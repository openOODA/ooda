// # Keys Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for KEYS.
//
// Setup: Imports keys_types.oo for data structure definitions.
//
// Beats:
//   1. Import KEYS types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./keys_types.oo";

pub fn key_pair_create(public_key: PublicKey, secret_key: SecretKey, pair_id: String) -> KeyPair {
    let mut valid: Bool = true;
    let p_rev: Bool = public_key_is_revoked(public_key);
    let s_rev: Bool = secret_key_is_revoked(secret_key);
    let s_wiped: Bool = secret_key_is_wiped(secret_key);
    if p_rev {
        valid = false;
    }
    if s_rev {
        valid = false;
    }
    if s_wiped {
        valid = false;
    }
    return KeyPair {
        public_key: public_key,
        secret_key: secret_key,
        pair_id: pair_id,
        is_valid: valid,
    };
}

// -------------------------------------------------------------------
// Security & Verification Operations
// -------------------------------------------------------------------

pub fn secret_key_verify_checksum(sk_ref: &SecretKey) -> Bool {
    let wiped: Bool = (sk_ref).is_wiped;
    if wiped {
        return false;
    }
    let raw: String = (sk_ref).raw_bytes;
    let expected: Int = key_calculate_checksum(raw);
    let chk: Int = (sk_ref).checksum;
    return chk == expected;
}

pub fn public_key_verify_checksum(pk_ref: &PublicKey) -> Bool {
    let raw: String = (pk_ref).raw_bytes;
    let expected: Int = key_calculate_checksum(raw);
    let chk: Int = (pk_ref).checksum;
    return chk == expected;
}

pub fn secret_key_wipe(sk_mut: &mut SecretKey) {
    sk_mut.raw_bytes = "";
    sk_mut.checksum = 0;
    sk_mut.is_wiped = true;
}

// -------------------------------------------------------------------
// Hex Encoding & Decoding
// -------------------------------------------------------------------

pub fn byte_to_hex_pair(b: Int) -> String {
    let hex_chars: String = "0123456789abcdef";
    let div16: Int = b / 16;
    let hi: Int = div16 % 16;
    let lo: Int = b % 16;
    let mut res: List[Int] = bytes_new();
    res = bytes_push(res, byte_at(hex_chars, hi));
    res = bytes_push(res, byte_at(hex_chars, lo));
    return bytes_to_str(res);
}

pub fn key_bytes_to_hex(raw_bytes: String) -> String {
    let len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut out: String = "";
    while i < len {
        let b: Int = byte_at(raw_bytes, i);
        out = out + byte_to_hex_pair(b);
        i = i + 1;
    }
    return out;
}

pub fn hex_char_to_val(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 {
            return ch - 48;
        }
    }
    if ch >= 97 {
        if ch <= 102 {
            return ch - 87;
        }
    }
    if ch >= 65 {
        if ch <= 70 {
            return ch - 55;
        }
    }
    return -1;
}

pub fn hex_to_key_bytes(hex_str: String) -> Result[String, String] {
    let len: Int = hex_str.len();
    let rem: Int = len % 2;
    if rem != 0 {
        return Err("INVALID_HEX: String length must be even");
    }
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < len {
        let hi_ch: Int = byte_at(hex_str, i);
        let next_i: Int = i + 1;
        let lo_ch: Int = byte_at(hex_str, next_i);
        let hi_v: Int = hex_char_to_val(hi_ch);
        let lo_v: Int = hex_char_to_val(lo_ch);
        if hi_v < 0 {
            return Err("INVALID_HEX: Invalid hex character");
        }
        if lo_v < 0 {
            return Err("INVALID_HEX: Invalid hex character");
        }
        let hi_mult: Int = hi_v * 16;
        let b: Int = hi_mult + lo_v;
        buf = bytes_push(buf, b);
        i = i + 2;
    }
    let res_str: String = bytes_to_str(buf);
    return Ok(res_str);
}

pub type Invalid = struct {};
pub type Fail = struct {};
pub type Default = struct {};


