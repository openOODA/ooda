// # ZKP Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for ZKP.
//
// Setup: Imports zkp_types.oo for data structure definitions.
//
// Beats:
//   1. Import ZKP types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./zkp_math.oo";

pub fn pedersen_commitment_create(
    pc_g: Int,
    pc_h: Int,
    pc_val: Int,
    pc_r: Int,
    modulus: Int
) -> PedersenCommitment {
    if modulus <= 1 {
        return PedersenCommitment {
            commitment: 0,
            generator_g: pc_g,
            generator_h: pc_h,
            blinding_factor: pc_r,
            value: pc_val,
            modulus: modulus,
            is_valid: false,
        };
    }
    let pc_gv = zkp_mod_pow(pc_g, pc_val, modulus);
    let pc_hr = zkp_mod_pow(pc_h, pc_r, modulus);
    let pc_calc_comm = zkp_mod_mul(pc_gv, pc_hr, modulus);

    return PedersenCommitment {
        commitment: pc_calc_comm,
        generator_g: pc_g,
        generator_h: pc_h,
        blinding_factor: pc_r,
        value: pc_val,
        modulus: modulus,
        is_valid: true,
    };
}

pub fn pedersen_commitment_verify(target_pcomm: PedersenCommitment, target_comm_val: Int) -> Bool {
    if (target_pcomm.is_valid) == false {
        return false;
    }
    let pc_expected = pedersen_commitment_create(
        target_pcomm.generator_g,
        target_pcomm.generator_h,
        target_pcomm.value,
        target_pcomm.blinding_factor,
        target_pcomm.modulus
    );
    if (pc_expected.commitment) == target_comm_val {
        return true;
    }
    return false;
}

pub fn pedersen_commitment_homomorphic_add(
    pcomm1: PedersenCommitment,
    pcomm2: PedersenCommitment
) -> PedersenCommitment {
    if (pcomm1.is_valid) == false {
        return pcomm2;
    }
    if (pcomm2.is_valid) == false {
        return pcomm1;
    }
    let pcomm_comb_c = zkp_mod_mul(pcomm1.commitment, pcomm2.commitment, pcomm1.modulus);
    let pcomm_comb_v = (pcomm1.value) + (pcomm2.value);
    let pcomm_comb_r = (pcomm1.blinding_factor) + (pcomm2.blinding_factor);

    return PedersenCommitment {
        commitment: pcomm_comb_c,
        generator_g: pcomm1.generator_g,
        generator_h: pcomm1.generator_h,
        blinding_factor: pcomm_comb_r,
        value: pcomm_comb_v,
        modulus: pcomm1.modulus,
        is_valid: true,
    };
}

pub fn pedersen_commitment_to_string(str_pcomm: PedersenCommitment) -> String {
    let pc_c_str = (str_pcomm.commitment).to_string();
    let pc_v_str = (str_pcomm.value).to_string();
    let pc_r_str = (str_pcomm.blinding_factor).to_string();
    return "PedersenComm(C=" + pc_c_str + ", V=" + pc_v_str + ", R=" + pc_r_str + ")";
}

// -------------------------------------------------------------------
// Schnorr Zero-Knowledge Proof Implementation
// -------------------------------------------------------------------

pub fn schnorr_prove(
    sp_secret: Int,
    sp_pub_key: Int,
    sp_generator: Int,
    sp_blinding: Int,
    sp_modulus: Int
) -> SchnorrProof {
    if sp_modulus <= 1 {
        return SchnorrProof {
            commitment_r: 0,
            challenge_c: 0,
            response_s: 0,
            public_key: sp_pub_key,
            generator: sp_generator,
            modulus: sp_modulus,
            is_valid: false,
        };
    }
    let sp_r_val = zkp_mod_pow(sp_generator, sp_blinding, sp_modulus);
    let sp_challenge = zkp_hash_challenge(sp_r_val, sp_pub_key, sp_modulus);
    let sp_phi = sp_modulus - 1;
    let sp_cx = zkp_mod_mul(sp_challenge, sp_secret, sp_phi);
    let sp_s_val = zkp_mod_add(sp_blinding, sp_cx, sp_phi);

    return SchnorrProof {
        commitment_r: sp_r_val,
        challenge_c: sp_challenge,
        response_s: sp_s_val,
        public_key: sp_pub_key,
        generator: sp_generator,
        modulus: sp_modulus,
        is_valid: true,
    };
}

pub fn schnorr_verify(sv_s_proof: SchnorrProof) -> Bool {
    if (sv_s_proof.is_valid) == false {
        return false;
    }
    if (sv_s_proof.modulus) <= 1 {
        return false;
    }

    let sv_lhs = zkp_mod_pow(sv_s_proof.generator, sv_s_proof.response_s, sv_s_proof.modulus);
    let sv_pk_c = zkp_mod_pow(sv_s_proof.public_key, sv_s_proof.challenge_c, sv_s_proof.modulus);
    let sv_rhs = zkp_mod_mul(sv_s_proof.commitment_r, sv_pk_c, sv_s_proof.modulus);

    let sv_recomp_c = zkp_hash_challenge(sv_s_proof.commitment_r, sv_s_proof.public_key, sv_s_proof.modulus);
    if (sv_s_proof.challenge_c) != sv_recomp_c {
        return false;
    }

    if sv_lhs == sv_rhs {
        return true;
    }
    return false;
}

pub fn schnorr_proof_to_string(str_sproof: SchnorrProof) -> String {
    let sp_r_str = (str_sproof.commitment_r).to_string();
    let sp_c_str = (str_sproof.challenge_c).to_string();
    let sp_s_str = (str_sproof.response_s).to_string();
    let sp_pk_str = (str_sproof.public_key).to_string();
    return "SchnorrProof(R=" + sp_r_str + ", C=" + sp_c_str + ", S=" + sp_s_str + ", PK=" + sp_pk_str + ")";
}
