// # SHA-256 one-shot (org facade destub)
//
// Logline: Forward sha256 to the runtime FIPS hex digest.
//
// Setup: crypto_sha256_internal is product C (FIPS 180-4 one-shot).
// Incremental ctx stays residual on std/hash/sha256.oo.
//
// Beats:
//   1. sha256 returns the 64-char hex digest.
//   2. Independent published vector: sha256("hello").
//   3. Do not claim a from-scratch compression function in this facade.

pub fn sha256(data: String) -> String {
    return crypto_sha256_internal(data);
}
