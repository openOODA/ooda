// # AES-128 inverse cipher
//
// Logline: Decrypt one 16-byte AES-128 block with the FIPS-197 inverse cipher.
//
// Setup: No runtime decrypt builtin. Key and block are raw 16-byte strings.
//
// Beats:
//   1. Expand the 128-bit key to 11 round keys.
//   2. InvShiftRows, InvSubBytes, AddRoundKey, InvMixColumns.
//   3. Return 16 raw plaintext bytes.

fn aes_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn aes_nibble(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 { return ch - 48; }
    }
    if ch >= 97 {
        if ch <= 102 { return ch - 87; }
    }
    return 0;
}

fn aes_sbox(i: Int) -> Int {
    let hx: String = "";
    return aes_nibble(byte_at(hx, i * 2)) * 16 + aes_nibble(byte_at(hx, i * 2 + 1));
}

fn aes_isbox(i: Int) -> Int {
    let hx: String = "";
    return aes_nibble(byte_at(hx, i * 2)) * 16 + aes_nibble(byte_at(hx, i * 2 + 1));
}

fn aes_xtime(a: Int) -> Int {
    let x: Int = (a * 2) & 255;
    if (a & 128) != 0 {
        return aes_xor(x, 27);
    }
    return x;
}

fn aes_mul(a: Int, b: Int) -> Int {
    let mut p: Int = 0;
    let mut x: Int = a;
    let mut y: Int = b;
    let mut i: Int = 0;
    while i < 8 {
        if (y & 1) != 0 {
            p = aes_xor(p, x);
        }
        x = aes_xtime(x);
        y = y / 2;
        i = i + 1;
    }
    return p;
}

fn aes_expand(key: String) -> String {
    let mut w: List[Int] = bytes_new();
    let mut i: Int = 0;
    while i < 16 {
        w = bytes_push(w, byte_at(key, i));
        i = i + 1;
    }
    let rcon: String = "01020408102040801b36";
    i = 16;
    while i < 176 {
        let mut t0: Int = byte_at(bytes_to_str(w), i - 4);
        let mut t1: Int = byte_at(bytes_to_str(w), i - 3);
        let mut t2: Int = byte_at(bytes_to_str(w), i - 2);
        let mut t3: Int = byte_at(bytes_to_str(w), i - 1);
        if (i % 16) == 0 {
            let k0: Int = t0;
            t0 = aes_sbox(t1);
            t1 = aes_sbox(t2);
            t2 = aes_sbox(t3);
            t3 = aes_sbox(k0);
            let rc: Int = aes_nibble(byte_at(rcon, (i / 16 - 1) * 2)) * 16 + aes_nibble(byte_at(rcon, (i / 16 - 1) * 2 + 1));
            t0 = aes_xor(t0, rc);
        }
        let ws: String = bytes_to_str(w);
        w = bytes_push(w, aes_xor(byte_at(ws, i - 16), t0));
        w = bytes_push(w, aes_xor(byte_at(ws, i - 15), t1));
        w = bytes_push(w, aes_xor(byte_at(ws, i - 14), t2));
        w = bytes_push(w, aes_xor(byte_at(ws, i - 13), t3));
        i = i + 4;
    }
    return bytes_to_str(w);
}

fn aes_get(s: String, i: Int) -> Int {
    return byte_at(s, i);
}

fn aes_set16(s: String, idx: Int, v: Int) -> String {
    let mut b: List[Int] = bytes_new();
    let mut i: Int = 0;
    while i < 16 {
        if i == idx {
            b = bytes_push(b, v);
        } else {
            b = bytes_push(b, byte_at(s, i));
        }
        i = i + 1;
    }
    return bytes_to_str(b);
}

fn aes_add_rk(s: String, w: String, rnd: Int) -> String {
    let mut b: List[Int] = bytes_new();
    let mut i: Int = 0;
    let off: Int = rnd * 16;
    while i < 16 {
        b = bytes_push(b, aes_xor(byte_at(s, i), byte_at(w, off + i)));
        i = i + 1;
    }
    return bytes_to_str(b);
}

fn aes_inv_shift(s: String) -> String {
    let mut t: String = s;
    t = aes_set16(t, 1, aes_get(s, 13));
    t = aes_set16(t, 5, aes_get(s, 1));
    t = aes_set16(t, 9, aes_get(s, 5));
    t = aes_set16(t, 13, aes_get(s, 9));
    t = aes_set16(t, 2, aes_get(s, 10));
    t = aes_set16(t, 6, aes_get(s, 14));
    t = aes_set16(t, 10, aes_get(s, 2));
    t = aes_set16(t, 14, aes_get(s, 6));
    t = aes_set16(t, 3, aes_get(s, 7));
    t = aes_set16(t, 7, aes_get(s, 11));
    t = aes_set16(t, 11, aes_get(s, 15));
    t = aes_set16(t, 15, aes_get(s, 3));
    return t;
}

fn aes_inv_sub(s: String) -> String {
    let mut b: List[Int] = bytes_new();
    let mut i: Int = 0;
    while i < 16 {
        b = bytes_push(b, aes_isbox(byte_at(s, i)));
        i = i + 1;
    }
    return bytes_to_str(b);
}

fn aes_inv_mix(s: String) -> String {
    let mut b: List[Int] = bytes_new();
    let mut c: Int = 0;
    while c < 4 {
        let i0: Int = c * 4;
        let a0: Int = byte_at(s, i0);
        let a1: Int = byte_at(s, i0 + 1);
        let a2: Int = byte_at(s, i0 + 2);
        let a3: Int = byte_at(s, i0 + 3);
        b = bytes_push(b, aes_xor(aes_xor(aes_mul(a0, 14), aes_mul(a1, 11)), aes_xor(aes_mul(a2, 13), aes_mul(a3, 9))));
        b = bytes_push(b, aes_xor(aes_xor(aes_mul(a0, 9), aes_mul(a1, 14)), aes_xor(aes_mul(a2, 11), aes_mul(a3, 13))));
        b = bytes_push(b, aes_xor(aes_xor(aes_mul(a0, 13), aes_mul(a1, 9)), aes_xor(aes_mul(a2, 14), aes_mul(a3, 11))));
        b = bytes_push(b, aes_xor(aes_xor(aes_mul(a0, 11), aes_mul(a1, 13)), aes_xor(aes_mul(a2, 9), aes_mul(a3, 14))));
        c = c + 1;
    }
    return bytes_to_str(b);
}

pub fn aes_inv_block(key: String, ct: String) -> String {
    let w: String = aes_expand(key);
    let mut s: String = aes_add_rk(ct, w, 10);
    let mut r: Int = 9;
    while r >= 1 {
        s = aes_inv_shift(s);
        s = aes_inv_sub(s);
        s = aes_add_rk(s, w, r);
        s = aes_inv_mix(s);
        r = r - 1;
    }
    s = aes_inv_shift(s);
    s = aes_inv_sub(s);
    s = aes_add_rk(s, w, 0);
    return s;
}
