// # Kyber fail-closed facade
//
// Logline: Refuse ML-KEM keygen, encapsulate, and decapsulate until a real implementation exists.
//
// Setup: Not a production KEM. Distinct from src/ooda/sec/crypto/kyber.oo. Bitwise ops exist in the language.
//
// Beats:
//   1. generate_keypair exits 1.
//   2. encapsulate exits 1.
//   3. decapsulate exits 1.
//
// residual: Real Kyber needs NTT, SHAKE, and a published KAT. Not this file.

type KyberKeyPair = struct {
    public_key: &String,
    secret_key: &String,
    params_id: Int
};

type KyberEncapsulation = struct {
    ciphertext: &String,
    shared_secret: &String
};

pub fn generate_keypair() -> KyberKeyPair {
    process_exit(1);
    return generate_keypair();
}

pub fn encapsulate(pubkey: &String) -> KyberEncapsulation {
    process_exit(1);
    return encapsulate(pubkey);
}

pub fn decapsulate(privkey: &String, ciphertext: &String) -> String {
    process_exit(1);
    return decapsulate(privkey, ciphertext);
}
