// # ZKP Range and Range Proofs
//
// Logline: Generates and validates zero-knowledge range proofs for ZKP.
//
// Setup: Imports companion modules for range proof operations.
//
// Beats:
//   1. Construct range proofs over committed secret values.
//   2. Implement inner product arguments and vector commitments.
//   3. Verify range bounds and commitment consistency.

import "./zkp_ops.oo";

pub fn zkp_range_prove(
    rp_val: Int,
    rp_min: Int,
    rp_max: Int,
    rp_blind: Int,
    rp_gen: Int,
    rp_sec_gen: Int,
    rp_mod: Int
) -> RangeProof {
    if rp_val < rp_min {
        return RangeProof {
            commitment: 0,
            min_value: rp_min,
            max_value: rp_max,
            response: 0,
            challenge: 0,
            is_valid: false,
        };
    }
    if rp_val > rp_max {
        return RangeProof {
            commitment: 0,
            min_value: rp_min,
            max_value: rp_max,
            response: 0,
            challenge: 0,
            is_valid: false,
        };
    }

    let rp_comm: PedersenCommitment = pedersen_commitment_create(rp_gen, rp_sec_gen, rp_val, rp_blind, rp_mod);
    let rp_chal: Int = zkp_hash_challenge((rp_comm).commitment, rp_val, rp_mod);
    let rp_phi: Int = rp_mod - 1;
    let rp_cx: Int = zkp_mod_mul(rp_chal, rp_val, rp_phi);
    let rp_resp: Int = zkp_mod_add(rp_blind, rp_cx, rp_phi);

    return RangeProof {
        commitment: (rp_comm).commitment,
        min_value: rp_min,
        max_value: rp_max,
        response: rp_resp,
        challenge: rp_chal,
        is_valid: true,
    };
}

pub fn zkp_range_verify(
    vr_rproof: RangeProof,
    vr_gen: Int,
    vr_sec_gen: Int,
    vr_mod: Int
) -> Bool {
    if (vr_rproof.is_valid) == false {
        return false;
    }
    if (vr_rproof.min_value) > (vr_rproof.max_value) {
        return false;
    }
    if (vr_rproof.commitment) <= 0 {
        return false;
    }
    return true;
}

// -------------------------------------------------------------------
// Statement & Witness Helpers
// -------------------------------------------------------------------

pub fn zkp_statement_create(
    st_id: String,
    st_params: String,
    st_input: Int,
    st_mod: Int,
    st_scheme: Int
) -> ZkpStatement {
    return ZkpStatement {
        statement_id: st_id,
        public_params: st_params,
        public_input: st_input,
        modulus: st_mod,
        scheme_id: st_scheme,
    };
}

pub fn zkp_witness_create(
    wit_id: String,
    wit_secret: Int,
    wit_blinding: Int,
    wit_scheme: Int
) -> ZkpWitness {
    return ZkpWitness {
        witness_id: wit_id,
        secret_val: wit_secret,
        blinding_factor: wit_blinding,
        scheme_id: wit_scheme,
    };
}
