// # ZKP Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for ZKP.
//
// Setup: Imports companion modules for validated ZKP operations.
//
// Beats:
//   1. Import ZKP operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./zkp_range.oo";

pub fn zkp_prover_init(
    prv_id: String,
    prv_scheme: Int,
    prv_sec_bits: Int,
    prv_mod: Int,
    prv_gen: Int,
    prv_sec_gen: Int
) -> ZkpProver {
    return ZkpProver {
        prover_id: prv_id,
        scheme_id: prv_scheme,
        security_bits: prv_sec_bits,
        proofs_generated: 0,
        modulus: prv_mod,
        generator: prv_gen,
        secondary_generator: prv_sec_gen,
        is_active: true,
    };
}

pub fn zkp_prover_set_active(prv_obj: &mut ZkpProver, prv_act: Bool) {
    prv_obj.is_active = prv_act;
}

pub fn zkp_prover_create_proof(
    prv_ctx: &mut ZkpProver,
    prv_stmt: ZkpStatement,
    prv_wit: ZkpWitness
) -> ZkpProof {
    if (prv_ctx.is_active) == false {
        return ZkpProof {
            proof_id: "ERR_INACTIVE_PROVER",
            scheme_id: prv_ctx.scheme_id,
            commitment: 0,
            challenge: 0,
            response: 0,
            public_input: prv_stmt.public_input,
            proof_bytes: "",
            is_verified: false,
        };
    }

    let prv_cnt: Int = ((prv_ctx).proofs_generated) + 1;
    (prv_ctx).proofs_generated = prv_cnt;

    let prv_pk: Int = zkp_mod_pow((prv_ctx).generator, (prv_wit).secret_val, (prv_ctx).modulus);
    let prv_schnorr: SchnorrProof = schnorr_prove(
        (prv_wit).secret_val,
        prv_pk,
        (prv_ctx).generator,
        (prv_wit).blinding_factor,
        (prv_ctx).modulus
    );

    let prv_cnt_str: String = prv_cnt.to_string();
    let prv_proof_id: String = (prv_ctx).prover_id + "_proof_" + prv_cnt_str;

    return ZkpProof {
        proof_id: prv_proof_id,
        scheme_id: (prv_ctx).scheme_id,
        commitment: (prv_schnorr).commitment_r,
        challenge: (prv_schnorr).challenge_c,
        response: (prv_schnorr).response_s,
        public_input: prv_pk,
        proof_bytes: "schnorr_proof_v1",
        is_verified: true,
    };
}

// -------------------------------------------------------------------
// Verifier Lifecycle & Execution
// -------------------------------------------------------------------

pub fn zkp_verifier_init(
    vf_id: String,
    vf_scheme: Int,
    vf_sec_bits: Int,
    vf_mod: Int,
    vf_gen: Int,
    vf_sec_gen: Int
) -> ZkpVerifier {
    return ZkpVerifier {
        verifier_id: vf_id,
        scheme_id: vf_scheme,
        security_bits: vf_sec_bits,
        proofs_verified: 0,
        proofs_rejected: 0,
        modulus: vf_mod,
        generator: vf_gen,
        secondary_generator: vf_sec_gen,
        strict_mode: true,
        is_active: true,
    };
}

pub fn zkp_verifier_set_strict_mode(vf_obj: &mut ZkpVerifier, vf_strict: Bool) {
    (vf_obj).strict_mode = vf_strict;
}

pub fn zkp_verifier_set_active(vf_act_obj: &mut ZkpVerifier, vf_act: Bool) {
    (vf_act_obj).is_active = vf_act;
}

pub fn zkp_verifier_verify_proof(
    vf_ctx: &mut ZkpVerifier,
    vf_zk_proof: ZkpProof,
    vf_stmt: ZkpStatement
) -> Bool {
    if ((vf_ctx).is_active) == false {
        let vf_r_cnt: Int = ((vf_ctx).proofs_rejected) + 1;
        (vf_ctx).proofs_rejected = vf_r_cnt;
        return false;
    }

    if ((vf_zk_proof).scheme_id) != ((vf_ctx).scheme_id) {
        let vf_r_cnt2: Int = ((vf_ctx).proofs_rejected) + 1;
        (vf_ctx).proofs_rejected = vf_r_cnt2;
        return false;
    }

    let vf_schnorr: SchnorrProof = SchnorrProof {
        commitment_r: (vf_zk_proof).commitment,
        challenge_c: (vf_zk_proof).challenge,
        response_s: (vf_zk_proof).response,
        public_key: (vf_zk_proof).public_input,
        generator: (vf_ctx).generator,
        modulus: (vf_ctx).modulus,
        flag_bits: 1,
        is_valid: (vf_zk_proof).is_verified,
    };

    let vf_valid: Bool = schnorr_verify(vf_schnorr);

    if vf_valid {
        let vf_v_cnt: Int = ((vf_ctx).proofs_verified) + 1;
        (vf_ctx).proofs_verified = vf_v_cnt;
        return true;
    } else {
        let vf_r_cnt3: Int = ((vf_ctx).proofs_rejected) + 1;
        (vf_ctx).proofs_rejected = vf_r_cnt3;
        return false;
    }
}

pub fn zkp_verifier_verify_with_capability(
    sys: &SysCap,
    cap_vf_ctx: &mut ZkpVerifier,
    cap_zk_proof: ZkpProof,
    cap_stmt: ZkpStatement
) -> Result[Bool, String] {
    let cap_valid = zkp_verifier_verify_proof(cap_vf_ctx, cap_zk_proof, cap_stmt);
    if cap_valid {
        return Ok(true);
    } else {
        return Err("ZKP_VERIFICATION_FAILED: Proof invalid or verifier rejected statement");
    }
}
