// # FHE Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for FHE.
//
// Setup: Imports companion modules for validated FHE operations.
//
// Beats:
//   1. Import FHE operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./fhe_types.oo";

// Remaining Homomorphic Arithmetic

pub fn fhe_sub_plain(subp_cipher: FheCiphertext, subp_plain: FhePlaintext) -> Result[FheCiphertext, String] {
    if subp_cipher.is_valid == false {
        return Err("INVALID_CIPHERTEXT: Ciphertext operand is invalid");
    }
    if subp_plain.is_valid == false {
        return Err("INVALID_PLAINTEXT: Plaintext operand is invalid");
    }

    let subp_c0: String = subp_cipher.c0_poly;
    let subp_c1: String = subp_cipher.c1_poly;
    let subp_noise: Int = subp_cipher.noise_budget;
    let subp_level: Int = subp_cipher.level;
    let subp_scale: Int = subp_cipher.scale;
    let subp_p_poly: String = subp_plain.encoded_poly;

    let new_subp_c0: String = "(" + subp_c0 + " - " + subp_p_poly + ")";
    let subp_combined: String = new_subp_c0 + subp_c1;
    let subp_chk: Int = fhe_calculate_checksum(subp_combined);

    let subp_target_id: String = subp_cipher.cipher_id;
    let subp_res_id: String = "subp_" + subp_target_id;

    let subp_res_cipher: FheCiphertext = FheCiphertext {
        cipher_id: subp_res_id,
        c0_poly: new_subp_c0,
        c1_poly: subp_c1,
        scale: subp_scale,
        level: subp_level,
        noise_budget: subp_noise - 1,
        checksum: subp_chk,
        is_valid: true,
    };
    return Ok(subp_res_cipher);
}

pub fn fhe_multiply(
    mul_c1: FheCiphertext,
    mul_c2: FheCiphertext,
    mul_eval_key: FheEvaluationKey
) -> Result[FheCiphertext, String] {
    if mul_c1.is_valid == false {
        return Err("INVALID_CIPHERTEXT: First operand is invalid");
    }
    if mul_c2.is_valid == false {
        return Err("INVALID_CIPHERTEXT: Second operand is invalid");
    }
    if mul_eval_key.is_valid == false {
        return Err("INVALID_EVAL_KEY: Evaluation/relinearization key is invalid");
    }

    let eval_relin: String = mul_eval_key.relin_poly;
    let mul_c1_c0: String = mul_c1.c0_poly;
    let mul_c2_c0: String = mul_c2.c0_poly;
    let mul_c1_c1: String = mul_c1.c1_poly;
    let mul_c2_c1: String = mul_c2.c1_poly;
    let mul_c1_noise: Int = mul_c1.noise_budget;
    let mul_c2_noise: Int = mul_c2.noise_budget;
    let mul_c1_scale: Int = mul_c1.scale;
    let mul_c2_scale: Int = mul_c2.scale;
    let mul_c1_level: Int = mul_c1.level;

    let new_mul_c0: String = "mul_relin(" + mul_c1_c0 + " * " + mul_c2_c0 + ", " + eval_relin + ")";
    let new_mul_c1: String = "mul_relin(" + mul_c1_c1 + " * " + mul_c2_c1 + ", " + eval_relin + ")";
    let mut mul_min_noise: Int = mul_c1_noise;
    if mul_c2_noise < mul_min_noise {
        mul_min_noise = mul_c2_noise;
    }
    let mul_new_noise: Int = mul_min_noise - 15;
    let mul_combined: String = new_mul_c0 + new_mul_c1;
    let mul_chk: Int = fhe_calculate_checksum(mul_combined);

    let mul_c1_id: String = mul_c1.cipher_id;
    let mul_c2_id: String = mul_c2.cipher_id;
    let mul_res_id: String = "mul_" + mul_c1_id + "_" + mul_c2_id;

    let mul_res_cipher: FheCiphertext = FheCiphertext {
        cipher_id: mul_res_id,
        c0_poly: new_mul_c0,
        c1_poly: new_mul_c1,
        scale: mul_c1_scale * mul_c2_scale,
        level: mul_c1_level + 1,
        noise_budget: mul_new_noise,
        checksum: mul_chk,
        is_valid: true,
    };
    return Ok(mul_res_cipher);
}

pub fn fhe_multiply_plain(mulp_cipher: FheCiphertext, mulp_plain: FhePlaintext) -> Result[FheCiphertext, String] {
    if mulp_cipher.is_valid == false {
        return Err("INVALID_CIPHERTEXT: Ciphertext operand is invalid");
    }
    if mulp_plain.is_valid == false {
        return Err("INVALID_PLAINTEXT: Plaintext operand is invalid");
    }

    let mulp_p_poly: String = mulp_plain.encoded_poly;
    let mulp_p_scale: Int = mulp_plain.scale;
    let mulp_c0: String = mulp_cipher.c0_poly;
    let mulp_c1: String = mulp_cipher.c1_poly;
    let mulp_c_scale: Int = mulp_cipher.scale;
    let mulp_c_level: Int = mulp_cipher.level;
    let mulp_c_noise: Int = mulp_cipher.noise_budget;

    let new_mulp_c0: String = "(" + mulp_c0 + " * " + mulp_p_poly + ")";
    let new_mulp_c1: String = "(" + mulp_c1 + " * " + mulp_p_poly + ")";
    let mulp_combined: String = new_mulp_c0 + new_mulp_c1;
    let mulp_chk: Int = fhe_calculate_checksum(mulp_combined);

    let mulp_target_id: String = mulp_cipher.cipher_id;
    let mulp_res_id: String = "mulp_" + mulp_target_id;

    let mulp_res_cipher: FheCiphertext = FheCiphertext {
        cipher_id: mulp_res_id,
        c0_poly: new_mulp_c0,
        c1_poly: new_mulp_c1,
        scale: mulp_c_scale * mulp_p_scale,
        level: mulp_c_level,
        noise_budget: mulp_c_noise - 5,
        checksum: mulp_chk,
        is_valid: true,
    };
    return Ok(mulp_res_cipher);
}

pub fn fhe_negate(neg_cipher: FheCiphertext) -> Result[FheCiphertext, String] {
    if neg_cipher.is_valid == false {
        return Err("INVALID_CIPHERTEXT: Ciphertext is invalid");
    }

    let neg_c0: String = neg_cipher.c0_poly;
    let neg_c1: String = neg_cipher.c1_poly;
    let neg_scale: Int = neg_cipher.scale;
    let neg_level: Int = neg_cipher.level;
    let neg_noise: Int = neg_cipher.noise_budget;

    let new_neg_c0: String = "-(" + neg_c0 + ")";
    let new_neg_c1: String = "-(" + neg_c1 + ")";
    let neg_combined: String = new_neg_c0 + new_neg_c1;
    let neg_chk: Int = fhe_calculate_checksum(neg_combined);

    let neg_target_id: String = neg_cipher.cipher_id;
    let neg_res_id: String = "neg_" + neg_target_id;

    let neg_res_cipher: FheCiphertext = FheCiphertext {
        cipher_id: neg_res_id,
        c0_poly: new_neg_c0,
        c1_poly: new_neg_c1,
        scale: neg_scale,
        level: neg_level,
        noise_budget: neg_noise,
        checksum: neg_chk,
        is_valid: true,
    };
    return Ok(neg_res_cipher);
}

pub fn fhe_rotate(
    rot_cipher: FheCiphertext,
    rot_steps: Int,
    rot_eval_key: FheEvaluationKey
) -> Result[FheCiphertext, String] {
    if rot_cipher.is_valid == false {
        return Err("INVALID_CIPHERTEXT: Ciphertext is invalid");
    }
    if rot_eval_key.is_valid == false {
        return Err("INVALID_EVAL_KEY: Evaluation key is invalid");
    }

    let rot_steps_str: String = rot_steps.to_string();
    let rot_c0: String = rot_cipher.c0_poly;
    let rot_c1: String = rot_cipher.c1_poly;
    let rot_scale: Int = rot_cipher.scale;
    let rot_level: Int = rot_cipher.level;
    let rot_noise: Int = rot_cipher.noise_budget;

    let new_rot_c0: String = "rot(" + rot_c0 + ", " + rot_steps_str + ")";
    let new_rot_c1: String = "rot(" + rot_c1 + ", " + rot_steps_str + ")";
    let rot_combined: String = new_rot_c0 + new_rot_c1;
    let rot_chk: Int = fhe_calculate_checksum(rot_combined);

    let rot_target_id: String = rot_cipher.cipher_id;
    let rot_res_id: String = "rot_" + rot_steps_str + "_" + rot_target_id;

    let rot_res_cipher: FheCiphertext = FheCiphertext {
        cipher_id: rot_res_id,
        c0_poly: new_rot_c0,
        c1_poly: new_rot_c1,
        scale: rot_scale,
        level: rot_level,
        noise_budget: rot_noise - 2,
        checksum: rot_chk,
        is_valid: true,
    };
    return Ok(rot_res_cipher);
}

pub fn fhe_rescale(rescale_cipher_ref: &mut FheCiphertext) -> Result[Bool, String] {
    if (rescale_cipher_ref).is_valid == false {
        return Err("INVALID_CIPHERTEXT: Cannot rescale invalid ciphertext");
    }
    let cur_rescale_scale: Int = (rescale_cipher_ref).scale;
    if cur_rescale_scale <= 1 {
        return Ok(false);
    }

    rescale_cipher_ref.scale = cur_rescale_scale / 2;
    rescale_cipher_ref.level = (rescale_cipher_ref).level + 1;
    return Ok(true);
}

pub fn fhe_mod_switch(mod_switch_cipher_ref: &mut FheCiphertext) -> Result[Bool, String] {
    if (mod_switch_cipher_ref).is_valid == false {
        return Err("INVALID_CIPHERTEXT: Cannot modulus switch invalid ciphertext");
    }

    mod_switch_cipher_ref.level = (mod_switch_cipher_ref).level + 1;
    mod_switch_cipher_ref.noise_budget = (mod_switch_cipher_ref).noise_budget - 3;
    return Ok(true);
}

pub fn fhe_estimate_noise_budget(noise_sk: &FheSecretKey, noise_cipher: &FheCiphertext) -> Int {
    if (noise_sk).is_wiped == true {
        return 0;
    }
    if (noise_cipher).is_valid == false {
        return 0;
    }
    return (noise_cipher).noise_budget;
}
