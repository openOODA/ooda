// # Keys Fail-Closed Stubs
//
// Logline: Enforces fail-closed process exit barriers for unverified cryptographic operations in KEYS.
//
// Setup: Imports companion modules for fail-closed stub declarations.
//
// Beats:
//   1. Import KEYS engine and state types.
//   2. Trap unverified low-level primitives with process_exit(1).
//   3. Guard unaudited hardware acceleration and FFI routines.

import "./keys_store.oo";

pub fn keystore_revoke_key(store: &mut KeyStore, key_id: String) -> Bool {
    let locked: Bool = (store).is_locked;
    if locked {
        return false;
    }

    let mut revoked: Bool = false;

    let mut new_s: List[SecretKey] = list_new();
    let s_keys: List[SecretKey] = (store).secret_keys;
    let n_s: Int = list_len(s_keys);
    let mut i: Int = 0;
    while i < n_s {
        let sk_entry: SecretKey = list_get(s_keys, i);
        if (sk_entry).key_id == key_id {
            let updated_k: SecretKey = SecretKey {
                key_id: (sk_entry).key_id,
                algorithm: (sk_entry).algorithm,
                key_type: (sk_entry).key_type,
                bit_length: (sk_entry).bit_length,
                usage_flags: (sk_entry).usage_flags,
                created_at: (sk_entry).created_at,
                expires_at: (sk_entry).expires_at,
                is_revoked: true,
                raw_bytes: (sk_entry).raw_bytes,
                checksum: (sk_entry).checksum,
                is_wiped: (sk_entry).is_wiped
            };
            new_s = list_push(new_s, updated_k);
            revoked = true;
        } else {
            new_s = list_push(new_s, sk_entry);
        }
        i = i + 1;
    }
    (store).secret_keys = new_s;

    let mut new_p: List[PublicKey] = list_new();
    let p_keys: List[PublicKey] = (store).public_keys;
    let n_p: Int = list_len(p_keys);
    let mut j: Int = 0;
    while j < n_p {
        let pk_entry: PublicKey = list_get(p_keys, j);
        if (pk_entry).key_id == key_id {
            let updated_pk: PublicKey = PublicKey {
                key_id: (pk_entry).key_id,
                algorithm: (pk_entry).algorithm,
                key_type: (pk_entry).key_type,
                bit_length: (pk_entry).bit_length,
                usage_flags: (pk_entry).usage_flags,
                created_at: (pk_entry).created_at,
                expires_at: (pk_entry).expires_at,
                is_revoked: true,
                raw_bytes: (pk_entry).raw_bytes,
                checksum: (pk_entry).checksum
            };
            new_p = list_push(new_p, updated_pk);
            revoked = true;
        } else {
            new_p = list_push(new_p, pk_entry);
        }
        j = j + 1;
    }
    (store).public_keys = new_p;

    return revoked;
}

pub fn keystore_do_work(store: &KeyStore) -> Int {
    let s_list: List[SecretKey] = (store).secret_keys;
    let p_list: List[PublicKey] = (store).public_keys;
    let pairs_list: List[KeyPair] = (store).key_pairs;
    let n_s: Int = list_len(s_list);
    let n_p: Int = list_len(p_list);
    let n_pairs: Int = list_len(pairs_list);
    let m_hash: Int = (store).master_key_hash;
    let p_work: Int = n_p * 2;
    let pair_work: Int = n_pairs * 3;
    let total_a: Int = n_s + p_work;
    let total_b: Int = total_a + pair_work;
    return total_b + m_hash;
}

