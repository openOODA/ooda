// # FHE Facade
//
// Logline: Re-exports FHE data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import FHE companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 5 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Some large-struct cross-module call markers omitted —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many large by-value calls in one unit.
// Real implementations remain in split modules (check green alone).

import "./fhe_types.oo";
import "./fhe_ops.oo";
import "./fhe_engine.oo";
import "./fhe_stubs.oo";

pub fn shim_marker_checksum() -> Int {
    return fhe_calculate_checksum("abc");
}

pub fn shim_marker_params_create() -> FheParams {
    return fhe_params_create("BFV", 4096, 1024, 60, 128);
}

pub fn shim_marker_params_validate(p: &FheParams) -> Bool {
    return fhe_params_validate(p);
}

pub fn shim_marker_public_key_create() -> FhePublicKey {
    return fhe_public_key_create("pk1", "pk0_poly", "pk1_poly");
}

pub fn shim_marker_secret_key_create() -> FheSecretKey {
    return fhe_secret_key_create("sk1", "sk_poly");
}

pub fn shim_marker_eval_key_create() -> FheEvaluationKey {
    return fhe_evaluation_key_create("ek1", "relin", "galois");
}

pub fn shim_marker_encode() -> FhePlaintext {
    let p: FheParams = fhe_params_create("BFV", 4096, 1024, 60, 128);
    return fhe_encode_int(42, p);
}

pub fn shim_marker_decode(pt: FhePlaintext) -> Result[Int, String] {
    return fhe_decode_int(pt);
}

pub fn shim_marker_encrypt(pk: FhePublicKey, p: FheParams, pt: FhePlaintext) -> Result[FheCiphertext, String] {
    return fhe_encrypt(pk, p, pt);
}

pub fn shim_marker_decrypt(sk: FheSecretKey, p: FheParams, ct: FheCiphertext) -> Result[FhePlaintext, String] {
    return fhe_decrypt(sk, p, ct);
}

pub fn shim_marker_add(c1: FheCiphertext, c2: FheCiphertext) -> Result[FheCiphertext, String] {
    return fhe_add(c1, c2);
}

pub fn shim_marker_sub(c1: FheCiphertext, c2: FheCiphertext) -> Result[FheCiphertext, String] {
    return fhe_sub(c1, c2);
}

pub fn shim_marker_multiply(c1: FheCiphertext, c2: FheCiphertext, ek: FheEvaluationKey) -> Result[FheCiphertext, String] {
    return fhe_multiply(c1, c2, ek);
}

pub fn shim_marker_negate(ct: FheCiphertext) -> Result[FheCiphertext, String] {
    return fhe_negate(ct);
}

pub fn shim_marker_rotate(ct: FheCiphertext, ek: FheEvaluationKey) -> Result[FheCiphertext, String] {
    return fhe_rotate(ct, 1, ek);
}

pub fn shim_marker_noise(sk: &FheSecretKey, ct: &FheCiphertext) -> Int {
    return fhe_estimate_noise_budget(sk, ct);
}

pub fn shim_marker_context_init(kp: FheKeyPair) -> FheContext {
    return fhe_context_init("ctx-1", kp);
}

pub fn shim_marker_context_do_work(ctx: &FheContext) -> Int {
    return fhe_context_do_work(ctx);
}

pub fn shim_marker_npu(sys: &SysCap) -> Int {
    return fhe_npu_hardware_bootstrap(sys, 0);
}
