// # PBKDF2-HMAC-SHA256
//
// Logline: RFC 8018 PBKDF2 with HMAC-SHA256, iteration count c>=1, one 32-byte block.
//
// Setup: hmac_sha256 from hmac.oo returns hex. F is U1 xor U2 xor ... Uc.
//
// Beats:
//   1. Build U1 = HMAC(P, S || 0x00000001) and iterate c-1 more HMACs.
//   2. XOR the U values and emit the first dk_len bytes as lowercase hex.
//   3. Refuse c<1, dk_len<1, or dk_len>32.

import "hmac.oo";

fn pbk_xor_byte(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn pbk_nibble(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 { return ch - 48; }
    }
    if ch >= 97 {
        if ch <= 102 { return ch - 87; }
    }
    return -1;
}

fn pbk_unhex(hex: String) -> String {
    let n: Int = hex.len();
    if (n % 2) != 0 {
        process_exit(1);
        return "";
    }
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < n {
        let hi_v: Int = pbk_nibble(byte_at(hex, i));
        let lo_v: Int = pbk_nibble(byte_at(hex, i + 1));
        if hi_v < 0 {
            process_exit(1);
            return "";
        }
        if lo_v < 0 {
            process_exit(1);
            return "";
        }
        buf = bytes_push(buf, hi_v * 16 + lo_v);
        i = i + 2;
    }
    return bytes_to_str(buf);
}

fn pbk_xor32(a: String, b: String) -> String {
    let mut buf: List[Int] = bytes_new();
    let mut i: Int = 0;
    while i < 32 {
        buf = bytes_push(buf, pbk_xor_byte(byte_at(a, i), byte_at(b, i)));
        i = i + 1;
    }
    return bytes_to_str(buf);
}

fn pbk_salt1(salt: String) -> String {
    let mut buf: List[Int] = bytes_new();
    let n: Int = bytes_len(salt);
    let mut i: Int = 0;
    while i < n {
        buf = bytes_push(buf, byte_at(salt, i));
        i = i + 1;
    }
    buf = bytes_push(buf, 0);
    buf = bytes_push(buf, 0);
    buf = bytes_push(buf, 0);
    buf = bytes_push(buf, 1);
    return bytes_to_str(buf);
}

pub fn pbkdf2_hmac_sha256(password: String, salt: String, iterations: Int, dk_len: Int) -> String {
    if iterations < 1 {
        process_exit(1);
        return "";
    }
    if dk_len < 1 {
        process_exit(1);
        return "";
    }
    if dk_len > 32 {
        process_exit(1);
        return "";
    }
    let mut u: String = pbk_unhex(hmac_sha256(password, pbk_salt1(salt)));
    let mut t: String = u;
    let mut j: Int = 2;
    while j <= iterations {
        u = pbk_unhex(hmac_sha256(password, u));
        t = pbk_xor32(t, u);
        j = j + 1;
    }
    let hex: String = "0123456789abcdef";
    let mut out: List[Int] = bytes_new();
    let mut k: Int = 0;
    while k < dk_len {
        let b: Int = byte_at(t, k);
        out = bytes_push(out, byte_at(hex, (b / 16) % 16));
        out = bytes_push(out, byte_at(hex, b % 16));
        k = k + 1;
    }
    return bytes_to_str(out);
}

pub fn pbkdf2(password: String, salt: String, iterations: Int, key_length: Int) -> String {
    return pbkdf2_hmac_sha256(password, salt, iterations, key_length);
}
