// # X25519 fail-closed facade
//
// Logline: Refuse X25519 keygen, derive, and agreement until a Montgomery ladder exists.
//
// Setup: Not RFC 7748. No CSPRNG. No 255-bit field arithmetic in this file.
//
// Beats:
//   1. generate_private_key exits 1.
//   2. derive_public_key exits 1.
//   3. key_agreement exits 1.
//
// residual: RFC 7748 Alice/Bob shared secret. Not a fake scalar mult.

pub type PublicKey = struct {
    point_bytes: &String
};

pub type PrivateKey = struct {
    scalar_bytes: &String
};

pub type SharedSecret = struct {
    secret_bytes: &String
};

pub fn generate_private_key() -> PrivateKey {
    process_exit(1);
    return generate_private_key();
}

pub fn derive_public_key(sk: &PrivateKey) -> PublicKey {
    process_exit(1);
    return derive_public_key(sk);
}

pub fn key_agreement(sk: &PrivateKey, pk: &PublicKey) -> SharedSecret {
    process_exit(1);
    return key_agreement(sk, pk);
}