// # FHE types
//
// Logline: Data structures, parameter sets, ciphertexts, plaintexts, and keys for Fully Homomorphic Encryption.
//
// Setup: Pure data definitions and configuration models.
//
// Beats:
//   1. Define FHE parameters, plaintexts, ciphertexts, and key structures.
//   2. Define evaluation keys, key pairs, and context models.
//   3. Implement checksum calculation and constructor utilities.

type FheParams = struct {
    scheme_type: String,
    poly_modulus_degree: Int,
    plain_modulus: Int,
    security_level: Int,
    is_valid: Bool,
};

type FhePlaintext = struct {
    plain_id: String,
    value: Int,
    encoded_poly: String,
    scale: Int,
    is_valid: Bool,
};

type FheCiphertext = struct {
    cipher_id: String,
    c0_poly: String,
    c1_poly: String,
    scale: Int,
    level: Int,
    noise_budget: Int,
    checksum: Int,
    is_valid: Bool,
};

type FhePublicKey = struct {
    key_id: String,
    pk0_poly: String,
    pk1_poly: String,
    is_valid: Bool,
};

type FheSecretKey = struct {
    key_id: String,
    sk_poly: String,
    is_valid: Bool,
    is_wiped: Bool,
};

type FheRelinKey = struct {
    key_id: String,
    rlk_poly: String,
    is_valid: Bool,
};

type FheGaloisKey = struct {
    key_id: String,
    glk_poly: String,
    is_valid: Bool,
};

type FheEvaluationKey = struct {
    key_id: String,
    relin_poly: String,
    galois_poly: String,
    is_valid: Bool,
};

type FheKeyPair = struct {
    public_key: FhePublicKey,
    secret_key: FheSecretKey,
    evaluation_key: FheEvaluationKey,
    params: FheParams,
    is_valid: Bool,
};

type FheContext = struct {
    context_id: String,
    params: FheParams,
    key_pair: FheKeyPair,
    is_initialized: Bool,
};

pub fn fhe_calculate_checksum(input_str: String) -> Int {
    let len: Int = input_str.len();
    let mut sum: Int = 0;
    let mut i: Int = 0;
    while i < len {
        sum = (sum * 31 + byte_at(input_str, i)) & 2147483647;
        i = i + 1;
    }
    return sum;
}

pub fn fhe_params_init(
    scheme: String,
    poly_deg: Int,
    plain_mod: Int,
    sec_lvl: Int
) -> FheParams {
    let mut valid: Bool = true;
    if poly_deg < 1024 { valid = false; }
    if plain_mod <= 0 { valid = false; }
    if sec_lvl < 128 { valid = false; }
    return FheParams {
        scheme_type: scheme,
        poly_modulus_degree: poly_deg,
        plain_modulus: plain_mod,
        security_level: sec_lvl,
        is_valid: valid,
    };
}

pub fn fhe_params_create(
    scheme: String,
    poly_deg: Int,
    plain_mod: Int,
    coeff_mod: Int,
    sec_lvl: Int
) -> FheParams {
    return fhe_params_init(scheme, poly_deg, plain_mod, sec_lvl);
}

pub fn fhe_params_validate(p: &FheParams) -> Bool {
    return (p).is_valid;
}

pub fn fhe_public_key_create(key_id: String, pk0_poly: String, pk1_poly: String) -> FhePublicKey {
    return FhePublicKey {
        key_id: key_id,
        pk0_poly: pk0_poly,
        pk1_poly: pk1_poly,
        is_valid: true,
    };
}

pub fn fhe_secret_key_create(key_id: String, sk_poly: String) -> FheSecretKey {
    return FheSecretKey {
        key_id: key_id,
        sk_poly: sk_poly,
        is_valid: true,
        is_wiped: false,
    };
}

pub fn fhe_evaluation_key_create(key_id: String, relin_poly: String, galois_poly: String) -> FheEvaluationKey {
    return FheEvaluationKey {
        key_id: key_id,
        relin_poly: relin_poly,
        galois_poly: galois_poly,
        is_valid: true,
    };
}

pub fn fhe_params_new(scheme_id: Int, poly_degree: Int, sec_level: Int) -> FheParams {
    let mut s_type: String = "BFV";
    if scheme_id == 2 { s_type = "BGV"; }
    if scheme_id == 3 { s_type = "CKKS"; }
    return fhe_params_init(s_type, poly_degree, 65537, sec_level);
}

pub fn fhe_params_degree(p: FheParams) -> Int {
    return (p).poly_modulus_degree;
}

pub fn fhe_params_flags(p: FheParams) -> Int {
    if (p).is_valid { return 1; }
    return 0;
}
