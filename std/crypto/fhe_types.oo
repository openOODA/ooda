// # FHE types
//
// Logline: FheParams destubbed off pub type nested keys.
// residual: String / nested FheKeyPair destubbed to Int floor.

type FheParams = struct {
    scheme_id: Int,
    poly_degree: Int,
    flag_bits: Int
};

pub fn fhe_params_new(scheme_id: Int, poly_degree: Int, sec_level: Int) -> FheParams {
    let mut n: Int = poly_degree;
    let mut pow2: Int = 0;
    if n >= 1024 {
        pow2 = 1;
        while n > 1 {
            let rem: Int = n % 2;
            if rem != 0 {
                pow2 = 0;
                n = 1;
            }
            n = n / 2;
        }
    }
    let mut valid: Int = 0;
    if pow2 == 1 {
        if sec_level >= 128 {
            valid = 1;
        }
    }
    let packed: Int = valid + (sec_level * 2);
    return FheParams {
        scheme_id: scheme_id,
        poly_degree: poly_degree,
        flag_bits: packed
    };
}

pub fn fhe_params_degree(p: FheParams) -> Int {
    return p.poly_degree;
}

pub fn fhe_params_flags(p: FheParams) -> Int {
    return p.flag_bits;
}
