// # Keys types
//
// Logline: KeyMetadata destubbed off pub type List[SecretKey].
// residual: List[struct] destubbed to Int floor.

type KeyMetadata = struct {
    key_id: Int,
    bit_length: Int,
    flag_bits: Int
};

pub fn key_meta_new(key_id: Int, bit_length: Int, usage_flags: Int) -> KeyMetadata {
    let mut size_ok: Int = 0;
    if bit_length == 128 {
        size_ok = 1;
    }
    if bit_length == 192 {
        size_ok = 1;
    }
    if bit_length == 256 {
        size_ok = 1;
    }
    let packed: Int = size_ok + (usage_flags * 2);
    return KeyMetadata {
        key_id: key_id,
        bit_length: bit_length,
        flag_bits: packed
    };
}

pub fn key_meta_bits(m: KeyMetadata) -> Int {
    return m.bit_length;
}

pub fn key_meta_flags(m: KeyMetadata) -> Int {
    return m.flag_bits;
}
