// # Keys types
//
// Logline: KeyMetadata, SecretKey, PublicKey, KeyPair, KeyStorePolicy, and KeyStore data types and accessors.
// Setup: Pure crypto types module.

pub type KeyMetadata = struct {
    key_id: String,
    algorithm: String,
    key_type: Int,
    bit_length: Int,
    usage_flags: Int,
    created_at: Int,
    expires_at: Int
};

pub type SecretKey = struct {
    key_id: String,
    algorithm: String,
    key_type: Int,
    bit_length: Int,
    usage_flags: Int,
    created_at: Int,
    expires_at: Int,
    is_revoked: Bool,
    raw_bytes: String,
    checksum: Int,
    is_wiped: Bool
};

pub type PublicKey = struct {
    key_id: String,
    algorithm: String,
    key_type: Int,
    bit_length: Int,
    usage_flags: Int,
    created_at: Int,
    expires_at: Int,
    is_revoked: Bool,
    raw_bytes: String,
    checksum: Int
};

pub type KeyPair = struct {
    public_key: PublicKey,
    secret_key: SecretKey,
    pair_id: String,
    is_valid: Bool
};

pub type KeyStorePolicy = struct {
    require_sys_cap: Bool,
    max_keys: Int,
    allow_export: Bool,
    fail_closed: Bool
};

pub type KeyStore = struct {
    store_id: String,
    policy: KeyStorePolicy,
    secret_keys: List[SecretKey],
    public_keys: List[PublicKey],
    key_pairs: List[KeyPair],
    is_locked: Bool,
    master_key_hash: Int
};

pub fn public_key_is_revoked(pk: PublicKey) -> Bool { return pk.is_revoked; }
pub fn secret_key_is_revoked(sk: SecretKey) -> Bool { return sk.is_revoked; }
pub fn secret_key_is_wiped(sk: SecretKey) -> Bool { return sk.is_wiped; }
pub fn secret_key_raw_bytes(sk: SecretKey) -> String { return sk.raw_bytes; }
pub fn secret_key_checksum(sk: SecretKey) -> Int { return sk.checksum; }
pub fn public_key_raw_bytes(pk: PublicKey) -> String { return pk.raw_bytes; }
pub fn public_key_checksum(pk: PublicKey) -> Int { return pk.checksum; }

pub fn key_calculate_checksum(raw: String) -> Int {
    let len: Int = raw.len();
    let mut sum: Int = 0;
    let mut i: Int = 0;
    while i < len {
        sum = (sum * 31 + byte_at(raw, i)) & 2147483647;
        i = i + 1;
    }
    return sum;
}

pub fn key_type_to_string(t: Int) -> String {
    if t == 0 { return "SYMMETRIC"; }
    if t == 1 { return "ASYMMETRIC_PUBLIC"; }
    if t == 2 { return "ASYMMETRIC_PRIVATE"; }
    return "UNKNOWN";
}

pub fn key_metadata_create(key_id: String, algorithm: String, key_type: Int, bit_length: Int, usage_flags: Int, created_at: Int, expires_at: Int) -> KeyMetadata {
    return KeyMetadata {
        key_id: key_id,
        algorithm: algorithm,
        key_type: key_type,
        bit_length: bit_length,
        usage_flags: usage_flags,
        created_at: created_at,
        expires_at: expires_at
    };
}

pub fn secret_key_create(meta: KeyMetadata, raw_bytes: String) -> SecretKey {
    let chk: Int = key_calculate_checksum(raw_bytes);
    return SecretKey {
        key_id: meta.key_id,
        algorithm: meta.algorithm,
        key_type: meta.key_type,
        bit_length: meta.bit_length,
        usage_flags: meta.usage_flags,
        created_at: meta.created_at,
        expires_at: meta.expires_at,
        is_revoked: false,
        raw_bytes: raw_bytes,
        checksum: chk,
        is_wiped: false
    };
}

pub fn public_key_create(meta: KeyMetadata, raw_bytes: String) -> PublicKey {
    let chk: Int = key_calculate_checksum(raw_bytes);
    return PublicKey {
        key_id: meta.key_id,
        algorithm: meta.algorithm,
        key_type: meta.key_type,
        bit_length: meta.bit_length,
        usage_flags: meta.usage_flags,
        created_at: meta.created_at,
        expires_at: meta.expires_at,
        is_revoked: false,
        raw_bytes: raw_bytes,
        checksum: chk
    };
}
