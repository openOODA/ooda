// # HMAC-SHA256 one-shot
//
// Logline: Forward hmac_sha256 to the runtime hex MAC and verify that hex tag.
//
// Setup: crypto_hmac_sha256_internal is product C (FIPS 198 / RFC 2104).
//
// Beats:
//   1. hmac_sha256 returns the 64-char lowercase hex tag.
//   2. hmac_sign is that same one-shot.
//   3. hmac_verify accepts only an exact hex match of hmac_sha256.

pub fn hmac_sha256(key: String, message: String) -> String {
    return crypto_hmac_sha256_internal(key, message);
}

pub fn hmac_sign(key: String, message: String) -> String {
    return hmac_sha256(key, message);
}

pub fn hmac_verify(key: String, message: String, signature: String) -> Bool {
    let got: String = hmac_sha256(key, message);
    if got.len() != signature.len() {
        return false;
    }
    return got == signature;
}
