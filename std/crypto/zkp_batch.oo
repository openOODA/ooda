// # ZKP Batch and Aggregation
//
// Logline: Provides batch verification and proof aggregation algorithms for ZKP.
//
// Setup: Imports companion modules for proof verification.
//
// Beats:
//   1. Aggregate multiple ZKP proofs for batch evaluation.
//   2. Execute multiscalar multiplication and random linear combinations.
//   3. Verify aggregate commitments with reduced computational overhead.

import "./zkp_engine.oo";

pub fn zkp_batch_verifier_init(bv_id: String) -> ZkpBatchVerifier {
    let bv_empty_proofs: List[ZkpProof] = list_new();
    let bv_empty_stmts: List[ZkpStatement] = list_new();
    return ZkpBatchVerifier {
        batch_id: bv_id,
        proofs: bv_empty_proofs,
        statements: bv_empty_stmts,
        verified_count: 0,
        failed_count: 0,
        is_completed: false,
    };
}

pub fn zkp_batch_verifier_add(
    bv_ctx: &mut ZkpBatchVerifier,
    bv_zk_proof: ZkpProof,
    bv_stmt: ZkpStatement
) {
    if (bv_ctx.is_completed) == true {
        return;
    }
    bv_ctx.proofs = list_push(bv_ctx.proofs, bv_zk_proof);
    bv_ctx.statements = list_push(bv_ctx.statements, bv_stmt);
}

pub fn zkp_batch_verifier_verify_all(
    bva_vf: &mut ZkpVerifier,
    bva_batch: &mut ZkpBatchVerifier
) -> Bool {
    if (bva_batch.is_completed) == true {
        return (bva_batch.failed_count) == 0;
    }

    let bva_num = list_len(bva_batch.proofs);
    let mut bva_idx = 0;
    let mut bva_pass = 0;
    let mut bva_fail = 0;

    while bva_idx < bva_num {
        let bva_p = list_get(bva_batch.proofs, bva_idx);
        let bva_s = list_get(bva_batch.statements, bva_idx);

        let bva_ok = zkp_verifier_verify_proof(bva_vf, bva_p, bva_s);
        if bva_ok {
            bva_pass = bva_pass + 1;
        } else {
            bva_fail = bva_fail + 1;
        }
        bva_idx = bva_idx + 1;
    }

    bva_batch.verified_count = bva_pass;
    bva_batch.failed_count = bva_fail;
    bva_batch.is_completed = true;

    return (bva_batch.failed_count) == 0;
}

// -------------------------------------------------------------------
// Proof Serialization & Work Metrics
// -------------------------------------------------------------------

pub fn zkp_proof_to_string(str_zkproof: ZkpProof) -> String {
    let zkp_id_str = str_zkproof.proof_id;
    let zkp_comm_str = (str_zkproof.commitment).to_string();
    let zkp_resp_str = (str_zkproof.response).to_string();
    let zkp_pub_str = (str_zkproof.public_input).to_string();
    return "ZkpProof[" + zkp_id_str + "] Comm:" + zkp_comm_str + " Resp:" + zkp_resp_str + " Pub:" + zkp_pub_str;
}

pub fn zkp_do_work(wrk_prover: &ZkpProver, wrk_verifier: &ZkpVerifier) -> Int {
    let wrk_p_gen = wrk_prover.proofs_generated;
    let wrk_v_ver = wrk_verifier.proofs_verified;
    let wrk_v_rej = wrk_verifier.proofs_rejected;
    return wrk_p_gen + wrk_v_ver + wrk_v_rej;
}
