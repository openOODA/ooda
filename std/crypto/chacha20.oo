// # ChaCha20 block
//
// Logline: RFC 8439 20-round block; XOR encrypt and decrypt at most 64 bytes.
//
// Setup: Pure 32-bit add/xor/rotl. Key 32 bytes, nonce 12 bytes, block counter.
//
// Beats:
//   1. Load constants, LE key, counter, LE nonce.
//   2. Ten double-rounds, add the start state, emit hex.
//   3. Encrypt XORs keystream to hex. Decrypt hex-decodes and XORs the same stream.

type CC4 = struct {
    a: Int,
    b: Int,
    c: Int,
    d: Int
};

type CCSt = struct {
    s0: Int,
    s1: Int,
    s2: Int,
    s3: Int,
    s4: Int,
    s5: Int,
    s6: Int,
    s7: Int,
    s8: Int,
    s9: Int,
    s10: Int,
    s11: Int,
    s12: Int,
    s13: Int,
    s14: Int,
    s15: Int
};

fn cc_mask(x: Int) -> Int {
    return x & 4294967295;
}

fn cc_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn cc_rotl(x: Int, r: Int) -> Int {
    let v: Int = cc_mask(x);
    let left: Int = (v << r) & 4294967295;
    let right: Int = v >> (32 - r);
    return (left | right) & 4294967295;
}

fn cc_qr(w: CC4) -> CC4 {
    let mut a: Int = w.a;
    let mut b: Int = w.b;
    let mut c: Int = w.c;
    let mut d: Int = w.d;
    a = cc_mask(a + b);
    d = cc_rotl(cc_xor(d, a), 16);
    c = cc_mask(c + d);
    b = cc_rotl(cc_xor(b, c), 12);
    a = cc_mask(a + b);
    d = cc_rotl(cc_xor(d, a), 8);
    c = cc_mask(c + d);
    b = cc_rotl(cc_xor(b, c), 7);
    return CC4 { a: a, b: b, c: c, d: d };
}

fn cc_get(s: CCSt, i: Int) -> Int {
    if i == 0 { return s.s0; }
    if i == 1 { return s.s1; }
    if i == 2 { return s.s2; }
    if i == 3 { return s.s3; }
    if i == 4 { return s.s4; }
    if i == 5 { return s.s5; }
    if i == 6 { return s.s6; }
    if i == 7 { return s.s7; }
    if i == 8 { return s.s8; }
    if i == 9 { return s.s9; }
    if i == 10 { return s.s10; }
    if i == 11 { return s.s11; }
    if i == 12 { return s.s12; }
    if i == 13 { return s.s13; }
    if i == 14 { return s.s14; }
    return s.s15;
}

fn cc_set(s: CCSt, i: Int, v: Int) -> CCSt {
    if i == 0 { return CCSt { s0: v, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 1 { return CCSt { s0: s.s0, s1: v, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 2 { return CCSt { s0: s.s0, s1: s.s1, s2: v, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 3 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: v, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 4 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: v, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 5 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: v, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 6 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: v, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 7 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: v, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 8 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: v, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 9 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: v, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 10 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: v, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 11 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: v, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 12 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: v, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 13 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: v, s14: s.s14, s15: s.s15 }; }
    if i == 14 { return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: v, s15: s.s15 }; }
    return CCSt { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: v };
}

fn cc_col(s: CCSt, i0: Int, i1: Int, i2: Int, i3: Int) -> CCSt {
    let w0: CC4 = CC4 { a: cc_get(s, i0), b: cc_get(s, i1), c: cc_get(s, i2), d: cc_get(s, i3) };
    let w1: CC4 = cc_qr(w0);
    let mut t: CCSt = cc_set(s, i0, w1.a);
    t = cc_set(t, i1, w1.b);
    t = cc_set(t, i2, w1.c);
    t = cc_set(t, i3, w1.d);
    return t;
}

fn cc_le32(data: String, off: Int) -> Int {
    let b0: Int = byte_at(data, off);
    let b1: Int = byte_at(data, off + 1);
    let b2: Int = byte_at(data, off + 2);
    let b3: Int = byte_at(data, off + 3);
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24);
}

fn cc_hex_byte(b: Int) -> String {
    let hex: String = "0123456789abcdef";
    let hi: Int = (b >> 4) & 15;
    let lo: Int = b & 15;
    return char_at(hex, hi) + char_at(hex, lo);
}

fn cc_word_hex(w: Int) -> String {
    let v: Int = cc_mask(w);
    let b0: Int = v & 255;
    let b1: Int = (v >> 8) & 255;
    let b2: Int = (v >> 16) & 255;
    let b3: Int = (v >> 24) & 255;
    return cc_hex_byte(b0) + cc_hex_byte(b1) + cc_hex_byte(b2) + cc_hex_byte(b3);
}

pub fn chacha20_block(key: String, nonce: String, counter: Int) -> String {
    if key.len() != 32 {
        process_exit(1);
        return "";
    }
    if nonce.len() != 12 {
        process_exit(1);
        return "";
    }
    let mut s: CCSt = CCSt {
        s0: 1634760805,
        s1: 857760878,
        s2: 2036477234,
        s3: 1797285236,
        s4: cc_le32(key, 0),
        s5: cc_le32(key, 4),
        s6: cc_le32(key, 8),
        s7: cc_le32(key, 12),
        s8: cc_le32(key, 16),
        s9: cc_le32(key, 20),
        s10: cc_le32(key, 24),
        s11: cc_le32(key, 28),
        s12: cc_mask(counter),
        s13: cc_le32(nonce, 0),
        s14: cc_le32(nonce, 4),
        s15: cc_le32(nonce, 8)
    };
    let start: CCSt = s;
    let mut r: Int = 0;
    while r < 10 {
        s = cc_col(s, 0, 4, 8, 12);
        s = cc_col(s, 1, 5, 9, 13);
        s = cc_col(s, 2, 6, 10, 14);
        s = cc_col(s, 3, 7, 11, 15);
        s = cc_col(s, 0, 5, 10, 15);
        s = cc_col(s, 1, 6, 11, 12);
        s = cc_col(s, 2, 7, 8, 13);
        s = cc_col(s, 3, 4, 9, 14);
        r = r + 1;
    }
    let mut out: String = "";
    let mut i: Int = 0;
    while i < 16 {
        let w: Int = cc_mask(cc_get(s, i) + cc_get(start, i));
        out = out + cc_word_hex(w);
        i = i + 1;
    }
    return out;
}

fn cc_nibble(b: Int) -> Int {
    if b >= 48 {
        if b <= 57 {
            return b - 48;
        }
    }
    if b >= 97 {
        if b <= 102 {
            return b - 87;
        }
    }
    return 0;
}

pub fn chacha20_encrypt(key: String, nonce: String, plaintext: String) -> String {
    let n: Int = bytes_len(plaintext);
    if n > 64 {
        process_exit(1);
        return "";
    }
    if n == 0 {
        return "";
    }
    let ks: String = chacha20_block(key, nonce, 1);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let kb: Int = cc_nibble(byte_at(ks, i * 2)) * 16 + cc_nibble(byte_at(ks, i * 2 + 1));
        let pb: Int = byte_at(plaintext, i);
        out = out + cc_hex_byte(cc_xor(kb, pb));
        i = i + 1;
    }
    return out;
}

pub fn chacha20_decrypt(key: String, nonce: String, cipher_hex: String) -> String {
    let hn: Int = cipher_hex.len();
    if (hn % 2) != 0 {
        process_exit(1);
        return "";
    }
    let n: Int = hn / 2;
    if n > 64 {
        process_exit(1);
        return "";
    }
    if n == 0 {
        return "";
    }
    let ks: String = chacha20_block(key, nonce, 1);
    let mut out: List[Int] = bytes_new();
    let mut i: Int = 0;
    while i < n {
        let kb: Int = cc_nibble(byte_at(ks, i * 2)) * 16 + cc_nibble(byte_at(ks, i * 2 + 1));
        let cb: Int = cc_nibble(byte_at(cipher_hex, i * 2)) * 16 + cc_nibble(byte_at(cipher_hex, i * 2 + 1));
        out = bytes_push(out, cc_xor(kb, cb));
        i = i + 1;
    }
    return bytes_to_str(out);
}
