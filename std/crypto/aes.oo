// # AES-128-ECB one-shot
//
// Logline: Encrypt 16-byte blocks with the runtime cipher and decrypt them with aes_inv_block.
//
// Setup: crypto_aes_encrypt_internal is product C. Decrypt is FIPS-197 inverse in aes_inv.oo.
//
// Beats:
//   1. aes_encrypt forwards to the runtime block cipher and returns hex.
//   2. Unaligned encrypt input returns the runtime residual string.
//   3. aes_decrypt hex-decodes the cipher, inverts each block, and returns raw bytes.

import "aes_inv.oo";

fn aes_nibble_pub(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 { return ch - 48; }
    }
    if ch >= 97 {
        if ch <= 102 { return ch - 87; }
    }
    if ch >= 65 {
        if ch <= 70 { return ch - 55; }
    }
    return -1;
}

fn aes_unhex(hex: String) -> String {
    let n: Int = hex.len();
    if n % 2 != 0 {
        process_exit(1);
        return "";
    }
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < n {
        let hi_v: Int = aes_nibble_pub(byte_at(hex, i));
        let lo_v: Int = aes_nibble_pub(byte_at(hex, i + 1));
        if hi_v < 0 {
            process_exit(1);
            return "";
        }
        if lo_v < 0 {
            process_exit(1);
            return "";
        }
        buf = bytes_push(buf, hi_v * 16 + lo_v);
        i = i + 2;
    }
    return bytes_to_str(buf);
}

fn aes_blk(s: String, off: Int) -> String {
    let mut buf: List[Int] = bytes_new();
    let mut i: Int = 0;
    while i < 16 {
        buf = bytes_push(buf, byte_at(s, off + i));
        i = i + 1;
    }
    return bytes_to_str(buf);
}

pub fn aes_encrypt(key: String, plain: String) -> String {
    return crypto_aes_encrypt_internal(key, plain);
}

pub fn aes_decrypt(key: String, cipher_hex: String) -> String {
    if bytes_len(key) != 16 {
        process_exit(1);
        return "";
    }
    let ct: String = aes_unhex(cipher_hex);
    let n: Int = bytes_len(ct);
    if n < 16 {
        process_exit(1);
        return "";
    }
    if (n % 16) != 0 {
        process_exit(1);
        return "";
    }
    let mut out: List[Int] = bytes_new();
    let mut off: Int = 0;
    while off < n {
        let p: String = aes_inv_block(key, aes_blk(ct, off));
        let mut j: Int = 0;
        while j < 16 {
            out = bytes_push(out, byte_at(p, j));
            j = j + 1;
        }
        off = off + 16;
    }
    return bytes_to_str(out);
}
