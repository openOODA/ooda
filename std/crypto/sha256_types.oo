// # SHA-256 types
//
// Logline: Sha256State destubbed off working-register lists.
// residual: List[struct] destubbed.

type Sha256State = struct {
    h0: Int,
    h1: Int
};

pub fn sha256_state_new(h0: Int, h1: Int) -> Sha256State {
    return Sha256State {
        h0: h0,
        h1: h1
    };
}

pub fn sha256_state_h0(s: Sha256State) -> Int {
    return s.h0;
}
