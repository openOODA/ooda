// # SHA-256 types
//
// Logline: Sha256State and Sha256Working state structures.
// Setup: Pure crypto types module.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//

type Sha256State = struct {
    h0: Int,
    h1: Int,
    h2: Int,
    h3: Int,
    h4: Int,
    h5: Int,
    h6: Int,
    h7: Int
};

type Sha256Working = struct {
    a: Int,
    b: Int,
    c: Int,
    d: Int,
    e: Int,
    f: Int,
    g: Int,
    h: Int
};

pub fn sha256_state_new(h0: Int, h1: Int, h2: Int, h3: Int, h4: Int, h5: Int, h6: Int, h7: Int) -> Sha256State {
    return Sha256State {
        h0: h0,
        h1: h1,
        h2: h2,
        h3: h3,
        h4: h4,
        h5: h5,
        h6: h6,
        h7: h7
    };
}

pub fn sha256_working_from_state(s: Sha256State) -> Sha256Working {
    return Sha256Working {
        a: s.h0,
        b: s.h1,
        c: s.h2,
        d: s.h3,
        e: s.h4,
        f: s.h5,
        g: s.h6,
        h: s.h7
    };
}

pub fn sha256_state_h0(s: Sha256State) -> Int {
    return s.h0;
}
