// # ZKP Math and Modular Arithmetic
//
// Logline: Provides prime field arithmetic, modular exponentiation, and number-theoretic primitives.
//
// Setup: Imports zkp_types.oo for mathematical structures.
//
// Beats:
//   1. Implement modular addition, subtraction, and multiplication.
//   2. Provide modular inverse and exponentiation routines.
//   3. Support prime field hashing and vector operations.

import "./zkp_types.oo";

pub fn zkp_mod_pow(base_val: Int, exp_val: Int, mod_val: Int) -> Int {
    if mod_val <= 1 {
        return 0;
    }
    let mut m_res = 1;
    let mut m_base = base_val % mod_val;
    if m_base < 0 {
        m_base = m_base + mod_val;
    }
    let mut m_exp = exp_val;
    while m_exp > 0 {
        if (m_exp % 2) == 1 {
            m_res = (m_res * m_base) % mod_val;
        }
        m_exp = m_exp / 2;
        m_base = (m_base * m_base) % mod_val;
    }
    return m_res;
}

pub fn zkp_mod_mul(mul_a: Int, mul_b: Int, mod_val: Int) -> Int {
    if mod_val <= 0 {
        return 0;
    }
    let a_mod = mul_a % mod_val;
    let b_mod = mul_b % mod_val;
    let mut mul_res = (a_mod * b_mod) % mod_val;
    if mul_res < 0 {
        mul_res = mul_res + mod_val;
    }
    return mul_res;
}

pub fn zkp_mod_add(add_a: Int, add_b: Int, mod_val: Int) -> Int {
    if mod_val <= 0 {
        return 0;
    }
    let mut add_res = (add_a + add_b) % mod_val;
    if add_res < 0 {
        add_res = add_res + mod_val;
    }
    return add_res;
}

pub fn zkp_mod_sub(sub_a: Int, sub_b: Int, mod_val: Int) -> Int {
    if mod_val <= 0 {
        return 0;
    }
    let mut sub_res = (sub_a - sub_b) % mod_val;
    if sub_res < 0 {
        sub_res = sub_res + mod_val;
    }
    return sub_res;
}

pub fn zkp_hash_challenge(hc_comm: Int, hc_pub: Int, mod_val: Int) -> Int {
    let mut hc_h = 5381;
    hc_h = (hc_h * 33) + hc_comm;
    hc_h = (hc_h * 33) + hc_pub;
    if hc_h < 0 {
        hc_h = 0 - hc_h;
    }
    let hc_m = mod_val - 1;
    if hc_m <= 0 {
        return 1;
    }
    let hc_res = (hc_h % hc_m) + 1;
    return hc_res;
}
