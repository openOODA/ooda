// # SHA-256 and HMAC-SHA256
//
// Logline: Forward to runtime crypto_sha256_internal and crypto_hmac_sha256_internal.
//
// Setup: Pure wrappers. No requires method calls (those do not emit).
//
// Beats:
//   1. sha256 returns the 64-char hex digest.
//   2. hmac_sha256 refuses an empty key and otherwise returns 64 hex chars.
//   3. AES and other leaves stay residual.

pub fn sha256(data: String) -> String {
    return crypto_sha256_internal(data);
}

pub fn hmac_sha256(key: String, message: String) -> String {
    if key.len() == 0 {
        return "";
    }
    return crypto_hmac_sha256_internal(key, message);
}
