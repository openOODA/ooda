// # ZKP Fail-Closed Stubs
//
// Logline: Enforces fail-closed process exit barriers for unverified cryptographic operations in ZKP.
//
// Setup: Imports companion modules for fail-closed stub declarations.
//
// Beats:
//   1. Import ZKP engine and state types.
//   2. Trap unverified low-level primitives with process_exit(1).
//   3. Guard unaudited hardware acceleration and FFI routines.

import "./zkp_batch.oo";

pub fn zkp_eval_groth16_pairing(g16_proof: ZkpProof, g16_vk: String) -> Bool {
    // COMPILER LIMITATION: Missing support for BN254 / BLS12-381 pairing operations and G1/G2 point representations required for Groth16 zk-SNARK verification.
    process_exit(1);
    return false;
}

pub fn zkp_eval_stark_fri_fold(stk_proof: ZkpProof, stk_params: String) -> Bool {
    // COMPILER LIMITATION: Missing support for Merkle tree vector commitments and Reed-Solomon FRI folding required for STARK proofs.
    process_exit(1);
    return false;
}

// -------------------------------------------------------------------
// Verification Tests
// -------------------------------------------------------------------

verify zkp {
    let v_modulus = 1009;
    let v_generator = 11;
    let v_sec_gen = 17;
    let v_secret = 42;
    let v_blinding = 123;

    let v_pub_key = zkp_mod_pow(v_generator, v_secret, v_modulus);
    let v_schnorr = schnorr_prove(v_secret, v_pub_key, v_generator, v_blinding, v_modulus);
    assert_eq!(schnorr_verify(v_schnorr), true);

    let v_comm1 = pedersen_commitment_create(v_generator, v_sec_gen, 10, 5, v_modulus);
    let v_comm2 = pedersen_commitment_create(v_generator, v_sec_gen, 20, 7, v_modulus);
    let v_comm_sum = pedersen_commitment_homomorphic_add(v_comm1, v_comm2);
    let v_expected_sum = pedersen_commitment_create(v_generator, v_sec_gen, 30, 12, v_modulus);
    assert_eq!(v_comm_sum.commitment, v_expected_sum.commitment);

    let v_range_p = zkp_range_prove(15, 0, 100, 99, v_generator, v_sec_gen, v_modulus);
    assert_eq!(zkp_range_verify(v_range_p, v_generator, v_sec_gen, v_modulus), true);

    let mut v_prover = zkp_prover_init("P1", 1, 128, v_modulus, v_generator, v_sec_gen);
    let mut v_verifier = zkp_verifier_init("V1", 1, 128, v_modulus, v_generator, v_sec_gen);

    let v_stmt = zkp_statement_create("S1", "params", v_pub_key, v_modulus, 1);
    let v_wit = zkp_witness_create("W1", v_secret, v_blinding, 1);

    let v_main_proof = zkp_prover_create_proof(&mut v_prover, v_stmt, v_wit);
    let v_verified = zkp_verifier_verify_proof(&mut v_verifier, v_main_proof, v_stmt);
    assert_eq!(v_verified, true);
    assert_eq!(v_prover.proofs_generated, 1);
    assert_eq!(v_verifier.proofs_verified, 1);

    let mut v_batch = zkp_batch_verifier_init("B1");
    zkp_batch_verifier_add(&mut v_batch, v_main_proof, v_stmt);
    let v_batch_ok = zkp_batch_verifier_verify_all(&mut v_verifier, &mut v_batch);
    assert_eq!(v_batch_ok, true);
}
