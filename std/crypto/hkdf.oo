// # HKDF-SHA256 extract and expand
//
// Logline: RFC 5869 extract is HMAC-SHA256; expand is T(i)=HMAC(PRK, T(i-1)||info||i).
//
// Setup: hmac_sha256 returns hex; expand hex-decodes T for the next round. Combined hkdf is extract then expand.
//
// Beats:
//   1. hkdf_extract returns the 64-char PRK hex.
//   2. hkdf_expand returns lowercase hex of L output bytes; refuses L<1 or L>8160.
//   3. hkdf(salt, ikm, info, L) decodes extract and expands to L bytes of hex.

import "hmac.oo";

fn hkdf_nibble(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 {
            return ch - 48;
        }
    }
    if ch >= 97 {
        if ch <= 102 {
            return ch - 87;
        }
    }
    if ch >= 65 {
        if ch <= 70 {
            return ch - 55;
        }
    }
    return -1;
}

fn hkdf_hex_decode(hex: String) -> String {
    let n: Int = hex.len();
    let rem: Int = n % 2;
    if rem != 0 {
        process_exit(1);
        return "";
    }
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < n {
        let hi_v: Int = hkdf_nibble(byte_at(hex, i));
        let lo_v: Int = hkdf_nibble(byte_at(hex, i + 1));
        if hi_v < 0 {
            process_exit(1);
            return "";
        }
        if lo_v < 0 {
            process_exit(1);
            return "";
        }
        buf = bytes_push(buf, hi_v * 16 + lo_v);
        i = i + 2;
    }
    return bytes_to_str(buf);
}

pub fn hkdf_extract(salt: String, ikm: String) -> String {
    return hmac_sha256(salt, ikm);
}

pub fn hkdf_expand(prk: String, info: String, length: Int) -> String {
    if length < 1 {
        process_exit(1);
        return "";
    }
    if length > 8160 {
        process_exit(1);
        return "";
    }
    let hex: String = "0123456789abcdef";
    let mut t_prev: String = "";
    let mut okm: List[Int] = bytes_new();
    let mut got: Int = 0;
    let mut ctr: Int = 1;
    while got < length {
        let mut msg: List[Int] = bytes_new();
        let tlen: Int = bytes_len(t_prev);
        let mut j: Int = 0;
        while j < tlen {
            msg = bytes_push(msg, byte_at(t_prev, j));
            j = j + 1;
        }
        let ilen: Int = bytes_len(info);
        j = 0;
        while j < ilen {
            msg = bytes_push(msg, byte_at(info, j));
            j = j + 1;
        }
        msg = bytes_push(msg, ctr);
        let t_hex: String = hmac_sha256(prk, bytes_to_str(msg));
        t_prev = hkdf_hex_decode(t_hex);
        let tn: Int = bytes_len(t_prev);
        j = 0;
        while j < tn {
            if got < length {
                okm = bytes_push(okm, byte_at(t_prev, j));
                got = got + 1;
            }
            j = j + 1;
        }
        ctr = ctr + 1;
    }
    let raw: String = bytes_to_str(okm);
    let mut out: List[Int] = bytes_new();
    let mut k: Int = 0;
    while k < length {
        let b: Int = byte_at(raw, k);
        out = bytes_push(out, byte_at(hex, (b / 16) % 16));
        out = bytes_push(out, byte_at(hex, b % 16));
        k = k + 1;
    }
    return bytes_to_str(out);
}

pub fn hkdf(salt: String, ikm: String, info: String, length: Int) -> String {
    let prk_hex: String = hkdf_extract(salt, ikm);
    let prk: String = hkdf_hex_decode(prk_hex);
    return hkdf_expand(prk, info, length);
}
