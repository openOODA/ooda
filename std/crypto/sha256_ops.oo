// # SHA-256 Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for SHA256.
//
// Setup: Imports sha256_types.oo for data structure definitions.
//
// Beats:
//   1. Import SHA256 types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./sha256_types.oo";

pub fn rotr(x: Int, n: Int) -> Int {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

pub fn ch(x: Int, y: Int, z: Int) -> Int {
    return (x & y) ^ ((x ^ 4294967295) & z);
}

pub fn maj(x: Int, y: Int, z: Int) -> Int {
    return (x & y) ^ (x & z) ^ (y & z);
}

pub fn bsig0(x: Int) -> Int {
    return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22);
}

pub fn bsig1(x: Int) -> Int {
    return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25);
}

pub fn ssig0(x: Int) -> Int {
    return rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3);
}

pub fn ssig1(x: Int) -> Int {
    return rotr(x, 17) ^ rotr(x, 19) ^ (x >> 10);
}

// One SHA-256 compression round (public for cross-module use / API stability).
pub fn sha256_round(wr: Sha256Working, k: Int, w: Int) -> Sha256Working {
    let t1 = (wr.h + bsig1(wr.e) + ch(wr.e, wr.f, wr.g) + k + w) & 4294967295;
    let t2 = (bsig0(wr.a) + maj(wr.a, wr.b, wr.c)) & 4294967295;
    return Sha256Working {
        a: (t1 + t2) & 4294967295,
        b: wr.a,
        c: wr.b,
        d: wr.c,
        e: (wr.d + t1) & 4294967295,
        f: wr.e,
        g: wr.f,
        h: wr.g
    };
}
