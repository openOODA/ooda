// # Curve25519 Fail-Closed Facade
//
// Logline: Fail-closed process_exit facade for Curve25519 keygen, derive, and exchange. Not real X25519.
//
// Setup: oodac R1 lacks bitwise operators. Curve25519 needs masking/clamping and 255-bit arithmetic.
//
// Beats:
//   1. generate_secret_key: refuse X25519 secret-key generation.
//   2. derive_public_key: refuse scalar-base multiplication without bitwise FFI.
//   3. exchange: refuse X25519 ECDH without conditional swaps.
//   4. process_exit(1): default-deny on unbuilt bitwise primitives.
//   5. SecretKey / PublicKey / SharedSecret: carry byte buffers and lengths.
//
// residual: NOT production key exchange; use libsodium or equivalent.

type SecretKey = struct {
    bytes: &String,
    len: Int
};

type PublicKey = struct {
    bytes: &String,
    len: Int
};

type SharedSecret = struct {
    bytes: &String,
    len: Int
};

pub fn generate_secret_key() -> SecretKey {
    // Hard compiler limitation: openOODA R1 check lacks bitwise operations.
    // Curve25519 requires bit-level manipulation (masking/clamping, 255-bit arith).
    // Keeping process_exit(1) stub.
    process_exit(1);
    return generate_secret_key();
}

pub fn derive_public_key(sk: &SecretKey) -> PublicKey {
    // Hard compiler limitation: openOODA R1 check lacks bitwise operations.
    // Curve25519 requires conditional swaps and 255-bit arithmetic.
    // Keeping process_exit(1) stub.
    process_exit(1);
    return derive_public_key(sk);
}

pub fn exchange(sk: &SecretKey, pk: &PublicKey) -> SharedSecret {
    // Hard compiler limitation: openOODA R1 check lacks bitwise operations.
    // Curve25519 requires conditional swaps and 255-bit arithmetic.
    // Keeping process_exit(1) stub.
    process_exit(1);
    return exchange(sk, pk);
}
