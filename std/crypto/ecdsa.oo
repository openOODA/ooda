// # ECDSA Fail-Closed Facade
//
// Logline: Fail-closed process_exit facade for ECDSA keygen, sign, and verify. Not real ECDSA.
//
// Setup: oodac R1 lacks BigInt and byte arrays required for random scalars and elliptic curve multiplication.
//
// Beats:
//   1. ecdsa_generate_keypair: refuse keypair generation without BigInt curve math.
//   2. ecdsa_sign: refuse signature creation without ephemeral-k and modular-invert.
//   3. ecdsa_verify: refuse signature verification without modular inverses and double multiplication.
//   4. process_exit(1): default-deny on unbuilt BigInt surface.
//   5. ECDSAPrivateKey / PublicKey / Signature: carry scalar/coord byte refs and curve id.
//
// residual: NOT production signatures; use a vetted library.

type ECDSAPrivateKey = struct {
    d_scalar: &String,
    curve_id: Int
};

type ECDSAPublicKey = struct {
    x_coord: &String,
    y_coord: &String,
    curve_id: Int
};

type ECDSASignature = struct {
    r_val: &String,
    s_val: &String
};

pub fn ecdsa_generate_keypair() -> Int {
    // COMPILER LIMITATION: Missing BigInt and byte arrays required for
    // random scalars and elliptic curve point multiplication.
    // Keeping process_exit(1) as a fail-closed stub.
    process_exit(1);
    return ecdsa_generate_keypair();
}

pub fn ecdsa_sign(msg_hash: &String, priv_key: &ECDSAPrivateKey) -> ECDSASignature {
    // COMPILER LIMITATION: Missing BigInt arithmetic and byte arrays
    // required for ephemeral k, invert, and r/s computation.
    // Keeping process_exit(1) as a fail-closed stub.
    process_exit(1);
    return ecdsa_sign(msg_hash, priv_key);
}

pub fn ecdsa_verify(msg_hash: &String, sig: &ECDSASignature, pub_key: &ECDSAPublicKey) -> Bool {
    // COMPILER LIMITATION: Missing BigInt arithmetic and byte arrays
    // needed for modular inverses and double point multiplication.
    // Keeping process_exit(1) as a fail-closed stub.
    process_exit(1);
    return ecdsa_verify(msg_hash, sig, pub_key);
}
