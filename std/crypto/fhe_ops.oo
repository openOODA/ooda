// # FHE Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for FHE.
//
// Setup: Imports fhe_types.oo for data structure definitions.
//
// Beats:
//   1. Import FHE types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./fhe_types.oo";

pub fn fhe_ops_probe() -> Int {
    return 1;
}

pub fn fhe_encode_int(encode_val: Int, encode_params: FheParams) -> FhePlaintext {
    let p_mod: Int = (encode_params).plain_modulus;
    let mod_val: Int = encode_val % p_mod;
    let val_str: String = mod_val.to_string();
    let enc_poly: String = "poly_val_" + val_str;
    let raw_val_str: String = encode_val.to_string();
    let plain_id_str: String = "plain_" + raw_val_str;

    return FhePlaintext {
        plain_id: plain_id_str,
        value: mod_val,
        encoded_poly: enc_poly,
        scale: 1,
        is_valid: true,
    };
}

pub fn fhe_decode_int(decode_plain: FhePlaintext) -> Result[Int, String] {
    if (decode_plain).is_valid == false {
        return Err("INVALID_PLAINTEXT: Cannot decode invalid plaintext structure");
    }
    return Ok((decode_plain).value);
}

pub fn fhe_encrypt(
    encrypt_pk: FhePublicKey,
    encrypt_params: FheParams,
    encrypt_plain: FhePlaintext
) -> Result[FheCiphertext, String] {
    if (encrypt_pk).is_valid == false { return Err("INVALID_PUBLIC_KEY: FHE public key is invalid"); }
    if (encrypt_params).is_valid == false { return Err("INVALID_PARAMS: FHE scheme parameters are invalid"); }
    if (encrypt_plain).is_valid == false { return Err("INVALID_PLAINTEXT: Plaintext payload is invalid"); }

    let enc_plain_val: Int = (encrypt_plain).value;
    let enc_plain_scale: Int = (encrypt_plain).scale;
    let val_str: String = enc_plain_val.to_string();
    let pub_pk0: String = (encrypt_pk).pk0_poly;
    let pub_pk1: String = (encrypt_pk).pk1_poly;
    let c0_str: String = "c0_" + pub_pk0 + "_" + val_str;
    let c1_str: String = "c1_" + pub_pk1 + "_" + val_str;
    let checksum_combined: String = c0_str + c1_str;
    let chk_val: Int = fhe_calculate_checksum(checksum_combined);
    let new_cipher_id: String = "cipher_" + val_str;

    return Ok(FheCiphertext {
        cipher_id: new_cipher_id,
        c0_poly: c0_str,
        c1_poly: c1_str,
        scale: enc_plain_scale,
        level: 0,
        noise_budget: 100,
        checksum: chk_val,
        is_valid: true,
    });
}

pub fn fhe_encrypt_with_capability(
    _sys_cap: &SysCap,
    encrypt_cap_pk: FhePublicKey,
    encrypt_cap_params: FheParams,
    encrypt_cap_plain: FhePlaintext
) -> Result[FheCiphertext, String] {
    return fhe_encrypt(encrypt_cap_pk, encrypt_cap_params, encrypt_cap_plain);
}

pub fn fhe_decrypt(
    decrypt_sk: FheSecretKey,
    decrypt_params: FheParams,
    decrypt_cipher: FheCiphertext
) -> Result[FhePlaintext, String] {
    if (decrypt_sk).is_wiped == true { return Err("KEY_WIPED: Secret key has been zeroized"); }
    if (decrypt_cipher).is_valid == false { return Err("INVALID_CIPHERTEXT: Cannot decrypt invalid ciphertext"); }
    if (decrypt_params).is_valid == false { return Err("INVALID_PARAMS: FHE scheme parameters are invalid"); }

    let dec_plain_mod: Int = (decrypt_params).plain_modulus;
    let cipher_checksum_val: Int = (decrypt_cipher).checksum;
    let decoded_val: Int = cipher_checksum_val % dec_plain_mod;
    let target_cipher_id: String = (decrypt_cipher).cipher_id;
    let decrypted_plain_id: String = "decrypted_" + target_cipher_id;
    let c0_poly_str: String = (decrypt_cipher).c0_poly;
    let cipher_scale_val: Int = (decrypt_cipher).scale;

    return Ok(FhePlaintext {
        plain_id: decrypted_plain_id,
        value: decoded_val,
        encoded_poly: c0_poly_str,
        scale: cipher_scale_val,
        is_valid: true,
    });
}

pub fn fhe_decrypt_with_capability(
    _sys_cap: &SysCap,
    decrypt_cap_sk: FheSecretKey,
    decrypt_cap_params: FheParams,
    decrypt_cap_cipher: FheCiphertext
) -> Result[FhePlaintext, String] {
    return fhe_decrypt(decrypt_cap_sk, decrypt_cap_params, decrypt_cap_cipher);
}

pub fn fhe_add(add_c1: FheCiphertext, add_c2: FheCiphertext) -> Result[FheCiphertext, String] {
    if (add_c1).is_valid == false { return Err("INVALID_CIPHERTEXT: First operand is invalid"); }
    if (add_c2).is_valid == false { return Err("INVALID_CIPHERTEXT: Second operand is invalid"); }

    let operand1_c0: String = (add_c1).c0_poly;
    let operand2_c0: String = (add_c2).c0_poly;
    let operand1_c1: String = (add_c1).c1_poly;
    let operand2_c1: String = (add_c2).c1_poly;
    let operand1_noise: Int = (add_c1).noise_budget;
    let operand2_noise: Int = (add_c2).noise_budget;
    let operand1_level: Int = (add_c1).level;
    let operand1_scale: Int = (add_c1).scale;

    let add_c0: String = "(" + operand1_c0 + " + " + operand2_c0 + ")";
    let add_c1_str: String = "(" + operand1_c1 + " + " + operand2_c1 + ")";
    let mut min_noise_val: Int = operand1_noise;
    if operand2_noise < min_noise_val { min_noise_val = operand2_noise; }
    let new_noise_val: Int = min_noise_val - 1;
    let add_combined: String = add_c0 + add_c1_str;
    let add_chk: Int = fhe_calculate_checksum(add_combined);

    let operand1_id: String = (add_c1).cipher_id;
    let operand2_id: String = (add_c2).cipher_id;
    let result_cipher_id: String = "add_" + operand1_id + "_" + operand2_id;

    return Ok(FheCiphertext {
        cipher_id: result_cipher_id,
        c0_poly: add_c0,
        c1_poly: add_c1_str,
        scale: operand1_scale,
        level: operand1_level,
        noise_budget: new_noise_val,
        checksum: add_chk,
        is_valid: true,
    });
}

pub fn fhe_add_plain(addp_cipher: FheCiphertext, addp_plain: FhePlaintext) -> Result[FheCiphertext, String] {
    if (addp_cipher).is_valid == false { return Err("INVALID_CIPHERTEXT: Ciphertext operand is invalid"); }
    if (addp_plain).is_valid == false { return Err("INVALID_PLAINTEXT: Plaintext operand is invalid"); }

    let target_c0: String = (addp_cipher).c0_poly;
    let target_c1: String = (addp_cipher).c1_poly;
    let target_noise: Int = (addp_cipher).noise_budget;
    let target_level: Int = (addp_cipher).level;
    let target_scale: Int = (addp_cipher).scale;
    let plaintext_poly: String = (addp_plain).encoded_poly;

    let addp_c0: String = "(" + target_c0 + " + " + plaintext_poly + ")";
    let addp_combined: String = addp_c0 + target_c1;
    let addp_chk: Int = fhe_calculate_checksum(addp_combined);
    let target_id: String = (addp_cipher).cipher_id;
    let result_cipher_id: String = "addp_" + target_id;

    return Ok(FheCiphertext {
        cipher_id: result_cipher_id,
        c0_poly: addp_c0,
        c1_poly: target_c1,
        scale: target_scale,
        level: target_level,
        noise_budget: target_noise - 1,
        checksum: addp_chk,
        is_valid: true,
    });
}

pub fn fhe_sub(sub_c1: FheCiphertext, sub_c2: FheCiphertext) -> Result[FheCiphertext, String] {
    if (sub_c1).is_valid == false { return Err("INVALID_CIPHERTEXT: First operand is invalid"); }
    if (sub_c2).is_valid == false { return Err("INVALID_CIPHERTEXT: Second operand is invalid"); }

    let sub_operand1_c0: String = (sub_c1).c0_poly;
    let sub_operand2_c0: String = (sub_c2).c0_poly;
    let sub_operand1_c1: String = (sub_c1).c1_poly;
    let sub_operand2_c1: String = (sub_c2).c1_poly;
    let sub_operand1_noise: Int = (sub_c1).noise_budget;
    let sub_operand2_noise: Int = (sub_c2).noise_budget;
    let sub_operand1_level: Int = (sub_c1).level;
    let sub_operand1_scale: Int = (sub_c1).scale;

    let sub_c0: String = "(" + sub_operand1_c0 + " - " + sub_operand2_c0 + ")";
    let sub_c1_str: String = "(" + sub_operand1_c1 + " - " + sub_operand2_c1 + ")";
    let mut sub_min_noise: Int = sub_operand1_noise;
    if sub_operand2_noise < sub_min_noise { sub_min_noise = sub_operand2_noise; }
    let sub_new_noise: Int = sub_min_noise - 1;
    let sub_combined: String = sub_c0 + sub_c1_str;
    let sub_chk: Int = fhe_calculate_checksum(sub_combined);

    let sub_operand1_id: String = (sub_c1).cipher_id;
    let sub_operand2_id: String = (sub_c2).cipher_id;
    let sub_result_id: String = "sub_" + sub_operand1_id + "_" + sub_operand2_id;

    return Ok(FheCiphertext {
        cipher_id: sub_result_id,
        c0_poly: sub_c0,
        c1_poly: sub_c1_str,
        scale: sub_operand1_scale,
        level: sub_operand1_level,
        noise_budget: sub_new_noise,
        checksum: sub_chk,
        is_valid: true,
    });
}
