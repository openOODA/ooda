// # WebP lossless predictor and Huffman
//
// Logline: Applies spatial predictors and a green-first color transform, then reads a canonical prefix Huffman symbol.
//
// Setup: Pure. Predictor modes 0..4. Huffman lengths must form a prefix code. Bad lengths are Err.
//
// Beats:
//   1. Predict a pixel from left and above neighbors.
//   2. Inverse the subtract-green color transform.
//   3. Decode one prefix symbol from a bit stream.
//   4. Reject an empty or malformed code-length table.

pub type WpOut = struct {
    flag: Int,
    err: String,
    r: Int,
    g: Int,
    b: Int,
    sym: Int
};

fn wp_err(m: String) -> WpOut {
    return WpOut { flag: 0, err: "ERR\twebp: " + m, r: 0, g: 0, b: 0, sym: 0 };
}

pub fn webp_lossless_predict(mode: Int, left: Int, up: Int) -> Result[Int, String] {
    if mode == 0 {
        return Ok(0);
    }
    if mode == 1 {
        return Ok(left);
    }
    if mode == 2 {
        return Ok(up);
    }
    if mode == 3 {
        return Ok((left + up) / 2);
    }
    if mode == 4 {
        return Ok(left + up - ((left + up) / 2));
    }
    return Err("ERR\twebp: pred");
}

pub fn webp_lossless_color(r: Int, g: Int, b: Int) -> WpOut {
    let rr: Int = (r + g) & 255;
    let bb: Int = (b + g) & 255;
    return WpOut { flag: 1, err: "", r: rr, g: g & 255, b: bb, sym: 0 };
}

pub fn webp_lossless_huff(lens: List[Int], bits: List[Int]) -> WpOut {
    if list_len(lens) < 1 {
        return wp_err("lens");
    }
    if list_len(bits) < 1 {
        return wp_err("bits");
    }
    let mut code: Int = 0;
    let mut i: Int = 0;
    while i < list_len(lens) {
        let L: Int = list_get(lens, i);
        if L < 1 {
            return wp_err("len");
        }
        if list_len(bits) < L {
            return wp_err("short");
        }
        let mut v: Int = 0;
        let mut j: Int = 0;
        while j < L {
            v = v * 2 + (list_get(bits, j) & 1);
            j = j + 1;
        }
        if v == code {
            return WpOut { flag: 1, err: "", r: 0, g: 0, b: 0, sym: i };
        }
        code = code + 1;
        i = i + 1;
    }
    return wp_err("sym");
}

pub fn webp_lossless_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn webp_lossless_flag(o: WpOut) -> Int {
    return o.flag;
}
pub fn webp_lossless_err(o: WpOut) -> String {
    return o.err;
}
