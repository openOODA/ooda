// # Sovereign Limit Order Book (LOB) High-Level Façade
//
// Logline: Unified high-level interface for order matching, cancelations, and market depth snapshots.
//
// Setup: Pure exchange matching engine package re-exporting OrderBook constructors and trading functions.
//
// Beats:
//   1. Re-export OrderBook lifecycle and order submission.
//   2. Re-export continuous double auction matching and trade emission.
//   3. Re-export L2 market depth aggregation and BBO calculations.

import "./orderbook_types.oo";
import "./orderbook_engine.oo";
import "./orderbook_depth.oo";

pub fn orderbook_summary(book: &OrderBook) -> String {
    let snap: L2Snapshot = orderbook_get_l2_snapshot(book, 5);
    return "BBO: " + snap.best_bid + " / " + snap.best_ask;
}
