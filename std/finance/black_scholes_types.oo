// # Black-Scholes Options Pricing & Greeks Data Structures
//
// Logline: Defines European option contract parameters, theoretical price results, and analytical Greeks.
//
// Setup: Pure quantitative finance data structures with zero struct trailing commas.
//
// Beats:
//   1. Define OptionContract with spot price S, strike K, time to expiry T, interest rate r, and volatility sigma.
//   2. Define OptionPrice holding theoretical European Call and Put values.
//   3. Define OptionGreeks holding first/second order sensitivities: Delta, Gamma, Vega, Theta, Rho.

pub type OptionContract = struct {
    spot: Float,
    strike: Float,
    time_to_maturity: Float,
    risk_free_rate: Float,
    volatility: Float
};

pub type OptionPrice = struct {
    call_price: Float,
    put_price: Float
};

pub type OptionGreeks = struct {
    call_delta: Float,
    put_delta: Float,
    gamma: Float,
    vega: Float,
    theta: Float,
    rho: Float
};

pub fn black_scholes_types_call_price(p: OptionPrice) -> Float {
    return p.call_price;
}

pub fn black_scholes_types_put_price(p: OptionPrice) -> Float {
    return p.put_price;
}
