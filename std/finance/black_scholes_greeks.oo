// # Black-Scholes Options Greeks Sensitivity Engine
//
// Logline: Calculates analytical first and second order risk Greeks (Delta, Gamma, Vega, Theta, Rho) for option portfolios.
//
// Setup: Pure quantitative finance engine deriving risk sensitivities from contract parameters.
//
// Beats:
//   1. Calculate Call Delta N(d1) and Put Delta N(d1) - 1.
//   2. Calculate second-order curvature Gamma = N'(d1) / (S * sigma * sqrt(T)).
//   3. Calculate volatility sensitivity Vega = S * sqrt(T) * N'(d1).
//   4. Calculate temporal decay Theta and interest rate sensitivity Rho.

import "./black_scholes_types.oo";
import "./black_scholes.oo";
import "std/math.oo";

/// Calculate analytical Greeks for European options.
pub fn bs_calculate_greeks(contract: &OptionContract) -> Result[OptionGreeks, String] {
    let s: Float = (contract).spot;
    let k: Float = (contract).strike;
    let t: Float = (contract).time_to_maturity;
    let r: Float = (contract).risk_free_rate;
    let v: Float = (contract).volatility;

    if s <= 0.0 || k <= 0.0 || t <= 0.0 || v <= 0.0 {
        return Err("ERR\tbs_greeks: spot, strike, maturity, and volatility must be strictly positive");
    }

    let sqrt_t: Float = math_sqrt(t);
    let st: Float = v * sqrt_t;
    let s_over_k: Float = s / k;
    let ln_sk: Float = math_ln(s_over_k);

    let d1: Float = (ln_sk + (r + 0.5 * v * v) * t) / st;
    let d2: Float = d1 - st;

    let nd1: Float = bs_normal_cdf(d1);
    let nd2: Float = bs_normal_cdf(d2);
    let call_delta: Float = nd1;
    let put_delta: Float = call_delta - 1.0;

    let pdf_d1: Float = bs_normal_pdf(d1);
    let gamma: Float = pdf_d1 / (s * st);
    let vega: Float = s * sqrt_t * pdf_d1;

    let disc: Float = math_exp(0.0 - r * t);
    let theta: Float = (0.0 - (s * pdf_d1 * v) / (2.0 * sqrt_t)) - (r * k * disc * nd2);
    let rho: Float = k * t * disc * nd2;

    return Ok(OptionGreeks {
        call_delta: call_delta,
        put_delta: put_delta,
        gamma: gamma,
        vega: vega,
        theta: theta,
        rho: rho
    });
}
