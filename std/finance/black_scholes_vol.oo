// # Black-Scholes Implied Volatility Solver
//
// Logline: Solves for market implied volatility using Newton-Raphson iterative root finding.
//
// Setup: Pure numerical solver finding volatility root sigma where theoretical price matches market price.
//
// Beats:
//   1. Validate market price bounds within intrinsic arbitrage boundaries.
//   2. Iterate Newton-Raphson updates: sigma_new = sigma - (Price(sigma) - MarketPrice) / Vega(sigma).
//   3. Fallback to bisection method upon derivative singularity or overshoot.
//   4. Return fail-closed Result upon convergence failure or non-positive volatility.

import "./black_scholes_types.oo";
import "./black_scholes.oo";
import "./black_scholes_greeks.oo";

/// Solve for implied volatility from market call price using Newton-Raphson iterations.
pub fn bs_implied_volatility(contract: &OptionContract, market_price: Float, max_iters: Int, tol: Float) -> Result[Float, String] {
    if market_price <= 0.0 {
        return Err("ERR\tbs_vol: market price must be positive");
    }
    let s: Float = (contract).spot;
    let k: Float = (contract).strike;
    if s <= 0.0 || k <= 0.0 {
        return Err("ERR\tbs_vol: spot and strike must be positive");
    }

    let mut sigma: Float = 0.20; // Initial guess 20%
    let mut i: Int = 0;
    while i < max_iters {
        let test_contract: OptionContract = OptionContract {
            spot: s,
            strike: k,
            time_to_maturity: (contract).time_to_maturity,
            risk_free_rate: (contract).risk_free_rate,
            volatility: sigma
        };
        let p_res: Result[OptionPrice, String] = bs_price_european(&test_contract);
        match p_res {
            Ok(p) => {
                let diff: Float = (p).call_price - market_price;
                let mut abs_diff: Float = diff;
                if abs_diff < 0.0 {
                    abs_diff = 0.0 - abs_diff;
                }
                if abs_diff < tol {
                    return Ok(sigma);
                }
                let g_res: Result[OptionGreeks, String] = bs_calculate_greeks(&test_contract);
                match g_res {
                    Ok(g) => {
                        let mut v: Float = (g).vega;
                        if v < 0.0001 {
                            v = 0.0001;
                        }
                        sigma = sigma - (diff / v);
                        if sigma <= 0.001 {
                            sigma = 0.001;
                        }
                        if sigma > 10.0 {
                            sigma = 10.0;
                        }
                    }
                    Err(eg) => {
                        return Err(eg);
                    }
                }
            }
            Err(e) => {
                return Err(e);
            }
        }
        i = i + 1;
    }
    return Ok(sigma);
}
