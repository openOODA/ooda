// # Order Book Market Depth & L2 Snapshot Aggregator
//
// Logline: Aggregates order queues into L2 market depth levels, calculates top-of-book BBO, spread, and mid-price.
//
// Setup: Pure market data engine generating L2 order book depth snapshots.
//
// Beats:
//   1. Identify Best Bid (highest price) and Best Ask (lowest price) top-of-book levels.
//   2. Calculate bid-ask spread: Spread = BestAsk - BestBid.
//   3. Calculate mid-market price: Mid = (BestBid + BestAsk) / 2.0.
//   4. Aggregate resting order quantities across L2 depth tiers up to specified depth limit.

import "./orderbook_types.oo";

/// Compute L2 market depth snapshot from OrderBook state.
pub fn orderbook_get_l2_snapshot(book: &OrderBook, depth_limit: Int) -> L2Snapshot {
    let mut best_b: Int = 0;
    let mut best_a: Int = 0;

    let mut b_levels: List[L2Level] = list_new();
    let mut a_levels: List[L2Level] = list_new();

    let n_bids: Int = list_len((book).bids);
    let mut limit_b: Int = depth_limit;
    if n_bids < limit_b {
        limit_b = n_bids;
    }
    let mut i_b: Int = 0;
    while i_b < limit_b {
        let pl: PriceLevel = list_get((book).bids, i_b);
        if i_b == 0 {
            best_b = (pl).price;
        }
        let lvl: L2Level = L2Level {
            price: (pl).price,
            qty: (pl).total_qty,
            order_count: list_len((pl).orders)
        };
        b_levels = list_push(b_levels, lvl);
        i_b = i_b + 1;
    }

    let n_asks: Int = list_len((book).asks);
    let mut limit_a: Int = depth_limit;
    if n_asks < limit_a {
        limit_a = n_asks;
    }
    let mut i_a: Int = 0;
    while i_a < limit_a {
        let pl: PriceLevel = list_get((book).asks, i_a);
        if i_a == 0 {
            best_a = (pl).price;
        }
        let lvl: L2Level = L2Level {
            price: (pl).price,
            qty: (pl).total_qty,
            order_count: list_len((pl).orders)
        };
        a_levels = list_push(a_levels, lvl);
        i_a = i_a + 1;
    }

    let mut spread: Int = 0;
    if best_a > 0 && best_b > 0 {
        spread = best_a - best_b;
    }
    let mut mid: Float = 0.0;
    if best_b > 0 && best_a > 0 {
        mid = ((best_b + best_a) + 0.0) / 2.0;
    }

    return L2Snapshot {
        best_bid: best_b,
        best_ask: best_a,
        spread: spread,
        mid_price: mid,
        bids: b_levels,
        asks: a_levels
    };
}
