// # Limit Order Book (LOB) Market Microstructure Structures
//
// Logline: Defines Order, Trade, PriceLevel, and L2 market depth snapshot structures for financial exchange matching.
//
// Setup: Pure quantitative finance data structures with zero struct trailing commas.
//
// Beats:
//   1. Define Order with side (1=Buy, 2=Sell), integer price in ticks, quantity in lots, and timestamp.
//   2. Define Trade capturing maker/taker matches, matched price, and filled quantity.
//   3. Define PriceLevel aggregating queued orders at a specific tick price.
//   4. Define L2Snapshot representing best bid/ask, spread, mid-price, and aggregated book depth.

pub type Order = struct {
    id: Int,
    side: Int,
    price: Int,
    qty: Int,
    timestamp: Int
};

pub type Trade = struct {
    trade_id: Int,
    maker_order_id: Int,
    taker_order_id: Int,
    price: Int,
    qty: Int,
    timestamp: Int
};

pub type PriceLevel = struct {
    price: Int,
    total_qty: Int,
    orders: List[Order]
};

pub type OrderBook = struct {
    bids: List[PriceLevel],
    asks: List[PriceLevel],
    next_order_id: Int,
    next_trade_id: Int
};

pub type L2Level = struct {
    price: Int,
    qty: Int,
    order_count: Int
};

pub type L2Snapshot = struct {
    best_bid: Int,
    best_ask: Int,
    spread: Int,
    mid_price: Float,
    bids: List[L2Level],
    asks: List[L2Level]
};
