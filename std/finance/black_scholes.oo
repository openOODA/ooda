// # Black-Scholes Analytical Option Pricing Engine
//
// Logline: Computes European Call and Put theoretical prices and verifies exact Put-Call Parity balance.
//
// Setup: Pure quantitative finance engine implementing closed-form Black-Scholes-Merton option pricing.
//
// Beats:
//   1. Compute d1 and d2 logarithmic strike ratios via analytical formulas.
//   2. Calculate standard normal probability density (PDF) and cumulative distribution (CDF) functions.
//   3. Compute European Call price: C = S * N(d1) - K * exp(-r*T) * N(d2).
//   4. Compute European Put price: P = K * exp(-r*T) * N(-d2) - S * N(-d1) and verify parity: C - P = S - K*exp(-r*T).

import "./black_scholes_types.oo";
import "std/math.oo";

/// Standard normal probability density function (PDF): phi(x) = (1 / sqrt(2*pi)) * exp(-0.5 * x^2).
pub fn bs_normal_pdf(x: Float) -> Float {
    let inv_sqrt_2pi: Float = 0.3989422804014327;
    return inv_sqrt_2pi * math_exp(0.0 - 0.5 * x * x);
}

/// Standard normal cumulative distribution function (CDF) approximation (Abramowitz & Stegun 26.2.17).
pub fn bs_normal_cdf(x: Float) -> Float {
    if x < (0.0 - 7.0) {
        return 0.0;
    }
    if x > 7.0 {
        return 1.0;
    }
    let mut z: Float = x;
    let mut is_neg: Bool = false;
    if z < 0.0 {
        z = 0.0 - z;
        is_neg = true;
    }
    let p: Float = 0.2316419;
    let b1: Float = 0.319381530;
    let b2: Float = 0.0 - 0.356563782;
    let b3: Float = 1.781477937;
    let b4: Float = 0.0 - 1.821255978;
    let b5: Float = 1.330274429;

    let t: Float = 1.0 / (1.0 + p * z);
    let pdf: Float = 0.3989422804014327 * math_exp(0.0 - 0.5 * z * z);
    let poly: Float = (((b5 * t + b4) * t + b3) * t + b2) * t + b1;
    let cdf: Float = 1.0 - pdf * poly * t;

    if is_neg {
        return 1.0 - cdf;
    }
    return cdf;
}

/// Price European Call and Put options via analytical Black-Scholes formulas.
pub fn bs_price_european(contract: &OptionContract) -> Result[OptionPrice, String] {
    let s: Float = (contract).spot;
    let k: Float = (contract).strike;
    let t: Float = (contract).time_to_maturity;
    let r: Float = (contract).risk_free_rate;
    let v: Float = (contract).volatility;

    if s <= 0.0 || k <= 0.0 || t <= 0.0 || v <= 0.0 {
        return Err("ERR\tbs_price: spot, strike, maturity, and volatility must be strictly positive");
    }

    let sqrt_t: Float = math_sqrt(t);
    let st: Float = v * sqrt_t;
    let s_over_k: Float = s / k;
    let ln_sk: Float = math_ln(s_over_k);

    let d1: Float = (ln_sk + (r + 0.5 * v * v) * t) / st;
    let d2: Float = d1 - st;

    let nd1: Float = bs_normal_cdf(d1);
    let nd2: Float = bs_normal_cdf(d2);
    let n_minus_d1: Float = bs_normal_cdf(0.0 - d1);
    let n_minus_d2: Float = bs_normal_cdf(0.0 - d2);

    let disc: Float = math_exp(0.0 - r * t);

    let call_p: Float = s * nd1 - k * disc * nd2;
    let put_p: Float = k * disc * n_minus_d2 - s * n_minus_d1;

    return Ok(OptionPrice {
        call_price: call_p,
        put_price: put_p
    });
}

/// Verify exact Put-Call Parity: |(C - P) - (S - K * exp(-r*T))| <= epsilon.
pub fn bs_verify_put_call_parity(contract: &OptionContract, price: &OptionPrice, eps: Float) -> Result[Bool, String] {
    let s: Float = (contract).spot;
    let k: Float = (contract).strike;
    let t: Float = (contract).time_to_maturity;
    let r: Float = (contract).risk_free_rate;
    let disc: Float = math_exp(0.0 - r * t);

    let lhs: Float = (price).call_price - (price).put_price;
    let rhs: Float = s - k * disc;
    let mut diff: Float = lhs - rhs;
    if diff < 0.0 {
        diff = 0.0 - diff;
    }
    if diff <= eps {
        return Ok(true);
    }
    return Err("ERR\tbs_parity: Put-Call Parity violated");
}
