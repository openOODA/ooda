// # Test runner
//
// Logline: Count passes and fails, print each name, and summarize at the end without exiting.
//
// Setup: Callers build a TestRunner and feed asserts. This file is pure: no ProcessCap.
//
// Beats:
//   1. test_runner_new starts at zero passed and failed.
//   2. Int, string, and bool asserts print PASS or FAIL and bump the count.
//   3. test_summary prints the totals; the caller checks failed if it wants a nonzero exit.

type TestRunner = struct {
    passed: Int,
    failed: Int,
};

pub fn test_runner_new() -> TestRunner {
    return TestRunner { passed: 0, failed: 0 };
}

pub fn test_assert_eq_int(mut r: TestRunner, name: String, got: Int, want: Int) -> TestRunner {
    if got == want {
        println("PASS: " + name);
        r.passed = r.passed + 1;
    } else {
        println("FAIL: " + name + " (got " + got.to_string() + ", want " + want.to_string() + ")");
        r.failed = r.failed + 1;
    }
    return r;
}

pub fn test_assert_eq_str(mut r: TestRunner, name: String, got: String, want: String) -> TestRunner {
    if got == want {
        println("PASS: " + name);
        r.passed = r.passed + 1;
    } else {
        println("FAIL: " + name + " (got '" + got + "', want '" + want + "')");
        r.failed = r.failed + 1;
    }
    return r;
}

pub fn test_assert(mut r: TestRunner, name: String, cond: Bool) -> TestRunner {
    if cond {
        println("PASS: " + name);
        r.passed = r.passed + 1;
    } else {
        println("FAIL: " + name + " (condition was false)");
        r.failed = r.failed + 1;
    }
    return r;
}

pub fn test_summary(r: TestRunner) {
    println("");
    println("Test Summary:");
    let passed = r.passed;
    let failed = r.failed;
    println("  Passed: " + passed.to_string());
    println("  Failed: " + failed.to_string());

    if failed > 0 {
        println("TEST SUITE FAILED");
    } else {
        println("TEST SUITE PASSED");
    }
}
