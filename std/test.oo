// ===================================================================
// openOODA Standard Library — std::test
// ===================================================================
// Dedicated Test Runner
// Captures failures without crashing the process to allow running 
// multiple tests and summarizing the results at the end.

struct TestRunner {
    passed: Int,
    failed: Int,
}

pub fn test_runner_new() -> TestRunner {
    return TestRunner { passed: 0, failed: 0 };
}

pub fn test_assert_eq_int(mut r: TestRunner, name: String, got: Int, want: Int) -> TestRunner {
    if got == want {
        println("PASS: " + name);
        r.passed = r.passed + 1;
    } else {
        println("FAIL: " + name + " (got " + got.to_string() + ", want " + want.to_string() + ")");
        r.failed = r.failed + 1;
    }
    return r;
}

pub fn test_assert_eq_str(mut r: TestRunner, name: String, got: String, want: String) -> TestRunner {
    if got == want {
        println("PASS: " + name);
        r.passed = r.passed + 1;
    } else {
        println("FAIL: " + name + " (got '" + got + "', want '" + want + "')");
        r.failed = r.failed + 1;
    }
    return r;
}

pub fn test_assert(mut r: TestRunner, name: String, cond: Bool) -> TestRunner {
    if cond {
        println("PASS: " + name);
        r.passed = r.passed + 1;
    } else {
        println("FAIL: " + name + " (condition was false)");
        r.failed = r.failed + 1;
    }
    return r;
}

pub fn test_summary(r: TestRunner) {
    println("");
    println("Test Summary:");
    println("  Passed: " + r.passed.to_string());
    println("  Failed: " + r.failed.to_string());
    
    if r.failed > 0 {
        println("TEST SUITE FAILED");
        // A test runner should still exit 1 if there are failures,
        // but only at the very end after summarizing.
        // process_exit(1) is available if we pass ProcessCap, but 
        // to keep it pure, the caller can check r.failed > 0.
    } else {
        println("TEST SUITE PASSED");
    }
}
