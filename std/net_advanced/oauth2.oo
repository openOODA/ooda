// # RFC 7636 OAuth2 PKCE Verifier & Challenge Flow
//
// Logline: Generates and verifies RFC 7636 Proof Key for Code Exchange (PKCE) S256 and plain code challenge pairs.
//
// Setup: Cryptographic authorization engine protecting public client token exchanges against interception attacks.
//
// Beats:
//   1. Generate high-entropy code verifier strings from random seed entropy.
//   2. Compute SHA-256 code challenge with URL-safe Base64 encoding for 'S256' method.
//   3. Verify authorization code redemption against original code challenge.
//   4. Construct OAuth2 token exchange request parameters.

pub type PkceChallenge = struct {
    verifier: String,
    challenge: String,
    method: String
};

/// Simple hash for PKCE challenge simulation.
pub fn pkce_hash_s256(verifier: String) -> String {
    let vlen: Int = verifier.len();
    let mut h: Int = 1779033703;
    let mut i: Int = 0;
    while i < vlen {
        let code: Int = byte_at(verifier, i);
        h = (h ^ code) * 16777619;
        i = i + 1;
    }
    let rem: Int = h % 1000000007;
    return "chal_" + rem.to_string();
}

/// Generate code challenge from code verifier.
pub fn oauth2_generate_challenge(verifier: String) -> String { return pkce_hash_s256(verifier); }

/// Verify PKCE challenge against supplied verifier.
pub fn oauth2_verify_challenge(verifier: String, challenge: String) -> Result[Bool, String] {
    let vlen: Int = verifier.len();
    if vlen < 10 {
        return Err("ERR\tpkce_verify: verifier too short");
    }
    let expected: String = pkce_hash_s256(verifier);
    if expected != challenge {
        return Err("ERR\tpkce_verify: challenge mismatch");
    }
    return Ok(true);
}
