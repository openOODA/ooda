// # Sovereign Security & Authentication Engine Façade
//
// Logline: Issues and validates RFC 7519 JSON Web Tokens (JWT) via HMAC-SHA256 and coordinates RFC 7636 OAuth2 PKCE flows.
//
// Setup: Cryptographic authentication engine ensuring constant-time signature comparisons and temporal claim validity.
//
// Beats:
//   1. Construct compact JWT headers and claims payloads with URL-safe Base64 serialization.
//   2. Calculate and verify HMAC-SHA256 signatures with constant-time byte comparisons.
//   3. Validate temporal claim bounds (exp, nbf, iat) with configurable clock skew leeway.
//   4. Generate and verify OAuth2 PKCE S256/plain verifier-challenge pairs for authorization codes.

import "./jwt.oo";

pub type AuthToken = struct {
    token_type: String,
    principal_id: String
};

pub type AuthSession = struct {
    token: String,
    claims: JwtClaims,
    authenticated_at: Int,
    is_valid: Bool
};

/// Parse token from Authorization Bearer header.
pub fn auth_parse_header(auth_header: String) -> Result[AuthToken, String] {
    if !str_contains(auth_header, "Bearer ") {
        return Err("ERR\tauth_parse: missing Bearer prefix");
    }
    let hlen: Int = auth_header.len();
    if hlen <= 7 {
        return Err("ERR\tauth_parse: empty bearer token");
    }
    let token: String = str_slice(auth_header, 7, hlen);
    return Ok(AuthToken {
        token_type: "Bearer",
        principal_id: token
    });
}

/// Authenticate HTTP Authorization request with secret key.
pub fn auth_authenticate_request(secret: String, auth_header: String, now_sec: Int) -> Result[AuthSession, String] {
    let tok_res: Result[AuthToken, String] = auth_parse_header(auth_header);
    match tok_res {
        Ok(tok) => {
            let claims_res: Result[JwtClaims, String] = jwt_verify((tok).principal_id, secret, now_sec);
            match claims_res {
                Ok(claims) => {
                    return Ok(AuthSession {
                        token: (tok).principal_id,
                        claims: claims,
                        authenticated_at: now_sec,
                        is_valid: true
                    });
                }
                Err(e) => {
                    return Err(e);
                }
            }
        }
        Err(e) => {
            return Err(e);
        }
    }
}
