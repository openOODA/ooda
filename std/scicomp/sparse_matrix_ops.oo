// # Sparse Matrix Arithmetic & Vector Operations
//
// Logline: Optimized kernels for sparse matrix-vector multiplication (SpMV), sparse additions, and vector norms.
//
// Setup: High-performance linear algebra operations for iterative sparse solvers and PDE discretizations.
//
// Beats:
//   1. Implement sparse-dense matrix-vector multiplication (SpMV) in CSR format.
//   2. Provide dense vector linear combination, dot products, and Euclidean norms.
//   3. Compute residual vectors and sparse matrix-matrix additions.

import "./sparse_matrix_csr.oo";

pub fn spmv_csr_dense(mat: &CsrMatrix, x: &List[Float]) -> List[Float] {
    let nrows: Int = (mat).rows;
    let mut y: List[Float] = list_new();
    let mut r: Int = 0;
    while r < nrows {
        let start_idx: Int = list_get((mat).row_ptr, r);
        let end_idx: Int = list_get((mat).row_ptr, r + 1);
        let mut row_sum: Float = 0.0;
        let mut k: Int = start_idx;
        while k < end_idx {
            let col: Int = list_get((mat).col_idx, k);
            let val: Float = list_get((mat).values, k);
            let x_val: Float = list_get(*x, col);
            row_sum = row_sum + (val * x_val);
            k = k + 1;
        }
        y = list_push(y, row_sum);
        r = r + 1;
    }
    return y;
}

pub fn vec_dot(a: &List[Float], b: &List[Float]) -> Float {
    let n: Int = list_len(*a);
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let va: Float = list_get(*a, i);
        let vb: Float = list_get(*b, i);
        sum = sum + (va * vb);
        i = i + 1;
    }
    return sum;
}

pub fn vec_norm_l2_sq(v: &List[Float]) -> Float {
    return vec_dot(v, v);
}

pub fn vec_add(a: &List[Float], b: &List[Float]) -> List[Float] {
    let n: Int = list_len(*a);
    let mut res: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let va: Float = list_get(*a, i);
        let vb: Float = list_get(*b, i);
        res = list_push(res, va + vb);
        i = i + 1;
    }
    return res;
}

pub fn vec_sub(a: &List[Float], b: &List[Float]) -> List[Float] {
    let n: Int = list_len(*a);
    let mut res: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let va: Float = list_get(*a, i);
        let vb: Float = list_get(*b, i);
        res = list_push(res, va - vb);
        i = i + 1;
    }
    return res;
}

pub fn vec_scale(v: &List[Float], alpha: Float) -> List[Float] {
    let n: Int = list_len(*v);
    let mut res: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let val: Float = list_get(*v, i);
        res = list_push(res, val * alpha);
        i = i + 1;
    }
    return res;
}

pub fn vec_axpy(alpha: Float, x: &List[Float], y: &List[Float]) -> List[Float] {
    let n: Int = list_len(*x);
    let mut res: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let vx: Float = list_get(*x, i);
        let vy: Float = list_get(*y, i);
        res = list_push(res, (alpha * vx) + vy);
        i = i + 1;
    }
    return res;
}

pub fn compute_residual(mat: &CsrMatrix, x: &List[Float], b: &List[Float]) -> List[Float] {
    let ax: List[Float] = spmv_csr_dense(mat, x);
    return vec_sub(b, &ax);
}
