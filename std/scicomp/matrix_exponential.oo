// # Matrix Exponential via Scaling & Squaring
//
// Logline: Computes e^A matrix exponential for dynamical systems, continuous state-space models, and Lie groups.
//
// Setup: Numerical matrix exponential evaluator using truncated series and repeated squaring.
//
// Beats:
//   1. Implement dense matrix addition, multiplication, and identity generators.
//   2. Compute 1-norm matrix scale factor for scaling and squaring reduction.
//   3. Evaluate matrix exponential polynomial and reconstruct e^A via repeated matrix squaring.

import "./eigen_values_qr.oo";

pub fn dense_mat_identity(dim: Int) -> DenseMatrix {
    let mut mat: DenseMatrix = dense_mat_new(dim, dim);
    let mut i: Int = 0;
    while i < dim {
        dense_mat_set(mat, i, i, 1.0);
        i = i + 1;
    }
    return mat;
}

pub fn dense_mat_add(a: &DenseMatrix, b: &DenseMatrix) -> DenseMatrix {
    let r: Int = (a).rows;
    let c: Int = (a).cols;
    let mut res: DenseMatrix = dense_mat_new(r, c);
    let mut i: Int = 0;
    while i < r {
        let mut j: Int = 0;
        while j < c {
            let sum: Float = dense_mat_get(a, i, j) + dense_mat_get(b, i, j);
            dense_mat_set(res, i, j, sum);
            j = j + 1;
        }
        i = i + 1;
    }
    return res;
}

pub fn dense_mat_scale(a: &DenseMatrix, s: Float) -> DenseMatrix {
    let r: Int = (a).rows;
    let c: Int = (a).cols;
    let mut res: DenseMatrix = dense_mat_new(r, c);
    let mut i: Int = 0;
    while i < r {
        let mut j: Int = 0;
        while j < c {
            let val: Float = dense_mat_get(a, i, j) * s;
            dense_mat_set(res, i, j, val);
            j = j + 1;
        }
        i = i + 1;
    }
    return res;
}

pub fn dense_mat_mul(a: &DenseMatrix, b: &DenseMatrix) -> DenseMatrix {
    let m: Int = (a).rows;
    let k_dim: Int = (a).cols;
    let n: Int = (b).cols;
    let mut res: DenseMatrix = dense_mat_new(m, n);

    let mut i: Int = 0;
    while i < m {
        let mut j: Int = 0;
        while j < n {
            let mut sum: Float = 0.0;
            let mut k: Int = 0;
            while k < k_dim {
                sum = sum + (dense_mat_get(a, i, k) * dense_mat_get(b, k, j));
                k = k + 1;
            }
            dense_mat_set(res, i, j, sum);
            j = j + 1;
        }
        i = i + 1;
    }
    return res;
}

pub fn dense_mat_norm_1(a: &DenseMatrix) -> Float {
    let r: Int = (a).rows;
    let c: Int = (a).cols;
    let mut max_col_sum: Float = 0.0;
    let mut j: Int = 0;
    while j < c {
        let mut col_sum: Float = 0.0;
        let mut i: Int = 0;
        while i < r {
            col_sum = col_sum + math_abs(dense_mat_get(a, i, j));
            i = i + 1;
        }
        if col_sum > max_col_sum {
            max_col_sum = col_sum;
        }
        j = j + 1;
    }
    return max_col_sum;
}

pub fn matrix_exp_taylor(mat: &DenseMatrix, order: Int) -> DenseMatrix {
    let dim: Int = (mat).rows;
    let mut res: DenseMatrix = dense_mat_identity(dim);
    let mut term: DenseMatrix = dense_mat_identity(dim);

    let mut k: Int = 1;
    let mut k_f: Float = 1.0;
    let mut fact: Float = 1.0;
    while k <= order {
        fact = fact * k_f;
        term = dense_mat_mul(&term, mat);
        let scaled_term: DenseMatrix = dense_mat_scale(&term, 1.0 / fact);
        res = dense_mat_add(&res, &scaled_term);
        k_f = k_f + 1.0;
        k = k + 1;
    }
    return res;
}

pub fn matrix_exp_scale_square(mat: &DenseMatrix) -> DenseMatrix {
    let dim: Int = (mat).rows;
    let n1: Float = dense_mat_norm_1(mat);

    let mut scale_power: Int = 0;
    let mut scaled_norm: Float = n1;
    while (scaled_norm > 0.5) && (scale_power < 10) {
        scaled_norm = scaled_norm / 2.0;
        scale_power = scale_power + 1;
    }

    let mut scale_factor: Float = 1.0;
    let mut p: Int = 0;
    while p < scale_power {
        scale_factor = scale_factor * 2.0;
        p = p + 1;
    }

    let scaled_mat: DenseMatrix = dense_mat_scale(mat, 1.0 / scale_factor);
    let mut cur: DenseMatrix = matrix_exp_taylor(&scaled_mat, 8);

    let mut sq: Int = 0;
    while sq < scale_power {
        cur = dense_mat_mul(&cur, &cur);
        sq = sq + 1;
    }

    return cur;
}
