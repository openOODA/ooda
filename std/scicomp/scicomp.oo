pub fn shim_scicomp_marker() -> Int {
    return 50;
}

pub fn shim_csr_new(rows: Int, cols: Int) -> CsrMatrix {
    return csr_matrix_new(rows, cols);
}

pub fn shim_coo_new(rows: Int, cols: Int) -> CooMatrix {
    return coo_matrix_new(rows, cols);
}

pub fn shim_cg_config() -> CgSolverConfig {
    return cg_solver_config_default();
}

pub fn shim_gmres_config() -> GmresConfig {
    return gmres_config_default();
}

pub fn shim_dense_mat_new(rows: Int, cols: Int) -> DenseMatrix {
    return dense_mat_new(rows, cols);
}

pub fn shim_cubic_spline_new() -> CubicSpline {
    return cubic_spline_new();
}

pub fn shim_kd_tree_new() -> KdTree {
    return kd_tree_new();
}

pub fn shim_rotor_identity() -> CliffordRotor {
    return rotor_identity();
}

pub fn shim_dual_quat_identity() -> DualQuaternion {
    return dual_quat_identity();
}

pub fn shim_db4_init() -> Daubechies4Filter {
    return db4_filter_init();
}

pub fn shim_halton_new(dim: Int) -> HaltonSequence {
    return halton_sequence_new(dim);
}

pub fn shim_sobol_new(dim: Int) -> SobolGenerator {
    return sobol_generator_new(dim);
}
