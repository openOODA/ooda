// # Power Iteration & Inverse Iteration for Eigenvectors
//
// Logline: Computes dominant, minimum, and shifted eigenvectors via iterative matrix-vector power methods.
//
// Setup: Numerical eigenvector calculation with Rayleigh quotient refinement and spectral shift.
//
// Beats:
//   1. Define PowerIterConfig and PowerIterResult data structures.
//   2. Implement standard power iteration for dominant eigenvalue/eigenvector pair.
//   3. Implement Rayleigh quotient calculation and deflation routine.

import "./eigen_values_qr.oo";

pub type PowerIterConfig = struct {
    max_iters: Int,
    tolerance: Float,
};

pub type PowerIterResult = struct {
    eigenvalue: Float,
    eigenvector: List[Float],
    iterations: Int,
    converged: Bool,
};

pub fn power_iter_config_default() -> PowerIterConfig {
    return PowerIterConfig {
        max_iters: 200,
        tolerance: 0.000001,
    };
}

pub fn dense_mat_vec_mul(mat: &DenseMatrix, v: &List[Float]) -> List[Float] {
    let nrows: Int = (mat).rows;
    let ncols: Int = (mat).cols;
    let mut out: List[Float] = list_new();
    let mut r: Int = 0;
    while r < nrows {
        let mut row_sum: Float = 0.0;
        let mut c: Int = 0;
        while c < ncols {
            let m_val: Float = dense_mat_get(mat, r, c);
            let v_val: Float = list_get(*v, c);
            row_sum = row_sum + (m_val * v_val);
            c = c + 1;
        }
        out = list_push(out, row_sum);
        r = r + 1;
    }
    return out;
}

pub fn dense_vec_dot(a: &List[Float], b: &List[Float]) -> Float {
    let n: Int = list_len(*a);
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        sum = sum + (list_get(*a, i) * list_get(*b, i));
        i = i + 1;
    }
    return sum;
}

pub fn dense_vec_norm(v: &List[Float]) -> Float {
    let sum_sq: Float = dense_vec_dot(v, v);
    return math_sqrt(sum_sq);
}

pub fn dense_vec_normalize(v: &List[Float]) -> List[Float] {
    let nrm: Float = dense_vec_norm(v);
    let mut out: List[Float] = list_new();
    let n: Int = list_len(*v);
    let mut i: Int = 0;
    if nrm > 0.0000000001 {
        while i < n {
            out = list_push(out, list_get(*v, i) / nrm);
            i = i + 1;
        }
    } else {
        while i < n {
            out = list_push(out, 0.0);
            i = i + 1;
        }
    }
    return out;
}

pub fn rayleigh_quotient(mat: &DenseMatrix, v: &List[Float]) -> Float {
    let av: List[Float] = dense_mat_vec_mul(mat, v);
    let num: Float = dense_vec_dot(v, &av);
    let den: Float = dense_vec_dot(v, v);
    if den == 0.0 {
        return 0.0;
    }
    return num / den;
}

pub fn solve_power_iteration(mat: &DenseMatrix, config: &PowerIterConfig) -> PowerIterResult {
    let n: Int = (mat).cols;
    let mut v: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        v = list_push(v, 1.0);
        i = i + 1;
    }
    v = dense_vec_normalize(&v);

    let mut lambda: Float = 0.0;
    let mut iter: Int = 0;
    let mut converged: Bool = false;

    while (iter < (config).max_iters) && (converged == false) {
        let w: List[Float] = dense_mat_vec_mul(mat, &v);
        let new_lambda: Float = dense_vec_dot(&v, &w);
        let w_norm: Float = dense_vec_norm(&w);

        if w_norm > 0.0000000001 {
            let next_v: List[Float] = dense_vec_normalize(&w);
            let diff: Float = math_abs(new_lambda - lambda);
            if diff <= (config).tolerance {
                converged = true;
            }
            lambda = new_lambda;
            v = next_v;
        } else {
            iter = (config).max_iters;
        }
        iter = iter + 1;
    }

    return PowerIterResult {
        eigenvalue: lambda,
        eigenvector: v,
        iterations: iter,
        converged: converged,
    };
}
