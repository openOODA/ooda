// # Halton Quasi-Random Low-Discrepancy Sequence
//
// Logline: Multi-dimensional deterministic quasi-random point generation using van der Corput radical inversion.
//
// Setup: High-efficiency low-discrepancy sampling across prime bases for numerical integration and ray tracing.
//
// Beats:
//   1. Define HaltonSequence structure with prime bases and current sample counter.
//   2. Compute van der Corput radical inverse function for given integer base.
//   3. Generate multi-dimensional point coordinates in unit hypercube [0, 1)^d.

pub type HaltonSequence = struct {
    dimension: Int,
    bases: List[Int],
    index: Int
};

pub fn halton_sequence_new(dim: Int) -> HaltonSequence {
    let mut b: List[Int] = list_new();
    b = list_push(b, 2);
    b = list_push(b, 3);
    b = list_push(b, 5);
    b = list_push(b, 7);
    b = list_push(b, 11);
    b = list_push(b, 13);
    b = list_push(b, 17);
    b = list_push(b, 19);

    return HaltonSequence {
        dimension: dim,
        bases: b,
        index: 1
    };
}

pub fn van_der_corput(index: Int, base: Int) -> Float {
    let mut f: Float = 1.0;
    let mut r: Float = 0.0;
    let mut i: Int = index;

    let mut base_f: Float = 0.0;
    let mut b_count: Int = 0;
    while b_count < base {
        base_f = base_f + 1.0;
        b_count = b_count + 1;
    }

    while i > 0 {
        f = f / base_f;
        let rem: Int = i % base;
        let mut rem_f: Float = 0.0;
        let mut r_count: Int = 0;
        while r_count < rem {
            rem_f = rem_f + 1.0;
            r_count = r_count + 1;
        }
        r = r + (f * rem_f);
        i = i / base;
    }

    return r;
}

pub fn halton_next_point(seq: &mut HaltonSequence) -> List[Float] {
    let cur_idx: Int = (seq).index;
    (seq).index = cur_idx + 1;

    let d: Int = (seq).dimension;
    let mut pt: List[Float] = list_new();

    let mut dim_i: Int = 0;
    while dim_i < d {
        let base_val: Int = list_get((seq).bases, dim_i);
        let coord: Float = van_der_corput(cur_idx, base_val);
        pt = list_push(pt, coord);
        dim_i = dim_i + 1;
    }

    return pt;
}
