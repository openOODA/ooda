// # K-d Tree Spatial Partitioning & Nearest Neighbor Search
//
// Logline: Multi-dimensional binary space partitioning tree for logarithmic k-NN queries and range bounding.
//
// Setup: Fast spatial indexing and nearest neighbor lookup for point clouds.
//
// Beats:
//   1. Define KdNode and KdTree data structures for 2D/3D coordinate queries.
//   2. Implement spatial splitting along alternating coordinate axes.
//   3. Execute nearest-neighbor search with branch-and-bound distance pruning.

import "./voronoi_diagram.oo";

pub type KdNode = struct {
    point: VoronoiPoint,
    axis: Int,
    left_child: Int,
    right_child: Int,
};

pub type KdTree = struct {
    nodes: List[KdNode],
    root_idx: Int,
    count: Int,
};

pub fn kd_node_new(pt: VoronoiPoint, axis: Int) -> KdNode {
    return KdNode {
        point: pt,
        axis: axis,
        left_child: 0 - 1,
        right_child: 0 - 1,
    };
}

pub fn kd_tree_new() -> KdTree {
    return KdTree {
        nodes: list_new(),
        root_idx: 0 - 1,
        count: 0,
    };
}

pub fn kd_tree_insert(tree: &mut KdTree, pt: VoronoiPoint) {
    let node_idx: Int = (tree).count;
    if (tree).root_idx == (0 - 1) {
        let root: KdNode = kd_node_new(pt, 0);
        let mut nodes_list: List[KdNode] = (tree).nodes;
        nodes_list = list_push(nodes_list, root);
        (tree).nodes = nodes_list;
        (tree).root_idx = 0;
        (tree).count = 1;
        return;
    }

    let mut cur_idx: Int = (tree).root_idx;
    let mut inserted: Bool = false;

    while inserted == false {
        let cur_node: KdNode = list_get((tree).nodes, cur_idx);
        let axis: Int = (cur_node).axis;
        let mut go_left: Bool = false;

        if axis == 0 {
            go_left = (pt).x < ((cur_node).point).x;
        } else {
            go_left = (pt).y < ((cur_node).point).y;
        }

        let next_axis: Int = 1 - axis;

        if go_left {
            if (cur_node).left_child == (0 - 1) {
                let new_node: KdNode = kd_node_new(pt, next_axis);
                let mut nds: List[KdNode] = (tree).nodes;
                nds = list_push(nds, new_node);
                (tree).nodes = nds;

                let updated_cur: KdNode = KdNode {
                    point: (cur_node).point,
                    axis: (cur_node).axis,
                    left_child: node_idx,
                    right_child: (cur_node).right_child,
                };

                let mut mod_nds: List[KdNode] = list_new();
                let mut k: Int = 0;
                while k < node_idx {
                    if k == cur_idx {
                        mod_nds = list_push(mod_nds, updated_cur);
                    } else {
                        mod_nds = list_push(mod_nds, list_get((tree).nodes, k));
                    }
                    k = k + 1;
                }
                (tree).nodes = mod_nds;
                (tree).count = (tree).count + 1;
                inserted = true;
            } else {
                cur_idx = (cur_node).left_child;
            }
        } else {
            if (cur_node).right_child == (0 - 1) {
                let new_node: KdNode = kd_node_new(pt, next_axis);
                let mut nds: List[KdNode] = (tree).nodes;
                nds = list_push(nds, new_node);
                (tree).nodes = nds;

                let updated_cur: KdNode = KdNode {
                    point: (cur_node).point,
                    axis: (cur_node).axis,
                    left_child: (cur_node).left_child,
                    right_child: node_idx,
                };

                let mut mod_nds: List[KdNode] = list_new();
                let mut k: Int = 0;
                while k < node_idx {
                    if k == cur_idx {
                        mod_nds = list_push(mod_nds, updated_cur);
                    } else {
                        mod_nds = list_push(mod_nds, list_get((tree).nodes, k));
                    }
                    k = k + 1;
                }
                (tree).nodes = mod_nds;
                (tree).count = (tree).count + 1;
                inserted = true;
            } else {
                cur_idx = (cur_node).right_child;
            }
        }
    }
}
