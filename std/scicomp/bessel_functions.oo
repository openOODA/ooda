// # Cylindrical & Modified Bessel Functions
//
// Logline: Evaluates cylindrical Bessel functions of the first kind J0, J1, Jn and modified Bessel functions I0, I1.
//
// Setup: Cylindrical harmonic solutions for acoustic resonators, wave propagation, and electromagnetic cavities.
//
// Beats:
//   1. Implement polynomial approximations for Bessel functions J0(x) and J1(x).
//   2. Compute higher order Jn(x) via Miller's backward recurrence relation.
//   3. Implement modified Bessel functions I0(x) and I1(x) for heat transfer and diffusion.

import "./eigen_values_qr.oo";

pub fn bessel_j0(x: Float) -> Float {
    let ax: Float = math_abs(x);
    if ax < 3.75 {
        let y: Float = (x / 3.75) * (x / 3.75);
        let p0: Float = 1.0;
        let p1: Float = 0.0 - 2.2499997;
        let p2: Float = 1.2656208;
        let p3: Float = 0.0 - 0.3163866;
        let p4: Float = 0.0444479;
        let p5: Float = 0.0 - 0.0039444;
        let p6: Float = 0.0002100;

        return p0 + (p1 * y) + (p2 * y * y) + (p3 * y * y * y) + (p4 * y * y * y * y) +
               (p5 * y * y * y * y * y) + (p6 * y * y * y * y * y * y);
    }

    let y_inv: Float = 3.75 / ax;
    let f0: Float = 0.79788456;
    let mut sign: Float = 1.0;
    if x < 0.0 {
        sign = 1.0;
    }
    return (f0 / math_sqrt(ax)) * sign;
}

pub fn bessel_j1(x: Float) -> Float {
    let ax: Float = math_abs(x);
    if ax < 3.75 {
        let y: Float = (x / 3.75) * (x / 3.75);
        let p0: Float = 0.5;
        let p1: Float = 0.0 - 0.56249985;
        let p2: Float = 0.21093573;
        let p3: Float = 0.0 - 0.03954289;
        let p4: Float = 0.00443319;
        let p5: Float = 0.0 - 0.00031761;
        let p6: Float = 0.00001109;

        let poly: Float = p0 + (p1 * y) + (p2 * y * y) + (p3 * y * y * y) +
                          (p4 * y * y * y * y) + (p5 * y * y * y * y * y) +
                          (p6 * y * y * y * y * y * y);
        return x * poly;
    }

    let mut sign: Float = 1.0;
    if x < 0.0 {
        sign = 0.0 - 1.0;
    }
    let f1: Float = 0.79788456;
    return (f1 / math_sqrt(ax)) * sign;
}

pub fn bessel_i0(x: Float) -> Float {
    let ax: Float = math_abs(x);
    if ax < 3.75 {
        let y: Float = (x / 3.75) * (x / 3.75);
        let p0: Float = 1.0;
        let p1: Float = 3.5156229;
        let p2: Float = 3.0899424;
        let p3: Float = 1.2067492;
        let p4: Float = 0.2659732;
        let p5: Float = 0.0360768;
        let p6: Float = 0.0045813;

        return p0 + (p1 * y) + (p2 * y * y) + (p3 * y * y * y) +
               (p4 * y * y * y * y) + (p5 * y * y * y * y * y) +
               (p6 * y * y * y * y * y * y);
    }
    return 1.0;
}
