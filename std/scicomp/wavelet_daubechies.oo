// # Daubechies-4 (db4) Orthogonal Wavelet Transform
//
// Logline: 4-tap compact support orthogonal wavelet filter bank for multi-resolution signal decomposition.
//
// Setup: Wavelet compression and transient feature extraction with 2 vanishing moments.
//
// Beats:
//   1. Define Daubechies4Filter coefficients with exact algebraic constants.
//   2. Implement 1D forward D4 convolution with circular boundary wrapping.
//   3. Implement inverse reconstruction IDWT filter synthesis.

pub type Daubechies4Filter = struct {
    h0: Float,
    h1: Float,
    h2: Float,
    h3: Float,
    g0: Float,
    g1: Float,
    g2: Float,
    g3: Float,
};

pub fn db4_filter_init() -> Daubechies4Filter {
    let sqrt3: Float = 1.7320508075688772;
    let denom: Float = 4.0 * 1.4142135623730951;

    let h0: Float = (1.0 + sqrt3) / denom;
    let h1: Float = (3.0 + sqrt3) / denom;
    let h2: Float = (3.0 - sqrt3) / denom;
    let h3: Float = (1.0 - sqrt3) / denom;

    return Daubechies4Filter {
        h0: h0,
        h1: h1,
        h2: h2,
        h3: h3,
        g0: h3,
        g1: 0.0 - h2,
        g2: h1,
        g3: 0.0 - h0,
    };
}

pub fn db4_forward_step(signal: &List[Float], filt: &Daubechies4Filter) -> List[Float] {
    let n: Int = list_len(*signal);
    let half_n: Int = n / 2;
    let mut approx: List[Float] = list_new();
    let mut detail: List[Float] = list_new();

    let mut i: Int = 0;
    while i < half_n {
        let idx0: Int = 2 * i;
        let idx1: Int = (2 * i) + 1;
        let mut idx2: Int = (2 * i) + 2;
        let mut idx3: Int = (2 * i) + 3;

        if idx2 >= n { idx2 = idx2 - n; }
        if idx3 >= n { idx3 = idx3 - n; }

        let s0: Float = list_get(*signal, idx0);
        let s1: Float = list_get(*signal, idx1);
        let s2: Float = list_get(*signal, idx2);
        let s3: Float = list_get(*signal, idx3);

        let a: Float = ((filt).h0 * s0) + ((filt).h1 * s1) + ((filt).h2 * s2) + ((filt).h3 * s3);
        let d: Float = ((filt).g0 * s0) + ((filt).g1 * s1) + ((filt).g2 * s2) + ((filt).g3 * s3);

        approx = list_push(approx, a);
        detail = list_push(detail, d);
        i = i + 1;
    }

    let mut out: List[Float] = list_new();
    i = 0;
    while i < half_n {
        out = list_push(out, list_get(approx, i));
        i = i + 1;
    }
    i = 0;
    while i < half_n {
        out = list_push(out, list_get(detail, i));
        i = i + 1;
    }
    return out;
}
