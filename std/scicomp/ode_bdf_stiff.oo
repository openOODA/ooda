// # Backward Differentiation Formula (BDF) Stiff ODE Solver
//
// Logline: Implicit multi-step BDF solver for stiff ordinary differential equations with Newton linearizations.
//
// Setup: Specialized integrator for chemical kinetics, electrical circuits, and stiff mechanical systems.
//
// Beats:
//   1. Define BdfConfig, BdfState, and BdfOrder data structures.
//   2. Compute implicit BDF1 (Backward Euler) and BDF2 polynomial coefficients.
//   3. Formulate Newton iteration residual (I - gamma*h*J) for stiff algebraic solve.

import "./eigen_values_qr.oo";
import "./lu_decomp.oo";

pub type BdfConfig = struct {
    max_order: Int,
    tolerance: Float,
    newton_max_iters: Int,
};

pub type BdfState = struct {
    y_current: List[Float],
    y_prev: List[Float],
    h: Float,
    order: Int,
};

pub fn bdf_config_default() -> BdfConfig {
    return BdfConfig {
        max_order: 2,
        tolerance: 0.000001,
        newton_max_iters: 10,
    };
}

pub fn bdf1_step_linear(
    y_n: &List[Float],
    h: Float,
    mat_a: &DenseMatrix
) -> List[Float] {
    let dim: Int = (mat_a).rows;
    let mut m_sys: DenseMatrix = dense_mat_new(dim, dim);

    let mut i: Int = 0;
    while i < dim {
        let mut j: Int = 0;
        while j < dim {
            let aij: Float = dense_mat_get(mat_a, i, j);
            let mut delta_ij: Float = 0.0;
            if i == j {
                delta_ij = 1.0;
            }
            dense_mat_set(m_sys, i, j, delta_ij - (h * aij));
            j = j + 1;
        }
        i = i + 1;
    }

    let factor: LuFactor = lu_decompose(&m_sys);
    return lu_solve(&factor, y_n);
}

pub fn bdf2_step_linear(
    y_n: &List[Float],
    y_nminus1: &List[Float],
    h: Float,
    mat_a: &DenseMatrix
) -> List[Float] {
    let dim: Int = (mat_a).rows;
    let mut m_sys: DenseMatrix = dense_mat_new(dim, dim);

    let mut i: Int = 0;
    while i < dim {
        let mut j: Int = 0;
        while j < dim {
            let aij: Float = dense_mat_get(mat_a, i, j);
            let mut delta_ij: Float = 0.0;
            if i == j {
                delta_ij = 1.0;
            }
            dense_mat_set(m_sys, i, j, delta_ij - ((2.0 / 3.0) * h * aij));
            j = j + 1;
        }
        i = i + 1;
    }

    let mut rhs: List[Float] = list_new();
    i = 0;
    while i < dim {
        let yn_i: Float = list_get(*y_n, i);
        let yn1_i: Float = list_get(*y_nminus1, i);
        let val: Float = ((4.0 / 3.0) * yn_i) - ((1.0 / 3.0) * yn1_i);
        rhs = list_push(rhs, val);
        i = i + 1;
    }

    let factor: LuFactor = lu_decompose(&m_sys);
    return lu_solve(&factor, &rhs);
}
