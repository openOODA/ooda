// # QR Algorithm for Matrix Eigenvalues
//
// Logline: Computes eigenvalues of real matrices using shifted QR iterations and Hessenberg reduction.
//
// Setup: Dense eigenvalue solver with Wilkinson shifts and deflation for numerical stability.
//
// Beats:
//   1. Define EigenResult structure for storing real and imaginary eigenvalue pairs.
//   2. Implement 2x2 and NxN Hessenberg reduction and QR iteration with Wilkinson shift.
//   3. Extract eigenvalues and compute spectral radius.

pub type DenseMatrix = struct {
    rows: Int,
    cols: Int,
    data: List[Float]
};

pub type EigenResult = struct {
    real_parts: List[Float],
    imag_parts: List[Float],
    iterations: Int,
    converged: Bool
};

pub fn dense_mat_new(rows: Int, cols: Int) -> DenseMatrix {
    let n: Int = rows * cols;
    let mut d: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        d = list_push(d, 0.0);
        i = i + 1;
    }
    return DenseMatrix {
        rows: rows,
        cols: cols,
        data: d
    };
}

pub fn dense_mat_get(mat: &DenseMatrix, r: Int, c: Int) -> Float {
    if (r < 0) || (r >= (mat).rows) || (c < 0) || (c >= (mat).cols) {
        return 0.0;
    }
    let idx: Int = (r * (mat).cols) + c;
    return list_get((mat).data, idx);
}

pub fn dense_mat_set(mat: &mut DenseMatrix, r: Int, c: Int, val: Float) {
    if (r >= 0) && (r < (mat).rows) && (c >= 0) && (c < (mat).cols) {
        let target_idx: Int = (r * (mat).cols) + c;
        let mut new_d: List[Float] = list_new();
        let total: Int = (mat).rows * (mat).cols;
        let mut i: Int = 0;
        while i < total {
            if i == target_idx {
                new_d = list_push(new_d, val);
            } else {
                new_d = list_push(new_d, list_get((mat).data, i));
            }
            i = i + 1;
        }
        (mat).data = new_d;
    }
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 {
        return 0.0;
    }
    let mut g: Float = x;
    if x > 1.0 {
        g = x / 2.0;
    }
    let mut i: Int = 0;
    while i < 14 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

pub fn compute_wilkinson_shift(a11: Float, a12: Float, a21: Float, a22: Float) -> Float {
    let d: Float = (a11 - a22) / 2.0;
    let mut sign: Float = 1.0;
    if d < 0.0 {
        sign = 0.0 - 1.0;
    }
    let denom: Float = math_abs(d) + math_sqrt((d * d) + (a12 * a21));
    if denom == 0.0 {
        return a22;
    }
    return a22 - ((sign * a12 * a21) / denom);
}

pub fn compute_eigenvalues_2x2(a11: Float, a12: Float, a21: Float, a22: Float) -> EigenResult {
    let tr: Float = a11 + a22;
    let det: Float = (a11 * a22) - (a12 * a21);
    let disc: Float = (tr * tr) - (4.0 * det);

    let mut reals: List[Float] = list_new();
    let mut imags: List[Float] = list_new();

    if disc >= 0.0 {
        let sq: Float = math_sqrt(disc);
        reals = list_push(reals, (tr + sq) / 2.0);
        imags = list_push(imags, 0.0);
        reals = list_push(reals, (tr - sq) / 2.0);
        imags = list_push(imags, 0.0);
    } else {
        let sq: Float = math_sqrt(0.0 - disc);
        reals = list_push(reals, tr / 2.0);
        imags = list_push(imags, sq / 2.0);
        reals = list_push(reals, tr / 2.0);
        imags = list_push(imags, (0.0 - sq) / 2.0);
    }

    return EigenResult {
        real_parts: reals,
        imag_parts: imags,
        iterations: 1,
        converged: true
    };
}
