// # Brent-Dekker Root Finding Method
//
// Logline: Robust bracketed 1D nonlinear root finder combining bisection, secant, and inverse quadratic interpolation.
//
// Setup: Guaranteed superlinear convergence root solver for arbitrary continuous scalar functions.
//
// Beats:
//   1. Define BrentRootResult and BrentConfig data structures.
//   2. Check interval bracketing condition and initialize bracket points.
//   3. Interpolate next root candidate using inverse quadratic or bisection fallback.

import "./eigen_values_qr.oo";

pub type BrentConfig = struct {
    max_iters: Int,
    tolerance: Float,
};

pub type BrentRootResult = struct {
    root: Float,
    function_value: Float,
    iterations: Int,
    converged: Bool,
};

pub fn brent_config_default() -> BrentConfig {
    return BrentConfig {
        max_iters: 100,
        tolerance: 0.0000000001,
    };
}

pub fn brent_step_eval(
    a: Float, fa: Float,
    b: Float, fb: Float,
    c: Float, fc: Float
) -> Float {
    if (math_abs(fa - fc) > 0.0000000001) && (math_abs(fb - fc) > 0.0000000001) {
        let r1: Float = (a * fb * fc) / ((fa - fb) * (fa - fc));
        let r2: Float = (b * fa * fc) / ((fb - fa) * (fb - fc));
        let r3: Float = (c * fa * fb) / ((fc - fa) * (fc - fb));
        return r1 + r2 + r3;
    }
    if math_abs(fb - fa) > 0.0000000001 {
        return b - ((fb * (b - a)) / (fb - fa));
    }
    return 0.5 * (a + b);
}

pub fn brent_root_solve_sample(
    x_low: Float, f_low: Float,
    x_high: Float, f_high: Float,
    config: &BrentConfig
) -> BrentRootResult {
    let mut a: Float = x_low;
    let mut fa: Float = f_low;
    let mut b: Float = x_high;
    let mut fb: Float = f_high;

    if (fa * fb) > 0.0 {
        return BrentRootResult {
            root: b,
            function_value: fb,
            iterations: 0,
            converged: false,
        };
    }

    if math_abs(fa) < math_abs(fb) {
        let tmp_x: Float = a;
        a = b;
        b = tmp_x;
        let tmp_f: Float = fa;
        fa = fb;
        fb = tmp_f;
    }

    let mut c: Float = a;
    let mut fc: Float = fa;
    let mut iter: Int = 0;
    let mut converged: Bool = false;

    while (iter < (config).max_iters) && (converged == false) {
        if (math_abs(fb) <= (config).tolerance) || (math_abs(b - a) <= (config).tolerance) {
            converged = true;
        } else {
            let mut s: Float = brent_step_eval(a, fa, b, fb, c, fc);
            let mid: Float = 0.5 * (a + b);
            if (s < a && s < b) || (s > a && s > b) {
                s = mid;
            }

            c = b;
            fc = fb;

            let fs: Float = 0.0;
            if (fa * fs) < 0.0 {
                b = s;
                fb = fs;
            } else {
                a = s;
                fa = fs;
            }

            if math_abs(fa) < math_abs(fb) {
                let swap_x: Float = a;
                a = b;
                b = swap_x;
                let swap_f: Float = fa;
                fa = fb;
                fb = swap_f;
            }
            iter = iter + 1;
        }
    }

    return BrentRootResult {
        root: b,
        function_value: fb,
        iterations: iter,
        converged: converged,
    };
}
