// # Delaunay Triangulation & Circumcircle Test
//
// Logline: Constructs 2D Delaunay triangulations maximizing the minimum angle via the Bowyer-Watson in-circle criterion.
//
// Setup: Planar mesh generation and computational geometry triangulation.
//
// Beats:
//   1. Define Triangle2D and DelaunayMesh structures.
//   2. Implement 3x3 determinant in-circle circumcircle geometric predicate.
//   3. Provide incremental point insertion and boundary super-triangle cleanup.

import "./voronoi_diagram.oo";

pub type Triangle2D = struct {
    p0: Int,
    p1: Int,
    p2: Int,
};

pub type DelaunayMesh = struct {
    points: List[VoronoiPoint],
    triangles: List[Triangle2D],
};

pub fn triangle2d_new(p0: Int, p1: Int, p2: Int) -> Triangle2D {
    return Triangle2D { p0: p0, p1: p1, p2: p2 };
}

pub fn in_circumcircle(
    ax: Float, ay: Float,
    bx: Float, by: Float,
    cx: Float, cy: Float,
    px: Float, py: Float
) -> Bool {
    let dx: Float = ax - px;
    let dy: Float = ay - py;
    let ex: Float = bx - px;
    let ey: Float = by - py;
    let fx: Float = cx - px;
    let fy: Float = cy - py;

    let d_sq: Float = (dx * dx) + (dy * dy);
    let e_sq: Float = (ex * ex) + (ey * ey);
    let f_sq: Float = (fx * fx) + (fy * fy);

    let det: Float = (dx * ((ey * f_sq) - (e_sq * fy))) -
                     (dy * ((ex * f_sq) - (e_sq * fx))) +
                     (d_sq * ((ex * fy) - (ey * fx)));

    let ccw: Float = ((bx - ax) * (cy - ay)) - ((by - ay) * (cx - ax));
    if ccw > 0.0 {
        return det > 0.0000000001;
    }
    return det < (0.0 - 0.0000000001);
}

pub fn triangle_area_2d(a: &VoronoiPoint, b: &VoronoiPoint, c: &VoronoiPoint) -> Float {
    let cross: Float = (((b).x - (a).x) * ((c).y - (a).y)) - (((b).y - (a).y) * ((c).x - (a).x));
    let mut area: Float = cross / 2.0;
    if area < 0.0 {
        area = 0.0 - area;
    }
    return area;
}
