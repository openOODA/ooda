// # Special Functions: Gamma, Beta & Error Function (erf)
//
// Logline: Lanczos approximation for Gamma/Log-Gamma and rational Chebyshev approximation for Error functions.
//
// Setup: Fundamental special functions for probability, quantum mechanics, and statistical physics.
//
// Beats:
//   1. Implement Lanczos 7-term series approximation for Gamma(z) and ln(Gamma(z)).
//   2. Compute Beta function B(a, b) from log-gamma sums avoiding numerical overflow.
//   3. Implement Abramowitz-Stegun rational approximations for erf(x) and erfc(x).

import "./eigen_values_qr.oo";

pub fn math_ln_approx(x: Float) -> Float {
    if x <= 0.0 {
        return 0.0 - 999999.0;
    }
    let mut val: Float = x;
    let mut k: Float = 0.0;
    while val > 2.0 {
        val = val / 2.0;
        k = k + 1.0;
    }
    while val < 1.0 {
        val = val * 2.0;
        k = k - 1.0;
    }

    let z: Float = (val - 1.0) / (val + 1.0);
    let z2: Float = z * z;
    let z3: Float = z2 * z;
    let z5: Float = z3 * z2;
    let z7: Float = z5 * z2;

    let series: Float = 2.0 * (z + (z3 / 3.0) + (z5 / 5.0) + (z7 / 7.0));
    let ln2: Float = 0.6931471805599453;
    return series + (k * ln2);
}

pub fn math_exp_approx(x: Float) -> Float {
    let mut term: Float = 1.0;
    let mut sum: Float = 1.0;
    let mut i: Int = 1;
    let mut i_f: Float = 1.0;
    while i < 18 {
        term = term * (x / i_f);
        sum = sum + term;
        i_f = i_f + 1.0;
        i = i + 1;
    }
    return sum;
}

pub fn log_gamma_lanczos(z: Float) -> Float {
    let p0: Float = 0.99999999999980993;
    let p1: Float = 676.5203681218851;
    let p2: Float = 0.0 - 1259.1392167224028;
    let p3: Float = 771.32342877765313;
    let p4: Float = 0.0 - 176.61502916214059;
    let p5: Float = 12.507343278686905;
    let p6: Float = 0.0 - 0.13857109583111262;

    let mut zh: Float = z;
    if z < 0.5 {
        zh = 1.0 - z;
    }

    let zm1: Float = zh - 1.0;
    let mut x: Float = p0 + (p1 / (zm1 + 1.0)) + (p2 / (zm1 + 2.0)) +
                       (p3 / (zm1 + 3.0)) + (p4 / (zm1 + 4.0)) +
                       (p5 / (zm1 + 5.0)) + (p6 / (zm1 + 6.0));

    let t: Float = zm1 + 7.5;
    let pi: Float = 3.141592653589793;
    let half_ln_2pi: Float = 0.9189385332046727;

    let lgt: Float = half_ln_2pi + ((zm1 + 0.5) * math_ln_approx(t)) - t + math_ln_approx(x);

    if z < 0.5 {
        return math_ln_approx(pi) - math_ln_approx(z) - lgt;
    }
    return lgt;
}

pub fn special_gamma(z: Float) -> Float {
    let lg: Float = log_gamma_lanczos(z);
    return math_exp_approx(lg);
}

pub fn special_beta(a: Float, b: Float) -> Float {
    let lg_a: Float = log_gamma_lanczos(a);
    let lg_b: Float = log_gamma_lanczos(b);
    let lg_ab: Float = log_gamma_lanczos(a + b);
    return math_exp_approx(lg_a + lg_b - lg_ab);
}

pub fn special_erf(x: Float) -> Float {
    let a1: Float = 0.254829592;
    let a2: Float = 0.0 - 0.284496736;
    let a3: Float = 1.421413741;
    let a4: Float = 0.0 - 1.453152027;
    let a5: Float = 1.061405429;
    let p: Float = 0.3275911;

    let mut sign: Float = 1.0;
    if x < 0.0 {
        sign = 0.0 - 1.0;
    }
    let abs_x: Float = math_abs(x);

    let t: Float = 1.0 / (1.0 + (p * abs_x));
    let t2: Float = t * t;
    let t3: Float = t2 * t;
    let t4: Float = t3 * t;
    let t5: Float = t4 * t;

    let poly: Float = (a1 * t) + (a2 * t2) + (a3 * t3) + (a4 * t4) + (a5 * t5);
    let y: Float = 1.0 - (poly * math_exp_approx(0.0 - (abs_x * abs_x)));

    return sign * y;
}

pub fn special_erfc(x: Float) -> Float {
    return 1.0 - special_erf(x);
}
