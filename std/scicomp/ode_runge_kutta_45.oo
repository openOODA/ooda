// # Runge-Kutta-Fehlberg / Dormand-Prince 4(5) Adaptive ODE Solver
//
// Logline: Embedded adaptive step size ODE integrator with 4th and 5th order error estimation.
//
// Setup: High-accuracy numerical integration for nonlinear ordinary differential equations.
//
// Beats:
//   1. Define OdeRk45Config and OdeRk45Step data structures.
//   2. Compute 6-stage Butcher tableau intermediate derivative evaluations.
//   3. Estimate local truncation error and adapt integration time step h.

import "./eigen_values_qr.oo";

pub type OdeRk45Config = struct {
    tolerance: Float,
    min_step: Float,
    max_step: Float,
    safety_factor: Float
};

pub type OdeRk45Step = struct {
    t_next: Float,
    y_next: List[Float],
    error_norm: Float,
    h_recommended: Float,
    step_accepted: Bool
};

pub fn ode_rk45_config_default() -> OdeRk45Config {
    return OdeRk45Config {
        tolerance: 0.000001,
        min_step: 0.00000001,
        max_step: 1.0,
        safety_factor: 0.9
    };
}

pub fn rk45_combine_stages(
    y: &List[Float],
    h: Float,
    k1: &List[Float],
    k2: &List[Float],
    k3: &List[Float],
    k4: &List[Float],
    k5: &List[Float],
    k6: &List[Float]
) -> OdeRk45Step {
    let n: Int = list_len(*y);
    let mut y5: List[Float] = list_new();
    let mut err_sq: Float = 0.0;

    let b1: Float = 35.0 / 384.0;
    let b3: Float = 500.0 / 1113.0;
    let b4: Float = 125.0 / 192.0;
    let b5: Float = (0.0 - 2187.0) / 6784.0;
    let b6: Float = 11.0 / 84.0;

    let e1: Float = (71.0 / 57600.0);
    let e3: Float = (0.0 - 71.0) / 16695.0;
    let e4: Float = 71.0 / 1920.0;
    let e5: Float = (0.0 - 17253.0) / 339200.0;
    let e6: Float = 22.0 / 525.0;

    let mut i: Int = 0;
    while i < n {
        let yi: Float = list_get(*y, i);
        let k1i: Float = list_get(*k1, i);
        let k3i: Float = list_get(*k3, i);
        let k4i: Float = list_get(*k4, i);
        let k5i: Float = list_get(*k5, i);
        let k6i: Float = list_get(*k6, i);

        let sum5: Float = (b1 * k1i) + (b3 * k3i) + (b4 * k4i) + (b5 * k5i) + (b6 * k6i);
        let y_new: Float = yi + (h * sum5);
        y5 = list_push(y5, y_new);

        let err_i: Float = h * ((e1 * k1i) + (e3 * k3i) + (e4 * k4i) + (e5 * k5i) + (e6 * k6i));
        err_sq = err_sq + (err_i * err_i);
        i = i + 1;
    }

    let err_norm: Float = math_sqrt(err_sq);
    let mut h_rec: Float = h;
    if err_norm > 0.0000000001 {
        let scale: Float = 0.9 * math_sqrt(1.0 / err_norm);
        h_rec = h * scale;
    }

    return OdeRk45Step {
        t_next: h,
        y_next: y5,
        error_norm: err_norm,
        h_recommended: h_rec,
        step_accepted: true
    };
}
