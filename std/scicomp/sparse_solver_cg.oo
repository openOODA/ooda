// # Conjugate Gradient (CG) Sparse Linear Solver
//
// Logline: Iterative Krylov subspace solver for symmetric positive-definite sparse linear systems with optional Jacobi preconditioning.
//
// Setup: High-performance CG algorithm with residual convergence tracking and iteration limits.
//
// Beats:
//   1. Define CgSolverConfig and CgSolverResult data structures.
//   2. Implement Jacobi diagonal preconditioner extraction and application.
//   3. Execute conjugate gradient iteration with dynamic step size updates.

import "./sparse_matrix_csr.oo";
import "./sparse_matrix_ops.oo";

pub type CgSolverConfig = struct {
    max_iters: Int,
    tolerance: Float,
    use_jacobi_preconditioner: Bool,
};

pub type CgSolverResult = struct {
    solution: List[Float],
    iterations: Int,
    residual_norm: Float,
    converged: Bool,
};

pub fn cg_solver_config_default() -> CgSolverConfig {
    return CgSolverConfig {
        max_iters: 1000,
        tolerance: 0.000001,
        use_jacobi_preconditioner: false,
    };
}

pub fn extract_jacobi_inv_diag(mat: &CsrMatrix) -> List[Float] {
    let n: Int = (mat).rows;
    let mut inv_diag: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let diag_val: Float = csr_get_entry(mat, i, i);
        if (diag_val > 0.0000000001) || (diag_val < (0.0 - 0.0000000001)) {
            inv_diag = list_push(inv_diag, 1.0 / diag_val);
        } else {
            inv_diag = list_push(inv_diag, 1.0);
        }
        i = i + 1;
    }
    return inv_diag;
}

pub fn apply_jacobi(inv_diag: &List[Float], r: &List[Float]) -> List[Float] {
    let n: Int = list_len(*r);
    let mut z: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let d: Float = list_get(*inv_diag, i);
        let val: Float = list_get(*r, i);
        z = list_push(z, d * val);
        i = i + 1;
    }
    return z;
}

pub fn solve_cg(mat: &CsrMatrix, b: &List[Float], config: &CgSolverConfig) -> CgSolverResult {
    let n: Int = (mat).rows;
    let mut x: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        x = list_push(x, 0.0);
        i = i + 1;
    }

    let ax: List[Float] = spmv_csr_dense(mat, &x);
    let mut r: List[Float] = vec_sub(b, &ax);

    let inv_diag: List[Float] = extract_jacobi_inv_diag(mat);
    let mut z: List[Float] = list_new();
    if (config).use_jacobi_preconditioner {
        z = apply_jacobi(&inv_diag, &r);
    } else {
        z = r;
    }

    let mut p: List[Float] = z;
    let mut rz_old: Float = vec_dot(&r, &z);
    let tol_sq: Float = ((config).tolerance) * ((config).tolerance);

    let mut iter: Int = 0;
    let mut converged: Bool = false;
    let mut r_norm_sq: Float = vec_norm_l2_sq(&r);

    while (iter < (config).max_iters) && (converged == false) {
        if r_norm_sq <= tol_sq {
            converged = true;
        } else {
            let ap: List[Float] = spmv_csr_dense(mat, &p);
            let p_ap: Float = vec_dot(&p, &ap);

            if (p_ap > 0.0000000000001) || (p_ap < (0.0 - 0.0000000000001)) {
                let alpha: Float = rz_old / p_ap;
                let alpha_p: List[Float] = vec_scale(&p, alpha);
                x = vec_add(&x, &alpha_p);

                let alpha_ap: List[Float] = vec_scale(&ap, alpha);
                r = vec_sub(&r, &alpha_ap);

                r_norm_sq = vec_norm_l2_sq(&r);
                if r_norm_sq <= tol_sq {
                    converged = true;
                } else {
                    if (config).use_jacobi_preconditioner {
                        z = apply_jacobi(&inv_diag, &r);
                    } else {
                        z = r;
                    }
                    let rz_new: Float = vec_dot(&r, &z);
                    let beta: Float = rz_new / rz_old;
                    let beta_p: List[Float] = vec_scale(&p, beta);
                    p = vec_add(&z, &beta_p);
                    rz_old = rz_new;
                }
            } else {
                iter = (config).max_iters;
            }
            iter = iter + 1;
        }
    }

    return CgSolverResult {
        solution: x,
        iterations: iter,
        residual_norm: r_norm_sq,
        converged: converged,
    };
}
