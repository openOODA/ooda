// # Hermite Polynomials & Monotone PCHIP Interpolation
//
// Logline: Evaluates cubic and quintic Hermite polynomials and constructs shape-preserving monotonic PCHIP splines.
//
// Setup: Interpolation matching function values and exact derivative constraints.
//
// Beats:
//   1. Define HermiteCubic and HermiteQuintic polynomial structures.
//   2. Evaluate canonical Hermite basis functions and blended curve values.
//   3. Implement Piecewise Cubic Hermite Interpolating Polynomial (PCHIP) with harmonic mean tangents.

import "./eigen_values_qr.oo";

pub type HermiteCubic = struct {
    x0: Float,
    x1: Float,
    y0: Float,
    y1: Float,
    m0: Float,
    m1: Float,
};

pub fn hermite_cubic_new(x0: Float, x1: Float, y0: Float, y1: Float, m0: Float, m1: Float) -> HermiteCubic {
    return HermiteCubic {
        x0: x0,
        x1: x1,
        y0: y0,
        y1: y1,
        m0: m0,
        m1: m1,
    };
}

pub fn hermite_cubic_eval(poly: &HermiteCubic, x: Float) -> Float {
    let dx: Float = (poly).x1 - (poly).x0;
    if dx == 0.0 {
        return (poly).y0;
    }
    let t: Float = (x - (poly).x0) / dx;
    let t2: Float = t * t;
    let t3: Float = t2 * t;

    let h00: Float = (2.0 * t3) - (3.0 * t2) + 1.0;
    let h10: Float = t3 - (2.0 * t2) + t;
    let h01: Float = (0.0 - (2.0 * t3)) + (3.0 * t2);
    let h11: Float = t3 - t2;

    return (h00 * (poly).y0) + (h10 * dx * (poly).m0) + (h01 * (poly).y1) + (h11 * dx * (poly).m1);
}

pub fn hermite_cubic_derivative(poly: &HermiteCubic, x: Float) -> Float {
    let dx: Float = (poly).x1 - (poly).x0;
    if dx == 0.0 {
        return (poly).m0;
    }
    let t: Float = (x - (poly).x0) / dx;
    let t2: Float = t * t;

    let dh00: Float = ((6.0 * t2) - (6.0 * t)) / dx;
    let dh10: Float = (3.0 * t2) - (4.0 * t) + 1.0;
    let dh01: Float = ((0.0 - (6.0 * t2)) + (6.0 * t)) / dx;
    let dh11: Float = (3.0 * t2) - (2.0 * t);

    return (dh00 * (poly).y0) + (dh10 * (poly).m0) + (dh01 * (poly).y1) + (dh11 * (poly).m1);
}

pub fn pchip_tangent_harmonic(d1: Float, d2: Float) -> Float {
    if (d1 * d2) <= 0.0 {
        return 0.0;
    }
    return (2.0 * d1 * d2) / (d1 + d2);
}

pub fn pchip_fit(xs: &List[Float], ys: &List[Float]) -> List[HermiteCubic] {
    let n: Int = list_len(*xs);
    let mut pieces: List[HermiteCubic] = list_new();
    if n < 2 {
        return pieces;
    }

    let mut deltas: List[Float] = list_new();
    let mut i: Int = 0;
    while i < (n - 1) {
        let dx: Float = list_get(*xs, i + 1) - list_get(*xs, i);
        let dy: Float = list_get(*ys, i + 1) - list_get(*ys, i);
        if dx != 0.0 {
            deltas = list_push(deltas, dy / dx);
        } else {
            deltas = list_push(deltas, 0.0);
        }
        i = i + 1;
    }

    let mut tangents: List[Float] = list_new();
    let d0: Float = list_get(deltas, 0);
    tangents = list_push(tangents, d0);

    i = 1;
    while i < (n - 1) {
        let d_prev: Float = list_get(deltas, i - 1);
        let d_curr: Float = list_get(deltas, i);
        let t: Float = pchip_tangent_harmonic(d_prev, d_curr);
        tangents = list_push(tangents, t);
        i = i + 1;
    }

    let d_last: Float = list_get(deltas, n - 2);
    tangents = list_push(tangents, d_last);

    i = 0;
    while i < (n - 1) {
        let h: HermiteCubic = hermite_cubic_new(
            list_get(*xs, i),
            list_get(*xs, i + 1),
            list_get(*ys, i),
            list_get(*ys, i + 1),
            list_get(tangents, i),
            list_get(tangents, i + 1)
        );
        pieces = list_push(pieces, h);
        i = i + 1;
    }

    return pieces;
}
