// # Simplex Algorithm for Linear Programming
//
// Logline: Solves linear programming problems in standard tableau form using Dantzig's simplex method with Bland's anti-cycling rule.
//
// Setup: Direct tableau pivoting for constrained linear optimization and resource allocation.
//
// Beats:
//   1. Define SimplexTableau and LpResult data structures.
//   2. Implement pivot element selection via reduced cost and minimum ratio test.
//   3. Perform Gauss-Jordan tableau row elimination and extract optimal primal variables.

import "./eigen_values_qr.oo";

pub type SimplexTableau = struct {
    num_constraints: Int,
    num_vars: Int,
    matrix: DenseMatrix,
    basic_vars: List[Int]
};

pub type LpResult = struct {
    optimal_value: Float,
    solution: List[Float],
    iterations: Int,
    is_optimal: Bool,
    is_unbounded: Bool
};

pub fn simplex_tableau_new(m: Int, n: Int) -> SimplexTableau {
    let r: Int = m + 1;
    let c: Int = n + m + 1;
    let mat: DenseMatrix = dense_mat_new(r, c);

    let mut basics: List[Int] = list_new();
    let mut i: Int = 0;
    while i < m {
        basics = list_push(basics, n + i);
        i = i + 1;
    }

    return SimplexTableau {
        num_constraints: m,
        num_vars: n,
        matrix: mat,
        basic_vars: basics
    };
}

pub fn simplex_pivot(tab: &mut SimplexTableau, pivot_row: Int, pivot_col: Int) {
    let r_total: Int = (tab).num_constraints + 1;
    let c_total: Int = (tab).num_vars + (tab).num_constraints + 1;

    let pivot_val: Float = dense_mat_get(&(tab).matrix, pivot_row, pivot_col);
    if math_abs(pivot_val) < 0.0000000001 {
        return;
    }

    let mut j: Int = 0;
    while j < c_total {
        let cur_val: Float = dense_mat_get(&(tab).matrix, pivot_row, j);
        dense_mat_set((tab).matrix, pivot_row, j, cur_val / pivot_val);
        j = j + 1;
    }

    let mut i: Int = 0;
    while i < r_total {
        if i != pivot_row {
            let factor: Float = dense_mat_get(&(tab).matrix, i, pivot_col);
            if math_abs(factor) > 0.0000000001 {
                j = 0;
                while j < c_total {
                    let old_v: Float = dense_mat_get(&(tab).matrix, i, j);
                    let piv_v: Float = dense_mat_get(&(tab).matrix, pivot_row, j);
                    dense_mat_set((tab).matrix, i, j, old_v - (factor * piv_v));
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }

    let mut new_basics: List[Int] = list_new();
    let mut b_idx: Int = 0;
    while b_idx < (tab).num_constraints {
        if b_idx == pivot_row {
            new_basics = list_push(new_basics, pivot_col);
        } else {
            new_basics = list_push(new_basics, list_get((tab).basic_vars, b_idx));
        }
        b_idx = b_idx + 1;
    }
    (tab).basic_vars = new_basics;
}
