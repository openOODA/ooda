// # LU Factorization with Partial Pivoting
//
// Logline: Computes PA = LU decomposition, matrix determinant, and exact system solver using row permutations.
//
// Setup: Direct Gaussian elimination solver with row pivoting for general square dense matrices.
//
// Beats:
//   1. Define LuFactor structure with L, U matrices, pivot index permutations, and determinant sign.
//   2. Implement Doolittle/Crout factorization with partial row pivoting.
//   3. Solve linear systems LUx = Pb via forward and backward substitution.

import "./eigen_values_qr.oo";

pub type LuFactor = struct {
    dim: Int,
    lu: DenseMatrix,
    pivots: List[Int],
    num_swaps: Int,
    is_singular: Bool,
};

pub fn lu_decompose(mat: &DenseMatrix) -> LuFactor {
    let n: Int = (mat).rows;
    let mut a: DenseMatrix = dense_mat_new(n, n);
    let mut r: Int = 0;
    while r < n {
        let mut c: Int = 0;
        while c < n {
            dense_mat_set(a, r, c, dense_mat_get(mat, r, c));
            c = c + 1;
        }
        r = r + 1;
    }

    let mut piv: List[Int] = list_new();
    let mut k: Int = 0;
    while k < n {
        piv = list_push(piv, k);
        k = k + 1;
    }

    let mut swaps: Int = 0;
    let mut singular: Bool = false;

    let mut i: Int = 0;
    while (i < n) && (singular == false) {
        let mut max_val: Float = math_abs(dense_mat_get(&a, i, i));
        let mut max_row: Int = i;
        let mut row_scan: Int = i + 1;
        while row_scan < n {
            let val: Float = math_abs(dense_mat_get(&a, row_scan, i));
            if val > max_val {
                max_val = val;
                max_row = row_scan;
            }
            row_scan = row_scan + 1;
        }

        if max_val < 0.000000000001 {
            singular = true;
        } else {
            if max_row != i {
                let mut col_swap: Int = 0;
                while col_swap < n {
                    let tmp: Float = dense_mat_get(&a, i, col_swap);
                    dense_mat_set(a, i, col_swap, dense_mat_get(&a, max_row, col_swap));
                    dense_mat_set(a, max_row, col_swap, tmp);
                    col_swap = col_swap + 1;
                }

                let p_i: Int = list_get(piv, i);
                let p_max: Int = list_get(piv, max_row);
                let mut new_piv: List[Int] = list_new();
                let mut p_idx: Int = 0;
                while p_idx < n {
                    if p_idx == i {
                        new_piv = list_push(new_piv, p_max);
                    } else if p_idx == max_row {
                        new_piv = list_push(new_piv, p_i);
                    } else {
                        new_piv = list_push(new_piv, list_get(piv, p_idx));
                    }
                    p_idx = p_idx + 1;
                }
                piv = new_piv;
                swaps = swaps + 1;
            }

            let pivot_val: Float = dense_mat_get(&a, i, i);
            let mut j: Int = i + 1;
            while j < n {
                let mult: Float = dense_mat_get(&a, j, i) / pivot_val;
                dense_mat_set(a, j, i, mult);
                let mut col_elim: Int = i + 1;
                while col_elim < n {
                    let orig: Float = dense_mat_get(&a, j, col_elim);
                    let sub: Float = mult * dense_mat_get(&a, i, col_elim);
                    dense_mat_set(a, j, col_elim, orig - sub);
                    col_elim = col_elim + 1;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }

    return LuFactor {
        dim: n,
        lu: a,
        pivots: piv,
        num_swaps: swaps,
        is_singular: singular,
    };
}

pub fn lu_solve(factor: &LuFactor, b: &List[Float]) -> List[Float] {
    let n: Int = (factor).dim;
    if (factor).is_singular {
        let mut zero_vec: List[Float] = list_new();
        let mut zi: Int = 0;
        while zi < n {
            zero_vec = list_push(zero_vec, 0.0);
            zi = zi + 1;
        }
        return zero_vec;
    }

    let lu: DenseMatrix = (factor).lu;
    let piv: List[Int] = (factor).pivots;

    let mut pb: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let p_idx: Int = list_get(piv, i);
        pb = list_push(pb, list_get(*b, p_idx));
        i = i + 1;
    }

    let mut y: List[Float] = list_new();
    i = 0;
    while i < n {
        let mut sum: Float = 0.0;
        let mut k: Int = 0;
        while k < i {
            sum = sum + (dense_mat_get(&lu, i, k) * list_get(y, k));
            k = k + 1;
        }
        y = list_push(y, list_get(pb, i) - sum);
        i = i + 1;
    }

    let mut x: List[Float] = list_new();
    let mut xi: Int = 0;
    while xi < n {
        x = list_push(x, 0.0);
        xi = xi + 1;
    }

    let mut row: Int = n - 1;
    while row >= 0 {
        let mut sum_back: Float = 0.0;
        let mut col: Int = row + 1;
        while col < n {
            sum_back = sum_back + (dense_mat_get(&lu, row, col) * list_get(x, col));
            col = col + 1;
        }
        let uii: Float = dense_mat_get(&lu, row, row);
        let val_x: Float = (list_get(y, row) - sum_back) / uii;

        let mut next_x: List[Float] = list_new();
        let mut p_col: Int = 0;
        while p_col < n {
            if p_col == row {
                next_x = list_push(next_x, val_x);
            } else {
                next_x = list_push(next_x, list_get(x, p_col));
            }
            p_col = p_col + 1;
        }
        x = next_x;
        row = row - 1;
    }

    return x;
}

pub fn lu_determinant(factor: &LuFactor) -> Float {
    if (factor).is_singular {
        return 0.0;
    }
    let n: Int = (factor).dim;
    let lu: DenseMatrix = (factor).lu;
    let mut det: Float = 1.0;
    let mut i: Int = 0;
    while i < n {
        det = det * dense_mat_get(&lu, i, i);
        i = i + 1;
    }
    if ((factor).num_swaps % 2) != 0 {
        det = 0.0 - det;
    }
    return det;
}

pub fn lu_decomp_probe() -> Int {
    return 0;
}
