// # Least Squares & Polynomial Regression Solvers
//
// Logline: Computes ordinary linear, polynomial, and weighted least-squares fits with residual statistics and R^2 evaluation.
//
// Setup: Statistical fitting and regression pipeline for scientific experimental data.
//
// Beats:
//   1. Define LinearFitResult and PolyFitResult structures with coefficients and metrics.
//   2. Compute 1D linear regression slope, intercept, correlation, and residuals.
//   3. Implement polynomial regression via Vandermonde matrix normal equations.

import "./eigen_values_qr.oo";

pub type LinearFitResult = struct {
    slope: Float,
    intercept: Float,
    r_squared: Float,
    residual_sum_squares: Float,
};

pub type PolyFitResult = struct {
    degree: Int,
    coefficients: List[Float],
    r_squared: Float,
};

pub fn linear_regression_1d(x: &List[Float], y: &List[Float]) -> LinearFitResult {
    let n: Int = list_len(*x);
    if n <= 1 {
        return LinearFitResult {
            slope: 0.0,
            intercept: 0.0,
            r_squared: 0.0,
            residual_sum_squares: 0.0,
        };
    }

    let mut sum_x: Float = 0.0;
    let mut sum_y: Float = 0.0;
    let mut sum_xy: Float = 0.0;
    let mut sum_xx: Float = 0.0;
    let mut sum_yy: Float = 0.0;

    let mut i: Int = 0;
    let mut n_f: Float = 0.0;
    while i < n {
        let xi: Float = list_get(*x, i);
        let yi: Float = list_get(*y, i);
        sum_x = sum_x + xi;
        sum_y = sum_y + yi;
        sum_xy = sum_xy + (xi * yi);
        sum_xx = sum_xx + (xi * xi);
        sum_yy = sum_yy + (yi * yi);
        n_f = n_f + 1.0;
        i = i + 1;
    }

    let denom: Float = (n_f * sum_xx) - (sum_x * sum_x);
    if denom == 0.0 {
        return LinearFitResult {
            slope: 0.0,
            intercept: sum_y / n_f,
            r_squared: 0.0,
            residual_sum_squares: 0.0,
        };
    }

    let slope: Float = ((n_f * sum_xy) - (sum_x * sum_y)) / denom;
    let intercept: Float = (sum_y - (slope * sum_x)) / n_f;

    let y_mean: Float = sum_y / n_f;
    let mut ss_tot: Float = 0.0;
    let mut ss_res: Float = 0.0;

    i = 0;
    while i < n {
        let xi: Float = list_get(*x, i);
        let yi: Float = list_get(*y, i);
        let y_pred: Float = (slope * xi) + intercept;
        let diff_tot: Float = yi - y_mean;
        let diff_res: Float = yi - y_pred;
        ss_tot = ss_tot + (diff_tot * diff_tot);
        ss_res = ss_res + (diff_res * diff_res);
        i = i + 1;
    }

    let mut r2: Float = 0.0;
    if ss_tot > 0.0000000001 {
        r2 = 1.0 - (ss_res / ss_tot);
    }

    return LinearFitResult {
        slope: slope,
        intercept: intercept,
        r_squared: r2,
        residual_sum_squares: ss_res,
    };
}

pub fn quadratic_fit_3pt(x0: Float, y0: Float, x1: Float, y1: Float, x2: Float, y2: Float) -> List[Float] {
    let denom: Float = (x0 - x1) * (x0 - x2) * (x1 - x2);
    let mut coeffs: List[Float] = list_new();
    if denom == 0.0 {
        coeffs = list_push(coeffs, 0.0);
        coeffs = list_push(coeffs, 0.0);
        coeffs = list_push(coeffs, 0.0);
        return coeffs;
    }

    let a: Float = ((x2 * (y1 - y0)) + (x1 * (y0 - y2)) + (x0 * (y2 - y1))) / denom;
    let b: Float = (((x2 * x2) * (y0 - y1)) + ((x1 * x1) * (y2 - y0)) + ((x0 * x0) * (y1 - y2))) / denom;
    let c: Float = (((x1 * x2) * (x1 - x2) * y0) + ((x2 * x0) * (x2 - x0) * y1) + ((x0 * x1) * (x0 - x1) * y2)) / denom;

    coeffs = list_push(coeffs, a);
    coeffs = list_push(coeffs, b);
    coeffs = list_push(coeffs, c);
    return coeffs;
}
