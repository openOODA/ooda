// # Discrete Cosine Transform (DCT-II & IDCT)
//
// Logline: Orthonormal DCT-II forward spectral transform and DCT-III inverse reconstruction for signal energy compaction.
//
// Setup: Frequency-domain transform widely used in JPEG compression and spectral PDE methods.
//
// Beats:
//   1. Implement Taylor series approximation for trigonometric cosine.
//   2. Compute 1D orthonormal forward DCT-II transform.
//   3. Compute 1D inverse discrete cosine transform (DCT-III / IDCT).

import "./eigen_values_qr.oo";

pub fn math_cos_approx(x: Float) -> Float {
    let pi: Float = 3.141592653589793;
    let mut val: Float = x;
    while val > pi {
        val = val - (2.0 * pi);
    }
    while val < (0.0 - pi) {
        val = val + (2.0 * pi);
    }

    let x2: Float = val * val;
    let x4: Float = x2 * x2;
    let x6: Float = x4 * x2;

    let c2: Float = 1.0 / 2.0;
    let c4: Float = 1.0 / 24.0;
    let c6: Float = 1.0 / 720.0;

    return 1.0 - (c2 * x2) + (c4 * x4) - (c6 * x6);
}

pub fn dct_2_forward(signal: &List[Float]) -> List[Float] {
    let n: Int = list_len(*signal);
    if n == 0 {
        return list_new();
    }

    let pi: Float = 3.141592653589793;
    let mut n_f: Float = 0.0;
    let mut count: Int = 0;
    while count < n {
        n_f = n_f + 1.0;
        count = count + 1;
    }

    let factor: Float = math_sqrt(2.0 / n_f);
    let dc_factor: Float = math_sqrt(1.0 / n_f);

    let mut out: List[Float] = list_new();
    let mut k: Int = 0;
    let mut k_f: Float = 0.0;
    while k < n {
        let mut sum: Float = 0.0;
        let mut i: Int = 0;
        let mut i_f: Float = 0.0;
        while i < n {
            let angle: Float = (pi / n_f) * (i_f + 0.5) * k_f;
            let c: Float = math_cos_approx(angle);
            let s_val: Float = list_get(*signal, i);
            sum = sum + (s_val * c);
            i_f = i_f + 1.0;
            i = i + 1;
        }

        if k == 0 {
            out = list_push(out, sum * dc_factor);
        } else {
            out = list_push(out, sum * factor);
        }
        k_f = k_f + 1.0;
        k = k + 1;
    }

    return out;
}

pub fn dct_2_inverse(coeffs: &List[Float]) -> List[Float] {
    let n: Int = list_len(*coeffs);
    if n == 0 {
        return list_new();
    }

    let pi: Float = 3.141592653589793;
    let mut n_f: Float = 0.0;
    let mut count: Int = 0;
    while count < n {
        n_f = n_f + 1.0;
        count = count + 1;
    }

    let factor: Float = math_sqrt(2.0 / n_f);
    let dc_factor: Float = math_sqrt(1.0 / n_f);

    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    let mut i_f: Float = 0.0;
    while i < n {
        let mut sum: Float = (list_get(*coeffs, 0) * dc_factor);
        let mut k: Int = 1;
        let mut k_f: Float = 1.0;
        while k < n {
            let angle: Float = (pi / n_f) * (i_f + 0.5) * k_f;
            let c: Float = math_cos_approx(angle);
            let ck: Float = list_get(*coeffs, k);
            sum = sum + (ck * factor * c);
            k_f = k_f + 1.0;
            k = k + 1;
        }
        out = list_push(out, sum);
        i_f = i_f + 1.0;
        i = i + 1;
    }

    return out;
}
