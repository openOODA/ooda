// # 2D Geometric Algebra Cl(2,0) Multivectors
//
// Logline: 4-component multivector arithmetic (scalar, vectors e1/e2, bivector e12) with geometric and wedge products.
//
// Setup: Geometric algebra primitives for 2D rotations, reflections, and exterior calculus.
//
// Beats:
//   1. Define MultiVector2D structure with scalar, vector, and pseudoscalar components.
//   2. Compute geometric product, wedge (outer) product, and dot (inner) product.
//   3. Implement reversion, multivector norm, and multiplicative inverse.

import "./eigen_values_qr.oo";

pub type MultiVector2D = struct {
    s: Float,
    e1: Float,
    e2: Float,
    e12: Float
};

pub fn mv2_new(s: Float, e1: Float, e2: Float, e12: Float) -> MultiVector2D {
    return MultiVector2D {
        s: s,
        e1: e1,
        e2: e2,
        e12: e12
    };
}

pub fn mv2_scalar(s: Float) -> MultiVector2D {
    return mv2_new(s, 0.0, 0.0, 0.0);
}

pub fn mv2_vector(x: Float, y: Float) -> MultiVector2D {
    return mv2_new(0.0, x, y, 0.0);
}

pub fn mv2_bivector(b: Float) -> MultiVector2D {
    return mv2_new(0.0, 0.0, 0.0, b);
}

pub fn mv2_add(a: &MultiVector2D, b: &MultiVector2D) -> MultiVector2D {
    return MultiVector2D {
        s: (a).s + (b).s,
        e1: (a).e1 + (b).e1,
        e2: (a).e2 + (b).e2,
        e12: (a).e12 + (b).e12
    };
}

pub fn mv2_sub(a: &MultiVector2D, b: &MultiVector2D) -> MultiVector2D {
    return MultiVector2D {
        s: (a).s - (b).s,
        e1: (a).e1 - (b).e1,
        e2: (a).e2 - (b).e2,
        e12: (a).e12 - (b).e12
    };
}

pub fn mv2_scale(a: &MultiVector2D, factor: Float) -> MultiVector2D {
    return MultiVector2D {
        s: (a).s * factor,
        e1: (a).e1 * factor,
        e2: (a).e2 * factor,
        e12: (a).e12 * factor
    };
}

pub fn mv2_geometric_prod(a: &MultiVector2D, b: &MultiVector2D) -> MultiVector2D {
    let s: Float = ((a).s * (b).s) + ((a).e1 * (b).e1) + ((a).e2 * (b).e2) - ((a).e12 * (b).e12);
    let e1: Float = ((a).s * (b).e1) + ((a).e1 * (b).s) - ((a).e2 * (b).e12) + ((a).e12 * (b).e2);
    let e2: Float = ((a).s * (b).e2) + ((a).e1 * (b).e12) + ((a).e2 * (b).s) - ((a).e12 * (b).e1);
    let e12: Float = ((a).s * (b).e12) + ((a).e1 * (b).e2) - ((a).e2 * (b).e1) + ((a).e12 * (b).s);

    return MultiVector2D {
        s: s,
        e1: e1,
        e2: e2,
        e12: e12
    };
}

pub fn mv2_wedge_prod(a: &MultiVector2D, b: &MultiVector2D) -> MultiVector2D {
    let s: Float = (a).s * (b).s;
    let e1: Float = ((a).s * (b).e1) + ((a).e1 * (b).s);
    let e2: Float = ((a).s * (b).e2) + ((a).e2 * (b).s);
    let e12: Float = ((a).s * (b).e12) + ((a).e1 * (b).e2) - ((a).e2 * (b).e1) + ((a).e12 * (b).s);

    return MultiVector2D {
        s: s,
        e1: e1,
        e2: e2,
        e12: e12
    };
}

pub fn mv2_reverse(a: &MultiVector2D) -> MultiVector2D {
    return MultiVector2D {
        s: (a).s,
        e1: (a).e1,
        e2: (a).e2,
        e12: 0.0 - (a).e12
    };
}

pub fn mv2_norm_sq(a: &MultiVector2D) -> Float {
    let rev: MultiVector2D = mv2_reverse(a);
    let prod: MultiVector2D = mv2_geometric_prod(a, &rev);
    return (prod).s;
}

pub fn mv2_norm(a: &MultiVector2D) -> Float {
    return math_sqrt(mv2_norm_sq(a));
}
