// # Nelder-Mead Downhill Simplex Optimizer
//
// Logline: Direct search derivative-free geometric optimization for unconstrained multi-dimensional functions.
//
// Setup: Heuristic downhill simplex operations (reflection, expansion, contraction, shrink) on N-dimensional vertices.
//
// Beats:
//   1. Define SimplexVertex and NelderMeadConfig data structures.
//   2. Compute geometric centroid of non-worst simplex vertices.
//   3. Implement reflection, expansion, outside/inside contraction, and shrink transforms.

import "./eigen_values_qr.oo";
import "./eigen_vectors_power.oo";

pub type SimplexVertex = struct {
    point: List[Float],
    value: Float,
};

pub type NelderMeadConfig = struct {
    max_iters: Int,
    tolerance: Float,
    alpha_reflect: Float,
    gamma_expand: Float,
    rho_contract: Float,
    sigma_shrink: Float,
};

pub fn nelder_mead_config_default() -> NelderMeadConfig {
    return NelderMeadConfig {
        max_iters: 500,
        tolerance: 0.000001,
        alpha_reflect: 1.0,
        gamma_expand: 2.0,
        rho_contract: 0.5,
        sigma_shrink: 0.5,
    };
}

pub fn compute_simplex_centroid(vertices: &List[SimplexVertex], worst_idx: Int) -> List[Float] {
    let num_v: Int = list_len(*vertices);
    if num_v <= 1 {
        return list_new();
    }
    let v0: SimplexVertex = list_get(*vertices, 0);
    let dim: Int = list_len((v0).point);

    let mut centroid: List[Float] = list_new();
    let mut d: Int = 0;
    while d < dim {
        centroid = list_push(centroid, 0.0);
        d = d + 1;
    }

    let mut count_f: Float = 0.0;
    let mut i: Int = 0;
    while i < num_v {
        if i != worst_idx {
            let v_pt: List[Float] = (list_get(*vertices, i)).point;
            d = 0;
            let mut new_c: List[Float] = list_new();
            while d < dim {
                let cur_sum: Float = list_get(centroid, d) + list_get(v_pt, d);
                new_c = list_push(new_c, cur_sum);
                d = d + 1;
            }
            centroid = new_c;
            count_f = count_f + 1.0;
        }
        i = i + 1;
    }

    if count_f > 0.0 {
        let mut scaled_c: List[Float] = list_new();
        d = 0;
        while d < dim {
            scaled_c = list_push(scaled_c, list_get(centroid, d) / count_f);
            d = d + 1;
        }
        return scaled_c;
    }
    return centroid;
}

pub fn reflect_simplex_point(centroid: &List[Float], worst: &List[Float], alpha: Float) -> List[Float] {
    let dim: Int = list_len(*centroid);
    let mut ref_pt: List[Float] = list_new();
    let mut i: Int = 0;
    while i < dim {
        let c_val: Float = list_get(*centroid, i);
        let w_val: Float = list_get(*worst, i);
        ref_pt = list_push(ref_pt, c_val + (alpha * (c_val - w_val)));
        i = i + 1;
    }
    return ref_pt;
}
