// # Coordinate Format (COO) Sparse Triplet Matrix
//
// Logline: Triplet-based sparse matrix representation for incremental assembly and format conversion.
//
// Setup: COO triplet data structures and assembly routines compatible with Eigen and SuiteSparse pipelines.
//
// Beats:
//   1. Define MatrixTriplet and CooMatrix structures for flexible coordinate storage.
//   2. Provide triplet insertion, accumulation, and bounding dimension adjustments.
//   3. Implement COO to CSR conversion and dense vector-triplet operations.

import "./sparse_matrix_csr.oo";

pub type MatrixTriplet = struct {
    row: Int,
    col: Int,
    val: Float,
};

pub type CooMatrix = struct {
    rows: Int,
    cols: Int,
    triplets: List[MatrixTriplet],
    nnz: Int,
};

pub fn matrix_triplet_new(row: Int, col: Int, val: Float) -> MatrixTriplet {
    return MatrixTriplet {
        row: row,
        col: col,
        val: val,
    };
}

pub fn coo_matrix_new(rows: Int, cols: Int) -> CooMatrix {
    return CooMatrix {
        rows: rows,
        cols: cols,
        triplets: list_new(),
        nnz: 0,
    };
}

pub fn coo_add_triplet(mat: &mut CooMatrix, row: Int, col: Int, val: Float) {
    let t: MatrixTriplet = matrix_triplet_new(row, col, val);
    let mut current: List[MatrixTriplet] = (mat).triplets;
    current = list_push(current, t);
    (mat).triplets = current;
    (mat).nnz = (mat).nnz + 1;
}

pub fn coo_get_nnz(mat: &CooMatrix) -> Int {
    return (mat).nnz;
}

pub fn coo_to_csr(mat: &CooMatrix) -> CsrMatrix {
    let nrows: Int = (mat).rows;
    let ncols: Int = (mat).cols;
    let ntriplets: Int = (mat).nnz;

    let mut row_counts: List[Int] = list_new();
    let mut r: Int = 0;
    while r < nrows {
        row_counts = list_push(row_counts, 0);
        r = r + 1;
    }

    let mut k: Int = 0;
    while k < ntriplets {
        let trip: MatrixTriplet = list_get((mat).triplets, k);
        let tr_row: Int = (trip).row;
        if (tr_row >= 0) && (tr_row < nrows) {
            let cur_cnt: Int = list_get(row_counts, tr_row);
            let mut updated_counts: List[Int] = list_new();
            let mut idx: Int = 0;
            while idx < nrows {
                if idx == tr_row {
                    updated_counts = list_push(updated_counts, cur_cnt + 1);
                } else {
                    updated_counts = list_push(updated_counts, list_get(row_counts, idx));
                }
                idx = idx + 1;
            }
            row_counts = updated_counts;
        }
        k = k + 1;
    }

    let mut rptr: List[Int] = list_new();
    rptr = list_push(rptr, 0);
    let mut running_sum: Int = 0;
    r = 0;
    while r < nrows {
        running_sum = running_sum + list_get(row_counts, r);
        rptr = list_push(rptr, running_sum);
        r = r + 1;
    }

    let mut cidx: List[Int] = list_new();
    let mut vals: List[Float] = list_new();
    k = 0;
    while k < ntriplets {
        let trip_item: MatrixTriplet = list_get((mat).triplets, k);
        cidx = list_push(cidx, (trip_item).col);
        vals = list_push(vals, (trip_item).val);
        k = k + 1;
    }

    return csr_matrix_from_raw(nrows, ncols, rptr, cidx, vals);
}

pub fn coo_transpose(mat: &CooMatrix) -> CooMatrix {
    let mut trans: CooMatrix = coo_matrix_new((mat).cols, (mat).rows);
    let n: Int = (mat).nnz;
    let mut i: Int = 0;
    while i < n {
        let t: MatrixTriplet = list_get((mat).triplets, i);
        coo_add_triplet(trans, (t).col, (t).row, (t).val);
        i = i + 1;
    }
    return trans;
}

pub fn coo_scale(mat: &CooMatrix, factor: Float) -> CooMatrix {
    let mut res: CooMatrix = coo_matrix_new((mat).rows, (mat).cols);
    let n: Int = (mat).nnz;
    let mut i: Int = 0;
    while i < n {
        let t: MatrixTriplet = list_get((mat).triplets, i);
        coo_add_triplet(res, (t).row, (t).col, (t).val * factor);
        i = i + 1;
    }
    return res;
}
