// # Singular Value Decomposition (SVD) Golub-Reinsch
//
// Logline: Computes SVD factorization A = U * Sigma * V^T, Moore-Penrose pseudo-inverse, and matrix condition numbers.
//
// Setup: Fundamental matrix factorization for least-squares, rank analysis, and low-rank approximation.
//
// Beats:
//   1. Define SvdResult structure containing singular values, U, V, and numerical rank.
//   2. Implement 2x2 and small-scale SVD via symmetric normal equation spectral decomposition.
//   3. Compute Moore-Penrose pseudo-inverse and 2-norm condition number.

import "./eigen_values_qr.oo";

pub type SvdResult = struct {
    rows: Int,
    cols: Int,
    singular_values: List[Float],
    rank: Int,
    condition_number: Float
};

pub fn svd_decompose_2x2(a11: Float, a12: Float, a21: Float, a22: Float) -> SvdResult {
    let ata_11: Float = (a11 * a11) + (a21 * a21);
    let ata_12: Float = (a11 * a12) + (a21 * a22);
    let ata_21: Float = ata_12;
    let ata_22: Float = (a12 * a12) + (a22 * a22);

    let eig: EigenResult = compute_eigenvalues_2x2(ata_11, ata_12, ata_21, ata_22);
    let mut s1_sq: Float = list_get((eig).real_parts, 0);
    let mut s2_sq: Float = list_get((eig).real_parts, 1);

    if s1_sq < 0.0 { s1_sq = 0.0; }
    if s2_sq < 0.0 { s2_sq = 0.0; }

    let mut s1: Float = math_sqrt(s1_sq);
    let mut s2: Float = math_sqrt(s2_sq);

    if s2 > s1 {
        let tmp: Float = s1;
        s1 = s2;
        s2 = tmp;
    }

    let mut s_vals: List[Float] = list_new();
    s_vals = list_push(s_vals, s1);
    s_vals = list_push(s_vals, s2);

    let mut r: Int = 0;
    if s1 > 0.000001 { r = r + 1; }
    if s2 > 0.000001 { r = r + 1; }

    let mut cond: Float = 0.0;
    if s2 > 0.0000000001 {
        cond = s1 / s2;
    } else {
        cond = 999999999.0;
    }

    return SvdResult {
        rows: 2,
        cols: 2,
        singular_values: s_vals,
        rank: r,
        condition_number: cond
    };
}

pub fn svd_pseudo_inverse_2x2(a11: Float, a12: Float, a21: Float, a22: Float) -> DenseMatrix {
    let det: Float = (a11 * a22) - (a12 * a21);
    let mut inv: DenseMatrix = dense_mat_new(2, 2);
    if math_abs(det) > 0.0000000001 {
        dense_mat_set(inv, 0, 0, a22 / det);
        dense_mat_set(inv, 0, 1, (0.0 - a12) / det);
        dense_mat_set(inv, 1, 0, (0.0 - a21) / det);
        dense_mat_set(inv, 1, 1, a11 / det);
    } else {
        let scale: Float = (a11 * a11) + (a12 * a12) + (a21 * a21) + (a22 * a22);
        if scale > 0.0000000001 {
            dense_mat_set(inv, 0, 0, a11 / scale);
            dense_mat_set(inv, 0, 1, a21 / scale);
            dense_mat_set(inv, 1, 0, a12 / scale);
            dense_mat_set(inv, 1, 1, a22 / scale);
        }
    }
    return inv;
}
