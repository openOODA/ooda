// # Sobol Quasi-Random Low-Discrepancy Sequence
//
// Logline: 1-D Sobol generator with Gray-code direction numbers.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type SobolGenerator = struct {
    dimension: Int,
    sample_index: Int,
    d0: Int,
    d1: Int,
    d2: Int,
    d3: Int,
    d4: Int,
    last_int: Int
};

pub fn sobol_generator_new(dim: Int) -> SobolGenerator {
    return SobolGenerator {
        dimension: dim,
        sample_index: 0,
        d0: 536870912,
        d1: 268435456,
        d2: 134217728,
        d3: 67108864,
        d4: 33554432,
        last_int: 0
    };
}

pub fn gray_code(n: Int) -> Int {
    return n ^ (n / 2);
}

pub fn sobol_dir_at(gen: SobolGenerator, bit: Int) -> Int {
    if bit == 0 {
        return gen.d0;
    }
    if bit == 1 {
        return gen.d1;
    }
    if bit == 2 {
        return gen.d2;
    }
    if bit == 3 {
        return gen.d3;
    }
    if bit == 4 {
        return gen.d4;
    }
    return 0;
}

pub fn sobol_next_1d(gen: SobolGenerator) -> SobolGenerator {
    let idx: Int = gen.sample_index;
    let mut result_int: Int = 0;
    let mut bit: Int = 0;
    let mut temp: Int = idx;
    while temp > 0 {
        if bit < 5 {
            if (temp % 2) == 1 {
                result_int = result_int ^ sobol_dir_at(gen, bit);
            }
        }
        temp = temp / 2;
        bit = bit + 1;
    }
    return SobolGenerator {
        dimension: gen.dimension,
        sample_index: idx + 1,
        d0: gen.d0,
        d1: gen.d1,
        d2: gen.d2,
        d3: gen.d3,
        d4: gen.d4,
        last_int: result_int
    };
}

pub fn sobol_last_scaled(gen: SobolGenerator) -> Int {
    return gen.last_int;
}
