// # Primal-Dual Interior Point Method for LP
//
// Logline: Solves linear programs along the central path using primal-dual Mehrotra predictor-corrector barrier iterations.
//
// Setup: Polynomial-time interior point optimization for large-scale convex linear programs.
//
// Beats:
//   1. Define IpLpState and IpLpConfig structures tracking primal/dual variables and slack.
//   2. Compute duality gap, complementarity residuals, and barrier parameter mu.
//   3. Implement step-length fraction-to-the-boundary rule ensuring strict positivity.

import "./eigen_values_qr.oo";
import "./eigen_vectors_power.oo";

pub type IpLpConfig = struct {
    max_iters: Int,
    tolerance: Float,
    gamma_step: Float,
};

pub type IpLpState = struct {
    primal_x: List[Float],
    dual_y: List[Float],
    slack_s: List[Float],
    duality_gap: Float,
    iterations: Int,
    converged: Bool,
};

pub fn ip_lp_config_default() -> IpLpConfig {
    return IpLpConfig {
        max_iters: 100,
        tolerance: 0.000001,
        gamma_step: 0.95,
    };
}

pub fn compute_duality_gap(x: &List[Float], s: &List[Float]) -> Float {
    let n: Int = list_len(*x);
    let dot: Float = dense_vec_dot(x, s);
    if n > 0 {
        let mut n_f: Float = 0.0;
        let mut i: Int = 0;
        while i < n {
            n_f = n_f + 1.0;
            i = i + 1;
        }
        return dot / n_f;
    }
    return 0.0;
}

pub fn step_fraction_to_boundary(v: &List[Float], dv: &List[Float], gamma: Float) -> Float {
    let n: Int = list_len(*v);
    let mut max_alpha: Float = 1.0;

    let mut i: Int = 0;
    while i < n {
        let d_val: Float = list_get(*dv, i);
        if d_val < 0.0 {
            let v_val: Float = list_get(*v, i);
            let alpha_i: Float = (0.0 - v_val) / d_val;
            if alpha_i < max_alpha {
                max_alpha = alpha_i;
            }
        }
        i = i + 1;
    }

    return gamma * max_alpha;
}
