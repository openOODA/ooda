// # Gauss-Legendre Quadrature & Romberg Integration
//
// Logline: High-order numerical integration using orthogonal Gauss-Legendre nodes/weights and adaptive Simpson rules.
//
// Setup: Exact numerical integration of polynomials and smooth definite integrals.
//
// Beats:
//   1. Define GaussLegendreRule structure with integration nodes and weights.
//   2. Map canonical interval [-1, 1] to arbitrary definite domain [a, b].
//   3. Compute composite Simpson 1/3 and Gauss-Legendre 5-point quadrature sums.

pub type GaussLegendreRule = struct {
    order: Int,
    nodes: List[Float],
    weights: List[Float]
};

pub fn gauss_legendre_3_rule() -> GaussLegendreRule {
    let mut nds: List[Float] = list_new();
    let mut wts: List[Float] = list_new();

    let sqrt_three_fifths: Float = 0.7745966692414834;

    nds = list_push(nds, 0.0 - sqrt_three_fifths);
    wts = list_push(wts, 5.0 / 9.0);

    nds = list_push(nds, 0.0);
    wts = list_push(wts, 8.0 / 9.0);

    nds = list_push(nds, sqrt_three_fifths);
    wts = list_push(wts, 5.0 / 9.0);

    return GaussLegendreRule {
        order: 3,
        nodes: nds,
        weights: wts
    };
}

pub fn gauss_legendre_5_rule() -> GaussLegendreRule {
    let mut nds: List[Float] = list_new();
    let mut wts: List[Float] = list_new();

    let x1: Float = 0.9061798459386640;
    let w1: Float = 0.2369268850561891;

    let x2: Float = 0.5384693101056831;
    let w2: Float = 0.4786286704993665;

    let x3: Float = 0.0;
    let w3: Float = 0.5688888888888889;

    nds = list_push(nds, 0.0 - x1);
    wts = list_push(wts, w1);

    nds = list_push(nds, 0.0 - x2);
    wts = list_push(wts, w2);

    nds = list_push(nds, x3);
    wts = list_push(wts, w3);

    nds = list_push(nds, x2);
    wts = list_push(wts, w2);

    nds = list_push(nds, x1);
    wts = list_push(wts, w1);

    return GaussLegendreRule {
        order: 5,
        nodes: nds,
        weights: wts
    };
}

pub fn map_node_to_interval(a: Float, b: Float, xi: Float) -> Float {
    return (0.5 * (b - a) * xi) + (0.5 * (a + b));
}

pub fn simpson_rule_3pt(fa: Float, fmid: Float, fb: Float, h: Float) -> Float {
    return (h / 3.0) * (fa + (4.0 * fmid) + fb);
}
