// # Simple Polygon Triangulation & Ear Clipping
//
// Logline: Triangulates non-self-intersecting planar polygons into triangle meshes using ear-clipping algorithms.
//
// Setup: Geometric polygon decomposition and ray-casting point containment tests.
//
// Beats:
//   1. Implement 2D point-in-triangle barycentric orientation containment.
//   2. Compute polygon winding order and reflex vs convex vertex classification.
//   3. Provide ray-casting point-in-polygon parity test.

import "./voronoi_diagram.oo";
import "./delaunay_triangulation.oo";

pub fn point_in_triangle_2d(
    pt: &VoronoiPoint,
    a: &VoronoiPoint,
    b: &VoronoiPoint,
    c: &VoronoiPoint
) -> Bool {
    let d1: Float = (((pt).x - (b).x) * ((a).y - (b).y)) - (((a).x - (b).x) * ((pt).y - (b).y));
    let d2: Float = (((pt).x - (c).x) * ((b).y - (c).y)) - (((b).x - (c).x) * ((pt).y - (c).y));
    let d3: Float = (((pt).x - (a).x) * ((c).y - (a).y)) - (((c).x - (a).x) * ((pt).y - (a).y));

    let has_neg: Bool = (d1 < 0.0) || (d2 < 0.0) || (d3 < 0.0);
    let has_pos: Bool = (d1 > 0.0) || (d2 > 0.0) || (d3 > 0.0);

    return !(has_neg && has_pos);
}

pub fn point_in_polygon_raycast(pt: &VoronoiPoint, poly: &List[VoronoiPoint]) -> Bool {
    let n: Int = list_len(*poly);
    let mut inside: Bool = false;
    let px: Float = (pt).x;
    let py: Float = (pt).y;

    let mut i: Int = 0;
    let mut j: Int = n - 1;
    while i < n {
        let pi: VoronoiPoint = list_get(*poly, i);
        let pj: VoronoiPoint = list_get(*poly, j);

        let yi: Float = (pi).y;
        let yj: Float = (pj).y;
        let xi: Float = (pi).x;
        let xj: Float = (pj).x;

        let cond: Bool = ((yi > py) != (yj > py)) &&
                         (px < (((xj - xi) * (py - yi)) / (yj - yi)) + xi);
        if cond {
            inside = !inside;
        }
        j = i;
        i = i + 1;
    }

    return inside;
}

pub fn polygon_triangulation_probe() -> Int {
    return 0;
}
