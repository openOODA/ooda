// # Cholesky Decomposition & Linear Solver
//
// Logline: Computes lower triangular factor L such that A = L * L^T for symmetric positive-definite matrices.
//
// Setup: Fast direct linear solver and determinant evaluator for positive-definite systems.
//
// Beats:
//   1. Define CholeskyFactor structure storing lower triangular matrix and success flag.
//   2. Implement Cholesky-Banachiewicz algorithm with positive-definiteness verification.
//   3. Provide forward and back substitution solvers for linear systems L L^T x = b.

import "./eigen_values_qr.oo";

pub type CholeskyFactor = struct {
    dim: Int,
    lower: DenseMatrix,
    is_positive_definite: Bool,
};

pub fn cholesky_decompose(mat: &DenseMatrix) -> CholeskyFactor {
    let n: Int = (mat).rows;
    let mut l: DenseMatrix = dense_mat_new(n, n);
    let mut is_spd: Bool = true;

    let mut i: Int = 0;
    while (i < n) && is_spd {
        let mut j: Int = 0;
        while (j <= i) && is_spd {
            let mut sum: Float = 0.0;
            let mut k: Int = 0;
            while k < j {
                let lik: Float = dense_mat_get(&l, i, k);
                let ljk: Float = dense_mat_get(&l, j, k);
                sum = sum + (lik * ljk);
                k = k + 1;
            }

            let aij: Float = dense_mat_get(mat, i, j);
            if i == j {
                let diff: Float = aij - sum;
                if diff <= 0.000000000001 {
                    is_spd = false;
                } else {
                    dense_mat_set(l, i, j, math_sqrt(diff));
                }
            } else {
                let ljj: Float = dense_mat_get(&l, j, j);
                if ljj > 0.000000000001 {
                    dense_mat_set(l, i, j, (aij - sum) / ljj);
                } else {
                    is_spd = false;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    return CholeskyFactor {
        dim: n,
        lower: l,
        is_positive_definite: is_spd,
    };
}

pub fn cholesky_solve(factor: &CholeskyFactor, b: &List[Float]) -> List[Float] {
    let n: Int = (factor).dim;
    let l: DenseMatrix = (factor).lower;

    let mut y: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let mut sum: Float = 0.0;
        let mut k: Int = 0;
        while k < i {
            sum = sum + (dense_mat_get(&l, i, k) * list_get(y, k));
            k = k + 1;
        }
        let bi: Float = list_get(*b, i);
        let lii: Float = dense_mat_get(&l, i, i);
        if lii != 0.0 {
            y = list_push(y, (bi - sum) / lii);
        } else {
            y = list_push(y, 0.0);
        }
        i = i + 1;
    }

    let mut x: List[Float] = list_new();
    let mut idx: Int = 0;
    while idx < n {
        x = list_push(x, 0.0);
        idx = idx + 1;
    }

    let mut row: Int = n - 1;
    while row >= 0 {
        let mut sum_back: Float = 0.0;
        let mut col: Int = row + 1;
        while col < n {
            let lki: Float = dense_mat_get(&l, col, row);
            sum_back = sum_back + (lki * list_get(x, col));
            col = col + 1;
        }
        let yi: Float = list_get(y, row);
        let lii: Float = dense_mat_get(&l, row, row);
        let xi: Float = (yi - sum_back) / lii;

        let mut new_x: List[Float] = list_new();
        let mut p: Int = 0;
        while p < n {
            if p == row {
                new_x = list_push(new_x, xi);
            } else {
                new_x = list_push(new_x, list_get(x, p));
            }
            p = p + 1;
        }
        x = new_x;
        row = row - 1;
    }

    return x;
}

pub fn cholesky_determinant(factor: &CholeskyFactor) -> Float {
    if (factor).is_positive_definite == false {
        return 0.0;
    }
    let n: Int = (factor).dim;
    let l: DenseMatrix = (factor).lower;
    let mut prod: Float = 1.0;
    let mut i: Int = 0;
    while i < n {
        let lii: Float = dense_mat_get(&l, i, i);
        prod = prod * (lii * lii);
        i = i + 1;
    }
    return prod;
}
