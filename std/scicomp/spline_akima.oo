// # Akima Non-Oscillatory Sub-Spline Interpolation
//
// Logline: Robust local cubic interpolation designed to prevent overshoot and spurious oscillations near sharp gradients.
//
// Setup: Non-oscillatory curve fitting using 5-point local derivative estimates.
//
// Beats:
//   1. Define AkimaSpline and AkimaSegment structures.
//   2. Calculate 5-point slope differentials and weighted derivative tangents.
//   3. Interpolate points with monotonic local cubic polynomials.

import "./eigen_values_qr.oo";

pub type AkimaSegment = struct {
    x0: Float,
    x1: Float,
    p0: Float,
    p1: Float,
    d0: Float,
    d1: Float,
};

pub type AkimaSpline = struct {
    segments: List[AkimaSegment],
    count: Int,
};

pub fn akima_segment_eval(seg: &AkimaSegment, x: Float) -> Float {
    let dx: Float = (seg).x1 - (seg).x0;
    if dx == 0.0 {
        return (seg).p0;
    }
    let t: Float = (x - (seg).x0) / dx;
    let t2: Float = t * t;
    let t3: Float = t2 * t;

    let h00: Float = (2.0 * t3) - (3.0 * t2) + 1.0;
    let h10: Float = t3 - (2.0 * t2) + t;
    let h01: Float = (0.0 - (2.0 * t3)) + (3.0 * t2);
    let h11: Float = t3 - t2;

    return (h00 * (seg).p0) + (h10 * dx * (seg).d0) + (h01 * (seg).p1) + (h11 * dx * (seg).d1);
}

pub fn compute_akima_tangent(m1: Float, m2: Float, m3: Float, m4: Float) -> Float {
    let w1: Float = math_abs(m4 - m3);
    let w2: Float = math_abs(m2 - m1);
    let denom: Float = w1 + w2;
    if denom > 0.0000000001 {
        return ((w1 * m2) + (w2 * m3)) / denom;
    }
    return 0.5 * (m2 + m3);
}

pub fn akima_spline_fit(xs: &List[Float], ys: &List[Float]) -> AkimaSpline {
    let n: Int = list_len(*xs);
    if n < 4 {
        return AkimaSpline {
            segments: list_new(),
            count: 0,
        };
    }

    let mut m: List[Float] = list_new();
    let mut i: Int = 0;
    while i < (n - 1) {
        let dx: Float = list_get(*xs, i + 1) - list_get(*xs, i);
        let dy: Float = list_get(*ys, i + 1) - list_get(*ys, i);
        if dx != 0.0 {
            m = list_push(m, dy / dx);
        } else {
            m = list_push(m, 0.0);
        }
        i = i + 1;
    }

    let m0: Float = list_get(m, 0);
    let m1: Float = list_get(m, 1);
    let m_ext_neg1: Float = (2.0 * m0) - m1;
    let m_ext_neg2: Float = (2.0 * m_ext_neg1) - m0;

    let m_last: Float = list_get(m, n - 2);
    let m_prev: Float = list_get(m, n - 3);
    let m_ext_pos1: Float = (2.0 * m_last) - m_prev;
    let m_ext_pos2: Float = (2.0 * m_ext_pos1) - m_last;

    let mut m_all: List[Float] = list_new();
    m_all = list_push(m_all, m_ext_neg2);
    m_all = list_push(m_all, m_ext_neg1);
    i = 0;
    while i < (n - 1) {
        m_all = list_push(m_all, list_get(m, i));
        i = i + 1;
    }
    m_all = list_push(m_all, m_ext_pos1);
    m_all = list_push(m_all, m_ext_pos2);

    let mut tangents: List[Float] = list_new();
    i = 0;
    while i < n {
        let t: Float = compute_akima_tangent(
            list_get(m_all, i),
            list_get(m_all, i + 1),
            list_get(m_all, i + 2),
            list_get(m_all, i + 3)
        );
        tangents = list_push(tangents, t);
        i = i + 1;
    }

    let mut segs: List[AkimaSegment] = list_new();
    i = 0;
    while i < (n - 1) {
        let seg: AkimaSegment = AkimaSegment {
            x0: list_get(*xs, i),
            x1: list_get(*xs, i + 1),
            p0: list_get(*ys, i),
            p1: list_get(*ys, i + 1),
            d0: list_get(tangents, i),
            d1: list_get(tangents, i + 1),
        };
        segs = list_push(segs, seg);
        i = i + 1;
    }

    return AkimaSpline {
        segments: segs,
        count: n - 1,
    };
}
