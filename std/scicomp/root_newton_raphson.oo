// # Newton-Raphson Multi-Dimensional Root Finder
//
// Logline: Finds roots of nonlinear systems of equations using Jacobian matrix linearization and Newton step solves.
//
// Setup: High-order nonlinear equation solver with quadratic local convergence.
//
// Beats:
//   1. Define NewtonConfig and NewtonResult data structures.
//   2. Compute 1D Newton step with derivative division and damping.
//   3. Solve 2x2 nonlinear system using analytical Jacobian inversion.

import "./eigen_values_qr.oo";

pub type NewtonConfig = struct {
    max_iters: Int,
    tolerance: Float,
    damping_factor: Float
};

pub type NewtonResult = struct {
    root_x: Float,
    residual: Float,
    iterations: Int,
    converged: Bool
};

pub fn newton_config_default() -> NewtonConfig {
    return NewtonConfig {
        max_iters: 100,
        tolerance: 0.00000001,
        damping_factor: 1.0
    };
}

pub fn newton_step_1d(x_curr: Float, fx: Float, dfx: Float, alpha: Float) -> Float {
    if math_abs(dfx) < 0.000000000001 {
        return x_curr;
    }
    return x_curr - (alpha * (fx / dfx));
}

pub fn solve_newton_2x2_step(
    x1: Float, x2: Float,
    f1: Float, f2: Float,
    j11: Float, j12: Float,
    j21: Float, j22: Float
) -> List[Float] {
    let det: Float = (j11 * j22) - (j12 * j21);
    let mut next_x: List[Float] = list_new();
    if math_abs(det) < 0.0000000001 {
        next_x = list_push(next_x, x1);
        next_x = list_push(next_x, x2);
        return next_x;
    }

    let dx1: Float = ((0.0 - f1) * j22) - (j12 * (0.0 - f2));
    let dx2: Float = (j11 * (0.0 - f2)) - ((0.0 - f1) * j21);

    next_x = list_push(next_x, x1 + (dx1 / det));
    next_x = list_push(next_x, x2 + (dx2 / det));
    return next_x;
}
