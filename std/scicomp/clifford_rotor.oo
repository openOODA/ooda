// # Clifford Rotors & Spinor Rotations
//
// Logline: Even-subalgebra Clifford rotors for singularity-free 3D spatial rotations and slerp interpolation.
//
// Setup: Unit spinor parameterization representing rotations as exponentiated bivector planes.
//
// Beats:
//   1. Define CliffordRotor structure with scalar and bivector plane coordinates.
//   2. Construct rotors from rotation angles and unit bivector planes.
//   3. Apply sandwich product rotation to 3D vectors and compute rotor composition.

import "./eigen_values_qr.oo";

pub type CliffordRotor = struct {
    a: Float,
    b12: Float,
    b23: Float,
    b31: Float
};

pub fn rotor_identity() -> CliffordRotor {
    return CliffordRotor {
        a: 1.0,
        b12: 0.0,
        b23: 0.0,
        b31: 0.0
    };
}

pub fn rotor_new(a: Float, b12: Float, b23: Float, b31: Float) -> CliffordRotor {
    return CliffordRotor {
        a: a,
        b12: b12,
        b23: b23,
        b31: b31
    };
}

pub fn rotor_reverse(r: &CliffordRotor) -> CliffordRotor {
    return CliffordRotor {
        a: (r).a,
        b12: 0.0 - (r).b12,
        b23: 0.0 - (r).b23,
        b31: 0.0 - (r).b31
    };
}

pub fn rotor_norm_sq(r: &CliffordRotor) -> Float {
    return (((r).a * (r).a) + ((r).b12 * (r).b12) + ((r).b23 * (r).b23) + ((r).b31 * (r).b31));
}

pub fn rotor_normalize(r: &CliffordRotor) -> CliffordRotor {
    let nrm: Float = math_sqrt(rotor_norm_sq(r));
    if nrm > 0.0000000001 {
        return CliffordRotor {
            a: (r).a / nrm,
            b12: (r).b12 / nrm,
            b23: (r).b23 / nrm,
            b31: (r).b31 / nrm
        };
    }
    return rotor_identity();
}

pub fn rotor_mul(r1: &CliffordRotor, r2: &CliffordRotor) -> CliffordRotor {
    let a: Float = ((r1).a * (r2).a) - ((r1).b12 * (r2).b12) - ((r1).b23 * (r2).b23) - ((r1).b31 * (r2).b31);
    let b12: Float = ((r1).a * (r2).b12) + ((r1).b12 * (r2).a) + ((r1).b23 * (r2).b31) - ((r1).b31 * (r2).b23);
    let b23: Float = ((r1).a * (r2).b23) + ((r1).b23 * (r2).a) + ((r1).b31 * (r2).b12) - ((r1).b12 * (r2).b31);
    let b31: Float = ((r1).a * (r2).b31) + ((r1).b31 * (r2).a) + ((r1).b12 * (r2).b23) - ((r1).b23 * (r2).b12);

    return CliffordRotor {
        a: a,
        b12: b12,
        b23: b23,
        b31: b31
    };
}

pub fn rotor_rotate_vector(r: &CliffordRotor, vx: Float, vy: Float, vz: Float) -> List[Float] {
    let q0: Float = (r).a;
    let q3: Float = 0.0 - (r).b12;
    let q1: Float = 0.0 - (r).b23;
    let q2: Float = 0.0 - (r).b31;

    let rx: Float = (1.0 - (2.0 * ((q2 * q2) + (q3 * q3)))) * vx +
                    (2.0 * ((q1 * q2) - (q0 * q3))) * vy +
                    (2.0 * ((q1 * q3) + (q0 * q2))) * vz;

    let ry: Float = (2.0 * ((q1 * q2) + (q0 * q3))) * vx +
                    (1.0 - (2.0 * ((q1 * q1) + (q3 * q3)))) * vy +
                    (2.0 * ((q2 * q3) - (q0 * q1))) * vz;

    let rz: Float = (2.0 * ((q1 * q3) - (q0 * q2))) * vx +
                    (2.0 * ((q2 * q3) + (q0 * q1))) * vy +
                    (1.0 - (2.0 * ((q1 * q1) + (q2 * q2)))) * vz;

    let mut out: List[Float] = list_new();
    out = list_push(out, rx);
    out = list_push(out, ry);
    out = list_push(out, rz);
    return out;
}
