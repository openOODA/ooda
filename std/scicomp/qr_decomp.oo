// # QR Factorization & Orthogonal Projections
//
// Logline: Computes A = Q * R decomposition via Modified Gram-Schmidt orthogonalization for least-squares solvers.
//
// Setup: Direct orthogonal factorization for overdetermined and square linear systems.
//
// Beats:
//   1. Define QrFactor structure storing orthogonal matrix Q and upper triangular R.
//   2. Implement Modified Gram-Schmidt (MGS) orthonormal column decomposition.
//   3. Solve least-squares problems Rx = Q^T b with backward substitution.

import "./eigen_values_qr.oo";
import "./eigen_vectors_power.oo";

pub type QrFactor = struct {
    rows: Int,
    cols: Int,
    q_mat: DenseMatrix,
    r_mat: DenseMatrix,
};

pub fn qr_decompose_mgs(mat: &DenseMatrix) -> QrFactor {
    let m: Int = (mat).rows;
    let n: Int = (mat).cols;

    let mut q: DenseMatrix = dense_mat_new(m, n);
    let mut r: DenseMatrix = dense_mat_new(n, n);

    let mut col: Int = 0;
    while col < n {
        let mut row: Int = 0;
        while row < m {
            dense_mat_set(q, row, col, dense_mat_get(mat, row, col));
            row = row + 1;
        }
        col = col + 1;
    }

    let mut k: Int = 0;
    while k < n {
        let mut sum_sq: Float = 0.0;
        let mut i: Int = 0;
        while i < m {
            let val: Float = dense_mat_get(&q, i, k);
            sum_sq = sum_sq + (val * val);
            i = i + 1;
        }
        let rkk: Float = math_sqrt(sum_sq);
        dense_mat_set(r, k, k, rkk);

        if rkk > 0.0000000001 {
            i = 0;
            while i < m {
                let old_q: Float = dense_mat_get(&q, i, k);
                dense_mat_set(q, i, k, old_q / rkk);
                i = i + 1;
            }
        }

        let mut j: Int = k + 1;
        while j < n {
            let mut dot: Float = 0.0;
            i = 0;
            while i < m {
                dot = dot + (dense_mat_get(&q, i, k) * dense_mat_get(&q, i, j));
                i = i + 1;
            }
            dense_mat_set(r, k, j, dot);

            i = 0;
            while i < m {
                let cur: Float = dense_mat_get(&q, i, j);
                let sub: Float = dot * dense_mat_get(&q, i, k);
                dense_mat_set(q, i, j, cur - sub);
                i = i + 1;
            }
            j = j + 1;
        }
        k = k + 1;
    }

    return QrFactor {
        rows: m,
        cols: n,
        q_mat: q,
        r_mat: r,
    };
}

pub fn qr_solve_least_squares(factor: &QrFactor, b: &List[Float]) -> List[Float] {
    let m: Int = (factor).rows;
    let n: Int = (factor).cols;
    let q: DenseMatrix = (factor).q_mat;
    let r: DenseMatrix = (factor).r_mat;

    let mut qty: List[Float] = list_new();
    let mut j: Int = 0;
    while j < n {
        let mut sum: Float = 0.0;
        let mut i: Int = 0;
        while i < m {
            sum = sum + (dense_mat_get(&q, i, j) * list_get(*b, i));
            i = i + 1;
        }
        qty = list_push(qty, sum);
        j = j + 1;
    }

    let mut x: List[Float] = list_new();
    let mut xi: Int = 0;
    while xi < n {
        x = list_push(x, 0.0);
        xi = xi + 1;
    }

    let mut row: Int = n - 1;
    while row >= 0 {
        let mut sum_back: Float = 0.0;
        let mut col: Int = row + 1;
        while col < n {
            sum_back = sum_back + (dense_mat_get(&r, row, col) * list_get(x, col));
            col = col + 1;
        }
        let r_diag: Float = dense_mat_get(&r, row, row);
        let val_x: Float = (list_get(qty, row) - sum_back) / r_diag;

        let mut next_x: List[Float] = list_new();
        let mut p_col: Int = 0;
        while p_col < n {
            if p_col == row {
                next_x = list_push(next_x, val_x);
            } else {
                next_x = list_push(next_x, list_get(x, p_col));
            }
            p_col = p_col + 1;
        }
        x = next_x;
        row = row - 1;
    }

    return x;
}
