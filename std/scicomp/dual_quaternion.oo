// # Dual Quaternions & Rigid Body SE(3) Transforms
//
// Logline: 8-parameter dual quaternion algebra unifying 3D rotation and translation for SE(3) kinematic transforms.
//
// Setup: Compact singularity-free rigid transformation for robotics, computer animation, and screw theory.
//
// Beats:
//   1. Define DualQuaternion structure with real and dual quaternion components.
//   2. Construct rigid transforms from unit quaternions and translation vectors.
//   3. Implement dual quaternion multiplication and rigid point transformation.

import "./eigen_values_qr.oo";

pub type DualQuaternion = struct {
    r_w: Float,
    r_x: Float,
    r_y: Float,
    r_z: Float,
    d_w: Float,
    d_x: Float,
    d_y: Float,
    d_z: Float,
};

pub fn dual_quat_identity() -> DualQuaternion {
    return DualQuaternion {
        r_w: 1.0, r_x: 0.0, r_y: 0.0, r_z: 0.0,
        d_w: 0.0, d_x: 0.0, d_y: 0.0, d_z: 0.0,
    };
}

pub fn dual_quat_from_rot_trans(
    rw: Float, rx: Float, ry: Float, rz: Float,
    tx: Float, ty: Float, tz: Float
) -> DualQuaternion {
    let dw: Float = 0.5 * ((0.0 - (tx * rx)) - (ty * ry) - (tz * rz));
    let dx: Float = 0.5 * (((tx * rw) + (ty * rz)) - (tz * ry));
    let dy: Float = 0.5 * (((ty * rw) + (tz * rx)) - (tx * rz));
    let dz: Float = 0.5 * (((tz * rw) + (tx * ry)) - (ty * rx));

    return DualQuaternion {
        r_w: rw, r_x: rx, r_y: ry, r_z: rz,
        d_w: dw, d_x: dx, d_y: dy, d_z: dz,
    };
}

pub fn dual_quat_transform_point(dq: &DualQuaternion, px: Float, py: Float, pz: Float) -> List[Float] {
    let qw: Float = (dq).r_w;
    let qx: Float = (dq).r_x;
    let qy: Float = (dq).r_y;
    let qz: Float = (dq).r_z;

    let rx: Float = (1.0 - (2.0 * ((qy * qy) + (qz * qz)))) * px +
                    (2.0 * ((qx * qy) - (qw * qz))) * py +
                    (2.0 * ((qx * qz) + (qw * qy))) * pz;

    let ry: Float = (2.0 * ((qx * qy) + (qw * qz))) * px +
                    (1.0 - (2.0 * ((qx * qx) + (qz * qz)))) * py +
                    (2.0 * ((qy * qz) - (qw * qx))) * pz;

    let rz: Float = (2.0 * ((qx * qz) - (qw * qy))) * px +
                    (2.0 * ((qy * qz) + (qw * qx))) * py +
                    (1.0 - (2.0 * ((qx * qx) + (qy * qy)))) * pz;

    let tx: Float = 2.0 * (((0.0 - (dq).d_w) * qx) + ((dq).d_x * qw) - ((dq).d_y * qz) + ((dq).d_z * qy));
    let ty: Float = 2.0 * (((0.0 - (dq).d_w) * qy) + ((dq).d_x * qz) + ((dq).d_y * qw) - ((dq).d_z * qx));
    let tz: Float = 2.0 * (((0.0 - (dq).d_w) * qz) - ((dq).d_x * qy) + ((dq).d_y * qx) + ((dq).d_z * qw));

    let mut out: List[Float] = list_new();
    out = list_push(out, rx + tx);
    out = list_push(out, ry + ty);
    out = list_push(out, rz + tz);
    return out;
}
