// # B-Spline Basis & Parametric Curve Evaluation
//
// Logline: Evaluates non-uniform B-spline basis functions and curve points using Cox-de Boor recursion.
//
// Setup: Geometric curve modeling and CAGD spline representations.
//
// Beats:
//   1. Define Point2D and BSplineCurve structures.
//   2. Implement Cox-de Boor recursive basis function evaluation.
//   3. Compute parametric B-spline curve coordinates via de Boor evaluation.

pub type Point2D = struct {
    x: Float,
    y: Float
};

pub type BSplineCurve = struct {
    degree: Int,
    knots: List[Float],
    control_points: List[Point2D]
};

pub fn point2d_new(x: Float, y: Float) -> Point2D {
    return Point2D { x: x, y: y };
}

pub fn bspline_curve_new(degree: Int, knots: List[Float], control_points: List[Point2D]) -> BSplineCurve {
    return BSplineCurve {
        degree: degree,
        knots: knots,
        control_points: control_points
    };
}

pub fn bspline_basis_0(i: Int, u: Float, knots: &List[Float]) -> Float {
    let t_i: Float = list_get(*knots, i);
    let t_next: Float = list_get(*knots, i + 1);
    if (u >= t_i) && (u < t_next) {
        return 1.0;
    }
    return 0.0;
}

pub fn bspline_basis_eval(i: Int, p: Int, u: Float, knots: &List[Float]) -> Float {
    if p == 0 {
        return bspline_basis_0(i, u, knots);
    }

    let t_i: Float = list_get(*knots, i);
    let t_ip: Float = list_get(*knots, i + p);
    let t_i1: Float = list_get(*knots, i + 1);
    let t_ip1: Float = list_get(*knots, i + p + 1);

    let mut left: Float = 0.0;
    let d_left: Float = t_ip - t_i;
    if d_left > 0.0000000001 {
        let n_left: Float = bspline_basis_eval(i, p - 1, u, knots);
        left = ((u - t_i) / d_left) * n_left;
    }

    let mut right: Float = 0.0;
    let d_right: Float = t_ip1 - t_i1;
    if d_right > 0.0000000001 {
        let n_right: Float = bspline_basis_eval(i + 1, p - 1, u, knots);
        right = ((t_ip1 - u) / d_right) * n_right;
    }

    return left + right;
}

pub fn bspline_eval_point(curve: &BSplineCurve, u: Float) -> Point2D {
    let n_ctrl: Int = list_len((curve).control_points);
    let p: Int = (curve).degree;
    let knots: List[Float] = (curve).knots;

    let mut px: Float = 0.0;
    let mut py: Float = 0.0;

    let mut i: Int = 0;
    while i < n_ctrl {
        let n_ip: Float = bspline_basis_eval(i, p, u, &knots);
        let pt: Point2D = list_get((curve).control_points, i);
        px = px + (n_ip * (pt).x);
        py = py + (n_ip * (pt).y);
        i = i + 1;
    }

    return Point2D { x: px, y: py };
}
