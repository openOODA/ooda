// # Monte Carlo Multi-Dimensional Integrator
//
// Logline: Multi-dimensional stochastic integration with variance estimation, standard error, and confidence intervals.
//
// Setup: Statistical integration for high-dimensional volumes and expected value estimation.
//
// Beats:
//   1. Define LcgRng state and MonteCarloResult structures.
//   2. Generate pseudo-random uniform variates on unit interval [0, 1).
//   3. Compute sample mean, sample variance, standard error, and 95% confidence bounds.

import "./eigen_values_qr.oo";

pub type LcgRng = struct {
    state: Int,
};

pub type MonteCarloResult = struct {
    integral_estimate: Float,
    standard_error: Float,
    confidence_lower: Float,
    confidence_upper: Float,
    num_samples: Int,
};

pub fn lcg_rng_new(seed: Int) -> LcgRng {
    return LcgRng { state: seed };
}

pub fn lcg_next_float(rng: &mut LcgRng) -> Float {
    let a: Int = 1664525;
    let c: Int = 1013904223;
    let m: Int = 2147483647;

    let next_s: Int = (((a * (rng).state) + c) % m);
    if next_s < 0 {
        (rng).state = 0 - next_s;
    } else {
        (rng).state = next_s;
    }

    let mut f_state: Float = 0.0;
    let mut temp: Int = (rng).state;
    while temp >= 10000 {
        f_state = f_state + 10000.0;
        temp = temp - 10000;
    }
    while temp >= 100 {
        f_state = f_state + 100.0;
        temp = temp - 100;
    }
    while temp >= 1 {
        f_state = f_state + 1.0;
        temp = temp - 1;
    }

    return f_state / 2147483647.0;
}

pub fn monte_carlo_accumulate(samples: &List[Float], volume: Float) -> MonteCarloResult {
    let n: Int = list_len(*samples);
    if n <= 1 {
        return MonteCarloResult {
            integral_estimate: 0.0,
            standard_error: 0.0,
            confidence_lower: 0.0,
            confidence_upper: 0.0,
            num_samples: n,
        };
    }

    let mut sum: Float = 0.0;
    let mut sum_sq: Float = 0.0;
    let mut n_f: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let v: Float = list_get(*samples, i);
        sum = sum + v;
        sum_sq = sum_sq + (v * v);
        n_f = n_f + 1.0;
        i = i + 1;
    }

    let mean: Float = sum / n_f;
    let variance: Float = (sum_sq - (n_f * mean * mean)) / (n_f - 1.0);
    let mut std_err: Float = 0.0;
    if variance > 0.0 {
        std_err = math_sqrt(variance / n_f);
    }

    let est: Float = mean * volume;
    let err: Float = std_err * volume;

    return MonteCarloResult {
        integral_estimate: est,
        standard_error: err,
        confidence_lower: est - (1.96 * err),
        confidence_upper: est + (1.96 * err),
        num_samples: n,
    };
}
