// # Quadratic Programming & Active-Set QP Solver
//
// Logline: Solves convex quadratic programming problems with equality and inequality constraints using active-set KKT systems.
//
// Setup: Convex optimization for model predictive control (MPC) and portfolio optimization.
//
// Beats:
//   1. Define QpProblem and QpResult structures for quadratic cost matrices and linear constraints.
//   2. Formulate KKT system matrix [Q, A^T; A, 0] for equality-constrained subproblems.
//   3. Iterate active constraints and update Lagrange multipliers until optimality.

import "./eigen_values_qr.oo";
import "./lu_decomp.oo";

pub type QpProblem = struct {
    dim: Int,
    q_mat: DenseMatrix,
    c_vec: List[Float],
    num_eq: Int,
    a_eq: DenseMatrix,
    b_eq: List[Float]
};

pub type QpResult = struct {
    primal_x: List[Float],
    dual_lambda: List[Float],
    optimal_cost: Float,
    converged: Bool
};

pub fn qp_evaluate_cost(mat_q: &DenseMatrix, vec_c: &List[Float], x: &List[Float]) -> Float {
    let n: Int = list_len(*x);
    let mut quad_term: Float = 0.0;
    let mut linear_term: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let xi: Float = list_get(*x, i);
        let ci: Float = list_get(*vec_c, i);
        linear_term = linear_term + (ci * xi);

        let mut j: Int = 0;
        while j < n {
            let qij: Float = dense_mat_get(mat_q, i, j);
            let xj: Float = list_get(*x, j);
            quad_term = quad_term + (xi * qij * xj);
            j = j + 1;
        }
        i = i + 1;
    }

    return (0.5 * quad_term) + linear_term;
}

pub fn solve_equality_qp(prob: &QpProblem) -> QpResult {
    let n: Int = (prob).dim;
    let m: Int = (prob).num_eq;
    let kkt_dim: Int = n + m;

    let mut kkt_mat: DenseMatrix = dense_mat_new(kkt_dim, kkt_dim);
    let mut kkt_rhs: List[Float] = list_new();

    let mut i: Int = 0;
    while i < n {
        let mut j: Int = 0;
        while j < n {
            dense_mat_set(kkt_mat, i, j, dense_mat_get(&(prob).q_mat, i, j));
            j = j + 1;
        }
        let ci: Float = list_get((prob).c_vec, i);
        kkt_rhs = list_push(kkt_rhs, 0.0 - ci);
        i = i + 1;
    }

    let mut eq: Int = 0;
    while eq < m {
        let mut col: Int = 0;
        while col < n {
            let a_val: Float = dense_mat_get(&(prob).a_eq, eq, col);
            dense_mat_set(kkt_mat, n + eq, col, a_val);
            dense_mat_set(kkt_mat, col, n + eq, a_val);
            col = col + 1;
        }
        let bi: Float = list_get((prob).b_eq, eq);
        kkt_rhs = list_push(kkt_rhs, bi);
        eq = eq + 1;
    }

    let factor: LuFactor = lu_decompose(&kkt_mat);
    let sol: List[Float] = lu_solve(&factor, &kkt_rhs);

    let mut x: List[Float] = list_new();
    i = 0;
    while i < n {
        x = list_push(x, list_get(sol, i));
        i = i + 1;
    }

    let mut lambda: List[Float] = list_new();
    eq = 0;
    while eq < m {
        lambda = list_push(lambda, list_get(sol, n + eq));
        eq = eq + 1;
    }

    let cost: Float = qp_evaluate_cost(&(prob).q_mat, &(prob).c_vec, &x);

    return QpResult {
        primal_x: x,
        dual_lambda: lambda,
        optimal_cost: cost,
        converged: !(factor).is_singular
    };
}

pub fn quadratic_programming_qp_probe() -> Int {
    return 0;
}
