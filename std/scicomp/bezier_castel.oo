// # Zero-Trust Bezier Curve (de Casteljau evaluation)
//
// Logline: Evaluates a Bezier curve of arbitrary degree via de Casteljau's algorithm; returns Result[T, String] with fail-closed logic on t-range and degenerate control point lists.
//
// Setup: Pure value-returning helpers, no IO. Control points are 2D Floats encoded as List[Float] of length 2 [x, y]. The parameter t must lie in [0, 1]. The number of control points must be >= 2.
//
// Beats:
//   1. Validate t in [0, 1]; Err otherwise.
//   2. Validate the control point list has length 2 + 2*n (n >= 1); Err otherwise.
//   3. Apply de Casteljau subdivision iteratively to evaluate the curve at t.
//   4. Return the point on the curve as a 2-elem List[Float] [x, y].

pub fn bezier_castel_min_pts() -> Int { return 2; }

// bezier_castel_make_pt encodes a 2D point as a List[Float] of length 2.
pub fn bezier_castel_make_pt(x: Float, y: Float) -> List[Float] {
    let mut p: List[Float] = list_new();
    p = list_push(p, x);
    p = list_push(p, y);
    return p;
}

pub fn bezier_castel_get_x(p: List[Float]) -> Float { return list_get(p, 0); }
pub fn bezier_castel_get_y(p: List[Float]) -> Float { return list_get(p, 1); }

// bezier_castel_validate_t returns Err when t is outside [0, 1].
pub fn bezier_castel_validate_t(t: Float) -> Result[Void, String] {
    if t < 0.0 { return Err("E_BEZIER_T_NEGATIVE"); }
    if t > 1.0 { return Err("E_BEZIER_T_OVERFLOW"); }
    return Ok(());
}

// bezier_castel_validate_pts returns Err when the control point list length is
// not at least 2 or is not a multiple of 2 (each point is 2 floats).
pub fn bezier_castel_validate_pts(pts: List[Float]) -> Result[Void, String] {
    let n: Int = list_len(pts);
    if n < bezier_castel_min_pts() { return Err("E_BEZIER_PTS_TOO_FEW"); }
    if (n - (n / 2) * 2) != 0 { return Err("E_BEZIER_PTS_NOT_EVEN"); }
    return Ok(());
}

// bezier_castel_lerp returns the linear interpolation between a and b at t:
// (1 - t) * a + t * b.
pub fn bezier_castel_lerp(a: Float, b: Float, t: Float) -> Float {
    let one_minus_t: Float = 1.0 - t;
    return one_minus_t * a + t * b;
}

// bezier_castel_lerp_pt returns the linear interpolation between two points.
pub fn bezier_castel_lerp_pt(a: List[Float], b: List[Float], t: Float) -> List[Float] {
    let x: Float = bezier_castel_lerp(bezier_castel_get_x(a), bezier_castel_get_x(b), t);
    let y: Float = bezier_castel_lerp(bezier_castel_get_y(a), bezier_castel_get_y(b), t);
    return bezier_castel_make_pt(x, y);
}

// bezier_castel_pt_at returns the i-th point from a flat list of [x0, y0, x1, y1, ...].
pub fn bezier_castel_pt_at(flat: List[Float], i: Int) -> List[Float] {
    let mut p: List[Float] = list_new();
    p = list_push(p, list_get(flat, i * 2));
    p = list_push(p, list_get(flat, i * 2 + 1));
    return p;
}

// bezier_castel_num_pts returns the number of points in a flat list.
pub fn bezier_castel_num_pts(flat: List[Float]) -> Int { return list_len(flat) / 2; }

// bezier_castel_evaluate applies de Casteljau's algorithm and returns the point
// on the curve at parameter t. Pure value-returning; no hidden state.
pub fn bezier_castel_evaluate(pts: List[Float], t: Float) -> Result[List[Float], String] {
    if bezier_castel_validate_t(t).is_err() == true { return Err("E_BEZIER_T_OUT_OF_RANGE"); }
    if bezier_castel_validate_pts(pts).is_err() == true { return Err("E_BEZIER_PTS_INVALID"); }
    let n: Int = bezier_castel_num_pts(pts);
    if n == 1 { return Ok(bezier_castel_pt_at(pts, 0)); }
    // Iterative de Casteljau: at each step, the working list shrinks by one.
    let mut working: List[Float] = pts;
    let mut k: Int = n;
    while k > 1 {
        let mut next: List[Float] = list_new();
        let mut i: Int = 0;
        while i < k - 1 {
            let a: List[Float] = bezier_castel_pt_at(working, i);
            let b: List[Float] = bezier_castel_pt_at(working, i + 1);
            let p: List[Float] = bezier_castel_lerp_pt(a, b, t);
            next = list_push(next, bezier_castel_get_x(p));
            next = list_push(next, bezier_castel_get_y(p));
            i = i + 1;
        }
        working = next;
        k = k - 1;
    }
    return Ok(bezier_castel_pt_at(working, 0));
}

// NOTE: bezier_castel_derivative_pts (n*(P_{i+1}-P_i)) was removed because
// a second Result[List[Float],String] function in the same file trips the
// C-emit protos pass (ag/grok fixing). Main API surface remains
// bezier_castel_evaluate.

// bezier_castel_int_to_float_helper converts an Int to a Float (Float*Int C-emit workaround).
pub fn bezier_castel_int_to_float_helper(x: Int) -> Float {
    let mut out: Float = 0.0;
    if x < 0 {
        let mut i: Int = 0;
        while i > x {
            out = out - 1.0;
            i = i - 1;
        }
        return out;
    }
    let mut i: Int = 0;
    while i < x {
        out = out + 1.0;
        i = i + 1;
    }
    return out;
}

verify bezier_castel_validates {
    let empty: List[Float] = list_new();
    let r1: Result[List[Float], String] = bezier_castel_evaluate(empty, 0.5);
    assert_eq!(r1.is_err(), true);
    let r2: Result[List[Float], String] = bezier_castel_evaluate(bezier_castel_make_pt(0.0, 0.0), -0.1);
    assert_eq!(r2.is_err(), true);
    let r3: Result[List[Float], String] = bezier_castel_evaluate(bezier_castel_make_pt(0.0, 0.0), 1.5);
    assert_eq!(r3.is_err(), true);
}
