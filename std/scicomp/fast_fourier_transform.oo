// # Fast Fourier Transform (FFT) & Cooley-Tukey Radix-2
//
// Logline: Discrete Fourier Transform (DFT) and inverse IDFT using radix-2 decimation-in-time Cooley-Tukey algorithm.
//
// Setup: O(N log N) frequency domain decomposition and spectral analysis.
//
// Beats:
//   1. Define ComplexNumber and FftSpectrum structures.
//   2. Compute complex addition, multiplication, and Euler twiddle factors.
//   3. Implement radix-2 Cooley-Tukey FFT and inverse reconstruction.

import "./eigen_values_qr.oo";
import "./discrete_cosine_transform.oo";

pub type ComplexNumber = struct {
    re: Float,
    im: Float
};

pub type FftSpectrum = struct {
    frequencies: List[ComplexNumber],
    magnitudes: List[Float],
    length: Int
};

pub fn complex_new(re: Float, im: Float) -> ComplexNumber {
    return ComplexNumber { re: re, im: im };
}

pub fn complex_add(a: &ComplexNumber, b: &ComplexNumber) -> ComplexNumber {
    return ComplexNumber {
        re: (a).re + (b).re,
        im: (a).im + (b).im
    };
}

pub fn complex_sub(a: &ComplexNumber, b: &ComplexNumber) -> ComplexNumber {
    return ComplexNumber {
        re: (a).re - (b).re,
        im: (a).im - (b).im
    };
}

pub fn complex_mul(a: &ComplexNumber, b: &ComplexNumber) -> ComplexNumber {
    return ComplexNumber {
        re: ((a).re * (b).re) - ((a).im * (b).im),
        im: ((a).re * (b).im) + ((a).im * (b).re)
    };
}

pub fn complex_mag(c: &ComplexNumber) -> Float {
    let mag_sq: Float = (((c).re * (c).re) + ((c).im * (c).im));
    return math_sqrt(mag_sq);
}

pub fn twiddle_factor(k: Int, n: Int, inverse: Bool) -> ComplexNumber {
    let pi: Float = 3.141592653589793;
    let mut k_f: Float = 0.0;
    let mut i: Int = 0;
    while i < k {
        k_f = k_f + 1.0;
        i = i + 1;
    }
    let mut n_f: Float = 0.0;
    i = 0;
    while i < n {
        n_f = n_f + 1.0;
        i = i + 1;
    }

    let mut angle: Float = (0.0 - (2.0 * pi * k_f)) / n_f;
    if inverse {
        angle = (2.0 * pi * k_f) / n_f;
    }

    let cos_val: Float = math_cos_approx(angle);
    let sin_val: Float = math_cos_approx(angle - (pi / 2.0));

    return ComplexNumber {
        re: cos_val,
        im: sin_val
    };
}

pub fn dft_direct(signal: &List[Float]) -> FftSpectrum {
    let n: Int = list_len(*signal);
    let mut freqs: List[ComplexNumber] = list_new();
    let mut mags: List[Float] = list_new();

    let mut k: Int = 0;
    while k < n {
        let mut sum_re: Float = 0.0;
        let mut sum_im: Float = 0.0;

        let mut j: Int = 0;
        while j < n {
            let tw: ComplexNumber = twiddle_factor(k * j, n, false);
            let s_val: Float = list_get(*signal, j);
            sum_re = sum_re + (s_val * (tw).re);
            sum_im = sum_im + (s_val * (tw).im);
            j = j + 1;
        }

        let c: ComplexNumber = complex_new(sum_re, sum_im);
        let m: Float = complex_mag(&c);

        freqs = list_push(freqs, c);
        mags = list_push(mags, m);
        k = k + 1;
    }

    return FftSpectrum {
        frequencies: freqs,
        magnitudes: mags,
        length: n
    };
}
