// # Zero-Trust 2D AABB Tree
//
// Logline: 2D axis-aligned bounding box (AABB) tree with linear-build + linear-query semantics, fail-closed on empty input and degenerate boxes (min > max); returns Result[T, String].
//
// Setup: Pure value-returning helpers, no IO. A box is encoded as List[Float] of length 4 [min_x, min_y, max_x, max_y]. The tree is a flat list of nodes. A query returns the list of box indices whose AABB intersects the query AABB.
//
// Beats:
//   1. Validate a box: min_x <= max_x and min_y <= max_y; Err otherwise.
//   2. Construct a tree from a list of AABBs; empty input is allowed.
//   3. Query the tree with an AABB; returns the list of intersecting indices.
//   4. Each box is wrapped in a node with its index for traceability.

// aabb_tree_min_size: a box must have all 4 floats; min is 4 elements.
pub fn aabb_tree_min_len() -> Int { return 4; }

// aabb_tree_int_to_float converts an Int to a Float (C-emit Float*Int workaround).
pub fn aabb_tree_int_to_float(x: Int) -> Float {
    let mut out: Float = 0.0;
    if x < 0 {
        let mut i: Int = 0;
        while i > x {
            out = out - 1.0;
            i = i - 1;
        }
        return out;
    }
    let mut i: Int = 0;
    while i < x {
        out = out + 1.0;
        i = i + 1;
    }
    return out;
}

// aabb_tree_box_new constructs an AABB. Validates that min <= max for both axes.
pub fn aabb_tree_box_new(min_x: Float, min_y: Float, max_x: Float, max_y: Float) -> Result[List[Float], String] {
    if min_x > max_x { return Err("E_AABB_INVERTED_X"); }
    if min_y > max_y { return Err("E_AABB_INVERTED_Y"); }
    let mut b: List[Float] = list_new();
    b = list_push(b, min_x);
    b = list_push(b, min_y);
    b = list_push(b, max_x);
    b = list_push(b, max_y);
    return Ok(b);
}

pub fn aabb_tree_box_min_x(b: List[Float]) -> Float { return list_get(b, 0); }
pub fn aabb_tree_box_min_y(b: List[Float]) -> Float { return list_get(b, 1); }
pub fn aabb_tree_box_max_x(b: List[Float]) -> Float { return list_get(b, 2); }
pub fn aabb_tree_box_max_y(b: List[Float]) -> Float { return list_get(b, 3); }

// aabb_tree_intersects returns true when two AABBs overlap (inclusive on edges).
pub fn aabb_tree_intersects(a: List[Float], b: List[Float]) -> Bool {
    if aabb_tree_box_max_x(a) < aabb_tree_box_min_x(b) { return false; }
    if aabb_tree_box_min_x(a) > aabb_tree_box_max_x(b) { return false; }
    if aabb_tree_box_max_y(a) < aabb_tree_box_min_y(b) { return false; }
    if aabb_tree_box_min_y(a) > aabb_tree_box_max_y(b) { return false; }
    return true;
}

// aabb_tree_validate_list validates every box in the list; returns Err on first
// inversion. Returns Ok(()) when all boxes are well-formed.
pub fn aabb_tree_validate_list(boxes: List[Float]) -> Result[Void, String] {
    let n: Int = list_len(boxes);
    if n == 0 { return Ok(()); }
    if (n - (n / 4) * 4) != 0 { return Err("E_AABB_LIST_LENGTH"); }
    let mut i: Int = 0;
    while i < n {
        let b: List[Float] = aabb_tree_box_at(boxes, i);
        if aabb_tree_box_min_x(b) > aabb_tree_box_max_x(b) { return Err("E_AABB_INVERTED_X"); }
        if aabb_tree_box_min_y(b) > aabb_tree_box_max_y(b) { return Err("E_AABB_INVERTED_Y"); }
        i = i + 4;
    }
    return Ok(());
}

// aabb_tree_box_at returns the i-th box (4 floats) from a flat list of boxes.
pub fn aabb_tree_box_at(flat: List[Float], i: Int) -> List[Float] {
    let mut b: List[Float] = list_new();
    b = list_push(b, list_get(flat, i));
    b = list_push(b, list_get(flat, i + 1));
    b = list_push(b, list_get(flat, i + 2));
    b = list_push(b, list_get(flat, i + 3));
    return b;
}

// aabb_tree_num_boxes returns the number of boxes encoded in a flat list.
pub fn aabb_tree_num_boxes(flat: List[Float]) -> Int { return list_len(flat) / 4; }

// aabb_tree_build builds a flat AABB index from a list of boxes. Each entry
// is the original index; the tree itself is just the list of boxes because
// we use linear-time query semantics.
pub fn aabb_tree_build(boxes: List[Float]) -> Result[List[Float], String] {
    if aabb_tree_validate_list(boxes).is_err() == true { return Err("E_AABB_INVALID_LIST"); }
    let n: Int = aabb_tree_num_boxes(boxes);
    let mut indices: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        indices = list_push(indices, aabb_tree_int_to_float(i));
        i = i + 1;
    }
    return Ok(indices);
}

// aabb_tree_query returns the list of box indices whose AABB intersects the
// query AABB. The query AABB is validated.
pub fn aabb_tree_query(tree: List[Float], boxes: List[Float], q: List[Float]) -> Result[List[Float], String] {
    if aabb_tree_box_min_x(q) > aabb_tree_box_max_x(q) { return Err("E_AABB_QUERY_INVERTED_X"); }
    if aabb_tree_box_min_y(q) > aabb_tree_box_max_y(q) { return Err("E_AABB_QUERY_INVERTED_Y"); }
    let n: Int = aabb_tree_num_boxes(boxes);
    let mut hits: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let b: List[Float] = aabb_tree_box_at(boxes, i);
        if aabb_tree_intersects(b, q) == true {
            hits = list_push(hits, aabb_tree_int_to_float(i));
        }
        i = i + 1;
    }
    return Ok(hits);
}

// aabb_tree_count returns the number of boxes in a tree.
pub fn aabb_tree_count(tree: List[Float]) -> Int { return list_len(tree); }

// NOTE: Result[List[Float],String] C-emit trips codegen on Ok path
// (ag/grok fixing). Verify only Err paths here; Ok paths exercised by
// the proof fixture which uses is_ok/is_err only.
verify aabb_tree_validates {
    let bad: Result[List[Float], String] = aabb_tree_box_new(1.0, 0.0, 0.0, 1.0);
    assert_eq!(bad.is_err(), true);
    let good: Result[List[Float], String] = aabb_tree_box_new(0.0, 0.0, 1.0, 1.0);
    assert_eq!(good.is_ok(), true);
}
