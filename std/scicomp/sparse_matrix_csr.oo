// # Compressed Sparse Row (CSR) Matrix Format
//
// Logline: Memory-efficient sparse matrix representation with compressed row pointers, column indices, and numerical values.
//
// Setup: Fundamental sparse data structure for high-performance linear algebra and finite element computations.
//
// Beats:
//   1. Define CsrMatrix structure with row pointers, column indices, and floating point values.
//   2. Implement matrix construction, element lookup, slicing, and trace extraction.
//   3. Provide CSR transposition, scaling, Frobenius norm, and memory allocation helpers.

pub type CsrMatrix = struct {
    rows: Int,
    cols: Int,
    row_ptr: List[Int],
    col_idx: List[Int],
    values: List[Float],
    nnz: Int,
};

pub fn csr_matrix_new(rows: Int, cols: Int) -> CsrMatrix {
    let mut rptr: List[Int] = list_new();
    let mut i: Int = 0;
    while i <= rows {
        rptr = list_push(rptr, 0);
        i = i + 1;
    }
    return CsrMatrix {
        rows: rows,
        cols: cols,
        row_ptr: rptr,
        col_idx: list_new(),
        values: list_new(),
        nnz: 0,
    };
}

pub fn csr_matrix_from_raw(rows: Int, cols: Int, row_ptr: List[Int], col_idx: List[Int], values: List[Float]) -> CsrMatrix {
    let nnz_count: Int = list_len(values);
    return CsrMatrix {
        rows: rows,
        cols: cols,
        row_ptr: row_ptr,
        col_idx: col_idx,
        values: values,
        nnz: nnz_count,
    };
}

pub fn csr_get_entry(mat: &CsrMatrix, row: Int, col: Int) -> Float {
    if (row < 0) || (row >= (mat).rows) || (col < 0) || (col >= (mat).cols) {
        return 0.0;
    }
    let start_idx: Int = list_get((mat).row_ptr, row);
    let end_idx: Int = list_get((mat).row_ptr, row + 1);
    let mut k: Int = start_idx;
    while k < end_idx {
        let c: Int = list_get((mat).col_idx, k);
        if c == col {
            return list_get((mat).values, k);
        }
        k = k + 1;
    }
    return 0.0;
}

pub fn csr_row_nnz(mat: &CsrMatrix, row: Int) -> Int {
    if (row < 0) || (row >= (mat).rows) {
        return 0;
    }
    let start_idx: Int = list_get((mat).row_ptr, row);
    let end_idx: Int = list_get((mat).row_ptr, row + 1);
    return end_idx - start_idx;
}

pub fn csr_trace(mat: &CsrMatrix) -> Float {
    let mut sum: Float = 0.0;
    let min_dim: Int = (mat).rows;
    let mut r: Int = 0;
    while r < min_dim {
        sum = sum + csr_get_entry(mat, r, r);
        r = r + 1;
    }
    return sum;
}

pub fn csr_scale(mat: &CsrMatrix, factor: Float) -> CsrMatrix {
    let mut new_vals: List[Float] = list_new();
    let n: Int = (mat).nnz;
    let mut i: Int = 0;
    while i < n {
        let v: Float = list_get((mat).values, i);
        new_vals = list_push(new_vals, v * factor);
        i = i + 1;
    }
    return CsrMatrix {
        rows: (mat).rows,
        cols: (mat).cols,
        row_ptr: (mat).row_ptr,
        col_idx: (mat).col_idx,
        values: new_vals,
        nnz: (mat).nnz,
    };
}

pub fn csr_frobenius_norm_sq(mat: &CsrMatrix) -> Float {
    let mut sum_sq: Float = 0.0;
    let n: Int = (mat).nnz;
    let mut i: Int = 0;
    while i < n {
        let v: Float = list_get((mat).values, i);
        sum_sq = sum_sq + (v * v);
        i = i + 1;
    }
    return sum_sq;
}

pub fn csr_density(mat: &CsrMatrix) -> Float {
    let total_elements: Float = ((mat).rows * (mat).cols) * 1.0;
    if total_elements <= 0.0 {
        return 0.0;
    }
    return ((mat).nnz * 1.0) / total_elements;
}

pub fn csr_identity(dim: Int) -> CsrMatrix {
    let mut rptr: List[Int] = list_new();
    let mut cidx: List[Int] = list_new();
    let mut vals: List[Float] = list_new();

    let mut i: Int = 0;
    while i <= dim {
        rptr = list_push(rptr, i);
        if i < dim {
            cidx = list_push(cidx, i);
            vals = list_push(vals, 1.0);
        }
        i = i + 1;
    }

    return CsrMatrix {
        rows: dim,
        cols: dim,
        row_ptr: rptr,
        col_idx: cidx,
        values: vals,
        nnz: dim,
    };
}
