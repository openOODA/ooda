// # Voronoi Diagram Geometric Computation
//
// Logline: Computes 2D Voronoi sites, cell boundaries, bisector lines, and circumcenter dual coordinates.
//
// Setup: Planar spatial partitioning and computational geometry for proximity graphs and meshing.
//
// Beats:
//   1. Define VoronoiPoint, VoronoiEdge, and VoronoiCell structures.
//   2. Compute circumcenter of three points forming Delaunay triangles.
//   3. Generate perpendicular bisectors and nearest-site cell locators.

import "./eigen_values_qr.oo";

pub type VoronoiPoint = struct {
    x: Float,
    y: Float
};

pub type VoronoiEdge = struct {
    start: VoronoiPoint,
    end_pt: VoronoiPoint,
    site_left: Int,
    site_right: Int
};

pub type VoronoiCell = struct {
    site_index: Int,
    site: VoronoiPoint,
    vertices: List[VoronoiPoint]
};

pub fn voronoi_point_new(x: Float, y: Float) -> VoronoiPoint {
    return VoronoiPoint { x: x, y: y };
}

pub fn voronoi_dist_sq(p1: &VoronoiPoint, p2: &VoronoiPoint) -> Float {
    let dx: Float = (p1).x - (p2).x;
    let dy: Float = (p1).y - (p2).y;
    return (dx * dx) + (dy * dy);
}

pub fn triangle_circumcenter(a: &VoronoiPoint, b: &VoronoiPoint, c: &VoronoiPoint) -> VoronoiPoint {
    let d: Float = 2.0 * (((a).x * ((b).y - (c).y)) + ((b).x * ((c).y - (a).y)) + ((c).x * ((a).y - (b).y)));
    if math_abs(d) < 0.0000000001 {
        return VoronoiPoint {
            x: ((a).x + (b).x + (c).x) / 3.0,
            y: ((a).y + (b).y + (c).y) / 3.0
        };
    }

    let a_sq: Float = ((a).x * (a).x) + ((a).y * (a).y);
    let b_sq: Float = ((b).x * (b).x) + ((b).y * (b).y);
    let c_sq: Float = ((c).x * (c).x) + ((c).y * (c).y);

    let ux: Float = ((a_sq * ((b).y - (c).y)) + (b_sq * ((c).y - (a).y)) + (c_sq * ((a).y - (b).y))) / d;
    let uy: Float = ((a_sq * ((c).x - (b).x)) + (b_sq * ((a).x - (c).x)) + (c_sq * ((b).x - (a).x))) / d;

    return VoronoiPoint { x: ux, y: uy };
}

pub fn find_nearest_site(query: &VoronoiPoint, sites: &List[VoronoiPoint]) -> Int {
    let n: Int = list_len(*sites);
    if n == 0 {
        return 0 - 1;
    }
    let mut min_idx: Int = 0;
    let mut min_d2: Float = voronoi_dist_sq(query, &list_get(*sites, 0));

    let mut i: Int = 1;
    while i < n {
        let d2: Float = voronoi_dist_sq(query, &list_get(*sites, i));
        if d2 < min_d2 {
            min_d2 = d2;
            min_idx = i;
        }
        i = i + 1;
    }
    return min_idx;
}
