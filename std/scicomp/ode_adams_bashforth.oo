// # Adams-Bashforth-Moulton Multi-Step ODE Solver
//
// Logline: Multi-step explicit predictor and implicit corrector ODE integrator using history buffers.
//
// Setup: High-efficiency ODE solver for non-stiff systems with smooth vector fields.
//
// Beats:
//   1. Define AdamsHistory and AdamsStepResult structures.
//   2. Compute 4th order Adams-Bashforth explicit predictor step.
//   3. Compute 4th order Adams-Moulton implicit corrector step (PECE mode).

pub type AdamsHistory = struct {
    f0: List[Float],
    f1: List[Float],
    f2: List[Float],
    f3: List[Float],
    steps_available: Int
};

pub type AdamsStepResult = struct {
    y_predicted: List[Float],
    y_corrected: List[Float]
};

pub fn adams_history_new() -> AdamsHistory {
    return AdamsHistory {
        f0: list_new(),
        f1: list_new(),
        f2: list_new(),
        f3: list_new(),
        steps_available: 0
    };
}

pub fn adams_bashforth_4_step(y_curr: &List[Float], h: Float, hist: &AdamsHistory) -> List[Float] {
    let n: Int = list_len(*y_curr);
    let mut y_next: List[Float] = list_new();

    let c0: Float = 55.0 / 24.0;
    let c1: Float = (0.0 - 59.0) / 24.0;
    let c2: Float = 37.0 / 24.0;
    let c3: Float = (0.0 - 9.0) / 24.0;

    let mut i: Int = 0;
    while i < n {
        let yi: Float = list_get(*y_curr, i);
        let f0i: Float = list_get((hist).f0, i);
        let f1i: Float = list_get((hist).f1, i);
        let f2i: Float = list_get((hist).f2, i);
        let f3i: Float = list_get((hist).f3, i);

        let delta: Float = h * ((c0 * f0i) + (c1 * f1i) + (c2 * f2i) + (c3 * f3i));
        y_next = list_push(y_next, yi + delta);
        i = i + 1;
    }
    return y_next;
}

pub fn adams_moulton_4_step(
    y_curr: &List[Float],
    h: Float,
    f_pred: &List[Float],
    hist: &AdamsHistory
) -> List[Float] {
    let n: Int = list_len(*y_curr);
    let mut y_corr: List[Float] = list_new();

    let m_pred: Float = 9.0 / 24.0;
    let m0: Float = 19.0 / 24.0;
    let m1: Float = (0.0 - 5.0) / 24.0;
    let m2: Float = 1.0 / 24.0;

    let mut i: Int = 0;
    while i < n {
        let yi: Float = list_get(*y_curr, i);
        let fp_i: Float = list_get(*f_pred, i);
        let f0i: Float = list_get((hist).f0, i);
        let f1i: Float = list_get((hist).f1, i);
        let f2i: Float = list_get((hist).f2, i);

        let delta: Float = h * ((m_pred * fp_i) + (m0 * f0i) + (m1 * f1i) + (m2 * f2i));
        y_corr = list_push(y_corr, yi + delta);
        i = i + 1;
    }
    return y_corr;
}
