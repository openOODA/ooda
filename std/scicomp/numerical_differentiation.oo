// # Numerical Differentiation & Richardson Extrapolation
//
// Logline: Finite-difference derivative operators, high-order stencils, and Richardson extrapolation for gradients and Hessians.
//
// Setup: Numerical calculus routines for gradient estimation in black-box functions.
//
// Beats:
//   1. Implement forward, backward, and 2nd/4th order central finite differences.
//   2. Compute second derivative stencils and mixed partial differentials.
//   3. Refine derivative accuracy using Richardson extrapolation.

import "./eigen_values_qr.oo";

pub fn diff_forward_1d(fx: Float, fx_plus_h: Float, h: Float) -> Float {
    if h == 0.0 {
        return 0.0;
    }
    return (fx_plus_h - fx) / h;
}

pub fn diff_backward_1d(fx: Float, fx_minus_h: Float, h: Float) -> Float {
    if h == 0.0 {
        return 0.0;
    }
    return (fx - fx_minus_h) / h;
}

pub fn diff_central_2nd_order(fx_plus_h: Float, fx_minus_h: Float, h: Float) -> Float {
    if h == 0.0 {
        return 0.0;
    }
    return (fx_plus_h - fx_minus_h) / (2.0 * h);
}

pub fn diff_central_4th_order(
    fx_plus_2h: Float,
    fx_plus_h: Float,
    fx_minus_h: Float,
    fx_minus_2h: Float,
    h: Float
) -> Float {
    if h == 0.0 {
        return 0.0;
    }
    let num: Float = (0.0 - fx_plus_2h) + (8.0 * fx_plus_h) - (8.0 * fx_minus_h) + fx_minus_2h;
    return num / (12.0 * h);
}

pub fn diff_second_deriv_central(
    fx_plus_h: Float,
    fx: Float,
    fx_minus_h: Float,
    h: Float
) -> Float {
    let h2: Float = h * h;
    if h2 == 0.0 {
        return 0.0;
    }
    return (fx_plus_h - (2.0 * fx) + fx_minus_h) / h2;
}

pub fn diff_richardson_extrapolation(d_h: Float, d_half_h: Float, order: Int) -> Float {
    let mut factor: Float = 4.0;
    if order == 4 {
        factor = 16.0;
    }
    return ((factor * d_half_h) - d_h) / (factor - 1.0);
}
