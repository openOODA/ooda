// # Haar Wavelet Decomposition & Denoising
//
// Logline: 1D Discrete Haar Wavelet Transform (DWT) forward/inverse decomposition and multiscale signal thresholding.
//
// Setup: Fast multiresolution signal analysis and subband filtering.
//
// Beats:
//   1. Define HaarDecomp structure storing approximation and detail coefficient vectors.
//   2. Compute 1D forward orthonormal Haar step dividing into averages and differences.
//   3. Implement inverse Haar reconstruction and universal VisuShrink soft thresholding.

import "./eigen_values_qr.oo";

pub type HaarDecomp = struct {
    approx: List[Float],
    detail: List[Float],
    length: Int,
};

pub fn haar_forward_1d(signal: &List[Float]) -> HaarDecomp {
    let n: Int = list_len(*signal);
    let half_n: Int = n / 2;
    let inv_sqrt2: Float = 0.7071067811865475;

    let mut approx: List[Float] = list_new();
    let mut detail: List[Float] = list_new();

    let mut i: Int = 0;
    while i < half_n {
        let x0: Float = list_get(*signal, 2 * i);
        let x1: Float = list_get(*signal, (2 * i) + 1);

        let avg: Float = (x0 + x1) * inv_sqrt2;
        let diff: Float = (x0 - x1) * inv_sqrt2;

        approx = list_push(approx, avg);
        detail = list_push(detail, diff);
        i = i + 1;
    }

    return HaarDecomp {
        approx: approx,
        detail: detail,
        length: half_n,
    };
}

pub fn haar_inverse_1d(decomp: &HaarDecomp) -> List[Float] {
    let half_n: Int = (decomp).length;
    let inv_sqrt2: Float = 0.7071067811865475;
    let mut recon: List[Float] = list_new();

    let mut i: Int = 0;
    while i < half_n {
        let a: Float = list_get((decomp).approx, i);
        let d: Float = list_get((decomp).detail, i);

        let x0: Float = (a + d) * inv_sqrt2;
        let x1: Float = (a - d) * inv_sqrt2;

        recon = list_push(recon, x0);
        recon = list_push(recon, x1);
        i = i + 1;
    }

    return recon;
}

pub fn soft_threshold(coeffs: &List[Float], threshold: Float) -> List[Float] {
    let n: Int = list_len(*coeffs);
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let c: Float = list_get(*coeffs, i);
        let abs_c: Float = math_abs(c);
        if abs_c <= threshold {
            out = list_push(out, 0.0);
        } else {
            let mut sign: Float = 1.0;
            if c < 0.0 {
                sign = 0.0 - 1.0;
            }
            out = list_push(out, sign * (abs_c - threshold));
        }
        i = i + 1;
    }
    return out;
}

pub fn wavelet_haar_probe() -> Int {
    return 0;
}
