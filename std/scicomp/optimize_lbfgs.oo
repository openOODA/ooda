// # Limited-Memory BFGS (L-BFGS) Optimizer
//
// Logline: Quasi-Newton optimization algorithm storing limited gradient history for large-scale unconstrained minimization.
//
// Setup: Two-loop recursion inverse Hessian approximation for high-dimensional parameter optimization.
//
// Beats:
//   1. Define LbfgsConfig, LbfgsMemory, and LbfgsResult structures.
//   2. Compute L-BFGS two-loop recursion search direction from history vectors.
//   3. Update position and gradient difference pairs (s_k, y_k) and curvature rho_k.

import "./eigen_values_qr.oo";
import "./eigen_vectors_power.oo";

pub type LbfgsConfig = struct {
    max_iters: Int,
    memory_size: Int,
    tolerance: Float,
    step_size: Float
};

pub type LbfgsMemory = struct {
    s_history: List[List[Float]],
    y_history: List[List[Float]],
    rho_history: List[Float],
    count: Int
};

pub type LbfgsResult = struct {
    solution: List[Float],
    iterations: Int,
    final_grad_norm: Float,
    converged: Bool
};

pub fn lbfgs_config_default() -> LbfgsConfig {
    return LbfgsConfig {
        max_iters: 200,
        memory_size: 10,
        tolerance: 0.000001,
        step_size: 1.0
    };
}

pub fn lbfgs_memory_new() -> LbfgsMemory {
    return LbfgsMemory {
        s_history: list_new(),
        y_history: list_new(),
        rho_history: list_new(),
        count: 0
    };
}

pub fn lbfgs_two_loop_direction(mem: &LbfgsMemory, grad: &List[Float]) -> List[Float] {
    let k: Int = (mem).count;
    let n: Int = list_len(*grad);
    if k == 0 {
        return vec_scale_dense(grad, 0.0 - 1.0);
    }

    let mut q: List[Float] = *grad;
    let mut alphas: List[Float] = list_new();
    let mut a_init: Int = 0;
    while a_init < k {
        alphas = list_push(alphas, 0.0);
        a_init = a_init + 1;
    }

    let mut i: Int = k - 1;
    while i >= 0 {
        let si: List[Float] = list_get((mem).s_history, i);
        let yi: List[Float] = list_get((mem).y_history, i);
        let rho_i: Float = list_get((mem).rho_history, i);

        let alpha_i: Float = rho_i * dense_vec_dot(&si, &q);
        let mut new_alphas: List[Float] = list_new();
        let mut p: Int = 0;
        while p < k {
            if p == i {
                new_alphas = list_push(new_alphas, alpha_i);
            } else {
                new_alphas = list_push(new_alphas, list_get(alphas, p));
            }
            p = p + 1;
        }
        alphas = new_alphas;

        let dy: List[Float] = vec_scale_dense(&yi, alpha_i);
        q = vec_sub_dense(&q, &dy);
        i = i - 1;
    }

    let s_last: List[Float] = list_get((mem).s_history, k - 1);
    let y_last: List[Float] = list_get((mem).y_history, k - 1);
    let sy: Float = dense_vec_dot(&s_last, &y_last);
    let yy: Float = dense_vec_dot(&y_last, &y_last);

    let mut gamma: Float = 1.0;
    if yy > 0.0000000001 {
        gamma = sy / yy;
    }

    let mut r: List[Float] = vec_scale_dense(&q, gamma);

    i = 0;
    while i < k {
        let si2: List[Float] = list_get((mem).s_history, i);
        let yi2: List[Float] = list_get((mem).y_history, i);
        let rho_i2: Float = list_get((mem).rho_history, i);
        let alpha_i2: Float = list_get(alphas, i);

        let beta: Float = rho_i2 * dense_vec_dot(&yi2, &r);
        let diff: Float = alpha_i2 - beta;
        let ds: List[Float] = vec_scale_dense(&si2, diff);
        r = vec_add_dense(&r, &ds);
        i = i + 1;
    }

    return vec_scale_dense(&r, 0.0 - 1.0);
}

pub fn vec_scale_dense(v: &List[Float], s: Float) -> List[Float] {
    let n: Int = list_len(*v);
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, list_get(*v, i) * s);
        i = i + 1;
    }
    return out;
}

pub fn vec_add_dense(a: &List[Float], b: &List[Float]) -> List[Float] {
    let n: Int = list_len(*a);
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, list_get(*a, i) + list_get(*b, i));
        i = i + 1;
    }
    return out;
}

pub fn vec_sub_dense(a: &List[Float], b: &List[Float]) -> List[Float] {
    let n: Int = list_len(*a);
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, list_get(*a, i) - list_get(*b, i));
        i = i + 1;
    }
    return out;
}
