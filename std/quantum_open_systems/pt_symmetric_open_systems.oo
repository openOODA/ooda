// # Parity-Time (PT) Symmetric Non-Hermitian Open Systems
//
// Logline: Analyzes gain-loss balanced non-Hermitian Hamiltonians, exceptional point (EP2/EP3) degeneracies, and PT-symmetry breaking transitions.
//
// Setup: Effective non-Hermitian 2x2 Hamiltonian H_PT = [[omega0 + i gamma, J], [J, omega0 - i gamma]] with balanced gain and loss.
//
// Beats:
//   1. Construct PT-symmetric Hamiltonian configuration with coupling J and gain/loss rate gamma.
//   2. Compute complex eigenvalues lambda_pm = omega0 +- sqrt(J^2 - gamma^2).
//   3. Identify exceptional point EP2 at gamma = J and evaluate PT-broken eigenbasis coalescence.

pub type Complex = struct {
    real: Float,
    imag: Float,
};

pub type PtSymmetricParams = struct {
    center_freq_omega0: Float,
    coupling_strength_j: Float,
    gain_loss_gamma: Float,
};

pub fn pt_symmetric_params_new(w0: Float, j: Float, gamma: Float) -> PtSymmetricParams {
    return PtSymmetricParams {
        center_freq_omega0: w0,
        coupling_strength_j: j,
        gain_loss_gamma: gamma,
    };
}

pub type PtEigenvalues = struct {
    lambda_plus: Complex,
    lambda_minus: Complex,
    is_broken_phase: Int,
};

pub fn pt_eigenvalues_compute(p: PtSymmetricParams) -> PtEigenvalues {
    let w0: Float = p.center_freq_omega0;
    let j: Float = p.coupling_strength_j;
    let gamma: Float = p.gain_loss_gamma;

    let delta_sq: Float = (j * j) - (gamma * gamma);
    if delta_sq >= 0.0 {
        let root_val: Float = sqrt(delta_sq);
        let lp: Complex = Complex { real: w0 + root_val, imag: 0.0 };
        let lm: Complex = Complex { real: w0 - root_val, imag: 0.0 };
        return PtEigenvalues {
            lambda_plus: lp,
            lambda_minus: lm,
            is_broken_phase: 0,
        };
    }

    let root_imag: Float = sqrt(0.0 - delta_sq);
    let lp: Complex = Complex { real: w0, imag: root_imag };
    let lm: Complex = Complex { real: w0, imag: 0.0 - root_imag };
    return PtEigenvalues {
        lambda_plus: lp,
        lambda_minus: lm,
        is_broken_phase: 1,
    };
}

pub fn pt_exceptional_point_distance(p: PtSymmetricParams) -> Float {
    let j: Float = p.coupling_strength_j;
    let gamma: Float = p.gain_loss_gamma;
    let mut diff: Float = j - gamma;
    if diff < 0.0 { diff = 0.0 - diff; }
    return diff;
}
