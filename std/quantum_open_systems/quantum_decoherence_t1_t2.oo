// # Quantum Coherence Decay Timescales T1, T2, and T_phi
//
// Logline: Computes longitudinal relaxation time T1, transverse dephasing time T2, pure dephasing T_phi, and verifies 1 / T2 = 1 / (2 T1) + 1 / T_phi.
//
// Setup: Qubit relaxation and dephasing parameter validation for open quantum processors.
//
// Beats:
//   1. Construct DecoherenceTimescales structure (T1 relaxation, T2 dephasing, T_phi pure dephasing).
//   2. Enforce the physical quantum bound T2 <= 2 T1.
//   3. Compute Ramsey coherence decay envelope exp(-t / T2) and inversion recovery 1 - exp(-t / T1).

pub type DecoherenceTimescales = struct {
    t1_relaxation_us: Float,
    t2_dephasing_us: Float,
    t_phi_pure_dephasing_us: Float,
};

pub fn decoherence_times_new(t1: Float, t_phi: Float) -> DecoherenceTimescales {
    let rate_1: Float = 1.0 / (2.0 * t1);
    let rate_phi: Float = 1.0 / t_phi;
    let rate_2: Float = rate_1 + rate_phi;
    let t2: Float = 1.0 / rate_2;

    return DecoherenceTimescales {
        t1_relaxation_us: t1,
        t2_dephasing_us: t2,
        t_phi_pure_dephasing_us: t_phi,
    };
}

pub fn decoherence_validate_bound(times: DecoherenceTimescales) -> Int {
    let t1: Float = times.t1_relaxation_us;
    let t2: Float = times.t2_dephasing_us;
    if t2 <= ((2.0 * t1) + 0.0001) {
        return 1;
    }
    return 0;
}

pub fn decoherence_ramsey_decay(times: DecoherenceTimescales, t_us: Float) -> Float {
    let t2: Float = times.t2_dephasing_us;
    return exp(0.0 - (t_us / t2));
}

pub fn decoherence_t1_inversion_recovery(times: DecoherenceTimescales, t_us: Float) -> Float {
    let t1: Float = times.t1_relaxation_us;
    return 1.0 - exp(0.0 - (t_us / t1));
}
