// -------------------------------------------------------------------
// Unified Open Quantum Systems Runtime Configuration
// -------------------------------------------------------------------

pub type OpenQuantumRuntimeConfig = struct {
    default_time_step_ns: Float,
    bath_temperature_mk: Float,
    enable_quantum_jumps: Int,
    monte_carlo_trajectories: Int,
};

pub fn open_quantum_runtime_default() -> OpenQuantumRuntimeConfig {
    return OpenQuantumRuntimeConfig {
        default_time_step_ns: 0.1,
        bath_temperature_mk: 15.0,
        enable_quantum_jumps: 1,
        monte_carlo_trajectories: 500,
    };
}

// -------------------------------------------------------------------
// High-Level Facade Convenience Shims
// -------------------------------------------------------------------

pub fn qos_lindblad_dissipator_default() -> LindbladDissipator2x2 {
    return lindblad_dissipator_default();
}

pub fn qos_thermal_reservoir_cryogenic() -> ThermalReservoir {
    return thermal_reservoir_cryogenic();
}

pub fn qos_decoherence_times(t1: Float, t_phi: Float) -> DecoherenceTimescales {
    return decoherence_times_new(t1, t_phi);
}

pub fn qos_udd_schedule(total_t: Float, n: Int) -> List[Float] {
    let seq: UddSequence = udd_sequence_new(total_t, n);
    return udd_schedule_generate(seq);
}

pub fn qos_gaussian_state_vacuum() -> GaussianState1Mode {
    return gaussian_state_vacuum();
}
