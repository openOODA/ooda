// # Superoperator Vectorization & Liouvillian Supermatrix Formalism
//
// Logline: Converts 2x2 density matrices to 4-vectors |rho>> and constructs 4x4 Liouvillian supermatrices for linear algebraic time evolution.
//
// Setup: Liouville space matrix-to-vector isomorphism (column-stacking) mapping master equations to d|rho>>/dt = L |rho>>.
//
// Beats:
//   1. Implement vectorization |rho>> = [rho00, rho10, rho01, rho11]^T.
//   2. Build 4x4 Liouvillian supermatrix including coherent and Lindblad dissipator entries.
//   3. Apply Liouvillian supermatrix product to statevector.

pub type Complex = struct {
    real: Float,
    imag: Float
};

pub fn sv_c_new(r: Float, i: Float) -> Complex {
    return Complex { real: r, imag: i };
}

pub fn sv_c_add(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let br: Float = b.real;
    let bi: Float = b.imag;
    return Complex { real: ar + br, imag: ai + bi };
}

pub fn sv_c_mul(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let br: Float = b.real;
    let bi: Float = b.imag;
    return Complex {
        real: (ar * br) - (ai * bi),
        imag: (ar * bi) + (ai * br)
    };
}

pub type Vector4Complex = struct {
    v0: Complex,
    v1: Complex,
    v2: Complex,
    v3: Complex
};

pub fn vectorize_density_matrix(r00: Complex, r01: Complex, r10: Complex, r11: Complex) -> Vector4Complex {
    return Vector4Complex { v0: r00, v1: r10, v2: r01, v3: r11 };
}

pub type SuperMatrix4x4 = struct {
    l00: Complex,
    l03: Complex,
    l11: Complex,
    l22: Complex,
    l30: Complex,
    l33: Complex
};

pub fn liouvillian_supermatrix_qubit_decay(omega: Float, gamma: Float) -> SuperMatrix4x4 {
    let half_gamma: Float = 0.5 * gamma;
    return SuperMatrix4x4 {
        l00: sv_c_new(0.0, 0.0),
        l03: sv_c_new(gamma, 0.0),
        l11: sv_c_new(0.0 - half_gamma, omega),
        l22: sv_c_new(0.0 - half_gamma, 0.0 - omega),
        l30: sv_c_new(0.0, 0.0),
        l33: sv_c_new(0.0 - gamma, 0.0)
    };
}

pub fn supermatrix_apply_vector(l: SuperMatrix4x4, v: Vector4Complex) -> Vector4Complex {
    let out0: Complex = sv_c_add(sv_c_mul(l.l00, v.v0), sv_c_mul(l.l03, v.v3));
    let out1: Complex = sv_c_mul(l.l11, v.v1);
    let out2: Complex = sv_c_mul(l.l22, v.v2);
    let out3: Complex = sv_c_add(sv_c_mul(l.l30, v.v0), sv_c_mul(l.l33, v.v3));
    return Vector4Complex { v0: out0, v1: out1, v2: out2, v3: out3 };
}
