// # Gaussian Open Quantum State Dissipation & Covariance Flow
//
// Logline: Integrates deterministic drift and diffusion for single-mode Gaussian states with symplectic invariants and purity mu = 1 / (2 sqrt(det sigma)).
//
// Setup: Continuous-variable Gaussian state dynamics under lossy beam splitter channels and thermal noise injection.
//
// Beats:
//   1. Construct Gaussian state 2x2 covariance matrix and displacement vector.
//   2. Compute Gaussian state purity mu = 1 / (2 sqrt(det sigma)) and symplectic eigenvalue nu.
//   3. Apply thermal attenuator channel sigma' = eta sigma + (1 - eta) (n_th + 0.5) I.

pub type GaussianState1Mode = struct {
    mean_x: Float,
    mean_p: Float,
    var_x: Float,
    var_p: Float,
    cov_xp: Float,
};

pub fn gaussian_state_vacuum() -> GaussianState1Mode {
    return GaussianState1Mode {
        mean_x: 0.0,
        mean_p: 0.0,
        var_x: 0.5,
        var_p: 0.5,
        cov_xp: 0.0,
    };
}

pub fn gaussian_purity_eval(state: GaussianState1Mode) -> Float {
    let vx: Float = state.var_x;
    let vp: Float = state.var_p;
    let cxp: Float = state.cov_xp;
    let det_sigma: Float = (vx * vp) - (cxp * cxp);
    if det_sigma <= 0.0 {
        return 0.0;
    }
    return 1.0 / (2.0 * sqrt(det_sigma));
}

pub fn gaussian_thermal_attenuator_step(state: GaussianState1Mode, transmissivity_eta: Float, n_th: Float) -> GaussianState1Mode {
    let mx: Float = state.mean_x;
    let mp: Float = state.mean_p;
    let vx: Float = state.var_x;
    let vp: Float = state.var_p;
    let cxp: Float = state.cov_xp;

    let sqrt_eta: Float = sqrt(transmissivity_eta);
    let thermal_term: Float = (1.0 - transmissivity_eta) * (n_th + 0.5);

    let next_mx: Float = sqrt_eta * mx;
    let next_mp: Float = sqrt_eta * mp;

    let next_vx: Float = (transmissivity_eta * vx) + thermal_term;
    let next_vp: Float = (transmissivity_eta * vp) + thermal_term;
    let next_cxp: Float = transmissivity_eta * cxp;

    return GaussianState1Mode {
        mean_x: next_mx,
        mean_p: next_mp,
        var_x: next_vx,
        var_p: next_vp,
        cov_xp: next_cxp,
    };
}
