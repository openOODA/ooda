// # Finite-Time Quantum Carnot Engine & Curzon-Ahlborn Benchmark
//
// Logline: Computes maximum power efficiency eta_CA = 1 - sqrt(T_c / T_h) and trade-offs between irreversible dissipation and finite cycle duration.
//
// Setup: Finite-time quantum thermodynamics optimizing power output against dissipative entropy generation.
//
// Beats:
//   1. Compute ideal reversible Carnot efficiency eta_Carnot = 1 - T_c / T_h.
//   2. Compute Curzon-Ahlborn maximum power efficiency eta_CA = 1 - sqrt(T_c / T_h).
//   3. Evaluate finite-time power-efficiency curve with dissipative coefficient Sigma.

pub type CarnotBenchmarkParams = struct {
    temp_cold_k: Float,
    temp_hot_k: Float,
    dissipative_constant: Float,
};

pub fn carnot_params_new(tc: Float, th: Float, sigma: Float) -> CarnotBenchmarkParams {
    return CarnotBenchmarkParams {
        temp_cold_k: tc,
        temp_hot_k: th,
        dissipative_constant: sigma,
    };
}

pub fn carnot_efficiency_ideal(p: CarnotBenchmarkParams) -> Float {
    let tc: Float = p.temp_cold_k;
    let th: Float = p.temp_hot_k;
    if th <= 0.0 {
        return 0.0;
    }
    return 1.0 - (tc / th);
}

pub fn curzon_ahlborn_efficiency(p: CarnotBenchmarkParams) -> Float {
    let tc: Float = p.temp_cold_k;
    let th: Float = p.temp_hot_k;
    if th <= 0.0 {
        return 0.0;
    }
    let ratio: Float = tc / th;
    return 1.0 - sqrt(ratio);
}

pub fn finite_time_power_output(p: CarnotBenchmarkParams, cycle_duration_tau: Float) -> Float {
    if cycle_duration_tau <= 0.0001 {
        return 0.0;
    }
    let tc: Float = p.temp_cold_k;
    let th: Float = p.temp_hot_k;
    let sigma: Float = p.dissipative_constant;

    let delta_t: Float = th - tc;
    let reversible_work: Float = delta_t;
    let lost_work: Float = sigma / cycle_duration_tau;

    let net_work: Float = reversible_work - lost_work;
    if net_work < 0.0 {
        return 0.0;
    }
    return net_work / cycle_duration_tau;
}
