// # Thermal Equilibrium Bath Correlation Functions & Fluctuation-Dissipation
//
// Logline: Evaluates complex-valued bath correlation functions C(t) = <B(t)B(0)> obeying quantum detailed balance and KMS conditions.
//
// Setup: Fluctuation-dissipation theorem mapping spectral density J(omega) and thermal bath temperature T to time-domain noise correlations.
//
// Beats:
//   1. Compute real (symmetric noise) and imaginary (dissipative response) correlation components.
//   2. Evaluate thermal bath correlation decay timescales tau_bath ~ hbar / (pi k_B T).
//   3. Verify Kubo-Martin-Schwinger (KMS) quantum detailed balance condition.

pub type Complex = struct {
    real: Float,
    imag: Float
};

pub type BathCorrelationParams = struct {
    temperature_k: Float,
    coupling_alpha: Float,
    cutoff_wc: Float
};

pub fn bath_correlation_params_new(temp_k: Float, alpha: Float, wc: Float) -> BathCorrelationParams {
    return BathCorrelationParams {
        temperature_k: temp_k,
        coupling_alpha: alpha,
        cutoff_wc: wc
    };
}

pub fn bath_thermal_correlation_time(temp_k: Float) -> Float {
    if temp_k <= 0.001 {
        return 1000.0;
    }
    let k_b: Float = 0.1309;
    return 1.0 / (3.14159265 * k_b * temp_k);
}

pub fn bath_correlation_ohmic_approx(p: BathCorrelationParams, t: Float) -> Complex {
    let tau_th: Float = bath_thermal_correlation_time(p.temperature_k);
    let mut abs_t: Float = t;
    if t < 0.0 { abs_t = 0.0 - t; }
    let decay: Float = exp(0.0 - (abs_t / tau_th));

    let wc: Float = p.cutoff_wc;
    let denom: Float = 1.0 + (wc * wc * t * t);
    let alpha: Float = p.coupling_alpha;

    let real_part: Float = (alpha * wc * decay) / denom;
    let imag_part: Float = (0.0 - (alpha * wc * wc * t)) / (denom * denom);

    return Complex { real: real_part, imag: imag_part };
}
