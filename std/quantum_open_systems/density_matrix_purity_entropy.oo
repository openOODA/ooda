// # Density Matrix Purity, Von Neumann Entropy & Mixedness Metrics
//
// Logline: Evaluates trace invariants, purity Tr(rho^2), von Neumann entropy S(rho), linear entropy S_L, and Bloch radius mixedness.
//
// Setup: Statistical quantum state diagnostics for density operators and mixedness characterization.
//
// Beats:
//   1. Define 2x2 density matrices and compute Tr(rho^2) purity.
//   2. Calculate linear entropy S_L = 1 - Tr(rho^2) and Bloch radius r = sqrt(x^2 + y^2 + z^2).
//   3. Compute von Neumann entropy S = -lambda_+ ln(lambda_+) - lambda_- ln(lambda_-) from eigenvalues.

pub type Complex = struct {
    real: Float,
    imag: Float
};

pub type StateEntropyMetrics = struct {
    purity: Float,
    linear_entropy: Float,
    von_neumann_entropy: Float,
    bloch_radius: Float,
    is_pure: Int
};

pub fn density_purity_eval(r00_r: Float, r01_r: Float, r01_i: Float, r11_r: Float) -> Float {
    let off_diag_sq: Float = (r01_r * r01_r) + (r01_i * r01_i);
    return (r00_r * r00_r) + (r11_r * r11_r) + (2.0 * off_diag_sq);
}

pub fn density_linear_entropy_eval(purity: Float) -> Float {
    let val: Float = 2.0 * (1.0 - purity);
    if val < 0.0 {
        return 0.0;
    }
    return val;
}

pub fn density_bloch_radius(r00_r: Float, r01_r: Float, r01_i: Float, r11_r: Float) -> Float {
    let rx: Float = 2.0 * r01_r;
    let ry: Float = 0.0 - (2.0 * r01_i);
    let rz: Float = r00_r - r11_r;
    let r_sq: Float = (rx * rx) + (ry * ry) + (rz * rz);
    return sqrt(r_sq);
}

pub fn density_eigenvalues_2x2(r00_r: Float, r01_r: Float, r01_i: Float, r11_r: Float) -> Complex {
    let trace: Float = r00_r + r11_r;
    let det: Float = (r00_r * r11_r) - ((r01_r * r01_r) + (r01_i * r01_i));
    let disc: Float = (trace * trace) - (4.0 * det);
    let mut root_disc: Float = 0.0;
    if disc > 0.0 {
        root_disc = sqrt(disc);
    }
    let l_plus: Float = (trace + root_disc) * 0.5;
    let l_minus: Float = (trace - root_disc) * 0.5;
    return Complex { real: l_plus, imag: l_minus };
}

pub fn density_von_neumann_entropy(l_plus: Float, l_minus: Float) -> Float {
    let mut s: Float = 0.0;
    if l_plus > 0.000001 {
        s = s - (l_plus * ln(l_plus));
    }
    if l_minus > 0.000001 {
        s = s - (l_minus * ln(l_minus));
    }
    return s;
}

pub fn density_entropy_metrics_compute(r00_r: Float, r01_r: Float, r01_i: Float, r11_r: Float) -> StateEntropyMetrics {
    let purity: Float = density_purity_eval(r00_r, r01_r, r01_i, r11_r);
    let s_lin: Float = density_linear_entropy_eval(purity);
    let r: Float = density_bloch_radius(r00_r, r01_r, r01_i, r11_r);
    let eigs: Complex = density_eigenvalues_2x2(r00_r, r01_r, r01_i, r11_r);
    let s_vn: Float = density_von_neumann_entropy(eigs.real, eigs.imag);

    let mut is_pure: Int = 0;
    if purity > 0.999 {
        is_pure = 1;
    }

    return StateEntropyMetrics {
        purity: purity,
        linear_entropy: s_lin,
        von_neumann_entropy: s_vn,
        bloch_radius: r,
        is_pure: is_pure
    };
}
