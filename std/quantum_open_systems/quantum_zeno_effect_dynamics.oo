// # Quantum Zeno & Anti-Zeno Dynamical Crossover
//
// Logline: Analyzes the suppression (Zeno) or acceleration (anti-Zeno) of decay transitions under periodic projective measurements with interval tau.
//
// Setup: High-frequency projective measurement monitoring of unstable quantum systems coupled to structured reservoirs.
//
// Beats:
//   1. Define Zeno measurement parameters (measurement interval tau, bare decay rate gamma_0, bath cutoff wc).
//   2. Compute effective decay rate Gamma(tau) = 2 pi int d omega J(omega) F(omega, tau).
//   3. Classify Zeno suppression vs Anti-Zeno enhancement regimes relative to the crossover timescale tau_c.

pub type ZenoMeasurementParams = struct {
    measurement_interval_tau_ns: Float,
    bare_decay_gamma0: Float,
    bath_cutoff_wc_ghz: Float
};

pub fn zeno_params_new(tau_ns: Float, gamma0: Float, wc: Float) -> ZenoMeasurementParams {
    return ZenoMeasurementParams {
        measurement_interval_tau_ns: tau_ns,
        bare_decay_gamma0: gamma0,
        bath_cutoff_wc_ghz: wc
    };
}

pub fn zeno_measurement_filter(omega: Float, tau: Float) -> Float {
    let arg: Float = 0.5 * omega * tau;
    if arg == 0.0 {
        return 1.0;
    }
    let s: Float = sin(arg);
    let sinc: Float = s / arg;
    return sinc * sinc;
}

pub fn zeno_effective_decay_rate(p: ZenoMeasurementParams) -> Float {
    let tau: Float = p.measurement_interval_tau_ns;
    let gamma0: Float = p.bare_decay_gamma0;
    let wc: Float = p.bath_cutoff_wc_ghz;

    // For short tau: Gamma(tau) ~ gamma0 * (tau * wc / pi) -> 0 as tau -> 0 (Zeno suppression)
    let product: Float = (tau * wc) / 3.14159265;
    if product < 1.0 {
        return gamma0 * product;
    }
    // Anti-Zeno or saturation regime
    return gamma0;
}

pub fn zeno_survival_probability(p: ZenoMeasurementParams, total_time_ns: Float) -> Float {
    let rate: Float = zeno_effective_decay_rate(p);
    return exp(0.0 - (rate * total_time_ns));
}
