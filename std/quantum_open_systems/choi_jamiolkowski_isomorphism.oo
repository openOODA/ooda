// # Choi-Jamiolkowski Isomorphism & Channel Matrix Positivity
//
// Logline: Maps CPTP superoperators to bipartite Choi density matrices rho_J and verifies complete positivity via Choi matrix eigenvalues.
//
// Setup: Duality between quantum channels and bipartite states on Hilbert space H_A (x) H_B.
//
// Beats:
//   1. Construct 4x4 Choi matrix representation for quantum channels.
//   2. Compute trace of Choi state and verify trace-preservation condition Tr_B(rho_J) = I/d.
//   3. Estimate Choi matrix spectral positivity for complete positivity certification.

pub type Complex = struct {
    real: Float,
    imag: Float,
};

pub type ChoiMatrix4x4 = struct {
    diag0: Float,
    diag1: Float,
    diag2: Float,
    diag3: Float,
    cross_real: Float,
    cross_imag: Float,
};

pub fn choi_depolarizing_channel(p: Float) -> ChoiMatrix4x4 {
    let one_minus_p: Float = 1.0 - p;
    let p_over_4: Float = p * 0.25;

    let d0: Float = (0.5 * one_minus_p) + p_over_4;
    let d1: Float = p_over_4;
    let d2: Float = p_over_4;
    let d3: Float = (0.5 * one_minus_p) + p_over_4;

    let cross: Float = 0.5 * one_minus_p;
    return ChoiMatrix4x4 {
        diag0: d0,
        diag1: d1,
        diag2: d2,
        diag3: d3,
        cross_real: cross,
        cross_imag: 0.0,
    };
}

pub fn choi_matrix_trace(c: ChoiMatrix4x4) -> Float {
    let d0: Float = c.diag0;
    let d1: Float = c.diag1;
    let d2: Float = c.diag2;
    let d3: Float = c.diag3;
    return d0 + d1 + d2 + d3;
}

pub fn choi_is_completely_positive(c: ChoiMatrix4x4) -> Int {
    let d0: Float = c.diag0;
    let d1: Float = c.diag1;
    let d2: Float = c.diag2;
    let d3: Float = c.diag3;
    let cr: Float = c.cross_real;
    let ci: Float = c.cross_imag;

    if d0 < 0.0 { return 0; }
    if d1 < 0.0 { return 0; }
    if d2 < 0.0 { return 0; }
    if d3 < 0.0 { return 0; }

    let det_sub: Float = (d0 * d3) - ((cr * cr) + (ci * ci));
    if det_sub < (0.0 - 0.0001) {
        return 0;
    }
    return 1;
}

pub fn choi_is_trace_preserving(c: ChoiMatrix4x4) -> Int {
    let d0: Float = c.diag0;
    let d1: Float = c.diag1;
    let d2: Float = c.diag2;
    let d3: Float = c.diag3;

    let tr_a0: Float = d0 + d1;
    let tr_a1: Float = d2 + d3;
    let mut diff0: Float = tr_a0 - 0.5;
    let mut diff1: Float = tr_a1 - 0.5;
    if diff0 < 0.0 { diff0 = 0.0 - diff0; }
    if diff1 < 0.0 { diff1 = 0.0 - diff1; }
    if diff0 < 0.01 && diff1 < 0.01 {
        return 1;
    }
    return 0;
}
