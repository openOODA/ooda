// # Cavity Optomechanics: Radiation Pressure & Dynamical Backaction
//
// Logline: Models coupled optical and mechanical resonators, computing the radiation pressure dynamical backaction, optical spring shift, and cooling rate.
//
// Setup: Parametric optomechanical interaction H_int = - hbar g_0 a^\dagger a (b + b^\dagger) with red-detuned optical drive.
//
// Beats:
//   1. Construct optomechanical parameters (optical cavity loss kappa, mechanical frequency omega_m, coupling g_0).
//   2. Compute dynamical backaction damping rate Gamma_opt(Delta) and optical spring frequency shift delta omega_m.
//   3. Evaluate steady-state effective mechanical temperature and phonon occupancy.

pub type OptomechanicalParams = struct {
    cavity_decay_kappa: Float,
    mech_frequency_omega_m: Float,
    vacuum_optomech_g0: Float,
    intracavity_photons: Float,
    laser_detuning_delta: Float,
};

pub fn optomechanical_params_new(kappa: Float, wm: Float, g0: Float, nc: Float, delta: Float) -> OptomechanicalParams {
    return OptomechanicalParams {
        cavity_decay_kappa: kappa,
        mech_frequency_omega_m: wm,
        vacuum_optomech_g0: g0,
        intracavity_photons: nc,
        laser_detuning_delta: delta,
    };
}

pub fn optomechanical_radiation_pressure_damping(p: OptomechanicalParams) -> Float {
    let kappa: Float = p.cavity_decay_kappa;
    let wm: Float = p.mech_frequency_omega_m;
    let g0: Float = p.vacuum_optomech_g0;
    let nc: Float = p.intracavity_photons;
    let delta: Float = p.laser_detuning_delta;

    let g_eff_sq: Float = g0 * g0 * nc;
    let half_k: Float = 0.5 * kappa;
    let half_k_sq: Float = half_k * half_k;

    // Lorentzian response at Delta + omega_m and Delta - omega_m
    let d_plus: Float = delta + wm;
    let d_minus: Float = delta - wm;

    let l_plus: Float = kappa / ((d_plus * d_plus) + half_k_sq);
    let l_minus: Float = kappa / ((d_minus * d_minus) + half_k_sq);

    return g_eff_sq * (l_plus - l_minus);
}

pub fn optomechanical_optical_spring_shift(p: OptomechanicalParams) -> Float {
    let kappa: Float = p.cavity_decay_kappa;
    let wm: Float = p.mech_frequency_omega_m;
    let g0: Float = p.vacuum_optomech_g0;
    let nc: Float = p.intracavity_photons;
    let delta: Float = p.laser_detuning_delta;

    let g_eff_sq: Float = g0 * g0 * nc;
    let half_k_sq: Float = 0.25 * kappa * kappa;

    let d_plus: Float = delta + wm;
    let d_minus: Float = delta - wm;

    let num_plus: Float = d_plus / ((d_plus * d_plus) + half_k_sq);
    let num_minus: Float = d_minus / ((d_minus * d_minus) + half_k_sq);

    return g_eff_sq * (num_plus + num_minus);
}
