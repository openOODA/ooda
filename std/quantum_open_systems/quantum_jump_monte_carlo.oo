// # Monte Carlo Wavefunction (MCWF) Quantum Jump Trajectory Engine
//
// Logline: Simulates stochastic quantum jump trajectories using non-Hermitian effective Hamiltonian evolution and deterministic jump branching.
//
// Setup: Stochastic wavefunction unravelling for open quantum systems subject to continuous measurement and discrete collapse events.
//
// Beats:
//   1. Define 2-level complex statevector amplitudes and norm evaluation.
//   2. Propagate under effective non-Hermitian Hamiltonian H_eff = H - (i/2) sum gamma_k L_k^dagger L_k.
//   3. Compute jump probability dp = 1 - ||psi||^2 and apply state re-normalization or jump reset.

pub type Complex = struct {
    real: Float,
    imag: Float
};

pub fn mcwf_c_new(r: Float, i: Float) -> Complex {
    return Complex { real: r, imag: i };
}

pub fn mcwf_c_add(a: Complex, b: Complex) -> Complex {
    return Complex { real: a.real + b.real, imag: a.imag + b.imag };
}

pub fn mcwf_c_scale(a: Complex, s: Float) -> Complex {
    return Complex { real: a.real * s, imag: a.imag * s };
}

pub type McwfQubitState = struct {
    c0: Complex,
    c1: Complex
};

pub fn mcwf_qubit_new(c0: Complex, c1: Complex) -> McwfQubitState {
    return McwfQubitState { c0: c0, c1: c1 };
}

pub fn mcwf_qubit_norm_sq(psi: McwfQubitState) -> Float {
    let c0: Complex = psi.c0;
    let c1: Complex = psi.c1;
    let n0: Float = (c0.real * c0.real) + (c0.imag * c0.imag);
    let n1: Float = (c1.real * c1.real) + (c1.imag * c1.imag);
    return n0 + n1;
}

pub fn mcwf_qubit_normalize(psi: McwfQubitState) -> McwfQubitState {
    let norm: Float = sqrt(mcwf_qubit_norm_sq(psi));
    if norm < 0.0000001 {
        return McwfQubitState {
            c0: mcwf_c_new(1.0, 0.0),
            c1: mcwf_c_new(0.0, 0.0)
        };
    }
    let inv_norm: Float = 1.0 / norm;
    let c0: Complex = psi.c0;
    let c1: Complex = psi.c1;
    return McwfQubitState {
        c0: mcwf_c_scale(c0, inv_norm),
        c1: mcwf_c_scale(c1, inv_norm)
    };
}

pub type McwfTrajectoryStepResult = struct {
    state: McwfQubitState,
    jump_occurred: Int,
    jump_prob: Float
};

pub fn mcwf_effective_step(psi: McwfQubitState, omega_rabi: Float, gamma_down: Float, dt: Float, random_sample: Float) -> McwfTrajectoryStepResult {
    let c0: Complex = psi.c0;
    let c1: Complex = psi.c1;
    let c0_r: Float = c0.real;
    let c0_i: Float = c0.imag;
    let c1_r: Float = c1.real;
    let c1_i: Float = c1.imag;

    let dc0_real: Float = 0.5 * omega_rabi * c1_i;
    let dc0_imag: Float = 0.0 - (0.5 * omega_rabi * c1_r);
    
    let dc1_real: Float = (0.5 * omega_rabi * c0_i) - (0.5 * gamma_down * c1_r);
    let dc1_imag: Float = (0.0 - (0.5 * omega_rabi * c0_r)) - (0.5 * gamma_down * c1_i);

    let new_c0: Complex = mcwf_c_add(c0, mcwf_c_scale(mcwf_c_new(dc0_real, dc0_imag), dt));
    let new_c1: Complex = mcwf_c_add(c1, mcwf_c_scale(mcwf_c_new(dc1_real, dc1_imag), dt));

    let unnorm_state: McwfQubitState = McwfQubitState { c0: new_c0, c1: new_c1 };
    let norm_sq: Float = mcwf_qubit_norm_sq(unnorm_state);
    let jump_prob: Float = 1.0 - norm_sq;

    if random_sample < jump_prob {
        let collapsed: McwfQubitState = McwfQubitState {
            c0: mcwf_c_new(1.0, 0.0),
            c1: mcwf_c_new(0.0, 0.0)
        };
        return McwfTrajectoryStepResult {
            state: collapsed,
            jump_occurred: 1,
            jump_prob: jump_prob
        };
    }

    let renorm_state: McwfQubitState = mcwf_qubit_normalize(unnorm_state);
    return McwfTrajectoryStepResult {
        state: renorm_state,
        jump_occurred: 0,
        jump_prob: jump_prob
    };
}
