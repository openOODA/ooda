// # Effective Non-Hermitian Hamiltonian & Bound States in Continuum
//
// Logline: Constructs H_eff = H - (i/2) sum gamma_k L_k^dagger L_k, evaluates complex energy spectra, decay widths, and bound states in the continuum.
//
// Setup: Feshbach projection partitioning the Hilbert space into discrete bound states and decay continuum channels.
//
// Beats:
//   1. Build 2x2 effective non-Hermitian Hamiltonian with coherent detuning and anti-Hermitian decay rates.
//   2. Compute complex eigenvalue decay rates Gamma_eff = -2 Im(E).
//   3. Detect Bound States in the Continuum (BIC) with zero imaginary resonance width.

pub type Complex = struct {
    real: Float,
    imag: Float,
};

pub type NonHermitianHam2x2 = struct {
    h00: Complex,
    h01: Complex,
    h10: Complex,
    h11: Complex,
};

pub fn non_hermitian_ham_decay_model(delta: Float, coupling_v: Float, gamma_decay: Float) -> NonHermitianHam2x2 {
    let half_delta: Float = 0.5 * delta;
    let half_gamma: Float = 0.5 * gamma_decay;

    return NonHermitianHam2x2 {
        h00: Complex { real: half_delta, imag: 0.0 },
        h01: Complex { real: coupling_v, imag: 0.0 },
        h10: Complex { real: coupling_v, imag: 0.0 },
        h11: Complex { real: 0.0 - half_delta, imag: 0.0 - half_gamma },
    };
}

pub type ComplexEigenpair2 = struct {
    e_plus: Complex,
    e_minus: Complex,
};

pub fn non_hermitian_trace(h: NonHermitianHam2x2) -> Complex {
    let h00: Complex = h.h00;
    let h11: Complex = h.h11;
    let r00: Float = h00.real;
    let r11: Float = h11.real;
    let i00: Float = h00.imag;
    let i11: Float = h11.imag;
    let tr_r: Float = r00 + r11;
    let tr_i: Float = i00 + i11;
    return Complex { real: tr_r, imag: tr_i };
}

pub fn non_hermitian_decay_rate_plus(e: Complex) -> Float {
    let ei: Float = e.imag;
    return 0.0 - (2.0 * ei);
}
