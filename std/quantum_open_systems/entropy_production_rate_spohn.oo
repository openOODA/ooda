// # Spohn Inequality & Irreversible Entropy Production Rate
//
// Logline: Computes non-negative irreversible entropy production sigma = -Tr((L rho)(ln rho - ln rho_ss)) >= 0 in open quantum systems.
//
// Setup: Second law of quantum thermodynamics and Spohn inequality for Markovian quantum master equations.
//
// Beats:
//   1. Construct 2-level instantaneous and steady-state population distributions.
//   2. Compute quantum relative entropy S(rho || rho_ss) = Tr(rho(ln rho - ln rho_ss)).
//   3. Evaluate non-negative entropy production rate sigma >= 0.

pub type SpohnEntropyMetrics = struct {
    relative_entropy: Float,
    entropy_production_rate: Float,
    heat_dissipation_rate: Float,
    is_second_law_satisfied: Int
};

pub fn spohn_relative_entropy_2level(p0: Float, p1: Float, p0_ss: Float, p1_ss: Float) -> Float {
    let mut rel_ent: Float = 0.0;
    if p0 > 0.000001 && p0_ss > 0.000001 {
        rel_ent = rel_ent + (p0 * ln(p0 / p0_ss));
    }
    if p1 > 0.000001 && p1_ss > 0.000001 {
        rel_ent = rel_ent + (p1 * ln(p1 / p1_ss));
    }
    return rel_ent;
}

pub fn spohn_entropy_production_rate(
    p0: Float,
    p1: Float,
    p0_ss: Float,
    p1_ss: Float,
    dp0_dt: Float,
    dp1_dt: Float
) -> Float {
    // sigma = - [ dp0/dt * ln(p0/p0_ss) + dp1/dt * ln(p1/p1_ss) ]
    let mut rate: Float = 0.0;
    if p0 > 0.000001 && p0_ss > 0.000001 {
        rate = rate - (dp0_dt * ln(p0 / p0_ss));
    }
    if p1 > 0.000001 && p1_ss > 0.000001 {
        rate = rate - (dp1_dt * ln(p1 / p1_ss));
    }
    return rate;
}

pub fn spohn_diagnose(
    p0: Float,
    p1: Float,
    p0_ss: Float,
    p1_ss: Float,
    dp0_dt: Float,
    dp1_dt: Float
) -> SpohnEntropyMetrics {
    let rel_ent: Float = spohn_relative_entropy_2level(p0, p1, p0_ss, p1_ss);
    let sigma: Float = spohn_entropy_production_rate(p0, p1, p0_ss, p1_ss, dp0_dt, dp1_dt);

    let mut satisfied: Int = 0;
    if sigma >= (0.0 - 0.0001) {
        satisfied = 1;
    }

    return SpohnEntropyMetrics {
        relative_entropy: rel_ent,
        entropy_production_rate: sigma,
        heat_dissipation_rate: 0.0,
        is_second_law_satisfied: satisfied
    };
}
