// # Continuous Algebraic Lyapunov Equation for Open Linear Systems
//
// Logline: Solves the continuous Lyapunov equation A sigma + sigma A^T + D = 0 to extract steady-state quantum covariance matrices of Gaussian open systems.
//
// Setup: Symplectic covariance matrix solver for linear quantum Brownian motion and optomechanical Langevin equations.
//
// Beats:
//   1. Construct 2x2 drift matrix A and diffusion matrix D.
//   2. Compute algebraic solution for stationary 2x2 covariance matrix sigma_ss.
//   3. Verify Robertson-Schrödinger quantum uncertainty relation sigma + i Omega / 2 >= 0.

pub type Matrix2x2Real = struct {
    m00: Float,
    m01: Float,
    m10: Float,
    m11: Float,
};

pub fn matrix2x2_real_new(m00: Float, m01: Float, m10: Float, m11: Float) -> Matrix2x2Real {
    return Matrix2x2Real { m00: m00, m01: m01, m10: m10, m11: m11 };
}

pub fn lyapunov_solve_2x2_diagonal(drift_gamma: Float, diffusion_d: Float) -> Matrix2x2Real {
    // For decoupled isotropic damping: A = -gamma I, D = 2 d I
    // -2 gamma sigma + 2 d = 0 => sigma = d / gamma
    let s_diag: Float = diffusion_d / drift_gamma;
    return Matrix2x2Real {
        m00: s_diag,
        m01: 0.0,
        m10: 0.0,
        m11: s_diag,
    };
}

pub fn lyapunov_uncertainty_satisfied(sigma: Matrix2x2Real) -> Int {
    let s00: Float = sigma.m00;
    let s01: Float = sigma.m01;
    let s10: Float = sigma.m10;
    let s11: Float = sigma.m11;

    let det: Float = (s00 * s11) - (s01 * s10);
    // Heisenberg-Robertson relation for hbar = 1: det(sigma) >= 1 / 4
    if det >= 0.2499 {
        return 1;
    }
    return 0;
}
