// # Continuous Quantum Homodyne Measurement & Photocurrent Records
//
// Logline: Models balanced homodyne detection of output field quadratures X_theta, continuous measurement backaction, and noisy photocurrent demodulation.
//
// Setup: Continuous monitoring of optical cavity output fields mixed with a strong local oscillator at phase theta.
//
// Beats:
//   1. Construct homodyne detector configuration (efficiency eta, local oscillator phase theta, filter bandwidth).
//   2. Generate continuous photocurrent record I(t) dt = sqrt(eta kappa) <X_theta> dt + dW.
//   3. Compute signal-to-noise ratio (SNR) for continuous homodyne state readout.

pub type HomodyneDetectorConfig = struct {
    quantum_efficiency_eta: Float,
    lo_phase_theta: Float,
    measurement_rate: Float
};

pub fn homodyne_detector_new(eta: Float, theta: Float, rate: Float) -> HomodyneDetectorConfig {
    return HomodyneDetectorConfig {
        quantum_efficiency_eta: eta,
        lo_phase_theta: theta,
        measurement_rate: rate
    };
}

pub type HomodyneSample = struct {
    photocurrent_current: Float,
    signal_component: Float,
    noise_component: Float
};

pub fn homodyne_sample_generate(
    cfg: HomodyneDetectorConfig,
    quadrature_expectation: Float,
    gaussian_noise: Float,
    dt: Float
) -> HomodyneSample {
    let eta: Float = cfg.quantum_efficiency_eta;
    let gamma: Float = cfg.measurement_rate;
    let sqrt_eta_gamma: Float = sqrt(eta * gamma);
    let sqrt_dt: Float = sqrt(dt);

    let sig: Float = sqrt_eta_gamma * quadrature_expectation;
    let noise: Float = gaussian_noise / sqrt_dt;
    let current: Float = sig + noise;

    return HomodyneSample {
        photocurrent_current: current,
        signal_component: sig,
        noise_component: noise
    };
}

pub fn homodyne_signal_to_noise_ratio(cfg: HomodyneDetectorConfig, quad_exp: Float, total_time: Float) -> Float {
    let eta: Float = cfg.quantum_efficiency_eta;
    let gamma: Float = cfg.measurement_rate;
    let signal_power: Float = 4.0 * eta * gamma * quad_exp * quad_exp * total_time;
    return signal_power;
}
