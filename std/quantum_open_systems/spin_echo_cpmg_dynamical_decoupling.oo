// # Hahn Echo & CPMG Dynamical Decoupling Sequences
//
// Logline: Simulates Carr-Purcell-Meiboom-Gill (CPMG) multi-pulse pi-sequences to cancel low-frequency 1/f noise and extend qubit coherence.
//
// Setup: Periodic dynamical decoupling pulse schedules for open quantum systems in colored bath noise.
//
// Beats:
//   1. Construct CPMG sequence parameterization (total duration T, number of pulses N).
//   2. Calculate pulse timing schedule t_k = (k - 0.5) * T / N for k = 1..N.
//   3. Compute CPMG noise filter function F(omega * T) and coherence retention factor.

pub type CpmgSequence = struct {
    total_time_us: Float,
    num_pulses: Int,
    inter_pulse_spacing_us: Float
};

pub fn cpmg_sequence_new(total_t: Float, n: Int) -> CpmgSequence {
    let n_f: Float = (n as Float);
    let spacing: Float = total_t / n_f;
    return CpmgSequence {
        total_time_us: total_t,
        num_pulses: n,
        inter_pulse_spacing_us: spacing
    };
}

pub fn cpmg_pulse_time(seq: CpmgSequence, pulse_index: Int) -> Float {
    let idx_f: Float = (pulse_index as Float);
    let spacing: Float = seq.inter_pulse_spacing_us;
    return (idx_f - 0.5) * spacing;
}

pub fn cpmg_filter_peak_frequency(seq: CpmgSequence) -> Float {
    let tau: Float = seq.inter_pulse_spacing_us;
    if tau <= 0.0 {
        return 0.0;
    }
    return 3.14159265 / tau;
}

pub fn cpmg_extended_coherence_factor(base_t2: Float, num_pulses: Int) -> Float {
    let n_f: Float = (num_pulses as Float);
    let factor: Float = sqrt(n_f);
    return base_t2 * factor;
}
