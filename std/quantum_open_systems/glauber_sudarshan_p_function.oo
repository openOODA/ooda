// # Glauber-Sudarshan P-Representation & Non-Classicality Metrics
//
// Logline: Analyzes the Glauber-Sudarshan P(alpha) distribution, detecting non-classicality via negative values and higher-order moments.
//
// Setup: Diagonal coherent state expansion rho = int P(alpha) |alpha><alpha| d^2 alpha with Mandel Q parameter evaluation.
//
// Beats:
//   1. Construct photon number statistics moments <n> and <n^2>.
//   2. Compute Mandel Q parameter Q = (<(Delta n)^2> - <n>) / <n>.
//   3. Classify sub-Poissonian non-classical light (Q < 0) vs super-Poissonian thermal light (Q > 0).

pub type PhotonStatistics = struct {
    mean_photon_number: Float,
    var_photon_number: Float,
    second_order_coherence_g2: Float,
    mandel_q_parameter: Float,
    is_non_classical: Int,
};

pub fn mandel_q_eval(mean_n: Float, var_n: Float) -> Float {
    if mean_n <= 0.0000001 {
        return 0.0;
    }
    return (var_n - mean_n) / mean_n;
}

pub fn second_order_coherence_g2_eval(mean_n: Float, var_n: Float) -> Float {
    if mean_n <= 0.0000001 {
        return 1.0;
    }
    let n_sq: Float = mean_n * mean_n;
    return 1.0 + ((var_n - mean_n) / n_sq);
}

pub fn photon_statistics_diagnose(mean_n: Float, var_n: Float) -> PhotonStatistics {
    let q: Float = mandel_q_eval(mean_n, var_n);
    let g2: Float = second_order_coherence_g2_eval(mean_n, var_n);
    let mut non_classical: Int = 0;
    if q < (0.0 - 0.0001) {
        non_classical = 1;
    }

    return PhotonStatistics {
        mean_photon_number: mean_n,
        var_photon_number: var_n,
        second_order_coherence_g2: g2,
        mandel_q_parameter: q,
        is_non_classical: non_classical,
    };
}
