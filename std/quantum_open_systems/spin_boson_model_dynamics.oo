// # Spin-Boson Model & Two-Level Bath Dynamics
//
// Logline: Models a dissipative two-level system coupled to a continuum of bosonic modes with tunneling splitting Delta and bias epsilon.
//
// Setup: Prototypical Hamiltonian H = (Delta / 2) sigma_x + (epsilon / 2) sigma_z + (sigma_z / 2) sum g_k (b_k + b_k^dagger).
//
// Beats:
//   1. Construct Spin-Boson model parameters (tunneling Delta, bias epsilon, Kondo alpha).
//   2. Compute renormalized tunneling amplitude Delta_r = Delta (Delta / omega_c)^{alpha / (1 - alpha)}.
//   3. Classify coherent oscillation vs incoherent relaxation regimes across the alpha = 1 / 2 crossover.

pub type SpinBosonParams = struct {
    tunneling_delta: Float,
    energy_bias_eps: Float,
    kondo_alpha: Float,
    cutoff_wc: Float,
};

pub fn spin_boson_params_new(delta: Float, eps: Float, alpha: Float, wc: Float) -> SpinBosonParams {
    return SpinBosonParams {
        tunneling_delta: delta,
        energy_bias_eps: eps,
        kondo_alpha: alpha,
        cutoff_wc: wc,
    };
}

pub fn spin_boson_renormalized_tunneling(p: SpinBosonParams) -> Float {
    let delta: Float = p.tunneling_delta;
    let alpha: Float = p.kondo_alpha;
    let wc: Float = p.cutoff_wc;

    if alpha >= 1.0 {
        return 0.0;
    }
    let ratio: Float = delta / wc;
    if ratio <= 0.0 {
        return 0.0;
    }
    let exponent: Float = alpha / (1.0 - alpha);
    let log_val: Float = ln(ratio);
    let power: Float = exp(exponent * log_val);
    return delta * power;
}

pub fn spin_boson_is_coherent_regime(p: SpinBosonParams) -> Int {
    let alpha: Float = p.kondo_alpha;
    if alpha < 0.5 {
        return 1;
    }
    return 0;
}
