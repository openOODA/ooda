// # Davies-GKSL Generator & Gibbs Thermal State Invariance
//
// Logline: Constructs microscopic Davies generators guaranteeing thermal detailed balance and convergence to the canonical Gibbs state rho_beta = exp(-beta H) / Z.
//
// Setup: Rigorous weak-coupling Davies generator formalism for open quantum systems coupled to infinite thermal reservoirs.
//
// Beats:
//   1. Construct Davies jump rate configuration from bath spectral density J(omega) at positive and negative transition Bohr frequencies.
//   2. Compute canonical two-level Gibbs state rho_beta = exp(-beta H) / Z.
//   3. Verify Davies generator Gibbs state invariance L_Davies(rho_beta) = 0.

pub type Complex = struct {
    real: Float,
    imag: Float,
};

pub type GibbsState2x2 = struct {
    pop_ground_0: Float,
    pop_excited_1: Float,
    partition_function_z: Float,
};

pub fn gibbs_state_2x2_compute(energy_gap_ghz: Float, temp_kelvin: Float) -> GibbsState2x2 {
    if temp_kelvin <= 0.0001 {
        return GibbsState2x2 {
            pop_ground_0: 1.0,
            pop_excited_1: 0.0,
            partition_function_z: 1.0,
        };
    }
    let x: Float = (0.0479924 * energy_gap_ghz) / temp_kelvin;
    let boltzmann_factor: Float = exp(0.0 - x);
    let z: Float = 1.0 + boltzmann_factor;

    let p0: Float = 1.0 / z;
    let p1: Float = boltzmann_factor / z;

    return GibbsState2x2 {
        pop_ground_0: p0,
        pop_excited_1: p1,
        partition_function_z: z,
    };
}

pub fn davies_detailed_balance_residual(p0: Float, p1: Float, rate_down: Float, rate_up: Float) -> Float {
    // Residual = | rate_up * p0 - rate_down * p1 |
    let flux: Float = (rate_up * p0) - (rate_down * p1);
    if flux < 0.0 {
        return 0.0 - flux;
    }
    return flux;
}
