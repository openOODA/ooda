// # Cascaded Open Quantum Systems & Directional Networks
//
// Logline: Implements the Carmichael-Gardiner cascaded quantum systems formalism for unidirectional photon transmission without backaction.
//
// Setup: Chiral waveguide networks linking emitter node A to receiver node B via directional Lindblad coupling.
//
// Beats:
//   1. Define 2-node cascaded network parameters (decay rate gamma_a, gamma_b, transmission phase phi).
//   2. Implement directional cascaded Liouvillian generator with non-reciprocal mediator coupling.
//   3. Evaluate unidirectional energy transfer fidelity from emitter to absorber.

pub type CascadedNodeParams = struct {
    decay_rate_gamma_a: Float,
    decay_rate_gamma_b: Float,
    transmission_phase_phi: Float,
};

pub fn cascaded_node_params_new(ga: Float, gb: Float, phi: Float) -> CascadedNodeParams {
    return CascadedNodeParams {
        decay_rate_gamma_a: ga,
        decay_rate_gamma_b: gb,
        transmission_phase_phi: phi,
    };
}

pub type CascadedPopulations = struct {
    pop_emitter_a: Float,
    pop_absorber_b: Float,
};

pub fn cascaded_network_step(p: CascadedNodeParams, state: CascadedPopulations, dt: Float) -> CascadedPopulations {
    let ga: Float = p.decay_rate_gamma_a;
    let gb: Float = p.decay_rate_gamma_b;
    let pa: Float = state.pop_emitter_a;
    let pb: Float = state.pop_absorber_b;

    // Node A emits independently into waveguide: d pA / dt = - gamma_a * pA
    let d_pa: Float = (0.0 - (ga * pa)) * dt;
    let next_pa: Float = pa + d_pa;

    // Node B is unidirectionally driven by emitted flux from A:
    // d pB / dt = - gamma_b * pB + 2 * sqrt(gamma_a * gamma_b) * cos(phi) * pA
    let sqrt_gagb: Float = sqrt(ga * gb);
    let cos_phi: Float = cos(p.transmission_phase_phi);
    let drive_from_a: Float = 2.0 * sqrt_gagb * cos_phi * pa;
    let d_pb: Float = ((0.0 - (gb * pb)) + drive_from_a) * dt;
    let mut next_pb: Float = pb + d_pb;
    if next_pb < 0.0 { next_pb = 0.0; }
    if next_pb > 1.0 { next_pb = 1.0; }

    return CascadedPopulations {
        pop_emitter_a: next_pa,
        pop_absorber_b: next_pb,
    };
}

pub fn cascaded_is_ideal_transfer(p: CascadedNodeParams) -> Int {
    let ga: Float = p.decay_rate_gamma_a;
    let gb: Float = p.decay_rate_gamma_b;
    let mut diff: Float = ga - gb;
    if diff < 0.0 { diff = 0.0 - diff; }
    if diff < 0.01 {
        return 1; // Impedance matched cascaded transfer
    }
    return 0;
}
