// # Liouvillian Spectral Gap & Dissipative Relaxation Timescales
//
// Logline: Computes the Liouvillian spectral gap Delta = |Re(lambda_1)| governing the asymptotic decay rate towards the unique steady state.
//
// Setup: Spectral analysis of Liouville superoperators L = -i [H, .] + D[L] and identification of dissipative phase transitions.
//
// Beats:
//   1. Define Liouvillian eigenvalue structures with real (decay) and imaginary (oscillation) parts.
//   2. Compute asymptotic relaxation timescale tau_relax = 1 / Delta from the spectral gap.
//   3. Detect critical gap closure Delta -> 0 signifying dissipative phase transitions or meta-stability.

pub type Complex = struct {
    real: Float,
    imag: Float
};

pub type LiouvillianGapResult = struct {
    spectral_gap_delta: Float,
    relaxation_time_tau: Float,
    is_gapless_critical: Int
};

pub fn liouvillian_gap_estimate_qubit(gamma_down: Float, gamma_up: Float, gamma_phi: Float) -> LiouvillianGapResult {
    // For standard longitudinal decay, the population relaxation rate is gamma_1 = gamma_down + gamma_up
    // The dephasing rate is gamma_2 = 0.5 * gamma_1 + 2 * gamma_phi
    let gamma_1: Float = gamma_down + gamma_up;
    let gamma_2: Float = (0.5 * gamma_1) + (2.0 * gamma_phi);

    let mut gap: Float = gamma_1;
    if gamma_2 < gamma_1 {
        gap = gamma_2;
    }

    let mut tau: Float = 10000.0;
    if gap > 0.000001 {
        tau = 1.0 / gap;
    }

    let mut critical: Int = 0;
    if gap < 0.0001 {
        critical = 1;
    }

    return LiouvillianGapResult {
        spectral_gap_delta: gap,
        relaxation_time_tau: tau,
        is_gapless_critical: critical
    };
}
