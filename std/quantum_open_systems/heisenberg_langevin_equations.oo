// # Quantum Heisenberg-Langevin Stochastic Differential Equations
//
// Logline: Integrates operator Langevin equations for damped harmonic oscillators driven by quantum input noise operators.
//
// Setup: Stochastic operator dynamics da/dt = -i omega_0 a - (gamma/2) a + sqrt(gamma) a_in(t) for open cavity modes.
//
// Beats:
//   1. Define cavity mode parameters (resonance freq omega_0, decay rate kappa, thermal drive).
//   2. Implement Euler-Maruyama stochastic Langevin time step for complex mode amplitudes.
//   3. Compute mean intracavity photon number <a^dagger a> and vacuum fluctuations.

pub type Complex = struct {
    real: Float,
    imag: Float,
};

pub type LangevinOscillatorParams = struct {
    resonance_freq: Float,
    decay_rate_kappa: Float,
    input_drive_power: Float,
};

pub fn langevin_params_new(omega0: Float, kappa: Float, drive: Float) -> LangevinOscillatorParams {
    return LangevinOscillatorParams {
        resonance_freq: omega0,
        decay_rate_kappa: kappa,
        input_drive_power: drive,
    };
}

pub type LangevinModeState = struct {
    alpha_real: Float,
    alpha_imag: Float,
    photon_number: Float,
};

pub fn langevin_euler_maruyama_step(
    p: LangevinOscillatorParams,
    state: LangevinModeState,
    noise_real: Float,
    noise_imag: Float,
    dt: Float
) -> LangevinModeState {
    let k: Float = p.decay_rate_kappa;
    let half_kappa: Float = 0.5 * k;
    let sqrt_kappa: Float = sqrt(k);
    let sqrt_dt: Float = sqrt(dt);
    let ar: Float = state.alpha_real;
    let ai: Float = state.alpha_imag;
    let w0: Float = p.resonance_freq;
    let drive: Float = p.input_drive_power;

    let drift_r: Float = (w0 * ai) - (half_kappa * ar) + (sqrt_kappa * drive);
    let drift_i: Float = (0.0 - (w0 * ar)) - (half_kappa * ai);

    let stoch_r: Float = sqrt_kappa * noise_real * sqrt_dt;
    let stoch_i: Float = sqrt_kappa * noise_imag * sqrt_dt;

    let next_r: Float = ar + (drift_r * dt) + stoch_r;
    let next_i: Float = ai + (drift_i * dt) + stoch_i;
    let n_photons: Float = (next_r * next_r) + (next_i * next_i);

    return LangevinModeState {
        alpha_real: next_r,
        alpha_imag: next_i,
        photon_number: n_photons,
    };
}
