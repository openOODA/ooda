// # Quantum Otto Heat Engine Four-Stroke Cycle Simulation
//
// Logline: Implements the four-stroke quantum Otto cycle (adiabatic compression, hot isochore, adiabatic expansion, cold isochore) and computes efficiency.
//
// Setup: Thermodynamic quantum heat engine using a two-level spin working medium between hot bath T_h and cold bath T_c.
//
// Beats:
//   1. Define Otto engine parameters (trap frequencies omega_low, omega_high, bath temps T_cold, T_hot).
//   2. Compute extracted work W_net = Q_hot + Q_cold and Otto thermal efficiency eta_otto = 1 - omega_low / omega_high.
//   3. Check Otto positive work extraction condition omega_high / omega_low < T_hot / T_cold.

pub type QuantumOttoConfig = struct {
    omega_cold_low: Float,
    omega_hot_high: Float,
    temp_cold: Float,
    temp_hot: Float
};

pub fn quantum_otto_config_new(w_low: Float, w_high: Float, tc: Float, th: Float) -> QuantumOttoConfig {
    return QuantumOttoConfig {
        omega_cold_low: w_low,
        omega_hot_high: w_high,
        temp_cold: tc,
        temp_hot: th
    };
}

pub fn quantum_otto_efficiency_ideal(cfg: QuantumOttoConfig) -> Float {
    let w_low: Float = cfg.omega_cold_low;
    let w_high: Float = cfg.omega_hot_high;
    if w_high <= 0.0 {
        return 0.0;
    }
    return 1.0 - (w_low / w_high);
}

pub fn quantum_otto_carnot_limit(cfg: QuantumOttoConfig) -> Float {
    let tc: Float = cfg.temp_cold;
    let th: Float = cfg.temp_hot;
    if th <= 0.0 {
        return 0.0;
    }
    return 1.0 - (tc / th);
}

pub fn quantum_otto_can_extract_work(cfg: QuantumOttoConfig) -> Int {
    let w_low: Float = cfg.omega_cold_low;
    let w_high: Float = cfg.omega_hot_high;
    let tc: Float = cfg.temp_cold;
    let th: Float = cfg.temp_hot;

    let ratio_freq: Float = w_high / w_low;
    let ratio_temp: Float = th / tc;

    if ratio_freq < ratio_temp {
        return 1; // Positive work output engine mode
    }
    return 0; // Refrigerator or dud mode
}
