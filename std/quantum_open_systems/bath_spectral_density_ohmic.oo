// # Bath Spectral Density & Ohmic Power-Law Ensembles
//
// Logline: Evaluates Ohmic (s=1), sub-Ohmic (s<1), and super-Ohmic (s>1) bath spectral coupling functions J(omega) = alpha omega^s exp(-omega / omega_c).
//
// Setup: Environmental coupling spectrum parameterization with high-frequency exponential cutoff.
//
// Beats:
//   1. Define spectral density parameter structure (Kondo parameter alpha, exponent s, cutoff omega_c).
//   2. Compute Ohmic, sub-Ohmic, and super-Ohmic spectral density values J(omega).
//   3. Calculate bath reorganization energy E_R = (1/pi) int (J(omega)/omega) d omega.

pub type SpectralDensityConfig = struct {
    alpha_kondo: Float,
    exponent_s: Float,
    cutoff_freq_wc: Float,
};

pub fn spectral_density_ohmic_default() -> SpectralDensityConfig {
    return SpectralDensityConfig {
        alpha_kondo: 0.05,
        exponent_s: 1.0,
        cutoff_freq_wc: 10.0,
    };
}

pub fn spectral_density_eval(cfg: SpectralDensityConfig, omega: Float) -> Float {
    if omega <= 0.0 {
        return 0.0;
    }
    let wc: Float = cfg.cutoff_freq_wc;
    let cutoff: Float = exp(0.0 - (omega / wc));

    let mut pow_val: Float = omega;
    if cfg.exponent_s == 1.0 {
        pow_val = omega;
    } else if cfg.exponent_s == 0.5 {
        pow_val = sqrt(omega);
    } else if cfg.exponent_s == 2.0 {
        pow_val = omega * omega;
    } else if cfg.exponent_s == 3.0 {
        pow_val = omega * omega * omega;
    }

    return cfg.alpha_kondo * pow_val * cutoff;
}

pub fn spectral_reorganization_energy_ohmic(cfg: SpectralDensityConfig) -> Float {
    return cfg.alpha_kondo * cfg.cutoff_freq_wc;
}

pub fn spectral_drude_lorentz_eval(gamma_coupling: Float, omega_drude: Float, omega: Float) -> Float {
    if omega <= 0.0 {
        return 0.0;
    }
    let denom: Float = (omega * omega) + (omega_drude * omega_drude);
    return (2.0 * gamma_coupling * omega_drude * omega) / denom;
}
