// # Quantum Absorption Refrigerator & Laser Sideband Cooling
//
// Logline: Models steady-state three-level quantum refrigerators and resolved-sideband optical cooling towards the motional ground state.
//
// Setup: Autonomous three-level quantum thermal machine and optomechanical sideband cooling engine.
//
// Beats:
//   1. Construct sideband cooling parameters (mechanical frequency omega_m, optical linewidth kappa, optomechanical coupling g0).
//   2. Compute resolved-sideband quantum backaction cooling rate Gamma_opt and minimum phonon limit n_min.
//   3. Compute three-level quantum absorption refrigerator coefficient of performance (COP).

pub type SidebandCoolingParams = struct {
    mech_frequency_omega_m: Float,
    cavity_linewidth_kappa: Float,
    optomechanical_g0: Float,
    drive_photon_number_nc: Float
};

pub fn sideband_cooling_params_new(wm: Float, kappa: Float, g0: Float, nc: Float) -> SidebandCoolingParams {
    return SidebandCoolingParams {
        mech_frequency_omega_m: wm,
        cavity_linewidth_kappa: kappa,
        optomechanical_g0: g0,
        drive_photon_number_nc: nc
    };
}

pub fn sideband_cooling_rate(p: SidebandCoolingParams) -> Float {
    let kappa: Float = p.cavity_linewidth_kappa;
    let g0: Float = p.optomechanical_g0;
    let nc: Float = p.drive_photon_number_nc;

    // In resolved sideband regime (omega_m >> kappa): Gamma_opt = 4 g0^2 nc / kappa
    if kappa <= 0.0 {
        return 0.0;
    }
    return (4.0 * g0 * g0 * nc) / kappa;
}

pub fn sideband_quantum_ground_state_limit(p: SidebandCoolingParams) -> Float {
    let wm: Float = p.mech_frequency_omega_m;
    let kappa: Float = p.cavity_linewidth_kappa;

    // Minimum reachable phonon occupancy: n_min = (kappa / (4 omega_m))^2
    if wm <= 0.0 {
        return 1.0;
    }
    let ratio: Float = kappa / (4.0 * wm);
    return ratio * ratio;
}

pub fn absorption_refrigerator_cop(temp_cold: Float, temp_work: Float, temp_hot: Float) -> Float {
    // Carnot COP of absorption refrigerator: COP_c = (1 - T_hot/T_work) / (T_hot/T_cold - 1)
    let denom: Float = (temp_hot / temp_cold) - 1.0;
    if denom <= 0.0 {
        return 0.0;
    }
    let num: Float = 1.0 - (temp_hot / temp_work);
    if num <= 0.0 {
        return 0.0;
    }
    return num / denom;
}
