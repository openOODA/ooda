// # Continuous Quantum Heterodyne & Dual-Quadrature Detection
//
// Logline: Simulates simultaneous non-commuting quadrature measurements (X and P) with quantum-limited 3 dB noise penalty and phase-insensitive amplification.
//
// Setup: Dual-balanced homodyne splitting of cavity output mode into in-phase and quadrature-phase channels.
//
// Beats:
//   1. Define heterodyne detector configuration with independent Wiener noise channels.
//   2. Generate joint complex measurement current J(t) dt = sqrt(kappa / 2) <alpha> dt + (dW_x + i dW_p) / sqrt(2).
//   3. Compute complex coherent state amplitude estimation and 3 dB quantum measurement penalty.

pub type Complex = struct {
    real: Float,
    imag: Float
};

pub type HeterodyneDetectorConfig = struct {
    efficiency_eta: Float,
    cavity_coupling_kappa: Float
};

pub fn heterodyne_detector_new(eta: Float, kappa: Float) -> HeterodyneDetectorConfig {
    return HeterodyneDetectorConfig {
        efficiency_eta: eta,
        cavity_coupling_kappa: kappa
    };
}

pub type HeterodyneCurrentSample = struct {
    current_x: Float,
    current_p: Float,
    estimated_alpha_r: Float,
    estimated_alpha_i: Float
};

pub fn heterodyne_sample_step(
    cfg: HeterodyneDetectorConfig,
    mean_x: Float,
    mean_p: Float,
    noise_x: Float,
    noise_p: Float,
    dt: Float
) -> HeterodyneCurrentSample {
    let eta: Float = cfg.efficiency_eta;
    let kappa: Float = cfg.cavity_coupling_kappa;
    let sqrt_half_eff: Float = sqrt(0.5 * eta * kappa);
    let sqrt_dt: Float = sqrt(dt);

    let j_x: Float = (sqrt_half_eff * mean_x) + (noise_x / sqrt_dt);
    let j_p: Float = (sqrt_half_eff * mean_p) + (noise_p / sqrt_dt);

    let alpha_r_est: Float = j_x / sqrt_half_eff;
    let alpha_i_est: Float = j_p / sqrt_half_eff;

    return HeterodyneCurrentSample {
        current_x: j_x,
        current_p: j_p,
        estimated_alpha_r: alpha_r_est,
        estimated_alpha_i: alpha_i_est
    };
}
