// # Diffusive Stochastic Schrodinger Equation (SSE)
//
// Logline: Simulates continuous weak measurement trajectories using the diffusive Itô stochastic Schrödinger equation with Wiener increments.
//
// Setup: Continuous homodyne unravelling of open quantum systems with measurement backaction and stochastic state collapse.
//
// Beats:
//   1. Define 2-level complex statevector amplitudes and compute expectation values <X>.
//   2. Evaluate deterministic drift and stochastic Wiener diffusion increment dW.
//   3. Implement Itô stochastic state update step preserving state normalization.

pub type Complex = struct {
    real: Float,
    imag: Float
};

pub fn sse_c_new(r: Float, i: Float) -> Complex {
    return Complex { real: r, imag: i };
}

pub fn sse_c_add(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let br: Float = b.real;
    let bi: Float = b.imag;
    return Complex { real: ar + br, imag: ai + bi };
}

pub fn sse_c_scale(a: Complex, s: Float) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    return Complex { real: ar * s, imag: ai * s };
}

pub type SseState = struct {
    c0: Complex,
    c1: Complex
};

pub fn sse_expectation_sigma_z(psi: SseState) -> Float {
    let c0: Complex = psi.c0;
    let c1: Complex = psi.c1;
    let p0: Float = (c0.real * c0.real) + (c0.imag * c0.imag);
    let p1: Float = (c1.real * c1.real) + (c1.imag * c1.imag);
    return p0 - p1;
}

pub fn sse_ito_step(psi: SseState, gamma_meas: Float, dw: Float, dt: Float) -> SseState {
    let sz_exp: Float = sse_expectation_sigma_z(psi);
    let sqrt_gamma: Float = sqrt(gamma_meas);
    let half_gamma: Float = 0.5 * gamma_meas;

    let c0: Complex = psi.c0;
    let c1: Complex = psi.c1;
    let c0_r: Float = c0.real;
    let c0_i: Float = c0.imag;
    let c1_r: Float = c1.real;
    let c1_i: Float = c1.imag;

    let drift0: Float = (0.0 - (0.5 * half_gamma * (1.0 - (sz_exp * sz_exp)))) * dt;
    let stoch0: Float = sqrt_gamma * (1.0 - sz_exp) * dw;
    let factor0: Float = 1.0 + drift0 + stoch0;

    let drift1: Float = (0.0 - (0.5 * half_gamma * (1.0 - (sz_exp * sz_exp)))) * dt;
    let stoch1: Float = sqrt_gamma * ((0.0 - 1.0) - sz_exp) * dw;
    let factor1: Float = 1.0 + drift1 + stoch1;

    let next_c0: Complex = sse_c_scale(c0, factor0);
    let next_c1: Complex = sse_c_scale(c1, factor1);

    let nc0_r: Float = next_c0.real;
    let nc0_i: Float = next_c0.imag;
    let nc1_r: Float = next_c1.real;
    let nc1_i: Float = next_c1.imag;
    let norm_sq: Float = (nc0_r * nc0_r) + (nc0_i * nc0_i) + (nc1_r * nc1_r) + (nc1_i * nc1_i);
    let mut inv_norm: Float = 1.0;
    if norm_sq > 0.0000001 {
        inv_norm = 1.0 / sqrt(norm_sq);
    }

    return SseState {
        c0: sse_c_scale(next_c0, inv_norm),
        c1: sse_c_scale(next_c1, inv_norm)
    };
}
