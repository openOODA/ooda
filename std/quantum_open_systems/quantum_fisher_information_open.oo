// # Quantum Fisher Information (QFI) in Noisy Parameter Estimation
//
// Logline: Evaluates the Quantum Fisher Information F_Q(rho_theta) for open quantum metrology, computing the quantum Cramér-Rao bound.
//
// Setup: Precision phase estimation in the presence of photon loss and dephasing noise channels.
//
// Beats:
//   1. Construct noisy metrological qubit state with phase theta and coherence retention factor eta.
//   2. Compute noisy Quantum Fisher Information F_Q = eta^2 * F_Q,pure.
//   3. Evaluate quantum Cramér-Rao bound delta theta >= 1 / sqrt(N_shots * F_Q).

pub type QfiMetrologyConfig = struct {
    num_probes_n: Int,
    dephasing_retention_eta: Float,
};

pub fn qfi_config_new(n: Int, eta: Float) -> QfiMetrologyConfig {
    return QfiMetrologyConfig {
        num_probes_n: n,
        dephasing_retention_eta: eta,
    };
}

pub fn qfi_single_qubit_noisy(eta: Float) -> Float {
    // For optimal equatorial pure state |+>, F_Q,pure = 1. Under dephasing: F_Q = eta^2
    return eta * eta;
}

pub fn qfi_quantum_cramer_rao_bound(cfg: QfiMetrologyConfig, num_shots: Int) -> Float {
    let n: Int = cfg.num_probes_n;
    let eta: Float = cfg.dephasing_retention_eta;
    let n_f: Float = (n as Float);
    let shots_f: Float = (num_shots as Float);

    let f_q_total: Float = n_f * qfi_single_qubit_noisy(eta);
    if f_q_total <= 0.0000001 || shots_f <= 0.0 {
        return 1000.0;
    }
    return 1.0 / sqrt(shots_f * f_q_total);
}
