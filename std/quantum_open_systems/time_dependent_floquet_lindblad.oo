// # Floquet-Markov Master Equation for Periodically Driven Systems
//
// Logline: Implements Floquet-Lindblad master equations for time-periodic Hamiltonians H(t + T) = H(t), computing quasi-energies and Floquet dissipators.
//
// Setup: Floquet theory unravelling of driven open systems beyond the static rotating wave approximation.
//
// Beats:
//   1. Construct Floquet drive parameters (drive frequency Omega, amplitude V_0, period T = 2 pi / Omega).
//   2. Compute two-level quasi-energy splitting epsilon_pm = +- 0.5 sqrt(Delta^2 + V_0^2).
//   3. Evaluate Floquet sideband transition rates at harmonics omega_k = epsilon +- k Omega.

pub type FloquetDriveParams = struct {
    static_detuning_delta: Float,
    drive_amplitude_v0: Float,
    drive_frequency_omega: Float,
};

pub fn floquet_params_new(delta: Float, v0: Float, omega: Float) -> FloquetDriveParams {
    return FloquetDriveParams {
        static_detuning_delta: delta,
        drive_amplitude_v0: v0,
        drive_frequency_omega: omega,
    };
}

pub fn floquet_quasi_energy_splitting(p: FloquetDriveParams) -> Float {
    let delta: Float = p.static_detuning_delta;
    let v0: Float = p.drive_amplitude_v0;
    let r_sq: Float = (delta * delta) + (v0 * v0);
    return sqrt(r_sq);
}

pub fn floquet_sideband_frequency(p: FloquetDriveParams, harmonic_k: Int) -> Float {
    let eps: Float = floquet_quasi_energy_splitting(p);
    let omega: Float = p.drive_frequency_omega;
    let k_f: Float = (harmonic_k * 1.0);
    return eps + (k_f * omega);
}
