// # Measurement-Induced Phase Transition (MIPT) Entanglement Scrambling
//
// Logline: Simulates the competition between random unitary entangling dynamics and local monitored projective measurements, tracking the volume-to-area law transition.
//
// Setup: Monitored quantum circuits undergoing measurement-induced entanglement transitions at critical measurement probability p_c.
//
// Beats:
//   1. Construct MIPT circuit parameters (qubit count N, measurement probability p_meas, depth).
//   2. Estimate critical measurement threshold p_c ~ 0.16 for 1D Haar/Clifford monitored circuits.
//   3. Compute subsystem entanglement entropy scaling and classify Area-Law vs Volume-Law phases.

pub type MiptCircuitParams = struct {
    qubit_count_n: Int,
    measurement_prob_p: Float,
    circuit_depth: Int
};

pub fn mipt_params_new(n: Int, p: Float, depth: Int) -> MiptCircuitParams {
    return MiptCircuitParams {
        qubit_count_n: n,
        measurement_prob_p: p,
        circuit_depth: depth
    };
}

pub fn mipt_critical_threshold() -> Float {
    return 0.160; // Critical monitoring rate p_c for 1+1D random circuits
}

pub fn mipt_is_area_law_phase(p: MiptCircuitParams) -> Int {
    let p_meas: Float = p.measurement_prob_p;
    let p_c: Float = mipt_critical_threshold();
    if p_meas > p_c {
        return 1; // Disentangled / Area-law phase (Zeno-like localization)
    }
    return 0; // Entangled / Volume-law phase (scrambling quantum state)
}

pub fn mipt_subsystem_entropy_estimate(p: MiptCircuitParams, subsystem_size_la: Int) -> Float {
    let is_area: Int = mipt_is_area_law_phase(p);
    let la_f: Float = (subsystem_size_la * 1.0);
    if is_area == 1 {
        // Area law: S(L_A) = constant O(1)
        return 1.0;
    }
    // Volume law: S(L_A) = alpha * L_A
    let alpha: Float = 0.5 * (1.0 - (p.measurement_prob_p / mipt_critical_threshold()));
    return alpha * la_f;
}
