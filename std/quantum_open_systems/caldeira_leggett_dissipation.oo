// # Caldeira-Leggett Quantum Brownian Motion & Friction
//
// Logline: Models high-temperature continuous variable quantum Brownian motion with Ohmic friction, position diffusion, and momentum damping.
//
// Setup: Master equation for a quantum particle in contact with an infinite harmonic bath in the high-T Caldeira-Leggett limit.
//
// Beats:
//   1. Construct Caldeira-Leggett model parameters (particle mass, friction eta, temperature T, trap freq).
//   2. Compute high-temperature diffusion constant D = 2 eta m k_B T.
//   3. Propagate first and second moments <x>, <p>, <x^2>, <p^2> with thermalization.

pub type CaldeiraLeggettParams = struct {
    mass: Float,
    friction_gamma: Float,
    temperature_k: Float,
    omega_trap: Float,
    diffusion_d: Float,
};

pub fn caldeira_leggett_params_new(m: Float, gamma: Float, temp_k: Float, omega: Float) -> CaldeiraLeggettParams {
    let k_b: Float = 1.380649;
    let diff: Float = 2.0 * gamma * m * k_b * temp_k;
    return CaldeiraLeggettParams {
        mass: m,
        friction_gamma: gamma,
        temperature_k: temp_k,
        omega_trap: omega,
        diffusion_d: diff,
    };
}

pub type PhaseSpaceMoments = struct {
    mean_x: Float,
    mean_p: Float,
    var_x: Float,
    var_p: Float,
};

pub fn caldeira_moments_new(x0: Float, p0: Float, vx0: Float, vp0: Float) -> PhaseSpaceMoments {
    return PhaseSpaceMoments { mean_x: x0, mean_p: p0, var_x: vx0, var_p: vp0 };
}

pub fn caldeira_leggett_time_step(p: CaldeiraLeggettParams, m: PhaseSpaceMoments, dt: Float) -> PhaseSpaceMoments {
    let mx: Float = m.mean_x;
    let mp: Float = m.mean_p;
    let vx: Float = m.var_x;
    let vp: Float = m.var_p;
    let mass: Float = p.mass;
    let gamma: Float = p.friction_gamma;
    let w_trap: Float = p.omega_trap;
    let diff_d: Float = p.diffusion_d;

    let dx: Float = (mp / mass) * dt;
    let dp: Float = ((0.0 - (mass * w_trap * w_trap * mx)) - (gamma * mp)) * dt;

    let next_x: Float = mx + dx;
    let next_p: Float = mp + dp;

    let dvar_p: Float = ((0.0 - (2.0 * gamma * vp)) + (2.0 * diff_d)) * dt;
    let next_var_p: Float = vp + dvar_p;

    let dvar_x: Float = ((2.0 * mp / mass) * mx) * dt;
    let next_var_x: Float = vx + (0.01 * next_x * next_x);

    return PhaseSpaceMoments {
        mean_x: next_x,
        mean_p: next_p,
        var_x: next_var_x,
        var_p: next_var_p,
    };
}
