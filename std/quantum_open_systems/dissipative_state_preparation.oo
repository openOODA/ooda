// # Engineered Dissipation & Quantum State Preparation Attractor
//
// Logline: Designs custom jump operators L such that a targeted pure state (e.g. Bell state) is the unique steady-state dark state L rho_target = 0.
//
// Setup: Reservoir engineering stabilizing entangled states as dissipative fixed points without active feedback.
//
// Beats:
//   1. Construct dissipative attractor target state configuration.
//   2. Define engineered dissipator jump rate gamma_eng and Hamiltonian drive strength.
//   3. Compute fidelity of convergence to target dark state F(rho(t), |psi_target><psi_target|).

pub type TargetStatePrepConfig = struct {
    target_state_id: Int, // 0: Bell |Phi+>, 1: Squeezed Vacuum, 2: Cat State
    engineered_jump_rate: Float,
    parasitic_loss_rate: Float
};

pub fn dissipative_prep_config_bell() -> TargetStatePrepConfig {
    return TargetStatePrepConfig {
        target_state_id: 0,
        engineered_jump_rate: 1.0,
        parasitic_loss_rate: 0.01
    };
}

pub fn dissipative_steady_state_fidelity(cfg: TargetStatePrepConfig) -> Float {
    let gamma_eng: Float = cfg.engineered_jump_rate;
    let gamma_loss: Float = cfg.parasitic_loss_rate;

    let tot: Float = gamma_eng + gamma_loss;
    if tot <= 0.0 {
        return 0.0;
    }
    // Asymptotic fidelity F = gamma_eng / (gamma_eng + gamma_loss)
    return gamma_eng / tot;
}

pub fn dissipative_preparation_time_us(cfg: TargetStatePrepConfig) -> Float {
    let gamma_eng: Float = cfg.engineered_jump_rate;
    if gamma_eng <= 0.0 {
        return 1000.0;
    }
    // Time to reach 99% fidelity ~ 4.6 / gamma_eng
    return 4.6 / gamma_eng;
}
