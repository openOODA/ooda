// # Hierarchical Equations of Motion (HEOM) Non-Markovian Engine
//
// Logline: Implements the Tanimura-Kubo HEOM hierarchy with auxiliary density operators (ADOs) for non-perturbative open quantum systems.
//
// Setup: Multi-tier auxiliary density matrix network capturing non-Markovian memory beyond second-order perturbation theory.
//
// Beats:
//   1. Construct HEOM tier parameters (Drude-Lorentz frequency gamma_d, reorganization energy lambda).
//   2. Define tier-0 (reduced density matrix) and tier-1 auxiliary density operator nodes.
//   3. Propagate hierarchical coupling step between primary state and auxiliary memory nodes.

pub type Complex = struct {
    real: Float,
    imag: Float
};

pub fn heom_c_new(r: Float, i: Float) -> Complex {
    return Complex { real: r, imag: i };
}

pub type HeomParams = struct {
    drude_decay_gamma: Float,
    reorganization_lambda: Float,
    temperature_k: Float
};

pub fn heom_params_new(gamma_d: Float, lambda_reorg: Float, temp: Float) -> HeomParams {
    return HeomParams {
        drude_decay_gamma: gamma_d,
        reorganization_lambda: lambda_reorg,
        temperature_k: temp
    };
}

pub type HeomTwoTierState = struct {
    rho_p0: Float,
    rho_p1: Float,
    ado1_r: Float,
    ado1_i: Float
};

pub fn heom_two_tier_step(state: HeomTwoTierState, p: HeomParams, omega_0: Float, dt: Float) -> HeomTwoTierState {
    let p0: Float = state.rho_p0;
    let p1: Float = state.rho_p1;
    let a1_r: Float = state.ado1_r;
    let a1_i: Float = state.ado1_i;

    let gamma_d: Float = p.drude_decay_gamma;
    let lambda_re: Float = p.reorganization_lambda;

    let dp0: Float = (0.0 - (2.0 * a1_i)) * dt;
    let dp1: Float = (2.0 * a1_i) * dt;

    let d_a1_r: Float = ((omega_0 * a1_i) - (gamma_d * a1_r)) * dt;
    let d_a1_i: Float = (((0.0 - (omega_0 * a1_r)) - (gamma_d * a1_i)) - (lambda_re * (p0 - p1))) * dt;

    return HeomTwoTierState {
        rho_p0: p0 + dp0,
        rho_p1: p1 + dp1,
        ado1_r: a1_r + d_a1_r,
        ado1_i: a1_i + d_a1_i
    };
}
