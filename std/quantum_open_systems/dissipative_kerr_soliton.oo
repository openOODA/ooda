// # Driven-Dissipative Kerr Microcavity Soliton & Bistability
//
// Logline: Models continuous-wave laser driven nonlinear Kerr optical microresonators with optical loss kappa, detuning Delta, and Kerr nonlinearity g.
//
// Setup: Mean-field and quantum master equation dynamics for dissipative Kerr solitons and optical bistability.
//
// Beats:
//   1. Construct Kerr cavity parameters (loss kappa, detuning Delta, Kerr coefficient g, pump amplitude F).
//   2. Evaluate optical bistability cubic polynomial roots for stationary intracavity photon intensity.
//   3. Propagate dissipative mean-field time step d alpha / dt = - (kappa/2 + i Delta) alpha - i g |alpha|^2 alpha + F.

pub type Complex = struct {
    real: Float,
    imag: Float,
};

pub type KerrCavityParams = struct {
    loss_kappa: Float,
    detuning_delta: Float,
    kerr_nonlinearity_g: Float,
    laser_drive_f: Float,
};

pub fn kerr_cavity_params_new(kappa: Float, delta: Float, g: Float, f: Float) -> KerrCavityParams {
    return KerrCavityParams {
        loss_kappa: kappa,
        detuning_delta: delta,
        kerr_nonlinearity_g: g,
        laser_drive_f: f,
    };
}

pub type KerrFieldState = struct {
    alpha_real: Float,
    alpha_imag: Float,
    intracavity_photons: Float,
};

pub fn kerr_field_step(p: KerrCavityParams, state: KerrFieldState, dt: Float) -> KerrFieldState {
    let ar: Float = state.alpha_real;
    let ai: Float = state.alpha_imag;
    let n_photons: Float = (ar * ar) + (ai * ai);

    let kappa: Float = p.loss_kappa;
    let delta: Float = p.detuning_delta;
    let g: Float = p.kerr_nonlinearity_g;
    let drive: Float = p.laser_drive_f;

    let eff_detuning: Float = delta + (g * n_photons);
    let half_kappa: Float = 0.5 * kappa;

    // d alpha / dt = - half_kappa * alpha - i * eff_detuning * alpha + drive
    let d_ar: Float = ((0.0 - (half_kappa * ar)) + (eff_detuning * ai) + drive) * dt;
    let d_ai: Float = ((0.0 - (half_kappa * ai)) - (eff_detuning * ar)) * dt;

    let next_ar: Float = ar + d_ar;
    let next_ai: Float = ai + d_ai;
    let next_n: Float = (next_ar * next_ar) + (next_ai * next_ai);

    return KerrFieldState {
        alpha_real: next_ar,
        alpha_imag: next_ai,
        intracavity_photons: next_n,
    };
}

pub fn kerr_threshold_drive(p: KerrCavityParams) -> Float {
    let kappa: Float = p.loss_kappa;
    let g: Float = p.kerr_nonlinearity_g;
    if g <= 0.0 {
        return 1000.0;
    }
    // Bistability threshold F_th ~ sqrt(8 * (kappa/2)^3 / (3*sqrt(3)*g))
    let half_k: Float = 0.5 * kappa;
    let num: Float = 8.0 * half_k * half_k * half_k;
    let den: Float = 5.19615 * g; // 3 * sqrt(3) ~ 5.19615
    return sqrt(num / den);
}
