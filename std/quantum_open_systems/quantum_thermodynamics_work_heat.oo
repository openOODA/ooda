// # Quantum Thermodynamics: Work, Heat Flux & First Law
//
// Logline: Partitions internal energy changes into mechanical work power W_dot = Tr(rho H_dot) and dissipative heat flux Q_dot = Tr(rho_dot H).
//
// Setup: First law of quantum thermodynamics dU/dt = dW/dt + dQ/dt for driven open quantum systems.
//
// Beats:
//   1. Construct instantaneous 2-level Hamiltonian and density matrix snapshot.
//   2. Compute internal energy U = Tr(rho H), work power dW/dt, and heat flux dQ/dt.
//   3. Verify First Law energy conservation residual dU - (dW + dQ) = 0.

pub type QuantumFirstLawSnapshot = struct {
    internal_energy_u: Float,
    work_power_w_dot: Float,
    heat_flux_q_dot: Float,
    total_power: Float
};

pub fn quantum_first_law_evaluate(
    p0: Float,
    p1: Float,
    e0: Float,
    e1: Float,
    de0_dt: Float,
    de1_dt: Float,
    dp0_dt: Float,
    dp1_dt: Float
) -> QuantumFirstLawSnapshot {
    // Internal energy U = p0*E0 + p1*E1
    let u: Float = (p0 * e0) + (p1 * e1);

    // Work power dW/dt = p0*(dE0/dt) + p1*(dE1/dt)
    let w_dot: Float = (p0 * de0_dt) + (p1 * de1_dt);

    // Heat flux dQ/dt = (dp0/dt)*E0 + (dp1/dt)*E1
    let q_dot: Float = (dp0_dt * e0) + (dp1_dt * e1);

    let tot: Float = w_dot + q_dot;
    return QuantumFirstLawSnapshot {
        internal_energy_u: u,
        work_power_w_dot: w_dot,
        heat_flux_q_dot: q_dot,
        total_power: tot
    };
}

pub fn quantum_first_law_residual(du_dt: Float, w_dot: Float, q_dot: Float) -> Float {
    let diff: Float = du_dt - (w_dot + q_dot);
    if diff < 0.0 {
        return 0.0 - diff;
    }
    return diff;
}
