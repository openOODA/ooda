// # Born-Markov Redfield Master Equation & Secular Approximation
//
// Logline: Computes transition rates and Lamb shifts in the energy eigenbasis using the microscopic Redfield tensor with full and secular approximations.
//
// Setup: Microscopic open system dynamics derived from system-bath coupling Hamiltonian H_I = S (x) B.
//
// Beats:
//   1. Construct microscopic Redfield transition rate tensors Gamma(omega).
//   2. Apply secular approximation (rotating wave approximation) decoupling populations and coherences.
//   3. Compute Lamb-shift Hamiltonian renormalization and decay rates.

pub type RedfieldRates2x2 = struct {
    rate_0_to_1: Float,
    rate_1_to_0: Float,
    lamb_shift_0: Float,
    lamb_shift_1: Float,
    pure_dephasing_gamma: Float
};

pub fn redfield_rates_new(gamma_down: Float, gamma_up: Float, lamb: Float, dephase: Float) -> RedfieldRates2x2 {
    return RedfieldRates2x2 {
        rate_0_to_1: gamma_up,
        rate_1_to_0: gamma_down,
        lamb_shift_0: 0.0 - (0.5 * lamb),
        lamb_shift_1: 0.5 * lamb,
        pure_dephasing_gamma: dephase
    };
}

pub type RedfieldDensityState = struct {
    pop_0: Float,
    pop_1: Float,
    coherence_r: Float,
    coherence_i: Float
};

pub fn redfield_secular_step(state: RedfieldDensityState, rates: RedfieldRates2x2, omega_0: Float, dt: Float) -> RedfieldDensityState {
    let p0: Float = state.pop_0;
    let p1: Float = state.pop_1;
    let cr: Float = state.coherence_r;
    let ci: Float = state.coherence_i;

    let r_up: Float = rates.rate_0_to_1;
    let r_down: Float = rates.rate_1_to_0;
    let dp0: Float = ((0.0 - (r_up * p0)) + (r_down * p1)) * dt;
    let dp1: Float = 0.0 - dp0;

    let next_p0: Float = p0 + dp0;
    let next_p1: Float = p1 + dp1;

    let gamma_2: Float = (0.5 * (r_up + r_down)) + rates.pure_dephasing_gamma;
    let eff_omega: Float = omega_0 + (rates.lamb_shift_1 - rates.lamb_shift_0);

    let d_cr: Float = ((eff_omega * ci) - (gamma_2 * cr)) * dt;
    let d_ci: Float = ((0.0 - (eff_omega * cr)) - (gamma_2 * ci)) * dt;

    return RedfieldDensityState {
        pop_0: next_p0,
        pop_1: next_p1,
        coherence_r: cr + d_cr,
        coherence_i: ci + d_ci
    };
}
