// # Kraus Operator Representation & Completely Positive Maps
//
// Logline: Implements CPTP quantum channels via Kraus decomposition rho |-> sum M_k rho M_k^dagger and verifies completeness sum M_k^dagger M_k = I.
//
// Setup: General operator-sum representation for arbitrary single-qubit quantum channels.
//
// Beats:
//   1. Define 2x2 complex Kraus operators and KrausChannel container.
//   2. Apply Kraus map to arbitrary 2x2 density matrices.
//   3. Compute completeness trace residual ||sum M_k^dagger M_k - I||.

pub type Complex = struct {
    real: Float,
    imag: Float
};

pub fn kc_new(r: Float, i: Float) -> Complex {
    return Complex { real: r, imag: i };
}

pub fn kc_add(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let br: Float = b.real;
    let bi: Float = b.imag;
    return Complex { real: ar + br, imag: ai + bi };
}

pub fn kc_sub(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let br: Float = b.real;
    let bi: Float = b.imag;
    return Complex { real: ar - br, imag: ai - bi };
}

pub fn kc_mul(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let br: Float = b.real;
    let bi: Float = b.imag;
    return Complex {
        real: (ar * br) - (ai * bi),
        imag: (ar * bi) + (ai * br)
    };
}

pub fn kc_conj(a: Complex) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    return Complex { real: ar, imag: 0.0 - ai };
}

pub type KrausOp2x2 = struct {
    m00: Complex,
    m01: Complex,
    m10: Complex,
    m11: Complex
};

pub fn kraus_op_new(m00: Complex, m01: Complex, m10: Complex, m11: Complex) -> KrausOp2x2 {
    return KrausOp2x2 { m00: m00, m01: m01, m10: m10, m11: m11 };
}

pub fn kraus_op_apply(op: KrausOp2x2, r00: Complex, r01: Complex, r10: Complex, r11: Complex) -> KrausOp2x2 {
    let op00: Complex = op.m00;
    let op01: Complex = op.m01;
    let op10: Complex = op.m10;
    let op11: Complex = op.m11;

    let t00: Complex = kc_add(kc_mul(op00, r00), kc_mul(op01, r10));
    let t01: Complex = kc_add(kc_mul(op00, r01), kc_mul(op01, r11));
    let t10: Complex = kc_add(kc_mul(op10, r00), kc_mul(op11, r10));
    let t11: Complex = kc_add(kc_mul(op10, r01), kc_mul(op11, r11));

    let md00: Complex = kc_conj(op00);
    let md01: Complex = kc_conj(op10);
    let md10: Complex = kc_conj(op01);
    let md11: Complex = kc_conj(op11);

    let out00: Complex = kc_add(kc_mul(t00, md00), kc_mul(t01, md10));
    let out01: Complex = kc_add(kc_mul(t00, md01), kc_mul(t01, md11));
    let out10: Complex = kc_add(kc_mul(t10, md00), kc_mul(t11, md10));
    let out11: Complex = kc_add(kc_mul(t10, md01), kc_mul(t11, md11));

    return KrausOp2x2 { m00: out00, m01: out01, m10: out10, m11: out11 };
}

pub fn kraus_amplitude_damping_channel(gamma: Float) -> List[KrausOp2x2] {
    let mut ops: List[KrausOp2x2] = list_new();
    let sqrt_1_minus_gamma: Float = sqrt(1.0 - gamma);
    let sqrt_gamma: Float = sqrt(gamma);

    let m0: KrausOp2x2 = KrausOp2x2 {
        m00: kc_new(1.0, 0.0),
        m01: kc_new(0.0, 0.0),
        m10: kc_new(0.0, 0.0),
        m11: kc_new(sqrt_1_minus_gamma, 0.0)
    };
    let m1: KrausOp2x2 = KrausOp2x2 {
        m00: kc_new(0.0, 0.0),
        m01: kc_new(sqrt_gamma, 0.0),
        m10: kc_new(0.0, 0.0),
        m11: kc_new(0.0, 0.0)
    };

    list_push(ops, m0);
    list_push(ops, m1);
    return ops;
}
