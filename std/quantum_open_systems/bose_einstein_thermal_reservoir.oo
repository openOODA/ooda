// # Bose-Einstein Thermal Reservoir & Detailed Balance Statistics
//
// Logline: Computes thermal photon/phonon occupation numbers n_th(omega, T), emission/absorption rate ratios, and reservoir detailed balance constraints.
//
// Setup: Statistical equilibrium bosonic reservoir obeying Bose-Einstein distribution n_th = 1 / (exp(hbar omega / k_B T) - 1).
//
// Beats:
//   1. Construct thermal reservoir configuration with temperature and reference frequency.
//   2. Compute Bose-Einstein average occupancy n_th(omega, T).
//   3. Enforce detailed balance ratio gamma_up / gamma_down = exp(-hbar omega / k_B T).

pub type ThermalReservoir = struct {
    temperature_kelvin: Float,
    boltzmann_kb: Float,
    planck_hbar: Float
};

pub fn thermal_reservoir_cryogenic() -> ThermalReservoir {
    return ThermalReservoir {
        temperature_kelvin: 0.020,
        boltzmann_kb: 1.380649,
        planck_hbar: 1.054571
    };
}

pub fn bose_einstein_occupation(res: ThermalReservoir, freq_ghz: Float) -> Float {
    let t_k: Float = res.temperature_kelvin;
    if t_k <= 0.0001 {
        return 0.0;
    }
    let x: Float = (0.0479924 * freq_ghz) / t_k;
    if x > 50.0 {
        return 0.0;
    }
    let exp_x: Float = exp(x);
    if exp_x <= 1.0000001 {
        return 10000.0;
    }
    return 1.0 / (exp_x - 1.0);
}

pub type Complex = struct {
    real: Float,
    imag: Float
};

pub fn detailed_balance_rates(res: ThermalReservoir, freq_ghz: Float, gamma_0: Float) -> Complex {
    let nth: Float = bose_einstein_occupation(res, freq_ghz);
    let gamma_down: Float = gamma_0 * (nth + 1.0);
    let gamma_up: Float = gamma_0 * nth;
    return Complex { real: gamma_down, imag: gamma_up };
}
