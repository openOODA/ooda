// # Nakajima-Zwanzig Projection Operator & Memory Kernel Dynamics
//
// Logline: Implements generalized master equations with time-nonlocal memory kernels K(t - tau) and projected relevant subspace evolution.
//
// Setup: Non-Markovian open system dynamics capturing environmental memory retention and non-exponential decay.
//
// Beats:
//   1. Construct exponential memory kernel parameters with memory time tau_m and coupling strength g.
//   2. Convolve historical system trajectories with memory kernel K(t - tau).
//   3. Compute non-Markovian population evolution with backflow of information.

pub type MemoryKernelParams = struct {
    coupling_strength: Float,
    memory_time: Float,
    oscillation_freq: Float,
};

pub fn memory_kernel_params_new(g: Float, tau_m: Float, omega: Float) -> MemoryKernelParams {
    return MemoryKernelParams {
        coupling_strength: g,
        memory_time: tau_m,
        oscillation_freq: omega,
    };
}

pub fn nakajima_exponential_kernel_eval(k: MemoryKernelParams, delta_t: Float) -> Float {
    if delta_t < 0.0 {
        return 0.0;
    }
    let tau_m: Float = k.memory_time;
    let decay: Float = exp(0.0 - (delta_t / tau_m));
    let osc: Float = cos(k.oscillation_freq * delta_t);
    return k.coupling_strength * decay * osc;
}

pub type NonMarkovianHistoryState = struct {
    p0: Float,
    p1: Float,
    t: Float,
};

pub fn nakajima_non_markovian_step(
    p0_history: List[Float],
    time_history: List[Float],
    curr_p0: Float,
    kernel: MemoryKernelParams,
    dt: Float
) -> Float {
    let hist_len: Int = list_len(p0_history);
    let mut memory_integral: Float = 0.0;
    let hist_len_f: Float = hist_len as Float;

    let mut i: Int = 0;
    while i < hist_len {
        let t_past: Float = list_get(time_history, i);
        let p_past: Float = list_get(p0_history, i);
        let delta_t: Float = (dt * hist_len_f) - t_past;
        let k_val: Float = nakajima_exponential_kernel_eval(kernel, delta_t);
        memory_integral = memory_integral + (k_val * (p_past - 0.5) * dt);
        i = i + 1;
    }

    let next_p0: Float = curr_p0 - (memory_integral * dt);
    if next_p0 > 1.0 {
        return 1.0;
    }
    if next_p0 < 0.0 {
        return 0.0;
    }
    return next_p0;
}
