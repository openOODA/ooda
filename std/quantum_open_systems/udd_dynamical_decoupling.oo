// # Uhrig Dynamical Decoupling (UDD) Optimal Timing Sequences
//
// Logline: Implements Uhrig non-equispaced pi-pulse sequences t_j = T sin^2(pi j / (2(N + 1))) designed to cancel high-order bath noise spectra.
//
// Setup: Non-equispaced analytical pulse timings suppressing noise moments up to order N with N pulses.
//
// Beats:
//   1. Construct UDD sequence specification (total time T, order N).
//   2. Compute exact Uhrig pulse time fractions s_j = sin^2(pi j / (2(N + 1))).
//   3. Generate complete pulse timing schedule list.

pub type UddSequence = struct {
    total_time_us: Float,
    order_n: Int,
};

pub fn udd_sequence_new(total_t: Float, n: Int) -> UddSequence {
    return UddSequence {
        total_time_us: total_t,
        order_n: n,
    };
}

pub fn udd_pulse_fraction(j: Int, n: Int) -> Float {
    let j_f: Float = (j as Float);
    let n_plus_1: Int = n + 1;
    let n_plus_1_f: Float = (n_plus_1 as Float);
    let pi_val: Float = 3.141592653589793;

    let arg: Float = (pi_val * j_f) / (2.0 * n_plus_1_f);
    let s: Float = sin(arg);
    return s * s;
}

pub fn udd_pulse_timestamp(seq: UddSequence, pulse_index: Int) -> Float {
    let t: Float = seq.total_time_us;
    let n: Int = seq.order_n;
    let frac: Float = udd_pulse_fraction(pulse_index, n);
    return t * frac;
}

pub fn udd_schedule_generate(seq: UddSequence) -> List[Float] {
    let mut times: List[Float] = list_new();
    let n: Int = seq.order_n;
    let mut j: Int = 1;
    while j <= n {
        let t_j: Float = udd_pulse_timestamp(seq, j);
        list_push(times, t_j);
        j = j + 1;
    }
    return times;
}
