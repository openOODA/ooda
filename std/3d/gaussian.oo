// # 3D Gaussian Splatting Facade
//
// Logline: Re-exports 3D Gaussian primitives, point cloud structures, splat rendering, and optimization stubs.
//
// Setup: Pure module shim importing gaussian_ops, gaussian_push, gaussian_render, and gaussian_stubs.
//
// Beats:
//   1. Import 3D Gaussian operations, push split dispatchers, renderers, and stubs.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream Gaussian splatting consumers.

import "./gaussian_ops.oo";
import "./gaussian_stubs.oo";

pub fn shim_marker_identity() -> Gaussian3D {
    return gaussian3d_identity();
}

pub fn shim_marker_cloud_new() -> GaussianCloud {
    return gaussian_cloud_new();
}

pub fn shim_marker_cloud_count(c: GaussianCloud) -> Int {
    return gaussian_cloud_count(c);
}

pub fn shim_marker_sample_new() -> GaussianSample {
    return gaussian_sample_new();
}

pub fn shim_marker_fit_result() -> GaussianFitResult {
    return gaussian_fit_result_new(0, 0, 0);
}

pub fn shim_marker_ops_init() -> Gaussian3D {
    return gaussian_ops_init(0, 0, 0, 0);
}

pub fn shim_marker_push(c: GaussianCloud, s: Gaussian3D) -> GaussianCloud {
    let out: GaussianCloud = gaussian_cloud_push(c, s);
    return out;
}

pub fn shim_marker_rend_new(w: Int, h: Int) -> GaussRend {
    return gauss_rend_new(w, h);
}

pub fn shim_marker_prune(c: GaussianCloud) -> GaussianCloud {
    let out: GaussianCloud = gaussian_cloud_prune_opacity(c, 0);
    return out;
}

pub fn shim_marker_stubs() -> Int {
    return gaussian_stubs_marker();
}

pub fn gaussian_marker() -> Int {
    return 1;
}
