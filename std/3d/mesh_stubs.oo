// # 3D Mesh Hardware Stubs
//
// Logline: Provides fail-closed residual stubs for native GPU mesh rasterization.
//
// Setup: Pure hardware stub module importing mesh_types.oo.
//
// Beats:
//   1. Guard GPU backend rasterization and draw calls.
//   2. Enforce fail-closed termination on missing graphics FFI.
//   3. Protect memory bounds against unallocated vertex buffers.

import "./mesh_types.oo";

// Render the mesh to a graphics backend.
// Hard compiler limitation: openOODA has no FFI to graphics libraries
// (OpenGL, Vulkan, Metal, etc.) and no standard ABI for GPU calls.
pub fn mesh_render(m: &Mesh) {
    // COMPILER LIMITATION: No FFI or graphics API available in openOODA.
    process_exit(1);
}
