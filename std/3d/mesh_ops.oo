// # 3D Mesh Geometry Operations
//
// Logline: Implements vector arithmetic, triangle geometric queries, and mesh aggregate calculations.
//
// Setup: Pure geometric operations importing mesh_types.oo.
//
// Beats:
//   1. Implement Vector3 addition, subtraction, dot product, cross product, scaling, and length squared.
//   2. Compute Triangle translations, un-normalized normal vectors, centroids, and area squared.
//   3. Manage Mesh triangle registration, centroid accumulation, and translation.

import "./mesh_types.oo";

pub fn vector3_add(v1: Vector3, v2: Vector3) -> Vector3 {
    let x1: Int = v1.x;
    let y1: Int = v1.y;
    let z1: Int = v1.z;
    let x2: Int = v2.x;
    let y2: Int = v2.y;
    let z2: Int = v2.z;
    return Vector3 { x: x1 + x2, y: y1 + y2, z: z1 + z2 };
}

pub fn vector3_sub(v1: Vector3, v2: Vector3) -> Vector3 {
    let x1: Int = v1.x;
    let y1: Int = v1.y;
    let z1: Int = v1.z;
    let x2: Int = v2.x;
    let y2: Int = v2.y;
    let z2: Int = v2.z;
    return Vector3 { x: x1 - x2, y: y1 - y2, z: z1 - z2 };
}

pub fn vector3_dot(v1: Vector3, v2: Vector3) -> Int {
    let x1: Int = v1.x;
    let y1: Int = v1.y;
    let z1: Int = v1.z;
    let x2: Int = v2.x;
    let y2: Int = v2.y;
    let z2: Int = v2.z;
    return ((x1 * x2) + (y1 * y2)) + (z1 * z2);
}

pub fn vector3_cross(v1: Vector3, v2: Vector3) -> Vector3 {
    let x1: Int = v1.x;
    let y1: Int = v1.y;
    let z1: Int = v1.z;
    let x2: Int = v2.x;
    let y2: Int = v2.y;
    let z2: Int = v2.z;
    let nx: Int = (y1 * z2) - (z1 * y2);
    let ny: Int = (z1 * x2) - (x1 * z2);
    let nz: Int = (x1 * y2) - (y1 * x2);
    return Vector3 { x: nx, y: ny, z: nz };
}

pub fn vector3_scale(v: Vector3, s: Int) -> Vector3 {
    let x1: Int = v.x;
    let y1: Int = v.y;
    let z1: Int = v.z;
    return Vector3 { x: x1 * s, y: y1 * s, z: z1 * s };
}

pub fn vector3_length_squared(v: Vector3) -> Int {
    return vector3_dot(v, v);
}

pub fn vector3_neg(v: Vector3) -> Vector3 {
    let x1: Int = v.x;
    let y1: Int = v.y;
    let z1: Int = v.z;
    return Vector3 { x: 0 - x1, y: 0 - y1, z: 0 - z1 };
}

pub fn vector3_eq(v1: Vector3, v2: Vector3) -> Int {
    let x1: Int = v1.x;
    let y1: Int = v1.y;
    let z1: Int = v1.z;
    let x2: Int = v2.x;
    let y2: Int = v2.y;
    let z2: Int = v2.z;
    if x1 != x2 {
        return 0;
    }
    if y1 != y2 {
        return 0;
    }
    if z1 != z2 {
        return 0;
    }
    return 1;
}

pub fn triangle_translate(t: Triangle, dx: Int, dy: Int, dz: Int) -> Triangle {
    return Triangle {
        x1: t.x1 + dx,
        y1: t.y1 + dy,
        z1: t.z1 + dz,
        x2: t.x2 + dx,
        y2: t.y2 + dy,
        z2: t.z2 + dz,
        x3: t.x3 + dx,
        y3: t.y3 + dy,
        z3: t.z3 + dz
    };
}

pub fn triangle_normal(tri: Triangle) -> Vector3 {
    let a: Vector3 = vector3_new(tri.x1, tri.y1, tri.z1);
    let b: Vector3 = vector3_new(tri.x2, tri.y2, tri.z2);
    let c: Vector3 = vector3_new(tri.x3, tri.y3, tri.z3);
    let edge_a: Vector3 = vector3_sub(b, a);
    let edge_b: Vector3 = vector3_sub(c, a);
    return vector3_cross(edge_a, edge_b);
}

pub fn triangle_centroid(tri: Triangle) -> Vector3 {
    let cx: Int = ((tri.x1 + tri.x2) + tri.x3) / 3;
    let cy: Int = ((tri.y1 + tri.y2) + tri.y3) / 3;
    let cz: Int = ((tri.z1 + tri.z2) + tri.z3) / 3;
    return Vector3 { x: cx, y: cy, z: cz };
}

// Squared length of the surface normal — proportional to the squared area (|normal|^2 = (2*area)^2).
pub fn triangle_area_squared(tri: Triangle) -> Int {
    let n: Vector3 = triangle_normal(tri);
    return vector3_length_squared(n);
}

// Register a triangle with the mesh. By-value destub.
pub fn mesh_add_triangle(m: Mesh, tri: Triangle) -> Mesh {
    let c: Vector3 = triangle_centroid(tri);
    let cx: Int = c.x;
    let cy: Int = c.y;
    let cz: Int = c.z;
    let mid: Int = m.id;
    let n0: Int = m.n_tri;
    let sx: Int = m.centroid_x_sum;
    let sy: Int = m.centroid_y_sum;
    let sz: Int = m.centroid_z_sum;
    return Mesh {
        id: mid,
        n_tri: n0 + 1,
        centroid_x_sum: sx + cx,
        centroid_y_sum: sy + cy,
        centroid_z_sum: sz + cz
    };
}

pub fn mesh_get_triangle_count(m: Mesh) -> Int {
    return m.n_tri;
}

pub fn mesh_get_centroid(m: Mesh) -> Vector3 {
    let ntri: Int = m.n_tri;
    if ntri == 0 {
        return Vector3 { x: 0, y: 0, z: 0 };
    }
    let sx: Int = m.centroid_x_sum;
    let sy: Int = m.centroid_y_sum;
    let sz: Int = m.centroid_z_sum;
    return Vector3 { x: sx / ntri, y: sy / ntri, z: sz / ntri };
}

pub fn mesh_translate(m: Mesh, dx: Int, dy: Int, dz: Int) -> Mesh {
    let ntri: Int = m.n_tri;
    let mid: Int = m.id;
    let sx: Int = m.centroid_x_sum;
    let sy: Int = m.centroid_y_sum;
    let sz: Int = m.centroid_z_sum;
    return Mesh {
        id: mid,
        n_tri: ntri,
        centroid_x_sum: sx + (dx * ntri),
        centroid_y_sum: sy + (dy * ntri),
        centroid_z_sum: sz + (dz * ntri)
    };
}

pub fn mesh_clear(m: Mesh) -> Mesh {
    let mid: Int = m.id;
    return Mesh {
        id: mid,
        n_tri: 0,
        centroid_x_sum: 0,
        centroid_y_sum: 0,
        centroid_z_sum: 0
    };
}
