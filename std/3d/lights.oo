// # 3D Lighting Facade
//
// Logline: Re-exports 3D lighting types, engine mutators, color operations, attenuation equations, and hardware stubs.
//
// Setup: Pure module shim importing lights_types, lights_engine, lights_ops, and lights_stubs.
//
// Beats:
//   1. Import 3D light types, engine mutators, operations, and hardware probe stubs.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream 3D rendering consumers.

import "./lights_types.oo";
import "./lights_engine.oo";
import "./lights_ops.oo";
import "./lights_stubs.oo";

pub fn shim_marker_light_color_white() -> LightColor {
    return light_color_white();
}

pub fn shim_marker_ambient_light_default() -> AmbientLight {
    return ambient_light_default();
}

pub fn shim_marker_directional_light_default() -> DirectionalLight {
    return directional_light_default();
}

pub fn shim_marker_point_light_default() -> PointLight {
    return point_light_default();
}

pub fn shim_marker_spot_light_default() -> SpotLight {
    return spot_light_default();
}

pub fn shim_marker_sample_environment_probe() -> LightColor {
    return sample_environment_probe(0, 0, 0);
}
