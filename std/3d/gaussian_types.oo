type Gaussian3D = struct {
    cx: Int,
    cy: Int,
    cz: Int,
    opacity: Int
};

pub fn gaussian3d_new(cx: Int, cy: Int, cz: Int, opacity: Int) -> Gaussian3D {
    return Gaussian3D {
        cx: cx,
        cy: cy,
        cz: cz,
        opacity: opacity
    };
}

pub fn gaussian3d_opacity(g: Gaussian3D) -> Int {
    return g.opacity;
}

pub fn gaussian3d_identity() -> Gaussian3D {
    return gaussian3d_new(0, 0, 0, 0);
}

pub fn gaussian3d_set_opacity(g: Gaussian3D, op: Int) -> Gaussian3D {
    return Gaussian3D { cx: g.cx, cy: g.cy, cz: g.cz, opacity: op };
}

pub fn gaussian3d_translate(g: Gaussian3D, dx: Int, dy: Int, dz: Int) -> Gaussian3D {
    return Gaussian3D { cx: g.cx + dx, cy: g.cy + dy, cz: g.cz + dz, opacity: g.opacity };
}

pub fn gaussian3d_scale(g: Gaussian3D, factor: Int) -> Gaussian3D {
    return Gaussian3D { cx: g.cx, cy: g.cy, cz: g.cz, opacity: (g.opacity * factor) / 1000 };
}
