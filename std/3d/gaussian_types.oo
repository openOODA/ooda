// # 3D Gaussian types
//
// Logline: Gaussian3D destubbed off List[struct] cloud slots.
// residual: List[struct] destubbed.

type Gaussian3D = struct {
    cx: Int,
    cy: Int,
    cz: Int,
    opacity: Int
};

pub fn gaussian3d_new(cx: Int, cy: Int, cz: Int, opacity: Int) -> Gaussian3D {
    return Gaussian3D {
        cx: cx,
        cy: cy,
        cz: cz,
        opacity: opacity
    };
}

pub fn gaussian3d_opacity(g: Gaussian3D) -> Int {
    return g.opacity;
}
