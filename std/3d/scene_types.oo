// # 3D Scene Graph Data Types
//
// Logline: Scene destubbed off List[SceneNode] to Int counts (emit cannot lower List[struct]).
//
// Setup: Pure Int scene bookkeeping.
//
// Beats:
//   1. scene_new next_id 1 count 0.
//   2. scene_add increments count and next_id.
// residual: List[SceneNode] destubbed to count/next_id.

type Scene = struct {
    next_id: Int,
    count: Int
};

pub fn scene_new() -> Scene {
    return Scene {
        next_id: 1,
        count: 0
    };
}

pub fn scene_len(s: Scene) -> Int {
    return s.count;
}

pub fn scene_add(s: Scene) -> Scene {
    let nid: Int = s.next_id;
    let c: Int = s.count;
    return Scene {
        next_id: nid + 1,
        count: c + 1
    };
}
