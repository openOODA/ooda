// # Extended Reality (XR) Operations
//
// Logline: Implements pose kinematics, stereoscopic eye view transforms, frustum sizing, and session management.
//
// Setup: Pure XR operational routines importing xr_types.oo.
//
// Beats:
//   1. Perform XrPose spatial translation, transform combination, linear interpolation, and equality checks.
//   2. Compute stereoscopic left/right eye offsets, IPD shifts, and frustum extents.
//   3. Manage XrSession lifecycle state transitions and XrFrame view extractions.

import "./xr_types.oo";

// Translate a pose by a world-space delta (in millimetres).
pub fn xr_pose_translate(pose: XrPose, dx: Int, dy: Int, dz: Int) -> XrPose {
    return XrPose {
        x: (pose).x + dx,
        y: (pose).y + dy,
        z: (pose).z + dz,
    };
}

// Combine two poses by adding their positions.
pub fn xr_pose_combine(parent: XrPose, child: XrPose) -> XrPose {
    return XrPose {
        x: (parent).x + (child).x,
        y: (parent).y + (child).y,
        z: (parent).z + (child).z,
    };
}

// Linear interpolation between two poses.
// t is in the range [0, 255] where 0 = fully a, 255 = fully b.
pub fn xr_pose_lerp(pos_a: XrPose, pos_b: XrPose, t: Int) -> XrPose {
    let inv_t: Int = 255 - t;
    let px: Int = (((pos_a).x * inv_t) + ((pos_b).x * t)) / 255;
    let py: Int = (((pos_a).y * inv_t) + ((pos_b).y * t)) / 255;
    let pz: Int = (((pos_a).z * inv_t) + ((pos_b).z * t)) / 255;
    return XrPose {
        x: px,
        y: py,
        z: pz,
    };
}

// Returns 1 if both poses have identical position.
pub fn xr_pose_equal(pos_a: XrPose, pos_b: XrPose) -> Int {
    if (pos_a).x == (pos_b).x {
        if (pos_a).y == (pos_b).y {
            if (pos_a).z == (pos_b).z {
                return 1;
            }
        }
    }
    return 0;
}

// Returns the left-eye view for a stereoscopic session.
// The left eye is offset by half the IPD in the negative X direction.
pub fn xr_view_left(head_pose: XrPose, fov: Int, ipd_mm: Int) -> XrView {
    let half_ipd: Int = ipd_mm / 2;
    let eye_pos: XrPose = xr_pose_translate(head_pose, 0 - half_ipd, 0, 0);
    return XrView {
        pose: eye_pos,
        fov: fov,
        eye_index: 0,
    };
}

// Returns the right-eye view for a stereoscopic session.
// The right eye is offset by half the IPD in the positive X direction.
pub fn xr_view_right(head_pose: XrPose, fov: Int, ipd_mm: Int) -> XrView {
    let half_ipd: Int = ipd_mm / 2;
    let eye_pos: XrPose = xr_pose_translate(head_pose, half_ipd, 0, 0);
    return XrView {
        pose: eye_pos,
        fov: fov,
        eye_index: 1,
    };
}

// Returns 1 if this view is for the left eye, 0 otherwise.
pub fn xr_view_is_left_eye(view: XrView) -> Int {
    if (view).eye_index == 0 {
        return 1;
    }
    return 0;
}

// Returns the horizontal extent of the view frustum at a given depth.
pub fn xr_view_frustum_half_width(view: XrView, depth_mm: Int) -> Int {
    let half_fov: Int = (view).fov / 2;
    return (depth_mm * half_fov) / 114591;
}

pub fn xr_session_start(session: XrSession) -> XrSession {
    return XrSession {
        id: (session).id,
        active: 1,
        fov: (session).fov,
        ipd_mm: (session).ipd_mm,
    };
}

pub fn xr_session_stop(session: XrSession) -> XrSession {
    return XrSession {
        id: (session).id,
        active: 0,
        fov: (session).fov,
        ipd_mm: (session).ipd_mm,
    };
}

// Returns 1 if the session is currently active, 0 otherwise.
pub fn xr_session_is_active(session: XrSession) -> Int {
    if (session).active == 1 {
        return 1;
    }
    return 0;
}

// Update the default FOV for the session (in millidegrees).
pub fn xr_session_set_fov(session: XrSession, fov: Int) -> XrSession {
    return XrSession {
        id: (session).id,
        active: (session).active,
        fov: fov,
        ipd_mm: (session).ipd_mm,
    };
}

// Update the IPD for the session (in millimetres).
pub fn xr_session_set_ipd(session: XrSession, ipd_mm: Int) -> XrSession {
    return XrSession {
        id: (session).id,
        active: (session).active,
        fov: (session).fov,
        ipd_mm: ipd_mm,
    };
}

// Returns the number of active views for the session.
pub fn xr_get_views(session: XrSession) -> Int {
    if (session).active == 1 {
        return 2;
    }
    return 0;
}

// Retrieve the left-eye XrView from a frame.
pub fn xr_frame_left_view(frame: XrFrame, fov: Int, ipd_mm: Int) -> XrView {
    return xr_view_left((frame).head_pose, fov, ipd_mm);
}

// Retrieve the right-eye XrView from a frame.
pub fn xr_frame_right_view(frame: XrFrame, fov: Int, ipd_mm: Int) -> XrView {
    return xr_view_right((frame).head_pose, fov, ipd_mm);
}

// Returns 1 if the frame has renderable views (i.e. session was active).
pub fn xr_frame_has_views(frame: XrFrame) -> Int {
    if (frame).view_count > 0 {
        return 1;
    }
    return 0;
}
