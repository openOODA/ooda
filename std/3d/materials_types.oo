// # 3D Materials & Color Data Types
//
// Logline: RGBA Color constructors. Destubbed off pub type so emit-c can lower.
//
// Setup: Pure Int channel structs.
//
// Beats:
//   1. color_new / color_red / color_black.
// residual: PBR Material nested structs destubbed; this is Color only.

type Color = struct {
    r: Int,
    g: Int,
    b: Int,
    a: Int
};

pub fn color_new(rv: Int, gv: Int, bv: Int, av: Int) -> Color {
    return Color {
        r: rv,
        g: gv,
        b: bv,
        a: av
    };
}

pub fn color_black() -> Color {
    return Color { r: 0, g: 0, b: 0, a: 255 };
}

pub fn color_white() -> Color {
    return Color { r: 255, g: 255, b: 255, a: 255 };
}

pub fn color_red() -> Color {
    return Color { r: 255, g: 0, b: 0, a: 255 };
}

pub fn color_green() -> Color {
    return Color { r: 0, g: 255, b: 0, a: 255 };
}

pub fn color_blue() -> Color {
    return Color { r: 0, g: 0, b: 255, a: 255 };
}
