// # Spatial Audio Facade
//
// Logline: Re-exports 3D audio emitter sources, listeners, spatialization algorithms, panning, and audio stubs.
//
// Setup: Pure module shim importing spatial_audio_types, spatial_audio_ops, and spatial_audio_stubs.
//
// Beats:
//   1. Import spatial audio types, operations, and hardware stubs.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream audio rendering pipelines.

import "./spatial_audio_types.oo";
import "./spatial_audio_ops.oo";
import "./spatial_audio_stubs.oo";

pub fn shim_marker_source_new() -> AudioSource {
    return source_new(0, 0, 0, 1000);
}

pub fn shim_marker_listener_new() -> AudioListener {
    return listener_new(0, 0, 0);
}

pub fn shim_marker_spatialize(src: AudioSource, lis: AudioListener) -> SpatialAudioFrame {
    return spatialize(src, lis);
}

pub fn shim_marker_frame_silence() -> SpatialAudioFrame {
    return frame_silence();
}
