// # 3D Materials Facade
//
// Logline: Re-exports 3D Color and PBR Material data types, presets, blending operations, and light interaction equations.
//
// Setup: Pure module shim importing materials_types and materials_ops.
//
// Beats:
//   1. Import Color and Material types, presets, and color calculation routines.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream 3D rendering consumers.

import "./materials_types.oo";
import "./materials_ops.oo";

type Material = struct {
    albedo: Color,
    roughness: Int,
    metallic: Int,
};

pub fn material_new(albedo: Color, roughness: Int, metallic: Int) -> Material {
    return Material {
        albedo: albedo,
        roughness: roughness,
        metallic: metallic,
    };
}

pub fn color_blend(col_a: Color, col_b: Color, t: Int) -> Color {
    let inv_t: Int = 255 - t;
    let r: Int = (((col_a).r * inv_t) + ((col_b).r * t)) / 255;
    let g: Int = (((col_a).g * inv_t) + ((col_b).g * t)) / 255;
    let bl: Int = (((col_a).b * inv_t) + ((col_b).b * t)) / 255;
    let al: Int = (((col_a).a * inv_t) + ((col_b).a * t)) / 255;
    return Color { r: r, g: g, b: bl, a: al };
}

pub fn material_default() -> Material {
    return Material {
        albedo: color_white(),
        roughness: 128,
        metallic: 0,
    };
}

pub fn material_mirror() -> Material {
    return Material {
        albedo: color_white(),
        roughness: 0,
        metallic: 255,
    };
}

pub fn material_matte_black() -> Material {
    return Material {
        albedo: color_black(),
        roughness: 255,
        metallic: 0,
    };
}

pub fn material_blend(mat_a: Material, mat_b: Material, t: Int) -> Material {
    let c: Color = color_blend((mat_a).albedo, (mat_b).albedo, t);
    let inv_t: Int = 255 - t;
    let rough: Int = (((mat_a).roughness * inv_t) + ((mat_b).roughness * t)) / 255;
    let metal: Int = (((mat_a).metallic * inv_t) + ((mat_b).metallic * t)) / 255;
    return Material {
        albedo: c,
        roughness: rough,
        metallic: metal,
    };
}

pub fn shim_marker_color_white() -> Color {
    return color_white();
}

pub fn shim_marker_color_black() -> Color {
    return color_black();
}

pub fn shim_marker_material_default() -> Material {
    return material_default();
}

pub fn shim_marker_material_mirror() -> Material {
    return material_mirror();
}

pub fn shim_marker_color_blend() -> Color {
    return color_blend(color_black(), color_white(), 128);
}

pub fn shim_marker_material_blend() -> Material {
    return material_blend(material_default(), material_matte_black(), 128);
}

pub fn materials_marker() -> Int {
    return 1;
}
