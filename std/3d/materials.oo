// # 3D Materials Facade
//
// Logline: Re-exports 3D Color and PBR Material data types, presets, blending operations, and light interaction equations.
//
// Setup: Pure module shim importing materials_types and materials_ops.
//
// Beats:
//   1. Import Color and Material types, presets, and color calculation routines.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream 3D rendering consumers.

import "./materials_types.oo";
import "./materials_ops.oo";

pub fn shim_marker_color_white() -> Color {
    return color_white();
}

pub fn shim_marker_color_black() -> Color {
    return color_black();
}

pub fn shim_marker_material_default() -> Material {
    return material_default();
}

pub fn shim_marker_material_mirror() -> Material {
    return material_mirror();
}

pub fn shim_marker_color_blend() -> Color {
    return color_blend(color_black(), color_white(), 128);
}

pub fn shim_marker_material_blend() -> Material {
    return material_blend(material_default(), material_matte_black(), 128);
}
