// residual: List[struct] destubbed to Int floor.

type AudioSource = struct {
    x: Int,
    y: Int,
    z: Int,
    volume: Int
};

pub fn audio_source_new(x: Int, y: Int, z: Int, volume: Int) -> AudioSource {
    return AudioSource {
        x: x,
        y: y,
        z: z,
        volume: volume
    };
}

pub fn audio_source_volume(s: AudioSource) -> Int {
    return s.volume;
}
