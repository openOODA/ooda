type MatOp = struct {
    albedo: Int,
    rough: Int
};

pub fn mat_op_new(albedo: Int, rough: Int) -> MatOp {
    return MatOp { albedo: albedo, rough: rough };
}

pub fn mat_op_albedo(op: MatOp) -> Int {
    return op.albedo;
}

pub fn mat_op_rough(op: MatOp) -> Int {
    return op.rough;
}
