// # 3D Lighting Data Types
//
// Logline: RGBA LightColor constructors. Destubbed off pub type / nested lights.
//
// Setup: Pure Int channel structs.
//
// Beats:
//   1. light_color_new / light_color_white.
// residual: nested Ambient/Point/Spot destubbed; emit pub type.

type LightColor = struct {
    r: Int,
    g: Int,
    b: Int,
    a: Int
};

pub fn light_color_new(r: Int, g: Int, b: Int, a: Int) -> LightColor {
    return LightColor {
        r: r,
        g: g,
        b: b,
        a: a
    };
}

pub fn light_color_white() -> LightColor {
    return LightColor { r: 255, g: 255, b: 255, a: 255 };
}

pub fn light_color_black() -> LightColor {
    return LightColor { r: 0, g: 0, b: 0, a: 255 };
}
