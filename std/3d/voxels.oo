// # 3D Voxel Primitives
//
// Logline: Defines a single Voxel and provides constructors, density clamp, and 6-face adjacency tests.
//
// Setup: Flat Int struct. Public front for the voxel module; grid store lives in voxels_core.oo.
//
// Beats:
//   1. Construct voxels; clamp density; test cardinal adjacency.
//   2. clamp helper rebuilds a Voxel with bounded density.

type Voxel = struct {
    x: Int,
    y: Int,
    z: Int,
    material_id: Int,
    density: Int
};

pub fn voxel_new(x: Int, y: Int, z: Int, material_id: Int, density: Int) -> Voxel {
    return Voxel {
        x: x,
        y: y,
        z: z,
        material_id: material_id,
        density: density
    };
}

pub fn voxel_is_solid(v: Voxel) -> Int {
    if v.density > 0 {
        return 1;
    }
    return 0;
}

pub fn voxel_same_material(a: Voxel, b: Voxel) -> Int {
    if a.material_id == b.material_id {
        return 1;
    }
    return 0;
}

pub fn voxel_clamped_density(v: Voxel, max_density: Int) -> Int {
    if v.density < 0 {
        return 0;
    }
    if v.density > max_density {
        return max_density;
    }
    return v.density;
}

pub fn voxel_is_adjacent(a: Voxel, b: Voxel) -> Int {
    let ax: Int = a.x;
    let ay: Int = a.y;
    let az: Int = a.z;
    let bx: Int = b.x;
    let by: Int = b.y;
    let bz: Int = b.z;
    let dx: Int = ax - bx;
    let dy: Int = ay - by;
    let dz: Int = az - bz;
    let mut adx: Int = dx;
    let mut ady: Int = dy;
    let mut adz: Int = dz;
    if dx < 0 {
        adx = 0 - dx;
    }
    if dy < 0 {
        ady = 0 - dy;
    }
    if dz < 0 {
        adz = 0 - dz;
    }
    if adx == 1 {
        if ady == 0 {
            if adz == 0 {
                return 1;
            }
        }
    }
    if adx == 0 {
        if ady == 1 {
            if adz == 0 {
                return 1;
            }
        }
    }
    if adx == 0 {
        if ady == 0 {
            if adz == 1 {
                return 1;
            }
        }
    }
    return 0;
}

pub fn voxel_clamp(v: Voxel, max_density: Int) -> Voxel {
    let clamped: Int = voxel_clamped_density(v, max_density);
    return Voxel {
        x: v.x,
        y: v.y,
        z: v.z,
        material_id: v.material_id,
        density: clamped
    };
}
