// # 3D Gaussian Cloud Push (Slots 0..7)
//
// Logline: Inserts 3D Gaussians into low-index fixed slots 0 through 7 of a GaussianCloud.
//
// Setup: Unrolled slot insertion logic importing gaussian_cloud.oo.
//
// Beats:
//   1. Check GaussianCloud count and match active slot indices 0 through 7.
//   2. Allocate splat into indexed field without dynamic memory reallocation.
//   3. Preserve unassigned placeholder splats across untouched slots.

import "./gaussian_cloud.oo";

// Cloud push — slots 0..7 (split from monofile unrolled push for <=256 limit)
pub fn gaussian_cloud_push_lo(cloud: GaussianCloud, splat: Gaussian3D) -> GaussianCloud {
    let n: Int = gaussian_cloud_count(cloud);

    // Slot 0
    if n == 0 {
        return GaussianCloud {
            count: 1,
            capacity: cloud.capacity,
            g0: splat,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 1
    if n == 1 {
        return GaussianCloud {
            count: 2,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: splat,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 2
    if n == 2 {
        return GaussianCloud {
            count: 3,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: splat,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 3
    if n == 3 {
        return GaussianCloud {
            count: 4,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: splat,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 4
    if n == 4 {
        return GaussianCloud {
            count: 5,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: splat,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 5
    if n == 5 {
        return GaussianCloud {
            count: 6,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: splat,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 6
    if n == 6 {
        return GaussianCloud {
            count: 7,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: splat,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 7
    if n == 7 {
        return GaussianCloud {
            count: 8,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: splat,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // n >= 8: leave for push_hi
    return cloud;
}
