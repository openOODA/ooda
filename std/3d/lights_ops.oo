// # Lighting ops
//
// Logline: LightOp destubbed off nested LightColor ops.
// residual: List[struct] destubbed to Int floor.

type LightOp = struct {
    kind: Int,
    intensity: Int
};

pub fn light_op_new(kind: Int, intensity: Int) -> LightOp {
    return LightOp { kind: kind, intensity: intensity };
}

pub fn light_op_intensity(op: LightOp) -> Int {
    return op.intensity;
}
