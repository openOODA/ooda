// # 3D Gaussian Cloud Dispatcher & Field Accessors
//
// Logline: Dispatches GaussianCloud push operations across low/high partitions and indexes splat elements.
//
// Setup: Pure routing module importing gaussian_push_lo and gaussian_push_hi.
//
// Beats:
//   1. Dispatch splat insertions between low and high partitions based on occupancy count.
//   2. Access splat elements by integer index 0 through 15.
//   3. Return identity fallback Gaussian for out-of-bounds queries.

import "./gaussian_push_lo.oo";
import "./gaussian_push_hi.oo";

pub fn gaussian_cloud_push(cloud: GaussianCloud, splat: Gaussian3D) -> GaussianCloud {
    let n: Int = gaussian_cloud_count(cloud);
    if n < 8 {
        return gaussian_cloud_push_lo(cloud, splat);
    }
    return gaussian_cloud_push_hi(cloud, splat);
}

// ===================================================================
// GaussianCloud — per-splat field accessors (by index 0..15)
// ===================================================================

// Return a Gaussian from the cloud by index.
// For indices out of range, returns the identity Gaussian.
pub fn gaussian_cloud_get(cloud: GaussianCloud, idx: Int) -> Gaussian3D {
    if idx == 0  { return cloud.g0;  }
    if idx == 1  { return cloud.g1;  }
    if idx == 2  { return cloud.g2;  }
    if idx == 3  { return cloud.g3;  }
    if idx == 4  { return cloud.g4;  }
    if idx == 5  { return cloud.g5;  }
    if idx == 6  { return cloud.g6;  }
    if idx == 7  { return cloud.g7;  }
    if idx == 8  { return cloud.g8;  }
    if idx == 9  { return cloud.g9;  }
    if idx == 10 { return cloud.g10; }
    if idx == 11 { return cloud.g11; }
    if idx == 12 { return cloud.g12; }
    if idx == 13 { return cloud.g13; }
    if idx == 14 { return cloud.g14; }
    if idx == 15 { return cloud.g15; }
    return gaussian3d_identity();
}
