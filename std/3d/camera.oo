// # 3D Camera Primitives
//
// Logline: Integer camera config, move, and depth project. Destubbed off &mut / pub type.
//
// Setup: Pure integer camera. Emit cannot lower pub type or &mut.
//
// Beats:
//   1. Construct camera from FOV/aspect.
//   2. Move and query position.
//   3. Project world z to camera-space depth.
// residual: &mut / frustum float destubbed; this is by-value Int structs.

type CameraConfig = struct {
    fov: Int,
    near_plane: Int,
    far_plane: Int,
    aspect_ratio: Int
};

type Camera = struct {
    fov: Int,
    near_plane: Int,
    far_plane: Int,
    aspect_ratio: Int,
    x: Int,
    y: Int,
    z: Int,
    pitch: Int,
    yaw: Int,
    roll: Int
};

pub fn init_camera_config(fov: Int, aspect_ratio: Int) -> CameraConfig {
    return CameraConfig {
        fov: fov,
        near_plane: 1,
        far_plane: 1000,
        aspect_ratio: aspect_ratio
    };
}

pub fn create_camera(config: CameraConfig) -> Camera {
    let fov: Int = config.fov;
    let near_plane: Int = config.near_plane;
    let far_plane: Int = config.far_plane;
    let aspect_ratio: Int = config.aspect_ratio;
    return Camera {
        fov: fov,
        near_plane: near_plane,
        far_plane: far_plane,
        aspect_ratio: aspect_ratio,
        x: 0,
        y: 0,
        z: 0,
        pitch: 0,
        yaw: 0,
        roll: 0
    };
}

pub fn camera_move(cam: Camera, dx: Int, dy: Int, dz: Int) -> Camera {
    let cx: Int = cam.x;
    let cy: Int = cam.y;
    let cz: Int = cam.z;
    return Camera {
        fov: cam.fov,
        near_plane: cam.near_plane,
        far_plane: cam.far_plane,
        aspect_ratio: cam.aspect_ratio,
        x: cx + dx,
        y: cy + dy,
        z: cz + dz,
        pitch: cam.pitch,
        yaw: cam.yaw,
        roll: cam.roll
    };
}

pub fn camera_get_position_z(cam: Camera) -> Int {
    return cam.z;
}

pub fn camera_project(cam: Camera, px: Int, py: Int, pz: Int) -> Int {
    let cz: Int = cam.z;
    return pz - cz;
}
