// # 3D Voxel Grid Store Operations
//
// Logline: Two-slot grid store with row-major index, capacity, in-bounds, and set/get by coordinate.
//
// Setup: Flat Int grid struct with s0_/s1_ slot fields. Destubbed off &mut / pub type / nested Vector3.
//
// Beats:
//   1. voxel_grid_new, voxel_grid_capacity, voxel_grid_in_bounds.
//   2. voxel_grid_index: row-major = x + w*(y + h*z).
//   3. voxel_grid_slot_match, write_slot0, write_slot1, set_voxel, get_voxel.
//   4. is_empty and width/height/depth getters.
//   5. voxel_grid_coords_from_index: inverse of voxel_grid_index.

import "./voxels_types.oo";

type VoxelGrid = struct {
    width: Int,
    height: Int,
    depth: Int,
    s0_x: Int,
    s0_y: Int,
    s0_z: Int,
    s0_mat: Int,
    s0_den: Int,
    s0_occ: Int,
    s1_x: Int,
    s1_y: Int,
    s1_z: Int,
    s1_mat: Int,
    s1_den: Int,
    s1_occ: Int
};

pub fn voxel_grid_new(width: Int, height: Int, depth: Int) -> VoxelGrid {
    return VoxelGrid {
        width: width,
        height: height,
        depth: depth,
        s0_x: 0,
        s0_y: 0,
        s0_z: 0,
        s0_mat: 0,
        s0_den: 0,
        s0_occ: 0,
        s1_x: 0,
        s1_y: 0,
        s1_z: 0,
        s1_mat: 0,
        s1_den: 0,
        s1_occ: 0
    };
}

pub fn voxel_grid_capacity(grid: VoxelGrid) -> Int {
    return (grid.width * grid.height) * grid.depth;
}

pub fn voxel_grid_in_bounds(grid: VoxelGrid, x: Int, y: Int, z: Int) -> Int {
    if x < 0 {
        return 0;
    }
    if y < 0 {
        return 0;
    }
    if z < 0 {
        return 0;
    }
    if x >= grid.width {
        return 0;
    }
    if y >= grid.height {
        return 0;
    }
    if z >= grid.depth {
        return 0;
    }
    return 1;
}

pub fn voxel_grid_index(grid: VoxelGrid, x: Int, y: Int, z: Int) -> Int {
    let inside: Int = voxel_grid_in_bounds(grid, x, y, z);
    if inside == 0 {
        return 0 - 1;
    }
    return x + (grid.width * (y + (grid.height * z)));
}

pub fn voxel_grid_slot_match(occ: Int, sx: Int, sy: Int, sz: Int, x: Int, y: Int, z: Int) -> Int {
    if occ == 0 {
        return 0;
    }
    if sx == x {
        if sy == y {
            if sz == z {
                return 1;
            }
        }
    }
    return 0;
}

pub fn voxel_grid_write_slot0(grid: VoxelGrid, x: Int, y: Int, z: Int, material_id: Int, density: Int) -> VoxelGrid {
    return VoxelGrid {
        width: grid.width,
        height: grid.height,
        depth: grid.depth,
        s0_x: x,
        s0_y: y,
        s0_z: z,
        s0_mat: material_id,
        s0_den: density,
        s0_occ: 1,
        s1_x: grid.s1_x,
        s1_y: grid.s1_y,
        s1_z: grid.s1_z,
        s1_mat: grid.s1_mat,
        s1_den: grid.s1_den,
        s1_occ: grid.s1_occ
    };
}

pub fn voxel_grid_write_slot1(grid: VoxelGrid, x: Int, y: Int, z: Int, material_id: Int, density: Int) -> VoxelGrid {
    return VoxelGrid {
        width: grid.width,
        height: grid.height,
        depth: grid.depth,
        s0_x: grid.s0_x,
        s0_y: grid.s0_y,
        s0_z: grid.s0_z,
        s0_mat: grid.s0_mat,
        s0_den: grid.s0_den,
        s0_occ: grid.s0_occ,
        s1_x: x,
        s1_y: y,
        s1_z: z,
        s1_mat: material_id,
        s1_den: density,
        s1_occ: 1
    };
}

pub fn voxel_grid_set_voxel(grid: VoxelGrid, x: Int, y: Int, z: Int, material_id: Int, density: Int) -> VoxelGrid {
    let inside: Int = voxel_grid_in_bounds(grid, x, y, z);
    if inside == 0 {
        process_exit(1);
    }
    let match0: Int = voxel_grid_slot_match(grid.s0_occ, grid.s0_x, grid.s0_y, grid.s0_z, x, y, z);
    if match0 == 1 {
        return voxel_grid_write_slot0(grid, x, y, z, material_id, density);
    }
    let match1: Int = voxel_grid_slot_match(grid.s1_occ, grid.s1_x, grid.s1_y, grid.s1_z, x, y, z);
    if match1 == 1 {
        return voxel_grid_write_slot1(grid, x, y, z, material_id, density);
    }
    if grid.s0_occ == 0 {
        return voxel_grid_write_slot0(grid, x, y, z, material_id, density);
    }
    if grid.s1_occ == 0 {
        return voxel_grid_write_slot1(grid, x, y, z, material_id, density);
    }
    return voxel_grid_write_slot0(grid, x, y, z, material_id, density);
}

pub fn voxel_grid_get_voxel(grid: VoxelGrid, x: Int, y: Int, z: Int) -> Voxel {
    let inside: Int = voxel_grid_in_bounds(grid, x, y, z);
    if inside == 0 {
        return voxel_new(x, y, z, 0, 0);
    }
    let match0: Int = voxel_grid_slot_match(grid.s0_occ, grid.s0_x, grid.s0_y, grid.s0_z, x, y, z);
    if match0 == 1 {
        return voxel_new(x, y, z, grid.s0_mat, grid.s0_den);
    }
    let match1: Int = voxel_grid_slot_match(grid.s1_occ, grid.s1_x, grid.s1_y, grid.s1_z, x, y, z);
    if match1 == 1 {
        return voxel_new(x, y, z, grid.s1_mat, grid.s1_den);
    }
    return voxel_new(x, y, z, 0, 0);
}

pub fn voxel_grid_is_empty(grid: VoxelGrid) -> Int {
    if grid.width == 0 {
        return 1;
    }
    if grid.height == 0 {
        return 1;
    }
    if grid.depth == 0 {
        return 1;
    }
    return 0;
}

pub fn voxel_grid_width(grid: VoxelGrid) -> Int {
    return grid.width;
}

pub fn voxel_grid_height(grid: VoxelGrid) -> Int {
    return grid.height;
}

pub fn voxel_grid_depth(grid: VoxelGrid) -> Int {
    return grid.depth;
}

pub fn voxel_grid_coords_from_index(grid: VoxelGrid, index: Int) -> Voxel {
    let cap: Int = voxel_grid_capacity(grid);
    if index < 0 {
        return voxel_new(0, 0, 0, 0, 0);
    }
    if index >= cap {
        return voxel_new(0, 0, 0, 0, 0);
    }
    let w: Int = grid.width;
    let h: Int = grid.height;
    let layer: Int = index / (w * h);
    let rem: Int = index - (layer * (w * h));
    let row: Int = rem / w;
    let col: Int = rem - (row * w);
    return voxel_new(col, row, layer, 0, 0);
}
