// # 3D Math Primitives & Vectors
//
// Logline: Integer Vector3 arithmetic. Destubbed off pub type / SysCap so emit-c can lower.
//
// Setup: Pure 3D integer primitives.
//
// Beats:
//   1. Construct Vector3.
//   2. Add, subtract, dot, cross, length_squared.
// residual: SysCap math_init destubbed; this is List-free Int structs.

type Vector3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn vec3_new(x: Int, y: Int, z: Int) -> Vector3 {
    return Vector3 {
        x: x,
        y: y,
        z: z
    };
}

pub fn vec3_add(a: Vector3, b: Vector3) -> Vector3 {
    let ax: Int = a.x;
    let ay: Int = a.y;
    let az: Int = a.z;
    let bx: Int = b.x;
    let by: Int = b.y;
    let bz: Int = b.z;
    return Vector3 {
        x: ax + bx,
        y: ay + by,
        z: az + bz
    };
}

pub fn vec3_sub(a: Vector3, b: Vector3) -> Vector3 {
    let ax: Int = a.x;
    let ay: Int = a.y;
    let az: Int = a.z;
    let bx: Int = b.x;
    let by: Int = b.y;
    let bz: Int = b.z;
    return Vector3 {
        x: ax - bx,
        y: ay - by,
        z: az - bz
    };
}

pub fn vec3_dot(a: Vector3, b: Vector3) -> Int {
    let ax: Int = a.x;
    let ay: Int = a.y;
    let az: Int = a.z;
    let bx: Int = b.x;
    let by: Int = b.y;
    let bz: Int = b.z;
    return (ax * bx) + (ay * by) + (az * bz);
}

pub fn vec3_cross(a: Vector3, b: Vector3) -> Vector3 {
    let ax: Int = a.x;
    let ay: Int = a.y;
    let az: Int = a.z;
    let bx: Int = b.x;
    let by: Int = b.y;
    let bz: Int = b.z;
    return Vector3 {
        x: (ay * bz) - (az * by),
        y: (az * bx) - (ax * bz),
        z: (ax * by) - (ay * bx)
    };
}

pub fn vec3_length_squared(a: Vector3) -> Int {
    return vec3_dot(a, a);
}
