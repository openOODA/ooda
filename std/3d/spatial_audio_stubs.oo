// # Spatial Audio Hardware Stubs
//
// Logline: Provides fail-closed residual stubs for native PCM soundcard audio stream processing.
//
// Setup: Pure hardware stub module importing spatial_audio_types.oo.
//
// Beats:
//   1. Guard audio driver PCM stream submission and buffer filling.
//   2. Enforce fail-closed termination on missing audio hardware FFI.
//   3. Prevent unbounded buffer overrun on audio backend devices.

import "./spatial_audio_types.oo";

// process_audio: audio device output stub.
//
// COMPILER LIMITATION: openOODA has no FFI to audio system libraries
// (ALSA, PulseAudio, CoreAudio, etc.) and no OS syscall wrappers for
// /dev/snd or ioctl-based audio. Actual PCM sample output cannot be
// performed from pure openOODA code.
pub fn process_audio() {
    process_exit(1);
}
