// # Extended Reality (XR) Facade
//
// Logline: Re-exports XR pose tracking, stereoscopic views, runtime sessions, and frame pipeline operations.
//
// Setup: Pure module shim importing xr_types and xr_ops.
//
// Beats:
//   1. Import XR pose, view, session, and frame snapshot structures and operations.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream XR runtime callers.

import "./xr_types.oo";
import "./xr_ops.oo";

pub fn xr_pose_identity() -> XrPose {
    return xr_pose_new(0, 0, 0);
}

pub fn shim_marker_pose_identity() -> XrPose {
    return xr_pose_identity();
}

pub fn shim_marker_session_new() -> XrSession {
    return xr_session_new(0);
}

pub fn shim_marker_view_new(p: XrPose) -> XrView {
    return xr_view_new(p, 90000);
}

pub fn shim_marker_frame_new(s: XrSession, p: XrPose) -> XrFrame {
    return xr_frame_new(s, p, 0);
}

pub fn xr_types_facade() -> Int {
    return xr_types_marker();
}

pub fn xr_ops_marker() -> Int {
    return 1;
}

pub fn xr_marker() -> Int {
    return 1;
}
