type AudioOp = struct {
    gain: Int,
    pan: Int
};

pub fn audio_op_new(gain: Int, pan: Int) -> AudioOp {
    return AudioOp { gain: gain, pan: pan };
}

pub fn audio_op_gain(op: AudioOp) -> Int {
    return op.gain;
}
