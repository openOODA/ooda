// # 3D Scene Facade
//
// Logline: Re-exports 3D coordinate vectors, spatial transforms, scene nodes, and hierarchical scene graph operations.
//
// Setup: Pure module shim importing scene_types and scene_ops.
//
// Beats:
//   1. Import 3D Vector3, Transform, SceneNode, and Scene graph operations.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream 3D graphics callers.

import "./scene_types.oo";
import "./scene_ops.oo";

type Vector3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn vector3_new(x: Int, y: Int, z: Int) -> Vector3 {
    return Vector3 { x: x, y: y, z: z };
}

pub fn vector3_zero() -> Vector3 {
    return Vector3 { x: 0, y: 0, z: 0 };
}

type Transform = struct {
    position: Vector3,
    rotation: Vector3,
    scale: Vector3
};

pub fn transform_new(pos: Vector3, rot: Vector3, scl: Vector3) -> Transform {
    return Transform {
        position: pos,
        rotation: rot,
        scale: scl
    };
}

pub fn transform_identity() -> Transform {
    return Transform {
        position: vector3_zero(),
        rotation: vector3_zero(),
        scale: vector3_new(1, 1, 1)
    };
}

type SceneNode = struct {
    id: Int,
    parent_id: Int,
    transform: Transform
};

pub fn scene_node_new(id: Int, parent_id: Int, tf: Transform) -> SceneNode {
    return SceneNode {
        id: id,
        parent_id: parent_id,
        transform: tf
    };
}

pub fn shim_marker_vector3_zero() -> Vector3 {
    return vector3_zero();
}

pub fn shim_marker_transform_identity() -> Transform {
    return transform_identity();
}

pub fn shim_marker_scene_new() -> Scene {
    return scene_new();
}

pub fn shim_marker_scene_node_new() -> SceneNode {
    return scene_node_new(0, 0, transform_identity());
}

pub fn scene_types_marker() -> Int {
    return 1;
}

pub fn scene_ops_marker() -> Int {
    return 1;
}

pub fn scene_marker() -> Int {
    return 1;
}
