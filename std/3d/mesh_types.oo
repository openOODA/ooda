// # 3D Mesh & Geometry Data Types
//
// Logline: Integer Vector3 and Mesh bookkeeping. Destubbed trailing-comma / nested Triangle.
//
// Setup: Pure Int structs.
//
// Beats:
//   1. vector3_new.
//   2. mesh_new id and empty triangle_count.
// residual: Triangle list destubbed; emit trailing-comma struct init.

type Vector3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn vector3_new(x: Int, y: Int, z: Int) -> Vector3 {
    return Vector3 {
        x: x,
        y: y,
        z: z
    };
}

// Flattened triangle (nested Vector3 fields do not emit).
type Triangle = struct {
    x1: Int,
    y1: Int,
    z1: Int,
    x2: Int,
    y2: Int,
    z2: Int,
    x3: Int,
    y3: Int,
    z3: Int
};

pub fn triangle_new(v1: Vector3, v2: Vector3, v3: Vector3) -> Triangle {
    let ax: Int = v1.x;
    let ay: Int = v1.y;
    let az: Int = v1.z;
    let bx: Int = v2.x;
    let by: Int = v2.y;
    let bz: Int = v2.z;
    let cx: Int = v3.x;
    let cy: Int = v3.y;
    let cz: Int = v3.z;
    return Triangle {
        x1: ax,
        y1: ay,
        z1: az,
        x2: bx,
        y2: by,
        z2: bz,
        x3: cx,
        y3: cy,
        z3: cz
    };
}

type Mesh = struct {
    id: Int,
    n_tri: Int,
    centroid_x_sum: Int,
    centroid_y_sum: Int,
    centroid_z_sum: Int
};

pub fn mesh_new(id: Int) -> Mesh {
    return Mesh {
        id: id,
        n_tri: 0,
        centroid_x_sum: 0,
        centroid_y_sum: 0,
        centroid_z_sum: 0
    };
}
