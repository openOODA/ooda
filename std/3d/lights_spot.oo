// # Spot light setters
//
// Logline: Set enabled, direction, and position on a by-value SpotLight.
//
// Setup: SpotLight type lives in lights_engine.oo. No List[Float].
//
// Beats:
//   1. Copy the spot and write enabled.
//   2. Copy the spot and write direction or position.
//   3. Return the copied SpotLight.

import "./lights_engine.oo";

pub fn spot_light_set_enabled(mspot: SpotLight, enabled: Int) -> SpotLight {
    return SpotLight {
        r: mspot.r,
        g: mspot.g,
        b: mspot.b,
        a: mspot.a,
        intensity: mspot.intensity,
        x: mspot.x,
        y: mspot.y,
        z: mspot.z,
        dir_x: mspot.dir_x,
        dir_y: mspot.dir_y,
        dir_z: mspot.dir_z,
        radius: mspot.radius,
        inner_cos_255: mspot.inner_cos_255,
        outer_cos_255: mspot.outer_cos_255,
        cast_shadow: mspot.cast_shadow,
        enabled: enabled
    };
}

pub fn spot_light_set_direction(mspot: SpotLight, dx: Int, dy: Int, dz: Int) -> SpotLight {
    return SpotLight {
        r: mspot.r,
        g: mspot.g,
        b: mspot.b,
        a: mspot.a,
        intensity: mspot.intensity,
        x: mspot.x,
        y: mspot.y,
        z: mspot.z,
        dir_x: dx,
        dir_y: dy,
        dir_z: dz,
        radius: mspot.radius,
        inner_cos_255: mspot.inner_cos_255,
        outer_cos_255: mspot.outer_cos_255,
        cast_shadow: mspot.cast_shadow,
        enabled: mspot.enabled
    };
}

pub fn spot_light_set_position(mspot: SpotLight, x: Int, y: Int, z: Int) -> SpotLight {
    return SpotLight {
        r: mspot.r,
        g: mspot.g,
        b: mspot.b,
        a: mspot.a,
        intensity: mspot.intensity,
        x: x,
        y: y,
        z: z,
        dir_x: mspot.dir_x,
        dir_y: mspot.dir_y,
        dir_z: mspot.dir_z,
        radius: mspot.radius,
        inner_cos_255: mspot.inner_cos_255,
        outer_cos_255: mspot.outer_cos_255,
        cast_shadow: mspot.cast_shadow,
        enabled: mspot.enabled
    };
}
