// # 3D Voxel Density Clamp Helper
//
// Logline: Apply voxel_clamped_density to the density field and return a new Voxel struct.
//
// Setup: Imports voxels_types.oo.
//
// Beats:
//   1. voxel_clamp: clamp density to [0, max_density] and return new Voxel.

import "./voxels_types.oo";

pub fn voxel_clamp(v: Voxel, max_density: Int) -> Voxel {
    let clamped: Int = voxel_clamped_density(v, max_density);
    return Voxel {
        x: v.x,
        y: v.y,
        z: v.z,
        material_id: v.material_id,
        density: clamped
    };
}
