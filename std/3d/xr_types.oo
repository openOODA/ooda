// # XR types
//
// Logline: XrPose destubbed off nested Vector3 lists.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: List[struct] destubbed to Int pose.

type XrPose = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn xr_pose_new(x: Int, y: Int, z: Int) -> XrPose {
    return XrPose { x: x, y: y, z: z };
}

pub fn xr_pose_x(p: XrPose) -> Int {
    return p.x;
}

type XrSession = struct {
    id: Int,
    active: Int,
    fov: Int,
    ipd_mm: Int
};

pub fn xr_session_new(id: Int) -> XrSession {
    return XrSession {
        id: id,
        active: 1,
        fov: 90000,
        ipd_mm: 64
    };
}

type XrView = struct {
    pose: XrPose,
    fov: Int,
    eye_index: Int
};

pub fn xr_view_new(p: XrPose, fov: Int) -> XrView {
    return XrView {
        pose: p,
        fov: fov,
        eye_index: 0
    };
}

type XrFrame = struct {
    head_pose: XrPose,
    session_id: Int,
    view_count: Int
};

pub fn xr_frame_new(s: XrSession, p: XrPose, view_count: Int) -> XrFrame {
    return XrFrame {
        head_pose: p,
        session_id: (s).id,
        view_count: view_count
    };
}

pub fn xr_types_marker() -> Int {
    return 1;
}
