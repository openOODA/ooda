// # 3D Gaussian Cloud Push (Slots 8..15)
//
// Logline: Inserts 3D Gaussians into high-index fixed slots 8 through 15 of a GaussianCloud.
//
// Setup: Unrolled slot insertion logic importing gaussian_cloud.oo.
//
// Beats:
//   1. Check GaussianCloud count and match active slot indices 8 through 15.
//   2. Allocate splat into indexed field without dynamic memory reallocation.
//   3. Handle capacity boundary full conditions gracefully.

import "./gaussian_cloud.oo";

// Cloud push — slots 8..15
pub fn gaussian_cloud_push_hi(cloud: GaussianCloud, splat: Gaussian3D) -> GaussianCloud {
    let n: Int = gaussian_cloud_count(cloud);

    // Slot 8
    if n == 8 {
        return GaussianCloud {
            count: 9,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: splat,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 9
    if n == 9 {
        return GaussianCloud {
            count: 10,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: splat,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 10
    if n == 10 {
        return GaussianCloud {
            count: 11,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: splat,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 11
    if n == 11 {
        return GaussianCloud {
            count: 12,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: splat,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 12
    if n == 12 {
        return GaussianCloud {
            count: 13,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: splat,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 13
    if n == 13 {
        return GaussianCloud {
            count: 14,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: splat,
            g14: cloud.g14,
            g15: cloud.g15
        };
    }

    // Slot 14
    if n == 14 {
        return GaussianCloud {
            count: 15,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: splat,
            g15: cloud.g15
        };
    }

    // Slot 15
    if n == 15 {
        return GaussianCloud {
            count: 16,
            capacity: cloud.capacity,
            g0: cloud.g0,
            g1: cloud.g1,
            g2: cloud.g2,
            g3: cloud.g3,
            g4: cloud.g4,
            g5: cloud.g5,
            g6: cloud.g6,
            g7: cloud.g7,
            g8: cloud.g8,
            g9: cloud.g9,
            g10: cloud.g10,
            g11: cloud.g11,
            g12: cloud.g12,
            g13: cloud.g13,
            g14: cloud.g14,
            g15: splat
        };
    }

    // Cloud is full — return unchanged
    return cloud;
}
