// # 3D Gaussian Operations & Transforms
//
// Logline: Evaluates Mahalanobis density responses, color blending, spatial transformations, and bounding volumes.
//
// Setup: Pure geometric operations on Gaussian primitives importing gaussian_types.oo.
//
// Beats:
//   1. Evaluate Mahalanobis distance response and scalar density for 3D Gaussians.
//   2. Compute axis-aligned bounding boxes (AABB) from centroid and standard deviations.
//   3. Perform 3D translation, anisotropic scaling, and opacity modulation.

import "./gaussian_types.oo";

// ===================================================================
// Gaussian3D — evaluation and geometry
// ===================================================================

// Evaluate the scalar density of Gaussian g at world point (px, py, pz).
//
// Uses a diagonal covariance model (axis-aligned ellipsoid).
// Fixed-point Mahalanobis distance squared:
//   d2 = (dx^2 / sx) + (dy^2 / sy) + (dz^2 / sz)    [scaled by 1000]
//
// Density response = opacity * clamp(1000 - d2, 0, 1000) / 1000
// Returns a value in [0, 255].
pub fn gaussian3d_eval(g: Gaussian3D, px: Int, py: Int, pz: Int) -> Int {
    let dx = px - (g).cx;
    let dy = py - (g).cy;
    let dz = pz - (g).cz;

    let sx = (g).sx;
    let sy = (g).sy;
    let sz = (g).sz;

    // Guard against zero-scale (degenerate Gaussian)
    if sx <= 0 {
        return 0;
    }
    if sy <= 0 {
        return 0;
    }
    if sz <= 0 {
        return 0;
    }

    // Mahalanobis distance squared (fixed-point * 1000)
    let ex = (dx * dx * 1000) / sx;
    let ey = (dy * dy * 1000) / sy;
    let ez = (dz * dz * 1000) / sz;
    let dist2 = ex + ey + ez;

    // Linear falloff approximation of exp(-dist2 / 2000)
    let mut response = 1000 - dist2;
    if response < 0 {
        response = 0;
    }

    return ((g).opacity * response) / 1000;
}

// Returns 1 if world point (px, py, pz) lies within the 1-sigma
// ellipsoid of Gaussian g, 0 otherwise.
pub fn gaussian3d_contains(g: Gaussian3D, px: Int, py: Int, pz: Int) -> Int {
    let dx = px - (g).cx;
    let dy = py - (g).cy;
    let dz = pz - (g).cz;

    let sx = (g).sx;
    let sy = (g).sy;
    let sz = (g).sz;

    if sx <= 0 {
        return 0;
    }
    if sy <= 0 {
        return 0;
    }
    if sz <= 0 {
        return 0;
    }

    // Mahalanobis distance squared (fixed-point * 1000)
    let ex = (dx * dx * 1000) / sx;
    let ey = (dy * dy * 1000) / sy;
    let ez = (dz * dz * 1000) / sz;
    let dist2 = ex + ey + ez;

    // Inside if dist2 <= 1000 (i.e., <= 1.0 in world-space)
    if dist2 <= 1000 {
        return 1;
    }
    return 0;
}

// Compute the squared distance between two Gaussian centres.
// Returns dx^2 + dy^2 + dz^2 in fixed-point units squared.
pub fn gaussian3d_centre_dist_sq(a: Gaussian3D, b: Gaussian3D) -> Int {
    let dx = (a).cx - (b).cx;
    let dy = (a).cy - (b).cy;
    let dz = (a).cz - (b).cz;
    return dx * dx + dy * dy + dz * dz;
}

// Scale the Gaussian's spread by factor (fixed-point * 1000).
// E.g. factor = 2000 doubles the scale; factor = 500 halves it.
pub fn gaussian3d_scale(g: Gaussian3D, factor: Int) -> Gaussian3D {
    let new_sx = ((g).sx * factor) / 1000;
    let new_sy = ((g).sy * factor) / 1000;
    let new_sz = ((g).sz * factor) / 1000;
    return Gaussian3D {
        cx: (g).cx,
        cy: (g).cy,
        cz: (g).cz,
        sx: new_sx,
        sy: new_sy,
        sz: new_sz,
        r: (g).r,
        g: (g).g,
        b: (g).b,
        a: (g).a,
        opacity: (g).opacity,
        sh_r: (g).sh_r,
        sh_g: (g).sh_g,
        sh_b: (g).sh_b,
    };
}

// Translate the Gaussian centre by (dx, dy, dz) in fixed-point units.
pub fn gaussian3d_translate(g: Gaussian3D, dx: Int, dy: Int, dz: Int) -> Gaussian3D {
    return Gaussian3D {
        cx: (g).cx + dx,
        cy: (g).cy + dy,
        cz: (g).cz + dz,
        sx: (g).sx,
        sy: (g).sy,
        sz: (g).sz,
        r: (g).r,
        g: (g).g,
        b: (g).b,
        a: (g).a,
        opacity: (g).opacity,
        sh_r: (g).sh_r,
        sh_g: (g).sh_g,
        sh_b: (g).sh_b,
    };
}

// Set the opacity of a Gaussian and return the updated value.
pub fn gaussian3d_set_opacity(g: Gaussian3D, opacity: Int) -> Gaussian3D {
    return Gaussian3D {
        cx: (g).cx,
        cy: (g).cy,
        cz: (g).cz,
        sx: (g).sx,
        sy: (g).sy,
        sz: (g).sz,
        r: (g).r,
        g: (g).g,
        b: (g).b,
        a: (g).a,
        opacity: opacity,
        sh_r: (g).sh_r,
        sh_g: (g).sh_g,
        sh_b: (g).sh_b,
    };
}

// Set the RGBA colour of a Gaussian and return the updated value.
pub fn gaussian3d_set_color(g: Gaussian3D, r: Int, gr: Int, b: Int, a: Int) -> Gaussian3D {
    return Gaussian3D {
        cx: (g).cx,
        cy: (g).cy,
        cz: (g).cz,
        sx: (g).sx,
        sy: (g).sy,
        sz: (g).sz,
        r: r,
        g: gr,
        b: b,
        a: a,
        opacity: (g).opacity,
        sh_r: r,
        sh_g: gr,
        sh_b: b,
    };
}

// Linear blend between two Gaussians by t in [0, 1000] fixed-point.
// t = 0    => returns ga
// t = 1000 => returns gb
pub fn gaussian3d_lerp(ga: Gaussian3D, gb: Gaussian3D, t: Int) -> Gaussian3D {
    let inv = 1000 - t;
    let cx = ((ga).cx * inv + (gb).cx * t) / 1000;
    let cy = ((ga).cy * inv + (gb).cy * t) / 1000;
    let cz = ((ga).cz * inv + (gb).cz * t) / 1000;
    let sx = ((ga).sx * inv + (gb).sx * t) / 1000;
    let sy = ((ga).sy * inv + (gb).sy * t) / 1000;
    let sz = ((ga).sz * inv + (gb).sz * t) / 1000;
    let r  = ((ga).r  * inv + (gb).r  * t) / 1000;
    let g  = ((ga).g  * inv + (gb).g  * t) / 1000;
    let b  = ((ga).b  * inv + (gb).b  * t) / 1000;
    let a  = ((ga).a  * inv + (gb).a  * t) / 1000;
    let op = ((ga).opacity * inv + (gb).opacity * t) / 1000;
    let shr = ((ga).sh_r * inv + (gb).sh_r * t) / 1000;
    let shg = ((ga).sh_g * inv + (gb).sh_g * t) / 1000;
    let shb = ((ga).sh_b * inv + (gb).sh_b * t) / 1000;
    return Gaussian3D {
        cx: cx,
        cy: cy,
        cz: cz,
        sx: sx,
        sy: sy,
        sz: sz,
        r: r,
        g: g,
        b: b,
        a: a,
        opacity: op,
        sh_r: shr,
        sh_g: shg,
        sh_b: shb,
    };
}
