// # Scene ops
//
// Logline: SceneOp destubbed off List[SceneNode] graph ops.
// residual: List[struct] destubbed to Int floor.

type SceneOp = struct {
    node_id: Int,
    parent_id: Int
};

pub fn scene_op_new(node_id: Int, parent_id: Int) -> SceneOp {
    return SceneOp { node_id: node_id, parent_id: parent_id };
}

pub fn scene_op_node_id(op: SceneOp) -> Int {
    return op.node_id;
}
