// # 3D Lighting Engine
//
// Logline: By-value setters for ambient, directional, point, and spot light state.
//
// Setup: Flat Int light structs. Destubbed off by-value / nested LightColor.
//
// Beats:
//   1. Construct default lights.
//   2. Set enabled, intensity, direction, position, radius.
//   3. Read back assigned components.

type AmbientLight = struct {
    r: Int,
    g: Int,
    b: Int,
    a: Int,
    intensity: Int,
    enabled: Int
};

type DirectionalLight = struct {
    r: Int,
    g: Int,
    b: Int,
    a: Int,
    intensity: Int,
    dir_x: Int,
    dir_y: Int,
    dir_z: Int,
    cast_shadow: Int,
    enabled: Int
};

type PointLight = struct {
    r: Int,
    g: Int,
    b: Int,
    a: Int,
    intensity: Int,
    x: Int,
    y: Int,
    z: Int,
    radius: Int,
    enabled: Int
};

type SpotLight = struct {
    r: Int,
    g: Int,
    b: Int,
    a: Int,
    intensity: Int,
    x: Int,
    y: Int,
    z: Int,
    dir_x: Int,
    dir_y: Int,
    dir_z: Int,
    radius: Int,
    inner_cos_255: Int,
    outer_cos_255: Int,
    cast_shadow: Int,
    enabled: Int
};

pub fn ambient_light_default() -> AmbientLight {
    return AmbientLight {
        r: 30,
        g: 30,
        b: 30,
        a: 255,
        intensity: 50,
        enabled: 1
    };
}

pub fn directional_light_default() -> DirectionalLight {
    return DirectionalLight {
        r: 255,
        g: 255,
        b: 255,
        a: 255,
        intensity: 200,
        dir_x: 0,
        dir_y: 0 - 1,
        dir_z: 0,
        cast_shadow: 1,
        enabled: 1
    };
}

pub fn point_light_default() -> PointLight {
    return PointLight {
        r: 255,
        g: 255,
        b: 255,
        a: 255,
        intensity: 255,
        x: 0,
        y: 0,
        z: 0,
        radius: 100,
        enabled: 1
    };
}

pub fn spot_light_default() -> SpotLight {
    return SpotLight {
        r: 255,
        g: 255,
        b: 255,
        a: 255,
        intensity: 220,
        x: 0,
        y: 10,
        z: 0,
        dir_x: 0,
        dir_y: 0 - 1,
        dir_z: 0,
        radius: 80,
        inner_cos_255: 220,
        outer_cos_255: 180,
        cast_shadow: 1,
        enabled: 1
    };
}

pub fn ambient_light_set_enabled(mamb: AmbientLight, enabled: Int) -> AmbientLight {
    return AmbientLight {
        r: mamb.r,
        g: mamb.g,
        b: mamb.b,
        a: mamb.a,
        intensity: mamb.intensity,
        enabled: enabled
    };
}

pub fn ambient_light_set_intensity(mamb: AmbientLight, intensity: Int) -> AmbientLight {
    return AmbientLight {
        r: mamb.r,
        g: mamb.g,
        b: mamb.b,
        a: mamb.a,
        intensity: intensity,
        enabled: mamb.enabled
    };
}

pub fn ambient_light_get_intensity(mamb: AmbientLight) -> Int {
    return mamb.intensity;
}

pub fn ambient_light_get_enabled(mamb: AmbientLight) -> Int {
    return mamb.enabled;
}

pub fn directional_light_set_enabled(mdir: DirectionalLight, enabled: Int) -> DirectionalLight {
    return DirectionalLight {
        r: mdir.r,
        g: mdir.g,
        b: mdir.b,
        a: mdir.a,
        intensity: mdir.intensity,
        dir_x: mdir.dir_x,
        dir_y: mdir.dir_y,
        dir_z: mdir.dir_z,
        cast_shadow: mdir.cast_shadow,
        enabled: enabled
    };
}

pub fn directional_light_set_direction(mdir: DirectionalLight, dx: Int, dy: Int, dz: Int) -> DirectionalLight {
    return DirectionalLight {
        r: mdir.r,
        g: mdir.g,
        b: mdir.b,
        a: mdir.a,
        intensity: mdir.intensity,
        dir_x: dx,
        dir_y: dy,
        dir_z: dz,
        cast_shadow: mdir.cast_shadow,
        enabled: mdir.enabled
    };
}

pub fn directional_light_dir_sum(mdir: DirectionalLight) -> Int {
    return (mdir.dir_x + mdir.dir_y) + mdir.dir_z;
}

pub fn point_light_set_position(mpt: PointLight, x: Int, y: Int, z: Int) -> PointLight {
    return PointLight {
        r: mpt.r,
        g: mpt.g,
        b: mpt.b,
        a: mpt.a,
        intensity: mpt.intensity,
        x: x,
        y: y,
        z: z,
        radius: mpt.radius,
        enabled: mpt.enabled
    };
}

pub fn point_light_set_enabled(mpt: PointLight, enabled: Int) -> PointLight {
    return PointLight {
        r: mpt.r,
        g: mpt.g,
        b: mpt.b,
        a: mpt.a,
        intensity: mpt.intensity,
        x: mpt.x,
        y: mpt.y,
        z: mpt.z,
        radius: mpt.radius,
        enabled: enabled
    };
}

pub fn point_light_set_radius(mpt: PointLight, radius: Int) -> PointLight {
    return PointLight {
        r: mpt.r,
        g: mpt.g,
        b: mpt.b,
        a: mpt.a,
        intensity: mpt.intensity,
        x: mpt.x,
        y: mpt.y,
        z: mpt.z,
        radius: radius,
        enabled: mpt.enabled
    };
}

pub fn point_light_pos_sum(mpt: PointLight) -> Int {
    return (mpt.x + mpt.y) + mpt.z;
}

pub fn point_light_get_radius(mpt: PointLight) -> Int {
    return mpt.radius;
}

pub fn spot_light_pos_sum(mspot: SpotLight) -> Int {
    return (mspot.x + mspot.y) + mspot.z;
}
