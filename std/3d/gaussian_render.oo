// # Gaussian render
//
// Logline: GaussRend destubbed off pub type GaussianAABB.
// residual: List[struct] destubbed to Int floor.

type GaussRend = struct {
    w: Int,
    h: Int
};

pub fn gauss_rend_new(w: Int, h: Int) -> GaussRend {
    return GaussRend { w: w, h: h };
}

pub fn gauss_rend_w(r: GaussRend) -> Int {
    return r.w;
}
