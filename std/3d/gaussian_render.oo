// # Gaussian render
//
// Logline: GaussRend destubbed off pub type GaussianAABB.
// residual: List[struct] destubbed to Int floor.

import "./gaussian_types.oo";
import "./gaussian_cloud.oo";

type GaussianAABB = struct {
    min_x: Int,
    max_x: Int,
    min_y: Int,
    max_y: Int,
    min_z: Int,
    max_z: Int,
};

type GaussianSample = struct {
    r: Int,
    g: Int,
    b: Int,
    a: Int,
    transmittance: Int,
    contributors: Int,
};

type GaussianFitResult = struct {
    iterations: Int,
    loss_scaled: Int,
    converged: Int,
};

type GaussRend = struct {
    w: Int,
    h: Int
};

pub fn gauss_rend_new(w: Int, h: Int) -> GaussRend {
    return GaussRend { w: w, h: h };
}

pub fn gauss_rend_w(r: GaussRend) -> Int {
    return r.w;
}
