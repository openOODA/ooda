import "./gaussian_types.oo";

type GaussianCloud = struct {
    count: Int,
    capacity: Int,
    g0: Gaussian3D,
    g1: Gaussian3D,
    g2: Gaussian3D,
    g3: Gaussian3D,
    g4: Gaussian3D,
    g5: Gaussian3D,
    g6: Gaussian3D,
    g7: Gaussian3D,
    g8: Gaussian3D,
    g9: Gaussian3D,
    g10: Gaussian3D,
    g11: Gaussian3D,
    g12: Gaussian3D,
    g13: Gaussian3D,
    g14: Gaussian3D,
    g15: Gaussian3D
};

pub fn gaussian_cloud_new() -> GaussianCloud {
    let id: Gaussian3D = gaussian3d_identity();
    return GaussianCloud {
        count: 0,
        capacity: 16,
        g0: id, g1: id, g2: id, g3: id,
        g4: id, g5: id, g6: id, g7: id,
        g8: id, g9: id, g10: id, g11: id,
        g12: id, g13: id, g14: id, g15: id
    };
}

pub fn gaussian_cloud_count(c: GaussianCloud) -> Int {
    return c.count;
}

type GaussCloud = struct {
    count: Int,
    opacity: Int
};

pub fn gauss_cloud_new(count: Int, opacity: Int) -> GaussCloud {
    return GaussCloud { count: count, opacity: opacity };
}

pub fn gauss_cloud_count(c: GaussCloud) -> Int {
    return c.count;
}
