// # Customer Relationship Management Deal Lifecycle
//
// Logline: Commercial deal creation, pipeline stage progression, and probability valuation.
//
// Setup: Imports crm_types.oo for Deal structures.
//
// Beats:
//   1. Instantiate commercial deals with initial stages and expected amounts.
//   2. Advance deal stages and update close probabilities.
//   3. Compute weighted pipeline valuations.

import "./crm_types.oo";

type Deal = struct {
    id: Int, customer_id: Int, title: String, amount: Int, stage: Int,
    probability: Int, is_closed: Bool, is_won: Bool
};

pub fn deal_create(id: Int, customer_id: Int, title: String, amount: Int) -> Deal {
    return Deal {
        id: id, customer_id: customer_id, title: title, amount: amount, stage: 0,
        probability: 10, is_closed: false, is_won: false
    };
}
pub fn deal_advance_stage(deal: &mut Deal, new_stage: Int, new_probability: Int) -> Bool {
    let mut deal: Deal = deal;
    let closed: Bool = (deal).is_closed;
    if closed == true  { return false; }
    if new_stage < 0  { return false; }
    if new_stage > 5  { return false; }
    if new_probability < 0  { return false; }
    if new_probability > 100  { return false; }

    (deal).stage = new_stage;
    (deal).probability = new_probability;

    if new_stage == 4 {
        (deal).is_closed = true;
        (deal).is_won = true;
        (deal).probability = 100;
    } else if new_stage == 5 {
        (deal).is_closed = true;
        (deal).is_won = false;
        (deal).probability = 0;
    }

    return true;
}
pub fn deal_close_won(deal: &mut Deal) -> Bool {
    let mut deal: Deal = deal;
    let closed: Bool = (deal).is_closed;
    if closed == true  { return false; }
    (deal).stage = 4;
    (deal).probability = 100;
    (deal).is_closed = true;
    (deal).is_won = true;
    return true;
}
pub fn deal_close_lost(deal: &mut Deal) -> Bool {
    let mut deal: Deal = deal;
    let closed: Bool = (deal).is_closed;
    if closed == true  { return false; }
    (deal).stage = 5;
    (deal).probability = 0;
    (deal).is_closed = true;
    (deal).is_won = false;
    return true;
}
