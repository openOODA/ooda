// # BPM Process Variables
//
// Logline: Create, set, and get Int / Bool process variable values gated on is_set.
//
// Setup: A single ProcessVariable carries val_int + val_bool with a shared is_set flag.
//
// Beats:
//   1. process_variable_create.
//   2. set_int / set_bool: write through and set is_set = true.
//   3. get_int / get_bool: return 0 / false if not set.

import "./bpm_types.oo";

pub fn process_variable_create(key_hash: Int, val_int: Int, val_bool: Bool) -> ProcessVariable {
    return ProcessVariable {
        key_hash: key_hash,
        val_int: val_int,
        val_bool: val_bool,
        is_set: true
    };
}

pub fn process_variable_set_int(var_item: &mut ProcessVariable, val: Int) {
    (var_item).val_int = val;
    (var_item).is_set = true;
}

pub fn process_variable_set_bool(var_item: &mut ProcessVariable, val: Bool) {
    (var_item).val_bool = val;
    (var_item).is_set = true;
}

pub fn process_variable_get_int(var_item: &ProcessVariable) -> Int {
    if (var_item).is_set == false {
        return 0;
    }
    return (var_item).val_int;
}

pub fn process_variable_get_bool(var_item: &ProcessVariable) -> Bool {
    if (var_item).is_set == false {
        return false;
    }
    return (var_item).val_bool;
}
