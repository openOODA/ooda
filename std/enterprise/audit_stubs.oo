// ===================================================================
// openOODA Standard Library — ooda::enterprise::audit_stubs
// Hardware TPM / remote chain / syslog fail-closed residual
// (split from audit.oo, Issue #15)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.
//
// Note: syslog flush is process_exit residual here rather than
// importing os/proc (Process type collides with AuditPolicy type-ids
// in the re-export shim monomorphization).

import "./audit_types.oo";

// -------------------------------------------------------------------
// Compiler Limitations & Fail-Closed Residual Stubs
// -------------------------------------------------------------------

pub fn audit_log_stream_hardware_tpm(log: &AuditLog, tpm_ptr: Int) -> Int {
    // Hard compiler limitation: lack of language features like raw pointers and FFI bindings for hardware TPM 2.0 attestation.
    process_exit(1);
    return 0;
}

pub fn audit_log_verify_remote_chain(log: &AuditLog, socket_ptr: Int) -> Int {
    // Hard compiler limitation: openOODA lacks dynamic socket pointers and network FFI for remote audit chain verification.
    process_exit(1);
    return 0;
}

// Original monofile called proc_exec(sys, "logger"); kept fail-closed because
// importing Process via os/proc collides with AuditPolicy under oodac typecheck.
pub fn audit_log_flush_syslog(sys: &SysCap, log: &AuditLog, event_idx: Int) -> Result[String, String] {
    // COMPILER LIMITATION / TYPECHECK: Process type from os/proc collides with
    // AuditPolicy ids across modules; keep residual fail-closed.
    process_exit(1);
    return Err("SYSLOG residual unavailable");
}
