// ===================================================================
// openOODA Standard Library — ooda::enterprise::audit_engine
// Audit log core engine (split from audit.oo, Issue #15)
// ===================================================================

import "./audit_types.oo";
import "./audit_policy.oo";

// -------------------------------------------------------------------
// Audit Log Core Engine
// -------------------------------------------------------------------

pub fn audit_log_init(tenant_id: String, policy: AuditPolicy) -> AuditLog {
    let events_list: List[AuditEvent] = list_new();
    return AuditLog {
        tenant_id: tenant_id,
        policy: policy,
        events: events_list,
        total_events: 0,
        violation_count: 0,
        checksum: 0,
        is_sealed: false,
    };
}

pub fn audit_log_is_sealed(log: &AuditLog) -> Bool {
    let sealed_is: Bool = (log).is_sealed;
    return sealed_is;
}

pub fn audit_log_seal(log: &mut AuditLog) {
    (log).is_sealed = true;
}

pub fn audit_log_get_total_events(log: &AuditLog) -> Int {
    let total_gt: Int = (log).total_events;
    return total_gt;
}

pub fn audit_log_get_violation_count(log: &AuditLog) -> Int {
    let count_gv: Int = (log).violation_count;
    return count_gv;
}

pub fn audit_log_get_checksum(log: &AuditLog) -> Int {
    let cs_gc: Int = (log).checksum;
    return cs_gc;
}

pub fn audit_log_verify_integrity(log: &AuditLog, expected_checksum: Int) -> Bool {
    let cs_vi: Int = (log).checksum;
    return cs_vi == expected_checksum;
}

pub fn audit_log_record(log: &mut AuditLog, evt: AuditEvent) -> Result[Int, String] {
    let e_rec: AuditEvent = evt;
    let act_rec: String = e_rec.action;
    let act_len_rec: Int = act_rec.len();
    if act_len_rec == 0 {
        return Err("INVALID_ACTION: Action string cannot be empty");
    }

    let sealed_rec: Bool = (log).is_sealed;
    if sealed_rec == true {
        return Err("AUDIT_SEALED: Audit log is sealed against mutations");
    }

    let pol_rec: AuditPolicy = (log).policy;
    let active_rec: Bool = pol_rec.is_active;
    if active_rec == false {
        return Err("AUDIT_DISABLED: Enterprise audit logging policy is inactive");
    }

    let req_cap_rec: Bool = pol_rec.require_sys_cap;
    if req_cap_rec == true {
        return Err("CAPABILITY_REQUIRED: System capability token required for privileged audit recording");
    }

    let sev_rec: Int = e_rec.severity;
    let min_sev_rec: Int = pol_rec.min_severity;
    let total_rec: Int = (log).total_events;
    if sev_rec < min_sev_rec {
        return Ok(total_rec);
    }

    let max_ev_rec: Int = pol_rec.max_events;
    if total_rec >= max_ev_rec {
        let fc_rec: Bool = pol_rec.fail_closed;
        if fc_rec == true {
            (log).is_sealed = true;
            return Err("AUDIT_QUOTA_EXCEEDED: Maximum audit event capacity reached in fail-closed mode");
        } else {
            return Err("AUDIT_CAPACITY_EXCEEDED: Audit event buffer capacity reached");
        }
    }

    let evt_hash_rec: Int = audit_event_calculate_hash(e_rec);
    let cur_cs_rec: Int = (log).checksum;
    (log).checksum = cur_cs_rec * 31 + evt_hash_rec;
    (log).total_events = total_rec + 1;

    if sev_rec >= 3 {
        let cur_v_rec: Int = (log).violation_count;
        (log).violation_count = cur_v_rec + 1;
    }

    let cur_evts_rec: List[AuditEvent] = (log).events;
    (log).events = list_push(cur_evts_rec, e_rec);
    return Ok(total_rec + 1);
}

pub fn audit_log_record_with_capability(sys: &SysCap, log: &mut AuditLog, evt: AuditEvent) -> Result[Int, String] {
    let e_cap: AuditEvent = evt;
    let act_cap: String = e_cap.action;
    let act_len_cap: Int = act_cap.len();
    if act_len_cap == 0 {
        return Err("INVALID_ACTION: Action string cannot be empty");
    }

    let sealed_cap: Bool = (log).is_sealed;
    if sealed_cap == true {
        return Err("AUDIT_SEALED: Audit log is sealed against mutations");
    }

    let pol_cap: AuditPolicy = (log).policy;
    let active_cap: Bool = pol_cap.is_active;
    if active_cap == false {
        return Err("AUDIT_DISABLED: Enterprise audit logging policy is inactive");
    }

    let sev_cap: Int = e_cap.severity;
    let min_sev_cap: Int = pol_cap.min_severity;
    let total_cap: Int = (log).total_events;
    if sev_cap < min_sev_cap {
        return Ok(total_cap);
    }

    let max_ev_cap: Int = pol_cap.max_events;
    if total_cap >= max_ev_cap {
        let fc_cap: Bool = pol_cap.fail_closed;
        if fc_cap == true {
            (log).is_sealed = true;
            return Err("AUDIT_QUOTA_EXCEEDED: Maximum audit event capacity reached in fail-closed mode");
        } else {
            return Err("AUDIT_CAPACITY_EXCEEDED: Audit event buffer capacity reached");
        }
    }

    let evt_hash_cap: Int = audit_event_calculate_hash(e_cap);
    let cur_cs_cap: Int = (log).checksum;
    (log).checksum = cur_cs_cap * 31 + evt_hash_cap;
    (log).total_events = total_cap + 1;

    if sev_cap >= 3 {
        let cur_v_cap: Int = (log).violation_count;
        (log).violation_count = cur_v_cap + 1;
    }

    let cur_evts_cap: List[AuditEvent] = (log).events;
    (log).events = list_push(cur_evts_cap, e_cap);
    return Ok(total_cap + 1);
}
