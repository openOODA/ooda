// # Business Process Management Types
//
// Logline: Define BpmProcess, BpmTask, and BpmInstance models.
//
// Setup: Core data types and structured models.
//
// Beats:
//   1. Declare workflow process template definitions.
//   2. Declare human and automated task specifications.
//   3. Declare runtime process execution instances.

pub type ProcessDefinition = struct { id: Int, version: Int, total_steps: Int, is_active: Bool };
pub type StepDefinition = struct {
    step_id: Int,
    step_type: Int, // 0 = Start, 1 = UserTask, 2 = ServiceTask, 3 = Decision, 4 = End,
    next_step_id: Int, timeout_seconds: Int, requires_approval: Bool
};
pub type ProcessInstance = struct {
    instance_id: Int, process_id: Int, current_step_id: Int,
    status: Int, // 0 = Created, 1 = Running, 2 = Suspended, 3 = Completed, 4 = Terminated, 5 = Cancelled,
    start_time: Int, update_time: Int, variable_count: Int, is_failed: Bool
};
pub type TaskInstance = struct {
    task_id: Int, instance_id: Int, step_id: Int, assignee_id: Int,
    status: Int, // 0 = Pending, 1 = In_Progress, 2 = Approved, 3 = Rejected, 4 = Completed, 5 = Cancelled,
    due_date: Int, priority: Int
};
pub type ProcessVariable = struct { key_hash: Int, val_int: Int, val_bool: Bool, is_set: Bool };
pub type BpmEngineMetrics = struct {
    total_started: Int, total_completed: Int, total_failed: Int,
    total_tasks_processed: Int
};
pub type BpmEngine = struct {
    engine_id: Int, active_instances: Int, strict_mode: Bool,
    auto_advance: Bool
};

pub fn process_definition_create(id: Int, version: Int, total_steps: Int) -> ProcessDefinition {
    return ProcessDefinition {
        id: id, version: version, total_steps: total_steps, is_active: true
    };
}
pub fn process_definition_set_active(def: &mut ProcessDefinition, active: Bool) {
    (def).is_active = active;
}
pub fn process_definition_is_valid(def: &ProcessDefinition) -> Bool {
    if (def).id <= 0  { return false; }
    if (def).version <= 0  { return false; }
    if (def).total_steps <= 0  { return false; }
    return (def).is_active;
}
pub fn step_definition_create(step_id: Int, step_type: Int, next_step_id: Int, timeout_seconds: Int, requires_approval: Bool) -> StepDefinition {
    return StepDefinition {
        step_id: step_id, step_type: step_type, next_step_id: next_step_id,
        timeout_seconds: timeout_seconds, requires_approval: requires_approval
    };
}
pub fn step_definition_is_end(step: &StepDefinition) -> Bool { return (step).step_type == 4; }
