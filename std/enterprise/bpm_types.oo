// # BPM Types and Definitions
//
// Logline: ProcessDefinition, StepDefinition, ProcessInstance, TaskInstance, ProcessVariable, BpmEngineMetrics, BpmEngine struct definitions and process/step constructors.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. Define the seven BPM carriers.
//   2. process_definition_create / set_active / is_valid.
//   3. step_definition_create / is_end.

pub type ProcessDefinition = struct {
    id: Int,
    version: Int,
    total_steps: Int,
    is_active: Bool,
};

pub type StepDefinition = struct {
    step_id: Int,
    step_type: Int,
    next_step_id: Int,
    timeout_seconds: Int,
    requires_approval: Bool,
};

pub type ProcessInstance = struct {
    instance_id: Int,
    process_id: Int,
    current_step_id: Int,
    status: Int,
    start_time: Int,
    update_time: Int,
    variable_count: Int,
    is_failed: Bool,
};

pub type TaskInstance = struct {
    task_id: Int,
    instance_id: Int,
    step_id: Int,
    assignee_id: Int,
    status: Int,
    due_date: Int,
    priority: Int,
};

pub type ProcessVariable = struct {
    key_hash: Int,
    val_int: Int,
    val_bool: Bool,
    is_set: Bool,
};

pub type BpmEngineMetrics = struct {
    total_started: Int,
    total_completed: Int,
    total_failed: Int,
    total_tasks_processed: Int,
};

pub type BpmEngine = struct {
    engine_id: Int,
    active_instances: Int,
    strict_mode: Bool,
    auto_advance: Bool,
};

pub fn process_definition_create(id: Int, version: Int, total_steps: Int) -> ProcessDefinition {
    return ProcessDefinition {
        id: id,
        version: version,
        total_steps: total_steps,
        is_active: true,
    };
}

pub fn process_definition_set_active(def: &mut ProcessDefinition, active: Bool) {
    (def).is_active = active;
}

pub fn process_definition_is_valid(def: &ProcessDefinition) -> Bool {
    if (def).id <= 0 {
        return false;
    }
    if (def).version <= 0 {
        return false;
    }
    if (def).total_steps <= 0 {
        return false;
    }
    return (def).is_active;
}

pub fn step_definition_create(step_id: Int, step_type: Int, next_step_id: Int, timeout_seconds: Int, requires_approval: Bool) -> StepDefinition {
    return StepDefinition {
        step_id: step_id,
        step_type: step_type,
        next_step_id: next_step_id,
        timeout_seconds: timeout_seconds,
        requires_approval: requires_approval,
    };
}

pub fn step_definition_is_end(step: &StepDefinition) -> Bool {
    return (step).step_type == 4;
}
