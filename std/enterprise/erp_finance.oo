// # Enterprise Resource Planning Finance, Ledger, Employee & Enterprise Operations
//
// Logline: Account init, ledger post (Asset/Liability/Equity/Revenue/Expense), employee lifecycle, enterprise cash/score.
//
// Setup: Account types 0=Asset, 1=Liability, 2=Equity, 3=Revenue, 4=Expense. RULES.oot 1.4 default-deny.
//
// Beats:
//   1. account_init, transaction_create, ledger_post_transaction.
//   2. account_calculate_net_balance.
//   3. employee_init, employee_record_hours, employee_calculate_paycheck, employee_reset_hours.
//   4. enterprise_init, enterprise_record_sale, enterprise_record_expense, enterprise_net_income.
//   5. enterprise_financial_health_score.

import "./erp_types.oo";

pub fn account_init(id: Int, acc_type: Int, initial_balance: Int) -> Account {
    return Account {
        account_id: id,
        account_type: acc_type,
        balance: initial_balance,
    };
}

pub fn transaction_create(tx_id: Int, debit_acc_id: Int, credit_acc_id: Int, amount: Int, ts: Int) -> LedgerTransaction {
    return LedgerTransaction {
        tx_id: tx_id,
        debit_account: debit_acc_id,
        credit_account: credit_acc_id,
        amount: amount,
        timestamp: ts,
        is_posted: false,
    };
}

pub fn ledger_post_transaction(tx: &mut LedgerTransaction, debit_acc: &mut Account, credit_acc: &mut Account) -> Bool {
    if (tx).is_posted == true {
        return false;
    }
    if (tx).amount <= 0 {
        return false;
    }
    if (debit_acc).account_id != (tx).debit_account {
        return false;
    }
    if (credit_acc).account_id != (tx).credit_account {
        return false;
    }

    // Process Debit Side
    // Account types: 0 = Asset, 1 = Liability, 2 = Equity, 3 = Revenue, 4 = Expense
    let debit_type = (debit_acc).account_type;
    if debit_type == 0 {
        (debit_acc).balance = (debit_acc).balance + (tx).amount;
    } else if debit_type == 4 {
        (debit_acc).balance = (debit_acc).balance + (tx).amount;
    } else {
        (debit_acc).balance = (debit_acc).balance - (tx).amount;
    }

    // Process Credit Side
    let credit_type = (credit_acc).account_type;
    if credit_type == 0 {
        (credit_acc).balance = (credit_acc).balance - (tx).amount;
    } else if credit_type == 4 {
        (credit_acc).balance = (credit_acc).balance - (tx).amount;
    } else {
        (credit_acc).balance = (credit_acc).balance + (tx).amount;
    }

    (tx).is_posted = true;
    return true;
}

pub fn account_calculate_net_balance(asset_acc: &Account, liability_acc: &Account) -> Int {
    return (asset_acc).balance - (liability_acc).balance;
}

pub fn employee_init(id: Int, dept: Int, rate: Int, salary: Int) -> EmployeeRecord {
    return EmployeeRecord {
        employee_id: id,
        department_id: dept,
        hourly_rate: rate,
        hours_worked: 0,
        base_salary: salary,
        is_active: true,
    };
}

pub fn employee_record_hours(emp: &mut EmployeeRecord, hours: Int) -> Bool {
    if (emp).is_active == false {
        return false;
    }
    if hours <= 0 {
        return false;
    }
    (emp).hours_worked = (emp).hours_worked + hours;
    return true;
}

pub fn employee_calculate_paycheck(emp: &EmployeeRecord) -> Int {
    if (emp).is_active == false {
        return 0;
    }
    if (emp).hourly_rate > 0 {
        return (emp).hourly_rate * (emp).hours_worked;
    }
    return (emp).base_salary;
}

pub fn employee_reset_hours(emp: &mut EmployeeRecord) {
    (emp).hours_worked = 0;
}

pub fn enterprise_init(id: Int, initial_cash: Int) -> EnterpriseState {
    return EnterpriseState {
        company_id: id,
        cash_reserve: initial_cash,
        total_revenue: 0,
        total_expenses: 0,
        active_employees: 0,
    };
}

pub fn enterprise_record_sale(ent: &mut EnterpriseState, order: &Order) -> Bool {
    if (order).is_paid == false {
        return false; // Fail-closed: sale must be paid
    }
    if (order).status != 1 {
        return false; // Order must be fulfilled
    }
    (ent).cash_reserve = (ent).cash_reserve + (order).total_amount;
    (ent).total_revenue = (ent).total_revenue + (order).total_amount;
    return true;
}

pub fn enterprise_record_expense(ent: &mut EnterpriseState, amount: Int) -> Bool {
    if amount <= 0 {
        return false;
    }
    if (ent).cash_reserve < amount {
        return false; // Fail-closed: insufficient reserves
    }
    (ent).cash_reserve = (ent).cash_reserve - amount;
    (ent).total_expenses = (ent).total_expenses + amount;
    return true;
}

pub fn enterprise_net_income(ent: &EnterpriseState) -> Int {
    return (ent).total_revenue - (ent).total_expenses;
}

pub fn enterprise_financial_health_score(ent: &EnterpriseState) -> Int {
    let net = enterprise_net_income(ent);
    let cash = (ent).cash_reserve;
    let mut score = 50;

    if net > 0 {
        score = score + 25;
    } else if net < 0 {
        score = score - 25;
    }

    if cash > 1000000 {
        score = score + 25;
    } else if cash > 100000 {
        score = score + 10;
    } else if cash < 10000 {
        score = score - 20;
    }

    if score > 100 {
        score = 100;
    }
    if score < 0 {
        score = 0;
    }
    return score;
}
