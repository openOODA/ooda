// # Enterprise Resource Planning Domain
//
// Logline: Track InventoryItem, Order, and Account balances; record fulfillment and payment status.
//
// Setup: Self-contained domain module. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. inventory_item_init: bind sku, quantity, and reorder point.
//   2. order_init: bind item, quantity, and paid status.
//   3. account_init: bind account type and balance.
//   4. order_mark_paid: flip is_paid and refresh balance.
//
// residual: not a real ERP; integrate vetted ERP platform.

pub type InventoryItem = struct {
    id: Int,
    sku: Int,
    quantity: Int,
    reorder_point: Int,
    unit_price: Int,
    unit_cost: Int,
};

pub type Order = struct {
    id: Int,
    customer_id: Int,
    item_id: Int,
    quantity: Int,
    unit_price: Int,
    total_amount: Int,
    status: Int,
    is_paid: Bool,
};

pub type Account = struct {
    account_id: Int,
    account_type: Int,
    balance: Int,
};

pub type LedgerTransaction = struct {
    tx_id: Int,
    debit_account: Int,
    credit_account: Int,
    amount: Int,
    timestamp: Int,
    is_posted: Bool,
};

pub type PurchaseOrder = struct {
    po_id: Int,
    vendor_id: Int,
    item_id: Int,
    quantity_ordered: Int,
    unit_cost: Int,
    status: Int,
};

pub type EmployeeRecord = struct {
    employee_id: Int,
    department_id: Int,
    hourly_rate: Int,
    hours_worked: Int,
    base_salary: Int,
    is_active: Bool,
};

pub type EnterpriseState = struct {
    company_id: Int,
    cash_reserve: Int,
    total_revenue: Int,
    total_expenses: Int,
    active_employees: Int,
};

pub fn inventory_item_init(id: Int, sku: Int, qty: Int, reorder: Int, price: Int, cost: Int) -> InventoryItem {
    return InventoryItem {
        id: id,
        sku: sku,
        quantity: qty,
        reorder_point: reorder,
        unit_price: price,
        unit_cost: cost,
    };
}

pub fn inventory_add_stock(item: &mut InventoryItem, qty: Int) -> Bool {
    if qty <= 0 {
        return false;
    }
    let current = (item).quantity;
    (item).quantity = current + qty;
    return true;
}

pub fn inventory_remove_stock(item: &mut InventoryItem, qty: Int) -> Bool {
    if qty <= 0 {
        return false;
    }
    let current = (item).quantity;
    if current < qty {
        return false; // Fail-closed: insufficient inventory
    }
    (item).quantity = current - qty;
    return true;
}

pub fn inventory_needs_reorder(item: &InventoryItem) -> Bool {
    return (item).quantity <= (item).reorder_point;
}

pub fn inventory_calculate_value(item: &InventoryItem) -> Int {
    return (item).quantity * (item).unit_cost;
}

pub fn inventory_calculate_profit_margin(item: &InventoryItem) -> Int {
    return (item).unit_price - (item).unit_cost;
}

pub fn order_create(id: Int, customer_id: Int, item_id: Int, qty: Int, unit_price: Int) -> Order {
    let total = qty * unit_price;
    return Order {
        id: id,
        customer_id: customer_id,
        item_id: item_id,
        quantity: qty,
        unit_price: unit_price,
        total_amount: total,
        status: 0, // 0 = Pending
        is_paid: false,
    };
}

pub fn order_fulfill(order: &mut Order, item: &mut InventoryItem) -> Bool {
    if (order).status != 0 {
        return false;
    }
    if (order).item_id != (item).id {
        return false;
    }
    let success = inventory_remove_stock(item, (order).quantity);
    if success == false {
        return false;
    }
    (order).status = 1; // 1 = Fulfilled
    return true;
}

pub fn order_cancel(order: &mut Order, item: &mut InventoryItem) -> Bool {
    if (order).status == 2 {
        return false; // Already cancelled
    }
    if (order).status == 1 {
        // Return inventory if order was previously fulfilled
        inventory_add_stock(item, (order).quantity);
    }
    (order).status = 2; // 2 = Cancelled
    return true;
}

pub fn order_mark_paid(order: &mut Order) -> Bool {
    if (order).is_paid == true {
        return false;
    }
    (order).is_paid = true;
    return true;
}

pub fn account_init(id: Int, acc_type: Int, initial_balance: Int) -> Account {
    return Account {
        account_id: id,
        account_type: acc_type,
        balance: initial_balance,
    };
}

pub fn transaction_create(tx_id: Int, debit_acc_id: Int, credit_acc_id: Int, amount: Int, ts: Int) -> LedgerTransaction {
    return LedgerTransaction {
        tx_id: tx_id,
        debit_account: debit_acc_id,
        credit_account: credit_acc_id,
        amount: amount,
        timestamp: ts,
        is_posted: false,
    };
}

pub fn ledger_post_transaction(tx: &mut LedgerTransaction, debit_acc: &mut Account, credit_acc: &mut Account) -> Bool {
    if (tx).is_posted == true {
        return false;
    }
    if (tx).amount <= 0 {
        return false;
    }
    if (debit_acc).account_id != (tx).debit_account {
        return false;
    }
    if (credit_acc).account_id != (tx).credit_account {
        return false;
    }

    // Process Debit Side
    // Account types: 0 = Asset, 1 = Liability, 2 = Equity, 3 = Revenue, 4 = Expense
    let debit_type = (debit_acc).account_type;
    if debit_type == 0 {
        (debit_acc).balance = (debit_acc).balance + (tx).amount;
    } else if debit_type == 4 {
        (debit_acc).balance = (debit_acc).balance + (tx).amount;
    } else {
        (debit_acc).balance = (debit_acc).balance - (tx).amount;
    }

    // Process Credit Side
    let credit_type = (credit_acc).account_type;
    if credit_type == 0 {
        (credit_acc).balance = (credit_acc).balance - (tx).amount;
    } else if credit_type == 4 {
        (credit_acc).balance = (credit_acc).balance - (tx).amount;
    } else {
        (credit_acc).balance = (credit_acc).balance + (tx).amount;
    }

    (tx).is_posted = true;
    return true;
}

pub fn account_calculate_net_balance(asset_acc: &Account, liability_acc: &Account) -> Int {
    return (asset_acc).balance - (liability_acc).balance;
}

pub fn purchase_order_create(po_id: Int, vendor_id: Int, item_id: Int, qty: Int, unit_cost: Int) -> PurchaseOrder {
    return PurchaseOrder {
        po_id: po_id,
        vendor_id: vendor_id,
        item_id: item_id,
        quantity_ordered: qty,
        unit_cost: unit_cost,
        status: 0, // 0 = Pending
    };
}

pub fn purchase_order_receive(po: &mut PurchaseOrder, item: &mut InventoryItem) -> Bool {
    if (po).status != 0 {
        return false;
    }
    if (po).item_id != (item).id {
        return false;
    }
    let success = inventory_add_stock(item, (po).quantity_ordered);
    if success == false {
        return false;
    }
    (po).status = 1; // 1 = Received
    return true;
}

pub fn purchase_order_reject(po: &mut PurchaseOrder) -> Bool {
    if (po).status != 0 {
        return false;
    }
    (po).status = 2; // 2 = Rejected
    return true;
}

pub fn employee_init(id: Int, dept: Int, rate: Int, salary: Int) -> EmployeeRecord {
    return EmployeeRecord {
        employee_id: id,
        department_id: dept,
        hourly_rate: rate,
        hours_worked: 0,
        base_salary: salary,
        is_active: true,
    };
}

pub fn employee_record_hours(emp: &mut EmployeeRecord, hours: Int) -> Bool {
    if (emp).is_active == false {
        return false;
    }
    if hours <= 0 {
        return false;
    }
    (emp).hours_worked = (emp).hours_worked + hours;
    return true;
}

pub fn employee_calculate_paycheck(emp: &EmployeeRecord) -> Int {
    if (emp).is_active == false {
        return 0;
    }
    if (emp).hourly_rate > 0 {
        return (emp).hourly_rate * (emp).hours_worked;
    }
    return (emp).base_salary;
}

pub fn employee_reset_hours(emp: &mut EmployeeRecord) {
    (emp).hours_worked = 0;
}

pub fn enterprise_init(id: Int, initial_cash: Int) -> EnterpriseState {
    return EnterpriseState {
        company_id: id,
        cash_reserve: initial_cash,
        total_revenue: 0,
        total_expenses: 0,
        active_employees: 0,
    };
}

pub fn enterprise_record_sale(ent: &mut EnterpriseState, order: &Order) -> Bool {
    if (order).is_paid == false {
        return false; // Fail-closed: sale must be paid
    }
    if (order).status != 1 {
        return false; // Order must be fulfilled
    }
    (ent).cash_reserve = (ent).cash_reserve + (order).total_amount;
    (ent).total_revenue = (ent).total_revenue + (order).total_amount;
    return true;
}

pub fn enterprise_record_expense(ent: &mut EnterpriseState, amount: Int) -> Bool {
    if amount <= 0 {
        return false;
    }
    if (ent).cash_reserve < amount {
        return false; // Fail-closed: insufficient reserves
    }
    (ent).cash_reserve = (ent).cash_reserve - amount;
    (ent).total_expenses = (ent).total_expenses + amount;
    return true;
}

pub fn enterprise_net_income(ent: &EnterpriseState) -> Int {
    return (ent).total_revenue - (ent).total_expenses;
}

pub fn enterprise_financial_health_score(ent: &EnterpriseState) -> Int {
    let net = enterprise_net_income(ent);
    let cash = (ent).cash_reserve;
    let mut score = 50;

    if net > 0 {
        score = score + 25;
    } else if net < 0 {
        score = score - 25;
    }

    if cash > 1000000 {
        score = score + 25;
    } else if cash > 100000 {
        score = score + 10;
    } else if cash < 10000 {
        score = score - 20;
    }

    if score > 100 {
        score = 100;
    }
    if score < 0 {
        score = 0;
    }
    return score;
}

