// # Enterprise Authentication Engine Core
//
// Logline: Central AuthEngine: register users, authenticate against the policy, validate and revoke tokens, gather metrics, with fail-closed halt on threshold breach.
//
// Setup: Imports auth_types.oo for the record types and constructor helpers. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. auth_engine_register_user: dedup by username and append a new UserCredentials.
//   2. auth_engine_authenticate: verify password hash, enforce failed-attempt lockout, issue a token, and tally metrics.
//   3. auth_engine_authenticate_with_capability, validate_token, revoke_token.
//   4. auth_engine_get_metrics, auth_do_work, plus residual process_exit stubs.

import "./auth_types.oo";

pub fn auth_engine_register_user(mut_eng: &mut AuthEngine, new_user: UserCredentials) -> Result[Bool, String] {
    let mut mut_eng: AuthEngine = mut_eng;
    if (mut_eng).system_halted  { return Err("SYSTEM_HALTED: Security subsystem is halted"); }
    let mut idx = 0;
    let n = list_len((mut_eng).users);
    while idx < n {
        let u = list_get((mut_eng).users, idx);
        if u.username == new_user.username {
            return Err("USER_EXISTS: User already registered");
        }
        idx = idx + 1;
    }
    (mut_eng).users = list_push((mut_eng).users, new_user);
    return Ok(true);
}

pub fn auth_engine_authenticate(auth_eng: &mut AuthEngine, login_user: String, input_hash: Int, now_time: Int) -> Result[AuthToken, String] {
    let mut auth_eng: AuthEngine = auth_eng;
    if (auth_eng).system_halted {
        return Err("SYSTEM_HALTED: Enterprise authentication subsystem is halted");
    }
    if (auth_eng).policy.is_active == false {
        return Err("POLICY_INACTIVE: Authentication policy is disabled");
    }
    (auth_eng).total_authentications = (auth_eng).total_authentications + 1;
    let mut user_idx = -1;
    let mut idx = 0;
    let n = list_len((auth_eng).users);
    while idx < n {
        let u = list_get((auth_eng).users, idx);
        if u.username == login_user  { user_idx = idx; }
        idx = idx + 1;
    }
    if user_idx < 0 {
        (auth_eng).failed_authentications = (auth_eng).failed_authentications + 1;
        return Err("AUTH_FAILED: User not found");
    }
    let found_user = list_get((auth_eng).users, user_idx);
    if found_user.is_active == false {
        (auth_eng).failed_authentications = (auth_eng).failed_authentications + 1;
        return Err("AUTH_FAILED: User account is inactive");
    }
    if found_user.is_locked {
        (auth_eng).failed_authentications = (auth_eng).failed_authentications + 1;
        return Err("AUTH_FAILED: User account is locked");
    }
    if found_user.password_hash != input_hash {
        (auth_eng).failed_authentications = (auth_eng).failed_authentications + 1;
        let mut updated_users: List[UserCredentials] = list_new();
        let mut j = 0;
        while j < n {
            let mut u = list_get((auth_eng).users, j);
            if j == user_idx {
                u.failed_attempts = u.failed_attempts + 1;
                if u.failed_attempts >= (auth_eng).policy.max_failed_attempts {
                    u.is_locked = true;
                }
            }
            updated_users = list_push(updated_users, u);
            j = j + 1;
        }
        (auth_eng).users = updated_users;
        if (auth_eng).policy.fail_closed {
            if (auth_eng).failed_authentications > (auth_eng).policy.max_failed_attempts * 5 {
                (auth_eng).system_halted = true;
            }
        }
        return Err("AUTH_FAILED: Invalid credentials");
    }
    let mut reset_users: List[UserCredentials] = list_new();
    let mut k = 0;
    while k < n {
        let mut u = list_get((auth_eng).users, k);
        if k == user_idx  { u.failed_attempts = 0; }
        reset_users = list_push(reset_users, u);
        k = k + 1;
    }
    (auth_eng).users = reset_users;
    (auth_eng).successful_authentications = (auth_eng).successful_authentications + 1;
    (auth_eng).total_tokens_issued = (auth_eng).total_tokens_issued + 1;
    let token_id = (auth_eng).total_tokens_issued;
    let token = auth_token_create(
        token_id,
        found_user.user_id,
        found_user.username,
        (auth_eng).tenant_id,
        now_time,
        (auth_eng).policy.session_ttl,
        0
    );
    (auth_eng).tokens = list_push((auth_eng).tokens, token);
    return Ok(token);
}

pub fn auth_engine_authenticate_with_capability(sys: &SysCap, cap_eng: &mut AuthEngine, cap_user: String, cap_hash: Int, cap_time: Int) -> Result[AuthToken, String] {
    return auth_engine_authenticate(cap_eng, cap_user, cap_hash, cap_time);
}

pub fn auth_engine_validate_token(tok_eng: &AuthEngine, target_tok_id: Int, check_time: Int) -> Bool {
    let mut idx = 0;
    let n = list_len((tok_eng).tokens);
    while idx < n {
        let t = list_get((tok_eng).tokens, idx);
        if t.token_id == target_tok_id {
            let valid: Bool = t.is_valid;
            let revoked: Bool = t.is_revoked;
            if valid && !revoked {
                if check_time < t.expires_at {
                    return true;
                }
            }
            return false;
        }
        idx = idx + 1;
    }
    return false;
}

pub fn auth_engine_revoke_token(rev_eng: &mut AuthEngine, rev_tok_id: Int) -> Bool {
    let mut rev_eng: AuthEngine = rev_eng;
    let mut new_tokens: List[AuthToken] = list_new();
    let mut found = false;
    let mut idx = 0;
    let n = list_len((rev_eng).tokens);
    while idx < n {
        let mut t = list_get((rev_eng).tokens, idx);
        if t.token_id == rev_tok_id {
            if t.is_revoked == false {
                t.is_revoked = true;
                t.is_valid = false;
                found = true;
            }
        }
        new_tokens = list_push(new_tokens, t);
        idx = idx + 1;
    }
    if found {
        (rev_eng).tokens = new_tokens;
        (rev_eng).total_revocations = (rev_eng).total_revocations + 1;
    }
    return found;
}

pub fn auth_engine_get_metrics(met_eng: &AuthEngine) -> Int {
    return (met_eng).total_authentications + (met_eng).successful_authentications + (met_eng).failed_authentications + (met_eng).total_tokens_issued;
}

pub fn auth_do_work(work_eng: &AuthEngine) -> Int {
    let num_users = list_len((work_eng).users);
    let num_tokens = list_len((work_eng).tokens);
    let num_sessions = list_len((work_eng).sessions);
    return num_users + num_tokens + num_sessions + auth_engine_get_metrics(work_eng);
}

pub fn auth_authenticate_webauthn_hardware(stub_eng: &AuthEngine, fido_ptr: Int) -> Bool {
    process_exit(1);
    return false;
}

pub fn auth_kerberos_gssapi_handshake(stub_eng: &AuthEngine, ticket_ptr: Int) -> Bool {
    process_exit(1);
    return false;
}
