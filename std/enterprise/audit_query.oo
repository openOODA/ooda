// # Audit Log Query, Export & Do-Work
//
// Logline: Query AuditLog by actor, severity, and time range; export counts and run do_work batch.
//
// Setup: Imports audit_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. audit_log_query_by_actor: scan events for matching actor id.
//   2. audit_log_query_by_severity: scan events for min severity threshold.
//   3. audit_log_export_counts: return violation_count and event totals.
//   4. audit_log_do_work: drain a batch of events into engine.
//
// residual: not the full audit chain; syslog is process_exit in audit_stubs.

import "./audit_types.oo";

// -------------------------------------------------------------------
// Querying & Log Processing
// -------------------------------------------------------------------

pub fn audit_log_query_by_actor(log: &AuditLog, target_actor: String) -> List[AuditEvent] {
    let mut matched_qa: List[AuditEvent] = list_new();
    let evts_qa: List[AuditEvent] = (log).events;
    let n_qa = list_len(evts_qa);
    let mut i_qa = 0;
    while i_qa < n_qa {
        let e_qa: AuditEvent = list_get(evts_qa, i_qa);
        let actor_qa: String = e_qa.actor;
        if actor_qa == target_actor {
            matched_qa = list_push(matched_qa, e_qa);
        }
        i_qa = i_qa + 1;
    }
    return matched_qa;
}

pub fn audit_log_query_by_severity(log: &AuditLog, min_sev: Int) -> List[AuditEvent] {
    let mut matched_qs: List[AuditEvent] = list_new();
    let evts_qs: List[AuditEvent] = (log).events;
    let n_qs = list_len(evts_qs);
    let mut i_qs = 0;
    while i_qs < n_qs {
        let e_qs: AuditEvent = list_get(evts_qs, i_qs);
        let sev_qs: Int = e_qs.severity;
        if sev_qs >= min_sev {
            matched_qs = list_push(matched_qs, e_qs);
        }
        i_qs = i_qs + 1;
    }
    return matched_qs;
}

pub fn audit_log_export_formatted(log: &AuditLog) -> List[String] {
    let mut formatted_exp: List[String] = list_new();
    let evts_exp: List[AuditEvent] = (log).events;
    let n_exp = list_len(evts_exp);
    let mut i_exp = 0;
    while i_exp < n_exp {
        let e_exp: AuditEvent = list_get(evts_exp, i_exp);
        let line_exp: String = audit_event_to_string(e_exp);
        formatted_exp = list_push(formatted_exp, line_exp);
        i_exp = i_exp + 1;
    }
    return formatted_exp;
}

pub fn audit_do_work(log: &AuditLog) -> Int {
    let total_dw: Int = (log).total_events;
    let vcount_dw: Int = (log).violation_count;
    let cs_dw: Int = (log).checksum;
    let evts_dw: List[AuditEvent] = (log).events;
    let n_dw = list_len(evts_dw);
    return total_dw + vcount_dw + cs_dw + n_dw;
}

pub fn audit_query_probe() -> Int {
    return 0;
}
