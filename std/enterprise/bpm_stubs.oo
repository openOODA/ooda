// # BPM Fail-Closed Stubs
//
// Logline: Hard compiler limitations for dynamic BPM script bytecode and BPMN XML stream parse that fail-closed via process_exit(1).
//
// Setup: openOODA lacks dynamic bytecode interpretation, raw pointers, and stream parsing for BPMN/XML.
//
// Beats:
//   1. bpm_execute_script_task_bytecode.
//   2. bpm_parse_bpmn_xml_stream.

pub fn bpm_execute_script_task_bytecode(script_ptr: Int, len: Int) -> Int {
    process_exit(1);
    return 0;
}

pub fn bpm_parse_bpmn_xml_stream(stream_ptr: Int, count: Int) -> Bool {
    process_exit(1);
    return false;
}
