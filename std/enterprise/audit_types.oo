// # Audit Domain Types
//
// Logline: Define AuditEvent, AuditPolicy, and AuditLog records with severity and seal fields.
//
// Setup: Self-contained type module. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. AuditEvent: bind event_id, action, actor, and severity.
//   2. AuditPolicy: bind min_severity, fail_closed, and require_sys_cap.
//   3. AuditLog: bind tenant_id, policy, events, and is_sealed.
//   4. audit_event_severity_to_int: map severity tag to int level.
//
// residual: struct-only module; no logic.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

type AuditEvent = struct {
    event_id: Int,
    timestamp: Int,
    severity: Int,
    action: String,
    actor: String,
    resource: String,
    status: String,
    detail: String,
};

type AuditPolicy = struct {
    min_severity: Int,
    fail_closed: Bool,
    max_events: Int,
    require_sys_cap: Bool,
    is_active: Bool,
};

type AuditLog = struct {
    tenant_id: String,
    policy: AuditPolicy,
    events: List[AuditEvent],
    total_events: Int,
    violation_count: Int,
    checksum: Int,
    is_sealed: Bool,
};

// -------------------------------------------------------------------
// Severity & Event Helpers
// -------------------------------------------------------------------

pub fn audit_severity_to_string(severity: Int) -> String {
    if severity == 0 {
        return "DEBUG";
    }
    if severity == 1 {
        return "INFO";
    }
    if severity == 2 {
        return "WARNING";
    }
    if severity == 3 {
        return "ERROR";
    }
    if severity >= 4 {
        return "CRITICAL";
    }
    return "UNKNOWN";
}

pub fn audit_event_create(
    event_id: Int,
    timestamp: Int,
    severity: Int,
    action: String,
    actor: String,
    resource: String,
    status: String,
    detail: String
) -> AuditEvent {
    return AuditEvent {
        event_id: event_id,
        timestamp: timestamp,
        severity: severity,
        action: action,
        actor: actor,
        resource: resource,
        status: status,
        detail: detail
    };
}

pub fn audit_event_to_string(evt: AuditEvent) -> String {
    let e_s: AuditEvent = evt;
    let sev_val: Int = (e_s).severity;
    let ts_val: Int = (e_s).timestamp;
    let id_val: Int = (e_s).event_id;
    let act_s: String = (e_s).action;
    let actor_s: String = (e_s).actor;
    let res_s: String = (e_s).resource;
    let st_s: String = (e_s).status;
    let det_s: String = (e_s).detail;
    let sev_str: String = audit_severity_to_string(sev_val);
    let ts_str: String = ts_val.to_string();
    let id_str: String = id_val.to_string();
    return "[" + ts_str + "] [ID:" + id_str + "] [" + sev_str + "] [" + actor_s + "] " + act_s + " " + res_s + " -> " + st_s + ": " + det_s;
}

pub fn audit_event_calculate_hash(evt: AuditEvent) -> Int {
    let e_h: AuditEvent = evt;
    let ev_id_h: Int = (e_h).event_id;
    let ts_h: Int = (e_h).timestamp;
    let sev_h: Int = (e_h).severity;
    let act_h: String = (e_h).action;
    let actor_h: String = (e_h).actor;
    let res_h: String = (e_h).resource;
    let mut h = ev_id_h * 17 + ts_h * 31 + sev_h * 101;
    let act_len = act_h.len();
    let actor_len = actor_h.len();
    let res_len = res_h.len();
    h = h + act_len * 7 + actor_len * 13 + res_len * 19;
    return h;
}
