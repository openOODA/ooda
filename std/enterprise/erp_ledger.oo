// # Enterprise Resource Planning Ledger, Purchase Orders, and Enterprise State
//
// Logline: Posts double-entry ledger transactions, manages purchase orders, and tracks enterprise cash, revenue, expenses, and financial health score.
//
// Setup: Imports erp.oo for inventory_add_stock and local type defs. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. transaction_create, ledger_post_transaction: double-entry debit and credit by account type.
//   2. purchase_order_create, purchase_order_receive, purchase_order_reject.
//   3. employee_init, employee_record_hours, employee_calculate_paycheck, employee_reset_hours.
//   4. enterprise_init, enterprise_record_sale, enterprise_record_expense, enterprise_net_income, enterprise_financial_health_score.

import "./erp.oo";

pub type Account = struct {
    account_id: Int, account_type: Int, balance: Int
};

pub type LedgerTransaction = struct {
    tx_id: Int, debit_account: Int, credit_account: Int, amount: Int, timestamp: Int, is_posted: Bool
};

pub type PurchaseOrder = struct {
    po_id: Int, vendor_id: Int, item_id: Int, quantity_ordered: Int, unit_cost: Int, status: Int
};

pub type EmployeeRecord = struct {
    employee_id: Int, department_id: Int, hourly_rate: Int, hours_worked: Int,
    base_salary: Int, is_active: Bool
};

pub type EnterpriseState = struct {
    company_id: Int, cash_reserve: Int, total_revenue: Int, total_expenses: Int, active_employees: Int
};

pub type Order = struct {
    id: Int, customer_id: Int, item_id: Int, quantity: Int, unit_price: Int,
    total_amount: Int, status: Int, is_paid: Bool
};

pub type InventoryItem = struct {
    id: Int, sku: Int, quantity: Int, reorder_point: Int, unit_price: Int, unit_cost: Int
};

pub fn transaction_create(tx_id: Int, debit_acc_id: Int, credit_acc_id: Int, amount: Int, ts: Int) -> LedgerTransaction {
    return LedgerTransaction {
        tx_id: tx_id, debit_account: debit_acc_id, credit_account: credit_acc_id,
        amount: amount, timestamp: ts, is_posted: false
    };
}

pub fn ledger_post_transaction(tx: &mut LedgerTransaction, debit_acc: &mut Account, credit_acc: &mut Account) -> Bool {
    let mut tx: LedgerTransaction = tx;
    let mut debit_acc: Account = debit_acc;
    let mut credit_acc: Account = credit_acc;
    if (tx).is_posted == true  { return false; }
    if (tx).amount <= 0  { return false; }
    if (debit_acc).account_id != (tx).debit_account  { return false; }
    if (credit_acc).account_id != (tx).credit_account  { return false; }
    let debit_type = (debit_acc).account_type;
    if debit_type == 0 {
        (debit_acc).balance = (debit_acc).balance + (tx).amount;
    } else if debit_type == 4 {
        (debit_acc).balance = (debit_acc).balance + (tx).amount;
    } else {
        (debit_acc).balance = (debit_acc).balance - (tx).amount;
    }
    let credit_type = (credit_acc).account_type;
    if credit_type == 0 {
        (credit_acc).balance = (credit_acc).balance - (tx).amount;
    } else if credit_type == 4 {
        (credit_acc).balance = (credit_acc).balance - (tx).amount;
    } else {
        (credit_acc).balance = (credit_acc).balance + (tx).amount;
    }
    (tx).is_posted = true;
    return true;
}

pub fn purchase_order_create(po_id: Int, vendor_id: Int, item_id: Int, qty: Int, unit_cost: Int) -> PurchaseOrder {
    return PurchaseOrder {
        po_id: po_id, vendor_id: vendor_id, item_id: item_id, quantity_ordered: qty,
        unit_cost: unit_cost, status: 0
    };
}

pub fn purchase_order_receive(po: &mut PurchaseOrder, item: &mut InventoryItem) -> Bool {
    let mut po: PurchaseOrder = po;
    let mut item: InventoryItem = item;
    if (po).status != 0  { return false; }
    if (po).item_id != (item).id  { return false; }
    let success = inventory_add_stock(&item, (po).quantity_ordered);
    if success == false  { return false; }
    (po).status = 1;
    return true;
}

pub fn purchase_order_reject(po: &mut PurchaseOrder) -> Bool {
    let mut po: PurchaseOrder = po;
    if (po).status != 0  { return false; }
    (po).status = 2;
    return true;
}

pub fn employee_init(id: Int, dept: Int, rate: Int, salary: Int) -> EmployeeRecord {
    return EmployeeRecord {
        employee_id: id, department_id: dept, hourly_rate: rate, hours_worked: 0,
        base_salary: salary, is_active: true
    };
}

pub fn employee_record_hours(emp: &mut EmployeeRecord, hours: Int) -> Bool {
    let mut emp: EmployeeRecord = emp;
    if (emp).is_active == false  { return false; }
    if hours <= 0  { return false; }
    (emp).hours_worked = (emp).hours_worked + hours;
    return true;
}

pub fn employee_calculate_paycheck(emp: &EmployeeRecord) -> Int {
    if (emp).is_active == false  { return 0; }
    if (emp).hourly_rate > 0  { return (emp).hourly_rate * (emp).hours_worked; }
    return (emp).base_salary;
}

pub fn employee_reset_hours(emp: &mut EmployeeRecord) {
    let mut emp: EmployeeRecord = emp;
    (emp).hours_worked = 0;
}

pub fn enterprise_init(id: Int, initial_cash: Int) -> EnterpriseState {
    return EnterpriseState {
        company_id: id, cash_reserve: initial_cash, total_revenue: 0,
        total_expenses: 0, active_employees: 0
    };
}

pub fn enterprise_record_sale(ent: &mut EnterpriseState, order: &Order) -> Bool {
    let mut ent: EnterpriseState = ent;
    if (order).is_paid == false {
        return false;
    }
    if (order).status != 1 {
        return false;
    }
    (ent).cash_reserve = (ent).cash_reserve + (order).total_amount;
    (ent).total_revenue = (ent).total_revenue + (order).total_amount;
    return true;
}

pub fn enterprise_record_expense(ent: &mut EnterpriseState, amount: Int) -> Bool {
    let mut ent: EnterpriseState = ent;
    if amount <= 0  { return false; }
    if (ent).cash_reserve < amount {
        return false;
    }
    (ent).cash_reserve = (ent).cash_reserve - amount;
    (ent).total_expenses = (ent).total_expenses + amount;
    return true;
}

pub fn enterprise_net_income(ent: &EnterpriseState) -> Int {
    return (ent).total_revenue - (ent).total_expenses;
}

pub fn enterprise_financial_health_score(ent: &EnterpriseState) -> Int {
    let net = enterprise_net_income(ent);
    let cash = (ent).cash_reserve;
    let mut score = 50;
    if net > 0 {
        score = score + 25;
    } else if net < 0 {
        score = score - 25;
    }
    if cash > 1000000 {
        score = score + 25;
    } else if cash > 100000 {
        score = score + 10;
    } else if cash < 10000 {
        score = score - 20;
    }
    if score > 100  { score = 100; }
    if score < 0  { score = 0; }
    return score;
}
