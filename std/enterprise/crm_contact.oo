// # Customer Relationship Management Contact Operations
//
// Logline: Contact score management, lifecycle status transitions, and contact validation.
//
// Setup: Imports crm_types.oo for Contact structure.
//
// Beats:
//   1. Update customer activity scores and engagement deltas.
//   2. Transition contact lifecycle statuses.
//   3. Validate contact email and phone attributes.

import ./crm_types.oo;

pub fn contact_update_score(contact: &mut Contact, delta: Int) -> Bool {
    let active: Bool = (contact).is_active;
    if active == false  { return false; }
    let cur_score: Int = (contact).score;
    let mut new_score: Int = cur_score + delta;
    if new_score < 0  { new_score = 0; }
    (contact).score = new_score;
    return true;
}
pub fn contact_change_status(contact: &mut Contact, new_status: Int) -> Bool {
    let active: Bool = (contact).is_active;
    if active == false  { return false; }
    if new_status < 0  { return false; }
    if new_status > 3  { return false; }
    (contact).status = new_status;
    return true;
}
