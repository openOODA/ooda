// ===================================================================
// openOODA Standard Library — ooda::enterprise::audit_policy
// Audit policy management (split from audit.oo, Issue #15)
// ===================================================================

import "./audit_types.oo";

// -------------------------------------------------------------------
// Audit Policy Management
// -------------------------------------------------------------------

pub fn audit_policy_init(min_severity: Int, fail_closed: Bool, max_events: Int, require_cap: Bool) -> AuditPolicy {
    return AuditPolicy {
        min_severity: min_severity,
        fail_closed: fail_closed,
        max_events: max_events,
        require_sys_cap: require_cap,
        is_active: true,
    };
}

pub fn audit_policy_is_allowed(policy: AuditPolicy, severity: Int) -> Bool {
    let pol_p: AuditPolicy = policy;
    let active_p: Bool = pol_p.is_active;
    if active_p == false {
        return false;
    }
    let min_sev_p: Int = pol_p.min_severity;
    if severity < min_sev_p {
        return false;
    }
    return true;
}
