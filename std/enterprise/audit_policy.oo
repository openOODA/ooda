// # Audit Policy Management
//
// Logline: Construct an AuditPolicy and gate event severity against the active policy.
//
// Setup: Imports ./audit_types.oo. RULES.oot 1.3 fail-closed for unbuilt syslog.
//
// Beats:
//   1. audit_policy_init: build a strict AuditPolicy with is_active=true and require_sys_cap.
//   2. audit_policy_is_allowed: refuse if is_active is false.
//   3. audit_policy_is_allowed: refuse if severity < min_severity.
//   4. audit_policy_is_allowed: return true on the policy gate pass.
//
// residual: not the full audit chain; syslog is process_exit in audit_stubs.

import "./audit_types.oo";

// -------------------------------------------------------------------
// Audit Policy Management
// -------------------------------------------------------------------

pub fn audit_policy_init(min_severity: Int, fail_closed: Bool, max_events: Int, require_cap: Bool) -> AuditPolicy {
    return AuditPolicy {
        min_severity: min_severity,
        fail_closed: fail_closed,
        max_events: max_events,
        require_sys_cap: require_cap,
        is_active: true
    };
}

pub fn audit_policy_is_allowed(policy: AuditPolicy, severity: Int) -> Bool {
    let pol_p: AuditPolicy = policy;
    let active_p: Bool = (pol_p).is_active;
    if active_p == false {
        return false;
    }
    let min_sev_p: Int = (pol_p).min_severity;
    if severity < min_sev_p {
        return false;
    }
    return true;
}
