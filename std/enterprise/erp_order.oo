// # Enterprise Resource Planning Order Operations
//
// Logline: Construct, fulfill, cancel, and mark-paid Order and PurchaseOrder lifecycle.
//
// Setup: 0=Pending, 1=Fulfilled/Received, 2=Cancelled/Rejected. Fail-closed on item id mismatch.
//
// Beats:
//   1. order_create, order_fulfill, order_cancel, order_mark_paid.
//   2. purchase_order_create, purchase_order_receive, purchase_order_reject.

import "./erp_types.oo";
import "./erp_inventory.oo";

pub fn order_create(id: Int, customer_id: Int, item_id: Int, qty: Int, unit_price: Int) -> Order {
    let total = qty * unit_price;
    return Order {
        id: id,
        customer_id: customer_id,
        item_id: item_id,
        quantity: qty,
        unit_price: unit_price,
        total_amount: total,
        status: 0, // 0 = Pending
        is_paid: false,
    };
}

pub fn order_fulfill(order: &mut Order, item: &mut InventoryItem) -> Bool {
    if (order).status != 0 {
        return false;
    }
    if (order).item_id != (item).id {
        return false;
    }
    let success = inventory_remove_stock(item, (order).quantity);
    if success == false {
        return false;
    }
    (order).status = 1; // 1 = Fulfilled
    return true;
}

pub fn order_cancel(order: &mut Order, item: &mut InventoryItem) -> Bool {
    if (order).status == 2 {
        return false; // Already cancelled
    }
    if (order).status == 1 {
        // Return inventory if order was previously fulfilled
        inventory_add_stock(item, (order).quantity);
    }
    (order).status = 2; // 2 = Cancelled
    return true;
}

pub fn order_mark_paid(order: &mut Order) -> Bool {
    if (order).is_paid == true {
        return false;
    }
    (order).is_paid = true;
    return true;
}

pub fn purchase_order_create(po_id: Int, vendor_id: Int, item_id: Int, qty: Int, unit_cost: Int) -> PurchaseOrder {
    return PurchaseOrder {
        po_id: po_id,
        vendor_id: vendor_id,
        item_id: item_id,
        quantity_ordered: qty,
        unit_cost: unit_cost,
        status: 0, // 0 = Pending
    };
}

pub fn purchase_order_receive(po: &mut PurchaseOrder, item: &mut InventoryItem) -> Bool {
    if (po).status != 0 {
        return false;
    }
    if (po).item_id != (item).id {
        return false;
    }
    let success = inventory_add_stock(item, (po).quantity_ordered);
    if success == false {
        return false;
    }
    (po).status = 1; // 1 = Received
    return true;
}

pub fn purchase_order_reject(po: &mut PurchaseOrder) -> Bool {
    if (po).status != 0 {
        return false;
    }
    (po).status = 2; // 2 = Rejected
    return true;
}
