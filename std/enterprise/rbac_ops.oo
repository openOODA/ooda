// # RBAC Engine Mutators and Role Assignment Operations
//
// Logline: Provides rbac_add_role, rbac_assign_role, rbac_revoke_role, and rbac_set_user_active mutators for the RbacEngine, plus rbac_has_role lookup.
//
// Setup: Imports rbac.oo for Permission, Role, UserAssignment, and RbacEngine. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. rbac_add_role: dedup-by-name or append a Role to the engine.
//   2. rbac_has_role: scan the engine for a given role name and return its is_active flag.
//   3. rbac_assign_role and rbac_revoke_role: append / remove a role from a user's assignment.
//   4. rbac_set_user_active: flip the is_active flag on a user.

import "./rbac.oo";

pub fn rbac_add_role(engine: &mut RbacEngine, role: Role) {
    let mut engine: RbacEngine = engine;
    let mut role_list: List[Role] = list_new();
    let mut current_roles: List[Role] = (engine).roles;
    let n = list_len(current_roles);
    let mut i = 0;
    let mut replaced = false;
    while i < n {
        let r: Role = list_get(current_roles, i);
        let r_name: String = (r).name;
        let role_name_v: String = (role).name;
        let is_match: Bool = r_name == role_name_v;
        if is_match {
            role_list = list_push(role_list, role);
            replaced = true;
        } else {
            role_list = list_push(role_list, r);
        }
        i = i + 1;
    }
    if replaced == false {
        role_list = list_push(role_list, role);
    }
    (engine).roles = role_list;
}

pub fn rbac_has_role(engine: &RbacEngine, role_name: String) -> Bool {
    let mut current_roles: List[Role] = (engine).roles;
    let n = list_len(current_roles);
    let mut i = 0;
    while i < n {
        let r: Role = list_get(current_roles, i);
        let r_name: String = r.name;
        if r_name == role_name {
            return r.is_active;
        }
        i = i + 1;
    }
    return false;
}

pub fn rbac_assign_role(engine: &mut RbacEngine, user_id: String, role_name: String) {
    let mut engine: RbacEngine = engine;
    let mut user_list: List[UserAssignment] = list_new();
    let mut current_users: List[UserAssignment] = (engine).users;
    let n = list_len(current_users);
    let mut i = 0;
    let mut user_found = false;
    while i < n {
        let u: UserAssignment = list_get(current_users, i);
        let u_id: String = u.user_id;
        if u_id == user_id {
            user_found = true;
            let updated_u: UserAssignment = user_assignment_add_role(u, role_name);
            user_list = list_push(user_list, updated_u);
        } else {
            user_list = list_push(user_list, u);
        }
        i = i + 1;
    }
    if user_found == false {
        let new_u: UserAssignment = user_assignment_create(user_id);
        let updated_u: UserAssignment = user_assignment_add_role(new_u, role_name);
        user_list = list_push(user_list, updated_u);
    }
    (engine).users = user_list;
}

pub fn rbac_revoke_role(engine: &mut RbacEngine, user_id: String, role_name: String) {
    let mut engine: RbacEngine = engine;
    let mut user_list: List[UserAssignment] = list_new();
    let mut current_users: List[UserAssignment] = (engine).users;
    let n = list_len(current_users);
    let mut i = 0;
    while i < n {
        let u: UserAssignment = list_get(current_users, i);
        let u_id: String = u.user_id;
        if u_id == user_id {
            let updated_u: UserAssignment = user_assignment_remove_role(u, role_name);
            user_list = list_push(user_list, updated_u);
        } else {
            user_list = list_push(user_list, u);
        }
        i = i + 1;
    }
    (engine).users = user_list;
}

pub fn rbac_set_user_active(engine: &mut RbacEngine, user_id: String, active: Bool) {
    let mut engine: RbacEngine = engine;
    let mut user_list: List[UserAssignment] = list_new();
    let mut current_users: List[UserAssignment] = (engine).users;
    let n = list_len(current_users);
    let mut i = 0;
    while i < n {
        let u: UserAssignment = list_get(current_users, i);
        let u_id: String = u.user_id;
        if u_id == user_id {
            let updated_u: UserAssignment = user_assignment_set_active(u, active);
            user_list = list_push(user_list, updated_u);
        } else {
            user_list = list_push(user_list, u);
        }
        i = i + 1;
    }
    (engine).users = user_list;
}
