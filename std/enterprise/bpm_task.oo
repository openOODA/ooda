// # BPM Task Instance Lifecycle
//
// Logline: task_instance_create / start / approve / reject / complete / cancel / is_overdue.
//
// Setup: Status codes: 0=Pending, 1=In_Progress, 2=Approved, 3=Rejected, 4=Completed, 5=Cancelled.
//
// Beats:
//   1. Start: only from Pending.
//   2. Approve / Reject: only from In_Progress or Pending.
//   3. Complete / Cancel: gate Completed and Cancelled.

import "./bpm_types.oo";

pub fn task_instance_create(task_id: Int, instance_id: Int, step_id: Int, assignee_id: Int, due_date: Int, priority: Int) -> TaskInstance {
    return TaskInstance {
        task_id: task_id,
        instance_id: instance_id,
        step_id: step_id,
        assignee_id: assignee_id,
        status: 0,
        due_date: due_date,
        priority: priority
    };
}

pub fn task_instance_start(task: &mut TaskInstance) -> Bool {
    if (task).status != 0 {
        return false;
    }
    (task).status = 1;
    return true;
}

pub fn task_instance_approve(task: &mut TaskInstance) -> Bool {
    if (task).status != 1 {
        if (task).status != 0 {
            return false;
        }
    }
    (task).status = 2;
    return true;
}

pub fn task_instance_reject(task: &mut TaskInstance) -> Bool {
    if (task).status != 1 {
        if (task).status != 0 {
            return false;
        }
    }
    (task).status = 3;
    return true;
}

pub fn task_instance_complete(task: &mut TaskInstance) -> Bool {
    let st = (task).status;
    if st == 4 {
        return false;
    }
    if st == 5 {
        return false;
    }
    (task).status = 4;
    return true;
}

pub fn task_instance_cancel(task: &mut TaskInstance) -> Bool {
    if (task).status == 4 {
        return false;
    }
    (task).status = 5;
    return true;
}

pub fn task_instance_is_overdue(task: &TaskInstance, current_time: Int) -> Bool {
    if (task).status == 4 {
        return false;
    }
    if (task).due_date <= 0 {
        return false;
    }
    return current_time > (task).due_date;
}
