// # Enterprise Resource Planning Domain Types
//
// Logline: Track InventoryItem, Order, Account, LedgerTransaction, PurchaseOrder, EmployeeRecord, and EnterpriseState carriers.
//
// Setup: Self-contained domain module. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. InventoryItem, Order, Account carriers.
//   2. LedgerTransaction, PurchaseOrder carriers.
//   3. EmployeeRecord, EnterpriseState carriers.

pub type InventoryItem = struct {
    id: Int,
    sku: Int,
    quantity: Int,
    reorder_point: Int,
    unit_price: Int,
    unit_cost: Int,
};

pub type Order = struct {
    id: Int,
    customer_id: Int,
    item_id: Int,
    quantity: Int,
    unit_price: Int,
    total_amount: Int,
    status: Int,
    is_paid: Bool,
};

pub type Account = struct {
    account_id: Int,
    account_type: Int,
    balance: Int,
};

pub type LedgerTransaction = struct {
    tx_id: Int,
    debit_account: Int,
    credit_account: Int,
    amount: Int,
    timestamp: Int,
    is_posted: Bool,
};

pub type PurchaseOrder = struct {
    po_id: Int,
    vendor_id: Int,
    item_id: Int,
    quantity_ordered: Int,
    unit_cost: Int,
    status: Int,
};

pub type EmployeeRecord = struct {
    employee_id: Int,
    department_id: Int,
    hourly_rate: Int,
    hours_worked: Int,
    base_salary: Int,
    is_active: Bool,
};

pub type EnterpriseState = struct {
    company_id: Int,
    cash_reserve: Int,
    total_revenue: Int,
    total_expenses: Int,
    active_employees: Int,
};
