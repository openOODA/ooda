// # Customer Relationship Management Engine Store Mutators
//
// Logline: Adds customer, deal, interaction, and campaign records to the CrmEngine, with id-based replace-or-append semantics and won/lost tally on close.
//
// Setup: Imports crm_types.oo for record types. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. crm_add_customer: replace-by-id or append a Contact.
//   2. crm_add_deal: replace-by-id or append a Deal and bump won or lost counters.
//   3. crm_add_interaction and crm_add_campaign: append Interaction and Campaign.

import "./crm_types.oo";

type Contact = struct {
    id: Int, name: String, email: String, phone: String, company_id: Int,
    status: Int, score: Int, is_active: Bool
};

type Deal = struct {
    id: Int, customer_id: Int, title: String, amount: Int, stage: Int,
    probability: Int, is_closed: Bool, is_won: Bool
};

type Interaction = struct {
    id: Int, customer_id: Int, deal_id: Int, interaction_type: Int,
    summary: String, timestamp: Int
};

type Campaign = struct {
    id: Int, name: String, budget: Int, spent: Int, leads_generated: Int,
    conversions: Int, is_active: Bool
};

type CrmEngine = struct {
    customers: List[Contact], deals: List[Deal], interactions: List[Interaction], campaigns: List[Campaign],
    strict_mode: Bool, total_deals_won: Int, total_deals_lost: Int
};

pub fn crm_add_customer(engine: &mut CrmEngine, c_item: Contact) {
    let mut engine: CrmEngine = engine;
    let mut new_custs: List[Contact] = list_new();
    let old_custs = (engine).customers;
    let n = list_len(old_custs);
    let mut i = 0;
    let mut replaced = false;
    let target_id = c_item.id;
    while i < n {
        let c = list_get(old_custs, i);
        let c_id: Int = c.id;
        if c_id == target_id {
            new_custs = list_push(new_custs, c_item);
            replaced = true;
        } else {
            new_custs = list_push(new_custs, c);
        }
        i = i + 1;
    }
    if replaced == false  { new_custs = list_push(new_custs, c_item); }
    (engine).customers = new_custs;
}

pub fn crm_add_deal(engine: &mut CrmEngine, d_item: Deal) {
    let mut engine: CrmEngine = engine;
    let mut new_deals: List[Deal] = list_new();
    let old_deals = (engine).deals;
    let n = list_len(old_deals);
    let mut i = 0;
    let mut replaced = false;
    let target_id = d_item.id;
    while i < n {
        let d = list_get(old_deals, i);
        let d_id: Int = d.id;
        if d_id == target_id {
            new_deals = list_push(new_deals, d_item);
            replaced = true;
        } else {
            new_deals = list_push(new_deals, d);
        }
        i = i + 1;
    }
    if replaced == false  { new_deals = list_push(new_deals, d_item); }
    (engine).deals = new_deals;
    let closed: Bool = d_item.is_closed;
    let won: Bool = d_item.is_won;
    if closed {
        if won {
            let mut won_c = (engine).total_deals_won;
            won_c = won_c + 1;
            (engine).total_deals_won = won_c;
        } else {
            let mut lost_c = (engine).total_deals_lost;
            lost_c = lost_c + 1;
            (engine).total_deals_lost = lost_c;
        }
    }
}

pub fn crm_add_interaction(engine: &mut CrmEngine, interaction: Interaction) {
    let mut engine: CrmEngine = engine;
    let mut new_inters: List[Interaction] = list_new();
    let old_inters = (engine).interactions;
    let n = list_len(old_inters);
    let mut i = 0;
    while i < n {
        new_inters = list_push(new_inters, list_get(old_inters, i));
        i = i + 1;
    }
    new_inters = list_push(new_inters, interaction);
    (engine).interactions = new_inters;
}

pub fn crm_add_campaign(engine: &mut CrmEngine, camp_item: Campaign) {
    let mut engine: CrmEngine = engine;
    let mut new_camps: List[Campaign] = list_new();
    let old_camps = (engine).campaigns;
    let n = list_len(old_camps);
    let mut i = 0;
    let mut replaced = false;
    let target_id: Int = camp_item.id;
    while i < n {
        let c = list_get(old_camps, i);
        let c_id: Int = c.id;
        if c_id == target_id {
            new_camps = list_push(new_camps, camp_item);
            replaced = true;
        } else {
            new_camps = list_push(new_camps, c);
        }
        i = i + 1;
    }
    if replaced == false  { new_camps = list_push(new_camps, camp_item); }
    (engine).campaigns = new_camps;
}
