// # Customer Relationship Management Campaign Operations
//
// Logline: Marketing campaign metrics, lead generation tracking, and conversion performance.
//
// Setup: Imports crm_types.oo for Campaign structures.
//
// Beats:
//   1. Instantiate marketing campaigns with budget and targets.
//   2. Record campaign lead generation events and conversions.
//   3. Calculate campaign return on investment.

import ./crm_types.oo;

pub fn campaign_record_lead(campaign: &mut Campaign) -> Bool {
    let active: Bool = (campaign).is_active;
    if active == false  { return false; }
    let cur_leads: Int = (campaign).leads_generated;
    (campaign).leads_generated = cur_leads + 1;
    return true;
}
pub fn campaign_record_conversion(campaign: &mut Campaign) -> Bool {
    let active: Bool = (campaign).is_active;
    if active == false  { return false; }
    let cur_conv: Int = (campaign).conversions;
    (campaign).conversions = cur_conv + 1;
    return true;
}
