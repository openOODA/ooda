// # Customer Relationship Management Types
//
// Logline: Define Contact, Deal, and Interaction models.
//
// Setup: Core data types and structured models.
//
// Beats:
//   1. Declare customer and lead contact entities.
//   2. Declare commercial deal lifecycle models.
//   3. Declare interaction and activity history records.

pub type Contact = struct {
    id: Int, name: String, email: String, phone: String, company_id: Int,
    status: Int, score: Int, is_active: Bool
};
pub type Deal = struct {
    id: Int, customer_id: Int, title: String, amount: Int, stage: Int,
    probability: Int, is_closed: Bool, is_won: Bool
};
pub type Interaction = struct {
    id: Int, customer_id: Int, deal_id: Int, interaction_type: Int,
    summary: String, timestamp: Int
};
pub type Campaign = struct {
    id: Int, name: String, budget: Int, spent: Int, leads_generated: Int,
    conversions: Int, is_active: Bool
};
pub type CrmEngine = struct {
    customers: List[Contact], deals: List[Deal],
    interactions: List[Interaction], campaigns: List[Campaign], strict_mode: Bool,
    total_deals_won: Int, total_deals_lost: Int
};

pub fn contact_create(id: Int, name: String, email: String, phone: String, company_id: Int) -> Contact {
    return Contact {
        id: id, name: name, email: email, phone: phone, company_id: company_id,
        status: 0, score: 0, is_active: true
    };
}
pub fn interaction_create(id: Int, customer_id: Int, deal_id: Int, itype: Int, summary: String, ts: Int) -> Interaction {
    return Interaction {
        id: id, customer_id: customer_id, deal_id: deal_id, interaction_type: itype,
        summary: summary, timestamp: ts
    };
}
pub fn campaign_create(id: Int, name: String, budget: Int) -> Campaign {
    return Campaign {
        id: id, name: name, budget: budget, spent: 0, leads_generated: 0,
        conversions: 0, is_active: true
    };
}
pub fn crm_engine_init() -> CrmEngine {
    let custs: List[Contact] = list_new();
    let dls: List[Deal] = list_new();
    let inters: List[Interaction] = list_new();
    let camps: List[Campaign] = list_new();
    return CrmEngine {
        customers: custs, deals: dls, interactions: inters, campaigns: camps,
        strict_mode: true, total_deals_won: 0, total_deals_lost: 0
    };
}
