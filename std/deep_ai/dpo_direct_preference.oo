// # Direct Preference Optimization (DPO) Loss & Margin Engine
//
// Logline: Computes exact DPO objective loss, reference model log-odds ratios, and implicit reward margins without separate reward models.
//
// Setup: Mathematical DPO loss formulation for alignment training.
//
// Beats:
//   1. Define DPOConfig, PreferencePair, and DPOLossMetrics structures.
//   2. Compute policy and reference log-likelihood differences.
//   3. Evaluate -log sigma(beta * (Delta log pi_theta - Delta log pi_ref)) with implicit reward margin.

pub type DPOConfig = struct {
    beta: Float,
    label_smoothing: Float,
};

pub type PreferencePair = struct {
    logp_policy_win: Float,
    logp_policy_lose: Float,
    logp_ref_win: Float,
    logp_ref_lose: Float,
};

pub type DPOLossMetrics = struct {
    loss: Float,
    reward_win: Float,
    reward_lose: Float,
    reward_margin: Float,
    win_accuracy: Float,
};

pub fn dpo_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn dpo_config_new(beta: Float, smoothing: Float) -> DPOConfig {
    return DPOConfig {
        beta: beta,
        label_smoothing: smoothing,
    };
}

pub fn dpo_log_sigmoid(x: Float) -> Float {
    if x > 30.0 {
        return 0.0 - exp(0.0 - x);
    }
    if x < (0.0 - 30.0) {
        return x;
    }
    return 0.0 - ln(1.0 + exp(0.0 - x));
}

pub fn dpo_compute_loss(
    pair: &PreferencePair,
    cfg: &DPOConfig
) -> DPOLossMetrics {
    let b: Float = (cfg).beta;
    let pi_log_ratio: Float = (pair).logp_policy_win - (pair).logp_policy_lose;
    let ref_log_ratio: Float = (pair).logp_ref_win - (pair).logp_ref_lose;

    let logit: Float = b * (pi_log_ratio - ref_log_ratio);

    let smooth: Float = (cfg).label_smoothing;
    let loss_main: Float = 0.0 - dpo_log_sigmoid(logit);
    let loss_reverse: Float = 0.0 - dpo_log_sigmoid(0.0 - logit);
    let final_loss: Float = ((1.0 - smooth) * loss_main) + (smooth * loss_reverse);

    let r_win: Float = b * ((pair).logp_policy_win - (pair).logp_ref_win);
    let r_lose: Float = b * ((pair).logp_policy_lose - (pair).logp_ref_lose);
    let margin: Float = r_win - r_lose;
    let acc: Float = if margin > 0.0 { 1.0 } else { 0.0 };

    return DPOLossMetrics {
        loss: final_loss,
        reward_win: r_win,
        reward_lose: r_lose,
        reward_margin: margin,
        win_accuracy: acc,
    };
}

pub fn dpo_batch_loss(
    pairs: List[PreferencePair],
    cfg: &DPOConfig
) -> Float {
    let n: Int = list_len(pairs);
    if n == 0 {
        return 0.0;
    }

    let mut total_loss: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let p: PreferencePair = list_get(pairs, i);
        let m: DPOLossMetrics = dpo_compute_loss(&p, cfg);
        total_loss = total_loss + (m).loss;
        i = i + 1;
    }

    return total_loss / dpo_int_to_float(n);
}

pub fn dpo_direct_preference_marker() -> Int {
    return 1;
}
