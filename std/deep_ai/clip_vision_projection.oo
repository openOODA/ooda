// # CLIP Multi-Modal Vision-to-Language Cross-Projection
//
// Logline: Projects Vision Transformer (ViT) patch representations into text embedding space with multi-modal linear projection and cosine similarity.
//
// Setup: Multi-modal linear projection and cross-modal similarity scoring for vision-language models.
//
// Beats:
//   1. Define CLIPVisionConfig and VisionProjectionLayer structures.
//   2. Project patch representations from vision dimension to text dimension.
//   3. Compute normalized visual-textual cosine similarity with temperature scaling.

pub type CLIPVisionConfig = struct {
    vision_dim: Int,
    text_dim: Int,
    num_patches: Int,
    temp_scale: Float,
};

pub type VisionProjectionLayer = struct {
    weight: List[Float],
    bias: List[Float],
    config: CLIPVisionConfig,
};

pub fn clip_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn clip_projection_new(
    vis_dim: Int,
    txt_dim: Int,
    num_patches: Int,
    temp: Float
) -> VisionProjectionLayer {
    let w_size: Int = vis_dim * txt_dim;
    let mut w_data: List[Float] = list_new();
    let mut i: Int = 0;
    while i < w_size {
        w_data = list_push(w_data, 0.02);
        i = i + 1;
    }

    let mut b_data: List[Float] = list_new();
    let mut j: Int = 0;
    while j < txt_dim {
        b_data = list_push(b_data, 0.0);
        j = j + 1;
    }

    let cfg: CLIPVisionConfig = CLIPVisionConfig {
        vision_dim: vis_dim,
        text_dim: txt_dim,
        num_patches: num_patches,
        temp_scale: temp,
    };

    return VisionProjectionLayer {
        weight: w_data,
        bias: b_data,
        config: cfg,
    };
}

pub fn clip_project_patch_embeddings(
    layer: &VisionProjectionLayer,
    patch_tokens: List[Float]
) -> List[Float] {
    let n_patches: Int = ((layer).config).num_patches;
    let vis_d: Int = ((layer).config).vision_dim;
    let txt_d: Int = ((layer).config).text_dim;

    let mut projected: List[Float] = list_new();

    let mut p: Int = 0;
    while p < n_patches {
        let mut t: Int = 0;
        while t < txt_d {
            let mut acc: Float = list_get((layer).bias, t);
            let mut v: Int = 0;
            while v < vis_d {
                let patch_val: Float = list_get(patch_tokens, (p * vis_d) + v);
                let w_val: Float = list_get((layer).weight, (v * txt_d) + t);
                acc = acc + (patch_val * w_val);
                v = v + 1;
            }
            projected = list_push(projected, acc);
            t = t + 1;
        }
        p = p + 1;
    }

    return projected;
}

pub fn clip_cosine_similarity(
    vis_emb: List[Float],
    txt_emb: List[Float],
    temp: Float
) -> Float {
    let dim: Int = list_len(vis_emb);
    let mut dot: Float = 0.0;
    let mut norm_v_sq: Float = 0.0;
    let mut norm_t_sq: Float = 0.0;

    let mut i: Int = 0;
    while i < dim {
        let v: Float = list_get(vis_emb, i);
        let t: Float = if i < list_len(txt_emb) { list_get(txt_emb, i) } else { 0.0 };
        dot = dot + (v * t);
        norm_v_sq = norm_v_sq + (v * v);
        norm_t_sq = norm_t_sq + (t * t);
        i = i + 1;
    }

    let norm_v: Float = sqrt(norm_v_sq);
    let norm_t: Float = sqrt(norm_t_sq);
    let denom: Float = norm_v * norm_t;

    let cos_sim: Float = if denom > 0.000001 { dot / denom } else { 0.0 };
    let t_scale: Float = if temp > 0.0001 { temp } else { 1.0 };
    return cos_sim * t_scale;
}

pub fn clip_vision_projection_marker() -> Int {
    return 1;
}
