// # ALiBi linear token-position slopes
//
// Logline: Press slope=2^(-8(h+1)/H). bias=slope*(j-i). Causal mask -1e5.
// residual: destubbed to Int floor.

type ALiBiConfig = struct {
    num_heads: Int,
    max_seq: Int
}

type ALiBiBias2 = struct {
    b00: Int,
    b01: Int,
    b10: Int,
    b11: Int
}

fn alibi_inv_pow2_milli(expn: Int) -> Int {
    if expn <= 0 {
        return 1000;
    }
    if expn == 1 {
        return 500;
    }
    if expn == 2 {
        return 250;
    }
    if expn == 3 {
        return 125;
    }
    if expn == 4 {
        return 62;
    }
    if expn == 5 {
        return 31;
    }
    if expn == 6 {
        return 15;
    }
    if expn == 7 {
        return 7;
    }
    if expn == 8 {
        return 3;
    }
    return 1;
}

pub fn alibi_slope_milli(head_idx: Int, num_heads: Int) -> Int {
    if num_heads <= 0 {
        return 1000;
    }
    let numer: Int = 8 * (head_idx + 1);
    let ratio: Int = numer / num_heads;
    return alibi_inv_pow2_milli(ratio);
}

pub fn alibi_config_new(num_heads: Int, max_seq: Int) -> ALiBiConfig {
    return ALiBiConfig {
        num_heads: num_heads,
        max_seq: max_seq
    };
}

pub fn alibi_bias_at(slope_milli: Int, q: Int, k: Int, causal: Int) -> Int {
    if causal == 0 {
        return slope_milli * (k - q);
    }
    if k > q {
        return 0 - 100000;
    }
    return slope_milli * (k - q);
}

pub fn alibi_bias_matrix2(cfg: ALiBiConfig, head_idx: Int, causal: Int) -> ALiBiBias2 {
    let sl: Int = alibi_slope_milli(head_idx, cfg.num_heads);
    return ALiBiBias2 {
        b00: alibi_bias_at(sl, 0, 0, causal),
        b01: alibi_bias_at(sl, 0, 1, causal),
        b10: alibi_bias_at(sl, 1, 0, causal),
        b11: alibi_bias_at(sl, 1, 1, causal)
    };
}

pub fn alibi_apply_logits2(cfg: ALiBiConfig, head_idx: Int, l00: Int, l01: Int, l10: Int, l11: Int) -> ALiBiBias2 {
    let sl: Int = alibi_slope_milli(head_idx, cfg.num_heads);
    return ALiBiBias2 {
        b00: l00 + alibi_bias_at(sl, 0, 0, 0),
        b01: l01 + alibi_bias_at(sl, 0, 1, 0),
        b10: l10 + alibi_bias_at(sl, 1, 0, 0),
        b11: l11 + alibi_bias_at(sl, 1, 1, 0)
    };
}

pub fn alibi_b10(m: ALiBiBias2) -> Int {
    return m.b10;
}

pub fn alibi_b01(m: ALiBiBias2) -> Int {
    return m.b01;
}
