pub fn shim_deep_ai_marker() -> Int {
    return 1;
}

pub fn shim_flash_attn_block_new(bm: Int, bn: Int, hdim: Int, scale: Float, is_causal: Bool) -> BlockAttentionConfig {
    return block_attention_config_new(bm, bn, hdim, scale, is_causal);
}

pub fn shim_rope_config_new(dim: Int, max_len: Int, base: Float) -> RoPEConfig {
    return rope_config_new(dim, max_len, base);
}

pub fn shim_alibi_config_new(num_heads: Int, max_seq_len: Int) -> ALiBiConfig {
    return alibi_config_new(num_heads, max_seq_len);
}

pub fn shim_moe_router_config_new(embed_dim: Int, num_experts: Int, top_k: Int) -> MoERouterConfig {
    return moe_router_config_new(embed_dim, num_experts, top_k);
}

pub fn shim_lora_linear_new(in_dim: Int, out_dim: Int, rank: Int, alpha: Float) -> LoRALinearLayer {
    return lora_linear_new(in_dim, out_dim, rank, alpha);
}

pub fn shim_quant_kv_cache_new(cfg: QuantKVConfig) -> QuantKVCache {
