// # Low-Rank Adaptation (LoRA) Linear Adapter
//
// Logline: Injects trainable rank decomposition matrices A and B alongside frozen base linear weights with scaling ratio alpha / r.
//
// Setup: Low-rank linear adaptation layer with merging and unmerging operations.
//
// Beats:
//   1. Define LoRAConfig and LoRALinearLayer structures.
//   2. Implement forward projection Y = X * W_0 + (alpha / r) * (X * A^T) * B^T.
//   3. Provide adapter weight merge and unmerge operations for zero-overhead inference.

pub type LoRAConfig = struct {
    in_dim: Int,
    out_dim: Int,
    rank: Int,
    alpha: Float,
    is_merged: Bool,
};

pub type LoRALinearLayer = struct {
    w_base: List[Float],
    lora_a: List[Float],
    lora_b: List[Float],
    config: LoRAConfig,
};

pub fn lora_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 10000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn lora_linear_new(
    in_dim: Int,
    out_dim: Int,
    rank: Int,
    alpha: Float
) -> LoRALinearLayer {
    let base_size: Int = in_dim * out_dim;
    let mut base: List[Float] = list_new();
    let mut i: Int = 0;
    while i < base_size {
        base = list_push(base, 0.05);
        i = i + 1;
    }

    let a_size: Int = in_dim * rank;
    let mut la: List[Float] = list_new();
    let mut j: Int = 0;
    while j < a_size {
        la = list_push(la, 0.01);
        j = j + 1;
    }

    let b_size: Int = rank * out_dim;
    let mut lb: List[Float] = list_new();
    let mut k: Int = 0;
    while k < b_size {
        lb = list_push(lb, 0.0);
        k = k + 1;
    }

    let cfg: LoRAConfig = LoRAConfig {
        in_dim: in_dim,
        out_dim: out_dim,
        rank: rank,
        alpha: alpha,
        is_merged: false,
    };

    return LoRALinearLayer {
        w_base: base,
        lora_a: la,
        lora_b: lb,
        config: cfg,
    };
}

pub fn lora_linear_forward(
    layer: &LoRALinearLayer,
    x: List[Float]
) -> List[Float] {
    let in_d: Int = ((layer).config).in_dim;
    let out_d: Int = ((layer).config).out_dim;
    let r: Int = ((layer).config).rank;
    let scale: Float = ((layer).config).alpha / lora_int_to_float(r);
    let is_merged: Bool = ((layer).config).is_merged;

    let mut out: List[Float] = list_new();
    let mut o: Int = 0;
    while o < out_d {
        let mut base_acc: Float = 0.0;
        let mut d: Int = 0;
        while d < in_d {
            let x_val: Float = list_get(x, d);
            let w_val: Float = list_get((layer).w_base, (d * out_d) + o);
            base_acc = base_acc + (x_val * w_val);
            d = d + 1;
        }
        out = list_push(out, base_acc);
        o = o + 1;
    }

    if is_merged {
        return out;
    }

    let mut lora_hidden: List[Float] = list_new();
    let mut r_idx: Int = 0;
    while r_idx < r {
        let mut a_acc: Float = 0.0;
        let mut d2: Int = 0;
        while d2 < in_d {
            let x_val: Float = list_get(x, d2);
            let a_val: Float = list_get((layer).lora_a, (d2 * r) + r_idx);
            a_acc = a_acc + (x_val * a_val);
            d2 = d2 + 1;
        }
        lora_hidden = list_push(lora_hidden, a_acc);
        r_idx = r_idx + 1;
    }

    let mut final_out: List[Float] = list_new();
    let mut o2: Int = 0;
    while o2 < out_d {
        let mut b_acc: Float = 0.0;
        let mut r_i: Int = 0;
        while r_i < r {
            let h_val: Float = list_get(lora_hidden, r_i);
            let b_val: Float = list_get((layer).lora_b, (r_i * out_d) + o2);
            b_acc = b_acc + (h_val * b_val);
            r_i = r_i + 1;
        }
        let base_val: Float = list_get(out, o2);
        final_out = list_push(final_out, base_val + (b_acc * scale));
        o2 = o2 + 1;
    }

    return final_out;
}

pub fn lora_merge_weights(layer: &mut LoRALinearLayer) {
    if ((layer).config).is_merged {
        return;
    }
    let in_d: Int = ((layer).config).in_dim;
    let out_d: Int = ((layer).config).out_dim;
    let r: Int = ((layer).config).rank;
    let scale: Float = ((layer).config).alpha / lora_int_to_float(r);

    let mut new_base: List[Float] = list_new();
    let mut i: Int = 0;
    while i < in_d {
        let mut o: Int = 0;
        while o < out_d {
            let mut delta: Float = 0.0;
            let mut r_i: Int = 0;
            while r_i < r {
                let a_val: Float = list_get((layer).lora_a, (i * r) + r_i);
                let b_val: Float = list_get((layer).lora_b, (r_i * out_d) + o);
                delta = delta + (a_val * b_val);
                r_i = r_i + 1;
            }
            let orig: Float = list_get((layer).w_base, (i * out_d) + o);
            new_base = list_push(new_base, orig + (delta * scale));
            o = o + 1;
        }
        i = i + 1;
    }

    (layer).w_base = new_base;
    ((layer).config).is_merged = true;
}

pub fn lora_unmerge_weights(layer: &mut LoRALinearLayer) {
    if !(((layer).config).is_merged) {
        return;
    }
    let in_d: Int = ((layer).config).in_dim;
    let out_d: Int = ((layer).config).out_dim;
    let r: Int = ((layer).config).rank;
    let scale: Float = ((layer).config).alpha / lora_int_to_float(r);

    let mut new_base: List[Float] = list_new();
    let mut i: Int = 0;
    while i < in_d {
        let mut o: Int = 0;
        while o < out_d {
            let mut delta: Float = 0.0;
            let mut r_i: Int = 0;
            while r_i < r {
                let a_val: Float = list_get((layer).lora_a, (i * r) + r_i);
                let b_val: Float = list_get((layer).lora_b, (r_i * out_d) + o);
                delta = delta + (a_val * b_val);
                r_i = r_i + 1;
            }
            let cur: Float = list_get((layer).w_base, (i * out_d) + o);
            new_base = list_push(new_base, cur - (delta * scale));
            o = o + 1;
        }
        i = i + 1;
    }

    (layer).w_base = new_base;
    ((layer).config).is_merged = false;
}

pub fn lora_linear_adapter_marker() -> Int {
    return 1;
}
