// # MoE top-k gate router
//
// Logline: 2-dim token, 4 experts, top-2 by gate logit, milli-renormalized weights.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type MoERouterConfig = struct {
    embed_dim: Int,
    num_experts: Int,
    top_k: Int
}

type MoEDecision = struct {
    exp0: Int,
    exp1: Int,
    w0_milli: Int,
    w1_milli: Int
}

type MoEPick = struct {
    idx: Int,
    logit: Int
}

pub fn moe_router_config_new(embed_dim: Int, num_experts: Int, top_k: Int) -> MoERouterConfig {
    return MoERouterConfig {
        embed_dim: embed_dim,
        num_experts: num_experts,
        top_k: top_k
    };
}

fn moe_consider(cur: MoEPick, logit: Int, idx: Int, avail: Int) -> MoEPick {
    if avail == 0 {
        return cur;
    }
    if cur.idx < 0 {
        return MoEPick { idx: idx, logit: logit };
    }
    if logit > cur.logit {
        return MoEPick { idx: idx, logit: logit };
    }
    return cur;
}

fn moe_avail(idx: Int, taken: Int) -> Int {
    if idx == taken {
        return 0;
    }
    return 1;
}

pub fn moe_router_forward(
    x0: Int,
    x1: Int,
    w00: Int,
    w01: Int,
    w02: Int,
    w03: Int,
    w10: Int,
    w11: Int,
    w12: Int,
    w13: Int
) -> MoEDecision {
    let l0: Int = (x0 * w00) + (x1 * w10);
    let l1: Int = (x0 * w01) + (x1 * w11);
    let l2: Int = (x0 * w02) + (x1 * w12);
    let l3: Int = (x0 * w03) + (x1 * w13);
    let empty: MoEPick = MoEPick { idx: 0 - 1, logit: 0 };
    let a0: MoEPick = moe_consider(empty, l0, 0, 1);
    let a1: MoEPick = moe_consider(a0, l1, 1, 1);
    let a2: MoEPick = moe_consider(a1, l2, 2, 1);
    let first: MoEPick = moe_consider(a2, l3, 3, 1);
    let b0: MoEPick = moe_consider(empty, l0, 0, moe_avail(0, first.idx));
    let b1: MoEPick = moe_consider(b0, l1, 1, moe_avail(1, first.idx));
    let b2: MoEPick = moe_consider(b1, l2, 2, moe_avail(2, first.idx));
    let second: MoEPick = moe_consider(b2, l3, 3, moe_avail(3, first.idx));
    let sum_l: Int = first.logit + second.logit;
    if sum_l == 0 {
        return MoEDecision {
            exp0: first.idx,
            exp1: second.idx,
            w0_milli: 500,
            w1_milli: 500
        };
    }
    return MoEDecision {
        exp0: first.idx,
        exp1: second.idx,
        w0_milli: (first.logit * 1000) / sum_l,
        w1_milli: (second.logit * 1000) / sum_l
    };
}

pub fn moe_decision_exp0(d: MoEDecision) -> Int {
    return d.exp0;
}

pub fn moe_decision_w0(d: MoEDecision) -> Int {
    return d.w0_milli;
}
