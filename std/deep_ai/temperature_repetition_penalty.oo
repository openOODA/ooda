// # Temperature and repetition token meter
//
// Logline: CTRL/HF repetition, presence, frequency penalties. 4-slot token counts.
// residual: destubbed to Int floor.

type PenaltyCfg = struct {
    temp_milli: Int,
    rep_milli: Int,
    pres_milli: Int,
    freq_milli: Int
}

type RepTracker = struct {
    vocab_size: Int,
    c0: Int,
    c1: Int,
    c2: Int,
    c3: Int
}

pub fn penalty_config_new(temp_milli: Int, rep_milli: Int, pres_milli: Int, freq_milli: Int) -> PenaltyCfg {
    return PenaltyCfg {
        temp_milli: temp_milli,
        rep_milli: rep_milli,
        pres_milli: pres_milli,
        freq_milli: freq_milli
    };
}

pub fn repetition_tracker_new(vocab_size: Int) -> RepTracker {
    return RepTracker {
        vocab_size: vocab_size,
        c0: 0,
        c1: 0,
        c2: 0,
        c3: 0
    };
}

pub fn repetition_tracker_record(tr: RepTracker, token_id: Int) -> RepTracker {
    if token_id < 0 {
        return tr;
    }
    if token_id >= tr.vocab_size {
        return tr;
    }
    if token_id == 0 {
        return RepTracker {
            vocab_size: tr.vocab_size,
            c0: tr.c0 + 1,
            c1: tr.c1,
            c2: tr.c2,
            c3: tr.c3
        };
    }
    if token_id == 1 {
        return RepTracker {
            vocab_size: tr.vocab_size,
            c0: tr.c0,
            c1: tr.c1 + 1,
            c2: tr.c2,
            c3: tr.c3
        };
    }
    if token_id == 2 {
        return RepTracker {
            vocab_size: tr.vocab_size,
            c0: tr.c0,
            c1: tr.c1,
            c2: tr.c2 + 1,
            c3: tr.c3
        };
    }
    if token_id == 3 {
        return RepTracker {
            vocab_size: tr.vocab_size,
            c0: tr.c0,
            c1: tr.c1,
            c2: tr.c2,
            c3: tr.c3 + 1
        };
    }
    return tr;
}

pub fn repetition_tracker_seen(tr: RepTracker, token_id: Int) -> Int {
    if token_id == 0 {
        return tr.c0;
    }
    if token_id == 1 {
        return tr.c1;
    }
    if token_id == 2 {
        return tr.c2;
    }
    if token_id == 3 {
        return tr.c3;
    }
    return 0;
}

fn apply_rep(logit: Int, seen: Int, rep_milli: Int) -> Int {
    if seen == 0 {
        return logit;
    }
    if rep_milli == 1000 {
        return logit;
    }
    if logit > 0 {
        return (logit * 1000) / rep_milli;
    }
    return (logit * rep_milli) / 1000;
}

fn apply_pres_freq(logit: Int, seen: Int, pres: Int, freq: Int) -> Int {
    if seen == 0 {
        return logit;
    }
    return (logit - pres) - (freq * seen);
}

fn apply_temp(logit: Int, temp_milli: Int) -> Int {
    if temp_milli <= 0 {
        return logit;
    }
    return (logit * 1000) / temp_milli;
}

pub fn apply_penalty_logit(logit: Int, seen: Int, cfg: PenaltyCfg) -> Int {
    let after_rep: Int = apply_rep(logit, seen, cfg.rep_milli);
    let after_pen: Int = apply_pres_freq(after_rep, seen, cfg.pres_milli, cfg.freq_milli);
    return apply_temp(after_pen, cfg.temp_milli);
}

pub fn apply_penalty_token(logit: Int, tr: RepTracker, token_id: Int, cfg: PenaltyCfg) -> Int {
    let seen: Int = repetition_tracker_seen(tr, token_id);
    return apply_penalty_logit(logit, seen, cfg);
}
