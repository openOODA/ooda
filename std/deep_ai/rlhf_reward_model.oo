// # RLHF Reward Head & Generalized Advantage Estimation (GAE)
//
// Logline: Computes sequence-level scalar rewards, Bradley-Terry pairwise preference loss, and PPO GAE-lambda advantage traces.
//
// Setup: Reward modeling and reinforcement learning from human feedback advantage estimation.
//
// Beats:
//   1. Define RewardModelConfig, RewardPair, and BradleyTerryLoss structures.
//   2. Evaluate Bradley-Terry preference loss L_BT = -log sigma(r(y_w) - r(y_l)).
//   3. Compute Generalized Advantage Estimation (GAE) over trajectory transitions.

pub type RewardModelConfig = struct {
    gamma_discount: Float,
    gae_lambda: Float,
};

pub type RewardPair = struct {
    reward_chosen: Float,
    reward_rejected: Float,
};

pub type BradleyTerryLoss = struct {
    loss: Float,
    accuracy: Float,
};

pub fn rlhf_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn reward_config_new(gamma: Float, lambda_val: Float) -> RewardModelConfig {
    return RewardModelConfig {
        gamma_discount: gamma,
        gae_lambda: lambda_val,
    };
}

pub fn rlhf_log_sigmoid(x: Float) -> Float {
    if x > 30.0 {
        return 0.0 - exp(0.0 - x);
    }
    if x < (0.0 - 30.0) {
        return x;
    }
    return 0.0 - ln(1.0 + exp(0.0 - x));
}

pub fn rlhf_compute_bradley_terry_loss(pair: &RewardPair) -> BradleyTerryLoss {
    let diff: Float = (pair).reward_chosen - (pair).reward_rejected;
    let loss_val: Float = 0.0 - rlhf_log_sigmoid(diff);
    let acc_val: Float = if diff > 0.0 { 1.0 } else { 0.0 };

    return BradleyTerryLoss {
        loss: loss_val,
        accuracy: acc_val,
    };
}

pub fn rlhf_compute_gae(
    rewards: List[Float],
    values: List[Float],
    dones: List[Bool],
    cfg: &RewardModelConfig
) -> List[Float] {
    let n: Int = list_len(rewards);
    let gamma: Float = (cfg).gamma_discount;
    let lambda_val: Float = (cfg).gae_lambda;

    let mut advantages: List[Float] = list_new();
    let mut init_i: Int = 0;
    while init_i < n {
        advantages = list_push(advantages, 0.0);
        init_i = init_i + 1;
    }

    let mut last_gae_lam: Float = 0.0;
    let mut step: Int = n - 1;
    while step >= 0 {
        let r_t: Float = list_get(rewards, step);
        let v_t: Float = list_get(values, step);
        let is_done: Bool = list_get(dones, step);

        let next_v: Float = if (step + 1) < list_len(values) {
            list_get(values, step + 1)
        } else {
            0.0
        };

        let not_done: Float = if is_done { 0.0 } else { 1.0 };
        let delta: Float = (r_t + (gamma * next_v * not_done)) - v_t;
        let gae_t: Float = delta + (gamma * lambda_val * not_done * last_gae_lam);
        last_gae_lam = gae_t;

        let mut next_adv: List[Float] = list_new();
        let mut k: Int = 0;
        while k < n {
            if k == step {
                next_adv = list_push(next_adv, gae_t);
            } else {
                next_adv = list_push(next_adv, list_get(advantages, k));
            }
            k = k + 1;
        }
        advantages = next_adv;

        step = step - 1;
    }

    return advantages;
}

pub fn rlhf_reward_model_marker() -> Int {
    return 1;
}
