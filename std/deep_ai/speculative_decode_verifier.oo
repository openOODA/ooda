// # Speculative decode prefix verifier
//
// Logline: Leviathan accept if rand < min(1, p_target/p_draft). 3-token draft, milli-probs.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type SpeculativeConfig = struct {
    gamma: Int,
    temp_milli: Int
}

type SpecResult = struct {
    n_accepted: Int,
    last_accepted: Int,
    resample_token: Int,
    speedup_milli: Int
}

pub fn speculative_verifier_new(gamma: Int, temp_milli: Int) -> SpeculativeConfig {
    return SpeculativeConfig {
        gamma: gamma,
        temp_milli: temp_milli
    };
}

fn spec_accept(p_t: Int, p_d: Int, rand_m: Int) -> Int {
    if p_d <= 0 {
        return 0;
    }
    let ratio: Int = (p_t * 1000) / p_d;
    let alpha: Int = ratio;
    if ratio >= 1000 {
        if rand_m < 1000 {
            return 1;
        }
        return 0;
    }
    if rand_m < alpha {
        return 1;
    }
    return 0;
}

fn spec_speedup(n_accepted: Int, gamma: Int) -> Int {
    let den: Int = gamma + 1;
    if den == 0 {
        return 0;
    }
    return ((n_accepted + 1) * 1000) / den;
}

pub fn speculative_verify_step(
    cfg: SpeculativeConfig,
    tok0: Int,
    tok1: Int,
    tok2: Int,
    q0: Int,
    q1: Int,
    q2: Int,
    p0: Int,
    p1: Int,
    p2: Int,
    u0: Int,
    u1: Int,
    u2: Int
) -> SpecResult {
    let g: Int = cfg.gamma;
    if g <= 0 {
        return SpecResult {
            n_accepted: 0,
            last_accepted: 0 - 1,
            resample_token: 0,
            speedup_milli: spec_speedup(0, 0)
        };
    }
    let a0: Int = spec_accept(p0, q0, u0);
    if a0 == 0 {
        return SpecResult {
            n_accepted: 0,
            last_accepted: 0 - 1,
            resample_token: 0,
            speedup_milli: spec_speedup(0, g)
        };
    }
    if g == 1 {
        return SpecResult {
            n_accepted: 1,
            last_accepted: tok0,
            resample_token: 0 - 1,
            speedup_milli: spec_speedup(1, g)
        };
    }
    let a1: Int = spec_accept(p1, q1, u1);
    if a1 == 0 {
        return SpecResult {
            n_accepted: 1,
            last_accepted: tok0,
            resample_token: 0,
            speedup_milli: spec_speedup(1, g)
        };
    }
    if g == 2 {
        return SpecResult {
            n_accepted: 2,
            last_accepted: tok1,
            resample_token: 0 - 1,
            speedup_milli: spec_speedup(2, g)
        };
    }
    let a2: Int = spec_accept(p2, q2, u2);
    if a2 == 0 {
        return SpecResult {
            n_accepted: 2,
            last_accepted: tok1,
            resample_token: 0,
            speedup_milli: spec_speedup(2, g)
        };
    }
    return SpecResult {
        n_accepted: 3,
        last_accepted: tok2,
        resample_token: 0 - 1,
        speedup_milli: spec_speedup(3, g)
    };
}

pub fn spec_result_accepted(r: SpecResult) -> Int {
    return r.n_accepted;
}

pub fn spec_result_speedup(r: SpecResult) -> Int {
    return r.speedup_milli;
}
