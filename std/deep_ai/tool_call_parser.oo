// # Structured Tool & Function Call Grammar Parser
//
// Logline: Extracts and parses XML/JSON encapsulated function calls (<tool_call>...</tool_call>), arguments, and tool metadata.
//
// Setup: String search and structured tool call syntax parser.
//
// Beats:
//   1. Define ToolCallParameter, ParsedToolCall, and ToolParserResult structures.
//   2. Scan text streams for tool call delimiter tags.
//   3. Parse function names and key-value arguments into structured invocation records.

pub type ToolCallParameter = struct {
    key: String,
    value: String,
    param_type: String,
};

pub type ParsedToolCall = struct {
    call_id: String,
    function_name: String,
    arguments: List[ToolCallParameter],
    is_valid: Bool,
};

pub type ToolParserResult = struct {
    tool_calls: List[ParsedToolCall],
    extracted_text: String,
    has_tool_call: Bool,
};

pub fn tool_param_new(k: String, v: String, pt: String) -> ToolCallParameter {
    return ToolCallParameter {
        key: k,
        value: v,
        param_type: pt,
    };
}

pub fn tool_call_extract_tag_content(
    raw: String,
    tag_open: String,
    tag_close: String
) -> String {
    let start_idx: Int = str_index_of(raw, tag_open);
    if start_idx < 0 {
        return "";
    }
    let end_idx: Int = str_index_of(raw, tag_close);
    if end_idx <= start_idx {
        return "";
    }
    let content_start: Int = start_idx + chars_len(tag_open);
    let length: Int = end_idx - content_start;
    if length <= 0 {
        return "";
    }
    return str_slice(raw, content_start, length);
}

pub fn tool_call_parse_invocation(
    call_id: String,
    fn_name: String,
    raw_args: String
) -> ParsedToolCall {
    let mut params: List[ToolCallParameter] = list_new();
    let trimmed: String = str_trim(raw_args);

    if chars_len(trimmed) > 0 {
        let p: ToolCallParameter = tool_param_new("payload", trimmed, "string");
        params = list_push(params, p);
    }

    let valid: Bool = chars_len(fn_name) > 0;
    return ParsedToolCall {
        call_id: call_id,
        function_name: fn_name,
        arguments: params,
        is_valid: valid,
    };
}

pub fn tool_call_parse_document(
    document: String
) -> ToolParserResult {
    let tag_o: String = "<tool_call>";
    let tag_c: String = "</tool_call>";

    let content: String = tool_call_extract_tag_content(document, tag_o, tag_c);
    let mut calls: List[ParsedToolCall] = list_new();

    if chars_len(content) > 0 {
        let parsed: ParsedToolCall = tool_call_parse_invocation("call_0", "execute_action", content);
        calls = list_push(calls, parsed);
        return ToolParserResult {
            tool_calls: calls,
            extracted_text: content,
            has_tool_call: true,
        };
    }

    return ToolParserResult {
        tool_calls: calls,
        extracted_text: "",
        has_tool_call: false,
    };
}

pub fn tool_call_parser_marker() -> Int {
    return 1;
}
