// # Okapi BM25 Lexical Inverted Index Retriever
//
// Logline: Term frequency, document frequency, and BM25 IDF/TF saturation.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type BM25Retriever = struct {
    k1_milli: Int,
    b_milli: Int,
    token_store: List[Int],
    doc_offsets: List[Int],
    doc_lens: List[Int],
    total_docs: Int,
    total_tokens: Int
};

pub fn bm25_retriever_new(k1_milli: Int, b_milli: Int) -> BM25Retriever {
    return BM25Retriever {
        k1_milli: k1_milli,
        b_milli: b_milli,
        token_store: list_new(),
        doc_offsets: list_new(),
        doc_lens: list_new(),
        total_docs: 0,
        total_tokens: 0
    };
}

pub fn bm25_add_document(retriever: BM25Retriever, tokens: List[Int]) -> BM25Retriever {
    let l: Int = list_len(tokens);
    let off: Int = list_len(retriever.token_store);
    let mut store: List[Int] = retriever.token_store;
    let mut i: Int = 0;
    while i < l {
        store = list_push(store, list_get(tokens, i));
        i = i + 1;
    }
    return BM25Retriever {
        k1_milli: retriever.k1_milli,
        b_milli: retriever.b_milli,
        token_store: store,
        doc_offsets: list_push(retriever.doc_offsets, off),
        doc_lens: list_push(retriever.doc_lens, l),
        total_docs: retriever.total_docs + 1,
        total_tokens: retriever.total_tokens + l
    };
}

pub fn bm25_compute_term_freq_range(store: List[Int], off: Int, len: Int, term: Int) -> Int {
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < len {
        if list_get(store, off + i) == term {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn bm25_compute_term_freq(tokens: List[Int], term: Int) -> Int {
    return bm25_compute_term_freq_range(tokens, 0, list_len(tokens), term);
}

pub fn bm25_compute_doc_freq(retriever: BM25Retriever, term: Int) -> Int {
    let mut df: Int = 0;
    let n: Int = retriever.total_docs;
    let mut i: Int = 0;
    while i < n {
        let off: Int = list_get(retriever.doc_offsets, i);
        let ln: Int = list_get(retriever.doc_lens, i);
        let tf: Int = bm25_compute_term_freq_range(retriever.token_store, off, ln, term);
        if tf > 0 {
            df = df + 1;
        }
        i = i + 1;
    }
    return df;
}

pub fn bm25_query_doc_score_milli(retriever: BM25Retriever, query_tokens: List[Int], doc_idx: Int) -> Int {
    if doc_idx < 0 {
        return 0;
    }
    if doc_idx >= retriever.total_docs {
        return 0;
    }
    let off: Int = list_get(retriever.doc_offsets, doc_idx);
    let doc_l: Int = list_get(retriever.doc_lens, doc_idx);
    let k1: Int = retriever.k1_milli;
    let b: Int = retriever.b_milli;
    let total_n: Int = retriever.total_docs;
    let mut avg_l: Int = 1;
    if total_n > 0 {
        avg_l = retriever.total_tokens / total_n;
    }
    if avg_l <= 0 {
        avg_l = 1;
    }
    let mut len_norm: Int = 1000 - b + ((b * doc_l) / avg_l);
    if len_norm <= 0 {
        len_norm = 1;
    }
    let mut score: Int = 0;
    let num_q: Int = list_len(query_tokens);
    let mut q_i: Int = 0;
    while q_i < num_q {
        let term: Int = list_get(query_tokens, q_i);
        let tf: Int = bm25_compute_term_freq_range(retriever.token_store, off, doc_l, term);
        if tf > 0 {
            let df: Int = bm25_compute_doc_freq(retriever, term);
            let idf_num: Int = ((total_n - df) * 1000) + 500;
            let idf_den: Int = (df * 1000) + 500;
            let idf: Int = (idf_num * 1000) / idf_den;
            let tf_num: Int = tf * (k1 + 1000);
            let mut tf_den: Int = (tf * 1000) + ((k1 * len_norm) / 1000);
            if tf_den <= 0 {
                tf_den = 1;
            }
            let tf_norm: Int = tf_num / tf_den;
            score = score + ((idf * tf_norm) / 1000);
        }
        q_i = q_i + 1;
    }
    return score;
}

pub fn rag_bm25_retriever_marker() -> Int {
    return 1;
}
