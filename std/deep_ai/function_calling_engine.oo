// # Function Calling Dispatch & Tool Registry Engine
//
// Logline: Manages available tool definitions, schema argument validation, execution dispatch, and conversation context serialization.
//
// Setup: Tool schema registry and response message serializer.
//
// Beats:
//   1. Define ToolParamSchema, ToolDefinition, ToolExecutionResult, and ToolRegistry structures.
//   2. Register tools with schema parameter descriptors and constraints.
//   3. Validate incoming tool calls and format standard response messages.

pub type ToolParamSchema = struct {
    name: String,
    type_name: String,
    required: Bool
};

pub type ToolDefinition = struct {
    name: String,
    description: String,
    params: List[ToolParamSchema]
};

pub type ToolExecutionResult = struct {
    call_id: String,
    tool_name: String,
    output: String,
    is_error: Bool
};

pub type ToolRegistry = struct {
    tools: List[ToolDefinition],
    registered_count: Int
};

pub fn tool_param_schema_new(name: String, type_name: String, req: Bool) -> ToolParamSchema {
    return ToolParamSchema {
        name: name,
        type_name: type_name,
        required: req
    };
}

pub fn tool_definition_new(name: String, desc: String, params: List[ToolParamSchema]) -> ToolDefinition {
    return ToolDefinition {
        name: name,
        description: desc,
        params: params
    };
}

pub fn tool_registry_new() -> ToolRegistry {
    let empty_list: List[ToolDefinition] = list_new();
    return ToolRegistry {
        tools: empty_list,
        registered_count: 0
    };
}

pub fn tool_registry_add(reg: &mut ToolRegistry, tool: ToolDefinition) -> Bool {
    (reg).tools = list_push((reg).tools, tool);
    (reg).registered_count = (reg).registered_count + 1;
    return true;
}

pub fn tool_registry_find(reg: &ToolRegistry, name: String) -> Int {
    let n: Int = (reg).registered_count;
    let mut i: Int = 0;
    while i < n {
        let t: ToolDefinition = list_get((reg).tools, i);
        if (t).name == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn tool_registry_validate_call(
    reg: &ToolRegistry,
    tool_name: String,
    provided_keys: List[String]
) -> Bool {
    let idx: Int = tool_registry_find(reg, tool_name);
    if idx < 0 {
        return false;
    }

    let t: ToolDefinition = list_get((reg).tools, idx);
    let num_params: Int = list_len((t).params);
    let num_prov: Int = list_len(provided_keys);

    let mut p_i: Int = 0;
    while p_i < num_params {
        let param: ToolParamSchema = list_get((t).params, p_i);
        if (param).required {
            let mut found: Bool = false;
            let mut k_i: Int = 0;
            while k_i < num_prov {
                if list_get(provided_keys, k_i) == (param).name {
                    found = true;
                }
                k_i = k_i + 1;
            }
            if !found {
                return false;
            }
        }
        p_i = p_i + 1;
    }

    return true;
}

pub fn tool_format_response_message(
    call_id: String,
    tool_name: String,
    result: String
) -> String {
    return "<tool_response id=\"" + call_id + "\" name=\"" + tool_name + "\">\n" + result + "\n</tool_response>";
}

pub fn function_calling_engine_marker() -> Int {
    return 1;
}
