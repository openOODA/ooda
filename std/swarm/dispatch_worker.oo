// # Swarm Worker and Task Lifecycle
//
// Logline: Worker capacity, assignment, heartbeat, and task state machine.
// residual: &mut destubbed to by-value.

import "./dispatch_types.oo";

type DispatcherConfig = struct {
    strategy: Int,
    max_queue_depth: Int,
    max_worker_capacity: Int,
    default_timeout_ms: Int,
    max_retries: Int
};

type SwarmDispatcher = struct {
    config: DispatcherConfig,
    total_submitted: Int,
    total_completed: Int,
    total_failed: Int,
    total_cancelled: Int,
    rr_cursor: Int,
    next_task_id: Int,
    active_worker_count: Int
};

type WorkerNode = struct {
    worker_id: Int,
    status: Int,
    active_tasks: Int,
    capacity: Int,
    completed_count: Int,
    failed_count: Int,
    last_heartbeat_ms: Int,
    last_ok: Int
};

type SwarmTask = struct {
    task_id: Int,
    priority: Int,
    status: Int,
    assigned_worker_id: Int,
    retry_count: Int,
    max_retries: Int,
    created_at_ms: Int,
    completed_at_ms: Int,
    payload_val: Int,
    last_ok: Int
};

pub fn make_swarm_dispatcher(config: DispatcherConfig, total_submitted: Int, total_completed: Int, total_failed: Int, total_cancelled: Int, rr_cursor: Int, next_task_id: Int, active_worker_count: Int) -> SwarmDispatcher {
    return SwarmDispatcher { config: config, total_submitted: total_submitted, total_completed: total_completed, total_failed: total_failed, total_cancelled: total_cancelled, rr_cursor: rr_cursor, next_task_id: next_task_id, active_worker_count: active_worker_count };
}

pub fn make_worker_node(worker_id: Int, status: Int, active_tasks: Int, capacity: Int, completed_count: Int, failed_count: Int, last_heartbeat_ms: Int, last_ok: Int) -> WorkerNode {
    return WorkerNode { worker_id: worker_id, status: status, active_tasks: active_tasks, capacity: capacity, completed_count: completed_count, failed_count: failed_count, last_heartbeat_ms: last_heartbeat_ms, last_ok: last_ok };
}

pub fn make_swarm_task(task_id: Int, priority: Int, status: Int, assigned_worker_id: Int, retry_count: Int, max_retries: Int, created_at_ms: Int, completed_at_ms: Int, payload_val: Int, last_ok: Int) -> SwarmTask {
    return SwarmTask { task_id: task_id, priority: priority, status: status, assigned_worker_id: assigned_worker_id, retry_count: retry_count, max_retries: max_retries, created_at_ms: created_at_ms, completed_at_ms: completed_at_ms, payload_val: payload_val, last_ok: last_ok };
}

pub fn dispatcher_config_init(strategy: Int, max_queue: Int, max_capacity: Int, timeout_ms: Int, retries: Int) -> DispatcherConfig {
    let mut strat: Int = strategy;
    if strat < 0 { strat = 0; }
    if strat > 3 { strat = 0; }
    let mut q_depth: Int = max_queue;
    if q_depth <= 0 { q_depth = 64; }
    let mut cap: Int = max_capacity;
    if cap <= 0 { cap = 8; }
    let mut timeout: Int = timeout_ms;
    if timeout <= 0 { timeout = 5000; }
    let mut r: Int = retries;
    if r < 0 { r = 3; }
    return DispatcherConfig { strategy: strat, max_queue_depth: q_depth, max_worker_capacity: cap, default_timeout_ms: timeout, max_retries: r };
}

pub fn dispatcher_init(config: DispatcherConfig) -> SwarmDispatcher {
    return make_swarm_dispatcher(config, 0, 0, 0, 0, 0, 1, 0);
}

pub fn worker_node_init(worker_id: Int, capacity: Int) -> WorkerNode {
    let mut cap: Int = capacity;
    if cap <= 0 { cap = 1; }
    return make_worker_node(worker_id, 1, 0, cap, 0, 0, 0, 1);
}

pub fn swarm_task_create(task_id: Int, priority: Int, payload: Int, max_retries: Int, created_ms: Int) -> SwarmTask {
    return make_swarm_task(task_id, priority, 0, 0 - 1, 0, max_retries, created_ms, 0, payload, 1);
}

pub fn worker_node_can_accept(worker: WorkerNode) -> Bool {
    if worker.status == 0 { return false; }
    if worker.status == 3 { return false; }
    if worker.active_tasks >= worker.capacity { return false; }
    return true;
}

pub fn worker_node_assign(worker: WorkerNode) -> WorkerNode {
    if worker_node_can_accept(worker) == false {
        return make_worker_node(worker.worker_id, worker.status, worker.active_tasks, worker.capacity, worker.completed_count, worker.failed_count, worker.last_heartbeat_ms, 0);
    }
    let current_active: Int = worker.active_tasks + 1;
    let mut st: Int = worker.status;
    if current_active >= worker.capacity { st = 2; }
    return make_worker_node(worker.worker_id, st, current_active, worker.capacity, worker.completed_count, worker.failed_count, worker.last_heartbeat_ms, 1);
}

pub fn worker_node_release(worker: WorkerNode, success: Bool) -> WorkerNode {
    let mut current_active: Int = worker.active_tasks;
    if current_active > 0 { current_active = current_active - 1; }
    let mut completed: Int = worker.completed_count;
    let mut failed: Int = worker.failed_count;
    if success { completed = completed + 1; }
    if success == false { failed = failed + 1; }
    let mut st: Int = worker.status;
    if st == 2 { if current_active < worker.capacity { st = 1; } }
    return make_worker_node(worker.worker_id, st, current_active, worker.capacity, completed, failed, worker.last_heartbeat_ms, 1);
}

pub fn worker_node_update_status(worker: WorkerNode, new_status: Int) -> WorkerNode {
    return make_worker_node(worker.worker_id, new_status, worker.active_tasks, worker.capacity, worker.completed_count, worker.failed_count, worker.last_heartbeat_ms, 1);
}

pub fn worker_node_heartbeat(worker: WorkerNode, timestamp_ms: Int) -> WorkerNode {
    let mut st: Int = worker.status;
    if st == 0 { st = 1; }
    return make_worker_node(worker.worker_id, st, worker.active_tasks, worker.capacity, worker.completed_count, worker.failed_count, timestamp_ms, 1);
}

pub fn task_is_terminal(task: SwarmTask) -> Bool {
    if task.status == 3 { return true; }
    if task.status == 4 { return true; }
    if task.status == 5 { return true; }
    return false;
}

pub fn task_can_retry(task: SwarmTask) -> Bool {
    if task.retry_count < task.max_retries { return true; }
    return false;
}

pub fn task_mark_dispatched(task: SwarmTask, worker_id: Int) -> SwarmTask {
    return make_swarm_task(task.task_id, task.priority, 1, worker_id, task.retry_count, task.max_retries, task.created_at_ms, task.completed_at_ms, task.payload_val, 1);
}

pub fn task_mark_completed(task: SwarmTask, timestamp_ms: Int) -> SwarmTask {
    return make_swarm_task(task.task_id, task.priority, 3, task.assigned_worker_id, task.retry_count, task.max_retries, task.created_at_ms, timestamp_ms, task.payload_val, 1);
}

pub fn task_mark_failed(task: SwarmTask, timestamp_ms: Int) -> SwarmTask {
    let retries: Int = task.retry_count + 1;
    if retries <= task.max_retries {
        return make_swarm_task(task.task_id, task.priority, 0, 0 - 1, retries, task.max_retries, task.created_at_ms, task.completed_at_ms, task.payload_val, 1);
    }
    return make_swarm_task(task.task_id, task.priority, 4, task.assigned_worker_id, retries, task.max_retries, task.created_at_ms, timestamp_ms, task.payload_val, 0);
}

pub fn task_mark_cancelled(task: SwarmTask) -> SwarmTask {
    return make_swarm_task(task.task_id, task.priority, 5, task.assigned_worker_id, task.retry_count, task.max_retries, task.created_at_ms, task.completed_at_ms, task.payload_val, 1);
}
