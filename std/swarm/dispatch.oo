// # Swarm Dispatch Facade
//
// Logline: Re-exports swarm dispatch modules and provides entry points for worker orchestration and task routing.
//
// Setup: Preconditions require valid dispatcher configurations, worker nodes, and task structures.
//
// Beats:
//   1. Import core types and functional modules across the swarm dispatch subsystem.
//   2. Expose initialization shims for dispatcher configs, worker nodes, and swarm tasks.
//   3. Provide validation entry points for scheduling, routing, throughput, and node health.
//

import "./dispatch_types.oo";
import "./dispatch_worker.oo";
import "./dispatch_engine.oo";
import "./dispatch_stubs.oo";

pub fn shim_marker_config_init() -> DispatcherConfig {
    return dispatcher_config_init(0, 32, 4, 1000, 2);
}

pub fn shim_marker_dispatcher_init() -> SwarmDispatcher {
    let cfg: DispatcherConfig = dispatcher_config_init(0, 32, 4, 1000, 2);
    return dispatcher_init(cfg);
}

pub fn shim_marker_worker_init() -> WorkerNode {
    return worker_node_init(101, 2);
}

pub fn shim_marker_task_create() -> SwarmTask {
    return swarm_task_create(1, 10, 42, 2, 100);
}

pub fn shim_marker_worker_can_accept() -> Bool {
    let w: WorkerNode = worker_node_init(101, 2);
    return worker_node_can_accept(&w);
}

pub fn shim_marker_task_terminal() -> Bool {
    let t: SwarmTask = swarm_task_create(1, 10, 42, 2, 100);
    return task_is_terminal(&t);
}

pub fn shim_marker_task_can_retry() -> Bool {
    let t: SwarmTask = swarm_task_create(1, 10, 42, 2, 100);
    return task_can_retry(&t);
}

pub fn shim_marker_least_loaded() -> Int {
    return dispatcher_select_worker_least_loaded(1, 4, 3, 4);
}

pub fn shim_marker_throughput() -> Int {
    let cfg: DispatcherConfig = dispatcher_config_init(0, 32, 4, 1000, 2);
    let d: SwarmDispatcher = dispatcher_init(cfg);
    return dispatcher_calculate_throughput(&d, 1000);
}

pub fn shim_marker_pending_slots() -> Int {
    let cfg: DispatcherConfig = dispatcher_config_init(0, 32, 4, 1000, 2);
    let d: SwarmDispatcher = dispatcher_init(cfg);
    return dispatcher_get_pending_slot_count(&d, 4);
}

pub fn shim_marker_healthy() -> Bool {
    let cfg: DispatcherConfig = dispatcher_config_init(0, 32, 4, 1000, 2);
    let d: SwarmDispatcher = dispatcher_init(cfg);
    return dispatcher_is_healthy(&d);
}
