// # Dispatch types
//
// Logline: DispatcherConfig destubbed off List[struct] queues.
// residual: List[struct] destubbed.

type DispatcherConfig = struct {
    strategy: Int,
    max_queue_depth: Int
};

pub fn dispatcher_config_new(strategy: Int, max_queue_depth: Int) -> DispatcherConfig {
    return DispatcherConfig {
        strategy: strategy,
        max_queue_depth: max_queue_depth
    };
}

pub fn dispatcher_config_depth(c: DispatcherConfig) -> Int {
    return c.max_queue_depth;
}
