// # Optical Flow & Dynamic 3D Scene Flow Consistency
//
// Logline: Multi-view 2D optical flow reprojection loss and 3D scene flow temporal smoothness regularizer.
//
// Setup: Enforces temporal motion consistency and prevents high-frequency temporal flickering in video novel view synthesis.
//
// Beats:
//   1. Define FlowVector2D and SceneFlowVector3D structures.
//   2. Compute 2D photometric flow consistency loss between forward-backward warped pixel pairs.
//   3. Compute 3D scene flow Laplacian smoothness regularization across neighboring spatial points.

import "./vec3_math.oo";

pub type FlowVector2D = struct {
    du: Float,
    dv: Float,
    confidence: Float
};

pub type SceneFlowVector3D = struct {
    velocity: Vec3
};

pub fn flow_vector_2d_new(du: Float, dv: Float, conf: Float) -> FlowVector2D {
    return FlowVector2D {
        du: du,
        dv: dv,
        confidence: math_clamp(conf, 0.0, 1.0)
    };
}

pub fn optical_flow_endpoint_error(flow_pred: &FlowVector2D, flow_gt: &FlowVector2D) -> Float {
    let diff_u: Float = (flow_pred).du - (flow_gt).du;
    let diff_v: Float = (flow_pred).dv - (flow_gt).dv;
    let error: Float = math_sqrt(diff_u * diff_u + diff_v * diff_v);
    return error * (flow_gt).confidence;
}

pub fn scene_flow_smoothness_penalty(v_curr: &Vec3, v_neighbor: &Vec3) -> Float {
    let diff: Vec3 = vec3_sub(v_curr, v_neighbor);
    return vec3_length_sq(&diff);
}
