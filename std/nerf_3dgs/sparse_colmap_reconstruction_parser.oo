// # COLMAP Sparse Reconstruction Parser Data Models
//
// Logline: Data structures and parser models for COLMAP cameras, registered image poses, and 3D tie points.
//
// Setup: Bridges Structure-from-Motion (SfM) pipelines to NeRF and 3DGS camera calibration initialization.
//
// Beats:
//   1. Define ColmapCamera with model ID (PINHOLE, SIMPLE_RADIAL, OPENCV) and focal/principal parameters.
//   2. Define ColmapImage with quaternion rotation, translation vector, camera ID, and image filename.
//   3. Define ColmapPoint3D with 3D world position, RGB color, and reprojection error.

import "./vec3_math.oo";
import "./camera_pose_se3.oo";

pub type ColmapCamera = struct {
    camera_id: Int,
    model_type: Int, // 0: PINHOLE, 1: SIMPLE_RADIAL, 2: OPENCV
    width: Int,
    height: Int,
    params_fx: Float,
    params_fy: Float,
    params_cx: Float,
    params_cy: Float
};

pub type ColmapImage = struct {
    image_id: Int,
    q_rot: Quaternion,
    trans: Vec3,
    camera_id: Int
};

pub type ColmapPoint3D = struct {
    point_id: Int,
    position: Vec3,
    color_rgb: Vec3,
    error: Float
};

pub fn colmap_image_to_c2w(img: &ColmapImage) -> CameraPose {
    // In COLMAP, stored poses are world-to-camera (w2c)
    let r_w2c: Mat3 = quat_to_mat3(&(img).q_rot);
    let w2c_pose: CameraPose = camera_pose_new(r_w2c, (img).trans);
    // Invert to obtain camera-to-world (c2w)
    return camera_pose_world_to_cam(&w2c_pose);
}

pub fn sparse_colmap_reconstruction_parser_probe() -> Int {
    return 0;
}
