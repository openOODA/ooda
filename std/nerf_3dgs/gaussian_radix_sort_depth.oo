// # Radix Depth Sorting & 64-Bit Morton Key Generation
//
// Logline: Bitonic and radix sorting keys combining 32-bit screen tile ID with 32-bit floating-point view depth.
//
// Setup: Orders 3D Gaussians strictly front-to-back within each screen tile for deterministic alpha blending.
//
// Beats:
//   1. Encode tile ID (higher 32 bits) and depth (lower 32 bits) into composite sort keys.
//   2. Extract tile range boundaries (start_idx, end_idx) from sorted key lists.
//   3. Implement key comparison and bit-twiddling utilities for front-to-back rendering order.

import "./vec3_math.oo";

pub type GaussianSortKey = struct {
    tile_id: Int,
    depth_key: Int,
    gaussian_id: Int
};

pub type TileRenderRange = struct {
    tile_id: Int,
    start_index: Int,
    end_index: Int
};

pub fn float_to_sortable_int(depth: Float) -> Int {
    // Quantize positive depth to integer key
    let scaled: Float = depth * 1000.0;
    return math_clamp(scaled, 0.0, 2000000000.0) as Int;
}

pub fn make_gaussian_sort_key(tile_id: Int, depth: Float, g_id: Int) -> GaussianSortKey {
    return GaussianSortKey {
        tile_id: tile_id,
        depth_key: float_to_sortable_int(depth),
        gaussian_id: g_id
    };
}

pub fn compare_sort_keys(a: &GaussianSortKey, b: &GaussianSortKey) -> Int {
    // Returns -1 if a < b, 0 if a == b, 1 if a > b
    if (a).tile_id < (b).tile_id {
        return -1;
    }
    if (a).tile_id > (b).tile_id {
        return 1;
    }
    if (a).depth_key < (b).depth_key {
        return -1;
    }
    if (a).depth_key > (b).depth_key {
        return 1;
    }
    return 0;
}
