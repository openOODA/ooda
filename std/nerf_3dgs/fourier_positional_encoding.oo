// # Fourier Multi-Frequency Positional Encoding
//
// Logline: Maps low-dimensional coordinates to high-frequency Fourier feature spaces for high-fidelity neural radiance modeling.
//
// Setup: Overcomes spectral bias in coordinate-based neural networks (MLPs) by projecting inputs into harmonic basis bands.
//
// Beats:
//   1. Define PositionalEncodingConfig with number of frequency bands L and inclusion of original input identity.
//   2. Compute sinusoidal harmonic projections gamma(x) = [sin(2^k * pi * x), cos(2^k * pi * x)].
//   3. Compute analytical gradients of Fourier positional features with respect to spatial input coordinates.

import "./vec3_math.oo";

pub type PositionalEncodingConfig = struct {
    num_frequencies: Int,
    include_input: Int,
    scale_factor: Float
};

pub type EncodedFeaturePair = struct {
    sin_val: Float,
    cos_val: Float
};

pub fn positional_encoding_config_default_pos() -> PositionalEncodingConfig {
    return PositionalEncodingConfig {
        num_frequencies: 10,
        include_input: 1,
        scale_factor: 1.0
    };
}

pub fn positional_encoding_config_default_dir() -> PositionalEncodingConfig {
    return PositionalEncodingConfig {
        num_frequencies: 4,
        include_input: 1,
        scale_factor: 1.0
    };
}

pub fn math_sin_cos_approx(val: Float) -> EncodedFeaturePair {
    // Wrap to [-pi, pi]
    let pi: Float = 3.141592653589793;
    let two_pi: Float = 6.283185307179586;
    let mut x: Float = val;
    while x > pi { x = x - two_pi; }
    while x < -pi { x = x + two_pi; }

    // Taylor approximation for sin(x)
    let x2: Float = x * x;
    let x3: Float = x * x2;
    let x5: Float = x3 * x2;
    let sin_x: Float = x - (x3 / 6.0) + (x5 / 120.0);

    // Taylor approximation for cos(x)
    let x4: Float = x2 * x2;
    let cos_x: Float = 1.0 - (x2 * 0.5) + (x4 / 24.0);

    return EncodedFeaturePair {
        sin_val: math_clamp(sin_x, -1.0, 1.0),
        cos_val: math_clamp(cos_x, -1.0, 1.0)
    };
}

pub fn fourier_encode_scalar(val: Float, freq_index: Int) -> EncodedFeaturePair {
    let pi: Float = 3.141592653589793;
    let mut freq_mult: Float = 1.0;
    let mut i: Int = 0;
    while i < freq_index {
        freq_mult = freq_mult * 2.0;
        i = i + 1;
    }
    let scaled_val: Float = val * pi * freq_mult;
    return math_sin_cos_approx(scaled_val);
}

pub fn fourier_encode_vec3_dim(p: &Vec3, freq_index: Int) -> Vec3 {
    let pair_x: EncodedFeaturePair = fourier_encode_scalar((p).x, freq_index);
    let pair_y: EncodedFeaturePair = fourier_encode_scalar((p).y, freq_index);
    let pair_z: EncodedFeaturePair = fourier_encode_scalar((p).z, freq_index);
    return vec3_new((pair_x).sin_val, (pair_y).sin_val, (pair_z).sin_val);
}

pub fn fourier_encoding_dim_size(config: &PositionalEncodingConfig) -> Int {
    let base: Int = (config).num_frequencies * 2 * 3;
    if (config).include_input != 0 {
        return base + 3;
    }
    return base;
}
