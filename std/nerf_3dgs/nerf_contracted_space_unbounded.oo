// # Unbounded Scene Space Contraction
//
// Logline: Non-linear Euclidean space contraction mapping infinite 3D worlds into a bounded unit domain.
//
// Setup: Allows bounded neural architectures to represent unbounded 360-degree backgrounds without spherical harmonics singularities.
//
// Beats:
//   1. Implement Mip-NeRF 360 contraction contract(x) mapping ||x|| > 1 to [1, 2) radius sphere.
//   2. Compute inverse contraction mapping uncontract(u) from bounded space back to world Euclidean space.
//   3. Compute the Jacobian determinant of the space contraction transformation for volume conservation.

import "./vec3_math.oo";

pub fn contract_point(p: &Vec3) -> Vec3 {
    let norm: Float = vec3_length(p);
    if norm <= 1.0 {
        return *p;
    }
    // For ||p|| > 1: (2 - 1/||p||) * (p / ||p||)
    let scale: Float = (2.0 - (1.0 / norm)) / norm;
    return vec3_scale(p, scale);
}

pub fn uncontract_point(u: &Vec3) -> Vec3 {
    let norm: Float = vec3_length(u);
    if norm <= 1.0 {
        return *u;
    }
    if norm >= 2.0 {
        let max_scale: Float = 1000000.0;
        return vec3_scale(u, max_scale);
    }
    // For 1 < ||u|| < 2: ||p|| = 1 / (2 - ||u||)
    let original_norm: Float = 1.0 / (2.0 - norm);
    let scale: Float = original_norm / norm;
    return vec3_scale(u, scale);
}

pub fn contraction_jacobian_factor(norm: Float) -> Float {
    if norm <= 1.0 {
        return 1.0;
    }
    // Derivative of (2 - 1/r) w.r.t r is 1/r^2
    return 1.0 / (norm * norm);
}
