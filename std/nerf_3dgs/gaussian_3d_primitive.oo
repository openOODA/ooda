// # 3D Gaussian Splatting Primitive Structure
//
// Logline: Comprehensive parameterization of explicit 3D Gaussians (mean, scale, quaternion rotation, opacity, and spherical harmonics).
//
// Setup: Core geometric and photometric atom of 3D Gaussian Splatting rendering pipelines.
//
// Beats:
//   1. Define Gaussian3D structure with mean position, scaling vector, quaternion rotation, opacity, and SH features.
//   2. Implement Gaussian constructors, activation mappings (sigmoid opacity, exp scale), and boundary clamps.
//   3. Compute memory footprint and serialization layout for 3D Gaussian point clouds.

import "./vec3_math.oo";

pub type Gaussian3D = struct {
    position: Vec3,
    scale: Vec3,
    rotation: Quaternion,
    opacity: Float,
    sh_dc: Vec3,
};

pub fn gaussian_3d_new(pos: Vec3, scale: Vec3, rot: Quaternion, opacity: Float, sh_dc: Vec3) -> Gaussian3D {
    return Gaussian3D {
        position: pos,
        scale: scale,
        rotation: quat_normalize(&rot),
        opacity: math_clamp(opacity, 0.0, 1.0),
        sh_dc: sh_dc,
    };
}

pub fn gaussian_activate_scale(raw_scale: &Vec3) -> Vec3 {
    return Vec3 {
        x: math_exp((raw_scale).x),
        y: math_exp((raw_scale).y),
        z: math_exp((raw_scale).z),
    };
}

pub fn gaussian_activate_opacity(raw_opacity: Float) -> Float {
    // Sigmoid: 1 / (1 + exp(-x))
    let clamped: Float = math_clamp(raw_opacity, -10.0, 10.0);
    let exp_val: Float = math_exp(-clamped);
    return 1.0 / (1.0 + exp_val);
}
