// # Neural Rendering Performance Benchmarks & Metrics
//
// Logline: End-to-end performance benchmarking harness for frames-per-second, memory footprint, and training throughput.
//
// Setup: Quantitative benchmarking harness tracking FPS, render latency, VRAM allocation, and PSNR convergence.
//
// Beats:
//   1. Define BenchmarkReport with FPS, frame time, Gaussian count, and memory metrics.
//   2. Compute throughput in samples-per-second and rays-per-second.
//   3. Validate real-time rendering thresholds (>30 FPS at 1080p).

pub type BenchmarkReport = struct {
    fps: Float,
    frame_time_ms: Float,
    num_gaussians: Int,
    vram_mb: Float,
    is_realtime: Int,
};

pub fn benchmark_report_new(frame_time_ms: Float, num_gaussians: Int, vram_mb: Float) -> BenchmarkReport {
    let mut fps: Float = 0.0;
    if frame_time_ms > 0.0001 {
        fps = 1000.0 / frame_time_ms;
    }
    let mut is_rt: Int = 0;
    if fps >= 30.0 {
        is_rt = 1;
    }
    return BenchmarkReport {
        fps: fps,
        frame_time_ms: frame_time_ms,
        num_gaussians: num_gaussians,
        vram_mb: vram_mb,
        is_realtime: is_rt,
    };
}

pub fn compute_throughput_rays_per_sec(num_rays: Int, elapsed_seconds: Float) -> Float {
    if elapsed_seconds <= 0.0001 {
        return 0.0;
    }
    return (num_rays as Float) / elapsed_seconds;
}
