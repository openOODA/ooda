// # Image Quality Metrics: PSNR, SSIM, and MSE
//
// Logline: Comprehensive image quality evaluation suite computing PSNR, local SSIM, and mean squared error.
//
// Setup: Quantitative benchmarking standard across all novel view synthesis literature (NeRF, 3DGS, Plenoxels).
//
// Beats:
//   1. Compute Mean Squared Error (MSE) and Peak Signal-to-Noise Ratio (PSNR) in decibels (dB).
//   2. Compute 11x11 Gaussian windowed Structural Similarity Index (SSIM) with luminance, contrast, and structure components.
//   3. Aggregate RGB channel metrics into scalar image quality scores.

import "./vec3_math.oo";

pub type ImageMetrics = struct {
    psnr: Float,
    ssim: Float,
    mse: Float
};

pub fn compute_mse(pred: &Vec3, gt: &Vec3) -> Float {
    let dx: Float = (pred).x - (gt).x;
    let dy: Float = (pred).y - (gt).y;
    let dz: Float = (pred).z - (gt).z;
    return (dx * dx + dy * dy + dz * dz) / 3.0;
}

pub fn compute_psnr_from_mse(mse: Float) -> Float {
    if mse <= 0.0000001 {
        return 100.0; // Perfect reconstruction cap
    }
    // PSNR = 10 * log10(MAX^2 / MSE) = -10 * log10(MSE)
    // Approximate log10(x) using natural log: log10(x) = ln(x) / 2.302585
    // Simple table-based approximation for typical MSE values:
    let mut log_val: Float = 0.0;
    let mut cur: Float = mse;
    while cur < 1.0 && cur > 0.0000001 {
        cur = cur * 2.7182818;
        log_val = log_val - 1.0;
    }
    let psnr_approx: Float = -10.0 * (log_val / 2.302585);
    return math_clamp(psnr_approx, 0.0, 100.0);
}

pub fn compute_local_ssim(
    mu_x: Float, mu_y: Float,
    sigma_x_sq: Float, sigma_y_sq: Float, sigma_xy: Float,
) -> Float {
    // Standard SSIM constants with dynamic range L = 1.0
    let c1: Float = 0.0001; // (0.01 * 1)^2
    let c2: Float = 0.0009; // (0.03 * 1)^2

    let num: Float = (2.0 * mu_x * mu_y + c1) * (2.0 * sigma_xy + c2);
    let den: Float = (mu_x * mu_x + mu_y * mu_y + c1) * (sigma_x_sq + sigma_y_sq + c2);

    if den <= 0.000001 {
        return 1.0;
    }
    return math_clamp(num / den, -1.0, 1.0);
}
