// # Pinhole Camera Intrinsics & Calibration Matrix
//
// Logline: Comprehensive pinhole camera intrinsic parameterization, focal lengths, principal points, and field of view conversions.
//
// Setup: Maps normalized device coordinates (NDC) and 3D camera space coordinates to 2D image sensor pixels.
//
// Beats:
//   1. Define CameraIntrinsics data structure with fx, fy, cx, cy, skew, and sensor resolution.
//   2. Compute 3x3 intrinsic calibration matrix K and inverse projection K_inv.
//   3. Convert between horizontal/vertical field of view (FOV) angles and focal lengths in pixels.

import "./vec3_math.oo";

pub type CameraIntrinsics = struct {
    width: Int,
    height: Int,
    fx: Float,
    fy: Float,
    cx: Float,
    cy: Float,
    skew: Float,
};

pub fn camera_intrinsics_new(width: Int, height: Int, fx: Float, fy: Float, cx: Float, cy: Float) -> CameraIntrinsics {
    return CameraIntrinsics {
        width: width,
        height: height,
        fx: fx,
        fy: fy,
        cx: cx,
        cy: cy,
        skew: 0.0,
    };
}

pub fn camera_intrinsics_from_fov(width: Int, height: Int, fov_x_rad: Float, fov_y_rad: Float) -> CameraIntrinsics {
    let mut tan_half_x: Float = fov_x_rad * 0.5;
    if tan_half_x < 0.001 { tan_half_x = 0.001; }
    let mut tan_half_y: Float = fov_y_rad * 0.5;
    if tan_half_y < 0.001 { tan_half_y = 0.001; }

    let fx: Float = ((width as Float) * 0.5) / tan_half_x;
    let fy: Float = ((height as Float) * 0.5) / tan_half_y;
    let cx: Float = (width as Float) * 0.5;
    let cy: Float = (height as Float) * 0.5;

    return CameraIntrinsics {
        width: width,
        height: height,
        fx: fx,
        fy: fy,
        cx: cx,
        cy: cy,
        skew: 0.0,
    };
}

pub fn camera_intrinsics_matrix(cam: &CameraIntrinsics) -> Mat3 {
    return Mat3 {
        m00: (cam).fx, m01: (cam).skew, m02: (cam).cx,
        m10: 0.0,     m11: (cam).fy,   m12: (cam).cy,
        m20: 0.0,     m21: 0.0,        m22: 1.0,
    };
}

pub fn camera_intrinsics_inv_matrix(cam: &CameraIntrinsics) -> Mat3 {
    let inv_fx: Float = 1.0 / (cam).fx;
    let inv_fy: Float = 1.0 / (cam).fy;
    return Mat3 {
        m00: inv_fx, m01: 0.0,    m02: -(cam).cx * inv_fx,
        m10: 0.0,    m11: inv_fy, m12: -(cam).cy * inv_fy,
        m20: 0.0,    m21: 0.0,    m22: 1.0,
    };
}

pub fn camera_project_point(cam: &CameraIntrinsics, pt_cam: &Vec3) -> Vec3 {
    let z: Float = (pt_cam).z;
    if z <= 0.0001 {
        return vec3_new(-1.0, -1.0, 0.0);
    }
    let inv_z: Float = 1.0 / z;
    let u: Float = (cam).fx * (pt_cam).x * inv_z + (cam).cx;
    let v: Float = (cam).fy * (pt_cam).y * inv_z + (cam).cy;
    return vec3_new(u, v, z);
}

pub fn camera_unproject_pixel(cam: &CameraIntrinsics, px: Float, py: Float, depth: Float) -> Vec3 {
    let x: Float = (px - (cam).cx) * depth / (cam).fx;
    let y: Float = (py - (cam).cy) * depth / (cam).fy;
    return vec3_new(x, y, depth);
}
