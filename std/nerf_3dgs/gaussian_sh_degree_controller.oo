// # Progressive Spherical Harmonics Degree Scheduler
//
// Logline: Progressive activation schedule for Spherical Harmonics degree bands during 3D Gaussian training.
//
// Setup: Prevents high-frequency directional local minima by initializing with diffuse DC band and incrementally unlocking higher bands.
//
// Beats:
//   1. Define SHDegreeScheduleConfig with step thresholds for degrees 0, 1, 2, and 3.
//   2. Compute active maximum SH degree as a function of current training iteration.
//   3. Compute coefficient count and active memory offsets for current training stage.

import "./vec3_math.oo";

pub type SHDegreeScheduleConfig = struct {
    max_degree: Int,
    steps_per_degree: Int
};

pub fn sh_degree_schedule_default() -> SHDegreeScheduleConfig {
    return SHDegreeScheduleConfig {
        max_degree: 3,
        steps_per_degree: 1000
    };
}

pub fn get_active_sh_degree(config: &SHDegreeScheduleConfig, iteration: Int) -> Int {
    let degree: Int = iteration / (config).steps_per_degree;
    if degree > (config).max_degree {
        return (config).max_degree;
    }
    return degree;
}

pub fn sh_degree_to_num_coeffs(degree: Int) -> Int {
    // (degree + 1)^2 coefficients
    let d: Int = degree + 1;
    return d * d;
}
