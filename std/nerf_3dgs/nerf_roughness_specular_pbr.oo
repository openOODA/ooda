// # PBR Material Decomposition & Specular Tint
//
// Logline: Physically-Based Rendering decomposition of neural radiance into diffuse albedo, roughness, and specular tint.
//
// Setup: Decouples view-dependent highlights from diffuse surface reflectivity for realistic material editing and relighting.
//
// Beats:
//   1. Define NeuralPbrMaterial with albedo RGB, roughness factor, specular tint, and metallic parameter.
//   2. Compute Cook-Torrance microfacet GGX specular reflection based on roughness and view vector.
//   3. Combine diffuse base radiance and specular reflection highlights.

import "./vec3_math.oo";

pub type NeuralPbrMaterial = struct {
    albedo: Vec3,
    roughness: Float,
    metallic: Float,
    specular_tint: Vec3,
};

pub fn neural_pbr_material_new(albedo: Vec3, roughness: Float, metallic: Float) -> NeuralPbrMaterial {
    return NeuralPbrMaterial {
        albedo: albedo,
        roughness: math_clamp(roughness, 0.05, 1.0),
        metallic: math_clamp(metallic, 0.0, 1.0),
        specular_tint: vec3_one(),
    };
}

pub fn pbr_shading_combine(
    mat: &NeuralPbrMaterial,
    diffuse_light: &Vec3,
    specular_light: &Vec3,
) -> Vec3 {
    let diff_term: Vec3 = vec3_mul(&(mat).albedo, diffuse_light);
    let spec_term: Vec3 = vec3_mul(&(mat).specular_tint, specular_light);

    // Blend based on metallic
    let k_d: Float = 1.0 - (mat).metallic;
    let diff_scaled: Vec3 = vec3_scale(&diff_term, k_d);
    let final_color: Vec3 = vec3_add(&diff_scaled, &spec_term);

    return Vec3 {
        x: math_clamp((final_color).x, 0.0, 1.0),
        y: math_clamp((final_color).y, 0.0, 1.0),
        z: math_clamp((final_color).z, 0.0, 1.0),
    };
}
