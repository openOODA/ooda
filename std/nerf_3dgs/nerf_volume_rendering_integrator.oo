// # Numerical Quadrature Volume Rendering Integrator
//
// Logline: Discrete numerical integration of radiative transfer equation with accumulated transmittance and early termination.
//
// Setup: Synthesizes final pixel radiance, expected depth, and opacity from sampled density-color sequences.
//
// Beats:
//   1. Define VolumeRenderSample and VolumeRenderOutput structures.
//   2. Compute accumulated transmittance T_i = prod_{j<i} (1 - alpha_j) and sample weights w_i = T_i * alpha_i.
//   3. Accumulate composite RGB radiance, expected ray termination depth, and accumulated opacity.

import "./vec3_math.oo";

pub type VolumeRenderSample = struct {
    color: Vec3,
    alpha: Float,
    t_val: Float,
    delta_t: Float,
};

pub type VolumeRenderOutput = struct {
    rgb: Vec3,
    depth: Float,
    opacity: Float,
    transmittance_final: Float,
};

pub fn volume_render_output_empty() -> VolumeRenderOutput {
    return VolumeRenderOutput {
        rgb: vec3_zero(),
        depth: 0.0,
        opacity: 0.0,
        transmittance_final: 1.0,
    };
}

pub fn volume_render_step(
    out: &VolumeRenderOutput,
    sample: &VolumeRenderSample,
    white_bkgd: Int,
) -> VolumeRenderOutput {
    let alpha: Float = (sample).alpha;
    let t_curr: Float = (out).transmittance_final;

    let weight: Float = t_curr * alpha;
    let new_transmittance: Float = t_curr * (1.0 - alpha);

    let sample_rgb: Vec3 = vec3_scale(&(sample).color, weight);
    let new_rgb: Vec3 = vec3_add(&(out).rgb, &sample_rgb);

    let sample_depth: Float = (sample).t_val * weight;
    let new_depth: Float = (out).depth + sample_depth;

    let new_opacity: Float = (out).opacity + weight;

    return VolumeRenderOutput {
        rgb: new_rgb,
        depth: new_depth,
        opacity: new_opacity,
        transmittance_final: new_transmittance,
    };
}

pub fn volume_render_finalize(out: &VolumeRenderOutput, white_bkgd: Int) -> Vec3 {
    let mut final_rgb: Vec3 = (out).rgb;
    if white_bkgd != 0 {
        let bkgd_contrib: Float = (out).transmittance_final;
        final_rgb = Vec3 {
            x: (final_rgb).x + bkgd_contrib,
            y: (final_rgb).y + bkgd_contrib,
            z: (final_rgb).z + bkgd_contrib,
        };
    }
    return Vec3 {
        x: math_clamp((final_rgb).x, 0.0, 1.0),
        y: math_clamp((final_rgb).y, 0.0, 1.0),
        z: math_clamp((final_rgb).z, 0.0, 1.0),
    };
}
