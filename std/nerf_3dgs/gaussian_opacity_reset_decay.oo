// # Opacity Reset & Exponential Decay Scheduling
//
// Logline: Periodic opacity resets and exponential decay schedules preventing floater accumulation and phantom artifacts.
//
// Setup: Regularizes optimization dynamics by forcing Gaussians to re-earn opacity in subsequent iterations.
//
// Beats:
//   1. Implement periodic opacity reset trigger (typically every 3,000 iterations).
//   2. Compute clamped reset opacity value alpha_reset = min(alpha, 0.01).
//   3. Compute exponential opacity decay factor for transient Gaussian suppression.

import "./vec3_math.oo";

pub type OpacityScheduleConfig = struct {
    reset_interval: Int,
    reset_opacity_val: Float,
    decay_rate: Float
};

pub fn opacity_schedule_config_default() -> OpacityScheduleConfig {
    return OpacityScheduleConfig {
        reset_interval: 3000,
        reset_opacity_val: 0.01,
        decay_rate: 0.999
    };
}

pub fn should_reset_opacity(iteration: Int, interval: Int) -> Int {
    if iteration > 0 && (iteration % interval) == 0 {
        return 1;
    }
    return 0;
}

pub fn apply_opacity_reset(current_opacity: Float, reset_val: Float) -> Float {
    if current_opacity > reset_val {
        return reset_val;
    }
    return current_opacity;
}

pub fn apply_opacity_decay(current_opacity: Float, decay_rate: Float) -> Float {
    return current_opacity * decay_rate;
}
