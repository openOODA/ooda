// # Real Spherical Harmonics (SH) Basis Evaluation
//
// Logline: Evaluates orthonormal real spherical harmonics basis up to degree 3 (16 coefficients) for view-dependent color rendering.
//
// Setup: Foundations of directional appearance modeling in 3D Gaussian Splatting and Plenoxels.
//
// Beats:
//   1. Compute degree 0 (constant DC band), degree 1 (linear dipoles), and degree 2 (quadrupoles) SH basis.
//   2. Compute degree 3 (octupoles) SH basis functions from normalized Cartesian ray directions.
//   3. Synthesize RGB color channels from SH coefficient vectors and clamp to valid dynamic range.

import "./vec3_math.oo";

pub type SphericalHarmonicsCoeffs = struct {
    c0: Vec3,
    c1: Vec3, c2: Vec3, c3: Vec3,
    c4: Vec3, c5: Vec3, c6: Vec3, c7: Vec3, c8: Vec3
};

pub fn sh_basis_degree_0(dir: &Vec3) -> Float {
    // C0 = 0.5 * sqrt(1/pi) = 0.28209479177387814
    return 0.28209479177387814;
}

pub fn sh_eval_deg0(c0: &Vec3) -> Vec3 {
    let basis0: Float = 0.28209479177387814;
    let r: Float = (c0).x * basis0 + 0.5;
    let g: Float = (c0).y * basis0 + 0.5;
    let b: Float = (c0).z * basis0 + 0.5;
    return vec3_new(math_clamp(r, 0.0, 1.0), math_clamp(g, 0.0, 1.0), math_clamp(b, 0.0, 1.0));
}

pub fn sh_eval_deg1(c0: &Vec3, c1: &Vec3, c2: &Vec3, c3: &Vec3, dir: &Vec3) -> Vec3 {
    let x: Float = (dir).x;
    let y: Float = (dir).y;
    let z: Float = (dir).z;

    // SH degree 0
    let y00: Float = 0.28209479177387814;

    // SH degree 1 constants
    // C1 = sqrt(3/(4*pi)) = 0.4886025119029199
    let c_deg1: Float = 0.4886025119029199;
    let y1_neg1: Float = -c_deg1 * y;
    let y1_0: Float = c_deg1 * z;
    let y1_pos1: Float = -c_deg1 * x;

    let mut r: Float = (c0).x * y00 + (c1).x * y1_neg1 + (c2).x * y1_0 + (c3).x * y1_pos1 + 0.5;
    let mut g: Float = (c0).y * y00 + (c1).y * y1_neg1 + (c2).y * y1_0 + (c3).y * y1_pos1 + 0.5;
    let mut b: Float = (c0).z * y00 + (c1).z * y1_neg1 + (c2).z * y1_0 + (c3).z * y1_pos1 + 0.5;

    return vec3_new(math_clamp(r, 0.0, 1.0), math_clamp(g, 0.0, 1.0), math_clamp(b, 0.0, 1.0));
}

pub fn sh_eval_deg2(coeffs: &SphericalHarmonicsCoeffs, dir: &Vec3) -> Vec3 {
    let x: Float = (dir).x;
    let y: Float = (dir).y;
    let z: Float = (dir).z;

    let xx: Float = x * x;
    let yy: Float = y * y;
    let zz: Float = z * z;
    let xy: Float = x * y;
    let yz: Float = y * z;
    let xz: Float = x * z;

    // Degree 0
    let y0: Float = 0.28209479177387814;

    // Degree 1
    let c1: Float = 0.4886025119029199;
    let y1: Float = -c1 * y;
    let y2: Float = c1 * z;
    let y3: Float = -c1 * x;

    // Degree 2 constants
    // C2_0 = 0.5 * sqrt(15/pi) = 1.0925484305920792
    // C2_1 = 0.25 * sqrt(5/pi) = 0.31539156525252005
    // C2_2 = 0.25 * sqrt(15/pi) = 0.5462742152960396
    let y4: Float = 1.0925484305920792 * xy;
    let y5: Float = -1.0925484305920792 * yz;
    let y6: Float = 0.31539156525252005 * (2.0 * zz - xx - yy);
    let y7: Float = -1.0925484305920792 * xz;
    let y8: Float = 0.5462742152960396 * (xx - yy);

    let mut r: Float = (coeffs).c0.x * y0 + (coeffs).c1.x * y1 + (coeffs).c2.x * y2 + (coeffs).c3.x * y3 +
                      (coeffs).c4.x * y4 + (coeffs).c5.x * y5 + (coeffs).c6.x * y6 + (coeffs).c7.x * y7 + (coeffs).c8.x * y8 + 0.5;

    let mut g: Float = (coeffs).c0.y * y0 + (coeffs).c1.y * y1 + (coeffs).c2.y * y2 + (coeffs).c3.y * y3 +
                      (coeffs).c4.y * y4 + (coeffs).c5.y * y5 + (coeffs).c6.y * y6 + (coeffs).c7.y * y7 + (coeffs).c8.y * y8 + 0.5;

    let mut b: Float = (coeffs).c0.z * y0 + (coeffs).c1.z * y1 + (coeffs).c2.z * y2 + (coeffs).c3.z * y3 +
                      (coeffs).c4.z * y4 + (coeffs).c5.z * y5 + (coeffs).c6.z * y6 + (coeffs).c7.z * y7 + (coeffs).c8.z * y8 + 0.5;

    return vec3_new(math_clamp(r, 0.0, 1.0), math_clamp(g, 0.0, 1.0), math_clamp(b, 0.0, 1.0));
}

pub type SphericalHarmonicsCoeffsDeg3 = struct {
    c0: Vec3,
    c1: Vec3, c2: Vec3, c3: Vec3,
    c4: Vec3, c5: Vec3, c6: Vec3, c7: Vec3, c8: Vec3,
    c9: Vec3, c10: Vec3, c11: Vec3, c12: Vec3, c13: Vec3, c14: Vec3, c15: Vec3
};

pub fn sh_eval_deg3(coeffs: &SphericalHarmonicsCoeffsDeg3, dir: &Vec3) -> Vec3 {
    let x: Float = (dir).x;
    let y: Float = (dir).y;
    let z: Float = (dir).z;

    let xx: Float = x * x;
    let yy: Float = y * y;
    let zz: Float = z * z;
    let xy: Float = x * y;
    let yz: Float = y * z;
    let xz: Float = x * z;

    // Degree 0
    let y0: Float = 0.28209479177387814;

    // Degree 1
    let c1: Float = 0.4886025119029199;
    let y1: Float = -c1 * y;
    let y2: Float = c1 * z;
    let y3: Float = -c1 * x;

    // Degree 2
    let y4: Float = 1.0925484305920792 * xy;
    let y5: Float = -1.0925484305920792 * yz;
    let y6: Float = 0.31539156525252005 * (2.0 * zz - xx - yy);
    let y7: Float = -1.0925484305920792 * xz;
    let y8: Float = 0.5462742152960396 * (xx - yy);

    // Degree 3 constants
    let y9: Float = -0.5900435899266435 * y * (3.0 * xx - yy);
    let y10: Float = 2.890611442640554 * xy * z;
    let y11: Float = -0.4570457994644658 * y * (4.0 * zz - xx - yy);
    let y12: Float = 0.3731763325901154 * z * (2.0 * zz - 3.0 * xx - 3.0 * yy);
    let y13: Float = -0.4570457994644658 * x * (4.0 * zz - xx - yy);
    let y14: Float = 1.445305721320277 * z * (xx - yy);
    let y15: Float = -0.5900435899266435 * x * (xx - 3.0 * yy);

    let mut r: Float = (coeffs).c0.x * y0 + (coeffs).c1.x * y1 + (coeffs).c2.x * y2 + (coeffs).c3.x * y3 +
                      (coeffs).c4.x * y4 + (coeffs).c5.x * y5 + (coeffs).c6.x * y6 + (coeffs).c7.x * y7 + (coeffs).c8.x * y8 +
                      (coeffs).c9.x * y9 + (coeffs).c10.x * y10 + (coeffs).c11.x * y11 + (coeffs).c12.x * y12 + (coeffs).c13.x * y13 + (coeffs).c14.x * y14 + (coeffs).c15.x * y15 + 0.5;

    let mut g: Float = (coeffs).c0.y * y0 + (coeffs).c1.y * y1 + (coeffs).c2.y * y2 + (coeffs).c3.y * y3 +
                      (coeffs).c4.y * y4 + (coeffs).c5.y * y5 + (coeffs).c6.y * y6 + (coeffs).c7.y * y7 + (coeffs).c8.y * y8 +
                      (coeffs).c9.y * y9 + (coeffs).c10.y * y10 + (coeffs).c11.y * y11 + (coeffs).c12.y * y12 + (coeffs).c13.y * y13 + (coeffs).c14.y * y14 + (coeffs).c15.y * y15 + 0.5;

    let mut b: Float = (coeffs).c0.z * y0 + (coeffs).c1.z * y1 + (coeffs).c2.z * y2 + (coeffs).c3.z * y3 +
                      (coeffs).c4.z * y4 + (coeffs).c5.z * y5 + (coeffs).c6.z * y6 + (coeffs).c7.z * y7 + (coeffs).c8.z * y8 +
                      (coeffs).c9.z * y9 + (coeffs).c10.z * y10 + (coeffs).c11.z * y11 + (coeffs).c12.z * y12 + (coeffs).c13.z * y13 + (coeffs).c14.z * y14 + (coeffs).c15.z * y15 + 0.5;

    return vec3_new(math_clamp(r, 0.0, 1.0), math_clamp(g, 0.0, 1.0), math_clamp(b, 0.0, 1.0));
}


pub fn spherical_harmonics_sh_eval_probe() -> Int {
    return 0;
}
