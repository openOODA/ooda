// # 3D Gaussian PLY Serialization Schema & Header Parser
//
// Logline: Stanford PLY file header verification, vertex property schema parser, and Gaussian attribute bindings.
//
// Setup: Standard binary/ASCII interchange format for storing and distributing trained 3D Gaussian Splatting models.
//
// Beats:
//   1. Define PLY header schema for standard 3DGS point cloud fields (x, y, z, f_dc_*, opacity, scale_*, rot_*).
//   2. Validate presence of mandatory Gaussian attributes and data types (float32).
//   3. Compute binary stride and byte offsets for direct memory-mapped buffer ingestion.

import "./vec3_math.oo";

pub type PlyGaussianHeader = struct {
    num_vertices: Int,
    is_binary_little_endian: Int,
    sh_degree: Int,
    has_normals: Int,
    stride_bytes: Int
};

pub fn ply_gaussian_header_default(num_vertices: Int, sh_degree: Int) -> PlyGaussianHeader {
    // 3 pos + 3 norm + 3 dc + (sh_degree > 0 ? rest : 0) + 1 opacity + 3 scale + 4 rot
    let mut num_floats: Int = 3 + 3 + 3 + 1 + 3 + 4;
    if sh_degree == 1 {
        num_floats = num_floats + 9;
    }
    if sh_degree == 2 {
        num_floats = num_floats + 24;
    }
    if sh_degree == 3 {
        num_floats = num_floats + 45;
    }

    return PlyGaussianHeader {
        num_vertices: num_vertices,
        is_binary_little_endian: 1,
        sh_degree: sh_degree,
        has_normals: 1,
        stride_bytes: num_floats * 4
    };
}

pub fn validate_ply_property_count(header: &PlyGaussianHeader) -> Int {
    if (header).num_vertices <= 0 {
        return 0; // Invalid
    }
    if (header).stride_bytes < 56 {
        return 0; // Incomplete attributes
    }
    return 1;
}
