// # Mip-NeRF 360 Distortion Loss & Floater Regularization
//
// Logline: Regularization penalty that consolidates ray weights into compact step functions and eliminates background floaters.
//
// Setup: Penalizes the dispersion of rendering weights along rays to enforce clean surface transitions.
//
// Beats:
//   1. Implement cross-interval weight dispersion penalty sum_{i,j} w_i w_j |s_i - s_j|.
//   2. Implement intra-interval self-dispersion penalty (1/3) * sum_i w_i^2 * delta_s_i.
//   3. Compute normalized distortion loss for unbounded scene regularization.

import "./vec3_math.oo";

pub type DistortionLossConfig = struct {
    weight_loss_distortion: Float,
    weight_loss_floater: Float
};

pub fn distortion_loss_config_default() -> DistortionLossConfig {
    return DistortionLossConfig {
        weight_loss_distortion: 0.01,
        weight_loss_floater: 0.005
    };
}

pub fn distortion_loss_pair(w_i: Float, s_i: Float, w_j: Float, s_j: Float) -> Float {
    let diff: Float = math_abs(s_i - s_j);
    return w_i * w_j * diff;
}

pub fn distortion_loss_interval(w_i: Float, delta_s: Float) -> Float {
    return (1.0 / 3.0) * (w_i * w_i) * delta_s;
}

pub fn floater_penalty(opacity_accum: Float, target_threshold: Float) -> Float {
    // Penalize semi-transparent clouds that fail to hit opaque surfaces
    if opacity_accum < target_threshold && opacity_accum > 0.01 {
        let diff: Float = target_threshold - opacity_accum;
        return diff * diff;
    }
    return 0.0;
}
