// # Multi-Level Occupancy Grid Acceleration
//
// Logline: Cascaded binary occupancy grids for fast empty space skipping and early ray termination.
//
// Setup: Accelerates ray marching by up to 10-100x by jumping over empty regions without querying neural networks.
//
// Beats:
//   1. Define OccupancyGridConfig with grid resolution N^3 and cascade levels.
//   2. Compute grid bitmask lookups from 3D continuous positions.
//   3. Compute ray marching skip step sizes through unallocated / empty cells.

import "./vec3_math.oo";

pub type OccupancyGridConfig = struct {
    resolution: Int,
    num_cascades: Int,
    occupancy_threshold: Float,
};

pub fn occupancy_grid_config_default() -> OccupancyGridConfig {
    return OccupancyGridConfig {
        resolution: 128,
        num_cascades: 4,
        occupancy_threshold: 0.01,
    };
}

pub fn occupancy_grid_coord_to_index(config: &OccupancyGridConfig, x: Int, y: Int, z: Int) -> Int {
    let res: Int = (config).resolution;
    return x + y * res + z * res * res;
}

pub fn occupancy_grid_test_point(pos: &Vec3, bound: Float, density_val: Float, threshold: Float) -> Int {
    // Check if point is inside bounding cube
    let max_abs: Float = math_clamp((pos).x, -(pos).x, (pos).x);
    if max_abs > bound {
        return 0; // Out of bounds
    }
    if density_val >= threshold {
        return 1; // Occupied
    }
    return 0; // Empty
}

pub fn occupancy_grid_adaptive_step(is_occupied: Int, base_step: Float, skip_multiplier: Float) -> Float {
    if is_occupied == 0 {
        return base_step * skip_multiplier;
    }
    return base_step;
}
