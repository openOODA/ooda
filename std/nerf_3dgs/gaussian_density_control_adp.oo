// # Adaptive Gaussian Density Control (Split, Clone, Prune)
//
// Logline: Dynamic densification and pruning policy governing 3D Gaussian cloning, splitting, and transparency culling.
//
// Setup: Refines geometric resolution by duplicating under-reconstructed areas and subdividing over-sized Gaussians.
//
// Beats:
//   1. Track accumulated screen-space positional gradient norm grad_p over optimization iterations.
//   2. Apply densification rules: Clone small Gaussians and Split large Gaussians into two smaller primitives.
//   3. Prune transparent Gaussians with opacity below threshold epsilon_alpha.

import "./vec3_math.oo";
import "./gaussian_3d_primitive.oo";

pub type DensityControlConfig = struct {
    grad_threshold: Float,
    min_opacity: Float,
    max_screen_size_ratio: Float,
    percentile_scale_split: Float
};

pub fn density_control_config_default() -> DensityControlConfig {
    return DensityControlConfig {
        grad_threshold: 0.0002,
        min_opacity: 0.005,
        max_screen_size_ratio: 0.15,
        percentile_scale_split: 0.01
    };
}

pub fn should_prune_gaussian(opacity: Float, min_opacity: Float) -> Int {
    if opacity < min_opacity {
        return 1; // Prune
    }
    return 0; // Keep
}

pub fn should_densify_gaussian(avg_grad_norm: Float, threshold: Float) -> Int {
    if avg_grad_norm > threshold {
        return 1; // Densify (split or clone)
    }
    return 0;
}

pub fn split_gaussian_scale(scale: &Vec3) -> Vec3 {
    // When splitting, divide scale by factor 1.6
    let inv_factor: Float = 1.0 / 1.6;
    return vec3_scale(scale, inv_factor);
}
