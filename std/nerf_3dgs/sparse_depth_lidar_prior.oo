// # Sparse LiDAR & SfM Depth Prior Loss
//
// Logline: Multi-modal depth supervision loss anchoring NeRF ray terminations to sparse LiDAR points or SfM tie points.
//
// Setup: Accelerates convergence and resolves multi-view ambiguity in textureless or specular scene regions.
//
// Beats:
//   1. Define SparseDepthSample with 2D pixel coordinate, measured target depth, and measurement variance sigma_depth.
//   2. Compute depth loss L_depth = (D_rendered - D_target)^2 / (2 * sigma_depth^2).
//   3. Compute Huber robust loss penalty for outlier filtering on imperfect sensor depth measurements.

import "./vec3_math.oo";

pub type SparseDepthSample = struct {
    pixel_x: Float,
    pixel_y: Float,
    target_depth: Float,
    depth_variance: Float
};

pub fn depth_prior_sample_new(px: Float, py: Float, target_d: Float, var_d: Float) -> SparseDepthSample {
    return SparseDepthSample {
        pixel_x: px,
        pixel_y: py,
        target_depth: target_d,
        depth_variance: math_clamp(var_d, 0.0001, 10.0)
    };
}

pub fn depth_gaussian_nll_loss(rendered_depth: Float, target: &SparseDepthSample) -> Float {
    let diff: Float = rendered_depth - (target).target_depth;
    let var_d: Float = (target).depth_variance;
    return (diff * diff) / (2.0 * var_d);
}

pub fn depth_huber_loss(rendered_depth: Float, target_depth: Float, delta: Float) -> Float {
    let abs_diff: Float = math_abs(rendered_depth - target_depth);
    if abs_diff <= delta {
        return 0.5 * abs_diff * abs_diff;
    }
    return delta * (abs_diff - 0.5 * delta);
}
