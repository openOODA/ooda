// # 3D Gaussian Covariance Matrix Construction
//
// Logline: Constructs symmetric positive-definite 3D spatial covariance matrices Sigma = R S S^T R^T from scale and rotation.
//
// Setup: Parameterizes anisotropic 3D ellipsoid ellipsoidal extents and spatial orientation for splat rasterization.
//
// Beats:
//   1. Construct diagonal scale matrix S and quaternion rotation matrix R.
//   2. Compute matrix product M = R S and 3D spatial covariance Sigma = M M^T.
//   3. Extract symmetric 6-element upper triangular covariance representation (xx, xy, xz, yy, yz, zz).

import "./vec3_math.oo";

pub type Covariance3D = struct {
    cov_xx: Float,
    cov_xy: Float,
    cov_xz: Float,
    cov_yy: Float,
    cov_yz: Float,
    cov_zz: Float,
};

pub fn covariance_3d_from_scale_rot(scale: &Vec3, rot: &Quaternion) -> Covariance3D {
    let r: Mat3 = quat_to_mat3(rot);

    // M = R * S (each column of R scaled by scale components)
    let sx: Float = (scale).x;
    let sy: Float = (scale).y;
    let sz: Float = (scale).z;

    let m00: Float = (r).m00 * sx;
    let m01: Float = (r).m01 * sy;
    let m02: Float = (r).m02 * sz;

    let m10: Float = (r).m10 * sx;
    let m11: Float = (r).m11 * sy;
    let m12: Float = (r).m12 * sz;

    let m20: Float = (r).m20 * sx;
    let m21: Float = (r).m21 * sy;
    let m22: Float = (r).m22 * sz;

    // Sigma = M * M^T
    let xx: Float = m00 * m00 + m01 * m01 + m02 * m02;
    let xy: Float = m00 * m10 + m01 * m11 + m02 * m12;
    let xz: Float = m00 * m20 + m01 * m21 + m02 * m22;
    let yy: Float = m10 * m10 + m11 * m11 + m12 * m12;
    let yz: Float = m10 * m20 + m11 * m21 + m12 * m22;
    let zz: Float = m20 * m20 + m21 * m21 + m22 * m22;

    return Covariance3D {
        cov_xx: xx,
        cov_xy: xy,
        cov_xz: xz,
        cov_yy: yy,
        cov_yz: yz,
        cov_zz: zz,
    };
}

pub fn gaussian_covariance_3d_probe() -> Int {
    return 0;
}
