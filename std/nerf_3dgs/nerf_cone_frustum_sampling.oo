// # Conical Frustum & Cylindrical Ray Sampling
//
// Logline: Multi-scale anti-aliasing cone parameterized sampling intervals for wide-aperture and variable-distance rays.
//
// Setup: Calculates geometric footprint of rays passing through discrete camera sensor pixels.
//
// Beats:
//   1. Compute pixel radius and angular cone spread angle theta from camera focal length.
//   2. Subdivide continuous ray cones into discrete consecutive conical frustum sections.
//   3. Compute frustum volume, centroid, and anisotropic covariance axes for anti-aliasing.

import "./vec3_math.oo";
import "./integrated_positional_encoding.oo";

pub type RayCone = struct {
    origin: Vec3,
    direction: Vec3,
    radius: Float,
};

pub fn ray_cone_new(origin: Vec3, direction: Vec3, focal: Float) -> RayCone {
    // Standard pixel radius in radians is 2.0 / (sqrt(12) * focal)
    let radius_factor: Float = 2.0 / (3.4641016 * focal);
    return RayCone {
        origin: origin,
        direction: vec3_normalize(&direction),
        radius: radius_factor,
    };
}

pub fn ray_cone_frustum_at(cone: &RayCone, t0: Float, t1: Float) -> ConicalFrustum {
    return ConicalFrustum {
        origin: (cone).origin,
        direction: (cone).direction,
        t0: t0,
        t1: t1,
        radius: (cone).radius,
    };
}

pub fn cone_frustum_volume(r0: Float, r1: Float, height: Float) -> Float {
    let pi: Float = 3.141592653589793;
    // Volume of conical frustum: (1/3) * pi * h * (r0^2 + r0*r1 + r1^2)
    return (pi * height * (r0 * r0 + r0 * r1 + r1 * r1)) / 3.0;
}
