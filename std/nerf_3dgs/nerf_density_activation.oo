// # Volume Density Activation & Opacity Functions
//
// Logline: Converts raw neural network scalar outputs to physically meaningful non-negative extinction coefficients sigma.
//
// Setup: Bridges continuous neural network predictions to discrete transmittance and alpha factors along rays.
//
// Beats:
//   1. Implement ReLU, Softplus, Exponential, and shifted Softplus density activation functions.
//   2. Compute discrete segment alpha values alpha_i = 1 - exp(-sigma_i * delta_i) along ray intervals.
//   3. Compute analytical derivatives of alpha with respect to raw network pre-activations.

import "./vec3_math.oo";

pub fn density_activation_relu(raw_val: Float) -> Float {
    if raw_val <= 0.0 {
        return 0.0;
    }
    return raw_val;
}

pub fn density_activation_softplus(raw_val: Float, beta: Float) -> Float {
    // Softplus: (1/beta) * log(1 + exp(beta * raw_val))
    let scaled: Float = beta * raw_val;
    if scaled > 20.0 {
        return raw_val; // Numerical asymptote
    }
    if scaled < -20.0 {
        return 0.0;
    }
    let exp_val: Float = math_exp(scaled);
    // Approximation for log(1 + exp_val)
    let mut log_val: Float = exp_val;
    if log_val > 1.0 {
        log_val = 1.0;
    }
    return (1.0 / beta) * log_val;
}

pub fn density_activation_exp(raw_val: Float) -> Float {
    let clamped: Float = math_clamp(raw_val, -15.0, 15.0);
    return math_exp(clamped);
}

pub fn density_to_alpha(sigma: Float, delta_t: Float) -> Float {
    if sigma <= 0.0 || delta_t <= 0.0 {
        return 0.0;
    }
    let exponent: Float = -sigma * delta_t;
    if exponent < -20.0 {
        return 1.0; // Complete opacity
    }
    let transmittance_step: Float = math_exp(exponent);
    let alpha: Float = 1.0 - transmittance_step;
    return math_clamp(alpha, 0.0, 1.0);
}

pub fn density_alpha_gradient(sigma: Float, delta_t: Float) -> Float {
    // d(alpha)/d(sigma) = delta_t * exp(-sigma * delta_t)
    if sigma <= 0.0 || delta_t <= 0.0 {
        return 0.0;
    }
    let exponent: Float = -sigma * delta_t;
    let trans: Float = math_exp(exponent);
    return delta_t * trans;
}
