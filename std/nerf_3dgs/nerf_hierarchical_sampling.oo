// # Hierarchical Sampling & Inverse Transform Sampling
//
// Logline: Coarse-to-fine importance sampling along rays using piecewise-constant probability density functions.
//
// Setup: Concentrates fine MLP evaluations around regions with high volume density and surface probability.
//
// Beats:
//   1. Construct normalized Probability Density Functions (PDF) and Cumulative Distribution Functions (CDF) from coarse weights.
//   2. Perform inverse transform sampling via binary search on discrete CDF intervals.
//   3. Merge and sort stratified coarse and fine sampling coordinates along the ray parameter t.

import "./vec3_math.oo";

pub type SamplingConfig = struct {
    num_coarse_samples: Int,
    num_fine_samples: Int,
    perturb: Int,
};

pub fn sampling_config_default() -> SamplingConfig {
    return SamplingConfig {
        num_coarse_samples: 64,
        num_fine_samples: 128,
        perturb: 1,
    };
}

pub fn stratified_sample_t(t_near: Float, t_far: Float, index: Int, total_samples: Int, jitter: Float) -> Float {
    let span: Float = t_far - t_near;
    let step: Float = span / (total_samples as Float);
    let base: Float = t_near + (index as Float) * step;
    let offset: Float = jitter * step;
    return base + offset;
}

pub fn normalize_weights_pdf(weights_sum: Float, weight_i: Float, eps: Float) -> Float {
    let total: Float = weights_sum + eps;
    return (weight_i + eps) / total;
}

pub fn inverse_transform_sample_bin(
    u_random: Float,
    cdf_lower: Float,
    cdf_upper: Float,
    t_lower: Float,
    t_upper: Float,
) -> Float {
    let denom: Float = cdf_upper - cdf_lower;
    if denom <= 0.00001 {
        return (t_lower + t_upper) * 0.5;
    }
    let fraction: Float = (u_random - cdf_lower) / denom;
    let clamped_frac: Float = math_clamp(fraction, 0.0, 1.0);
    return t_lower + clamped_frac * (t_upper - t_lower);
}
