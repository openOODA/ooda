// # Depth & Density Gradient Surface Normal Estimation
//
// Logline: Extracts continuous depth maps, disparity fields, and surface normal vectors from volume density gradients.
//
// Setup: Bridges volumetric density distributions to explicit geometric surface representations and photometric normals.
//
// Beats:
//   1. Compute expected depth and disparity along rays from accumulated transmittance weights.
//   2. Extract analytical spatial gradients of volume density grad(sigma) via central finite differences.
//   3. Normalize negative density gradients into unit surface normal vectors for relighting and geometry supervision.

import "./vec3_math.oo";

pub type DepthNormalOutput = struct {
    depth: Float,
    disparity: Float,
    normal: Vec3,
};

pub fn compute_disparity(depth: Float, min_depth: Float, max_depth: Float) -> Float {
    if depth <= min_depth {
        return 1.0;
    }
    if depth >= max_depth {
        return 0.0;
    }
    return (1.0 / depth - 1.0 / max_depth) / (1.0 / min_depth - 1.0 / max_depth);
}

pub fn density_gradient_to_normal(grad_x: Float, grad_y: Float, grad_z: Float) -> Vec3 {
    // Normal is negative normalized gradient of density
    let grad: Vec3 = vec3_new(-grad_x, -grad_y, -grad_z);
    let len: Float = vec3_length(&grad);
    if len > 0.000001 {
        return vec3_scale(&grad, 1.0 / len);
    }
    return vec3_new(0.0, 0.0, 1.0);
}
