// # Perceptual Feature Loss (LPIPS / VGG) Proxy
//
// Logline: Multi-scale feature map cosine distance and patch-level structural similarity for perceptual supervision.
//
// Setup: Complements pixel-wise L1/L2 losses with human visual perception alignment to avoid blurry reconstructions.
//
// Beats:
//   1. Define PerceptualLossConfig with feature layer weightings (conv1_2, conv2_2, conv3_2, conv4_2).
//   2. Compute normalized feature vector Euclidean distance d_perceptual(F_pred, F_gt).
//   3. Compute patch-level color gradient matching loss for high-frequency edge sharpening.

import "./vec3_math.oo";

pub type PerceptualLossConfig = struct {
    weight_layer1: Float,
    weight_layer2: Float,
    weight_layer3: Float,
    weight_layer4: Float,
};

pub fn perceptual_loss_config_default() -> PerceptualLossConfig {
    return PerceptualLossConfig {
        weight_layer1: 0.1,
        weight_layer2: 0.2,
        weight_layer3: 0.4,
        weight_layer4: 0.3,
    };
}

pub fn normalized_feature_diff_sq(f_pred: Float, f_gt: Float, eps: Float) -> Float {
    let diff: Float = f_pred - f_gt;
    return (diff * diff) / (f_gt * f_gt + eps);
}

pub fn patch_gradient_loss(
    grad_x_pred: Float, grad_y_pred: Float,
    grad_x_gt: Float, grad_y_gt: Float,
) -> Float {
    let diff_x: Float = math_abs(grad_x_pred - grad_x_gt);
    let diff_y: Float = math_abs(grad_y_pred - grad_y_gt);
    return diff_x + diff_y;
}
