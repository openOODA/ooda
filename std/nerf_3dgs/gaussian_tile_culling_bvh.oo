// # Screen-Space Tile Binning & Gaussian Culling
//
// Logline: 16x16 pixel tile grid binning, screen boundary culling, and tile overlap index range generation.
//
// Setup: Organizes millions of 2D screen splats into localized hardware tiles for parallel GPU rasterization.
//
// Beats:
//   1. Define TileGridConfig with tile dimensions (typically 16x16 pixels) and image resolution.
//   2. Compute integer tile coordinate bounds (min_tile_x, max_tile_x, min_tile_y, max_tile_y) for 2D splats.
//   3. Cull out-of-frustum Gaussians and compute tile duplicate count per Gaussian.

import "./vec3_math.oo";
import "./gaussian_projective_2d.oo";

pub type TileGridConfig = struct {
    tile_width: Int,
    tile_height: Int,
    tiles_x: Int,
    tiles_y: Int
};

pub type TileOverlapBounds = struct {
    min_tx: Int,
    max_tx: Int,
    min_ty: Int,
    max_ty: Int,
    is_visible: Int
};

pub fn tile_grid_config_new(img_w: Int, img_h: Int, tile_size: Int) -> TileGridConfig {
    let tx: Int = (img_w + tile_size - 1) / tile_size;
    let ty: Int = (img_h + tile_size - 1) / tile_size;
    return TileGridConfig {
        tile_width: tile_size,
        tile_height: tile_size,
        tiles_x: tx,
        tiles_y: ty
    };
}

pub fn gaussian_tile_overlap(
    splat: &ProjectedGaussian2D,
    grid: &TileGridConfig,
    img_w: Int,
    img_h: Int,
) -> TileOverlapBounds {
    let rad: Float = (splat).radius;
    if rad <= 0.0 {
        return TileOverlapBounds { min_tx: 0, max_tx: 0, min_ty: 0, max_ty: 0, is_visible: 0 };
    }

    let px: Float = (splat).screen_x;
    let py: Float = (splat).screen_y;

    let min_x: Float = px - rad;
    let max_x: Float = px + rad;
    let min_y: Float = py - rad;
    let max_y: Float = py + rad;

    if max_x < 0.0 || min_x >= (img_w as Float) || max_y < 0.0 || min_y >= (img_h as Float) {
        return TileOverlapBounds { min_tx: 0, max_tx: 0, min_ty: 0, max_ty: 0, is_visible: 0 };
    }

    let tile_sz: Float = (grid).tile_width as Float;

    let mut min_tx: Int = (min_x / tile_sz) as Int;
    let mut max_tx: Int = (max_x / tile_sz) as Int;
    let mut min_ty: Int = (min_y / tile_sz) as Int;
    let mut max_ty: Int = (max_y / tile_sz) as Int;

    if min_tx < 0 { min_tx = 0; }
    if max_tx >= (grid).tiles_x { max_tx = (grid).tiles_x - 1; }
    if min_ty < 0 { min_ty = 0; }
    if max_ty >= (grid).tiles_y { max_ty = (grid).tiles_y - 1; }

    return TileOverlapBounds {
        min_tx: min_tx,
        max_tx: max_tx,
        min_ty: min_ty,
        max_ty: max_ty,
        is_visible: 1
    };
}

pub fn tile_index_from_coord(grid: &TileGridConfig, tx: Int, ty: Int) -> Int {
    return tx + ty * (grid).tiles_x;
}
