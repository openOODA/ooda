pub type NeRF3DGSSceneConfig = struct {
    render_mode: Int, // 0: NeRF Volume Rendering, 1: 3D Gaussian Splatting
    image_width: Int,
    image_height: Int,
    sh_degree: Int,
    white_background: Int
};

pub fn nerf_3dgs_scene_config_default() -> NeRF3DGSSceneConfig {
    return NeRF3DGSSceneConfig {
        render_mode: 1, // Default 3DGS
        image_width: 1920,
        image_height: 1080,
        sh_degree: 3,
        white_background: 0
    };
}
