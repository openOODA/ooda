// # Synthetic Blender Dataset Specification (transforms.json)
//
// Logline: Data specification and camera coordinate transformations for NeRF Synthetic Blender benchmarks.
//
// Setup: Bridges Blender camera conventions (OpenGL coordinate system) to standard openOODA vision frame.
//
// Beats:
//   1. Define BlenderDatasetHeader with camera angle x, focal length, and frame dimensions.
//   2. Define BlenderFrameEntry with file path, rotation angle, and 4x4 transformation matrix.
//   3. Convert Blender camera coordinate frame (X right, Y up, Z back) to NeRF ray convention.

import "./vec3_math.oo";
import "./camera_pinhole_intrinsics.oo";
import "./camera_pose_se3.oo";

pub type BlenderDatasetHeader = struct {
    camera_angle_x: Float,
    image_width: Int,
    image_height: Int,
    near_bound: Float,
    far_bound: Float
};

pub fn blender_dataset_header_default() -> BlenderDatasetHeader {
    return BlenderDatasetHeader {
        camera_angle_x: 0.6911112, // ~39.6 degrees (focal ~ 1111 on 800x800)
        image_width: 800,
        image_height: 800,
        near_bound: 2.0,
        far_bound: 6.0
    };
}

pub fn blender_focal_length(header: &BlenderDatasetHeader) -> Float {
    let half_angle: Float = (header).camera_angle_x * 0.5;
    let mut tan_val: Float = half_angle;
    if tan_val < 0.001 { tan_val = 0.001; }
    return (0.5 * ((header).image_width as Float)) / tan_val;
}

pub fn blender_intrinsics_from_header(header: &BlenderDatasetHeader) -> CameraIntrinsics {
    let f: Float = blender_focal_length(header);
    let cx: Float = ((header).image_width as Float) * 0.5;
    let cy: Float = ((header).image_height as Float) * 0.5;
    return camera_intrinsics_new((header).image_width, (header).image_height, f, f, cx, cy);
}
