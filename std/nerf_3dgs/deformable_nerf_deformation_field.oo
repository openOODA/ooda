// # Non-Rigid Deformation Field for Dynamic NeRF
//
// Logline: Spatial deformation field mapping time-varying dynamic coordinates (x, t) to canonical rest space.
//
// Setup: Parameterizes continuous non-rigid motion vectors and SE(3) screw transformations across temporal video frames.
//
// Beats:
//   1. Define DeformationConfig with temporal frequency encoding bands and maximum displacement bounds.
//   2. Compute 3D translation offset delta_x(x, t) and local rigid rotation quaternion delta_q(x, t).
//   3. Transform observation points into canonical coordinate space for static radiance network evaluation.

import "./vec3_math.oo";

pub type DeformationConfig = struct {
    num_time_frequencies: Int,
    elastic_regularization_weight: Float
};

pub type DeformedPoint = struct {
    canonical_pos: Vec3,
    displacement_norm: Float
};

pub fn deformation_config_default() -> DeformationConfig {
    return DeformationConfig {
        num_time_frequencies: 6,
        elastic_regularization_weight: 0.001
    };
}

pub fn deform_point_to_canonical(pos: &Vec3, delta_pos: &Vec3) -> DeformedPoint {
    let canon_pos: Vec3 = vec3_add(pos, delta_pos);
    let disp: Float = vec3_length(delta_pos);
    return DeformedPoint {
        canonical_pos: canon_pos,
        displacement_norm: disp
    };
}

pub fn elastic_regularization_penalty(disp_norm: Float, max_allowed: Float) -> Float {
    if disp_norm > max_allowed {
        let excess: Float = disp_norm - max_allowed;
        return excess * excess;
    }
    return 0.0;
}
