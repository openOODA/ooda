// # Tone Mapping & Exposure Compensation Pipeline
//
// Logline: Non-linear tone mapping curves, Reinhard compression, and gamma correction for high dynamic range neural radiance.
//
// Setup: Maps unbounded physical radiance output from neural volume rendering into 8-bit dynamic range display buffers.
//
// Beats:
//   1. Implement exposure scaling C_exp = C * 2^(EV) with exposure value adjustment.
//   2. Apply Reinhard tone mapping C_mapped = C / (1 + C) and ACES approximation.
//   3. Apply sRGB gamma correction C_srgb = C^(1/2.2) and dynamic range clamp [0, 1].

import "./vec3_math.oo";

pub type ExposureToneConfig = struct {
    exposure_value: Float,
    gamma: Float,
    use_reinhard: Int
};

pub fn exposure_tone_config_default() -> ExposureToneConfig {
    return ExposureToneConfig {
        exposure_value: 0.0,
        gamma: 2.2,
        use_reinhard: 1
    };
}

pub fn reinhard_tone_map(hdr: &Vec3) -> Vec3 {
    let r: Float = (hdr).x / (1.0 + (hdr).x);
    let g: Float = (hdr).y / (1.0 + (hdr).y);
    let b: Float = (hdr).z / (1.0 + (hdr).z);
    return vec3_new(r, g, b);
}

pub fn apply_gamma_correction(rgb: &Vec3, gamma: Float) -> Vec3 {
    let inv_gamma: Float = 1.0 / gamma;
    // Approximating x^(1/2.2) via square root for 2.0 approx
    let r: Float = math_sqrt((rgb).x);
    let g: Float = math_sqrt((rgb).y);
    let b: Float = math_sqrt((rgb).z);
    return vec3_new(
        math_clamp(r, 0.0, 1.0),
        math_clamp(g, 0.0, 1.0),
        math_clamp(b, 0.0, 1.0),
    );
}
