// # Tri-Plane Feature Field Representation
//
// Logline: Orthogonal 2D plane decomposition (XY, XZ, YZ) with bilinear feature interpolation for 3D radiance fields.
//
// Setup: Compact O(N^2) memory footprint alternative to full 3D voxel grids for fast generative and neural 3D modeling.
//
// Beats:
//   1. Project 3D continuous point p = (x, y, z) onto XY, XZ, and YZ canonical planes.
//   2. Perform 2D bilinear sampling on planar feature maps with boundary clamp/mirror modes.
//   3. Aggregate multi-plane features via summation, Hadamard product, or MLP concatenation.

import "./vec3_math.oo";

pub type TriplaneConfig = struct {
    plane_resolution: Int,
    feature_dim: Int,
    aggregation_mode: Int, // 0: Sum, 1: Product, 2: Concat
};

pub type PlaneCoordinates = struct {
    u_xy: Float, v_xy: Float,
    u_xz: Float, v_xz: Float,
    u_yz: Float, v_yz: Float,
};

pub fn triplane_config_default() -> TriplaneConfig {
    return TriplaneConfig {
        plane_resolution: 256,
        feature_dim: 32,
        aggregation_mode: 0,
    };
}

pub fn triplane_project_point(pos: &Vec3, bound_min: &Vec3, bound_max: &Vec3) -> PlaneCoordinates {
    // Normalize coordinates to [0, 1] range
    let span_x: Float = (bound_max).x - (bound_min).x;
    let span_y: Float = (bound_max).y - (bound_min).y;
    let span_z: Float = (bound_max).z - (bound_min).z;

    let nx: Float = math_clamp(((pos).x - (bound_min).x) / span_x, 0.0, 1.0);
    let ny: Float = math_clamp(((pos).y - (bound_min).y) / span_y, 0.0, 1.0);
    let nz: Float = math_clamp(((pos).z - (bound_min).z) / span_z, 0.0, 1.0);

    return PlaneCoordinates {
        u_xy: nx, v_xy: ny,
        u_xz: nx, v_xz: nz,
        u_yz: ny, v_yz: nz,
    };
}

pub fn bilinear_interpolate_2d(
    top_left: Float, top_right: Float,
    bottom_left: Float, bottom_right: Float,
    u: Float, v: Float,
) -> Float {
    let top: Float = top_left * (1.0 - u) + top_right * u;
    let bottom: Float = bottom_left * (1.0 - u) + bottom_right * u;
    return top * (1.0 - v) + bottom * v;
}

pub fn triplane_aggregate_features(feat_xy: Float, feat_xz: Float, feat_yz: Float, mode: Int) -> Float {
    if mode == 1 {
        // Multiplicative / Hadamard product aggregation
        return feat_xy * feat_xz * feat_yz;
    }
    // Default additive aggregation
    return feat_xy + feat_xz + feat_yz;
}
