// # Surface Mesh Extraction & TSDF Marching Cubes
//
// Logline: Converts continuous 3D Gaussian density fields into explicit polygonal triangle meshes via Marching Cubes.
//
// Setup: Bridges unstructured neural point splats to standard 3D triangle geometry for physics engines and DCC tools.
//
// Beats:
//   1. Sample continuous 3D Gaussian density field onto a discrete 3D TSDF voxel grid.
//   2. Compute iso-surface crossing values at voxel edges against level-set threshold sigma_iso.
//   3. Generate triangle vertex positions, interpolated vertex normals, and vertex colors.

import "./vec3_math.oo";

pub type MarchingCubesConfig = struct {
    grid_resolution: Int,
    iso_level: Float,
    bounding_radius: Float
};

pub type MeshVertex = struct {
    position: Vec3,
    normal: Vec3
};

pub fn marching_cubes_config_default() -> MarchingCubesConfig {
    return MarchingCubesConfig {
        grid_resolution: 128,
        iso_level: 0.5,
        bounding_radius: 1.5
    };
}

pub fn interpolate_edge_vertex(
    p1: &Vec3, p2: &Vec3,
    val1: Float, val2: Float,
    iso_val: Float,
) -> Vec3 {
    let diff: Float = val2 - val1;
    if math_abs(diff) <= 0.00001 {
        return vec3_scale(&vec3_add(p1, p2), 0.5);
    }
    let mu: Float = (iso_val - val1) / diff;
    let clamped_mu: Float = math_clamp(mu, 0.0, 1.0);

    let delta: Vec3 = vec3_sub(p2, p1);
    let offset: Vec3 = vec3_scale(&delta, clamped_mu);
    return vec3_add(p1, &offset);
}
