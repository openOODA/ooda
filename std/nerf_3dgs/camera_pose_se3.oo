// # Camera Poses & SE(3) Rigid Body Transformations
//
// Logline: Camera extrinsics, rotation matrices, translation vectors, and camera-to-world (c2w) / world-to-camera (w2c) conversions.
//
// Setup: Parameterizes 6-DOF camera positions and orientations for multi-view scene synthesis in NeRF and 3DGS.
//
// Beats:
//   1. Define CameraPose structure with rotation matrix R and translation vector t.
//   2. Compute camera optical center in world coordinates and camera viewing direction.
//   3. Implement SE(3) inverse transformation, pose interpolation, and look-at matrix generation.

import "./vec3_math.oo";

pub type CameraPose = struct {
    rotation: Mat3,
    translation: Vec3,
};

pub fn camera_pose_identity() -> CameraPose {
    return CameraPose {
        rotation: mat3_identity(),
        translation: vec3_zero(),
    };
}

pub fn camera_pose_new(rot: Mat3, trans: Vec3) -> CameraPose {
    return CameraPose {
        rotation: rot,
        translation: trans,
    };
}

pub fn camera_pose_world_to_cam(c2w: &CameraPose) -> CameraPose {
    let r_inv: Mat3 = mat3_transpose(&(c2w).rotation);
    let neg_t: Vec3 = vec3_scale(&(c2w).translation, -1.0);
    let t_inv: Vec3 = mat3_mul_vec(&r_inv, &neg_t);
    return CameraPose {
        rotation: r_inv,
        translation: t_inv,
    };
}

pub fn camera_pose_cam_to_world_point(c2w: &CameraPose, pt_cam: &Vec3) -> Vec3 {
    let rot_pt: Vec3 = mat3_mul_vec(&(c2w).rotation, pt_cam);
    return vec3_add(&rot_pt, &(c2w).translation);
}

pub fn camera_pose_world_to_cam_point(w2c: &CameraPose, pt_world: &Vec3) -> Vec3 {
    let rot_pt: Vec3 = mat3_mul_vec(&(w2c).rotation, pt_world);
    return vec3_add(&rot_pt, &(w2c).translation);
}

pub fn camera_pose_center(c2w: &CameraPose) -> Vec3 {
    return (c2w).translation;
}

pub fn camera_pose_view_direction(c2w: &CameraPose) -> Vec3 {
    // Forward vector in OpenGL / NeRF convention is -Z or +Z depending on standard
    let forward_local: Vec3 = vec3_new(0.0, 0.0, -1.0);
    return mat3_mul_vec(&(c2w).rotation, &forward_local);
}

pub fn camera_pose_look_at(eye: &Vec3, target: &Vec3, up: &Vec3) -> CameraPose {
    let forward: Vec3 = vec3_normalize(&vec3_sub(target, eye));
    let right: Vec3 = vec3_normalize(&vec3_cross(&forward, up));
    let true_up: Vec3 = vec3_cross(&right, &forward);

    // OpenGL convention: X right, Y up, Z backwards
    let z_axis: Vec3 = vec3_scale(&forward, -1.0);
    let rot: Mat3 = Mat3 {
        m00: (right).x, m01: (true_up).x, m02: (z_axis).x,
        m10: (right).y, m11: (true_up).y, m12: (z_axis).y,
        m20: (right).z, m21: (true_up).z, m22: (z_axis).z,
    };

    return CameraPose {
        rotation: rot,
        translation: *eye,
    };
}
