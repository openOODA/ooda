// # Spherical Gaussian Ambient Lighting & Environment Radiance
//
// Logline: Spherical Gaussian (SG) parametric illumination model for neural scene relighting and environment mapping.
//
// Setup: Decouples incident environmental illumination from intrinsic material reflectance in neural radiance fields.
//
// Beats:
//   1. Define SphericalGaussianLight with lobe axis direction, lobe sharpness lambda, and RGB amplitude.
//   2. Evaluate Spherical Gaussian radiance L(v) = amplitude * exp(lambda * (dot(axis, v) - 1)).
//   3. Compute SG convolution with clamped cosine lobes for diffuse irradiance approximation.

import "./vec3_math.oo";

pub type SphericalGaussianLight = struct {
    axis: Vec3,
    sharpness: Float,
    amplitude: Vec3,
};

pub fn spherical_gaussian_new(axis: Vec3, sharpness: Float, amplitude: Vec3) -> SphericalGaussianLight {
    return SphericalGaussianLight {
        axis: vec3_normalize(&axis),
        sharpness: sharpness,
        amplitude: amplitude,
    };
}

pub fn evaluate_spherical_gaussian(sg: &SphericalGaussianLight, dir: &Vec3) -> Vec3 {
    let cos_theta: Float = vec3_dot(&(sg).axis, dir);
    let exponent: Float = (sg).sharpness * (cos_theta - 1.0);
    if exponent < -15.0 {
        return vec3_zero();
    }
    let weight: Float = math_exp(exponent);
    return vec3_scale(&(sg).amplitude, weight);
}

pub fn sg_diffuse_irradiance(sg: &SphericalGaussianLight, normal: &Vec3) -> Vec3 {
    let cos_theta: Float = vec3_dot(&(sg).axis, normal);
    let clamped_cos: Float = math_clamp(cos_theta, 0.0, 1.0);
    let pi: Float = 3.141592653589793;
    let factor: Float = (2.0 * pi) / ((sg).sharpness + 2.0);
    return vec3_scale(&(sg).amplitude, factor * clamped_cos);
}
