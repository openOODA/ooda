// # Camera Ray Bundle & Pixel Ray Generator
//
// Logline: Generates calibrated 3D viewing rays through image pixels with NDC mapping and batch bundle structures.
//
// Setup: Bridges 2D camera sensor pixels to continuous 3D world rays for volume rendering in NeRF.
//
// Beats:
//   1. Define CameraRay structure with origin, normalized direction, near/far bounds, and pixel coordinate.
//   2. Generate world-space rays for individual sensor pixels using intrinsic matrix K and pose c2w.
//   3. Compute Normalized Device Coordinates (NDC) ray transformations for forward-facing capture setups.

import "./vec3_math.oo";
import "./camera_pinhole_intrinsics.oo";
import "./camera_pose_se3.oo";

pub type CameraRay = struct {
    origin: Vec3,
    direction: Vec3,
    t_near: Float,
    t_far: Float,
    pixel_x: Float,
    pixel_y: Float,
};

pub fn camera_ray_new(origin: Vec3, direction: Vec3, t_near: Float, t_far: Float, px: Float, py: Float) -> CameraRay {
    return CameraRay {
        origin: origin,
        direction: vec3_normalize(&direction),
        t_near: t_near,
        t_far: t_far,
        pixel_x: px,
        pixel_y: py,
    };
}

pub fn camera_generate_ray(
    cam: &CameraIntrinsics,
    c2w: &CameraPose,
    px: Float,
    py: Float,
    t_near: Float,
    t_far: Float,
) -> CameraRay {
    // Camera coordinates direction (assuming -Z forward)
    let dir_cam_x: Float = (px - (cam).cx) / (cam).fx;
    let dir_cam_y: Float = -(py - (cam).cy) / (cam).fy;
    let dir_cam_z: Float = -1.0;

    let dir_cam: Vec3 = vec3_new(dir_cam_x, dir_cam_y, dir_cam_z);
    let dir_world: Vec3 = mat3_mul_vec(&(c2w).rotation, &dir_cam);
    let dir_norm: Vec3 = vec3_normalize(&dir_world);
    let origin: Vec3 = (c2w).translation;

    return CameraRay {
        origin: origin,
        direction: dir_norm,
        t_near: t_near,
        t_far: t_far,
        pixel_x: px,
        pixel_y: py,
    };
}

pub fn camera_ray_at(ray: &CameraRay, t: Float) -> Vec3 {
    let step: Vec3 = vec3_scale(&(ray).direction, t);
    return vec3_add(&(ray).origin, &step);
}

pub fn camera_ray_to_ndc(ray: &CameraRay, H: Float, W: Float, focal: Float, near: Float) -> CameraRay {
    // Shift ray origin to near plane
    let t_to_near: Float = -(near + (ray).origin.z) / (ray).direction.z;
    let orig_near: Vec3 = camera_ray_at(ray, t_to_near);

    // Compute NDC origin components
    let o0: Float = -((2.0 * focal) / W) * (orig_near).x / (orig_near).z;
    let o1: Float = -((2.0 * focal) / H) * (orig_near).y / (orig_near).z;
    let o2: Float = 1.0 + (2.0 * near) / (orig_near).z;

    // Compute NDC direction components
    let d0: Float = -((2.0 * focal) / W) * ((ray).direction.x / (ray).direction.z - (orig_near).x / (orig_near).z);
    let d1: Float = -((2.0 * focal) / H) * ((ray).direction.y / (ray).direction.z - (orig_near).y / (orig_near).z);
    let d2: Float = -2.0 * near / (orig_near).z;

    let ndc_orig: Vec3 = vec3_new(o0, o1, o2);
    let ndc_dir: Vec3 = vec3_normalize(&vec3_new(d0, d1, d2));

    return CameraRay {
        origin: ndc_orig,
        direction: ndc_dir,
        t_near: 0.0,
        t_far: 1.0,
        pixel_x: (ray).pixel_x,
        pixel_y: (ray).pixel_y,
    };
}
