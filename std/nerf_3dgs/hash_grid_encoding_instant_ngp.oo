// # Multiresolution Hash Grid Encoding (Instant-NGP)
//
// Logline: Spatial hash encoding with multi-scale resolution levels and O(1) trilinear feature lookup.
//
// Setup: Replaces heavy MLP coordinate networks with compact multi-level spatial hash tables for real-time NeRF.
//
// Beats:
//   1. Implement spatial prime hashing function hash(x, y, z) for 3D integer coordinates.
//   2. Compute geometric progression of grid resolutions across L resolution levels.
//   3. Perform trilinear interpolation of corner feature vectors within voxel grid cells.

import "./vec3_math.oo";

pub type HashGridConfig = struct {
    num_levels: Int,
    features_per_level: Int,
    log2_hashmap_size: Int,
    base_resolution: Int,
    per_level_scale: Float
};

pub type HashCellCorners = struct {
    x0: Int, y0: Int, z0: Int,
    x1: Int, y1: Int, z1: Int,
    fx: Float, fy: Float, fz: Float
};

pub fn hash_grid_config_default() -> HashGridConfig {
    return HashGridConfig {
        num_levels: 16,
        features_per_level: 2,
        log2_hashmap_size: 19, // 2^19 = 524288 entries
        base_resolution: 16,
        per_level_scale: 1.3819
    };
}

pub fn hash_spatial_primes(x: Int, y: Int, z: Int, hash_mask: Int) -> Int {
    // Large prime numbers for spatial hashing (Muller et al. Instant-NGP)
    let p1: Int = 73856093;
    let p2: Int = 19349663;
    let p3: Int = 83492791;

    let h: Int = (x * p1) ^ (y * p2) ^ (z * p3);
    let mut positive_h: Int = h;
    if positive_h < 0 {
        positive_h = -positive_h;
    }
    return positive_h % (hash_mask + 1);
}

pub fn hash_grid_cell_corners(pos: &Vec3, resolution: Float) -> HashCellCorners {
    let px: Float = (pos).x * resolution;
    let py: Float = (pos).y * resolution;
    let pz: Float = (pos).z * resolution;

    let x0: Int = px as Int;
    let y0: Int = py as Int;
    let z0: Int = pz as Int;

    let fx: Float = px - (x0 as Float);
    let fy: Float = py - (y0 as Float);
    let fz: Float = pz - (z0 as Float);

    return HashCellCorners {
        x0: x0, y0: y0, z0: z0,
        x1: x0 + 1, y1: y0 + 1, z1: z0 + 1,
        fx: fx, fy: fy, fz: fz
    };
}

pub fn trilinear_interpolate_scalar(
    c000: Float, c100: Float, c010: Float, c110: Float,
    c001: Float, c101: Float, c011: Float, c111: Float,
    fx: Float, fy: Float, fz: Float,
) -> Float {
    let c00: Float = c000 * (1.0 - fx) + c100 * fx;
    let c01: Float = c001 * (1.0 - fx) + c101 * fx;
    let c10: Float = c010 * (1.0 - fx) + c110 * fx;
    let c11: Float = c011 * (1.0 - fx) + c111 * fx;

    let c0: Float = c00 * (1.0 - fy) + c10 * fy;
    let c1: Float = c01 * (1.0 - fy) + c11 * fy;

    return c0 * (1.0 - fz) + c1 * fz;
}

pub fn hash_grid_level_resolution(config: &HashGridConfig, level: Int) -> Float {
    let mut scale: Float = 1.0;
    let mut i: Int = 0;
    while i < level {
        scale = scale * (config).per_level_scale;
        i = i + 1;
    }
    return ((config).base_resolution as Float) * scale;
}
