// # Plenoxels Sparse Voxel Grid Radiance Field
//
// Logline: Neural-free explicit sparse voxel grid with trilinear interpolation of density and spherical harmonics colors.
//
// Setup: Direct optimization of volume density and SH coefficients stored in sparse 3D grid structures.
//
// Beats:
//   1. Define PlenoxelGridConfig, VoxelCell, and SparseVoxelIndex data structures.
//   2. Compute trilinear spatial interpolation of density sigma and SH appearance vectors.
//   3. Implement empty space voxel pruning based on accumulated density thresholds.

import "./vec3_math.oo";
import "./spherical_harmonics_sh_eval.oo";

pub type PlenoxelGridConfig = struct {
    resolution_x: Int,
    resolution_y: Int,
    resolution_z: Int,
    sh_degree: Int,
    density_threshold: Float,
};

pub type VoxelSample = struct {
    density: Float,
    sh_c0: Vec3,
};

pub fn plenoxel_config_new(res: Int) -> PlenoxelGridConfig {
    return PlenoxelGridConfig {
        resolution_x: res,
        resolution_y: res,
        resolution_z: res,
        sh_degree: 2,
        density_threshold: 0.001,
    };
}

pub fn plenoxel_linear_index(config: &PlenoxelGridConfig, x: Int, y: Int, z: Int) -> Int {
    return x + y * (config).resolution_x + z * (config).resolution_x * (config).resolution_y;
}

pub fn plenoxel_sample_trilinear(
    c000: &VoxelSample, c100: &VoxelSample,
    c010: &VoxelSample, c110: &VoxelSample,
    c001: &VoxelSample, c101: &VoxelSample,
    c011: &VoxelSample, c111: &VoxelSample,
    fx: Float, fy: Float, fz: Float,
) -> VoxelSample {
    // Interpolate density
    let d00: Float = (c000).density * (1.0 - fx) + (c100).density * fx;
    let d01: Float = (c001).density * (1.0 - fx) + (c101).density * fx;
    let d10: Float = (c010).density * (1.0 - fx) + (c110).density * fx;
    let d11: Float = (c011).density * (1.0 - fx) + (c111).density * fx;

    let d0: Float = d00 * (1.0 - fy) + d10 * fy;
    let d1: Float = d01 * (1.0 - fy) + d11 * fy;
    let interp_density: Float = d0 * (1.0 - fz) + d1 * fz;

    // Interpolate SH DC color (c0)
    let c0_x: Float = ((c000).sh_c0.x * (1.0 - fx) + (c100).sh_c0.x * fx) * (1.0 - fy) +
                      ((c010).sh_c0.x * (1.0 - fx) + (c110).sh_c0.x * fx) * fy;
    let c1_x: Float = ((c001).sh_c0.x * (1.0 - fx) + (c101).sh_c0.x * fx) * (1.0 - fy) +
                      ((c011).sh_c0.x * (1.0 - fx) + (c111).sh_c0.x * fx) * fy;
    let interp_sh_x: Float = c0_x * (1.0 - fz) + c1_x * fz;

    let c0_y: Float = ((c000).sh_c0.y * (1.0 - fx) + (c100).sh_c0.y * fx) * (1.0 - fy) +
                      ((c010).sh_c0.y * (1.0 - fx) + (c110).sh_c0.y * fx) * fy;
    let c1_y: Float = ((c001).sh_c0.y * (1.0 - fx) + (c101).sh_c0.y * fx) * (1.0 - fy) +
                      ((c011).sh_c0.y * (1.0 - fx) + (c111).sh_c0.y * fx) * fy;
    let interp_sh_y: Float = c0_y * (1.0 - fz) + c1_y * fz;

    let c0_z: Float = ((c000).sh_c0.z * (1.0 - fx) + (c100).sh_c0.z * fx) * (1.0 - fy) +
                      ((c010).sh_c0.z * (1.0 - fx) + (c110).sh_c0.z * fx) * fy;
    let c1_z: Float = ((c001).sh_c0.z * (1.0 - fx) + (c101).sh_c0.z * fx) * (1.0 - fy) +
                      ((c011).sh_c0.z * (1.0 - fx) + (c111).sh_c0.z * fx) * fy;
    let interp_sh_z: Float = c0_z * (1.0 - fz) + c1_z * fz;

    return VoxelSample {
        density: interp_density,
        sh_c0: vec3_new(interp_sh_x, interp_sh_y, interp_sh_z),
    };
}

pub fn plenoxel_is_active(density: Float, threshold: Float) -> Int {
    if density > threshold {
        return 1;
    }
    return 0;
}
