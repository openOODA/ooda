// # Per-Image Appearance Embeddings & Exposure Correction
//
// Logline: Latent appearance code embeddings and affine color transforms for variable exposure in-the-wild captures.
//
// Setup: Decouples static 3D scene geometry from image-specific photometric variations and lighting changes.
//
// Beats:
//   1. Define AppearanceEmbeddingConfig with per-image latent vector dimension.
//   2. Compute affine color transformation C_adj = A * C + b for per-camera exposure correction.
//   3. Blend base 3D Gaussian color with transient appearance compensation.

import "./vec3_math.oo";

pub type AppearanceEmbeddingConfig = struct {
    embedding_dim: Int,
    num_cameras: Int,
    use_affine_transform: Int
};

pub type AffineColorTransform = struct {
    scale_r: Float, scale_g: Float, scale_b: Float,
    bias_r: Float, bias_g: Float, bias_b: Float
};

pub fn affine_color_transform_identity() -> AffineColorTransform {
    return AffineColorTransform {
        scale_r: 1.0, scale_g: 1.0, scale_b: 1.0,
        bias_r: 0.0, bias_g: 0.0, bias_b: 0.0
    };
}

pub fn apply_appearance_transform(color: &Vec3, trans: &AffineColorTransform) -> Vec3 {
    let r: Float = (color).x * (trans).scale_r + (trans).bias_r;
    let g: Float = (color).y * (trans).scale_g + (trans).bias_g;
    let b: Float = (color).z * (trans).scale_b + (trans).bias_b;

    return Vec3 {
        x: math_clamp(r, 0.0, 1.0),
        y: math_clamp(g, 0.0, 1.0),
        z: math_clamp(b, 0.0, 1.0)
    };
}
