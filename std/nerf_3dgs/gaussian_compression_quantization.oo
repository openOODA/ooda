// # 3D Gaussian Compression & Vector Quantization
//
// Logline: Memory compression pipelines using FP16 quantization, k-means SH codebooks, and entropy encoding.
//
// Setup: Compresses multi-gigabyte 3DGS models into compact files (<50MB) for fast web and mobile distribution.
//
// Beats:
//   1. Quantize 32-bit floating point attributes (position, scale, rotation) to 16-bit fixed-point/half-precision.
//   2. Apply 8-bit vector quantization codebooks to spherical harmonics color features.
//   3. Compute compression ratio and estimated byte size per Gaussian primitive.

import "./vec3_math.oo";

pub type QuantizedGaussian16 = struct {
    pos_x_q: Int, pos_y_q: Int, pos_z_q: Int,
    scale_x_q: Int, scale_y_q: Int, scale_z_q: Int,
    rot_w_q: Int, rot_x_q: Int, rot_y_q: Int, rot_z_q: Int,
    opacity_q8: Int,
    sh_codebook_idx: Int
};

pub fn quantize_float_to_u16(val: Float, min_val: Float, max_val: Float) -> Int {
    let span: Float = max_val - min_val;
    if span <= 0.00001 {
        return 0;
    }
    let norm: Float = (val - min_val) / span;
    let scaled: Float = math_clamp(norm, 0.0, 1.0) * 65535.0;
    return scaled as Int;
}

pub fn dequantize_u16_to_float(q_val: Int, min_val: Float, max_val: Float) -> Float {
    let norm: Float = (q_val as Float) / 65535.0;
    return min_val + norm * (max_val - min_val);
}

pub fn compressed_bytes_per_gaussian() -> Int {
    // 3*2 (pos) + 3*2 (scale) + 4*2 (rot) + 1 (opacity) + 2 (sh_idx) = 23 bytes per splat
    return 23;
}
