// # 3D Vector Mathematics for Neural Rendering
//
// Logline: Float Vec3 vector and math operations for neural radiance modeling.
//
// Setup: Pure Float vector arithmetic.
//
// Beats:
//   1. Construct Vec3.
//   2. Vector arithmetic, dot product, scaling, normalization.
//   3. Math helper functions (clamp, exp).

type Vec3 = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

pub fn vec3_zero() -> Vec3 {
    return Vec3 { x: 0.0, y: 0.0, z: 0.0 };
}

pub fn vec3_one() -> Vec3 {
    return Vec3 { x: 1.0, y: 1.0, z: 1.0 };
}

pub fn vec3_add(a: &Vec3, b: &Vec3) -> Vec3 {
    return Vec3 {
        x: (a).x + (b).x,
        y: (a).y + (b).y,
        z: (a).z + (b).z,
    };
}

pub fn vec3_sub(a: &Vec3, b: &Vec3) -> Vec3 {
    return Vec3 {
        x: (a).x - (b).x,
        y: (a).y - (b).y,
        z: (a).z - (b).z,
    };
}

pub fn vec3_scale(v: &Vec3, s: Float) -> Vec3 {
    return Vec3 {
        x: (v).x * s,
        y: (v).y * s,
        z: (v).z * s,
    };
}

pub fn vec3_dot(a: &Vec3, b: &Vec3) -> Float {
    return ((a).x * (b).x) + ((a).y * (b).y) + ((a).z * (b).z);
}

pub fn vec3_length_sq(v: &Vec3) -> Float {
    return (((v).x * (v).x) + ((v).y * (v).y)) + ((v).z * (v).z);
}

pub fn vec3_length(v: &Vec3) -> Float {
    return sqrt(vec3_length_sq(v));
}

pub fn vec3_normalize(v: &Vec3) -> Vec3 {
    let l_sq: Float = vec3_length_sq(v);
    if l_sq < 0.0000000001 {
        return vec3_zero();
    }
    let inv_l: Float = 1.0 / sqrt(l_sq);
    return vec3_scale(v, inv_l);
}

pub fn math_clamp(v: Float, min_val: Float, max_val: Float) -> Float {
    if v < min_val {
        return min_val;
    }
    if v > max_val {
        return max_val;
    }
    return v;
}

pub fn math_exp(v: Float) -> Float {
    return exp(v);
}
