// # 4D Spatiotemporal Gaussian Splatting
//
// Logline: 4D space-time Gaussian representation with dynamic velocity fields, temporal duration, and trajectory splines.
//
// Setup: Extends 3D Gaussian Splatting to dynamic time-varying scenes and high-framerate volumetric video synthesis.
//
// Beats:
//   1. Define DynamicGaussian4D with spatial mean, velocity vector, temporal center t_0, and temporal duration sigma_t.
//   2. Compute time-dependent Gaussian position mu(t) = mu_0 + v * (t - t_0) + 0.5 * a * (t - t_0)^2.
//   3. Compute temporal opacity gating factor alpha(t) = alpha_0 * exp(-0.5 * (t - t_0)^2 / sigma_t^2).

import "./vec3_math.oo";
import "./gaussian_3d_primitive.oo";

pub type DynamicGaussian4D = struct {
    base_gaussian: Gaussian3D,
    velocity: Vec3,
    acceleration: Vec3,
    t_center: Float,
    t_duration: Float
};

pub fn dynamic_gaussian_4d_new(
    base: Gaussian3D,
    vel: Vec3,
    accel: Vec3,
    t_center: Float,
    t_duration: Float,
) -> DynamicGaussian4D {
    return DynamicGaussian4D {
        base_gaussian: base,
        velocity: vel,
        acceleration: accel,
        t_center: t_center,
        t_duration: math_clamp(t_duration, 0.001, 100.0)
    };
}

pub fn evaluate_4d_position_at_time(g: &DynamicGaussian4D, t: Float) -> Vec3 {
    let dt: Float = t - (g).t_center;
    let vel_term: Vec3 = vec3_scale(&(g).velocity, dt);
    let accel_term: Vec3 = vec3_scale(&(g).acceleration, 0.5 * dt * dt);

    let pos: Vec3 = vec3_add(&(g).base_gaussian.position, &vel_term);
    return vec3_add(&pos, &accel_term);
}

pub fn evaluate_4d_opacity_at_time(g: &DynamicGaussian4D, t: Float) -> Float {
    let dt: Float = t - (g).t_center;
    let var_t: Float = (g).t_duration * (g).t_duration;
    let exponent: Float = -0.5 * (dt * dt) / var_t;
    if exponent < -15.0 {
        return 0.0;
    }
    let temp_gate: Float = math_exp(exponent);
    return (g).base_gaussian.opacity * temp_gate;
}

pub fn dynamic_gaussian_4d_spacetime_probe() -> Int {
    return 0;
}
