// # Tensorial Radiance Field (TensoRF) Decomposition
//
// Logline: Low-rank Vector-Matrix (VM) and CP tensor factorization for ultra-compact neural scene representation.
//
// Setup: Factorizes dense 3D/4D radiance tensors into 1D vectors and 2D matrices along orthogonal spatial axes.
//
// Beats:
//   1. Define TensoRFConfig with component ranks R_sigma (density) and R_app (appearance).
//   2. Compute Vector-Matrix (VM) outer product reconstructions T(x, y, z) = sum_r v_r(z) * M_r(x, y).
//   3. Decode decomposed density sigma and appearance feature latent vectors for MLP color decoding.

import "./vec3_math.oo";

pub type TensoRFConfig = struct {
    grid_dim_x: Int,
    grid_dim_y: Int,
    grid_dim_z: Int,
    density_rank: Int,
    appearance_rank: Int
};

pub type VMComponentSample = struct {
    vector_val: Float,
    matrix_u: Float,
    matrix_v: Float
};

pub fn tensorf_config_default() -> TensoRFConfig {
    return TensoRFConfig {
        grid_dim_x: 128,
        grid_dim_y: 128,
        grid_dim_z: 128,
        density_rank: 16,
        appearance_rank: 48
    };
}

pub fn tensorf_vm_dot(v_val: Float, mat_interp: Float) -> Float {
    return v_val * mat_interp;
}

pub fn tensorf_cp_dot(v_x: Float, v_y: Float, v_z: Float) -> Float {
    return v_x * v_y * v_z;
}

pub fn tensorf_decode_density(vm_sum: Float, density_shift: Float) -> Float {
    // Density activation via shifted softplus / relu
    let raw: Float = vm_sum + density_shift;
    if raw <= 0.0 {
        return 0.0;
    }
    return raw;
}
