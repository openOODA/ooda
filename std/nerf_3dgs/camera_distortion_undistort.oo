// # Radial & Tangential Lens Distortion (Brown-Conrady)
//
// Logline: Non-linear lens distortion modeling (k1, k2, k3, p1, p2) and iterative Newton undistortion solver.
//
// Setup: Corrects barrel/pincushion optical aberrations for raw photography datasets prior to ray generation.
//
// Beats:
//   1. Define DistortionCoefficients with radial k1, k2, k3 and tangential p1, p2 parameters.
//   2. Apply forward lens distortion mapping normalized ideal points (x, y) to distorted sensor points (xd, yd).
//   3. Implement iterative Newton-Raphson inverse mapping to un-distort pixel coordinates.

import "./vec3_math.oo";

pub type DistortionCoefficients = struct {
    k1: Float,
    k2: Float,
    k3: Float,
    p1: Float,
    p2: Float
};

pub fn distortion_coefficients_none() -> DistortionCoefficients {
    return DistortionCoefficients {
        k1: 0.0, k2: 0.0, k3: 0.0,
        p1: 0.0, p2: 0.0
    };
}

pub fn apply_lens_distortion(
    x: Float,
    y: Float,
    dist: &DistortionCoefficients,
) -> Vec3 {
    let r2: Float = x * x + y * y;
    let r4: Float = r2 * r2;
    let r6: Float = r4 * r2;

    // Radial factor
    let radial: Float = 1.0 + (dist).k1 * r2 + (dist).k2 * r4 + (dist).k3 * r6;

    // Tangential components
    let dx_tangential: Float = 2.0 * (dist).p1 * x * y + (dist).p2 * (r2 + 2.0 * x * x);
    let dy_tangential: Float = (dist).p1 * (r2 + 2.0 * y * y) + 2.0 * (dist).p2 * x * y;

    let x_distorted: Float = x * radial + dx_tangential;
    let y_distorted: Float = y * radial + dy_tangential;

    return vec3_new(x_distorted, y_distorted, 0.0);
}

pub fn undistort_point_iterative(
    xd: Float,
    yd: Float,
    dist: &DistortionCoefficients,
    max_iters: Int,
) -> Vec3 {
    let mut x: Float = xd;
    let mut y: Float = yd;

    let mut i: Int = 0;
    while i < max_iters {
        let r2: Float = x * x + y * y;
        let radial: Float = 1.0 + (dist).k1 * r2 + (dist).k2 * (r2 * r2);
        let dx_tan: Float = 2.0 * (dist).p1 * x * y + (dist).p2 * (r2 + 2.0 * x * x);
        let dy_tan: Float = (dist).p1 * (r2 + 2.0 * y * y) + 2.0 * (dist).p2 * x * y;

        x = (xd - dx_tan) / radial;
        y = (yd - dy_tan) / radial;
        i = i + 1;
    }

    return vec3_new(x, y, 0.0);
}
