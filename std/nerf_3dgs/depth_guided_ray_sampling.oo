// # Depth-Guided Gaussian Ray Sampling
//
// Logline: Gaussian-distributed importance ray sampling focused around prior depth surfaces.
//
// Setup: Replaces uniform ray marching with localized Gaussian sampling centered on estimated geometry.
//
// Beats:
//   1. Define DepthGuidedSamplingConfig with depth mean, standard deviation, and sample count.
//   2. Sample ray distances t_i from normal distribution N(d_prior, sigma_d^2).
//   3. Blend uniform background sampling with foreground depth-guided Gaussian samples.

import "./vec3_math.oo";

pub type DepthGuidedSamplingConfig = struct {
    num_samples: Int,
    depth_prior: Float,
    depth_std: Float,
    uniform_ratio: Float
};

pub fn depth_guided_sampling_config_default(d_prior: Float) -> DepthGuidedSamplingConfig {
    return DepthGuidedSamplingConfig {
        num_samples: 64,
        depth_prior: d_prior,
        depth_std: 0.1 * d_prior,
        uniform_ratio: 0.2
    };
}

pub fn sample_gaussian_depth(
    d_mean: Float,
    d_std: Float,
    uniform_rand: Float,
) -> Float {
    // Linear approximation of normal distribution CDF inverse
    let offset: Float = (uniform_rand - 0.5) * 2.0 * d_std * 1.732;
    let t: Float = d_mean + offset;
    if t < 0.001 {
        return 0.001;
    }
    return t;
}
