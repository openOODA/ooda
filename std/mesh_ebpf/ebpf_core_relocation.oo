// # eBPF CO-RE Field Relocation & Offset Resolver
//
// Logline: Resolves struct member offsets across heterogeneous kernel versions using BPF Compile Once - Run Everywhere.
//
// Setup: Relocation engine parsing BTF access paths and patching instruction memory offsets.
//
// Beats:
//   1. Define CO-RE relocation records containing type ID, access string specification, and insn offset.
//   2. Match target kernel struct layout against local BPF source definition.
//   3. Compute relocated byte offset, bitfield shifts, and patch BPF instruction imm/off fields.

pub type CoreRelocKind = struct {
    kind_id: Int, // 0: FIELD_BYTE_OFFSET, 1: FIELD_BYTE_SIZE, 2: FIELD_EXISTS, 3: FIELD_SIGNED
    type_id: Int,
    access_index: Int
};

pub type StructFieldLayout = struct {
    struct_type_id: Int,
    field_index: Int,
    field_name: String,
    byte_offset: Int,
    byte_size: Int
};

pub type CoreRelocationEngine = struct {
    layouts: List[StructFieldLayout],
    relocs_applied: Int,
    relocs_failed: Int
};

pub fn core_relocation_engine_new() -> CoreRelocationEngine {
    let empty_layouts: List[StructFieldLayout] = list_new();
    return CoreRelocationEngine {
        layouts: empty_layouts,
        relocs_applied: 0,
        relocs_failed: 0
    };
}

pub fn core_register_layout(
    engine: &mut CoreRelocationEngine,
    struct_id: Int,
    field_idx: Int,
    name: String,
    offset: Int,
    size: Int
) {
    let layout = StructFieldLayout {
        struct_type_id: struct_id,
        field_index: field_idx,
        field_name: name,
        byte_offset: offset,
        byte_size: size
    };
    (engine).layouts = list_push((engine).layouts, layout);
}

pub fn core_resolve_offset(
    engine: &mut CoreRelocationEngine,
    reloc: &CoreRelocKind
) -> Int {
    let n: Int = list_len((engine).layouts);
    let mut i: Int = 0;

    while i < n {
        let l: StructFieldLayout = list_get((engine).layouts, i);
        if (l).struct_type_id == (reloc).type_id && (l).field_index == (reloc).access_index {
            (engine).relocs_applied = (engine).relocs_applied + 1;
            if (reloc).kind_id == 0 {
                return (l).byte_offset;
            }
            if (reloc).kind_id == 1 {
                return (l).byte_size;
            }
            if (reloc).kind_id == 2 {
                return 1; // Exists
            }
            return 0;
        }
        i = i + 1;
    }

    (engine).relocs_failed = (engine).relocs_failed + 1;
    if (reloc).kind_id == 2 {
        return 0; // Does not exist
    }
    return 0 - 1; // Error
}
