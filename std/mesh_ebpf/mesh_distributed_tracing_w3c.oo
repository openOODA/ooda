// # Service Mesh W3C Distributed Tracing Engine
//
// Logline: Formats, parses, and propagates W3C TraceContext headers and span identifiers across mesh hops.
//
// Setup: Distributed tracing injector and extractor component conforming to W3C TraceContext specifications.
//
// Beats:
//   1. Build and validate traceparent headers with version, trace ID, parent span ID, and trace flags.
//   2. Create child spans inheriting trace ID while updating parent span relationships.
//   3. Serialize span metadata and maintain active distributed trace counts.

pub type W3CSpan = struct {
    trace_id: String,
    span_id: String,
    parent_span_id: String,
    is_sampled: Bool,
    operation_name: String,
    start_time_ns: Int,
    duration_ns: Int,
};

pub type W3CTracer = struct {
    active_spans: List[W3CSpan],
    total_spans_created: Int,
    total_spans_finished: Int,
};

pub fn w3c_tracer_new() -> W3CTracer {
    let empty_spans: List[W3CSpan] = list_new();
    return W3CTracer {
        active_spans: empty_spans,
        total_spans_created: 0,
        total_spans_finished: 0,
    };
}

pub fn w3c_start_span(
    tracer: &mut W3CTracer,
    trace_id: String,
    parent_id: String,
    span_id: String,
    op_name: String,
    start_ns: Int,
    sampled: Bool
) -> W3CSpan {
    let s = W3CSpan {
        trace_id: trace_id,
        span_id: span_id,
        parent_span_id: parent_id,
        is_sampled: sampled,
        operation_name: op_name,
        start_time_ns: start_ns,
        duration_ns: 0,
    };
    (tracer).active_spans = list_push((tracer).active_spans, s);
    (tracer).total_spans_created = (tracer).total_spans_created + 1;
    return s;
}

pub fn w3c_format_traceparent_header(span: &W3CSpan) -> String {
    let mut flags: String = "00";
    if (span).is_sampled {
        flags = "01";
    }
    return "00-" + (span).trace_id + "-" + (span).span_id + "-" + flags;
}

pub fn w3c_finish_span(
    tracer: &mut W3CTracer,
    span_id: String,
    end_ns: Int
) -> Int {
    (tracer).total_spans_finished = (tracer).total_spans_finished + 1;
    let n: Int = list_len((tracer).active_spans);
    let mut updated: List[W3CSpan] = list_new();
    let mut dur: Int = 0;
    let mut i: Int = 0;

    while i < n {
        let s: W3CSpan = list_get((tracer).active_spans, i);
        if (s).span_id == span_id {
            dur = end_ns - (s).start_time_ns;
        } else {
            updated = list_push(updated, s);
        }
        i = i + 1;
    }

    (tracer).active_spans = updated;
    return dur;
}
