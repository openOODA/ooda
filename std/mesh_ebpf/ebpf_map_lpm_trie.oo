// # eBPF Longest Prefix Match (LPM) Trie Map
//
// Logline: Implements CIDR prefix routing lookup using bitwise masking and longest prefix match algorithm.
//
// Setup: High-speed IP routing and policy classification table in kernel eBPF data path.
//
// Beats:
//   1. Store network prefix routes with variable prefix lengths (0 to 32 bits for IPv4).
//   2. Match destination IPv4 addresses against stored prefix masks using bitwise AND operations.
//   3. Return route target with highest prefix length specificity (longest prefix match).

pub type LpmRouteEntry = struct {
    prefix_ip: Int,
    prefix_len: Int,
    next_hop_id: Int,
    metric: Int,
};

pub type LpmTrie = struct {
    routes: List[LpmRouteEntry],
    route_count: Int,
    default_next_hop: Int,
};

pub fn lpm_trie_new(default_nh: Int) -> LpmTrie {
    let empty_routes: List[LpmRouteEntry] = list_new();
    return LpmTrie {
        routes: empty_routes,
        route_count: 0,
        default_next_hop: default_nh,
    };
}

pub fn lpm_make_mask(prefix_len: Int) -> Int {
    if prefix_len <= 0 {
        return 0;
    }
    if prefix_len >= 32 {
        return 4294967295;
    }
    let mut mask: Int = 0;
    let mut i: Int = 0;
    while i < prefix_len {
        mask = (mask << 1) | 1;
        i = i + 1;
    }
    mask = mask << (32 - prefix_len);
    return mask;
}

pub fn lpm_add_route(
    trie: &mut LpmTrie,
    prefix: Int,
    prefix_len: Int,
    next_hop: Int,
    metric: Int
) {
    let entry = LpmRouteEntry {
        prefix_ip: prefix,
        prefix_len: prefix_len,
        next_hop_id: next_hop,
        metric: metric,
    };
    (trie).routes = list_push((trie).routes, entry);
    (trie).route_count = (trie).route_count + 1;
}

pub fn lpm_lookup(trie: &LpmTrie, dst_ip: Int) -> Int {
    let n: Int = (trie).route_count;
    let mut i: Int = 0;
    let mut best_prefix_len: Int = 0 - 1;
    let mut best_next_hop: Int = (trie).default_next_hop;

    while i < n {
        let r: LpmRouteEntry = list_get((trie).routes, i);
        let mask: Int = lpm_make_mask((r).prefix_len);
        let masked_dst: Int = dst_ip & mask;
        let masked_pfx: Int = (r).prefix_ip & mask;

        if masked_dst == masked_pfx {
            if (r).prefix_len > best_prefix_len {
                best_prefix_len = (r).prefix_len;
                best_next_hop = (r).next_hop_id;
            }
        }
        i = i + 1;
    }

    return best_next_hop;
}
