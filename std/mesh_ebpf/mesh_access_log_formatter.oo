// # Service Mesh Structured Access Log Formatter
//
// Logline: Formats HTTP request and response metrics into structured JSON and standard text access logs.
//
// Setup: Observability pipeline component formatting access logging records for streaming collectors.
//
// Beats:
//   1. Collect request attributes (method, path, status, upstream cluster, bytes sent/received, duration).
//   2. Extract distributed tracing identifiers (traceparent, request ID) for log-trace correlation.
//   3. Format standardized JSON log entries and count total access log events emitted.

pub type AccessLogRecord = struct {
    method: String,
    path: String,
    response_code: Int,
    duration_ms: Int,
    bytes_sent: Int,
    bytes_received: Int,
    upstream_cluster: String,
    trace_id: String,
};

pub type AccessLoggerState = struct {
    logs_emitted: Int,
    error_logs_emitted: Int,
    total_bytes_logged: Int,
};

pub fn access_logger_new() -> AccessLoggerState {
    return AccessLoggerState {
        logs_emitted: 0,
        error_logs_emitted: 0,
        total_bytes_logged: 0,
    };
}

pub fn access_log_format_json(
    state: &mut AccessLoggerState,
    rec: &AccessLogRecord
) -> String {
    (state).logs_emitted = (state).logs_emitted + 1;
    (state).total_bytes_logged = (state).total_bytes_logged + (rec).bytes_sent + (rec).bytes_received;

    if (rec).response_code >= 400 {
        (state).error_logs_emitted = (state).error_logs_emitted + 1;
    }

    let out: String = "{\"method\":\"" + (rec).method +
                      "\",\"path\":\"" + (rec).path +
                      "\",\"status\":" + ((rec).response_code + "") +
                      ",\"duration_ms\":" + ((rec).duration_ms + "") +
                      ",\"bytes_sent\":" + ((rec).bytes_sent + "") +
                      ",\"upstream_cluster\":\"" + (rec).upstream_cluster +
                      "\",\"trace_id\":\"" + (rec).trace_id + "\"}";
    return out;
}
