// # Kernel Networking Geneve Tunnel Option Parser
//
// Logline: Parses Generic Network Virtualization Encapsulation (Geneve) headers and variable TLV metadata options.
//
// Setup: Advanced overlay tunnel header processor for dynamic SDN metadata propagation over UDP port 6081.
//
// Beats:
//   1. Parse base Geneve 8-byte header (version, option length, protocol type, 24-bit VNI).
//   2. Parse variable-length Type-Length-Value (TLV) tunnel options (class, type, data).
//   3. Validate protocol type identifiers (0x6558: Transparent Ethernet Bridging, 0x0800: IPv4).

pub type GeneveTlvOption = struct {
    option_class: Int,
    option_type: Int,
    length_bytes: Int,
    data_value: Int
};

pub type GeneveHeader = struct {
    version: Int,
    opt_len_bytes: Int,
    protocol_type: Int,
    vni: Int,
    options: List[GeneveTlvOption],
    is_valid: Bool
};

pub fn geneve_header_new(proto: Int, vni: Int) -> GeneveHeader {
    let empty_opts: List[GeneveTlvOption] = list_new();
    return GeneveHeader {
        version: 0,
        opt_len_bytes: 0,
        protocol_type: proto,
        vni: vni,
        options: empty_opts,
        is_valid: true
    };
}

pub fn geneve_add_option(
    hdr: &mut GeneveHeader,
    opt_class: Int,
    opt_type: Int,
    len: Int,
    val: Int
) {
    let opt = GeneveTlvOption {
        option_class: opt_class,
        option_type: opt_type,
        length_bytes: len,
        data_value: val
    };
    (hdr).options = list_push((hdr).options, opt);
    (hdr).opt_len_bytes = (hdr).opt_len_bytes + 4 + len;
}

pub fn geneve_find_option(
    hdr: &GeneveHeader,
    opt_class: Int,
    opt_type: Int
) -> Int {
    let n: Int = list_len((hdr).options);
    let mut i: Int = 0;

    while i < n {
        let opt: GeneveTlvOption = list_get((hdr).options, i);
        if (opt).option_class == opt_class && (opt).option_type == opt_type {
            return (opt).data_value;
        }
        i = i + 1;
    }

    return 0 - 1; // Not found
}
