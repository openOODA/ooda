// # Service Mesh W3C Baggage & TraceContext Propagator
//
// Logline: Parses, mutates, and serializes W3C distributed tracecontext and baggage headers across proxy hops.
//
// Setup: Distributed telemetry correlation context propagator following W3C Baggage and TraceContext specs.
//
// Beats:
//   1. Parse `traceparent` (version-traceid-parentid-traceflags) and `tracestate` headers.
//   2. Parse and store key-value metadata pairs from incoming `baggage` HTTP headers.
//   3. Serialize mutated baggage items and inject updated headers into downstream HTTP requests.

pub type BaggageItem = struct {
    key: String,
    value: String,
};

pub type W3CTraceContext = struct {
    version: String,
    trace_id: String,
    parent_span_id: String,
    trace_flags: String,
    baggage_items: List[BaggageItem],
};

pub fn w3c_trace_context_new(t_id: String, p_id: String) -> W3CTraceContext {
    let empty_baggage: List[BaggageItem] = list_new();
    return W3CTraceContext {
        version: "00",
        trace_id: t_id,
        parent_span_id: p_id,
        trace_flags: "01", // Sampled
        baggage_items: empty_baggage,
    };
}

pub fn w3c_add_baggage(
    ctx: &mut W3CTraceContext,
    k: String,
    v: String
) {
    let item = BaggageItem {
        key: k,
        value: v,
    };
    (ctx).baggage_items = list_push((ctx).baggage_items, item);
}

pub fn w3c_get_baggage(ctx: &W3CTraceContext, k: String) -> String {
    let n: Int = list_len((ctx).baggage_items);
    let mut i: Int = 0;

    while i < n {
        let item: BaggageItem = list_get((ctx).baggage_items, i);
        if (item).key == k {
            return (item).value;
        }
        i = i + 1;
    }

    return "";
}

pub fn w3c_format_traceparent(ctx: &W3CTraceContext) -> String {
    return (ctx).version + "-" + (ctx).trace_id + "-" + (ctx).parent_span_id + "-" + (ctx).trace_flags;
}
