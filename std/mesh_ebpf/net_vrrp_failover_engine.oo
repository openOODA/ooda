// # Kernel Networking VRRPv3 Virtual Router Failover State Machine
//
// Logline: Implements VRRPv3 protocol state machine (INITIALIZE, MASTER, BACKUP) for high availability gateway routing.
//
// Setup: Redundant gateway protocol electing virtual master and coordinating virtual IP takeovers.
//
// Beats:
//   1. Track virtual router ID (VRID), node priority (1-255), and advertisement interval.
//   2. Transition states: INITIALIZE (0), BACKUP (1), MASTER (2) upon heartbeat timeouts.
//   3. Handle preemption and trigger virtual IP (VIP) and virtual MAC ownership shifts.

pub type VrrpState = struct {
    vrid: Int,
    priority: Int,
    advert_interval_ms: Int,
    current_state: Int, // 0: INITIALIZE, 1: BACKUP, 2: MASTER
    master_down_timer_ms: Int,
    is_preempt_enabled: Bool
};

pub fn vrrp_engine_new(vrid: Int, prio: Int, adv_int_ms: Int, preempt: Bool) -> VrrpState {
    return VrrpState {
        vrid: vrid,
        priority: prio,
        advert_interval_ms: adv_int_ms,
        current_state: 1, // BACKUP initially
        master_down_timer_ms: adv_int_ms * 3, // 3 * Advert_Interval
        is_preempt_enabled: preempt
    };
}

pub fn vrrp_on_advertisement(
    vrrp: &mut VrrpState,
    remote_prio: Int,
    now_ms: Int
) -> Bool {
    if (vrrp).current_state == 2 { // MASTER
        if remote_prio > (vrrp).priority {
            (vrrp).current_state = 1; // Transition to BACKUP
            (vrrp).master_down_timer_ms = (vrrp).advert_interval_ms * 3;
            return false;
        }
        return true;
    }

    if (vrrp).current_state == 1 { // BACKUP
        if (vrrp).is_preempt_enabled && (vrrp).priority > remote_prio {
            (vrrp).current_state = 2; // Preempt to MASTER
            return true;
        }
        (vrrp).master_down_timer_ms = (vrrp).advert_interval_ms * 3;
    }

    return false;
}

pub fn vrrp_check_timeout(
    vrrp: &mut VrrpState,
    elapsed_ms: Int
) -> Bool {
    if (vrrp).current_state == 1 { // BACKUP
        (vrrp).master_down_timer_ms = (vrrp).master_down_timer_ms - elapsed_ms;
        if (vrrp).master_down_timer_ms <= 0 {
            (vrrp).current_state = 2; // Master down, promote to MASTER
            return true;
        }
    }
    return false;
}
