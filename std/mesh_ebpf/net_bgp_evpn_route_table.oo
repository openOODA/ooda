// # Kernel Networking BGP EVPN Route Table
//
// Logline: Manages BGP EVPN Type-2 (MAC/IP) and Type-5 (IP Prefix) routing tables with Route Distinguishers.
//
// Setup: Multi-tenant control plane routing table distributing overlay reachability across data centers.
//
// Beats:
//   1. Store EVPN NLRI routes (Type-2 MAC/IP advertisement, Type-5 IP Prefix route).
//   2. Match Route Distinguishers (RD) and Route Targets (RT) for multi-tenant VRF isolation.
//   3. Lookup overlay next-hop VTEP IP for tenant MAC and IP prefix destinations.

pub type EvpnRoute = struct {
    route_type: Int, // 2: MAC/IP, 5: IP Prefix
    route_distinguisher: Int,
    route_target: Int,
    prefix_or_ip: Int,
    prefix_len: Int,
    mac_address_lo: Int,
    next_hop_vtep_ip: Int,
    vni: Int
};

pub type EvpnRouteTable = struct {
    local_vrf_rt: Int,
    routes: List[EvpnRoute],
    total_routes: Int
};

pub fn evpn_route_table_new(vrf_rt: Int) -> EvpnRouteTable {
    let empty_routes: List[EvpnRoute] = list_new();
    return EvpnRouteTable {
        local_vrf_rt: vrf_rt,
        routes: empty_routes,
        total_routes: 0
    };
}

pub fn evpn_add_type2_route(
    tbl: &mut EvpnRouteTable,
    rd: Int,
    rt: Int,
    ip: Int,
    mac_lo: Int,
    vtep: Int,
    vni: Int
) {
    let r = EvpnRoute {
        route_type: 2,
        route_distinguisher: rd,
        route_target: rt,
        prefix_or_ip: ip,
        prefix_len: 32,
        mac_address_lo: mac_lo,
        next_hop_vtep_ip: vtep,
        vni: vni
    };
    (tbl).routes = list_push((tbl).routes, r);
    (tbl).total_routes = (tbl).total_routes + 1;
}

pub fn evpn_lookup_vtep(
    tbl: &EvpnRouteTable,
    dst_ip: Int
) -> Int {
    let n: Int = list_len((tbl).routes);
    let mut i: Int = 0;

    while i < n {
        let r: EvpnRoute = list_get((tbl).routes, i);
        if (r).route_target == (tbl).local_vrf_rt && (r).prefix_or_ip == dst_ip {
            return (r).next_hop_vtep_ip;
        }
        i = i + 1;
    }

    return 0; // Not found
}
