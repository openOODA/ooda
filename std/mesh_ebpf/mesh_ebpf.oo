pub fn mesh_ebpf_verifier(max_insns: Int) -> VerifierState {
    return ebpf_verifier_state_new(max_insns);
}

pub fn mesh_ebpf_xdp_filter(default_act: Int) -> XdpFilterState {
    return xdp_filter_state_new(default_act);
}

pub fn mesh_ebpf_sockmap() -> SockmapRedirectState {
    return sockmap_state_new();
}

pub fn mesh_ebpf_lru_map(capacity: Int) -> EbpfLruHashMap {
    return ebpf_lru_map_new(capacity);
}

pub fn mesh_ebpf_lpm_trie(default_nh: Int) -> LpmTrie {
    return lpm_trie_new(default_nh);
}

pub fn mesh_ebpf_ring_buffer(capacity: Int) -> EbpfRingBuffer {
    return ebpf_ring_buffer_new(capacity);
}

pub fn mesh_ebpf_xds_client(node: String, cluster: String) -> XdsClientState {
    return xds_client_new(node, cluster);
}

pub fn mesh_ebpf_mtls_verifier(trust_domain: String) -> MtlsVerifierState {
    return mtls_verifier_new(trust_domain);
}

pub fn mesh_ebpf_trace_context(trace_id: String, parent_id: String) -> W3CTraceContext {
    return w3c_trace_context_new(trace_id, parent_id);
}

pub fn mesh_ebpf_rate_limiter() -> MeshRateLimiter {
    return mesh_rate_limiter_new();
}

pub fn mesh_ebpf_rbac_engine() -> MeshRbacEngine {
    return mesh_rbac_engine_new();
}
