// # eBPF Kprobe & Kretprobe Kernel Function Latency Tracer
//
// Logline: Traces kernel function entries and exits to calculate nanosecond-precision execution latency.
//
// Setup: Dynamic kernel instrumentation probe measuring system call and driver handler execution times.
//
// Beats:
//   1. Intercept function entry via kprobe, recording start timestamp and input arguments in thread map.
//   2. Intercept function exit via kretprobe, calculating delta elapsed time and capturing return code.
//   3. Aggregate execution latency histograms and alert on slow function executions exceeding SLA threshold.

pub type KprobeEntry = struct {
    pid_tgid: Int,
    function_symbol_id: Int,
    start_time_ns: Int,
    arg0: Int,
    arg1: Int
};

pub type KretprobeResult = struct {
    pid_tgid: Int,
    function_symbol_id: Int,
    duration_ns: Int,
    ret_code: Int,
    is_slow: Bool
};

pub type KprobeTracerState = struct {
    active_entries: List[KprobeEntry],
    slow_threshold_ns: Int,
    total_traces: Int,
    slow_traces: Int
};

pub fn kprobe_tracer_new(slow_threshold_ns: Int) -> KprobeTracerState {
    let empty_entries: List[KprobeEntry] = list_new();
    return KprobeTracerState {
        active_entries: empty_entries,
        slow_threshold_ns: slow_threshold_ns,
        total_traces: 0,
        slow_traces: 0
    };
}

pub fn kprobe_on_enter(
    tracer: &mut KprobeTracerState,
    pid_tgid: Int,
    symbol_id: Int,
    now_ns: Int,
    arg0: Int,
    arg1: Int
) {
    let entry = KprobeEntry {
        pid_tgid: pid_tgid,
        function_symbol_id: symbol_id,
        start_time_ns: now_ns,
        arg0: arg0,
        arg1: arg1
    };
    (tracer).active_entries = list_push((tracer).active_entries, entry);
}

pub fn kretprobe_on_exit(
    tracer: &mut KprobeTracerState,
    pid_tgid: Int,
    symbol_id: Int,
    now_ns: Int,
    ret_code: Int
) -> KretprobeResult {
    (tracer).total_traces = (tracer).total_traces + 1;
    let n: Int = list_len((tracer).active_entries);
    let mut remaining: List[KprobeEntry] = list_new();
    let mut duration: Int = 0;
    let mut found: Bool = false;
    let mut i: Int = 0;

    while i < n {
        let e: KprobeEntry = list_get((tracer).active_entries, i);
        if !found && (e).pid_tgid == pid_tgid && (e).function_symbol_id == symbol_id {
            duration = now_ns - (e).start_time_ns;
            found = true;
        } else {
            remaining = list_push(remaining, e);
        }
        i = i + 1;
    }

    (tracer).active_entries = remaining;

    let is_slow: Bool = duration > (tracer).slow_threshold_ns;
    if is_slow {
        (tracer).slow_traces = (tracer).slow_traces + 1;
    }

    return KretprobeResult {
        pid_tgid: pid_tgid,
        function_symbol_id: symbol_id,
        duration_ns: duration,
        ret_code: ret_code,
        is_slow: is_slow
    };
}
