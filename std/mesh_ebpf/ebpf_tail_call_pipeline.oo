// # eBPF Prog Array Tail Call Dispatcher & Depth Limiter
//
// Logline: Chains modular eBPF program execution via prog_array tail calls with recursion depth bounding.
//
// Setup: Pipeline orchestrator executing multi-stage packet processing pipelines up to 33 hops.
//
// Beats:
//   1. Maintain BPF_MAP_TYPE_PROG_ARRAY index map linking stage numbers to program handlers.
//   2. Enforce Linux kernel maximum tail call limit (strictly <= 33 consecutive jumps).
//   3. Execute pipeline stage transitions without stack growth, returning terminal pipeline exit code.

pub type PipelineStage = struct {
    stage_index: Int,
    stage_name: String,
    prog_fd: Int,
    action_type: Int
};

pub type TailCallPipeline = struct {
    stages: List[PipelineStage],
    max_depth: Int,
    current_depth: Int,
    total_dispatched: Int,
    limit_violations: Int
};

pub fn tail_call_pipeline_new() -> TailCallPipeline {
    let empty_stages: List[PipelineStage] = list_new();
    return TailCallPipeline {
        stages: empty_stages,
        max_depth: 33,
        current_depth: 0,
        total_dispatched: 0,
        limit_violations: 0
    };
}

pub fn tail_call_register_stage(
    pipeline: &mut TailCallPipeline,
    index: Int,
    name: String,
    fd: Int,
    action: Int
) {
    let stage = PipelineStage {
        stage_index: index,
        stage_name: name,
        prog_fd: fd,
        action_type: action
    };
    (pipeline).stages = list_push((pipeline).stages, stage);
}

pub fn tail_call_dispatch(
    pipeline: &mut TailCallPipeline,
    target_index: Int
) -> Int {
    if (pipeline).current_depth >= (pipeline).max_depth {
        (pipeline).limit_violations = (pipeline).limit_violations + 1;
        return 0 - 1;
    }

    let n: Int = list_len((pipeline).stages);
    let mut i: Int = 0;

    while i < n {
        let s: PipelineStage = list_get((pipeline).stages, i);
        if (s).stage_index == target_index {
            (pipeline).current_depth = (pipeline).current_depth + 1;
            (pipeline).total_dispatched = (pipeline).total_dispatched + 1;
            return (s).prog_fd;
        }
        i = i + 1;
    }

    return 0 - 2;
}

pub fn tail_call_reset_depth(pipeline: &mut TailCallPipeline) {
    (pipeline).current_depth = 0;
}
