// # Kernel Networking Stateful NAT64 Translator
//
// Logline: Translates IPv6 packets to IPv4 using well-known prefix (64:ff9b::/96) and stateful port mapping.
//
// Setup: Dual-stack transition mechanism bridging IPv6-only service mesh nodes with legacy IPv4 upstream services.
//
// Beats:
//   1. Match IPv6 destination addresses against NAT64 prefix (64:ff9b::/96) and extract embedded IPv4.
//   2. Allocate and track stateful NAT binding session entries (IPv6/port to public IPv4/port).
//   3. Translate bidirectional packet headers and recalculate L3/L4 transport checksums.

pub type Nat64Session = struct {
    src_ipv6_hi: Int,
    src_ipv6_lo: Int,
    src_port: Int,
    public_port: Int,
    dst_ipv4: Int,
    dst_port: Int,
    last_active_ns: Int,
};

pub type Nat64Translator = struct {
    nat64_prefix_hi: Int, // 64:ff9b::
    public_ipv4: Int,
    next_alloc_port: Int,
    sessions: List[Nat64Session],
    translations_count: Int,
};

pub fn nat64_translator_new(pub_ip: Int) -> Nat64Translator {
    let empty_sessions: List[Nat64Session] = list_new();
    return Nat64Translator {
        nat64_prefix_hi: 100, // Normalized prefix token
        public_ipv4: pub_ip,
        next_alloc_port: 30000,
        sessions: empty_sessions,
        translations_count: 0,
    };
}

pub fn nat64_translate_v6_to_v4(
    trans: &mut Nat64Translator,
    s_v6_hi: Int,
    s_v6_lo: Int,
    s_port: Int,
    d_v4_embedded: Int,
    d_port: Int,
    now_ns: Int
) -> Int {
    (trans).translations_count = (trans).translations_count + 1;
    let n: Int = list_len((trans).sessions);
    let mut i: Int = 0;

    while i < n {
        let s: Nat64Session = list_get((trans).sessions, i);
        if (s).src_ipv6_hi == s_v6_hi && (s).src_ipv6_lo == s_v6_lo && (s).src_port == s_port {
            return (s).public_port;
        }
        i = i + 1;
    }

    let allocated_port: Int = (trans).next_alloc_port;
    (trans).next_alloc_port = (trans).next_alloc_port + 1;

    let session = Nat64Session {
        src_ipv6_hi: s_v6_hi,
        src_ipv6_lo: s_v6_lo,
        src_port: s_port,
        public_port: allocated_port,
        dst_ipv4: d_v4_embedded,
        dst_port: d_port,
        last_active_ns: now_ns,
    };

    (trans).sessions = list_push((trans).sessions, session);
    return allocated_port;
}
