// # Service Mesh Canary Traffic Splitter & Weighted Router
//
// Logline: Routes incoming traffic between baseline and canary clusters via weighted splits and header overrides.
//
// Setup: Traffic management component implementing progressive canary rollouts and A/B test splits.
//
// Beats:
//   1. Configure canary deployment weights (e.g. 90% baseline, 10% canary) and override header rules.
//   2. Evaluate request headers for explicit canary triggers (e.g. x-canary: always).
//   3. Deterministically route requests using hash modulo and maintain split statistics.

pub type CanaryRoute = struct {
    baseline_cluster: String,
    canary_cluster: String,
    canary_weight_percent: Int,
    override_header_key: String,
    override_header_val: String,
};

pub type CanarySplitterState = struct {
    routes: List[CanaryRoute],
    total_routed: Int,
    canary_routed: Int,
    baseline_routed: Int,
};

pub fn canary_splitter_new() -> CanarySplitterState {
    let empty_routes: List[CanaryRoute] = list_new();
    return CanarySplitterState {
        routes: empty_routes,
        total_routed: 0,
        canary_routed: 0,
        baseline_routed: 0,
    };
}

pub fn canary_add_route(
    state: &mut CanarySplitterState,
    baseline: String,
    canary: String,
    canary_weight: Int
) {
    let r = CanaryRoute {
        baseline_cluster: baseline,
        canary_cluster: canary,
        canary_weight_percent: canary_weight,
        override_header_key: "x-canary",
        override_header_val: "always",
    };
    (state).routes = list_push((state).routes, r);
}

pub fn canary_select_cluster(
    state: &mut CanarySplitterState,
    route_idx: Int,
    req_seed: Int,
    header_val: String
) -> String {
    (state).total_routed = (state).total_routed + 1;
    let n: Int = list_len((state).routes);
    if route_idx < 0 || route_idx >= n {
        (state).baseline_routed = (state).baseline_routed + 1;
        return "default";
    }

    let r: CanaryRoute = list_get((state).routes, route_idx);
    if header_val == (r).override_header_val {
        (state).canary_routed = (state).canary_routed + 1;
        return (r).canary_cluster;
    }

    let roll: Int = req_seed % 100;
    if roll < (r).canary_weight_percent {
        (state).canary_routed = (state).canary_routed + 1;
        return (r).canary_cluster;
    }

    (state).baseline_routed = (state).baseline_routed + 1;
    return (r).baseline_cluster;
}
