// # eBPF Internet Packet Checksum Calculator
//
// Logline: Calculates RFC 1071 16-bit Internet 1s complement checksums and incremental packet delta updates.
//
// Setup: High-speed checksum recalculation engine for NAT, encapsulation, and header modification filters.
//
// Beats:
//   1. Implement 1s complement 16-bit word addition with end-around carry folding.
//   2. Compute IPv4 header checksums over 20-byte base packet headers.
//   3. Compute incremental delta checksum updates (csum_diff) during IP/port NAT mutations.

pub type ChecksumContext = struct {
    accumulator: Int,
    folded_sum: Int
};

pub fn checksum_context_new() -> ChecksumContext {
    return ChecksumContext {
        accumulator: 0,
        folded_sum: 0
    };
}

pub fn checksum_add_word(ctx: &mut ChecksumContext, word: Int) {
    (ctx).accumulator = (ctx).accumulator + (word & 65535);
}

pub fn checksum_fold(ctx: &mut ChecksumContext) -> Int {
    let mut sum: Int = (ctx).accumulator;
    while sum > 65535 {
        sum = (sum & 65535) + (sum >> 16);
    }
    let res: Int = sum ^ 65535;
    (ctx).folded_sum = res;
    return res;
}

pub fn checksum_calc_ipv4_header(
    ver_ihl_tos: Int,
    total_len: Int,
    ident: Int,
    flags_frag: Int,
    ttl_proto: Int,
    src_ip_hi: Int,
    src_ip_lo: Int,
    dst_ip_hi: Int,
    dst_ip_lo: Int
) -> Int {
    let mut ctx: ChecksumContext = checksum_context_new();
    checksum_add_word(&mut ctx, ver_ihl_tos);
    checksum_add_word(&mut ctx, total_len);
    checksum_add_word(&mut ctx, ident);
    checksum_add_word(&mut ctx, flags_frag);
    checksum_add_word(&mut ctx, ttl_proto);
    checksum_add_word(&mut ctx, src_ip_hi);
    checksum_add_word(&mut ctx, src_ip_lo);
    checksum_add_word(&mut ctx, dst_ip_hi);
    checksum_add_word(&mut ctx, dst_ip_lo);
    return checksum_fold(&mut ctx);
}

pub fn checksum_diff_update_16(
    old_csum: Int,
    old_val: Int,
    new_val: Int
) -> Int {
    let mut sum: Int = (old_csum ^ 65535) & 65535;
    sum = sum + ((old_val ^ 65535) & 65535) + (new_val & 65535);
    while sum > 65535 {
        sum = (sum & 65535) + (sum >> 16);
    }
    return (sum ^ 65535) & 65535;
}
