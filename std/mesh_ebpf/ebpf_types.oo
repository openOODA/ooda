// # eBPF instruction class and opcode constants
//
// Logline: Names Linux 64-bit eBPF class, ALU, jump, and memory opcode fields for an 8-byte insn encoder.
//
// Setup: Pure constants. No capability tokens. Callers import this file.
//
// Beats:
//   1. Publish class, source, ALU, jump, and memory field values.
//   2. Combine class, op, and source into one opcode byte.
//   3. Combine class, size, and mode into one load or store opcode.

pub fn ebpf_types_cls_ldx() -> Int { return 1; }
pub fn ebpf_types_cls_stx() -> Int { return 3; }
pub fn ebpf_types_cls_jmp() -> Int { return 5; }
pub fn ebpf_types_cls_alu64() -> Int { return 7; }

pub fn ebpf_types_src_k() -> Int { return 0; }
pub fn ebpf_types_src_x() -> Int { return 8; }

pub fn ebpf_types_alu_add() -> Int { return 0; }
pub fn ebpf_types_alu_sub() -> Int { return 16; }
pub fn ebpf_types_alu_and() -> Int { return 80; }
pub fn ebpf_types_alu_xor() -> Int { return 160; }
pub fn ebpf_types_alu_mov() -> Int { return 176; }

pub fn ebpf_types_jmp_jeq() -> Int { return 16; }
pub fn ebpf_types_jmp_jgt() -> Int { return 32; }
pub fn ebpf_types_jmp_jne() -> Int { return 80; }
pub fn ebpf_types_jmp_exit() -> Int { return 144; }

pub fn ebpf_types_size_w() -> Int { return 0; }
pub fn ebpf_types_size_dw() -> Int { return 24; }
pub fn ebpf_types_mode_mem() -> Int { return 96; }

pub fn ebpf_types_opcode(cls: Int, op: Int, src: Int) -> Int {
    let a: Int = cls & 7;
    let b: Int = op & 240;
    let c: Int = src & 8;
    return a + b + c;
}

pub fn ebpf_types_mem_opcode(cls: Int, size: Int, mode: Int) -> Int {
    let a: Int = cls & 7;
    let b: Int = size & 24;
    let c: Int = mode & 224;
    return a + b + c;
}

pub fn ebpf_types_exit() -> Int {
    return ebpf_types_opcode(ebpf_types_cls_jmp(), ebpf_types_jmp_exit(), ebpf_types_src_k());
}
