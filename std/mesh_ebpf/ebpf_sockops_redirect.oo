// # eBPF Sockops Socket Redirection & Sockmap Accelerator
//
// Logline: Intercepts socket lifecycle events to bypass TCP/IP protocol stack via BPF sockmap redirection.
//
// Setup: Kernel-level socket-layer accelerator connecting local proxy sidecars directly to application endpoints.
//
// Beats:
//   1. Intercept TCP established events (passive and active) to register socket cookies in sockmap.
//   2. Extract 4-tuple socket identifiers and lookup symmetric destination peer sockets.
//   3. Execute zero-copy sk_msg redirection directly into target socket receive queues.

pub type SockopsEvent = struct {
    op_type: Int,      // 1: ACTIVE_ESTABLISHED, 2: PASSIVE_ESTABLISHED, 3: STATE_CB
    src_ip: Int,
    dst_ip: Int,
    src_port: Int,
    dst_port: Int,
    socket_cookie: Int,
};

pub type SockmapEntry = struct {
    key_hash: Int,
    src_ip: Int,
    src_port: Int,
    dst_ip: Int,
    dst_port: Int,
    socket_cookie: Int,
    is_active: Bool,
};

pub type SockmapRedirectState = struct {
    entries: List[SockmapEntry],
    established_count: Int,
    redirect_count: Int,
    bypass_bytes: Int,
};

pub fn sockmap_hash_4tuple(s_ip: Int, s_port: Int, d_ip: Int, d_port: Int) -> Int {
    let mut h: Int = (s_ip * 31 + s_port) * 17 + (d_ip * 13 + d_port);
    if h < 0 {
        h = 0 - h;
    }
    return h % 1000000007;
}

pub fn sockmap_state_new() -> SockmapRedirectState {
    let empty_entries: List[SockmapEntry] = list_new();
    return SockmapRedirectState {
        entries: empty_entries,
        established_count: 0,
        redirect_count: 0,
        bypass_bytes: 0,
    };
}

pub fn sockops_on_established(
    state: &mut SockmapRedirectState,
    event: &SockopsEvent
) -> Bool {
    let kh: Int = sockmap_hash_4tuple((event).src_ip, (event).src_port, (event).dst_ip, (event).dst_port);
    let entry = SockmapEntry {
        key_hash: kh,
        src_ip: (event).src_ip,
        src_port: (event).src_port,
        dst_ip: (event).dst_ip,
        dst_port: (event).dst_port,
        socket_cookie: (event).socket_cookie,
        is_active: true,
    };

    (state).entries = list_push((state).entries, entry);
    (state).established_count = (state).established_count + 1;
    return true;
}

pub fn sockops_redirect_msg(
    state: &mut SockmapRedirectState,
    s_ip: Int,
    s_port: Int,
    d_ip: Int,
    d_port: Int,
    msg_len: Int
) -> Int {
    let kh: Int = sockmap_hash_4tuple(d_ip, d_port, s_ip, s_port);
    let n: Int = list_len((state).entries);
    let mut i: Int = 0;

    while i < n {
        let e: SockmapEntry = list_get((state).entries, i);
        if (e).is_active && (e).key_hash == kh {
            (state).redirect_count = (state).redirect_count + 1;
            (state).bypass_bytes = (state).bypass_bytes + msg_len;
            return (e).socket_cookie; // Direct socket redirect target
        }
        i = i + 1;
    }

    return 0; // Fallback to normal TCP/IP stack
}
