// # Kernel Networking VXLAN Overlay Encapsulation & Header Parser
//
// Logline: Encapsulates and decapsulates Virtual Extensible LAN (VXLAN) tunnel packets with 24-bit VNI identifiers.
//
// Setup: Layer-2 overlay network tunnel processor operating over UDP port 4789.
//
// Beats:
//   1. Parse outer UDP/VXLAN 8-byte header flags and 24-bit VXLAN Network Identifier (VNI).
//   2. Encapsulate inner Ethernet frames with outer IP/UDP transport headers and VNI tags.
//   3. Decapsulate validated overlay packets and forward to target virtual bridge interface.

pub type VxlanHeader = struct {
    flags: Int, // 0x08: VNI valid bit
    vni: Int,   // 24-bit VXLAN Network Identifier
    inner_payload_hash: Int,
    is_valid: Bool,
};

pub type VxlanTunnelState = struct {
    local_vtep_ip: Int,
    default_udp_port: Int,
    encap_count: Int,
    decap_count: Int,
};

pub fn vxlan_tunnel_new(local_ip: Int) -> VxlanTunnelState {
    return VxlanTunnelState {
        local_vtep_ip: local_ip,
        default_udp_port: 4789,
        encap_count: 0,
        decap_count: 0,
    };
}

pub fn vxlan_parse_header(b0: Int, b4: Int, b5: Int, b6: Int, payload_hash: Int) -> VxlanHeader {
    let flags: Int = b0;
    let has_vni: Bool = (flags & 8) != 0;
    let vni_val: Int = (b4 << 16) | (b5 << 8) | b6;

    return VxlanHeader {
        flags: flags,
        vni: vni_val,
        inner_payload_hash: payload_hash,
        is_valid: has_vni,
    };
}

pub fn vxlan_encapsulate_frame(
    state: &mut VxlanTunnelState,
    vni: Int,
    inner_hash: Int
) -> VxlanHeader {
    (state).encap_count = (state).encap_count + 1;
    return VxlanHeader {
        flags: 8, // VNI present flag
        vni: vni & 16777215,
        inner_payload_hash: inner_hash,
        is_valid: true,
    };
}
