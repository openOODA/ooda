// # Service Mesh gRPC-Web Protocol Transcoder
//
// Logline: Transcodes browser HTTP/1.1 gRPC-Web requests to backend gRPC HTTP/2 binary frame streams.
//
// Setup: Protocol gateway filter handling CORS preflight, frame decoding, and `grpc-status` header mapping.
//
// Beats:
//   1. Parse gRPC-Web frame header byte flags (compression bit, message length prefix).
//   2. Validate CORS origin headers and emit permissive preflight response headers.
//   3. Map standard HTTP error codes to gRPC canonical status codes (0: OK, 3: INVALID_ARGUMENT, 16: UNAUTHENTICATED).

pub type GrpcWebFrame = struct {
    flags: Int, // bit 0: compressed, bit 7: trailers
    length: Int,
    payload_hash: Int
};

pub type GrpcWebTranscoder = struct {
    cors_allowed_origin: String,
    frames_transcoded: Int,
    cors_preflights_handled: Int
};

pub fn grpc_web_transcoder_new(origin: String) -> GrpcWebTranscoder {
    return GrpcWebTranscoder {
        cors_allowed_origin: origin,
        frames_transcoded: 0,
        cors_preflights_handled: 0
    };
}

pub fn grpc_web_parse_frame_header(b0: Int, b1: Int, b2: Int, b3: Int, b4: Int) -> GrpcWebFrame {
    let flags: Int = b0;
    let len: Int = (b1 << 24) | (b2 << 16) | (b3 << 8) | b4;
    return GrpcWebFrame {
        flags: flags,
        length: len,
        payload_hash: (flags * 31 + len) % 1000000007
    };
}

pub fn grpc_web_http_to_grpc_status(http_status: Int) -> Int {
    if http_status == 200 { return 0; } // OK
    if http_status == 400 { return 3; } // INVALID_ARGUMENT
    if http_status == 401 { return 16; } // UNAUTHENTICATED
    if http_status == 403 { return 7; } // PERMISSION_DENIED
    if http_status == 404 { return 5; } // NOT_FOUND
    if http_status == 429 { return 8; } // RESOURCE_EXHAUSTED
    if http_status == 503 { return 14; } // UNAVAILABLE
    if http_status == 504 { return 4; } // DEADLINE_EXCEEDED
    return 2; // UNKNOWN
}
