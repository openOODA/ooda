// # eBPF 8-byte instruction encoder
//
// Logline: Packs standard 8-byte little-endian eBPF insns and builds ALU64, memory, jump, EXIT, and LSM filter streams.
//
// Setup: Imports ebpf_types.oo. Pure. No capability tokens.
//
// Beats:
//   1. Pack opcode, dst_reg, src_reg, offset, and imm32 into one 64-bit insn.
//   2. Build ALU64 ADD/SUB/MOV/AND/XOR, LDX/STX, JEQ/JNE/JGT, and BPF_EXIT.
//   3. Emit ebpf_build_lsm_cap_filter as a short in-kernel capability filter.

import "./ebpf_types.oo";

pub fn ebpf_encoder_pack(opcode: Int, dst_reg: Int, src_reg: Int, offset: Int, imm32: Int) -> Int {
    let op: Int = opcode & 255;
    let dst: Int = dst_reg & 15;
    let src: Int = src_reg & 15;
    let off: Int = offset & 65535;
    let imm: Int = imm32 & 4294967295;
    let b1: Int = dst + (src << 4);
    let lo: Int = op + (b1 << 8) + (off << 16);
    return lo + (imm << 32);
}

pub fn ebpf_encoder_opcode(insn: Int) -> Int { return insn & 255; }
pub fn ebpf_encoder_dst(insn: Int) -> Int { return (insn >> 8) & 15; }
pub fn ebpf_encoder_src(insn: Int) -> Int { return (insn >> 12) & 15; }
pub fn ebpf_encoder_off(insn: Int) -> Int { return (insn >> 16) & 65535; }
pub fn ebpf_encoder_imm(insn: Int) -> Int { return (insn >> 32) & 4294967295; }

pub fn ebpf_encoder_alu64_add(dst: Int, src: Int) -> Int {
    let code: Int = ebpf_types_opcode(ebpf_types_cls_alu64(), ebpf_types_alu_add(), ebpf_types_src_x());
    return ebpf_encoder_pack(code, dst, src, 0, 0);
}

pub fn ebpf_encoder_alu64_sub(dst: Int, src: Int) -> Int {
    let code: Int = ebpf_types_opcode(ebpf_types_cls_alu64(), ebpf_types_alu_sub(), ebpf_types_src_x());
    return ebpf_encoder_pack(code, dst, src, 0, 0);
}

pub fn ebpf_encoder_alu64_mov(dst: Int, src: Int) -> Int {
    let code: Int = ebpf_types_opcode(ebpf_types_cls_alu64(), ebpf_types_alu_mov(), ebpf_types_src_x());
    return ebpf_encoder_pack(code, dst, src, 0, 0);
}

pub fn ebpf_encoder_alu64_and(dst: Int, src: Int) -> Int {
    let code: Int = ebpf_types_opcode(ebpf_types_cls_alu64(), ebpf_types_alu_and(), ebpf_types_src_x());
    return ebpf_encoder_pack(code, dst, src, 0, 0);
}

pub fn ebpf_encoder_alu64_xor(dst: Int, src: Int) -> Int {
    let code: Int = ebpf_types_opcode(ebpf_types_cls_alu64(), ebpf_types_alu_xor(), ebpf_types_src_x());
    return ebpf_encoder_pack(code, dst, src, 0, 0);
}

pub fn ebpf_encoder_alu64_mov_imm(dst: Int, imm: Int) -> Int {
    let code: Int = ebpf_types_opcode(ebpf_types_cls_alu64(), ebpf_types_alu_mov(), ebpf_types_src_k());
    return ebpf_encoder_pack(code, dst, 0, 0, imm);
}

pub fn ebpf_encoder_alu64_and_imm(dst: Int, imm: Int) -> Int {
    let code: Int = ebpf_types_opcode(ebpf_types_cls_alu64(), ebpf_types_alu_and(), ebpf_types_src_k());
    return ebpf_encoder_pack(code, dst, 0, 0, imm);
}

pub fn ebpf_encoder_ldx_w(dst: Int, src: Int, off: Int) -> Int {
    let code: Int = ebpf_types_mem_opcode(ebpf_types_cls_ldx(), ebpf_types_size_w(), ebpf_types_mode_mem());
    return ebpf_encoder_pack(code, dst, src, off, 0);
}

pub fn ebpf_encoder_ldx_dw(dst: Int, src: Int, off: Int) -> Int {
    let code: Int = ebpf_types_mem_opcode(ebpf_types_cls_ldx(), ebpf_types_size_dw(), ebpf_types_mode_mem());
    return ebpf_encoder_pack(code, dst, src, off, 0);
}

pub fn ebpf_encoder_stx_dw(dst: Int, src: Int, off: Int) -> Int {
    let code: Int = ebpf_types_mem_opcode(ebpf_types_cls_stx(), ebpf_types_size_dw(), ebpf_types_mode_mem());
    return ebpf_encoder_pack(code, dst, src, off, 0);
}

pub fn ebpf_encoder_jeq_imm(dst: Int, imm: Int, off: Int) -> Int {
    let code: Int = ebpf_types_opcode(ebpf_types_cls_jmp(), ebpf_types_jmp_jeq(), ebpf_types_src_k());
    return ebpf_encoder_pack(code, dst, 0, off, imm);
}

pub fn ebpf_encoder_jne_imm(dst: Int, imm: Int, off: Int) -> Int {
    let code: Int = ebpf_types_opcode(ebpf_types_cls_jmp(), ebpf_types_jmp_jne(), ebpf_types_src_k());
    return ebpf_encoder_pack(code, dst, 0, off, imm);
}

pub fn ebpf_encoder_jgt_imm(dst: Int, imm: Int, off: Int) -> Int {
    let code: Int = ebpf_types_opcode(ebpf_types_cls_jmp(), ebpf_types_jmp_jgt(), ebpf_types_src_k());
    return ebpf_encoder_pack(code, dst, 0, off, imm);
}

pub fn ebpf_encoder_exit() -> Int {
    return ebpf_encoder_pack(ebpf_types_exit(), 0, 0, 0, 0);
}

pub fn ebpf_build_lsm_cap_filter(allowed_fd_mask: Int) -> List[Int] {
    let mut p: List[Int] = list_new();
    p = list_push(p, ebpf_encoder_ldx_w(2, 1, 0));
    p = list_push(p, ebpf_encoder_alu64_and_imm(2, allowed_fd_mask));
    p = list_push(p, ebpf_encoder_alu64_mov_imm(0, 0));
    p = list_push(p, ebpf_encoder_jeq_imm(2, 0, 1));
    p = list_push(p, ebpf_encoder_alu64_mov_imm(0, 1));
    p = list_push(p, ebpf_encoder_exit());
    return p;
}
