// # eBPF BTF Type Information Graph
//
// Logline: Models BPF Type Format (BTF) type metadata, struct members, pointers, and size introspection.
//
// Setup: In-memory type graph for kernel debug information and type-safe kernel symbol introspection.
//
// Beats:
//   1. Represent BTF fundamental types (INT, PTR, ARRAY, STRUCT, ENUM, FUNC).
//   2. Record struct member offsets, names, and nested type reference relationships.
//   3. Compute composite struct sizes and validate memory alignment constraints.

pub type BtfKind = struct {
    type_id: Int,
    kind: Int,        // 1: INT, 2: PTR, 3: ARRAY, 4: STRUCT, 5: ENUM, 6: FUNC
    name: String,
    size_bytes: Int,
    target_type_id: Int // For PTR or ARRAY element
};

pub type BtfMember = struct {
    struct_id: Int,
    member_name: String,
    member_type_id: Int,
    bit_offset: Int
};

pub type BtfTypeGraph = struct {
    types: List[BtfKind],
    members: List[BtfMember],
    type_count: Int
};

pub fn btf_type_graph_new() -> BtfTypeGraph {
    let empty_types: List[BtfKind] = list_new();
    let empty_members: List[BtfMember] = list_new();
    return BtfTypeGraph {
        types: empty_types,
        members: empty_members,
        type_count: 0
    };
}

pub fn btf_add_int(graph: &mut BtfTypeGraph, id: Int, name: String, size: Int) {
    let t = BtfKind {
        type_id: id,
        kind: 1,
        name: name,
        size_bytes: size,
        target_type_id: 0
    };
    (graph).types = list_push((graph).types, t);
    (graph).type_count = (graph).type_count + 1;
}

pub fn btf_add_ptr(graph: &mut BtfTypeGraph, id: Int, target_id: Int) {
    let t = BtfKind {
        type_id: id,
        kind: 2,
        name: "*",
        size_bytes: 8,
        target_type_id: target_id
    };
    (graph).types = list_push((graph).types, t);
    (graph).type_count = (graph).type_count + 1;
}

pub fn btf_add_struct(graph: &mut BtfTypeGraph, id: Int, name: String, total_size: Int) {
    let t = BtfKind {
        type_id: id,
        kind: 4,
        name: name,
        size_bytes: total_size,
        target_type_id: 0
    };
    (graph).types = list_push((graph).types, t);
    (graph).type_count = (graph).type_count + 1;
}

pub fn btf_add_member(
    graph: &mut BtfTypeGraph,
    struct_id: Int,
    member_name: String,
    member_type: Int,
    bit_offset: Int
) {
    let m = BtfMember {
        struct_id: struct_id,
        member_name: member_name,
        member_type_id: member_type,
        bit_offset: bit_offset
    };
    (graph).members = list_push((graph).members, m);
}

pub fn btf_get_type_size(graph: &BtfTypeGraph, type_id: Int) -> Int {
    let n: Int = list_len((graph).types);
    let mut i: Int = 0;

    while i < n {
        let t: BtfKind = list_get((graph).types, i);
        if (t).type_id == type_id {
            return (t).size_bytes;
        }
        i = i + 1;
    }

    return 0;
}
