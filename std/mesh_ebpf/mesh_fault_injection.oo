// # Service Mesh Chaos Engineering Fault Injector
//
// Logline: Injects simulated network delays and HTTP abort error responses with percentage-based rollout sampling.
//
// Setup: Testing and chaos engineering proxy filter validating client resiliency against degradation.
//
// Beats:
//   1. Configure delay injection (fixed delay in ms) and abort injection (HTTP status code).
//   2. Sample incoming requests using percentage ratios (e.g. 5% delay, 1% HTTP 503 abort).
//   3. Return fault decision results with delay duration and synthetic HTTP response status.

pub type FaultConfig = struct {
    delay_percent: Int,
    delay_duration_ms: Int,
    abort_percent: Int,
    abort_http_status: Int,
    is_active: Bool,
};

pub type FaultResult = struct {
    injected_delay_ms: Int,
    injected_http_status: Int,
    is_aborted: Bool,
};

pub type FaultInjectorState = struct {
    config: FaultConfig,
    total_evaluated: Int,
    delays_injected: Int,
    aborts_injected: Int,
};

pub fn fault_injector_new(cfg: FaultConfig) -> FaultInjectorState {
    return FaultInjectorState {
        config: cfg,
        total_evaluated: 0,
        delays_injected: 0,
        aborts_injected: 0,
    };
}

pub fn fault_evaluate(
    state: &mut FaultInjectorState,
    sample_seed: Int
) -> FaultResult {
    (state).total_evaluated = (state).total_evaluated + 1;

    if !(state).config.is_active {
        return FaultResult {
            injected_delay_ms: 0,
            injected_http_status: 200,
            is_aborted: false,
        };
    }

    let sample_val: Int = sample_seed % 100;
    let mut delay_ms: Int = 0;
    let mut abort_status: Int = 200;
    let mut aborted: Bool = false;

    // Check abort fault
    if sample_val < (state).config.abort_percent {
        (state).aborts_injected = (state).aborts_injected + 1;
        abort_status = (state).config.abort_http_status;
        aborted = true;
        return FaultResult {
            injected_delay_ms: 0,
            injected_http_status: abort_status,
            is_aborted: true,
        };
    }

    // Check delay fault
    if sample_val < (state).config.delay_percent {
        (state).delays_injected = (state).delays_injected + 1;
        delay_ms = (state).config.delay_duration_ms;
    }

    return FaultResult {
        injected_delay_ms: delay_ms,
        injected_http_status: 200,
        is_aborted: false,
    };
}
