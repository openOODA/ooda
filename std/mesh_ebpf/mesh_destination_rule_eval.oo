// # Service Mesh DestinationRule Traffic Policy Evaluator
//
// Logline: Evaluates Istio DestinationRule subset definitions, connection pool limits, and TLS client settings.
//
// Setup: Upstream configuration resolver applying connection timeouts, max connections, and TLS policies.
//
// Beats:
//   1. Define DestinationRule subsets matching version labels (e.g. `version: v1`, `version: v2`).
//   2. Configure connection pool settings (max TCP connections, pending HTTP requests, max requests per conn).
//   3. Apply TLS client transport modes: DISABLE, SIMPLE, MUTUAL, ISTIO_MUTUAL.

pub type SubsetDef = struct {
    name: String,
    version_label: String,
};

pub type ConnectionPoolSettings = struct {
    max_tcp_connections: Int,
    max_pending_requests: Int,
    max_requests_per_connection: Int,
    connect_timeout_ms: Int,
};

pub type DestinationRule = struct {
    host: String,
    subsets: List[SubsetDef],
    conn_pool: ConnectionPoolSettings,
    tls_mode: Int, // 0: DISABLE, 1: SIMPLE, 2: MUTUAL, 3: ISTIO_MUTUAL
};

pub fn default_conn_pool() -> ConnectionPoolSettings {
    return ConnectionPoolSettings {
        max_tcp_connections: 1024,
        max_pending_requests: 512,
        max_requests_per_connection: 100,
        connect_timeout_ms: 250,
    };
}

pub fn destination_rule_new(host: String, tls_mode: Int) -> DestinationRule {
    let empty_subsets: List[SubsetDef] = list_new();
    return DestinationRule {
        host: host,
        subsets: empty_subsets,
        conn_pool: default_conn_pool(),
        tls_mode: tls_mode,
    };
}

pub fn destination_rule_add_subset(
    rule: &mut DestinationRule,
    name: String,
    version: String
) {
    let s = SubsetDef {
        name: name,
        version_label: version,
    };
    (rule).subsets = list_push((rule).subsets, s);
}

pub fn destination_rule_has_subset(
    rule: &DestinationRule,
    name: String
) -> Bool {
    let n: Int = list_len((rule).subsets);
    let mut i: Int = 0;

    while i < n {
        let s: SubsetDef = list_get((rule).subsets, i);
        if (s).name == name {
            return true;
        }
        i = i + 1;
    }

    return false;
}
