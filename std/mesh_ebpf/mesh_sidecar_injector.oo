// # Service Mesh Sidecar Proxy Injector & Mutating Webhook
//
// Logline: Generates Envoy sidecar container specs and iptables redirection init-containers for Kubernetes pods.
//
// Setup: Kubernetes mutating admission webhook injecting data plane proxy sidecars into application pods.
//
// Beats:
//   1. Inspect pod template annotations (`sidecar.istio.io/inject`, `traffic.sidecar.istio.io/includeInboundPorts`).
//   2. Generate Envoy proxy sidecar container specification with memory/CPU limits and drain durations.
//   3. Configure `istio-init` container arguments for transparent iptables PREROUTING port redirection.

pub type SidecarConfig = struct {
    proxy_image: String,
    proxy_port: Int,
    admin_port: Int,
    inbound_include_ports: String,
    outbound_include_ips: String,
    is_injected: Bool
};

pub type SidecarInjectorState = struct {
    default_image: String,
    default_proxy_port: Int,
    total_injections: Int,
    skipped_injections: Int
};

pub fn sidecar_injector_new(default_img: String, proxy_port: Int) -> SidecarInjectorState {
    return SidecarInjectorState {
        default_image: default_img,
        default_proxy_port: proxy_port,
        total_injections: 0,
        skipped_injections: 0
    };
}

pub fn sidecar_evaluate_pod_annotation(
    injector: &mut SidecarInjectorState,
    inject_annotation: String,
    inbound_ports: String
) -> SidecarConfig {
    if inject_annotation == "false" || inject_annotation == "disabled" {
        (injector).skipped_injections = (injector).skipped_injections + 1;
        return SidecarConfig {
            proxy_image: "",
            proxy_port: 0,
            admin_port: 0,
            inbound_include_ports: "",
            outbound_include_ips: "",
            is_injected: false
        };
    }

    (injector).total_injections = (injector).total_injections + 1;
    return SidecarConfig {
        proxy_image: (injector).default_image,
        proxy_port: (injector).default_proxy_port,
        admin_port: 15000,
        inbound_include_ports: inbound_ports,
        outbound_include_ips: "*",
        is_injected: true
    };
}
