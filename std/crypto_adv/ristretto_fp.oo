// # Curve25519 8-limb field arithmetic
//
// Logline: Adds, subtracts, and multiplies 256-bit elements modulo 2^255-19.
//
// Setup: Pure. Eight little-endian 32-bit limbs. p0 is 4294967277. Called from ristretto255.oo.
//
// Beats:
//   1. Add and subtract with a single p reduction.
//   2. Multiply through the 16-bit fold helper.
//   3. Lift a small integer into the field.
//   4. Compare and test zero.

import "std/crypto_adv/ristretto_fp_red.oo";

pub fn ristretto_fp_p(i: Int) -> Int {
    if i == 0 {
        return 4294967277;
    }
    if i == 7 {
        return 2147483647;
    }
    if i < 1 {
        return 0;
    }
    if i > 7 {
        return 0;
    }
    return 4294967295;
}

fn rf_plist() -> List[Int] {
    let mut p: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 8 {
        p = list_push(p, ristretto_fp_p(i));
        i = i + 1;
    }
    return p;
}

fn rf_ge(a: List[Int], b: List[Int]) -> Int {
    let mut i: Int = 7;
    while i >= 0 {
        if list_get(a, i) > list_get(b, i) {
            return 1;
        }
        if list_get(a, i) < list_get(b, i) {
            return 0;
        }
        i = i - 1;
    }
    return 1;
}

fn rf_sub8(a: List[Int], b: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut br: Int = 0;
    let mut i: Int = 0;
    while i < 8 {
        let mut t: Int = list_get(a, i) - list_get(b, i) - br;
        if t < 0 {
            t = t + 4294967296;
            br = 1;
        } else {
            br = 0;
        }
        out = list_push(out, t & 4294967295);
        i = i + 1;
    }
    return out;
}

fn rf_add8(a: List[Int], b: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < 8 {
        let t: Int = list_get(a, i) + list_get(b, i) + c;
        out = list_push(out, t & 4294967295);
        c = t >> 32;
        i = i + 1;
    }
    return out;
}

pub fn ristretto_fp_add(a: List[Int], b: List[Int]) -> List[Int] {
    let s: List[Int] = rf_add8(a, b);
    let p: List[Int] = rf_plist();
    if rf_ge(s, p) > 0 {
        return rf_sub8(s, p);
    }
    return s;
}

pub fn ristretto_fp_sub(a: List[Int], b: List[Int]) -> List[Int] {
    if rf_ge(a, b) > 0 {
        return rf_sub8(a, b);
    }
    let p: List[Int] = rf_plist();
    return rf_sub8(rf_add8(a, p), b);
}

pub fn ristretto_fp_mul(a: List[Int], b: List[Int]) -> List[Int] {
    return ristretto_fp_red_mul(a, b);
}

pub fn ristretto_fp_inv(a: List[Int]) -> List[Int] {
    return ristretto_fp_red_inv(a);
}

pub fn ristretto_fp_eq(a: List[Int], b: List[Int]) -> Int {
    let mut i: Int = 0;
    while i < 8 {
        if list_get(a, i) != list_get(b, i) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

pub fn ristretto_fp_is0(a: List[Int]) -> Int {
    let mut i: Int = 0;
    while i < 8 {
        if list_get(a, i) != 0 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

pub fn ristretto_fp_one() -> List[Int] {
    return ristretto_fp_red_one();
}

pub fn ristretto_fp_from_i(n: Int) -> List[Int] {
    if n < 0 {
        return ristretto_fp_sub(ristretto_fp_from_i(0), ristretto_fp_from_i(0 - n));
    }
    let mut o: List[Int] = list_new();
    o = list_push(o, n & 4294967295);
    let mut r: Int = n / 4294967296;
    let mut i: Int = 1;
    while i < 8 {
        o = list_push(o, r & 4294967295);
        r = r / 4294967296;
        i = i + 1;
    }
    return o;
}
