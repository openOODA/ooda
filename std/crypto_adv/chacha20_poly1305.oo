// # RFC 8439 ChaCha20 quarter-round and Poly1305
//
// Logline: Runs the ChaCha20 quarter-round on four 32-bit words and authenticates a block with Poly1305 modulo 2^130-5.
//
// Setup: Pure. Words wrap at 2^32. Poly1305 uses 26-bit limbs. Truncated key material is Err.
//
// Beats:
//   1. Add, XOR, and rotate the quarter-round.
//   2. Clamp r and accumulate one Poly1305 block.
//   3. Match the RFC 8439 quarter-round test vector.
//   4. Reject a short r or s buffer.

import "std/crypto_adv/chacha20_poly1305_mac.oo";

pub type QrOut = struct {
    flag: Int,
    err: String,
    a: Int,
    b: Int,
    c: Int,
    d: Int
};

fn qr_err(m: String) -> QrOut {
    return QrOut { flag: 0, err: "ERR\tchacha: " + m, a: 0, b: 0, c: 0, d: 0 };
}

fn cc_mask(x: Int) -> Int {
    return x & 4294967295;
}

fn cc_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn cc_rotl(x: Int, r: Int) -> Int {
    let v: Int = cc_mask(x);
    let left: Int = (v << r) & 4294967295;
    let right: Int = v >> (32 - r);
    return cc_mask(left | right);
}

pub fn chacha20_poly1305_qr(a: Int, b: Int, c: Int, d: Int) -> QrOut {
    let mut aa: Int = cc_mask(a);
    let mut bb: Int = cc_mask(b);
    let mut ccw: Int = cc_mask(c);
    let mut dd: Int = cc_mask(d);
    aa = cc_mask(aa + bb);
    dd = cc_rotl(cc_xor(dd, aa), 16);
    ccw = cc_mask(ccw + dd);
    bb = cc_rotl(cc_xor(bb, ccw), 12);
    aa = cc_mask(aa + bb);
    dd = cc_rotl(cc_xor(dd, aa), 8);
    ccw = cc_mask(ccw + dd);
    bb = cc_rotl(cc_xor(bb, ccw), 7);
    return QrOut { flag: 1, err: "", a: aa, b: bb, c: ccw, d: dd };
}

pub fn chacha20_poly1305_rfc8439() -> QrOut {
    return chacha20_poly1305_qr(286331153, 16909060, 2609737539, 19088743);
}

pub fn chacha20_poly1305_mac(r: List[Int], s: List[Int], msg: List[Int]) -> PolyOut {
    return chacha20_poly1305_mac_block(r, s, msg);
}

pub fn chacha20_poly1305_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn chacha20_poly1305_flag(o: QrOut) -> Int {
    return o.flag;
}
pub fn chacha20_poly1305_err(o: QrOut) -> String {
    return o.err;
}
pub fn chacha20_poly1305_a(o: QrOut) -> Int {
    return o.a;
}
pub fn chacha20_poly1305_b(o: QrOut) -> Int {
    return o.b;
}
pub fn chacha20_poly1305_c(o: QrOut) -> Int {
    return o.c;
}
pub fn chacha20_poly1305_d(o: QrOut) -> Int {
    return o.d;
}
