// # Keccak-f[1600] round constants
//
// Logline: Returns the 64-bit iota constant for a round as 32-bit lo and hi halves.
//
// Setup: Pure. Round index is 0..23. Called from keccak_f1600.oo.
//
// Beats:
//   1. Map the round to the FIPS 202 RC word.
//   2. Split into low and high 32-bit halves.

pub fn keccak_rc_lo(r: Int) -> Int {
    if r == 0 { return 1; }
    if r == 1 { return 32898; }
    if r == 2 { return 32906; }
    if r == 3 { return 2147516416; }
    if r == 4 { return 32907; }
    if r == 5 { return 2147483649; }
    if r == 6 { return 2147516545; }
    if r == 7 { return 32777; }
    if r == 8 { return 138; }
    if r == 9 { return 136; }
    if r == 10 { return 2147516425; }
    if r == 11 { return 2147483658; }
    if r == 12 { return 2147516555; }
    if r == 13 { return 139; }
    if r == 14 { return 32905; }
    if r == 15 { return 32771; }
    if r == 16 { return 32770; }
    if r == 17 { return 128; }
    if r == 18 { return 32778; }
    if r == 19 { return 2147483658; }
    if r == 20 { return 2147516545; }
    if r == 21 { return 32896; }
    if r == 22 { return 2147483649; }
    return 2147516424;
}

pub fn keccak_rc_hi(r: Int) -> Int {
    if r == 2 { return 2147483648; }
    if r == 3 { return 2147483648; }
    if r == 6 { return 2147483648; }
    if r == 7 { return 2147483648; }
    if r == 13 { return 2147483648; }
    if r == 14 { return 2147483648; }
    if r == 15 { return 2147483648; }
    if r == 16 { return 2147483648; }
    if r == 17 { return 2147483648; }
    if r == 19 { return 2147483648; }
    if r == 20 { return 2147483648; }
    if r == 21 { return 2147483648; }
    if r == 23 { return 2147483648; }
    return 0;
}
