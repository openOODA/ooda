// # Ristretto255 prime-order group floor
//
// Logline: Adds twisted-Edwards points over Curve25519 and rejects identity and 2-torsion.
//
// Setup: Pure. Field is 2^255-19 with eight 32-bit limbs. Curve is -x^2 + y^2 = 1 + d x^2 y^2, d = -121665/121666.
//
// Beats:
//   1. Lift coordinates into the 25519 field.
//   2. Add completed Edwards points with a = -1.
//   3. Double and test 2P.
//   4. Reject identity (0,1) and 2-torsion (0,-1) as small-subgroup abuse.

import "std/crypto_adv/ristretto_fp.oo";

pub type RtOut = struct {
    flag: Int,
    err: String,
    x: Int,
    y: Int
};

fn rt_err(m: String) -> RtOut {
    return RtOut { flag: 0, err: "ERR\tristretto: " + m, x: 0, y: 0 };
}

fn rt_d() -> List[Int] {
    let mut o: List[Int] = list_new();
    o = list_push(o, 324630691);
    o = list_push(o, 1978355146);
    o = list_push(o, 1094834347);
    o = list_push(o, 7342669);
    o = list_push(o, 2004478104);
    o = list_push(o, 2361868409);
    o = list_push(o, 728759923);
    o = list_push(o, 1375956206);
    return o;
}

fn rt_box(x: List[Int], y: List[Int]) -> RtOut {
    return RtOut { flag: 1, err: "", x: list_get(x, 0), y: list_get(y, 0) };
}

pub fn ristretto255_p_limb(i: Int) -> Int {
    return ristretto_fp_p(i);
}

pub fn ristretto255_add(x1: Int, y1: Int, x2: Int, y2: Int) -> RtOut {
    let X1: List[Int] = ristretto_fp_from_i(x1);
    let Y1: List[Int] = ristretto_fp_from_i(y1);
    let X2: List[Int] = ristretto_fp_from_i(x2);
    let Y2: List[Int] = ristretto_fp_from_i(y2);
    let xx: List[Int] = ristretto_fp_mul(X1, X2);
    let yy: List[Int] = ristretto_fp_mul(Y1, Y2);
    let dxy: List[Int] = ristretto_fp_mul(rt_d(), ristretto_fp_mul(xx, yy));
    let one: List[Int] = ristretto_fp_one();
    let denx: List[Int] = ristretto_fp_add(one, dxy);
    let deny: List[Int] = ristretto_fp_sub(one, dxy);
    if ristretto_fp_is0(denx) > 0 {
        return rt_err("add");
    }
    if ristretto_fp_is0(deny) > 0 {
        return rt_err("add");
    }
    let xnum: List[Int] = ristretto_fp_add(ristretto_fp_mul(X1, Y2), ristretto_fp_mul(Y1, X2));
    let ynum: List[Int] = ristretto_fp_add(yy, xx);
    let xr: List[Int] = ristretto_fp_mul(xnum, ristretto_fp_inv(denx));
    let yr: List[Int] = ristretto_fp_mul(ynum, ristretto_fp_inv(deny));
    return rt_box(xr, yr);
}

pub fn ristretto255_dbl(x: Int, y: Int) -> RtOut {
    return ristretto255_add(x, y, x, y);
}

pub fn ristretto255_check(x: Int, y: Int) -> Result[Int, String] {
    let X: List[Int] = ristretto_fp_from_i(x);
    let Y: List[Int] = ristretto_fp_from_i(y);
    let one: List[Int] = ristretto_fp_one();
    let z: List[Int] = ristretto_fp_from_i(0);
    if ristretto_fp_is0(X) > 0 {
        if ristretto_fp_eq(Y, one) > 0 {
            return Err("ERR\tristretto: identity");
        }
        if ristretto_fp_eq(Y, ristretto_fp_sub(z, one)) > 0 {
            return Err("ERR\tristretto: torsion");
        }
    }
    let xx: List[Int] = ristretto_fp_mul(X, X);
    let yy: List[Int] = ristretto_fp_mul(Y, Y);
    let lhs: List[Int] = ristretto_fp_sub(yy, xx);
    let rhs: List[Int] = ristretto_fp_add(one, ristretto_fp_mul(rt_d(), ristretto_fp_mul(xx, yy)));
    if ristretto_fp_eq(lhs, rhs) < 1 {
        return Err("ERR\tristretto: curve");
    }
    let d: RtOut = ristretto255_dbl(x, y);
    if d.flag < 1 {
        return Err(d.err);
    }
    if d.x == 0 {
        if d.y == 1 {
            return Err("ERR\tristretto: small-subgroup");
        }
    }
    return Ok(1);
}

pub fn ristretto255_gen() -> RtOut {
    return ristretto255_add(2, 2, 0, 1);
}

pub fn ristretto255_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}
