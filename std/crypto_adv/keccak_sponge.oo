// # SHAKE sponge over Keccak-f[1600]
//
// Logline: Absorbs bytes with SHAKE domain padding 0x1F, permutes with Keccak-f[1600], and squeezes output words.
//
// Setup: Pure. Rate is 168 bytes for SHAKE128. Empty output length is Err. State is 50 32-bit halves.
//
// Beats:
//   1. XOR message bytes into the rate.
//   2. Pad with 0x1F and the final 0x80 bit.
//   3. Permute 24 rounds.
//   4. Squeeze the first lanes as live output words.

import "std/crypto_adv/keccak_f1600.oo";

pub type KecOut = struct {
    flag: Int,
    err: String,
    n: Int,
    w0: Int,
    w1: Int,
    w2: Int
};

fn ks_err(m: String) -> KecOut {
    return KecOut { flag: 0, err: "ERR\tkeccak: " + m, n: 0, w0: 0, w1: 0, w2: 0 };
}

fn ks_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn ks_zero() -> List[Int] {
    let mut s: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 50 {
        s = list_push(s, 0);
        i = i + 1;
    }
    return s;
}

fn ks_xorb(st: List[Int], pos: Int, b: Int) -> List[Int] {
    let lane: Int = pos / 8;
    let off: Int = pos % 8;
    let mut idx: Int = 2 * lane;
    let mut sh: Int = 8 * off;
    if off >= 4 {
        idx = 2 * lane + 1;
        sh = 8 * (off - 4);
    }
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 50 {
        if i == idx {
            o = list_push(o, ks_xor(list_get(st, i), (b & 255) * (1 << sh)) & 4294967295);
        } else {
            o = list_push(o, list_get(st, i));
        }
        i = i + 1;
    }
    return o;
}

pub fn keccak_sponge_perm(st: List[Int]) -> KecOut {
    let p: KfOut = keccak_f1600_perm(st);
    if keccak_f1600_flag(p) < 1 {
        return ks_err("perm");
    }
    return KecOut { flag: 1, err: "", n: 50, w0: keccak_f1600_w0(p), w1: keccak_f1600_w1(p), w2: keccak_f1600_lane(p, 2) };
}

pub fn keccak_sponge_shake(msg: List[Int], outn: Int) -> KecOut {
    if outn < 1 {
        return ks_err("out");
    }
    let rate: Int = 168;
    let mut s: List[Int] = ks_zero();
    let mut i: Int = 0;
    while i < list_len(msg) {
        let pos: Int = i % rate;
        s = ks_xorb(s, pos, list_get(msg, i));
        if pos == rate - 1 {
            let p: KfOut = keccak_f1600_perm(s);
            if keccak_f1600_flag(p) < 1 {
                return ks_err("perm");
            }
            let mut ns: List[Int] = list_new();
            let mut j: Int = 0;
            while j < 50 {
                ns = list_push(ns, keccak_f1600_lane(p, j));
                j = j + 1;
            }
            s = ns;
        }
        i = i + 1;
    }
    let used: Int = list_len(msg) % rate;
    s = ks_xorb(s, used, 31);
    s = ks_xorb(s, rate - 1, 128);
    let q: KfOut = keccak_f1600_perm(s);
    if keccak_f1600_flag(q) < 1 {
        return ks_err("perm");
    }
    return KecOut { flag: 1, err: "", n: outn, w0: keccak_f1600_w0(q), w1: keccak_f1600_w1(q), w2: keccak_f1600_lane(q, 2) };
}

pub fn keccak_sponge_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn keccak_sponge_flag(o: KecOut) -> Int {
    return o.flag;
}
pub fn keccak_sponge_err(o: KecOut) -> String {
    return o.err;
}
pub fn keccak_sponge_w0(o: KecOut) -> Int {
    return o.w0;
}
pub fn keccak_sponge_w1(o: KecOut) -> Int {
    return o.w1;
}
