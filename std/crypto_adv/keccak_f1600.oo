// # Keccak-f[1600] 24-round permutation
//
// Logline: Permutes 25 64-bit lanes stored as 32-bit lo/hi pairs through theta, rho, pi, chi, and iota.
//
// Setup: Pure. State is 50 Ints, two per lane. Rotations wrap at 64 bits using 32-bit halves. Length other than 50 is Err.
//
// Beats:
//   1. Mix columns with theta.
//   2. Rotate and permute with rho and pi.
//   3. Nonlinear chi and iota round constants.
//   4. Repeat 24 rounds.

import "std/crypto_adv/keccak_rc.oo";

pub type KfOut = struct {
    flag: Int,
    err: String,
    n: Int,
    w0: Int,
    w1: Int,
    lanes: List[Int]
};

fn kf_err(m: String) -> KfOut {
    return KfOut { flag: 0, err: "ERR\tkeccak: " + m, n: 0, w0: 0, w1: 0, lanes: list_new() };
}

fn kf_mask(x: Int) -> Int {
    return x & 4294967295;
}

fn kf_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn kf_rotl_lo(lo: Int, hi: Int, r: Int) -> Int {
    let n: Int = r % 64;
    if n == 0 {
        return kf_mask(lo);
    }
    if n < 32 {
        return kf_mask((lo << n) | (hi >> (32 - n)));
    }
    let m: Int = n - 32;
    return kf_mask((hi << m) | (lo >> (32 - m)));
}

fn kf_rotl_hi(lo: Int, hi: Int, r: Int) -> Int {
    let n: Int = r % 64;
    if n == 0 {
        return kf_mask(hi);
    }
    if n < 32 {
        return kf_mask((hi << n) | (lo >> (32 - n)));
    }
    let m: Int = n - 32;
    return kf_mask((lo << m) | (hi >> (32 - m)));
}

fn kf_rho(x: Int, y: Int) -> Int {
    if x == 0 {
        if y == 0 { return 0; }
        if y == 1 { return 36; }
        if y == 2 { return 3; }
        if y == 3 { return 41; }
        return 18;
    }
    if x == 1 {
        if y == 0 { return 1; }
        if y == 1 { return 44; }
        if y == 2 { return 10; }
        if y == 3 { return 45; }
        return 2;
    }
    if x == 2 {
        if y == 0 { return 62; }
        if y == 1 { return 6; }
        if y == 2 { return 43; }
        if y == 3 { return 15; }
        return 61;
    }
    if x == 3 {
        if y == 0 { return 28; }
        if y == 1 { return 55; }
        if y == 2 { return 25; }
        if y == 3 { return 21; }
        return 56;
    }
    if y == 0 { return 27; }
    if y == 1 { return 20; }
    if y == 2 { return 39; }
    if y == 3 { return 8; }
    return 14;
}

fn kf_getlo(st: List[Int], x: Int, y: Int) -> Int {
    return list_get(st, 2 * (x + 5 * y));
}

fn kf_gethi(st: List[Int], x: Int, y: Int) -> Int {
    return list_get(st, 2 * (x + 5 * y) + 1);
}

fn kf_put(st: List[Int], x: Int, y: Int, lo: Int, hi: Int) -> List[Int] {
    let idx: Int = 2 * (x + 5 * y);
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 50 {
        if i == idx {
            o = list_push(o, kf_mask(lo));
        } else {
            if i == idx + 1 {
                o = list_push(o, kf_mask(hi));
            } else {
                o = list_push(o, list_get(st, i));
            }
        }
        i = i + 1;
    }
    return o;
}

pub fn keccak_f1600_perm(st: List[Int]) -> KfOut {
    if list_len(st) != 50 {
        return kf_err("state");
    }
    let mut s: List[Int] = st;
    let mut rnd: Int = 0;
    while rnd < 24 {
        let mut cxlo: List[Int] = list_new();
        let mut cxhi: List[Int] = list_new();
        let mut x: Int = 0;
        while x < 5 {
            let mut lo: Int = 0;
            let mut hi: Int = 0;
            let mut y: Int = 0;
            while y < 5 {
                lo = kf_xor(lo, kf_getlo(s, x, y));
                hi = kf_xor(hi, kf_gethi(s, x, y));
                y = y + 1;
            }
            cxlo = list_push(cxlo, lo);
            cxhi = list_push(cxhi, hi);
            x = x + 1;
        }
        let mut ns: List[Int] = list_new();
        let mut i: Int = 0;
        while i < 50 {
            ns = list_push(ns, 0);
            i = i + 1;
        }
        x = 0;
        while x < 5 {
            let x1: Int = (x + 1) % 5;
            let x4: Int = (x + 4) % 5;
            let dlo: Int = kf_xor(list_get(cxlo, x4), kf_rotl_lo(list_get(cxlo, x1), list_get(cxhi, x1), 1));
            let dhi: Int = kf_xor(list_get(cxhi, x4), kf_rotl_hi(list_get(cxlo, x1), list_get(cxhi, x1), 1));
            let mut y: Int = 0;
            while y < 5 {
                let lo2: Int = kf_xor(kf_getlo(s, x, y), dlo);
                let hi2: Int = kf_xor(kf_gethi(s, x, y), dhi);
                ns = kf_put(ns, x, y, lo2, hi2);
                y = y + 1;
            }
            x = x + 1;
        }
        s = ns;
        let mut b: List[Int] = list_new();
        i = 0;
        while i < 50 {
            b = list_push(b, 0);
            i = i + 1;
        }
        x = 0;
        while x < 5 {
            let mut y: Int = 0;
            while y < 5 {
                let lo3: Int = kf_getlo(s, x, y);
                let hi3: Int = kf_gethi(s, x, y);
                let rr: Int = kf_rho(x, y);
                let nx: Int = y;
                let ny: Int = (2 * x + 3 * y) % 5;
                b = kf_put(b, nx, ny, kf_rotl_lo(lo3, hi3, rr), kf_rotl_hi(lo3, hi3, rr));
                y = y + 1;
            }
            x = x + 1;
        }
        let mut c: List[Int] = list_new();
        i = 0;
        while i < 50 {
            c = list_push(c, 0);
            i = i + 1;
        }
        x = 0;
        while x < 5 {
            let mut y: Int = 0;
            while y < 5 {
                let lo4: Int = kf_getlo(b, x, y);
                let hi4: Int = kf_gethi(b, x, y);
                let nlo: Int = kf_xor(kf_getlo(b, (x + 1) % 5, y), 4294967295);
                let nhi: Int = kf_xor(kf_gethi(b, (x + 1) % 5, y), 4294967295);
                let clo: Int = kf_xor(lo4, nlo & kf_getlo(b, (x + 2) % 5, y));
                let chi: Int = kf_xor(hi4, nhi & kf_gethi(b, (x + 2) % 5, y));
                c = kf_put(c, x, y, clo, chi);
                y = y + 1;
            }
            x = x + 1;
        }
        s = kf_put(c, 0, 0, kf_xor(kf_getlo(c, 0, 0), keccak_rc_lo(rnd)), kf_xor(kf_gethi(c, 0, 0), keccak_rc_hi(rnd)));
        rnd = rnd + 1;
    }
    return KfOut { flag: 1, err: "", n: 50, w0: list_get(s, 0), w1: list_get(s, 1), lanes: s };
}

pub fn keccak_f1600_lane(p: KfOut, i: Int) -> Int {
    if i < 0 {
        return 0;
    }
    if i >= list_len(p.lanes) {
        return 0;
    }
    return list_get(p.lanes, i);
}

pub fn keccak_f1600_flag(o: KfOut) -> Int {
    return o.flag;
}

pub fn keccak_f1600_err(o: KfOut) -> String {
    return o.err;
}

pub fn keccak_f1600_w0(o: KfOut) -> Int {
    return o.w0;
}

pub fn keccak_f1600_w1(o: KfOut) -> Int {
    return o.w1;
}
