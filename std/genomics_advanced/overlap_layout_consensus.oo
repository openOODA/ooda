// # Overlap-Layout-Consensus (OLC) Assembly Engine
//
// Logline: Computes string graph transitive reduction and builds high-fidelity consensus sequences from long reads.
//
// Setup: Long-read assembly graph engine removing transitive containment edges and generating consensus tracks.
//
// Beats:
//   1. Define OlcOverlap, OlcReadNode, and StringGraphEdge data structures.
//   2. Identify transitive bypass edges (A->B, B->C => A->C is redundant).
//   3. Compute consensus base voting and Phred quality score.

type OlcOverlap = struct {
    read_a_id: Int,
    read_b_id: Int,
    overlap_len: Int,
    mismatches: Int,
    identity_pct: Float,
    is_contained: Bool
};

type StringGraphEdge = struct {
    source_id: Int,
    target_id: Int,
    edge_len: Int,
    is_transitive: Bool
};

pub fn olc_filter_overlap(ov: &OlcOverlap, min_len: Int, min_ident: Float) -> Bool {
    if (ov).overlap_len < min_len { return false; }
    if (ov).identity_pct < min_ident { return false; }
    return !(ov).is_contained;
}

pub fn olc_is_transitive_edge(len_ac: Int, len_ab: Int, len_bc: Int, slack: Int) -> Bool {
    let sum_direct = len_ab + len_bc;
    let diff = if sum_direct > len_ac { sum_direct - len_ac } else { len_ac - sum_direct };
    return diff <= slack;
}
