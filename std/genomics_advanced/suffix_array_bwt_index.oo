// # Suffix Array & Burrows-Wheeler Transform (BWT) Index
//
// Logline: Implements FM-index backward search over BWT strings and sampled suffix array coordinate lookups.
//
// Setup: Ultra-compact full-text index enabling sub-millisecond exact string matching on whole chromosomes.
//
// Beats:
//   1. Define BwtIndexRange, SuffixArrayEntry, and FmSearchResult data structures.
//   2. Perform LF-mapping (Last-to-First) coordinate navigation using rank/count tables.
//   3. Resolve genomic coordinate bounds from suffix array sample points.

type BwtIndexRange = struct {
    low_idx: Int,
    high_idx: Int,
    match_count: Int
};

type FmSearchResult = struct {
    query_len: Int,
    matches_found: Int,
    sa_start_pos: Int,
    is_unique: Bool
};

pub fn bwt_calc_range_count(r: &BwtIndexRange) -> Int {
    if (r).high_idx < (r).low_idx { return 0; }
    return ((r).high_idx - (r).low_idx) + 1;
}

pub fn bwt_step_lf_mapping(
    c_count: Int,
    occ_low: Int,
    occ_high: Int,
) -> BwtIndexRange {
    let next_low = c_count + occ_low;
    let next_high = (c_count + occ_high) - 1;
    let count = if next_high >= next_low { (next_high - next_low) + 1 } else { 0 };
    return BwtIndexRange {
        low_idx: next_low,
        high_idx: next_high,
        match_count: count
    };
}
