// # SAM Format Flag Bitwise Bitmask Classifier
//
// Logline: Decodes SAM/BAM 16-bit alignment flags into paired, duplicate, unmapped, and supplementary states.
//
// Setup: High-throughput sequencing record classifier validating read pairing, proper orientation, and secondary alignments.
//
// Beats:
//   1. Define SamFlagDecomposition data structure with boolean state flags.
//   2. Unpack bitwise masks: 0x1 (paired), 0x2 (proper pair), 0x4 (unmapped), 0x10 (reverse), 0x100 (secondary).
//   3. Classify alignment category: primary, secondary, supplementary, unmapped, duplicate.

type SamFlagDecomposition = struct {
    is_paired: Bool,
    is_proper_pair: Bool,
    is_unmapped: Bool,
    is_mate_unmapped: Bool,
    is_reverse_strand: Bool,
    is_mate_reverse: Bool,
    is_read1: Bool,
    is_read2: Bool,
    is_secondary: Bool,
    is_qc_failed: Bool,
    is_duplicate: Bool,
    is_supplementary: Bool,
};

pub fn sam_test_bit(flag: Int, bit_mask: Int) -> Bool {
    let div = flag / bit_mask;
    let rem = div - ((div / 2) * 2);
    return rem == 1;
}

pub fn sam_decompose_flag(flag: Int) -> SamFlagDecomposition {
    return SamFlagDecomposition {
        is_paired: sam_test_bit(flag, 1),
        is_proper_pair: sam_test_bit(flag, 2),
        is_unmapped: sam_test_bit(flag, 4),
        is_mate_unmapped: sam_test_bit(flag, 8),
        is_reverse_strand: sam_test_bit(flag, 16),
        is_mate_reverse: sam_test_bit(flag, 32),
        is_read1: sam_test_bit(flag, 64),
        is_read2: sam_test_bit(flag, 128),
        is_secondary: sam_test_bit(flag, 256),
        is_qc_failed: sam_test_bit(flag, 512),
        is_duplicate: sam_test_bit(flag, 1024),
        is_supplementary: sam_test_bit(flag, 2048),
    };
}
