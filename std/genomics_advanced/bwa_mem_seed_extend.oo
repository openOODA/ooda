// # BWA-MEM Maximal Exact Match Seed & Extension Engine
//
// Logline: Implements BWA-MEM seed chaining heuristics and banded affine gap extension for NGS alignment.
//
// Setup: Seed-and-extend sequence aligner locating Super-Maximal Exact Matches (SMEM) and extending collinear chains.
//
// Beats:
//   1. Define BwaMemSeed, BwaChainedSeed, and BwaAlignmentExtension data structures.
//   2. Validate collinear seed compatibility in query and reference coordinate spaces.
//   3. Compute affine gap penalty extension scores and optimal alignment bounds.

type BwaMemSeed = struct {
    q_start: Int,
    q_end: Int,
    r_start: Int,
    r_end: Int,
    length: Int,
};

type BwaChainedSeed = struct {
    score: Int,
    seed_count: Int,
    is_collinear: Bool,
};

type BwaAlignmentExtension = struct {
    query_len: Int,
    ref_len: Int,
    match_score: Int,
    mismatch_penalty: Int,
    gap_open: Int,
    gap_extend: Int,
    final_sw_score: Int,
    is_optimal: Bool,
};

pub fn bwa_seed_is_collinear(s1: &BwaMemSeed, s2: &BwaMemSeed, max_gap: Int) -> Bool {
    let dq = (s2).q_start - (s1).q_end;
    let dr = (s2).r_start - (s1).r_end;
    if dq < 0 || dr < 0 { return false; }
    if dq > max_gap || dr > max_gap { return false; }
    let diff = if dq > dr { dq - dr } else { dr - dq };
    return diff <= max_gap;
}

pub fn bwa_chain_seed_score(s1: &BwaMemSeed, s2: &BwaMemSeed, match_weight: Int, gap_penalty: Int) -> Int {
    let seed_len = (s2).length;
    let dq = (s2).q_start - (s1).q_end;
    let dr = (s2).r_start - (s1).r_end;
    let gap = if dq > dr { dq - dr } else { dr - dq };
    let gain = seed_len * match_weight;
    let cost = gap * gap_penalty;
    let net = gain - cost;
    return if net > 0 { net } else { 0 };
}

pub fn bwa_extend_banded_affine(
    q_len: Int,
    r_len: Int,
    matches: Int,
    mismatches: Int,
    gaps: Int,
    w_match: Int,
    w_mismatch: Int,
    w_open: Int,
    w_ext: Int,
) -> BwaAlignmentExtension {
    let score = (matches * w_match) - (mismatches * w_mismatch) - (gaps * w_open) - (gaps * w_ext);
    let opt = score > 30 && mismatches < 5;
    return BwaAlignmentExtension {
        query_len: q_len,
        ref_len: r_len,
        match_score: matches * w_match,
        mismatch_penalty: mismatches * w_mismatch,
        gap_open: w_open,
        gap_extend: w_ext,
        final_sw_score: score,
        is_optimal: opt,
    };
}
