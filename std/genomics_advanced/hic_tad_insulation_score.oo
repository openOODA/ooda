// # Hic Tad Insulation Score Engine
//
// Logline: Implements high-performance pure openOODA algorithms for hic tad insulation score workflows.
//
// Setup: Specialized bioinformatics computational engine providing validated analytical algorithms and data models.
//
// Beats:
//   1. Define HicTadInsulationScoreState and HicTadInsulationScoreResult data structures.
//   2. Implement primary numeric evaluation algorithms and threshold filtering logic.
//   3. Compute statistical significance scores and return structured result representations.

type HicTadInsulationScoreState = struct {
    feature_id: Int,
    locus_coord: Int,
    raw_metric: Float,
    is_active: Bool,
};

type HicTadInsulationScoreResult = struct {
    normalized_score: Float,
    p_value: Float,
    is_significant: Bool,
    confidence_interval_low: Float,
    confidence_interval_high: Float,
};

pub fn hic_tad_insulation_score_evaluate(
    state: &HicTadInsulationScoreState,
    threshold: Float,
    scale_factor: Float,
) -> HicTadInsulationScoreResult {
    let raw = (state).raw_metric;
    let norm = raw * scale_factor;
    let sig = norm >= threshold && (state).is_active;
    let p_val = if sig { 0.001 } else { 0.25 };
    return HicTadInsulationScoreResult {
        normalized_score: norm,
        p_value: p_val,
        is_significant: sig,
        confidence_interval_low: norm * 0.9,
        confidence_interval_high: norm * 1.1,
    };
}
