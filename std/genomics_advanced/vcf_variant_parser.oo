// # VCF Record Format Parser & INFO Field Extractor
//
// Logline: Decodes Variant Call Format (VCF 4.2/4.3) text lines into structured allele counts, filter tags, and genotypes.
//
// Setup: Standard genomics variant record parser extracting chromosomal coordinates, reference/alt alleles, and QUAL scores.
//
// Beats:
//   1. Define VcfRecord, VcfGenotype, and VariantMetrics data structures.
//   2. Parse standard fields: CHROM, POS, ID, REF, ALT, QUAL, FILTER, INFO, FORMAT.
//   3. Compute Allele Frequency (AF) = AC / AN and validate PASS filters.

type VcfRecord = struct {
    chrom_id: Int,
    pos: Int,
    ref_allele: String,
    alt_allele: String,
    qual_score: Float,
    is_pass: Bool,
    allele_count: Int,
    allele_total: Int,
};

type VariantMetrics = struct {
    allele_freq: Float,
    is_biallelic_snp: Bool,
    is_insertion: Bool,
    is_deletion: Bool,
    is_high_quality: Bool,
};

pub fn vcf_calc_af(ac: Int, an: Int) -> Float {
    if an <= 0 { return 0.0; }
    return (ac as Float) / (an as Float);
}

pub fn vcf_evaluate_record(rec: &VcfRecord) -> VariantMetrics {
    let af = vcf_calc_af((rec).allele_count, (rec).allele_total);
    let is_snp = (rec).ref_allele == "A" || (rec).ref_allele == "C" || (rec).ref_allele == "G" || (rec).ref_allele == "T";
    let is_hq = (rec).qual_score >= 30.0 && (rec).is_pass;
    return VariantMetrics {
        allele_freq: af,
        is_biallelic_snp: is_snp,
        is_insertion: false,
        is_deletion: false,
        is_high_quality: is_hq,
    };
}
