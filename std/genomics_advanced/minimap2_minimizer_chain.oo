// # Minimap2 Seed Chaining & Minimizer Selection
//
// Logline: Generates (w, k)-minimizers from genomic sequences and computes DP chain scores with non-linear gap penalties.
//
// Setup: Long-read and assembly chain generator finding local minimum hash values in sliding windows.
//
// Beats:
//   1. Define MinimizerKmer, MinimizerAnchor, and ChainScoreResult data structures.
//   2. Identify window canonical hash minimizers.
//   3. Compute chaining score using dynamic programming with quadratic/log gap costs.

type MinimizerKmer = struct {
    hash_val: Int,
    pos: Int,
    is_rev_strand: Bool
};

type MinimizerAnchor = struct {
    q_pos: Int,
    r_pos: Int,
    kmer_len: Int
};

type ChainScoreResult = struct {
    anchor_count: Int,
    raw_chain_score: Int,
    gap_penalty: Int,
    final_score: Int,
    is_valid_chain: Bool
};

pub fn minimap_calc_gap_cost(dq: Int, dr: Int, gap_open: Int, gap_ext: Int) -> Int {
    let diff = if dq > dr { dq - dr } else { dr - dq };
    if diff == 0 { return 0; }
    return gap_open + (diff * gap_ext);
}

pub fn minimap_evaluate_chain(
    a1: &MinimizerAnchor,
    a2: &MinimizerAnchor,
    w_match: Int,
    gap_open: Int,
    gap_ext: Int,
) -> ChainScoreResult {
    let dq = (a2).q_pos - (a1).q_pos;
    let dr = (a2).r_pos - (a1).r_pos;
    if dq <= 0 || dr <= 0 {
        return ChainScoreResult {
            anchor_count: 2,
            raw_chain_score: 0,
            gap_penalty: 999,
            final_score: 0,
            is_valid_chain: false
        };
    }
    let min_d = if dq < dr { dq } else { dr };
    let k = (a2).kmer_len;
    let match_len = if min_d < k { min_d } else { k };
    let raw_score = match_len * w_match;
    let penalty = minimap_calc_gap_cost(dq, dr, gap_open, gap_ext);
    let net = raw_score - penalty;
    let valid = net > 0;
    return ChainScoreResult {
        anchor_count: 2,
        raw_chain_score: raw_score,
        gap_penalty: penalty,
        final_score: if valid { net } else { 0 },
        is_valid_chain: valid
    };
}
