// # EVM bytecode dispatcher floor
//
// Logline: Executes ADD, bitwise, PUSH/POP/DUP/SWAP, and bounded MLOAD/MSTORE on a stack and memory.
//
// Setup: Pure. Stack and memory are List[Int]. Out-of-bounds memory or stack underflow is Err.
//
// Beats:
//   1. PUSH1 reads the next immediate onto the stack.
//   2. ADD, AND, OR, XOR, POP, DUP1, SWAP1.
//   3. MSTORE writes a byte and MLOAD reads it back.
//   4. Reject underflow and OOB.

pub type EvmOut = struct {
    flag: Int,
    err: String,
    top: Int,
    n: Int
};

fn ev_err(m: String) -> EvmOut {
    return EvmOut { flag: 0, err: "ERR\tevm: " + m, top: 0, n: 0 };
}

fn ev_and() -> Int {
    return 22;
}

fn ev_or() -> Int {
    return 23;
}

fn ev_xor() -> Int {
    return 24;
}

fn ev_bxor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn ev_put(ram: List[Int], addr: Int, v: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < list_len(ram) {
        if i == addr {
            o = list_push(o, v & 255);
        } else {
            o = list_push(o, list_get(ram, i));
        }
        i = i + 1;
    }
    return o;
}

fn ev_at(st: List[Int], i: Int) -> Int {
    return list_get(st, list_len(st) - 1 - i);
}

fn ev_pop(st: List[Int]) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    let n: Int = list_len(st) - 1;
    while i < n {
        o = list_push(o, list_get(st, i));
        i = i + 1;
    }
    return o;
}

pub fn evm_bytecode_core_run(code: List[Int], ram0: List[Int]) -> EvmOut {
    let mut st: List[Int] = list_new();
    let mut ram: List[Int] = ram0;
    let mut pc: Int = 0;
    let n: Int = list_len(code);
    while pc < n {
        let op: Int = list_get(code, pc);
        pc = pc + 1;
        if op == 96 {
            if pc >= n {
                return ev_err("imm");
            }
            st = list_push(st, list_get(code, pc) & 255);
            pc = pc + 1;
        } else {
            if op == 80 {
                if list_len(st) < 1 {
                    return ev_err("under");
                }
                st = ev_pop(st);
            } else {
                if op == 1 {
                    if list_len(st) < 2 {
                        return ev_err("under");
                    }
                    let a: Int = ev_at(st, 0);
                    let b: Int = ev_at(st, 1);
                    st = ev_pop(ev_pop(st));
                    st = list_push(st, a + b);
                } else {
                    if op == ev_and() {
                        if list_len(st) < 2 {
                            return ev_err("under");
                        }
                        let a2: Int = ev_at(st, 0);
                        let b2: Int = ev_at(st, 1);
                        st = ev_pop(ev_pop(st));
                        st = list_push(st, a2 & b2);
                    } else {
                        if op == ev_or() {
                            if list_len(st) < 2 {
                                return ev_err("under");
                            }
                            let a3: Int = ev_at(st, 0);
                            let b3: Int = ev_at(st, 1);
                            st = ev_pop(ev_pop(st));
                            st = list_push(st, a3 | b3);
                        } else {
                            if op == ev_xor() {
                                if list_len(st) < 2 {
                                    return ev_err("under");
                                }
                                let a4: Int = ev_at(st, 0);
                                let b4: Int = ev_at(st, 1);
                                st = ev_pop(ev_pop(st));
                                st = list_push(st, ev_bxor(a4, b4));
                            } else {
                                if op == 128 {
                                    if list_len(st) < 1 {
                                        return ev_err("under");
                                    }
                                    st = list_push(st, ev_at(st, 0));
                                } else {
                                    if op == 144 {
                                        if list_len(st) < 2 {
                                            return ev_err("under");
                                        }
                                        let t0: Int = ev_at(st, 0);
                                        let t1: Int = ev_at(st, 1);
                                        st = ev_pop(ev_pop(st));
                                        st = list_push(st, t0);
                                        st = list_push(st, t1);
                                    } else {
                                        if op == 82 {
                                            if list_len(st) < 2 {
                                                return ev_err("under");
                                            }
                                            let addr: Int = ev_at(st, 0);
                                            let val: Int = ev_at(st, 1);
                                            if addr < 0 {
                                                return ev_err("oob");
                                            }
                                            if addr >= list_len(ram) {
                                                return ev_err("oob");
                                            }
                                            ram = ev_put(ram, addr, val);
                                            st = ev_pop(ev_pop(st));
                                        } else {
                                            if op == 81 {
                                                if list_len(st) < 1 {
                                                    return ev_err("under");
                                                }
                                                let addr2: Int = ev_at(st, 0);
                                                if addr2 < 0 {
                                                    return ev_err("oob");
                                                }
                                                if addr2 >= list_len(ram) {
                                                    return ev_err("oob");
                                                }
                                                st = ev_pop(st);
                                                st = list_push(st, list_get(ram, addr2));
                                            } else {
                                                return ev_err("op");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if list_len(st) < 1 {
        return EvmOut { flag: 1, err: "", top: 0, n: 0 };
    }
    return EvmOut { flag: 1, err: "", top: ev_at(st, 0), n: list_len(st) };
}

pub fn evm_bytecode_core_step(op: Int, a: Int, b: Int, ram: List[Int], addr: Int) -> EvmOut {
    let mut code: List[Int] = list_new();
    if op == 81 {
        code = list_push(code, 96);
        code = list_push(code, addr & 255);
        code = list_push(code, 81);
        return evm_bytecode_core_run(code, ram);
    }
    if op == 82 {
        code = list_push(code, 96);
        code = list_push(code, a & 255);
        code = list_push(code, 96);
        code = list_push(code, addr & 255);
        code = list_push(code, 82);
        return evm_bytecode_core_run(code, ram);
    }
    return ev_err("op");
}

pub fn evm_bytecode_core_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn evm_bytecode_core_flag(o: EvmOut) -> Int {
    return o.flag;
}
pub fn evm_bytecode_core_err(o: EvmOut) -> String {
    return o.err;
}
pub fn evm_bytecode_core_top(o: EvmOut) -> Int {
    return o.top;
}
