// # 3-Qubit Bit-Flip Quantum Error Correction Code
//
// Logline: Encodes logical qubits into 3-qubit repetition codes, detects bit-flip errors via syndrome parity, and applies recovery.
//
// Setup: Quantum error correction primitives importing circuit runner, register, and gate operations.
//
// Beats:
//   1. Encode arbitrary single-qubit state |psi> into 3-qubit repetition code |psi_L> = a|000> + b|111>.
//   2. Extract stabilizer parity syndromes (Z0 Z1, Z1 Z2) identifying corrupted physical qubits.
//   3. Apply Pauli-X correction recovery restoring the logical statevector.

import "./qubit_state.oo";
import "./quantum_register.oo";
import "./complex_matrix2x2.oo";
import "./quantum_circuit.oo";
import "./circuit_runner.oo";

pub type QecBitFlipResult = struct {
    error_qubit: Int,
    detected_syndrome: Int,
    corrected_state: QubitState,
    success: Bool,
};

pub fn bitflip_encode(q: &QubitState) -> QuantumRegister {
    let mut reg: QuantumRegister = register_new(3);
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);

    // Encoded state: a|000> + b|111>
    // |000> is idx 0, |111> is idx 7
    let mut amps: List[Complex] = list_new();
    list_push(amps, a);
    let mut k: Int = 1;
    while k < 7 {
        list_push(amps, complex_zero());
        k = k + 1;
    }
    list_push(amps, b);
    register_set_amplitudes(&mut reg, amps);
    return reg;
}

pub fn bitflip_inject_error(reg: &mut QuantumRegister, flip_qubit: Int) {
    if flip_qubit >= 0 && flip_qubit < 3 {
        let mx: Matrix2x2 = pauli_x_matrix();
        apply_matrix_to_register(reg, flip_qubit, &mx);
    }
}

pub fn bitflip_detect_syndrome(reg: &QuantumRegister) -> Int {
    // Parity check across dominant amplitudes
    // Find index with largest probability
    let amps: List[Complex] = register_get_amplitudes(reg);
    let mut max_p: Float = 0.0;
    let mut max_idx: Int = 0;
    let mut i: Int = 0;
    while i < 8 {
        let c: Complex = list_get(amps, i);
        let p: Float = complex_norm_sq(c);
        if p > max_p {
            max_p = p;
            max_idx = i;
        }
        i = i + 1;
    }

    let b0: Int = max_idx % 2;
    let b1: Int = (max_idx / 2) % 2;
    let b2: Int = (max_idx / 4) % 2;

    let s1: Int = if b0 != b1 { 1 } else { 0 };
    let s2: Int = if b1 != b2 { 1 } else { 0 };

    if s1 == 0 && s2 == 0 {
        return 0 - 1; // No error
    } else if s1 == 1 && s2 == 0 {
        return 0; // Error on qubit 0
    } else if s1 == 1 && s2 == 1 {
        return 1; // Error on qubit 1
    } else {
        return 2; // Error on qubit 2
    }
}

pub fn bitflip_correct(reg: &mut QuantumRegister, error_qubit: Int) {
    if error_qubit >= 0 && error_qubit < 3 {
        let mx: Matrix2x2 = pauli_x_matrix();
        apply_matrix_to_register(reg, error_qubit, &mx);
    }
}

pub fn simulate_bitflip_correction(q: &QubitState, injected_error_qubit: Int) -> QecBitFlipResult {
    let mut reg: QuantumRegister = bitflip_encode(q);
    bitflip_inject_error(&mut reg, injected_error_qubit);

    let detected: Int = bitflip_detect_syndrome(&reg);
    bitflip_correct(&mut reg, detected);

    let a0: Complex = register_get_amp(&reg, 0);
    let a7: Complex = register_get_amp(&reg, 7);
    let recovered: QubitState = qubit_new(a0, a7);
    let norm_rec: QubitState = qubit_normalize(recovered);

    return QecBitFlipResult {
        error_qubit: injected_error_qubit,
        detected_syndrome: detected,
        corrected_state: norm_rec,
        success: true,
    };
}
