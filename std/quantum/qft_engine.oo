// # Quantum Fourier Transform (QFT) Engine
//
// Logline: QFT / IQFT circuit synthesis: H, controlled phase, SWAP reverse.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type QftCircuit = struct {
    num_qubits: Int,
    gate_count: Int,
    last_type: Int,
    last_target: Int,
    last_param_milli: Int
};

pub fn qft_math_pi_milli() -> Int {
    return 3142;
}

pub fn qft_int_pow2(n: Int) -> Int {
    let mut res: Int = 1;
    let mut i: Int = 0;
    while i < n {
        res = res * 2;
        i = i + 1;
    }
    return res;
}

pub fn qft_circuit_new(num_qubits: Int) -> QftCircuit {
    return QftCircuit {
        num_qubits: num_qubits,
        gate_count: 0,
        last_type: 0,
        last_target: 0,
        last_param_milli: 0
    };
}

pub fn qft_circuit_h(c: QftCircuit, target: Int) -> QftCircuit {
    return QftCircuit {
        num_qubits: c.num_qubits,
        gate_count: c.gate_count + 1,
        last_type: 3,
        last_target: target,
        last_param_milli: 0
    };
}

pub fn qft_circuit_phase(c: QftCircuit, target: Int, angle_milli: Int) -> QftCircuit {
    return QftCircuit {
        num_qubits: c.num_qubits,
        gate_count: c.gate_count + 1,
        last_type: 13,
        last_target: target,
        last_param_milli: angle_milli
    };
}

pub fn qft_circuit_swap(c: QftCircuit, q1: Int, q2: Int) -> QftCircuit {
    return QftCircuit {
        num_qubits: c.num_qubits,
        gate_count: c.gate_count + 1,
        last_type: 11,
        last_target: q2,
        last_param_milli: q1
    };
}

pub fn build_qft_circuit(num_qubits: Int) -> QftCircuit {
    let mut circ: QftCircuit = qft_circuit_new(num_qubits);
    let pi_val: Int = qft_math_pi_milli();
    let mut j: Int = 0;
    while j < num_qubits {
        circ = qft_circuit_h(circ, j);
        let mut k: Int = j + 1;
        while k < num_qubits {
            let diff: Int = k - j;
            let div_factor: Int = qft_int_pow2(diff);
            let angle: Int = pi_val / div_factor;
            circ = qft_circuit_phase(circ, j, angle);
            k = k + 1;
        }
        j = j + 1;
    }
    let half_n: Int = num_qubits / 2;
    let mut s: Int = 0;
    while s < half_n {
        let targ: Int = (num_qubits - 1) - s;
        circ = qft_circuit_swap(circ, s, targ);
        s = s + 1;
    }
    return circ;
}

pub fn build_iqft_circuit(num_qubits: Int) -> QftCircuit {
    let mut circ: QftCircuit = qft_circuit_new(num_qubits);
    let pi_val: Int = qft_math_pi_milli();
    let half_n: Int = num_qubits / 2;
    let mut s: Int = 0;
    while s < half_n {
        let targ: Int = (num_qubits - 1) - s;
        circ = qft_circuit_swap(circ, s, targ);
        s = s + 1;
    }
    let mut j: Int = num_qubits - 1;
    while j >= 0 {
        let mut k: Int = num_qubits - 1;
        while k > j {
            let diff: Int = k - j;
            let div_factor: Int = qft_int_pow2(diff);
            let angle: Int = (0 - pi_val) / div_factor;
            circ = qft_circuit_phase(circ, j, angle);
            k = k - 1;
        }
        circ = qft_circuit_h(circ, j);
        j = j - 1;
    }
    return circ;
}

pub fn qft_expected_gate_count(n: Int) -> Int {
    let phases: Int = (n * (n - 1)) / 2;
    let swaps: Int = n / 2;
    return n + phases + swaps;
}
