// # Toffoli & Fredkin Multi-Qubit Controlled Gates
//
// Logline: Implements CCX (Toffoli), CCZ, and CSWAP (Fredkin) 3-qubit reversible logic gates.
//
// Setup: Three-qubit gate operations modifying QuantumRegister statevectors importing qubit_state.oo and quantum_register.oo.
//
// Beats:
//   1. Implement 3-qubit Toffoli (CCX) gate targeting arbitrary register triplets.
//   2. Implement 3-qubit Controlled-Controlled-Z (CCZ) and Fredkin (CSWAP) gates.
//   3. Implement multi-controlled X gate abstraction with arbitrary control count.

import "./qubit_state.oo";
import "./quantum_register.oo";

pub fn apply_toffoli(reg: &mut QuantumRegister, ctrl1: Int, ctrl2: Int, targ: Int) {
    let c1_mask: Int = int_pow2(ctrl1);
    let c2_mask: Int = int_pow2(ctrl2);
    let t_mask: Int = int_pow2(targ);
    let n_states: Int = reg.num_states;
    let old_amps: List[Complex] = reg.amplitudes;
    let mut new_amps: List[Complex] = list_new();

    let mut i: Int = 0;
    while i < n_states {
        let b1: Int = (i / c1_mask) % 2;
        let b2: Int = (i / c2_mask) % 2;
        if b1 == 1 && b2 == 1 {
            let tb: Int = (i / t_mask) % 2;
            let pair_idx: Int = if tb == 0 {
                i + t_mask
            } else {
                i - t_mask
            };
            list_push(new_amps, list_get(old_amps, pair_idx));
        } else {
            list_push(new_amps, list_get(old_amps, i));
        }
        i = i + 1;
    }
    reg.amplitudes = new_amps;
}

pub fn apply_ccz(reg: &mut QuantumRegister, ctrl1: Int, ctrl2: Int, targ: Int) {
    let c1_mask: Int = int_pow2(ctrl1);
    let c2_mask: Int = int_pow2(ctrl2);
    let t_mask: Int = int_pow2(targ);
    let n_states: Int = reg.num_states;
    let old_amps: List[Complex] = reg.amplitudes;
    let mut new_amps: List[Complex] = list_new();

    let mut i: Int = 0;
    while i < n_states {
        let b1: Int = (i / c1_mask) % 2;
        let b2: Int = (i / c2_mask) % 2;
        let tb: Int = (i / t_mask) % 2;
        let amp: Complex = list_get(old_amps, i);
        if b1 == 1 && b2 == 1 && tb == 1 {
            let neg_amp: Complex = complex_scale(amp, 0.0 - 1.0);
            list_push(new_amps, neg_amp);
        } else {
            list_push(new_amps, amp);
        }
        i = i + 1;
    }
    reg.amplitudes = new_amps;
}

pub fn apply_fredkin(reg: &mut QuantumRegister, ctrl: Int, targ1: Int, targ2: Int) {
    let c_mask: Int = int_pow2(ctrl);
    let t1_mask: Int = int_pow2(targ1);
    let t2_mask: Int = int_pow2(targ2);
    let n_states: Int = reg.num_states;
    let old_amps: List[Complex] = reg.amplitudes;
    let mut new_amps: List[Complex] = list_new();

    let mut i: Int = 0;
    while i < n_states {
        let cb: Int = (i / c_mask) % 2;
        if cb == 1 {
            let b1: Int = (i / t1_mask) % 2;
            let b2: Int = (i / t2_mask) % 2;
            if b1 != b2 {
                let swapped_idx: Int = (i - (b1 * t1_mask) - (b2 * t2_mask)) + (b2 * t1_mask) + (b1 * t2_mask);
                list_push(new_amps, list_get(old_amps, swapped_idx));
            } else {
                list_push(new_amps, list_get(old_amps, i));
            }
        } else {
            list_push(new_amps, list_get(old_amps, i));
        }
        i = i + 1;
    }
    reg.amplitudes = new_amps;
}
