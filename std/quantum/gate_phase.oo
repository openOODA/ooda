// # Phase & T Quantum Gates
//
// Logline: Implements S (Phase) and T (pi/8) quantum gates, their adjoints, and gate relations (T^2=S, S^2=Z).
//
// Setup: Single-qubit non-Clifford and Clifford phase gates importing qubit_state.oo and complex_matrix2x2.oo.
//
// Beats:
//   1. Construct 2x2 complex matrices for S, S_dagger, T, and T_dagger gates.
//   2. Apply phase transformations directly to QubitState statevectors.
//   3. Implement algebraic verification for S^2 = Z and T^2 = S identities.

import "./qubit_state.oo";
import "./complex_matrix2x2.oo";

pub fn gate_s_matrix() -> Matrix2x2 {
    // S = [[1, 0], [0, i]]
    return Matrix2x2 {
        m00: complex_one(),
        m01: complex_zero(),
        m10: complex_zero(),
        m11: complex_i()
    };
}

pub fn gate_s_dagger_matrix() -> Matrix2x2 {
    // S_dagger = [[1, 0], [0, -i]]
    let neg_i: Complex = Complex { real: 0.0, imag: 0.0 - 1.0 };
    return Matrix2x2 {
        m00: complex_one(),
        m01: complex_zero(),
        m10: complex_zero(),
        m11: neg_i
    };
}

pub fn gate_t_matrix() -> Matrix2x2 {
    // T = [[1, 0], [0, e^(i pi/4)]] where e^(i pi/4) = 1/sqrt(2) + i/sqrt(2)
    let inv_sqrt2: Float = 0.7071067811865475;
    let exp_ipi4: Complex = Complex { real: inv_sqrt2, imag: inv_sqrt2 };
    return Matrix2x2 {
        m00: complex_one(),
        m01: complex_zero(),
        m10: complex_zero(),
        m11: exp_ipi4
    };
}

pub fn gate_t_dagger_matrix() -> Matrix2x2 {
    // T_dagger = [[1, 0], [0, e^(-i pi/4)]] where e^(-i pi/4) = 1/sqrt(2) - i/sqrt(2)
    let inv_sqrt2: Float = 0.7071067811865475;
    let neg_inv: Float = 0.0 - inv_sqrt2;
    let exp_neg_ipi4: Complex = Complex { real: inv_sqrt2, imag: neg_inv };
    return Matrix2x2 {
        m00: complex_one(),
        m01: complex_zero(),
        m10: complex_zero(),
        m11: exp_neg_ipi4
    };
}

pub fn apply_s_gate(q: &QubitState) -> QubitState {
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);
    let new_b: Complex = complex_mul(complex_i(), b);
    return QubitState { alpha: a, beta: new_b };
}

pub fn apply_s_dagger_gate(q: &QubitState) -> QubitState {
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);
    let neg_i: Complex = Complex { real: 0.0, imag: 0.0 - 1.0 };
    let new_b: Complex = complex_mul(neg_i, b);
    return QubitState { alpha: a, beta: new_b };
}

pub fn apply_t_gate(q: &QubitState) -> QubitState {
    let inv_sqrt2: Float = 0.7071067811865475;
    let exp_ipi4: Complex = Complex { real: inv_sqrt2, imag: inv_sqrt2 };
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);
    let new_b: Complex = complex_mul(exp_ipi4, b);
    return QubitState { alpha: a, beta: new_b };
}

pub fn apply_t_dagger_gate(q: &QubitState) -> QubitState {
    let inv_sqrt2: Float = 0.7071067811865475;
    let neg_inv: Float = 0.0 - inv_sqrt2;
    let exp_neg: Complex = Complex { real: inv_sqrt2, imag: neg_inv };
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);
    let new_b: Complex = complex_mul(exp_neg, b);
    return QubitState { alpha: a, beta: new_b };
}

pub fn phase_s_squared_is_z() -> Bool {
    let s: Matrix2x2 = gate_s_matrix();
    let s2: Matrix2x2 = matrix2x2_mul(&s, &s);
    let diff00: Complex = complex_sub(s2.m00, complex_one());
    let neg_one: Complex = Complex { real: 0.0 - 1.0, imag: 0.0 };
    let diff11: Complex = complex_sub(s2.m11, neg_one);
    if complex_abs(diff00) > 0.0001 { return false; }
    if complex_abs(diff11) > 0.0001 { return false; }
    return true;
}

pub fn phase_t_squared_is_s() -> Bool {
    let t: Matrix2x2 = gate_t_matrix();
    let t2: Matrix2x2 = matrix2x2_mul(&t, &t);
    let s: Matrix2x2 = gate_s_matrix();
    let diff11: Complex = complex_sub(t2.m11, s.m11);
    if complex_abs(diff11) > 0.0001 { return false; }
    return true;
}
