// # Statevector Simulation & Observable Expectation Values
//
// Logline: Computes quantum statevector inner products, state fidelity, Born probabilities, and Pauli observable expectation values.
//
// Setup: Quantum state analysis algorithms importing qubit_state.oo, quantum_register.oo, and complex_matrix2x2.oo.
//
// Beats:
//   1. Compute Hilbert space inner products <psi|phi> and pure state fidelity |<psi|phi>|^2.
//   2. Compute expectation values for single-qubit Pauli observables <X_k>, <Y_k>, <Z_k>.
//   3. Compute full statevector probability distributions across computational basis states.

import "./qubit_state.oo";
import "./quantum_register.oo";
import "./complex_matrix2x2.oo";

pub fn sim_inner_product(reg1: &QuantumRegister, reg2: &QuantumRegister) -> Complex {
    let n1: Int = register_get_num_states(reg1);
    let n2: Int = register_get_num_states(reg2);
    if n1 != n2 {
        return complex_zero();
    }
    let amps1: List[Complex] = register_get_amplitudes(reg1);
    let amps2: List[Complex] = register_get_amplitudes(reg2);
    let mut total: Complex = complex_zero();
    let mut i: Int = 0;
    while i < n1 {
        let a1: Complex = list_get(amps1, i);
        let a2: Complex = list_get(amps2, i);
        let term: Complex = complex_mul(complex_conj(a1), a2);
        total = complex_add(total, term);
        i = i + 1;
    }
    return total;
}

pub fn sim_state_fidelity(reg1: &QuantumRegister, reg2: &QuantumRegister) -> Float {
    let ip: Complex = sim_inner_product(reg1, reg2);
    return complex_norm_sq(ip);
}

pub fn sim_expectation_value_z(reg: &QuantumRegister, target: Int) -> Float {
    let mask: Int = int_pow2(target);
    let n_states: Int = register_get_num_states(reg);
    let amps: List[Complex] = register_get_amplitudes(reg);
    let mut exp_val: Float = 0.0;

    let mut i: Int = 0;
    while i < n_states {
        let bit: Int = (i / mask) % 2;
        let c: Complex = list_get(amps, i);
        let prob: Float = complex_norm_sq(c);
        if bit == 0 {
            exp_val = exp_val + prob;
        } else {
            exp_val = exp_val - prob;
        }
        i = i + 1;
    }
    return exp_val;
}

pub fn sim_expectation_value_x(reg: &QuantumRegister, target: Int) -> Float {
    let mask: Int = int_pow2(target);
    let n_states: Int = register_get_num_states(reg);
    let amps: List[Complex] = register_get_amplitudes(reg);
    let mut total_re: Float = 0.0;

    let mut i: Int = 0;
    while i < n_states {
        let bit: Int = (i / mask) % 2;
        if bit == 0 {
            let j: Int = i + mask;
            let ai: Complex = list_get(amps, i);
            let aj: Complex = list_get(amps, j);
            let prod: Complex = complex_mul(complex_conj(ai), aj);
            let pr: Float = prod.real;
            total_re = total_re + pr;
        }
        i = i + 1;
    }
    return 2.0 * total_re;
}

pub fn sim_expectation_value_y(reg: &QuantumRegister, target: Int) -> Float {
    let mask: Int = int_pow2(target);
    let n_states: Int = register_get_num_states(reg);
    let amps: List[Complex] = register_get_amplitudes(reg);
    let mut total_im: Float = 0.0;

    let mut i: Int = 0;
    while i < n_states {
        let bit: Int = (i / mask) % 2;
        if bit == 0 {
            let j: Int = i + mask;
            let ai: Complex = list_get(amps, i);
            let aj: Complex = list_get(amps, j);
            let prod: Complex = complex_mul(complex_conj(ai), aj);
            let pi: Float = prod.imag;
            total_im = total_im + pi;
        }
        i = i + 1;
    }
    return 2.0 * total_im;
}

pub fn sim_all_probabilities(reg: &QuantumRegister) -> List[Float] {
    let n_states: Int = register_get_num_states(reg);
    let amps: List[Complex] = register_get_amplitudes(reg);
    let mut probs: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n_states {
        let c: Complex = list_get(amps, i);
        list_push(probs, complex_norm_sq(c));
        i = i + 1;
    }
    return probs;
}
