// # Quantum Measurement Probabilities & Wavefunction Collapse
//
// Logline: Calculates single-qubit and joint marginal measurement probabilities and performs projective wavefunction collapse.
//
// Setup: Projective measurement primitives importing qubit_state.oo and quantum_register.oo.
//
// Beats:
//   1. Compute single-qubit marginal probabilities P(q=0) and P(q=1).
//   2. Compute two-qubit joint measurement probabilities across 4 computational basis pairs.
//   3. Implement projective measurement collapse with statevector zeroing and renormalization.

import "./qubit_state.oo";
import "./quantum_register.oo";

pub fn prob_qubit_zero(reg: &QuantumRegister, target: Int) -> Float {
    let mask: Int = int_pow2(target);
    let n_states: Int = register_get_num_states(reg);
    let amps: List[Complex] = register_get_amplitudes(reg);
    let mut total_p0: Float = 0.0;

    let mut i: Int = 0;
    while i < n_states {
        let bit: Int = (i / mask) % 2;
        if bit == 0 {
            let c: Complex = list_get(amps, i);
            total_p0 = total_p0 + complex_norm_sq(c);
        }
        i = i + 1;
    }
    return total_p0;
}

pub fn prob_qubit_one(reg: &QuantumRegister, target: Int) -> Float {
    let p0: Float = prob_qubit_zero(reg, target);
    return 1.0 - p0;
}

pub fn marginal_prob_pair(reg: &QuantumRegister, q1: Int, q2: Int) -> List[Float] {
    let m1: Int = int_pow2(q1);
    let m2: Int = int_pow2(q2);
    let n_states: Int = register_get_num_states(reg);
    let amps: List[Complex] = register_get_amplitudes(reg);

    let mut p00: Float = 0.0;
    let mut p01: Float = 0.0;
    let mut p10: Float = 0.0;
    let mut p11: Float = 0.0;

    let mut i: Int = 0;
    while i < n_states {
        let b1: Int = (i / m1) % 2;
        let b2: Int = (i / m2) % 2;
        let c: Complex = list_get(amps, i);
        let prob: Float = complex_norm_sq(c);

        if b1 == 0 && b2 == 0 {
            p00 = p00 + prob;
        } else if b1 == 0 && b2 == 1 {
            p01 = p01 + prob;
        } else if b1 == 1 && b2 == 0 {
            p10 = p10 + prob;
        } else {
            p11 = p11 + prob;
        }
        i = i + 1;
    }

    let mut result: List[Float] = list_new();
    list_push(result, p00);
    list_push(result, p01);
    list_push(result, p10);
    list_push(result, p11);
    return result;
}

pub fn collapse_qubit(reg: &mut QuantumRegister, target: Int, outcome: Int) {
    let mask: Int = int_pow2(target);
    let n_states: Int = register_get_num_states(reg);
    let amps: List[Complex] = register_get_amplitudes(reg);
    let mut new_amps: List[Complex] = list_new();

    let mut i: Int = 0;
    while i < n_states {
        let bit: Int = (i / mask) % 2;
        if bit == outcome {
            list_push(new_amps, list_get(amps, i));
        } else {
            list_push(new_amps, complex_zero());
        }
        i = i + 1;
    }
    register_set_amplitudes(reg, new_amps);
    register_normalize(reg);
}

pub fn sample_measurement_deterministic(reg: &QuantumRegister, threshold: Float) -> List[Int] {
    let n_qubits: Int = register_size(reg);
    let mut bits: List[Int] = list_new();
    let mut q: Int = 0;
    while q < n_qubits {
        let p1: Float = prob_qubit_one(reg, q);
        if p1 > threshold {
            list_push(bits, 1);
        } else {
            list_push(bits, 0);
        }
        q = q + 1;
    }
    return bits;
}
