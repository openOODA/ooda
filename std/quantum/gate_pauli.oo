// # Pauli Quantum Gates & Algebra
//
// Logline: Implements Pauli I, X, Y, Z matrices, single-qubit transformations, and commutation relations.
//
// Setup: Unitary single-qubit Pauli gate primitives importing qubit_state.oo and complex_matrix2x2.oo.
//
// Beats:
//   1. Construct canonical 2x2 complex matrices for Pauli-I, Pauli-X, Pauli-Y, and Pauli-Z.
//   2. Apply direct Pauli operators to QubitState statevectors.
//   3. Implement algebraic properties including square-to-identity and commutation checks.

import "./qubit_state.oo";
import "./complex_matrix2x2.oo";

pub fn pauli_i_matrix() -> Matrix2x2 {
    return matrix2x2_identity();
}

pub fn pauli_x_matrix() -> Matrix2x2 {
    // X = [[0, 1], [1, 0]]
    return Matrix2x2 {
        m00: complex_zero(),
        m01: complex_one(),
        m10: complex_one(),
        m11: complex_zero()
    };
}

pub fn pauli_y_matrix() -> Matrix2x2 {
    // Y = [[0, -i], [i, 0]]
    let neg_i: Complex = Complex { real: 0.0, imag: 0.0 - 1.0 };
    return Matrix2x2 {
        m00: complex_zero(),
        m01: neg_i,
        m10: complex_i(),
        m11: complex_zero()
    };
}

pub fn pauli_z_matrix() -> Matrix2x2 {
    // Z = [[1, 0], [0, -1]]
    let neg_one: Complex = Complex { real: 0.0 - 1.0, imag: 0.0 };
    return Matrix2x2 {
        m00: complex_one(),
        m01: complex_zero(),
        m10: complex_zero(),
        m11: neg_one
    };
}

pub fn apply_pauli_i(q: &QubitState) -> QubitState {
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);
    return QubitState { alpha: a, beta: b };
}

pub fn apply_pauli_x(q: &QubitState) -> QubitState {
    // X |0> = |1>, X |1> = |0> -> alpha' = beta, beta' = alpha
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);
    return QubitState { alpha: b, beta: a };
}

pub fn apply_pauli_y(q: &QubitState) -> QubitState {
    // Y |0> = i|1>, Y |1> = -i|0> -> alpha' = -i*beta, beta' = i*alpha
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);
    let neg_i: Complex = Complex { real: 0.0, imag: 0.0 - 1.0 };
    let new_alpha: Complex = complex_mul(neg_i, b);
    let new_beta: Complex = complex_mul(complex_i(), a);
    return QubitState {
        alpha: new_alpha,
        beta: new_beta
    };
}

pub fn apply_pauli_z(q: &QubitState) -> QubitState {
    // Z |0> = |0>, Z |1> = -|1> -> alpha' = alpha, beta' = -beta
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);
    let neg_one: Complex = Complex { real: 0.0 - 1.0, imag: 0.0 };
    let new_beta: Complex = complex_mul(neg_one, b);
    return QubitState {
        alpha: a,
        beta: new_beta
    };
}

pub fn pauli_commutator(a: &Matrix2x2, b: &Matrix2x2) -> Matrix2x2 {
    let ab: Matrix2x2 = matrix2x2_mul(a, b);
    let ba: Matrix2x2 = matrix2x2_mul(b, a);
    let neg_ba: Matrix2x2 = matrix2x2_scale(&ba, 0.0 - 1.0);
    return matrix2x2_add(&ab, &neg_ba);
}

pub fn pauli_anticommutator(a: &Matrix2x2, b: &Matrix2x2) -> Matrix2x2 {
    let ab: Matrix2x2 = matrix2x2_mul(a, b);
    let ba: Matrix2x2 = matrix2x2_mul(b, a);
    return matrix2x2_add(&ab, &ba);
}
