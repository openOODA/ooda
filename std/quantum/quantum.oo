// # Quantum Computing & Circuit Simulation Unified Facade
//
// Logline: Re-exports quantum statevectors, gates, circuit simulator, QASM compiler, algorithms, error correction, and density channels.
//
// Setup: Pure module shim and facade importing all 24 quantum computing companion submodules.
//
// Beats:
//   1. Import 24 modular Quantum Computing & Circuit Simulation subcomponents.
//   2. Re-export public constructors, gate sets, statevector simulator entry points, and algorithm runners.
//   3. Maintain full backwards compatibility with downstream openOODA callers.

import "./qubit_state.oo";
import "./quantum_register.oo";
import "./complex_matrix2x2.oo";
import "./gate_pauli.oo";
import "./gate_hadamard.oo";
import "./gate_phase.oo";
import "./gate_cnot.oo";
import "./gate_toffoli.oo";
import "./gate_rotation.oo";
import "./quantum_circuit.oo";
import "./circuit_runner.oo";
import "./statevector_sim.oo";
import "./measurement_prob.oo";
import "./density_matrix.oo";
import "./quantum_teleportation.oo";
import "./qasm_lexer.oo";
import "./qasm_parser.oo";
import "./qft_engine.oo";
import "./grover_search.oo";
import "./vqe_algorithm.oo";
import "./quantum_error_bitflip.oo";
import "./quantum_entropy.oo";
import "./quantum_noise_channel.oo";
import "./quantum_stubs.oo";

pub fn quantum_shim_complex(r: Float, i: Float) -> Complex {
    return complex_new(r, i);
}

pub fn quantum_shim_qubit_zero() -> QubitState {
    return qubit_zero();
}

pub fn quantum_shim_qubit_one() -> QubitState {
    return qubit_one();
}

pub fn quantum_shim_qubit_plus() -> QubitState {
    return qubit_plus();
}

pub fn quantum_shim_register(size: Int) -> QuantumRegister {
    return register_new(size);
}

pub fn quantum_shim_circuit(num_qubits: Int, num_classical: Int) -> QuantumCircuit {
    return circuit_new(num_qubits, num_classical);
}

pub fn quantum_shim_run_circuit(circ: &QuantumCircuit) -> ExecutionResult {
    return circuit_run(circ);
}

pub fn quantum_shim_hadamard(q: &QubitState) -> QubitState {
    return apply_hadamard(q);
}

pub fn quantum_shim_pauli_x(q: &QubitState) -> QubitState {
    return apply_pauli_x(q);
}

pub fn quantum_shim_pauli_y(q: &QubitState) -> QubitState {
    return apply_pauli_y(q);
}

pub fn quantum_shim_pauli_z(q: &QubitState) -> QubitState {
    return apply_pauli_z(q);
}

pub fn quantum_shim_density_from_qubit(q: &QubitState) -> DensityMatrix2x2 {
    return density_from_qubit(q);
}

pub fn quantum_shim_purity(rho: &DensityMatrix2x2) -> Float {
    return density_purity(rho);
}

pub fn quantum_shim_von_neumann_entropy(rho: &DensityMatrix2x2) -> Float {
    return von_neumann_entropy(rho);
}

pub fn quantum_shim_parse_qasm(src: String) -> QuantumCircuit {
    return qasm_parse_source(src);
}

pub fn quantum_shim_build_qft(num_qubits: Int) -> QuantumCircuit {
    return build_qft_circuit(num_qubits);
}

pub fn quantum_shim_grover_search(num_qubits: Int, marked_target: Int) -> GroverResult {
    return run_grover_search(num_qubits, marked_target);
}

pub fn quantum_shim_vqe(h_z0: Float, h_z1: Float, h_zz: Float) -> VqeResult {
    return vqe_optimize(h_z0, h_z1, h_zz, 0.5, 50, 0.1);
}

pub fn quantum_shim_teleport(q: &QubitState) -> TeleportationResult {
    return simulate_teleportation(q);
}

pub fn quantum_shim_bitflip_correct(q: &QubitState, err_qubit: Int) -> QecBitFlipResult {
    return simulate_bitflip_correction(q, err_qubit);
}

pub fn quantum_shim_channel_depolarizing(rho: &DensityMatrix2x2, p: Float) -> DensityMatrix2x2 {
    return channel_depolarizing(rho, p);
}
