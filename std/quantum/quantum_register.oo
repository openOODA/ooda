// # N-Qubit Quantum Register & Statevector Memory
//
// Logline: Manages multi-qubit statevectors, amplitude initialization, normalization, and tensor products.
//
// Setup: Multi-qubit statevector allocation importing Complex arithmetic from qubit_state.oo.
//
// Beats:
//   1. Allocate and initialize 2^N dimensional quantum statevectors in the |0...0> ground state.
//   2. Provide amplitude indexing, mutation, normalization, and probability queries.
//   3. Implement register cloning, tensor products, and single-qubit lifting.

import "./qubit_state.oo";

pub fn int_pow2(n: Int) -> Int {
    let mut res: Int = 1;
    let mut i: Int = 0;
    while i < n {
        res = res * 2;
        i = i + 1;
    }
    return res;
}

pub type QuantumRegister = struct {
    size: Int,
    num_states: Int,
    amplitudes: List[Complex]
};

pub fn register_new(size: Int) -> QuantumRegister {
    let num_states: Int = int_pow2(size);
    let mut amps: List[Complex] = list_new();
    
    // Initialize state |0...0> = 1.0, all others 0.0
    list_push(amps, complex_one());
    let mut idx: Int = 1;
    while idx < num_states {
        list_push(amps, complex_zero());
        idx = idx + 1;
    }
    
    return QuantumRegister {
        size: size,
        num_states: num_states,
        amplitudes: amps
    };
}

pub fn register_dim(reg: &QuantumRegister) -> Int {
    return reg.num_states;
}

pub fn register_size(reg: &QuantumRegister) -> Int {
    return reg.size;
}

pub fn register_get_num_states(reg: &QuantumRegister) -> Int {
    return reg.num_states;
}

pub fn register_get_amplitudes(reg: &QuantumRegister) -> List[Complex] {
    return reg.amplitudes;
}

pub fn register_set_amplitudes(reg: &mut QuantumRegister, amps: List[Complex]) {
    reg.amplitudes = amps;
}

pub fn register_get_amp(reg: &QuantumRegister, idx: Int) -> Complex {
    let amps: List[Complex] = reg.amplitudes;
    let count: Int = list_len(amps);
    if idx < 0 || idx >= count {
        return complex_zero();
    }
    return list_get(amps, idx);
}

pub fn register_set_amp(reg: &mut QuantumRegister, idx: Int, val: Complex) {
    let amps: List[Complex] = reg.amplitudes;
    let count: Int = list_len(amps);
    if idx >= 0 && idx < count {
        let mut new_amps: List[Complex] = list_new();
        let mut i: Int = 0;
        while i < count {
            if i == idx {
                list_push(new_amps, val);
            } else {
                let existing: Complex = list_get(amps, i);
                list_push(new_amps, existing);
            }
            i = i + 1;
        }
        reg.amplitudes = new_amps;
    }
}

pub fn register_norm_sq(reg: &QuantumRegister) -> Float {
    let amps: List[Complex] = reg.amplitudes;
    let count: Int = list_len(amps);
    let mut total: Float = 0.0;
    let mut i: Int = 0;
    while i < count {
        let c: Complex = list_get(amps, i);
        let nsq: Float = complex_norm_sq(c);
        total = total + nsq;
        i = i + 1;
    }
    return total;
}

pub fn register_normalize(reg: &mut QuantumRegister) {
    let nsq: Float = register_norm_sq(reg);
    if nsq > 0.0 {
        let norm: Float = sqrt(nsq);
        let inv_norm: Float = 1.0 / norm;
        let amps: List[Complex] = reg.amplitudes;
        let count: Int = list_len(amps);
        let mut new_amps: List[Complex] = list_new();
        let mut i: Int = 0;
        while i < count {
            let c: Complex = list_get(amps, i);
            let scaled: Complex = complex_scale(c, inv_norm);
            list_push(new_amps, scaled);
            i = i + 1;
        }
        reg.amplitudes = new_amps;
    }
}

pub fn register_prob(reg: &QuantumRegister, idx: Int) -> Float {
    let c: Complex = register_get_amp(reg, idx);
    return complex_norm_sq(c);
}

pub fn register_clone(reg: &QuantumRegister) -> QuantumRegister {
    let amps: List[Complex] = reg.amplitudes;
    let count: Int = list_len(amps);
    let mut new_amps: List[Complex] = list_new();
    let mut i: Int = 0;
    while i < count {
        let c: Complex = list_get(amps, i);
        list_push(new_amps, c);
        i = i + 1;
    }
    return QuantumRegister {
        size: reg.size,
        num_states: reg.num_states,
        amplitudes: new_amps
    };
}

pub fn register_from_qubit(q: &QubitState) -> QuantumRegister {
    let mut amps: List[Complex] = list_new();
    list_push(amps, qubit_get_alpha(q));
    list_push(amps, qubit_get_beta(q));
    return QuantumRegister {
        size: 1,
        num_states: 2,
        amplitudes: amps
    };
}

pub fn register_tensor_product(reg1: &QuantumRegister, reg2: &QuantumRegister) -> QuantumRegister {
    let n1: Int = reg1.num_states;
    let n2: Int = reg2.num_states;
    let total_qubits: Int = reg1.size + reg2.size;
    let total_states: Int = n1 * n2;
    let mut new_amps: List[Complex] = list_new();

    let amps1: List[Complex] = reg1.amplitudes;
    let amps2: List[Complex] = reg2.amplitudes;

    let mut i: Int = 0;
    while i < n1 {
        let a: Complex = list_get(amps1, i);
        let mut j: Int = 0;
        while j < n2 {
            let b: Complex = list_get(amps2, j);
            let prod: Complex = complex_mul(a, b);
            list_push(new_amps, prod);
            j = j + 1;
        }
        i = i + 1;
    }

    return QuantumRegister {
        size: total_qubits,
        num_states: total_states,
        amplitudes: new_amps
    };
}
