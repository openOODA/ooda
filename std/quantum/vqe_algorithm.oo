// # Variational Quantum Eigensolver (VQE) Algorithm
//
// Logline: Hardware-efficient 2-qubit ansatz builder and parameter steps.
// residual: &mut destubbed to by-value.

type VqeAnsatz = struct {
    gate_count: Int,
    last_type: Int,
    last_target: Int,
    theta_milli: Int
};

type VqeResult = struct {
    optimal_param_milli: Int,
    ground_state_energy_milli: Int,
    iterations: Int
};

pub fn vqe_ansatz_circuit(theta_milli: Int) -> VqeAnsatz {
    let mut a: VqeAnsatz = VqeAnsatz {
        gate_count: 0,
        last_type: 0,
        last_target: 0,
        theta_milli: theta_milli
    };
    a = VqeAnsatz { gate_count: a.gate_count + 1, last_type: 3, last_target: 0, theta_milli: theta_milli };
    a = VqeAnsatz { gate_count: a.gate_count + 1, last_type: 3, last_target: 1, theta_milli: theta_milli };
    a = VqeAnsatz { gate_count: a.gate_count + 1, last_type: 7, last_target: 0, theta_milli: theta_milli };
    a = VqeAnsatz { gate_count: a.gate_count + 1, last_type: 9, last_target: 1, theta_milli: theta_milli };
    a = VqeAnsatz { gate_count: a.gate_count + 1, last_type: 7, last_target: 1, theta_milli: theta_milli };
    return a;
}

pub fn vqe_compute_energy_milli(param_milli: Int, h_z0: Int, h_z1: Int, h_zz: Int) -> Int {
    let p: Int = param_milli;
    let mut c: Int = 1000 - ((p * p) / 2000);
    if c < 0 {
        c = 0;
    }
    let exp_z0: Int = c;
    let exp_z1: Int = c;
    let exp_zz: Int = ((c * c) / 1000) - (((1000 - c) * (1000 - c)) / 1000);
    return ((h_z0 * exp_z0) / 1000) + ((h_z1 * exp_z1) / 1000) + ((h_zz * exp_zz) / 1000);
}

pub fn vqe_optimize(h_z0: Int, h_z1: Int, h_zz: Int, initial_theta: Int, steps: Int, lr: Int) -> VqeResult {
    let mut current: Int = initial_theta;
    let eps: Int = 10;
    let mut step: Int = 0;
    while step < steps {
        let e_plus: Int = vqe_compute_energy_milli(current + eps, h_z0, h_z1, h_zz);
        let e_minus: Int = vqe_compute_energy_milli(current - eps, h_z0, h_z1, h_zz);
        let grad: Int = (e_plus - e_minus) / (2 * eps);
        current = current - ((lr * grad) / 1000);
        step = step + 1;
    }
    let final_e: Int = vqe_compute_energy_milli(current, h_z0, h_z1, h_zz);
    return VqeResult {
        optimal_param_milli: current,
        ground_state_energy_milli: final_e,
        iterations: steps
    };
}
