// # OpenQASM 2.0 Lexer & Token Stream Generator
//
// Logline: Scans OpenQASM 2.0 quantum assembly text into structured tokens with source positions.
//
// Setup: Lexical scanner for quantum circuit descriptions.
//
// Beats:
//   1. Define QasmToken record storing token kind, raw text, line number, and column.
//   2. Scan OpenQASM keywords (OPENQASM, include, qreg, creg, gate, measure, barrier, reset, if).
//   3. Tokenize quantum registers, indices, punctuation, angles, and identifiers.

pub type QasmToken = struct {
    kind: String,
    text: String,
    line: Int,
    col: Int,
};

pub fn qasm_token_new(kind: String, text: String, line: Int, col: Int) -> QasmToken {
    return QasmToken {
        kind: kind,
        text: text,
        line: line,
        col: col,
    };
}

pub fn qasm_token_get_kind(tok: &QasmToken) -> String {
    return tok.kind;
}

pub fn qasm_token_get_text(tok: &QasmToken) -> String {
    return tok.text;
}

pub fn qasm_token_get_line(tok: &QasmToken) -> Int {
    return tok.line;
}

pub fn qasm_token_get_col(tok: &QasmToken) -> Int {
    return tok.col;
}

pub fn qasm_tokenize(src: String) -> List[QasmToken] {
    let mut tokens: List[QasmToken] = list_new();
    let n: Int = chars_len(src);
    let mut i: Int = 0;
    let mut line: Int = 1;
    let mut col: Int = 1;

    while i < n {
        let ch: String = char_at(src, i);

        if ch == "\n" {
            line = line + 1;
            col = 1;
            i = i + 1;
        } else if char_is_space(ch) {
            col = col + 1;
            i = i + 1;
        } else if ch == "/" && i + 1 < n && char_at(src, i + 1) == "/" {
            // Line comment: skip until newline
            while i < n && char_at(src, i) != "\n" {
                i = i + 1;
            }
        } else if ch == ";" {
            let t: QasmToken = qasm_token_new("SEMI", ";", line, col);
            list_push(tokens, t);
            col = col + 1;
            i = i + 1;
        } else if ch == "," {
            let t: QasmToken = qasm_token_new("COMMA", ",", line, col);
            list_push(tokens, t);
            col = col + 1;
            i = i + 1;
        } else if ch == "(" {
            let t: QasmToken = qasm_token_new("LPAREN", "(", line, col);
            list_push(tokens, t);
            col = col + 1;
            i = i + 1;
        } else if ch == ")" {
            let t: QasmToken = qasm_token_new("RPAREN", ")", line, col);
            list_push(tokens, t);
            col = col + 1;
            i = i + 1;
        } else if ch == "[" {
            let t: QasmToken = qasm_token_new("LBRACKET", "[", line, col);
            list_push(tokens, t);
            col = col + 1;
            i = i + 1;
        } else if ch == "]" {
            let t: QasmToken = qasm_token_new("RBRACKET", "]", line, col);
            list_push(tokens, t);
            col = col + 1;
            i = i + 1;
        } else if ch == "{" {
            let t: QasmToken = qasm_token_new("LBRACE", "{", line, col);
            list_push(tokens, t);
            col = col + 1;
            i = i + 1;
        } else if ch == "}" {
            let t: QasmToken = qasm_token_new("RBRACE", "}", line, col);
            list_push(tokens, t);
            col = col + 1;
            i = i + 1;
        } else if ch == "-" && i + 1 < n && char_at(src, i + 1) == ">" {
            let t: QasmToken = qasm_token_new("ARROW", "->", line, col);
            list_push(tokens, t);
            col = col + 2;
            i = i + 2;
        } else if char_is_digit(ch) {
            let start_col: Int = col;
            let mut num_str: String = "";
            let mut is_flt: Bool = false;
            while i < n && (char_is_digit(char_at(src, i)) || char_at(src, i) == ".") {
                let cur: String = char_at(src, i);
                if cur == "." {
                    is_flt = true;
                }
                num_str = num_str + cur;
                col = col + 1;
                i = i + 1;
            }
            let kind: String = if is_flt { "FLOAT" } else { "INT" };
            let t: QasmToken = qasm_token_new(kind, num_str, line, start_col);
            list_push(tokens, t);
        } else if char_is_alpha(ch) || ch == "_" {
            let start_col: Int = col;
            let mut ident_str: String = "";
            while i < n && (char_is_alpha(char_at(src, i)) || char_is_digit(char_at(src, i)) || char_at(src, i) == "_") {
                ident_str = ident_str + char_at(src, i);
                col = col + 1;
                i = i + 1;
            }
            let mut kind: String = "IDENT";
            if ident_str == "OPENQASM" { kind = "OPENQASM"; }
            else if ident_str == "include" { kind = "INCLUDE"; }
            else if ident_str == "qreg" { kind = "QREG"; }
            else if ident_str == "creg" { kind = "CREG"; }
            else if ident_str == "gate" { kind = "GATE"; }
            else if ident_str == "measure" { kind = "MEASURE"; }
            else if ident_str == "barrier" { kind = "BARRIER"; }
            else if ident_str == "reset" { kind = "RESET"; }
            else if ident_str == "if" { kind = "IF"; }

            let t: QasmToken = qasm_token_new(kind, ident_str, line, start_col);
            list_push(tokens, t);
        } else {
            col = col + 1;
            i = i + 1;
        }
    }

    let eof_tok: QasmToken = qasm_token_new("EOF", "", line, col);
    list_push(tokens, eof_tok);
    return tokens;
}
