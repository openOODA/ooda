// # Hadamard Quantum Gate & Superposition Generator
//
// Logline: Implements the Hadamard transformation, equal superposition creation, and X-to-Z basis conversion.
//
// Setup: Single-qubit Clifford generator importing qubit_state.oo and complex_matrix2x2.oo.
//
// Beats:
//   1. Construct 2x2 complex Hadamard matrix normalized by 1/sqrt(2).
//   2. Apply Hadamard transformation to create superpositions and rotate computational to diagonal basis.
//   3. Implement self-inverse involution and Hermitian verification properties.

import "./qubit_state.oo";
import "./complex_matrix2x2.oo";

pub fn hadamard_matrix() -> Matrix2x2 {
    let inv_sqrt2: Float = 0.7071067811865475;
    let neg_inv: Float = 0.0 - inv_sqrt2;
    return Matrix2x2 {
        m00: Complex { real: inv_sqrt2, imag: 0.0 },
        m01: Complex { real: inv_sqrt2, imag: 0.0 },
        m10: Complex { real: inv_sqrt2, imag: 0.0 },
        m11: Complex { real: neg_inv, imag: 0.0 },
    };
}

pub fn apply_hadamard(q: &QubitState) -> QubitState {
    let inv_sqrt2: Float = 0.7071067811865475;
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);
    
    // alpha' = (alpha + beta) / sqrt(2)
    // beta' = (alpha - beta) / sqrt(2)
    let sum_ab: Complex = complex_add(a, b);
    let diff_ab: Complex = complex_sub(a, b);
    
    return QubitState {
        alpha: complex_scale(sum_ab, inv_sqrt2),
        beta: complex_scale(diff_ab, inv_sqrt2),
    };
}

pub fn hadamard_superposition() -> QubitState {
    let zero: QubitState = qubit_zero();
    return apply_hadamard(&zero);
}

pub fn hadamard_basis_change(q: &QubitState) -> QubitState {
    return apply_hadamard(q);
}

pub fn hadamard_is_hermitian() -> Bool {
    let h: Matrix2x2 = hadamard_matrix();
    let adj: Matrix2x2 = matrix2x2_adjoint(&h);
    let diff: Matrix2x2 = Matrix2x2 {
        m00: complex_sub(h.m00, adj.m00),
        m01: complex_sub(h.m01, adj.m01),
        m10: complex_sub(h.m10, adj.m10),
        m11: complex_sub(h.m11, adj.m11),
    };
    if complex_abs(diff.m00) > 0.0001 { return false; }
    if complex_abs(diff.m01) > 0.0001 { return false; }
    if complex_abs(diff.m10) > 0.0001 { return false; }
    if complex_abs(diff.m11) > 0.0001 { return false; }
    return true;
}

pub fn hadamard_is_involutory() -> Bool {
    let h: Matrix2x2 = hadamard_matrix();
    let h2: Matrix2x2 = matrix2x2_mul(&h, &h);
    let diff00: Complex = complex_sub(h2.m00, complex_one());
    let diff11: Complex = complex_sub(h2.m11, complex_one());
    if complex_abs(diff00) > 0.0001 { return false; }
    if complex_abs(h2.m01) > 0.0001 { return false; }
    if complex_abs(h2.m10) > 0.0001 { return false; }
    if complex_abs(diff11) > 0.0001 { return false; }
    return true;
}
