// # OpenQASM 2.0 Parser & AST Circuit Synthesizer
//
// Logline: Parses OpenQASM token streams into executable QuantumCircuit instruction sequences.
//
// Setup: Syntactic analyzer importing qasm_lexer.oo, quantum_circuit.oo, and qubit_state.oo.
//
// Beats:
//   1. Parse register declarations (qreg, creg) extracting qubit and bit counts.
//   2. Parse single, two, and three-qubit gate application statements with index slicing.
//   3. Build and return initialized QuantumCircuit intermediate representations.

import "./qubit_state.oo";
import "./quantum_circuit.oo";
import "./qasm_lexer.oo";

pub fn parse_int_from_str(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut val: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        if char_is_digit(ch) {
            let d: Int = if ch == "0" { 0 }
            else if ch == "1" { 1 }
            else if ch == "2" { 2 }
            else if ch == "3" { 3 }
            else if ch == "4" { 4 }
            else if ch == "5" { 5 }
            else if ch == "6" { 6 }
            else if ch == "7" { 7 }
            else if ch == "8" { 8 }
            else { 9 };
            val = (val * 10) + d;
        }
        i = i + 1;
    }
    return val;
}

pub fn qasm_parse_tokens(tokens: List[QasmToken]) -> QuantumCircuit {
    let n: Int = list_len(tokens);
    let mut num_qubits: Int = 0;
    let mut num_classical: Int = 0;

    // First pass: count qubits and classical bits
    let mut idx: Int = 0;
    while idx < n {
        let tok: QasmToken = list_get(tokens, idx);
        let kind: String = qasm_token_get_kind(&tok);

        if kind == "QREG" {
            // qreg name[N];
            if idx + 3 < n {
                let num_tok: QasmToken = list_get(tokens, idx + 3);
                num_qubits = num_qubits + parse_int_from_str(qasm_token_get_text(&num_tok));
            }
        } else if kind == "CREG" {
            // creg name[M];
            if idx + 3 < n {
                let num_tok: QasmToken = list_get(tokens, idx + 3);
                num_classical = num_classical + parse_int_from_str(qasm_token_get_text(&num_tok));
            }
        }
        idx = idx + 1;
    }

    if num_qubits == 0 {
        num_qubits = 1;
    }

    let mut circ: QuantumCircuit = circuit_new(num_qubits, num_classical);

    // Second pass: parse gate instructions
    idx = 0;
    while idx < n {
        let tok: QasmToken = list_get(tokens, idx);
        let kind: String = qasm_token_get_kind(&tok);
        let text: String = qasm_token_get_text(&tok);

        if kind == "IDENT" {
            if text == "h" {
                // h q[k];
                if idx + 3 < n {
                    let k_tok: QasmToken = list_get(tokens, idx + 3);
                    let k: Int = parse_int_from_str(qasm_token_get_text(&k_tok));
                    circuit_h(&mut circ, k);
                }
            } else if text == "x" {
                if idx + 3 < n {
                    let k_tok: QasmToken = list_get(tokens, idx + 3);
                    let k: Int = parse_int_from_str(qasm_token_get_text(&k_tok));
                    circuit_x(&mut circ, k);
                }
            } else if text == "y" {
                if idx + 3 < n {
                    let k_tok: QasmToken = list_get(tokens, idx + 3);
                    let k: Int = parse_int_from_str(qasm_token_get_text(&k_tok));
                    circuit_y(&mut circ, k);
                }
            } else if text == "z" {
                if idx + 3 < n {
                    let k_tok: QasmToken = list_get(tokens, idx + 3);
                    let k: Int = parse_int_from_str(qasm_token_get_text(&k_tok));
                    circuit_z(&mut circ, k);
                }
            } else if text == "s" {
                if idx + 3 < n {
                    let k_tok: QasmToken = list_get(tokens, idx + 3);
                    let k: Int = parse_int_from_str(qasm_token_get_text(&k_tok));
                    circuit_s(&mut circ, k);
                }
            } else if text == "t" {
                if idx + 3 < n {
                    let k_tok: QasmToken = list_get(tokens, idx + 3);
                    let k: Int = parse_int_from_str(qasm_token_get_text(&k_tok));
                    circuit_t(&mut circ, k);
                }
            } else if text == "cx" {
                // cx q[c], q[t];
                if idx + 8 < n {
                    let c_tok: QasmToken = list_get(tokens, idx + 3);
                    let t_tok: QasmToken = list_get(tokens, idx + 8);
                    let c: Int = parse_int_from_str(qasm_token_get_text(&c_tok));
                    let t: Int = parse_int_from_str(qasm_token_get_text(&t_tok));
                    circuit_cnot(&mut circ, c, t);
                }
            } else if text == "cz" {
                if idx + 8 < n {
                    let c_tok: QasmToken = list_get(tokens, idx + 3);
                    let t_tok: QasmToken = list_get(tokens, idx + 8);
                    let c: Int = parse_int_from_str(qasm_token_get_text(&c_tok));
                    let t: Int = parse_int_from_str(qasm_token_get_text(&t_tok));
                    circuit_cz(&mut circ, c, t);
                }
            } else if text == "ccx" {
                // ccx q[c1], q[c2], q[t];
                if idx + 13 < n {
                    let c1_tok: QasmToken = list_get(tokens, idx + 3);
                    let c2_tok: QasmToken = list_get(tokens, idx + 8);
                    let t_tok: QasmToken = list_get(tokens, idx + 13);
                    let c1: Int = parse_int_from_str(qasm_token_get_text(&c1_tok));
                    let c2: Int = parse_int_from_str(qasm_token_get_text(&c2_tok));
                    let t: Int = parse_int_from_str(qasm_token_get_text(&t_tok));
                    circuit_toffoli(&mut circ, c1, c2, t);
                }
            }
        }
        idx = idx + 1;
    }

    return circ;
}

pub fn qasm_parse_source(src: String) -> QuantumCircuit {
    let tokens: List[QasmToken] = qasm_tokenize(src);
    return qasm_parse_tokens(tokens);
}
