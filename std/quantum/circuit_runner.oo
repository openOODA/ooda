// # Quantum Circuit Simulation Runner
//
// Logline: 1-qubit 2x2 unitary apply (Hadamard / Pauli) on a two-amplitude register.
// residual: &mut destubbed to by-value.

type QAmp = struct {
    re_milli: Int,
    im_milli: Int
};

type QReg1 = struct {
    a0: QAmp,
    a1: QAmp
};

type Mat2 = struct {
    m00_re: Int,
    m00_im: Int,
    m01_re: Int,
    m01_im: Int,
    m10_re: Int,
    m10_im: Int,
    m11_re: Int,
    m11_im: Int
};

pub fn qamp_mul_add(ar: Int, ai: Int, br: Int, bi: Int, cr: Int, ci: Int, dr: Int, di: Int) -> QAmp {
    let re: Int = ((ar * cr) / 1000) - ((ai * ci) / 1000) + ((br * dr) / 1000) - ((bi * di) / 1000);
    let im: Int = ((ar * ci) / 1000) + ((ai * cr) / 1000) + ((br * di) / 1000) + ((bi * dr) / 1000);
    return QAmp { re_milli: re, im_milli: im };
}

pub fn register_new_1q() -> QReg1 {
    return QReg1 {
        a0: QAmp { re_milli: 1000, im_milli: 0 },
        a1: QAmp { re_milli: 0, im_milli: 0 }
    };
}

pub fn hadamard_matrix() -> Mat2 {
    return Mat2 {
        m00_re: 707,
        m00_im: 0,
        m01_re: 707,
        m01_im: 0,
        m10_re: 707,
        m10_im: 0,
        m11_re: 0 - 707,
        m11_im: 0
    };
}

pub fn pauli_x_matrix() -> Mat2 {
    return Mat2 {
        m00_re: 0,
        m00_im: 0,
        m01_re: 1000,
        m01_im: 0,
        m10_re: 1000,
        m10_im: 0,
        m11_re: 0,
        m11_im: 0
    };
}

pub fn apply_matrix_to_register(reg: QReg1, m: Mat2) -> QReg1 {
    let a0: QAmp = qamp_mul_add(m.m00_re, m.m00_im, m.m01_re, m.m01_im, reg.a0.re_milli, reg.a0.im_milli, reg.a1.re_milli, reg.a1.im_milli);
    let a1: QAmp = qamp_mul_add(m.m10_re, m.m10_im, m.m11_re, m.m11_im, reg.a0.re_milli, reg.a0.im_milli, reg.a1.re_milli, reg.a1.im_milli);
    return QReg1 { a0: a0, a1: a1 };
}

pub fn circuit_apply_h(reg: QReg1) -> QReg1 {
    return apply_matrix_to_register(reg, hadamard_matrix());
}

pub fn circuit_apply_x(reg: QReg1) -> QReg1 {
    return apply_matrix_to_register(reg, pauli_x_matrix());
}

pub fn register_prob0_milli(reg: QReg1) -> Int {
    let r: Int = reg.a0.re_milli;
    let i: Int = reg.a0.im_milli;
    return ((r * r) + (i * i)) / 1000;
}
