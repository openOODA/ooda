// # Single Qubit State & Complex Arithmetic
//
// Logline: Implements complex number algebra, single-qubit statevectors, normalization, and Bloch sphere coordinate mapping.
//
// Setup: Fundamental numeric primitives for quantum amplitude calculations and state representations.
//
// Beats:
//   1. Define Complex struct with arithmetic (add, sub, mul, div, conj, norm, abs).
//   2. Define QubitState representation with standard basis states (|0>, |1>, |+>, |->).
//   3. Implement state normalization, Born rule measurement probabilities, and Bloch sphere projections.

pub type Complex = struct {
    real: Float,
    imag: Float
};

pub fn complex_new(r: Float, i: Float) -> Complex {
    return Complex { real: r, imag: i };
}

pub fn complex_get_real(c: &Complex) -> Float {
    return c.real;
}

pub fn complex_get_imag(c: &Complex) -> Float {
    return c.imag;
}

pub fn complex_zero() -> Complex {
    return Complex { real: 0.0, imag: 0.0 };
}

pub fn complex_one() -> Complex {
    return Complex { real: 1.0, imag: 0.0 };
}

pub fn complex_i() -> Complex {
    return Complex { real: 0.0, imag: 1.0 };
}

pub fn complex_add(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let br: Float = b.real;
    let bi: Float = b.imag;
    return Complex {
        real: ar + br,
        imag: ai + bi
    };
}

pub fn complex_sub(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let br: Float = b.real;
    let bi: Float = b.imag;
    return Complex {
        real: ar - br,
        imag: ai - bi
    };
}

pub fn complex_mul(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let br: Float = b.real;
    let bi: Float = b.imag;
    let r: Float = (ar * br) - (ai * bi);
    let i: Float = (ar * bi) + (ai * br);
    return Complex {
        real: r,
        imag: i
    };
}

pub fn complex_scale(a: Complex, s: Float) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    return Complex {
        real: ar * s,
        imag: ai * s
    };
}

pub fn complex_conj(a: Complex) -> Complex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let neg_ai: Float = 0.0 - ai;
    return Complex {
        real: ar,
        imag: neg_ai
    };
}

pub fn complex_norm_sq(a: Complex) -> Float {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    return (ar * ar) + (ai * ai);
}

pub fn complex_abs(a: Complex) -> Float {
    let nsq: Float = complex_norm_sq(a);
    return sqrt(nsq);
}

pub fn complex_div(a: Complex, b: Complex) -> Complex {
    let denom: Float = complex_norm_sq(b);
    if denom == 0.0 {
        return complex_zero();
    }
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let br: Float = b.real;
    let bi: Float = b.imag;
    let num_r: Float = (ar * br) + (ai * bi);
    let num_i: Float = (ai * br) - (ar * bi);
    return Complex {
        real: num_r / denom,
        imag: num_i / denom
    };
}

// -------------------------------------------------------------------
// Single Qubit State Representation
// -------------------------------------------------------------------

pub type QubitState = struct {
    alpha: Complex,
    beta: Complex
};

pub fn qubit_new(alpha: Complex, beta: Complex) -> QubitState {
    return QubitState { alpha: alpha, beta: beta };
}

pub fn qubit_get_alpha(q: &QubitState) -> Complex {
    return q.alpha;
}

pub fn qubit_get_beta(q: &QubitState) -> Complex {
    return q.beta;
}

pub fn qubit_zero() -> QubitState {
    return QubitState {
        alpha: complex_one(),
        beta: complex_zero()
    };
}

pub fn qubit_one() -> QubitState {
    return QubitState {
        alpha: complex_zero(),
        beta: complex_one()
    };
}

pub fn qubit_plus() -> QubitState {
    let inv_sqrt2: Float = 0.7071067811865475;
    return QubitState {
        alpha: Complex { real: inv_sqrt2, imag: 0.0 },
        beta: Complex { real: inv_sqrt2, imag: 0.0 }
    };
}

pub fn qubit_minus() -> QubitState {
    let inv_sqrt2: Float = 0.7071067811865475;
    let neg_inv: Float = 0.0 - inv_sqrt2;
    return QubitState {
        alpha: Complex { real: inv_sqrt2, imag: 0.0 },
        beta: Complex { real: neg_inv, imag: 0.0 }
    };
}

pub fn qubit_normalize(q: QubitState) -> QubitState {
    let nsq: Float = complex_norm_sq(q.alpha) + complex_norm_sq(q.beta);
    if nsq == 0.0 {
        return qubit_zero();
    }
    let norm: Float = sqrt(nsq);
    let inv_norm: Float = 1.0 / norm;
    return QubitState {
        alpha: complex_scale(q.alpha, inv_norm),
        beta: complex_scale(q.beta, inv_norm)
    };
}

pub fn qubit_prob0(q: &QubitState) -> Float {
    return complex_norm_sq(q.alpha);
}

pub fn qubit_prob1(q: &QubitState) -> Float {
    return complex_norm_sq(q.beta);
}

pub fn qubit_bloch_x(q: &QubitState) -> Float {
    let prod: Complex = complex_mul(complex_conj(q.alpha), q.beta);
    let pr: Float = prod.real;
    return 2.0 * pr;
}

pub fn qubit_bloch_y(q: &QubitState) -> Float {
    let prod: Complex = complex_mul(complex_conj(q.alpha), q.beta);
    let pi: Float = prod.imag;
    return 2.0 * pi;
}

pub fn qubit_bloch_z(q: &QubitState) -> Float {
    let p0: Float = complex_norm_sq(q.alpha);
    let p1: Float = complex_norm_sq(q.beta);
    return p0 - p1;
}

pub fn qubit_bloch_coords(q: &QubitState) -> List[Float] {
    let mut coords: List[Float] = list_new();
    let bx: Float = qubit_bloch_x(q);
    let by: Float = qubit_bloch_y(q);
    let bz: Float = qubit_bloch_z(q);
    list_push(coords, bx);
    list_push(coords, by);
    list_push(coords, bz);
    return coords;
}
