// # Quantum Circuit Representation & Gate Sequence Assembly
//
// Logline: Defines quantum circuit instruction lists, gate descriptors, qubit allocations, and circuit builder methods.
//
// Setup: Intermediate representation for quantum programs importing qubit_state.oo.
//
// Beats:
//   1. Define CircuitGate instruction descriptor supporting 1, 2, and 3 qubit operations and continuous rotation angles.
//   2. Define QuantumCircuit program container with qubit and classical register tracking.
//   3. Implement builder methods to append H, X, Y, Z, S, T, Rx, Ry, Rz, CNOT, CZ, SWAP, and Toffoli gates.

import "./qubit_state.oo";

pub type CircuitGate = struct {
    gate_type: Int,
    target: Int,
    control1: Int,
    control2: Int,
    param: Float
};

pub type QuantumCircuit = struct {
    num_qubits: Int,
    num_classical: Int,
    gates: List[CircuitGate]
};

pub fn gate_get_type(g: &CircuitGate) -> Int {
    return g.gate_type;
}

pub fn gate_get_target(g: &CircuitGate) -> Int {
    return g.target;
}

pub fn gate_get_ctrl1(g: &CircuitGate) -> Int {
    return g.control1;
}

pub fn gate_get_ctrl2(g: &CircuitGate) -> Int {
    return g.control2;
}

pub fn gate_get_param(g: &CircuitGate) -> Float {
    return g.param;
}

pub fn circuit_get_qubits(c: &QuantumCircuit) -> Int {
    return c.num_qubits;
}

pub fn circuit_get_classical(c: &QuantumCircuit) -> Int {
    return c.num_classical;
}

pub fn circuit_get_gates(c: &QuantumCircuit) -> List[CircuitGate] {
    return c.gates;
}

pub fn circuit_new(num_qubits: Int, num_classical: Int) -> QuantumCircuit {
    let empty_gates: List[CircuitGate] = list_new();
    return QuantumCircuit {
        num_qubits: num_qubits,
        num_classical: num_classical,
        gates: empty_gates
    };
}

pub fn circuit_add_gate(c: &mut QuantumCircuit, g: CircuitGate) {
    let mut current_gates: List[CircuitGate] = c.gates;
    list_push(current_gates, g);
    c.gates = current_gates;
}

pub fn circuit_gate_count(c: &QuantumCircuit) -> Int {
    let gates_list: List[CircuitGate] = c.gates;
    return list_len(gates_list);
}

pub fn circuit_h(c: &mut QuantumCircuit, target: Int) {
    let g: CircuitGate = CircuitGate { gate_type: 3, target: target, control1: 0 - 1, control2: 0 - 1, param: 0.0 };
    circuit_add_gate(c, g);
}

pub fn circuit_x(c: &mut QuantumCircuit, target: Int) {
    let g: CircuitGate = CircuitGate { gate_type: 0, target: target, control1: 0 - 1, control2: 0 - 1, param: 0.0 };
    circuit_add_gate(c, g);
}

pub fn circuit_y(c: &mut QuantumCircuit, target: Int) {
    let g: CircuitGate = CircuitGate { gate_type: 1, target: target, control1: 0 - 1, control2: 0 - 1, param: 0.0 };
    circuit_add_gate(c, g);
}

pub fn circuit_z(c: &mut QuantumCircuit, target: Int) {
    let g: CircuitGate = CircuitGate { gate_type: 2, target: target, control1: 0 - 1, control2: 0 - 1, param: 0.0 };
    circuit_add_gate(c, g);
}

pub fn circuit_s(c: &mut QuantumCircuit, target: Int) {
    let g: CircuitGate = CircuitGate { gate_type: 4, target: target, control1: 0 - 1, control2: 0 - 1, param: 0.0 };
    circuit_add_gate(c, g);
}

pub fn circuit_t(c: &mut QuantumCircuit, target: Int) {
    let g: CircuitGate = CircuitGate { gate_type: 5, target: target, control1: 0 - 1, control2: 0 - 1, param: 0.0 };
    circuit_add_gate(c, g);
}

pub fn circuit_rx(c: &mut QuantumCircuit, target: Int, theta: Float) {
    let g: CircuitGate = CircuitGate { gate_type: 6, target: target, control1: 0 - 1, control2: 0 - 1, param: theta };
    circuit_add_gate(c, g);
}

pub fn circuit_ry(c: &mut QuantumCircuit, target: Int, theta: Float) {
    let g: CircuitGate = CircuitGate { gate_type: 7, target: target, control1: 0 - 1, control2: 0 - 1, param: theta };
    circuit_add_gate(c, g);
}

pub fn circuit_rz(c: &mut QuantumCircuit, target: Int, theta: Float) {
    let g: CircuitGate = CircuitGate { gate_type: 8, target: target, control1: 0 - 1, control2: 0 - 1, param: theta };
    circuit_add_gate(c, g);
}

pub fn circuit_phase(c: &mut QuantumCircuit, target: Int, phi: Float) {
    let g: CircuitGate = CircuitGate { gate_type: 13, target: target, control1: 0 - 1, control2: 0 - 1, param: phi };
    circuit_add_gate(c, g);
}

pub fn circuit_cnot(c: &mut QuantumCircuit, ctrl: Int, targ: Int) {
    let g: CircuitGate = CircuitGate { gate_type: 9, target: targ, control1: ctrl, control2: 0 - 1, param: 0.0 };
    circuit_add_gate(c, g);
}

pub fn circuit_cz(c: &mut QuantumCircuit, ctrl: Int, targ: Int) {
    let g: CircuitGate = CircuitGate { gate_type: 10, target: targ, control1: ctrl, control2: 0 - 1, param: 0.0 };
    circuit_add_gate(c, g);
}

pub fn circuit_swap(c: &mut QuantumCircuit, q1: Int, q2: Int) {
    let g: CircuitGate = CircuitGate { gate_type: 11, target: q2, control1: q1, control2: 0 - 1, param: 0.0 };
    circuit_add_gate(c, g);
}

pub fn circuit_toffoli(c: &mut QuantumCircuit, ctrl1: Int, ctrl2: Int, targ: Int) {
    let g: CircuitGate = CircuitGate { gate_type: 12, target: targ, control1: ctrl1, control2: ctrl2, param: 0.0 };
    circuit_add_gate(c, g);
}
