// # Complex 2x2 Unitary Matrix Operations
//
// Logline: Implements 2x2 complex matrix algebra, adjoints, determinants, unitarity verification, and qubit state transformations.
//
// Setup: Complex linear algebra primitives importing Complex and QubitState from qubit_state.oo.
//
// Beats:
//   1. Construct 2x2 complex matrices and standard identity and zero operators.
//   2. Implement matrix addition, scalar scaling, matrix multiplication, trace, and determinant.
//   3. Provide conjugate transpose (adjoint), unitarity verification, and state vector application.

import "./qubit_state.oo";

pub type Matrix2x2 = struct {
    m00: Complex,
    m01: Complex,
    m10: Complex,
    m11: Complex,
};

pub fn matrix2x2_new(m00: Complex, m01: Complex, m10: Complex, m11: Complex) -> Matrix2x2 {
    return Matrix2x2 {
        m00: m00,
        m01: m01,
        m10: m10,
        m11: m11,
    };
}

pub fn matrix_get_m00(m: &Matrix2x2) -> Complex {
    return m.m00;
}

pub fn matrix_get_m01(m: &Matrix2x2) -> Complex {
    return m.m01;
}

pub fn matrix_get_m10(m: &Matrix2x2) -> Complex {
    return m.m10;
}

pub fn matrix_get_m11(m: &Matrix2x2) -> Complex {
    return m.m11;
}

pub fn matrix2x2_identity() -> Matrix2x2 {
    return Matrix2x2 {
        m00: complex_one(),
        m01: complex_zero(),
        m10: complex_zero(),
        m11: complex_one(),
    };
}

pub fn matrix2x2_zero() -> Matrix2x2 {
    return Matrix2x2 {
        m00: complex_zero(),
        m01: complex_zero(),
        m10: complex_zero(),
        m11: complex_zero(),
    };
}

pub fn matrix2x2_add(a: &Matrix2x2, b: &Matrix2x2) -> Matrix2x2 {
    return Matrix2x2 {
        m00: complex_add(a.m00, b.m00),
        m01: complex_add(a.m01, b.m01),
        m10: complex_add(a.m10, b.m10),
        m11: complex_add(a.m11, b.m11),
    };
}

pub fn matrix2x2_scale(a: &Matrix2x2, s: Float) -> Matrix2x2 {
    return Matrix2x2 {
        m00: complex_scale(a.m00, s),
        m01: complex_scale(a.m01, s),
        m10: complex_scale(a.m10, s),
        m11: complex_scale(a.m11, s),
    };
}

pub fn matrix2x2_mul(a: &Matrix2x2, b: &Matrix2x2) -> Matrix2x2 {
    let a00: Complex = a.m00;
    let a01: Complex = a.m01;
    let a10: Complex = a.m10;
    let a11: Complex = a.m11;

    let b00: Complex = b.m00;
    let b01: Complex = b.m01;
    let b10: Complex = b.m10;
    let b11: Complex = b.m11;

    let c00: Complex = complex_add(complex_mul(a00, b00), complex_mul(a01, b10));
    let c01: Complex = complex_add(complex_mul(a00, b01), complex_mul(a01, b11));
    let c10: Complex = complex_add(complex_mul(a10, b00), complex_mul(a11, b10));
    let c11: Complex = complex_add(complex_mul(a10, b01), complex_mul(a11, b11));
    return Matrix2x2 {
        m00: c00,
        m01: c01,
        m10: c10,
        m11: c11,
    };
}

pub fn matrix2x2_adjoint(a: &Matrix2x2) -> Matrix2x2 {
    return Matrix2x2 {
        m00: complex_conj(a.m00),
        m01: complex_conj(a.m10),
        m10: complex_conj(a.m01),
        m11: complex_conj(a.m11),
    };
}

pub fn matrix2x2_trace(a: &Matrix2x2) -> Complex {
    return complex_add(a.m00, a.m11);
}

pub fn matrix2x2_det(a: &Matrix2x2) -> Complex {
    let p1: Complex = complex_mul(a.m00, a.m11);
    let p2: Complex = complex_mul(a.m01, a.m10);
    return complex_sub(p1, p2);
}

pub fn matrix2x2_is_unitary(a: &Matrix2x2, eps: Float) -> Bool {
    let adj: Matrix2x2 = matrix2x2_adjoint(a);
    let prod: Matrix2x2 = matrix2x2_mul(a, &adj);
    
    let diff00: Complex = complex_sub(prod.m00, complex_one());
    let diff01: Complex = prod.m01;
    let diff10: Complex = prod.m10;
    let diff11: Complex = complex_sub(prod.m11, complex_one());
    
    if complex_abs(diff00) > eps { return false; }
    if complex_abs(diff01) > eps { return false; }
    if complex_abs(diff10) > eps { return false; }
    if complex_abs(diff11) > eps { return false; }
    return true;
}

pub fn matrix2x2_apply(m: &Matrix2x2, q: &QubitState) -> QubitState {
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);
    let new_alpha: Complex = complex_add(complex_mul(m.m00, a), complex_mul(m.m01, b));
    let new_beta: Complex = complex_add(complex_mul(m.m10, a), complex_mul(m.m11, b));
    return QubitState {
        alpha: new_alpha,
        beta: new_beta,
    };
}
