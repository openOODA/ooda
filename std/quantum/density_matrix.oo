// # Single-Qubit Density Matrix & Mixed State Formalism
//
// Logline: Implements 2x2 density matrices, pure state outer products, mixed ensembles, purity calculations, and unitary Kraus evolution.
//
// Setup: Statistical density operator representation importing qubit_state.oo and complex_matrix2x2.oo.
//
// Beats:
//   1. Construct DensityMatrix2x2 from pure statevectors and maximally mixed ensembles.
//   2. Compute trace, purity Tr(rho^2), and Bloch vector coordinates for mixed states.
//   3. Implement unitary channel transformation rho' = U rho U^dagger.

import "./qubit_state.oo";
import "./complex_matrix2x2.oo";

pub type DensityMatrix2x2 = struct {
    rho00: Complex,
    rho01: Complex,
    rho10: Complex,
    rho11: Complex,
};

pub fn density_get_00(rho: &DensityMatrix2x2) -> Complex {
    return rho.rho00;
}

pub fn density_get_01(rho: &DensityMatrix2x2) -> Complex {
    return rho.rho01;
}

pub fn density_get_10(rho: &DensityMatrix2x2) -> Complex {
    return rho.rho10;
}

pub fn density_get_11(rho: &DensityMatrix2x2) -> Complex {
    return rho.rho11;
}

pub fn density_from_qubit(q: &QubitState) -> DensityMatrix2x2 {
    let a: Complex = qubit_get_alpha(q);
    let b: Complex = qubit_get_beta(q);
    
    let a_conj: Complex = complex_conj(a);
    let b_conj: Complex = complex_conj(b);
    
    return DensityMatrix2x2 {
        rho00: complex_mul(a, a_conj),
        rho01: complex_mul(a, b_conj),
        rho10: complex_mul(b, a_conj),
        rho11: complex_mul(b, b_conj),
    };
}

pub fn density_maximally_mixed() -> DensityMatrix2x2 {
    let half: Complex = Complex { real: 0.5, imag: 0.0 };
    return DensityMatrix2x2 {
        rho00: half,
        rho01: complex_zero(),
        rho10: complex_zero(),
        rho11: half,
    };
}

pub fn density_trace(rho: &DensityMatrix2x2) -> Complex {
    let r00: Complex = density_get_00(rho);
    let r11: Complex = density_get_11(rho);
    return complex_add(r00, r11);
}

pub fn density_purity(rho: &DensityMatrix2x2) -> Float {
    let r00: Complex = density_get_00(rho);
    let r01: Complex = density_get_01(rho);
    let r10: Complex = density_get_10(rho);
    let r11: Complex = density_get_11(rho);

    // Tr(rho^2) = rho00^2 + rho01*rho10 + rho10*rho01 + rho11^2
    let term1: Complex = complex_mul(r00, r00);
    let term2: Complex = complex_mul(r01, r10);
    let term3: Complex = complex_mul(r10, r01);
    let term4: Complex = complex_mul(r11, r11);

    let sum1: Complex = complex_add(term1, term2);
    let sum2: Complex = complex_add(sum1, term3);
    let sum3: Complex = complex_add(sum2, term4);
    return sum3.real;
}

pub fn density_apply_gate(rho: &DensityMatrix2x2, m: &Matrix2x2) -> DensityMatrix2x2 {
    // rho' = M * rho * M^dagger
    let r00: Complex = density_get_00(rho);
    let r01: Complex = density_get_01(rho);
    let r10: Complex = density_get_10(rho);
    let r11: Complex = density_get_11(rho);

    let rho_mat: Matrix2x2 = Matrix2x2 {
        m00: r00,
        m01: r01,
        m10: r10,
        m11: r11,
    };

    let m_adj: Matrix2x2 = matrix2x2_adjoint(m);
    let m_rho: Matrix2x2 = matrix2x2_mul(m, &rho_mat);
    let final_mat: Matrix2x2 = matrix2x2_mul(&m_rho, &m_adj);

    return DensityMatrix2x2 {
        rho00: matrix_get_m00(&final_mat),
        rho01: matrix_get_m01(&final_mat),
        rho10: matrix_get_m10(&final_mat),
        rho11: matrix_get_m11(&final_mat),
    };
}

pub fn density_bloch_vector(rho: &DensityMatrix2x2) -> List[Float] {
    let r00: Complex = density_get_00(rho);
    let r01: Complex = density_get_01(rho);
    let r11: Complex = density_get_11(rho);

    let bx: Float = 2.0 * r01.real;
    let by: Float = 0.0 - (2.0 * r01.imag);
    let bz: Float = r00.real - r11.real;

    let mut coords: List[Float] = list_new();
    list_push(coords, bx);
    list_push(coords, by);
    list_push(coords, bz);
    return coords;
}
