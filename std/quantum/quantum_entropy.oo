// # Quantum Entropy & Entanglement Measures
//
// Logline: Calculates von Neumann entropy, linear entropy, Bloch sphere purity radius, and entanglement concurrence.
//
// Setup: Quantum information metrics importing qubit_state.oo, density_matrix.oo, and complex_matrix2x2.oo.
//
// Beats:
//   1. Compute linear entropy S_L = 2(1 - Tr(rho^2)) for 2x2 density matrices.
//   2. Compute von Neumann entropy S(rho) = -Tr(rho log2 rho) via Bloch eigenvalues.
//   3. Compute subsystem entanglement entropy and bipartite concurrence metrics.

import "./qubit_state.oo";
import "./density_matrix.oo";
import "./complex_matrix2x2.oo";

pub fn math_ln2() -> Float {
    return 0.6931471805599453;
}

pub fn math_log2(x: Float) -> Float {
    if x <= 0.0 {
        return 0.0;
    }
    return ln(x) / math_ln2();
}

pub fn linear_entropy(rho: &DensityMatrix2x2) -> Float {
    let purity: Float = density_purity(rho);
    let diff: Float = 1.0 - purity;
    return 2.0 * diff;
}

pub fn bloch_radius(rho: &DensityMatrix2x2) -> Float {
    let purity: Float = density_purity(rho);
    let term: Float = (2.0 * purity) - 1.0;
    if term <= 0.0 {
        return 0.0;
    }
    return sqrt(term);
}

pub fn von_neumann_entropy(rho: &DensityMatrix2x2) -> Float {
    let r: Float = bloch_radius(rho);
    if r >= 0.99999 {
        // Pure state: S = 0
        return 0.0;
    }
    if r <= 0.00001 {
        // Maximally mixed state: S = 1
        return 1.0;
    }
    let lambda1: Float = (1.0 + r) * 0.5;
    let lambda2: Float = (1.0 - r) * 0.5;

    let term1: Float = 0.0 - (lambda1 * math_log2(lambda1));
    let term2: Float = 0.0 - (lambda2 * math_log2(lambda2));
    return term1 + term2;
}

pub fn entanglement_entropy_from_purity(purity: Float) -> Float {
    let term: Float = (2.0 * purity) - 1.0;
    let r: Float = if term <= 0.0 { 0.0 } else { sqrt(term) };
    if r >= 0.99999 {
        return 0.0;
    }
    let l1: Float = (1.0 + r) * 0.5;
    let l2: Float = (1.0 - r) * 0.5;
    return (0.0 - (l1 * math_log2(l1))) - (l2 * math_log2(l2));
}

pub fn concurrence_from_purity(purity: Float) -> Float {
    let diff: Float = 1.0 - purity;
    if diff <= 0.0 {
        return 0.0;
    }
    return sqrt(2.0 * diff);
}
