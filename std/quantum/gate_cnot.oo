// # Controlled-NOT & Two-Qubit Entangling Gates
//
// Logline: Implements CNOT, CZ, CY, and SWAP gates on multi-qubit registers for quantum entanglement generation.
//
// Setup: Two-qubit gate operations modifying QuantumRegister statevectors importing qubit_state.oo and quantum_register.oo.
//
// Beats:
//   1. Implement bitmask-based CNOT (CX) gate targeting arbitrary register qubit pairs.
//   2. Implement Controlled-Z (CZ), Controlled-Y (CY), and SWAP permutations.
//   3. Provide helper to generate canonical Bell states (|Phi+> = (|00> + |11>)/sqrt(2)).

import "./qubit_state.oo";
import "./quantum_register.oo";

pub fn apply_cnot(reg: &mut QuantumRegister, ctrl: Int, targ: Int) {
    let ctrl_mask: Int = int_pow2(ctrl);
    let targ_mask: Int = int_pow2(targ);
    let n_states: Int = reg.num_states;
    let old_amps: List[Complex] = reg.amplitudes;
    let mut new_amps: List[Complex] = list_new();

    let mut i: Int = 0;
    while i < n_states {
        let ctrl_bit: Int = (i / ctrl_mask) % 2;
        if ctrl_bit == 1 {
            // Flip target bit to find swapped amplitude index
            let targ_bit: Int = (i / targ_mask) % 2;
            let pair_idx: Int = if targ_bit == 0 {
                i + targ_mask
            } else {
                i - targ_mask
            };
            let amp: Complex = list_get(old_amps, pair_idx);
            list_push(new_amps, amp);
        } else {
            let amp: Complex = list_get(old_amps, i);
            list_push(new_amps, amp);
        }
        i = i + 1;
    }
    reg.amplitudes = new_amps;
}

pub fn apply_cz(reg: &mut QuantumRegister, ctrl: Int, targ: Int) {
    let ctrl_mask: Int = int_pow2(ctrl);
    let targ_mask: Int = int_pow2(targ);
    let n_states: Int = reg.num_states;
    let old_amps: List[Complex] = reg.amplitudes;
    let mut new_amps: List[Complex] = list_new();

    let mut i: Int = 0;
    while i < n_states {
        let ctrl_bit: Int = (i / ctrl_mask) % 2;
        let targ_bit: Int = (i / targ_mask) % 2;
        let amp: Complex = list_get(old_amps, i);
        if ctrl_bit == 1 && targ_bit == 1 {
            // Phase flip by -1
            let neg_amp: Complex = complex_scale(amp, 0.0 - 1.0);
            list_push(new_amps, neg_amp);
        } else {
            list_push(new_amps, amp);
        }
        i = i + 1;
    }
    reg.amplitudes = new_amps;
}

pub fn apply_cy(reg: &mut QuantumRegister, ctrl: Int, targ: Int) {
    let ctrl_mask: Int = int_pow2(ctrl);
    let targ_mask: Int = int_pow2(targ);
    let n_states: Int = reg.num_states;
    let old_amps: List[Complex] = reg.amplitudes;
    let mut new_amps: List[Complex] = list_new();
    let neg_i: Complex = Complex { real: 0.0, imag: 0.0 - 1.0 };

    let mut i: Int = 0;
    while i < n_states {
        let ctrl_bit: Int = (i / ctrl_mask) % 2;
        if ctrl_bit == 1 {
            let targ_bit: Int = (i / targ_mask) % 2;
            if targ_bit == 0 {
                // target 0 receives -i * amp(target=1)
                let pair_idx: Int = i + targ_mask;
                let amp1: Complex = list_get(old_amps, pair_idx);
                list_push(new_amps, complex_mul(neg_i, amp1));
            } else {
                // target 1 receives i * amp(target=0)
                let pair_idx: Int = i - targ_mask;
                let amp0: Complex = list_get(old_amps, pair_idx);
                list_push(new_amps, complex_mul(complex_i(), amp0));
            }
        } else {
            list_push(new_amps, list_get(old_amps, i));
        }
        i = i + 1;
    }
    reg.amplitudes = new_amps;
}

pub fn apply_swap(reg: &mut QuantumRegister, q1: Int, q2: Int) {
    if q1 == q2 {
        return;
    }
    let m1: Int = int_pow2(q1);
    let m2: Int = int_pow2(q2);
    let n_states: Int = reg.num_states;
    let old_amps: List[Complex] = reg.amplitudes;
    let mut new_amps: List[Complex] = list_new();

    let mut i: Int = 0;
    while i < n_states {
        let b1: Int = (i / m1) % 2;
        let b2: Int = (i / m2) % 2;
        if b1 != b2 {
            // Swap bit 1 and bit 2
            let swapped_idx: Int = (i - (b1 * m1) - (b2 * m2)) + (b2 * m1) + (b1 * m2);
            list_push(new_amps, list_get(old_amps, swapped_idx));
        } else {
            list_push(new_amps, list_get(old_amps, i));
        }
        i = i + 1;
    }
    reg.amplitudes = new_amps;
}
