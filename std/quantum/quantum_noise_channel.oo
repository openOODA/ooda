// # Quantum Noise Channels & Open Quantum Systems
//
// Logline: Simulates depolarizing, bit-flip, phase-flip, amplitude damping, and dephasing quantum noise channels.
//
// Setup: Kraus operator representations importing qubit_state.oo, density_matrix.oo, and complex_matrix2x2.oo.
//
// Beats:
//   1. Implement Pauli noise channels (bit-flip, phase-flip, and depolarizing).
//   2. Implement non-unitary energy relaxation (amplitude damping channel with decay rate gamma).
//   3. Implement pure phase dephasing channels preserving diagonal populations.

import "./qubit_state.oo";
import "./density_matrix.oo";
import "./complex_matrix2x2.oo";

pub fn channel_bit_flip(rho: &DensityMatrix2x2, p: Float) -> DensityMatrix2x2 {
    let r00: Complex = density_get_00(rho);
    let r01: Complex = density_get_01(rho);
    let r10: Complex = density_get_10(rho);
    let r11: Complex = density_get_11(rho);

    // rho' = (1-p) rho + p (X rho X)
    // X rho X swaps diagonal and off-diagonal: [[rho11, rho10], [rho01, rho00]]
    let one_minus_p: Float = 1.0 - p;
    let new_00: Complex = complex_add(complex_scale(r00, one_minus_p), complex_scale(r11, p));
    let new_01: Complex = complex_add(complex_scale(r01, one_minus_p), complex_scale(r10, p));
    let new_10: Complex = complex_add(complex_scale(r10, one_minus_p), complex_scale(r01, p));
    let new_11: Complex = complex_add(complex_scale(r11, one_minus_p), complex_scale(r00, p));

    return DensityMatrix2x2 {
        rho00: new_00,
        rho01: new_01,
        rho10: new_10,
        rho11: new_11
    };
}

pub fn channel_phase_flip(rho: &DensityMatrix2x2, p: Float) -> DensityMatrix2x2 {
    let r00: Complex = density_get_00(rho);
    let r01: Complex = density_get_01(rho);
    let r10: Complex = density_get_10(rho);
    let r11: Complex = density_get_11(rho);

    // rho' = (1-p) rho + p (Z rho Z)
    // Z rho Z: [[rho00, -rho01], [-rho10, rho11]]
    let factor: Float = 1.0 - (2.0 * p);
    let new_01: Complex = complex_scale(r01, factor);
    let new_10: Complex = complex_scale(r10, factor);

    return DensityMatrix2x2 {
        rho00: r00,
        rho01: new_01,
        rho10: new_10,
        rho11: r11
    };
}

pub fn channel_depolarizing(rho: &DensityMatrix2x2, p: Float) -> DensityMatrix2x2 {
    let r00: Complex = density_get_00(rho);
    let r01: Complex = density_get_01(rho);
    let r10: Complex = density_get_10(rho);
    let r11: Complex = density_get_11(rho);

    // rho' = (1 - p) rho + p * (I / 2)
    let one_minus_p: Float = 1.0 - p;
    let half_p: Float = p * 0.5;
    let half_p_c: Complex = Complex { real: half_p, imag: 0.0 };

    let new_00: Complex = complex_add(complex_scale(r00, one_minus_p), half_p_c);
    let new_01: Complex = complex_scale(r01, one_minus_p);
    let new_10: Complex = complex_scale(r10, one_minus_p);
    let new_11: Complex = complex_add(complex_scale(r11, one_minus_p), half_p_c);

    return DensityMatrix2x2 {
        rho00: new_00,
        rho01: new_01,
        rho10: new_10,
        rho11: new_11
    };
}

pub fn channel_amplitude_damping(rho: &DensityMatrix2x2, gamma: Float) -> DensityMatrix2x2 {
    let r00: Complex = density_get_00(rho);
    let r01: Complex = density_get_01(rho);
    let r10: Complex = density_get_10(rho);
    let r11: Complex = density_get_11(rho);

    // rho'00 = rho00 + gamma * rho11
    // rho'01 = sqrt(1-gamma) * rho01
    // rho'10 = sqrt(1-gamma) * rho10
    // rho'11 = (1-gamma) * rho11
    let scale_off: Float = sqrt(1.0 - gamma);
    let one_minus_gamma: Float = 1.0 - gamma;

    let new_00: Complex = complex_add(r00, complex_scale(r11, gamma));
    let new_01: Complex = complex_scale(r01, scale_off);
    let new_10: Complex = complex_scale(r10, scale_off);
    let new_11: Complex = complex_scale(r11, one_minus_gamma);

    return DensityMatrix2x2 {
        rho00: new_00,
        rho01: new_01,
        rho10: new_10,
        rho11: new_11
    };
}

pub fn channel_phase_damping(rho: &DensityMatrix2x2, lambda_val: Float) -> DensityMatrix2x2 {
    let r00: Complex = density_get_00(rho);
    let r01: Complex = density_get_01(rho);
    let r10: Complex = density_get_10(rho);
    let r11: Complex = density_get_11(rho);

    let scale_off: Float = sqrt(1.0 - lambda_val);
    let new_01: Complex = complex_scale(r01, scale_off);
    let new_10: Complex = complex_scale(r10, scale_off);

    return DensityMatrix2x2 {
        rho00: r00,
        rho01: new_01,
        rho10: new_10,
        rho11: r11
    };
}
