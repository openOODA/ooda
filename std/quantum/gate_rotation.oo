// # Single-Qubit Parameterized Rotation Gates
//
// Logline: Implements continuous unitary rotations Rx(theta), Ry(theta), Rz(theta), PhaseShift(phi), and universal U3 matrices.
//
// Setup: Parameterized quantum gate generators importing qubit_state.oo and complex_matrix2x2.oo.
//
// Beats:
//   1. Construct 2x2 complex unitary rotation matrices Rx, Ry, Rz using trigonometric functions.
//   2. Construct universal single-qubit U3(theta, phi, lambda) and PhaseShift(phi) matrices.
//   3. Apply arbitrary continuous rotations directly to QubitState statevectors.

import "./qubit_state.oo";
import "./complex_matrix2x2.oo";

pub fn rot_x_matrix(theta: Float) -> Matrix2x2 {
    let half_th: Float = theta * 0.5;
    let c: Float = cos(half_th);
    let s: Float = sin(half_th);
    let neg_s: Float = 0.0 - s;
    return Matrix2x2 {
        m00: Complex { real: c, imag: 0.0 },
        m01: Complex { real: 0.0, imag: neg_s },
        m10: Complex { real: 0.0, imag: neg_s },
        m11: Complex { real: c, imag: 0.0 },
    };
}

pub fn rot_y_matrix(theta: Float) -> Matrix2x2 {
    let half_th: Float = theta * 0.5;
    let c: Float = cos(half_th);
    let s: Float = sin(half_th);
    let neg_s: Float = 0.0 - s;
    return Matrix2x2 {
        m00: Complex { real: c, imag: 0.0 },
        m01: Complex { real: neg_s, imag: 0.0 },
        m10: Complex { real: s, imag: 0.0 },
        m11: Complex { real: c, imag: 0.0 },
    };
}

pub fn rot_z_matrix(theta: Float) -> Matrix2x2 {
    let half_th: Float = theta * 0.5;
    let c: Float = cos(half_th);
    let s: Float = sin(half_th);
    let neg_s: Float = 0.0 - s;
    return Matrix2x2 {
        m00: Complex { real: c, imag: neg_s },
        m01: complex_zero(),
        m10: complex_zero(),
        m11: Complex { real: c, imag: s },
    };
}

pub fn phase_shift_matrix(phi: Float) -> Matrix2x2 {
    let c: Float = cos(phi);
    let s: Float = sin(phi);
    return Matrix2x2 {
        m00: complex_one(),
        m01: complex_zero(),
        m10: complex_zero(),
        m11: Complex { real: c, imag: s },
    };
}

pub fn u3_matrix(theta: Float, phi: Float, lambda_val: Float) -> Matrix2x2 {
    let half_th: Float = theta * 0.5;
    let c: Float = cos(half_th);
    let s: Float = sin(half_th);
    let neg_s: Float = 0.0 - s;
    
    // e^(i * lambda)
    let elam: Complex = Complex { real: cos(lambda_val), imag: sin(lambda_val) };
    // e^(i * phi)
    let ephi: Complex = Complex { real: cos(phi), imag: sin(phi) };
    // e^(i * (phi + lambda))
    let phi_plus_lam: Float = phi + lambda_val;
    let ephilam: Complex = Complex { real: cos(phi_plus_lam), imag: sin(phi_plus_lam) };
    
    let m00_val: Complex = Complex { real: c, imag: 0.0 };
    let m01_val: Complex = complex_scale(elam, neg_s);
    let m10_val: Complex = complex_scale(ephi, s);
    let m11_val: Complex = complex_scale(ephilam, c);
    
    return Matrix2x2 {
        m00: m00_val,
        m01: m01_val,
        m10: m10_val,
        m11: m11_val,
    };
}

pub fn apply_rx(q: &QubitState, theta: Float) -> QubitState {
    let m: Matrix2x2 = rot_x_matrix(theta);
    return matrix2x2_apply(&m, q);
}

pub fn apply_ry(q: &QubitState, theta: Float) -> QubitState {
    let m: Matrix2x2 = rot_y_matrix(theta);
    return matrix2x2_apply(&m, q);
}

pub fn apply_rz(q: &QubitState, theta: Float) -> QubitState {
    let m: Matrix2x2 = rot_z_matrix(theta);
    return matrix2x2_apply(&m, q);
}

pub fn apply_phase_shift(q: &QubitState, phi: Float) -> QubitState {
    let m: Matrix2x2 = phase_shift_matrix(phi);
    return matrix2x2_apply(&m, q);
}
