// # Confidential Hardware Enclave Types & Capability Descriptors
//
// Logline: Platform descriptors, capability token permissions, and measurement structures for AMD SEV-SNP, Intel SGX, and AWS Nitro.
//
// Setup: Sovereign capability token models gating confidential hardware isolation boundaries.
//
// Beats:
//   1. Define platform constants (SEV-SNP, Intel SGX, AWS Nitro, Measured Isolate).
//   2. Define permission flags (Attest, Seal, Unseal, Vsock).
//   3. Provide EnclaveCap constructors and permission attenuation routines.
//   4. Define measurement and policy descriptor records.
// RULES.oot 1.4: Pure data capability types.
// RULES.oot 1.7: Strictly under 256 lines.

pub type EnclaveCap = struct {
    token_id: Int,
    platform: Int,
    permissions: Int,
    vmpl_level: Int,
    is_valid: Bool
};

pub type EnclaveMeasurement = struct {
    platform: Int,
    measurement_hex: String,
    signer_hex: String,
    svn: Int,
    is_debug: Bool
};

pub fn enclave_platform_sev_snp() -> Int { return 1; }
pub fn enclave_platform_intel_sgx() -> Int { return 2; }
pub fn enclave_platform_aws_nitro() -> Int { return 3; }
pub fn enclave_platform_isolate() -> Int { return 4; }

pub fn enclave_perm_attest() -> Int { return 1; }
pub fn enclave_perm_seal() -> Int { return 2; }
pub fn enclave_perm_unseal() -> Int { return 4; }
pub fn enclave_perm_vsock() -> Int { return 8; }
pub fn enclave_perm_all() -> Int { return 15; }

pub fn enclave_cap_new(platform: Int, perms: Int, vmpl: Int) -> EnclaveCap {
    return EnclaveCap {
        token_id: 1001,
        platform: platform,
        permissions: perms,
        vmpl_level: vmpl,
        is_valid: true
    };
}

pub fn enclave_cap_has_permission(cap: EnclaveCap, perm: Int) -> Bool {
    let valid: Bool = cap.is_valid;
    if !valid { return false; }
    let mask: Int = cap.permissions;
    return (mask / perm) % 2 == 1;
}

pub fn enclave_cap_attenuate(cap: EnclaveCap, new_perms: Int) -> Result[EnclaveCap, String] {
    let valid: Bool = cap.is_valid;
    if !valid { return Err("Invalid parent enclave capability"); }
    let mask: Int = cap.permissions;
    if new_perms > mask {
        return Err("Cannot elevate permissions during capability attenuation");
    }
    return Ok(EnclaveCap {
        token_id: cap.token_id + 1,
        platform: cap.platform,
        permissions: new_perms,
        vmpl_level: cap.vmpl_level,
        is_valid: true
    });
}

pub fn enclave_platform_name(platform: Int) -> String {
    if platform == 1 { return "AMD_SEV_SNP"; }
    if platform == 2 { return "INTEL_SGX"; }
    if platform == 3 { return "AWS_NITRO"; }
    if platform == 4 { return "MEASURED_ISOLATE"; }
    return "UNKNOWN_PLATFORM";
}
