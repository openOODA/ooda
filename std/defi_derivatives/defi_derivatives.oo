pub fn defi_derivatives_version() -> String {
    return "1.0.0";
}

pub fn defi_derivatives_module_count() -> Int {
    return 50;
}

pub fn defi_derivatives_sabr_default() -> SabrParameters {
    return sabr_params_new(0.60, 0.70, -0.30, 0.80);
}

pub fn defi_derivatives_garch_default() -> Garch11Params {
    return garch11_params_crypto_default();
}

pub fn defi_derivatives_funding_config_default() -> FundingRateConfig {
    return funding_config_default();
}

pub fn defi_derivatives_vamm_default() -> VammPool {
    return vamm_pool_new("ETH-PERP", 1000.0, 3000000.0, 0.001);
}

pub fn defi_derivatives_black76_contract_default() -> Black76Contract {
    return black76_contract_new(3000.0, 3000.0, 0.25, 0.05, 0.60, true);
}

pub fn defi_derivatives_mock_state_default() -> MockDerivativesMarketState {
    return mock_derivatives_state_default();
}
