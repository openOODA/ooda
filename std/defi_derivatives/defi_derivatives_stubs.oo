// # DeFi Derivatives Testing Stubs & Mock Fixtures
//
// Logline: Provides deterministic mock price feeds, synthetic SABR volatility surfaces, and perpetual market fixtures for automated test suites.
//
// Setup: Pure testing fixture module for perpetual futures, option pricers, and DeFi derivatives test suites.
//
// Beats:
//   1. Define MockPerpFeed, MockDerivativesMarketState, and MockSabrVolFixture structures.
//   2. Generate deterministic price ticks and simulated funding rate observations.
//   3. Provide pre-configured benchmark volatility smile calibration datasets for unit verification.

pub type MockPerpFeed = struct {
    market_symbol: String,
    base_index_price: Float,
    base_mark_price: Float,
    tick_count: Int
};

pub type MockSabrVolFixture = struct {
    asset_symbol: String,
    forward_price: Float,
    expiry_years: Float,
    alpha: Float,
    beta: Float,
    rho: Float,
    nu: Float,
    test_strikes: List[Float],
    expected_implied_vols: List[Float]
};

pub type MockDerivativesMarketState = struct {
    eth_spot_price: Float,
    btc_spot_price: Float,
    eth_perp_funding_8h: Float,
    insurance_fund_usd: Float,
    total_open_interest_usd: Float
};

pub fn mock_perp_feed_new(symbol: String, index_px: Float, mark_px: Float) -> MockPerpFeed {
    return MockPerpFeed {
        market_symbol: symbol,
        base_index_price: index_px,
        base_mark_price: mark_px,
        tick_count: 0
    };
}

pub fn mock_generate_perp_tick(feed: &mut MockPerpFeed, step_seed: Int) -> Float {
    (feed).tick_count = (feed).tick_count + 1;
    let mut step_f: Float = 0.0;
    let mut rem_s: Int = (step_seed * 13 + (feed).tick_count) % 21 - 10;
    let is_neg: Bool = rem_s < 0;
    if is_neg { rem_s = 0 - rem_s; }
    while rem_s > 0 { step_f = step_f + 1.0; rem_s = rem_s - 1; }
    if is_neg { step_f = 0.0 - step_f; }

    return (feed).base_mark_price + (step_f * 0.5);
}

pub fn mock_sabr_fixture_eth() -> MockSabrVolFixture {
    let mut strikes: List[Float] = list_new();
    strikes = list_push(strikes, 2500.0);
    strikes = list_push(strikes, 2800.0);
    strikes = list_push(strikes, 3000.0);
    strikes = list_push(strikes, 3200.0);
    strikes = list_push(strikes, 3500.0);

    let mut vols: List[Float] = list_new();
    vols = list_push(vols, 0.72);
    vols = list_push(vols, 0.66);
    vols = list_push(vols, 0.63);
    vols = list_push(vols, 0.62);
    vols = list_push(vols, 0.64);

    return MockSabrVolFixture {
        asset_symbol: "ETH-USD-OPT",
        forward_price: 3000.0,
        expiry_years: 0.25,
        alpha: 0.63,
        beta: 0.70,
        rho: -0.35,
        nu: 0.85,
        test_strikes: strikes,
        expected_implied_vols: vols
    };
}

pub fn mock_derivatives_state_default() -> MockDerivativesMarketState {
    return MockDerivativesMarketState {
        eth_spot_price: 3000.0,
        btc_spot_price: 65000.0,
        eth_perp_funding_8h: 0.0001, // 0.01%
        insurance_fund_usd: 50000000.0,
        total_open_interest_usd: 1200000000.0
    };
}

pub fn mock_is_test_environment() -> Bool {
    return true;
}
