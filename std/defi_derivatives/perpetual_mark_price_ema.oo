// # Perpetual Fair Mark Price & EMA Basis Engine
//
// Logline: Calculates fair mark prices using order book impact midpoints, exponential moving average basis smoothing, and collar clamping bands.
//
// Setup: Pure quantitative finance module mitigating market manipulation and unnecessary liquidations in perpetual futures.
//
// Beats:
//   1. Define OrderBookImpact, MarkPriceEmaConfig, and MarkPriceResult structures.
//   2. Compute order book impact mid-price based on notional depth thresholds.
//   3. Smooth basis spread via exponential moving average (EMA) and clamp mark price within strict safety corridors.

pub type OrderBookImpact = struct {
    impact_bid_price: Float,
    impact_ask_price: Float,
    target_notional_usd: Float,
};

pub type MarkPriceEmaConfig = struct {
    ema_alpha: Float,          // Smoothing factor, e.g. 0.05
    max_mark_deviation_pct: Float, // Safety band, e.g. 0.05 (5%)
};

pub type MarkPriceResult = struct {
    computed_mark_price: Float,
    smoothed_basis_usd: Float,
    impact_mid_price: Float,
    is_clamped: Bool,
};

pub fn mark_price_config_default() -> MarkPriceEmaConfig {
    return MarkPriceEmaConfig {
        ema_alpha: 0.05,
        max_mark_deviation_pct: 0.05, // 5% collar
    };
}

pub fn calc_fair_mark_price(
    index_px: Float,
    prev_ema_basis: Float,
    ob: &OrderBookImpact,
    cfg: &MarkPriceEmaConfig
) -> MarkPriceResult {
    let impact_mid: Float = ((ob).impact_bid_price + (ob).impact_ask_price) / 2.0;
    let instant_basis: Float = impact_mid - index_px;

    let updated_basis: Float = ((cfg).ema_alpha * instant_basis) + ((1.0 - (cfg).ema_alpha) * prev_ema_basis);
    let raw_mark: Float = index_px + updated_basis;

    let max_mark: Float = index_px * (1.0 + (cfg).max_mark_deviation_pct);
    let min_mark: Float = index_px * (1.0 - (cfg).max_mark_deviation_pct);

    let mut final_mark: Float = raw_mark;
    let mut clamped: Bool = false;

    if final_mark > max_mark {
        final_mark = max_mark;
        clamped = true;
    }
    if final_mark < min_mark {
        final_mark = min_mark;
        clamped = true;
    }

    return MarkPriceResult {
        computed_mark_price: final_mark,
        smoothed_basis_usd: updated_basis,
        impact_mid_price: impact_mid,
        is_clamped: clamped,
    };
}
