// # SABR Stochastic Volatility Smile Model
//
// Logline: Hagan (2002) asymptotic expansion formula for SABR implied volatility smile calibration across strikes and tenors.
//
// Setup: Pure quantitative finance module implementing SABR model parameters (alpha, beta, rho, nu) for volatility surface fitting.
//
// Beats:
//   1. Define SabrParameters, SabrCalibrationPoint, and SabrSmileSlice structures.
//   2. Compute Hagan 2002 closed-form asymptotic Black implied volatility for ATM and OTM strikes.
//   3. Generate calibrated volatility smile curves and calculate smile skew / curvature.

pub type SabrParameters = struct {
    alpha: Float, // Initial volatility
    beta: Float,  // CEV exponent (0.0 <= beta <= 1.0)
    rho: Float,   // Correlation between forward and vol (-1.0 < rho < 1.0)
    nu: Float    // Volatility of volatility (vol-of-vol >= 0.0)
};

pub type SabrCalibrationPoint = struct {
    strike: Float,
    market_implied_vol: Float,
    model_implied_vol: Float,
    weight: Float
};

pub type SabrSmileSlice = struct {
    forward_price: Float,
    expiry_years: Float,
    params: SabrParameters,
    points: List[SabrCalibrationPoint],
    atm_volatility: Float
};

pub fn sabr_params_new(alpha: Float, beta: Float, rho: Float, nu: Float) -> SabrParameters {
    return SabrParameters {
        alpha: alpha,
        beta: beta,
        rho: rho,
        nu: nu
    };
}

pub fn sabr_atm_volatility(
    f: Float,
    t: Float,
    params: &SabrParameters
) -> Float {
    if f <= 0.0 || t <= 0.0 {
        return 0.0;
    }
    let one_minus_beta: Float = 1.0 - (params).beta;
    let f_pow: Float = exp(one_minus_beta * ln(f));
    let term1: Float = (params).alpha / f_pow;

    let a_part: Float = (one_minus_beta * one_minus_beta * (params).alpha * (params).alpha) / (24.0 * f_pow * f_pow);
    let b_part: Float = ((params).rho * (params).beta * (params).nu * (params).alpha) / (4.0 * f_pow);
    let c_part: Float = ((2.0 - (3.0 * (params).rho * (params).rho)) * (params).nu * (params).nu) / 24.0;

    let term2: Float = 1.0 + ((a_part + b_part + c_part) * t);
    return term1 * term2;
}

pub fn sabr_implied_volatility(
    f: Float,
    k: Float,
    t: Float,
    params: &SabrParameters
) -> Float {
    if f <= 0.0 || k <= 0.0 || t <= 0.0 {
        return 0.0;
    }
    let diff: Float = f - k;
    let mut abs_diff: Float = diff;
    if abs_diff < 0.0 {
        abs_diff = 0.0 - abs_diff;
    }
    if abs_diff < 0.000001 {
        return sabr_atm_volatility(f, t, params);
    }

    let one_minus_beta: Float = 1.0 - (params).beta;
    let fk: Float = f * k;
    let log_fk: Float = ln(f / k);
    let fk_pow: Float = exp((one_minus_beta / 2.0) * ln(fk));

    let z: Float = ((params).nu / (params).alpha) * fk_pow * log_fk;
    let sqrt_term: Float = sqrt(1.0 - (2.0 * (params).rho * z) + (z * z));
    let x_z_num: Float = sqrt_term + z - (params).rho;
    let x_z_den: Float = 1.0 - (params).rho;
    let x_z: Float = ln(x_z_num / x_z_den);

    let mut z_over_xz: Float = 1.0;
    if z != 0.0 && x_z != 0.0 {
        z_over_xz = z / x_z;
    }

    let denom_part: Float = 1.0 + ((one_minus_beta * one_minus_beta / 24.0) * (log_fk * log_fk)) +
                            ((one_minus_beta * one_minus_beta * one_minus_beta * one_minus_beta / 1920.0) * (log_fk * log_fk * log_fk * log_fk));

    let a_part: Float = (one_minus_beta * one_minus_beta * (params).alpha * (params).alpha) / (24.0 * exp(one_minus_beta * ln(fk)));
    let b_part: Float = ((params).rho * (params).beta * (params).nu * (params).alpha) / (4.0 * fk_pow);
    let c_part: Float = ((2.0 - (3.0 * (params).rho * (params).rho)) * (params).nu * (params).nu) / 24.0;

    let time_part: Float = 1.0 + ((a_part + b_part + c_part) * t);

    let sigma: Float = ((params).alpha / (fk_pow * denom_part)) * z_over_xz * time_part;
    return sigma;
}

pub fn sabr_create_slice(
    f: Float,
    t: Float,
    alpha: Float,
    beta: Float,
    rho: Float,
    nu: Float
) -> SabrSmileSlice {
    let p: SabrParameters = sabr_params_new(alpha, beta, rho, nu);
    let atm_vol: Float = sabr_atm_volatility(f, t, &p);
    let pts: List[SabrCalibrationPoint] = list_new();
    return SabrSmileSlice {
        forward_price: f,
        expiry_years: t,
        params: p,
        points: pts,
        atm_volatility: atm_vol
    };
}
