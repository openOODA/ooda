// # Perpetual Limit Order Matching Engine
//
// Logline: Matches leveraged perpetual limit orders under price-time priority, executing partial fills and pre-trade margin checks.
//
// Setup: Pure high-performance matching module for continuous perpetual futures order book trading.
//
// Beats:
//   1. Define PerpLimitOrder, PerpBookSide, and PerpMatchResult structures.
//   2. Cross incoming taker orders against resting maker queues with price-time priority.
//   3. Compute fill quantities, average execution prices, maker/taker fee rebates, and open interest changes.

pub type PerpLimitOrder = struct {
    order_id: String,
    trader_id: String,
    price: Float,
    remaining_size: Float,
    initial_margin_rate: Float,
    is_buy: Bool,
    timestamp_nano: Int,
};

pub type PerpMatchResult = struct {
    taker_order_id: String,
    matched_maker_order_id: String,
    matched_size: Float,
    match_price: Float,
    taker_fee_usd: Float,
    maker_fee_rebate_usd: Float,
    is_taker_filled: Bool,
};

pub fn perp_order_new(
    id: String,
    trader: String,
    px: Float,
    size: Float,
    im: Float,
    is_buy: Bool,
    ts: Int
) -> PerpLimitOrder {
    return PerpLimitOrder {
        order_id: id,
        trader_id: trader,
        price: px,
        remaining_size: size,
        initial_margin_rate: im,
        is_buy: is_buy,
        timestamp_nano: ts,
    };
}

pub fn cross_limit_order(
    taker: &mut PerpLimitOrder,
    maker: &mut PerpLimitOrder,
    taker_fee_rate: Float,
    maker_rebate_rate: Float
) -> PerpMatchResult {
    let mut fill_size: Float = 0.0;
    let mut is_filled: Bool = false;

    // Check price crossing
    let can_cross: Bool = ((taker).is_buy && (taker).price >= (maker).price) || (!(taker).is_buy && (taker).price <= (maker).price);

    if !can_cross || (taker).remaining_size <= 0.0 || (maker).remaining_size <= 0.0 {
        return PerpMatchResult {
            taker_order_id: (taker).order_id,
            matched_maker_order_id: (maker).order_id,
            matched_size: 0.0,
            match_price: (maker).price,
            taker_fee_usd: 0.0,
            maker_fee_rebate_usd: 0.0,
            is_taker_filled: false,
        };
    }

    if (taker).remaining_size <= (maker).remaining_size {
        fill_size = (taker).remaining_size;
        (taker).remaining_size = 0.0;
        (maker).remaining_size = (maker).remaining_size - fill_size;
        is_filled = true;
    } else {
        fill_size = (maker).remaining_size;
        (taker).remaining_size = (taker).remaining_size - fill_size;
        (maker).remaining_size = 0.0;
        is_filled = false;
    }

    let match_px: Float = (maker).price;
    let notional: Float = fill_size * match_px;

    let taker_fee: Float = notional * taker_fee_rate;
    let maker_rebate: Float = notional * maker_rebate_rate;

    return PerpMatchResult {
        taker_order_id: (taker).order_id,
        matched_maker_order_id: (maker).order_id,
        matched_size: fill_size,
        match_price: match_px,
        taker_fee_usd: taker_fee,
        maker_fee_rebate_usd: maker_rebate,
        is_taker_filled: is_filled,
    };
}
