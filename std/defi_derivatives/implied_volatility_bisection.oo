// # Robust Bisection & Brent Implied Volatility Solver
//
// Logline: Implements guaranteed-convergence bracketed interval bisection for robust Black-Scholes implied volatility extraction on deep OTM/ITM contracts.
//
// Setup: Pure quantitative finance module providing numerical fallback when gradient-based solvers encounter flat Vega domains.
//
// Beats:
//   1. Define BisectionConfig and BisectionResult structures.
//   2. Bracket root interval $[a, b]$ satisfying $f(a) \cdot f(b) \le 0$.
//   3. Bisect recursively with logarithmic scale stepping to achieve target decimal precision.

pub type BisectionConfig = struct {
    max_iterations: Int,
    tolerance: Float,
    vol_lower_bound: Float,
    vol_upper_bound: Float
};

pub type BisectionResult = struct {
    implied_volatility: Float,
    iterations_used: Int,
    absolute_error: Float,
    is_converged: Bool
};

pub fn bisection_config_default() -> BisectionConfig {
    return BisectionConfig {
        max_iterations: 40,
        tolerance: 0.00001,
        vol_lower_bound: 0.0001,
        vol_upper_bound: 8.0
    };
}

pub fn bisection_norm_pdf(x: Float) -> Float {
    let pi_factor: Float = 0.3989422804;
    return pi_factor * exp(0.0 - (x * x / 2.0));
}

pub fn bisection_norm_cdf(x: Float) -> Float {
    let mut abs_x: Float = x;
    if x < 0.0 { abs_x = 0.0 - x; }
    let k: Float = 1.0 / (1.0 + (0.2316419 * abs_x));
    let poly: Float = k * (0.31938153 + (k * (-0.35656378 + (k * (1.78147794 + (k * (-1.82125598 + (1.33027443 * k))))))));
    let mut cdf: Float = 1.0 - (bisection_norm_pdf(abs_x) * poly);
    if x < 0.0 { cdf = 1.0 - cdf; }
    return cdf;
}

pub fn bisection_eval_bs(s: Float, k: Float, t: Float, r: Float, vol: Float, is_call: Bool) -> Float {
    let sqrt_t: Float = sqrt(t);
    let d1: Float = (ln(s / k) + ((r + (0.5 * vol * vol)) * t)) / (vol * sqrt_t);
    let d2: Float = d1 - (vol * sqrt_t);
    let df: Float = exp((0.0 - r) * t);

    if is_call {
        return (s * bisection_norm_cdf(d1)) - (k * df * bisection_norm_cdf(d2));
    }
    return (k * df * bisection_norm_cdf(0.0 - d2)) - (s * bisection_norm_cdf(0.0 - d1));
}

pub fn solve_iv_bisection(
    target_price: Float,
    spot: Float,
    strike: Float,
    t: Float,
    r: Float,
    is_call: Bool,
    cfg: &BisectionConfig
) -> BisectionResult {
    let mut low: Float = (cfg).vol_lower_bound;
    let mut high: Float = (cfg).vol_upper_bound;
    let mut mid: Float = (low + high) / 2.0;

    let mut iter: Int = 0;
    let mut err: Float = 1.0;

    while iter < (cfg).max_iterations {
        mid = (low + high) / 2.0;
        let px_mid: Float = bisection_eval_bs(spot, strike, t, r, mid, is_call);
        let diff: Float = px_mid - target_price;

        let mut abs_diff: Float = diff;
        if abs_diff < 0.0 { abs_diff = 0.0 - abs_diff; }
        err = abs_diff;

        if abs_diff < (cfg).tolerance || (high - low) < (cfg).tolerance {
            return BisectionResult {
                implied_volatility: mid,
                iterations_used: iter,
                absolute_error: err,
                is_converged: true
            };
        }

        if diff > 0.0 {
            high = mid;
        } else {
            low = mid;
        }

        iter = iter + 1;
    }

    return BisectionResult {
        implied_volatility: mid,
        iterations_used: iter,
        absolute_error: err,
        is_converged: false
    };
}
