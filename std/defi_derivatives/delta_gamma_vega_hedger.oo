// # Multi-Asset Delta-Gamma-Vega Greeks Neutrality Hedger
//
// Logline: Solves simultaneous linear equations via matrix determinant inversion to achieve exact Delta, Gamma, and Vega portfolio neutrality.
//
// Setup: Pure quantitative risk module calculating multi-instrument hedge quantities for complex derivatives books.
//
// Beats:
//   1. Define HedgeInstrument, PortfolioExposure, and HedgeSolveResult structures.
//   2. Formulate 3x3 linear Greeks sensitivity system (Delta, Gamma, Vega).
//   3. Solve for optimal hedge weights using Cramer's rule determinants and verify residual neutrality.

pub type HedgeInstrument = struct {
    symbol: String,
    delta: Float,
    gamma: Float,
    vega: Float,
};

pub type PortfolioExposure = struct {
    net_delta: Float,
    net_gamma: Float,
    net_vega: Float,
};

pub type HedgeSolveResult = struct {
    weight_instrument_1: Float,
    weight_instrument_2: Float,
    weight_instrument_3: Float,
    residual_delta: Float,
    residual_gamma: Float,
    residual_vega: Float,
    is_solvable: Bool,
};

pub fn hedge_instrument_new(
    sym: String,
    d: Float,
    g: Float,
    v: Float
) -> HedgeInstrument {
    return HedgeInstrument {
        symbol: sym,
        delta: d,
        gamma: g,
        vega: v,
    };
}

pub fn det_3x3(
    a1: Float, a2: Float, a3: Float,
    b1: Float, b2: Float, b3: Float,
    c1: Float, c2: Float, c3: Float
) -> Float {
    let term1: Float = a1 * ((b2 * c3) - (b3 * c2));
    let term2: Float = a2 * ((b1 * c3) - (b3 * c1));
    let term3: Float = a3 * ((b1 * c2) - (b2 * c1));
    return term1 - term2 + term3;
}

pub fn solve_greeks_hedge(
    port: &PortfolioExposure,
    inst1: &HedgeInstrument,
    inst2: &HedgeInstrument,
    inst3: &HedgeInstrument
) -> HedgeSolveResult {
    let a1: Float = (inst1).delta; let a2: Float = (inst2).delta; let a3: Float = (inst3).delta;
    let b1: Float = (inst1).gamma; let b2: Float = (inst2).gamma; let b3: Float = (inst3).gamma;
    let c1: Float = (inst1).vega;  let c2: Float = (inst2).vega;  let c3: Float = (inst3).vega;

    let target1: Float = 0.0 - (port).net_delta;
    let target2: Float = 0.0 - (port).net_gamma;
    let target3: Float = 0.0 - (port).net_vega;

    let det_a: Float = det_3x3(a1, a2, a3, b1, b2, b3, c1, c2, c3);

    let mut abs_det: Float = det_a;
    if abs_det < 0.0 { abs_det = 0.0 - abs_det; }

    if abs_det < 0.000001 {
        return HedgeSolveResult {
            weight_instrument_1: 0.0,
            weight_instrument_2: 0.0,
            weight_instrument_3: 0.0,
            residual_delta: (port).net_delta,
            residual_gamma: (port).net_gamma,
            residual_vega: (port).net_vega,
            is_solvable: false,
        };
    }

    let det_w1: Float = det_3x3(target1, a2, a3, target2, b2, b3, target3, c2, c3);
    let det_w2: Float = det_3x3(a1, target1, a3, b1, target2, b3, c1, target3, c3);
    let det_w3: Float = det_3x3(a1, a2, target1, b1, b2, target2, c1, c2, target3);

    let w1: Float = det_w1 / det_a;
    let w2: Float = det_w2 / det_a;
    let w3: Float = det_w3 / det_a;

    let res_d: Float = (port).net_delta + (w1 * a1) + (w2 * a2) + (w3 * a3);
    let res_g: Float = (port).net_gamma + (w1 * b1) + (w2 * b2) + (w3 * b3);
    let res_v: Float = (port).net_vega + (w1 * c1) + (w2 * c2) + (w3 * c3);

    return HedgeSolveResult {
        weight_instrument_1: w1,
        weight_instrument_2: w2,
        weight_instrument_3: w3,
        residual_delta: res_d,
        residual_gamma: res_g,
        residual_vega: res_v,
        is_solvable: true,
    };
}
