// # Stochastic Volatility Inspired (SVI) Surface Parameterization
//
// Logline: Implements Gatheral (2004) Raw and Quasi-Explicit SVI smile parameterization ensuring asymptotic linearity and absence of butterfly arbitrage.
//
// Setup: Pure quantitative finance module calibrating total implied variance curves across log-moneyness slices.
//
// Beats:
//   1. Define SviParameters, SviLogMoneynessPoint, and SviSliceResult structures.
//   2. Compute raw SVI total implied variance $w(k) = a + b(\rho(k-m) + \sqrt{(k-m)^2 + \sigma^2})$.
//   3. Validate Roger Lee moment formulas and verify absence of negative probability density.

pub type SviParameters = struct {
    a: Float,     // Overall variance level
    b: Float,     // Slope of asymptotic wings (b >= 0)
    rho: Float,   // Orientation of vertex / skew (-1 < rho < 1)
    m: Float,     // Horizontal translation / shift
    sigma: Float // Smoothness of vertex (sigma > 0)
};

pub type SviLogMoneynessPoint = struct {
    log_moneyness_k: Float, // k = ln(K / F)
    total_implied_variance: Float,
    implied_volatility: Float,
    first_derivative: Float,
    second_derivative: Float
};

pub type SviSliceResult = struct {
    expiry_t: Float,
    params: SviParameters,
    atm_volatility: Float,
    left_asymptotic_slope: Float,
    right_asymptotic_slope: Float,
    is_valid_arbitrage_free: Bool
};

pub fn svi_params_default() -> SviParameters {
    return SviParameters {
        a: 0.04,
        b: 0.20,
        rho: -0.40,
        m: 0.0,
        sigma: 0.10
    };
}

pub fn svi_eval_total_variance(k: Float, p: &SviParameters) -> Float {
    let km: Float = k - (p).m;
    let disc: Float = sqrt((km * km) + ((p).sigma * (p).sigma));
    let w: Float = (p).a + ((p).b * (((p).rho * km) + disc));
    if w <= 0.000001 {
        return 0.000001;
    }
    return w;
}

pub fn svi_eval_point(k: Float, t: Float, p: &SviParameters) -> SviLogMoneynessPoint {
    let km: Float = k - (p).m;
    let disc: Float = sqrt((km * km) + ((p).sigma * (p).sigma));
    let w: Float = (p).a + ((p).b * (((p).rho * km) + disc));

    // Derivatives w'(k) and w''(k)
    let dw: Float = (p).b * ((p).rho + (km / disc));
    let d2w: Float = ((p).b * (p).sigma * (p).sigma) / (disc * disc * disc);

    let mut vol: Float = 0.0;
    if t > 0.0 && w > 0.0 {
        vol = sqrt(w / t);
    }

    return SviLogMoneynessPoint {
        log_moneyness_k: k,
        total_implied_variance: w,
        implied_volatility: vol,
        first_derivative: dw,
        second_derivative: d2w
    };
}

pub fn svi_analyze_slice(t: Float, p: &SviParameters) -> SviSliceResult {
    let w_atm: Float = svi_eval_total_variance(0.0, p);
    let mut atm_vol: Float = 0.0;
    if t > 0.0 {
        atm_vol = sqrt(w_atm / t);
    }

    let left_slope: Float = (p).b * ((p).rho - 1.0);
    let right_slope: Float = (p).b * ((p).rho + 1.0);

    // Lee's moment condition: slopes must satisfy |slope| <= 2
    let mut abs_l: Float = left_slope;
    if abs_l < 0.0 { abs_l = 0.0 - abs_l; }
    let mut abs_r: Float = right_slope;
    if abs_r < 0.0 { abs_r = 0.0 - abs_r; }

    let valid: Bool = (p).b >= 0.0 && (p).sigma > 0.0 && abs_l <= 2.0 && abs_r <= 2.0;

    return SviSliceResult {
        expiry_t: t,
        params: *p,
        atm_volatility: atm_vol,
        left_asymptotic_slope: left_slope,
        right_asymptotic_slope: right_slope,
        is_valid_arbitrage_free: valid
    };
}
