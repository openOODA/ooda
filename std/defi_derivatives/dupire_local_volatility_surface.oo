// # Dupire Local Volatility Surface Constructor
//
// Logline: Implements Dupire (1994) local volatility equation reconstructing non-parametric deterministic diffusion surfaces from market European prices.
//
// Setup: Pure quantitative finance module calculating local variance from strike/maturity partial derivatives of call prices.
//
// Beats:
//   1. Define LocalVolPoint, DupireSurfaceGrid, and LocalVolResult structures.
//   2. Compute finite difference derivatives of call prices with respect to calendar time and strike.
//   3. Extract continuous local volatility surfaces free of static calendar and butterfly arbitrage.

pub type LocalVolPoint = struct {
    strike: Float,
    expiry: Float,
    local_vol: Float,
    local_variance: Float,
    is_arbitrage_free: Bool
};

pub type DupireSurfaceGrid = struct {
    underlying_symbol: String,
    spot_price: Float,
    risk_free_rate: Float,
    dividend_yield: Float,
    grid_points: List[LocalVolPoint]
};

pub type LocalVolResult = struct {
    strike: Float,
    expiry: Float,
    local_volatility: Float,
    dC_dT: Float,
    dC_dK: Float,
    d2C_dK2: Float
};

pub fn dupire_surface_new(
    symbol: String,
    spot: Float,
    r: Float,
    q: Float
) -> DupireSurfaceGrid {
    let pts: List[LocalVolPoint] = list_new();
    return DupireSurfaceGrid {
        underlying_symbol: symbol,
        spot_price: spot,
        risk_free_rate: r,
        dividend_yield: q,
        grid_points: pts
    };
}

pub fn dupire_calc_local_vol(
    call_px: Float,
    dC_dT: Float,
    dC_dK: Float,
    d2C_dK2: Float,
    strike: Float,
    r: Float,
    q: Float
) -> LocalVolResult {
    let numerator: Float = dC_dT + ((r - q) * strike * dC_dK) + (q * call_px);
    let denominator: Float = 0.5 * strike * strike * d2C_dK2;

    let mut local_var: Float = 0.04; // 20% default floor
    if denominator > 0.000001 && numerator > 0.0 {
        local_var = numerator / denominator;
    }

    if local_var < 0.0001 {
        local_var = 0.0001; // 1% min vol
    }
    if local_var > 25.0 {
        local_var = 25.0;   // 500% max vol
    }

    let vol: Float = sqrt(local_var);

    return LocalVolResult {
        strike: strike,
        expiry: 1.0,
        local_volatility: vol,
        dC_dT: dC_dT,
        dC_dK: dC_dK,
        d2C_dK2: d2C_dK2
    };
}

pub fn dupire_point_from_derivatives(
    k: Float,
    t: Float,
    c: Float,
    dc_dt: Float,
    dc_dk: Float,
    d2c_dk2: Float,
    r: Float,
    q: Float
) -> LocalVolPoint {
    let res: LocalVolResult = dupire_calc_local_vol(c, dc_dt, dc_dk, d2c_dk2, k, r, q);
    let is_arb_free: Bool = d2c_dk2 > 0.0 && dc_dt >= 0.0;
    return LocalVolPoint {
        strike: k,
        expiry: t,
        local_vol: (res).local_volatility,
        local_variance: (res).local_volatility * (res).local_volatility,
        is_arbitrage_free: is_arb_free
    };
}
