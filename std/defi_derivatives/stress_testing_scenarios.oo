// # Derivatives Portfolio Macro Stress Testing Matrix
//
// Logline: Simulates simultaneous underlying price crashes, implied volatility spikes, and liquidity crunches across multi-asset derivative books.
//
// Setup: Pure quantitative risk module stress-testing derivative portfolios against historical tail events (e.g., Black Thursday, FTX Collapse).
//
// Beats:
//   1. Define StressScenario, StressPositionItem, and StressTestResult structures.
//   2. Apply joint parametric spot price shocks ($\Delta S$) and implied volatility shifts ($\Delta \sigma$).
//   3. Compute stressed portfolio equity, margin call requirements, and worst-case drawdown.

pub type StressScenario = struct {
    scenario_name: String,
    spot_shock_pct: Float, // e.g. -0.30 (-30% crash)
    vol_shock_pct: Float,  // e.g. +0.50 (+50% vol spike)
    funding_rate_shock_pct: Float
};

pub type StressPositionItem = struct {
    symbol: String,
    position_notional_usd: Float,
    delta_usd: Float,
    gamma_usd: Float,
    vega_usd: Float
};

pub type StressTestResult = struct {
    scenario_name: String,
    initial_portfolio_value_usd: Float,
    stressed_portfolio_value_usd: Float,
    projected_pnl_usd: Float,
    delta_pnl_usd: Float,
    gamma_pnl_usd: Float,
    vega_pnl_usd: Float,
    margin_breach_detected: Bool
};

pub fn stress_scenario_black_swan() -> StressScenario {
    return StressScenario {
        scenario_name: "CRYPTO_CRASH_VIX_SPIKE",
        spot_shock_pct: -0.35, // -35% spot crash
        vol_shock_pct: 0.60,   // +60% vol spike
        funding_rate_shock_pct: -0.015
    };
}

pub fn evaluate_stress_scenario(
    scenario: &StressScenario,
    positions: List[StressPositionItem],
    initial_equity_usd: Float,
    maintenance_margin_req_usd: Float
) -> StressTestResult {
    let n: Int = list_len(positions);
    let mut total_delta_pnl: Float = 0.0;
    let mut total_gamma_pnl: Float = 0.0;
    let mut total_vega_pnl: Float = 0.0;

    let s_shock: Float = (scenario).spot_shock_pct;
    let v_shock: Float = (scenario).vol_shock_pct;

    let mut i: Int = 0;
    while i < n {
        let pos: StressPositionItem = list_get(positions, i);

        // Delta PnL = Delta * S_shock
        let d_pnl: Float = (pos).delta_usd * s_shock;
        // Gamma PnL = 0.5 * Gamma * (S_shock)^2
        let g_pnl: Float = 0.5 * (pos).gamma_usd * (s_shock * s_shock);
        // Vega PnL = Vega * (V_shock * 100)
        let v_pnl: Float = (pos).vega_usd * (v_shock * 100.0);

        total_delta_pnl = total_delta_pnl + d_pnl;
        total_gamma_pnl = total_gamma_pnl + g_pnl;
        total_vega_pnl = total_vega_pnl + v_pnl;

        i = i + 1;
    }

    let net_pnl: Float = total_delta_pnl + total_gamma_pnl + total_vega_pnl;
    let stressed_equity: Float = initial_equity_usd + net_pnl;
    let is_breach: Bool = stressed_equity < maintenance_margin_req_usd;

    return StressTestResult {
        scenario_name: (scenario).scenario_name,
        initial_portfolio_value_usd: initial_equity_usd,
        stressed_portfolio_value_usd: stressed_equity,
        projected_pnl_usd: net_pnl,
        delta_pnl_usd: total_delta_pnl,
        gamma_pnl_usd: total_gamma_pnl,
        vega_pnl_usd: total_vega_pnl,
        margin_breach_detected: is_breach
    };
}
