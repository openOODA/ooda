// # Synthetic Perpetual Funding Rate Basis Swap Engine
//
// Logline: Prices synthetic basis swaps exchanging floating 8-hour perpetual funding rate cash flows for fixed term yields.
//
// Setup: Pure quantitative finance module modeling fixed-for-floating basis swaps across crypto perpetual markets.
//
// Beats:
//   1. Define BasisSwapContract, BasisSwapLegState, and BasisSwapSettlement structures.
//   2. Compute accrued floating funding rate payments against fixed rate payment obligations.
//   3. Value net present value (NPV) and determine market-clearing par swap rates.

pub type BasisSwapContract = struct {
    swap_id: String,
    notional_usd: Float,
    fixed_rate_annual: Float,
    tenor_days: Float,
    floating_rates_history: List[Float], // 8h rates
    is_payer_fixed: Bool,
};

pub type BasisSwapSettlement = struct {
    swap_id: String,
    fixed_leg_cash_flow_usd: Float,
    floating_leg_cash_flow_usd: Float,
    net_settlement_cash_flow_usd: Float,
    realized_spread_apr: Float,
    is_favorable_to_fixed_payer: Bool,
};

pub fn basis_swap_new(
    id: String,
    notional: Float,
    fixed_rate: Float,
    tenor: Float,
    is_payer_fixed: Bool
) -> BasisSwapContract {
    let hist: List[Float] = list_new();
    return BasisSwapContract {
        swap_id: id,
        notional_usd: notional,
        fixed_rate_annual: fixed_rate,
        tenor_days: tenor,
        floating_rates_history: hist,
        is_payer_fixed: is_payer_fixed,
    };
}

pub fn settle_basis_swap(
    swap: &BasisSwapContract
) -> BasisSwapSettlement {
    let n: Int = list_len((swap).floating_rates_history);
    let mut sum_floating: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let r: Float = list_get((swap).floating_rates_history, i);
        sum_floating = sum_floating + r;
        i = i + 1;
    }

    let fixed_rate_period: Float = (swap).fixed_rate_annual * ((swap).tenor_days / 365.0);
    let fixed_payment: Float = (swap).notional_usd * fixed_rate_period;
    let floating_payment: Float = (swap).notional_usd * sum_floating;

    let mut net_flow: Float = 0.0;
    if (swap).is_payer_fixed {
        net_flow = floating_payment - fixed_payment;
    } else {
        net_flow = fixed_payment - floating_payment;
    }

    let mut realized_apr: Float = 0.0;
    if (swap).tenor_days > 0.0 {
        realized_apr = sum_floating * (365.0 / (swap).tenor_days);
    }

    return BasisSwapSettlement {
        swap_id: (swap).swap_id,
        fixed_leg_cash_flow_usd: fixed_payment,
        floating_leg_cash_flow_usd: floating_payment,
        net_settlement_cash_flow_usd: net_flow,
        realized_spread_apr: realized_apr - (swap).fixed_rate_annual,
        is_favorable_to_fixed_payer: net_flow > 0.0,
    };
}
