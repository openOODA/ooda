// # Black-76 Perpetual and Futures Options Valuation Engine
//
// Logline: Prices European options on perpetual futures and forward commitments using the Black (1976) discounted forward formula and closed-form Greeks.
//
// Setup: Pure quantitative finance module implementing Black-76 valuation for crypto perpetual and futures options.
//
// Beats:
//   1. Define Black76Contract and Black76GreeksResult structures.
//   2. Compute forward moneyness, discounted expectation integrals, and parity relations.
//   3. Derive analytical futures Greeks (Delta, Gamma, Vega, Theta, Rho) with discount factor weighting.

pub type Black76Contract = struct {
    forward_price: Float,
    strike_price: Float,
    time_to_expiry_years: Float,
    risk_free_rate: Float,
    volatility: Float,
    is_call: Bool,
};

pub type Black76GreeksResult = struct {
    option_price: Float,
    delta: Float,
    gamma: Float,
    vega: Float,
    theta_daily: Float,
    rho: Float,
    intrinsic_value: Float,
    time_value: Float,
};

pub fn black76_norm_pdf(x: Float) -> Float {
    let pi_factor: Float = 0.3989422804;
    return pi_factor * exp(0.0 - (x * x / 2.0));
}

pub fn black76_norm_cdf(x: Float) -> Float {
    let mut abs_x: Float = x;
    if x < 0.0 { abs_x = 0.0 - x; }
    let k: Float = 1.0 / (1.0 + (0.2316419 * abs_x));
    let poly: Float = k * (0.31938153 + (k * (-0.35656378 + (k * (1.78147794 + (k * (-1.82125598 + (1.33027443 * k))))))));
    let mut cdf: Float = 1.0 - (black76_norm_pdf(abs_x) * poly);
    if x < 0.0 { cdf = 1.0 - cdf; }
    return cdf;
}

pub fn black76_contract_new(
    f: Float,
    k: Float,
    t: Float,
    r: Float,
    vol: Float,
    is_call: Bool
) -> Black76Contract {
    return Black76Contract {
        forward_price: f,
        strike_price: k,
        time_to_expiry_years: t,
        risk_free_rate: r,
        volatility: vol,
        is_call: is_call,
    };
}

pub fn black76_evaluate(c: &Black76Contract) -> Black76GreeksResult {
    let f: Float = (c).forward_price;
    let k: Float = (c).strike_price;
    let t: Float = (c).time_to_expiry_years;
    let r: Float = (c).risk_free_rate;
    let vol: Float = (c).volatility;

    if t <= 0.0 || vol <= 0.0 || f <= 0.0 || k <= 0.0 {
        let mut intr: Float = 0.0;
        if (c).is_call {
            if f > k { intr = f - k; }
        } else {
            if k > f { intr = k - f; }
        }
        return Black76GreeksResult {
            option_price: intr,
            delta: 0.0,
            gamma: 0.0,
            vega: 0.0,
            theta_daily: 0.0,
            rho: 0.0,
            intrinsic_value: intr,
            time_value: 0.0,
        };
    }

    let sqrt_t: Float = sqrt(t);
    let d1: Float = (ln(f / k) + (0.5 * vol * vol * t)) / (vol * sqrt_t);
    let d2: Float = d1 - (vol * sqrt_t);

    let df: Float = exp((0.0 - r) * t);
    let n_d1: Float = black76_norm_cdf(d1);
    let n_d2: Float = black76_norm_cdf(d2);
    let pdf_d1: Float = black76_norm_pdf(d1);

    let mut px: Float = 0.0;
    let mut delta: Float = 0.0;
    let mut intr: Float = 0.0;

    if (c).is_call {
        px = df * ((f * n_d1) - (k * n_d2));
        delta = df * n_d1;
        if f > k { intr = f - k; }
    } else {
        let n_minus_d1: Float = black76_norm_cdf(0.0 - d1);
        let n_minus_d2: Float = black76_norm_cdf(0.0 - d2);
        px = df * ((k * n_minus_d2) - (f * n_minus_d1));
        delta = 0.0 - (df * n_minus_d1);
        if k > f { intr = k - f; }
    }

    let gamma: Float = (df * pdf_d1) / (f * vol * sqrt_t);
    let vega: Float = df * f * sqrt_t * pdf_d1 * 0.01; // 1% change

    let theta_annual: Float = (0.0 - (df * f * pdf_d1 * vol)) / (2.0 * sqrt_t) - (r * px);
    let theta_daily: Float = theta_annual / 365.0;

    let rho: Float = (0.0 - t) * px * 0.01;
    let time_val: Float = px - intr;

    return Black76GreeksResult {
        option_price: px,
        delta: delta,
        gamma: gamma,
        vega: vega,
        theta_daily: theta_daily,
        rho: rho,
        intrinsic_value: intr,
        time_value: time_val,
    };
}
