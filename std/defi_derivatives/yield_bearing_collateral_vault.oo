// # Yield-Bearing Collateral & LST/LRT Vault Engine
//
// Logline: Accrues staking yields, exchange rate revaluations, and debt safety margins for liquid staking/restaking tokens (LST/LRT) deposited as collateral.
//
// Setup: Pure quantitative DeFi protocol module managing yield-bearing collateral accounting (e.g., wstETH, rETH, ezETH).
//
// Beats:
//   1. Define LstVaultConfig, LstCollateralPosition, and LstAccrualResult structures.
//   2. Track underlying token exchange rate multiplier growth from staking consensus rewards.
//   3. Compute dynamic LTV expansion, auto-deleveraging yield buffers, and collateral appreciation.

pub type LstVaultConfig = struct {
    token_symbol: String,
    underlying_base_asset: String,
    staking_apr: Float,          // e.g. 0.035 (3.5% staking yield)
    slashing_insurance_fee: Float,
    base_ltv_pct: Float,
};

pub type LstCollateralPosition = struct {
    position_id: String,
    lst_shares: Float,
    initial_exchange_rate: Float, // e.g. wstETH / ETH rate
    current_exchange_rate: Float,
    base_asset_usd_price: Float,
    outstanding_debt_usd: Float,
};

pub type LstAccrualResult = struct {
    collateral_base_units: Float,
    collateral_usd_value: Float,
    accrued_yield_usd: Float,
    current_ltv_pct: Float,
    health_factor: Float,
    is_safe: Bool,
};

pub fn lst_vault_config_wsteth() -> LstVaultConfig {
    return LstVaultConfig {
        token_symbol: "wstETH",
        underlying_base_asset: "ETH",
        staking_apr: 0.034,
        slashing_insurance_fee: 0.001,
        base_ltv_pct: 0.85,
    };
}

pub fn lst_accrue_exchange_rate(
    current_rate: Float,
    days_elapsed: Float,
    cfg: &LstVaultConfig
) -> Float {
    let net_apr: Float = (cfg).staking_apr - (cfg).slashing_insurance_fee;
    let growth: Float = net_apr * (days_elapsed / 365.0);
    return current_rate * (1.0 + growth);
}

pub fn evaluate_lst_position(
    pos: &LstCollateralPosition,
    cfg: &LstVaultConfig
) -> LstAccrualResult {
    let base_units: Float = (pos).lst_shares * (pos).current_exchange_rate;
    let mkt_val_usd: Float = base_units * (pos).base_asset_usd_price;

    let initial_base_units: Float = (pos).lst_shares * (pos).initial_exchange_rate;
    let accrued_yield: Float = (base_units - initial_base_units) * (pos).base_asset_usd_price;

    let mut current_ltv: Float = 0.0;
    let mut health_fac: Float = 999.0;

    if mkt_val_usd > 0.0 {
        current_ltv = (pos).outstanding_debt_usd / mkt_val_usd;
        let max_borrow: Float = mkt_val_usd * (cfg).base_ltv_pct;
        if (pos).outstanding_debt_usd > 0.0 {
            health_fac = max_borrow / (pos).outstanding_debt_usd;
        }
    }

    let is_safe: Bool = health_fac >= 1.0;

    return LstAccrualResult {
        collateral_base_units: base_units,
        collateral_usd_value: mkt_val_usd,
        accrued_yield_usd: accrued_yield,
        current_ltv_pct: current_ltv,
        health_factor: health_fac,
        is_safe: is_safe,
    };
}
