// # Historical Volatility Cone & Multi-Estimator Engine
//
// Logline: Calculates realized volatility cones across multiple time horizons using Parkinson, Garman-Klass, Rogers-Satchell, and Yang-Zhang estimators.
//
// Setup: Pure quantitative finance module measuring historical volatility regimes and range-based dispersion.
//
// Beats:
//   1. Define OhlcBar, VolatilityEstimatorsResult, and VolatilityConeBand structures.
//   2. Compute high-low-open-close range estimators minimizing microstructure noise and drift bias.
//   3. Construct multi-window historical volatility percentile cones (Min, 25th, Median, 75th, Max).

pub type OhlcBar = struct {
    open: Float,
    high: Float,
    low: Float,
    close: Float,
};

pub type VolatilityEstimatorsResult = struct {
    close_to_close_vol: Float,
    parkinson_vol: Float,
    garman_klass_vol: Float,
    rogers_satchell_vol: Float,
    yang_zhang_vol: Float,
};

pub type VolatilityConeBand = struct {
    window_days: Int,
    min_vol: Float,
    percentile_25_vol: Float,
    median_vol: Float,
    percentile_75_vol: Float,
    max_vol: Float,
    current_realized_vol: Float,
};

pub fn ohlc_bar_new(o: Float, h: Float, l: Float, c: Float) -> OhlcBar {
    return OhlcBar {
        open: o,
        high: h,
        low: l,
        close: c,
    };
}

pub fn calc_vol_estimators(
    bars: List[OhlcBar],
    annualization_factor: Float
) -> VolatilityEstimatorsResult {
    let n: Int = list_len(bars);
    if n < 2 {
        return VolatilityEstimatorsResult {
            close_to_close_vol: 0.0,
            parkinson_vol: 0.0,
            garman_klass_vol: 0.0,
            rogers_satchell_vol: 0.0,
            yang_zhang_vol: 0.0,
        };
    }

    let mut sum_p: Float = 0.0;
    let mut sum_gk: Float = 0.0;
    let mut sum_rs: Float = 0.0;
    let mut sum_cc: Float = 0.0;

    let mut prev_c: Float = 0.0;
    let first_bar: OhlcBar = list_get(bars, 0);
    prev_c = (first_bar).close;

    let mut i: Int = 1;
    while i < n {
        let bar: OhlcBar = list_get(bars, i);
        let log_hl: Float = ln((bar).high / (bar).low);
        let log_co: Float = ln((bar).close / (bar).open);
        let log_cc: Float = ln((bar).close / prev_c);

        sum_p = sum_p + (log_hl * log_hl);
        sum_gk = sum_gk + ((0.5 * log_hl * log_hl) - ((0.38629436) * log_co * log_co));

        let log_ho: Float = ln((bar).high / (bar).open);
        let log_hc: Float = ln((bar).high / (bar).close);
        let log_lo: Float = ln((bar).low / (bar).open);
        let log_lc: Float = ln((bar).low / (bar).close);
        sum_rs = sum_rs + ((log_ho * log_hc) + (log_lo * log_lc));

        sum_cc = sum_cc + (log_cc * log_cc);

        prev_c = (bar).close;
        i = i + 1;
    }

    let mut n_f: Float = 0.0;
    let mut rem: Int = n - 1;
    while rem > 0 { n_f = n_f + 1.0; rem = rem - 1; }

    let p_var: Float = sum_p / (4.0 * 0.69314718 * n_f);
    let gk_var: Float = sum_gk / n_f;
    let rs_var: Float = sum_rs / n_f;
    let cc_var: Float = sum_cc / n_f;
    let yz_var: Float = (0.5 * cc_var) + (0.5 * rs_var);

    let ann_sqrt: Float = sqrt(annualization_factor);

    return VolatilityEstimatorsResult {
        close_to_close_vol: sqrt(cc_var) * ann_sqrt,
        parkinson_vol: sqrt(p_var) * ann_sqrt,
        garman_klass_vol: sqrt(gk_var) * ann_sqrt,
        rogers_satchell_vol: sqrt(rs_var) * ann_sqrt,
        yang_zhang_vol: sqrt(yz_var) * ann_sqrt,
    };
}
