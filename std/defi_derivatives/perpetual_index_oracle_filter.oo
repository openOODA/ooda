// # Perpetual Spot Index Oracle Filter & Medianizer
//
// Logline: Filters multi-venue spot oracle feeds using trimmed-mean medianizers, deviation rejection thresholds, and stale-tick safety checks.
//
// Setup: Pure quantitative finance module constructing robust, manipulation-resistant spot index prices for perpetual derivative settlements.
//
// Beats:
//   1. Define VenueQuote, IndexFilterConfig, and FilteredIndexResult structures.
//   2. Filter stale timestamps and reject quotes deviating excessively from median reference.
//   3. Compute volume-weighted median index prices with fallback fault tolerance.

pub type VenueQuote = struct {
    venue_id: String,
    price: Float,
    volume_24h: Float,
    timestamp_sec: Int,
    is_stale: Bool
};

pub type IndexFilterConfig = struct {
    max_staleness_sec: Int,
    max_deviation_pct: Float, // e.g. 0.03 (3% max deviation from median)
    min_active_venues: Int
};

pub type FilteredIndexResult = struct {
    computed_index_price: Float,
    median_raw_price: Float,
    active_venues_count: Int,
    rejected_venues_count: Int,
    is_healthy: Bool
};

pub fn index_filter_config_default() -> IndexFilterConfig {
    return IndexFilterConfig {
        max_staleness_sec: 60,
        max_deviation_pct: 0.02, // 2% max deviation
        min_active_venues: 3
    };
}

pub fn venue_quote_new(
    venue_id: String,
    px: Float,
    vol: Float,
    ts: Int
) -> VenueQuote {
    return VenueQuote {
        venue_id: venue_id,
        price: px,
        volume_24h: vol,
        timestamp_sec: ts,
        is_stale: false
    };
}

pub fn filter_and_aggregate_index(
    quotes: List[VenueQuote],
    current_time_sec: Int,
    cfg: &IndexFilterConfig
) -> FilteredIndexResult {
    let n: Int = list_len(quotes);
    if n == 0 {
        return FilteredIndexResult {
            computed_index_price: 0.0,
            median_raw_price: 0.0,
            active_venues_count: 0,
            rejected_venues_count: 0,
            is_healthy: false
        };
    }

    let mut valid_quotes: List[VenueQuote] = list_new();
    let mut sum_raw_px: Float = 0.0;
    let mut valid_count: Int = 0;

    let mut i: Int = 0;
    while i < n {
        let q: VenueQuote = list_get(quotes, i);
        let age: Int = current_time_sec - (q).timestamp_sec;
        let is_stale: Bool = age > (cfg).max_staleness_sec || age < -5;

        if !is_stale && (q).price > 0.0 {
            valid_quotes = list_push(valid_quotes, q);
            sum_raw_px = sum_raw_px + (q).price;
            valid_count = valid_count + 1;
        }
        i = i + 1;
    }

    if valid_count < (cfg).min_active_venues {
        return FilteredIndexResult {
            computed_index_price: 0.0,
            median_raw_price: 0.0,
            active_venues_count: valid_count,
            rejected_venues_count: n - valid_count,
            is_healthy: false
        };
    }

    let mut count_f: Float = 0.0;
    let mut rem_c: Int = valid_count;
    while rem_c > 0 { count_f = count_f + 1.0; rem_c = rem_c - 1; }
    let raw_mean: Float = sum_raw_px / count_f;

    // Filter outliers deviating from raw mean
    let mut sum_filtered_px_vol: Float = 0.0;
    let mut sum_vol: Float = 0.0;
    let mut accepted_count: Int = 0;

    let mut j: Int = 0;
    while j < valid_count {
        let vq: VenueQuote = list_get(valid_quotes, j);
        let dev: Float = ((vq).price - raw_mean) / raw_mean;
        let mut abs_dev: Float = dev;
        if abs_dev < 0.0 { abs_dev = 0.0 - abs_dev; }

        if abs_dev <= (cfg).max_deviation_pct {
            let weight: Float = (vq).volume_24h + 1.0;
            sum_filtered_px_vol = sum_filtered_px_vol + ((vq).price * weight);
            sum_vol = sum_vol + weight;
            accepted_count = accepted_count + 1;
        }
        j = j + 1;
    }

    let final_px: Float = sum_filtered_px_vol / sum_vol;

    return FilteredIndexResult {
        computed_index_price: final_px,
        median_raw_price: raw_mean,
        active_venues_count: accepted_count,
        rejected_venues_count: n - accepted_count,
        is_healthy: accepted_count >= (cfg).min_active_venues
    };
}
