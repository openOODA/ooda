// # Perpetual Futures Cross-Margin Accounting Engine
//
// Logline: Manages portfolio-wide cross-margin collateral, aggregating unrealized PnL, free margin, and leverage ratios across multi-asset positions.
//
// Setup: Pure quantitative risk module implementing portfolio cross-margin calculations for perpetual trading platforms.
//
// Beats:
//   1. Define CrossPosition, CrossMarginAccount, and CrossMarginSummary structures.
//   2. Aggregate initial and maintenance margin requirements across long and short positions.
//   3. Compute free margin, effective account leverage, and withdrawal capacity.

pub type CrossPosition = struct {
    symbol: String,
    size: Float,
    entry_price: Float,
    mark_price: Float,
    initial_margin_rate: Float,
    maintenance_margin_rate: Float,
};

pub type CrossMarginAccount = struct {
    account_id: String,
    deposited_collateral_usd: Float,
    positions: List[CrossPosition],
};

pub type CrossMarginSummary = struct {
    total_collateral_usd: Float,
    total_unrealized_pnl: Float,
    total_equity_usd: Float,
    total_position_notional_usd: Float,
    total_initial_margin_usd: Float,
    total_maintenance_margin_usd: Float,
    free_margin_usd: Float,
    margin_ratio: Float,
    effective_leverage: Float,
    is_liquidatable: Bool,
};

pub fn cross_account_new(account_id: String, initial_collateral: Float) -> CrossMarginAccount {
    let pos_list: List[CrossPosition] = list_new();
    return CrossMarginAccount {
        account_id: account_id,
        deposited_collateral_usd: initial_collateral,
        positions: pos_list,
    };
}

pub fn cross_position_new(
    symbol: String,
    size: Float,
    entry_px: Float,
    mark_px: Float,
    im_rate: Float,
    mm_rate: Float
) -> CrossPosition {
    return CrossPosition {
        symbol: symbol,
        size: size,
        entry_price: entry_px,
        mark_price: mark_px,
        initial_margin_rate: im_rate,
        maintenance_margin_rate: mm_rate,
    };
}

pub fn cross_evaluate_account(account: &CrossMarginAccount) -> CrossMarginSummary {
    let n: Int = list_len((account).positions);
    let mut total_upnl: Float = 0.0;
    let mut total_notional: Float = 0.0;
    let mut total_im: Float = 0.0;
    let mut total_mm: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let pos: CrossPosition = list_get((account).positions, i);
        let upnl: Float = (pos).size * ((pos).mark_price - (pos).entry_price);
        total_upnl = total_upnl + upnl;

        let mut abs_size: Float = (pos).size;
        if abs_size < 0.0 {
            abs_size = 0.0 - abs_size;
        }
        let notional: Float = abs_size * (pos).mark_price;
        total_notional = total_notional + notional;
        total_im = total_im + (notional * (pos).initial_margin_rate);
        total_mm = total_mm + (notional * (pos).maintenance_margin_rate);

        i = i + 1;
    }

    let equity: Float = (account).deposited_collateral_usd + total_upnl;
    let free_margin: Float = equity - total_im;

    let mut margin_ratio: Float = 1.0;
    let mut leverage: Float = 0.0;
    if total_notional > 0.0 {
        margin_ratio = equity / total_notional;
        if equity > 0.0 {
            leverage = total_notional / equity;
        }
    }

    let is_liq: Bool = equity <= total_mm;

    return CrossMarginSummary {
        total_collateral_usd: (account).deposited_collateral_usd,
        total_unrealized_pnl: total_upnl,
        total_equity_usd: equity,
        total_position_notional_usd: total_notional,
        total_initial_margin_usd: total_im,
        total_maintenance_margin_usd: total_mm,
        free_margin_usd: free_margin,
        margin_ratio: margin_ratio,
        effective_leverage: leverage,
        is_liquidatable: is_liq,
    };
}
