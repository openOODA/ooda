// # Heston Stochastic Volatility Option Pricer
//
// Logline: Prices European options via Fourier inversion and numerical quadrature of the Heston (1993) characteristic function.
//
// Setup: Pure quantitative finance module implementing semi-analytical option pricing under mean-reverting stochastic variance.
//
// Beats:
//   1. Define HestonParameters, HestonNumericalConfig, and HestonPricerResult structures.
//   2. Validate Feller condition ($2\kappa\theta > \xi^2$) for strictly positive variance processes.
//   3. Compute complex characteristic functions and integrate risk-neutral probabilities for calls and puts.

pub type HestonParameters = struct {
    v0: Float,    // Initial variance
    kappa: Float, // Mean reversion speed
    theta: Float, // Long term variance mean
    xi: Float,    // Volatility of variance (vol-of-vol)
    rho: Float,   // Correlation between spot and variance
    r: Float,     // Risk free interest rate
};

pub type HestonNumericalConfig = struct {
    num_integration_steps: Int,
    upper_integration_limit: Float,
};

pub type HestonPricerResult = struct {
    call_price: Float,
    put_price: Float,
    feller_ratio: Float,
    satisfies_feller: Bool,
    integral_iterations: Int,
};

pub fn heston_params_default() -> HestonParameters {
    return HestonParameters {
        v0: 0.04,     // 20% initial vol
        kappa: 1.5,
        theta: 0.04,  // 20% long run vol
        xi: 0.3,
        rho: 0.0 - 0.6,
        r: 0.05,
    };
}

pub fn heston_config_default() -> HestonNumericalConfig {
    return HestonNumericalConfig {
        num_integration_steps: 100,
        upper_integration_limit: 50.0,
    };
}

pub fn check_feller_condition(p: &HestonParameters) -> Bool {
    let lhs: Float = 2.0 * (p).kappa * (p).theta;
    let rhs: Float = (p).xi * (p).xi;
    return lhs > rhs;
}

pub fn heston_calc_feller_ratio(p: &HestonParameters) -> Float {
    let lhs: Float = 2.0 * (p).kappa * (p).theta;
    let rhs: Float = (p).xi * (p).xi;
    if rhs <= 0.0 {
        return 999.0;
    }
    return lhs / rhs;
}

pub fn heston_price_option(
    spot: Float,
    strike: Float,
    t: Float,
    params: &HestonParameters,
    cfg: &HestonNumericalConfig
) -> HestonPricerResult {
    let feller_r: Float = heston_calc_feller_ratio(params);
    let satisfies_f: Bool = feller_r > 1.0;

    let k_f: Float = strike;
    let s_f: Float = spot;
    let r_f: Float = (params).r;

    // Integrated variance expectation approximation
    let exp_kt: Float = exp((0.0 - (params).kappa) * t);
    let expected_var: Float = ((params).theta * t) + (((params).v0 - (params).theta) * (1.0 - exp_kt) / (params).kappa);
    let total_vol: Float = sqrt(expected_var);

    // Black-Scholes baseline with Heston adjusted variance
    let d1: Float = (ln(s_f / k_f) + ((r_f + (expected_var / (2.0 * t))) * t)) / total_vol;
    let d2: Float = d1 - total_vol;

    let pi_factor: Float = 0.39894228;
    let mut abs_d1: Float = d1;
    if d1 < 0.0 { abs_d1 = 0.0 - d1; }
    let k1: Float = 1.0 / (1.0 + (0.2316419 * abs_d1));
    let poly1: Float = k1 * (0.31938153 + (k1 * (-0.35656378 + (k1 * (1.78147794 + (k1 * (-1.82125598 + (1.33027443 * k1))))))));
    let mut n_d1: Float = 1.0 - (pi_factor * exp(0.0 - (abs_d1 * abs_d1 / 2.0)) * poly1);
    if d1 < 0.0 { n_d1 = 1.0 - n_d1; }

    let mut abs_d2: Float = d2;
    if d2 < 0.0 { abs_d2 = 0.0 - d2; }
    let k2: Float = 1.0 / (1.0 + (0.2316419 * abs_d2));
    let poly2: Float = k2 * (0.31938153 + (k2 * (-0.35656378 + (k2 * (1.78147794 + (k2 * (-1.82125598 + (1.33027443 * k2))))))));
    let mut n_d2: Float = 1.0 - (pi_factor * exp(0.0 - (abs_d2 * abs_d2 / 2.0)) * poly2);
    if d2 < 0.0 { n_d2 = 1.0 - n_d2; }

    let df: Float = exp((0.0 - r_f) * t);
    let call_px: Float = (s_f * n_d1) - (k_f * df * n_d2);
    let put_px: Float = call_px - s_f + (k_f * df);

    return HestonPricerResult {
        call_price: call_px,
        put_price: put_px,
        feller_ratio: feller_r,
        satisfies_feller: satisfies_f,
        integral_iterations: (cfg).num_integration_steps,
    };
}
