// # DEM Analytical Hillshade Shading & Illumination
//
// Logline: Computes shaded relief grayscale illumination values [0-255] from terrain slope, aspect, solar azimuth, and zenith angles.
//
// Setup: Lambertian reflectance model for topographical relief cartography and 3D terrain visualization.
//
// Beats:
//   1. Define HillshadeConfig struct specifying solar altitude, solar azimuth, and z-factor exaggeration.
//   2. Compute illumination cosine angle using spherical trigonometric dot products with the surface normal.
//   3. Scale illumination value to 8-bit unsigned integer grayscale range [0, 255].

import "./geotiff_elevation_raster.oo";
import "./dem_slope_aspect_calc.oo";

pub type HillshadeConfig = struct {
    solar_altitude_deg: Float, // Sun elevation above horizon (0 to 90)
    solar_azimuth_deg: Float,  // Sun direction clockwise from North (default 315 NW)
    z_factor: Float,           // Vertical exaggeration factor (default 1.0)
};

pub fn hillshade_config_default() -> HillshadeConfig {
    return HillshadeConfig {
        solar_altitude_deg: 45.0,
        solar_azimuth_deg: 315.0,
        z_factor: 1.0,
    };
}

// Convert degrees to radians
pub fn hillshade_deg2rad(deg: Float) -> Float {
    return deg * 0.017453292519943295;
}

// Compute 8-bit hillshade value [0, 255] for a raster cell
pub fn dem_compute_hillshade(
    grid: &DemRasterGrid,
    col: Int,
    row: Int,
    cfg: &HillshadeConfig
) -> Int {
    let sa_res = dem_calc_slope_aspect_horn(grid, col, row);

    // Zenith angle = 90 - altitude
    let zenith_deg: Float = 90.0 - (cfg).solar_altitude_deg;
    let zenith_rad: Float = hillshade_deg2rad(zenith_deg);
    let azimuth_rad: Float = hillshade_deg2rad((cfg).solar_azimuth_deg);

    let slope_rad: Float = hillshade_deg2rad((sa_res).slope_deg * (cfg).z_factor);
    let aspect_rad: Float = if (sa_res).aspect_deg < 0.0 {
        azimuth_rad // flat terrain faces sun
    } else {
        hillshade_deg2rad((sa_res).aspect_deg)
    };

    // Standard ESRI Hillshade formula:
    // Hillshade = 255.0 * ((cos(Zenith) * cos(Slope)) + (sin(Zenith) * sin(Slope) * cos(Azimuth - Aspect)))
    let cos_zenith: Float = cos(zenith_rad);
    let sin_zenith: Float = sin(zenith_rad);
    let cos_slope: Float = cos(slope_rad);
    let sin_slope: Float = sin(slope_rad);
    let cos_az_diff: Float = cos(azimuth_rad - aspect_rad);

    let illumination: Float = (cos_zenith * cos_slope) + (sin_zenith * sin_slope * cos_az_diff);
    let clamped_illum: Float = if illumination < 0.0 { 0.0 } else { if illumination > 1.0 { 1.0 } else { illumination } };

    let gray_f: Float = clamped_illum * 255.0;
    let mut gray_int: Int = 0;
    let mut tmp: Float = gray_f;
    while tmp >= 100.0 { gray_int = gray_int + 100; tmp = tmp - 100.0; }
    while tmp >= 10.0 { gray_int = gray_int + 10; tmp = tmp - 10.0; }
    while tmp >= 1.0 { gray_int = gray_int + 1; tmp = tmp - 1.0; }

    if gray_int > 255 {
        return 255;
    }
    return gray_int;
}
