// # H3 Hexagonal K-Ring Neighbor Resolution
//
// Logline: Computes concentric hexagonal k-ring neighbor sets and hollow ring boundaries for H3 spatial indexing.
//
// Setup: Hexagonal grid topology with 6 directional neighbor vectors and distance metrics.
//
// Beats:
//   1. Define H3NeighborRing struct holding neighbor count and cell list.
//   2. Calculate k-ring cell count formula 3k(k+1) + 1 for hexagonal grids.
//   3. Generate immediate 6-directional adjacent neighbor cells and hollow rings.

import "./h3_hex_cell_index.oo";

pub type H3NeighborRing = struct {
    origin: H3Index,
    k_distance: Int,
    total_cells: Int,
    ring_cells: List[H3Index]
};

pub fn h3_k_ring_size(k: Int) -> Int {
    if k <= 0 { return 1; }
    // Formula: 1 + 3 * k * (k + 1)
    return 1 + (3 * k * (k + 1));
}

pub fn h3_hollow_ring_size(k: Int) -> Int {
    if k <= 0 { return 1; }
    // Formula: 6 * k
    return 6 * k;
}

pub fn h3_get_direct_neighbor(origin: &H3Index, direction: Int) -> H3Index {
    let dir_mod: Int = direction;
    let new_low: Int = (origin).low + dir_mod + 1;
    return H3Index {
        high: (origin).high,
        low: new_low,
        res: (origin).res,
        base_cell: (origin).base_cell,
        is_pentagon: (origin).is_pentagon
    };
}

pub fn h3_k_ring(origin: &H3Index, k: Int) -> H3NeighborRing {
    let mut cells: List[H3Index] = list_new();
    list_push(cells, *origin);

    if k <= 0 {
        return H3NeighborRing {
            origin: *origin,
            k_distance: 0,
            total_cells: 1,
            ring_cells: cells
        };
    }

    let mut step: Int = 1;
    while step <= k {
        let mut dir: Int = 0;
        while dir < 6 {
            let neighbor = h3_get_direct_neighbor(origin, (step * 6) + dir);
            list_push(cells, neighbor);
            dir = dir + 1;
        }
        step = step + 1;
    }

    let count: Int = list_len(cells);
    return H3NeighborRing {
        origin: *origin,
        k_distance: k,
        total_cells: count,
        ring_cells: cells
    };
}

pub fn h3_hollow_ring(origin: &H3Index, k: Int) -> H3NeighborRing {
    let mut cells: List[H3Index] = list_new();

    if k <= 0 {
        list_push(cells, *origin);
        return H3NeighborRing {
            origin: *origin,
            k_distance: 0,
            total_cells: 1,
            ring_cells: cells
        };
    }

    let mut dir: Int = 0;
    let expected_count: Int = h3_hollow_ring_size(k);
    while dir < expected_count {
        let neighbor = h3_get_direct_neighbor(origin, (k * 10) + dir);
        list_push(cells, neighbor);
        dir = dir + 1;
    }

    return H3NeighborRing {
        origin: *origin,
        k_distance: k,
        total_cells: list_len(cells),
        ring_cells: cells
    };
}
