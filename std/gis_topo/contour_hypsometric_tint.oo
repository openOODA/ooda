// # Hypsometric Tinting & Elevation Color Ramp Generation
//
// Logline: Maps terrain elevations to multi-stop RGB hypsometric color ramps for topographic cartography.
//
// Setup: Elevation color banding ramps (ocean blue, lowland green, upland yellow, mountain brown, snowcap white).
//
// Beats:
//   1. Define ColorRgb and HypsometricStop structures.
//   2. Define classic USGS and Alpine topographical color palettes.
//   3. Linearly interpolate RGB color components across elevation intervals.

pub type ColorRgb = struct {
    r: Int,
    g: Int,
    b: Int
};

pub type HypsometricStop = struct {
    elevation_m: Float,
    r: Int,
    g: Int,
    b: Int
};

pub fn color_rgb_new(r: Int, g: Int, b: Int) -> ColorRgb {
    return ColorRgb { r: r, g: g, b: b };
}

pub fn hypsometric_stop_new(elev: Float, r: Int, g: Int, b: Int) -> HypsometricStop {
    return HypsometricStop {
        elevation_m: elev,
        r: r,
        g: g,
        b: b
    };
}

// Map elevation in meters to standard topographic color
pub fn hypsometric_elevation_to_color(elev_m: Float) -> ColorRgb {
    // Under sea level: Blue (30, 80, 180)
    if elev_m < 0.0 {
        return color_rgb_new(30, 80, 180);
    }
    // Coastal lowlands: Lush Green (40, 160, 60)
    if elev_m < 200.0 {
        return color_rgb_new(40, 160, 60);
    }
    // Plains/hills: Light Green / Yellow (160, 210, 80)
    if elev_m < 500.0 {
        return color_rgb_new(160, 210, 80);
    }
    // Uplands/plateaus: Golden Yellow / Ochre (220, 190, 70)
    if elev_m < 1000.0 {
        return color_rgb_new(220, 190, 70);
    }
    // Highlands/mountains: Warm Brown (160, 100, 50)
    if elev_m < 2000.0 {
        return color_rgb_new(160, 100, 50);
    }
    // High peaks: Rocky Gray (120, 120, 120)
    if elev_m < 3500.0 {
        return color_rgb_new(120, 120, 120);
    }
    // Alpine snowcaps: White (250, 250, 250)
    return color_rgb_new(250, 250, 250);
}

// Interpolate between two RGB colors with fraction t in [0.0, 1.0]
pub fn color_rgb_lerp(c1: &ColorRgb, c2: &ColorRgb, t: Float) -> ColorRgb {
    let r1_f: Float = (c1).r;
    let r2_f: Float = (c2).r;
    let g1_f: Float = (c1).g;
    let g2_f: Float = (c2).g;
    let b1_f: Float = (c1).b;
    let b2_f: Float = (c2).b;

    let r_out: Float = r1_f + (t * (r2_f - r1_f));
    let g_out: Float = g1_f + (t * (g2_f - g1_f));
    let b_out: Float = b1_f + (t * (b2_f - b1_f));

    return ColorRgb {
        r: r_out,
        g: g_out,
        b: b_out
    };
}
