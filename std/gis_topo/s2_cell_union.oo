// # S2 Spherical Cell Union & Region Coverer
//
// Logline: Manages collections of disjoint S2 cells approximating spherical geographic regions and polygons.
//
// Setup: Hierarchical spatial coverage, cell normalization, deduplication, and bounding box covering.
//
// Beats:
//   1. Define S2CellUnion struct holding normalized lists of S2CellId instances.
//   2. Normalize cell unions by replacing 4 sibling children with parent cells.
//   3. Compute union total surface area and test cell intersection / containment.

import "./s2_cell_id_hilbert.oo";

pub type S2CellUnion = struct {
    num_cells: Int,
    cells: List[S2CellId]
};

pub fn s2_cell_union_new() -> S2CellUnion {
    let list: List[S2CellId] = list_new();
    return S2CellUnion {
        num_cells: 0,
        cells: list
    };
}

pub fn s2_cell_union_add(cu: &mut S2CellUnion, cell: S2CellId) {
    list_push((cu).cells, cell);
    (cu).num_cells = (cu).num_cells + 1;
}

// Check if union contains a cell by matching cell or any of its ancestors
pub fn s2_cell_union_contains(cu: &S2CellUnion, target: &S2CellId) -> Bool {
    let count: Int = (cu).num_cells;
    let mut i: Int = 0;
    while i < count {
        let c: S2CellId = list_get((cu).cells, i);
        if (c).face == (target).face {
            if (c).level <= (target).level {
                let ancestor = s2_parent(target, (c).level);
                if (c).hilbert_low == (ancestor).hilbert_low {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// Compute total approximate surface area of the cell union in km2
pub fn s2_cell_union_area_km2(cu: &S2CellUnion) -> Float {
    let mut total_area: Float = 0.0;
    let count: Int = (cu).num_cells;
    let mut i: Int = 0;
    while i < count {
        let c: S2CellId = list_get((cu).cells, i);
        let cell_area: Float = s2_cell_area_km2((c).level);
        total_area = total_area + cell_area;
        i = i + 1;
    }
    return total_area;
}

// Normalize cell union: replace 4 sibling children with their common parent
pub fn s2_cell_union_normalize(cu: &S2CellUnion) -> S2CellUnion {
    let mut normalized = s2_cell_union_new();
    let count: Int = (cu).num_cells;
    if count == 0 {
        return normalized;
    }

    let mut i: Int = 0;
    while i < count {
        let c: S2CellId = list_get((cu).cells, i);
        if (c).level > 0 {
            let parent_cell = s2_parent(&c, (c).level - 1);
            s2_cell_union_add(&mut normalized, parent_cell);
        } else {
            s2_cell_union_add(&mut normalized, c);
        }
        i = i + 1;
    }
    return normalized;
}
