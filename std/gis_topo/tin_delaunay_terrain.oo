// # Triangulated Irregular Network (TIN) Delaunay Terrain
//
// Logline: Builds 3D Triangulated Irregular Networks (TIN) with 2.5D Delaunay circumcircle criteria and surface interpolation.
//
// Setup: Irregular spatial point collections generating continuous triangular facets for topographical terrain modeling.
//
// Beats:
//   1. Define TinVertex3D and TinTriangle3D topological mesh structures.
//   2. Compute 2D in-circle determinant test for Delaunay triangulation condition.
//   3. Interpolate elevation Z inside a 3D triangle via barycentric coordinates.

pub type TinVertex3D = struct {
    id: Int,
    x: Float,
    y: Float,
    z: Float,
};

pub type TinTriangle3D = struct {
    v0: Int,
    v1: Int,
    v2: Int,
    normal_x: Float,
    normal_y: Float,
    normal_z: Float,
};

pub fn tin_vertex_new(id: Int, x: Float, y: Float, z: Float) -> TinVertex3D {
    return TinVertex3D { id: id, x: x, y: y, z: z };
}

pub fn tin_triangle_new(v0: Int, v1: Int, v2: Int) -> TinTriangle3D {
    return TinTriangle3D {
        v0: v0,
        v1: v1,
        v2: v2,
        normal_x: 0.0,
        normal_y: 0.0,
        normal_z: 1.0,
    };
}

// 2D In-Circle determinant test: returns true if point (px, py) lies inside circumcircle of triangle (a, b, c) in counter-clockwise order
pub fn tin_in_circumcircle(
    ax: Float, ay: Float,
    bx: Float, by: Float,
    cx: Float, cy: Float,
    px: Float, py: Float
) -> Bool {
    let adx: Float = ax - px;
    let ady: Float = ay - py;
    let bdx: Float = bx - px;
    let bdy: Float = by - py;
    let cdx: Float = cx - px;
    let cdy: Float = cy - py;

    let ab_det: Float = (adx * bdy) - (bdx * ady);
    let bc_det: Float = (bdx * cdy) - (cdx * bdy);
    let ca_det: Float = (cdx * ady) - (adx * cdy);

    let a_lift: Float = (adx * adx) + (ady * ady);
    let b_lift: Float = (bdx * bdx) + (bdy * bdy);
    let c_lift: Float = (cdx * cdx) + (cdy * cdy);

    let det: Float = (a_lift * bc_det) + (b_lift * ca_det) + (c_lift * ab_det);
    return det > 0.0000001;
}

// Compute elevation Z at (px, py) using barycentric planar interpolation on triangle (v0, v1, v2)
pub fn tin_interpolate_z(
    v0: &TinVertex3D,
    v1: &TinVertex3D,
    v2: &TinVertex3D,
    px: Float,
    py: Float
) -> Float {
    let x0: Float = (v0).x; let y0: Float = (v0).y; let z0: Float = (v0).z;
    let x1: Float = (v1).x; let y1: Float = (v1).y; let z1: Float = (v1).z;
    let x2: Float = (v2).x; let y2: Float = (v2).y; let z2: Float = (v2).z;

    let denom: Float = ((y1 - y2) * (x0 - x2)) + ((x2 - x1) * (y0 - y2));
    if (denom > -0.000001) && (denom < 0.000001) {
        return (z0 + z1 + z2) / 3.0;
    }

    let w0: Float = (((y1 - y2) * (px - x2)) + ((x2 - x1) * (py - y2))) / denom;
    let w1: Float = (((y2 - y0) * (px - x2)) + ((x0 - x2) * (py - y2))) / denom;
    let w2: Float = 1.0 - w0 - w1;

    return (w0 * z0) + (w1 * z1) + (w2 * z2);
}
