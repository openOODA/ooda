// # Geoid Undulation EGM96 & Orthometric Height Calculation
//
// Logline: Converts between GNSS ellipsoidal heights (h) and true orthometric mean sea level heights (H = h - N) via EGM96 geoid undulation.
//
// Setup: Spherical harmonic geopotential models and gridded geoid height corrections above WGS84 reference ellipsoid.
//
// Beats:
//   1. Define GeoidHeightResult struct containing ellipsoidal, orthometric, and geoid undulation heights.
//   2. Interpolate geoid undulation N (meters) across global latitude/longitude coordinates.
//   3. Transform GPS/GNSS ellipsoidal heights to orthometric elevations above sea level.

pub type GeoidHeightResult = struct {
    lat_deg: Float,
    lon_deg: Float,
    ellipsoidal_height_m: Float,
    geoid_undulation_n_m: Float,
    orthometric_height_m: Float
};

// Approximate analytical EGM96 geoid undulation in meters across latitude/longitude
pub fn egm96_geoid_undulation(lat_deg: Float, lon_deg: Float) -> Float {
    let lat_rad: Float = lat_deg * 0.017453292519943295;
    let lon_rad: Float = lon_deg * 0.017453292519943295;

    // Dominant low-degree spherical harmonic approximations
    let term1: Float = -28.0 * sin(2.0 * lat_rad);
    let term2: Float = 14.0 * cos(lat_rad) * cos(lon_rad);
    let term3: Float = -8.0 * cos(lat_rad) * sin(2.0 * lon_rad);
    let term4: Float = 5.0 * sin(3.0 * lat_rad);

    let n: Float = term1 + term2 + term3 + term4;
    return n;
}

// Convert GNSS ellipsoidal height to orthometric height: H = h - N
pub fn ellipsoidal_to_orthometric(
    lat_deg: Float,
    lon_deg: Float,
    ellip_h_m: Float
) -> GeoidHeightResult {
    let n_m: Float = egm96_geoid_undulation(lat_deg, lon_deg);
    let ortho_h: Float = ellip_h_m - n_m;

    return GeoidHeightResult {
        lat_deg: lat_deg,
        lon_deg: lon_deg,
        ellipsoidal_height_m: ellip_h_m,
        geoid_undulation_n_m: n_m,
        orthometric_height_m: ortho_h
    };
}

// Convert orthometric height to GNSS ellipsoidal height: h = H + N
pub fn orthometric_to_ellipsoidal(
    lat_deg: Float,
    lon_deg: Float,
    ortho_h_m: Float
) -> GeoidHeightResult {
    let n_m: Float = egm96_geoid_undulation(lat_deg, lon_deg);
    let ellip_h: Float = ortho_h_m + n_m;

    return GeoidHeightResult {
        lat_deg: lat_deg,
        lon_deg: lon_deg,
        ellipsoidal_height_m: ellip_h,
        geoid_undulation_n_m: n_m,
        orthometric_height_m: ortho_h_m
    };
}
