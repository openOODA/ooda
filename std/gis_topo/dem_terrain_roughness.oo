// # Terrain Ruggedness (TRI) & Topographic Position (TPI) Indices
//
// Logline: Calculates Riley's Terrain Ruggedness Index (TRI) and Weiss's Topographic Position Index (TPI) for geomorphological classification.
//
// Setup: 3x3 local neighborhood focal statistics extracting terrain heterogeneity, ridges, valleys, and slope position.
//
// Beats:
//   1. Compute Terrain Ruggedness Index (TRI) = sqrt(sum((z_i - z_c)^2) / 8).
//   2. Compute Topographic Position Index (TPI) = z_c - mean(z_neighbors).
//   3. Classify landform categories (ridge, upper slope, flat plain, valley bottom).

import "./geotiff_elevation_raster.oo";

pub type TerrainMorphometry = struct {
    tri: Float, // Terrain Ruggedness Index
    tpi: Float, // Topographic Position Index
    elevation_range: Float,
    is_valid: Bool,
};

// Compute TRI and TPI for cell (col, row) over 3x3 window
pub fn dem_calc_tri_tpi(
    grid: &DemRasterGrid,
    col: Int,
    row: Int
) -> TerrainMorphometry {
    let z_c: Float = dem_raster_get_value(grid, col, row);
    if z_c == (grid).nodata_value {
        return TerrainMorphometry {
            tri: 0.0,
            tpi: 0.0,
            elevation_range: 0.0,
            is_valid: false,
        };
    }

    let mut sum_sq_diff: Float = 0.0;
    let mut sum_neighbors: Float = 0.0;
    let mut min_z: Float = z_c;
    let mut max_z: Float = z_c;
    let mut valid_count: Int = 0;

    let mut dr: Int = -1;
    while dr <= 1 {
        let mut dc: Int = -1;
        while dc <= 1 {
            if (dr != 0) || (dc != 0) {
                let z_n: Float = dem_raster_get_value(grid, col + dc, row + dr);
                if z_n != (grid).nodata_value {
                    let diff: Float = z_n - z_c;
                    sum_sq_diff = sum_sq_diff + (diff * diff);
                    sum_neighbors = sum_neighbors + z_n;
                    if z_n < min_z { min_z = z_n; }
                    if z_n > max_z { max_z = z_n; }
                    valid_count = valid_count + 1;
                }
            }
            dc = dc + 1;
        }
        dr = dr + 1;
    }

    if valid_count == 0 {
        return TerrainMorphometry {
            tri: 0.0,
            tpi: 0.0,
            elevation_range: 0.0,
            is_valid: false,
        };
    }

    let mut count_f: Float = 0.0;
    let mut c: Int = valid_count;
    while c >= 1 { count_f = count_f + 1.0; c = c - 1; }

    let tri: Float = sqrt(sum_sq_diff / count_f);
    let mean_neighbor_z: Float = sum_neighbors / count_f;
    let tpi: Float = z_c - mean_neighbor_z;
    let elev_range: Float = max_z - min_z;

    return TerrainMorphometry {
        tri: tri,
        tpi: tpi,
        elevation_range: elev_range,
        is_valid: true,
    };
}

// Classify landform type based on TPI value
// TPI > 1.0: Ridge / Peak
// TPI < -1.0: Valley / Depression
// Otherwise: Flat plain or gentle slope
pub fn dem_classify_landform(tpi: Float) -> String {
    if tpi > 5.0 {
        return "Peak";
    }
    if tpi > 1.0 {
        return "Ridge";
    }
    if tpi < -5.0 {
        return "DeepCanyon";
    }
    if tpi < -1.0 {
        return "Valley";
    }
    return "FlatPlain";
}
