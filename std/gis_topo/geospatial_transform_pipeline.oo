// # Geospatial Coordinate Transformation Pipeline
//
// Logline: Chains multi-stage geodetic transformations across datums, ellipsoids, projections, and unit conversions.
//
// Setup: Modular coordinate pipelines composing datum shifts (WGS84/NAD83) and map projections (UTM/Mercator).
//
// Beats:
//   1. Define TransformPipelineStep and PipelineExecutionResult structures.
//   2. Chain 3D geocentric shifts, geodetic lat/lon conversions, and planar projections.
//   3. Validate transformation boundaries and track conversion error residuals.

import "./proj_utm_conversion.oo";
import "./proj_web_mercator.oo";
import "./geocentric_ecef_converter.oo";
import "./proj_geodetic_datum.oo";

pub type TransformPipelineResult = struct {
    out_x: Float,
    out_y: Float,
    out_z: Float,
    target_crs: String,
    success: Bool
};

// Pipeline: Geodetic WGS84 (Lat, Lon, Alt) -> UTM Planar (Easting, Northing, Alt)
pub fn transform_wgs84_to_utm(
    lat_deg: Float,
    lon_deg: Float,
    alt_m: Float
) -> TransformPipelineResult {
    let utm = utm_forward(lat_deg, lon_deg);
    return TransformPipelineResult {
        out_x: (utm).easting,
        out_y: (utm).northing,
        out_z: alt_m,
        target_crs: "EPSG:32600",
        success: true
    };
}

// Pipeline: Geodetic WGS84 (Lat, Lon, Alt) -> Web Mercator (X, Y, Alt)
pub fn transform_wgs84_to_mercator(
    lat_deg: Float,
    lon_deg: Float,
    alt_m: Float
) -> TransformPipelineResult {
    let merc = web_mercator_forward(lat_deg, lon_deg);
    return TransformPipelineResult {
        out_x: (merc).x,
        out_y: (merc).y,
        out_z: alt_m,
        target_crs: "EPSG:3857",
        success: true
    };
}
