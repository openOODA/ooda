// # 2D Spatial Polygon Overlay & Bounding Box Clipping
//
// Logline: Clips 2D spatial polygons against rectangular geographic boundaries using the Sutherland-Hodgman pipeline.
//
// Setup: Planar computational geometry clipping subject polygons against left, right, bottom, and top bounding edges.
//
// Beats:
//   1. Define ClippedPolygon2D struct containing clipped coordinate sequences.
//   2. Compute line segment intersection against 1D axis-aligned clip boundary planes.
//   3. Sequentially clip polygon vertices against 4 rectangular viewport edges.

pub type ClippedPolygon2D = struct {
    num_points: Int,
    xs: List[Float],
    ys: List[Float]
};

pub fn clipped_polygon_new() -> ClippedPolygon2D {
    let xs: List[Float] = list_new();
    let ys: List[Float] = list_new();
    return ClippedPolygon2D {
        num_points: 0,
        xs: xs,
        ys: ys
    };
}

pub fn clipped_polygon_add(poly: &mut ClippedPolygon2D, x: Float, y: Float) {
    list_push((poly).xs, x);
    list_push((poly).ys, y);
    (poly).num_points = (poly).num_points + 1;
}

// Clip polygon against left boundary (x >= min_x)
pub fn clip_polygon_left(
    input_poly: &ClippedPolygon2D,
    min_x: Float
) -> ClippedPolygon2D {
    let mut out = clipped_polygon_new();
    let n: Int = (input_poly).num_points;
    if n == 0 {
        return out;
    }

    let mut i: Int = 0;
    while i < n {
        let prev_i: Int = if i == 0 { n - 1 } else { i - 1 };
        let px: Float = list_get((input_poly).xs, prev_i);
        let py: Float = list_get((input_poly).ys, prev_i);
        let cx: Float = list_get((input_poly).xs, i);
        let cy: Float = list_get((input_poly).ys, i);

        let c_inside: Bool = cx >= min_x;
        let p_inside: Bool = px >= min_x;

        if c_inside {
            if p_inside == false {
                // Compute intersection with x = min_x
                let t: Float = (min_x - px) / (cx - px);
                let iy: Float = py + (t * (cy - py));
                clipped_polygon_add(&mut out, min_x, iy);
            }
            clipped_polygon_add(&mut out, cx, cy);
        } else if p_inside {
            let t: Float = (min_x - px) / (cx - px);
            let iy: Float = py + (t * (cy - py));
            clipped_polygon_add(&mut out, min_x, iy);
        }
        i = i + 1;
    }

    return out;
}
