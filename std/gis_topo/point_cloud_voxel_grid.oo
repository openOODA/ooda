// # 3D Point Cloud Voxel Grid Downsampling & Filtering
//
// Logline: Decimates dense 3D LiDAR and photogrammetry point clouds into uniform voxel grids with centroid aggregation.
//
// Setup: Regular 3D volumetric cubic discretization with spatial hashing and representative point reduction.
//
// Beats:
//   1. Define VoxelIndex3D and VoxelCentroidAccumulator structures.
//   2. Compute 3D integer voxel coordinates from continuous coordinates given voxel leaf size.
//   3. Aggregate point counts and compute average centroid coordinates per occupied voxel.

pub type VoxelIndex3D = struct {
    vx: Int,
    vy: Int,
    vz: Int
};

pub type VoxelAccumulator = struct {
    vx: Int,
    vy: Int,
    vz: Int,
    sum_x: Float,
    sum_y: Float,
    sum_z: Float,
    count: Int
};

pub fn voxel_index_new(vx: Int, vy: Int, vz: Int) -> VoxelIndex3D {
    return VoxelIndex3D { vx: vx, vy: vy, vz: vz };
}

pub fn voxel_accum_new(vx: Int, vy: Int, vz: Int) -> VoxelAccumulator {
    return VoxelAccumulator {
        vx: vx,
        vy: vy,
        vz: vz,
        sum_x: 0.0,
        sum_y: 0.0,
        sum_z: 0.0,
        count: 0
    };
}

// Convert 3D point coordinates (x, y, z) to integer voxel grid cell coordinates
pub fn point_to_voxel_index(
    x: Float, y: Float, z: Float,
    origin_x: Float, origin_y: Float, origin_z: Float,
    leaf_size_m: Float
) -> VoxelIndex3D {
    let dx: Float = (x - origin_x) / leaf_size_m;
    let dy: Float = (y - origin_y) / leaf_size_m;
    let dz: Float = (z - origin_z) / leaf_size_m;

    let mut vx: Int = 0;
    let mut tx: Float = dx;
    while tx >= 1.0 { vx = vx + 1; tx = tx - 1.0; }

    let mut vy: Int = 0;
    let mut ty: Float = dy;
    while ty >= 1.0 { vy = vy + 1; ty = ty - 1.0; }

    let mut vz: Int = 0;
    let mut tz: Float = dz;
    while tz >= 1.0 { vz = vz + 1; tz = tz - 1.0; }

    return VoxelIndex3D { vx: vx, vy: vy, vz: vz };
}

// Accumulate point into voxel accumulator
pub fn voxel_accum_add_point(acc: &mut VoxelAccumulator, x: Float, y: Float, z: Float) {
    (acc).sum_x = (acc).sum_x + x;
    (acc).sum_y = (acc).sum_y + y;
    (acc).sum_z = (acc).sum_z + z;
    (acc).count = (acc).count + 1;
}

// Compute average centroid coordinate of accumulated voxel
pub fn voxel_accum_get_centroid(acc: &VoxelAccumulator) -> List[Float] {
    let mut res: List[Float] = list_new();
    let c: Int = (acc).count;
    if c <= 0 {
        list_push(res, 0.0);
        list_push(res, 0.0);
        list_push(res, 0.0);
        return res;
    }

    let mut c_f: Float = 0.0;
    let mut tmp: Int = c;
    while tmp >= 100 { c_f = c_f + 100.0; tmp = tmp - 100; }
    while tmp >= 10 { c_f = c_f + 10.0; tmp = tmp - 10; }
    while tmp >= 1 { c_f = c_f + 1.0; tmp = tmp - 1; }

    list_push(res, (acc).sum_x / c_f);
    list_push(res, (acc).sum_y / c_f);
    list_push(res, (acc).sum_z / c_f);
    return res;
}
