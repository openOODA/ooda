// # CityGML Level-of-Detail (LoD) 3D Building Geometry
//
// Logline: Constructs 3D urban building models across CityGML Levels of Detail (LoD1 box prism, LoD2 multi-pitch roofs, LoD3 facades).
//
// Setup: OGC CityGML 3.0 semantic 3D city models, building envelope extrusions, and rooftop geometry classification.
//
// Beats:
//   1. Define CityGmlBuilding struct with LoD level (0-4), footprint vertices, height, and roof type.
//   2. Extrude 2D building footprint polygons into vertical 3D prism volumes (LoD1).
//   3. Compute roof ridge vertex heights for standard roof shapes (Flat, Gabled, Hipped).

pub type CityGmlBuilding = struct {
    id: String,
    lod_level: Int, // 1 = Prism, 2 = Roof shape, 3 = Detailed facade
    ground_elevation_m: Float,
    eaves_height_m: Float,
    roof_height_m: Float,
    roof_type: String, // "Flat", "Gabled", "Hipped", "Pyramidal"
    num_footprint_vertices: Int,
    footprint_x: List[Float],
    footprint_y: List[Float],
};

pub fn citygml_building_new(
    id: String,
    lod: Int,
    ground_z: Float,
    eaves_h: Float,
    roof_h: Float,
    roof_type: String
) -> CityGmlBuilding {
    let xs: List[Float] = list_new();
    let ys: List[Float] = list_new();
    return CityGmlBuilding {
        id: id,
        lod_level: lod,
        ground_elevation_m: ground_z,
        eaves_height_m: eaves_h,
        roof_height_m: roof_h,
        roof_type: roof_type,
        num_footprint_vertices: 0,
        footprint_x: xs,
        footprint_y: ys,
    };
}

pub fn citygml_add_footprint_vertex(b: &mut CityGmlBuilding, x: Float, y: Float) {
    list_push((b).footprint_x, x);
    list_push((b).footprint_y, y);
    (b).num_footprint_vertices = (b).num_footprint_vertices + 1;
}

// Compute total maximum building height above ground
pub fn citygml_total_height(b: &CityGmlBuilding) -> Float {
    return (b).eaves_height_m + (b).roof_height_m;
}

// Compute 2D polygon footprint area using Shoelace formula
pub fn citygml_footprint_area(b: &CityGmlBuilding) -> Float {
    let n: Int = (b).num_footprint_vertices;
    if n < 3 {
        return 0.0;
    }

    let mut area_sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let next_i: Int = if (i + 1) == n { 0 } else { i + 1 };
        let xi: Float = list_get((b).footprint_x, i);
        let yi: Float = list_get((b).footprint_y, i);
        let x_next: Float = list_get((b).footprint_x, next_i);
        let y_next: Float = list_get((b).footprint_y, next_i);

        area_sum = area_sum + ((xi * y_next) - (x_next * yi));
        i = i + 1;
    }

    let abs_area: Float = if area_sum < 0.0 { 0.0 - area_sum } else { area_sum };
    return 0.5 * abs_area;
}

// Compute gross 3D building volume in cubic meters (LoD1 prism approximation)
pub fn citygml_lod1_volume_m3(b: &CityGmlBuilding) -> Float {
    let area: Float = citygml_footprint_area(b);
    let avg_height: Float = (b).eaves_height_m + ((b).roof_height_m * 0.5);
    return area * avg_height;
}
