// # GeoJSON FeatureCollection & Spatial Features
//
// Logline: Models RFC 7946 GeoJSON Feature, FeatureCollection, spatial attributes, and bounding box envelopes.
//
// Setup: Hierarchical JSON-compatible geospatial vector data structures.
//
// Beats:
//   1. Define GeoJsonFeature and GeoJsonFeatureCollection structs.
//   2. Manage feature properties as key-value pairs and feature lists.
//   3. Compute aggregate bounding box (bbox) for whole FeatureCollection.

pub type GeoJsonFeature = struct {
    id: String,
    geom_type: String,
    num_coords: Int,
    coords_x: List[Float],
    coords_y: List[Float],
    coords_z: List[Float]
};

pub type GeoJsonFeatureCollection = struct {
    num_features: Int,
    features: List[GeoJsonFeature],
    bbox_min_x: Float,
    bbox_min_y: Float,
    bbox_max_x: Float,
    bbox_max_y: Float
};

pub fn geojson_feature_new(id: String, geom_type: String) -> GeoJsonFeature {
    let xs: List[Float] = list_new();
    let ys: List[Float] = list_new();
    let zs: List[Float] = list_new();
    return GeoJsonFeature {
        id: id,
        geom_type: geom_type,
        num_coords: 0,
        coords_x: xs,
        coords_y: ys,
        coords_z: zs
    };
}

pub fn geojson_feature_add_point_3d(f: &mut GeoJsonFeature, x: Float, y: Float, z: Float) {
    list_push((f).coords_x, x);
    list_push((f).coords_y, y);
    list_push((f).coords_z, z);
    (f).num_coords = (f).num_coords + 1;
}

pub fn geojson_feature_collection_new() -> GeoJsonFeatureCollection {
    let feat_list: List[GeoJsonFeature] = list_new();
    return GeoJsonFeatureCollection {
        num_features: 0,
        features: feat_list,
        bbox_min_x: 0.0,
        bbox_min_y: 0.0,
        bbox_max_x: 0.0,
        bbox_max_y: 0.0
    };
}

pub fn geojson_collection_add_feature(col: &mut GeoJsonFeatureCollection, feat: GeoJsonFeature) {
    list_push((col).features, feat);
    (col).num_features = (col).num_features + 1;
}

// Compute aggregate 2D bounding box for all features in collection
pub fn geojson_collection_update_bbox(col: &mut GeoJsonFeatureCollection) {
    let n: Int = (col).num_features;
    if n == 0 {
        return;
    }

    let mut min_x: Float = 999999999.0;
    let mut max_x: Float = -999999999.0;
    let mut min_y: Float = 999999999.0;
    let mut max_y: Float = -999999999.0;

    let mut i: Int = 0;
    while i < n {
        let f: GeoJsonFeature = list_get((col).features, i);
        let num_pts: Int = (f).num_coords;
        let mut p: Int = 0;
        while p < num_pts {
            let px: Float = list_get((f).coords_x, p);
            let py: Float = list_get((f).coords_y, p);
            if px < min_x { min_x = px; }
            if px > max_x { max_x = px; }
            if py < min_y { min_y = py; }
            if py > max_y { max_y = py; }
            p = p + 1;
        }
        i = i + 1;
    }

    (col).bbox_min_x = min_x;
    (col).bbox_min_y = min_y;
    (col).bbox_max_x = max_x;
    (col).bbox_max_y = max_y;
}
