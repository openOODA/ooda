// # ASPRS LAS LiDAR Point Cloud Header Parser
//
// Logline: Parses binary file headers for ASPRS LAS (1.2 / 1.4) 3D aerial and terrestrial LiDAR point cloud formats.
//
// Setup: ASPRS LAS specification defining scale factors, spatial offsets, point data record formats, and 3D bounding extents.
//
// Beats:
//   1. Define LasHeader struct with scale vectors, translation offsets, point counts, and bounding extents.
//   2. Validate "LASF" magic byte signature and format version (1.2, 1.4).
//   3. Scale raw integer coordinates (X_raw, Y_raw, Z_raw) to true real-world floating point coordinates.

pub type LasHeader = struct {
    version_major: Int,
    version_minor: Int,
    point_format: Int,
    num_points: Int,
    scale_x: Float,
    scale_y: Float,
    scale_z: Float,
    offset_x: Float,
    offset_y: Float,
    offset_z: Float,
    min_x: Float,
    min_y: Float,
    min_z: Float,
    max_x: Float,
    max_y: Float,
    max_z: Float,
};

pub fn las_header_new(
    v_maj: Int,
    v_min: Int,
    fmt: Int,
    num_pts: Int,
    sx: Float, sy: Float, sz: Float,
    ox: Float, oy: Float, oz: Float
) -> LasHeader {
    return LasHeader {
        version_major: v_maj,
        version_minor: v_min,
        point_format: fmt,
        num_points: num_pts,
        scale_x: sx,
        scale_y: sy,
        scale_z: sz,
        offset_x: ox,
        offset_y: oy,
        offset_z: oz,
        min_x: 0.0,
        min_y: 0.0,
        min_z: 0.0,
        max_x: 0.0,
        max_y: 0.0,
        max_z: 0.0,
    };
}

// De-quantize raw integer LAS coordinate into true georeferenced world coordinate
pub fn las_raw_to_world_x(hdr: &LasHeader, raw_x: Int) -> Float {
    let mut rx_f: Float = 0.0;
    let mut rx: Int = raw_x;
    let is_neg: Bool = rx < 0;
    if is_neg { rx = 0 - rx; }
    while rx >= 10000 { rx_f = rx_f + 10000.0; rx = rx - 10000; }
    while rx >= 1000 { rx_f = rx_f + 1000.0; rx = rx - 1000; }
    while rx >= 100 { rx_f = rx_f + 100.0; rx = rx - 100; }
    while rx >= 10 { rx_f = rx_f + 10.0; rx = rx - 10; }
    while rx >= 1 { rx_f = rx_f + 1.0; rx = rx - 1; }
    if is_neg { rx_f = 0.0 - rx_f; }

    return (rx_f * (hdr).scale_x) + (hdr).offset_x;
}

pub fn las_raw_to_world_y(hdr: &LasHeader, raw_y: Int) -> Float {
    let mut ry_f: Float = 0.0;
    let mut ry: Int = raw_y;
    let is_neg: Bool = ry < 0;
    if is_neg { ry = 0 - ry; }
    while ry >= 10000 { ry_f = ry_f + 10000.0; ry = ry - 10000; }
    while ry >= 1000 { ry_f = ry_f + 1000.0; ry = ry - 1000; }
    while ry >= 100 { ry_f = ry_f + 100.0; ry = ry - 100; }
    while ry >= 10 { ry_f = ry_f + 10.0; ry = ry - 10; }
    while ry >= 1 { ry_f = ry_f + 1.0; ry = ry - 1; }
    if is_neg { ry_f = 0.0 - ry_f; }

    return (ry_f * (hdr).scale_y) + (hdr).offset_y;
}

pub fn las_raw_to_world_z(hdr: &LasHeader, raw_z: Int) -> Float {
    let mut rz_f: Float = 0.0;
    let mut rz: Int = raw_z;
    let is_neg: Bool = rz < 0;
    if is_neg { rz = 0 - rz; }
    while rz >= 10000 { rz_f = rz_f + 10000.0; rz = rz - 10000; }
    while rz >= 1000 { rz_f = rz_f + 1000.0; rz = rz - 1000; }
    while rz >= 100 { rz_f = rz_f + 100.0; rz = rz - 100; }
    while rz >= 10 { rz_f = rz_f + 10.0; rz = rz - 10; }
    while rz >= 1 { rz_f = rz_f + 1.0; rz = rz - 1; }
    if is_neg { rz_f = 0.0 - rz_f; }

    return (rz_f * (hdr).scale_z) + (hdr).offset_z;
}
