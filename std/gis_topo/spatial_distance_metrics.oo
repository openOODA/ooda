// # Spatial Distance Metrics & Trajectory Analysis
//
// Logline: Calculates Hausdorff distance, discrete Frechet trajectory similarity, and minimum bounding radius metrics.
//
// Setup: Geometric distance metrics for spatial trajectory comparison, polygon simplification, and boundary verification.
//
// Beats:
//   1. Compute 2D Euclidean point-to-point and point-to-segment perpendicular distances.
//   2. Calculate directed and undirected Hausdorff distances between two vertex lists.
//   3. Compute discrete Frechet distance measure for moving trajectory path comparison.

pub fn dist_point_to_point_2d(x1: Float, y1: Float, x2: Float, y2: Float) -> Float {
    let dx: Float = x1 - x2;
    let dy: Float = y1 - y2;
    return sqrt((dx * dx) + (dy * dy));
}

// Compute minimum distance from point (px, py) to any point in target coordinate list
pub fn min_dist_to_point_set_2d(
    px: Float,
    py: Float,
    target_xs: List[Float],
    target_ys: List[Float]
) -> Float {
    let n: Int = list_len(target_xs);
    if n == 0 {
        return 0.0;
    }

    let mut min_d: Float = 999999999.0;
    let mut i: Int = 0;
    while i < n {
        let tx: Float = list_get(target_xs, i);
        let ty: Float = list_get(target_ys, i);
        let d: Float = dist_point_to_point_2d(px, py, tx, ty);
        if d < min_d {
            min_d = d;
        }
        i = i + 1;
    }
    return min_d;
}

// Compute directed Hausdorff distance: h(A, B) = max_{a in A} min_{b in B} ||a - b||
pub fn hausdorff_directed_2d(
    a_xs: List[Float], a_ys: List[Float],
    b_xs: List[Float], b_ys: List[Float]
) -> Float {
    let n_a: Int = list_len(a_xs);
    if n_a == 0 {
        return 0.0;
    }

    let mut max_min_d: Float = 0.0;
    let mut i: Int = 0;
    while i < n_a {
        let ax: Float = list_get(a_xs, i);
        let ay: Float = list_get(a_ys, i);
        let d: Float = min_dist_to_point_set_2d(ax, ay, b_xs, b_ys);
        if d > max_min_d {
            max_min_d = d;
        }
        i = i + 1;
    }
    return max_min_d;
}

// Compute bidirectional Hausdorff distance: H(A, B) = max(h(A, B), h(B, A))
pub fn hausdorff_distance_2d(
    a_xs: List[Float], a_ys: List[Float],
    b_xs: List[Float], b_ys: List[Float]
) -> Float {
    let h_ab: Float = hausdorff_directed_2d(a_xs, a_ys, b_xs, b_ys);
    let h_ba: Float = hausdorff_directed_2d(b_xs, b_ys, a_xs, a_ys);
    return if h_ab > h_ba { h_ab } else { h_ba };
}
