// # S2 Spherical Polyline Metrics & Geodesic Length
//
// Logline: Measures great-circle polyline lengths, vertex interpolation, and cross-track deviations on the S2 sphere.
//
// Setup: Spherical polyline sequences of S2LatLng vertices, spherical arc interpolation, and segment projections.
//
// Beats:
//   1. Define S2Polyline struct containing ordered list of S2LatLng vertices.
//   2. Calculate total cumulative geodesic length of polyline in meters.
//   3. Interpolate points along polyline by normalized fractional distance [0.0, 1.0].

import "./s2_lat_lng_point.oo";

pub type S2Polyline = struct {
    num_vertices: Int,
    vertices: List[S2LatLng],
};

pub fn s2_polyline_new() -> S2Polyline {
    let list: List[S2LatLng] = list_new();
    return S2Polyline {
        num_vertices: 0,
        vertices: list,
    };
}

pub fn s2_polyline_add_vertex(poly: &mut S2Polyline, vertex: S2LatLng) {
    list_push((poly).vertices, vertex);
    (poly).num_vertices = (poly).num_vertices + 1;
}

// Compute cumulative geodesic length of polyline in meters
pub fn s2_polyline_length_meters(poly: &S2Polyline) -> Float {
    let count: Int = (poly).num_vertices;
    if count < 2 {
        return 0.0;
    }

    let mut total_m: Float = 0.0;
    let mut i: Int = 0;
    while i < (count - 1) {
        let v1: S2LatLng = list_get((poly).vertices, i);
        let v2: S2LatLng = list_get((poly).vertices, i + 1);
        let seg_len: Float = s2_distance_meters(&v1, &v2);
        total_m = total_m + seg_len;
        i = i + 1;
    }
    return total_m;
}

// Linearly interpolate between two LatLng points with fraction t in [0.0, 1.0]
pub fn s2_lat_lng_interpolate(v1: &S2LatLng, v2: &S2LatLng, t: Float) -> S2LatLng {
    let lat: Float = (v1).lat_deg + (t * ((v2).lat_deg - (v1).lat_deg));
    let lng: Float = (v1).lng_deg + (t * ((v2).lng_deg - (v1).lng_deg));
    return S2LatLng {
        lat_deg: lat,
        lng_deg: lng,
    };
}

// Sample point along polyline at fraction t [0.0, 1.0]
pub fn s2_polyline_sample_at(poly: &S2Polyline, t: Float) -> S2LatLng {
    let count: Int = (poly).num_vertices;
    if count == 0 {
        return S2LatLng { lat_deg: 0.0, lng_deg: 0.0 };
    }
    if count == 1 {
        let v0: S2LatLng = list_get((poly).vertices, 0);
        return v0;
    }
    if t <= 0.0 {
        let v0: S2LatLng = list_get((poly).vertices, 0);
        return v0;
    }
    if t >= 1.0 {
        let v_last: S2LatLng = list_get((poly).vertices, count - 1);
        return v_last;
    }

    let num_segments: Int = count - 1;
    let mut num_seg_f: Float = 0.0;
    let mut n: Int = num_segments;
    while n >= 10 { num_seg_f = num_seg_f + 10.0; n = n - 10; }
    while n >= 1 { num_seg_f = num_seg_f + 1.0; n = n - 1; }

    let scaled: Float = t * num_seg_f;
    let mut seg_idx: Int = 0;
    let mut rem: Float = scaled;
    while (rem >= 1.0) && (seg_idx < (num_segments - 1)) {
        rem = rem - 1.0;
        seg_idx = seg_idx + 1;
    }

    let p1: S2LatLng = list_get((poly).vertices, seg_idx);
    let p2: S2LatLng = list_get((poly).vertices, seg_idx + 1);
    return s2_lat_lng_interpolate(&p1, &p2, rem);
}
