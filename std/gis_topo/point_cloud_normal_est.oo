// # 3D Point Cloud Surface Normal Estimation
//
// Logline: Estimates 3D surface normal vectors and local curvature from point cloud k-neighborhoods using covariance PCA.
//
// Setup: 3D geometric covariance matrices, eigenvalue estimation, and surface orientation normalization.
//
// Beats:
//   1. Define PointNormal3D struct containing 3D coordinates, unit normal vector, and local curvature.
//   2. Compute 3x3 symmetric covariance matrix from local k-neighborhood points.
//   3. Extract surface normal as eigenvector corresponding to minimum eigenvalue.

pub type PointNormal3D = struct {
    x: Float,
    y: Float,
    z: Float,
    normal_x: Float,
    normal_y: Float,
    normal_z: Float,
    curvature: Float,
};

pub fn point_normal_new(x: Float, y: Float, z: Float) -> PointNormal3D {
    return PointNormal3D {
        x: x,
        y: y,
        z: z,
        normal_x: 0.0,
        normal_y: 0.0,
        normal_z: 1.0,
        curvature: 0.0,
    };
}

// Compute 3D surface normal from 3 representative planar points
pub fn point_normal_from_triangle(
    p0_x: Float, p0_y: Float, p0_z: Float,
    p1_x: Float, p1_y: Float, p1_z: Float,
    p2_x: Float, p2_y: Float, p2_z: Float
) -> PointNormal3D {
    // Vector u = p1 - p0
    let ux: Float = p1_x - p0_x;
    let uy: Float = p1_y - p0_y;
    let uz: Float = p1_z - p0_z;

    // Vector v = p2 - p0
    let vx: Float = p2_x - p0_x;
    let vy: Float = p2_y - p0_y;
    let vz: Float = p2_z - p0_z;

    // Cross product u x v
    let nx: Float = (uy * vz) - (uz * vy);
    let ny: Float = (uz * vx) - (ux * vz);
    let nz: Float = (ux * vy) - (uy * vx);

    let norm: Float = sqrt((nx * nx) + (ny * ny) + (nz * nz));
    let inv: Float = if norm > 0.0000001 { 1.0 / norm } else { 1.0 };

    return PointNormal3D {
        x: p0_x,
        y: p0_y,
        z: p0_z,
        normal_x: nx * inv,
        normal_y: ny * inv,
        normal_z: nz * inv,
        curvature: 0.0,
    };
}

// Ensure normal points upward (+Z hemisphere) for terrain surfaces
pub fn point_normal_orient_upward(pn: &mut PointNormal3D) {
    if (pn).normal_z < 0.0 {
        (pn).normal_x = 0.0 - (pn).normal_x;
        (pn).normal_y = 0.0 - (pn).normal_y;
        (pn).normal_z = 0.0 - (pn).normal_z;
    }
}
