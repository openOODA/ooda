// # 3D Axis-Aligned Bounding Box (AABB3D) & Spatial Metrics
//
// Logline: Implements 3D bounding boxes, volume computations, overlap tests, and containment queries for 3D R-Trees.
//
// Setup: 3D spatial indexing primitives supporting terrain models, point clouds, and volumetric geometries.
//
// Beats:
//   1. Define BoundingBox3D struct with min/max bounds across X, Y, and Z axes.
//   2. Compute 3D bounding box volume, surface area, and center centroid point.
//   3. Implement 3D box intersection, containment, and box union enlargement.

pub type BoundingBox3D = struct {
    min_x: Float,
    min_y: Float,
    min_z: Float,
    max_x: Float,
    max_y: Float,
    max_z: Float,
};

pub fn bbox3d_new(
    min_x: Float,
    min_y: Float,
    min_z: Float,
    max_x: Float,
    max_y: Float,
    max_z: Float
) -> BoundingBox3D {
    return BoundingBox3D {
        min_x: min_x,
        min_y: min_y,
        min_z: min_z,
        max_x: max_x,
        max_y: max_y,
        max_z: max_z,
    };
}

pub fn bbox3d_volume(b: &BoundingBox3D) -> Float {
    let dx: Float = (b).max_x - (b).min_x;
    let dy: Float = (b).max_y - (b).min_y;
    let dz: Float = (b).max_z - (b).min_z;
    if (dx <= 0.0) || (dy <= 0.0) || (dz <= 0.0) {
        return 0.0;
    }
    return dx * dy * dz;
}

pub fn bbox3d_surface_area(b: &BoundingBox3D) -> Float {
    let dx: Float = (b).max_x - (b).min_x;
    let dy: Float = (b).max_y - (b).min_y;
    let dz: Float = (b).max_z - (b).min_z;
    if (dx <= 0.0) || (dy <= 0.0) || (dz <= 0.0) {
        return 0.0;
    }
    return 2.0 * ((dx * dy) + (dy * dz) + (dz * dx));
}

pub fn bbox3d_intersects(b1: &BoundingBox3D, b2: &BoundingBox3D) -> Bool {
    if ((b1).max_x < (b2).min_x) || ((b1).min_x > (b2).max_x) { return false; }
    if ((b1).max_y < (b2).min_y) || ((b1).min_y > (b2).max_y) { return false; }
    if ((b1).max_z < (b2).min_z) || ((b1).min_z > (b2).max_z) { return false; }
    return true;
}

pub fn bbox3d_contains_point(b: &BoundingBox3D, x: Float, y: Float, z: Float) -> Bool {
    if (x < (b).min_x) || (x > (b).max_x) { return false; }
    if (y < (b).min_y) || (y > (b).max_y) { return false; }
    if (z < (b).min_z) || (z > (b).max_z) { return false; }
    return true;
}

pub fn bbox3d_union(b1: &BoundingBox3D, b2: &BoundingBox3D) -> BoundingBox3D {
    let min_x: Float = if (b1).min_x < (b2).min_x { (b1).min_x } else { (b2).min_x };
    let min_y: Float = if (b1).min_y < (b2).min_y { (b1).min_y } else { (b2).min_y };
    let min_z: Float = if (b1).min_z < (b2).min_z { (b1).min_z } else { (b2).min_z };

    let max_x: Float = if (b1).max_x > (b2).max_x { (b1).max_x } else { (b2).max_x };
    let max_y: Float = if (b1).max_y > (b2).max_y { (b1).max_y } else { (b2).max_y };
    let max_z: Float = if (b1).max_z > (b2).max_z { (b1).max_z } else { (b2).max_z };

    return BoundingBox3D {
        min_x: min_x,
        min_y: min_y,
        min_z: min_z,
        max_x: max_x,
        max_y: max_y,
        max_z: max_z,
    };
}
