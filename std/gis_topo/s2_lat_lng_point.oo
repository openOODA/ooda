// # S2 Spherical Lat/Lng and 3D Unit Vector Projection
//
// Logline: Converts between geographic latitude/longitude coordinates and unit 3D Cartesian vectors on the unit sphere.
//
// Setup: Spherical trigonometry, radians/degrees conversions, and 3D Euclidean vector dot and cross products.
//
// Beats:
//   1. Define S2LatLng and S2Point3D unit vector structs.
//   2. Convert spherical (lat, lng) to (x, y, z) on unit sphere and vice versa.
//   3. Compute spherical angle, great circle angular distance, and dot product metrics.

pub type S2LatLng = struct {
    lat_deg: Float,
    lng_deg: Float
};

pub type S2Point3D = struct {
    x: Float,
    y: Float,
    z: Float
};

pub fn s2_lat_lng_new(lat: Float, lng: Float) -> S2LatLng {
    return S2LatLng {
        lat_deg: lat,
        lng_deg: lng
    };
}

pub fn s2_point_new(x: Float, y: Float, z: Float) -> S2Point3D {
    let norm: Float = sqrt((x * x) + (y * y) + (z * z));
    let inv: Float = if norm > 0.000000001 { 1.0 / norm } else { 1.0 };
    return S2Point3D {
        x: x * inv,
        y: y * inv,
        z: z * inv
    };
}

pub fn s2_deg_to_rad(deg: Float) -> Float {
    return deg * 0.017453292519943295;
}

pub fn s2_rad_to_deg(rad: Float) -> Float {
    return rad * 57.29577951308232;
}

// Convert S2LatLng to 3D Cartesian unit vector on unit sphere
pub fn s2_lat_lng_to_point(ll: &S2LatLng) -> S2Point3D {
    let phi: Float = s2_deg_to_rad((ll).lat_deg);
    let theta: Float = s2_deg_to_rad((ll).lng_deg);

    let cos_phi: Float = cos(phi);
    let sin_phi: Float = sin(phi);
    let cos_theta: Float = cos(theta);
    let sin_theta: Float = sin(theta);

    return S2Point3D {
        x: cos_phi * cos_theta,
        y: cos_phi * sin_theta,
        z: sin_phi
    };
}

// Compute dot product between two S2 unit vector points
pub fn s2_point_dot(p1: &S2Point3D, p2: &S2Point3D) -> Float {
    return ((p1).x * (p2).x) + ((p1).y * (p2).y) + ((p1).z * (p2).z);
}

// Compute angular distance (radians) between two points on sphere
pub fn s2_angular_distance_rad(p1: &S2Point3D, p2: &S2Point3D) -> Float {
    let dot: Float = s2_point_dot(p1, p2);
    let clamped_dot: Float = if dot > 1.0 { 1.0 } else { if dot < -1.0 { -1.0 } else { dot } };
    // Small angle approximation: angle ~= sqrt(2 * (1 - dot))
    if clamped_dot >= 1.0 {
        return 0.0;
    }
    return sqrt(2.0 * (1.0 - clamped_dot));
}

// Compute great-circle surface distance in meters (Earth radius ~ 6,371,008m)
pub fn s2_distance_meters(ll1: &S2LatLng, ll2: &S2LatLng) -> Float {
    let p1 = s2_lat_lng_to_point(ll1);
    let p2 = s2_lat_lng_to_point(ll2);
    let rad: Float = s2_angular_distance_rad(&p1, &p2);
    let earth_radius_m: Float = 6371008.8;
    return rad * earth_radius_m;
}
