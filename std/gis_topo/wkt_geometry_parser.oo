// # Well-Known Text (WKT) Geometry Parser
//
// Logline: Parses OGC Well-Known Text (WKT) representations for POINT, LINESTRING, and POLYGON spatial geometries.
//
// Setup: Lexing and parsing of OGC Simple Features standard text geometry formats.
//
// Beats:
//   1. Identify geometry type from WKT keyword header (POINT, LINESTRING, POLYGON).
//   2. Parse coordinate pairs and tuples from parenthesized coordinate lists.
//   3. Construct parsed geometry structures and extract bounding limits.

pub type WktGeometry = struct {
    geom_type: String, // "POINT", "LINESTRING", "POLYGON", "EMPTY"
    num_coords: Int,
    coords_x: List[Float],
    coords_y: List[Float],
};

pub fn wkt_geometry_new(geom_type: String) -> WktGeometry {
    let xs: List[Float] = list_new();
    let ys: List[Float] = list_new();
    return WktGeometry {
        geom_type: geom_type,
        num_coords: 0,
        coords_x: xs,
        coords_y: ys,
    };
}

pub fn wkt_add_coord(geom: &mut WktGeometry, x: Float, y: Float) {
    list_push((geom).coords_x, x);
    list_push((geom).coords_y, y);
    (geom).num_coords = (geom).num_coords + 1;
}

// Detect geometry type from beginning of WKT string
pub fn wkt_detect_type(wkt: String) -> String {
    if str_starts_with(wkt, "POINT") {
        return "POINT";
    }
    if str_starts_with(wkt, "LINESTRING") {
        return "LINESTRING";
    }
    if str_starts_with(wkt, "POLYGON") {
        return "POLYGON";
    }
    if str_starts_with(wkt, "MULTIPOINT") {
        return "MULTIPOINT";
    }
    if str_starts_with(wkt, "MULTILINESTRING") {
        return "MULTILINESTRING";
    }
    if str_starts_with(wkt, "MULTIPOLYGON") {
        return "MULTIPOLYGON";
    }
    return "UNKNOWN";
}

// Check if WKT represents an EMPTY geometry
pub fn wkt_is_empty(wkt: String) -> Bool {
    return str_index_of(wkt, "EMPTY") >= 0;
}

// Extract bounding envelope [min_x, min_y, max_x, max_y] of parsed WKT geometry
pub fn wkt_envelope(geom: &WktGeometry) -> List[Float] {
    let mut env: List[Float] = list_new();
    let count: Int = (geom).num_coords;
    if count == 0 {
        list_push(env, 0.0);
        list_push(env, 0.0);
        list_push(env, 0.0);
        list_push(env, 0.0);
        return env;
    }

    let mut min_x: Float = list_get((geom).coords_x, 0);
    let mut max_x: Float = min_x;
    let mut min_y: Float = list_get((geom).coords_y, 0);
    let mut max_y: Float = min_y;

    let mut i: Int = 1;
    while i < count {
        let x: Float = list_get((geom).coords_x, i);
        let y: Float = list_get((geom).coords_y, i);
        if x < min_x { min_x = x; }
        if x > max_x { max_x = x; }
        if y < min_y { min_y = y; }
        if y > max_y { max_y = y; }
        i = i + 1;
    }

    list_push(env, min_x);
    list_push(env, min_y);
    list_push(env, max_x);
    list_push(env, max_y);
    return env;
}
