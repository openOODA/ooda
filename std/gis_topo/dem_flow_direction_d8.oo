// # D8 Hydrological Flow Direction Algorithm
//
// Logline: Determines surface water flow paths across digital elevation models using the deterministic 8-direction (D8) steepest descent method.
//
// Setup: Raster digital elevation grids, 8-neighbor directional connectivity, and topographic pit/sink detection.
//
// Beats:
//   1. Define standard ESRI D8 flow direction encoding bitmasks (1, 2, 4, 8, 16, 32, 64, 128).
//   2. Compute maximum downward slope drop across 8 neighboring cells with diagonal scaling.
//   3. Classify sink/pit depressions where no adjacent neighbor has lower elevation.

import "./geotiff_elevation_raster.oo";

pub fn d8_code_east() -> Int { return 1; }
pub fn d8_code_southeast() -> Int { return 2; }
pub fn d8_code_south() -> Int { return 4; }
pub fn d8_code_southwest() -> Int { return 8; }
pub fn d8_code_west() -> Int { return 16; }
pub fn d8_code_northwest() -> Int { return 32; }
pub fn d8_code_north() -> Int { return 64; }
pub fn d8_code_northeast() -> Int { return 128; }
pub fn d8_code_sink() -> Int { return 0; }

// Compute D8 flow direction code for raster cell (col, row)
pub fn dem_calc_d8_flow_direction(
    grid: &DemRasterGrid,
    col: Int,
    row: Int
) -> Int {
    let z_c: Float = dem_raster_get_value(grid, col, row);
    if z_c == (grid).nodata_value {
        return d8_code_sink();
    }

    let dx: Float = (grid).pixel_size_x;
    let dy: Float = (grid).pixel_size_y;
    let diag: Float = sqrt((dx * dx) + (dy * dy));

    let mut max_drop: Float = 0.0;
    let mut best_dir: Int = d8_code_sink();

    // 1: East (col + 1, row)
    let z_e: Float = dem_raster_get_value(grid, col + 1, row);
    if (z_e != (grid).nodata_value) && ((z_c - z_e) > max_drop) {
        max_drop = (z_c - z_e) / dx;
        best_dir = d8_code_east();
    }

    // 2: SE (col + 1, row + 1)
    let z_se: Float = dem_raster_get_value(grid, col + 1, row + 1);
    if (z_se != (grid).nodata_value) && (((z_c - z_se) / diag) > max_drop) {
        max_drop = (z_c - z_se) / diag;
        best_dir = d8_code_southeast();
    }

    // 4: South (col, row + 1)
    let z_s: Float = dem_raster_get_value(grid, col, row + 1);
    if (z_s != (grid).nodata_value) && (((z_c - z_s) / dy) > max_drop) {
        max_drop = (z_c - z_s) / dy;
        best_dir = d8_code_south();
    }

    // 8: SW (col - 1, row + 1)
    let z_sw: Float = dem_raster_get_value(grid, col - 1, row + 1);
    if (z_sw != (grid).nodata_value) && (((z_c - z_sw) / diag) > max_drop) {
        max_drop = (z_c - z_sw) / diag;
        best_dir = d8_code_southwest();
    }

    // 16: West (col - 1, row)
    let z_w: Float = dem_raster_get_value(grid, col - 1, row);
    if (z_w != (grid).nodata_value) && (((z_c - z_w) / dx) > max_drop) {
        max_drop = (z_c - z_w) / dx;
        best_dir = d8_code_west();
    }

    // 32: NW (col - 1, row - 1)
    let z_nw: Float = dem_raster_get_value(grid, col - 1, row - 1);
    if (z_nw != (grid).nodata_value) && (((z_c - z_nw) / diag) > max_drop) {
        max_drop = (z_c - z_nw) / diag;
        best_dir = d8_code_northwest();
    }

    // 64: North (col, row - 1)
    let z_n: Float = dem_raster_get_value(grid, col, row - 1);
    if (z_n != (grid).nodata_value) && (((z_c - z_n) / dy) > max_drop) {
        max_drop = (z_c - z_n) / dy;
        best_dir = d8_code_north();
    }

    // 128: NE (col + 1, row - 1)
    let z_ne: Float = dem_raster_get_value(grid, col + 1, row - 1);
    if (z_ne != (grid).nodata_value) && (((z_c - z_ne) / diag) > max_drop) {
        max_drop = (z_c - z_ne) / diag;
        best_dir = d8_code_northeast();
    }

    return best_dir;
}
