// # Mapbox Vector Tile (MVT) Protocol Buffer Geometry Decoder
//
// Logline: Decodes binary MVT geometry command streams (MoveTo, LineTo, ClosePath) and zigzag integer coordinates.
//
// Setup: Mapbox Vector Tile 2.1 specification decoding screen tile integer coordinates (4096 extent).
//
// Beats:
//   1. Define MvtGeometryCommand and MvtDecodedFeature structures.
//   2. Parse MVT command integer headers: Command ID (MoveTo=1, LineTo=2, ClosePath=7) and repeat counts.
//   3. Decode zigzag variable-length integer parameter offsets to tile coordinate space.

pub type MvtCommand = struct {
    cmd_id: Int, // 1 = MoveTo, 2 = LineTo, 7 = ClosePath
    count: Int
};

pub fn mvt_decode_command_integer(cmd_int: Int) -> MvtCommand {
    let id: Int = cmd_int - ((cmd_int / 8) * 8); // cmd_int & 0x7
    let count: Int = cmd_int / 8;               // cmd_int >> 3
    return MvtCommand {
        cmd_id: id,
        count: count
    };
}

// Decode zigzag integer: ((n >> 1) ^ (-(n & 1)))
pub fn mvt_decode_zigzag(val: Int) -> Int {
    let is_odd: Bool = (val - ((val / 2) * 2)) == 1;
    let half: Int = val / 2;
    if is_odd {
        return 0 - (half + 1);
    }
    return half;
}

// Convert MVT tile screen coordinate (0 to extent) to local unit fraction [0.0, 1.0]
pub fn mvt_to_normalized_coord(tile_coord: Int, extent: Int) -> Float {
    let mut coord_f: Float = 0.0;
    let mut c: Int = tile_coord;
    let is_neg: Bool = c < 0;
    if is_neg { c = 0 - c; }
    while c >= 1000 { coord_f = coord_f + 1000.0; c = c - 1000; }
    while c >= 100 { coord_f = coord_f + 100.0; c = c - 100; }
    while c >= 10 { coord_f = coord_f + 10.0; c = c - 10; }
    while c >= 1 { coord_f = coord_f + 1.0; c = c - 1; }
    if is_neg { coord_f = 0.0 - coord_f; }

    let mut ext_f: Float = 0.0;
    let mut e: Int = extent;
    while e >= 1000 { ext_f = ext_f + 1000.0; e = e - 1000; }
    while e >= 100 { ext_f = ext_f + 100.0; e = e - 100; }
    while e >= 10 { ext_f = ext_f + 10.0; e = e - 10; }
    while e >= 1 { ext_f = ext_f + 1.0; e = e - 1; }

    if ext_f > 0.0 {
        return coord_f / ext_f;
    }
    return 0.0;
}
