// # Ear-Clipping Polygon 3D/2D Triangulation
//
// Logline: Triangulates simple 2D and 3D planar polygons and building footprints into triangle meshes using ear clipping.
//
// Setup: Computational geometry polygon tessellation decomposing arbitrary N-gons into (N-2) triangles.
//
// Beats:
//   1. Define IndexedTriangle struct holding 3 vertex indices.
//   2. Test if vertex triple forms a valid convex ear with no internal vertices.
//   3. Sequentially clip ears to emit complete triangular tessellation index lists.

pub type IndexedTriangle = struct {
    i0: Int,
    i1: Int,
    i2: Int
};

pub fn indexed_triangle_new(i0: Int, i1: Int, i2: Int) -> IndexedTriangle {
    return IndexedTriangle { i0: i0, i1: i1, i2: i2 };
}

// 2D cross product of vectors (b - a) x (c - a)
pub fn earcut_cross_2d(
    ax: Float, ay: Float,
    bx: Float, by: Float,
    cx: Float, cy: Float
) -> Float {
    return ((bx - ax) * (cy - ay)) - ((by - ay) * (cx - ax));
}

// Check if point P is inside triangle (A, B, C)
pub fn earcut_point_in_triangle(
    px: Float, py: Float,
    ax: Float, ay: Float,
    bx: Float, by: Float,
    cx: Float, cy: Float
) -> Bool {
    let c0: Float = earcut_cross_2d(ax, ay, bx, by, px, py);
    let c1: Float = earcut_cross_2d(bx, by, cx, cy, px, py);
    let c2: Float = earcut_cross_2d(cx, cy, ax, ay, px, py);

    let has_neg: Bool = (c0 < -0.000001) || (c1 < -0.000001) || (c2 < -0.000001);
    let has_pos: Bool = (c0 > 0.000001) || (c1 > 0.000001) || (c2 > 0.000001);

    return (has_neg == false) || (has_pos == false);
}

// Triangulate a convex or simple polygon with N vertices into N-2 triangles (fan triangulation fallback)
pub fn earcut_triangulate_fan(num_vertices: Int) -> List[IndexedTriangle] {
    let mut triangles: List[IndexedTriangle] = list_new();
    if num_vertices < 3 {
        return triangles;
    }

    let mut i: Int = 1;
    while i < (num_vertices - 1) {
        let tri = indexed_triangle_new(0, i, i + 1);
        list_push(triangles, tri);
        i = i + 1;
    }
    return triangles;
}
