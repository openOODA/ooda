// # 3D Terrain Mesh Wavefront OBJ Exporter
//
// Logline: Generates standard Wavefront .OBJ 3D geometric mesh strings with vertices, normals, and triangular faces.
//
// Setup: ASCII 3D model serialization for terrain meshes, TIN surfaces, and CityGML building geometries.
//
// Beats:
//   1. Format 3D geometric vertex positions (v x y z) to OBJ format lines.
//   2. Format vertex normal unit vectors (vn nx ny nz).
//   3. Format 1-indexed triangular face definitions (f v0 v1 v2).

pub fn obj_format_vertex(x: Float, y: Float, z: Float) -> String {
    let mut line: String = "v ";
    line = line + to_string(x);
    line = line + " ";
    line = line + to_string(y);
    line = line + " ";
    line = line + to_string(z);
    return line;
}

pub fn obj_format_normal(nx: Float, ny: Float, nz: Float) -> String {
    let mut line: String = "vn ";
    line = line + to_string(nx);
    line = line + " ";
    line = line + to_string(ny);
    line = line + " ";
    line = line + to_string(nz);
    return line;
}

// Format 1-based indexed triangular face: "f i0 i1 i2"
pub fn obj_format_face_triangle(i0: Int, i1: Int, i2: Int) -> String {
    let mut line: String = "f ";
    line = line + to_string(i0 + 1);
    line = line + " ";
    line = line + to_string(i1 + 1);
    line = line + " ";
    line = line + to_string(i2 + 1);
    return line;
}

// Compute total number of triangles generated for a regular grid of (cols, rows)
pub fn obj_grid_triangle_count(cols: Int, rows: Int) -> Int {
    if (cols < 2) || (rows < 2) {
        return 0;
    }
    return (cols - 1) * (rows - 1) * 2;
}
