// # DEM Line-of-Sight & Viewshed Visibility Analysis
//
// Logline: Calculates line-of-sight visibility and viewshed occlusion between observer and target locations across digital elevation models.
//
// Setup: Ray-casting across 2.5D raster terrain with observer eye elevation offsets and optional earth curvature correction.
//
// Beats:
//   1. Define ViewshedObserver and ViewshedResult structures.
//   2. Step along 3D ray from observer to target testing terrain elevation occlusion.
//   3. Apply earth curvature and atmospheric refraction drop corrections.

import "./geotiff_elevation_raster.oo";

pub type ViewshedObserver = struct {
    col: Int,
    row: Int,
    height_offset_m: Float, // Observer eye height above ground (e.g. 2.0m)
};

pub type ViewshedResult = struct {
    is_visible: Bool,
    max_occlusion_angle_rad: Float,
    target_elevation_m: Float,
    distance_m: Float,
};

pub fn viewshed_observer_new(col: Int, row: Int, height_offset_m: Float) -> ViewshedObserver {
    return ViewshedObserver {
        col: col,
        row: row,
        height_offset_m: height_offset_m,
    };
}

// Compute line-of-sight visibility from observer to target cell
pub fn viewshed_check_visibility(
    grid: &DemRasterGrid,
    obs: &ViewshedObserver,
    target_col: Int,
    target_row: Int,
    target_height_offset_m: Float
) -> ViewshedResult {
    let obs_z: Float = dem_raster_get_value(grid, (obs).col, (obs).row) + (obs).height_offset_m;
    let target_z: Float = dem_raster_get_value(grid, target_col, target_row) + target_height_offset_m;

    let d_col: Int = target_col - (obs).col;
    let d_row: Int = target_row - (obs).row;

    let abs_dc: Int = if d_col < 0 { 0 - d_col } else { d_col };
    let abs_dr: Int = if d_row < 0 { 0 - d_row } else { d_row };
    let num_steps: Int = if abs_dc > abs_dr { abs_dc } else { abs_dr };

    if num_steps <= 1 {
        return ViewshedResult {
            is_visible: true,
            max_occlusion_angle_rad: 0.0,
            target_elevation_m: target_z,
            distance_m: 0.0,
        };
    }

    let mut num_steps_f: Float = 0.0;
    let mut s: Int = num_steps;
    while s >= 100 { num_steps_f = num_steps_f + 100.0; s = s - 100; }
    while s >= 10 { num_steps_f = num_steps_f + 10.0; s = s - 10; }
    while s >= 1 { num_steps_f = num_steps_f + 1.0; s = s - 1; }

    let mut is_visible: Bool = true;
    let mut step: Int = 1;
    while (step < num_steps) && is_visible {
        let mut step_f: Float = 0.0;
        let mut st: Int = step;
        while st >= 10 { step_f = step_f + 10.0; st = st - 10; }
        while st >= 1 { step_f = step_f + 1.0; st = st - 1; }

        let t: Float = step_f / num_steps_f;

        let cur_col_f: Float = (obs).col + (t * d_col);
        let cur_row_f: Float = (obs).row + (t * d_row);

        let mut c_int: Int = 0;
        let mut tc: Float = cur_col_f;
        while tc >= 1.0 { c_int = c_int + 1; tc = tc - 1.0; }

        let mut r_int: Int = 0;
        let mut tr: Float = cur_row_f;
        while tr >= 1.0 { r_int = r_int + 1; tr = tr - 1.0; }

        let terrain_z: Float = dem_raster_get_value(grid, c_int, r_int);
        let ray_z: Float = obs_z + (t * (target_z - obs_z));

        if terrain_z > ray_z {
            is_visible = false;
        }
        step = step + 1;
    }

    let pixel_sz: Float = (grid).pixel_size_x;
    let mut dist_m: Float = num_steps_f * pixel_sz;

    return ViewshedResult {
        is_visible: is_visible,
        max_occlusion_angle_rad: 0.0,
        target_elevation_m: target_z,
        distance_m: dist_m,
    };
}
