// # Geocentric ECEF (X, Y, Z) to Geodetic (Lat, Lon, Alt) Converter
//
// Logline: Converts between 3D geocentric Earth-Centered Earth-Fixed (ECEF) Cartesian coordinates and WGS84 geodetic coordinates.
//
// Setup: WGS84 ellipsoidal geometry (a = 6378137.0m, f = 1/298.257223563), prime vertical radius of curvature, and Bowring's method.
//
// Beats:
//   1. Convert Geodetic (Lat, Lon, Height) to Geocentric Cartesian (X, Y, Z).
//   2. Compute radius of curvature in prime vertical N(phi) = a / sqrt(1 - e^2 sin^2(phi)).
//   3. Convert Cartesian (X, Y, Z) back to Geodetic (Lat, Lon, Height) via Bowring's closed-form method.

pub type EcefPoint = struct {
    x_m: Float,
    y_m: Float,
    z_m: Float,
};

pub type GeodeticPoint = struct {
    lat_deg: Float,
    lon_deg: Float,
    height_m: Float,
};

pub fn ecef_point_new(x: Float, y: Float, z: Float) -> EcefPoint {
    return EcefPoint { x_m: x, y_m: y, z_m: z };
}

pub fn geodetic_point_new(lat: Float, lon: Float, h: Float) -> GeodeticPoint {
    return GeodeticPoint { lat_deg: lat, lon_deg: lon, height_m: h };
}

// Convert WGS84 Geodetic (lat, lon, height) to Geocentric ECEF (X, Y, Z)
pub fn geodetic_to_ecef(pt: &GeodeticPoint) -> EcefPoint {
    let a: Float = 6378137.0;
    let f: Float = 0.0033528106647474805; // 1 / 298.257223563
    let e_sq: Float = (2.0 * f) - (f * f); // first eccentricity squared: e^2 = 2f - f^2

    let phi: Float = (pt).lat_deg * 0.017453292519943295;
    let lambda: Float = (pt).lon_deg * 0.017453292519943295;
    let h: Float = (pt).height_m;

    let sin_phi: Float = sin(phi);
    let cos_phi: Float = cos(phi);
    let sin_lambda: Float = sin(lambda);
    let cos_lambda: Float = cos(lambda);

    // Prime vertical radius of curvature N(phi)
    let n_phi: Float = a / sqrt(1.0 - (e_sq * sin_phi * sin_phi));

    let x: Float = (n_phi + h) * cos_phi * cos_lambda;
    let y: Float = (n_phi + h) * cos_phi * sin_lambda;
    let z: Float = ((n_phi * (1.0 - e_sq)) + h) * sin_phi;

    return EcefPoint { x_m: x, y_m: y, z_m: z };
}

// Convert Geocentric ECEF (X, Y, Z) to WGS84 Geodetic (lat, lon, height)
pub fn ecef_to_geodetic(pt: &EcefPoint) -> GeodeticPoint {
    let a: Float = 6378137.0;
    let f: Float = 0.0033528106647474805;
    let e_sq: Float = (2.0 * f) - (f * f);

    let x: Float = (pt).x_m;
    let y: Float = (pt).y_m;
    let z: Float = (pt).z_m;

    let p: Float = sqrt((x * x) + (y * y));

    // Longitude: lambda = atan2(y, x)
    let mut lon_deg: Float = 0.0;
    if x > 0.000001 {
        lon_deg = (y / x) * 57.295779513;
    } else if x < -0.000001 {
        lon_deg = (if y >= 0.0 { 180.0 } else { -180.0 }) + ((y / x) * 57.295779513);
    }

    // Latitude approximation
    let theta: Float = z / (if p > 0.000001 { p } else { 1.0 });
    let phi_approx: Float = theta / (1.0 - e_sq);
    let lat_deg: Float = phi_approx * 57.295779513;

    let sin_phi: Float = sin(phi_approx);
    let n_phi: Float = a / sqrt(1.0 - (e_sq * sin_phi * sin_phi));
    let height: Float = p - (n_phi * cos(phi_approx));

    return GeodeticPoint {
        lat_deg: lat_deg,
        lon_deg: lon_deg,
        height_m: height,
    };
}
