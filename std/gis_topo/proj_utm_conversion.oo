// # Universal Transverse Mercator (UTM) Map Projection
//
// Logline: Converts between geodetic WGS84 latitude/longitude and planar Universal Transverse Mercator (UTM) Easting/Northing coordinates.
//
// Setup: Ellipsoidal transverse cylindrical projection with 6-degree longitudinal zones, central meridian, and false origins.
//
// Beats:
//   1. Define UtmCoordinate struct holding Easting, Northing, UTM Zone (1-60), and Hemisphere.
//   2. Compute UTM zone from longitude and determine central meridian.
//   3. Project WGS84 coordinates to UTM Easting/Northing with 0.9996 scale factor.

pub type UtmCoordinate = struct {
    easting: Float,
    northing: Float,
    zone: Int,
    is_northern: Bool
};

pub fn utm_coordinate_new(easting: Float, northing: Float, zone: Int, is_northern: Bool) -> UtmCoordinate {
    return UtmCoordinate {
        easting: easting,
        northing: northing,
        zone: zone,
        is_northern: is_northern
    };
}

// Calculate UTM longitudinal zone (1 to 60) for a given longitude in degrees
pub fn utm_zone_from_lon(lon_deg: Float) -> Int {
    let shifted: Float = lon_deg + 180.0;
    let mut zone: Int = 1;
    let mut tmp: Float = shifted;
    while tmp >= 6.0 {
        zone = zone + 1;
        tmp = tmp - 6.0;
    }
    if zone > 60 {
        return 60;
    }
    if zone < 1 {
        return 1;
    }
    return zone;
}

// Calculate central meridian longitude in degrees for a given UTM zone
pub fn utm_central_meridian(zone: Int) -> Float {
    let mut z_f: Float = 0.0;
    let mut z: Int = zone;
    while z >= 10 { z_f = z_f + 10.0; z = z - 10; }
    while z >= 1 { z_f = z_f + 1.0; z = z - 1; }

    return (z_f * 6.0) - 183.0;
}

// Forward UTM projection (approximate Transverse Mercator series)
pub fn utm_forward(lat_deg: Float, lon_deg: Float) -> UtmCoordinate {
    let zone: Int = utm_zone_from_lon(lon_deg);
    let cm_deg: Float = utm_central_meridian(zone);
    let is_north: Bool = lat_deg >= 0.0;

    let rad_factor: Float = 0.017453292519943295;
    let phi: Float = lat_deg * rad_factor;
    let lambda_diff: Float = (lon_deg - cm_deg) * rad_factor;

    let a: Float = 6378137.0; // WGS84 semi-major axis
    let k0: Float = 0.9996;   // UTM central scale factor

    let cos_phi: Float = cos(phi);
    let sin_phi: Float = sin(phi);

    // Approximate conformal series expansions
    let x_offset: Float = a * k0 * lambda_diff * cos_phi;
    let easting: Float = 500000.0 + x_offset;

    let y_offset: Float = a * k0 * phi;
    let northing: Float = if is_north {
        y_offset
    } else {
        10000000.0 + y_offset
    };

    return UtmCoordinate {
        easting: easting,
        northing: northing,
        zone: zone,
        is_northern: is_north
    };
}
