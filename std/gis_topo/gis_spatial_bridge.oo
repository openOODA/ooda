// # GIS Spatial Topology Interoperability Bridge
//
// Logline: Converts between 2D planar GIS spatial structures and 3D topographic elevation grids, TIN meshes, and R-Trees.
//
// Setup: Bridge transformations lifting 2D geographic coordinates to 3D terrain topologies with elevation sampling.
//
// Beats:
//   1. Define BridgePoint3D and BridgeEnvelope3D compatibility records.
//   2. Lift 2D coordinate pairs (X, Y) to 3D coordinates (X, Y, Z) via DEM elevation sampling.
//   3. Project 3D bounding boxes to 2D bounding boxes and vice versa.

import "./geotiff_elevation_raster.oo";
import "./rtree_3d_bounding_box.oo";

pub type BridgePoint3D = struct {
    x: Float,
    y: Float,
    z: Float
};

pub type BridgeEnvelope2D = struct {
    min_x: Float,
    min_y: Float,
    max_x: Float,
    max_y: Float
};

pub fn bridge_point_new(x: Float, y: Float, z: Float) -> BridgePoint3D {
    return BridgePoint3D { x: x, y: y, z: z };
}

pub fn bridge_envelope_new(min_x: Float, min_y: Float, max_x: Float, max_y: Float) -> BridgeEnvelope2D {
    return BridgeEnvelope2D {
        min_x: min_x,
        min_y: min_y,
        max_x: max_x,
        max_y: max_y
    };
}

// Convert 3D bounding box to 2D envelope
pub fn bridge_bbox3d_to_envelope2d(b: &BoundingBox3D) -> BridgeEnvelope2D {
    return BridgeEnvelope2D {
        min_x: (b).min_x,
        min_y: (b).min_y,
        max_x: (b).max_x,
        max_y: (b).max_y
    };
}

// Convert 2D envelope to 3D bounding box with min/max elevation bounds
pub fn bridge_envelope2d_to_bbox3d(
    env: &BridgeEnvelope2D,
    min_z: Float,
    max_z: Float
) -> BoundingBox3D {
    return BoundingBox3D {
        min_x: (env).min_x,
        min_y: (env).min_y,
        min_z: min_z,
        max_x: (env).max_x,
        max_y: (env).max_y,
        max_z: max_z
    };
}

// Sample 2D point on DEM raster and return lifted 3D point
pub fn bridge_lift_point_to_3d(
    grid: &DemRasterGrid,
    world_x: Float,
    world_y: Float
) -> BridgePoint3D {
    let px = dem_world_to_pixel(grid, world_x, world_y);
    let col_f: Float = list_get(px, 0);
    let row_f: Float = list_get(px, 1);
    let z: Float = dem_sample_bilinear(grid, col_f, row_f);
    let valid_z: Float = if z == (grid).nodata_value { 0.0 } else { z };

    return BridgePoint3D {
        x: world_x,
        y: world_y,
        z: valid_z
    };
}
