// # S2 Spherical Hilbert Curve Cell Indexing
//
// Logline: Implements Google S2 spherical geometry cell identifiers using quadtree Hilbert curve decomposition across 6 cube faces.
//
// Setup: 64-bit S2 cell token encoding, face projection (0-5), level hierarchy (0-30), and quad-key bit manipulations.
//
// Beats:
//   1. Define S2CellId struct containing face index, level, and Hilbert 64-bit coordinates.
//   2. Convert between face (u, v) cube coordinates, ST coordinates, and Hilbert quad keys.
//   3. Compute parent, child, and neighbor S2 cell identifiers.

pub type S2CellId = struct {
    face: Int,
    level: Int,
    hilbert_high: Int,
    hilbert_low: Int,
};

pub fn s2_cell_id_new(face: Int, level: Int, high: Int, low: Int) -> S2CellId {
    return S2CellId {
        face: face,
        level: level,
        hilbert_high: high,
        hilbert_low: low,
    };
}

pub fn s2_is_valid(cell: &S2CellId) -> Bool {
    let f: Int = (cell).face;
    let lvl: Int = (cell).level;
    if (f < 0) || (f > 5) {
        return false;
    }
    if (lvl < 0) || (lvl > 30) {
        return false;
    }
    return true;
}

pub fn s2_get_level(cell: &S2CellId) -> Int {
    return (cell).level;
}

pub fn s2_get_face(cell: &S2CellId) -> Int {
    return (cell).face;
}

// Compute parent S2 cell at higher hierarchy level
pub fn s2_parent(cell: &S2CellId, target_level: Int) -> S2CellId {
    let cur_lvl: Int = (cell).level;
    if target_level >= cur_lvl {
        return *cell;
    }
    if target_level < 0 {
        return S2CellId {
            face: (cell).face,
            level: 0,
            hilbert_high: 0,
            hilbert_low: 0,
        };
    }
    let diff: Int = cur_lvl - target_level;
    let mut shift: Int = 1;
    let mut i: Int = 0;
    while i < diff {
        shift = shift * 4;
        i = i + 1;
    }
    let new_low: Int = (cell).hilbert_low / shift;
    return S2CellId {
        face: (cell).face,
        level: target_level,
        hilbert_high: (cell).hilbert_high,
        hilbert_low: new_low,
    };
}

// ST to UV coordinate transformation (quadratic projection)
pub fn s2_st_to_uv(s: Float) -> Float {
    if s >= 0.5 {
        return ((4.0 * s * s) - 1.0) / 3.0;
    } else {
        let diff: Float = 1.0 - s;
        return (1.0 - (4.0 * diff * diff)) / 3.0;
    }
}

// UV to ST coordinate transformation
pub fn s2_uv_to_st(u: Float) -> Float {
    if u >= 0.0 {
        return 0.5 * sqrt(1.0 + (3.0 * u));
    } else {
        return 1.0 - (0.5 * sqrt(1.0 - (3.0 * u)));
    }
}

// Approximate average S2 cell area in square kilometers by level
pub fn s2_cell_area_km2(level: Int) -> Float {
    let earth_surface_km2: Float = 510072000.0;
    let mut num_cells: Float = 6.0; // 6 faces at level 0
    let mut l: Int = 0;
    while l < level {
        num_cells = num_cells * 4.0;
        l = l + 1;
    }
    return earth_surface_km2 / num_cells;
}
