// # DEM Flow Accumulation & Watershed Drainage Area
//
// Logline: Computes upstream contributing drainage area and channel network initiation from D8 flow direction matrices.
//
// Setup: Hydrological drainage networks, upstream cell counts, and stream threshold channel extraction.
//
// Beats:
//   1. Define FlowAccumulationGrid struct holding 2D matrix of upstream cell counts.
//   2. Accumulate flow counts recursively or iteratively from ridgelines to basin outlets.
//   3. Classify river/stream channels exceeding contributing drainage thresholds.

import "./dem_flow_direction_d8.oo";

pub type FlowAccumulationGrid = struct {
    cols: Int,
    rows: Int,
    cell_counts: List[Int]
};

pub fn flow_accumulation_grid_new(cols: Int, rows: Int) -> FlowAccumulationGrid {
    let counts: List[Int] = list_new_int();
    let total: Int = cols * rows;
    let mut i: Int = 0;
    while i < total {
        list_push_int(counts, 1); // Each cell contributes 1 (itself)
        i = i + 1;
    }
    return FlowAccumulationGrid {
        cols: cols,
        rows: rows,
        cell_counts: counts
    };
}

pub fn flow_accum_get(grid: &FlowAccumulationGrid, col: Int, row: Int) -> Int {
    if (col < 0) || (col >= (grid).cols) || (row < 0) || (row >= (grid).rows) {
        return 0;
    }
    let idx: Int = (row * (grid).cols) + col;
    if idx < list_len((grid).cell_counts) {
        return list_get_int((grid).cell_counts, idx);
    }
    return 0;
}

// Convert upstream cell count to catchment drainage area in square kilometers
pub fn flow_accum_to_area_km2(
    cell_count: Int,
    pixel_size_x_m: Float,
    pixel_size_y_m: Float
) -> Float {
    let mut count_f: Float = 0.0;
    let mut c: Int = cell_count;
    while c >= 10000 { count_f = count_f + 10000.0; c = c - 10000; }
    while c >= 1000 { count_f = count_f + 1000.0; c = c - 1000; }
    while c >= 100 { count_f = count_f + 100.0; c = c - 100; }
    while c >= 10 { count_f = count_f + 10.0; c = c - 10; }
    while c >= 1 { count_f = count_f + 1.0; c = c - 1; }

    let cell_area_m2: Float = pixel_size_x_m * pixel_size_y_m;
    let total_area_m2: Float = count_f * cell_area_m2;
    return total_area_m2 * 0.000001; // m2 to km2
}

// Test if a cell is classified as a permanent stream channel based on threshold
pub fn flow_is_stream_channel(cell_count: Int, threshold: Int) -> Bool {
    return cell_count >= threshold;
}
