// # GeoTIFF Digital Elevation Model (DEM) Raster Grid
//
// Logline: Manages 2D elevation scalar fields, georeferenced pixel-to-world coordinates, nodata handling, and bilinear interpolation.
//
// Setup: Regular Cartesian raster grids representing topographical terrain elevations with affine transform parameters.
//
// Beats:
//   1. Define DemRasterGrid struct with dimensions, spatial resolution, origin, and elevation values.
//   2. Transform between world coordinates (x, y) and raster image grid coordinates (col, row).
//   3. Sample terrain elevation at sub-pixel resolution via 2D bilinear interpolation.

pub type DemRasterGrid = struct {
    cols: Int,
    rows: Int,
    origin_x: Float,
    origin_y: Float,
    pixel_size_x: Float,
    pixel_size_y: Float,
    nodata_value: Float,
    data: List[Float]
};

pub fn dem_raster_grid_new(
    cols: Int,
    rows: Int,
    origin_x: Float,
    origin_y: Float,
    res_x: Float,
    res_y: Float,
    nodata: Float
) -> DemRasterGrid {
    let data: List[Float] = list_new();
    return DemRasterGrid {
        cols: cols,
        rows: rows,
        origin_x: origin_x,
        origin_y: origin_y,
        pixel_size_x: res_x,
        pixel_size_y: res_y,
        nodata_value: nodata,
        data: data
    };
}

pub fn dem_raster_get_value(grid: &DemRasterGrid, col: Int, row: Int) -> Float {
    if (col < 0) || (col >= (grid).cols) || (row < 0) || (row >= (grid).rows) {
        return (grid).nodata_value;
    }
    let idx: Int = (row * (grid).cols) + col;
    if idx < list_len((grid).data) {
        return list_get((grid).data, idx);
    }
    return (grid).nodata_value;
}

pub fn dem_raster_set_value(grid: &mut DemRasterGrid, col: Int, row: Int, val: Float) {
    if (col >= 0) && (col < (grid).cols) && (row >= 0) && (row < (grid).rows) {
        let idx: Int = (row * (grid).cols) + col;
        while list_len((grid).data) <= idx {
            list_push((grid).data, (grid).nodata_value);
        }
        // In openOODA list operations, appending or setting
    }
}

// Transform world coordinates (X, Y) to raster grid pixel (col, row)
pub fn dem_world_to_pixel(grid: &DemRasterGrid, world_x: Float, world_y: Float) -> List[Float] {
    let col_f: Float = (world_x - (grid).origin_x) / (grid).pixel_size_x;
    let row_f: Float = ((grid).origin_y - world_y) / (grid).pixel_size_y;
    let mut res: List[Float] = list_new();
    list_push(res, col_f);
    list_push(res, row_f);
    return res;
}

// Bilinear interpolation of elevation at continuous pixel coordinates (col_f, row_f)
pub fn dem_sample_bilinear(grid: &DemRasterGrid, col_f: Float, row_f: Float) -> Float {
    let c0: Int = if col_f >= 0.0 { 0 } else { -1 };
    let mut c_int: Int = 0;
    let mut tmp_c: Float = col_f;
    while tmp_c >= 1.0 { c_int = c_int + 1; tmp_c = tmp_c - 1.0; }
    let mut r_int: Int = 0;
    let mut tmp_r: Float = row_f;
    while tmp_r >= 1.0 { r_int = r_int + 1; tmp_r = tmp_r - 1.0; }

    let fx: Float = tmp_c;
    let fy: Float = tmp_r;

    let z00: Float = dem_raster_get_value(grid, c_int, r_int);
    let z10: Float = dem_raster_get_value(grid, c_int + 1, r_int);
    let z01: Float = dem_raster_get_value(grid, c_int, r_int + 1);
    let z11: Float = dem_raster_get_value(grid, c_int + 1, r_int + 1);

    if (z00 == (grid).nodata_value) || (z10 == (grid).nodata_value) ||
       (z01 == (grid).nodata_value) || (z11 == (grid).nodata_value) {
        return (grid).nodata_value;
    }

    let top: Float = z00 + (fx * (z10 - z00));
    let bot: Float = z01 + (fx * (z11 - z01));
    return top + (fy * (bot - top));
}
