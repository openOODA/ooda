// # ESRI Shapefile Binary Header Parser
//
// Logline: Parses standard 100-byte ESRI Shapefile (.shp) binary main file headers and bounding boxes.
//
// Setup: Binary header format specifications for GIS vector datasets with 2D/3D geometry shape types.
//
// Beats:
//   1. Define ShapefileHeader struct with magic code, length, shape type, and 3D bounding box.
//   2. Validate ESRI magic integer (9994 / 0x0000270A) and file version (1000).
//   3. Decode 2D and 3D Z/M shape type enumerations.

pub type ShapefileHeader = struct {
    file_code: Int,      // Magic number 9994
    file_length_bytes: Int,
    version: Int,        // 1000
    shape_type: Int,     // 1=Point, 3=PolyLine, 5=Polygon, 11=PointZ, 13=PolyLineZ, 15=PolygonZ
    x_min: Float,
    y_min: Float,
    x_max: Float,
    y_max: Float,
    z_min: Float,
    z_max: Float,
    m_min: Float,
    m_max: Float
};

pub fn shapefile_header_new(
    file_code: Int,
    file_length_words: Int,
    shape_type: Int,
    xmin: Float,
    ymin: Float,
    xmax: Float,
    ymax: Float
) -> ShapefileHeader {
    return ShapefileHeader {
        file_code: file_code,
        file_length_bytes: file_length_words * 2,
        version: 1000,
        shape_type: shape_type,
        x_min: xmin,
        y_min: ymin,
        x_max: xmax,
        y_max: ymax,
        z_min: 0.0,
        z_max: 0.0,
        m_min: 0.0,
        m_max: 0.0
    };
}

pub fn shapefile_is_valid_header(hdr: &ShapefileHeader) -> Bool {
    if (hdr).file_code != 9994 {
        return false;
    }
    if (hdr).version != 1000 {
        return false;
    }
    return true;
}

pub fn shapefile_is_3d(hdr: &ShapefileHeader) -> Bool {
    let st: Int = (hdr).shape_type;
    // 11: PointZ, 13: PolyLineZ, 15: PolygonZ, 18: MultiPointZ, 31: MultiPatch
    if st == 11 || st == 13 || st == 15 || st == 18 || st == 31 {
        return true;
    }
    return false;
}

pub fn shapefile_type_name(shape_type: Int) -> String {
    if shape_type == 0 { return "NullShape"; }
    if shape_type == 1 { return "Point"; }
    if shape_type == 3 { return "PolyLine"; }
    if shape_type == 5 { return "Polygon"; }
    if shape_type == 8 { return "MultiPoint"; }
    if shape_type == 11 { return "PointZ"; }
    if shape_type == 13 { return "PolyLineZ"; }
    if shape_type == 15 { return "PolygonZ"; }
    if shape_type == 18 { return "MultiPointZ"; }
    if shape_type == 31 { return "MultiPatch"; }
    return "UnknownShapeType";
}
