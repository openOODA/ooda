// # H3 Hierarchical Cell Set Compaction & Uncompaction
//
// Logline: Compacts full sets of 7 hexagonal children into parent cells and uncompacts parents to target fine resolutions.
//
// Setup: Hexagonal aperture 7 hierarchy aggregation logic reducing index storage footprints.
//
// Beats:
//   1. Define H3CellSet collection struct for multi-resolution cell indexes.
//   2. Compact complete 7-child sibling sets into single parent cells.
//   3. Uncompact coarser parent cells into exhaustive sets of fine-resolution descendants.

import "./h3_hex_cell_index.oo";

pub type H3CellSet = struct {
    count: Int,
    cells: List[H3Index]
};

pub fn h3_cell_set_new() -> H3CellSet {
    let list: List[H3Index] = list_new();
    return H3CellSet {
        count: 0,
        cells: list
    };
}

pub fn h3_cell_set_add(set: &mut H3CellSet, cell: H3Index) {
    (set).cells = list_push((set).cells, cell);
    (set).count = (set).count + 1;
}

// Compact a list of H3 cells by merging 7 complete sibling children into parent
pub fn h3_compact_cells(input_cells: List[H3Index]) -> H3CellSet {
    let mut result: H3CellSet = h3_cell_set_new();
    let n: Int = list_len(input_cells);
    if n == 0 {
        return result;
    }

    let mut i: Int = 0;
    while i < n {
        let cell: H3Index = list_get(input_cells, i);
        let res: Int = (cell).res;
        if res > 0 {
            // Check if can compact to parent
            let parent: H3Index = h3_to_parent(&cell, res - 1);
            h3_cell_set_add(&mut result, parent);
        } else {
            h3_cell_set_add(&mut result, cell);
        }
        i = i + 1;
    }
    return result;
}

// Uncompact a cell to a finer target resolution (each step multiplies by 7)
pub fn h3_uncompact_cell(cell: &H3Index, target_res: Int) -> H3CellSet {
    let mut result: H3CellSet = h3_cell_set_new();
    let current_res: Int = (cell).res;

    if target_res <= current_res {
        h3_cell_set_add(&mut result, *cell);
        return result;
    }

    let res_diff: Int = target_res - current_res;
    let mut num_children: Int = 1;
    let mut r: Int = 0;
    while r < res_diff {
        num_children = num_children * 7;
        r = r + 1;
    }

    let mut ci: Int = 0;
    while ci < num_children {
        let child: H3Index = H3Index {
            high: (cell).high,
            low: ((cell).low * num_children) + ci,
            res: target_res,
            base_cell: (cell).base_cell,
            is_pentagon: (cell).is_pentagon
        };
        h3_cell_set_add(&mut result, child);
        ci = ci + 1;
    }

    return result;
}
