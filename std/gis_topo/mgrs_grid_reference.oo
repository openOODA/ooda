// # Military Grid Reference System (MGRS) Coordinates
//
// Logline: Encodes and decodes alphanumeric Military Grid Reference System (MGRS) grid zone designations and 100km square IDs.
//
// Setup: NATO standard geographic coordinate system based on UTM and UPS map projections with nested alpha square identifiers.
//
// Beats:
//   1. Define MgrsCoordinate struct containing GZD, 100km square letters, easting, and northing.
//   2. Compute Latitude Band letter (C to X, omitting I and O) for 8-degree latitudinal bands.
//   3. Extract numerical Easting/Northing offsets at 10m, 100m, and 1000m resolutions.

pub type MgrsCoordinate = struct {
    gzd_zone: Int,          // 1-60
    gzd_band_char: String,  // C..X
    square_col: String,     // Column letter
    square_row: String,     // Row letter
    easting_m: Int,         // 0-99999
    northing_m: Int,        // 0-99999
    precision_digits: Int  // 1=10km, 2=1km, 3=100m, 4=10m, 5=1m
};

pub fn mgrs_coord_new(
    zone: Int,
    band: String,
    col: String,
    row: String,
    easting: Int,
    northing: Int,
    precision: Int
) -> MgrsCoordinate {
    return MgrsCoordinate {
        gzd_zone: zone,
        gzd_band_char: band,
        square_col: col,
        square_row: row,
        easting_m: easting,
        northing_m: northing,
        precision_digits: precision
    };
}

// Compute MGRS latitude band letter for latitude in degrees [-80, +84]
pub fn mgrs_latitude_band(lat_deg: Float) -> String {
    if lat_deg < -72.0 { return "C"; }
    if lat_deg < -64.0 { return "D"; }
    if lat_deg < -56.0 { return "E"; }
    if lat_deg < -48.0 { return "F"; }
    if lat_deg < -40.0 { return "G"; }
    if lat_deg < -32.0 { return "H"; }
    if lat_deg < -24.0 { return "J"; }
    if lat_deg < -16.0 { return "K"; }
    if lat_deg < -8.0  { return "L"; }
    if lat_deg < 0.0   { return "M"; }
    if lat_deg < 8.0   { return "N"; }
    if lat_deg < 16.0  { return "P"; }
    if lat_deg < 24.0  { return "Q"; }
    if lat_deg < 32.0  { return "R"; }
    if lat_deg < 40.0  { return "S"; }
    if lat_deg < 48.0  { return "T"; }
    if lat_deg < 56.0  { return "U"; }
    if lat_deg < 64.0  { return "V"; }
    if lat_deg < 72.0  { return "W"; }
    return "X";
}

// Convert full UTM Easting/Northing meters into 100km grid square relative coordinates
pub fn mgrs_utm_to_100k_offsets(easting: Float, northing: Float) -> List[Int] {
    let mut e_int: Int = 0;
    let mut te: Float = easting;
    while te >= 100000.0 { te = te - 100000.0; }
    while te >= 1.0 { e_int = e_int + 1; te = te - 1.0; }

    let mut n_int: Int = 0;
    let mut tn: Float = northing;
    while tn >= 100000.0 { tn = tn - 100000.0; }
    while tn >= 1.0 { n_int = n_int + 1; tn = tn - 1.0; }

    let mut offsets: List[Int] = list_new_int();
    list_push_int(offsets, e_int);
    list_push_int(offsets, n_int);
    return offsets;
}
