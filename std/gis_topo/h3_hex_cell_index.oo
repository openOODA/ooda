// # H3 Hexagonal Cell Index & Resolution Encoding
//
// Logline: Encodes and decodes Uber H3 discrete global hexagonal grid cell identifiers across resolutions 0 to 15.
//
// Setup: 64-bit split high/low index representation with base cell, resolution level, and child directional digits.
//
// Beats:
//   1. Construct and validate H3 cell index structs with 64-bit integer components.
//   2. Extract resolution level, base cell index, cell mode, and directional digits.
//   3. Compute parent cell identifiers and resolution scaling metrics.

pub type H3Index = struct {
    high: Int,
    low: Int,
    res: Int,
    base_cell: Int,
    is_pentagon: Bool,
};

pub fn h3_index_new(high: Int, low: Int, res: Int, base_cell: Int, is_pentagon: Bool) -> H3Index {
    return H3Index {
        high: high,
        low: low,
        res: res,
        base_cell: base_cell,
        is_pentagon: is_pentagon,
    };
}

pub fn h3_is_valid(idx: &H3Index) -> Bool {
    let r: Int = (idx).res;
    let bc: Int = (idx).base_cell;
    if (r < 0) || (r > 15) {
        return false;
    }
    if (bc < 0) || (bc >= 122) {
        return false;
    }
    return true;
}

pub fn h3_get_resolution(idx: &H3Index) -> Int {
    return (idx).res;
}

pub fn h3_get_base_cell(idx: &H3Index) -> Int {
    return (idx).base_cell;
}

pub fn h3_is_pentagon_cell(idx: &H3Index) -> Bool {
    return (idx).is_pentagon;
}

// Compute parent H3 index at target lower resolution
pub fn h3_to_parent(idx: &H3Index, parent_res: Int) -> H3Index {
    let current_res: Int = (idx).res;
    if parent_res >= current_res {
        return H3Index {
            high: (idx).high,
            low: (idx).low,
            res: current_res,
            base_cell: (idx).base_cell,
            is_pentagon: (idx).is_pentagon,
        };
    }
    if parent_res < 0 {
        return H3Index {
            high: (idx).high,
            low: (idx).low,
            res: 0,
            base_cell: (idx).base_cell,
            is_pentagon: (idx).is_pentagon,
        };
    }
    let res_diff: Int = current_res - parent_res;
    let mut shift_factor: Int = 1;
    let mut i: Int = 0;
    while i < res_diff {
        shift_factor = shift_factor * 7;
        i = i + 1;
    }
    let new_low: Int = (idx).low / shift_factor;
    return H3Index {
        high: (idx).high,
        low: new_low,
        res: parent_res,
        base_cell: (idx).base_cell,
        is_pentagon: (idx).is_pentagon,
    };
}

// Calculate nominal hexagon edge length in meters for resolution 0-15
pub fn h3_edge_length_m(res: Int) -> Float {
    if res <= 0 { return 1107712.59; }
    if res == 1 { return 418676.06; }
    if res == 2 { return 158244.66; }
    if res == 3 { return 59810.86; }
    if res == 4 { return 22606.38; }
    if res == 5 { return 8544.41; }
    if res == 6 { return 3229.48; }
    if res == 7 { return 1220.63; }
    if res == 8 { return 461.35; }
    if res == 9 { return 174.37; }
    if res == 10 { return 65.91; }
    if res == 11 { return 24.91; }
    if res == 12 { return 9.42; }
    if res == 13 { return 3.56; }
    if res == 14 { return 1.35; }
    return 0.51;
}

// Calculate nominal hexagon cell area in square meters for resolution 0-15
pub fn h3_hex_area_m2(res: Int) -> Float {
    if res <= 0 { return 4357449416078.0; }
    if res == 1 { return 609788441794.0; }
    if res == 2 { return 86801780307.0; }
    if res == 3 { return 12393434033.0; }
    if res == 4 { return 1770347654.0; }
    if res == 5 { return 252901939.0; }
    if res == 6 { return 36129016.0; }
    if res == 7 { return 5161290.0; }
    if res == 8 { return 737327.0; }
    if res == 9 { return 105332.0; }
    if res == 10 { return 15047.0; }
    if res == 11 { return 2150.0; }
    if res == 12 { return 307.0; }
    if res == 13 { return 43.87; }
    if res == 14 { return 6.27; }
    return 0.89;
}
