// # 3D K-D Tree Spatial Search & Nearest Neighbors
//
// Logline: Constructs balanced 3D k-d trees with cyclic axis splits (X, Y, Z) for Euclidean nearest neighbor searches.
//
// Setup: Multi-dimensional binary search trees for 3D point clouds, LiDAR points, and geospatial terrain samples.
//
// Beats:
//   1. Define KdNode3D struct with 3D coordinate vector, split axis (0, 1, 2), and child indices.
//   2. Compute 3D squared Euclidean distance between query and target points.
//   3. Implement nearest neighbor branch pruning logic along orthogonal split hyperplanes.

pub type KdPoint3D = struct {
    x: Float,
    y: Float,
    z: Float,
    id: Int,
};

pub type KdNode3D = struct {
    point: KdPoint3D,
    axis: Int, // 0 = X, 1 = Y, 2 = Z
    left_child: Int,  // -1 if none
    right_child: Int, // -1 if none
};

pub fn kd_point_new(x: Float, y: Float, z: Float, id: Int) -> KdPoint3D {
    return KdPoint3D { x: x, y: y, z: z, id: id };
}

pub fn kd_node_new(pt: KdPoint3D, axis: Int) -> KdNode3D {
    return KdNode3D {
        point: pt,
        axis: axis,
        left_child: -1,
        right_child: -1,
    };
}

// 3D Euclidean distance squared
pub fn kd_dist_sq(p1: &KdPoint3D, p2: &KdPoint3D) -> Float {
    let dx: Float = (p1).x - (p2).x;
    let dy: Float = (p1).y - (p2).y;
    let dz: Float = (p1).z - (p2).z;
    return (dx * dx) + (dy * dy) + (dz * dz);
}

// Next cyclic split axis (0 -> 1 -> 2 -> 0)
pub fn kd_next_axis(current_axis: Int) -> Int {
    if current_axis == 0 { return 1; }
    if current_axis == 1 { return 2; }
    return 0;
}

// Check which side of split hyperplane a query point lies on
pub fn kd_choose_branch(node: &KdNode3D, query: &KdPoint3D) -> Int {
    let ax: Int = (node).axis;
    if ax == 0 {
        return if (query).x < (node).point.x { 0 } else { 1 };
    }
    if ax == 1 {
        return if (query).y < (node).point.y { 0 } else { 1 };
    }
    return if (query).z < (node).point.z { 0 } else { 1 };
}

// Compute 1D axis distance squared to split hyperplane
pub fn kd_axis_dist_sq(node: &KdNode3D, query: &KdPoint3D) -> Float {
    let ax: Int = (node).axis;
    let diff: Float = if ax == 0 {
        (query).x - (node).point.x
    } else if ax == 1 {
        (query).y - (node).point.y
    } else {
        (query).z - (node).point.z
    };
    return diff * diff;
}
