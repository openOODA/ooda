// # H3 Grid Distance & Local IJ Coordinates
//
// Logline: Computes discrete hexagonal grid step distances and local IJ planar coordinate projections.
//
// Setup: Hexagonal grid metric spaces, axial coordinates (i, j, k), and Manhattan-style hex distances.
//
// Beats:
//   1. Define H3CoordIJ local integer planar hexagonal coordinate struct.
//   2. Convert H3 index cells into local IJ grid relative offsets.
//   3. Compute shortest path cell grid step distance between arbitrary cell pairs.

import "./h3_hex_cell_index.oo";

pub type H3CoordIJ = struct {
    i: Int,
    j: Int,
};

pub fn h3_coord_ij_new(i: Int, j: Int) -> H3CoordIJ {
    return H3CoordIJ {
        i: i,
        j: j,
    };
}

// Convert index to rough local IJ coordinate offset relative to base origin
pub fn h3_to_local_ij(origin: &H3Index, destination: &H3Index) -> H3CoordIJ {
    let diff_low: Int = (destination).low - (origin).low;
    let diff_base: Int = (destination).base_cell - (origin).base_cell;
    let i_coord: Int = (diff_base * 100) + (diff_low / 3);
    let j_coord: Int = diff_low - (diff_low / 3);
    return H3CoordIJ {
        i: i_coord,
        j: j_coord,
    };
}

// Hexagonal Manhattan distance in axial coordinates: (|di| + |dj| + |di - dj|) / 2
pub fn h3_distance_ij(c1: &H3CoordIJ, c2: &H3CoordIJ) -> Int {
    let di: Int = (c1).i - (c2).i;
    let dj: Int = (c1).j - (c2).j;
    let dk: Int = di - dj;

    let abs_di: Int = if di < 0 { 0 - di } else { di };
    let abs_dj: Int = if dj < 0 { 0 - dj } else { dj };
    let abs_dk: Int = if dk < 0 { 0 - dk } else { dk };

    return (abs_di + abs_dj + abs_dk) / 2;
}

// Compute discrete cell grid distance between two H3 indices at the same resolution
pub fn h3_grid_distance(origin: &H3Index, destination: &H3Index) -> Int {
    if (origin).res != (destination).res {
        return -1; // Incompatible resolutions
    }
    let ij1 = h3_to_local_ij(origin, origin);
    let ij2 = h3_to_local_ij(origin, destination);
    return h3_distance_ij(&ij1, &ij2);
}

// Estimate approximate Euclidean ground distance (meters) between two cells
pub fn h3_approx_ground_distance_m(origin: &H3Index, destination: &H3Index) -> Float {
    let steps: Int = h3_grid_distance(origin, destination);
    if steps < 0 {
        return 0.0;
    }
    let edge_len: Float = h3_edge_length_m((origin).res);
    let hex_spacing: Float = edge_len * 1.7320508; // sqrt(3) * edge
    let mut steps_f: Float = 0.0;
    let mut s: Int = steps;
    while s >= 1000 { steps_f = steps_f + 1000.0; s = s - 1000; }
    while s >= 100 { steps_f = steps_f + 100.0; s = s - 100; }
    while s >= 10 { steps_f = steps_f + 10.0; s = s - 10; }
    while s >= 1 { steps_f = steps_f + 1.0; s = s - 1; }

    return steps_f * hex_spacing;
}
