// # 3D Octree Spatial Partitioning
//
// Logline: Subdivides 3D continuous space into 8 recursive octants for fast point cloud and volumetric queries.
//
// Setup: Hierarchical spatial partitioning trees with bounding center, half-extents, and octant index resolution.
//
// Beats:
//   1. Define OctreeNode3D and OctreePoint3D structures.
//   2. Determine child octant index (0-7) for 3D coordinates based on split planes.
//   3. Compute octant bounding boxes and test spherical query sphere intersections.

pub type OctreePoint3D = struct {
    id: Int,
    x: Float,
    y: Float,
    z: Float,
};

pub type OctreeNode3D = struct {
    center_x: Float,
    center_y: Float,
    center_z: Float,
    half_size: Float,
    depth: Int,
    max_depth: Int,
    is_leaf: Bool,
    num_points: Int,
    point_ids: List[Int],
};

pub fn octree_point_new(id: Int, x: Float, y: Float, z: Float) -> OctreePoint3D {
    return OctreePoint3D { id: id, x: x, y: y, z: z };
}

pub fn octree_node_new(
    cx: Float,
    cy: Float,
    cz: Float,
    half_sz: Float,
    depth: Int,
    max_depth: Int
) -> OctreeNode3D {
    let ids: List[Int] = list_new_int();
    return OctreeNode3D {
        center_x: cx,
        center_y: cy,
        center_z: cz,
        half_size: half_sz,
        depth: depth,
        max_depth: max_depth,
        is_leaf: true,
        num_points: 0,
        point_ids: ids,
    };
}

// Determine octant index (0-7) for a point relative to node center
// Bit 0 (1): X >= center_x
// Bit 1 (2): Y >= center_y
// Bit 2 (4): Z >= center_z
pub fn octree_get_octant(node: &OctreeNode3D, x: Float, y: Float, z: Float) -> Int {
    let mut octant: Int = 0;
    if x >= (node).center_x { octant = octant + 1; }
    if y >= (node).center_y { octant = octant + 2; }
    if z >= (node).center_z { octant = octant + 4; }
    return octant;
}

// Add point ID to octree node
pub fn octree_node_add_point(node: &mut OctreeNode3D, pt_id: Int) {
    list_push_int((node).point_ids, pt_id);
    (node).num_points = (node).num_points + 1;
}

// Test intersection between octree node bounding cube and query sphere
pub fn octree_intersects_sphere(
    node: &OctreeNode3D,
    sx: Float,
    sy: Float,
    sz: Float,
    radius: Float
) -> Bool {
    let min_x: Float = (node).center_x - (node).half_size;
    let max_x: Float = (node).center_x + (node).half_size;
    let min_y: Float = (node).center_y - (node).half_size;
    let max_y: Float = (node).center_y + (node).half_size;
    let min_z: Float = (node).center_z - (node).half_size;
    let max_z: Float = (node).center_z + (node).half_size;

    // Closest point on box to sphere center
    let cx: Float = if sx < min_x { min_x } else { if sx > max_x { max_x } else { sx } };
    let cy: Float = if sy < min_y { min_y } else { if sy > max_y { max_y } else { sy } };
    let cz: Float = if sz < min_z { min_z } else { if sz > max_z { max_z } else { sz } };

    let dx: Float = sx - cx;
    let dy: Float = sy - cy;
    let dz: Float = sz - cz;
    let dist_sq: Float = (dx * dx) + (dy * dy) + (dz * dz);

    return dist_sq <= (radius * radius);
}
