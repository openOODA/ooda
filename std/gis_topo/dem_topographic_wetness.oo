// # Topographic Wetness Index (TWI) Hydrological Model
//
// Logline: Calculates the Beven-Kirkby Topographic Wetness Index (TWI = ln(a / tan(beta))) quantifying soil moisture and saturation.
//
// Setup: Steady-state hydrological wetness index combining specific catchment area (a) and local slope angle (beta).
//
// Beats:
//   1. Compute specific catchment area per unit contour length.
//   2. Compute local slope tangent tan(beta) with minimum threshold clamping.
//   3. Calculate TWI dimensionless moisture index value.

pub fn twi_calc(
    specific_catchment_area_m: Float,
    slope_deg: Float
) -> Float {
    // Convert slope to radians
    let slope_rad: Float = slope_deg * 0.017453292519943295;
    let sin_s: Float = sin(slope_rad);
    let cos_s: Float = cos(slope_rad);

    // tan(slope) = sin / cos
    let tan_slope: Float = if cos_s > 0.001 {
        sin_s / cos_s
    } else {
        1000.0
    };

    // Minimum slope threshold (e.g. 0.001 to prevent division by zero in flat terrain)
    let clamped_tan: Float = if tan_slope < 0.001 { 0.001 } else { tan_slope };
    let area_clamped: Float = if specific_catchment_area_m < 1.0 { 1.0 } else { specific_catchment_area_m };

    let ratio: Float = area_clamped / clamped_tan;
    return ln(ratio);
}

// Classify wetland / high saturation risk based on TWI threshold (typically > 8.0 - 10.0)
pub fn twi_is_potential_wetland(twi_val: Float, threshold: Float) -> Bool {
    return twi_val >= threshold;
}
