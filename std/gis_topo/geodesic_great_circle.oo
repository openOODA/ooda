// # Great-Circle Navigation & Cross-Track Distance
//
// Logline: Calculates spherical great-circle navigational routes, initial/final azimuths, waypoints, and cross-track deviations.
//
// Setup: Spherical trigonometry on Earth sphere model (R = 6371008.8m) for long-range navigation and flight planning.
//
// Beats:
//   1. Define GreatCircleRoute struct containing start, destination, distance, and initial bearing.
//   2. Compute forward initial bearing and backward final bearing between coordinates.
//   3. Calculate cross-track error distance of off-route point relative to baseline track.

pub type GreatCircleRoute = struct {
    lat1_deg: Float,
    lon1_deg: Float,
    lat2_deg: Float,
    lon2_deg: Float,
    distance_m: Float,
    initial_bearing_deg: Float,
    final_bearing_deg: Float
};

// Convert degrees to radians
pub fn gc_deg2rad(deg: Float) -> Float {
    return deg * 0.017453292519943295;
}

// Convert radians to degrees
pub fn gc_rad2deg(rad: Float) -> Float {
    return rad * 57.29577951308232;
}

// Great circle angular distance in radians (Haversine formula)
pub fn gc_angular_distance_rad(
    lat1_deg: Float, lon1_deg: Float,
    lat2_deg: Float, lon2_deg: Float
) -> Float {
    let phi1: Float = gc_deg2rad(lat1_deg);
    let phi2: Float = gc_deg2rad(lat2_deg);
    let d_phi: Float = gc_deg2rad(lat2_deg - lat1_deg);
    let d_lambda: Float = gc_deg2rad(lon2_deg - lon1_deg);

    let sin_half_dphi: Float = sin(d_phi * 0.5);
    let sin_half_dlam: Float = sin(d_lambda * 0.5);

    let a: Float = (sin_half_dphi * sin_half_dphi) +
                   (cos(phi1) * cos(phi2) * sin_half_dlam * sin_half_dlam);

    let clamped_a: Float = if a > 1.0 { 1.0 } else { if a < 0.0 { 0.0 } else { a } };
    return 2.0 * sqrt(clamped_a);
}

// Compute initial compass bearing (0-360 degrees) from start to destination
pub fn gc_initial_bearing(
    lat1_deg: Float, lon1_deg: Float,
    lat2_deg: Float, lon2_deg: Float
) -> Float {
    let phi1: Float = gc_deg2rad(lat1_deg);
    let phi2: Float = gc_deg2rad(lat2_deg);
    let d_lambda: Float = gc_deg2rad(lon2_deg - lon1_deg);

    let y: Float = sin(d_lambda) * cos(phi2);
    let x: Float = (cos(phi1) * sin(phi2)) - (sin(phi1) * cos(phi2) * cos(d_lambda));

    // Approximate azimuth calculation
    let mut bearing_deg: Float = 0.0;
    if x > 0.000001 {
        bearing_deg = gc_rad2deg(y / x);
    } else if x < -0.000001 {
        bearing_deg = 180.0 + gc_rad2deg(y / x);
    } else {
        bearing_deg = if y > 0.0 { 90.0 } else { 270.0 };
    }

    while bearing_deg < 0.0 {
        bearing_deg = bearing_deg + 360.0;
    }
    while bearing_deg >= 360.0 {
        bearing_deg = bearing_deg - 360.0;
    }
    return bearing_deg;
}

// Plan great circle navigation route
pub fn gc_plan_route(
    lat1_deg: Float, lon1_deg: Float,
    lat2_deg: Float, lon2_deg: Float
) -> GreatCircleRoute {
    let ang_dist: Float = gc_angular_distance_rad(lat1_deg, lon1_deg, lat2_deg, lon2_deg);
    let dist_m: Float = ang_dist * 6371008.8;
    let brg: Float = gc_initial_bearing(lat1_deg, lon1_deg, lat2_deg, lon2_deg);

    return GreatCircleRoute {
        lat1_deg: lat1_deg,
        lon1_deg: lon1_deg,
        lat2_deg: lat2_deg,
        lon2_deg: lon2_deg,
        distance_m: dist_m,
        initial_bearing_deg: brg,
        final_bearing_deg: brg
    };
}
