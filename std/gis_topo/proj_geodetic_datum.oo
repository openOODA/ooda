// # Geodetic Datums & 7-Parameter Helmert Transformation
//
// Logline: Converts 3D coordinates across geodetic datums (WGS84, NAD83, ETRS89) using 7-parameter Helmert conformal shifts.
//
// Setup: Geodetic reference ellipsoids (semi-major axis, inverse flattening) and 3D similarity transformation matrices.
//
// Beats:
//   1. Define GeodeticDatum parameters (semi_major_a, flattening_f) and Helmert7Param struct.
//   2. Apply 3D coordinate translation, 3-axis rotation, and scale factor transformation.
//   3. Provide reference datum definitions for WGS84, GRS80, and Airy 1830.

pub type GeodeticDatum = struct {
    name: String,
    semi_major_a: Float,
    flattening_f: Float,
    epsg_code: Int,
};

pub type Helmert7Param = struct {
    dx_m: Float,      // Translation X (meters)
    dy_m: Float,      // Translation Y (meters)
    dz_m: Float,      // Translation Z (meters)
    rx_arcsec: Float, // Rotation around X (arc-seconds)
    ry_arcsec: Float, // Rotation around Y (arc-seconds)
    rz_arcsec: Float, // Rotation around Z (arc-seconds)
    scale_ppm: Float, // Scale factor (parts per million)
};

pub fn datum_wgs84() -> GeodeticDatum {
    return GeodeticDatum {
        name: "WGS 84",
        semi_major_a: 6378137.0,
        flattening_f: 0.0033528106647474805, // 1 / 298.257223563
        epsg_code: 4326,
    };
}

pub fn datum_grs80() -> GeodeticDatum {
    return GeodeticDatum {
        name: "GRS 1980 / NAD83",
        semi_major_a: 6378137.0,
        flattening_f: 0.003352810681182319, // 1 / 298.257222101
        epsg_code: 4269,
    };
}

pub fn datum_airy1830() -> GeodeticDatum {
    return GeodeticDatum {
        name: "Airy 1830 / OSGB36",
        semi_major_a: 6377563.396,
        flattening_f: 0.003340850641496962, // 1 / 299.3249646
        epsg_code: 4277,
    };
}

pub fn helmert_nad83_to_wgs84() -> Helmert7Param {
    return Helmert7Param {
        dx_m: -0.9956,
        dy_m: 1.9013,
        dz_m: 0.5215,
        rx_arcsec: -0.025915,
        ry_arcsec: -0.009426,
        rz_arcsec: -0.011599,
        scale_ppm: 0.00062,
    };
}

// Apply 7-parameter Helmert 3D Cartesian transformation: [X', Y', Z'] = T + (1 + s) * R * [X, Y, Z]
pub fn helmert_transform_point(
    x: Float,
    y: Float,
    z: Float,
    p: &Helmert7Param
) -> List[Float] {
    let arcsec_to_rad: Float = 0.00000484813681109536;
    let rx: Float = (p).rx_arcsec * arcsec_to_rad;
    let ry: Float = (p).ry_arcsec * arcsec_to_rad;
    let rz: Float = (p).rz_arcsec * arcsec_to_rad;

    let s: Float = 1.0 + ((p).scale_ppm * 0.000001);

    // Infinitesimal rotation matrix approximation:
    // [ 1,  -rz,  ry ]
    // [ rz,   1, -rx ]
    // [-ry,  rx,   1 ]
    let x_rot: Float = x - (rz * y) + (ry * z);
    let y_rot: Float = (rz * x) + y - (rx * z);
    let z_rot: Float = (0.0 - (ry * x)) + (rx * y) + z;

    let x_out: Float = (p).dx_m + (s * x_rot);
    let y_out: Float = (p).dy_m + (s * y_rot);
    let z_out: Float = (p).dz_m + (s * z_rot);

    let mut res: List[Float] = list_new();
    list_push(res, x_out);
    list_push(res, y_out);
    list_push(res, z_out);
    return res;
}
