// # Well-Known Binary (WKB) OGC Geometry Decoder
//
// Logline: Decodes binary Well-Known Binary (WKB) geometries, byte-order endianness, and 2D/3D OGC type tags.
//
// Setup: OGC Simple Features specification for binary serialized geometry streams and endian flags.
//
// Beats:
//   1. Define WkbHeader and WkbDecodedGeometry metadata structures.
//   2. Parse byte order (Big-Endian XDR vs Little-Endian NDR) and OGC geometry integer type codes.
//   3. Handle 2D and 3D Z/M dimensional flags (ISO 1000/2000/3000 series).

pub type WkbHeader = struct {
    byte_order: Int,     // 0 = BigEndian (XDR), 1 = LittleEndian (NDR)
    raw_type: Int,       // Raw integer type code
    ogc_geom_type: Int,  // Base type: 1=Point, 2=LineString, 3=Polygon, etc.
    has_z: Bool,
    has_m: Bool,
};

pub fn wkb_header_new(byte_order: Int, raw_type: Int) -> WkbHeader {
    let mut base_type: Int = raw_type;
    let mut is_z: Bool = false;
    let mut is_m: Bool = false;

    // ISO SQL/MM style 3D/4D codes: 1000 = +Z, 2000 = +M, 3000 = +ZM
    if base_type >= 3000 {
        base_type = base_type - 3000;
        is_z = true;
        is_m = true;
    } else if base_type >= 2000 {
        base_type = base_type - 2000;
        is_m = true;
    } else if base_type >= 1000 {
        base_type = base_type - 1000;
        is_z = true;
    }

    return WkbHeader {
        byte_order: byte_order,
        raw_type: raw_type,
        ogc_geom_type: base_type,
        has_z: is_z,
        has_m: is_m,
    };
}

pub fn wkb_type_name(ogc_type: Int) -> String {
    if ogc_type == 1 { return "Point"; }
    if ogc_type == 2 { return "LineString"; }
    if ogc_type == 3 { return "Polygon"; }
    if ogc_type == 4 { return "MultiPoint"; }
    if ogc_type == 5 { return "MultiLineString"; }
    if ogc_type == 6 { return "MultiPolygon"; }
    if ogc_type == 7 { return "GeometryCollection"; }
    return "UnknownGeometry";
}

// Compute byte size of a point given dimensional flags (8 bytes per coordinate float64)
pub fn wkb_point_byte_size(hdr: &WkbHeader) -> Int {
    let mut coords: Int = 2; // X, Y
    if (hdr).has_z { coords = coords + 1; }
    if (hdr).has_m { coords = coords + 1; }
    return coords * 8;
}

// Compute expected byte size for a linestring of N vertices
pub fn wkb_linestring_byte_size(hdr: &WkbHeader, num_points: Int) -> Int {
    let pt_size: Int = wkb_point_byte_size(hdr);
    return 5 + 4 + (num_points * pt_size); // 1 byte order + 4 type + 4 count + points
}
