// # Spherical Web Mercator Projection (EPSG:3857)
//
// Logline: Implements EPSG:3857 Web Mercator coordinate transformations, tile coordinate mapping, and zoom level resolutions.
//
// Setup: Spherical conformal projection standard for web mapping (OpenStreetMap, Mapbox, Google Maps).
//
// Beats:
//   1. Define MercatorPoint and TileCoord structures.
//   2. Transform geographic Lat/Lon to EPSG:3857 Cartesian Easting/Northing meters.
//   3. Compute slippy map tile XYZ coordinates from geographic positions across zoom levels 0-25.

pub type MercatorPoint = struct {
    x: Float,
    y: Float,
};

pub type TileCoord = struct {
    x: Int,
    y: Int,
    z: Int,
};

pub fn mercator_point_new(x: Float, y: Float) -> MercatorPoint {
    return MercatorPoint { x: x, y: y };
}

pub fn tile_coord_new(x: Int, y: Int, z: Int) -> TileCoord {
    return TileCoord { x: x, y: y, z: z };
}

// Convert geographic lat/lng to Web Mercator (EPSG:3857) meters
pub fn web_mercator_forward(lat_deg: Float, lon_deg: Float) -> MercatorPoint {
    let r_major: Float = 6378137.0;
    let rad_factor: Float = 0.017453292519943295;

    let x: Float = r_major * (lon_deg * rad_factor);

    // Clamped latitude to [-85.05112878, 85.05112878]
    let clamped_lat: Float = if lat_deg > 85.05112878 {
        85.05112878
    } else if lat_deg < -85.05112878 {
        -85.05112878
    } else {
        lat_deg
    };

    let phi: Float = clamped_lat * rad_factor;
    let sin_phi: Float = sin(phi);

    // y = R/2 * ln((1 + sin(phi)) / (1 - sin(phi)))
    let one_plus_sin: Float = 1.0 + sin_phi;
    let one_minus_sin: Float = if (1.0 - sin_phi) > 0.0000001 { 1.0 - sin_phi } else { 0.0000001 };
    let ratio: Float = one_plus_sin / one_minus_sin;
    let y: Float = 0.5 * r_major * ln(ratio);

    return MercatorPoint { x: x, y: y };
}

// Convert Web Mercator meters to geographic lat/lng
pub fn web_mercator_inverse(x: Float, y: Float) -> List[Float] {
    let r_major: Float = 6378137.0;
    let lon_deg: Float = (x / r_major) * 57.29577951308232;

    // phi = pi/2 - 2 * atan(exp(-y / R))
    // Approximation for inverse mercator
    let y_scaled: Float = y / r_major;
    let exp_y: Float = exp(y_scaled);
    let sin_phi: Float = (exp_y - 1.0) / (exp_y + 1.0);
    let phi_approx: Float = sin_phi * 1.57079632679;
    let lat_deg: Float = phi_approx * 57.29577951308232;

    let mut coords: List[Float] = list_new();
    list_push(coords, lat_deg);
    list_push(coords, lon_deg);
    return coords;
}

// Convert geographic lat/lon to slippy map Tile XYZ coordinates
pub fn lat_lon_to_tile(lat_deg: Float, lon_deg: Float, zoom: Int) -> TileCoord {
    let mut num_tiles: Float = 1.0;
    let mut z: Int = 0;
    while z < zoom {
        num_tiles = num_tiles * 2.0;
        z = z + 1;
    }

    let tile_x_f: Float = ((lon_deg + 180.0) / 360.0) * num_tiles;
    let mut tile_x: Int = 0;
    let mut tmp_x: Float = tile_x_f;
    while tmp_x >= 1.0 { tile_x = tile_x + 1; tmp_x = tmp_x - 1.0; }

    let lat_rad: Float = lat_deg * 0.017453292519943295;
    let sin_lat: Float = sin(lat_rad);
    let ratio: Float = (1.0 + sin_lat) / (1.0 - sin_lat);
    let log_val: Float = ln(ratio);
    let tile_y_f: Float = (1.0 - (log_val / 3.141592653589793)) * 0.5 * num_tiles;

    let mut tile_y: Int = 0;
    let mut tmp_y: Float = tile_y_f;
    while tmp_y >= 1.0 { tile_y = tile_y + 1; tmp_y = tmp_y - 1.0; }

    return TileCoord { x: tile_x, y: tile_y, z: zoom };
}
