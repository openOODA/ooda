// # LiDAR Point Cloud Ground Classification & Filtering
//
// Logline: Classifies raw 3D LiDAR point clouds into ground and non-ground returns using progressive surface filtering.
//
// Setup: ASPRS classification standards (Class 2 Ground, Class 3-5 Vegetation, Class 6 Building) and terrain residuals.
//
// Beats:
//   1. Define LidarPoint3D struct with ASPRS classification code, intensity, and return number.
//   2. Filter ground surface points based on elevation residual thresholds above bare-earth model.
//   3. Classify vegetation canopy and building rooftop points by height above ground.

pub type LidarPoint3D = struct {
    x: Float,
    y: Float,
    z: Float,
    intensity: Int,
    return_number: Int,
    num_returns: Int,
    classification: Int // ASPRS class: 1=Unassigned, 2=Ground, 3=LowVeg, 4=MedVeg, 5=HighVeg, 6=Building
};

pub fn lidar_point_new(
    x: Float,
    y: Float,
    z: Float,
    intensity: Int,
    ret_num: Int,
    tot_ret: Int
) -> LidarPoint3D {
    return LidarPoint3D {
        x: x,
        y: y,
        z: z,
        intensity: intensity,
        return_number: ret_num,
        num_returns: tot_ret,
        classification: 1 // Default unassigned
    };
}

pub fn lidar_class_ground() -> Int { return 2; }
pub fn lidar_class_low_veg() -> Int { return 3; }
pub fn lidar_class_med_veg() -> Int { return 4; }
pub fn lidar_class_high_veg() -> Int { return 5; }
pub fn lidar_class_building() -> Int { return 6; }

// Classify point given estimated ground elevation at (x, y)
pub fn lidar_classify_by_height(
    pt: &mut LidarPoint3D,
    estimated_ground_z: Float
) {
    let height_above_ground: Float = (pt).z - estimated_ground_z;

    if height_above_ground < 0.3 {
        (pt).classification = lidar_class_ground();
    } else if height_above_ground < 2.0 {
        (pt).classification = lidar_class_low_veg();
    } else if height_above_ground < 5.0 {
        (pt).classification = lidar_class_med_veg();
    } else if height_above_ground < 50.0 {
        (pt).classification = lidar_class_high_veg();
    } else {
        (pt).classification = lidar_class_building();
    }
}

pub fn lidar_is_ground(pt: &LidarPoint3D) -> Bool {
    return (pt).classification == lidar_class_ground();
}
