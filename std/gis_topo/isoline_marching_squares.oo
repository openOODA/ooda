// # Isoline & Contour Marching Squares Algorithm
//
// Logline: Extracts continuous elevation contour lines from 2D digital elevation grids using the 16-case Marching Squares algorithm.
//
// Setup: 2D scalar fields, cell corner thresholding, and edge linear interpolation for topographic contouring.
//
// Beats:
//   1. Define ContourSegment2D struct with start and end 2D coordinates.
//   2. Compute 4-bit binary index (0-15) based on 4 corner values exceeding isovalue.
//   3. Linearly interpolate contour crossing coordinates along cell edges.

pub type ContourSegment2D = struct {
    x1: Float,
    y1: Float,
    x2: Float,
    y2: Float,
};

pub fn contour_segment_new(x1: Float, y1: Float, x2: Float, y2: Float) -> ContourSegment2D {
    return ContourSegment2D {
        x1: x1,
        y1: y1,
        x2: x2,
        y2: y2,
    };
}

// Compute 4-bit marching squares cell index:
// Bit 0 (1): top-left (z_tl >= isovalue)
// Bit 1 (2): top-right (z_tr >= isovalue)
// Bit 2 (4): bottom-right (z_br >= isovalue)
// Bit 3 (8): bottom-left (z_bl >= isovalue)
pub fn marching_squares_case(
    z_tl: Float,
    z_tr: Float,
    z_br: Float,
    z_bl: Float,
    isovalue: Float
) -> Int {
    let mut case_idx: Int = 0;
    if z_tl >= isovalue { case_idx = case_idx + 1; }
    if z_tr >= isovalue { case_idx = case_idx + 2; }
    if z_br >= isovalue { case_idx = case_idx + 4; }
    if z_bl >= isovalue { case_idx = case_idx + 8; }
    return case_idx;
}

// Linear interpolation between two scalar values to find crossing fraction t in [0, 1]
pub fn marching_squares_interp(v0: Float, v1: Float, isoval: Float) -> Float {
    let diff: Float = v1 - v0;
    if (diff > -0.000001) && (diff < 0.000001) {
        return 0.5;
    }
    let t: Float = (isoval - v0) / diff;
    if t < 0.0 { return 0.0; }
    if t > 1.0 { return 1.0; }
    return t;
}

// Generate contour segment for a single grid cell given corner elevations
pub fn marching_squares_cell_segments(
    x_left: Float, x_right: Float,
    y_top: Float, y_bot: Float,
    z_tl: Float, z_tr: Float,
    z_br: Float, z_bl: Float,
    isovalue: Float
) -> List[ContourSegment2D] {
    let mut segments: List[ContourSegment2D] = list_new();
    let c: Int = marching_squares_case(z_tl, z_tr, z_br, z_bl, isovalue);

    if (c == 0) || (c == 15) {
        return segments; // Fully below or fully above isovalue
    }

    // Interpolate 4 edge crossings
    let t_top: Float = marching_squares_interp(z_tl, z_tr, isovalue);
    let t_right: Float = marching_squares_interp(z_tr, z_br, isovalue);
    let t_bot: Float = marching_squares_interp(z_bl, z_br, isovalue);
    let t_left: Float = marching_squares_interp(z_tl, z_bl, isovalue);

    let p_top_x: Float = x_left + (t_top * (x_right - x_left));
    let p_top_y: Float = y_top;

    let p_right_x: Float = x_right;
    let p_right_y: Float = y_top + (t_right * (y_bot - y_top));

    let p_bot_x: Float = x_left + (t_bot * (x_right - x_left));
    let p_bot_y: Float = y_bot;

    let p_left_x: Float = x_left;
    let p_left_y: Float = y_top + (t_left * (y_bot - y_top));

    if (c == 1) || (c == 14) {
        list_push(segments, contour_segment_new(p_left_x, p_left_y, p_top_x, p_top_y));
    } else if (c == 2) || (c == 13) {
        list_push(segments, contour_segment_new(p_top_x, p_top_y, p_right_x, p_right_y));
    } else if (c == 3) || (c == 12) {
        list_push(segments, contour_segment_new(p_left_x, p_left_y, p_right_x, p_right_y));
    } else if (c == 4) || (c == 11) {
        list_push(segments, contour_segment_new(p_right_x, p_right_y, p_bot_x, p_bot_y));
    } else if (c == 6) || (c == 9) {
        list_push(segments, contour_segment_new(p_top_x, p_top_y, p_bot_x, p_bot_y));
    } else if (c == 7) || (c == 8) {
        list_push(segments, contour_segment_new(p_left_x, p_left_y, p_bot_x, p_bot_y));
    }

    return segments;
}
