// # GeoTIFF Tag Directory & Georeference Metadata
//
// Logline: Decodes TIFF Image File Directory (IFD) tags, ModelTiepoint, ModelPixelScale, and GeoKey metadata.
//
// Setup: TIFF 6.0 binary tag structures, baseline TIFF tags, and GeoTIFF geocoding key directories.
//
// Beats:
//   1. Define GeoTiffTag and GeoKeyDirectory metadata structures.
//   2. Parse standard TIFF raster tags (Width, Height, BitsPerSample, SampleFormat).
//   3. Extract georeferencing tiepoints, pixel scale vectors, and EPSG coordinate system codes.

pub type GeoTiffTag = struct {
    tag_id: Int,
    tag_type: Int,
    count: Int,
    value_offset: Int,
};

pub type GeoKeyEntry = struct {
    key_id: Int,
    tiff_tag_location: Int,
    count: Int,
    value_offset: Int,
};

pub type GeoTiffMetadata = struct {
    image_width: Int,
    image_height: Int,
    bits_per_sample: Int,
    model_tiepoint_x: Float,
    model_tiepoint_y: Float,
    model_tiepoint_z: Float,
    pixel_scale_x: Float,
    pixel_scale_y: Float,
    pixel_scale_z: Float,
    epsg_crs_code: Int,
};

pub fn geotiff_metadata_default() -> GeoTiffMetadata {
    return GeoTiffMetadata {
        image_width: 0,
        image_height: 0,
        bits_per_sample: 16,
        model_tiepoint_x: 0.0,
        model_tiepoint_y: 0.0,
        model_tiepoint_z: 0.0,
        pixel_scale_x: 1.0,
        pixel_scale_y: 1.0,
        pixel_scale_z: 1.0,
        epsg_crs_code: 4326,
    };
}

pub fn geotiff_tag_is_geokey(tag_id: Int) -> Bool {
    // 34735: GeoKeyDirectoryTag
    // 34736: GeoDoubleParamsTag
    // 34737: GeoAsciiParamsTag
    // 33550: ModelPixelScaleTag
    // 33922: ModelTiepointTag
    // 34264: ModelTransformationTag
    if tag_id == 34735 || tag_id == 34736 || tag_id == 34737 {
        return true;
    }
    if tag_id == 33550 || tag_id == 33922 || tag_id == 34264 {
        return true;
    }
    return false;
}

pub fn geotiff_tag_name(tag_id: Int) -> String {
    if tag_id == 256 { return "ImageWidth"; }
    if tag_id == 257 { return "ImageLength"; }
    if tag_id == 258 { return "BitsPerSample"; }
    if tag_id == 259 { return "Compression"; }
    if tag_id == 33550 { return "ModelPixelScale"; }
    if tag_id == 33922 { return "ModelTiepoint"; }
    if tag_id == 34264 { return "ModelTransformation"; }
    if tag_id == 34735 { return "GeoKeyDirectory"; }
    if tag_id == 34736 { return "GeoDoubleParams"; }
    if tag_id == 34737 { return "GeoAsciiParams"; }
    return "UnknownTag";
}

pub fn geotiff_extract_resolution(meta: &GeoTiffMetadata) -> List[Float] {
    let mut scales: List[Float] = list_new();
    list_push(scales, (meta).pixel_scale_x);
    list_push(scales, (meta).pixel_scale_y);
    return scales;
}

pub fn geotiff_compute_bounds(meta: &GeoTiffMetadata) -> List[Float] {
    let min_x: Float = (meta).model_tiepoint_x;
    let mut w_f: Float = 0.0;
    let mut w: Int = (meta).image_width;
    while w >= 1000 { w_f = w_f + 1000.0; w = w - 1000; }
    while w >= 100 { w_f = w_f + 100.0; w = w - 100; }
    while w >= 10 { w_f = w_f + 10.0; w = w - 10; }
    while w >= 1 { w_f = w_f + 1.0; w = w - 1; }

    let max_x: Float = min_x + (w_f * (meta).pixel_scale_x);

    let max_y: Float = (meta).model_tiepoint_y;
    let mut h_f: Float = 0.0;
    let mut h: Int = (meta).image_height;
    while h >= 1000 { h_f = h_f + 1000.0; h = h - 1000; }
    while h >= 100 { h_f = h_f + 100.0; h = h - 100; }
    while h >= 10 { h_f = h_f + 10.0; h = h - 10; }
    while h >= 1 { h_f = h_f + 1.0; h = h - 1; }

    let min_y: Float = max_y - (h_f * (meta).pixel_scale_y);

    let mut bounds: List[Float] = list_new();
    list_push(bounds, min_x);
    list_push(bounds, min_y);
    list_push(bounds, max_x);
    list_push(bounds, max_y);
    return bounds;
}
