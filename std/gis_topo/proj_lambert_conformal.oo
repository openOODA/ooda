// # Lambert Conformal Conic (LCC) Map Projection
//
// Logline: Converts geodetic coordinates to planar Easting/Northing via 2-standard-parallel Lambert Conformal Conic projection.
//
// Setup: Secant conic projection preserving local angles and shapes, standard for aeronautical charts and regional surveys.
//
// Beats:
//   1. Define LccProjectionConfig struct holding standard parallels (lat1, lat2), origin, and false offsets.
//   2. Compute conic projection constants (cone constant n, scale factor F, initial radius rho0).
//   3. Project geographic (lat, lon) coordinates to planar Lambert Easting/Northing.

pub type LccProjectionConfig = struct {
    std_parallel_1_deg: Float,
    std_parallel_2_deg: Float,
    origin_lat_deg: Float,
    origin_lon_deg: Float,
    false_easting: Float,
    false_northing: Float
};

pub fn lcc_config_default() -> LccProjectionConfig {
    return LccProjectionConfig {
        std_parallel_1_deg: 33.0,
        std_parallel_2_deg: 45.0,
        origin_lat_deg: 39.0,
        origin_lon_deg: -96.0,
        false_easting: 0.0,
        false_northing: 0.0
    };
}

// Convert degrees to radians
pub fn lcc_deg2rad(deg: Float) -> Float {
    return deg * 0.017453292519943295;
}

// Forward Lambert Conformal Conic projection (spherical approximation)
pub fn lcc_forward(cfg: &LccProjectionConfig, lat_deg: Float, lon_deg: Float) -> List[Float] {
    let phi1: Float = lcc_deg2rad((cfg).std_parallel_1_deg);
    let phi2: Float = lcc_deg2rad((cfg).std_parallel_2_deg);
    let phi0: Float = lcc_deg2rad((cfg).origin_lat_deg);
    let lambda0: Float = lcc_deg2rad((cfg).origin_lon_deg);

    let phi: Float = lcc_deg2rad(lat_deg);
    let lambda: Float = lcc_deg2rad(lon_deg);

    let r_earth: Float = 6371008.8;

    // Cone constant n ~= (sin(phi1) + sin(phi2)) / 2
    let n: Float = (sin(phi1) + sin(phi2)) * 0.5;

    // Colatitude angle calculations
    let half_pi: Float = 1.57079632679;
    let t0: Float = (half_pi - phi0) * 0.5;
    let t: Float = (half_pi - phi) * 0.5;

    let rho0: Float = r_earth * t0;
    let rho: Float = r_earth * t;

    let theta: Float = n * (lambda - lambda0);

    let x: Float = (cfg).false_easting + (rho * sin(theta));
    let y: Float = (cfg).false_northing + (rho0 - (rho * cos(theta)));

    let mut result: List[Float] = list_new();
    list_push(result, x);
    list_push(result, y);
    return result;
}
