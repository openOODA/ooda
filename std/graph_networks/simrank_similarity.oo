// # SimRank Structural Graph Node Similarity
//
// Logline: Computes pairwise structural graph similarities based on iterative in-neighbor intersection convergence.
//
// Setup: Fixed-point matrix iteration propagating similarity decay factors between connected vertex pairs.
//
// Beats:
//   1. Initialize identity diagonal similarity matrix across N graph vertices.
//   2. Propagate similarity mass along bipartite in-neighbor cartesian products with decay factor C.
//   3. Iterate until matrix Frobenius norm delta converges below tolerance threshold.

pub type SimRankMatrix = struct {
    num_nodes: Int,
    matrix_data: List[Int], // Scaled integers (0..10000) for N x N matrix
    iterations: Int
};

pub fn simrank_matrix_create(n: Int) -> SimRankMatrix {
    let total: Int = n * n;
    let mut data: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total {
        let row: Int = i / n;
        let col: Int = i % n;
        if row == col {
            data = list_push(data, 10000); // Identity diagonal 1.0
        } else {
            data = list_push(data, 0);
        }
        i = i + 1;
    }
    return SimRankMatrix {
        num_nodes: n,
        matrix_data: data,
        iterations: 0
    };
}

pub fn simrank_get(mat: &SimRankMatrix, u: Int, v: Int) -> Int {
    let n: Int = (mat).num_nodes;
    if u < 0 || u >= n || v < 0 || v >= n {
        return 0;
    }
    let idx: Int = u * n + v;
    return list_get((mat).matrix_data, idx);
}

pub fn simrank_set_data(data: List[Int], idx: Int, val: Int) -> List[Int] {
    let mut next_list: List[Int] = list_new();
    let total: Int = list_len(data);
    let mut i: Int = 0;
    while i < total {
        if i == idx {
            next_list = list_push(next_list, val);
        } else {
            next_list = list_push(next_list, list_get(data, i));
        }
        i = i + 1;
    }
    return next_list;
}

pub fn simrank_step(
    mat: &SimRankMatrix,
    in_neighbors: List[List[Int]], // List of neighbor lists
    decay_pct: Int                 // e.g. 80 for 0.8
) -> SimRankMatrix {
    let n: Int = (mat).num_nodes;
    let mut next_data: List[Int] = list_new();

    let mut u: Int = 0;
    while u < n {
        let mut v: Int = 0;
        while v < n {
            if u == v {
                next_data = list_push(next_data, 10000);
            } else {
                let in_u: List[Int] = list_get(in_neighbors, u);
                let in_v: List[Int] = list_get(in_neighbors, v);
                let len_u: Int = list_len(in_u);
                let len_v: Int = list_len(in_v);

                if len_u == 0 || len_v == 0 {
                    next_data = list_push(next_data, 0);
                } else {
                    let mut sum_sim: Int = 0;
                    let mut i: Int = 0;
                    while i < len_u {
                        let nu: Int = list_get(in_u, i);
                        let mut j: Int = 0;
                        while j < len_v {
                            let nv: Int = list_get(in_v, j);
                            sum_sim = sum_sim + simrank_get(mat, nu, nv);
                            j = j + 1;
                        }
                        i = i + 1;
                    }
                    let total_pairs: Int = len_u * len_v;
                    let avg_sim: Int = sum_sim / total_pairs;
                    let decayed: Int = (avg_sim * decay_pct) / 100;
                    next_data = list_push(next_data, decayed);
                }
            }
            v = v + 1;
        }
        u = u + 1;
    }

    return SimRankMatrix {
        num_nodes: n,
        matrix_data: next_data,
        iterations: (mat).iterations + 1
    };
}
