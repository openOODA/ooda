// # Eigenvector and Katz Centrality Solver
//
// Logline: Computes spectral node influence using power iteration eigenvector and Katz attenuation propagation.
//
// Setup: Spectral graph centrality engine solving dominant adjacency matrix eigenvectors and attenuated walk sums.
//
// Beats:
//   1. Distribute uniform initial influence vectors across network vertices.
//   2. Multiply iteratively by graph adjacency matrix with L1/L2 vector normalization (Eigenvector).
//   3. Accumulate walks of all lengths attenuated by alpha factor with baseline beta teleportation (Katz).

pub type SpectralCentralityResult = struct {
    num_nodes: Int,
    scores: List[Int], // Scaled integers (0..10000)
    iterations: Int,
    is_converged: Bool,
};

pub fn eigenvector_centrality_compute(
    num_nodes: Int,
    adjacency: List[List[Int]],
    max_iters: Int
) -> SpectralCentralityResult {
    let mut x: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        x = list_push(x, 1000); // Initial unit score
        i = i + 1;
    }

    let mut iter: Int = 0;
    let mut converged: Bool = false;

    while iter < max_iters && !converged {
        let mut x_next: List[Int] = list_new();
        let mut sum_norm: Int = 0;

        let mut u: Int = 0;
        while u < num_nodes {
            let nbrs: List[Int] = list_get(adjacency, u);
            let n_nbrs: Int = list_len(nbrs);
            let mut val: Int = 0;
            let mut j: Int = 0;
            while j < n_nbrs {
                let v: Int = list_get(nbrs, j);
                val = val + list_get(x, v);
                j = j + 1;
            }
            x_next = list_push(x_next, val);
            sum_norm = sum_norm + val;
            u = u + 1;
        }

        if sum_norm == 0 {
            sum_norm = 1;
        }

        // Normalize to scale 10000
        let mut x_norm: List[Int] = list_new();
        let mut delta: Int = 0;
        let mut k: Int = 0;
        while k < num_nodes {
            let cur_val: Int = list_get(x_next, k);
            let scaled_val: Int = (cur_val * 10000) / sum_norm;
            let old_val: Int = list_get(x, k);
            let mut diff: Int = scaled_val - old_val;
            if diff < 0 {
                diff = 0 - diff;
            }
            delta = delta + diff;
            x_norm = list_push(x_norm, scaled_val);
            k = k + 1;
        }

        x = x_norm;
        if delta < 10 {
            converged = true;
        }
        iter = iter + 1;
    }

    return SpectralCentralityResult {
        num_nodes: num_nodes,
        scores: x,
        iterations: iter,
        is_converged: converged,
    };
}

pub fn katz_centrality_compute(
    num_nodes: Int,
    adjacency: List[List[Int]],
    alpha_pct: Int, // e.g. 10 for 0.10 attenuation
    beta_val: Int,  // Base exogenous weight (e.g. 1000)
    max_iters: Int
) -> SpectralCentralityResult {
    let mut katz: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        katz = list_push(katz, beta_val);
        i = i + 1;
    }

    let mut iter: Int = 0;
    while iter < max_iters {
        let mut next_katz: List[Int] = list_new();
        let mut u: Int = 0;
        while u < num_nodes {
            let nbrs: List[Int] = list_get(adjacency, u);
            let n_nbrs: Int = list_len(nbrs);
            let mut sum_nbrs: Int = 0;
            let mut j: Int = 0;
            while j < n_nbrs {
                let v: Int = list_get(nbrs, j);
                sum_nbrs = sum_nbrs + list_get(katz, v);
                j = j + 1;
            }
            let attenuated: Int = (sum_nbrs * alpha_pct) / 100;
            next_katz = list_push(next_katz, attenuated + beta_val);
            u = u + 1;
        }
        katz = next_katz;
        iter = iter + 1;
    }

    return SpectralCentralityResult {
        num_nodes: num_nodes,
        scores: katz,
        iterations: iter,
        is_converged: true,
    };
}
