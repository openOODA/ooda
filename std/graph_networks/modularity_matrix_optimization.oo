// # Newman Spectral Modularity Matrix & Partitioning
//
// Logline: Computes the modularity matrix B_ij = A_ij - (k_i k_j)/(2m) and evaluates community partition quality Q.
//
// Setup: Spectral graph partitioning framework maximizing modularity quality Q against null-model configuration networks.
//
// Beats:
//   1. Construct modularity matrix subtracting degree-product expectations from adjacency entries.
//   2. Evaluate partition modularity score Q for arbitrary community assignments.
//   3. Compute optimal 2-way graph bi-partitioning via leading eigenvector sign heuristics.

pub type ModularityPartitionResult = struct {
    num_nodes: Int,
    partition: List[Int], // +1 or -1 for bi-partition
    modularity_q: Int,    // Scaled by 10000 (-10000 to +10000)
};

pub fn modularity_eval_q(
    num_nodes: Int,
    adjacency_matrix: List[Int],
    degrees: List[Int],
    total_edges: Int,
    community_assignment: List[Int]
) -> Int {
    if total_edges <= 0 {
        return 0;
    }
    let two_m: Int = 2 * total_edges;
    let mut sum_q: Int = 0;

    let mut u: Int = 0;
    while u < num_nodes {
        let cu: Int = list_get(community_assignment, u);
        let ku: Int = list_get(degrees, u);

        let mut v: Int = 0;
        while v < num_nodes {
            let cv: Int = list_get(community_assignment, v);
            if cu == cv {
                let kv: Int = list_get(degrees, v);
                let a_uv: Int = list_get(adjacency_matrix, u * num_nodes + v);
                // B_uv = A_uv - (ku * kv) / (2m)
                let expected: Int = (ku * kv * 10000) / two_m;
                let actual: Int = a_uv * 10000;
                let b_uv: Int = actual - expected;
                sum_q = sum_q + b_uv;
            }
            v = v + 1;
        }
        u = u + 1;
    }

    return sum_q / two_m;
}

pub fn modularity_spectral_bipartition(
    num_nodes: Int,
    adjacency_matrix: List[Int],
    degrees: List[Int],
    total_edges: Int,
    power_iters: Int
) -> ModularityPartitionResult {
    let mut s: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        s = list_push(s, if i % 2 == 0 { 1 } else { -1 });
        i = i + 1;
    }

    if total_edges <= 0 {
        return ModularityPartitionResult {
            num_nodes: num_nodes,
            partition: s,
            modularity_q: 0,
        };
    }

    let two_m: Int = 2 * total_edges;
    let mut iter: Int = 0;

    while iter < power_iters {
        let mut next_s: List[Int] = list_new();
        let mut u: Int = 0;
        while u < num_nodes {
            let ku: Int = list_get(degrees, u);
            let mut dot: Int = 0;

            let mut v: Int = 0;
            while v < num_nodes {
                let kv: Int = list_get(degrees, v);
                let a_uv: Int = list_get(adjacency_matrix, u * num_nodes + v);
                let b_uv: Int = (a_uv * two_m) - (ku * kv);
                let sv: Int = list_get(s, v);
                dot = dot + b_uv * sv;
                v = v + 1;
            }

            next_s = list_push(next_s, if dot >= 0 { 1 } else { -1 });
            u = u + 1;
        }
        s = next_s;
        iter = iter + 1;
    }

    let q_score: Int = modularity_eval_q(num_nodes, adjacency_matrix, degrees, total_edges, s);

    return ModularityPartitionResult {
        num_nodes: num_nodes,
        partition: s,
        modularity_q: q_score,
    };
}
