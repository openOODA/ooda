// # Optimized Link State Routing (OLSR) Multipoint Relays
//
// Logline: Implements OLSR Multipoint Relay (MPR) greedy selection to minimize broadcast packet flooding redundancy.
//
// Setup: Proactive link-state mesh routing algorithm selecting minimal 1-hop subset covering all 2-hop symmetric neighbors.
//
// Beats:
//   1. Build 1-hop and 2-hop strict symmetric neighbor connectivity tables.
//   2. Identify isolated 2-hop nodes requiring mandatory 1-hop MPR designations.
//   3. Greedily select maximum-coverage 1-hop neighbors until all 2-hop targets are spanned.

pub type OlsrNodeNeighbor = struct {
    node_id: Int,
    is_mpr: Bool,
    two_hop_neighbors: List[Int],
};

pub type MprSelectionResult = struct {
    local_id: Int,
    mpr_nodes: List[Int],
    covered_2hop_nodes: List[Int],
};

pub fn olsr_contains(lst: List[Int], val: Int) -> Bool {
    let n: Int = list_len(lst);
    let mut i: Int = 0;
    while i < n {
        if list_get(lst, i) == val {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn olsr_select_mpr_set(
    local_id: Int,
    one_hop_neighbors: List[Int],
    two_hop_neighbors_per_1hop: List[List[Int]], // 2-hop nbrs reachable through each 1-hop
    all_target_2hop: List[Int]
) -> MprSelectionResult {
    let mut mpr_set: List[Int] = list_new();
    let mut covered_2hop: List[Int] = list_new();

    let n_1hop: Int = list_len(one_hop_neighbors);
    let n_2hop: Int = list_len(all_target_2hop);

    // 1. Mandatory MPRs: 2-hop nodes covered by exactly one 1-hop neighbor
    let mut t: Int = 0;
    while t < n_2hop {
        let target: Int = list_get(all_target_2hop, t);
        let mut cover_count: Int = 0;
        let mut sole_cover_1hop: Int = -1;

        let mut i: Int = 0;
        while i < n_1hop {
            let nbr_1hop: Int = list_get(one_hop_neighbors, i);
            let nbr_2hops: List[Int] = list_get(two_hop_neighbors_per_1hop, i);
            if olsr_contains(nbr_2hops, target) {
                cover_count = cover_count + 1;
                sole_cover_1hop = nbr_1hop;
            }
            i = i + 1;
        }

        if cover_count == 1 {
            if !olsr_contains(mpr_set, sole_cover_1hop) {
                mpr_set = list_push(mpr_set, sole_cover_1hop);
            }
            if !olsr_contains(covered_2hop, target) {
                covered_2hop = list_push(covered_2hop, target);
            }
        }
        t = t + 1;
    }

    // 2. Greedy selection for remaining uncovered 2-hop nodes
    while list_len(covered_2hop) < n_2hop {
        let mut best_1hop: Int = -1;
        let mut max_new_covers: Int = 0;

        let mut i: Int = 0;
        while i < n_1hop {
            let nbr_1hop: Int = list_get(one_hop_neighbors, i);
            if !olsr_contains(mpr_set, nbr_1hop) {
                let nbr_2hops: List[Int] = list_get(two_hop_neighbors_per_1hop, i);
                let mut new_covers: Int = 0;

                let mut j: Int = 0;
                let len_2h: Int = list_len(nbr_2hops);
                while j < len_2h {
                    let cand_2h: Int = list_get(nbr_2hops, j);
                    if olsr_contains(all_target_2hop, cand_2h) && !olsr_contains(covered_2hop, cand_2h) {
                        new_covers = new_covers + 1;
                    }
                    j = j + 1;
                }

                if new_covers > max_new_covers {
                    max_new_covers = new_covers;
                    best_1hop = nbr_1hop;
                }
            }
            i = i + 1;
        }

        if max_new_covers == 0 || best_1hop < 0 {
            // Cannot cover more
            return MprSelectionResult {
                local_id: local_id,
                mpr_nodes: mpr_set,
                covered_2hop_nodes: covered_2hop,
            };
        }

        mpr_set = list_push(mpr_set, best_1hop);

        // Mark 2-hop nodes newly covered
        let mut idx_1h: Int = 0;
        while idx_1h < n_1hop {
            if list_get(one_hop_neighbors, idx_1h) == best_1hop {
                let nbr_2hops: List[Int] = list_get(two_hop_neighbors_per_1hop, idx_1h);
                let mut k: Int = 0;
                let l_2h: Int = list_len(nbr_2hops);
                while k < l_2h {
                    let c2: Int = list_get(nbr_2hops, k);
                    if !olsr_contains(covered_2hop, c2) {
                        covered_2hop = list_push(covered_2hop, c2);
                    }
                    k = k + 1;
                }
            }
            idx_1h = idx_1h + 1;
        }
    }

    return MprSelectionResult {
        local_id: local_id,
        mpr_nodes: mpr_set,
        covered_2hop_nodes: covered_2hop,
    };
}
