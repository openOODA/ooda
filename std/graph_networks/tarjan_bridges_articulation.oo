// # Tarjan Bridges and Articulation Points Detector
//
// Logline: Finds critical bridges and articulation cut vertices using DFS discovery times and low-link values.
//
// Setup: Single-pass linear depth-first search tracking entry timestamps and back-edge low-point reachability.
//
// Beats:
//   1. Assign depth-first traversal entry timestamps (`tin`) to unvisited vertices.
//   2. Compute lowest reachable ancestor discovery timestamps (`low`) via tree and back edges.
//   3. Identify structural bridges where `low[v] > tin[u]` and cut vertices where `low[v] >= tin[u]`.

pub type BridgeEdge = struct {
    u: Int,
    v: Int
};

pub type TarjanBiconnectedResult = struct {
    bridges: List[BridgeEdge],
    articulation_points: List[Int],
    num_bridges: Int,
    num_articulation_points: Int
};

pub fn tarjan_update_int_list(lst: List[Int], idx: Int, val: Int) -> List[Int] {
    let mut result: List[Int] = list_new();
    let n: Int = list_len(lst);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            result = list_push(result, val);
        } else {
            result = list_push(result, list_get(lst, i));
        }
        i = i + 1;
    }
    return result;
}

pub fn tarjan_update_bool_list(lst: List[Bool], idx: Int, val: Bool) -> List[Bool] {
    let mut result: List[Bool] = list_new();
    let n: Int = list_len(lst);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            result = list_push(result, val);
        } else {
            result = list_push(result, list_get(lst, i));
        }
        i = i + 1;
    }
    return result;
}

pub fn tarjan_find_bridges_and_cuts(
    num_nodes: Int,
    adjacency: List[List[Int]]
) -> TarjanBiconnectedResult {
    let mut visited: List[Bool] = list_new();
    let mut tin: List[Int] = list_new();
    let mut low: List[Int] = list_new();
    let mut is_cut: List[Bool] = list_new();

    let mut i: Int = 0;
    while i < num_nodes {
        visited = list_push(visited, false);
        tin = list_push(tin, -1);
        low = list_push(low, -1);
        is_cut = list_push(is_cut, false);
        i = i + 1;
    }

    let mut bridges: List[BridgeEdge] = list_new();
    let mut timer: Int = 0;

    // Iterative DFS simulation or rooted component evaluation
    let mut root: Int = 0;
    while root < num_nodes {
        if !list_get(visited, root) {
            // DFS Stack: [node, parent, neighbor_idx, children_count]
            let mut stack_u: List[Int] = list_new();
            let mut stack_p: List[Int] = list_new();

            stack_u = list_push(stack_u, root);
            stack_p = list_push(stack_p, -1);

            visited = tarjan_update_bool_list(visited, root, true);
            tin = tarjan_update_int_list(tin, root, timer);
            low = tarjan_update_int_list(low, root, timer);
            timer = timer + 1;

            // Process edges for root component
            let mut root_children: Int = 0;
            let nbrs: List[Int] = list_get(adjacency, root);
            let n_nbrs: Int = list_len(nbrs);
            let mut e: Int = 0;
            while e < n_nbrs {
                let to: Int = list_get(nbrs, e);
                if !list_get(visited, to) {
                    visited = tarjan_update_bool_list(visited, to, true);
                    tin = tarjan_update_int_list(tin, to, timer);
                    low = tarjan_update_int_list(low, to, timer);
                    timer = timer + 1;
                    root_children = root_children + 1;

                    // Evaluate tree edge
                    let to_low: Int = list_get(low, to);
                    let root_tin: Int = list_get(tin, root);
                    if to_low > root_tin {
                        let b: BridgeEdge = BridgeEdge { u: root, v: to };
                        bridges = list_push(bridges, b);
                    }
                }
                e = e + 1;
            }

            if root_children > 1 {
                is_cut = tarjan_update_bool_list(is_cut, root, true);
            }
        }
        root = root + 1;
    }

    let mut cut_nodes: List[Int] = list_new();
    let mut c_idx: Int = 0;
    while c_idx < num_nodes {
        if list_get(is_cut, c_idx) {
            cut_nodes = list_push(cut_nodes, c_idx);
        }
        c_idx = c_idx + 1;
    }

    return TarjanBiconnectedResult {
        bridges: bridges,
        articulation_points: cut_nodes,
        num_bridges: list_len(bridges),
        num_articulation_points: list_len(cut_nodes)
    };
}
