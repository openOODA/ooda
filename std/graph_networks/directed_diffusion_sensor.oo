// # Directed Diffusion Sensor Network Routing
//
// Logline: Implements data-centric Directed Diffusion routing using task interest propagation and gradient reinforcement.
//
// Setup: Wireless sensor network dissemination framework establishing directional event gradients and low-latency path reinforcement.
//
// Beats:
//   1. Disseminate task Interest messages naming sensed attribute types and required data reporting rates.
//   2. Establish directional data Gradients pointing back to requesting sink nodes.
//   3. Empirically Reinforce optimal low-latency event delivery paths with high data rates.

pub type DiffusionInterest = struct {
    interest_id: Int,
    target_attribute_type: Int,
    data_rate_interval_ms: Int,
    sink_id: Int,
    expires_at_ms: Int
};

pub type DiffusionGradient = struct {
    interest_id: Int,
    neighbor_id: Int,
    data_rate_interval_ms: Int,
    is_reinforced: Bool
};

pub type DiffusionSensorNode = struct {
    local_id: Int,
    sensed_attributes: List[Int],
    active_interests: List[DiffusionInterest],
    active_gradients: List[DiffusionGradient]
};

pub fn diffusion_create(local_id: Int, attributes: List[Int]) -> DiffusionSensorNode {
    let empty_i: List[DiffusionInterest] = list_new();
    let empty_g: List[DiffusionGradient] = list_new();
    return DiffusionSensorNode {
        local_id: local_id,
        sensed_attributes: attributes,
        active_interests: empty_i,
        active_gradients: empty_g
    };
}

pub fn diffusion_has_attribute(node: &DiffusionSensorNode, attr: Int) -> Bool {
    let n: Int = list_len((node).sensed_attributes);
    let mut i: Int = 0;
    while i < n {
        if list_get((node).sensed_attributes, i) == attr {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn diffusion_process_interest(
    node: &mut DiffusionSensorNode,
    interest: &DiffusionInterest,
    from_neighbor: Int
) -> Bool {
    // 1. Store or update interest
    let mut found_interest: Bool = false;
    let n_i: Int = list_len((node).active_interests);
    let mut i: Int = 0;
    while i < n_i && !found_interest {
        let cur_i: DiffusionInterest = list_get((node).active_interests, i);
        if (cur_i).interest_id == (interest).interest_id {
            found_interest = true;
        }
        i = i + 1;
    }

    if !found_interest {
        (node).active_interests = list_push((node).active_interests, *interest);
    }

    // 2. Setup/update gradient pointing to from_neighbor
    let grad: DiffusionGradient = DiffusionGradient {
        interest_id: (interest).interest_id,
        neighbor_id: from_neighbor,
        data_rate_interval_ms: (interest).data_rate_interval_ms,
        is_reinforced: false
    };

    let mut found_g: Bool = false;
    let n_g: Int = list_len((node).active_gradients);
    let mut j: Int = 0;
    while j < n_g && !found_g {
        let cur_g: DiffusionGradient = list_get((node).active_gradients, j);
        if (cur_g).interest_id == (interest).interest_id && (cur_g).neighbor_id == from_neighbor {
            found_g = true;
        }
        j = j + 1;
    }

    if !found_g {
        (node).active_gradients = list_push((node).active_gradients, grad);
    }

    return true;
}

pub fn diffusion_reinforce_gradient(
    node: &mut DiffusionSensorNode,
    interest_id: Int,
    preferred_neighbor: Int,
    high_data_rate_ms: Int
) -> Bool {
    let n_g: Int = list_len((node).active_gradients);
    let mut updated: List[DiffusionGradient] = list_new();
    let mut changed: Bool = false;

    let mut i: Int = 0;
    while i < n_g {
        let g: DiffusionGradient = list_get((node).active_gradients, i);
        if (g).interest_id == interest_id && (g).neighbor_id == preferred_neighbor {
            let reinf: DiffusionGradient = DiffusionGradient {
                interest_id: (g).interest_id,
                neighbor_id: (g).neighbor_id,
                data_rate_interval_ms: high_data_rate_ms,
                is_reinforced: true
            };
            updated = list_push(updated, reinf);
            changed = true;
        } else {
            updated = list_push(updated, g);
        }
        i = i + 1;
    }

    (node).active_gradients = updated;
    return changed;
}
