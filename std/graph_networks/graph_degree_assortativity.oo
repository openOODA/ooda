// # Graph Degree Assortativity & Mixing Coefficient
//
// Logline: Computes Newman's degree assortativity coefficient measuring degree correlation across connected network edges.
//
// Setup: Pearson correlation coefficient calculator measuring tendency of high-degree hubs to connect to other hubs (assortative) vs leaves (disassortative).
//
// Beats:
//   1. Compute degree vectors `k_u` and `k_v` for all network edge endpoints.
//   2. Calculate joint degree cross-moments, mean degree expectations, and degree variances.
//   3. Derive normalized Pearson assortativity `r` in [-1.0, +1.0] scaled representation.

pub type AssortativityResult = struct {
    num_edges: Int,
    assortativity_coeff: Int, // Scaled by 10000 (-10000 to +10000)
    is_assortative: Bool
};

pub fn assortativity_compute(
    num_nodes: Int,
    edges_u: List[Int],
    edges_v: List[Int]
) -> AssortativityResult {
    let m: Int = list_len(edges_u);
    if m == 0 {
        return AssortativityResult {
            num_edges: 0,
            assortativity_coeff: 0,
            is_assortative: false
        };
    }

    // 1. Compute degrees
    let mut degs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        degs = list_push(degs, 0);
        i = i + 1;
    }

    let mut e: Int = 0;
    while e < m {
        let u: Int = list_get(edges_u, e);
        let v: Int = list_get(edges_v, e);

        let mut updated_degs: List[Int] = list_new();
        let mut n_idx: Int = 0;
        while n_idx < num_nodes {
            let cur_d: Int = list_get(degs, n_idx);
            let mut delta: Int = 0;
            if n_idx == u { delta = delta + 1; }
            if n_idx == v { delta = delta + 1; }
            updated_degs = list_push(updated_degs, cur_d + delta);
            n_idx = n_idx + 1;
        }
        degs = updated_degs;
        e = e + 1;
    }

    // 2. Compute cross moments across undirected edges (counted twice as (u,v) and (v,u))
    let mut sum_prod: Int = 0;
    let mut sum_deg: Int = 0;
    let mut sum_sq: Int = 0;

    e = 0;
    while e < m {
        let u: Int = list_get(edges_u, e);
        let v: Int = list_get(edges_v, e);
        let ku: Int = list_get(degs, u);
        let kv: Int = list_get(degs, v);

        // Forward + backward
        sum_prod = sum_prod + 2 * (ku * kv);
        sum_deg = sum_deg + (ku + kv);
        sum_sq = sum_sq + (ku * ku + kv * kv);
        e = e + 1;
    }

    let total_ends: Int = 2 * m;
    let numerator: Int = (total_ends * sum_prod) - (sum_deg * sum_deg);
    let denominator: Int = (total_ends * sum_sq) - (sum_deg * sum_deg);

    let r_scaled: Int = if denominator != 0 {
        (numerator * 10000) / denominator
    } else {
        0
    };

    return AssortativityResult {
        num_edges: m,
        assortativity_coeff: r_scaled,
        is_assortative: r_scaled > 0
    };
}
