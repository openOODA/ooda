// # CAN (Content Addressable Network) Cartesian Torus DHT
//
// Logline: Implements Content Addressable Network (CAN) d-dimensional Cartesian space zone routing and coordinate splitting.
//
// Setup: Multi-dimensional geometric DHT overlay partitioning continuous [0, 1)^d torus coordinate space into hyper-rectangular zones.
//
// Beats:
//   1. Define d-dimensional bounding box coordinate zones [x_min, x_max] x [y_min, y_max].
//   2. Route queries along straight-line greedy coordinate paths to adjacent zone neighbors.
//   3. Bisect and split coordinate zones dynamically upon new peer join operations.

pub type CanZone2D = struct {
    x_min: Int, // Coordinates scaled by 10000 (0..10000)
    x_max: Int,
    y_min: Int,
    y_max: Int,
};

pub type CanNeighborZone = struct {
    node_id: Int,
    zone: CanZone2D,
};

pub type CanNode = struct {
    node_id: Int,
    my_zone: CanZone2D,
    neighbors: List[CanNeighborZone],
};

pub fn can_node_create(node_id: Int, zone: CanZone2D) -> CanNode {
    let empty: List[CanNeighborZone] = list_new();
    return CanNode {
        node_id: node_id,
        my_zone: zone,
        neighbors: empty,
    };
}

pub fn can_zone_contains(zone: &CanZone2D, px: Int, py: Int) -> Bool {
    return px >= (zone).x_min && px < (zone).x_max && py >= (zone).y_min && py < (zone).y_max;
}

pub fn can_zone_center_dist_sq(zone: &CanZone2D, px: Int, py: Int) -> Int {
    let cx: Int = ((zone).x_min + (zone).x_max) / 2;
    let cy: Int = ((zone).y_min + (zone).y_max) / 2;
    let dx: Int = cx - px;
    let dy: Int = cy - py;
    return dx * dx + dy * dy;
}

pub fn can_add_neighbor(node: &mut CanNode, nbr_id: Int, zone: CanZone2D) -> Bool {
    let entry: CanNeighborZone = CanNeighborZone {
        node_id: nbr_id,
        zone: zone,
    };
    (node).neighbors = list_push((node).neighbors, entry);
    return true;
}

pub fn can_route_point(node: &CanNode, px: Int, py: Int) -> Int {
    // 1. Check if local zone owns the point
    if can_zone_contains(&(node).my_zone, px, py) {
        return (node).node_id;
    }

    // 2. Greedy forwarding: find neighbor whose zone center is closest to (px, py)
    let cur_dist: Int = can_zone_center_dist_sq(&(node).my_zone, px, py);
    let mut best_dist: Int = cur_dist;
    let mut best_next_hop: Int = (node).node_id;

    let n: Int = list_len((node).neighbors);
    let mut i: Int = 0;
    while i < n {
        let nbr: CanNeighborZone = list_get((node).neighbors, i);
        let d: Int = can_zone_center_dist_sq(&(nbr).zone, px, py);
        if d < best_dist {
            best_dist = d;
            best_next_hop = (nbr).node_id;
        }
        i = i + 1;
    }

    return best_next_hop;
}

pub fn can_split_x(zone: &CanZone2D) -> List[CanZone2D] {
    let mid_x: Int = ((zone).x_min + (zone).x_max) / 2;
    let left: CanZone2D = CanZone2D {
        x_min: (zone).x_min,
        x_max: mid_x,
        y_min: (zone).y_min,
        y_max: (zone).y_max,
    };
    let right: CanZone2D = CanZone2D {
        x_min: mid_x,
        x_max: (zone).x_max,
        y_min: (zone).y_min,
        y_max: (zone).y_max,
    };
    let mut res: List[CanZone2D] = list_new();
    res = list_push(res, left);
    res = list_push(res, right);
    return res;
}
