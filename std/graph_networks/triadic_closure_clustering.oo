// # Triadic Closure and Network Transitivity Metrics
//
// Logline: Computes local clustering coefficients, closed triangle counts, and global network transitivity.
//
// Setup: Metric calculation suite analyzing 3-cliques and open vs closed connected node triplets.
//
// Beats:
//   1. Count closed triangles and 2-path open wedges across graph neighbor pairs.
//   2. Compute individual local clustering coefficients C_i with high precision scaling.
//   3. Calculate overall graph transitivity T = 3 * Triangles / Connected Triplets.

pub type ClusteringStats = struct {
    num_nodes: Int,
    total_triangles: Int,
    total_triplets: Int,
    global_transitivity: Int, // Scaled 0..10000
    avg_local_clustering: Int // Scaled 0..10000
};

pub fn triadic_has_neighbor(nbrs: List[Int], target: Int) -> Bool {
    let n: Int = list_len(nbrs);
    let mut i: Int = 0;
    while i < n {
        if list_get(nbrs, i) == target {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn triadic_compute_stats(num_nodes: Int, adjacency: List[List[Int]]) -> ClusteringStats {
    let mut total_triangles: Int = 0;
    let mut total_triplets: Int = 0;
    let mut sum_local_c: Int = 0;

    let mut u: Int = 0;
    while u < num_nodes {
        let nbrs_u: List[Int] = list_get(adjacency, u);
        let deg_u: Int = list_len(nbrs_u);

        if deg_u >= 2 {
            let possible_u: Int = (deg_u * (deg_u - 1)) / 2;
            total_triplets = total_triplets + possible_u;

            let mut triangles_u: Int = 0;
            let mut i: Int = 0;
            while i < deg_u {
                let v: Int = list_get(nbrs_u, i);
                let nbrs_v: List[Int] = list_get(adjacency, v);

                let mut j: Int = i + 1;
                while j < deg_u {
                    let w: Int = list_get(nbrs_u, j);
                    if triadic_has_neighbor(nbrs_v, w) {
                        triangles_u = triangles_u + 1;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }

            total_triangles = total_triangles + triangles_u;
            let local_c: Int = (triangles_u * 10000) / possible_u;
            sum_local_c = sum_local_c + local_c;
        }
        u = u + 1;
    }

    // Since each triangle is counted 3 times across u, v, w:
    let exact_triangles: Int = total_triangles / 3;

    let transitivity: Int = if total_triplets > 0 {
        (exact_triangles * 3 * 10000) / total_triplets
    } else {
        0
    };

    let avg_local: Int = if num_nodes > 0 {
        sum_local_c / num_nodes
    } else {
        0
    };

    return ClusteringStats {
        num_nodes: num_nodes,
        total_triangles: exact_triangles,
        total_triplets: total_triplets,
        global_transitivity: transitivity,
        avg_local_clustering: avg_local
    };
}
