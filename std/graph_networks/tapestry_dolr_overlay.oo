// # Tapestry Decentralized Object Location and Routing (DOLR)
//
// Logline: Implements Tapestry prefix-based mesh routing and decentralized object location mappings.
//
// Setup: Prefix-matching overlay network architecture resolving objects and routing messages to nearest surrogate nodes.
//
// Beats:
//   1. Implement suffix/prefix neighbor routing tables indexed by digit level and radix.
//   2. Route object publications and queries toward unique canonical root identifiers.
//   3. Cache location pointers at intermediate nodes along publication paths to optimize local query latency.

pub type TapestryObjectPointer = struct {
    object_id: Int,
    server_node_id: Int,
    distance_rtt_ms: Int,
};

pub type TapestryNode = struct {
    node_id: Int,
    radix_base: Int, // e.g. 16
    digits: Int,
    routing_table: List[Int], // Level x Radix neighbor table
    object_pointers: List[TapestryObjectPointer],
};

pub fn tapestry_create(node_id: Int, digits: Int, radix: Int) -> TapestryNode {
    let total_cells: Int = digits * radix;
    let mut table: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total_cells {
        table = list_push(table, -1);
        i = i + 1;
    }
    let empty_ptrs: List[TapestryObjectPointer] = list_new();

    return TapestryNode {
        node_id: node_id,
        radix_base: radix,
        digits: digits,
        routing_table: table,
        object_pointers: empty_ptrs,
    };
}

pub fn tapestry_get_digit_at_level(id: Int, level: Int, radix: Int) -> Int {
    let mut temp: Int = id;
    let mut i: Int = 0;
    while i < level {
        temp = temp / radix;
        i = i + 1;
    }
    return temp % radix;
}

pub fn tapestry_publish_object(
    node: &mut TapestryNode,
    obj_id: Int,
    server_id: Int,
    rtt_ms: Int
) -> Bool {
    let ptr: TapestryObjectPointer = TapestryObjectPointer {
        object_id: obj_id,
        server_node_id: server_id,
        distance_rtt_ms: rtt_ms,
    };
    (node).object_pointers = list_push((node).object_pointers, ptr);
    return true;
}

pub fn tapestry_find_cached_object(node: &TapestryNode, obj_id: Int) -> Int {
    let n: Int = list_len((node).object_pointers);
    let mut best_server: Int = -1;
    let mut min_rtt: Int = 2147483647;

    let mut i: Int = 0;
    while i < n {
        let p: TapestryObjectPointer = list_get((node).object_pointers, i);
        if (p).object_id == obj_id {
            if (p).distance_rtt_ms < min_rtt {
                min_rtt = (p).distance_rtt_ms;
                best_server = (p).server_node_id;
            }
        }
        i = i + 1;
    }
    return best_server;
}

pub fn tapestry_route_next_hop(node: &TapestryNode, dest_guid: Int, cur_level: Int) -> Int {
    if dest_guid == (node).node_id {
        return (node).node_id;
    }

    if cur_level >= (node).digits {
        return (node).node_id;
    }

    let digit: Int = tapestry_get_digit_at_level(dest_guid, cur_level, (node).radix_base);
    let cell_idx: Int = cur_level * (node).radix_base + digit;
    let next_hop: Int = list_get((node).routing_table, cell_idx);

    if next_hop >= 0 {
        return next_hop;
    }

    return (node).node_id;
}
