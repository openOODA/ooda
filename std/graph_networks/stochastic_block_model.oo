// # Stochastic Block Model (SBM) Graph Generator
//
// Logline: Generates community-structured graphs and computes SBM log-likelihood over block connection matrices.
//
// Setup: Generative statistical model assigning vertices to K blocks with affinity probability matrix P_rs.
//
// Beats:
//   1. Partition vertex sets into discrete block assignments.
//   2. Sample inter-block and intra-block edge connections based on affinity matrix P.
//   3. Compute fit log-likelihood for community partition hypotheses.

pub type SbmEdge = struct {
    u: Int,
    v: Int,
};

pub type SbmGraph = struct {
    num_nodes: Int,
    num_blocks: Int,
    block_assignments: List[Int],
    affinity_matrix: List[Int], // K x K matrix of connection probabilities (0..100)
    edges: List[SbmEdge],
};

pub fn sbm_create(num_nodes: Int, num_blocks: Int, assignments: List[Int], affinity: List[Int]) -> SbmGraph {
    let empty: List[SbmEdge] = list_new();
    return SbmGraph {
        num_nodes: num_nodes,
        num_blocks: num_blocks,
        block_assignments: assignments,
        affinity_matrix: affinity,
        edges: empty,
    };
}

pub fn sbm_generate(sbm: &mut SbmGraph, seed: Int) -> Bool {
    let n: Int = (sbm).num_nodes;
    let k: Int = (sbm).num_blocks;
    let mut edge_list: List[SbmEdge] = list_new();

    let mut u: Int = 0;
    while u < n {
        let block_u: Int = list_get((sbm).block_assignments, u);
        let mut v: Int = u + 1;
        while v < n {
            let block_v: Int = list_get((sbm).block_assignments, v);
            let aff_idx: Int = block_u * k + block_v;
            let prob_pct: Int = list_get((sbm).affinity_matrix, aff_idx);

            let roll: Int = (u * 31337 + v * 10007 + seed * 7919) % 100;
            if roll < prob_pct {
                let e: SbmEdge = SbmEdge { u: u, v: v };
                edge_list = list_push(edge_list, e);
            }
            v = v + 1;
        }
        u = u + 1;
    }

    (sbm).edges = edge_list;
    return true;
}

pub fn sbm_has_edge(edges: List[SbmEdge], u: Int, v: Int) -> Bool {
    let n: Int = list_len(edges);
    let mut i: Int = 0;
    while i < n {
        let e: SbmEdge = list_get(edges, i);
        if ((e).u == u && (e).v == v) || ((e).u == v && (e).v == u) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn sbm_evaluate_fit_score(sbm: &SbmGraph) -> Int {
    let n: Int = (sbm).num_nodes;
    let k: Int = (sbm).num_blocks;
    let mut score: Int = 0;

    let mut u: Int = 0;
    while u < n {
        let bu: Int = list_get((sbm).block_assignments, u);
        let mut v: Int = u + 1;
        while v < n {
            let bv: Int = list_get((sbm).block_assignments, v);
            let aff_idx: Int = bu * k + bv;
            let expected_pct: Int = list_get((sbm).affinity_matrix, aff_idx);
            let connected: Bool = sbm_has_edge((sbm).edges, u, v);

            if connected {
                score = score + expected_pct;
            } else {
                score = score + (100 - expected_pct);
            }
            v = v + 1;
        }
        u = u + 1;
    }
    return score;
}
