// # Barabási-Albert Scale-Free Preferential Attachment
//
// Logline: Generates scale-free power-law graphs via cumulative degree proportional preferential attachment.
//
// Setup: Generative network model expanding node sets with m new links attached preferentially to high-degree hubs.
//
// Beats:
//   1. Seed initial m0-clique core network topology.
//   2. Sample existing target attachment nodes proportional to vertex degree degrees.
//   3. Form scale-free topologies with characteristic power-law degree exponents (gamma ~ 3).

pub type BaEdge = struct {
    u: Int,
    v: Int
};

pub type BarabasiAlbertGraph = struct {
    num_nodes: Int,
    m_links_per_step: Int,
    edges: List[BaEdge],
    node_degrees: List[Int],
    repeated_nodes: List[Int] // Flat array of nodes repeated degree times for O(1) sampling
};

pub fn ba_create(m0: Int, m_per_step: Int) -> BarabasiAlbertGraph {
    let mut initial_edges: List[BaEdge] = list_new();
    let mut degs: List[Int] = list_new();
    let mut repeated: List[Int] = list_new();

    let mut i: Int = 0;
    while i < m0 {
        degs = list_push(degs, m0 - 1);
        let mut j: Int = i + 1;
        while j < m0 {
            let e: BaEdge = BaEdge { u: i, v: j };
            initial_edges = list_push(initial_edges, e);
            repeated = list_push(repeated, i);
            repeated = list_push(repeated, j);
            j = j + 1;
        }
        i = i + 1;
    }

    return BarabasiAlbertGraph {
        num_nodes: m0,
        m_links_per_step: m_per_step,
        edges: initial_edges,
        node_degrees: degs,
        repeated_nodes: repeated
    };
}

pub fn ba_update_degree(degs: List[Int], target_node: Int, delta: Int) -> List[Int] {
    let mut next_degs: List[Int] = list_new();
    let n: Int = list_len(degs);
    let mut i: Int = 0;
    while i < n {
        if i == target_node {
            next_degs = list_push(next_degs, list_get(degs, i) + delta);
        } else {
            next_degs = list_push(next_degs, list_get(degs, i));
        }
        i = i + 1;
    }
    return next_degs;
}

pub fn ba_add_node(ba: &mut BarabasiAlbertGraph, seed: Int) -> Int {
    let new_id: Int = (ba).num_nodes;
    let m: Int = (ba).m_links_per_step;
    let pool_len: Int = list_len((ba).repeated_nodes);

    if pool_len == 0 {
        return new_id;
    }

    let mut targets: List[Int] = list_new();
    let mut step: Int = 0;
    while step < m {
        let sample_idx: Int = (step * 31337 + seed * 10007 + 7919) % pool_len;
        let chosen: Int = list_get((ba).repeated_nodes, sample_idx);

        // Avoid duplicate links
        let mut already_linked: Bool = false;
        let mut t_idx: Int = 0;
        let num_targets: Int = list_len(targets);
        while t_idx < num_targets {
            if list_get(targets, t_idx) == chosen {
                already_linked = true;
            }
            t_idx = t_idx + 1;
        }

        if !already_linked {
            targets = list_push(targets, chosen);
        }
        step = step + 1;
    }

    // Attach edges
    let num_chosen: Int = list_len(targets);
    (ba).node_degrees = list_push((ba).node_degrees, num_chosen);

    let mut i: Int = 0;
    while i < num_chosen {
        let target_v: Int = list_get(targets, i);
        let e: BaEdge = BaEdge { u: new_id, v: target_v };
        (ba).edges = list_push((ba).edges, e);
        (ba).repeated_nodes = list_push((ba).repeated_nodes, new_id);
        (ba).repeated_nodes = list_push((ba).repeated_nodes, target_v);
        (ba).node_degrees = ba_update_degree((ba).node_degrees, target_v, 1);
        i = i + 1;
    }

    (ba).num_nodes = (ba).num_nodes + 1;
    return new_id;
}
