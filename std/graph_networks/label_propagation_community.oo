// # Label Propagation Community Detection (LPA)
//
// Logline: Detects community structures in near-linear time using iterative local majority label voting.
//
// Setup: Scalable clustering engine updating vertex community labels according to maximum neighbor label frequencies.
//
// Beats:
//   1. Assign unique initial label identifiers to each network vertex.
//   2. Propagate dominant consensus labels across neighbor sets in randomized visit order.
//   3. Converge rapidly to modular community partitions without predefined cluster counts.

pub type LpaResult = struct {
    num_nodes: Int,
    labels: List[Int],
    iterations: Int,
    is_converged: Bool,
};

pub fn lpa_update_label(labels: List[Int], idx: Int, new_lbl: Int) -> List[Int] {
    let mut next_list: List[Int] = list_new();
    let n: Int = list_len(labels);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            next_list = list_push(next_list, new_lbl);
        } else {
            next_list = list_push(next_list, list_get(labels, i));
        }
        i = i + 1;
    }
    return next_list;
}

pub fn lpa_find_majority_label(labels: List[Int], nbrs: List[Int], default_lbl: Int) -> Int {
    let n: Int = list_len(nbrs);
    if n == 0 {
        return default_lbl;
    }

    let mut distinct_lbls: List[Int] = list_new();
    let mut counts: List[Int] = list_new();

    let mut i: Int = 0;
    while i < n {
        let v: Int = list_get(nbrs, i);
        let lbl: Int = list_get(labels, v);

        // Find in distinct
        let num_d: Int = list_len(distinct_lbls);
        let mut found_idx: Int = -1;
        let mut j: Int = 0;
        while j < num_d && found_idx < 0 {
            if list_get(distinct_lbls, j) == lbl {
                found_idx = j;
            }
            j = j + 1;
        }

        if found_idx >= 0 {
            let mut next_c: List[Int] = list_new();
            let mut k: Int = 0;
            while k < num_d {
                if k == found_idx {
                    next_c = list_push(next_c, list_get(counts, k) + 1);
                } else {
                    next_c = list_push(next_c, list_get(counts, k));
                }
                k = k + 1;
            }
            counts = next_c;
        } else {
            distinct_lbls = list_push(distinct_lbls, lbl);
            counts = list_push(counts, 1);
        }
        i = i + 1;
    }

    // Find label with highest count
    let num_d: Int = list_len(distinct_lbls);
    let mut best_lbl: Int = default_lbl;
    let mut max_c: Int = 0;
    let mut k: Int = 0;
    while k < num_d {
        let c: Int = list_get(counts, k);
        if c > max_c {
            max_c = c;
            best_lbl = list_get(distinct_lbls, k);
        }
        k = k + 1;
    }
    return best_lbl;
}

pub fn lpa_detect_communities(
    num_nodes: Int,
    adjacency: List[List[Int]],
    max_iters: Int
) -> LpaResult {
    let mut lbls: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        lbls = list_push(lbls, i);
        i = i + 1;
    }

    let mut iter: Int = 0;
    let mut converged: Bool = false;

    while iter < max_iters && !converged {
        let mut changed: Bool = false;
        let mut u: Int = 0;
        while u < num_nodes {
            let nbrs: List[Int] = list_get(adjacency, u);
            let cur_lbl: Int = list_get(lbls, u);
            let majority_lbl: Int = lpa_find_majority_label(lbls, nbrs, cur_lbl);

            if majority_lbl != cur_lbl {
                lbls = lpa_update_label(lbls, u, majority_lbl);
                changed = true;
            }
            u = u + 1;
        }

        if !changed {
            converged = true;
        }
        iter = iter + 1;
    }

    return LpaResult {
        num_nodes: num_nodes,
        labels: lbls,
        iterations: iter,
        is_converged: converged,
    };
}
