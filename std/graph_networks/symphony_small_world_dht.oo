// # Symphony Randomized Small-World DHT Overlay
//
// Logline: Implements Symphony randomized 1D ring routing with Kleinberg harmonic long-range link distributions.
//
// Setup: Randomized small-world P2P architecture connecting immediate ring neighbors plus k random harmonic shortcuts.
//
// Beats:
//   1. Construct 1D continuous identifier ring [0, 1) with immediate successor/predecessor contacts.
//   2. Establish k long-range shortcut links sampled from harmonic pdf f(x) = 1 / (x * ln(N)).
//   3. Route greedily across short and long contacts achieving O((1/k) log^2 N) average hop counts.

pub type SymphonyLongLink = struct {
    target_node_id: Int,
    target_position: Int, // Scaled 0..10000
};

pub type SymphonyNode = struct {
    node_id: Int,
    position: Int, // Scaled 0..10000 on continuous unit ring
    successor_id: Int,
    successor_pos: Int,
    predecessor_id: Int,
    long_links: List[SymphonyLongLink],
};

pub fn symphony_create_node(node_id: Int, pos: Int) -> SymphonyNode {
    let empty: List[SymphonyLongLink] = list_new();
    return SymphonyNode {
        node_id: node_id,
        position: pos,
        successor_id: node_id,
        successor_pos: pos,
        predecessor_id: node_id,
        long_links: empty,
    };
}

pub fn symphony_forward_distance(from_pos: Int, to_pos: Int) -> Int {
    let scale: Int = 10000;
    if to_pos >= from_pos {
        return to_pos - from_pos;
    }
    return (scale - from_pos) + to_pos;
}

pub fn symphony_add_shortcut(node: &mut SymphonyNode, target_id: Int, target_pos: Int) -> Bool {
    let link: SymphonyLongLink = SymphonyLongLink {
        target_node_id: target_id,
        target_position: target_pos,
    };
    (node).long_links = list_push((node).long_links, link);
    return true;
}

pub fn symphony_greedy_route(node: &SymphonyNode, dest_pos: Int) -> Int {
    let my_pos: Int = (node).position;
    let mut min_dist: Int = symphony_forward_distance(my_pos, dest_pos);
    let mut best_hop: Int = (node).node_id;

    if min_dist == 0 {
        return (node).node_id;
    }

    // 1. Evaluate successor
    let succ_dist: Int = symphony_forward_distance((node).successor_pos, dest_pos);
    if succ_dist < min_dist {
        min_dist = succ_dist;
        best_hop = (node).successor_id;
    }

    // 2. Evaluate all long-range shortcuts
    let n: Int = list_len((node).long_links);
    let mut i: Int = 0;
    while i < n {
        let link: SymphonyLongLink = list_get((node).long_links, i);
        let d: Int = symphony_forward_distance((link).target_position, dest_pos);
        if d < min_dist {
            min_dist = d;
            best_hop = (link).target_node_id;
        }
        i = i + 1;
    }

    return best_hop;
}
