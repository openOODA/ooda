// # Counting Bloom Filter Multi-Hash Array
//
// Logline: Implements Counting Bloom Filters supporting probabilistic membership queries and safe item deletions.
//
// Setup: Multi-bit counter array with k-independent hash functions and saturating 8-bit arithmetic.
//
// Beats:
//   1. Allocate m-element counter array with parameterized k-hash coefficients.
//   2. Increment saturating counters upon item insertion and decrement upon deletion.
//   3. Query zero-counter presence to verify non-membership with zero false negatives.

pub type CountingBloomFilter = struct {
    num_cells: Int,
    num_hashes: Int,
    counters: List[Int],
    item_count: Int,
    max_counter: Int,
};

pub fn cbf_create(num_cells: Int, num_hashes: Int) -> CountingBloomFilter {
    let mut m: Int = num_cells;
    let mut k: Int = num_hashes;
    if m < 8 {
        m = 64;
    }
    if k < 1 {
        k = 4;
    }
    let mut cells: List[Int] = list_new();
    let mut i: Int = 0;
    while i < m {
        cells = list_push(cells, 0);
        i = i + 1;
    }
    return CountingBloomFilter {
        num_cells: m,
        num_hashes: k,
        counters: cells,
        item_count: 0,
        max_counter: 255, // 8-bit saturation
    };
}

pub fn cbf_calc_hash(item: Int, seed: Int, m: Int) -> Int {
    let mut pos_item: Int = item;
    if pos_item < 0 {
        pos_item = 0 - pos_item;
    }
    let h: Int = (pos_item * 31337 + seed * 10007 + 7919) % m;
    if h < 0 {
        return h + m;
    }
    return h;
}

pub fn cbf_modify_counter(counters: List[Int], target_idx: Int, delta: Int, max_val: Int) -> List[Int] {
    let mut next_list: List[Int] = list_new();
    let n: Int = list_len(counters);
    let mut i: Int = 0;
    while i < n {
        if i == target_idx {
            let cur: Int = list_get(counters, i);
            let mut updated: Int = cur + delta;
            if updated < 0 {
                updated = 0;
            }
            if updated > max_val {
                updated = max_val;
            }
            next_list = list_push(next_list, updated);
        } else {
            next_list = list_push(next_list, list_get(counters, i));
        }
        i = i + 1;
    }
    return next_list;
}

pub fn cbf_insert(cbf: &mut CountingBloomFilter, item: Int) -> Bool {
    let k: Int = (cbf).num_hashes;
    let m: Int = (cbf).num_cells;
    let max_v: Int = (cbf).max_counter;
    let mut i: Int = 0;
    while i < k {
        let idx: Int = cbf_calc_hash(item, i, m);
        (cbf).counters = cbf_modify_counter((cbf).counters, idx, 1, max_v);
        i = i + 1;
    }
    (cbf).item_count = (cbf).item_count + 1;
    return true;
}

pub fn cbf_contains(cbf: &CountingBloomFilter, item: Int) -> Bool {
    let k: Int = (cbf).num_hashes;
    let m: Int = (cbf).num_cells;
    let mut i: Int = 0;
    while i < k {
        let idx: Int = cbf_calc_hash(item, i, m);
        let val: Int = list_get((cbf).counters, idx);
        if val == 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn cbf_remove(cbf: &mut CountingBloomFilter, item: Int) -> Bool {
    if !cbf_contains(cbf, item) {
        return false;
    }
    let k: Int = (cbf).num_hashes;
    let m: Int = (cbf).num_cells;
    let max_v: Int = (cbf).max_counter;
    let mut i: Int = 0;
    while i < k {
        let idx: Int = cbf_calc_hash(item, i, m);
        (cbf).counters = cbf_modify_counter((cbf).counters, idx, -1, max_v);
        i = i + 1;
    }
    if (cbf).item_count > 0 {
        (cbf).item_count = (cbf).item_count - 1;
    }
    return true;
}

pub fn cbf_estimate_fill_ratio(cbf: &CountingBloomFilter) -> Int {
    let m: Int = (cbf).num_cells;
    if m == 0 {
        return 0;
    }
    let mut occupied: Int = 0;
    let mut i: Int = 0;
    while i < m {
        if list_get((cbf).counters, i) > 0 {
            occupied = occupied + 1;
        }
        i = i + 1;
    }
    return (occupied * 10000) / m; // Scaled percentage (0 to 10000)
}
