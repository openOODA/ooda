// # Brandes Shortest-Path Betweenness Centrality
//
// Logline: Computes exact vertex betweenness centrality scores in O(VE) time using Brandes' dependency accumulation.
//
// Setup: Exact centrality engine operating on BFS shortest path DAGs and recursive pair-dependency backpropagation.
//
// Beats:
//   1. Perform unweighted BFS traversals from all source vertices tracking path counts (`sigma`).
//   2. Construct shortest-path predecessor acyclic subgraphs and vertex exploration order.
//   3. Accumulate pair-dependencies (`delta`) in reverse topological topological order back to sources.

pub type BrandesResult = struct {
    num_nodes: Int,
    centrality_scores: List[Int], // Scaled integers (e.g. score * 1000)
};

pub fn brandes_update_int(lst: List[Int], idx: Int, val: Int) -> List[Int] {
    let mut result: List[Int] = list_new();
    let n: Int = list_len(lst);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            result = list_push(result, val);
        } else {
            result = list_push(result, list_get(lst, i));
        }
        i = i + 1;
    }
    return result;
}

pub fn brandes_compute(num_nodes: Int, adjacency: List[List[Int]]) -> BrandesResult {
    let mut cb: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        cb = list_push(cb, 0);
        i = i + 1;
    }

    let mut s: Int = 0;
    while s < num_nodes {
        // Stack S
        let mut stack: List[Int] = list_new();
        // sigma (path counts)
        let mut sigma: List[Int] = list_new();
        // d (distances)
        let mut d: List[Int] = list_new();
        // delta (dependencies)
        let mut delta: List[Int] = list_new();

        let mut init_i: Int = 0;
        while init_i < num_nodes {
            sigma = list_push(sigma, if init_i == s { 1 } else { 0 });
            d = list_push(d, if init_i == s { 0 } else { -1 });
            delta = list_push(delta, 0);
            init_i = init_i + 1;
        }

        // BFS Queue Q
        let mut queue: List[Int] = list_new();
        queue = list_push(queue, s);

        let mut q_head: Int = 0;
        while q_head < list_len(queue) {
            let v: Int = list_get(queue, q_head);
            q_head = q_head + 1;
            stack = list_push(stack, v);

            let nbrs: List[Int] = list_get(adjacency, v);
            let n_nbrs: Int = list_len(nbrs);
            let mut j: Int = 0;
            while j < n_nbrs {
                let w: Int = list_get(nbrs, j);
                let d_w: Int = list_get(d, w);
                let d_v: Int = list_get(d, v);

                // w found for the first time?
                if d_w < 0 {
                    d = brandes_update_int(d, w, d_v + 1);
                    queue = list_push(queue, w);
                }

                // shortest path to w via v?
                if list_get(d, w) == (d_v + 1) {
                    let sig_w: Int = list_get(sigma, w);
                    let sig_v: Int = list_get(sigma, v);
                    sigma = brandes_update_int(sigma, w, sig_w + sig_v);
                }
                j = j + 1;
            }
        }

        // Accumulate dependencies delta in reverse order of stack
        let stack_len: Int = list_len(stack);
        let mut st_idx: Int = stack_len - 1;
        while st_idx >= 0 {
            let w: Int = list_get(stack, st_idx);
            let sig_w: Int = list_get(sigma, w);
            let del_w: Int = list_get(delta, w);

            let nbrs_w: List[Int] = list_get(adjacency, w);
            let n_nbrs_w: Int = list_len(nbrs_w);
            let mut k: Int = 0;
            while k < n_nbrs_w {
                let v: Int = list_get(nbrs_w, k);
                if list_get(d, w) == (list_get(d, v) + 1) {
                    let sig_v: Int = list_get(sigma, v);
                    if sig_w > 0 {
                        let term: Int = ((sig_v * 1000) / sig_w) * (1000 + del_w) / 1000;
                        let cur_del_v: Int = list_get(delta, v);
                        delta = brandes_update_int(delta, v, cur_del_v + term);
                    }
                }
                k = k + 1;
            }

            if w != s {
                let cur_cb_w: Int = list_get(cb, w);
                cb = brandes_update_int(cb, w, cur_cb_w + del_w);
            }
            st_idx = st_idx - 1;
        }

        s = s + 1;
    }

    return BrandesResult {
        num_nodes: num_nodes,
        centrality_scores: cb,
    };
}
