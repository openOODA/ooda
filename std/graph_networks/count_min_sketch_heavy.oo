// # Count-Min Sketch Heavy Frequency Estimator
//
// Logline: Implements sub-linear 2D matrix Count-Min Sketch for streaming item frequency estimation.
//
// Setup: Pairwise independent 2-universal hash family matrix mapping stream events to frequency counters.
//
// Beats:
//   1. Construct depth x width counter matrix with randomized linear hash functions.
//   2. Increment hash-indexed counter cells upon observing stream elements.
//   3. Extract minimum counter projection as point-frequency estimator with bounded error.

pub type CountMinSketch = struct {
    depth: Int,
    width: Int,
    counters: List[Int], // Flattened depth * width array
    a_params: List[Int],
    b_params: List[Int],
    total_count: Int,
};

pub fn cms_create(depth: Int, width: Int) -> CountMinSketch {
    let mut d: Int = depth;
    let mut w: Int = width;
    if d < 1 {
        d = 4;
    }
    if w < 1 {
        w = 128;
    }
    let total_cells: Int = d * w;
    let mut grid: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total_cells {
        grid = list_push(grid, 0);
        i = i + 1;
    }

    let mut a: List[Int] = list_new();
    let mut b: List[Int] = list_new();
    let mut row: Int = 0;
    while row < d {
        let a_val: Int = (row * 31337 + 101) % 65535 + 1;
        let b_val: Int = (row * 13337 + 7919) % 65535;
        a = list_push(a, a_val);
        b = list_push(b, b_val);
        row = row + 1;
    }

    return CountMinSketch {
        depth: d,
        width: w,
        counters: grid,
        a_params: a,
        b_params: b,
        total_count: 0,
    };
}

pub fn cms_hash(item: Int, a: Int, b: Int, width: Int) -> Int {
    let prime: Int = 2147483647;
    let mut pos_item: Int = item;
    if pos_item < 0 {
        pos_item = 0 - pos_item;
    }
    let val: Int = (pos_item * a + b) % prime;
    let mut pos_val: Int = val;
    if pos_val < 0 {
        pos_val = 0 - pos_val;
    }
    return pos_val % width;
}

pub fn cms_update_counter(counters: List[Int], idx: Int, delta: Int) -> List[Int] {
    let mut next_list: List[Int] = list_new();
    let n: Int = list_len(counters);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            let cur: Int = list_get(counters, i);
            next_list = list_push(next_list, cur + delta);
        } else {
            next_list = list_push(next_list, list_get(counters, i));
        }
        i = i + 1;
    }
    return next_list;
}

pub fn cms_add(sketch: &mut CountMinSketch, item: Int, count: Int) -> Bool {
    if count <= 0 {
        return false;
    }
    let d: Int = (sketch).depth;
    let w: Int = (sketch).width;
    let mut row: Int = 0;
    while row < d {
        let a: Int = list_get((sketch).a_params, row);
        let b: Int = list_get((sketch).b_params, row);
        let col: Int = cms_hash(item, a, b, w);
        let cell_idx: Int = row * w + col;
        (sketch).counters = cms_update_counter((sketch).counters, cell_idx, count);
        row = row + 1;
    }
    (sketch).total_count = (sketch).total_count + count;
    return true;
}

pub fn cms_estimate(sketch: &CountMinSketch, item: Int) -> Int {
    let d: Int = (sketch).depth;
    let w: Int = (sketch).width;
    let mut min_val: Int = 2147483647;
    let mut row: Int = 0;
    while row < d {
        let a: Int = list_get((sketch).a_params, row);
        let b: Int = list_get((sketch).b_params, row);
        let col: Int = cms_hash(item, a, b, w);
        let cell_idx: Int = row * w + col;
        let c: Int = list_get((sketch).counters, cell_idx);
        if c < min_val {
            min_val = c;
        }
        row = row + 1;
    }
    return min_val;
}

pub fn cms_merge(c1: &CountMinSketch, c2: &CountMinSketch) -> CountMinSketch {
    let d: Int = (c1).depth;
    let w: Int = (c1).width;
    let total_cells: Int = d * w;
    let mut merged: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total_cells {
        let v1: Int = list_get((c1).counters, i);
        let v2: Int = list_get((c2).counters, i);
        merged = list_push(merged, v1 + v2);
        i = i + 1;
    }
    return CountMinSketch {
        depth: d,
        width: w,
        counters: merged,
        a_params: (c1).a_params,
        b_params: (c1).b_params,
        total_count: (c1).total_count + (c2).total_count,
    };
}
