// # Space-Saving Top-K Heavy Hitters Stream Summary
//
// Logline: Implements the deterministic Space-Saving streaming algorithm for Top-K frequent items and heavy hitters.
//
// Setup: Bounded memory stream summary tracking item counts and maximum error bounds with guaranteed recall.
//
// Beats:
//   1. Maintain k fixed capacity counter slots with minimum-value eviction policy.
//   2. Increment existing item counters or evict minimum elements with recorded over-estimation error.
//   3. Extract verified heavy hitters satisfying support threshold criteria.

pub type HeavyHitterEntry = struct {
    item_id: Int,
    count: Int,
    error_bound: Int
};

pub type SpaceSavingSummary = struct {
    k: Int,
    entries: List[HeavyHitterEntry],
    total_stream_items: Int
};

pub fn topk_summary_create(k: Int) -> SpaceSavingSummary {
    let mut capacity: Int = k;
    if capacity < 1 {
        capacity = 10;
    }
    let empty: List[HeavyHitterEntry] = list_new();
    return SpaceSavingSummary {
        k: capacity,
        entries: empty,
        total_stream_items: 0
    };
}

pub fn topk_find_item_index(summary: &SpaceSavingSummary, item: Int) -> Int {
    let n: Int = list_len((summary).entries);
    let mut i: Int = 0;
    while i < n {
        let entry: HeavyHitterEntry = list_get((summary).entries, i);
        if (entry).item_id == item {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn topk_find_min_index(summary: &SpaceSavingSummary) -> Int {
    let n: Int = list_len((summary).entries);
    if n == 0 {
        return -1;
    }
    let mut min_idx: Int = 0;
    let first: HeavyHitterEntry = list_get((summary).entries, 0);
    let mut min_cnt: Int = (first).count;

    let mut i: Int = 1;
    while i < n {
        let entry: HeavyHitterEntry = list_get((summary).entries, i);
        if (entry).count < min_cnt {
            min_cnt = (entry).count;
            min_idx = i;
        }
        i = i + 1;
    }
    return min_idx;
}

pub fn topk_replace_entry(entries: List[HeavyHitterEntry], idx: Int, new_entry: HeavyHitterEntry) -> List[HeavyHitterEntry] {
    let mut result: List[HeavyHitterEntry] = list_new();
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            result = list_push(result, new_entry);
        } else {
            result = list_push(result, list_get(entries, i));
        }
        i = i + 1;
    }
    return result;
}

pub fn topk_process_item(summary: &mut SpaceSavingSummary, item: Int) -> Bool {
    (summary).total_stream_items = (summary).total_stream_items + 1;
    let idx: Int = topk_find_item_index(summary, item);
    if idx >= 0 {
        let cur: HeavyHitterEntry = list_get((summary).entries, idx);
        let updated: HeavyHitterEntry = HeavyHitterEntry {
            item_id: (cur).item_id,
            count: (cur).count + 1,
            error_bound: (cur).error_bound
        };
        (summary).entries = topk_replace_entry((summary).entries, idx, updated);
        return true;
    }

    let cur_len: Int = list_len((summary).entries);
    if cur_len < (summary).k {
        let new_entry: HeavyHitterEntry = HeavyHitterEntry {
            item_id: item,
            count: 1,
            error_bound: 0
        };
        (summary).entries = list_push((summary).entries, new_entry);
        return true;
    }

    // Evict minimum element
    let min_idx: Int = topk_find_min_index(summary);
    let min_entry: HeavyHitterEntry = list_get((summary).entries, min_idx);
    let replaced: HeavyHitterEntry = HeavyHitterEntry {
        item_id: item,
        count: (min_entry).count + 1,
        error_bound: (min_entry).count
    };
    (summary).entries = topk_replace_entry((summary).entries, min_idx, replaced);
    return true;
}

pub fn topk_query_count(summary: &SpaceSavingSummary, item: Int) -> Int {
    let idx: Int = topk_find_item_index(summary, item);
    if idx >= 0 {
        let entry: HeavyHitterEntry = list_get((summary).entries, idx);
        return (entry).count;
    }
    return 0;
}

pub fn topk_get_heavy_hitters(summary: &SpaceSavingSummary, threshold_pct: Int) -> List[HeavyHitterEntry] {
    let total: Int = (summary).total_stream_items;
    let mut results: List[HeavyHitterEntry] = list_new();
    if total == 0 {
        return results;
    }

    let min_required: Int = (total * threshold_pct) / 100;
    let n: Int = list_len((summary).entries);
    let mut i: Int = 0;
    while i < n {
        let entry: HeavyHitterEntry = list_get((summary).entries, i);
        // Guaranteed heavy hitter if count - error >= min_required
        if ((entry).count - (entry).error_bound) >= min_required {
            results = list_push(results, entry);
        }
        i = i + 1;
    }
    return results;
}
