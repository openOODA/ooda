// # Destination-Sequenced Distance-Vector (DSDV) Routing
//
// Logline: Implements proactive Bellman-Ford routing with destination sequence numbers preventing routing loops.
//
// Setup: Proactive distance-vector mesh routing protocol updating routing tables via full dumps and incremental periodic advertisements.
//
// Beats:
//   1. Maintain routing tables with even monotonic sequence numbers generated by destination hosts.
//   2. Accept route updates with higher sequence numbers or equal sequence numbers with lower hop counts.
//   3. Advertise broken link routes with odd sequence numbers and infinity metrics.

pub type DsdvRouteEntry = struct {
    destination: Int,
    next_hop: Int,
    metric_hops: Int,
    seq_number: Int, // Even = valid, Odd = broken link
    install_time_ms: Int
};

pub type DsdvRoutingTable = struct {
    local_id: Int,
    local_seq: Int,
    routes: List[DsdvRouteEntry]
};

pub type DsdvUpdateItem = struct {
    dest_id: Int,
    metric_hops: Int,
    seq_number: Int
};

pub fn dsdv_table_create(local_id: Int) -> DsdvRoutingTable {
    let mut r: List[DsdvRouteEntry] = list_new();
    // Self entry
    let self_entry: DsdvRouteEntry = DsdvRouteEntry {
        destination: local_id,
        next_hop: local_id,
        metric_hops: 0,
        seq_number: 2,
        install_time_ms: 0
    };
    r = list_push(r, self_entry);

    return DsdvRoutingTable {
        local_id: local_id,
        local_seq: 2,
        routes: r
    };
}

pub fn dsdv_find_idx(table: &DsdvRoutingTable, dest: Int) -> Int {
    let n: Int = list_len((table).routes);
    let mut i: Int = 0;
    while i < n {
        let entry: DsdvRouteEntry = list_get((table).routes, i);
        if (entry).destination == dest {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn dsdv_process_update(
    table: &mut DsdvRoutingTable,
    update: &DsdvUpdateItem,
    sender_id: Int,
    cur_time_ms: Int
) -> Bool {
    let dest: Int = (update).dest_id;
    let new_metric: Int = (update).metric_hops + 1;
    let new_seq: Int = (update).seq_number;

    let idx: Int = dsdv_find_idx(table, dest);
    let new_entry: DsdvRouteEntry = DsdvRouteEntry {
        destination: dest,
        next_hop: sender_id,
        metric_hops: new_metric,
        seq_number: new_seq,
        install_time_ms: cur_time_ms
    };

    if idx < 0 {
        (table).routes = list_push((table).routes, new_entry);
        return true;
    }

    let cur: DsdvRouteEntry = list_get((table).routes, idx);
    // DSDV update rule: higher seq num, or same seq num with lower metric
    if (new_seq > (cur).seq_number) || (new_seq == (cur).seq_number && new_metric < (cur).metric_hops) {
        let mut next_routes: List[DsdvRouteEntry] = list_new();
        let n: Int = list_len((table).routes);
        let mut i: Int = 0;
        while i < n {
            if i == idx {
                next_routes = list_push(next_routes, new_entry);
            } else {
                next_routes = list_push(next_routes, list_get((table).routes, i));
            }
            i = i + 1;
        }
        (table).routes = next_routes;
        return true;
    }

    return false;
}

pub fn dsdv_mark_broken_link(table: &mut DsdvRoutingTable, next_hop: Int) -> Bool {
    let n: Int = list_len((table).routes);
    let mut updated: List[DsdvRouteEntry] = list_new();
    let mut changed: Bool = false;

    let mut i: Int = 0;
    while i < n {
        let r: DsdvRouteEntry = list_get((table).routes, i);
        if (r).next_hop == next_hop && (r).destination != (table).local_id {
            // Increment sequence number to make it odd (broken link)
            let odd_seq: Int = if (r).seq_number % 2 == 0 { (r).seq_number + 1 } else { (r).seq_number };
            let broken: DsdvRouteEntry = DsdvRouteEntry {
                destination: (r).destination,
                next_hop: (r).next_hop,
                metric_hops: 9999, // Infinity
                seq_number: odd_seq,
                install_time_ms: (r).install_time_ms
            };
            updated = list_push(updated, broken);
            changed = true;
        } else {
            updated = list_push(updated, r);
        }
        i = i + 1;
    }

    (table).routes = updated;
    return changed;
}
