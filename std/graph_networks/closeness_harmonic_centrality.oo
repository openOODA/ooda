// # Closeness and Harmonic Centrality Analyzer
//
// Logline: Computes classical closeness and disconnected-robust harmonic centrality scores across network graphs.
//
// Setup: Distance-based topological ranking engine summing inverse shortest-path metrics over all reachable vertex pairs.
//
// Beats:
//   1. Execute single-source BFS distance calculations across all graph node sources.
//   2. Compute normalized reciprocal total path distance for connected components (Closeness).
//   3. Sum pairwise inverse shortest paths to safely handle disconnected graph structures (Harmonic).

pub type CentralityVectorResult = struct {
    num_nodes: Int,
    scores: List[Int], // Scaled integers (score * 10000)
};

pub fn centrality_bfs_distances(start_node: Int, num_nodes: Int, adjacency: List[List[Int]]) -> List[Int] {
    let mut dist: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        dist = list_push(dist, if i == start_node { 0 } else { -1 });
        i = i + 1;
    }

    let mut queue: List[Int] = list_new();
    queue = list_push(queue, start_node);

    let mut q_head: Int = 0;
    while q_head < list_len(queue) {
        let u: Int = list_get(queue, q_head);
        q_head = q_head + 1;

        let d_u: Int = list_get(dist, u);
        let nbrs: List[Int] = list_get(adjacency, u);
        let n_nbrs: Int = list_len(nbrs);

        let mut j: Int = 0;
        while j < n_nbrs {
            let v: Int = list_get(nbrs, j);
            if list_get(dist, v) < 0 {
                // Update dist[v] = d_u + 1
                let mut next_dist: List[Int] = list_new();
                let mut k: Int = 0;
                while k < num_nodes {
                    if k == v {
                        next_dist = list_push(next_dist, d_u + 1);
                    } else {
                        next_dist = list_push(next_dist, list_get(dist, k));
                    }
                    k = k + 1;
                }
                dist = next_dist;
                queue = list_push(queue, v);
            }
            j = j + 1;
        }
    }
    return dist;
}

pub fn closeness_centrality_compute(num_nodes: Int, adjacency: List[List[Int]]) -> CentralityVectorResult {
    let mut cc: List[Int] = list_new();
    let mut u: Int = 0;
    while u < num_nodes {
        let dist: List[Int] = centrality_bfs_distances(u, num_nodes, adjacency);
        let mut sum_dist: Int = 0;
        let mut reachable: Int = 0;

        let mut v: Int = 0;
        while v < num_nodes {
            if v != u {
                let d: Int = list_get(dist, v);
                if d > 0 {
                    sum_dist = sum_dist + d;
                    reachable = reachable + 1;
                }
            }
            v = v + 1;
        }

        if sum_dist > 0 && reachable > 0 {
            // Closeness = (reachable * 10000) / sum_dist
            let score: Int = (reachable * 10000) / sum_dist;
            cc = list_push(cc, score);
        } else {
            cc = list_push(cc, 0);
        }
        u = u + 1;
    }

    return CentralityVectorResult {
        num_nodes: num_nodes,
        scores: cc,
    };
}

pub fn harmonic_centrality_compute(num_nodes: Int, adjacency: List[List[Int]]) -> CentralityVectorResult {
    let mut hc: List[Int] = list_new();
    let mut u: Int = 0;
    while u < num_nodes {
        let dist: List[Int] = centrality_bfs_distances(u, num_nodes, adjacency);
        let mut sum_inv: Int = 0;

        let mut v: Int = 0;
        while v < num_nodes {
            if v != u {
                let d: Int = list_get(dist, v);
                if d > 0 {
                    // Sum 10000 / d
                    sum_inv = sum_inv + (10000 / d);
                }
            }
            v = v + 1;
        }

        let n_denom: Int = if num_nodes > 1 { num_nodes - 1 } else { 1 };
        let norm_score: Int = sum_inv / n_denom;
        hc = list_push(hc, norm_score);
        u = u + 1;
    }

    return CentralityVectorResult {
        num_nodes: num_nodes,
        scores: hc,
    };
}

pub fn closeness_harmonic_centrality_probe() -> Int {
    return 0;
}
