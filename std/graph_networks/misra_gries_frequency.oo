// # Misra-Gries Streaming Frequency & Majority Estimator
//
// Logline: Implements the classic Misra-Gries deterministic k-frequency estimator and majority item identifier.
//
// Setup: Streaming summary maintaining k - 1 item counters with joint decrement upon full-capacity cache misses.
//
// Beats:
//   1. Maintain k - 1 candidate frequency counters for stream token processing.
//   2. Jointly decrement all active counters when encountering an unseen element at full capacity.
//   3. Prune zeroed counters and output guaranteed 1/k-frequency candidates.

pub type MgCounter = struct {
    item_id: Int,
    count: Int
};

pub type MisraGriesSketch = struct {
    k_factor: Int,
    max_entries: Int,
    entries: List[MgCounter],
    total_elements: Int
};

pub fn misra_gries_create(k_factor: Int) -> MisraGriesSketch {
    let mut k: Int = k_factor;
    if k < 2 {
        k = 2;
    }
    let empty: List[MgCounter] = list_new();
    return MisraGriesSketch {
        k_factor: k,
        max_entries: k - 1,
        entries: empty,
        total_elements: 0
    };
}

pub fn misra_gries_find_index(sketch: &MisraGriesSketch, item: Int) -> Int {
    let n: Int = list_len((sketch).entries);
    let mut i: Int = 0;
    while i < n {
        let c: MgCounter = list_get((sketch).entries, i);
        if (c).item_id == item {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn misra_gries_update_at(entries: List[MgCounter], idx: Int, delta: Int) -> List[MgCounter] {
    let mut result: List[MgCounter] = list_new();
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        let cur: MgCounter = list_get(entries, i);
        if i == idx {
            let updated: MgCounter = MgCounter {
                item_id: (cur).item_id,
                count: (cur).count + delta
            };
            result = list_push(result, updated);
        } else {
            result = list_push(result, cur);
        }
        i = i + 1;
    }
    return result;
}

pub fn misra_gries_decrement_all(entries: List[MgCounter]) -> List[MgCounter] {
    let mut non_zero: List[MgCounter] = list_new();
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        let c: MgCounter = list_get(entries, i);
        let next_c: Int = (c).count - 1;
        if next_c > 0 {
            let dec_entry: MgCounter = MgCounter {
                item_id: (c).item_id,
                count: next_c
            };
            non_zero = list_push(non_zero, dec_entry);
        }
        i = i + 1;
    }
    return non_zero;
}

pub fn misra_gries_process(sketch: &mut MisraGriesSketch, item: Int) -> Bool {
    (sketch).total_elements = (sketch).total_elements + 1;
    let idx: Int = misra_gries_find_index(sketch, item);
    if idx >= 0 {
        (sketch).entries = misra_gries_update_at((sketch).entries, idx, 1);
        return true;
    }

    let cur_len: Int = list_len((sketch).entries);
    if cur_len < (sketch).max_entries {
        let new_c: MgCounter = MgCounter {
            item_id: item,
            count: 1
        };
        (sketch).entries = list_push((sketch).entries, new_c);
        return true;
    }

    // Decrement all active counters
    (sketch).entries = misra_gries_decrement_all((sketch).entries);
    return true;
}

pub fn misra_gries_query(sketch: &MisraGriesSketch, item: Int) -> Int {
    let idx: Int = misra_gries_find_index(sketch, item);
    if idx >= 0 {
        let c: MgCounter = list_get((sketch).entries, idx);
        return (c).count;
    }
    return 0;
}

pub fn misra_gries_get_frequent(sketch: &MisraGriesSketch) -> List[MgCounter] {
    return (sketch).entries;
}
