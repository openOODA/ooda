// # Erdős-Rényi Random Graph Generator
//
// Logline: Implements classical Erdős-Rényi G(n, p) and G(n, m) random graph generation models.
//
// Setup: Generative baseline network generator forming independent Bernoulli edge trials and uniform m-edge samplers.
//
// Beats:
//   1. Generate G(n, p) random graphs by evaluating independent edge creation probabilities across all n*(n-1)/2 pairs.
//   2. Sample exactly m distinct edges uniformly at random for G(n, m) ensembles.
//   3. Compute percolation thresholds and phase transitions to giant connected components.

pub type ErEdge = struct {
    u: Int,
    v: Int,
};

pub type ErdosRenyiGraph = struct {
    num_nodes: Int,
    edges: List[ErEdge],
    edge_count: Int,
};

pub fn er_generate_gnp(num_nodes: Int, prob_pct: Int, seed: Int) -> ErdosRenyiGraph {
    let mut edge_list: List[ErEdge] = list_new();
    let n: Int = num_nodes;

    let mut u: Int = 0;
    while u < n {
        let mut v: Int = u + 1;
        while v < n {
            let roll: Int = (u * 31337 + v * 10007 + seed * 7919) % 100;
            if roll < prob_pct {
                let e: ErEdge = ErEdge { u: u, v: v };
                edge_list = list_push(edge_list, e);
            }
            v = v + 1;
        }
        u = u + 1;
    }

    return ErdosRenyiGraph {
        num_nodes: n,
        edges: edge_list,
        edge_count: list_len(edge_list),
    };
}

pub fn er_generate_gnm(num_nodes: Int, target_edges: Int, seed: Int) -> ErdosRenyiGraph {
    let mut edge_list: List[ErEdge] = list_new();
    let n: Int = num_nodes;
    let max_possible: Int = (n * (n - 1)) / 2;
    let m: Int = if target_edges < max_possible { target_edges } else { max_possible };

    let mut added: Int = 0;
    let mut step: Int = 0;
    while added < m && step < (m * 10 + 100) {
        let u: Int = (step * 31337 + seed * 10007) % n;
        let v: Int = (step * 13337 + seed * 7919 + 1) % n;

        if u != v {
            let min_node: Int = if u < v { u } else { v };
            let max_node: Int = if u > v { u } else { v };

            // Check if already present
            let mut exists: Bool = false;
            let mut i: Int = 0;
            let cur_len: Int = list_len(edge_list);
            while i < cur_len && !exists {
                let e: ErEdge = list_get(edge_list, i);
                if (e).u == min_node && (e).v == max_node {
                    exists = true;
                }
                i = i + 1;
            }

            if !exists {
                let new_e: ErEdge = ErEdge { u: min_node, v: max_node };
                edge_list = list_push(edge_list, new_e);
                added = added + 1;
            }
        }
        step = step + 1;
    }

    return ErdosRenyiGraph {
        num_nodes: n,
        edges: edge_list,
        edge_count: list_len(edge_list),
    };
}

pub fn er_check_giant_component_threshold(num_nodes: Int, prob_pct: Int) -> Bool {
    // Phase transition occurs when avg_degree = (n - 1) * p >= 1.0
    // (n - 1) * prob_pct / 100 >= 1 => (n - 1) * prob_pct >= 100
    let n: Int = num_nodes;
    if (n - 1) * prob_pct >= 100 {
        return true; // Supercritical regime
    }
    return false;
}
