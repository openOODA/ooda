// # Hierarchical Random Graph (HRG) Model
//
// Logline: Models nested community structure and multiscale hierarchy via binary tree dendrograms.
//
// Setup: Generative hierarchical dendrogram placing connection probabilities at internal tree bifurcation nodes.
//
// Beats:
//   1. Construct binary tree dendrogram where leaves represent observed network vertices.
//   2. Assign connection probability parameter `p_r` to each internal branch node.
//   3. Compute hierarchical model fit likelihood over lowest common ancestor paths.

pub type HrgInternalNode = struct {
    node_id: Int,
    left_child: Int,
    right_child: Int,
    prob_pct: Int, // Probability of link between left and right subtrees (0..100)
};

pub type HrgDendrogram = struct {
    num_leaves: Int,
    internal_nodes: List[HrgInternalNode],
    root_id: Int,
};

pub type HrgEdge = struct {
    u: Int,
    v: Int,
};

pub fn hrg_create_balanced(num_leaves: Int) -> HrgDendrogram {
    let mut internals: List[HrgInternalNode] = list_new();
    let num_internals: Int = if num_leaves > 1 { num_leaves - 1 } else { 1 };

    let mut i: Int = 0;
    while i < num_internals {
        let node: HrgInternalNode = HrgInternalNode {
            node_id: i,
            left_child: i * 2 + 1,
            right_child: i * 2 + 2,
            prob_pct: 50, // Default 50% link probability
        };
        internals = list_push(internals, node);
        i = i + 1;
    }

    return HrgDendrogram {
        num_leaves: num_leaves,
        internal_nodes: internals,
        root_id: 0,
    };
}

pub fn hrg_find_lca_prob(dendro: &HrgDendrogram, u: Int, v: Int) -> Int {
    // Simplified binary tree LCA probability mapping
    let n_internals: Int = list_len((dendro).internal_nodes);
    if n_internals == 0 {
        return 0;
    }

    let diff: Int = if u > v { u - v } else { v - u };
    let level: Int = diff % n_internals;
    let node: HrgInternalNode = list_get((dendro).internal_nodes, level);
    return (node).prob_pct;
}

pub fn hrg_sample_graph(dendro: &HrgDendrogram, seed: Int) -> List[HrgEdge] {
    let n: Int = (dendro).num_leaves;
    let mut edges: List[HrgEdge] = list_new();

    let mut u: Int = 0;
    while u < n {
        let mut v: Int = u + 1;
        while v < n {
            let p: Int = hrg_find_lca_prob(dendro, u, v);
            let roll: Int = (u * 31337 + v * 10007 + seed * 7919) % 100;
            if roll < p {
                let e: HrgEdge = HrgEdge { u: u, v: v };
                edges = list_push(edges, e);
            }
            v = v + 1;
        }
        u = u + 1;
    }
    return edges;
}

pub fn hrg_compute_log_likelihood_score(dendro: &HrgDendrogram, edges: List[HrgEdge]) -> Int {
    let n: Int = (dendro).num_leaves;
    let mut score: Int = 0;
    let n_edges: Int = list_len(edges);

    let mut u: Int = 0;
    while u < n {
        let mut v: Int = u + 1;
        while v < n {
            let p: Int = hrg_find_lca_prob(dendro, u, v);

            // Check if edge exists
            let mut has_edge: Bool = false;
            let mut e_idx: Int = 0;
            while e_idx < n_edges && !has_edge {
                let e: HrgEdge = list_get(edges, e_idx);
                if ((e).u == u && (e).v == v) || ((e).u == v && (e).v == u) {
                    has_edge = true;
                }
                e_idx = e_idx + 1;
            }

            if has_edge {
                score = score + p;
            } else {
                score = score + (100 - p);
            }
            v = v + 1;
        }
        u = u + 1;
    }
    return score;
}
