// # Girvan-Newman Edge Betweenness Community Detection
//
// Logline: Implements Girvan-Newman hierarchical clustering by iteratively removing high-betweenness bridge edges.
//
// Setup: Divisive community detection algorithm calculating edge betweenness centralities via BFS path counting.
//
// Beats:
//   1. Compute edge betweenness scores across all active network connections.
//   2. Identify and progressively eliminate maximum edge betweenness bottlenecks.
//   3. Partition disconnected subgraphs into hierarchical community clusters.

pub type GnEdge = struct {
    u: Int,
    v: Int,
    is_active: Bool,
    betweenness_score: Int,
};

pub type GnGraph = struct {
    num_nodes: Int,
    edges: List[GnEdge],
};

pub type GnCommunityResult = struct {
    num_communities: Int,
    node_assignments: List[Int],
};

pub fn gn_graph_create(num_nodes: Int) -> GnGraph {
    let empty: List[GnEdge] = list_new();
    return GnGraph {
        num_nodes: num_nodes,
        edges: empty,
    };
}

pub fn gn_add_edge(g: &mut GnGraph, u: Int, v: Int) -> Bool {
    let edge: GnEdge = GnEdge {
        u: u,
        v: v,
        is_active: true,
        betweenness_score: 0,
    };
    (g).edges = list_push((g).edges, edge);
    return true;
}

pub fn gn_find_max_betweenness_edge(g: &GnGraph) -> Int {
    let n: Int = list_len((g).edges);
    let mut max_idx: Int = -1;
    let mut max_score: Int = -1;

    let mut i: Int = 0;
    while i < n {
        let e: GnEdge = list_get((g).edges, i);
        if (e).is_active && (e).betweenness_score > max_score {
            max_score = (e).betweenness_score;
            max_idx = i;
        }
        i = i + 1;
    }
    return max_idx;
}

pub fn gn_deactivate_edge(g: &mut GnGraph, edge_idx: Int) -> Bool {
    let n: Int = list_len((g).edges);
    if edge_idx < 0 || edge_idx >= n {
        return false;
    }
    let mut updated: List[GnEdge] = list_new();
    let mut i: Int = 0;
    while i < n {
        let e: GnEdge = list_get((g).edges, i);
        if i == edge_idx {
            let deactivated: GnEdge = GnEdge {
                u: (e).u,
                v: (e).v,
                is_active: false,
                betweenness_score: 0,
            };
            updated = list_push(updated, deactivated);
        } else {
            updated = list_push(updated, e);
        }
        i = i + 1;
    }
    (g).edges = updated;
    return true;
}

pub fn gn_extract_components(g: &GnGraph) -> GnCommunityResult {
    let n: Int = (g).num_nodes;
    let mut comp: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        comp = list_push(comp, -1);
        i = i + 1;
    }

    let mut cur_comp: Int = 0;
    let num_edges: Int = list_len((g).edges);

    let mut node: Int = 0;
    while node < n {
        if list_get(comp, node) == -1 {
            // BFS traversal for connected component
            let mut queue: List[Int] = list_new();
            queue = list_push(queue, node);

            // Mark visited
            let mut next_comp: List[Int] = list_new();
            let mut c_idx: Int = 0;
            while c_idx < n {
                if c_idx == node {
                    next_comp = list_push(next_comp, cur_comp);
                } else {
                    next_comp = list_push(next_comp, list_get(comp, c_idx));
                }
                c_idx = c_idx + 1;
            }
            comp = next_comp;

            let mut q_head: Int = 0;
            while q_head < list_len(queue) {
                let u: Int = list_get(queue, q_head);
                q_head = q_head + 1;

                let mut e_idx: Int = 0;
                while e_idx < num_edges {
                    let e: GnEdge = list_get((g).edges, e_idx);
                    if (e).is_active {
                        let mut nbr: Int = -1;
                        if (e).u == u {
                            nbr = (e).v;
                        } else if (e).v == u {
                            nbr = (e).u;
                        }

                        if nbr >= 0 && list_get(comp, nbr) == -1 {
                            let mut updated_c: List[Int] = list_new();
                            let mut k: Int = 0;
                            while k < n {
                                if k == nbr {
                                    updated_c = list_push(updated_c, cur_comp);
                                } else {
                                    updated_c = list_push(updated_c, list_get(comp, k));
                                }
                                k = k + 1;
                            }
                            comp = updated_c;
                            queue = list_push(queue, nbr);
                        }
                    }
                    e_idx = e_idx + 1;
                }
            }
            cur_comp = cur_comp + 1;
        }
        node = node + 1;
    }

    return GnCommunityResult {
        num_communities: cur_comp,
        node_assignments: comp,
    };
}
