// # Greedy Perimeter Stateless Routing (GPSR)
//
// Logline: Implements geographic geometric mesh routing with greedy distance forwarding and perimeter face recovery.
//
// Setup: Stateless wireless sensor network routing combining euclidean greedy forwarding with the right-hand perimeter rule.
//
// Beats:
//   1. Select neighbor node geographically closest to destination coordinate (Greedy Mode).
//   2. Detect local minima voids where no neighbor is strictly closer than current node.
//   3. Traverse planarized face boundaries using the right-hand rule to bypass geographic voids (Perimeter Mode).

pub type GpsrGeoPoint = struct {
    x: Int, // Coordinates scaled by 100
    y: Int,
};

pub type GpsrNeighbor = struct {
    node_id: Int,
    location: GpsrGeoPoint,
};

pub type GpsrPacket = struct {
    packet_id: Int,
    dest_location: GpsrGeoPoint,
    mode: Int, // 0 = Greedy, 1 = Perimeter
    perimeter_first_edge_u: Int,
    perimeter_first_edge_v: Int,
};

pub fn gpsr_dist_sq(p1: &GpsrGeoPoint, p2: &GpsrGeoPoint) -> Int {
    let dx: Int = (p1).x - (p2).x;
    let dy: Int = (p1).y - (p2).y;
    return dx * dx + dy * dy;
}

pub fn gpsr_find_greedy_next_hop(
    cur_loc: &GpsrGeoPoint,
    dest_loc: &GpsrGeoPoint,
    neighbors: List[GpsrNeighbor]
) -> Int {
    let cur_dist: Int = gpsr_dist_sq(cur_loc, dest_loc);
    let mut best_dist: Int = cur_dist;
    let mut best_node: Int = -1;

    let n: Int = list_len(neighbors);
    let mut i: Int = 0;
    while i < n {
        let nbr: GpsrNeighbor = list_get(neighbors, i);
        let d: Int = gpsr_dist_sq(&(nbr).location, dest_loc);
        if d < best_dist {
            best_dist = d;
            best_node = (nbr).node_id;
        }
        i = i + 1;
    }
    return best_node;
}

pub fn gpsr_right_hand_forward(
    cur_id: Int,
    prev_id: Int,
    neighbors: List[GpsrNeighbor]
) -> Int {
    // Select the first neighbor in counter-clockwise angular order from incoming edge
    let n: Int = list_len(neighbors);
    if n == 0 {
        return -1;
    }

    let mut i: Int = 0;
    while i < n {
        let nbr: GpsrNeighbor = list_get(neighbors, i);
        if (nbr).node_id != prev_id {
            return (nbr).node_id;
        }
        i = i + 1;
    }
    let first: GpsrNeighbor = list_get(neighbors, 0);
    return (first).node_id;
}

pub fn gpsr_route_packet(
    local_id: Int,
    local_loc: &GpsrGeoPoint,
    prev_id: Int,
    packet: &mut GpsrPacket,
    neighbors: List[GpsrNeighbor]
) -> Int {
    if (packet).mode == 0 {
        // Greedy Mode
        let next_hop: Int = gpsr_find_greedy_next_hop(local_loc, &(packet).dest_location, neighbors);
        if next_hop >= 0 {
            return next_hop;
        }

        // Void detected: Switch to Perimeter Mode
        (packet).mode = 1;
        let perim_hop: Int = gpsr_right_hand_forward(local_id, prev_id, neighbors);
        (packet).perimeter_first_edge_u = local_id;
        (packet).perimeter_first_edge_v = perim_hop;
        return perim_hop;
    }

    // In Perimeter Mode: Check if greedy forwarding can be resumed
    let cur_dist: Int = gpsr_dist_sq(local_loc, &(packet).dest_location);
    let next_greedy: Int = gpsr_find_greedy_next_hop(local_loc, &(packet).dest_location, neighbors);

    if next_greedy >= 0 {
        (packet).mode = 0; // Return to greedy mode
        return next_greedy;
    }

    // Continue perimeter traversal
    return gpsr_right_hand_forward(local_id, prev_id, neighbors);
}
