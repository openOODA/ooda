// # Epidemic Routing Protocol for Delay-Tolerant Networks
//
// Logline: Implements flood-based epidemic routing with summary vector exchange and hop-count TTL expiration.
//
// Setup: Opportunistic DTN routing engine maximizing delivery probability across intermittent mobile ad-hoc contacts.
//
// Beats:
//   1. Maintain local message buffer with unique message IDs, destination targets, and TTL limits.
//   2. Exchange compact summary vectors upon pairwise opportunistic node contacts.
//   3. Replicate missing messages to peer buffer up to buffer capacity limits.

pub type DtnMessage = struct {
    msg_id: Int,
    source_id: Int,
    dest_id: Int,
    hop_limit: Int,
    payload_size: Int,
};

pub type EpidemicRouter = struct {
    local_id: Int,
    buffer_capacity: Int,
    message_buffer: List[DtnMessage],
    delivered_ids: List[Int],
};

pub fn epidemic_create(local_id: Int, capacity: Int) -> EpidemicRouter {
    let empty_buf: List[DtnMessage] = list_new();
    let empty_del: List[Int] = list_new();
    return EpidemicRouter {
        local_id: local_id,
        buffer_capacity: capacity,
        message_buffer: empty_buf,
        delivered_ids: empty_del,
    };
}

pub fn epidemic_has_message(router: &EpidemicRouter, msg_id: Int) -> Bool {
    let n: Int = list_len((router).message_buffer);
    let mut i: Int = 0;
    while i < n {
        let m: DtnMessage = list_get((router).message_buffer, i);
        if (m).msg_id == msg_id {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn epidemic_get_summary_vector(router: &EpidemicRouter) -> List[Int] {
    let mut vec: List[Int] = list_new();
    let n: Int = list_len((router).message_buffer);
    let mut i: Int = 0;
    while i < n {
        let m: DtnMessage = list_get((router).message_buffer, i);
        vec = list_push(vec, (m).msg_id);
        i = i + 1;
    }
    return vec;
}

pub fn epidemic_receive_message(router: &mut EpidemicRouter, msg: &DtnMessage) -> Bool {
    if epidemic_has_message(router, (msg).msg_id) {
        return false;
    }

    if (msg).hop_limit <= 0 {
        return false;
    }

    // Check if this node is the destination
    if (msg).dest_id == (router).local_id {
        (router).delivered_ids = list_push((router).delivered_ids, (msg).msg_id);
        return true;
    }

    // Buffer check
    if list_len((router).message_buffer) >= (router).buffer_capacity {
        return false; // Buffer full
    }

    let replicated: DtnMessage = DtnMessage {
        msg_id: (msg).msg_id,
        source_id: (msg).source_id,
        dest_id: (msg).dest_id,
        hop_limit: (msg).hop_limit - 1,
        payload_size: (msg).payload_size,
    };

    (router).message_buffer = list_push((router).message_buffer, replicated);
    return true;
}

pub fn epidemic_find_missing_messages(
    router: &EpidemicRouter,
    remote_summary: List[Int]
) -> List[DtnMessage] {
    let mut to_send: List[DtnMessage] = list_new();
    let n_local: Int = list_len((router).message_buffer);
    let n_remote: Int = list_len(remote_summary);

    let mut i: Int = 0;
    while i < n_local {
        let m: DtnMessage = list_get((router).message_buffer, i);
        let mut peer_has: Bool = false;
        let mut j: Int = 0;
        while j < n_remote && !peer_has {
            if list_get(remote_summary, j) == (m).msg_id {
                peer_has = true;
            }
            j = j + 1;
        }

        if !peer_has {
            to_send = list_push(to_send, m);
        }
        i = i + 1;
    }
    return to_send;
}
