// # Chord DHT Logarithmic Finger Table Routing
//
// Logline: Implements Chord consistent hashing ring, logarithmic m-entry finger tables, and O(log N) key lookup.
//
// Setup: Structured peer-to-peer overlay network mapping keys and nodes into 1D modular identifier ring [0, 2^m - 1].
//
// Beats:
//   1. Partition cyclic key identifier space across consistent hashing circular ring topology.
//   2. Populate logarithmic finger table where finger[i] = successor((n + 2^(i-1)) mod 2^m).
//   3. Route key queries via closest preceding finger nodes to achieve O(log N) lookup complexity.

pub type ChordFinger = struct {
    start_id: Int,
    node_id: Int,
};

pub type ChordNode = struct {
    node_id: Int,
    m_bits: Int,
    successor: Int,
    predecessor: Int,
    finger_table: List[ChordFinger],
};

pub fn chord_pow2(exp: Int) -> Int {
    let mut res: Int = 1;
    let mut i: Int = 0;
    while i < exp {
        res = res * 2;
        i = i + 1;
    }
    return res;
}

pub fn chord_in_interval_open(val: Int, a: Int, b: Int, max_ring: Int) -> Bool {
    if a < b {
        return val > a && val < b;
    }
    if a > b {
        return val > a || val < b;
    }
    // a == b means entire ring except a
    return val != a;
}

pub fn chord_in_interval_right_closed(val: Int, a: Int, b: Int, max_ring: Int) -> Bool {
    if a < b {
        return val > a && val <= b;
    }
    if a > b {
        return val > a || val <= b;
    }
    return true;
}

pub fn chord_node_create(node_id: Int, m_bits: Int) -> ChordNode {
    let max_ring: Int = chord_pow2(m_bits);
    let mut fingers: List[ChordFinger] = list_new();

    let mut i: Int = 0;
    while i < m_bits {
        let offset: Int = chord_pow2(i);
        let start: Int = (node_id + offset) % max_ring;
        let f: ChordFinger = ChordFinger {
            start_id: start,
            node_id: node_id, // Default to self until joined
        };
        fingers = list_push(fingers, f);
        i = i + 1;
    }

    return ChordNode {
        node_id: node_id,
        m_bits: m_bits,
        successor: node_id,
        predecessor: node_id,
        finger_table: fingers,
    };
}

pub fn chord_closest_preceding_finger(node: &ChordNode, key_id: Int) -> Int {
    let m: Int = (node).m_bits;
    let max_ring: Int = chord_pow2(m);
    let n_id: Int = (node).node_id;

    let mut i: Int = m - 1;
    while i >= 0 {
        let f: ChordFinger = list_get((node).finger_table, i);
        if chord_in_interval_open((f).node_id, n_id, key_id, max_ring) {
            return (f).node_id;
        }
        i = i - 1;
    }
    return n_id;
}

pub fn chord_find_next_hop(node: &ChordNode, key_id: Int) -> Int {
    let max_ring: Int = chord_pow2((node).m_bits);
    let n_id: Int = (node).node_id;
    let succ: Int = (node).successor;

    // If key is within (n, successor], successor is responsible
    if chord_in_interval_right_closed(key_id, n_id, succ, max_ring) {
        return succ;
    }

    // Forward to closest preceding finger
    return chord_closest_preceding_finger(node, key_id);
}

pub fn chord_set_finger(node: &mut ChordNode, finger_idx: Int, target_node: Int) -> Bool {
    let m: Int = (node).m_bits;
    if finger_idx < 0 || finger_idx >= m {
        return false;
    }

    let mut updated: List[ChordFinger] = list_new();
    let mut i: Int = 0;
    while i < m {
        let f: ChordFinger = list_get((node).finger_table, i);
        if i == finger_idx {
            let next_f: ChordFinger = ChordFinger {
                start_id: (f).start_id,
                node_id: target_node,
            };
            updated = list_push(updated, next_f);
        } else {
            updated = list_push(updated, f);
        }
        i = i + 1;
    }

    (node).finger_table = updated;
    if finger_idx == 0 {
        (node).successor = target_node;
    }
    return true;
}
