// # Fruchterman-Reingold Force-Directed Layout
//
// Logline: Computes 2D graph node coordinates using spring attraction, electrostatic repulsion, and simulated annealing.
//
// Setup: Energy-minimization layout algorithm iteratively updating vertex positions bounded by temperature cooling schedules.
//
// Beats:
//   1. Compute pairwise repulsive electrostatic forces between all graph vertices.
//   2. Calculate spring-like attractive forces along connected edges.
//   3. Displace node coordinates bounded by decaying system temperature.

pub type FrPoint = struct {
    x: Int, // Scaled coordinate (e.g. * 100)
    y: Int,
};

pub type FrEdge = struct {
    u: Int,
    v: Int,
};

pub type FrGraphLayout = struct {
    num_nodes: Int,
    positions: List[FrPoint],
    edges: List[FrEdge],
    temperature: Int,
    k_optimal_dist: Int,
};

pub fn fr_layout_create(num_nodes: Int, area_width: Int, area_height: Int) -> FrGraphLayout {
    let mut pts: List[FrPoint] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        // Initial circular placement
        let angle_idx: Int = (i * 360) / (if num_nodes > 0 { num_nodes } else { 1 });
        let pt: FrPoint = FrPoint {
            x: (area_width / 2) + (angle_idx * 2),
            y: (area_height / 2) + (i * 10),
        };
        pts = list_push(pts, pt);
        i = i + 1;
    }

    let empty_edges: List[FrEdge] = list_new();
    return FrGraphLayout {
        num_nodes: num_nodes,
        positions: pts,
        edges: empty_edges,
        temperature: 100, // Initial temperature
        k_optimal_dist: 50,
    };
}

pub fn fr_layout_add_edge(layout: &mut FrGraphLayout, u: Int, v: Int) -> Bool {
    let e: FrEdge = FrEdge { u: u, v: v };
    (layout).edges = list_push((layout).edges, e);
    return true;
}

pub fn fr_approx_sqrt(val: Int) -> Int {
    if val <= 0 {
        return 1;
    }
    let mut x: Int = val / 2;
    if x == 0 {
        x = 1;
    }
    let mut iter: Int = 0;
    while iter < 10 {
        x = (x + val / x) / 2;
        iter = iter + 1;
    }
    if x <= 0 {
        return 1;
    }
    return x;
}

pub fn fr_step(layout: &mut FrGraphLayout) -> Bool {
    let n: Int = (layout).num_nodes;
    let k: Int = (layout).k_optimal_dist;
    let temp: Int = (layout).temperature;
    if temp <= 0 {
        return false;
    }

    let mut disp_x: List[Int] = list_new();
    let mut disp_y: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        disp_x = list_push(disp_x, 0);
        disp_y = list_push(disp_y, 0);
        i = i + 1;
    }

    // 1. Repulsive forces
    let mut v: Int = 0;
    while v < n {
        let pos_v: FrPoint = list_get((layout).positions, v);
        let mut u: Int = 0;
        while u < n {
            if u != v {
                let pos_u: FrPoint = list_get((layout).positions, u);
                let dx: Int = (pos_v).x - (pos_u).x;
                let dy: Int = (pos_v).y - (pos_u).y;
                let dist_sq: Int = dx * dx + dy * dy;
                let dist: Int = fr_approx_sqrt(dist_sq);
                if dist > 0 {
                    let force: Int = (k * k) / dist;
                    let dx_rep: Int = (dx * force) / dist;
                    let dy_rep: Int = (dy * force) / dist;

                    let cur_dx: Int = list_get(disp_x, v);
                    let cur_dy: Int = list_get(disp_y, v);

                    // Update displacements
                    let mut next_dx: List[Int] = list_new();
                    let mut next_dy: List[Int] = list_new();
                    let mut j: Int = 0;
                    while j < n {
                        if j == v {
                            next_dx = list_push(next_dx, cur_dx + dx_rep);
                            next_dy = list_push(next_dy, cur_dy + dy_rep);
                        } else {
                            next_dx = list_push(next_dx, list_get(disp_x, j));
                            next_dy = list_push(next_dy, list_get(disp_y, j));
                        }
                        j = j + 1;
                    }
                    disp_x = next_dx;
                    disp_y = next_dy;
                }
            }
            u = u + 1;
        }
        v = v + 1;
    }

    // 2. Displace positions bounded by temperature
    let mut next_positions: List[FrPoint] = list_new();
    let mut p_idx: Int = 0;
    while p_idx < n {
        let pos: FrPoint = list_get((layout).positions, p_idx);
        let dx: Int = list_get(disp_x, p_idx);
        let dy: Int = list_get(disp_y, p_idx);
        let dist: Int = fr_approx_sqrt(dx * dx + dy * dy);

        let mut move_x: Int = 0;
        let mut move_y: Int = 0;
        if dist > 0 {
            let cap: Int = if dist < temp { dist } else { temp };
            move_x = (dx * cap) / dist;
            move_y = (dy * cap) / dist;
        }

        let updated_pt: FrPoint = FrPoint {
            x: (pos).x + move_x,
            y: (pos).y + move_y,
        };
        next_positions = list_push(next_positions, updated_pt);
        p_idx = p_idx + 1;
    }

    (layout).positions = next_positions;
    (layout).temperature = (temp * 95) / 100; // Cool temperature by 5%
    return true;
}
