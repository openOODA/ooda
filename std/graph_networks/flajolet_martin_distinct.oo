// # Flajolet-Martin Probabilistic Distinct Elements Counter
//
// Logline: Implements the Flajolet-Martin algorithm using trailing-zero bitmasks and phi-scaled cardinality estimation.
//
// Setup: Streaming distinct element estimator tracking least significant zero bit positions in bitmap registers.
//
// Beats:
//   1. Map stream elements to 32-bit hash integers and extract trailing zero runs.
//   2. Set corresponding bit positions in bitmap registers across multiple hash functions.
//   3. Compute lowest unset bit position (R) and estimate distinct elements using the 1/phi constant factor.

pub type FmBitmaskCounter = struct {
    num_hashes: Int,
    bitmaps: List[Int], // One 32-bit integer bitmask per hash function
    a_params: List[Int],
    b_params: List[Int],
};

pub type FmDistinctEstimate = struct {
    mean_r: Int,
    estimated_distinct: Int,
};

pub fn fm_pow2(exp: Int) -> Int {
    let mut res: Int = 1;
    let mut i: Int = 0;
    while i < exp {
        res = res * 2;
        i = i + 1;
    }
    return res;
}

pub fn fm_create(num_hashes: Int) -> FmBitmaskCounter {
    let mut k: Int = num_hashes;
    if k < 1 {
        k = 16;
    }
    let mut b_list: List[Int] = list_new();
    let mut a_list: List[Int] = list_new();
    let mut b_params: List[Int] = list_new();
    let mut i: Int = 0;
    while i < k {
        b_list = list_push(b_list, 0);
        let a_val: Int = (i * 31337 + 101) % 65535 + 1;
        let b_val: Int = (i * 13337 + 7919) % 65535;
        a_list = list_push(a_list, a_val);
        b_params = list_push(b_params, b_val);
        i = i + 1;
    }
    return FmBitmaskCounter {
        num_hashes: k,
        bitmaps: b_list,
        a_params: a_list,
        b_params: b_params,
    };
}

pub fn fm_trailing_zeros(val: Int) -> Int {
    if val == 0 {
        return 31;
    }
    let mut count: Int = 0;
    let mut temp: Int = val;
    if temp < 0 {
        temp = 0 - temp;
    }
    while temp > 0 && temp % 2 == 0 && count < 31 {
        count = count + 1;
        temp = temp / 2;
    }
    return count;
}

pub fn fm_set_bit(bitmap: Int, bit_idx: Int) -> Int {
    let bit_mask: Int = fm_pow2(bit_idx);
    // Integer bitwise OR emulation
    let bit_val: Int = (bitmap / bit_mask) % 2;
    if bit_val == 0 {
        return bitmap + bit_mask;
    }
    return bitmap;
}

pub fn fm_add(counter: &mut FmBitmaskCounter, item: Int) -> Bool {
    let k: Int = (counter).num_hashes;
    let mut updated_bitmaps: List[Int] = list_new();
    let prime: Int = 2147483647;

    let mut i: Int = 0;
    while i < k {
        let a: Int = list_get((counter).a_params, i);
        let b: Int = list_get((counter).b_params, i);
        let mut pos_item: Int = item;
        if pos_item < 0 {
            pos_item = 0 - pos_item;
        }
        let h: Int = (pos_item * a + b) % prime;
        let r: Int = fm_trailing_zeros(h);
        let cur_bm: Int = list_get((counter).bitmaps, i);
        let new_bm: Int = fm_set_bit(cur_bm, r);
        updated_bitmaps = list_push(updated_bitmaps, new_bm);
        i = i + 1;
    }

    (counter).bitmaps = updated_bitmaps;
    return true;
}

pub fn fm_find_lowest_zero_bit(bitmap: Int) -> Int {
    let mut bit: Int = 0;
    let mut temp: Int = bitmap;
    while bit < 31 {
        if temp % 2 == 0 {
            return bit;
        }
        temp = temp / 2;
        bit = bit + 1;
    }
    return 31;
}

pub fn fm_estimate(counter: &FmBitmaskCounter) -> FmDistinctEstimate {
    let k: Int = (counter).num_hashes;
    if k == 0 {
        return FmDistinctEstimate { mean_r: 0, estimated_distinct: 0 };
    }

    let mut sum_r: Int = 0;
    let mut i: Int = 0;
    while i < k {
        let bm: Int = list_get((counter).bitmaps, i);
        let r: Int = fm_find_lowest_zero_bit(bm);
        sum_r = sum_r + r;
        i = i + 1;
    }

    let avg_r_scaled: Int = (sum_r * 100) / k;
    let mean_r_int: Int = avg_r_scaled / 100;
    let two_pow_r: Int = fm_pow2(mean_r_int);

    // Scaling factor 1/phi approx 1.2928 (or 2^R / 0.77351)
    // 2^R * 10000 / 7735
    let estimated: Int = (two_pow_r * 10000) / 7735;

    return FmDistinctEstimate {
        mean_r: mean_r_int,
        estimated_distinct: estimated,
    };
}
