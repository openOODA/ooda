// # Kamada-Kawai Spring Embedder Graph Layout
//
// Logline: Computes 2D graph layout coordinates by minimizing ideal shortest-path spring energy stress.
//
// Setup: Energy-minimization layout engine operating on all-pairs shortest paths and Hooke's law spring stiffness.
//
// Beats:
//   1. Establish matrix of ideal geometric distances derived from graph-theoretic shortest paths.
//   2. Compute pairwise spring stiffness constants inversely proportional to squared ideal distances.
//   3. Minimize global energy stress using steepest descent coordinate displacement steps.

pub type KkPoint = struct {
    x: Int,
    y: Int
};

pub type KkLayoutEngine = struct {
    num_nodes: Int,
    positions: List[KkPoint],
    ideal_distances: List[Int], // N x N matrix of ideal lengths
    spring_constants: List[Int], // N x N matrix of K_ij values
    iterations: Int
};

pub fn kk_approx_sqrt(val: Int) -> Int {
    if val <= 0 {
        return 1;
    }
    let mut x: Int = val / 2;
    if x == 0 {
        x = 1;
    }
    let mut iter: Int = 0;
    while iter < 8 {
        x = (x + val / x) / 2;
        iter = iter + 1;
    }
    if x <= 0 {
        return 1;
    }
    return x;
}

pub fn kk_layout_create(num_nodes: Int, shortest_paths: List[Int], length_factor: Int) -> KkLayoutEngine {
    let mut pts: List[KkPoint] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        let angle_idx: Int = (i * 360) / (if num_nodes > 0 { num_nodes } else { 1 });
        let pt: KkPoint = KkPoint {
            x: (angle_idx * 10) % 500,
            y: (i * 40) % 500
        };
        pts = list_push(pts, pt);
        i = i + 1;
    }

    let total_cells: Int = num_nodes * num_nodes;
    let mut ideal_d: List[Int] = list_new();
    let mut spring_k: List[Int] = list_new();

    let mut cell: Int = 0;
    while cell < total_cells {
        let d: Int = list_get(shortest_paths, cell);
        let ideal_val: Int = d * length_factor;
        ideal_d = list_push(ideal_d, ideal_val);

        if d > 0 {
            let k_val: Int = 10000 / (d * d);
            spring_k = list_push(spring_k, k_val);
        } else {
            spring_k = list_push(spring_k, 0);
        }
        cell = cell + 1;
    }

    return KkLayoutEngine {
        num_nodes: num_nodes,
        positions: pts,
        ideal_distances: ideal_d,
        spring_constants: spring_k,
        iterations: 0
    };
}

pub fn kk_compute_stress(engine: &KkLayoutEngine) -> Int {
    let n: Int = (engine).num_nodes;
    let mut total_stress: Int = 0;

    let mut i: Int = 0;
    while i < n {
        let pi: KkPoint = list_get((engine).positions, i);
        let mut j: Int = i + 1;
        while j < n {
            let pj: KkPoint = list_get((engine).positions, j);
            let dx: Int = (pi).x - (pj).x;
            let dy: Int = (pi).y - (pj).y;
            let dist: Int = kk_approx_sqrt(dx * dx + dy * dy);

            let cell_idx: Int = i * n + j;
            let ideal_len: Int = list_get((engine).ideal_distances, cell_idx);
            let k_val: Int = list_get((engine).spring_constants, cell_idx);

            let diff: Int = dist - ideal_len;
            let term: Int = (k_val * diff * diff) / 2;
            total_stress = total_stress + term;
            j = j + 1;
        }
        i = i + 1;
    }
    return total_stress;
}

pub fn kk_step_steepest_descent(engine: &mut KkLayoutEngine, step_size: Int) -> Bool {
    let n: Int = (engine).num_nodes;
    let mut next_positions: List[KkPoint] = list_new();

    let mut m: Int = 0;
    while m < n {
        let pm: KkPoint = list_get((engine).positions, m);
        let mut grad_x: Int = 0;
        let mut grad_y: Int = 0;

        let mut i: Int = 0;
        while i < n {
            if i != m {
                let pi: KkPoint = list_get((engine).positions, i);
                let dx: Int = (pm).x - (pi).x;
                let dy: Int = (pm).y - (pi).y;
                let dist: Int = kk_approx_sqrt(dx * dx + dy * dy);

                let cell_idx: Int = m * n + i;
                let l_mi: Int = list_get((engine).ideal_distances, cell_idx);
                let k_mi: Int = list_get((engine).spring_constants, cell_idx);

                if dist > 0 {
                    let d_diff: Int = dist - l_mi;
                    grad_x = grad_x + (k_mi * dx * d_diff) / dist;
                    grad_y = grad_y + (k_mi * dy * d_diff) / dist;
                }
            }
            i = i + 1;
        }

        let updated_p: KkPoint = KkPoint {
            x: (pm).x - (grad_x * step_size) / 1000,
            y: (pm).y - (grad_y * step_size) / 1000
        };
        next_positions = list_push(next_positions, updated_p);
        m = m + 1;
    }

    (engine).positions = next_positions;
    (engine).iterations = (engine).iterations + 1;
    return true;
}
