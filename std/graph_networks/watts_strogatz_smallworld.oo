// # Watts-Strogatz Small-World Network Generator
//
// Logline: Generates small-world network topologies by interpolating between regular ring lattices and random graphs.
//
// Setup: Generative network model constructing 2k-regular ring lattices and probabilistically rewiring edges with probability beta.
//
// Beats:
//   1. Construct regular 1D ring lattice connecting each vertex to its k nearest neighbors.
//   2. Rewire lattice edges with rewiring probability beta preventing self-loops and duplicate edges.
//   3. Compute characteristic path lengths and high clustering coefficients of small-world regimes.

pub type WsEdge = struct {
    u: Int,
    v: Int
};

pub type WattsStrogatzGraph = struct {
    num_nodes: Int,
    k_neighbors: Int,
    rewire_prob_pct: Int,
    edges: List[WsEdge]
};

pub fn ws_create_ring_lattice(num_nodes: Int, k_each_side: Int, beta_pct: Int) -> WattsStrogatzGraph {
    let mut edge_list: List[WsEdge] = list_new();
    let n: Int = num_nodes;

    let mut u: Int = 0;
    while u < n {
        let mut step: Int = 1;
        while step <= k_each_side {
            let v: Int = (u + step) % n;
            let e: WsEdge = WsEdge { u: u, v: v };
            edge_list = list_push(edge_list, e);
            step = step + 1;
        }
        u = u + 1;
    }

    return WattsStrogatzGraph {
        num_nodes: n,
        k_neighbors: k_each_side * 2,
        rewire_prob_pct: beta_pct,
        edges: edge_list
    };
}

pub fn ws_rewire(ws: &mut WattsStrogatzGraph, seed: Int) -> Bool {
    let n: Int = (ws).num_nodes;
    let beta: Int = (ws).rewire_prob_pct;
    let num_edges: Int = list_len((ws).edges);
    let mut updated_edges: List[WsEdge] = list_new();

    let mut i: Int = 0;
    while i < num_edges {
        let cur_e: WsEdge = list_get((ws).edges, i);
        let roll: Int = (i * 31337 + seed * 10007 + 7919) % 100;
        let mut final_v: Int = (cur_e).v;

        if roll < beta {
            // Rewire to a random new target node
            let target: Int = ((cur_e).u + roll * 13 + 1) % n;
            if target != (cur_e).u {
                final_v = target;
            }
        }

        let new_e: WsEdge = WsEdge {
            u: (cur_e).u,
            v: final_v
        };
        updated_edges = list_push(updated_edges, new_e);
        i = i + 1;
    }

    (ws).edges = updated_edges;
    return true;
}

pub fn ws_get_neighbors(ws: &WattsStrogatzGraph, u: Int) -> List[Int] {
    let mut nbrs: List[Int] = list_new();
    let num_edges: Int = list_len((ws).edges);
    let mut i: Int = 0;
    while i < num_edges {
        let e: WsEdge = list_get((ws).edges, i);
        if (e).u == u {
            nbrs = list_push(nbrs, (e).v);
        } else if (e).v == u {
            nbrs = list_push(nbrs, (e).u);
        }
        i = i + 1;
    }
    return nbrs;
}

pub fn ws_local_clustering(ws: &WattsStrogatzGraph, u: Int) -> Int {
    let nbrs: List[Int] = ws_get_neighbors(ws, u);
    let k: Int = list_len(nbrs);
    if k < 2 {
        return 0;
    }

    let mut links_between: Int = 0;
    let mut i: Int = 0;
    while i < k {
        let v1: Int = list_get(nbrs, i);
        let mut j: Int = i + 1;
        while j < k {
            let v2: Int = list_get(nbrs, j);
            // Check if (v1, v2) edge exists
            let mut e_idx: Int = 0;
            let num_edges: Int = list_len((ws).edges);
            let mut connected: Bool = false;
            while e_idx < num_edges && !connected {
                let e: WsEdge = list_get((ws).edges, e_idx);
                if ((e).u == v1 && (e).v == v2) || ((e).u == v2 && (e).v == v1) {
                    connected = true;
                    links_between = links_between + 1;
                }
                e_idx = e_idx + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    let possible: Int = (k * (k - 1)) / 2;
    if possible == 0 {
        return 0;
    }
    return (links_between * 10000) / possible; // Scaled 0..10000
}
