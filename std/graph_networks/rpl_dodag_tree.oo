// # RPL IPv6 DODAG Tree Routing (RFC 6550)
//
// Logline: Implements RPL Destination-Oriented Directed Acyclic Graph (DODAG) formation for low-power lossy mesh networks.
//
// Setup: Tree-structured distance vector routing protocol for IoT mesh running Objective Function Zero (OF0) rank calculations.
//
// Beats:
//   1. Broadcast DODAG Information Object (DIO) control messages with rank and instance IDs.
//   2. Select preferred parent and compute monotonic node rank using Objective Function (OF0/MRHOF).
//   3. Transmit Destination Advertisement Objects (DAO) upstream to establish downward routing paths.

pub type RplDioMessage = struct {
    dodag_id: Int,
    version: Int,
    rank: Int,
    grounded: Bool,
    sender_id: Int,
    link_metric: Int // ETX or link cost
};

pub type RplDaoMessage = struct {
    dodag_id: Int,
    target_prefix: Int,
    sequence_num: Int,
    lifetime: Int,
    sender_id: Int
};

pub type RplDodagNode = struct {
    node_id: Int,
    dodag_id: Int,
    is_root: Bool,
    current_rank: Int,
    preferred_parent: Int,
    parent_link_cost: Int,
    version: Int,
    dao_sequence: Int
};

pub fn rpl_node_create(node_id: Int, is_root: Bool, dodag_id: Int) -> RplDodagNode {
    let min_hop_rank_inc: Int = 256;
    let root_rank: Int = min_hop_rank_inc;
    let inf_rank: Int = 65535;

    return RplDodagNode {
        node_id: node_id,
        dodag_id: dodag_id,
        is_root: is_root,
        current_rank: if is_root { root_rank } else { inf_rank },
        preferred_parent: if is_root { node_id } else { -1 },
        parent_link_cost: 0,
        version: 1,
        dao_sequence: 1
    };
}

pub fn rpl_of0_calculate_rank(parent_rank: Int, step_of_rank: Int) -> Int {
    let min_hop_rank_inc: Int = 256;
    let rank_increase: Int = step_of_rank * min_hop_rank_inc;
    return parent_rank + rank_increase;
}

pub fn rpl_process_dio(node: &mut RplDodagNode, dio: &RplDioMessage) -> Bool {
    if (node).is_root {
        return false; // Root never switches parents
    }

    if (dio).dodag_id != (node).dodag_id {
        return false;
    }

    // Step calculation: ETX-based (step 1..8)
    let step: Int = if (dio).link_metric > 0 { (dio).link_metric } else { 1 };
    let candidate_rank: Int = rpl_of0_calculate_rank((dio).rank, step);

    // Rule: Avoid loops (must have strictly lower candidate rank than current, or new dodag version)
    if candidate_rank < (node).current_rank || (dio).version > (node).version {
        (node).current_rank = candidate_rank;
        (node).preferred_parent = (dio).sender_id;
        (node).parent_link_cost = (dio).link_metric;
        (node).version = (dio).version;
        return true;
    }

    return false;
}

pub fn rpl_generate_dio(node: &RplDodagNode) -> RplDioMessage {
    return RplDioMessage {
        dodag_id: (node).dodag_id,
        version: (node).version,
        rank: (node).current_rank,
        grounded: true,
        sender_id: (node).node_id,
        link_metric: (node).parent_link_cost
    };
}

pub fn rpl_generate_dao(node: &mut RplDodagNode) -> RplDaoMessage {
    (node).dao_sequence = (node).dao_sequence + 1;
    return RplDaoMessage {
        dodag_id: (node).dodag_id,
        target_prefix: (node).node_id,
        sequence_num: (node).dao_sequence,
        lifetime: 3600,
        sender_id: (node).node_id
    };
}
