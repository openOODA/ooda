// # Core-Periphery Structure Detection
//
// Logline: Partitions networks into dense cohesive cores and sparse disconnected peripheries via Borgatti-Everett scoring.
//
// Setup: Structural optimization engine maximizing correlation between observed adjacency and ideal core-periphery matrices.
//
// Beats:
//   1. Define binary core/periphery classification vectors across N graph vertices.
//   2. Form ideal block model matrix with dense core-core, medium core-periphery, and zero periphery-periphery links.
//   3. Optimize discrete node class memberships to maximize correlation fitness.

pub type CorePeripheryResult = struct {
    num_nodes: Int,
    is_core: List[Bool],
    num_core_nodes: Int,
    fitness_score: Int, // Scaled correlation score (0..10000)
};

pub fn cp_toggle_bool(lst: List[Bool], idx: Int, val: Bool) -> List[Bool] {
    let mut result: List[Bool] = list_new();
    let n: Int = list_len(lst);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            result = list_push(result, val);
        } else {
            result = list_push(result, list_get(lst, i));
        }
        i = i + 1;
    }
    return result;
}

pub fn cp_evaluate_fitness(
    num_nodes: Int,
    is_core: List[Bool],
    adjacency_matrix: List[Int] // Flattened N x N binary matrix
) -> Int {
    let mut score: Int = 0;
    let mut u: Int = 0;
    while u < num_nodes {
        let cu: Bool = list_get(is_core, u);
        let mut v: Int = u + 1;
        while v < num_nodes {
            let cv: Bool = list_get(is_core, v);
            let idx: Int = u * num_nodes + v;
            let has_edge: Bool = list_get(adjacency_matrix, idx) > 0;

            // Ideal: core-core = 1, periphery-periphery = 0
            if cu && cv {
                if has_edge {
                    score = score + 100;
                } else {
                    score = score - 50;
                }
            } else if !cu && !cv {
                if !has_edge {
                    score = score + 100;
                } else {
                    score = score - 50;
                }
            } else {
                // core-periphery
                if has_edge {
                    score = score + 50;
                }
            }
            v = v + 1;
        }
        u = u + 1;
    }
    return score;
}

pub fn cp_detect_structure(
    num_nodes: Int,
    adjacency_matrix: List[Int],
    max_steps: Int
) -> CorePeripheryResult {
    let mut core_vec: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        // Initial state: high degree nodes as core candidates
        let mut deg: Int = 0;
        let mut j: Int = 0;
        while j < num_nodes {
            deg = deg + list_get(adjacency_matrix, i * num_nodes + j);
            j = j + 1;
        }
        core_vec = list_push(core_vec, deg >= (num_nodes / 3));
        i = i + 1;
    }

    let mut best_score: Int = cp_evaluate_fitness(num_nodes, core_vec, adjacency_matrix);
    let mut step: Int = 0;

    while step < max_steps {
        let target_node: Int = step % num_nodes;
        let cur_val: Bool = list_get(core_vec, target_node);
        let toggled: List[Bool] = cp_toggle_bool(core_vec, target_node, !cur_val);
        let test_score: Int = cp_evaluate_fitness(num_nodes, toggled, adjacency_matrix);

        if test_score > best_score {
            best_score = test_score;
            core_vec = toggled;
        }
        step = step + 1;
    }

    let mut core_count: Int = 0;
    let mut k: Int = 0;
    while k < num_nodes {
        if list_get(core_vec, k) {
            core_count = core_count + 1;
        }
        k = k + 1;
    }

    return CorePeripheryResult {
        num_nodes: num_nodes,
        is_core: core_vec,
        num_core_nodes: core_count,
        fitness_score: best_score,
    };
}
