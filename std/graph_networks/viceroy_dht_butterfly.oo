// # Viceroy Butterfly P2P Distributed Hash Table
//
// Logline: Implements Viceroy constant-degree DHT overlay with logarithmic levels and butterfly inter-level routing.
//
// Setup: Constant-degree DHT topology combining ring successors with butterfly levels achieving O(log N) lookup hops with O(1) state.
//
// Beats:
//   1. Assign nodes to levels 1..log(N) in a virtual butterfly network structure.
//   2. Maintain constant number of pointers (ring successor/predecessor, up/down level edges, cross-links).
//   3. Route messages along butterfly edges with 3-phase descent, cross-hopping, and ring finalization.

pub type ViceroyPointers = struct {
    ring_succ: Int,
    ring_pred: Int,
    level_up: Int,
    level_down_left: Int,
    level_down_right: Int
};

pub type ViceroyNode = struct {
    node_id: Int,
    position_unit: Int, // Position on ring in [0..10000)
    level: Int,         // Level 1..L
    max_levels: Int,
    pointers: ViceroyPointers
};

pub fn viceroy_create_node(node_id: Int, pos: Int, level: Int, max_levels: Int) -> ViceroyNode {
    let pt: ViceroyPointers = ViceroyPointers {
        ring_succ: node_id,
        ring_pred: node_id,
        level_up: node_id,
        level_down_left: node_id,
        level_down_right: node_id
    };
    return ViceroyNode {
        node_id: node_id,
        position_unit: pos,
        level: level,
        max_levels: max_levels,
        pointers: pt
    };
}

pub fn viceroy_dist(from_pos: Int, to_pos: Int) -> Int {
    let scale: Int = 10000;
    if to_pos >= from_pos {
        return to_pos - from_pos;
    }
    return (scale - from_pos) + to_pos;
}

pub fn viceroy_route_step(node: &ViceroyNode, target_pos: Int, phase: Int) -> Int {
    let cur_pos: Int = (node).position_unit;
    let pt: ViceroyPointers = (node).pointers;

    // Phase 1: Climb up to root level 1
    if phase == 1 {
        if (node).level == 1 {
            // Reached root, switch to Phase 2
            return (pt).level_down_left;
        }
        return (pt).level_up;
    }

    // Phase 2: Traverse down the butterfly levels toward target
    if phase == 2 {
        if (node).level == (node).max_levels {
            // Reached bottom level, switch to Phase 3 (ring traversal)
            return (pt).ring_succ;
        }

        // Branch down left or right based on target distance
        let d_left: Int = viceroy_dist(cur_pos, target_pos);
        if d_left > 5000 {
            return (pt).level_down_right;
        }
        return (pt).level_down_left;
    }

    // Phase 3: Final ring successor traversal
    return (pt).ring_succ;
}
