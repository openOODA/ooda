// # UART Hardware Ring Buffer
//
// Logline: Implements a fixed-capacity circular FIFO byte ring buffer for UART drivers, with push/pop/peek/clear primitives and explicit full/empty checks.
//
// Setup: Pure value-returning helpers, no IO. The buffer is byte-indexed (each element is an Int in 0..255). Capacity is fixed at construction. Operations are O(1) except for clear which is O(capacity).
//
// Beats:
//   1. Construct a UartRing of fixed capacity, initially empty, with head=0, tail=0, count=0.
//   2. push appends a byte at the tail and advances tail; returns Err if the ring is full.
//   3. pop removes a byte from the head and advances head; returns Err if the ring is empty.
//   4. is_empty / is_full / peek / clear expose the standard ring-buffer primitives.

import "std/result.oo";

type UartRing = struct {
    capacity: Int,
    head: Int,
    tail: Int,
    count: Int,
    data: List[Int]
};

pub fn uart_ring_new(capacity: Int) -> UartRing {
    let mut data: List[Int] = list_new();
    let mut i: Int = 0;
    while i < capacity {
        data = list_push(data, 0);
        i = i + 1;
    }
    return UartRing {
        capacity: capacity,
        head: 0,
        tail: 0,
        count: 0,
        data: data
    };
}

pub fn uart_ring_capacity(r: &UartRing) -> Int { return (r).capacity; }

pub fn uart_ring_is_empty(r: &UartRing) -> Bool { return (r).count == 0; }

pub fn uart_ring_is_full(r: &UartRing) -> Bool { return (r).count == (r).capacity; }

pub fn uart_ring_count(r: &UartRing) -> Int { return (r).count; }

pub fn uart_ring_push_byte(mut_r: &mut UartRing, byte: Int) -> Result[Void, String] {
    if uart_ring_is_full(mut_r) {
        return Err("E_UART_RING_FULL");
    }
    let cap: Int = (mut_r).capacity;
    let tail: Int = (mut_r).tail;
    let old_data: List[Int] = (mut_r).data;
    (mut_r).data = uart_ring_set_at(old_data, tail, byte);
    (mut_r).tail = (tail + 1) - ((tail + 1) / cap) * cap;
    (mut_r).count = (mut_r).count + 1;
    return Ok(());
}

pub fn uart_ring_pop_byte(mut_r: &mut UartRing) -> Result[Int, String] {
    if uart_ring_is_empty(mut_r) {
        return Err("E_UART_RING_EMPTY");
    }
    let head: Int = (mut_r).head;
    let cap: Int = (mut_r).capacity;
    let old_data: List[Int] = (mut_r).data;
    let b: Int = list_get(old_data, head);
    (mut_r).head = (head + 1) - ((head + 1) / cap) * cap;
    (mut_r).count = (mut_r).count - 1;
    return Ok(b);
}

pub fn uart_ring_peek(r: &UartRing) -> Result[Int, String] {
    if uart_ring_is_empty(r) {
        return Err("E_UART_RING_EMPTY");
    }
    let head: Int = (r).head;
    let data: List[Int] = (r).data;
    return Ok(list_get(data, head));
}

pub fn uart_ring_clear(mut_r: &mut UartRing) {
    let cap: Int = (mut_r).capacity;
    let mut data: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cap {
        data = list_push(data, 0);
        i = i + 1;
    }
    (mut_r).data = data;
    (mut_r).head = 0;
    (mut_r).tail = 0;
    (mut_r).count = 0;
}

pub fn uart_ring_set_at(data: List[Int], idx: Int, byte: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(data);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            out = list_push(out, byte);
        } else {
            out = list_push(out, list_get(data, i));
        }
        i = i + 1;
    }
    return out;
}
