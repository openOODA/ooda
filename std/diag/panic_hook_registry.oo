// # Panic Hook Callback Registry Module
//
// Logline: Unhandled panic hook registration model executing telemetry flushes upon runtime panic.
//
// Setup: Structured panic hook dispatcher model.
//
// Beats:
//   1. Construct PanicHookRegistry state.
//   2. Register custom panic hook name.
//   3. Check if panic hooks are configured.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type PanicRegistry = struct {
    hook_names: List[String],
    active: Bool
};

pub fn panic_registry_new() -> PanicRegistry {
    let hooks: List[String] = list_new();
    return PanicRegistry {
        hook_names: hooks,
        active: true
    };
}

pub fn panic_register_hook(reg: PanicRegistry, name: String) -> PanicRegistry {
    let new_hooks: List[String] = list_push(reg.hook_names, name);
    return PanicRegistry {
        hook_names: new_hooks,
        active: reg.active
    };
}

pub fn panic_has_hooks(reg: PanicRegistry) -> Bool {
    return list_len(reg.hook_names) > 0;
}
