// # Monotonic Metrics Counter Module
//
// Logline: Monotonic metrics counter tracking cumulative counts with label descriptions.
//
// Setup: Pure diagnostics metrics accumulator.
//
// Beats:
//   1. Construct MetricsCounter with metric name.
//   2. Increment counter by 1 or by positive delta.
//   3. Read current cumulative count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type MetricsCounter = struct {
    name: String,
    value: Int
};

pub fn metrics_counter_new(name: String) -> MetricsCounter {
    return MetricsCounter {
        name: name,
        value: 0
    };
}

pub fn metrics_counter_inc(c: MetricsCounter) -> MetricsCounter {
    let cur: Int = c.value;
    return MetricsCounter {
        name: c.name,
        value: cur + 1
    };
}

pub fn metrics_counter_add(c: MetricsCounter, delta: Int) -> MetricsCounter {
    if delta <= 0 { return c; }
    let cur: Int = c.value;
    return MetricsCounter {
        name: c.name,
        value: cur + delta
    };
}

pub fn metrics_counter_get(c: MetricsCounter) -> Int {
    return c.value;
}
