// # Diagnostic Counterexample State Capture & Diff Engine
//
// Logline: Dynamic variable snapshot capture and state diffing on assertion violations to isolate counterexamples.
//
// Setup: Records system state variables before and after invariant checks to automatically reconstruct failing counterexamples.
//
// Beats:
//   1. Define VariableSnapshot and CounterexampleState data structures.
//   2. Capture named variables with runtime values and type identifiers.
//   3. Compute delta between baseline pre-condition and failing post-condition snapshots.
//   4. Format structured counterexample diagnostic reports.

pub type VariableSnapshot = struct {
    var_name: String,
    var_type: String,
    var_value: String
};

pub fn variable_snapshot_new(name: String, vtype: String, val: String) -> VariableSnapshot { return VariableSnapshot {
        var_name: name,
        var_type: vtype,
        var_value: val
    }; }

pub type CounterexampleState = struct {
    assertion_name: String,
    file_loc: String,
    snapshots: List[VariableSnapshot],
    delta_notes: String
};

pub fn counterexample_capture_new(name: String, loc: String) -> CounterexampleState {
    let snaps: List[VariableSnapshot] = list_new();
    return CounterexampleState {
        assertion_name: name,
        file_loc: loc,
        snapshots: snaps,
        delta_notes: ""
    };
}

pub fn counterexample_add_var(ce: &mut CounterexampleState, name: String, vtype: String, val: String) {
    let snap: VariableSnapshot = variable_snapshot_new(name, vtype, val);
    (ce).snapshots = list_push((ce).snapshots, snap);
}

pub fn counterexample_format(ce: &CounterexampleState) -> String {
    let mut out: String = "=== COUNTEREXAMPLE CAPTURE ===
";
    out = out + "Assertion: " + (ce).assertion_name + " at " + (ce).file_loc + "
";
    out = out + "State Variables:
";
    let snaps: List[VariableSnapshot] = (ce).snapshots;
    let n: Int = list_len(snaps);
    let mut i: Int = 0;
    while i < n {
        let s: VariableSnapshot = list_get(snaps, i);
        out = out + "  - " + (s).var_name + " (" + (s).var_type + ") = " + (s).var_value + "
";
        i = i + 1;
    }
    return out;
}

pub fn counterexample_diff(pre_state: &CounterexampleState, post_state: &CounterexampleState) -> String {
    let mut out: String = "=== STATE DELTA REPORT ===
";
    let pre_snaps: List[VariableSnapshot] = (pre_state).snapshots;
    let post_snaps: List[VariableSnapshot] = (post_state).snapshots;
    let n_pre: Int = list_len(pre_snaps);
    let n_post: Int = list_len(post_snaps);
    let mut i: Int = 0;
    while i < n_post {
        let s_post: VariableSnapshot = list_get(post_snaps, i);
        let name_post: String = (s_post).var_name;
        let val_post: String = (s_post).var_value;
        let mut found: Bool = false;
        let mut j: Int = 0;
        while j < n_pre {
            let s_pre: VariableSnapshot = list_get(pre_snaps, j);
            let name_pre: String = (s_pre).var_name;
            let val_pre: String = (s_pre).var_value;
            if name_pre == name_post {
                found = true;
                if !(val_pre == val_post) {
                    out = out + "  MUTATION: " + name_post + " changed: " + val_pre + " -> " + val_post + "
";
                }
            }
            j = j + 1;
        }
        if !found {
            out = out + "  NEW: " + name_post + " = " + val_post + "
";
        }
        i = i + 1;
    }
    return out;
}

pub fn counterexample_capture_probe() -> Int {
    let mut ce: CounterexampleState = counterexample_capture_new("check_bounds", "main.oo:42");
    counterexample_add_var(&mut ce, "index", "Int", "99");
    let rep: String = counterexample_format(&ce);
    return rep.len();
}
