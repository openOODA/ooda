// # Call Stack Backtrace Frame Symbolication Stub Module
//
// Logline: Stack backtrace frame extractor formatting function names, source files, and line numbers under SysCap.
//
// Setup: Structured stack unwinder model.
//
// Beats:
//   1. Define BacktraceFrame descriptor structure.
//   2. Format frame string (function name at file:line).
//   3. Capture synthetic stack trace.
// RULES.oot 1.4: Default-deny for stack inspection. Explicit &SysCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: backtrace / libunwind lowers via host libc.

import "std/str.oo";
import "std/text/format.oo";

type StackFrame = struct {
    fn_name: String,
    file_path: String,
    line_num: Int
};

pub fn stack_frame_new(fn_name: String, file_path: String, line: Int) -> StackFrame {
    return StackFrame {
        fn_name: fn_name,
        file_path: file_path,
        line_num: line
    };
}

pub fn stack_frame_format(frame: StackFrame) -> String {
    let fn_n: String = frame.fn_name;
    let fp: String = frame.file_path;
    let ln: Int = frame.line_num;
    let l_str: String = format_int_to_hex(ln);
    return fn_n + " at " + fp + ":" + l_str;
}
