// # Telemetry Metric and Trace Sink Module
//
// Logline: Buffered telemetry export sink batching metrics and trace spans for asynchronous transport.
//
// Setup: Pure telemetry event buffer.
//
// Beats:
//   1. Construct TelemetrySink with buffer capacity.
//   2. Buffer telemetry event strings.
//   3. Flush telemetry buffer.
//   4. Query buffered event count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type TelemetrySink = struct {
    events: List[String],
    capacity: Int
};

pub fn telemetry_sink_new(capacity: Int) -> TelemetrySink {
    let ev: List[String] = list_new();
    let mut cap: Int = capacity;
    if cap < 1 { cap = 1; }
    return TelemetrySink {
        events: ev,
        capacity: cap
    };
}

pub fn telemetry_sink_push(sink: TelemetrySink, event: String) -> TelemetrySink {
    let cur_cnt: Int = list_len(sink.events);
    let max_cap: Int = sink.capacity;
    if cur_cnt >= max_cap {
        return sink;
    }
    let new_ev: List[String] = list_push(sink.events, event);
    return TelemetrySink {
        events: new_ev,
        capacity: max_cap
    };
}

pub fn telemetry_sink_len(sink: TelemetrySink) -> Int {
    return list_len(sink.events);
}
