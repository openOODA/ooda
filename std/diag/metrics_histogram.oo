// # Metrics Histogram Distribution Module
//
// Logline: Metrics histogram tracking sample counts, sum, min, max, and bucket distributions.
//
// Setup: Pure diagnostics metrics distribution.
//
// Beats:
//   1. Construct MetricsHistogram with metric name.
//   2. Record numerical observations.
//   3. Compute sample average and sum.
//   4. Query total observation count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type MetricsHist = struct {
    name: String,
    count: Int,
    sum_val: Int,
    min_val: Int,
    max_val: Int
};

pub fn metrics_hist_new(name: String) -> MetricsHist {
    return MetricsHist {
        name: name,
        count: 0,
        sum_val: 0,
        min_val: 2147483647,
        max_val: -2147483648
    };
}

pub fn metrics_hist_record(h: MetricsHist, val: Int) -> MetricsHist {
    let cur_c: Int = h.count;
    let cur_sum: Int = h.sum_val;
    let mut mn: Int = h.min_val;
    let mut mx: Int = h.max_val;
    if val < mn { mn = val; }
    if val > mx { mx = val; }
    return MetricsHist {
        name: h.name,
        count: cur_c + 1,
        sum_val: cur_sum + val,
        min_val: mn,
        max_val: mx
    };
}

pub fn metrics_hist_count(h: MetricsHist) -> Int {
    return h.count;
}

pub fn metrics_hist_mean(h: MetricsHist) -> Int {
    let c: Int = h.count;
    if c == 0 { return 0; }
    let s: Int = h.sum_val;
    return s / c;
}
