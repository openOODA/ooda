// # Service Health Check Registry Module
//
// Logline: Service health check coordinator aggregating readiness and liveness status of sub-components.
//
// Setup: Pure diagnostics health aggregation module.
//
// Beats:
//   1. Construct HealthRegistry with overall status.
//   2. Register healthy / unhealthy component reports.
//   3. Evaluate composite health: All components must be healthy.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type HealthRegistry = struct {
    component_names: List[String],
    is_all_healthy: Bool
};

pub fn health_registry_new() -> HealthRegistry {
    let comps: List[String] = list_new();
    return HealthRegistry {
        component_names: comps,
        is_all_healthy: true
    };
}

pub fn health_report_ok(reg: HealthRegistry, comp_name: String) -> HealthRegistry {
    let new_comps: List[String] = list_push(reg.component_names, comp_name);
    return HealthRegistry {
        component_names: new_comps,
        is_all_healthy: reg.is_all_healthy
    };
}

pub fn health_report_failed(reg: HealthRegistry, comp_name: String) -> HealthRegistry {
    let new_comps: List[String] = list_push(reg.component_names, comp_name);
    return HealthRegistry {
        component_names: new_comps,
        is_all_healthy: false
    };
}

pub fn health_is_healthy(reg: HealthRegistry) -> Bool {
    return reg.is_all_healthy;
}
