// # Sovereign Diagnostic & Invariant Tracing Engine Facade
//
// Logline: Unified export facade for execution spans, breadcrumb visual trees, AI NDJSON telemetry, counterexample capture, and invariant evaluation.
//
// Setup: Zero-trust diagnostic engine re-exporting all diagnostic and formal verification subsystems.
//
// Beats:
//   1. Import trace span execution records and circular ring buffers.
//   2. Import human-readable visual breadcrumb tree formatters.
//   3. Import AI telemetry single-line NDJSON formatters with ANSI sanitization.
//   4. Import dynamic counterexample state capture and formal invariant evaluators.

import "./trace_span.oo";
import "./breadcrumb_tree.oo";
import "./telemetry_ndjson.oo";
import "./counterexample_capture.oo";
import "./invariant_eval.oo";

pub fn diag_suite_probe() -> Int {
    let p1: Int = trace_span_probe();
    let p2: Int = breadcrumb_tree_probe();
    let p3: Int = telemetry_ndjson_probe();
    let p4: Int = counterexample_capture_probe();
    let p5: Int = invariant_eval_probe();
    return p1 + p2 + p3 + p4 + p5;
}
