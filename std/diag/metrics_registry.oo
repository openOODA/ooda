// # Metrics Registry Diagnostics Module
//
// Logline: Metric instrumentation registry for Counters, Gauges, and Prometheus text export format.
//
// Setup: Coordinates in-memory metrics recording, counter increments, gauge updates, and Prometheus exposition.
//
// Beats:
//   1. Initialize empty MetricsRegistry.
//   2. Record and increment Counter metric entries.
//   3. Record and set Gauge metric entries.
//   4. Export registry metrics in standard Prometheus exposition text format.
// RULES.oot 1.4: Pure metrics registry module, zero ambient side effects.
// RULES.oot 1.7: Under 256 lines.

type MetricsRegistry = struct {
    entries: List[String],
    count: Int
};

// Create a new empty MetricsRegistry.
pub fn registry_new() -> MetricsRegistry {
    let e_list: List[String] = list_new();
    return MetricsRegistry {
        entries: e_list,
        count: 0
    };
}

// Return number of metric records in the registry.
pub fn registry_len(reg: MetricsRegistry) -> Int {
    return reg.count;
}

// True if registry has no recorded metrics.
pub fn registry_is_empty(reg: MetricsRegistry) -> Bool {
    return reg.count == 0;
}

// Increment counter metric by delta.
pub fn registry_counter_inc(
    reg: MetricsRegistry,
    name: String,
    delta: Int
) -> MetricsRegistry {
    let d_str: String = delta.to_string();
    let entry: String = "# TYPE " + name + " counter\n" + name + " " + d_str;
    let new_entries: List[String] = list_push(reg.entries, entry);
    let c: Int = reg.count;
    let next_c: Int = c + 1;
    return MetricsRegistry {
        entries: new_entries,
        count: next_c
    };
}

// Set gauge metric to value.
pub fn registry_gauge_set(
    reg: MetricsRegistry,
    name: String,
    val: Int
) -> MetricsRegistry {
    let v_str: String = val.to_string();
    let entry: String = "# TYPE " + name + " gauge\n" + name + " " + v_str;
    let new_entries: List[String] = list_push(reg.entries, entry);
    let c: Int = reg.count;
    let next_c: Int = c + 1;
    return MetricsRegistry {
        entries: new_entries,
        count: next_c
    };
}

// Export all recorded metrics as Prometheus text exposition string.
pub fn registry_format_prometheus(reg: MetricsRegistry) -> String {
    let n: Int = reg.count;
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let entry: String = list_get(reg.entries, i);
        out = out + entry + "\n";
        i = i + 1;
    }
    return out;
}
