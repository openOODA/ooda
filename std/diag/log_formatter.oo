// # Log Formatter Diagnostics Module
//
// Logline: Log record formatting engines for Text, JSON, Logfmt, and ANSI terminal output.
//
// Setup: Pure string transformation module converting LogRecord structures into standard log formats.
//
// Beats:
//   1. Construct LogRecord with level, message, target, and timestamp.
//   2. Format records into plaintext log lines.
//   3. Format records into structured JSON objects.
//   4. Format records into key-value Logfmt strings.
// RULES.oot 1.4: Pure string formatting module, zero ambient side effects.
// RULES.oot 1.7: Under 256 lines.

type LogRecord = struct {
    level: String,
    message: String,
    target: String,
    timestamp_ms: Int
};

// Create a new LogRecord descriptor.
pub fn record_new(
    level: String,
    msg: String,
    target: String,
    ts_ms: Int
) -> LogRecord {
    return LogRecord {
        level: level,
        message: msg,
        target: target,
        timestamp_ms: ts_ms
    };
}

// Format record as human-readable plaintext string.
pub fn format_text(rec: LogRecord) -> String {
    let ts: Int = rec.timestamp_ms;
    let ts_str: String = ts.to_string();
    let lvl: String = rec.level;
    let tgt: String = rec.target;
    let msg: String = rec.message;
    return ts_str + " [" + lvl + "] " + tgt + ": " + msg;
}

// Format record as structured JSON object.
pub fn format_json(rec: LogRecord) -> String {
    let ts: Int = rec.timestamp_ms;
    let ts_str: String = ts.to_string();
    let lvl: String = rec.level;
    let tgt: String = rec.target;
    let msg: String = rec.message;
    return "{\"ts\":" + ts_str + ",\"level\":\"" + lvl + "\",\"target\":\"" + tgt + "\",\"msg\":\"" + msg + "\"}";
}

// Format record as standard Logfmt key-value pairs.
pub fn format_logfmt(rec: LogRecord) -> String {
    let ts: Int = rec.timestamp_ms;
    let ts_str: String = ts.to_string();
    let lvl: String = rec.level;
    let tgt: String = rec.target;
    let msg: String = rec.message;
    return "ts=" + ts_str + " level=" + lvl + " target=" + tgt + " msg=\"" + msg + "\"";
}

// Format record with ANSI color escapes based on log level.
pub fn format_ansi(rec: LogRecord) -> String {
    let lvl: String = rec.level;
    let mut color: String = "\x1b[37m";
    if lvl == "ERROR" || lvl == "FATAL" {
        color = "\x1b[31m";
    }
    if lvl == "WARN" {
        color = "\x1b[33m";
    }
    if lvl == "INFO" {
        color = "\x1b[32m";
    }
    if lvl == "DEBUG" || lvl == "TRACE" {
        color = "\x1b[36m";
    }
    let reset: String = "\x1b[0m";
    let formatted: String = format_text(rec);
    return color + formatted + reset;
}
