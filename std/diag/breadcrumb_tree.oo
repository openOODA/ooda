// # Diagnostic Human Visual Breadcrumb Tree
//
// Logline: ASCII and ANSI hierarchy formatter rendering trace spans, execution trees, and status highlights.
//
// Setup: Human-readable diagnostic visualization displaying hierarchical execution flows and timings.
//
// Beats:
//   1. Generate tree branch indentations based on span depth.
//   2. Format status badges (OK, FAIL, RUN) with ANSI styling.
//   3. Render execution duration and memory footprint per span node.
//   4. Assemble comprehensive visual trace tree string.

import "./trace_span.oo";

fn make_indent(depth: Int) -> String {
    let mut out: String = "";
    let mut i: Int = 0;
    while i < depth {
        out = out + "  ";
        i = i + 1;
    }
    return out;
}

pub fn breadcrumb_status_badge(status: Int) -> String {
    if status == 1 {
        return "\x1b[32m[PASS]\x1b[0m";
    }
    if status == 2 {
        return "\x1b[31m[FAIL]\x1b[0m";
    }
    return "\x1b[33m[RUN]\x1b[0m";
}

pub fn breadcrumb_format_span(span: &TraceSpan) -> String {
    let indent: String = make_indent((span).depth);
    let badge: String = breadcrumb_status_badge((span).status);
    let dur: Int = trace_span_duration(span);
    let mut line: String = indent + "+- " + (span).name + " " + badge;
    line = line + " (" + dur.to_string() + "ms, " + (span).memory_bytes.to_string() + "B)";
    return line;
}

pub fn breadcrumb_tree_render(spans: List[TraceSpan]) -> String {
    let n: Int = list_len(spans);
    let mut out: String = "=== Sovereign Diagnostic Trace Tree ===\n";
    let mut i: Int = 0;
    while i < n {
        let span: TraceSpan = list_get(spans, i);
        let line: String = breadcrumb_format_span(&span);
        out = out + line + "\n";
        i = i + 1;
    }
    return out;
}

pub fn breadcrumb_tree_probe() -> Int {
    let mut s: TraceSpan = trace_span_new(1, "root", 0, 0, 100);
    trace_span_finish(&mut s, 150, 1, 1024);
    let line: String = breadcrumb_format_span(&s);
    return line.len() + trace_span_probe();
}
