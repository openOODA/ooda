// # Structured Logger Module
//
// Logline: Leveled logging (TRACE, DEBUG, INFO, WARN, ERROR, FATAL) and message routing under TimeCap.
//
// Setup: Bridges standard severity thresholds with timestamped message emission under TimeCap.
//
// Beats:
//   1. Define standard log level severities (TRACE: 10, DEBUG: 20, INFO: 30, WARN: 40, ERROR: 50, FATAL: 60).
//   2. Construct Logger with minimum severity threshold and target destination.
//   3. Check should_emit severity filter.
//   4. Format and emit structured log lines with monotonic timestamp under TimeCap.
// RULES.oot 1.4: Default-deny for time-stamped logging. Explicit &TimeCap required.
// RULES.oot 1.7: Under 256 lines.

type Logger = struct {
    min_severity: Int,
    target: String,
    include_timestamp: Bool
};

// TRACE severity level (10).
pub fn log_level_trace() -> Int {
    return 10;
}

// DEBUG severity level (20).
pub fn log_level_debug() -> Int {
    return 20;
}

// INFO severity level (30).
pub fn log_level_info() -> Int {
    return 30;
}

// WARN severity level (40).
pub fn log_level_warn() -> Int {
    return 40;
}

// ERROR severity level (50).
pub fn log_level_error() -> Int {
    return 50;
}

// FATAL severity level (60).
pub fn log_level_fatal() -> Int {
    return 60;
}

// Map severity number to level name.
pub fn log_level_name(sev: Int) -> String {
    if sev <= 10 { return "TRACE"; }
    if sev <= 20 { return "DEBUG"; }
    if sev <= 30 { return "INFO"; }
    if sev <= 40 { return "WARN"; }
    if sev <= 50 { return "ERROR"; }
    return "FATAL";
}

// Create a new Logger with minimum severity threshold and output target.
pub fn logger_new(min_level: Int, target: String) -> Logger {
    return Logger {
        min_severity: min_level,
        target: target,
        include_timestamp: true
    };
}

// Check if message at given severity should be emitted.
pub fn log_should_emit(logger: Logger, level: Int) -> Bool {
    let min_s: Int = logger.min_severity;
    return level >= min_s;
}

// Format and emit log line under TimeCap.
pub fn log_emit(
    time_cap: &TimeCap,
    logger: Logger,
    level: Int,
    msg: String
) -> String {
    let should: Bool = log_should_emit(logger, level);
    if should == false {
        return "";
    }
    let lvl_name: String = log_level_name(level);
    let now: Int = now_ms(time_cap);
    let now_str: String = now.to_string();
    let tgt: String = logger.target;
    return "[" + now_str + " ms] [" + lvl_name + "] [" + tgt + "] " + msg;
}
