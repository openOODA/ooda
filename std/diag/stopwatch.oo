// # Stopwatch Execution Timer Module
//
// Logline: High-precision monotonic execution timer, lap interval recording, and split measurements under TimeCap.
//
// Setup: Coordinates monotonic delta calculations and split intervals under explicit TimeCap.
//
// Beats:
//   1. Start stopwatch and capture initial timestamp under TimeCap.
//   2. Record lap split intervals under TimeCap.
//   3. Stop stopwatch and calculate total elapsed time under TimeCap.
//   4. Reset stopwatch and query running state and lap counts.
// RULES.oot 1.4: Default-deny for timing effects. Explicit &TimeCap required.
// RULES.oot 1.7: Under 256 lines.

type Stopwatch = struct {
    start_ms: Int,
    stop_ms: Int,
    is_running: Bool,
    laps: List[Int],
    lap_count: Int
};

// Start a new stopwatch timer under TimeCap.
pub fn stopwatch_start(time_cap: &TimeCap) -> Stopwatch {
    let now: Int = now_ms(time_cap);
    let l_list: List[Int] = list_new();
    return Stopwatch {
        start_ms: now,
        stop_ms: 0,
        is_running: true,
        laps: l_list,
        lap_count: 0
    };
}

// Stop the stopwatch timer under TimeCap.
pub fn stopwatch_stop(time_cap: &TimeCap, sw: Stopwatch) -> Stopwatch {
    let now: Int = now_ms(time_cap);
    return Stopwatch {
        start_ms: sw.start_ms,
        stop_ms: now,
        is_running: false,
        laps: sw.laps,
        lap_count: sw.lap_count
    };
}

// Calculate elapsed milliseconds from start.
pub fn stopwatch_elapsed_ms(time_cap: &TimeCap, sw: Stopwatch) -> Int {
    let run: Bool = sw.is_running;
    let s: Int = sw.start_ms;
    if run == true {
        let now: Int = now_ms(time_cap);
        if now < s { return 0; }
        return now - s;
    }
    let st: Int = sw.stop_ms;
    if st < s { return 0; }
    return st - s;
}

// Record a lap split timestamp under TimeCap.
pub fn stopwatch_lap(time_cap: &TimeCap, sw: Stopwatch) -> Stopwatch {
    let elapsed: Int = stopwatch_elapsed_ms(time_cap, sw);
    let new_laps: List[Int] = list_push(sw.laps, elapsed);
    let lc: Int = sw.lap_count;
    let next_lc: Int = lc + 1;
    return Stopwatch {
        start_ms: sw.start_ms,
        stop_ms: sw.stop_ms,
        is_running: sw.is_running,
        laps: new_laps,
        lap_count: next_lc
    };
}

// Return number of recorded lap splits.
pub fn stopwatch_lap_count(sw: Stopwatch) -> Int {
    return sw.lap_count;
}

// Reset stopwatch to clean initial state under TimeCap.
pub fn stopwatch_reset(time_cap: &TimeCap) -> Stopwatch {
    let now: Int = now_ms(time_cap);
    let l_list: List[Int] = list_new();
    return Stopwatch {
        start_ms: now,
        stop_ms: 0,
        is_running: false,
        laps: l_list,
        lap_count: 0
    };
}

// True if stopwatch is currently running.
pub fn stopwatch_is_running(sw: Stopwatch) -> Bool {
    return sw.is_running;
}

pub fn stopwatch_probe() -> Int {
    return 0;
}
