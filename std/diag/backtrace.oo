// # Stack Backtrace Diagnostics Module
//
// Logline: Execution stack frames, symbolication descriptors, and backtrace dumping under TimeCap.
//
// Setup: Bridges runtime stack frames with structured call-chain diagnostics.
//
// Beats:
//   1. Construct StackFrame with depth, function name, source file, and line number.
//   2. Format stack frame into human-readable representation ("#<depth> <fn> at <file>:<line>").
//   3. Capture and initialize Backtrace record under TimeCap.
//   4. Dump multi-line backtrace dump string.
// RULES.oot 1.4: Default-deny for time-stamped diagnostics. Explicit &TimeCap required.
// RULES.oot 1.7: Under 256 lines.

type StackFrame = struct {
    depth: Int,
    function_name: String,
    file_name: String,
    line_number: Int
};

type Backtrace = struct {
    frames: List[String],
    total_frames: Int,
    timestamp_ms: Int
};

// Create a new StackFrame descriptor.
pub fn frame_new(
    depth: Int,
    fn_name: String,
    file: String,
    line: Int
) -> StackFrame {
    return StackFrame {
        depth: depth,
        function_name: fn_name,
        file_name: file,
        line_number: line
    };
}

// Format a single StackFrame as "#0 main at main.oo:42".
pub fn frame_format(f: StackFrame) -> String {
    let d: Int = f.depth;
    let d_str: String = d.to_string();
    let l: Int = f.line_number;
    let l_str: String = l.to_string();
    let fn_n: String = f.function_name;
    let file_n: String = f.file_name;
    return "#" + d_str + " " + fn_n + " at " + file_n + ":" + l_str;
}

// Capture / create a new Backtrace under TimeCap.
pub fn backtrace_new(time_cap: &TimeCap) -> Backtrace {
    let now: Int = now_ms(time_cap);
    let f_list: List[String] = list_new();
    return Backtrace {
        frames: f_list,
        total_frames: 0,
        timestamp_ms: now
    };
}

// Add formatted frame string to backtrace.
pub fn backtrace_add_frame(bt: Backtrace, frame_str: String) -> Backtrace {
    let new_frames: List[String] = list_push(bt.frames, frame_str);
    let tf: Int = bt.total_frames;
    let next_tf: Int = tf + 1;
    return Backtrace {
        frames: new_frames,
        total_frames: next_tf,
        timestamp_ms: bt.timestamp_ms
    };
}

// Return number of frames in the backtrace.
pub fn backtrace_depth(bt: Backtrace) -> Int {
    return bt.total_frames;
}

// Dump formatted multi-line stack trace string.
pub fn backtrace_dump(bt: Backtrace) -> String {
    let n: Int = bt.total_frames;
    let ts: Int = bt.timestamp_ms;
    let ts_str: String = ts.to_string();
    let mut out: String = "=== Backtrace at " + ts_str + " ms ===\n";
    let mut i: Int = 0;
    while i < n {
        let f: String = list_get(bt.frames, i);
        out = out + f + "\n";
        i = i + 1;
    }
    return out;
}
