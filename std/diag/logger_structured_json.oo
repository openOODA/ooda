// # Structured JSON Log Formatter Module
//
// Logline: Structured JSON log formatter emitting level, timestamp, message, and target key-value pairs.
//
// Setup: Pure JSON log line formatter.
//
// Beats:
//   1. Format structured log entry into single-line JSON string.
//   2. Support log levels (DEBUG, INFO, WARN, ERROR).
//   3. Escape quotes within log message.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

pub fn log_json_format(level: String, msg: String, target: String) -> String {
    let clean_msg: String = str_replace(msg, "\"", "\\\"");
    return "{\"level\":\"" + level + "\",\"target\":\"" + target + "\",\"message\":\"" + clean_msg + "\"}";
}

pub fn log_json_info(msg: String) -> String {
    return log_json_format("INFO", msg, "app");
}

pub fn log_json_error(msg: String) -> String {
    return log_json_format("ERROR", msg, "app");
}
