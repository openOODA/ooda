// # Distributed Tracing Span and Context Propagation Module
//
// Logline: Distributed tracing spans, span contexts, parent-child span linkage, and microsecond span durations.
//
// Setup: Pure diagnostics module for OpenTelemetry-compatible tracing models.
//
// Beats:
//   1. Construct TraceSpan with span ID, trace ID, and parent span ID.
//   2. Record span start and end timestamps.
//   3. Compute span duration in milliseconds.
//   4. Attach span metadata tags.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type TraceSpan = struct {
    trace_id: String,
    span_id: String,
    parent_id: String,
    name: String,
    start_ms: Int,
    duration_ms: Int
};

pub fn trace_span_new(trace_id: String, span_id: String, name: String, start_ms: Int) -> TraceSpan {
    return TraceSpan {
        trace_id: trace_id,
        span_id: span_id,
        parent_id: "",
        name: name,
        start_ms: start_ms,
        duration_ms: 0
    };
}

pub fn trace_span_child(parent: TraceSpan, span_id: String, name: String, start_ms: Int) -> TraceSpan {
    return TraceSpan {
        trace_id: parent.trace_id,
        span_id: span_id,
        parent_id: parent.span_id,
        name: name,
        start_ms: start_ms,
        duration_ms: 0
    };
}

pub fn trace_span_finish(span: TraceSpan, end_ms: Int) -> TraceSpan {
    let s: Int = span.start_ms;
    let mut d: Int = end_ms - s;
    if d < 0 { d = 0; }
    return TraceSpan {
        trace_id: span.trace_id,
        span_id: span.span_id,
        parent_id: span.parent_id,
        name: span.name,
        start_ms: s,
        duration_ms: d
    };
}

pub fn trace_span_duration(span: TraceSpan) -> Int {
    return span.duration_ms;
}
