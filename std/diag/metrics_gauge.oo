// # Variable Metrics Gauge Module
//
// Logline: Metrics gauge supporting instantaneous value setting, increments, and decrements.
//
// Setup: Pure diagnostics metrics gauge.
//
// Beats:
//   1. Construct MetricsGauge with initial value.
//   2. Set instantaneous gauge reading.
//   3. Increment and decrement gauge values.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type MetricsGauge = struct {
    name: String,
    value: Int
};

pub fn metrics_gauge_new(name: String, initial: Int) -> MetricsGauge {
    return MetricsGauge {
        name: name,
        value: initial
    };
}

pub fn metrics_gauge_set(g: MetricsGauge, val: Int) -> MetricsGauge {
    return MetricsGauge {
        name: g.name,
        value: val
    };
}

pub fn metrics_gauge_inc(g: MetricsGauge) -> MetricsGauge {
    let cur: Int = g.value;
    return MetricsGauge {
        name: g.name,
        value: cur + 1
    };
}

pub fn metrics_gauge_dec(g: MetricsGauge) -> MetricsGauge {
    let cur: Int = g.value;
    return MetricsGauge {
        name: g.name,
        value: cur - 1
    };
}

pub fn metrics_gauge_get(g: MetricsGauge) -> Int {
    return g.value;
}
