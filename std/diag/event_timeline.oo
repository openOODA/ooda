// # Diagnostic Event Recording Timeline Module
//
// Logline: Chronologically ordered diagnostic event sequence recorder for debugging and audit trails.
//
// Setup: Pure diagnostic event recording timeline.
//
// Beats:
//   1. Construct EventTimeline with capacity limit.
//   2. Append timestamped event tag.
//   3. Query total recorded events.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type EventTimeline = struct {
    events: List[String],
    capacity: Int
};

pub fn event_timeline_new(capacity: Int) -> EventTimeline {
    let ev: List[String] = list_new();
    let mut cap: Int = capacity;
    if cap < 1 { cap = 1; }
    return EventTimeline {
        events: ev,
        capacity: cap
    };
}

pub fn event_timeline_record(t: EventTimeline, event_name: String) -> EventTimeline {
    let cur_cnt: Int = list_len(t.events);
    let max_cap: Int = t.capacity;
    if cur_cnt >= max_cap {
        return t;
    }
    let new_ev: List[String] = list_push(t.events, event_name);
    return EventTimeline {
        events: new_ev,
        capacity: max_cap
    };
}

pub fn event_timeline_count(t: EventTimeline) -> Int {
    return list_len(t.events);
}
