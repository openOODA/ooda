// # JIT Stack Frame Layout Manager
//
// Logline: Stack frame layout calculations, spill slot allocation, callee-saved register offsets, and 16-byte alignment.
//
// Setup: Generates prologue and epilogue stack offsets ensuring strict ABI compliance and frame pointer preservation.
//
// Beats:
//   1. Define JitFrameLayout structure.
//   2. Calculate callee-save restore areas and spill slot byte offsets.
//   3. Enforce 16-byte stack pointer alignment.

pub type JitFrameLayout = struct {
    num_callee_saved_regs: Int,
    callee_save_area_size: Int,
    num_spill_slots: Int,
    spill_area_size: Int,
    outgoing_args_size: Int,
    total_frame_size_bytes: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn jit_frame_layout_calculate(callee_regs: Int, spill_slots: Int, outgoing_args: Int) -> JitFrameLayout {
    let callee_sz: Int = callee_regs * 8;
    let spill_sz: Int = spill_slots * 8;
    let raw_total: Int = callee_sz + spill_sz + outgoing_args + 8; // +8 for saved RBP / FP
    
    // Align total frame size to 16 bytes
    let rem: Int = raw_total % 16;
    let mut aligned_total: Int = raw_total;
    if rem != 0 {
        aligned_total = raw_total + (16 - rem);
    }
    
    return JitFrameLayout {
        num_callee_saved_regs: callee_regs,
        callee_save_area_size: callee_sz,
        num_spill_slots: spill_slots,
        spill_area_size: spill_sz,
        outgoing_args_size: outgoing_args,
        total_frame_size_bytes: aligned_total,
    };
}

pub fn jit_frame_get_spill_offset(layout: JitFrameLayout, slot_idx: Int) -> Int {
    // Spill offsets are indexed from the top of the spill area
    let base: Int = (layout).callee_save_area_size + 8;
    return base + (slot_idx * 8);
}
