// # WebAssembly GC I31 Unboxed Integer Operations
//
// Logline: Unboxed 31-bit tagged scalar integer arithmetic, encoding, decoding, and sign extension.
//
// Setup: Implements ref.i31, i31.get_s, and i31.get_u using lowest-31-bit wrap.
//
// Beats:
//   1. Encode raw integers into 31-bit tagged values.
//   2. Signed extract: bit 30 set means value - 2^31.
//   3. Unsigned extract returns the raw 31-bit magnitude.
// residual: pub type destubbed; algorithm kept.

type I31Ref = struct {
    raw_bits: Int,
    is_valid: Int
};

pub fn i31_max_signed() -> Int {
    return 1073741823;
}

pub fn i31_min_signed() -> Int {
    return 0 - 1073741824;
}

pub fn i31_max_unsigned() -> Int {
    return 2147483647;
}

pub fn ref_i31(val: Int) -> I31Ref {
    let modulus: Int = 2147483648;
    let mut bits: Int = val % modulus;
    if bits < 0 {
        bits = bits + modulus;
    }
    return I31Ref {
        raw_bits: bits,
        is_valid: 1
    };
}

pub fn i31_get_s(ref_val: I31Ref) -> Int {
    if ref_val.is_valid == 0 {
        return 0;
    }
    let raw: Int = ref_val.raw_bits;
    if raw >= 1073741824 {
        return raw - 2147483648;
    }
    return raw;
}

pub fn i31_get_u(ref_val: I31Ref) -> Int {
    if ref_val.is_valid == 0 {
        return 0;
    }
    return ref_val.raw_bits;
}

pub fn i31_add(a: I31Ref, b: I31Ref) -> I31Ref {
    let sum: Int = i31_get_s(a) + i31_get_s(b);
    return ref_i31(sum);
}

pub fn i31_sub(a: I31Ref, b: I31Ref) -> I31Ref {
    let diff: Int = i31_get_s(a) - i31_get_s(b);
    return ref_i31(diff);
}
