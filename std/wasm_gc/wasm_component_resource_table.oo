// # WebAssembly Component Model Resource Table
//
// Logline: Handle-based lifecycle management and dynamic index mapping for Component Model resources.
//
// Setup: Tracks opaque integer handles mapped to underlying host or guest representation pointers.
//
// Beats:
//   1. Define ResourceEntry and ResourceTable structures.
//   2. Allocate fresh handles via resource.new.
//   3. Implement resource.rep lookup and resource.drop destruction.

pub type ResourceEntry = struct {
    handle_id: Int,
    representation_pointer: Int,
    type_id: Int,
    is_borrow: Int, // 1: borrow, 0: own
    is_alive: Int
};

pub type ResourceTable = struct {
    entries: List[ResourceEntry],
    entry_count: Int,
    next_handle_id: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn resource_entry_new(handle: Int, rep: Int, t_id: Int, is_borrow: Int) -> ResourceEntry {
    return ResourceEntry {
        handle_id: handle,
        representation_pointer: rep,
        type_id: t_id,
        is_borrow: is_borrow,
        is_alive: 1
    };
}

pub fn resource_table_new() -> ResourceTable {
    let empty_entries: List[ResourceEntry] = list_new();
    return ResourceTable {
        entries: empty_entries,
        entry_count: 0,
        next_handle_id: 1
    };
}

// -------------------------------------------------------------------
// Resource Lifecycle Operations
// -------------------------------------------------------------------

pub fn resource_table_new_entry(mut table: ResourceTable, rep: Int, t_id: Int, is_borrow: Int) -> ResourceTable {
    let handle: Int = (table).next_handle_id;
    let entry: ResourceEntry = resource_entry_new(handle, rep, t_id, is_borrow);
    let mut es: List[ResourceEntry] = (table).entries;
    es = list_push(es, entry);
    table.entries = es;
    table.entry_count = (table).entry_count + 1;
    table.next_handle_id = handle + 1;
    return table;
}

pub fn resource_table_rep(table: ResourceTable, handle: Int) -> Int {
    let mut i: Int = 0;
    let count: Int = (table).entry_count;
    while i < count {
        let entry: ResourceEntry = list_get((table).entries, i);
        if (entry).handle_id == handle && (entry).is_alive == 1 {
            return (entry).representation_pointer;
        }
        i = i + 1;
    }
    return -1;
}

pub fn resource_table_drop(mut table: ResourceTable, handle: Int) -> ResourceTable {
    let mut new_entries: List[ResourceEntry] = list_new();
    let mut i: Int = 0;
    let count: Int = (table).entry_count;
    while i < count {
        let entry: ResourceEntry = list_get((table).entries, i);
        if (entry).handle_id == handle {
            let dropped: ResourceEntry = ResourceEntry {
                handle_id: (entry).handle_id,
                representation_pointer: 0,
                type_id: (entry).type_id,
                is_borrow: (entry).is_borrow,
                is_alive: 0
            };
            new_entries = list_push(new_entries, dropped);
        } else {
            new_entries = list_push(new_entries, entry);
        }
        i = i + 1;
    }
    table.entries = new_entries;
    return table;
}
