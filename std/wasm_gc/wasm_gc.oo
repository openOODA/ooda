pub fn wasm_gc_version() -> String {
    return "openOODA-Wasm-GC-JIT-v2.0";
}

pub fn wasm_gc_create_sample_hierarchy() -> TypeHierarchy {
    return generate_sample_type_hierarchy();
}

pub fn wasm_gc_create_type_checker(hier: TypeHierarchy) -> GcTypeChecker {
    return gc_type_checker_new(hier);
}

pub fn wasm_gc_create_resource_table() -> ResourceTable {
    return resource_table_new();
}

pub fn wasm_gc_create_jit_builder(func_name: String) -> JirBuilder {
    return jir_builder_new(func_name);
}

pub fn wasm_gc_create_generational_heap(nursery_sz: Int, tenured_sz: Int) -> GenerationalHeap {
    return generational_heap_new(nursery_sz, tenured_sz);
}

pub fn wasm_gc_create_mark_sweep_collector() -> MarkSweepCollector {
    return mark_sweep_collector_new();
}

pub fn wasm_gc_create_linear_scan_alloc(num_regs: Int) -> LinearScanAlloc {
    return linear_scan_alloc_new(num_regs);
}
