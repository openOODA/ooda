// # WebAssembly GC Ref Equality Engine
//
// Logline: Reference identity comparison, null detection, and equality semantics for GC references.
//
// Setup: Implements ref.eq and ref.is_null operations comparing object identity and unboxed i31 values.
//
// Beats:
//   1. Compare two GcRefValue handles for reference identity.
//   2. Check null status of references (ref.is_null).
//   3. Handle i31 vs heap instance reference inequality.

import "./wasm_gc_ref_test.oo";

// -------------------------------------------------------------------
// Equality and Null Inspection
// -------------------------------------------------------------------

pub fn gc_ref_is_null(ref_val: GcRefValue) -> Bool {
    return (ref_val).is_null == 1;
}

pub fn gc_ref_eq(a: GcRefValue, b: GcRefValue) -> Bool {
    // Both null: considered equal
    if (a).is_null == 1 && (b).is_null == 1 {
        return true;
    }
    // One null, one not null: not equal
    if (a).is_null == 1 || (b).is_null == 1 {
        return false;
    }
    
    // Both i31: compare unboxed scalar payload
    if (a).is_i31 == 1 && (b).is_i31 == 1 {
        return (a).instance_id == (b).instance_id;
    }
    
    // One i31, one heap instance: not equal
    if (a).is_i31 == 1 || (b).is_i31 == 1 {
        return false;
    }
    
    // Both heap instances: compare instance pointer IDs
    return (a).instance_id == (b).instance_id;
}
