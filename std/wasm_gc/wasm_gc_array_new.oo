// # WebAssembly GC Array New Allocation
//
// Logline: Allocation and initialization logic for GC array instances with stride calculations and initializers.
//
// Setup: Encodes element storage types, element counts, header metadata, and contiguous buffer allocation for arrays.
//
// Beats:
//   1. Define GcArrayDescriptor and GcArrayInstance structures.
//   2. Compute total heap allocation size including object header.
//   3. Implement array.new, array.new_default, and array.new_fixed.

import "./wasm_gc_field_types.oo";

pub type GcArrayDescriptor = struct {
    type_index: Int,
    element_type: StorageType,
    is_mutable: Int,
    element_stride_bytes: Int
};

pub type GcArrayInstance = struct {
    type_index: Int,
    instance_id: Int,
    length: Int,
    elements: List[Int],
    is_alive: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn gc_array_descriptor_new(type_idx: Int, st: StorageType, is_mut: Int) -> GcArrayDescriptor {
    let sz: Int = field_size_bytes(st);
    return GcArrayDescriptor {
        type_index: type_idx,
        element_type: st,
        is_mutable: is_mut,
        element_stride_bytes: sz
    };
}

pub fn gc_array_new(type_idx: Int, inst_id: Int, fill_val: Int, length: Int) -> GcArrayInstance {
    let mut elems: List[Int] = list_new();
    let mut i: Int = 0;
    while i < length {
        elems = list_push(elems, fill_val);
        i = i + 1;
    }
    return GcArrayInstance {
        type_index: type_idx,
        instance_id: inst_id,
        length: length,
        elements: elems,
        is_alive: 1
    };
}

pub fn gc_array_new_default(type_idx: Int, inst_id: Int, length: Int) -> GcArrayInstance {
    return gc_array_new(type_idx, inst_id, 0, length);
}

pub fn gc_array_new_fixed(type_idx: Int, inst_id: Int, init_elements: List[Int], length: Int) -> GcArrayInstance {
    return GcArrayInstance {
        type_index: type_idx,
        instance_id: inst_id,
        length: length,
        elements: init_elements,
        is_alive: 1
    };
}

pub fn gc_array_total_size(desc: GcArrayDescriptor, length: Int) -> Int {
    // 8-byte object header + 4-byte length + 4-byte padding + element storage
    let data_sz: Int = (desc).element_stride_bytes * length;
    return 16 + data_sz;
}
