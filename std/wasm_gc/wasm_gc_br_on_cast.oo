// # WebAssembly GC Branch on Cast Engine
//
// Logline: Conditional branch control flow execution for br_on_cast and br_on_cast_fail instructions.
//
// Setup: Directs control flow to target label or fallthrough based on dynamic reference type satisfaction.
//
// Beats:
//   1. Define BrOnCastInstruction and BranchDecision structures.
//   2. Evaluate br_on_cast matching condition and operand forwarding.
//   3. Evaluate br_on_cast_fail inverted condition.

import "./wasm_gc_type_hierarchy.oo";
import "./wasm_gc_heap_types.oo";
import "./wasm_gc_ref_test.oo";

pub type BrOnCastInstruction = struct {
    target_label: Int,
    source_heap_type: HeapType,
    target_heap_type: HeapType,
    is_inverted: Int // 1: br_on_cast_fail, 0: br_on_cast
};

pub type BranchDecision = struct {
    should_branch: Int, // 1: branch taken, 0: fallthrough
    forwarded_ref: GcRefValue,
    target_label: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn br_on_cast_new(label: Int, src_ht: HeapType, tgt_ht: HeapType, inverted: Int) -> BrOnCastInstruction {
    return BrOnCastInstruction {
        target_label: label,
        source_heap_type: src_ht,
        target_heap_type: tgt_ht,
        is_inverted: inverted
    };
}

// -------------------------------------------------------------------
// Execution
// -------------------------------------------------------------------

pub fn evaluate_br_on_cast(hier: TypeHierarchy, inst: BrOnCastInstruction, ref_val: GcRefValue) -> BranchDecision {
    let test_res: Int = gc_ref_test(hier, ref_val, (inst).target_heap_type);
    
    if (inst).is_inverted == 0 {
        // br_on_cast: branch if matches target type
        if test_res == 1 {
            return BranchDecision {
                should_branch: 1,
                forwarded_ref: ref_val,
                target_label: (inst).target_label
            };
        }
        return BranchDecision {
            should_branch: 0,
            forwarded_ref: ref_val,
            target_label: -1
        };
    } else {
        // br_on_cast_fail: branch if DOES NOT match target type
        if test_res == 0 {
            return BranchDecision {
                should_branch: 1,
                forwarded_ref: ref_val,
                target_label: (inst).target_label
            };
        }
        return BranchDecision {
            should_branch: 0,
            forwarded_ref: ref_val,
            target_label: -1
        };
    }
}

pub fn wasm_gc_br_on_cast_probe() -> Int {
    return 0;
}
