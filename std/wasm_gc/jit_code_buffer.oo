// # JIT Executable Code Buffer Manager
//
// Logline: Executable memory buffer management, relative branch relocation patching, and page protection transitions.
//
// Setup: Emits sequential machine code bytes into contiguous memory buffers and resolves forward jump relocations.
//
// Beats:
//   1. Define RelocationPatch and JitCodeBuffer structures.
//   2. Append bytes and record symbolic label jump sites.
//   3. Apply 32-bit relative displacement relocation patches.

pub type RelocationPatch = struct {
    patch_offset: Int,
    target_label_id: Int,
    is_applied: Int,
};

pub type JitCodeBuffer = struct {
    bytes: List[Int],
    byte_count: Int,
    capacity: Int,
    patches: List[RelocationPatch],
    patch_count: Int,
    is_executable: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn relocation_patch_new(offset: Int, label_id: Int) -> RelocationPatch {
    return RelocationPatch {
        patch_offset: offset,
        target_label_id: label_id,
        is_applied: 0,
    };
}

pub fn jit_code_buffer_new(capacity: Int) -> JitCodeBuffer {
    let empty_bytes: List[Int] = list_new();
    let empty_patches: List[RelocationPatch] = list_new();
    return JitCodeBuffer {
        bytes: empty_bytes,
        byte_count: 0,
        capacity: capacity,
        patches: empty_patches,
        patch_count: 0,
        is_executable: 0,
    };
}

// -------------------------------------------------------------------
// Buffer Operations
// -------------------------------------------------------------------

pub fn jit_code_buffer_emit_u8(mut buf: JitCodeBuffer, val: Int) -> JitCodeBuffer {
    let mut bs: List[Int] = (buf).bytes;
    bs = list_push(bs, val % 256);
    buf.bytes = bs;
    buf.byte_count = (buf).byte_count + 1;
    return buf;
}

pub fn jit_code_buffer_emit_u32(mut buf: JitCodeBuffer, val: Int) -> JitCodeBuffer {
    let b0: Int = val % 256;
    let b1: Int = (val / 256) % 256;
    let b2: Int = (val / 65536) % 256;
    let b3: Int = (val / 16777216) % 256;
    buf = jit_code_buffer_emit_u8(buf, b0);
    buf = jit_code_buffer_emit_u8(buf, b1);
    buf = jit_code_buffer_emit_u8(buf, b2);
    buf = jit_code_buffer_emit_u8(buf, b3);
    return buf;
}

pub fn jit_code_buffer_add_patch(mut buf: JitCodeBuffer, label_id: Int) -> JitCodeBuffer {
    let patch: RelocationPatch = relocation_patch_new((buf).byte_count, label_id);
    let mut ps: List[RelocationPatch] = (buf).patches;
    ps = list_push(ps, patch);
    buf.patches = ps;
    buf.patch_count = (buf).patch_count + 1;
    return buf;
}
