// # WebAssembly GC Mark and Sweep Collector
//
// Logline: Tri-color mark-and-sweep garbage collection algorithm for tracing GC heaps.
//
// Setup: Classifies GC objects as White (unreached), Gray (reached, unscanned), or Black (reached, scanned).
//
// Beats:
//   1. Define GcHeader, WorklistQueue, and MarkSweepCollector structures.
//   2. Push root pointers onto gray worklist.
//   3. Process worklist, mark objects black, and sweep white unreached objects.

pub type GcHeader = struct {
    object_id: Int,
    color: Int, // 0: White, 1: Gray, 2: Black
    size_bytes: Int,
    is_alive: Int
};

pub type MarkSweepCollector = struct {
    objects: List[GcHeader],
    object_count: Int,
    gray_worklist: List[Int],
    gray_count: Int,
    bytes_reclaimed: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn gc_header_new(id: Int, sz: Int) -> GcHeader {
    return GcHeader {
        object_id: id,
        color: 0,
        size_bytes: sz,
        is_alive: 1
    };
}

pub fn mark_sweep_collector_new() -> MarkSweepCollector {
    let empty_objs: List[GcHeader] = list_new();
    let empty_gray: List[Int] = list_new();
    return MarkSweepCollector {
        objects: empty_objs,
        object_count: 0,
        gray_worklist: empty_gray,
        gray_count: 0,
        bytes_reclaimed: 0
    };
}

// -------------------------------------------------------------------
// Collector Operations
// -------------------------------------------------------------------

pub fn mark_sweep_add_object(mut col: MarkSweepCollector, hdr: GcHeader) -> MarkSweepCollector {
    let mut os: List[GcHeader] = (col).objects;
    os = list_push(os, hdr);
    col.objects = os;
    col.object_count = (col).object_count + 1;
    return col;
}

pub fn mark_sweep_push_root(mut col: MarkSweepCollector, obj_id: Int) -> MarkSweepCollector {
    let mut gs: List[Int] = (col).gray_worklist;
    gs = list_push(gs, obj_id);
    col.gray_worklist = gs;
    col.gray_count = (col).gray_count + 1;
    return col;
}

pub fn mark_sweep_sweep(mut col: MarkSweepCollector) -> MarkSweepCollector {
    let mut new_objs: List[GcHeader] = list_new();
    let mut reclaimed: Int = 0;
    let mut i: Int = 0;
    let count: Int = (col).object_count;
    
    while i < count {
        let hdr: GcHeader = list_get((col).objects, i);
        if (hdr).color == 2 {
            // Black: reset to White for next GC cycle
            let reset_hdr: GcHeader = GcHeader {
                object_id: (hdr).object_id,
                color: 0,
                size_bytes: (hdr).size_bytes,
                is_alive: 1
            };
            new_objs = list_push(new_objs, reset_hdr);
        } else {
            // White: dead, reclaim
            reclaimed = reclaimed + (hdr).size_bytes;
        }
        i = i + 1;
    }
    
    col.objects = new_objs;
    col.object_count = list_len(new_objs);
    col.bytes_reclaimed = reclaimed;
    return col;
}
