// # JIT Safepoint and Stack Map Manager
//
// Logline: Precise GC stack map generation, pollcheck insertion, and safepoint tables for compiled native code.
//
// Setup: Maps native code instruction pointers (IP) to live GC pointer bitvectors in stack slots and registers.
//
// Beats:
//   1. Define StackMapEntry and SafepointTable structures.
//   2. Register live GC pointer slots at call sites and allocation points.
//   3. Lookup stack maps during GC stack unwinding.

pub type StackMapEntry = struct {
    code_offset: Int,
    live_gc_stack_slots: List[Int],
    slot_count: Int,
    live_gc_registers: List[Int],
    reg_count: Int,
};

pub type SafepointTable = struct {
    entries: List[StackMapEntry],
    entry_count: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn stack_map_entry_new(offset: Int) -> StackMapEntry {
    let empty_slots: List[Int] = list_new();
    let empty_regs: List[Int] = list_new();
    return StackMapEntry {
        code_offset: offset,
        live_gc_stack_slots: empty_slots,
        slot_count: 0,
        live_gc_registers: empty_regs,
        reg_count: 0,
    };
}

pub fn safepoint_table_new() -> SafepointTable {
    let empty_entries: List[StackMapEntry] = list_new();
    return SafepointTable {
        entries: empty_entries,
        entry_count: 0,
    };
}

// -------------------------------------------------------------------
// Safepoint Registration and Lookup
// -------------------------------------------------------------------

pub fn safepoint_table_add(mut table: SafepointTable, entry: StackMapEntry) -> SafepointTable {
    let mut es: List[StackMapEntry] = (table).entries;
    es = list_push(es, entry);
    table.entries = es;
    table.entry_count = (table).entry_count + 1;
    return table;
}

pub fn safepoint_table_find(table: SafepointTable, code_offset: Int) -> StackMapEntry {
    let mut i: Int = 0;
    let count: Int = (table).entry_count;
    while i < count {
        let entry: StackMapEntry = list_get((table).entries, i);
        if (entry).code_offset == code_offset {
            return entry;
        }
        i = i + 1;
    }
    return stack_map_entry_new(-1);
}
