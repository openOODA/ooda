// # WebAssembly GC Shadow Stack Engine
//
// Logline: Shadow stack frame management, root pointer enumeration, and stack frame traversal for runtime GC.
//
// Setup: Maintains an explicit linked list of stack frames containing GC reference root pointers.
//
// Beats:
//   1. Define ShadowStackFrame and ShadowStack structures.
//   2. Push and pop shadow stack activation frames.
//   3. Iterate live root pointers during GC mark phase.

pub type ShadowStackFrame = struct {
    frame_id: Int,
    function_id: Int,
    root_pointers: List[Int],
    root_count: Int
};

pub type ShadowStack = struct {
    frames: List[ShadowStackFrame],
    frame_count: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn shadow_stack_frame_new(f_id: Int, func_id: Int) -> ShadowStackFrame {
    let empty_roots: List[Int] = list_new();
    return ShadowStackFrame {
        frame_id: f_id,
        function_id: func_id,
        root_pointers: empty_roots,
        root_count: 0
    };
}

pub fn shadow_stack_new() -> ShadowStack {
    let empty_frames: List[ShadowStackFrame] = list_new();
    return ShadowStack {
        frames: empty_frames,
        frame_count: 0
    };
}

// -------------------------------------------------------------------
// Frame Management
// -------------------------------------------------------------------

pub fn shadow_stack_push(mut ss: ShadowStack, frame: ShadowStackFrame) -> ShadowStack {
    let mut fs: List[ShadowStackFrame] = (ss).frames;
    fs = list_push(fs, frame);
    ss.frames = fs;
    ss.frame_count = (ss).frame_count + 1;
    return ss;
}

pub fn shadow_stack_pop(mut ss: ShadowStack) -> ShadowStack {
    if (ss).frame_count <= 0 {
        return ss;
    }
    let mut fs: List[ShadowStackFrame] = list_new();
    let mut i: Int = 0;
    let limit: Int = (ss).frame_count - 1;
    while i < limit {
        fs = list_push(fs, list_get((ss).frames, i));
        i = i + 1;
    }
    ss.frames = fs;
    ss.frame_count = limit;
    return ss;
}

pub fn shadow_frame_add_root(mut frame: ShadowStackFrame, ptr: Int) -> ShadowStackFrame {
    let mut rs: List[Int] = (frame).root_pointers;
    rs = list_push(rs, ptr);
    frame.root_pointers = rs;
    frame.root_count = (frame).root_count + 1;
    return frame;
}
