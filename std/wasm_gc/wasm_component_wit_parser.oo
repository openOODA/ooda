// # WebAssembly Component Model WIT Parser
//
// Logline: Tokenizer and lexical recursive descent parser for WebAssembly Interface Types (WIT) syntax.
//
// Setup: Parses interface declarations, worlds, type aliases, and function signatures from WIT source streams.
//
// Beats:
//   1. Define WitToken and WitParser structures.
//   2. Tokenize WIT keywords (interface, world, record, variant, func, export, import).
//   3. Parse declarations into structured token streams.

pub type WitToken = struct {
    token_kind: Int, // 1: KEYWORD, 2: IDENT, 3: PUNCT, 4: LITERAL, 5: EOF
    text: String,
    line_number: Int,
};

pub type WitParser = struct {
    tokens: List[WitToken],
    token_count: Int,
    cursor: Int,
    errors_encountered: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn wit_token_new(kind: Int, text: String, line: Int) -> WitToken {
    return WitToken {
        token_kind: kind,
        text: text,
        line_number: line,
    };
}

pub fn wit_parser_new() -> WitParser {
    let empty_tokens: List[WitToken] = list_new();
    return WitParser {
        tokens: empty_tokens,
        token_count: 0,
        cursor: 0,
        errors_encountered: 0,
    };
}

// -------------------------------------------------------------------
// Parser Operations
// -------------------------------------------------------------------

pub fn wit_parser_add_token(mut parser: WitParser, token: WitToken) -> WitParser {
    let mut ts: List[WitToken] = (parser).tokens;
    ts = list_push(ts, token);
    parser.tokens = ts;
    parser.token_count = (parser).token_count + 1;
    return parser;
}

pub fn wit_parser_peek(parser: WitParser) -> WitToken {
    if (parser).cursor < (parser).token_count {
        return list_get((parser).tokens, (parser).cursor);
    }
    return wit_token_new(5, "EOF", -1);
}

pub fn wit_parser_advance(mut parser: WitParser) -> WitParser {
    if (parser).cursor < (parser).token_count {
        parser.cursor = (parser).cursor + 1;
    }
    return parser;
}

pub fn wit_parser_is_eof(parser: WitParser) -> Bool {
    return (parser).cursor >= (parser).token_count;
}
