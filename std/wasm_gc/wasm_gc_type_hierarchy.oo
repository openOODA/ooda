// # WebAssembly GC Type Hierarchy Engine
//
// Logline: Type hierarchy, recursive type group definitions, explicit subtyping declarations, and structural variance for Wasm GC.
//
// Setup: Encodes recursive type groups containing struct and array definitions, tracking supertype indices and nominal subtyping depth.
//
// Beats:
//   1. Define GcTypeDef, RecGroup, and TypeHierarchy structures.
//   2. Register recursive type groups with supertype parent links.
//   3. Validate subtyping relationships between heap types.

pub type GcTypeDef = struct {
    type_index: Int,
    super_type_index: Int, // -1 if no supertype
    is_final: Int, // 1: final, 0: open for subtyping
    composite_kind: Int, // 1: struct, 2: array, 3: func
    rec_group_id: Int
};

pub type RecGroup = struct {
    group_id: Int,
    start_type_index: Int,
    type_count: Int
};

pub type TypeHierarchy = struct {
    types: List[GcTypeDef],
    type_count: Int,
    rec_groups: List[RecGroup],
    rec_group_count: Int
};

// -------------------------------------------------------------------
// Tag Constants
// -------------------------------------------------------------------

pub fn gc_comp_struct() -> Int { return 1; }
pub fn gc_comp_array() -> Int { return 2; }
pub fn gc_comp_func() -> Int { return 3; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn gc_type_def_new(type_idx: Int, super_idx: Int, is_final: Int, kind: Int, group: Int) -> GcTypeDef {
    return GcTypeDef {
        type_index: type_idx,
        super_type_index: super_idx,
        is_final: is_final,
        composite_kind: kind,
        rec_group_id: group
    };
}

pub fn rec_group_new(group_id: Int, start_idx: Int, count: Int) -> RecGroup {
    return RecGroup {
        group_id: group_id,
        start_type_index: start_idx,
        type_count: count
    };
}

pub fn type_hierarchy_new() -> TypeHierarchy {
    let empty_types: List[GcTypeDef] = list_new();
    let empty_groups: List[RecGroup] = list_new();
    return TypeHierarchy {
        types: empty_types,
        type_count: 0,
        rec_groups: empty_groups,
        rec_group_count: 0
    };
}

// -------------------------------------------------------------------
// Mutations & Hierarchy Checks
// -------------------------------------------------------------------

pub fn type_hierarchy_add_type(mut hier: TypeHierarchy, t: GcTypeDef) -> TypeHierarchy {
    let mut ts: List[GcTypeDef] = (hier).types;
    ts = list_push(ts, t);
    hier.types = ts;
    hier.type_count = (hier).type_count + 1;
    return hier;
}

pub fn type_hierarchy_add_rec_group(mut hier: TypeHierarchy, g: RecGroup) -> TypeHierarchy {
    let mut gs: List[RecGroup] = (hier).rec_groups;
    gs = list_push(gs, g);
    hier.rec_groups = gs;
    hier.rec_group_count = (hier).rec_group_count + 1;
    return hier;
}

pub fn type_hierarchy_get_type(hier: TypeHierarchy, index: Int) -> GcTypeDef {
    if index >= 0 && index < (hier).type_count {
        return list_get((hier).types, index);
    }
    return gc_type_def_new(-1, -1, 1, 0, -1);
}

pub fn type_hierarchy_is_subtype_of(hier: TypeHierarchy, sub_idx: Int, super_idx: Int) -> Bool {
    if sub_idx == super_idx {
        return true;
    }
    let mut curr_idx: Int = sub_idx;
    let mut guard: Int = 0;
    while curr_idx >= 0 && curr_idx < (hier).type_count && guard < 64 {
        if curr_idx == super_idx {
            return true;
        }
        let t: GcTypeDef = list_get((hier).types, curr_idx);
        curr_idx = (t).super_type_index;
        guard = guard + 1;
    }
    return false;
}
