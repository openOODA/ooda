// # JIT Cranelift Machine Intermediate Representation
//
// Logline: Cranelift-inspired SSA Machine Intermediate Representation with typed values, instructions, and basic blocks.
//
// Setup: Encodes machine-level scalar and reference types, instruction opcodes, value IDs, and block parameters.
//
// Beats:
//   1. Define JirType, JirValue, JirInstruction, and JirBlock structures.
//   2. Enumerate machine opcodes (IAdd, ISub, IMul, Load, Store, Branch, Call, Return).
//   3. Provide constructors for SSA value bindings and block nodes.

pub type JirType = struct {
    tag: Int, // 1: I32, 2: I64, 3: F32, 4: F64, 5: R64 (GC Ref), 6: B1
    size_bytes: Int
};

pub type JirValue = struct {
    value_id: Int,
    val_type: JirType,
    is_defined: Int
};

pub type JirInstruction = struct {
    inst_id: Int,
    opcode: Int, // 1: IADD, 2: ISUB, 3: IMUL, 4: LOAD, 5: STORE, 6: BR, 7: BR_IF, 8: CALL, 9: RET
    result_value_id: Int,
    arg0: Int,
    arg1: Int,
    target_block: Int
};

pub type JirBlock = struct {
    block_id: Int,
    instructions: List[JirInstruction],
    instruction_count: Int,
    predecessors: List[Int],
    successors: List[Int]
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn jir_type_i32() -> JirType { return JirType { tag: 1, size_bytes: 4 }; }
pub fn jir_type_i64() -> JirType { return JirType { tag: 2, size_bytes: 8 }; }
pub fn jir_type_f32() -> JirType { return JirType { tag: 3, size_bytes: 4 }; }
pub fn jir_type_f64() -> JirType { return JirType { tag: 4, size_bytes: 8 }; }
pub fn jir_type_r64() -> JirType { return JirType { tag: 5, size_bytes: 8 }; }
pub fn jir_type_b1() -> JirType { return JirType { tag: 6, size_bytes: 1 }; }

pub fn jir_inst_new(id: Int, op: Int, res: Int, a0: Int, a1: Int, target: Int) -> JirInstruction {
    return JirInstruction {
        inst_id: id,
        opcode: op,
        result_value_id: res,
        arg0: a0,
        arg1: a1,
        target_block: target
    };
}

pub fn jir_block_new(id: Int) -> JirBlock {
    let empty_insts: List[JirInstruction] = list_new();
    let empty_preds: List[Int] = list_new();
    let empty_succs: List[Int] = list_new();
    return JirBlock {
        block_id: id,
        instructions: empty_insts,
        instruction_count: 0,
        predecessors: empty_preds,
        successors: empty_succs
    };
}

pub fn jir_block_add_inst(mut blk: JirBlock, inst: JirInstruction) -> JirBlock {
    let mut insts: List[JirInstruction] = (blk).instructions;
    insts = list_push(insts, inst);
    blk.instructions = insts;
    blk.instruction_count = (blk).instruction_count + 1;
    return blk;
}
