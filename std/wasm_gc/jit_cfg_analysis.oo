// # JIT Control Flow Graph Analysis
//
// Logline: Basic block predecessor/successor linking, loop header detection, and CFG post-dominator analysis for JIT compilation.
//
// Setup: Analyzes branch targets to compute CFG topological ordering and loop depth metrics.
//
// Beats:
//   1. Define JirCfgBlockInfo and JirCfgAnalysis structures.
//   2. Compute block entry/exit relationships and edge counts.
//   3. Detect loop headers and back-edges.

pub type JirCfgBlockInfo = struct {
    block_id: Int,
    pred_count: Int,
    succ_count: Int,
    loop_depth: Int,
    is_loop_header: Int
};

pub type JirCfgAnalysis = struct {
    blocks: List[JirCfgBlockInfo],
    block_count: Int,
    has_cycles: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn jir_cfg_block_info_new(id: Int) -> JirCfgBlockInfo {
    return JirCfgBlockInfo {
        block_id: id,
        pred_count: 0,
        succ_count: 0,
        loop_depth: 0,
        is_loop_header: 0
    };
}

pub fn jir_cfg_analysis_new() -> JirCfgAnalysis {
    let empty_blocks: List[JirCfgBlockInfo] = list_new();
    return JirCfgAnalysis {
        blocks: empty_blocks,
        block_count: 0,
        has_cycles: 0
    };
}

// -------------------------------------------------------------------
// Analysis Helpers
// -------------------------------------------------------------------

pub fn jir_cfg_add_block_info(mut analysis: JirCfgAnalysis, info: JirCfgBlockInfo) -> JirCfgAnalysis {
    let mut bs: List[JirCfgBlockInfo] = (analysis).blocks;
    bs = list_push(bs, info);
    analysis.blocks = bs;
    analysis.block_count = (analysis).block_count + 1;
    return analysis;
}

pub fn jir_cfg_mark_loop(mut info: JirCfgBlockInfo, depth: Int) -> JirCfgBlockInfo {
    info.is_loop_header = 1;
    info.loop_depth = depth;
    return info;
}
