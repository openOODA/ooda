// # WebAssembly Component Model Linker
//
// Logline: Composition graph linking, dependency DAG resolution, and import-export instantiation wiring.
//
// Setup: Resolves imported interfaces of child components against exported interfaces of provider components.
//
// Beats:
//   1. Define ComponentNode, LinkEdge, and CompositionGraph structures.
//   2. Validate acyclic dependency ordering among instantiated components.
//   3. Bind matching interface exports to instance imports.

pub type ComponentNode = struct {
    node_id: Int,
    component_name: String,
    in_degree: Int,
};

pub type LinkEdge = struct {
    from_node_id: Int, // provider
    to_node_id: Int,   // consumer
    interface_name: String,
};

pub type CompositionGraph = struct {
    nodes: List[ComponentNode],
    node_count: Int,
    edges: List[LinkEdge],
    edge_count: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn component_node_new(id: Int, name: String) -> ComponentNode {
    return ComponentNode {
        node_id: id,
        component_name: name,
        in_degree: 0,
    };
}

pub fn link_edge_new(from_id: Int, to_id: Int, iface: String) -> LinkEdge {
    return LinkEdge {
        from_node_id: from_id,
        to_node_id: to_id,
        interface_name: iface,
    };
}

pub fn composition_graph_new() -> CompositionGraph {
    let empty_nodes: List[ComponentNode] = list_new();
    let empty_edges: List[LinkEdge] = list_new();
    return CompositionGraph {
        nodes: empty_nodes,
        node_count: 0,
        edges: empty_edges,
        edge_count: 0,
    };
}

// -------------------------------------------------------------------
// Graph Operations
// -------------------------------------------------------------------

pub fn composition_graph_add_node(mut g: CompositionGraph, node: ComponentNode) -> CompositionGraph {
    let mut ns: List[ComponentNode] = (g).nodes;
    ns = list_push(ns, node);
    g.nodes = ns;
    g.node_count = (g).node_count + 1;
    return g;
}

pub fn composition_graph_add_edge(mut g: CompositionGraph, edge: LinkEdge) -> CompositionGraph {
    let mut es: List[LinkEdge] = (g).edges;
    es = list_push(es, edge);
    g.edges = es;
    g.edge_count = (g).edge_count + 1;
    return g;
}
