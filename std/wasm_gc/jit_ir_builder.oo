// # JIT Machine IR Builder
//
// Logline: Fluent SSA Intermediate Representation builder for constructing functions, basic blocks, and JIT operations.
//
// Setup: Maintains cursor positions, allocates monotonic value identifiers, and binds instructions into active blocks.
//
// Beats:
//   1. Define JirBuilder and JirFunction structures.
//   2. Allocate SSA value IDs and append arithmetic and memory instructions.
//   3. Finalize basic blocks and link control flow branches.

import "./jit_cranelift_machine_ir.oo";

pub type JirFunction = struct {
    func_name: String,
    blocks: List[JirBlock],
    block_count: Int,
    entry_block_id: Int
};

pub type JirBuilder = struct {
    func: JirFunction,
    current_block_idx: Int,
    next_value_id: Int,
    next_inst_id: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn jir_function_new(name: String) -> JirFunction {
    let empty_blocks: List[JirBlock] = list_new();
    return JirFunction {
        func_name: name,
        blocks: empty_blocks,
        block_count: 0,
        entry_block_id: 0
    };
}

pub fn jir_builder_new(name: String) -> JirBuilder {
    let mut f: JirFunction = jir_function_new(name);
    let entry: JirBlock = jir_block_new(0);
    let mut bs: List[JirBlock] = (f).blocks;
    bs = list_push(bs, entry);
    f.blocks = bs;
    f.block_count = 1;
    
    return JirBuilder {
        func: f,
        current_block_idx: 0,
        next_value_id: 1,
        next_inst_id: 1
    };
}

// -------------------------------------------------------------------
// Builder Instruction Emission
// -------------------------------------------------------------------

pub fn jir_builder_emit_iadd(mut b: JirBuilder, a0: Int, a1: Int) -> JirBuilder {
    let res_id: Int = (b).next_value_id;
    let inst_id: Int = (b).next_inst_id;
    let inst: JirInstruction = jir_inst_new(inst_id, 1, res_id, a0, a1, -1);
    
    let mut curr_blk: JirBlock = list_get((b).func.blocks, (b).current_block_idx);
    curr_blk = jir_block_add_inst(curr_blk, inst);
    
    let mut bs: List[JirBlock] = list_new();
    let mut i: Int = 0;
    let count: Int = (b).func.block_count;
    while i < count {
        if i == (b).current_block_idx {
            bs = list_push(bs, curr_blk);
        } else {
            bs = list_push(bs, list_get((b).func.blocks, i));
        }
        i = i + 1;
    }
    b.func.blocks = bs;
    b.next_value_id = res_id + 1;
    b.next_inst_id = inst_id + 1;
    return b;
}

pub fn jir_builder_emit_return(mut b: JirBuilder, val_id: Int) -> JirBuilder {
    let inst_id: Int = (b).next_inst_id;
    let inst: JirInstruction = jir_inst_new(inst_id, 9, -1, val_id, 0, -1);
    
    let mut curr_blk: JirBlock = list_get((b).func.blocks, (b).current_block_idx);
    curr_blk = jir_block_add_inst(curr_blk, inst);
    
    let mut bs: List[JirBlock] = list_new();
    let mut i: Int = 0;
    let count: Int = (b).func.block_count;
    while i < count {
        if i == (b).current_block_idx {
            bs = list_push(bs, curr_blk);
        } else {
            bs = list_push(bs, list_get((b).func.blocks, i));
        }
        i = i + 1;
    }
    b.func.blocks = bs;
    b.next_inst_id = inst_id + 1;
    return b;
}
