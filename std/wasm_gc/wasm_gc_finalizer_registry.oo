// # WebAssembly GC Finalizer Registry Engine
//
// Logline: Weak reference tracking, finalization registries, cleanup callback scheduling, and unregister tokens.
//
// Setup: Tracks target GC objects, unregister tokens, and cleanup callbacks scheduled upon target collection.
//
// Beats:
//   1. Define FinalizerEntry and FinalizerRegistry structures.
//   2. Register cleanup callbacks with optional unregister tokens.
//   3. Process collected targets and fire cleanup notifications.

pub type FinalizerEntry = struct {
    target_object_id: Int,
    held_value: Int,
    unregister_token: Int,
    is_active: Int
};

pub type FinalizerRegistry = struct {
    entries: List[FinalizerEntry],
    entry_count: Int,
    callbacks_fired: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn finalizer_entry_new(target_id: Int, held: Int, token: Int) -> FinalizerEntry {
    return FinalizerEntry {
        target_object_id: target_id,
        held_value: held,
        unregister_token: token,
        is_active: 1
    };
}

pub fn finalizer_registry_new() -> FinalizerRegistry {
    let empty_entries: List[FinalizerEntry] = list_new();
    return FinalizerRegistry {
        entries: empty_entries,
        entry_count: 0,
        callbacks_fired: 0
    };
}

// -------------------------------------------------------------------
// Registry Operations
// -------------------------------------------------------------------

pub fn finalizer_registry_register(mut reg: FinalizerRegistry, target_id: Int, held: Int, token: Int) -> FinalizerRegistry {
    let entry: FinalizerEntry = finalizer_entry_new(target_id, held, token);
    let mut es: List[FinalizerEntry] = (reg).entries;
    es = list_push(es, entry);
    reg.entries = es;
    reg.entry_count = (reg).entry_count + 1;
    return reg;
}

pub fn finalizer_registry_unregister(mut reg: FinalizerRegistry, token: Int) -> FinalizerRegistry {
    let mut new_entries: List[FinalizerEntry] = list_new();
    let mut i: Int = 0;
    let count: Int = (reg).entry_count;
    
    while i < count {
        let entry: FinalizerEntry = list_get((reg).entries, i);
        if (entry).unregister_token == token {
            let deactivated: FinalizerEntry = FinalizerEntry {
                target_object_id: (entry).target_object_id,
                held_value: (entry).held_value,
                unregister_token: (entry).unregister_token,
                is_active: 0
            };
            new_entries = list_push(new_entries, deactivated);
        } else {
            new_entries = list_push(new_entries, entry);
        }
        i = i + 1;
    }
    
    reg.entries = new_entries;
    return reg;
}
