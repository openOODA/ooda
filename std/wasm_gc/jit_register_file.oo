// # JIT Hardware Register File
//
// Logline: Hardware register file abstractions for x86-64 and AArch64 architectures with ABI roles.
//
// Setup: Encodes physical register indices, caller-saved vs callee-saved classifications, and parameter registers.
//
// Beats:
//   1. Define PhysicalReg and RegisterFile structures.
//   2. Enumerate x86-64 register indices (RAX=0, RCX=1, RDX=2, RBX=3, RSP=4, RBP=5, RSI=6, RDI=7, R8-R15).
//   3. Enumerate AArch64 general purpose registers (X0-X30, SP).

pub type PhysicalReg = struct {
    reg_id: Int,
    name: String,
    arch_type: Int, // 1: x86_64, 2: aarch64
    is_callee_saved: Int,
    is_parameter_reg: Int,
};

pub type RegisterFile = struct {
    registers: List[PhysicalReg],
    reg_count: Int,
    num_allocatable: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn physical_reg_new(id: Int, name: String, arch: Int, callee_saved: Int, is_param: Int) -> PhysicalReg {
    return PhysicalReg {
        reg_id: id,
        name: name,
        arch_type: arch,
        is_callee_saved: callee_saved,
        is_parameter_reg: is_param,
    };
}

pub fn register_file_x86_64() -> RegisterFile {
    let mut regs: List[PhysicalReg] = list_new();
    // RAX: caller-saved, return value
    regs = list_push(regs, physical_reg_new(0, "rax", 1, 0, 0));
    // RCX: caller-saved, 4th param (SysV)
    regs = list_push(regs, physical_reg_new(1, "rcx", 1, 0, 1));
    // RDX: caller-saved, 3rd param
    regs = list_push(regs, physical_reg_new(2, "rdx", 1, 0, 1));
    // RBX: callee-saved
    regs = list_push(regs, physical_reg_new(3, "rbx", 1, 1, 0));
    // RSI: caller-saved, 2nd param
    regs = list_push(regs, physical_reg_new(6, "rsi", 1, 0, 1));
    // RDI: caller-saved, 1st param
    regs = list_push(regs, physical_reg_new(7, "rdi", 1, 0, 1));
    // R8: caller-saved, 5th param
    regs = list_push(regs, physical_reg_new(8, "r8", 1, 0, 1));
    // R9: caller-saved, 6th param
    regs = list_push(regs, physical_reg_new(9, "r9", 1, 0, 1));
    // R10-R11: caller-saved
    regs = list_push(regs, physical_reg_new(10, "r10", 1, 0, 0));
    regs = list_push(regs, physical_reg_new(11, "r11", 1, 0, 0));
    // R12-R15: callee-saved
    regs = list_push(regs, physical_reg_new(12, "r12", 1, 1, 0));
    regs = list_push(regs, physical_reg_new(13, "r13", 1, 1, 0));
    regs = list_push(regs, physical_reg_new(14, "r14", 1, 1, 0));
    regs = list_push(regs, physical_reg_new(15, "r15", 1, 1, 0));
    
    return RegisterFile {
        registers: regs,
        reg_count: 14,
        num_allocatable: 14,
    };
}
