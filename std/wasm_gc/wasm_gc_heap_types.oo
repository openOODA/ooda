// # Wasm GC heap types
//
// Logline: WasmGcHeap destubbed off nested heap-type lists.
// residual: List[struct] destubbed.

type WasmGcHeap = struct {
    kind: Int,
    nullable: Int
};

pub fn wasm_gc_heap_new(kind: Int, nullable: Int) -> WasmGcHeap {
    return WasmGcHeap {
        kind: kind,
        nullable: nullable
    };
}

pub fn wasm_gc_heap_kind(h: WasmGcHeap) -> Int {
    return h.kind;
}
