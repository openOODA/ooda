// # WebAssembly GC Ref Test Engine
//
// Logline: Dynamic runtime type inspection for GC references against target heap types and nullability flags.
//
// Setup: Evaluates ref.test and ref.test null instructions, validating concrete and abstract subtyping at runtime.
//
// Beats:
//   1. Define GcRefValue representation for dynamic heap objects.
//   2. Check if a reference matches a target HeapType without throwing traps.
//   3. Support ref.test null variant with nullable heap types.

import "./wasm_gc_type_hierarchy.oo";
import "./wasm_gc_heap_types.oo";

pub type GcRefValue = struct {
    actual_type_index: Int,
    is_null: Int, // 1: null, 0: non-null
    is_i31: Int, // 1: unboxed i31, 0: heap pointer
    instance_id: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn gc_ref_null(type_idx: Int) -> GcRefValue {
    return GcRefValue {
        actual_type_index: type_idx,
        is_null: 1,
        is_i31: 0,
        instance_id: -1,
    };
}

pub fn gc_ref_instance(type_idx: Int, inst_id: Int) -> GcRefValue {
    return GcRefValue {
        actual_type_index: type_idx,
        is_null: 0,
        is_i31: 0,
        instance_id: inst_id,
    };
}

pub fn gc_ref_i31_val(val: Int) -> GcRefValue {
    return GcRefValue {
        actual_type_index: -2,
        is_null: 0,
        is_i31: 1,
        instance_id: val,
    };
}

// -------------------------------------------------------------------
// Ref Test Operations
// -------------------------------------------------------------------

pub fn gc_ref_test(hier: TypeHierarchy, ref_val: GcRefValue, target_ht: HeapType) -> Int {
    if (ref_val).is_null == 1 {
        // ref.test returns 0 for null unless nullable target is explicitly tested with ref.test null
        if (target_ht).is_nullable == 1 {
            return 1;
        }
        return 0;
    }
    
    // Unboxed i31 testing
    if (ref_val).is_i31 == 1 {
        if (target_ht).kind == 0 || (target_ht).kind == 1 || (target_ht).kind == 2 {
            return 1; // matches any, eq, i31
        }
        return 0;
    }
    
    // Abstract targets
    if (target_ht).kind == 0 || (target_ht).kind == 1 {
        return 1; // all heap structs/arrays match any and eq
    }
    if (target_ht).kind == 3 {
        // struct heap type
        let t: GcTypeDef = type_hierarchy_get_type(hier, (ref_val).actual_type_index);
        if (t).composite_kind == 1 {
            return 1;
        }
        return 0;
    }
    if (target_ht).kind == 4 {
        // array heap type
        let t: GcTypeDef = type_hierarchy_get_type(hier, (ref_val).actual_type_index);
        if (t).composite_kind == 2 {
            return 1;
        }
        return 0;
    }
    
    // Concrete target type index
    if (target_ht).kind == 10 {
        let is_sub: Bool = type_hierarchy_is_subtype_of(hier, (ref_val).actual_type_index, (target_ht).type_index);
        if is_sub {
            return 1;
        }
        return 0;
    }
    
    return 0;
}
