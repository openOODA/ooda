// # JIT Polymorphic Inline Cache Engine
//
// Logline: Inline caching, monomorphic fast paths, polymorphic table lookups, and megamorphic fallback dispatch.
//
// Setup: Caches struct field byte offsets and method addresses per dynamic shape/type index to eliminate dynamic resolution overhead.
//
// Beats:
//   1. Define InlineCacheEntry, InlineCacheState, and InlineCache structures.
//   2. Update IC state transitions: Uninitialized -> Monomorphic -> Polymorphic -> Megamorphic.
//   3. Lookup cached field offsets and dispatch targets.

pub type InlineCacheEntry = struct {
    type_index: Int,
    field_byte_offset: Int,
    target_code_ptr: Int,
    hit_count: Int
};

pub type InlineCache = struct {
    call_site_id: Int,
    state_kind: Int, // 0: UNINIT, 1: MONOMORPHIC, 2: POLYMORPHIC, 3: MEGAMORPHIC
    entries: List[InlineCacheEntry],
    entry_count: Int,
    max_poly_entries: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn ic_entry_new(t_idx: Int, offset: Int, code_ptr: Int) -> InlineCacheEntry {
    return InlineCacheEntry {
        type_index: t_idx,
        field_byte_offset: offset,
        target_code_ptr: code_ptr,
        hit_count: 1
    };
}

pub fn inline_cache_new(site_id: Int) -> InlineCache {
    let empty_entries: List[InlineCacheEntry] = list_new();
    return InlineCache {
        call_site_id: site_id,
        state_kind: 0,
        entries: empty_entries,
        entry_count: 0,
        max_poly_entries: 4
    };
}

// -------------------------------------------------------------------
// IC Lookup and Mutations
// -------------------------------------------------------------------

pub fn inline_cache_lookup(ic: InlineCache, t_idx: Int) -> Int {
    if (ic).state_kind == 0 {
        return -1; // Uninitialized
    }
    let mut i: Int = 0;
    let count: Int = (ic).entry_count;
    while i < count {
        let entry: InlineCacheEntry = list_get((ic).entries, i);
        if (entry).type_index == t_idx {
            return (entry).field_byte_offset;
        }
        i = i + 1;
    }
    return -1; // Cache miss
}

pub fn inline_cache_update(mut ic: InlineCache, t_idx: Int, offset: Int, code_ptr: Int) -> InlineCache {
    let existing_offset: Int = inline_cache_lookup(ic, t_idx);
    if existing_offset >= 0 {
        return ic;
    }
    
    let entry: InlineCacheEntry = ic_entry_new(t_idx, offset, code_ptr);
    let mut es: List[InlineCacheEntry] = (ic).entries;
    es = list_push(es, entry);
    ic.entries = es;
    ic.entry_count = (ic).entry_count + 1;
    
    if (ic).entry_count == 1 {
        ic.state_kind = 1; // Monomorphic
    } else {
        if (ic).entry_count <= (ic).max_poly_entries {
            ic.state_kind = 2; // Polymorphic
        } else {
            ic.state_kind = 3; // Megamorphic
        }
    }
    return ic;
}
