// # WebAssembly GC Immix Space Allocator
//
// Logline: Immix mark-region memory allocation with coarse block and fine line status marking.
//
// Setup: Organizes heap memory into 32KB blocks containing 128-byte lines to combine bump allocation speed with low fragmentation.
//
// Beats:
//   1. Define ImmixLine, ImmixBlock, and ImmixSpace structures.
//   2. Allocate objects inside contiguous unmarked line holes.
//   3. Mark surviving lines during collection cycles.

pub type ImmixLine = struct {
    line_index: Int,
    is_marked: Int,
};

pub type ImmixBlock = struct {
    block_id: Int,
    lines: List[ImmixLine],
    line_count: Int,
    is_reusable: Int,
};

pub type ImmixSpace = struct {
    blocks: List[ImmixBlock],
    block_count: Int,
    current_block_idx: Int,
    current_line_idx: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn immix_line_new(idx: Int) -> ImmixLine {
    return ImmixLine {
        line_index: idx,
        is_marked: 0,
    };
}

pub fn immix_block_new(b_id: Int) -> ImmixBlock {
    let mut ls: List[ImmixLine] = list_new();
    let mut i: Int = 0;
    while i < 256 { // 256 lines * 128 bytes = 32KB block
        ls = list_push(ls, immix_line_new(i));
        i = i + 1;
    }
    return ImmixBlock {
        block_id: b_id,
        lines: ls,
        line_count: 256,
        is_reusable: 1,
    };
}

pub fn immix_space_new() -> ImmixSpace {
    let mut bs: List[ImmixBlock] = list_new();
    bs = list_push(bs, immix_block_new(0));
    return ImmixSpace {
        blocks: bs,
        block_count: 1,
        current_block_idx: 0,
        current_line_idx: 0,
    };
}

// -------------------------------------------------------------------
// Immix Allocation
// -------------------------------------------------------------------

pub fn immix_space_alloc_lines(mut space: ImmixSpace, num_lines: Int) -> Int {
    let cur_line: Int = (space).current_line_idx;
    if cur_line + num_lines <= 256 {
        space.current_line_idx = cur_line + num_lines;
        return ((space).current_block_idx * 32768) + (cur_line * 128);
    }
    
    // Allocate fresh block
    let next_b_id: Int = (space).block_count;
    let new_b: ImmixBlock = immix_block_new(next_b_id);
    let mut bs: List[ImmixBlock] = (space).blocks;
    bs = list_push(bs, new_b);
    space.blocks = bs;
    space.block_count = next_b_id + 1;
    space.current_block_idx = next_b_id;
    space.current_line_idx = num_lines;
    return (next_b_id * 32768);
}
