// # WebAssembly GC Type Canonicalization Engine
//
// Logline: Canonicalization of recursive type groups, hash-consing, iso-recursive unrolling, and type equivalence.
//
// Setup: Maps structurally equivalent recursive type groups to unique canonical indices to support cross-module link compatibility.
//
// Beats:
//   1. Define CanonTypeEntry and CanonTypeTable structures.
//   2. Compute canonical fingerprints for struct and array composite signatures.
//   3. Lookup and intern canonical types.

import "./wasm_gc_type_hierarchy.oo";

pub type CanonTypeEntry = struct {
    local_index: Int,
    canonical_id: Int,
    structural_hash: Int,
    rec_depth: Int,
    is_valid: Int,
};

pub type CanonTypeTable = struct {
    entries: List[CanonTypeEntry],
    entry_count: Int,
    next_canonical_id: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn canon_type_entry_new(local_idx: Int, canon_id: Int, hash: Int, depth: Int) -> CanonTypeEntry {
    return CanonTypeEntry {
        local_index: local_idx,
        canonical_id: canon_id,
        structural_hash: hash,
        rec_depth: depth,
        is_valid: 1,
    };
}

pub fn canon_type_table_new() -> CanonTypeTable {
    let empty_entries: List[CanonTypeEntry] = list_new();
    return CanonTypeTable {
        entries: empty_entries,
        entry_count: 0,
        next_canonical_id: 1000,
    };
}

// -------------------------------------------------------------------
// Hash and Intern Operations
// -------------------------------------------------------------------

pub fn canon_compute_hash(composite_kind: Int, field_count: Int, super_idx: Int) -> Int {
    let mut h: Int = composite_kind * 31;
    h = (h + field_count) * 31;
    h = h + super_idx;
    if h < 0 {
        h = 0 - h;
    }
    return h;
}

pub fn canon_find_match(table: CanonTypeTable, hash: Int, depth: Int) -> Int {
    let mut i: Int = 0;
    let count: Int = (table).entry_count;
    while i < count {
        let entry: CanonTypeEntry = list_get((table).entries, i);
        if (entry).structural_hash == hash && (entry).rec_depth == depth {
            return (entry).canonical_id;
        }
        i = i + 1;
    }
    return -1;
}

pub fn canon_intern_type(mut table: CanonTypeTable, local_idx: Int, hash: Int, depth: Int) -> CanonTypeTable {
    let existing_id: Int = canon_find_match(table, hash, depth);
    if existing_id >= 0 {
        let entry: CanonTypeEntry = canon_type_entry_new(local_idx, existing_id, hash, depth);
        let mut es: List[CanonTypeEntry] = (table).entries;
        es = list_push(es, entry);
        table.entries = es;
        table.entry_count = (table).entry_count + 1;
        return table;
    }
    
    let new_id: Int = (table).next_canonical_id;
    let entry: CanonTypeEntry = canon_type_entry_new(local_idx, new_id, hash, depth);
    let mut es: List[CanonTypeEntry] = (table).entries;
    es = list_push(es, entry);
    table.entries = es;
    table.entry_count = (table).entry_count + 1;
    table.next_canonical_id = new_id + 1;
    return table;
}

pub fn canon_get_canonical_id(table: CanonTypeTable, local_idx: Int) -> Int {
    let mut i: Int = 0;
    let count: Int = (table).entry_count;
    while i < count {
        let entry: CanonTypeEntry = list_get((table).entries, i);
        if (entry).local_index == local_idx {
            return (entry).canonical_id;
        }
        i = i + 1;
    }
    return -1;
}
