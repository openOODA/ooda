// # JIT Instruction Encoder for AArch64
//
// Logline: 32-bit fixed-width instruction encoding for ARM64 arithmetic, memory, and branch operations.
//
// Setup: Emits native 32-bit little-endian binary words for A64 instruction formats (ADD, SUB, MOV, LDR, STR, RET).
//
// Beats:
//   1. Define Arm64Instruction and Arm64Stream structures.
//   2. Encode register arithmetic format (sf, op, S, shift, Rm, imm6, Rn, Rd).
//   3. Emit unconditional branch and procedure return opcodes.

pub type Arm64Word = struct {
    word_val: Int,
};

pub type Arm64Stream = struct {
    words: List[Int],
    word_count: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn arm64_stream_new() -> Arm64Stream {
    let empty_list: List[Int] = list_new();
    return Arm64Stream {
        words: empty_list,
        word_count: 0,
    };
}

pub fn arm64_stream_add_word(mut s: Arm64Stream, w: Int) -> Arm64Stream {
    let mut ws: List[Int] = (s).words;
    ws = list_push(ws, w);
    s.words = ws;
    s.word_count = (s).word_count + 1;
    return s;
}

// -------------------------------------------------------------------
// Encoders
// -------------------------------------------------------------------

pub fn encode_arm64_add_reg(rd: Int, rn: Int, rm: Int) -> Int {
    // 64-bit ADD Xd, Xn, Xm -> sf=1 (bit 31), op=0 (bit 30), S=0 (bit 29), 0101100 (bits 28-24)
    // Base opcode: 0x8B000000
    let mut w: Int = 2332033024; // 0x8B000000
    w = w + ((rm % 32) * 65536); // Rm at bits 20-16
    w = w + ((rn % 32) * 32);    // Rn at bits 9-5
    w = w + (rd % 32);           // Rd at bits 4-0
    return w;
}

pub fn encode_arm64_ret() -> Int {
    // RET X30 -> 0xD65F03C0
    // As unsigned 32-bit int: 3596551104
    return 3596551104;
}
