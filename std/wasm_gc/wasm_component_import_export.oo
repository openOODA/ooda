// # WebAssembly Component Model Import and Export Engine
//
// Logline: Import and export descriptors, instance instantiation bindings, and alias resolution.
//
// Setup: Tracks external dependency interfaces and exported functional entry points of a WebAssembly Component.
//
// Beats:
//   1. Define ComponentItemDesc, ComponentImport, and ComponentExport structures.
//   2. Register component imports and exports.
//   3. Resolve item aliases and instance export lookups.

pub type ComponentItemDesc = struct {
    item_kind: Int, // 1: Core Module, 2: Func, 3: Value, 4: Type, 5: Instance, 6: Component
    item_index: Int
};

pub type ComponentImport = struct {
    name: String,
    desc: ComponentItemDesc
};

pub type ComponentExport = struct {
    name: String,
    desc: ComponentItemDesc
};

pub type ComponentManifest = struct {
    name: String,
    imports: List[ComponentImport],
    import_count: Int,
    exports: List[ComponentExport],
    export_count: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn comp_item_desc_new(kind: Int, index: Int) -> ComponentItemDesc {
    return ComponentItemDesc {
        item_kind: kind,
        item_index: index
    };
}

pub fn component_import_new(name: String, desc: ComponentItemDesc) -> ComponentImport {
    return ComponentImport {
        name: name,
        desc: desc
    };
}

pub fn component_export_new(name: String, desc: ComponentItemDesc) -> ComponentExport {
    return ComponentExport {
        name: name,
        desc: desc
    };
}

pub fn component_manifest_new(name: String) -> ComponentManifest {
    let empty_imports: List[ComponentImport] = list_new();
    let empty_exports: List[ComponentExport] = list_new();
    return ComponentManifest {
        name: name,
        imports: empty_imports,
        import_count: 0,
        exports: empty_exports,
        export_count: 0
    };
}

// -------------------------------------------------------------------
// Manifest Mutations
// -------------------------------------------------------------------

pub fn component_manifest_add_import(mut m: ComponentManifest, imp: ComponentImport) -> ComponentManifest {
    let mut imps: List[ComponentImport] = (m).imports;
    imps = list_push(imps, imp);
    m.imports = imps;
    m.import_count = (m).import_count + 1;
    return m;
}

pub fn component_manifest_add_export(mut m: ComponentManifest, exp: ComponentExport) -> ComponentManifest {
    let mut exps: List[ComponentExport] = (m).exports;
    exps = list_push(exps, exp);
    m.exports = exps;
    m.export_count = (m).export_count + 1;
    return m;
}
