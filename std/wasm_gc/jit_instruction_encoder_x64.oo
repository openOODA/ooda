// # JIT Instruction Encoder for x86-64
//
// Logline: Low-level byte encoding for x86-64 machine instructions, REX prefixes, and ModR/M addressing.
//
// Setup: Emits native binary instruction streams for ADD, SUB, MOV, CMP, JMP, and CALL on x86-64 CPUs.
//
// Beats:
//   1. Define EncodedBytes and X64Encoder structures.
//   2. Compute REX prefix byte for 64-bit operands and extended registers.
//   3. Emit ModR/M and SIB bytes for direct register-to-register and memory operand encodings.

pub type EncodedBytes = struct {
    bytes: List[Int],
    count: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn encoded_bytes_new() -> EncodedBytes {
    let empty_list: List[Int] = list_new();
    return EncodedBytes {
        bytes: empty_list,
        count: 0,
    };
}

pub fn encoded_bytes_add(mut eb: EncodedBytes, b: Int) -> EncodedBytes {
    let mut bs: List[Int] = (eb).bytes;
    bs = list_push(bs, b % 256);
    eb.bytes = bs;
    eb.count = (eb).count + 1;
    return eb;
}

// -------------------------------------------------------------------
// Byte Encoding Helpers
// -------------------------------------------------------------------

pub fn encode_rex_prefix(is_w: Int, is_r: Int, is_x: Int, is_b: Int) -> Int {
    let mut byte_val: Int = 64; // 0x40
    if is_w == 1 { byte_val = byte_val + 8; }
    if is_r == 1 { byte_val = byte_val + 4; }
    if is_x == 1 { byte_val = byte_val + 2; }
    if is_b == 1 { byte_val = byte_val + 1; }
    return byte_val;
}

pub fn encode_modrm(mod_mode: Int, reg_opcode: Int, rm: Int) -> Int {
    return ((mod_mode % 4) * 64) + ((reg_opcode % 8) * 8) + (rm % 8);
}

pub fn encode_x64_add_reg_reg(dst_reg: Int, src_reg: Int) -> EncodedBytes {
    let mut eb: EncodedBytes = encoded_bytes_new();
    // REX.W prefix for 64-bit ADD
    let rex: Int = encode_rex_prefix(1, 0, 0, 0);
    eb = encoded_bytes_add(eb, rex);
    // Opcode for ADD r/m64, r64 -> 0x01
    eb = encoded_bytes_add(eb, 1);
    // ModR/M: mod=3 (register-direct), reg=src_reg, rm=dst_reg
    let modrm: Int = encode_modrm(3, src_reg, dst_reg);
    eb = encoded_bytes_add(eb, modrm);
    return eb;
}

pub fn encode_x64_ret() -> EncodedBytes {
    let mut eb: EncodedBytes = encoded_bytes_new();
    eb = encoded_bytes_add(eb, 195); // 0xC3 (RET)
    return eb;
}
