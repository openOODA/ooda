// # WebAssembly Component Model Flatten ABI
//
// Logline: Core WebAssembly type flattening rules and MAX_FLAT_PARAMS memory indirection calculation.
//
// Setup: Maps compound WIT types (records, variants, lists, tuples) into flat sequences of core Wasm scalar types.
//
// Beats:
//   1. Define FlattenedTypeSeq and FlattenResult structures.
//   2. Compute core type counts for primitive and compound types.
//   3. Determine whether passing convention requires linear memory spill pointer.

pub type FlattenedTypeSeq = struct {
    core_types: List[Int], // 1: i32, 2: i64, 3: f32, 4: f64
    count: Int,
};

pub type FlattenResult = struct {
    flat_seq: FlattenedTypeSeq,
    uses_memory_indirection: Int, // 1: indirect pointer, 0: direct registers
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn flattened_type_seq_new() -> FlattenedTypeSeq {
    let empty_list: List[Int] = list_new();
    return FlattenedTypeSeq {
        core_types: empty_list,
        count: 0,
    };
}

pub fn flattened_type_seq_add(mut seq: FlattenedTypeSeq, core_type: Int) -> FlattenedTypeSeq {
    let mut ts: List[Int] = (seq).core_types;
    ts = list_push(ts, core_type);
    seq.core_types = ts;
    seq.count = (seq).count + 1;
    return seq;
}

// -------------------------------------------------------------------
// Flattening Calculation
// -------------------------------------------------------------------

pub fn flatten_type_kind(type_kind: Int) -> FlattenedTypeSeq {
    let mut seq: FlattenedTypeSeq = flattened_type_seq_new();
    
    // Primitive types: bool, s32, u32 -> single i32
    if type_kind <= 2 {
        seq = flattened_type_seq_add(seq, 1);
        return seq;
    }
    // s64, u64 -> single i64
    if type_kind == 3 || type_kind == 4 {
        seq = flattened_type_seq_add(seq, 2);
        return seq;
    }
    // f32 -> f32 (3), f64 -> f64 (4)
    if type_kind == 5 {
        seq = flattened_type_seq_add(seq, 3);
        return seq;
    }
    if type_kind == 6 {
        seq = flattened_type_seq_add(seq, 4);
        return seq;
    }
    // string / list -> (i32 ptr, i32 len)
    if type_kind == 7 || type_kind == 8 {
        seq = flattened_type_seq_add(seq, 1);
        seq = flattened_type_seq_add(seq, 1);
        return seq;
    }
    // Default fallback
    seq = flattened_type_seq_add(seq, 1);
    return seq;
}

pub fn should_pass_by_memory(param_count: Int) -> Int {
    // Canonical ABI: If total flattened core types > 16, pass as memory pointer
    if param_count > 16 {
        return 1;
    }
    return 0;
}
