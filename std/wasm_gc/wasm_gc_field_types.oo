type WasmGcField = struct {
    storage: Int,
    packed: Int
};

pub fn wasm_gc_field_new(storage: Int, packed: Int) -> WasmGcField {
    return WasmGcField {
        storage: storage,
        packed: packed
    };
}

pub fn wasm_gc_field_storage(f: WasmGcField) -> Int {
    return f.storage;
}
