// # WebAssembly Component Model WIT AST
//
// Logline: Abstract syntax tree nodes for WIT interfaces, worlds, types, and resource declarations.
//
// Setup: Encodes record fields, variant cases, flags, enum values, and exported function parameter signatures.
//
// Beats:
//   1. Define WitTypeNode, WitFuncParam, WitFuncSignature, and WitInterface structures.
//   2. Support record, variant, enum, flags, and resource AST representations.
//   3. Build complete WIT world container structures.

pub type WitField = struct {
    name: String,
    type_name: String,
};

pub type WitVariantCase = struct {
    name: String,
    payload_type: String, // empty if unit
};

pub type WitFuncParam = struct {
    param_name: String,
    param_type: String,
};

pub type WitFuncSignature = struct {
    func_name: String,
    params: List[WitFuncParam],
    param_count: Int,
    result_type: String,
};

pub type WitInterface = struct {
    name: String,
    functions: List[WitFuncSignature],
    func_count: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn wit_field_new(name: String, t_name: String) -> WitField {
    return WitField {
        name: name,
        type_name: t_name,
    };
}

pub fn wit_variant_case_new(name: String, payload: String) -> WitVariantCase {
    return WitVariantCase {
        name: name,
        payload_type: payload,
    };
}

pub fn wit_func_param_new(name: String, p_type: String) -> WitFuncParam {
    return WitFuncParam {
        param_name: name,
        param_type: p_type,
    };
}

pub fn wit_func_sig_new(name: String, res_type: String) -> WitFuncSignature {
    let empty_params: List[WitFuncParam] = list_new();
    return WitFuncSignature {
        func_name: name,
        params: empty_params,
        param_count: 0,
        result_type: res_type,
    };
}

pub fn wit_func_sig_add_param(mut sig: WitFuncSignature, p: WitFuncParam) -> WitFuncSignature {
    let mut ps: List[WitFuncParam] = (sig).params;
    ps = list_push(ps, p);
    sig.params = ps;
    sig.param_count = (sig).param_count + 1;
    return sig;
}

pub fn wit_interface_new(name: String) -> WitInterface {
    let empty_funcs: List[WitFuncSignature] = list_new();
    return WitInterface {
        name: name,
        functions: empty_funcs,
        func_count: 0,
    };
}

pub fn wit_interface_add_func(mut iface: WitInterface, f: WitFuncSignature) -> WitInterface {
    let mut fs: List[WitFuncSignature] = (iface).functions;
    fs = list_push(fs, f);
    iface.functions = fs;
    iface.func_count = (iface).func_count + 1;
    return iface;
}
