// # WebAssembly Component Model Type Section
//
// Logline: Component Model binary type section encoding for instance types, component types, and defined interfaces.
//
// Setup: Generates binary type section entries according to the WebAssembly Component Model binary specification.
//
// Beats:
//   1. Define ComponentTypeDecl and ComponentTypeSection structures.
//   2. Encode core and component type declarations.
//   3. Index component interface definitions.

pub type ComponentTypeDecl = struct {
    tag: Int, // 1: Defined, 2: Func, 3: Component, 4: Instance, 5: Resource
    type_name: String,
    param_count: Int,
    result_count: Int,
};

pub type ComponentTypeSection = struct {
    types: List[ComponentTypeDecl],
    type_count: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn comp_type_decl_new(tag: Int, name: String, params: Int, results: Int) -> ComponentTypeDecl {
    return ComponentTypeDecl {
        tag: tag,
        type_name: name,
        param_count: params,
        result_count: results,
    };
}

pub fn component_type_section_new() -> ComponentTypeSection {
    let empty_types: List[ComponentTypeDecl] = list_new();
    return ComponentTypeSection {
        types: empty_types,
        type_count: 0,
    };
}

// -------------------------------------------------------------------
// Type Section Operations
// -------------------------------------------------------------------

pub fn component_type_section_add(mut sec: ComponentTypeSection, decl: ComponentTypeDecl) -> ComponentTypeSection {
    let mut ts: List[ComponentTypeDecl] = (sec).types;
    ts = list_push(ts, decl);
    sec.types = ts;
    sec.type_count = (sec).type_count + 1;
    return sec;
}

pub fn component_type_section_get(sec: ComponentTypeSection, index: Int) -> ComponentTypeDecl {
    if index >= 0 && index < (sec).type_count {
        return list_get((sec).types, index);
    }
    return comp_type_decl_new(0, "UNKNOWN", 0, 0);
}
