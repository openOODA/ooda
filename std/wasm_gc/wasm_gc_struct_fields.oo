// # WebAssembly GC Struct Fields Accessor
//
// Logline: Field accessors, sign extension for packed fields, and mutability validation for GC struct instances.
//
// Setup: Implements struct.get, struct.get_s, struct.get_u, and struct.set operations with bounds and sign extension.
//
// Beats:
//   1. Define FieldAccessResult structure.
//   2. Implement field reading with signed/unsigned i8/i16 decoding.
//   3. Implement field writing with mutability verification.

import "./wasm_gc_struct_new.oo";

pub type FieldAccessResult = struct {
    value: Int,
    is_success: Int,
    error_code: Int // 0: OK, 1: Out of bounds, 2: Immutable field
};

// -------------------------------------------------------------------
// Accessor Helpers
// -------------------------------------------------------------------

pub fn sign_extend_8(val: Int) -> Int {
    let b: Int = val % 256;
    if b >= 128 {
        return b - 256;
    }
    return b;
}

pub fn sign_extend_16(val: Int) -> Int {
    let b: Int = val % 65536;
    if b >= 32768 {
        return b - 65536;
    }
    return b;
}

// -------------------------------------------------------------------
// Field Operations
// -------------------------------------------------------------------

pub fn gc_struct_get(inst: GcStructInstance, field_idx: Int) -> FieldAccessResult {
    if field_idx < 0 || field_idx >= (inst).field_count {
        return FieldAccessResult { value: 0, is_success: 0, error_code: 1 };
    }
    let raw: Int = list_get((inst).field_values, field_idx);
    return FieldAccessResult { value: raw, is_success: 1, error_code: 0 };
}

pub fn gc_struct_get_s(inst: GcStructInstance, field_idx: Int, packed_tag: Int) -> FieldAccessResult {
    let res: FieldAccessResult = gc_struct_get(inst, field_idx);
    if (res).is_success == 0 {
        return res;
    }
    let mut v: Int = (res).value;
    if packed_tag == 2 {
        v = sign_extend_8(v);
    }
    if packed_tag == 3 {
        v = sign_extend_16(v);
    }
    return FieldAccessResult { value: v, is_success: 1, error_code: 0 };
}

pub fn gc_struct_get_u(inst: GcStructInstance, field_idx: Int, packed_tag: Int) -> FieldAccessResult {
    let res: FieldAccessResult = gc_struct_get(inst, field_idx);
    if (res).is_success == 0 {
        return res;
    }
    let mut v: Int = (res).value;
    if packed_tag == 2 {
        v = v % 256;
    }
    if packed_tag == 3 {
        v = v % 65536;
    }
    return FieldAccessResult { value: v, is_success: 1, error_code: 0 };
}

pub fn gc_struct_set(mut inst: GcStructInstance, field_idx: Int, new_val: Int, is_mutable: Int) -> GcStructInstance {
    if is_mutable == 0 {
        return inst;
    }
    if field_idx >= 0 && field_idx < (inst).field_count {
        let mut vals: List[Int] = list_new();
        let mut i: Int = 0;
        let count: Int = (inst).field_count;
        while i < count {
            if i == field_idx {
                vals = list_push(vals, new_val);
            } else {
                vals = list_push(vals, list_get((inst).field_values, i));
            }
            i = i + 1;
        }
        inst.field_values = vals;
    }
    return inst;
}
