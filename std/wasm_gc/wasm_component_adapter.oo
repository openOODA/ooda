// # WebAssembly Component Model Canonical Adapter
//
// Logline: Canonical adapter shims translating legacy WASI Preview 1 calls to Preview 2 Component Model streams.
//
// Setup: Maps POSIX file descriptor calls (fd_read, fd_write, fd_seek) to Component Model resource streams.
//
// Beats:
//   1. Define WasiP1Call and AdapterTranslation structures.
//   2. Translate fd_read and fd_write to stream resource invocations.
//   3. Manage errno error code mappings.

pub type WasiP1Call = struct {
    call_id: Int, // 1: fd_read, 2: fd_write, 3: fd_close, 4: fd_seek
    fd: Int,
    buffer_ptr: Int,
    buffer_len: Int,
};

pub type AdapterTranslation = struct {
    p2_resource_handle: Int,
    p2_operation: Int, // 1: read_stream, 2: write_stream, 3: drop_stream
    translated_bytes: Int,
    errno_code: Int, // 0: SUCCESS, 8: EBADF, 28: ENOSPC
};

// -------------------------------------------------------------------
// Errno Constants
// -------------------------------------------------------------------

pub fn wasi_errno_success() -> Int { return 0; }
pub fn wasi_errno_ebadf() -> Int { return 8; }
pub fn wasi_errno_einval() -> Int { return 28; }

// -------------------------------------------------------------------
// Translation Logic
// -------------------------------------------------------------------

pub fn translate_wasi_p1_call(call: WasiP1Call, stream_handle: Int) -> AdapterTranslation {
    if (call).fd < 0 {
        return AdapterTranslation {
            p2_resource_handle: -1,
            p2_operation: 0,
            translated_bytes: 0,
            errno_code: wasi_errno_ebadf(),
        };
    }
    
    if (call).call_id == 1 {
        // fd_read -> read_stream
        return AdapterTranslation {
            p2_resource_handle: stream_handle,
            p2_operation: 1,
            translated_bytes: (call).buffer_len,
            errno_code: wasi_errno_success(),
        };
    }
    
    if (call).call_id == 2 {
        // fd_write -> write_stream
        return AdapterTranslation {
            p2_resource_handle: stream_handle,
            p2_operation: 2,
            translated_bytes: (call).buffer_len,
            errno_code: wasi_errno_success(),
        };
    }
    
    if (call).call_id == 3 {
        // fd_close -> drop_stream
        return AdapterTranslation {
            p2_resource_handle: stream_handle,
            p2_operation: 3,
            translated_bytes: 0,
            errno_code: wasi_errno_success(),
        };
    }
    
    return AdapterTranslation {
        p2_resource_handle: -1,
        p2_operation: 0,
        translated_bytes: 0,
        errno_code: wasi_errno_einval(),
    };
}
