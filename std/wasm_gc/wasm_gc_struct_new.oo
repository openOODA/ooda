// # WebAssembly GC Struct New Allocation
//
// Logline: Allocation and initialization logic for GC struct instances with layout computation and default fields.
//
// Setup: Pre-computes byte offsets for struct fields and provides initialization buffers for GC runtime allocation.
//
// Beats:
//   1. Define GcStructDescriptor, StructFieldInit, and GcStructInstance structures.
//   2. Compute aggregate memory layout with padding alignment.
//   3. Allocate struct instances with field values or zeroed defaults.

import "./wasm_gc_field_types.oo";

pub type StructFieldInit = struct {
    field_index: Int,
    int_value: Int,
    ref_value_id: Int
};

pub type GcStructDescriptor = struct {
    type_index: Int,
    fields: List[FieldType],
    field_count: Int,
    total_size_bytes: Int
};

pub type GcStructInstance = struct {
    type_index: Int,
    instance_id: Int,
    field_values: List[Int],
    field_count: Int,
    is_alive: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn gc_struct_descriptor_new(type_idx: Int) -> GcStructDescriptor {
    let empty_fields: List[FieldType] = list_new();
    return GcStructDescriptor {
        type_index: type_idx,
        fields: empty_fields,
        field_count: 0,
        total_size_bytes: 8 // 8-byte object header
    };
}

pub fn gc_struct_descriptor_add_field(mut desc: GcStructDescriptor, st: StorageType, is_mut: Int) -> GcStructDescriptor {
    let sz: Int = field_size_bytes(st);
    let al: Int = field_alignment_bytes(st);
    
    let mut current_offset: Int = (desc).total_size_bytes;
    let rem: Int = current_offset % al;
    if rem != 0 {
        current_offset = current_offset + (al - rem);
    }
    
    let f: FieldType = field_type_new(st, is_mut, current_offset);
    let mut fs: List[FieldType] = (desc).fields;
    fs = list_push(fs, f);
    desc.fields = fs;
    desc.field_count = (desc).field_count + 1;
    desc.total_size_bytes = current_offset + sz;
    return desc;
}

pub fn gc_struct_new(type_idx: Int, inst_id: Int, init_values: List[Int], count: Int) -> GcStructInstance {
    return GcStructInstance {
        type_index: type_idx,
        instance_id: inst_id,
        field_values: init_values,
        field_count: count,
        is_alive: 1
    };
}

pub fn gc_struct_new_default(desc: GcStructDescriptor, inst_id: Int) -> GcStructInstance {
    let mut vals: List[Int] = list_new();
    let mut i: Int = 0;
    let count: Int = (desc).field_count;
    while i < count {
        vals = list_push(vals, 0);
        i = i + 1;
    }
    return GcStructInstance {
        type_index: (desc).type_index,
        instance_id: inst_id,
        field_values: vals,
        field_count: count,
        is_alive: 1
    };
}
