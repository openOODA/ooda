// # JIT Calling Convention ABI Engine
//
// Logline: ABI calling convention mappings for System V AMD64 and ARM64 AAPCS function calls.
//
// Setup: Maps logical parameter positions to physical argument registers or incoming stack frame offsets.
//
// Beats:
//   1. Define AbiArgLocation and CallConvPlan structures.
//   2. Compute argument register placements for System V AMD64 (RDI, RSI, RDX, RCX, R8, R9).
//   3. Compute argument register placements for ARM64 AAPCS (X0-X7).

pub type AbiArgLocation = struct {
    param_index: Int,
    is_in_register: Int, // 1: physical reg, 0: stack slot
    register_id: Int,
    stack_byte_offset: Int,
};

pub type CallConvPlan = struct {
    arch_type: Int, // 1: x86_64, 2: aarch64
    arg_locations: List[AbiArgLocation],
    arg_count: Int,
    stack_args_size: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn call_conv_plan_new(arch: Int) -> CallConvPlan {
    let empty_locs: List[AbiArgLocation] = list_new();
    return CallConvPlan {
        arch_type: arch,
        arg_locations: empty_locs,
        arg_count: 0,
        stack_args_size: 0,
    };
}

// -------------------------------------------------------------------
// ABI Planners
// -------------------------------------------------------------------

pub fn plan_sysv_amd64_args(num_args: Int) -> CallConvPlan {
    let mut plan: CallConvPlan = call_conv_plan_new(1);
    let sysv_regs: List[Int] = list_push(list_push(list_push(list_push(list_push(list_push(list_new(), 7), 6), 2), 1), 8), 9);
    
    let mut locs: List[AbiArgLocation] = list_new();
    let mut i: Int = 0;
    let mut stack_off: Int = 0;
    
    while i < num_args {
        if i < 6 {
            let reg: Int = list_get(sysv_regs, i);
            let loc: AbiArgLocation = AbiArgLocation {
                param_index: i,
                is_in_register: 1,
                register_id: reg,
                stack_byte_offset: 0,
            };
            locs = list_push(locs, loc);
        } else {
            let loc: AbiArgLocation = AbiArgLocation {
                param_index: i,
                is_in_register: 0,
                register_id: -1,
                stack_byte_offset: stack_off,
            };
            locs = list_push(locs, loc);
            stack_off = stack_off + 8;
        }
        i = i + 1;
    }
    
    plan.arg_locations = locs;
    plan.arg_count = num_args;
    plan.stack_args_size = stack_off;
    return plan;
}
