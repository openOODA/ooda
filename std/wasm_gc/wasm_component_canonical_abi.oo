// # WebAssembly Component Model Canonical ABI
//
// Logline: Canonical ABI lifting, lowering, realloc memory management, and post-return cleanup.
//
// Setup: Bridges high-level WIT types to flat core WebAssembly linear memory layout with typed byte offsets.
//
// Beats:
//   1. Define CanonicalAbiOptions and FlatVal structures.
//   2. Compute byte alignment and size for compound component data structures.
//   3. Implement lift and lower transformations across linear memory.

pub type FlatVal = struct {
    tag: Int, // 1: i32, 2: i64, 3: f32, 4: f64
    i32_val: Int,
    i64_val: Int
};

pub type CanonicalAbiOptions = struct {
    memory_idx: Int,
    realloc_func_idx: Int,
    post_return_func_idx: Int,
    string_encoding: Int // 0: UTF-8, 1: UTF-16, 2: Compact UTF-16
};

pub type MemorySlice = struct {
    pointer: Int,
    length: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn flat_val_i32(val: Int) -> FlatVal {
    return FlatVal {
        tag: 1,
        i32_val: val,
        i64_val: 0
    };
}

pub fn flat_val_i64(val: Int) -> FlatVal {
    return FlatVal {
        tag: 2,
        i32_val: 0,
        i64_val: val
    };
}

pub fn canonical_abi_options_default() -> CanonicalAbiOptions {
    return CanonicalAbiOptions {
        memory_idx: 0,
        realloc_func_idx: 0,
        post_return_func_idx: -1,
        string_encoding: 0
    };
}

pub fn memory_slice_new(ptr: Int, len: Int) -> MemorySlice {
    return MemorySlice {
        pointer: ptr,
        length: len
    };
}

// -------------------------------------------------------------------
// Layout and Alignment Helpers
// -------------------------------------------------------------------

pub fn abi_align_to(val: Int, align: Int) -> Int {
    let rem: Int = val % align;
    if rem == 0 {
        return val;
    }
    return val + (align - rem);
}

pub fn abi_compute_record_size(field_sizes: List[Int], field_aligns: List[Int], count: Int) -> Int {
    let mut offset: Int = 0;
    let mut max_align: Int = 1;
    let mut i: Int = 0;
    while i < count {
        let sz: Int = list_get(field_sizes, i);
        let al: Int = list_get(field_aligns, i);
        if al > max_align {
            max_align = al;
        }
        offset = abi_align_to(offset, al);
        offset = offset + sz;
        i = i + 1;
    }
    return abi_align_to(offset, max_align);
}
