// # WebAssembly GC Array Length and Indexing
//
// Logline: Element indexing, length inspection, and signed/unsigned element retrieval for GC arrays.
//
// Setup: Implements array.len, array.get, array.get_s, array.get_u, and array.set instructions.
//
// Beats:
//   1. Define ArrayAccessResult structure.
//   2. Query GC array length and validate index bounds.
//   3. Read and write array elements with sign extension.

import "./wasm_gc_array_new.oo";
import "./wasm_gc_struct_fields.oo";

pub type ArrayAccessResult = struct {
    value: Int,
    is_success: Int,
    error_code: Int, // 0: OK, 1: Out of bounds, 2: Immutable array
};

// -------------------------------------------------------------------
// Array Length and Element Access
// -------------------------------------------------------------------

pub fn gc_array_len(arr: GcArrayInstance) -> Int {
    return (arr).length;
}

pub fn gc_array_get(arr: GcArrayInstance, index: Int) -> ArrayAccessResult {
    if index < 0 || index >= (arr).length {
        return ArrayAccessResult { value: 0, is_success: 0, error_code: 1 };
    }
    let val: Int = list_get((arr).elements, index);
    return ArrayAccessResult { value: val, is_success: 1, error_code: 0 };
}

pub fn gc_array_get_s(arr: GcArrayInstance, index: Int, packed_tag: Int) -> ArrayAccessResult {
    let res: ArrayAccessResult = gc_array_get(arr, index);
    if (res).is_success == 0 {
        return res;
    }
    let mut v: Int = (res).value;
    if packed_tag == 2 {
        v = sign_extend_8(v);
    }
    if packed_tag == 3 {
        v = sign_extend_16(v);
    }
    return ArrayAccessResult { value: v, is_success: 1, error_code: 0 };
}

pub fn gc_array_get_u(arr: GcArrayInstance, index: Int, packed_tag: Int) -> ArrayAccessResult {
    let res: ArrayAccessResult = gc_array_get(arr, index);
    if (res).is_success == 0 {
        return res;
    }
    let mut v: Int = (res).value;
    if packed_tag == 2 {
        v = v % 256;
    }
    if packed_tag == 3 {
        v = v % 65536;
    }
    return ArrayAccessResult { value: v, is_success: 1, error_code: 0 };
}

pub fn gc_array_set(mut arr: GcArrayInstance, index: Int, new_val: Int, is_mutable: Int) -> GcArrayInstance {
    if is_mutable == 0 {
        return arr;
    }
    if index >= 0 && index < (arr).length {
        let mut new_elems: List[Int] = list_new();
        let mut i: Int = 0;
        let len: Int = (arr).length;
        while i < len {
            if i == index {
                new_elems = list_push(new_elems, new_val);
            } else {
                new_elems = list_push(new_elems, list_get((arr).elements, i));
            }
            i = i + 1;
        }
        arr.elements = new_elems;
    }
    return arr;
}

pub fn wasm_gc_array_len_probe() -> Int {
    return 0;
}
