// # WebAssembly GC Type Checker
//
// Logline: Unified type checking, subtyping evaluation, and bottom type verification for Wasm GC expressions.
//
// Setup: Evaluates value types against expected target types considering nominal hierarchy, nullability, and top/bottom heap types.
//
// Beats:
//   1. Define GcTypeChecker context with TypeHierarchy reference.
//   2. Implement is_val_subtype checking for numeric and reference types.
//   3. Compute least common supertype (join) for branching expressions.

import "./wasm_gc_type_hierarchy.oo";
import "./wasm_gc_heap_types.oo";
import "./wasm_gc_field_types.oo";

pub type GcTypeChecker = struct {
    hierarchy: TypeHierarchy,
    error_count: Int,
    last_error: String,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn gc_type_checker_new(hier: TypeHierarchy) -> GcTypeChecker {
    return GcTypeChecker {
        hierarchy: hier,
        error_count: 0,
        last_error: "",
    };
}

// -------------------------------------------------------------------
// Subtyping Logic
// -------------------------------------------------------------------

pub fn is_heap_subtype(hier: TypeHierarchy, sub: HeapType, sup: HeapType) -> Bool {
    // Nullability check: non-null cannot be assigned null unless target is nullable
    if (sub).is_nullable == 1 && (sup).is_nullable == 0 {
        return false;
    }
    
    // Abstract subtyping
    if (sub).kind < 10 && (sup).kind < 10 {
        return is_abstract_subtype(sub, sup);
    }
    
    // Concrete to abstract: any concrete struct/array is subtype of 'any' and 'eq'
    if (sub).kind == 10 && (sup).kind == 0 {
        return true; // any
    }
    if (sub).kind == 10 && (sup).kind == 1 {
        return true; // eq
    }
    
    // Concrete to concrete: check nominal hierarchy
    if (sub).kind == 10 && (sup).kind == 10 {
        return type_hierarchy_is_subtype_of(hier, (sub).type_index, (sup).type_index);
    }
    
    // Abstract bottom 'none' is subtype of any concrete
    if (sub).kind == 7 && (sup).kind == 10 {
        return true;
    }
    
    return false;
}

pub fn is_val_subtype(hier: TypeHierarchy, sub: ValType, sup: ValType) -> Bool {
    if (sub).tag != (sup).tag {
        return false;
    }
    if (sub).tag == 6 {
        return is_heap_subtype(hier, (sub).heap_type, (sup).heap_type);
    }
    return true;
}

pub fn check_type_match(mut checker: GcTypeChecker, actual: ValType, expected: ValType) -> GcTypeChecker {
    let ok: Bool = is_val_subtype((checker).hierarchy, actual, expected);
    if !ok {
        checker.error_count = (checker).error_count + 1;
        checker.last_error = "Type mismatch: actual is not subtype of expected";
    }
    return checker;
}

pub fn wasm_gc_type_checker_probe() -> Int {
    return 0;
}
