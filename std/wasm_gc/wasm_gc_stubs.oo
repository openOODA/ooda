// # WebAssembly GC, Component Model and JIT Diagnostic Stubs
//
// Logline: Diagnostic test fixtures, synthetic GC type hierarchies, mock component manifests, and JIT IR programs.
//
// Setup: Pre-constructs sample GC struct types, component worlds, and SSA machine instructions for testing compiler pipelines.
//
// Beats:
//   1. Build synthetic recursive type hierarchy with base and derived struct types.
//   2. Generate sample WIT interface AST with functions and parameters.
//   3. Construct arithmetic SSA JIT basic blocks for test suites.

import "./wasm_gc_type_hierarchy.oo";
import "./wasm_gc_heap_types.oo";
import "./wasm_gc_field_types.oo";
import "./wasm_gc_struct_new.oo";
import "./wasm_gc_array_new.oo";
import "./wasm_component_wit_ast.oo";
import "./jit_cranelift_machine_ir.oo";

pub type WasmGcStubSuite = struct {
    suite_name: String,
    num_test_hierarchies: Int,
    num_test_components: Int,
    num_test_jit_blocks: Int,
    is_available: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn wasm_gc_stubs_default() -> WasmGcStubSuite {
    return WasmGcStubSuite {
        suite_name: "openOODA-Wasm-GC-Component-JIT-Suite",
        num_test_hierarchies: 5,
        num_test_components: 10,
        num_test_jit_blocks: 8,
        is_available: 1
    };
}

pub fn generate_sample_type_hierarchy() -> TypeHierarchy {
    let mut hier: TypeHierarchy = type_hierarchy_new();
    
    // Type 0: Base struct (open)
    let t0: GcTypeDef = gc_type_def_new(0, -1, 0, gc_comp_struct(), 0);
    // Type 1: Derived struct (subtypes 0)
    let t1: GcTypeDef = gc_type_def_new(1, 0, 1, gc_comp_struct(), 0);
    // Type 2: Array of i32
    let t2: GcTypeDef = gc_type_def_new(2, -1, 1, gc_comp_array(), 0);
    
    hier = type_hierarchy_add_type(hier, t0);
    hier = type_hierarchy_add_type(hier, t1);
    hier = type_hierarchy_add_type(hier, t2);
    
    let g: RecGroup = rec_group_new(0, 0, 3);
    hier = type_hierarchy_add_rec_group(hier, g);
    return hier;
}

pub fn generate_sample_wit_interface() -> WitInterface {
    let mut iface: WitInterface = wit_interface_new("calculator");
    let mut sig: WitFuncSignature = wit_func_sig_new("add", "s32");
    sig = wit_func_sig_add_param(sig, wit_func_param_new("a", "s32"));
    sig = wit_func_sig_add_param(sig, wit_func_param_new("b", "s32"));
    iface = wit_interface_add_func(iface, sig);
    return iface;
}

pub fn generate_sample_jit_block() -> JirBlock {
    let mut blk: JirBlock = jir_block_new(0);
    let i1: JirInstruction = jir_inst_new(1, 1, 3, 1, 2, -1); // v3 = iadd v1, v2
    let i2: JirInstruction = jir_inst_new(2, 9, -1, 3, 0, -1); // ret v3
    blk = jir_block_add_inst(blk, i1);
    blk = jir_block_add_inst(blk, i2);
    return blk;
}
