// # WebAssembly GC Array Copy Engine
//
// Logline: Bulk memory operations, overlapping array copy, fill patterns, and bounds validation for GC arrays.
//
// Setup: Implements array.copy and array.fill semantics with strict boundary checks and source-to-destination transfer.
//
// Beats:
//   1. Define ArrayCopyResult structure.
//   2. Validate range bounds for copy and fill operations.
//   3. Perform element copying across GC array instances.

import "./wasm_gc_array_new.oo";

pub type ArrayCopyResult = struct {
    elements_copied: Int,
    is_success: Int,
    error_code: Int // 0: OK, 1: Out of bounds, 2: Immutable target
};

// -------------------------------------------------------------------
// Bounds Validation
// -------------------------------------------------------------------

pub fn check_array_bounds(len: Int, offset: Int, count: Int) -> Bool {
    if offset < 0 || count < 0 {
        return false;
    }
    if offset + count > len {
        return false;
    }
    return true;
}

// -------------------------------------------------------------------
// Array Operations
// -------------------------------------------------------------------

pub fn gc_array_fill(mut target: GcArrayInstance, offset: Int, fill_val: Int, count: Int) -> GcArrayInstance {
    let ok: Bool = check_array_bounds((target).length, offset, count);
    if !ok {
        return target;
    }
    let mut new_elems: List[Int] = list_new();
    let mut i: Int = 0;
    let len: Int = (target).length;
    while i < len {
        if i >= offset && i < (offset + count) {
            new_elems = list_push(new_elems, fill_val);
        } else {
            new_elems = list_push(new_elems, list_get((target).elements, i));
        }
        i = i + 1;
    }
    target.elements = new_elems;
    return target;
}

pub fn gc_array_copy(mut dst: GcArrayInstance, dst_off: Int, src: GcArrayInstance, src_off: Int, count: Int) -> GcArrayInstance {
    let ok_src: Bool = check_array_bounds((src).length, src_off, count);
    let ok_dst: Bool = check_array_bounds((dst).length, dst_off, count);
    if !ok_src || !ok_dst {
        return dst;
    }
    
    // Extract source slice
    let mut src_slice: List[Int] = list_new();
    let mut k: Int = 0;
    while k < count {
        let v: Int = list_get((src).elements, src_off + k);
        src_slice = list_push(src_slice, v);
        k = k + 1;
    }
    
    // Apply to destination
    let mut new_elems: List[Int] = list_new();
    let mut i: Int = 0;
    let len: Int = (dst).length;
    while i < len {
        if i >= dst_off && i < (dst_off + count) {
            let slice_idx: Int = i - dst_off;
            new_elems = list_push(new_elems, list_get(src_slice, slice_idx));
        } else {
            new_elems = list_push(new_elems, list_get((dst).elements, i));
        }
        i = i + 1;
    }
    dst.elements = new_elems;
    return dst;
}
