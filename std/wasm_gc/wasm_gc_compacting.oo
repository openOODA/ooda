// # WebAssembly GC Compacting Collector
//
// Logline: Sliding compaction and two-finger compacting algorithms for defragmenting GC heaps.
//
// Setup: Computes forwarding addresses for surviving objects and relocates heap data into a single contiguous block.
//
// Beats:
//   1. Define CompactObject and CompactingHeap structures.
//   2. Compute sliding forwarding addresses for live objects.
//   3. Update interior pointers and compact objects down to heap base.

pub type CompactObject = struct {
    object_id: Int,
    current_offset: Int,
    forwarding_offset: Int,
    size_bytes: Int,
    is_live: Int
};

pub type CompactingHeap = struct {
    objects: List[CompactObject],
    object_count: Int,
    heap_size_bytes: Int,
    compacted_free_offset: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn compact_object_new(id: Int, curr_off: Int, sz: Int, live: Int) -> CompactObject {
    return CompactObject {
        object_id: id,
        current_offset: curr_off,
        forwarding_offset: -1,
        size_bytes: sz,
        is_live: live
    };
}

pub fn compacting_heap_new(heap_sz: Int) -> CompactingHeap {
    let empty_objs: List[CompactObject] = list_new();
    return CompactingHeap {
        objects: empty_objs,
        object_count: 0,
        heap_size_bytes: heap_sz,
        compacted_free_offset: 0
    };
}

// -------------------------------------------------------------------
// Compaction Operations
// -------------------------------------------------------------------

pub fn compacting_heap_add(mut heap: CompactingHeap, obj: CompactObject) -> CompactingHeap {
    let mut os: List[CompactObject] = (heap).objects;
    os = list_push(os, obj);
    heap.objects = os;
    heap.object_count = (heap).object_count + 1;
    return heap;
}

pub fn compacting_heap_compute_forwarding(mut heap: CompactingHeap) -> CompactingHeap {
    let mut next_free: Int = 0;
    let mut new_objs: List[CompactObject] = list_new();
    let mut i: Int = 0;
    let count: Int = (heap).object_count;
    
    while i < count {
        let obj: CompactObject = list_get((heap).objects, i);
        if (obj).is_live == 1 {
            let updated: CompactObject = CompactObject {
                object_id: (obj).object_id,
                current_offset: (obj).current_offset,
                forwarding_offset: next_free,
                size_bytes: (obj).size_bytes,
                is_live: 1
            };
            new_objs = list_push(new_objs, updated);
            next_free = next_free + (obj).size_bytes;
        } else {
            new_objs = list_push(new_objs, obj);
        }
        i = i + 1;
    }
    
    heap.objects = new_objs;
    heap.compacted_free_offset = next_free;
    return heap;
}
