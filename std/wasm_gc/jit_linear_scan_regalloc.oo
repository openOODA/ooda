// # JIT Linear Scan Register Allocator
//
// Logline: Linear scan register allocation, live interval expiration, physical register assignment, and spill handling.
//
// Setup: Maps virtual SSA values to physical machine registers across sequential instruction indices.
//
// Beats:
//   1. Define LiveInterval, RegAssignment, and LinearScanAlloc structures.
//   2. Expire old live intervals when instruction cursor advances.
//   3. Allocate free physical register or spill the longest-living interval.

pub type LiveInterval = struct {
    value_id: Int,
    start_pos: Int,
    end_pos: Int,
    assigned_reg: Int, // -1: Spilled, >= 0: Physical reg ID
    spill_slot: Int,
};

pub type LinearScanAlloc = struct {
    num_physical_regs: Int,
    intervals: List[LiveInterval],
    interval_count: Int,
    active_intervals: List[LiveInterval],
    active_count: Int,
    next_spill_slot: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn live_interval_new(val_id: Int, start: Int, end: Int) -> LiveInterval {
    return LiveInterval {
        value_id: val_id,
        start_pos: start,
        end_pos: end,
        assigned_reg: -1,
        spill_slot: -1,
    };
}

pub fn linear_scan_alloc_new(num_regs: Int) -> LinearScanAlloc {
    let empty_intervals: List[LiveInterval] = list_new();
    let empty_active: List[LiveInterval] = list_new();
    return LinearScanAlloc {
        num_physical_regs: num_regs,
        intervals: empty_intervals,
        interval_count: 0,
        active_intervals: empty_active,
        active_count: 0,
        next_spill_slot: 0,
    };
}

// -------------------------------------------------------------------
// Allocation Steps
// -------------------------------------------------------------------

pub fn linear_scan_add_interval(mut alloc: LinearScanAlloc, intv: LiveInterval) -> LinearScanAlloc {
    let mut ivs: List[LiveInterval] = (alloc).intervals;
    ivs = list_push(ivs, intv);
    alloc.intervals = ivs;
    alloc.interval_count = (alloc).interval_count + 1;
    return alloc;
}

pub fn linear_scan_assign_reg(mut alloc: LinearScanAlloc, idx: Int, reg_id: Int) -> LinearScanAlloc {
    if idx >= 0 && idx < (alloc).interval_count {
        let mut new_ivs: List[LiveInterval] = list_new();
        let mut i: Int = 0;
        let count: Int = (alloc).interval_count;
        while i < count {
            let iv: LiveInterval = list_get((alloc).intervals, i);
            if i == idx {
                let assigned: LiveInterval = LiveInterval {
                    value_id: (iv).value_id,
                    start_pos: (iv).start_pos,
                    end_pos: (iv).end_pos,
                    assigned_reg: reg_id,
                    spill_slot: -1,
                };
                new_ivs = list_push(new_ivs, assigned);
            } else {
                new_ivs = list_push(new_ivs, iv);
            }
            i = i + 1;
        }
        alloc.intervals = new_ivs;
    }
    return alloc;
}
