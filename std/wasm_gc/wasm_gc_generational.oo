// # WebAssembly GC Generational Collector
//
// Logline: Generational garbage collection with nursery bump allocation, tenured space promotion, and card table tracking.
//
// Setup: Implements the weak generational hypothesis: nursery minor collections with dirty card barrier scanning.
//
// Beats:
//   1. Define CardTable and GenerationalHeap structures.
//   2. Allocate objects rapidly via nursery bump pointer.
//   3. Mark dirty card entries on old-to-young pointer mutation.

pub type CardTable = struct {
    cards: List[Int], // 0: clean, 1: dirty
    card_count: Int,
};

pub type GenerationalHeap = struct {
    nursery_capacity: Int,
    nursery_offset: Int,
    tenured_capacity: Int,
    tenured_offset: Int,
    card_table: CardTable,
    minor_gc_count: Int,
    major_gc_count: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn card_table_new(num_cards: Int) -> CardTable {
    let mut cs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_cards {
        cs = list_push(cs, 0);
        i = i + 1;
    }
    return CardTable {
        cards: cs,
        card_count: num_cards,
    };
}

pub fn generational_heap_new(nursery_sz: Int, tenured_sz: Int) -> GenerationalHeap {
    let num_cards: Int = tenured_sz / 512; // 512 bytes per card
    let ct: CardTable = card_table_new(num_cards);
    return GenerationalHeap {
        nursery_capacity: nursery_sz,
        nursery_offset: 0,
        tenured_capacity: tenured_sz,
        tenured_offset: 0,
        card_table: ct,
        minor_gc_count: 0,
        major_gc_count: 0,
    };
}

// -------------------------------------------------------------------
// Generational Operations
// -------------------------------------------------------------------

pub fn nursery_alloc(mut heap: GenerationalHeap, size_bytes: Int) -> Int {
    if (heap).nursery_offset + size_bytes <= (heap).nursery_capacity {
        let ptr: Int = (heap).nursery_offset;
        heap.nursery_offset = (heap).nursery_offset + size_bytes;
        return ptr;
    }
    return -1; // Nursery full, trigger minor GC
}

pub fn write_barrier_post(mut ct: CardTable, tenured_addr: Int) -> CardTable {
    let card_idx: Int = tenured_addr / 512;
    if card_idx >= 0 && card_idx < (ct).card_count {
        let mut new_cards: List[Int] = list_new();
        let mut i: Int = 0;
        let count: Int = (ct).card_count;
        while i < count {
            if i == card_idx {
                new_cards = list_push(new_cards, 1); // Dirty
            } else {
                new_cards = list_push(new_cards, list_get((ct).cards, i));
            }
            i = i + 1;
        }
        ct.cards = new_cards;
    }
    return ct;
}
