// # WebAssembly GC Ref Cast Engine
//
// Logline: Dynamic type casting, downcasting validation, and trap reporting for Wasm GC references.
//
// Setup: Implements ref.cast and ref.cast null semantics, producing narrowed reference types or raising type traps.
//
// Beats:
//   1. Define RefCastResult structure.
//   2. Validate downcasting rules against nominal hierarchy.
//   3. Handle cast success and error codes.

import "./wasm_gc_type_hierarchy.oo";
import "./wasm_gc_heap_types.oo";
import "./wasm_gc_ref_test.oo";

pub type RefCastResult = struct {
    ref_value: GcRefValue,
    is_success: Int,
    error_code: Int // 0: OK, 1: Cast trap (bad type), 2: Null trap
};

// -------------------------------------------------------------------
// Ref Cast Operations
// -------------------------------------------------------------------

pub fn gc_ref_cast(hier: TypeHierarchy, ref_val: GcRefValue, target_ht: HeapType) -> RefCastResult {
    // If input is null
    if (ref_val).is_null == 1 {
        if (target_ht).is_nullable == 1 {
            return RefCastResult {
                ref_value: ref_val,
                is_success: 1,
                error_code: 0
            };
        }
        // Casting null to non-nullable ref results in a trap
        return RefCastResult {
            ref_value: ref_val,
            is_success: 0,
            error_code: 2
        };
    }
    
    // Check type test
    let matches: Int = gc_ref_test(hier, ref_val, target_ht);
    if matches == 1 {
        return RefCastResult {
            ref_value: ref_val,
            is_success: 1,
            error_code: 0
        };
    }
    
    // Failed dynamic cast traps
    return RefCastResult {
        ref_value: ref_val,
        is_success: 0,
        error_code: 1
    };
}

pub fn wasm_gc_ref_cast_probe() -> Int {
    return 0;
}
