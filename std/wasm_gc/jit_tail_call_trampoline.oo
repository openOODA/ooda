// # JIT Tail Call Trampoline Engine
//
// Logline: Tail call optimization, caller frame recycling, argument repositioning, and jump trampolines.
//
// Setup: Emits return_call jump trampolines by reusing the caller's stack frame without growing stack space.
//
// Beats:
//   1. Define TailCallDescriptor and TailCallTrampoline structures.
//   2. Compute argument stack shift adjustments when target argument count differs from caller.
//   3. Emit frame deconstruction and tail jump instruction sequences.

pub type TailCallDescriptor = struct {
    callee_func_index: Int,
    caller_args_count: Int,
    callee_args_count: Int,
    caller_frame_size: Int,
};

pub type TailCallTrampoline = struct {
    descriptor: TailCallDescriptor,
    stack_delta_bytes: Int,
    requires_memmove: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn tail_call_descriptor_new(callee_idx: Int, caller_args: Int, callee_args: Int, frame_sz: Int) -> TailCallDescriptor {
    return TailCallDescriptor {
        callee_func_index: callee_idx,
        caller_args_count: caller_args,
        callee_args_count: callee_args,
        caller_frame_size: frame_sz,
    };
}

pub fn tail_call_trampoline_plan(desc: TailCallDescriptor) -> TailCallTrampoline {
    let diff_args: Int = (desc).callee_args_count - (desc).caller_args_count;
    let stack_delta: Int = diff_args * 8;
    let mut req_memmove: Int = 0;
    if diff_args > 0 {
        req_memmove = 1;
    }
    return TailCallTrampoline {
        descriptor: desc,
        stack_delta_bytes: stack_delta,
        requires_memmove: req_memmove,
    };
}
