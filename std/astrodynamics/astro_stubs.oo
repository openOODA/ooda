// # Astrodynamics Test Fixtures & Orbital Benchmarks
//
// Logline: Provides standardized benchmark orbital elements, ISS TLE records, and planetary transfer test fixtures.
//
// Setup: Imports kepler_orbit.oo, kepler_elements.oo, tle_parser.oo, and delta_v_budget.oo for orbital mock validation.
//
// Beats:
//   1. Provide verified NORAD Two-Line Element (TLE) string records for the International Space Station (ISS).
//   2. Define canonical orbital element sets for GTO, GEO, and high-eccentricity Molniya orbits.
//   3. Provide reference interplanetary transfer and mission delta-V benchmark fixtures.

import "./kepler_orbit.oo";
import "./kepler_elements.oo";
import "./tle_parser.oo";
import "./delta_v_budget.oo";

pub type AstroTestFixture = struct {
    fixture_id: Int,
    name_id: Int,
    semi_major_axis: Float,
    eccentricity: Float,
    inclination_deg: Float,
    target_dv: Float,
};

pub fn stub_iss_tle_line1() -> String {
    return "1 25544U 98067A   24001.50000000  .00016717  00000-0  10270-3 0  9001";
}

pub fn stub_iss_tle_line2() -> String {
    return "2 25544  51.6400 208.1000 0005000 130.0000 325.0000 15.50000000430005";
}

pub fn stub_iss_record() -> TleRecord {
    let l1: TleLine1 = tle_line1_new(25544, 24, 1.5, 0.0001027, 1);
    let l2: TleLine2 = tle_line2_new(25544, 51.64, 208.1, 0.0005, 130.0, 325.0, 15.5, 43000, 5);
    return tle_record_new(l1, l2, true);
}

pub fn stub_gto_elements() -> OrbitalElements {
    let pi_val: Float = 3.141592653589793;
    let deg2rad: Float = pi_val / 180.0;
    // GTO: Perigee ~200km (r=6578km), Apogee ~35786km (r=42164km), a = 24371km, e = 0.730
    return orbital_elements_new(
        24371000.0,
        0.730,
        28.5 * deg2rad,
        0.0,
        0.0,
        0.0
    );
}

pub fn stub_geo_elements() -> OrbitalElements {
    // GEO: r = 42164.14 km, e = 0.0001, i = 0.0 deg
    return orbital_elements_new(
        42164140.0,
        0.0001,
        0.0,
        0.0,
        0.0,
        0.0
    );
}

pub fn stub_molniya_elements() -> OrbitalElements {
    let pi_val: Float = 3.141592653589793;
    let deg2rad: Float = pi_val / 180.0;
    // Molniya: a = 26600 km, e = 0.74, i = 63.4 deg (critical inclination)
    return orbital_elements_new(
        26600000.0,
        0.74,
        63.435 * deg2rad,
        45.0 * deg2rad,
        270.0 * deg2rad,
        0.0
    );
}

pub fn stub_earth_mars_transfer_dv() -> Float {
    // Typical Earth-Mars Hohmann injection delta-V from LEO: ~3600 - 3900 m/s
    return 3600.0;
}

pub fn stub_fixture_get(id: Int) -> AstroTestFixture {
    if id == 1 {
        // ISS LEO fixture
        return AstroTestFixture {
            fixture_id: 1,
            name_id: 101,
            semi_major_axis: 6798000.0,
            eccentricity: 0.0005,
            inclination_deg: 51.64,
            target_dv: 100.0,
        };
    }
    if id == 2 {
        // GEO fixture
        return AstroTestFixture {
            fixture_id: 2,
            name_id: 102,
            semi_major_axis: 42164140.0,
            eccentricity: 0.0001,
            inclination_deg: 0.05,
            target_dv: 1500.0,
        };
    }
    // Deep space fixture
    return AstroTestFixture {
        fixture_id: 3,
        name_id: 103,
        semi_major_axis: 149597870700.0,
        eccentricity: 0.2056,
        inclination_deg: 1.85,
        target_dv: 3900.0,
    };
}
