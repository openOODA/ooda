// # Astrodynamics & Spacecraft Mechanics Unified Facade
//
// Logline: Re-exports orbital mechanics, Keplerian solvers, coordinate frames, attitude kinematics, propulsion, and tracking.
//
// Setup: Pure facade module importing all 24 modular astrodynamics, trajectory, and celestial navigation submodules.
//
// Beats:
//   1. Import 24 specialized spacecraft mechanics, orbital propagation, and attitude dynamics components.
//   2. Re-export public constructors, state propagators, coordinate converters, and trajectory solvers.
//   3. Maintain full API interoperability with downstream openOODA aerospace and physics callers.

import "./kepler_orbit.oo";
import "./kepler_elements.oo";
import "./anomaly_kepler_solver.oo";
import "./hohmann_transfer.oo";
import "./bi_elliptic_transfer.oo";
import "./tle_parser.oo";
import "./sgp4_propagator.oo";
import "./gravitational_j2_perturbation.oo";
import "./lagrange_points.oo";
import "./lambert_solver.oo";
import "./patched_conics.oo";
import "./coordinate_eci_ecef.oo";
import "./coordinate_orbital_plane.oo";
import "./julian_date.oo";
import "./sidereal_time.oo";
import "./attitude_quaternion.oo";
import "./attitude_reaction_wheels.oo";
import "./rcs_thruster_allocator.oo";
import "./delta_v_budget.oo";
import "./rocket_tsiolkovsky.oo";
import "./launch_trajectory.oo";
import "./re_entry_thermal_profile.oo";
import "./ground_station_pass.oo";
import "./astro_stubs.oo";

pub fn astro_shim_vec3(x: Float, y: Float, z: Float) -> Vector3 {
    return vec3_new(x, y, z);
}

pub fn astro_shim_kepler_orbit(a: Float, e: Float, mu: Float) -> KeplerOrbit {
    return kepler_orbit_new(a, e, mu);
}

pub fn astro_shim_orbital_elements(a: Float, e: Float, inc: Float, raan: Float, argp: Float, nu: Float) -> OrbitalElements {
    return orbital_elements_new(a, e, inc, raan, argp, nu);
}

pub fn astro_shim_state_vector(pos: Vector3, vel: Vector3) -> StateVector {
    return state_vector_new(pos, vel);
}

pub fn astro_shim_solve_anomaly(m_val: Float, e_val: Float) -> AnomalySolution {
    return mean_to_eccentric_anomaly(m_val, e_val, 0.000001, 50);
}

pub fn astro_shim_hohmann(r1: Float, r2: Float, mu: Float) -> HohmannTransfer {
    return hohmann_transfer_compute(r1, r2, mu);
}

pub fn astro_shim_bi_elliptic(r1: Float, r2: Float, rb: Float, mu: Float) -> BiEllipticTransfer {
    return bi_elliptic_transfer_compute(r1, r2, rb, mu);
}

pub fn astro_shim_tle_record(l1: TleLine1, l2: TleLine2, valid: Bool) -> TleRecord {
    return tle_record_new(l1, l2, valid);
}

pub fn astro_shim_sgp4_model(tle: TleRecord, mu: Float) -> Sgp4SatModel {
    return sgp4_init_model(tle, mu);
}

pub fn astro_shim_j2_rates(elem: OrbitalElements, mu: Float) -> J2PerturbationRates {
    return j2_perturbation_rates_compute(elem, mu);
}

pub fn astro_shim_lagrange(m1: Float, m2: Float, dist: Float) -> LagrangeSystem {
    return lagrange_system_compute(m1, m2, dist);
}

pub fn astro_shim_lambert(r1: Vector3, r2: Vector3, tof: Float, is_prograde: Bool, mu: Float) -> LambertResult {
    return lambert_solve(r1, r2, tof, is_prograde, mu, 40, 0.0001);
}

pub fn astro_shim_gravity_assist(v_inf: Float, rp: Float, v_planet: Float, mu: Float) -> PatchedConicFlyby {
    return gravity_assist_compute(v_inf, rp, v_planet, mu);
}

pub fn astro_shim_eci_to_ecef(eci: Vector3, gmst: Float) -> Vector3 {
    return eci_to_ecef(eci, gmst);
}

pub fn astro_shim_rsw_frame(pos: Vector3, vel: Vector3) -> RswFrame {
    return compute_rsw_frame(pos, vel);
}

pub fn astro_shim_julian_epoch(dt: DateTimeUtc) -> JulianEpoch {
    return julian_epoch_from_date(dt);
}

pub fn astro_shim_sidereal_times(dt: DateTimeUtc, lon_deg: Float) -> SiderealTimes {
    return sidereal_times_compute(dt, lon_deg);
}

pub fn astro_shim_quat_from_axis_angle(axis: Vector3, angle_rad: Float) -> Quaternion {
    return quat_from_axis_angle(axis, angle_rad);
}

pub fn astro_shim_rwa(inertia: Float, max_rpm: Float, max_tau: Float, angle_deg: Float) -> TetrahedralRwa {
    return tetrahedral_rwa_new(inertia, max_rpm, max_tau, angle_deg);
}

pub fn astro_shim_rcs_command(f: Vector3, tau: Vector3) -> RcsCommand {
    return rcs_command_new(f, tau);
}

pub fn astro_shim_delta_v_budget() -> MissionDeltaVBudget {
    return delta_v_budget_empty();
}

pub fn astro_shim_rocket_stage(num: Int, dry: Float, prop: Float, isp: Float) -> RocketStage {
    return rocket_stage_new(num, dry, prop, isp);
}

pub fn astro_shim_launch_state(t: Float, alt: Float, down: Float, v: Float, gamma: Float, m: Float, q: Float) -> LaunchState {
    return launch_state_new(t, alt, down, v, gamma, m, q);
}

pub fn astro_shim_reentry_state(alt: Float, v: Float, gamma: Float, q: Float, g: Float) -> ReEntryState {
    return ReEntryState { altitude_m: alt, velocity_m_s: v, flight_path_angle_rad: gamma, heat_flux_w_m2: q, g_load: g };
}

pub fn astro_shim_ground_station(id: Int, lat_deg: Float, lon_deg: Float, alt_m: Float, min_el_deg: Float) -> GroundStation {
    return ground_station_new(id, lat_deg, lon_deg, alt_m, min_el_deg);
}

pub fn astro_shim_iss_fixture() -> AstroTestFixture {
    return stub_fixture_get(1);
}
