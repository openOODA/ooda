// # Envelope Demodulation (HFRT) for Impact Bearing Diagnostics
//
// Logline: Demodulates high-frequency resonant carrier vibration to isolate low-frequency cyclic bearing impact pulses.
//
// Setup: Full-wave rectification followed by an IIR low-pass smoothing filter to recover modulation envelope.
//
// Beats:
//   1. Define EnvelopeDemodResult structure storing envelope waveform, peak modulation, and crest factor.
//   2. Apply full-wave absolute rectification to bandpassed vibration signal.
//   3. Filter rectified waveform with recursive exponential smoothing to extract envelope.

pub type EnvelopeDemodResult = struct {
    envelope_signal: List[Float],
    peak_envelope: Float,
    rms_envelope: Float,
    envelope_crest_factor: Float
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn envelope_demodulate(raw_bandpassed: &List[Float], smoothing_alpha: Float) -> EnvelopeDemodResult {
    let n: Int = list_len(*raw_bandpassed);
    let mut env: List[Float] = list_new();

    if n == 0 {
        return EnvelopeDemodResult {
            envelope_signal: env,
            peak_envelope: 0.0,
            rms_envelope: 0.0,
            envelope_crest_factor: 0.0
        };
    }

    let mut prev_env: Float = math_abs(list_get(*raw_bandpassed, 0));
    env = list_push(env, prev_env);

    let mut peak_val: Float = prev_env;
    let mut sum_sq: Float = prev_env * prev_env;

    let mut i: Int = 1;
    while i < n {
        let rectified: Float = math_abs(list_get(*raw_bandpassed, i));
        let cur_env: Float = (smoothing_alpha * rectified) + ((1.0 - smoothing_alpha) * prev_env);
        env = list_push(env, cur_env);

        if cur_env > peak_val {
            peak_val = cur_env;
        }
        sum_sq = sum_sq + (cur_env * cur_env);
        prev_env = cur_env;
        i = i + 1;
    }

    let n_f: Float = int_to_float(n);
    let rms: Float = math_sqrt(sum_sq / n_f);
    let cf: Float = if rms > 0.000001 { peak_val / rms } else { 0.0 };

    return EnvelopeDemodResult {
        envelope_signal: env,
        peak_envelope: peak_val,
        rms_envelope: rms,
        envelope_crest_factor: cf
    };
}
