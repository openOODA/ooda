// # Exponential & Multi-Order Moving Average Filters
//
// Logline: Computes simple, exponential, double exponential (DEMA), and triple exponential (TEMA) smoothing filters.
//
// Setup: Industrial sensor smoothing filters reducing latency while eliminating high-frequency telemetry noise.
//
// Beats:
//   1. Calculate windowed Simple Moving Average (SMA) and linear Weighted Moving Average (WMA).
//   2. Calculate Single Exponential Moving Average (EMA) with smoothing factor alpha.
//   3. Implement Double (DEMA) and Triple (TEMA) zero-lag exponential estimators.

pub type EmaFilterState = struct {
    alpha: Float,
    current_value: Float,
    initialized: Bool,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn ts_ema_filter_new(alpha: Float) -> EmaFilterState {
    return EmaFilterState {
        alpha: alpha,
        current_value: 0.0,
        initialized: false,
    };
}

pub fn ts_ema_step(state: &mut EmaFilterState, sample: Float) -> Float {
    if !(state).initialized {
        (state).current_value = sample;
        (state).initialized = true;
        return sample;
    }
    let next_val: Float = ((state).alpha * sample) + ((1.0 - (state).alpha) * (state).current_value);
    (state).current_value = next_val;
    return next_val;
}

pub fn ts_sma_rolling(series: &List[Float], window: Int) -> List[Float] {
    let n: Int = list_len(*series);
    let mut result: List[Float] = list_new();
    if n == 0 || window <= 0 {
        return result;
    }

    let win_f: Float = int_to_float(window);
    let mut i: Int = 0;
    while i < n {
        let mut sum: Float = 0.0;
        let mut count: Int = 0;
        let mut j: Int = 0;
        while j < window {
            let idx: Int = i - j;
            if idx >= 0 {
                sum = sum + list_get(*series, idx);
                count = count + 1;
            }
            j = j + 1;
        }
        let avg: Float = if count > 0 { sum / int_to_float(count) } else { 0.0 };
        result = list_push(result, avg);
        i = i + 1;
    }
    return result;
}

pub fn ts_ema_series(series: &List[Float], alpha: Float) -> List[Float] {
    let n: Int = list_len(*series);
    let mut result: List[Float] = list_new();
    if n == 0 {
        return result;
    }

    let mut prev: Float = list_get(*series, 0);
    result = list_push(result, prev);

    let mut i: Int = 1;
    while i < n {
        let x: Float = list_get(*series, i);
        let cur: Float = (alpha * x) + ((1.0 - alpha) * prev);
        result = list_push(result, cur);
        prev = cur;
        i = i + 1;
    }
    return result;
}

pub fn ts_dema_series(series: &List[Float], alpha: Float) -> List[Float] {
    let ema1: List[Float] = ts_ema_series(series, alpha);
    let ema2: List[Float] = ts_ema_series(&ema1, alpha);
    let n: Int = list_len(*series);
    let mut result: List[Float] = list_new();

    let mut i: Int = 0;
    while i < n {
        let e1: Float = list_get(ema1, i);
        let e2: Float = list_get(ema2, i);
        let dema_val: Float = (2.0 * e1) - e2;
        result = list_push(result, dema_val);
        i = i + 1;
    }
    return result;
}

pub fn ts_tema_series(series: &List[Float], alpha: Float) -> List[Float] {
    let ema1: List[Float] = ts_ema_series(series, alpha);
    let ema2: List[Float] = ts_ema_series(&ema1, alpha);
    let ema3: List[Float] = ts_ema_series(&ema2, alpha);
    let n: Int = list_len(*series);
    let mut result: List[Float] = list_new();

    let mut i: Int = 0;
    while i < n {
        let e1: Float = list_get(ema1, i);
        let e2: Float = list_get(ema2, i);
        let e3: Float = list_get(ema3, i);
        let tema_val: Float = (3.0 * e1) - (3.0 * e2) + e3;
        result = list_push(result, tema_val);
        i = i + 1;
    }
    return result;
}
