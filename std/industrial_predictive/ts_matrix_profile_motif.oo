// # Matrix Profile (STAMP/STOMP) & Motif Discovery
//
// Logline: Computes 1-NN subsequence distance profiles for recurring motif pattern discovery and discord anomaly isolation.
//
// Setup: Sliding window subsequence matching of length m across industrial machine telemetry.
//
// Beats:
//   1. Define MatrixProfileResult and MotifDiscordPair structures.
//   2. Compute 1-Nearest-Neighbor Euclidean distance profile and index matrix.
//   3. Extract minimum-distance motif pair and maximum-distance discord anomaly.

pub type MatrixProfileResult = struct {
    profile: List[Float],
    profile_index: List[Int],
    subsequence_len: Int,
    num_subsequences: Int
};

pub type MotifDiscordPair = struct {
    motif_idx1: Int,
    motif_idx2: Int,
    motif_dist: Float,
    discord_idx: Int,
    discord_dist: Float
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn matrix_profile_compute(series: &List[Float], m: Int) -> MatrixProfileResult {
    let n: Int = list_len(*series);
    let mut p: List[Float] = list_new();
    let mut ip: List[Int] = list_new();

    if n < m || m <= 1 {
        return MatrixProfileResult {
            profile: p,
            profile_index: ip,
            subsequence_len: m,
            num_subsequences: 0
        };
    }

    let num_subs: Int = n - m + 1;
    let infinity: Float = 10000000.0;

    let mut i: Int = 0;
    while i < num_subs {
        let mut min_dist: Float = infinity;
        let mut min_idx: Int = 0 - 1;

        let mut j: Int = 0;
        while j < num_subs {
            let trivial_diff: Int = if (i - j) >= 0 { i - j } else { j - i };
            if trivial_diff >= (m / 2) {
                let mut sum_sq: Float = 0.0;
                let mut k: Int = 0;
                while k < m {
                    let d: Float = list_get(*series, i + k) - list_get(*series, j + k);
                    sum_sq = sum_sq + (d * d);
                    k = k + 1;
                }
                let dist: Float = math_sqrt(sum_sq);
                if dist < min_dist {
                    min_dist = dist;
                    min_idx = j;
                }
            }
            j = j + 1;
        }

        p = list_push(p, min_dist);
        ip = list_push(ip, min_idx);
        i = i + 1;
    }

    return MatrixProfileResult {
        profile: p,
        profile_index: ip,
        subsequence_len: m,
        num_subsequences: num_subs
    };
}

pub fn matrix_profile_extract_motif_discord(mp: &MatrixProfileResult) -> MotifDiscordPair {
    let n: Int = (mp).num_subsequences;
    if n == 0 {
        return MotifDiscordPair {
            motif_idx1: 0,
            motif_idx2: 0,
            motif_dist: 0.0,
            discord_idx: 0,
            discord_dist: 0.0
        };
    }

    let mut min_d: Float = 10000000.0;
    let mut min_i1: Int = 0;
    let mut min_i2: Int = 0;

    let mut max_d: Float = 0.0 - 1.0;
    let mut max_i: Int = 0;

    let mut i: Int = 0;
    while i < n {
        let d: Float = list_get((mp).profile, i);
        let match_idx: Int = list_get((mp).profile_index, i);

        if d < min_d && match_idx >= 0 {
            min_d = d;
            min_i1 = i;
            min_i2 = match_idx;
        }
        if d > max_d {
            max_d = d;
            max_i = i;
        }
        i = i + 1;
    }

    return MotifDiscordPair {
        motif_idx1: min_i1,
        motif_idx2: min_i2,
        motif_dist: min_d,
        discord_idx: max_i,
        discord_dist: max_d
    };
}
