// # Rolling Z-Score & Statistical Anomaly Detector
//
// Logline: Computes windowed rolling mean and standard deviation to detect point anomalies and sensor outliers via Z-score thresholding.
//
// Setup: Sliding window statistical scoring flagging samples with absolute Z-scores exceeding critical tolerance (e.g. 3.0 sigma).
//
// Beats:
//   1. Define ZScoreAnomalyResult structure with Z-score series, anomaly flags, and count.
//   2. Compute sliding window local mean and unbiased sample standard deviation.
//   3. Evaluate standardized Z-scores and generate binary anomaly alert masks.

pub type ZScoreAnomalyResult = struct {
    z_scores: List[Float],
    is_anomaly: List[Bool],
    num_anomalies: Int,
    window_size: Int,
    threshold_sigma: Float
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn rolling_zscore_detect(
    series: &List[Float],
    window: Int,
    threshold: Float,
) -> ZScoreAnomalyResult {
    let n: Int = list_len(*series);
    let mut z_list: List[Float] = list_new();
    let mut flags: List[Bool] = list_new();
    let mut anom_count: Int = 0;

    if n == 0 || window <= 1 {
        return ZScoreAnomalyResult {
            z_scores: z_list,
            is_anomaly: flags,
            num_anomalies: 0,
            window_size: window,
            threshold_sigma: threshold
        };
    }

    let mut i: Int = 0;
    while i < n {
        let mut sum: Float = 0.0;
        let mut count: Int = 0;
        let mut j: Int = 0;
        while j < window {
            let idx: Int = i - j;
            if idx >= 0 {
                sum = sum + list_get(*series, idx);
                count = count + 1;
            }
            j = j + 1;
        }

        let mean: Float = sum / int_to_float(count);
        let mut sum_sq: Float = 0.0;
        j = 0;
        while j < window {
            let idx: Int = i - j;
            if idx >= 0 {
                let diff: Float = list_get(*series, idx) - mean;
                sum_sq = sum_sq + (diff * diff);
            }
            j = j + 1;
        }

        let std_dev: Float = if count > 1 { math_sqrt(sum_sq / int_to_float(count - 1)) } else { 0.0 };
        let x_cur: Float = list_get(*series, i);
        let z: Float = if std_dev > 0.000001 { (x_cur - mean) / std_dev } else { 0.0 };
        let is_anom: Bool = if math_abs(z) >= threshold { true } else { false };

        z_list = list_push(z_list, z);
        flags = list_push(flags, is_anom);
        if is_anom {
            anom_count = anom_count + 1;
        }
        i = i + 1;
    }

    return ZScoreAnomalyResult {
        z_scores: z_list,
        is_anomaly: flags,
        num_anomalies: anom_count,
        window_size: window,
        threshold_sigma: threshold
    };
}
