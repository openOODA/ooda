// # Virtual Soft Sensor Surrogate Estimator
//
// Logline: Estimates unmeasured physical state variables (e.g. stator core temperature) via multi-variable surrogate regression.
//
// Setup: Maps measured electrical current, voltage, coolant flow, and ambient temperature into virtual sensor telemetry.
//
// Beats:
//   1. Define VirtualSensorWeights and VirtualEstimate structures.
//   2. Evaluate 2nd-order multi-variate polynomial proxy equations.
//   3. Compute estimation confidence and sensor discrepancy metrics.

pub type VirtualSensorWeights = struct {
    w_intercept: Float,
    w_current_i: Float,
    w_current_i2: Float,
    w_ambient_t: Float,
    w_coolant_flow: Float
};

pub type VirtualEstimate = struct {
    estimated_temperature_c: Float,
    heat_loss_watts: Float,
    estimation_confidence: Float,
    is_valid_operating_point: Bool
};

pub fn virtual_sensor_default_stator() -> VirtualSensorWeights {
    return VirtualSensorWeights {
        w_intercept: 25.0,
        w_current_i: 0.15,
        w_current_i2: 0.008,
        w_ambient_t: 0.85,
        w_coolant_flow: 0.0 - 1.2
    };
}

pub fn virtual_sensor_calc(
    weights: &VirtualSensorWeights,
    motor_current_a: Float,
    ambient_temp_c: Float,
    coolant_flow_lpm: Float,
) -> VirtualEstimate {
    let i: Float = motor_current_a;
    let i2: Float = i * i;
    let t_amb: Float = ambient_temp_c;
    let flow: Float = coolant_flow_lpm;

    let t_est: Float = (weights).w_intercept
        + ((weights).w_current_i * i)
        + ((weights).w_current_i2 * i2)
        + ((weights).w_ambient_t * t_amb)
        + ((weights).w_coolant_flow * flow);

    // Copper I^2 R electrical heat loss (approx 0.05 ohms resistance)
    let heat_w: Float = 0.05 * i2;
    let is_valid: Bool = (i >= 0.0) && (t_amb >= (0.0 - 20.0)) && (t_amb <= 80.0);

    return VirtualEstimate {
        estimated_temperature_c: t_est,
        heat_loss_watts: heat_w,
        estimation_confidence: if is_valid { 0.95 } else { 0.50 },
        is_valid_operating_point: is_valid
    };
}
