// # Bearing Fault Characteristic Frequencies (BPFO, BPFI, BSF, FTF)
//
// Logline: Calculates kinematic rolling element bearing fault frequencies and diagnoses spectral peak matches.
//
// Setup: Equations based on pitch diameter (D), roller diameter (d), contact angle (alpha), and rolling element count (n).
//
// Beats:
//   1. Define BearingGeometry and BearingFrequencies structures.
//   2. Calculate BPFO, BPFI, BSF, and FTF frequencies from rotational shaft speed.
//   3. Match experimental vibration spectrum peaks to bearing defect frequencies with tolerance bands.

pub type BearingGeometry = struct {
    num_rollers: Int,
    roller_diameter_mm: Float,
    pitch_diameter_mm: Float,
    contact_angle_rad: Float
};

pub type BearingFrequencies = struct {
    shaft_freq_hz: Float,
    bpfo_hz: Float,
    bpfi_hz: Float,
    bsf_hz: Float,
    ftf_hz: Float
};

pub type BearingFaultDiagnostic = struct {
    fault_type: Int, // 0=None, 1=OuterRace, 2=InnerRace, 3=BallDefect, 4=CageDefect
    peak_frequency: Float,
    amplitude: Float,
    confidence: Float
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 && count < 10 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_cos(x: Float) -> Float {
    let pi: Float = 3.141592653589793;
    let mut val: Float = x;
    while val > pi { val = val - (2.0 * pi); }
    while val < (0.0 - pi) { val = val + (2.0 * pi); }
    let x2: Float = val * val;
    let x4: Float = x2 * x2;
    let x6: Float = x4 * x2;
    return 1.0 - (x2 / 2.0) + (x4 / 24.0) - (x6 / 720.0);
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn bearing_calc_frequencies(geom: &BearingGeometry, shaft_rpm: Float) -> BearingFrequencies {
    let fr: Float = shaft_rpm / 60.0;
    let n_f: Float = int_to_float((geom).num_rollers);
    let d: Float = (geom).roller_diameter_mm;
    let cap_d: Float = (geom).pitch_diameter_mm;
    let cos_a: Float = math_cos((geom).contact_angle_rad);

    let ratio: Float = if cap_d > 0.0 { (d / cap_d) * cos_a } else { 0.0 };

    let bpfo: Float = (n_f / 2.0) * fr * (1.0 - ratio);
    let bpfi: Float = (n_f / 2.0) * fr * (1.0 + ratio);
    let bsf: Float = if d > 0.0 { (cap_d / (2.0 * d)) * fr * (1.0 - (ratio * ratio)) } else { 0.0 };
    let ftf: Float = 0.5 * fr * (1.0 - ratio);

    return BearingFrequencies {
        shaft_freq_hz: fr,
        bpfo_hz: bpfo,
        bpfi_hz: bpfi,
        bsf_hz: bsf,
        ftf_hz: ftf
    };
}

pub fn bearing_diagnose_peak(bf: &BearingFrequencies, peak_hz: Float, amp: Float) -> BearingFaultDiagnostic {
    let tol: Float = 0.03;

    if math_abs(peak_hz - (bf).bpfo_hz) <= (tol * (bf).bpfo_hz) {
        return BearingFaultDiagnostic {
            fault_type: 1, // BPFO Outer Race
            peak_frequency: peak_hz,
            amplitude: amp,
            confidence: 0.95
        };
    }
    if math_abs(peak_hz - (bf).bpfi_hz) <= (tol * (bf).bpfi_hz) {
        return BearingFaultDiagnostic {
            fault_type: 2, // BPFI Inner Race
            peak_frequency: peak_hz,
            amplitude: amp,
            confidence: 0.92
        };
    }
    if math_abs(peak_hz - (bf).bsf_hz) <= (tol * (bf).bsf_hz) {
        return BearingFaultDiagnostic {
            fault_type: 3, // BSF Ball Defect
            peak_frequency: peak_hz,
            amplitude: amp,
            confidence: 0.88
        };
    }
    if math_abs(peak_hz - (bf).ftf_hz) <= (tol * (bf).ftf_hz) {
        return BearingFaultDiagnostic {
            fault_type: 4, // FTF Cage Defect
            peak_frequency: peak_hz,
            amplitude: amp,
            confidence: 0.85
        };
    }

    return BearingFaultDiagnostic {
        fault_type: 0,
        peak_frequency: peak_hz,
        amplitude: amp,
        confidence: 0.0
    };
}
