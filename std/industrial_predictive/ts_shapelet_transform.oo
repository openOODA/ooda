// # Time-Series Shapelet Extraction & Distance Transform
//
// Logline: Extracts discriminative phase-independent subsequence shapelets and computes sliding window Euclidean distance maps.
//
// Setup: Finds characteristic failure signature motifs that minimize classification distance to degraded machine runs.
//
// Beats:
//   1. Define ShapeletCandidate and ShapeletMatchResult structures.
//   2. Compute normalized minimum subsequence Euclidean distance from shapelet to query series.
//   3. Transform raw continuous telemetry into shapelet-distance feature spaces.

pub type ShapeletCandidate = struct {
    pattern: List[Float],
    length: Int,
    class_label: Int,
    information_gain: Float,
};

pub type ShapeletMatchResult = struct {
    min_distance: Float,
    best_offset: Int,
    normalized_distance: Float,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn shapelet_distance_to_series(shapelet: &ShapeletCandidate, series: &List[Float]) -> ShapeletMatchResult {
    let l: Int = (shapelet).length;
    let n: Int = list_len(*series);

    if l == 0 || n < l {
        return ShapeletMatchResult {
            min_distance: 0.0,
            best_offset: 0 - 1,
            normalized_distance: 0.0,
        };
    }

    let infinity: Float = 10000000.0;
    let mut min_d: Float = infinity;
    let mut best_idx: Int = 0;

    let num_windows: Int = n - l + 1;
    let mut i: Int = 0;
    while i < num_windows {
        let mut sum_sq: Float = 0.0;
        let mut k: Int = 0;
        while k < l {
            let s_val: Float = list_get((shapelet).pattern, k);
            let t_val: Float = list_get(*series, i + k);
            let diff: Float = s_val - t_val;
            sum_sq = sum_sq + (diff * diff);
            k = k + 1;
        }
        let d: Float = math_sqrt(sum_sq);
        if d < min_d {
            min_d = d;
            best_idx = i;
        }
        i = i + 1;
    }

    let l_f: Float = int_to_float(l);
    let norm_d: Float = if l_f > 0.0 { min_d / math_sqrt(l_f) } else { min_d };

    return ShapeletMatchResult {
        min_distance: min_d,
        best_offset: best_idx,
        normalized_distance: norm_d,
    };
}
