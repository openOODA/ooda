// # Multivariate Mahalanobis Distance & Correlated Sensor Anomaly Scoring
//
// Logline: Calculates multivariate Mahalanobis distance $D_M(x) = \sqrt{(x-\mu)^T \Sigma^{-1} (x-\mu)}$ across correlated sensor pairs.
//
// Setup: Detects multidimensional anomalies when individual sensors stay within 1D limits but violate cross-sensor covariance ellipses.
//
// Beats:
//   1. Define Mahalanobis2DModel and MahalanobisScore structures.
//   2. Compute 2D mean vector and invert 2x2 covariance matrix $\Sigma$.
//   3. Evaluate quadratic form $(x-\mu)^T \Sigma^{-1} (x-\mu)$ and compare to Chi-Square thresholds.

pub type Mahalanobis2DModel = struct {
    mean_x1: Float,
    mean_x2: Float,
    inv_cov_00: Float,
    inv_cov_01: Float,
    inv_cov_10: Float,
    inv_cov_11: Float,
    threshold_chi2: Float
};

pub type MahalanobisScore = struct {
    distance_d_m: Float,
    d_m_squared: Float,
    is_multivariate_outlier: Bool
};

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn mahalanobis_2d_fit(
    mu1: Float,
    mu2: Float,
    var11: Float,
    var22: Float,
    cov12: Float,
    p_val_threshold: Float,
) -> Mahalanobis2DModel {
    let det: Float = (var11 * var22) - (cov12 * cov12);
    let inv_det: Float = if det > 0.000001 { 1.0 / det } else { 1.0 };

    let i00: Float = var22 * inv_det;
    let i01: Float = (0.0 - cov12) * inv_det;
    let i10: Float = (0.0 - cov12) * inv_det;
    let i11: Float = var11 * inv_det;

    // Chi2 with 2 DOF at 99%: 9.21
    let thresh: Float = if p_val_threshold > 0.0 { p_val_threshold } else { 9.21 };

    return Mahalanobis2DModel {
        mean_x1: mu1,
        mean_x2: mu2,
        inv_cov_00: i00,
        inv_cov_01: i01,
        inv_cov_10: i10,
        inv_cov_11: i11,
        threshold_chi2: thresh
    };
}

pub fn mahalanobis_2d_eval(
    model: &Mahalanobis2DModel,
    x1: Float,
    x2: Float,
) -> MahalanobisScore {
    let dx1: Float = x1 - (model).mean_x1;
    let dx2: Float = x2 - (model).mean_x2;

    let v0: Float = ((model).inv_cov_00 * dx1) + ((model).inv_cov_01 * dx2);
    let v1: Float = ((model).inv_cov_10 * dx1) + ((model).inv_cov_11 * dx2);

    let d2: Float = (dx1 * v0) + (dx2 * v1);
    let safe_d2: Float = if d2 > 0.0 { d2 } else { 0.0 };
    let dm: Float = math_sqrt(safe_d2);

    let is_outlier: Bool = if safe_d2 >= (model).threshold_chi2 { true } else { false };

    return MahalanobisScore {
        distance_d_m: dm,
        d_m_squared: safe_d2,
        is_multivariate_outlier: is_outlier
    };
}
