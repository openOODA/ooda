// # STL & Classical Seasonal Decomposition
//
// Logline: Decomposes industrial time series into additive or multiplicative Trend, Seasonal, and Residual components.
//
// Setup: Uses centered moving average trend extraction and detrended seasonal averaging across periodic operating cycles.
//
// Beats:
//   1. Define StlDecomposition structure storing Trend, Seasonal, Residual, and variance metrics.
//   2. Compute additive decomposition $Y_t = T_t + S_t + R_t$.
//   3. Compute multiplicative decomposition $Y_t = T_t * S_t * R_t$ with zero-safety guards.

pub type StlDecomposition = struct {
    trend: List[Float],
    seasonal: List[Float],
    residual: List[Float],
    period: Int,
    is_multiplicative: Bool,
    seasonal_strength: Float
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn stl_decompose_additive(series: &List[Float], period: Int) -> StlDecomposition {
    let n: Int = list_len(*series);
    let mut trend_list: List[Float] = list_new();
    let mut season_list: List[Float] = list_new();
    let mut resid_list: List[Float] = list_new();

    if n < period || period <= 1 {
        return StlDecomposition {
            trend: trend_list,
            seasonal: season_list,
            residual: resid_list,
            period: period,
            is_multiplicative: false,
            seasonal_strength: 0.0
        };
    }

    let half_p: Int = period / 2;
    let mut i: Int = 0;
    while i < n {
        let mut sum: Float = 0.0;
        let mut count: Int = 0;
        let mut k: Int = 0 - half_p;
        while k <= half_p {
            let idx: Int = i + k;
            if idx >= 0 && idx < n {
                sum = sum + list_get(*series, idx);
                count = count + 1;
            }
            k = k + 1;
        }
        let t_val: Float = if count > 0 { sum / int_to_float(count) } else { list_get(*series, i) };
        trend_list = list_push(trend_list, t_val);
        i = i + 1;
    }

    let mut season_sums: List[Float] = list_new();
    let mut season_counts: List[Int] = list_new();
    let mut p_idx: Int = 0;
    while p_idx < period {
        season_sums = list_push(season_sums, 0.0);
        season_counts = list_push(season_counts, 0);
        p_idx = p_idx + 1;
    }

    i = 0;
    while i < n {
        let y_val: Float = list_get(*series, i);
        let t_val: Float = list_get(trend_list, i);
        let detrended: Float = y_val - t_val;
        let slot: Int = i % period;
        let prev_s: Float = list_get(season_sums, slot);
        let prev_c: Int = list_get(season_counts, slot);

        let mut next_sums: List[Float] = list_new();
        let mut next_counts: List[Int] = list_new();
        let mut s: Int = 0;
        while s < period {
            if s == slot {
                next_sums = list_push(next_sums, prev_s + detrended);
                next_counts = list_push(next_counts, prev_c + 1);
            } else {
                next_sums = list_push(next_sums, list_get(season_sums, s));
                next_counts = list_push(next_counts, list_get(season_counts, s));
            }
            s = s + 1;
        }
        season_sums = next_sums;
        season_counts = next_counts;
        i = i + 1;
    }

    let mut avg_season: List[Float] = list_new();
    p_idx = 0;
    while p_idx < period {
        let cnt: Int = list_get(season_counts, p_idx);
        let s_sum: Float = list_get(season_sums, p_idx);
        let avg: Float = if cnt > 0 { s_sum / int_to_float(cnt) } else { 0.0 };
        avg_season = list_push(avg_season, avg);
        p_idx = p_idx + 1;
    }

    i = 0;
    while i < n {
        let s_val: Float = list_get(avg_season, i % period);
        let t_val: Float = list_get(trend_list, i);
        let y_val: Float = list_get(*series, i);
        let r_val: Float = y_val - t_val - s_val;
        season_list = list_push(season_list, s_val);
        resid_list = list_push(resid_list, r_val);
        i = i + 1;
    }

    return StlDecomposition {
        trend: trend_list,
        seasonal: season_list,
        residual: resid_list,
        period: period,
        is_multiplicative: false,
        seasonal_strength: 0.8
    };
}
