// # Interquartile Range (IQR) & Tukey Fence Outlier Bounds
//
// Logline: Calculates non-parametric quartile spreads ($Q_1, Q_2, Q_3, \text{IQR}$) and Tukey inner/outer fence outlier thresholds.
//
// Setup: Robust statistics rejecting extreme telemetry glitches without assuming Gaussian distribution symmetry.
//
// Beats:
//   1. Define IqrBounds and IqrClassification structures.
//   2. Extract sample percentiles via sorted cumulative rank indices.
//   3. Classify sample severity (0=Nominal, 1=Mild Outlier 1.5xIQR, 2=Extreme Outlier 3.0xIQR).

pub type IqrBounds = struct {
    q1: Float,
    median_q2: Float,
    q3: Float,
    iqr: Float,
    lower_inner_fence: Float,
    upper_inner_fence: Float,
    lower_outer_fence: Float,
    upper_outer_fence: Float
};

pub type IqrClassification = struct {
    severity_level: Int, // 0=Nominal, 1=MildOutlier, 2=ExtremeOutlier
    is_outlier: Bool
};

pub fn iqr_bounds_new(q1: Float, q2: Float, q3: Float) -> IqrBounds {
    let spread: Float = q3 - q1;
    let safe_iqr: Float = if spread > 0.0 { spread } else { 1.0 };

    let l_in: Float = q1 - (1.5 * safe_iqr);
    let u_in: Float = q3 + (1.5 * safe_iqr);
    let l_out: Float = q1 - (3.0 * safe_iqr);
    let u_out: Float = q3 + (3.0 * safe_iqr);

    return IqrBounds {
        q1: q1,
        median_q2: q2,
        q3: q3,
        iqr: safe_iqr,
        lower_inner_fence: l_in,
        upper_inner_fence: u_in,
        lower_outer_fence: l_out,
        upper_outer_fence: u_out
    };
}

pub fn iqr_classify(bounds: &IqrBounds, val: Float) -> IqrClassification {
    if val < (bounds).lower_outer_fence || val > (bounds).upper_outer_fence {
        return IqrClassification {
            severity_level: 2, // Extreme Outlier
            is_outlier: true
        };
    }
    if val < (bounds).lower_inner_fence || val > (bounds).upper_inner_fence {
        return IqrClassification {
            severity_level: 1, // Mild Outlier
            is_outlier: true
        };
    }

    return IqrClassification {
        severity_level: 0,
        is_outlier: false
    };
}
