// # Vibration FFT Harmonics & Order Tracking
//
// Logline: Analyzes vibration frequency spectra for 1X/2X/3X rotational harmonics, sideband modulations, and total harmonic distortion.
//
// Setup: Spectral feature extractor for rotating machinery unbalance, misalignment, and mechanical looseness.
//
// Beats:
//   1. Define HarmonicPeak and VibrationSpectrumAnalysis structures.
//   2. Extract fundamental rotational speed (1X) and integer multiples (2X..5X).
//   3. Compute Total Harmonic Distortion (THD) and sideband modulation energy.

pub type HarmonicPeak = struct {
    order_multiplier: Float,
    frequency_hz: Float,
    amplitude: Float,
    is_dominant: Bool,
};

pub type VibrationSpectrumAnalysis = struct {
    fundamental_1x_hz: Float,
    fundamental_amp: Float,
    thd_percentage: Float,
    harmonics: List[HarmonicPeak],
    unbalance_severity: Float,
    misalignment_severity: Float,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn vibration_analyze_harmonics(
    freq_bins: &List[Float],
    mag_bins: &List[Float],
    rpm_speed: Float,
) -> VibrationSpectrumAnalysis {
    let mut empty_h: List[HarmonicPeak] = list_new();
    if rpm_speed <= 0.0 {
        return VibrationSpectrumAnalysis {
            fundamental_1x_hz: 0.0,
            fundamental_amp: 0.0,
            thd_percentage: 0.0,
            harmonics: empty_h,
            unbalance_severity: 0.0,
            misalignment_severity: 0.0,
        };
    }

    let f1x: Float = rpm_speed / 60.0;
    let n: Int = list_len(*freq_bins);
    let mut harms: List[HarmonicPeak] = list_new();

    let mut sum_harm_sq: Float = 0.0;
    let mut amp_1x: Float = 0.0;
    let mut amp_2x: Float = 0.0;

    let mut order: Int = 1;
    while order <= 5 {
        let order_f: Float = int_to_float(order);
        let target_freq: Float = order_f * f1x;

        let mut best_amp: Float = 0.0;
        let mut best_freq: Float = target_freq;

        let mut i: Int = 0;
        while i < n {
            let f: Float = list_get(*freq_bins, i);
            let diff: Float = math_abs(f - target_freq);
            if diff <= (0.05 * target_freq) {
                let amp: Float = list_get(*mag_bins, i);
                if amp > best_amp {
                    best_amp = amp;
                    best_freq = f;
                }
            }
            i = i + 1;
        }

        if order == 1 {
            amp_1x = best_amp;
        } else {
            sum_harm_sq = sum_harm_sq + (best_amp * best_amp);
            if order == 2 {
                amp_2x = best_amp;
            }
        }

        let p = HarmonicPeak {
            order_multiplier: order_f,
            frequency_hz: best_freq,
            amplitude: best_amp,
            is_dominant: (order == 1),
        };
        harms = list_push(harms, p);
        order = order + 1;
    }

    let thd: Float = if amp_1x > 0.0001 { (math_sqrt(sum_harm_sq) / amp_1x) * 100.0 } else { 0.0 };
    let unbal: Float = amp_1x;
    let misalign: Float = if amp_1x > 0.0001 { amp_2x / amp_1x } else { 0.0 };

    return VibrationSpectrumAnalysis {
        fundamental_1x_hz: f1x,
        fundamental_amp: amp_1x,
        thd_percentage: thd,
        harmonics: harms,
        unbalance_severity: unbal,
        misalignment_severity: misalign,
    };
}
