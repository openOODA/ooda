// # Complementary Sensor Fusion Filter
//
// Logline: Fuses high-rate gyroscope angular rates with static accelerometer tilt angles to eliminate gyro drift and shock artifacts.
//
// Setup: Blends a high-pass filter on integrated gyro rates with a low-pass filter on accelerometer gravity vectors.
//
// Beats:
//   1. Define ComplementaryState structure with smoothing weight alpha and estimated angle.
//   2. Integrate high-frequency gyro angular velocity across sample interval $\Delta t$.
//   3. Apply complementary blending: $\theta_t = \alpha(\theta_{t-1} + \omega \Delta t) + (1-\alpha)\theta_{\text{acc}}$.

pub type ComplementaryState = struct {
    estimated_angle_deg: Float,
    alpha_gyro_weight: Float, // Typical: 0.98
    gyro_bias_estimate: Float,
    is_initialized: Bool,
};

pub fn comp_filter_new(alpha: Float) -> ComplementaryState {
    return ComplementaryState {
        estimated_angle_deg: 0.0,
        alpha_gyro_weight: alpha,
        gyro_bias_estimate: 0.0,
        is_initialized: false,
    };
}

pub fn comp_filter_update(
    state: &mut ComplementaryState,
    gyro_rate_dps: Float,
    accel_angle_deg: Float,
    dt_sec: Float,
) -> Float {
    if !(state).is_initialized {
        (state).estimated_angle_deg = accel_angle_deg;
        (state).is_initialized = true;
        return accel_angle_deg;
    }

    let alpha: Float = (state).alpha_gyro_weight;
    let rate_unbiased: Float = gyro_rate_dps - (state).gyro_bias_estimate;
    let gyro_integrated: Float = (state).estimated_angle_deg + (rate_unbiased * dt_sec);

    let fused_angle: Float = (alpha * gyro_integrated) + ((1.0 - alpha) * accel_angle_deg);
    (state).estimated_angle_deg = fused_angle;

    return fused_angle;
}
