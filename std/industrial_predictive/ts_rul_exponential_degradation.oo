// # Exponential Degradation & Accelerated RUL
//
// Logline: Models non-linear exponential degradation wear trajectories ($y = a \cdot e^{bt}$) for accelerated failure prognostics.
//
// Setup: Fits log-linearized degradation curves to predict remaining useful life under exponential acceleration.
//
// Beats:
//   1. Define ExponentialRulResult structure.
//   2. Fit parameters $a$ and $b$ using log-linearized ordinary least squares.
//   3. Compute analytical time-to-threshold intersection and remaining operating duration.

pub type ExponentialRulResult = struct {
    rul_hours: Float,
    growth_rate_b: Float,
    base_scale_a: Float,
    current_wear: Float,
    threshold_limit: Float,
    is_valid_forecast: Bool,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_ln(x: Float) -> Float {
    if x <= 0.0 { return (0.0 - 20.0); }
    let mut y: Float = x;
    let mut count_e: Float = 0.0;
    let e: Float = 2.718281828459045;
    while y > e {
        y = y / e;
        count_e = count_e + 1.0;
    }
    while y < (1.0 / e) {
        y = y * e;
        count_e = count_e - 1.0;
    }
    let z: Float = (y - 1.0) / (y + 1.0);
    let z2: Float = z * z;
    let series: Float = 2.0 * z * (1.0 + (z2 / 3.0) + ((z2 * z2) / 5.0) + ((z2 * z2 * z2) / 7.0));
    return count_e + series;
}

pub fn math_exp(x: Float) -> Float {
    if x < (0.0 - 20.0) { return 0.0; }
    if x > 20.0 { return 485165195.0; }
    let mut val: Float = 1.0;
    let mut term: Float = 1.0;
    let mut i: Int = 1;
    while i < 16 {
        let i_f: Float = int_to_float(i);
        term = term * (x / i_f);
        val = val + term;
        i = i + 1;
    }
    return val;
}

pub fn rul_exponential_predict(
    times: &List[Float],
    wear_values: &List[Float],
    wear_threshold: Float,
) -> ExponentialRulResult {
    let n: Int = list_len(*times);
    let ny: Int = list_len(*wear_values);

    if n < 2 || n != ny || wear_threshold <= 0.0 {
        let cur: Float = if ny > 0 { list_get(*wear_values, ny - 1) } else { 0.0 };
        return ExponentialRulResult {
            rul_hours: 0.0,
            growth_rate_b: 0.0,
            base_scale_a: cur,
            current_wear: cur,
            threshold_limit: wear_threshold,
            is_valid_forecast: false,
        };
    }

    let n_f: Float = int_to_float(n);
    let mut sum_t: Float = 0.0;
    let mut sum_lny: Float = 0.0;
    let mut sum_t_lny: Float = 0.0;
    let mut sum_tt: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let t: Float = list_get(*times, i);
        let y: Float = list_get(*wear_values, i);
        let safe_y: Float = if y > 0.0001 { y } else { 0.0001 };
        let lny: Float = math_ln(safe_y);

        sum_t = sum_t + t;
        sum_lny = sum_lny + lny;
        sum_t_lny = sum_t_lny + (t * lny);
        sum_tt = sum_tt + (t * t);
        i = i + 1;
    }

    let denom: Float = (n_f * sum_tt) - (sum_t * sum_t);
    if denom == 0.0 {
        let cur: Float = list_get(*wear_values, n - 1);
        return ExponentialRulResult {
            rul_hours: 0.0,
            growth_rate_b: 0.0,
            base_scale_a: cur,
            current_wear: cur,
            threshold_limit: wear_threshold,
            is_valid_forecast: false,
        };
    }

    let b: Float = ((n_f * sum_t_lny) - (sum_t * sum_lny)) / denom;
    let ln_a: Float = (sum_lny - (b * sum_t)) / n_f;
    let a: Float = math_exp(ln_a);

    let last_t: Float = list_get(*times, n - 1);
    let cur_w: Float = list_get(*wear_values, n - 1);

    let mut rul: Float = 0.0;
    let mut valid: Bool = false;

    if b > 0.0 && wear_threshold > a {
        let ln_thresh: Float = math_ln(wear_threshold);
        let t_eol: Float = (ln_thresh - ln_a) / b;
        rul = t_eol - last_t;
        if rul < 0.0 { rul = 0.0; }
        valid = true;
    }

    return ExponentialRulResult {
        rul_hours: rul,
        growth_rate_b: b,
        base_scale_a: a,
        current_wear: cur_w,
        threshold_limit: wear_threshold,
        is_valid_forecast: valid,
    };
}
