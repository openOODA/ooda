// # Overall Equipment Effectiveness (OEE) Metric & Loss Breakdown
//
// Logline: Calculates Availability, Performance, and Quality factors to derive standard industrial OEE percentage and loss categorization.
//
// Setup: Multiplies $A \times P \times Q$ to evaluate world-class manufacturing productivity benchmarks (e.g. >= 85%).
//
// Beats:
//   1. Define OeeInputs and OeeResult structures.
//   2. Calculate Availability ($T_{\text{run}} / T_{\text{plan}}$), Performance ($Count \cdot T_{\text{ideal}} / T_{\text{run}}$), and Quality ($Count_{\text{good}} / Count$).
//   3. Compute composite OEE index and assess operational performance grade.

pub type OeeInputs = struct {
    planned_production_time_min: Float,
    unplanned_downtime_min: Float,
    ideal_cycle_time_sec: Float,
    total_parts_produced: Float,
    good_parts_produced: Float
};

pub type OeeResult = struct {
    availability_pct: Float,
    performance_pct: Float,
    quality_pct: Float,
    oee_pct: Float,
    operating_time_min: Float,
    is_world_class: Bool // >= 85.0%
};

pub fn oee_calculate(inputs: &OeeInputs) -> OeeResult {
    let t_plan: Float = (inputs).planned_production_time_min;
    let t_down: Float = (inputs).unplanned_downtime_min;
    let t_ideal: Float = (inputs).ideal_cycle_time_sec;
    let total_parts: Float = (inputs).total_parts_produced;
    let good_parts: Float = (inputs).good_parts_produced;

    let t_run: Float = if t_plan > t_down { t_plan - t_down } else { 0.0 };

    let a_factor: Float = if t_plan > 0.0 { t_run / t_plan } else { 0.0 };

    let t_run_sec: Float = t_run * 60.0;
    let p_factor: Float = if t_run_sec > 0.0 { (total_parts * t_ideal) / t_run_sec } else { 0.0 };

    let q_factor: Float = if total_parts > 0.0 { good_parts / total_parts } else { 1.0 };

    let safe_a: Float = if a_factor > 1.0 { 1.0 } else { a_factor };
    let safe_p: Float = if p_factor > 1.0 { 1.0 } else { p_factor };
    let safe_q: Float = if q_factor > 1.0 { 1.0 } else { q_factor };

    let oee_ratio: Float = safe_a * safe_p * safe_q;
    let oee_pct_val: Float = oee_ratio * 100.0;

    let is_wc: Bool = if oee_pct_val >= 85.0 { true } else { false };

    return OeeResult {
        availability_pct: safe_a * 100.0,
        performance_pct: safe_p * 100.0,
        quality_pct: safe_q * 100.0,
        oee_pct: oee_pct_val,
        operating_time_min: t_run,
        is_world_class: is_wc
    };
}

pub fn ts_oee_equipment_efficiency_probe() -> Int {
    return 0;
}
