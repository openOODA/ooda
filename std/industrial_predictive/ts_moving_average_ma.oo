// # Moving Average MA(q) Model & Innovations
//
// Logline: Estimates Moving Average MA(q) time series parameters and recursively computes innovation residuals.
//
// Setup: Fits MA coefficients $\theta_1, \dots, \theta_q$ and reconstructs filtered white-noise innovations.
//
// Beats:
//   1. Define MaModel and MaResidualResult structures.
//   2. Estimate MA(1) and MA(q) parameters using sample autocovariances.
//   3. Compute one-step ahead residual innovations and multi-step forecasts.

pub type MaModel = struct {
    order_q: Int,
    theta_coeffs: List[Float],
    mean: Float,
    sigma2: Float
};

pub type MaResidualResult = struct {
    residuals: List[Float],
    mean_squared_error: Float
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn ma1_fit_moment(series: &List[Float]) -> MaModel {
    let n: Int = list_len(*series);
    let mut thetas: List[Float] = list_new();
    if n <= 2 {
        thetas = list_push(thetas, 0.0);
        return MaModel { order_q: 1, theta_coeffs: thetas, mean: 0.0, sigma2: 1.0 };
    }

    let n_f: Float = int_to_float(n);
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        sum = sum + list_get(*series, i);
        i = i + 1;
    }
    let mu: Float = sum / n_f;

    let mut gamma0: Float = 0.0;
    let mut gamma1: Float = 0.0;
    i = 0;
    while i < n {
        let diff0: Float = list_get(*series, i) - mu;
        gamma0 = gamma0 + (diff0 * diff0);
        if i > 0 {
            let diff1: Float = list_get(*series, i - 1) - mu;
            gamma1 = gamma1 + (diff0 * diff1);
        }
        i = i + 1;
    }
    gamma0 = gamma0 / n_f;
    gamma1 = gamma1 / n_f;

    let rho1: Float = if gamma0 > 0.00001 { gamma1 / gamma0 } else { 0.0 };
    let mut theta: Float = 0.0;
    if (rho1 * rho1) < 0.25 {
        let disc: Float = 1.0 - (4.0 * rho1 * rho1);
        let sq: Float = math_sqrt(disc);
        theta = (1.0 - sq) / (2.0 * rho1);
    }

    thetas = list_push(thetas, theta);
    let denom: Float = 1.0 + (theta * theta);
    let sig2: Float = if denom > 0.0 { gamma0 / denom } else { gamma0 };

    return MaModel {
        order_q: 1,
        theta_coeffs: thetas,
        mean: mu,
        sigma2: sig2
    };
}

pub fn ma_extract_residuals(model: &MaModel, series: &List[Float]) -> MaResidualResult {
    let n: Int = list_len(*series);
    let mut resids: List[Float] = list_new();
    if n == 0 {
        return MaResidualResult { residuals: resids, mean_squared_error: 0.0 };
    }

    let theta: Float = if list_len((model).theta_coeffs) > 0 { list_get((model).theta_coeffs, 0) } else { 0.0 };
    let mu: Float = (model).mean;
    let mut last_e: Float = 0.0;
    let mut sse: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let y_t: Float = list_get(*series, i);
        let e_t: Float = y_t - mu - (theta * last_e);
        resids = list_push(resids, e_t);
        sse = sse + (e_t * e_t);
        last_e = e_t;
        i = i + 1;
    }

    let mse: Float = sse / int_to_float(n);
    return MaResidualResult {
        residuals: resids,
        mean_squared_error: mse
    };
}
