// # EWMA Statistical Process Control (SPC) Chart
//
// Logline: Implements EWMA control charts with exact time-varying Upper and Lower Control Limits ($UCL_t, LCL_t$).
//
// Setup: Detects subtle process drifts and manufacturing out-of-control conditions with smoothing parameter lambda (0.05 - 0.25).
//
// Beats:
//   1. Define EwmaSpcState and EwmaSpcResult structures.
//   2. Compute recursive EWMA statistic $Z_t = \lambda X_t + (1-\lambda) Z_{t-1}$.
//   3. Compute dynamic confidence band bounds and signal out-of-control process states.

pub type EwmaSpcState = struct {
    center_line_mu0: Float,
    process_sigma: Float,
    lambda: Float,
    control_limit_l: Float, // Typically 3.0
    current_z: Float,
    sample_index_t: Int
};

pub type EwmaSpcResult = struct {
    z_statistic: Float,
    ucl: Float,
    lcl: Float,
    is_out_of_control: Bool
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn ewma_spc_new(mu0: Float, sigma: Float, lambda: Float, l_sigma: Float) -> EwmaSpcState {
    return EwmaSpcState {
        center_line_mu0: mu0,
        process_sigma: sigma,
        lambda: lambda,
        control_limit_l: l_sigma,
        current_z: mu0,
        sample_index_t: 0
    };
}

pub fn ewma_spc_step(state: &mut EwmaSpcState, sample: Float) -> EwmaSpcResult {
    let lam: Float = (state).lambda;
    let mu0: Float = (state).center_line_mu0;
    let sig: Float = (state).process_sigma;
    let l_factor: Float = (state).control_limit_l;

    (state).sample_index_t = (state).sample_index_t + 1;
    let t: Int = (state).sample_index_t;

    let z_next: Float = (lam * sample) + ((1.0 - lam) * (state).current_z);
    (state).current_z = z_next;

    // Variance factor = (lambda / (2 - lambda))
    let var_ratio: Float = lam / (2.0 - lam);
    let sigma_z: Float = sig * math_sqrt(var_ratio);

    let ucl: Float = mu0 + (l_factor * sigma_z);
    let lcl: Float = mu0 - (l_factor * sigma_z);

    let ooc: Bool = if z_next > ucl || z_next < lcl { true } else { false };

    return EwmaSpcResult {
        z_statistic: z_next,
        ucl: ucl,
        lcl: lcl,
        is_out_of_control: ooc
    };
}
