// # MTBF, MTTR & Operational Availability KPIs
//
// Logline: Calculates Mean Time Between Failures (MTBF), Mean Time to Repair (MTTR), and Inherent Availability ($A_i$).
//
// Setup: Fundamental plant maintenance indicators driving reliability-centered maintenance (RCM) optimization.
//
// Beats:
//   1. Define ReliabilityKpiResult structure.
//   2. Calculate MTBF = $T_{\text{operating}} / N_{\text{failures}}$ and failure rate $\lambda = 1 / \text{MTBF}$.
//   3. Compute Mean Time to Repair (MTTR) and inherent system availability $A_i = \text{MTBF} / (\text{MTBF} + \text{MTTR})$.

pub type ReliabilityKpiResult = struct {
    mtbf_hours: Float,
    mttr_hours: Float,
    mttf_hours: Float,
    failure_rate_lambda: Float,
    inherent_availability_pct: Float,
    total_operating_hours: Float,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn calculate_reliability_kpis(
    total_operating_hours: Float,
    total_repair_downtime_hours: Float,
    num_failures: Int,
) -> ReliabilityKpiResult {
    let n_f: Float = int_to_float(num_failures);

    if num_failures <= 0 || total_operating_hours <= 0.0 {
        return ReliabilityKpiResult {
            mtbf_hours: total_operating_hours,
            mttr_hours: 0.0,
            mttf_hours: total_operating_hours,
            failure_rate_lambda: 0.0,
            inherent_availability_pct: 100.0,
            total_operating_hours: total_operating_hours,
        };
    }

    let mtbf: Float = total_operating_hours / n_f;
    let mttr: Float = total_repair_downtime_hours / n_f;
    let mttf: Float = if mtbf > mttr { mtbf - mttr } else { mtbf };
    let lambda: Float = if mtbf > 0.0 { 1.0 / mtbf } else { 0.0 };

    let total_cycle: Float = mtbf + mttr;
    let a_i: Float = if total_cycle > 0.0 { (mtbf / total_cycle) * 100.0 } else { 100.0 };

    return ReliabilityKpiResult {
        mtbf_hours: mtbf,
        mttr_hours: mttr,
        mttf_hours: mttf,
        failure_rate_lambda: lambda,
        inherent_availability_pct: a_i,
        total_operating_hours: total_operating_hours,
    };
}
