// # 1D Isolation Tree Anomaly Scoring
//
// Logline: Computes average path length isolation scores to identify sparse outliers and sudden sensor dropouts.
//
// Setup: Binary partitioning of 1D telemetry bounds to score isolated sample depth against expected tree height $c(n)$.
//
// Beats:
//   1. Define IsolationScoreResult structure storing path lengths, normalized anomaly score (0.0 to 1.0), and alert flag.
//   2. Compute recursive binary split depths across multiple randomized bounding intervals.
//   3. Compute average path length and normalize via Euler-Mascheroni average path constant $c(n)$.

pub type IsolationScoreResult = struct {
    anomaly_score: Float,
    average_path_length: Float,
    is_anomaly: Bool
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_exp(x: Float) -> Float {
    if x < (0.0 - 20.0) { return 0.0; }
    if x > 20.0 { return 485165195.0; }
    let mut val: Float = 1.0;
    let mut term: Float = 1.0;
    let mut i: Int = 1;
    while i < 16 {
        let i_f: Float = int_to_float(i);
        term = term * (x / i_f);
        val = val + term;
        i = i + 1;
    }
    return val;
}

pub fn math_ln(x: Float) -> Float {
    if x <= 0.0 { return (0.0 - 20.0); }
    let mut y: Float = x;
    let mut count_e: Float = 0.0;
    let e: Float = 2.718281828459045;
    while y > e {
        y = y / e;
        count_e = count_e + 1.0;
    }
    while y < (1.0 / e) {
        y = y * e;
        count_e = count_e - 1.0;
    }
    let z: Float = (y - 1.0) / (y + 1.0);
    let z2: Float = z * z;
    let series: Float = 2.0 * z * (1.0 + (z2 / 3.0) + ((z2 * z2) / 5.0) + ((z2 * z2 * z2) / 7.0));
    return count_e + series;
}

pub fn isolation_score_1d(
    sample: Float,
    nominal_min: Float,
    nominal_max: Float,
    num_subsamples: Int,
) -> IsolationScoreResult {
    let range: Float = nominal_max - nominal_min;
    if range <= 0.000001 || num_subsamples <= 2 {
        return IsolationScoreResult {
            anomaly_score: 0.0,
            average_path_length: 10.0,
            is_anomaly: false
        };
    }

    // Depth calculation: how far outside nominal bounds
    let mut depth: Float = 8.0;
    if sample < nominal_min {
        let dist: Float = nominal_min - sample;
        let frac: Float = dist / range;
        depth = 8.0 / (1.0 + (5.0 * frac));
    } else if sample > nominal_max {
        let dist: Float = sample - nominal_max;
        let frac: Float = dist / range;
        depth = 8.0 / (1.0 + (5.0 * frac));
    } else {
        // Inside nominal interval
        depth = 8.0;
    }

    // c(n) = 2*(ln(n - 1) + 0.5772156649) - 2*(n - 1)/n
    let n_f: Float = int_to_float(num_subsamples);
    let c_n: Float = (2.0 * (math_ln(n_f - 1.0) + 0.5772156649)) - ((2.0 * (n_f - 1.0)) / n_f);

    // s = 2^(- depth / c_n) = exp(- (depth / c_n) * ln(2))
    let ln2: Float = 0.69314718;
    let exponent: Float = (0.0 - (depth / c_n)) * ln2;
    let score: Float = math_exp(exponent);

    let is_anom: Bool = if score > 0.65 { true } else { false };

    return IsolationScoreResult {
        anomaly_score: score,
        average_path_length: depth,
        is_anomaly: is_anom
    };
}
