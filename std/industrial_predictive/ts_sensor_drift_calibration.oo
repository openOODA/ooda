// # Sensor Zero-Drift Calibration & Thermal Compensation
//
// Logline: Applies gain, offset, and 2-point temperature compensation to linearize raw analog industrial transducer signals.
//
// Setup: Compensates for physical sensor zero-drift and thermal coefficient of sensitivity (TCS) shifts across operating ambient ranges.
//
// Beats:
//   1. Define SensorCalibrationProfile and CompensatedSensorReading structures.
//   2. Apply 2-point linear gain and offset span calibration: $y_{\text{cal}} = \text{gain} \cdot x + \text{offset}$.
//   3. Compute thermal zero-shift and sensitivity correction across ambient temperature swings.

pub type SensorCalibrationProfile = struct {
    gain_multiplier: Float,
    zero_offset: Float,
    reference_temp_c: Float,
    temp_coefficient_zero: Float, // Zero drift per deg C
    temp_coefficient_span: Float, // Span drift per deg C
    max_range: Float,
    min_range: Float,
};

pub type CompensatedSensorReading = struct {
    calibrated_value: Float,
    temperature_corrected_value: Float,
    sensor_drift_amount: Float,
    is_in_range: Bool,
};

pub fn sensor_calibration_default_pt100() -> SensorCalibrationProfile {
    return SensorCalibrationProfile {
        gain_multiplier: 1.0,
        zero_offset: 0.0,
        reference_temp_c: 20.0,
        temp_coefficient_zero: 0.005,
        temp_coefficient_span: 0.0001,
        max_range: 200.0,
        min_range: (0.0 - 50.0),
    };
}

pub fn sensor_apply_calibration(
    profile: &SensorCalibrationProfile,
    raw_adc_reading: Float,
    ambient_temp_c: Float,
) -> CompensatedSensorReading {
    let y_cal: Float = ((profile).gain_multiplier * raw_adc_reading) + (profile).zero_offset;
    let dt: Float = ambient_temp_c - (profile).reference_temp_c;

    let zero_shift: Float = (profile).temp_coefficient_zero * dt;
    let span_shift: Float = (profile).temp_coefficient_span * dt * y_cal;

    let y_comp: Float = y_cal - zero_shift - span_shift;
    let drift: Float = y_comp - raw_adc_reading;

    let in_rng: Bool = if y_comp >= (profile).min_range && y_comp <= (profile).max_range { true } else { false };

    return CompensatedSensorReading {
        calibrated_value: y_cal,
        temperature_corrected_value: y_comp,
        sensor_drift_amount: drift,
        is_in_range: in_rng,
    };
}
