// # Sliding Window Median Filter & Spike Rejection
//
// Logline: Applies sliding window median filtering with threshold clipping to strip isolated sensor spikes and ADC glitches.
//
// Setup: Windowed sorting buffer replacing impulsive transient artifacts with robust local medians.
//
// Beats:
//   1. Define MedianFilterResult structure storing smoothed series and rejected spike count.
//   2. Extract sliding window slice and sort local 3-point or 5-point buffer.
//   3. Substitute sample with median if deviation exceeds maximum permissible rate-of-change.

pub type MedianFilterResult = struct {
    filtered_series: List[Float],
    num_spikes_clipped: Int,
    window_size: Int
};

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn median_sort_3(a: Float, b: Float, c: Float) -> Float {
    if (a >= b && a <= c) || (a >= c && a <= b) { return a; }
    if (b >= a && b <= c) || (b >= c && b <= a) { return b; }
    return c;
}

pub fn median_filter_3pt(series: &List[Float], max_spike_delta: Float) -> MedianFilterResult {
    let n: Int = list_len(*series);
    let mut out: List[Float] = list_new();
    let mut spikes: Int = 0;

    if n <= 2 {
        return MedianFilterResult {
            filtered_series: *series,
            num_spikes_clipped: 0,
            window_size: 3
        };
    }

    out = list_push(out, list_get(*series, 0));

    let mut i: Int = 1;
    while i < (n - 1) {
        let v_prev: Float = list_get(*series, i - 1);
        let v_cur: Float = list_get(*series, i);
        let v_next: Float = list_get(*series, i + 1);

        let med: Float = median_sort_3(v_prev, v_cur, v_next);
        let diff: Float = math_abs(v_cur - med);

        if max_spike_delta > 0.0 && diff > max_spike_delta {
            out = list_push(out, med);
            spikes = spikes + 1;
        } else {
            out = list_push(out, med);
        }
        i = i + 1;
    }

    out = list_push(out, list_get(*series, n - 1));

    return MedianFilterResult {
        filtered_series: out,
        num_spikes_clipped: spikes,
        window_size: 3
    };
}
