// # 1D Kalman Sensor Debiasing & Drift Estimator
//
// Logline: Recursive 2-state discrete Kalman filter estimating true physical process variables while tracking slow sensor bias drift.
//
// Setup: State vector $[x, b]^T$ separates high-frequency dynamic signal from slow additive calibration offsets.
//
// Beats:
//   1. Define KalmanDebiasState and KalmanEstimate structures.
//   2. Compute state and covariance prediction step with process noise injection.
//   3. Update measurement innovation, compute Kalman gain, and debias sensor readout.

pub type KalmanDebiasState = struct {
    estimated_value: Float,
    estimated_bias: Float,
    p00: Float, p01: Float,
    p10: Float, p11: Float,
    q_value_noise: Float,
    q_bias_drift: Float,
    r_measurement_noise: Float,
};

pub type KalmanEstimate = struct {
    debiased_value: Float,
    current_bias: Float,
    estimation_uncertainty: Float,
    innovation_residual: Float,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn kalman_debias_new(init_val: Float, q_val: Float, q_bias: Float, r_meas: Float) -> KalmanDebiasState {
    return KalmanDebiasState {
        estimated_value: init_val,
        estimated_bias: 0.0,
        p00: 1.0, p01: 0.0,
        p10: 0.0, p11: 0.1,
        q_value_noise: q_val,
        q_bias_drift: q_bias,
        r_measurement_noise: r_meas,
    };
}

pub fn kalman_debias_update(state: &mut KalmanDebiasState, raw_sensor_reading: Float) -> KalmanEstimate {
    // 1. Predict Step
    let x_pred: Float = (state).estimated_value;
    let b_pred: Float = (state).estimated_bias;

    let p00_pred: Float = (state).p00 + (state).q_value_noise;
    let p01_pred: Float = (state).p01;
    let p10_pred: Float = (state).p10;
    let p11_pred: Float = (state).p11 + (state).q_bias_drift;

    // Measurement model: z = x + b
    let z_pred: Float = x_pred + b_pred;
    let innovation: Float = raw_sensor_reading - z_pred;

    // Innovation covariance: S = P00 + P01 + P10 + P11 + R
    let s: Float = p00_pred + p01_pred + p10_pred + p11_pred + (state).r_measurement_noise;
    let s_inv: Float = if s > 0.000001 { 1.0 / s } else { 1.0 };

    // Kalman gain: K = [ (P00 + P01)/S, (P10 + P11)/S ]^T
    let k0: Float = (p00_pred + p01_pred) * s_inv;
    let k1: Float = (p10_pred + p11_pred) * s_inv;

    // 2. Update Step
    let x_upd: Float = x_pred + (k0 * innovation);
    let b_upd: Float = b_pred + (k1 * innovation);

    let p00_upd: Float = p00_pred - (k0 * (p00_pred + p10_pred));
    let p01_upd: Float = p01_pred - (k0 * (p01_pred + p11_pred));
    let p10_upd: Float = p10_pred - (k1 * (p00_pred + p10_pred));
    let p11_upd: Float = p11_pred - (k1 * (p01_pred + p11_pred));

    (state).estimated_value = x_upd;
    (state).estimated_bias = b_upd;
    (state).p00 = p00_upd;
    (state).p01 = p01_upd;
    (state).p10 = p10_upd;
    (state).p11 = p11_upd;

    return KalmanEstimate {
        debiased_value: x_upd,
        current_bias: b_upd,
        estimation_uncertainty: math_sqrt(p00_upd),
        innovation_residual: innovation,
    };
}
