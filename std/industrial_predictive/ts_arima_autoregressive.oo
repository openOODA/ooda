// # ARIMA Autoregressive Integrated Moving Average
//
// Logline: Time series modeling and multi-step forecasting using difference integration, autoregression, and moving average innovations.
//
// Setup: Fits AR(p), I(d), and MA(q) parameters with residual error estimation and stepwise forecasting.
//
// Beats:
//   1. Implement recursive series differencing (d=1, d=2) and reconstruction integration.
//   2. Estimate AR(p) autoregressive coefficients using least-squares autocorrelation.
//   3. Forecast forward steps by combining autoregressive lag sums and residual innovations.

pub type ArimaModel = struct {
    p_order: Int,
    d_order: Int,
    q_order: Int,
    ar_coeffs: List[Float],
    ma_coeffs: List[Float],
    intercept: Float,
    sigma2: Float
};

pub type ArimaForecast = struct {
    forecasts: List[Float],
    horizon: Int
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn arima_diff(series: &List[Float], order: Int) -> List[Float] {
    let n: Int = list_len(*series);
    if order <= 0 || n <= 1 {
        return *series;
    }
    let mut cur: List[Float] = *series;
    let mut step: Int = 0;
    while step < order {
        let cur_len: Int = list_len(cur);
        if cur_len <= 1 {
            return cur;
        }
        let mut diffed: List[Float] = list_new();
        let mut i: Int = 1;
        while i < cur_len {
            let v1: Float = list_get(cur, i);
            let v0: Float = list_get(cur, i - 1);
            diffed = list_push(diffed, v1 - v0);
            i = i + 1;
        }
        cur = diffed;
        step = step + 1;
    }
    return cur;
}

pub fn arima_undiff_step(last_val: Float, diff_val: Float) -> Float {
    return last_val + diff_val;
}

pub fn arima_fit_ar1(diff_series: &List[Float]) -> ArimaModel {
    let n: Int = list_len(*diff_series);
    let mut ar_list: List[Float] = list_new();
    let mut ma_list: List[Float] = list_new();
    if n < 3 {
        ar_list = list_push(ar_list, 0.5);
        return ArimaModel {
            p_order: 1,
            d_order: 1,
            q_order: 0,
            ar_coeffs: ar_list,
            ma_coeffs: ma_list,
            intercept: 0.0,
            sigma2: 1.0
        };
    }

    let mut sum_xy: Float = 0.0;
    let mut sum_xx: Float = 0.0;
    let mut sum_y: Float = 0.0;
    let mut i: Int = 1;
    while i < n {
        let y_t: Float = list_get(*diff_series, i);
        let y_prev: Float = list_get(*diff_series, i - 1);
        sum_xy = sum_xy + (y_t * y_prev);
        sum_xx = sum_xx + (y_prev * y_prev);
        sum_y = sum_y + y_t;
        i = i + 1;
    }

    let phi: Float = if sum_xx > 0.00001 { sum_xy / sum_xx } else { 0.0 };
    let n_f: Float = int_to_float(n - 1);
    let mu: Float = sum_y / n_f;
    let intercept: Float = mu * (1.0 - phi);

    let mut sse: Float = 0.0;
    i = 1;
    while i < n {
        let y_t: Float = list_get(*diff_series, i);
        let y_prev: Float = list_get(*diff_series, i - 1);
        let pred: Float = intercept + (phi * y_prev);
        let err: Float = y_t - pred;
        sse = sse + (err * err);
        i = i + 1;
    }
    let sig2: Float = sse / n_f;

    ar_list = list_push(ar_list, phi);

    return ArimaModel {
        p_order: 1,
        d_order: 1,
        q_order: 0,
        ar_coeffs: ar_list,
        ma_coeffs: ma_list,
        intercept: intercept,
        sigma2: sig2
    };
}

pub fn arima_forecast_steps(model: &ArimaModel, history: &List[Float], horizon: Int) -> ArimaForecast {
    let mut fc: List[Float] = list_new();
    let n: Int = list_len(*history);
    if n == 0 || horizon <= 0 {
        return ArimaForecast { forecasts: fc, horizon: 0 };
    }

    let phi: Float = if list_len((model).ar_coeffs) > 0 { list_get((model).ar_coeffs, 0) } else { 0.0 };
    let mut last_raw: Float = list_get(*history, n - 1);
    let prev_raw: Float = if n >= 2 { list_get(*history, n - 2) } else { last_raw };
    let mut last_diff: Float = last_raw - prev_raw;

    let mut h: Int = 0;
    while h < horizon {
        let next_diff: Float = (model).intercept + (phi * last_diff);
        let next_raw: Float = last_raw + next_diff;
        fc = list_push(fc, next_raw);
        last_diff = next_diff;
        last_raw = next_raw;
        h = h + 1;
    }

    return ArimaForecast {
        forecasts: fc,
        horizon: horizon
    };
}
