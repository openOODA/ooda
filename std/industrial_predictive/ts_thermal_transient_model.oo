// # Thermal Transient Rise & Cooling Curve Predictor
//
// Logline: Models 1st-order lumped thermal capacitance heating and exponential cooling curves to forecast temperature trip times.
//
// Setup: Solves $T(t) = T_{\text{amb}} + \Delta T_{\text{ss}}(1 - e^{-t/\tau}) + (T_0 - T_{\text{amb}})e^{-t/\tau}$ for electrical windings and gearboxes.
//
// Beats:
//   1. Define ThermalModelParams and ThermalTransientPrediction structures.
//   2. Forecast time-series temperature trajectory under steady electrical load.
//   3. Compute exact analytical minutes remaining until maximum permissible thermal trip limit.

pub type ThermalModelParams = struct {
    ambient_temp_c: Float,
    steady_state_temp_rise_c: Float,
    thermal_time_constant_min: Float, // tau
    trip_limit_temp_c: Float,
};

pub type ThermalTransientPrediction = struct {
    predicted_steady_state_temp_c: Float,
    minutes_until_trip_alarm: Float,
    is_thermal_overload: Bool,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_ln(x: Float) -> Float {
    if x <= 0.0 { return (0.0 - 20.0); }
    let mut y: Float = x;
    let mut count_e: Float = 0.0;
    let e: Float = 2.718281828459045;
    while y > e {
        y = y / e;
        count_e = count_e + 1.0;
    }
    while y < (1.0 / e) {
        y = y * e;
        count_e = count_e - 1.0;
    }
    let z: Float = (y - 1.0) / (y + 1.0);
    let z2: Float = z * z;
    let series: Float = 2.0 * z * (1.0 + (z2 / 3.0) + ((z2 * z2) / 5.0) + ((z2 * z2 * z2) / 7.0));
    return count_e + series;
}

pub fn thermal_predict_overload(
    params: &ThermalModelParams,
    initial_temp_c: Float,
) -> ThermalTransientPrediction {
    let t_amb: Float = (params).ambient_temp_c;
    let dt_ss: Float = (params).steady_state_temp_rise_c;
    let tau: Float = (params).thermal_time_constant_min;
    let t_trip: Float = (params).trip_limit_temp_c;

    let t_final_ss: Float = t_amb + dt_ss;
    let is_overload: Bool = if t_final_ss >= t_trip { true } else { false };

    let mut time_to_trip: Float = 99999.0;
    if is_overload && initial_temp_c < t_trip && tau > 0.0 {
        // T_trip = T_amb + dt_ss*(1 - e^(-t/tau)) + (T0 - T_amb)*e^(-t/tau)
        // Let y = e^(-t/tau), then T_trip - (T_amb + dt_ss) = y * (T0 - T_amb - dt_ss)
        let num: Float = t_trip - t_final_ss;
        let denom: Float = initial_temp_c - t_final_ss;
        let ratio: Float = if denom != 0.0 { num / denom } else { 0.0 };

        if ratio > 0.0 && ratio < 1.0 {
            time_to_trip = (0.0 - tau) * math_ln(ratio);
        }
    } else if initial_temp_c >= t_trip {
        time_to_trip = 0.0;
    }

    return ThermalTransientPrediction {
        predicted_steady_state_temp_c: t_final_ss,
        minutes_until_trip_alarm: time_to_trip,
        is_thermal_overload: is_overload,
    };
}
