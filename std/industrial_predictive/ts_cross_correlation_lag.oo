// # Lagged Cross-Correlation & Lead/Lag Identification
//
// Logline: Calculates normalized cross-correlation sequences to identify optimal temporal lag and phase delay between sensor pairs.
//
// Setup: Measures causal coupling, propagation delay, and phase synchronization across industrial telemetry channels.
//
// Beats:
//   1. Define CrossCorrelationResult storing correlation values, peak correlation, and optimal lag.
//   2. Compute normalized cross-correlation $\rho_{xy}(\tau)$ across positive and negative lag horizons.
//   3. Extract optimal lead/lag offset and determine leading sensor indicator.

pub type CrossCorrelationResult = struct {
    lags: List[Int],
    correlations: List[Float],
    optimal_lag: Int,
    peak_correlation: Float,
    is_x_leading: Bool
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn cross_correlation_lagged(x: &List[Float], y: &List[Float], max_lag: Int) -> CrossCorrelationResult {
    let n: Int = list_len(*x);
    let ny: Int = list_len(*y);
    let mut lag_list: List[Int] = list_new();
    let mut corr_list: List[Float] = list_new();

    if n == 0 || ny == 0 || n != ny || max_lag < 0 {
        return CrossCorrelationResult {
            lags: lag_list,
            correlations: corr_list,
            optimal_lag: 0,
            peak_correlation: 0.0,
            is_x_leading: false
        };
    }

    let n_f: Float = int_to_float(n);
    let mut sum_x: Float = 0.0;
    let mut sum_y: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        sum_x = sum_x + list_get(*x, i);
        sum_y = sum_y + list_get(*y, i);
        i = i + 1;
    }
    let mean_x: Float = sum_x / n_f;
    let mean_y: Float = sum_y / n_f;

    let mut var_x: Float = 0.0;
    let mut var_y: Float = 0.0;
    i = 0;
    while i < n {
        let dx: Float = list_get(*x, i) - mean_x;
        let dy: Float = list_get(*y, i) - mean_y;
        var_x = var_x + (dx * dx);
        var_y = var_y + (dy * dy);
        i = i + 1;
    }
    let denom: Float = math_sqrt(var_x * var_y);

    let mut best_lag: Int = 0;
    let mut best_corr: Float = 0.0;
    let mut best_abs_corr: Float = 0.0 - 1.0;

    let mut lag: Int = 0 - max_lag;
    while lag <= max_lag {
        let mut cov: Float = 0.0;
        i = 0;
        while i < n {
            let j: Int = i + lag;
            if j >= 0 && j < n {
                let dx: Float = list_get(*x, i) - mean_x;
                let dy: Float = list_get(*y, j) - mean_y;
                cov = cov + (dx * dy);
            }
            i = i + 1;
        }

        let r: Float = if denom > 0.000001 { cov / denom } else { 0.0 };
        lag_list = list_push(lag_list, lag);
        corr_list = list_push(corr_list, r);

        let abs_r: Float = math_abs(r);
        if abs_r > best_abs_corr {
            best_abs_corr = abs_r;
            best_corr = r;
            best_lag = lag;
        }
        lag = lag + 1;
    }

    return CrossCorrelationResult {
        lags: lag_list,
        correlations: corr_list,
        optimal_lag: best_lag,
        peak_correlation: best_corr,
        is_x_leading: (best_lag > 0)
    };
}
