// # Savitzky-Golay Polynomial Smoothing Filter
//
// Logline: Applies 5-point and 7-point Savitzky-Golay convolution kernels to smooth industrial sensor signals while preserving peak morphology.
//
// Setup: Convolution weights derived from local least-squares polynomial fits to preserve extrema height and line width.
//
// Beats:
//   1. Define SavitzkyGolayResult structure.
//   2. Apply 5-point quadratic kernel: $[-3, 12, 17, 12, -3] / 35$.
//   3. Apply 7-point quadratic kernel: $[-2, 3, 6, 7, 6, 3, -2] / 21$.

pub type SavitzkyGolayResult = struct {
    smoothed_series: List[Float],
    kernel_size: Int,
    polynomial_order: Int
};

pub fn sg_smooth_5pt(series: &List[Float]) -> SavitzkyGolayResult {
    let n: Int = list_len(*series);
    let mut out: List[Float] = list_new();

    if n < 5 {
        return SavitzkyGolayResult {
            smoothed_series: *series,
            kernel_size: 5,
            polynomial_order: 2
        };
    }

    out = list_push(out, list_get(*series, 0));
    out = list_push(out, list_get(*series, 1));

    let mut i: Int = 2;
    while i < (n - 2) {
        let y_m2: Float = list_get(*series, i - 2);
        let y_m1: Float = list_get(*series, i - 1);
        let y_0: Float  = list_get(*series, i);
        let y_p1: Float = list_get(*series, i + 1);
        let y_p2: Float = list_get(*series, i + 2);

        let conv: Float = ((0.0 - 3.0) * y_m2) + (12.0 * y_m1) + (17.0 * y_0) + (12.0 * y_p1) - (3.0 * y_p2);
        let val: Float = conv / 35.0;
        out = list_push(out, val);
        i = i + 1;
    }

    out = list_push(out, list_get(*series, n - 2));
    out = list_push(out, list_get(*series, n - 1));

    return SavitzkyGolayResult {
        smoothed_series: out,
        kernel_size: 5,
        polynomial_order: 2
    };
}

pub fn sg_smooth_7pt(series: &List[Float]) -> SavitzkyGolayResult {
    let n: Int = list_len(*series);
    let mut out: List[Float] = list_new();

    if n < 7 {
        return SavitzkyGolayResult {
            smoothed_series: *series,
            kernel_size: 7,
            polynomial_order: 2
        };
    }

    out = list_push(out, list_get(*series, 0));
    out = list_push(out, list_get(*series, 1));
    out = list_push(out, list_get(*series, 2));

    let mut i: Int = 3;
    while i < (n - 3) {
        let y_m3: Float = list_get(*series, i - 3);
        let y_m2: Float = list_get(*series, i - 2);
        let y_m1: Float = list_get(*series, i - 1);
        let y_0: Float  = list_get(*series, i);
        let y_p1: Float = list_get(*series, i + 1);
        let y_p2: Float = list_get(*series, i + 2);
        let y_p3: Float = list_get(*series, i + 3);

        let conv: Float = ((0.0 - 2.0) * y_m3) + (3.0 * y_m2) + (6.0 * y_m1) + (7.0 * y_0) + (6.0 * y_p1) + (3.0 * y_p2) - (2.0 * y_p3);
        let val: Float = conv / 21.0;
        out = list_push(out, val);
        i = i + 1;
    }

    out = list_push(out, list_get(*series, n - 3));
    out = list_push(out, list_get(*series, n - 2));
    out = list_push(out, list_get(*series, n - 1));

    return SavitzkyGolayResult {
        smoothed_series: out,
        kernel_size: 7,
        polynomial_order: 2
    };
}

pub fn ts_savitzky_golay_filter_probe() -> Int {
    return 0;
}
