// # Pruned Change-Point Search & Regime Detection
//
// Logline: Detects structural mean shift change-points across operational time-series via penalized least-squares cost minimization.
//
// Setup: Evaluates segment cost functions $\sum (y_i - \bar{y})^2 + \beta$ to locate discrete operating mode changes.
//
// Beats:
//   1. Define ChangePointResult structure storing detected change index, pre/post means, and cost reduction.
//   2. Compute piecewise segment sum-of-squares cost for candidate split positions.
//   3. Extract optimal split index maximizing penalized residual variance reduction.

pub type ChangePointResult = struct {
    best_split_index: Int,
    pre_shift_mean: Float,
    post_shift_mean: Float,
    total_cost_reduction: Float,
    is_significant_shift: Bool
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn change_point_search_single(
    series: &List[Float],
    min_segment_len: Int,
    penalty_beta: Float,
) -> ChangePointResult {
    let n: Int = list_len(*series);
    if n < (2 * min_segment_len) || min_segment_len <= 1 {
        return ChangePointResult {
            best_split_index: 0 - 1,
            pre_shift_mean: 0.0,
            post_shift_mean: 0.0,
            total_cost_reduction: 0.0,
            is_significant_shift: false
        };
    }

    // Total baseline cost without split
    let n_f: Float = int_to_float(n);
    let mut total_sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        total_sum = total_sum + list_get(*series, i);
        i = i + 1;
    }
    let global_mean: Float = total_sum / n_f;

    let mut global_sse: Float = 0.0;
    i = 0;
    while i < n {
        let diff: Float = list_get(*series, i) - global_mean;
        global_sse = global_sse + (diff * diff);
        i = i + 1;
    }

    let mut best_split: Int = 0 - 1;
    let mut min_cost: Float = global_sse;
    let mut best_m1: Float = global_mean;
    let mut best_m2: Float = global_mean;

    let mut split: Int = min_segment_len;
    while split <= (n - min_segment_len) {
        let mut sum1: Float = 0.0;
        let mut sum2: Float = 0.0;
        let n1_f: Float = int_to_float(split);
        let n2_f: Float = int_to_float(n - split);

        i = 0;
        while i < split {
            sum1 = sum1 + list_get(*series, i);
            i = i + 1;
        }
        while i < n {
            sum2 = sum2 + list_get(*series, i);
            i = i + 1;
        }

        let m1: Float = sum1 / n1_f;
        let m2: Float = sum2 / n2_f;

        let mut sse1: Float = 0.0;
        let mut sse2: Float = 0.0;
        i = 0;
        while i < split {
            let d: Float = list_get(*series, i) - m1;
            sse1 = sse1 + (d * d);
            i = i + 1;
        }
        while i < n {
            let d: Float = list_get(*series, i) - m2;
            sse2 = sse2 + (d * d);
            i = i + 1;
        }

        let cost_split: Float = sse1 + sse2 + penalty_beta;
        if cost_split < min_cost {
            min_cost = cost_split;
            best_split = split;
            best_m1 = m1;
            best_m2 = m2;
        }
        split = split + 1;
    }

    let reduction: Float = global_sse - min_cost;
    let is_sig: Bool = if best_split > 0 && reduction > 0.0 { true } else { false };

    return ChangePointResult {
        best_split_index: best_split,
        pre_shift_mean: best_m1,
        post_shift_mean: best_m2,
        total_cost_reduction: reduction,
        is_significant_shift: is_sig
    };
}
