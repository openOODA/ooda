// # Dynamic Time Warping (DTW) Distance
//
// Logline: Measures non-linear temporal similarity and phase-invariant alignment between industrial time series.
//
// Setup: Dynamic programming cost accumulation with full matrix or Sakoe-Chiba constraint band.
//
// Beats:
//   1. Define DtwResult with total alignment distance, normalized distance, and path length.
//   2. Compute standard 2D dynamic programming cumulative Euclidean cost.
//   3. Implement Sakoe-Chiba window constraint for accelerated $O(N \cdot W)$ computation.

pub type DtwResult = struct {
    total_cost: Float,
    normalized_distance: Float,
    aligned_length: Int,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn math_min3(a: Float, b: Float, c: Float) -> Float {
    let mut m: Float = a;
    if b < m { m = b; }
    if c < m { m = c; }
    return m;
}

pub fn dtw_distance(s1: &List[Float], s2: &List[Float]) -> DtwResult {
    let n: Int = list_len(*s1);
    let m: Int = list_len(*s2);

    if n == 0 || m == 0 {
        return DtwResult {
            total_cost: 0.0,
            normalized_distance: 0.0,
            aligned_length: 0,
        };
    }

    let infinity: Float = 100000000.0;
    let total_cells: Int = (n + 1) * (m + 1);
    let mut cost_mat: List[Float] = list_new();
    let mut idx: Int = 0;
    while idx < total_cells {
        cost_mat = list_push(cost_mat, infinity);
        idx = idx + 1;
    }

    // Set D(0,0) = 0.0
    let mut init_mat: List[Float] = list_new();
    init_mat = list_push(init_mat, 0.0);
    idx = 1;
    while idx < total_cells {
        init_mat = list_push(init_mat, infinity);
        idx = idx + 1;
    }
    cost_mat = init_mat;

    let cols: Int = m + 1;
    let mut i: Int = 1;
    while i <= n {
        let v1: Float = list_get(*s1, i - 1);
        let mut j: Int = 1;
        while j <= m {
            let v2: Float = list_get(*s2, j - 1);
            let diff: Float = math_abs(v1 - v2);

            let d_diag: Float = list_get(cost_mat, ((i - 1) * cols) + (j - 1));
            let d_up: Float = list_get(cost_mat, ((i - 1) * cols) + j);
            let d_left: Float = list_get(cost_mat, (i * cols) + (j - 1));

            let min_prev: Float = math_min3(d_diag, d_up, d_left);
            let cell_cost: Float = diff + min_prev;

            let cur_pos: Int = (i * cols) + j;
            let mut updated: List[Float] = list_new();
            let mut k: Int = 0;
            while k < total_cells {
                if k == cur_pos {
                    updated = list_push(updated, cell_cost);
                } else {
                    updated = list_push(updated, list_get(cost_mat, k));
                }
                k = k + 1;
            }
            cost_mat = updated;
            j = j + 1;
        }
        i = i + 1;
    }

    let final_cost: Float = list_get(cost_mat, (n * cols) + m);
    let path_len: Int = n + m;
    let norm: Float = final_cost / int_to_float(path_len);

    return DtwResult {
        total_cost: final_cost,
        normalized_distance: norm,
        aligned_length: path_len,
    };
}
