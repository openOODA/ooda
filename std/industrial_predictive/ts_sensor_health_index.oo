// # Composite Asset Health Index (HI) & Degradation Grading
//
// Logline: Fuses mechanical vibration, thermal rise, oil condition, and electrical stress into a normalized 0-100% Health Index.
//
// Setup: Multi-criteria weighted geometric/arithmetic aggregation assigning asset degradation letter grades (A through F).
//
// Beats:
//   1. Define SubsystemHealthMetrics and CompositeHealthReport structures.
//   2. Compute weighted composite score $HI = \sum w_i \cdot HI_i$ with minimum-subsystem bottleneck penalty.
//   3. Assign asset condition letter grade (A=Pristine, B=Good, C=Fair/Alert, D=Poor, F=Critical).

pub type SubsystemHealthMetrics = struct {
    vibration_health_pct: Float,
    thermal_health_pct: Float,
    lubrication_health_pct: Float,
    electrical_health_pct: Float,
};

pub type CompositeHealthReport = struct {
    composite_health_index: Float,
    health_grade_code: Int, // 1='A', 2='B', 3='C', 4='D', 5='F'
    limiting_subsystem_code: Int, // 1=Vibration, 2=Thermal, 3=Lubrication, 4=Electrical
    is_maintenance_required: Bool,
};

pub fn compute_composite_health(metrics: &SubsystemHealthMetrics) -> CompositeHealthReport {
    let v: Float = (metrics).vibration_health_pct;
    let t: Float = (metrics).thermal_health_pct;
    let l: Float = (metrics).lubrication_health_pct;
    let e: Float = (metrics).electrical_health_pct;

    // Weights: Vibration=0.35, Thermal=0.25, Lubrication=0.20, Electrical=0.20
    let weighted_avg: Float = (0.35 * v) + (0.25 * t) + (0.20 * l) + (0.20 * e);

    // Identify minimum bottleneck subsystem
    let mut min_val: Float = v;
    let mut min_code: Int = 1;

    if t < min_val {
        min_val = t;
        min_code = 2;
    }
    if l < min_val {
        min_val = l;
        min_code = 3;
    }
    if e < min_val {
        min_val = e;
        min_code = 4;
    }

    // Penalize composite HI if any single critical subsystem is severely degraded
    let mut final_hi: Float = weighted_avg;
    if min_val < 50.0 {
        final_hi = (0.7 * weighted_avg) + (0.3 * min_val);
    }

    let mut grade: Int = 1; // 'A'
    if final_hi >= 90.0 {
        grade = 1; // A
    } else if final_hi >= 75.0 {
        grade = 2; // B
    } else if final_hi >= 50.0 {
        grade = 3; // C
    } else if final_hi >= 25.0 {
        grade = 4; // D
    } else {
        grade = 5; // F
    }

    let maint_req: Bool = if grade >= 3 { true } else { false };

    return CompositeHealthReport {
        composite_health_index: final_hi,
        health_grade_code: grade,
        limiting_subsystem_code: min_code,
        is_maintenance_required: maint_req,
    };
}
