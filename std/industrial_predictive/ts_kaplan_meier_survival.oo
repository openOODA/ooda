// # Kaplan-Meier Non-Parametric Survival Curve
//
// Logline: Calculates product-limit empirical survival curves for right-censored industrial equipment fleet failure datasets.
//
// Setup: Multiplies conditional survival probabilities $(1 - d_i / n_i)$ across discrete observed failure event times.
//
// Beats:
//   1. Define KaplanMeierPoint and KaplanMeierCurve structures.
//   2. Step through sorted failure and censoring events with active at-risk counters.
//   3. Interpolate empirical survival probability and median fleet lifetime.

pub type KaplanMeierPoint = struct {
    time_hours: Float,
    at_risk_count: Int,
    failed_count: Int,
    survival_prob: Float,
};

pub type KaplanMeierCurve = struct {
    points: List[KaplanMeierPoint],
    num_events: Int,
    median_lifetime_hours: Float,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn km_curve_new() -> KaplanMeierCurve {
    let mut pts: List[KaplanMeierPoint] = list_new();
    return KaplanMeierCurve {
        points: pts,
        num_events: 0,
        median_lifetime_hours: 0.0,
    };
}

pub fn km_fit_simple(
    event_times: &List[Float],
    event_d: &List[Int],
    at_risk_n: &List[Int],
) -> KaplanMeierCurve {
    let k: Int = list_len(*event_times);
    let mut pts: List[KaplanMeierPoint] = list_new();
    if k == 0 {
        return km_curve_new();
    }

    let mut current_surv: Float = 1.0;
    let mut med_life: Float = 0.0;
    let mut med_found: Bool = false;

    let mut i: Int = 0;
    while i < k {
        let t: Float = list_get(*event_times, i);
        let d: Int = list_get(*event_d, i);
        let n: Int = list_get(*at_risk_n, i);

        let d_f: Float = int_to_float(d);
        let n_f: Float = int_to_float(n);

        if n > 0 {
            let p_step: Float = 1.0 - (d_f / n_f);
            current_surv = current_surv * p_step;
        }

        if (!med_found) && current_surv <= 0.5 {
            med_life = t;
            med_found = true;
        }

        let pt = KaplanMeierPoint {
            time_hours: t,
            at_risk_count: n,
            failed_count: d,
            survival_prob: current_surv,
        };
        pts = list_push(pts, pt);
        i = i + 1;
    }

    return KaplanMeierCurve {
        points: pts,
        num_events: k,
        median_lifetime_hours: med_life,
    };
}

pub fn km_eval_survival(curve: &KaplanMeierCurve, query_time: Float) -> Float {
    let k: Int = (curve).num_events;
    if k == 0 { return 1.0; }

    let mut s: Float = 1.0;
    let mut i: Int = 0;
    while i < k {
        let pt: KaplanMeierPoint = list_get((curve).points, i);
        if (pt).time_hours <= query_time {
            s = (pt).survival_prob;
        }
        i = i + 1;
    }
    return s;
}
