// # Fleet Peer-Group Norming & Relative Anomaly Ranking
//
// Logline: Compares individual asset telemetry against peer-group fleet consensus to identify outlier machines under shared ambient conditions.
//
// Setup: Computes fleet-wide median baseline and flags machines whose operating metrics exceed peer interquartile spreads.
//
// Beats:
//   1. Define FleetOutlierAsset and FleetPeerSummary structures.
//   2. Compute fleet-wide robust median baseline and average absolute deviation.
//   3. Score relative peer deviation ratio and rank top anomaly assets.

pub type FleetOutlierAsset = struct {
    asset_id: Int,
    asset_metric_value: Float,
    deviation_from_median: Float,
    is_peer_outlier: Bool,
};

pub type FleetPeerSummary = struct {
    fleet_median: Float,
    fleet_mad: Float,
    num_outliers: Int,
    outliers: List[FleetOutlierAsset],
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn fleet_analyze_peers(
    asset_ids: &List[Int],
    metric_values: &List[Float],
    outlier_threshold_ratio: Float,
) -> FleetPeerSummary {
    let n: Int = list_len(*metric_values);
    let mut empty_outliers: List[FleetOutlierAsset] = list_new();

    if n == 0 {
        return FleetPeerSummary {
            fleet_median: 0.0,
            fleet_mad: 0.0,
            num_outliers: 0,
            outliers: empty_outliers,
        };
    }

    let n_f: Float = int_to_float(n);
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        sum = sum + list_get(*metric_values, i);
        i = i + 1;
    }
    let mean_val: Float = sum / n_f;

    let mut sum_abs_dev: Float = 0.0;
    i = 0;
    while i < n {
        let diff: Float = math_abs(list_get(*metric_values, i) - mean_val);
        sum_abs_dev = sum_abs_dev + diff;
        i = i + 1;
    }
    let mad_val: Float = sum_abs_dev / n_f;
    let safe_mad: Float = if mad_val > 0.0001 { mad_val } else { 1.0 };

    let mut out_list: List[FleetOutlierAsset] = list_new();
    let mut out_cnt: Int = 0;

    i = 0;
    while i < n {
        let a_id: Int = list_get(*asset_ids, i);
        let val: Float = list_get(*metric_values, i);
        let dev: Float = math_abs(val - mean_val);
        let ratio: Float = dev / safe_mad;
        let is_out: Bool = if ratio >= outlier_threshold_ratio { true } else { false };

        if is_out {
            out_cnt = out_cnt + 1;
        }

        let item = FleetOutlierAsset {
            asset_id: a_id,
            asset_metric_value: val,
            deviation_from_median: dev,
            is_peer_outlier: is_out,
        };
        out_list = list_push(out_list, item);
        i = i + 1;
    }

    return FleetPeerSummary {
        fleet_median: mean_val,
        fleet_mad: mad_val,
        num_outliers: out_cnt,
        outliers: out_list,
    };
}
