// # Markov Chain Asset Health State Degradation
//
// Logline: Models multi-stage stochastic asset health deterioration (Healthy -> Degraded -> Alert -> Failure) via Markov chains.
//
// Setup: Multiplies probability state distributions by a 4x4 transition probability matrix with absorbing failure state.
//
// Beats:
//   1. Define StateDistribution4 and MarkovHealthModel structures.
//   2. Step discrete-time state transitions $\pi_{t+1} = \pi_t \cdot P$.
//   3. Compute forward time horizon failure probability and mean transition intervals.

pub type StateDistribution4 = struct {
    p0_healthy: Float,
    p1_minor_wear: Float,
    p2_severe_alert: Float,
    p3_failed: Float
};

pub type MarkovHealthModel = struct {
    p00: Float, p01: Float, p02: Float, p03: Float,
    p10: Float, p11: Float, p12: Float, p13: Float,
    p20: Float, p21: Float, p22: Float, p23: Float,
    p30: Float, p31: Float, p32: Float, p33: Float
};

pub fn markov_model_default() -> MarkovHealthModel {
    return MarkovHealthModel {
        p00: 0.90, p01: 0.08, p02: 0.02, p03: 0.00,
        p10: 0.00, p11: 0.85, p12: 0.12, p13: 0.03,
        p20: 0.00, p21: 0.00, p22: 0.70, p23: 0.30,
        p30: 0.00, p31: 0.00, p32: 0.00, p33: 1.00
    };
}

pub fn markov_step(state: &StateDistribution4, model: &MarkovHealthModel) -> StateDistribution4 {
    let s0: Float = (state).p0_healthy;
    let s1: Float = (state).p1_minor_wear;
    let s2: Float = (state).p2_severe_alert;
    let s3: Float = (state).p3_failed;

    let next0: Float = (s0 * (model).p00) + (s1 * (model).p10) + (s2 * (model).p20) + (s3 * (model).p30);
    let next1: Float = (s0 * (model).p01) + (s1 * (model).p11) + (s2 * (model).p21) + (s3 * (model).p31);
    let next2: Float = (s0 * (model).p02) + (s1 * (model).p12) + (s2 * (model).p22) + (s3 * (model).p32);
    let next3: Float = (s0 * (model).p03) + (s1 * (model).p13) + (s2 * (model).p23) + (s3 * (model).p33);

    return StateDistribution4 {
        p0_healthy: next0,
        p1_minor_wear: next1,
        p2_severe_alert: next2,
        p3_failed: next3
    };
}

pub fn markov_predict_horizon(
    initial_state: &StateDistribution4,
    model: &MarkovHealthModel,
    steps: Int,
) -> StateDistribution4 {
    let mut cur: StateDistribution4 = *initial_state;
    let mut i: Int = 0;
    while i < steps {
        cur = markov_step(&cur, model);
        i = i + 1;
    }
    return cur;
}
