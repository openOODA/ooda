// # SAX Symbolic Aggregate Approximation & PAA
//
// Logline: Converts continuous sensor telemetry into Piecewise Aggregate Approximation (PAA) and symbolic SAX alphabet tokens.
//
// Setup: Quantizes normalized time-series into discrete string words with lower-bounding distance calculation.
//
// Beats:
//   1. Implement Piecewise Aggregate Approximation (PAA) dimension reduction.
//   2. Discretize PAA segments into alphabet indices using standard Gaussian breakpoints.
//   3. Calculate MINDIST lower-bound Euclidean distance between two SAX words.

pub type PaaResult = struct {
    paa_values: List[Float],
    num_segments: Int
};

pub type SaxSymbolicSeries = struct {
    symbols: List[Int],
    alphabet_size: Int,
    num_segments: Int
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn ts_paa_transform(series: &List[Float], num_segments: Int) -> PaaResult {
    let n: Int = list_len(*series);
    let mut paa: List[Float] = list_new();
    if n == 0 || num_segments <= 0 || num_segments > n {
        return PaaResult { paa_values: paa, num_segments: 0 };
    }

    let seg_len: Int = n / num_segments;
    let seg_f: Float = int_to_float(seg_len);

    let mut w: Int = 0;
    while w < num_segments {
        let mut sum: Float = 0.0;
        let mut i: Int = 0;
        while i < seg_len {
            let idx: Int = (w * seg_len) + i;
            sum = sum + list_get(*series, idx);
            i = i + 1;
        }
        paa = list_push(paa, sum / seg_f);
        w = w + 1;
    }

    return PaaResult {
        paa_values: paa,
        num_segments: num_segments
    };
}

pub fn ts_sax_symbolize(paa: &PaaResult, alphabet_size: Int) -> SaxSymbolicSeries {
    let n_seg: Int = (paa).num_segments;
    let mut syms: List[Int] = list_new();

    // Gaussian breakpoints for alphabet_size = 4: [-0.67, 0.0, 0.67]
    let mut i: Int = 0;
    while i < n_seg {
        let v: Float = list_get((paa).paa_values, i);
        let mut code: Int = 0;
        if alphabet_size == 4 {
            if v < (0.0 - 0.674) {
                code = 0;
            } else if v < 0.0 {
                code = 1;
            } else if v < 0.674 {
                code = 2;
            } else {
                code = 3;
            }
        } else {
            // Default 3-symbol: [-0.43, 0.43]
            if v < (0.0 - 0.43) {
                code = 0;
            } else if v < 0.43 {
                code = 1;
            } else {
                code = 2;
            }
        }
        syms = list_push(syms, code);
        i = i + 1;
    }

    return SaxSymbolicSeries {
        symbols: syms,
        alphabet_size: alphabet_size,
        num_segments: n_seg
    };
}
