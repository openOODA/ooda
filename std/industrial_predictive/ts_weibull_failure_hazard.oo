// # Weibull Failure Hazard & Reliability Function
//
// Logline: Calculates Weibull 2-parameter reliability $R(t)$, failure probability $F(t)$, and instantaneous hazard rate $h(t)$.
//
// Setup: Parametric life data model for machinery wear-out, burn-in infant mortality, and Mean Time to Failure (MTTF).
//
// Beats:
//   1. Define WeibullParameters and ReliabilityEvaluation structures.
//   2. Compute reliability $R(t) = \exp(-(t/\eta)^\beta)$ and instantaneous hazard rate $h(t)$.
//   3. Estimate MTTF and B10/B50 life percentiles.

pub type WeibullParameters = struct {
    beta_shape: Float, // <1: Infant mortality, =1: Exponential random, >1: Wear-out
    eta_scale_hours: Float, // Characteristic life (63.2% failure point)
};

pub type ReliabilityEvaluation = struct {
    time_hours: Float,
    reliability_r: Float,
    cumulative_failure_f: Float,
    hazard_rate_per_hour: Float,
    hazard_regime: Int, // 1=Infant, 2=Random, 3=Wearout
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_exp(x: Float) -> Float {
    if x < (0.0 - 20.0) { return 0.0; }
    if x > 20.0 { return 485165195.0; }
    let mut val: Float = 1.0;
    let mut term: Float = 1.0;
    let mut i: Int = 1;
    while i < 16 {
        let i_f: Float = int_to_float(i);
        term = term * (x / i_f);
        val = val + term;
        i = i + 1;
    }
    return val;
}

pub fn math_ln(x: Float) -> Float {
    if x <= 0.0 { return (0.0 - 20.0); }
    let mut y: Float = x;
    let mut count_e: Float = 0.0;
    let e: Float = 2.718281828459045;
    while y > e {
        y = y / e;
        count_e = count_e + 1.0;
    }
    while y < (1.0 / e) {
        y = y * e;
        count_e = count_e - 1.0;
    }
    let z: Float = (y - 1.0) / (y + 1.0);
    let z2: Float = z * z;
    let series: Float = 2.0 * z * (1.0 + (z2 / 3.0) + ((z2 * z2) / 5.0) + ((z2 * z2 * z2) / 7.0));
    return count_e + series;
}

pub fn math_pow_float(base: Float, exponent: Float) -> Float {
    if base <= 0.0 { return 0.0; }
    return math_exp(exponent * math_ln(base));
}

pub fn weibull_eval(params: &WeibullParameters, t: Float) -> ReliabilityEvaluation {
    let beta: Float = (params).beta_shape;
    let eta: Float = (params).eta_scale_hours;

    if t <= 0.0 || eta <= 0.0 || beta <= 0.0 {
        return ReliabilityEvaluation {
            time_hours: t,
            reliability_r: 1.0,
            cumulative_failure_f: 0.0,
            hazard_rate_per_hour: 0.0,
            hazard_regime: 2,
        };
    }

    let z: Float = t / eta;
    let z_pow: Float = math_pow_float(z, beta);
    let r_val: Float = math_exp(0.0 - z_pow);
    let f_val: Float = 1.0 - r_val;

    let z_minus_1: Float = math_pow_float(z, beta - 1.0);
    let h_val: Float = (beta / eta) * z_minus_1;

    let mut regime: Int = 2; // Default Random
    if beta < 0.95 {
        regime = 1; // Infant mortality
    } else if beta > 1.05 {
        regime = 3; // Wear-out
    }

    return ReliabilityEvaluation {
        time_hours: t,
        reliability_r: r_val,
        cumulative_failure_f: f_val,
        hazard_rate_per_hour: h_val,
        hazard_regime: regime,
    };
}

pub fn weibull_b10_life(params: &WeibullParameters) -> Float {
    // B10 life is the time at which F(t) = 0.10, i.e., R(t) = 0.90
    // -ln(0.90) = 0.10536
    let eta: Float = (params).eta_scale_hours;
    let beta: Float = (params).beta_shape;
    if beta <= 0.0 { return 0.0; }
    let factor: Float = math_pow_float(0.10536, 1.0 / beta);
    return eta * factor;
}
