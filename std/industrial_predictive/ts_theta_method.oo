// # Theta Forecasting Method
//
// Logline: Implements the Assimakopoulos-Nikolopoulos Theta decomposition method combining linear regression with SES curvature.
//
// Setup: Decomposes series into $\theta_1=0$ (pure trend) and $\theta_2=2$ (doubled curvature) for robust forecasting.
//
// Beats:
//   1. Fit ordinary linear regression slope and intercept to represent the $\theta=0$ line.
//   2. Apply Simple Exponential Smoothing (SES) to the $\theta=2$ curvature series.
//   3. Blend trend and curvature forecasts with equal weight $\frac{1}{2}(\hat{Z}_0 + \hat{Z}_2)$.

pub type ThetaModel = struct {
    slope: Float,
    intercept: Float,
    ses_level: Float,
    alpha: Float,
    n_samples: Int
};

pub type ThetaForecast = struct {
    forecasts: List[Float],
    horizon: Int
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn theta_fit(series: &List[Float], alpha: Float) -> ThetaModel {
    let n: Int = list_len(*series);
    if n <= 1 {
        let v0: Float = if n == 1 { list_get(*series, 0) } else { 0.0 };
        return ThetaModel {
            slope: 0.0,
            intercept: v0,
            ses_level: v0,
            alpha: alpha,
            n_samples: n
        };
    }

    let n_f: Float = int_to_float(n);
    let mut sum_t: Float = 0.0;
    let mut sum_y: Float = 0.0;
    let mut sum_ty: Float = 0.0;
    let mut sum_tt: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let t_f: Float = int_to_float(i);
        let y_val: Float = list_get(*series, i);
        sum_t = sum_t + t_f;
        sum_y = sum_y + y_val;
        sum_ty = sum_ty + (t_f * y_val);
        sum_tt = sum_tt + (t_f * t_f);
        i = i + 1;
    }

    let denom: Float = (n_f * sum_tt) - (sum_t * sum_t);
    let slope: Float = if denom != 0.0 { ((n_f * sum_ty) - (sum_t * sum_y)) / denom } else { 0.0 };
    let intercept: Float = (sum_y - (slope * sum_t)) / n_f;

    // Build theta=2 line: Z2(t) = 2*Y(t) - (intercept + slope*t)
    let mut z2_level: Float = (2.0 * list_get(*series, 0)) - intercept;
    i = 1;
    while i < n {
        let t_f: Float = int_to_float(i);
        let z2_t: Float = (2.0 * list_get(*series, i)) - (intercept + (slope * t_f));
        z2_level = (alpha * z2_t) + ((1.0 - alpha) * z2_level);
        i = i + 1;
    }

    return ThetaModel {
        slope: slope,
        intercept: intercept,
        ses_level: z2_level,
        alpha: alpha,
        n_samples: n
    };
}

pub fn theta_forecast(model: &ThetaModel, horizon: Int) -> ThetaForecast {
    let mut fc: List[Float] = list_new();
    let n_base: Float = int_to_float((model).n_samples);
    let mut h: Int = 1;

    while h <= horizon {
        let h_f: Float = int_to_float(h);
        let t_future: Float = n_base + h_f - 1.0;
        let trend_part: Float = (model).intercept + ((model).slope * t_future);
        let ses_part: Float = (model).ses_level;
        let combined: Float = 0.5 * (trend_part + ses_part);
        fc = list_push(fc, combined);
        h = h + 1;
    }

    return ThetaForecast {
        forecasts: fc,
        horizon: horizon
    };
}
