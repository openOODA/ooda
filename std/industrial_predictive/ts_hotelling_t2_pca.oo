// # Hotelling's T^2 & Q-Residual PCA Monitoring
//
// Logline: Evaluates multivariate Principal Component Analysis (PCA) health indices: Hotelling's $T^2$ and Squared Prediction Error (SPE/Q).
//
// Setup: Projects multi-sensor telemetry onto principal loading vectors and measures systematic subspace distance vs residual noise.
//
// Beats:
//   1. Define PcaMonitoringModel and PcaMonitoringScores structures.
//   2. Compute Hotelling's $T^2$ score in principal subspace: $T^2 = \sum (t_k^2 / \lambda_k)$.
//   3. Compute Squared Prediction Error (Q-residual) in orthogonal residual subspace: $Q = \sum e_i^2$.

pub type PcaMonitoringModel = struct {
    mean1: Float, mean2: Float, mean3: Float,
    loading1: Float, loading2: Float, loading3: Float,
    eigenvalue1: Float,
    t2_threshold: Float,
    q_threshold: Float
};

pub type PcaMonitoringScores = struct {
    hotelling_t2: Float,
    q_residual_spe: Float,
    t2_alarm: Bool,
    q_alarm: Bool,
    overall_health_alarm: Bool
};

pub fn pca_monitoring_default() -> PcaMonitoringModel {
    return PcaMonitoringModel {
        mean1: 50.0, mean2: 10.0, mean3: 100.0,
        loading1: 0.577, loading2: 0.577, loading3: 0.577,
        eigenvalue1: 2.5,
        t2_threshold: 6.63,
        q_threshold: 1.50
    };
}

pub fn pca_monitoring_eval(
    model: &PcaMonitoringModel,
    x1: Float,
    x2: Float,
    x3: Float,
) -> PcaMonitoringScores {
    let dx1: Float = x1 - (model).mean1;
    let dx2: Float = x2 - (model).mean2;
    let dx3: Float = x3 - (model).mean3;

    // Principal component score t = x^T * p
    let t_score: Float = (dx1 * (model).loading1) + (dx2 * (model).loading2) + (dx3 * (model).loading3);

    // Hotelling's T^2 = t^2 / lambda
    let lam: Float = (model).eigenvalue1;
    let t2: Float = if lam > 0.0001 { (t_score * t_score) / lam } else { 0.0 };

    // Reconstructed signal x_hat = t * p
    let x1_hat: Float = t_score * (model).loading1;
    let x2_hat: Float = t_score * (model).loading2;
    let x3_hat: Float = t_score * (model).loading3;

    // Residual e = x - x_hat
    let e1: Float = dx1 - x1_hat;
    let e2: Float = dx2 - x2_hat;
    let e3: Float = dx3 - x3_hat;

    // Q-residual (SPE) = e^T * e
    let q: Float = (e1 * e1) + (e2 * e2) + (e3 * e3);

    let t2_a: Bool = if t2 >= (model).t2_threshold { true } else { false };
    let q_a: Bool = if q >= (model).q_threshold { true } else { false };
    let overall_a: Bool = if t2_a || q_a { true } else { false };

    return PcaMonitoringScores {
        hotelling_t2: t2,
        q_residual_spe: q,
        t2_alarm: t2_a,
        q_alarm: q_a,
        overall_health_alarm: overall_a
    };
}
