// # Discrete Fréchet Distance
//
// Logline: Measures geometric similarity and leash distance between polygonal time-series curves and machine trajectories.
//
// Setup: Dynamic programming coupling table with inductive step $\max(d(P_i, Q_j), \min(\text{diag}, \text{left}, \text{down}))$.
//
// Beats:
//   1. Define FrechetResult structure storing discrete Fréchet distance and index couplings.
//   2. Build 2D recurrence table across curve P and curve Q sample points.
//   3. Compute bounding leash length and trajectory similarity score.

pub type FrechetResult = struct {
    frechet_distance: Float,
    p_len: Int,
    q_len: Int,
    similarity_score: Float,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn math_max2(a: Float, b: Float) -> Float {
    if a > b { return a; }
    return b;
}

pub fn math_min3(a: Float, b: Float, c: Float) -> Float {
    let mut m: Float = a;
    if b < m { m = b; }
    if c < m { m = c; }
    return m;
}

pub fn frechet_discrete_distance(p: &List[Float], q: &List[Float]) -> FrechetResult {
    let n: Int = list_len(*p);
    let m: Int = list_len(*q);

    if n == 0 || m == 0 {
        return FrechetResult {
            frechet_distance: 0.0,
            p_len: n,
            q_len: m,
            similarity_score: 0.0,
        };
    }

    let infinity: Float = 10000000.0;
    let total: Int = n * m;
    let mut ca: List[Float] = list_new();
    let mut idx: Int = 0;
    while idx < total {
        ca = list_push(ca, 0.0 - 1.0);
        idx = idx + 1;
    }

    let mut i: Int = 0;
    while i < n {
        let pi: Float = list_get(*p, i);
        let mut j: Int = 0;
        while j < m {
            let qj: Float = list_get(*q, j);
            let dist: Float = math_abs(pi - qj);

            let mut cell_val: Float = 0.0;
            if i == 0 && j == 0 {
                cell_val = dist;
            } else if i > 0 && j == 0 {
                let prev: Float = list_get(ca, (i - 1) * m);
                cell_val = math_max2(prev, dist);
            } else if i == 0 && j > 0 {
                let prev: Float = list_get(ca, j - 1);
                cell_val = math_max2(prev, dist);
            } else {
                let c_diag: Float = list_get(ca, ((i - 1) * m) + (j - 1));
                let c_up: Float = list_get(ca, ((i - 1) * m) + j);
                let c_left: Float = list_get(ca, (i * m) + (j - 1));
                let min_prev: Float = math_min3(c_diag, c_up, c_left);
                cell_val = math_max2(min_prev, dist);
            }

            let cur_idx: Int = (i * m) + j;
            let mut next_ca: List[Float] = list_new();
            let mut k: Int = 0;
            while k < total {
                if k == cur_idx {
                    next_ca = list_push(next_ca, cell_val);
                } else {
                    next_ca = list_push(next_ca, list_get(ca, k));
                }
                k = k + 1;
            }
            ca = next_ca;
            j = j + 1;
        }
        i = i + 1;
    }

    let f_dist: Float = list_get(ca, (n * m) - 1);
    let sim: Float = 1.0 / (1.0 + f_dist);

    return FrechetResult {
        frechet_distance: f_dist,
        p_len: n,
        q_len: m,
        similarity_score: sim,
    };
}
