// # Cox Proportional Hazards Model & Covariate Risk
//
// Logline: Multiplies baseline failure hazards by operating stress covariates (temperature, load, vibration) via log-linear exponentiation.
//
// Setup: Predicts instantaneous equipment failure risk adjustments based on dynamic environmental and operational telemetry.
//
// Beats:
//   1. Define CoxCovariates and CoxHazardAssessment structures.
//   2. Compute linear score metric $z = \sum \beta_i (x_i - \bar{x}_i)$.
//   3. Calculate relative hazard multiplier $\psi = \exp(z)$ and adjusted failure rate.

pub type CoxCovariates = struct {
    temperature_c: Float,
    vibration_rms_mm_s: Float,
    load_factor_pct: Float,
    oil_particulate_ppm: Float,
};

pub type CoxHazardAssessment = struct {
    relative_risk_multiplier: Float,
    baseline_hazard: Float,
    adjusted_hazard: Float,
    is_high_risk: Bool,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_exp(x: Float) -> Float {
    if x < (0.0 - 20.0) { return 0.0; }
    if x > 20.0 { return 485165195.0; }
    let mut val: Float = 1.0;
    let mut term: Float = 1.0;
    let mut i: Int = 1;
    while i < 16 {
        let i_f: Float = int_to_float(i);
        term = term * (x / i_f);
        val = val + term;
        i = i + 1;
    }
    return val;
}

pub fn cox_eval_hazard(
    cov: &CoxCovariates,
    baseline_h: Float,
) -> CoxHazardAssessment {
    // Reference nominal operating baseline:
    // T_nom = 40.0 C, Vib_nom = 2.0 mm/s, Load_nom = 80.0%, Oil_nom = 15.0 ppm
    let dt: Float = ((cov).temperature_c - 40.0) / 10.0;
    let dv: Float = ((cov).vibration_rms_mm_s - 2.0) / 1.0;
    let dl: Float = ((cov).load_factor_pct - 80.0) / 20.0;
    let doil: Float = ((cov).oil_particulate_ppm - 15.0) / 10.0;

    // Weights beta: beta_T = 0.4, beta_V = 0.6, beta_L = 0.3, beta_Oil = 0.5
    let score: Float = (0.4 * dt) + (0.6 * dv) + (0.3 * dl) + (0.5 * doil);
    let psi: Float = math_exp(score);
    let adj_h: Float = baseline_h * psi;

    return CoxHazardAssessment {
        relative_risk_multiplier: psi,
        baseline_hazard: baseline_h,
        adjusted_hazard: adj_h,
        is_high_risk: (psi > 2.5),
    };
}
