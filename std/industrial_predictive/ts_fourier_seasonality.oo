// # Trigonometric Fourier Seasonality & Multi-Harmonic Profile
//
// Logline: Extracts multi-order harmonic Fourier coefficients for cyclic industrial load and thermal baseline forecasting.
//
// Setup: Fits sin/cos orthogonal basis pairs for multi-period operating cycles (e.g. shift, daily, weekly).
//
// Beats:
//   1. Implement Taylor series approximation for trigonometric sine and cosine.
//   2. Fit K-harmonic Fourier coefficients ($a_0, a_k, b_k$) via numerical quadrature.
//   3. Synthesize forward periodic waveforms and compute spectral power concentration.

pub type FourierHarmonic = struct {
    harmonic_order: Int,
    a_k: Float,
    b_k: Float,
    amplitude: Float,
    phase: Float,
};

pub type FourierSeasonalProfile = struct {
    period: Float,
    a0: Float,
    harmonics: List[FourierHarmonic],
    num_harmonics: Int,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_cos(x: Float) -> Float {
    let pi: Float = 3.141592653589793;
    let mut val: Float = x;
    while val > pi { val = val - (2.0 * pi); }
    while val < (0.0 - pi) { val = val + (2.0 * pi); }
    let x2: Float = val * val;
    let x4: Float = x2 * x2;
    let x6: Float = x4 * x2;
    return 1.0 - (x2 / 2.0) + (x4 / 24.0) - (x6 / 720.0);
}

pub fn math_sin(x: Float) -> Float {
    let pi: Float = 3.141592653589793;
    return math_cos(x - (pi / 2.0));
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn fourier_fit_profile(series: &List[Float], period: Float, num_harmonics: Int) -> FourierSeasonalProfile {
    let n: Int = list_len(*series);
    let mut harms: List[FourierHarmonic] = list_new();
    if n == 0 || period <= 0.0 || num_harmonics <= 0 {
        return FourierSeasonalProfile {
            period: period,
            a0: 0.0,
            harmonics: harms,
            num_harmonics: 0,
        };
    }

    let n_f: Float = int_to_float(n);
    let mut sum_y: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        sum_y = sum_y + list_get(*series, i);
        i = i + 1;
    }
    let a0: Float = sum_y / n_f;

    let pi: Float = 3.141592653589793;
    let mut k: Int = 1;
    while k <= num_harmonics {
        let k_f: Float = int_to_float(k);
        let mut sum_cos: Float = 0.0;
        let mut sum_sin: Float = 0.0;
        i = 0;
        while i < n {
            let t_f: Float = int_to_float(i);
            let theta: Float = (2.0 * pi * k_f * t_f) / period;
            let yt: Float = list_get(*series, i);
            sum_cos = sum_cos + (yt * math_cos(theta));
            sum_sin = sum_sin + (yt * math_sin(theta));
            i = i + 1;
        }
        let ak: Float = (2.0 / n_f) * sum_cos;
        let bk: Float = (2.0 / n_f) * sum_sin;
        let amp: Float = math_sqrt((ak * ak) + (bk * bk));

        let h_obj = FourierHarmonic {
            harmonic_order: k,
            a_k: ak,
            b_k: bk,
            amplitude: amp,
            phase: 0.0,
        };
        harms = list_push(harms, h_obj);
        k = k + 1;
    }

    return FourierSeasonalProfile {
        period: period,
        a0: a0,
        harmonics: harms,
        num_harmonics: num_harmonics,
    };
}

pub fn fourier_eval_point(profile: &FourierSeasonalProfile, t: Float) -> Float {
    let mut val: Float = (profile).a0;
    let pi: Float = 3.141592653589793;
    let n_h: Int = list_len((profile).harmonics);
    let mut k: Int = 0;
    while k < n_h {
        let h_item: FourierHarmonic = list_get((profile).harmonics, k);
        let k_f: Float = int_to_float(h_item.harmonic_order);
        let theta: Float = (2.0 * pi * k_f * t) / (profile).period;
        val = val + (h_item.a_k * math_cos(theta)) + (h_item.b_k * math_sin(theta));
        k = k + 1;
    }
    return val;
}
