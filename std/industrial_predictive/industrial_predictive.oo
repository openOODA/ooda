pub fn predictive_shim_hw_fit(series: &List[Float], alpha: Float, beta: Float, gamma: Float, s_len: Int) -> HoltWintersModel {
    return hw_fit_additive(series, alpha, beta, gamma, s_len);
}

pub fn predictive_shim_vibration_moments(signal: &List[Float]) -> VibrationMoments {
    return vibration_calc_moments(signal);
}

pub fn predictive_shim_weibull_eval(beta: Float, eta: Float, t: Float) -> ReliabilityEvaluation {
    let p = WeibullParameters { beta_shape: beta, eta_scale_hours: eta };
    return weibull_eval(&p, t);
}

pub fn predictive_shim_rul_linear(times: &List[Float], hi: &List[Float], thresh: Float) -> LinearRulResult {
    return rul_linear_predict(times, hi, thresh);
}

pub fn predictive_shim_kalman_debias(init_val: Float) -> KalmanDebiasState {
    return kalman_debias_new(init_val, 0.01, 0.001, 0.1);
}

pub fn predictive_shim_zscore(series: &List[Float], window: Int, thresh: Float) -> ZScoreAnomalyResult {
    return rolling_zscore_detect(series, window, thresh);
}

pub fn predictive_shim_oee(t_plan: Float, t_down: Float, t_ideal: Float, total: Float, good: Float) -> OeeResult {
    let inps = OeeInputs {
        planned_production_time_min: t_plan,
        unplanned_downtime_min: t_down,
        ideal_cycle_time_sec: t_ideal,
        total_parts_produced: total,
        good_parts_produced: good
    };
    return oee_calculate(&inps);
}
