// # Condition-Based Maintenance (CBM) Multi-Rule Engine
//
// Logline: Evaluates composite multi-criteria condition thresholds and degradation slopes to trigger targeted maintenance work orders.
//
// Setup: Synthesizes absolute limits, rate-of-rise tolerances, and cumulative high-stress exposure to recommend prescriptive actions.
//
// Beats:
//   1. Define CbmRuleThresholds and MaintenanceRecommendation structures.
//   2. Check Level-1 Caution and Level-2 Critical absolute limit excursions.
//   3. Classify maintenance urgency (0=Normal, 1=Plan Inspection, 2=Relubricate, 3=Overhaul, 4=Emergency Trip).

pub type CbmRuleThresholds = struct {
    caution_limit: Float,
    critical_limit: Float,
    max_allowable_rate_of_rise: Float,
    high_stress_hour_limit: Float,
};

pub type MaintenanceRecommendation = struct {
    urgency_level: Int, // 0=Nominal, 1=PlanRoutine, 2=UrgentInspection, 3=ImmediateStop
    action_code: Int, // 1=InspectVibration, 2=ReplaceBearing, 3=CleanFilter, 4=CheckAlignment
    recommended_lead_time_days: Int,
    trigger_reason_code: Int, // 1=AbsoluteTrip, 2=FastTrend, 3=StressHours
};

pub fn cbm_default_thresholds() -> CbmRuleThresholds {
    return CbmRuleThresholds {
        caution_limit: 4.5, // e.g. 4.5 mm/s RMS
        critical_limit: 7.1, // e.g. 7.1 mm/s RMS
        max_allowable_rate_of_rise: 0.5, // mm/s per day
        high_stress_hour_limit: 100.0,
    };
}

pub fn cbm_evaluate(
    thresholds: &CbmRuleThresholds,
    current_value: Float,
    rate_of_rise: Float,
    stress_hours: Float,
) -> MaintenanceRecommendation {
    if current_value >= (thresholds).critical_limit {
        return MaintenanceRecommendation {
            urgency_level: 3, // Immediate Stop
            action_code: 2, // Replace Bearing / Component
            recommended_lead_time_days: 0,
            trigger_reason_code: 1, // Absolute Trip
        };
    }

    if rate_of_rise >= (thresholds).max_allowable_rate_of_rise && current_value >= (thresholds).caution_limit {
        return MaintenanceRecommendation {
            urgency_level: 2, // Urgent Inspection
            action_code: 4, // Check Alignment & Unbalance
            recommended_lead_time_days: 2,
            trigger_reason_code: 2, // Fast Trend
        };
    }

    if current_value >= (thresholds).caution_limit || stress_hours >= (thresholds).high_stress_hour_limit {
        return MaintenanceRecommendation {
            urgency_level: 1, // Plan Routine
            action_code: 1, // Inspect & Lubricate
            recommended_lead_time_days: 7,
            trigger_reason_code: 3, // Stress Hours
        };
    }

    return MaintenanceRecommendation {
        urgency_level: 0,
        action_code: 0,
        recommended_lead_time_days: 30,
        trigger_reason_code: 0,
    };
}
