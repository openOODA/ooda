// # Vibration Statistical Moments & Kurtosis
//
// Logline: Calculates time-domain statistical indicators including Kurtosis, Crest Factor, Skewness, and Shape Factor.
//
// Setup: Evaluates standard vibration feature extraction metrics for early detection of impulsive bearing spalls.
//
// Beats:
//   1. Define VibrationMoments data structure with statistical metrics and spall severity flag.
//   2. Compute 1st through 4th central moments (Mean, Variance, Skewness, Kurtosis).
//   3. Compute dimensionless condition indicators (Crest Factor, Shape Factor, Impulse Factor).

pub type VibrationMoments = struct {
    mean: Float,
    rms: Float,
    peak: Float,
    peak_to_peak: Float,
    crest_factor: Float,
    kurtosis: Float,
    skewness: Float,
    shape_factor: Float,
    impulse_factor: Float,
    is_impulsive_fault: Bool
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn vibration_calc_moments(signal: &List[Float]) -> VibrationMoments {
    let n: Int = list_len(*signal);
    if n == 0 {
        return VibrationMoments {
            mean: 0.0,
            rms: 0.0,
            peak: 0.0,
            peak_to_peak: 0.0,
            crest_factor: 0.0,
            kurtosis: 0.0,
            skewness: 0.0,
            shape_factor: 0.0,
            impulse_factor: 0.0,
            is_impulsive_fault: false
        };
    }

    let n_f: Float = int_to_float(n);
    let mut sum: Float = 0.0;
    let mut sum_sq: Float = 0.0;
    let mut sum_abs: Float = 0.0;
    let mut min_val: Float = list_get(*signal, 0);
    let mut max_val: Float = list_get(*signal, 0);

    let mut i: Int = 0;
    while i < n {
        let x: Float = list_get(*signal, i);
        sum = sum + x;
        sum_sq = sum_sq + (x * x);
        sum_abs = sum_abs + math_abs(x);
        if x < min_val { min_val = x; }
        if x > max_val { max_val = x; }
        i = i + 1;
    }

    let mean: Float = sum / n_f;
    let rms: Float = math_sqrt(sum_sq / n_f);
    let peak: Float = math_abs(if math_abs(max_val) > math_abs(min_val) { max_val } else { min_val });
    let p2p: Float = max_val - min_val;
    let mean_abs: Float = sum_abs / n_f;

    let mut sum_diff2: Float = 0.0;
    let mut sum_diff3: Float = 0.0;
    let mut sum_diff4: Float = 0.0;

    i = 0;
    while i < n {
        let d: Float = list_get(*signal, i) - mean;
        let d2: Float = d * d;
        sum_diff2 = sum_diff2 + d2;
        sum_diff3 = sum_diff3 + (d2 * d);
        sum_diff4 = sum_diff4 + (d2 * d2);
        i = i + 1;
    }

    let variance: Float = sum_diff2 / n_f;
    let sigma: Float = math_sqrt(variance);
    let sigma3: Float = sigma * sigma * sigma;
    let sigma4: Float = variance * variance;

    let skew: Float = if sigma3 > 0.000001 { (sum_diff3 / n_f) / sigma3 } else { 0.0 };
    let kurt: Float = if sigma4 > 0.000001 { (sum_diff4 / n_f) / sigma4 } else { 3.0 };

    let cf: Float = if rms > 0.000001 { peak / rms } else { 0.0 };
    let sf: Float = if mean_abs > 0.000001 { rms / mean_abs } else { 0.0 };
    let if_factor: Float = if mean_abs > 0.000001 { peak / mean_abs } else { 0.0 };

    let is_fault: Bool = (kurt > 4.5) || (cf > 4.0);

    return VibrationMoments {
        mean: mean,
        rms: rms,
        peak: peak,
        peak_to_peak: p2p,
        crest_factor: cf,
        kurtosis: kurt,
        skewness: skew,
        shape_factor: sf,
        impulse_factor: if_factor,
        is_impulsive_fault: is_fault
    };
}
