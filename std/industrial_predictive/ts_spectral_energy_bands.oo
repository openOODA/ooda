// # Spectral Energy Bands & ISO 10816 Machine Severity
//
// Logline: Partitions vibration frequency spectra into diagnostic energy bands and evaluates ISO 10816 machine condition zones.
//
// Setup: Computes band-limited RMS velocity and classifies machinery health into Zones A, B, C, and D.
//
// Beats:
//   1. Define SpectralBandEnergy and Iso10816Assessment structures.
//   2. Calculate band-limited spectral energy and equivalent RMS vibration velocity.
//   3. Classify machine severity (Zone A: Good, B: Acceptable, C: Unsatisfactory, D: Unacceptable).

pub type SpectralBandEnergy = struct {
    band_name_code: Int, // 1=SubSync, 2=Sync1X, 3=Harmonics2to10X, 4=HighFreqBearing
    low_freq_hz: Float,
    high_freq_hz: Float,
    rms_energy: Float,
    fraction_of_total: Float
};

pub type Iso10816Assessment = struct {
    overall_rms_velocity_mm_s: Float,
    iso_zone: Int, // 1=ZoneA(Good), 2=ZoneB(Acceptable), 3=ZoneC(Alert), 4=ZoneD(Danger)
    machine_class: Int, // 1=Small(<15kW), 2=Medium(15-75kW), 3=LargeRigid(>75kW), 4=LargeSoft
    trip_alarm: Bool
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn math_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = if x > 1.0 { x / 2.0 } else { x };
    let mut i: Int = 0;
    while i < 12 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn calc_band_energy(
    freqs: &List[Float],
    mags: &List[Float],
    f_low: Float,
    f_high: Float,
    code: Int,
) -> SpectralBandEnergy {
    let n: Int = list_len(*freqs);
    let mut sum_sq: Float = 0.0;
    let mut i: Int = 0;

    while i < n {
        let f: Float = list_get(*freqs, i);
        if f >= f_low && f <= f_high {
            let a: Float = list_get(*mags, i);
            sum_sq = sum_sq + (a * a);
        }
        i = i + 1;
    }

    let rms: Float = math_sqrt(sum_sq);
    return SpectralBandEnergy {
        band_name_code: code,
        low_freq_hz: f_low,
        high_freq_hz: f_high,
        rms_energy: rms,
        fraction_of_total: 0.0
    };
}

pub fn iso_10816_evaluate(overall_rms_mm_s: Float, machine_class: Int) -> Iso10816Assessment {
    let mut zone: Int = 1; // Default Zone A

    // Class 3 limits (Large machines with rigid foundation):
    // Zone A: < 2.3 mm/s, Zone B: 2.3 - 4.5 mm/s, Zone C: 4.5 - 7.1 mm/s, Zone D: > 7.1 mm/s
    if machine_class == 3 {
        if overall_rms_mm_s < 2.3 {
            zone = 1;
        } else if overall_rms_mm_s < 4.5 {
            zone = 2;
        } else if overall_rms_mm_s < 7.1 {
            zone = 3;
        } else {
            zone = 4;
        }
    } else {
        // Standard industrial threshold (Class 2: Medium machines 15-75kW)
        // Zone A: < 1.4, Zone B: 1.4 - 2.8, Zone C: 2.8 - 4.5, Zone D: > 4.5
        if overall_rms_mm_s < 1.4 {
            zone = 1;
        } else if overall_rms_mm_s < 2.8 {
            zone = 2;
        } else if overall_rms_mm_s < 4.5 {
            zone = 3;
        } else {
            zone = 4;
        }
    }

    let is_trip: Bool = (zone == 4);

    return Iso10816Assessment {
        overall_rms_velocity_mm_s: overall_rms_mm_s,
        iso_zone: zone,
        machine_class: machine_class,
        trip_alarm: is_trip
    };
}
