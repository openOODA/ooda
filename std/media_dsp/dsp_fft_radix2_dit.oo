// # Cooley-Tukey Radix-2 DIT Fast Fourier Transform (FFT)
//
// Logline: Computes forward and inverse Discrete Fourier Transforms using Radix-2 Decimation-In-Time butterflies and bit-reversal.
//
// Setup: Fundamental O(N log N) spectral decomposition algorithm for audio analysis, convolution, and spectrogram generation.
//
// Beats:
//   1. Implement integer bit-reversal index permutation for power-of-two sizes.
//   2. Compute complex twiddle factor angles: `cos(2*pi*k/N) - j*sin(2*pi*k/N)`.
//   3. Execute Cooley-Tukey in-place butterfly execution stages.

pub type ComplexSignal = struct {
    real: List[Float],
    imag: List[Float],
    size: Int
};

// -------------------------------------------------------------------
// Bit-Reversal Indexing
// -------------------------------------------------------------------

pub fn dsp_bit_reverse(idx: Int, bits: Int) -> Int {
    let mut rev: Int = 0;
    let mut i: Int = 0;
    let mut temp: Int = idx;

    while i < bits {
        rev = (rev << 1) | (temp & 1);
        temp = temp >> 1;
        i = i + 1;
    }
    return rev;
}

// -------------------------------------------------------------------
// Complex Signal Constructors & Metrics
// -------------------------------------------------------------------

pub fn dsp_complex_signal_new(size: Int) -> ComplexSignal {
    let mut r: List[Float] = list_new();
    let mut im: List[Float] = list_new();
    let mut i: Int = 0;
    while i < size {
        r = list_push(r, 0.0);
        im = list_push(im, 0.0);
        i = i + 1;
    }

    return ComplexSignal {
        real: r,
        imag: im,
        size: size
    };
}

pub fn dsp_magnitude_at(sig: &ComplexSignal, idx: Int) -> Float {
    if idx < 0 || idx >= (sig).size {
        return 0.0;
    }
    let r: Float = list_get((sig).real, idx);
    let im: Float = list_get((sig).imag, idx);
    return sqrt((r * r) + (im * im));
}

pub fn dsp_power_spectrum_at(sig: &ComplexSignal, idx: Int) -> Float {
    if idx < 0 || idx >= (sig).size {
        return 0.0;
    }
    let r: Float = list_get((sig).real, idx);
    let im: Float = list_get((sig).imag, idx);
    return (r * r) + (im * im);
}
