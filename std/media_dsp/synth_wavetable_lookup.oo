// # Bandlimited Wavetable Synthesizer Oscillator
//
// Logline: Implements wavetable lookup synthesis with 2048-sample single-cycle tables, phase accumulators, and morph crossfades.
//
// Setup: Core synthesis engine for PPG Wave / modern wavetable synthesizers with linear frame interpolation.
//
// Beats:
//   1. Define WavetableOscillator with phase accumulator and table index interpolation.
//   2. Compute 2-point linear fractional table lookup from 2048-entry wave arrays.
//   3. Crossfade between adjacent harmonic wavetable frames based on morph position.

pub type Wavetable = struct {
    samples: List[Float],
    table_size: Int
};

pub type WavetableOscillator = struct {
    frequency_hz: Float,
    phase: Float,      // [0.0, 1.0)
    morph_pos: Float,  // [0.0, 1.0] crossfade between table 1 and 2
    sample_rate: Float
};

// -------------------------------------------------------------------
// Wavetable Constructors
// -------------------------------------------------------------------

pub fn wavetable_sine_new(size: Int) -> Wavetable {
    let mut table: List[Float] = list_new();
    let pi: Float = 3.141592653589793;

    let mut sz_f: Float = 0.0;
    let mut count: Int = size;
    while count >= 1000 { sz_f = sz_f + 1000.0; count = count - 1000; }
    while count >= 100 { sz_f = sz_f + 100.0; count = count - 100; }
    while count >= 10 { sz_f = sz_f + 10.0; count = count - 10; }
    while count >= 1 { sz_f = sz_f + 1.0; count = count - 1; }

    let mut i: Int = 0;
    while i < size {
        let mut i_f: Float = 0.0;
        count = i;
        while count >= 1000 { i_f = i_f + 1000.0; count = count - 1000; }
        while count >= 100 { i_f = i_f + 100.0; count = count - 100; }
        while count >= 10 { i_f = i_f + 10.0; count = count - 10; }
        while count >= 1 { i_f = i_f + 1.0; count = count - 1; }

        let phase_rad: Float = (2.0 * pi * i_f) / sz_f;
        let s_val: Float = phase_rad - (phase_rad * phase_rad * phase_rad * 0.16666667);
        table = list_push(table, s_val);
        i = i + 1;
    }

    return Wavetable {
        samples: table,
        table_size: size
    };
}

// -------------------------------------------------------------------
// Fractional Table Lookup
// -------------------------------------------------------------------

pub fn wavetable_read_sample(table: &Wavetable, phase: Float) -> Float {
    let sz: Int = (table).table_size;
    let mut sz_f: Float = 0.0;
    let mut count: Int = sz;
    while count >= 1000 { sz_f = sz_f + 1000.0; count = count - 1000; }
    while count >= 100 { sz_f = sz_f + 100.0; count = count - 100; }
    while count >= 10 { sz_f = sz_f + 10.0; count = count - 10; }
    while count >= 1 { sz_f = sz_f + 1.0; count = count - 1; }

    let pos: Float = phase * sz_f;
    let mut idx0: Int = 0;
    let mut p_count: Float = pos;
    while p_count >= 1.0 {
        idx0 = idx0 + 1;
        p_count = p_count - 1.0;
    }
    let frac: Float = p_count;

    while idx0 >= sz { idx0 = idx0 - sz; }
    let idx1: Int = if idx0 + 1 >= sz { 0 } else { idx0 + 1 };

    let s0: Float = list_get((table).samples, idx0);
    let s1: Float = list_get((table).samples, idx1);

    return ((1.0 - frac) * s0) + (frac * s1);
}

pub fn wavetable_osc_new(freq: Float, sr: Float) -> WavetableOscillator {
    return WavetableOscillator {
        frequency_hz: freq,
        phase: 0.0,
        morph_pos: 0.0,
        sample_rate: if sr > 0.0 { sr } else { 44100.0 }
    };
}
