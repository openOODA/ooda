// # H.264 / AVC NAL Unit Framing & Emulation Prevention
//
// Logline: Decodes H.264 / AVC Network Abstraction Layer (NAL) unit headers, reference flags, and strips 0x03 emulation bytes.
//
// Setup: Implements ITU-T H.264 / ISO/IEC 14496-10 Advanced Video Coding (AVC) bitstream encapsulation.
//
// Beats:
//   1. Parse 8-bit NAL unit header (forbidden_zero_bit, nal_ref_idc, nal_unit_type).
//   2. Classify NAL unit types: Non-IDR Slice (1), IDR Slice (5), SEI (6), SPS (7), PPS (8), AUD (9).
//   3. Strip 0x000003 Emulation Prevention Three-Bytes to produce Raw Byte Sequence Payloads (RBSP).

pub type H264NalUnit = struct {
    forbidden_zero_bit: Int,
    nal_ref_idc: Int,        // 0..3 (importance of slice for reference)
    nal_unit_type: Int,      // 1..31
    rbsp_byte_length: Int,
};

// -------------------------------------------------------------------
// NAL Unit Type Constants
// -------------------------------------------------------------------

pub fn h264_nal_slice_non_idr() -> Int { return 1; }
pub fn h264_nal_slice_idr() -> Int { return 5; }
pub fn h264_nal_sei() -> Int { return 6; }
pub fn h264_nal_sps() -> Int { return 7; }
pub fn h264_nal_pps() -> Int { return 8; }
pub fn h264_nal_aud() -> Int { return 9; }

// -------------------------------------------------------------------
// Header Parsing & Emulation Byte Stripping
// -------------------------------------------------------------------

pub fn h264_nal_parse_header(header_byte: Int) -> H264NalUnit {
    let f_zero: Int = (header_byte >> 7) & 1;
    let ref_idc: Int = (header_byte >> 5) & 3;
    let u_type: Int = header_byte & 31;

    return H264NalUnit {
        forbidden_zero_bit: f_zero,
        nal_ref_idc: ref_idc,
        nal_unit_type: u_type,
        rbsp_byte_length: 0,
    };
}

pub fn h264_strip_emulation_prevention_bytes(nal_bytes: List[Int]) -> List[Int] {
    let total: Int = list_len(nal_bytes);
    let mut rbsp: List[Int] = list_new();

    let mut i: Int = 0;
    let mut zero_count: Int = 0;

    while i < total {
        let b: Int = list_get(nal_bytes, i);
        if zero_count >= 2 && b == 3 {
            // Emulation prevention byte (0x03) skipped after two 0x00 bytes
            zero_count = 0;
        } else {
            rbsp = list_push(rbsp, b);
            if b == 0 {
                zero_count = zero_count + 1;
            } else {
                zero_count = 0;
            }
        }
        i = i + 1;
    }

    return rbsp;
}

pub fn h264_is_keyframe(nal: &H264NalUnit) -> Bool {
    return (nal).nal_unit_type == 5; // IDR Slice
}

pub fn h264_is_parameter_set(nal: &H264NalUnit) -> Bool {
    let t: Int = (nal).nal_unit_type;
    return t == 7 || t == 8; // SPS or PPS
}
