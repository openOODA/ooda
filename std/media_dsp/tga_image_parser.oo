// # Truevision TGA Image File Header Parser
//
// Logline: Decodes Truevision TGA (TARGA) 18-byte image headers, color map descriptors, and RLE compression flags.
//
// Setup: Implements Truevision TGA file format specification for uncompressed and RLE-compressed 24/32-bit rasters.
//
// Beats:
//   1. Define TgaHeader structure matching the canonical 18-byte binary layout.
//   2. Parse image types (Uncompressed True-color 2, RLE True-color 10, Grayscale 3/11).
//   3. Extract image descriptor orientation flags (origin bottom-left vs top-left).

pub type TgaHeader = struct {
    id_length: Int,
    color_map_type: Int,
    image_type: Int,
    cm_first_entry: Int,
    cm_length: Int,
    cm_entry_size: Int,
    x_origin: Int,
    y_origin: Int,
    width: Int,
    height: Int,
    pixel_depth: Int,
    image_descriptor: Int,
};

pub type TgaMetadata = struct {
    header: TgaHeader,
    bytes_per_pixel: Int,
    is_rle_compressed: Bool,
    is_top_to_bottom: Bool,
    alpha_bits: Int,
};

// -------------------------------------------------------------------
// Image Type Classifiers
// -------------------------------------------------------------------

pub fn tga_type_no_image() -> Int { return 0; }
pub fn tga_type_uncompressed_paletted() -> Int { return 1; }
pub fn tga_type_uncompressed_truecolor() -> Int { return 2; }
pub fn tga_type_uncompressed_grayscale() -> Int { return 3; }
pub fn tga_type_rle_paletted() -> Int { return 9; }
pub fn tga_type_rle_truecolor() -> Int { return 10; }
pub fn tga_type_rle_grayscale() -> Int { return 11; }

// -------------------------------------------------------------------
// Header Constructors & Validation
// -------------------------------------------------------------------

pub fn tga_header_new(
    img_type: Int,
    w: Int,
    h: Int,
    depth: Int,
    desc: Int
) -> TgaHeader {
    return TgaHeader {
        id_length: 0,
        color_map_type: 0,
        image_type: img_type,
        cm_first_entry: 0,
        cm_length: 0,
        cm_entry_size: 0,
        x_origin: 0,
        y_origin: 0,
        width: w,
        height: h,
        pixel_depth: depth,
        image_descriptor: desc,
    };
}

pub fn tga_metadata_parse(hdr: TgaHeader) -> TgaMetadata {
    let depth: Int = (hdr).pixel_depth;
    let bpp: Int = (depth + 7) / 8;
    let img_type: Int = (hdr).image_type;
    let is_rle: Bool = img_type == 9 || img_type == 10 || img_type == 11;

    let desc: Int = (hdr).image_descriptor;
    let is_top_down: Bool = (desc & 32) != 0; // Bit 5
    let alpha_b: Int = desc & 15;             // Bits 0-3

    return TgaMetadata {
        header: hdr,
        bytes_per_pixel: bpp,
        is_rle_compressed: is_rle,
        is_top_to_bottom: is_top_down,
        alpha_bits: alpha_b,
    };
}

pub fn tga_is_valid(hdr: &TgaHeader) -> Bool {
    let w: Int = (hdr).width;
    let h: Int = (hdr).height;
    let d: Int = (hdr).pixel_depth;

    if w <= 0 || h <= 0 {
        return false;
    }
    return d == 8 || d == 15 || d == 16 || d == 24 || d == 32;
}
