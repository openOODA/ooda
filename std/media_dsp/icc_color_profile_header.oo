// # ICC Color Management Profile Header Parser
//
// Logline: Decodes ICC v2/v4 128-byte color management profile headers, device color spaces, and TRC gamma curves.
//
// Setup: Implements ISO 15076-1 International Color Consortium (ICC) specification for cross-device color consistency.
//
// Beats:
//   1. Parse 128-byte ICC profile header fields (Size, CMM, Version, Device Class, Color Space, PCS).
//   2. Validate profile class ('mntr' display, 'prtr' output, 'scnr' input) and primary spaces ('RGB ', 'CMYK').
//   3. Compute sRGB and linear gamma Tone Reproduction Curve (TRC) transfer functions.

pub type IccProfileHeader = struct {
    profile_size: Int,
    cmm_type: String,
    version_major: Int,
    version_minor: Int,
    device_class: String,      // "mntr", "scnr", "prtr", "spac"
    color_space: String,       // "RGB ", "CMYK", "GRAY"
    connection_space: String,  // "XYZ ", "Lab "
    rendering_intent: Int,     // 0=Perceptual, 1=Relative Colorimetric, 2=Saturation, 3=Absolute
};

pub type IccXyzColor = struct {
    x: Float,
    y: Float,
    z: Float,
};

// -------------------------------------------------------------------
// Header Constructors & Validation
// -------------------------------------------------------------------

pub fn icc_profile_header_new(
    size: Int,
    v_maj: Int,
    v_min: Int,
    dev_cls: String,
    c_space: String,
    pcs: String
) -> IccProfileHeader {
    return IccProfileHeader {
        profile_size: size,
        cmm_type: "default",
        version_major: v_maj,
        version_minor: v_min,
        device_class: dev_cls,
        color_space: c_space,
        connection_space: pcs,
        rendering_intent: 1, // Relative Colorimetric
    };
}

pub fn icc_d50_white_point() -> IccXyzColor {
    // D50 Standard Illuminant in CIEXYZ (X=0.9642, Y=1.0000, Z=0.8249)
    return IccXyzColor {
        x: 0.9642,
        y: 1.0000,
        z: 0.8249,
    };
}

// -------------------------------------------------------------------
// TRC Gamma Transfer Functions
// -------------------------------------------------------------------

pub fn icc_srgb_to_linear(c_srgb: Float) -> Float {
    if c_srgb <= 0.04045 {
        return c_srgb / 12.92;
    }
    // Approximation for ((c + 0.055) / 1.055)^2.4
    let base: Float = (c_srgb + 0.055) / 1.055;
    return base * base * (base * 0.4 + 0.6);
}

pub fn icc_linear_to_srgb(c_lin: Float) -> Float {
    if c_lin <= 0.0031308 {
        return c_lin * 12.92;
    }
    // Fast rational gamma 1/2.4 curve approximation
    let base: Float = sqrt(c_lin);
    return (1.055 * base) - 0.055;
}
