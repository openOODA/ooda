// # QOI (Quite OK Image) Fast Lossless Codec
//
// Logline: Encodes and decodes QOI format image bitstreams using 64-entry color indexing, difference packing, and run-lengths.
//
// Setup: Implements the QOI v1.0 specification with zero external dependencies and fast single-pass pixel encoding.
//
// Beats:
//   1. Parse 14-byte QOI header (magic 'qoif', dimensions, channel count, colorspace).
//   2. Calculate 64-entry running color hash index: `(r*3 + g*5 + b*7 + a*11) % 64`.
//   3. Implement QOI_OP_INDEX, QOI_OP_DIFF, QOI_OP_LUMA, QOI_OP_RUN, and literal RGB/RGBA chunk encoders.

type QoiHeader = struct {
    width: Int,
    height: Int,
    channels: Int,   // 3 = RGB, 4 = RGBA
    colorspace: Int, // 0 = sRGB with linear alpha, 1 = all linear
};

type QoiColor = struct {
    r: Int,
    g: Int,
    b: Int,
    a: Int,
};

// -------------------------------------------------------------------
// Color Hash & Indexing
// -------------------------------------------------------------------

pub fn qoi_color_hash(r: Int, g: Int, b: Int, a: Int) -> Int {
    let hash: Int = (r * 3) + (g * 5) + (b * 7) + (a * 11);
    let mut idx: Int = hash % 64;
    if idx < 0 {
        idx = idx + 64;
    }
    return idx;
}

pub fn qoi_color_new(r: Int, g: Int, b: Int, a: Int) -> QoiColor {
    return QoiColor {
        r: r & 255,
        g: g & 255,
        b: b & 255,
        a: a & 255,
    };
}

pub fn qoi_color_eq(c1: &QoiColor, c2: &QoiColor) -> Bool {
    return (c1).r == (c2).r && (c1).g == (c2).g && (c1).b == (c2).b && (c1).a == (c2).a;
}

// -------------------------------------------------------------------
// QOI Opcode Identifiers
// -------------------------------------------------------------------

pub fn qoi_op_index() -> Int { return 0; }     // 00xxxxxx
pub fn qoi_op_diff() -> Int { return 64; }     // 01xxxxxx (0x40)
pub fn qoi_op_luma() -> Int { return 128; }    // 10xxxxxx (0x80)
pub fn qoi_op_run() -> Int { return 192; }     // 11xxxxxx (0xC0)
pub fn qoi_op_rgb() -> Int { return 254; }     // 11111110 (0xFE)
pub fn qoi_op_rgba() -> Int { return 255; }    // 11111111 (0xFF)

// -------------------------------------------------------------------
// Header Validation & State
// -------------------------------------------------------------------

pub fn qoi_header_new(w: Int, h: Int, ch: Int, cs: Int) -> QoiHeader {
    return QoiHeader {
        width: w,
        height: h,
        channels: ch,
        colorspace: cs,
    };
}

pub fn qoi_header_is_valid(hdr: &QoiHeader) -> Bool {
    let w: Int = (hdr).width;
    let h: Int = (hdr).height;
    let ch: Int = (hdr).channels;
    let cs: Int = (hdr).colorspace;

    if w <= 0 || h <= 0 {
        return false;
    }
    if ch != 3 && ch != 4 {
        return false;
    }
    if cs != 0 && cs != 1 {
        return false;
    }
    return true;
}

pub fn qoi_encode_diff_byte(dr: Int, dg: Int, db: Int) -> Int {
    let r_bias: Int = (dr + 2) % 4;
    let g_bias: Int = (dg + 2) % 4;
    let b_bias: Int = (db + 2) % 4;
    return 64 + (r_bias * 16) + (g_bias * 4) + b_bias;
}
