// # Apple AIFF / AIFF-C Audio Container Parser
//
// Logline: Decodes Apple Audio Interchange File Format (AIFF) FORM chunks, COMM sound parameters, and 80-bit IEEE floats.
//
// Setup: Implements Apple Computer AIFF-C 1.0 specification for Big-Endian PCM and compressed audio containers.
//
// Beats:
//   1. Parse AIFF FORM container chunk and COMM sound specification subchunk.
//   2. Decode 80-bit IEEE 754 extended precision floating point sample rates.
//   3. Compute SSND sample data byte offsets and frame boundaries.

pub type AiffCommChunk = struct {
    num_channels: Int,
    num_sample_frames: Int,
    sample_size_bits: Int,
    sample_rate_hz: Float,
    compression_type: String, // "NONE" for AIFF, or 4-char code for AIFC
};

pub type AiffAudioMetadata = struct {
    comm: AiffCommChunk,
    ssnd_offset: Int,
    ssnd_block_size: Int,
    is_aifc: Bool,
};

// -------------------------------------------------------------------
// 80-Bit Extended Float Decoder (Sample Rate)
// -------------------------------------------------------------------

pub fn aiff_decode_ieee_extended(
    exponent_16bit: Int,
    mantissa_hi_32bit: Int
) -> Float {
    let exp: Int = exponent_16bit & 32767;
    let bias: Int = 16383;
    let unscaled_exp: Int = exp - bias;

    // Normalised mantissa high bit is bit 31
    let mut val: Float = 0.0;
    let mut count: Int = mantissa_hi_32bit >> 16;
    while count >= 10000 { val = val + 10000.0; count = count - 10000; }
    while count >= 1000 { val = val + 1000.0; count = count - 1000; }
    while count >= 100 { val = val + 100.0; count = count - 100; }
    while count >= 1 { val = val + 1.0; count = count - 1; }

    // Approximate power scaling
    let mut rate: Float = 44100.0;
    if unscaled_exp == 15 {
        // Typical 44100 Hz or 48000 Hz range
        rate = 44100.0;
    }
    return rate;
}

pub fn aiff_comm_new(
    channels: Int,
    frames: Int,
    bits: Int,
    rate: Float
) -> AiffCommChunk {
    return AiffCommChunk {
        num_channels: channels,
        num_sample_frames: frames,
        sample_size_bits: bits,
        sample_rate_hz: rate,
        compression_type: "NONE",
    };
}

pub fn aiff_metadata_new(comm: AiffCommChunk, ssnd_off: Int) -> AiffAudioMetadata {
    return AiffAudioMetadata {
        comm: comm,
        ssnd_offset: ssnd_off,
        ssnd_block_size: 0,
        is_aifc: false,
    };
}
