// # PNG Scanline Filtering & Paeth Predictor
//
// Logline: Implements ISO/IEC 15948 PNG scanline reconstruction filters (None, Sub, Up, Average, Paeth) and inverse filtering.
//
// Setup: Exact byte-level filtering and de-filtering arithmetic with modulo 256 wraparound.
//
// Beats:
//   1. Implement the 5 canonical PNG filter types: None (0), Sub (1), Up (2), Average (3), Paeth (4).
//   2. Compute the Paeth linear predictor given Left (a), Above (b), and Upper-Left (c) pixel bytes.
//   3. Decode and reconstruct unfiltered scanlines from raw filtered byte buffers.

pub fn png_filter_type_none() -> Int { return 0; }
pub fn png_filter_type_sub() -> Int { return 1; }
pub fn png_filter_type_up() -> Int { return 2; }
pub fn png_filter_type_average() -> Int { return 3; }
pub fn png_filter_type_paeth() -> Int { return 4; }

// -------------------------------------------------------------------
// Paeth Predictor Arithmetic
// -------------------------------------------------------------------

pub fn png_paeth_predictor(a: Int, b: Int, c: Int) -> Int {
    let p: Int = a + b - c;
    let mut pa: Int = p - a;
    if pa < 0 { pa = 0 - pa; }
    let mut pb: Int = p - b;
    if pb < 0 { pb = 0 - pb; }
    let mut pc: Int = p - c;
    if pc < 0 { pc = 0 - pc; }

    if pa <= pb && pa <= pc {
        return a;
    }
    if pb <= pc {
        return b;
    }
    return c;
}

// -------------------------------------------------------------------
// Single Byte Reconstruction
// -------------------------------------------------------------------

pub fn png_unfilter_byte(
    filter_type: Int,
    x: Int,
    a: Int,
    b: Int,
    c: Int
) -> Int {
    if filter_type == 0 {
        return x & 255;
    }
    if filter_type == 1 {
        // Sub: Raw(x) = (Filt(x) + Raw(x - bpp)) mod 256
        return (x + a) & 255;
    }
    if filter_type == 2 {
        // Up: Raw(x) = (Filt(x) + Prior(x)) mod 256
        return (x + b) & 255;
    }
    if filter_type == 3 {
        // Average: Raw(x) = (Filt(x) + floor((Raw(x-bpp) + Prior(x)) / 2)) mod 256
        let avg: Int = (a + b) / 2;
        return (x + avg) & 255;
    }
    if filter_type == 4 {
        // Paeth: Raw(x) = (Filt(x) + PaethPredictor(a, b, c)) mod 256
        let pr: Int = png_paeth_predictor(a, b, c);
        return (x + pr) & 255;
    }
    return x & 255;
}

// -------------------------------------------------------------------
// Scanline Reconstruction Loop
// -------------------------------------------------------------------

pub fn png_reconstruct_scanline(
    filtered_scanline: List[Int],
    prior_scanline: List[Int],
    bpp: Int
) -> List[Int] {
    let line_len: Int = list_len(filtered_scanline);
    if line_len <= 1 {
        return list_new();
    }
    let filter_type: Int = list_get(filtered_scanline, 0);
    let mut out: List[Int] = list_new();

    let prior_len: Int = list_len(prior_scanline);
    let mut i: Int = 1;
    while i < line_len {
        let x: Int = list_get(filtered_scanline, i);
        let byte_idx: Int = i - 1;

        let a: Int = if byte_idx >= bpp {
            list_get(out, byte_idx - bpp)
        } else {
            0
        };

        let b: Int = if byte_idx < prior_len {
            list_get(prior_scanline, byte_idx)
        } else {
            0
        };

        let c: Int = if (byte_idx >= bpp) && (byte_idx - bpp < prior_len) {
            list_get(prior_scanline, byte_idx - bpp)
        } else {
            0
        };

        let recon: Int = png_unfilter_byte(filter_type, x, a, b, c);
        out = list_push(out, recon);
        i = i + 1;
    }

    return out;
}

// -------------------------------------------------------------------
// Scanline Filter Encoder (Forward Filter)
// -------------------------------------------------------------------

pub fn png_filter_byte(
    filter_type: Int,
    raw_x: Int,
    a: Int,
    b: Int,
    c: Int
) -> Int {
    if filter_type == 0 {
        return raw_x & 255;
    }
    if filter_type == 1 {
        return (raw_x - a) & 255;
    }
    if filter_type == 2 {
        return (raw_x - b) & 255;
    }
    if filter_type == 3 {
        let avg: Int = (a + b) / 2;
        return (raw_x - avg) & 255;
    }
    if filter_type == 4 {
        let pr: Int = png_paeth_predictor(a, b, c);
        return (raw_x - pr) & 255;
    }
    return raw_x & 255;
}
