// # GIF LZW Decompressor & Graphic Control Extension
//
// Logline: Decodes CompuServe GIF87a/89a Variable-Width LZW raster streams, color tables, and animation frame delay metadata.
//
// Setup: Implements GIF89a specification for indexed palette graphics, transparent indices, and LZW dictionary tree parsing.
//
// Beats:
//   1. Parse GIF Screen Descriptor and Graphic Control Extension (GCE) animation properties.
//   2. Manage variable-length LZW string code table dictionary (codes up to 4096).
//   3. Handle Clear Code (CC) and End-Of-Information (EOI) stream control tokens.

pub type GifScreenDescriptor = struct {
    width: Int,
    height: Int,
    has_global_color_table: Bool,
    color_resolution_bits: Int,
    sort_flag: Bool,
    global_color_table_size: Int,
    background_color_index: Int,
    pixel_aspect_ratio: Int
};

pub type GifGraphicControl = struct {
    disposal_method: Int, // 0 = unspecified, 1 = do not dispose, 2 = restore to bg, 3 = restore to previous
    user_input_flag: Bool,
    transparent_color_flag: Bool,
    delay_time_centiseconds: Int, // in 1/100 seconds
    transparent_color_index: Int
};

pub type GifLzwState = struct {
    min_code_size: Int,
    current_code_size: Int,
    clear_code: Int,
    eoi_code: Int,
    next_code: Int,
    max_code: Int
};

// -------------------------------------------------------------------
// GIF LZW State Initialization
// -------------------------------------------------------------------

pub fn gif_lzw_init(min_code_size: Int) -> GifLzwState {
    let clear: Int = 1 << min_code_size;
    let eoi: Int = clear + 1;
    let first_free: Int = clear + 2;
    let cur_size: Int = min_code_size + 1;

    return GifLzwState {
        min_code_size: min_code_size,
        current_code_size: cur_size,
        clear_code: clear,
        eoi_code: eoi,
        next_code: first_free,
        max_code: 1 << cur_size
    };
}

pub fn gif_lzw_reset(state: &GifLzwState) -> GifLzwState {
    return gif_lzw_init((state).min_code_size);
}

pub fn gif_lzw_add_code(state: &GifLzwState) -> GifLzwState {
    let next: Int = (state).next_code + 1;
    let mut cur_size: Int = (state).current_code_size;
    let mut max_c: Int = (state).max_code;

    if next >= max_c && cur_size < 12 {
        cur_size = cur_size + 1;
        max_c = 1 << cur_size;
    }

    return GifLzwState {
        min_code_size: (state).min_code_size,
        current_code_size: cur_size,
        clear_code: (state).clear_code,
        eoi_code: (state).eoi_code,
        next_code: next,
        max_code: max_c
    };
}

// -------------------------------------------------------------------
// Control Extension Constructors
// -------------------------------------------------------------------

pub fn gif_gce_default() -> GifGraphicControl {
    return GifGraphicControl {
        disposal_method: 0,
        user_input_flag: false,
        transparent_color_flag: false,
        delay_time_centiseconds: 0,
        transparent_color_index: 0
    };
}
