// # AAC ADTS Audio Transport Stream Header Parser
//
// Logline: Decodes Advanced Audio Coding (AAC) ADTS fixed and variable sync headers, audio profiles, and frame sizes.
//
// Setup: Implements ISO/IEC 13818-7 / 14496-3 ADTS streaming protocol for MPEG-2/4 AAC audio bitstreams.
//
// Beats:
//   1. Parse 28-bit ADTS fixed header and validate 12-bit sync word (0xFFF).
//   2. Extract AAC Object Type Profile (AAC LC, HE-AAC), sampling rate index, and channel config.
//   3. Compute 13-bit AAC raw frame length and data block counts.

pub type AacAdtsHeader = struct {
    syncword: Int,        // 12 bits (0xFFF)
    id: Int,              // 0 = MPEG-4, 1 = MPEG-2
    layer: Int,           // must be 0
    protection_absent: Int,
    profile: Int,         // 0 = Main, 1 = LC, 2 = SSR, 3 = LTP
    sampling_freq_index: Int,
    channel_configuration: Int,
    frame_length_bytes: Int,
    raw_data_blocks: Int,
};

// -------------------------------------------------------------------
// Sampling Rate Lookup Table
// -------------------------------------------------------------------

pub fn aac_lookup_sampling_rate(idx: Int) -> Int {
    if idx == 0 { return 96000; }
    if idx == 1 { return 88200; }
    if idx == 2 { return 64000; }
    if idx == 3 { return 48000; }
    if idx == 4 { return 44100; }
    if idx == 5 { return 32000; }
    if idx == 6 { return 24000; }
    if idx == 7 { return 22050; }
    if idx == 8 { return 16000; }
    if idx == 9 { return 12000; }
    if idx == 10 { return 11025; }
    if idx == 11 { return 8000; }
    if idx == 12 { return 7350; }
    return 0;
}

// -------------------------------------------------------------------
// ADTS Header Bitstream Unpacker
// -------------------------------------------------------------------

pub fn aac_adts_parse_7bytes(
    b0: Int, b1: Int, b2: Int, b3: Int, b4: Int, b5: Int, b6: Int
) -> AacAdtsHeader {
    let sync: Int = (b0 << 4) | (b1 >> 4);
    let id_bit: Int = (b1 >> 3) & 1;
    let lay: Int = (b1 >> 1) & 3;
    let prot: Int = b1 & 1;

    let prof: Int = (b2 >> 6) & 3;
    let sf_idx: Int = (b2 >> 2) & 15;
    let ch_cfg: Int = ((b2 & 1) << 2) | (b3 >> 6);

    let flen: Int = ((b3 & 3) << 11) | (b4 << 3) | (b5 >> 5);
    let blocks: Int = b6 & 3;

    return AacAdtsHeader {
        syncword: sync,
        id: id_bit,
        layer: lay,
        protection_absent: prot,
        profile: prof,
        sampling_freq_index: sf_idx,
        channel_configuration: ch_cfg,
        frame_length_bytes: flen,
        raw_data_blocks: blocks,
    };
}

pub fn aac_adts_is_valid(hdr: &AacAdtsHeader) -> Bool {
    return (hdr).syncword == 4095 && (hdr).layer == 0;
}
