// -------------------------------------------------------------------
// Unified Media Engine Context
// -------------------------------------------------------------------

pub type MediaDspContext = struct {
    sample_rate: Float,
    block_size: Int,
    audio_channels: Int,
    video_width: Int,
    video_height: Int,
};

pub fn media_dsp_context_default() -> MediaDspContext {
    return MediaDspContext {
        sample_rate: 44100.0,
        block_size: 512,
        audio_channels: 2,
        video_width: 1920,
        video_height: 1080,
    };
}

// -------------------------------------------------------------------
// Facade Convenience Shims
// -------------------------------------------------------------------

pub fn media_create_png_ihdr(w: Int, h: Int, depth: Int, color: Int) -> PngIhdr {
    return png_ihdr_new(w, h, depth, color, 0, 0, 0);
}

pub fn media_create_wav_fmt(channels: Int, rate: Int, bits: Int) -> WavFmtSubchunk {
    return wav_fmt_new(1, channels, rate, bits);
}

pub fn media_create_biquad_lowpass(sr: Float, cutoff: Float, q: Float) -> BiquadFilter {
    let coeffs: BiquadCoefficients = biquad_lowpass(sr, cutoff, q);
    return biquad_filter_new(coeffs);
}

pub fn media_create_polyblep_osc(freq: Float, sr: Float) -> PolyBlepOscillator {
    return synth_oscillator_new(freq, sr);
}

pub fn media_create_adsr(att: Float, dec: Float, sus: Float, rel: Float, sr: Float) -> AdsrEnvelope {
    return adsr_envelope_new(att, dec, sus, rel, sr);
}

pub fn media_create_moog_filter(cutoff: Float, res: Float, sr: Float) -> MoogLadderFilter {
    return moog_filter_new(cutoff, res, sr);
}
