// # H.265 / HEVC 2-Byte NAL Unit Header Parser
//
// Logline: Decodes High Efficiency Video Coding (H.265/HEVC) 2-byte NAL unit headers, layer IDs, and temporal scalability tiers.
//
// Setup: Implements ITU-T H.265 Section 7.3.1.2 NAL unit syntax with VPS/SPS/PPS parameter sets and CRA/IDR keyframe identification.
//
// Beats:
//   1. Parse 16-bit HEVC NAL unit header (forbidden_zero, nal_unit_type, nuh_layer_id, temporal_id).
//   2. Classify NAL unit types: Trailing (0..1), IDR (19..20), CRA (21), VPS (32), SPS (33), PPS (34).
//   3. Compute temporal sub-layer hierarchical indexing for scalable bitstreams.

pub type H265NalUnit = struct {
    forbidden_zero_bit: Int,
    nal_unit_type: Int,      // 6 bits (0..63)
    nuh_layer_id: Int,       // 6 bits
    temporal_id: Int,        // nuh_temporal_id_plus1 - 1
};

// -------------------------------------------------------------------
// HEVC NAL Unit Type Constants
// -------------------------------------------------------------------

pub fn h265_nal_trail_r() -> Int { return 1; }
pub fn h265_nal_idr_w_radl() -> Int { return 19; }
pub fn h265_nal_idr_n_lp() -> Int { return 20; }
pub fn h265_nal_cra() -> Int { return 21; }
pub fn h265_nal_vps() -> Int { return 32; }
pub fn h265_nal_sps() -> Int { return 33; }
pub fn h265_nal_pps() -> Int { return 34; }
pub fn h265_nal_aud() -> Int { return 35; }

// -------------------------------------------------------------------
// 2-Byte Header Parser
// -------------------------------------------------------------------

pub fn h265_nal_parse_header_bytes(byte0: Int, byte1: Int) -> H265NalUnit {
    let f_zero: Int = (byte0 >> 7) & 1;
    let u_type: Int = (byte0 >> 1) & 63;
    let layer_id: Int = ((byte0 & 1) << 5) | ((byte1 >> 3) & 31);
    let tid_plus1: Int = byte1 & 7;

    return H265NalUnit {
        forbidden_zero_bit: f_zero,
        nal_unit_type: u_type,
        nuh_layer_id: layer_id,
        temporal_id: if tid_plus1 > 0 { tid_plus1 - 1 } else { 0 },
    };
}

pub fn h265_is_intra_random_access_point(nal: &H265NalUnit) -> Bool {
    let t: Int = (nal).nal_unit_type;
    return t >= 16 && t <= 23; // BLA, IDR, CRA
}

pub fn h265_is_vps_or_sps(nal: &H265NalUnit) -> Bool {
    let t: Int = (nal).nal_unit_type;
    return t == 32 || t == 33;
}
