// # 4-Operator FM / Phase Modulation Matrix Synthesizer
//
// Logline: Implements 4-operator Frequency Modulation (FM) synthesis with phase modulation routing matrix and operator feedback.
//
// Setup: Implements Chowning FM synthesis algorithms and Yamaha DX-style operator modulation topologies.
//
// Beats:
//   1. Define FmOperator with frequency ratio multipliers, modulation depth, and phase accumulator.
//   2. Compute 4x4 phase modulation interaction matrix across carriers and modulators.
//   3. Implement self-feedback operator loops for metallic and noise harmonic generation.

pub type FmOperator = struct {
    frequency_ratio: Float,
    phase: Float,
    feedback_amount: Float,
    last_output: Float,
};

pub type FmMatrix4Op = struct {
    op0: FmOperator,
    op1: FmOperator,
    op2: FmOperator,
    op3: FmOperator,
    base_freq_hz: Float,
    sample_rate: Float,
};

// -------------------------------------------------------------------
// Operator Constructor
// -------------------------------------------------------------------

pub fn fm_operator_new(ratio: Float, fb: Float) -> FmOperator {
    return FmOperator {
        frequency_ratio: ratio,
        phase: 0.0,
        feedback_amount: fb,
        last_output: 0.0,
    };
}

pub fn fm_matrix_new(base_freq: Float, sr: Float) -> FmMatrix4Op {
    return FmMatrix4Op {
        op0: fm_operator_new(1.0, 0.0), // Carrier
        op1: fm_operator_new(2.0, 0.0), // Modulator 1
        op2: fm_operator_new(1.0, 0.0), // Modulator 2
        op3: fm_operator_new(0.5, 0.2), // Modulator 3 with feedback
        base_freq_hz: base_freq,
        sample_rate: if sr > 0.0 { sr } else { 44100.0 },
    };
}

// -------------------------------------------------------------------
// Single Operator Sine Evaluation
// -------------------------------------------------------------------

pub fn fm_eval_op(
    op: &FmOperator,
    mod_phase: Float,
    base_freq: Float,
    sr: Float
) -> List[Float] {
    // Returns [new_phase, new_last_output, sample_output]
    let pi: Float = 3.141592653589793;
    let dt: Float = (base_freq * (op).frequency_ratio) / sr;
    let mut next_phase: Float = (op).phase + dt;
    while next_phase >= 1.0 { next_phase = next_phase - 1.0; }

    let total_phase: Float = next_phase + mod_phase + ((op).feedback_amount * (op).last_output);
    let rad: Float = 2.0 * pi * total_phase;
    let out_sample: Float = rad - (rad * rad * rad * 0.16666667);

    let mut res: List[Float] = list_new();
    res = list_push(res, next_phase);
    res = list_push(res, out_sample);
    res = list_push(res, out_sample);
    return res;
}
