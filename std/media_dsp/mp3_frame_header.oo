// # MPEG Audio Frame Header & Layer III Sync Parser
//
// Logline: Decodes MPEG-1/2 Audio Layer III (MP3) frame sync headers, bitrates, sample rates, and computes frame lengths.
//
// Setup: Implements ISO/IEC 11172-3 / 13818-3 specifications for MPEG audio stream synchronization and side information.
//
// Beats:
//   1. Parse 32-bit MPEG frame header and validate 11-bit frame sync word (0xFFE).
//   2. Decode Audio Version (MPEG-1/2/2.5), Layer (I/II/III), Bitrate, and Sampling Rate.
//   3. Calculate exact frame byte length: `(144 * Bitrate * 1000) / SampleRate + Padding`.

pub type Mp3FrameHeader = struct {
    mpeg_version: Int,    // 3 = MPEG-1, 2 = MPEG-2, 0 = MPEG-2.5
    layer: Int,           // 1 = Layer III, 2 = Layer II, 3 = Layer I
    protection_bit: Int,  // 0 = CRC protected, 1 = no CRC
    bitrate_kbps: Int,
    sample_rate_hz: Int,
    padding_bit: Int,
    channel_mode: Int,    // 0 = Stereo, 1 = Joint Stereo, 2 = Dual Mono, 3 = Single Mono
    frame_length_bytes: Int
};

// -------------------------------------------------------------------
// Bitrate & Sample Rate Lookup Tables
// -------------------------------------------------------------------

pub fn mp3_lookup_bitrate_v1_l3(idx: Int) -> Int {
    if idx == 1 { return 32; }  if idx == 2 { return 40; }  if idx == 3 { return 48; }  if idx == 4 { return 56; }
    if idx == 5 { return 64; }  if idx == 6 { return 80; }  if idx == 7 { return 96; }  if idx == 8 { return 112; }
    if idx == 9 { return 128; } if idx == 10 { return 160; } if idx == 11 { return 192; } if idx == 12 { return 224; }
    if idx == 13 { return 256; } if idx == 14 { return 320; }
    return 0; // 0 = free, 15 = bad
}

pub fn mp3_lookup_samplerate_v1(idx: Int) -> Int {
    if idx == 0 { return 44100; }
    if idx == 1 { return 48000; }
    if idx == 2 { return 32000; }
    return 0;
}

// -------------------------------------------------------------------
// Header Parsing & Frame Length Calculation
// -------------------------------------------------------------------

pub fn mp3_frame_header_parse(header_dword: Int) -> Mp3FrameHeader {
    let sync: Int = (header_dword >> 21) & 2047; // Top 11 bits
    let ver: Int = (header_dword >> 19) & 3;
    let lay: Int = (header_dword >> 17) & 3;
    let prot: Int = (header_dword >> 16) & 1;
    let br_idx: Int = (header_dword >> 12) & 15;
    let sr_idx: Int = (header_dword >> 10) & 3;
    let pad: Int = (header_dword >> 9) & 1;
    let mode: Int = (header_dword >> 6) & 3;

    let bitrate: Int = mp3_lookup_bitrate_v1_l3(br_idx);
    let srate: Int = mp3_lookup_samplerate_v1(sr_idx);

    let mut flen: Int = 0;
    if srate > 0 && bitrate > 0 {
        // Formula for Layer III: (144 * Bitrate * 1000) / SampleRate + Padding
        flen = ((144 * bitrate * 1000) / srate) + pad;
    }

    return Mp3FrameHeader {
        mpeg_version: ver,
        layer: lay,
        protection_bit: prot,
        bitrate_kbps: bitrate,
        sample_rate_hz: srate,
        padding_bit: pad,
        channel_mode: mode,
        frame_length_bytes: flen
    };
}

pub fn mp3_samples_per_frame(layer: Int, mpeg_version: Int) -> Int {
    if layer == 3 { return 384; }  // Layer I
    if layer == 2 { return 1152; } // Layer II
    if layer == 1 {
        // Layer III
        return if mpeg_version == 3 { 1152 } else { 576 };
    }
    return 1152;
}
