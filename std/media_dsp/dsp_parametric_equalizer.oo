// # Parametric Equalizer & Audio EQ Peaking Filters
//
// Logline: Implements RBJ parametric peaking equalizer, low/high shelf filters, and multi-band mastering EQ chains.
//
// Setup: Implements Robert Bristow-Johnson Audio EQ Cookbook equations for audio mixing and studio mastering.
//
// Beats:
//   1. Compute Peaking EQ coefficients with gain dB, center frequency, and bandwidth Q.
//   2. Compute Low Shelf and High Shelf filter transfer function coefficients.
//   3. Cascade 3-band parametric equalizer stages (Low Shelf, Mid Peaking, High Shelf).

pub type EqBandCoeffs = struct {
    b0: Float,
    b1: Float,
    b2: Float,
    a1: Float,
    a2: Float
};

pub type ParametricEq3Band = struct {
    low_shelf: EqBandCoeffs,
    mid_peak: EqBandCoeffs,
    high_shelf: EqBandCoeffs
};

// -------------------------------------------------------------------
// Peaking EQ Coefficient Generator
// -------------------------------------------------------------------

pub fn dsp_peaking_eq(
    sample_rate: Float,
    freq_hz: Float,
    gain_db: Float,
    q: Float
) -> EqBandCoeffs {
    let pi: Float = 3.141592653589793;
    let safe_sr: Float = if sample_rate > 0.0 { sample_rate } else { 44100.0 };
    let w0: Float = (2.0 * pi * freq_hz) / safe_sr;

    let w2: Float = w0 * w0;
    let cos_w0: Float = 1.0 - (w2 * 0.5) + (w2 * w2 * 0.0416666667);
    let sin_w0: Float = w0 - (w0 * w2 * 0.1666666667);

    // Linear amplitude A = 10^(gain_db / 40) approx
    let mut a_lin: Float = 1.0 + (gain_db * 0.0575646);
    if a_lin < 0.1 { a_lin = 0.1; }

    let safe_q: Float = if q > 0.001 { q } else { 1.0 };
    let alpha: Float = sin_w0 / (2.0 * safe_q);

    let b0_raw: Float = 1.0 + (alpha * a_lin);
    let b1_raw: Float = 0.0 - (2.0 * cos_w0);
    let b2_raw: Float = 1.0 - (alpha * a_lin);
    let a0_raw: Float = 1.0 + (alpha / a_lin);
    let a1_raw: Float = 0.0 - (2.0 * cos_w0);
    let a2_raw: Float = 1.0 - (alpha / a_lin);

    return EqBandCoeffs {
        b0: b0_raw / a0_raw,
        b1: b1_raw / a0_raw,
        b2: b2_raw / a0_raw,
        a1: a1_raw / a0_raw,
        a2: a2_raw / a0_raw
    };
}

// -------------------------------------------------------------------
// 3-Band Parametric EQ Strip
// -------------------------------------------------------------------

pub fn dsp_eq_3band_new(sample_rate: Float) -> ParametricEq3Band {
    let low: EqBandCoeffs = dsp_peaking_eq(sample_rate, 100.0, 0.0, 0.707);
    let mid: EqBandCoeffs = dsp_peaking_eq(sample_rate, 1000.0, 0.0, 1.0);
    let high: EqBandCoeffs = dsp_peaking_eq(sample_rate, 8000.0, 0.0, 0.707);

    return ParametricEq3Band {
        low_shelf: low,
        mid_peak: mid,
        high_shelf: high
    };
}
