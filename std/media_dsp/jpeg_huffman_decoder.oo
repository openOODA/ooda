// # JPEG Huffman Table & Entropy Decoder
//
// Logline: Decodes ITU-T T.81 JPEG Huffman trees (DHT), DC difference coefficients, and AC run-length symbols.
//
// Setup: Parses 16-element BITS code length counts and HUFFVAL symbol arrays for baseline JPEG stream decoding.
//
// Beats:
//   1. Define JpegHuffmanTable struct containing BITS length counts and HUFFVAL mapped symbols.
//   2. Reconstruct canonical Huffman min/max prefix code lookup arrays from 1 to 16 bit depths.
//   3. Decode DC category magnitude values and sign extension differences.

pub type JpegHuffmanTable = struct {
    table_class: Int, // 0 = DC, 1 = AC
    table_id: Int,    // 0 = Luminance, 1 = Chrominance
    bits: List[Int],   // 16 counts for bit lengths 1..16
    huffval: List[Int]
};

pub type JpegDcSymbol = struct {
    category: Int,
    diff_value: Int
};

// -------------------------------------------------------------------
// Huffman Table Constructors & Properties
// -------------------------------------------------------------------

pub fn jpeg_huffman_table_new(
    t_class: Int,
    t_id: Int,
    bits: List[Int],
    huffval: List[Int]
) -> JpegHuffmanTable {
    return JpegHuffmanTable {
        table_class: t_class,
        table_id: t_id,
        bits: bits,
        huffval: huffval
    };
}

pub fn jpeg_huffman_total_symbols(table: &JpegHuffmanTable) -> Int {
    let mut total: Int = 0;
    let mut i: Int = 0;
    let n: Int = list_len((table).bits);
    while i < n {
        total = total + list_get((table).bits, i);
        i = i + 1;
    }
    return total;
}

// -------------------------------------------------------------------
// DC Magnitude Sign Extension
// -------------------------------------------------------------------

pub fn jpeg_extend_sign(raw_val: Int, category: Int) -> Int {
    if category == 0 {
        return 0;
    }
    let threshold: Int = 1 << (category - 1);
    if raw_val < threshold {
        // Negative coefficient in JPEG standard
        let offset: Int = (1 << category) - 1;
        return raw_val - offset;
    }
    return raw_val;
}

pub fn jpeg_decode_dc_diff(category: Int, bits_val: Int) -> JpegDcSymbol {
    let diff: Int = jpeg_extend_sign(bits_val, category);
    return JpegDcSymbol {
        category: category,
        diff_value: diff
    };
}

// -------------------------------------------------------------------
// Standard JPEG Luminance DC Table Default Generator
// -------------------------------------------------------------------

pub fn jpeg_default_dc_lum_table() -> JpegHuffmanTable {
    let mut bits: List[Int] = list_new();
    // BITS counts for length 1..16
    bits = list_push(bits, 0); bits = list_push(bits, 1); bits = list_push(bits, 5); bits = list_push(bits, 1);
    bits = list_push(bits, 1); bits = list_push(bits, 1); bits = list_push(bits, 1); bits = list_push(bits, 1);
    bits = list_push(bits, 1); bits = list_push(bits, 0); bits = list_push(bits, 0); bits = list_push(bits, 0);
    bits = list_push(bits, 0); bits = list_push(bits, 0); bits = list_push(bits, 0); bits = list_push(bits, 0);

    let mut vals: List[Int] = list_new();
    vals = list_push(vals, 0); vals = list_push(vals, 1); vals = list_push(vals, 2); vals = list_push(vals, 3);
    vals = list_push(vals, 4); vals = list_push(vals, 5); vals = list_push(vals, 6); vals = list_push(vals, 7);
    vals = list_push(vals, 8); vals = list_push(vals, 9); vals = list_push(vals, 10); vals = list_push(vals, 11);

    return JpegHuffmanTable {
        table_class: 0,
        table_id: 0,
        bits: bits,
        huffval: vals
    };
}
