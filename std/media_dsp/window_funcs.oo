// # Discrete spectral window functions
//
// Logline: Builds Hann, Hamming, Blackman-Harris, and Flat-Top windows and energy-normalizes them so the sum of squares is one.
//
// Setup: Pure. N must be at least 4. Uses host cos. Angles are 2*pi*n/N.
//
// Beats:
//   1. Reject N less than 4.
//   2. Evaluate the named cosine series.
//   3. Divide by the Euclidean norm of the vector.
//   4. Return energy plus identity samples w0 and wmid.

pub type WinOut = struct {
    flag: Int,
    err: String,
    n: Int,
    energy: Float,
    w0: Float,
    wmid: Float
};

fn win_err(m: String) -> WinOut {
    return WinOut { flag: 0, err: m, n: 0, energy: 0.0, w0: 0.0, wmid: 0.0 };
}

fn win_two_pi() -> Float {
    return 6.283185307179586;
}

fn win_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

fn win_norm(raw: List[Float]) -> WinOut {
    let n: Int = list_len(raw);
    let mut s: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let x: Float = list_get(raw, i);
        s = s + x * x;
        i = i + 1;
    }
    if s <= 0.0 {
        return win_err("window energy");
    }
    let g: Float = sqrt(s);
    let mut e2: Float = 0.0;
    let mut y0: Float = 0.0;
    let mut ym: Float = 0.0;
    let mid: Int = n / 2;
    i = 0;
    while i < n {
        let y: Float = list_get(raw, i) / g;
        e2 = e2 + y * y;
        if i == 0 {
            y0 = y;
        }
        if i == mid {
            ym = y;
        }
        i = i + 1;
    }
    if win_abs(e2 - 1.0) > 0.01 {
        return win_err("window energy");
    }
    return WinOut { flag: 1, err: "", n: n, energy: e2, w0: y0, wmid: ym };
}

fn win_itof(n: Int) -> Float {
    let mut x: Float = 0.0;
    let mut i: Int = 0;
    let mut m: Int = n;
    if m < 0 {
        m = 0 - m;
    }
    while i < m {
        x = x + 1.0;
        i = i + 1;
    }
    if n < 0 {
        return 0.0 - x;
    }
    return x;
}

fn win_cosk(i: Int, n: Int, k: Int) -> Float {
    let nf: Float = win_itof(n);
    let idx: Float = win_itof(i);
    let kf: Float = win_itof(k);
    return cos(win_two_pi() * kf * idx / nf);
}

pub fn window_funcs_hann(n: Int) -> WinOut {
    if n < 4 {
        return win_err("window n");
    }
    let mut raw: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        raw = list_push(raw, 0.5 - 0.5 * win_cosk(i, n, 1));
        i = i + 1;
    }
    let o: WinOut = win_norm(raw);
    if o.flag < 1 {
        return o;
    }
    if win_abs(o.w0) > 0.01 {
        return win_err("window hann ones");
    }
    return o;
}

pub fn window_funcs_hamming(n: Int) -> WinOut {
    if n < 4 {
        return win_err("window n");
    }
    let mut raw: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        raw = list_push(raw, 0.54 - 0.46 * win_cosk(i, n, 1));
        i = i + 1;
    }
    return win_norm(raw);
}

pub fn window_funcs_blackman_harris(n: Int) -> WinOut {
    if n < 4 {
        return win_err("window n");
    }
    let mut raw: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let w: Float = 0.35875 - 0.48829 * win_cosk(i, n, 1) + 0.14128 * win_cosk(i, n, 2) - 0.01168 * win_cosk(i, n, 3);
        raw = list_push(raw, w);
        i = i + 1;
    }
    return win_norm(raw);
}

pub fn window_funcs_flat_top(n: Int) -> WinOut {
    if n < 4 {
        return win_err("window n");
    }
    let mut raw: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let w: Float = 0.21557895 - 0.41663158 * win_cosk(i, n, 1) + 0.277263158 * win_cosk(i, n, 2) - 0.083578947 * win_cosk(i, n, 3) + 0.006947368 * win_cosk(i, n, 4);
        raw = list_push(raw, w);
        i = i + 1;
    }
    return win_norm(raw);
}

pub fn window_funcs_prove(kind: Int, n: Int) -> Result[Int, String] {
    let mut o: WinOut = win_err("window kind");
    if kind == 0 {
        o = window_funcs_hann(n);
    }
    if kind == 1 {
        o = window_funcs_hamming(n);
    }
    if kind == 2 {
        o = window_funcs_blackman_harris(n);
    }
    if kind == 3 {
        o = window_funcs_flat_top(n);
    }
    if o.flag < 1 {
        return Err(o.err);
    }
    return Ok(o.n);
}

pub fn window_funcs_stat(flag: Int, err: String, n: Int) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(n);
}
