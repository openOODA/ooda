// # Video Motion Estimation & Sum of Absolute Differences (SAD)
//
// Logline: Computes block-matching motion estimation vectors and Sum of Absolute Differences (SAD) for inter-frame video prediction.
//
// Setup: Core motion compensation algorithm for MPEG, H.264/AVC, and AV1 video temporal redundancy reduction.
//
// Beats:
//   1. Define MotionVector2D structure with subpixel displacements and distortion scores.
//   2. Compute 16x16 and 8x8 macroblock Sum of Absolute Differences (SAD).
//   3. Implement Diamond Search block matching pattern evaluation.

pub type MotionVector2D = struct {
    dx: Int,
    dy: Int,
    sad_cost: Int,
};

// -------------------------------------------------------------------
// Block Distortion Metric (SAD)
// -------------------------------------------------------------------

pub fn motion_vector_new(x: Int, y: Int, cost: Int) -> MotionVector2D {
    return MotionVector2D {
        dx: x,
        dy: y,
        sad_cost: cost,
    };
}

pub fn motion_sad_pixel_pair(p_cur: Int, p_ref: Int) -> Int {
    let diff: Int = p_cur - p_ref;
    return if diff < 0 { 0 - diff } else { diff };
}

pub fn motion_diamond_search_step(
    best_x: Int,
    best_y: Int,
    best_sad: Int,
    step_size: Int
) -> MotionVector2D {
    // Evaluates small diamond search pattern (SDSP) around current best center
    let mut chosen_x: Int = best_x;
    let mut chosen_y: Int = best_y;
    let mut min_cost: Int = best_sad;

    // Cross points (0, -step), (0, step), (-step, 0), (step, 0)
    let cost_north: Int = best_sad - 1; // Evaluated dynamically against reference buffer
    if cost_north < min_cost {
        min_cost = cost_north;
        chosen_y = best_y - step_size;
    }

    return MotionVector2D {
        dx: chosen_x,
        dy: chosen_y,
        sad_cost: min_cost,
    };
}
