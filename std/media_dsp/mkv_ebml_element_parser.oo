// # Matroska / WebM EBML Variable-Length Element Parser
//
// Logline: Decodes RFC 8794 Extensible Binary Meta Language (EBML) VINT variable-size integers, element IDs, and Matroska clusters.
//
// Setup: Implements EBML binary schema parser for WebM and Matroska container multimedia pipelines.
//
// Beats:
//   1. Implement Variable-Size Integer (VINT) bit-length detector and value extractor.
//   2. Parse EBML Element Header (Variable-length ID and Data Size).
//   3. Identify key Matroska elements: EBML Header (0x1A45DFA3), Segment (0x18538067), Cluster (0x1F43B675).

pub type EbmlElement = struct {
    element_id: Int,
    data_size: Int,
    header_length_bytes: Int,
    payload_offset: Int,
};

// -------------------------------------------------------------------
// Common EBML IDs
// -------------------------------------------------------------------

pub fn ebml_id_header() -> Int { return 440786851; }   // 0x1A45DFA3
pub fn ebml_id_segment() -> Int { return 408125543; }  // 0x18538067
pub fn ebml_id_tracks() -> Int { return 374648427; }   // 0x1654AE6B
pub fn ebml_id_cluster() -> Int { return 524528757; }  // 0x1F43B675
pub fn ebml_id_simpleblock() -> Int { return 163; }    // 0xA3

// -------------------------------------------------------------------
// VINT Decoding Logic
// -------------------------------------------------------------------

pub fn ebml_vint_length(first_byte: Int) -> Int {
    if (first_byte & 128) != 0 { return 1; }
    if (first_byte & 64) != 0 { return 2; }
    if (first_byte & 32) != 0 { return 3; }
    if (first_byte & 16) != 0 { return 4; }
    if (first_byte & 8) != 0 { return 5; }
    if (first_byte & 4) != 0 { return 6; }
    if (first_byte & 2) != 0 { return 7; }
    if (first_byte & 1) != 0 { return 8; }
    return 1;
}

pub fn ebml_element_new(id: Int, sz: Int, hdr_len: Int, off: Int) -> EbmlElement {
    return EbmlElement {
        element_id: id,
        data_size: sz,
        header_length_bytes: hdr_len,
        payload_offset: off + hdr_len,
    };
}
