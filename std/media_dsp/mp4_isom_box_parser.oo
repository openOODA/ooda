// # ISO Base Media File Format (ISOBMFF) Box Parser
//
// Logline: Decodes MP4/ISOBMFF recursive box hierarchy ('ftyp', 'moov', 'trak', 'mdat') and 64-bit large box payloads.
//
// Setup: Implements ISO/IEC 14496-12 standard for digital video and audio container atoms and nested tracks.
//
// Beats:
//   1. Parse 8-byte Box header (32-bit size and 4-character FourCC atom type).
//   2. Parse FullBox version and 24-bit flag attributes.
//   3. Validate nested container hierarchy ('moov' -> 'trak' -> 'mdia' -> 'minf' -> 'stbl').

pub type IsomBox = struct {
    fourcc: String,
    box_size: Int,
    header_size: Int, // 8 for standard, 16 for largesize, 12 for FullBox
    payload_offset: Int,
};

pub type IsomFullBox = struct {
    box: IsomBox,
    version: Int,
    flags: Int,
};

// -------------------------------------------------------------------
// Common FourCC Identifiers
// -------------------------------------------------------------------

pub fn isom_box_ftyp() -> String { return "ftyp"; }
pub fn isom_box_moov() -> String { return "moov"; }
pub fn isom_box_mvhd() -> String { return "mvhd"; }
pub fn isom_box_trak() -> String { return "trak"; }
pub fn isom_box_mdat() -> String { return "mdat"; }

// -------------------------------------------------------------------
// Box Parsing & Classification
// -------------------------------------------------------------------

pub fn isom_box_new(fourcc: String, size: Int, offset: Int) -> IsomBox {
    return IsomBox {
        fourcc: fourcc,
        box_size: size,
        header_size: 8,
        payload_offset: offset + 8,
    };
}

pub fn isom_fullbox_new(
    fourcc: String,
    size: Int,
    offset: Int,
    ver: Int,
    flg: Int
) -> IsomFullBox {
    let b: IsomBox = IsomBox {
        fourcc: fourcc,
        box_size: size,
        header_size: 12,
        payload_offset: offset + 12,
    };
    return IsomFullBox {
        box: b,
        version: ver,
        flags: flg,
    };
}

pub fn isom_is_container_box(box: &IsomBox) -> Bool {
    let t: String = (box).fourcc;
    return t == "moov" || t == "trak" || t == "mdia" || t == "minf" || t == "stbl" || t == "edts";
}
