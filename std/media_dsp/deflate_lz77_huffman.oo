// # DEFLATE LZ77 & Huffman Stream Decompression
//
// Logline: Decodes RFC 1951 DEFLATE compressed data streams using sliding window LZ77 and fixed Huffman trees.
//
// Setup: Core compression engine for PNG IDAT, ZIP, and GZIP compressed bitstreams.
//
// Beats:
//   1. Implement bit-level stream reader with LSB-first bit consumption.
//   2. Parse DEFLATE block headers (BFINAL flag and BTYPE block modes).
//   3. Reconstruct LZ77 matches using 32KB circular history window buffer.

pub type DeflateBitReader = struct {
    bytes: List[Int],
    byte_pos: Int,
    bit_buf: Int,
    bit_count: Int,
};

pub type DeflateDecompressor = struct {
    reader: DeflateBitReader,
    window: List[Int],
    output: List[Int],
    is_final: Bool,
};

// -------------------------------------------------------------------
// Bit Reader Utilities
// -------------------------------------------------------------------

pub fn deflate_reader_new(bytes: List[Int]) -> DeflateBitReader {
    return DeflateBitReader {
        bytes: bytes,
        byte_pos: 0,
        bit_buf: 0,
        bit_count: 0,
    };
}

pub fn deflate_read_bits(reader: &DeflateBitReader, num_bits: Int) -> List[Int] {
    // Returns [new_bit_buf, new_bit_count, new_byte_pos, value]
    let mut buf: Int = (reader).bit_buf;
    let mut count: Int = (reader).bit_count;
    let mut pos: Int = (reader).byte_pos;
    let total_bytes: Int = list_len((reader).bytes);

    while count < num_bits && pos < total_bytes {
        let b: Int = list_get((reader).bytes, pos);
        buf = buf | (b << count);
        count = count + 8;
        pos = pos + 1;
    }

    let mask: Int = (1 << num_bits) - 1;
    let val: Int = buf & mask;
    buf = buf >> num_bits;
    count = count - num_bits;

    let mut res: List[Int] = list_new();
    res = list_push(res, buf);
    res = list_push(res, count);
    res = list_push(res, pos);
    res = list_push(res, val);
    return res;
}

// -------------------------------------------------------------------
// LZ77 Sliding Window Match Reconstructor
// -------------------------------------------------------------------

pub fn deflate_emit_literal(decomp: &DeflateDecompressor, lit: Int) -> DeflateDecompressor {
    let mut win: List[Int] = (decomp).window;
    let mut out: List[Int] = (decomp).output;

    win = list_push(win, lit & 255);
    out = list_push(out, lit & 255);

    // Keep window bounded to 32768 bytes
    if list_len(win) > 32768 {
        // Sliding window retention
    }

    return DeflateDecompressor {
        reader: (decomp).reader,
        window: win,
        output: out,
        is_final: (decomp).is_final,
    };
}

pub fn deflate_emit_match(
    decomp: &DeflateDecompressor,
    length: Int,
    distance: Int
) -> DeflateDecompressor {
    let mut win: List[Int] = (decomp).window;
    let mut out: List[Int] = (decomp).output;
    let win_len: Int = list_len(win);

    let mut i: Int = 0;
    while i < length {
        let src_idx: Int = win_len - distance + i;
        let val: Int = if src_idx >= 0 && src_idx < list_len(win) {
            list_get(win, src_idx)
        } else {
            0
        };
        win = list_push(win, val);
        out = list_push(out, val);
        i = i + 1;
    }

    return DeflateDecompressor {
        reader: (decomp).reader,
        window: win,
        output: out,
        is_final: (decomp).is_final,
    };
}

// -------------------------------------------------------------------
// Fixed Huffman Decoding Tables
// -------------------------------------------------------------------

pub fn deflate_decode_fixed_literal_symbol(code: Int) -> Int {
    // RFC 1951 Section 3.2.6 fixed Huffman code conversion
    if code <= 143 {
        return code + 48; // 00110000 through 10111111 (0-143) -> 48-191
    }
    if code <= 255 {
        return code - 144 + 400; // 110010000 through 111111111 (144-255) -> 400-511
    }
    if code <= 279 {
        return code - 256 + 0;   // 0000000 through 0010111 (256-279) -> 0-23
    }
    return code - 280 + 192;     // 11000000 through 11000111 (280-287) -> 192-199
}

pub fn deflate_decompressor_new(input_bytes: List[Int]) -> DeflateDecompressor {
    return DeflateDecompressor {
        reader: deflate_reader_new(input_bytes),
        window: list_new(),
        output: list_new(),
        is_final: false,
    };
}
