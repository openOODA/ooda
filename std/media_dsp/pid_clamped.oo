// # Discrete clamped PID controller
//
// Logline: Steps a PID with setpoint deadband, derivative low-pass filtering, and anti-windup output clamps.
//
// Setup: Pure. dt must be positive. Clamp bounds must satisfy lo < hi.
//
// Beats:
//   1. Treat |error| inside the deadband as zero.
//   2. Low-pass the derivative instead of using raw delta over dt.
//   3. Freeze the integrator when the unsaturated output is outside the clamp.
//   4. Return the clamped command and updated state.

pub type Pid = struct {
    flag: Int,
    err: String,
    kp: Float,
    ki: Float,
    kd: Float,
    dead: Float,
    tau: Float,
    lo: Float,
    hi: Float,
    integ: Float,
    deriv: Float,
    prev_e: Float,
    primed: Int,
    u: Float
};

pub fn pid_clamped_new(kp: Float, ki: Float, kd: Float, dead: Float, tau: Float, lo: Float, hi: Float) -> Pid {
    if lo >= hi {
        return Pid { flag: 0, err: "pid clamp", kp: 0.0, ki: 0.0, kd: 0.0, dead: 0.0, tau: 0.0, lo: 0.0, hi: 0.0, integ: 0.0, deriv: 0.0, prev_e: 0.0, primed: 0, u: 0.0 };
    }
    return Pid { flag: 1, err: "", kp: kp, ki: ki, kd: kd, dead: dead, tau: tau, lo: lo, hi: hi, integ: 0.0, deriv: 0.0, prev_e: 0.0, primed: 0, u: 0.0 };
}

fn pid_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

fn pid_clip(x: Float, lo: Float, hi: Float) -> Float {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

pub fn pid_clamped_step(kp: Float, ki: Float, kd: Float, dead: Float, tau: Float, lo: Float, hi: Float, integ0: Float, deriv0: Float, prev0: Float, primed: Int, sp: Float, y: Float, dt: Float) -> Pid {
    if dt <= 0.0 {
        return Pid { flag: 0, err: "pid dt", kp: kp, ki: ki, kd: kd, dead: dead, tau: tau, lo: lo, hi: hi, integ: integ0, deriv: deriv0, prev_e: prev0, primed: primed, u: 0.0 };
    }
    let mut e: Float = sp - y;
    if pid_abs(e) <= dead {
        e = 0.0;
    }
    let mut deriv: Float = deriv0;
    if primed < 1 {
        deriv = 0.0;
    } else {
        let raw: Float = (e - prev0) / dt;
        let a: Float = dt / (tau + dt);
        deriv = deriv0 + a * (raw - deriv0);
    }
    let trial_i: Float = integ0 + e * dt;
    let unsat: Float = kp * e + ki * trial_i + kd * deriv;
    let mut integ: Float = trial_i;
    if unsat < lo {
        integ = integ0;
    }
    if unsat > hi {
        integ = integ0;
    }
    let u: Float = pid_clip(kp * e + ki * integ + kd * deriv, lo, hi);
    return Pid { flag: 1, err: "", kp: kp, ki: ki, kd: kd, dead: dead, tau: tau, lo: lo, hi: hi, integ: integ, deriv: deriv, prev_e: e, primed: 1, u: u };
}

pub fn pid_clamped_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}
