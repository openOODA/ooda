// # Feedback Comb & Schroeder Allpass Reverb Units
//
// Logline: Implements Schroeder Feedback Comb Filters (FBCF) and Allpass Filters (APF) for acoustic reverberation synthesis.
//
// Setup: Implements Manfred Schroeder and Freeverb acoustic reverberator networks with circular ring delay buffers.
//
// Beats:
//   1. Implement Feedback Comb Filter (FBCF) difference equations with feedback gain and damping.
//   2. Implement Schroeder Allpass Filter (APF) with flat frequency response and phase dispersion.
//   3. Manage circular index wrap-around in fixed-size integer delay buffers.

pub type CombFilter = struct {
    buffer: List[Float],
    buffer_size: Int,
    buffer_index: Int,
    feedback: Float,
    damping: Float,
    filter_store: Float
};

pub type AllpassFilter = struct {
    buffer: List[Float],
    buffer_size: Int,
    buffer_index: Int,
    feedback: Float
};

// -------------------------------------------------------------------
// Comb Filter Implementation
// -------------------------------------------------------------------

pub fn dsp_comb_new(delay_samples: Int, fb: Float, damp: Float) -> CombFilter {
    let mut buf: List[Float] = list_new();
    let mut i: Int = 0;
    while i < delay_samples {
        buf = list_push(buf, 0.0);
        i = i + 1;
    }

    return CombFilter {
        buffer: buf,
        buffer_size: delay_samples,
        buffer_index: 0,
        feedback: fb,
        damping: damp,
        filter_store: 0.0
    };
}

pub fn dsp_comb_process_sample(comb: &CombFilter, input_val: Float) -> List[Float] {
    // Returns [new_index, new_filter_store, output_sample]
    let sz: Int = (comb).buffer_size;
    let idx: Int = (comb).buffer_index;
    let delayed: Float = list_get((comb).buffer, idx);

    let store: Float = (delayed * (1.0 - (comb).damping)) + ((comb).filter_store * (comb).damping);
    let next_store: Float = store;

    let next_idx: Int = if idx + 1 >= sz { 0 } else { idx + 1 };

    let mut res: List[Float] = list_new();
    let mut next_idx_f: Float = 0.0;
    let mut count: Int = next_idx;
    while count >= 1000 { next_idx_f = next_idx_f + 1000.0; count = count - 1000; }
    while count >= 100 { next_idx_f = next_idx_f + 100.0; count = count - 100; }
    while count >= 10 { next_idx_f = next_idx_f + 10.0; count = count - 10; }
    while count >= 1 { next_idx_f = next_idx_f + 1.0; count = count - 1; }

    res = list_push(res, next_idx_f);
    res = list_push(res, next_store);
    res = list_push(res, delayed);
    return res;
}

// -------------------------------------------------------------------
// Schroeder Allpass Filter Implementation
// -------------------------------------------------------------------

pub fn dsp_allpass_new(delay_samples: Int, fb: Float) -> AllpassFilter {
    let mut buf: List[Float] = list_new();
    let mut i: Int = 0;
    while i < delay_samples {
        buf = list_push(buf, 0.0);
        i = i + 1;
    }

    return AllpassFilter {
        buffer: buf,
        buffer_size: delay_samples,
        buffer_index: 0,
        feedback: fb
    };
}
