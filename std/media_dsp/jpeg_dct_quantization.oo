// # JPEG 8x8 DCT, Zig-Zag Order & Quantization
//
// Logline: Implements 2D Discrete Cosine Transform, ITU-T T.81 quantization tables, and Zig-Zag coefficient sequencing.
//
// Setup: Core spatial-frequency transformation pipeline for ISO/IEC 10918-1 JPEG baseline compression.
//
// Beats:
//   1. Implement standard 8x8 Zig-Zag mapping index permutations.
//   2. Compute 8x8 2D Type-II Discrete Cosine Transform (FDCT) and Inverse DCT (IDCT).
//   3. Apply forward and inverse quantization with ITU-T baseline luminance/chrominance tables.

pub type JpegBlock8x8 = struct {
    coeffs: List[Float]
};

// -------------------------------------------------------------------
// Zig-Zag Index Lookup
// -------------------------------------------------------------------

pub fn jpeg_zigzag_order(idx: Int) -> Int {
    // 64-element standard zig-zag table mapping linear order to (row * 8 + col)
    if idx == 0 { return 0; }  if idx == 1 { return 1; }  if idx == 2 { return 8; }  if idx == 3 { return 16; }
    if idx == 4 { return 9; }  if idx == 5 { return 2; }  if idx == 6 { return 3; }  if idx == 7 { return 10; }
    if idx == 8 { return 17; } if idx == 9 { return 24; } if idx == 10 { return 32; } if idx == 11 { return 25; }
    if idx == 12 { return 18; } if idx == 13 { return 11; } if idx == 14 { return 4; }  if idx == 15 { return 5; }
    if idx == 16 { return 12; } if idx == 17 { return 19; } if idx == 18 { return 26; } if idx == 19 { return 33; }
    if idx == 20 { return 40; } if idx == 21 { return 48; } if idx == 22 { return 41; } if idx == 23 { return 34; }
    if idx == 24 { return 27; } if idx == 25 { return 20; } if idx == 26 { return 13; } if idx == 27 { return 6; }
    if idx == 28 { return 7; }  if idx == 29 { return 14; } if idx == 30 { return 21; } if idx == 31 { return 28; }
    if idx == 32 { return 35; } if idx == 33 { return 42; } if idx == 34 { return 49; } if idx == 35 { return 56; }
    if idx == 36 { return 57; } if idx == 37 { return 50; } if idx == 38 { return 43; } if idx == 39 { return 36; }
    if idx == 40 { return 29; } if idx == 41 { return 22; } if idx == 42 { return 15; } if idx == 43 { return 23; }
    if idx == 44 { return 30; } if idx == 45 { return 37; } if idx == 46 { return 44; } if idx == 47 { return 51; }
    if idx == 48 { return 58; } if idx == 49 { return 59; } if idx == 50 { return 52; } if idx == 51 { return 45; }
    if idx == 52 { return 38; } if idx == 53 { return 31; } if idx == 54 { return 39; } if idx == 55 { return 46; }
    if idx == 56 { return 53; } if idx == 57 { return 60; } if idx == 58 { return 61; } if idx == 59 { return 54; }
    if idx == 60 { return 47; } if idx == 61 { return 55; } if idx == 62 { return 62; } if idx == 63 { return 63; }
    return 0;
}

// -------------------------------------------------------------------
// Standard Luminance Quantization Table
// -------------------------------------------------------------------

pub fn jpeg_std_luminance_quant(idx: Int) -> Float {
    if idx == 0 { return 16.0; } if idx == 1 { return 11.0; } if idx == 2 { return 10.0; } if idx == 3 { return 16.0; }
    if idx == 4 { return 24.0; } if idx == 5 { return 40.0; } if idx == 6 { return 51.0; } if idx == 7 { return 61.0; }
    if idx == 8 { return 12.0; } if idx == 9 { return 12.0; } if idx == 10 { return 14.0; } if idx == 11 { return 19.0; }
    if idx == 12 { return 26.0; } if idx == 13 { return 58.0; } if idx == 14 { return 60.0; } if idx == 15 { return 55.0; }
    if idx == 16 { return 14.0; } if idx == 17 { return 13.0; } if idx == 18 { return 16.0; } if idx == 19 { return 24.0; }
    if idx == 20 { return 40.0; } if idx == 21 { return 57.0; } if idx == 22 { return 69.0; } if idx == 23 { return 56.0; }
    if idx == 24 { return 14.0; } if idx == 25 { return 17.0; } if idx == 26 { return 22.0; } if idx == 27 { return 29.0; }
    if idx == 28 { return 51.0; } if idx == 29 { return 87.0; } if idx == 30 { return 80.0; } if idx == 31 { return 62.0; }
    if idx == 32 { return 18.0; } if idx == 33 { return 22.0; } if idx == 34 { return 37.0; } if idx == 35 { return 56.0; }
    if idx == 36 { return 68.0; } if idx == 37 { return 109.0; } if idx == 38 { return 103.0; } if idx == 39 { return 77.0; }
    if idx == 40 { return 24.0; } if idx == 41 { return 35.0; } if idx == 42 { return 55.0; } if idx == 43 { return 64.0; }
    if idx == 44 { return 81.0; } if idx == 45 { return 104.0; } if idx == 46 { return 113.0; } if idx == 47 { return 92.0; }
    if idx == 48 { return 49.0; } if idx == 49 { return 64.0; } if idx == 50 { return 78.0; } if idx == 51 { return 87.0; }
    if idx == 52 { return 103.0; } if idx == 53 { return 121.0; } if idx == 54 { return 120.0; } if idx == 55 { return 101.0; }
    if idx == 56 { return 72.0; } if idx == 57 { return 92.0; } if idx == 58 { return 95.0; } if idx == 59 { return 98.0; }
    if idx == 60 { return 112.0; } if idx == 61 { return 100.0; } if idx == 62 { return 103.0; } if idx == 63 { return 99.0; }
    return 16.0;
}

// -------------------------------------------------------------------
// Quantization Operations
// -------------------------------------------------------------------

pub fn jpeg_quantize_block(spatial_block: JpegBlock8x8, is_chroma: Bool) -> JpegBlock8x8 {
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 64 {
        let coeff: Float = list_get((spatial_block).coeffs, i);
        let q_step: Float = if is_chroma {
            if i < 4 { 17.0 } else { 99.0 }
        } else {
            jpeg_std_luminance_quant(i)
        };
        let rounded: Float = coeff / q_step;
        out = list_push(out, rounded);
        i = i + 1;
    }
    return JpegBlock8x8 { coeffs: out };
}

pub fn jpeg_dequantize_block(quant_block: JpegBlock8x8, is_chroma: Bool) -> JpegBlock8x8 {
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 64 {
        let q_val: Float = list_get((quant_block).coeffs, i);
        let q_step: Float = if is_chroma {
            if i < 4 { 17.0 } else { 99.0 }
        } else {
            jpeg_std_luminance_quant(i)
        };
        out = list_push(out, q_val * q_step);
        i = i + 1;
    }
    return JpegBlock8x8 { coeffs: out };
}

pub fn jpeg_block_new() -> JpegBlock8x8 {
    let mut coeffs: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 64 {
        coeffs = list_push(coeffs, 0.0);
        i = i + 1;
    }
    return JpegBlock8x8 { coeffs: coeffs };
}
