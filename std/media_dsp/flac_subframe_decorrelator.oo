// # FLAC Audio Subframe Predictor & Inter-Channel Decorrelation
//
// Logline: Decodes Free Lossless Audio Codec (FLAC) linear subframe predictor orders (Fixed 0..4, LPC) and Mid/Side stereo channels.
//
// Setup: Implements Xiph.Org FLAC specification for inter-channel decorrelation and polynomial residual reconstruction.
//
// Beats:
//   1. Implement FLAC Fixed predictor polynomial orders (Order 0 through Order 4).
//   2. Decode Mid/Side, Left/Side, and Right/Side channel difference decorrelation modes.
//   3. Reconstruct uncompressed PCM audio sample vectors from predictive residuals.

pub type FlacSubframeHeader = struct {
    subframe_type: Int, // 0=Constant, 1=Verbatim, 2=Fixed, 3=LPC
    predictor_order: Int,
    wasted_bits: Int,
};

pub type FlacStereoPair = struct {
    left_sample: Int,
    right_sample: Int,
};

// -------------------------------------------------------------------
// Fixed Predictor Coefficients
// -------------------------------------------------------------------

pub fn flac_fixed_predict_sample(
    order: Int,
    history: List[Int],
    hist_len: Int
) -> Int {
    if order == 0 {
        return 0;
    }
    if order == 1 {
        // s_hat[i] = s[i-1]
        return if hist_len >= 1 { list_get(history, hist_len - 1) } else { 0 };
    }
    if order == 2 {
        // s_hat[i] = 2*s[i-1] - s[i-2]
        let s1: Int = if hist_len >= 1 { list_get(history, hist_len - 1) } else { 0 };
        let s2: Int = if hist_len >= 2 { list_get(history, hist_len - 2) } else { 0 };
        return (2 * s1) - s2;
    }
    if order == 3 {
        // s_hat[i] = 3*s[i-1] - 3*s[i-2] + s[i-3]
        let s1: Int = if hist_len >= 1 { list_get(history, hist_len - 1) } else { 0 };
        let s2: Int = if hist_len >= 2 { list_get(history, hist_len - 2) } else { 0 };
        let s3: Int = if hist_len >= 3 { list_get(history, hist_len - 3) } else { 0 };
        return (3 * s1) - (3 * s2) + s3;
    }
    if order == 4 {
        // s_hat[i] = 4*s[i-1] - 6*s[i-2] + 4*s[i-3] - s[i-4]
        let s1: Int = if hist_len >= 1 { list_get(history, hist_len - 1) } else { 0 };
        let s2: Int = if hist_len >= 2 { list_get(history, hist_len - 2) } else { 0 };
        let s3: Int = if hist_len >= 3 { list_get(history, hist_len - 3) } else { 0 };
        let s4: Int = if hist_len >= 4 { list_get(history, hist_len - 4) } else { 0 };
        return (4 * s1) - (6 * s2) + (4 * s3) - s4;
    }
    return 0;
}

// -------------------------------------------------------------------
// Inter-Channel Decorrelation Modes
// -------------------------------------------------------------------

pub fn flac_decode_left_side(left: Int, side: Int) -> FlacStereoPair {
    // Right = Left - Side
    return FlacStereoPair {
        left_sample: left,
        right_sample: left - side,
    };
}

pub fn flac_decode_right_side(side: Int, right: Int) -> FlacStereoPair {
    // Left = Side + Right
    return FlacStereoPair {
        left_sample: side + right,
        right_sample: right,
    };
}

pub fn flac_decode_mid_side(mid: Int, side: Int) -> FlacStereoPair {
    // Left = (2*Mid + Side) / 2, Right = (2*Mid - Side) / 2
    let double_mid: Int = mid << 1;
    let adjusted_mid: Int = double_mid | (side & 1);
    let left: Int = (adjusted_mid + side) >> 1;
    let right: Int = (adjusted_mid - side) >> 1;

    return FlacStereoPair {
        left_sample: left,
        right_sample: right,
    };
}

pub fn flac_subframe_header_new(t: Int, ord: Int, wasted: Int) -> FlacSubframeHeader {
    return FlacSubframeHeader {
        subframe_type: t,
        predictor_order: ord,
        wasted_bits: wasted,
    };
}
