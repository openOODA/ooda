// # 1D linear Kalman filter
//
// Logline: Predicts state and covariance then applies the measurement update with Kalman gain.
//
// Setup: Pure. Scalars A, H, Q, R, P, x. dt must be positive. R must be positive.
//
// Beats:
//   1. Predict x := A x and P := A P A + Q.
//   2. Form K := P H / (H P H + R).
//   3. Update x and P from the measurement z.
//   4. Reject dt <= 0 or R <= 0.

pub type Kalman = struct {
    flag: Int,
    err: String,
    x: Float,
    p: Float,
    k: Float
};

fn kf_err(m: String) -> Kalman {
    return Kalman { flag: 0, err: m, x: 0.0, p: 0.0, k: 0.0 };
}

pub fn kalman_filter_1d_new(x: Float, p: Float, r: Float) -> Kalman {
    if r <= 0.0 {
        return kf_err("kalman R");
    }
    if p < 0.0 {
        return kf_err("kalman P");
    }
    return Kalman { flag: 1, err: "", x: x, p: p, k: 0.0 };
}

pub fn kalman_filter_1d_step(x: Float, p: Float, a: Float, h: Float, q: Float, r: Float, z: Float, dt: Float) -> Kalman {
    if dt <= 0.0 {
        return kf_err("kalman dt");
    }
    if r <= 0.0 {
        return kf_err("kalman R");
    }
    if q < 0.0 {
        return kf_err("kalman Q");
    }
    if p < 0.0 {
        return kf_err("kalman P");
    }
    let xp: Float = a * x;
    let pp: Float = a * p * a + q;
    let s: Float = h * pp * h + r;
    if s <= 0.0 {
        return kf_err("kalman S");
    }
    let k: Float = (pp * h) / s;
    let xn: Float = xp + k * (z - h * xp);
    let pn: Float = (1.0 - k * h) * pp;
    return Kalman { flag: 1, err: "", x: xn, p: pn, k: k };
}

pub fn kalman_filter_1d_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}
