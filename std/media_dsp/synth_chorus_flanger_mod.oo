// # Multi-Voice Chorus, Flanger & Vibrato Modulator
//
// Logline: Implements stereophonic multi-voice Chorus, Flanger, and Vibrato effects with quadrature LFO delay modulation.
//
// Setup: Core spatial audio modulation DSP combining fractional delay lines with low-frequency periodic sweep engines.
//
// Beats:
//   1. Implement quadrature (90-degree phase offset) sinusoidal LFO delay sweeps.
//   2. Compute Flanger comb modulation with positive/negative feedback regeneration.
//   3. Blend multi-voice Chorus delay taps for wide stereophonic spatial enhancement.

pub type ChorusVoice = struct {
    base_delay_ms: Float,
    depth_ms: Float,
    lfo_rate_hz: Float,
    lfo_phase: Float,
    feedback: Float
};

pub type StereoModOutput = struct {
    left_sample: Float,
    right_sample: Float
};

// -------------------------------------------------------------------
// Voice Constructor
// -------------------------------------------------------------------

pub fn chorus_voice_new(
    base_d: Float,
    depth: Float,
    rate: Float,
    fb: Float
) -> ChorusVoice {
    return ChorusVoice {
        base_delay_ms: base_d,
        depth_ms: depth,
        lfo_rate_hz: rate,
        lfo_phase: 0.0,
        feedback: fb
    };
}

pub fn chorus_voice_default() -> ChorusVoice {
    return chorus_voice_new(15.0, 3.5, 0.8, 0.2);
}

pub fn flanger_voice_default() -> ChorusVoice {
    return chorus_voice_new(2.0, 1.5, 0.2, 0.7);
}

// -------------------------------------------------------------------
// LFO Sweep Delay Time Calculation
// -------------------------------------------------------------------

pub fn chorus_current_delay_samples(
    voice: &ChorusVoice,
    sample_rate: Float,
    phase_offset_rad: Float
) -> Float {
    let pi: Float = 3.141592653589793;
    let rad: Float = (2.0 * pi * (voice).lfo_phase) + phase_offset_rad;
    let sin_val: Float = rad - (rad * rad * rad * 0.16666667);

    let mod_delay_ms: Float = (voice).base_delay_ms + ((voice).depth_ms * sin_val);
    let ms_to_samples: Float = sample_rate * 0.001;
    return mod_delay_ms * ms_to_samples;
}

pub fn chorus_step_lfo(voice: &ChorusVoice, sample_rate: Float) -> ChorusVoice {
    let dt: Float = (voice).lfo_rate_hz / sample_rate;
    let mut next_phase: Float = (voice).lfo_phase + dt;
    while next_phase >= 1.0 {
        next_phase = next_phase - 1.0;
    }

    return ChorusVoice {
        base_delay_ms: (voice).base_delay_ms,
        depth_ms: (voice).depth_ms,
        lfo_rate_hz: (voice).lfo_rate_hz,
        lfo_phase: next_phase,
        feedback: (voice).feedback
    };
}
