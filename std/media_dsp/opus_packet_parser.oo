// # Opus Audio Packet Table of Contents (TOC) Parser
//
// Logline: Decodes RFC 6716 Opus audio packet TOC byte, Silk/CELT codec modes, bandwidths, frame counts, and durations.
//
// Setup: Implements IETF RFC 6716 interactive speech and audio codec transport packet layout.
//
// Beats:
//   1. Parse 8-bit TOC byte into config number (5 bits), stereo flag (1 bit), and frame count code (2 bits).
//   2. Determine underlying core encoder mode (SILK speech, Hybrid, CELT music/low-delay).
//   3. Compute audio bandwidth (Narrowband, Mediumband, Wideband, Superwideband, Fullband) and frame sizes.

pub type OpusToc = struct {
    config_id: Int,       // 0..31
    is_stereo: Bool,
    frame_count_code: Int,// 0=1 frame, 1=2 equal frames, 2=2 variable frames, 3=arbitrary
    mode: String,         // "SILK", "HYBRID", "CELT"
    bandwidth: String,    // "NB", "MB", "WB", "SWB", "FB"
    frame_duration_ms: Float,
};

// -------------------------------------------------------------------
// Mode & Bandwidth Derivation
// -------------------------------------------------------------------

pub fn opus_parse_toc_byte(toc_byte: Int) -> OpusToc {
    let cfg: Int = (toc_byte >> 3) & 31;
    let stereo: Bool = (toc_byte & 4) != 0;
    let c_code: Int = toc_byte & 3;

    let mut mode_str: String = "SILK";
    let mut bw_str: String = "FB";
    let mut dur: Float = 20.0;

    if cfg <= 11 {
        mode_str = "SILK";
        if cfg <= 3 { bw_str = "NB"; }
        else if cfg <= 7 { bw_str = "MB"; }
        else { bw_str = "WB"; }

        if (cfg & 3) == 0 { dur = 10.0; }
        else if (cfg & 3) == 1 { dur = 20.0; }
        else if (cfg & 3) == 2 { dur = 40.0; }
        else { dur = 60.0; }
    } else if cfg <= 15 {
        mode_str = "HYBRID";
        if cfg <= 13 { bw_str = "SWB"; } else { bw_str = "FB"; }
        dur = if (cfg & 1) == 0 { 10.0 } else { 20.0 };
    } else {
        mode_str = "CELT";
        if cfg <= 19 { bw_str = "NB"; }
        else if cfg <= 23 { bw_str = "WB"; }
        else if cfg <= 27 { bw_str = "SWB"; }
        else { bw_str = "FB"; }

        let rem: Int = cfg & 3;
        if rem == 0 { dur = 2.5; }
        else if rem == 1 { dur = 5.0; }
        else if rem == 2 { dur = 10.0; }
        else { dur = 20.0; }
    }

    return OpusToc {
        config_id: cfg,
        is_stereo: stereo,
        frame_count_code: c_code,
        mode: mode_str,
        bandwidth: bw_str,
        frame_duration_ms: dur,
    };
}
