// # Synthetic Noise Generators (White, Pink & Brown)
//
// Logline: Generates algorithmic White (flat PSD), Pink (1/f Voss-McCartney filter), and Brown (1/f^2 integrated) noise sources.
//
// Setup: Core sound design generator for percussion synthesis, wind/ocean ambient textures, and audio dithering.
//
// Beats:
//   1. Implement 32-bit Xorshift pseudorandom uniform White noise generator.
//   2. Implement Voss-McCartney 3-stage octave accumulator for 1/f Pink noise.
//   3. Implement leaky Brownian random walk integrator for 1/f^2 Brown noise.

pub type NoiseGenerator = struct {
    seed: Int,
    pink_b0: Float,
    pink_b1: Float,
    pink_b2: Float,
    brown_accumulator: Float
};

// -------------------------------------------------------------------
// Xorshift Uniform Random Float [-1.0, 1.0]
// -------------------------------------------------------------------

pub fn synth_xorshift32(seed: Int) -> List[Float] {
    // Returns [new_seed_f, random_float]
    let mut x: Int = seed;
    x = x ^ (x << 13);
    x = x ^ (x >> 17);
    x = x ^ (x << 5);
    if x == 0 { x = 1234567; }

    let norm: Float = 0.0000000004656612875; // 1 / 2^31
    let mut x_f: Float = 0.0;
    let mut count: Int = (x & 2147483647) >> 16;
    while count >= 1000 { x_f = x_f + 1000.0; count = count - 1000; }
    while count >= 100 { x_f = x_f + 100.0; count = count - 100; }
    while count >= 10 { x_f = x_f + 10.0; count = count - 10; }
    while count >= 1 { x_f = x_f + 1.0; count = count - 1; }

    let float_val: Float = (x_f * norm * 65536.0) - 1.0;

    let mut res: List[Float] = list_new();
    let mut new_seed_f: Float = 0.0;
    count = (x & 65535);
    while count >= 1000 { new_seed_f = new_seed_f + 1000.0; count = count - 1000; }
    while count >= 100 { new_seed_f = new_seed_f + 100.0; count = count - 100; }
    while count >= 10 { new_seed_f = new_seed_f + 10.0; count = count - 10; }
    while count >= 1 { new_seed_f = new_seed_f + 1.0; count = count - 1; }

    res = list_push(res, new_seed_f);
    res = list_push(res, float_val);
    return res;
}

// -------------------------------------------------------------------
// Noise Generator Constructor & Steps
// -------------------------------------------------------------------

pub fn synth_noise_generator_new(initial_seed: Int) -> NoiseGenerator {
    return NoiseGenerator {
        seed: if initial_seed != 0 { initial_seed } else { 88888 },
        pink_b0: 0.0,
        pink_b1: 0.0,
        pink_b2: 0.0,
        brown_accumulator: 0.0
    };
}

pub fn synth_noise_pink_step(gen: &NoiseGenerator, white_in: Float) -> List[Float] {
    // Paul Kellet's filter for 3dB/octave pink roll-off
    let b0: Float = (0.99765 * (gen).pink_b0) + (white_in * 0.0990460);
    let b1: Float = (0.96300 * (gen).pink_b1) + (white_in * 0.1606540);
    let b2: Float = (0.57000 * (gen).pink_b2) + (white_in * 0.5670870);
    let pink: Float = (b0 + b1 + b2 + (white_in * 0.5362)) * 0.15;

    let mut res: List[Float] = list_new();
    res = list_push(res, b0);
    res = list_push(res, b1);
    res = list_push(res, b2);
    res = list_push(res, pink);
    return res;
}
