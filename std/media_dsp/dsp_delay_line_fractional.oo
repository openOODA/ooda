// # Fractional Delay Line & Hermite Interpolator
//
// Logline: Implements circular ring buffer delay lines with 1st-order linear and 3rd-order Hermite fractional interpolation.
//
// Setup: Core DSP module for pitch shifting, flanging, chorus, Doppler pitch modulation, and physical modeling.
//
// Beats:
//   1. Implement circular buffer write pointer and read position wrapped calculations.
//   2. Compute 1st-order linear fractional sample interpolation.
//   3. Implement 4-point 3rd-order Hermite polynomial curve interpolation for alias-free delay modulation.

pub type FractionalDelayLine = struct {
    buffer: List[Float],
    max_delay_samples: Int,
    write_index: Int,
};

// -------------------------------------------------------------------
// Delay Line Initializer
// -------------------------------------------------------------------

pub fn dsp_delay_line_new(max_samples: Int) -> FractionalDelayLine {
    let mut buf: List[Float] = list_new();
    let mut i: Int = 0;
    while i < max_samples {
        buf = list_push(buf, 0.0);
        i = i + 1;
    }

    return FractionalDelayLine {
        buffer: buf,
        max_delay_samples: max_samples,
        write_index: 0,
    };
}

// -------------------------------------------------------------------
// Fractional Interpolation
// -------------------------------------------------------------------

pub fn dsp_interpolate_linear(y0: Float, y1: Float, frac: Float) -> Float {
    return ((1.0 - frac) * y0) + (frac * y1);
}

pub fn dsp_interpolate_hermite(
    y_prev: Float,
    y0: Float,
    y1: Float,
    y2: Float,
    frac: Float
) -> Float {
    // 4-point, 3rd-order Hermite interpolation
    let c0: Float = y0;
    let c1: Float = 0.5 * (y1 - y_prev);
    let c2: Float = y_prev - (2.5 * y0) + (2.0 * y1) - (0.5 * y2);
    let c3: Float = (0.5 * (y2 - y_prev)) + (1.5 * (y0 - y1));

    return (((((c3 * frac) + c2) * frac) + c1) * frac) + c0;
}

// -------------------------------------------------------------------
// Delay Read Step
// -------------------------------------------------------------------

pub fn dsp_delay_read_linear(
    delay: &FractionalDelayLine,
    delay_samples: Float
) -> Float {
    let max_sz: Int = (delay).max_delay_samples;
    let mut int_delay: Int = 0;
    let mut d_count: Float = delay_samples;
    while d_count >= 1.0 {
        int_delay = int_delay + 1;
        d_count = d_count - 1.0;
    }
    let frac: Float = d_count;

    let w_idx: Int = (delay).write_index;
    let mut r_idx0: Int = w_idx - int_delay;
    while r_idx0 < 0 { r_idx0 = r_idx0 + max_sz; }
    while r_idx0 >= max_sz { r_idx0 = r_idx0 - max_sz; }

    let mut r_idx1: Int = r_idx0 - 1;
    while r_idx1 < 0 { r_idx1 = r_idx1 + max_sz; }
    while r_idx1 >= max_sz { r_idx1 = r_idx1 - max_sz; }

    let s0: Float = list_get((delay).buffer, r_idx0);
    let s1: Float = list_get((delay).buffer, r_idx1);

    return dsp_interpolate_linear(s0, s1, frac);
}
