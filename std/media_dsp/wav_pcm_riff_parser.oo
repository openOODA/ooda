// # WAV PCM & RIFF Audio Stream Header Parser
//
// Logline: Decodes RIFF/WAVE container chunks, audio format codes (PCM, IEEE float), channel counts, and sample frame layouts.
//
// Setup: Implements Microsoft/IBM Multimedia Programming Interface Resource Interchange File Format (RIFF) WAVE audio.
//
// Beats:
//   1. Parse 12-byte RIFF/WAVE master chunk header and 'fmt ' audio properties subchunk.
//   2. Validate format codes: Linear PCM (1), IEEE 32-bit Float (3), A-Law (6), mu-Law (7).
//   3. Compute sample frame block alignment, data payload sizes, and playback durations.

pub type WavFmtSubchunk = struct {
    audio_format: Int,      // 1 = PCM, 3 = IEEE Float
    num_channels: Int,      // 1 = Mono, 2 = Stereo
    sample_rate: Int,       // e.g., 44100, 48000
    byte_rate: Int,         // sample_rate * num_channels * (bits_per_sample / 8)
    block_align: Int,       // num_channels * (bits_per_sample / 8)
    bits_per_sample: Int,   // 8, 16, 24, 32
};

pub type WavAudioMetadata = struct {
    fmt: WavFmtSubchunk,
    data_chunk_size: Int,
    total_sample_frames: Int,
    duration_seconds: Float,
    is_valid_wav: Bool,
};

// -------------------------------------------------------------------
// Format Code Identifiers
// -------------------------------------------------------------------

pub fn wav_format_pcm() -> Int { return 1; }
pub fn wav_format_ieee_float() -> Int { return 3; }
pub fn wav_format_alaw() -> Int { return 6; }
pub fn wav_format_mulaw() -> Int { return 7; }
pub fn wav_format_extensible() -> Int { return 65534; }

// -------------------------------------------------------------------
// Subchunk Constructors & Metrics
// -------------------------------------------------------------------

pub fn wav_fmt_new(
    format: Int,
    channels: Int,
    rate: Int,
    bits: Int
) -> WavFmtSubchunk {
    let bytes_per_sample: Int = (bits + 7) / 8;
    let align: Int = channels * bytes_per_sample;
    let b_rate: Int = rate * align;

    return WavFmtSubchunk {
        audio_format: format,
        num_channels: channels,
        sample_rate: rate,
        byte_rate: b_rate,
        block_align: align,
        bits_per_sample: bits,
    };
}

pub fn wav_meta_from_fmt(fmt: WavFmtSubchunk, data_bytes: Int) -> WavAudioMetadata {
    let align: Int = (fmt).block_align;
    let safe_align: Int = if align > 0 { align } else { 1 };
    let frames: Int = data_bytes / safe_align;

    let rate: Int = (fmt).sample_rate;
    let mut rate_f: Float = 0.0;
    let mut count: Int = rate;
    while count >= 10000 { rate_f = rate_f + 10000.0; count = count - 10000; }
    while count >= 1000 { rate_f = rate_f + 1000.0; count = count - 1000; }
    while count >= 100 { rate_f = rate_f + 100.0; count = count - 100; }
    while count >= 1 { rate_f = rate_f + 1.0; count = count - 1; }

    let mut frames_f: Float = 0.0;
    count = frames;
    while count >= 100000 { frames_f = frames_f + 100000.0; count = count - 100000; }
    while count >= 10000 { frames_f = frames_f + 10000.0; count = count - 10000; }
    while count >= 1000 { frames_f = frames_f + 1000.0; count = count - 1000; }
    while count >= 100 { frames_f = frames_f + 100.0; count = count - 100; }
    while count >= 1 { frames_f = frames_f + 1.0; count = count - 1; }

    let dur: Float = if rate_f > 0.0 { frames_f / rate_f } else { 0.0 };

    return WavAudioMetadata {
        fmt: fmt,
        data_chunk_size: data_bytes,
        total_sample_frames: frames,
        duration_seconds: dur,
        is_valid_wav: true,
    };
}

pub fn wav_is_supported_pcm(fmt: &WavFmtSubchunk) -> Bool {
    let f: Int = (fmt).audio_format;
    let b: Int = (fmt).bits_per_sample;
    let ch: Int = (fmt).num_channels;

    if f != 1 && f != 3 {
        return false;
    }
    if ch < 1 || ch > 8 {
        return false;
    }
    return b == 8 || b == 16 || b == 24 || b == 32;
}
