// # PNG IHDR and IDAT Stream Processing
//
// Logline: Parses PNG image headers (IHDR), validates color types and dimensions, and orchestrates IDAT chunk payloads.
//
// Setup: Implements ISO/IEC 15948:2004 specification for PNG image metadata, channel depths, and stream defragmentation.
//
// Beats:
//   1. Define PngIhdr header structure, color types (Greyscale, Truecolour, Indexed, Alpha), and channel dimensions.
//   2. Calculate bytes-per-pixel, scanline strides, and total uncompressed image buffer sizes.
//   3. Validate chunk CRC checksums and aggregate sequential IDAT compressed bitstream chunks.

pub type PngIhdr = struct {
    width: Int,
    height: Int,
    bit_depth: Int,
    color_type: Int,
    compression_method: Int,
    filter_method: Int,
    interlace_method: Int
};

pub type PngIdatStream = struct {
    total_chunks: Int,
    total_compressed_bytes: Int,
    chunks_data: List[Int]
};

// -------------------------------------------------------------------
// Color Type Constants
// -------------------------------------------------------------------

pub fn png_color_type_grayscale() -> Int { return 0; }
pub fn png_color_type_rgb() -> Int { return 2; }
pub fn png_color_type_palette() -> Int { return 3; }
pub fn png_color_type_grayscale_alpha() -> Int { return 4; }
pub fn png_color_type_rgba() -> Int { return 6; }

// -------------------------------------------------------------------
// Header Validation & Parsing
// -------------------------------------------------------------------

pub fn png_ihdr_new(
    w: Int,
    h: Int,
    depth: Int,
    color: Int,
    comp: Int,
    filter: Int,
    interlace: Int
) -> PngIhdr {
    return PngIhdr {
        width: w,
        height: h,
        bit_depth: depth,
        color_type: color,
        compression_method: comp,
        filter_method: filter,
        interlace_method: interlace
    };
}

pub fn png_ihdr_is_valid(hdr: &PngIhdr) -> Bool {
    let w: Int = (hdr).width;
    let h: Int = (hdr).height;
    let d: Int = (hdr).bit_depth;
    let c: Int = (hdr).color_type;

    if w <= 0 || h <= 0 {
        return false;
    }
    if (hdr).compression_method != 0 || (hdr).filter_method != 0 {
        return false;
    }
    if (hdr).interlace_method != 0 && (hdr).interlace_method != 1 {
        return false;
    }

    if c == 0 {
        return d == 1 || d == 2 || d == 4 || d == 8 || d == 16;
    }
    if c == 2 {
        return d == 8 || d == 16;
    }
    if c == 3 {
        return d == 1 || d == 2 || d == 4 || d == 8;
    }
    if c == 4 {
        return d == 8 || d == 16;
    }
    if c == 6 {
        return d == 8 || d == 16;
    }
    return false;
}

pub fn png_channels_per_pixel(color_type: Int) -> Int {
    if color_type == 0 { return 1; }
    if color_type == 2 { return 3; }
    if color_type == 3 { return 1; }
    if color_type == 4 { return 2; }
    if color_type == 6 { return 4; }
    return 0;
}

pub fn png_bytes_per_pixel(hdr: &PngIhdr) -> Int {
    let channels: Int = png_channels_per_pixel((hdr).color_type);
    let depth: Int = (hdr).bit_depth;
    if depth >= 8 {
        return channels * (depth / 8);
    }
    // Sub-byte pixels (1, 2, 4 bits per pixel)
    return 1;
}

pub fn png_scanline_stride_bytes(hdr: &PngIhdr) -> Int {
    let w: Int = (hdr).width;
    let channels: Int = png_channels_per_pixel((hdr).color_type);
    let depth: Int = (hdr).bit_depth;
    let total_bits: Int = w * channels * depth;
    let row_bytes: Int = (total_bits + 7) / 8;
    // 1 filter byte prefix + row bytes
    return 1 + row_bytes;
}

pub fn png_uncompressed_raw_size(hdr: &PngIhdr) -> Int {
    let stride: Int = png_scanline_stride_bytes(hdr);
    return stride * (hdr).height;
}

// -------------------------------------------------------------------
// IDAT Stream Aggregation
// -------------------------------------------------------------------

pub fn png_idat_stream_new() -> PngIdatStream {
    return PngIdatStream {
        total_chunks: 0,
        total_compressed_bytes: 0,
        chunks_data: list_new()
    };
}

pub fn png_idat_stream_append(stream: &PngIdatStream, chunk_bytes: List[Int]) -> PngIdatStream {
    let chunk_len: Int = list_len(chunk_bytes);
    let mut acc: List[Int] = (stream).chunks_data;
    let mut i: Int = 0;
    while i < chunk_len {
        acc = list_push(acc, list_get(chunk_bytes, i));
        i = i + 1;
    }
    return PngIdatStream {
        total_chunks: (stream).total_chunks + 1,
        total_compressed_bytes: (stream).total_compressed_bytes + chunk_len,
        chunks_data: acc
    };
}
