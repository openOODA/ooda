// # Chroma Subsampling Resampler & Format Scaler
//
// Logline: Converts between YUV 4:2:0, 4:2:2, and 4:4:4 chroma planes using 2x2 box downsampling and bilinear upsampling.
//
// Setup: Implements digital video subsampling filters conforming to MPEG-2/H.264 chroma sample positioning standards.
//
// Beats:
//   1. Implement 2x2 spatial box filter downsampler from full-resolution 4:4:4 to 4:2:0.
//   2. Implement 2x2 bilinear interpolator upsampling 4:2:0 chroma to 4:4:4.
//   3. Compute memory requirements for 4:2:0, 4:2:2, and 4:4:4 frame buffers.

pub type ChromaDimensions = struct {
    luma_w: Int,
    luma_h: Int,
    chroma_w: Int,
    chroma_h: Int,
    total_bytes: Int,
};

// -------------------------------------------------------------------
// Dimension Calculations
// -------------------------------------------------------------------

pub fn chroma_dimensions_yuv420(width: Int, height: Int) -> ChromaDimensions {
    let cw: Int = (width + 1) / 2;
    let ch: Int = (height + 1) / 2;
    let y_sz: Int = width * height;
    let uv_sz: Int = cw * ch;
    let total: Int = y_sz + (2 * uv_sz);

    return ChromaDimensions {
        luma_w: width,
        luma_h: height,
        chroma_w: cw,
        chroma_h: ch,
        total_bytes: total,
    };
}

pub fn chroma_dimensions_yuv444(width: Int, height: Int) -> ChromaDimensions {
    let y_sz: Int = width * height;
    let total: Int = y_sz * 3;

    return ChromaDimensions {
        luma_w: width,
        luma_h: height,
        chroma_w: width,
        chroma_h: height,
        total_bytes: total,
    };
}

// -------------------------------------------------------------------
// Resampling Arithmetic
// -------------------------------------------------------------------

pub fn chroma_downsample_box_2x2(p00: Int, p01: Int, p10: Int, p11: Int) -> Int {
    // Average 4 pixels in 2x2 block
    let sum: Int = p00 + p01 + p10 + p11 + 2;
    return sum >> 2;
}

pub fn chroma_upsample_bilinear(
    c00: Int, c01: Int, c10: Int, c11: Int,
    fx: Int, fy: Int
) -> Int {
    // fx, fy in range [0..256]
    let inv_fx: Int = 256 - fx;
    let inv_fy: Int = 256 - fy;

    let top: Int = (c00 * inv_fx) + (c01 * fx);
    let bottom: Int = (c10 * inv_fx) + (c11 * fx);

    let val: Int = ((top * inv_fy) + (bottom * fy)) >> 16;
    return val;
}
