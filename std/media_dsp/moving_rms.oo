// # Sliding-window RMS
//
// Logline: Updates root-mean-square energy with an incremental sum of squares instead of a full-window resummation.
//
// Setup: Pure. Capacity must be at least 1. Drop is the outgoing sample when the window is full.
//
// Beats:
//   1. Add x squared to the running sum.
//   2. Subtract the dropped sample squared when the ring is full.
//   3. Return sqrt(sumsq / filled).
//   4. Provide a full-list RMS for the same samples.

pub type RmsOut = struct {
    flag: Int,
    err: String,
    n: Int,
    sumsq: Float,
    rms: Float
};

fn rms_err(m: String) -> RmsOut {
    return RmsOut { flag: 0, err: m, n: 0, sumsq: 0.0, rms: 0.0 };
}

pub fn moving_rms_step(sumsq: Float, filled: Int, cap: Int, x: Float, drop: Float) -> RmsOut {
    if cap < 1 {
        return rms_err("rms cap");
    }
    if filled < 0 {
        return rms_err("rms n");
    }
    let mut s: Float = sumsq + x * x;
    let mut n: Int = filled;
    if filled >= cap {
        s = s - drop * drop;
    } else {
        n = filled + 1;
    }
    if n < 1 {
        return rms_err("rms n");
    }
    if s < 0.0 {
        return rms_err("rms sum");
    }
    let nf: Float = 0.0 + 1.0;
    let mut den: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        den = den + nf;
        i = i + 1;
    }
    return RmsOut { flag: 1, err: "", n: n, sumsq: s, rms: sqrt(s / den) };
}

pub fn moving_rms_of(xs: List[Float]) -> RmsOut {
    let n: Int = list_len(xs);
    if n < 1 {
        return rms_err("rms n");
    }
    let mut s: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let x: Float = list_get(xs, i);
        s = s + x * x;
        i = i + 1;
    }
    let mut den: Float = 0.0;
    i = 0;
    while i < n {
        den = den + 1.0;
        i = i + 1;
    }
    return RmsOut { flag: 1, err: "", n: n, sumsq: s, rms: sqrt(s / den) };
}

pub fn moving_rms_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}
