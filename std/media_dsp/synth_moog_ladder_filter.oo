// # Stilson-Smith 4-Pole Moog Ladder Filter
//
// Logline: Implements 24 dB/octave 4-pole virtual analog Moog transistor ladder filter with non-linear saturation and resonance.
//
// Setup: Implements digital modeling of Robert Moog's 1965 patent ladder filter with 4 cascaded 1-pole integrator stages.
//
// Beats:
//   1. Compute tuned cutoff gain parameter g and resonance feedback factor k.
//   2. Apply rational non-linear hyperbolic tangent (tanh) saturation curves.
//   3. Cascade 4 1-pole leaky integrators with global negative resonance feedback.

pub type MoogLadderFilter = struct {
    cutoff_hz: Float,
    resonance: Float, // [0.0, 1.0] where 1.0 is self-oscillation
    s0: Float,
    s1: Float,
    s2: Float,
    s3: Float,
    sample_rate: Float
};

// -------------------------------------------------------------------
// Non-Linear Saturation Approximation (Fast tanh)
// -------------------------------------------------------------------

pub fn synth_tanh_approx(x: Float) -> Float {
    if x < -3.0 { return -1.0; }
    if x > 3.0 { return 1.0; }
    // Rational Pade approximation for tanh(x)
    let x2: Float = x * x;
    let num: Float = x * (27.0 + x2);
    let den: Float = 27.0 + (9.0 * x2);
    return num / den;
}

// -------------------------------------------------------------------
// Filter Constructor & Processing
// -------------------------------------------------------------------

pub fn moog_filter_new(cutoff: Float, res: Float, sr: Float) -> MoogLadderFilter {
    return MoogLadderFilter {
        cutoff_hz: cutoff,
        resonance: if res < 0.0 { 0.0 } else if res > 1.0 { 1.0 } else { res },
        s0: 0.0,
        s1: 0.0,
        s2: 0.0,
        s3: 0.0,
        sample_rate: if sr > 0.0 { sr } else { 44100.0 }
    };
}

pub fn moog_filter_process_sample(
    filter: &MoogLadderFilter,
    input_x: Float
) -> List[Float] {
    // Returns [new_s0, new_s1, new_s2, new_s3, output_y]
    let pi: Float = 3.141592653589793;
    let sr: Float = (filter).sample_rate;
    let fc: Float = (filter).cutoff_hz;

    // Normalised cutoff frequency
    let mut g: Float = (2.0 * pi * fc) / sr;
    if g > 0.95 { g = 0.95; }
    if g < 0.001 { g = 0.001; }

    let k: Float = 4.0 * (filter).resonance;
    let feedback: Float = k * (filter).s3;
    let u: Float = synth_tanh_approx(input_x - feedback);

    // 4 cascaded 1-pole leaky integrators
    let next_s0: Float = (filter).s0 + (g * (synth_tanh_approx(u) - synth_tanh_approx((filter).s0)));
    let next_s1: Float = (filter).s1 + (g * (synth_tanh_approx(next_s0) - synth_tanh_approx((filter).s1)));
    let next_s2: Float = (filter).s2 + (g * (synth_tanh_approx(next_s1) - synth_tanh_approx((filter).s2)));
    let next_s3: Float = (filter).s3 + (g * (synth_tanh_approx(next_s2) - synth_tanh_approx((filter).s3)));

    let mut res: List[Float] = list_new();
    res = list_push(res, next_s0);
    res = list_push(res, next_s1);
    res = list_push(res, next_s2);
    res = list_push(res, next_s3);
    res = list_push(res, next_s3);
    return res;
}
