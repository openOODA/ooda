// # ITU-T G.711 A-Law and mu-Law Companding Audio Codec
//
// Logline: Converts 16-bit linear PCM audio samples to 8-bit logarithmic G.711 A-law and mu-law telephony companded codes.
//
// Setup: Implements ITU-T Recommendation G.711 Pulse Code Modulation (PCM) of voice frequencies.
//
// Beats:
//   1. Implement 16-bit linear to 8-bit mu-law (PCMU) companding and inverse expansion.
//   2. Implement 16-bit linear to 8-bit A-law (PCMA) companding with 0x55 even-bit inversion.
//   3. Provide high-throughput segment and quant lookup arithmetic.

pub fn g711_linear_to_mulaw(pcm_val: Int) -> Int {
    let mut pcm: Int = pcm_val;
    let mut sign: Int = 0;
    if pcm < 0 {
        sign = 128;
        pcm = 0 - pcm;
    }
    // Clip to 14 bits (8159)
    if pcm > 8159 {
        pcm = 8159;
    }
    pcm = pcm + 132; // BIAS

    // Find segment exponent (3 bits)
    let mut seg: Int = 7;
    if pcm < 256 { seg = 0; }
    else if pcm < 512 { seg = 1; }
    else if pcm < 1024 { seg = 2; }
    else if pcm < 2048 { seg = 3; }
    else if pcm < 4096 { seg = 4; }
    else if pcm < 8192 { seg = 5; }
    else if pcm < 16384 { seg = 6; }

    let quant: Int = (pcm >> (seg + 3)) & 15;
    let u_val: Int = sign | (seg << 4) | quant;
    return u_val ^ 255; // mu-law inverts all bits
}

pub fn g711_mulaw_to_linear(mu_byte: Int) -> Int {
    let u: Int = mu_byte ^ 255;
    let sign: Int = u & 128;
    let seg: Int = (u >> 4) & 7;
    let quant: Int = u & 15;

    let mut t: Int = ((quant << 1) + 33) << seg;
    t = t - 132;

    return if sign != 0 { 0 - t } else { t };
}

pub fn g711_linear_to_alaw(pcm_val: Int) -> Int {
    let mut pcm: Int = pcm_val;
    let mut sign: Int = 0;
    if pcm < 0 {
        sign = 128;
        pcm = 0 - pcm;
    }
    if pcm > 32767 {
        pcm = 32767;
    }

    let mut seg: Int = 7;
    if pcm < 256 { seg = 0; }
    else if pcm < 512 { seg = 1; }
    else if pcm < 1024 { seg = 2; }
    else if pcm < 2048 { seg = 3; }
    else if pcm < 4096 { seg = 4; }
    else if pcm < 8192 { seg = 5; }
    else if pcm < 16384 { seg = 6; }

    let quant: Int = if seg == 0 {
        (pcm >> 4) & 15
    } else {
        (pcm >> (seg + 3)) & 15
    };

    let a_val: Int = sign | (seg << 4) | quant;
    return a_val ^ 85; // A-law inverts even bits (0x55 = 85)
}

pub fn g711_alaw_to_linear(a_byte: Int) -> Int {
    let a: Int = a_byte ^ 85;
    let sign: Int = a & 128;
    let seg: Int = (a >> 4) & 7;
    let quant: Int = a & 15;

    let mut t: Int = 0;
    if seg == 0 {
        t = (quant << 4) + 8;
    } else {
        t = ((quant << 4) + 264) << (seg - 1);
    }

    return if sign != 0 { 0 - t } else { t };
}
