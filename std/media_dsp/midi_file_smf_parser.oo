// # Standard MIDI File (SMF) Header & VLQ Delta Parser
//
// Logline: Decodes Standard MIDI File MThd/MTrk chunks, Variable-Length Quantity (VLQ) delta-times, and MIDI event status bytes.
//
// Setup: Implements MIDI 1.0 Detailed Specification for SMF Format 0/1 polyphonic musical sequence processing.
//
// Beats:
//   1. Parse 14-byte MThd master header (Format 0/1/2, track count, PPQ time division).
//   2. Decode Variable-Length Quantity (VLQ) delta-time byte sequences with 7-bit continuation masking.
//   3. Classify channel voice messages (Note On/Off, Control Change, Pitch Bend) and Meta events.

pub type MidiFileHeader = struct {
    format_type: Int, // 0 = Single track, 1 = Synchronous multi-track, 2 = Asynchronous multi-track
    track_count: Int,
    time_division: Int, // PPQ ticks per quarter note
    is_valid_midi: Bool,
};

pub type MidiEvent = struct {
    delta_time: Int,
    status_byte: Int,
    channel: Int,
    data1: Int,
    data2: Int,
};

// -------------------------------------------------------------------
// VLQ Delta-Time Decoder
// -------------------------------------------------------------------

pub fn midi_decode_vlq(bytes: List[Int], offset: Int) -> List[Int] {
    // Returns [new_offset, delta_value]
    let mut val: Int = 0;
    let mut idx: Int = offset;
    let total: Int = list_len(bytes);

    let mut cont: Bool = true;
    while cont && idx < total {
        let b: Int = list_get(bytes, idx);
        idx = idx + 1;
        val = (val << 7) | (b & 127);
        if (b & 128) == 0 {
            cont = false;
        }
    }

    let mut res: List[Int] = list_new();
    res = list_push(res, idx);
    res = list_push(res, val);
    return res;
}

// -------------------------------------------------------------------
// Header Constructors & Voice Classification
// -------------------------------------------------------------------

pub fn midi_header_new(fmt: Int, tracks: Int, div: Int) -> MidiFileHeader {
    return MidiFileHeader {
        format_type: fmt,
        track_count: tracks,
        time_division: div,
        is_valid_midi: fmt >= 0 && fmt <= 2 && tracks > 0,
    };
}

pub fn midi_event_new(dt: Int, status: Int, d1: Int, d2: Int) -> MidiEvent {
    let ch: Int = status & 15;
    return MidiEvent {
        delta_time: dt,
        status_byte: status,
        channel: ch,
        data1: d1,
        data2: d2,
    };
}

pub fn midi_is_note_on(event: &MidiEvent) -> Bool {
    let s: Int = (event).status_byte & 240;
    return s == 144 && (event).data2 > 0; // 0x90 with velocity > 0
}

pub fn midi_is_note_off(event: &MidiEvent) -> Bool {
    let s: Int = (event).status_byte & 240;
    return s == 128 || (s == 144 && (event).data2 == 0); // 0x80 or Note-On with 0 velocity
}
