// # Second-Order IIR Biquad Digital Filter
//
// Logline: Implements RBJ Audio EQ Cookbook Direct Form II Transposed IIR Biquad filters for Lowpass, Highpass, Bandpass, and Notch modes.
//
// Setup: Canonical 2nd-order Infinite Impulse Response (IIR) difference equation with normalization and state preservation.
//
// Beats:
//   1. Compute Biquad filter normalized feedforward (b0, b1, b2) and feedback (a1, a2) coefficients.
//   2. Implement Direct Form II Transposed single-sample processing step with minimal state registers.
//   3. Provide coefficient generators for Butterworth 2nd-order Lowpass, Highpass, and Notch filters.

pub type BiquadCoefficients = struct {
    b0: Float,
    b1: Float,
    b2: Float,
    a1: Float,
    a2: Float,
};

pub type BiquadFilter = struct {
    coeffs: BiquadCoefficients,
    s1: Float,
    s2: Float,
};

// -------------------------------------------------------------------
// Filter Coefficient Constructors (RBJ Audio EQ Cookbook)
// -------------------------------------------------------------------

pub fn biquad_lowpass(sample_rate: Float, cutoff_hz: Float, q: Float) -> BiquadCoefficients {
    let pi: Float = 3.141592653589793;
    let safe_sr: Float = if sample_rate > 0.0 { sample_rate } else { 44100.0 };
    let w0: Float = (2.0 * pi * cutoff_hz) / safe_sr;

    // Taylor series approximation for sin(w0) and cos(w0)
    let w2: Float = w0 * w0;
    let cos_w0: Float = 1.0 - (w2 * 0.5) + (w2 * w2 * 0.0416666667);
    let sin_w0: Float = w0 - (w0 * w2 * 0.1666666667);

    let safe_q: Float = if q > 0.001 { q } else { 0.7071 };
    let alpha: Float = sin_w0 / (2.0 * safe_q);

    let b0_raw: Float = (1.0 - cos_w0) * 0.5;
    let b1_raw: Float = 1.0 - cos_w0;
    let b2_raw: Float = (1.0 - cos_w0) * 0.5;
    let a0_raw: Float = 1.0 + alpha;
    let a1_raw: Float = 0.0 - (2.0 * cos_w0);
    let a2_raw: Float = 1.0 - alpha;

    return BiquadCoefficients {
        b0: b0_raw / a0_raw,
        b1: b1_raw / a0_raw,
        b2: b2_raw / a0_raw,
        a1: a1_raw / a0_raw,
        a2: a2_raw / a0_raw,
    };
}

pub fn biquad_highpass(sample_rate: Float, cutoff_hz: Float, q: Float) -> BiquadCoefficients {
    let pi: Float = 3.141592653589793;
    let safe_sr: Float = if sample_rate > 0.0 { sample_rate } else { 44100.0 };
    let w0: Float = (2.0 * pi * cutoff_hz) / safe_sr;

    let w2: Float = w0 * w0;
    let cos_w0: Float = 1.0 - (w2 * 0.5) + (w2 * w2 * 0.0416666667);
    let sin_w0: Float = w0 - (w0 * w2 * 0.1666666667);

    let safe_q: Float = if q > 0.001 { q } else { 0.7071 };
    let alpha: Float = sin_w0 / (2.0 * safe_q);

    let b0_raw: Float = (1.0 + cos_w0) * 0.5;
    let b1_raw: Float = 0.0 - (1.0 + cos_w0);
    let b2_raw: Float = (1.0 + cos_w0) * 0.5;
    let a0_raw: Float = 1.0 + alpha;
    let a1_raw: Float = 0.0 - (2.0 * cos_w0);
    let a2_raw: Float = 1.0 - alpha;

    return BiquadCoefficients {
        b0: b0_raw / a0_raw,
        b1: b1_raw / a0_raw,
        b2: b2_raw / a0_raw,
        a1: a1_raw / a0_raw,
        a2: a2_raw / a0_raw,
    };
}

// -------------------------------------------------------------------
// Direct Form II Transposed Sample Processing
// -------------------------------------------------------------------

pub fn biquad_process_sample(filter: &BiquadFilter, x: Float) -> List[Float] {
    // Returns [new_s1, new_s2, y]
    let c: BiquadCoefficients = (filter).coeffs;
    let s1: Float = (filter).s1;
    let s2: Float = (filter).s2;

    let y: Float = ((c).b0 * x) + s1;
    let next_s1: Float = ((c).b1 * x) - ((c).a1 * y) + s2;
    let next_s2: Float = ((c).b2 * x) - ((c).a2 * y);

    let mut res: List[Float] = list_new();
    res = list_push(res, next_s1);
    res = list_push(res, next_s2);
    res = list_push(res, y);
    return res;
}

pub fn biquad_filter_new(coeffs: BiquadCoefficients) -> BiquadFilter {
    return BiquadFilter {
        coeffs: coeffs,
        s1: 0.0,
        s2: 0.0,
    };
}
