// # Windows BMP File & DIB Header Parser
//
// Logline: Decodes Windows Bitmap (BMP) BITMAPFILEHEADER and BITMAPINFOHEADER structures and computes row stride alignment.
//
// Setup: Implements Microsoft Windows DIB bitmap specifications with 4-byte boundary row padding and BI_RGB formats.
//
// Beats:
//   1. Parse 14-byte BITMAPFILEHEADER and 40-byte BITMAPINFOHEADER structures.
//   2. Calculate 4-byte DWORD-aligned scanline row stride and image buffer offsets.
//   3. Handle positive/negative height orientations (bottom-up vs top-down DIB).

pub type BmpFileHeader = struct {
    file_type: Int,      // 0x4D42 ("BM")
    file_size: Int,
    reserved1: Int,
    reserved2: Int,
    pixel_offset: Int
};

pub type BmpDibHeader = struct {
    header_size: Int,    // 40 for BITMAPINFOHEADER
    width: Int,
    height: Int,
    planes: Int,         // must be 1
    bits_per_pixel: Int, // 1, 4, 8, 16, 24, 32
    compression: Int,    // 0 = BI_RGB
    image_size: Int,
    x_pixels_per_m: Int,
    y_pixels_per_m: Int,
    colors_used: Int,
    colors_important: Int
};

pub type BmpImageMeta = struct {
    file_hdr: BmpFileHeader,
    dib_hdr: BmpDibHeader,
    row_stride_bytes: Int,
    is_top_down: Bool,
    total_pixel_count: Int
};

// -------------------------------------------------------------------
// Row Stride & Memory Calculation
// -------------------------------------------------------------------

pub fn bmp_calculate_row_stride(width: Int, bpp: Int) -> Int {
    // Formula: ((width * bpp + 31) / 32) * 4
    let bits: Int = width * bpp;
    let dwords: Int = (bits + 31) / 32;
    return dwords * 4;
}

pub fn bmp_dib_header_new(
    w: Int,
    h: Int,
    bpp: Int,
    comp: Int
) -> BmpDibHeader {
    let abs_h: Int = if h < 0 { 0 - h } else { h };
    let stride: Int = bmp_calculate_row_stride(w, bpp);
    let img_sz: Int = stride * abs_h;

    return BmpDibHeader {
        header_size: 40,
        width: w,
        height: h,
        planes: 1,
        bits_per_pixel: bpp,
        compression: comp,
        image_size: img_sz,
        x_pixels_per_m: 2835, // ~72 DPI
        y_pixels_per_m: 2835,
        colors_used: 0,
        colors_important: 0
    };
}

pub fn bmp_meta_create(
    file_hdr: BmpFileHeader,
    dib_hdr: BmpDibHeader
) -> BmpImageMeta {
    let w: Int = (dib_hdr).width;
    let h: Int = (dib_hdr).height;
    let bpp: Int = (dib_hdr).bits_per_pixel;
    let stride: Int = bmp_calculate_row_stride(w, bpp);
    let is_td: Bool = h < 0;
    let abs_h: Int = if h < 0 { 0 - h } else { h };

    return BmpImageMeta {
        file_hdr: file_hdr,
        dib_hdr: dib_hdr,
        row_stride_bytes: stride,
        is_top_down: is_td,
        total_pixel_count: w * abs_h
    };
}

pub fn bmp_is_supported_format(dib_hdr: &BmpDibHeader) -> Bool {
    let bpp: Int = (dib_hdr).bits_per_pixel;
    let comp: Int = (dib_hdr).compression;
    if comp != 0 {
        return false; // Only uncompressed BI_RGB currently supported
    }
    return bpp == 1 || bpp == 4 || bpp == 8 || bpp == 24 || bpp == 32;
}
