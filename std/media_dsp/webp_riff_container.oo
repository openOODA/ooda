// # WebP Container & VP8X Feature Header Parser
//
// Logline: Decodes WebP RIFF container chunks, VP8/VP8L/VP8X payloads, and extracts alpha channel and animation metadata.
//
// Setup: Implements Google WebP Container Specification based on Resource Interchange File Format (RIFF).
//
// Beats:
//   1. Parse RIFF header framing and FourCC chunk descriptors ('VP8 ', 'VP8L', 'VP8X').
//   2. Extract VP8X extended feature flags (ICC, Alpha, EXIF, XMP, Animation).
//   3. Compute 24-bit canvas dimensions from VP8X extended metadata.

pub type WebpHeader = struct {
    file_size: Int,
    is_valid_webp: Bool,
    format_type: String // "lossy", "lossless", "extended"
};

pub type WebpVp8xFlags = struct {
    has_icc: Bool,
    has_alpha: Bool,
    has_exif: Bool,
    has_xmp: Bool,
    has_animation: Bool,
    canvas_width: Int,
    canvas_height: Int
};

pub type WebpChunk = struct {
    fourcc: String,
    chunk_size: Int,
    payload_offset: Int
};

// -------------------------------------------------------------------
// Feature Flag Extraction
// -------------------------------------------------------------------

pub fn webp_parse_vp8x_flags(
    flags_byte: Int,
    width_24bit: Int,
    height_24bit: Int
) -> WebpVp8xFlags {
    let icc: Bool = (flags_byte & 32) != 0;
    let alpha: Bool = (flags_byte & 16) != 0;
    let exif: Bool = (flags_byte & 8) != 0;
    let xmp: Bool = (flags_byte & 4) != 0;
    let anim: Bool = (flags_byte & 2) != 0;

    return WebpVp8xFlags {
        has_icc: icc,
        has_alpha: alpha,
        has_exif: exif,
        has_xmp: xmp,
        has_animation: anim,
        canvas_width: width_24bit + 1,
        canvas_height: height_24bit + 1
    };
}

pub fn webp_chunk_new(fourcc: String, size: Int, offset: Int) -> WebpChunk {
    return WebpChunk {
        fourcc: fourcc,
        chunk_size: size,
        payload_offset: offset
    };
}

pub fn webp_chunk_padded_size(chunk: &WebpChunk) -> Int {
    let raw_sz: Int = (chunk).chunk_size;
    // RIFF chunks are padded to even 2-byte boundaries
    return if (raw_sz & 1) != 0 { raw_sz + 1 } else { raw_sz };
}

pub fn webp_header_new(sz: Int, fmt: String) -> WebpHeader {
    return WebpHeader {
        file_size: sz,
        is_valid_webp: true,
        format_type: fmt
    };
}
