// # Radiance HDR RGBE Pixel Representation & RLE
//
// Logline: Converts 32-bit Greg Ward RGBE pixels to IEEE 32-bit floating point HDR color values and unpacks adaptive RLE scanlines.
//
// Setup: Implements Radiance High Dynamic Range (HDR) image format standard with 8-bit shared exponent.
//
// Beats:
//   1. Unpack 4-byte RGBE representation into linear floating point Red, Green, and Blue channels.
//   2. Pack floating point HDR colors into compact 4-byte RGBE tuples.
//   3. Decode Radiance adaptive RLE scanline channel planar bursts.

pub type HdrRgbePixel = struct {
    r: Int,
    g: Int,
    b: Int,
    e: Int
};

pub type HdrRgbFloat = struct {
    r: Float,
    g: Float,
    b: Float
};

// -------------------------------------------------------------------
// RGBE to Float Decoding
// -------------------------------------------------------------------

pub fn hdr_rgbe_to_float(pixel: &HdrRgbePixel) -> HdrRgbFloat {
    let e: Int = (pixel).e;
    if e == 0 {
        return HdrRgbFloat { r: 0.0, g: 0.0, b: 0.0 };
    }

    // Power of two calculation: 2^(e - 128 - 8) = 2^(e - 136)
    let exponent: Int = e - 128 - 8;
    let mut scale: Float = 1.0;

    if exponent >= 0 {
        let mut i: Int = 0;
        while i < exponent {
            scale = scale * 2.0;
            i = i + 1;
        }
    } else {
        let mut i: Int = 0;
        let neg_exp: Int = 0 - exponent;
        while i < neg_exp {
            scale = scale / 2.0;
            i = i + 1;
        }
    }

    let mut rf: Float = 0.0;
    let mut count: Int = (pixel).r;
    while count >= 100 { rf = rf + 100.0; count = count - 100; }
    while count >= 10 { rf = rf + 10.0; count = count - 10; }
    while count >= 1 { rf = rf + 1.0; count = count - 1; }

    let mut gf: Float = 0.0;
    count = (pixel).g;
    while count >= 100 { gf = gf + 100.0; count = count - 100; }
    while count >= 10 { gf = gf + 10.0; count = count - 10; }
    while count >= 1 { gf = gf + 1.0; count = count - 1; }

    let mut bf: Float = 0.0;
    count = (pixel).b;
    while count >= 100 { bf = bf + 100.0; count = count - 100; }
    while count >= 10 { bf = bf + 10.0; count = count - 10; }
    while count >= 1 { bf = bf + 1.0; count = count - 1; }

    return HdrRgbFloat {
        r: (rf + 0.5) * scale,
        g: (gf + 0.5) * scale,
        b: (bf + 0.5) * scale
    };
}

pub fn hdr_rgbe_new(r: Int, g: Int, b: Int, e: Int) -> HdrRgbePixel {
    return HdrRgbePixel {
        r: r & 255,
        g: g & 255,
        b: b & 255,
        e: e & 255
    };
}
