// # Ogg Bitstream Framing & Page Lacing Table
//
// Logline: Decodes RFC 3533 Ogg transport bitstream pages, OggS capture framing, granule positions, and lacing values.
//
// Setup: Implements Xiph.Org Ogg bitstream framing specification for multiplexed Vorbis, Opus, and Theora streams.
//
// Beats:
//   1. Parse 27-byte base Ogg page header and 'OggS' 4-byte capture pattern.
//   2. Extract page header flags (Fresh packet, Continued packet, BOS beginning of stream, EOS end of stream).
//   3. Compute segment table length sums and packet boundaries from byte lacing arrays.

pub type OggPageHeader = struct {
    version: Int,
    header_type: Int,      // 0x01 = continued, 0x02 = BOS, 0x04 = EOS
    granule_position: Int, // playback timestamp / sample index
    serial_number: Int,
    page_sequence: Int,
    checksum_crc32: Int,
    page_segments: Int,    // 0..255 segments in segment table
};

pub type OggPageMetadata = struct {
    header: OggPageHeader,
    payload_byte_size: Int,
    is_bos: Bool,
    is_eos: Bool,
    is_continued: Bool,
};

// -------------------------------------------------------------------
// Flag Checking Utilities
// -------------------------------------------------------------------

pub fn ogg_flag_continued() -> Int { return 1; }
pub fn ogg_flag_bos() -> Int { return 2; }
pub fn ogg_flag_eos() -> Int { return 4; }

pub fn ogg_page_header_new(
    htype: Int,
    granule: Int,
    serial: Int,
    seq: Int,
    crc: Int,
    segs: Int
) -> OggPageHeader {
    return OggPageHeader {
        version: 0,
        header_type: htype,
        granule_position: granule,
        serial_number: serial,
        page_sequence: seq,
        checksum_crc32: crc,
        page_segments: segs,
    };
}

pub fn ogg_calculate_payload_size(lacing_table: List[Int]) -> Int {
    let mut total_bytes: Int = 0;
    let n: Int = list_len(lacing_table);
    let mut i: Int = 0;
    while i < n {
        total_bytes = total_bytes + list_get(lacing_table, i);
        i = i + 1;
    }
    return total_bytes;
}

pub fn ogg_page_metadata_build(
    header: OggPageHeader,
    lacing_table: List[Int]
) -> OggPageMetadata {
    let flags: Int = (header).header_type;
    let sz: Int = ogg_calculate_payload_size(lacing_table);

    return OggPageMetadata {
        header: header,
        payload_byte_size: sz,
        is_bos: (flags & 2) != 0,
        is_eos: (flags & 4) != 0,
        is_continued: (flags & 1) != 0,
    };
}
