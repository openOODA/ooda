// # IMA / DVI ADPCM 4-Bit Differential Audio Decoder
//
// Logline: Decodes 4-bit Adaptive Differential Pulse Code Modulation (ADPCM) nibbles into 16-bit linear PCM samples.
//
// Setup: Implements Interactive Multimedia Association (IMA) / DVI ADPCM algorithm with 89-entry step table.
//
// Beats:
//   1. Implement IMA ADPCM 89-entry step size and index adjustment lookup tables.
//   2. Compute 4-bit differential predictor sample delta and sign extension.
//   3. Maintain adaptive quantizer step index within [0, 88] and clamp output to 16-bit boundaries.

pub type ImaAdpcmState = struct {
    predicted_sample: Int,
    step_index: Int
};

// -------------------------------------------------------------------
// Lookup Tables
// -------------------------------------------------------------------

pub fn ima_step_size(idx: Int) -> Int {
    let mut i: Int = idx;
    if i < 0 { i = 0; }
    if i > 88 { i = 88; }

    if i <= 8 {
        if i == 0 { return 7; }   if i == 1 { return 8; }   if i == 2 { return 9; }
        if i == 3 { return 10; }  if i == 4 { return 11; }  if i == 5 { return 12; }
        if i == 6 { return 13; }  if i == 7 { return 14; }  return 16;
    }
    if i <= 20 {
        if i == 9 { return 17; }   if i == 10 { return 19; } if i == 11 { return 21; }
        if i == 12 { return 23; }  if i == 13 { return 25; } if i == 14 { return 28; }
        if i == 15 { return 31; }  if i == 16 { return 34; } if i == 17 { return 37; }
        if i == 18 { return 41; }  if i == 19 { return 45; } return 50;
    }
    // High-amplitude step progression
    if i >= 80 {
        if i == 88 { return 32767; }
        return 20000 + ((i - 80) * 1500);
    }
    return 50 + ((i - 20) * 250);
}

pub fn ima_index_adjust(nibble: Int) -> Int {
    let n: Int = nibble & 7;
    if n <= 3 { return 0 - 1; }
    if n == 4 { return 2; }
    if n == 5 { return 4; }
    if n == 6 { return 6; }
    return 8;
}

// -------------------------------------------------------------------
// ADPCM Decoding Step
// -------------------------------------------------------------------

pub fn ima_decode_nibble(state: &ImaAdpcmState, nibble: Int) -> ImaAdpcmState {
    let step: Int = ima_step_size((state).step_index);
    let mut diff: Int = step >> 3;

    if (nibble & 4) != 0 { diff = diff + step; }
    if (nibble & 2) != 0 { diff = diff + (step >> 1); }
    if (nibble & 1) != 0 { diff = diff + (step >> 2); }

    let mut pred: Int = (state).predicted_sample;
    if (nibble & 8) != 0 {
        pred = pred - diff;
    } else {
        pred = pred + diff;
    }

    // Clamp to 16-bit signed integer [-32768, 32767]
    if pred > 32767 { pred = 32767; }
    if pred < -32768 { pred = -32768; }

    let mut new_idx: Int = (state).step_index + ima_index_adjust(nibble);
    if new_idx < 0 { new_idx = 0; }
    if new_idx > 88 { new_idx = 88; }

    return ImaAdpcmState {
        predicted_sample: pred,
        step_index: new_idx
    };
}

pub fn ima_state_new(sample: Int, index: Int) -> ImaAdpcmState {
    return ImaAdpcmState {
        predicted_sample: sample,
        step_index: index
    };
}
