// # PolyBLEP Anti-Aliased Waveform Oscillator
//
// Logline: Generates bandlimited Sawtooth, Square, Pulse, and Triangle synthesis waveforms using Polynomial Bandlimited Step (PolyBLEP).
//
// Setup: Implements Valimaki and Brandao PolyBLEP anti-aliasing residual corrections for subtractive virtual analog synthesizers.
//
// Beats:
//   1. Implement 2nd-order polynomial PolyBLEP step correction function for phase discontinuities.
//   2. Generate alias-suppressed Sawtooth and variable Pulse-Width Square waveforms.
//   3. Integrate anti-aliased square to synthesize continuous-derivative Triangle waveforms.

pub type PolyBlepOscillator = struct {
    frequency_hz: Float,
    phase: Float,           // [0.0, 1.0)
    pulse_width: Float,     // [0.01, 0.99]
    sample_rate: Float,
};

// -------------------------------------------------------------------
// PolyBLEP Residual Function
// -------------------------------------------------------------------

pub fn synth_poly_blep(t: Float, dt: Float) -> Float {
    if dt <= 0.00001 {
        return 0.0;
    }
    // 0 <= t < dt
    if t < dt {
        let v: Float = t / dt;
        return (v + v) - (v * v) - 1.0;
    }
    // 1 - dt < t <= 1
    if t > (1.0 - dt) {
        let v: Float = (t - 1.0) / dt;
        return (v * v) + (v + v) + 1.0;
    }
    return 0.0;
}

// -------------------------------------------------------------------
// Waveform Generators
// -------------------------------------------------------------------

pub fn synth_osc_saw(osc: &PolyBlepOscillator) -> Float {
    let p: Float = (osc).phase;
    let dt: Float = (osc).frequency_hz / (osc).sample_rate;

    // Naive sawtooth: 2 * phase - 1
    let naive_saw: Float = (2.0 * p) - 1.0;
    let blep: Float = synth_poly_blep(p, dt);
    return naive_saw - blep;
}

pub fn synth_osc_square(osc: &PolyBlepOscillator) -> Float {
    let p: Float = (osc).phase;
    let pw: Float = (osc).pulse_width;
    let dt: Float = (osc).frequency_hz / (osc).sample_rate;

    let naive_sq: Float = if p < pw { 1.0 } else { -1.0 };
    let blep1: Float = synth_poly_blep(p, dt);

    let mut p2: Float = p - pw;
    if p2 < 0.0 { p2 = p2 + 1.0; }
    let blep2: Float = synth_poly_blep(p2, dt);

    return naive_sq + blep1 - blep2;
}

pub fn synth_osc_step(osc: &PolyBlepOscillator) -> PolyBlepOscillator {
    let dt: Float = (osc).frequency_hz / (osc).sample_rate;
    let mut next_phase: Float = (osc).phase + dt;
    while next_phase >= 1.0 {
        next_phase = next_phase - 1.0;
    }

    return PolyBlepOscillator {
        frequency_hz: (osc).frequency_hz,
        phase: next_phase,
        pulse_width: (osc).pulse_width,
        sample_rate: (osc).sample_rate,
    };
}

pub fn synth_oscillator_new(freq: Float, sr: Float) -> PolyBlepOscillator {
    return PolyBlepOscillator {
        frequency_hz: freq,
        phase: 0.0,
        pulse_width: 0.5,
        sample_rate: if sr > 0.0 { sr } else { 44100.0 },
    };
}
