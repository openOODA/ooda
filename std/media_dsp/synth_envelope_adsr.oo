// # 4-Stage ADSR Envelope Generator & Retrigger Engine
//
// Logline: Implements exponential and linear 4-stage Attack-Decay-Sustain-Release (ADSR) envelope state machines for musical synthesizers.
//
// Setup: Canonical modular synthesis dynamic amplitude and filter cutoff contour modulation generator.
//
// Beats:
//   1. Implement ADSR state machine transitions (Idle, Attack, Decay, Sustain, Release).
//   2. Calculate rate increments per sample based on stage durations and sample rate.
//   3. Handle legato key retriggering with smooth continuous level preservation.

pub type AdsrEnvelope = struct {
    attack_time_s: Float,
    decay_time_s: Float,
    sustain_level: Float, // [0.0, 1.0]
    release_time_s: Float,
    current_stage: Int,   // 0=Idle, 1=Attack, 2=Decay, 3=Sustain, 4=Release
    current_level: Float,
    sample_rate: Float
};

// -------------------------------------------------------------------
// Stage State Constants
// -------------------------------------------------------------------

pub fn adsr_stage_idle() -> Int { return 0; }
pub fn adsr_stage_attack() -> Int { return 1; }
pub fn adsr_stage_decay() -> Int { return 2; }
pub fn adsr_stage_sustain() -> Int { return 3; }
pub fn adsr_stage_release() -> Int { return 4; }

// -------------------------------------------------------------------
// Envelope Constructors & Controls
// -------------------------------------------------------------------

pub fn adsr_envelope_new(
    att: Float,
    dec: Float,
    sus: Float,
    rel: Float,
    sr: Float
) -> AdsrEnvelope {
    return AdsrEnvelope {
        attack_time_s: if att > 0.001 { att } else { 0.001 },
        decay_time_s: if dec > 0.001 { dec } else { 0.001 },
        sustain_level: if sus < 0.0 { 0.0 } else if sus > 1.0 { 1.0 } else { sus },
        release_time_s: if rel > 0.001 { rel } else { 0.001 },
        current_stage: 0,
        current_level: 0.0,
        sample_rate: if sr > 0.0 { sr } else { 44100.0 }
    };
}

pub fn adsr_gate_on(env: &AdsrEnvelope) -> AdsrEnvelope {
    return AdsrEnvelope {
        attack_time_s: (env).attack_time_s,
        decay_time_s: (env).decay_time_s,
        sustain_level: (env).sustain_level,
        release_time_s: (env).release_time_s,
        current_stage: 1, // Start Attack
        current_level: (env).current_level,
        sample_rate: (env).sample_rate
    };
}

pub fn adsr_gate_off(env: &AdsrEnvelope) -> AdsrEnvelope {
    return AdsrEnvelope {
        attack_time_s: (env).attack_time_s,
        decay_time_s: (env).decay_time_s,
        sustain_level: (env).sustain_level,
        release_time_s: (env).release_time_s,
        current_stage: 4, // Start Release
        current_level: (env).current_level,
        sample_rate: (env).sample_rate
    };
}

// -------------------------------------------------------------------
// Single-Sample Step Evolution
// -------------------------------------------------------------------

pub fn adsr_process_sample(env: &AdsrEnvelope) -> AdsrEnvelope {
    let stage: Int = (env).current_stage;
    let mut lvl: Float = (env).current_level;
    let mut next_st: Int = stage;
    let sr: Float = (env).sample_rate;

    if stage == 1 {
        // Attack
        let rate: Float = 1.0 / ((env).attack_time_s * sr);
        lvl = lvl + rate;
        if lvl >= 1.0 {
            lvl = 1.0;
            next_st = 2; // Move to Decay
        }
    } else if stage == 2 {
        // Decay
        let target: Float = (env).sustain_level;
        let rate: Float = (1.0 - target) / ((env).decay_time_s * sr);
        lvl = lvl - rate;
        if lvl <= target {
            lvl = target;
            next_st = 3; // Move to Sustain
        }
    } else if stage == 3 {
        // Sustain
        lvl = (env).sustain_level;
    } else if stage == 4 {
        // Release
        let rate: Float = (env).sustain_level / ((env).release_time_s * sr);
        lvl = lvl - rate;
        if lvl <= 0.0 {
            lvl = 0.0;
            next_st = 0; // Move to Idle
        }
    }

    return AdsrEnvelope {
        attack_time_s: (env).attack_time_s,
        decay_time_s: (env).decay_time_s,
        sustain_level: (env).sustain_level,
        release_time_s: (env).release_time_s,
        current_stage: next_st,
        current_level: lvl,
        sample_rate: (env).sample_rate
    };
}
