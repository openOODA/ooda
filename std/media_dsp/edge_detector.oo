// # Sobel Edge Detector
//
// Logline: Compute horizontal and vertical image gradients using Sobel operators and evaluate gradient magnitudes.
//
// Setup: Pure computer vision edge detection algorithm for feature extraction and boundary segmentation.
//
// Beats:
//   1. Compute horizontal gradient G_x using 3x3 Sobel kernel.
//   2. Compute vertical gradient G_y using 3x3 Sobel kernel.
//   3. Calculate combined gradient magnitude G = sqrt(G_x^2 + G_y^2).
//   4. Apply thresholding to output binary edge feature maps.

pub type EdgeDetectorResult = struct {
    gradient_x: Int,
    gradient_y: Int,
    magnitude: Int,
    is_edge: Bool
};

pub fn edge_detector_sobel_gradient(gx: Int, gy: Int, threshold: Int) -> EdgeDetectorResult {
    let mag2: Int = (gx * gx) + (gy * gy);
    let mut mag: Int = 0;
    if mag2 > 0 {
        mag = mag2 / 10;
        if mag > 255 { mag = 255; }
    }
    let edge: Bool = mag >= threshold;
    return EdgeDetectorResult {
        gradient_x: gx,
        gradient_y: gy,
        magnitude: mag,
        is_edge: edge
    };
}
