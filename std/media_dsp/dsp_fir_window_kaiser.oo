// # Kaiser Windowed-Sinc FIR Filter Kernel Generator
//
// Logline: Generates linear-phase Finite Impulse Response (FIR) filter tap weights using the Kaiser-Bessel window and Bessel I0 series.
//
// Setup: Implements digital signal processing windowing theory with parameterizable beta stopband attenuation trade-offs.
//
// Beats:
//   1. Implement 0-th order modified Bessel function of the first kind (I0) power series.
//   2. Compute symmetric Kaiser window weights for tap lengths N and shape parameter beta.
//   3. Multiply ideal sinc impulse response by Kaiser window to create causal linear-phase lowpass kernels.

pub type FirKernel = struct {
    taps: List[Float],
    num_taps: Int
};

// -------------------------------------------------------------------
// Modified Bessel Function I0(x) Series
// -------------------------------------------------------------------

pub fn dsp_bessel_i0(x: Float) -> Float {
    let mut sum: Float = 1.0;
    let mut term: Float = 1.0;
    let x_half: Float = x * 0.5;

    let mut k: Int = 1;
    while k <= 20 {
        let mut k_f: Float = 0.0;
        let mut count: Int = k;
        while count >= 10 { k_f = k_f + 10.0; count = count - 10; }
        while count >= 1 { k_f = k_f + 1.0; count = count - 1; }

        let factor: Float = x_half / k_f;
        term = term * factor * factor;
        sum = sum + term;
        if term < 0.0000001 {
            k = 100; // Break
        }
        k = k + 1;
    }

    return sum;
}

// -------------------------------------------------------------------
// Kaiser Window & Sinc Kernel Generator
// -------------------------------------------------------------------

pub fn dsp_kaiser_weight(n: Int, m_minus_1: Int, beta: Float, i0_beta: Float) -> Float {
    if m_minus_1 <= 0 {
        return 1.0;
    }
    let mut n_f: Float = 0.0;
    let mut count: Int = n;
    while count >= 100 { n_f = n_f + 100.0; count = count - 100; }
    while count >= 10 { n_f = n_f + 10.0; count = count - 10; }
    while count >= 1 { n_f = n_f + 1.0; count = count - 1; }

    let mut m_f: Float = 0.0;
    count = m_minus_1;
    while count >= 100 { m_f = m_f + 100.0; count = count - 100; }
    while count >= 10 { m_f = m_f + 10.0; count = count - 10; }
    while count >= 1 { m_f = m_f + 1.0; count = count - 1; }

    let val: Float = (2.0 * n_f / m_f) - 1.0;
    let arg_sq: Float = 1.0 - (val * val);
    let safe_sq: Float = if arg_sq > 0.0 { arg_sq } else { 0.0 };

    let i0_val: Float = dsp_bessel_i0(beta * sqrt(safe_sq));
    let safe_i0_b: Float = if i0_beta > 0.0001 { i0_beta } else { 1.0 };
    return i0_val / safe_i0_b;
}

pub fn dsp_fir_lowpass_kaiser(num_taps: Int, cutoff_ratio: Float, beta: Float) -> FirKernel {
    let mut taps: List[Float] = list_new();
    let i0_b: Float = dsp_bessel_i0(beta);
    let pi: Float = 3.141592653589793;

    let mut n_taps_f: Float = 0.0;
    let mut count: Int = num_taps;
    while count >= 100 { n_taps_f = n_taps_f + 100.0; count = count - 100; }
    while count >= 10 { n_taps_f = n_taps_f + 10.0; count = count - 10; }
    while count >= 1 { n_taps_f = n_taps_f + 1.0; count = count - 1; }

    let center: Float = (n_taps_f - 1.0) * 0.5;

    let mut i: Int = 0;
    while i < num_taps {
        let mut i_f: Float = 0.0;
        count = i;
        while count >= 100 { i_f = i_f + 100.0; count = count - 100; }
        while count >= 10 { i_f = i_f + 10.0; count = count - 10; }
        while count >= 1 { i_f = i_f + 1.0; count = count - 1; }

        let diff: Float = i_f - center;
        let sinc: Float = if diff > -0.0001 && diff < 0.0001 {
            2.0 * cutoff_ratio
        } else {
            let arg: Float = 2.0 * pi * cutoff_ratio * diff;
            let sin_val: Float = arg - (arg * arg * arg * 0.166666667);
            sin_val / (pi * diff)
        };

        let w: Float = dsp_kaiser_weight(i, num_taps - 1, beta, i0_b);
        taps = list_push(taps, sinc * w);
        i = i + 1;
    }

    return FirKernel {
        taps: taps,
        num_taps: num_taps
    };
}
