// # Block Overlap-Add (OLA) Fast Convolution Engine
//
// Logline: Implements Overlap-Add (OLA) partitioned convolution for real-time impulse response and reverberation processing.
//
// Setup: Standard DSP block partitioned convolution method avoiding cyclic boundary aliasing in frequency-domain filtering.
//
// Beats:
//   1. Define OverlapAddEngine with block length L, kernel length M, and accumulation buffer.
//   2. Compute direct discrete time convolution: `y[n] = sum(x[k] * h[n-k])`.
//   3. Accumulate overlap tails across sequential audio streaming buffer blocks.

pub type OverlapAddEngine = struct {
    block_length_l: Int,
    kernel_length_m: Int,
    overlap_buffer: List[Float],
    is_active: Bool
};

// -------------------------------------------------------------------
// Direct Time-Domain Convolution Step
// -------------------------------------------------------------------

pub fn dsp_convolve_direct(
    signal_x: List[Float],
    kernel_h: List[Float]
) -> List[Float] {
    let len_x: Int = list_len(signal_x);
    let len_h: Int = list_len(kernel_h);
    let out_len: Int = len_x + len_h - 1;

    let mut out: List[Float] = list_new();
    let mut n: Int = 0;
    while n < out_len {
        let mut acc: Float = 0.0;
        let mut k: Int = 0;
        while k < len_h {
            let x_idx: Int = n - k;
            if x_idx >= 0 && x_idx < len_x {
                let x_val: Float = list_get(signal_x, x_idx);
                let h_val: Float = list_get(kernel_h, k);
                acc = acc + (x_val * h_val);
            }
            k = k + 1;
        }
        out = list_push(out, acc);
        n = n + 1;
    }

    return out;
}

// -------------------------------------------------------------------
// Overlap-Add Buffer Accumulator
// -------------------------------------------------------------------

pub fn dsp_ola_engine_new(block_l: Int, kernel_m: Int) -> OverlapAddEngine {
    let overlap_sz: Int = kernel_m - 1;
    let mut buf: List[Float] = list_new();
    let mut i: Int = 0;
    while i < overlap_sz {
        buf = list_push(buf, 0.0);
        i = i + 1;
    }

    return OverlapAddEngine {
        block_length_l: block_l,
        kernel_length_m: kernel_m,
        overlap_buffer: buf,
        is_active: true
    };
}
