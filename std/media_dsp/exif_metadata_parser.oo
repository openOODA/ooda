// # EXIF / TIFF Tag Directory Metadata Parser
//
// Logline: Decodes TIFF/EXIF Image File Directories (IFD), endianness headers, and camera exposure/orientation metadata tags.
//
// Setup: Implements JEITA CP-3451 EXIF 2.3 standard with Little-Endian (II) and Big-Endian (MM) stream compatibility.
//
// Beats:
//   1. Parse 8-byte TIFF header (byte alignment marker 'II'/'MM' and magic 0x002A).
//   2. Decode 12-byte IFD tag entries (Tag ID, Field Type, Count, Value/Offset).
//   3. Extract standard photography metadata (Image Orientation 1..8, ISO speed, Exposure Time).

pub type ExifHeader = struct {
    is_little_endian: Bool,
    first_ifd_offset: Int,
    is_valid: Bool
};

pub type ExifTagEntry = struct {
    tag_id: Int,
    field_type: Int, // 1=BYTE, 2=ASCII, 3=SHORT, 4=LONG, 5=RATIONAL
    count: Int,
    value_or_offset: Int
};

pub type ExifPhotoMetadata = struct {
    orientation: Int,      // Tag 0x0112 (1..8)
    image_width: Int,      // Tag 0x0100
    image_height: Int,     // Tag 0x0101
    iso_speed: Int,        // Tag 0x8827
    has_exif_data: Bool
};

// -------------------------------------------------------------------
// Tag Constants
// -------------------------------------------------------------------

pub fn exif_tag_image_width() -> Int { return 256; }         // 0x0100
pub fn exif_tag_image_height() -> Int { return 257; }        // 0x0101
pub fn exif_tag_orientation() -> Int { return 274; }         // 0x0112
pub fn exif_tag_iso_speed() -> Int { return 34855; }         // 0x8827
pub fn exif_tag_exposure_time() -> Int { return 33434; }     // 0x829A
pub fn exif_tag_f_number() -> Int { return 33437; }          // 0x829D

// -------------------------------------------------------------------
// Tag Constructors & Utilities
// -------------------------------------------------------------------

pub fn exif_tag_entry_new(
    id: Int,
    f_type: Int,
    cnt: Int,
    val_off: Int
) -> ExifTagEntry {
    return ExifTagEntry {
        tag_id: id,
        field_type: f_type,
        count: cnt,
        value_or_offset: val_off
    };
}

pub fn exif_metadata_default() -> ExifPhotoMetadata {
    return ExifPhotoMetadata {
        orientation: 1, // Normal top-left
        image_width: 0,
        image_height: 0,
        iso_speed: 100,
        has_exif_data: false
    };
}

pub fn exif_orientation_description(orientation: Int) -> String {
    if orientation == 1 { return "TopLeft"; }
    if orientation == 3 { return "BottomRight"; }
    if orientation == 6 { return "RightTop_Rotate90CW"; }
    if orientation == 8 { return "LeftBottom_Rotate270CW"; }
    return "Custom_Or_Flipped";
}
