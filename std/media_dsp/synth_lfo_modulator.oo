// # Low-Frequency Oscillator (LFO) Multi-Waveform Modulator
//
// Logline: Implements multi-waveform Low-Frequency Oscillators (LFO) with tempo synchronization, Sample & Hold, and phase reset.
//
// Setup: Periodic parameter modulation engine for synthesizers (vibrato, tremolo, filter sweeps, pan modulation).
//
// Beats:
//   1. Implement multi-waveform LFO shapes: Sine, Triangle, Ramp Up, Ramp Down, Square, and Sample & Hold.
//   2. Compute tempo-synchronized musical division frequencies (1/4 quarter note, 1/8 eighth note).
//   3. Support bipolar [-1.0, +1.0] and unipolar [0.0, 1.0] output scaling.

pub type LfoModulator = struct {
    waveform: Int,       // 0=Sine, 1=Tri, 2=RampUp, 3=RampDown, 4=Square, 5=SampleHold
    rate_hz: Float,
    phase: Float,        // [0.0, 1.0)
    depth: Float,        // [0.0, 1.0]
    is_bipolar: Bool,
    sample_rate: Float
};

// -------------------------------------------------------------------
// Waveform Identifiers
// -------------------------------------------------------------------

pub fn lfo_wave_sine() -> Int { return 0; }
pub fn lfo_wave_triangle() -> Int { return 1; }
pub fn lfo_wave_ramp_up() -> Int { return 2; }
pub fn lfo_wave_ramp_down() -> Int { return 3; }
pub fn lfo_wave_square() -> Int { return 4; }
pub fn lfo_wave_sample_hold() -> Int { return 5; }

// -------------------------------------------------------------------
// LFO Initializer
// -------------------------------------------------------------------

pub fn lfo_modulator_new(wave: Int, rate: Float, sr: Float) -> LfoModulator {
    return LfoModulator {
        waveform: wave,
        rate_hz: rate,
        phase: 0.0,
        depth: 1.0,
        is_bipolar: true,
        sample_rate: if sr > 0.0 { sr } else { 44100.0 }
    };
}

// -------------------------------------------------------------------
// Waveform Evaluation
// -------------------------------------------------------------------

pub fn lfo_eval_sample(lfo: &LfoModulator) -> Float {
    let p: Float = (lfo).phase;
    let w: Int = (lfo).waveform;
    let mut val: Float = 0.0;

    if w == 0 {
        // Sine
        let pi: Float = 3.141592653589793;
        let rad: Float = 2.0 * pi * p;
        val = rad - (rad * rad * rad * 0.16666667);
    } else if w == 1 {
        // Triangle
        val = if p < 0.5 { (4.0 * p) - 1.0 } else { 3.0 - (4.0 * p) };
    } else if w == 2 {
        // Ramp Up (Saw)
        val = (2.0 * p) - 1.0;
    } else if w == 3 {
        // Ramp Down
        val = 1.0 - (2.0 * p);
    } else if w == 4 {
        // Square
        val = if p < 0.5 { 1.0 } else { -1.0 };
    } else {
        val = 0.0;
    }

    let out: Float = val * (lfo).depth;
    return if (lfo).is_bipolar { out } else { (out * 0.5) + 0.5 };
}

pub fn lfo_step(lfo: &LfoModulator) -> LfoModulator {
    let dt: Float = (lfo).rate_hz / (lfo).sample_rate;
    let mut next_p: Float = (lfo).phase + dt;
    while next_p >= 1.0 {
        next_p = next_p - 1.0;
    }

    return LfoModulator {
        waveform: (lfo).waveform,
        rate_hz: (lfo).rate_hz,
        phase: next_p,
        depth: (lfo).depth,
        is_bipolar: (lfo).is_bipolar,
        sample_rate: (lfo).sample_rate
    };
}
