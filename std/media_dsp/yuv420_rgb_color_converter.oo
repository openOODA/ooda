// # YUV 4:2:0 to RGB24 Color Space Matrix Transformation
//
// Logline: Converts planar YUV 4:2:0 video frames to interleaved RGB24 pixels using ITU-R BT.601 and BT.709 color matrices.
//
// Setup: Implements full-range and studio-swing YCbCr to sRGB conversion matrices with chroma subsampling indexing.
//
// Beats:
//   1. Implement ITU-R BT.601 (SDTV) studio-swing YUV-to-RGB matrix equations.
//   2. Implement ITU-R BT.709 (HDTV) high-definition matrix equations.
//   3. Compute planar 4:2:0 subsampled chroma plane (U/V) memory offsets: `(y / 2) * (width / 2) + (x / 2)`.

pub type RgbColor = struct {
    r: Int,
    g: Int,
    b: Int,
};

// -------------------------------------------------------------------
// Pixel Clamping Helper
// -------------------------------------------------------------------

pub fn yuv_clamp_byte(val: Int) -> Int {
    if val < 0 { return 0; }
    if val > 255 { return 255; }
    return val;
}

// -------------------------------------------------------------------
// BT.601 Color Conversion
// -------------------------------------------------------------------

pub fn yuv_to_rgb_bt601(y_val: Int, u_val: Int, v_val: Int) -> RgbColor {
    // Fixed-point integer arithmetic (scaled by 1024)
    // C = Y - 16, D = U - 128, E = V - 128
    let c: Int = y_val - 16;
    let d: Int = u_val - 128;
    let e: Int = v_val - 128;

    let r_scaled: Int = (298 * c) + (409 * e) + 128;
    let g_scaled: Int = (298 * c) - (100 * d) - (208 * e) + 128;
    let b_scaled: Int = (298 * c) + (516 * d) + 128;

    return RgbColor {
        r: yuv_clamp_byte(r_scaled >> 8),
        g: yuv_clamp_byte(g_scaled >> 8),
        b: yuv_clamp_byte(b_scaled >> 8),
    };
}

// -------------------------------------------------------------------
// BT.709 HDTV Color Conversion
// -------------------------------------------------------------------

pub fn yuv_to_rgb_bt709(y_val: Int, u_val: Int, v_val: Int) -> RgbColor {
    let c: Int = y_val - 16;
    let d: Int = u_val - 128;
    let e: Int = v_val - 128;

    let r_scaled: Int = (298 * c) + (459 * e) + 128;
    let g_scaled: Int = (298 * c) - (55 * d) - (136 * e) + 128;
    let b_scaled: Int = (298 * c) + (541 * d) + 128;

    return RgbColor {
        r: yuv_clamp_byte(r_scaled >> 8),
        g: yuv_clamp_byte(g_scaled >> 8),
        b: yuv_clamp_byte(b_scaled >> 8),
    };
}

// -------------------------------------------------------------------
// 4:2:0 Chroma Plane Offset Calculator
// -------------------------------------------------------------------

pub fn yuv420_chroma_offset(x: Int, y: Int, width: Int) -> Int {
    let chroma_x: Int = x >> 1;
    let chroma_y: Int = y >> 1;
    let chroma_w: Int = width >> 1;
    return (chroma_y * chroma_w) + chroma_x;
}
