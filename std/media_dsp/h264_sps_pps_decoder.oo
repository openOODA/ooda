// # H.264 SPS / PPS Sequence Parameter Set Decoder
//
// Logline: Decodes H.264 Sequence/Picture Parameter Sets, Exponential-Golomb bitstream codes, and frame resolutions.
//
// Setup: Implements ITU-T H.264 Section 7.3.2 syntax table parsing for macroblock video geometry extraction.
//
// Beats:
//   1. Implement Unsigned Exponential-Golomb ue(v) and Signed se(v) entropy decoders.
//   2. Parse SPS profile_idc (Baseline 66, Main 77, High 100) and constraint flags.
//   3. Compute video pixel width and height from macroblock map unit dimensions.

pub type H264Sps = struct {
    profile_idc: Int,
    level_idc: Int,
    sps_id: Int,
    pic_width_in_mbs_minus1: Int,
    pic_height_in_map_units_minus1: Int,
    frame_mbs_only_flag: Int,
    pixel_width: Int,
    pixel_height: Int
};

pub type H264Pps = struct {
    pps_id: Int,
    sps_id: Int,
    entropy_coding_mode_flag: Int, // 0 = CAVLC, 1 = CABAC
    num_slice_groups_minus1: Int,
    num_ref_idx_l0_default_active_minus1: Int,
    num_ref_idx_l1_default_active_minus1: Int
};

// -------------------------------------------------------------------
// Exp-Golomb Bitstream Decoding
// -------------------------------------------------------------------

pub fn h264_decode_ue_golomb(leading_zeros: Int, suffix_bits: Int) -> Int {
    // Formula: (2^leading_zeros - 1) + suffix_bits
    let mut base: Int = 1;
    let mut i: Int = 0;
    while i < leading_zeros {
        base = base << 1;
        i = i + 1;
    }
    return (base - 1) + suffix_bits;
}

pub fn h264_decode_se_golomb(ue_val: Int) -> Int {
    // Signed mapping: (-1)^(k+1) * ceil(k / 2)
    let sign: Int = if (ue_val & 1) != 0 { 1 } else { 0 - 1 };
    let mag: Int = (ue_val + 1) >> 1;
    return sign * mag;
}

// -------------------------------------------------------------------
// SPS Constructor & Resolution Calculation
// -------------------------------------------------------------------

pub fn h264_sps_new(
    profile: Int,
    level: Int,
    sps_id: Int,
    w_mbs_minus1: Int,
    h_units_minus1: Int,
    mbs_only: Int
) -> H264Sps {
    let width_px: Int = (w_mbs_minus1 + 1) * 16;
    let mult: Int = if mbs_only != 0 { 1 } else { 2 };
    let height_px: Int = (h_units_minus1 + 1) * 16 * mult;

    return H264Sps {
        profile_idc: profile,
        level_idc: level,
        sps_id: sps_id,
        pic_width_in_mbs_minus1: w_mbs_minus1,
        pic_height_in_map_units_minus1: h_units_minus1,
        frame_mbs_only_flag: mbs_only,
        pixel_width: width_px,
        pixel_height: height_px
    };
}

pub fn h264_pps_new(pps_id: Int, sps_id: Int, cabac: Int) -> H264Pps {
    return H264Pps {
        pps_id: pps_id,
        sps_id: sps_id,
        entropy_coding_mode_flag: cabac,
        num_slice_groups_minus1: 0,
        num_ref_idx_l0_default_active_minus1: 0,
        num_ref_idx_l1_default_active_minus1: 0
    };
}
