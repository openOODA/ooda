// # Extended Kalman Filter (EKF) State & Covariance Structures
//
// Logline: Defines state vectors, covariance matrices, and innovation residuals for non-linear Kalman filtering.
//
// Setup: Pure robotics state estimation data structures with zero struct trailing commas.
//
// Beats:
//   1. Define EkfConfig holding state dimension n and measurement dimension m.
//   2. Define EkfState maintaining estimated state vector x and covariance matrix P.
//   3. Define EkfStepResult returning updated state, updated covariance, and innovation vector.

pub type EkfConfig = struct {
    state_dim: Int,
    obs_dim: Int
};

pub type EkfState = struct {
    x: List[Float],
    p_cov: List[Float],
    state_dim: Int
};

pub type EkfStepResult = struct {
    x_hat: List[Float],
    innovation: List[Float],
    is_converged: Bool
};
