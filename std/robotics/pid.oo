// # Discrete PID Controller with Anti-Windup Clamping
//
// Logline: Implements discrete-time PID feedback control with integral anti-windup and derivative filtering.
//
// Setup: Pure robotics control loop executing stable actuator command synthesis.
//
// Beats:
//   1. Calculate proportional error term: P = Kp * e(t).
//   2. Compute trapezoidal numerical integration of error with anti-windup clamping.
//   3. Compute discrete derivative of error: D = Kd * (e(t) - e(t-1)) / dt.
//   4. Clamp combined control output to [output_min, output_max] actuator limits.

import "./pid_types.oo";

/// Initialize a new PID controller state.
pub fn pid_controller_new(cfg: PidConfig, initial_setpoint: Float) -> Result[PidState, String] {
    if (cfg).output_min >= (cfg).output_max {
        return Err("ERR\tpid_new: output_min must be strictly less than output_max");
    }
    return Ok(PidState {
        config: cfg,
        setpoint: initial_setpoint,
        prev_error: 0.0,
        integral: 0.0
    });
}

/// Update PID controller step with measurement and elapsed time dt.
pub fn pid_controller_update(state: PidState, measurement: Float, dt: Float) -> Result[PidOutput, String] {
    if dt <= 0.0 {
        return Err("ERR\tpid_update: dt must be strictly positive");
    }
    let error: Float = (state).setpoint - measurement;

    // 1. Proportional term
    let p_term: Float = ((state).config).kp * error;

    // 2. Integral term with anti-windup
    let mut next_integral: Float = (state).integral + error * dt;
    let i_term: Float = ((state).config).ki * next_integral;

    // 3. Derivative term
    let d_term: Float = ((state).config).kd * (error - (state).prev_error) / dt;

    // 4. Raw control output
    let mut u: Float = p_term + i_term + d_term;
    let mut is_sat: Bool = false;

    let min_lim: Float = ((state).config).output_min;
    let max_lim: Float = ((state).config).output_max;

    if u > max_lim {
        u = max_lim;
        is_sat = true;
        if ((state).config).anti_windup_enabled {
            next_integral = (state).integral; // Freeze integral
        }
    } else if u < min_lim {
        u = min_lim;
        is_sat = true;
        if ((state).config).anti_windup_enabled {
            next_integral = (state).integral; // Freeze integral
        }
    }

    return Ok(PidOutput {
        control_output: u,
        p_term: p_term,
        i_term: i_term,
        d_term: d_term,
        is_saturated: is_sat
    });
}
