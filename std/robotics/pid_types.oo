// # Discrete PID Controller Configuration & State Structures
//
// Logline: Defines PID gains (Kp, Ki, Kd), anti-windup saturation limits, low-pass filter constants, and controller state.
//
// Setup: Pure robotics control systems data types with zero struct trailing commas.
//
// Beats:
//   1. Define PidConfig with proportional, integral, derivative gains and output bounds.
//   2. Define PidState maintaining integral error accumulator and previous derivative/error records.
//   3. Define PidOutput with individual P, I, D term contributions and saturation flags.

pub type PidConfig = struct {
    kp: Float,
    ki: Float,
    kd: Float,
    output_min: Float,
    output_max: Float,
    anti_windup_enabled: Bool
};

pub type PidState = struct {
    config: PidConfig,
    setpoint: Float,
    prev_error: Float,
    integral: Float
};

pub type PidOutput = struct {
    control_output: Float,
    p_term: Float,
    i_term: Float,
    d_term: Float,
    is_saturated: Bool
};
