// # Columnar Vector Storage & Type Invariants
//
// Logline: Implements strongly-typed columnar array vectors (Int, Float, String, Bool) with validity bitmasks.
//
// Setup: Pure columnar data structures providing contiguous typed memory layout for analytical queries.
//
// Beats:
//   1. Define ColumnInt, ColumnFloat, ColumnString, and ColumnBool typed vector buffers.
//   2. Define universal Column container with dynamic type dispatch.
//   3. Track boolean nullability validity masks for each element.
//   4. Append, access, and slice columnar array vectors.

pub type ColumnInt = struct {
    name: String,
    values: List[Int],
    is_null: List[Bool],
    len: Int
};

pub type ColumnFloat = struct {
    name: String,
    values: List[Float],
    is_null: List[Bool],
    len: Int
};

pub type ColumnString = struct {
    name: String,
    values: List[String],
    is_null: List[Bool],
    len: Int
};

pub type Column = struct {
    name: String,
    dtype: Int,
    int_col: ColumnInt,
    float_col: ColumnFloat,
    str_col: ColumnString,
    len: Int
};

pub fn empty_column_int() -> ColumnInt {
    let empty_vals: List[Int] = list_new();
    let empty_null: List[Bool] = list_new();
    return ColumnInt {
        name: "",
        values: empty_vals,
        is_null: empty_null,
        len: 0
    };
}

pub fn empty_column_float() -> ColumnFloat {
    let empty_vals: List[Float] = list_new();
    let empty_null: List[Bool] = list_new();
    return ColumnFloat {
        name: "",
        values: empty_vals,
        is_null: empty_null,
        len: 0
    };
}

pub fn empty_column_string() -> ColumnString {
    let empty_vals: List[String] = list_new();
    let empty_null: List[Bool] = list_new();
    return ColumnString {
        name: "",
        values: empty_vals,
        is_null: empty_null,
        len: 0
    };
}

/// Create a new ColumnInt vector.
pub fn col_int_new(name: String, values: List[Int]) -> Column {
    let n: Int = list_len(values);
    let mut null_mask: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < n {
        null_mask = list_push(null_mask, false);
        i = i + 1;
    }
    let ci: ColumnInt = ColumnInt {
        name: name,
        values: values,
        is_null: null_mask,
        len: n
    };
    return Column {
        name: name,
        dtype: 1,
        int_col: ci,
        float_col: empty_column_float(),
        str_col: empty_column_string(),
        len: n
    };
}

/// Create a new ColumnFloat vector.
pub fn col_float_new(name: String, values: List[Float]) -> Column {
    let n: Int = list_len(values);
    let mut null_mask: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < n {
        null_mask = list_push(null_mask, false);
        i = i + 1;
    }
    let cf: ColumnFloat = ColumnFloat {
        name: name,
        values: values,
        is_null: null_mask,
        len: n
    };
    return Column {
        name: name,
        dtype: 2,
        int_col: empty_column_int(),
        float_col: cf,
        str_col: empty_column_string(),
        len: n
    };
}

/// Create a new ColumnString vector.
pub fn col_str_new(name: String, values: List[String]) -> Column {
    let n: Int = list_len(values);
    let mut null_mask: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < n {
        null_mask = list_push(null_mask, false);
        i = i + 1;
    }
    let cs: ColumnString = ColumnString {
        name: name,
        values: values,
        is_null: null_mask,
        len: n
    };
    return Column {
        name: name,
        dtype: 3,
        int_col: empty_column_int(),
        float_col: empty_column_float(),
        str_col: cs,
        len: n
    };
}
