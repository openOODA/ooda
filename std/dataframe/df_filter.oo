// # DataFrame Filtering & Predicate Evaluation Engine
//
// Logline: Evaluates columnar filter predicates (equality, comparisons, substring matching) to produce Boolean masks.
//
// Setup: Pure query engine applying boolean selection masks to filter DataFrame rows.
//
// Beats:
//   1. Construct BooleanMask arrays matching DataFrame row dimensions.
//   2. Compute element-wise boolean operations (AND, OR, NOT) over masks.
//   3. Evaluate equality and comparison predicates on integer and float columns.
//   4. Apply BooleanMask to extract matching row subsets into a new DataFrame.

import "./dataframe.oo";

pub type BooleanMask = struct {
    flags: List[Bool],
    len: Int
};

/// Create a boolean mask from list of flags.
pub fn mask_new(flags: List[Bool]) -> BooleanMask { return BooleanMask {
        flags: flags,
        len: list_len(flags)
    }; }

/// Compute logical AND of two masks.
pub fn mask_and(a: &BooleanMask, b: &BooleanMask) -> Result[BooleanMask, String] {
    if (a).len != (b).len {
        return Err("ERR\tmask_and: mask length mismatch");
    }
    let mut out: List[Bool] = list_new();
    let n: Int = (a).len;
    let mut i: Int = 0;
    while i < n {
        let fa: Bool = list_get((a).flags, i);
        let fb: Bool = list_get((b).flags, i);
        out = list_push(out, fa && fb);
        i = i + 1;
    }
    return Ok(BooleanMask { flags: out, len: n });
}

/// Filter DataFrame by integer column equality: col == target_val.
pub fn df_filter_eq_int(df: &DataFrame, col_name: String, target_val: Int) -> Result[BooleanMask, String] {
    let opt_ord: Option[Int] = schema_find_column(&(df).schema, col_name);
    match opt_ord {
        Some(ord) => {
            let cols: List[Column] = (df).columns;
            let col: Column = list_get(cols, ord);
            if (col).dtype != 1 {
                return Err("ERR\tdf_filter: column is not integer type");
            }
            let mut flags: List[Bool] = list_new();
            let int_col: ColumnInt = (col).int_col;
            let vals: List[Int] = (int_col).values;
            let n: Int = (int_col).len;
            let mut i: Int = 0;
            while i < n {
                let v: Int = list_get(vals, i);
                flags = list_push(flags, v == target_val);
                i = i + 1;
            }
            return Ok(BooleanMask { flags: flags, len: n });
        }
        None => {
            return Err("ERR\tdf_filter: column not found: " + col_name);
        }
    }
}
