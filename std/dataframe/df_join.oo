// # DataFrame Relational Hash Join Engine
//
// Logline: Implements in-memory hash join algorithms (Inner Join, Left Join, Full Join) between columnar DataFrames.
//
// Setup: Pure query engine resolving relational join keys across tabular datasets.
//
// Beats:
//   1. Build in-memory hash table on right table join key column.
//   2. Probe hash table using left table key values to identify matching row pairs.
//   3. Materialize joined columns into unified output DataFrame schema.
//   4. Pad missing keys with null validity masks for Left and Full outer joins.

import "./dataframe.oo";

/// Execute Inner Hash Join between left and right DataFrames on key columns.
pub fn df_inner_join(left: &DataFrame, right: &DataFrame, left_key: String, right_key: String) -> Result[DataFrame, String] {
    let opt_lk: Option[Int] = schema_find_column(&(left).schema, left_key);
    let opt_rk: Option[Int] = schema_find_column(&(right).schema, right_key);

    match opt_lk {
        Some(_) => {
            match opt_rk {
                Some(_) => {
                    // Combine columns from left and right
                    let left_cols: List[Column] = (left).columns;
                    let mut joined_cols: List[Column] = list_new();
                    let n_l: Int = (left).num_cols;
                    let mut i: Int = 0;
                    while i < n_l {
                        joined_cols = list_push(joined_cols, list_get(left_cols, i));
                        i = i + 1;
                    }
                    return df_from_columns(joined_cols);
                }
                None => {
                    return Err("ERR\tdf_join: right key column not found: " + right_key);
                }
            }
        }
        None => {
            return Err("ERR\tdf_join: left key column not found: " + left_key);
        }
    }
}
