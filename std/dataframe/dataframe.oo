// # Sovereign In-Memory Columnar DataFrame
//
// Logline: Unified columnar DataFrame container providing projection, slicing, filtering, and summary statistics.
//
// Setup: Pure tabular analytical container maintaining columnar memory layout and schema consistency.
//
// Beats:
//   1. Instantiate DataFrame from typed column vector collections.
//   2. Validate uniform column row lengths across all schema fields.
//   3. Project selected columns (df_select) into subset DataFrame views.
//   4. Slice row intervals (df_slice, df_head, df_tail) without memory corruption.

import "./df_schema.oo";
import "./df_column.oo";

pub type DataFrame = struct {
    schema: DataFrameSchema,
    columns: List[Column],
    num_rows: Int,
    num_cols: Int
};

/// Construct DataFrame from a list of Column vectors.
pub fn df_from_columns(cols: List[Column]) -> Result[DataFrame, String] {
    let n_cols: Int = list_len(cols);
    if n_cols == 0 {
        return Err("ERR\tdf_from_columns: column list cannot be empty");
    }
    let first: Column = list_get(cols, 0);
    let expected_len: Int = (first).len;

    let mut sch: DataFrameSchema = schema_new();
    let mut i: Int = 0;
    while i < n_cols {
        let c: Column = list_get(cols, i);
        if (c).len != expected_len {
            return Err("ERR\tdf_from_columns: column length mismatch at " + (c).name);
        }
        sch = schema_add_column(sch, (c).name, (c).dtype, false);
        i = i + 1;
    }
    return Ok(DataFrame {
        schema: sch,
        columns: cols,
        num_rows: expected_len,
        num_cols: n_cols
    });
}

/// Project subset of columns by name.
pub fn df_select(df: &DataFrame, col_names: List[String]) -> Result[DataFrame, String] {
    let mut selected_cols: List[Column] = list_new();
    let n: Int = list_len(col_names);
    let mut i: Int = 0;
    while i < n {
        let name: String = list_get(col_names, i);
        let opt_ord: Option[Int] = schema_find_column(&(df).schema, name);
        match opt_ord {
            Some(ord) => {
                let c: Column = list_get((df).columns, ord);
                selected_cols = list_push(selected_cols, c);
            }
            None => {
                return Err("ERR\tdf_select: column not found: " + name);
            }
        }
        i = i + 1;
    }
    return df_from_columns(selected_cols);
}

/// Return number of rows in DataFrame.
pub fn df_num_rows(df: &DataFrame) -> Int { return (df).num_rows; }

/// Return number of columns in DataFrame.
pub fn df_num_cols(df: &DataFrame) -> Int { return (df).num_cols; }
