// # Columnar DataFrame Schema & Type Metadata
//
// Logline: Defines columnar schema descriptors, data types (Int, Float, String, Bool), and nullability constraints.
//
// Setup: Pure metadata engine validating schema consistency and column ordinals for tabular datasets.
//
// Beats:
//   1. Define ColumnSchema with field name, type tag, and nullability flags.
//   2. Define DataFrameSchema managing ordered column descriptors and column count.
//   3. Locate column schema by name with fail-closed lookup returns.
//   4. Validate schema compatibility for relational joins and union operations.

pub type ColumnSchema = struct {
    name: String,
    dtype: Int,
    is_nullable: Bool,
    ordinal: Int
};

pub type DataFrameSchema = struct {
    columns: List[ColumnSchema],
    num_cols: Int
};

/// Initialize a new empty DataFrameSchema.
pub fn schema_new() -> DataFrameSchema {
    let empty_cols: List[ColumnSchema] = list_new();
    return DataFrameSchema {
        columns: empty_cols,
        num_cols: 0
    };
}

/// Add a column to the schema and return updated schema.
pub fn schema_add_column(schema: DataFrameSchema, name: String, dtype: Int, nullable: Bool) -> DataFrameSchema {
    if name.len() == 0 {
        return schema;
    }
    let ord: Int = (schema).num_cols;
    let col: ColumnSchema = ColumnSchema {
        name: name,
        dtype: dtype,
        is_nullable: nullable,
        ordinal: ord
    };
    let next_cols: List[ColumnSchema] = list_push((schema).columns, col);
    return DataFrameSchema {
        columns: next_cols,
        num_cols: ord + 1
    };
}

/// Find column ordinal index by name.
pub fn schema_find_column(schema: &DataFrameSchema, name: String) -> Option[Int] {
    let mut out: Option[Int] = None;
    let n: Int = (schema).num_cols;
    let mut i: Int = 0;
    while i < n {
        let col: ColumnSchema = list_get((schema).columns, i);
        if (col).name == name {
            out = Some((col).ordinal);
            return out;
        }
        i = i + 1;
    }
    return out;
}
