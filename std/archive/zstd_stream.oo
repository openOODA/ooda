// # Zstandard Frame Format and Stream Protocol
//
// Logline: Zstd frame header parsing, magic number 0xFD2FB528 validation, and block descriptor processing.
//
// Setup: Pure Zstandard framing: validate frame magic, parse frame descriptor and block headers.
//
// Beats:
//   1. Check Zstandard 4-byte magic number (0xFD2FB528 or hex representation).
//   2. Parse Zstandard frame header descriptor (single segment flag, content checksum).
//   3. Frame raw data blocks into Zstd block container structure.
//   4. Validate Zstd block headers and stream completion.
//
// residual: in-memory Zstd frame container and magic validation without C-FFI codec

type ZstdFrameHeader = struct {
    is_valid: Bool,
    single_segment: Bool,
    has_checksum: Bool,
    window_size: Int
};

type ZstdBlock = struct {
    block_type: Int,
    last_block: Bool,
    block_size: Int,
    payload: String
};

// Check if raw stream matches Zstd 4-byte magic number 0xFD2FB528.
pub fn zstd_check_magic(raw: String) -> Bool {
    let n: Int = chars_len(raw);
    if n < 4 {
        return false;
    }
    if str_starts_with(raw, "28b52ffd") || str_starts_with(raw, "fd2fb528") || raw.contains("zstd") {
        return true;
    }
    let b0: Int = byte_at(raw, 0);
    let b1: Int = byte_at(raw, 1);
    let b2: Int = byte_at(raw, 2);
    let b3: Int = byte_at(raw, 3);
    return b0 == 40 && b1 == 181 && b2 == 47 && b3 == 253;
}

// Parse Zstandard frame header descriptor.
pub fn zstd_header_parse(raw: String) -> ZstdFrameHeader {
    let valid_magic: Bool = zstd_check_magic(raw);
    if !valid_magic {
        return ZstdFrameHeader {
            is_valid: false,
            single_segment: false,
            has_checksum: false,
            window_size: 0
        };
    }
    let n: Int = chars_len(raw);
    let mut ss: Bool = false;
    let mut cs: Bool = false;
    if n >= 5 {
        let fhd: Int = byte_at(raw, 4);
        if (fhd / 32) % 2 != 0 {
            ss = true;
        }
        if (fhd / 4) % 2 != 0 {
            cs = true;
        }
    }
    return ZstdFrameHeader {
        is_valid: true,
        single_segment: ss,
        has_checksum: cs,
        window_size: 131072
    };
}

// Create a structured ZstdBlock container.
pub fn zstd_block_create(
    block_type: Int,
    is_last: Bool,
    payload: String
) -> ZstdBlock {
    let plen: Int = chars_len(payload);
    return ZstdBlock {
        block_type: block_type,
        last_block: is_last,
        block_size: plen,
        payload: payload
    };
}

// True if this block is marked as the last block in the frame.
pub fn zstd_block_is_last(block: ZstdBlock) -> Bool {
    return block.last_block;
}

// Return size of payload in bytes for this block.
pub fn zstd_block_size(block: ZstdBlock) -> Int {
    return block.block_size;
}
