// # Detect gzip hex magic
//
// Logline: gzip_detect returns Ok when the string contains hex 1f8b and Err otherwise.
//
// Setup: This module is pure: no FS, net, or env. Callers import this file.
//
// Beats:
//   1. Scan the raw string for the substring "1f8b".
//   2. Return Ok("gzip-detected") when the magic is present.
//   3. Return Err("not-gzip") when it is not.
//
// residual: Byte/binary 0x1f 0x8b not product surface; full gzip decompress NOT product

// Hex-string magic detect. Ok("gzip-detected") when "1f8b" present; else Err.
pub fn gzip_detect(raw: String) -> Result[String, String] {
    if raw.contains("1f8b") {
        return Ok("gzip-detected");
    }
    return Err("not-gzip");
}
