// package: std::archive
// job: pure gzip magic detect only (hex "1f8b" string form)
// caps: none (no FS/net/env)
// residual: Byte/binary 0x1f 0x8b not product surface; full gzip decompress NOT product
// S: low — string-form magic detect only (not DESIGN archive complete)

// Hex-string magic detect. Ok("gzip-detected") when "1f8b" present; else Err.
// Not a decompress: Byte arrays / raw 1f 8b octets remain residual without Byte.
pub fn gzip_detect(raw: String) -> Result[String, String] {
    if raw.contains("1f8b") {
        return Ok("gzip-detected");
    }
    return Err("not-gzip");
}
