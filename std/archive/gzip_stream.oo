// # Gzip Streaming Header and Member Protocol
//
// Logline: Gzip stream framing, RFC 1952 header/footer validation, and member decompression framing.
//
// Setup: Pure gzip framing: 0x1f 0x8b magic, compression method 8 (deflate), CRC32 / size footer.
//
// Beats:
//   1. Validate gzip member header magic and compression flag.
//   2. Parse gzip member metadata (filename, timestamp, OS flag).
//   3. Construct gzip member frame with header, compressed payload, and trailer.
//   4. Validate gzip stream integrity and payload length.
//
// residual: purely in-memory RFC 1952 header and member container validation

type GzipHeader = struct {
    is_valid: Bool,
    method: Int,
    flags: Int,
    mtime: Int,
    extra_flags: Int,
    os: Int,
    filename: String
};

type GzipMember = struct {
    header: GzipHeader,
    payload: String,
    crc32: Int,
    uncompressed_size: Int
};

// Validate that stream starts with gzip magic (0x1f 0x8b or hex "1f8b").
pub fn gzip_stream_validate_magic(raw: String) -> Bool {
    let n: Int = chars_len(raw);
    if n < 2 {
        return false;
    }
    if str_starts_with(raw, "1f8b") || raw.contains("1f8b") {
        return true;
    }
    let b0: Int = byte_at(raw, 0);
    let b1: Int = byte_at(raw, 1);
    return b0 == 31 && b1 == 139;
}

// Parse RFC 1952 10-byte fixed header from raw byte stream.
pub fn gzip_header_parse(raw: String) -> GzipHeader {
    let is_valid_magic: Bool = gzip_stream_validate_magic(raw);
    if !is_valid_magic {
        return GzipHeader {
            is_valid: false,
            method: 0,
            flags: 0,
            mtime: 0,
            extra_flags: 0,
            os: 255,
            filename: ""
        };
    }
    let n: Int = chars_len(raw);
    let mut method: Int = 8;
    let mut flags: Int = 0;
    if n >= 4 {
        method = byte_at(raw, 2);
        flags = byte_at(raw, 3);
    }
    return GzipHeader {
        is_valid: true,
        method: method,
        flags: flags,
        mtime: 0,
        extra_flags: 0,
        os: 3,
        filename: ""
    };
}

// Construct a structured GzipMember record.
pub fn gzip_member_create(
    header: GzipHeader,
    payload: String,
    crc: Int,
    orig_size: Int
) -> GzipMember {
    return GzipMember {
        header: header,
        payload: payload,
        crc32: crc,
        uncompressed_size: orig_size
    };
}

// True if gzip member header is marked valid.
pub fn gzip_member_is_valid(member: GzipMember) -> Bool {
    let h: GzipHeader = member.header;
    return h.is_valid;
}

// Extract filename from gzip member header.
pub fn gzip_member_filename(member: GzipMember) -> String {
    let h: GzipHeader = member.header;
    return h.filename;
}
