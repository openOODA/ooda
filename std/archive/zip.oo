// # Detect PK zip magic
//
// Logline: zip_detect returns Ok when the string contains PK and Err otherwise.
//
// Setup: This module is pure: no FS, net, or env. Callers import this file.
//
// Beats:
//   1. Scan the raw string for the substring "PK".
//   2. Return Ok("zip-detected") when the magic is present.
//   3. Return Err("not-zip") when it is not.
//
// residual: full zip decompress NOT product; EOCD/central-dir parse NOT product

// Magic substring detect. Ok("zip-detected") when "PK" present; else Err.
pub fn zip_detect(raw: String) -> Result[String, String] {
    if raw.contains("PK") {
        return Ok("zip-detected");
    }
    return Err("not-zip");
}
