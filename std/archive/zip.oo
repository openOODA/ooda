// package: std::archive
// job: pure zip header-magic detect only ("PK" substring)
// caps: none (no FS/net/env)
// residual: full zip decompress NOT product; EOCD/central-dir parse NOT product
// S: low — magic detect only (not DESIGN archive complete)

// Magic substring detect. Ok("zip-detected") when "PK" present; else Err.
// Does not inflate entries or claim local-file header completeness.
pub fn zip_detect(raw: String) -> Result[String, String] {
    if raw.contains("PK") {
        return Ok("zip-detected");
    }
    return Err("not-zip");
}
