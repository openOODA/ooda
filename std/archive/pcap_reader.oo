// # PCAP and PCAP-NG record reader
//
// Logline: Parses a PCAP file header and packet records, converting nanosecond timestamps when the magic says so.
//
// Setup: Pure. Bytes are List[Int] 0..255 little-endian. Magic 0xA1B2C3D4 is microseconds. 0xA1B23C4D is nanoseconds.
//
// Beats:
//   1. Require a 24-byte global header.
//   2. Detect microsecond versus nanosecond magic.
//   3. Read ts_sec, ts_frac, incl_len, orig_len.
//   4. Reject a truncated header or a length that overruns the buffer.

pub type PcapOut = struct {
    flag: Int,
    err: String,
    ns: Int,
    ts_sec: Int,
    ts_ns: Int,
    incl: Int
};

fn pc_err(m: String) -> PcapOut {
    return PcapOut { flag: 0, err: "ERR\tpcap: " + m, ns: 0, ts_sec: 0, ts_ns: 0, incl: 0 };
}

fn pc_u32(buf: List[Int], o: Int) -> Int {
    return list_get(buf, o) + list_get(buf, o + 1) * 256 + list_get(buf, o + 2) * 65536 + list_get(buf, o + 3) * 16777216;
}

pub fn pcap_reader_header(buf: List[Int]) -> PcapOut {
    if list_len(buf) < 24 {
        return pc_err("short");
    }
    let mag: Int = pc_u32(buf, 0);
    let mut ns: Int = 0;
    if mag == 2712847316 {
        ns = 0;
    } else {
        if mag == 2712812621 {
            ns = 1;
        } else {
            if mag == 168627466 {
                ns = 1;
            } else {
                return pc_err("magic");
            }
        }
    }
    return PcapOut { flag: 1, err: "", ns: ns, ts_sec: 0, ts_ns: 0, incl: 0 };
}

pub fn pcap_reader_packet(buf: List[Int], ns: Int) -> PcapOut {
    if list_len(buf) < 16 {
        return pc_err("short");
    }
    let ts_sec: Int = pc_u32(buf, 0);
    let frac: Int = pc_u32(buf, 4);
    let incl: Int = pc_u32(buf, 8);
    if 16 + incl > list_len(buf) {
        return pc_err("oversize");
    }
    let mut ts_ns: Int = frac;
    if ns < 1 {
        ts_ns = frac * 1000;
    }
    return PcapOut { flag: 1, err: "", ns: ns, ts_sec: ts_sec, ts_ns: ts_ns, incl: incl };
}

pub fn pcap_reader_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn pcap_reader_flag(o: PcapOut) -> Int {
    return o.flag;
}
pub fn pcap_reader_err(o: PcapOut) -> String {
    return o.err;
}
pub fn pcap_reader_incl(o: PcapOut) -> Int {
    return o.incl;
}
pub fn pcap_reader_ts_ns(o: PcapOut) -> Int {
    return o.ts_ns;
}
