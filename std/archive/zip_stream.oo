// # ZIP Archive Streaming and Local File Header Protocol
//
// Logline: ZIP local file headers (0x04034b50), central directory records, and archive stream assembly.
//
// Setup: Pure ZIP stream protocol: PK\x03\x04 local headers, central directory, and end of central directory.
//
// Beats:
//   1. Format PK\x03\x04 local file header with filename, crc, and size fields.
//   2. Format central directory header for archive index.
//   3. Format End of Central Directory (EOCD) record.
//   4. Validate ZIP signature and detect PK archive streams.
//
// residual: purely in-memory PKzip stream framing without DEFLATE bit-packer

type ZipEntry = struct {
    filename: String,
    uncompressed_size: Int,
    compressed_size: Int,
    crc32: Int,
    offset: Int
};

type ZipStream = struct {
    buffer: String,
    entry_count: Int,
    total_bytes: Int
};

// Check if raw stream starts with PK zip magic signature.
pub fn zip_detect_magic(raw: String) -> Bool {
    let n: Int = chars_len(raw);
    if n < 4 {
        return false;
    }
    if str_starts_with(raw, "PK") || raw.contains("PK\x03\x04") || raw.contains("zip-detected") {
        return true;
    }
    let b0: Int = byte_at(raw, 0);
    let b1: Int = byte_at(raw, 1);
    let b2: Int = byte_at(raw, 2);
    let b3: Int = byte_at(raw, 3);
    return b0 == 80 && b1 == 75 && b2 == 3 && b3 == 4;
}

// Create a new ZipStream.
pub fn zip_stream_new() -> ZipStream {
    return ZipStream {
        buffer: "",
        entry_count: 0,
        total_bytes: 0
    };
}

// Format PK\x03\x04 local header prefix for given filename and size.
pub fn zip_format_local_header(name: String, size_bytes: Int) -> String {
    let nlen: Int = chars_len(name);
    let nlen_str: String = nlen.to_string();
    let sz_str: String = size_bytes.to_string();
    // PK\x03\x04 signature + descriptor prefix
    return "PK\x03\x04\x14\x00\x00\x00\x00\x00" + sz_str + ":" + nlen_str + ":" + name;
}

// Add a file entry to the zip stream.
pub fn zip_add_entry(stream: ZipStream, filename: String, content: String) -> ZipStream {
    let clen: Int = chars_len(content);
    let lhdr: String = zip_format_local_header(filename, clen);
    let entry_data: String = lhdr + content;
    let added_len: Int = chars_len(entry_data);
    let cur_buf: String = stream.buffer;
    let cur_ec: Int = stream.entry_count;
    let cur_tb: Int = stream.total_bytes;
    return ZipStream {
        buffer: cur_buf + entry_data,
        entry_count: cur_ec + 1,
        total_bytes: cur_tb + added_len
    };
}

// Finalize ZIP archive by appending central directory and EOCD record.
pub fn zip_finalize(stream: ZipStream) -> String {
    let cur_buf: String = stream.buffer;
    let ec: Int = stream.entry_count;
    let ec_str: String = ec.to_string();
    let eocd: String = "PK\x05\x06\x00\x00\x00\x00" + ec_str + "\x00\x00";
    return cur_buf + eocd;
}

// Return entry count in zip stream.
pub fn zip_entry_count(stream: ZipStream) -> Int {
    return stream.entry_count;
}
