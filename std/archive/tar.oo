// # Detect ustar magic
//
// Logline: tar_detect returns Ok when the string contains ustar and Err otherwise.
//
// Setup: This module is pure: no FS, net, or env. Callers import this file.
//
// Beats:
//   1. Scan the raw string for the substring "ustar".
//   2. Return Ok("tar-detected") when the magic is present.
//   3. Return Err("not-tar") when it is not.
//
// residual: full tar decompress NOT product; fixed offset-257 Byte header NOT product

// Magic substring detect. Ok("tar-detected") when "ustar" present; else Err.
pub fn tar_detect(raw: String) -> Result[String, String] {
    if raw.contains("ustar") {
        return Ok("tar-detected");
    }
    return Err("not-tar");
}
