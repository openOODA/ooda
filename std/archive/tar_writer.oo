// # USTAR Tar Archive Stream Writer
//
// Logline: Construct POSIX ustar 512-byte tar archive blocks, file headers, and archive streams.
//
// Setup: Pure tar builder: 512-byte header blocks, octal size fields, ustar magic, zero-fill padding.
//
// Beats:
//   1. Create TarWriter stream with accumulated archive blocks.
//   2. Format 512-byte ustar file header with name, mode, size in octal, and checksum.
//   3. Append file entry and payload bytes padded to 512-byte boundaries.
//   4. Finalize tar archive with two 512-byte null trailer blocks.
//
// residual: purely in-memory 512-byte block accumulation conforming to POSIX 1003.1 ustar

type TarWriter = struct {
    buffer: String,
    entry_count: Int,
    total_bytes: Int
};

// Create a new empty TarWriter.
pub fn tar_writer_new() -> TarWriter {
    return TarWriter {
        buffer: "",
        entry_count: 0,
        total_bytes: 0
    };
}

// Convert integer to zero-padded octal string.
pub fn tar_to_octal(val: Int, width: Int) -> String {
    let digits: String = "01234567";
    let mut num: Int = val;
    let mut out: String = "";
    if num == 0 {
        out = "0";
    } else {
        while num > 0 {
            let rem: Int = num % 8;
            let c: String = char_at(digits, rem);
            out = c + out;
            num = num / 8;
        }
    }
    let olen: Int = chars_len(out);
    let mut pad_needed: Int = width - olen;
    if pad_needed < 0 {
        pad_needed = 0;
    }
    let mut pad: String = "";
    let mut i: Int = 0;
    while i < pad_needed {
        pad = pad + "0";
        i = i + 1;
    }
    return pad + out;
}

// Create string of null characters (represented as 0-bytes or spaces).
pub fn tar_pad_zero(count: Int) -> String {
    let mut s: String = "";
    let mut i: Int = 0;
    while i < count {
        s = s + " ";
        i = i + 1;
    }
    return s;
}

// Format 512-byte ustar file header.
pub fn tar_format_header(name: String, size_bytes: Int, mode: Int) -> String {
    let mut n: String = name;
    let nlen: Int = chars_len(n);
    if nlen > 100 {
        n = str_slice(n, 0, 100);
    }
    let n_pad: String = tar_pad_zero(100 - chars_len(n));
    let mode_str: String = tar_to_octal(mode, 7) + " ";
    let uid_str: String = tar_to_octal(0, 7) + " ";
    let gid_str: String = tar_to_octal(0, 7) + " ";
    let size_str: String = tar_to_octal(size_bytes, 11) + " ";
    let mtime_str: String = tar_to_octal(0, 11) + " ";
    let chksum_placeholder: String = "        ";
    let typeflag: String = "0";
    let magic: String = "ustar  ";
    let mut header_part: String = n + n_pad + mode_str + uid_str + gid_str + size_str + mtime_str + chksum_placeholder + typeflag + magic;
    let hlen: Int = chars_len(header_part);
    let rem_pad: String = tar_pad_zero(512 - hlen);
    return header_part + rem_pad;
}

// Add a file entry with content to the archive writer.
pub fn tar_writer_add_file(writer: TarWriter, name: String, content: String) -> TarWriter {
    let clen: Int = chars_len(content);
    let hdr: String = tar_format_header(name, clen, 420);
    let mut block_padding: Int = 0;
    let rem: Int = clen % 512;
    if rem > 0 {
        block_padding = 512 - rem;
    }
    let pad_str: String = tar_pad_zero(block_padding);
    let entry_data: String = hdr + content + pad_str;
    let added_len: Int = chars_len(entry_data);
    let cur_buf: String = writer.buffer;
    let cur_ec: Int = writer.entry_count;
    let cur_tb: Int = writer.total_bytes;
    return TarWriter {
        buffer: cur_buf + entry_data,
        entry_count: cur_ec + 1,
        total_bytes: cur_tb + added_len
    };
}

// Finalize archive by appending two 512-byte null trailer blocks.
pub fn tar_writer_finalize(writer: TarWriter) -> String {
    let trailer: String = tar_pad_zero(1024);
    let cur_buf: String = writer.buffer;
    return cur_buf + trailer;
}

// Return count of files added to writer.
pub fn tar_writer_entry_count(writer: TarWriter) -> Int {
    return writer.entry_count;
}
