// # Vision Transformer (ViT) Class Token & Global Pooling
//
// Logline: Prepend [CLS], n_tok = n_patch+1, extract CLS, mean-pool patches.
// residual: destubbed to Int floor.

type ViTClassTokenConfig = struct {
    embed_d: Int,
    use_cls: Int,
    use_mean: Int
}

type CLSSequence = struct {
    cls0: Int,
    p0: Int,
    p1: Int,
    p2: Int,
    n_tok: Int
}

pub fn vit_class_token_config_new(dim: Int, use_cls: Int, use_mean: Int) -> ViTClassTokenConfig {
    return ViTClassTokenConfig {
        embed_d: dim,
        use_cls: use_cls,
        use_mean: use_mean
    };
}

pub fn vit_n_tok(cfg: ViTClassTokenConfig, n_patch: Int) -> Int {
    if cfg.use_cls == 0 {
        return n_patch;
    }
    return n_patch + 1;
}

pub fn vit_prepend_cls_token(cfg: ViTClassTokenConfig, cls: Int, p0: Int, p1: Int, p2: Int) -> CLSSequence {
    if cfg.use_cls == 0 {
        return CLSSequence {
            cls0: 0,
            p0: p0,
            p1: p1,
            p2: p2,
            n_tok: 3
        };
    }
    return CLSSequence {
        cls0: cls,
        p0: p0,
        p1: p1,
        p2: p2,
        n_tok: 4
    };
}

pub fn vit_extract_cls_token(seq: CLSSequence) -> Int {
    return seq.cls0;
}

pub fn vit_global_mean_pool(seq: CLSSequence) -> Int {
    return ((seq.p0 + seq.p1) + seq.p2) / 3;
}
