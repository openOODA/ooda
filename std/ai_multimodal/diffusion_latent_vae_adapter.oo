// # Latent Diffusion VAE Scaling and Channel Adapter
//
// Logline: Applies standard deviation scaling, channel packing, and spatial patch dimension conversion for latent diffusion models.
//
// Setup: Latent diffusion models operate in continuous latent space scaled by variance factor (e.g. 0.18215 or 0.13025).
//
// Beats:
//   1. Define LatentVAEConfig and LatentDimensions structs.
//   2. Scale and unscale latent tensors: z_scaled = z * scale_factor, z = z_scaled / scale_factor.
//   3. Compute spatial downsampling strides and channel layout flattening for spatial latent grids.

pub type LatentVAEConfig = struct {
    scaling_factor: Float,
    shift_factor: Float,
    spatial_downscale: Int,
    in_channels: Int,
    latent_channels: Int,
};

pub type LatentDimensions = struct {
    height: Int,
    width: Int,
    channels: Int,
    latent_height: Int,
    latent_width: Int,
    total_elements: Int,
};

pub fn latent_vae_config_new(
    scale: Float,
    shift: Float,
    downscale: Int,
    in_c: Int,
    latent_c: Int
) -> LatentVAEConfig {
    return LatentVAEConfig {
        scaling_factor: scale,
        shift_factor: shift,
        spatial_downscale: downscale,
        in_channels: in_c,
        latent_channels: latent_c,
    };
}

pub fn latent_compute_dims(
    img_h: Int,
    img_w: Int,
    in_c: Int,
    downscale: Int,
    latent_c: Int
) -> LatentDimensions {
    let lat_h: Int = img_h / downscale;
    let lat_w: Int = img_w / downscale;
    let total: Int = lat_h * lat_w * latent_c;
    return LatentDimensions {
        height: img_h,
        width: img_w,
        channels: in_c,
        latent_height: lat_h,
        latent_width: lat_w,
        total_elements: total,
    };
}

pub fn latent_encode_scale(
    cfg: &LatentVAEConfig,
    raw_latents: List[Float]
) -> List[Float] {
    let scale: Float = (cfg).scaling_factor;
    let shift: Float = (cfg).shift_factor;
    let len: Int = list_len(raw_latents);

    let mut scaled: List[Float] = list_new();
    let mut i: Int = 0;
    while i < len {
        let z: Float = list_get(raw_latents, i);
        let z_out: Float = (z - shift) * scale;
        scaled = list_push(scaled, z_out);
        i = i + 1;
    }
    return scaled;
}

pub fn latent_decode_unscale(
    cfg: &LatentVAEConfig,
    scaled_latents: List[Float]
) -> List[Float] {
    let scale: Float = if (cfg).scaling_factor > 0.000001 { (cfg).scaling_factor } else { 1.0 };
    let shift: Float = (cfg).shift_factor;
    let len: Int = list_len(scaled_latents);

    let mut unscaled: List[Float] = list_new();
    let mut i: Int = 0;
    while i < len {
        let z_s: Float = list_get(scaled_latents, i);
        let z_out: Float = (z_s / scale) + shift;
        unscaled = list_push(unscaled, z_out);
        i = i + 1;
    }
    return unscaled;
}

pub fn latent_vae_adapter_marker() -> Int {
    return 1;
}
