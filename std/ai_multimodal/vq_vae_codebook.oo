// # VQ-VAE nearest codebook
//
// Logline: van den Oord argmin L2. 3-entry 2-dim codebook, commitment milli.
// residual: destubbed to Int floor.

type VQCfg = struct {
    n_embeddings: Int,
    embed_dim: Int,
    beta_milli: Int
}

type VQResult = struct {
    best_k: Int,
    vq_sse: Int,
    commit_sse: Int,
    n_vectors: Int
}

type VQCand = struct {
    k: Int,
    dist: Int
}

pub fn vq_codebook_config_new(n_embeddings: Int, embed_dim: Int, beta_milli: Int) -> VQCfg {
    return VQCfg {
        n_embeddings: n_embeddings,
        embed_dim: embed_dim,
        beta_milli: beta_milli
    };
}

fn vq_sse2(z0: Int, z1: Int, e0: Int, e1: Int) -> Int {
    let d0: Int = z0 - e0;
    let d1: Int = z1 - e1;
    return (d0 * d0) + (d1 * d1);
}

fn vq_consider(cur: VQCand, k: Int, dist: Int) -> VQCand {
    if dist < cur.dist {
        return VQCand { k: k, dist: dist };
    }
    return cur;
}

pub fn vq_quantize_one(
    cfg: VQCfg,
    z0: Int,
    z1: Int,
    e00: Int,
    e01: Int,
    e10: Int,
    e11: Int,
    e20: Int,
    e21: Int
) -> VQResult {
    let d0: Int = vq_sse2(z0, z1, e00, e01);
    let d1: Int = vq_sse2(z0, z1, e10, e11);
    let d2: Int = vq_sse2(z0, z1, e20, e21);
    let c0: VQCand = VQCand { k: 0, dist: d0 };
    let c1: VQCand = vq_consider(c0, 1, d1);
    let c2: VQCand = vq_consider(c1, 2, d2);
    let commit: Int = (c2.dist * cfg.beta_milli) / 1000;
    return VQResult {
        best_k: c2.k,
        vq_sse: c2.dist,
        commit_sse: commit,
        n_vectors: 1
    };
}

pub fn vq_best_k(r: VQResult) -> Int {
    return r.best_k;
}

pub fn vq_commit(r: VQResult) -> Int {
    return r.commit_sse;
}
