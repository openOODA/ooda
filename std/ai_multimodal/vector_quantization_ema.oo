// # EMA codebook usage counters
//
// Logline: van den Oord N=d*N+(1-d)*batch. e=m/N. Dead-code revive.
// residual: destubbed to Int floor.

type VQEMAConfig = struct {
    n_embed: Int,
    embed_d: Int,
    decay: Int,
    eps: Int
}

type EMAState = struct {
    n0: Int,
    n1: Int,
    e0: Int,
    e1: Int
}

pub fn vq_ema_config_new(n_embed: Int, embed_d: Int, decay: Int) -> VQEMAConfig {
    return VQEMAConfig {
        n_embed: n_embed,
        embed_d: embed_d,
        decay: decay,
        eps: 1
    };
}

pub fn vq_ema_state_new(n0: Int, n1: Int, e0: Int, e1: Int) -> EMAState {
    return EMAState {
        n0: n0,
        n1: n1,
        e0: e0,
        e1: e1
    };
}

pub fn vq_ema_update_n(old_n: Int, batch_n: Int, decay: Int) -> Int {
    return ((decay * old_n) + ((10000 - decay) * batch_n)) / 10000;
}

fn vq_ema_centroid(old_e: Int, new_n: Int, eps: Int, latent: Int) -> Int {
    if new_n < 100 {
        return latent;
    }
    let den: Int = new_n + eps;
    if den == 0 {
        return latent;
    }
    return (old_e * new_n) / den;
}

pub fn vq_ema_update(
    cfg: VQEMAConfig,
    st: EMAState,
    batch0: Int,
    batch1: Int,
    lat0: Int,
    lat1: Int
) -> EMAState {
    let n0: Int = vq_ema_update_n(st.n0, batch0, cfg.decay);
    let n1: Int = vq_ema_update_n(st.n1, batch1, cfg.decay);
    return EMAState {
        n0: n0,
        n1: n1,
        e0: vq_ema_centroid(st.e0, n0, cfg.eps, lat0),
        e1: vq_ema_centroid(st.e1, n1, cfg.eps, lat1)
    };
}

pub fn vq_ema_n0(st: EMAState) -> Int {
    return st.n0;
}

pub fn vq_ema_e0(st: EMAState) -> Int {
    return st.e0;
}
