// # ViT 2D token-grid positional encodings
//
// Logline: n_tok=H*W. sin/cos(y),sin/cos(x) in 10000ths. Add to token.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type ViTPositionalConfig = struct {
    grid_h: Int,
    grid_w: Int,
    embed_d: Int,
    temperature: Int
}

type PosToken = struct {
    sy: Int,
    cy: Int,
    sx: Int,
    cx: Int,
    n_tok: Int
}

fn vpos_isqrt_iter(n: Int, x: Int, y: Int, guard: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if guard >= 32 {
        return x;
    }
    if y < x {
        if y == 0 {
            return 0;
        }
        return vpos_isqrt_iter(n, y, (y + (n / y)) / 2, guard + 1);
    }
    return x;
}

fn vpos_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    return vpos_isqrt_iter(n, n, (n + 1) / 2, 0);
}

fn vpos_mul(a: Int, b: Int) -> Int {
    return (a * b) / 10000;
}

fn vpos_mod_2pi(x: Int) -> Int {
    if x < 0 {
        let y: Int = 0 - x;
        let m: Int = y - (62832 * (y / 62832));
        if m == 0 {
            return 0;
        }
        return 62832 - m;
    }
    return x - (62832 * (x / 62832));
}

fn vpos_sin_taylor(x: Int) -> Int {
    let x2: Int = vpos_mul(x, x);
    let x3: Int = vpos_mul(x2, x);
    let x5: Int = vpos_mul(vpos_mul(x3, x), x);
    return (x - (x3 / 6)) + (x5 / 120);
}

fn vpos_cos_taylor(x: Int) -> Int {
    let x2: Int = vpos_mul(x, x);
    let x4: Int = vpos_mul(x2, x2);
    return (10000 - (x2 / 2)) + (x4 / 24);
}

fn vpos_sin_10000(x: Int) -> Int {
    let r: Int = vpos_mod_2pi(x);
    if r > 31416 {
        return 0 - vpos_sin_10000(r - 31416);
    }
    if r > 15708 {
        return vpos_sin_taylor(31416 - r);
    }
    return vpos_sin_taylor(r);
}

fn vpos_cos_10000(x: Int) -> Int {
    let r: Int = vpos_mod_2pi(x);
    if r > 31416 {
        return 0 - vpos_cos_10000(r - 31416);
    }
    if r > 15708 {
        return 0 - vpos_cos_taylor(31416 - r);
    }
    return vpos_cos_taylor(r);
}

fn vpos_arg(coord: Int, period: Int) -> Int {
    if period <= 0 {
        return 0;
    }
    return (coord * 10000) / period;
}

pub fn vit_positional_config_new(gh: Int, gw: Int, dim: Int) -> ViTPositionalConfig {
    return ViTPositionalConfig {
        grid_h: gh,
        grid_w: gw,
        embed_d: dim,
        temperature: 10000
    };
}

pub fn vit_n_tok_grid(gh: Int, gw: Int) -> Int {
    return gh * gw;
}

pub fn vit_pos_at(cfg: ViTPositionalConfig, y: Int, x: Int) -> PosToken {
    let p0: Int = 1;
    let p1: Int = 1;
    if cfg.embed_d >= 8 {
        let p1b: Int = vpos_isqrt(cfg.temperature);
        return PosToken {
            sy: vpos_sin_10000(vpos_arg(y, p0)),
            cy: vpos_cos_10000(vpos_arg(y, p0)),
            sx: vpos_sin_10000(vpos_arg(x, p1b)),
            cx: vpos_cos_10000(vpos_arg(x, p1b)),
            n_tok: vit_n_tok_grid(cfg.grid_h, cfg.grid_w)
        };
    }
    return PosToken {
        sy: vpos_sin_10000(vpos_arg(y, p0)),
        cy: vpos_cos_10000(vpos_arg(y, p0)),
        sx: vpos_sin_10000(vpos_arg(x, p1)),
        cx: vpos_cos_10000(vpos_arg(x, p1)),
        n_tok: vit_n_tok_grid(cfg.grid_h, cfg.grid_w)
    };
}

pub fn vit_add_pos(tok: Int, pos: Int) -> Int {
    return tok + pos;
}

pub fn vit_pos_sy(p: PosToken) -> Int {
    return p.sy;
}

pub fn vit_pos_n_tok(p: PosToken) -> Int {
    return p.n_tok;
}
