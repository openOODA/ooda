// # Classifier-free guidance scheduler
//
// Logline: Ho/Salimans e = u + s*(c-u). Std rescale. Milli scale.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type CFGConfig = struct {
    scale_milli: Int,
    rescale_milli: Int,
    thresh: Int
}

type CFGVec = struct {
    g0: Int,
    g1: Int
}

fn cfg_isqrt_iter(n: Int, x: Int, y: Int, guard: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if guard >= 32 {
        return x;
    }
    if y < x {
        if y == 0 {
            return 0;
        }
        return cfg_isqrt_iter(n, y, (y + (n / y)) / 2, guard + 1);
    }
    return x;
}

fn cfg_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    return cfg_isqrt_iter(n, n, (n + 1) / 2, 0);
}

fn cfg_clip(x: Int, thresh: Int) -> Int {
    if thresh <= 0 {
        return x;
    }
    if x > thresh {
        return thresh;
    }
    if x < (0 - thresh) {
        return 0 - thresh;
    }
    return x;
}

pub fn cfg_config_new(scale_milli: Int, rescale_milli: Int, thresh: Int) -> CFGConfig {
    return CFGConfig {
        scale_milli: scale_milli,
        rescale_milli: rescale_milli,
        thresh: thresh
    };
}

pub fn cfg_guide_one(u: Int, c: Int, scale_milli: Int) -> Int {
    return u + ((scale_milli * (c - u)) / 1000);
}

pub fn cfg_apply(cfg: CFGConfig, u0: Int, u1: Int, c0: Int, c1: Int) -> CFGVec {
    let raw0: Int = cfg_guide_one(u0, c0, cfg.scale_milli);
    let raw1: Int = cfg_guide_one(u1, c1, cfg.scale_milli);
    let g0: Int = cfg_clip(raw0, cfg.thresh);
    let g1: Int = cfg_clip(raw1, cfg.thresh);
    if cfg.rescale_milli <= 0 {
        return CFGVec { g0: g0, g1: g1 };
    }
    let ss_c: Int = (c0 * c0) + (c1 * c1);
    let ss_g: Int = (g0 * g0) + (g1 * g1);
    let std_c: Int = cfg_isqrt(ss_c);
    let std_g: Int = cfg_isqrt(ss_g);
    if std_g <= 0 {
        return CFGVec { g0: g0, g1: g1 };
    }
    let ratio: Int = (std_c * 1000) / std_g;
    let mix: Int = ((cfg.rescale_milli * ratio) / 1000) + (1000 - cfg.rescale_milli);
    return CFGVec {
        g0: (g0 * mix) / 1000,
        g1: (g1 * mix) / 1000
    };
}

pub fn cfg_g0(v: CFGVec) -> Int {
    return v.g0;
}

pub fn cfg_g1(v: CFGVec) -> Int {
    return v.g1;
}
