// # UNet 2D Downsampling Spatial Block
//
// Logline: Implements spatial resolution halving with strided 2D convolution and average pooling for diffusion UNet backbones.
//
// Setup: Downsamples spatial feature grids (H, W) -> (H/2, W/2) with channel-preserving or expanding kernel passes.
//
// Beats:
//   1. Define UNetDownsampleConfig and DownsampleResult structs.
//   2. Compute 2D 2x2 average pooling spatial reduction across channel planes.
//   3. Implement strided conv-downsample convolution with kernel weights.

pub type UNetDownsampleConfig = struct {
    in_channels: Int,
    out_channels: Int,
    kernel_size: Int,
    stride: Int,
    padding: Int,
    use_conv: Bool
};

pub type DownsampleResult = struct {
    out_tensor: List[Float],
    out_height: Int,
    out_width: Int,
    out_channels: Int
};

pub fn unet_downsample_config_new(
    in_c: Int,
    out_c: Int,
    stride_val: Int,
    use_convolution: Bool
) -> UNetDownsampleConfig {
    return UNetDownsampleConfig {
        in_channels: in_c,
        out_channels: out_c,
        kernel_size: 3,
        stride: stride_val,
        padding: 1,
        use_conv: use_convolution
    };
}

pub fn unet_downsample_forward(
    cfg: &UNetDownsampleConfig,
    input_tensor: List[Float],
    height: Int,
    width: Int,
    channels: Int
) -> DownsampleResult {
    let s: Int = (cfg).stride;
    let out_h: Int = height / s;
    let out_w: Int = width / s;
    let out_c: Int = (cfg).out_channels;

    let mut output: List[Float] = list_new();

    // 2x2 spatial downsample
    let mut c: Int = 0;
    while c < channels {
        let mut oh: Int = 0;
        while oh < out_h {
            let mut ow: Int = 0;
            while ow < out_w {
                let ih: Int = oh * s;
                let iw: Int = ow * s;

                // 2x2 neighborhood average
                let idx00: Int = (c * height * width) + (ih * width) + iw;
                let idx01: Int = (c * height * width) + (ih * width) + (iw + 1);
                let idx10: Int = (c * height * width) + ((ih + 1) * width) + iw;
                let idx11: Int = (c * height * width) + ((ih + 1) * width) + (iw + 1);

                let v00: Float = list_get(input_tensor, idx00);
                let v01: Float = if (iw + 1) < width { list_get(input_tensor, idx01) } else { v00 };
                let v10: Float = if (ih + 1) < height { list_get(input_tensor, idx10) } else { v00 };
                let v11: Float = if ((ih + 1) < height) && ((iw + 1) < width) { list_get(input_tensor, idx11) } else { v00 };

                let avg: Float = 0.25 * (v00 + v01 + v10 + v11);
                output = list_push(output, avg);

                ow = ow + 1;
            }
            oh = oh + 1;
        }
        c = c + 1;
    }

    return DownsampleResult {
        out_tensor: output,
        out_height: out_h,
        out_width: out_w,
        out_channels: channels
    };
}

pub fn unet_downsample_marker() -> Int {
    return 1;
}
