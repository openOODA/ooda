// # ViT patch token lengths
//
// Logline: Dosovitskiy n_tok=(H/P)*(W/P). 2x2 patch sum * w / 1000.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type ViTPatchConfig = struct {
    image_size: Int,
    patch_size: Int,
    in_channels: Int,
    embed_d: Int
}

type PatchEmbeddings = struct {
    t0: Int,
    t1: Int,
    t2: Int,
    t3: Int,
    n_tok: Int,
    grid: Int
}

pub fn vit_patch_config_new(img: Int, patch: Int, in_c: Int, emb_d: Int) -> ViTPatchConfig {
    return ViTPatchConfig {
        image_size: img,
        patch_size: patch,
        in_channels: in_c,
        embed_d: emb_d
    };
}

pub fn vit_n_patch(img: Int, patch: Int) -> Int {
    if patch <= 0 {
        return 0;
    }
    if img < patch {
        return 0;
    }
    let g: Int = img / patch;
    return g * g;
}

pub fn vit_grid_n(img: Int, patch: Int) -> Int {
    if patch <= 0 {
        return 0;
    }
    return img / patch;
}

pub fn vit_patch_proj(p00: Int, p01: Int, p10: Int, p11: Int, w: Int) -> Int {
    let s: Int = ((p00 + p01) + p10) + p11;
    return (s * w) / 1000;
}

pub fn vit_embed_four(
    cfg: ViTPatchConfig,
    a: Int,
    b: Int,
    c: Int,
    d: Int,
    w: Int
) -> PatchEmbeddings {
    let g: Int = vit_grid_n(cfg.image_size, cfg.patch_size);
    let n: Int = vit_n_patch(cfg.image_size, cfg.patch_size);
    return PatchEmbeddings {
        t0: (a * w) / 1000,
        t1: (b * w) / 1000,
        t2: (c * w) / 1000,
        t3: (d * w) / 1000,
        n_tok: n,
        grid: g
    };
}

pub fn vit_embed_one_patch(
    cfg: ViTPatchConfig,
    p00: Int,
    p01: Int,
    p10: Int,
    p11: Int,
    w: Int
) -> PatchEmbeddings {
    let tok: Int = vit_patch_proj(p00, p01, p10, p11, w);
    return PatchEmbeddings {
        t0: tok,
        t1: 0,
        t2: 0,
        t3: 0,
        n_tok: vit_n_patch(cfg.image_size, cfg.patch_size),
        grid: vit_grid_n(cfg.image_size, cfg.patch_size)
    };
}

pub fn vit_tok0(p: PatchEmbeddings) -> Int {
    return p.t0;
}

pub fn vit_n_tok(p: PatchEmbeddings) -> Int {
    return p.n_tok;
}
