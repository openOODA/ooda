// # DDPM linear beta scheduler
//
// Logline: Ho linear beta, alpha, and alpha_bar in 10000ths. q_sample uses integer sqrt.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type DDPMSched = struct {
    timesteps: Int,
    beta_start: Int,
    beta_end: Int,
    t: Int,
    beta: Int,
    alpha: Int,
    alpha_bar: Int
}

fn ddpm_clamp_t(timesteps: Int, t: Int) -> Int {
    if t < 0 {
        return 0;
    }
    if timesteps <= 0 {
        return 0;
    }
    let last: Int = timesteps - 1;
    if t > last {
        return last;
    }
    return t;
}

fn ddpm_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    let mut guard: Int = 0;
    while y < x {
        if guard >= 32 {
            return x;
        }
        x = y;
        if x == 0 {
            return 0;
        }
        y = (x + (n / x)) / 2;
        guard = guard + 1;
    }
    return x;
}

pub fn ddpm_beta_at(timesteps: Int, beta_start: Int, beta_end: Int, t: Int) -> Int {
    if timesteps <= 1 {
        return beta_start;
    }
    return beta_start + ((t * (beta_end - beta_start)) / (timesteps - 1));
}

pub fn ddpm_sched_new(timesteps: Int, beta_start: Int, beta_end: Int) -> DDPMSched {
    return ddpm_sched_at(timesteps, beta_start, beta_end, 0);
}

pub fn ddpm_sched_at(timesteps: Int, beta_start: Int, beta_end: Int, t_in: Int) -> DDPMSched {
    let t: Int = ddpm_clamp_t(timesteps, t_in);
    let mut ab: Int = 10000;
    let mut i: Int = 0;
    let mut last_beta: Int = beta_start;
    let mut last_alpha: Int = 10000 - beta_start;
    while i <= t {
        last_beta = ddpm_beta_at(timesteps, beta_start, beta_end, i);
        last_alpha = 10000 - last_beta;
        ab = (ab * last_alpha) / 10000;
        i = i + 1;
    }
    return DDPMSched {
        timesteps: timesteps,
        beta_start: beta_start,
        beta_end: beta_end,
        t: t,
        beta: last_beta,
        alpha: last_alpha,
        alpha_bar: ab
    };
}

pub fn ddpm_q_sample(sched: DDPMSched, x0: Int, eps: Int) -> Int {
    let sqrt_ab: Int = ddpm_isqrt(sched.alpha_bar);
    let one_minus: Int = 10000 - sched.alpha_bar;
    let sqrt_om: Int = ddpm_isqrt(one_minus);
    return ((sqrt_ab * x0) + (sqrt_om * eps)) / 100;
}

pub fn ddpm_alpha_bar(sched: DDPMSched) -> Int {
    return sched.alpha_bar;
}

pub fn ddpm_beta(sched: DDPMSched) -> Int {
    return sched.beta;
}
