// # UNet 2D Upsampling Spatial Block with Skip Concatenation
//
// Logline: Doubles spatial resolution with nearest-neighbor / bilinear interpolation and concatenates encoder skip-connection features.
//
// Setup: Reconstructs spatial detail in the UNet decoder by combining upsampled features with matching downsample skips.
//
// Beats:
//   1. Define UNetUpsampleConfig and UpsampleResult structs.
//   2. Perform spatial 2x nearest-neighbor interpolation: (H, W) -> (2H, 2W).
//   3. Concatenate upsampled feature maps with skip connections along the channel dimension.

pub type UNetUpsampleConfig = struct {
    in_channels: Int,
    skip_channels: Int,
    out_channels: Int,
    scale_factor: Int
};

pub type UpsampleResult = struct {
    out_tensor: List[Float],
    out_height: Int,
    out_width: Int,
    out_channels: Int
};

pub fn unet_upsample_config_new(
    in_c: Int,
    skip_c: Int,
    out_c: Int,
    scale: Int
) -> UNetUpsampleConfig {
    return UNetUpsampleConfig {
        in_channels: in_c,
        skip_channels: skip_c,
        out_channels: out_c,
        scale_factor: scale
    };
}

pub fn unet_upsample_forward(
    cfg: &UNetUpsampleConfig,
    input_tensor: List[Float],
    skip_tensor: List[Float],
    in_h: Int,
    in_w: Int,
    in_c: Int,
    skip_c: Int
) -> UpsampleResult {
    let scale: Int = (cfg).scale_factor;
    let out_h: Int = in_h * scale;
    let out_w: Int = in_w * scale;

    let mut upsampled: List[Float] = list_new();

    // 1. Nearest neighbor upsample of input_tensor
    let mut c: Int = 0;
    while c < in_c {
        let mut oh: Int = 0;
        while oh < out_h {
            let ih: Int = oh / scale;
            let mut ow: Int = 0;
            while ow < out_w {
                let iw: Int = ow / scale;
                let src_idx: Int = (c * in_h * in_w) + (ih * in_w) + iw;
                let val: Float = list_get(input_tensor, src_idx);
                upsampled = list_push(upsampled, val);
                ow = ow + 1;
            }
            oh = oh + 1;
        }
        c = c + 1;
    }

    // 2. Concatenate skip_tensor (channel dimension)
    let total_c: Int = in_c + skip_c;
    let mut combined: List[Float] = upsampled;

    let skip_len: Int = list_len(skip_tensor);
    let mut s_idx: Int = 0;
    while s_idx < skip_len {
        let s_val: Float = list_get(skip_tensor, s_idx);
        combined = list_push(combined, s_val);
        s_idx = s_idx + 1;
    }

    return UpsampleResult {
        out_tensor: combined,
        out_height: out_h,
        out_width: out_w,
        out_channels: total_c
    };
}

pub fn unet_upsample_marker() -> Int {
    return 1;
}
