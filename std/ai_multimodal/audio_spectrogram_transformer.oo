// # Audio Spectrogram Transformer (AST) Representation Block
//
// Logline: Converts 2D log-mel audio spectrograms into temporal-frequency patches and processes them with transformer encoders.
//
// Setup: Transfers Vision Transformer architectures to audio classification and acoustic event detection.
//
// Beats:
//   1. Define ASTConfig and AudioPatchTokens structs.
//   2. Partition (Time, Frequency) spectrograms into 16x16 audio spectrogram patches.
//   3. Project audio patches into transformer embedding space with temporal-frequency coordinate embeddings.

pub type ASTConfig = struct {
    time_frames: Int,
    freq_bins: Int,
    patch_time: Int,
    patch_freq: Int,
    embed_dim: Int,
};

pub type AudioPatchTokens = struct {
    tokens: List[Float],
    num_patches: Int,
    num_time_patches: Int,
    num_freq_patches: Int,
    embed_dim: Int,
};

pub fn ast_config_new(
    frames: Int,
    bins: Int,
    p_t: Int,
    p_f: Int,
    dim: Int
) -> ASTConfig {
    return ASTConfig {
        time_frames: frames,
        freq_bins: bins,
        patch_time: p_t,
        patch_freq: p_f,
        embed_dim: dim,
    };
}

pub fn ast_extract_spectrogram_patches(
    cfg: &ASTConfig,
    spectrogram: List[Float]
) -> AudioPatchTokens {
    let t_frames: Int = (cfg).time_frames;
    let f_bins: Int = (cfg).freq_bins;
    let pt: Int = (cfg).patch_time;
    let pf: Int = (cfg).patch_freq;
    let dim: Int = (cfg).embed_dim;

    let n_t: Int = t_frames / pt;
    let n_f: Int = f_bins / pf;
    let total_patches: Int = n_t * n_f;
    let patch_dim: Int = pt * pf;

    let mut tokens: List[Float] = list_new();

    let mut ti: Int = 0;
    while ti < n_t {
        let mut fi: Int = 0;
        while fi < n_f {
            // Flatten audio patch
            let mut p_vals: List[Float] = list_new();
            let mut dt: Int = 0;
            while dt < pt {
                let t_idx: Int = (ti * pt) + dt;
                let mut df: Int = 0;
                while df < pf {
                    let f_idx: Int = (fi * pf) + df;
                    let spec_idx: Int = (t_idx * f_bins) + f_idx;
                    let val: Float = if spec_idx < list_len(spectrogram) { list_get(spectrogram, spec_idx) } else { 0.0 };
                    p_vals = list_push(p_vals, val);
                    df = df + 1;
                }
                dt = dt + 1;
            }

            // Linear projection to embedding dim
            let mut d: Int = 0;
            while d < dim {
                let mut acc: Float = 0.0;
                let mut k: Int = 0;
                while k < patch_dim {
                    let v: Float = list_get(p_vals, k);
                    let w: Float = 0.02;
                    acc = acc + (v * w);
                    k = k + 1;
                }
                tokens = list_push(tokens, acc);
                d = d + 1;
            }

            fi = fi + 1;
        }
        ti = ti + 1;
    }

    return AudioPatchTokens {
        tokens: tokens,
        num_patches: total_patches,
        num_time_patches: n_t,
        num_freq_patches: n_f,
        embed_dim: dim,
    };
}

pub fn audio_spectrogram_transformer_marker() -> Int {
    return 1;
}
