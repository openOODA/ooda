// # DPM-Solver++ Fast High-Order Diffusion Multistep Engine
//
// Logline: Lu first/second-order update in 10000ths. phi = exp(h)-1 from alpha/sigma.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type DPMSolverConfig = struct {
    alg: Int,
    order: Int,
    lower_final: Int
}

type DPMSolverState = struct {
    last_model: Int,
    last_h: Int,
    n_step: Int
}

pub fn dpm_solver_config_new(alg: Int, order: Int, lower_final: Int) -> DPMSolverConfig {
    return DPMSolverConfig {
        alg: alg,
        order: order,
        lower_final: lower_final
    };
}

pub fn dpm_solver_state_new() -> DPMSolverState {
    return DPMSolverState {
        last_model: 0,
        last_h: 0,
        n_step: 0
    };
}

pub fn dpm_state_record(st: DPMSolverState, model: Int, h: Int) -> DPMSolverState {
    return DPMSolverState {
        last_model: model,
        last_h: h,
        n_step: st.n_step + 1
    };
}

pub fn dpm_ratio(sigma_s: Int, sigma_t: Int) -> Int {
    if sigma_t <= 0 {
        return 0;
    }
    return (sigma_s * 10000) / sigma_t;
}

pub fn dpm_phi1(alpha_s: Int, alpha_t: Int, sigma_s: Int, sigma_t: Int) -> Int {
    if sigma_s <= 0 {
        return 0;
    }
    if alpha_t <= 0 {
        return 0;
    }
    let exp_h: Int = (((alpha_s * 10000) / sigma_s) * sigma_t) / alpha_t;
    return exp_h - 10000;
}

fn dpm_r_q(h: Int, h_prev: Int) -> Int {
    if h_prev == 0 {
        return 10000;
    }
    return (h * 10000) / h_prev;
}

pub fn dpm_first_order_update(
    x_t: Int,
    model_t: Int,
    alpha_s: Int,
    alpha_t: Int,
    sigma_s: Int,
    sigma_t: Int
) -> Int {
    let ratio: Int = dpm_ratio(sigma_s, sigma_t);
    let phi: Int = dpm_phi1(alpha_s, alpha_t, sigma_s, sigma_t);
    let scaled_x: Int = (ratio * x_t) / 10000;
    let corr: Int = (((alpha_s * phi) / 10000) * model_t) / 10000;
    return scaled_x - corr;
}

pub fn dpm_second_order_update(
    x_t: Int,
    model_t: Int,
    model_prev: Int,
    h: Int,
    h_prev: Int,
    alpha_s: Int,
    alpha_t: Int,
    sigma_s: Int,
    sigma_t: Int
) -> Int {
    let base: Int = dpm_first_order_update(x_t, model_t, alpha_s, alpha_t, sigma_s, sigma_t);
    let r_q: Int = dpm_r_q(h, h_prev);
    if r_q == 0 {
        return base;
    }
    let d1: Int = ((model_t - model_prev) * 10000) / r_q;
    let phi: Int = dpm_phi1(alpha_s, alpha_t, sigma_s, sigma_t);
    let extra: Int = ((((alpha_s * phi) / 10000) * d1) / 2) / 10000;
    return base - extra;
}
