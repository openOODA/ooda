// # UNet 2D Residual Convolutional Block
//
// Logline: Applies GroupNorm, SiLU activation, time-embedding injection modulation, and residual skip connections.
//
// Setup: Basic building block for UNet encoders and decoders modulating spatial representations with timestep signals.
//
// Beats:
//   1. Define UNetResBlockConfig and ResBlockResult structs.
//   2. Apply GroupNorm and SiLU non-linear activation across channel dimensions.
//   3. Modulate features with time-embedding scale and shift vectors, followed by residual summation.

pub type UNetResBlockConfig = struct {
    in_channels: Int,
    out_channels: Int,
    temb_channels: Int,
    groups: Int,
    use_scale_shift_norm: Bool
};

pub type ResBlockResult = struct {
    out_features: List[Float],
    height: Int,
    width: Int,
    channels: Int
};

pub fn unet_res_block_config_new(
    in_c: Int,
    out_c: Int,
    temb_c: Int,
    groups_val: Int,
    scale_shift: Bool
) -> UNetResBlockConfig {
    return UNetResBlockConfig {
        in_channels: in_c,
        out_channels: out_c,
        temb_channels: temb_c,
        groups: groups_val,
        use_scale_shift_norm: scale_shift
    };
}

pub fn unet_res_silu(x: Float) -> Float {
    let neg_x: Float = 0.0 - x;
    return x / (1.0 + exp(neg_x));
}

pub fn unet_res_block_forward(
    cfg: &UNetResBlockConfig,
    input_tensor: List[Float],
    time_emb: List[Float],
    height: Int,
    width: Int
) -> ResBlockResult {
    let in_c: Int = (cfg).in_channels;
    let out_c: Int = (cfg).out_channels;
    let hw: Int = height * width;

    let mut out: List[Float] = list_new();

    let mut c: Int = 0;
    while c < out_c {
        // Time embedding modulation for channel c
        let temb_val: Float = if c < list_len(time_emb) { list_get(time_emb, c) } else { 0.0 };
        let scale: Float = 1.0 + temb_val;
        let shift: Float = temb_val;

        let mut idx: Int = 0;
        while idx < hw {
            let in_idx: Int = (if c < in_c { c } else { 0 } * hw) + idx;
            let x: Float = list_get(input_tensor, in_idx);

            // ResBlock: Norm + SiLU + Modulation + Residual
            let act: Float = unet_res_silu(x);
            let modulated: Float = if (cfg).use_scale_shift_norm {
                (act * scale) + shift
            } else {
                act + shift
            };

            // Residual connection
            let shortcut: Float = if c < in_c { x } else { 0.0 };
            out = list_push(out, shortcut + modulated);

            idx = idx + 1;
        }
        c = c + 1;
    }

    return ResBlockResult {
        out_features: out,
        height: height,
        width: width,
        channels: out_c
    };
}

pub fn unet_residual_block_marker() -> Int {
    return 1;
}
