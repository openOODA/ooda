// # Finite Scalar Quantizer
//
// Logline: Mentzer FSQ 2-dim base-L pack. Clamp to half-levels, pack codes.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type FSQCfg = struct {
    dim: Int,
    level0: Int,
    level1: Int,
    codebook_size: Int
}

type FSQResult = struct {
    q0: Int,
    q1: Int,
    idx: Int,
    n_vectors: Int
}

fn fsq_clamp(z: Int, half: Int) -> Int {
    if z > half {
        return half;
    }
    if z < (0 - half) {
        return 0 - half;
    }
    return z;
}

pub fn fsq_config_new(level0: Int, level1: Int) -> FSQCfg {
    return FSQCfg {
        dim: 2,
        level0: level0,
        level1: level1,
        codebook_size: level0 * level1
    };
}

pub fn fsq_quantize_pair(cfg: FSQCfg, z0: Int, z1: Int) -> FSQResult {
    let h0: Int = cfg.level0 / 2;
    let h1: Int = cfg.level1 / 2;
    let q0: Int = fsq_clamp(z0, h0);
    let q1: Int = fsq_clamp(z1, h1);
    let c0: Int = q0 + h0;
    let c1: Int = q1 + h1;
    let idx: Int = c0 + (c1 * cfg.level0);
    return FSQResult {
        q0: q0,
        q1: q1,
        idx: idx,
        n_vectors: 1
    };
}

pub fn fsq_codebook_size(cfg: FSQCfg) -> Int {
    return cfg.codebook_size;
}

pub fn fsq_index(r: FSQResult) -> Int {
    return r.idx;
}
