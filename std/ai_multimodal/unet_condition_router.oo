// # UNet Multimodal Condition Router & Fusion Block
//
// Logline: Blends and routes text conditioning, image prompts, IP-Adapter latents, and spatial control maps to UNet attention layers.
//
// Setup: Multi-signal condition weighting and projection for complex multi-modal diffusion pipelines.
//
// Beats:
//   1. Define ConditionRouterConfig and RoutedCondition structs.
//   2. Compute weighted linear combination of multiple conditioning modalities.
//   3. Apply condition dropout for classifier-free guidance training and inference.

pub type ConditionRouterConfig = struct {
    text_dim: Int,
    image_dim: Int,
    control_dim: Int,
    out_dim: Int,
    dropout_prob: Float,
};

pub type RoutedCondition = struct {
    fused_context: List[Float],
    num_tokens: Int,
    dim: Int,
};

pub fn condition_router_config_new(
    t_dim: Int,
    img_dim: Int,
    ctrl_dim: Int,
    out_d: Int,
    dropout: Float
) -> ConditionRouterConfig {
    return ConditionRouterConfig {
        text_dim: t_dim,
        image_dim: img_dim,
        control_dim: ctrl_dim,
        out_dim: out_d,
        dropout_prob: dropout,
    };
}

pub fn condition_route_fuse(
    cfg: &ConditionRouterConfig,
    text_emb: List[Float],
    image_emb: List[Float],
    control_emb: List[Float],
    text_weight: Float,
    image_weight: Float,
    control_weight: Float,
    num_tokens: Int
) -> RoutedCondition {
    let out_d: Int = (cfg).out_dim;
    let mut fused: List[Float] = list_new();

    let mut t: Int = 0;
    while t < num_tokens {
        let mut d: Int = 0;
        while d < out_d {
            let t_val: Float = if (t * (cfg).text_dim + d) < list_len(text_emb) {
                list_get(text_emb, (t * (cfg).text_dim) + d)
            } else {
                0.0
            };
            let img_val: Float = if (t * (cfg).image_dim + d) < list_len(image_emb) {
                list_get(image_emb, (t * (cfg).image_dim) + d)
            } else {
                0.0
            };
            let ctrl_val: Float = if (t * (cfg).control_dim + d) < list_len(control_emb) {
                list_get(control_emb, (t * (cfg).control_dim) + d)
            } else {
                0.0
            };

            let combined: Float = (text_weight * t_val) + (image_weight * img_val) + (control_weight * ctrl_val);
            fused = list_push(fused, combined);
            d = d + 1;
        }
        t = t + 1;
    }

    return RoutedCondition {
        fused_context: fused,
        num_tokens: num_tokens,
        dim: out_d,
    };
}

pub fn unet_condition_router_marker() -> Int {
    return 1;
}
