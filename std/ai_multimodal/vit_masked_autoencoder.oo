// # MAE visible/masked token counters
//
// Logline: He n_keep=n_patch*(1-r). Prefix mask. Milli MSE on masked.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type MAEConfig = struct {
    n_patch: Int,
    patch_d: Int,
    mask_milli: Int
}

type MaskedTokens = struct {
    v0: Int,
    v1: Int,
    m0: Int,
    m1: Int,
    m2: Int,
    m3: Int,
    n_vis: Int,
    n_mask: Int
}

type MAELossOutput = struct {
    loss_milli: Int,
    n_mask: Int
}

pub fn mae_config_new(patches: Int, p_dim: Int, mask_milli: Int) -> MAEConfig {
    return MAEConfig {
        n_patch: patches,
        patch_d: p_dim,
        mask_milli: mask_milli
    };
}

pub fn mae_n_keep(n_patch: Int, mask_milli: Int) -> Int {
    if n_patch <= 0 {
        return 0;
    }
    let keep_milli: Int = 1000 - mask_milli;
    if keep_milli < 0 {
        return 1;
    }
    let n: Int = (n_patch * keep_milli) / 1000;
    if n < 1 {
        return 1;
    }
    if n > n_patch {
        return n_patch;
    }
    return n;
}

fn mae_bit(i: Int, n_keep: Int) -> Int {
    if i < n_keep {
        return 0;
    }
    return 1;
}

fn mae_vis(i: Int, n_keep: Int, tok: Int) -> Int {
    if i < n_keep {
        return tok;
    }
    return 0;
}

pub fn mae_apply_masking(cfg: MAEConfig, t0: Int, t1: Int, t2: Int, t3: Int) -> MaskedTokens {
    let n_keep: Int = mae_n_keep(cfg.n_patch, cfg.mask_milli);
    return MaskedTokens {
        v0: mae_vis(0, n_keep, t0),
        v1: mae_vis(1, n_keep, t1),
        m0: mae_bit(0, n_keep),
        m1: mae_bit(1, n_keep),
        m2: mae_bit(2, n_keep),
        m3: mae_bit(3, n_keep),
        n_vis: n_keep,
        n_mask: cfg.n_patch - n_keep
    };
}

fn mae_masked_sse(m: Int, pred: Int, tgt: Int) -> Int {
    if m == 0 {
        return 0;
    }
    let d: Int = pred - tgt;
    return d * d;
}

pub fn mae_reconstruction_loss(
    cfg: MAEConfig,
    p0: Int,
    p1: Int,
    p2: Int,
    p3: Int,
    t0: Int,
    t1: Int,
    t2: Int,
    t3: Int,
    m0: Int,
    m1: Int,
    m2: Int,
    m3: Int
) -> MAELossOutput {
    let n_m: Int = ((m0 + m1) + m2) + m3;
    let sse: Int = ((mae_masked_sse(m0, p0, t0) + mae_masked_sse(m1, p1, t1)) + mae_masked_sse(m2, p2, t2)) + mae_masked_sse(m3, p3, t3);
    if n_m <= 0 {
        return MAELossOutput { loss_milli: 0, n_mask: 0 };
    }
    let den: Int = n_m * cfg.patch_d;
    if den <= 0 {
        return MAELossOutput { loss_milli: 0, n_mask: n_m };
    }
    return MAELossOutput {
        loss_milli: (sse * 1000) / den,
        n_mask: n_m
    };
}

pub fn mae_n_vis(m: MaskedTokens) -> Int {
    return m.n_vis;
}

pub fn mae_loss_milli(o: MAELossOutput) -> Int {
    return o.loss_milli;
}
