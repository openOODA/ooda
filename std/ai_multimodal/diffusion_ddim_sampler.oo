// # DDIM Non-Markovian Sampler for Diffusion
//
// Logline: Song DDIM step in 10000ths. pred_x0, eta-sigma, prev sample.
// residual: destubbed to Int floor.

type DDIMSamplerConfig = struct {
    n_steps: Int,
    eta: Int,
    clip_on: Int,
    clip_range: Int
}

type DDIMStepResult = struct {
    prev_sample: Int,
    pred_x0: Int
}

fn ddim_isqrt_iter(n: Int, x: Int, y: Int, guard: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if guard >= 32 {
        return x;
    }
    if y < x {
        if y == 0 {
            return 0;
        }
        return ddim_isqrt_iter(n, y, (y + (n / y)) / 2, guard + 1);
    }
    return x;
}

fn ddim_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    return ddim_isqrt_iter(n, n, (n + 1) / 2, 0);
}

fn ddim_nonneg(x: Int) -> Int {
    if x < 0 {
        return 0;
    }
    return x;
}

fn ddim_clip_val(x: Int, clip_on: Int, clip_range: Int) -> Int {
    if clip_on == 0 {
        return x;
    }
    if x > clip_range {
        return clip_range;
    }
    if x < (0 - clip_range) {
        return 0 - clip_range;
    }
    return x;
}

pub fn ddim_sampler_config_new(steps: Int, eta_val: Int, clip: Int, range_val: Int) -> DDIMSamplerConfig {
    return DDIMSamplerConfig {
        n_steps: steps,
        eta: eta_val,
        clip_on: clip,
        clip_range: range_val
    };
}

pub fn ddim_pred_x0(x_t: Int, eps: Int, a_t: Int) -> Int {
    let sa: Int = ddim_isqrt(a_t);
    if sa == 0 {
        return 0;
    }
    let om: Int = ddim_nonneg(10000 - a_t);
    let som: Int = ddim_isqrt(om);
    return ((x_t * 100) - (som * eps)) / sa;
}

pub fn ddim_sigma(eta: Int, a_t: Int, a_prev: Int) -> Int {
    if eta <= 0 {
        return 0;
    }
    let om_t: Int = 10000 - a_t;
    let om_p: Int = 10000 - a_prev;
    if om_t <= 0 {
        return 0;
    }
    if a_prev <= 0 {
        return 0;
    }
    let ratio1: Int = (om_p * 10000) / om_t;
    let ratio2: Int = 10000 - ((a_t * 10000) / a_prev);
    if ratio2 < 0 {
        return 0;
    }
    let var_term: Int = (ratio1 * ratio2) / 10000;
    let root: Int = ddim_isqrt(var_term);
    return (eta * root) / 100;
}

pub fn ddim_step(
    cfg: DDIMSamplerConfig,
    x_t: Int,
    eps: Int,
    a_t: Int,
    a_prev: Int,
    noise: Int
) -> DDIMStepResult {
    let raw_x0: Int = ddim_pred_x0(x_t, eps, a_t);
    let pred_x0: Int = ddim_clip_val(raw_x0, cfg.clip_on, cfg.clip_range);
    let sigma: Int = ddim_sigma(cfg.eta, a_t, a_prev);
    let sig2: Int = (sigma * sigma) / 10000;
    let dir_term: Int = ddim_nonneg((10000 - a_prev) - sig2);
    let sqrt_dir: Int = ddim_isqrt(dir_term);
    let sqrt_ap: Int = ddim_isqrt(a_prev);
    let base: Int = ((sqrt_ap * pred_x0) + (sqrt_dir * eps)) / 100;
    let noise_term: Int = (sigma * noise) / 10000;
    return DDIMStepResult {
        prev_sample: base + noise_term,
        pred_x0: pred_x0
    };
}
