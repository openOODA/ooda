// # CTC alignment-free token loss
//
// Logline: Graves blank-interleave + forward alpha. log-add in milli. NLL.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type CTCConfig = struct {
    blank_index: Int,
    vocab_size: Int,
    zero_infinity: Int
}

type CTCTarget = struct {
    y0: Int,
    y1: Int,
    n_y: Int
}

type CTCExtended = struct {
    e0: Int,
    e1: Int,
    e2: Int,
    e3: Int,
    e4: Int,
    n_ext: Int
}

type CTCLogits = struct {
    t0_blank: Int,
    t0_lab: Int,
    t1_blank: Int,
    t1_lab: Int
}

type CTCLossOutput = struct {
    loss_milli: Int,
    target_n: Int,
    input_n: Int
}

fn ctc_ln1p_exp(d: Int) -> Int {
    if d >= 0 {
        return 693;
    }
    if d > (0 - 350) {
        return 693 + (d / 2);
    }
    if d > (0 - 550) {
        return 480;
    }
    if d > (0 - 750) {
        return 405;
    }
    if d > (0 - 1100) {
        return 313;
    }
    if d > (0 - 1600) {
        return 182;
    }
    if d > (0 - 2500) {
        return 82;
    }
    if d > (0 - 4000) {
        return 18;
    }
    return 0;
}

pub fn ctc_log_add(a: Int, b: Int) -> Int {
    if a < (0 - 99999) {
        return b;
    }
    if b < (0 - 99999) {
        return a;
    }
    if a > b {
        return a + ctc_ln1p_exp(b - a);
    }
    return b + ctc_ln1p_exp(a - b);
}

fn ctc_clamp_loss(raw: Int) -> Int {
    if raw < 0 {
        return 0;
    }
    return raw;
}

pub fn ctc_config_new(blank_idx: Int, v_size: Int, zero_inf: Int) -> CTCConfig {
    return CTCConfig {
        blank_index: blank_idx,
        vocab_size: v_size,
        zero_infinity: zero_inf
    };
}

pub fn ctc_target_new(y0: Int, y1: Int, n_y: Int) -> CTCTarget {
    return CTCTarget {
        y0: y0,
        y1: y1,
        n_y: n_y
    };
}

pub fn ctc_logits_new(t0b: Int, t0y: Int, t1b: Int, t1y: Int) -> CTCLogits {
    return CTCLogits {
        t0_blank: t0b,
        t0_lab: t0y,
        t1_blank: t1b,
        t1_lab: t1y
    };
}

pub fn ctc_extended_n(n_y: Int) -> Int {
    return (2 * n_y) + 1;
}

pub fn ctc_extend(cfg: CTCConfig, tgt: CTCTarget) -> CTCExtended {
    let b: Int = cfg.blank_index;
    if tgt.n_y <= 0 {
        return CTCExtended {
            e0: b,
            e1: 0,
            e2: 0,
            e3: 0,
            e4: 0,
            n_ext: 1
        };
    }
    if tgt.n_y == 1 {
        return CTCExtended {
            e0: b,
            e1: tgt.y0,
            e2: b,
            e3: 0,
            e4: 0,
            n_ext: 3
        };
    }
    return CTCExtended {
        e0: b,
        e1: tgt.y0,
        e2: b,
        e3: tgt.y1,
        e4: b,
        n_ext: 5
    };
}

pub fn ctc_loss_t1(lp_blank: Int, lp_lab: Int, tgt: CTCTarget) -> CTCLossOutput {
    if tgt.n_y <= 0 {
        return CTCLossOutput {
            loss_milli: ctc_clamp_loss(0 - lp_blank),
            target_n: 0,
            input_n: 1
        };
    }
    return CTCLossOutput {
        loss_milli: ctc_clamp_loss(0 - lp_lab),
        target_n: tgt.n_y,
        input_n: 1
    };
}

pub fn ctc_compute_loss(cfg: CTCConfig, logits: CTCLogits, tgt: CTCTarget) -> CTCLossOutput {
    if tgt.n_y <= 0 {
        return CTCLossOutput {
            loss_milli: ctc_clamp_loss(0 - logits.t0_blank),
            target_n: 0,
            input_n: 2
        };
    }
    let a0: Int = logits.t0_blank;
    let a1: Int = logits.t0_lab;
    let n1: Int = ctc_log_add(a1, a0) + logits.t1_lab;
    let n2: Int = a1 + logits.t1_blank;
    let ll: Int = ctc_log_add(n2, n1);
    let raw: Int = 0 - ll;
    if cfg.zero_infinity == 0 {
        return CTCLossOutput {
            loss_milli: ctc_clamp_loss(raw),
            target_n: tgt.n_y,
            input_n: 2
        };
    }
    return CTCLossOutput {
        loss_milli: raw,
        target_n: tgt.n_y,
        input_n: 2
    };
}

pub fn ctc_loss_milli(out: CTCLossOutput) -> Int {
    return out.loss_milli;
}

pub fn ctc_ext_n(ext: CTCExtended) -> Int {
    return ext.n_ext;
}
