// # Mixture-of-Depths token capacity router
//
// Logline: First-k capacity budget (Raposo MoD). Combine keeps residual skip.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type MoDRouterConfig = struct {
    embed_dim: Int,
    capacity_permille: Int
}

type MoDDecision = struct {
    n_tokens: Int,
    n_routed: Int,
    idx0: Int,
    idx1: Int
}

pub fn mod_router_config_new(dim: Int, capacity_permille: Int) -> MoDRouterConfig {
    return MoDRouterConfig {
        embed_dim: dim,
        capacity_permille: capacity_permille
    };
}

fn mod_capacity_k(n_tokens: Int, capacity_permille: Int) -> Int {
    let raw: Int = (n_tokens * capacity_permille) / 1000;
    if raw < 1 {
        return 1;
    }
    if raw > n_tokens {
        return n_tokens;
    }
    return raw;
}

pub fn mod_route_tokens(cfg: MoDRouterConfig, n_tokens: Int) -> MoDDecision {
    let k: Int = mod_capacity_k(n_tokens, cfg.capacity_permille);
    let i0: Int = 0;
    if k > 1 {
        return MoDDecision {
            n_tokens: n_tokens,
            n_routed: k,
            idx0: i0,
            idx1: 1
        };
    }
    return MoDDecision {
        n_tokens: n_tokens,
        n_routed: k,
        idx0: i0,
        idx1: 0 - 1
    };
}

pub fn mod_token_routed(dec: MoDDecision, token_idx: Int) -> Int {
    if token_idx < 0 {
        return 0;
    }
    if token_idx < dec.n_routed {
        return 1;
    }
    return 0;
}

pub fn mod_combine_token(orig: Int, proc: Int, routed: Int, weight_milli: Int) -> Int {
    if routed == 0 {
        return orig;
    }
    return orig + ((weight_milli * proc) / 1000);
}

pub fn mod_decision_routed(dec: MoDDecision) -> Int {
    return dec.n_routed;
}
