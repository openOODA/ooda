// # Flow Matching & Continuous Rectified Flow Engine
//
// Logline: OT path x_t and velocity in milli. Euler step along v.
// residual: destubbed to Int floor.

type FlowMatchingConfig = struct {
    sigma_min: Int,
    time_eps: Int
}

type FlowPath = struct {
    xt0: Int,
    xt1: Int,
    v0: Int,
    v1: Int
}

fn flow_clamp_t(t: Int) -> Int {
    if t < 0 {
        return 0;
    }
    if t > 1000 {
        return 1000;
    }
    return t;
}

pub fn flow_matching_config_new(s_min: Int, eps: Int) -> FlowMatchingConfig {
    return FlowMatchingConfig {
        sigma_min: s_min,
        time_eps: eps
    };
}

pub fn flow_coef0(cfg: FlowMatchingConfig, t: Int) -> Int {
    let tc: Int = flow_clamp_t(t);
    return 1000 - (((1000 - cfg.sigma_min) * tc) / 1000);
}

pub fn flow_vt_comp(cfg: FlowMatchingConfig, x0: Int, x1: Int) -> Int {
    return x1 - (((1000 - cfg.sigma_min) * x0) / 1000);
}

pub fn flow_sample_path(cfg: FlowMatchingConfig, x00: Int, x01: Int, x10: Int, x11: Int, t: Int) -> FlowPath {
    let tc: Int = flow_clamp_t(t);
    let c0: Int = flow_coef0(cfg, tc);
    let xt0: Int = ((c0 * x00) + (tc * x10)) / 1000;
    let xt1: Int = ((c0 * x01) + (tc * x11)) / 1000;
    return FlowPath {
        xt0: xt0,
        xt1: xt1,
        v0: flow_vt_comp(cfg, x00, x10),
        v1: flow_vt_comp(cfg, x01, x11)
    };
}

pub fn flow_euler_step(x: Int, v: Int, dt: Int) -> Int {
    return x + ((dt * v) / 1000);
}
