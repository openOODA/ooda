// # Neural Phase Vocoder & Pitch Shift Engine
//
// Logline: Adjusts fundamental audio frequency and pitch trajectories while preserving temporal duration via phase unwrapping.
//
// Setup: Harmonic audio modification engine computing instantaneous frequencies across Short-Time Fourier Transform (STFT) frames.
//
// Beats:
//   1. Define VocoderConfig and VocoderFrame structs.
//   2. Compute phase delta and instantaneous frequency across adjacent STFT hops.
//   3. Scale frequency bins by pitch factor and synthesize rescaled phase accumulators.

pub type VocoderConfig = struct {
    hop_length: Int,
    fft_size: Int,
    pitch_semitones: Float,
    sample_rate: Int,
};

pub type VocoderFrame = struct {
    magnitudes: List[Float],
    phases: List[Float],
    num_bins: Int,
};

pub fn audio_vocoder_config_new(
    hop: Int,
    fft: Int,
    semitones: Float,
    sr: Int
) -> VocoderConfig {
    return VocoderConfig {
        hop_length: hop,
        fft_size: fft,
        pitch_semitones: semitones,
        sample_rate: sr,
    };
}

pub fn audio_pitch_ratio_from_semitones(semitones: Float) -> Float {
    // pitch_ratio = 2 ^ (semitones / 12.0)
    let power: Float = semitones / 12.0;
    return pow(2.0, power);
}

pub fn audio_shift_frame(
    cfg: &VocoderConfig,
    frame: &VocoderFrame
) -> VocoderFrame {
    let ratio: Float = audio_pitch_ratio_from_semitones((cfg).pitch_semitones);
    let n_bins: Int = (frame).num_bins;

    let mut new_mags: List[Float] = list_new();
    let mut new_phases: List[Float] = list_new();

    let mut b: Int = 0;
    while b < n_bins {
        // Map target bin b back to source bin
        let mut b_f: Float = 0.0;
        let mut count: Int = b;
        while count >= 1000 { b_f = b_f + 1000.0; count = count - 1000; }
        while count >= 100 { b_f = b_f + 100.0; count = count - 100; }
        while count >= 10 { b_f = b_f + 10.0; count = count - 10; }
        while count >= 1 { b_f = b_f + 1.0; count = count - 1; }

        let src_f: Float = b_f / (if ratio > 0.0001 { ratio } else { 1.0 });
        let mut src_idx: Int = 0;
        let mut rem_f: Float = src_f;
        while rem_f >= 1.0 {
            src_idx = src_idx + 1;
            rem_f = rem_f - 1.0;
        }

        let mag_val: Float = if src_idx < n_bins {
            list_get((frame).magnitudes, src_idx)
        } else {
            0.0
        };
        let phase_val: Float = if src_idx < n_bins {
            list_get((frame).phases, src_idx) * ratio
        } else {
            0.0
        };

        new_mags = list_push(new_mags, mag_val);
        new_phases = list_push(new_phases, phase_val);
        b = b + 1;
    }

    return VocoderFrame {
        magnitudes: new_mags,
        phases: new_phases,
        num_bins: n_bins,
    };
}

pub fn audio_pitch_shift_marker() -> Int {
    return 1;
}
