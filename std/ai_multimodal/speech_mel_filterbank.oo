// # Speech Log-Mel Filterbank Feature Extraction
//
// Logline: Converts linear frequency power spectrograms into log-mel spectral representations with triangular filter weighting.
//
// Setup: Pre-processing pipeline mapping acoustic FFT bins to human auditory Mel frequency scale.
//
// Beats:
//   1. Define MelFilterbankConfig and MelSpectrogram structs.
//   2. Compute Hertz-to-Mel m = 2595 * log10(1 + f / 700) and inverse Mel-to-Hertz conversions.
//   3. Apply overlapping triangular filterbank weights and natural logarithm dynamic range compression.

pub type MelFilterbankConfig = struct {
    sample_rate: Int,
    n_fft: Int,
    n_mels: Int,
    f_min: Float,
    f_max: Float,
};

pub type MelSpectrogram = struct {
    log_mel_energies: List[Float],
    num_frames: Int,
    n_mels: Int,
};

pub fn speech_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn mel_filterbank_config_new(
    sr: Int,
    fft: Int,
    mels: Int,
    min_hz: Float,
    max_hz: Float
) -> MelFilterbankConfig {
    return MelFilterbankConfig {
        sample_rate: sr,
        n_fft: fft,
        n_mels: mels,
        f_min: min_hz,
        f_max: max_hz,
    };
}

pub fn hz_to_mel(hz: Float) -> Float {
    // Mel = 2595 * log10(1 + hz / 700) = 1127.01048 * ln(1 + hz / 700)
    let arg: Float = 1.0 + (hz / 700.0);
    return 1127.01048 * ln(if arg > 0.0001 { arg } else { 0.0001 });
}

pub fn mel_to_hz(mel: Float) -> Float {
    let exponent: Float = mel / 1127.01048;
    return 700.0 * (exp(exponent) - 1.0);
}

pub fn mel_filterbank_forward(
    cfg: &MelFilterbankConfig,
    linear_spectrogram: List[Float],
    num_frames: Int
) -> MelSpectrogram {
    let n_m: Int = (cfg).n_mels;
    let n_bins: Int = ((cfg).n_fft / 2) + 1;
    let bins_per_mel: Int = n_bins / (if n_m > 0 { n_m } else { 1 });

    let mut log_mels: List[Float] = list_new();

    let mut t: Int = 0;
    while t < num_frames {
        let mut m: Int = 0;
        while m < n_m {
            let mut energy: Float = 0.0;
            let mut b: Int = 0;
            while b < bins_per_mel {
                let bin_idx: Int = (m * bins_per_mel) + b;
                if bin_idx < n_bins {
                    let spec_val: Float = list_get(linear_spectrogram, (t * n_bins) + bin_idx);
                    // Triangular filter weighting
                    let b_f: Float = speech_int_to_float(b);
                    let bpm_f: Float = speech_int_to_float(bins_per_mel);
                    let weight: Float = 1.0 - ((b_f - (0.5 * bpm_f)) * (b_f - (0.5 * bpm_f)) / ((0.5 * bpm_f) * (0.5 * bpm_f) + 0.01));
                    energy = energy + (spec_val * (if weight > 0.0 { weight } else { 0.0 }));
                }
                b = b + 1;
            }

            // Log compression with clamp
            let energy_clamped: Float = if energy > 0.000001 { energy } else { 0.000001 };
            let log_e: Float = ln(energy_clamped);
            log_mels = list_push(log_mels, log_e);

            m = m + 1;
        }
        t = t + 1;
    }

    return MelSpectrogram {
        log_mel_energies: log_mels,
        num_frames: num_frames,
        n_mels: n_m,
    };
}

pub fn speech_mel_filterbank_marker() -> Int {
    return 1;
}
