// # IEEE 1588 PTP Hardware Clock Synchronization
//
// Logline: Synchronizes exchange network timestamps with host hardware clocks and tracks NIC ingress/egress latency jitter.
//
// Setup: PTP nanosecond time synchronizer calculating clock offsets, one-way network delays, and latency timestamps.
//
// Beats:
//   1. Define PtpClockOffset, NicTimestampTelemetry, and PtpClockState structures.
//   2. Calculate master-slave offset using IEEE 1588 four-timestamp formulas (t1, t2, t3, t4).
//   3. Compute wire-to-application queue latencies and detect clock skew drift.

pub type PtpClockOffset = struct {
    master_to_slave_delay_ns: Int,
    slave_to_master_delay_ns: Int,
    mean_path_delay_ns: Int,
    clock_offset_ns: Int,
    is_synchronized: Bool
};

pub type NicTimestampTelemetry = struct {
    nic_ingress_ts_ns: Int,
    kernel_ts_ns: Int,
    app_ingress_ts_ns: Int,
    app_egress_ts_ns: Int,
    nic_egress_ts_ns: Int
};

pub type PtpClockState = struct {
    current_offset_ns: Int,
    drift_rate_ppm: Float,
    sync_count: Int,
    last_sync_ts_ns: Int
};

pub fn ptp_clock_state_new() -> PtpClockState {
    return PtpClockState {
        current_offset_ns: 0,
        drift_rate_ppm: 0.0,
        sync_count: 0,
        last_sync_ts_ns: 0
    };
}

pub fn calculate_ptp_offset(
    t1_master_tx_ns: Int,
    t2_slave_rx_ns: Int,
    t3_slave_tx_ns: Int,
    t4_master_rx_ns: Int
) -> PtpClockOffset {
    let m2s: Int = t2_slave_rx_ns - t1_master_tx_ns;
    let s2m: Int = t4_master_rx_ns - t3_slave_tx_ns;
    let mean_delay: Int = (m2s + s2m) / 2;
    let offset: Int = (m2s - s2m) / 2;

    let syncd: Bool = (mean_delay >= 0) && (offset > -50000) && (offset < 50000);

    return PtpClockOffset {
        master_to_slave_delay_ns: m2s,
        slave_to_master_delay_ns: s2m,
        mean_path_delay_ns: mean_delay,
        clock_offset_ns: offset,
        is_synchronized: syncd
    };
}

pub fn ptp_update_clock_state(state: &mut PtpClockState, offset: &PtpClockOffset, now_ns: Int) {
    (state).current_offset_ns = (offset).clock_offset_ns;
    (state).sync_count = (state).sync_count + 1;
    (state).last_sync_ts_ns = now_ns;
}

pub fn compute_nic_to_app_latency(telemetry: &NicTimestampTelemetry) -> Int {
    let diff: Int = (telemetry).app_ingress_ts_ns - (telemetry).nic_ingress_ts_ns;
    return if diff > 0 { diff } else { 0 };
}
