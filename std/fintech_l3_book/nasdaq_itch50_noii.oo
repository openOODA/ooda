// # NASDAQ Net Order Imbalance Indicator (NOII)
//
// Logline: Decodes and tracks NOII auction imbalances, paired shares, far/near indicative clearing prices, and cross types.
//
// Setup: Market auction analytics module for opening, closing, halt, and IPO crossing auctions on NASDAQ.
//
// Beats:
//   1. Define NoiiMessage, AuctionCrossType, and NoiiAuctionState structures.
//   2. Calculate net imbalance direction, unmarketable share volume, and price pressure.
//   3. Implement NOII snapshot evaluation for cross auction execution forecasting.

pub type NoiiMessage = struct {
    timestamp_ns: Int,
    stock: String,
    paired_shares: Int,
    imbalance_shares: Int,
    imbalance_direction: String,
    cross_type: String,
    far_price_fixed: Int,
    near_price_fixed: Int,
    current_reference_price_fixed: Int,
    price_variation_indicator: String,
};

pub type NoiiAuctionState = struct {
    stock: String,
    cross_type: String,
    latest_paired_shares: Int,
    latest_imbalance_shares: Int,
    latest_direction: String,
    near_price_fixed: Int,
    far_price_fixed: Int,
    reference_price_fixed: Int,
    updates_count: Int,
};

pub fn noii_message_new(
    ts: Int,
    symbol: String,
    paired: Int,
    imbalance: Int,
    dir: String,
    cross: String,
    far_px: Int,
    near_px: Int,
    ref_px: Int,
    var_ind: String
) -> NoiiMessage {
    return NoiiMessage {
        timestamp_ns: ts,
        stock: symbol,
        paired_shares: paired,
        imbalance_shares: imbalance,
        imbalance_direction: dir,
        cross_type: cross,
        far_price_fixed: far_px,
        near_price_fixed: near_px,
        current_reference_price_fixed: ref_px,
        price_variation_indicator: var_ind,
    };
}

pub fn noii_auction_state_new(symbol: String, cross: String) -> NoiiAuctionState {
    return NoiiAuctionState {
        stock: symbol,
        cross_type: cross,
        latest_paired_shares: 0,
        latest_imbalance_shares: 0,
        latest_direction: "N",
        near_price_fixed: 0,
        far_price_fixed: 0,
        reference_price_fixed: 0,
        updates_count: 0,
    };
}

pub fn noii_update_auction_state(
    state: &mut NoiiAuctionState,
    msg: &NoiiMessage
) {
    (state).stock = (msg).stock;
    (state).cross_type = (msg).cross_type;
    (state).latest_paired_shares = (msg).paired_shares;
    (state).latest_imbalance_shares = (msg).imbalance_shares;
    (state).latest_direction = (msg).imbalance_direction;
    (state).near_price_fixed = (msg).near_price_fixed;
    (state).far_price_fixed = (msg).far_price_fixed;
    (state).reference_price_fixed = (msg).current_reference_price_fixed;
    (state).updates_count = (state).updates_count + 1;
}

pub fn noii_is_buy_imbalance(msg: &NoiiMessage) -> Bool {
    return (msg).imbalance_direction == "B";
}

pub fn noii_is_sell_imbalance(msg: &NoiiMessage) -> Bool {
    return (msg).imbalance_direction == "S";
}

pub fn noii_is_auction_cleared(msg: &NoiiMessage) -> Bool {
    return (msg).imbalance_shares == 0;
}

pub fn noii_compute_imbalance_ratio(paired: Int, imbalance: Int) -> Float {
    let total: Int = paired + imbalance;
    if total <= 0 {
        return 0.0;
    }
    let mut imb_f: Float = 0.0;
    let mut tot_f: Float = 0.0;
    let mut c_imb: Int = imbalance;
    while c_imb >= 1000 { imb_f = imb_f + 1000.0; c_imb = c_imb - 1000; }
    while c_imb >= 1 { imb_f = imb_f + 1.0; c_imb = c_imb - 1; }

    let mut c_tot: Int = total;
    while c_tot >= 1000 { tot_f = tot_f + 1000.0; c_tot = c_tot - 1000; }
    while c_tot >= 1 { tot_f = tot_f + 1.0; c_tot = c_tot - 1; }

    return imb_f / tot_f;
}
