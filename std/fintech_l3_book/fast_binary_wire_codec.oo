// # Ultra-Fast Binary Wire Codec
//
// Logline: Provides low-overhead big-endian integer, 4-decimal fixed point, and alphanumeric wire conversion utilities.
//
// Setup: Low-level serialization codec optimized for ITCH 5.0 and OUCH 5.0 binary protocol formatting.
//
// Beats:
//   1. Implement integer-to-fixed-point decimal conversion functions.
//   2. Encode and decode 4-byte and 8-byte big-endian binary integers.
//   3. Handle padded ASCII ticker symbol tokenization and normalization.

pub type PriceFixedPoint = struct {
    raw_integer: Int,
    scale: Int,
};

pub fn price_fixed_from_float(price: Float) -> Int {
    let scaled: Float = price * 10000.0;
    let mut rounded_int: Int = 0;
    let mut temp_s: Float = scaled;
    while temp_s >= 10000.0 { rounded_int = rounded_int + 10000; temp_s = temp_s - 10000.0; }
    while temp_s >= 100.0 { rounded_int = rounded_int + 100; temp_s = temp_s - 100.0; }
    while temp_s >= 1.0 { rounded_int = rounded_int + 1; temp_s = temp_s - 1.0; }
    return rounded_int;
}

pub fn price_fixed_to_float(raw: Int) -> Float {
    let mut f_val: Float = 0.0;
    let mut temp_r: Int = raw;
    let is_neg: Bool = temp_r < 0;
    if is_neg { temp_r = 0 - temp_r; }

    while temp_r >= 10000 { f_val = f_val + 10000.0; temp_r = temp_r - 10000; }
    while temp_r >= 100 { f_val = f_val + 100.0; temp_r = temp_r - 100; }
    while temp_r >= 1 { f_val = f_val + 1.0; temp_r = temp_r - 1; }

    let result: Float = f_val / 10000.0;
    return if is_neg { 0.0 - result } else { result };
}

pub fn price_fixed_new(raw: Int) -> PriceFixedPoint {
    return PriceFixedPoint {
        raw_integer: raw,
        scale: 4,
    };
}

pub fn encode_uint16_be(val: Int) -> Int {
    let high: Int = (val / 256) % 256;
    let low: Int = val % 256;
    return (high * 256) + low;
}

pub fn decode_uint16_be(byte0: Int, byte1: Int) -> Int {
    return (byte0 * 256) + byte1;
}

pub fn decode_uint32_be(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    return (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3;
}
