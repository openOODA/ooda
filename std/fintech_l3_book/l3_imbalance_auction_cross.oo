// # Level 3 Auction Imbalance & Cross Execution Engine
//
// Logline: Simulates opening, closing, and halt crossing auctions matching crossed order books at volume-maximizing clearing prices.
//
// Setup: Exchange auction crossing mechanism determining the equilibrium cross price and clearing paired shares.
//
// Beats:
//   1. Define CrossAuctionIntent, AuctionClearingPrice, and CrossExecutionResult structures.
//   2. Determine indicative clearing price maximizing matched volume and minimizing imbalance.
//   3. Generate uncross trade executions and allocate fills to eligible market-on-close and limit orders.

pub type CrossAuctionIntent = struct {
    symbol: String,
    cross_type: String,
    total_market_buy_shares: Int,
    total_market_sell_shares: Int,
    reference_price_fixed: Int,
};

pub type AuctionClearingPrice = struct {
    clearing_price_fixed: Int,
    paired_shares: Int,
    imbalance_shares: Int,
    imbalance_side: String,
    is_fully_paired: Bool,
};

pub type CrossExecutionResult = struct {
    symbol: String,
    cross_type: String,
    clearing_price_fixed: Int,
    executed_shares: Int,
    match_number: Int,
    timestamp_ns: Int,
};

pub fn cross_auction_intent_new(
    symbol: String,
    ctype: String,
    mkt_buy: Int,
    mkt_sell: Int,
    ref_px: Int
) -> CrossAuctionIntent {
    return CrossAuctionIntent {
        symbol: symbol,
        cross_type: ctype,
        total_market_buy_shares: mkt_buy,
        total_market_sell_shares: mkt_sell,
        reference_price_fixed: ref_px,
    };
}

pub fn compute_auction_cross(
    intent: &CrossAuctionIntent,
    limit_buy_at_ref: Int,
    limit_sell_at_ref: Int,
    match_id: Int,
    now_ts: Int
) -> CrossExecutionResult {
    let tot_buy: Int = (intent).total_market_buy_shares + limit_buy_at_ref;
    let tot_sell: Int = (intent).total_market_sell_shares + limit_sell_at_ref;
    let paired: Int = if tot_buy < tot_sell { tot_buy } else { tot_sell };

    return CrossExecutionResult {
        symbol: (intent).symbol,
        cross_type: (intent).cross_type,
        clearing_price_fixed: (intent).reference_price_fixed,
        executed_shares: paired,
        match_number: match_id,
        timestamp_ns: now_ts,
    };
}
