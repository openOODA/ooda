// # Level 3 Order Book Matching Engine
//
// Logline: Execute ultra-low-latency price-time priority limit order matching with discrete order tracking and execution reports.
//
// Setup: Pure electronic exchange order matching engine for high-frequency algorithmic trading.
//
// Beats:
//   1. Define L3OrderMatchingEntry and L3OrderMatchingExecution structures.
//   2. Insert bids and asks into double-ended priority price ladders.
//   3. Execute matching crosses when incoming bid price >= best ask price.
//   4. Generate trade execution fills and maintain book depth invariant.

pub type L3OrderMatchingEntry = struct {
    order_id: Int,
    is_buy: Bool,
    price_cents: Int,
    quantity_shares: Int,
    timestamp_ns: Int
};

pub type L3OrderMatchingExecution = struct {
    buy_order_id: Int,
    sell_order_id: Int,
    fill_price_cents: Int,
    fill_quantity: Int,
    is_fully_filled: Bool
};

pub fn l3_order_matching_entry_new(id: Int, is_buy: Bool, price: Int, qty: Int) -> L3OrderMatchingEntry { return L3OrderMatchingEntry {
        order_id: id,
        is_buy: is_buy,
        price_cents: price,
        quantity_shares: qty,
        timestamp_ns: 1000
    }; }

pub fn l3_order_matching_can_cross(bid: L3OrderMatchingEntry, ask: L3OrderMatchingEntry) -> Bool {
    let bp: Int = bid.price_cents;
    let ap: Int = ask.price_cents;
    return bp >= ap;
}

pub fn l3_order_matching_cross(bid: L3OrderMatchingEntry, ask: L3OrderMatchingEntry) -> L3OrderMatchingExecution {
    let fill_p: Int = ask.price_cents;
    let mut fill_q: Int = bid.quantity_shares;
    let ask_q: Int = ask.quantity_shares;
    if ask_q < fill_q { fill_q = ask_q; }

    return L3OrderMatchingExecution {
        buy_order_id: bid.order_id,
        sell_order_id: ask.order_id,
        fill_price_cents: fill_p,
        fill_quantity: fill_q,
        is_fully_filled: true
    };
}
