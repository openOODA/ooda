// # NASDAQ Glimpse Snapshot Protocol Handler
//
// Logline: Manages point-to-point book snapshot recovery and synchronization with live ITCH 5.0 feeds.
//
// Setup: State recovery module parsing Glimpse state-of-book messages and reconciling snapshot sequence checkpoints.
//
// Beats:
//   1. Define GlimpseSnapshotHeader, GlimpseOrderRecord, and GlimpseSessionState structures.
//   2. Parse Glimpse start, order state, and end-of-snapshot marker messages.
//   3. Compute snapshot synchronization sequence number for seamless live feed cutover.

pub type GlimpseSnapshotHeader = struct {
    sequence_number: Int,
    snapshot_timestamp_ns: Int,
    stock: String
};

pub type GlimpseOrderRecord = struct {
    order_id: Int,
    buy_sell_indicator: String,
    shares: Int,
    stock: String,
    price_fixed: Int
};

pub type GlimpseSessionState = struct {
    is_in_snapshot: Bool,
    snapshot_complete: Bool,
    sync_sequence_number: Int,
    orders_loaded: Int,
    total_shares_loaded: Int
};

pub fn glimpse_session_new() -> GlimpseSessionState {
    return GlimpseSessionState {
        is_in_snapshot: false,
        snapshot_complete: false,
        sync_sequence_number: 0,
        orders_loaded: 0,
        total_shares_loaded: 0
    };
}

pub fn glimpse_order_record_new(
    oid: Int,
    side: String,
    qty: Int,
    symbol: String,
    px: Int
) -> GlimpseOrderRecord {
    return GlimpseOrderRecord {
        order_id: oid,
        buy_sell_indicator: side,
        shares: qty,
        stock: symbol,
        price_fixed: px
    };
}

pub fn glimpse_start_snapshot(
    state: &mut GlimpseSessionState,
    sync_seq: Int
) {
    (state).is_in_snapshot = true;
    (state).snapshot_complete = false;
    (state).sync_sequence_number = sync_seq;
    (state).orders_loaded = 0;
    (state).total_shares_loaded = 0;
}

pub fn glimpse_add_order(
    state: &mut GlimpseSessionState,
    order: &GlimpseOrderRecord
) {
    if (state).is_in_snapshot {
        (state).orders_loaded = (state).orders_loaded + 1;
        (state).total_shares_loaded = (state).total_shares_loaded + (order).shares;
    }
}

pub fn glimpse_end_snapshot(
    state: &mut GlimpseSessionState,
    end_seq: Int
) -> Bool {
    (state).is_in_snapshot = false;
    (state).snapshot_complete = true;
    (state).sync_sequence_number = end_seq;
    return true;
}

pub fn glimpse_is_order_in_sync(
    seq_number: Int,
    state: &GlimpseSessionState
) -> Bool {
    if !(state).snapshot_complete {
        return false;
    }
    return seq_number > (state).sync_sequence_number;
}
