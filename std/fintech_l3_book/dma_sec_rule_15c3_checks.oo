// # US SEC Rule 15c3-5 Market Access Risk Controls
//
// Logline: Implements regulatory pre-trade controls under SEC Rule 15c3-5 for direct market access broker-dealers.
//
// Setup: Regulatory risk compliance engine ensuring financial risk thresholds and supervisory controls on DMA order flow.
//
// Beats:
//   1. Define Rule15c3Config, AccountCapitalThreshold, and Compliance15c3Result structures.
//   2. Check aggregate customer capital utilization against assigned credit thresholds.
//   3. Enforce algorithmic sanity checks, erroneous order blocking, and post-trade credit alerts.

pub type Rule15c3Config = struct {
    broker_mpid: String,
    enforce_pretrade_credit: Bool,
    enforce_erroneous_order_block: Bool,
    max_account_capital_usage_pct: Float,
};

pub type AccountCapitalThreshold = struct {
    account_id: String,
    total_credit_limit_fixed: Int,
    current_utilized_fixed: Int,
    daily_settled_fixed: Int,
};

pub type Compliance15c3Result = struct {
    approved: Bool,
    account_id: String,
    post_order_utilization_pct: Float,
    violation_code: String,
};

pub fn rule15c3_config_default(mpid: String) -> Rule15c3Config {
    return Rule15c3Config {
        broker_mpid: mpid,
        enforce_pretrade_credit: true,
        enforce_erroneous_order_block: true,
        max_account_capital_usage_pct: 95.0,
    };
}

pub fn account_capital_threshold_new(acct: String, limit: Int) -> AccountCapitalThreshold {
    return AccountCapitalThreshold {
        account_id: acct,
        total_credit_limit_fixed: limit,
        current_utilized_fixed: 0,
        daily_settled_fixed: 0,
    };
}

pub fn check_rule15c3_compliance(
    cfg: &Rule15c3Config,
    threshold: &AccountCapitalThreshold,
    order_notional_fixed: Int
) -> Compliance15c3Result {
    if !(cfg).enforce_pretrade_credit {
        return Compliance15c3Result {
            approved: true,
            account_id: (threshold).account_id,
            post_order_utilization_pct: 0.0,
            violation_code: "BYPASSED",
        };
    }

    let projected_utilized: Int = (threshold).current_utilized_fixed + order_notional_fixed;
    if (threshold).total_credit_limit_fixed <= 0 {
        return Compliance15c3Result {
            approved: false,
            account_id: (threshold).account_id,
            post_order_utilization_pct: 100.0,
            violation_code: "NO_CREDIT_LIMIT_SET",
        };
    }

    let mut util_f: Float = 0.0;
    let mut lim_f: Float = 0.0;
    let mut cu: Int = projected_utilized;
    while cu >= 1000000 { util_f = util_f + 1000000.0; cu = cu - 1000000; }
    while cu >= 1000 { util_f = util_f + 1000.0; cu = cu - 1000; }
    while cu >= 1 { util_f = util_f + 1.0; cu = cu - 1; }

    let mut cl: Int = (threshold).total_credit_limit_fixed;
    while cl >= 1000000 { lim_f = lim_f + 1000000.0; cl = cl - 1000000; }
    while cl >= 1000 { lim_f = lim_f + 1000.0; cl = cl - 1000; }
    while cl >= 1 { lim_f = lim_f + 1.0; cl = cl - 1; }

    let pct: Float = (util_f / lim_f) * 100.0;
    let is_ok: Bool = pct <= (cfg).max_account_capital_usage_pct;

    let vcode: String = if is_ok { "APPROVED" } else { "CREDIT_THRESHOLD_BREACHED" };

    return Compliance15c3Result {
        approved: is_ok,
        account_id: (threshold).account_id,
        post_order_utilization_pct: pct,
        violation_code: vcode,
    };
}
