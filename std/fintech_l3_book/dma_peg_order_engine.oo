// # Direct Market Access Pegged Order Engine
//
// Logline: Tracks NBBO changes and automatically calculates dynamic price pegs for primary, market, and midpoint pegged orders.
//
// Setup: DMA algorithmic order engine adjusting resting order prices relative to moving market reference points.
//
// Beats:
//   1. Define PeggedOrder, PegType, and PegRepriceEvent structures.
//   2. Calculate new pegged order prices against best bid, best ask, and midpoint.
//   3. Apply discretionary offsets, limit price caps, and tick boundary roundings.

pub type PeggedOrder = struct {
    user_ref_number: Int,
    side: String,
    shares: Int,
    symbol: String,
    peg_type: String,
    offset_fixed: Int,
    limit_cap_price_fixed: Int,
    current_order_price_fixed: Int,
    is_active: Bool
};

pub type PegRepriceEvent = struct {
    user_ref_number: Int,
    old_price_fixed: Int,
    new_price_fixed: Int,
    needs_exchange_replace: Bool,
    timestamp_ns: Int
};

pub fn pegged_order_new(
    ref_num: Int,
    side: String,
    qty: Int,
    symbol: String,
    ptype: String,
    offset: Int,
    cap_px: Int
) -> PeggedOrder {
    return PeggedOrder {
        user_ref_number: ref_num,
        side: side,
        shares: qty,
        symbol: symbol,
        peg_type: ptype,
        offset_fixed: offset,
        limit_cap_price_fixed: cap_px,
        current_order_price_fixed: 0,
        is_active: true
    };
}

pub fn calculate_peg_price(
    order: &PeggedOrder,
    best_bid_fixed: Int,
    best_ask_fixed: Int,
    now_ts: Int
) -> PegRepriceEvent {
    let ptype: String = (order).peg_type;
    let is_buy: Bool = (order).side == "B";
    let mut calculated_px: Int = 0;

    if ptype == "PRIMARY" {
        calculated_px = if is_buy { best_bid_fixed + (order).offset_fixed } else { best_ask_fixed - (order).offset_fixed };
    } else if ptype == "MARKET" {
        calculated_px = if is_buy { best_ask_fixed + (order).offset_fixed } else { best_bid_fixed - (order).offset_fixed };
    } else if ptype == "MIDPOINT" {
        calculated_px = (best_bid_fixed + best_ask_fixed) / 2;
    }

    if (order).limit_cap_price_fixed > 0 {
        if is_buy && calculated_px > (order).limit_cap_price_fixed {
            calculated_px = (order).limit_cap_price_fixed;
        } else if !is_buy && calculated_px < (order).limit_cap_price_fixed {
            calculated_px = (order).limit_cap_price_fixed;
        }
    }

    let needs_update: Bool = calculated_px != (order).current_order_price_fixed && calculated_px > 0;

    return PegRepriceEvent {
        user_ref_number: (order).user_ref_number,
        old_price_fixed: (order).current_order_price_fixed,
        new_price_fixed: calculated_px,
        needs_exchange_replace: needs_update,
        timestamp_ns: now_ts
    };
}

pub fn apply_peg_reprice(order: &mut PeggedOrder, reprice: &PegRepriceEvent) {
    if (reprice).needs_exchange_replace {
        (order).current_order_price_fixed = (reprice).new_price_fixed;
    }
}
