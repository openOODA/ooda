// # Best-Bid-Offer (BBO) Quote Disseminator
//
// Logline: Detects changes in top-of-book prices and sizes and formats incremental BBO quote update events.
//
// Setup: Low-latency quote engine publishing incremental BBO updates only when top price or aggregate size changes.
//
// Beats:
//   1. Define BboQuoteMessage, BboFilterState, and QuoteDisseminationMetrics structures.
//   2. Compare incoming top-of-book against previous published BBO state.
//   3. Suppress redundant updates and publish delta events with microsecond timestamps.

pub type BboQuoteMessage = struct {
    symbol: String,
    bid_price_fixed: Int,
    bid_shares: Int,
    ask_price_fixed: Int,
    ask_shares: Int,
    mid_price_fixed: Int,
    spread_fixed: Int,
    timestamp_ns: Int
};

pub type BboFilterState = struct {
    symbol: String,
    last_bid_price_fixed: Int,
    last_bid_shares: Int,
    last_ask_price_fixed: Int,
    last_ask_shares: Int,
    quotes_disseminated: Int,
    quotes_suppressed: Int
};

pub fn bbo_filter_state_new(symbol: String) -> BboFilterState {
    return BboFilterState {
        symbol: symbol,
        last_bid_price_fixed: 0,
        last_bid_shares: 0,
        last_ask_price_fixed: 0,
        last_ask_shares: 0,
        quotes_disseminated: 0,
        quotes_suppressed: 0
    };
}

pub fn bbo_quote_message_new(
    symbol: String,
    bid_px: Int,
    bid_qty: Int,
    ask_px: Int,
    ask_qty: Int,
    ts: Int
) -> BboQuoteMessage {
    let mid_px: Int = (bid_px + ask_px) / 2;
    let spread: Int = if ask_px >= bid_px && bid_px > 0 { ask_px - bid_px } else { 0 };

    return BboQuoteMessage {
        symbol: symbol,
        bid_price_fixed: bid_px,
        bid_shares: bid_qty,
        ask_price_fixed: ask_px,
        ask_shares: ask_qty,
        mid_price_fixed: mid_px,
        spread_fixed: spread,
        timestamp_ns: ts
    };
}

pub fn evaluate_and_disseminate_bbo(
    state: &mut BboFilterState,
    new_bid_px: Int,
    new_bid_qty: Int,
    new_ask_px: Int,
    new_ask_qty: Int,
    now_ts: Int
) -> BboQuoteMessage {
    let changed: Bool = (new_bid_px != (state).last_bid_price_fixed) ||
                        (new_bid_qty != (state).last_bid_shares) ||
                        (new_ask_px != (state).last_ask_price_fixed) ||
                        (new_ask_qty != (state).last_ask_shares);

    if !changed {
        (state).quotes_suppressed = (state).quotes_suppressed + 1;
        return bbo_quote_message_new((state).symbol, 0, 0, 0, 0, 0);
    }

    (state).last_bid_price_fixed = new_bid_px;
    (state).last_bid_shares = new_bid_qty;
    (state).last_ask_price_fixed = new_ask_px;
    (state).last_ask_shares = new_ask_qty;
    (state).quotes_disseminated = (state).quotes_disseminated + 1;

    return bbo_quote_message_new((state).symbol, new_bid_px, new_bid_qty, new_ask_px, new_ask_qty, now_ts);
}
