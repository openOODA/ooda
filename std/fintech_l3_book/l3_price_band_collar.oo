// # Limit Up / Limit Down (LULD) Price Band Collar
//
// Logline: Calculates regulatory LULD price bands and rejects aggressive orders breaching statutory price collar corridors.
//
// Setup: Price volatility safeguard module implementing US National Market System Plan to Address Extraordinary Market Volatility (LULD).
//
// Beats:
//   1. Define LuldBand, SecurityTier, and LuldCheckResult structures.
//   2. Calculate upper and lower price bands based on 5-minute reference prices and percentage widths.
//   3. Classify straddle states and reject unexecutable orders beyond allowable bands.

pub type LuldBand = struct {
    symbol: String,
    reference_price_fixed: Int,
    upper_band_fixed: Int,
    lower_band_fixed: Int,
    band_percentage_bps: Int,
    is_straddle_state: Bool,
    timestamp_ns: Int
};

pub type LuldCheckResult = struct {
    is_order_acceptable: Bool,
    is_straddle_state: Bool,
    clamped_price_fixed: Int,
    reject_reason: String
};

pub fn luld_band_new(
    symbol: String,
    ref_px: Int,
    band_bps: Int,
    ts: Int
) -> LuldBand {
    let delta: Int = (ref_px * band_bps) / 10000;
    let upper: Int = ref_px + delta;
    let mut lower: Int = ref_px - delta;
    if lower < 0 { lower = 0; }

    return LuldBand {
        symbol: symbol,
        reference_price_fixed: ref_px,
        upper_band_fixed: upper,
        lower_band_fixed: lower,
        band_percentage_bps: band_bps,
        is_straddle_state: false,
        timestamp_ns: ts
    };
}

pub fn check_luld_price_collar(
    band: &LuldBand,
    side: String,
    order_price_fixed: Int
) -> LuldCheckResult {
    let is_buy: Bool = side == "B";

    if is_buy && order_price_fixed > (band).upper_band_fixed {
        return LuldCheckResult {
            is_order_acceptable: false,
            is_straddle_state: (band).is_straddle_state,
            clamped_price_fixed: (band).upper_band_fixed,
            reject_reason: "LULD_UPPER_BAND_BREACH"
        };
    }

    if !is_buy && order_price_fixed < (band).lower_band_fixed {
        return LuldCheckResult {
            is_order_acceptable: false,
            is_straddle_state: (band).is_straddle_state,
            clamped_price_fixed: (band).lower_band_fixed,
            reject_reason: "LULD_LOWER_BAND_BREACH"
        };
    }

    return LuldCheckResult {
        is_order_acceptable: true,
        is_straddle_state: (band).is_straddle_state,
        clamped_price_fixed: order_price_fixed,
        reject_reason: "ACCEPTED"
    };
}
