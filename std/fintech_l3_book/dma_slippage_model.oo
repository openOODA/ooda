// # Direct Market Access Slippage & Market Impact Estimator
//
// Logline: Estimates pre-trade expected slippage from Level 3 order book depth and compares against realized post-trade execution prices.
//
// Setup: Quantitative execution model quantifying market friction, liquidity consumption costs, and implementation shortfall.
//
// Beats:
//   1. Define SlippageEstimate, RealizedSlippageMetrics, and DepthConsumptionModel structures.
//   2. Compute expected execution price by walking order book price levels.
//   3. Calculate slippage in basis points relative to initial arrival midprice.

pub type SlippageEstimate = struct {
    symbol: String,
    shares: Int,
    arrival_midprice_fixed: Int,
    expected_vwap_fixed: Int,
    expected_slippage_bps: Int,
    levels_consumed: Int,
};

pub type RealizedSlippageMetrics = struct {
    symbol: String,
    executed_shares: Int,
    arrival_midprice_fixed: Int,
    realized_vwap_fixed: Int,
    realized_slippage_bps: Int,
    slippage_variance_bps: Int,
};

pub fn slippage_estimate_new(
    symbol: String,
    shares: Int,
    arrival_px: Int,
    vwap_px: Int,
    levels: Int
) -> SlippageEstimate {
    let diff: Int = vwap_px - arrival_px;
    let abs_diff: Int = if diff < 0 { 0 - diff } else { diff };
    let bps: Int = if arrival_px > 0 { (abs_diff * 10000) / arrival_px } else { 0 };

    return SlippageEstimate {
        symbol: symbol,
        shares: shares,
        arrival_midprice_fixed: arrival_px,
        expected_vwap_fixed: vwap_px,
        expected_slippage_bps: bps,
        levels_consumed: levels,
    };
}

pub fn calculate_realized_slippage(
    symbol: String,
    shares: Int,
    arrival_px: Int,
    realized_vwap: Int,
    expected_bps: Int
) -> RealizedSlippageMetrics {
    let diff: Int = realized_vwap - arrival_px;
    let abs_diff: Int = if diff < 0 { 0 - diff } else { diff };
    let real_bps: Int = if arrival_px > 0 { (abs_diff * 10000) / arrival_px } else { 0 };
    let var_diff: Int = real_bps - expected_bps;
    let var_bps: Int = if var_diff < 0 { 0 - var_diff } else { var_diff };

    return RealizedSlippageMetrics {
        symbol: symbol,
        executed_shares: shares,
        arrival_midprice_fixed: arrival_px,
        realized_vwap_fixed: realized_vwap,
        realized_slippage_bps: real_bps,
        slippage_variance_bps: var_bps,
    };
}
