// # Direct Market Access Short Sale Locate & Reg SHO Tracker
//
// Logline: Tracks locate source identifiers, available borrow inventory, and enforces SEC Reg SHO Rule 201 circuit breaker restrictions.
//
// Setup: DMA compliance module ensuring valid borrow locates and uptick test enforcement during SSR restriction periods.
//
// Beats:
//   1. Define LocateRecord, RegShoSsrState, and ShortSaleCheckResult structures.
//   2. Verify available borrow shares and deduct allocated locate quantities.
//   3. Validate short sale order price against National Best Bid when SSR is active.

pub type LocateRecord = struct {
    locate_id: String,
    symbol: String,
    total_borrow_shares: Int,
    allocated_shares: Int,
    is_easy_to_borrow: Bool,
    expiry_timestamp_ns: Int
};

pub type RegShoSsrState = struct {
    symbol: String,
    is_ssr_active: Bool,
    trigger_timestamp_ns: Int,
    deactivation_timestamp_ns: Int
};

pub type ShortSaleCheckResult = struct {
    approved: Bool,
    short_sale_type: String,
    reject_reason: String,
    remaining_locate_shares: Int
};

pub fn locate_record_new(
    loc_id: String,
    symbol: String,
    shares: Int,
    etb: Bool,
    exp_ts: Int
) -> LocateRecord {
    return LocateRecord {
        locate_id: loc_id,
        symbol: symbol,
        total_borrow_shares: shares,
        allocated_shares: 0,
        is_easy_to_borrow: etb,
        expiry_timestamp_ns: exp_ts
    };
}

pub fn reg_sho_state_new(symbol: String) -> RegShoSsrState {
    return RegShoSsrState {
        symbol: symbol,
        is_ssr_active: false,
        trigger_timestamp_ns: 0,
        deactivation_timestamp_ns: 0
    };
}

pub fn verify_short_sale_order(
    locate: &mut LocateRecord,
    ssr: &RegShoSsrState,
    requested_shares: Int,
    order_price_fixed: Int,
    best_bid_price_fixed: Int,
    is_short_exempt: Bool
) -> ShortSaleCheckResult {
    if (ssr).is_ssr_active && !is_short_exempt {
        if order_price_fixed <= best_bid_price_fixed {
            return ShortSaleCheckResult {
                approved: false,
                short_sale_type: "SHORT",
                reject_reason: "REG_SHO_SSR_RESTRICTION_PRICE_BELOW_BID",
                remaining_locate_shares: (locate).total_borrow_shares - (locate).allocated_shares
            };
        }
    }

    let available: Int = (locate).total_borrow_shares - (locate).allocated_shares;
    if requested_shares > available {
        return ShortSaleCheckResult {
            approved: false,
            short_sale_type: "SHORT",
            reject_reason: "INSUFFICIENT_LOCATE_SHARES",
            remaining_locate_shares: available
        };
    }

    (locate).allocated_shares = (locate).allocated_shares + requested_shares;
    let sstype: String = if is_short_exempt { "SHORT_EXEMPT" } else { "SHORT" };

    return ShortSaleCheckResult {
        approved: true,
        short_sale_type: sstype,
        reject_reason: "PASSED",
        remaining_locate_shares: (locate).total_borrow_shares - (locate).allocated_shares
    };
}
