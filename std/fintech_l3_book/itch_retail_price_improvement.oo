// # NASDAQ Retail Price Improvement Indicator (RPII)
//
// Logline: Processes Retail Price Improvement (RPII) interest flags and tracks sub-penny retail liquidity opportunities.
//
// Setup: Real-time RPII feed parser detecting retail price improvement interest on bid, ask, or both sides of the book.
//
// Beats:
//   1. Define RpiiMessage and RpiiState structures.
//   2. Parse RPII interest flags ('B' Buy, 'A' Sell, 'C' Both, 'N' None).
//   3. Provide retail liquidity availability queries for smart order routers.

pub type RpiiMessage = struct {
    timestamp_ns: Int,
    stock: String,
    interest_flag: String,
};

pub type RpiiState = struct {
    stock: String,
    has_buy_interest: Bool,
    has_sell_interest: Bool,
    last_update_ts_ns: Int,
    event_count: Int,
};

pub fn rpii_message_new(ts: Int, symbol: String, flag: String) -> RpiiMessage {
    return RpiiMessage {
        timestamp_ns: ts,
        stock: symbol,
        interest_flag: flag,
    };
}

pub fn rpii_state_new(symbol: String) -> RpiiState {
    return RpiiState {
        stock: symbol,
        has_buy_interest: false,
        has_sell_interest: false,
        last_update_ts_ns: 0,
        event_count: 0,
    };
}

pub fn rpii_process_event(state: &mut RpiiState, msg: &RpiiMessage) {
    (state).stock = (msg).stock;
    (state).last_update_ts_ns = (msg).timestamp_ns;
    (state).event_count = (state).event_count + 1;

    let flag: String = (msg).interest_flag;
    if flag == "B" {
        (state).has_buy_interest = true;
        (state).has_sell_interest = false;
    } else if flag == "A" {
        (state).has_buy_interest = false;
        (state).has_sell_interest = true;
    } else if flag == "C" {
        (state).has_buy_interest = true;
        (state).has_sell_interest = true;
    } else {
        (state).has_buy_interest = false;
        (state).has_sell_interest = false;
    }
}

pub fn rpii_has_retail_liquidity(state: &RpiiState, side: String) -> Bool {
    if side == "B" {
        return (state).has_buy_interest;
    }
    if side == "S" || side == "A" {
        return (state).has_sell_interest;
    }
    return (state).has_buy_interest || (state).has_sell_interest;
}
