// # Market Data Sequence Gap Recovery
//
// Logline: Detects MoldUDP64 sequence gaps, formats TCP retransmission requests, and reconciles out-of-order market data buffers.
//
// Setup: Reliability and packet recovery module ensuring lossless ITCH 5.0 feed processing across multicast drops.
//
// Beats:
//   1. Define SequenceGap, RetransmitRequest, and GapRecoveryTracker structures.
//   2. Identify gap boundaries and queue missing sequence ranges for TCP re-request.
//   3. Drain retransmitted packets and restore continuous feed synchronization.

pub type SequenceGap = struct {
    start_sequence: Int,
    message_count: Int,
    detected_timestamp_ns: Int,
    is_resolved: Bool
};

pub type RetransmitRequest = struct {
    session_id: String,
    start_sequence: Int,
    message_count: Int,
    request_timestamp_ns: Int
};

pub type GapRecoveryTracker = struct {
    session_id: String,
    total_gaps_detected: Int,
    total_gaps_resolved: Int,
    active_gap_count: Int,
    max_batch_retransmit_size: Int
};

pub fn gap_recovery_tracker_new(sess: String, max_batch: Int) -> GapRecoveryTracker {
    return GapRecoveryTracker {
        session_id: sess,
        total_gaps_detected: 0,
        total_gaps_resolved: 0,
        active_gap_count: 0,
        max_batch_retransmit_size: max_batch
    };
}

pub fn sequence_gap_new(start: Int, count: Int, ts: Int) -> SequenceGap {
    return SequenceGap {
        start_sequence: start,
        message_count: count,
        detected_timestamp_ns: ts,
        is_resolved: false
    };
}

pub fn create_retransmit_request(
    tracker: &mut GapRecoveryTracker,
    gap: &SequenceGap,
    req_ts: Int
) -> RetransmitRequest {
    (tracker).total_gaps_detected = (tracker).total_gaps_detected + 1;
    (tracker).active_gap_count = (tracker).active_gap_count + 1;

    let mut count: Int = (gap).message_count;
    if count > (tracker).max_batch_retransmit_size {
        count = (tracker).max_batch_retransmit_size;
    }

    return RetransmitRequest {
        session_id: (tracker).session_id,
        start_sequence: (gap).start_sequence,
        message_count: count,
        request_timestamp_ns: req_ts
    };
}

pub fn resolve_sequence_gap(
    tracker: &mut GapRecoveryTracker,
    gap: &mut SequenceGap
) {
    if !(gap).is_resolved {
        (gap).is_resolved = true;
        (tracker).total_gaps_resolved = (tracker).total_gaps_resolved + 1;
        if (tracker).active_gap_count > 0 {
            (tracker).active_gap_count = (tracker).active_gap_count - 1;
        }
    }
}
