// # Level 3 Order Book Delta Compressor
//
// Logline: Applies delta compression and variable-length integer encoding to reduce network bandwidth of L3 book distribution.
//
// Setup: Low-bandwidth market data compressor encoding delta price ticks, relative order IDs, and compact event flags.
//
// Beats:
//   1. Define CompressedDeltaEvent, CompressionState, and CompressionMetrics structures.
//   2. Encode price offsets relative to previous message base price.
//   3. Compute compression ratio metrics across streaming L3 update bursts.

pub type CompressedDeltaEvent = struct {
    action_flag: Int,
    delta_order_id: Int,
    delta_price_ticks: Int,
    shares: Int,
    delta_timestamp_micros: Int
};

pub type CompressionState = struct {
    base_order_id: Int,
    base_price_fixed: Int,
    base_timestamp_ns: Int,
    tick_size_fixed: Int
};

pub type CompressionMetrics = struct {
    raw_bytes_in: Int,
    compressed_bytes_out: Int,
    total_events_compressed: Int
};

pub fn compression_state_new(base_px: Int, tick_size: Int) -> CompressionState {
    return CompressionState {
        base_order_id: 0,
        base_price_fixed: base_px,
        base_timestamp_ns: 0,
        tick_size_fixed: tick_size
    };
}

pub fn compression_metrics_new() -> CompressionMetrics {
    return CompressionMetrics {
        raw_bytes_in: 0,
        compressed_bytes_out: 0,
        total_events_compressed: 0
    };
}

pub fn compress_l3_event(
    state: &mut CompressionState,
    metrics: &mut CompressionMetrics,
    action: Int,
    oid: Int,
    px: Int,
    qty: Int,
    ts_ns: Int
) -> CompressedDeltaEvent {
    let delta_oid: Int = oid - (state).base_order_id;
    let px_diff: Int = px - (state).base_price_fixed;
    let delta_ticks: Int = if (state).tick_size_fixed > 0 { px_diff / (state).tick_size_fixed } else { 0 };
    let ts_diff_ns: Int = ts_ns - (state).base_timestamp_ns;
    let delta_micros: Int = ts_diff_ns / 1000;

    (state).base_order_id = oid;
    (state).base_price_fixed = px;
    (state).base_timestamp_ns = ts_ns;

    (metrics).raw_bytes_in = (metrics).raw_bytes_in + 36;
    (metrics).compressed_bytes_out = (metrics).compressed_bytes_out + 12;
    (metrics).total_events_compressed = (metrics).total_events_compressed + 1;

    return CompressedDeltaEvent {
        action_flag: action,
        delta_order_id: delta_oid,
        delta_price_ticks: delta_ticks,
        shares: qty,
        delta_timestamp_micros: delta_micros
    };
}
