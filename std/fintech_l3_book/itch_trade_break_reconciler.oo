// # ITCH Trade Break Reconciler
//
// Logline: Processes ITCH 5.0 Broken Trade messages (Type 'B') and adjusts trade ledgers, volume analytics, and position records.
//
// Setup: Post-execution settlement and trade consistency reconciler responding to exchange-busted trade notifications.
//
// Beats:
//   1. Define TradeBreakEvent and TradeBreakLedger structures.
//   2. Match broken trade match numbers against historical execution logs.
//   3. Compute volume reversals, position adjustments, and audit status flags.

pub type TradeBreakEvent = struct {
    match_number: Int,
    timestamp_ns: Int,
    stock: String,
    shares_broken: Int,
    price_fixed: Int,
    reason: String,
};

pub type TradeBreakLedger = struct {
    total_breaks_processed: Int,
    total_broken_shares: Int,
    total_broken_notional_fixed: Int,
    last_break_match_number: Int,
};

pub fn trade_break_ledger_new() -> TradeBreakLedger {
    return TradeBreakLedger {
        total_breaks_processed: 0,
        total_broken_shares: 0,
        total_broken_notional_fixed: 0,
        last_break_match_number: 0,
    };
}

pub fn trade_break_event_new(
    match_id: Int,
    ts: Int,
    symbol: String,
    qty: Int,
    px: Int,
    reason: String
) -> TradeBreakEvent {
    return TradeBreakEvent {
        match_number: match_id,
        timestamp_ns: ts,
        stock: symbol,
        shares_broken: qty,
        price_fixed: px,
        reason: reason,
    };
}

pub fn trade_break_process_event(
    ledger: &mut TradeBreakLedger,
    event: &TradeBreakEvent
) {
    (ledger).total_breaks_processed = (ledger).total_breaks_processed + 1;
    (ledger).total_broken_shares = (ledger).total_broken_shares + (event).shares_broken;
    (ledger).total_broken_notional_fixed = (ledger).total_broken_notional_fixed + ((event).shares_broken * (event).price_fixed);
    (ledger).last_break_match_number = (event).match_number;
}

pub fn trade_break_is_significant(event: &TradeBreakEvent, share_threshold: Int) -> Bool {
    return (event).shares_broken >= share_threshold;
}
