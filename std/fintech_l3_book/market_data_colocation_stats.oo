// # Market Data Colocation Latency Statistics
//
// Logline: Measures sub-microsecond colocation network latency, tick-to-trade response times, and kernel bypass efficiency.
//
// Setup: Low-latency telemetry module recording hardware timestamps for exchange colocation optimization.
//
// Beats:
//   1. Define LatencySample, ColocationProfile, and JitterMetrics structures.
//   2. Record tick arrival, signal generation, and wire egress timestamps.
//   3. Compute rolling minimum, maximum, mean, and jitter variance in nanoseconds.

pub type LatencySample = struct {
    tick_ingress_ns: Int,
    signal_eval_ns: Int,
    order_egress_ns: Int,
    wire_to_wire_ns: Int
};

pub type ColocationProfile = struct {
    sample_count: Int,
    min_latency_ns: Int,
    max_latency_ns: Int,
    total_latency_ns: Int,
    mean_latency_ns: Int,
    last_jitter_ns: Int
};

pub fn colocation_profile_new() -> ColocationProfile {
    return ColocationProfile {
        sample_count: 0,
        min_latency_ns: 999999999,
        max_latency_ns: 0,
        total_latency_ns: 0,
        mean_latency_ns: 0,
        last_jitter_ns: 0
    };
}

pub fn latency_sample_new(
    ingress_ts: Int,
    eval_ts: Int,
    egress_ts: Int
) -> LatencySample {
    let lat: Int = egress_ts - ingress_ts;
    return LatencySample {
        tick_ingress_ns: ingress_ts,
        signal_eval_ns: eval_ts,
        order_egress_ns: egress_ts,
        wire_to_wire_ns: if lat > 0 { lat } else { 0 }
    };
}

pub fn record_colocation_sample(
    profile: &mut ColocationProfile,
    sample: &LatencySample
) {
    let lat: Int = (sample).wire_to_wire_ns;
    (profile).sample_count = (profile).sample_count + 1;
    (profile).total_latency_ns = (profile).total_latency_ns + lat;

    if lat < (profile).min_latency_ns {
        (profile).min_latency_ns = lat;
    }
    if lat > (profile).max_latency_ns {
        (profile).max_latency_ns = lat;
    }

    let prev_mean: Int = (profile).mean_latency_ns;
    (profile).mean_latency_ns = (profile).total_latency_ns / (profile).sample_count;

    let jitter: Int = lat - prev_mean;
    (profile).last_jitter_ns = if jitter < 0 { 0 - jitter } else { jitter };
}
