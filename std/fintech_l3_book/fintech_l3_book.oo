pub fn fintech_l3_book_version() -> String {
    return "1.0.0";
}

pub fn fintech_l3_book_module_count() -> Int {
    return 50;
}

pub fn fintech_l3_book_default_risk_limits() -> DmaRiskLimits {
    return dma_risk_limits_default();
}

pub fn fintech_l3_book_new_state(symbol: String) -> L3OrderBookState {
