// # Price-Time Priority (FIFO) Matching Allocator
//
// Logline: Executes aggressive incoming orders against resting passive liquidity in strict Price-Time (FIFO) priority.
//
// Setup: Core exchange matching algorithm exhausting resting queue layers in chronological arrival order.
//
// Beats:
//   1. Define MatchFillEvent, RestingOrderQueueEntry, and FifoMatchResult structures.
//   2. Match incoming taker quantity against resting maker orders at the same price level.
//   3. Compute individual fill quantities, maker executions, and residual leaves quantity.

pub type MatchFillEvent = struct {
    match_number: Int,
    maker_order_id: Int,
    taker_order_id: Int,
    fill_shares: Int,
    fill_price_fixed: Int,
    is_maker_fully_filled: Bool,
    timestamp_ns: Int
};

pub type FifoMatchResult = struct {
    taker_order_id: Int,
    total_shares_matched: Int,
    taker_leaves_shares: Int,
    match_count: Int,
    is_taker_fully_filled: Bool
};

pub fn match_against_resting_order(
    match_id: Int,
    taker_oid: Int,
    taker_shares_left: Int,
    maker_oid: Int,
    maker_shares_avail: Int,
    price_fixed: Int,
    ts: Int
) -> MatchFillEvent {
    let fill_qty: Int = if taker_shares_left < maker_shares_avail { taker_shares_left } else { maker_shares_avail };
    let fully_filled: Bool = fill_qty >= maker_shares_avail;

    return MatchFillEvent {
        match_number: match_id,
        maker_order_id: maker_oid,
        taker_order_id: taker_oid,
        fill_shares: fill_qty,
        fill_price_fixed: price_fixed,
        is_maker_fully_filled: fully_filled,
        timestamp_ns: ts
    };
}

pub fn fifo_match_result_new(taker_oid: Int, orig_shares: Int) -> FifoMatchResult {
    return FifoMatchResult {
        taker_order_id: taker_oid,
        total_shares_matched: 0,
        taker_leaves_shares: orig_shares,
        match_count: 0,
        is_taker_fully_filled: false
    };
}

pub fn apply_match_fill(
    result: &mut FifoMatchResult,
    fill: &MatchFillEvent
) {
    (result).total_shares_matched = (result).total_shares_matched + (fill).fill_shares;
    (result).taker_leaves_shares = (result).taker_leaves_shares - (fill).fill_shares;
    (result).match_count = (result).match_count + 1;

    if (result).taker_leaves_shares <= 0 {
        (result).taker_leaves_shares = 0;
        (result).is_taker_fully_filled = true;
    }
}
