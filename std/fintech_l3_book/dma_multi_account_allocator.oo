// # DMA Multi-Account Pre-Trade Allocator
//
// Logline: Splits block parent orders into sub-account allocations and computes average pricing across multi-fill executions.
//
// Setup: DMA post-execution clearing module distributing fills proportionately across sub-accounts.
//
// Beats:
//   1. Define AccountAllocationTarget, SubAccountFill, and BlockAllocationSummary structures.
//   2. Calculate pro-rata fill quantities and remainder share distributions.
//   3. Compute volume-weighted average price (VWAP) per sub-account allocation slice.

pub type AccountAllocationTarget = struct {
    account_id: String,
    target_shares: Int,
    allocated_shares: Int,
    allocated_notional_fixed: Int
};

pub type SubAccountFill = struct {
    account_id: String,
    shares: Int,
    avg_price_fixed: Int
};

pub type BlockAllocationSummary = struct {
    block_order_id: Int,
    total_requested_shares: Int,
    total_executed_shares: Int,
    is_fully_allocated: Bool
};

pub fn account_allocation_target_new(acct: String, target_qty: Int) -> AccountAllocationTarget {
    return AccountAllocationTarget {
        account_id: acct,
        target_shares: target_qty,
        allocated_shares: 0,
        allocated_notional_fixed: 0
    };
}

pub fn block_allocation_summary_new(order_id: Int, total_qty: Int) -> BlockAllocationSummary {
    return BlockAllocationSummary {
        block_order_id: order_id,
        total_requested_shares: total_qty,
        total_executed_shares: 0,
        is_fully_allocated: false
    };
}

pub fn allocate_fill_slice(
    target: &mut AccountAllocationTarget,
    fill_shares: Int,
    fill_price_fixed: Int
) -> SubAccountFill {
    (target).allocated_shares = (target).allocated_shares + fill_shares;
    (target).allocated_notional_fixed = (target).allocated_notional_fixed + (fill_shares * fill_price_fixed);

    let avg_px: Int = if (target).allocated_shares > 0 {
        (target).allocated_notional_fixed / (target).allocated_shares
    } else {
        fill_price_fixed
    };

    return SubAccountFill {
        account_id: (target).account_id,
        shares: fill_shares,
        avg_price_fixed: avg_px
    };
}
