// # Direct Market Access Margin and Credit Utilization Monitor
//
// Logline: Tracks intraday gross and net margin usage, portfolio buying power, and enforces liquidation warning thresholds.
//
// Setup: Real-time risk accounting module monitoring equity leverage and portfolio margin requirements across active DMA accounts.
//
// Beats:
//   1. Define AccountMarginState, MarginRequirementRule, and MarginCheckResult structures.
//   2. Calculate initial and maintenance margin requirements on executed and open orders.
//   3. Compute excess liquidity headroom and generate margin call warning triggers.

pub type AccountMarginState = struct {
    account_id: String,
    total_cash_fixed: Int,
    long_market_value_fixed: Int,
    short_market_value_fixed: Int,
    open_order_notional_fixed: Int,
    initial_margin_rate_bps: Int,
    maint_margin_rate_bps: Int
};

pub type MarginCheckResult = struct {
    has_sufficient_margin: Bool,
    total_equity_fixed: Int,
    margin_requirement_fixed: Int,
    excess_liquidity_fixed: Int,
    leverage_ratio: Float
};

pub fn account_margin_state_new(
    acct: String,
    cash_fixed: Int,
    init_bps: Int,
    maint_bps: Int
) -> AccountMarginState {
    return AccountMarginState {
        account_id: acct,
        total_cash_fixed: cash_fixed,
        long_market_value_fixed: 0,
        short_market_value_fixed: 0,
        open_order_notional_fixed: 0,
        initial_margin_rate_bps: init_bps,
        maint_margin_rate_bps: maint_bps
    };
}

pub fn evaluate_account_margin(
    state: &AccountMarginState,
    incoming_order_notional_fixed: Int
) -> MarginCheckResult {
    let total_equity: Int = (state).total_cash_fixed + (state).long_market_value_fixed - (state).short_market_value_fixed;
    let gross_exposure: Int = (state).long_market_value_fixed + (state).short_market_value_fixed + (state).open_order_notional_fixed + incoming_order_notional_fixed;

    let margin_req: Int = (gross_exposure * (state).initial_margin_rate_bps) / 10000;
    let excess_liq: Int = total_equity - margin_req;
    let is_ok: Bool = excess_liq >= 0;

    let mut exp_f: Float = 0.0;
    let mut eq_f: Float = 0.0;
    let mut c_exp: Int = gross_exposure;
    while c_exp >= 1000000 { exp_f = exp_f + 1000000.0; c_exp = c_exp - 1000000; }
    while c_exp >= 1000 { exp_f = exp_f + 1000.0; c_exp = c_exp - 1000; }
    while c_exp >= 1 { exp_f = exp_f + 1.0; c_exp = c_exp - 1; }

    let mut c_eq: Int = if total_equity > 0 { total_equity } else { 1 };
    while c_eq >= 1000000 { eq_f = eq_f + 1000000.0; c_eq = c_eq - 1000000; }
    while c_eq >= 1000 { eq_f = eq_f + 1000.0; c_eq = c_eq - 1000; }
    while c_eq >= 1 { eq_f = eq_f + 1.0; c_eq = c_eq - 1; }

    let leverage: Float = exp_f / eq_f;

    return MarginCheckResult {
        has_sufficient_margin: is_ok,
        total_equity_fixed: total_equity,
        margin_requirement_fixed: margin_req,
        excess_liquidity_fixed: excess_liq,
        leverage_ratio: leverage
    };
}
