// # Lock-Free Circular Ring Buffer Matching Core
//
// Logline: Implements an ultra-low latency circular ring buffer for zero-allocation single-producer single-consumer order matching pipelines.
//
// Setup: High-throughput matching engine command bus passing incoming orders and cancel commands without heap allocations.
//
// Beats:
//   1. Define RingBufferSlot, RingBufferMetrics, and LockFreeRing structures.
//   2. Enqueue order execution intents using circular sequence indexing.
//   3. Dequeue matching commands and track consumer head/tail progress.

pub type RingBufferSlot = struct {
    slot_id: Int,
    command_type: String,
    order_id: Int,
    side: String,
    shares: Int,
    price_fixed: Int,
    sequence_number: Int,
    is_ready: Bool
};

pub type RingBufferMetrics = struct {
    capacity: Int,
    head_sequence: Int,
    tail_sequence: Int,
    total_enqueued: Int,
    total_dequeued: Int,
    overflow_count: Int
};

pub fn ring_buffer_metrics_new(cap: Int) -> RingBufferMetrics {
    return RingBufferMetrics {
        capacity: cap,
        head_sequence: 0,
        tail_sequence: 0,
        total_enqueued: 0,
        total_dequeued: 0,
        overflow_count: 0
    };
}

pub fn ring_buffer_slot_new(id: Int) -> RingBufferSlot {
    return RingBufferSlot {
        slot_id: id,
        command_type: "NOP",
        order_id: 0,
        side: "",
        shares: 0,
        price_fixed: 0,
        sequence_number: 0,
        is_ready: false
    };
}

pub fn ring_enqueue_order(
    metrics: &mut RingBufferMetrics,
    cmd: String,
    oid: Int,
    side: String,
    qty: Int,
    px: Int
) -> RingBufferSlot {
    let inflight: Int = (metrics).tail_sequence - (metrics).head_sequence;
    if inflight >= (metrics).capacity {
        (metrics).overflow_count = (metrics).overflow_count + 1;
        return ring_buffer_slot_new(-1);
    }

    let seq: Int = (metrics).tail_sequence;
    let slot_idx: Int = seq % (metrics).capacity;
    (metrics).tail_sequence = (metrics).tail_sequence + 1;
    (metrics).total_enqueued = (metrics).total_enqueued + 1;

    return RingBufferSlot {
        slot_id: slot_idx,
        command_type: cmd,
        order_id: oid,
        side: side,
        shares: qty,
        price_fixed: px,
        sequence_number: seq,
        is_ready: true
    };
}

pub fn ring_dequeue_complete(metrics: &mut RingBufferMetrics) -> Bool {
    if (metrics).head_sequence >= (metrics).tail_sequence {
        return false;
    }
    (metrics).head_sequence = (metrics).head_sequence + 1;
    (metrics).total_dequeued = (metrics).total_dequeued + 1;
    return true;
}

pub fn ring_available_capacity(metrics: &RingBufferMetrics) -> Int {
    let used: Int = (metrics).tail_sequence - (metrics).head_sequence;
    let avail: Int = (metrics).capacity - used;
    return if avail > 0 { avail } else { 0 };
}
