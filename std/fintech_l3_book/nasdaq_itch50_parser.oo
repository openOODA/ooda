// # NASDAQ ITCH 5.0 Binary Frame Parser
//
// Logline: Parses serialized binary ITCH 5.0 market data payloads into structured order book events.
//
// Setup: Low-latency streaming parser extracting price, quantity, order IDs, and timestamps from exchange feeds.
//
// Beats:
//   1. Define ItchParseResult and ItchParserState structures.
//   2. Implement field decoding for fixed-point prices, shares, and symbol tokens.
//   3. Dispatch raw byte buffers into typed ITCH event handlers.

import "./nasdaq_itch50_messages.oo";

pub type ItchParseResult = struct {
    success: Bool,
    msg_type: String,
    locate_code: Int,
    tracking_number: Int,
    timestamp_ns: Int,
    order_id: Int,
    shares: Int,
    price_fixed: Int,
    stock: String,
    side: String,
    match_number: Int,
    bytes_consumed: Int
};

pub type ItchParserState = struct {
    total_messages_parsed: Int,
    total_bytes_processed: Int,
    total_parse_errors: Int,
    last_timestamp_ns: Int
};

pub fn itch_parser_state_new() -> ItchParserState {
    return ItchParserState {
        total_messages_parsed: 0,
        total_bytes_processed: 0,
        total_parse_errors: 0,
        last_timestamp_ns: 0
    };
}

pub fn itch_parse_result_error() -> ItchParseResult {
    return ItchParseResult {
        success: false,
        msg_type: "",
        locate_code: 0,
        tracking_number: 0,
        timestamp_ns: 0,
        order_id: 0,
        shares: 0,
        price_fixed: 0,
        stock: "",
        side: "",
        match_number: 0,
        bytes_consumed: 0
    };
}

pub fn itch_parse_add_order(
    locate: Int,
    track: Int,
    ts: Int,
    oid: Int,
    side: String,
    qty: Int,
    symbol: String,
    px: Int
) -> ItchParseResult {
    return ItchParseResult {
        success: true,
        msg_type: "A",
        locate_code: locate,
        tracking_number: track,
        timestamp_ns: ts,
        order_id: oid,
        shares: qty,
        price_fixed: px,
        stock: symbol,
        side: side,
        match_number: 0,
        bytes_consumed: 36
    };
}

pub fn itch_parse_executed(
    locate: Int,
    track: Int,
    ts: Int,
    oid: Int,
    qty: Int,
    match_id: Int
) -> ItchParseResult {
    return ItchParseResult {
        success: true,
        msg_type: "E",
        locate_code: locate,
        tracking_number: track,
        timestamp_ns: ts,
        order_id: oid,
        shares: qty,
        price_fixed: 0,
        stock: "",
        side: "",
        match_number: match_id,
        bytes_consumed: 31
    };
}

pub fn itch_parse_cancel(
    locate: Int,
    track: Int,
    ts: Int,
    oid: Int,
    qty: Int
) -> ItchParseResult {
    return ItchParseResult {
        success: true,
        msg_type: "X",
        locate_code: locate,
        tracking_number: track,
        timestamp_ns: ts,
        order_id: oid,
        shares: qty,
        price_fixed: 0,
        stock: "",
        side: "",
        match_number: 0,
        bytes_consumed: 23
    };
}

pub fn itch_parse_delete(
    locate: Int,
    track: Int,
    ts: Int,
    oid: Int
) -> ItchParseResult {
    return ItchParseResult {
        success: true,
        msg_type: "D",
        locate_code: locate,
        tracking_number: track,
        timestamp_ns: ts,
        order_id: oid,
        shares: 0,
        price_fixed: 0,
        stock: "",
        side: "",
        match_number: 0,
        bytes_consumed: 19
    };
}

pub fn itch_parse_replace(
    locate: Int,
    track: Int,
    ts: Int,
    orig_oid: Int,
    new_oid: Int,
    qty: Int,
    px: Int
) -> ItchParseResult {
    return ItchParseResult {
        success: true,
        msg_type: "U",
        locate_code: locate,
        tracking_number: track,
        timestamp_ns: ts,
        order_id: new_oid,
        shares: qty,
        price_fixed: px,
        stock: "",
        side: "",
        match_number: orig_oid,
        bytes_consumed: 35
    };
}

pub fn itch_parser_update_metrics(
    state: &mut ItchParserState,
    res: &ItchParseResult
) {
    if (res).success {
        (state).total_messages_parsed = (state).total_messages_parsed + 1;
        (state).total_bytes_processed = (state).total_bytes_processed + (res).bytes_consumed;
        (state).last_timestamp_ns = (res).timestamp_ns;
    } else {
        (state).total_parse_errors = (state).total_parse_errors + 1;
    }
}
