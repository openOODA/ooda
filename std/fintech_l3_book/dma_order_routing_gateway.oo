// # Direct Market Access (DMA) Order Routing Gateway
//
// Logline: Routes incoming client orders to direct exchange matching engines with session dispatch, failover, and latency minimization.
//
// Setup: High-speed gateway multiplexer balancing order flow across primary and secondary exchange OUCH ports.
//
// Beats:
//   1. Define GatewaySession, RoutingRule, and GatewayMetrics structures.
//   2. Select target exchange connection using latency metrics and availability health.
//   3. Handle session failover, order state re-binding, and routing audit records.

pub type GatewaySession = struct {
    session_id: String,
    venue_code: String,
    is_connected: Bool,
    current_latency_ns: Int,
    orders_sent: Int,
    errors_count: Int
};

pub type RoutingRule = struct {
    symbol_prefix: String,
    primary_session_id: String,
    secondary_session_id: String,
    allow_failover: Bool,
    max_inflight_orders: Int
};

pub type GatewayMetrics = struct {
    total_routed_orders: Int,
    total_failed_routes: Int,
    total_failovers_triggered: Int,
    avg_latency_ns: Int
};

pub fn gateway_session_new(sess: String, venue: String) -> GatewaySession {
    return GatewaySession {
        session_id: sess,
        venue_code: venue,
        is_connected: true,
        current_latency_ns: 1200,
        orders_sent: 0,
        errors_count: 0
    };
}

pub fn gateway_metrics_new() -> GatewayMetrics {
    return GatewayMetrics {
        total_routed_orders: 0,
        total_failed_routes: 0,
        total_failovers_triggered: 0,
        avg_latency_ns: 0
    };
}

pub fn select_target_session(
    primary: &GatewaySession,
    secondary: &GatewaySession,
    rule: &RoutingRule
) -> String {
    if (primary).is_connected {
        return (primary).session_id;
    }
    if (rule).allow_failover && (secondary).is_connected {
        return (secondary).session_id;
    }
    return "";
}

pub fn gateway_record_dispatch(
    metrics: &mut GatewayMetrics,
    session: &mut GatewaySession,
    latency_ns: Int
) {
    (metrics).total_routed_orders = (metrics).total_routed_orders + 1;
    (session).orders_sent = (session).orders_sent + 1;
    (session).current_latency_ns = latency_ns;
}
