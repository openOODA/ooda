// # Synthetic National Best Bid and Offer (NBBO) Feed
//
// Logline: Consolidates multi-venue ITCH and direct feed top-of-book quotes into a unified synthetic NBBO stream.
//
// Setup: Low-latency ticker plant consolidator aggregating BBO feeds across exchanges to compute consolidated NBBO.
//
// Beats:
//   1. Define VenueQuote, SyntheticNbboQuote, and ConsolidatedNbboBook structures.
//   2. Update venue quote states on incoming BBO delta notifications.
//   3. Compute best national bid, best national offer, locked/crossed market flags, and aggregate sizes.

pub type VenueQuote = struct {
    venue_id: String,
    stock: String,
    bid_price_fixed: Int,
    bid_shares: Int,
    ask_price_fixed: Int,
    ask_shares: Int,
    update_timestamp_ns: Int,
};

pub type SyntheticNbboQuote = struct {
    stock: String,
    best_bid_price_fixed: Int,
    best_bid_shares: Int,
    best_bid_venue: String,
    best_ask_price_fixed: Int,
    best_ask_shares: Int,
    best_ask_venue: String,
    is_locked: Bool,
    is_crossed: Bool,
    spread_fixed: Int,
    timestamp_ns: Int,
};

pub fn venue_quote_new(
    venue: String,
    symbol: String,
    bid_px: Int,
    bid_qty: Int,
    ask_px: Int,
    ask_qty: Int,
    ts: Int
) -> VenueQuote {
    return VenueQuote {
        venue_id: venue,
        stock: symbol,
        bid_price_fixed: bid_px,
        bid_shares: bid_qty,
        ask_price_fixed: ask_px,
        ask_shares: ask_qty,
        update_timestamp_ns: ts,
    };
}

pub fn synthetic_nbbo_compute_two_venues(
    q1: &VenueQuote,
    q2: &VenueQuote
) -> SyntheticNbboQuote {
    let mut best_bid_px: Int = (q1).bid_price_fixed;
    let mut best_bid_qty: Int = (q1).bid_shares;
    let mut best_bid_v: String = (q1).venue_id;

    if (q2).bid_price_fixed > best_bid_px {
        best_bid_px = (q2).bid_price_fixed;
        best_bid_qty = (q2).bid_shares;
        best_bid_v = (q2).venue_id;
    } else if (q2).bid_price_fixed == best_bid_px {
        best_bid_qty = best_bid_qty + (q2).bid_shares;
        best_bid_v = "MULTIPLE";
    }

    let mut best_ask_px: Int = (q1).ask_price_fixed;
    let mut best_ask_qty: Int = (q1).ask_shares;
    let mut best_ask_v: String = (q1).venue_id;

    if (q2).ask_price_fixed < best_ask_px && (q2).ask_price_fixed > 0 {
        best_ask_px = (q2).ask_price_fixed;
        best_ask_qty = (q2).ask_shares;
        best_ask_v = (q2).venue_id;
    } else if (q2).ask_price_fixed == best_ask_px {
        best_ask_qty = best_ask_qty + (q2).ask_shares;
        best_ask_v = "MULTIPLE";
    }

    let locked: Bool = (best_bid_px > 0) && (best_bid_px == best_ask_px);
    let crossed: Bool = (best_bid_px > 0) && (best_ask_px > 0) && (best_bid_px > best_ask_px);
    let spread: Int = if best_ask_px >= best_bid_px { best_ask_px - best_bid_px } else { 0 };

    let ts: Int = if (q1).update_timestamp_ns > (q2).update_timestamp_ns {
        (q1).update_timestamp_ns
    } else {
        (q2).update_timestamp_ns
    };

    return SyntheticNbboQuote {
        stock: (q1).stock,
        best_bid_price_fixed: best_bid_px,
        best_bid_shares: best_bid_qty,
        best_bid_venue: best_bid_v,
        best_ask_price_fixed: best_ask_px,
        best_ask_shares: best_ask_qty,
        best_ask_venue: best_ask_v,
        is_locked: locked,
        is_crossed: crossed,
        spread_fixed: spread,
        timestamp_ns: ts,
    };
}
