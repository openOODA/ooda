// # Ultra-Low Latency ITCH/OUCH 5.0 and L3 Book Test Stubs
//
// Logline: Provides mock ITCH 5.0 packet generators, synthetic OUCH order feeds, and test fixtures for L3 market engine validation.
//
// Setup: Testing harness producing deterministic market events, order books, and DMA risk checks.
//
// Beats:
//   1. Define MockItchFeed, MockOuchSession, and MockL3TestFixture structures.
//   2. Generate deterministic ITCH AddOrder, Executed, and Cancel packet fixtures.
//   3. Provide pre-configured test fixtures for DMA risk and order matching tests.

import "./nasdaq_itch50_messages.oo";
import "./nasdaq_ouch50_order_entry.oo";
import "./dma_pretrade_risk_checks.oo";
import "./l3_order_book_core.oo";

pub type MockItchFeed = struct {
    symbol: String,
    sequence_number: Int,
    current_timestamp_ns: Int,
    orders_generated: Int
};

pub type MockOuchSession = struct {
    firm_id: String,
    user_ref_counter: Int,
    orders_sent: Int,
    fills_received: Int
};

pub type MockL3TestFixture = struct {
    symbol: String,
    initial_bid_price_fixed: Int,
    initial_ask_price_fixed: Int,
    initial_shares_per_level: Int
};

pub fn mock_itch_feed_new(symbol: String) -> MockItchFeed {
    return MockItchFeed {
        symbol: symbol,
        sequence_number: 1,
        current_timestamp_ns: 1700000000000000000,
        orders_generated: 0
    };
}

pub fn mock_ouch_session_new(firm: String) -> MockOuchSession {
    return MockOuchSession {
        firm_id: firm,
        user_ref_counter: 1000,
        orders_sent: 0,
        fills_received: 0
    };
}

pub fn mock_l3_test_fixture_default() -> MockL3TestFixture {
    return MockL3TestFixture {
        symbol: "AAPL",
        initial_bid_price_fixed: 1855000,
        initial_ask_price_fixed: 1855100,
        initial_shares_per_level: 500
    };
}

pub fn mock_generate_itch_add_order(
    feed: &mut MockItchFeed,
    side: String,
    qty: Int,
    px: Int
) -> ItchAddOrder {
    (feed).orders_generated = (feed).orders_generated + 1;
    (feed).current_timestamp_ns = (feed).current_timestamp_ns + 1000;
    let oid: Int = (feed).orders_generated;

    let hdr: ItchHeader = itch_header_new("A", 1, (feed).orders_generated, (feed).current_timestamp_ns);
    return itch_add_order_new(hdr, oid, side, qty, (feed).symbol, px, "NSDQ");
}

pub fn mock_generate_ouch_order(
    session: &mut MockOuchSession,
    symbol: String,
    side: String,
    qty: Int,
    px: Int
) -> OuchEnterOrder {
    (session).user_ref_counter = (session).user_ref_counter + 1;
    (session).orders_sent = (session).orders_sent + 1;

    return ouch_enter_order_new(
        (session).user_ref_counter,
        side,
        qty,
        symbol,
        px,
        0,
        (session).firm_id
    );
}

pub fn mock_is_test_environment() -> Bool {
    return true;
}
