// # Level 3 Multi-Level Market Order Sweep Engine
//
// Logline: Sweeps through sequential L3 price levels executing aggressive Immediate-or-Cancel (IOC) and Fill-or-Kill (FOK) market orders.
//
// Setup: Order execution sweep module evaluating multi-level book exhaustion, fill pricing, and residual cancellation.
//
// Beats:
//   1. Define SweepOrderIntent, LevelSweepResult, and SweepExecutionReport structures.
//   2. Evaluate multi-level liquidity availability against limit price caps.
//   3. Execute fills across ladder rungs and return aggregate executed volume and VWAP.

pub type SweepOrderIntent = struct {
    taker_order_id: Int,
    side: String,
    shares: Int,
    limit_price_cap_fixed: Int,
    order_type: String,
    timestamp_ns: Int,
};

pub type LevelSweepResult = struct {
    price_fixed: Int,
    shares_filled: Int,
    remaining_taker_shares: Int,
};

pub type SweepExecutionReport = struct {
    taker_order_id: Int,
    requested_shares: Int,
    filled_shares: Int,
    average_price_fixed: Int,
    total_notional_fixed: Int,
    is_fully_filled: Bool,
    is_fok_rejected: Bool,
};

pub fn sweep_order_intent_new(
    oid: Int,
    side: String,
    qty: Int,
    cap_px: Int,
    otype: String,
    ts: Int
) -> SweepOrderIntent {
    return SweepOrderIntent {
        taker_order_id: oid,
        side: side,
        shares: qty,
        limit_price_cap_fixed: cap_px,
        order_type: otype,
        timestamp_ns: ts,
    };
}

pub fn sweep_execution_report_new(oid: Int, req_qty: Int) -> SweepExecutionReport {
    return SweepExecutionReport {
        taker_order_id: oid,
        requested_shares: req_qty,
        filled_shares: 0,
        average_price_fixed: 0,
        total_notional_fixed: 0,
        is_fully_filled: false,
        is_fok_rejected: false,
    };
}

pub fn apply_level_sweep_fill(
    report: &mut SweepExecutionReport,
    level_px: Int,
    level_avail_shares: Int,
    is_buy: Bool,
    cap_px: Int
) -> Int {
    if (report).is_fully_filled {
        return 0;
    }

    if cap_px > 0 {
        if is_buy && level_px > cap_px { return 0; }
        if !is_buy && level_px < cap_px { return 0; }
    }

    let needed: Int = (report).requested_shares - (report).filled_shares;
    let filled: Int = if needed < level_avail_shares { needed } else { level_avail_shares };

    (report).filled_shares = (report).filled_shares + filled;
    (report).total_notional_fixed = (report).total_notional_fixed + (filled * level_px);

    if (report).filled_shares > 0 {
        (report).average_price_fixed = (report).total_notional_fixed / (report).filled_shares;
    }

    if (report).filled_shares >= (report).requested_shares {
        (report).is_fully_filled = true;
    }

    return filled;
}
