// # Exchange Market Session Trading State Machine
//
// Logline: Tracks global and symbol-specific exchange trading session states (Pre-Open, Cross, Continuous Trading, Halt, Closed).
//
// Setup: Market state coordinator managing transitions across daily exchange operational phases and regulatory halt states.
//
// Beats:
//   1. Define MarketSessionState, SessionTransitionEvent, and TradingStateTracker structures.
//   2. Validate order acceptance entitlements across trading sessions.
//   3. Handle regulatory trading halts, resumption quotes, and closing cross transitions.

pub type MarketSessionState = struct {
    symbol: String,
    session_phase: String,
    is_trading_allowed: Bool,
    is_quoting_allowed: Bool,
    is_cross_in_progress: Bool,
    last_phase_transition_ts_ns: Int,
};

pub type SessionTransitionEvent = struct {
    symbol: String,
    previous_phase: String,
    new_phase: String,
    reason: String,
    timestamp_ns: Int,
};

pub fn market_session_state_new(symbol: String) -> MarketSessionState {
    return MarketSessionState {
        symbol: symbol,
        session_phase: "PRE_OPEN",
        is_trading_allowed: false,
        is_quoting_allowed: true,
        is_cross_in_progress: false,
        last_phase_transition_ts_ns: 0,
    };
}

pub fn transition_session_phase(
    state: &mut MarketSessionState,
    new_phase: String,
    reason: String,
    ts: Int
) -> SessionTransitionEvent {
    let prev: String = (state).session_phase;
    (state).session_phase = new_phase;
    (state).last_phase_transition_ts_ns = ts;

    if new_phase == "CONTINUOUS_TRADING" {
        (state).is_trading_allowed = true;
        (state).is_quoting_allowed = true;
        (state).is_cross_in_progress = false;
    } else if new_phase == "HALT" || new_phase == "PAUSE" {
        (state).is_trading_allowed = false;
        (state).is_quoting_allowed = false;
        (state).is_cross_in_progress = false;
    } else if new_phase == "OPENING_CROSS" || new_phase == "CLOSING_CROSS" {
        (state).is_trading_allowed = false;
        (state).is_quoting_allowed = true;
        (state).is_cross_in_progress = true;
    } else if new_phase == "CLOSED" {
        (state).is_trading_allowed = false;
        (state).is_quoting_allowed = false;
        (state).is_cross_in_progress = false;
    }

    return SessionTransitionEvent {
        symbol: (state).symbol,
        previous_phase: prev,
        new_phase: new_phase,
        reason: reason,
        timestamp_ns: ts,
    };
}

pub fn can_accept_new_orders(state: &MarketSessionState) -> Bool {
    return (state).is_quoting_allowed || (state).is_trading_allowed;
}
