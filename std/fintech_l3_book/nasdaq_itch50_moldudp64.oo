// # NASDAQ MoldUDP64 Transport Protocol Processor
//
// Logline: Implements MoldUDP64 downstream packet header parsing, sequence validation, and session packet framing.
//
// Setup: Protocol layer handling UDP multicast feeds for ITCH 5.0 market data distribution.
//
// Beats:
//   1. Define MoldPacketHeader and MoldSessionState structures.
//   2. Validate sequence continuity and detect dropped packet ranges.
//   3. Extract message payload blocks from multi-message MoldUDP packets.

pub type MoldPacketHeader = struct {
    session_id: String,
    sequence_number: Int,
    message_count: Int,
};

pub type MoldSessionState = struct {
    session_id: String,
    expected_sequence_number: Int,
    packets_received: Int,
    packets_lost: Int,
    heartbeats_received: Int,
    is_synchronized: Bool,
};

pub type MoldMessageBlock = struct {
    sequence_number: Int,
    message_length: Int,
    offset_in_packet: Int,
};

pub fn mold_header_new(sess: String, seq: Int, count: Int) -> MoldPacketHeader {
    return MoldPacketHeader {
        session_id: sess,
        sequence_number: seq,
        message_count: count,
    };
}

pub fn mold_session_state_new(sess: String, start_seq: Int) -> MoldSessionState {
    return MoldSessionState {
        session_id: sess,
        expected_sequence_number: start_seq,
        packets_received: 0,
        packets_lost: 0,
        heartbeats_received: 0,
        is_synchronized: true,
    };
}

pub fn mold_process_packet_header(
    state: &mut MoldSessionState,
    header: &MoldPacketHeader
) -> Int {
    if (header).message_count == 0 {
        (state).heartbeats_received = (state).heartbeats_received + 1;
        return 0;
    }

    (state).packets_received = (state).packets_received + 1;
    let seq_diff: Int = (header).sequence_number - (state).expected_sequence_number;

    if seq_diff > 0 {
        (state).packets_lost = (state).packets_lost + seq_diff;
        (state).is_synchronized = false;
    }

    let next_expected: Int = (header).sequence_number + (header).message_count;
    (state).expected_sequence_number = next_expected;
    return seq_diff;
}

pub fn mold_is_heartbeat(header: &MoldPacketHeader) -> Bool {
    return (header).message_count == 0;
}

pub fn mold_is_end_of_session(header: &MoldPacketHeader) -> Bool {
    return (header).message_count == 65535;
}

pub fn mold_create_message_block(
    seq: Int,
    len: Int,
    offset: Int
) -> MoldMessageBlock {
    return MoldMessageBlock {
        sequence_number: seq,
        message_length: len,
        offset_in_packet: offset,
    };
}
