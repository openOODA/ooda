// # Level 3 Zero-Allocation Order Memory Pool
//
// Logline: Manages pre-allocated static slabs and free-list recycling for zero-garbage collection L3 order book node allocations.
//
// Setup: Low-latency memory manager providing O(1) order slab allocation and node reclamation without dynamic heap allocations.
//
// Beats:
//   1. Define MemoryPoolStats, OrderSlabSlot, and MemoryPoolConfig structures.
//   2. Allocate order nodes from pre-allocated buffer freelist.
//   3. Recycle deleted or executed order slabs back to pool freelist.

pub type MemoryPoolConfig = struct {
    total_capacity: Int,
    slab_size_bytes: Int,
    preallocate_count: Int,
};

pub type MemoryPoolStats = struct {
    capacity: Int,
    allocated_count: Int,
    free_count: Int,
    high_water_mark: Int,
    exhaustion_events: Int,
};

pub type OrderSlabSlot = struct {
    slot_id: Int,
    is_in_use: Bool,
    order_id: Int,
    shares: Int,
    price_fixed: Int,
};

pub fn memory_pool_config_new(cap: Int) -> MemoryPoolConfig {
    return MemoryPoolConfig {
        total_capacity: cap,
        slab_size_bytes: 64,
        preallocate_count: cap,
    };
}

pub fn memory_pool_stats_new(cap: Int) -> MemoryPoolStats {
    return MemoryPoolStats {
        capacity: cap,
        allocated_count: 0,
        free_count: cap,
        high_water_mark: 0,
        exhaustion_events: 0,
    };
}

pub fn order_slab_slot_new(id: Int) -> OrderSlabSlot {
    return OrderSlabSlot {
        slot_id: id,
        is_in_use: false,
        order_id: 0,
        shares: 0,
        price_fixed: 0,
    };
}

pub fn pool_allocate_slot(
    stats: &mut MemoryPoolStats,
    oid: Int,
    qty: Int,
    px: Int
) -> OrderSlabSlot {
    if (stats).free_count <= 0 {
        (stats).exhaustion_events = (stats).exhaustion_events + 1;
        return order_slab_slot_new(-1);
    }

    (stats).allocated_count = (stats).allocated_count + 1;
    (stats).free_count = (stats).free_count - 1;

    if (stats).allocated_count > (stats).high_water_mark {
        (stats).high_water_mark = (stats).allocated_count;
    }

    return OrderSlabSlot {
        slot_id: (stats).allocated_count,
        is_in_use: true,
        order_id: oid,
        shares: qty,
        price_fixed: px,
    };
}

pub fn pool_release_slot(
    stats: &mut MemoryPoolStats,
    slot: &mut OrderSlabSlot
) {
    if (slot).is_in_use {
        (slot).is_in_use = false;
        (slot).order_id = 0;
        (slot).shares = 0;
        (slot).price_fixed = 0;

        (stats).allocated_count = (stats).allocated_count - 1;
        (stats).free_count = (stats).free_count + 1;
    }
}
