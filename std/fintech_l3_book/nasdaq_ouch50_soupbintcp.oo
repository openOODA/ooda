// # NASDAQ SoupBinTCP 3.0 Session Protocol
//
// Logline: Implements point-to-point SoupBinTCP 3.0 session layer state machine, heartbeat timers, and sequence management.
//
// Setup: Transport session layer establishing secure, sequenced, bidirectional TCP connectivity for OUCH 5.0 gateways.
//
// Beats:
//   1. Define SoupSessionState, SoupLoginRequest, and SoupPacket structures.
//   2. Manage session lifecycle transitions (Connecting, Connected, Active, LoggedOut).
//   3. Validate client/server heartbeats, inbound sequence tracking, and logout handshakes.

pub type SoupPacket = struct {
    packet_type: String,
    payload_len: Int,
    sequence_number: Int
};

pub type SoupLoginRequest = struct {
    username: String,
    password: String,
    session_id: String,
    requested_sequence_number: Int
};

pub type SoupSessionState = struct {
    session_id: String,
    username: String,
    is_authenticated: Bool,
    inbound_seq: Int,
    outbound_seq: Int,
    last_heartbeat_sent_ns: Int,
    last_heartbeat_rcvd_ns: Int,
    heartbeat_interval_ms: Int,
    session_status: String
};

pub fn soup_session_new(user: String, heartbeat_ms: Int) -> SoupSessionState {
    return SoupSessionState {
        session_id: "",
        username: user,
        is_authenticated: false,
        inbound_seq: 1,
        outbound_seq: 1,
        last_heartbeat_sent_ns: 0,
        last_heartbeat_rcvd_ns: 0,
        heartbeat_interval_ms: heartbeat_ms,
        session_status: "DISCONNECTED"
    };
}

pub fn soup_create_login_request(
    user: String,
    pass: String,
    sess: String,
    seq: Int
) -> SoupLoginRequest {
    return SoupLoginRequest {
        username: user,
        password: pass,
        session_id: sess,
        requested_sequence_number: seq
    };
}

pub fn soup_handle_login_accepted(
    state: &mut SoupSessionState,
    sess: String,
    next_seq: Int,
    now_ns: Int
) {
    (state).session_id = sess;
    (state).inbound_seq = next_seq;
    (state).is_authenticated = true;
    (state).session_status = "LOGGED_IN";
    (state).last_heartbeat_rcvd_ns = now_ns;
}

pub fn soup_handle_login_rejected(
    state: &mut SoupSessionState,
    reject_reason: String
) {
    (state).is_authenticated = false;
    (state).session_status = "REJECTED";
}

pub fn soup_process_sequenced_packet(
    state: &mut SoupSessionState,
    now_ns: Int
) -> Int {
    let current_seq: Int = (state).inbound_seq;
    (state).inbound_seq = (state).inbound_seq + 1;
    (state).last_heartbeat_rcvd_ns = now_ns;
    return current_seq;
}

pub fn soup_is_heartbeat_needed(
    state: &SoupSessionState,
    now_ns: Int
) -> Bool {
    if !(state).is_authenticated {
        return false;
    }
    let elapsed_ns: Int = now_ns - (state).last_heartbeat_sent_ns;
    let interval_ns: Int = (state).heartbeat_interval_ms * 1000000;
    return elapsed_ns >= interval_ns;
}
