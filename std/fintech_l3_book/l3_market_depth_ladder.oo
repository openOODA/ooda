// # Level 3 to Level 2 Market Depth Ladder Aggregator
//
// Logline: Aggregates discrete Level 3 order events into consolidated multi-level price ladders (L2 market depth).
//
// Setup: Market data transformation pipeline generating consolidated price levels and depth views from granular L3 streams.
//
// Beats:
//   1. Define DepthLevel and DepthLadder structures.
//   2. Aggregate resting shares and order counts across distinct price ticks.
//   3. Compute top N depth levels and cumulative depth volumes.

pub type DepthLevel = struct {
    price_fixed: Int,
    shares: Int,
    order_count: Int,
};

pub type DepthLadder = struct {
    symbol: String,
    side: String,
    level1: DepthLevel,
    level2: DepthLevel,
    level3: DepthLevel,
    level4: DepthLevel,
    level5: DepthLevel,
    total_depth_shares: Int,
};

pub fn depth_level_new(px: Int, qty: Int, count: Int) -> DepthLevel {
    return DepthLevel {
        price_fixed: px,
        shares: qty,
        order_count: count,
    };
}

pub fn depth_level_empty() -> DepthLevel {
    return DepthLevel {
        price_fixed: 0,
        shares: 0,
        order_count: 0,
    };
}

pub fn depth_ladder_new(symbol: String, side: String) -> DepthLadder {
    return DepthLadder {
        symbol: symbol,
        side: side,
        level1: depth_level_empty(),
        level2: depth_level_empty(),
        level3: depth_level_empty(),
        level4: depth_level_empty(),
        level5: depth_level_empty(),
        total_depth_shares: 0,
    };
}

pub fn depth_ladder_set_levels(
    ladder: &mut DepthLadder,
    l1: &DepthLevel,
    l2: &DepthLevel,
    l3: &DepthLevel,
    l4: &DepthLevel,
    l5: &DepthLevel
) {
    (ladder).level1 = *l1;
    (ladder).level2 = *l2;
    (ladder).level3 = *l3;
    (ladder).level4 = *l4;
    (ladder).level5 = *l5;
    (ladder).total_depth_shares = (l1).shares + (l2).shares + (l3).shares + (l4).shares + (l5).shares;
}

pub fn depth_ladder_compute_vwap(ladder: &DepthLadder) -> Int {
    let tot_shares: Int = (ladder).total_depth_shares;
    if tot_shares <= 0 {
        return 0;
    }

    let notional: Int = ((ladder).level1.shares * (ladder).level1.price_fixed) +
                        ((ladder).level2.shares * (ladder).level2.price_fixed) +
                        ((ladder).level3.shares * (ladder).level3.price_fixed) +
                        ((ladder).level4.shares * (ladder).level4.price_fixed) +
                        ((ladder).level5.shares * (ladder).level5.price_fixed);

    return notional / tot_shares;
}
