// # NASDAQ ITCH 5.0 Message Structures
//
// Logline: Defines canonical binary message structures and payload layouts for the NASDAQ TotalView-ITCH 5.0 feed.
//
// Setup: Pure data specification module for ultra-low latency direct market data decoding.
//
// Beats:
//   1. Define message header and individual ITCH 5.0 event struct schemas.
//   2. Provide constructors for AddOrder, Executed, Cancel, Delete, Replace, and Cross messages.
//   3. Implement message tag identification and byte size lookup helpers.

pub type ItchHeader = struct {
    msg_type: String,
    locate_code: Int,
    tracking_number: Int,
    timestamp_ns: Int,
};

pub type ItchAddOrder = struct {
    header: ItchHeader,
    order_id: Int,
    buy_sell_indicator: String,
    shares: Int,
    stock: String,
    price_fixed: Int,
    mpid: String,
};

pub type ItchOrderExecuted = struct {
    header: ItchHeader,
    order_id: Int,
    executed_shares: Int,
    match_number: Int,
};

pub type ItchOrderExecutedWithPrice = struct {
    header: ItchHeader,
    order_id: Int,
    executed_shares: Int,
    match_number: Int,
    printable: Bool,
    execution_price_fixed: Int,
};

pub type ItchOrderCancel = struct {
    header: ItchHeader,
    order_id: Int,
    canceled_shares: Int,
};

pub type ItchOrderDelete = struct {
    header: ItchHeader,
    order_id: Int,
};

pub type ItchOrderReplace = struct {
    header: ItchHeader,
    original_order_id: Int,
    new_order_id: Int,
    shares: Int,
    price_fixed: Int,
};

pub type ItchTradeCross = struct {
    header: ItchHeader,
    shares: Int,
    stock: String,
    cross_price_fixed: Int,
    match_number: Int,
    cross_type: String,
};

pub type ItchSystemEvent = struct {
    header: ItchHeader,
    event_code: String,
};

pub fn itch_header_new(mtype: String, locate: Int, track: Int, ts: Int) -> ItchHeader {
    return ItchHeader {
        msg_type: mtype,
        locate_code: locate,
        tracking_number: track,
        timestamp_ns: ts,
    };
}

pub fn itch_add_order_new(
    hdr: ItchHeader,
    oid: Int,
    side: String,
    qty: Int,
    symbol: String,
    px: Int,
    mpid: String
) -> ItchAddOrder {
    return ItchAddOrder {
        header: hdr,
        order_id: oid,
        buy_sell_indicator: side,
        shares: qty,
        stock: symbol,
        price_fixed: px,
        mpid: mpid,
    };
}

pub fn itch_order_executed_new(
    hdr: ItchHeader,
    oid: Int,
    qty: Int,
    match_id: Int
) -> ItchOrderExecuted {
    return ItchOrderExecuted {
        header: hdr,
        order_id: oid,
        executed_shares: qty,
        match_number: match_id,
    };
}

pub fn itch_order_replace_new(
    hdr: ItchHeader,
    orig_id: Int,
    new_id: Int,
    qty: Int,
    px: Int
) -> ItchOrderReplace {
    return ItchOrderReplace {
        header: hdr,
        original_order_id: orig_id,
        new_order_id: new_id,
        shares: qty,
        price_fixed: px,
    };
}

pub fn itch_message_payload_size(msg_type: String) -> Int {
    if msg_type == "S" { return 12; }
    if msg_type == "R" { return 39; }
    if msg_type == "H" { return 25; }
    if msg_type == "Y" { return 20; }
    if msg_type == "L" { return 26; }
    if msg_type == "V" { return 35; }
    if msg_type == "W" { return 12; }
    if msg_type == "K" { return 28; }
    if msg_type == "J" { return 35; }
    if msg_type == "h" { return 21; }
    if msg_type == "A" { return 36; }
    if msg_type == "F" { return 40; }
    if msg_type == "E" { return 31; }
    if msg_type == "C" { return 36; }
    if msg_type == "X" { return 23; }
    if msg_type == "D" { return 19; }
    if msg_type == "U" { return 35; }
    if msg_type == "P" { return 44; }
    if msg_type == "Q" { return 40; }
    if msg_type == "B" { return 19; }
    if msg_type == "I" { return 50; }
    if msg_type == "N" { return 20; }
    return 0;
}
