// # Level 3 Direct Market Order Book Core
//
// Logline: Implements high-performance Level 3 (L3) order book maintaining individual order IDs, price ladders, and book updates.
//
// Setup: Core order book engine processing ITCH 5.0 Add, Execute, Cancel, and Delete messages.
//
// Beats:
//   1. Define L3BookSummary, L3BookOrderEntry, and L3OrderBookState structures.
//   2. Insert new limit orders and update bid/ask ladders.
//   3. Handle executions, cancellations, order deletions, and top-of-book updates.

pub type L3BookOrderEntry = struct {
    order_id: Int,
    side: String,
    shares: Int,
    price_fixed: Int,
    timestamp_ns: Int
};

pub type L3BookSummary = struct {
    symbol: String,
    best_bid_fixed: Int,
    best_bid_shares: Int,
    best_ask_fixed: Int,
    best_ask_shares: Int,
    total_bid_orders: Int,
    total_ask_orders: Int,
    total_bid_shares: Int,
    total_ask_shares: Int
};

pub type L3OrderBookState = struct {
    symbol: String,
    total_orders_inserted: Int,
    total_orders_executed: Int,
    total_orders_canceled: Int,
    last_update_ts_ns: Int,
    summary: L3BookSummary
};

pub fn l3_book_summary_new(symbol: String) -> L3BookSummary {
    return L3BookSummary {
        symbol: symbol,
        best_bid_fixed: 0,
        best_bid_shares: 0,
        best_ask_fixed: 0,
        best_ask_shares: 0,
        total_bid_orders: 0,
        total_ask_orders: 0,
        total_bid_shares: 0,
        total_ask_shares: 0
    };
}

pub fn l3_order_book_state_new(symbol: String) -> L3OrderBookState {
    return L3OrderBookState {
        symbol: symbol,
        total_orders_inserted: 0,
        total_orders_executed: 0,
        total_orders_canceled: 0,
        last_update_ts_ns: 0,
        summary: l3_book_summary_new(symbol)
    };
}

pub fn l3_book_add_order(
    state: &mut L3OrderBookState,
    side: String,
    shares: Int,
    price_fixed: Int,
    ts: Int
) {
    (state).total_orders_inserted = (state).total_orders_inserted + 1;
    (state).last_update_ts_ns = ts;

    if side == "B" {
        (state).summary.total_bid_orders = (state).summary.total_bid_orders + 1;
        (state).summary.total_bid_shares = (state).summary.total_bid_shares + shares;
        if price_fixed > (state).summary.best_bid_fixed {
            (state).summary.best_bid_fixed = price_fixed;
            (state).summary.best_bid_shares = shares;
        } else if price_fixed == (state).summary.best_bid_fixed {
            (state).summary.best_bid_shares = (state).summary.best_bid_shares + shares;
        }
    } else {
        (state).summary.total_ask_orders = (state).summary.total_ask_orders + 1;
        (state).summary.total_ask_shares = (state).summary.total_ask_shares + shares;
        if (state).summary.best_ask_fixed == 0 || price_fixed < (state).summary.best_ask_fixed {
            (state).summary.best_ask_fixed = price_fixed;
            (state).summary.best_ask_shares = shares;
        } else if price_fixed == (state).summary.best_ask_fixed {
            (state).summary.best_ask_shares = (state).summary.best_ask_shares + shares;
        }
    }
}

pub fn l3_book_execute_order(
    state: &mut L3OrderBookState,
    side: String,
    executed_shares: Int,
    ts: Int
) {
    (state).total_orders_executed = (state).total_orders_executed + 1;
    (state).last_update_ts_ns = ts;

    if side == "B" {
        (state).summary.total_bid_shares = (state).summary.total_bid_shares - executed_shares;
        if (state).summary.total_bid_shares < 0 { (state).summary.total_bid_shares = 0; }
        (state).summary.best_bid_shares = (state).summary.best_bid_shares - executed_shares;
        if (state).summary.best_bid_shares < 0 { (state).summary.best_bid_shares = 0; }
    } else {
        (state).summary.total_ask_shares = (state).summary.total_ask_shares - executed_shares;
        if (state).summary.total_ask_shares < 0 { (state).summary.total_ask_shares = 0; }
        (state).summary.best_ask_shares = (state).summary.best_ask_shares - executed_shares;
        if (state).summary.best_ask_shares < 0 { (state).summary.best_ask_shares = 0; }
    }
}
