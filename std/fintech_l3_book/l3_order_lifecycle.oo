// # Level 3 Order State Machine and Lifecycle
//
// Logline: Manages discrete order state transitions (PendingNew, Active, PartiallyFilled, Filled, Canceled, Replaced, Expired).
//
// Setup: Core order state engine enforcing deterministic state machine transitions for individual L3 resting orders.
//
// Beats:
//   1. Define L3OrderState enum/string tags and L3OrderRecord structures.
//   2. Validate permitted state transitions according to exchange protocol specifications.
//   3. Transition orders on execution fills, partial cancellations, and full terminal states.

pub type L3OrderRecord = struct {
    order_id: Int,
    side: String,
    symbol: String,
    shares: Int,
    price_fixed: Int,
    filled_shares: Int,
    state: String,
    entry_timestamp_ns: Int,
    last_update_timestamp_ns: Int
};

pub type StateTransitionResult = struct {
    valid: Bool,
    previous_state: String,
    new_state: String,
    is_terminal: Bool
};

pub fn l3_order_record_new(
    oid: Int,
    side: String,
    symbol: String,
    shares: Int,
    px: Int,
    ts: Int
) -> L3OrderRecord {
    return L3OrderRecord {
        order_id: oid,
        side: side,
        symbol: symbol,
        shares: shares,
        price_fixed: px,
        filled_shares: 0,
        state: "ACTIVE",
        entry_timestamp_ns: ts,
        last_update_timestamp_ns: ts
    };
}

pub fn transition_l3_order_fill(
    order: &mut L3OrderRecord,
    exec_qty: Int,
    now_ts: Int
) -> StateTransitionResult {
    let prev: String = (order).state;
    (order).filled_shares = (order).filled_shares + exec_qty;
    (order).last_update_timestamp_ns = now_ts;

    if (order).filled_shares >= (order).shares {
        (order).state = "FILLED";
        return StateTransitionResult {
            valid: true,
            previous_state: prev,
            new_state: "FILLED",
            is_terminal: true
        };
    }

    (order).state = "PARTIALLY_FILLED";
    return StateTransitionResult {
        valid: true,
        previous_state: prev,
        new_state: "PARTIALLY_FILLED",
        is_terminal: false
    };
}

pub fn transition_l3_order_cancel(
    order: &mut L3OrderRecord,
    cancel_qty: Int,
    now_ts: Int
) -> StateTransitionResult {
    let prev: String = (order).state;
    (order).last_update_timestamp_ns = now_ts;
    (order).shares = (order).shares - cancel_qty;

    if (order).shares <= (order).filled_shares {
        (order).state = "CANCELED";
        return StateTransitionResult {
            valid: true,
            previous_state: prev,
            new_state: "CANCELED",
            is_terminal: true
        };
    }

    return StateTransitionResult {
        valid: true,
        previous_state: prev,
        new_state: (order).state,
        is_terminal: false
    };
}

pub fn is_order_active(order: &L3OrderRecord) -> Bool {
    return (order).state == "ACTIVE" || (order).state == "PARTIALLY_FILLED";
}
