// # Drop Copy Real-Time Execution Audit Stream
//
// Logline: Replicates exchange order and execution events into Drop Copy streams for risk clearing, compliance, and post-trade accounting.
//
// Setup: High-throughput audit stream generator formatting FIX 4.2/4.4 and binary execution replication records.
//
// Beats:
//   1. Define DropCopyRecord, DropCopySession, and DropCopyMetrics structures.
//   2. Replicate OUCH order acks, executions, cancels, and corrections.
//   3. Maintain sequenced delivery and audit trail reconciliation timestamps.

pub type DropCopyRecord = struct {
    sequence_number: Int,
    exec_id: String,
    cl_ord_id: Int,
    order_id: Int,
    exec_type: String,
    ord_status: String,
    symbol: String,
    side: String,
    shares: Int,
    price_fixed: Int,
    last_shares: Int,
    last_price_fixed: Int,
    cum_shares: Int,
    leaves_shares: Int,
    transact_time_ns: Int,
    account: String,
};

pub type DropCopySession = struct {
    session_id: String,
    target_firm: String,
    last_sent_seq: Int,
    total_records_sent: Int,
    is_active: Bool,
};

pub type DropCopyMetrics = struct {
    total_fills_copied: Int,
    total_cancels_copied: Int,
    total_rejects_copied: Int,
    total_notional_cleared_fixed: Int,
};

pub fn drop_copy_session_new(sess: String, firm: String) -> DropCopySession {
    return DropCopySession {
        session_id: sess,
        target_firm: firm,
        last_sent_seq: 0,
        total_records_sent: 0,
        is_active: true,
    };
}

pub fn drop_copy_metrics_new() -> DropCopyMetrics {
    return DropCopyMetrics {
        total_fills_copied: 0,
        total_cancels_copied: 0,
        total_rejects_copied: 0,
        total_notional_cleared_fixed: 0,
    };
}

pub fn create_drop_copy_fill(
    seq: Int,
    exec_id: String,
    cl_ord_id: Int,
    order_id: Int,
    symbol: String,
    side: String,
    fill_qty: Int,
    fill_px: Int,
    cum_qty: Int,
    leaves_qty: Int,
    ts: Int,
    acct: String
) -> DropCopyRecord {
    let status: String = if leaves_qty == 0 { "FILLED" } else { "PARTIALLY_FILLED" };
    return DropCopyRecord {
        sequence_number: seq,
        exec_id: exec_id,
        cl_ord_id: cl_ord_id,
        order_id: order_id,
        exec_type: "TRADE",
        ord_status: status,
        symbol: symbol,
        side: side,
        shares: cum_qty + leaves_qty,
        price_fixed: fill_px,
        last_shares: fill_qty,
        last_price_fixed: fill_px,
        cum_shares: cum_qty,
        leaves_shares: leaves_qty,
        transact_time_ns: ts,
        account: acct,
    };
}

pub fn drop_copy_process_record(
    sess: &mut DropCopySession,
    metrics: &mut DropCopyMetrics,
    rec: &DropCopyRecord
) {
    (sess).last_sent_seq = (rec).sequence_number;
    (sess).total_records_sent = (sess).total_records_sent + 1;

    if (rec).exec_type == "TRADE" {
        (metrics).total_fills_copied = (metrics).total_fills_copied + 1;
        (metrics).total_notional_cleared_fixed = (metrics).total_notional_cleared_fixed + ((rec).last_shares * (rec).last_price_fixed);
    } else if (rec).exec_type == "CANCELED" {
        (metrics).total_cancels_copied = (metrics).total_cancels_copied + 1;
    } else if (rec).exec_type == "REJECTED" {
        (metrics).total_rejects_copied = (metrics).total_rejects_copied + 1;
    }
}
