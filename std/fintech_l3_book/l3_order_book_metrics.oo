// # Level 3 Real-Time Order Book Microstructure Analytics
//
// Logline: Calculates real-time microstructural metrics including spread, order flow imbalance, book slope, and cancel-to-fill ratios.
//
// Setup: Quantitative market microstructure engine deriving real-time market quality and adverse selection indicators from L3 state.
//
// Beats:
//   1. Define L3MicrostructureMetrics and BookImbalanceState structures.
//   2. Compute top-level and weighted depth imbalance ratios.
//   3. Calculate order cancellation velocity and market maker replenishment slope.

pub type L3MicrostructureMetrics = struct {
    symbol: String,
    bid_ask_spread_fixed: Int,
    spread_bps: Int,
    top_level_imbalance_ratio: Float,
    effective_spread_fixed: Int,
    order_churn_ratio: Float,
    timestamp_ns: Int,
};

pub type BookImbalanceState = struct {
    total_adds: Int,
    total_cancels: Int,
    total_fills: Int,
    last_update_ts_ns: Int,
};

pub fn book_imbalance_state_new() -> BookImbalanceState {
    return BookImbalanceState {
        total_adds: 0,
        total_cancels: 0,
        total_fills: 0,
        last_update_ts_ns: 0,
    };
}

pub fn compute_l3_microstructure_metrics(
    symbol: String,
    bid_px: Int,
    bid_qty: Int,
    ask_px: Int,
    ask_qty: Int,
    state: &BookImbalanceState,
    now_ts: Int
) -> L3MicrostructureMetrics {
    let spread: Int = if ask_px >= bid_px && bid_px > 0 { ask_px - bid_px } else { 0 };
    let mid_px: Int = (bid_px + ask_px) / 2;
    let s_bps: Int = if mid_px > 0 { (spread * 10000) / mid_px } else { 0 };

    let tot_qty: Int = bid_qty + ask_qty;
    let mut imb_ratio: Float = 0.5;

    if tot_qty > 0 {
        let mut b_f: Float = 0.0;
        let mut t_f: Float = 0.0;

        let mut cb: Int = bid_qty;
        while cb >= 1000 { b_f = b_f + 1000.0; cb = cb - 1000; }
        while cb >= 1 { b_f = b_f + 1.0; cb = cb - 1; }

        let mut ct: Int = tot_qty;
        while ct >= 1000 { t_f = t_f + 1000.0; ct = ct - 1000; }
        while ct >= 1 { t_f = t_f + 1.0; ct = ct - 1; }

        imb_ratio = b_f / t_f;
    }

    let mut churn: Float = 0.0;
    if (state).total_fills > 0 {
        let mut c_f: Float = 0.0;
        let mut f_f: Float = 0.0;

        let mut cc: Int = (state).total_cancels;
        while cc >= 1000 { c_f = c_f + 1000.0; cc = cc - 1000; }
        while cc >= 1 { c_f = c_f + 1.0; cc = cc - 1; }

        let mut cf: Int = (state).total_fills;
        while cf >= 1000 { f_f = f_f + 1000.0; cf = cf - 1000; }
        while cf >= 1 { f_f = f_f + 1.0; cf = cf - 1; }

        churn = c_f / f_f;
    }

    return L3MicrostructureMetrics {
        symbol: symbol,
        bid_ask_spread_fixed: spread,
        spread_bps: s_bps,
        top_level_imbalance_ratio: imb_ratio,
        effective_spread_fixed: spread,
        order_churn_ratio: churn,
        timestamp_ns: now_ts,
    };
}
