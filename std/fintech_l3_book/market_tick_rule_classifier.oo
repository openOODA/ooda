// # Market Tick Rule and Trade Aggressor Classifier
//
// Logline: Classifies trade aggressor side and tick direction (Uptick, Downtick, Zero-Uptick, Zero-Downtick) from price changes and BBO quotes.
//
// Setup: Order flow analysis module determining buyer vs seller trade initiation using tick and quote rules.
//
// Beats:
//   1. Define TickClassification and TickClassifierState structures.
//   2. Apply Lee-Ready algorithm comparing trade price to prevailing BBO midpoint.
//   3. Fall back to classic Tick Rule when trade executes at exact midprice.

pub type TickClassification = struct {
    trade_price_fixed: Int,
    trade_shares: Int,
    tick_direction: String,
    aggressor_side: String,
    is_buyer_initiated: Bool,
    timestamp_ns: Int
};

pub type TickClassifierState = struct {
    symbol: String,
    last_trade_price_fixed: Int,
    last_tick_direction: String,
    total_buy_volume: Int,
    total_sell_volume: Int
};

pub fn tick_classifier_state_new(symbol: String) -> TickClassifierState {
    return TickClassifierState {
        symbol: symbol,
        last_trade_price_fixed: 0,
        last_tick_direction: "NONE",
        total_buy_volume: 0,
        total_sell_volume: 0
    };
}

pub fn classify_trade_tick(
    state: &mut TickClassifierState,
    price_fixed: Int,
    shares: Int,
    bid_fixed: Int,
    ask_fixed: Int,
    ts: Int
) -> TickClassification {
    let mut dir: String = "NONE";
    let mut agg_side: String = "UNKNOWN";
    let mut is_buy: Bool = false;

    if price_fixed > (state).last_trade_price_fixed && (state).last_trade_price_fixed > 0 {
        dir = "UPTICK";
    } else if price_fixed < (state).last_trade_price_fixed && (state).last_trade_price_fixed > 0 {
        dir = "DOWNTICK";
    } else if price_fixed == (state).last_trade_price_fixed {
        dir = if (state).last_tick_direction == "UPTICK" || (state).last_tick_direction == "ZERO_UPTICK" {
            "ZERO_UPTICK"
        } else {
            "ZERO_DOWNTICK"
        };
    }

    if bid_fixed > 0 && ask_fixed > 0 {
        let mid: Int = (bid_fixed + ask_fixed) / 2;
        if price_fixed > mid {
            agg_side = "BUY";
            is_buy = true;
        } else if price_fixed < mid {
            agg_side = "SELL";
            is_buy = false;
        } else {
            is_buy = (dir == "UPTICK") || (dir == "ZERO_UPTICK");
            agg_side = if is_buy { "BUY" } else { "SELL" };
        }
    } else {
        is_buy = (dir == "UPTICK") || (dir == "ZERO_UPTICK");
        agg_side = if is_buy { "BUY" } else { "SELL" };
    }

    (state).last_trade_price_fixed = price_fixed;
    (state).last_tick_direction = dir;

    if is_buy {
        (state).total_buy_volume = (state).total_buy_volume + shares;
    } else {
        (state).total_sell_volume = (state).total_sell_volume + shares;
    }

    return TickClassification {
        trade_price_fixed: price_fixed,
        trade_shares: shares,
        tick_direction: dir,
        aggressor_side: agg_side,
        is_buyer_initiated: is_buy,
        timestamp_ns: ts
    };
}
