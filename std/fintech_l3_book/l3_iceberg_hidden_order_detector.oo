// # Level 3 Iceberg and Hidden Order Detector
//
// Logline: Detects undisclosed iceberg orders and hidden reserve quantities from ITCH execution events without visible order additions.
//
// Setup: Market microstructure analytics module discovering hidden liquidity replenishment at active price levels.
//
// Beats:
//   1. Define IcebergDetectorState, IcebergSignature, and HiddenLiquidityEvent structures.
//   2. Analyze trade executions exceeding previously displayed L3 order quantities.
//   3. Track display replenishment patterns and estimate total hidden order size.

pub type IcebergSignature = struct {
    price_fixed: Int,
    side: String,
    estimated_peak_size: Int,
    total_hidden_executed_shares: Int,
    refresh_count: Int,
    last_refresh_timestamp_ns: Int,
};

pub type IcebergDetectorState = struct {
    symbol: String,
    detected_iceberg_count: Int,
    total_hidden_shares_detected: Int,
    last_event_timestamp_ns: Int,
};

pub fn iceberg_detector_state_new(symbol: String) -> IcebergDetectorState {
    return IcebergDetectorState {
        symbol: symbol,
        detected_iceberg_count: 0,
        total_hidden_shares_detected: 0,
        last_event_timestamp_ns: 0,
    };
}

pub fn iceberg_signature_new(
    px: Int,
    side: String,
    peak_qty: Int,
    ts: Int
) -> IcebergSignature {
    return IcebergSignature {
        price_fixed: px,
        side: side,
        estimated_peak_size: peak_qty,
        total_hidden_executed_shares: 0,
        refresh_count: 0,
        last_refresh_timestamp_ns: ts,
    };
}

pub fn record_iceberg_execution(
    state: &mut IcebergDetectorState,
    sig: &mut IcebergSignature,
    executed_qty: Int,
    visible_qty_before_trade: Int,
    now_ts: Int
) -> Bool {
    let is_hidden_fill: Bool = executed_qty > visible_qty_before_trade;

    if is_hidden_fill {
        let hidden_slice: Int = executed_qty - visible_qty_before_trade;
        (sig).total_hidden_executed_shares = (sig).total_hidden_executed_shares + hidden_slice;
        (sig).refresh_count = (sig).refresh_count + 1;
        (sig).last_refresh_timestamp_ns = now_ts;

        (state).total_hidden_shares_detected = (state).total_hidden_shares_detected + hidden_slice;
        (state).last_event_timestamp_ns = now_ts;
        return true;
    }

    return false;
}
