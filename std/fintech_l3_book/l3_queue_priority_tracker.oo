// # Level 3 Queue Priority & Ahead-Volume Tracker
//
// Logline: Tracks exact queue position, ahead order volume, and behind order volume for resting limit orders.
//
// Setup: Quantitative execution model tracking queue priority depletion to estimate fill probabilities and queue wait times.
//
// Beats:
//   1. Define QueuePriorityPosition and QueueDepletionEvent structures.
//   2. Initialize queue position with shares ahead at order insertion time.
//   3. Deduct front-of-queue executions and cancellations to track queue progression.

pub type QueuePriorityPosition = struct {
    order_id: Int,
    price_fixed: Int,
    my_order_shares: Int,
    shares_ahead: Int,
    shares_behind: Int,
    initial_shares_ahead: Int,
    is_at_head_of_queue: Bool,
};

pub type QueueDepletionEvent = struct {
    shares_depleted_ahead: Int,
    shares_added_behind: Int,
    is_fully_at_head: Bool,
};

pub fn queue_priority_position_new(
    oid: Int,
    px: Int,
    my_qty: Int,
    ahead_qty: Int,
    behind_qty: Int
) -> QueuePriorityPosition {
    let at_head: Bool = ahead_qty == 0;
    return QueuePriorityPosition {
        order_id: oid,
        price_fixed: px,
        my_order_shares: my_qty,
        shares_ahead: ahead_qty,
        shares_behind: behind_qty,
        initial_shares_ahead: ahead_qty,
        is_at_head_of_queue: at_head,
    };
}

pub fn update_queue_depletion(
    pos: &mut QueuePriorityPosition,
    trade_or_cancel_shares_at_price: Int
) -> QueueDepletionEvent {
    let mut depleted: Int = 0;

    if (pos).shares_ahead > 0 {
        if trade_or_cancel_shares_at_price >= (pos).shares_ahead {
            depleted = (pos).shares_ahead;
            (pos).shares_ahead = 0;
            (pos).is_at_head_of_queue = true;
        } else {
            depleted = trade_or_cancel_shares_at_price;
            (pos).shares_ahead = (pos).shares_ahead - trade_or_cancel_shares_at_price;
        }
    }

    return QueueDepletionEvent {
        shares_depleted_ahead: depleted,
        shares_added_behind: 0,
        is_fully_at_head: (pos).is_at_head_of_queue,
    };
}

pub fn compute_queue_progress_pct(pos: &QueuePriorityPosition) -> Float {
    if (pos).initial_shares_ahead <= 0 {
        return 100.0;
    }

    let progress: Int = (pos).initial_shares_ahead - (pos).shares_ahead;
    let mut prog_f: Float = 0.0;
    let mut init_f: Float = 0.0;

    let mut cp: Int = progress;
    while cp >= 1000 { prog_f = prog_f + 1000.0; cp = cp - 1000; }
    while cp >= 1 { prog_f = prog_f + 1.0; cp = cp - 1; }

    let mut ci: Int = (pos).initial_shares_ahead;
    while ci >= 1000 { init_f = init_f + 1000.0; ci = ci - 1000; }
    while ci >= 1 { init_f = init_f + 1.0; ci = ci - 1; }

    return (prog_f / init_f) * 100.0;
}
