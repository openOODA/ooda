// # Level 3 Price Level FIFO Queue
//
// Logline: Maintains discrete FIFO order queue structures per price level with aggregated share volumes and order counts.
//
// Setup: Price level container storing resting orders in time priority at a single fixed-point tick.
//
// Beats:
//   1. Define L3PriceLevel and L3QueueNode structures.
//   2. Add orders to queue tail, updating aggregate depth and order count.
//   3. Execute and cancel orders from queue head, managing FIFO priority advancement.

pub type L3QueueNode = struct {
    order_id: Int,
    shares: Int,
    entry_timestamp_ns: Int,
};

pub type L3PriceLevel = struct {
    price_fixed: Int,
    total_shares: Int,
    order_count: Int,
    head_order_id: Int,
    tail_order_id: Int,
};

pub fn l3_price_level_new(px: Int) -> L3PriceLevel {
    return L3PriceLevel {
        price_fixed: px,
        total_shares: 0,
        order_count: 0,
        head_order_id: 0,
        tail_order_id: 0,
    };
}

pub fn l3_queue_node_new(oid: Int, qty: Int, ts: Int) -> L3QueueNode {
    return L3QueueNode {
        order_id: oid,
        shares: qty,
        entry_timestamp_ns: ts,
    };
}

pub fn l3_price_level_add_order(
    level: &mut L3PriceLevel,
    node: &L3QueueNode
) {
    (level).total_shares = (level).total_shares + (node).shares;
    (level).order_count = (level).order_count + 1;

    if (level).order_count == 1 {
        (level).head_order_id = (node).order_id;
    }
    (level).tail_order_id = (node).order_id;
}

pub fn l3_price_level_reduce_shares(
    level: &mut L3PriceLevel,
    shares_reduced: Int,
    is_order_fully_removed: Bool
) {
    (level).total_shares = (level).total_shares - shares_reduced;
    if (level).total_shares < 0 {
        (level).total_shares = 0;
    }

    if is_order_fully_removed && (level).order_count > 0 {
        (level).order_count = (level).order_count - 1;
        if (level).order_count == 0 {
            (level).head_order_id = 0;
            (level).tail_order_id = 0;
        }
    }
}

pub fn l3_price_level_is_empty(level: &L3PriceLevel) -> Bool {
    return (level).order_count == 0 || (level).total_shares == 0;
}
