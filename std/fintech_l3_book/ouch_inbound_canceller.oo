// # OUCH High-Speed Inbound Canceller and Kill Switch
//
// Logline: Executes Cancel-on-Disconnect (COD), mass order cancellation sweeps, and emergency trading halts for OUCH sessions.
//
// Setup: DMA emergency risk mitigation module cancelling outstanding resting orders upon network drop or kill switch trigger.
//
// Beats:
//   1. Define MassCancelRequest, KillSwitchConfig, and CancelSweepSummary structures.
//   2. Trigger session-wide or symbol-specific order cancellations.
//   3. Handle Cancel-on-Disconnect heartbeat timeouts and produce cancellation audit events.

pub type MassCancelRequest = struct {
    session_id: String,
    firm_id: String,
    symbol_filter: String,
    side_filter: String,
    reason: String,
    timestamp_ns: Int,
};

pub type KillSwitchConfig = struct {
    is_kill_switch_active: Bool,
    auto_cancel_on_disconnect: Bool,
    cod_timeout_ms: Int,
    authorized_admin: String,
};

pub type CancelSweepSummary = struct {
    orders_targeted: Int,
    orders_canceled: Int,
    shares_canceled: Int,
    elapsed_time_ns: Int,
    success: Bool,
};

pub fn kill_switch_config_default() -> KillSwitchConfig {
    return KillSwitchConfig {
        is_kill_switch_active: false,
        auto_cancel_on_disconnect: true,
        cod_timeout_ms: 1000,
        authorized_admin: "RISK_DESK",
    };
}

pub fn mass_cancel_request_new(
    sess: String,
    firm: String,
    symbol: String,
    reason: String,
    ts: Int
) -> MassCancelRequest {
    return MassCancelRequest {
        session_id: sess,
        firm_id: firm,
        symbol_filter: symbol,
        side_filter: "ALL",
        reason: reason,
        timestamp_ns: ts,
    };
}

pub fn cancel_sweep_summary_new(targeted: Int) -> CancelSweepSummary {
    return CancelSweepSummary {
        orders_targeted: targeted,
        orders_canceled: 0,
        shares_canceled: 0,
        elapsed_time_ns: 0,
        success: true,
    };
}

pub fn evaluate_cod_trigger(
    cfg: &KillSwitchConfig,
    last_heartbeat_ns: Int,
    now_ns: Int
) -> Bool {
    if !(cfg).auto_cancel_on_disconnect {
        return false;
    }
    let elapsed_ns: Int = now_ns - last_heartbeat_ns;
    let timeout_ns: Int = (cfg).cod_timeout_ms * 1000000;
    return elapsed_ns > timeout_ns;
}
