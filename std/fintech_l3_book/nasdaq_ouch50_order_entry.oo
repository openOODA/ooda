// # NASDAQ OUCH 5.0 Order Entry Protocol
//
// Logline: Formats and parses NASDAQ OUCH 5.0 binary order entry messages for sub-microsecond direct market execution.
//
// Setup: Low-latency DMA order entry protocol encoder/decoder handling Enter, Replace, Cancel, Accepted, Executed, and Canceled messages.
//
// Beats:
//   1. Define OUCH inbound request and outbound response struct schemas.
//   2. Construct EnterOrder, ReplaceOrder, and CancelOrder binary records.
//   3. Decode OrderAccepted, OrderRejected, OrderExecuted, and BrokenTrade notifications.

pub type OuchEnterOrder = struct {
    user_ref_number: Int,
    side: String,
    shares: Int,
    stock: String,
    price_fixed: Int,
    time_in_force: Int,
    firm_id: String,
    display: String,
    capacity: String,
    iso_eligible: Bool
};

pub type OuchReplaceOrder = struct {
    existing_user_ref_number: Int,
    new_user_ref_number: Int,
    shares: Int,
    price_fixed: Int,
    time_in_force: Int,
    display: String
};

pub type OuchCancelOrder = struct {
    user_ref_number: Int,
    shares: Int
};

pub type OuchOrderAccepted = struct {
    timestamp_ns: Int,
    user_ref_number: Int,
    side: String,
    shares: Int,
    stock: String,
    price_fixed: Int,
    time_in_force: Int,
    firm_id: String,
    display: String,
    order_reference_number: Int,
    order_state: String
};

pub type OuchOrderRejected = struct {
    timestamp_ns: Int,
    user_ref_number: Int,
    reject_reason_code: String
};

pub type OuchOrderExecuted = struct {
    timestamp_ns: Int,
    user_ref_number: Int,
    executed_shares: Int,
    execution_price_fixed: Int,
    liquidity_flag: String,
    match_number: Int
};

pub type OuchOrderCanceled = struct {
    timestamp_ns: Int,
    user_ref_number: Int,
    decrement_shares: Int,
    reason: String
};

pub fn ouch_enter_order_new(
    ref_num: Int,
    side: String,
    qty: Int,
    symbol: String,
    px: Int,
    tif: Int,
    firm: String
) -> OuchEnterOrder {
    return OuchEnterOrder {
        user_ref_number: ref_num,
        side: side,
        shares: qty,
        stock: symbol,
        price_fixed: px,
        time_in_force: tif,
        firm_id: firm,
        display: "Y",
        capacity: "P",
        iso_eligible: false
    };
}

pub fn ouch_replace_order_new(
    old_ref: Int,
    new_ref: Int,
    qty: Int,
    px: Int,
    tif: Int
) -> OuchReplaceOrder {
    return OuchReplaceOrder {
        existing_user_ref_number: old_ref,
        new_user_ref_number: new_ref,
        shares: qty,
        price_fixed: px,
        time_in_force: tif,
        display: "Y"
    };
}

pub fn ouch_cancel_order_new(ref_num: Int, qty: Int) -> OuchCancelOrder {
    return OuchCancelOrder {
        user_ref_number: ref_num,
        shares: qty
    };
}

pub fn ouch_order_accepted_new(
    ts: Int,
    ref_num: Int,
    side: String,
    qty: Int,
    symbol: String,
    px: Int,
    order_ref: Int
) -> OuchOrderAccepted {
    return OuchOrderAccepted {
        timestamp_ns: ts,
        user_ref_number: ref_num,
        side: side,
        shares: qty,
        stock: symbol,
        price_fixed: px,
        time_in_force: 0,
        firm_id: "",
        display: "Y",
        order_reference_number: order_ref,
        order_state: "LIVE"
    };
}

pub fn ouch_is_passive_fill(exec: &OuchOrderExecuted) -> Bool {
    return (exec).liquidity_flag == "A" || (exec).liquidity_flag == "M";
}
