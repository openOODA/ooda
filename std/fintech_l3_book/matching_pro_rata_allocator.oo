// # Pro-Rata and Split-FIFO Matching Allocator
//
// Logline: Allocates execution fills proportionately to resting order sizes with minimum allocation thresholds and remainder distribution.
//
// Setup: Derivatives and interest-rate matching engine model allocating trades based on resting quote volume share.
//
// Beats:
//   1. Define ProRataAllocation, ProRataConfig, and ProRataResult structures.
//   2. Calculate proportional share allocations across all resting orders at price level.
//   3. Handle fractional share remainders and apply FIFO priority tie-breakers.

pub type ProRataConfig = struct {
    min_allocation_shares: Int,
    enable_top_step_fifo: Bool,
    top_step_pct: Float,
};

pub type ProRataAllocation = struct {
    order_id: Int,
    resting_shares: Int,
    allocated_shares: Int,
    remainder_awarded: Bool,
};

pub type ProRataResult = struct {
    total_shares_matched: Int,
    total_remainder_shares: Int,
    allocations_count: Int,
};

pub fn pro_rata_config_default() -> ProRataConfig {
    return ProRataConfig {
        min_allocation_shares: 1,
        enable_top_step_fifo: false,
        top_step_pct: 0.0,
    };
}

pub fn pro_rata_result_new() -> ProRataResult {
    return ProRataResult {
        total_shares_matched: 0,
        total_remainder_shares: 0,
        allocations_count: 0,
    };
}

pub fn calculate_pro_rata_share(
    taker_shares: Int,
    order_shares: Int,
    total_level_shares: Int,
    min_alloc: Int
) -> Int {
    if total_level_shares <= 0 {
        return 0;
    }

    let raw_alloc: Int = (taker_shares * order_shares) / total_level_shares;
    if raw_alloc < min_alloc && taker_shares >= min_alloc {
        return 0;
    }
    return if raw_alloc <= order_shares { raw_alloc } else { order_shares };
}

pub fn pro_rata_allocation_new(
    oid: Int,
    resting: Int,
    allocated: Int
) -> ProRataAllocation {
    return ProRataAllocation {
        order_id: oid,
        resting_shares: resting,
        allocated_shares: allocated,
        remainder_awarded: false,
    };
}
