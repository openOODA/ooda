// # Level 3 Order Book Snapshot Rebuilder
//
// Logline: Rapidly initializes L3 book state from a Glimpse baseline snapshot and replays incremental ITCH 5.0 delta logs.
//
// Setup: Fast state initialization module synchronizing offline book snapshots with real-time streaming multicast feeds.
//
// Beats:
//   1. Define SnapshotRebuildStatus and SnapshotCheckpoint structures.
//   2. Load baseline resting orders up to snapshot synchronization sequence.
//   3. Buffer and replay post-snapshot ITCH deltas to achieve real-time synchronization.

pub type SnapshotCheckpoint = struct {
    sequence_number: Int,
    snapshot_timestamp_ns: Int,
    order_count: Int,
    total_shares: Int
};

pub type SnapshotRebuildStatus = struct {
    symbol: String,
    is_snapshot_applied: Bool,
    is_fully_synchronized: Bool,
    baseline_sequence: Int,
    current_sequence: Int,
    buffered_deltas_count: Int,
    replayed_deltas_count: Int
};

pub fn snapshot_rebuild_status_new(symbol: String) -> SnapshotRebuildStatus {
    return SnapshotRebuildStatus {
        symbol: symbol,
        is_snapshot_applied: false,
        is_fully_synchronized: false,
        baseline_sequence: 0,
        current_sequence: 0,
        buffered_deltas_count: 0,
        replayed_deltas_count: 0
    };
}

pub fn snapshot_checkpoint_new(seq: Int, ts: Int, count: Int, shares: Int) -> SnapshotCheckpoint {
    return SnapshotCheckpoint {
        sequence_number: seq,
        snapshot_timestamp_ns: ts,
        order_count: count,
        total_shares: shares
    };
}

pub fn apply_snapshot_checkpoint(
    status: &mut SnapshotRebuildStatus,
    checkpoint: &SnapshotCheckpoint
) {
    (status).is_snapshot_applied = true;
    (status).baseline_sequence = (checkpoint).sequence_number;
    (status).current_sequence = (checkpoint).sequence_number;
}

pub fn replay_delta_message(
    status: &mut SnapshotRebuildStatus,
    delta_seq: Int
) -> Bool {
    if !(status).is_snapshot_applied {
        return false;
    }

    if delta_seq <= (status).baseline_sequence {
        return false;
    }

    (status).current_sequence = delta_seq;
    (status).replayed_deltas_count = (status).replayed_deltas_count + 1;
    (status).is_fully_synchronized = true;
    return true;
}
