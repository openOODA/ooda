// # OUCH Firm ID and Self-Match Prevention (SMP) Filter
//
// Logline: Filters and validates Market Participant Identifiers (MPID) and executes Self-Match Prevention policies.
//
// Setup: DMA gateway compliance filter preventing illegal wash sales and self-crosses across trading desks.
//
// Beats:
//   1. Define MpidConfig, SmpPolicy, and SmpCheckResult structures.
//   2. Enforce SMP policies: Cancel Newest (CN), Cancel Oldest (CO), and Decrement and Cancel (DC).
//   3. Validate firm identifier authorization and routing desk entitlements.

pub type MpidConfig = struct {
    mpid: String,
    firm_id: String,
    smp_group_id: String,
    is_active: Bool,
    default_smp_policy: String,
};

pub type SmpCheckResult = struct {
    is_self_match: Bool,
    action_required: String,
    canceled_order_id: Int,
    remaining_shares: Int,
    reason: String,
};

pub fn mpid_config_new(
    mpid: String,
    firm: String,
    smp_group: String,
    policy: String
) -> MpidConfig {
    return MpidConfig {
        mpid: mpid,
        firm_id: firm,
        smp_group_id: smp_group,
        is_active: true,
        default_smp_policy: policy,
    };
}

pub fn smp_evaluate_cross(
    maker_smp_group: String,
    maker_order_id: Int,
    maker_shares: Int,
    taker_smp_group: String,
    taker_order_id: Int,
    taker_shares: Int,
    policy: String
) -> SmpCheckResult {
    if maker_smp_group == "" || taker_smp_group == "" || maker_smp_group != taker_smp_group {
        return SmpCheckResult {
            is_self_match: false,
            action_required: "ALLOW_TRADE",
            canceled_order_id: 0,
            remaining_shares: taker_shares,
            reason: "DIFFERENT_GROUPS",
        };
    }

    if policy == "CN" {
        return SmpCheckResult {
            is_self_match: true,
            action_required: "CANCEL_NEWEST",
            canceled_order_id: taker_order_id,
            remaining_shares: 0,
            reason: "SMP_CANCEL_NEWEST",
        };
    }

    if policy == "CO" {
        return SmpCheckResult {
            is_self_match: true,
            action_required: "CANCEL_OLDEST",
            canceled_order_id: maker_order_id,
            remaining_shares: taker_shares,
            reason: "SMP_CANCEL_OLDEST",
        };
    }

    let diff: Int = taker_shares - maker_shares;
    let rem: Int = if diff > 0 { diff } else { 0 };
    return SmpCheckResult {
        is_self_match: true,
        action_required: "DECREMENT_AND_CANCEL",
        canceled_order_id: maker_order_id,
        remaining_shares: rem,
        reason: "SMP_DECREMENT",
    };
}

pub fn is_mpid_authorized(cfg: &MpidConfig, target_firm: String) -> Bool {
    return (cfg).is_active && ((cfg).firm_id == target_firm);
}
