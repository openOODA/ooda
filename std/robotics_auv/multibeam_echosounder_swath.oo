// # Multibeam Echosounder (MBES) Swath Beamforming & Sounding
//
// Logline: Converts multibeam acoustic array receive beams into roll/pitch compensated 3D bathymetric seabed sounding soundings.
//
// Setup: High-density swath bathymetry processor applying Mills-Cross beamsteering and SVP refraction correction.
//
// Beats:
//   1. Define Multibeam array specifications (swath aperture angle, number of beams e.g. 256 beams).
//   2. Apply vehicle roll, pitch, and yaw attitude transformations to individual beam steering angles.
//   3. Compute individual beam acoustic two-way travel time slant depth and across-track offset.
//   4. Deliver georeferenced seabed bathymetry point soundings in NED frame.

import "./auv_hydrodynamics_constants.oo";
import "./fossen_6dof_hydrodynamics.oo";

pub type MbesConfig = struct {
    carrier_frequency_khz: Float,
    swath_coverage_angle_rad: Float, // e.g. 130 deg (2.268 rad)
    number_of_beams: Int,
    sound_speed_m_s: Float,
    max_depth_rating_m: Float
};

pub type MbesBeamSounding = struct {
    beam_index: Int,
    two_way_travel_time_s: Float,
    beam_steering_angle_rad: Float, // Relative to transducer normal
    intensity_db: Float
};

pub type BathymetricPoint = struct {
    x_north_m: Float,
    y_east_m: Float,
    seabed_depth_m: Float,
    across_track_m: Float,
    is_valid: Bool
};

pub fn mbes_config_default_em2040() -> MbesConfig {
    return MbesConfig {
        carrier_frequency_khz: 300.0, // 300 kHz Kongsberg EM2040
        swath_coverage_angle_rad: 2.268928, // 130 deg swath
        number_of_beams: 256,
        sound_speed_m_s: 1500.0,
        max_depth_rating_m: 600.0
    };
}

pub fn mbes_solve_sounding(
    cfg: &MbesConfig,
    beam: &MbesBeamSounding,
    pose: &AuvPose
) -> BathymetricPoint {
    let c: Float = (cfg).sound_speed_m_s;
    let r_slant: Float = (c * (beam).two_way_travel_time_s) * 0.5;

    if (r_slant < 0.5) || (r_slant > 200.0) {
        return BathymetricPoint {
            x_north_m: 0.0, y_east_m: 0.0, seabed_depth_m: 0.0,
            across_track_m: 0.0, is_valid: false
        };
    }

    // Correct steering angle with vehicle roll angle phi
    let theta_roll_corr: Float = (beam).beam_steering_angle_rad + (pose).phi;

    // Transducer frame coordinate offsets
    let dy_trans: Float = r_slant * sin(theta_roll_corr);
    let dz_trans: Float = r_slant * cos(theta_roll_corr);

    // Rotate horizontal offsets by heading psi
    let cpsi: Float = cos((pose).psi);
    let spsi: Float = sin((pose).psi);

    let dx_ned: Float = 0.0 - (dy_trans * spsi);
    let dy_ned: Float = dy_trans * cpsi;

    let pt_x: Float = (pose).x + dx_ned;
    let pt_y: Float = (pose).y + dy_ned;
    let pt_z: Float = (pose).z + dz_trans;

    return BathymetricPoint {
        x_north_m: pt_x,
        y_east_m: pt_y,
        seabed_depth_m: pt_z,
        across_track_m: dy_trans,
        is_valid: true
    };
}
