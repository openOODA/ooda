// # Marine Hydrodynamics & Oceanographic Physical Constants
//
// Logline: Defines standard ocean water physical properties, acoustic propagation parameters, and core 3D/6D mathematical primitives.
//
// Setup: Core constants and vector operations tailored for autonomous underwater vehicles and marine hydrodynamic simulation.
//
// Beats:
//   1. Provide seawater thermodynamic constants (density, salinity, kinematic viscosity, bulk modulus).
//   2. Implement empirical UNESCO / Mackenzie speed of sound equation in seawater.
//   3. Define 3D vector, 6-DOF generalized coordinate, and spatial transformation utilities.
//   4. Supply transcendental, trigonometric, and logarithmic math helper functions.

pub type Vector3 = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub type Vector6 = struct {
    surge: Float,
    sway: Float,
    heave: Float,
    roll: Float,
    pitch: Float,
    yaw: Float,
};

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vector3 {
    return Vector3 { x: x, y: y, z: z };
}

pub fn vec3_zero() -> Vector3 {
    return Vector3 { x: 0.0, y: 0.0, z: 0.0 };
}

pub fn vec3_add(a: Vector3, b: Vector3) -> Vector3 {
    return Vector3 {
        x: (a).x + (b).x,
        y: (a).y + (b).y,
        z: (a).z + (b).z,
    };
}

pub fn vec3_sub(a: Vector3, b: Vector3) -> Vector3 {
    return Vector3 {
        x: (a).x - (b).x,
        y: (a).y - (b).y,
        z: (a).z - (b).z,
    };
}

pub fn vec3_scale(v: Vector3, s: Float) -> Vector3 {
    return Vector3 {
        x: (v).x * s,
        y: (v).y * s,
        z: (v).z * s,
    };
}

pub fn vec3_dot(a: Vector3, b: Vector3) -> Float {
    return ((a).x * (b).x) + ((a).y * (b).y) + ((a).z * (b).z);
}

pub fn vec3_cross(a: Vector3, b: Vector3) -> Vector3 {
    return Vector3 {
        x: ((a).y * (b).z) - ((a).z * (b).y),
        y: ((a).z * (b).x) - ((a).x * (b).z),
        z: ((a).x * (b).y) - ((a).y * (b).x),
    };
}

pub fn vec3_norm(v: Vector3) -> Float {
    return sqrt(vec3_dot(v, v));
}

pub fn vec3_normalize(v: Vector3) -> Vector3 {
    let n: Float = vec3_norm(v);
    if n <= 0.000000001 {
        return vec3_zero();
    }
    return vec3_scale(v, 1.0 / n);
}

pub fn vec6_new(u: Float, v: Float, w: Float, p: Float, q: Float, r: Float) -> Vector6 {
    return Vector6 {
        surge: u,
        sway: v,
        heave: w,
        roll: p,
        pitch: q,
        yaw: r,
    };
}

pub fn vec6_zero() -> Vector6 {
    return Vector6 {
        surge: 0.0,
        sway: 0.0,
        heave: 0.0,
        roll: 0.0,
        pitch: 0.0,
        yaw: 0.0,
    };
}

pub fn vec6_add(a: Vector6, b: Vector6) -> Vector6 {
    return Vector6 {
        surge: (a).surge + (b).surge,
        sway: (a).sway + (b).sway,
        heave: (a).heave + (b).heave,
        roll: (a).roll + (b).roll,
        pitch: (a).pitch + (b).pitch,
        yaw: (a).yaw + (b).yaw,
    };
}

pub fn const_pi() -> Float { return 3.141592653589793; }
pub fn const_two_pi() -> Float { return 6.283185307179586; }
pub fn const_g() -> Float { return 9.80665; }
pub fn const_seawater_density_std() -> Float { return 1025.0; }
pub fn const_freshwater_density() -> Float { return 1000.0; }
pub fn const_kinematic_viscosity_seawater() -> Float { return 0.00000105; }
pub fn const_bulk_modulus_water() -> Float { return 2200000000.0; }

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn math_min(a: Float, b: Float) -> Float {
    if a < b { return a; }
    return b;
}

pub fn math_max(a: Float, b: Float) -> Float {
    if a > b { return a; }
    return b;
}

pub fn math_clamp(v: Float, lo: Float, hi: Float) -> Float {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

pub fn math_atan_unit(z: Float) -> Float {
    let z2: Float = z * z;
    let poly: Float = z2 * (0.3333333333333333 - (z2 * (0.2 - (z2 * 0.14285714285714285))));
    return z * (1.0 - poly);
}

pub fn math_atan(z: Float) -> Float {
    let abs_z: Float = math_abs(z);
    if abs_z <= 1.0 {
        let res: Float = math_atan_unit(abs_z);
        if z < 0.0 { return 0.0 - res; }
        return res;
    }
    let half_pi: Float = const_pi() / 2.0;
    let res: Float = half_pi - math_atan_unit(1.0 / abs_z);
    if z < 0.0 { return 0.0 - res; }
    return res;
}

pub fn math_atan2(y: Float, x: Float) -> Float {
    let pi_val: Float = const_pi();
    if x > 0.0 { return math_atan(y / x); }
    if x < 0.0 {
        if y >= 0.0 { return math_atan(y / x) + pi_val; }
        return math_atan(y / x) - pi_val;
    }
    if y > 0.0 { return pi_val / 2.0; }
    if y < 0.0 { return 0.0 - (pi_val / 2.0); }
    return 0.0;
}

pub fn math_acos(x: Float) -> Float {
    let clamped: Float = math_clamp(x, 0.0 - 1.0, 1.0);
    let s: Float = sqrt(1.0 - (clamped * clamped));
    return math_atan2(s, clamped);
}

pub fn math_asin(x: Float) -> Float {
    let clamped: Float = math_clamp(x, 0.0 - 1.0, 1.0);
    let c: Float = sqrt(1.0 - (clamped * clamped));
    return math_atan2(clamped, c);
}

pub fn sound_speed_mackenzie(temperature_c: Float, salinity_ppt: Float, depth_m: Float) -> Float {
    let t: Float = temperature_c;
    let s: Float = salinity_ppt;
    let d: Float = depth_m;
    return 1448.96 + (4.591 * t) - (0.05304 * t * t) + (0.0002374 * t * t * t) 
        + (1.340 * (s - 35.0)) + (0.0163 * d) + (0.0000001675 * d * d) 
        - (0.01025 * t * (s - 35.0)) - (0.0000007139 * t * d * d * d);
}

pub fn seawater_density_unesco(temperature_c: Float, salinity_ppt: Float) -> Float {
    let t: Float = temperature_c;
    let s: Float = salinity_ppt;
    let rho_fresh: Float = 999.842594 + (0.06793952 * t) - (0.00909529 * t * t) + (0.0001001685 * t * t * t);
    let a: Float = 0.824493 - (0.0040899 * t) + (0.000076438 * t * t);
    let b: Float = 0.0 - 0.00572466 + (0.00010227 * t);
    let c: Float = 0.00048314;
    return rho_fresh + (a * s) + (b * (s * sqrt(s))) + (c * s * s);
}
