// # Singularity-Free 3D Vector Field Guidance Law
//
// Logline: Generates continuous 3D convergent vector fields for straight-line tracks, circular orbits, and helical diving profiles.
//
// Setup: Nelson & Beard vector field guidance creating globally stable velocity reference fields for autonomous marine tracking.
//
// Beats:
//   1. Define vector field parameters (convergence gain k_conv, entry angle chi_inf, orbit radius R_orbit).
//   2. Compute straight-line path convergent vector field heading chi_d(y_e).
//   3. Compute circular loiter orbit guidance vector field with radius convergence.
//   4. Deliver 3D normalized velocity direction vector in Earth-fixed NED coordinates.

import "./auv_hydrodynamics_constants.oo";
import "./fossen_6dof_hydrodynamics.oo";

pub type VectorFieldConfig = struct {
    k_convergence: Float,
    entry_angle_rad: Float, // Typically pi/2 or 0.8 rad
    orbit_radius_m: Float,
    vertical_gain_kz: Float,
};

pub fn vector_field_config_default() -> VectorFieldConfig {
    return VectorFieldConfig {
        k_convergence: 0.15,
        entry_angle_rad: 1.2, // ~70 deg
        orbit_radius_m: 20.0,
        vertical_gain_kz: 0.1,
    };
}

pub fn vector_field_straight_line(
    cfg: &VectorFieldConfig,
    current_pos: &Vector3,
    line_start: &Vector3,
    line_end: &Vector3
) -> Vector3 {
    let dx: Float = (line_end).x - (line_start).x;
    let dy: Float = (line_end).y - (line_start).y;
    let path_heading: Float = math_atan2(dy, dx);

    let px: Float = (current_pos).x - (line_start).x;
    let py: Float = (current_pos).y - (line_start).y;

    // Cross-track distance
    let y_e: Float = (0.0 - (px * sin(path_heading))) + (py * cos(path_heading));

    // Vector field course angle: chi_d = path_heading - chi_inf * (2/pi) * atan(k * y_e)
    let factor: Float = (2.0 / const_pi()) * (cfg).entry_angle_rad;
    let course_offset: Float = factor * math_atan((cfg).k_convergence * y_e);
    let chi_d: Float = path_heading - course_offset;

    // Vertical convergence
    let z_e: Float = (current_pos).z - (line_start).z;
    let vz_cmd: Float = 0.0 - ((cfg).vertical_gain_kz * z_e);

    return vec3_new(cos(chi_d), sin(chi_d), vz_cmd);
}

pub fn vector_field_circular_orbit(
    cfg: &VectorFieldConfig,
    current_pos: &Vector3,
    orbit_center: &Vector3
) -> Vector3 {
    let dx: Float = (current_pos).x - (orbit_center).x;
    let dy: Float = (current_pos).y - (orbit_center).y;
    let r_dist: Float = sqrt((dx * dx) + (dy * dy));

    let phi_angle: Float = math_atan2(dy, dx);
    let r_target: Float = (cfg).orbit_radius_m;
    let d_error: Float = r_dist - r_target;

    // Radial entry angle
    let factor: Float = (2.0 / const_pi()) * (cfg).entry_angle_rad;
    let theta_radial: Float = factor * math_atan((cfg).k_convergence * d_error);

    // Tangential direction (counter-clockwise) + radial attraction
    let course_angle: Float = phi_angle + (const_pi() / 2.0) + theta_radial;

    return vec3_new(cos(course_angle), sin(course_angle), 0.0);
}
