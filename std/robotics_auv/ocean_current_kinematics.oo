// # 3D Ocean Current Kinematics & Relative Velocity
//
// Logline: Models 3D ocean currents, Ekman spiral depth shear, and transforms relative water velocities into body-fixed coordinates.
//
// Setup: Fossen relative velocity formulation nu_r = nu - nu_c ensuring accurate hydrodynamic force evaluation in ambient currents.
//
// Beats:
//   1. Define 3D ocean current vector in NED frame [v_c_north, v_c_east, v_c_down].
//   2. Compute logarithmic boundary layer and Ekman depth decay profiles.
//   3. Transform NED current into body-fixed coordinates via transpose rotation matrix R_b_n^T.
//   4. Calculate 6-DOF relative velocity vector nu_r for hydrodynamic drag and lifting computations.

import "./auv_hydrodynamics_constants.oo";
import "./fossen_6dof_hydrodynamics.oo";

pub type OceanCurrentProfile = struct {
    surface_speed_m_s: Float,
    direction_rad: Float,
    shear_depth_m: Float,
    vertical_speed_m_s: Float,
};

pub fn ocean_current_profile_default() -> OceanCurrentProfile {
    return OceanCurrentProfile {
        surface_speed_m_s: 0.5,
        direction_rad: 0.785398, // 45 deg (North-East)
        shear_depth_m: 50.0,
        vertical_speed_m_s: 0.0,
    };
}

pub fn compute_current_at_depth(
    profile: &OceanCurrentProfile,
    depth_z: Float
) -> Vector3 {
    let v0: Float = (profile).surface_speed_m_s;
    let dir: Float = (profile).direction_rad;
    let h: Float = (profile).shear_depth_m;

    let mut speed: Float = v0;
    if depth_z > 0.0 {
        // Linear / exponential depth attenuation
        let ratio: Float = depth_z / h;
        if ratio < 1.0 {
            speed = v0 * (1.0 - (0.5 * ratio));
        } else {
            speed = v0 * 0.5;
        }
    }

    let vc_n: Float = speed * cos(dir);
    let vc_e: Float = speed * sin(dir);
    let vc_d: Float = (profile).vertical_speed_m_s;

    return vec3_new(vc_n, vc_e, vc_d);
}

pub fn ned_to_body_current(
    vc_ned: &Vector3,
    phi: Float,
    theta: Float,
    psi: Float
) -> Vector3 {
    let rot: Matrix3x3 = fossen_rotation_matrix_body_to_ned(phi, theta, psi);
    let vn: Float = (vc_ned).x;
    let ve: Float = (vc_ned).y;
    let vd: Float = (vc_ned).z;

    // Multiply by R_b_n^T (transpose of R_b_n)
    let u_c: Float = ((rot).r11 * vn) + ((rot).r21 * ve) + ((rot).r31 * vd);
    let v_c: Float = ((rot).r12 * vn) + ((rot).r22 * ve) + ((rot).r32 * vd);
    let w_c: Float = ((rot).r13 * vn) + ((rot).r23 * ve) + ((rot).r33 * vd);

    return vec3_new(u_c, v_c, w_c);
}

pub fn compute_relative_velocity(
    nu: &AuvVelocity,
    vc_body: &Vector3
) -> AuvVelocity {
    return AuvVelocity {
        u: (nu).u - (vc_body).x,
        v: (nu).v - (vc_body).y,
        w: (nu).w - (vc_body).z,
        p: (nu).p, // Irrotational current assumption
        q: (nu).q,
        r: (nu).r,
    };
}
