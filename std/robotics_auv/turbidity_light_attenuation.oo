// # Seawater Optical Turbidity & Beer-Lambert Light Attenuation
//
// Logline: Jerlov c = a+b+k NTU and two-way Beer-Lambert. Int milli destub.
//
// Setup: Underwater optical transmission; Koschmieder range.
//
// Beats:
//   1. a, b, NTU, strobe, contrast threshold.
//   2. c = a + b + 0.08 NTU.
//   3. T = 1 / (1 + cd + 0.5 cd^2 + 1/6 cd^3), cd = 2 c d.
//   4. R_max = 3.912 / c.

type OpticalWaterConfig = struct {
    absorption_milli: Int,
    scattering_milli: Int,
    turbidity_milli_ntu: Int,
    strobe_lumens: Int,
    camera_min_contrast_milli: Int
};

type OpticalTransmissionOutput = struct {
    total_attenuation_milli: Int,
    transmission_milli: Int,
    max_visible_range_mm: Int,
    estimated_contrast_milli: Int
};

pub fn optical_water_config_default_clear() -> OpticalWaterConfig {
    return OpticalWaterConfig {
        absorption_milli: 50,
        scattering_milli: 30,
        turbidity_milli_ntu: 200,
        strobe_lumens: 5000,
        camera_min_contrast_milli: 20
    };
}

pub fn optical_water_config_coastal_turbid() -> OpticalWaterConfig {
    return OpticalWaterConfig {
        absorption_milli: 350,
        scattering_milli: 650,
        turbidity_milli_ntu: 5000,
        strobe_lumens: 5000,
        camera_min_contrast_milli: 20
    };
}

pub fn compute_optical_attenuation(cfg: OpticalWaterConfig, target_distance_m: Int) -> OpticalTransmissionOutput {
    let a: Int = cfg.absorption_milli;
    let b: Int = cfg.scattering_milli;
    let ntu: Int = cfg.turbidity_milli_ntu;
    let c_total: Int = a + b + ((80 * ntu) / 1000);
    let dist: Int = if target_distance_m < 0 { 0 } else { target_distance_m };
    let two_d: Int = 2 * dist;
    let cd: Int = c_total * two_d;
    let cd2: Int = cd * cd;
    let term2: Int = (500 * cd2) / 1000000;
    let term3: Int = (167 * cd2 * cd) / 1000000000;
    let denom: Int = 1000 + cd + term2 + term3;
    let safe_den: Int = if denom < 1 { 1 } else { denom };
    let t_milli: Int = 1000000 / safe_den;
    let safe_c: Int = if c_total < 10 { 10 } else { c_total };
    let r_max_mm: Int = 3912000 / safe_c;
    let cden: Int = 1000 + ((400 * ntu * dist) / 1000);
    let safe_cden: Int = if cden < 1 { 1 } else { cden };
    let contrast: Int = (t_milli * 1000) / safe_cden;
    let contrast_pos: Int = if contrast < 0 { 0 } else { contrast };
    return OpticalTransmissionOutput {
        total_attenuation_milli: c_total,
        transmission_milli: t_milli,
        max_visible_range_mm: r_max_mm,
        estimated_contrast_milli: contrast_pos
    };
}
