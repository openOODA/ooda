// # Sub-Bottom Profiler (SBP) FM Chirp Acoustic Sediment Penetration
//
// Logline: Simulates acoustic chirp pulse reflection, impedance mismatch, and sub-seafloor sediment layer thickness profiling.
//
// Setup: Low-frequency marine acoustic sub-bottom profiler processing subsea sediment strata and acoustic reflection coefficients.
//
// Beats:
//   1. Define Chirp profiler parameters (start freq f1, stop freq f2, pulse length T_pulse).
//   2. Compute acoustic impedance Z = rho * c and reflection coefficient R = (Z2 - Z1)/(Z2 + Z1).
//   3. Model frequency-dependent sediment attenuation alpha_sed * f * depth.
//   4. Calculate sediment stratum layer thickness delta_z = c_sed * delta_t / 2.

import "./auv_hydrodynamics_constants.oo";

pub type SbpChirpConfig = struct {
    start_freq_khz: Float, // e.g. 2 kHz
    stop_freq_khz: Float,  // e.g. 10 kHz
    pulse_length_ms: Float,
    source_level_db: Float,
    sediment_sound_speed_m_s: Float, // ~1600 m/s in sand/silt
    sediment_attenuation_db_m_khz: Float,
};

pub type SedimentLayerReturn = struct {
    layer_index: Int,
    time_delay_ms: Float,
    reflection_amplitude: Float,
    layer_thickness_m: Float,
    sediment_density_kg_m3: Float,
};

pub fn sbp_chirp_config_default() -> SbpChirpConfig {
    return SbpChirpConfig {
        start_freq_khz: 2.0,
        stop_freq_khz: 12.0,
        pulse_length_ms: 20.0,
        source_level_db: 205.0,
        sediment_sound_speed_m_s: 1650.0,
        sediment_attenuation_db_m_khz: 0.5,
    };
}

pub fn compute_acoustic_impedance(density_kg_m3: Float, sound_speed_m_s: Float) -> Float {
    return density_kg_m3 * sound_speed_m_s;
}

pub fn compute_reflection_coefficient(z1_impedance: Float, z2_impedance: Float) -> Float {
    let sum_z: Float = z1_impedance + z2_impedance;
    if sum_z <= 0.0001 { return 0.0; }
    return (z2_impedance - z1_impedance) / sum_z;
}

pub fn sbp_solve_layer_thickness(
    cfg: &SbpChirpConfig,
    dt_two_way_s: Float
) -> Float {
    let c_sed: Float = (cfg).sediment_sound_speed_m_s;
    return (c_sed * dt_two_way_s) * 0.5;
}

pub fn sbp_estimate_sediment_stratum(
    cfg: &SbpChirpConfig,
    water_density: Float,
    water_c: Float,
    sed_density: Float,
    delta_t_ms: Float
) -> SedimentLayerReturn {
    let z_water: Float = compute_acoustic_impedance(water_density, water_c);
    let z_sed: Float = compute_acoustic_impedance(sed_density, (cfg).sediment_sound_speed_m_s);

    let r_coeff: Float = compute_reflection_coefficient(z_water, z_sed);
    let dt_s: Float = delta_t_ms / 1000.0;
    let thickness: Float = sbp_solve_layer_thickness(cfg, dt_s);

    return SedimentLayerReturn {
        layer_index: 1,
        time_delay_ms: delta_t_ms,
        reflection_amplitude: math_abs(r_coeff),
        layer_thickness_m: thickness,
        sediment_density_kg_m3: sed_density,
    };
}
