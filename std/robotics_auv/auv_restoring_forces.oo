// # Hydrostatic Restoring Forces & Metacentric Stability
//
// Logline: Calculates 6-DOF gravitational weight and Archimedean buoyancy restoring forces, restoring moments, and metacentric stability.
//
// Setup: Fossen hydrostatic restoring vector g(eta) based on center of gravity (CG) and center of buoyancy (CB) spatial offsets.
//
// Beats:
//   1. Define vehicle weight W = m * g and submerged buoyancy B = rho * V * g.
//   2. Define center of gravity r_g and center of buoyancy r_b relative to origin.
//   3. Compute 6-DOF body-fixed restoring force and moment vector g(eta).
//   4. Calculate metacentric righting moment arm and passive pitch/roll static stability.

import "./auv_hydrodynamics_constants.oo";
import "./fossen_6dof_hydrodynamics.oo";

pub type AuvHydrostaticParams = struct {
    mass_kg: Float,
    volume_m3: Float,
    water_density: Float,
    cg_x: Float,
    cg_y: Float,
    cg_z: Float,
    cb_x: Float,
    cb_y: Float,
    cb_z: Float,
};

pub fn auv_hydrostatic_params_default() -> AuvHydrostaticParams {
    return AuvHydrostaticParams {
        mass_kg: 30.5,
        volume_m3: 0.0300, // Slightly negatively buoyant (~0.25 kg net weight)
        water_density: 1025.0,
        cg_x: 0.0,
        cg_y: 0.0,
        cg_z: 0.015, // CG below centerline (stable)
        cb_x: 0.0,
        cb_y: 0.0,
        cb_z: 0.0,   // CB at centerline
    };
}

pub fn compute_restoring_wrench(
    params: &AuvHydrostaticParams,
    phi: Float,
    theta: Float
) -> Vector6 {
    let g_acc: Float = const_g();
    let w_weight: Float = (params).mass_kg * g_acc;
    let b_buoy: Float = (params).water_density * (params).volume_m3 * g_acc;

    let sphi: Float = sin(phi);
    let cphi: Float = cos(phi);
    let sth: Float = sin(theta);
    let cth: Float = cos(theta);

    let xg: Float = (params).cg_x;
    let yg: Float = (params).cg_y;
    let zg: Float = (params).cg_z;

    let xb: Float = (params).cb_x;
    let yb: Float = (params).cb_y;
    let zb: Float = (params).cb_z;

    // Surge restoring force (X)
    let g_x: Float = (w_weight - b_buoy) * sth;

    // Sway restoring force (Y)
    let g_y: Float = 0.0 - ((w_weight - b_buoy) * cth * sphi);

    // Heave restoring force (Z)
    let g_z: Float = 0.0 - ((w_weight - b_buoy) * cth * cphi);

    // Roll restoring moment (K)
    let g_k: Float = 0.0 - (
        ((yg * w_weight - yb * b_buoy) * cth * cphi) +
        ((zg * w_weight - zb * b_buoy) * cth * sphi)
    );

    // Pitch restoring moment (M)
    let g_m: Float = 0.0 - (
        ((zg * w_weight - zb * b_buoy) * sth) +
        ((xg * w_weight - xb * b_buoy) * cth * cphi)
    );

    // Yaw restoring moment (N)
    let g_n: Float = 0.0 - (
        ((xg * w_weight - xb * b_buoy) * cth * sphi) +
        ((yg * w_weight - yb * b_buoy) * sth)
    );

    return vec6_new(g_x, g_y, g_z, g_k, g_m, g_n);
}

pub fn metacentric_height_bg_z(params: &AuvHydrostaticParams) -> Float {
    // BG_z = z_g - z_b: positive means CG is below CB (inherently stable)
    return (params).cg_z - (params).cb_z;
}

pub fn righting_moment_roll(params: &AuvHydrostaticParams, phi: Float) -> Float {
    let w: Float = (params).mass_kg * const_g();
    let bg_z: Float = metacentric_height_bg_z(params);
    return 0.0 - (w * bg_z * sin(phi));
}
