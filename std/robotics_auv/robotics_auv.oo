pub type AuvSystem = struct {
    capabilities: AuvCapabilities,
    hydrostatics: AuvHydrostaticParams,
    added_mass: AddedMass6Dof,
    damping: DampingCoefficients6Dof,
    battery: BatteryPackConfig,
    is_armed: Bool,
};

pub fn auv_system_new() -> AuvSystem {
    return AuvSystem {
        capabilities: auv_capabilities_default(),
        hydrostatics: auv_hydrostatic_params_default(),
        added_mass: added_mass_default_remus100(),
        damping: damping_coefficients_default_remus100(),
        battery: battery_config_default_auv(),
        is_armed: false,
    };
}

pub fn auv_system_arm(sys: &AuvSystem) -> AuvSystem {
    return AuvSystem {
        capabilities: (sys).capabilities,
        hydrostatics: (sys).hydrostatics,
        added_mass: (sys).added_mass,
        damping: (sys).damping,
        battery: (sys).battery,
        is_armed: true,
    };
}

pub fn auv_system_disarm(sys: &AuvSystem) -> AuvSystem {
    return AuvSystem {
        capabilities: (sys).capabilities,
        hydrostatics: (sys).hydrostatics,
        added_mass: (sys).added_mass,
        damping: (sys).damping,
        battery: (sys).battery,
        is_armed: false,
    };
}
