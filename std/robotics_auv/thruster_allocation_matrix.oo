// # 8-Thruster Vectored Allocation Matrix & Control Distributor
//
// Logline: Maps desired 6-DOF force/torque control commands into 8-thruster individual motor thrust allocations with saturation clipping.
//
// Setup: Geometric pseudo-inverse thruster allocation matrix for omnidirectional and vectored underwater vehicles (e.g. BlueROV2 Heavy).
//
// Beats:
//   1. Define 8-thruster geometric positions and orientation angles relative to body center.
//   2. Construct 6x8 thruster configuration matrix T_alloc.
//   3. Compute pseudo-inverse unconstrained thrust distribution u = T^+ * tau.
//   4. Apply saturation limits and thrust normalization scaling.

import "./auv_hydrodynamics_constants.oo";
import "./fossen_6dof_hydrodynamics.oo";

pub type ThrusterAllocation8 = struct {
    t1: Float,
    t2: Float,
    t3: Float,
    t4: Float,
    t5: Float,
    t6: Float,
    t7: Float,
    t8: Float,
};

pub fn thruster_allocation_zero() -> ThrusterAllocation8 {
    return ThrusterAllocation8 {
        t1: 0.0, t2: 0.0, t3: 0.0, t4: 0.0,
        t5: 0.0, t6: 0.0, t7: 0.0, t8: 0.0,
    };
}

pub fn allocate_vectored_8thruster(
    tau_cmd: &Vector6,
    max_thrust_n: Float
) -> ThrusterAllocation8 {
    // 4 Horizontal vectored thrusters (t1..t4) at 45 deg angles
    // 4 Vertical thrusters (t5..t8) at corners for heave, roll, pitch
    let f_surge: Float = (tau_cmd).surge;
    let f_sway: Float = (tau_cmd).sway;
    let f_heave: Float = (tau_cmd).heave;
    let t_roll: Float = (tau_cmd).roll;
    let t_pitch: Float = (tau_cmd).pitch;
    let t_yaw: Float = (tau_cmd).yaw;

    let c45: Float = 0.70710678; // cos(45 deg)
    let lx_h: Float = 0.15; // horizontal thruster arm
    let ly_h: Float = 0.15;
    let lx_v: Float = 0.12; // vertical thruster arm
    let ly_v: Float = 0.10;

    // Horizontal allocation
    let t1_raw: Float = (0.5 * f_surge / c45) + (0.5 * f_sway / c45) + (0.25 * t_yaw / lx_h);
    let t2_raw: Float = (0.5 * f_surge / c45) - (0.5 * f_sway / c45) - (0.25 * t_yaw / lx_h);
    let t3_raw: Float = (0.0 - (0.5 * f_surge / c45)) + (0.5 * f_sway / c45) - (0.25 * t_yaw / lx_h);
    let t4_raw: Float = (0.0 - (0.5 * f_surge / c45)) - (0.5 * f_sway / c45) + (0.25 * t_yaw / lx_h);

    // Vertical allocation
    let t5_raw: Float = (0.25 * f_heave) + (0.25 * t_roll / ly_v) - (0.25 * t_pitch / lx_v);
    let t6_raw: Float = (0.25 * f_heave) - (0.25 * t_roll / ly_v) - (0.25 * t_pitch / lx_v);
    let t7_raw: Float = (0.25 * f_heave) + (0.25 * t_roll / ly_v) + (0.25 * t_pitch / lx_v);
    let t8_raw: Float = (0.25 * f_heave) - (0.25 * t_roll / ly_v) + (0.25 * t_pitch / lx_v);

    // Saturation clipping
    return ThrusterAllocation8 {
        t1: math_clamp(t1_raw, 0.0 - max_thrust_n, max_thrust_n),
        t2: math_clamp(t2_raw, 0.0 - max_thrust_n, max_thrust_n),
        t3: math_clamp(t3_raw, 0.0 - max_thrust_n, max_thrust_n),
        t4: math_clamp(t4_raw, 0.0 - max_thrust_n, max_thrust_n),
        t5: math_clamp(t5_raw, 0.0 - max_thrust_n, max_thrust_n),
        t6: math_clamp(t6_raw, 0.0 - max_thrust_n, max_thrust_n),
        t7: math_clamp(t7_raw, 0.0 - max_thrust_n, max_thrust_n),
        t8: math_clamp(t8_raw, 0.0 - max_thrust_n, max_thrust_n),
    };
}
