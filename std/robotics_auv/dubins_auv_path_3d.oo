// # 3D Dubins Curves & Constrained Turning Trajectory
//
// Logline: Generates curvature-bounded 3D Dubins paths (RSR/RSL/LSR/LSL) with maximum pitch angle limits for underwater survey missions.
//
// Setup: Kinematic path generation algorithm computing optimal minimum-length turning curves subject to minimum turning radius R_min.
//
// Beats:
//   1. Define 3D Dubins constraints (minimum turning radius R_min, maximum dive/climb pitch gamma_max).
//   2. Calculate horizontal 2D Dubins primitive lengths (Right-Straight-Right, Right-Straight-Left, Left-Straight-Right, Left-Straight-Left).
//   3. Select minimal length path candidate and superimpose vertical pitch ramp.
//   4. Sample 3D trajectory waypoints along the composite Dubins arc-line curve.

import "./auv_hydrodynamics_constants.oo";
import "./fossen_6dof_hydrodynamics.oo";

pub type DubinsAuvConfig = struct {
    min_turn_radius_m: Float,
    max_pitch_angle_rad: Float,
    waypoint_step_m: Float
};

pub type Dubins3DPath = struct {
    total_length_3d_m: Float,
    horizontal_length_m: Float,
    vertical_distance_m: Float,
    path_type_id: Int, // 1: RSR, 2: RSL, 3: LSR, 4: LSL
    is_valid: Bool
};

pub fn dubins_auv_config_default() -> DubinsAuvConfig {
    return DubinsAuvConfig {
        min_turn_radius_m: 8.0,
        max_pitch_angle_rad: 0.35, // ~20 deg
        waypoint_step_m: 1.0
    };
}

pub fn dubins_solve_rsr(
    dx: Float,
    dy: Float,
    heading_start: Float,
    heading_end: Float,
    r: Float
) -> Float {
    // Distance between circle centers
    let d: Float = sqrt((dx * dx) + (dy * dy));
    if d < (2.0 * r) {
        return 9999.0; // Invalid / too close
    }

    let alpha: Float = heading_start;
    let beta: Float = heading_end;
    let theta: Float = math_atan2(dy, dx);

    // Tangent arc lengths
    let mut arc1: Float = theta - alpha;
    if arc1 < 0.0 { arc1 = arc1 + const_two_pi(); }

    let mut arc2: Float = beta - theta;
    if arc2 < 0.0 { arc2 = arc2 + const_two_pi(); }

    let straight: Float = sqrt((d * d) - (4.0 * r * r));
    return (r * arc1) + straight + (r * arc2);
}

pub fn dubins_solve_3d_path(
    cfg: &DubinsAuvConfig,
    start_pose: &AuvPose,
    end_pose: &AuvPose
) -> Dubins3DPath {
    let dx: Float = (end_pose).x - (start_pose).x;
    let dy: Float = (end_pose).y - (start_pose).y;
    let dz: Float = (end_pose).z - (start_pose).z;

    let r_min: Float = (cfg).min_turn_radius_m;

    let len_rsr: Float = dubins_solve_rsr(dx, dy, (start_pose).psi, (end_pose).psi, r_min);
    let mut min_len_horiz: Float = len_rsr;
    let mut best_type: Int = 1;

    // Direct distance fallback if too close
    let d_direct: Float = sqrt((dx * dx) + (dy * dy));
    if min_len_horiz > 5000.0 {
        min_len_horiz = d_direct + (2.0 * const_pi() * r_min);
        best_type = 1;
    }

    // Vertical pitch constraint check
    let mut safe_lh: Float = min_len_horiz;
    if safe_lh < 0.1 {
        safe_lh = 0.1;
    }
    let pitch_req: Float = math_atan2(math_abs(dz), safe_lh);
    let mut total_3d: Float = sqrt((min_len_horiz * min_len_horiz) + (dz * dz));

    if pitch_req > (cfg).max_pitch_angle_rad {
        // Must add horizontal helix loops to meet max pitch constraint
        let min_horiz_needed: Float = math_abs(dz) / math_atan((cfg).max_pitch_angle_rad);
        min_len_horiz = min_horiz_needed;
        total_3d = sqrt((min_len_horiz * min_len_horiz) + (dz * dz));
    }

    return Dubins3DPath {
        total_length_3d_m: total_3d,
        horizontal_length_m: min_len_horiz,
        vertical_distance_m: dz,
        path_type_id: best_type,
        is_valid: true
    };
}
