// # Hydrodynamic Added Mass & Damping Matrices
//
// Logline: Lamb spheroid added mass and linear+quadratic D(nu)nu. Int milli destub.
//
// Setup: Flattened 6-DOF diagonals; wrench in mN / mN.mm.
//
// Beats:
//   1. REMUS-100 table coefficients.
//   2. Prolate volume and k1=0.10, k2=0.85, k'=0.65.
//   3. tau = Xu u + Xuu |u| u (milli).
//   4. Return 6-DOF damping wrench.

type AddedMass6Dof = struct {
    x_udot_g: Int,
    y_vdot_g: Int,
    z_wdot_g: Int,
    k_pdot_milli: Int,
    m_qdot_milli: Int,
    n_rdot_milli: Int
};

type DampingCoefficients6Dof = struct {
    x_u_milli: Int,
    y_v_milli: Int,
    z_w_milli: Int,
    k_p_milli: Int,
    m_q_milli: Int,
    n_r_milli: Int,
    x_uu_milli: Int,
    y_vv_milli: Int,
    z_ww_milli: Int,
    k_pp_milli: Int,
    m_qq_milli: Int,
    n_rr_milli: Int
};

type DampingWrench = struct {
    tau_x_mn: Int,
    tau_y_mn: Int,
    tau_z_mn: Int,
    tau_k_mnm: Int,
    tau_m_mnm: Int,
    tau_n_mnm: Int
};

pub fn adam_abs(v: Int) -> Int {
    if v < 0 {
        return 0 - v;
    }
    return v;
}

pub fn added_mass_default_remus100() -> AddedMass6Dof {
    return AddedMass6Dof {
        x_udot_g: 0 - 930,
        y_vdot_g: 0 - 35500,
        z_wdot_g: 0 - 35500,
        k_pdot_milli: 0 - 70,
        m_qdot_milli: 0 - 4880,
        n_rdot_milli: 0 - 4880
    };
}

pub fn damping_coefficients_default_remus100() -> DampingCoefficients6Dof {
    return DampingCoefficients6Dof {
        x_u_milli: 0 - 13500,
        y_v_milli: 0 - 66500,
        z_w_milli: 0 - 66500,
        k_p_milli: 0 - 540,
        m_q_milli: 0 - 8400,
        n_r_milli: 0 - 8400,
        x_uu_milli: 0 - 18200,
        y_vv_milli: 0 - 131000,
        z_ww_milli: 0 - 131000,
        k_pp_milli: 0 - 1100,
        m_qq_milli: 0 - 18800,
        n_rr_milli: 0 - 18800
    };
}

pub fn added_mass_prolate_spheroid(
    length_mm: Int,
    diameter_mm: Int,
    fluid_density: Int
) -> AddedMass6Dof {
    let a: Int = length_mm / 2;
    let b: Int = diameter_mm / 2;
    let safe_a: Int = if a < 1 { 1 } else { a };
    let safe_b: Int = if b < 1 { 1 } else { b };
    let vol_mm3: Int = (((4 * 3142) * safe_a) * safe_b * safe_b) / 3000;
    let rho: Int = if fluid_density < 1 { 1 } else { fluid_density };
    let m_g: Int = (rho * vol_mm3) / 1000000;
    let x_udot: Int = 0 - ((100 * m_g) / 1000);
    let y_vdot: Int = 0 - ((850 * m_g) / 1000);
    let j_milli: Int = (m_g * ((safe_a * safe_a) + (safe_b * safe_b))) / 5000000;
    let m_qdot: Int = 0 - ((650 * j_milli) / 1000);
    return AddedMass6Dof {
        x_udot_g: x_udot,
        y_vdot_g: y_vdot,
        z_wdot_g: y_vdot,
        k_pdot_milli: 0,
        m_qdot_milli: m_qdot,
        n_rdot_milli: m_qdot
    };
}

pub fn compute_hydrodynamic_damping_wrench(
    damp: DampingCoefficients6Dof,
    u_mm_s: Int,
    v_mm_s: Int,
    w_mm_s: Int,
    p_mrad_s: Int,
    q_mrad_s: Int,
    r_mrad_s: Int
) -> DampingWrench {
    let tau_x: Int = ((damp.x_u_milli * u_mm_s) / 1000) + (((damp.x_uu_milli * adam_abs(u_mm_s)) * u_mm_s) / 1000000);
    let tau_y: Int = ((damp.y_v_milli * v_mm_s) / 1000) + (((damp.y_vv_milli * adam_abs(v_mm_s)) * v_mm_s) / 1000000);
    let tau_z: Int = ((damp.z_w_milli * w_mm_s) / 1000) + (((damp.z_ww_milli * adam_abs(w_mm_s)) * w_mm_s) / 1000000);
    let tau_k: Int = ((damp.k_p_milli * p_mrad_s) / 1000) + (((damp.k_pp_milli * adam_abs(p_mrad_s)) * p_mrad_s) / 1000000);
    let tau_m: Int = ((damp.m_q_milli * q_mrad_s) / 1000) + (((damp.m_qq_milli * adam_abs(q_mrad_s)) * q_mrad_s) / 1000000);
    let tau_n: Int = ((damp.n_r_milli * r_mrad_s) / 1000) + (((damp.n_rr_milli * adam_abs(r_mrad_s)) * r_mrad_s) / 1000000);
    return DampingWrench {
        tau_x_mn: tau_x,
        tau_y_mn: tau_y,
        tau_z_mn: tau_z,
        tau_k_mnm: tau_k,
        tau_m_mnm: tau_m,
        tau_n_mnm: tau_n
    };
}

pub fn damp_tau_x(w: DampingWrench) -> Int {
    return w.tau_x_mn;
}

pub fn damp_tau_y(w: DampingWrench) -> Int {
    return w.tau_y_mn;
}
