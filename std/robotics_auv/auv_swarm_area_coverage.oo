// # Distributed Multi-AUV Boustrophedon Area Coverage & Lawnmower Search
//
// Logline: Partitions 2D/3D seafloor search zones into parallel lawnmower survey lanes with acoustic swath overlap for multi-AUV teams.
//
// Setup: Cooperative area coverage planner allocating boustrophedon sweep lines across multi-agent survey swarms (e.g., MCM missions).
//
// Beats:
//   1. Define survey polygon bounds (length, width, orientation) and acoustic sensor swath width W.
//   2. Calculate inter-lane spacing based on target sensor overlap fraction (e.g., 20% overlap).
//   3. Partition total survey lanes across N swarm member vehicles by agent ID.
//   4. Compute lane start/end 3D waypoints and cumulative area coverage metrics.

import "./auv_hydrodynamics_constants.oo";
import "./fossen_6dof_hydrodynamics.oo";

pub type AreaCoverageConfig = struct {
    survey_length_m: Float,
    survey_width_m: Float,
    sensor_swath_width_m: Float,
    overlap_fraction: Float,
    survey_depth_m: Float,
    total_vehicles: Int,
};

pub type SwarmLaneAssignment = struct {
    vehicle_id: Int,
    lane_index: Int,
    start_point: Vector3,
    end_point: Vector3,
    total_assigned_lanes: Int,
};

pub fn area_coverage_config_default() -> AreaCoverageConfig {
    return AreaCoverageConfig {
        survey_length_m: 500.0,
        survey_width_m: 300.0,
        sensor_swath_width_m: 50.0, // 50m SSS / MBES swath
        overlap_fraction: 0.20,     // 20% overlap
        survey_depth_m: 25.0,
        total_vehicles: 3,
    };
}

pub fn compute_lane_spacing(cfg: &AreaCoverageConfig) -> Float {
    let w: Float = (cfg).sensor_swath_width_m;
    let ov: Float = (cfg).overlap_fraction;
    return w * (1.0 - ov);
}

pub fn get_vehicle_lane_assignment(
    cfg: &AreaCoverageConfig,
    vehicle_id: Int,
    lane_number: Int
) -> SwarmLaneAssignment {
    let lane_spacing: Float = compute_lane_spacing(cfg);

    // Float conversion for indexing
    let mut lane_f: Float = 0.0;
    let mut count: Int = 0;
    while count < lane_number {
        lane_f = lane_f + 1.0;
        count = count + 1;
    }

    // Y-coordinate across survey area
    let y_offset: Float = (lane_f + 0.5) * lane_spacing;

    // Check direction alternation
    let half_idx: Int = lane_number / 2;
    let is_even: Bool = (half_idx * 2) == lane_number;

    let mut x_start: Float = 0.0;
    let mut x_end: Float = (cfg).survey_length_m;
    if !is_even {
        x_start = (cfg).survey_length_m;
        x_end = 0.0;
    }

    let z_depth: Float = (cfg).survey_depth_m;

    return SwarmLaneAssignment {
        vehicle_id: vehicle_id,
        lane_index: lane_number,
        start_point: vec3_new(x_start, y_offset, z_depth),
        end_point: vec3_new(x_end, y_offset, z_depth),
        total_assigned_lanes: 10,
    };
}
