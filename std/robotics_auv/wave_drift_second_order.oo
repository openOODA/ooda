// # Second-Order Mean & Slow-Drift Wave Forces
//
// Logline: Implements Newman approximation for second-order mean wave drift forces and low-frequency slow drift yaw moments.
//
// Setup: Quadratic wave elevation force transfer functions (QTF) modeling environmental drift loads on marine vessels.
//
// Beats:
//   1. Define second-order wave drift coefficient parameters (surge, sway, yaw).
//   2. Compute quadratic wave amplitude force scaling F_drift ~ 0.5 * rho * g * R_d * B * A^2.
//   3. Implement relative wave encounter angle dependence for quartering and beam seas.
//   4. Deliver body-fixed mean drift wrench for station-keeping and trajectory tracking.

import "./auv_hydrodynamics_constants.oo";
import "./fossen_6dof_hydrodynamics.oo";
import "./wave_radiation_diffraction.oo";

pub type WaveDriftCoefficients = struct {
    surge_c_xd: Float,
    sway_c_yd: Float,
    yaw_c_nd: Float,
    characteristic_width_m: Float,
    characteristic_length_m: Float,
};

pub fn wave_drift_coefficients_default() -> WaveDriftCoefficients {
    return WaveDriftCoefficients {
        surge_c_xd: 0.15,
        sway_c_yd: 0.45,
        yaw_c_nd: 0.08,
        characteristic_width_m: 0.25,
        characteristic_length_m: 1.6,
    };
}

pub fn compute_wave_drift_wrench(
    coeff: &WaveDriftCoefficients,
    wave: &OceanWaveState,
    pose: &AuvPose,
    rho: Float
) -> Vector6 {
    let amp: Float = (wave).amplitude_m;
    let b_w: Float = (coeff).characteristic_width_m;
    let l_w: Float = (coeff).characteristic_length_m;
    let g_acc: Float = const_g();

    // Quadratic wave amplitude force base
    let f_base: Float = 0.5 * rho * g_acc * (amp * amp);

    // Relative wave heading beta = wave_dir - vehicle_heading
    let beta: Float = (wave).direction_rad - (pose).psi;
    let cos_b: Float = cos(beta);
    let sin_b: Float = sin(beta);

    // Depth decay for submerged bodies: exp(-2 * k * depth)
    let k: Float = wave_number_deep_water((wave).frequency_rad_s);
    let depth_z: Float = (pose).z;
    let mut atten: Float = 1.0;
    if depth_z > 0.0 {
        let two_kz: Float = 2.0 * k * depth_z;
        atten = 1.0 / (1.0 + two_kz + (0.5 * two_kz * two_kz));
    }

    // Mean drift forces (always pushes in direction of wave propagation)
    let f_surge: Float = f_base * b_w * (coeff).surge_c_xd * cos_b * math_abs(cos_b) * atten;
    let f_sway: Float = f_base * l_w * (coeff).sway_c_yd * sin_b * math_abs(sin_b) * atten;
    let tau_yaw: Float = f_base * (l_w * l_w) * (coeff).yaw_c_nd * sin(2.0 * beta) * atten;

    return vec6_new(f_surge, f_sway, 0.0, 0.0, 0.0, tau_yaw);
}
