// # Rigid Body & Hydrodynamic Added Mass Coriolis-Centripetal Matrices
//
// Logline: Computes 6-DOF skew-symmetric Coriolis and centripetal acceleration wrenches C_RB(nu)*nu and C_A(nu_r)*nu_r.
//
// Setup: Fossen parametrization of rigid body and hydrodynamic added-mass cross-product matrices in body-fixed coordinates.
//
// Beats:
//   1. Define vehicle rigid body mass, center of gravity, and 3x3 inertia moments (I_xx, I_yy, I_zz).
//   2. Compute rigid-body Coriolis-centripetal wrench C_RB(nu) * nu.
//   3. Compute hydrodynamic added mass Coriolis-centripetal wrench C_A(nu_r) * nu_r from M_A coefficients.
//   4. Deliver unified combined Coriolis and centripetal reaction wrench.

import "./auv_hydrodynamics_constants.oo";
import "./fossen_6dof_hydrodynamics.oo";
import "./added_mass_damping_matrix.oo";

pub type AuvInertiaParams = struct {
    mass_kg: Float,
    i_xx: Float,
    i_yy: Float,
    i_zz: Float,
    cg_x: Float,
    cg_y: Float,
    cg_z: Float,
};

pub fn auv_inertia_params_default_remus() -> AuvInertiaParams {
    return AuvInertiaParams {
        mass_kg: 30.5,
        i_xx: 0.177,
        i_yy: 3.45,
        i_zz: 3.45,
        cg_x: 0.0,
        cg_y: 0.0,
        cg_z: 0.015,
    };
}

pub fn compute_coriolis_rigid_body_wrench(
    inertia: &AuvInertiaParams,
    nu: &AuvVelocity
) -> Vector6 {
    let m: Float = (inertia).mass_kg;
    let ix: Float = (inertia).i_xx;
    let iy: Float = (inertia).i_yy;
    let iz: Float = (inertia).i_zz;

    let xg: Float = (inertia).cg_x;
    let yg: Float = (inertia).cg_y;
    let zg: Float = (inertia).cg_z;

    let u: Float = (nu).u;
    let v: Float = (nu).v;
    let w: Float = (nu).w;
    let p: Float = (nu).p;
    let q: Float = (nu).q;
    let r: Float = (nu).r;

    // Linear components
    let f_x: Float = m * ( (0.0 - (v * r)) + (w * q) - (xg * (q * q + r * r)) + (yg * p * q) + (zg * p * r) );
    let f_y: Float = m * ( (0.0 - (w * p)) + (u * r) - (yg * (r * r + p * p)) + (zg * q * r) + (xg * p * q) );
    let f_z: Float = m * ( (0.0 - (u * q)) + (v * p) - (zg * (p * p + q * q)) + (xg * p * r) + (yg * q * r) );

    // Rotational components (simplified for principal axes)
    let tau_k: Float = ((iz - iy) * q * r) + (m * yg * ((0.0 - (u * q)) + (v * p))) - (m * zg * ((0.0 - (w * p)) + (u * r)));
    let tau_m: Float = ((ix - iz) * p * r) + (m * zg * ((0.0 - (v * r)) + (w * q))) - (m * xg * ((0.0 - (u * q)) + (v * p)));
    let tau_n: Float = ((iy - ix) * p * q) + (m * xg * ((0.0 - (w * p)) + (u * r))) - (m * yg * ((0.0 - (v * r)) + (w * q)));

    return vec6_new(f_x, f_y, f_z, tau_k, tau_m, tau_n);
}

pub fn compute_coriolis_added_mass_wrench(
    am: &AddedMass6Dof,
    nu_r: &AuvVelocity
) -> Vector6 {
    let u: Float = (nu_r).u;
    let v: Float = (nu_r).v;
    let w: Float = (nu_r).w;
    let p: Float = (nu_r).p;
    let q: Float = (nu_r).q;
    let r: Float = (nu_r).r;

    let a1: Float = 0.0 - (am).x_udot;
    let a2: Float = 0.0 - (am).y_vdot;
    let a3: Float = 0.0 - (am).z_wdot;
    let a4: Float = 0.0 - (am).k_pdot;
    let a5: Float = 0.0 - (am).m_qdot;
    let a6: Float = 0.0 - (am).n_rdot;

    // sk-symmetric added mass Coriolis formulation (Fossen 2011)
    let f_x: Float = 0.0 - (a2 * v * r) + (a3 * w * q);
    let f_y: Float = (a1 * u * r) - (a3 * w * p);
    let f_z: Float = 0.0 - (a1 * u * q) + (a2 * v * p);

    let tau_k: Float = 0.0 - ((a5 - a6) * q * r) - ((a2 - a3) * v * w);
    let tau_m: Float = 0.0 - ((a6 - a4) * p * r) + ((a1 - a3) * u * w);
    let tau_n: Float = 0.0 - ((a4 - a5) * p * q) - ((a1 - a2) * u * v);

    return vec6_new(f_x, f_y, f_z, tau_k, tau_m, tau_n);
}

pub fn compute_total_coriolis_wrench(
    inertia: &AuvInertiaParams,
    am: &AddedMass6Dof,
    nu: &AuvVelocity,
    nu_r: &AuvVelocity
) -> Vector6 {
    let c_rb: Vector6 = compute_coriolis_rigid_body_wrench(inertia, nu);
    let c_a: Vector6 = compute_coriolis_added_mass_wrench(am, nu_r);
    return vec6_add(c_rb, c_a);
}
