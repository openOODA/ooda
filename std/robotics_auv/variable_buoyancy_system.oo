// # Variable Buoyancy System (VBS) & Volume Displacement
//
// Logline: Piston volume, hull compressibility, Archimedes force. Int milli destub.
//
// Setup: Stroke-limited buoyancy engine; P = rho g z; pump power P Q / eta.
//
// Beats:
//   1. Max delta-V, piston area, stroke rate, compressibility, eta.
//   2. Clamp target; rate-limit volume by area * speed * dt.
//   3. Hull loss = V0 * beta * P_bar; F = rho * V_eff * g.
//   4. Electrical pump power from hydrostatic head and flow.

type VbsParams = struct {
    max_displacement_volume_mm3: Int,
    piston_area_mm2: Int,
    max_piston_speed_mm_s: Int,
    hull_compress_micro_per_bar: Int,
    nominal_volume_mm3: Int,
    pump_efficiency_milli: Int
};

type VbsState = struct {
    displaced_volume_mm3: Int,
    piston_position_mm: Int,
    net_buoyancy_force_mn: Int,
    pump_power_mw: Int
};

pub fn vbs_params_default_glider() -> VbsParams {
    return VbsParams {
        max_displacement_volume_mm3: 500000,
        piston_area_mm2: 5000,
        max_piston_speed_mm_s: 2,
        hull_compress_micro_per_bar: 20,
        nominal_volume_mm3: 52000000,
        pump_efficiency_milli: 650
    };
}

pub fn vbs_state_neutral() -> VbsState {
    return VbsState {
        displaced_volume_mm3: 0,
        piston_position_mm: 0,
        net_buoyancy_force_mn: 0,
        pump_power_mw: 0
    };
}

pub fn vbs_clamp_int(v: Int, lo: Int, hi: Int) -> Int {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    return v;
}

pub fn vbs_abs_int(v: Int) -> Int {
    if v < 0 {
        return 0 - v;
    }
    return v;
}

pub fn vbs_step(
    params: VbsParams,
    state: VbsState,
    target_delta_vol_mm3: Int,
    depth_mm: Int,
    water_density: Int,
    dt_ms: Int
) -> VbsState {
    let max_v: Int = params.max_displacement_volume_mm3;
    let clamped_target: Int = vbs_clamp_int(target_delta_vol_mm3, 0 - max_v, max_v);
    let area: Int = if params.piston_area_mm2 < 1 { 1 } else { params.piston_area_mm2 };
    let max_vol_rate: Int = area * params.max_piston_speed_mm_s;
    let dt_use: Int = if dt_ms < 1 { 1 } else { dt_ms };
    let max_vol_step: Int = (max_vol_rate * dt_use) / 1000;
    let vol_diff: Int = clamped_target - state.displaced_volume_mm3;
    let vol_step: Int = vbs_clamp_int(vol_diff, 0 - max_vol_step, max_vol_step);
    let new_vol: Int = state.displaced_volume_mm3 + vol_step;
    let new_pos: Int = new_vol / area;
    let depth_use: Int = if depth_mm < 0 { 0 } else { depth_mm };
    let rho: Int = if water_density < 1 { 1 } else { water_density };
    let p_milli_bar: Int = (rho * 9807 * depth_use) / 100000000;
    let hull_vol_loss: Int = ((params.nominal_volume_mm3 / 1000) * params.hull_compress_micro_per_bar * p_milli_bar) / 1000000;
    let effective_delta_vol: Int = new_vol - hull_vol_loss;
    let net_buoyancy_mn: Int = (rho * effective_delta_vol * 9807) / 1000000000;
    let eta: Int = if params.pump_efficiency_milli < 1 { 1 } else { params.pump_efficiency_milli };
    let flow_abs: Int = vbs_abs_int(vol_step);
    let pump_power: Int = (p_milli_bar * flow_abs * 100) / (dt_use * eta);
    return VbsState {
        displaced_volume_mm3: new_vol,
        piston_position_mm: new_pos,
        net_buoyancy_force_mn: net_buoyancy_mn,
        pump_power_mw: pump_power
    };
}
