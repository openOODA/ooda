// # Biomimetic Undulatory Fin & Robotic Fish Propulsion
//
// Logline: Calculates Lighthill elongated-body reactive thrust, caudal fin oscillations, and optimal Strouhal number propulsion.
//
// Setup: Bio-inspired fish locomotion simulator modeling traveling wave lateral kinematics and added-mass momentum shed thrust.
//
// Beats:
//   1. Define biomimetic fish geometric parameters (body length L, caudal fin span, tail amplitude envelope).
//   2. Compute undulating traveling wave kinematics y(x, t) = (c1*x + c2*x^2) * sin(k*x - omega*t).
//   3. Calculate Lighthill reactive hydrodynamic added-mass thrust and cyclic lateral sway forces.
//   4. Evaluate Strouhal number St = (2 * f * A) / U for optimal propulsive efficiency.

import "./auv_hydrodynamics_constants.oo";
import "./fossen_6dof_hydrodynamics.oo";

pub type BiomimeticFinParams = struct {
    body_length_m: Float,
    caudal_fin_height_m: Float,
    flapping_freq_hz: Float,
    tail_max_amplitude_m: Float,
    wave_number_k: Float,
    added_mass_cross_coeff: Float
};

pub type BiomimeticThrustOutput = struct {
    thrust_surge_n: Float,
    cyclic_sway_force_n: Float,
    tail_lateral_pos_m: Float,
    tail_lateral_vel_m_s: Float,
    strouhal_number: Float
};

pub fn biomimetic_fin_params_default_tuna() -> BiomimeticFinParams {
    return BiomimeticFinParams {
        body_length_m: 0.8,
        caudal_fin_height_m: 0.18,
        flapping_freq_hz: 2.5,        // 2.5 Hz tail beat
        tail_max_amplitude_m: 0.08,  // 8 cm tail sweep
        wave_number_k: 4.5,          // Rad/m
        added_mass_cross_coeff: 1.2
    };
}

pub fn compute_biomimetic_thrust(
    params: &BiomimeticFinParams,
    surge_speed: Float,
    water_density: Float,
    time_s: Float
) -> BiomimeticThrustOutput {
    let l: Float = (params).body_length_m;
    let f: Float = (params).flapping_freq_hz;
    let a_tail: Float = (params).tail_max_amplitude_m;
    let omega: Float = const_two_pi() * f;
    let k_w: Float = (params).wave_number_k;

    // Traveling wave kinematics at trailing edge (x = L)
    let phase: Float = (k_w * l) - (omega * time_s);
    let sin_p: Float = sin(phase);
    let cos_p: Float = cos(phase);

    let y_tail: Float = a_tail * sin_p;
    let w_tail_vel: Float = (0.0 - a_tail) * omega * cos_p;
    let tail_slope: Float = a_tail * k_w * cos_p;

    // Lighthill reactive force: T = m_added * w_tail * (w_tail - U * slope)
    let fin_area: Float = (params).caudal_fin_height_m * (params).caudal_fin_height_m * 0.5;
    let m_added_tail: Float = (params).added_mass_cross_coeff * (const_pi() / 4.0) * water_density * (params).caudal_fin_height_m * (params).caudal_fin_height_m;

    let w_rel: Float = w_tail_vel - (surge_speed * tail_slope);
    let f_lateral: Float = 0.0 - (m_added_tail * w_rel * omega);

    // Mean forward thrust (reactive momentum transfer)
    let thrust: Float = math_max(0.0, m_added_tail * (w_tail_vel * w_tail_vel - (0.5 * (w_tail_vel - surge_speed * tail_slope) * (w_tail_vel - surge_speed * tail_slope))));

    // Strouhal number: St = (2 * f * A) / U (optimal ~ 0.25 to 0.35)
    let mut safe_u: Float = surge_speed;
    if safe_u < 0.1 {
        safe_u = 0.1;
    }
    let st: Float = (2.0 * f * a_tail) / safe_u;

    return BiomimeticThrustOutput {
        thrust_surge_n: thrust,
        cyclic_sway_force_n: f_lateral,
        tail_lateral_pos_m: y_tail,
        tail_lateral_vel_m_s: w_tail_vel,
        strouhal_number: st
    };
}
