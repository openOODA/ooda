// # Spectral Flow Invariants & Thouless Topological Charge Pumps
//
// Logline: Models adiabatic magnetic flux threading Phi -> Phi + 2*pi, instantaneous eigenstate spectral flow, and quantized charge pumping.
//
// Setup: Dynamical characterization of topological invariants via adiabatic spectral flow and bulk-boundary Thouless pumps.
//
// Beats:
//   1. Configure 1D/2D cylinder geometry with adiabatic flux insertion Phi(t) in [0, 2*pi].
//   2. Track instantaneous energy eigenvalues crossing the Fermi level during flux threading.
//   3. Compute quantized pumped charge Q = C * e and verify Chern number correspondence.

pub type SpectralFlowLevel = struct {
    level_id: Int,
    initial_energy: Float,
    final_energy: Float,
    crosses_fermi_level_up: Int,
    crosses_fermi_level_down: Int
};

pub fn spectral_flow_level_new(id: Int, e_i: Float, e_f: Float, fermi_energy: Float) -> SpectralFlowLevel {
    let mut up: Int = 0;
    let mut down: Int = 0;
    if e_i < fermi_energy && e_f >= fermi_energy {
        up = 1;
    } else if e_i >= fermi_energy && e_f < fermi_energy {
        down = 1;
    }
    return SpectralFlowLevel {
        level_id: id,
        initial_energy: e_i,
        final_energy: e_f,
        crosses_fermi_level_up: up,
        crosses_fermi_level_down: down
    };
}

pub type SpectralFlowPump = struct {
    fermi_energy: Float,
    pump_period_seconds: Float,
    levels: List[SpectralFlowLevel]
};

pub fn spectral_flow_pump_new(e_f: Float, period: Float) -> SpectralFlowPump {
    let empty_levels: List[SpectralFlowLevel] = list_new();
    return SpectralFlowPump {
        fermi_energy: e_f,
        pump_period_seconds: period,
        levels: empty_levels
    };
}

pub fn spectral_flow_add_level(pump: &mut SpectralFlowPump, level: SpectralFlowLevel) {
    list_push(pump.levels, level);
}

pub fn spectral_flow_net_pumped_charge(pump: &SpectralFlowPump) -> Int {
    let n: Int = list_len(pump.levels);
    let mut net_charge: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let lvl: SpectralFlowLevel = list_get(pump.levels, i);
        let up: Int = lvl.crosses_fermi_level_up;
        let down: Int = lvl.crosses_fermi_level_down;
        if up != 0 {
            net_charge = net_charge + 1;
        }
        if down != 0 {
            net_charge = net_charge - 1;
        }
        i = i + 1;
    }
    return net_charge; // Net pumped charge in units of electron charge e (Chern number C)
}

pub fn thouless_pump_average_current_amps(net_charge_c: Int, period_seconds: Float) -> Float {
    // Current I = Q / T = C * e / T
    let e_coulomb: Float = 0.000000000000000000160217663; // 1.602e-19 C
    let c_f: Float = (net_charge_c as Float);
    if period_seconds <= 0.0 {
        return 0.0;
    }
    return (c_f * e_coulomb) / period_seconds;
}
