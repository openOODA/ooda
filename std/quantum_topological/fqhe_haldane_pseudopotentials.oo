// # Haldane Pseudopotentials & Lowest Landau Level Projections
//
// Logline: Implements Haldane pseudopotential decompositions V_L for two-body interactions and exact zero-energy Laughlin parent Hamiltonians.
//
// Setup: Angular momentum decomposition of electron-electron interactions projected onto the Lowest Landau Level (LLL).
//
// Beats:
//   1. Define Haldane relative angular momentum pseudopotentials V_L (L=1, 3, 5, ...).
//   2. Construct parent Hamiltonians for exact Laughlin wavefunctions at nu = 1/m.
//   3. Compute Coulomb pseudopotential coefficients V_L / (e^2 / epsilon ell_B).

pub type PseudopotentialSet = struct {
    max_relative_angular_momentum: Int,
    coefficients: List[Float] // V_0, V_1, V_2, ...
};

pub fn pseudopotential_set_new(max_l: Int) -> PseudopotentialSet {
    let empty_coeffs: List[Float] = list_new();
    return PseudopotentialSet {
        max_relative_angular_momentum: max_l,
        coefficients: empty_coeffs
    };
}

pub fn pseudopotential_add(set: &mut PseudopotentialSet, v_val: Float) {
    list_push(set.coefficients, v_val);
}

pub fn laughlin_parent_pseudopotentials(m: Int) -> PseudopotentialSet {
    // For Laughlin nu = 1/m, parent Hamiltonian has V_L > 0 for odd L < m, and V_L = 0 for L >= m
    let mut set: PseudopotentialSet = pseudopotential_set_new(m);
    let mut l: Int = 0;
    while l <= m {
        if l % 2 == 1 && l < m {
            pseudopotential_add(&mut set, 1.0); // Repulsive barrier
        } else {
            pseudopotential_add(&mut set, 0.0); // Exact zero
        }
        l = l + 1;
    }
    return set;
}

pub fn coulomb_pseudopotential_approx(relative_l: Int) -> Float {
    // Typical values for pure Coulomb interaction in LLL in units of e^2 / (epsilon * ell_B):
    // V_1 ~ 0.526, V_3 ~ 0.380, V_5 ~ 0.318, V_7 ~ 0.280
    if relative_l == 1 { return 0.5261; }
    if relative_l == 3 { return 0.3802; }
    if relative_l == 5 { return 0.3180; }
    if relative_l == 7 { return 0.2798; }
    return 0.1000;
}
