// # Toric Code Star & Plaquette Stabilizers
//
// Logline: Implements Kitaev's 2D Toric Code lattice geometry, star vertex operators A_s, plaquette operators B_p, and ground space degeneracy.
//
// Setup: Exact quantum stabilizer lattice model on periodic 2-torus realizing Z_2 topological order and abelian anyons.
//
// Beats:
//   1. Define 2D square torus lattice grid and edge-based physical qubits.
//   2. Compute star vertex X-stabilizers A_s and plaquette Z-stabilizers B_p.
//   3. Evaluate syndrome defect configurations and 4-fold torus ground state degeneracy.

pub type ToricLattice = struct {
    lx: Int,
    ly: Int,
    num_qubits: Int, // 2 * lx * ly
    num_stars: Int,  // lx * ly
    num_plaquettes: Int, // lx * ly
};

pub fn toric_lattice_new(lx: Int, ly: Int) -> ToricLattice {
    let nq: Int = 2 * lx * ly;
    let ns: Int = lx * ly;
    let np: Int = lx * ly;
    return ToricLattice {
        lx: lx,
        ly: ly,
        num_qubits: nq,
        num_stars: ns,
        num_plaquettes: np,
    };
}

pub type StarOperator = struct {
    vertex_x: Int,
    vertex_y: Int,
    edge_qubits: List[Int], // 4 incident edges: [north, east, south, west]
};

pub fn star_operator_new(vx: Int, vy: Int, edges: List[Int]) -> StarOperator {
    return StarOperator {
        vertex_x: vx,
        vertex_y: vy,
        edge_qubits: edges,
    };
}

pub type PlaquetteOperator = struct {
    face_x: Int,
    face_y: Int,
    boundary_qubits: List[Int], // 4 boundary edges: [top, right, bottom, left]
};

pub fn plaquette_operator_new(fx: Int, fy: Int, edges: List[Int]) -> PlaquetteOperator {
    return PlaquetteOperator {
        face_x: fx,
        face_y: fy,
        boundary_qubits: edges,
    };
}

pub fn toric_star_syndrome(star: &StarOperator, pauli_z_errors: List[Int]) -> Int {
    // Star syndrome A_s is violated (-1) if odd number of Z errors on incident edges
    let mut flip_count: Int = 0;
    let mut i: Int = 0;
    while i < 4 {
        let q_idx: Int = list_get(star.edge_qubits, i);
        let err: Int = list_get(pauli_z_errors, q_idx);
        if err != 0 {
            flip_count = flip_count + 1;
        }
        i = i + 1;
    }
    if flip_count % 2 == 1 {
        return 0 - 1; // -1 defect (e-anyon)
    }
    return 1; // +1 stabilizer satisfied
}

pub fn toric_plaquette_syndrome(plaq: &PlaquetteOperator, pauli_x_errors: List[Int]) -> Int {
    // Plaquette syndrome B_p is violated (-1) if odd number of X errors on boundary edges
    let mut flip_count: Int = 0;
    let mut i: Int = 0;
    while i < 4 {
        let q_idx: Int = list_get(plaq.boundary_qubits, i);
        let err: Int = list_get(pauli_x_errors, q_idx);
        if err != 0 {
            flip_count = flip_count + 1;
        }
        i = i + 1;
    }
    if flip_count % 2 == 1 {
        return 0 - 1; // -1 defect (m-anyon)
    }
    return 1; // +1 stabilizer satisfied
}

pub fn toric_ground_state_degeneracy(genus: Int) -> Int {
    // For closed 2D Riemann surface of genus g, D = 4^g = 2^(2g)
    let mut deg: Int = 1;
    let mut i: Int = 0;
    while i < genus {
        deg = deg * 4;
        i = i + 1;
    }
    return deg;
}
