// # FQHE Quasiparticle Fractional Charge & Braiding Berry Phase
//
// Logline: Models fractional charge e/m, quasihole wavefunctions, and adiabatic braiding Berry phases in Fractional Quantum Hall states.
//
// Setup: Abelian fractional statistics in Laughlin fractional quantum Hall liquids verified by adiabatic loop transport.
//
// Beats:
//   1. Define quasihole/quasiparticle topological excitations with fractional charge e* = e/m.
//   2. Compute fractional statistical exchange angle theta = pi/m.
//   3. Evaluate Berry phase accumulated along closed circular braiding trajectories.

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub type QuasiholeExcitation = struct {
    laughlin_m: Int,
    fractional_charge_e_star: Float, // 1.0 / m
    statistical_angle_radians: Float, // pi / m
    position_x: Float,
    position_y: Float
};

pub fn quasihole_new(m: Int, x: Float, y: Float) -> QuasiholeExcitation {
    let pi_val: Float = 3.141592653589793;
    let m_f: Float = int_to_float(m);
    let q_star: Float = 1.0 / m_f;
    let theta: Float = pi_val / m_f;
    return QuasiholeExcitation {
        laughlin_m: m,
        fractional_charge_e_star: q_star,
        statistical_angle_radians: theta,
        position_x: x,
        position_y: y
    };
}

pub fn quasihole_exchange_phase(qh1: &QuasiholeExcitation, qh2: &QuasiholeExcitation) -> Float {
    let th: Float = qh1.statistical_angle_radians;
    return th; // Half braid (single exchange) phase = pi / m
}

pub fn quasihole_monodromy_phase(qh1: &QuasiholeExcitation, qh2: &QuasiholeExcitation) -> Float {
    let th: Float = qh1.statistical_angle_radians;
    return 2.0 * th; // Full braid (encircling) phase = 2 * pi / m
}

pub fn fqhe_berry_phase_circular_path(m: Int, path_radius_nm: Float, ell_b_nm: Float) -> Float {
    let pi_val: Float = 3.141592653589793;
    let m_f: Float = int_to_float(m);
    let nu: Float = 1.0 / m_f;
    let area: Float = pi_val * path_radius_nm * path_radius_nm;
    let ell_b_sq: Float = ell_b_nm * ell_b_nm;
    // Aharonov-Bohm phase = 2 * pi * (Area / (2 * pi * ell_B^2)) * nu = nu * Area / ell_B^2
    return nu * (area / ell_b_sq);
}
