// # Topological Spin, Ribbon Twists & Modular Balancing Equations
//
// Logline: Models anyon topological spins, ribbon category twists, chiral central charge phase sums, and ribbon balancing equations.
//
// Setup: Pre-modular and ribbon category consistency conditions connecting topological spin twists with anyon braiding phases.
//
// Beats:
//   1. Represent topological spin phases theta_a = exp(2*pi*i*h_a).
//   2. Compute chiral central charge phase sum and Gauss-Milgram sums.
//   3. Verify ribbon balancing equations theta_a * theta_b * (R_{ab}^c * R_{ba}^c) = theta_c.

pub type TopoSpin = struct {
    species_id: Int,
    conformal_weight: Float, // h_a in cycles (e.g. 0.0, 0.0625, 0.5)
    cos_theta: Float,
    sin_theta: Float,
};

pub fn topo_spin_new(id: Int, h_weight: Float) -> TopoSpin {
    let pi_val: Float = 3.141592653589793;
    let angle: Float = 2.0 * pi_val * h_weight;
    let c: Float = cos(angle);
    let s: Float = sin(angle);
    return TopoSpin {
        species_id: id,
        conformal_weight: h_weight,
        cos_theta: c,
        sin_theta: s,
    };
}

pub type RibbonData = struct {
    num_species: Int,
    spins: List[TopoSpin],
    quantum_dims: List[Float],
    total_dim_d: Float,
};

pub fn ribbon_data_new(n: Int, total_d: Float) -> RibbonData {
    let empty_spins: List[TopoSpin] = list_new();
    let empty_dims: List[Float] = list_new();
    return RibbonData {
        num_species: n,
        spins: empty_spins,
        quantum_dims: empty_dims,
        total_dim_d: total_d,
    };
}

pub fn ribbon_data_add_species(ribbon: &mut RibbonData, spin: TopoSpin, qdim: Float) {
    list_push(ribbon.spins, spin);
    list_push(ribbon.quantum_dims, qdim);
}

pub fn ribbon_gauss_sum_re(ribbon: &RibbonData) -> Float {
    let n: Int = ribbon.num_species;
    let mut sum_re: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let sp: TopoSpin = list_get(ribbon.spins, i);
        let d: Float = list_get(ribbon.quantum_dims, i);
        let d_sq: Float = d * d;
        let c: Float = sp.cos_theta;
        sum_re = sum_re + d_sq * c;
        i = i + 1;
    }
    return sum_re;
}

pub fn ribbon_gauss_sum_im(ribbon: &RibbonData) -> Float {
    let n: Int = ribbon.num_species;
    let mut sum_im: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let sp: TopoSpin = list_get(ribbon.spins, i);
        let d: Float = list_get(ribbon.quantum_dims, i);
        let d_sq: Float = d * d;
        let s: Float = sp.sin_theta;
        sum_im = sum_im + d_sq * s;
        i = i + 1;
    }
    return sum_im;
}

pub fn ribbon_balancing_phase_diff(h_a: Float, h_b: Float, h_c: Float, monodromy_phase: Float) -> Float {
    // Ribbon balancing: theta_c / (theta_a * theta_b) = R_{ab}^c * R_{ba}^c = exp(i * monodromy_phase)
    // In terms of conformal weights: delta_h = h_c - h_a - h_b
    let pi_val: Float = 3.141592653589793;
    let expected_phase: Float = 2.0 * pi_val * (h_c - h_a - h_b);
    let diff: Float = monodromy_phase - expected_phase;
    let abs_diff: Float = if diff < 0.0 { 0.0 - diff } else { diff };
    return abs_diff;
}
