// # Toric Code Fault-Tolerant Noise Thresholds & Error Chains
//
// Logline: Models phenomenological error distributions, random-bond Ising model (RBIM) phase transitions, and code capacity error thresholds.
//
// Setup: Statistical mechanics mapping of topological error correction thresholds for uncorrelated Pauli noise channels.
//
// Beats:
//   1. Define physical error rates p_x, p_z and syndrome measurement error probabilities.
//   2. Model RBIM Nishimori line mapping and critical error threshold p_th ~ 10.9%.
//   3. Compute syndrome defect pair density and error chain percolation bounds.

pub type NoiseModelParams = struct {
    bit_flip_rate_px: Float,
    phase_flip_rate_pz: Float,
    measurement_error_rate_pm: Float,
};

pub fn noise_model_params_new(px: Float, pz: Float, pm: Float) -> NoiseModelParams {
    return NoiseModelParams {
        bit_flip_rate_px: px,
        phase_flip_rate_pz: pz,
        measurement_error_rate_pm: pm,
    };
}

pub type NoiseThresholdResult = struct {
    code_capacity_threshold: Float, // ~ 0.109 (10.9% for code capacity)
    phenomenological_threshold: Float, // ~ 0.029 (2.9% with noisy syndrome)
    is_below_threshold: Int,
};

pub fn toric_evaluate_threshold(params: &NoiseModelParams) -> NoiseThresholdResult {
    let px: Float = params.bit_flip_rate_px;
    let pz: Float = params.phase_flip_rate_pz;
    let pm: Float = params.measurement_error_rate_pm;

    let p_eff: Float = if px >= pz { px } else { pz };
    let cap_th: Float = 0.1093; // 10.93% RBIM Nishimori point
    let phenom_th: Float = 0.0293; // 2.93% 3D gauge glass

    let is_below: Int = if pm > 0.0 {
        if p_eff < phenom_th && pm < phenom_th { 1 } else { 0 }
    } else {
        if p_eff < cap_th { 1 } else { 0 }
    };

    return NoiseThresholdResult {
        code_capacity_threshold: cap_th,
        phenomenological_threshold: phenom_th,
        is_below_threshold: is_below,
    };
}

pub fn toric_defect_density(physical_error_p: Float) -> Float {
    // Defect generation density for independent errors: rho = 4 * p * (1 - p)^3 ~ 4p for small p
    let one_minus_p: Float = 1.0 - physical_error_p;
    let factor: Float = one_minus_p * one_minus_p * one_minus_p;
    return 4.0 * physical_error_p * factor;
}
