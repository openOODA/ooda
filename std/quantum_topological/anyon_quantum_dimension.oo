// # Quantum Dimensions, Frobenius-Perron Eigenvalues & Modular S-Matrix
//
// Logline: Computes anyonic quantum dimensions via Frobenius-Perron spectral radius of fusion matrices and Verlinde S-matrix entries.
//
// Setup: Spectral theory of modular tensor categories establishing algebraic anyon quantum dimensions and topological charges.
//
// Beats:
//   1. Build fusion adjacency matrices N_a for simple anyonic objects.
//   2. Compute Frobenius-Perron dimension via iterative power iteration.
//   3. Implement modular S-matrix generation and Verlinde formula consistency checks.

pub type MatrixEntry = struct {
    row: Int,
    col: Int,
    val: Float,
};

pub fn matrix_entry_new(r: Int, c: Int, v: Float) -> MatrixEntry {
    return MatrixEntry { row: r, col: c, val: v };
}

pub type FusionMatrix = struct {
    dim: Int,
    entries: List[MatrixEntry],
};

pub fn fusion_matrix_new(dim: Int) -> FusionMatrix {
    let empty_entries: List[MatrixEntry] = list_new();
    return FusionMatrix {
        dim: dim,
        entries: empty_entries,
    };
}

pub fn fusion_matrix_add(mat: &mut FusionMatrix, r: Int, c: Int, val: Float) {
    let e: MatrixEntry = matrix_entry_new(r, c, val);
    list_push(mat.entries, e);
}

pub fn fusion_matrix_get(mat: &FusionMatrix, r: Int, c: Int) -> Float {
    let n: Int = list_len(mat.entries);
    let mut i: Int = 0;
    while i < n {
        let e: MatrixEntry = list_get(mat.entries, i);
        let er: Int = e.row;
        let ec: Int = e.col;
        if er == r && ec == c {
            return e.val;
        }
        i = i + 1;
    }
    return 0.0;
}

pub fn power_iteration_step(mat: &FusionMatrix, vec: List[Float]) -> List[Float] {
    let d: Int = mat.dim;
    let mut next_vec: List[Float] = list_new();
    let mut r: Int = 0;
    while r < d {
        let mut sum: Float = 0.0;
        let mut c: Int = 0;
        while c < d {
            let m_rc: Float = fusion_matrix_get(mat, r, c);
            let v_c: Float = list_get(vec, c);
            sum = sum + m_rc * v_c;
            c = c + 1;
        }
        list_push(next_vec, sum);
        r = r + 1;
    }
    return next_vec;
}

pub fn vector_norm_max(vec: List[Float]) -> Float {
    let n: Int = list_len(vec);
    let mut max_val: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let v: Float = list_get(vec, i);
        let abs_v: Float = if v < 0.0 { 0.0 - v } else { v };
        if abs_v > max_val {
            max_val = abs_v;
        }
        i = i + 1;
    }
    return max_val;
}

pub type ModularSMatrix = struct {
    num_species: Int,
    entries: List[MatrixEntry],
};

pub fn modular_s_matrix_new(n: Int) -> ModularSMatrix {
    let empty_list: List[MatrixEntry] = list_new();
    return ModularSMatrix {
        num_species: n,
        entries: empty_list,
    };
}

pub fn modular_s_matrix_add(smat: &mut ModularSMatrix, r: Int, c: Int, val: Float) {
    let e: MatrixEntry = matrix_entry_new(r, c, val);
    list_push(smat.entries, e);
}

pub fn fibonacci_modular_s_matrix() -> ModularSMatrix {
    let mut smat: ModularSMatrix = modular_s_matrix_new(2);
    let phi: Float = (1.0 + sqrt(5.0)) / 2.0;
    let big_d: Float = sqrt(1.0 + phi * phi);
    let s00: Float = 1.0 / big_d;
    let s01: Float = phi / big_d;
    let s10: Float = phi / big_d;
    let s11: Float = (0.0 - 1.0) / big_d;

    modular_s_matrix_add(&mut smat, 0, 0, s00);
    modular_s_matrix_add(&mut smat, 0, 1, s01);
    modular_s_matrix_add(&mut smat, 1, 0, s10);
    modular_s_matrix_add(&mut smat, 1, 1, s11);
    return smat;
}

pub fn ising_modular_s_matrix() -> ModularSMatrix {
    let mut smat: ModularSMatrix = modular_s_matrix_new(3);
    let sqrt2: Float = sqrt(2.0);
    modular_s_matrix_add(&mut smat, 0, 0, 0.5);
    modular_s_matrix_add(&mut smat, 0, 1, 0.5 * sqrt2);
    modular_s_matrix_add(&mut smat, 0, 2, 0.5);

    modular_s_matrix_add(&mut smat, 1, 0, 0.5 * sqrt2);
    modular_s_matrix_add(&mut smat, 1, 1, 0.0);
    modular_s_matrix_add(&mut smat, 1, 2, 0.0 - 0.5 * sqrt2);

    modular_s_matrix_add(&mut smat, 2, 0, 0.5);
    modular_s_matrix_add(&mut smat, 2, 1, 0.0 - 0.5 * sqrt2);
    modular_s_matrix_add(&mut smat, 2, 2, 0.5);

    return smat;
}
