// # Higher-Order Topological Insulators & Quantized Quadrupole Moments
//
// Logline: Models 2D Benalcazar-Bernevig-Hughes (BBH) quadrupole insulators hosting gapped edges and quantized e/2 corner zero modes.
//
// Setup: Multipolar higher-order topological phases where d-dimensional bulk topology protects (d-2)-dimensional corner boundary states.
//
// Beats:
//   1. Configure 2D BBH lattice parameters (intracell gamma_x, gamma_y, intercell lambda_x, lambda_y).
//   2. Compute quantized bulk quadrupole moment q_xy = e/2 mod e.
//   3. Extract fractional e/4 corner charges and protected mid-gap corner state wavefunctions.

pub type BbhQuadrupoleModel = struct {
    intracell_gamma: Float,
    intercell_lambda: Float,
    grid_size_l: Int,
    bulk_quadrupole_qxy: Float, // 0.5 (e/2) in topological phase
    corner_charge: Float       // 0.25 (e/4)
};

pub fn bbh_quadrupole_model_new(gamma: Float, lambda_val: Float, l_size: Int) -> BbhQuadrupoleModel {
    let abs_gamma: Float = if gamma < 0.0 { 0.0 - gamma } else { gamma };
    let abs_lambda: Float = if lambda_val < 0.0 { 0.0 - lambda_val } else { lambda_val };

    let is_topo: Int = if abs_gamma < abs_lambda { 1 } else { 0 };
    let qxy: Float = if is_topo != 0 { 0.5 } else { 0.0 };
    let q_corner: Float = if is_topo != 0 { 0.25 } else { 0.0 };

    return BbhQuadrupoleModel {
        intracell_gamma: gamma,
        intercell_lambda: lambda_val,
        grid_size_l: l_size,
        bulk_quadrupole_qxy: qxy,
        corner_charge: q_corner
    };
}

pub fn bbh_is_topological_quadrupole(model: &BbhQuadrupoleModel) -> Int {
    let qxy: Float = model.bulk_quadrupole_qxy;
    if qxy >= 0.49 && qxy <= 0.51 {
        return 1; // Topological phase with quantized e/2 quadrupole
    }
    return 0; // Trivial insulator
}

pub fn bbh_corner_state_energy_splitting(model: &BbhQuadrupoleModel) -> Float {
    // Energy splitting between 4 corner modes scales as exp(-L / xi)
    let gamma: Float = model.intracell_gamma;
    let lambda_val: Float = model.intercell_lambda;
    let l_val: Int = model.grid_size_l;
    let l_f: Float = (l_val as Float);

    if lambda_val <= 0.0 || gamma <= 0.0 {
        return 0.0;
    }
    let ratio: Float = gamma / lambda_val;
    if ratio >= 1.0 {
        return 1.0;
    }
    let xi: Float = (0.0 - 1.0) / ln(ratio);
    if xi <= 0.0 {
        return 0.0;
    }
    return exp((0.0 - l_f) / xi);
}
