// # Read-Rezayi Parafermion States & Universal Fibonacci Anyons
//
// Logline: Models Read-Rezayi Z_k parafermion FQHE states, k-body clustering wavefunctions, and universal Fibonacci anyons at k=3 (nu = 12/5).
//
// Setup: Non-Abelian quantum Hall states supporting universal topological quantum computing via braidings of Z_3 parafermion / Fibonacci anyons.
//
// Beats:
//   1. Configure Read-Rezayi Z_k clustering parameters (k=2 Moore-Read, k=3 Fibonacci).
//   2. Compute filling factor nu = k / (k * M + 2) and quasihole charge e* = e / (k * M + 2).
//   3. Model universal quantum computation capacity and golden ratio quantum dimensions.

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub type ReadRezayiState = struct {
    cluster_k: Int, // k=2 (Ising), k=3 (Fibonacci)
    jastrow_m: Int, // M=1 for fermionic FQHE
    filling_fraction_nu: Float,
    quasihole_charge_e_star: Float,
    is_universal_for_tqc: Int, // 1 for k=3 (Fibonacci) or k >= 5, 0 for k=2
};

pub fn read_rezayi_state_new(k: Int, m: Int) -> ReadRezayiState {
    let k_f: Float = int_to_float(k);
    let m_f: Float = int_to_float(m);
    let denom: Float = k_f * m_f + 2.0;
    let nu: Float = k_f / denom;
    let q_star: Float = 1.0 / denom;
    let is_univ: Int = if k == 3 || k >= 5 { 1 } else { 0 };

    return ReadRezayiState {
        cluster_k: k,
        jastrow_m: m,
        filling_fraction_nu: nu,
        quasihole_charge_e_star: q_star,
        is_universal_for_tqc: is_univ,
    };
}

pub fn read_rezayi_fibonacci_k3() -> ReadRezayiState {
    // k=3, M=1: nu = 3/5 in LLL or nu = 2 + 2/5 = 12/5 in 2nd Landau level
    return read_rezayi_state_new(3, 1);
}

pub fn read_rezayi_anyon_quantum_dim(state: &ReadRezayiState) -> Float {
    let k: Int = state.cluster_k;
    if k == 2 {
        return sqrt(2.0); // Ising anyon
    }
    if k == 3 {
        return (1.0 + sqrt(5.0)) / 2.0; // Golden ratio Fibonacci anyon
    }
    return 1.0;
}
