// # Toric Code Anyon Excitations & Mutual Braiding Statistics
//
// Logline: Models Toric Code superselection sectors (1, e, m, epsilon), mutual braiding phases, and dyon fermionic statistics.
//
// Setup: Abelian anyon algebra in Z_2 quantum double verifying semionic mutual braiding and emergent fermion bound states.
//
// Beats:
//   1. Represent Toric Code anyon types (vacuum 1, charge e, flux m, dyon epsilon).
//   2. Model fusion rules e x e = 1, m x m = 1, e x m = epsilon, epsilon x epsilon = 1.
//   3. Compute mutual statistical braiding phase theta(e, m) = pi and self-exchange phases.

pub type ToricAnyon = struct {
    id: Int, // 0: 1 (vacuum), 1: e (electric charge), 2: m (magnetic flux), 3: epsilon (dyon)
    label: String,
    electric_charge: Int, // 0 or 1
    magnetic_charge: Int, // 0 or 1
    topological_spin_phase: Float, // 0.0 (boson) or 1.0 (fermion pi)
};

pub fn toric_vacuum() -> ToricAnyon {
    return ToricAnyon {
        id: 0,
        label: "1",
        electric_charge: 0,
        magnetic_charge: 0,
        topological_spin_phase: 0.0,
    };
}

pub fn toric_charge_e() -> ToricAnyon {
    return ToricAnyon {
        id: 1,
        label: "e",
        electric_charge: 1,
        magnetic_charge: 0,
        topological_spin_phase: 0.0, // Boson
    };
}

pub fn toric_flux_m() -> ToricAnyon {
    return ToricAnyon {
        id: 2,
        label: "m",
        electric_charge: 0,
        magnetic_charge: 1,
        topological_spin_phase: 0.0, // Boson
    };
}

pub fn toric_dyon_epsilon() -> ToricAnyon {
    return ToricAnyon {
        id: 3,
        label: "eps",
        electric_charge: 1,
        magnetic_charge: 1,
        topological_spin_phase: 1.0, // Fermion (pi spin)
    };
}

pub fn toric_fusion(a_id: Int, b_id: Int) -> Int {
    // Z_2 x Z_2 fusion: bitwise XOR of (e, m) charge components
    // 0: (0,0), 1: (1,0), 2: (0,1), 3: (1,1)
    if a_id == 0 { return b_id; }
    if b_id == 0 { return a_id; }
    if a_id == b_id { return 0; } // x * x = 1 for all x in Z_2 x Z_2

    if (a_id == 1 && b_id == 2) || (a_id == 2 && b_id == 1) {
        return 3; // e x m = epsilon
    }
    if (a_id == 1 && b_id == 3) || (a_id == 3 && b_id == 1) {
        return 2; // e x epsilon = m
    }
    if (a_id == 2 && b_id == 3) || (a_id == 3 && b_id == 2) {
        return 1; // m x epsilon = e
    }
    return 0;
}

pub fn toric_mutual_braid_phase(a_id: Int, b_id: Int) -> Float {
    // Full braid (monodromy) phase = exp(i * phase)
    // Non-trivial phase pi occurs only between e and m components:
    // theta(e, m) = pi, theta(e, eps) = pi, theta(m, eps) = pi
    let pi_val: Float = 3.141592653589793;
    if a_id == 0 || b_id == 0 {
        return 0.0;
    }
    if a_id == b_id {
        return 0.0;
    }
    // Any pair among {e, m, eps} with distinct non-vacuum IDs has mutual braid phase pi
    return pi_val;
}

pub fn toric_anyon_is_fermion(a_id: Int) -> Int {
    if a_id == 3 {
        return 1; // epsilon is fermionic
    }
    return 0; // 1, e, m are bosonic
}
