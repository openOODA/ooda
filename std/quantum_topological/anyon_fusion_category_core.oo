// # Modular Tensor Category (MTC) & Anyon Fusion Category Core
//
// Logline: Core algebraic data structures for unitary modular tensor categories, simple anyon objects, fusion coefficients, and quantum dimensions.
//
// Setup: Foundations of topological quantum computing representing anyonic species, fusion spaces, and algebraic categorical invariants.
//
// Beats:
//   1. Define anyon particle types and fusion category descriptors.
//   2. Compute quantum dimensions, total quantum dimension, and Frobenius-Perron weights.
//   3. Implement fusion product multiplicities and fusion tensor lookups.

pub type AnyonSpecies = struct {
    id: Int,
    label: String,
    quantum_dim: Float,
    is_abelian: Int,
    topological_spin: Float, // h_a in radians
};

pub fn anyon_species_new(id: Int, label: String, qdim: Float, is_ab: Int, spin: Float) -> AnyonSpecies {
    return AnyonSpecies {
        id: id,
        label: label,
        quantum_dim: qdim,
        is_abelian: is_ab,
        topological_spin: spin,
    };
}

pub type FusionCategory = struct {
    num_species: Int,
    vacuum_id: Int,
    species: List[AnyonSpecies],
    total_quantum_dim: Float,
};

pub fn fusion_category_new(num_species: Int, vacuum_id: Int) -> FusionCategory {
    let empty_sp: List[AnyonSpecies] = list_new();
    return FusionCategory {
        num_species: num_species,
        vacuum_id: vacuum_id,
        species: empty_sp,
        total_quantum_dim: 0.0,
    };
}

pub fn fusion_category_add_species(cat: &mut FusionCategory, sp: AnyonSpecies) {
    list_push(cat.species, sp);
    let d: Float = sp.quantum_dim;
    cat.total_quantum_dim = sqrt(cat.total_quantum_dim * cat.total_quantum_dim + d * d);
}

pub type FusionRule = struct {
    a: Int,
    b: Int,
    c: Int,
    multiplicity: Int, // N_{ab}^c
};

pub fn fusion_rule_new(a: Int, b: Int, c: Int, mult: Int) -> FusionRule {
    return FusionRule {
        a: a,
        b: b,
        c: c,
        multiplicity: mult,
    };
}

pub type FusionTensor = struct {
    num_species: Int,
    rules: List[FusionRule],
};

pub fn fusion_tensor_new(num_species: Int) -> FusionTensor {
    let empty_r: List[FusionRule] = list_new();
    return FusionTensor {
        num_species: num_species,
        rules: empty_r,
    };
}

pub fn fusion_tensor_add_rule(tensor: &mut FusionTensor, a: Int, b: Int, c: Int, mult: Int) {
    let r: FusionRule = fusion_rule_new(a, b, c, mult);
    list_push(tensor.rules, r);
}

pub fn fusion_tensor_get_mult(tensor: &FusionTensor, a: Int, b: Int, c: Int) -> Int {
    let n: Int = list_len(tensor.rules);
    let mut i: Int = 0;
    while i < n {
        let r: FusionRule = list_get(tensor.rules, i);
        if r.a == a && r.b == b && r.c == c {
            return r.multiplicity;
        }
        i = i + 1;
    }
    return 0;
}

pub fn fusion_category_calc_total_dim(species: List[AnyonSpecies]) -> Float {
    let n: Int = list_len(species);
    let mut sum_sq: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let sp: AnyonSpecies = list_get(species, i);
        let d: Float = sp.quantum_dim;
        sum_sq = sum_sq + d * d;
        i = i + 1;
    }
    return sqrt(sum_sq);
}
