// # Walker-Wang 3D Topological Lattice Models & Boundary Anyons
//
// Logline: Models 3D Walker-Wang commuting projector lattice models realizing chiral anyon topological orders on 2D boundary surfaces.
//
// Setup: Exact 3D topological orders parameterized by unitary braided tensor categories displaying bulk confinement and deconfined surface anyons.
//
// Beats:
//   1. Configure 3D cubic/diamond lattice geometry with braided category edge labels.
//   2. Model bulk loop excitations and anyon string confinement.
//   3. Extract 2D boundary chiral anyon deconfined spectrum and surface state Hamiltonians.

pub type WalkerWang3DModel = struct {
    num_bulk_cells: Int,
    category_name: String,
    is_modular_category: Int, // 1 for MTC (Fibonacci, Ising), 0 for non-modular
    bulk_has_point_anyons: Int, // 0 for MTC (bulk anyons confined into loop endpoints)
    boundary_has_chiral_anyons: Int, // 1 for MTC
};

pub fn walker_wang_fibonacci_3d() -> WalkerWang3DModel {
    return WalkerWang3DModel {
        num_bulk_cells: 1000,
        category_name: "Fibonacci",
        is_modular_category: 1,
        bulk_has_point_anyons: 0, // Bulk point anyons are confined
        boundary_has_chiral_anyons: 1, // Surface has deconfined Fibonacci anyons
    };
}

pub fn walker_wang_semion_3d() -> WalkerWang3DModel {
    return WalkerWang3DModel {
        num_bulk_cells: 1000,
        category_name: "Semion",
        is_modular_category: 1,
        bulk_has_point_anyons: 0,
        boundary_has_chiral_anyons: 1,
    };
}

pub fn walker_wang_toric_code_3d() -> WalkerWang3DModel {
    // For symmetric braided category (non-modular like Z_2 with trivial braiding), 3D bulk hosts deconfined point charges
    return WalkerWang3DModel {
        num_bulk_cells: 1000,
        category_name: "Z2_Symmetric",
        is_modular_category: 0,
        bulk_has_point_anyons: 1,
        boundary_has_chiral_anyons: 0,
    };
}

pub fn walker_wang_bulk_string_tension(model: &WalkerWang3DModel, string_length_nm: Float) -> Float {
    let is_mod: Int = model.is_modular_category;
    if is_mod != 0 {
        // Linear confinement: Energy ~ sigma * L in bulk
        let sigma: Float = 0.05; // eV / nm
        return sigma * string_length_nm;
    }
    return 0.0; // Deconfined in bulk (zero string tension)
}
