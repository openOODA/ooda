// # Planar Toric Code Boundaries & Anyon Condensation
//
// Logline: Models smooth and rough boundary conditions in planar Toric Code patches, anyon condensation, and single logical qubit encodings.
//
// Setup: Planar topological surface code boundaries converting periodic torus degeneracy into open-boundary fault-tolerant logical memory.
//
// Beats:
//   1. Define smooth (electric-condensing) and rough (magnetic-condensing) boundary types.
//   2. Model anyon absorption at physical boundaries.
//   3. Compute planar patch logical qubit count k = 1 and boundary stabilizer modifications.

pub type BoundaryType = struct {
    id: Int, // 0: Smooth (e-condensing), 1: Rough (m-condensing)
    label: String,
    condensed_anyon: Int // 1 for e, 2 for m
};

pub fn boundary_smooth() -> BoundaryType {
    return BoundaryType {
        id: 0,
        label: "smooth",
        condensed_anyon: 1 // e-charge condenses
    };
}

pub fn boundary_rough() -> BoundaryType {
    return BoundaryType {
        id: 1,
        label: "rough",
        condensed_anyon: 2 // m-flux condenses
    };
}

pub type PlanarPatchConfig = struct {
    width_dx: Int,
    height_dz: Int,
    top_boundary: BoundaryType,
    bottom_boundary: BoundaryType,
    left_boundary: BoundaryType,
    right_boundary: BoundaryType
};

pub fn planar_patch_standard(dx: Int, dz: Int) -> PlanarPatchConfig {
    return PlanarPatchConfig {
        width_dx: dx,
        height_dz: dz,
        top_boundary: boundary_smooth(),
        bottom_boundary: boundary_smooth(),
        left_boundary: boundary_rough(),
        right_boundary: boundary_rough()
    };
}

pub fn planar_patch_can_condense(b_type: &BoundaryType, anyon_type: Int) -> Int {
    let ca: Int = b_type.condensed_anyon;
    if anyon_type == ca {
        return 1; // Anyon condenses into the vacuum at this boundary
    }
    return 0; // Anyon is reflected; cannot condense
}

pub fn planar_patch_logical_qubits(patch: &PlanarPatchConfig) -> Int {
    // Standard planar patch with alternating smooth/rough pairs has 1 logical qubit
    return 1;
}

pub fn planar_patch_code_distance(patch: &PlanarPatchConfig) -> Int {
    let wx: Int = patch.width_dx;
    let hz: Int = patch.height_dz;
    if wx <= hz {
        return wx;
    }
    return hz;
}
