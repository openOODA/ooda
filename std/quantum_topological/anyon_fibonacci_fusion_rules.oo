// # Fibonacci Anyon Fusion Rules & Branching Trees
//
// Logline: Implements non-Abelian Fibonacci anyon fusion algebra, golden ratio quantum dimensions, and branching tree Hilbert space dimensions.
//
// Setup: Golden ratio anyon model supporting universal topological quantum computation via non-Abelian braiding and fusion.
//
// Beats:
//   1. Define Fibonacci anyon types and golden ratio quantum dimensions.
//   2. Model the fusion rule tau x tau = 1 + tau and branching paths.
//   3. Compute topological Hilbert space dimensions for n-anyon systems.

pub type FibonacciAnyonType = struct {
    id: Int, // 0: Vacuum (1), 1: Tau (tau)
    symbol: String,
    quantum_dim: Float,
};

pub fn fibonacci_vacuum() -> FibonacciAnyonType {
    return FibonacciAnyonType {
        id: 0,
        symbol: "1",
        quantum_dim: 1.0,
    };
}

pub fn fibonacci_tau() -> FibonacciAnyonType {
    let phi: Float = (1.0 + sqrt(5.0)) / 2.0; // Golden ratio ~ 1.618033988749895
    return FibonacciAnyonType {
        id: 1,
        symbol: "tau",
        quantum_dim: phi,
    };
}

pub fn fibonacci_fusion_outcomes(a: Int, b: Int) -> List[Int] {
    let mut outcomes: List[Int] = list_new();
    if a == 0 && b == 0 {
        list_push(outcomes, 0); // 1 x 1 = 1
    } else if a == 0 && b == 1 {
        list_push(outcomes, 1); // 1 x tau = tau
    } else if a == 1 && b == 0 {
        list_push(outcomes, 1); // tau x 1 = tau
    } else if a == 1 && b == 1 {
        list_push(outcomes, 0); // tau x tau = 1
        list_push(outcomes, 1); //          + tau
    }
    return outcomes;
}

pub fn fibonacci_number(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }
    let mut a: Int = 0;
    let mut b: Int = 1;
    let mut i: Int = 2;
    while i <= n {
        let temp: Int = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    return b;
}

/// Computes Hilbert space dimension for N tau anyons fusing to total charge target (0 for 1, 1 for tau).
pub fn fibonacci_fusion_space_dim(n_tau: Int, target: Int) -> Int {
    if n_tau <= 0 {
        if target == 0 { return 1; }
        return 0;
    }
    if n_tau == 1 {
        if target == 1 { return 1; }
        return 0;
    }
    if target == 0 {
        // Dim(V_{tau...tau}^1) = Fib(n_tau - 1)
        return fibonacci_number(n_tau - 1);
    }
    // Dim(V_{tau...tau}^tau) = Fib(n_tau)
    return fibonacci_number(n_tau);
}

pub type FibonacciBranchTree = struct {
    num_leaves: Int,
    intermediate_charges: List[Int],
    target_charge: Int,
};

pub fn fibonacci_branch_tree_new(num_leaves: Int, target_charge: Int) -> FibonacciBranchTree {
    let empty_charges: List[Int] = list_new();
    return FibonacciBranchTree {
        num_leaves: num_leaves,
        intermediate_charges: empty_charges,
        target_charge: target_charge,
    };
}

pub fn fibonacci_validate_path(path: List[Int]) -> Int {
    let n: Int = list_len(path);
    if n < 2 {
        return 1;
    }
    let mut i: Int = 0;
    while i < n - 1 {
        let curr: Int = list_get(path, i);
        let nxt: Int = list_get(path, i + 1);
        // Consecutive 0s (1 fusing to 1 via tau) cannot occur in tau chain
        if curr == 0 && nxt == 0 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}
