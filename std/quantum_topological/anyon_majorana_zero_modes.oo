// # Majorana Zero Modes & 1D Kitaev Topological Superconductor
//
// Logline: Models Majorana bound states in 1D Kitaev chains, non-local Dirac fermion modes, fermion parity, and braiding operators.
//
// Setup: Condensed matter realization of non-Abelian Ising anyons localized at semiconductor nanowire topological domain walls.
//
// Beats:
//   1. Configure 1D Kitaev chain parameters (chemical potential mu, hopping t, p-wave pairing delta).
//   2. Map complex electron creation/annihilation operators to Majorana operators gamma_2j-1 and gamma_2j.
//   3. Implement parity operators, topological protection energy splits, and Clifford braiding unitaries.

pub type KitaevWireConfig = struct {
    num_sites: Int,
    chemical_potential: Float, // mu
    hopping_amplitude: Float,  // t
    superconducting_gap: Float // delta
};

pub fn kitaev_wire_config_new(sites: Int, mu: Float, t: Float, delta: Float) -> KitaevWireConfig {
    return KitaevWireConfig {
        num_sites: sites,
        chemical_potential: mu,
        hopping_amplitude: t,
        superconducting_gap: delta
    };
}

pub fn kitaev_wire_is_topological(cfg: &KitaevWireConfig) -> Int {
    let mu: Float = cfg.chemical_potential;
    let t: Float = cfg.hopping_amplitude;
    let abs_mu: Float = if mu < 0.0 { 0.0 - mu } else { mu };
    let abs_2t: Float = if t < 0.0 { 0.0 - 2.0 * t } else { 2.0 * t };
    if abs_mu < abs_2t {
        return 1; // Topological phase with edge zero modes
    }
    return 0; // Trivial insulating phase
}

pub type MajoranaMode = struct {
    wire_id: Int,
    mode_index: Int, // 1..2N
    is_left_edge: Int,
    is_right_edge: Int,
    energy_splitting: Float // delta E ~ exp(-L / xi)
};

pub fn majorana_mode_new(wire_id: Int, idx: Int, left: Int, right: Int, split: Float) -> MajoranaMode {
    return MajoranaMode {
        wire_id: wire_id,
        mode_index: idx,
        is_left_edge: left,
        is_right_edge: right,
        energy_splitting: split
    };
}

pub fn majorana_wire_energy_split(length_l: Float, coherence_len_xi: Float) -> Float {
    if coherence_len_xi <= 0.0 {
        return 0.0;
    }
    let ratio: Float = length_l / coherence_len_xi;
    let neg_ratio: Float = 0.0 - ratio;
    return exp(neg_ratio);
}

pub type MajoranaBraidOp = struct {
    mode_a: Int,
    mode_b: Int,
    phase_angle: Float // pi / 4 for standard braid
};

pub fn majorana_braid_op_new(mode_a: Int, mode_b: Int) -> MajoranaBraidOp {
    let pi_val: Float = 3.141592653589793;
    return MajoranaBraidOp {
        mode_a: mode_a,
        mode_b: mode_b,
        phase_angle: pi_val / 4.0
    };
}

/// Applies Majorana exchange transformation:
/// gamma_a -> gamma_b,  gamma_b -> -gamma_a
pub fn majorana_braid_transform_index(braid: &MajoranaBraidOp, target_mode: Int) -> Int {
    let ma: Int = braid.mode_a;
    let mb: Int = braid.mode_b;
    if target_mode == ma {
        return mb;
    }
    if target_mode == mb {
        return 0 - ma; // Sign flipped
    }
    return target_mode;
}

pub fn majorana_parity_operator_sign(n_occupied: Int) -> Int {
    // Parity P = (-1)^N = +1 (even) or -1 (odd)
    if n_occupied % 2 == 0 {
        return 1;
    }
    return 0 - 1;
}
