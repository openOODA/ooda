// # Jones Polynomial Evaluation & Kauffman Bracket Braid Invariants
//
// Logline: Computes link invariants, Kauffman bracket state sums, writhe numbers, and Jones polynomials from anyonic braid words.
//
// Setup: Topological knot invariants computed via quantum traces and modular tensor category state-sum models.
//
// Beats:
//   1. Represent braid generators and link diagrams with signed crossings.
//   2. Compute Kauffman bracket polynomial coefficients and writhe numbers.
//   3. Evaluate Jones polynomial V(t) at roots of unity corresponding to SU(2)_k anyon models.

pub type BraidCrossing = struct {
    strand_index: Int, // 1..N-1
    is_positive: Int   // 1 for sigma_i (+1), 0 for sigma_i^{-1} (-1)
};

pub fn braid_crossing_new(strand: Int, is_pos: Int) -> BraidCrossing {
    return BraidCrossing {
        strand_index: strand,
        is_positive: is_pos
    };
}

pub type BraidWord = struct {
    num_strands: Int,
    num_crossings: Int,
    crossings: List[BraidCrossing]
};

pub fn braid_word_new(strands: Int) -> BraidWord {
    let empty_cr: List[BraidCrossing] = list_new();
    return BraidWord {
        num_strands: strands,
        num_crossings: 0,
        crossings: empty_cr
    };
}

pub fn braid_word_append(bw: &mut BraidWord, strand: Int, is_pos: Int) {
    let cr: BraidCrossing = braid_crossing_new(strand, is_pos);
    list_push(bw.crossings, cr);
    let nc: Int = bw.num_crossings;
    bw.num_crossings = nc + 1;
}

pub fn braid_word_writhe(bw: &BraidWord) -> Int {
    let n: Int = bw.num_crossings;
    let mut w: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let cr: BraidCrossing = list_get(bw.crossings, i);
        let pos: Int = cr.is_positive;
        if pos == 1 {
            w = w + 1;
        } else {
            w = w - 1;
        }
        i = i + 1;
    }
    return w;
}

pub type PolynomialTerm = struct {
    degree: Int,
    coeff: Float
};

pub fn polynomial_term_new(deg: Int, coeff: Float) -> PolynomialTerm {
    return PolynomialTerm {
        degree: deg,
        coeff: coeff
    };
}

pub type LaurentPoly = struct {
    terms: List[PolynomialTerm]
};

pub fn laurent_poly_new() -> LaurentPoly {
    let empty_terms: List[PolynomialTerm] = list_new();
    return LaurentPoly {
        terms: empty_terms
    };
}

pub fn laurent_poly_add_term(poly: &mut LaurentPoly, deg: Int, coeff: Float) {
    let t: PolynomialTerm = polynomial_term_new(deg, coeff);
    list_push(poly.terms, t);
}

pub fn kauffman_circle_value_d(a_val: Float) -> Float {
    // d = -A^2 - A^(-2)
    if a_val == 0.0 {
        return 0.0;
    }
    let a2: Float = a_val * a_val;
    let inv_a2: Float = 1.0 / a2;
    return 0.0 - a2 - inv_a2;
}

pub fn jones_trefoil_evaluate(t_val: Float) -> Float {
    // Jones polynomial of right-handed trefoil (3_1):
    // V(t) = t + t^3 - t^4
    let t2: Float = t_val * t_val;
    let t3: Float = t2 * t_val;
    let t4: Float = t3 * t_val;
    return t_val + t3 - t4;
}

pub fn jones_figure_eight_evaluate(t_val: Float) -> Float {
    // Jones polynomial of figure-eight knot (4_1):
    // V(t) = t^{-2} - t^{-1} + 1 - t + t^2
    if t_val == 0.0 {
        return 0.0;
    }
    let inv_t: Float = 1.0 / t_val;
    let inv_t2: Float = inv_t * inv_t;
    let t2: Float = t_val * t_val;
    return inv_t2 - inv_t + 1.0 - t_val + t2;
}
