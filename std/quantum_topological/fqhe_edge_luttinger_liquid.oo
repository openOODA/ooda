// # Chiral Luttinger Liquid Edge Modes & Thermal Hall Transport
//
// Logline: Models Wen's 1D chiral Luttinger liquid edge states, chiral boson field commutators, and quantized electrical/thermal Hall conductances.
//
// Setup: Conformal field theory of gapless 1D chiral boundary excitations bounding 2D fractional quantum Hall bulk topological phases.
//
// Beats:
//   1. Configure chiral Luttinger liquid parameters (edge velocity v, filling fraction nu, central charge c).
//   2. Compute 1D electron and quasihole scaling dimensions and tunneling exponent g = 1/nu.
//   3. Calculate quantized electrical Hall conductance G = nu * e^2/h and chiral thermal Hall conductance.

pub type ChiralEdgeLiquid = struct {
    filling_fraction_nu: Float,
    edge_velocity_m_s: Float,
    chiral_central_charge: Float,
    electron_tunneling_exponent: Float, // g = 1 / nu
    quasihole_scaling_dimension: Float, // Delta = nu / 2
};

pub fn chiral_edge_liquid_new(nu: Float, velocity: Float, c: Float) -> ChiralEdgeLiquid {
    let g: Float = if nu > 0.0 { 1.0 / nu } else { 1.0 };
    let delta_qh: Float = nu / 2.0;
    return ChiralEdgeLiquid {
        filling_fraction_nu: nu,
        edge_velocity_m_s: velocity,
        chiral_central_charge: c,
        electron_tunneling_exponent: g,
        quasihole_scaling_dimension: delta_qh,
    };
}

pub fn chiral_edge_laughlin_nu_1_3(velocity: Float) -> ChiralEdgeLiquid {
    return chiral_edge_liquid_new(0.3333333333, velocity, 1.0);
}

pub fn chiral_edge_moore_read_nu_5_2(velocity: Float) -> ChiralEdgeLiquid {
    // Moore-Read edge has 1 chiral charge boson (c=1) + 1 neutral Majorana fermion (c=0.5) -> c_tot = 1.5
    return chiral_edge_liquid_new(2.5, velocity, 1.5);
}

pub fn chiral_edge_conductance_si(liquid: &ChiralEdgeLiquid) -> Float {
    // G = nu * (e^2 / h) where e^2/h ~ 3.87404e-5 Siemens
    let nu: Float = liquid.filling_fraction_nu;
    let conductance_quantum: Float = 0.00003874045; // S
    return nu * conductance_quantum;
}

pub fn chiral_thermal_hall_coefficient(liquid: &ChiralEdgeLiquid) -> Float {
    // Thermal Hall coefficient kappa_xy / T = c * (pi^2 k_B^2 / 3h)
    let c: Float = liquid.chiral_central_charge;
    return c;
}
