// # SU(2)_k Chern-Simons Anyon Categories & Quantum Integers
//
// Logline: Models SU(2)_k Chern-Simons anyonic theories, quantum q-deformed dimensions, and level-k truncated angular momentum fusion rules.
//
// Setup: General parameterized class of non-Abelian anyon systems encompassing Fibonacci (k=3) and Ising (k=2) categories.
//
// Beats:
//   1. Represent SU(2)_k spins parameterized by 2j in 0..k.
//   2. Compute q-deformed quantum dimensions via quantum sine formulas.
//   3. Implement SU(2)_k fusion product truncation and total quantum dimension.

pub type Su2LevelKAnyon = struct {
    two_j: Int, // 2j index: 0, 1, 2, ..., k
    level_k: Int,
    quantum_dim: Float,
    conformal_weight: Float // h_j = j(j+1)/(k+2)
};

pub fn su2_quantum_dimension(two_j: Int, k: Int) -> Float {
    let pi_val: Float = 3.141592653589793;
    let k_f: Float = (k + 2) as Float;
    let denom_arg: Float = pi_val / k_f;
    let j_f: Float = (two_j + 1) as Float;
    let num_arg: Float = j_f * denom_arg;
    let s_num: Float = sin(num_arg);
    let s_den: Float = sin(denom_arg);
    if s_den == 0.0 {
        return 1.0;
    }
    return s_num / s_den;
}

pub fn su2_conformal_weight(two_j: Int, k: Int) -> Float {
    let j_val: Float = (two_j as Float) / 2.0;
    let k_plus_2: Float = (k + 2) as Float;
    let num: Float = j_val * (j_val + 1.0);
    return num / k_plus_2;
}

pub fn su2_level_k_anyon_new(two_j: Int, k: Int) -> Su2LevelKAnyon {
    let qdim: Float = su2_quantum_dimension(two_j, k);
    let h: Float = su2_conformal_weight(two_j, k);
    return Su2LevelKAnyon {
        two_j: two_j,
        level_k: k,
        quantum_dim: qdim,
        conformal_weight: h
    };
}

/// Fusion rule for SU(2)_k: j1 x j2 produces all j from |j1-j2| to min(j1+j2, k-(j1+j2)) in integer steps of j
pub fn su2_fusion_outcomes(two_j1: Int, two_j2: Int, k: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let min_2j: Int = if two_j1 >= two_j2 { two_j1 - two_j2 } else { two_j2 - two_j1 };
    let sum_2j: Int = two_j1 + two_j2;
    let dual_sum_2j: Int = 2 * k - sum_2j;
    let max_2j: Int = if sum_2j <= dual_sum_2j { sum_2j } else { dual_sum_2j };

    let mut cur: Int = min_2j;
    while cur <= max_2j {
        list_push(out, cur);
        cur = cur + 2; // Step by 2 in 2j (step by 1 in j)
    }
    return out;
}

pub fn su2_total_quantum_dimension(k: Int) -> Float {
    let pi_val: Float = 3.141592653589793;
    let k_plus_2: Float = (k + 2) as Float;
    let arg: Float = pi_val / k_plus_2;
    let s: Float = sin(arg);
    if s == 0.0 {
        return 1.0;
    }
    let factor: Float = sqrt(k_plus_2 / 2.0);
    return factor / s;
}
