// # Jain Composite Fermion Sequences & Effective Gauge Fields
//
// Logline: Implements Jain's composite fermion hierarchy mapping FQHE electron states to integer Landau levels of flux-bound fermions.
//
// Setup: Strongly interacting 2D electron gas mapped to weakly interacting composite fermions under reduced effective magnetic field B*.
//
// Beats:
//   1. Model composite fermion construction attaching 2k flux quanta to electrons.
//   2. Compute Jain sequence filling fractions nu = p / (2*k*p +/- 1).
//   3. Calculate effective magnetic field B* and composite fermion Landau level gaps.

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub type CompositeFermionState = struct {
    cf_lambda_p: Int, // Integer filling p of composite fermions
    attached_flux_2k: Int, // 2k (typically 2 or 4)
    filling_fraction_nu: Float,
    effective_field_b_star: Float,
    cf_cyclotron_gap_k: Float, // in Kelvin
};

pub fn composite_fermion_state_new(p: Int, k: Int, b_field_tesla: Float) -> CompositeFermionState {
    let p_f: Float = int_to_float(p);
    let k_f: Float = int_to_float(k);
    let denom: Float = 2.0 * k_f * p_f + 1.0;
    let nu: Float = p_f / denom;

    // B* = B / (2kp + 1)
    let b_star: Float = b_field_tesla / denom;
    // Composite fermion activation gap ~ 0.05 * e^2 / (epsilon * ell_B) in K
    let gap_k: Float = 5.0 * sqrt(if b_field_tesla > 0.0 { b_field_tesla } else { 1.0 });

    return CompositeFermionState {
        cf_lambda_p: p,
        attached_flux_2k: 2 * k,
        filling_fraction_nu: nu,
        effective_field_b_star: b_star,
        cf_cyclotron_gap_k: gap_k,
    };
}

pub fn jain_principal_sequence(max_p: Int) -> List[Float] {
    let mut fractions: List[Float] = list_new();
    let mut p: Int = 1;
    while p <= max_p {
        let p_f: Float = int_to_float(p);
        let nu: Float = p_f / (2.0 * p_f + 1.0);
        list_push(fractions, nu);
        p = p + 1;
    }
    return fractions;
}
