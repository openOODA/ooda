// # Artin Braid Group B_N & Yang-Baxter Relations
//
// Logline: Implements the Artin Braid Group B_N algebra, Yang-Baxter braid relation verification, and word reduction.
//
// Setup: Algebraic structure of multi-strand anyon braiding operations governing topological quantum gate operations.
//
// Beats:
//   1. Represent Artin braid generators sigma_i and inverse generators sigma_i^{-1}.
//   2. Verify far-commutation sigma_i sigma_j = sigma_j sigma_i for |i-j| >= 2.
//   3. Validate the Yang-Baxter relation sigma_i sigma_{i+1} sigma_i = sigma_{i+1} sigma_i sigma_{i+1}.

pub type BraidGenerator = struct {
    index: Int,      // 1..N-1
    is_inverse: Int // 0 for sigma_i, 1 for sigma_i^{-1}
};

pub fn braid_generator_new(idx: Int, inv: Int) -> BraidGenerator {
    return BraidGenerator {
        index: idx,
        is_inverse: inv
    };
}

pub type BraidGroupElement = struct {
    num_strands_n: Int,
    word_length: Int,
    generators: List[BraidGenerator]
};

pub fn braid_group_element_new(strands: Int) -> BraidGroupElement {
    let empty_gen: List[BraidGenerator] = list_new();
    return BraidGroupElement {
        num_strands_n: strands,
        word_length: 0,
        generators: empty_gen
    };
}

pub fn braid_group_append(el: &mut BraidGroupElement, gen: BraidGenerator) {
    list_push(el.generators, gen);
    let wl: Int = el.word_length;
    el.word_length = wl + 1;
}

pub fn braid_generators_commute(g1: &BraidGenerator, g2: &BraidGenerator) -> Int {
    let i1: Int = g1.index;
    let i2: Int = g2.index;
    let diff: Int = if i1 >= i2 { i1 - i2 } else { i2 - i1 };
    if diff >= 2 {
        return 1; // Far commutation holds
    }
    return 0; // Adjacent generators do not commute
}

pub fn braid_cancels_adjacent(g1: &BraidGenerator, g2: &BraidGenerator) -> Int {
    let i1: Int = g1.index;
    let i2: Int = g2.index;
    let inv1: Int = g1.is_inverse;
    let inv2: Int = g2.is_inverse;
    if i1 == i2 && inv1 != inv2 {
        return 1; // sigma_i * sigma_i^{-1} = 1 (identity)
    }
    return 0;
}
