// # Kitaev Honeycomb Abelian Phase & Perturbative Toric Code
//
// Logline: Implements 4th-order perturbation theory mapping the anisotropic Kitaev honeycomb A_z phase (J_z >> J_x, J_y) to Toric Code.
//
// Setup: Low-energy effective Hamiltonian mapping z-bond spin pairs to effective Toric Code qubits and star/plaquette stabilizers.
//
// Beats:
//   1. Model anisotropic limit J_z >> J_x, J_y and dimer subspace projection.
//   2. Compute 4th-order effective exchange coupling J_eff = J_x^2 J_y^2 / (16 J_z^3).
//   3. Map hexagonal plaquettes to effective square lattice Toric Code stabilizers.

pub type AbelianPhaseMapping = struct {
    jx: Float,
    jy: Float,
    jz: Float,
    effective_coupling_j_eff: Float,
    subspace_gap: Float // ~ 2 * J_z
};

pub fn abelian_phase_mapping_new(jx: Float, jy: Float, jz: Float) -> AbelianPhaseMapping {
    let jx2: Float = jx * jx;
    let jy2: Float = jy * jy;
    let jz3: Float = jz * jz * jz;
    let j_eff: Float = if jz3 != 0.0 { (jx2 * jy2) / (16.0 * jz3) } else { 0.0 };
    let gap: Float = 2.0 * jz;
    return AbelianPhaseMapping {
        jx: jx,
        jy: jy,
        jz: jz,
        effective_coupling_j_eff: j_eff,
        subspace_gap: gap
    };
}

pub fn abelian_phase_is_perturbative_valid(mapping: &AbelianPhaseMapping) -> Int {
    let jx: Float = mapping.jx;
    let jy: Float = mapping.jy;
    let jz: Float = mapping.jz;
    // Condition: max(Jx, Jy) << Jz (e.g. ratio < 0.25)
    let max_xy: Float = if jx >= jy { jx } else { jy };
    if jz <= 0.0 {
        return 0;
    }
    let ratio: Float = max_xy / jz;
    if ratio < 0.25 {
        return 1;
    }
    return 0;
}

pub fn abelian_phase_toric_plaquette_energy(mapping: &AbelianPhaseMapping) -> Float {
    let j_eff: Float = mapping.effective_coupling_j_eff;
    // Ground state energy contribution per plaquette is -J_eff
    return 0.0 - j_eff;
}
