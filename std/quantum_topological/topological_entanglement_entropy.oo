// # Topological Entanglement Entropy & Kitaev-Preskill Tripartition
//
// Logline: Computes topological entanglement entropy gamma = ln(D) via Kitaev-Preskill and Levin-Wen geometric area-law subtractions.
//
// Setup: Non-local multipartite entanglement signatures diagnosing intrinsic topological order in strongly correlated quantum states.
//
// Beats:
//   1. Model 3-region geometric tripartitions (A, B, C) on 2D manifolds.
//   2. Compute Kitaev-Preskill linear combination S_topo = S_A + S_B + S_C - S_AB - S_BC - S_CA + S_ABC.
//   3. Extract total quantum dimension D = exp(gamma) and compare against theoretical MTC values.

pub type TripartitionEntropies = struct {
    entropy_a: Float,
    entropy_b: Float,
    entropy_c: Float,
    entropy_ab: Float,
    entropy_bc: Float,
    entropy_ca: Float,
    entropy_abc: Float,
};

pub fn tripartition_entropies_new(sa: Float, sb: Float, sc: Float, sab: Float, sbc: Float, sca: Float, sabc: Float) -> TripartitionEntropies {
    return TripartitionEntropies {
        entropy_a: sa,
        entropy_b: sb,
        entropy_c: sc,
        entropy_ab: sab,
        entropy_bc: sbc,
        entropy_ca: sca,
        entropy_abc: sabc,
    };
}

pub fn kitaev_preskill_topological_entropy(e: &TripartitionEntropies) -> Float {
    // S_topo = S_A + S_B + S_C - S_AB - S_BC - S_CA + S_ABC = -gamma
    let sa: Float = e.entropy_a;
    let sb: Float = e.entropy_b;
    let sc: Float = e.entropy_c;
    let sab: Float = e.entropy_ab;
    let sbc: Float = e.entropy_bc;
    let sca: Float = e.entropy_ca;
    let sabc: Float = e.entropy_abc;

    let pos: Float = sa + sb + sc + sabc;
    let neg: Float = sab + sbc + sca;
    let s_topo: Float = pos - neg;
    // gamma = -S_topo
    return 0.0 - s_topo;
}

pub fn total_quantum_dim_from_gamma(gamma: Float) -> Float {
    // D = exp(gamma)
    return exp(gamma);
}

pub fn theoretical_gamma_toric_code() -> Float {
    // D = 2.0 -> gamma = ln(2)
    return ln(2.0);
}

pub fn theoretical_gamma_fibonacci() -> Float {
    // phi = (1 + sqrt(5))/2, D = sqrt(1 + phi^2)
    let phi: Float = (1.0 + sqrt(5.0)) / 2.0;
    let d: Float = sqrt(1.0 + phi * phi);
    return ln(d);
}

pub fn theoretical_gamma_ising() -> Float {
    // D = 2.0 -> gamma = ln(2)
    return ln(2.0);
}
