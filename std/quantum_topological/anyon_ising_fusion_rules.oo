// # Ising Anyon Fusion Rules & Majorana Braiding Algebra
//
// Logline: Implements Ising anyon fusion rules (1, sigma, psi), Majorana fermion fusion subspaces, and topological quantum dimensions.
//
// Setup: Algebraic core of Ising topological phase realized in Fractional Quantum Hall nu=5/2 and Kitaev topological superconductor wires.
//
// Beats:
//   1. Define Ising anyon species (vacuum 1, non-Abelian sigma, fermion psi).
//   2. Model fusion algebra sigma x sigma = 1 + psi, sigma x psi = sigma, psi x psi = 1.
//   3. Compute multi-sigma Hilbert space dimension 2^(n-1) and fermion parity.

pub type IsingAnyon = struct {
    id: Int, // 0: 1 (vacuum), 1: sigma (vortex/Majorana), 2: psi (fermion)
    label: String,
    quantum_dim: Float,
    topological_spin_phase: Float // in multiples of pi: 0, 1/8, 1/2
};

pub fn ising_vacuum() -> IsingAnyon {
    return IsingAnyon {
        id: 0,
        label: "1",
        quantum_dim: 1.0,
        topological_spin_phase: 0.0
    };
}

pub fn ising_sigma() -> IsingAnyon {
    return IsingAnyon {
        id: 1,
        label: "sigma",
        quantum_dim: sqrt(2.0),
        topological_spin_phase: 0.125 // pi / 8
    };
}

pub fn ising_psi() -> IsingAnyon {
    return IsingAnyon {
        id: 2,
        label: "psi",
        quantum_dim: 1.0,
        topological_spin_phase: 0.5 // pi / 2
    };
}

pub fn ising_fusion_outcomes(a: Int, b: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    if a == 0 {
        list_push(out, b);
        return out;
    }
    if b == 0 {
        list_push(out, a);
        return out;
    }
    if a == 1 && b == 1 {
        // sigma x sigma = 1 + psi
        list_push(out, 0);
        list_push(out, 2);
        return out;
    }
    if (a == 1 && b == 2) || (a == 2 && b == 1) {
        // sigma x psi = psi x sigma = sigma
        list_push(out, 1);
        return out;
    }
    if a == 2 && b == 2 {
        // psi x psi = 1
        list_push(out, 0);
        return out;
    }
    return out;
}

pub fn ising_fusion_space_dim_sigma_pairs(num_sigma_pairs: Int) -> Int {
    if num_sigma_pairs <= 0 {
        return 1;
    }
    let mut dim: Int = 1;
    let mut i: Int = 1;
    while i < num_sigma_pairs {
        dim = dim * 2;
        i = i + 1;
    }
    return dim;
}

pub fn ising_total_quantum_dim() -> Float {
    // D = sqrt(1^2 + (sqrt(2))^2 + 1^2) = sqrt(1 + 2 + 1) = 2.0
    return 2.0;
}

pub fn ising_fermion_parity(intermediate_charge: Int) -> Int {
    // 0: even parity (1), 2: odd parity (psi)
    if intermediate_charge == 2 {
        return 1; // odd
    }
    return 0; // even
}
