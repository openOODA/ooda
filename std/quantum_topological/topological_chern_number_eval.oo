// # First Chern Number Evaluation & Fukui-Hatsugai-Suzuki Method
//
// Logline: Computes quantized First Chern numbers C in Z on discretized 2D Brillouin zones using gauge-invariant U(1) Wilson plaquette products.
//
// Setup: Topological band structure classification of integer quantum Hall states and Chern insulators.
//
// Beats:
//   1. Discretize 2D Brillouin zone into N_kx x N_ky momentum grid cells.
//   2. Compute U(1) link variables and plaquette Berry fluxes F_xy(k).
//   3. Sum plaquette fluxes to extract integer Chern invariant C = (1/2*pi) * sum F_xy in Z.

pub type BrillouinGrid = struct {
    nkx: Int,
    nky: Int,
    total_plaquettes: Int,
    plaquette_fluxes: List[Float], // Berry flux per plaquette in radians
};

pub fn brillouin_grid_new(nkx: Int, nky: Int) -> BrillouinGrid {
    let empty_fluxes: List[Float] = list_new();
    let total: Int = nkx * nky;
    return BrillouinGrid {
        nkx: nkx,
        nky: nky,
        total_plaquettes: total,
        plaquette_fluxes: empty_fluxes,
    };
}

pub fn brillouin_grid_add_flux(grid: &mut BrillouinGrid, flux: Float) {
    list_push(grid.plaquette_fluxes, flux);
}

pub fn fukui_compute_chern_number(grid: &BrillouinGrid) -> Int {
    let n: Int = list_len(grid.plaquette_fluxes);
    let mut sum_flux: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let f: Float = list_get(grid.plaquette_fluxes, i);
        sum_flux = sum_flux + f;
        i = i + 1;
    }
    let pi_val: Float = 3.141592653589793;
    let two_pi: Float = 2.0 * pi_val;
    let c_float: Float = sum_flux / two_pi;

    // Round to nearest integer
    if c_float >= 0.0 {
        let c_int: Int = (c_float + 0.5) as Int;
        return c_int;
    }
    let c_neg: Float = 0.0 - c_float;
    let c_int_neg: Int = (c_neg + 0.5) as Int;
    return 0 - c_int_neg;
}

pub fn qhe_hall_conductance_quantized(chern_number: Int) -> Float {
    // sigma_xy = C * (e^2 / h)
    let c_f: Float = if chern_number >= 0 {
        (chern_number as Float)
    } else {
        let neg: Int = 0 - chern_number;
        0.0 - (neg as Float)
    };
    return c_f; // In units of e^2/h
}
