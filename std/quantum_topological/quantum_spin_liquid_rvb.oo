// # Resonating Valence Bond (RVB) Quantum Spin Liquids
//
// Logline: Models Anderson's Resonating Valence Bond singlet dimer wavefunctions, Rokhsar-Kivelson quantum dimer models, and topological entropy.
//
// Setup: Spin-1/2 frustrated quantum antiferromagnets with short-range dimer coverings and fractionalized spinon excitations.
//
// Beats:
//   1. Define spin-singlet valence bonds (i, j) and lattice dimer coverings.
//   2. Compute Rokhsar-Kivelson equal-amplitude quantum dimer superpositions.
//   3. Evaluate topological entanglement entropy gamma = ln(2) and spinon deconfinement.

pub type SingletDimer = struct {
    site_a: Int,
    site_b: Int,
    weight: Float,
};

pub fn singlet_dimer_new(a: Int, b: Int, w: Float) -> SingletDimer {
    return SingletDimer {
        site_a: a,
        site_b: b,
        weight: w,
    };
}

pub type DimerCovering = struct {
    num_dimers: Int,
    dimers: List[SingletDimer],
};

pub fn dimer_covering_new() -> DimerCovering {
    let empty_d: List[SingletDimer] = list_new();
    return DimerCovering {
        num_dimers: 0,
        dimers: empty_d,
    };
}

pub fn dimer_covering_add(cov: &mut DimerCovering, d: SingletDimer) {
    list_push(cov.dimers, d);
    let nd: Int = cov.num_dimers;
    cov.num_dimers = nd + 1;
}

pub type RvbState = struct {
    num_sites: Int,
    num_coverings: Int,
    coverings: List[DimerCovering],
    topological_entropy_gamma: Float, // ln(2) ~ 0.693147
};

pub fn rvb_state_new(sites: Int) -> RvbState {
    let empty_c: List[DimerCovering] = list_new();
    let ln2: Float = ln(2.0);
    return RvbState {
        num_sites: sites,
        num_coverings: 0,
        coverings: empty_c,
        topological_entropy_gamma: ln2,
    };
}

pub fn rvb_add_covering(state: &mut RvbState, cov: DimerCovering) {
    list_push(state.coverings, cov);
    let nc: Int = state.num_coverings;
    state.num_coverings = nc + 1;
}

pub fn rvb_overlap_loop_factor(num_transition_loops: Int) -> Float {
    // Overlap <D_1 | D_2> = 2^(N_loops - N_sites/2) * sign
    let mut factor: Float = 1.0;
    let mut i: Int = 0;
    while i < num_transition_loops {
        factor = factor * 2.0;
        i = i + 1;
    }
    return factor;
}
