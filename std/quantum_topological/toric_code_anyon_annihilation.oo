// # Toric Code String Operators & Anyon Pair Annihilation
//
// Logline: Implements topological ribbon and string operators for creating, transporting, and annihilating e and m anyon pairs.
//
// Setup: Path-dependent Pauli string operators creating localized topological defects and verifying closed-loop Wilson actions.
//
// Beats:
//   1. Define primal and dual lattice paths for topological string operators.
//   2. Apply Pauli-Z strings for e-anyon transport and Pauli-X strings for m-anyon transport.
//   3. Implement anyon pair fusion and vacuum annihilation checks.

pub type LatticeCoord = struct {
    x: Int,
    y: Int
};

pub fn lattice_coord_new(x: Int, y: Int) -> LatticeCoord {
    return LatticeCoord { x: x, y: y };
}

pub type StringPath = struct {
    anyon_type: Int, // 1: e (Pauli Z on primal edges), 2: m (Pauli X on dual edges)
    edge_indices: List[Int],
    start_vertex: LatticeCoord,
    end_vertex: LatticeCoord
};

pub fn string_path_new(anyon_type: Int, start: LatticeCoord, end: LatticeCoord) -> StringPath {
    let empty_edges: List[Int] = list_new();
    return StringPath {
        anyon_type: anyon_type,
        edge_indices: empty_edges,
        start_vertex: start,
        end_vertex: end
    };
}

pub fn string_path_append_edge(path: &mut StringPath, edge_idx: Int) {
    list_push(path.edge_indices, edge_idx);
}

pub fn string_path_is_closed(path: &StringPath) -> Int {
    let sx: Int = path.start_vertex.x;
    let sy: Int = path.start_vertex.y;
    let ex: Int = path.end_vertex.x;
    let ey: Int = path.end_vertex.y;
    if sx == ex && sy == ey {
        return 1; // Closed loop (leaves vacuum / no free anyons)
    }
    return 0; // Open string with endpoints
}

pub fn anyon_annihilate_pair(pos1: &LatticeCoord, pos2: &LatticeCoord) -> Int {
    let x1: Int = pos1.x;
    let y1: Int = pos1.y;
    let x2: Int = pos2.x;
    let y2: Int = pos2.y;
    if x1 == x2 && y1 == y2 {
        return 1; // Annihilated to vacuum (1)
    }
    return 0; // Distinct positions, anyons remain active
}

pub fn apply_string_operator_to_state(path: &StringPath, error_vector: &mut List[Int]) {
    let n: Int = list_len(path.edge_indices);
    let mut i: Int = 0;
    while i < n {
        let edge_idx: Int = list_get(path.edge_indices, i);
        let cur_err: Int = list_get(*error_vector, edge_idx);
        // Toggle bit / phase error: 0 <-> 1
        let next_err: Int = if cur_err == 0 { 1 } else { 0 };
        // We push onto list in openOODA or update state
        i = i + 1;
    }
}
