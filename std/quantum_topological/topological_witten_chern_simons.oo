// # Witten Chern-Simons TQFT & 3D Topological Quantum Invariants
//
// Logline: Models 3D Chern-Simons gauge theories at integer level k, Wilson loop expectation values, and knot invariant evaluation.
//
// Setup: Exact non-perturbative topological quantum field theory connecting 3D quantum gauge paths with modular tensor categories.
//
// Beats:
//   1. Configure SU(2) Chern-Simons action parameters (level k, gauge connection rank).
//   2. Compute Wilson loop expectation values <W_j(C)> along linked knots in S^3.
//   3. Implement framing anomaly self-linking phase factors exp(2*pi*i*h_j).

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub type ChernSimonsConfig = struct {
    gauge_group: String,
    level_k: Int,
    manifold: String // e.g. "S3", "S2xS1", "T3"
};

pub fn chern_simons_config_new(group: String, k: Int, manifold: String) -> ChernSimonsConfig {
    return ChernSimonsConfig {
        gauge_group: group,
        level_k: k,
        manifold: manifold
    };
}

pub fn cs_su2_partition_function_s3(k: Int) -> Float {
    // Z(S^3) = sqrt(2 / (k + 2)) * sin(pi / (k + 2))
    let pi_val: Float = 3.141592653589793;
    let k_plus_2: Float = int_to_float(k + 2);
    let prefactor: Float = sqrt(2.0 / k_plus_2);
    let arg: Float = pi_val / k_plus_2;
    return prefactor * sin(arg);
}

pub fn cs_wilson_loop_unknot(two_j: Int, k: Int) -> Float {
    // Quantum dimension [2j+1]_q for the unknot in S^3
    let pi_val: Float = 3.141592653589793;
    let k_plus_2: Float = int_to_float(k + 2);
    let denom_arg: Float = pi_val / k_plus_2;
    let j_f: Float = int_to_float(two_j + 1);
    let num_arg: Float = j_f * denom_arg;
    let s_num: Float = sin(num_arg);
    let s_den: Float = sin(denom_arg);
    if s_den == 0.0 {
        return 1.0;
    }
    return s_num / s_den;
}

pub fn cs_framing_anomaly_phase(two_j: Int, k: Int, framing_number_p: Int) -> Float {
    let pi_val: Float = 3.141592653589793;
    let j_val: Float = int_to_float(two_j) / 2.0;
    let k_plus_2: Float = int_to_float(k + 2);
    let h_j: Float = (j_val * (j_val + 1.0)) / k_plus_2;
    let p_f: Float = int_to_float(framing_number_p);
    // Phase = 2 * pi * h_j * p
    return 2.0 * pi_val * h_j * p_f;
}
