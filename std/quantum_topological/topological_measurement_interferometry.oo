// # Anyon Interferometry & Non-Abelian State Measurement
//
// Logline: Models Fabry-Perot and Mach-Zehnder anyon interferometers, quantum point contact transmission, and S-matrix visibility suppression.
//
// Setup: Electronic and edge-state interferometry in Fractional Quantum Hall liquids measuring non-Abelian topological charges.
//
// Beats:
//   1. Configure two-contact Fabry-Perot interferometer geometry (QPC-1, QPC-2, enclosed area).
//   2. Compute interference current oscillations as a function of magnetic flux and enclosed topological charge.
//   3. Evaluate visibility suppression factors S_{ab}/S_{0b} diagnosing non-Abelian quantum states.

pub type InterferometerConfig = struct {
    area_nm2: Float,
    qpc1_tunneling_prob: Float,
    qpc2_tunneling_prob: Float,
    temperature_mk: Float
};

pub fn interferometer_config_new(area: Float, t1: Float, t2: Float, temp_mk: Float) -> InterferometerConfig {
    return InterferometerConfig {
        area_nm2: area,
        qpc1_tunneling_prob: t1,
        qpc2_tunneling_prob: t2,
        temperature_mk: temp_mk
    };
}

pub fn anyon_interference_visibility_abelian(t1: Float, t2: Float) -> Float {
    // Visibility V = 2 * sqrt(t1 * t2) / (t1 + t2)
    let prod: Float = t1 * t2;
    let sum: Float = t1 + t2;
    if sum == 0.0 {
        return 0.0;
    }
    let sqrt_prod: Float = if prod > 0.0 { sqrt(prod) } else { 0.0 };
    return (2.0 * sqrt_prod) / sum;
}

pub fn anyon_interference_visibility_non_abelian(t1: Float, t2: Float, s_ab: Float, s_0b: Float) -> Float {
    let base_vis: Float = anyon_interference_visibility_abelian(t1, t2);
    if s_0b == 0.0 {
        return 0.0;
    }
    let mod_ratio: Float = s_ab / s_0b;
    let abs_ratio: Float = if mod_ratio < 0.0 { 0.0 - mod_ratio } else { mod_ratio };
    return base_vis * abs_ratio;
}

pub fn anyon_aharonov_bohm_period_tesla(area_nm2: Float, charge_e_star: Float) -> Float {
    // Period Delta B = (h / e*) / Area
    // Flux quantum h/e ~ 4.135667e-15 Wb = 4.135667e-15 T * m^2 = 4.135667e3 T * nm^2
    let flux_quantum_t_nm2: Float = 4135.667;
    let effective_flux: Float = if charge_e_star > 0.0 { flux_quantum_t_nm2 / charge_e_star } else { flux_quantum_t_nm2 };
    if area_nm2 <= 0.0 {
        return 0.0;
    }
    return effective_flux / area_nm2;
}
