// # Topological Density Matrices & Fusion Channel Superoperators
//
// Logline: Models density matrices on topological Hilbert spaces, non-unitary fusion superoperators, purity, and decoherence.
//
// Setup: Open quantum system framework for tracking anyonic entanglement entropy loss and environmental leakage.
//
// Beats:
//   1. Represent 2D topological qubit density matrices [rho_00, rho_01; rho_10, rho_11].
//   2. Apply incoherent fusion measurement channels and dephasing superoperators.
//   3. Compute state purity Tr(rho^2) and von Neumann entropy.

pub type TopoDensityMatrix2x2 = struct {
    rho00: Float,
    rho11: Float,
    rho01_re: Float,
    rho01_im: Float,
};

pub fn topo_density_matrix_pure_zero() -> TopoDensityMatrix2x2 {
    return TopoDensityMatrix2x2 {
        rho00: 1.0,
        rho11: 0.0,
        rho01_re: 0.0,
        rho01_im: 0.0,
    };
}

pub fn topo_density_matrix_maximally_mixed() -> TopoDensityMatrix2x2 {
    return TopoDensityMatrix2x2 {
        rho00: 0.5,
        rho11: 0.5,
        rho01_re: 0.0,
        rho01_im: 0.0,
    };
}

pub fn topo_density_matrix_purity(rho: &TopoDensityMatrix2x2) -> Float {
    // Purity gamma = Tr(rho^2) = rho00^2 + rho11^2 + 2*(rho01_re^2 + rho01_im^2)
    let r00: Float = rho.rho00;
    let r11: Float = rho.rho11;
    let r01_re: Float = rho.rho01_re;
    let r01_im: Float = rho.rho01_im;
    let off_diag_sq: Float = r01_re * r01_re + r01_im * r01_im;
    return r00 * r00 + r11 * r11 + 2.0 * off_diag_sq;
}

pub fn topo_density_matrix_apply_dephasing(rho: &TopoDensityMatrix2x2, gamma_dephase: Float) -> TopoDensityMatrix2x2 {
    // Off-diagonal terms damped by (1 - gamma_dephase)
    let factor: Float = 1.0 - gamma_dephase;
    let safe_factor: Float = if factor > 0.0 { factor } else { 0.0 };
    let r00: Float = rho.rho00;
    let r11: Float = rho.rho11;
    let r01_re: Float = rho.rho01_re;
    let r01_im: Float = rho.rho01_im;

    return TopoDensityMatrix2x2 {
        rho00: r00,
        rho11: r11,
        rho01_re: r01_re * safe_factor,
        rho01_im: r01_im * safe_factor,
    };
}

pub fn topo_density_matrix_entropy(rho: &TopoDensityMatrix2x2) -> Float {
    // Von Neumann entropy S = -lambda_1 ln(lambda_1) - lambda_2 ln(lambda_2)
    let r00: Float = rho.rho00;
    let r11: Float = rho.rho11;
    let r01_re: Float = rho.rho01_re;
    let r01_im: Float = rho.rho01_im;

    let diff: Float = r00 - r11;
    let off_sq: Float = r01_re * r01_re + r01_im * r01_im;
    let disc: Float = diff * diff + 4.0 * off_sq;
    let sqrt_disc: Float = if disc > 0.0 { sqrt(disc) } else { 0.0 };

    let l1: Float = (1.0 + sqrt_disc) / 2.0;
    let l2: Float = (1.0 - sqrt_disc) / 2.0;

    let term1: Float = if l1 > 0.00001 { (0.0 - l1) * ln(l1) } else { 0.0 };
    let term2: Float = if l2 > 0.00001 { (0.0 - l2) * ln(l2) } else { 0.0 };
    return term1 + term2;
}
