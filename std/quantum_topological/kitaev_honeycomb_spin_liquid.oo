// # Kitaev Honeycomb Spin Liquid & Majorana Fractionalization
//
// Logline: Implements Kitaev's exactly solvable honeycomb spin model with bond-dependent directional Ising exchanges J_x, J_y, J_z.
//
// Setup: Quantum spin-1/2 honeycomb lattice hosting fractionalized itinerant Majorana fermions coupled to static Z_2 gauge fields.
//
// Beats:
//   1. Represent honeycomb lattice bonds (x-links, y-links, z-links) and spin couplings.
//   2. Map physical spins to 4 Majorana fermions (c, b^x, b^y, b^z) per site.
//   3. Formulate the quadratic Majorana hopping Hamiltonian and static link gauge variables u_jk = +/-1.

pub type HoneycombBond = struct {
    site_j: Int,
    site_k: Int,
    bond_type: Int, // 0: x-link, 1: y-link, 2: z-link
    coupling_j: Float,
    gauge_u: Int // +1 or -1
};

pub fn honeycomb_bond_new(j: Int, k: Int, b_type: Int, j_val: Float) -> HoneycombBond {
    return HoneycombBond {
        site_j: j,
        site_k: k,
        bond_type: b_type,
        coupling_j: j_val,
        gauge_u: 1 // Ground state vortex-free sector: u_jk = +1
    };
}

pub type HoneycombModel = struct {
    num_sites: Int,
    jx: Float,
    jy: Float,
    jz: Float,
    bonds: List[HoneycombBond]
};

pub fn honeycomb_model_new(sites: Int, jx: Float, jy: Float, jz: Float) -> HoneycombModel {
    let empty_bonds: List[HoneycombBond] = list_new();
    return HoneycombModel {
        num_sites: sites,
        jx: jx,
        jy: jy,
        jz: jz,
        bonds: empty_bonds
    };
}

pub fn honeycomb_add_bond(model: &mut HoneycombModel, j: Int, k: Int, b_type: Int) {
    let mut j_val: Float = model.jz;
    if b_type == 0 {
        j_val = model.jx;
    } else if b_type == 1 {
        j_val = model.jy;
    }
    let b: HoneycombBond = honeycomb_bond_new(j, k, b_type, j_val);
    list_push(model.bonds, b);
}

pub fn honeycomb_phase_diagram(jx: Float, jy: Float, jz: Float) -> Int {
    // Triangle inequalities for gapless B-phase (non-Abelian / gapless spin liquid):
    // |Jx - Jy| <= Jz <= Jx + Jy
    // If Jz > Jx + Jy: Gapped A_z phase (Toric code Abelian phase)
    let sum_xy: Float = jx + jy;
    let diff_xy: Float = if jx >= jy { jx - jy } else { jy - jx };

    if jz > sum_xy {
        return 0; // Gapped A_z phase (Abelian Toric Code)
    }
    if jx > jy + jz {
        return 1; // Gapped A_x phase
    }
    if jy > jx + jz {
        return 2; // Gapped A_y phase
    }
    return 3; // Gapless B-phase (Majorana Fermi surfaces / Dirac cones)
}

pub fn honeycomb_majorana_hopping_matrix_entry(bond: &HoneycombBond) -> Float {
    let j_val: Float = bond.coupling_j;
    let u_val: Int = bond.gauge_u;
    let u_f: Float = if u_val > 0 { 1.0 } else { 0.0 - 1.0 };
    return 2.0 * j_val * u_f;
}
