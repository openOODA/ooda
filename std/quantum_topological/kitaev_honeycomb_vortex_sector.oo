// # Kitaev Honeycomb Plaquette Vortices & Z_2 Gauge Fields
//
// Logline: Models hexagonal plaquette loop operators W_p, Lieb's vortex-free ground state theorem, and vison excitation gaps.
//
// Setup: Gauge theory of static Z_2 fluxes W_p = +/-1 defining vortex sectors in the Kitaev honeycomb spin liquid.
//
// Beats:
//   1. Construct hexagonal plaquette Wilson loops W_p = sigma_1^x sigma_2^y sigma_3^z sigma_4^x sigma_5^y sigma_6^z.
//   2. Compute product of link gauge variables u_jk around plaquette perimeters.
//   3. Calculate vison flux excitation gaps and vortex pair energy costs.

pub type HexagonalPlaquette = struct {
    plaquette_id: Int,
    site_indices: List[Int], // 6 perimeter sites: 1..6
    link_indices: List[Int] // 6 incident links
};

pub fn hexagonal_plaquette_new(p_id: Int) -> HexagonalPlaquette {
    let empty_sites: List[Int] = list_new();
    let empty_links: List[Int] = list_new();
    return HexagonalPlaquette {
        plaquette_id: p_id,
        site_indices: empty_sites,
        link_indices: empty_links
    };
}

pub fn plaquette_add_element(plaq: &mut HexagonalPlaquette, site: Int, link: Int) {
    list_push(plaq.site_indices, site);
    list_push(plaq.link_indices, link);
}

pub fn plaquette_evaluate_flux(plaq: &HexagonalPlaquette, link_gauge_u: List[Int]) -> Int {
    // W_p = product of u_jk for the 6 links on the hexagon
    let mut flux: Int = 1;
    let mut i: Int = 0;
    while i < 6 {
        let l_idx: Int = list_get(plaq.link_indices, i);
        let u: Int = list_get(link_gauge_u, l_idx);
        flux = flux * u;
        i = i + 1;
    }
    return flux; // +1: vortex-free, -1: pi-flux vortex (vison)
}

pub fn kitaev_vortex_gap(jz: Float) -> Float {
    // In isotropic limit J_x = J_y = J_z = J, flux gap Delta_v ~ 0.153 J_z
    return 0.1536 * jz;
}

pub fn is_ground_state_sector(plaquette_fluxes: List[Int]) -> Int {
    let n: Int = list_len(plaquette_fluxes);
    let mut i: Int = 0;
    while i < n {
        let fl: Int = list_get(plaquette_fluxes, i);
        if fl != 1 {
            return 0; // Contains vortices, not in ground state sector
        }
        i = i + 1;
    }
    return 1; // All W_p = +1 (vortex-free)
}
