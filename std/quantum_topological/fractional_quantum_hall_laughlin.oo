// # Fractional Quantum Hall Laughlin Wavefunctions & Plasma Analogy
//
// Logline: Implements Laughlin trial wavefunctions at filling factor nu = 1/m, magnetic length scaling, and 2D one-component plasma mapping.
//
// Setup: Ground state wavefunctions of strongly correlated 2D electron gases in perpendicular magnetic fields in the Lowest Landau Level.
//
// Beats:
//   1. Configure Laughlin state parameters (filling fraction nu = 1/m, magnetic length ell_B).
//   2. Compute 2D coordinate Jastrow polynomial factor prod (z_i - z_j)^m.
//   3. Map electron density distributions to classical 2D one-component plasma screening profiles.

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub type ComplexCoord = struct {
    x: Float,
    y: Float
};

pub fn complex_coord_new(x: Float, y: Float) -> ComplexCoord {
    return ComplexCoord { x: x, y: y };
}

pub type LaughlinState = struct {
    num_particles: Int,
    laughlin_m: Int, // m = 3 for nu = 1/3, m = 5 for nu = 1/5
    filling_fraction: Float, // 1.0 / m
    magnetic_length_ell_b: Float,
    electron_density: Float // nu / (2 * pi * ell_B^2)
};

pub fn laughlin_state_new(n_particles: Int, m: Int, magnetic_field_tesla: Float) -> LaughlinState {
    let pi_val: Float = 3.141592653589793;
    let b_safe: Float = if magnetic_field_tesla > 0.0 { magnetic_field_tesla } else { 1.0 };
    let ell_b: Float = 25.66 / sqrt(b_safe); // in nm
    let m_f: Float = int_to_float(m);
    let nu: Float = 1.0 / m_f;
    let ell_b_sq: Float = ell_b * ell_b;
    let rho: Float = nu / (2.0 * pi_val * ell_b_sq);

    return LaughlinState {
        num_particles: n_particles,
        laughlin_m: m,
        filling_fraction: nu,
        magnetic_length_ell_b: ell_b,
        electron_density: rho
    };
}

pub fn laughlin_jastrow_log_magnitude(state: &LaughlinState, positions: List[ComplexCoord]) -> Float {
    let n: Int = state.num_particles;
    let m_val: Int = state.laughlin_m;
    let m_f: Float = int_to_float(m_val);
    let mut log_mag: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let mut j: Int = i + 1;
        while j < n {
            let pi: ComplexCoord = list_get(positions, i);
            let pj: ComplexCoord = list_get(positions, j);
            let pix: Float = pi.x;
            let piy: Float = pi.y;
            let pjx: Float = pj.x;
            let pjy: Float = pj.y;
            let dx: Float = pix - pjx;
            let dy: Float = piy - pjy;
            let dist_sq: Float = dx * dx + dy * dy;
            let dist: Float = if dist_sq > 0.0 { sqrt(dist_sq) } else { 0.0001 };
            log_mag = log_mag + m_f * ln(dist);
            j = j + 1;
        }
        i = i + 1;
    }
    return log_mag;
}

pub fn laughlin_gaussian_factor_log(state: &LaughlinState, positions: List[ComplexCoord]) -> Float {
    let n: Int = state.num_particles;
    let ell_b: Float = state.magnetic_length_ell_b;
    let ell_b_sq: Float = ell_b * ell_b;
    let mut sum_r2: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let p: ComplexCoord = list_get(positions, i);
        let px: Float = p.x;
        let py: Float = p.y;
        sum_r2 = sum_r2 + (px * px + py * py);
        i = i + 1;
    }
    return (0.0 - sum_r2) / (4.0 * ell_b_sq);
}
