// # Anyon F-Matrix (Associator) & R-Matrix (Braid) Operators
//
// Logline: Implements unitary topological F-moves (basis change) and R-moves (braid exchanges) for Fibonacci and Ising anyons.
//
// Setup: Unitary transformations mapping between anyon fusion tree bases and computing topological braiding matrices.
//
// Beats:
//   1. Represent 2x2 unitary F-matrices for Fibonacci and Ising fusion trees.
//   2. Define phase R-matrices for elementary anyon swaps.
//   3. Apply basis transformations and braid moves to 2D topological qubit statevectors.

pub type ComplexNum = struct {
    re: Float,
    im: Float,
};

pub fn complex_new(re: Float, im: Float) -> ComplexNum {
    return ComplexNum { re: re, im: im };
}

pub fn complex_add(a: ComplexNum, b: ComplexNum) -> ComplexNum {
    return ComplexNum { re: a.re + b.re, im: a.im + b.im };
}

pub fn complex_mul(a: ComplexNum, b: ComplexNum) -> ComplexNum {
    let ar: Float = a.re;
    let ai: Float = a.im;
    let br: Float = b.re;
    let bi: Float = b.im;
    let r: Float = ar * br - ai * bi;
    let i_val: Float = ar * bi + ai * br;
    return ComplexNum { re: r, im: i_val };
}

pub type Matrix2x2 = struct {
    m00: ComplexNum,
    m01: ComplexNum,
    m10: ComplexNum,
    m11: ComplexNum,
};

pub fn matrix2x2_new(m00: ComplexNum, m01: ComplexNum, m10: ComplexNum, m11: ComplexNum) -> Matrix2x2 {
    return Matrix2x2 { m00: m00, m01: m01, m10: m10, m11: m11 };
}

pub fn fibonacci_f_matrix() -> Matrix2x2 {
    let phi: Float = (1.0 + sqrt(5.0)) / 2.0;
    let inv_phi: Float = 1.0 / phi;
    let inv_sqrt_phi: Float = 1.0 / sqrt(phi);
    return Matrix2x2 {
        m00: complex_new(inv_phi, 0.0),
        m01: complex_new(inv_sqrt_phi, 0.0),
        m10: complex_new(inv_sqrt_phi, 0.0),
        m11: complex_new(0.0 - inv_phi, 0.0),
    };
}

pub fn fibonacci_r_matrix() -> Matrix2x2 {
    // R_1 = exp(-i * 4 * pi / 5), R_tau = exp(i * 3 * pi / 5)
    let pi_val: Float = 3.141592653589793;
    let theta1: Float = (0.0 - 4.0) * pi_val / 5.0;
    let theta2: Float = 3.0 * pi_val / 5.0;
    return Matrix2x2 {
        m00: complex_new(cos(theta1), sin(theta1)),
        m01: complex_new(0.0, 0.0),
        m10: complex_new(0.0, 0.0),
        m11: complex_new(cos(theta2), sin(theta2)),
    };
}

pub fn ising_f_matrix() -> Matrix2x2 {
    let inv_sqrt2: Float = 1.0 / sqrt(2.0);
    return Matrix2x2 {
        m00: complex_new(inv_sqrt2, 0.0),
        m01: complex_new(inv_sqrt2, 0.0),
        m10: complex_new(inv_sqrt2, 0.0),
        m11: complex_new(0.0 - inv_sqrt2, 0.0),
    };
}

pub fn ising_r_matrix() -> Matrix2x2 {
    // R_1 = exp(-i * pi / 8), R_psi = exp(i * 3 * pi / 8)
    let pi_val: Float = 3.141592653589793;
    let theta1: Float = (0.0 - 1.0) * pi_val / 8.0;
    let theta2: Float = 3.0 * pi_val / 8.0;
    return Matrix2x2 {
        m00: complex_new(cos(theta1), sin(theta1)),
        m01: complex_new(0.0, 0.0),
        m10: complex_new(0.0, 0.0),
        m11: complex_new(cos(theta2), sin(theta2)),
    };
}

pub type TopoQubitState = struct {
    c0: ComplexNum, // Amplitude for intermediate channel 0 (vacuum 1)
    c1: ComplexNum, // Amplitude for intermediate channel 1 (anyon tau / fermion psi)
};

pub fn topo_qubit_apply_matrix(state: &TopoQubitState, mat: &Matrix2x2) -> TopoQubitState {
    let t00: ComplexNum = complex_mul(mat.m00, state.c0);
    let t01: ComplexNum = complex_mul(mat.m01, state.c1);
    let new_c0: ComplexNum = complex_add(t00, t01);

    let t10: ComplexNum = complex_mul(mat.m10, state.c0);
    let t11: ComplexNum = complex_mul(mat.m11, state.c1);
    let new_c1: ComplexNum = complex_add(t10, t11);

    return TopoQubitState {
        c0: new_c0,
        c1: new_c1,
    };
}

pub fn topo_qubit_braid_sigma1(state: &TopoQubitState, r_mat: &Matrix2x2) -> TopoQubitState {
    return topo_qubit_apply_matrix(state, r_mat);
}

pub fn topo_qubit_braid_sigma2(state: &TopoQubitState, f_mat: &Matrix2x2, r_mat: &Matrix2x2) -> TopoQubitState {
    // sigma_2 = F * R * F
    let s1: TopoQubitState = topo_qubit_apply_matrix(state, f_mat);
    let s2: TopoQubitState = topo_qubit_apply_matrix(&s1, r_mat);
    let s3: TopoQubitState = topo_qubit_apply_matrix(&s2, f_mat);
    return s3;
}
