// # Topological Quantum Memory & Exponential Error Suppression
//
// Logline: Models topological quantum memory lifetimes, thermal anyon hopping rates, and exponential protection scaling with code distance.
//
// Setup: Thermodynamic stability and fault-tolerant retention of quantum information in gapped topological phases.
//
// Beats:
//   1. Configure topological memory parameters (topological gap Delta, code distance d, operating temperature T).
//   2. Compute Arrhenius thermal anyon excitation rate Gamma = omega_0 * exp(-Delta / k_B T).
//   3. Calculate logical qubit memory lifetime tau_L scaling exponentially with code distance d.

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub type TopoMemoryConfig = struct {
    code_distance_d: Int,
    topological_gap_k: Float, // in Kelvin
    temperature_k: Float,     // in Kelvin
    attempt_frequency_ghz: Float
};

pub fn topo_memory_config_new(d: Int, gap_k: Float, temp_k: Float) -> TopoMemoryConfig {
    return TopoMemoryConfig {
        code_distance_d: d,
        topological_gap_k: gap_k,
        temperature_k: temp_k,
        attempt_frequency_ghz: 10.0
    };
}

pub fn topo_memory_thermal_excitation_rate(cfg: &TopoMemoryConfig) -> Float {
    let gap: Float = cfg.topological_gap_k;
    let temp: Float = cfg.temperature_k;
    let omega_0: Float = cfg.attempt_frequency_ghz;
    if temp <= 0.0 {
        return 0.0;
    }
    let exponent: Float = (0.0 - gap) / temp;
    let boltzmann_factor: Float = exp(exponent);
    return omega_0 * boltzmann_factor;
}

pub fn topo_memory_logical_lifetime_seconds(cfg: &TopoMemoryConfig) -> Float {
    let d: Int = cfg.code_distance_d;
    let d_f: Float = int_to_float(d);
    let rate: Float = topo_memory_thermal_excitation_rate(cfg);
    if rate <= 0.0 {
        return 1000000.0; // Infinite lifetime at T=0
    }
    // Lifetime tau_L ~ (1 / rate) * (rate_th / rate)^(d/2)
    // Simplified scaling: tau_0 * exp(0.5 * d * (Delta / T))
    let gap: Float = cfg.topological_gap_k;
    let temp: Float = cfg.temperature_k;
    let temp_safe: Float = if temp > 0.001 { temp } else { 0.001 };
    let scaled_exp: Float = 0.5 * d_f * (gap / temp_safe);
    let cap_exp: Float = if scaled_exp > 50.0 { 50.0 } else { scaled_exp };
    return (0.001 / rate) * exp(cap_exp);
}
