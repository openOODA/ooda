// # Moore-Read Pfaffian State & nu=5/2 Non-Abelian Anyons
//
// Logline: Implements Moore-Read Pfaffian trial wavefunctions at filling factor nu = 5/2, e/4 quasiholes, and Majorana zero mode bound states.
//
// Setup: Paired composite fermion state realizing the Ising topological quantum field theory in second Landau level 2D electron gases.
//
// Beats:
//   1. Configure Moore-Read state at nu = 5/2 (or nu = 1/2 bosonic).
//   2. Model Pfaffian pairing factor Pf(1 / (z_i - z_j)) and Jastrow envelope.
//   3. Compute e/4 fractional quasihole charge and 2^(n-1) multi-quasihole ground state degeneracy.

pub type MooreReadState = struct {
    num_particles: Int,
    filling_fraction: Float, // 2.5 (nu = 5/2)
    quasihole_charge_e_star: Float, // 0.25 (e / 4)
    quasihole_quantum_dim: Float, // sqrt(2)
};

pub fn moore_read_state_new(n_particles: Int) -> MooreReadState {
    return MooreReadState {
        num_particles: n_particles,
        filling_fraction: 2.5,
        quasihole_charge_e_star: 0.25,
        quasihole_quantum_dim: sqrt(2.0),
    };
}

pub fn moore_read_quasihole_degeneracy(num_quasiholes: Int) -> Int {
    // 2n quasiholes produce 2^(n-1) fold degenerate ground states
    if num_quasiholes < 2 {
        return 1;
    }
    let n_pairs: Int = num_quasiholes / 2;
    let mut deg: Int = 1;
    let mut i: Int = 1;
    while i < n_pairs {
        deg = deg * 2;
        i = i + 1;
    }
    return deg;
}

pub fn moore_read_anti_pfaffian_shift() -> Int {
    // Topological shift on sphere: Moore-Read shift = 3, Anti-Pfaffian shift = -1
    return 0 - 1;
}

pub fn moore_read_pfaffian_shift() -> Int {
    return 3;
}
