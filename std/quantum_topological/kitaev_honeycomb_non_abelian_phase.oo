// # Kitaev Honeycomb Non-Abelian Phase & Chiral Majorana Modes
//
// Logline: Models time-reversal breaking 3-spin interaction kappa, chiral Majorana gap opening, Chern number nu = +/-1, and Ising anyons.
//
// Setup: Non-Abelian topological phase in Kitaev spin liquids driven by magnetic field perturbations and hosting c=1/2 chiral edge modes.
//
// Beats:
//   1. Compute effective 3-spin interaction strength kappa ~ h_x h_y h_z / J^2.
//   2. Calculate topological Chern number nu = sgn(kappa) = +/-1 for Majorana bands.
//   3. Model non-Abelian Ising anyon statistics bound to pi-flux vortices and chiral edge conductance.

pub type NonAbelianPhaseModel = struct {
    exchange_j: Float,
    magnetic_field_hx: Float,
    magnetic_field_hy: Float,
    magnetic_field_hz: Float,
    kappa_coupling: Float,
    chern_number: Int, // nu = +1 or -1
    chiral_central_charge: Float // c = 0.5 (Majorana fermion edge mode)
};

pub fn non_abelian_phase_new(j: Float, hx: Float, hy: Float, hz: Float) -> NonAbelianPhaseModel {
    let j2: Float = j * j;
    let h_prod: Float = hx * hy * hz;
    let kappa: Float = if j2 != 0.0 { h_prod / j2 } else { 0.0 };
    let c_num: Int = if kappa >= 0.0 { 1 } else { 0 - 1 };
    return NonAbelianPhaseModel {
        exchange_j: j,
        magnetic_field_hx: hx,
        magnetic_field_hy: hy,
        magnetic_field_hz: hz,
        kappa_coupling: kappa,
        chern_number: c_num,
        chiral_central_charge: 0.5
    };
}

pub fn non_abelian_majorana_mass_gap(model: &NonAbelianPhaseModel) -> Float {
    let kappa: Float = model.kappa_coupling;
    let abs_kappa: Float = if kappa < 0.0 { 0.0 - kappa } else { kappa };
    // Mass gap Delta_m = 6 * sqrt(3) * |kappa|
    let sqrt3: Float = sqrt(3.0);
    return 6.0 * sqrt3 * abs_kappa;
}

pub fn non_abelian_vortex_majorana_zero_mode(model: &NonAbelianPhaseModel) -> Int {
    // In the non-Abelian phase (|nu| = 1), each pi-flux vortex traps exactly one Majorana zero mode
    let nu: Int = model.chern_number;
    let abs_nu: Int = if nu < 0 { 0 - nu } else { nu };
    if abs_nu == 1 {
        return 1; // Traps a Majorana zero mode (Ising anyon sigma)
    }
    return 0;
}

pub fn non_abelian_chiral_edge_velocity(model: &NonAbelianPhaseModel) -> Float {
    // Edge velocity v_edge ~ 3 * J * a / hbar
    let j: Float = model.exchange_j;
    return 3.0 * j;
}
