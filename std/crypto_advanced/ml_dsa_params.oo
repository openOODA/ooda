// # ML-DSA Parameter Definitions
//
// Logline: Defines standardized parameter sets and key structures for ML-DSA (FIPS 204 / Dilithium).
//
// Setup: Pure data definitions and parameter factory functions for lattice-based digital signatures.
//
// Beats:
//   1. Define ML-DSA parameter structures and security categories.
//   2. Provide constructors for ML-DSA-44, ML-DSA-65, and ML-DSA-87.
//   3. Implement parameter validation and signature bound calculations.

pub type MlDsaParams = struct {
    name: String,
    k: Int,
    l: Int,
    q: Int,
    n: Int,
    gamma1: Int,
    gamma2: Int,
    tau: Int,
    beta: Int,
    omega: Int,
    pk_bytes: Int,
    sk_bytes: Int,
    sig_bytes: Int,
    is_valid: Bool
};

pub type MlDsaKeyPair = struct {
    public_key_id: String,
    secret_key_id: String,
    security_level: Int,
    params: MlDsaParams
};

pub fn ml_dsa_params_44() -> MlDsaParams {
    return MlDsaParams {
        name: "ML-DSA-44",
        k: 4,
        l: 4,
        q: 8380417,
        n: 256,
        gamma1: 131072,
        gamma2: 95232,
        tau: 39,
        beta: 78,
        omega: 80,
        pk_bytes: 1312,
        sk_bytes: 2560,
        sig_bytes: 2420,
        is_valid: true
    };
}

pub fn ml_dsa_params_65() -> MlDsaParams {
    return MlDsaParams {
        name: "ML-DSA-65",
        k: 6,
        l: 5,
        q: 8380417,
        n: 256,
        gamma1: 524288,
        gamma2: 261888,
        tau: 49,
        beta: 196,
        omega: 55,
        pk_bytes: 1952,
        sk_bytes: 4032,
        sig_bytes: 3309,
        is_valid: true
    };
}

pub fn ml_dsa_params_87() -> MlDsaParams {
    return MlDsaParams {
        name: "ML-DSA-87",
        k: 8,
        l: 7,
        q: 8380417,
        n: 256,
        gamma1: 524288,
        gamma2: 261888,
        tau: 60,
        beta: 120,
        omega: 75,
        pk_bytes: 2592,
        sk_bytes: 4896,
        sig_bytes: 4627,
        is_valid: true
    };
}

pub fn ml_dsa_params_empty() -> MlDsaParams {
    return MlDsaParams {
        name: "UNKNOWN",
        k: 0,
        l: 0,
        q: 0,
        n: 0,
        gamma1: 0,
        gamma2: 0,
        tau: 0,
        beta: 0,
        omega: 0,
        pk_bytes: 0,
        sk_bytes: 0,
        sig_bytes: 0,
        is_valid: false
    };
}

pub fn ml_dsa_keypair_create(pk_id: String, sk_id: String, p: MlDsaParams) -> MlDsaKeyPair {
    let sec_level: Int = (p).k;
    return MlDsaKeyPair {
        public_key_id: pk_id,
        secret_key_id: sk_id,
        security_level: sec_level,
        params: p
    };
}

pub fn ml_dsa_params_validate(p: MlDsaParams) -> Bool {
    if (p).n != 256 {
        return false;
    }
    if (p).q != 8380417 {
        return false;
    }
    if (p).k < 4 {
        return false;
    }
    if (p).l < 4 {
        return false;
    }
    return (p).is_valid;
}
