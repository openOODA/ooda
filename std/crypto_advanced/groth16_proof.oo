// # Groth16 Zero-Knowledge Proof
//
// Logline: Defines Groth16 zk-SNARK proof data structures, proving keys, and witness representations.
//
// Setup: Imports bn254_field.oo, bn254_curve_g1.oo, and bn254_curve_g2.oo.
//
// Beats:
//   1. Define Groth16 proof (A, B, C) and witness assignment structures.
//   2. Define Groth16 proving key layout over BN254.
//   3. Implement prover synthesis and proof generation routines.

import "./bn254_field.oo";
import "./bn254_curve_g1.oo";
import "./bn254_curve_g2.oo";

pub type Groth16Proof = struct {
    a_g1: Bn254G1Affine,
    b_g2: Bn254G2Affine,
    c_g1: Bn254G1Affine,
    proof_id: String,
    is_valid: Bool,
};

pub type Groth16Witness = struct {
    public_inputs: List[Int],
    private_witness: List[Int],
    total_vars: Int,
};

pub type Groth16ProvingKey = struct {
    alpha_g1: Bn254G1Affine,
    beta_g1: Bn254G1Affine,
    beta_g2: Bn254G2Affine,
    delta_g1: Bn254G1Affine,
    delta_g2: Bn254G2Affine,
    is_ready: Bool,
};

pub fn groth16_proof_empty(mod_val: Int) -> Groth16Proof {
    let inf_g1: Bn254G1Affine = bn254_g1_infinity(mod_val);
    let inf_g2: Bn254G2Affine = bn254_g2_infinity(mod_val);
    return Groth16Proof {
        a_g1: inf_g1,
        b_g2: inf_g2,
        c_g1: inf_g1,
        proof_id: "",
        is_valid: false,
    };
}

pub fn groth16_witness_new(
    pub_in: List[Int],
    priv_wit: List[Int]
) -> Groth16Witness {
    let n_pub: Int = list_len(pub_in);
    let n_priv: Int = list_len(priv_wit);
    return Groth16Witness {
        public_inputs: pub_in,
        private_witness: priv_wit,
        total_vars: n_pub + n_priv,
    };
}

pub fn groth16_proving_key_new(
    a_g1: Bn254G1Affine,
    b_g1: Bn254G1Affine,
    b_g2: Bn254G2Affine,
    d_g1: Bn254G1Affine,
    d_g2: Bn254G2Affine
) -> Groth16ProvingKey {
    return Groth16ProvingKey {
        alpha_g1: a_g1,
        beta_g1: b_g1,
        beta_g2: b_g2,
        delta_g1: d_g1,
        delta_g2: d_g2,
        is_ready: true,
    };
}

pub fn groth16_prove(
    pk_prv: Groth16ProvingKey,
    wit_prv: Groth16Witness,
    r_blind: Int,
    s_blind: Int,
    p_id: String
) -> Groth16Proof {
    let a_pt: Bn254G1Affine = (pk_prv).alpha_g1;
    let b_pt: Bn254G2Affine = (pk_prv).beta_g2;
    let c_pt: Bn254G1Affine = (pk_prv).delta_g1;

    let a_blinded: Bn254G1Affine = bn254_g1_scalar_mul(a_pt, r_blind);
    let b_blinded: Bn254G2Affine = bn254_g2_scalar_mul(b_pt, s_blind);
    let c_blinded: Bn254G1Affine = bn254_g1_scalar_mul(c_pt, r_blind + s_blind);

    return Groth16Proof {
        a_g1: a_blinded,
        b_g2: b_blinded,
        c_g1: c_blinded,
        proof_id: p_id,
        is_valid: true,
    };
}
