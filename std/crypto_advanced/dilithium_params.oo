// # NIST FIPS 204 ML-DSA / Dilithium Digital Signature Parameters
//
// Logline: Defines NIST FIPS 204 ML-DSA (Dilithium2, Dilithium3, Dilithium5) security parameters and signature sizes.
//
// Setup: Pure cryptographic parameter definitions for post-quantum Module-Lattice Digital Signature Algorithm.
//
// Beats:
//   1. Define DilithiumParams with matrix dimensions k, l, and infinity norm bounds gamma_1, gamma_2.
//   2. Instantiate NIST Security Category 2, 3, and 5 parameter sets.
//   3. Validate modulus q=8380417 and dropped bits d=13.

pub type DilithiumParams = struct {
    k: Int,
    l: Int,
    gamma1: Int,
    gamma2: Int,
    tau: Int,
    beta: Int,
    omega: Int,
    q: Int,
    pk_bytes: Int,
    sk_bytes: Int,
    sig_bytes: Int,
    name: String
};

/// Instantiate Dilithium2 (NIST Category 2) parameters.
pub fn dilithium_params_2() -> DilithiumParams { return DilithiumParams {
        k: 4,
        l: 4,
        gamma1: 131072,
        gamma2: 95232,
        tau: 39,
        beta: 78,
        omega: 80,
        q: 8380417,
        pk_bytes: 1312,
        sk_bytes: 2528,
        sig_bytes: 2420,
        name: "Dilithium2"
    }; }

/// Instantiate Dilithium3 (NIST Category 3) parameters.
pub fn dilithium_params_3() -> DilithiumParams { return DilithiumParams {
        k: 6,
        l: 5,
        gamma1: 524288,
        gamma2: 261888,
        tau: 49,
        beta: 196,
        omega: 55,
        q: 8380417,
        pk_bytes: 1952,
        sk_bytes: 4000,
        sig_bytes: 3293,
        name: "Dilithium3"
    }; }

/// Instantiate Dilithium5 (NIST Category 5) parameters.
pub fn dilithium_params_5() -> DilithiumParams { return DilithiumParams {
        k: 8,
        l: 7,
        gamma1: 524288,
        gamma2: 261888,
        tau: 60,
        beta: 120,
        omega: 75,
        q: 8380417,
        pk_bytes: 2592,
        sk_bytes: 4864,
        sig_bytes: 4595,
        name: "Dilithium5"
    }; }
