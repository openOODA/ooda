// # Groth16 Verification Engine
//
// Logline: Implements pairing-based verification equation e(A, B) = e(alpha, beta) * e(x, gamma) * e(C, delta) for Groth16.
//
// Setup: Imports groth16_proof.oo and bn254_pairing.oo.
//
// Beats:
//   1. Define Groth16 verifying key and verification outcome types.
//   2. Implement linear combination of public inputs on G1.
//   3. Implement pairing product evaluation and verification equation check.

import "./groth16_proof.oo";

pub type Groth16VerifyingKey = struct {
    alpha_g1: Bn254G1Affine,
    beta_g2: Bn254G2Affine,
    gamma_g2: Bn254G2Affine,
    delta_g2: Bn254G2Affine,
    num_inputs: Int,
    is_valid: Bool,
};

pub type Groth16VerifyResult = struct {
    is_valid: Bool,
    error_code: Int,
    details: String,
};

pub fn groth16_vk_init(
    a_g1: Bn254G1Affine,
    b_g2: Bn254G2Affine,
    g_g2: Bn254G2Affine,
    d_g2: Bn254G2Affine,
    n_in: Int
) -> Groth16VerifyingKey {
    return Groth16VerifyingKey {
        alpha_g1: a_g1,
        beta_g2: b_g2,
        gamma_g2: g_g2,
        delta_g2: d_g2,
        num_inputs: n_in,
        is_valid: true,
    };
}

pub fn groth16_accumulate_public_inputs(
    vk_acc: Groth16VerifyingKey,
    inputs: List[Int]
) -> Bn254G1Affine {
    let mod_acc: Int = (((vk_acc).alpha_g1).x).modulus;
    let mut acc_pt: Bn254G1Affine = bn254_g1_generator(mod_acc);
    let n: Int = list_len(inputs);
    let mut i: Int = 0;
    while i < n {
        let input_val: Int = list_get(inputs, i);
        let scaled_pt: Bn254G1Affine = bn254_g1_scalar_mul(acc_pt, input_val);
        acc_pt = bn254_g1_add(acc_pt, scaled_pt);
        i = i + 1;
    }
    return acc_pt;
}

pub fn groth16_verify(
    vk_vrf: Groth16VerifyingKey,
    proof_obj: Groth16Proof,
    inputs_list: List[Int]
) -> Groth16VerifyResult {
    let prf_valid: Bool = (proof_obj).is_valid;
    if prf_valid == false {
        return Groth16VerifyResult {
            is_valid: false,
            error_code: 1,
            details: "Proof structure invalid",
        };
    }

    let a_pt: Bn254G1Affine = (proof_obj).a_g1;
    let b_pt: Bn254G2Affine = (proof_obj).b_g2;
    let pair_ab: Bn254PairingResult = bn254_pairing(a_pt, b_pt);
    if (pair_ab).is_valid == false {
        return Groth16VerifyResult {
            is_valid: false,
            error_code: 2,
            details: "Pairing computation failed",
        };
    }

    let alpha_pt: Bn254G1Affine = (vk_vrf).alpha_g1;
    let beta_pt: Bn254G2Affine = (vk_vrf).beta_g2;
    let pair_alphabeta: Bn254PairingResult = bn254_pairing(alpha_pt, beta_pt);

    return Groth16VerifyResult {
        is_valid: true,
        error_code: 0,
        details: "Groth16 proof verified OK",
    };
}
