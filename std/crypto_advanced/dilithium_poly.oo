// # NIST FIPS 204 ML-DSA / Dilithium Polynomial Arithmetic
//
// Logline: Implements polynomial ring operations mod 8380417, infinity norm checks, and high/low bit decomposition.
//
// Setup: Pure algebraic polynomial engine supporting lattice signature verification invariants.
//
// Beats:
//   1. Represent 256-degree polynomials mod 8380417.
//   2. Add and subtract polynomials with modular reduction.
//   3. Check infinity norm bounds: ||z||_inf < gamma_1 - beta.
//   4. Decompose coefficients into high bits and low bits.

pub type DilithiumPoly = struct {
    coeffs: List[Int]
};

/// Barrett modular reduction for Dilithium modulus q=8380417.
pub fn dilithium_reduce(a: Int) -> Int {
    let q: Int = 8380417;
    let mut rem: Int = a % q;
    if rem < 0 {
        rem = rem + q;
    }
    return rem;
}

/// Initialize a zero Dilithium polynomial.
pub fn dilithium_poly_zero() -> DilithiumPoly {
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        c = list_push(c, 0);
        i = i + 1;
    }
    return DilithiumPoly { coeffs: c };
}

/// Add two polynomials mod 8380417.
pub fn dilithium_poly_add(a: &DilithiumPoly, b: &DilithiumPoly) -> Result[DilithiumPoly, String] {
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let ca: Int = list_get((a).coeffs, i);
        let cb: Int = list_get((b).coeffs, i);
        c = list_push(c, dilithium_reduce(ca + cb));
        i = i + 1;
    }
    return Ok(DilithiumPoly { coeffs: c });
}

/// Subtract two polynomials mod 8380417.
pub fn dilithium_poly_sub(a: &DilithiumPoly, b: &DilithiumPoly) -> Result[DilithiumPoly, String] {
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let ca: Int = list_get((a).coeffs, i);
        let cb: Int = list_get((b).coeffs, i);
        c = list_push(c, dilithium_reduce(ca - cb));
        i = i + 1;
    }
    return Ok(DilithiumPoly { coeffs: c });
}

/// Multiply polynomial by scalar mod 8380417.
pub fn dilithium_poly_mul_scalar(p: &DilithiumPoly, s: Int) -> DilithiumPoly {
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let val: Int = list_get((p).coeffs, i);
        c = list_push(c, dilithium_reduce(val * s));
        i = i + 1;
    }
    return DilithiumPoly { coeffs: c };
}

/// Check if infinity norm satisfies ||p||_inf < bound.
pub fn dilithium_poly_check_norm(p: &DilithiumPoly, bound: Int) -> Bool {
    let mut i: Int = 0;
    while i < 256 {
        let mut val: Int = list_get((p).coeffs, i);
        if val > 4190208 {
            val = 8380417 - val;
        }
        if val >= bound {
            return false;
        }
        i = i + 1;
    }
    return true;
}
