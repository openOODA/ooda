// # ML-KEM / Kyber Lattice Parameter Definitions
//
// Logline: Defines NIST FIPS 203 ML-KEM (Kyber-512, Kyber-768, Kyber-1024) security parameters and byte lengths.
//
// Setup: Pure cryptographic parameter definitions for post-quantum Module-Lattice Key Encapsulation Mechanism.
//
// Beats:
//   1. Define KyberParams structure with ring dimension $k$, noise parameters $\eta_1, \eta_2$, and compression factors $d_u, d_v$.
//   2. Instantiate NIST Security Category 1, 3, and 5 parameter sets.
//   3. Validate parameter invariants against NIST FIPS 203 standard modulus $q=3329$.

pub type KyberParams = struct {
    k: Int,
    eta1: Int,
    eta2: Int,
    du: Int,
    dv: Int,
    q: Int,
    pk_bytes: Int,
    sk_bytes: Int,
    ct_bytes: Int,
    ss_bytes: Int,
    name: String
};

/// Instantiate Kyber-512 (NIST Category 1) parameters.
pub fn kyber_params_512() -> KyberParams { return KyberParams {
        k: 2,
        eta1: 3,
        eta2: 2,
        du: 10,
        dv: 4,
        q: 3329,
        pk_bytes: 800,
        sk_bytes: 1632,
        ct_bytes: 768,
        ss_bytes: 32,
        name: "Kyber-512"
    }; }

/// Instantiate Kyber-768 (NIST Category 3) parameters.
pub fn kyber_params_768() -> KyberParams { return KyberParams {
        k: 3,
        eta1: 2,
        eta2: 2,
        du: 10,
        dv: 4,
        q: 3329,
        pk_bytes: 1184,
        sk_bytes: 2400,
        ct_bytes: 1088,
        ss_bytes: 32,
        name: "Kyber-768"
    }; }

/// Instantiate Kyber-1024 (NIST Category 5) parameters.
pub fn kyber_params_1024() -> KyberParams { return KyberParams {
        k: 4,
        eta1: 2,
        eta2: 2,
        du: 11,
        dv: 5,
        q: 3329,
        pk_bytes: 1568,
        sk_bytes: 3168,
        ct_bytes: 1568,
        ss_bytes: 32,
        name: "Kyber-1024"
    }; }

/// Validate parameters against NIST standards.
pub fn kyber_params_validate(params: &KyberParams) -> Result[Bool, String] {
    if (params).q != 3329 {
        return Err("ERR\tkyber_params: invalid modulus q != 3329");
    }
    if (params).k < 2 || (params).k > 4 {
        return Err("ERR\tkyber_params: invalid matrix rank k");
    }
    if (params).ss_bytes != 32 {
        return Err("ERR\tkyber_params: shared secret size must be 32 bytes");
    }
    return Ok(true);
}

pub fn kyber_params_k(p: KyberParams) -> Int {
    return p.k;
}

pub fn kyber_params_q(p: KyberParams) -> Int {
    return p.q;
}
