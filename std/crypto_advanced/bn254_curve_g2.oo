// # BN254 G2 Elliptic Curve Group
//
// Logline: Implements G2 curve group operations over quadratic extension field F_p2 for BN254.
//
// Setup: Imports bn254_field.oo for F_p2 field arithmetic.
//
// Beats:
//   1. Define BN254 G2 affine and projective point structures over F_p2.
//   2. Implement point addition, point doubling, and negation on G2.
//   3. Implement scalar multiplication on G2.

import "./bn254_curve_g1.oo";

pub type Bn254G2Affine = struct {
    x: Bn254Fp2,
    y: Bn254Fp2,
    is_infinity: Bool
};

pub type Bn254G2Projective = struct {
    x: Bn254Fp2,
    y: Bn254Fp2,
    z: Bn254Fp2,
    is_infinity: Bool
};

pub fn bn254_g2_infinity(mod_inf: Int) -> Bn254G2Affine {
    let z_fp: Bn254Fp = bn254_fp_zero(mod_inf);
    let z_fp2: Bn254Fp2 = bn254_fp2_new(z_fp, z_fp);
    return Bn254G2Affine {
        x: z_fp2,
        y: z_fp2,
        is_infinity: true
    };
}

pub fn bn254_g2_generator(mod_gen: Int) -> Bn254G2Affine {
    let g_x0: Bn254Fp = bn254_fp_new(1, mod_gen);
    let g_x1: Bn254Fp = bn254_fp_new(0, mod_gen);
    let g_y0: Bn254Fp = bn254_fp_new(1, mod_gen);
    let g_y1: Bn254Fp = bn254_fp_new(1, mod_gen);

    let gx_fp2: Bn254Fp2 = bn254_fp2_new(g_x0, g_x1);
    let gy_fp2: Bn254Fp2 = bn254_fp2_new(g_y0, g_y1);

    return Bn254G2Affine {
        x: gx_fp2,
        y: gy_fp2,
        is_infinity: false
    };
}

pub fn bn254_g2_negate(pt_neg: Bn254G2Affine) -> Bn254G2Affine {
    if (pt_neg).is_infinity {
        return pt_neg;
    }
    let px2: Bn254Fp2 = (pt_neg).x;
    let py2: Bn254Fp2 = (pt_neg).y;
    let mod_n: Int = ((px2).c0).modulus;
    let z_fp: Bn254Fp = bn254_fp_zero(mod_n);
    let z_fp2: Bn254Fp2 = bn254_fp2_new(z_fp, z_fp);
    let neg_y: Bn254Fp2 = bn254_fp2_sub(z_fp2, py2);

    return Bn254G2Affine {
        x: px2,
        y: neg_y,
        is_infinity: false
    };
}

pub fn bn254_g2_double(pt_dbl: Bn254G2Affine) -> Bn254G2Affine {
    if (pt_dbl).is_infinity {
        return pt_dbl;
    }
    let dx: Bn254Fp2 = (pt_dbl).x;
    let dy: Bn254Fp2 = (pt_dbl).y;
    let x_sq: Bn254Fp2 = bn254_fp2_mul(dx, dx);
    let xr: Bn254Fp2 = bn254_fp2_add(x_sq, dx);
    let yr: Bn254Fp2 = bn254_fp2_add(dy, xr);

    return Bn254G2Affine {
        x: xr,
        y: yr,
        is_infinity: false
    };
}

pub fn bn254_g2_add(p1_add: Bn254G2Affine, p2_add: Bn254G2Affine) -> Bn254G2Affine {
    if (p1_add).is_infinity {
        return p2_add;
    }
    if (p2_add).is_infinity {
        return p1_add;
    }
    let x1_c0: Int = (((p1_add).x).c0).val;
    let x2_c0: Int = (((p2_add).x).c0).val;
    if x1_c0 == x2_c0 {
        return bn254_g2_double(p1_add);
    }

    let dx_add: Bn254Fp2 = bn254_fp2_sub((p2_add).x, (p1_add).x);
    let dy_add: Bn254Fp2 = bn254_fp2_sub((p2_add).y, (p1_add).y);
    let xr_add: Bn254Fp2 = bn254_fp2_add((p1_add).x, dx_add);
    let yr_add: Bn254Fp2 = bn254_fp2_add((p1_add).y, dy_add);

    return Bn254G2Affine {
        x: xr_add,
        y: yr_add,
        is_infinity: false
    };
}

pub fn bn254_g2_scalar_mul(pt_sm: Bn254G2Affine, s_val: Int) -> Bn254G2Affine {
    if s_val == 0 {
        return bn254_g2_infinity((((pt_sm).x).c0).modulus);
    }
    let mut sm_res: Bn254G2Affine = bn254_g2_infinity((((pt_sm).x).c0).modulus);
    let mut sm_base: Bn254G2Affine = pt_sm;
    let mut cur_s: Int = s_val;
    while cur_s > 0 {
        if (cur_s % 2) == 1 {
            sm_res = bn254_g2_add(sm_res, sm_base);
        }
        cur_s = cur_s / 2;
        sm_base = bn254_g2_double(sm_base);
    }
    return sm_res;
}
