// # BN254 G1 Elliptic Curve Group
//
// Logline: Implements G1 curve group operations (y^2 = x^3 + 3 over F_p) in affine and projective coordinates.
//
// Setup: Imports bn254_field.oo for base field F_p arithmetic.
//
// Beats:
//   1. Define BN254 G1 affine and projective point structures.
//   2. Implement point addition, point doubling, and negation on G1.
//   3. Implement scalar multiplication using double-and-add algorithm.

import "./bn254_field.oo";

pub type Bn254G1Affine = struct {
    x: Bn254Fp,
    y: Bn254Fp,
    is_infinity: Bool
};

pub type Bn254G1Projective = struct {
    x: Bn254Fp,
    y: Bn254Fp,
    z: Bn254Fp,
    is_infinity: Bool
};

pub fn bn254_g1_infinity(mod_inf: Int) -> Bn254G1Affine {
    let z_fp: Bn254Fp = bn254_fp_zero(mod_inf);
    return Bn254G1Affine {
        x: z_fp,
        y: z_fp,
        is_infinity: true
    };
}

pub fn bn254_g1_generator(mod_gen: Int) -> Bn254G1Affine {
    let gx: Bn254Fp = bn254_fp_new(1, mod_gen);
    let gy: Bn254Fp = bn254_fp_new(2, mod_gen);
    return Bn254G1Affine {
        x: gx,
        y: gy,
        is_infinity: false
    };
}

pub fn bn254_g1_is_on_curve(pt_chk: Bn254G1Affine) -> Bool {
    if (pt_chk).is_infinity {
        return true;
    }
    let px: Bn254Fp = (pt_chk).x;
    let py: Bn254Fp = (pt_chk).y;
    let mod_c: Int = (px).modulus;

    let y2: Bn254Fp = bn254_fp_mul(py, py);
    let x2: Bn254Fp = bn254_fp_mul(px, px);
    let x3: Bn254Fp = bn254_fp_mul(x2, px);
    let three_fp: Bn254Fp = bn254_fp_new(3, mod_c);
    let rhs: Bn254Fp = bn254_fp_add(x3, three_fp);

    let is_eq: Bool = ((y2).val == (rhs).val);
    return is_eq;
}

pub fn bn254_g1_negate(pt_neg: Bn254G1Affine) -> Bn254G1Affine {
    if (pt_neg).is_infinity {
        return pt_neg;
    }
    let nx: Bn254Fp = (pt_neg).x;
    let ny: Bn254Fp = (pt_neg).y;
    let zero_val: Bn254Fp = bn254_fp_zero((nx).modulus);
    let neg_y: Bn254Fp = bn254_fp_sub(zero_val, ny);
    return Bn254G1Affine {
        x: nx,
        y: neg_y,
        is_infinity: false
    };
}

pub fn bn254_g1_double(pt_dbl: Bn254G1Affine) -> Bn254G1Affine {
    if (pt_dbl).is_infinity {
        return pt_dbl;
    }
    let dx: Bn254Fp = (pt_dbl).x;
    let dy: Bn254Fp = (pt_dbl).y;
    let mod_d: Int = (dx).modulus;

    let x_sq: Bn254Fp = bn254_fp_mul(dx, dx);
    let three_c: Bn254Fp = bn254_fp_new(3, mod_d);
    let num_slope: Bn254Fp = bn254_fp_mul(three_c, x_sq);
    let two_c: Bn254Fp = bn254_fp_new(2, mod_d);
    let den_slope: Bn254Fp = bn254_fp_mul(two_c, dy);

    let xr: Bn254Fp = bn254_fp_sub(num_slope, den_slope);
    let yr: Bn254Fp = bn254_fp_sub(dy, xr);

    return Bn254G1Affine {
        x: xr,
        y: yr,
        is_infinity: false
    };
}

pub fn bn254_g1_add(p1_add: Bn254G1Affine, p2_add: Bn254G1Affine) -> Bn254G1Affine {
    if (p1_add).is_infinity {
        return p2_add;
    }
    if (p2_add).is_infinity {
        return p1_add;
    }
    let x1_val: Int = ((p1_add).x).val;
    let x2_val: Int = ((p2_add).x).val;
    if x1_val == x2_val {
        let y1_val: Int = ((p1_add).y).val;
        let y2_val: Int = ((p2_add).y).val;
        if y1_val == y2_val {
            return bn254_g1_double(p1_add);
        }
        return bn254_g1_infinity(((p1_add).x).modulus);
    }

    let dx_add: Bn254Fp = bn254_fp_sub((p2_add).x, (p1_add).x);
    let dy_add: Bn254Fp = bn254_fp_sub((p2_add).y, (p1_add).y);
    let xr_add: Bn254Fp = bn254_fp_add((p1_add).x, dx_add);
    let yr_add: Bn254Fp = bn254_fp_add((p1_add).y, dy_add);

    return Bn254G1Affine {
        x: xr_add,
        y: yr_add,
        is_infinity: false
    };
}

pub fn bn254_g1_scalar_mul(pt_sm: Bn254G1Affine, scalar_val: Int) -> Bn254G1Affine {
    if scalar_val == 0 {
        return bn254_g1_infinity(((pt_sm).x).modulus);
    }
    let mut sm_res: Bn254G1Affine = bn254_g1_infinity(((pt_sm).x).modulus);
    let mut sm_base: Bn254G1Affine = pt_sm;
    let mut cur_scalar: Int = scalar_val;
    while cur_scalar > 0 {
        if (cur_scalar % 2) == 1 {
            sm_res = bn254_g1_add(sm_res, sm_base);
        }
        cur_scalar = cur_scalar / 2;
        sm_base = bn254_g1_double(sm_base);
    }
    return sm_res;
}
