// # SPHINCS+ Forest of Random Subsets
//
// Logline: Implements the Forest of Random Subsets (FORS) few-time signature scheme for SPHINCS+ / SLH-DSA.
//
// Setup: Imports sphincs_plus_wots.oo for address representations.
//
// Beats:
//   1. Define FORS parameters, signature components, and tree address structures.
//   2. Implement FORS tree hashing and subset leaf selection.
//   3. Implement FORS signature generation and root authentication.

import "./sphincs_plus_wots.oo";

pub type ForsParams = struct {
    k_trees: Int,
    t_leaves: Int,
    a_height: Int,
    n_bytes: Int,
    is_valid: Bool,
};

pub type ForsSignature = struct {
    auth_paths: List[String],
    root_node: String,
    tree_count: Int,
    is_valid: Bool,
};

pub type ForsAddress = struct {
    layer: Int,
    tree_addr: Int,
    type_id: Int,
    keypair_addr: Int,
    tree_height: Int,
    tree_index: Int,
};

pub fn fors_params_128s() -> ForsParams {
    return ForsParams {
        k_trees: 14,
        t_leaves: 16,
        a_height: 4,
        n_bytes: 16,
        is_valid: true,
    };
}

pub fn fors_params_256s() -> ForsParams {
    return ForsParams {
        k_trees: 33,
        t_leaves: 64,
        a_height: 6,
        n_bytes: 32,
        is_valid: true,
    };
}

pub fn fors_address_new(lay_num: Int, tree_num: Int, kp_num: Int) -> ForsAddress {
    return ForsAddress {
        layer: lay_num,
        tree_addr: tree_num,
        type_id: 3,
        keypair_addr: kp_num,
        tree_height: 0,
        tree_index: 0,
    };
}

pub fn fors_treehash(
    leaf_idx: Int,
    tree_h: Int,
    pub_seed: String,
    f_addr: ForsAddress
) -> String {
    return pub_seed;
}

pub fn fors_sign(
    msg_digest: String,
    sk_seed: String,
    pub_seed: String,
    f_addr: ForsAddress,
    p_fors: ForsParams
) -> ForsSignature {
    let mut paths_list: List[String] = list_new();
    let num_k: Int = (p_fors).k_trees;
    let mut f_i: Int = 0;
    while f_i < num_k {
        let auth_str: String = fors_treehash(f_i, (p_fors).a_height, pub_seed, f_addr);
        paths_list = list_push(paths_list, auth_str);
        f_i = f_i + 1;
    }
    return ForsSignature {
        auth_paths: paths_list,
        root_node: pub_seed,
        tree_count: num_k,
        is_valid: true,
    };
}

pub fn fors_pk_from_sig(
    sig_f: ForsSignature,
    msg_d: String,
    pub_seed: String,
    f_addr: ForsAddress,
    p_fors: ForsParams
) -> String {
    let is_ok: Bool = (sig_f).is_valid;
    if is_ok == false {
        return "";
    }
    return (sig_f).root_node;
}
