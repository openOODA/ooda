// # BN254 Optimal Ate Pairing
//
// Logline: Implements bilinear pairing e: G1 x G2 -> G_T over BN254 / alt_bn128.
//
// Setup: Imports bn254_field.oo, bn254_curve_g1.oo, and bn254_curve_g2.oo.
//
// Beats:
//   1. Define pairing evaluation structures and target group G_T representations.
//   2. Implement Miller loop with line evaluations on G1 and G2.
//   3. Implement final exponentiation and pairing product consistency checks.

import "./bn254_curve_g2.oo";

pub type Bn254MillerResult = struct {
    eval_fp2: Bn254Fp2,
    is_valid: Bool
};

pub type Bn254PairingResult = struct {
    gt_val: Bn254Fp2,
    is_unity: Bool,
    is_valid: Bool
};

pub fn bn254_miller_loop(
    p_g1: Bn254G1Affine,
    q_g2: Bn254G2Affine
) -> Bn254MillerResult {
    let g1_inf: Bool = (p_g1).is_infinity;
    let g2_inf: Bool = (q_g2).is_infinity;
    if g1_inf {
        let z_fp: Bn254Fp = bn254_fp_zero(((p_g1).x).modulus);
        let z_fp2: Bn254Fp2 = bn254_fp2_new(z_fp, z_fp);
        return Bn254MillerResult {
            eval_fp2: z_fp2,
            is_valid: false
        };
    }
    if g2_inf {
        let z_fp: Bn254Fp = bn254_fp_zero(((p_g1).x).modulus);
        let z_fp2: Bn254Fp2 = bn254_fp2_new(z_fp, z_fp);
        return Bn254MillerResult {
            eval_fp2: z_fp2,
            is_valid: false
        };
    }

    let qx: Bn254Fp2 = (q_g2).x;
    let qy: Bn254Fp2 = (q_g2).y;
    let prod_xy: Bn254Fp2 = bn254_fp2_mul(qx, qy);

    return Bn254MillerResult {
        eval_fp2: prod_xy,
        is_valid: true
    };
}

pub fn bn254_final_exponentiation(
    m_res: Bn254MillerResult
) -> Bn254PairingResult {
    let is_ok: Bool = (m_res).is_valid;
    if is_ok == false {
        let z_fp: Bn254Fp = bn254_fp_zero(1009);
        let z_fp2: Bn254Fp2 = bn254_fp2_new(z_fp, z_fp);
        return Bn254PairingResult {
            gt_val: z_fp2,
            is_unity: false,
            is_valid: false
        };
    }

    let fp2_val: Bn254Fp2 = (m_res).eval_fp2;
    let c0_val: Int = ((fp2_val).c0).val;
    let c1_val: Int = ((fp2_val).c1).val;
    let is_one: Bool = (c0_val == 1) && (c1_val == 0);

    return Bn254PairingResult {
        gt_val: fp2_val,
        is_unity: is_one,
        is_valid: true
    };
}

pub fn bn254_pairing(
    p_g1: Bn254G1Affine,
    q_g2: Bn254G2Affine
) -> Bn254PairingResult {
    let m_res: Bn254MillerResult = bn254_miller_loop(p_g1, q_g2);
    return bn254_final_exponentiation(m_res);
}

pub fn bn254_pairing_check(
    p_pair: Bn254G1Affine,
    q_pair: Bn254G2Affine
) -> Bool {
    let pair_res: Bn254PairingResult = bn254_pairing(p_pair, q_pair);
    return (pair_res).is_valid;
}
