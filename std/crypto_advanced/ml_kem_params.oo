// # ML-KEM Parameter Definitions
//
// Logline: Defines standardized parameter sets and metadata for ML-KEM post-quantum key encapsulation.
//
// Setup: Pure data definitions and parameter factory functions according to FIPS 203.
//
// Beats:
//   1. Define ML-KEM parameter structures and key representation types.
//   2. Provide constructors for ML-KEM-512, ML-KEM-768, and ML-KEM-1024.
//   3. Implement parameter validation and size computation routines.

pub type MlKemParams = struct {
    name: String,
    k: Int,
    q: Int,
    n: Int,
    eta1: Int,
    eta2: Int,
    du: Int,
    dv: Int,
    pk_bytes: Int,
    sk_bytes: Int,
    ct_bytes: Int,
    ss_bytes: Int,
    is_valid: Bool
};

pub type MlKemKeyPair = struct {
    public_key_id: String,
    secret_key_id: String,
    security_category: Int,
    params: MlKemParams
};

pub fn ml_kem_params_512() -> MlKemParams {
    return MlKemParams {
        name: "ML-KEM-512",
        k: 2,
        q: 3329,
        n: 256,
        eta1: 3,
        eta2: 2,
        du: 10,
        dv: 4,
        pk_bytes: 800,
        sk_bytes: 1632,
        ct_bytes: 768,
        ss_bytes: 32,
        is_valid: true
    };
}

pub fn ml_kem_params_768() -> MlKemParams {
    return MlKemParams {
        name: "ML-KEM-768",
        k: 3,
        q: 3329,
        n: 256,
        eta1: 2,
        eta2: 2,
        du: 10,
        dv: 4,
        pk_bytes: 1184,
        sk_bytes: 2400,
        ct_bytes: 1088,
        ss_bytes: 32,
        is_valid: true
    };
}

pub fn ml_kem_params_1024() -> MlKemParams {
    return MlKemParams {
        name: "ML-KEM-1024",
        k: 4,
        q: 3329,
        n: 256,
        eta1: 2,
        eta2: 2,
        du: 11,
        dv: 5,
        pk_bytes: 1568,
        sk_bytes: 3168,
        ct_bytes: 1568,
        ss_bytes: 32,
        is_valid: true
    };
}

pub fn ml_kem_params_empty() -> MlKemParams {
    return MlKemParams {
        name: "UNKNOWN",
        k: 0,
        q: 0,
        n: 0,
        eta1: 0,
        eta2: 0,
        du: 0,
        dv: 0,
        pk_bytes: 0,
        sk_bytes: 0,
        ct_bytes: 0,
        ss_bytes: 0,
        is_valid: false
    };
}

pub fn ml_kem_keypair_create(pk_id: String, sk_id: String, p: MlKemParams) -> MlKemKeyPair {
    let cat: Int = p.k;
    return MlKemKeyPair {
        public_key_id: pk_id,
        secret_key_id: sk_id,
        security_category: cat,
        params: p
    };
}

pub fn ml_kem_params_validate(p: MlKemParams) -> Bool {
    if p.n != 256 {
        return false;
    }
    if p.q != 3329 {
        return false;
    }
    if p.k < 2 {
        return false;
    }
    if p.k > 4 {
        return false;
    }
    if p.ss_bytes != 32 {
        return false;
    }
    return p.is_valid;
}
