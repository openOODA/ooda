// # Advanced Cryptography Facade
//
// Logline: Re-exports Post-Quantum Cryptography and Zero-Knowledge Proof primitives, schemes, and verification engines.
//
// Setup: Pure module shim importing companion advanced cryptography submodules.
//
// Beats:
//   1. Import ML-KEM, ML-DSA, Falcon, SPHINCS+, BN254, Groth16, Merkle ZK, Poseidon, Rescue, and Bulletproofs modules.
//   2. Re-export typed public shim markers for post-quantum and zero-knowledge subsystems.
//   3. Maintain unified entry points for advanced cryptography consumers.

import "./ml_kem_params.oo";
import "./ml_kem_poly.oo";
import "./ml_kem_ntt.oo";
import "./ml_kem_encapsulate.oo";
import "./ml_dsa_params.oo";
import "./ml_dsa_polyvec.oo";
import "./ml_dsa_sign.oo";
import "./ml_dsa_verify.oo";
import "./falcon_fft.oo";
import "./falcon_sign.oo";
import "./sphincs_plus_wots.oo";
import "./sphincs_plus_fors.oo";
import "./bn254_field.oo";
import "./bn254_curve_g1.oo";
import "./bn254_curve_g2.oo";
import "./bn254_pairing.oo";
import "./groth16_proof.oo";
import "./groth16_verifier.oo";
import "./merkle_tree_zk.oo";
import "./poseidon_hash.oo";
import "./rescue_prime_hash.oo";
import "./bulletproofs_inner_product.oo";
import "./bulletproofs_range_proof.oo";
import "./crypto_pq_stubs.oo";

pub fn crypto_advanced_ml_kem_params_default() -> MlKemParams {
    return ml_kem_params_768();
}

pub fn crypto_advanced_ml_kem_poly_zero() -> MlKemPoly {
    return ml_kem_poly_zero();
}

pub fn crypto_advanced_ml_kem_ntt_ctx() -> MlKemNttContext {
    return ml_kem_ntt_context_init();
}

pub fn crypto_advanced_ml_dsa_params_default() -> MlDsaParams {
    return ml_dsa_params_65();
}

pub fn crypto_advanced_falcon_params_default() -> FalconParams {
    return falcon_params_512();
}

pub fn crypto_advanced_wots_params_default() -> WotsParams {
    return wots_params_16_128();
}

pub fn crypto_advanced_fors_params_default() -> ForsParams {
    return fors_params_128s();
}

pub fn crypto_advanced_bn254_fp_zero() -> Bn254Fp {
    return bn254_fp_zero(1009);
}

pub fn crypto_advanced_bn254_g1_gen() -> Bn254G1Affine {
    return bn254_g1_generator(1009);
}

pub fn crypto_advanced_bn254_g2_gen() -> Bn254G2Affine {
    return bn254_g2_generator(1009);
}

pub fn crypto_advanced_groth16_proof_empty() -> Groth16Proof {
    return groth16_proof_empty(1009);
}

pub fn crypto_advanced_merkle_zk_new() -> MerkleZkTree {
    return merkle_zk_tree_new(16, "ROOT_ZERO");
}

pub fn crypto_advanced_poseidon_params() -> PoseidonParams {
    return poseidon_params_t3(1009);
}

pub fn crypto_advanced_rescue_prime_params() -> RescuePrimeParams {
    return rescue_prime_params_default(1009);
}

pub fn crypto_advanced_bulletproofs_ipa_cfg() -> BulletproofsIpaConfig {
    return bulletproofs_ipa_config_new(64, 1009);
}

pub fn crypto_advanced_bulletproofs_range_prover() -> BulletproofsRangeProver {
    return bulletproofs_range_prover_init(64, 1009);
}

pub fn crypto_advanced_security_policy() -> CryptoPqPolicy {
    return crypto_pq_policy_high_assurance();
}
