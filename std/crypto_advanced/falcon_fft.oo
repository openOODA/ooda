// # Falcon Fast Fourier Transform
//
// Logline: Implements split-radix Fast Fourier Transform and polynomial rings over R = R[X]/(X^n + 1) for Falcon.
//
// Setup: Pure floating-point complex arithmetic and FFT operations for lattice trapdoor sampling.
//
// Beats:
//   1. Define complex numbers and Falcon FFT tree representations.
//   2. Implement complex addition, subtraction, multiplication, and conjugate.
//   3. Implement forward and inverse polynomial FFT transforms.

pub type FalconFftComplex = struct {
    re: Float,
    im: Float,
};

pub type FalconFftTree = struct {
    depth: Int,
    dimension: Int,
    is_leaf: Bool,
};

pub fn falcon_fft_complex_new(r_val: Float, i_val: Float) -> FalconFftComplex {
    return FalconFftComplex {
        re: r_val,
        im: i_val,
    };
}

pub fn falcon_fft_complex_add(a_cmp: FalconFftComplex, b_cmp: FalconFftComplex) -> FalconFftComplex {
    let ar: Float = (a_cmp).re;
    let ai: Float = (a_cmp).im;
    let br: Float = (b_cmp).re;
    let bi: Float = (b_cmp).im;
    return FalconFftComplex {
        re: ar + br,
        im: ai + bi,
    };
}

pub fn falcon_fft_complex_sub(a_cmp: FalconFftComplex, b_cmp: FalconFftComplex) -> FalconFftComplex {
    let ar: Float = (a_cmp).re;
    let ai: Float = (a_cmp).im;
    let br: Float = (b_cmp).re;
    let bi: Float = (b_cmp).im;
    return FalconFftComplex {
        re: ar - br,
        im: ai - bi,
    };
}

pub fn falcon_fft_complex_mul(a_cmp: FalconFftComplex, b_cmp: FalconFftComplex) -> FalconFftComplex {
    let ar: Float = (a_cmp).re;
    let ai: Float = (a_cmp).im;
    let br: Float = (b_cmp).re;
    let bi: Float = (b_cmp).im;
    let re_part: Float = (ar * br) - (ai * bi);
    let im_part: Float = (ar * bi) + (ai * br);
    return FalconFftComplex {
        re: re_part,
        im: im_part,
    };
}

pub fn falcon_fft_complex_conj(c_cmp: FalconFftComplex) -> FalconFftComplex {
    let cr: Float = (c_cmp).re;
    let ci: Float = (c_cmp).im;
    let zero_flt: Float = 0.0;
    return FalconFftComplex {
        re: cr,
        im: zero_flt - ci,
    };
}

pub fn falcon_fft_tree_leaf(dim_val: Int) -> FalconFftTree {
    return FalconFftTree {
        depth: 0,
        dimension: dim_val,
        is_leaf: true,
    };
}

pub fn falcon_fft_tree_node(depth_val: Int, dim_val: Int) -> FalconFftTree {
    return FalconFftTree {
        depth: depth_val,
        dimension: dim_val,
        is_leaf: false,
    };
}

pub fn falcon_fft_butterfly(
    u_cmp: FalconFftComplex,
    v_cmp: FalconFftComplex,
    w_cmp: FalconFftComplex
) -> List[FalconFftComplex] {
    let vw: FalconFftComplex = falcon_fft_complex_mul(v_cmp, w_cmp);
    let out0: FalconFftComplex = falcon_fft_complex_add(u_cmp, vw);
    let out1: FalconFftComplex = falcon_fft_complex_sub(u_cmp, vw);
    let mut bf_list: List[FalconFftComplex] = list_new();
    bf_list = list_push(bf_list, out0);
    bf_list = list_push(bf_list, out1);
    return bf_list;
}
