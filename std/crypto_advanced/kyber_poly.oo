// # ML-KEM / Kyber Polynomial Ring Arithmetic
//
// Logline: Implements polynomial ring arithmetic over R_q = Z_q[X]/(X^256+1) with q=3329 and Barrett reduction.
//
// Setup: Pure algebraic polynomial engine with constant-time modular arithmetic and coefficient compression.
//
// Beats:
//   1. Represent 256-degree polynomials with coefficients modulo 3329.
//   2. Execute Barrett modular reduction ensuring positive standard representatives in [0, 3328].
//   3. Compute coefficient-wise polynomial addition, subtraction, and scalar multiplication.
//   4. Compress and decompress polynomial coefficients across bit depths d_u and d_v.

pub type KyberPoly = struct {
    coeffs: List[Int],
    is_ntt: Bool
};

/// Barrett modular reduction for modulus q=3329.
pub fn kyber_barrett_reduce(a: Int) -> Int {
    let q: Int = 3329;
    let mut rem: Int = a % q;
    if rem < 0 {
        rem = rem + q;
    }
    return rem;
}

/// Initialize a zero polynomial with 256 zero coefficients.
pub fn kyber_poly_zero() -> KyberPoly {
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        c = list_push(c, 0);
        i = i + 1;
    }
    return KyberPoly {
        coeffs: c,
        is_ntt: false
    };
}

/// Create polynomial from coefficient list with modulus normalization.
pub fn kyber_poly_from_list(raw_coeffs: List[Int]) -> Result[KyberPoly, String] {
    let n: Int = list_len(raw_coeffs);
    if n != 256 {
        return Err("ERR\tkyber_poly: coefficient list length must be exactly 256");
    }
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let val: Int = list_get(raw_coeffs, i);
        c = list_push(c, kyber_barrett_reduce(val));
        i = i + 1;
    }
    return Ok(KyberPoly {
        coeffs: c,
        is_ntt: false
    });
}

/// Add two polynomials coefficient-wise modulo 3329.
pub fn kyber_poly_add(a: &KyberPoly, b: &KyberPoly) -> Result[KyberPoly, String] {
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let ca: Int = list_get((a).coeffs, i);
        let cb: Int = list_get((b).coeffs, i);
        let sum: Int = kyber_barrett_reduce(ca + cb);
        c = list_push(c, sum);
        i = i + 1;
    }
    return Ok(KyberPoly {
        coeffs: c,
        is_ntt: (a).is_ntt
    });
}

/// Subtract two polynomials coefficient-wise modulo 3329.
pub fn kyber_poly_sub(a: &KyberPoly, b: &KyberPoly) -> Result[KyberPoly, String] {
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let ca: Int = list_get((a).coeffs, i);
        let cb: Int = list_get((b).coeffs, i);
        let diff: Int = kyber_barrett_reduce(ca - cb + 3329);
        c = list_push(c, diff);
        i = i + 1;
    }
    return Ok(KyberPoly {
        coeffs: c,
        is_ntt: (a).is_ntt
    });
}

/// Compress polynomial coefficients to d bits.
pub fn kyber_poly_compress(p: &KyberPoly, d: Int) -> Result[KyberPoly, String] {
    if d <= 0 || d > 12 {
        return Err("ERR\tkyber_compress: invalid bit depth d");
    }
    let mask: Int = (1 << d) - 1;
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let coeff: Int = list_get((p).coeffs, i);
        let comp: Int = (((coeff << d) + 1664) / 3329) & mask;
        c = list_push(c, comp);
        i = i + 1;
    }
    return Ok(KyberPoly {
        coeffs: c,
        is_ntt: false
    });
}

/// Decompress polynomial coefficients from d bits back to modulus 3329.
pub fn kyber_poly_decompress(p: &KyberPoly, d: Int) -> Result[KyberPoly, String] {
    if d <= 0 || d > 12 {
        return Err("ERR\tkyber_decompress: invalid bit depth d");
    }
    let mut c: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let coeff: Int = list_get((p).coeffs, i);
        let decomp: Int = ((coeff * 3329) + (1 << (d - 1))) >> d;
        c = list_push(c, kyber_barrett_reduce(decomp));
        i = i + 1;
    }
    return Ok(KyberPoly {
        coeffs: c,
        is_ntt: false
    });
}
