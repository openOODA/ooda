// # BN254 Finite Field Arithmetic
//
// Logline: Implements base field F_p and quadratic extension field F_p2 arithmetic for BN254 / alt_bn128.
//
// Setup: Pure arithmetic algorithms for prime field modulus and algebraic extensions.
//
// Beats:
//   1. Define F_p and F_p2 element structures.
//   2. Implement field addition, subtraction, multiplication, and modular inverse for F_p.
//   3. Implement quadratic extension F_p2 arithmetic with non-residue reduction.

pub type Bn254Fp = struct {
    val: Int,
    modulus: Int,
};

pub type Bn254Fp2 = struct {
    c0: Bn254Fp,
    c1: Bn254Fp,
};

pub fn bn254_fp_new(v_num: Int, mod_num: Int) -> Bn254Fp {
    let mut v_mod: Int = v_num % mod_num;
    if v_mod < 0 {
        v_mod = v_mod + mod_num;
    }
    return Bn254Fp {
        val: v_mod,
        modulus: mod_num,
    };
}

pub fn bn254_fp_zero(mod_z: Int) -> Bn254Fp {
    return Bn254Fp {
        val: 0,
        modulus: mod_z,
    };
}

pub fn bn254_fp_one(mod_o: Int) -> Bn254Fp {
    return Bn254Fp {
        val: 1,
        modulus: mod_o,
    };
}

pub fn bn254_fp_add(a_fp: Bn254Fp, b_fp: Bn254Fp) -> Bn254Fp {
    let mod_val: Int = (a_fp).modulus;
    let sum_val: Int = ((a_fp).val + (b_fp).val) % mod_val;
    return Bn254Fp {
        val: sum_val,
        modulus: mod_val,
    };
}

pub fn bn254_fp_sub(a_fp: Bn254Fp, b_fp: Bn254Fp) -> Bn254Fp {
    let mod_val: Int = (a_fp).modulus;
    let mut diff_val: Int = ((a_fp).val - (b_fp).val) % mod_val;
    if diff_val < 0 {
        diff_val = diff_val + mod_val;
    }
    return Bn254Fp {
        val: diff_val,
        modulus: mod_val,
    };
}

pub fn bn254_fp_mul(a_fp: Bn254Fp, b_fp: Bn254Fp) -> Bn254Fp {
    let mod_val: Int = (a_fp).modulus;
    let prod_val: Int = ((a_fp).val * (b_fp).val) % mod_val;
    return Bn254Fp {
        val: prod_val,
        modulus: mod_val,
    };
}

pub fn bn254_fp_mod_pow(base_fp: Bn254Fp, exp_val: Int) -> Bn254Fp {
    let mod_val: Int = (base_fp).modulus;
    let mut cur_res: Int = 1;
    let mut cur_base: Int = (base_fp).val;
    let mut cur_exp: Int = exp_val;
    while cur_exp > 0 {
        if (cur_exp % 2) == 1 {
            cur_res = (cur_res * cur_base) % mod_val;
        }
        cur_exp = cur_exp / 2;
        cur_base = (cur_base * cur_base) % mod_val;
    }
    return Bn254Fp {
        val: cur_res,
        modulus: mod_val,
    };
}

pub fn bn254_fp2_new(c0_fp: Bn254Fp, c1_fp: Bn254Fp) -> Bn254Fp2 {
    return Bn254Fp2 {
        c0: c0_fp,
        c1: c1_fp,
    };
}

pub fn bn254_fp2_add(a_fp2: Bn254Fp2, b_fp2: Bn254Fp2) -> Bn254Fp2 {
    let sum_c0: Bn254Fp = bn254_fp_add((a_fp2).c0, (b_fp2).c0);
    let sum_c1: Bn254Fp = bn254_fp_add((a_fp2).c1, (b_fp2).c1);
    return Bn254Fp2 {
        c0: sum_c0,
        c1: sum_c1,
    };
}

pub fn bn254_fp2_sub(a_fp2: Bn254Fp2, b_fp2: Bn254Fp2) -> Bn254Fp2 {
    let sub_c0: Bn254Fp = bn254_fp_sub((a_fp2).c0, (b_fp2).c0);
    let sub_c1: Bn254Fp = bn254_fp_sub((a_fp2).c1, (b_fp2).c1);
    return Bn254Fp2 {
        c0: sub_c0,
        c1: sub_c1,
    };
}

pub fn bn254_fp2_mul(a_fp2: Bn254Fp2, b_fp2: Bn254Fp2) -> Bn254Fp2 {
    let a0: Bn254Fp = (a_fp2).c0;
    let a1: Bn254Fp = (a_fp2).c1;
    let b0: Bn254Fp = (b_fp2).c0;
    let b1: Bn254Fp = (b_fp2).c1;

    let v0: Bn254Fp = bn254_fp_mul(a0, b0);
    let v1: Bn254Fp = bn254_fp_mul(a1, b1);

    let sum_a: Bn254Fp = bn254_fp_add(a0, a1);
    let sum_b: Bn254Fp = bn254_fp_add(b0, b1);
    let v_cross: Bn254Fp = bn254_fp_mul(sum_a, sum_b);
    let v_cross_sub: Bn254Fp = bn254_fp_sub(v_cross, v0);
    let res_c1: Bn254Fp = bn254_fp_sub(v_cross_sub, v1);
    let res_c0: Bn254Fp = bn254_fp_sub(v0, v1);

    return Bn254Fp2 {
        c0: res_c0,
        c1: res_c1,
    };
}
