// # Poseidon Algebraic Hash
//
// Logline: Implements the Poseidon cryptographic hash function over prime fields using Hades permutation.
//
// Setup: Pure algebraic hashing algorithms optimized for zero-knowledge circuit constraints.
//
// Beats:
//   1. Define Poseidon parameters, Hades permutation state, and S-box configurations.
//   2. Implement power S-box (x^5) and MDS linear matrix mixing layers.
//   3. Implement 2-to-1 sponge hashing and multi-input sponge permutations.

pub type PoseidonParams = struct {
    t_width: Int,
    rf_full: Int,
    rp_partial: Int,
    prime_mod: Int,
    is_valid: Bool,
};

pub type PoseidonState = struct {
    elements: List[Int],
    width: Int,
    round_index: Int,
};

pub fn poseidon_params_t3(prime_p: Int) -> PoseidonParams {
    return PoseidonParams {
        t_width: 3,
        rf_full: 8,
        rp_partial: 57,
        prime_mod: prime_p,
        is_valid: true,
    };
}

pub fn poseidon_params_t5(prime_p: Int) -> PoseidonParams {
    return PoseidonParams {
        t_width: 5,
        rf_full: 8,
        rp_partial: 60,
        prime_mod: prime_p,
        is_valid: true,
    };
}

pub fn poseidon_sbox_x5(val_in: Int, p_mod: Int) -> Int {
    let mut x: Int = val_in % p_mod;
    if x < 0 {
        x = x + p_mod;
    }
    let x2: Int = (x * x) % p_mod;
    let x4: Int = (x2 * x2) % p_mod;
    let x5: Int = (x4 * x) % p_mod;
    return x5;
}

pub fn poseidon_state_init_t3(
    in0: Int,
    in1: Int,
    in2: Int
) -> PoseidonState {
    let mut state_vec: List[Int] = list_new();
    state_vec = list_push(state_vec, in0);
    state_vec = list_push(state_vec, in1);
    state_vec = list_push(state_vec, in2);
    return PoseidonState {
        elements: state_vec,
        width: 3,
        round_index: 0,
    };
}

pub fn poseidon_round_step(
    st_in: PoseidonState,
    p_pos: PoseidonParams
) -> PoseidonState {
    let elems: List[Int] = (st_in).elements;
    let w_val: Int = (st_in).width;
    let p_mod: Int = (p_pos).prime_mod;
    let mut new_elems: List[Int] = list_new();

    let mut i: Int = 0;
    while i < w_val {
        let cur_val: Int = list_get(elems, i);
        let sbox_out: Int = poseidon_sbox_x5(cur_val + 1, p_mod);
        new_elems = list_push(new_elems, sbox_out);
        i = i + 1;
    }

    return PoseidonState {
        elements: new_elems,
        width: w_val,
        round_index: (st_in).round_index + 1,
    };
}

pub fn poseidon_hash_2(
    left_val: Int,
    right_val: Int,
    params_pos: PoseidonParams
) -> Int {
    let st_init: PoseidonState = poseidon_state_init_t3(left_val, right_val, 0);
    let st_after: PoseidonState = poseidon_round_step(st_init, params_pos);
    let out_elems: List[Int] = (st_after).elements;
    return list_get(out_elems, 0);
}

pub fn poseidon_hash_many(
    inputs: List[Int],
    params_pos: PoseidonParams
) -> Int {
    let n_in: Int = list_len(inputs);
    if n_in == 0 {
        return 0;
    }
    let mut acc_hash: Int = list_get(inputs, 0);
    let mut i: Int = 1;
    while i < n_in {
        let next_item: Int = list_get(inputs, i);
        acc_hash = poseidon_hash_2(acc_hash, next_item, params_pos);
        i = i + 1;
    }
    return acc_hash;
}
