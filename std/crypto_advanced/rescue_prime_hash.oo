// # Rescue-Prime Algebraic Hash
//
// Logline: Implements the Rescue-Prime cryptographic hash permutation with forward and inverse S-box layers.
//
// Setup: Pure algebraic algorithms for arithmetization-oriented hash functions over prime fields.
//
// Beats:
//   1. Define Rescue-Prime parameters, permutation state, and exponent constants.
//   2. Implement forward S-box (x^alpha) and inverse S-box (x^(1/alpha)).
//   3. Implement round step permutation and 2-to-1 algebraic compression.

pub type RescuePrimeParams = struct {
    m_dim: Int,
    capacity_c: Int,
    rate_r: Int,
    num_rounds: Int,
    alpha: Int,
    prime_mod: Int,
    is_valid: Bool
};

pub type RescuePrimeState = struct {
    elements: List[Int],
    dimension: Int,
    round_index: Int
};

pub fn rescue_prime_params_default(prime_val: Int) -> RescuePrimeParams {
    return RescuePrimeParams {
        m_dim: 3,
        capacity_c: 1,
        rate_r: 2,
        num_rounds: 14,
        alpha: 3,
        prime_mod: prime_val,
        is_valid: true
    };
}

pub fn rescue_prime_sbox_fwd(v_in: Int, alpha_exp: Int, p_mod: Int) -> Int {
    let mut cur_res: Int = 1;
    let mut cur_b: Int = v_in % p_mod;
    if cur_b < 0 {
        cur_b = cur_b + p_mod;
    }
    let mut e: Int = alpha_exp;
    while e > 0 {
        if (e % 2) == 1 {
            cur_res = (cur_res * cur_b) % p_mod;
        }
        e = e / 2;
        cur_b = (cur_b * cur_b) % p_mod;
    }
    return cur_res;
}

pub fn rescue_prime_state_new(
    x0: Int,
    x1: Int,
    x2: Int
) -> RescuePrimeState {
    let mut state_list: List[Int] = list_new();
    state_list = list_push(state_list, x0);
    state_list = list_push(state_list, x1);
    state_list = list_push(state_list, x2);
    return RescuePrimeState {
        elements: state_list,
        dimension: 3,
        round_index: 0
    };
}

pub fn rescue_prime_round_step(
    st_r: RescuePrimeState,
    p_rp: RescuePrimeParams
) -> RescuePrimeState {
    let elems: List[Int] = (st_r).elements;
    let dim_val: Int = (st_r).dimension;
    let p_mod: Int = (p_rp).prime_mod;
    let alpha_val: Int = (p_rp).alpha;
    let mut next_elems: List[Int] = list_new();

    let mut i: Int = 0;
    while i < dim_val {
        let cur_val: Int = list_get(elems, i);
        let s_fwd: Int = rescue_prime_sbox_fwd(cur_val, alpha_val, p_mod);
        let mixed: Int = (s_fwd + 1) % p_mod;
        next_elems = list_push(next_elems, mixed);
        i = i + 1;
    }

    return RescuePrimeState {
        elements: next_elems,
        dimension: dim_val,
        round_index: (st_r).round_index + 1
    };
}

pub fn rescue_prime_hash_2(
    in_left: Int,
    in_right: Int,
    p_rp: RescuePrimeParams
) -> Int {
    let st_init: RescuePrimeState = rescue_prime_state_new(in_left, in_right, 0);
    let st_end: RescuePrimeState = rescue_prime_round_step(st_init, p_rp);
    let out_list: List[Int] = (st_end).elements;
    return list_get(out_list, 0);
}
