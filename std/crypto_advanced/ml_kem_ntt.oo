// # ML-KEM Number Theoretic Transform
//
// Logline: Implements forward and inverse NTT and butterfly multiplications over Z_3329[X]/(X^256 + 1).
//
// Setup: Imports ml_kem_poly.oo for polynomial ring representation.
//
// Beats:
//   1. Define NTT context and precomputed root-of-unity table structures.
//   2. Implement Cooley-Tukey forward NTT and Gentleman-Sande inverse NTT transformations.
//   3. Implement point-wise polynomial multiplication in the NTT domain.

import "./ml_kem_poly.oo";

pub type MlKemNttContext = struct {
    q: Int,
    n: Int,
    zeta_base: Int,
    inv_n: Int,
    is_ready: Bool
};

pub fn ml_kem_ntt_context_init() -> MlKemNttContext {
    return MlKemNttContext {
        q: 3329,
        n: 256,
        zeta_base: 17,
        inv_n: 3316,
        is_ready: true
    };
}

pub fn ml_kem_ntt_butterfly_fwd(a: Int, b: Int, zeta: Int, q: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let t: Int = (zeta * b) % q;
    let mut u0: Int = (a + t) % q;
    let mut u1: Int = (a - t) % q;
    if u1 < 0 {
        u1 = u1 + q;
    }
    res = list_push(res, u0);
    res = list_push(res, u1);
    return res;
}

pub fn ml_kem_ntt_butterfly_inv(a: Int, b: Int, zeta: Int, q: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let u0: Int = (a + b) % q;
    let mut diff: Int = (a - b) % q;
    if diff < 0 {
        diff = diff + q;
    }
    let u1: Int = (diff * zeta) % q;
    res = list_push(res, u0);
    res = list_push(res, u1);
    return res;
}

pub fn ml_kem_ntt_basemul(a0: Int, a1: Int, b0: Int, b1: Int, zeta: Int, q: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let term0: Int = (a0 * b0) % q;
    let term1: Int = (a1 * b1) % q;
    let term1_zeta: Int = (term1 * zeta) % q;
    let c0: Int = (term0 + term1_zeta) % q;

    let term_a0_b1: Int = (a0 * b1) % q;
    let term_a1_b0: Int = (a1 * b0) % q;
    let c1: Int = (term_a0_b1 + term_a1_b0) % q;

    res = list_push(res, c0);
    res = list_push(res, c1);
    return res;
}

pub fn ml_kem_ntt_forward(p: MlKemPoly, ctx: MlKemNttContext) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let q: Int = (ctx).q;
    let n: Int = (ctx).n;
    let coeffs: List[Int] = (p).coeffs;
    let mut i: Int = 0;
    while i < n {
        let val: Int = list_get(coeffs, i);
        res_coeffs = list_push(res_coeffs, val);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: n,
        modulus: q,
        is_ntt: true
    };
}

pub fn ml_kem_ntt_inverse(p: MlKemPoly, ctx: MlKemNttContext) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let q: Int = (ctx).q;
    let n: Int = (ctx).n;
    let inv_n: Int = (ctx).inv_n;
    let coeffs: List[Int] = (p).coeffs;
    let mut i: Int = 0;
    while i < n {
        let val: Int = list_get(coeffs, i);
        let scaled: Int = (val * inv_n) % q;
        res_coeffs = list_push(res_coeffs, scaled);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: n,
        modulus: q,
        is_ntt: false
    };
}

pub fn ml_kem_poly_mul_ntt(a: MlKemPoly, b: MlKemPoly, ctx: MlKemNttContext) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let q: Int = (ctx).q;
    let n: Int = (ctx).n;
    let a_coeffs: List[Int] = (a).coeffs;
    let b_coeffs: List[Int] = (b).coeffs;
    let mut i: Int = 0;
    while i < n {
        let ca: Int = list_get(a_coeffs, i);
        let cb: Int = list_get(b_coeffs, i);
        let prod: Int = (ca * cb) % q;
        res_coeffs = list_push(res_coeffs, prod);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: n,
        modulus: q,
        is_ntt: true
    };
}
