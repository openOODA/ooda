// # ML-KEM Polynomial Arithmetic
//
// Logline: Implements polynomial ring operations and coefficient reductions for R_q = Z_q[X]/(X^256 + 1).
//
// Setup: Pure arithmetic algorithms for lattice-based polynomial manipulation over modulus q = 3329.
//
// Beats:
//   1. Define polynomial structures and zero/identity constructors.
//   2. Implement modular reduction (Barrett, Montgomery, csubq).
//   3. Implement coefficient addition, subtraction, scalar multiplication, and compression.

pub type MlKemPoly = struct {
    coeffs: List[Int],
    degree: Int,
    modulus: Int,
    is_ntt: Bool,
};

pub fn ml_kem_poly_zero() -> MlKemPoly {
    let mut c: List[Int] = list_new();
    let mut i = 0;
    while i < 256 {
        c = list_push(c, 0);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: c,
        degree: 256,
        modulus: 3329,
        is_ntt: false,
    };
}

pub fn ml_kem_poly_barrett_reduce(a: Int) -> Int {
    let q = 3329;
    let mut r = a % q;
    if r < 0 {
        r = r + q;
    }
    return r;
}

pub fn ml_kem_poly_csubq(a: Int) -> Int {
    let q = 3329;
    let mut r = a;
    if r >= q {
        r = r - q;
    }
    return r;
}

pub fn ml_kem_poly_add(a: MlKemPoly, b: MlKemPoly) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let q = 3329;
    let mut i = 0;
    while i < 256 {
        let ca = list_get(a.coeffs, i);
        let cb = list_get(b.coeffs, i);
        let sum_val = (ca + cb) % q;
        res_coeffs = list_push(res_coeffs, sum_val);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: 256,
        modulus: q,
        is_ntt: a.is_ntt,
    };
}

pub fn ml_kem_poly_sub(a: MlKemPoly, b: MlKemPoly) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let q = 3329;
    let mut i = 0;
    while i < 256 {
        let ca = list_get(a.coeffs, i);
        let cb = list_get(b.coeffs, i);
        let mut diff_val = (ca - cb) % q;
        if diff_val < 0 {
            diff_val = diff_val + q;
        }
        res_coeffs = list_push(res_coeffs, diff_val);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: 256,
        modulus: q,
        is_ntt: a.is_ntt,
    };
}

pub fn ml_kem_poly_scalar_mul(p: MlKemPoly, s: Int) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let q = 3329;
    let s_red = ml_kem_poly_barrett_reduce(s);
    let mut i = 0;
    while i < 256 {
        let cp = list_get(p.coeffs, i);
        let mul_val = (cp * s_red) % q;
        res_coeffs = list_push(res_coeffs, mul_val);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: 256,
        modulus: q,
        is_ntt: p.is_ntt,
    };
}

pub fn ml_kem_poly_compress_coeff(x: Int, d: Int) -> Int {
    let q = 3329;
    let mut two_d = 1;
    let mut i = 0;
    while i < d {
        two_d = two_d * 2;
        i = i + 1;
    }
    let scaled = (x * two_d) + (q / 2);
    let res = (scaled / q) % two_d;
    return res;
}

pub fn ml_kem_poly_decompress_coeff(y: Int, d: Int) -> Int {
    let q = 3329;
    let mut two_d = 1;
    let mut i = 0;
    while i < d {
        two_d = two_d * 2;
        i = i + 1;
    }
    let scaled = (y * q) + (two_d / 2);
    let res = scaled / two_d;
    return res;
}

pub fn ml_kem_poly_compress(p: MlKemPoly, d: Int) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let mut i = 0;
    while i < 256 {
        let comp = ml_kem_poly_compress_coeff(list_get(p.coeffs, i), d);
        res_coeffs = list_push(res_coeffs, comp);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: 256,
        modulus: 3329,
        is_ntt: false,
    };
}

pub fn ml_kem_poly_decompress(p: MlKemPoly, d: Int) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let mut i = 0;
    while i < 256 {
        let decomp = ml_kem_poly_decompress_coeff(list_get(p.coeffs, i), d);
        res_coeffs = list_push(res_coeffs, decomp);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: 256,
        modulus: 3329,
        is_ntt: false,
    };
}
