// # Ed25519 twisted Edwards
//
// Logline: Adds, doubles, and scalar-multiplies points on Ed25519 over 2^255-19 and compresses them.
//
// Setup: Pure. A field element is 16 limbs of 16 bits. A point is 64 Ints X then Y then Z then T.
//
// Beats:
//   1. Reduce field add, sub, and mul modulo 2^255-19.
//   2. Invert with a^(2^255-21) and take a square root.
//   3. Extended-coordinate add and double-and-add scalar mul.
//   4. Compress and decompress an affine point.

fn ed25519_curve_z(n: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        o = list_push(o, 0);
        i = i + 1;
    }
    return o;
}
fn ed25519_curve_n() -> List[Int] { return ed25519_curve_z(16); }
fn ed25519_curve_car(o: List[Int]) -> List[Int] {
    let mut t: List[Int] = o;
    let mut i: Int = 0;
    while i < 16 {
        let v: Int = list_get(t, i) + 65536;
        let c: Int = v >> 16;
        t = list_set(t, i, v - (c << 16));
        if i == 15 {
            t = list_set(t, 0, list_get(t, 0) + 38 * (c - 1));
        } else {
            t = list_set(t, i + 1, list_get(t, i + 1) + (c - 1));
        }
        i = i + 1;
    }
    return t;
}
fn ed25519_curve_addf(a: List[Int], b: List[Int]) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        o = list_push(o, list_get(a, i) + list_get(b, i));
        i = i + 1;
    }
    return o;
}
fn ed25519_curve_subf(a: List[Int], b: List[Int]) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        o = list_push(o, list_get(a, i) - list_get(b, i));
        i = i + 1;
    }
    return ed25519_curve_car(o);
}
fn ed25519_curve_mulf(a: List[Int], b: List[Int]) -> List[Int] {
    let mut t: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 31 {
        t = list_push(t, 0);
        i = i + 1;
    }
    i = 0;
    while i < 16 {
        let mut j: Int = 0;
        while j < 16 {
            let idx: Int = i + j;
            t = list_set(t, idx, list_get(t, idx) + list_get(a, i) * list_get(b, j));
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < 15 {
        t = list_set(t, i, list_get(t, i) + 38 * list_get(t, i + 16));
        i = i + 1;
    }
    let mut o: List[Int] = list_new();
    i = 0;
    while i < 16 {
        o = list_push(o, list_get(t, i));
        i = i + 1;
    }
    return ed25519_curve_car(ed25519_curve_car(o));
}
fn ed25519_curve_sq(a: List[Int]) -> List[Int] { return ed25519_curve_mulf(a, a); }
fn ed25519_curve_one() -> List[Int] { return list_set(ed25519_curve_n(), 0, 1); }
fn ed25519_curve_from(n: Int) -> List[Int] {
    let mut o: List[Int] = ed25519_curve_n();
    o = list_set(o, 0, n & 65535);
    return list_set(o, 1, n >> 16);
}
fn ed25519_curve_inv(a: List[Int]) -> List[Int] {
    let mut r: List[Int] = a;
    let mut i: Int = 253;
    while i >= 0 {
        r = ed25519_curve_sq(r);
        if i != 2 {
            if i != 4 { r = ed25519_curve_mulf(r, a); }
        }
        i = i - 1;
    }
    return r;
}
fn ed25519_curve_sqrt(a: List[Int]) -> List[Int] {
    let mut r: List[Int] = a;
    let mut i: Int = 250;
    while i >= 1 {
        r = ed25519_curve_sq(r);
        r = ed25519_curve_mulf(r, a);
        i = i - 1;
    }
    return ed25519_curve_sq(r);
}
fn ed25519_curve_sel(p: List[Int], part: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        o = list_push(o, list_get(p, part * 16 + i));
        i = i + 1;
    }
    return o;
}
fn ed25519_curve_put(p: List[Int], part: Int, f: List[Int]) -> List[Int] {
    let mut o: List[Int] = p;
    let mut i: Int = 0;
    while i < 16 {
        o = list_set(o, part * 16 + i, list_get(f, i));
        i = i + 1;
    }
    return o;
}
fn ed25519_curve_pt() -> List[Int] { return ed25519_curve_z(64); }
fn ed25519_curve_d() -> List[Int] {
    let mut o: List[Int] = ed25519_curve_n();
    o = list_set(o, 0, 30883);
    o = list_set(o, 1, 4953);
    o = list_set(o, 2, 19914);
    o = list_set(o, 3, 30187);
    o = list_set(o, 4, 55467);
    o = list_set(o, 5, 16705);
    o = list_set(o, 6, 2637);
    o = list_set(o, 7, 112);
    o = list_set(o, 8, 59544);
    o = list_set(o, 9, 30585);
    o = list_set(o, 10, 16505);
    o = list_set(o, 11, 36039);
    o = list_set(o, 12, 65139);
    o = list_set(o, 13, 11119);
    o = list_set(o, 14, 27886);
    return list_set(o, 15, 20995);
}
pub fn ed25519_curve_identity() -> List[Int] {
    let mut p: List[Int] = ed25519_curve_pt();
    p = list_set(p, 16, 1);
    return list_set(p, 32, 1);
}
pub fn ed25519_curve_add(p: List[Int], q: List[Int]) -> List[Int] {
    let x1: List[Int] = ed25519_curve_sel(p, 0);
    let y1: List[Int] = ed25519_curve_sel(p, 1);
    let z1: List[Int] = ed25519_curve_sel(p, 2);
    let t1: List[Int] = ed25519_curve_sel(p, 3);
    let x2: List[Int] = ed25519_curve_sel(q, 0);
    let y2: List[Int] = ed25519_curve_sel(q, 1);
    let z2: List[Int] = ed25519_curve_sel(q, 2);
    let t2: List[Int] = ed25519_curve_sel(q, 3);
    let a: List[Int] = ed25519_curve_mulf(ed25519_curve_subf(y1, x1), ed25519_curve_subf(y2, x2));
    let b: List[Int] = ed25519_curve_mulf(ed25519_curve_addf(y1, x1), ed25519_curve_addf(y2, x2));
    let two: List[Int] = ed25519_curve_from(2);
    let c: List[Int] = ed25519_curve_mulf(ed25519_curve_mulf(t1, ed25519_curve_mulf(two, ed25519_curve_d())), t2);
    let dd: List[Int] = ed25519_curve_mulf(ed25519_curve_mulf(z1, two), z2);
    let e: List[Int] = ed25519_curve_subf(b, a);
    let f: List[Int] = ed25519_curve_subf(dd, c);
    let g: List[Int] = ed25519_curve_addf(dd, c);
    let h: List[Int] = ed25519_curve_addf(b, a);
    let mut r: List[Int] = ed25519_curve_pt();
    r = ed25519_curve_put(r, 0, ed25519_curve_mulf(e, f));
    r = ed25519_curve_put(r, 1, ed25519_curve_mulf(g, h));
    r = ed25519_curve_put(r, 2, ed25519_curve_mulf(f, g));
    return ed25519_curve_put(r, 3, ed25519_curve_mulf(e, h));
}
pub fn ed25519_curve_double(p: List[Int]) -> List[Int] { return ed25519_curve_add(p, p); }
pub fn ed25519_curve_scalarmult(p: List[Int], s: Int) -> List[Int] {
    let mut q: List[Int] = ed25519_curve_identity();
    let mut i: Int = 31;
    while i >= 0 {
        q = ed25519_curve_double(q);
        if ((s >> i) & 1) == 1 { q = ed25519_curve_add(q, p); }
        i = i - 1;
    }
    return q;
}
pub fn ed25519_curve_base() -> List[Int] {
    let y: List[Int] = ed25519_curve_mulf(ed25519_curve_from(4), ed25519_curve_inv(ed25519_curve_from(5)));
    let y2: List[Int] = ed25519_curve_sq(y);
    let u: List[Int] = ed25519_curve_subf(y2, ed25519_curve_one());
    let v: List[Int] = ed25519_curve_addf(ed25519_curve_one(), ed25519_curve_mulf(ed25519_curve_d(), y2));
    let x: List[Int] = ed25519_curve_sqrt(ed25519_curve_mulf(u, ed25519_curve_inv(v)));
    let mut p: List[Int] = ed25519_curve_pt();
    p = ed25519_curve_put(p, 0, x);
    p = ed25519_curve_put(p, 1, y);
    p = ed25519_curve_put(p, 2, ed25519_curve_one());
    return ed25519_curve_put(p, 3, ed25519_curve_mulf(x, y));
}
fn ed25519_curve_packfe(f: List[Int]) -> List[Int] {
    let mut t: List[Int] = ed25519_curve_car(ed25519_curve_car(ed25519_curve_car(f)));
    let m: Int = list_get(t, 15) >> 15;
    t = list_set(t, 15, list_get(t, 15) & 32767);
    t = list_set(t, 0, list_get(t, 0) + m * 19);
    t = ed25519_curve_car(t);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        let w: Int = list_get(t, i);
        out = list_push(out, w & 255);
        out = list_push(out, (w >> 8) & 255);
        i = i + 1;
    }
    return out;
}
pub fn ed25519_curve_compress(p: List[Int]) -> Result[List[Int], String] {
    if list_len(p) != 64 { return Err("ed25519 point"); }
    let zinv: List[Int] = ed25519_curve_inv(ed25519_curve_sel(p, 2));
    let x: List[Int] = ed25519_curve_mulf(ed25519_curve_sel(p, 0), zinv);
    let y: List[Int] = ed25519_curve_mulf(ed25519_curve_sel(p, 1), zinv);
    let mut b: List[Int] = ed25519_curve_packfe(y);
    let sign: Int = list_get(ed25519_curve_packfe(x), 0) & 1;
    b = list_set(b, 31, list_get(b, 31) | (sign * 128));
    return Ok(b);
}
pub fn ed25519_curve_decompress(b: List[Int]) -> Result[List[Int], String] {
    if list_len(b) != 32 { return Err("ed25519 length"); }
    let sign: Int = (list_get(b, 31) >> 7) & 1;
    let mut y: List[Int] = ed25519_curve_n();
    let mut i: Int = 0;
    while i < 16 {
        y = list_set(y, i, list_get(b, 2 * i) + list_get(b, 2 * i + 1) * 256);
        i = i + 1;
    }
    y = list_set(y, 15, list_get(y, 15) & 32767);
    let y2: List[Int] = ed25519_curve_sq(y);
    let u: List[Int] = ed25519_curve_subf(y2, ed25519_curve_one());
    let v: List[Int] = ed25519_curve_addf(ed25519_curve_one(), ed25519_curve_mulf(ed25519_curve_d(), y2));
    let mut x: List[Int] = ed25519_curve_sqrt(ed25519_curve_mulf(u, ed25519_curve_inv(v)));
    if (list_get(ed25519_curve_packfe(x), 0) & 1) != sign {
        x = ed25519_curve_subf(ed25519_curve_n(), x);
    }
    let mut p: List[Int] = ed25519_curve_pt();
    p = ed25519_curve_put(p, 0, x);
    p = ed25519_curve_put(p, 1, y);
    p = ed25519_curve_put(p, 2, ed25519_curve_one());
    return Ok(ed25519_curve_put(p, 3, ed25519_curve_mulf(x, y)));
}
