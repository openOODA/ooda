// # ML-DSA Polynomial and Vector Operations
//
// Logline: Implements polynomial vector operations, rounding, decomposition, and hints for ML-DSA.
//
// Setup: Arithmetic algorithms over R_q = Z_8380417[X]/(X^256 + 1) for lattice signature schemes.
//
// Beats:
//   1. Define polynomial and polynomial vector structures for ML-DSA.
//   2. Implement vector addition, subtraction, and infinity-norm bounds checking.
//   3. Implement HighBits, LowBits, MakeHint, and UseHint rounding decompositions.

pub type MlDsaPoly = struct {
    coeffs: List[Int],
    degree: Int,
    modulus: Int,
};

pub type MlDsaPolyVec = struct {
    dimension: Int,
    is_valid: Bool,
};

pub fn ml_dsa_poly_zero() -> MlDsaPoly {
    let mut zero_coeffs: List[Int] = list_new();
    let mut z_i: Int = 0;
    while z_i < 256 {
        zero_coeffs = list_push(zero_coeffs, 0);
        z_i = z_i + 1;
    }
    return MlDsaPoly {
        coeffs: zero_coeffs,
        degree: 256,
        modulus: 8380417,
    };
}

pub fn ml_dsa_poly_add(poly_a: MlDsaPoly, poly_b: MlDsaPoly) -> MlDsaPoly {
    let mut add_coeffs: List[Int] = list_new();
    let q_val: Int = 8380417;
    let ac_list: List[Int] = (poly_a).coeffs;
    let bc_list: List[Int] = (poly_b).coeffs;
    let mut add_i: Int = 0;
    while add_i < 256 {
        let val_a: Int = list_get(ac_list, add_i);
        let val_b: Int = list_get(bc_list, add_i);
        let sum_val: Int = (val_a + val_b) % q_val;
        add_coeffs = list_push(add_coeffs, sum_val);
        add_i = add_i + 1;
    }
    return MlDsaPoly {
        coeffs: add_coeffs,
        degree: 256,
        modulus: q_val,
    };
}

pub fn ml_dsa_poly_sub(poly_a: MlDsaPoly, poly_b: MlDsaPoly) -> MlDsaPoly {
    let mut sub_coeffs: List[Int] = list_new();
    let q_val: Int = 8380417;
    let ac_list: List[Int] = (poly_a).coeffs;
    let bc_list: List[Int] = (poly_b).coeffs;
    let mut sub_i: Int = 0;
    while sub_i < 256 {
        let val_a: Int = list_get(ac_list, sub_i);
        let val_b: Int = list_get(bc_list, sub_i);
        let mut diff_val: Int = (val_a - val_b) % q_val;
        if diff_val < 0 {
            diff_val = diff_val + q_val;
        }
        sub_coeffs = list_push(sub_coeffs, diff_val);
        sub_i = sub_i + 1;
    }
    return MlDsaPoly {
        coeffs: sub_coeffs,
        degree: 256,
        modulus: q_val,
    };
}

pub fn ml_dsa_decompose(r_val: Int, alpha_val: Int) -> List[Int] {
    let q_val: Int = 8380417;
    let mut r_mod: Int = r_val % q_val;
    if r_mod < 0 {
        r_mod = r_mod + q_val;
    }
    let mut r0_val: Int = r_mod % alpha_val;
    let half_alpha: Int = alpha_val / 2;
    if r0_val > half_alpha {
        r0_val = r0_val - alpha_val;
    }
    let r1_val: Int = (r_mod - r0_val) / alpha_val;
    let mut decomp_out: List[Int] = list_new();
    decomp_out = list_push(decomp_out, r1_val);
    decomp_out = list_push(decomp_out, r0_val);
    return decomp_out;
}

pub fn ml_dsa_high_bits(r_hb: Int, alpha_hb: Int) -> Int {
    let hb_list: List[Int] = ml_dsa_decompose(r_hb, alpha_hb);
    return list_get(hb_list, 0);
}

pub fn ml_dsa_low_bits(r_lb: Int, alpha_lb: Int) -> Int {
    let lb_list: List[Int] = ml_dsa_decompose(r_lb, alpha_lb);
    return list_get(lb_list, 1);
}

pub fn ml_dsa_make_hint(z0_hint: Int, r_hint: Int, alpha_hint: Int) -> Int {
    let r1_h: Int = ml_dsa_high_bits(r_hint, alpha_hint);
    let v1_h: Int = ml_dsa_high_bits(r_hint + z0_hint, alpha_hint);
    if r1_h != v1_h {
        return 1;
    }
    return 0;
}

pub fn ml_dsa_use_hint(h_uh: Int, r_uh: Int, alpha_uh: Int) -> Int {
    let m_uh: Int = (8380417 - 1) / alpha_uh;
    let r1_uh: Int = ml_dsa_high_bits(r_uh, alpha_uh);
    if h_uh == 0 {
        return r1_uh;
    }
    let r0_uh: Int = ml_dsa_low_bits(r_uh, alpha_uh);
    if r0_uh > 0 {
        return (r1_uh + 1) % m_uh;
    }
    let mut ans_uh: Int = (r1_uh - 1) % m_uh;
    if ans_uh < 0 {
        ans_uh = ans_uh + m_uh;
    }
    return ans_uh;
}

pub fn ml_dsa_check_norm_bound(p_chk: MlDsaPoly, bound_val: Int) -> Bool {
    let chk_coeffs: List[Int] = (p_chk).coeffs;
    let mut chk_i: Int = 0;
    while chk_i < 256 {
        let mut coeff_item: Int = list_get(chk_coeffs, chk_i);
        if coeff_item < 0 {
            coeff_item = 0 - coeff_item;
        }
        if coeff_item >= bound_val {
            return false;
        }
        chk_i = chk_i + 1;
    }
    return true;
}
