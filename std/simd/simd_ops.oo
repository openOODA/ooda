// # SIMD Vector Operations Module
//
// Logline: Pure vector operations, arithmetic intrinsics, and cross-platform hardware acceleration primitives for AVX2 and ARM NEON.
//
// Setup: Vector operations on Vec4f, Vec8f, Vec4i, Vec8i, and Vec16b types.
//
// Beats:
//   1. Pure float arithmetic (fadd, fsub, fmul, fdiv, scale, fma) for 4-wide and 8-wide vectors.
//   2. Pure integer arithmetic and bitwise ops for 4-wide and 8-wide int vectors.
//   3. Pure byte vector operations (add, sub, bitwise and/or/xor) for 16-wide byte vectors.
//   4. Intrinsic operations: insertelement, extractelement, shufflevector, and reductions for AVX2 and NEON.

import "std/simd/simd_types.oo";

// Vec4f Float Arithmetic Intrinsics
pub fn vec4f_fadd(a: Vec4f, b: Vec4f) -> Vec4f {
    return Vec4f { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z, w: a.w + b.w };
}

pub fn vec4f_fsub(a: Vec4f, b: Vec4f) -> Vec4f {
    return Vec4f { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z, w: a.w - b.w };
}

pub fn vec4f_fmul(a: Vec4f, b: Vec4f) -> Vec4f {
    return Vec4f { x: a.x * b.x, y: a.y * b.y, z: a.z * b.z, w: a.w * b.w };
}

pub fn vec4f_fdiv(a: Vec4f, b: Vec4f) -> Vec4f {
    let mut bx: Float = b.x; let mut by: Float = b.y;
    let mut bz: Float = b.z; let mut bw: Float = b.w;
    if bx == 0.0 { bx = 1.0; }
    if by == 0.0 { by = 1.0; }
    if bz == 0.0 { bz = 1.0; }
    if bw == 0.0 { bw = 1.0; }
    return Vec4f { x: a.x / bx, y: a.y / by, z: a.z / bz, w: a.w / bw };
}

pub fn vec4f_extract(v: Vec4f, idx: Int) -> Float {
    if idx == 0 { return v.x; }
    if idx == 1 { return v.y; }
    if idx == 2 { return v.z; }
    return v.w;
}

pub fn vec4f_insert(v: Vec4f, val: Float, idx: Int) -> Vec4f {
    let mut x: Float = v.x; let mut y: Float = v.y;
    let mut z: Float = v.z; let mut w: Float = v.w;
    if idx == 0 { x = val; }
    else if idx == 1 { y = val; }
    else if idx == 2 { z = val; }
    else { w = val; }
    return Vec4f { x: x, y: y, z: z, w: w };
}

pub fn vec4f_shuffle(a: Vec4f, b: Vec4f, i0: Int, i1: Int, i2: Int, i3: Int) -> Vec4f {
    let mut x = if i0 < 4 { vec4f_extract(a, i0) } else { vec4f_extract(b, i0 - 4) };
    let mut y = if i1 < 4 { vec4f_extract(a, i1) } else { vec4f_extract(b, i1 - 4) };
    let mut z = if i2 < 4 { vec4f_extract(a, i2) } else { vec4f_extract(b, i2 - 4) };
    let mut w = if i3 < 4 { vec4f_extract(a, i3) } else { vec4f_extract(b, i3 - 4) };
    return Vec4f { x: x, y: y, z: z, w: w };
}

// Vec8f Float Arithmetic Intrinsics (AVX2)
pub fn vec8f_fadd(a: Vec8f, b: Vec8f) -> Vec8f {
    return Vec8f {
        v0: a.v0 + b.v0, v1: a.v1 + b.v1, v2: a.v2 + b.v2, v3: a.v3 + b.v3,
        v4: a.v4 + b.v4, v5: a.v5 + b.v5, v6: a.v6 + b.v6, v7: a.v7 + b.v7
    };
}

pub fn vec8f_fsub(a: Vec8f, b: Vec8f) -> Vec8f {
    return Vec8f {
        v0: a.v0 - b.v0, v1: a.v1 - b.v1, v2: a.v2 - b.v2, v3: a.v3 - b.v3,
        v4: a.v4 - b.v4, v5: a.v5 - b.v5, v6: a.v6 - b.v6, v7: a.v7 - b.v7
    };
}

pub fn vec8f_fmul(a: Vec8f, b: Vec8f) -> Vec8f {
    return Vec8f {
        v0: a.v0 * b.v0, v1: a.v1 * b.v1, v2: a.v2 * b.v2, v3: a.v3 * b.v3,
        v4: a.v4 * b.v4, v5: a.v5 * b.v5, v6: a.v6 * b.v6, v7: a.v7 * b.v7
    };
}

pub fn vec8f_fdiv(a: Vec8f, b: Vec8f) -> Vec8f {
    let mut b0 = b.v0; if b0 == 0.0 { b0 = 1.0; }
    let mut b1 = b.v1; if b1 == 0.0 { b1 = 1.0; }
    let mut b2 = b.v2; if b2 == 0.0 { b2 = 1.0; }
    let mut b3 = b.v3; if b3 == 0.0 { b3 = 1.0; }
    let mut b4 = b.v4; if b4 == 0.0 { b4 = 1.0; }
    let mut b5 = b.v5; if b5 == 0.0 { b5 = 1.0; }
    let mut b6 = b.v6; if b6 == 0.0 { b6 = 1.0; }
    let mut b7 = b.v7; if b7 == 0.0 { b7 = 1.0; }
    return Vec8f {
        v0: a.v0 / b0, v1: a.v1 / b1, v2: a.v2 / b2, v3: a.v3 / b3,
        v4: a.v4 / b4, v5: a.v5 / b5, v6: a.v6 / b6, v7: a.v7 / b7
    };
}

pub fn vec8f_extract(v: Vec8f, idx: Int) -> Float {
    if idx == 0 { return v.v0; } if idx == 1 { return v.v1; }
    if idx == 2 { return v.v2; } if idx == 3 { return v.v3; }
    if idx == 4 { return v.v4; } if idx == 5 { return v.v5; }
    if idx == 6 { return v.v6; } return v.v7;
}

pub fn vec8f_insert(v: Vec8f, val: Float, idx: Int) -> Vec8f {
    let mut v0 = v.v0; let mut v1 = v.v1; let mut v2 = v.v2; let mut v3 = v.v3;
    let mut v4 = v.v4; let mut v5 = v.v5; let mut v6 = v.v6; let mut v7 = v.v7;
    if idx == 0 { v0 = val; } else if idx == 1 { v1 = val; }
    else if idx == 2 { v2 = val; } else if idx == 3 { v3 = val; }
    else if idx == 4 { v4 = val; } else if idx == 5 { v5 = val; }
    else if idx == 6 { v6 = val; } else { v7 = val; }
    return Vec8f { v0: v0, v1: v1, v2: v2, v3: v3, v4: v4, v5: v5, v6: v6, v7: v7 };
}

pub fn vec8f_fma(a: Vec8f, b: Vec8f, c: Vec8f) -> Vec8f {
    return Vec8f {
        v0: a.v0 * b.v0 + c.v0, v1: a.v1 * b.v1 + c.v1,
        v2: a.v2 * b.v2 + c.v2, v3: a.v3 * b.v3 + c.v3,
        v4: a.v4 * b.v4 + c.v4, v5: a.v5 * b.v5 + c.v5,
        v6: a.v6 * b.v6 + c.v6, v7: a.v7 * b.v7 + c.v7
    };
}

// Vec4i Integer Operations (SSE2 / NEON)
pub fn vec4i_add(a: Vec4i, b: Vec4i) -> Vec4i {
    return Vec4i { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z, w: a.w + b.w };
}

pub fn vec4i_sub(a: Vec4i, b: Vec4i) -> Vec4i {
    return Vec4i { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z, w: a.w - b.w };
}

pub fn vec4i_mul(a: Vec4i, b: Vec4i) -> Vec4i {
    return Vec4i { x: a.x * b.x, y: a.y * b.y, z: a.z * b.z, w: a.w * b.w };
}

pub fn vec4i_extract(v: Vec4i, idx: Int) -> Int {
    if idx == 0 { return v.x; }
    if idx == 1 { return v.y; }
    if idx == 2 { return v.z; }
    return v.w;
}

pub fn vec4i_insert(v: Vec4i, val: Int, idx: Int) -> Vec4i {
    let mut x = v.x; let mut y = v.y; let mut z = v.z; let mut w = v.w;
    if idx == 0 { x = val; }
    else if idx == 1 { y = val; }
    else if idx == 2 { z = val; }
    else { w = val; }
    return Vec4i { x: x, y: y, z: z, w: w };
}

// Vec8i Integer Operations (AVX2)
pub fn vec8i_add(a: Vec8i, b: Vec8i) -> Vec8i {
    return Vec8i {
        v0: a.v0 + b.v0, v1: a.v1 + b.v1, v2: a.v2 + b.v2, v3: a.v3 + b.v3,
        v4: a.v4 + b.v4, v5: a.v5 + b.v5, v6: a.v6 + b.v6, v7: a.v7 + b.v7
    };
}

pub fn vec8i_sub(a: Vec8i, b: Vec8i) -> Vec8i {
    return Vec8i {
        v0: a.v0 - b.v0, v1: a.v1 - b.v1, v2: a.v2 - b.v2, v3: a.v3 - b.v3,
        v4: a.v4 - b.v4, v5: a.v5 - b.v5, v6: a.v6 - b.v6, v7: a.v7 - b.v7
    };
}

pub fn vec8i_mul(a: Vec8i, b: Vec8i) -> Vec8i {
    return Vec8i {
        v0: a.v0 * b.v0, v1: a.v1 * b.v1, v2: a.v2 * b.v2, v3: a.v3 * b.v3,
        v4: a.v4 * b.v4, v5: a.v5 * b.v5, v6: a.v6 * b.v6, v7: a.v7 * b.v7
    };
}

pub fn vec8i_extract(v: Vec8i, idx: Int) -> Int {
    if idx == 0 { return v.v0; } if idx == 1 { return v.v1; }
    if idx == 2 { return v.v2; } if idx == 3 { return v.v3; }
    if idx == 4 { return v.v4; } if idx == 5 { return v.v5; }
    if idx == 6 { return v.v6; } return v.v7;
}

pub fn vec8i_insert(v: Vec8i, val: Int, idx: Int) -> Vec8i {
    let mut v0 = v.v0; let mut v1 = v.v1; let mut v2 = v.v2; let mut v3 = v.v3;
    let mut v4 = v.v4; let mut v5 = v.v5; let mut v6 = v.v6; let mut v7 = v.v7;
    if idx == 0 { v0 = val; } else if idx == 1 { v1 = val; }
    else if idx == 2 { v2 = val; } else if idx == 3 { v3 = val; }
    else if idx == 4 { v4 = val; } else if idx == 5 { v5 = val; }
    else if idx == 6 { v6 = val; } else { v7 = val; }
    return Vec8i { v0: v0, v1: v1, v2: v2, v3: v3, v4: v4, v5: v5, v6: v6, v7: v7 };
}

// Vec16b Byte Operations (NEON / SSE2)
pub fn vec16b_add(a: Vec16b, b: Vec16b) -> Vec16b {
    return Vec16b {
        b0: (a.b0 + b.b0) % 256, b1: (a.b1 + b.b1) % 256, b2: (a.b2 + b.b2) % 256, b3: (a.b3 + b.b3) % 256,
        b4: (a.b4 + b.b4) % 256, b5: (a.b5 + b.b5) % 256, b6: (a.b6 + b.b6) % 256, b7: (a.b7 + b.b7) % 256,
        b8: (a.b8 + b.b8) % 256, b9: (a.b9 + b.b9) % 256, b10: (a.b10 + b.b10) % 256, b11: (a.b11 + b.b11) % 256,
        b12: (a.b12 + b.b12) % 256, b13: (a.b13 + b.b13) % 256, b14: (a.b14 + b.b14) % 256, b15: (a.b15 + b.b15) % 256
    };
}

pub fn vec16b_and(a: Vec16b, b: Vec16b) -> Vec16b {
    return Vec16b {
        b0: a.b0 & b.b0, b1: a.b1 & b.b1, b2: a.b2 & b.b2, b3: a.b3 & b.b3,
        b4: a.b4 & b.b4, b5: a.b5 & b.b5, b6: a.b6 & b.b6, b7: a.b7 & b.b7,
        b8: a.b8 & b.b8, b9: a.b9 & b.b9, b10: a.b10 & b.b10, b11: a.b11 & b.b11,
        b12: a.b12 & b.b12, b13: a.b13 & b.b13, b14: a.b14 & b.b14, b15: a.b15 & b.b15
    };
}

pub fn vec16b_xor(a: Vec16b, b: Vec16b) -> Vec16b {
    return Vec16b {
        b0: a.b0 ^ b.b0, b1: a.b1 ^ b.b1, b2: a.b2 ^ b.b2, b3: a.b3 ^ b.b3,
        b4: a.b4 ^ b.b4, b5: a.b5 ^ b.b5, b6: a.b6 ^ b.b6, b7: a.b7 ^ b.b7,
        b8: a.b8 ^ b.b8, b9: a.b9 ^ b.b9, b10: a.b10 ^ b.b10, b11: a.b11 ^ b.b11,
        b12: a.b12 ^ b.b12, b13: a.b13 ^ b.b13, b14: a.b14 ^ b.b14, b15: a.b15 ^ b.b15
    };
}

pub fn vec16b_extract(v: Vec16b, idx: Int) -> Int {
    if idx == 0 { return v.b0; } if idx == 1 { return v.b1; }
    if idx == 2 { return v.b2; } if idx == 3 { return v.b3; }
    if idx == 4 { return v.b4; } if idx == 5 { return v.b5; }
    if idx == 6 { return v.b6; } if idx == 7 { return v.b7; }
    if idx == 8 { return v.b8; } if idx == 9 { return v.b9; }
    if idx == 10 { return v.b10; } if idx == 11 { return v.b11; }
    if idx == 12 { return v.b12; } if idx == 13 { return v.b13; }
    if idx == 14 { return v.b14; } return v.b15;
}

pub fn vec16b_insert(v: Vec16b, val: Int, idx: Int) -> Vec16b {
    let mut b0 = v.b0; let mut b1 = v.b1; let mut b2 = v.b2; let mut b3 = v.b3;
    let mut b4 = v.b4; let mut b5 = v.b5; let mut b6 = v.b6; let mut b7 = v.b7;
    let mut b8 = v.b8; let mut b9 = v.b9; let mut b10 = v.b10; let mut b11 = v.b11;
    let mut b12 = v.b12; let mut b13 = v.b13; let mut b14 = v.b14; let mut b15 = v.b15;
    if idx == 0 { b0 = val; } else if idx == 1 { b1 = val; }
    else if idx == 2 { b2 = val; } else if idx == 3 { b3 = val; }
    else if idx == 4 { b4 = val; } else if idx == 5 { b5 = val; }
    else if idx == 6 { b6 = val; } else if idx == 7 { b7 = val; }
    else if idx == 8 { b8 = val; } else if idx == 9 { b9 = val; }
    else if idx == 10 { b10 = val; } else if idx == 11 { b11 = val; }
    else if idx == 12 { b12 = val; } else if idx == 13 { b13 = val; }
    else if idx == 14 { b14 = val; } else { b15 = val; }
    return Vec16b {
        b0: b0, b1: b1, b2: b2, b3: b3, b4: b4, b5: b5, b6: b6, b7: b7,
        b8: b8, b9: b9, b10: b10, b11: b11, b12: b12, b13: b13, b14: b14, b15: b15
    };
}
