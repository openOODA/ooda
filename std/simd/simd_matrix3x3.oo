// # 3x3 SIMD Matrix Transformation Module
//
// Logline: 3x3 single-precision floating-point matrix arithmetic, 3D affine vector transformation, and determinant calculation.
//
// Setup: Pure math module. Stores 3x3 transformation matrices for 3D graphics and spatial rotations.
//
// Beats:
//   1. Construct 3x3 matrix structures from elements, identity, and zero initializers.
//   2. Element-wise matrix addition, subtraction, and scalar scaling.
//   3. Matrix-matrix composition and 3D coordinate transformation.
//   4. Matrix transpose, determinant, and trace.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD lowering is handled via compiler backend.

type SimdMat3 = struct {
    m00: Float, m01: Float, m02: Float,
    m10: Float, m11: Float, m12: Float,
    m20: Float, m21: Float, m22: Float
};

pub fn simd_mat3_new(
    m00: Float, m01: Float, m02: Float,
    m10: Float, m11: Float, m12: Float,
    m20: Float, m21: Float, m22: Float
) -> SimdMat3 {
    return SimdMat3 {
        m00: m00, m01: m01, m02: m02,
        m10: m10, m11: m11, m12: m12,
        m20: m20, m21: m21, m22: m22
    };
}

pub fn simd_mat3_zero() -> SimdMat3 {
    return SimdMat3 {
        m00: 0.0, m01: 0.0, m02: 0.0,
        m10: 0.0, m11: 0.0, m12: 0.0,
        m20: 0.0, m21: 0.0, m22: 0.0
    };
}

pub fn simd_mat3_identity() -> SimdMat3 {
    return SimdMat3 {
        m00: 1.0, m01: 0.0, m02: 0.0,
        m10: 0.0, m11: 1.0, m12: 0.0,
        m20: 0.0, m21: 0.0, m22: 1.0
    };
}

pub fn simd_mat3_add(a: SimdMat3, b: SimdMat3) -> SimdMat3 {
    let a00: Float = a.m00; let b00: Float = b.m00;
    let a01: Float = a.m01; let b01: Float = b.m01;
    let a02: Float = a.m02; let b02: Float = b.m02;
    let a10: Float = a.m10; let b10: Float = b.m10;
    let a11: Float = a.m11; let b11: Float = b.m11;
    let a12: Float = a.m12; let b12: Float = b.m12;
    let a20: Float = a.m20; let b20: Float = b.m20;
    let a21: Float = a.m21; let b21: Float = b.m21;
    let a22: Float = a.m22; let b22: Float = b.m22;
    return SimdMat3 {
        m00: a00 + b00, m01: a01 + b01, m02: a02 + b02,
        m10: a10 + b10, m11: a11 + b11, m12: a12 + b12,
        m20: a20 + b20, m21: a21 + b21, m22: a22 + b22
    };
}

pub fn simd_mat3_sub(a: SimdMat3, b: SimdMat3) -> SimdMat3 {
    let a00: Float = a.m00; let b00: Float = b.m00;
    let a01: Float = a.m01; let b01: Float = b.m01;
    let a02: Float = a.m02; let b02: Float = b.m02;
    let a10: Float = a.m10; let b10: Float = b.m10;
    let a11: Float = a.m11; let b11: Float = b.m11;
    let a12: Float = a.m12; let b12: Float = b.m12;
    let a20: Float = a.m20; let b20: Float = b.m20;
    let a21: Float = a.m21; let b21: Float = b.m21;
    let a22: Float = a.m22; let b22: Float = b.m22;
    return SimdMat3 {
        m00: a00 - b00, m01: a01 - b01, m02: a02 - b02,
        m10: a10 - b10, m11: a11 - b11, m12: a12 - b12,
        m20: a20 - b20, m21: a21 - b21, m22: a22 - b22
    };
}

pub fn simd_mat3_scale(m: SimdMat3, s: Float) -> SimdMat3 {
    let m00: Float = m.m00; let m01: Float = m.m01; let m02: Float = m.m02;
    let m10: Float = m.m10; let m11: Float = m.m11; let m12: Float = m.m12;
    let m20: Float = m.m20; let m21: Float = m.m21; let m22: Float = m.m22;
    return SimdMat3 {
        m00: m00 * s, m01: m01 * s, m02: m02 * s,
        m10: m10 * s, m11: m11 * s, m12: m12 * s,
        m20: m20 * s, m21: m21 * s, m22: m22 * s
    };
}

pub fn simd_mat3_transpose(m: SimdMat3) -> SimdMat3 {
    let m00: Float = m.m00; let m01: Float = m.m01; let m02: Float = m.m02;
    let m10: Float = m.m10; let m11: Float = m.m11; let m12: Float = m.m12;
    let m20: Float = m.m20; let m21: Float = m.m21; let m22: Float = m.m22;
    return SimdMat3 {
        m00: m00, m01: m10, m02: m20,
        m10: m01, m11: m11, m12: m21,
        m20: m02, m21: m12, m22: m22
    };
}

pub fn simd_mat3_det(m: SimdMat3) -> Float {
    let m00: Float = m.m00; let m01: Float = m.m01; let m02: Float = m.m02;
    let m10: Float = m.m10; let m11: Float = m.m11; let m12: Float = m.m12;
    let m20: Float = m.m20; let m21: Float = m.m21; let m22: Float = m.m22;
    let term1: Float = m00 * (m11 * m22 - m12 * m21);
    let term2: Float = m01 * (m10 * m22 - m12 * m20);
    let term3: Float = m02 * (m10 * m21 - m11 * m20);
    return term1 - term2 + term3;
}

pub fn simd_mat3_trace(m: SimdMat3) -> Float {
    let m00: Float = m.m00;
    let m11: Float = m.m11;
    let m22: Float = m.m22;
    return m00 + m11 + m22;
}
