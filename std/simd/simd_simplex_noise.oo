// # SIMD Simplex Noise Module
//
// Logline: 2D Simplex noise evaluation using triangular grid skewing and circular kernel contributions.
//
// Setup: Pure math module. Provides continuous, artifact-free simplex gradient noise.
//
// Beats:
//   1. Coordinate skewing and unskewing factors for 2D simplex grid.
//   2. Simplex corner contributions and radial distance attenuation.
//   3. 2D Simplex noise evaluation.
//   4. Multi-octave Simplex Fractal Brownian Motion.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD lowering is handled via compiler backend.

type SimplexConfig = struct {
    octaves: Int,
    persistence: Float,
    lacunarity: Float
};

pub fn simplex_config_default() -> SimplexConfig {
    return SimplexConfig {
        octaves: 4,
        persistence: 0.5,
        lacunarity: 2.0
    };
}

fn simplex_grad2(hash: Int, x: Float, y: Float) -> Float {
    let h: Int = hash % 8;
    if h == 0 { return x + y; }
    if h == 1 { return (0.0 - x) + y; }
    if h == 2 { return x - y; }
    if h == 3 { return (0.0 - x) - y; }
    if h == 4 { return x; }
    if h == 5 { return 0.0 - x; }
    if h == 6 { return y; }
    return 0.0 - y;
}

pub fn simplex_noise2d(x: Float, y: Float) -> Float {
    let g2: Float = 0.2113248654051871;

    let x0: Float = x;
    let y0: Float = y;
    let x1: Float = x0 - 1.0 + g2;
    let y1: Float = y0 + g2;
    let x2: Float = x0 - 1.0 + 2.0 * g2;
    let y2: Float = y0 - 1.0 + 2.0 * g2;

    let mut n0: Float = 0.0;
    let mut t0: Float = 0.5 - x0 * x0 - y0 * y0;
    if t0 > 0.0 {
        t0 = t0 * t0;
        n0 = t0 * t0 * simplex_grad2(0, x0, y0);
    }

    let mut n1: Float = 0.0;
    let mut t1: Float = 0.5 - x1 * x1 - y1 * y1;
    if t1 > 0.0 {
        t1 = t1 * t1;
        n1 = t1 * t1 * simplex_grad2(1, x1, y1);
    }

    let mut n2: Float = 0.0;
    let mut t2: Float = 0.5 - x2 * x2 - y2 * y2;
    if t2 > 0.0 {
        t2 = t2 * t2;
        n2 = t2 * t2 * simplex_grad2(2, x2, y2);
    }

    return 70.0 * (n0 + n1 + n2);
}

pub fn simplex_fbm2d(x: Float, y: Float, cfg: SimplexConfig) -> Float {
    let mut total: Float = 0.0;
    let mut freq: Float = 1.0;
    let mut amp: Float = 1.0;
    let mut max_amp: Float = 0.0;
    let mut k: Int = 0;
    let oct: Int = cfg.octaves;
    let pers: Float = cfg.persistence;
    let lac: Float = cfg.lacunarity;

    while k < oct {
        let val: Float = simplex_noise2d(x * freq, y * freq);
        total = total + val * amp;
        max_amp = max_amp + amp;
        amp = amp * pers;
        freq = freq * lac;
        k = k + 1;
    }
    if max_amp == 0.0 { return 0.0; }
    return total / max_amp;
}
