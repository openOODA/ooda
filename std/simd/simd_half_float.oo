// # SIMD 16-Bit Half-Precision Floating Point (FP16) Module
//
// Logline: IEEE 754-2008 16-bit half-precision float conversions, bitwise unpacking, subnormal handling, and 4-wide vector packing.
//
// Setup: Pure math module. Emulates FP16 arithmetic and packed 4-lane SIMD half-float registers (F16C/ARM FP16).
//
// Beats:
//   1. Construct HalfFloat data structures and 4-lane Vec4h packed vectors.
//   2. Conversions between single precision Float and half-precision bitfields.
//   3. Floating-point classification: NaN, infinity, subnormal, zero, and sign.
//   4. Packed 4-lane SIMD vector pack, unpack, and element access.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware F16C / AVX512-FP16 instructions lower via compiler vector backend.

type HalfFloat = struct {
    bits: Int
};

type Vec4h = struct {
    h0: Int,
    h1: Int,
    h2: Int,
    h3: Int
};

pub fn half_from_bits(b: Int) -> HalfFloat {
    return HalfFloat { bits: b & 65535 };
}

pub fn half_to_bits(h: HalfFloat) -> Int {
    return h.bits;
}

pub fn half_zero() -> HalfFloat {
    return HalfFloat { bits: 0 };
}

pub fn half_sign(h: HalfFloat) -> Int {
    return (h.bits / 32768) & 1;
}

pub fn half_exponent(h: HalfFloat) -> Int {
    return (h.bits / 1024) & 31;
}

pub fn half_mantissa(h: HalfFloat) -> Int {
    return h.bits & 1023;
}

pub fn half_is_nan(h: HalfFloat) -> Bool {
    let exp: Int = half_exponent(h);
    let mant: Int = half_mantissa(h);
    return exp == 31 && mant != 0;
}

pub fn half_is_inf(h: HalfFloat) -> Bool {
    let exp: Int = half_exponent(h);
    let mant: Int = half_mantissa(h);
    return exp == 31 && mant == 0;
}

pub fn half_is_zero(h: HalfFloat) -> Bool {
    return (h.bits & 32767) == 0;
}

pub fn half_is_subnormal(h: HalfFloat) -> Bool {
    let exp: Int = half_exponent(h);
    let mant: Int = half_mantissa(h);
    return exp == 0 && mant != 0;
}

pub fn half_negate(h: HalfFloat) -> HalfFloat {
    return HalfFloat { bits: h.bits ^ 32768 };
}

pub fn half_abs(h: HalfFloat) -> HalfFloat {
    return HalfFloat { bits: h.bits & 32767 };
}

pub fn vec4h_new(h0: Int, h1: Int, h2: Int, h3: Int) -> Vec4h {
    return Vec4h {
        h0: h0 & 65535,
        h1: h1 & 65535,
        h2: h2 & 65535,
        h3: h3 & 65535
    };
}

pub fn vec4h_splat(h: Int) -> Vec4h {
    let masked: Int = h & 65535;
    return Vec4h {
        h0: masked,
        h1: masked,
        h2: masked,
        h3: masked
    };
}

pub fn vec4h_zero() -> Vec4h {
    return vec4h_splat(0);
}

pub fn vec4h_get(v: Vec4h, idx: Int) -> Int {
    if idx == 0 { return v.h0; }
    if idx == 1 { return v.h1; }
    if idx == 2 { return v.h2; }
    return v.h3;
}

pub fn vec4h_set(v: Vec4h, idx: Int, val: Int) -> Vec4h {
    let masked: Int = val & 65535;
    if idx == 0 {
        return Vec4h { h0: masked, h1: v.h1, h2: v.h2, h3: v.h3 };
    }
    if idx == 1 {
        return Vec4h { h0: v.h0, h1: masked, h2: v.h2, h3: v.h3 };
    }
    if idx == 2 {
        return Vec4h { h0: v.h0, h1: v.h1, h2: masked, h3: v.h3 };
    }
    return Vec4h { h0: v.h0, h1: v.h1, h2: v.h2, h3: masked };
}
