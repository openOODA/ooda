// # SIMD Vector Gather and Scatter Simulation Module
//
// Logline: Vectorized indirect indexed gather and scatter memory simulation over flat memory buffers.
//
// Setup: Pure memory mapping module. Emulates SIMD gather/scatter addressing modes.
//
// Beats:
//   1. Define GatherScatterIndex vector address offsets.
//   2. Gather elements from memory list by vectorized indices.
//   3. Scatter elements into memory list by vectorized indices.
//   4. Masked gather and scatter operations.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD lowering is handled via compiler backend.

import "std/core/list.oo";

type SimdIndices4 = struct {
    i0: Int,
    i1: Int,
    i2: Int,
    i3: Int
};

type SimdValues4 = struct {
    v0: Int,
    v1: Int,
    v2: Int,
    v3: Int
};

pub fn simd_indices4_new(i0: Int, i1: Int, i2: Int, i3: Int) -> SimdIndices4 {
    return SimdIndices4 { i0: i0, i1: i1, i2: i2, i3: i3 };
}

pub fn simd_values4_new(v0: Int, v1: Int, v2: Int, v3: Int) -> SimdValues4 {
    return SimdValues4 { v0: v0, v1: v1, v2: v2, v3: v3 };
}

fn safe_list_get(mem: List[Int], idx: Int, fallback: Int) -> Int {
    let n: Int = list_len(mem);
    if idx < 0 || idx >= n { return fallback; }
    return list_get(mem, idx);
}

pub fn simd_gather4(mem: List[Int], idxs: SimdIndices4, fallback: Int) -> SimdValues4 {
    let idx0: Int = idxs.i0;
    let idx1: Int = idxs.i1;
    let idx2: Int = idxs.i2;
    let idx3: Int = idxs.i3;
    return SimdValues4 {
        v0: safe_list_get(mem, idx0, fallback),
        v1: safe_list_get(mem, idx1, fallback),
        v2: safe_list_get(mem, idx2, fallback),
        v3: safe_list_get(mem, idx3, fallback)
    };
}
