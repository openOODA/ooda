// # 4x4 SIMD Matrix Transformation Module
//
// Logline: 4x4 single-precision floating-point matrix arithmetic, vector transformation, and transposition using 4-wide SIMD vectors.
//
// Setup: Pure math module. Stores 4x4 transformation matrices as 4 row Vec4f vectors for fast SIMD transformation.
//
// Beats:
//   1. Construct 4x4 matrix structures from row vectors, identity, and zero initializers.
//   2. Element-wise matrix addition, subtraction, and scalar scaling.
//   3. 4D vector transformation (matrix-vector multiplication) and matrix-matrix composition.
//   4. Matrix transpose, trace, and element indexing.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD lowering to 4x128-bit registers is handled via compiler backend.

import "std/simd/simd_vec4f.oo";

type SimdMat4 = struct {
    r0: Vec4f,
    r1: Vec4f,
    r2: Vec4f,
    r3: Vec4f
};

pub fn simd_mat4_from_rows(r0: Vec4f, r1: Vec4f, r2: Vec4f, r3: Vec4f) -> SimdMat4 {
    return SimdMat4 {
        r0: r0,
        r1: r1,
        r2: r2,
        r3: r3
    };
}

pub fn simd_mat4_zero() -> SimdMat4 {
    let z: Vec4f = vec4f_zero();
    return SimdMat4 {
        r0: z,
        r1: z,
        r2: z,
        r3: z
    };
}

pub fn simd_mat4_identity() -> SimdMat4 {
    return SimdMat4 {
        r0: vec4f_new(1.0, 0.0, 0.0, 0.0),
        r1: vec4f_new(0.0, 1.0, 0.0, 0.0),
        r2: vec4f_new(0.0, 0.0, 1.0, 0.0),
        r3: vec4f_new(0.0, 0.0, 0.0, 1.0)
    };
}

pub fn simd_mat4_add(a: SimdMat4, b: SimdMat4) -> SimdMat4 {
    return SimdMat4 {
        r0: vec4f_add(a.r0, b.r0),
        r1: vec4f_add(a.r1, b.r1),
        r2: vec4f_add(a.r2, b.r2),
        r3: vec4f_add(a.r3, b.r3)
    };
}

pub fn simd_mat4_sub(a: SimdMat4, b: SimdMat4) -> SimdMat4 {
    return SimdMat4 {
        r0: vec4f_sub(a.r0, b.r0),
        r1: vec4f_sub(a.r1, b.r1),
        r2: vec4f_sub(a.r2, b.r2),
        r3: vec4f_sub(a.r3, b.r3)
    };
}

pub fn simd_mat4_scale(m: SimdMat4, s: Float) -> SimdMat4 {
    return SimdMat4 {
        r0: vec4f_scale(m.r0, s),
        r1: vec4f_scale(m.r1, s),
        r2: vec4f_scale(m.r2, s),
        r3: vec4f_scale(m.r3, s)
    };
}

pub fn simd_mat4_mul_vec(m: SimdMat4, v: Vec4f) -> Vec4f {
    return Vec4f {
        x: vec4f_dot(m.r0, v),
        y: vec4f_dot(m.r1, v),
        z: vec4f_dot(m.r2, v),
        w: vec4f_dot(m.r3, v)
    };
}

pub fn simd_mat4_transpose(m: SimdMat4) -> SimdMat4 {
    let r0: Vec4f = m.r0;
    let r1: Vec4f = m.r1;
    let r2: Vec4f = m.r2;
    let r3: Vec4f = m.r3;
    return SimdMat4 {
        r0: vec4f_new(r0.x, r1.x, r2.x, r3.x),
        r1: vec4f_new(r0.y, r1.y, r2.y, r3.y),
        r2: vec4f_new(r0.z, r1.z, r2.z, r3.z),
        r3: vec4f_new(r0.w, r1.w, r2.w, r3.w)
    };
}

pub fn simd_mat4_mul(a: SimdMat4, b: SimdMat4) -> SimdMat4 {
    let bt: SimdMat4 = simd_mat4_transpose(b);
    let ar0: Vec4f = a.r0;
    let ar1: Vec4f = a.r1;
    let ar2: Vec4f = a.r2;
    let ar3: Vec4f = a.r3;
    let btr0: Vec4f = bt.r0;
    let btr1: Vec4f = bt.r1;
    let btr2: Vec4f = bt.r2;
    let btr3: Vec4f = bt.r3;
    return SimdMat4 {
        r0: vec4f_new(vec4f_dot(ar0, btr0), vec4f_dot(ar0, btr1), vec4f_dot(ar0, btr2), vec4f_dot(ar0, btr3)),
        r1: vec4f_new(vec4f_dot(ar1, btr0), vec4f_dot(ar1, btr1), vec4f_dot(ar1, btr2), vec4f_dot(ar1, btr3)),
        r2: vec4f_new(vec4f_dot(ar2, btr0), vec4f_dot(ar2, btr1), vec4f_dot(ar2, btr2), vec4f_dot(ar2, btr3)),
        r3: vec4f_new(vec4f_dot(ar3, btr0), vec4f_dot(ar3, btr1), vec4f_dot(ar3, btr2), vec4f_dot(ar3, btr3))
    };
}

pub fn simd_mat4_trace(m: SimdMat4) -> Float {
    let r0: Vec4f = m.r0;
    let r1: Vec4f = m.r1;
    let r2: Vec4f = m.r2;
    let r3: Vec4f = m.r3;
    return r0.x + r1.y + r2.z + r3.w;
}

pub fn simd_mat4_get(m: SimdMat4, r: Int, c: Int) -> Float {
    if r == 0 { return vec4f_get(m.r0, c); }
    if r == 1 { return vec4f_get(m.r1, c); }
    if r == 2 { return vec4f_get(m.r2, c); }
    return vec4f_get(m.r3, c);
}
