// # SIMD Bitwise Selection and Mask Blending Module
//
// Logline: 32-bit and 64-bit SIMD conditional selection, bitwise multiplexing, and boolean mask blending.
//
// Setup: Pure math module. Vectorized branchless multiplexing using bitwise masks.
//
// Beats:
//   1. Conditional bit selection: bitselect(mask, a, b) = (a & mask) | (b & (mask ^ -1)).
//   2. Boolean lane multiplexing for integers and floats.
//   3. Sign-bit extraction and mask generation.
//   4. Equality mask generation.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD lowering is handled via compiler backend.

pub fn simd_bitselect_i32(mask: Int, a: Int, b: Int) -> Int {
    let not_mask: Int = mask ^ -1;
    return (a & mask) | (b & not_mask);
}

pub fn simd_blend_i32(condition: Bool, a: Int, b: Int) -> Int {
    if condition { return a; }
    return b;
}

pub fn simd_blend_f32(condition: Bool, a: Float, b: Float) -> Float {
    if condition { return a; }
    return b;
}

pub fn simd_mask_eq_i32(a: Int, b: Int) -> Int {
    if a == b { return -1; }
    return 0;
}

pub fn simd_mask_gt_i32(a: Int, b: Int) -> Int {
    if a > b { return -1; }
    return 0;
}

pub fn simd_mask_lt_i32(a: Int, b: Int) -> Int {
    if a < b { return -1; }
    return 0;
}
