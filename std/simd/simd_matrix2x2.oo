// # 2x2 SIMD Matrix Transformation Module
//
// Logline: 2x2 single-precision floating-point matrix arithmetic, vector transformation, and determinant calculation.
//
// Setup: Pure math module. Stores 2x2 transformation matrices as 2 row Vec4f/Float pairs for fast SIMD transformation.
//
// Beats:
//   1. Construct 2x2 matrix structures from elements, identity, and zero initializers.
//   2. Element-wise matrix addition, subtraction, and scalar scaling.
//   3. 2D vector transformation (matrix-vector multiplication) and matrix-matrix composition.
//   4. Matrix transpose, determinant, inverse, and trace.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD lowering is handled via compiler backend.

type SimdMat2 = struct {
    m00: Float,
    m01: Float,
    m10: Float,
    m11: Float
};

pub fn simd_mat2_new(m00: Float, m01: Float, m10: Float, m11: Float) -> SimdMat2 {
    return SimdMat2 {
        m00: m00,
        m01: m01,
        m10: m10,
        m11: m11
    };
}

pub fn simd_mat2_zero() -> SimdMat2 {
    return SimdMat2 {
        m00: 0.0,
        m01: 0.0,
        m10: 0.0,
        m11: 0.0
    };
}

pub fn simd_mat2_identity() -> SimdMat2 {
    return SimdMat2 {
        m00: 1.0,
        m01: 0.0,
        m10: 0.0,
        m11: 1.0
    };
}

pub fn simd_mat2_add(a: SimdMat2, b: SimdMat2) -> SimdMat2 {
    let a00: Float = a.m00;
    let b00: Float = b.m00;
    let a01: Float = a.m01;
    let b01: Float = b.m01;
    let a10: Float = a.m10;
    let b10: Float = b.m10;
    let a11: Float = a.m11;
    let b11: Float = b.m11;
    return SimdMat2 {
        m00: a00 + b00,
        m01: a01 + b01,
        m10: a10 + b10,
        m11: a11 + b11
    };
}

pub fn simd_mat2_sub(a: SimdMat2, b: SimdMat2) -> SimdMat2 {
    let a00: Float = a.m00;
    let b00: Float = b.m00;
    let a01: Float = a.m01;
    let b01: Float = b.m01;
    let a10: Float = a.m10;
    let b10: Float = b.m10;
    let a11: Float = a.m11;
    let b11: Float = b.m11;
    return SimdMat2 {
        m00: a00 - b00,
        m01: a01 - b01,
        m10: a10 - b10,
        m11: a11 - b11
    };
}

pub fn simd_mat2_scale(m: SimdMat2, s: Float) -> SimdMat2 {
    let m00: Float = m.m00;
    let m01: Float = m.m01;
    let m10: Float = m.m10;
    let m11: Float = m.m11;
    return SimdMat2 {
        m00: m00 * s,
        m01: m01 * s,
        m10: m10 * s,
        m11: m11 * s
    };
}

pub fn simd_mat2_mul(a: SimdMat2, b: SimdMat2) -> SimdMat2 {
    let a00: Float = a.m00;
    let a01: Float = a.m01;
    let a10: Float = a.m10;
    let a11: Float = a.m11;
    let b00: Float = b.m00;
    let b01: Float = b.m01;
    let b10: Float = b.m10;
    let b11: Float = b.m11;
    return SimdMat2 {
        m00: a00 * b00 + a01 * b10,
        m01: a00 * b01 + a01 * b11,
        m10: a10 * b00 + a11 * b10,
        m11: a10 * b01 + a11 * b11
    };
}

pub fn simd_mat2_transpose(m: SimdMat2) -> SimdMat2 {
    let m00: Float = m.m00;
    let m01: Float = m.m01;
    let m10: Float = m.m10;
    let m11: Float = m.m11;
    return SimdMat2 {
        m00: m00,
        m01: m10,
        m10: m01,
        m11: m11
    };
}

pub fn simd_mat2_det(m: SimdMat2) -> Float {
    let m00: Float = m.m00;
    let m01: Float = m.m01;
    let m10: Float = m.m10;
    let m11: Float = m.m11;
    return m00 * m11 - m01 * m10;
}

pub fn simd_mat2_trace(m: SimdMat2) -> Float {
    let m00: Float = m.m00;
    let m11: Float = m.m11;
    return m00 + m11;
}

pub fn simd_mat2_inv(m: SimdMat2) -> SimdMat2 {
    let d: Float = simd_mat2_det(m);
    if d == 0.0 {
        return simd_mat2_zero();
    }
    let inv_d: Float = 1.0 / d;
    let m00: Float = m.m00;
    let m01: Float = m.m01;
    let m10: Float = m.m10;
    let m11: Float = m.m11;
    return SimdMat2 {
        m00: m11 * inv_d,
        m01: (0.0 - m01) * inv_d,
        m10: (0.0 - m10) * inv_d,
        m11: m00 * inv_d
    };
}
