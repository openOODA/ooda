// # SIMD Linear and Non-Linear Interpolation Module
//
// Logline: SIMD float and vector interpolation: lerp, smoothstep, smootherstep, and inverse lerp.
//
// Setup: Pure math module. Parallel interpolation primitives across scalar and vector lanes.
//
// Beats:
//   1. Scalar and lane-wise linear interpolation (lerp).
//   2. Inverse linear interpolation (inv_lerp) and range remap.
//   3. Hermite smoothstep (3t^2 - 2t^3) and Perlin smootherstep (6t^5 - 15t^4 + 10t^3).
//   4. Multi-lane 4-wide interpolation.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD lowering is handled via compiler backend.

pub fn simd_lerp_f32(a: Float, b: Float, t: Float) -> Float {
    return a + t * (b - a);
}

pub fn simd_inv_lerp_f32(a: Float, b: Float, v: Float) -> Float {
    let diff: Float = b - a;
    if diff == 0.0 { return 0.0; }
    return (v - a) / diff;
}

pub fn simd_remap_f32(in_min: Float, in_max: Float, out_min: Float, out_max: Float, v: Float) -> Float {
    let t: Float = simd_inv_lerp_f32(in_min, in_max, v);
    return simd_lerp_f32(out_min, out_max, t);
}

pub fn simd_smoothstep_f32(edge0: Float, edge1: Float, x: Float) -> Float {
    let diff: Float = edge1 - edge0;
    if diff == 0.0 { return 0.0; }
    let mut t: Float = (x - edge0) / diff;
    if t < 0.0 { t = 0.0; }
    if t > 1.0 { t = 1.0; }
    return t * t * (3.0 - 2.0 * t);
}

pub fn simd_smootherstep_f32(edge0: Float, edge1: Float, x: Float) -> Float {
    let diff: Float = edge1 - edge0;
    if diff == 0.0 { return 0.0; }
    let mut t: Float = (x - edge0) / diff;
    if t < 0.0 { t = 0.0; }
    if t > 1.0 { t = 1.0; }
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}
