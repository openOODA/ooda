// # SIMD Vector Types Definition Module
//
// Logline: Defines explicit 128-bit and 256-bit SIMD vector data types (Vec4f, Vec8f, Vec4i, Vec8i, Vec16b) for AVX2 and ARM NEON hardware acceleration.
//
// Setup: Pure math structures representing packed float, int32, and byte vectors.
//
// Beats:
//   1. Define 128-bit 4-wide float vector (Vec4f) and 256-bit 8-wide float vector (Vec8f).
//   2. Define 128-bit 4-wide int vector (Vec4i) and 256-bit 8-wide int vector (Vec8i).
//   3. Define 128-bit 16-wide byte vector (Vec16b).
//   4. Constructors, zero initializers, splat initializers, and lane accessors for all vector types.

type Vec4f = struct {
    x: Float,
    y: Float,
    z: Float,
    w: Float
};

type Vec8f = struct {
    v0: Float,
    v1: Float,
    v2: Float,
    v3: Float,
    v4: Float,
    v5: Float,
    v6: Float,
    v7: Float
};

type Vec4i = struct {
    x: Int,
    y: Int,
    z: Int,
    w: Int
};

type Vec8i = struct {
    v0: Int,
    v1: Int,
    v2: Int,
    v3: Int,
    v4: Int,
    v5: Int,
    v6: Int,
    v7: Int
};

type Vec16b = struct {
    b0: Int, b1: Int, b2: Int, b3: Int,
    b4: Int, b5: Int, b6: Int, b7: Int,
    b8: Int, b9: Int, b10: Int, b11: Int,
    b12: Int, b13: Int, b14: Int, b15: Int
};

pub fn vec4f_new(x: Float, y: Float, z: Float, w: Float) -> Vec4f {
    return Vec4f { x: x, y: y, z: z, w: w };
}

pub fn vec4f_splat(v: Float) -> Vec4f {
    return Vec4f { x: v, y: v, z: v, w: v };
}

pub fn vec4f_zero() -> Vec4f {
    return Vec4f { x: 0.0, y: 0.0, z: 0.0, w: 0.0 };
}

pub fn vec8f_new(v0: Float, v1: Float, v2: Float, v3: Float, v4: Float, v5: Float, v6: Float, v7: Float) -> Vec8f {
    return Vec8f { v0: v0, v1: v1, v2: v2, v3: v3, v4: v4, v5: v5, v6: v6, v7: v7 };
}

pub fn vec8f_splat(v: Float) -> Vec8f {
    return Vec8f { v0: v, v1: v, v2: v, v3: v, v4: v, v5: v, v6: v, v7: v };
}

pub fn vec8f_zero() -> Vec8f {
    return Vec8f { v0: 0.0, v1: 0.0, v2: 0.0, v3: 0.0, v4: 0.0, v5: 0.0, v6: 0.0, v7: 0.0 };
}

pub fn vec4i_new(x: Int, y: Int, z: Int, w: Int) -> Vec4i {
    return Vec4i { x: x, y: y, z: z, w: w };
}

pub fn vec4i_splat(v: Int) -> Vec4i {
    return Vec4i { x: v, y: v, z: v, w: v };
}

pub fn vec4i_zero() -> Vec4i {
    return Vec4i { x: 0, y: 0, z: 0, w: 0 };
}

pub fn vec8i_new(v0: Int, v1: Int, v2: Int, v3: Int, v4: Int, v5: Int, v6: Int, v7: Int) -> Vec8i {
    return Vec8i { v0: v0, v1: v1, v2: v2, v3: v3, v4: v4, v5: v5, v6: v6, v7: v7 };
}

pub fn vec8i_splat(v: Int) -> Vec8i {
    return Vec8i { v0: v, v1: v, v2: v, v3: v, v4: v, v5: v, v6: v, v7: v };
}

pub fn vec8i_zero() -> Vec8i {
    return Vec8i { v0: 0, v1: 0, v2: 0, v3: 0, v4: 0, v5: 0, v6: 0, v7: 0 };
}

pub fn vec16b_new(
    b0: Int, b1: Int, b2: Int, b3: Int,
    b4: Int, b5: Int, b6: Int, b7: Int,
    b8: Int, b9: Int, b10: Int, b11: Int,
    b12: Int, b13: Int, b14: Int, b15: Int
) -> Vec16b {
    return Vec16b {
        b0: b0, b1: b1, b2: b2, b3: b3,
        b4: b4, b5: b5, b6: b6, b7: b7,
        b8: b8, b9: b9, b10: b10, b11: b11,
        b12: b12, b13: b13, b14: b14, b15: b15
    };
}

pub fn vec16b_splat(v: Int) -> Vec16b {
    return Vec16b {
        b0: v, b1: v, b2: v, b3: v,
        b4: v, b5: v, b6: v, b7: v,
        b8: v, b9: v, b10: v, b11: v,
        b12: v, b13: v, b14: v, b15: v
    };
}

pub fn vec16b_zero() -> Vec16b {
    return Vec16b {
        b0: 0, b1: 0, b2: 0, b3: 0,
        b4: 0, b5: 0, b6: 0, b7: 0,
        b8: 0, b9: 0, b10: 0, b11: 0,
        b12: 0, b13: 0, b14: 0, b15: 0
    };
}
