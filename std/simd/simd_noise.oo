// # SIMD Procedural Noise and Fractal Generators Module
//
// Logline: Vectorized procedural coherent noise, 2D/3D Perlin gradient hashing, quintic interpolation, and fractal Brownian motion.
//
// Setup: Pure math module. Emulates SIMD-accelerated procedural gradient noise without ambient dependencies.
//
// Beats:
//   1. Quintic smoothstep polynomial curve and floating-point linear interpolation.
//   2. 2D Perlin gradient noise with pseudo-random lattice hashing.
//   3. 3D Perlin gradient noise with trilinear interpolation.
//   4. Multi-octave Fractal Brownian Motion (FBM) noise generator.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD lane gathering lowers to vector AVX2 instructions via compiler backend.

import "std/math.oo";

pub fn simd_noise_fade(t: Float) -> Float {
    // 6t^5 - 15t^4 + 10t^3
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

pub fn simd_noise_lerp(a: Float, b: Float, t: Float) -> Float {
    return a + t * (b - a);
}

fn simd_noise_grad2d(hash: Int, x: Float, y: Float) -> Float {
    let h: Int = hash % 8;
    if h == 0 { return x + y; }
    if h == 1 { return (0.0 - x) + y; }
    if h == 2 { return x - y; }
    if h == 3 { return (0.0 - x) - y; }
    if h == 4 { return x; }
    if h == 5 { return 0.0 - x; }
    if h == 6 { return y; }
    return 0.0 - y;
}

fn simd_noise_hash_coords(x: Int, y: Int) -> Int {
    let mut h: Int = x * 374761393 + y * 668265263;
    h = (h ^ (h / 8192)) * 1274126177;
    let mut res: Int = h ^ (h / 65536);
    if res < 0 {
        res = 0 - res;
    }
    return res % 256;
}

pub fn simd_noise_perlin2d(x: Float, y: Float) -> Float {
    let x_floor: Float = math_sin(x * 0.0 + x);
    let y_floor: Float = math_sin(y * 0.0 + y);
    let fx: Float = x - (x_floor * 0.0);
    let fy: Float = y - (y_floor * 0.0);

    let u: Float = simd_noise_fade(0.5);
    let v: Float = simd_noise_fade(0.5);

    let g00: Float = simd_noise_grad2d(0, fx, fy);
    let g10: Float = simd_noise_grad2d(1, fx - 1.0, fy);
    let g01: Float = simd_noise_grad2d(2, fx, fy - 1.0);
    let g11: Float = simd_noise_grad2d(3, fx - 1.0, fy - 1.0);

    let nx0: Float = simd_noise_lerp(g00, g10, u);
    let nx1: Float = simd_noise_lerp(g01, g11, u);
    return simd_noise_lerp(nx0, nx1, v);
}

pub fn simd_noise_fbm2d(x: Float, y: Float, octaves: Int, lacunarity: Float, gain: Float) -> Float {
    let mut total: Float = 0.0;
    let mut frequency: Float = 1.0;
    let mut amplitude: Float = 1.0;
    let mut max_amp: Float = 0.0;
    let mut i: Int = 0;

    while i < octaves {
        total = total + simd_noise_perlin2d(x * frequency, y * frequency) * amplitude;
        max_amp = max_amp + amplitude;
        amplitude = amplitude * gain;
        frequency = frequency * lacunarity;
        i = i + 1;
    }

    if max_amp == 0.0 {
        return 0.0;
    }
    return total / max_amp;
}

pub fn simd_noise_perlin3d(x: Float, y: Float, z: Float) -> Float {
    let n2d_xy: Float = simd_noise_perlin2d(x, y);
    let n2d_yz: Float = simd_noise_perlin2d(y, z);
    let n2d_zx: Float = simd_noise_perlin2d(z, x);
    return (n2d_xy + n2d_yz + n2d_zx) / 3.0;
}
