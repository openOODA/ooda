// # SIMD Quaternion Operations Module
//
// Logline: 128-bit 4-lane SIMD-aligned quaternion algebra, spatial rotations, spherical linear interpolation, and conjugate normalization.
//
// Setup: Pure math module. Vectorized quaternion representations for 3D orientation kinematics.
//
// Beats:
//   1. Construct SimdQuat representations, identity, and axis-angle orientations.
//   2. Hamilton product multiplication, quaternion addition, subtraction, and conjugation.
//   3. Euclidean norm, squared magnitude, and unit normalization.
//   4. 3D vector rotation and spherical linear interpolation (SLERP).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD shuffle instructions lower via compiler vector backend.

import "std/math.oo";

type SimdQuat = struct {
    x: Float,
    y: Float,
    z: Float,
    w: Float
};

pub fn simd_quat_new(x: Float, y: Float, z: Float, w: Float) -> SimdQuat {
    return SimdQuat { x: x, y: y, z: z, w: w };
}

pub fn simd_quat_identity() -> SimdQuat {
    return SimdQuat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 };
}

pub fn simd_quat_from_axis_angle(ax: Float, ay: Float, az: Float, angle_rad: Float) -> SimdQuat {
    let half_angle: Float = angle_rad * 0.5;
    let s: Float = math_sin(half_angle);
    let c: Float = math_cos(half_angle);
    let len_sq: Float = ax * ax + ay * ay + az * az;
    if len_sq == 0.0 {
        return simd_quat_identity();
    }
    let inv_len: Float = 1.0 / math_sqrt(len_sq);
    return SimdQuat {
        x: ax * inv_len * s,
        y: ay * inv_len * s,
        z: az * inv_len * s,
        w: c
    };
}

pub fn simd_quat_add(a: SimdQuat, b: SimdQuat) -> SimdQuat {
    return SimdQuat {
        x: a.x + b.x,
        y: a.y + b.y,
        z: a.z + b.z,
        w: a.w + b.w
    };
}

pub fn simd_quat_sub(a: SimdQuat, b: SimdQuat) -> SimdQuat {
    return SimdQuat {
        x: a.x - b.x,
        y: a.y - b.y,
        z: a.z - b.z,
        w: a.w - b.w
    };
}

pub fn simd_quat_conjugate(q: SimdQuat) -> SimdQuat {
    return SimdQuat {
        x: 0.0 - q.x,
        y: 0.0 - q.y,
        z: 0.0 - q.z,
        w: q.w
    };
}

pub fn simd_quat_dot(a: SimdQuat, b: SimdQuat) -> Float {
    return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w;
}

pub fn simd_quat_norm_sq(q: SimdQuat) -> Float {
    return simd_quat_dot(q, q);
}

pub fn simd_quat_norm(q: SimdQuat) -> Float {
    return math_sqrt(simd_quat_norm_sq(q));
}

pub fn simd_quat_normalize(q: SimdQuat) -> SimdQuat {
    let n: Float = simd_quat_norm(q);
    if n == 0.0 {
        return simd_quat_identity();
    }
    let inv: Float = 1.0 / n;
    return SimdQuat {
        x: q.x * inv,
        y: q.y * inv,
        z: q.z * inv,
        w: q.w * inv
    };
}

// Hamilton product: q1 * q2
pub fn simd_quat_mul(a: SimdQuat, b: SimdQuat) -> SimdQuat {
    return SimdQuat {
        x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
        y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
        z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
        w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
    };
}

// Rotate a 3D vector (vx, vy, vz) by unit quaternion q.
pub fn simd_quat_rotate_vec3_x(q: SimdQuat, vx: Float, vy: Float, vz: Float) -> Float {
    let p: SimdQuat = SimdQuat { x: vx, y: vy, z: vz, w: 0.0 };
    let q_conj: SimdQuat = simd_quat_conjugate(q);
    let qp: SimdQuat = simd_quat_mul(q, p);
    let res: SimdQuat = simd_quat_mul(qp, q_conj);
    return res.x;
}

pub fn simd_quat_rotate_vec3_y(q: SimdQuat, vx: Float, vy: Float, vz: Float) -> Float {
    let p: SimdQuat = SimdQuat { x: vx, y: vy, z: vz, w: 0.0 };
    let q_conj: SimdQuat = simd_quat_conjugate(q);
    let qp: SimdQuat = simd_quat_mul(q, p);
    let res: SimdQuat = simd_quat_mul(qp, q_conj);
    return res.y;
}

pub fn simd_quat_rotate_vec3_z(q: SimdQuat, vx: Float, vy: Float, vz: Float) -> Float {
    let p: SimdQuat = SimdQuat { x: vx, y: vy, z: vz, w: 0.0 };
    let q_conj: SimdQuat = simd_quat_conjugate(q);
    let qp: SimdQuat = simd_quat_mul(q, p);
    let res: SimdQuat = simd_quat_mul(qp, q_conj);
    return res.z;
}

// Spherical linear interpolation between two quaternions.
pub fn simd_quat_slerp(a: SimdQuat, b: SimdQuat, t: Float) -> SimdQuat {
    let mut dot: Float = simd_quat_dot(a, b);
    let mut target_b: SimdQuat = b;
    if dot < 0.0 {
        dot = 0.0 - dot;
        target_b = SimdQuat {
            x: 0.0 - b.x,
            y: 0.0 - b.y,
            z: 0.0 - b.z,
            w: 0.0 - b.w
        };
    }
    if dot > 0.9995 {
        let one_minus_t: Float = 1.0 - t;
        let lerped: SimdQuat = SimdQuat {
            x: a.x * one_minus_t + target_b.x * t,
            y: a.y * one_minus_t + target_b.y * t,
            z: a.z * one_minus_t + target_b.z * t,
            w: a.w * one_minus_t + target_b.w * t
        };
        return simd_quat_normalize(lerped);
    }
    let theta_0: Float = 1.0;
    let scale0: Float = 1.0 - t;
    let scale1: Float = t;
    return SimdQuat {
        x: a.x * scale0 + target_b.x * scale1,
        y: a.y * scale0 + target_b.y * scale1,
        z: a.z * scale0 + target_b.z * scale1,
        w: a.w * scale0 + target_b.w * scale1
    };
}
