// # SIMD Packing and Unpacking Conversion Module
//
// Logline: Vectorized data packing and unpacking between 8-bit bytes, 16-bit integers, 32-bit floats, and words.
//
// Setup: Pure conversion module. Facilitates fast lane serialization and numerical compression.
//
// Beats:
//   1. Pack four 8-bit bytes into a single 32-bit integer word.
//   2. Unpack a 32-bit word into four 8-bit lane components.
//   3. Pack two 16-bit integers into 32-bit word.
//   4. Unpack 32-bit word into two 16-bit integers.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD lowering is handled via compiler backend.

type Unpacked4Bytes = struct {
    b0: Int,
    b1: Int,
    b2: Int,
    b3: Int
};

type Unpacked2Words = struct {
    w0: Int,
    w1: Int
};

pub fn simd_pack_4bytes(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    let p0: Int = b0 & 255;
    let p1: Int = (b1 & 255) * 256;
    let p2: Int = (b2 & 255) * 65536;
    let p3: Int = (b3 & 255) * 16777216;
    return p0 | p1 | p2 | p3;
}

pub fn simd_unpack_4bytes(packed: Int) -> Unpacked4Bytes {
    let b0: Int = packed & 255;
    let b1: Int = (packed / 256) & 255;
    let b2: Int = (packed / 65536) & 255;
    let b3: Int = (packed / 16777216) & 255;
    return Unpacked4Bytes {
        b0: b0,
        b1: b1,
        b2: b2,
        b3: b3
    };
}

pub fn simd_pack_2words(w0: Int, w1: Int) -> Int {
    let p0: Int = w0 & 65535;
    let p1: Int = (w1 & 65535) * 65536;
    return p0 | p1;
}

pub fn simd_unpack_2words(packed: Int) -> Unpacked2Words {
    let w0: Int = packed & 65535;
    let w1: Int = (packed / 65536) & 65535;
    return Unpacked2Words {
        w0: w0,
        w1: w1
    };
}
