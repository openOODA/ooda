// # 4-Wide Single-Precision SIMD Float Vector Module
//
// Logline: 128-bit 4-lane single-precision floating-point SIMD vector operations, arithmetic, and geometric reductions.
//
// Setup: Pure math module. Emulates 4-wide float vector processing (SSE/NEON) for fast parallel arithmetic.
//
// Beats:
//   1. Construct 4-lane float vector structures, splats, and zero initializers.
//   2. Element-wise vector addition, subtraction, multiplication, division, and scale.
//   3. Fused multiply-add (FMA), min, max, and element access.
//   4. Vector dot product, Euclidean norm, and unit normalization.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware vector intrinsics are lowered to host SSE/AVX via compiler backend.

type Vec4f = struct {
    x: Float,
    y: Float,
    z: Float,
    w: Float
};

pub fn vec4f_new(x: Float, y: Float, z: Float, w: Float) -> Vec4f {
    return Vec4f { x: x, y: y, z: z, w: w };
}

pub fn vec4f_splat(v: Float) -> Vec4f {
    return Vec4f { x: v, y: v, z: v, w: v };
}

pub fn vec4f_zero() -> Vec4f {
    return Vec4f { x: 0.0, y: 0.0, z: 0.0, w: 0.0 };
}

pub fn vec4f_add(a: Vec4f, b: Vec4f) -> Vec4f {
    return Vec4f {
        x: a.x + b.x,
        y: a.y + b.y,
        z: a.z + b.z,
        w: a.w + b.w
    };
}

pub fn vec4f_sub(a: Vec4f, b: Vec4f) -> Vec4f {
    return Vec4f {
        x: a.x - b.x,
        y: a.y - b.y,
        z: a.z - b.z,
        w: a.w - b.w
    };
}

pub fn vec4f_mul(a: Vec4f, b: Vec4f) -> Vec4f {
    return Vec4f {
        x: a.x * b.x,
        y: a.y * b.y,
        z: a.z * b.z,
        w: a.w * b.w
    };
}

pub fn vec4f_div(a: Vec4f, b: Vec4f) -> Vec4f {
    let mut bx: Float = b.x;
    let mut by: Float = b.y;
    let mut bz: Float = b.z;
    let mut bw: Float = b.w;
    if bx == 0.0 { bx = 1.0; }
    if by == 0.0 { by = 1.0; }
    if bz == 0.0 { bz = 1.0; }
    if bw == 0.0 { bw = 1.0; }
    return Vec4f {
        x: a.x / bx,
        y: a.y / by,
        z: a.z / bz,
        w: a.w / bw
    };
}

pub fn vec4f_scale(v: Vec4f, s: Float) -> Vec4f {
    return Vec4f {
        x: v.x * s,
        y: v.y * s,
        z: v.z * s,
        w: v.w * s
    };
}

pub fn vec4f_fma(a: Vec4f, b: Vec4f, c: Vec4f) -> Vec4f {
    return Vec4f {
        x: a.x * b.x + c.x,
        y: a.y * b.y + c.y,
        z: a.z * b.z + c.z,
        w: a.w * b.w + c.w
    };
}

pub fn vec4f_dot(a: Vec4f, b: Vec4f) -> Float {
    return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w;
}

pub fn vec4f_hadd(v: Vec4f) -> Float {
    return v.x + v.y + v.z + v.w;
}

pub fn vec4f_norm_sq(v: Vec4f) -> Float {
    return vec4f_dot(v, v);
}

pub fn vec4f_norm(v: Vec4f) -> Float {
    let sq: Float = vec4f_dot(v, v);
    return sqrt(sq);
}

pub fn vec4f_normalize(v: Vec4f) -> Vec4f {
    let len: Float = vec4f_norm(v);
    if len == 0.0 {
        return vec4f_zero();
    }
    return vec4f_scale(v, 1.0 / len);
}

pub fn vec4f_min(a: Vec4f, b: Vec4f) -> Vec4f {
    let mut mx: Float = a.x;
    if b.x < mx { mx = b.x; }
    let mut my: Float = a.y;
    if b.y < my { my = b.y; }
    let mut mz: Float = a.z;
    if b.z < mz { mz = b.z; }
    let mut mw: Float = a.w;
    if b.w < mw { mw = b.w; }
    return Vec4f { x: mx, y: my, z: mz, w: mw };
}

pub fn vec4f_max(a: Vec4f, b: Vec4f) -> Vec4f {
    let mut mx: Float = a.x;
    if b.x > mx { mx = b.x; }
    let mut my: Float = a.y;
    if b.y > my { my = b.y; }
    let mut mz: Float = a.z;
    if b.z > mz { mz = b.z; }
    let mut mw: Float = a.w;
    if b.w > mw { mw = b.w; }
    return Vec4f { x: mx, y: my, z: mz, w: mw };
}

pub fn vec4f_get(v: Vec4f, idx: Int) -> Float {
    if idx == 0 { return v.x; }
    if idx == 1 { return v.y; }
    if idx == 2 { return v.z; }
    return v.w;
}
