// # 4-Wide Integer SIMD Vector Module
//
// Logline: 128-bit 4-lane integer SIMD vector operations, arithmetic, bitwise logic, and comparisons.
//
// Setup: Pure math module. Emulates 4-wide 32-bit integer SIMD vector processing (SSE2/NEON).
//
// Beats:
//   1. Construct 4-lane integer vector structures, splats, and zero initializers.
//   2. Element-wise integer addition, subtraction, multiplication, and scaling.
//   3. Bitwise min, max, dot product, and horizontal addition reductions.
//   4. Lane extraction, equality testing, and list conversion.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware vector intrinsics are lowered to host SSE2 via compiler backend.

type Vec4i = struct {
    x: Int,
    y: Int,
    z: Int,
    w: Int
};

pub fn vec4i_new(x: Int, y: Int, z: Int, w: Int) -> Vec4i {
    return Vec4i { x: x, y: y, z: z, w: w };
}

pub fn vec4i_splat(v: Int) -> Vec4i {
    return Vec4i { x: v, y: v, z: v, w: v };
}

pub fn vec4i_zero() -> Vec4i {
    return Vec4i { x: 0, y: 0, z: 0, w: 0 };
}

pub fn vec4i_add(a: Vec4i, b: Vec4i) -> Vec4i {
    return Vec4i {
        x: a.x + b.x,
        y: a.y + b.y,
        z: a.z + b.z,
        w: a.w + b.w
    };
}

pub fn vec4i_sub(a: Vec4i, b: Vec4i) -> Vec4i {
    return Vec4i {
        x: a.x - b.x,
        y: a.y - b.y,
        z: a.z - b.z,
        w: a.w - b.w
    };
}

pub fn vec4i_mul(a: Vec4i, b: Vec4i) -> Vec4i {
    return Vec4i {
        x: a.x * b.x,
        y: a.y * b.y,
        z: a.z * b.z,
        w: a.w * b.w
    };
}

pub fn vec4i_scale(v: Vec4i, s: Int) -> Vec4i {
    return Vec4i {
        x: v.x * s,
        y: v.y * s,
        z: v.z * s,
        w: v.w * s
    };
}

pub fn vec4i_min(a: Vec4i, b: Vec4i) -> Vec4i {
    let mut mx: Int = a.x;
    let bx: Int = b.x;
    if bx < mx {
        mx = bx;
    }
    let mut my: Int = a.y;
    let by: Int = b.y;
    if by < my {
        my = by;
    }
    let mut mz: Int = a.z;
    let bz: Int = b.z;
    if bz < mz {
        mz = bz;
    }
    let mut mw: Int = a.w;
    let bw: Int = b.w;
    if bw < mw {
        mw = bw;
    }
    return Vec4i { x: mx, y: my, z: mz, w: mw };
}

pub fn vec4i_max(a: Vec4i, b: Vec4i) -> Vec4i {
    let mut mx: Int = a.x;
    let bx: Int = b.x;
    if bx > mx {
        mx = bx;
    }
    let mut my: Int = a.y;
    let by: Int = b.y;
    if by > my {
        my = by;
    }
    let mut mz: Int = a.z;
    let bz: Int = b.z;
    if bz > mz {
        mz = bz;
    }
    let mut mw: Int = a.w;
    let bw: Int = b.w;
    if bw > mw {
        mw = bw;
    }
    return Vec4i { x: mx, y: my, z: mz, w: mw };
}

pub fn vec4i_hadd(v: Vec4i) -> Int {
    return v.x + v.y + v.z + v.w;
}

pub fn vec4i_dot(a: Vec4i, b: Vec4i) -> Int {
    return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w;
}

pub fn vec4i_get(v: Vec4i, idx: Int) -> Int {
    if idx == 0 { return v.x; }
    if idx == 1 { return v.y; }
    if idx == 2 { return v.z; }
    return v.w;
}

pub fn vec4i_eq(a: Vec4i, b: Vec4i) -> Bool {
    if a.x != b.x { return false; }
    if a.y != b.y { return false; }
    if a.z != b.z { return false; }
    if a.w != b.w { return false; }
    return true;
}

pub fn vec4i_to_list(v: Vec4i) -> List[Int] {
    let mut l: List[Int] = list_new();
    l = list_push(l, v.x);
    l = list_push(l, v.y);
    l = list_push(l, v.z);
    l = list_push(l, v.w);
    return l;
}
