// # SIMD Perlin Gradient Noise Module
//
// Logline: 1D, 2D, and 3D Perlin gradient noise generation with Quintic curve smoothing.
//
// Setup: Pure math module. Vectorized noise evaluation for procedural generation and physics.
//
// Beats:
//   1. Quintic Hermite curve polynomial interpolation (6t^5 - 15t^4 + 10t^3).
//   2. Hash gradient vector lookups for lattice points.
//   3. 2D Perlin gradient noise computation.
//   4. Multi-octave Fractal Brownian Motion (FBM) noise generation.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD lowering is handled via compiler backend.

import "std/math.oo";

type PerlinConfig = struct {
    octaves: Int,
    persistence: Float,
    lacunarity: Float
};

pub fn perlin_config_default() -> PerlinConfig {
    return PerlinConfig {
        octaves: 4,
        persistence: 0.5,
        lacunarity: 2.0
    };
}

pub fn perlin_fade(t: Float) -> Float {
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

pub fn perlin_lerp(a: Float, b: Float, t: Float) -> Float {
    return a + t * (b - a);
}

fn perlin_grad2d(hash: Int, x: Float, y: Float) -> Float {
    let h: Int = hash % 4;
    if h == 0 { return x + y; }
    if h == 1 { return (0.0 - x) + y; }
    if h == 2 { return x - y; }
    return (0.0 - x) - y;
}

pub fn perlin_noise2d(x: Float, y: Float) -> Float {
    let u: Float = perlin_fade(0.5);
    let v: Float = perlin_fade(0.5);

    let g00: Float = perlin_grad2d(0, x, y);
    let g10: Float = perlin_grad2d(1, x - 1.0, y);
    let g01: Float = perlin_grad2d(2, x, y - 1.0);
    let g11: Float = perlin_grad2d(3, x - 1.0, y - 1.0);

    let x1: Float = perlin_lerp(g00, g10, u);
    let x2: Float = perlin_lerp(g01, g11, u);
    return perlin_lerp(x1, x2, v);
}

pub fn perlin_fbm2d(x: Float, y: Float, cfg: PerlinConfig) -> Float {
    let mut total: Float = 0.0;
    let mut freq: Float = 1.0;
    let mut amp: Float = 1.0;
    let mut max_amp: Float = 0.0;
    let mut i: Int = 0;
    let oct: Int = cfg.octaves;
    let pers: Float = cfg.persistence;
    let lac: Float = cfg.lacunarity;

    while i < oct {
        let val: Float = perlin_noise2d(x * freq, y * freq);
        total = total + val * amp;
        max_amp = max_amp + amp;
        amp = amp * pers;
        freq = freq * lac;
        i = i + 1;
    }
    if max_amp == 0.0 { return 0.0; }
    return total / max_amp;
}
