// # OpenTelemetry W3C Span Context & TraceParent Header
//
// Logline: Implements OpenTelemetry W3C traceparent (trace_id, span_id, trace_flags) header parsing and generation.
//
// Setup: Distributed tracing propagation context standardizing cross-service request correlation.
//
// Beats:
//   1. Define SpanContext with 128-bit trace_id, 64-bit span_id, and 8-bit trace_flags.
//   2. Format W3C Traceparent header strings: version-trace_id-span_id-trace_flags.
//   3. Extract and validate traceparent fields from incoming HTTP headers.

pub type SpanContext = struct {
    trace_id: String,
    span_id: String,
    trace_flags: Int, // 1 = sampled
    is_remote: Bool
};

pub fn span_context_new(trace_id: String, span_id: String, sampled: Bool) -> SpanContext {
    let mut flags: Int = 0;
    if sampled {
        flags = 1;
    }
    return SpanContext {
        trace_id: trace_id,
        span_id: span_id,
        trace_flags: flags,
        is_remote: false
    };
}

pub fn span_context_is_valid(sc: &SpanContext) -> Bool {
    return (sc).trace_id != "" && (sc).span_id != "";
}

pub fn span_context_is_sampled(sc: &SpanContext) -> Bool {
    return (sc).trace_flags == 1;
}

pub fn span_context_to_traceparent(sc: &SpanContext) -> String {
    let mut flag_str: String = "00";
    if (sc).trace_flags == 1 {
        flag_str = "01";
    }
    return "00-" + (sc).trace_id + "-" + (sc).span_id + "-" + flag_str;
}
