// # Kubernetes Horizontal Pod Autoscaler (HPA) Controller
//
// Logline: Calculates desired replica count from CPU/memory metric utilization ratios with stabilization windows.
//
// Setup: Autonomous control loop scaling pod replica counts to match target utilization thresholds.
//
// Beats:
//   1. Configure min/max replica boundaries and target average CPU utilization percentage.
//   2. Calculate desired replicas using formula: ceil[current_replicas * (current_util / target_util)].
//   3. Apply scale-up/scale-down damping stabilization to prevent thrashing oscillation.

pub type HpaConfig = struct {
    name: String,
    namespace: String,
    target_deployment: String,
    min_replicas: Int,
    max_replicas: Int,
    target_cpu_utilization_percent: Int,
    scale_up_limit_percent: Int,
    scale_down_limit_percent: Int
};

pub type HpaState = struct {
    config: HpaConfig,
    current_replicas: Int,
    desired_replicas: Int,
    last_scale_ms: Int
};

pub fn hpa_state_new(
    name: String,
    ns: String,
    target_deploy: String,
    min_rep: Int,
    max_rep: Int,
    target_cpu: Int,
    now_ms: Int
) -> HpaState {
    let cfg: HpaConfig = HpaConfig {
        name: name,
        namespace: ns,
        target_deployment: target_deploy,
        min_replicas: min_rep,
        max_replicas: max_rep,
        target_cpu_utilization_percent: target_cpu,
        scale_up_limit_percent: 100, // max double
        scale_down_limit_percent: 50
    };
    return HpaState {
        config: cfg,
        current_replicas: min_rep,
        desired_replicas: min_rep,
        last_scale_ms: now_ms
    };
}

pub fn hpa_calculate_replicas(hpa: &mut HpaState, current_cpu_percent: Int) -> Int {
    let cur_rep: Int = (hpa).current_replicas;
    let target_cpu: Int = (hpa).config.target_cpu_utilization_percent;

    if target_cpu <= 0 || cur_rep <= 0 {
        return cur_rep;
    }

    // Ratio calculation with integer arithmetic: (cur_rep * current_cpu + target_cpu - 1) / target_cpu
    let mut raw_desired: Int = ((cur_rep * current_cpu_percent) + target_cpu - 1) / target_cpu;

    if raw_desired < (hpa).config.min_replicas {
        raw_desired = (hpa).config.min_replicas;
    }
    if raw_desired > (hpa).config.max_replicas {
        raw_desired = (hpa).config.max_replicas;
    }

    (hpa).desired_replicas = raw_desired;
    return raw_desired;
}
