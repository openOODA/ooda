// # Grow-Only Set CRDT (4-slot Int floor)
//
// Logline: G-Set add-only union. List[String] destubbed to four Int slots.
//
// Setup: e0..e3 hold members; 0 means empty slot. Add is idempotent.
//
// Beats:
//   1. add writes first empty slot if not already present.
//   2. contains scans slots.
//   3. merge unions remote members into local slots.

type GSet = struct {
    e0: Int,
    e1: Int,
    e2: Int,
    e3: Int
};

pub fn g_set_new() -> GSet {
    return GSet { e0: 0, e1: 0, e2: 0, e3: 0 };
}

pub fn g_set_contains(set: GSet, elem: Int) -> Int {
    if elem == 0 {
        return 0;
    }
    if set.e0 == elem {
        return 1;
    }
    if set.e1 == elem {
        return 1;
    }
    if set.e2 == elem {
        return 1;
    }
    if set.e3 == elem {
        return 1;
    }
    return 0;
}

pub fn g_set_add(set: GSet, elem: Int) -> GSet {
    if g_set_contains(set, elem) == 1 {
        return set;
    }
    if set.e0 == 0 {
        return GSet { e0: elem, e1: set.e1, e2: set.e2, e3: set.e3 };
    }
    if set.e1 == 0 {
        return GSet { e0: set.e0, e1: elem, e2: set.e2, e3: set.e3 };
    }
    if set.e2 == 0 {
        return GSet { e0: set.e0, e1: set.e1, e2: elem, e3: set.e3 };
    }
    if set.e3 == 0 {
        return GSet { e0: set.e0, e1: set.e1, e2: set.e2, e3: elem };
    }
    return set;
}

fn g_slot_occ(x: Int) -> Int {
    if x == 0 {
        return 0;
    }
    return 1;
}

pub fn g_set_len(set: GSet) -> Int {
    let a: Int = g_slot_occ(set.e0);
    let b: Int = g_slot_occ(set.e1);
    let c: Int = g_slot_occ(set.e2);
    let d: Int = g_slot_occ(set.e3);
    let ab: Int = a + b;
    let abc: Int = ab + c;
    return abc + d;
}

pub fn g_set_merge(local: GSet, remote: GSet) -> GSet {
    let s1: GSet = g_set_add(local, remote.e0);
    let s2: GSet = g_set_add(s1, remote.e1);
    let s3: GSet = g_set_add(s2, remote.e2);
    return g_set_add(s3, remote.e3);
}
