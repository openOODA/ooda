// # OpenTelemetry OTLP JSON Payload Exporter
//
// Logline: Formats OpenTelemetry Span and Resource records into compliant OTLP/HTTP JSON wire payloads.
//
// Setup: Observability export pipeline serializing telemetry batches for OTLP collector ingestion.
//
// Beats:
//   1. Model SpanRecord with span_id, trace_id, name, kind, timestamps, and status codes.
//   2. Structure resource attributes (service.name, host.name, telemetry.sdk.language).
//   3. Serialize batch into standardized OTLP/HTTP JSON schema format.

pub type OtelExportSpan = struct {
    trace_id: String,
    span_id: String,
    name: String,
    start_time_unix_nano: Int,
    end_time_unix_nano: Int,
    status_code: Int // 0=Unset, 1=Ok, 2=Error
};

pub type OtlpBatch = struct {
    service_name: String,
    spans: List[OtelExportSpan]
};

pub fn otlp_batch_new(svc_name: String) -> OtlpBatch {
    let empty_spans: List[OtelExportSpan] = list_new();
    return OtlpBatch {
        service_name: svc_name,
        spans: empty_spans
    };
}

pub fn otlp_batch_add_span(
    batch: &mut OtlpBatch,
    trace_id: String,
    span_id: String,
    name: String,
    start_ns: Int,
    end_ns: Int,
    status: Int
) {
    let s: OtelExportSpan = OtelExportSpan {
        trace_id: trace_id,
        span_id: span_id,
        name: name,
        start_time_unix_nano: start_ns,
        end_time_unix_nano: end_ns,
        status_code: status
    };
    (batch).spans = list_push((batch).spans, s);
}

pub fn otlp_batch_span_count(batch: &OtlpBatch) -> Int {
    return list_len((batch).spans);
}
