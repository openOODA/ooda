// # Smooth Weighted Round-Robin (2-backend Int floor)
//
// Logline: Nginx SWRR for two backends. By-value destub off List[struct].
//
// Setup: Weights w0/w1 and current weights cw0/cw1.
//
// Beats:
//   1. next adds weight to current, picks max, subtracts total from winner.
//   2. last_pick is 0 or 1.
//   3. Same algorithm as cloud/load_balancer_rr.oo.

type RoundRobinBalancer = struct {
    w0: Int,
    w1: Int,
    cw0: Int,
    cw1: Int,
    last_pick: Int
};

pub fn round_robin_balancer_new(w0: Int, w1: Int) -> RoundRobinBalancer {
    return RoundRobinBalancer { w0: w0, w1: w1, cw0: 0, cw1: 0, last_pick: 0 - 1 };
}

pub fn round_robin_next(b: RoundRobinBalancer) -> RoundRobinBalancer {
    let a: Int = b.cw0 + b.w0;
    let c: Int = b.cw1 + b.w1;
    let total: Int = b.w0 + b.w1;
    if a >= c {
        return RoundRobinBalancer {
            w0: b.w0,
            w1: b.w1,
            cw0: a - total,
            cw1: c,
            last_pick: 0
        };
    }
    return RoundRobinBalancer {
        w0: b.w0,
        w1: b.w1,
        cw0: a,
        cw1: c - total,
        last_pick: 1
    };
}

pub fn round_robin_last_pick(b: RoundRobinBalancer) -> Int {
    return b.last_pick;
}
