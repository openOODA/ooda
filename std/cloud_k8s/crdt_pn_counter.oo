// # Positive-Negative Counter CRDT (2-replica Int floor)
//
// Logline: PN-Counter value = P - N. By-value destub off List[struct].
//
// Setup: Two replicas (0 and 1). Increment writes P; decrement writes N.
//
// Beats:
//   1. increment(replica, delta) adds to that replica's P.
//   2. decrement adds to N. read is (p0+p1) - (n0+n1).
//   3. merge takes pairwise max of P and of N.

type PNCounter = struct {
    p0: Int,
    p1: Int,
    n0: Int,
    n1: Int
};

pub fn pn_counter_new() -> PNCounter {
    return PNCounter { p0: 0, p1: 0, n0: 0, n1: 0 };
}

pub fn pn_counter_increment(c: PNCounter, replica: Int, delta: Int) -> PNCounter {
    if delta <= 0 {
        return c;
    }
    if replica == 0 {
        return PNCounter { p0: c.p0 + delta, p1: c.p1, n0: c.n0, n1: c.n1 };
    }
    return PNCounter { p0: c.p0, p1: c.p1 + delta, n0: c.n0, n1: c.n1 };
}

pub fn pn_counter_decrement(c: PNCounter, replica: Int, delta: Int) -> PNCounter {
    if delta <= 0 {
        return c;
    }
    if replica == 0 {
        return PNCounter { p0: c.p0, p1: c.p1, n0: c.n0 + delta, n1: c.n1 };
    }
    return PNCounter { p0: c.p0, p1: c.p1, n0: c.n0, n1: c.n1 + delta };
}

pub fn pn_counter_read(c: PNCounter) -> Int {
    return (c.p0 + c.p1) - (c.n0 + c.n1);
}

fn pn_max(a: Int, b: Int) -> Int {
    if a > b {
        return a;
    }
    return b;
}

pub fn pn_counter_merge(a: PNCounter, b: PNCounter) -> PNCounter {
    return PNCounter {
        p0: pn_max(a.p0, b.p0),
        p1: pn_max(a.p1, b.p1),
        n0: pn_max(a.n0, b.n0),
        n1: pn_max(a.n1, b.n1)
    };
}
