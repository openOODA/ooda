// # Multi-Value Register CRDT (2-slot Int floor)
//
// Logline: MV-Register keeps concurrent sibling writes; dominated clocks drop. By-value destub.
//
// Setup: Two value slots with 2-node clocks (a,b). filled is occupancy. No VectorClock import.
//
// Beats:
//   1. write drops slots whose clock precedes the new clock.
//   2. write always stores the new value.
//   3. concurrent clocks keep a sibling in the second slot.

type MvRegister = struct {
    v0: Int,
    a0: Int,
    b0: Int,
    v1: Int,
    a1: Int,
    b1: Int,
    filled: Int
};

type MvRead = struct {
    v0: Int,
    v1: Int,
    filled: Int
};

pub fn mv_register_new() -> MvRegister {
    return MvRegister { v0: 0, a0: 0, b0: 0, v1: 0, a1: 0, b1: 0, filled: 0 };
}

fn mv_has_gt(x0: Int, x1: Int, y0: Int, y1: Int) -> Int {
    if x0 > y0 {
        return 1;
    }
    if x1 > y1 {
        return 1;
    }
    return 0;
}

fn mv_clock_compare(aa: Int, ab: Int, ba: Int, bb: Int) -> Int {
    let a_gt: Int = mv_has_gt(aa, ab, ba, bb);
    let b_gt: Int = mv_has_gt(ba, bb, aa, ab);
    if a_gt == 0 {
        if b_gt == 0 {
            return 0;
        }
        return 0 - 1;
    }
    if b_gt == 0 {
        return 1;
    }
    return 2;
}

fn mv_slot_live(filled: Int, idx: Int) -> Int {
    if filled > idx {
        return 1;
    }
    return 0;
}

fn mv_keep_slot(sa: Int, sb: Int, na: Int, nb: Int, live: Int) -> Int {
    if live == 0 {
        return 0;
    }
    let cmp: Int = mv_clock_compare(sa, sb, na, nb);
    let pred: Int = 0 - 1;
    if cmp == pred {
        return 0;
    }
    return 1;
}

pub fn mv_register_write(reg: MvRegister, val: Int, ca: Int, cb: Int) -> MvRegister {
    let k0: Int = mv_keep_slot(reg.a0, reg.b0, ca, cb, mv_slot_live(reg.filled, 0));
    let k1: Int = mv_keep_slot(reg.a1, reg.b1, ca, cb, mv_slot_live(reg.filled, 1));
    if k0 == 1 {
        return MvRegister {
            v0: reg.v0,
            a0: reg.a0,
            b0: reg.b0,
            v1: val,
            a1: ca,
            b1: cb,
            filled: 2
        };
    }
    if k1 == 1 {
        return MvRegister {
            v0: reg.v1,
            a0: reg.a1,
            b0: reg.b1,
            v1: val,
            a1: ca,
            b1: cb,
            filled: 2
        };
    }
    return MvRegister {
        v0: val,
        a0: ca,
        b0: cb,
        v1: 0,
        a1: 0,
        b1: 0,
        filled: 1
    };
}

pub fn mv_register_read(reg: MvRegister) -> MvRead {
    return MvRead { v0: reg.v0, v1: reg.v1, filled: reg.filled };
}
