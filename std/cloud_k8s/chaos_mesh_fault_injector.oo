// # Chaos Mesh Fault Injection Engine
//
// Logline: Simulates NetworkChaos latency/packet loss and PodChaos kill schedules for resilience validation.
//
// Setup: Chaos engineering fault injector verifying distributed system failover and recovery behavior.
//
// Beats:
//   1. Model fault injection actions: NetworkLatency, PacketDrop, PodKill, CPUStress.
//   2. Configure fault duration, jitter, probability, and target selector labels.
//   3. Evaluate probabilistic fault injection triggers against active requests.

pub type ChaosAction = Int; // 0=Latency, 1=Drop, 2=Kill, 3=Stress

pub type ChaosExperiment = struct {
    name: String,
    action: Int,
    target_selector: String,
    latency_ms: Int,
    jitter_ms: Int,
    drop_percent: Int,
    duration_sec: Int,
    is_active: Bool
};

pub fn chaos_network_latency(name: String, target: String, lat_ms: Int, dur_sec: Int) -> ChaosExperiment {
    return ChaosExperiment {
        name: name,
        action: 0, // Latency
        target_selector: target,
        latency_ms: lat_ms,
        jitter_ms: lat_ms / 5,
        drop_percent: 0,
        duration_sec: dur_sec,
        is_active: true
    };
}

pub fn chaos_network_drop(name: String, target: String, drop_pct: Int, dur_sec: Int) -> ChaosExperiment {
    return ChaosExperiment {
        name: name,
        action: 1, // Drop
        target_selector: target,
        latency_ms: 0,
        jitter_ms: 0,
        drop_percent: drop_pct,
        duration_sec: dur_sec,
        is_active: true
    };
}

pub fn chaos_should_drop_packet(exp: &ChaosExperiment, rand_sample: Int) -> Bool {
    if !(exp).is_active || (exp).action != 1 {
        return false;
    }
    let mut sample_val: Int = rand_sample % 100;
    if sample_val < 0 {
        sample_val = 0 - sample_val;
    }
    return sample_val < (exp).drop_percent;
}
