// # Weighted Random Load Balancer
//
// Logline: Implements alias/cumulative distribution weighted random selection for backend distribution.
//
// Setup: Probabilistic load balancer routing requests proportionally to server capacities.
//
// Beats:
//   1. Build cumulative weight distribution array over healthy backend endpoints.
//   2. Sample random offset in [0, total_weight) using linear congruential pseudorandom generator.
//   3. Locate matching backend bucket via cumulative prefix sum comparison.

pub type WeightedRandomBackend = struct {
    id: String,
    weight: Int,
    is_healthy: Bool,
};

pub type WeightedRandomBalancer = struct {
    backends: List[WeightedRandomBackend],
    rng_state: Int,
};

pub fn weighted_random_balancer_new(seed: Int) -> WeightedRandomBalancer {
    let empty_list: List[WeightedRandomBackend] = list_new();
    let mut initial_seed: Int = seed;
    if initial_seed <= 0 {
        initial_seed = 123456789;
    }
    return WeightedRandomBalancer {
        backends: empty_list,
        rng_state: initial_seed,
    };
}

pub fn weighted_random_add(b: &mut WeightedRandomBalancer, id: String, weight: Int) {
    let backend: WeightedRandomBackend = WeightedRandomBackend {
        id: id,
        weight: weight,
        is_healthy: true,
    };
    (b).backends = list_push((b).backends, backend);
}

pub fn weighted_random_select(b: &mut WeightedRandomBalancer) -> String {
    let n: Int = list_len((b).backends);
    if n == 0 {
        return "";
    }

    let mut total_weight: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let be: WeightedRandomBackend = list_get((b).backends, i);
        if (be).is_healthy {
            total_weight = total_weight + (be).weight;
        }
        i = i + 1;
    }

    if total_weight <= 0 {
        return "";
    }

    // LCG PRNG
    (b).rng_state = ((b).rng_state * 1103515245 + 12345) % 2147483647;
    let mut pick: Int = (b).rng_state % total_weight;
    if pick < 0 {
        pick = 0 - pick;
    }

    let mut acc: Int = 0;
    let mut j: Int = 0;
    while j < n {
        let be: WeightedRandomBackend = list_get((b).backends, j);
        if (be).is_healthy {
            acc = acc + (be).weight;
            if pick < acc {
                return (be).id;
            }
        }
        j = j + 1;
    }

    let first: WeightedRandomBackend = list_get((b).backends, 0);
    return (first).id;
}
