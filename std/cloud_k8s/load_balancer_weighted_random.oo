// # Weighted Random Load Balancer
//
// Logline: Cumulative distribution weighted random selection for backend distribution.
//
// Setup: Probabilistic load balancer routing requests proportionally to server capacities.
//
// Beats:
//   1. Sample random offset using LCG pseudorandom generator.
//   2. Select backend index proportionally to weights w0 and w1.
//   3. By-value destub off List[struct].

type WeightedRandomBalancer = struct {
    w0: Int,
    w1: Int,
    rng_state: Int,
    last_pick: Int
};

pub fn weighted_random_w0(b: WeightedRandomBalancer) -> Int {
    return b.w0;
}

pub fn weighted_random_w1(b: WeightedRandomBalancer) -> Int {
    return b.w1;
}

pub fn weighted_random_balancer_new(w0: Int, w1: Int, seed: Int) -> WeightedRandomBalancer {
    let mut s: Int = seed;
    if s <= 0 {
        s = 123456789;
    }
    return WeightedRandomBalancer {
        w0: w0,
        w1: w1,
        rng_state: s,
        last_pick: 0 - 1
    };
}

pub fn weighted_random_select(b: WeightedRandomBalancer) -> WeightedRandomBalancer {
    let weight0: Int = weighted_random_w0(b);
    let weight1: Int = weighted_random_w1(b);
    let total: Int = weight0 + weight1;
    if total <= 0 {
        return WeightedRandomBalancer {
            w0: weight0,
            w1: weight1,
            rng_state: b.rng_state,
            last_pick: 0
        };
    }
    let next_rng: Int = (b.rng_state * 1103515245 + 12345) % 2147483647;
    let mut pick: Int = next_rng % total;
    if pick < 0 {
        pick = 0 - pick;
    }
    if pick < weight0 {
        return WeightedRandomBalancer {
            w0: weight0,
            w1: weight1,
            rng_state: next_rng,
            last_pick: 0
        };
    }
    return WeightedRandomBalancer {
        w0: weight0,
        w1: weight1,
        rng_state: next_rng,
        last_pick: 1
    };
}

pub fn weighted_random_last_pick(b: WeightedRandomBalancer) -> Int {
    return b.last_pick;
}
