// # AWS S3 Signature Version 4 (SigV4) Request Signer
//
// Logline: Implements AWS SigV4 canonical request construction, credential scope derivation, and Authorization header generation.
//
// Setup: Cryptographic authentication protocol signing REST requests to S3 and compatible object storage.
//
// Beats:
//   1. Build Canonical Request (HTTPMethod, CanonicalURI, CanonicalQueryString, CanonicalHeaders).
//   2. Derive Credential Scope: date / region / service / aws4_request.
//   3. Compute StringToSign and construct Authorization header.

pub type SigV4Credentials = struct {
    access_key_id: String,
    secret_access_key: String,
    region: String,
    service: String,
};

pub type SigV4Request = struct {
    method: String,
    uri: String,
    query_string: String,
    date_stamp: String, // YYYYMMDD
    amz_date: String,   // YYYYMMDD'T'HHMMSS'Z'
    payload_hash: String,
};

pub fn sigv4_credentials_new(key: String, secret: String, region: String, svc: String) -> SigV4Credentials {
    return SigV4Credentials {
        access_key_id: key,
        secret_access_key: secret,
        region: region,
        service: svc,
    };
}

pub fn sigv4_credential_scope(creds: &SigV4Credentials, date_stamp: String) -> String {
    return date_stamp + "/" + (creds).region + "/" + (creds).service + "/aws4_request";
}

pub fn sigv4_string_to_sign(
    creds: &SigV4Credentials,
    req: &SigV4Request,
    canonical_request_hash: String
) -> String {
    let scope: String = sigv4_credential_scope(creds, (req).date_stamp);
    return "AWS4-HMAC-SHA256\n" + (req).amz_date + "\n" + scope + "\n" + canonical_request_hash;
}
