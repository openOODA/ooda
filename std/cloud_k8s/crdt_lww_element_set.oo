// # Last-Write-Wins Element Set (single-element Int floor)
//
// Logline: Membership if add_ts > rem_ts (add-bias on equal). By-value destub.
//
// Setup: One element id. List[struct] destubbed to add_ts / rem_ts / bias.
//
// Beats:
//   1. add writes add_ts if now is newer.
//   2. remove writes rem_ts if now is newer.
//   3. contains: add_ts > rem_ts, or equal and add_bias==1.

type LwwSet = struct {
    elem: Int,
    add_ts: Int,
    rem_ts: Int,
    add_bias: Int
};

pub fn lww_set_new(elem: Int, add_bias: Int) -> LwwSet {
    return LwwSet { elem: elem, add_ts: 0, rem_ts: 0, add_bias: add_bias };
}

pub fn lww_set_add(set: LwwSet, now_ms: Int) -> LwwSet {
    if now_ms > set.add_ts {
        return LwwSet { elem: set.elem, add_ts: now_ms, rem_ts: set.rem_ts, add_bias: set.add_bias };
    }
    return set;
}

pub fn lww_set_remove(set: LwwSet, now_ms: Int) -> LwwSet {
    if now_ms > set.rem_ts {
        return LwwSet { elem: set.elem, add_ts: set.add_ts, rem_ts: now_ms, add_bias: set.add_bias };
    }
    return set;
}

pub fn lww_set_contains(set: LwwSet) -> Int {
    if set.add_ts > set.rem_ts {
        return 1;
    }
    if set.add_ts == set.rem_ts {
        if set.add_bias == 1 {
            if set.add_ts > 0 {
                return 1;
            }
        }
    }
    return 0;
}

fn lww_max(x: Int, y: Int) -> Int {
    if x > y {
        return x;
    }
    return y;
}

pub fn lww_set_merge(a: LwwSet, b: LwwSet) -> LwwSet {
    return LwwSet {
        elem: a.elem,
        add_ts: lww_max(a.add_ts, b.add_ts),
        rem_ts: lww_max(a.rem_ts, b.rem_ts),
        add_bias: a.add_bias
    };
}
