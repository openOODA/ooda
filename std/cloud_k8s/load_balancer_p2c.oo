// # Power of Two Random Choices (P2C) Load Balancer
//
// Logline: Implements Michael Mitzenmacher's Power of Two Random Choices algorithm minimizing maximum load.
//
// Setup: Low-overhead sub-sampling load balancer picking the least loaded of two randomly sampled backends.
//
// Beats:
//   1. Track active inflight request counts and server health status across upstream pool.
//   2. Uniformly pick two distinct candidate servers via pseudo-random indexing.
//   3. Dispatch request to candidate with fewer inflight connections, breaking ties randomly.

pub type P2cBackend = struct {
    id: String,
    inflight_requests: Int,
    is_healthy: Bool
};

pub type P2cBalancer = struct {
    backends: List[P2cBackend],
    rng_state: Int
};

pub fn p2c_balancer_new(seed: Int) -> P2cBalancer {
    let empty_list: List[P2cBackend] = list_new();
    let mut initial_seed: Int = seed;
    if initial_seed <= 0 {
        initial_seed = 987654321;
    }
    return P2cBalancer {
        backends: empty_list,
        rng_state: initial_seed
    };
}

pub fn p2c_add_backend(b: &mut P2cBalancer, id: String) {
    let backend: P2cBackend = P2cBackend {
        id: id,
        inflight_requests: 0,
        is_healthy: true
    };
    (b).backends = list_push((b).backends, backend);
}

pub fn p2c_next_prng(b: &mut P2cBalancer) -> Int {
    (b).rng_state = ((b).rng_state * 1664525 + 1013904223) % 2147483647;
    let mut res: Int = (b).rng_state;
    if res < 0 {
        res = 0 - res;
    }
    return res;
}

pub fn p2c_select(b: &mut P2cBalancer) -> Int {
    let n: Int = list_len((b).backends);
    if n == 0 {
        return -1;
    }
    if n == 1 {
        return 0;
    }

    let idx1: Int = p2c_next_prng(b) % n;
    let mut idx2: Int = p2c_next_prng(b) % n;
    if idx1 == idx2 {
        idx2 = (idx1 + 1) % n;
    }

    let b1: P2cBackend = list_get((b).backends, idx1);
    let b2: P2cBackend = list_get((b).backends, idx2);

    if (b1).inflight_requests <= (b2).inflight_requests {
        return idx1;
    }
    return idx2;
}

pub fn p2c_acquire(b: &mut P2cBalancer, idx: Int) {
    let n: Int = list_len((b).backends);
    if idx >= 0 && idx < n {
        let mut target: P2cBackend = list_get((b).backends, idx);
        (target).inflight_requests = (target).inflight_requests + 1;
    }
}

pub fn p2c_release(b: &mut P2cBalancer, idx: Int) {
    let n: Int = list_len((b).backends);
    if idx >= 0 && idx < n {
        let mut target: P2cBackend = list_get((b).backends, idx);
        if (target).inflight_requests > 0 {
            (target).inflight_requests = (target).inflight_requests - 1;
        }
    }
}
