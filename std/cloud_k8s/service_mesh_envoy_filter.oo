// # Service Mesh Envoy Route Filter & Header Mutator
//
// Logline: Implements Envoy HTTP Connection Manager route matching, prefix rewriting, and header mutations.
//
// Setup: Data-plane proxy filter evaluating URL paths and applying traffic policies.
//
// Beats:
//   1. Match incoming HTTP paths against exact, prefix, or default routing rules.
//   2. Rewrite request prefixes and redirect traffic to designated upstream clusters.
//   3. By-value destub off List[struct].

type HttpHeader = struct {
    key: String,
    value: String
};

type EnvoyRoute = struct {
    prefix_match: String,
    cluster_name: String,
    prefix_rewrite: String,
    timeout_ms: Int
};

type EnvoyRouteTable = struct {
    p0: String,
    c0: String,
    rw0: String,
    t0: Int,
    p1: String,
    c1: String,
    rw1: String,
    t1: Int,
    route_count: Int,
    default_cluster: String
};

type FilterResult = struct {
    matched_cluster: String,
    rewritten_path: String,
    timeout_ms: Int,
    is_routed: Bool
};

pub fn filter_result_cluster(res: FilterResult) -> String {
    return res.matched_cluster;
}

pub fn filter_result_rewritten_path(res: FilterResult) -> String {
    return res.rewritten_path;
}

pub fn filter_result_timeout(res: FilterResult) -> Int {
    return res.timeout_ms;
}

pub fn filter_result_is_routed(res: FilterResult) -> Bool {
    return res.is_routed;
}

pub fn envoy_route_table_new(default_cluster: String) -> EnvoyRouteTable {
    return EnvoyRouteTable {
        p0: "",
        c0: "",
        rw0: "",
        t0: 0,
        p1: "",
        c1: "",
        rw1: "",
        t1: 0,
        route_count: 0,
        default_cluster: default_cluster
    };
}

pub fn envoy_add_route(
    table: EnvoyRouteTable,
    prefix: String,
    cluster: String,
    rewrite: String,
    timeout_ms: Int
) -> EnvoyRouteTable {
    if table.route_count == 0 {
        return EnvoyRouteTable {
            p0: prefix,
            c0: cluster,
            rw0: rewrite,
            t0: timeout_ms,
            p1: table.p1,
            c1: table.c1,
            rw1: table.rw1,
            t1: table.t1,
            route_count: 1,
            default_cluster: table.default_cluster
        };
    }
    return EnvoyRouteTable {
        p0: table.p0,
        c0: table.c0,
        rw0: table.rw0,
        t0: table.t0,
        p1: prefix,
        c1: cluster,
        rw1: rewrite,
        t1: timeout_ms,
        route_count: table.route_count + 1,
        default_cluster: table.default_cluster
    };
}

pub fn envoy_match_route(table: EnvoyRouteTable, request_path: String) -> FilterResult {
    if table.route_count > 0 {
        if table.p0 == "/" || table.p0 == request_path {
            return FilterResult {
                matched_cluster: table.c0,
                rewritten_path: table.rw0,
                timeout_ms: table.t0,
                is_routed: true
            };
        }
    }
    if table.route_count > 1 {
        if table.p1 == "/" || table.p1 == request_path {
            return FilterResult {
                matched_cluster: table.c1,
                rewritten_path: table.rw1,
                timeout_ms: table.t1,
                is_routed: true
            };
        }
    }
    return FilterResult {
        matched_cluster: table.default_cluster,
        rewritten_path: request_path,
        timeout_ms: 5000,
        is_routed: true
    };
}
