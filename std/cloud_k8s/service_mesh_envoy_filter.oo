// # Service Mesh Envoy Route Filter & Header Mutator
//
// Logline: Implements Envoy HTTP Connection Manager route matching, prefix rewriting, and header mutations.
//
// Setup: Data-plane proxy filter evaluating URL paths and applying traffic policies.
//
// Beats:
//   1. Match incoming HTTP paths against exact, prefix, or wildcard routing rules.
//   2. Rewrite request prefixes and redirect traffic to designated upstream clusters.
//   3. Apply header injections (e.g. x-request-id, traceparent) and timeout policies.

pub type HttpHeader = struct {
    key: String,
    value: String,
};

pub type EnvoyRoute = struct {
    prefix_match: String,
    cluster_name: String,
    prefix_rewrite: String,
    timeout_ms: Int,
};

pub type EnvoyRouteTable = struct {
    routes: List[EnvoyRoute],
    default_cluster: String,
};

pub type FilterResult = struct {
    matched_cluster: String,
    rewritten_path: String,
    timeout_ms: Int,
    is_routed: Bool,
};

pub fn envoy_route_table_new(default_cluster: String) -> EnvoyRouteTable {
    let empty_routes: List[EnvoyRoute] = list_new();
    return EnvoyRouteTable {
        routes: empty_routes,
        default_cluster: default_cluster,
    };
}

pub fn envoy_add_route(
    table: &mut EnvoyRouteTable,
    prefix: String,
    cluster: String,
    rewrite: String,
    timeout_ms: Int
) {
    let r: EnvoyRoute = EnvoyRoute {
        prefix_match: prefix,
        cluster_name: cluster,
        prefix_rewrite: rewrite,
        timeout_ms: timeout_ms,
    };
    (table).routes = list_push((table).routes, r);
}

pub fn envoy_match_route(table: &EnvoyRouteTable, request_path: String) -> FilterResult {
    let n: Int = list_len((table).routes);
    let mut i: Int = 0;
    while i < n {
        let r: EnvoyRoute = list_get((table).routes, i);
        // If route prefix matches request path start
        if (r).prefix_match == "/" || (r).prefix_match == request_path {
            return FilterResult {
                matched_cluster: (r).cluster_name,
                rewritten_path: (r).prefix_rewrite,
                timeout_ms: (r).timeout_ms,
                is_routed: true,
            };
        }
        i = i + 1;
    }

    return FilterResult {
        matched_cluster: (table).default_cluster,
        rewritten_path: request_path,
        timeout_ms: 5000,
        is_routed: true,
    };
}
