// # Multi-Paxos Acceptor State Machine
//
// Logline: Implements Multi-Paxos slot-indexed Promise/Accept evaluation with persistent promise thresholds.
//
// Setup: Acceptor role in Multi-Paxos consensus keeping log slots, promised numbers, and accepted values.
//
// Beats:
//   1. Maintain per-slot state tracking promised_proposal, accepted_proposal, and accepted_value.
//   2. Evaluate Prepare requests across slots and return highest accepted proposal metadata.
//   3. Accept values for proposals >= promised_proposal and notify learners of commit status.

pub type MultiPaxosSlot = struct {
    slot_index: Int,
    promised_proposal: Int,
    accepted_proposal: Int,
    accepted_value: String,
    is_committed: Bool,
};

pub type MultiPaxosAcceptor = struct {
    acceptor_id: String,
    slots: List[MultiPaxosSlot],
    max_slot_index: Int,
};

pub fn multipaxos_slot_new(slot_index: Int) -> MultiPaxosSlot {
    return MultiPaxosSlot {
        slot_index: slot_index,
        promised_proposal: -1,
        accepted_proposal: -1,
        accepted_value: "",
        is_committed: false,
    };
}

pub fn multipaxos_acceptor_new(id: String) -> MultiPaxosAcceptor {
    let empty_slots: List[MultiPaxosSlot] = list_new();
    return MultiPaxosAcceptor {
        acceptor_id: id,
        slots: empty_slots,
        max_slot_index: 0,
    };
}

pub fn multipaxos_acceptor_prepare(
    acc: &mut MultiPaxosAcceptor,
    slot_idx: Int,
    prop_num: Int
) -> MultiPaxosSlot {
    let n: Int = list_len((acc).slots);
    let mut i: Int = 0;
    let mut found: Bool = false;
    let mut target: MultiPaxosSlot = multipaxos_slot_new(slot_idx);

    while i < n {
        let mut s: MultiPaxosSlot = list_get((acc).slots, i);
        if (s).slot_index == slot_idx {
            if prop_num > (s).promised_proposal {
                (s).promised_proposal = prop_num;
            }
            target = s;
            found = true;
        }
        i = i + 1;
    }

    if !found {
        (target).promised_proposal = prop_num;
        (acc).slots = list_push((acc).slots, target);
        if slot_idx > (acc).max_slot_index {
            (acc).max_slot_index = slot_idx;
        }
    }

    return target;
}

pub fn multipaxos_acceptor_accept(
    acc: &mut MultiPaxosAcceptor,
    slot_idx: Int,
    prop_num: Int,
    val: String
) -> Bool {
    let n: Int = list_len((acc).slots);
    let mut i: Int = 0;
    while i < n {
        let mut s: MultiPaxosSlot = list_get((acc).slots, i);
        if (s).slot_index == slot_idx {
            if prop_num >= (s).promised_proposal {
                (s).promised_proposal = prop_num;
                (s).accepted_proposal = prop_num;
                (s).accepted_value = val;
                return true;
            }
            return false;
        }
        i = i + 1;
    }

    let mut new_slot: MultiPaxosSlot = multipaxos_slot_new(slot_idx);
    (new_slot).promised_proposal = prop_num;
    (new_slot).accepted_proposal = prop_num;
    (new_slot).accepted_value = val;
    (acc).slots = list_push((acc).slots, new_slot);
    return true;
}
