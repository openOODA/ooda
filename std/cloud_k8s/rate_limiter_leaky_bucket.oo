// # Leaky Bucket Traffic Shaper
//
// Logline: Implements Leaky Bucket queue algorithm smoothing output rate and discarding overflow requests.
//
// Setup: Traffic shaping governor enforcing a strictly constant egress rate over time.
//
// Beats:
//   1. Track bucket capacity, constant leak rate per second, and current water level.
//   2. Calculate water leakage based on elapsed time since last leak event.
//   3. Accept incoming units if buffer capacity allows; drop packets that overflow.

pub type LeakyBucket = struct {
    capacity: Int,
    leak_rate_per_sec: Int,
    water_level: Int,
    last_leak_ms: Int,
    total_queued: Int,
    total_dropped: Int
};

pub fn leaky_bucket_new(capacity: Int, leak_rate_per_sec: Int, now_ms: Int) -> LeakyBucket {
    return LeakyBucket {
        capacity: capacity,
        leak_rate_per_sec: leak_rate_per_sec,
        water_level: 0,
        last_leak_ms: now_ms,
        total_queued: 0,
        total_dropped: 0
    };
}

pub fn leaky_bucket_leak(lb: &mut LeakyBucket, now_ms: Int) {
    let elapsed: Int = now_ms - (lb).last_leak_ms;
    if elapsed <= 0 {
        return;
    }

    let leaked: Int = (elapsed * (lb).leak_rate_per_sec) / 1000;
    if leaked > 0 {
        let mut new_lvl: Int = (lb).water_level - leaked;
        if new_lvl < 0 {
            new_lvl = 0;
        }
        (lb).water_level = new_lvl;
        (lb).last_leak_ms = now_ms;
    }
}

pub fn leaky_bucket_add(lb: &mut LeakyBucket, amount: Int, now_ms: Int) -> Bool {
    leaky_bucket_leak(lb, now_ms);

    if (lb).water_level + amount <= (lb).capacity {
        (lb).water_level = (lb).water_level + amount;
        (lb).total_queued = (lb).total_queued + 1;
        return true;
    }

    (lb).total_dropped = (lb).total_dropped + 1;
    return false;
}
