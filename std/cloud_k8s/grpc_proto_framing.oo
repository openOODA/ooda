// # gRPC Wire Framing & Length-Prefixed Message Codec
//
// Logline: Implements gRPC HTTP/2 length-prefixed binary message framing (1-byte compressed flag + 4-byte big-endian length).
//
// Setup: Low-level network framing packing and unpacking protobuf messages across HTTP/2 streams.
//
// Beats:
//   1. Define gRPC 5-byte header: compression flag (0/1) and 32-bit big-endian payload length.
//   2. Encode length-prefixed wire headers for outbound protobuf message bytes.
//   3. Parse incoming wire buffers, extracting message payload boundaries and decompression flags.

pub type GrpcWireFrame = struct {
    is_compressed: Bool,
    message_length: Int,
    payload_raw: String,
};

pub fn grpc_frame_new(compressed: Bool, length: Int, raw: String) -> GrpcWireFrame {
    return GrpcWireFrame {
        is_compressed: compressed,
        message_length: length,
        payload_raw: raw,
    };
}

pub fn grpc_frame_header_size() -> Int {
    return 5; // 1 byte compression + 4 bytes big-endian length
}

pub fn grpc_frame_validate(frame: &GrpcWireFrame, max_message_size: Int) -> Bool {
    if (frame).message_length < 0 {
        return false;
    }
    if (frame).message_length > max_message_size {
        return false;
    }
    return true;
}
