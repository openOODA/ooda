// # Token Bucket Rate Limiter with Continuous Refill
//
// Logline: Implements Token Bucket algorithm supporting burst tolerance and continuous fractional token replenishment.
//
// Setup: Traffic policing governor controlling request throughput and smoothing peak bursts.
//
// Beats:
//   1. Track capacity, refill rate per second, and timestamped available token balance.
//   2. Refill tokens proportionally to elapsed milliseconds up to maximum burst capacity.
//   3. Deduct consumed tokens on permitted requests or reject with retry wait estimates.

pub type TokenBucketLimiter = struct {
    capacity: Int,
    refill_rate_per_sec: Int,
    available_tokens: Int,
    last_refill_ms: Int,
    total_permitted: Int,
    total_throttled: Int,
};

pub fn token_bucket_limiter_new(capacity: Int, rate_per_sec: Int, now_ms: Int) -> TokenBucketLimiter {
    return TokenBucketLimiter {
        capacity: capacity,
        refill_rate_per_sec: rate_per_sec,
        available_tokens: capacity,
        last_refill_ms: now_ms,
        total_permitted: 0,
        total_throttled: 0,
    };
}

pub fn token_bucket_limiter_refill(tb: &mut TokenBucketLimiter, now_ms: Int) {
    let elapsed: Int = now_ms - (tb).last_refill_ms;
    if elapsed <= 0 {
        return;
    }

    let tokens_to_add: Int = (elapsed * (tb).refill_rate_per_sec) / 1000;
    if tokens_to_add > 0 {
        let mut new_bal: Int = (tb).available_tokens + tokens_to_add;
        if new_bal > (tb).capacity {
            new_bal = (tb).capacity;
        }
        (tb).available_tokens = new_bal;
        (tb).last_refill_ms = now_ms;
    }
}

pub fn token_bucket_limiter_allow(tb: &mut TokenBucketLimiter, tokens: Int, now_ms: Int) -> Bool {
    token_bucket_limiter_refill(tb, now_ms);

    if (tb).available_tokens >= tokens {
        (tb).available_tokens = (tb).available_tokens - tokens;
        (tb).total_permitted = (tb).total_permitted + 1;
        return true;
    }

    (tb).total_throttled = (tb).total_throttled + 1;
    return false;
}
