pub fn cloud_k8s_raft_election(node_id: String, cluster_size: Int, timeout_ms: Int, now_ms: Int) -> RaftElectionState {
    return raft_election_init(node_id, cluster_size, timeout_ms, now_ms);
}

pub fn cloud_k8s_hash_ring(vnodes: Int) -> HashRing {
    return hash_ring_new(vnodes);
}

pub fn cloud_k8s_swim_cluster(local_id: String, interval_ms: Int, timeout_ms: Int) -> SwimCluster {
    return swim_cluster_new(local_id, interval_ms, timeout_ms);
}

pub fn cloud_k8s_vector_clock() -> VectorClock {
    return vector_clock_new();
}

pub fn cloud_k8s_pn_counter() -> PNCounter {
    return pn_counter_new();
}

pub fn cloud_k8s_lww_set(add_bias: Bool) -> LwwSet {
    return lww_set_new(add_bias);
}

pub fn cloud_k8s_token_bucket(capacity: Int, rate: Int, now_ms: Int) -> TokenBucketLimiter {
    return token_bucket_limiter_new(capacity, rate, now_ms);
}

pub fn cloud_k8s_circuit_breaker(fail_th: Int, rec_th: Int, cd_ms: Int, now_ms: Int) -> HystereticCircuitBreaker {
    return hysteretic_circuit_breaker_new(fail_th, rec_th, cd_ms, now_ms);
}

pub fn cloud_k8s_pod_manifest(name: String, ns: String) -> PodManifest {
    return pod_manifest_new(name, ns);
}

pub fn cloud_k8s_deployment_spec(name: String, ns: String, replicas: Int, img: String) -> DeploymentSpec {
    return deployment_spec_new(name, ns, replicas, img);
}

pub fn cloud_k8s_span_context(trace_id: String, span_id: String, sampled: Bool) -> SpanContext {
    return span_context_new(trace_id, span_id, sampled);
}
