// # Kubernetes Role-Based Access Control (RBAC) Authorizer
//
// Logline: Evaluates ClusterRole and RoleBinding policy rules against API verb, API group, and resource requests.
//
// Setup: Security authorization engine enforcing principle of least privilege across Kubernetes API requests.
//
// Beats:
//   1. Define PolicyRule structs with api_groups, resources, resource_names, and verbs.
//   2. Bind Roles to Subjects (User, Group, ServiceAccount).
//   3. Authorize or reject API request attributes against bound policy rules.

pub type PolicyRule = struct {
    api_group: String,
    resource: String,
    verb: String, // get, list, watch, create, update, patch, delete
};

pub type RoleBinding = struct {
    name: String,
    namespace: String,
    subject_kind: String, // User, ServiceAccount, Group
    subject_name: String,
    role_name: String,
};

pub type RbacAuthorizer = struct {
    rules: List[PolicyRule],
    bindings: List[RoleBinding],
};

pub fn rbac_authorizer_new() -> RbacAuthorizer {
    let empty_r: List[PolicyRule] = list_new();
    let empty_b: List[RoleBinding] = list_new();
    return RbacAuthorizer {
        rules: empty_r,
        bindings: empty_b,
    };
}

pub fn rbac_add_rule(auth: &mut RbacAuthorizer, group: String, res: String, verb: String) {
    let r: PolicyRule = PolicyRule {
        api_group: group,
        resource: res,
        verb: verb,
    };
    (auth).rules = list_push((auth).rules, r);
}

pub fn rbac_authorize(
    auth: &RbacAuthorizer,
    group: String,
    res: String,
    verb: String
) -> Bool {
    let n: Int = list_len((auth).rules);
    let mut i: Int = 0;
    while i < n {
        let r: PolicyRule = list_get((auth).rules, i);
        let group_ok: Bool = (r).api_group == "*" || (r).api_group == group;
        let res_ok: Bool = (r).resource == "*" || (r).resource == res;
        let verb_ok: Bool = (r).verb == "*" || (r).verb == verb;

        if group_ok && res_ok && verb_ok {
            return true;
        }
        i = i + 1;
    }
    return false;
}
