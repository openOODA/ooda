// # etcd In-Memory Raft Storage & WAL Buffer
//
// Logline: Implements etcd raft.MemoryStorage maintaining uncompacted log entries, hard state, and snapshot references.
//
// Setup: Core storage engine backing etcd's consensus state machine and WAL synchronization.
//
// Beats:
//   1. Maintain in-memory log entries array with base index offset tracking.
//   2. Persist hard state (term, vote, commit) alongside raft entries.
//   3. Handle log appends with conflict truncation and snapshot compaction bounds.

pub type HardState = struct {
    term: Int,
    vote: String,
    commit: Int,
};

pub type RaftStorageEntry = struct {
    index: Int,
    term: Int,
    data: String,
};

pub type EtcdMemoryStorage = struct {
    hard_state: HardState,
    entries: List[RaftStorageEntry],
    first_index: Int,
};

pub fn etcd_memory_storage_new() -> EtcdMemoryStorage {
    let hs: HardState = HardState { term: 0, vote: "", commit: 0 };
    let mut initial_entries: List[RaftStorageEntry] = list_new();
    let dummy: RaftStorageEntry = RaftStorageEntry { index: 0, term: 0, data: "" };
    initial_entries = list_push(initial_entries, dummy);

    return EtcdMemoryStorage {
        hard_state: hs,
        entries: initial_entries,
        first_index: 0,
    };
}

pub fn etcd_storage_set_hardstate(st: &mut EtcdMemoryStorage, hs: HardState) {
    (st).hard_state = hs;
}

pub fn etcd_storage_append(st: &mut EtcdMemoryStorage, ent: RaftStorageEntry) {
    (st).entries = list_push((st).entries, ent);
}

pub fn etcd_storage_last_index(st: &EtcdMemoryStorage) -> Int {
    let n: Int = list_len((st).entries);
    if n == 0 {
        return (st).first_index;
    }
    let last: RaftStorageEntry = list_get((st).entries, n - 1);
    return (last).index;
}
