// # Paxos Synod Proposer Protocol
//
// Logline: Implements Single-Decree Paxos Phase 1 (Prepare/Promise) and Phase 2 (Accept/Accepted) proposal engine.
//
// Setup: Core classical consensus protocol proposer coordinating majority quorums and value convergence.
//
// Beats:
//   1. Generate monotonically increasing proposal numbers with unique node identifier tie-breaking.
//   2. Dispatch Prepare requests, collect Promise replies, and choose value with highest proposal number.
//   3. Dispatch Accept requests, gather Accepted acknowledgments, and broadcast committed decision.

pub type PaxosPrepare = struct {
    proposal_number: Int,
    proposer_id: String,
};

pub type PaxosPromise = struct {
    proposal_number: Int,
    accepted: Bool,
    max_accepted_proposal: Int,
    max_accepted_value: String,
};

pub type PaxosAccept = struct {
    proposal_number: Int,
    value: String,
};

pub type SynodProposer = struct {
    node_id: String,
    node_index: Int,
    round_number: Int,
    current_proposal: Int,
    proposed_value: String,
    cluster_size: Int,
    promises_received: Int,
    highest_seen_proposal: Int,
    chosen_value: String,
    is_decided: Bool,
};

pub fn synod_proposer_new(node_id: String, node_index: Int, cluster_size: Int) -> SynodProposer {
    return SynodProposer {
        node_id: node_id,
        node_index: node_index,
        round_number: 0,
        current_proposal: 0,
        proposed_value: "",
        cluster_size: cluster_size,
        promises_received: 0,
        highest_seen_proposal: -1,
        chosen_value: "",
        is_decided: false,
    };
}

/// Create next unique proposal number: round * 1000 + node_index.
pub fn synod_proposer_next_proposal(p: &mut SynodProposer, initial_val: String) -> PaxosPrepare {
    (p).round_number = (p).round_number + 1;
    (p).current_proposal = ((p).round_number * 1000) + (p).node_index;
    (p).proposed_value = initial_val;
    (p).promises_received = 0;
    (p).highest_seen_proposal = -1;
    (p).chosen_value = initial_val;

    return PaxosPrepare {
        proposal_number: (p).current_proposal,
        proposer_id: (p).node_id,
    };
}

/// Handle incoming promise response from an acceptor.
pub fn synod_proposer_handle_promise(
    p: &mut SynodProposer,
    promise: &PaxosPromise
) -> Bool {
    if !(promise).accepted || (promise).proposal_number != (p).current_proposal {
        return false;
    }

    (p).promises_received = (p).promises_received + 1;

    if (promise).max_accepted_proposal > (p).highest_seen_proposal {
        (p).highest_seen_proposal = (promise).max_accepted_proposal;
        (p).chosen_value = (promise).max_accepted_value;
    }

    let quorum: Int = ((p).cluster_size / 2) + 1;
    return (p).promises_received >= quorum;
}

/// Generate Paxos Accept request after securing majority promises.
pub fn synod_proposer_build_accept(p: &SynodProposer) -> PaxosAccept {
    return PaxosAccept {
        proposal_number: (p).current_proposal,
        value: (p).chosen_value,
    };
}
