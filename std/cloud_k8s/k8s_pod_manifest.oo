// # Kubernetes Pod Manifest Spec & Phase Lifecycle
//
// Logline: Models Kubernetes Pod object specifications, container descriptors, resource limits, and phase transitions.
//
// Setup: Fundamental workload primitive defining containerized tasks, volumes, restart policies, and lifecycle phases.
//
// Beats:
//   1. Define container resource requirements (CPU millis, memory bytes) and environment bindings.
//   2. Model PodSpec with container arrays, restart policies, and node selector constraints.
//   3. Compute aggregate resource requests and transition PodPhase (Pending, Running, Succeeded, Failed).

pub type ContainerResource = struct {
    cpu_millis: Int,
    memory_mb: Int
};

pub type ContainerSpec = struct {
    name: String,
    image: String,
    command: String,
    requests: ContainerResource,
    limits: ContainerResource
};

pub type PodManifest = struct {
    name: String,
    namespace: String,
    containers: List[ContainerSpec],
    restart_policy: String, // Always, OnFailure, Never
    node_name: String,
    phase: String // Pending, Running, Succeeded, Failed
};

pub fn pod_manifest_new(name: String, namespace: String) -> PodManifest {
    let empty_containers: List[ContainerSpec] = list_new();
    return PodManifest {
        name: name,
        namespace: namespace,
        containers: empty_containers,
        restart_policy: "Always",
        node_name: "",
        phase: "Pending"
    };
}

pub fn pod_add_container(
    pod: &mut PodManifest,
    name: String,
    image: String,
    req_cpu: Int,
    req_mem: Int
) {
    let req: ContainerResource = ContainerResource { cpu_millis: req_cpu, memory_mb: req_mem };
    let lim: ContainerResource = ContainerResource { cpu_millis: req_cpu * 2, memory_mb: req_mem * 2 };
    let c: ContainerSpec = ContainerSpec {
        name: name,
        image: image,
        command: "",
        requests: req,
        limits: lim
    };
    (pod).containers = list_push((pod).containers, c);
}

pub fn pod_total_requested_cpu(pod: &PodManifest) -> Int {
    let n: Int = list_len((pod).containers);
    let mut total: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: ContainerSpec = list_get((pod).containers, i);
        total = total + (c).requests.cpu_millis;
        i = i + 1;
    }
    return total;
}

pub fn pod_total_requested_memory(pod: &PodManifest) -> Int {
    let n: Int = list_len((pod).containers);
    let mut total: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: ContainerSpec = list_get((pod).containers, i);
        total = total + (c).requests.memory_mb;
        i = i + 1;
    }
    return total;
}
