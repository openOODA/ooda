// # Chubby-Style Distributed Lock & Fencing Sequencer
//
// Logline: Implements coarse-grained distributed lock leases with monotonic fencing tokens and keep-alive renew.
//
// Setup: Distributed mutual exclusion service providing safe lock acquisition and stale-request fencing.
//
// Beats:
//   1. Grant exclusive lock leases bound to client identifiers and expiration deadlines.
//   2. Issue monotonically increasing fencing tokens to defeat out-of-order delayed network writes.
//   3. Renew lock lease periods via periodic keep-alive heartbeats and release cleanly.

pub type FencingToken = struct {
    token_number: Int,
    holder_id: String,
    granted_at_ms: Int,
    lease_duration_ms: Int,
};

pub type ChubbyLock = struct {
    lock_name: String,
    current_holder: String,
    current_token: Int,
    lease_expires_ms: Int,
    is_locked: Bool,
};

pub fn chubby_lock_new(name: String) -> ChubbyLock {
    return ChubbyLock {
        lock_name: name,
        current_holder: "",
        current_token: 0,
        lease_expires_ms: 0,
        is_locked: false,
    };
}

pub fn chubby_lock_acquire(
    lock: &mut ChubbyLock,
    client_id: String,
    lease_ms: Int,
    now_ms: Int
) -> FencingToken {
    if (lock).is_locked && now_ms < (lock).lease_expires_ms {
        // Lock currently held and unexpired
        return FencingToken {
            token_number: -1,
            holder_id: (lock).current_holder,
            granted_at_ms: 0,
            lease_duration_ms: 0,
        };
    }

    (lock).current_token = (lock).current_token + 1;
    (lock).current_holder = client_id;
    (lock).lease_expires_ms = now_ms + lease_ms;
    (lock).is_locked = true;

    return FencingToken {
        token_number: (lock).current_token,
        holder_id: client_id,
        granted_at_ms: now_ms,
        lease_duration_ms: lease_ms,
    };
}

pub fn chubby_lock_renew(
    lock: &mut ChubbyLock,
    client_id: String,
    token_num: Int,
    lease_ms: Int,
    now_ms: Int
) -> Bool {
    if (lock).is_locked && (lock).current_holder == client_id && (lock).current_token == token_num {
        (lock).lease_expires_ms = now_ms + lease_ms;
        return true;
    }
    return false;
}

pub fn chubby_lock_release(lock: &mut ChubbyLock, client_id: String, token_num: Int) -> Bool {
    if (lock).is_locked && (lock).current_holder == client_id && (lock).current_token == token_num {
        (lock).is_locked = false;
        (lock).current_holder = "";
        return true;
    }
    return false;
}
