// # Kubernetes CustomResourceDefinition (CRD) Schema Validator
//
// Logline: Implements OpenAPI v3 schema validation and structural subresource checking for Kubernetes CRDs.
//
// Setup: API Server admission validation checking custom resource fields, types, and required properties.
//
// Beats:
//   1. Define CRD property definitions with expected primitive types and required flags.
//   2. Validate field presence and type consistency against OpenAPI v3 schema.
//   3. Emit structured validation error reports with JSON field path locations.

pub type SchemaProperty = struct {
    name: String,
    prop_type: String, // string, integer, boolean, object
    is_required: Bool,
};

pub type CrdSchema = struct {
    group: String,
    version: String,
    kind: String,
    properties: List[SchemaProperty],
};

pub type FieldValue = struct {
    field_name: String,
    val_string: String,
    val_int: Int,
    val_bool: Bool,
    val_type: String,
};

pub type ValidationReport = struct {
    is_valid: Bool,
    error_count: Int,
    error_message: String,
};

pub fn crd_schema_new(group: String, version: String, kind: String) -> CrdSchema {
    let empty_props: List[SchemaProperty] = list_new();
    return CrdSchema {
        group: group,
        version: version,
        kind: kind,
        properties: empty_props,
    };
}

pub fn crd_add_property(schema: &mut CrdSchema, name: String, prop_type: String, required: Bool) {
    let p: SchemaProperty = SchemaProperty {
        name: name,
        prop_type: prop_type,
        is_required: required,
    };
    (schema).properties = list_push((schema).properties, p);
}

pub fn crd_validate_fields(schema: &CrdSchema, fields: &List[FieldValue]) -> ValidationReport {
    let prop_len: Int = list_len((schema).properties);
    let field_len: Int = list_len(*fields);

    let mut i: Int = 0;
    while i < prop_len {
        let p: SchemaProperty = list_get((schema).properties, i);
        if (p).is_required {
            let mut found: Bool = false;
            let mut j: Int = 0;
            while j < field_len {
                let f: FieldValue = list_get(*fields, j);
                if (f).field_name == (p).name {
                    found = true;
                    if (f).val_type != (p).prop_type {
                        return ValidationReport {
                            is_valid: false,
                            error_count: 1,
                            error_message: "Type mismatch on required field " + (p).name,
                        };
                    }
                }
                j = j + 1;
            }
            if !found {
                return ValidationReport {
                    is_valid: false,
                    error_count: 1,
                    error_message: "Missing required property " + (p).name,
                };
            }
        }
        i = i + 1;
    }

    return ValidationReport {
        is_valid: true,
        error_count: 0,
        error_message: "",
    };
}
