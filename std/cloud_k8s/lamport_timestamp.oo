// # Lamport Logical Clock (Int process id destub)
//
// Logline: Lamport clock: tick +1; witness max(local, remote)+1. By-value destub.
//
// Setup: process_id and time are Int. No String fields.
//
// Beats:
//   1. tick advances time by 1.
//   2. witness sets time = max(local, remote) + 1.
//   3. compare: earlier time first; tie-break on process_id.

type LamportClock = struct {
    process_id: Int,
    time: Int
};

pub fn lamport_clock_new(pid: Int) -> LamportClock {
    return LamportClock { process_id: pid, time: 0 };
}

pub fn lamport_clock_tick(clock: LamportClock) -> LamportClock {
    return LamportClock { process_id: clock.process_id, time: clock.time + 1 };
}

pub fn lamport_clock_witness(clock: LamportClock, received_time: Int) -> LamportClock {
    let base: Int = clock.time;
    if received_time > base {
        return LamportClock { process_id: clock.process_id, time: received_time + 1 };
    }
    return LamportClock { process_id: clock.process_id, time: base + 1 };
}

pub fn lamport_clock_time(clock: LamportClock) -> Int {
    return clock.time;
}

pub fn lamport_event_compare(t1: Int, p1: Int, t2: Int, p2: Int) -> Int {
    if t1 < t2 {
        return 0 - 1;
    }
    if t1 > t2 {
        return 1;
    }
    if p1 < p2 {
        return 0 - 1;
    }
    if p1 > p2 {
        return 1;
    }
    return 0;
}
