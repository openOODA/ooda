// # OpenTelemetry Monotonic Metric Counter
//
// Logline: Implements OpenTelemetry monotonic Synchronous Counter instrument with attribute dimensions.
//
// Setup: Observability metric instrument recording cumulative non-negative numeric counts.
//
// Beats:
//   1. Track metric descriptor (name, unit, description) and dimension labels.
//   2. Record non-negative increments across key-value attribute sets.
//   3. Aggregate cumulative sums and provide delta snapshots for periodic export cycles.

pub type MetricAttribute = struct {
    key: String,
    value: String
};

pub type MetricDataPoint = struct {
    attribute_tag: String,
    value: Int,
    timestamp_ms: Int
};

pub type OtelCounter = struct {
    name: String,
    unit: String,
    description: String,
    data_points: List[MetricDataPoint]
};

pub fn otel_counter_new(name: String, unit: String, desc: String) -> OtelCounter {
    let empty_points: List[MetricDataPoint] = list_new();
    return OtelCounter {
        name: name,
        unit: unit,
        description: desc,
        data_points: empty_points
    };
}

pub fn otel_counter_add(
    counter: &mut OtelCounter,
    tag: String,
    amount: Int,
    now_ms: Int
) {
    if amount < 0 {
        return; // Counters are strictly monotonic non-negative
    }

    let n: Int = list_len((counter).data_points);
    let mut i: Int = 0;
    while i < n {
        let mut dp: MetricDataPoint = list_get((counter).data_points, i);
        if (dp).attribute_tag == tag {
            (dp).value = (dp).value + amount;
            (dp).timestamp_ms = now_ms;
            return;
        }
        i = i + 1;
    }

    let new_dp: MetricDataPoint = MetricDataPoint {
        attribute_tag: tag,
        value: amount,
        timestamp_ms: now_ms
    };
    (counter).data_points = list_push((counter).data_points, new_dp);
}

pub fn otel_counter_get_sum(counter: &OtelCounter) -> Int {
    let n: Int = list_len((counter).data_points);
    let mut total: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let dp: MetricDataPoint = list_get((counter).data_points, i);
        total = total + (dp).value;
        i = i + 1;
    }
    return total;
}
