// # Open Container Initiative (OCI) Image Manifest & Descriptor
//
// Logline: Implements OCI Image Specification v1.0 Manifest, Content Descriptors, and Layer verification.
//
// Setup: Container image packaging schema defining config JSON and tar layer content addresses.
//
// Beats:
//   1. Define OciDescriptor with media_type, sha256 digest, and size in bytes.
//   2. Model OciManifest with schemaVersion 2, config descriptor, and array of layer descriptors.
//   3. Compute total uncompressed/compressed container image footprint in bytes.

pub type OciDescriptor = struct {
    media_type: String,
    digest: String,
    size_bytes: Int,
};

pub type OciImageManifest = struct {
    schema_version: Int,
    media_type: String,
    config: OciDescriptor,
    layers: List[OciDescriptor],
};

pub fn oci_descriptor_new(media_type: String, digest: String, size_bytes: Int) -> OciDescriptor {
    return OciDescriptor {
        media_type: media_type,
        digest: digest,
        size_bytes: size_bytes,
    };
}

pub fn oci_image_manifest_new(cfg: OciDescriptor) -> OciImageManifest {
    let empty_layers: List[OciDescriptor] = list_new();
    return OciImageManifest {
        schema_version: 2,
        media_type: "application/vnd.oci.image.manifest.v1+json",
        config: cfg,
        layers: empty_layers,
    };
}

pub fn oci_manifest_add_layer(m: &mut OciImageManifest, layer: OciDescriptor) {
    (m).layers = list_push((m).layers, layer);
}

pub fn oci_manifest_total_size(m: &OciImageManifest) -> Int {
    let mut total: Int = (m).config.size_bytes;
    let n: Int = list_len((m).layers);
    let mut i: Int = 0;
    while i < n {
        let l: OciDescriptor = list_get((m).layers, i);
        total = total + (l).size_bytes;
        i = i + 1;
    }
    return total;
}
