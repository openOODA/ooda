// # Sliding Window Counter Rate Limiter
//
// Logline: Implements Sliding Window Log/Counter algorithm combining previous and current window weights.
//
// Setup: Smooth rate limiting avoiding window boundary double-burst vulnerabilities.
//
// Beats:
//   1. Partition timeline into discrete window segments.
//   2. Calculate weighted request estimates: count_curr + count_prev * (1 - fraction_elapsed).
//   3. Permit or reject requests based on estimated rate limit quota.

pub type SlidingWindowLimiter = struct {
    limit_per_window: Int,
    window_duration_ms: Int,
    current_window_start_ms: Int,
    current_count: Int,
    previous_count: Int
};

pub fn sliding_window_new(limit: Int, window_duration_ms: Int, now_ms: Int) -> SlidingWindowLimiter {
    let win_start: Int = (now_ms / window_duration_ms) * window_duration_ms;
    return SlidingWindowLimiter {
        limit_per_window: limit,
        window_duration_ms: window_duration_ms,
        current_window_start_ms: win_start,
        current_count: 0,
        previous_count: 0
    };
}

pub fn sliding_window_advance(sw: &mut SlidingWindowLimiter, now_ms: Int) {
    let cur_win: Int = (now_ms / (sw).window_duration_ms) * (sw).window_duration_ms;
    if cur_win == (sw).current_window_start_ms {
        return;
    }

    if cur_win == (sw).current_window_start_ms + (sw).window_duration_ms {
        (sw).previous_count = (sw).current_count;
        (sw).current_count = 0;
        (sw).current_window_start_ms = cur_win;
    } else {
        (sw).previous_count = 0;
        (sw).current_count = 0;
        (sw).current_window_start_ms = cur_win;
    }
}

pub fn sliding_window_allow(sw: &mut SlidingWindowLimiter, now_ms: Int) -> Bool {
    sliding_window_advance(sw, now_ms);

    let elapsed: Int = now_ms - (sw).current_window_start_ms;
    let weight_prev: Int = ((sw).window_duration_ms - elapsed) * 1000 / (sw).window_duration_ms;
    let estimated: Int = (sw).current_count + (((sw).previous_count * weight_prev) / 1000);

    if estimated < (sw).limit_per_window {
        (sw).current_count = (sw).current_count + 1;
        return true;
    }

    return false;
}
