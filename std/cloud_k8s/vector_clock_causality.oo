// # Vector Clock Causality Tracker
//
// Logline: Implements Mattern/Fidge Vector Clocks for partial ordering and concurrent event detection.
//
// Setup: Distributed causality tracking associating per-node counter vectors with causal event histories.
//
// Beats:
//   1. Maintain dynamic vector entries mapping node IDs to monotonic logical counters.
//   2. Advance local node ticks upon local state transitions.
//   3. Merge incoming vector clocks via pairwise supremum and evaluate causal relations (Precedes, Concurrent).

pub type VectorClockEntry = struct {
    node_id: String,
    counter: Int
};

pub type VectorClock = struct {
    entries: List[VectorClockEntry]
};

pub fn vector_clock_new() -> VectorClock {
    let empty_list: List[VectorClockEntry] = list_new();
    return VectorClock {
        entries: empty_list
    };
}

pub fn vector_clock_get(vc: &VectorClock, node_id: String) -> Int {
    let n: Int = list_len((vc).entries);
    let mut i: Int = 0;
    while i < n {
        let e: VectorClockEntry = list_get((vc).entries, i);
        if (e).node_id == node_id {
            return (e).counter;
        }
        i = i + 1;
    }
    return 0;
}

pub fn vector_clock_tick(vc: &mut VectorClock, local_id: String) {
    let n: Int = list_len((vc).entries);
    let mut i: Int = 0;
    while i < n {
        let mut e: VectorClockEntry = list_get((vc).entries, i);
        if (e).node_id == local_id {
            (e).counter = (e).counter + 1;
            return;
        }
        i = i + 1;
    }

    let new_entry: VectorClockEntry = VectorClockEntry {
        node_id: local_id,
        counter: 1
    };
    (vc).entries = list_push((vc).entries, new_entry);
}

pub fn vector_clock_merge(vc: &mut VectorClock, incoming: &VectorClock) {
    let n: Int = list_len((incoming).entries);
    let mut i: Int = 0;
    while i < n {
        let inc_entry: VectorClockEntry = list_get((incoming).entries, i);
        let mut local_n: Int = list_len((vc).entries);
        let mut j: Int = 0;
        let mut found: Bool = false;

        while j < local_n {
            let mut loc_entry: VectorClockEntry = list_get((vc).entries, j);
            let loc_id: String = (loc_entry).node_id;
            let inc_id: String = (inc_entry).node_id;
            if loc_id == inc_id {
                if (inc_entry).counter > (loc_entry).counter {
                    (loc_entry).counter = (inc_entry).counter;
                }
                found = true;
            }
            j = j + 1;
        }

        if !found {
            (vc).entries = list_push((vc).entries, inc_entry);
        }
        i = i + 1;
    }
}

/// Compare two vector clocks: 0 = Equal, -1 = a precedes b, 1 = b precedes a, 2 = Concurrent.
pub fn vector_clock_compare(a: &VectorClock, b: &VectorClock) -> Int {
    let mut a_has_greater: Bool = false;
    let mut b_has_greater: Bool = false;

    let len_a: Int = list_len((a).entries);
    let mut i: Int = 0;
    while i < len_a {
        let e_a: VectorClockEntry = list_get((a).entries, i);
        let count_b: Int = vector_clock_get(b, (e_a).node_id);
        if (e_a).counter > count_b {
            a_has_greater = true;
        }
        if (e_a).counter < count_b {
            b_has_greater = true;
        }
        i = i + 1;
    }

    let len_b: Int = list_len((b).entries);
    let mut j: Int = 0;
    while j < len_b {
        let e_b: VectorClockEntry = list_get((b).entries, j);
        let count_a: Int = vector_clock_get(a, (e_b).node_id);
        if (e_b).counter > count_a {
            b_has_greater = true;
        }
        if (e_b).counter < count_a {
            a_has_greater = true;
        }
        j = j + 1;
    }

    if !a_has_greater && !b_has_greater {
        return 0; // Equal
    }
    if a_has_greater && !b_has_greater {
        return 1; // b precedes a
    }
    if !a_has_greater && b_has_greater {
        return -1; // a precedes b
    }
    return 2; // Concurrent
}
