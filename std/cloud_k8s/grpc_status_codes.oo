// # gRPC Canonical Status Codes & Error Propagation
//
// Logline: Implements canonical gRPC status codes (0=OK to 16=UNAUTHENTICATED) and HTTP mapping.
//
// Setup: Distributed error taxonomy standardizing failure codes across heterogeneous microservices.
//
// Beats:
//   1. Map gRPC status codes to canonical names (OK, CANCELLED, DEADLINE_EXCEEDED, UNAVAILABLE, etc.).
//   2. Bidirectional translation between HTTP status codes and gRPC status codes.
//   3. Format gRPC status trailers (grpc-status, grpc-message).

pub type GrpcStatus = struct {
    code: Int,
    name: String,
    message: String
};

pub fn grpc_status_ok() -> GrpcStatus {
    return GrpcStatus {
        code: 0,
        name: "OK",
        message: ""
    };
}

pub fn grpc_status_not_found(msg: String) -> GrpcStatus {
    return GrpcStatus {
        code: 5,
        name: "NOT_FOUND",
        message: msg
    };
}

pub fn grpc_status_deadline_exceeded(msg: String) -> GrpcStatus {
    return GrpcStatus {
        code: 4,
        name: "DEADLINE_EXCEEDED",
        message: msg
    };
}

pub fn grpc_status_unavailable(msg: String) -> GrpcStatus {
    return GrpcStatus {
        code: 14,
        name: "UNAVAILABLE",
        message: msg
    };
}

pub fn grpc_status_to_http(code: Int) -> Int {
    if code == 0 { return 200; }
    if code == 1 { return 499; } // CANCELLED
    if code == 3 { return 400; } // INVALID_ARGUMENT
    if code == 4 { return 504; } // DEADLINE_EXCEEDED
    if code == 5 { return 404; } // NOT_FOUND
    if code == 6 { return 409; } // ALREADY_EXISTS
    if code == 7 { return 403; } // PERMISSION_DENIED
    if code == 8 { return 429; } // RESOURCE_EXHAUSTED
    if code == 14 { return 503; } // UNAVAILABLE
    if code == 16 { return 401; } // UNAUTHENTICATED
    return 500;
}
