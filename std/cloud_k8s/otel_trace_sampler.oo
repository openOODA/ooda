// # OpenTelemetry Trace Sampler (AlwaysOn, Ratio, ParentBased)
//
// Logline: Implements Head-based sampling algorithms (AlwaysOn, AlwaysOff, TraceIdRatioBased, ParentBased).
//
// Setup: Observability telemetry rate governor balancing distributed trace visibility against export overhead.
//
// Beats:
//   1. Implement AlwaysOn and AlwaysOff deterministic sampling strategies.
//   2. Calculate TraceIdRatioBased probabilistic decisions using trace_id numeric hashing.
//   3. Inherit parent sampling decisions with ParentBased fallback logic.

pub type SamplingDecision = struct {
    is_sampled: Bool,
    sampler_description: String,
};

pub type SamplerType = Int; // 0=AlwaysOn, 1=AlwaysOff, 2=Ratio, 3=ParentBased

pub type OtelSampler = struct {
    sampler_type: Int,
    ratio_permille: Int, // e.g. 100 = 10.0%, 1000 = 100%
};

pub fn otel_sampler_always_on() -> OtelSampler {
    return OtelSampler {
        sampler_type: 0,
        ratio_permille: 1000,
    };
}

pub fn otel_sampler_ratio(ratio_permille: Int) -> OtelSampler {
    return OtelSampler {
        sampler_type: 2,
        ratio_permille: ratio_permille,
    };
}

pub fn otel_sampler_parent_based(ratio_permille: Int) -> OtelSampler {
    return OtelSampler {
        sampler_type: 3,
        ratio_permille: ratio_permille,
    };
}

pub fn otel_sample_decision(
    sampler: &OtelSampler,
    has_parent: Bool,
    parent_sampled: Bool,
    trace_id_hash: Int
) -> SamplingDecision {
    if (sampler).sampler_type == 0 {
        return SamplingDecision {
            is_sampled: true,
            sampler_description: "AlwaysOn",
        };
    }

    if (sampler).sampler_type == 1 {
        return SamplingDecision {
            is_sampled: false,
            sampler_description: "AlwaysOff",
        };
    }

    if (sampler).sampler_type == 3 && has_parent {
        return SamplingDecision {
            is_sampled: parent_sampled,
            sampler_description: "ParentBased",
        };
    }

    // Ratio check: trace_id_hash in [0, 1000)
    let mut val: Int = trace_id_hash % 1000;
    if val < 0 {
        val = 0 - val;
    }
    let should_sample: Bool = val < (sampler).ratio_permille;

    return SamplingDecision {
        is_sampled: should_sample,
        sampler_description: "TraceIdRatioBased",
    };
}
