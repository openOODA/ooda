// # Observed-Remove Set CRDT (2-slot Int floor)
//
// Logline: OR-Set: element is in if an add-tag is not tombstoned. By-value destub.
//
// Setup: Two add slots (val, tag) and two remove tags.
//
// Beats:
//   1. add writes first empty slot with unique tag.
//   2. remove copies matching add tags into tombstones.
//   3. contains if some add tag is not in remove tags.

type OrSet = struct {
    v0: Int,
    t0: Int,
    v1: Int,
    t1: Int,
    r0: Int,
    r1: Int
};

pub fn or_set_new() -> OrSet {
    return OrSet { v0: 0, t0: 0, v1: 0, t1: 0, r0: 0, r1: 0 };
}

pub fn or_set_add(set: OrSet, val: Int, tag: Int) -> OrSet {
    if set.t0 == 0 {
        return OrSet { v0: val, t0: tag, v1: set.v1, t1: set.t1, r0: set.r0, r1: set.r1 };
    }
    if set.t1 == 0 {
        return OrSet { v0: set.v0, t0: set.t0, v1: val, t1: tag, r0: set.r0, r1: set.r1 };
    }
    return set;
}

fn or_tag_removed(set: OrSet, tag: Int) -> Int {
    if tag == 0 {
        return 1;
    }
    if set.r0 == tag {
        return 1;
    }
    if set.r1 == tag {
        return 1;
    }
    return 0;
}

type OrTomb = struct {
    r0: Int,
    r1: Int
};

fn or_push_tomb(r0: Int, r1: Int, tag: Int) -> OrTomb {
    if tag == 0 {
        return OrTomb { r0: r0, r1: r1 };
    }
    if r0 == 0 {
        return OrTomb { r0: tag, r1: r1 };
    }
    if r1 == 0 {
        return OrTomb { r0: r0, r1: tag };
    }
    return OrTomb { r0: r0, r1: r1 };
}

fn or_maybe_tomb(r0: Int, r1: Int, v: Int, val: Int, tag: Int) -> OrTomb {
    if v == val {
        return or_push_tomb(r0, r1, tag);
    }
    return OrTomb { r0: r0, r1: r1 };
}

pub fn or_set_remove(set: OrSet, val: Int) -> OrSet {
    let t0: OrTomb = or_maybe_tomb(set.r0, set.r1, set.v0, val, set.t0);
    let t1: OrTomb = or_maybe_tomb(t0.r0, t0.r1, set.v1, val, set.t1);
    return OrSet { v0: set.v0, t0: set.t0, v1: set.v1, t1: set.t1, r0: t1.r0, r1: t1.r1 };
}

pub fn or_set_contains(set: OrSet, val: Int) -> Int {
    if set.v0 == val {
        if or_tag_removed(set, set.t0) == 0 {
            return 1;
        }
    }
    if set.v1 == val {
        if or_tag_removed(set, set.t1) == 0 {
            return 1;
        }
    }
    return 0;
}
