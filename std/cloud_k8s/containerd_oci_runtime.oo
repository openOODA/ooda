// # containerd OCI Runtime Spec & Cgroup Sandbox
//
// Logline: Models OCI Runtime Spec bundle, Linux namespaces, and Cgroup v2 resource controllers.
//
// Setup: Low-level container executor defining process execution isolation, namespaces, and cgroups.
//
// Beats:
//   1. Configure Linux namespaces (pid, net, ipc, uts, mount, user, cgroup).
//   2. Specify Cgroups v2 memory.max, cpu.max (quota and period) limits.
//   3. Validate OCI container process entrypoint arguments and environment bindings.

pub type CgroupV2Limits = struct {
    cpu_quota_us: Int,
    cpu_period_us: Int,
    memory_max_bytes: Int,
    pids_max: Int
};

pub type LinuxNamespaces = struct {
    pid_ns: Bool,
    net_ns: Bool,
    ipc_ns: Bool,
    uts_ns: Bool,
    mount_ns: Bool
};

pub type OciRuntimeBundle = struct {
    bundle_path: String,
    rootfs_path: String,
    namespaces: LinuxNamespaces,
    cgroups: CgroupV2Limits,
    readonly_rootfs: Bool
};

pub fn oci_runtime_bundle_new(bundle_path: String) -> OciRuntimeBundle {
    let ns: LinuxNamespaces = LinuxNamespaces {
        pid_ns: true,
        net_ns: true,
        ipc_ns: true,
        uts_ns: true,
        mount_ns: true
    };
    let cg: CgroupV2Limits = CgroupV2Limits {
        cpu_quota_us: 100000,  // 1 CPU core
        cpu_period_us: 100000,
        memory_max_bytes: 536870912, // 512MB
        pids_max: 1024
    };
    return OciRuntimeBundle {
        bundle_path: bundle_path,
        rootfs_path: bundle_path + "/rootfs",
        namespaces: ns,
        cgroups: cg,
        readonly_rootfs: true
    };
}

pub fn oci_bundle_set_memory_limit(bundle: &mut OciRuntimeBundle, mem_bytes: Int) {
    (bundle).cgroups.memory_max_bytes = mem_bytes;
}

pub fn oci_bundle_set_cpu_limit(bundle: &mut OciRuntimeBundle, quota_us: Int, period_us: Int) {
    (bundle).cgroups.cpu_quota_us = quota_us;
    (bundle).cgroups.cpu_period_us = period_us;
}
