// # Replicated Growable Array Sequence CRDT (2-slot Int floor)
//
// Logline: RGA insert-after-parent with id-priority shift and tombstone delete. By-value destub.
//
// Setup: Two flattened nodes (ts, replica, parent, value, deleted). n_nodes is occupancy.
//
// Beats:
//   1. insert after parent, then skip nodes whose id compares greater than the new id.
//   2. delete sets the matching node's deleted flag.
//   3. id compare is timestamp first, then replica id.

type RgaSequence = struct {
    ts0: Int,
    rp0: Int,
    pts0: Int,
    prp0: Int,
    val0: Int,
    del0: Int,
    ts1: Int,
    rp1: Int,
    pts1: Int,
    prp1: Int,
    val1: Int,
    del1: Int,
    n_nodes: Int
};

pub fn rga_sequence_new() -> RgaSequence {
    return RgaSequence {
        ts0: 0,
        rp0: 0,
        pts0: 0,
        prp0: 0,
        val0: 0,
        del0: 0,
        ts1: 0,
        rp1: 0,
        pts1: 0,
        prp1: 0,
        val1: 0,
        del1: 0,
        n_nodes: 0
    };
}

pub fn rga_id_eq(ats: Int, arp: Int, bts: Int, brp: Int) -> Int {
    if ats == bts {
        if arp == brp {
            return 1;
        }
    }
    return 0;
}

pub fn rga_id_compare(ats: Int, arp: Int, bts: Int, brp: Int) -> Int {
    if ats > bts {
        return 1;
    }
    if ats < bts {
        return 0 - 1;
    }
    if arp > brp {
        return 1;
    }
    if arp < brp {
        return 0 - 1;
    }
    return 0;
}

fn rga_parent_pos(seq: RgaSequence, pts: Int, prp: Int) -> Int {
    if pts <= 0 {
        return 0;
    }
    if seq.n_nodes > 0 {
        if rga_id_eq(seq.ts0, seq.rp0, pts, prp) == 1 {
            return 1;
        }
    }
    if seq.n_nodes > 1 {
        if rga_id_eq(seq.ts1, seq.rp1, pts, prp) == 1 {
            return 2;
        }
    }
    return 0;
}

fn rga_advance(seq: RgaSequence, pos: Int, nts: Int, nrp: Int) -> Int {
    if pos >= seq.n_nodes {
        return pos;
    }
    if pos == 0 {
        if rga_id_compare(seq.ts0, seq.rp0, nts, nrp) > 0 {
            return 1;
        }
        return 0;
    }
    if pos == 1 {
        if rga_id_compare(seq.ts1, seq.rp1, nts, nrp) > 0 {
            return 2;
        }
        return 1;
    }
    return pos;
}

fn rga_insert_pos(seq: RgaSequence, pts: Int, prp: Int, nts: Int, nrp: Int) -> Int {
    let p0: Int = rga_parent_pos(seq, pts, prp);
    let p1: Int = rga_advance(seq, p0, nts, nrp);
    return rga_advance(seq, p1, nts, nrp);
}

pub fn rga_insert(
    seq: RgaSequence,
    parent_ts: Int,
    parent_rep: Int,
    val: Int,
    ts: Int,
    replica_id: Int
) -> RgaSequence {
    let pos: Int = rga_insert_pos(seq, parent_ts, parent_rep, ts, replica_id);
    if seq.n_nodes == 0 {
        return RgaSequence {
            ts0: ts,
            rp0: replica_id,
            pts0: parent_ts,
            prp0: parent_rep,
            val0: val,
            del0: 0,
            ts1: 0,
            rp1: 0,
            pts1: 0,
            prp1: 0,
            val1: 0,
            del1: 0,
            n_nodes: 1
        };
    }
    if seq.n_nodes == 1 {
        if pos == 0 {
            return RgaSequence {
                ts0: ts,
                rp0: replica_id,
                pts0: parent_ts,
                prp0: parent_rep,
                val0: val,
                del0: 0,
                ts1: seq.ts0,
                rp1: seq.rp0,
                pts1: seq.pts0,
                prp1: seq.prp0,
                val1: seq.val0,
                del1: seq.del0,
                n_nodes: 2
            };
        }
        return RgaSequence {
            ts0: seq.ts0,
            rp0: seq.rp0,
            pts0: seq.pts0,
            prp0: seq.prp0,
            val0: seq.val0,
            del0: seq.del0,
            ts1: ts,
            rp1: replica_id,
            pts1: parent_ts,
            prp1: parent_rep,
            val1: val,
            del1: 0,
            n_nodes: 2
        };
    }
    if pos == 0 {
        return RgaSequence {
            ts0: ts,
            rp0: replica_id,
            pts0: parent_ts,
            prp0: parent_rep,
            val0: val,
            del0: 0,
            ts1: seq.ts0,
            rp1: seq.rp0,
            pts1: seq.pts0,
            prp1: seq.prp0,
            val1: seq.val0,
            del1: seq.del0,
            n_nodes: 2
        };
    }
    if pos == 1 {
        return RgaSequence {
            ts0: seq.ts0,
            rp0: seq.rp0,
            pts0: seq.pts0,
            prp0: seq.prp0,
            val0: seq.val0,
            del0: seq.del0,
            ts1: ts,
            rp1: replica_id,
            pts1: parent_ts,
            prp1: parent_rep,
            val1: val,
            del1: 0,
            n_nodes: 2
        };
    }
    return seq;
}

pub fn rga_delete(seq: RgaSequence, ts: Int, rep: Int) -> RgaSequence {
    if seq.n_nodes > 0 {
        if rga_id_eq(seq.ts0, seq.rp0, ts, rep) == 1 {
            return RgaSequence {
                ts0: seq.ts0,
                rp0: seq.rp0,
                pts0: seq.pts0,
                prp0: seq.prp0,
                val0: seq.val0,
                del0: 1,
                ts1: seq.ts1,
                rp1: seq.rp1,
                pts1: seq.pts1,
                prp1: seq.prp1,
                val1: seq.val1,
                del1: seq.del1,
                n_nodes: seq.n_nodes
            };
        }
    }
    if seq.n_nodes > 1 {
        if rga_id_eq(seq.ts1, seq.rp1, ts, rep) == 1 {
            return RgaSequence {
                ts0: seq.ts0,
                rp0: seq.rp0,
                pts0: seq.pts0,
                prp0: seq.prp0,
                val0: seq.val0,
                del0: seq.del0,
                ts1: seq.ts1,
                rp1: seq.rp1,
                pts1: seq.pts1,
                prp1: seq.prp1,
                val1: seq.val1,
                del1: 1,
                n_nodes: seq.n_nodes
            };
        }
    }
    return seq;
}

fn rga_vis_slot(n_nodes: Int, idx: Int, del: Int) -> Int {
    if n_nodes > idx {
        if del == 0 {
            return 1;
        }
    }
    return 0;
}

pub fn rga_visible_n(seq: RgaSequence) -> Int {
    return rga_vis_slot(seq.n_nodes, 0, seq.del0) + rga_vis_slot(seq.n_nodes, 1, seq.del1);
}
