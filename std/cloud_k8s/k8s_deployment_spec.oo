// # Kubernetes Deployment Spec & Rolling Update Controller
//
// Logline: Implements Kubernetes Deployment specification, maxSurge/maxUnavailable rolling updates, and replica reconciliation.
//
// Setup: High-level workload manager maintaining declarative pod replicas through ReplicaSets.
//
// Beats:
//   1. Specify desired replica count, template pod spec, and rolling update strategy parameters.
//   2. Calculate surge and unavailable bounds during version rollout transitions.
//   3. Compute scaling delta between current and desired replicas.

pub type RollingUpdateStrategy = struct {
    max_surge: Int,
    max_unavailable: Int
};

pub type DeploymentSpec = struct {
    name: String,
    namespace: String,
    replicas: Int,
    strategy: RollingUpdateStrategy,
    selector_label: String,
    image: String
};

pub type DeploymentStatus = struct {
    replicas: Int,
    updated_replicas: Int,
    ready_replicas: Int,
    available_replicas: Int
};

pub fn deployment_spec_new(name: String, namespace: String, replicas: Int, img: String) -> DeploymentSpec {
    let strat: RollingUpdateStrategy = RollingUpdateStrategy {
        max_surge: 1,
        max_unavailable: 0
    };
    return DeploymentSpec {
        name: name,
        namespace: namespace,
        replicas: replicas,
        strategy: strat,
        selector_label: name,
        image: img
    };
}

pub fn deployment_calculate_max_allowed(spec: &DeploymentSpec) -> Int {
    return (spec).replicas + (spec).strategy.max_surge;
}

pub fn deployment_calculate_min_available(spec: &DeploymentSpec) -> Int {
    let min_avail: Int = (spec).replicas - (spec).strategy.max_unavailable;
    if min_avail < 0 {
        return 0;
    }
    return min_avail;
}

pub fn deployment_needs_scale(spec: &DeploymentSpec, status: &DeploymentStatus) -> Bool {
    return (spec).replicas != (status).replicas;
}
