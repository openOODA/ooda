// # Consistent Hash Ring with Virtual Nodes (4-slot Int floor)
//
// Logline: Ketama clockwise successor over hashed vnode tokens. By-value destub.
//
// Setup: Four vnode slots (token, node). n_nodes is physical count; filled is vnode occupancy.
//
// Beats:
//   1. add_node places vnodes_per_node tokens (capped at two per add, four total).
//   2. get_node returns the clockwise successor of the key token.
//   3. wrap to the minimum token when no token is >= the key.

type HashRing = struct {
    t0: Int,
    n0: Int,
    t1: Int,
    n1: Int,
    t2: Int,
    n2: Int,
    t3: Int,
    n3: Int,
    vnodes_per_node: Int,
    n_nodes: Int,
    filled: Int
};

type ChrPick = struct {
    token: Int,
    node: Int
};

pub fn hash_ring_new(vnodes_per_node: Int) -> HashRing {
    return HashRing {
        t0: 0,
        n0: 0,
        t1: 0,
        n1: 0,
        t2: 0,
        n2: 0,
        t3: 0,
        n3: 0,
        vnodes_per_node: vnodes_per_node,
        n_nodes: 0,
        filled: 0
    };
}

pub fn hash_string_token(s: Int, salt: Int) -> Int {
    let mix: Int = s + salt;
    let h0: Int = 216613626 + (mix * 16777619);
    let h1: Int = h0 % 1000000007;
    if h1 < 0 {
        return 0 - h1;
    }
    return h1;
}

fn hash_ring_push(ring: HashRing, node_id: Int, replica: Int) -> HashRing {
    let token: Int = hash_string_token(node_id, replica * 31);
    if ring.filled == 0 {
        return HashRing {
            t0: token,
            n0: node_id,
            t1: ring.t1,
            n1: ring.n1,
            t2: ring.t2,
            n2: ring.n2,
            t3: ring.t3,
            n3: ring.n3,
            vnodes_per_node: ring.vnodes_per_node,
            n_nodes: ring.n_nodes,
            filled: 1
        };
    }
    if ring.filled == 1 {
        return HashRing {
            t0: ring.t0,
            n0: ring.n0,
            t1: token,
            n1: node_id,
            t2: ring.t2,
            n2: ring.n2,
            t3: ring.t3,
            n3: ring.n3,
            vnodes_per_node: ring.vnodes_per_node,
            n_nodes: ring.n_nodes,
            filled: 2
        };
    }
    if ring.filled == 2 {
        return HashRing {
            t0: ring.t0,
            n0: ring.n0,
            t1: ring.t1,
            n1: ring.n1,
            t2: token,
            n2: node_id,
            t3: ring.t3,
            n3: ring.n3,
            vnodes_per_node: ring.vnodes_per_node,
            n_nodes: ring.n_nodes,
            filled: 3
        };
    }
    if ring.filled == 3 {
        return HashRing {
            t0: ring.t0,
            n0: ring.n0,
            t1: ring.t1,
            n1: ring.n1,
            t2: ring.t2,
            n2: ring.n2,
            t3: token,
            n3: node_id,
            vnodes_per_node: ring.vnodes_per_node,
            n_nodes: ring.n_nodes,
            filled: 4
        };
    }
    return ring;
}

fn hash_ring_with_n(ring: HashRing, n_nodes: Int) -> HashRing {
    return HashRing {
        t0: ring.t0,
        n0: ring.n0,
        t1: ring.t1,
        n1: ring.n1,
        t2: ring.t2,
        n2: ring.n2,
        t3: ring.t3,
        n3: ring.n3,
        vnodes_per_node: ring.vnodes_per_node,
        n_nodes: n_nodes,
        filled: ring.filled
    };
}

pub fn hash_ring_add_node(ring: HashRing, node_id: Int) -> HashRing {
    if ring.vnodes_per_node <= 0 {
        return hash_ring_with_n(ring, ring.n_nodes + 1);
    }
    let r0: HashRing = hash_ring_push(ring, node_id, 0);
    if ring.vnodes_per_node <= 1 {
        return hash_ring_with_n(r0, ring.n_nodes + 1);
    }
    let r1: HashRing = hash_ring_push(r0, node_id, 1);
    return hash_ring_with_n(r1, ring.n_nodes + 1);
}

fn chr_slot_live(filled: Int, idx: Int) -> Int {
    if filled > idx {
        return 1;
    }
    return 0;
}

fn chr_ge(token: Int, node: Int, key_token: Int, live: Int) -> ChrPick {
    if live == 0 {
        return ChrPick { token: 0, node: 0 };
    }
    if token >= key_token {
        return ChrPick { token: token, node: node };
    }
    return ChrPick { token: 0, node: 0 };
}

fn chr_closer(a: ChrPick, b: ChrPick, key_token: Int) -> ChrPick {
    if a.node == 0 {
        return b;
    }
    if b.node == 0 {
        return a;
    }
    let da: Int = a.token - key_token;
    let db: Int = b.token - key_token;
    if da < db {
        return a;
    }
    return b;
}

fn chr_live(token: Int, node: Int, live: Int) -> ChrPick {
    if live == 0 {
        return ChrPick { token: 0, node: 0 };
    }
    return ChrPick { token: token, node: node };
}

fn chr_min_tok(a: ChrPick, b: ChrPick) -> ChrPick {
    if a.node == 0 {
        return b;
    }
    if b.node == 0 {
        return a;
    }
    if a.token < b.token {
        return a;
    }
    return b;
}

pub fn hash_ring_get_node(ring: HashRing, key: Int) -> Int {
    if ring.filled == 0 {
        return 0;
    }
    let kt: Int = hash_string_token(key, 0);
    let g0: ChrPick = chr_ge(ring.t0, ring.n0, kt, chr_slot_live(ring.filled, 0));
    let g1: ChrPick = chr_ge(ring.t1, ring.n1, kt, chr_slot_live(ring.filled, 1));
    let g2: ChrPick = chr_ge(ring.t2, ring.n2, kt, chr_slot_live(ring.filled, 2));
    let g3: ChrPick = chr_ge(ring.t3, ring.n3, kt, chr_slot_live(ring.filled, 3));
    let b01: ChrPick = chr_closer(g0, g1, kt);
    let b23: ChrPick = chr_closer(g2, g3, kt);
    let best: ChrPick = chr_closer(b01, b23, kt);
    if best.node == 0 {
        let w0: ChrPick = chr_live(ring.t0, ring.n0, chr_slot_live(ring.filled, 0));
        let w1: ChrPick = chr_live(ring.t1, ring.n1, chr_slot_live(ring.filled, 1));
        let w2: ChrPick = chr_live(ring.t2, ring.n2, chr_slot_live(ring.filled, 2));
        let w3: ChrPick = chr_live(ring.t3, ring.n3, chr_slot_live(ring.filled, 3));
        let m01: ChrPick = chr_min_tok(w0, w1);
        let m23: ChrPick = chr_min_tok(w2, w3);
        let wrap: ChrPick = chr_min_tok(m01, m23);
        return wrap.node;
    }
    return best.node;
}
