// # Raft Log Compaction & Snapshotting
//
// Logline: Implements snapshot chunking, log truncation, and InstallSnapshot RPC for lagging replicas.
//
// Setup: Memory and disk compaction mechanisms preventing unbounded log growth in Raft clusters.
//
// Beats:
//   1. Track snapshot metadata including last_included_index, last_included_term, and cluster config.
//   2. Discard and compact log entries preceding snapshot index.
//   3. Handle InstallSnapshot RPC streaming state transfer to slow or restored followers.

pub type RaftSnapshotMetadata = struct {
    last_included_index: Int,
    last_included_term: Int,
    snapshot_size_bytes: Int,
    created_at_ms: Int,
};

pub type InstallSnapshotArgs = struct {
    term: Int,
    leader_id: String,
    last_included_index: Int,
    last_included_term: Int,
    offset: Int,
    data: String,
    done: Bool,
};

pub type InstallSnapshotReply = struct {
    term: Int,
    accepted: Bool,
};

pub type CompactedRaftLog = struct {
    snapshot: RaftSnapshotMetadata,
    base_index: Int,
    entry_count: Int,
};

pub fn compacted_raft_log_new() -> CompactedRaftLog {
    let meta: RaftSnapshotMetadata = RaftSnapshotMetadata {
        last_included_index: 0,
        last_included_term: 0,
        snapshot_size_bytes: 0,
        created_at_ms: 0,
    };
    return CompactedRaftLog {
        snapshot: meta,
        base_index: 0,
        entry_count: 0,
    };
}

pub fn raft_log_compact(
    log: &mut CompactedRaftLog,
    snapshot_idx: Int,
    snapshot_term: Int,
    byte_size: Int,
    now_ms: Int
) -> Bool {
    if snapshot_idx <= (log).snapshot.last_included_index {
        return false;
    }

    (log).snapshot.last_included_index = snapshot_idx;
    (log).snapshot.last_included_term = snapshot_term;
    (log).snapshot.snapshot_size_bytes = byte_size;
    (log).snapshot.created_at_ms = now_ms;
    (log).base_index = snapshot_idx;
    return true;
}

pub fn raft_handle_install_snapshot(
    log: &mut CompactedRaftLog,
    current_term: Int,
    args: &InstallSnapshotArgs,
    now_ms: Int
) -> InstallSnapshotReply {
    if (args).term < current_term {
        return InstallSnapshotReply {
            term: current_term,
            accepted: false,
        };
    }

    if (args).last_included_index > (log).snapshot.last_included_index {
        (log).snapshot.last_included_index = (args).last_included_index;
        (log).snapshot.last_included_term = (args).last_included_term;
        (log).snapshot.created_at_ms = now_ms;
        (log).base_index = (args).last_included_index;
    }

    return InstallSnapshotReply {
        term: current_term,
        accepted: true,
    };
}
