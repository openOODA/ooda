// # Kubernetes ConfigMap & Secret Key-Value Store
//
// Logline: Models ConfigMap and Secret key-value projections, projection hashes, and volume mounting metadata.
//
// Setup: Configuration and confidential credential data store projected into container environments.
//
// Beats:
//   1. Store key-value pairs with binary/string data representations.
//   2. Compute data digest hash for rolling update trigger annotations.
//   3. Project configurations as environment variables or mounted volume file descriptors.

pub type ConfigEntry = struct {
    key: String,
    value: String,
};

pub type ConfigMap = struct {
    name: String,
    namespace: String,
    data: List[ConfigEntry],
    is_immutable: Bool,
};

pub type K8sSecret = struct {
    name: String,
    namespace: String,
    secret_type: String, // Opaque, kubernetes.io/tls, kubernetes.io/service-account-token
    data: List[ConfigEntry],
    is_immutable: Bool,
};

pub fn configmap_new(name: String, ns: String) -> ConfigMap {
    let empty_entries: List[ConfigEntry] = list_new();
    return ConfigMap {
        name: name,
        namespace: ns,
        data: empty_entries,
        is_immutable: false,
    };
}

pub fn configmap_set(cm: &mut ConfigMap, key: String, val: String) {
    let n: Int = list_len((cm).data);
    let mut i: Int = 0;
    while i < n {
        let mut entry: ConfigEntry = list_get((cm).data, i);
        if (entry).key == key {
            (entry).value = val;
            return;
        }
        i = i + 1;
    }
    let new_entry: ConfigEntry = ConfigEntry { key: key, value: val };
    (cm).data = list_push((cm).data, new_entry);
}

pub fn configmap_get(cm: &ConfigMap, key: String) -> String {
    let n: Int = list_len((cm).data);
    let mut i: Int = 0;
    while i < n {
        let entry: ConfigEntry = list_get((cm).data, i);
        if (entry).key == key {
            return (entry).value;
        }
        i = i + 1;
    }
    return "";
}
