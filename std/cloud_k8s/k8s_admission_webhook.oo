// # Kubernetes Admission Webhook Review Handler
//
// Logline: Handles Mutating and Validating AdmissionReview requests with JSON patch generation and deny messages.
//
// Setup: Extensible API admission webhook intercepting resource creation, modification, and deletion.
//
// Beats:
//   1. Parse AdmissionReview request metadata (UID, Kind, Resource, Operation, UserInfo).
//   2. Run validation interceptors to admit or reject resource manifests with HTTP status codes.
//   3. Generate RFC 6902 JSONPatch operations for mutating admission modifications.

pub type AdmissionRequest = struct {
    uid: String,
    resource_kind: String,
    namespace: String,
    operation: String, // CREATE, UPDATE, DELETE
    object_json: String
};

pub type AdmissionResponse = struct {
    uid: String,
    allowed: Bool,
    status_code: Int,
    status_message: String,
    patch_type: String, // JSONPatch or empty
    patch_data: String
};

pub fn admission_response_allow(uid: String) -> AdmissionResponse {
    return AdmissionResponse {
        uid: uid,
        allowed: true,
        status_code: 200,
        status_message: "Admitted",
        patch_type: "",
        patch_data: ""
    };
}

pub fn admission_response_deny(uid: String, code: Int, msg: String) -> AdmissionResponse {
    return AdmissionResponse {
        uid: uid,
        allowed: false,
        status_code: code,
        status_message: msg,
        patch_type: "",
        patch_data: ""
    };
}

pub fn admission_response_mutate(uid: String, patch_json: String) -> AdmissionResponse {
    return AdmissionResponse {
        uid: uid,
        allowed: true,
        status_code: 200,
        status_message: "Mutated",
        patch_type: "JSONPatch",
        patch_data: patch_json
    };
}
