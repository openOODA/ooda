// # Tiny JSON field scrape for pay handshakes
//
// Logline: Read a string or int field from a small JSON object. Not a parser.
//
// Setup: First matching "key" wins. No escapes. Fixtures only.
//
// Beats:
//   1. pay_json_string reads a quoted value.
//   2. pay_json_int reads a decimal.
//   3. pay_json_object after a key returns the first {…} value.

import "std/str.oo";

fn skip_ws(s: String, i: Int) -> Int {
    let n: Int = chars_len(s);
    let mut p: Int = i;
    while p < n {
        let c: String = char_at(s, p);
        if c == " " || c == "\n" || c == "\t" || c == "\r" {
            p = p + 1;
        } else {
            return p;
        }
    }
    return p;
}

fn after_key(body: String, key: String) -> Int {
    let needle: String = "\"" + key + "\"";
    let n: Int = chars_len(body);
    let m: Int = chars_len(needle);
    let mut from: Int = 0;
    while from < n {
        let rest: String = str_slice(body, from, n);
        let k: Int = str_index_of(rest, needle);
        if k < 0 {
            return -1;
        }
        let abs: Int = from + k;
        let mut p: Int = skip_ws(body, abs + m);
        if p < n {
            if char_at(body, p) == ":" {
                return skip_ws(body, p + 1);
            }
        }
        from = abs + 1;
    }
    return -1;
}

pub fn pay_json_string(body: String, key: String) -> String {
    let p: Int = after_key(body, key);
    if p < 0 {
        return "";
    }
    let n: Int = chars_len(body);
    if p >= n {
        return "";
    }
    if char_at(body, p) != "\"" {
        return "";
    }
    let mut i: Int = p + 1;
    while i < n {
        if char_at(body, i) == "\"" {
            return str_slice(body, p + 1, i);
        }
        i = i + 1;
    }
    return "";
}

pub fn pay_json_int(body: String, key: String) -> Int {
    let p: Int = after_key(body, key);
    if p < 0 {
        return 0;
    }
    let n: Int = chars_len(body);
    let mut i: Int = p;
    let mut acc: String = "";
    while i < n {
        let c: String = char_at(body, i);
        if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" {
            acc = acc + c;
        } else if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
            acc = acc + c;
        } else {
            break;
        }
        i = i + 1;
    }
    if acc == "" {
        return 0;
    }
    return parse_int(acc);
}

pub fn pay_json_object(body: String, key: String) -> String {
    let p: Int = after_key(body, key);
    if p < 0 {
        return "";
    }
    let n: Int = chars_len(body);
    let mut i: Int = p;
    while i < n {
        if char_at(body, i) == "{" {
            let mut depth: Int = 0;
            let mut j: Int = i;
            while j < n {
                let c: String = char_at(body, j);
                if c == "{" {
                    depth = depth + 1;
                }
                if c == "}" {
                    depth = depth - 1;
                    if depth == 0 {
                        return str_slice(body, i, j + 1);
                    }
                }
                j = j + 1;
            }
            return "";
        }
        i = i + 1;
    }
    return "";
}

pub fn pay_json_first_accept(body: String) -> String {
    return pay_json_object(body, "accepts");
}
