// # x402 spend pin (fail-closed)
//
// Logline: Refuse to spend until a process pin says spend is on. No wallet here.
//
// Setup: Pure pin string. Callers pass OODA_X402_SPEND or leave empty.
//
// Beats:
//   1. Empty or any value other than 1 denies spend.
//   2. Pin 1 allows attaching an X-PAYMENT proof string.
//   3. Empty proof is still denied.
//
// residual: no chain send; no facilitator; pin is not a budget

import "std/net/x402.oo";

pub fn x402_spend_pin_on(pin: String) -> Bool {
    return pin == "1";
}

pub fn x402_may_spend(pin: String, proof: String) -> Bool {
    if !x402_spend_pin_on(pin) {
        return false;
    }
    if proof == "" {
        return false;
    }
    return true;
}

pub fn x402_attach_or_deny(pin: String, proof: String) -> Result[Bool, String] {
    if !x402_spend_pin_on(pin) {
        return Err("x402 spend denied: set OODA_X402_SPEND=1");
    }
    if proof == "" {
        return Err("x402 spend denied: empty proof");
    }
    return Ok(true);
}
