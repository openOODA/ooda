        recv_buf_size: rb,
        send_buf_size: sb,
        recv_timeout_ms: rt,
        send_timeout_ms: st
    };
}

pub fn socket_opts_with_nodelay(opts: SocketOptions, val: Bool) -> SocketOptions {
    let ra: Bool = opts.reuse_addr;
    let rp: Bool = opts.reuse_port;
    let ka: Bool = opts.keep_alive;
    let rb: Int = opts.recv_buf_size;
    let sb: Int = opts.send_buf_size;
