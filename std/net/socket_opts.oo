// # Socket Options and Configuration Descriptors Module
//
// Logline: Socket configuration attributes, SO_REUSEADDR, TCP_NODELAY, buffer sizing, and timeouts.
//
// Setup: Pure socket options builder for TCP and UDP socket initialization.
//
// Beats:
//   1. Define SocketOptions struct with reuse flags, keepalive, nodelay, buffers, and timeouts.
//   2. Provide standard default socket options (SO_REUSEADDR enabled, TCP_NODELAY enabled).
//   3. Implement immutable option builder modifiers for socket parameters.
//   4. Format diagnostic summaries of active socket configurations.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type SocketOptions = struct {
    reuse_addr: Bool,
    reuse_port: Bool,
    keep_alive: Bool,
    tcp_nodelay: Bool,
    recv_buf_size: Int,
    send_buf_size: Int,
    recv_timeout_ms: Int,
    send_timeout_ms: Int
};

pub fn socket_opts_default() -> SocketOptions {
    return SocketOptions {
        reuse_addr: true,
        reuse_port: false,
        keep_alive: true,
        tcp_nodelay: true,
        recv_buf_size: 65536,
        send_buf_size: 65536,
        recv_timeout_ms: 30000,
        send_timeout_ms: 30000
    };
}

pub fn socket_opts_with_reuse_addr(opts: SocketOptions, val: Bool) -> SocketOptions {
    let rp: Bool = opts.reuse_port;
    let ka: Bool = opts.keep_alive;
    let nd: Bool = opts.tcp_nodelay;
    let rb: Int = opts.recv_buf_size;
    let sb: Int = opts.send_buf_size;
    let rt: Int = opts.recv_timeout_ms;
    let st: Int = opts.send_timeout_ms;
    return SocketOptions {
        reuse_addr: val,
        reuse_port: rp,
        keep_alive: ka,
        tcp_nodelay: nd,
        recv_buf_size: rb,
        send_buf_size: sb,
        recv_timeout_ms: rt,
        send_timeout_ms: st
    };
}

pub fn socket_opts_with_reuse_port(opts: SocketOptions, val: Bool) -> SocketOptions {
    let ra: Bool = opts.reuse_addr;
    let ka: Bool = opts.keep_alive;
    let nd: Bool = opts.tcp_nodelay;
    let rb: Int = opts.recv_buf_size;
    let sb: Int = opts.send_buf_size;
    let rt: Int = opts.recv_timeout_ms;
    let st: Int = opts.send_timeout_ms;
    return SocketOptions {
        reuse_addr: ra,
        reuse_port: val,
        keep_alive: ka,
        tcp_nodelay: nd,
        recv_buf_size: rb,
        send_buf_size: sb,
        recv_timeout_ms: rt,
        send_timeout_ms: st
    };
}

