        reuse_addr: ra,
        reuse_port: rp,
        keep_alive: ka,
        tcp_nodelay: val,
        recv_buf_size: rb,
        send_buf_size: sb,
        recv_timeout_ms: rt,
        send_timeout_ms: st
    };
}

pub fn socket_opts_with_timeouts(opts: SocketOptions, recv_ms: Int, send_ms: Int) -> SocketOptions {
    let ra: Bool = opts.reuse_addr;
    let rp: Bool = opts.reuse_port;
    let ka: Bool = opts.keep_alive;
    let nd: Bool = opts.tcp_nodelay;
    let rb: Int = opts.recv_buf_size;
    let sb: Int = opts.send_buf_size;
    return SocketOptions {
        reuse_addr: ra,
        reuse_port: rp,
        keep_alive: ka,
        tcp_nodelay: nd,
        recv_buf_size: rb,
        send_buf_size: sb,
        recv_timeout_ms: recv_ms,
        send_timeout_ms: send_ms
    };
}

pub fn socket_opts_with_buf_sizes(opts: SocketOptions, recv_bytes: Int, send_bytes: Int) -> SocketOptions {
    let ra: Bool = opts.reuse_addr;
    let rp: Bool = opts.reuse_port;
    let ka: Bool = opts.keep_alive;
    let nd: Bool = opts.tcp_nodelay;
    let rt: Int = opts.recv_timeout_ms;
    let st: Int = opts.send_timeout_ms;
    return SocketOptions {
        reuse_addr: ra,
        reuse_port: rp,
        keep_alive: ka,
        tcp_nodelay: nd,
        recv_buf_size: recv_bytes,
        send_buf_size: send_bytes,
        recv_timeout_ms: rt,
        send_timeout_ms: st
    };
}

pub fn socket_opts_format(opts: SocketOptions) -> String {
    let ra: Bool = opts.reuse_addr;
    let nd: Bool = opts.tcp_nodelay;
    let rt: Int = opts.recv_timeout_ms;
    let rt_str: String = rt.to_string();
    let mut ra_str: String = "reuse_addr=0";
    if ra { ra_str = "reuse_addr=1"; }
    let mut nd_str: String = "nodelay=0";
    if nd { nd_str = "nodelay=1"; }
    return "[SocketOpts: " + ra_str + " " + nd_str + " timeout=" + rt_str + "ms]";
}
