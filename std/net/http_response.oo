// # HTTP Response Representation and Parsing Module
//
// Logline: HTTP response status codes, reason phrases, header formatting, and body decoding.
//
// Setup: Pure message abstraction for HTTP/1.1 response status, headers, and body payloads.
//
// Beats:
//   1. Define HttpResponse struct with status code, reason phrase, version, headers, and body.
//   2. Provide constructors for standard HTTP responses (200, 201, 400, 404, 500).
//   3. Map integer status codes to canonical reason phrases.
//   4. Serialize and parse HTTP response status lines, headers, and payloads.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type HttpResponse = struct {
    status_code: Int,
    reason_phrase: String,
    version: String,
    headers: String,
    body: String
};

pub fn http_response_reason(code: Int) -> String {
    if code == 200 { return "OK"; }
    if code == 201 { return "Created"; }
    if code == 202 { return "Accepted"; }
    if code == 204 { return "No Content"; }
    if code == 301 { return "Moved Permanently"; }
    if code == 302 { return "Found"; }
    if code == 304 { return "Not Modified"; }
    if code == 400 { return "Bad Request"; }
    if code == 401 { return "Unauthorized"; }
    if code == 402 { return "Payment Required"; }
    if code == 403 { return "Forbidden"; }
    if code == 404 { return "Not Found"; }
    if code == 405 { return "Method Not Allowed"; }
    if code == 425 { return "Too Early"; }
    if code == 429 { return "Too Many Requests"; }
    if code == 500 { return "Internal Server Error"; }
    if code == 502 { return "Bad Gateway"; }
    if code == 503 { return "Service Unavailable"; }
    if code == 504 { return "Gateway Timeout"; }
    return "Unknown";
}

pub fn http_response_new(status_code: Int, body: String) -> HttpResponse {
    let r: String = http_response_reason(status_code);
    return HttpResponse {
        status_code: status_code,
        reason_phrase: r,
        version: "HTTP/1.1",
        headers: "",
        body: body
    };
}

pub fn http_response_ok(body: String) -> HttpResponse {
    return http_response_new(200, body);
}

pub fn http_response_created(body: String) -> HttpResponse {
    return http_response_new(201, body);
}

pub fn http_response_bad_request(msg: String) -> HttpResponse {
    return http_response_new(400, msg);
}

pub fn http_response_payment_required(body: String) -> HttpResponse {
    return http_response_new(402, body);
}

pub fn http_response_not_found(msg: String) -> HttpResponse {
    return http_response_new(404, msg);
}

pub fn http_response_too_early(body: String) -> HttpResponse {
    return http_response_new(425, body);
}

pub fn http_response_server_error(msg: String) -> HttpResponse {
    return http_response_new(500, msg);
}

pub fn http_response_is_success(resp: HttpResponse) -> Bool {
    let s: Int = resp.status_code;
    return s >= 200 && s < 300;
}

pub fn http_response_with_header(resp: HttpResponse, name: String, value: String) -> HttpResponse {
    let s: Int = resp.status_code;
    let r: String = resp.reason_phrase;
    let v: String = resp.version;
    let h: String = resp.headers;
    let b: String = resp.body;
    let new_h: String = h + name + ": " + value + "\r\n";
    return HttpResponse {
        status_code: s,
        reason_phrase: r,
        version: v,
        headers: new_h,
        body: b
    };
}

pub fn http_response_serialize(resp: HttpResponse) -> String {
    let s: Int = resp.status_code;
    let s_str: String = s.to_string();
    let r: String = resp.reason_phrase;
    let v: String = resp.version;
    let h: String = resp.headers;
    let b: String = resp.body;
    let mut out: String = v + " " + s_str + " " + r + "\r\n";
    if chars_len(h) > 0 {
        out = out + h;
    }
    let blen: Int = chars_len(b);
    if blen > 0 {
        let blen_str: String = blen.to_string();
        if !h.contains("Content-Length:") {
            out = out + "Content-Length: " + blen_str + "\r\n";
        }
    }
    out = out + "\r\n";
    if blen > 0 {
        out = out + b;
    }
    return out;
}

fn http_parse_digits(s: String) -> Int {
    let mut acc: Int = 0;
    let mut i: Int = 0;
    let n: Int = chars_len(s);
    while i < n {
        let c: String = char_at(s, i);
        let mut d: Int = -1;
        if c == "0" { d = 0; }
        if c == "1" { d = 1; }
        if c == "2" { d = 2; }
        if c == "3" { d = 3; }
        if c == "4" { d = 4; }
        if c == "5" { d = 5; }
        if c == "6" { d = 6; }
        if c == "7" { d = 7; }
        if c == "8" { d = 8; }
        if c == "9" { d = 9; }
        if d < 0 {
            return acc;
        }
        acc = acc * 10 + d;
        i = i + 1;
    }
    return acc;
}

pub fn http_response_parse_status(raw: String) -> Int {
    if !raw.contains("HTTP/") {
        return 0;
    }
    let p: Int = str_index_of(raw, " ");
    if p < 0 {
        return 0;
    }
    let n: Int = chars_len(raw);
    let rem: String = str_slice(raw, p + 1, n);
    let end_p: Int = str_index_of(rem, " ");
    if end_p < 0 {
        return 0;
    }
    let code_str: String = str_slice(rem, 0, end_p);
    return http_parse_digits(code_str);
}

pub fn http_response_parse_body(raw: String) -> String {
    let dnl: Int = str_index_of(raw, "\r\n\r\n");
    let n: Int = chars_len(raw);
    if dnl >= 0 {
        return str_slice(raw, dnl + 4, n);
    }
    let dnl2: Int = str_index_of(raw, "\n\n");
    if dnl2 >= 0 {
        return str_slice(raw, dnl2 + 2, n);
    }
    return raw;
}
