// # WebSocket Framing and Opcode Definition Module
//
// Logline: WebSocket frame structure, opcodes (Text, Binary, Ping, Pong, Close), masking keys, and serialization (RFC 6455).
//
// Setup: Pure data abstraction for RFC 6455 WebSocket framing and message encapsulation.
//
// Beats:
//   1. Define WebSocketFrame struct with FIN, opcode, mask flag, key, length, and payload.
//   2. Provide constructors for standard frame types (Text, Binary, Ping, Pong, Close).
//   3. Implement opcode classification, control frame identification, and frame formatting.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type WebSocketFrame = struct {
    fin: Bool,
    opcode: Int,
    masked: Bool,
    mask_key: String,
    payload_len: Int,
    payload: String
};

pub fn ws_frame_opcode_name(opcode: Int) -> String {
    if opcode == 0 { return "CONTINUATION"; }
    if opcode == 1 { return "TEXT"; }
    if opcode == 2 { return "BINARY"; }
    if opcode == 8 { return "CLOSE"; }
    if opcode == 9 { return "PING"; }
    if opcode == 10 { return "PONG"; }
    return "UNKNOWN";
}

pub fn ws_frame_new(fin: Bool, opcode: Int, masked: Bool, payload: String) -> WebSocketFrame {
    let len: Int = chars_len(payload);
    let mut key: String = "";
    if masked {
        key = "1234";
    }
    return WebSocketFrame {
        fin: fin,
        opcode: opcode,
        masked: masked,
        mask_key: key,
        payload_len: len,
        payload: payload
    };
}

pub fn ws_frame_text(text: String, masked: Bool) -> WebSocketFrame {
    return ws_frame_new(true, 1, masked, text);
}

pub fn ws_frame_binary(data: String, masked: Bool) -> WebSocketFrame {
    return ws_frame_new(true, 2, masked, data);
}

pub fn ws_frame_ping(data: String) -> WebSocketFrame {
    return ws_frame_new(true, 9, false, data);
}

pub fn ws_frame_pong(data: String) -> WebSocketFrame {
    return ws_frame_new(true, 10, false, data);
}

pub fn ws_frame_close(code: Int, reason: String) -> WebSocketFrame {
    let c_str: String = code.to_string();
    let body: String = c_str + ":" + reason;
    return ws_frame_new(true, 8, false, body);
}

pub fn ws_frame_is_control(frame: WebSocketFrame) -> Bool {
    let op: Int = frame.opcode;
    return op >= 8;
}

pub fn ws_frame_format(frame: WebSocketFrame) -> String {
    let op: Int = frame.opcode;
    let op_name: String = ws_frame_opcode_name(op);
    let len: Int = frame.payload_len;
    let len_str: String = len.to_string();
    let f: Bool = frame.fin;
    let mut fin_str: String = "FIN";
    if !f {
        fin_str = "CONT";
    }
    return "[WebSocket Frame: " + fin_str + " op=" + op_name + " len=" + len_str + "]";
}
