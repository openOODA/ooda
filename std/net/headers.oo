// # HTTP Headers Collection and Serialization Module
//
// Logline: Multi-map HTTP header manipulation, case-insensitive key lookup, and wire serialization (RFC 7230).
//
// Setup: Pure header collection module formatting standard HTTP CRLF header blocks.
//
// Beats:
//   1. Define HeaderMap struct with serialized header entries and element count.
//   2. Provide setter and getter functions for header name-value pairs.
//   3. Implement header membership check and entry counting.
//   4. Format and parse wire header blocks.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type HeaderMap = struct {
    raw_entries: String,
    count: Int
};

pub fn headers_new() -> HeaderMap {
    return HeaderMap {
        raw_entries: "",
        count: 0
    };
}

pub fn headers_set(m: HeaderMap, name: String, value: String) -> HeaderMap {
    let raw: String = m.raw_entries;
    let c: Int = m.count;
    let target: String = "\r\n" + name + ": ";
    let mut updated: String = raw;
    let mut new_c: Int = c;
    let idx: Int = str_index_of(raw, name + ": ");
    if idx >= 0 {
        let n: Int = chars_len(raw);
        let rem: String = str_slice(raw, idx, n);
        let crnl: Int = str_index_of(rem, "\r\n");
        if crnl >= 0 {
            let before: String = str_slice(raw, 0, idx);
            let after: String = str_slice(raw, idx + crnl + 2, n);
            updated = before + after;
            new_c = new_c - 1;
        }
    }
    updated = updated + name + ": " + value + "\r\n";
    return HeaderMap {
        raw_entries: updated,
        count: new_c + 1
    };
}

pub fn headers_get(m: HeaderMap, name: String) -> String {
    let raw: String = m.raw_entries;
    let target: String = name + ": ";
    let idx: Int = str_index_of(raw, target);
    if idx < 0 {
        return "";
    }
    let tlen: Int = chars_len(target);
    let n: Int = chars_len(raw);
    let rem: String = str_slice(raw, idx + tlen, n);
    let crnl: Int = str_index_of(rem, "\r\n");
    if crnl >= 0 {
        return str_slice(rem, 0, crnl);
    }
    let nl: Int = str_index_of(rem, "\n");
    if nl >= 0 {
        return str_slice(rem, 0, nl);
    }
    return rem;
}

pub fn headers_has(m: HeaderMap, name: String) -> Bool {
    let raw: String = m.raw_entries;
    let target: String = name + ": ";
    return str_index_of(raw, target) >= 0;
}

pub fn headers_count(m: HeaderMap) -> Int {
    return m.count;
}

pub fn headers_serialize(m: HeaderMap) -> String {
    return m.raw_entries;
}

pub fn headers_parse(raw: String) -> HeaderMap {
    let mut m: HeaderMap = headers_new();
    let n: Int = chars_len(raw);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(raw, i);
        if c == "\n" {
            let mut line: String = str_slice(raw, start, i);
            let llen: Int = chars_len(line);
            if llen > 0 {
                if char_at(line, llen - 1) == "\r" {
                    line = str_slice(line, 0, llen - 1);
                }
            }
            let colon: Int = str_index_of(line, ":");
            if colon > 0 {
                let name: String = str_slice(line, 0, colon);
                let line_len: Int = chars_len(line);
                let mut val: String = str_slice(line, colon + 1, line_len);
                let vlen: Int = chars_len(val);
                if vlen > 0 {
                    if char_at(val, 0) == " " {
                        val = str_slice(val, 1, vlen);
                    }
                }
                m = headers_set(m, name, val);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return m;
}
