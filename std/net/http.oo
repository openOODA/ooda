// # Fetch one URL under NetCap
//
// Logline: http_fetch forwards a URL under NetCap and returns the response body or Err.
//
// Setup: Callers pass &NetCap. Runtime injects the token. This file does not mint one.
//
// Beats:
//   1. Caller passes &NetCap and a URL string.
//   2. http_fetch forwards to fetch.
//   3. Sealed fetch returns Ok(body) or Err.
//
// residual: this leaf keeps legacy NetCap; no method, headers, or HttpCap here.

// GET the URL under NetCap.
pub fn http_fetch(net: &NetCap, url: String) -> Result[String, String] {
    return fetch(net, url);
}
