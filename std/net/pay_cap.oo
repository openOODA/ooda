// # Pay with a capability (not USDC)
//
// Logline: Parse a 402 that wants an attenuated cap, not a chain payment.
//
// Setup: Pure strings. No grant, no kernel seal, no wallet.
//
// Beats:
//   1. CAP-REQUIRED names the header that carries the quote.
//   2. Ready when scheme is cap and cap + resource are present.
//   3. Attach CAP-PROOF is denied unless OODA_CAP_SPEND=1 and proof is not empty.
//
// residual: does not check a live FsRead/MsgCap token

import "std/net/pay_json.oo";
import "std/net/pay_pin.oo";

type PayCapQuote = struct {
    scheme: String,
    cap: String,
    path: String,
    domain: String,
    resource: String
};

pub fn pay_cap_required_header_name() -> String {
    return "CAP-REQUIRED";
}

pub fn pay_cap_proof_header_name() -> String {
    return "CAP-PROOF";
}

pub fn pay_cap_parse(body: String) -> PayCapQuote {
    let acc: String = pay_json_first_accept(body);
    let mut src: String = acc;
    if src == "" {
        src = body;
    }
    let mut res: String = pay_json_string(body, "url");
    if res == "" {
        res = pay_json_string(src, "resource");
    }
    return PayCapQuote {
        scheme: pay_json_string(src, "scheme"),
        cap: pay_json_string(src, "cap"),
        path: pay_json_string(src, "path"),
        domain: pay_json_string(src, "domain"),
        resource: res
    };
}

pub fn pay_cap_ready(q: PayCapQuote) -> Bool {
    if q.scheme != "cap" {
        return false;
    }
    if q.cap == "" {
        return false;
    }
    if q.resource == "" {
        return false;
    }
    return true;
}

pub fn pay_cap_format(q: PayCapQuote) -> String {
    return "pay cap " + q.cap + " path=" + q.path + " for " + q.resource;
}

pub fn pay_cap_required_json(cap: String, path: String, resource: String) -> String {
    return "{\"x402Version\":2,\"error\":\"CAP-PROOF header is required\",\"resource\":{\"url\":\"" + resource + "\"},\"accepts\":[{\"scheme\":\"cap\",\"cap\":\"" + cap + "\",\"path\":\"" + path + "\"}]}";
}

pub fn pay_cap_proof_line(proof: String) -> String {
    return "CAP-PROOF: " + proof;
}

pub fn pay_cap_attach_or_deny(pin: String, proof: String) -> Result[Bool, String] {
    return pay_attach_or_deny(pin, proof, "OODA_CAP_SPEND=1");
}
