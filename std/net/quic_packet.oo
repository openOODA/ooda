// # QUIC Packet Representation and Header Typing Module
//
// Logline: QUIC packet types, Long and Short header distinctions, Connection IDs, and wire summaries (RFC 9000).
//
// Setup: Pure data abstractions for Initial, Handshake, 0-RTT, Retry, and 1-RTT QUIC packets.
//
// Beats:
//   1. Define QuicPacket struct with header flag, packet type, version, CID pairs, PN, and payload.
//   2. Provide constructors for Long-Header (Initial, Handshake, Retry) and Short-Header (1-RTT) packets.
//   3. Implement header classification and packet telemetry formatting.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type QuicPacket = struct {
    is_long_header: Bool,
    packet_type: String,
    version: Int,
    dcid: String,
    scid: String,
    packet_number: Int,
    payload: String
};

pub fn quic_packet_initial(dcid: String, scid: String, payload: String) -> QuicPacket {
    return QuicPacket {
        is_long_header: true,
        packet_type: "Initial",
        version: 1,
        dcid: dcid,
        scid: scid,
        packet_number: 0,
        payload: payload
    };
}

pub fn quic_packet_handshake(dcid: String, scid: String, packet_number: Int, payload: String) -> QuicPacket {
    return QuicPacket {
        is_long_header: true,
        packet_type: "Handshake",
        version: 1,
        dcid: dcid,
        scid: scid,
        packet_number: packet_number,
        payload: payload
    };
}

pub fn quic_packet_retry(dcid: String, scid: String, payload: String) -> QuicPacket {
    return QuicPacket {
        is_long_header: true,
        packet_type: "Retry",
        version: 1,
        dcid: dcid,
        scid: scid,
        packet_number: 0,
        payload: payload
    };
}

pub fn quic_packet_short(dcid: String, packet_number: Int, payload: String) -> QuicPacket {
    return QuicPacket {
        is_long_header: false,
        packet_type: "1-RTT",
        version: 1,
        dcid: dcid,
        scid: "",
        packet_number: packet_number,
        payload: payload
    };
}

pub fn quic_packet_is_long(packet: QuicPacket) -> Bool {
    return packet.is_long_header;
}

pub fn quic_packet_format(packet: QuicPacket) -> String {
    let pty: String = packet.packet_type;
    let dcid: String = packet.dcid;
    let pn: Int = packet.packet_number;
    let pn_str: String = pn.to_string();
    let plen: Int = chars_len(packet.payload);
    let plen_str: String = plen.to_string();
    let mut hdr_kind: String = "Short";
    let long_hdr: Bool = packet.is_long_header;
    if long_hdr {
        hdr_kind = "Long";
    }
    return "[QUIC " + hdr_kind + " Packet: type=" + pty + " dcid=" + dcid + " pn=" + pn_str + " len=" + plen_str + "]";
}
