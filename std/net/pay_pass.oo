// # Privacy Pass challenge scrape (RFC 9577 shape)
//
// Logline: Read a PrivateToken challenge. Do not mint or redeem.
//
// Setup: Header value like: PrivateToken challenge="…", token-key="…"
//
// Beats:
//   1. WWW-Authenticate / Authorization scheme name is PrivateToken.
//   2. Ready when challenge and token-key are both present.
//   3. Attach Authorization is denied unless OODA_PASS_ATTACH=1 and the token is not empty.
//
// residual: no VOPRF, no issuer, no origin redeem

import "std/net/pay_pin.oo";
import "std/str.oo";

type PayPass = struct {
    scheme: String,
    challenge: String,
    token_key: String
};

fn quoted_after(s: String, key: String) -> String {
    let needle: String = key + "=\"";
    let k: Int = str_index_of(s, needle);
    if k < 0 {
        return "";
    }
    let n: Int = chars_len(s);
    let start: Int = k + chars_len(needle);
    let mut i: Int = start;
    while i < n {
        if char_at(s, i) == "\"" {
            return str_slice(s, start, i);
        }
        i = i + 1;
    }
    return "";
}

pub fn pay_pass_auth_scheme() -> String {
    return "PrivateToken";
}

pub fn pay_pass_parse(header: String) -> PayPass {
    return PayPass {
        scheme: "PrivateToken",
        challenge: quoted_after(header, "challenge"),
        token_key: quoted_after(header, "token-key")
    };
}

pub fn pay_pass_ready(p: PayPass) -> Bool {
    if p.challenge == "" {
        return false;
    }
    if p.token_key == "" {
        return false;
    }
    return true;
}

pub fn pay_pass_format(p: PayPass) -> String {
    let n: Int = chars_len(p.challenge);
    return "PrivateToken challenge-len " + n.to_string();
}

pub fn pay_pass_www_authenticate(challenge: String, token_key: String) -> String {
    return "PrivateToken challenge=\"" + challenge + "\", token-key=\"" + token_key + "\"";
}

pub fn pay_pass_authorization_line(token: String) -> String {
    return "Authorization: PrivateToken token=\"" + token + "\"";
}

pub fn pay_pass_attach_or_deny(pin: String, token: String) -> Result[Bool, String] {
    return pay_attach_or_deny(pin, token, "OODA_PASS_ATTACH=1");
}
