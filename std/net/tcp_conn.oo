// # TCP Connection Lifecycle and Stream IO Module
//
// Logline: TCP connection establishment, stream read/write transfer, accounting, and socket teardown under TcpCap.
//
// Setup: Encapsulates process socket slot IO with explicit capability verification.
//
// Beats:
//   1. Define TcpConnection struct with socket slot, endpoint host/port, connection state, and byte counters.
//   2. Open TCP stream connection to remote host and port under TcpCap.
//   3. Transmit and receive stream bytes with accounting updates.
//   4. Close active TCP socket slot and transition state to disconnected.
// RULES.oot 1.4: Default-deny for network effects. Explicit &TcpCap required.
// RULES.oot 1.7: Under 256 lines.

type TcpConnection = struct {
    slot: Int,
    host: String,
    port: Int,
    is_connected: Bool,
    bytes_sent: Int,
    bytes_recv: Int
};

pub fn tcp_conn_open(tcp: &TcpCap, host: String, port: Int) -> Result[TcpConnection, String] {
    if chars_len(host) == 0 {
        return Err("TCP_CONN_ERR: empty host name");
    }
    if port <= 0 || port > 65535 {
        return Err("TCP_CONN_ERR: invalid port number");
    }
    let res: Result[String, String] = tcp_connect(tcp, host, port);
    if res.is_err() {
        let e: String = match res {
            Ok(s) => s,
            Err(msg) => msg
        };
        return Err("TCP_CONNECT_ERR: " + e);
    }
    let conn: TcpConnection = TcpConnection {
        slot: 1,
        host: host,
        port: port,
        is_connected: true,
        bytes_sent: 0,
        bytes_recv: 0
    };
    return Ok(conn);
}

pub fn tcp_conn_write(tcp: &TcpCap, conn: TcpConnection, data: String) -> Result[TcpConnection, String] {
    let open: Bool = conn.is_connected;
    if !open {
        return Err("TCP_CONN_ERR: connection is closed");
    }
    let s: Int = conn.slot;
    let res: Result[String, String] = tcp_write(tcp, s, data);
    if res.is_err() {
        let e: String = match res {
            Ok(val) => val,
            Err(msg) => msg
        };
        return Err("TCP_WRITE_ERR: " + e);
    }
    let dlen: Int = chars_len(data);
    let sent: Int = conn.bytes_sent;
    let recv: Int = conn.bytes_recv;
    let h: String = conn.host;
    let p: Int = conn.port;
    let updated: TcpConnection = TcpConnection {
        slot: s,
        host: h,
        port: p,
        is_connected: true,
        bytes_sent: sent + dlen,
        bytes_recv: recv
    };
    return Ok(updated);
}

pub fn tcp_conn_read(tcp: &TcpCap, conn: TcpConnection, max_n: Int) -> Result[String, String] {
    let open: Bool = conn.is_connected;
    if !open {
        return Err("TCP_CONN_ERR: connection is closed");
    }
    let s: Int = conn.slot;
    return tcp_read(tcp, s, max_n);
}

pub fn tcp_conn_close(tcp: &TcpCap, conn: TcpConnection) -> Result[TcpConnection, String] {
    let s: Int = conn.slot;
    let res: Result[String, String] = tcp_close(tcp, s);
    if res.is_err() {
        let e: String = match res {
            Ok(val) => val,
            Err(msg) => msg
        };
        return Err("TCP_CLOSE_ERR: " + e);
    }
    let h: String = conn.host;
    let p: Int = conn.port;
    let sent: Int = conn.bytes_sent;
    let recv: Int = conn.bytes_recv;
    let closed: TcpConnection = TcpConnection {
        slot: -1,
        host: h,
        port: p,
        is_connected: false,
        bytes_sent: sent,
        bytes_recv: recv
    };
    return Ok(closed);
}

pub fn tcp_conn_is_open(conn: TcpConnection) -> Bool {
    return conn.is_connected;
}

pub fn tcp_conn_info(conn: TcpConnection) -> String {
    let h: String = conn.host;
    let p: Int = conn.port;
    let p_str: String = p.to_string();
    let sent: Int = conn.bytes_sent;
    let sent_str: String = sent.to_string();
    let recv: Int = conn.bytes_recv;
    let recv_str: String = recv.to_string();
    let mut st_str: String = "open";
    let open: Bool = conn.is_connected;
    if !open { st_str = "closed"; }
    return "[TCP Conn: " + h + ":" + p_str + " state=" + st_str + " tx=" + sent_str + " rx=" + recv_str + "]";
}

pub fn tcp_conn_probe() -> Int {
    return 0;
}
