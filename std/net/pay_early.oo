// # HTTP 425 Too Early (RFC 8470) for pay replay
//
// Logline: 425 means the proof arrived before it was valid, or the quote is not live yet.
//
// Setup: Pure status + JSON. No clock. Callers pass validAfter as a string.
//
// Beats:
//   1. Status 425 is too early. 402 is not.
//   2. Ready when validAfter is present.
//   3. Attach is denied unless OODA_EARLY_RETRY=1 and the retry string is not empty.
//
// residual: does not compare wall time

import "std/net/pay_json.oo";
import "std/net/pay_pin.oo";

type PayEarly = struct {
    valid_after: String,
    reason: String,
    resource: String
};

pub fn pay_early_is_too_early(status: Int) -> Bool {
    return status == 425;
}

pub fn pay_early_parse(body: String) -> PayEarly {
    let mut res: String = pay_json_string(body, "url");
    if res == "" {
        res = pay_json_string(body, "resource");
    }
    return PayEarly {
        valid_after: pay_json_string(body, "validAfter"),
        reason: pay_json_string(body, "reason"),
        resource: res
    };
}

pub fn pay_early_ready(e: PayEarly) -> Bool {
    if e.valid_after == "" {
        return false;
    }
    return true;
}

pub fn pay_early_format(e: PayEarly) -> String {
    return "too early until " + e.valid_after + " " + e.resource;
}

pub fn pay_early_json(valid_after: String, resource: String, reason: String) -> String {
    return "{\"validAfter\":\"" + valid_after + "\",\"reason\":\"" + reason + "\",\"resource\":{\"url\":\"" + resource + "\"}}";
}

pub fn pay_early_retry_or_deny(pin: String, proof: String) -> Result[Bool, String] {
    return pay_attach_or_deny(pin, proof, "OODA_EARLY_RETRY=1");
}
