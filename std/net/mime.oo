// # MIME Media Type Identification and Registry Module
//
// Logline: Media type resolution from file extensions, text/binary classification, and Content-Type formatting.
//
// Setup: Pure MIME dictionary and media type classifier for HTTP and network payloads.
//
// Beats:
//   1. Resolve standard MIME types from file extensions (json, html, js, css, png, etc.).
//   2. Extract file extension and MIME type from full file paths.
//   3. Classify MIME types into text, json, or binary media categories.
//   4. Format and strip character sets from Content-Type strings.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

pub fn mime_from_extension(ext: String) -> String {
    if ext == "html" || ext == "htm" { return "text/html"; }
    if ext == "json" { return "application/json"; }
    if ext == "js" || ext == "mjs" { return "application/javascript"; }
    if ext == "css" { return "text/css"; }
    if ext == "txt" || ext == "oo" { return "text/plain"; }
    if ext == "xml" { return "application/xml"; }
    if ext == "csv" { return "text/csv"; }
    if ext == "png" { return "image/png"; }
    if ext == "jpg" || ext == "jpeg" { return "image/jpeg"; }
    if ext == "gif" { return "image/gif"; }
    if ext == "svg" { return "image/svg+xml"; }
    if ext == "webp" { return "image/webp"; }
    if ext == "pdf" { return "application/pdf"; }
    if ext == "zip" { return "application/zip"; }
    if ext == "gz" || ext == "gzip" { return "application/gzip"; }
    if ext == "tar" { return "application/x-tar"; }
    if ext == "wasm" { return "application/wasm"; }
    if ext == "mp4" { return "video/mp4"; }
    if ext == "mp3" { return "audio/mpeg"; }
    return "application/octet-stream";
}

pub fn mime_from_path(path: String) -> String {
    let n: Int = chars_len(path);
    let mut dot_idx: Int = -1;
    let mut i: Int = n - 1;
    while i >= 0 {
        let c: String = char_at(path, i);
        if c == "." {
            dot_idx = i;
            i = -1;
        } else if c == "/" {
            i = -1;
        } else {
            i = i - 1;
        }
    }
    if dot_idx < 0 {
        return "application/octet-stream";
    }
    let ext: String = str_slice(path, dot_idx + 1, n);
    return mime_from_extension(ext);
}

pub fn mime_is_text(mime_type: String) -> Bool {
    if str_starts_with(mime_type, "text/") {
        return true;
    }
    if mime_type == "application/json" || mime_type == "application/javascript" || mime_type == "application/xml" {
        return true;
    }
    return false;
}

pub fn mime_is_json(mime_type: String) -> Bool {
    return mime_type == "application/json" || mime_type.contains("+json");
}

pub fn mime_is_binary(mime_type: String) -> Bool {
    let t: Bool = mime_is_text(mime_type);
    return !t;
}

pub fn mime_with_charset(mime_type: String, charset: String) -> String {
    return mime_type + "; charset=" + charset;
}

pub fn mime_extract_base(mime_type: String) -> String {
    let semi_idx: Int = str_index_of(mime_type, ";");
    if semi_idx >= 0 {
        return str_slice(mime_type, 0, semi_idx);
    }
    return mime_type;
}
