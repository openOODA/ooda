// # DNS Packet and Wire Format Module
//
// Logline: DNS message header definitions, query questions, resource records, and standard record types (RFC 1035).
//
// Setup: Pure data structures representing DNS message wire headers, questions, and RR answers.
//
// Beats:
//   1. Define DnsHeader, DnsQuestion, and DnsRecord structures.
//   2. Define numeric constants and name mapping for standard DNS record types (A, AAAA, MX, TXT, CNAME).
//   3. Format resource records and wire summaries for inspection and diagnostics.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type DnsHeader = struct {
    id: Int,
    qr: Bool,
    opcode: Int,
    aa: Bool,
    tc: Bool,
    rd: Bool,
    ra: Bool,
    rcode: Int,
    qd_count: Int,
    an_count: Int
};

type DnsQuestion = struct {
    name: String,
    qtype: Int,
    qclass: Int
};

type DnsRecord = struct {
    name: String,
    rtype: Int,
    rclass: Int,
    ttl: Int,
    rdata: String
};

pub fn dns_type_a() -> Int { return 1; }
pub fn dns_type_ns() -> Int { return 2; }
pub fn dns_type_cname() -> Int { return 5; }
pub fn dns_type_soa() -> Int { return 6; }
pub fn dns_type_mx() -> Int { return 15; }
pub fn dns_type_txt() -> Int { return 16; }
pub fn dns_type_aaaa() -> Int { return 28; }

pub fn dns_type_name(t: Int) -> String {
    if t == 1 { return "A"; }
    if t == 2 { return "NS"; }
    if t == 5 { return "CNAME"; }
    if t == 6 { return "SOA"; }
    if t == 15 { return "MX"; }
    if t == 16 { return "TXT"; }
    if t == 28 { return "AAAA"; }
    return "UNKNOWN";
}

pub fn dns_header_new(id: Int, rd: Bool) -> DnsHeader {
    return DnsHeader {
        id: id,
        qr: false,
        opcode: 0,
        aa: false,
        tc: false,
        rd: rd,
        ra: false,
        rcode: 0,
        qd_count: 1,
        an_count: 0
    };
}

pub fn dns_question_new(name: String, qtype: Int) -> DnsQuestion {
    return DnsQuestion {
        name: name,
        qtype: qtype,
        qclass: 1
    };
}

pub fn dns_record_new(name: String, rtype: Int, ttl: Int, rdata: String) -> DnsRecord {
    return DnsRecord {
        name: name,
        rtype: rtype,
        rclass: 1,
        ttl: ttl,
        rdata: rdata
    };
}

pub fn dns_record_format(rec: DnsRecord) -> String {
    let name: String = rec.name;
    let rt: Int = rec.rtype;
    let rt_name: String = dns_type_name(rt);
    let ttl: Int = rec.ttl;
    let ttl_str: String = ttl.to_string();
    let rdata: String = rec.rdata;
    return name + " " + ttl_str + " IN " + rt_name + " " + rdata;
}
