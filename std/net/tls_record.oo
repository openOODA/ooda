// # TLS Record Layer Framing and Content Types Module
//
// Logline: TLS record layer framing (RFC 5246 / RFC 8446), content types (Handshake, AppData, Alert), and wire descriptors.
//
// Setup: Pure data abstraction representing TLS record headers, protocol versions, and encrypted/plain fragments.
//
// Beats:
//   1. Define TlsRecord struct with content type, protocol version (major/minor), length, and fragment.
//   2. Provide constructors for standard TLS record types (Handshake, Application Data, Alert, ChangeCipherSpec).
//   3. Implement content type name resolution and record wire formatting.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type TlsRecord = struct {
    content_type: Int,
    version_major: Int,
    version_minor: Int,
    length: Int,
    fragment: String
};

pub fn tls_record_content_name(content_type: Int) -> String {
    if content_type == 20 { return "CHANGE_CIPHER_SPEC"; }
    if content_type == 21 { return "ALERT"; }
    if content_type == 22 { return "HANDSHAKE"; }
    if content_type == 23 { return "APPLICATION_DATA"; }
    if content_type == 24 { return "HEARTBEAT"; }
    return "UNKNOWN";
}

pub fn tls_record_new(content_type: Int, fragment: String) -> TlsRecord {
    let len: Int = chars_len(fragment);
    return TlsRecord {
        content_type: content_type,
        version_major: 3,
        version_minor: 3,
        length: len,
        fragment: fragment
    };
}

pub fn tls_record_handshake(fragment: String) -> TlsRecord {
    return tls_record_new(22, fragment);
}

pub fn tls_record_app_data(fragment: String) -> TlsRecord {
    return tls_record_new(23, fragment);
}

pub fn tls_record_alert(level: Int, description: Int) -> TlsRecord {
    let l_str: String = level.to_string();
    let d_str: String = description.to_string();
    let body: String = l_str + ":" + d_str;
    return tls_record_new(21, body);
}

pub fn tls_record_change_cipher_spec() -> TlsRecord {
    return tls_record_new(20, "\x01");
}

pub fn tls_record_format(rec: TlsRecord) -> String {
    let ct: Int = rec.content_type;
    let cname: String = tls_record_content_name(ct);
    let maj: Int = rec.version_major;
    let maj_str: String = maj.to_string();
    let min: Int = rec.version_minor;
    let min_str: String = min.to_string();
    let len: Int = rec.length;
    let len_str: String = len.to_string();
    return "[TLS Record: type=" + cname + " ver=" + maj_str + "." + min_str + " len=" + len_str + "]";
}
