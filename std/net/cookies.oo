pub fn cookie_serialize_set_cookie(c: HttpCookie) -> String {
    let n: String = c.name;
    let v: String = c.value;
    let mut out: String = n + "=" + v;
    let p: String = c.path;
    if chars_len(p) > 0 {
        out = out + "; Path=" + p;
    }
    let d: String = c.domain;
    if chars_len(d) > 0 {
        out = out + "; Domain=" + d;
    }
    let ma: Int = c.max_age;
    if ma >= 0 {
        let ma_str: String = ma.to_string();
        out = out + "; Max-Age=" + ma_str;
    }
    let s: Bool = c.secure;
    if s {
        out = out + "; Secure";
    }
    let ho: Bool = c.http_only;
    if ho {
        out = out + "; HttpOnly";
    }
    let ss: String = c.same_site;
    if chars_len(ss) > 0 {
        out = out + "; SameSite=" + ss;
    }
    return out;
}

pub fn cookie_serialize_cookie(c: HttpCookie) -> String {
    let n: String = c.name;
    let v: String = c.value;
    return n + "=" + v;
}

pub fn cookie_parse_name(raw: String) -> String {
    let eq_idx: Int = str_index_of(raw, "=");
    if eq_idx < 0 {
        return raw;
    }
    return str_slice(raw, 0, eq_idx);
}

pub fn cookie_parse_value(raw: String) -> String {
    let eq_idx: Int = str_index_of(raw, "=");
    if eq_idx < 0 {
        return "";
    }
    let n: Int = chars_len(raw);
    let rem: String = str_slice(raw, eq_idx + 1, n);
    let semi_idx: Int = str_index_of(rem, ";");
    if semi_idx >= 0 {
        return str_slice(rem, 0, semi_idx);
    }
    return rem;
}
