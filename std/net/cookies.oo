// # HTTP Cookie Representation and Parsing Module
//
// Logline: Cookie attributes, Set-Cookie wire serialization, security flags, and name-value extraction (RFC 6265).
//
// Setup: Pure HTTP Cookie builder and parser supporting Path, Domain, Max-Age, Secure, HttpOnly, and SameSite.
//
// Beats:
//   1. Define HttpCookie struct with name, value, path, domain, max_age, secure, http_only, and same_site.
//   2. Provide builder functions for configuring cookie security and scope attributes.
//   3. Serialize HttpCookie into standard Set-Cookie and Cookie header wire formats.
//   4. Extract name and value pairs from raw Cookie strings.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type HttpCookie = struct {
    name: String,
    value: String,
    path: String,
    domain: String,
    max_age: Int,
    secure: Bool,
    http_only: Bool,
    same_site: String
};

pub fn cookie_new(name: String, value: String) -> HttpCookie {
    return HttpCookie {
        name: name,
        value: value,
        path: "/",
        domain: "",
        max_age: -1,
        secure: false,
        http_only: false,
        same_site: "Lax"
    };
}

pub fn cookie_with_path(c: HttpCookie, path: String) -> HttpCookie {
    let n: String = c.name;
    let v: String = c.value;
    let d: String = c.domain;
    let ma: Int = c.max_age;
    let s: Bool = c.secure;
    let ho: Bool = c.http_only;
    let ss: String = c.same_site;
    return HttpCookie {
        name: n,
        value: v,
        path: path,
        domain: d,
        max_age: ma,
        secure: s,
        http_only: ho,
        same_site: ss
    };
}

