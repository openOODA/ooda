// # DNS Client Resolution Module
//
// Logline: DNS client configuration, forward and IPv4 queries, and capability-gated resolution under NetCap.
//
// Setup: Bridges user-configured DNS resolvers with native hostname resolution primitives.
//
// Beats:
//   1. Define DnsClientConfig struct with nameserver IP, port, and query timeout.
//   2. Dispatch forward domain lookups via oo_dns_resolve under NetCap.
//   3. Dispatch strict IPv4 lookups via oo_dns_resolve_ipv4 under NetCap.
//   4. Format diagnostic query descriptors for standard DNS lookups.
// RULES.oot 1.4: Default-deny for network effects. Explicit &NetCap required.
// RULES.oot 1.7: Under 256 lines.

type DnsClientConfig = struct {
    server_ip: String,
    server_port: Int,
    timeout_ms: Int
};

pub fn dns_client_new(server_ip: String) -> DnsClientConfig {
    return DnsClientConfig {
        server_ip: server_ip,
        server_port: 53,
        timeout_ms: 5000
    };
}

pub fn dns_client_default() -> DnsClientConfig {
    return dns_client_new("8.8.8.8");
}

pub fn dns_client_with_port(cfg: DnsClientConfig, port: Int) -> DnsClientConfig {
    let sip: String = cfg.server_ip;
    let t: Int = cfg.timeout_ms;
    return DnsClientConfig {
        server_ip: sip,
        server_port: port,
        timeout_ms: t
    };
}

pub fn dns_client_with_timeout(cfg: DnsClientConfig, timeout_ms: Int) -> DnsClientConfig {
    let sip: String = cfg.server_ip;
    let p: Int = cfg.server_port;
    return DnsClientConfig {
        server_ip: sip,
        server_port: p,
        timeout_ms: timeout_ms
    };
}

pub fn dns_client_resolve(net: &NetCap, host: String) -> Result[String, String] {
    if chars_len(host) == 0 {
        return Err("DNS_CLIENT_ERR: empty hostname");
    }
    return oo_dns_resolve(net, host);
}

pub fn dns_client_resolve_ipv4(net: &NetCap, host: String) -> Result[String, String] {
    if chars_len(host) == 0 {
        return Err("DNS_CLIENT_ERR: empty hostname");
    }
    return oo_dns_resolve_ipv4(net, host);
}

pub fn dns_client_format_query(domain: String, qtype: Int) -> String {
    let mut qt_name: String = "A";
    if qtype == 28 {
        qt_name = "AAAA";
    }
    if qtype == 15 {
        qt_name = "MX";
    }
    if qtype == 16 {
        qt_name = "TXT";
    }
    if qtype == 5 {
        qt_name = "CNAME";
    }
    return "[DNS Query: name=" + domain + " type=" + qt_name + "]";
}
