// # HTTP/2 Stream State Machine and Flow Control Module
//
// Logline: Stream lifecycle states, credit-based flow control, and concurrency limits for HTTP/2 multiplexing (RFC 7540).
//
// Setup: Pure stream state model managing transitions (idle -> open -> half-closed -> closed) and window updates.
//
// Beats:
//   1. Define Http2Stream struct with ID, state, window credits, priority weight, and closed indicator.
//   2. Transition stream states across local/remote header and end-stream boundaries.
//   3. Manage flow control window consumption and credit updates.
//   4. Validate whether stream is eligible for transmission or reception.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type Http2Stream = struct {
    stream_id: Int,
    state: String,
    window_size: Int,
    remote_window_size: Int,
    weight: Int,
    is_closed: Bool
};

pub fn http2_stream_new(stream_id: Int) -> Http2Stream {
    return Http2Stream {
        stream_id: stream_id,
        state: "idle",
        window_size: 65535,
        remote_window_size: 65535,
        weight: 16,
        is_closed: false
    };
}

pub fn http2_stream_open(stream: Http2Stream) -> Http2Stream {
    let sid: Int = stream.stream_id;
    let ws: Int = stream.window_size;
    let rws: Int = stream.remote_window_size;
    let wt: Int = stream.weight;
    return Http2Stream {
        stream_id: sid,
        state: "open",
        window_size: ws,
        remote_window_size: rws,
        weight: wt,
        is_closed: false
    };
}

pub fn http2_stream_half_close_local(stream: Http2Stream) -> Http2Stream {
    let sid: Int = stream.stream_id;
    let ws: Int = stream.window_size;
    let rws: Int = stream.remote_window_size;
    let wt: Int = stream.weight;
    let st: String = stream.state;
    let mut next_st: String = "half_closed_local";
    let mut closed: Bool = false;
    if st == "half_closed_remote" {
        next_st = "closed";
        closed = true;
    }
    return Http2Stream {
        stream_id: sid,
        state: next_st,
        window_size: ws,
        remote_window_size: rws,
        weight: wt,
        is_closed: closed
    };
}

pub fn http2_stream_half_close_remote(stream: Http2Stream) -> Http2Stream {
    let sid: Int = stream.stream_id;
    let ws: Int = stream.window_size;
    let rws: Int = stream.remote_window_size;
    let wt: Int = stream.weight;
    let st: String = stream.state;
    let mut next_st: String = "half_closed_remote";
    let mut closed: Bool = false;
    if st == "half_closed_local" {
        next_st = "closed";
        closed = true;
    }
    return Http2Stream {
        stream_id: sid,
        state: next_st,
        window_size: ws,
        remote_window_size: rws,
        weight: wt,
        is_closed: closed
    };
}

pub fn http2_stream_close(stream: Http2Stream) -> Http2Stream {
    let sid: Int = stream.stream_id;
    let ws: Int = stream.window_size;
    let rws: Int = stream.remote_window_size;
    let wt: Int = stream.weight;
    return Http2Stream {
        stream_id: sid,
        state: "closed",
        window_size: ws,
        remote_window_size: rws,
        weight: wt,
        is_closed: true
    };
}

pub fn http2_stream_can_send(stream: Http2Stream) -> Bool {
    let st: String = stream.state;
    return st == "open" || st == "half_closed_remote";
}

pub fn http2_stream_can_recv(stream: Http2Stream) -> Bool {
    let st: String = stream.state;
    return st == "open" || st == "half_closed_local";
}

pub fn http2_stream_consume_window(stream: Http2Stream, bytes_count: Int) -> Result[Http2Stream, String] {
    let sid: Int = stream.stream_id;
    let st: String = stream.state;
    let ws: Int = stream.window_size;
    let rws: Int = stream.remote_window_size;
    let wt: Int = stream.weight;
    let cl: Bool = stream.is_closed;
    if rws < bytes_count {
        return Err("HTTP2_STREAM_ERR: flow control window overflow");
    }
    let next_rws: Int = rws - bytes_count;
    let updated: Http2Stream = Http2Stream {
        stream_id: sid,
        state: st,
        window_size: ws,
        remote_window_size: next_rws,
        weight: wt,
        is_closed: cl
    };
    return Ok(updated);
}

pub fn http2_stream_update_window(stream: Http2Stream, increment: Int) -> Http2Stream {
    let sid: Int = stream.stream_id;
    let st: String = stream.state;
    let ws: Int = stream.window_size;
    let rws: Int = stream.remote_window_size;
    let wt: Int = stream.weight;
    let cl: Bool = stream.is_closed;
    let next_rws: Int = rws + increment;
    return Http2Stream {
        stream_id: sid,
        state: st,
        window_size: ws,
        remote_window_size: next_rws,
        weight: wt,
        is_closed: cl
    };
}

pub fn http2_stream_format(stream: Http2Stream) -> String {
    let sid: Int = stream.stream_id;
    let sid_str: String = sid.to_string();
    let st: String = stream.state;
    let rws: Int = stream.remote_window_size;
    let rws_str: String = rws.to_string();
    return "[HTTP2 Stream #" + sid_str + " state=" + st + " window=" + rws_str + "]";
}
