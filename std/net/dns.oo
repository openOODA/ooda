// # DNS hostname resolution module under NetCap
//
// Logline: Resolve hostnames to IPv4/IPv6 addresses under explicit NetCap capability.
//
// Setup: Callers pass &NetCap. Privileged DNS lookup requires capability nonce.
//
// Beats:
//   1. Resolve hostname to IPv4 or IPv6 address.
//   2. Resolve hostname strictly to IPv4 address.
//   3. Validate IP formatting and handle localhost aliases.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &NetCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

pub fn dns_resolve(net: &NetCap, host: String) -> Result[String, String] {
    if host.len() == 0 {
        return Err("DNS_ERR: empty host name");
    }
    return oo_dns_resolve(net, host);
}

pub fn dns_resolve_ipv4(net: &NetCap, host: String) -> Result[String, String] {
    if host.len() == 0 {
        return Err("DNS_ERR: empty host name");
    }
    return oo_dns_resolve_ipv4(net, host);
}

pub fn dns_probe() -> Int {
    return 0;
}
