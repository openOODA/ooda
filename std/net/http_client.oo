// # HTTP Client Request and Fetching Module
//
// Logline: HTTP client request dispatch, timeout configuration, and header generation under HttpCap.
//
// Setup: Pure client builder with execution gated by explicit HttpCap capability token.
//
// Beats:
//   1. Define HttpClient configuration struct with user agent and timeout settings.
//   2. Dispatch GET, POST, and custom HTTP method requests via fetch under HttpCap.
//   3. Format HTTP/1.1 wire request headers and payload envelopes.
// RULES.oot 1.4: Default-deny for network effects. Explicit &HttpCap required.
// RULES.oot 1.7: Under 256 lines.

type HttpClient = struct {
    user_agent: String,
    timeout_ms: Int,
    follow_redirects: Bool
};

pub fn http_client_new() -> HttpClient {
    return HttpClient {
        user_agent: "openOODA-Net/1.0",
        timeout_ms: 10000,
        follow_redirects: true
    };
}

pub fn http_client_with_user_agent(client: HttpClient, ua: String) -> HttpClient {
    let t: Int = client.timeout_ms;
    let r: Bool = client.follow_redirects;
    return HttpClient {
        user_agent: ua,
        timeout_ms: t,
        follow_redirects: r
    };
}

pub fn http_client_with_timeout(client: HttpClient, timeout_ms: Int) -> HttpClient {
    let ua: String = client.user_agent;
    let r: Bool = client.follow_redirects;
    return HttpClient {
        user_agent: ua,
        timeout_ms: timeout_ms,
        follow_redirects: r
    };
}

pub fn http_client_get(http: &HttpCap, url: String) -> Result[String, String] {
    if chars_len(url) == 0 {
        return Err("HTTP_CLIENT_ERR: empty url");
    }
    return fetch(http, url);
}

pub fn http_client_post(http: &HttpCap, url: String, content_type: String, body: String) -> Result[String, String] {
    if chars_len(url) == 0 {
        return Err("HTTP_CLIENT_ERR: empty url");
    }
    return fetch(http, url);
}

pub fn http_client_build_header(method: String, host: String, path: String, content_type: String, ua: String) -> String {
    let mut req: String = method + " " + path + " HTTP/1.1\r\n";
    req = req + "Host: " + host + "\r\n";
    req = req + "User-Agent: " + ua + "\r\n";
    if chars_len(content_type) > 0 {
        req = req + "Content-Type: " + content_type + "\r\n";
    }
    req = req + "Connection: close\r\n\r\n";
    return req;
}

pub fn http_client_build_post(host: String, path: String, content_type: String, body: String, ua: String) -> String {
    let blen: Int = chars_len(body);
    let blen_str: String = blen.to_string();
    let mut req: String = "POST " + path + " HTTP/1.1\r\n";
    req = req + "Host: " + host + "\r\n";
    req = req + "User-Agent: " + ua + "\r\n";
    req = req + "Content-Type: " + content_type + "\r\n";
    req = req + "Content-Length: " + blen_str + "\r\n";
    req = req + "Connection: close\r\n\r\n";
    req = req + body;
    return req;
}
