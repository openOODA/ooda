// # Network Error Definition and Classification Module
//
// Logline: Structured error codes, categories, transient flags, and diagnostic representations for network operations.
//
// Setup: Pure error module classifying socket, protocol, DNS, TLS, and HTTP failures.
//
// Beats:
//   1. Define NetError struct with code, category, message, and retryability.
//   2. Provide constructors for common network error categories (Timeout, Refused, DNS, TLS, Protocol).
//   3. Classify retryability and format structured diagnostic error strings.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type NetError = struct {
    code: Int,
    category: String,
    message: String,
    is_transient: Bool
};

pub fn net_err_new(code: Int, category: String, message: String, is_transient: Bool) -> NetError {
    return NetError {
        code: code,
        category: category,
        message: message,
        is_transient: is_transient
    };
}

pub fn net_err_timeout(msg: String) -> NetError {
    return NetError {
        code: 1001,
        category: "TIMEOUT",
        message: msg,
        is_transient: true
    };
}

pub fn net_err_connection_refused(msg: String) -> NetError {
    return NetError {
        code: 1002,
        category: "CONNECTION_REFUSED",
        message: msg,
        is_transient: false
    };
}

pub fn net_err_host_not_found(msg: String) -> NetError {
    return NetError {
        code: 1003,
        category: "HOST_NOT_FOUND",
        message: msg,
        is_transient: false
    };
}

pub fn net_err_tls_failure(msg: String) -> NetError {
    return NetError {
        code: 1004,
        category: "TLS_ERROR",
        message: msg,
        is_transient: false
    };
}

pub fn net_err_protocol_error(msg: String) -> NetError {
    return NetError {
        code: 1005,
        category: "PROTOCOL_ERROR",
        message: msg,
        is_transient: false
    };
}

pub fn net_err_cap_denied(msg: String) -> NetError {
    return NetError {
        code: 1006,
        category: "CAPABILITY_DENIED",
        message: msg,
        is_transient: false
    };
}

pub fn net_err_eof(msg: String) -> NetError {
    return NetError {
        code: 1007,
        category: "EOF",
        message: msg,
        is_transient: false
    };
}

pub fn net_err_is_retryable(err: NetError) -> Bool {
    return err.is_transient;
}

pub fn net_err_format(err: NetError) -> String {
    let c: Int = err.code;
    let c_str: String = c.to_string();
    let cat: String = err.category;
    let msg: String = err.message;
    let mut out: String = "[" + cat + ":" + c_str + "] " + msg;
    let transient: Bool = err.is_transient;
    if transient {
        out = out + " (transient/retryable)";
    }
    return out;
}
