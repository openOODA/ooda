// # CIDR Subnet and IP Range Calculation Module
//
// Logline: IPv4 CIDR prefix representations, subnet masking, host counting, and containment testing.
//
// Setup: Pure network subnet module calculating prefix masks and address ranges.
//
// Beats:
//   1. Define Ipv4Cidr struct with network octets, prefix length, and validity flag.
//   2. Calculate available host counts from prefix lengths (0..32).
//   3. Implement IP containment check within CIDR subnets using integer bit masking.
//   4. Parse CIDR notation (e.g. 192.168.1.0/24) and format to string.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type Ipv4Cidr = struct {
    a: Int,
    b: Int,
    c: Int,
    d: Int,
    prefix: Int,
    is_valid: Bool
};

pub fn cidr_new(a: Int, b: Int, c: Int, d: Int, prefix: Int) -> Ipv4Cidr {
    let mut valid: Bool = true;
    if a < 0 || a > 255 || b < 0 || b > 255 || c < 0 || c > 255 || d < 0 || d > 255 {
        valid = false;
    }
    if prefix < 0 || prefix > 32 {
        valid = false;
    }
    return Ipv4Cidr {
        a: a,
        b: b,
        c: c,
        d: d,
        prefix: prefix,
        is_valid: valid
    };
}

pub fn cidr_to_string(cidr: Ipv4Cidr) -> String {
    let a: Int = cidr.a;
    let b: Int = cidr.b;
    let c: Int = cidr.c;
    let d: Int = cidr.d;
    let p: Int = cidr.prefix;
    let sa: String = a.to_string();
    let sb: String = b.to_string();
    let sc: String = c.to_string();
    let sd: String = d.to_string();
    let sp: String = p.to_string();
    return sa + "." + sb + "." + sc + "." + sd + "/" + sp;
}

pub fn cidr_host_count(cidr: Ipv4Cidr) -> Int {
    let p: Int = cidr.prefix;
    if p >= 32 {
        return 1;
    }
    if p == 31 {
        return 2;
    }
    let host_bits: Int = 32 - p;
    let mut count: Int = 1;
    let mut i: Int = 0;
    while i < host_bits {
        count = count * 2;
        i = i + 1;
    }
    return count - 2;
}

fn cidr_to_u32(a: Int, b: Int, c: Int, d: Int) -> Int {
    return (a * 16777216) + (b * 65536) + (c * 256) + d;
}

pub fn cidr_contains(cidr: Ipv4Cidr, ip_a: Int, ip_b: Int, ip_c: Int, ip_d: Int) -> Bool {
    let ca: Int = cidr.a;
    let cb: Int = cidr.b;
    let cc: Int = cidr.c;
    let cd: Int = cidr.d;
    let p: Int = cidr.prefix;
    let net_val: Int = cidr_to_u32(ca, cb, cc, cd);
    let ip_val: Int = cidr_to_u32(ip_a, ip_b, ip_c, ip_d);
    let host_bits: Int = 32 - p;
    let mut divisor: Int = 1;
    let mut i: Int = 0;
    while i < host_bits {
        divisor = divisor * 2;
        i = i + 1;
    }
    let net_prefix: Int = net_val / divisor;
    let ip_prefix: Int = ip_val / divisor;
    return net_prefix == ip_prefix;
}

fn cidr_parse_digits(s: String) -> Int {
    let mut acc: Int = 0;
    let mut i: Int = 0;
    let n: Int = chars_len(s);
    if n == 0 { return -1; }
    while i < n {
        let c: String = char_at(s, i);
        let mut d: Int = -1;
        if c == "0" { d = 0; }
        if c == "1" { d = 1; }
        if c == "2" { d = 2; }
        if c == "3" { d = 3; }
        if c == "4" { d = 4; }
        if c == "5" { d = 5; }
        if c == "6" { d = 6; }
        if c == "7" { d = 7; }
        if c == "8" { d = 8; }
        if c == "9" { d = 9; }
        if d < 0 { return -1; }
        acc = acc * 10 + d;
        i = i + 1;
    }
    return acc;
}

pub fn cidr_invalid() -> Ipv4Cidr {
    return Ipv4Cidr {
        a: 0,
        b: 0,
        c: 0,
        d: 0,
        prefix: 0,
        is_valid: false
    };
}

pub fn cidr_parse(s: String) -> Ipv4Cidr {
    let slash: Int = str_index_of(s, "/");
    if slash <= 0 { return cidr_invalid(); }
    let n: Int = chars_len(s);
    let ip_part: String = str_slice(s, 0, slash);
    let prefix_part: String = str_slice(s, slash + 1, n);
    let prefix: Int = cidr_parse_digits(prefix_part);
    if prefix < 0 || prefix > 32 { return cidr_invalid(); }
    let d1: Int = str_index_of(ip_part, ".");
    if d1 <= 0 { return cidr_invalid(); }
    let ip_len: Int = chars_len(ip_part);
    let s1: String = str_slice(ip_part, 0, d1);
    let rem1: String = str_slice(ip_part, d1 + 1, ip_len);
    let d2: Int = str_index_of(rem1, ".");
    if d2 <= 0 { return cidr_invalid(); }
    let r1_len: Int = chars_len(rem1);
    let s2: String = str_slice(rem1, 0, d2);
    let rem2: String = str_slice(rem1, d2 + 1, r1_len);
    let d3: Int = str_index_of(rem2, ".");
    if d3 <= 0 { return cidr_invalid(); }
    let r2_len: Int = chars_len(rem2);
    let s3: String = str_slice(rem2, 0, d3);
    let s4: String = str_slice(rem2, d3 + 1, r2_len);
    let a: Int = cidr_parse_digits(s1);
    let b: Int = cidr_parse_digits(s2);
    let c: Int = cidr_parse_digits(s3);
    let d: Int = cidr_parse_digits(s4);
    if a < 0 || a > 255 || b < 0 || b > 255 || c < 0 || c > 255 || d < 0 || d > 255 {
        return cidr_invalid();
    }
    return cidr_new(a, b, c, d, prefix);
}
