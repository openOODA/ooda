// # IP Address Representation and Classification Module
//
// Logline: IPv4 and IPv6 address types, parsing, dotted-decimal formatting, integer conversion, and scope classification.
//
// Setup: Pure IP address module supporting loopback, private RFC 1918, and multicast range checks.
//
// Beats:
//   1. Define Ipv4Addr and Ipv6Addr structures.
//   2. Parse dotted-decimal strings into Ipv4Addr and convert between 32-bit integer representations.
//   3. Implement loopback (127.0.0.0/8, ::1), private (10/8, 172.16/12, 192.168/16), and multicast classification.
//   4. Format canonical string representations for IPv4 and IPv6.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type Ipv4Addr = struct {
    a: Int,
    b: Int,
    c: Int,
    d: Int,
    is_valid: Bool
};

type Ipv6Addr = struct {
    hex_addr: String,
    is_valid: Bool
};

pub fn ipv4_new(a: Int, b: Int, c: Int, d: Int) -> Ipv4Addr {
    let mut valid: Bool = true;
    if a < 0 || a > 255 || b < 0 || b > 255 || c < 0 || c > 255 || d < 0 || d > 255 {
        valid = false;
    }
    return Ipv4Addr {
        a: a,
        b: b,
        c: c,
        d: d,
        is_valid: valid
    };
}

pub fn ipv4_to_string(ip: Ipv4Addr) -> String {
    let a: Int = ip.a;
    let b: Int = ip.b;
    let c: Int = ip.c;
    let d: Int = ip.d;
    let sa: String = a.to_string();
    let sb: String = b.to_string();
    let sc: String = c.to_string();
    let sd: String = d.to_string();
    return sa + "." + sb + "." + sc + "." + sd;
}

pub fn ipv4_to_int(ip: Ipv4Addr) -> Int {
    let a: Int = ip.a;
    let b: Int = ip.b;
    let c: Int = ip.c;
    let d: Int = ip.d;
    return (a * 16777216) + (b * 65536) + (c * 256) + d;
}

pub fn ipv4_from_int(val: Int) -> Ipv4Addr {
    let a: Int = (val / 16777216) % 256;
    let b: Int = (val / 65536) % 256;
    let c: Int = (val / 256) % 256;
    let d: Int = val % 256;
    return ipv4_new(a, b, c, d);
}

pub fn ipv4_is_loopback(ip: Ipv4Addr) -> Bool {
    let a: Int = ip.a;
    return a == 127;
}

pub fn ipv4_is_private(ip: Ipv4Addr) -> Bool {
    let a: Int = ip.a;
    let b: Int = ip.b;
    if a == 10 {
        return true;
    }
    if a == 172 && b >= 16 && b <= 31 {
        return true;
    }
    if a == 192 && b == 168 {
        return true;
    }
    return false;
}

pub fn ipv4_is_multicast(ip: Ipv4Addr) -> Bool {
    let a: Int = ip.a;
    return a >= 224 && a <= 239;
}

fn parse_octet_digits(s: String) -> Int {
    let mut acc: Int = 0;
    let mut i: Int = 0;
    let n: Int = chars_len(s);
    if n == 0 { return -1; }
    while i < n {
        let c: String = char_at(s, i);
        let mut d: Int = -1;
        if c == "0" { d = 0; }
        if c == "1" { d = 1; }
        if c == "2" { d = 2; }
        if c == "3" { d = 3; }
        if c == "4" { d = 4; }
        if c == "5" { d = 5; }
        if c == "6" { d = 6; }
        if c == "7" { d = 7; }
        if c == "8" { d = 8; }
        if c == "9" { d = 9; }
        if d < 0 { return -1; }
        acc = acc * 10 + d;
        i = i + 1;
    }
    return acc;
}

pub fn ipv4_invalid() -> Ipv4Addr {
    return Ipv4Addr {
        a: 0,
        b: 0,
        c: 0,
        d: 0,
        is_valid: false
    };
}

pub fn ipv4_parse(s: String) -> Ipv4Addr {
    let d1: Int = str_index_of(s, ".");
    if d1 <= 0 { return ipv4_invalid(); }
    let n: Int = chars_len(s);
    let s1: String = str_slice(s, 0, d1);
    let rem1: String = str_slice(s, d1 + 1, n);
    let d2: Int = str_index_of(rem1, ".");
    if d2 <= 0 { return ipv4_invalid(); }
    let r1_len: Int = chars_len(rem1);
    let s2: String = str_slice(rem1, 0, d2);
    let rem2: String = str_slice(rem1, d2 + 1, r1_len);
    let d3: Int = str_index_of(rem2, ".");
    if d3 <= 0 { return ipv4_invalid(); }
    let r2_len: Int = chars_len(rem2);
    let s3: String = str_slice(rem2, 0, d3);
    let s4: String = str_slice(rem2, d3 + 1, r2_len);
    let a: Int = parse_octet_digits(s1);
    let b: Int = parse_octet_digits(s2);
    let c: Int = parse_octet_digits(s3);
    let d: Int = parse_octet_digits(s4);
    if a < 0 || a > 255 || b < 0 || b > 255 || c < 0 || c > 255 || d < 0 || d > 255 {
        return ipv4_invalid();
    }
    return ipv4_new(a, b, c, d);
}

pub fn ipv6_new(hex_addr: String) -> Ipv6Addr {
    return Ipv6Addr {
        hex_addr: hex_addr,
        is_valid: chars_len(hex_addr) > 0
    };
}

pub fn ipv6_is_loopback(ip: Ipv6Addr) -> Bool {
    let h: String = ip.hex_addr;
    return h == "::1" || h == "0000:0000:0000:0000:0000:0000:0000:0001";
}
