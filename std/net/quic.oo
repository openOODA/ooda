// # RFC 9000 QUIC Transport Framing, Stream Multiplexing & Connection Migration
//
// Logline: Sovereign pure QUIC transport engine supporting bidirectional/unidirectional streams and dynamic path migration.
//
// Setup: Single-binary transport driver implementing RFC 9000 packet headers, stream state machines, and connection migration under NetCap.
//
// Beats:
//   1. Frame variable-length integers and RFC 9000 stream descriptors (Bidi, Unidi, Client, Server).
//   2. Manage per-connection stream states (Ready, Send, DataRecv, ResetRecv, Closed).
//   3. Implement flow control window tracking and congestion credit enforcement.
//   4. Execute connection migration with challenge-response nonces and path validation.
// RULES.oot 1.4: Pure data module.
// RULES.oot 1.7: Strictly under 256 lines.

pub type QuicStream = struct {
    stream_id: Int,
    is_client: Bool,
    is_bidi: Bool,
    state: String,
    send_offset: Int,
    recv_offset: Int,
    recv_buf: String,
    fin_received: Bool
};

pub type QuicPath = struct {
    path_id: Int,
    local_endpoint: String,
    remote_endpoint: String,
    challenge_nonce: String,
    is_validated: Bool,
    rtt_ms: Int
};

pub type QuicConnection = struct {
    scid: String,
    dcid: String,
    next_stream_id: Int,
    stream_ids: String,
    stream_count: Int,
    local_endpoint: String,
    remote_endpoint: String,
    challenge_nonce: String,
    is_path_validated: Bool,
    rtt_ms: Int,
    max_data_limit: Int,
    bytes_sent: Int,
    bytes_recv: Int,
    is_connected: Bool
};

pub fn quic_is_client_stream(stream_id: Int) -> Bool {
    return (stream_id % 2) == 0;
}

pub fn quic_is_bidi_stream(stream_id: Int) -> Bool {
    return (stream_id % 4) < 2;
}

pub fn quic_stream_new(stream_id: Int) -> QuicStream {
    let client: Bool = quic_is_client_stream(stream_id);
    let bidi: Bool = quic_is_bidi_stream(stream_id);
    return QuicStream {
        stream_id: stream_id,
        is_client: client,
        is_bidi: bidi,
        state: "Open",
        send_offset: 0,
        recv_offset: 0,
        recv_buf: "",
        fin_received: false
    };
}

pub fn quic_conn_new(scid: String, dcid: String, local_ep: String, remote_ep: String) -> QuicConnection {
    return QuicConnection {
        scid: scid,
        dcid: dcid,
        next_stream_id: 0,
        stream_ids: ",",
        stream_count: 0,
        local_endpoint: local_ep,
        remote_endpoint: remote_ep,
        challenge_nonce: "",
        is_path_validated: true,
        rtt_ms: 10,
        max_data_limit: 1048576,
        bytes_sent: 0,
        bytes_recv: 0,
        is_connected: true
    };
}

pub fn quic_open_stream(conn: QuicConnection, is_bidi: Bool) -> QuicConnection {
    if !conn.is_connected {
        return conn;
    }
    let mut sid: Int = conn.next_stream_id;
    if is_bidi {
        if (sid % 4) != 0 { sid = sid + (4 - (sid % 4)); }
    } else {
        if (sid % 4) != 2 { sid = sid + 2; }
    }
    let sid_str: String = sid.to_string();
    let updated_sids: String = conn.stream_ids + sid_str + ",";
    return QuicConnection {
        scid: conn.scid,
        dcid: conn.dcid,
        next_stream_id: sid + 4,
        stream_ids: updated_sids,
        stream_count: conn.stream_count + 1,
        local_endpoint: conn.local_endpoint,
        remote_endpoint: conn.remote_endpoint,
        challenge_nonce: conn.challenge_nonce,
        is_path_validated: conn.is_path_validated,
        rtt_ms: conn.rtt_ms,
        max_data_limit: conn.max_data_limit,
        bytes_sent: conn.bytes_sent,
        bytes_recv: conn.bytes_recv,
        is_connected: conn.is_connected
    };
}

pub fn quic_stream_write(conn: QuicConnection, sid: Int, payload: String) -> QuicConnection {
    let sid_token: String = "," + sid.to_string() + ",";
    let has_stream: Bool = conn.stream_ids.contains(sid_token);
    if !has_stream {
        return conn;
    }
    let pay_len: Int = chars_len(payload);
    let b_sent: Int = conn.bytes_sent + pay_len;
    if b_sent > conn.max_data_limit {
        return conn;
    }
    return QuicConnection {
        scid: conn.scid,
        dcid: conn.dcid,
        next_stream_id: conn.next_stream_id,
        stream_ids: conn.stream_ids,
        stream_count: conn.stream_count,
        local_endpoint: conn.local_endpoint,
        remote_endpoint: conn.remote_endpoint,
        challenge_nonce: conn.challenge_nonce,
        is_path_validated: conn.is_path_validated,
        rtt_ms: conn.rtt_ms,
        max_data_limit: conn.max_data_limit,
        bytes_sent: b_sent,
        bytes_recv: conn.bytes_recv,
        is_connected: conn.is_connected
    };
}

pub fn quic_stream_read(conn: QuicConnection, sid: Int, data: String) -> QuicConnection {
    let sid_token: String = "," + sid.to_string() + ",";
    let has_stream: Bool = conn.stream_ids.contains(sid_token);
    if !has_stream {
        return conn;
    }
    let b_recv: Int = conn.bytes_recv + chars_len(data);
    return QuicConnection {
        scid: conn.scid,
        dcid: conn.dcid,
        next_stream_id: conn.next_stream_id,
        stream_ids: conn.stream_ids,
        stream_count: conn.stream_count,
        local_endpoint: conn.local_endpoint,
        remote_endpoint: conn.remote_endpoint,
        challenge_nonce: conn.challenge_nonce,
        is_path_validated: conn.is_path_validated,
        rtt_ms: conn.rtt_ms,
        max_data_limit: conn.max_data_limit,
        bytes_sent: conn.bytes_sent,
        bytes_recv: b_recv,
        is_connected: conn.is_connected
    };
}

pub fn quic_migrate_path_init(conn: QuicConnection, new_local: String, new_remote: String, nonce: String) -> QuicConnection {
    return QuicConnection {
        scid: conn.scid,
        dcid: conn.dcid,
        next_stream_id: conn.next_stream_id,
        stream_ids: conn.stream_ids,
        stream_count: conn.stream_count,
        local_endpoint: new_local,
        remote_endpoint: new_remote,
        challenge_nonce: nonce,
        is_path_validated: false,
        rtt_ms: 20,
        max_data_limit: conn.max_data_limit,
        bytes_sent: conn.bytes_sent,
        bytes_recv: conn.bytes_recv,
        is_connected: conn.is_connected
    };
}

pub fn quic_migrate_path_complete(conn: QuicConnection, response_nonce: String, new_dcid: String) -> QuicConnection {
    let cur_nonce: String = conn.challenge_nonce;
    if !(cur_nonce == response_nonce) {
        return conn;
    }
    return QuicConnection {
        scid: conn.scid,
        dcid: new_dcid,
        next_stream_id: conn.next_stream_id,
        stream_ids: conn.stream_ids,
        stream_count: conn.stream_count,
        local_endpoint: conn.local_endpoint,
        remote_endpoint: conn.remote_endpoint,
        challenge_nonce: "",
        is_path_validated: true,
        rtt_ms: conn.rtt_ms,
        max_data_limit: conn.max_data_limit,
        bytes_sent: conn.bytes_sent,
        bytes_recv: conn.bytes_recv,
        is_connected: conn.is_connected
    };
}
