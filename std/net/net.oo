// # Standard Network Protocol Suite and Re-Export Facade
//
// Logline: Unified catalog, registry, and capability wrappers for all 24 openOODA networking modules.
//
// Setup: Bridges granular network capability tokens (HttpCap, TcpCap, BindCap, UdpCap, NetCap) with modular networking APIs.
//
// Beats:
//   1. Provide module availability queries and catalog count for the standard networking suite.
//   2. Re-export core capability-gated network operations (HTTP, TCP, UDP, TLS, DNS).
//   3. Dispatch raw socket access under root NetCap.
// RULES.oot 1.4: Default-deny for network effects. Explicit capability token required.
// RULES.oot 1.7: Under 256 lines.

// Return total count of modular networking components (29).
pub fn net_modules_count() -> Int {
    return 29;
}

// Query whether a specific networking module is part of the standard library.
pub fn net_is_module_available(name: String) -> Bool {
    if name == "http_client" || name == "http_server" || name == "http_request" || name == "http_response" { return true; }
    if name == "http2_frame" || name == "http2_stream" || name == "http3_frame" || name == "quic_packet" { return true; }
    if name == "websocket" || name == "websocket_frame" || name == "dns_client" || name == "dns_packet" { return true; }
    if name == "url" || name == "mime" || name == "cookies" || name == "headers" { return true; }
    if name == "tls_session" || name == "tls_record" || name == "ip_addr" || name == "cidr" { return true; }
    if name == "socket_opts" || name == "tcp_conn" || name == "udp_conn" || name == "net_error" || name == "net" { return true; }
    if name == "quic" || name == "swarm_peer" || name == "swarm_proto" || name == "swarm" { return true; }
    return false;
}

// HTTP request dispatch under HttpCap.
pub fn net_http_get(http: &HttpCap, url: String) -> Result[String, String] {
    if chars_len(url) == 0 {
        return Err("NET_ERR: empty url");
    }
    return fetch(http, url);
}

pub fn net_http_post(http: &HttpCap, url: String) -> Result[String, String] {
    if chars_len(url) == 0 {
        return Err("NET_ERR: empty url");
    }
    return fetch(http, url);
}

// TCP connection under TcpCap.
pub fn net_tcp_connect(tcp: &TcpCap, host: String, port: Int) -> Result[String, String] {
    if chars_len(host) == 0 {
        return Err("NET_ERR: empty host name");
    }
    return tcp_connect(tcp, host, port);
}

// TCP socket binding under BindCap.
pub fn net_tcp_bind(bind: &BindCap, port: Int) -> Result[String, String] {
    return tcp_bind(bind, port);
}

// UDP port binding under UdpCap.
pub fn net_udp_bind(udp: &UdpCap, port: Int) -> Result[String, String] {
    return bind_udp(udp, port);
}

// TLS connection under TcpCap.
pub fn net_tls_connect(tcp: &TcpCap, host: String, port: Int) -> Result[String, String] {
    if chars_len(host) == 0 {
        return Err("NET_ERR: empty host name");
    }
    return tls_connect(tcp, host, port);
}

// DNS hostname resolution under NetCap.
pub fn net_dns_resolve(net: &NetCap, host: String) -> Result[String, String] {
    if chars_len(host) == 0 {
        return Err("NET_ERR: empty host name");
    }
    return oo_dns_resolve(net, host);
}

// Raw socket fallback under root NetCap.
pub fn net_sock_raw(net: &NetCap, proto: Int) -> Result[String, String] {
    return sock_raw(net, proto);
}
