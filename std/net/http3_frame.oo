// # HTTP/3 Frame Representation and Typing Module
//
// Logline: HTTP/3 frame definitions, QPACK payload encapsulation, and stream frame dispatch (RFC 9114).
//
// Setup: Pure frame abstractions for QUIC-based HTTP/3 transport.
//
// Beats:
//   1. Define Http3Frame struct with frame type, length, and binary payload.
//   2. Provide constructors for HTTP/3 frame types (DATA, HEADERS, SETTINGS, GOAWAY).
//   3. Implement frame type naming and diagnostic formatting for HTTP/3 telemetry.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type Http3Frame = struct {
    frame_type: Int,
    length: Int,
    payload: String
};

pub fn http3_frame_new(frame_type: Int, payload: String) -> Http3Frame {
    let len: Int = chars_len(payload);
    return Http3Frame {
        frame_type: frame_type,
        length: len,
        payload: payload
    };
}

pub fn http3_frame_type_name(frame_type: Int) -> String {
    if frame_type == 0 { return "DATA"; }
    if frame_type == 1 { return "HEADERS"; }
    if frame_type == 3 { return "CANCEL_PUSH"; }
    if frame_type == 4 { return "SETTINGS"; }
    if frame_type == 5 { return "PUSH_PROMISE"; }
    if frame_type == 7 { return "GOAWAY"; }
    if frame_type == 13 { return "MAX_PUSH_ID"; }
    return "UNKNOWN";
}

pub fn http3_frame_data(payload: String) -> Http3Frame {
    return http3_frame_new(0, payload);
}

pub fn http3_frame_headers(encoded_headers: String) -> Http3Frame {
    return http3_frame_new(1, encoded_headers);
}

pub fn http3_frame_cancel_push(push_id: Int) -> Http3Frame {
    let p_str: String = push_id.to_string();
    return http3_frame_new(3, p_str);
}

pub fn http3_frame_settings(payload: String) -> Http3Frame {
    return http3_frame_new(4, payload);
}

pub fn http3_frame_goaway(stream_id: Int) -> Http3Frame {
    let s_str: String = stream_id.to_string();
    return http3_frame_new(7, s_str);
}

pub fn http3_frame_max_push_id(push_id: Int) -> Http3Frame {
    let p_str: String = push_id.to_string();
    return http3_frame_new(13, p_str);
}

pub fn http3_frame_format(frame: Http3Frame) -> String {
    let ft: Int = frame.frame_type;
    let tname: String = http3_frame_type_name(ft);
    let len: Int = frame.length;
    let len_str: String = len.to_string();
    return "[HTTP3 Frame: type=" + tname + " len=" + len_str + "]";
}
