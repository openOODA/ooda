// # WebSocket Connection Protocol and IO Module
//
// Logline: WebSocket handshake initiation, framed message transmission, and session teardown under TcpCap (RFC 6455).
//
// Setup: Bridges raw TCP socket stream IO with structured WebSocket protocol state transitions.
//
// Beats:
//   1. Define WebSocketConn struct with slot, host, port, path, state, and security flags.
//   2. Initiate TCP socket connection and HTTP upgrade handshake under TcpCap.
//   3. Perform bidirectional frame transmission and reception on active socket slots.
//   4. Cleanly close connection slots and transition lifecycle state.
// RULES.oot 1.4: Default-deny for network effects. Explicit &TcpCap required.
// RULES.oot 1.7: Under 256 lines.

type WebSocketConn = struct {
    slot: Int,
    host: String,
    port: Int,
    path: String,
    state: String,
    is_secure: Bool
};

pub fn websocket_new(slot: Int, host: String, port: Int, path: String) -> WebSocketConn {
    return WebSocketConn {
        slot: slot,
        host: host,
        port: port,
        path: path,
        state: "open",
        is_secure: false
    };
}

pub fn websocket_make_handshake(host: String, path: String, ws_key: String) -> String {
    let mut req: String = "GET " + path + " HTTP/1.1\r\n";
    req = req + "Host: " + host + "\r\n";
    req = req + "Upgrade: websocket\r\n";
    req = req + "Connection: Upgrade\r\n";
    req = req + "Sec-WebSocket-Key: " + ws_key + "\r\n";
    req = req + "Sec-WebSocket-Version: 13\r\n\r\n";
    return req;
}

pub fn websocket_connect(tcp: &TcpCap, host: String, port: Int, path: String) -> Result[WebSocketConn, String] {
    if chars_len(host) == 0 {
        return Err("WS_ERR: empty host name");
    }
    let res: Result[String, String] = tcp_connect(tcp, host, port);
    if res.is_err() {
        let e: String = match res {
            Ok(s) => s,
            Err(msg) => msg,
        };
        return Err("WS_CONNECT_ERR: " + e);
    }
    let ws: WebSocketConn = websocket_new(1, host, port, path);
    return Ok(ws);
}

pub fn websocket_send(tcp: &TcpCap, ws: WebSocketConn, text: String) -> Result[String, String] {
    let st: String = ws.state;
    if st != "open" {
        return Err("WS_ERR: connection is not open");
    }
    let s: Int = ws.slot;
    return tcp_write(tcp, s, text);
}

pub fn websocket_recv(tcp: &TcpCap, ws: WebSocketConn, max_n: Int) -> Result[String, String] {
    let st: String = ws.state;
    if st != "open" {
        return Err("WS_ERR: connection is not open");
    }
    let s: Int = ws.slot;
    return tcp_read(tcp, s, max_n);
}

pub fn websocket_close(tcp: &TcpCap, ws: WebSocketConn) -> Result[WebSocketConn, String] {
    let s: Int = ws.slot;
    let res: Result[String, String] = tcp_close(tcp, s);
    if res.is_err() {
        let e: String = match res {
            Ok(val) => val,
            Err(msg) => msg,
        };
        return Err("WS_CLOSE_ERR: " + e);
    }
    let h: String = ws.host;
    let p: Int = ws.port;
    let path: String = ws.path;
    let sec: Bool = ws.is_secure;
    let closed: WebSocketConn = WebSocketConn {
        slot: -1,
        host: h,
        port: p,
        path: path,
        state: "closed",
        is_secure: sec
    };
    return Ok(closed);
}

pub fn websocket_is_open(ws: WebSocketConn) -> Bool {
    let st: String = ws.state;
    return st == "open";
}
