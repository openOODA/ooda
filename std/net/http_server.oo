// # HTTP Server and Route Dispatch Module
//
// Logline: HTTP server configuration, socket binding under BindCap, route matching, and wire response building.
//
// Setup: Structured server definitions with socket binding capability gated under BindCap.
//
// Beats:
//   1. Define HttpServerConfig and HttpServer structures.
//   2. Bind server listening socket to configured port under BindCap.
//   3. Perform exact route matching for incoming requests.
//   4. Format standard HTTP/1.1 wire responses with status lines, headers, and body.
// RULES.oot 1.4: Default-deny for network effects. Explicit &BindCap required.
// RULES.oot 1.7: Under 256 lines.

type HttpServerConfig = struct {
    host: String,
    port: Int,
    backlog: Int
};

type HttpServer = struct {
    config: HttpServerConfig,
    is_running: Bool
};

pub fn http_server_new(port: Int) -> HttpServer {
    let cfg: HttpServerConfig = HttpServerConfig {
        host: "0.0.0.0",
        port: port,
        backlog: 128
    };
    return HttpServer {
        config: cfg,
        is_running: false
    };
}

pub fn http_server_with_host(server: HttpServer, host: String) -> HttpServer {
    let cfg: HttpServerConfig = server.config;
    let p: Int = cfg.port;
    let b: Int = cfg.backlog;
    let new_cfg: HttpServerConfig = HttpServerConfig {
        host: host,
        port: p,
        backlog: b
    };
    let r: Bool = server.is_running;
    return HttpServer {
        config: new_cfg,
        is_running: r
    };
}

pub fn http_server_with_backlog(server: HttpServer, backlog: Int) -> HttpServer {
    let cfg: HttpServerConfig = server.config;
    let h: String = cfg.host;
    let p: Int = cfg.port;
    let new_cfg: HttpServerConfig = HttpServerConfig {
        host: h,
        port: p,
        backlog: backlog
    };
    let r: Bool = server.is_running;
    return HttpServer {
        config: new_cfg,
        is_running: r
    };
}

pub fn http_server_bind(bind: &BindCap, server: HttpServer) -> Result[String, String] {
    let cfg: HttpServerConfig = server.config;
    let p: Int = cfg.port;
    if p < 0 || p > 65535 {
        return Err("HTTP_SERVER_ERR: invalid port number");
    }
    return tcp_bind(bind, p);
}

pub fn http_server_match_route(req_method: String, req_path: String, route_method: String, route_path: String) -> Bool {
    if req_method != route_method {
        return false;
    }
    if req_path != route_path {
        return false;
    }
    return true;
}

pub fn http_server_make_response(status: Int, status_text: String, content_type: String, body: String) -> String {
    let s_str: String = status.to_string();
    let blen: Int = chars_len(body);
    let blen_str: String = blen.to_string();
    let mut resp: String = "HTTP/1.1 " + s_str + " " + status_text + "\r\n";
    resp = resp + "Content-Type: " + content_type + "\r\n";
    resp = resp + "Content-Length: " + blen_str + "\r\n";
    resp = resp + "Connection: close\r\n\r\n";
    resp = resp + body;
    return resp;
}

pub fn http_server_make_200(content_type: String, body: String) -> String {
    return http_server_make_response(200, "OK", content_type, body);
}

pub fn http_server_make_404() -> String {
    return http_server_make_response(404, "Not Found", "text/plain", "404 Not Found");
}

pub fn http_server_make_500(msg: String) -> String {
    return http_server_make_response(500, "Internal Server Error", "text/plain", msg);
}
