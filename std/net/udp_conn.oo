// # UDP Socket and Datagram IO Module
//
// Logline: UDP socket port binding, datagram reception, packet accounting, and state descriptors under UdpCap.
//
// Setup: Encapsulates connectionless UDP socket slot operations with explicit capability gating.
//
// Beats:
//   1. Define UdpSocket struct with slot, bound port, binding status, and packet counters.
//   2. Bind local UDP port under UdpCap via bind_udp.
//   3. Receive datagram payloads up to max_n bytes from bound socket slots.
//   4. Format diagnostic summaries of bound UDP sockets.
// RULES.oot 1.4: Default-deny for network effects. Explicit &UdpCap required.
// RULES.oot 1.7: Under 256 lines.

type UdpSocket = struct {
    slot: Int,
    bound_port: Int,
    is_bound: Bool,
    packets_recv: Int
};

pub fn udp_socket_bind(udp: &UdpCap, port: Int) -> Result[UdpSocket, String] {
    if port < 0 || port > 65535 {
        return Err("UDP_BIND_ERR: invalid port number");
    }
    let res: Result[String, String] = bind_udp(udp, port);
    if res.is_err() {
        let e: String = match res {
            Ok(s) => s,
            Err(msg) => msg,
        };
        return Err("UDP_BIND_ERR: " + e);
    }
    let sock: UdpSocket = UdpSocket {
        slot: 1,
        bound_port: port,
        is_bound: true,
        packets_recv: 0
    };
    return Ok(sock);
}

pub fn udp_socket_recv(udp: &UdpCap, sock: UdpSocket, max_n: Int) -> Result[String, String] {
    let bound: Bool = sock.is_bound;
    if !bound {
        return Err("UDP_RECV_ERR: socket is not bound");
    }
    let s: Int = sock.slot;
    return udp_recv(udp, s, max_n);
}

pub fn udp_socket_is_bound(sock: UdpSocket) -> Bool {
    return sock.is_bound;
}

pub fn udp_socket_info(sock: UdpSocket) -> String {
    let p: Int = sock.bound_port;
    let p_str: String = p.to_string();
    let pr: Int = sock.packets_recv;
    let pr_str: String = pr.to_string();
    let mut b_str: String = "bound";
    let bound: Bool = sock.is_bound;
    if !bound { b_str = "unbound"; }
    return "[UDP Socket: port=" + p_str + " state=" + b_str + " rx_pkts=" + pr_str + "]";
}
