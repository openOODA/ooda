// # Inverted 402 — server offers to pay the client
//
// Logline: Parse a PAYMENT-OFFERED quote. The server pays if the client delivers.
//
// Setup: Not an IETF status. Header on 200 (or any success). Pure strings.
//
// Beats:
//   1. PAYMENT-OFFERED is the header name.
//   2. Ready when payTo, amount, network, asset, and resource.url are present.
//   3. Attach is denied unless OODA_OFFER_CLAIM=1 and the claim string is not empty.
//
// residual: no settle; claiming is not collecting

import "std/net/pay_json.oo";
import "std/net/pay_pin.oo";

type PayOffer = struct {
    scheme: String,
    network: String,
    amount: String,
    pay_to: String,
    asset: String,
    resource: String,
    want: String
};

pub fn pay_offer_header_name() -> String {
    return "PAYMENT-OFFERED";
}

pub fn pay_offer_parse(body: String) -> PayOffer {
    let acc: String = pay_json_object(body, "pays");
    let mut src: String = acc;
    if src == "" {
        src = pay_json_first_accept(body);
    }
    if src == "" {
        src = body;
    }
    let mut res: String = pay_json_string(body, "url");
    if res == "" {
        res = pay_json_string(src, "resource");
    }
    let mut amt: String = pay_json_string(src, "amount");
    if amt == "" {
        amt = pay_json_string(src, "maxAmountRequired");
    }
    return PayOffer {
        scheme: pay_json_string(src, "scheme"),
        network: pay_json_string(src, "network"),
        amount: amt,
        pay_to: pay_json_string(src, "payTo"),
        asset: pay_json_string(src, "asset"),
        resource: res,
        want: pay_json_string(body, "want")
    };
}

pub fn pay_offer_ready(o: PayOffer) -> Bool {
    if o.pay_to == "" {
        return false;
    }
    if o.amount == "" {
        return false;
    }
    if o.network == "" {
        return false;
    }
    if o.asset == "" {
        return false;
    }
    if o.resource == "" {
        return false;
    }
    return true;
}

pub fn pay_offer_format(o: PayOffer) -> String {
    return "offer " + o.amount + " on " + o.network + " to " + o.pay_to + " for " + o.resource;
}

pub fn pay_offer_json(pay_to: String, amount: String, network: String, asset: String, resource: String, want: String) -> String {
    return "{\"x402Version\":2,\"offer\":true,\"want\":\"" + want + "\",\"resource\":{\"url\":\"" + resource + "\"},\"pays\":[{\"scheme\":\"exact\",\"network\":\"" + network + "\",\"amount\":\"" + amount + "\",\"asset\":\"" + asset + "\",\"payTo\":\"" + pay_to + "\",\"maxTimeoutSeconds\":60}]}";
}

pub fn pay_offer_header_line(body: String) -> String {
    return "PAYMENT-OFFERED: " + body;
}

pub fn pay_offer_claim_or_deny(pin: String, claim: String) -> Result[Bool, String] {
    return pay_attach_or_deny(pin, claim, "OODA_OFFER_CLAIM=1");
}
