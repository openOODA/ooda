// # Pay with work (hashcash on SHA-256)
//
// Logline: Quote bits of leading-zero work. Verify a stamp. No wallet.
//
// Setup: sha256 is the product hex digest. Stamp is ver:bits:date:resource:ext:rand:counter.
//
// Beats:
//   1. WORK-REQUIRED names the quote header.
//   2. Ready when bits > 0 and resource is present.
//   3. A stamp is ok only if sha256(stamp) has at least bits leading zero bits
//      and the resource field matches.
//
// residual: no mint in this file; callers loop a counter if they want a stamp

import "std/crypto/sha256.oo";
import "std/net/pay_json.oo";
import "std/net/pay_pin.oo";
import "std/str.oo";

type PayWorkQuote = struct {
    scheme: String,
    bits: Int,
    alg: String,
    resource: String
};

fn nibble_extra(c: String) -> Int {
    if c == "1" {
        return 3;
    }
    if c == "2" || c == "3" {
        return 2;
    }
    if c == "4" || c == "5" || c == "6" || c == "7" {
        return 1;
    }
    return 0;
}

pub fn pay_work_hex_zero_bits(h: String) -> Int {
    let n: Int = chars_len(h);
    let mut bits: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(h, i);
        if c == "0" {
            bits = bits + 4;
        } else {
            return bits + nibble_extra(c);
        }
        i = i + 1;
    }
    return bits;
}

fn field(s: String, idx: Int) -> String {
    let n: Int = chars_len(s);
    let mut f: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(s, i) == ":" {
            if f == idx {
                return str_slice(s, start, i);
            }
            f = f + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

pub fn pay_work_required_header_name() -> String {
    return "WORK-REQUIRED";
}

pub fn pay_work_proof_header_name() -> String {
    return "WORK-PROOF";
}

pub fn pay_work_parse(body: String) -> PayWorkQuote {
    let acc: String = pay_json_first_accept(body);
    let mut src: String = acc;
    if src == "" {
        src = body;
    }
    let mut res: String = pay_json_string(body, "url");
    if res == "" {
        res = pay_json_string(src, "resource");
    }
    return PayWorkQuote {
        scheme: pay_json_string(src, "scheme"),
        bits: pay_json_int(src, "bits"),
        alg: pay_json_string(src, "alg"),
        resource: res
    };
}

pub fn pay_work_ready(q: PayWorkQuote) -> Bool {
    if q.scheme != "work" {
        return false;
    }
    if q.bits <= 0 {
        return false;
    }
    if q.resource == "" {
        return false;
    }
    return true;
}

pub fn pay_work_format(q: PayWorkQuote) -> String {
    let bits: Int = q.bits;
    let b: String = bits.to_string();
    let res: String = q.resource;
    return "pay work " + b + " bits on " + res;
}

pub fn pay_work_required_json(bits: Int, resource: String) -> String {
    let b: String = bits.to_string();
    return "{\"x402Version\":2,\"error\":\"WORK-PROOF header is required\",\"resource\":{\"url\":\"" + resource + "\"},\"accepts\":[{\"scheme\":\"work\",\"alg\":\"sha256\",\"bits\":" + b + "}]}";
}

pub fn pay_work_stamp_ok(stamp: String, bits: Int, resource: String) -> Bool {
    if stamp == "" {
        return false;
    }
    if bits <= 0 {
        return false;
    }
    if field(stamp, 3) != resource {
        return false;
    }
    let want: String = bits.to_string();
    if field(stamp, 1) != want {
        return false;
    }
    let h: String = sha256(stamp);
    if pay_work_hex_zero_bits(h) < bits {
        return false;
    }
    return true;
}

pub fn pay_work_proof_line(stamp: String) -> String {
    return "WORK-PROOF: " + stamp;
}

pub fn pay_work_attach_or_deny(pin: String, stamp: String) -> Result[Bool, String] {
    return pay_attach_or_deny(pin, stamp, "OODA_WORK_SPEND=1");
}
