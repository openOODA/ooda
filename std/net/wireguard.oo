// openOODA WireGuard VPN bindings
// std/src/net/wireguard.oo
//
// HONESTY residual: Thin facade only. Crypto (Noise_IK, Curve25519, BLAKE2s,
// ChaCha20-Poly1305), TUN bind, and UDP transport are NOT implemented here.
// All effectful entry points fail-closed via process_exit(1). Do not treat
// construct helpers as a live VPN. Not product WireGuard.
// CAP-G6 / CAP-G1: preferred &UdpCap for UDP/VPN residual (WireGuard is UDP;
// bind_udp/udp_recv prefer UdpCap — BindCap is TCP listen only).
// HONESTY: legacy &NetCap still supersedes soft-granular at check + runtime;
// this facade surfaces the preferred token. Wrong granular (e.g. only HttpCap)
// must not authorize a VPN residual. Do not greenwash cap migration as crypto.
// RULES 1.3: Fail-closed residual for unimplemented builtins.
// RULES 1.4: Default-deny — explicit &UdpCap (or legacy NetCap supersede).
// CAPS.oot §2: UdpCap preferred for UDP bind/recv. Deeper policy/types surface
// (still crypto-gated) lives under ooda::sec::net::wireguard when present.

type WGPeer = struct {
    pubkey: String,
    endpoint: String,
};

type WGInterface = struct {
    listen_port: Int,
    private_key: String,
    udp: &UdpCap,
};

pub fn wg_init(udp: &UdpCap) -> Int {
    // Residual: no kernel WireGuard / netlink / TUN builtins in openOODA IR.
    process_exit(1);
    return 1;
}

pub fn wg_create_interface(listen_port: Int, udp: &UdpCap) -> WGInterface {
    // Residual: cannot mint real interface keys or bind a device.
    process_exit(1);
    return WGInterface {
        listen_port: listen_port,
        private_key: "",
        udp: udp,
    };
}

pub fn wg_add_peer(iface: &WGInterface, pubkey: String) -> WGPeer {
    // Residual: peer install requires handshake crypto + kernel SAD.
    process_exit(1);
    return WGPeer {
        pubkey: pubkey,
        endpoint: "",
    };
}

pub fn wg_remove_peer(iface: &WGInterface, peer: &WGPeer) -> Int {
    process_exit(1);
    return 1;
}

pub fn wg_start(iface: &WGInterface) -> Int {
    process_exit(1);
    return 1;
}

pub fn wg_stop(iface: &WGInterface) -> Int {
    process_exit(1);
    return 1;
}
