// # HTTP/2 Frame Representation and Serialization Module
//
// Logline: HTTP/2 binary frame types, flag masks, stream association, and diagnostic formatting (RFC 7540).
//
// Setup: Pure frame representations covering DATA, HEADERS, SETTINGS, PING, GOAWAY, and WINDOW_UPDATE.
//
// Beats:
//   1. Define Http2Frame struct with 9-octet frame header attributes and payload.
//   2. Provide constructors for standard HTTP/2 frame types and flag configurations.
//   3. Implement flag verification and frame type name resolution.
//   4. Format diagnostic wire summaries for protocol inspection and tracing.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type Http2Frame = struct {
    length: Int,
    frame_type: Int,
    flags: Int,
    stream_id: Int,
    payload: String
};

pub fn http2_frame_new(frame_type: Int, flags: Int, stream_id: Int, payload: String) -> Http2Frame {
    let len: Int = chars_len(payload);
    return Http2Frame {
        length: len,
        frame_type: frame_type,
        flags: flags,
        stream_id: stream_id,
        payload: payload
    };
}

pub fn http2_frame_type_name(frame_type: Int) -> String {
    if frame_type == 0 { return "DATA"; }
    if frame_type == 1 { return "HEADERS"; }
    if frame_type == 2 { return "PRIORITY"; }
    if frame_type == 3 { return "RST_STREAM"; }
    if frame_type == 4 { return "SETTINGS"; }
    if frame_type == 5 { return "PUSH_PROMISE"; }
    if frame_type == 6 { return "PING"; }
    if frame_type == 7 { return "GOAWAY"; }
    if frame_type == 8 { return "WINDOW_UPDATE"; }
    if frame_type == 9 { return "CONTINUATION"; }
    return "UNKNOWN";
}

pub fn http2_frame_data(stream_id: Int, payload: String, end_stream: Bool) -> Http2Frame {
    let mut flags: Int = 0;
    if end_stream {
        flags = 1;
    }
    return http2_frame_new(0, flags, stream_id, payload);
}

pub fn http2_frame_headers(stream_id: Int, payload: String, end_headers: Bool, end_stream: Bool) -> Http2Frame {
    let mut flags: Int = 0;
    if end_stream {
        flags = flags + 1;
    }
    if end_headers {
        flags = flags + 4;
    }
    return http2_frame_new(1, flags, stream_id, payload);
}

pub fn http2_frame_settings(ack: Bool, payload: String) -> Http2Frame {
    let mut flags: Int = 0;
    if ack {
        flags = 1;
    }
    return http2_frame_new(4, flags, 0, payload);
}

pub fn http2_frame_ping(ack: Bool, payload: String) -> Http2Frame {
    let mut flags: Int = 0;
    if ack {
        flags = 1;
    }
    return http2_frame_new(6, flags, 0, payload);
}

pub fn http2_frame_goaway(last_stream_id: Int, error_code: Int, debug_data: String) -> Http2Frame {
    let l_str: String = last_stream_id.to_string();
    let e_str: String = error_code.to_string();
    let body: String = l_str + ":" + e_str + ":" + debug_data;
    return http2_frame_new(7, 0, 0, body);
}

pub fn http2_frame_window_update(stream_id: Int, increment: Int) -> Http2Frame {
    let inc_str: String = increment.to_string();
    return http2_frame_new(8, 0, stream_id, inc_str);
}

pub fn http2_frame_has_flag(frame: Http2Frame, flag_bit: Int) -> Bool {
    let fl: Int = frame.flags;
    let div: Int = fl / flag_bit;
    return (div % 2) != 0;
}

pub fn http2_frame_format(frame: Http2Frame) -> String {
    let ft: Int = frame.frame_type;
    let tname: String = http2_frame_type_name(ft);
    let sid: Int = frame.stream_id;
    let sid_str: String = sid.to_string();
    let fl: Int = frame.flags;
    let fl_str: String = fl.to_string();
    let len: Int = frame.length;
    let len_str: String = len.to_string();
    return "[HTTP2 Frame: type=" + tname + " stream=" + sid_str + " flags=" + fl_str + " length=" + len_str + "]";
}
