// # URL Parsing and Formatting Module
//
// Logline: URI scheme, host, port, path, query, and fragment parsing and serialization (RFC 3986).
//
// Setup: Pure URI manipulation module for URL composition and query parameter extraction.
//
// Beats:
//   1. Define ParsedUrl struct with scheme, host, port, path, query, fragment, and validity flag.
//   2. Parse absolute and relative URLs into structured components.
//   3. Extract query parameters from URL query strings.
//   4. Serialize ParsedUrl structures back into canonical URL strings.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type ParsedUrl = struct {
    scheme: String,
    host: String,
    port: Int,
    path: String,
    query: String,
    fragment: String,
    is_valid: Bool
};

pub fn url_default_port(scheme: String) -> Int {
    if scheme == "https" || scheme == "wss" { return 443; }
    if scheme == "http" || scheme == "ws" { return 80; }
    if scheme == "ftp" { return 21; }
    if scheme == "ssh" { return 22; }
    return 0;
}

pub fn url_invalid() -> ParsedUrl {
    return ParsedUrl {
        scheme: "",
        host: "",
        port: 0,
        path: "",
        query: "",
        fragment: "",
        is_valid: false
    };
}

pub fn url_new(scheme: String, host: String, port: Int, path: String) -> ParsedUrl {
    let mut p: Int = port;
    if p == 0 {
        p = url_default_port(scheme);
    }
    return ParsedUrl {
        scheme: scheme,
        host: host,
        port: p,
        path: path,
        query: "",
        fragment: "",
        is_valid: true
    };
}

pub fn url_is_https(u: ParsedUrl) -> Bool {
    let s: String = u.scheme;
    return s == "https" || s == "wss";
}

pub fn url_is_http(u: ParsedUrl) -> Bool {
    let s: String = u.scheme;
    return s == "http" || s == "ws";
}

pub fn url_with_query(u: ParsedUrl, query: String) -> ParsedUrl {
    let s: String = u.scheme;
    let h: String = u.host;
    let p: Int = u.port;
    let path: String = u.path;
    let f: String = u.fragment;
    let v: Bool = u.is_valid;
    return ParsedUrl {
        scheme: s,
        host: h,
        port: p,
        path: path,
        query: query,
        fragment: f,
        is_valid: v
    };
}

fn url_parse_port_digits(s: String) -> Int {
    let mut acc: Int = 0;
    let mut i: Int = 0;
    let n: Int = chars_len(s);
    while i < n {
        let c: String = char_at(s, i);
        let mut d: Int = -1;
        if c == "0" { d = 0; }
        if c == "1" { d = 1; }
        if c == "2" { d = 2; }
        if c == "3" { d = 3; }
        if c == "4" { d = 4; }
        if c == "5" { d = 5; }
        if c == "6" { d = 6; }
        if c == "7" { d = 7; }
        if c == "8" { d = 8; }
        if c == "9" { d = 9; }
        if d < 0 { return acc; }
        acc = acc * 10 + d;
        i = i + 1;
    }
    return acc;
}

pub fn url_parse(raw: String) -> ParsedUrl {
    let n: Int = chars_len(raw);
    if n == 0 {
        return url_invalid();
    }
    let proto_sep: Int = str_index_of(raw, "://");
    if proto_sep < 0 {
        return url_invalid();
    }
    let scheme: String = str_slice(raw, 0, proto_sep);
    let after_proto: String = str_slice(raw, proto_sep + 3, n);
    let after_len: Int = chars_len(after_proto);
    let slash_idx: Int = str_index_of(after_proto, "/");
    let mut host_port: String = after_proto;
    let mut path_query: String = "/";
    if slash_idx >= 0 {
        host_port = str_slice(after_proto, 0, slash_idx);
        path_query = str_slice(after_proto, slash_idx, after_len);
    }
    let mut host: String = host_port;
    let mut port: Int = url_default_port(scheme);
    let colon_idx: Int = str_index_of(host_port, ":");
    if colon_idx >= 0 {
        let hp_len: Int = chars_len(host_port);
        host = str_slice(host_port, 0, colon_idx);
        let port_str: String = str_slice(host_port, colon_idx + 1, hp_len);
        let parsed_p: Int = url_parse_port_digits(port_str);
        if parsed_p > 0 {
            port = parsed_p;
        }
    }
    let mut path: String = path_query;
    let mut query: String = "";
    let mut fragment: String = "";
    let q_idx: Int = str_index_of(path_query, "?");
    let pq_len: Int = chars_len(path_query);
    if q_idx >= 0 {
        path = str_slice(path_query, 0, q_idx);
        let rem_q: String = str_slice(path_query, q_idx + 1, pq_len);
        let hash_idx: Int = str_index_of(rem_q, "#");
        if hash_idx >= 0 {
            let rq_len: Int = chars_len(rem_q);
            query = str_slice(rem_q, 0, hash_idx);
            fragment = str_slice(rem_q, hash_idx + 1, rq_len);
        } else {
            query = rem_q;
        }
    }
    return ParsedUrl {
        scheme: scheme,
        host: host,
        port: port,
        path: path,
        query: query,
        fragment: fragment,
        is_valid: true
    };
}

pub fn url_get_param(query: String, key: String) -> String {
    let target: String = key + "=";
    let idx: Int = str_index_of(query, target);
    if idx < 0 {
        return "";
    }
    let qlen: Int = chars_len(query);
    let tlen: Int = chars_len(target);
    let rem: String = str_slice(query, idx + tlen, qlen);
    let amp: Int = str_index_of(rem, "&");
    if amp >= 0 {
        return str_slice(rem, 0, amp);
    }
    return rem;
}

pub fn url_to_string(u: ParsedUrl) -> String {
    let s: String = u.scheme;
    let h: String = u.host;
    let p: Int = u.port;
    let path: String = u.path;
    let q: String = u.query;
    let f: String = u.fragment;
    let def_p: Int = url_default_port(s);
    let mut out: String = s + "://" + h;
    if p != def_p && p != 0 {
        let p_str: String = p.to_string();
        out = out + ":" + p_str;
    }
    out = out + path;
    if chars_len(q) > 0 {
        out = out + "?" + q;
    }
    if chars_len(f) > 0 {
        out = out + "#" + f;
    }
    return out;
}
