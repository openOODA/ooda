// # HTTP Request Representation and Parsing Module
//
// Logline: Immutable HTTP request representations, wire serialization, header access, and body extraction.
//
// Setup: Pure message abstraction for HTTP/1.1 client and server requests.
//
// Beats:
//   1. Define HttpRequest struct with method, URI, version, headers, and body.
//   2. Provide constructors and builder methods for adding headers and payload.
//   3. Serialize HttpRequest into standard HTTP/1.1 wire format.
//   4. Parse method, URI, headers, and body from raw request text.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type HttpRequest = struct {
    method: String,
    uri: String,
    version: String,
    headers: String,
    body: String
};

pub fn http_request_new(method: String, uri: String) -> HttpRequest {
    return HttpRequest {
        method: method,
        uri: uri,
        version: "HTTP/1.1",
        headers: "",
        body: ""
    };
}

pub fn http_request_with_header(req: HttpRequest, name: String, value: String) -> HttpRequest {
    let m: String = req.method;
    let u: String = req.uri;
    let v: String = req.version;
    let h: String = req.headers;
    let b: String = req.body;
    let new_h: String = h + name + ": " + value + "\r\n";
    return HttpRequest {
        method: m,
        uri: u,
        version: v,
        headers: new_h,
        body: b
    };
}

pub fn http_request_with_body(req: HttpRequest, body: String) -> HttpRequest {
    let m: String = req.method;
    let u: String = req.uri;
    let v: String = req.version;
    let h: String = req.headers;
    return HttpRequest {
        method: m,
        uri: u,
        version: v,
        headers: h,
        body: body
    };
}

pub fn http_request_has_body(req: HttpRequest) -> Bool {
    let b: String = req.body;
    return chars_len(b) > 0;
}

pub fn http_request_serialize(req: HttpRequest) -> String {
    let m: String = req.method;
    let u: String = req.uri;
    let v: String = req.version;
    let h: String = req.headers;
    let b: String = req.body;
    let mut out: String = m + " " + u + " " + v + "\r\n";
    if chars_len(h) > 0 {
        out = out + h;
    }
    let blen: Int = chars_len(b);
    if blen > 0 {
        let blen_str: String = blen.to_string();
        if !h.contains("Content-Length:") {
            out = out + "Content-Length: " + blen_str + "\r\n";
        }
    }
    out = out + "\r\n";
    if blen > 0 {
        out = out + b;
    }
    return out;
}

pub fn http_request_parse_method(raw: String) -> String {
    let sp1: Int = str_index_of(raw, " ");
    if sp1 <= 0 {
        return "GET";
    }
    return str_slice(raw, 0, sp1);
}

pub fn http_request_parse_uri(raw: String) -> String {
    let sp1: Int = str_index_of(raw, " ");
    if sp1 < 0 {
        return "/";
    }
    let n: Int = chars_len(raw);
    let rem: String = str_slice(raw, sp1 + 1, n);
    let sp2: Int = str_index_of(rem, " ");
    if sp2 < 0 {
        let nl: Int = str_index_of(rem, "\n");
        if nl < 0 {
            return rem;
        }
        return str_slice(rem, 0, nl);
    }
    return str_slice(rem, 0, sp2);
}

pub fn http_request_parse_body(raw: String) -> String {
    let dnl: Int = str_index_of(raw, "\r\n\r\n");
    let n: Int = chars_len(raw);
    if dnl >= 0 {
        return str_slice(raw, dnl + 4, n);
    }
    let dnl2: Int = str_index_of(raw, "\n\n");
    if dnl2 >= 0 {
        return str_slice(raw, dnl2 + 2, n);
    }
    return "";
}

pub fn http_request_get_header(req: HttpRequest, name: String) -> String {
    let h: String = req.headers;
    let target: String = name + ": ";
    let idx: Int = str_index_of(h, target);
    if idx < 0 {
        return "";
    }
    let tlen: Int = chars_len(target);
    let hlen: Int = chars_len(h);
    let rem: String = str_slice(h, idx + tlen, hlen);
    let crnl: Int = str_index_of(rem, "\r\n");
    if crnl >= 0 {
        return str_slice(rem, 0, crnl);
    }
    let nl: Int = str_index_of(rem, "\n");
    if nl >= 0 {
        return str_slice(rem, 0, nl);
    }
    return rem;
}
