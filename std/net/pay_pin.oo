// # Fail-closed attach pin for pay handshakes
//
// Logline: Refuse to attach a proof unless the pin is exactly 1 and the proof is not empty.
//
// Setup: Callers pass their own env pin string. This file does not read the environment.
//
// Beats:
//   1. Empty pin denies.
//   2. Pin 1 with empty proof denies.
//   3. Pin 1 with a proof is Ok(true). Not a payment.

pub fn pay_pin_on(pin: String) -> Bool {
    return pin == "1";
}

pub fn pay_attach_or_deny(pin: String, proof: String, need: String) -> Result[Bool, String] {
    if !pay_pin_on(pin) {
        return Err("pay attach denied: set " + need);
    }
    if proof == "" {
        return Err("pay attach denied: empty proof");
    }
    return Ok(true);
}
