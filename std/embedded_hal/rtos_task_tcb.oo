// # RTOS Task Control Block (TCB)
//
// Logline: Task Control Block data model, lifecycle states, stack watermark tracking, and runtime metrics.
//
// Setup: Pure data structures and lifecycle transitions for preemptive RTOS tasks.
//
// Beats:
//   1. Define Task Control Block (TCB) state structures, stack bounds, and execution states.
//   2. Initialize tasks with stack limits, entry points, and priority levels.
//   3. Manage task state transitions, delay counters, and stack high-watermark tracking.
//   4. Calculate CPU execution time metrics and provide task inspection queries.

type RtosTaskState = struct {
    task_id: Int,
    name: String,
    priority: Int,
    base_priority: Int,
    state: Int,
    stack_base: Int,
    stack_size: Int,
    stack_pointer: Int,
    min_free_stack: Int,
    delay_ticks: Int,
    runtime_ticks: Int,
    last_ok: Bool,
};

pub fn rtos_tcb_new(
    id: Int,
    name: String,
    priority: Int,
    stack_base: Int,
    stack_size: Int
) -> RtosTaskState {
    let bounded_prio: Int = if priority < 0 { 0 } else { if priority > 31 { 31 } else { priority } };
    return RtosTaskState {
        task_id: id,
        name: name,
        priority: bounded_prio,
        base_priority: bounded_prio,
        state: 0,
        stack_base: stack_base,
        stack_size: stack_size,
        stack_pointer: stack_base + stack_size,
        min_free_stack: stack_size,
        delay_ticks: 0,
        runtime_ticks: 0,
        last_ok: true,
    };
}

pub fn rtos_tcb_set_state(task: RtosTaskState, new_state: Int) -> RtosTaskState {
    if new_state >= 0 {
        if new_state <= 4 {
            return RtosTaskState {
                task_id: (task).task_id,
                name: (task).name,
                priority: (task).priority,
                base_priority: (task).base_priority,
                state: new_state,
                stack_base: (task).stack_base,
                stack_size: (task).stack_size,
                stack_pointer: (task).stack_pointer,
                min_free_stack: (task).min_free_stack,
                delay_ticks: (task).delay_ticks,
                runtime_ticks: (task).runtime_ticks,
                last_ok: true,
            };
        }
    }
    return task;
}

pub fn rtos_tcb_delay(task: RtosTaskState, ticks: Int) -> RtosTaskState {
    if ticks > 0 {
        return RtosTaskState {
            task_id: (task).task_id,
            name: (task).name,
            priority: (task).priority,
            base_priority: (task).base_priority,
            state: 2,
            stack_base: (task).stack_base,
            stack_size: (task).stack_size,
            stack_pointer: (task).stack_pointer,
            min_free_stack: (task).min_free_stack,
            delay_ticks: ticks,
            runtime_ticks: (task).runtime_ticks,
            last_ok: true,
        };
    }
    return task;
}

pub fn rtos_tcb_tick_delay(task: RtosTaskState) -> RtosTaskState {
    if (task).state == 2 {
        if (task).delay_ticks > 0 {
            let next: Int = (task).delay_ticks - 1;
            if next == 0 {
                return RtosTaskState {
                    task_id: (task).task_id,
                    name: (task).name,
                    priority: (task).priority,
                    base_priority: (task).base_priority,
                    state: 0,
                    stack_base: (task).stack_base,
                    stack_size: (task).stack_size,
                    stack_pointer: (task).stack_pointer,
                    min_free_stack: (task).min_free_stack,
                    delay_ticks: 0,
                    runtime_ticks: (task).runtime_ticks,
                    last_ok: true,
                };
            }
            return RtosTaskState {
                task_id: (task).task_id,
                name: (task).name,
                priority: (task).priority,
                base_priority: (task).base_priority,
                state: 2,
                stack_base: (task).stack_base,
                stack_size: (task).stack_size,
                stack_pointer: (task).stack_pointer,
                min_free_stack: (task).min_free_stack,
                delay_ticks: next,
                runtime_ticks: (task).runtime_ticks,
                last_ok: false,
            };
        }
    }
    return RtosTaskState {
        task_id: (task).task_id,
        name: (task).name,
        priority: (task).priority,
        base_priority: (task).base_priority,
        state: (task).state,
        stack_base: (task).stack_base,
        stack_size: (task).stack_size,
        stack_pointer: (task).stack_pointer,
        min_free_stack: (task).min_free_stack,
        delay_ticks: (task).delay_ticks,
        runtime_ticks: (task).runtime_ticks,
        last_ok: false,
    };
}

pub fn rtos_tcb_suspend(task: RtosTaskState) -> RtosTaskState {
    return rtos_tcb_set_state(task, 3);
}

pub fn rtos_tcb_resume(task: RtosTaskState) -> RtosTaskState {
    if (task).state == 3 {
        return rtos_tcb_set_state(task, 0);
    }
    return task;
}

pub fn rtos_tcb_terminate(task: RtosTaskState) -> RtosTaskState {
    return rtos_tcb_set_state(task, 4);
}

pub fn rtos_tcb_update_stack(task: RtosTaskState, current_sp: Int) -> RtosTaskState {
    let free_bytes: Int = current_sp - (task).stack_base;
    let mut min_free: Int = (task).min_free_stack;
    if free_bytes < min_free {
        min_free = free_bytes;
    }
    let ok: Bool = if current_sp < (task).stack_base { false } else { true };
    return RtosTaskState {
        task_id: (task).task_id,
        name: (task).name,
        priority: (task).priority,
        base_priority: (task).base_priority,
        state: (task).state,
        stack_base: (task).stack_base,
        stack_size: (task).stack_size,
        stack_pointer: current_sp,
        min_free_stack: min_free,
        delay_ticks: (task).delay_ticks,
        runtime_ticks: (task).runtime_ticks,
        last_ok: ok,
    };
}

pub fn rtos_tcb_accumulate_runtime(task: RtosTaskState, ticks: Int) -> RtosTaskState {
    return RtosTaskState {
        task_id: (task).task_id,
        name: (task).name,
        priority: (task).priority,
        base_priority: (task).base_priority,
        state: (task).state,
        stack_base: (task).stack_base,
        stack_size: (task).stack_size,
        stack_pointer: (task).stack_pointer,
        min_free_stack: (task).min_free_stack,
        delay_ticks: (task).delay_ticks,
        runtime_ticks: (task).runtime_ticks + ticks,
        last_ok: (task).last_ok,
    };
}

pub fn rtos_tcb_set_inherited_priority(task: RtosTaskState, inherited_prio: Int) -> RtosTaskState {
    if inherited_prio > (task).priority {
        return RtosTaskState {
            task_id: (task).task_id,
            name: (task).name,
            priority: inherited_prio,
            base_priority: (task).base_priority,
            state: (task).state,
            stack_base: (task).stack_base,
            stack_size: (task).stack_size,
            stack_pointer: (task).stack_pointer,
            min_free_stack: (task).min_free_stack,
            delay_ticks: (task).delay_ticks,
            runtime_ticks: (task).runtime_ticks,
            last_ok: (task).last_ok,
        };
    }
    return task;
}

pub fn rtos_tcb_restore_base_priority(task: RtosTaskState) -> RtosTaskState {
    return RtosTaskState {
        task_id: (task).task_id,
        name: (task).name,
        priority: (task).base_priority,
        base_priority: (task).base_priority,
        state: (task).state,
        stack_base: (task).stack_base,
        stack_size: (task).stack_size,
        stack_pointer: (task).stack_pointer,
        min_free_stack: (task).min_free_stack,
        delay_ticks: (task).delay_ticks,
        runtime_ticks: (task).runtime_ticks,
        last_ok: (task).last_ok,
    };
}

pub fn rtos_tcb_is_ready(task: RtosTaskState) -> Bool {
    return (task).state == 0;
}

pub fn rtos_tcb_is_running(task: RtosTaskState) -> Bool {
    return (task).state == 1;
}

pub fn rtos_tcb_is_blocked(task: RtosTaskState) -> Bool {
    return (task).state == 2;
}

pub fn rtos_tcb_is_suspended(task: RtosTaskState) -> Bool {
    return (task).state == 3;
}

pub fn rtos_tcb_is_terminated(task: RtosTaskState) -> Bool {
    return (task).state == 4;
}

pub fn rtos_tcb_get_stack_high_watermark(task: RtosTaskState) -> Int {
    return (task).min_free_stack;
}
