// # DAC Waveform Generator & Signal Synthesis
//
// Logline: Digital-to-Analog Converter channel configuration, output buffer control, and waveform lookup table generation.
//
// Setup: Analog output driver for signal generation, audio playback, and sensor excitation.
//
// Beats:
//   1. Define DAC channel descriptors, resolution modes, and reference voltages.
//   2. Implement precise millivolt-to-DAC-code quantization and boundary clamping.
//   3. Synthesize waveform lookup tables (Sine, Triangle, Sawtooth, Square) for DMA.
//   4. Manage DAC output levels, channel enable states, and trigger timer associations.

type DacChannel = struct {
    channel_id: Int,
    resolution_bits: Int,
    vref_mv: Int,
    buffer_enabled: Bool,
    current_code: Int,
    is_enabled: Bool,
};

pub fn dac_channel_new(ch_id: Int, vref_mv: Int) -> DacChannel {
    return DacChannel {
        channel_id: ch_id,
        resolution_bits: 12,
        vref_mv: vref_mv,
        buffer_enabled: true,
        current_code: 0,
        is_enabled: false,
    };
}

pub fn dac_millivolts_to_code(dac: DacChannel, mv: Int) -> Int {
    let bounded_mv: Int = if mv < 0 { 0 } else { if mv > (dac).vref_mv { (dac).vref_mv } else { mv } };
    let mut max_code: Int = 1;
    let mut b: Int = 0;
    while b < (dac).resolution_bits {
        max_code = max_code * 2;
        b = b + 1;
    }
    max_code = max_code - 1;
    let code: Int = (bounded_mv * max_code) / (dac).vref_mv;
    return code;
}

pub fn dac_code_to_millivolts(dac: DacChannel, code: Int) -> Int {
    let mut max_code: Int = 1;
    let mut b: Int = 0;
    while b < (dac).resolution_bits {
        max_code = max_code * 2;
        b = b + 1;
    }
    max_code = max_code - 1;
    if max_code <= 0 {
        return 0;
    }
    return (code * (dac).vref_mv) / max_code;
}

pub fn dac_set_voltage_mv(dac: DacChannel, mv: Int) -> DacChannel {
    return DacChannel {
        channel_id: (dac).channel_id,
        resolution_bits: (dac).resolution_bits,
        vref_mv: (dac).vref_mv,
        buffer_enabled: (dac).buffer_enabled,
        current_code: dac_millivolts_to_code(dac, mv),
        is_enabled: (dac).is_enabled,
    };
}

pub fn dac_generate_sine_table(samples: Int, max_val: Int) -> List[Int] {
    let mut table: List[Int] = list_new();
    let count: Int = if samples < 4 { 4 } else { samples };
    let mid: Int = max_val / 2;
    let mut i: Int = 0;
    while i < count {
        let phase: Int = (i * 100) / count;
        let mut val: Int = mid;
        if phase < 25 {
            val = mid + ((mid * phase) / 25);
        } else {
            if phase < 75 {
                val = mid + ((mid * (50 - phase)) / 25);
            } else {
                val = mid - ((mid * (100 - phase)) / 25);
            }
        }
        table = list_push(table, val);
        i = i + 1;
    }
    return table;
}

pub fn dac_generate_triangle_table(samples: Int, max_val: Int) -> List[Int] {
    let mut table: List[Int] = list_new();
    let count: Int = if samples < 2 { 2 } else { samples };
    let half: Int = count / 2;
    let mut i: Int = 0;
    while i < count {
        let mut val: Int = 0;
        if i <= half {
            val = (max_val * i) / half;
        } else {
            val = (max_val * (count - i)) / half;
        }
        table = list_push(table, val);
        i = i + 1;
    }
    return table;
}

pub fn dac_generate_sawtooth_table(samples: Int, max_val: Int) -> List[Int] {
    let mut table: List[Int] = list_new();
    let count: Int = if samples < 2 { 2 } else { samples };
    let mut i: Int = 0;
    while i < count {
        let val: Int = (max_val * i) / count;
        table = list_push(table, val);
        i = i + 1;
    }
    return table;
}

pub fn dac_generate_square_table(samples: Int, max_val: Int, duty_pct: Int) -> List[Int] {
    let mut table: List[Int] = list_new();
    let count: Int = if samples < 2 { 2 } else { samples };
    let high_samples: Int = (count * duty_pct) / 100;
    let mut i: Int = 0;
    while i < count {
        let val: Int = if i < high_samples { max_val } else { 0 };
        table = list_push(table, val);
        i = i + 1;
    }
    return table;
}

pub fn dac_enable(dac: DacChannel) -> DacChannel {
    return DacChannel {
        channel_id: (dac).channel_id,
        resolution_bits: (dac).resolution_bits,
        vref_mv: (dac).vref_mv,
        buffer_enabled: (dac).buffer_enabled,
        current_code: (dac).current_code,
        is_enabled: true,
    };
}

pub fn dac_disable(dac: DacChannel) -> DacChannel {
    return DacChannel {
        channel_id: (dac).channel_id,
        resolution_bits: (dac).resolution_bits,
        vref_mv: (dac).vref_mv,
        buffer_enabled: (dac).buffer_enabled,
        current_code: 0,
        is_enabled: false,
    };
}
