// # UART DMA Ring Buffer Block I/O Operations
//
// Logline: Non-blocking multi-byte write_bytes and read_bytes over the ring buffer with overrun early-exit.
//
// Setup: Pure operations importing uart_dma_ring_ops and uart_dma_ring_types.
//
// Beats:
//   1. uart_ring_write_bytes: push bytes until overrun, return early on failure.
//   2. uart_ring_read_bytes: pop up to max_bytes or until empty.

import "./uart_dma_ring_types.oo";
import "./uart_dma_ring_ops.oo";

pub fn uart_ring_write_bytes(ring: UartRingBuffer, data: List[Int]) -> UartRingBuffer {
    let len: Int = list_len(data);
    let mut acc: UartRingBuffer = ring;
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < len {
        let b: Int = list_get(data, i);
        acc = uart_ring_push_byte(acc, b);
        if (acc).last_ok {
            count = count + 1;
        } else {
            return UartRingBuffer {
                config: (acc).config,
                buffer: (acc).buffer,
                capacity: (acc).capacity,
                head: (acc).head,
                tail: (acc).tail,
                overrun_count: (acc).overrun_count,
                framing_errors: (acc).framing_errors,
                dma_enabled: (acc).dma_enabled,
                last_ok: false,
                last_byte: (acc).last_byte,
                last_count: count,
                last_read: (acc).last_read,
            };
        }
        i = i + 1;
    }
    return UartRingBuffer {
        config: (acc).config,
        buffer: (acc).buffer,
        capacity: (acc).capacity,
        head: (acc).head,
        tail: (acc).tail,
        overrun_count: (acc).overrun_count,
        framing_errors: (acc).framing_errors,
        dma_enabled: (acc).dma_enabled,
        last_ok: true,
        last_byte: (acc).last_byte,
        last_count: count,
        last_read: (acc).last_read,
    };
}

pub fn uart_ring_read_bytes(ring: UartRingBuffer, max_bytes: Int) -> UartRingBuffer {
    let mut acc: UartRingBuffer = ring;
    let mut out: List[Int] = list_new();
    let mut count: Int = 0;
    while count < max_bytes {
        acc = uart_ring_pop_byte(acc);
        if (acc).last_byte < 0 {
            return UartRingBuffer {
                config: (acc).config,
                buffer: (acc).buffer,
                capacity: (acc).capacity,
                head: (acc).head,
                tail: (acc).tail,
                overrun_count: (acc).overrun_count,
                framing_errors: (acc).framing_errors,
                dma_enabled: (acc).dma_enabled,
                last_ok: true,
                last_byte: (acc).last_byte,
                last_count: count,
                last_read: out,
            };
        }
        out = list_push(out, (acc).last_byte);
        count = count + 1;
    }
    return UartRingBuffer {
        config: (acc).config,
        buffer: (acc).buffer,
        capacity: (acc).capacity,
        head: (acc).head,
        tail: (acc).tail,
        overrun_count: (acc).overrun_count,
        framing_errors: (acc).framing_errors,
        dma_enabled: (acc).dma_enabled,
        last_ok: true,
        last_byte: (acc).last_byte,
        last_count: count,
        last_read: out,
    };
}
