// # Embedded HAL & RTOS Unified Facade
//
// Logline: Re-exports ARM NVIC, RISC-V CSR, RTOS TCB/Scheduler/Timers/Semaphores, GPIO, UART, SPI, I2C, Timers, ADC, DAC, RTC, WDT, Flash, EEPROM, CRC, Power, USB, and Stubs.
//
// Setup: Pure module shim importing all 24 companion Embedded Systems & RTOS submodules.
//
// Beats:
//   1. Import 24 modular microcontrollers, RTOS primitives, and hardware peripheral drivers.
//   2. Re-export public constructors, encoders, controllers, and capability-gated interfaces.
//   3. Maintain complete compatibility with downstream openOODA embedded callers.

import "./nvic_cortex_m.oo";
import "./riscv_csr.oo";
import "./rtos_task_tcb.oo";
import "./rtos_context_switch.oo";
import "./rtos_timer_queue.oo";
import "./rtos_semaphore_binary.oo";
import "./rtos_event_flags.oo";
import "./gpio_pin_config.oo";
import "./uart_dma_ring.oo";
import "./spi_master_transaction.oo";
import "./i2c_master_smbus.oo";
import "./timer_pwm_channel.oo";
import "./adc_dma_continuous.oo";
import "./dac_waveform_generator.oo";
import "./rtc_realtime_clock.oo";
import "./watchdog_timer.oo";
import "./flash_nor_sector.oo";
import "./flash_wear_leveling.oo";
import "./eeprom_emulation.oo";
import "./crc32_hardware.oo";
import "./power_sleep_modes.oo";
import "./usb_device_cdc.oo";
import "./usb_device_hid.oo";
import "./embedded_hal_stubs.oo";

pub fn hal_shim_nvic(num_irqs: Int, prio_bits: Int) -> NvicController {
    return nvic_controller_new(num_irqs, prio_bits);
}

pub fn hal_shim_riscv_csr() -> RiscvCsrState {
    return riscv_csr_init();
}

pub fn hal_shim_rtos_tcb(id: Int, name: String, prio: Int, base: Int, size: Int) -> RtosTaskState {
    return rtos_tcb_new(id, name, prio, base, size);
}

pub fn hal_shim_rtos_scheduler() -> RtosScheduler {
    return rtos_scheduler_new();
}

pub fn hal_shim_rtos_timer_queue() -> RtosTimerQueue {
    return rtos_timer_queue_new();
}

pub fn hal_shim_rtos_semaphore_binary(id: Int, init_val: Bool) -> RtosSemaphore {
    return rtos_semaphore_binary_new(id, init_val);
}

pub fn hal_shim_rtos_event_group(id: Int, init_flags: Int) -> RtosEventGroup {
    return rtos_event_group_new(id, init_flags);
}

pub fn hal_shim_gpio_pin(port: Int, pin: Int) -> GpioPin {
    return gpio_pin_new(port, pin);
}

pub fn hal_shim_uart_ring(cfg: UartConfig, cap: Int) -> UartRingBuffer {
    return uart_ring_buffer_new(cfg, cap);
}

pub fn hal_shim_spi_tx(cfg: SpiConfig) -> SpiTransaction {
    return spi_transaction_new(cfg);
}

pub fn hal_shim_i2c_tx(cfg: I2cConfig) -> I2cTransaction {
    return i2c_transaction_new(cfg);
}

pub fn hal_shim_hardware_timer(id: Int, freq: Int) -> HardwareTimer {
    return hardware_timer_new(id, freq);
}

pub fn hal_shim_adc(id: Int, res: Int, vref: Int) -> AdcController {
    return adc_controller_new(id, res, vref);
}

pub fn hal_shim_dac(id: Int, vref: Int) -> DacChannel {
    return dac_channel_new(id, vref);
}

pub fn hal_shim_rtc(dt: RtcDateTime) -> RtcController {
    return rtc_controller_new(dt);
}

pub fn hal_shim_iwdg(prescaler: Int, reload: Int) -> IwdgConfig {
    return iwdg_config_new(prescaler, reload);
}

pub fn hal_shim_wwdg(prescaler: Int, win: Int, reload: Int) -> WwdgConfig {
    return wwdg_config_new(prescaler, win, reload);
}

pub fn hal_shim_flash_controller() -> FlashNorController {
    return flash_controller_new();
}

pub fn hal_shim_wear_leveler(blocks: Int, max_cycles: Int) -> WearLeveler {
    return wear_leveler_new(blocks, max_cycles);
}

pub fn hal_shim_virtual_eeprom(max_records: Int) -> VirtualEeprom {
    return virtual_eeprom_new(max_records);
}

pub fn hal_shim_crc32_ieee() -> Crc32Engine {
    return crc32_engine_new_ieee();
}

pub fn hal_shim_power_state() -> McuPowerState {
    return mcu_power_state_new();
}

pub fn hal_shim_usb_cdc() -> UsbCdcDevice {
    return usb_cdc_device_new();
}

pub fn hal_shim_usb_hid() -> UsbHidDevice {
    return usb_hid_device_new();
}

pub fn hal_shim_fail_closed_mmio(sys: &SysCap, addr: Int) -> Int {
    return hal_raw_mmio_read32(sys, addr);
}
