// # MCU Low-Power States & Sleep Modes
//
// Logline: MCU power states (Run, Sleep, Stop, Standby, Shutdown), clock gating, SRAM retention, and wakeup sources.
//
// Setup: Power Control (PWR) register abstraction governing clock domain shutoff and energy conservation.
//
// Beats:
//   1. Define MCU power states, voltage scaling ranges, and peripheral domain power gates.
//   2. Configure Sleep (WFI/WFE), Deep-Sleep/Stop, and Standby mode transitions.
//   3. Configure Wakeup Pins (WKUP1-5), RTC alarm wakeup sources, and polarity flags.
//   4. Estimate power consumption in microamps (uA) and manage clock restoration upon wakeup.

type McuPowerState = struct {
    mode: Int,
    voltage_scale: Int,
    sram1_retention: Bool,
    sram2_retention: Bool,
    flash_power_down: Bool,
    wakeup_pin_mask: Int,
    rtc_wakeup_enabled: Bool,
    current_draw_ua: Int
};

pub fn mcu_power_state_new() -> McuPowerState {
    return McuPowerState {
        mode: 0,
        voltage_scale: 1,
        sram1_retention: true,
        sram2_retention: true,
        flash_power_down: false,
        wakeup_pin_mask: 0,
        rtc_wakeup_enabled: false,
        current_draw_ua: 15000
    };
}

pub fn power_enter_sleep_mode(pwr: McuPowerState) -> McuPowerState {
    return McuPowerState {
        mode: 1,
        voltage_scale: (pwr).voltage_scale,
        sram1_retention: (pwr).sram1_retention,
        sram2_retention: (pwr).sram2_retention,
        flash_power_down: (pwr).flash_power_down,
        wakeup_pin_mask: (pwr).wakeup_pin_mask,
        rtc_wakeup_enabled: (pwr).rtc_wakeup_enabled,
        current_draw_ua: 4000
    };
}

pub fn power_enter_stop_mode(pwr: McuPowerState, retain_sram2: Bool) -> McuPowerState {
    return McuPowerState {
        mode: 2,
        voltage_scale: (pwr).voltage_scale,
        sram1_retention: true,
        sram2_retention: retain_sram2,
        flash_power_down: true,
        wakeup_pin_mask: (pwr).wakeup_pin_mask,
        rtc_wakeup_enabled: (pwr).rtc_wakeup_enabled,
        current_draw_ua: 12
    };
}

pub fn power_enter_standby_mode(pwr: McuPowerState) -> McuPowerState {
    return McuPowerState {
        mode: 3,
        voltage_scale: (pwr).voltage_scale,
        sram1_retention: false,
        sram2_retention: false,
        flash_power_down: true,
        wakeup_pin_mask: (pwr).wakeup_pin_mask,
        rtc_wakeup_enabled: (pwr).rtc_wakeup_enabled,
        current_draw_ua: 1
    };
}

pub fn power_enter_shutdown_mode(pwr: McuPowerState) -> McuPowerState {
    return McuPowerState {
        mode: 4,
        voltage_scale: (pwr).voltage_scale,
        sram1_retention: false,
        sram2_retention: false,
        flash_power_down: true,
        wakeup_pin_mask: (pwr).wakeup_pin_mask,
        rtc_wakeup_enabled: (pwr).rtc_wakeup_enabled,
        current_draw_ua: 0
    };
}

pub fn power_wakeup(pwr: McuPowerState) -> McuPowerState {
    let mut draw: Int = 3000;
    if (pwr).voltage_scale == 1 {
        draw = 15000;
    } else {
        if (pwr).voltage_scale == 2 {
            draw = 8000;
        }
    }
    return McuPowerState {
        mode: 0,
        voltage_scale: (pwr).voltage_scale,
        sram1_retention: (pwr).sram1_retention,
        sram2_retention: (pwr).sram2_retention,
        flash_power_down: false,
        wakeup_pin_mask: (pwr).wakeup_pin_mask,
        rtc_wakeup_enabled: (pwr).rtc_wakeup_enabled,
        current_draw_ua: draw
    };
}

pub fn power_enable_wakeup_pin(pwr: McuPowerState, pin_index: Int) -> McuPowerState {
    let mut mask: Int = (pwr).wakeup_pin_mask;
    if pin_index >= 1 {
        if pin_index <= 5 {
            let mut bit: Int = 1;
            let mut i: Int = 1;
            while i < pin_index {
                bit = bit * 2;
                i = i + 1;
            }
            if (mask / bit) % 2 == 0 {
                mask = mask + bit;
            }
        }
    }
    return McuPowerState {
        mode: (pwr).mode,
        voltage_scale: (pwr).voltage_scale,
        sram1_retention: (pwr).sram1_retention,
        sram2_retention: (pwr).sram2_retention,
        flash_power_down: (pwr).flash_power_down,
        wakeup_pin_mask: mask,
        rtc_wakeup_enabled: (pwr).rtc_wakeup_enabled,
        current_draw_ua: (pwr).current_draw_ua
    };
}

pub fn power_disable_wakeup_pin(pwr: McuPowerState, pin_index: Int) -> McuPowerState {
    let mut mask: Int = (pwr).wakeup_pin_mask;
    if pin_index >= 1 {
        if pin_index <= 5 {
            let mut bit: Int = 1;
            let mut i: Int = 1;
            while i < pin_index {
                bit = bit * 2;
                i = i + 1;
            }
            if (mask / bit) % 2 == 1 {
                mask = mask - bit;
            }
        }
    }
    return McuPowerState {
        mode: (pwr).mode,
        voltage_scale: (pwr).voltage_scale,
        sram1_retention: (pwr).sram1_retention,
        sram2_retention: (pwr).sram2_retention,
        flash_power_down: (pwr).flash_power_down,
        wakeup_pin_mask: mask,
        rtc_wakeup_enabled: (pwr).rtc_wakeup_enabled,
        current_draw_ua: (pwr).current_draw_ua
    };
}

pub fn power_is_in_low_power(pwr: McuPowerState) -> Bool {
    return (pwr).mode > 0;
}
