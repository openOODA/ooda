// # RISC-V CSR State Type
//
// Logline: RiscvCsrState struct and default machine-mode init.
//
// Setup: Flat Int field carrier for machine-mode CSRs (mstatus, mie, mip, mtvec, mepc, mcause, mtval, pmpcfg0, pmpaddr0/1) plus privilege and audit fields.
//
// Beats:
//   1. Define RiscvCsrState.
//   2. riscv_csr_init: machine mode (3) with all CSRs zeroed.

type RiscvCsrState = struct {
    mstatus: Int,
    mie: Int,
    mip: Int,
    mtvec: Int,
    mepc: Int,
    mcause: Int,
    mtval: Int,
    pmpcfg0: Int,
    pmpaddr0: Int,
    pmpaddr1: Int,
    privilege_mode: Int,
    last_csr: Int,
    last_handler: Int
};

pub fn riscv_csr_init() -> RiscvCsrState {
    return RiscvCsrState {
        mstatus: 0,
        mie: 0,
        mip: 0,
        mtvec: 0,
        mepc: 0,
        mcause: 0,
        mtval: 0,
        pmpcfg0: 0,
        pmpaddr0: 0,
        pmpaddr1: 0,
        privilege_mode: 3,
        last_csr: 0,
        last_handler: 0
    };
}
