// # USB Device HID Driver
//
// Logline: USB Human Interface Device class descriptors, keyboard/mouse input reports, and idle rate control.
//
// Setup: USB device peripheral controller implementing standard keyboard and pointer input devices.
//
// Beats:
//   1. Define USB HID class structures, report protocols, and idle interval timing.
//   2. Build standard 8-byte USB HID keyboard input report frames.
//   3. Build standard USB HID mouse input report frames with button bitmasks and coordinate deltas.
//   4. Manage Set_Idle and Get_Report class-specific control request handlers.

type UsbHidKeyboardReport = struct {
    modifier_keys: Int,
    reserved: Int,
    keycodes: List[Int],
};

type UsbHidMouseReport = struct {
    buttons: Int,
    delta_x: Int,
    delta_y: Int,
    wheel: Int,
};

type UsbHidDevice = struct {
    protocol_mode: Int,
    idle_rate_4ms: Int,
    idle_timer: Int,
    is_configured: Bool,
};

pub fn usb_hid_keyboard_report_new() -> UsbHidKeyboardReport {
    let mut empty_keys: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 6 {
        empty_keys = list_push(empty_keys, 0);
        i = i + 1;
    }
    return UsbHidKeyboardReport {
        modifier_keys: 0,
        reserved: 0,
        keycodes: empty_keys,
    };
}

pub fn usb_hid_mouse_report_new() -> UsbHidMouseReport {
    return UsbHidMouseReport {
        buttons: 0,
        delta_x: 0,
        delta_y: 0,
        wheel: 0,
    };
}

pub fn usb_hid_device_new() -> UsbHidDevice {
    return UsbHidDevice {
        protocol_mode: 1,
        idle_rate_4ms: 125,
        idle_timer: 0,
        is_configured: false,
    };
}

pub fn usb_hid_keyboard_serialize(report: UsbHidKeyboardReport) -> List[Int] {
    let mut bytes: List[Int] = list_new();
    bytes = list_push(bytes, (report).modifier_keys % 256);
    bytes = list_push(bytes, 0);

    let mut i: Int = 0;
    let len: Int = list_len((report).keycodes);
    while i < 6 {
        let code: Int = if i < len { list_get((report).keycodes, i) } else { 0 };
        bytes = list_push(bytes, code % 256);
        i = i + 1;
    }
    return bytes;
}

pub fn usb_hid_mouse_serialize(report: UsbHidMouseReport) -> List[Int] {
    let mut bytes: List[Int] = list_new();
    bytes = list_push(bytes, (report).buttons % 256);

    let dx: Int = if (report).delta_x < 0 { (report).delta_x + 256 } else { (report).delta_x };
    let dy: Int = if (report).delta_y < 0 { (report).delta_y + 256 } else { (report).delta_y };
    let dz: Int = if (report).wheel < 0 { (report).wheel + 256 } else { (report).wheel };

    bytes = list_push(bytes, dx % 256);
    bytes = list_push(bytes, dy % 256);
    bytes = list_push(bytes, dz % 256);
    return bytes;
}

pub fn usb_hid_set_idle(dev: UsbHidDevice, duration_4ms: Int) -> UsbHidDevice {
    return UsbHidDevice {
        protocol_mode: (dev).protocol_mode,
        idle_rate_4ms: duration_4ms,
        idle_timer: 0,
        is_configured: (dev).is_configured,
    };
}

pub fn usb_hid_set_protocol(dev: UsbHidDevice, protocol: Int) -> UsbHidDevice {
    return UsbHidDevice {
        protocol_mode: protocol % 2,
        idle_rate_4ms: (dev).idle_rate_4ms,
        idle_timer: (dev).idle_timer,
        is_configured: (dev).is_configured,
    };
}
