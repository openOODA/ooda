// # Real-Time Clock & Calendar
//
// Logline: BCD date/time encoding, leap-year calculations, alarm matching, and periodic wakeup timers.
//
// Setup: Low-power battery-backed real-time clock domain for calendar tracking and wakeups.
//
// Beats:
//   1. Define DateTime structures, BCD encoder/decoder helpers, and RTC register models.
//   2. Validate calendar dates with leap-year rules and days-per-month boundaries.
//   3. Implement time advancement, second increments, and epoch conversions.
//   4. Configure Alarm A/B match masks and evaluate trigger firing conditions.

type RtcDateTime = struct {
    year: Int,
    month: Int,
    day: Int,
    weekday: Int,
    hours: Int,
    minutes: Int,
    seconds: Int,
    subseconds: Int
};

type RtcAlarm = struct {
    hours: Int,
    minutes: Int,
    seconds: Int,
    mask_hours: Bool,
    mask_minutes: Bool,
    mask_seconds: Bool,
    is_enabled: Bool
};

type RtcController = struct {
    datetime: RtcDateTime,
    alarm_a: RtcAlarm,
    alarm_b: RtcAlarm,
    wakeup_timer_ticks: Int,
    wakeup_enabled: Bool
};

pub fn bcd_to_bin(bcd: Int) -> Int {
    return ((bcd / 16) * 10) + (bcd % 16);
}

pub fn bin_to_bcd(bin_val: Int) -> Int {
    return ((bin_val / 10) * 16) + (bin_val % 10);
}

pub fn is_leap_year(year: Int) -> Bool {
    if (year % 400) == 0 { return true; }
    if (year % 100) == 0 { return false; }
    if (year % 4) == 0 { return true; }
    return false;
}

pub fn get_days_in_month(month: Int, year: Int) -> Int {
    if month == 2 {
        if is_leap_year(year) { return 29; }
        return 28;
    }
    if month == 4 { return 30; }
    if month == 6 { return 30; }
    if month == 9 { return 30; }
    if month == 11 { return 30; }
    return 31;
}

pub fn rtc_datetime_new(y: Int, m: Int, d: Int, h: Int, min: Int, s: Int) -> RtcDateTime {
    return RtcDateTime {
        year: y,
        month: m,
        day: d,
        weekday: 1,
        hours: h,
        minutes: min,
        seconds: s,
        subseconds: 0
    };
}

pub fn rtc_controller_new(initial_time: RtcDateTime) -> RtcController {
    let dummy_alarm: RtcAlarm = RtcAlarm {
        hours: 0,
        minutes: 0,
        seconds: 0,
        mask_hours: true,
        mask_minutes: true,
        mask_seconds: true,
        is_enabled: false
    };
    return RtcController {
        datetime: initial_time,
        alarm_a: dummy_alarm,
        alarm_b: dummy_alarm,
        wakeup_timer_ticks: 0,
        wakeup_enabled: false
    };
}

pub fn rtc_tick_second(rtc: RtcController) -> RtcController {
    let dt0: RtcDateTime = (rtc).datetime;
    let mut sec: Int = (dt0).seconds + 1;
    let mut minv: Int = (dt0).minutes;
    let mut hr: Int = (dt0).hours;
    let mut day: Int = (dt0).day;
    let mut month: Int = (dt0).month;
    let mut year: Int = (dt0).year;
    let mut weekday: Int = (dt0).weekday;

    if sec >= 60 {
        sec = 0;
        minv = minv + 1;
        if minv >= 60 {
            minv = 0;
            hr = hr + 1;
            if hr >= 24 {
                hr = 0;
                day = day + 1;
                weekday = (weekday % 7) + 1;
                let max_days: Int = get_days_in_month(month, year);
                if day > max_days {
                    day = 1;
                    month = month + 1;
                    if month > 12 {
                        month = 1;
                        year = year + 1;
                    }
                }
            }
        }
    }

    return RtcController {
        datetime: RtcDateTime {
            year: year,
            month: month,
            day: day,
            weekday: weekday,
            hours: hr,
            minutes: minv,
            seconds: sec,
            subseconds: (dt0).subseconds
        },
        alarm_a: (rtc).alarm_a,
        alarm_b: (rtc).alarm_b,
        wakeup_timer_ticks: (rtc).wakeup_timer_ticks,
        wakeup_enabled: (rtc).wakeup_enabled
    };
}

pub fn rtc_check_alarm(alarm: RtcAlarm, dt: RtcDateTime) -> Bool {
    if !(alarm).is_enabled {
        return false;
    }
    if !(alarm).mask_seconds {
        if (alarm).seconds != (dt).seconds { return false; }
    }
    if !(alarm).mask_minutes {
        if (alarm).minutes != (dt).minutes { return false; }
    }
    if !(alarm).mask_hours {
        if (alarm).hours != (dt).hours { return false; }
    }
    return true;
}

pub fn rtc_set_alarm_a(rtc: RtcController, h: Int, m: Int, s: Int) -> RtcController {
    return RtcController {
        datetime: (rtc).datetime,
        alarm_a: RtcAlarm {
            hours: h,
            minutes: m,
            seconds: s,
            mask_hours: false,
            mask_minutes: false,
            mask_seconds: false,
            is_enabled: true
        },
        alarm_b: (rtc).alarm_b,
        wakeup_timer_ticks: (rtc).wakeup_timer_ticks,
        wakeup_enabled: (rtc).wakeup_enabled
    };
}
