// # USB Device CDC ACM Driver
//
// Logline: USB Full-Speed/High-Speed CDC Abstract Control Model, line coding, control requests, and bulk endpoints.
//
// Setup: USB device peripheral controller providing virtual COM port serial emulation over USB.
//
// Beats:
//   1. Define USB Device descriptors, CDC ACM functional descriptors, and endpoint structures.
//   2. Manage CDC Line Coding structures (baud rate, stop bits, parity, data bits).
//   3. Handle USB CDC control line states (DTR, RTS) and standard class requests.
//   4. Transmit and receive packets over Bulk IN / Bulk OUT data endpoints.

type UsbCdcLineCoding = struct {
    baud_rate: Int,
    stop_bits: Int,
    parity_type: Int,
    data_bits: Int
};

type UsbCdcDevice = struct {
    device_address: Int,
    is_configured: Bool,
    line_coding: UsbCdcLineCoding,
    dtr_active: Bool,
    rts_active: Bool,
    rx_packet_buffer: List[Int],
    tx_packet_buffer: List[Int],
    max_packet_size: Int,
    last_count: Int,
    last_read: List[Int]
};

pub fn usb_cdc_line_coding_new(baud: Int) -> UsbCdcLineCoding {
    return UsbCdcLineCoding {
        baud_rate: baud,
        stop_bits: 0,
        parity_type: 0,
        data_bits: 8
    };
}

pub fn usb_cdc_device_new() -> UsbCdcDevice {
    let empty_rx: List[Int] = list_new();
    let empty_tx: List[Int] = list_new();
    return UsbCdcDevice {
        device_address: 0,
        is_configured: false,
        line_coding: usb_cdc_line_coding_new(115200),
        dtr_active: false,
        rts_active: false,
        rx_packet_buffer: empty_rx,
        tx_packet_buffer: empty_tx,
        max_packet_size: 64,
        last_count: 0,
        last_read: empty_rx
    };
}

pub fn usb_cdc_set_line_coding(dev: UsbCdcDevice, baud: Int, stop: Int, parity: Int, data: Int) -> UsbCdcDevice {
    return UsbCdcDevice {
        device_address: (dev).device_address,
        is_configured: (dev).is_configured,
        line_coding: UsbCdcLineCoding {
            baud_rate: baud,
            stop_bits: stop % 3,
            parity_type: parity % 5,
            data_bits: data
        },
        dtr_active: (dev).dtr_active,
        rts_active: (dev).rts_active,
        rx_packet_buffer: (dev).rx_packet_buffer,
        tx_packet_buffer: (dev).tx_packet_buffer,
        max_packet_size: (dev).max_packet_size,
        last_count: (dev).last_count,
        last_read: (dev).last_read
    };
}

pub fn usb_cdc_set_control_line_state(dev: UsbCdcDevice, dtr: Bool, rts: Bool) -> UsbCdcDevice {
    return UsbCdcDevice {
        device_address: (dev).device_address,
        is_configured: (dev).is_configured,
        line_coding: (dev).line_coding,
        dtr_active: dtr,
        rts_active: rts,
        rx_packet_buffer: (dev).rx_packet_buffer,
        tx_packet_buffer: (dev).tx_packet_buffer,
        max_packet_size: (dev).max_packet_size,
        last_count: (dev).last_count,
        last_read: (dev).last_read
    };
}

pub fn usb_cdc_queue_tx(dev: UsbCdcDevice, data: List[Int]) -> UsbCdcDevice {
    let len: Int = list_len(data);
    let mut tx: List[Int] = (dev).tx_packet_buffer;
    let mut queued: Int = 0;
    let mut i: Int = 0;
    while i < len {
        let b: Int = list_get(data, i);
        tx = list_push(tx, b % 256);
        queued = queued + 1;
        i = i + 1;
    }
    return UsbCdcDevice {
        device_address: (dev).device_address,
        is_configured: (dev).is_configured,
        line_coding: (dev).line_coding,
        dtr_active: (dev).dtr_active,
        rts_active: (dev).rts_active,
        rx_packet_buffer: (dev).rx_packet_buffer,
        tx_packet_buffer: tx,
        max_packet_size: (dev).max_packet_size,
        last_count: queued,
        last_read: (dev).last_read
    };
}

pub fn usb_cdc_fetch_rx(dev: UsbCdcDevice, max_len: Int) -> UsbCdcDevice {
    let mut out: List[Int] = list_new();
    let cur_len: Int = list_len((dev).rx_packet_buffer);
    let to_take: Int = if max_len < cur_len { max_len } else { cur_len };

    let mut i: Int = 0;
    while i < to_take {
        out = list_push(out, list_get((dev).rx_packet_buffer, i));
        i = i + 1;
    }

    let mut remaining: List[Int] = list_new();
    let mut j: Int = to_take;
    while j < cur_len {
        remaining = list_push(remaining, list_get((dev).rx_packet_buffer, j));
        j = j + 1;
    }
    return UsbCdcDevice {
        device_address: (dev).device_address,
        is_configured: (dev).is_configured,
        line_coding: (dev).line_coding,
        dtr_active: (dev).dtr_active,
        rts_active: (dev).rts_active,
        rx_packet_buffer: remaining,
        tx_packet_buffer: (dev).tx_packet_buffer,
        max_packet_size: (dev).max_packet_size,
        last_count: to_take,
        last_read: out
    };
}

pub fn usb_cdc_dma_receive_packet(dev: UsbCdcDevice, packet: List[Int]) -> UsbCdcDevice {
    let len: Int = list_len(packet);
    let mut rx: List[Int] = (dev).rx_packet_buffer;
    let mut i: Int = 0;
    while i < len {
        rx = list_push(rx, list_get(packet, i) % 256);
        i = i + 1;
    }
    return UsbCdcDevice {
        device_address: (dev).device_address,
        is_configured: (dev).is_configured,
        line_coding: (dev).line_coding,
        dtr_active: (dev).dtr_active,
        rts_active: (dev).rts_active,
        rx_packet_buffer: rx,
        tx_packet_buffer: (dev).tx_packet_buffer,
        max_packet_size: (dev).max_packet_size,
        last_count: len,
        last_read: (dev).last_read
    };
}
