// # UART DMA Ring Buffer Operations
//
// Logline: Circular buffer push/pop/peek, DMA pointer updates, overrun detection, and non-blocking block I/O.
//
// Setup: Pure Int head/tail arithmetic; capacity-1 free space convention.
//
// Beats:
//   1. uart_ring_available / free_space: head vs tail accounting.
//   2. uart_ring_push_byte / pop_byte / peek_byte: per-byte I/O with overrun detection.
//   3. uart_ring_dma_update_head: hardware pointer handover.
//   4. uart_ring_write_bytes / read_bytes / flush: multi-byte block I/O.

import "./uart_dma_ring_types.oo";

fn list_set_element(list_in: List[Int], idx: Int, val: Int) -> List[Int] {
    let mut result: List[Int] = list_new();
    let len: Int = list_len(list_in);
    let mut i: Int = 0;
    while i < len {
        if i == idx {
            result = list_push(result, val);
        } else {
            result = list_push(result, list_get(list_in, i));
        }
        i = i + 1;
    }
    return result;
}

pub fn uart_ring_available(ring: UartRingBuffer) -> Int {
    let h: Int = (ring).head;
    let t: Int = (ring).tail;
    if h >= t {
        return h - t;
    }
    return (ring).capacity - (t - h);
}

pub fn uart_ring_free_space(ring: UartRingBuffer) -> Int {
    return ((ring).capacity - 1) - uart_ring_available(ring);
}

pub fn uart_ring_push_byte(ring: UartRingBuffer, byte: Int) -> UartRingBuffer {
    let next_head: Int = ((ring).head + 1) % (ring).capacity;
    if next_head == (ring).tail {
        return UartRingBuffer {
            config: (ring).config,
            buffer: (ring).buffer,
            capacity: (ring).capacity,
            head: (ring).head,
            tail: (ring).tail,
            overrun_count: (ring).overrun_count + 1,
            framing_errors: (ring).framing_errors,
            dma_enabled: (ring).dma_enabled,
            last_ok: false,
            last_byte: (ring).last_byte,
            last_count: (ring).last_count,
            last_read: (ring).last_read
        };
    }
    return UartRingBuffer {
        config: (ring).config,
        buffer: list_set_element((ring).buffer, (ring).head, byte % 256),
        capacity: (ring).capacity,
        head: next_head,
        tail: (ring).tail,
        overrun_count: (ring).overrun_count,
        framing_errors: (ring).framing_errors,
        dma_enabled: (ring).dma_enabled,
        last_ok: true,
        last_byte: byte % 256,
        last_count: (ring).last_count,
        last_read: (ring).last_read
    };
}

pub fn uart_ring_pop_byte(ring: UartRingBuffer) -> UartRingBuffer {
    if (ring).head == (ring).tail {
        return UartRingBuffer {
            config: (ring).config,
            buffer: (ring).buffer,
            capacity: (ring).capacity,
            head: (ring).head,
            tail: (ring).tail,
            overrun_count: (ring).overrun_count,
            framing_errors: (ring).framing_errors,
            dma_enabled: (ring).dma_enabled,
            last_ok: false,
            last_byte: 0 - 1,
            last_count: (ring).last_count,
            last_read: (ring).last_read
        };
    }
    let byte: Int = list_get((ring).buffer, (ring).tail);
    return UartRingBuffer {
        config: (ring).config,
        buffer: (ring).buffer,
        capacity: (ring).capacity,
        head: (ring).head,
        tail: ((ring).tail + 1) % (ring).capacity,
        overrun_count: (ring).overrun_count,
        framing_errors: (ring).framing_errors,
        dma_enabled: (ring).dma_enabled,
        last_ok: true,
        last_byte: byte,
        last_count: (ring).last_count,
        last_read: (ring).last_read
    };
}

pub fn uart_ring_peek_byte(ring: UartRingBuffer) -> Int {
    if (ring).head == (ring).tail {
        return 0 - 1;
    }
    return list_get((ring).buffer, (ring).tail);
}

pub fn uart_ring_dma_update_head(ring: UartRingBuffer, dma_remaining_bytes: Int) -> UartRingBuffer {
    let new_head: Int = (ring).capacity - dma_remaining_bytes;
    if new_head >= 0 {
        if new_head < (ring).capacity {
            return UartRingBuffer {
                config: (ring).config,
                buffer: (ring).buffer,
                capacity: (ring).capacity,
                head: new_head,
                tail: (ring).tail,
                overrun_count: (ring).overrun_count,
                framing_errors: (ring).framing_errors,
                dma_enabled: (ring).dma_enabled,
                last_ok: true,
                last_byte: (ring).last_byte,
                last_count: (ring).last_count,
                last_read: (ring).last_read
            };
        }
    }
    return ring;
}

pub fn uart_ring_flush(ring: UartRingBuffer) -> UartRingBuffer {
    return UartRingBuffer {
        config: (ring).config,
        buffer: (ring).buffer,
        capacity: (ring).capacity,
        head: 0,
        tail: 0,
        overrun_count: (ring).overrun_count,
        framing_errors: (ring).framing_errors,
        dma_enabled: (ring).dma_enabled,
        last_ok: true,
        last_byte: (ring).last_byte,
        last_count: 0,
        last_read: (ring).last_read
    };
}
