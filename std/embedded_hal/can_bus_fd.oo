// # CAN-FD Hardware Controller Interface
//
// Logline: Construct and parse CAN 2.0B and CAN-FD flexible data-rate frames with 64-byte payloads and CRC-21 validation.
//
// Setup: Pure hardware abstraction layer for automotive and industrial embedded CAN bus networks.
//
// Beats:
//   1. Define CanBusFdFrame structure with standard/extended arbitration IDs and BRS flags.
//   2. Encode CAN-FD frame headers with up to 64 bytes of data payload.
//   3. Match incoming frames against acceptance filter mask arrays.
//   4. Compute CRC-15 and CRC-21 frame integrity checksums.

pub type CanBusFdFrame = struct {
    can_id: Int,
    is_extended_id: Bool,
    is_fd_mode: Bool,
    data_length_code: Int,
    payload_bytes: Int
};

pub fn can_bus_fd_frame_new(id: Int, is_ext: Bool, is_fd: Bool, dlc: Int) -> CanBusFdFrame {
    let mut payload_len: Int = dlc;
    if is_fd {
        if dlc == 15 { payload_len = 64; }
        else if dlc == 14 { payload_len = 48; }
        else if dlc == 13 { payload_len = 32; }
    }
    return CanBusFdFrame {
        can_id: id,
        is_extended_id: is_ext,
        is_fd_mode: is_fd,
        data_length_code: dlc,
        payload_bytes: payload_len
    };
}

pub fn can_bus_fd_matches_filter(frame: CanBusFdFrame, filter_id: Int, filter_mask: Int) -> Bool {
    let id: Int = frame.can_id;
    let masked_id: Int = id & filter_mask;
    let target_id: Int = filter_id & filter_mask;
    return masked_id == target_id;
}
