// # RISC-V CSR Read / Write / Bit Operations
//
// Logline: Dispatch read/write by CSR number, plus atomic set-bits (CSRRS) and clear-bits (CSRRC) loops.
//
// Setup: Hardcoded machine-mode CSR numbers (768 mstatus, 772 mie, 836 mip, 773 mtvec, 833 mepc, 834 mcause, 835 mtval).
//
// Beats:
//   1. riscv_csr_read: pick field by csr_num.
//   2. csr_with_field: private by-value setter for the matched field.
//   3. riscv_csr_write: forward to csr_with_field.
//   4. riscv_csr_set_bits / riscv_csr_clear_bits: 32-bit OR/AND over read value, then write.

import "./riscv_csr_types.oo";

pub fn riscv_csr_read(csr: RiscvCsrState, csr_num: Int) -> Int {
    if csr_num == 768 {
        return (csr).mstatus;
    }
    if csr_num == 772 {
        return (csr).mie;
    }
    if csr_num == 836 {
        return (csr).mip;
    }
    if csr_num == 773 {
        return (csr).mtvec;
    }
    if csr_num == 833 {
        return (csr).mepc;
    }
    if csr_num == 834 {
        return (csr).mcause;
    }
    if csr_num == 835 {
        return (csr).mtval;
    }
    return 0;
}

fn csr_with_field(csr: RiscvCsrState, csr_num: Int, val: Int) -> RiscvCsrState {
    let mut mstatus = (csr).mstatus;
    let mut mie = (csr).mie;
    let mut mip = (csr).mip;
    let mut mtvec = (csr).mtvec;
    let mut mepc = (csr).mepc;
    let mut mcause = (csr).mcause;
    let mut mtval = (csr).mtval;
    if csr_num == 768 {
        mstatus = val;
    } else {
        if csr_num == 772 {
            mie = val;
        } else {
            if csr_num == 836 {
                mip = val;
            } else {
                if csr_num == 773 {
                    mtvec = val;
                } else {
                    if csr_num == 833 {
                        mepc = val;
                    } else {
                        if csr_num == 834 {
                            mcause = val;
                        } else {
                            if csr_num == 835 {
                                mtval = val;
                            }
                        }
                    }
                }
            }
        }
    }
    return RiscvCsrState {
        mstatus: mstatus,
        mie: mie,
        mip: mip,
        mtvec: mtvec,
        mepc: mepc,
        mcause: mcause,
        mtval: mtval,
        pmpcfg0: (csr).pmpcfg0,
        pmpaddr0: (csr).pmpaddr0,
        pmpaddr1: (csr).pmpaddr1,
        privilege_mode: (csr).privilege_mode,
        last_csr: (csr).last_csr,
        last_handler: (csr).last_handler,
    };
}

pub fn riscv_csr_write(csr: RiscvCsrState, csr_num: Int, val: Int) -> RiscvCsrState {
    return csr_with_field(csr, csr_num, val);
}

pub fn riscv_csr_set_bits(csr: RiscvCsrState, csr_num: Int, mask: Int) -> RiscvCsrState {
    let old_val: Int = riscv_csr_read(csr, csr_num);
    let mut new_val: Int = 0;
    let mut m: Int = 1;
    let mut bit: Int = 0;
    while bit < 32 {
        let bit_old: Int = (old_val / m) % 2;
        let bit_mask: Int = (mask / m) % 2;
        if bit_old == 1 {
            new_val = new_val + m;
        } else {
            if bit_mask == 1 {
                new_val = new_val + m;
            }
        }
        m = m * 2;
        bit = bit + 1;
    }
    let written: RiscvCsrState = riscv_csr_write(csr, csr_num, new_val);
    return RiscvCsrState {
        mstatus: (written).mstatus,
        mie: (written).mie,
        mip: (written).mip,
        mtvec: (written).mtvec,
        mepc: (written).mepc,
        mcause: (written).mcause,
        mtval: (written).mtval,
        pmpcfg0: (written).pmpcfg0,
        pmpaddr0: (written).pmpaddr0,
        pmpaddr1: (written).pmpaddr1,
        privilege_mode: (written).privilege_mode,
        last_csr: old_val,
        last_handler: (written).last_handler,
    };
}

pub fn riscv_csr_clear_bits(csr: RiscvCsrState, csr_num: Int, mask: Int) -> RiscvCsrState {
    let old_val: Int = riscv_csr_read(csr, csr_num);
    let mut new_val: Int = 0;
    let mut m: Int = 1;
    let mut bit: Int = 0;
    while bit < 32 {
        let bit_old: Int = (old_val / m) % 2;
        let bit_mask: Int = (mask / m) % 2;
        if bit_old == 1 {
            if bit_mask == 0 {
                new_val = new_val + m;
            }
        }
        m = m * 2;
        bit = bit + 1;
    }
    let written: RiscvCsrState = riscv_csr_write(csr, csr_num, new_val);
    return RiscvCsrState {
        mstatus: (written).mstatus,
        mie: (written).mie,
        mip: (written).mip,
        mtvec: (written).mtvec,
        mepc: (written).mepc,
        mcause: (written).mcause,
        mtval: (written).mtval,
        pmpcfg0: (written).pmpcfg0,
        pmpaddr0: (written).pmpaddr0,
        pmpaddr1: (written).pmpaddr1,
        privilege_mode: (written).privilege_mode,
        last_csr: old_val,
        last_handler: (written).last_handler,
    };
}
