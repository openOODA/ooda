// # RTOS Task Control Block Lifecycle Transitions
//
// Logline: Delay, tick decrement, suspend, resume, and terminate state transitions for the TCB.
//
// Setup: Imports the TCB door for the RtosTaskState type and base state set helper.
//
// Beats:
//   1. Apply delay to put a task in the blocked state with a tick counter.
//   2. Decrement the delay counter on each tick and restore ready state at zero.
//   3. Suspend, resume, and terminate the task through the shared set-state helper.

import "./rtos_task_tcb.oo";

pub fn rtos_tcb_delay(task: RtosTaskState, ticks: Int) -> RtosTaskState {
    if ticks > 0 {
        return RtosTaskState {
            task_id: (task).task_id,
            name: (task).name,
            priority: (task).priority,
            base_priority: (task).base_priority,
            state: 2,
            stack_base: (task).stack_base,
            stack_size: (task).stack_size,
            stack_pointer: (task).stack_pointer,
            min_free_stack: (task).min_free_stack,
            delay_ticks: ticks,
            runtime_ticks: (task).runtime_ticks,
            last_ok: true
        };
    }
    return task;
}

pub fn rtos_tcb_tick_delay(task: RtosTaskState) -> RtosTaskState {
    if (task).state == 2 {
        if (task).delay_ticks > 0 {
            let next: Int = (task).delay_ticks - 1;
            if next == 0 {
                return RtosTaskState {
                    task_id: (task).task_id,
                    name: (task).name,
                    priority: (task).priority,
                    base_priority: (task).base_priority,
                    state: 0,
                    stack_base: (task).stack_base,
                    stack_size: (task).stack_size,
                    stack_pointer: (task).stack_pointer,
                    min_free_stack: (task).min_free_stack,
                    delay_ticks: 0,
                    runtime_ticks: (task).runtime_ticks,
                    last_ok: true
                };
            }
            return RtosTaskState {
                task_id: (task).task_id,
                name: (task).name,
                priority: (task).priority,
                base_priority: (task).base_priority,
                state: 2,
                stack_base: (task).stack_base,
                stack_size: (task).stack_size,
                stack_pointer: (task).stack_pointer,
                min_free_stack: (task).min_free_stack,
                delay_ticks: next,
                runtime_ticks: (task).runtime_ticks,
                last_ok: false
            };
        }
    }
    return RtosTaskState {
        task_id: (task).task_id,
        name: (task).name,
        priority: (task).priority,
        base_priority: (task).base_priority,
        state: (task).state,
        stack_base: (task).stack_base,
        stack_size: (task).stack_size,
        stack_pointer: (task).stack_pointer,
        min_free_stack: (task).min_free_stack,
        delay_ticks: (task).delay_ticks,
        runtime_ticks: (task).runtime_ticks,
        last_ok: false
    };
}

pub fn rtos_tcb_suspend(task: RtosTaskState) -> RtosTaskState {
    return rtos_tcb_set_state(task, 3);
}

pub fn rtos_tcb_resume(task: RtosTaskState) -> RtosTaskState {
    if (task).state == 3 {
        return rtos_tcb_set_state(task, 0);
    }
    return task;
}

pub fn rtos_tcb_terminate(task: RtosTaskState) -> RtosTaskState {
    return rtos_tcb_set_state(task, 4);
}
