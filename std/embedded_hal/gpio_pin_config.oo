// # GPIO Pin Configuration & Control
//
// Logline: Hardware GPIO port and pin modes, pull-up/down resistors, drive speed, and digital I/O operations.
//
// Setup: Register models for MODER, OTYPER, OSPEEDR, PUPDR, IDR, ODR, BSRR, and EXTI triggers.
//
// Beats:
//   1. Define GPIO port identifiers, pin numbers, mode enums, and electrical descriptors.
//   2. Configure pin modes (Input, Output, Alternate Function, Analog) and pull resistors.
//   3. Implement atomic pin set, clear, toggle, and digital read logic via bit-set/reset registers.
//   4. Configure external interrupt (EXTI) edge detection modes for pin state transitions.

type GpioPin = struct {
    port: Int,
    pin_number: Int,
    mode: Int,
    output_type: Int,
    speed: Int,
    pull: Int,
    alternate_func: Int,
    output_level: Bool,
    input_level: Bool,
    exti_trigger: Int,
    exti_enabled: Bool,
    last_exti_fired: Bool,
};

pub fn gpio_pin_new(port: Int, pin: Int) -> GpioPin {
    let valid_pin: Int = if pin < 0 { 0 } else { if pin > 15 { 15 } else { pin } };
    return GpioPin {
        port: port,
        pin_number: valid_pin,
        mode: 0,
        output_type: 0,
        speed: 0,
        pull: 0,
        alternate_func: 0,
        output_level: false,
        input_level: false,
        exti_trigger: 0,
        exti_enabled: false,
        last_exti_fired: false,
    };
}

pub fn gpio_configure_output(pin: GpioPin, out_type: Int, speed: Int) -> GpioPin {
    return GpioPin {
        port: (pin).port,
        pin_number: (pin).pin_number,
        mode: 1,
        output_type: out_type % 2,
        speed: speed % 4,
        pull: (pin).pull,
        alternate_func: (pin).alternate_func,
        output_level: (pin).output_level,
        input_level: (pin).input_level,
        exti_trigger: (pin).exti_trigger,
        exti_enabled: (pin).exti_enabled,
        last_exti_fired: (pin).last_exti_fired,
    };
}

pub fn gpio_configure_input(pin: GpioPin, pull: Int) -> GpioPin {
    let mut in_level = (pin).input_level;
    if pull == 1 {
        in_level = true;
    } else {
        if pull == 2 {
            in_level = false;
        }
    }
    return GpioPin {
        port: (pin).port,
        pin_number: (pin).pin_number,
        mode: 0,
        output_type: (pin).output_type,
        speed: (pin).speed,
        pull: pull % 3,
        alternate_func: (pin).alternate_func,
        output_level: (pin).output_level,
        input_level: in_level,
        exti_trigger: (pin).exti_trigger,
        exti_enabled: (pin).exti_enabled,
        last_exti_fired: (pin).last_exti_fired,
    };
}

pub fn gpio_configure_af(pin: GpioPin, af_num: Int, out_type: Int, speed: Int) -> GpioPin {
    return GpioPin {
        port: (pin).port,
        pin_number: (pin).pin_number,
        mode: 2,
        output_type: out_type % 2,
        speed: speed % 4,
        pull: (pin).pull,
        alternate_func: af_num % 16,
        output_level: (pin).output_level,
        input_level: (pin).input_level,
        exti_trigger: (pin).exti_trigger,
        exti_enabled: (pin).exti_enabled,
        last_exti_fired: (pin).last_exti_fired,
    };
}

pub fn gpio_configure_analog(pin: GpioPin) -> GpioPin {
    return GpioPin {
        port: (pin).port,
        pin_number: (pin).pin_number,
        mode: 3,
        output_type: (pin).output_type,
        speed: (pin).speed,
        pull: 0,
        alternate_func: (pin).alternate_func,
        output_level: (pin).output_level,
        input_level: (pin).input_level,
        exti_trigger: (pin).exti_trigger,
        exti_enabled: (pin).exti_enabled,
        last_exti_fired: (pin).last_exti_fired,
    };
}

pub fn gpio_write(pin: GpioPin, state: Bool) -> GpioPin {
    return GpioPin {
        port: (pin).port,
        pin_number: (pin).pin_number,
        mode: (pin).mode,
        output_type: (pin).output_type,
        speed: (pin).speed,
        pull: (pin).pull,
        alternate_func: (pin).alternate_func,
        output_level: state,
        input_level: (pin).input_level,
        exti_trigger: (pin).exti_trigger,
        exti_enabled: (pin).exti_enabled,
        last_exti_fired: (pin).last_exti_fired,
    };
}

pub fn gpio_set(pin: GpioPin) -> GpioPin {
    return gpio_write(pin, true);
}

pub fn gpio_reset(pin: GpioPin) -> GpioPin {
    return gpio_write(pin, false);
}

pub fn gpio_toggle(pin: GpioPin) -> GpioPin {
    return gpio_write(pin, !((pin).output_level));
}

pub fn gpio_read_input(pin: GpioPin) -> Bool {
    return (pin).input_level;
}

pub fn gpio_read_output(pin: GpioPin) -> Bool {
    return (pin).output_level;
}

pub fn gpio_set_simulated_input(pin: GpioPin, state: Bool) -> GpioPin {
    let old_state: Bool = (pin).input_level;
    let mut fired: Bool = false;

    if (pin).exti_enabled {
        if (pin).exti_trigger == 1 {
            if !old_state {
                if state { fired = true; }
            }
        } else {
            if (pin).exti_trigger == 2 {
                if old_state {
                    if !state { fired = true; }
                }
            } else {
                if (pin).exti_trigger == 3 {
                    if old_state != state { fired = true; }
                }
            }
        }
    }

    return GpioPin {
        port: (pin).port,
        pin_number: (pin).pin_number,
        mode: (pin).mode,
        output_type: (pin).output_type,
        speed: (pin).speed,
        pull: (pin).pull,
        alternate_func: (pin).alternate_func,
        output_level: (pin).output_level,
        input_level: state,
        exti_trigger: (pin).exti_trigger,
        exti_enabled: (pin).exti_enabled,
        last_exti_fired: fired,
    };
}

pub fn gpio_enable_exti(pin: GpioPin, trigger_mode: Int) -> GpioPin {
    return GpioPin {
        port: (pin).port,
        pin_number: (pin).pin_number,
        mode: (pin).mode,
        output_type: (pin).output_type,
        speed: (pin).speed,
        pull: (pin).pull,
        alternate_func: (pin).alternate_func,
        output_level: (pin).output_level,
        input_level: (pin).input_level,
        exti_trigger: trigger_mode % 4,
        exti_enabled: true,
        last_exti_fired: (pin).last_exti_fired,
    };
}

pub fn gpio_disable_exti(pin: GpioPin) -> GpioPin {
    return GpioPin {
        port: (pin).port,
        pin_number: (pin).pin_number,
        mode: (pin).mode,
        output_type: (pin).output_type,
        speed: (pin).speed,
        pull: (pin).pull,
        alternate_func: (pin).alternate_func,
        output_level: (pin).output_level,
        input_level: (pin).input_level,
        exti_trigger: 0,
        exti_enabled: false,
        last_exti_fired: (pin).last_exti_fired,
    };
}
