// # RISC-V CSR Physical Memory Protection
//
// Logline: Configure PMP entry 0/1 address and packed read/write/exec/lock attribute byte in pmpcfg0.
//
// Setup: Imports riscv_csr_types. Attribute bits: R=1, W=2, X=4, L=128.
//
// Beats:
//   1. riscv_pmp_configure_entry: write pmpaddr0/1 by entry_idx, pack R/W/X/L into pmpcfg0.

import "./riscv_csr_types.oo";

pub fn riscv_pmp_configure_entry(
    csr: RiscvCsrState,
    entry_idx: Int,
    addr: Int,
    read_allow: Bool,
    write_allow: Bool,
    exec_allow: Bool,
    lock: Bool
) -> RiscvCsrState {
    let mut pmpaddr0 = (csr).pmpaddr0;
    let mut pmpaddr1 = (csr).pmpaddr1;
    if entry_idx == 0 {
        pmpaddr0 = addr;
    } else {
        if entry_idx == 1 {
            pmpaddr1 = addr;
        }
    }
    let mut attr: Int = 0;
    if read_allow { attr = attr + 1; }
    if write_allow { attr = attr + 2; }
    if exec_allow { attr = attr + 4; }
    if lock { attr = attr + 128; }

    return RiscvCsrState {
        mstatus: (csr).mstatus,
        mie: (csr).mie,
        mip: (csr).mip,
        mtvec: (csr).mtvec,
        mepc: (csr).mepc,
        mcause: (csr).mcause,
        mtval: (csr).mtval,
        pmpcfg0: attr,
        pmpaddr0: pmpaddr0,
        pmpaddr1: pmpaddr1,
        privilege_mode: (csr).privilege_mode,
        last_csr: (csr).last_csr,
        last_handler: (csr).last_handler,
    };
}
