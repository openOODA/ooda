// # Bare-Metal MMU Page Table & Hardware Capability Token Mapper
//
// Logline: Hardware capability abstraction mapping MMU page tables, interrupt vectors, and MMIO peripherals to unforgeable tokens.
//
// Setup: Standalone embedded HAL framework providing zero-ambient-authority hardware primitives for microkernel construction.
//
// Beats:
//   1. Define PageTableEntry, MmuDirectory, InterruptVectorEntry, and UartPort structures.
//   2. Enforce explicit capability validation on MMU page mapping and interrupt registrations.
//   3. Provide deterministic page flag bitmask calculations (Read, Write, Execute, Supervisor).

pub type PageTableEntry = struct {
    physical_frame_addr: Int,
    flags_bitmask: Int, // bit 0: Present, bit 1: Writable, bit 2: User, bit 3: Executable
    is_valid: Bool
};

pub type MmuDirectory = struct {
    root_table_id: Int,
    entries: List[PageTableEntry],
    entry_count: Int,
    total_mapped_bytes: Int
};

pub type InterruptVectorEntry = struct {
    irq_number: Int,
    handler_id: Int,
    priority_level: Int,
    is_enabled: Bool
};

pub type UartPortDescriptor = struct {
    base_mmio_addr: Int,
    baud_rate: Int,
    tx_fifo_depth: Int,
    rx_fifo_depth: Int
};

pub fn mmu_directory_new(root_id: Int) -> MmuDirectory {
    let empty_entries: List[PageTableEntry] = list_new();
    return MmuDirectory {
        root_table_id: root_id,
        entries: empty_entries,
        entry_count: 0,
        total_mapped_bytes: 0
    };
}

pub fn mmu_page_entry_new(phys_addr: Int, is_writable: Bool, is_exec: Bool) -> PageTableEntry {
    let mut flags: Int = 1; // Bit 0: Present
    if is_writable {
        flags = flags | 2;  // Bit 1: Writable
    }
    if is_exec {
        flags = flags | 8;  // Bit 3: Executable (NX bit clear)
    }
    return PageTableEntry {
        physical_frame_addr: phys_addr,
        flags_bitmask: flags,
        is_valid: true
    };
}

pub fn mmu_map_frame(dir: &mut MmuDirectory, phys_addr: Int, is_writable: Bool, is_exec: Bool) -> Bool {
    let pte: PageTableEntry = mmu_page_entry_new(phys_addr, is_writable, is_exec);
    (dir).entries = list_push((dir).entries, pte);
    (dir).entry_count = (dir).entry_count + 1;
    (dir).total_mapped_bytes = (dir).total_mapped_bytes + 4096; // 4 KiB standard page
    return true;
}

pub fn interrupt_vector_entry_new(irq: Int, handler: Int, priority: Int) -> InterruptVectorEntry {
    return InterruptVectorEntry {
        irq_number: irq,
        handler_id: handler,
        priority_level: priority,
        is_enabled: true
    };
}

pub fn uart_port_descriptor_new(base_addr: Int, baud: Int) -> UartPortDescriptor {
    return UartPortDescriptor {
        base_mmio_addr: base_addr,
        baud_rate: baud,
        tx_fifo_depth: 64,
        rx_fifo_depth: 64
    };
}
