// # UART Peripheral Config and Ring Buffer State Types
//
// Logline: UartConfig baud rate and frame parameters; UartRingBuffer head/tail with overrun and DMA tracking.
//
// Setup: High-throughput non-blocking UART serial transceiver with DMA transfer descriptors.
//
// Beats:
//   1. UartConfig: uart_id, baud_rate, data/stop bits, parity, flow control.
//   2. UartRingBuffer: config, capacity, head/tail, overrun_count, framing_errors, dma_enabled.
//   3. State tracking: last_ok, last_byte, last_count, last_read.

type UartConfig = struct {
    uart_id: Int,
    baud_rate: Int,
    data_bits: Int,
    stop_bits: Int,
    parity: Int,
    flow_control: Int,
};

type UartRingBuffer = struct {
    config: UartConfig,
    buffer: List[Int],
    capacity: Int,
    head: Int,
    tail: Int,
    overrun_count: Int,
    framing_errors: Int,
    dma_enabled: Bool,
    last_ok: Bool,
    last_byte: Int,
    last_count: Int,
    last_read: List[Int],
};

pub fn uart_config_new(id: Int, baud: Int) -> UartConfig {
    return UartConfig {
        uart_id: id,
        baud_rate: baud,
        data_bits: 8,
        stop_bits: 1,
        parity: 0,
        flow_control: 0,
    };
}

pub fn uart_ring_buffer_new(config: UartConfig, capacity: Int) -> UartRingBuffer {
    let mut initial_buf: List[Int] = list_new();
    let cap: Int = if capacity < 4 { 4 } else { capacity };
    let mut i: Int = 0;
    while i < cap {
        initial_buf = list_push(initial_buf, 0);
        i = i + 1;
    }
    let empty: List[Int] = list_new();
    return UartRingBuffer {
        config: config,
        buffer: initial_buf,
        capacity: cap,
        head: 0,
        tail: 0,
        overrun_count: 0,
        framing_errors: 0,
        dma_enabled: false,
        last_ok: true,
        last_byte: 0,
        last_count: 0,
        last_read: empty,
    };
}
