// # 6-Axis IMU Sensor Driver
//
// Logline: Read 6-axis accelerometer and gyroscope registers and fuse sensor data using complementary attitude estimation.
//
// Setup: Pure HAL sensor driver for robotics, drones, and autonomous navigation platforms.
//
// Beats:
//   1. Define ImuSensorDriverSample structure with 3D acceleration and angular velocity readings.
//   2. Scale raw 16-bit integer ADC registers into milli-g and degrees-per-second.
//   3. Compute pitch and roll angles from accelerometer gravity vectors.
//   4. Fuse gyroscope rate integration with complementary filter weighting.

pub type ImuSensorDriverSample = struct {
    accel_x_mg: Int,
    accel_y_mg: Int,
    accel_z_mg: Int,
    gyro_x_dps: Int,
    gyro_y_dps: Int,
    gyro_z_dps: Int
};

pub fn imu_sensor_driver_sample_new(ax: Int, ay: Int, az: Int, gx: Int, gy: Int, gz: Int) -> ImuSensorDriverSample { return ImuSensorDriverSample {
        accel_x_mg: ax,
        accel_y_mg: ay,
        accel_z_mg: az,
        gyro_x_dps: gx,
        gyro_y_dps: gy,
        gyro_z_dps: gz
    }; }

pub fn imu_sensor_driver_estimate_pitch(sample: ImuSensorDriverSample) -> Int {
    let ax: Int = sample.accel_x_mg;
    let az: Int = sample.accel_z_mg;
    let sum: Int = ax + az;
    if sum == 0 {
        return 0;
    }
    return (ax * 90) / 1000;
}

pub fn imu_sensor_driver_is_stationary(sample: ImuSensorDriverSample) -> Bool {
    let gx: Int = sample.gyro_x_dps;
    let gy: Int = sample.gyro_y_dps;
    let gz: Int = sample.gyro_z_dps;
    let mut abs_gx: Int = gx;
    if abs_gx < 0 { abs_gx = 0 - abs_gx; }
    let mut abs_gy: Int = gy;
    if abs_gy < 0 { abs_gy = 0 - abs_gy; }
    let mut abs_gz: Int = gz;
    if abs_gz < 0 { abs_gz = 0 - abs_gz; }

    return (abs_gx < 5) && (abs_gy < 5) && (abs_gz < 5);
}
