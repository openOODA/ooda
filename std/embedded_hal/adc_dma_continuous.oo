// # ADC Continuous DMA Sampler
//
// Logline: Analog-to-Digital Converter sequencer scan mode, resolution selection, DMA circular capture, and mV conversion.
//
// Setup: Multi-channel analog acquisition pipeline with hardware oversampling and calibration.
//
// Beats:
//   1. Define ADC channel parameters, sequencer rank configurations, and resolution bits.
//   2. Configure sampling times, VREF reference voltage (mV), and DMA transfer targets.
//   3. Convert raw digital quantization codes into calibrated millivolts.
//   4. Apply hardware oversampling accumulation and multi-sample digital filtering.

type AdcChannelConfig = struct {
    channel_id: Int,
    sampling_cycles: Int,
    rank: Int,
    gain_scale: Float,
    offset_mv: Int
};

type AdcController = struct {
    adc_id: Int,
    resolution_bits: Int,
    vref_mv: Int,
    channels: List[AdcChannelConfig],
    dma_buffer: List[Int],
    oversample_ratio: Int,
    is_scanning: Bool
};

pub fn adc_channel_config_new(ch_id: Int, rank: Int) -> AdcChannelConfig {
    return AdcChannelConfig {
        channel_id: ch_id,
        sampling_cycles: 56,
        rank: rank,
        gain_scale: 1.0,
        offset_mv: 0
    };
}

pub fn adc_controller_new(adc_id: Int, resolution_bits: Int, vref_mv: Int) -> AdcController {
    let empty_chans: List[AdcChannelConfig] = list_new();
    let empty_dma: List[Int] = list_new();
    return AdcController {
        adc_id: adc_id,
        resolution_bits: resolution_bits,
        vref_mv: vref_mv,
        channels: empty_chans,
        dma_buffer: empty_dma,
        oversample_ratio: 1,
        is_scanning: false
    };
}

pub fn adc_add_channel(adc: AdcController, ch: AdcChannelConfig) -> AdcController {
    return AdcController {
        adc_id: (adc).adc_id,
        resolution_bits: (adc).resolution_bits,
        vref_mv: (adc).vref_mv,
        channels: list_push((adc).channels, ch),
        dma_buffer: (adc).dma_buffer,
        oversample_ratio: (adc).oversample_ratio,
        is_scanning: (adc).is_scanning
    };
}

pub fn adc_raw_to_millivolts(adc: AdcController, raw_count: Int) -> Int {
    let mut max_count: Int = 1;
    let mut b: Int = 0;
    while b < (adc).resolution_bits {
        max_count = max_count * 2;
        b = b + 1;
    }
    max_count = max_count - 1;
    if max_count <= 0 {
        return 0;
    }
    let mv_calc: Int = (raw_count * (adc).vref_mv) / max_count;
    return mv_calc;
}

pub fn adc_calibrated_millivolts(adc: AdcController, ch_idx: Int, raw_count: Int) -> Float {
    let raw_mv: Int = adc_raw_to_millivolts(adc, raw_count);
    if ch_idx < list_len((adc).channels) {
        let ch: AdcChannelConfig = list_get((adc).channels, ch_idx);
        let calibrated: Float = ((raw_mv * 1.0) * (ch).gain_scale) + ((ch).offset_mv * 1.0);
        return calibrated;
    }
    return raw_mv * 1.0;
}

pub fn adc_dma_ingest_samples(adc: AdcController, samples: List[Int]) -> AdcController {
    return AdcController {
        adc_id: (adc).adc_id,
        resolution_bits: (adc).resolution_bits,
        vref_mv: (adc).vref_mv,
        channels: (adc).channels,
        dma_buffer: samples,
        oversample_ratio: (adc).oversample_ratio,
        is_scanning: (adc).is_scanning
    };
}

pub fn adc_calculate_oversampled_average(samples: List[Int]) -> Int {
    let len: Int = list_len(samples);
    if len == 0 {
        return 0;
    }
    let mut sum: Int = 0;
    let mut i: Int = 0;
    while i < len {
        sum = sum + list_get(samples, i);
        i = i + 1;
    }
    return sum / len;
}

pub fn adc_start_continuous(adc: AdcController) -> AdcController {
    return AdcController {
        adc_id: (adc).adc_id,
        resolution_bits: (adc).resolution_bits,
        vref_mv: (adc).vref_mv,
        channels: (adc).channels,
        dma_buffer: (adc).dma_buffer,
        oversample_ratio: (adc).oversample_ratio,
        is_scanning: true
    };
}

pub fn adc_stop_continuous(adc: AdcController) -> AdcController {
    return AdcController {
        adc_id: (adc).adc_id,
        resolution_bits: (adc).resolution_bits,
        vref_mv: (adc).vref_mv,
        channels: (adc).channels,
        dma_buffer: (adc).dma_buffer,
        oversample_ratio: (adc).oversample_ratio,
        is_scanning: false
    };
}
