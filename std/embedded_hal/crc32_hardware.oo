// # Hardware CRC-32 Engine
//
// Logline: Hardware-accelerated CRC-32 computation, IEEE 802.3 / MPEG-2 polynomials, reflection options, and seed registers.
//
// Setup: Peripheral CRC engine model for firmware integrity checking and packet framing.
//
// Beats:
//   1. Define Hardware CRC engine configuration, polynomials, seed initialization, and reflection.
//   2. Implement 8-bit byte-level accumulation with polynomial division.
//   3. Implement 32-bit word accumulation matching MCU hardware CRC peripherals.
//   4. Compute block checksums and verify integrity against expected signature tokens.

type Crc32Engine = struct {
    polynomial: Int,
    init_seed: Int,
    current_crc: Int,
    reflect_input: Bool,
    reflect_output: Bool,
    xor_output: Int,
};

pub fn crc32_engine_new_ieee() -> Crc32Engine {
    return Crc32Engine {
        polynomial: 79764919,
        init_seed: 4294967295,
        current_crc: 4294967295,
        reflect_input: false,
        reflect_output: false,
        xor_output: 4294967295,
    };
}

pub fn crc32_engine_new_mpeg2() -> Crc32Engine {
    return Crc32Engine {
        polynomial: 79764919,
        init_seed: 4294967295,
        current_crc: 4294967295,
        reflect_input: false,
        reflect_output: false,
        xor_output: 0,
    };
}

pub fn crc32_reset(engine: Crc32Engine) -> Crc32Engine {
    return Crc32Engine {
        polynomial: (engine).polynomial,
        init_seed: (engine).init_seed,
        current_crc: (engine).init_seed,
        reflect_input: (engine).reflect_input,
        reflect_output: (engine).reflect_output,
        xor_output: (engine).xor_output,
    };
}

fn reverse_byte(b: Int) -> Int {
    let mut out: Int = 0;
    let mut m_in: Int = 1;
    let mut m_out: Int = 128;
    let mut i: Int = 0;
    while i < 8 {
        if (b / m_in) % 2 == 1 {
            out = out + m_out;
        }
        m_in = m_in * 2;
        m_out = m_out / 2;
        i = i + 1;
    }
    return out;
}

pub fn crc32_reverse_byte(b: Int) -> Int {
    return reverse_byte(b);
}

pub fn crc32_accumulate_byte(engine: Crc32Engine, byte_val: Int) -> Crc32Engine {
    let mut b: Int = byte_val % 256;
    if (engine).reflect_input {
        b = reverse_byte(b);
    }

    let mut crc: Int = (engine).current_crc;
    let top_byte: Int = (crc / 16777216) % 256;
    let xor_byte: Int = top_byte + b;
    crc = ((crc % 16777216) * 256) + (xor_byte % 256);

    let mut bit: Int = 0;
    while bit < 8 {
        let msb: Int = (crc / 2147483648) % 2;
        crc = (crc * 2) % 4294967296;
        if msb == 1 {
            crc = (crc + (engine).polynomial) % 4294967296;
        }
        bit = bit + 1;
    }

    return Crc32Engine {
        polynomial: (engine).polynomial,
        init_seed: (engine).init_seed,
        current_crc: crc,
        reflect_input: (engine).reflect_input,
        reflect_output: (engine).reflect_output,
        xor_output: (engine).xor_output,
    };
}

pub fn crc32_accumulate_block(engine: Crc32Engine, data: List[Int]) -> Crc32Engine {
    let len: Int = list_len(data);
    let mut acc: Crc32Engine = engine;
    let mut i: Int = 0;
    while i < len {
        let b: Int = list_get(data, i);
        acc = crc32_accumulate_byte(acc, b);
        i = i + 1;
    }
    return acc;
}

pub fn crc32_finalize(engine: Crc32Engine) -> Int {
    let mut crc: Int = (engine).current_crc;
    if (engine).xor_output != 0 {
        crc = (crc + (engine).xor_output) % 4294967296;
    }
    return crc;
}
