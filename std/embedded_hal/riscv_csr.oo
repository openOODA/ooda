// # RISC-V CSR Architecture & Trap State
//
// Logline: Machine-mode Control and Status Register bit manipulation, trap handling context, and PMP memory protection.
//
// Setup: Register models for MSTATUS, MIE, MIP, MTVEC, MEPC, MCAUSE, MTVAL, and PMP configuration.
//
// Beats:
//   1. Define machine-mode CSR structures, privilege levels, and bitmask constants.
//   2. Implement CSR read/write, bit-set (CSRRS), and bit-clear (CSRRC) operations.
//   3. Handle trap dispatching, exception cause decoding, and MRET state restoration.
//   4. Configure Physical Memory Protection (PMP) address and permission attributes.

type RiscvCsrState = struct {
    mstatus: Int,
    mie: Int,
    mip: Int,
    mtvec: Int,
    mepc: Int,
    mcause: Int,
    mtval: Int,
    pmpcfg0: Int,
    pmpaddr0: Int,
    pmpaddr1: Int,
    privilege_mode: Int,
    last_csr: Int,
    last_handler: Int,
};

pub fn riscv_csr_init() -> RiscvCsrState {
    return RiscvCsrState {
        mstatus: 0,
        mie: 0,
        mip: 0,
        mtvec: 0,
        mepc: 0,
        mcause: 0,
        mtval: 0,
        pmpcfg0: 0,
        pmpaddr0: 0,
        pmpaddr1: 0,
        privilege_mode: 3,
        last_csr: 0,
        last_handler: 0,
    };
}

pub fn riscv_csr_read(csr: RiscvCsrState, csr_num: Int) -> Int {
    if csr_num == 768 {
        return (csr).mstatus;
    }
    if csr_num == 772 {
        return (csr).mie;
    }
    if csr_num == 836 {
        return (csr).mip;
    }
    if csr_num == 773 {
        return (csr).mtvec;
    }
    if csr_num == 833 {
        return (csr).mepc;
    }
    if csr_num == 834 {
        return (csr).mcause;
    }
    if csr_num == 835 {
        return (csr).mtval;
    }
    return 0;
}

fn csr_with_field(csr: RiscvCsrState, csr_num: Int, val: Int) -> RiscvCsrState {
    let mut mstatus = (csr).mstatus;
    let mut mie = (csr).mie;
    let mut mip = (csr).mip;
    let mut mtvec = (csr).mtvec;
    let mut mepc = (csr).mepc;
    let mut mcause = (csr).mcause;
    let mut mtval = (csr).mtval;
    if csr_num == 768 {
        mstatus = val;
    } else {
        if csr_num == 772 {
            mie = val;
        } else {
            if csr_num == 836 {
                mip = val;
            } else {
                if csr_num == 773 {
                    mtvec = val;
                } else {
                    if csr_num == 833 {
                        mepc = val;
                    } else {
                        if csr_num == 834 {
                            mcause = val;
                        } else {
                            if csr_num == 835 {
                                mtval = val;
                            }
                        }
                    }
                }
            }
        }
    }
    return RiscvCsrState {
        mstatus: mstatus,
        mie: mie,
        mip: mip,
        mtvec: mtvec,
        mepc: mepc,
        mcause: mcause,
        mtval: mtval,
        pmpcfg0: (csr).pmpcfg0,
        pmpaddr0: (csr).pmpaddr0,
        pmpaddr1: (csr).pmpaddr1,
        privilege_mode: (csr).privilege_mode,
        last_csr: (csr).last_csr,
        last_handler: (csr).last_handler,
    };
}

pub fn riscv_csr_write(csr: RiscvCsrState, csr_num: Int, val: Int) -> RiscvCsrState {
    return csr_with_field(csr, csr_num, val);
}

pub fn riscv_csr_set_bits(csr: RiscvCsrState, csr_num: Int, mask: Int) -> RiscvCsrState {
    let old_val: Int = riscv_csr_read(csr, csr_num);
    let mut new_val: Int = 0;
    let mut m: Int = 1;
    let mut bit: Int = 0;
    while bit < 32 {
        let bit_old: Int = (old_val / m) % 2;
        let bit_mask: Int = (mask / m) % 2;
        if bit_old == 1 {
            new_val = new_val + m;
        } else {
            if bit_mask == 1 {
                new_val = new_val + m;
            }
        }
        m = m * 2;
        bit = bit + 1;
    }
    let written: RiscvCsrState = riscv_csr_write(csr, csr_num, new_val);
    return RiscvCsrState {
        mstatus: (written).mstatus,
        mie: (written).mie,
        mip: (written).mip,
        mtvec: (written).mtvec,
        mepc: (written).mepc,
        mcause: (written).mcause,
        mtval: (written).mtval,
        pmpcfg0: (written).pmpcfg0,
        pmpaddr0: (written).pmpaddr0,
        pmpaddr1: (written).pmpaddr1,
        privilege_mode: (written).privilege_mode,
        last_csr: old_val,
        last_handler: (written).last_handler,
    };
}

pub fn riscv_csr_clear_bits(csr: RiscvCsrState, csr_num: Int, mask: Int) -> RiscvCsrState {
    let old_val: Int = riscv_csr_read(csr, csr_num);
    let mut new_val: Int = 0;
    let mut m: Int = 1;
    let mut bit: Int = 0;
    while bit < 32 {
        let bit_old: Int = (old_val / m) % 2;
        let bit_mask: Int = (mask / m) % 2;
        if bit_old == 1 {
            if bit_mask == 0 {
                new_val = new_val + m;
            }
        }
        m = m * 2;
        bit = bit + 1;
    }
    let written: RiscvCsrState = riscv_csr_write(csr, csr_num, new_val);
    return RiscvCsrState {
        mstatus: (written).mstatus,
        mie: (written).mie,
        mip: (written).mip,
        mtvec: (written).mtvec,
        mepc: (written).mepc,
        mcause: (written).mcause,
        mtval: (written).mtval,
        pmpcfg0: (written).pmpcfg0,
        pmpaddr0: (written).pmpaddr0,
        pmpaddr1: (written).pmpaddr1,
        privilege_mode: (written).privilege_mode,
        last_csr: old_val,
        last_handler: (written).last_handler,
    };
}

pub fn riscv_enable_global_interrupts(csr: RiscvCsrState) -> RiscvCsrState {
    return riscv_csr_set_bits(csr, 768, 8);
}

pub fn riscv_disable_global_interrupts(csr: RiscvCsrState) -> RiscvCsrState {
    return riscv_csr_clear_bits(csr, 768, 8);
}

pub fn riscv_is_global_interrupt_enabled(csr: RiscvCsrState) -> Bool {
    let mstatus: Int = (csr).mstatus;
    return ((mstatus / 8) % 2) == 1;
}

pub fn riscv_trap_enter(csr: RiscvCsrState, cause: Int, pc: Int, bad_addr: Int) -> RiscvCsrState {
    let base_csr: RiscvCsrState = RiscvCsrState {
        mstatus: (csr).mstatus,
        mie: (csr).mie,
        mip: (csr).mip,
        mtvec: (csr).mtvec,
        mepc: pc,
        mcause: cause,
        mtval: bad_addr,
        pmpcfg0: (csr).pmpcfg0,
        pmpaddr0: (csr).pmpaddr0,
        pmpaddr1: (csr).pmpaddr1,
        privilege_mode: (csr).privilege_mode,
        last_csr: (csr).last_csr,
        last_handler: (csr).last_handler,
    };

    let current_mie: Int = ((base_csr).mstatus / 8) % 2;
    let mut after_mpie: RiscvCsrState = base_csr;
    if current_mie == 1 {
        after_mpie = riscv_csr_set_bits(base_csr, 768, 128);
    } else {
        after_mpie = riscv_csr_clear_bits(base_csr, 768, 128);
    }
    let after_mie: RiscvCsrState = riscv_csr_clear_bits(after_mpie, 768, 8);

    let mode: Int = (after_mie).mtvec % 4;
    let base: Int = (after_mie).mtvec - mode;
    let mut handler: Int = base;
    if mode == 1 {
        let is_irq: Int = (cause / 2147483648) % 2;
        if is_irq == 1 {
            let code: Int = cause % 32;
            handler = base + (code * 4);
        }
    }
    return RiscvCsrState {
        mstatus: (after_mie).mstatus,
        mie: (after_mie).mie,
        mip: (after_mie).mip,
        mtvec: (after_mie).mtvec,
        mepc: (after_mie).mepc,
        mcause: (after_mie).mcause,
        mtval: (after_mie).mtval,
        pmpcfg0: (after_mie).pmpcfg0,
        pmpaddr0: (after_mie).pmpaddr0,
        pmpaddr1: (after_mie).pmpaddr1,
        privilege_mode: (after_mie).privilege_mode,
        last_csr: (after_mie).last_csr,
        last_handler: handler,
    };
}

pub fn riscv_trap_return(csr: RiscvCsrState) -> RiscvCsrState {
    let mpie: Int = ((csr).mstatus / 128) % 2;
    let mut after: RiscvCsrState = csr;
    if mpie == 1 {
        after = riscv_csr_set_bits(csr, 768, 8);
    } else {
        after = riscv_csr_clear_bits(csr, 768, 8);
    }
    after = riscv_csr_set_bits(after, 768, 128);
    return RiscvCsrState {
        mstatus: (after).mstatus,
        mie: (after).mie,
        mip: (after).mip,
        mtvec: (after).mtvec,
        mepc: (after).mepc,
        mcause: (after).mcause,
        mtval: (after).mtval,
        pmpcfg0: (after).pmpcfg0,
        pmpaddr0: (after).pmpaddr0,
        pmpaddr1: (after).pmpaddr1,
        privilege_mode: (after).privilege_mode,
        last_csr: (after).last_csr,
        last_handler: (after).mepc,
    };
}

pub fn riscv_pmp_configure_entry(
    csr: RiscvCsrState,
    entry_idx: Int,
    addr: Int,
    read_allow: Bool,
    write_allow: Bool,
    exec_allow: Bool,
    lock: Bool
) -> RiscvCsrState {
    let mut pmpaddr0 = (csr).pmpaddr0;
    let mut pmpaddr1 = (csr).pmpaddr1;
    if entry_idx == 0 {
        pmpaddr0 = addr;
    } else {
        if entry_idx == 1 {
            pmpaddr1 = addr;
        }
    }
    let mut attr: Int = 0;
    if read_allow { attr = attr + 1; }
    if write_allow { attr = attr + 2; }
    if exec_allow { attr = attr + 4; }
    if lock { attr = attr + 128; }

    return RiscvCsrState {
        mstatus: (csr).mstatus,
        mie: (csr).mie,
        mip: (csr).mip,
        mtvec: (csr).mtvec,
        mepc: (csr).mepc,
        mcause: (csr).mcause,
        mtval: (csr).mtval,
        pmpcfg0: attr,
        pmpaddr0: pmpaddr0,
        pmpaddr1: pmpaddr1,
        privilege_mode: (csr).privilege_mode,
        last_csr: (csr).last_csr,
        last_handler: (csr).last_handler,
    };
}
