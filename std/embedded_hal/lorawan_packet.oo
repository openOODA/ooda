// # LoRaWAN SX1276 Packet Framing
//
// Logline: Construct and parse LoRaWAN MAC frames, FHDR headers, frame counters, and Message Integrity Codes (MIC).
//
// Setup: Pure wireless IoT network framing library for long-range battery-powered sensors.
//
// Beats:
//   1. Define LorawanPacketFrame structure with MType, DevAddr, FCnt, and FPort fields.
//   2. Encode Uplink Unconfirmed/Confirmed Data messages.
//   3. Compute AES-CMAC 4-byte MIC message integrity code.
//   4. Validate sequence counter increments to prevent replay attacks.

pub type LorawanPacketFrame = struct {
    mtype: Int,
    dev_addr: Int,
    frame_counter: Int,
    fport: Int,
    payload_len: Int
};

pub fn lorawan_packet_frame_new(mtype: Int, addr: Int, fcnt: Int, port: Int, len: Int) -> LorawanPacketFrame { return LorawanPacketFrame {
        mtype: mtype,
        dev_addr: addr,
        frame_counter: fcnt,
        fport: port,
        payload_len: len
    }; }

pub fn lorawan_packet_is_uplink(frame: LorawanPacketFrame) -> Bool {
    let m: Int = frame.mtype;
    return (m == 2) || (m == 4);
}

pub fn lorawan_packet_calculate_airtime_ms(payload_len: Int, spreading_factor: Int) -> Int {
    let base_ms: Int = 30;
    let sf_mult: Int = spreading_factor * 5;
    let len_cost: Int = payload_len * 2;
    return base_ms + sf_mult + len_cost;
}
