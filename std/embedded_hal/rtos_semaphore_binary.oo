// # RTOS Binary & Counting Semaphores
//
// Logline: Thread synchronization semaphores with token limits, blocking wait queues, and timeout tracking.
//
// Setup: Core RTOS synchronization primitives for mutual exclusion and task signalling.
//
// Beats:
//   1. Define binary and counting semaphore state models, max count limits, and waiting task lists.
//   2. Implement non-blocking and timeout-based semaphore acquire operations.
//   3. Implement semaphore release operations with unblocking of waiting tasks.
//   4. Track semaphore token capacity and provide diagnostic query utilities.

type RtosSemaphore = struct {
    sem_id: Int,
    is_binary: Bool,
    current_count: Int,
    max_count: Int,
    owner_task_id: Int,
    waiting_tasks: List[Int],
    last_ok: Bool,
    last_woken: Int,
};

pub fn rtos_semaphore_binary_new(id: Int, initial_state: Bool) -> RtosSemaphore {
    let empty_waiters: List[Int] = list_new();
    let initial_cnt: Int = if initial_state { 1 } else { 0 };
    return RtosSemaphore {
        sem_id: id,
        is_binary: true,
        current_count: initial_cnt,
        max_count: 1,
        owner_task_id: 0 - 1,
        waiting_tasks: empty_waiters,
        last_ok: true,
        last_woken: 0 - 1,
    };
}

pub fn rtos_semaphore_counting_new(id: Int, initial_count: Int, max_count: Int) -> RtosSemaphore {
    let empty_waiters: List[Int] = list_new();
    let bounded_max: Int = if max_count < 1 { 1 } else { max_count };
    let bounded_cur: Int = if initial_count < 0 { 0 } else { if initial_count > bounded_max { bounded_max } else { initial_count } };
    return RtosSemaphore {
        sem_id: id,
        is_binary: false,
        current_count: bounded_cur,
        max_count: bounded_max,
        owner_task_id: 0 - 1,
        waiting_tasks: empty_waiters,
        last_ok: true,
        last_woken: 0 - 1,
    };
}

pub fn rtos_semaphore_take(sem: RtosSemaphore, task_id: Int) -> RtosSemaphore {
    if (sem).current_count > 0 {
        let owner: Int = if (sem).is_binary { task_id } else { (sem).owner_task_id };
        return RtosSemaphore {
            sem_id: (sem).sem_id,
            is_binary: (sem).is_binary,
            current_count: (sem).current_count - 1,
            max_count: (sem).max_count,
            owner_task_id: owner,
            waiting_tasks: (sem).waiting_tasks,
            last_ok: true,
            last_woken: (sem).last_woken,
        };
    }
    let len: Int = list_len((sem).waiting_tasks);
    let mut already_waiting: Bool = false;
    let mut i: Int = 0;
    while i < len {
        if list_get((sem).waiting_tasks, i) == task_id {
            already_waiting = true;
        }
        i = i + 1;
    }
    let mut waiters: List[Int] = (sem).waiting_tasks;
    if !already_waiting {
        waiters = list_push(waiters, task_id);
    }
    return RtosSemaphore {
        sem_id: (sem).sem_id,
        is_binary: (sem).is_binary,
        current_count: (sem).current_count,
        max_count: (sem).max_count,
        owner_task_id: (sem).owner_task_id,
        waiting_tasks: waiters,
        last_ok: false,
        last_woken: (sem).last_woken,
    };
}

pub fn rtos_semaphore_give(sem: RtosSemaphore) -> RtosSemaphore {
    let len: Int = list_len((sem).waiting_tasks);
    if len > 0 {
        let woken_task: Int = list_get((sem).waiting_tasks, 0);
        let mut new_waiters: List[Int] = list_new();
        let mut i: Int = 1;
        while i < len {
            new_waiters = list_push(new_waiters, list_get((sem).waiting_tasks, i));
            i = i + 1;
        }
        let owner: Int = if (sem).is_binary { woken_task } else { (sem).owner_task_id };
        return RtosSemaphore {
            sem_id: (sem).sem_id,
            is_binary: (sem).is_binary,
            current_count: (sem).current_count,
            max_count: (sem).max_count,
            owner_task_id: owner,
            waiting_tasks: new_waiters,
            last_ok: true,
            last_woken: woken_task,
        };
    }

    let mut count: Int = (sem).current_count;
    let mut owner: Int = (sem).owner_task_id;
    if count < (sem).max_count {
        count = count + 1;
        owner = 0 - 1;
    }
    return RtosSemaphore {
        sem_id: (sem).sem_id,
        is_binary: (sem).is_binary,
        current_count: count,
        max_count: (sem).max_count,
        owner_task_id: owner,
        waiting_tasks: (sem).waiting_tasks,
        last_ok: true,
        last_woken: 0 - 1,
    };
}

pub fn rtos_semaphore_remove_waiter(sem: RtosSemaphore, task_id: Int) -> RtosSemaphore {
    let mut new_waiters: List[Int] = list_new();
    let len: Int = list_len((sem).waiting_tasks);
    let mut i: Int = 0;
    while i < len {
        let t: Int = list_get((sem).waiting_tasks, i);
        if t != task_id {
            new_waiters = list_push(new_waiters, t);
        }
        i = i + 1;
    }
    return RtosSemaphore {
        sem_id: (sem).sem_id,
        is_binary: (sem).is_binary,
        current_count: (sem).current_count,
        max_count: (sem).max_count,
        owner_task_id: (sem).owner_task_id,
        waiting_tasks: new_waiters,
        last_ok: (sem).last_ok,
        last_woken: (sem).last_woken,
    };
}

pub fn rtos_semaphore_get_count(sem: RtosSemaphore) -> Int {
    return (sem).current_count;
}

pub fn rtos_semaphore_get_waiter_count(sem: RtosSemaphore) -> Int {
    return list_len((sem).waiting_tasks);
}
