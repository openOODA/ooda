// # Independent Watchdog timeout (Int destub floor)
//
// Logline: IWDG timeout_ms = reload * 1000 / (LSI / prescaler). By-value destub.
//
// Setup: Flattened 5 Int fields. Bool destubbed to 0/1. No trailing-dot structs.
//
// Beats:
//   1. new clamps reload to [0,4095].
//   2. start sets enabled=1 and counter=reload.
//   3. timeout_ms from 32 kHz LSI.

type IwdgConfig = struct {
    prescaler_div: Int,
    reload_value: Int,
    counter: Int,
    is_enabled: Int,
    lsi_freq_hz: Int
};

fn iwdg_clamp_reload(reload: Int) -> Int {
    if reload < 0 {
        return 0;
    }
    if reload > 4095 {
        return 4095;
    }
    return reload;
}

pub fn iwdg_config_new(prescaler: Int, reload: Int) -> IwdgConfig {
    let bounded: Int = iwdg_clamp_reload(reload);
    return IwdgConfig {
        prescaler_div: prescaler,
        reload_value: bounded,
        counter: bounded,
        is_enabled: 0,
        lsi_freq_hz: 32000
    };
}

pub fn iwdg_start(iwdg: IwdgConfig) -> IwdgConfig {
    return IwdgConfig {
        prescaler_div: iwdg.prescaler_div,
        reload_value: iwdg.reload_value,
        counter: iwdg.reload_value,
        is_enabled: 1,
        lsi_freq_hz: iwdg.lsi_freq_hz
    };
}

pub fn iwdg_kick(iwdg: IwdgConfig) -> IwdgConfig {
    return IwdgConfig {
        prescaler_div: iwdg.prescaler_div,
        reload_value: iwdg.reload_value,
        counter: iwdg.reload_value,
        is_enabled: iwdg.is_enabled,
        lsi_freq_hz: iwdg.lsi_freq_hz
    };
}

pub fn iwdg_calculate_timeout_ms(iwdg: IwdgConfig) -> Int {
    if iwdg.lsi_freq_hz <= 0 {
        return 0;
    }
    if iwdg.prescaler_div <= 0 {
        return 0;
    }
    let ticks_per_sec: Int = iwdg.lsi_freq_hz / iwdg.prescaler_div;
    if ticks_per_sec <= 0 {
        return 0;
    }
    return (iwdg.reload_value * 1000) / ticks_per_sec;
}
