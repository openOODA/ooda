// # Advanced Astrodynamics Test Fixtures & Mission Benchmarks
//
// Logline: Provides standardized validation benchmarks, Apollo/Artemis trajectory mocks, and DSOC optical link test fixtures.
//
// Setup: Generates calibrated reference states for testing advanced orbital mechanics, attitude estimation, and propulsion solvers.
//
// Beats:
//   1. Provide reference Apollo 11 Trans-Lunar and Lunar Orbit Insertion mission parameter benchmarks.
//   2. Provide JWST Earth-Moon / Sun-Earth L2 Halo orbit and Mars aerocapture validation fixtures.
//   3. Provide Deep Space Optical Communications (DSOC) and Hall thruster electric propulsion mock telemetry.

import "./astro_constants.oo";
import "./earth_moon_trans_lunar.oo";
import "./lunar_orbit_insertion.oo";
import "./lunar_landing_guidance.oo";
import "./halo_orbit_cr3bp.oo";
import "./deep_space_optical_comm.oo";
import "./electric_propulsion_hall_thruster.oo";

pub type AstroMissionBenchmark = struct {
    benchmark_id: Int,
    name_code: Int,
    target_delta_v_m_s: Float,
    expected_duration_s: Float,
    reference_mass_kg: Float,
};

pub fn stub_apollo11_tli_fixture() -> TliTransferSolution {
    let params: TliMissionParams = tli_params_default();
    return tli_compute_transfer(params);
}

pub fn stub_apollo11_loi_fixture() -> LoiCaptureSolution {
    let params: LoiTargetParams = loi_params_default();
    return loi_compute_capture(params, 314000.0, 91000.0, 30000.0, 314.0);
}

pub fn stub_artemis_landing_waypoint() -> LandingWaypoint {
    return LandingWaypoint {
        pos_x: 0.0,
        pos_y: 0.0,
        pos_z: 0.0,
        vel_x: 0.0,
        vel_y: 0.0,
        vel_z: 0.0, // vertical touchdown
        t_target_sec: 180.0, // 3-minute terminal phase
    };
}

pub fn stub_artemis_landing_initial_state() -> LandingState {
    return landing_state_new(
        2500.0, // 2.5 km cross-range
        15000.0, // 15 km downrange
        3000.0, // 3 km altitude
        0.0 - 25.0,
        0.0 - 150.0,
        0.0 - 35.0,
        15000.0 // 15 metric tons
    );
}

pub fn stub_jwst_halo_l2_fixture() -> HaloStateSolution {
    let spec: HaloOrbitSpec = halo_orbit_spec_default_l2(250000.0);
    return halo_orbit_compute_state(spec, 0.0);
}

pub fn stub_dsoc_psyche_fixture() -> DsocLinkPerformance {
    let spec: DsocSystemSpec = dsoc_spec_mars_default();
    return dsoc_compute_link(spec);
}

pub fn stub_hall_thruster_fixture() -> HallThrusterPerformance {
    let spec: HallThrusterSpec = hall_thruster_xenon_default();
    return hall_thruster_compute(spec);
}
