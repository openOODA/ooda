// # Cell Population Dynamics & Culture
//
// Logline: Simulates bioreactor chemostat cultures, cell population demographics, and colony survival rates.
//
// Setup: Imports cell_types.oo for CellCulture, BioreactorState, and PopulationDemographics types.
//
// Beats:
//   1. Initialize bioreactor batch, fed-batch, and continuous chemostat cultures.
//   2. Track live cell density, viability percentages, and mortality rates across population cohorts.
//   3. Compute dilution rates, wash-out boundaries, and steady-state nutrient concentrations.

import "./cell_types.oo";

// -------------------------------------------------------------------
// CellPopulation Helper Functions
// -------------------------------------------------------------------

pub fn cell_population_new(id: Int, name: String, rate: GrowthRate, volume: Float) -> CellPopulation {
    let empty_cells: List[AgentCell] = list_new();
    return CellPopulation {
        population_id: id,
        population_name: name,
        initial_count: 0,
        current_count: 0,
        growth_rate: rate,
        cells: empty_cells,
        total_volume_ml: volume,
        viability_percent: 100.0,
    };
}

pub fn cell_population_add_cell(pop: &mut CellPopulation, cell: AgentCell) {
    let mut c_list: List[AgentCell] = (pop).cells;
    c_list = list_push(c_list, cell);
    (pop).cells = c_list;
    (pop).current_count = (pop).current_count + 1;
    if (pop).initial_count == 0 {
        (pop).initial_count = (pop).current_count;
    }
}

pub fn cell_population_size(pop: &CellPopulation) -> Int {
    return (pop).current_count;
}

pub fn cell_population_get_cell(pop: &CellPopulation, idx: Int) -> AgentCell {
    let c_list: List[AgentCell] = (pop).cells;
    return list_get(c_list, idx);
}

pub fn cell_population_average_viability(pop: &CellPopulation) -> Float {
    let c_list: List[AgentCell] = (pop).cells;
    let n: Int = c_list.len();
    if n == 0 {
        return 0.0;
    }
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let cell: AgentCell = list_get(c_list, i);
        sum = sum + (cell).viability;
        i = i + 1;
    }
    return sum / (n * 1.0);
}

pub fn cell_population_total_atp(pop: &CellPopulation) -> Float {
    let c_list: List[AgentCell] = (pop).cells;
    let n: Int = c_list.len();
    let mut total: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let cell: AgentCell = list_get(c_list, i);
        total = total + (cell).atp_level;
        i = i + 1;
    }
    return total;
}

pub fn cell_population_filter_viable(pop: &CellPopulation, min_viability: Float) -> CellPopulation {
    let c_list: List[AgentCell] = (pop).cells;
    let n: Int = c_list.len();
    let mut filtered_cells: List[AgentCell] = list_new();
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let cell: AgentCell = list_get(c_list, i);
        if (cell).viability >= min_viability {
            filtered_cells = list_push(filtered_cells, cell);
            count = count + 1;
        }
        i = i + 1;
    }
    return CellPopulation {
        population_id: (pop).population_id,
        population_name: (pop).population_name,
        initial_count: count,
        current_count: count,
        growth_rate: (pop).growth_rate,
        cells: filtered_cells,
        total_volume_ml: (pop).total_volume_ml,
        viability_percent: (pop).viability_percent,
    };
}

pub fn cell_population_density(pop: &CellPopulation) -> Float {
    let vol = (pop).total_volume_ml;
    if vol <= 0.0 {
        return 0.0;
    }
    let count_float = (pop).current_count * 1.0;
    return count_float / vol;
}

// -------------------------------------------------------------------
// CellEnvironment & CellCulture Helper Functions
// -------------------------------------------------------------------

pub fn cell_environment_new(ph: Float, temp: Float, glucose: Float, o2: Float) -> CellEnvironment {
    return CellEnvironment {
        ph: ph,
        temperature_c: temp,
        glucose_mM: glucose,
        oxygen_percent: o2,
    };
}

pub fn cell_environment_default() -> CellEnvironment {
    return CellEnvironment {
        ph: 7.4,
        temperature_c: 37.0,
        glucose_mM: 25.0,
        oxygen_percent: 21.0,
    };
}

pub fn cell_environment_is_physiological(env: &CellEnvironment) -> Bool {
    let ph_ok = (env).ph >= 6.8 && (env).ph <= 7.8;
    let temp_ok = (env).temperature_c >= 35.0 && (env).temperature_c <= 39.0;
    let o2_ok = (env).oxygen_percent >= 1.0 && (env).oxygen_percent <= 21.0;
    return ph_ok && temp_ok && o2_ok;
}

pub fn cell_line_new(id: String, species: String, tissue: String, immortal: Bool, doubling: Float) -> CellLine {
    return CellLine {
        line_id: id,
        species: species,
        tissue_origin: tissue,
        is_immortalized: immortal,
        base_doubling_time: doubling,
    };
}

pub fn cell_culture_new(id: Int, name: String, pop: CellPopulation, env: CellEnvironment) -> CellCulture {
    return CellCulture {
        culture_id: id,
        culture_name: name,
        population: pop,
        environment: env,
        passage_number: 1,
    };
}

pub fn cell_culture_passage(culture: &mut CellCulture, split_ratio: Float) {
    (culture).passage_number = (culture).passage_number + 1;
    let old_count = (culture).population.current_count;
    let new_count_float = (old_count * 1.0) / split_ratio;
    let mut new_count: Int = 0;
    let mut temp = new_count_float;
    while temp >= 1.0 {
        new_count = new_count + 1;
        temp = temp - 1.0;
    }
    (culture).population.current_count = new_count;
}
