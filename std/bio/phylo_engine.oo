// # Phylogenetic Distance & Tree Inference
//
// Logline: Computes evolutionary distance matrices, Jukes-Cantor corrections, and neighbor-joining tree topology.
//
// Setup: Imports phylo_types.oo and phylo_ops.oo for distance matrix calculations and tree topologies.
//
// Beats:
//   1. Compute pairwise sequence distances and apply Jukes-Cantor / Kimura 2-parameter corrections.
//   2. Construct distance matrices and evaluate phylogenetic tree branch lengths.
//   3. Infer neighbor-joining (NJ) and UPGMA phylogenetic tree topologies.

import "./phylo_ops.oo";

// -------------------------------------------------------------------
// DistanceMatrix Functions
// -------------------------------------------------------------------

pub fn distance_matrix_new(n_taxa: Int, model: String) -> DistanceMatrix {
    let init_names: List[String] = list_new();
    let init_dists: List[Float] = list_new();
    return DistanceMatrix {
        n_taxa: n_taxa,
        taxa_names: init_names,
        distances: init_dists,
        model_name: model,
        is_symmetric: true
    };
}

pub fn distance_matrix_add_taxon(mat: &mut DistanceMatrix, name: String) {
    let mut taxa_names_lst: List[String] = (mat).taxa_names;
    taxa_names_lst = list_push(taxa_names_lst, name);
    (mat).taxa_names = taxa_names_lst;
    (mat).n_taxa = list_len(taxa_names_lst);
}

pub fn distance_matrix_set(mat: &mut DistanceMatrix, i: Int, j: Int, dist: Float) {
    let dm_n: Int = (mat).n_taxa;
    if i < 0 || i >= dm_n || j < 0 || j >= dm_n {
        return;
    }
    let dm_target_idx: Int = (i * dm_n) + j;
    let dm_current_len: Int = list_len((mat).distances);
    let mut dm_dists: List[Float] = (mat).distances;

    let mut dm_k: Int = dm_current_len;
    while dm_k <= dm_target_idx {
        dm_dists = list_push(dm_dists, 0.0);
        dm_k = dm_k + 1;
    }

    let mut dm_new_dists: List[Float] = list_new();
    let dm_total_cells: Int = list_len(dm_dists);
    let mut dm_idx: Int = 0;
    while dm_idx < dm_total_cells {
        if dm_idx == dm_target_idx {
            dm_new_dists = list_push(dm_new_dists, dist);
        } else {
            dm_new_dists = list_push(dm_new_dists, list_get(dm_dists, dm_idx));
        }
        dm_idx = dm_idx + 1;
    }
    (mat).distances = dm_new_dists;
}

pub fn distance_matrix_get(mat: &DistanceMatrix, i: Int, j: Int) -> Float {
    let dm_get_n: Int = (mat).n_taxa;
    if i < 0 || i >= dm_get_n || j < 0 || j >= dm_get_n {
        return 0.0;
    }
    let dm_get_target: Int = (i * dm_get_n) + j;
    let dm_get_dists: List[Float] = (mat).distances;
    if dm_get_target < list_len(dm_get_dists) {
        return list_get(dm_get_dists, dm_get_target);
    }
    return 0.0;
}

pub fn distance_matrix_is_valid(mat: &DistanceMatrix) -> Bool {
    let dm_val_n: Int = (mat).n_taxa;
    if dm_val_n <= 0 {
        return false;
    }
    let dm_exp_cells: Int = dm_val_n * dm_val_n;
    let dm_act_cells: Int = list_len((mat).distances);
    return dm_act_cells >= dm_exp_cells;
}

pub fn calculate_p_distance(seq1: String, seq2: String) -> Float {
    let p_len1: Int = chars_len(seq1);
    let p_len2: Int = chars_len(seq2);
    let p_min_len_int: Int = if p_len1 < p_len2 { p_len1 } else { p_len2 };
    if p_min_len_int == 0 {
        return 0.0;
    }
    let mut p_i: Int = 0;
    let mut p_diffs: Float = 0.0;
    let mut p_min_len: Float = 0.0;
    while p_i < p_min_len_int {
        let p_c1: String = char_at(seq1, p_i);
        let p_c2: String = char_at(seq2, p_i);
        if p_c1 != p_c2 {
            p_diffs = p_diffs + 1.0;
        }
        p_min_len = p_min_len + 1.0;
        p_i = p_i + 1;
    }
    return p_diffs / p_min_len;
}

pub fn calculate_jukes_cantor(p_dist: Float) -> Float {
    if p_dist >= 0.75 {
        return 3.0;
    }
    let jc_x: Float = (4.0 / 3.0) * p_dist;
    let jc_ln_arg: Float = 1.0 - jc_x;
    if jc_ln_arg <= 0.0 {
        return 3.0;
    }
    let jc_val: Float = ln(jc_ln_arg);
    return (0.0 - 0.75) * jc_val;
}

pub fn calculate_kimura_2p(transitions: Float, transversions: Float, total_sites: Float) -> Float {
    if total_sites <= 0.0 {
        return 0.0;
    }
    let k_p: Float = transitions / total_sites;
    let k_q: Float = transversions / total_sites;

    let k_arg1: Float = (1.0 - (2.0 * k_p)) - k_q;
    let k_arg2: Float = 1.0 - (2.0 * k_q);
    if k_arg1 <= 0.0 || k_arg2 <= 0.0 {
        return 3.0;
    }
    let k_ln1: Float = ln(k_arg1);
    let k_ln2: Float = ln(k_arg2);
    return (0.0 - (0.5 * k_ln1)) - (0.25 * k_ln2);
}

// -------------------------------------------------------------------
// PhyloTree Functions
// -------------------------------------------------------------------

pub fn phylo_tree_new(tree_id: Int, name: String) -> PhyloTree {
    let init_tree_nodes: List[PhyloNode] = list_new();
    let init_tree_taxa: List[Taxon] = list_new();
    return PhyloTree {
        tree_id: tree_id,
        name: name,
        root_id: -1,
        nodes: init_tree_nodes,
        taxa: init_tree_taxa,
        node_count: 0,
        is_rooted: true,
        is_binary: true,
        total_tree_length: 0.0
    };
}

pub fn phylo_tree_add_node(tree: &mut PhyloTree, node: PhyloNode) {
    let mut tree_nds: List[PhyloNode] = (tree).nodes;
    tree_nds = list_push(tree_nds, node);
    (tree).nodes = tree_nds;
    (tree).node_count = list_len(tree_nds);
    (tree).total_tree_length = (tree).total_tree_length + (node).branch_length;
}

pub fn phylo_tree_add_taxon(tree: &mut PhyloTree, taxon: Taxon) {
    let mut tree_txs: List[Taxon] = (tree).taxa;
    tree_txs = list_push(tree_txs, taxon);
    (tree).taxa = tree_txs;
}

pub fn phylo_tree_get_node(tree: &PhyloTree, idx: Int) -> PhyloNode {
    let tree_get_nds: List[PhyloNode] = (tree).nodes;
    if idx >= 0 && idx < list_len(tree_get_nds) {
        return list_get(tree_get_nds, idx);
    }
    return phylo_node_new_leaf(-1, "null", -1, -1, 0.0);
}

pub fn phylo_tree_set_root(tree: &mut PhyloTree, root_id: Int) {
    (tree).root_id = root_id;
}

pub fn phylo_tree_compute_total_length(tree: &PhyloTree) -> Float {
    let tree_comp_nds: List[PhyloNode] = (tree).nodes;
    let tree_comp_n: Int = list_len(tree_comp_nds);
    let mut tree_comp_i: Int = 0;
    let mut tree_total_len: Float = 0.0;
    while tree_comp_i < tree_comp_n {
        let tree_comp_node: PhyloNode = list_get(tree_comp_nds, tree_comp_i);
        tree_total_len = tree_total_len + (tree_comp_node).branch_length;
        tree_comp_i = tree_comp_i + 1;
    }
    return tree_total_len;
}

pub fn phylo_tree_is_valid(tree: &PhyloTree) -> Bool {
    return (tree).node_count > 0 && (tree).root_id >= 0;
}

pub fn phylo_tree_node_count(tree: &PhyloTree) -> Int {
    return (tree).node_count;
}

pub fn phylo_tree_taxa_count(tree: &PhyloTree) -> Int {
    return list_len((tree).taxa);
}
