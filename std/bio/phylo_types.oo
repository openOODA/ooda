// # Phylogenetic Data Types
//
// Logline: Defines core data structures for taxa, phylogenetic trees, distance matrices, and evolutionary models.
//
// Setup: Pure data type definitions for phylogenetic analysis.
//
// Beats:
//   1. Define Taxon, PhyloNode, and PhyloTree tree structures.
//   2. Define DistanceMatrix and AlignmentStats metrics types.
//   3. Define SubstitutionModel configurations and evolutionary rate parameters.

// -------------------------------------------------------------------
// Helper Utilities
// -------------------------------------------------------------------

pub fn int_to_float(n: Int) -> Float {
    let mut f_res: Float = 0.0;
    let mut i_conv: Int = 0;
    let mut c_conv: Int = n;
    if c_conv < 0 {
        c_conv = 0 - c_conv;
    }
    while i_conv < c_conv {
        f_res = f_res + 1.0;
        i_conv = i_conv + 1;
    }
    if n < 0 {
        return 0.0 - f_res;
    }
    return f_res;
}

// -------------------------------------------------------------------
// Core Data Structures
// -------------------------------------------------------------------

pub type Taxon = struct {
    id: Int,
    name: String,
    accession: String,
    taxonomy_id: Int,
    sequence_length: Int,
    is_outgroup: Bool
};

pub type PhyloNode = struct {
    id: Int,
    label: String,
    taxon_id: Int,
    branch_length: Float,
    parent_id: Int,
    left_child_id: Int,
    right_child_id: Int,
    is_leaf: Bool,
    bootstrap_support: Float
};

pub type PhyloTree = struct {
    tree_id: Int,
    name: String,
    root_id: Int,
    nodes: List[PhyloNode],
    taxa: List[Taxon],
    node_count: Int,
    is_rooted: Bool,
    is_binary: Bool,
    total_tree_length: Float
};

pub type DistanceMatrix = struct {
    n_taxa: Int,
    taxa_names: List[String],
    distances: List[Float],
    model_name: String,
    is_symmetric: Bool
};

pub type SubstitutionsModel = struct {
    model_type: String,
    transition_transversion_ratio: Float,
    gamma_shape: Float,
    pinv: Float,
    is_calibrated: Bool
};

pub type TreeAlignment = struct {
    n_sequences: Int,
    alignment_length: Int,
    taxa_names: List[String],
    sequences: List[String],
    is_aligned: Bool
};
