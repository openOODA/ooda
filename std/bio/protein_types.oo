type Point3D = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn protein_point3d_new(x: Int, y: Int, z: Int) -> Point3D {
    return Point3D { x: x, y: y, z: z };
}

pub fn protein_point3d_x(p: Point3D) -> Int {
    return p.x;
}
