// # Phylogenetics Facade
//
// Logline: Re-exports phylogenetic tree structures, distance matrices, evolutionary models, and tree builders.
//
// Setup: Pure module shim importing companion phylogenetic submodules.
//
// Beats:
//   1. Import phylogenetic taxon types, tree nodes, distance matrices, and substitution models.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain backwards compatibility with evolutionary biology consumers.

import "./phylo_types.oo";
import "./phylo_ops.oo";
import "./phylo_engine.oo";
import "./phylo_stubs.oo";

pub fn shim_marker_int_to_float() -> Float {
    return int_to_float(3);
}

pub fn shim_marker_taxon_new() -> Taxon {
    return taxon_new(1, "Homo_sapiens", "NC_012920", 9606);
}

pub fn shim_marker_taxon_outgroup() -> Bool {
    let t: Taxon = taxon_new(1, "Homo_sapiens", "NC_012920", 9606);
    return taxon_is_outgroup(&t);
}

pub fn shim_marker_node_leaf() -> PhyloNode {
    return phylo_node_new_leaf(1, "Human", 1, 3, 0.05);
}

pub fn shim_marker_node_is_leaf() -> Bool {
    let n: PhyloNode = phylo_node_new_leaf(1, "Human", 1, 3, 0.05);
    return phylo_node_is_leaf(&n);
}

pub fn shim_marker_tree_new() -> PhyloTree {
    return phylo_tree_new(101, "Hominid_Tree");
}

pub fn shim_marker_tree_valid() -> Bool {
    let t: PhyloTree = phylo_tree_new(101, "Hominid_Tree");
    return phylo_tree_is_valid(&t);
}

pub fn shim_marker_p_distance() -> Float {
    return calculate_p_distance("ATGCATGC", "ATGGATGC");
}

pub fn shim_marker_jc() -> Float {
    return calculate_jukes_cantor(0.125);
}

pub fn shim_marker_distance_matrix() -> DistanceMatrix {
    return distance_matrix_new(2, "Jukes-Cantor");
}

pub fn shim_marker_model_new() -> SubstitutionsModel {
    return substitutions_model_new("HKY85", 2.0);
}

pub fn shim_marker_model_calibrated() -> Bool {
    let m: SubstitutionsModel = substitutions_model_new("HKY85", 2.0);
    return substitutions_model_is_calibrated(&m);
}

pub fn shim_marker_align_new() -> TreeAlignment {
    return tree_alignment_new(2, 8);
}

pub fn shim_marker_align_valid() -> Bool {
    let a: TreeAlignment = tree_alignment_new(2, 8);
    return tree_alignment_validate(&a);
}
