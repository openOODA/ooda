// # Chemical Molecule & Bond Operations
//
// Logline: Atomic-number tables, centi-dalton weights, Hill counts. Destubbed off List[Atom].
//
// Setup: Imports smiles_types.oo. Molecule is element counters plus running weight.
//
// Beats:
//   1. Map SMILES symbols to Z and Z to weight*100.
//   2. Add atoms by-value; implicit H add 1.008 g/mol scaled 101.
//   3. Hill-system C/H/N/O tallies.
// residual: List[struct] destubbed to Int floor.

import "./smiles_types.oo";

pub fn atom_symbol_to_number(symbol: String) -> Int {
    if symbol == "H" {
        return 1;
    }
    if symbol == "B" {
        return 5;
    }
    if symbol == "C" {
        return 6;
    }
    if symbol == "c" {
        return 6;
    }
    if symbol == "N" {
        return 7;
    }
    if symbol == "n" {
        return 7;
    }
    if symbol == "O" {
        return 8;
    }
    if symbol == "o" {
        return 8;
    }
    if symbol == "F" {
        return 9;
    }
    if symbol == "P" {
        return 15;
    }
    if symbol == "p" {
        return 15;
    }
    if symbol == "S" {
        return 16;
    }
    if symbol == "s" {
        return 16;
    }
    if symbol == "Cl" {
        return 17;
    }
    if symbol == "Br" {
        return 35;
    }
    if symbol == "I" {
        return 53;
    }
    return 0;
}

pub fn atom_atomic_weight(atomic_num: Int) -> Int {
    if atomic_num == 1 {
        return 101;
    }
    if atomic_num == 5 {
        return 1081;
    }
    if atomic_num == 6 {
        return 1201;
    }
    if atomic_num == 7 {
        return 1401;
    }
    if atomic_num == 8 {
        return 1600;
    }
    if atomic_num == 9 {
        return 1900;
    }
    if atomic_num == 15 {
        return 3097;
    }
    if atomic_num == 16 {
        return 3206;
    }
    if atomic_num == 17 {
        return 3545;
    }
    if atomic_num == 35 {
        return 7990;
    }
    if atomic_num == 53 {
        return 12690;
    }
    return 0;
}

pub fn atom_default_valency(atomic_num: Int) -> Int {
    if atomic_num == 1 { return 1; }
    if atomic_num == 5 { return 3; }
    if atomic_num == 6 { return 4; }
    if atomic_num == 7 { return 3; }
    if atomic_num == 8 { return 2; }
    if atomic_num == 9 { return 1; }
    if atomic_num == 15 { return 3; }
    if atomic_num == 16 { return 2; }
    if atomic_num == 17 { return 1; }
    if atomic_num == 35 { return 1; }
    if atomic_num == 53 { return 1; }
    return 0;
}

pub fn atom_create(symbol: String, atomic_number: Int, charge: Int, valency: Int, is_aromatic: Bool, isotope: Int, implicit_h: Int) -> Atom {
    return Atom {
        atomic_number: atomic_number,
        charge: charge,
        valency: valency,
        implicit_h: implicit_h
    };
}

pub fn bond_create(idx1: Int, idx2: Int, btype: Int, is_aro: Int) -> Bond {
    return smiles_bond_new(idx1, idx2, btype, is_aro);
}

pub fn smiles_molecule_init(raw: String) -> SmilesMolecule {
    let empty: SmilesMolecule = smiles_molecule_empty();
    if raw == "" {
        return empty;
    }
    return SmilesMolecule {
        n_c: empty.n_c,
        n_h: empty.n_h,
        n_n: empty.n_n,
        n_o: empty.n_o,
        n_atoms: empty.n_atoms,
        n_bonds: empty.n_bonds,
        n_rings: empty.n_rings,
        molecular_weight: empty.molecular_weight,
        is_valid: 1
    };
}

pub fn smiles_molecule_add_atom(mol: SmilesMolecule, a: Atom) -> SmilesMolecule {
    let z: Int = smiles_atom_z(a);
    let h_imp: Int = smiles_atom_implicit_h(a);
    let mut n_c: Int = (mol).n_c;
    let mut n_h: Int = (mol).n_h;
    let mut n_n: Int = (mol).n_n;
    let mut n_o: Int = (mol).n_o;
    if z == 1 {
        n_h = n_h + 1;
    }
    if z == 6 {
        n_c = n_c + 1;
    }
    if z == 7 {
        n_n = n_n + 1;
    }
    if z == 8 {
        n_o = n_o + 1;
    }
    n_h = n_h + h_imp;
    let atom_w: Int = atom_atomic_weight(z);
    let h_w: Int = atom_atomic_weight(1);
    let add_w: Int = atom_w + (h_imp * h_w);
    return SmilesMolecule {
        n_c: n_c,
        n_h: n_h,
        n_n: n_n,
        n_o: n_o,
        n_atoms: (mol).n_atoms + 1,
        n_bonds: (mol).n_bonds,
        n_rings: (mol).n_rings,
        molecular_weight: (mol).molecular_weight + add_w,
        is_valid: 1
    };
}

pub fn smiles_molecule_add_bond(mol: SmilesMolecule, bond: Bond) -> SmilesMolecule {
    let mut extra: Int = 0;
    if (bond).bond_type > 0 {
        extra = 1;
    }
    return SmilesMolecule {
        n_c: (mol).n_c,
        n_h: (mol).n_h,
        n_n: (mol).n_n,
        n_o: (mol).n_o,
        n_atoms: (mol).n_atoms,
        n_bonds: (mol).n_bonds + extra,
        n_rings: (mol).n_rings,
        molecular_weight: (mol).molecular_weight,
        is_valid: (mol).is_valid
    };
}

pub fn smiles_molecule_weight(mol: SmilesMolecule) -> Int {
    return (mol).molecular_weight;
}

pub fn smiles_molecule_formula(mol: SmilesMolecule) -> HillFormula {
    return HillFormula {
        n_c: (mol).n_c,
        n_h: (mol).n_h,
        n_n: (mol).n_n,
        n_o: (mol).n_o
    };
}

pub fn smiles_atom_weight_with_h(atom: Atom) -> Int {
    let atom_w: Int = atom_atomic_weight((atom).atomic_number);
    let h_w: Int = atom_atomic_weight(1);
    let h_imp: Int = (atom).implicit_h;
    return atom_w + (h_imp * h_w);
}
