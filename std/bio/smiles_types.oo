// # SMILES types
//
// Logline: Atom / Bond / molecule counters destubbed off List[Atom]/List[Bond].
// residual: List[struct] destubbed to Int floor.

type Atom = struct {
    atomic_number: Int,
    charge: Int,
    valency: Int,
    implicit_h: Int
};

pub fn smiles_atom_new(atomic_number: Int, charge: Int, valency: Int) -> Atom {
    return Atom {
        atomic_number: atomic_number,
        charge: charge,
        valency: valency,
        implicit_h: 0
    };
}

pub fn smiles_atom_with_h(atomic_number: Int, charge: Int, valency: Int, implicit_h: Int) -> Atom {
    return Atom {
        atomic_number: atomic_number,
        charge: charge,
        valency: valency,
        implicit_h: implicit_h
    };
}

pub fn smiles_atom_z(a: Atom) -> Int {
    return a.atomic_number;
}

pub fn smiles_atom_implicit_h(a: Atom) -> Int {
    return a.implicit_h;
}

type Bond = struct {
    atom1_idx: Int,
    atom2_idx: Int,
    bond_type: Int,
    is_aromatic: Int
};

pub fn smiles_bond_new(atom1_idx: Int, atom2_idx: Int, bond_type: Int, is_aromatic: Int) -> Bond {
    return Bond {
        atom1_idx: atom1_idx,
        atom2_idx: atom2_idx,
        bond_type: bond_type,
        is_aromatic: is_aromatic
    };
}

type SmilesMolecule = struct {
    n_c: Int,
    n_h: Int,
    n_n: Int,
    n_o: Int,
    n_atoms: Int,
    n_bonds: Int,
    n_rings: Int,
    molecular_weight: Int,
    is_valid: Int
};

pub fn smiles_molecule_empty() -> SmilesMolecule {
    return SmilesMolecule {
        n_c: 0,
        n_h: 0,
        n_n: 0,
        n_o: 0,
        n_atoms: 0,
        n_bonds: 0,
        n_rings: 0,
        molecular_weight: 0,
        is_valid: 0
    };
}

type HillFormula = struct {
    n_c: Int,
    n_h: Int,
    n_n: Int,
    n_o: Int
};
