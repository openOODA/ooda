// # Cellular Growth Kinetics
//
// Logline: Models Monod nutrient limitation, exponential growth phases, and carrying capacity constraints.
//
// Setup: Imports cell_types.oo for GrowthParameters, NutrientEnvironment, and BiomassState types.
//
// Beats:
//   1. Calculate specific growth rates under Monod and substrate inhibition models.
//   2. Evaluate temperature and pH dependency factors for bacterial and mammalian cells.
//   3. Model logistic growth curves and biomass yield coefficients.

pub type GrowthRate = struct {
    doubling_time_hours: Float,
    lag_phase_hours: Float,
    max_density: Float,
    death_rate: Float,
    is_exponential: Bool,
};

// -------------------------------------------------------------------
// GrowthRate Helper Functions
// -------------------------------------------------------------------

pub fn growth_rate_new(doubling_time: Float, lag_phase: Float, max_density: Float, death_rate: Float) -> GrowthRate {
    return GrowthRate {
        doubling_time_hours: doubling_time,
        lag_phase_hours: lag_phase,
        max_density: max_density,
        death_rate: death_rate,
        is_exponential: true,
    };
}

pub fn growth_rate_default() -> GrowthRate {
    return GrowthRate {
        doubling_time_hours: 24.0,
        lag_phase_hours: 2.0,
        max_density: 1000000.0,
        death_rate: 0.01,
        is_exponential: true,
    };
}

pub fn growth_rate_is_optimal(rate: &GrowthRate) -> Bool {
    let dt: Float = (rate).doubling_time_hours;
    let dr: Float = (rate).death_rate;
    let dt_ok: Bool = dt > 0.0 && dt <= 48.0;
    let dr_ok: Bool = dr >= 0.0 && dr < 0.1;
    return dt_ok && dr_ok;
}

pub fn growth_rate_effective_rate(rate: &GrowthRate, current_density: Float) -> Float {
    let max_d: Float = (rate).max_density;
    if max_d <= 0.0 {
        return 0.0;
    }
    let capacity_ratio: Float = current_density / max_d;
    if capacity_ratio >= 1.0 {
        return 0.0;
    }
    let base_rate: Float = 0.693147 / (rate).doubling_time_hours;
    let factor: Float = 1.0 - capacity_ratio;
    return base_rate * factor - (rate).death_rate;
}

pub fn growth_rate_calculate_count(rate: &GrowthRate, initial_count: Int, elapsed_hours: Float) -> Int {
    let lag: Float = (rate).lag_phase_hours;
    if elapsed_hours <= lag {
        return initial_count;
    }
    let active_hours: Float = elapsed_hours - lag;
    let dt: Float = (rate).doubling_time_hours;
    if dt <= 0.0 {
        return initial_count;
    }
    let mut divisions: Int = 0;
    let mut temp_h: Float = active_hours;
    while temp_h >= dt {
        divisions = divisions + 1;
        temp_h = temp_h - dt;
    }
    let mut count: Int = initial_count;
    let mut i: Int = 0;
    while i < divisions {
        count = count * 2;
        i = i + 1;
    }
    return count;
}
