// # Cell Agent Mechanics & Metabolism
//
// Logline: Nutrient uptake, ATP generation, viability, aging, and division. Destubbed off &mut.
//
// Setup: By-value AgentCell. Imports none.
//
// Beats:
//   1. Construct a cell agent.
//   2. Metabolize glucose to ATP (uptake * 30, cap 100).
//   3. Age, update viability, and divide by half ATP/volume.

type AgentCell = struct {
    cell_id: Int,
    cell_type: String,
    viability: Float,
    age_cycles: Int,
    atp_level: Float,
    volume_um3: Float,
    is_divided: Bool,
    metabolic_state: String
};

type CellDivision = struct {
    parent: AgentCell,
    daughter: AgentCell
};

pub fn agent_cell_new(id: Int, cell_type: String, viability: Float, atp: Float) -> AgentCell {
    return AgentCell {
        cell_id: id,
        cell_type: cell_type,
        viability: viability,
        age_cycles: 0,
        atp_level: atp,
        volume_um3: 1500.0,
        is_divided: false,
        metabolic_state: "active"
    };
}

pub fn agent_cell_create_full(id: Int, cell_type: String, viability: Float, age: Int, atp: Float, volume: Float, state: String) -> AgentCell {
    return AgentCell {
        cell_id: id,
        cell_type: cell_type,
        viability: viability,
        age_cycles: age,
        atp_level: atp,
        volume_um3: volume,
        is_divided: false,
        metabolic_state: state
    };
}

pub fn agent_cell_is_alive(cell: AgentCell) -> Bool {
    return cell.viability > 0.1 && cell.atp_level > 0.0;
}

pub fn agent_cell_can_divide(cell: AgentCell, min_atp: Float, min_viability: Float) -> Bool {
    let alive: Bool = agent_cell_is_alive(cell);
    let atp_ok: Bool = cell.atp_level >= min_atp;
    let viab_ok: Bool = cell.viability >= min_viability;
    let not_divided: Bool = cell.is_divided == false;
    return alive && atp_ok && viab_ok && not_divided;
}

pub fn agent_cell_get_atp(cell: AgentCell) -> Float {
    return cell.atp_level;
}

pub fn agent_cell_get_viability(cell: AgentCell) -> Float {
    return cell.viability;
}

pub fn agent_cell_get_age(cell: AgentCell) -> Int {
    return cell.age_cycles;
}

pub fn agent_cell_get_id(cell: AgentCell) -> Int {
    return cell.cell_id;
}

pub fn agent_cell_is_divided(cell: AgentCell) -> Bool {
    return cell.is_divided;
}

pub fn agent_cell_get_volume(cell: AgentCell) -> Float {
    return cell.volume_um3;
}

pub fn cell_division_parent(div: CellDivision) -> AgentCell {
    return div.parent;
}

pub fn cell_division_daughter(div: CellDivision) -> AgentCell {
    return div.daughter;
}

// ATP generated = glucose * 0.1 * 30, then added and capped at 100.
pub fn agent_cell_metabolize(cell: AgentCell, glucose_conc: Float) -> AgentCell {
    if cell.viability <= 0.0 {
        return cell;
    }
    let uptake: Float = glucose_conc * 0.1;
    let atp_generated: Float = uptake * 30.0;
    let mut new_atp: Float = cell.atp_level + atp_generated;
    if new_atp > 100.0 {
        new_atp = 100.0;
    }
    return AgentCell {
        cell_id: cell.cell_id,
        cell_type: cell.cell_type,
        viability: cell.viability,
        age_cycles: cell.age_cycles,
        atp_level: new_atp,
        volume_um3: cell.volume_um3,
        is_divided: cell.is_divided,
        metabolic_state: cell.metabolic_state
    };
}

pub fn agent_cell_divide(cell: AgentCell, new_id: Int) -> CellDivision {
    let half_atp: Float = cell.atp_level / 2.0;
    let half_vol: Float = cell.volume_um3 / 2.0;
    let parent: AgentCell = AgentCell {
        cell_id: cell.cell_id,
        cell_type: cell.cell_type,
        viability: cell.viability,
        age_cycles: cell.age_cycles + 1,
        atp_level: half_atp,
        volume_um3: half_vol,
        is_divided: true,
        metabolic_state: cell.metabolic_state
    };
    let daughter: AgentCell = AgentCell {
        cell_id: new_id,
        cell_type: cell.cell_type,
        viability: cell.viability,
        age_cycles: 0,
        atp_level: half_atp,
        volume_um3: half_vol,
        is_divided: false,
        metabolic_state: cell.metabolic_state
    };
    return CellDivision {
        parent: parent,
        daughter: daughter
    };
}

pub fn agent_cell_update_viability(cell: AgentCell, delta: Float) -> AgentCell {
    let mut v: Float = cell.viability + delta;
    if v > 1.0 {
        v = 1.0;
    }
    if v < 0.0 {
        v = 0.0;
    }
    return AgentCell {
        cell_id: cell.cell_id,
        cell_type: cell.cell_type,
        viability: v,
        age_cycles: cell.age_cycles,
        atp_level: cell.atp_level,
        volume_um3: cell.volume_um3,
        is_divided: cell.is_divided,
        metabolic_state: cell.metabolic_state
    };
}

pub fn agent_cell_age(cell: AgentCell) -> AgentCell {
    let mut v: Float = cell.viability - 0.02;
    if v < 0.0 {
        v = 0.0;
    }
    return AgentCell {
        cell_id: cell.cell_id,
        cell_type: cell.cell_type,
        viability: v,
        age_cycles: cell.age_cycles + 1,
        atp_level: cell.atp_level,
        volume_um3: cell.volume_um3,
        is_divided: cell.is_divided,
        metabolic_state: cell.metabolic_state
    };
}
