// # Cellular Biology Facade
//
// Logline: Re-exports cell agent models, growth kinematics, population ecology, and fail-closed bio stubs.
//
// Setup: Pure module shim importing cell biology companion modules.
//
// Beats:
//   1. Import cellular data types, cell agent behaviors, growth kinetics, and population dynamics.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain backwards compatibility with biological simulation pipelines.

import "./cell_types.oo";
import "./cell_growth.oo";
import "./cell_agent.oo";
import "./cell_pop.oo";
import "./cell_stubs.oo";

pub fn shim_marker_growth_new() -> GrowthRate {
    return growth_rate_new(24.0, 2.0, 1000000.0, 0.01);
}

pub fn shim_marker_growth_default() -> GrowthRate {
    return growth_rate_default();
}

pub fn shim_marker_growth_optimal() -> Bool {
    let r: GrowthRate = growth_rate_default();
    return growth_rate_is_optimal(&r);
}

pub fn shim_marker_growth_count() -> Int {
    let r: GrowthRate = growth_rate_default();
    return growth_rate_calculate_count(&r, 100, 50.0);
}

pub fn shim_marker_agent_new() -> AgentCell {
    return agent_cell_new(1, "HeLa", 0.95, 50.0);
}

pub fn shim_marker_agent_alive() -> Bool {
    let c: AgentCell = agent_cell_new(1, "HeLa", 0.95, 50.0);
    return agent_cell_is_alive(&c);
}

pub fn shim_marker_agent_can_divide() -> Bool {
    let c: AgentCell = agent_cell_new(1, "HeLa", 0.95, 50.0);
    return agent_cell_can_divide(&c, 20.0, 0.8);
}

pub fn shim_marker_pop_new() -> CellPopulation {
    let r: GrowthRate = growth_rate_default();
    return cell_population_new(1, "pop", r, 10.0);
}

pub fn shim_marker_pop_size() -> Int {
    let r: GrowthRate = growth_rate_default();
    let p: CellPopulation = cell_population_new(1, "pop", r, 10.0);
    return cell_population_size(&p);
}

pub fn shim_marker_env_default() -> CellEnvironment {
    return cell_environment_default();
}

pub fn shim_marker_env_physio() -> Bool {
    let e: CellEnvironment = cell_environment_default();
    return cell_environment_is_physiological(&e);
}

pub fn shim_marker_line_new() -> CellLine {
    return cell_line_new("HEK293", "Human", "Kidney", true, 22.0);
}

pub fn shim_marker_culture_new() -> CellCulture {
    let r: GrowthRate = growth_rate_default();
    let p: CellPopulation = cell_population_new(1, "pop", r, 10.0);
    let e: CellEnvironment = cell_environment_default();
    return cell_culture_new(1, "c1", p, e);
}
