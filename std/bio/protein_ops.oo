// # Protein Backbone Geometry & Dihedral Angles
//
// Logline: Peptide geometry, phi/psi torsions, Ramachandran regions. Destubbed off &mut / pub type.
//
// Setup: By-value plot and secondary-structure counters. Point3D from protein_types.
//
// Beats:
//   1. Backbone atom CA distance.
//   2. Classify core alpha / beta / left-alpha / allowed / disallowed.
//   3. Tally Ramachandran and secondary-structure counts.

import "./protein_types.oo";

type BackboneAtoms = struct {
    atom_n: Point3D,
    atom_ca: Point3D,
    atom_c: Point3D,
    atom_o: Point3D,
    atom_h: Point3D
};

pub fn backbone_atoms_new(n: Point3D, ca: Point3D, c: Point3D, o: Point3D, h: Point3D) -> BackboneAtoms {
    return BackboneAtoms {
        atom_n: n,
        atom_ca: ca,
        atom_c: c,
        atom_o: o,
        atom_h: h
    };
}

pub fn point3d_new(x: Int, y: Int, z: Int) -> Point3D {
    return Point3D { x: x, y: y, z: z };
}

pub fn point3d_dist_sq(p1: Point3D, p2: Point3D) -> Int {
    let dx: Int = p1.x - p2.x;
    let dy: Int = p1.y - p2.y;
    let dz: Int = p1.z - p2.z;
    return (dx * dx) + (dy * dy) + (dz * dz);
}

pub fn point3d_sqrt_approx(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    let mut x: Int = n;
    let mut y: Int = (x + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn point3d_dist(p1: Point3D, p2: Point3D) -> Int {
    let dsq: Int = point3d_dist_sq(p1, p2);
    return point3d_sqrt_approx(dsq);
}

pub fn backbone_atoms_ca_distance(b1: BackboneAtoms, b2: BackboneAtoms) -> Int {
    return point3d_dist(b1.atom_ca, b2.atom_ca);
}

type TorsionAngles = struct {
    phi: Int,
    psi: Int,
    omega: Int,
    chi1: Int
};

pub fn torsion_angles_new(phi: Int, psi: Int, omega: Int, chi1: Int) -> TorsionAngles {
    return TorsionAngles {
        phi: phi,
        psi: psi,
        omega: omega,
        chi1: chi1
    };
}

// Trans peptide if |omega| >= 150000 millidegrees.
pub fn torsion_angles_is_trans(angles: TorsionAngles) -> Int {
    let mut om: Int = angles.omega;
    if om < 0 {
        om = 0 - om;
    }
    if om >= 150000 {
        return 1;
    }
    return 0;
}

// 1 = core alpha, 2 = core beta, 3 = left alpha, 4 = allowed, 0 = disallowed.
pub fn torsion_angles_ramachandran_region(angles: TorsionAngles) -> Int {
    let phi: Int = angles.phi;
    let psi: Int = angles.psi;

    if phi >= 0 - 90000 {
        if phi <= 0 - 30000 {
            if psi >= 0 - 70000 {
                if psi <= 0 - 10000 {
                    return 1;
                }
            }
        }
    }

    if phi >= 0 - 170000 {
        if phi <= 0 - 90000 {
            if psi >= 90000 {
                if psi <= 170000 {
                    return 2;
                }
            }
        }
    }

    if phi >= 30000 {
        if phi <= 90000 {
            if psi >= 10000 {
                if psi <= 70000 {
                    return 3;
                }
            }
        }
    }

    if phi >= 0 - 180000 {
        if phi <= 180000 {
            if psi >= 0 - 180000 {
                if psi <= 180000 {
                    return 4;
                }
            }
        }
    }

    return 0;
}

pub fn torsion_angles_is_alpha_helix(angles: TorsionAngles) -> Int {
    let region: Int = torsion_angles_ramachandran_region(angles);
    if region == 1 {
        return 1;
    }
    return 0;
}

pub fn torsion_angles_is_beta_sheet(angles: TorsionAngles) -> Int {
    let region: Int = torsion_angles_ramachandran_region(angles);
    if region == 2 {
        return 1;
    }
    return 0;
}

type RamachandranPlot = struct {
    core_alpha: Int,
    core_beta: Int,
    left_alpha: Int,
    allowed: Int,
    disallowed: Int
};

pub fn ramachandran_plot_new() -> RamachandranPlot {
    return RamachandranPlot {
        core_alpha: 0,
        core_beta: 0,
        left_alpha: 0,
        allowed: 0,
        disallowed: 0
    };
}

pub fn ramachandran_plot_add(plot: RamachandranPlot, angles: TorsionAngles) -> RamachandranPlot {
    let region: Int = torsion_angles_ramachandran_region(angles);
    let mut core_alpha: Int = plot.core_alpha;
    let mut core_beta: Int = plot.core_beta;
    let mut left_alpha: Int = plot.left_alpha;
    let mut allowed: Int = plot.allowed;
    let mut disallowed: Int = plot.disallowed;
    if region == 1 {
        core_alpha = core_alpha + 1;
    }
    if region == 2 {
        core_beta = core_beta + 1;
    }
    if region == 3 {
        left_alpha = left_alpha + 1;
    }
    if region == 4 {
        allowed = allowed + 1;
    }
    if region == 0 {
        disallowed = disallowed + 1;
    }
    return RamachandranPlot {
        core_alpha: core_alpha,
        core_beta: core_beta,
        left_alpha: left_alpha,
        allowed: allowed,
        disallowed: disallowed
    };
}

pub fn ramachandran_plot_core_alpha(plot: RamachandranPlot) -> Int {
    return plot.core_alpha;
}

pub fn ramachandran_plot_core_beta(plot: RamachandranPlot) -> Int {
    return plot.core_beta;
}

type SecondaryStructure = struct {
    n_helix: Int,
    n_sheet: Int,
    n_turn: Int,
    n_coil: Int
};

pub fn secondary_structure_new() -> SecondaryStructure {
    return SecondaryStructure {
        n_helix: 0,
        n_sheet: 0,
        n_turn: 0,
        n_coil: 0
    };
}

pub fn secondary_structure_register(ss: SecondaryStructure, angles: TorsionAngles) -> SecondaryStructure {
    if torsion_angles_is_alpha_helix(angles) == 1 {
        return SecondaryStructure { n_helix: ss.n_helix + 1, n_sheet: ss.n_sheet, n_turn: ss.n_turn, n_coil: ss.n_coil };
    }
    if torsion_angles_is_beta_sheet(angles) == 1 {
        return SecondaryStructure { n_helix: ss.n_helix, n_sheet: ss.n_sheet + 1, n_turn: ss.n_turn, n_coil: ss.n_coil };
    }
    return SecondaryStructure { n_helix: ss.n_helix, n_sheet: ss.n_sheet, n_turn: ss.n_turn, n_coil: ss.n_coil + 1 };
}

pub fn secondary_structure_helix_count(ss: SecondaryStructure) -> Int {
    return ss.n_helix;
}

pub fn secondary_structure_sheet_count(ss: SecondaryStructure) -> Int {
    return ss.n_sheet;
}
