// # Chemical SMILES Facade
//
// Logline: Re-exports SMILES chemical representations, parser engines, molecular graphs, fingerprints, and stubs.
//
// Setup: Pure module shim importing chemical SMILES companion submodules.
//
// Beats:
//   1. Import SMILES data types, parser routines, molecular graph operations, and chemical fingerprint engines.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain backwards compatibility with cheminformatics analysis pipelines.

import "./smiles_ops.oo";
import "./smiles_parse.oo";
import "./smiles_engine.oo";
import "./smiles_stubs.oo";

pub fn shim_marker_atom_default_valency() -> Int {
    return atom_default_valency(6);
}

pub fn shim_marker_atom_symbol() -> Int {
    return atom_symbol_to_number("C");
}

pub fn shim_marker_mol_init() -> SmilesMolecule {
    return smiles_molecule_init("C");
}

pub fn shim_marker_fp_empty() -> Fingerprint {
    return fingerprint_create_empty(64, "ecfp");
}

pub fn shim_marker_do_work(mol: &SmilesMolecule) -> Int {
    return smiles_do_work(mol);
}
