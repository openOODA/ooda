// # Protein Biophysics & Backbone Metrics
//
// Logline: Residue registration, centroid, hydrophobic ratio, H-bond energy. Destubbed off &mut / pub type.
//
// Setup: By-value ProteinBackbone. AminoAcid table from IUPAC residue masses.
//
// Beats:
//   1. Add residues; accumulate mass, charge, hydrophobic count, CA sums.
//   2. Center of mass = CA sum / count.
//   3. Kabsch-Sander-style H-bond energy in millical/mol.

import "./protein_ops.oo";

type ProteinBackbone = struct {
    id: Int,
    residue_count: Int,
    total_mass: Int,
    net_charge: Int,
    hydrophobic_count: Int,
    ca_sum_x: Int,
    ca_sum_y: Int,
    ca_sum_z: Int
};

type AminoAcid = struct {
    code_id: Int,
    charge: Int,
    is_hydrophobic: Int,
    is_polar: Int,
    is_aromatic: Int,
    mass: Int,
    pKa_sidechain: Int
};

pub fn protein_backbone_new(id: Int) -> ProteinBackbone {
    return ProteinBackbone {
        id: id,
        residue_count: 0,
        total_mass: 0,
        net_charge: 0,
        hydrophobic_count: 0,
        ca_sum_x: 0,
        ca_sum_y: 0,
        ca_sum_z: 0
    };
}

// Standard residue masses in centi-Daltons (Ala 71.08 Da = 7108).
pub fn amino_acid_from_code(code_id: Int) -> AminoAcid {
    if code_id == 1 {
        return AminoAcid { code_id: 1, charge: 0, is_hydrophobic: 1, is_polar: 0, is_aromatic: 0, mass: 7108, pKa_sidechain: 0 };
    }
    if code_id == 2 {
        return AminoAcid { code_id: 2, charge: 100, is_hydrophobic: 0, is_polar: 1, is_aromatic: 0, mass: 15619, pKa_sidechain: 1248 };
    }
    if code_id == 3 {
        return AminoAcid { code_id: 3, charge: 0, is_hydrophobic: 0, is_polar: 1, is_aromatic: 0, mass: 11410, pKa_sidechain: 0 };
    }
    if code_id == 4 {
        return AminoAcid { code_id: 4, charge: 0 - 100, is_hydrophobic: 0, is_polar: 1, is_aromatic: 0, mass: 11509, pKa_sidechain: 365 };
    }
    if code_id == 5 {
        return AminoAcid { code_id: 5, charge: 0, is_hydrophobic: 1, is_polar: 0, is_aromatic: 0, mass: 10314, pKa_sidechain: 818 };
    }
    if code_id == 6 {
        return AminoAcid { code_id: 6, charge: 0, is_hydrophobic: 0, is_polar: 1, is_aromatic: 0, mass: 12813, pKa_sidechain: 0 };
    }
    if code_id == 7 {
        return AminoAcid { code_id: 7, charge: 0 - 100, is_hydrophobic: 0, is_polar: 1, is_aromatic: 0, mass: 12912, pKa_sidechain: 425 };
    }
    if code_id == 8 {
        return AminoAcid { code_id: 8, charge: 0, is_hydrophobic: 0, is_polar: 0, is_aromatic: 0, mass: 5705, pKa_sidechain: 0 };
    }
    if code_id == 9 {
        return AminoAcid { code_id: 9, charge: 0, is_hydrophobic: 0, is_polar: 1, is_aromatic: 1, mass: 13714, pKa_sidechain: 600 };
    }
    if code_id == 10 {
        return AminoAcid { code_id: 10, charge: 0, is_hydrophobic: 1, is_polar: 0, is_aromatic: 0, mass: 11316, pKa_sidechain: 0 };
    }
    if code_id == 11 {
        return AminoAcid { code_id: 11, charge: 0, is_hydrophobic: 1, is_polar: 0, is_aromatic: 0, mass: 11316, pKa_sidechain: 0 };
    }
    if code_id == 12 {
        return AminoAcid { code_id: 12, charge: 100, is_hydrophobic: 0, is_polar: 1, is_aromatic: 0, mass: 12817, pKa_sidechain: 1053 };
    }
    if code_id == 13 {
        return AminoAcid { code_id: 13, charge: 0, is_hydrophobic: 1, is_polar: 0, is_aromatic: 0, mass: 13120, pKa_sidechain: 0 };
    }
    if code_id == 14 {
        return AminoAcid { code_id: 14, charge: 0, is_hydrophobic: 1, is_polar: 0, is_aromatic: 1, mass: 14718, pKa_sidechain: 0 };
    }
    if code_id == 15 {
        return AminoAcid { code_id: 15, charge: 0, is_hydrophobic: 1, is_polar: 0, is_aromatic: 0, mass: 9712, pKa_sidechain: 0 };
    }
    if code_id == 16 {
        return AminoAcid { code_id: 16, charge: 0, is_hydrophobic: 0, is_polar: 1, is_aromatic: 0, mass: 8708, pKa_sidechain: 0 };
    }
    if code_id == 17 {
        return AminoAcid { code_id: 17, charge: 0, is_hydrophobic: 0, is_polar: 1, is_aromatic: 0, mass: 10111, pKa_sidechain: 0 };
    }
    if code_id == 18 {
        return AminoAcid { code_id: 18, charge: 0, is_hydrophobic: 1, is_polar: 0, is_aromatic: 1, mass: 18621, pKa_sidechain: 0 };
    }
    if code_id == 19 {
        return AminoAcid { code_id: 19, charge: 0, is_hydrophobic: 0, is_polar: 1, is_aromatic: 1, mass: 16318, pKa_sidechain: 1007 };
    }
    if code_id == 20 {
        return AminoAcid { code_id: 20, charge: 0, is_hydrophobic: 1, is_polar: 0, is_aromatic: 0, mass: 9913, pKa_sidechain: 0 };
    }
    return AminoAcid {
        code_id: 0,
        charge: 0,
        is_hydrophobic: 0,
        is_polar: 0,
        is_aromatic: 0,
        mass: 0,
        pKa_sidechain: 0
    };
}

pub fn amino_acid_mass(aa: AminoAcid) -> Int {
    return aa.mass;
}

pub fn amino_acid_charge(aa: AminoAcid) -> Int {
    return aa.charge;
}

pub fn protein_backbone_add_residue(pb: ProteinBackbone, aa: AminoAcid, ca_pos: Point3D) -> ProteinBackbone {
    let mut hydro: Int = pb.hydrophobic_count;
    if aa.is_hydrophobic == 1 {
        hydro = hydro + 1;
    }
    return ProteinBackbone {
        id: pb.id,
        residue_count: pb.residue_count + 1,
        total_mass: pb.total_mass + aa.mass,
        net_charge: pb.net_charge + aa.charge,
        hydrophobic_count: hydro,
        ca_sum_x: pb.ca_sum_x + ca_pos.x,
        ca_sum_y: pb.ca_sum_y + ca_pos.y,
        ca_sum_z: pb.ca_sum_z + ca_pos.z
    };
}

pub fn protein_backbone_center_of_mass(pb: ProteinBackbone) -> Point3D {
    let count: Int = pb.residue_count;
    if count == 0 {
        return Point3D { x: 0, y: 0, z: 0 };
    }
    let cx: Int = pb.ca_sum_x / count;
    let cy: Int = pb.ca_sum_y / count;
    let cz: Int = pb.ca_sum_z / count;
    return Point3D { x: cx, y: cy, z: cz };
}

pub fn protein_backbone_get_residue_count(pb: ProteinBackbone) -> Int {
    return pb.residue_count;
}

pub fn protein_backbone_get_total_mass(pb: ProteinBackbone) -> Int {
    return pb.total_mass;
}

pub fn protein_backbone_get_net_charge(pb: ProteinBackbone) -> Int {
    return pb.net_charge;
}

pub fn protein_backbone_hydrophobic_ratio(pb: ProteinBackbone) -> Int {
    let count: Int = pb.residue_count;
    if count == 0 {
        return 0;
    }
    return (pb.hydrophobic_count * 1000) / count;
}

// E = 332000 * (1/r_ON + 1/r_CH - 1/r_OH - 1/r_CN) millical/mol.
pub fn hydrogen_bond_energy(donor_n: Point3D, donor_h: Point3D, acceptor_o: Point3D, acceptor_c: Point3D) -> Int {
    let r_on: Int = point3d_dist(donor_n, acceptor_o);
    let r_ch: Int = point3d_dist(acceptor_c, donor_h);
    let r_oh: Int = point3d_dist(acceptor_o, donor_h);
    let r_cn: Int = point3d_dist(acceptor_c, donor_n);
    if r_oh == 0 {
        return 0;
    }
    if r_on == 0 {
        return 0;
    }
    if r_ch == 0 {
        return 0;
    }
    if r_cn == 0 {
        return 0;
    }
    let term_on: Int = 332000 / r_on;
    let term_ch: Int = 332000 / r_ch;
    let term_oh: Int = 332000 / r_oh;
    let term_cn: Int = 332000 / r_cn;
    let e: Int = (term_on + term_ch) - (term_oh + term_cn);
    return e;
}
