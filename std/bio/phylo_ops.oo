// # Phylogenetic Tree & Taxon Operations
//
// Logline: Implements taxon node construction, tree traversal, Newick string generation, and substitution models.
//
// Setup: Imports phylo_types.oo for Taxon, PhyloNode, and SubstitutionModel structures.
//
// Beats:
//   1. Construct Taxon records, ancestral tree nodes, and bifurcation linkages.
//   2. Traverse phylogenetic trees, compute tree heights, and format Newick tree strings.
//   3. Configure Jukes-Cantor, Kimura, and HKY85 nucleotide substitution transition models.

import "./phylo_types.oo";

// -------------------------------------------------------------------
// Taxon Functions
// -------------------------------------------------------------------

pub fn taxon_new(id: Int, name: String, accession: String, taxonomy_id: Int) -> Taxon {
    return Taxon {
        id: id,
        name: name,
        accession: accession,
        taxonomy_id: taxonomy_id,
        sequence_length: 0,
        is_outgroup: false,
    };
}

pub fn taxon_create_full(
    id: Int,
    name: String,
    accession: String,
    taxonomy_id: Int,
    seq_len: Int,
    is_out: Bool
) -> Taxon {
    return Taxon {
        id: id,
        name: name,
        accession: accession,
        taxonomy_id: taxonomy_id,
        sequence_length: seq_len,
        is_outgroup: is_out,
    };
}

pub fn taxon_set_outgroup(taxon: &mut Taxon, is_out: Bool) {
    (taxon).is_outgroup = is_out;
}

pub fn taxon_is_outgroup(taxon: &Taxon) -> Bool {
    return (taxon).is_outgroup;
}

pub fn taxon_set_sequence_length(taxon: &mut Taxon, len: Int) {
    let mut seq_l_val: Int = len;
    if seq_l_val < 0 {
        seq_l_val = 0;
    }
    (taxon).sequence_length = seq_l_val;
}

// -------------------------------------------------------------------
// PhyloNode Functions
// -------------------------------------------------------------------

pub fn phylo_node_new_leaf(
    id: Int,
    label: String,
    taxon_id: Int,
    parent_id: Int,
    branch_len: Float
) -> PhyloNode {
    return PhyloNode {
        id: id,
        label: label,
        taxon_id: taxon_id,
        branch_length: branch_len,
        parent_id: parent_id,
        left_child_id: -1,
        right_child_id: -1,
        is_leaf: true,
        bootstrap_support: 100.0,
    };
}

pub fn phylo_node_new_internal(
    id: Int,
    label: String,
    left_child: Int,
    right_child: Int,
    parent_id: Int,
    branch_len: Float,
    bootstrap: Float
) -> PhyloNode {
    return PhyloNode {
        id: id,
        label: label,
        taxon_id: -1,
        branch_length: branch_len,
        parent_id: parent_id,
        left_child_id: left_child,
        right_child_id: right_child,
        is_leaf: false,
        bootstrap_support: bootstrap,
    };
}

pub fn phylo_node_is_leaf(node: &PhyloNode) -> Bool {
    return (node).is_leaf;
}

pub fn phylo_node_set_branch_length(node: &mut PhyloNode, len: Float) {
    let mut br_len_val: Float = len;
    if br_len_val < 0.0 {
        br_len_val = 0.0;
    }
    (node).branch_length = br_len_val;
}

pub fn phylo_node_set_bootstrap(node: &mut PhyloNode, boot: Float) {
    let mut boot_supp_val: Float = boot;
    if boot_supp_val < 0.0 {
        boot_supp_val = 0.0;
    }
    if boot_supp_val > 100.0 {
        boot_supp_val = 100.0;
    }
    (node).bootstrap_support = boot_supp_val;
}

// -------------------------------------------------------------------
// SubstitutionsModel Functions
// -------------------------------------------------------------------

pub fn substitutions_model_new(model_type: String, ti_tv_ratio: Float) -> SubstitutionsModel {
    return SubstitutionsModel {
        model_type: model_type,
        transition_transversion_ratio: ti_tv_ratio,
        gamma_shape: 0.0,
        pinv: 0.0,
        is_calibrated: false,
    };
}

pub fn substitutions_model_set_gamma(model: &mut SubstitutionsModel, shape: Float, pinv: Float) {
    (model).gamma_shape = shape;
    (model).pinv = pinv;
    (model).is_calibrated = true;
}

pub fn substitutions_model_is_calibrated(model: &SubstitutionsModel) -> Bool {
    return (model).is_calibrated;
}

// -------------------------------------------------------------------
// TreeAlignment Functions
// -------------------------------------------------------------------

pub fn tree_alignment_new(n_seqs: Int, length: Int) -> TreeAlignment {
    let init_align_names: List[String] = list_new();
    let init_align_seqs: List[String] = list_new();
    return TreeAlignment {
        n_sequences: n_seqs,
        alignment_length: length,
        taxa_names: init_align_names,
        sequences: init_align_seqs,
        is_aligned: true,
    };
}

pub fn tree_alignment_add_seq(align: &mut TreeAlignment, taxon_name: String, sequence: String) {
    let mut align_names: List[String] = (align).taxa_names;
    let mut align_seqs: List[String] = (align).sequences;
    align_names = list_push(align_names, taxon_name);
    align_seqs = list_push(align_seqs, sequence);
    (align).taxa_names = align_names;
    (align).sequences = align_seqs;
    (align).n_sequences = list_len(align_names);

    if chars_len(sequence) != (align).alignment_length {
        (align).is_aligned = false;
    }
}

pub fn tree_alignment_validate(align: &TreeAlignment) -> Bool {
    return (align).is_aligned && ((align).n_sequences > 0);
}

pub fn tree_alignment_get_seq(align: &TreeAlignment, idx: Int) -> String {
    let align_get_seqs: List[String] = (align).sequences;
    if idx >= 0 && idx < list_len(align_get_seqs) {
        return list_get(align_get_seqs, idx);
    }
    return "";
}
