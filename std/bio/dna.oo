// # DNA Sequence Metrics, K-mer Index & Pairwise Alignment
//
// Logline: Nucleotide length/GC metrics, sliding k-mer totals, identity alignment. Destubbed off pub type / &mut.
//
// Setup: By-value Int payloads. No String sequence buffer.
//
// Beats:
//   1. DnaSequence validity, AT complement of GC percent.
//   2. Hamming on length + GC; k-mer window total (L-k+1).
//   3. Alignment identity = matches / (matches+mismatches+gaps).

type DnaSequence = struct {
    id: Int,
    seq_n: Int,
    gc_content_pct: Int,
    quality_score: Int,
    is_valid: Int
};

type KmerIndex = struct {
    k: Int,
    kmer_total: Int,
    unique_kmers: Int,
    total_bases: Int,
    alloc_bytes: Int
};

type AlignmentResult = struct {
    query_id: Int,
    ref_id: Int,
    score: Int,
    matches: Int,
    mismatches: Int,
    gaps: Int,
    identity_pct: Int,
    cigar_n: Int
};

type BioSequencer = struct {
    device_id: Int,
    flow_cell_id: Int,
    read_total: Int,
    is_running: Int
};

pub fn dna_sequence_new(id: Int, seq_n: Int, gc_pct: Int, qual: Int) -> DnaSequence {
    let valid: Int = if seq_n >= 0 { 1 } else { 0 };
    return DnaSequence {
        id: id,
        seq_n: seq_n,
        gc_content_pct: gc_pct,
        quality_score: qual,
        is_valid: valid
    };
}

pub fn dna_sequence_valid(seq: DnaSequence) -> Int {
    return seq.is_valid;
}

pub fn dna_sequence_n(seq: DnaSequence) -> Int {
    return seq.seq_n;
}

pub fn dna_sequence_gc_content(seq: DnaSequence) -> Int {
    return seq.gc_content_pct;
}

pub fn dna_sequence_qual(seq: DnaSequence) -> Int {
    return seq.quality_score;
}

pub fn dna_sequence_estimate_at_content(seq: DnaSequence) -> Int {
    let gc: Int = seq.gc_content_pct;
    if gc > 100 {
        return 0;
    }
    return 100 - gc;
}

pub fn int_abs(x: Int) -> Int {
    if x < 0 {
        return 0 - x;
    }
    return x;
}

pub fn dna_sequence_hamming_distance(s1: DnaSequence, s2: DnaSequence) -> Int {
    let len_diff: Int = int_abs(s1.seq_n - s2.seq_n);
    let gc_diff: Int = int_abs(s1.gc_content_pct - s2.gc_content_pct);
    return len_diff + gc_diff;
}

pub fn kmer_index_new(k: Int) -> KmerIndex {
    return KmerIndex {
        k: k,
        kmer_total: 0,
        unique_kmers: 0,
        total_bases: 0,
        alloc_bytes: 0
    };
}

pub fn kmer_index_add_sequence(idx: KmerIndex, seq: DnaSequence) -> KmerIndex {
    if seq.is_valid == 0 {
        return idx;
    }
    let k_n: Int = idx.k;
    let s_n: Int = seq.seq_n;
    let added: Int = if s_n >= k_n { (s_n - k_n) + 1 } else { 0 };
    return KmerIndex {
        k: idx.k,
        kmer_total: idx.kmer_total + added,
        unique_kmers: idx.unique_kmers,
        total_bases: idx.total_bases + s_n,
        alloc_bytes: idx.alloc_bytes
    };
}

pub fn kmer_index_get_total(idx: KmerIndex) -> Int {
    return idx.kmer_total;
}

pub fn kmer_index_get_total_bases(idx: KmerIndex) -> Int {
    return idx.total_bases;
}

pub fn alignment_result_new(query_id: Int, ref_id: Int, score: Int, matches: Int, mismatches: Int, gaps: Int) -> AlignmentResult {
    let total_aligned: Int = matches + mismatches + gaps;
    let id_pct: Int = if total_aligned > 0 { (matches * 100) / total_aligned } else { 0 };
    return AlignmentResult {
        query_id: query_id,
        ref_id: ref_id,
        score: score,
        matches: matches,
        mismatches: mismatches,
        gaps: gaps,
        identity_pct: id_pct,
        cigar_n: total_aligned
    };
}

pub fn alignment_result_score(res: AlignmentResult) -> Int {
    return res.score;
}

pub fn alignment_result_identity(res: AlignmentResult) -> Int {
    return res.identity_pct;
}

pub fn align_sequences(query: DnaSequence, reference: DnaSequence, match_score: Int, mismatch_penalty: Int, gap_penalty: Int) -> AlignmentResult {
    let q_n: Int = query.seq_n;
    let r_n: Int = reference.seq_n;
    let min_n: Int = if q_n < r_n { q_n } else { r_n };
    let n_diff: Int = if q_n > r_n { q_n - r_n } else { r_n - q_n };
    let calc_score: Int = (min_n * match_score) - (n_diff * gap_penalty);
    return alignment_result_new(query.id, reference.id, calc_score, min_n, 0, n_diff);
}

pub fn bio_sequencer_new(device_id: Int, flow_cell_id: Int) -> BioSequencer {
    return BioSequencer {
        device_id: device_id,
        flow_cell_id: flow_cell_id,
        read_total: 0,
        is_running: 0
    };
}

pub fn bio_sequencer_device(seq: BioSequencer) -> Int {
    return seq.device_id;
}
