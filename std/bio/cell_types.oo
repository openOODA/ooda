// # Cellular Biology Data Types
//
// Logline: CellPopulation destubbed off List[AgentCell] to Int counts.
//
// Setup: Pure Int population bookkeeping.
//
// Beats:
//   1. cell_pop_new initial_count.
// residual: List[AgentCell] destubbed.

type CellPopulation = struct {
    initial_count: Int,
    current_count: Int
};

pub fn cell_pop_new(initial_count: Int) -> CellPopulation {
    return CellPopulation {
        initial_count: initial_count,
        current_count: initial_count
    };
}

pub fn cell_pop_current(p: CellPopulation) -> Int {
    return p.current_count;
}
