// # Protein Biochemistry Facade
//
// Logline: Re-exports amino acid types, backbone geometry, torsion angles, Ramachandran maps, and biophysics stubs.
//
// Setup: Pure module shim importing protein companion submodules.
//
// Beats:
//   1. Import amino acid properties, backbone geometry, Ramachandran dihedral angles, and biophysics engines.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain backwards compatibility with structural biology pipelines.

import "./protein_types.oo";
import "./protein_ops.oo";
import "./protein_engine.oo";
import "./protein_stubs.oo";

pub fn shim_marker_point3d_new() -> Point3D {
    return point3d_new(0, 0, 0);
}

pub fn shim_marker_point3d_dist() -> Int {
    let a: Point3D = point3d_new(0, 0, 0);
    let b: Point3D = point3d_new(300, 400, 0);
    return point3d_dist(a, b);
}

pub fn shim_marker_amino_acid() -> AminoAcid {
    return amino_acid_from_code(1);
}

pub fn shim_marker_amino_acid_mass() -> Int {
    let aa: AminoAcid = amino_acid_from_code(1);
    return amino_acid_mass(aa);
}

pub fn shim_marker_torsion_new() -> TorsionAngles {
    return torsion_angles_new(-60000, -45000, 180000, 0);
}

pub fn shim_marker_ramachandran_region() -> Int {
    let t: TorsionAngles = torsion_angles_new(-60000, -45000, 180000, 0);
    return torsion_angles_ramachandran_region(t);
}

pub fn shim_marker_rama_plot() -> RamachandranPlot {
    return ramachandran_plot_new();
}

pub fn shim_marker_ss_new() -> SecondaryStructure {
    return secondary_structure_new();
}

pub fn shim_marker_backbone_new() -> ProteinBackbone {
    return protein_backbone_new(1);
}

pub fn shim_marker_backbone_count() -> Int {
    let pb: ProteinBackbone = protein_backbone_new(1);
    return protein_backbone_get_residue_count(&pb);
}

pub fn shim_marker_hbond_energy() -> Int {
    let n: Point3D = point3d_new(0, 0, 0);
    let h: Point3D = point3d_new(100, 0, 0);
    let o: Point3D = point3d_new(300, 0, 0);
    let c: Point3D = point3d_new(400, 0, 0);
    return hydrogen_bond_energy(n, h, o, c);
}
