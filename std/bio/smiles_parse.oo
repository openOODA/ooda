// # Chemical SMILES String Parser
//
// Logline: Parses simplified molecular-input line-entry system (SMILES) strings into explicit molecular atom-bond graphs.
//
// Setup: Imports smiles_ops.oo for atom creation, ring closure management, and molecular graphs.
//
// Beats:
//   1. Lex and parse SMILES characters (aliphatic, aromatic, branch parentheses, ring numbers).
//   2. Track branch stack hierarchies and ring closure partner connections.
//   3. Calculate implicit hydrogen counts and assemble verified SmilesMolecule structures.

import "./smiles_ops.oo";

pub fn smiles_molecule_parse(smiles_str: String) -> SmilesMolecule {
    let mut atoms: List[Atom] = list_new();
    let mut bonds: List[Bond] = list_new();
    let slen: Int = smiles_str.len();
    let mut i = 0;
    let mut branch_stack: List[Int] = list_new();
    let mut ring_atoms: List[Int] = list_new();
    let mut r = 0;
    while r < 10 {
        ring_atoms = list_push(ring_atoms, 0 - 1);
        r = r + 1;
    }
    let mut last_atom_idx = 0 - 1;
    let mut next_bond_type = 1;
    let mut is_next_bond_aromatic = false;
    let mut ring_count = 0;
    while i < slen {
        let byte_val: Int = byte_at(smiles_str, i);
        if byte_val == 45 {
            // '-' Single bond
            next_bond_type = 1;
            is_next_bond_aromatic = false;
            i = i + 1;
        } else if byte_val == 61 {
            // '=' Double bond
            next_bond_type = 2;
            is_next_bond_aromatic = false;
            i = i + 1;
        } else if byte_val == 35 {
            // '#' Triple bond
            next_bond_type = 3;
            is_next_bond_aromatic = false;
            i = i + 1;
        } else if byte_val == 58 {
            // ':' Aromatic bond
            next_bond_type = 4;
            is_next_bond_aromatic = true;
            i = i + 1;
        } else if byte_val == 40 {
            // '(' Branch open
            if last_atom_idx >= 0 {
                branch_stack = list_push(branch_stack, last_atom_idx);
            }
            i = i + 1;
        } else if byte_val == 41 {
            // ')' Branch close
            let st_len: Int = list_len(branch_stack);
            if st_len > 0 {
                let pop_idx: Int = list_get(branch_stack, st_len - 1);
                let mut new_st: List[Int] = list_new();
                let mut k = 0;
                while k < (st_len - 1) {
                    let st_elem: Int = list_get(branch_stack, k);
                    new_st = list_push(new_st, st_elem);
                    k = k + 1;
                }
                branch_stack = new_st;
                last_atom_idx = pop_idx;
            }
            i = i + 1;
        } else if (byte_val >= 49) && (byte_val <= 57) {
            // '1'..'9' Ring closure digits
            let digit = byte_val - 48;
            let prev_ring_atom: Int = list_get(ring_atoms, digit);
            if prev_ring_atom >= 0 {
                if last_atom_idx >= 0 {
                    let r_bond = bond_create(last_atom_idx, prev_ring_atom, next_bond_type, is_next_bond_aromatic);
                    bonds = list_push(bonds, r_bond);
                    ring_count = ring_count + 1;
                }
                let mut new_rings: List[Int] = list_new();
                let mut r_i = 0;
                while r_i < 10 {
                    if r_i == digit {
                        new_rings = list_push(new_rings, 0 - 1);
                    } else {
                        let elem_r: Int = list_get(ring_atoms, r_i);
                        new_rings = list_push(new_rings, elem_r);
                    }
                    r_i = r_i + 1;
                }
                ring_atoms = new_rings;
            } else {
                if last_atom_idx >= 0 {
                    let mut new_rings2: List[Int] = list_new();
                    let mut r_i2 = 0;
                    while r_i2 < 10 {
                        if r_i2 == digit {
                            new_rings2 = list_push(new_rings2, last_atom_idx);
                        } else {
                            let elem_r2: Int = list_get(ring_atoms, r_i2);
                            new_rings2 = list_push(new_rings2, elem_r2);
                        }
                        r_i2 = r_i2 + 1;
                    }
                    ring_atoms = new_rings2;
                }
            }
            next_bond_type = 1;
            is_next_bond_aromatic = false;
            i = i + 1;
        } else {
            let mut symbol = "";
            let mut is_aro = false;
            let mut atomic_num = 0;
            if (byte_val == 67) && ((i + 1) < slen) && (byte_at(smiles_str, i + 1) == 108) {
                symbol = "Cl";
                atomic_num = 17;
                i = i + 2;
            } else if (byte_val == 66) && ((i + 1) < slen) && (byte_at(smiles_str, i + 1) == 114) {
                symbol = "Br";
                atomic_num = 35;
                i = i + 2;
            } else if byte_val == 67 {
                symbol = "C";
                atomic_num = 6;
                i = i + 1;
            } else if byte_val == 99 {
                symbol = "c";
                atomic_num = 6;
                is_aro = true;
                i = i + 1;
            } else if byte_val == 78 {
                symbol = "N";
                atomic_num = 7;
                i = i + 1;
            } else if byte_val == 110 {
                symbol = "n";
                atomic_num = 7;
                is_aro = true;
                i = i + 1;
            } else if byte_val == 79 {
                symbol = "O";
                atomic_num = 8;
                i = i + 1;
            } else if byte_val == 111 {
                symbol = "o";
                atomic_num = 8;
                is_aro = true;
                i = i + 1;
            } else if byte_val == 83 {
                symbol = "S";
                atomic_num = 16;
                i = i + 1;
            } else if byte_val == 115 {
                symbol = "s";
                atomic_num = 16;
                is_aro = true;
                i = i + 1;
            } else if byte_val == 80 {
                symbol = "P";
                atomic_num = 15;
                i = i + 1;
            } else if byte_val == 112 {
                symbol = "p";
                atomic_num = 15;
                is_aro = true;
                i = i + 1;
            } else if byte_val == 70 {
                symbol = "F";
                atomic_num = 9;
                i = i + 1;
            } else if byte_val == 73 {
                symbol = "I";
                atomic_num = 53;
                i = i + 1;
            } else if byte_val == 66 {
                symbol = "B";
                atomic_num = 5;
                i = i + 1;
            } else if byte_val == 72 {
                symbol = "H";
                atomic_num = 1;
                i = i + 1;
            } else {
                i = i + 1;
            }
            if atomic_num > 0 {
                let default_v: Int = atom_default_valency(atomic_num);
                let cur_idx: Int = list_len(atoms);
                let atom_obj = atom_create(symbol, atomic_num, 0, default_v, is_aro, 0, 0);
                atoms = list_push(atoms, atom_obj);
                if last_atom_idx >= 0 {
                    let btype = if is_aro && is_next_bond_aromatic { 4 } else { next_bond_type };
                    let new_bond = bond_create(last_atom_idx, cur_idx, btype, is_aro || is_next_bond_aromatic);
                    bonds = list_push(bonds, new_bond);
                }
                last_atom_idx = cur_idx;
                next_bond_type = 1;
                is_next_bond_aromatic = false;
            }
        }
    }
    let mut updated_atoms: List[Atom] = list_new();
    let num_atoms: Int = list_len(atoms);
    let num_bonds: Int = list_len(bonds);
    let mut a_idx = 0;
    while a_idx < num_atoms {
        let cur_a: Atom = list_get(atoms, a_idx);
        let mut total_bond_valency = 0;
        let mut b_i = 0;
        while b_i < num_bonds {
            let b_obj: Bond = list_get(bonds, b_i);
            let b_a1: Int = b_obj.atom1_idx;
            let b_a2: Int = b_obj.atom2_idx;
            let b_type: Int = b_obj.bond_type;
            if (b_a1 == a_idx) || (b_a2 == a_idx) {
                total_bond_valency = total_bond_valency + b_type;
            }
            b_i = b_i + 1;
        }
        let cur_valency: Int = cur_a.valency;
        let mut imp_h = cur_valency - total_bond_valency;
        if imp_h < 0 {
            imp_h = 0;
        }
        let sym_val: String = cur_a.symbol;
        let z_val: Int = cur_a.atomic_number;
        let chg_val: Int = cur_a.charge;
        let aro_val: Bool = cur_a.is_aromatic;
        let iso_val: Int = cur_a.isotope;
        let fixed_a = atom_create(sym_val, z_val, chg_val, cur_valency, aro_val, iso_val, imp_h);
        updated_atoms = list_push(updated_atoms, fixed_a);
        a_idx = a_idx + 1;
    }
    let calc_mw: Int = smiles_molecule_weight(updated_atoms);
    let calc_form: String = smiles_molecule_formula(updated_atoms);
    return SmilesMolecule {
        smiles_raw: smiles_str,
        formula: calc_form,
        atoms: updated_atoms,
        bonds: bonds,
        molecular_weight: calc_mw,
        atom_count: list_len(updated_atoms),
        bond_count: list_len(bonds),
        ring_count: ring_count,
        is_valid: true
    };
}
