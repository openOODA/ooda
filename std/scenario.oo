// package: std — scenario verb library (storytelling / Given-When-Then)
// job: scenario / check / expect_* verbs; compose with std::test
// caps: &ProcessCap (command verbs), &FsReadCap (file probes)

import "std/os/process.oo";
import "std/os/fs.oo";
import "std/str.oo";

pub fn scenario(p: &ProcessCap, fs: &FsReadCap, name: String) -> Result[Void, String] {
    println("--- scenario: " + name + " ---");
    let w: Result[String, String] = process_exec(p, "true");
    if w.is_err() {
        return Err("scenario warmup failed");
    }
    return Ok(void);
}

pub fn check(p: &ProcessCap, cmd: String, within: Int) -> Result[Void, String]
    requires chars_len(cmd) > 0
    requires within > 0
{
    let r: Result[String, String] = process_exec(p, cmd);
    if r.is_err() {
        return Err("check failed (timeout " + within.to_string() + "s): " + cmd);
    }
    return Ok(void);
}

pub fn expect_present(fs: &FsReadCap, path: String) -> Result[Void, String] {
    if !fs_path_exists(fs, path) {
        return Err("expected present: " + path);
    }
    return Ok(void);
}

pub fn expect_absent(fs: &FsReadCap, path: String) -> Result[Void, String] {
    if fs_path_exists(fs, path) {
        return Err("expected absent: " + path);
    }
    return Ok(void);
}

pub fn expect_line_count(fs: &FsReadCap, path: String, n: Int) -> Result[Void, String] {
    let r: Result[String, String] = fs_read_file(fs, path);
    if r.is_err() {
        return Err("line_count: cannot read " + path);
    }
    let body: String = match r { Ok(s) => s, Err(_) => "" };
    let len: Int = chars_len(body);
    let mut lines: Int = 0;
    if len > 0 {
        lines = 1;
        let mut i: Int = 0;
        while i < len {
            if char_at(body, i) == "\n" { lines = lines + 1; }
            i = i + 1;
        }
    }
    if lines != n {
        return Err("line_count " + path + " got " + lines.to_string() + " want " + n.to_string());
    }
    return Ok(void);
}

pub fn expect_substring(fs: &FsReadCap, path: String, needle: String) -> Result[Void, String] {
    let r: Result[String, String] = fs_read_file(fs, path);
    if r.is_err() {
        return Err("substring: cannot read " + path);
    }
    let body: String = match r { Ok(s) => s, Err(_) => "" };
    if !str_contains(body, needle) {
        return Err("substring missing in " + path + ": " + needle);
    }
    return Ok(void);
}

pub fn expect_quiet(p: &ProcessCap, cmd: String) -> Result[Void, String]
    requires chars_len(cmd) > 0
{
    let r: Result[String, String] = process_exec(p, cmd);
    if r.is_err() {
        return Err("expect_quiet: command failed: " + cmd);
    }
    let out: String = match r { Ok(s) => s, Err(_) => "" };
    if !str_is_empty(out) {
        return Err("expect_quiet: stdout not empty: " + cmd);
    }
    return Ok(void);
}

pub fn expect_no_phantoms(fs: &FsReadCap, dir: String, allow: List[String]) -> Result[Void, String] {
    let entries: List[String] = fs_walk(fs, dir);
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        let entry: String = list_get(entries, i);
        if ends_with(entry, ".oo") {
            let mut allowed: Bool = false;
            let m: Int = list_len(allow);
            let mut j: Int = 0;
            while j < m {
                if entry == list_get(allow, j) { allowed = true; break; }
                j = j + 1;
            }
            if !allowed { return Err("phantom .oo: " + entry); }
        }
        i = i + 1;
    }
    return Ok(void);
}

pub fn expect_count(fs: &FsReadCap, dir: String, pattern: String, n: Int) -> Result[Void, String] {
    let entries: List[String] = fs_walk(fs, dir);
    let total: Int = list_len(entries);
    let mut hits: Int = 0;
    let mut i: Int = 0;
    while i < total {
        if str_contains(list_get(entries, i), pattern) { hits = hits + 1; }
        i = i + 1;
    }
    if hits != n {
        return Err("count " + pattern + " got " + hits.to_string() + " want " + n.to_string());
    }
    return Ok(void);
}

pub fn expect_clean(p: &ProcessCap, cmd: String) -> Result[Void, String]
    requires chars_len(cmd) > 0
{
    let r: Result[String, String] = process_exec(p, cmd);
    if r.is_err() {
        return Err("expect_clean failed: " + cmd);
    }
    return Ok(void);
}

pub fn expect_equal(a: String, b: String) -> Result[Void, String] {
    if !str_eq(a, b) {
        return Err("expect_equal: '" + a + "' != '" + b + "'");
    }
    return Ok(void);
}

pub fn expect_lt(a: Int, b: Int) -> Result[Void, String] {
    if a >= b {
        return Err("expect_lt: " + a.to_string() + " >= " + b.to_string());
    }
    return Ok(void);
}