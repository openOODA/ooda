// # System Cross-Backend Execution & State Parity Engine
//
// Logline: Dispatches CLI builds and captures process exit codes, stdout streams, and memory state hashes across compiler backends.
//
// Setup: Low-level multi-compiler execution primitives under ProcessCap for cross-backend verification.
//
// Beats:
//   1. Define BackendDispatch, MemoryStateSpec, ProcessCapture, and CrossValSession structures.
//   2. Configure backend CLI compilation dispatch arguments.
//   3. Compute deterministic memory state hashes from execution streams.
//   4. Capture and normalize process execution outputs.
//   5. Evaluate cross-backend parity across process captures.
// RULES.oot 1.4: Capability-gated process cross-validation.
// RULES.oot 1.7: Strictly under 256 lines.

pub type BackendDispatch = struct {
    backend_id: String,
    cli_flag: String,
    output_ext: String,
    is_direct_elf: Bool
};

pub type MemoryStateSpec = struct {
    allocated_bytes: Int,
    stack_depth: Int,
    state_hash_hex: String,
    alignment_bytes: Int
};

pub type ProcessCapture = struct {
    backend_id: String,
    exit_code: Int,
    stdout_text: String,
    is_clean_exit: Bool,
    memory_state: MemoryStateSpec
};

pub type CrossValSession = struct {
    session_id: Int,
    target_source_path: String,
    captures: List[ProcessCapture],
    is_divergence_free: Bool
};

pub fn sys_cross_val_dispatch_new(id: String, flag: String, ext: String, is_elf: Bool) -> BackendDispatch { return BackendDispatch {
        backend_id: id,
        cli_flag: flag,
        output_ext: ext,
        is_direct_elf: is_elf
    }; }

pub fn sys_cross_val_memory_spec_new(alloc_bytes: Int, stack: Int, hash: String, align: Int) -> MemoryStateSpec { return MemoryStateSpec {
        allocated_bytes: alloc_bytes,
        stack_depth: stack,
        state_hash_hex: hash,
        alignment_bytes: align
    }; }

pub fn sys_cross_val_capture_new(backend: String, code: Int, out: String, mem: MemoryStateSpec) -> ProcessCapture {
    let clean: Bool = code == 0;
    return ProcessCapture {
        backend_id: backend,
        exit_code: code,
        stdout_text: out,
        is_clean_exit: clean,
        memory_state: mem
    };
}

pub fn sys_cross_val_compute_state_hash(data: String, seed: Int) -> String {
    let len: Int = chars_len(data);
    let mut h: Int = seed;
    let mut i: Int = 0;
    while i < len {
        let ch: String = char_at(data, i);
        let code: Int = chars_len(ch);
        h = (h * 31 + code) % 1000000007;
        i = i + 1;
    }
    return "0x_state_" + h.to_string();
}

pub fn sys_cross_val_evaluate_parity(captures: List[ProcessCapture]) -> Bool {
    let n: Int = list_len(captures);
    if n <= 1 { return true; }

    let primary: ProcessCapture = list_get(captures, 0);
    let p_code: Int = primary.exit_code;
    let p_out: String = primary.stdout_text;
    let p_hash: String = primary.memory_state.state_hash_hex;

    let mut i: Int = 1;
    while i < n {
        let current: ProcessCapture = list_get(captures, i);
        let c_code: Int = current.exit_code;
        let c_out: String = current.stdout_text;
        let c_hash: String = current.memory_state.state_hash_hex;

        if c_code != p_code { return false; }
        if !(c_out == p_out) { return false; }
        if !(c_hash == p_hash) { return false; }
        i = i + 1;
    }
    return true;
}

pub fn sys_cross_val_session_create(id: Int, path: String, captures: List[ProcessCapture]) -> CrossValSession {
    let parity_ok: Bool = sys_cross_val_evaluate_parity(captures);
    return CrossValSession {
        session_id: id,
        target_source_path: path,
        captures: captures,
        is_divergence_free: parity_ok
    };
}
