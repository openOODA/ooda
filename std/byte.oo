// package: std — Byte 0..255 convention + path A byte free-name wrappers
// job: Int-range helpers + wrappers over byte_* free names / List[Int] buffer
// caps: none
// residual: NOT a native u8 primitive; NOT true List[Byte] ABI; NOT &str borrow
// residual: String remains value-copy (OoStr); path A is owned byte-indexed copy only
// residual: true &str lifetimes / List[Byte] ABI are NOT product
// path A Byte buffer: List[Int] elements documented as Byte = 0..255 Int (honest)

// Docs-only alias: 0..255 convention. Resolves to Int; no range seal at check.
type Byte = Int;

// Clamp Int into the documented 0..255 Byte convention.
// Residual: no range typecheck; no Byte arrays; no &str borrow.
pub fn byte_clamp(v: Int) -> Int {
    if v < 0 {
        return 0;
    }
    if v > 255 {
        return 255;
    }
    return v;
}

// True when v is in the Byte convention range 0..255 (inclusive).
// Residual: convention helper only — not a sealed Byte type test.
pub fn byte_in_range(v: Int) -> Bool {
    if v < 0 {
        return false;
    }
    if v > 255 {
        return false;
    }
    return true;
}

// Path A free-name wrappers (owned String / Int — not &str borrow).
pub fn byte_get(s: String, i: Int) -> Int {
    return byte_at(s, i);
}

// M166: first byte 0..255, or -1 if empty (free name ord; not &str).
pub fn byte_ord(s: String) -> Int {
    return ord(s);
}

pub fn byte_len(s: String) -> Int {
    return bytes_len(s);
}

// Owned copy of raw bytes [start, end) by byte index (not UTF-8 chars).
pub fn byte_sub(s: String, start: Int, end: Int) -> String {
    return byte_slice(s, start, end);
}

pub fn byte_eq(a: String, b: String) -> Bool {
    return bytes_eq(a, b);
}

// Owned identity: String as byte-string view (still String / OoStr, not &str).
pub fn byte_view(s: String) -> String {
    return bytes_from_str(s);
}

// Raw byte concat of two Strings (owned result).
pub fn byte_concat(a: String, b: String) -> String {
    return bytes_concat(a, b);
}

// Path A Byte buffer = List[Int] 0..255 (not true List[Byte] ABI).
pub fn byte_buf_new() -> List[Int] {
    return bytes_new();
}

pub fn byte_buf_push(bs: List[Int], b: Int) -> List[Int] {
    return bytes_push(bs, b);
}

pub fn byte_buf_get(bs: List[Int], i: Int) -> Int {
    return bytes_get(bs, i);
}

// Owned String from buffer (clamps each element to 0..255).
pub fn byte_buf_to_str(bs: List[Int]) -> String {
    return bytes_to_str(bs);
}
