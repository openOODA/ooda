// # Byte range helpers
//
// Logline: Treat Int values 0..255 as bytes and wrap the owned byte_* free names.
//
// Setup: There is no native u8 type. String is still OoStr. List[Int] is the buffer.
//
// Beats:
//   1. Byte is an Int alias with clamp and range tests.
//   2. byte_get, byte_ord, byte_len, byte_sub, byte_eq wrap free names.
//   3. A List[Int] buffer builds an owned String of clamped bytes.
//
// residual: NOT a native u8; NOT List[Byte] ABI; NOT &str borrow
// residual: String remains value-copy (OoStr)

// Docs-only alias: 0..255 convention. Resolves to Int; no range seal at check.
type Byte = Int;

// Clamp Int into 0..255.
pub fn byte_clamp(v: Int) -> Int {
    if v < 0 {
        return 0;
    }
    if v > 255 {
        return 255;
    }
    return v;
}

// True when v is in 0..255 inclusive.
pub fn byte_in_range(v: Int) -> Bool {
    if v < 0 {
        return false;
    }
    if v > 255 {
        return false;
    }
    return true;
}

pub fn byte_get(s: String, i: Int) -> Int {
    return byte_at(s, i);
}

// First byte 0..255, or -1 if empty.
pub fn byte_ord(s: String) -> Int {
    return ord(s);
}

pub fn byte_len(s: String) -> Int {
    return bytes_len(s);
}

// Owned copy of raw bytes [start, end) by byte index.
pub fn byte_sub(s: String, start: Int, end: Int) -> String {
    return byte_slice(s, start, end);
}

pub fn byte_eq(a: String, b: String) -> Bool {
    return bytes_eq(a, b);
}

pub fn byte_view(s: String) -> String {
    return bytes_from_str(s);
}

pub fn byte_concat(a: String, b: String) -> String {
    return bytes_concat(a, b);
}

pub fn byte_buf_new() -> List[Int] {
    return bytes_new();
}

pub fn byte_buf_push(bs: List[Int], b: Int) -> List[Int] {
    return bytes_push(bs, b);
}

pub fn byte_buf_get(bs: List[Int], i: Int) -> Int {
    return bytes_get(bs, i);
}

// Owned String from buffer (clamps each element to 0..255).
pub fn byte_buf_to_str(bs: List[Int]) -> String {
    return bytes_to_str(bs);
}
