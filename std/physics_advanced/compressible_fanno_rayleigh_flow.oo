// # 1D Fanno & Rayleigh Compressible Duct Flows
//
// Logline: Solves adiabatic wall friction (Fanno line) and frictionless heat addition (Rayleigh line) 1D compressible flows.
//
// Setup: Frictional duct choking and thermal choking Mach number trajectories towards sonic point M = 1.
//
// Beats:
//   1. Evaluate Fanno friction parameter 4*f*L*/D as a function of Mach number.
//   2. Evaluate Rayleigh thermal ratios T0/T0* and P0/P0* for combustion heat addition.
//   3. Compute critical choked maximum heat addition Delta_q_max and maximum pipe length L*.

pub type FannoState = struct {
    mach: Float,
    fanno_parameter_4fl_d: Float,
    t_over_tstar: Float,
    p_over_pstar: Float,
    p0_over_p0star: Float,
};

pub type RayleighState = struct {
    mach: Float,
    t0_over_t0star: Float,
    t_over_tstar: Float,
    p_over_pstar: Float,
    p0_over_p0star: Float,
};

// -------------------------------------------------------------------
// Fanno Line Flow (Frictional Duct)
// -------------------------------------------------------------------

pub fn fanno_evaluate_state(mach: Float, gamma: Float) -> FannoState {
    if mach <= 0.0001 {
        return FannoState {
            mach: 0.0001,
            fanno_parameter_4fl_d: 99999.0,
            t_over_tstar: 1.0,
            p_over_pstar: 99999.0,
            p0_over_p0star: 99999.0,
        };
    }

    let m2: Float = mach * mach;
    let gp1: Float = gamma + 1.0;
    let gm1: Float = gamma - 1.0;

    let t_rat: Float = (gp1 * 0.5) / (1.0 + (0.5 * gm1 * m2));
    let p_rat: Float = (1.0 / mach) * sqrt(t_rat);

    let term1: Float = (1.0 - m2) / (gamma * m2);
    let term2: Float = (gp1 / (2.0 * gamma)) * ln(((gp1 * m2) * 0.5) / (1.0 + (0.5 * gm1 * m2)));
    let fl_d: Float = term1 + term2;

    return FannoState {
        mach: mach,
        fanno_parameter_4fl_d: fl_d,
        t_over_tstar: t_rat,
        p_over_pstar: p_rat,
        p0_over_p0star: p_rat * sqrt(t_rat),
    };
}

// -------------------------------------------------------------------
// Rayleigh Line Flow (Heat Addition)
// -------------------------------------------------------------------

pub fn rayleigh_evaluate_state(mach: Float, gamma: Float) -> RayleighState {
    let m2: Float = mach * mach;
    let gp1: Float = gamma + 1.0;
    let gm1: Float = gamma - 1.0;

    let denom_p: Float = 1.0 + (gamma * m2);
    let p_rat: Float = gp1 / (denom_p + 0.00001);

    let t_rat: Float = m2 * p_rat * p_rat;
    let t0_rat: Float = ((2.0 * gp1 * m2) * (1.0 + (0.5 * gm1 * m2))) / ((denom_p * denom_p) + 0.00001);

    return RayleighState {
        mach: mach,
        t0_over_t0star: t0_rat,
        t_over_tstar: t_rat,
        p_over_pstar: p_rat,
        p0_over_p0star: p_rat,
    };
}
