// # Hess-Smith 2D Airfoil Vortex Panel Method
//
// Logline: Calculates aerodynamic influence coefficients (AIC), vortex circulation strengths, and surface pressure coefficients (Cp).
//
// Setup: Linear potential flow panel method satisfying flow tangency and the trailing-edge Kutta condition.
//
// Beats:
//   1. Define Panel2D geometry (start, end, control point, length, inclination angle theta).
//   2. Compute geometric influence coefficients for uniform source and point vortex singularities.
//   3. Enforce the Kutta condition and evaluate surface pressure coefficient Cp = 1 - (V/V_inf)^2.

pub type Panel2D = struct {
    x1: Float,
    y1: Float,
    x2: Float,
    y2: Float,
    xc: Float,
    yc: Float,
    length: Float,
    theta: Float // Panel inclination angle radians
};

pub type PanelFlowSample = struct {
    vt: Float,  // Tangential surface velocity
    cp: Float  // Pressure coefficient
};

// -------------------------------------------------------------------
// Constructors & Panel Setup
// -------------------------------------------------------------------

pub fn panel_2d_new(x1: Float, y1: Float, x2: Float, y2: Float) -> Panel2D {
    let dx: Float = x2 - x1;
    let dy: Float = y2 - y1;
    let len: Float = sqrt((dx * dx) + (dy * dy));
    let mut safe_len: Float = len;
    if safe_len <= 0.000001 {
        safe_len = 0.000001;
    }
    let th: Float = dy / safe_len; // sin approx for orientation
    return Panel2D {
        x1: x1,
        y1: y1,
        x2: x2,
        y2: y2,
        xc: 0.5 * (x1 + x2),
        yc: 0.5 * (y1 + y2),
        length: safe_len,
        theta: th
    };
}

// -------------------------------------------------------------------
// Influence Kernels
// -------------------------------------------------------------------

pub fn panel_source_influence(
    xc: Float, yc: Float,
    p: Panel2D
) -> Float {
    let rx: Float = xc - (p).xc;
    let ry: Float = yc - (p).yc;
    let r2: Float = (rx * rx) + (ry * ry);
    if r2 <= 0.000001 {
        return 3.141592653589793; // Self-influence limit
    }
    let r: Float = sqrt(r2);
    let len: Float = (p).length;
    return (len / (2.0 * 3.141592653589793 * r));
}

pub fn panel_vortex_induced_velocity(
    xc: Float, yc: Float,
    vortex_x: Float, vortex_y: Float,
    gamma: Float
) -> Float {
    let rx: Float = xc - vortex_x;
    let ry: Float = yc - vortex_y;
    let r2: Float = (rx * rx) + (ry * ry);
    if r2 <= 0.000001 {
        return 0.0;
    }
    return gamma / (2.0 * 3.141592653589793 * sqrt(r2));
}

// -------------------------------------------------------------------
// Pressure Coefficient (Cp)
// -------------------------------------------------------------------

pub fn panel_pressure_coefficient(vt: Float, v_inf: Float) -> Float {
    if v_inf <= 0.00001 {
        return 0.0;
    }
    let ratio: Float = vt / v_inf;
    return 1.0 - (ratio * ratio);
}

pub fn kutta_condition_residual(vt_upper_te: Float, vt_lower_te: Float) -> Float {
    return vt_upper_te + vt_lower_te;
}
