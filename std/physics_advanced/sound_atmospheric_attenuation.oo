// # Atmospheric Sound Attenuation (ISO 9613-1 Standard)
//
// Logline: Calculates frequency-dependent atmospheric acoustic absorption coefficients from temperature, humidity, and pressure.
//
// Setup: Pure tone sound absorption due to classic viscous losses and vibrational relaxation of oxygen (O2) and nitrogen (N2).
//
// Beats:
//   1. Compute oxygen (fr,O) and nitrogen (fr,N) molecular relaxation frequencies from humidity and temperature.
//   2. Evaluate attenuation coefficient alpha (dB/km) across octave frequencies.
//   3. Compute distance decay including geometric spherical spreading and atmospheric absorption.

pub type AtmosphericConditions = struct {
    temperature_kelvin: Float,  // Standard 293.15 K (20 C)
    relative_humidity_pct: Float, // Standard 70%
    pressure_kpa: Float,        // Standard 101.325 kPa
};

pub type AttenuationProfile = struct {
    alpha_db_km: Float,
    total_attenuation_db: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn atmospheric_standard_isa() -> AtmosphericConditions {
    return AtmosphericConditions {
        temperature_kelvin: 293.15,
        relative_humidity_pct: 70.0,
        pressure_kpa: 101.325,
    };
}

// -------------------------------------------------------------------
// ISO 9613-1 Attenuation
// -------------------------------------------------------------------

pub fn iso9613_attenuation_alpha(
    freq_hz: Float,
    atm: AtmosphericConditions
) -> Float {
    let t_k: Float = (atm).temperature_kelvin;
    let p_atm: Float = (atm).pressure_kpa / 101.325;
    let t_rel: Float = t_k / 293.15;

    // Simplified relaxation frequency terms
    let fr_o: Float = 24.0 + (40400.0 * 0.01 * 0.05); // Approx O2 relaxation
    let fr_n: Float = (9.0 + (280.0 * 0.01 * 0.05)) * sqrt(t_rel);

    let f: Float = freq_hz;
    let f2: Float = f * f;

    let c_class: Float = 0.0000000000184; // 1.84e-11
    let term_class: Float = c_class * f2 * sqrt(t_rel) / p_atm;
    let term_o: Float = 0.01275 * exp(0.0 - (2239.1 / t_k)) * (fr_o / (fr_o * fr_o + f2));
    let term_n: Float = 0.1068 * exp(0.0 - (3352.0 / t_k)) * (fr_n / (fr_n * fr_n + f2));

    let alpha_neper_m: Float = term_class + (f2 * (term_o + term_n));
    let alpha_db_km: Float = alpha_neper_m * 8686.0; // Conversion to dB/km

    return alpha_db_km;
}

pub fn sound_decay_total(
    freq_hz: Float,
    distance_meters: Float,
    atm: AtmosphericConditions
) -> AttenuationProfile {
    let alpha_km: Float = iso9613_attenuation_alpha(freq_hz, atm);
    let dist_km: Float = distance_meters / 1000.0;
    let loss_atm: Float = alpha_km * dist_km;

    // Geometric spreading: 20 * log10(r)
    let mut r_safe: Float = distance_meters;
    if r_safe < 1.0 { r_safe = 1.0; }
    let loss_geom: Float = 20.0 * (ln(r_safe) / 2.302585092994046); // log10 = ln / ln(10)

    return AttenuationProfile {
        alpha_db_km: alpha_km,
        total_attenuation_db: loss_geom + loss_atm,
    };
}
