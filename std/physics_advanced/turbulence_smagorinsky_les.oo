// # Smagorinsky Large Eddy Simulation (LES) Turbulence Model
//
// Logline: Calculates subgrid-scale (SGS) turbulent eddy viscosity using the Smagorinsky-Lilly strain rate tensor invariant model.
//
// Setup: LES closure model for unresolved high Reynolds number turbulent eddies on spatial filter grids.
//
// Beats:
//   1. Compute symmetric 2D strain rate tensor components S_xx, S_yy, S_xy.
//   2. Evaluate characteristic filtered strain rate magnitude |S| = sqrt(2 S_ij S_ij).
//   3. Compute subgrid turbulent eddy viscosity nu_t = (Cs * Delta)^2 * |S| with Van Driest wall damping.

pub type StrainTensor2D = struct {
    s_xx: Float,
    s_yy: Float,
    s_xy: Float,
};

pub type SmagorinskyConfig = struct {
    smagorinsky_cs: Float,   // Standard ~ 0.1 to 0.2
    filter_width_delta: Float,
    van_driest_a_plus: Float, // ~ 26.0 for wall damping
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn smagorinsky_config_default(dx: Float, dy: Float) -> SmagorinskyConfig {
    let filter_delta: Float = sqrt(dx * dy);
    return SmagorinskyConfig {
        smagorinsky_cs: 0.17,
        filter_width_delta: filter_delta,
        van_driest_a_plus: 26.0,
    };
}

// -------------------------------------------------------------------
// Strain Rate Tensor & Invariant Magnitude
// -------------------------------------------------------------------

pub fn compute_strain_tensor_2d(
    du_dx: Float,
    du_dy: Float,
    dv_dx: Float,
    dv_dy: Float
) -> StrainTensor2D {
    return StrainTensor2D {
        s_xx: du_dx,
        s_yy: dv_dy,
        s_xy: 0.5 * (du_dy + dv_dx),
    };
}

pub fn strain_rate_magnitude_2d(s: StrainTensor2D) -> Float {
    let s_xx: Float = (s).s_xx;
    let s_yy: Float = (s).s_yy;
    let s_xy: Float = (s).s_xy;
    let sum_sq: Float = (s_xx * s_xx) + (s_yy * s_yy) + (2.0 * (s_xy * s_xy));
    return sqrt(2.0 * sum_sq);
}

// -------------------------------------------------------------------
// Subgrid Eddy Viscosity
// -------------------------------------------------------------------

pub fn smagorinsky_eddy_viscosity(
    strain_magnitude: Float,
    config: SmagorinskyConfig
) -> Float {
    let cs: Float = (config).smagorinsky_cs;
    let delta: Float = (config).filter_width_delta;
    let length_scale: Float = cs * delta;
    return length_scale * length_scale * strain_magnitude;
}

pub fn van_driest_damping_factor(y_plus: Float, a_plus: Float) -> Float {
    if a_plus <= 0.0001 {
        return 1.0;
    }
    let ratio: Float = 0.0 - (y_plus / a_plus);
    let damp: Float = 1.0 - exp(ratio);
    if damp < 0.0 {
        return 0.0;
    }
    return damp;
}
