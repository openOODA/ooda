// # 1D Isentropic Compressible Gas Dynamics
//
// Logline: Calculates stagnation pressure, temperature, and density ratios and supersonic critical throat area ratios A/A*.
//
// Setup: Ideal gas isentropic relations with specific heat ratio gamma (default 1.4 for air).
//
// Beats:
//   1. Compute stagnation temperature ratio T0/T = 1 + ((gamma - 1)/2) * M^2.
//   2. Compute stagnation pressure P0/P and density rho0/rho isentropic exponents.
//   3. Evaluate de Laval supersonic nozzle area-Mach relation A/A*(M).

pub type IsentropicGas = struct {
    gamma: Float, // Specific heat ratio (1.4 for air)
    gas_constant_r: Float // J/(kg*K) (287.05 for air)
};

pub type IsentropicRatios = struct {
    t_over_t0: Float,
    p_over_p0: Float,
    rho_over_rho0: Float,
    area_over_astar: Float,
    speed_of_sound: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn isentropic_gas_air() -> IsentropicGas {
    return IsentropicGas {
        gamma: 1.4,
        gas_constant_r: 287.05
    };
}

// -------------------------------------------------------------------
// Isentropic Ratios
// -------------------------------------------------------------------

pub fn isentropic_temperature_ratio(mach: Float, gamma: Float) -> Float {
    let gm1_half: Float = (gamma - 1.0) * 0.5;
    let factor: Float = 1.0 + (gm1_half * mach * mach);
    if factor <= 0.0001 {
        return 1.0;
    }
    return 1.0 / factor;
}

pub fn isentropic_pressure_ratio(mach: Float, gamma: Float) -> Float {
    let t_ratio: Float = isentropic_temperature_ratio(mach, gamma);
    let exp_val: Float = gamma / (gamma - 1.0);
    return pow(t_ratio, exp_val);
}

pub fn isentropic_density_ratio(mach: Float, gamma: Float) -> Float {
    let t_ratio: Float = isentropic_temperature_ratio(mach, gamma);
    let exp_val: Float = 1.0 / (gamma - 1.0);
    return pow(t_ratio, exp_val);
}

pub fn isentropic_area_ratio(mach: Float, gamma: Float) -> Float {
    if mach <= 0.0001 {
        return 999999.0;
    }
    let gp1: Float = gamma + 1.0;
    let gm1: Float = gamma - 1.0;
    let term: Float = (2.0 / gp1) * (1.0 + (0.5 * gm1 * mach * mach));
    let exponent: Float = gp1 / (2.0 * gm1);
    let factor: Float = pow(term, exponent);
    return (1.0 / mach) * factor;
}

pub fn isentropic_evaluate_all(
    gas: IsentropicGas,
    mach: Float,
    t0: Float,
    p0: Float
) -> IsentropicRatios {
    let g: Float = (gas).gamma;
    let r: Float = (gas).gas_constant_r;

    let t_rat: Float = isentropic_temperature_ratio(mach, g);
    let p_rat: Float = isentropic_pressure_ratio(mach, g);
    let rho_rat: Float = isentropic_density_ratio(mach, g);
    let a_rat: Float = isentropic_area_ratio(mach, g);

    let t_static: Float = t0 * t_rat;
    let a_sound: Float = sqrt(g * r * t_static);

    return IsentropicRatios {
        t_over_t0: t_rat,
        p_over_p0: p_rat,
        rho_over_rho0: rho_rat,
        area_over_astar: a_rat,
        speed_of_sound: a_sound
    };
}
