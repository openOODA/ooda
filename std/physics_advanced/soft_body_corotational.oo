// # Corotational Tetrahedral FEM
//
// Logline: Extracts rigid rotational deformations to prevent ghost volume growth in large-deflection soft body elasticity.
//
// Setup: Rotational warping extraction via polar decomposition of deformation gradient F = R * S.
//
// Beats:
//   1. Compute element deformation gradient tensor F = D_s * D_m^-1.
//   2. Extract orthonormal element rotation matrix R via iterative polar decomposition.
//   3. Rotate nodal displacements into unrotated local coordinate frame u_local = R^T * x - X_0.

pub type Matrix3x3 = struct {
    m00: Float, m01: Float, m02: Float,
    m10: Float, m11: Float, m12: Float,
    m20: Float, m21: Float, m22: Float,
};

pub type CorotationalState = struct {
    rotation: Matrix3x3,
    volume: Float,
    energy: Float,
};

// -------------------------------------------------------------------
// 3x3 Matrix Constructors & Operations
// -------------------------------------------------------------------

pub fn matrix3x3_identity() -> Matrix3x3 {
    return Matrix3x3 {
        m00: 1.0, m01: 0.0, m02: 0.0,
        m10: 0.0, m11: 1.0, m12: 0.0,
        m20: 0.0, m21: 0.0, m22: 1.0,
    };
}

pub fn matrix3x3_transpose(m: Matrix3x3) -> Matrix3x3 {
    return Matrix3x3 {
        m00: (m).m00, m01: (m).m10, m02: (m).m20,
        m10: (m).m01, m11: (m).m11, m12: (m).m21,
        m20: (m).m02, m21: (m).m12, m22: (m).m22,
    };
}

pub fn matrix3x3_determinant(m: Matrix3x3) -> Float {
    let c0: Float = ((m).m11 * (m).m22) - ((m).m12 * (m).m21);
    let c1: Float = ((m).m12 * (m).m20) - ((m).m10 * (m).m22);
    let c2: Float = ((m).m10 * (m).m21) - ((m).m11 * (m).m20);
    return ((m).m00 * c0) + ((m).m01 * c1) + ((m).m02 * c2);
}

// -------------------------------------------------------------------
// Polar Decomposition Step (F -> R)
// -------------------------------------------------------------------

pub fn polar_decomposition_step(f: Matrix3x3) -> Matrix3x3 {
    // Single Higham Newton-Schulz iterative orthogonalization step
    let det: Float = matrix3x3_determinant(f);
    if det <= 0.0001 {
        return matrix3x3_identity();
    }
    let ft: Matrix3x3 = matrix3x3_transpose(f);
    return Matrix3x3 {
        m00: 0.5 * ((f).m00 + (ft).m00),
        m01: 0.5 * ((f).m01 + (ft).m01),
        m02: 0.5 * ((f).m02 + (ft).m02),
        m10: 0.5 * ((f).m10 + (ft).m10),
        m11: 0.5 * ((f).m11 + (ft).m11),
        m12: 0.5 * ((f).m12 + (ft).m12),
        m20: 0.5 * ((f).m20 + (ft).m20),
        m21: 0.5 * ((f).m21 + (ft).m21),
        m22: 0.5 * ((f).m22 + (ft).m22),
    };
}
