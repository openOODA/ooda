// # Navier-Stokes 2D Staggered MAC Grid
//
// Logline: Implements marker-and-cell (MAC) staggered 2D Eulerian fluid grid geometry, cell boundary tags, and velocity interpolation.
//
// Setup: Structured Cartesian 2D grid storing staggered face velocities u, v and cell-centered pressure p.
//
// Beats:
//   1. Define Grid2D, CellType, FaceVelocity, and MacCell state representations.
//   2. Compute 1D flattened index offsets and neighbor coordinate lookups with boundary clamping.
//   3. Interpolate cell-centered velocity vectors from staggered u and v face values.

pub type CellType = struct {
    tag: Int // 0 = Fluid, 1 = Solid obstacle, 2 = Empty / Air, 3 = Inflow, 4 = Outflow
};

pub type MacGrid2D = struct {
    nx: Int,
    ny: Int,
    dx: Float,
    dy: Float,
    inv_dx: Float,
    inv_dy: Float
};

pub type MacVelocitySample = struct {
    u: Float,
    v: Float
};

pub type MacCellMetrics = struct {
    volume: Float,
    face_area_x: Float,
    face_area_y: Float
};

// -------------------------------------------------------------------
// Helper Functions
// -------------------------------------------------------------------

pub fn mac_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 {
        count = 0 - count;
    }
    while count >= 10000 {
        f = f + 10000.0;
        count = count - 10000;
    }
    while count >= 1000 {
        f = f + 1000.0;
        count = count - 1000;
    }
    while count >= 100 {
        f = f + 100.0;
        count = count - 100;
    }
    while count >= 10 {
        f = f + 10.0;
        count = count - 10;
    }
    while count >= 1 {
        f = f + 1.0;
        count = count - 1;
    }
    if n < 0 {
        return 0.0 - f;
    }
    return f;
}

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn mac_grid_2d_new(nx: Int, ny: Int, dx: Float, dy: Float) -> MacGrid2D {
    let mut safe_dx: Float = dx;
    if safe_dx <= 0.00001 {
        safe_dx = 1.0;
    }
    let mut safe_dy: Float = dy;
    if safe_dy <= 0.00001 {
        safe_dy = 1.0;
    }
    return MacGrid2D {
        nx: nx,
        ny: ny,
        dx: safe_dx,
        dy: safe_dy,
        inv_dx: 1.0 / safe_dx,
        inv_dy: 1.0 / safe_dy
    };
}

pub fn mac_grid_metrics(grid: MacGrid2D) -> MacCellMetrics {
    let dx: Float = (grid).dx;
    let dy: Float = (grid).dy;
    return MacCellMetrics {
        volume: dx * dy,
        face_area_x: dy,
        face_area_y: dx
    };
}

// -------------------------------------------------------------------
// Indexing & Coordinates
// -------------------------------------------------------------------

pub fn mac_grid_index(grid: MacGrid2D, i: Int, j: Int) -> Int {
    let nx: Int = (grid).nx;
    let ny: Int = (grid).ny;
    let mut ci: Int = i;
    if ci < 0 {
        ci = 0;
    }
    if ci >= nx {
        ci = nx - 1;
    }
    let mut cj: Int = j;
    if cj < 0 {
        cj = 0;
    }
    if cj >= ny {
        cj = ny - 1;
    }
    return (cj * nx) + ci;
}

pub fn mac_cell_center_x(grid: MacGrid2D, i: Int) -> Float {
    let offset: Float = 0.5 + mac_int_to_float(i);
    let dx: Float = (grid).dx;
    return offset * dx;
}

pub fn mac_cell_center_y(grid: MacGrid2D, j: Int) -> Float {
    let offset: Float = 0.5 + mac_int_to_float(j);
    let dy: Float = (grid).dy;
    return offset * dy;
}

// -------------------------------------------------------------------
// Staggered Face to Center Interpolation
// -------------------------------------------------------------------

pub fn mac_interpolate_center_velocity(
    u_left: Float,
    u_right: Float,
    v_bottom: Float,
    v_top: Float
) -> MacVelocitySample {
    return MacVelocitySample {
        u: 0.5 * (u_left + u_right),
        v: 0.5 * (v_bottom + v_top)
    };
}

pub fn mac_is_solid_cell(tag: Int) -> Int {
    if tag == 1 {
        return 1;
    }
    return 0;
}

pub fn mac_is_fluid_cell(tag: Int) -> Int {
    if tag == 0 {
        return 1;
    }
    return 0;
}
