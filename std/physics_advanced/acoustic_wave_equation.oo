// # 2D/3D Linear Acoustic Wave Equation FDTD Solver
//
// Logline: Solves second-order linear acoustic wave equations (d2p/dt2 = c^2 * laplacian(p)) via finite-difference time-domain (FDTD).
//
// Setup: Sound pressure propagation through heterogeneous compressible media with speed of sound c and density rho.
//
// Beats:
//   1. Define AcousticMedium properties (sound_speed_c, reference_density_rho, attenuation_sigma).
//   2. Evaluate 2D 5-point discrete pressure Laplacian stencil.
//   3. Advance pressure wavefield p^(n+1) with Courant-Friedrichs-Lewy (CFL) stability bounds.

pub type AcousticMedium = struct {
    sound_speed_c: Float,    // m/s (343.0 for air)
    density_rho: Float,      // kg/m^3 (1.21 for air)
    damping_factor: Float
};

pub type AcousticWaveState2D = struct {
    pressure_curr: Float,
    pressure_prev: Float,
    pressure_next: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn acoustic_medium_air() -> AcousticMedium {
    return AcousticMedium {
        sound_speed_c: 343.2,
        density_rho: 1.204,
        damping_factor: 0.0001
    };
}

pub fn acoustic_medium_water() -> AcousticMedium {
    return AcousticMedium {
        sound_speed_c: 1481.0,
        density_rho: 998.0,
        damping_factor: 0.00001
    };
}

// -------------------------------------------------------------------
// FDTD Time Stepping
// -------------------------------------------------------------------

pub fn acoustic_fdtd_step_2d(
    p_curr: Float,
    p_prev: Float,
    p_east: Float,
    p_west: Float,
    p_north: Float,
    p_south: Float,
    c: Float,
    dt: Float,
    dx: Float,
    dy: Float,
    damping: Float
) -> Float {
    let cour_x: Float = (c * dt) / dx;
    let cour_y: Float = (c * dt) / dy;
    let cx2: Float = cour_x * cour_x;
    let cy2: Float = cour_y * cour_y;

    let lap_x: Float = p_east - (2.0 * p_curr) + p_west;
    let lap_y: Float = p_north - (2.0 * p_curr) + p_south;

    let un_damped: Float = (2.0 * p_curr) - p_prev + (cx2 * lap_x) + (cy2 * lap_y);
    return (un_damped + (damping * p_prev)) / (1.0 + damping);
}

pub fn acoustic_cfl_max_dt_2d(c: Float, dx: Float, dy: Float) -> Float {
    let inv_d2: Float = (1.0 / (dx * dx)) + (1.0 / (dy * dy));
    return 1.0 / (c * sqrt(inv_d2));
}
