// # Upper Atmospheric Orbital Decay Drag (NRLMSISE-00)
//
// Logline: Calculates thermospheric exponential drag forces, ballistic coefficients (B*), and orbital lifetime decay rates.
//
// Setup: Low Earth Orbit (LEO) aerodynamic orbital perturbation dynamics with exponential density scale heights.
//
// Beats:
//   1. Compute atmospheric density rho(h) via layered exponential scale height models.
//   2. Evaluate relative atmospheric co-rotating velocity v_rel = v_orbit - (omega_earth x r).
//   3. Compute deceleration vector a_drag = -0.5 * Cd * (A/m) * rho * |v_rel| * v_rel.

pub type SatelliteAerodynamics = struct {
    ballistic_area_m2: Float,
    drag_coefficient_cd: Float,
    mass_kg: Float
};

pub type AtmosphericDragAcceleration = struct {
    ax: Float,
    ay: Float,
    az: Float,
    density_kg_m3: Float,
    mach_orbit: Float
};

// -------------------------------------------------------------------
// Thermospheric Density Model (Exponential Layered)
// -------------------------------------------------------------------

pub fn thermospheric_density_leo(altitude_km: Float) -> Float {
    if altitude_km < 100.0 {
        return 0.0005; // Dense lower atmosphere
    }
    if altitude_km > 1000.0 {
        return 0.000000000000001; // Negligible exosphere
    }

    // Reference baseline at 200 km: rho0 = 2.789e-10, scale height H = 37.5 km
    let h0: Float = 200.0;
    let rho0: Float = 0.0000000002789;
    let scale_h: Float = 37.5 + (0.05 * (altitude_km - h0));

    let delta_h: Float = altitude_km - h0;
    let exponent: Float = 0.0 - (delta_h / scale_h);
    return rho0 * exp(exponent);
}

// -------------------------------------------------------------------
// Drag Acceleration
// -------------------------------------------------------------------

pub fn compute_orbital_drag_acceleration(
    sat: SatelliteAerodynamics,
    altitude_km: Float,
    v_rel_x: Float, v_rel_y: Float, v_rel_z: Float
) -> AtmosphericDragAcceleration {
    let rho: Float = thermospheric_density_leo(altitude_km);
    let v_sq: Float = (v_rel_x * v_rel_x) + (v_rel_y * v_rel_y) + (v_rel_z * v_rel_z);
    let v_mag: Float = sqrt(v_sq);

    let cd: Float = (sat).drag_coefficient_cd;
    let a: Float = (sat).ballistic_area_m2;
    let m: Float = (sat).mass_kg;

    let b_star: Float = (cd * a) / (2.0 * m + 0.000001);
    let a_mag: Float = b_star * rho * v_sq;

    let mut dir_x: Float = 0.0;
    let mut dir_y: Float = 0.0;
    let mut dir_z: Float = 0.0;

    if v_mag > 0.00001 {
        dir_x = (0.0 - v_rel_x) / v_mag;
        dir_y = (0.0 - v_rel_y) / v_mag;
        dir_z = (0.0 - v_rel_z) / v_mag;
    }

    return AtmosphericDragAcceleration {
        ax: a_mag * dir_x,
        ay: a_mag * dir_y,
        az: a_mag * dir_z,
        density_kg_m3: rho,
        mach_orbit: v_mag / 300.0
    };
}
