// # 1-DOF Revolute / Hinge Joint with Angular Limits
//
// Logline: Enforces 1-DOF rotational hinge constraints with customizable min/max angular stops and motorized velocity drivers.
//
// Setup: Biomechanical knee and elbow joints restricting motion to single-axis rotation.
//
// Beats:
//   1. Lock 3 relative linear displacements and 2 out-of-plane rotational axes.
//   2. Enforce angular travel stops [angle_min, angle_max] with restitution bounce.
//   3. Drive target rotational velocities using bounded angular motor torques.

pub type HingeJoint = struct {
    hinge_axis_x: Float,
    hinge_axis_y: Float,
    hinge_axis_z: Float,
    min_angle_rad: Float,
    max_angle_rad: Float,
    motor_target_rate: Float,
    max_motor_torque: Float,
};

pub type HingeEvaluation = struct {
    current_angle_rad: Float,
    angle_error: Float,
    motor_torque: Float,
    is_locked: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn hinge_joint_knee() -> HingeJoint {
    return HingeJoint {
        hinge_axis_x: 1.0,
        hinge_axis_y: 0.0,
        hinge_axis_z: 0.0,
        min_angle_rad: 0.0,       // Full extension (0 deg)
        max_angle_rad: 2.356,     // Full flexion (135 deg)
        motor_target_rate: 0.0,
        max_motor_torque: 300.0,
    };
}

pub fn hinge_joint_elbow() -> HingeJoint {
    return HingeJoint {
        hinge_axis_x: 0.0,
        hinge_axis_y: 1.0,
        hinge_axis_z: 0.0,
        min_angle_rad: 0.0,
        max_angle_rad: 2.53,      // 145 deg
        motor_target_rate: 0.0,
        max_motor_torque: 150.0,
    };
}

// -------------------------------------------------------------------
// Joint Evaluation
// -------------------------------------------------------------------

pub fn hinge_joint_step(
    joint: HingeJoint,
    angle: Float,
    angular_rate: Float,
    dt: Float
) -> HingeEvaluation {
    let min_a: Float = (joint).min_angle_rad;
    let max_a: Float = (joint).max_angle_rad;
    let target_rate: Float = (joint).motor_target_rate;
    let max_tau: Float = (joint).max_motor_torque;

    let mut err: Float = 0.0;
    let mut locked: Int = 0;

    if angle < min_a {
        err = min_a - angle;
        locked = 1;
    }
    if angle > max_a {
        err = max_a - angle;
        locked = 1;
    }

    let rate_err: Float = target_rate - angular_rate;
    let mut motor_t: Float = 50.0 * rate_err;
    if motor_t > max_tau { motor_t = max_tau; }
    if motor_t < (0.0 - max_tau) { motor_t = 0.0 - max_tau; }

    return HingeEvaluation {
        current_angle_rad: angle,
        angle_error: err,
        motor_torque: motor_t,
        is_locked: locked,
    };
}
