// # Circular Restricted Three-Body Problem (CR3BP)
//
// Logline: Calculates non-dimensional equations of motion, Jacobi integral constants, and Lagrange point stability manifolds.
//
// Setup: Gravitational dynamics of a massless third body orbiting in the rotating frame of two massive primaries (mu = m2/(m1+m2)).
//
// Beats:
//   1. Compute non-dimensional rotating coordinate frame effective potential U(x, y, z).
//   2. Evaluate Jacobi energy integral C = 2*U - (vx^2 + vy^2 + vz^2).
//   3. Compute Coriolis and centrifugal acceleration terms in the rotating synodic barycentric frame.

pub type Cr3bpSystem = struct {
    mass_ratio_mu: Float, // e.g. Earth-Moon mu ~ 0.01215, Sun-Earth mu ~ 3.003e-6
    primary_1_x: Float,   // -mu
    primary_2_x: Float   // 1 - mu
};

pub type SynodicState = struct {
    x: Float, y: Float, z: Float,
    vx: Float, vy: Float, vz: Float
};

pub type Cr3bpAcceleration = struct {
    ax: Float,
    ay: Float,
    az: Float,
    jacobi_constant: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn cr3bp_earth_moon() -> Cr3bpSystem {
    let mu: Float = 0.0121505856;
    return Cr3bpSystem {
        mass_ratio_mu: mu,
        primary_1_x: 0.0 - mu,
        primary_2_x: 1.0 - mu
    };
}

pub fn cr3bp_sun_earth() -> Cr3bpSystem {
    let mu: Float = 0.00000300348;
    return Cr3bpSystem {
        mass_ratio_mu: mu,
        primary_1_x: 0.0 - mu,
        primary_2_x: 1.0 - mu
    };
}

// -------------------------------------------------------------------
// Equations of Motion & Jacobi Constant
// -------------------------------------------------------------------

pub fn cr3bp_compute_derivatives(
    sys: Cr3bpSystem,
    state: SynodicState
) -> Cr3bpAcceleration {
    let mu: Float = (sys).mass_ratio_mu;
    let one_minus_mu: Float = 1.0 - mu;

    let x: Float = (state).x;
    let y: Float = (state).y;
    let z: Float = (state).z;
    let vx: Float = (state).vx;
    let vy: Float = (state).vy;
    let vz: Float = (state).vz;

    // Distances to primary 1 and primary 2
    let d1x: Float = x + mu;
    let r1_sq: Float = (d1x * d1x) + (y * y) + (z * z);
    let r1_cubed: Float = pow(r1_sq, 1.5) + 0.000001;

    let d2x: Float = x - (1.0 - mu);
    let r2_sq: Float = (d2x * d2x) + (y * y) + (z * z);
    let r2_cubed: Float = pow(r2_sq, 1.5) + 0.000001;

    // Potential U = 0.5*(x^2 + y^2) + (1-mu)/r1 + mu/r2
    let u_pot: Float = (0.5 * ((x * x) + (y * y))) + (one_minus_mu / sqrt(r1_sq + 0.000001)) + (mu / sqrt(r2_sq + 0.000001));

    // Jacobi constant C = 2*U - v^2
    let v_sq: Float = (vx * vx) + (vy * vy) + (vz * vz);
    let c_jacobi: Float = (2.0 * u_pot) - v_sq;

    // Equations of motion with Coriolis terms (2*vy, -2*vx)
    let ax: Float = (2.0 * vy) + x - ((one_minus_mu * d1x) / r1_cubed) - ((mu * d2x) / r2_cubed);
    let ay: Float = (0.0 - (2.0 * vx)) + y - ((one_minus_mu * y) / r1_cubed) - ((mu * y) / r2_cubed);
    let az: Float = 0.0 - (((one_minus_mu * z) / r1_cubed) + ((mu * z) / r2_cubed));

    return Cr3bpAcceleration {
        ax: ax,
        ay: ay,
        az: az,
        jacobi_constant: c_jacobi
    };
}
