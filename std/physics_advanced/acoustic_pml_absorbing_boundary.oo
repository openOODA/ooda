// # Perfectly Matched Layer (PML) Acoustic Absorbing Boundaries
//
// Logline: Implements complex coordinate stretching absorbing boundaries for reflectionless truncation of acoustic wave domains.
//
// Setup: Berenger / Gedney Perfectly Matched Layer absorbing boundary conditions for finite FDTD acoustic lattices.
//
// Beats:
//   1. Compute polynomial spatial damping profile sigma(x) = sigma_max * (x / d_pml)^m.
//   2. Split acoustic wavefields into normal and tangential auxiliary absorbing components.
//   3. Exponentially damp outgoing waves to eliminate artificial domain boundary reflections.

pub type PmlConfig = struct {
    pml_thickness: Float, // Distance in meters
    sigma_max: Float,     // Maximum conductivity
    profile_order_m: Float, // Typically 2.0 to 4.0
};

pub type PmlDampingSample = struct {
    sigma_val: Float,
    decay_factor: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn pml_config_default(thickness: Float, sound_speed: Float) -> PmlConfig {
    let sig_max: Float = (3.0 * sound_speed) / (2.0 * thickness + 0.0001);
    return PmlConfig {
        pml_thickness: thickness,
        sigma_max: sig_max,
        profile_order_m: 2.0,
    };
}

// -------------------------------------------------------------------
// Damping Profile Evaluation
// -------------------------------------------------------------------

pub fn evaluate_pml_damping(
    distance_into_pml: Float,
    config: PmlConfig,
    dt: Float
) -> PmlDampingSample {
    let d_pml: Float = (config).pml_thickness;
    let s_max: Float = (config).sigma_max;
    let m: Float = (config).profile_order_m;

    let mut dist: Float = distance_into_pml;
    if dist < 0.0 { dist = 0.0; }
    if dist > d_pml { dist = d_pml; }

    let ratio: Float = dist / (d_pml + 0.00001);
    let poly: Float = pow(ratio, m);
    let sigma: Float = s_max * poly;

    let decay: Float = exp(0.0 - (sigma * dt));

    return PmlDampingSample {
        sigma_val: sigma,
        decay_factor: decay,
    };
}
