// # Multi-Relaxation-Time (MRT) Lattice Boltzmann Operator
//
// Logline: Transforms distribution populations into hydrodynamic moment space for independent acoustic and viscous relaxation modes.
//
// Setup: MRT collision operator overcoming BGK stability limits at high Reynolds numbers.
//
// Beats:
//   1. Define 9D hydrodynamic moment state (density, energy, energy-squared, momentum, heat-flux, stress).
//   2. Project discrete distributions to orthogonal moment vectors m = M * f.
//   3. Relax moments with individual diagonal relaxation rates S and transform back to population space.

pub type MrtMoments = struct {
    m_rho: Float,   // Density
    m_e: Float,     // Energy
    m_eps: Float,   // Energy squared
    m_jx: Float,    // X-momentum
    m_q_x: Float,   // X-heat flux
    m_jy: Float,    // Y-momentum
    m_q_y: Float,   // Y-heat flux
    m_p_xx: Float,  // Diagonal stress component
    m_p_xy: Float,  // Off-diagonal shear stress component
};

pub type MrtRelaxationRates = struct {
    s_rho: Float,
    s_e: Float,
    s_eps: Float,
    s_j: Float,
    s_q: Float,
    s_nu: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn mrt_relaxation_rates_standard(nu: Float) -> MrtRelaxationRates {
    let tau_nu: Float = (3.0 * nu) + 0.5;
    let s_nu: Float = 1.0 / tau_nu;
    return MrtRelaxationRates {
        s_rho: 1.0,
        s_e: 1.1,
        s_eps: 1.0,
        s_j: 1.0,
        s_q: 1.2,
        s_nu: s_nu,
    };
}

// -------------------------------------------------------------------
// Moment Transformations
// -------------------------------------------------------------------

pub fn d2q9_to_mrt_moments(
    f0: Float, f1: Float, f2: Float, f3: Float,
    f4: Float, f5: Float, f6: Float, f7: Float, f8: Float
) -> MrtMoments {
    let m_rho: Float = f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8;
    let m_e: Float = (0.0 - (4.0 * f0)) - (f1 + f2 + f3 + f4) + (2.0 * (f5 + f6 + f7 + f8));
    let m_eps: Float = (4.0 * f0) - (2.0 * (f1 + f2 + f3 + f4)) + (f5 + f6 + f7 + f8);
    let m_jx: Float = (f1 - f3) + (f5 - f6 - f7 + f8);
    let m_qx: Float = (0.0 - (2.0 * (f1 - f3))) + (f5 - f6 - f7 + f8);
    let m_jy: Float = (f2 - f4) + (f5 + f6 - f7 - f8);
    let m_qy: Float = (0.0 - (2.0 * (f2 - f4))) + (f5 + f6 - f7 - f8);
    let m_pxx: Float = (f1 - f2 + f3 - f4);
    let m_pxy: Float = (f5 - f6 + f7 - f8);

    return MrtMoments {
        m_rho: m_rho,
        m_e: m_e,
        m_eps: m_eps,
        m_jx: m_jx,
        m_q_x: m_qx,
        m_jy: m_jy,
        m_q_y: m_qy,
        m_p_xx: m_pxx,
        m_p_xy: m_pxy,
    };
}

pub fn mrt_relax_moment(m_curr: Float, m_eq: Float, rate: Float) -> Float {
    return m_curr - (rate * (m_curr - m_eq));
}
