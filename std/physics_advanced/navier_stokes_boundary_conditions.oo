// # Navier-Stokes Boundary Conditions
//
// Logline: Applies Dirichlet no-slip/free-slip walls, parabolic Poiseuille inflow profiles, and convective outflow boundaries.
//
// Setup: Boundary condition enforcement for Eulerian velocity and pressure fields on Cartesian domains.
//
// Beats:
//   1. Evaluate parabolic Poiseuille channel inflow velocity profiles.
//   2. Enforce no-slip and free-slip ghost cell reflections.
//   3. Compute convective Sommerfeld radiation conditions for open outflows.

pub type BoundaryConfig = struct {
    inflow_u_max: Float,
    channel_height_h: Float,
    convective_speed_c: Float
};

pub type WallReflection = struct {
    u_ghost: Float,
    v_ghost: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn boundary_config_default() -> BoundaryConfig {
    return BoundaryConfig {
        inflow_u_max: 1.0,
        channel_height_h: 1.0,
        convective_speed_c: 1.0
    };
}

// -------------------------------------------------------------------
// Inflow Velocity Profiles
// -------------------------------------------------------------------

pub fn poiseuille_inflow_u(y: Float, h: Float, u_max: Float) -> Float {
    if h <= 0.00001 {
        return 0.0;
    }
    let norm_y: Float = y / h;
    if norm_y < 0.0 {
        return 0.0;
    }
    if norm_y > 1.0 {
        return 0.0;
    }
    return 4.0 * u_max * norm_y * (1.0 - norm_y);
}

// -------------------------------------------------------------------
// Wall Reflections
// -------------------------------------------------------------------

pub fn no_slip_wall_ghost(u_interior: Float, v_interior: Float) -> WallReflection {
    return WallReflection {
        u_ghost: 0.0 - u_interior,
        v_ghost: 0.0 - v_interior
    };
}

pub fn free_slip_wall_ghost_horizontal(u_interior: Float, v_interior: Float) -> WallReflection {
    return WallReflection {
        u_ghost: u_interior,
        v_ghost: 0.0 - v_interior
    };
}

pub fn free_slip_wall_ghost_vertical(u_interior: Float, v_interior: Float) -> WallReflection {
    return WallReflection {
        u_ghost: 0.0 - u_interior,
        v_ghost: v_interior
    };
}

// -------------------------------------------------------------------
// Convective Outflow (Sommerfeld Condition)
// -------------------------------------------------------------------

pub fn convective_outflow_step(
    phi_boundary: Float,
    phi_prev_interior: Float,
    c: Float,
    dt: Float,
    dx: Float
) -> Float {
    let cfl: Float = (c * dt) / dx;
    return phi_boundary - (cfl * (phi_boundary - phi_prev_interior));
}
