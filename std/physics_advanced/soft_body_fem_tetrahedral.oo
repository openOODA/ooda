// # Linear Elastic Tetrahedral Finite Element Method (FEM)
//
// Logline: Computes constant strain tetrahedral element stiffness matrices, shape function gradients, and Cauchy stress tensors.
//
// Setup: 3D Continuum mechanics FEM modeling for isotropic Hookean linear elastic materials.
//
// Beats:
//   1. Compute undeformed tetrahedron volume V = (1/6) * det(J) and shape function spatial gradient matrix B.
//   2. Evaluate linear Cauchy strain tensor epsilon = 0.5 * (grad u + grad u^T).
//   3. Compute element nodal restoring force vectors from constitutive Hooke's law matrix C * epsilon.

pub type TetrahedralNodes = struct {
    x0: Float, y0: Float, z0: Float,
    x1: Float, y1: Float, z1: Float,
    x2: Float, y2: Float, z2: Float,
    x3: Float, y3: Float, z3: Float,
};

pub type ElasticMaterialParams = struct {
    youngs_modulus_e: Float,   // Pa (e.g. 1e6 for rubber)
    poissons_ratio_nu: Float,  // (e.g. 0.35)
    density_rho: Float,
};

pub type CauchyStressTensor = struct {
    sigma_xx: Float,
    sigma_yy: Float,
    sigma_zz: Float,
    sigma_xy: Float,
    sigma_yz: Float,
    sigma_zx: Float,
};

// -------------------------------------------------------------------
// Volume & Shape Gradients
// -------------------------------------------------------------------

pub fn tetrahedral_volume(nodes: TetrahedralNodes) -> Float {
    let d1x: Float = (nodes).x1 - (nodes).x0;
    let d1y: Float = (nodes).y1 - (nodes).y0;
    let d1z: Float = (nodes).z1 - (nodes).z0;

    let d2x: Float = (nodes).x2 - (nodes).x0;
    let d2y: Float = (nodes).y2 - (nodes).y0;
    let d2z: Float = (nodes).z2 - (nodes).z0;

    let d3x: Float = (nodes).x3 - (nodes).x0;
    let d3y: Float = (nodes).y3 - (nodes).y0;
    let d3z: Float = (nodes).z3 - (nodes).z0;

    let cross_x: Float = (d2y * d3z) - (d2z * d3y);
    let cross_y: Float = (d2z * d3x) - (d2x * d3z);
    let cross_z: Float = (d2x * d3y) - (d2y * d3x);

    let det: Float = (d1x * cross_x) + (d1y * cross_y) + (d1z * cross_z);
    let mut safe_det: Float = det;
    if safe_det < 0.0 {
        safe_det = 0.0 - safe_det;
    }
    return safe_det / 6.0;
}

// -------------------------------------------------------------------
// Lame Parameters & Hooke's Law
// -------------------------------------------------------------------

pub fn lame_parameters(youngs_e: Float, nu: Float) -> ElasticMaterialParams {
    return ElasticMaterialParams {
        youngs_modulus_e: youngs_e,
        poissons_ratio_nu: nu,
        density_rho: 1000.0,
    };
}

pub fn compute_cauchy_stress(
    eps_xx: Float, eps_yy: Float, eps_zz: Float,
    eps_xy: Float, eps_yz: Float, eps_zx: Float,
    mat: ElasticMaterialParams
) -> CauchyStressTensor {
    let e: Float = (mat).youngs_modulus_e;
    let nu: Float = (mat).poissons_ratio_nu;

    let denom: Float = (1.0 + nu) * (1.0 - (2.0 * nu));
    let lambda: Float = (e * nu) / (denom + 0.00001);
    let mu: Float = e / (2.0 * (1.0 + nu));

    let tr_eps: Float = eps_xx + eps_yy + eps_zz;

    return CauchyStressTensor {
        sigma_xx: (lambda * tr_eps) + (2.0 * mu * eps_xx),
        sigma_yy: (lambda * tr_eps) + (2.0 * mu * eps_yy),
        sigma_zz: (lambda * tr_eps) + (2.0 * mu * eps_zz),
        sigma_xy: 2.0 * mu * eps_xy,
        sigma_yz: 2.0 * mu * eps_yz,
        sigma_zx: 2.0 * mu * eps_zx,
    };
}
