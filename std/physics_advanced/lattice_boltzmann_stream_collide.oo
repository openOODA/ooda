// # Lattice Boltzmann BGK Streaming & Collision Step
//
// Logline: Implements the single-relaxation-time Bhatnagar-Gross-Krook (BGK) collision operator and advective streaming step.
//
// Setup: Relaxes populations towards equilibrium f_eq with dimensionless relaxation parameter tau = 3*nu + 0.5.
//
// Beats:
//   1. Define LbmBgkConfig relaxation and kinematic viscosity parameters.
//   2. Compute local BGK post-collision populations f_star_i = f_i - (f_i - f_eq_i)/tau.
//   3. Apply external body force acceleration terms (Guo forcing scheme).

pub type LbmBgkConfig = struct {
    tau_relaxation: Float,
    kinematic_viscosity: Float,
    force_x: Float,
    force_y: Float,
};

pub type BgkCollisionResult = struct {
    f_post: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn lbm_bgk_config_from_viscosity(nu: Float) -> LbmBgkConfig {
    let tau: Float = (3.0 * nu) + 0.5;
    return LbmBgkConfig {
        tau_relaxation: tau,
        kinematic_viscosity: nu,
        force_x: 0.0,
        force_y: 0.0,
    };
}

pub fn lbm_kinematic_viscosity_from_tau(tau: Float) -> Float {
    return (tau - 0.5) / 3.0;
}

// -------------------------------------------------------------------
// BGK Collision Step
// -------------------------------------------------------------------

pub fn lbm_bgk_collide_single(
    f_curr: Float,
    f_eq: Float,
    tau: Float
) -> Float {
    let mut safe_tau: Float = tau;
    if safe_tau <= 0.50001 {
        safe_tau = 0.50001;
    }
    let omega: Float = 1.0 / safe_tau;
    return f_curr - (omega * (f_curr - f_eq));
}

// -------------------------------------------------------------------
// Guo External Forcing Term
// -------------------------------------------------------------------

pub fn lbm_guo_force_term(
    index: Int,
    weight: Float,
    u: Float,
    v: Float,
    fx: Float,
    fy: Float,
    tau: Float
) -> Float {
    let mut cx: Float = 0.0;
    let mut cy: Float = 0.0;

    if index == 1 { cx = 1.0; cy = 0.0; }
    if index == 2 { cx = 0.0; cy = 1.0; }
    if index == 3 { cx = 0.0 - 1.0; cy = 0.0; }
    if index == 4 { cx = 0.0; cy = 0.0 - 1.0; }
    if index == 5 { cx = 1.0; cy = 1.0; }
    if index == 6 { cx = 0.0 - 1.0; cy = 1.0; }
    if index == 7 { cx = 0.0 - 1.0; cy = 0.0 - 1.0; }
    if index == 8 { cx = 1.0; cy = 0.0 - 1.0; }

    let e_minus_u_x: Float = cx - u;
    let e_minus_u_y: Float = cy - v;
    let dot_prod: Float = (e_minus_u_x * fx) + (e_minus_u_y * fy);
    let factor: Float = 1.0 - (0.5 / tau);
    return factor * weight * 3.0 * dot_prod;
}
