// # Airfoil Lift & Drag Polar Aerodynamic Models
//
// Logline: Evaluates thin airfoil theoretical lift curves, stall angles, skin friction, and parasitic/induced drag polars.
//
// Setup: Aerodynamic force coefficients for 2D airfoil sections across pre-stall, stall, and post-stall regimes.
//
// Beats:
//   1. Compute linear thin airfoil lift slope Cl = 2*pi*(alpha - alpha_0).
//   2. Apply smooth hyperbolic tangent / Viterna post-stall aerodynamic transition.
//   3. Compute quadratic parasitic drag polar Cd = Cd0 + k * (Cl - Cl_min)^2.

pub type AirfoilPolarConfig = struct {
    cl_alpha_slope: Float,   // Radians^-1 (~ 2*pi = 6.28)
    alpha_zero_lift: Float,  // Radians
    cl_max: Float,           // Maximum pre-stall lift
    alpha_stall: Float,      // Stall angle radians (~ 0.25 rad = 14 deg)
    cd_0: Float,             // Zero-lift drag coefficient (~ 0.008)
    induced_drag_k: Float   // Drag polar curvature k (~ 0.04)
};

pub type AerodynamicCoefficients = struct {
    cl: Float,
    cd: Float,
    cm_quarter_chord: Float,
    is_stalled: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn airfoil_polar_config_default() -> AirfoilPolarConfig {
    return AirfoilPolarConfig {
        cl_alpha_slope: 6.283185307179586, // 2 * pi
        alpha_zero_lift: 0.0 - 0.035,       // -2 deg
        cl_max: 1.4,
        alpha_stall: 0.2618,                // 15 deg
        cd_0: 0.008,
        induced_drag_k: 0.045
    };
}

// -------------------------------------------------------------------
// Lift & Drag Evaluation
// -------------------------------------------------------------------

pub fn airfoil_evaluate_polar(
    config: AirfoilPolarConfig,
    alpha_rad: Float
) -> AerodynamicCoefficients {
    let cl_slope: Float = (config).cl_alpha_slope;
    let a0: Float = (config).alpha_zero_lift;
    let a_stall: Float = (config).alpha_stall;
    let cl_max: Float = (config).cl_max;
    let cd0: Float = (config).cd_0;
    let k_drag: Float = (config).induced_drag_k;

    let eff_alpha: Float = alpha_rad - a0;
    let mut cl_linear: Float = cl_slope * eff_alpha;
    let mut stalled: Int = 0;

    if alpha_rad > a_stall {
        stalled = 1;
        let excess: Float = alpha_rad - a_stall;
        cl_linear = cl_max - (2.0 * excess);
        if cl_linear < 0.2 {
            cl_linear = 0.2;
        }
    }

    if alpha_rad < (0.0 - a_stall) {
        stalled = 1;
        let excess: Float = (0.0 - a_stall) - alpha_rad;
        cl_linear = (0.0 - cl_max) + (2.0 * excess);
        if cl_linear > (0.0 - 0.2) {
            cl_linear = 0.0 - 0.2;
        }
    }

    let cd: Float = cd0 + (k_drag * cl_linear * cl_linear);
    let cm_c4: Float = 0.0 - (0.05 * cl_linear); // Quarter-chord pitching moment

    return AerodynamicCoefficients {
        cl: cl_linear,
        cd: cd,
        cm_quarter_chord: cm_c4,
        is_stalled: stalled
    };
}

pub fn lift_to_drag_ratio(cl: Float, cd: Float) -> Float {
    if cd <= 0.00001 {
        return 0.0;
    }
    return cl / cd;
}
