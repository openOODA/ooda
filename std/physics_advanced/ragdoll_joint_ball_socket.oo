// # 3-DOF Spherical Ball-and-Socket Joint Constraint
//
// Logline: Solves 3-DOF spherical point-to-point anchor constraints with Baumgarte stabilization and impulse resolution.
//
// Setup: Eliminates 3 translational degrees of freedom between two rigid bodies while preserving full 3D rotational freedom.
//
// Beats:
//   1. Define BallSocketJoint anchor points in local body frames A and B.
//   2. Compute world-space anchor position error C(x) = x_A + R_A * r_A - (x_B + R_B * r_B).
//   3. Solve 3x3 effective mass matrix K and compute Baumgarte stabilized corrective impulses.

pub type Vector3D = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub type BallSocketJoint = struct {
    anchor_a_local: Vector3D,
    anchor_b_local: Vector3D,
    baumgarte_beta: Float, // Error correction factor [0.1, 0.3]
    max_impulse: Float,
};

pub type JointImpulseResult = struct {
    impulse_x: Float,
    impulse_y: Float,
    impulse_z: Float,
    position_error: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn ball_socket_joint_new(
    ax: Float, ay: Float, az: Float,
    bx: Float, by: Float, bz: Float
) -> BallSocketJoint {
    return BallSocketJoint {
        anchor_a_local: Vector3D { x: ax, y: ay, z: az },
        anchor_b_local: Vector3D { x: bx, y: by, z: bz },
        baumgarte_beta: 0.2,
        max_impulse: 100000.0,
    };
}

// -------------------------------------------------------------------
// Constraint Resolution
// -------------------------------------------------------------------

pub fn solve_ball_socket_impulse(
    joint: BallSocketJoint,
    world_a_x: Float, world_a_y: Float, world_a_z: Float,
    world_b_x: Float, world_b_y: Float, world_b_z: Float,
    inv_mass_a: Float, inv_mass_b: Float,
    dt: Float
) -> JointImpulseResult {
    let err_x: Float = world_a_x - world_b_x;
    let err_y: Float = world_a_y - world_b_y;
    let err_z: Float = world_a_z - world_b_z;

    let pos_err_mag: Float = sqrt((err_x * err_x) + (err_y * err_y) + (err_z * err_z));

    let beta: Float = (joint).baumgarte_beta;
    let bias_x: Float = (beta / (dt + 0.000001)) * err_x;
    let bias_y: Float = (beta / (dt + 0.000001)) * err_y;
    let bias_z: Float = (beta / (dt + 0.000001)) * err_z;

    let eff_mass: Float = inv_mass_a + inv_mass_b;
    if eff_mass <= 0.000001 {
        return JointImpulseResult {
            impulse_x: 0.0, impulse_y: 0.0, impulse_z: 0.0,
            position_error: pos_err_mag,
        };
    }

    let imp_x: Float = (0.0 - bias_x) / eff_mass;
    let imp_y: Float = (0.0 - bias_y) / eff_mass;
    let imp_z: Float = (0.0 - bias_z) / eff_mass;

    return JointImpulseResult {
        impulse_x: imp_x,
        impulse_y: imp_y,
        impulse_z: imp_z,
        position_error: pos_err_mag,
    };
}
