// # NACA 4-Digit Airfoil Geometry Generator
//
// Logline: Generates mean camber lines, thickness distributions, and upper/lower surface coordinates for NACA 4-digit airfoils.
//
// Setup: Analytical profile generation parameterized by maximum camber (m), position (p), and maximum thickness (t).
//
// Beats:
//   1. Define Naca4Params configuration (e.g. NACA 2412 -> m=0.02, p=0.4, t=0.12).
//   2. Evaluate parabolic mean camber line y_c(x) and local camber slope dy_c/dx.
//   3. Compute half-thickness distribution y_t(x) and project orthogonal upper (x_u, y_u) and lower (x_l, y_l) coordinates.

pub type Naca4Params = struct {
    max_camber_m: Float,     // e.g. 0.02
    camber_pos_p: Float,     // e.g. 0.4
    thickness_t: Float,      // e.g. 0.12
    chord_c: Float,          // Chord length meters
};

pub type AirfoilCoordinatePair = struct {
    x_upper: Float,
    y_upper: Float,
    x_lower: Float,
    y_lower: Float,
    camber_y: Float,
    thickness_yt: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn naca4_params_new(m: Float, p: Float, t: Float, chord: Float) -> Naca4Params {
    let mut safe_chord: Float = chord;
    if safe_chord <= 0.0001 {
        safe_chord = 1.0;
    }
    return Naca4Params {
        max_camber_m: m,
        camber_pos_p: p,
        thickness_t: t,
        chord_c: safe_chord,
    };
}

pub fn naca4_naca0012(chord: Float) -> Naca4Params {
    return naca4_params_new(0.0, 0.0, 0.12, chord);
}

pub fn naca4_naca2412(chord: Float) -> Naca4Params {
    return naca4_params_new(0.02, 0.4, 0.12, chord);
}

pub fn naca4_naca4415(chord: Float) -> Naca4Params {
    return naca4_params_new(0.04, 0.4, 0.15, chord);
}

// -------------------------------------------------------------------
// Camber & Thickness Formulas
// -------------------------------------------------------------------

pub fn naca4_camber_line(x_norm: Float, m: Float, p: Float) -> Float {
    if p <= 0.0001 {
        return 0.0;
    }
    if x_norm < p {
        let p2: Float = p * p;
        return (m / p2) * ((2.0 * p * x_norm) - (x_norm * x_norm));
    } else {
        let om_p: Float = 1.0 - p;
        let om_p2: Float = om_p * om_p;
        let term: Float = (1.0 - (2.0 * p)) + (2.0 * p * x_norm) - (x_norm * x_norm);
        return (m / om_p2) * term;
    }
}

pub fn naca4_camber_slope(x_norm: Float, m: Float, p: Float) -> Float {
    if p <= 0.0001 {
        return 0.0;
    }
    if x_norm < p {
        let p2: Float = p * p;
        return ((2.0 * m) / p2) * (p - x_norm);
    } else {
        let om_p: Float = 1.0 - p;
        let om_p2: Float = om_p * om_p;
        return ((2.0 * m) / om_p2) * (p - x_norm);
    }
}

pub fn naca4_half_thickness(x_norm: Float, t: Float) -> Float {
    let sqrt_x: Float = sqrt(x_norm);
    let x2: Float = x_norm * x_norm;
    let x3: Float = x2 * x_norm;
    let x4: Float = x3 * x_norm;

    let poly: Float = (0.2969 * sqrt_x) - (0.1260 * x_norm) - (0.3516 * x2) + (0.2843 * x3) - (0.1015 * x4);
    return 5.0 * t * poly;
}

// -------------------------------------------------------------------
// Surface Coordinate Evaluation
// -------------------------------------------------------------------

pub fn naca4_evaluate_point(params: Naca4Params, x_chord_ratio: Float) -> AirfoilCoordinatePair {
    let mut xn: Float = x_chord_ratio;
    if xn < 0.0 { xn = 0.0; }
    if xn > 1.0 { xn = 1.0; }

    let m: Float = (params).max_camber_m;
    let p: Float = (params).camber_pos_p;
    let t: Float = (params).thickness_t;
    let c: Float = (params).chord_c;

    let yc: Float = naca4_camber_line(xn, m, p);
    let dyc: Float = naca4_camber_slope(xn, m, p);
    let yt: Float = naca4_half_thickness(xn, t);

    let theta: Float = dyc; // Small angle approx for normal orientation
    let sin_th: Float = theta / sqrt(1.0 + (theta * theta));
    let cos_th: Float = 1.0 / sqrt(1.0 + (theta * theta));

    let xu: Float = (xn - (yt * sin_th)) * c;
    let yu: Float = (yc + (yt * cos_th)) * c;
    let xl: Float = (xn + (yt * sin_th)) * c;
    let yl: Float = (yc - (yt * cos_th)) * c;

    return AirfoilCoordinatePair {
        x_upper: xu,
        y_upper: yu,
        x_lower: xl,
        y_lower: yl,
        camber_y: yc * c,
        thickness_yt: yt * c,
    };
}
