// # Elliptic Cone-Twist Biomechanical Joint
//
// Logline: Constrains spherical swing motions within an elliptic cone boundary and enforces axial twist rotation limits.
//
// Setup: Biomechanical hip, shoulder, and neck joints with asymmetric swing spans (swing_span_1, swing_span_2) and twist limits.
//
// Beats:
//   1. Define ConeTwistJoint configuration (swing1_limit, swing2_limit, twist_limit).
//   2. Evaluate elliptic cone swing angular deviation (th1/span1)^2 + (th2/span2)^2 <= 1.
//   3. Compute twist angle along longitudinal bone axis and project clamp impulses.

pub type ConeTwistJoint = struct {
    swing_span_1_rad: Float, // Maximum swing around local X
    swing_span_2_rad: Float, // Maximum swing around local Y
    twist_span_rad: Float,   // Maximum twist around local Z
    damping: Float
};

pub type ConeTwistStatus = struct {
    is_swing_clamped: Int,
    is_twist_clamped: Int,
    swing_penetration: Float,
    twist_penetration: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn cone_twist_shoulder_joint() -> ConeTwistJoint {
    return ConeTwistJoint {
        swing_span_1_rad: 1.309, // 75 deg
        swing_span_2_rad: 1.047, // 60 deg
        twist_span_rad: 0.785,   // 45 deg
        damping: 0.85
    };
}

pub fn cone_twist_hip_joint() -> ConeTwistJoint {
    return ConeTwistJoint {
        swing_span_1_rad: 0.873, // 50 deg
        swing_span_2_rad: 0.698, // 40 deg
        twist_span_rad: 0.524,   // 30 deg
        damping: 0.9
    };
}

// -------------------------------------------------------------------
// Cone & Twist Boundary Evaluation
// -------------------------------------------------------------------

pub fn cone_twist_evaluate_angles(
    joint: ConeTwistJoint,
    angle_swing_1: Float,
    angle_swing_2: Float,
    angle_twist: Float
) -> ConeTwistStatus {
    let s1: Float = (joint).swing_span_1_rad;
    let s2: Float = (joint).swing_span_2_rad;
    let tw: Float = (joint).twist_span_rad;

    let r1: Float = angle_swing_1 / (s1 + 0.00001);
    let r2: Float = angle_swing_2 / (s2 + 0.00001);
    let ellipse_norm: Float = (r1 * r1) + (r2 * r2);

    let mut swing_clamp: Int = 0;
    let mut swing_pen: Float = 0.0;
    if ellipse_norm > 1.0 {
        swing_clamp = 1;
        swing_pen = sqrt(ellipse_norm) - 1.0;
    }

    let mut twist_clamp: Int = 0;
    let mut twist_pen: Float = 0.0;
    let mut abs_twist: Float = angle_twist;
    if abs_twist < 0.0 {
        abs_twist = 0.0 - abs_twist;
    }
    if abs_twist > tw {
        twist_clamp = 1;
        twist_pen = abs_twist - tw;
    }

    return ConeTwistStatus {
        is_swing_clamped: swing_clamp,
        is_twist_clamped: twist_clamp,
        swing_penetration: swing_pen,
        twist_penetration: twist_pen
    };
}
