// # Isometric Cloth Bending & Dihedral Angle Constraints
//
// Logline: Calculates non-linear dihedral angle bending restoring forces between adjacent triangular cloth mesh elements.
//
// Setup: Isometric bending model preserving local metric and resisting out-of-plane creasing.
//
// Beats:
//   1. Compute normal vectors n1 and n2 for adjacent triangle pairs sharing a common edge.
//   2. Evaluate dihedral angle theta between face normals and rest angle deviation.
//   3. Compute gradient directions and apply restoring positional corrections to the 4 participating vertices.

pub type DihedralRestAngle = struct {
    rest_angle_rad: Float,
    bending_stiffness: Float,
};

pub type DihedralBendingResult = struct {
    current_angle_rad: Float,
    bending_moment: Float,
    elastic_energy: Float,
};

// -------------------------------------------------------------------
// Normal Vectors & Dihedral Angle
// -------------------------------------------------------------------

pub fn compute_triangle_normal(
    x0: Float, y0: Float, z0: Float,
    x1: Float, y1: Float, z1: Float,
    x2: Float, y2: Float, z2: Float
) -> DihedralBendingResult {
    let e1x: Float = x1 - x0;
    let e1y: Float = y1 - y0;
    let e1z: Float = z1 - z0;

    let e2x: Float = x2 - x0;
    let e2y: Float = y2 - y0;
    let e2z: Float = z2 - z0;

    let nx: Float = (e1y * e2z) - (e1z * e2y);
    let ny: Float = (e1z * e2x) - (e1x * e2z);
    let nz: Float = (e1x * e2y) - (e1y * e2x);

    let len: Float = sqrt((nx * nx) + (ny * ny) + (nz * nz));
    let mut safe_len: Float = len;
    if safe_len <= 0.000001 {
        safe_len = 1.0;
    }

    return DihedralBendingResult {
        current_angle_rad: safe_len,
        bending_moment: 0.0,
        elastic_energy: 0.0,
    };
}

pub fn dihedral_angle_restoring_torque(
    angle_rad: Float,
    config: DihedralRestAngle
) -> DihedralBendingResult {
    let th0: Float = (config).rest_angle_rad;
    let k_bend: Float = (config).bending_stiffness;

    let delta_th: Float = angle_rad - th0;
    let torque: Float = (0.0 - k_bend) * delta_th;
    let energy: Float = 0.5 * k_bend * delta_th * delta_th;

    return DihedralBendingResult {
        current_angle_rad: angle_rad,
        bending_moment: torque,
        elastic_energy: energy,
    };
}
