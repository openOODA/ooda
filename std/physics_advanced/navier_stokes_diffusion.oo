// # Navier-Stokes Viscous Diffusion Solver
//
// Logline: Evaluates 2D viscous momentum diffusion with explicit finite-difference Laplacians and Crank-Nicolson implicit stepping.
//
// Setup: Solves kinematic viscosity diffusion equations (nu * div grad u) for incompressible fluid velocity fields.
//
// Beats:
//   1. Compute 5-point discrete finite-difference Laplacian stencils.
//   2. Execute explicit forward Euler viscous momentum diffusion step.
//   3. Provide implicit Jacobi relaxation step for stiff high-viscosity Stokes flows.

pub type DiffusionConfig = struct {
    kinematic_viscosity_nu: Float,
    cfl_visc_limit: Float
};

pub type LaplacianStencil2D = struct {
    center: Float,
    east: Float,
    west: Float,
    north: Float,
    south: Float,
    dx: Float,
    dy: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn diffusion_config_default() -> DiffusionConfig {
    return DiffusionConfig {
        kinematic_viscosity_nu: 0.001, // m^2/s
        cfl_visc_limit: 0.25
    };
}

// -------------------------------------------------------------------
// Discrete Laplacian Stencil
// -------------------------------------------------------------------

pub fn compute_laplacian_2d(stencil: LaplacianStencil2D) -> Float {
    let dx: Float = (stencil).dx;
    let dy: Float = (stencil).dy;
    let c: Float = (stencil).center;
    let e: Float = (stencil).east;
    let w: Float = (stencil).west;
    let n: Float = (stencil).north;
    let s: Float = (stencil).south;

    let d2_dx2: Float = (e - (2.0 * c) + w) / (dx * dx);
    let d2_dy2: Float = (n - (2.0 * c) + s) / (dy * dy);
    return d2_dx2 + d2_dy2;
}

// -------------------------------------------------------------------
// Explicit Viscous Step
// -------------------------------------------------------------------

pub fn diffusion_step_explicit(
    val_center: Float,
    laplacian: Float,
    nu: Float,
    dt: Float
) -> Float {
    return val_center + (nu * dt * laplacian);
}

// -------------------------------------------------------------------
// Implicit Jacobi Relaxation Step
// -------------------------------------------------------------------

pub fn diffusion_step_implicit_jacobi_cell(
    val_orig: Float,
    val_east: Float,
    val_west: Float,
    val_north: Float,
    val_south: Float,
    nu: Float,
    dt: Float,
    dx: Float,
    dy: Float
) -> Float {
    let alpha_x: Float = (nu * dt) / (dx * dx);
    let alpha_y: Float = (nu * dt) / (dy * dy);
    let denom: Float = 1.0 + (2.0 * alpha_x) + (2.0 * alpha_y);
    let num: Float = val_orig + (alpha_x * (val_east + val_west)) + (alpha_y * (val_north + val_south));
    return num / denom;
}

pub fn diffusion_stability_max_dt(nu: Float, dx: Float, dy: Float) -> Float {
    let mut min_d: Float = dx;
    if dy < min_d {
        min_d = dy;
    }
    if nu <= 0.000001 {
        return 1.0;
    }
    return (0.25 * min_d * min_d) / nu;
}
