// # Standard k-Epsilon Two-Equation Turbulence Model
//
// Logline: Implements turbulent kinetic energy (k) and dissipation rate (epsilon) transport equations and turbulent eddy viscosity closure.
//
// Setup: High Reynolds number 2-equation Reynolds-Averaged Navier-Stokes (RANS) closure.
//
// Beats:
//   1. Define standard empirical k-epsilon empirical constants (C_mu, C1_eps, C2_eps, sigma_k, sigma_eps).
//   2. Compute shear production rate P_k from Reynolds stresses and mean velocity gradients.
//   3. Evaluate turbulent eddy viscosity nu_t = C_mu * k^2 / epsilon.

pub type KEpsilonConstants = struct {
    c_mu: Float,       // 0.09
    c1_eps: Float,     // 1.44
    c2_eps: Float,     // 1.92
    sigma_k: Float,    // 1.0
    sigma_eps: Float,  // 1.3
};

pub type KEpsilonState = struct {
    k: Float,
    epsilon: Float,
    nu_turbulent: Float,
    production_p: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn k_epsilon_constants_standard() -> KEpsilonConstants {
    return KEpsilonConstants {
        c_mu: 0.09,
        c1_eps: 1.44,
        c2_eps: 1.92,
        sigma_k: 1.0,
        sigma_eps: 1.3,
    };
}

pub fn k_epsilon_state_new(k_init: Float, eps_init: Float, c_mu: Float) -> KEpsilonState {
    let mut safe_eps: Float = eps_init;
    if safe_eps <= 0.000001 {
        safe_eps = 0.000001;
    }
    let nu_t: Float = c_mu * (k_init * k_init) / safe_eps;
    return KEpsilonState {
        k: k_init,
        epsilon: safe_eps,
        nu_turbulent: nu_t,
        production_p: 0.0,
    };
}

// -------------------------------------------------------------------
// Turbulence Production & Viscosity
// -------------------------------------------------------------------

pub fn compute_turbulent_production(
    nu_t: Float,
    du_dx: Float,
    du_dy: Float,
    dv_dx: Float,
    dv_dy: Float
) -> Float {
    let s_xx: Float = du_dx;
    let s_yy: Float = dv_dy;
    let s_xy: Float = 0.5 * (du_dy + dv_dx);
    let term: Float = (2.0 * s_xx * s_xx) + (2.0 * s_yy * s_yy) + (4.0 * s_xy * s_xy);
    return nu_t * term;
}

pub fn compute_k_epsilon_nu_t(k: Float, eps: Float, c_mu: Float) -> Float {
    if eps <= 0.000001 {
        return 0.0;
    }
    return c_mu * (k * k) / eps;
}

// -------------------------------------------------------------------
// Source Term Evaluations
// -------------------------------------------------------------------

pub fn k_source_term(prod: Float, eps: Float) -> Float {
    return prod - eps;
}

pub fn epsilon_source_term(
    prod: Float,
    eps: Float,
    k: Float,
    c1: Float,
    c2: Float
) -> Float {
    if k <= 0.000001 {
        return 0.0;
    }
    return ((c1 * prod * eps) / k) - ((c2 * eps * eps) / k);
}
