// # Hypersonic Modified Newtonian Impact Aerodynamics
//
// Logline: Implements Newtonian impact theory for high Mach numbers (M >> 5), stagnation pressure coefficients, and blunt body drag.
//
// Setup: High-energy hypersonic aerodynamics where bow shock layers lie close to body surfaces.
//
// Beats:
//   1. Compute stagnation point maximum pressure coefficient Cp_max via Rayleigh pitot formula.
//   2. Evaluate Newtonian local surface pressure coefficient Cp = Cp_max * sin^2(theta).
//   3. Integrate hypersonic blunt nose wave drag and aerodynamic force coefficients.

pub type HypersonicConfig = struct {
    freestream_mach: Float,
    gamma: Float,
    cp_max: Float,
};

pub type SurfacePressureSample = struct {
    surface_angle_theta_rad: Float,
    cp: Float,
    pressure_pa: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn hypersonic_config_new(mach: Float, gamma: Float) -> HypersonicConfig {
    let cp_max: Float = modified_newtonian_cp_max(mach, gamma);
    return HypersonicConfig {
        freestream_mach: mach,
        gamma: gamma,
        cp_max: cp_max,
    };
}

// -------------------------------------------------------------------
// Modified Newtonian Formulas
// -------------------------------------------------------------------

pub fn modified_newtonian_cp_max(mach: Float, gamma: Float) -> Float {
    if mach <= 1.0 {
        return 1.0;
    }
    let m2: Float = mach * mach;
    let gp1: Float = gamma + 1.0;
    let gm1: Float = gamma - 1.0;

    let term1: Float = (gp1 * m2) / ((gm1 * m2) + 2.0);
    let term2: Float = gp1 / ((2.0 * gamma * m2) - gm1);
    let p02_p1: Float = pow(term1, gamma / gm1) * pow(term2, 1.0 / gm1);

    let q_inf_ratio: Float = 0.5 * gamma * m2;
    return (p02_p1 - 1.0) / q_inf_ratio;
}

pub fn newtonian_surface_pressure_cp(
    cp_max: Float,
    surface_inclination_angle_rad: Float
) -> Float {
    let sin_th: Float = sin(surface_inclination_angle_rad);
    if sin_th <= 0.0 {
        return 0.0; // In aerodynamic shadow (Cp = 0)
    }
    return cp_max * sin_th * sin_th;
}

pub fn hypersonic_sphere_drag_cd(cp_max: Float) -> Float {
    return 0.5 * cp_max; // Analytical Newtonian integral over hemisphere
}
