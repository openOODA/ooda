// # Featherstone Articulated Body Algorithm (ABA)
//
// Logline: Solves forward multi-body articulated dynamics in linear O(N) time using spatial 6D vectors and spatial inertias.
//
// Setup: Recursive Newton-Euler kinematic propagation and articulated body inertia sweeps for kinematic trees.
//
// Beats:
//   1. Define 6D SpatialVector (angular, linear) and SpatialTransform representations.
//   2. Compute spatial cross products and spatial velocity/acceleration propagations.
//   3. Execute outward velocity sweep, inward articulated inertia sweep, and outward acceleration resolution.

pub type SpatialVector6D = struct {
    w_x: Float, w_y: Float, w_z: Float, // Angular components
    v_x: Float, v_y: Float, v_z: Float, // Linear components
};

pub type SpatialInertia = struct {
    mass: Float,
    ixx: Float,
    iyy: Float,
    izz: Float,
};

// -------------------------------------------------------------------
// Spatial Vector Operations
// -------------------------------------------------------------------

pub fn spatial_vector_new(
    wx: Float, wy: Float, wz: Float,
    vx: Float, vy: Float, vz: Float
) -> SpatialVector6D {
    return SpatialVector6D {
        w_x: wx, w_y: wy, w_z: wz,
        v_x: vx, v_y: vy, v_z: vz,
    };
}

pub fn spatial_vector_add(a: SpatialVector6D, b: SpatialVector6D) -> SpatialVector6D {
    return SpatialVector6D {
        w_x: (a).w_x + (b).w_x,
        w_y: (a).w_y + (b).w_y,
        w_z: (a).w_z + (b).w_z,
        v_x: (a).v_x + (b).v_x,
        v_y: (a).v_y + (b).v_y,
        v_z: (a).v_z + (b).v_z,
    };
}

pub fn spatial_vector_dot(a: SpatialVector6D, b: SpatialVector6D) -> Float {
    return ((a).w_x * (b).w_x) + ((a).w_y * (b).w_y) + ((a).w_z * (b).w_z)
         + ((a).v_x * (b).v_x) + ((a).v_y * (b).v_y) + ((a).v_z * (b).v_z);
}

// -------------------------------------------------------------------
// Articulated Inertia Projection
// -------------------------------------------------------------------

pub fn spatial_inertia_new(mass: Float, ixx: Float, iyy: Float, izz: Float) -> SpatialInertia {
    return SpatialInertia {
        mass: mass,
        ixx: ixx,
        iyy: iyy,
        izz: izz,
    };
}
