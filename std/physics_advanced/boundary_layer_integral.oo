// # Integral Boundary Layer Methods (Thwaites & Head)
//
// Logline: Solves laminar and turbulent boundary layer momentum thickness, displacement thickness, and skin friction coefficients.
//
// Setup: Von Karman momentum integral equation for boundary layer evolution along airfoil surfaces.
//
// Beats:
//   1. Define BoundaryLayerState (delta_star displacement, theta momentum thickness, shape factor H).
//   2. Compute Thwaites laminar parameter lambda = (theta^2 / nu) * (dUe/dx).
//   3. Evaluate local skin friction coefficient Cf and boundary layer separation criteria.

pub type BoundaryLayerState = struct {
    displacement_thickness_delta_star: Float,
    momentum_thickness_theta: Float,
    shape_factor_h: Float,
    skin_friction_cf: Float,
    is_separated: Int
};

pub type ThwaitesResult = struct {
    theta: Float,
    lambda_param: Float,
    h_shape: Float,
    cf: Float,
    separated: Int
};

// -------------------------------------------------------------------
// Thwaites Laminar Method
// -------------------------------------------------------------------

pub fn thwaites_laminar_step(
    theta_curr: Float,
    u_edge: Float,
    du_edge_dx: Float,
    kinematic_nu: Float
) -> ThwaitesResult {
    let theta2: Float = theta_curr * theta_curr;
    let lambda: Float = (theta2 / kinematic_nu) * du_edge_dx;

    // Thwaites empirical correlations for l(lambda) and H(lambda)
    let mut h: Float = 2.6; // Blasius baseline flat plate
    let mut l_shear: Float = 0.22;
    let mut sep: Int = 0;

    if lambda < (0.0 - 0.09) {
        sep = 1; // Laminar separation point
        l_shear = 0.0;
        h = 3.5;
    } else {
        l_shear = 0.22 + (1.57 * lambda) - (1.8 * lambda * lambda);
        h = 2.61 - (3.75 * lambda) + (5.24 * lambda * lambda);
    }

    let mut cf: Float = 0.0;
    if u_edge > 0.0001 && theta_curr > 0.000001 {
        let re_theta: Float = (u_edge * theta_curr) / kinematic_nu;
        if re_theta > 0.0001 {
            cf = (2.0 * l_shear) / re_theta;
        }
    }

    return ThwaitesResult {
        theta: theta_curr,
        lambda_param: lambda,
        h_shape: h,
        cf: cf,
        separated: sep
    };
}

// -------------------------------------------------------------------
// Turbulent Flat Plate Boundary Layer (Prandtl 1/7th Power Law)
// -------------------------------------------------------------------

pub fn turbulent_flat_plate_theta(x: Float, re_x: Float) -> Float {
    if re_x <= 1.0 {
        return 0.0;
    }
    // theta approx 0.036 * x / (Re_x ^ 0.2)
    let denom: Float = pow(re_x, 0.2);
    if denom <= 0.0001 {
        return 0.0;
    }
    return (0.036 * x) / denom;
}

pub fn turbulent_skin_friction_cf(re_x: Float) -> Float {
    if re_x <= 1000.0 {
        return 0.005;
    }
    // Cf = 0.0592 / (Re_x ^ 0.2)
    let denom: Float = pow(re_x, 0.2);
    return 0.0592 / denom;
}
