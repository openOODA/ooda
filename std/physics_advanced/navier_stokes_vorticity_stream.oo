// # Navier-Stokes Vorticity-Streamfunction Formulation
//
// Logline: Implements 2D vorticity transport, streamfunction Poisson inversion, and circulation conservation metrics.
//
// Setup: Solves 2D incompressible fluid flows without pressure fields via vorticity omega = curl(u) and streamfunction psi.
//
// Beats:
//   1. Calculate discrete scalar vorticity from 2D velocity curls.
//   2. Invert Poisson equation for streamfunction laplacian(psi) = -omega.
//   3. Reconstruct solenoidal velocity fields from streamfunction derivatives.

pub type VorticityPoint2D = struct {
    omega: Float,
    psi: Float,
    u: Float,
    v: Float,
};

pub type CirculationMetrics = struct {
    total_circulation: Float,
    enstrophy: Float,
};

// -------------------------------------------------------------------
// Vorticity Computation
// -------------------------------------------------------------------

pub fn compute_vorticity_2d(
    u_north: Float,
    u_south: Float,
    v_east: Float,
    v_west: Float,
    dx: Float,
    dy: Float
) -> Float {
    let dv_dx: Float = (v_east - v_west) / (2.0 * dx);
    let du_dy: Float = (u_north - u_south) / (2.0 * dy);
    return dv_dx - du_dy;
}

// -------------------------------------------------------------------
// Streamfunction Poisson Inversion (SOR Cell)
// -------------------------------------------------------------------

pub fn streamfunction_sor_cell(
    psi_center: Float,
    psi_east: Float,
    psi_west: Float,
    psi_north: Float,
    psi_south: Float,
    omega_center: Float,
    dx: Float,
    dy: Float,
    omega_sor: Float
) -> Float {
    let dx2: Float = dx * dx;
    let dy2: Float = dy * dy;
    let denom: Float = (2.0 * dx2) + (2.0 * dy2);
    let rhs: Float = omega_center * dx2 * dy2;
    let psi_jacobi: Float = (((psi_east + psi_west) * dy2) + ((psi_north + psi_south) * dx2) + rhs) / denom;
    return ((1.0 - omega_sor) * psi_center) + (omega_sor * psi_jacobi);
}

// -------------------------------------------------------------------
// Velocity Recovery from Streamfunction
// -------------------------------------------------------------------

pub fn velocity_from_streamfunction(
    psi_north: Float,
    psi_south: Float,
    psi_east: Float,
    psi_west: Float,
    dx: Float,
    dy: Float
) -> VorticityPoint2D {
    let u: Float = (psi_north - psi_south) / (2.0 * dy);
    let v: Float = 0.0 - ((psi_east - psi_west) / (2.0 * dx));
    return VorticityPoint2D {
        omega: 0.0,
        psi: 0.0,
        u: u,
        v: v,
    };
}

// -------------------------------------------------------------------
// Global Conservation Metrics
// -------------------------------------------------------------------

pub fn enstrophy_cell(omega: Float, cell_area: Float) -> Float {
    return 0.5 * omega * omega * cell_area;
}

pub fn circulation_cell(omega: Float, cell_area: Float) -> Float {
    return omega * cell_area;
}
