// # 3D Acoustic Doppler Effect & Moving Source Dynamics
//
// Logline: Calculates frequency shifts, perceived pitch ratios, and Mach cone shock angles for 3D moving acoustic sources.
//
// Setup: Relativistic and classical 3D Doppler frequency transformations for arbitrary observer and source trajectory vectors.
//
// Beats:
//   1. Compute line-of-sight velocity projections along source-to-observer unit vector r_hat.
//   2. Evaluate perceived Doppler frequency f_observed = f_source * ((c + v_obs_proj) / (c - v_src_proj)).
//   3. Evaluate supersonic Mach cone half-angle mu = asin(1 / M) for supersonic sound sources (M > 1).

pub type DopplerKinematics3D = struct {
    src_pos_x: Float, src_pos_y: Float, src_pos_z: Float,
    src_vel_x: Float, src_vel_y: Float, src_vel_z: Float,
    obs_pos_x: Float, obs_pos_y: Float, obs_pos_z: Float,
    obs_vel_x: Float, obs_vel_y: Float, obs_vel_z: Float,
};

pub type DopplerShiftResult = struct {
    observed_frequency_hz: Float,
    frequency_ratio: Float,
    source_mach: Float,
    is_supersonic: Int,
    mach_cone_angle_rad: Float,
};

// -------------------------------------------------------------------
// 3D Doppler Shift Computation
// -------------------------------------------------------------------

pub fn compute_doppler_3d(
    kin: DopplerKinematics3D,
    f_source_hz: Float,
    sound_speed_c: Float
) -> DopplerShiftResult {
    let rx: Float = (kin).obs_pos_x - (kin).src_pos_x;
    let ry: Float = (kin).obs_pos_y - (kin).src_pos_y;
    let rz: Float = (kin).obs_pos_z - (kin).src_pos_z;

    let dist: Float = sqrt((rx * rx) + (ry * ry) + (rz * rz));
    let mut safe_dist: Float = dist;
    if safe_dist <= 0.00001 {
        safe_dist = 0.00001;
    }

    let r_hat_x: Float = rx / safe_dist;
    let r_hat_y: Float = ry / safe_dist;
    let r_hat_z: Float = rz / safe_dist;

    let v_src_proj: Float = ((kin).src_vel_x * r_hat_x) + ((kin).src_vel_y * r_hat_y) + ((kin).src_vel_z * r_hat_z);
    let v_obs_proj: Float = ((kin).obs_vel_x * r_hat_x) + ((kin).obs_vel_y * r_hat_y) + ((kin).obs_vel_z * r_hat_z);

    let src_speed: Float = sqrt(((kin).src_vel_x * (kin).src_vel_x) + ((kin).src_vel_y * (kin).src_vel_y) + ((kin).src_vel_z * (kin).src_vel_z));
    let mach: Float = src_speed / sound_speed_c;

    let mut supersonic: Int = 0;
    let mut cone_angle: Float = 0.0;

    if mach > 1.0 {
        supersonic = 1;
        cone_angle = 1.0 / mach; // Small angle approx for asin(1/M)
    }

    let num: Float = sound_speed_c + v_obs_proj;
    let den: Float = sound_speed_c - v_src_proj;
    let mut ratio: Float = 1.0;
    if den > 0.001 {
        ratio = num / den;
    }

    return DopplerShiftResult {
        observed_frequency_hz: f_source_hz * ratio,
        frequency_ratio: ratio,
        source_mach: mach,
        is_supersonic: supersonic,
        mach_cone_angle_rad: cone_angle,
    };
}

pub fn sound_doppler_3d_probe() -> Int {
    return 0;
}
