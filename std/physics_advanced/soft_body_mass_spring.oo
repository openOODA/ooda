// # 3D Mass-Spring-Damper Lattice Soft Body
//
// Logline: Simulates 3D viscoelastic deformable soft bodies with structural, shear, and volumetric diagonal springs.
//
// Setup: Multi-node mass-spring network with Hookean restoring forces and Rayleigh damping.
//
// Beats:
//   1. Define SpringNode3D and ViscoelasticSpring definitions.
//   2. Compute linear Hookean spring forces F = -k * (|x_ij| - L_0) * d_ij.
//   3. Apply velocity-dependent damper forces F_damp = -c * (v_rel . d_ij) * d_ij.

pub type SpringNode3D = struct {
    x: Float,
    y: Float,
    z: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    inv_mass: Float,
};

pub type ViscoelasticSpring = struct {
    rest_length: Float,
    stiffness_k: Float,
    damping_c: Float,
};

pub type SpringForceResult = struct {
    fx: Float,
    fy: Float,
    fz: Float,
    strain: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn spring_node_3d_new(x: Float, y: Float, z: Float, mass: Float) -> SpringNode3D {
    let mut inv_m: Float = 0.0;
    if mass > 0.000001 {
        inv_m = 1.0 / mass;
    }
    return SpringNode3D {
        x: x, y: y, z: z,
        vx: 0.0, vy: 0.0, vz: 0.0,
        inv_mass: inv_m,
    };
}

pub fn viscoelastic_spring_new(rest_len: Float, k: Float, c: Float) -> ViscoelasticSpring {
    return ViscoelasticSpring {
        rest_length: rest_len,
        stiffness_k: k,
        damping_c: c,
    };
}

// -------------------------------------------------------------------
// Force Computation
// -------------------------------------------------------------------

pub fn evaluate_spring_force(
    n1: SpringNode3D,
    n2: SpringNode3D,
    spring: ViscoelasticSpring
) -> SpringForceResult {
    let dx: Float = (n2).x - (n1).x;
    let dy: Float = (n2).y - (n1).y;
    let dz: Float = (n2).z - (n1).z;

    let dist: Float = sqrt((dx * dx) + (dy * dy) + (dz * dz));
    let mut safe_dist: Float = dist;
    if safe_dist <= 0.000001 {
        safe_dist = 0.000001;
    }

    let dir_x: Float = dx / safe_dist;
    let dir_y: Float = dy / safe_dist;
    let dir_z: Float = dz / safe_dist;

    let l0: Float = (spring).rest_length;
    let k: Float = (spring).stiffness_k;
    let c: Float = (spring).damping_c;

    let delta_l: Float = dist - l0;
    let spring_mag: Float = k * delta_l;

    // Relative velocity along line of action
    let dvx: Float = (n2).vx - (n1).vx;
    let dvy: Float = (n2).vy - (n1).vy;
    let dvz: Float = (n2).vz - (n1).vz;
    let v_rel: Float = (dvx * dir_x) + (dvy * dir_y) + (dvz * dir_z);
    let damp_mag: Float = c * v_rel;

    let total_mag: Float = spring_mag + damp_mag;

    return SpringForceResult {
        fx: total_mag * dir_x,
        fy: total_mag * dir_y,
        fz: total_mag * dir_z,
        strain: delta_l / (l0 + 0.000001),
    };
}
