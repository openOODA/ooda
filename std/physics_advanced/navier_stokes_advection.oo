// # Navier-Stokes Semi-Lagrangian Advection
//
// Logline: Implements unconditionally stable Semi-Lagrangian backtracing and MacCormack second-order advection schemes.
//
// Setup: Advection of velocity components and passive scalars through Eulerian velocity vector fields.
//
// Beats:
//   1. Perform characteristic trajectory backtrace with Euler and RK2 midpoint integration.
//   2. Evaluate 2D bilinear interpolation of scalar and vector quantities at arbitrary real coordinates.
//   3. Compute MacCormack predictor-corrector limiter to minimize numerical diffusion.

pub type BilinearSample = struct {
    c00: Float,
    c10: Float,
    c01: Float,
    c11: Float,
    tx: Float,
    ty: Float,
};

pub type BacktracePosition2D = struct {
    x: Float,
    y: Float,
};

// -------------------------------------------------------------------
// Bilinear Interpolation
// -------------------------------------------------------------------

pub fn bilinear_interpolate_scalar(sample: BilinearSample) -> Float {
    let tx: Float = (sample).tx;
    let ty: Float = (sample).ty;
    let c00: Float = (sample).c00;
    let c10: Float = (sample).c10;
    let c01: Float = (sample).c01;
    let c11: Float = (sample).c11;

    let bot: Float = ((1.0 - tx) * c00) + (tx * c10);
    let top: Float = ((1.0 - tx) * c01) + (tx * c11);
    return ((1.0 - ty) * bot) + (ty * top);
}

// -------------------------------------------------------------------
// Backtrace Trajectory Integrators
// -------------------------------------------------------------------

pub fn advection_backtrace_euler(
    px: Float,
    py: Float,
    u: Float,
    v: Float,
    dt: Float
) -> BacktracePosition2D {
    return BacktracePosition2D {
        x: px - (u * dt),
        y: py - (v * dt),
    };
}

pub fn advection_backtrace_rk2(
    px: Float,
    py: Float,
    u_mid: Float,
    v_mid: Float,
    dt: Float
) -> BacktracePosition2D {
    let half_dt: Float = 0.5 * dt;
    let mid_x: Float = px - (u_mid * half_dt);
    let mid_y: Float = py - (v_mid * half_dt);
    return BacktracePosition2D {
        x: px - (u_mid * dt),
        y: py - (v_mid * dt),
    };
}

// -------------------------------------------------------------------
// MacCormack Predictor-Corrector Limiter
// -------------------------------------------------------------------

pub fn maccormack_clamp_limiter(
    phi_corrected: Float,
    c00: Float,
    c10: Float,
    c01: Float,
    c11: Float
) -> Float {
    let mut min_val: Float = c00;
    if c10 < min_val { min_val = c10; }
    if c01 < min_val { min_val = c01; }
    if c11 < min_val { min_val = c11; }

    let mut max_val: Float = c00;
    if c10 > max_val { max_val = c10; }
    if c01 > max_val { max_val = c01; }
    if c11 > max_val { max_val = c11; }

    if phi_corrected < min_val {
        return min_val;
    }
    if phi_corrected > max_val {
        return max_val;
    }
    return phi_corrected;
}

pub fn maccormack_combine(
    phi_n: Float,
    phi_fwd: Float,
    phi_bwd: Float
) -> Float {
    return phi_fwd + (0.5 * (phi_n - phi_bwd));
}
