// # General Relativistic Schwarzschild Orbital Corrections
//
// Logline: Calculates post-Newtonian relativistic perihelion advance and spacetime curvature acceleration corrections.
//
// Setup: 1st Post-Newtonian (1PN) General Relativity perturbations for relativistic orbits (Mercury, GPS, binary pulsars).
//
// Beats:
//   1. Compute Schwarzschild radius r_s = 2 * G * M / c^2.
//   2. Evaluate 1PN post-Newtonian acceleration correction Delta_a_GR.
//   3. Compute analytical relativistic perihelion advance per orbital revolution Delta_omega = 6*pi*G*M / (c^2 * a * (1 - e^2)).

pub type RelativityConfig = struct {
    central_mu: Float,       // G * M (m^3/s^2)
    speed_of_light_c: Float // m/s (299792458.0)
};

pub type RelativisticAcceleration = struct {
    ax_gr: Float,
    ay_gr: Float,
    az_gr: Float,
    schwarzschild_radius: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn relativity_config_sun() -> RelativityConfig {
    return RelativityConfig {
        central_mu: 132712440018.0 * 1000000000.0, // 1.327e20 m^3/s^2
        speed_of_light_c: 299792458.0
    };
}

pub fn relativity_config_earth() -> RelativityConfig {
    return RelativityConfig {
        central_mu: 398600.4418 * 1000000000.0, // 3.986e14 m^3/s^2
        speed_of_light_c: 299792458.0
    };
}

// -------------------------------------------------------------------
// Post-Newtonian 1PN Perturbations
// -------------------------------------------------------------------

pub fn schwarzschild_radius(mu: Float, c: Float) -> Float {
    return (2.0 * mu) / (c * c);
}

pub fn relativistic_perihelion_precession_rad(
    mu: Float,
    semi_major_axis_a: Float,
    eccentricity_e: Float,
    c: Float
) -> Float {
    let pi: Float = 3.141592653589793;
    let om_e2: Float = 1.0 - (eccentricity_e * eccentricity_e);
    let denom: Float = (c * c) * semi_major_axis_a * om_e2;
    if denom <= 0.000001 {
        return 0.0;
    }
    return (6.0 * pi * mu) / denom;
}

pub fn compute_gr_1pn_acceleration(
    config: RelativityConfig,
    rx: Float, ry: Float, rz: Float,
    vx: Float, vy: Float, vz: Float
) -> RelativisticAcceleration {
    let mu: Float = (config).central_mu;
    let c: Float = (config).speed_of_light_c;
    let c2: Float = c * c;

    let r_sq: Float = (rx * rx) + (ry * ry) + (rz * rz);
    let r: Float = sqrt(r_sq);
    let r3: Float = r_sq * r;

    let v_sq: Float = (vx * vx) + (vy * vy) + (vz * vz);
    let r_dot_v: Float = (rx * vx) + (ry * vy) + (rz * vz);

    // a_GR = (mu / (c^2 * r^3)) * [ (4*mu/r - v^2)*r_vec + 4*(r.v)*v_vec ]
    let factor: Float = mu / (c2 * r3 + 0.000001);
    let scalar_r: Float = ((4.0 * mu) / (r + 0.000001)) - v_sq;
    let scalar_v: Float = 4.0 * r_dot_v;

    let ax: Float = factor * ((scalar_r * rx) + (scalar_v * vx));
    let ay: Float = factor * ((scalar_r * ry) + (scalar_v * vy));
    let az: Float = factor * ((scalar_r * rz) + (scalar_v * vz));

    return RelativisticAcceleration {
        ax_gr: ax,
        ay_gr: ay,
        az_gr: az,
        schwarzschild_radius: (2.0 * mu) / c2
    };
}
