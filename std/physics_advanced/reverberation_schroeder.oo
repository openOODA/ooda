// # Schroeder Digital Audio Reverberator
//
// Logline: Synthesizes acoustic room impulse responses using parallel Feedback Comb Filters (FBCF) and series All-Pass Filters (APF).
//
// Setup: Computational acoustic room reverberation modeled by Sabine/Eyring RT60 reverberation decay times.
//
// Beats:
//   1. Define FeedbackCombFilter and AllPassFilter acoustic delay line stages.
//   2. Compute Sabine RT60 reverberation time RT60 = 0.161 * V / (S * alpha_avg).
//   3. Evaluate comb filter loop gains g = 10^(-3 * delay / (RT60 * f_sample)) for natural decay.

pub type RoomAcoustics = struct {
    room_volume_m3: Float,
    surface_area_m2: Float,
    avg_absorption_alpha: Float,
    rt60_seconds: Float
};

pub type CombFilterState = struct {
    delay_samples: Int,
    feedback_gain: Float,
    damp: Float
};

pub type AllPassState = struct {
    delay_samples: Int,
    gain_g: Float
};

// -------------------------------------------------------------------
// Helper Functions
// -------------------------------------------------------------------

pub fn schroeder_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

// -------------------------------------------------------------------
// Room Acoustic Geometry & Sabine RT60
// -------------------------------------------------------------------

pub fn room_acoustics_new(volume: Float, area: Float, alpha: Float) -> RoomAcoustics {
    let mut safe_alpha: Float = alpha;
    if safe_alpha <= 0.001 { safe_alpha = 0.001; }
    if safe_alpha > 0.99 { safe_alpha = 0.99; }

    // Sabine RT60 formula
    let rt60: Float = (0.161 * volume) / (area * safe_alpha);

    return RoomAcoustics {
        room_volume_m3: volume,
        surface_area_m2: area,
        avg_absorption_alpha: safe_alpha,
        rt60_seconds: rt60
    };
}

// -------------------------------------------------------------------
// Filter Parametrizations
// -------------------------------------------------------------------

pub fn compute_comb_feedback_gain(delay_samples: Int, rt60_sec: Float, sample_rate: Float) -> Float {
    if rt60_sec <= 0.01 {
        return 0.5;
    }
    let delay_f: Float = schroeder_int_to_float(delay_samples);
    let delay_sec: Float = delay_f / sample_rate;
    let exponent: Float = 0.0 - ((3.0 * delay_sec) / rt60_sec);
    return pow(10.0, exponent);
}

pub fn all_pass_filter_sample(input_x: Float, delay_buf_out: Float, g: Float) -> Float {
    return (0.0 - (g * input_x)) + delay_buf_out;
}
