// # Normal & Oblique Shock Wave Relations
//
// Logline: Computes Rankine-Hugoniot jump conditions, downstream Mach numbers, and theta-beta-M oblique shock angles.
//
// Setup: Discontinuous normal and oblique shock wave dynamics for supersonic flows (M > 1).
//
// Beats:
//   1. Compute normal shock downstream Mach M2, static pressure ratio P2/P1, and total pressure loss P02/P01.
//   2. Solve Rankine-Hugoniot density rho2/rho1 and temperature T2/T1 jumps across normal shocks.
//   3. Evaluate oblique shock wave relations for flow deflection angle theta and wave angle beta.

pub type NormalShockJump = struct {
    mach_downstream_m2: Float,
    pressure_ratio_p2_p1: Float,
    density_ratio_rho2_rho1: Float,
    temperature_ratio_t2_t1: Float,
    total_pressure_ratio_p02_p01: Float,
};

pub type ObliqueShockJump = struct {
    wave_angle_beta_rad: Float,
    deflection_angle_theta_rad: Float,
    mach_1n: Float,
    mach_2n: Float,
    mach_2_total: Float,
};

// -------------------------------------------------------------------
// Normal Shock Relations
// -------------------------------------------------------------------

pub fn normal_shock_solve(m1: Float, gamma: Float) -> NormalShockJump {
    if m1 <= 1.0 {
        return NormalShockJump {
            mach_downstream_m2: m1,
            pressure_ratio_p2_p1: 1.0,
            density_ratio_rho2_rho1: 1.0,
            temperature_ratio_t2_t1: 1.0,
            total_pressure_ratio_p02_p01: 1.0,
        };
    }

    let m1_sq: Float = m1 * m1;
    let gp1: Float = gamma + 1.0;
    let gm1: Float = gamma - 1.0;

    // Downstream Mach M2
    let m2_num: Float = (gm1 * m1_sq) + 2.0;
    let m2_den: Float = (2.0 * gamma * m1_sq) - gm1;
    let m2: Float = sqrt(m2_num / m2_den);

    // Static pressure ratio P2/P1
    let p2_p1: Float = 1.0 + (((2.0 * gamma) / gp1) * (m1_sq - 1.0));

    // Density ratio rho2/rho1
    let rho2_rho1: Float = (gp1 * m1_sq) / ((gm1 * m1_sq) + 2.0);

    // Temperature ratio T2/T1 = (P2/P1) / (rho2/rho1)
    let t2_t1: Float = p2_p1 / rho2_rho1;

    // Total pressure ratio P02/P01
    let term1: Float = (gp1 * m1_sq) / ((gm1 * m1_sq) + 2.0);
    let term2: Float = gp1 / ((2.0 * gamma * m1_sq) - gm1);
    let p02_p01: Float = pow(term1, gamma / gm1) * pow(term2, 1.0 / gm1);

    return NormalShockJump {
        mach_downstream_m2: m2,
        pressure_ratio_p2_p1: p2_p1,
        density_ratio_rho2_rho1: rho2_rho1,
        temperature_ratio_t2_t1: t2_t1,
        total_pressure_ratio_p02_p01: p02_p01,
    };
}

// -------------------------------------------------------------------
// Oblique Shock Relations (Theta-Beta-M)
// -------------------------------------------------------------------

pub fn oblique_shock_deflection_theta(
    m1: Float,
    beta_rad: Float,
    gamma: Float
) -> Float {
    let sin_b: Float = sin(beta_rad);
    let cos_b: Float = cos(beta_rad);
    let sin_b_sq: Float = sin_b * sin_b;
    let m1_sq: Float = m1 * m1;

    let num: Float = 2.0 * (cos_b / (sin_b + 0.00001)) * ((m1_sq * sin_b_sq) - 1.0);
    let den: Float = 2.0 + (m1_sq * (gamma + cos(2.0 * beta_rad)));
    if den <= 0.0001 {
        return 0.0;
    }
    let tan_th: Float = num / den;
    return tan_th; // approx theta for small/moderate deflections
}
