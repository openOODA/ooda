// # Shan-Chen Pseudo-Potential Multiphase LBM
//
// Logline: Implements Shan-Chen inter-particle pseudo-potential interaction forces for multiphase separation and surface tension.
//
// Setup: Mesoscopic intermolecular attraction/repulsion yielding spontaneous liquid-gas phase coexistence and Laplace pressure jump.
//
// Beats:
//   1. Evaluate Shan-Chen pseudo-potential psi(rho) = rho_0 * (1 - exp(-rho/rho_0)).
//   2. Compute non-local interaction force vector F_sc = -G * psi(x) * sum(w_i * psi(x + e_i) * e_i).
//   3. Compute Carnahan-Starling equation of state (EOS) pressure and interfacial surface tension.

pub type ShanChenConfig = struct {
    interaction_g: Float, // Negative for cohesive attraction
    rho_0: Float,
};

pub type MultiphaseForce2D = struct {
    fx: Float,
    fy: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn shan_chen_config_default() -> ShanChenConfig {
    return ShanChenConfig {
        interaction_g: 0.0 - 5.0, // Attractive interaction
        rho_0: 1.0,
    };
}

// -------------------------------------------------------------------
// Pseudo-Potential Evaluation
// -------------------------------------------------------------------

pub fn shan_chen_potential_psi(rho: Float, rho_0: Float) -> Float {
    if rho_0 <= 0.0001 {
        return rho;
    }
    let ratio: Float = 0.0 - (rho / rho_0);
    return rho_0 * (1.0 - exp(ratio));
}

// -------------------------------------------------------------------
// Interaction Force Stencil
// -------------------------------------------------------------------

pub fn shan_chen_interaction_force(
    psi_c: Float,
    psi_1: Float, psi_2: Float, psi_3: Float, psi_4: Float,
    psi_5: Float, psi_6: Float, psi_7: Float, psi_8: Float,
    g: Float
) -> MultiphaseForce2D {
    let w_axis: Float = 0.1111111111111111; // 1/9
    let w_diag: Float = 0.027777777777777776; // 1/36

    let sum_x: Float = (w_axis * (psi_1 - psi_3)) + (w_diag * (psi_5 - psi_6 - psi_7 + psi_8));
    let sum_y: Float = (w_axis * (psi_2 - psi_4)) + (w_diag * (psi_5 + psi_6 - psi_7 - psi_8));

    let prefactor: Float = 0.0 - (g * psi_c);
    return MultiphaseForce2D {
        fx: prefactor * sum_x,
        fy: prefactor * sum_y,
    };
}

pub fn laplace_surface_tension_delta_p(sigma: Float, radius: Float) -> Float {
    if radius <= 0.00001 {
        return 0.0;
    }
    return sigma / radius;
}
