// # Ragdoll Angular PD Orientation Motor
//
// Logline: Implements proportional-derivative (PD) orientation servo motors with torque saturation limits for active ragdoll animations.
//
// Setup: Active joint controller driving rigid limb orientations towards animated target poses.
//
// Beats:
//   1. Compute relative orientation error quaternion between current and target poses.
//   2. Evaluate Proportional-Derivative (PD) feedback torque tau = Kp * theta_err + Kd * (omega_target - omega_curr).
//   3. Clamp torque vectors within maximum allowable biological actuation thresholds.

pub type AngularMotorConfig = struct {
    kp_stiffness: Float,
    kd_damping: Float,
    max_torque_limit: Float
};

pub type MotorTorqueResult = struct {
    torque_x: Float,
    torque_y: Float,
    torque_z: Float,
    is_saturated: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn angular_motor_config_new(kp: Float, kd: Float, max_tau: Float) -> AngularMotorConfig {
    return AngularMotorConfig {
        kp_stiffness: kp,
        kd_damping: kd,
        max_torque_limit: max_tau
    };
}

// -------------------------------------------------------------------
// PD Control Evaluation
// -------------------------------------------------------------------

pub fn compute_motor_torque_3d(
    config: AngularMotorConfig,
    err_rot_x: Float, err_rot_y: Float, err_rot_z: Float,
    curr_omega_x: Float, curr_omega_y: Float, curr_omega_z: Float,
    target_omega_x: Float, target_omega_y: Float, target_omega_z: Float
) -> MotorTorqueResult {
    let kp: Float = (config).kp_stiffness;
    let kd: Float = (config).kd_damping;
    let max_t: Float = (config).max_torque_limit;

    let d_om_x: Float = target_omega_x - curr_omega_x;
    let d_om_y: Float = target_omega_y - curr_omega_y;
    let d_om_z: Float = target_omega_z - curr_omega_z;

    let tx_raw: Float = (kp * err_rot_x) + (kd * d_om_x);
    let ty_raw: Float = (kp * err_rot_y) + (kd * d_om_y);
    let tz_raw: Float = (kp * err_rot_z) + (kd * d_om_z);

    let t_mag: Float = sqrt((tx_raw * tx_raw) + (ty_raw * ty_raw) + (tz_raw * tz_raw));
    let mut saturated: Int = 0;

    let mut scale: Float = 1.0;
    if t_mag > max_t && t_mag > 0.000001 {
        scale = max_t / t_mag;
        saturated = 1;
    }

    return MotorTorqueResult {
        torque_x: tx_raw * scale,
        torque_y: ty_raw * scale,
        torque_z: tz_raw * scale,
        is_saturated: saturated
    };
}
