// # 1-DOF Prismatic Slider Joint
//
// Logline: Implements 1-DOF linear translational prismatic slider joint with transverse locking and stroke limit bumpers.
//
// Setup: Constrains relative rigid body motion to slide purely along a 1D linear rail axis.
//
// Beats:
//   1. Define SliderJoint with slide axis unit vector, stroke limits (min_limit, max_limit), and linear motor.
//   2. Eliminate 2 transverse linear DOFs and all 3 relative angular rotations.
//   3. Apply restitution bounce and clamping impulses at prismatic stroke limits.

pub type SliderJoint = struct {
    axis_x: Float,
    axis_y: Float,
    axis_z: Float,
    lower_limit: Float,
    upper_limit: Float,
    motor_target_speed: Float,
    max_motor_force: Float
};

pub type SliderState = struct {
    current_displacement: Float,
    is_at_lower_limit: Int,
    is_at_upper_limit: Int,
    corrective_impulse: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn slider_joint_new(
    ax: Float, ay: Float, az: Float,
    min_dist: Float, max_dist: Float
) -> SliderJoint {
    let len: Float = sqrt((ax * ax) + (ay * ay) + (az * az));
    let mut safe_len: Float = len;
    if safe_len <= 0.000001 {
        safe_len = 1.0;
    }
    return SliderJoint {
        axis_x: ax / safe_len,
        axis_y: ay / safe_len,
        axis_z: az / safe_len,
        lower_limit: min_dist,
        upper_limit: max_dist,
        motor_target_speed: 0.0,
        max_motor_force: 1000.0
    };
}

// -------------------------------------------------------------------
// Stroke Limits & Motor Step
// -------------------------------------------------------------------

pub fn slider_solve_limits(
    joint: SliderJoint,
    dx: Float, dy: Float, dz: Float
) -> SliderState {
    let ax: Float = (joint).axis_x;
    let ay: Float = (joint).axis_y;
    let az: Float = (joint).axis_z;

    let proj: Float = (dx * ax) + (dy * ay) + (dz * az);
    let min_lim: Float = (joint).lower_limit;
    let max_lim: Float = (joint).upper_limit;

    let mut at_low: Int = 0;
    let mut at_high: Int = 0;
    let mut impulse: Float = 0.0;

    if proj < min_lim {
        at_low = 1;
        impulse = min_lim - proj;
    }
    if proj > max_lim {
        at_high = 1;
        impulse = max_lim - proj;
    }

    return SliderState {
        current_displacement: proj,
        is_at_lower_limit: at_low,
        is_at_upper_limit: at_high,
        corrective_impulse: impulse
    };
}
