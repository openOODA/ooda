// # Hyperelastic Neo-Hookean Strain Energy & Stress
//
// Logline: Evaluates compressible and nearly-incompressible Neo-Hookean strain energy densities and First Piola-Kirchhoff (PK1) stresses.
//
// Setup: Non-linear hyperelasticity for rubber-like soft tissue and large biomechanical strains.
//
// Beats:
//   1. Compute Right Cauchy-Green deformation tensor C = F^T * F and principal invariants I1, I2, I3 = J^2.
//   2. Evaluate Neo-Hookean strain energy density Psi = (mu/2)*(I1_bar - 3) + (K/2)*(J - 1)^2.
//   3. Compute First Piola-Kirchhoff stress tensor P = mu * (F - F^-T) + K * ln(J) * F^-T.

pub type NeoHookeanMaterial = struct {
    shear_modulus_mu: Float,
    bulk_modulus_k: Float,
};

pub type HyperelasticEnergy = struct {
    isochoric_energy: Float,
    volumetric_energy: Float,
    total_strain_energy: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn neo_hookean_material_new(shear_mu: Float, bulk_k: Float) -> NeoHookeanMaterial {
    return NeoHookeanMaterial {
        shear_modulus_mu: shear_mu,
        bulk_modulus_k: bulk_k,
    };
}

// -------------------------------------------------------------------
// Strain Invariants & Energy Density
// -------------------------------------------------------------------

pub fn neo_hookean_energy(
    i1_trace: Float,
    j_volume_ratio: Float,
    mat: NeoHookeanMaterial
) -> HyperelasticEnergy {
    let mu: Float = (mat).shear_modulus_mu;
    let k: Float = (mat).bulk_modulus_k;

    let mut safe_j: Float = j_volume_ratio;
    if safe_j <= 0.0001 {
        safe_j = 0.0001;
    }

    // Isochoric invariant I1_bar = J^(-2/3) * I1
    let j_pow: Float = pow(safe_j, 0.0 - 0.6666666666666666);
    let i1_bar: Float = j_pow * i1_trace;

    let psi_iso: Float = 0.5 * mu * (i1_bar - 3.0);
    let psi_vol: Float = 0.5 * k * (safe_j - 1.0) * (safe_j - 1.0);

    return HyperelasticEnergy {
        isochoric_energy: psi_iso,
        volumetric_energy: psi_vol,
        total_strain_energy: psi_iso + psi_vol,
    };
}

pub fn hydrostatic_pressure(j_volume_ratio: Float, bulk_k: Float) -> Float {
    if j_volume_ratio <= 0.0001 {
        return 0.0;
    }
    return bulk_k * ln(j_volume_ratio) / j_volume_ratio;
}
