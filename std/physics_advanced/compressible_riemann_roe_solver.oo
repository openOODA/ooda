// # Roe Approximate Riemann Solver for 1D Euler Equations
//
// Logline: Computes Roe-averaged intermediate states, wave speeds, and upwind numerical flux vectors for compressible gas dynamics.
//
// Setup: High-resolution Godunov-type finite volume shock capturing for 1D Euler equations.
//
// Beats:
//   1. Define Euler conservative variables U = [rho, rho*u, E] and primitive variables [rho, u, p].
//   2. Compute Roe-averaged density, velocity, and enthalpy between left and right cell interfaces.
//   3. Evaluate characteristic wave speeds and Roe numerical flux vector F_roe = 0.5*(F_L + F_R - sum(|lambda_k| * alpha_k * K_k)).

pub type EulerState1D = struct {
    rho: Float,
    u: Float,
    p: Float,
    energy_e: Float,
};

pub type RoeAverages1D = struct {
    rho_roe: Float,
    u_roe: Float,
    h_roe: Float,
    a_roe: Float,
};

pub type FluxVector1D = struct {
    flux_mass: Float,
    flux_momentum: Float,
    flux_energy: Float,
};

// -------------------------------------------------------------------
// Primitive to Conservative Conversion
// -------------------------------------------------------------------

pub fn euler_state_new(rho: Float, u: Float, p: Float, gamma: Float) -> EulerState1D {
    let total_e: Float = (p / (gamma - 1.0)) + (0.5 * rho * u * u);
    return EulerState1D {
        rho: rho,
        u: u,
        p: p,
        energy_e: total_e,
    };
}

// -------------------------------------------------------------------
// Roe Average Evaluation
// -------------------------------------------------------------------

pub fn compute_roe_averages(left: EulerState1D, right: EulerState1D, gamma: Float) -> RoeAverages1D {
    let sqrt_rho_l: Float = sqrt((left).rho);
    let sqrt_rho_r: Float = sqrt((right).rho);
    let denom: Float = sqrt_rho_l + sqrt_rho_r;

    let u_roe: Float = ((sqrt_rho_l * (left).u) + (sqrt_rho_r * (right).u)) / denom;

    let h_l: Float = ((left).energy_e + (left).p) / (left).rho;
    let h_r: Float = ((right).energy_e + (right).p) / (right).rho;
    let h_roe: Float = ((sqrt_rho_l * h_l) + (sqrt_rho_r * h_r)) / denom;

    let gm1: Float = gamma - 1.0;
    let sound_sq: Float = gm1 * (h_roe - (0.5 * u_roe * u_roe));
    let mut safe_sound_sq: Float = sound_sq;
    if safe_sound_sq <= 0.0001 {
        safe_sound_sq = 0.0001;
    }
    let a_roe: Float = sqrt(safe_sound_sq);

    return RoeAverages1D {
        rho_roe: sqrt_rho_l * sqrt_rho_r,
        u_roe: u_roe,
        h_roe: h_roe,
        a_roe: a_roe,
    };
}

// -------------------------------------------------------------------
// Physical Interface Flux
// -------------------------------------------------------------------

pub fn physical_euler_flux(state: EulerState1D) -> FluxVector1D {
    let rho: Float = (state).rho;
    let u: Float = (state).u;
    let p: Float = (state).p;
    let e: Float = (state).energy_e;

    return FluxVector1D {
        flux_mass: rho * u,
        flux_momentum: (rho * u * u) + p,
        flux_energy: (e + p) * u,
    };
}
