// # Barnes-Hut Hierarchical N-Body Gravitational Tree
//
// Logline: Approximates all-pairs N-body gravitational interactions in O(N log N) using octree spatial decomposition and multipole acceptance.
//
// Setup: Hierarchical spatial partitioning evaluating long-range gravitational cluster forces via center-of-mass multipoles.
//
// Beats:
//   1. Define Barnes-Hut OctreeNode (center of mass cx, cy, cz, total mass, box width).
//   2. Evaluate Barnes-Hut multipole acceptance criterion (MAC) condition s / d < theta.
//   3. Compute gravitational attraction acceleration with Plummer / softening radius epsilon.

pub type OctreeNode = struct {
    center_of_mass_x: Float,
    center_of_mass_y: Float,
    center_of_mass_z: Float,
    total_mass: Float,
    box_size_s: Float
};

pub type GravitationalAcceleration = struct {
    ax: Float,
    ay: Float,
    az: Float,
    is_approximate_node: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn octree_node_new(
    cx: Float, cy: Float, cz: Float,
    mass: Float,
    size: Float
) -> OctreeNode {
    return OctreeNode {
        center_of_mass_x: cx,
        center_of_mass_y: cy,
        center_of_mass_z: cz,
        total_mass: mass,
        box_size_s: size
    };
}

// -------------------------------------------------------------------
// Barnes-Hut Multipole Criterion & Gravity
// -------------------------------------------------------------------

pub fn barnes_hut_evaluate_node(
    body_x: Float, body_y: Float, body_z: Float,
    node: OctreeNode,
    theta_threshold: Float,
    grav_g: Float,
    softening_eps: Float
) -> GravitationalAcceleration {
    let dx: Float = (node).center_of_mass_x - body_x;
    let dy: Float = (node).center_of_mass_y - body_y;
    let dz: Float = (node).center_of_mass_z - body_z;

    let dist_sq: Float = (dx * dx) + (dy * dy) + (dz * dz);
    let dist: Float = sqrt(dist_sq);

    let s: Float = (node).box_size_s;
    let mac_ratio: Float = s / (dist + 0.00001);

    let mut is_approx: Int = 0;
    if mac_ratio < theta_threshold {
        is_approx = 1;
    }

    // Softened Newtonian gravity: a = G * M / (r^2 + eps^2)^(3/2) * d_vec
    let eps2: Float = softening_eps * softening_eps;
    let denom: Float = pow(dist_sq + eps2, 1.5);
    let prefactor: Float = (grav_g * (node).total_mass) / (denom + 0.000001);

    return GravitationalAcceleration {
        ax: prefactor * dx,
        ay: prefactor * dy,
        az: prefactor * dz,
        is_approximate_node: is_approx
    };
}
