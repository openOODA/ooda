// # D2Q9 Lattice Boltzmann Velocity & Weight Set
//
// Logline: Defines discrete 2D 9-velocity (D2Q9) lattice vectors, equilibrium lattice weights, and macroscopic moment evaluations.
//
// Setup: Standard 9-directional square lattice with speed of sound c_s^2 = 1/3 for mesoscopic fluid dynamics.
//
// Beats:
//   1. Define D2Q9 lattice weights (w0=4/9, w1..4=1/9, w5..8=1/36) and discrete directional vectors.
//   2. Compute zero-th (density rho) and first-order (momentum rho*u, rho*v) distribution moments.
//   3. Evaluate Maxwell-Boltzmann equilibrium distribution function f_eq_i(rho, u, v).

pub type D2Q9Moments = struct {
    density_rho: Float,
    velocity_u: Float,
    velocity_v: Float,
};

pub type D2Q9Distributions = struct {
    f0: Float,
    f1: Float,
    f2: Float,
    f3: Float,
    f4: Float,
    f5: Float,
    f6: Float,
    f7: Float,
    f8: Float,
};

// -------------------------------------------------------------------
// Discrete Weights & Lattice Constants
// -------------------------------------------------------------------

pub fn d2q9_weight(index: Int) -> Float {
    if index == 0 {
        return 0.4444444444444444; // 4/9
    }
    if index >= 1 && index <= 4 {
        return 0.1111111111111111; // 1/9
    }
    if index >= 5 && index <= 8 {
        return 0.027777777777777776; // 1/36
    }
    return 0.0;
}

pub fn d2q9_speed_of_sound_sq() -> Float {
    return 0.3333333333333333; // c_s^2 = 1/3
}

// -------------------------------------------------------------------
// Macroscopic Moment Reductions
// -------------------------------------------------------------------

pub fn d2q9_compute_moments(f: D2Q9Distributions) -> D2Q9Moments {
    let f0: Float = (f).f0;
    let f1: Float = (f).f1;
    let f2: Float = (f).f2;
    let f3: Float = (f).f3;
    let f4: Float = (f).f4;
    let f5: Float = (f).f5;
    let f6: Float = (f).f6;
    let f7: Float = (f).f7;
    let f8: Float = (f).f8;

    let rho: Float = f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8;
    let mut safe_rho: Float = rho;
    if safe_rho <= 0.000001 {
        safe_rho = 1.0;
    }

    let jx: Float = (f1 - f3) + (f5 - f6 - f7 + f8);
    let jy: Float = (f2 - f4) + (f5 + f6 - f7 - f8);

    return D2Q9Moments {
        density_rho: rho,
        velocity_u: jx / safe_rho,
        velocity_v: jy / safe_rho,
    };
}

// -------------------------------------------------------------------
// Equilibrium Distribution Function (f_eq)
// -------------------------------------------------------------------

pub fn d2q9_feq_component(
    index: Int,
    rho: Float,
    u: Float,
    v: Float
) -> Float {
    let w: Float = d2q9_weight(index);
    let u_sq: Float = (u * u) + (v * v);

    let mut cx: Float = 0.0;
    let mut cy: Float = 0.0;

    if index == 1 { cx = 1.0; cy = 0.0; }
    if index == 2 { cx = 0.0; cy = 1.0; }
    if index == 3 { cx = 0.0 - 1.0; cy = 0.0; }
    if index == 4 { cx = 0.0; cy = 0.0 - 1.0; }
    if index == 5 { cx = 1.0; cy = 1.0; }
    if index == 6 { cx = 0.0 - 1.0; cy = 1.0; }
    if index == 7 { cx = 0.0 - 1.0; cy = 0.0 - 1.0; }
    if index == 8 { cx = 1.0; cy = 0.0 - 1.0; }

    let c_dot_u: Float = (cx * u) + (cy * v);
    let term: Float = 1.0 + (3.0 * c_dot_u) + (4.5 * c_dot_u * c_dot_u) - (1.5 * u_sq);
    return w * rho * term;
}
