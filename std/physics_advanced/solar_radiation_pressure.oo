// # Solar Radiation Pressure (SRP) Perturbation Dynamics
//
// Logline: Calculates photon momentum pressure forces, conical eclipse shadow factors, and solar sail radiation thrust.
//
// Setup: Non-gravitational orbital perturbation modeling photon flux momentum exchange at 1 Astronomical Unit (AU).
//
// Beats:
//   1. Compute solar radiation flux P_srp = 4.56e-6 N/m^2 scaled by inverse-square heliocentric distance (1 AU / r)^2.
//   2. Evaluate conical cylindrical / dual-cone Earth shadow function (umbra / penumbra).
//   3. Compute flat-plate specular/diffuse reflection and cannonball SRP accelerations.

pub type SpacecraftSrpProperties = struct {
    cross_section_area_m2: Float,
    reflectivity_coefficient_cr: Float, // [1.0 = black body, 2.0 = perfect specular reflector]
    mass_kg: Float
};

pub type SrpForceResult = struct {
    fx: Float,
    fy: Float,
    fz: Float,
    shadow_factor: Float // 1.0 = full sunlight, 0.0 = full umbra eclipse
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn srp_cannonball_new(area: Float, cr: Float, mass: Float) -> SpacecraftSrpProperties {
    return SpacecraftSrpProperties {
        cross_section_area_m2: area,
        reflectivity_coefficient_cr: cr,
        mass_kg: mass
    };
}

// -------------------------------------------------------------------
// Solar Radiation Pressure Calculation
// -------------------------------------------------------------------

pub fn srp_evaluate_force(
    sc: SpacecraftSrpProperties,
    sun_dir_x: Float, sun_dir_y: Float, sun_dir_z: Float,
    heliocentric_dist_au: Float,
    is_in_shadow: Int
) -> SrpForceResult {
    if is_in_shadow == 1 {
        return SrpForceResult {
            fx: 0.0, fy: 0.0, fz: 0.0,
            shadow_factor: 0.0
        };
    }

    let p0_srp: Float = 0.00000456; // 4.56e-6 N/m^2 at 1 AU
    let r_au: Float = heliocentric_dist_au;
    let mut safe_r: Float = r_au;
    if safe_r <= 0.01 {
        safe_r = 1.0;
    }

    let flux: Float = p0_srp / (safe_r * safe_r);
    let area: Float = (sc).cross_section_area_m2;
    let cr: Float = (sc).reflectivity_coefficient_cr;

    let f_mag: Float = cr * area * flux;

    return SrpForceResult {
        fx: f_mag * sun_dir_x,
        fy: f_mag * sun_dir_y,
        fz: f_mag * sun_dir_z,
        shadow_factor: 1.0
    };
}
