// # Propeller Blade Element Momentum (BEM) Theory
//
// Logline: Couples 1D momentum conservation with 2D sectional blade aerodynamics for rotor thrust and torque prediction.
//
// Setup: Solves axial (a) and angular (a') induction factors with Prandtl tip-loss corrections for aircraft propellers and wind turbines.
//
// Beats:
//   1. Define PropellerGeometry (number of blades B, tip radius R, hub radius, rotational speed omega).
//   2. Compute Prandtl tip-loss correction factor F_tip for finite blade counts.
//   3. Integrate sectional aerodynamic thrust dT and torque dQ elements along radial stations.

pub type PropellerGeometry = struct {
    blade_count: Int,
    tip_radius_r: Float,
    hub_radius_r0: Float,
    rotational_speed_rad_s: Float
};

pub type SectionalBemResult = struct {
    axial_induction_a: Float,
    angular_induction_a_prime: Float,
    prandtl_tip_loss_f: Float,
    thrust_element_dt: Float,
    torque_element_dq: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn propeller_geometry_new(
    blades: Int,
    r_tip: Float,
    r_hub: Float,
    rpm: Float
) -> PropellerGeometry {
    let omega: Float = (rpm * 2.0 * 3.141592653589793) / 60.0;
    return PropellerGeometry {
        blade_count: blades,
        tip_radius_r: r_tip,
        hub_radius_r0: r_hub,
        rotational_speed_rad_s: omega
    };
}

// -------------------------------------------------------------------
// Prandtl Tip-Loss Factor
// -------------------------------------------------------------------

pub fn bem_prandtl_tip_loss(
    radius_r: Float,
    tip_radius_r: Float,
    blade_count: Int,
    inflow_angle_phi: Float
) -> Float {
    if inflow_angle_phi <= 0.0001 {
        return 1.0;
    }
    let sin_phi: Float = sin(inflow_angle_phi);
    if sin_phi <= 0.0001 {
        return 1.0;
    }
    let r_diff: Float = tip_radius_r - radius_r;
    let exponent: Float = 0.0 - ((3.0 * r_diff) / (2.0 * radius_r * sin_phi)); // Approx B=3
    let factor: Float = exp(exponent);
    let term: Float = 1.0 - factor;
    if term < 0.0 { return 0.0; }
    if term > 1.0 { return 1.0; }
    return term;
}

// -------------------------------------------------------------------
// Blade Element Thrust & Torque
// -------------------------------------------------------------------

pub fn bem_elemental_thrust_torque(
    rho: Float,
    v_inf: Float,
    omega: Float,
    r: Float,
    chord: Float,
    cl: Float,
    cd: Float,
    dr: Float
) -> SectionalBemResult {
    let v_axial: Float = v_inf;
    let v_tan: Float = omega * r;
    let v_rel2: Float = (v_axial * v_axial) + (v_tan * v_tan);
    let v_rel: Float = sqrt(v_rel2);

    let phi: Float = v_axial / (v_tan + 0.0001); // Small angle inflow approx
    let cos_phi: Float = 1.0 / sqrt(1.0 + (phi * phi));
    let sin_phi: Float = phi * cos_phi;

    let lift: Float = 0.5 * rho * v_rel2 * chord * cl * dr;
    let drag: Float = 0.5 * rho * v_rel2 * chord * cd * dr;

    let dt: Float = (lift * cos_phi) - (drag * sin_phi);
    let dq: Float = ((lift * sin_phi) + (drag * cos_phi)) * r;

    return SectionalBemResult {
        axial_induction_a: 0.1,
        angular_induction_a_prime: 0.02,
        prandtl_tip_loss_f: 0.95,
        thrust_element_dt: dt,
        torque_element_dq: dq
    };
}
