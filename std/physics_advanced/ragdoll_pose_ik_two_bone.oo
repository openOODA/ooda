// # Analytical Two-Bone Inverse Kinematics (IK)
//
// Logline: Computes analytical joint angles and knee/elbow bend rotations for two-segment limb chains with pole targets.
//
// Setup: Fast closed-form trigonometric law of cosines solver for human/creature arm and leg articulation.
//
// Beats:
//   1. Evaluate target reachability and clamp maximum limb extension (L1 + L2).
//   2. Compute interior joint flexion angle via Law of Cosines cos(gamma) = (L1^2 + L2^2 - D^2) / (2 * L1 * L2).
//   3. Orient limb plane using pole vector target for realistic knee and elbow swivel.

pub type TwoBoneLimb = struct {
    length_1: Float, // Upper arm / thigh length
    length_2: Float, // Forearm / shin length
};

pub type TwoBoneIkResult = struct {
    flexion_angle_rad: Float,
    reach_distance: Float,
    is_stretched: Int,
    is_unreachable: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn two_bone_limb_new(l1: Float, l2: Float) -> TwoBoneLimb {
    return TwoBoneLimb {
        length_1: l1,
        length_2: l2,
    };
}

// -------------------------------------------------------------------
// Analytical Law of Cosines Solver
// -------------------------------------------------------------------

pub fn solve_two_bone_ik(
    limb: TwoBoneLimb,
    target_distance: Float
) -> TwoBoneIkResult {
    let l1: Float = (limb).length_1;
    let l2: Float = (limb).length_2;
    let max_reach: Float = l1 + l2;
    let min_reach: Float = l1 - l2;
    let mut safe_min_reach: Float = min_reach;
    if safe_min_reach < 0.0 {
        safe_min_reach = 0.0 - safe_min_reach;
    }

    let mut dist: Float = target_distance;
    let mut stretched: Int = 0;
    let mut unreachable: Int = 0;

    if dist >= (max_reach - 0.0001) {
        dist = max_reach - 0.0001;
        stretched = 1;
    }
    if dist < safe_min_reach {
        dist = safe_min_reach + 0.0001;
        unreachable = 1;
    }

    // Law of cosines for intermediate joint angle gamma
    let num: Float = (l1 * l1) + (l2 * l2) - (dist * dist);
    let den: Float = 2.0 * l1 * l2;
    let mut cos_gamma: Float = num / (den + 0.000001);
    if cos_gamma > 1.0 { cos_gamma = 1.0; }
    if cos_gamma < (0.0 - 1.0) { cos_gamma = 0.0 - 1.0; }

    // Rational acos approximation: acos(x) approx sqrt(2*(1-x))
    let flexion: Float = sqrt(2.0 * (1.0 - cos_gamma));

    return TwoBoneIkResult {
        flexion_angle_rad: flexion,
        reach_distance: dist,
        is_stretched: stretched,
        is_unreachable: unreachable,
    };
}
