// # Lattice Boltzmann Boundary Conditions
//
// Logline: Implements half-way bounce-back solid wall reflections and Zou-He velocity and pressure boundary conditions.
//
// Setup: Boundary rules for unknown incoming D2Q9 populations at solid obstacles and fluid domain borders.
//
// Beats:
//   1. Reflect populations via simple and half-way bounce-back for stationary/moving walls.
//   2. Solve Zou-He inlet velocity boundary conditions for unknown east/north face distributions.
//   3. Solve Zou-He outlet constant pressure boundary conditions.

pub type ZouHeInletResult = struct {
    f1: Float,
    f5: Float,
    f8: Float,
    rho_inlet: Float
};

pub type ZouHeOutletResult = struct {
    f3: Float,
    f6: Float,
    f7: Float,
    u_outlet: Float
};

// -------------------------------------------------------------------
// Bounce-Back Reflections
// -------------------------------------------------------------------

pub fn lbm_bounce_back_opposite(index: Int) -> Int {
    if index == 1 { return 3; }
    if index == 2 { return 4; }
    if index == 3 { return 1; }
    if index == 4 { return 2; }
    if index == 5 { return 7; }
    if index == 6 { return 8; }
    if index == 7 { return 5; }
    if index == 8 { return 6; }
    return 0;
}

pub fn lbm_moving_wall_bounce_back(
    index: Int,
    f_opp: Float,
    weight: Float,
    rho: Float,
    wall_u: Float,
    wall_v: Float
) -> Float {
    let mut cx: Float = 0.0;
    let mut cy: Float = 0.0;
    if index == 1 { cx = 1.0; cy = 0.0; }
    if index == 2 { cx = 0.0; cy = 1.0; }
    if index == 3 { cx = 0.0 - 1.0; cy = 0.0; }
    if index == 4 { cx = 0.0; cy = 0.0 - 1.0; }
    if index == 5 { cx = 1.0; cy = 1.0; }
    if index == 6 { cx = 0.0 - 1.0; cy = 1.0; }
    if index == 7 { cx = 0.0 - 1.0; cy = 0.0 - 1.0; }
    if index == 8 { cx = 1.0; cy = 0.0 - 1.0; }

    let c_dot_uw: Float = (cx * wall_u) + (cy * wall_v);
    return f_opp - (2.0 * weight * rho * 3.0 * c_dot_uw);
}

// -------------------------------------------------------------------
// Zou-He West Velocity Inflow Boundary
// -------------------------------------------------------------------

pub fn zou_he_west_inflow(
    u_target: Float,
    v_target: Float,
    f0: Float,
    f2: Float,
    f3: Float,
    f4: Float,
    f6: Float,
    f7: Float
) -> ZouHeInletResult {
    let denom: Float = 1.0 - u_target;
    let rho_w: Float = (f0 + f2 + f4 + (2.0 * (f3 + f6 + f7))) / denom;

    let f1_new: Float = f3 + ((0.6666666666666666) * rho_w * u_target);
    let f5_new: Float = f7 - (0.5 * (f2 - f4)) + (0.16666666666666666 * rho_w * u_target) + (0.5 * rho_w * v_target);
    let f8_new: Float = f6 + (0.5 * (f2 - f4)) + (0.16666666666666666 * rho_w * u_target) - (0.5 * rho_w * v_target);

    return ZouHeInletResult {
        f1: f1_new,
        f5: f5_new,
        f8: f8_new,
        rho_inlet: rho_w
    };
}
