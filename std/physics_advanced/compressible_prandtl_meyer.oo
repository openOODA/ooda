// # Prandtl-Meyer Supersonic Expansion Fan Function
//
// Logline: Evaluates the Prandtl-Meyer angle nu(M) and downstream Mach number for supersonic corner expansion flows.
//
// Setup: Isentropic supersonic expansion turning around convex sharp corners.
//
// Beats:
//   1. Compute Prandtl-Meyer function nu(M) = sqrt((gamma+1)/(gamma-1)) * atan(...) - atan(...).
//   2. Calculate maximum theoretical turning angle nu_max for infinite Mach expansion.
//   3. Invert the Prandtl-Meyer relation to find downstream Mach M2 from turning angle theta = nu(M2) - nu(M1).

pub type ExpansionFanResult = struct {
    mach_downstream_m2: Float,
    nu_1_rad: Float,
    nu_2_rad: Float,
    expansion_angle_theta_rad: Float
};

// -------------------------------------------------------------------
// Prandtl-Meyer Function nu(M)
// -------------------------------------------------------------------

pub fn prandtl_meyer_nu(mach: Float, gamma: Float) -> Float {
    if mach <= 1.0 {
        return 0.0;
    }
    let gp1: Float = gamma + 1.0;
    let gm1: Float = gamma - 1.0;
    let prefactor: Float = sqrt(gp1 / gm1);

    let m_sq_minus_1: Float = (mach * mach) - 1.0;
    let sqrt_term: Float = sqrt(m_sq_minus_1);

    // nu(M) = prefactor * atan(sqrt((gm1/gp1)*(M^2 - 1))) - atan(sqrt(M^2 - 1))
    let arg1: Float = sqrt((gm1 / gp1) * m_sq_minus_1);
    let atan1: Float = arg1 / (1.0 + (0.28 * arg1 * arg1)); // Accurate rational atan approx
    let atan2: Float = sqrt_term / (1.0 + (0.28 * sqrt_term * sqrt_term));

    return (prefactor * atan1) - atan2;
}

pub fn prandtl_meyer_max_angle(gamma: Float) -> Float {
    let gp1: Float = gamma + 1.0;
    let gm1: Float = gamma - 1.0;
    let prefactor: Float = sqrt(gp1 / gm1);
    let half_pi: Float = 1.5707963267948966;
    return (prefactor - 1.0) * half_pi;
}

// -------------------------------------------------------------------
// Inversion: Solve M2 from M1 and Expansion Angle Theta
// -------------------------------------------------------------------

pub fn prandtl_meyer_expand_step(
    m1: Float,
    theta_turn_rad: Float,
    gamma: Float
) -> ExpansionFanResult {
    let nu1: Float = prandtl_meyer_nu(m1, gamma);
    let nu2_target: Float = nu1 + theta_turn_rad;

    // Newton / bisection search for M2 such that nu(M2) = nu2_target
    let mut m_low: Float = m1;
    let mut m_high: Float = m1 + 4.0;
    let mut m_mid: Float = 0.5 * (m_low + m_high);

    let mut iter: Int = 0;
    while iter < 12 {
        m_mid = 0.5 * (m_low + m_high);
        let nu_curr: Float = prandtl_meyer_nu(m_mid, gamma);
        if nu_curr < nu2_target {
            m_low = m_mid;
        } else {
            m_high = m_mid;
        }
        iter = iter + 1;
    }

    return ExpansionFanResult {
        mach_downstream_m2: m_mid,
        nu_1_rad: nu1,
        nu_2_rad: nu2_target,
        expansion_angle_theta_rad: theta_turn_rad
    };
}
