// # Prandtl Classical Lifting-Line Theory for 3D Wings
//
// Logline: Calculates finite wing spanwise circulation distribution, downwash angles, and induced drag coefficients.
//
// Setup: Models finite span aerodynamic vortex shedding and 3D aspect ratio performance penalties.
//
// Beats:
//   1. Define Wing3DGeometry (wingspan b, planform area S, aspect ratio AR, taper ratio lambda).
//   2. Compute downwash angle w_i(y) and effective angle of attack alpha_eff = alpha_geom - alpha_induced.
//   3. Compute Oswald span efficiency factor e and induced drag coefficient Cdi = Cl^2 / (pi * AR * e).

pub type Wing3DGeometry = struct {
    wingspan_b: Float,
    planform_area_s: Float,
    aspect_ratio_ar: Float,
    taper_ratio: Float,
    oswald_efficiency_e: Float,
};

pub type WingAerodynamicPerformance = struct {
    total_lift_cl: Float,
    induced_drag_cdi: Float,
    induced_angle_rad: Float,
    effective_alpha_rad: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn wing_3d_geometry_new(
    span: Float,
    area: Float,
    taper: Float,
    oswald_e: Float
) -> Wing3DGeometry {
    let mut safe_area: Float = area;
    if safe_area <= 0.0001 {
        safe_area = 1.0;
    }
    let ar: Float = (span * span) / safe_area;
    return Wing3DGeometry {
        wingspan_b: span,
        planform_area_s: safe_area,
        aspect_ratio_ar: ar,
        taper_ratio: taper,
        oswald_efficiency_e: oswald_e,
    };
}

pub fn wing_3d_rectangular(span: Float, chord: Float) -> Wing3DGeometry {
    let area: Float = span * chord;
    return wing_3d_geometry_new(span, area, 1.0, 0.85);
}

pub fn wing_3d_elliptic(span: Float, area: Float) -> Wing3DGeometry {
    return wing_3d_geometry_new(span, area, 1.0, 1.0); // Perfect elliptic e = 1.0
}

// -------------------------------------------------------------------
// Lifting Line Performance
// -------------------------------------------------------------------

pub fn finite_wing_induced_drag_cdi(
    cl: Float,
    aspect_ratio: Float,
    oswald_e: Float
) -> Float {
    let pi: Float = 3.141592653589793;
    let denom: Float = pi * aspect_ratio * oswald_e;
    if denom <= 0.0001 {
        return 0.0;
    }
    return (cl * cl) / denom;
}

pub fn finite_wing_induced_angle(
    cl: Float,
    aspect_ratio: Float,
    oswald_e: Float
) -> Float {
    let pi: Float = 3.141592653589793;
    let denom: Float = pi * aspect_ratio * oswald_e;
    if denom <= 0.0001 {
        return 0.0;
    }
    return cl / denom;
}

pub fn finite_wing_evaluate(
    geom: Wing3DGeometry,
    cl_2d: Float,
    alpha_geom_rad: Float
) -> WingAerodynamicPerformance {
    let ar: Float = (geom).aspect_ratio_ar;
    let e: Float = (geom).oswald_efficiency_e;

    let a_ind: Float = finite_wing_induced_angle(cl_2d, ar, e);
    let cdi: Float = finite_wing_induced_drag_cdi(cl_2d, ar, e);
    let a_eff: Float = alpha_geom_rad - a_ind;

    return WingAerodynamicPerformance {
        total_lift_cl: cl_2d,
        induced_drag_cdi: cdi,
        induced_angle_rad: a_ind,
        effective_alpha_rad: a_eff,
    };
}
