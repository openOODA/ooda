// # Spike-Timing-Dependent Plasticity (STDP) Learning
//
// Logline: Adjusts synaptic weights based on millisecond-level spike timing differences between pre- and post-synaptic neurons.
//
// Setup: Biologically validated Hebbian learning rule modeling long-term potentiation (LTP) and long-term depression (LTD).
//
// Beats:
//   1. Define STDPParams (a_plus, a_minus, tau_plus, tau_minus, w_min, w_max).
//   2. Compute weight modification delta_w from inter-spike interval delta_t = t_post - t_pre.
//   3. Apply soft or hard boundary bounds to preserve stability in recurrent neural circuits.

pub type STDPParams = struct {
    a_plus: Float,     // Maximum potentiation amplitude (default 0.01)
    a_minus: Float,    // Maximum depression amplitude (default 0.0105)
    tau_plus: Float,   // Potentiation time constant (ms, default 20.0)
    tau_minus: Float,  // Depression time constant (ms, default 20.0)
    w_min: Float,      // Minimum synaptic weight (default 0.0)
    w_max: Float      // Maximum synaptic weight (default 1.0)
};

pub type SynapseSTDP = struct {
    weight: Float,
    last_pre_spike_ms: Float,
    last_post_spike_ms: Float
};

pub fn stdp_params_default() -> STDPParams {
    return STDPParams {
        a_plus: 0.01,
        a_minus: 0.0105,
        tau_plus: 20.0,
        tau_minus: 20.0,
        w_min: 0.0,
        w_max: 1.0
    };
}

pub fn stdp_compute_delta_w(delta_t_ms: Float, params: &STDPParams) -> Float {
    // delta_t = t_post - t_pre
    if delta_t_ms > 0.0 {
        // Pre-before-post: LTP potentiation
        return (params).a_plus * exp((0.0 - delta_t_ms) / (params).tau_plus);
    } else if delta_t_ms < 0.0 {
        // Post-before-pre: LTD depression
        return 0.0 - ((params).a_minus * exp(delta_t_ms / (params).tau_minus));
    }
    return 0.0;
}

pub fn stdp_update_on_pre_spike(syn: &SynapseSTDP, t_current_ms: Float, params: &STDPParams) -> SynapseSTDP {
    let mut w = (syn).weight;
    if (syn).last_post_spike_ms >= 0.0 {
        let dt = (syn).last_post_spike_ms - t_current_ms; // negative: post happened before this pre
        let dw = stdp_compute_delta_w(dt, params);
        w = w + dw;
        if w < (params).w_min { w = (params).w_min; }
        if w > (params).w_max { w = (params).w_max; }
    }
    return SynapseSTDP {
        weight: w,
        last_pre_spike_ms: t_current_ms,
        last_post_spike_ms: (syn).last_post_spike_ms
    };
}

pub fn stdp_update_on_post_spike(syn: &SynapseSTDP, t_current_ms: Float, params: &STDPParams) -> SynapseSTDP {
    let mut w = (syn).weight;
    if (syn).last_pre_spike_ms >= 0.0 {
        let dt = t_current_ms - (syn).last_pre_spike_ms; // positive: pre happened before this post
        let dw = stdp_compute_delta_w(dt, params);
        w = w + dw;
        if w < (params).w_min { w = (params).w_min; }
        if w > (params).w_max { w = (params).w_max; }
    }
    return SynapseSTDP {
        weight: w,
        last_pre_spike_ms: (syn).last_pre_spike_ms,
        last_post_spike_ms: t_current_ms
    };
}
