// # Adaptive Exponential Integrate-and-Fire (AdEx) Neuron
//
// Logline: Simulates Brette-Gerstner AdEx dynamics with exponential spike initiation and spike-frequency adaptation.
//
// Setup: Two-variable biophysical integrate-and-fire model matching cortical pyramidal cell electrophysiology.
//
// Beats:
//   1. Define AdExParams (c_m, g_l, e_l, delta_t, v_t, v_reset, v_peak, a, b, tau_w).
//   2. Compute exponential spike initiation current and subthreshold adaptation current w.
//   3. Apply discrete reset: V -> V_reset and w -> w + b upon reaching V_peak.

pub type AdExParams = struct {
    c_m: Float,       // Membrane capacitance (pF, default 200.0)
    g_l: Float,       // Leak conductance (nS, default 10.0)
    e_l: Float,       // Leak reversal potential (mV, default -70.0)
    delta_t: Float,   // Slope factor for exponential initiation (mV, default 2.0)
    v_t: Float,       // Threshold potential (mV, default -50.0)
    v_reset: Float,   // Reset membrane potential (mV, default -58.0)
    v_peak: Float,    // Spike cut-off / peak potential (mV, default 0.0)
    a: Float,         // Subthreshold adaptation conductance (nS, default 2.0)
    b: Float,         // Spike-triggered adaptation increment (pA, default 60.0)
    tau_w: Float     // Adaptation time constant (ms, default 120.0)
};

pub type AdExState = struct {
    v: Float,         // Membrane potential (mV)
    w: Float,         // Adaptation current (pA)
    spiked: Bool     // Spike emission indicator
};

pub type AdExDerivatives = struct {
    dv_dt: Float,
    dw_dt: Float
};

pub fn adex_params_pyramidal() -> AdExParams {
    return AdExParams {
        c_m: 200.0,
        g_l: 10.0,
        e_l: 0.0 - 70.0,
        delta_t: 2.0,
        v_t: 0.0 - 50.0,
        v_reset: 0.0 - 58.0,
        v_peak: 0.0,
        a: 2.0,
        b: 60.0,
        tau_w: 120.0
    };
}

pub fn adex_state_initial(v_init: Float, w_init: Float) -> AdExState {
    return AdExState {
        v: v_init,
        w: w_init,
        spiked: false
    };
}

pub fn adex_compute_derivatives(state: &AdExState, i_inj: Float, params: &AdExParams) -> AdExDerivatives {
    let v_val = (state).v;
    let w_val = (state).w;

    let exp_term = (params).g_l * (params).delta_t * exp((v_val - (params).v_t) / (params).delta_t);
    let i_leak = (params).g_l * (v_val - (params).e_l);

    let dv = (0.0 - i_leak + exp_term - w_val + i_inj) / (params).c_m;
    let dw = (((params).a * (v_val - (params).e_l)) - w_val) / (params).tau_w;

    return AdExDerivatives {
        dv_dt: dv,
        dw_dt: dw
    };
}

pub fn adex_step(state: &AdExState, i_inj: Float, dt_ms: Float, params: &AdExParams) -> AdExState {
    let mut v_curr = (state).v;
    let mut w_curr = (state).w;
    let mut has_spiked = false;

    if v_curr >= (params).v_peak {
        v_curr = (params).v_reset;
        w_curr = w_curr + (params).b;
    }

    let deriv = adex_compute_derivatives(state, i_inj, params);
    v_curr = v_curr + ((deriv).dv_dt * dt_ms);
    w_curr = w_curr + ((deriv).dw_dt * dt_ms);

    if v_curr >= (params).v_peak {
        has_spiked = true;
    }

    return AdExState {
        v: v_curr,
        w: w_curr,
        spiked: has_spiked
    };
}
