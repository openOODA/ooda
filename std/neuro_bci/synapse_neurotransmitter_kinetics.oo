// # Synaptic Neurotransmitter Binding Kinetics
//
// Logline: Simulates dual-exponential and first-order receptor binding dynamics for AMPA, NMDA, GABA_A, and GABA_B channels.
//
// Setup: Postsynaptic conductance kinetics modeling neurotransmitter release and receptor channel gating.
//
// Beats:
//   1. Define ReceptorKinetics (g_peak, e_rev, tau_rise, tau_decay) and SynapticConductance state.
//   2. Provide standard kinetic parameters for excitatory (AMPA, NMDA) and inhibitory (GABA_A, GABA_B) transmission.
//   3. Compute instantaneous synaptic post-synaptic current (PSC) I_syn = g(t) * (V_m - E_rev).

pub type ReceptorKinetics = struct {
    g_peak: Float,     // Peak conductance (nS)
    e_rev: Float,      // Reversal potential (mV)
    tau_rise: Float,   // Rise time constant (ms)
    tau_decay: Float,  // Decay time constant (ms)
};

pub type DualExpState = struct {
    g_rise: Float,
    g_decay: Float,
};

pub fn kinetics_ampa_default() -> ReceptorKinetics {
    return ReceptorKinetics {
        g_peak: 1.0,
        e_rev: 0.0,
        tau_rise: 0.5,
        tau_decay: 2.5,
    };
}

pub fn kinetics_nmda_default() -> ReceptorKinetics {
    return ReceptorKinetics {
        g_peak: 0.6,
        e_rev: 0.0,
        tau_rise: 2.0,
        tau_decay: 80.0,
    };
}

pub fn kinetics_gaba_a_default() -> ReceptorKinetics {
    return ReceptorKinetics {
        g_peak: 1.2,
        e_rev: 0.0 - 70.0,
        tau_rise: 0.5,
        tau_decay: 6.0,
    };
}

pub fn kinetics_gaba_b_default() -> ReceptorKinetics {
    return ReceptorKinetics {
        g_peak: 0.3,
        e_rev: 0.0 - 90.0,
        tau_rise: 25.0,
        tau_decay: 150.0,
    };
}

pub fn dual_exp_state_zero() -> DualExpState {
    return DualExpState {
        g_rise: 0.0,
        g_decay: 0.0,
    };
}

pub fn dual_exp_step(state: &DualExpState, dt_ms: Float, params: &ReceptorKinetics) -> DualExpState {
    let decay_factor_rise = exp((0.0 - dt_ms) / (params).tau_rise);
    let decay_factor_decay = exp((0.0 - dt_ms) / (params).tau_decay);

    return DualExpState {
        g_rise: (state).g_rise * decay_factor_rise,
        g_decay: (state).g_decay * decay_factor_decay,
    };
}

pub fn dual_exp_on_spike(state: &DualExpState, weight: Float) -> DualExpState {
    return DualExpState {
        g_rise: (state).g_rise + weight,
        g_decay: (state).g_decay + weight,
    };
}

pub fn dual_exp_conductance(state: &DualExpState, params: &ReceptorKinetics) -> Float {
    let g_diff = (state).g_decay - (state).g_rise;
    if g_diff < 0.0 { return 0.0; }
    return (params).g_peak * g_diff;
}

pub fn dual_exp_current(state: &DualExpState, v_m: Float, params: &ReceptorKinetics) -> Float {
    let g = dual_exp_conductance(state, params);
    return g * (v_m - (params).e_rev);
}
