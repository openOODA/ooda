// # NMDA Receptor Magnesium Voltage-Dependent Gating
//
// Logline: Calculates voltage-dependent extracellular magnesium (Mg2+) unblock kinetics for NMDA channels.
//
// Setup: Biophysical Jahr-Stevens formulation governing coincidental detector properties in synaptic spines.
//
// Beats:
//   1. Define NMDAGatingParams (mg_concentration_mm, alpha, delta, g_nmda_max, e_nmda_rev).
//   2. Compute fraction of unblocked open channels B(V) as a function of membrane potential.
//   3. Calculate instantaneous NMDA synaptic current I_NMDA(V, s).

pub type NMDAGatingParams = struct {
    mg_concentration_mm: Float, // Extracellular Mg2+ concentration (mM, default 1.0)
    alpha: Float,               // Voltage sensitivity scaling (1/mV, default 0.062)
    delta: Float,               // Constant denominator scaling (mM, default 3.57)
    g_nmda_max: Float,          // Maximal NMDA conductance (nS, default 1.0)
    e_nmda_rev: Float,          // Reversal potential (mV, default 0.0)
};

pub fn nmda_gating_params_default() -> NMDAGatingParams {
    return NMDAGatingParams {
        mg_concentration_mm: 1.0,
        alpha: 0.062,
        delta: 3.57,
        g_nmda_max: 1.0,
        e_nmda_rev: 0.0,
    };
}

pub fn nmda_mg_unblock_fraction(v_membrane_mv: Float, params: &NMDAGatingParams) -> Float {
    // B(V) = 1 / (1 + exp(-alpha * V) * [Mg2+] / delta)
    let exp_term = exp((0.0 - (params).alpha) * v_membrane_mv);
    let denominator = 1.0 + ((exp_term * (params).mg_concentration_mm) / (params).delta);
    if denominator <= 0.0 { return 0.0; }
    return 1.0 / denominator;
}

pub fn nmda_effective_conductance(v_membrane_mv: Float, s_open_fraction: Float, params: &NMDAGatingParams) -> Float {
    let b_v = nmda_mg_unblock_fraction(v_membrane_mv, params);
    return (params).g_nmda_max * s_open_fraction * b_v;
}

pub fn nmda_current(v_membrane_mv: Float, s_open_fraction: Float, params: &NMDAGatingParams) -> Float {
    let g_eff = nmda_effective_conductance(v_membrane_mv, s_open_fraction, params);
    return g_eff * (v_membrane_mv - (params).e_nmda_rev);
}
