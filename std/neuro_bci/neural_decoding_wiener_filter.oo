// # Linear Wiener Filter Neural Kinematic Decoder
//
// Logline: Decodes motor velocities using multi-tap finite impulse response (FIR) temporal lag memory filters.
//
// Setup: Optimal linear estimator mapping multi-unit spike history to velocity trajectories under minimum mean-square error (MMSE).
//
// Beats:
//   1. Define WienerWeights2x4 (multi-tap FIR regression weights across 4 time lags for 2 neural channels).
//   2. Buffer spike rate history across recent temporal lags (0 ms, -50 ms, -100 ms, -150 ms).
//   3. Compute linear dot-product prediction for decoded instantaneous velocity.

pub type WienerWeights2x4 = struct {
    // Channel 1 lag weights: lag0, lag1, lag2, lag3
    w1_0: Float, w1_1: Float, w1_2: Float, w1_3: Float,
    // Channel 2 lag weights: lag0, lag1, lag2, lag3
    w2_0: Float, w2_1: Float, w2_2: Float, w2_3: Float,
    bias: Float
};

pub type SpikeHistoryLag4 = struct {
    r0: Float, // Current time t
    r1: Float, // Lag 1 (t - 1)
    r2: Float, // Lag 2 (t - 2)
    r3: Float // Lag 3 (t - 3)
};

pub type DecodedVelocity = struct {
    velocity_cm_per_s: Float
};

pub fn wiener_weights_default() -> WienerWeights2x4 {
    return WienerWeights2x4 {
        w1_0: 0.45, w1_1: 0.30, w1_2: 0.15, w1_3: 0.05,
        w2_0: 0.0 - 0.40, w2_1: 0.0 - 0.25, w2_2: 0.0 - 0.10, w2_3: 0.0 - 0.05,
        bias: 0.0
    };
}

pub fn wiener_update_history(hist: &SpikeHistoryLag4, new_rate: Float) -> SpikeHistoryLag4 {
    return SpikeHistoryLag4 {
        r0: new_rate,
        r1: (hist).r0,
        r2: (hist).r1,
        r3: (hist).r2
    };
}

pub fn wiener_decode_single_axis(
    hist_ch1: &SpikeHistoryLag4,
    hist_ch2: &SpikeHistoryLag4,
    weights: &WienerWeights2x4
) -> DecodedVelocity {
    let dot1 = ((hist_ch1).r0 * (weights).w1_0) + ((hist_ch1).r1 * (weights).w1_1) +
               ((hist_ch1).r2 * (weights).w1_2) + ((hist_ch1).r3 * (weights).w1_3);

    let dot2 = ((hist_ch2).r0 * (weights).w2_0) + ((hist_ch2).r1 * (weights).w2_1) +
               ((hist_ch2).r2 * (weights).w2_2) + ((hist_ch2).r3 * (weights).w2_3);

    let v = dot1 + dot2 + (weights).bias;

    return DecodedVelocity {
        velocity_cm_per_s: v
    };
}
