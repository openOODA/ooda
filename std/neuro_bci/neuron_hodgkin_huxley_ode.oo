// # Hodgkin-Huxley Biophysical Action Potential ODE Solver
//
// Logline: Simulates 4-variable conductance-based action potential dynamics with Na+, K+, and leak ion channels.
//
// Setup: Biophysical differential equation integrator modeling squid giant axon electrophysiology.
//
// Beats:
//   1. Define Hodgkin-Huxley state (V, m, h, n) and biophysical parameters (g_Na, g_K, g_L, E_Na, E_K, E_L, C_m).
//   2. Compute voltage-dependent transition rates (alpha, beta) for activation and inactivation gating particles.
//   3. Advance state via explicit Euler/Runge-Kutta numerical integration given injected membrane current.

pub type HHParams = struct {
    c_m: Float,    // Membrane capacitance (uF/cm^2, default 1.0)
    g_na: Float,   // Max Na+ conductance (mS/cm^2, default 120.0)
    g_k: Float,    // Max K+ conductance (mS/cm^2, default 36.0)
    g_l: Float,    // Leak conductance (mS/cm^2, default 0.3)
    e_na: Float,   // Na+ reversal potential (mV, default 50.0)
    e_k: Float,    // K+ reversal potential (mV, default -77.0)
    e_l: Float,    // Leak reversal potential (mV, default -54.387)
};

pub type HHState = struct {
    v: Float,      // Membrane potential (mV)
    m: Float,      // Na+ activation gate [0, 1]
    h: Float,      // Na+ inactivation gate [0, 1]
    n: Float,      // K+ activation gate [0, 1]
};

pub type HHDerivatives = struct {
    dv_dt: Float,
    dm_dt: Float,
    dh_dt: Float,
    dn_dt: Float,
};

pub fn hh_params_default() -> HHParams {
    return HHParams {
        c_m: 1.0,
        g_na: 120.0,
        g_k: 36.0,
        g_l: 0.3,
        e_na: 50.0,
        e_k: 0.0 - 77.0,
        e_l: 0.0 - 54.387,
    };
}

pub fn hh_state_resting() -> HHState {
    return HHState {
        v: 0.0 - 65.0,
        m: 0.0529,
        h: 0.5961,
        n: 0.3177,
    };
}

pub fn hh_alpha_m(v: Float) -> Float {
    let num = 0.1 * (v + 40.0);
    let den = 1.0 - exp((0.0 - (v + 40.0)) / 10.0);
    if den == 0.0 { return 1.0; }
    return num / den;
}

pub fn hh_beta_m(v: Float) -> Float {
    return 4.0 * exp((0.0 - (v + 65.0)) / 18.0);
}

pub fn hh_alpha_h(v: Float) -> Float {
    return 0.07 * exp((0.0 - (v + 65.0)) / 20.0);
}

pub fn hh_beta_h(v: Float) -> Float {
    return 1.0 / (1.0 + exp((0.0 - (v + 35.0)) / 10.0));
}

pub fn hh_alpha_n(v: Float) -> Float {
    let num = 0.01 * (v + 55.0);
    let den = 1.0 - exp((0.0 - (v + 55.0)) / 10.0);
    if den == 0.0 { return 0.1; }
    return num / den;
}

pub fn hh_beta_n(v: Float) -> Float {
    return 0.125 * exp((0.0 - (v + 65.0)) / 80.0);
}

pub fn hh_compute_derivatives(state: &HHState, i_inj: Float, params: &HHParams) -> HHDerivatives {
    let v_val = (state).v;
    let m_val = (state).m;
    let h_val = (state).h;
    let n_val = (state).n;

    let i_na = (params).g_na * (m_val * m_val * m_val) * h_val * (v_val - (params).e_na);
    let i_k = (params).g_k * (n_val * n_val * n_val * n_val) * (v_val - (params).e_k);
    let i_l = (params).g_l * (v_val - (params).e_l);

    let dv = (i_inj - i_na - i_k - i_l) / (params).c_m;
    let dm = (hh_alpha_m(v_val) * (1.0 - m_val)) - (hh_beta_m(v_val) * m_val);
    let dh = (hh_alpha_h(v_val) * (1.0 - h_val)) - (hh_beta_h(v_val) * h_val);
    let dn = (hh_alpha_n(v_val) * (1.0 - n_val)) - (hh_beta_n(v_val) * n_val);

    return HHDerivatives {
        dv_dt: dv,
        dm_dt: dm,
        dh_dt: dh,
        dn_dt: dn,
    };
}

pub fn hh_euler_step(state: &HHState, i_inj: Float, dt_ms: Float, params: &HHParams) -> HHState {
    let deriv = hh_compute_derivatives(state, i_inj, params);
    let mut next_m = (state).m + ((deriv).dm_dt * dt_ms);
    let mut next_h = (state).h + ((deriv).dh_dt * dt_ms);
    let mut next_n = (state).n + ((deriv).dn_dt * dt_ms);

    if next_m < 0.0 { next_m = 0.0; } else if next_m > 1.0 { next_m = 1.0; }
    if next_h < 0.0 { next_h = 0.0; } else if next_h > 1.0 { next_h = 1.0; }
    if next_n < 0.0 { next_n = 0.0; } else if next_n > 1.0 { next_n = 1.0; }

    return HHState {
        v: (state).v + ((deriv).dv_dt * dt_ms),
        m: next_m,
        h: next_h,
        n: next_n,
    };
}
