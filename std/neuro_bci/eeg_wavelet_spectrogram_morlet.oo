// # Morlet Wavelet Time-Frequency Spectrogram
//
// Logline: Generates time-resolved event-related spectral perturbation (ERSP) spectrograms via complex Morlet wavelet filtering.
//
// Setup: Continuous wavelet transform engine balancing time and frequency resolution for transient neuro-oscillations.
//
// Beats:
//   1. Define MorletWaveletParams (center_freq_hz, bandwidth_param, sampling_rate_hz).
//   2. Compute 5-point discrete Gaussian-tapered complex Morlet wavelet kernel (real and imag components).
//   3. Convolve wavelet with EEG time series to obtain instantaneous event-related spectral power.

pub type MorletWaveletParams = struct {
    center_freq_hz: Float,
    bandwidth_sigma: Float,
    sampling_rate_hz: Float,
};

pub type MorletKernel5 = struct {
    re0: Float, re1: Float, re2: Float, re3: Float, re4: Float,
    im0: Float, im1: Float, im2: Float, im3: Float, im4: Float,
};

pub type WaveletPowerResponse = struct {
    real_response: Float,
    imag_response: Float,
    power: Float,
};

pub fn morlet_params_default(freq_hz: Float, fs_hz: Float) -> MorletWaveletParams {
    return MorletWaveletParams {
        center_freq_hz: freq_hz,
        bandwidth_sigma: 1.0,
        sampling_rate_hz: fs_hz,
    };
}

pub fn morlet_compute_kernel_5pt(params: &MorletWaveletParams) -> MorletKernel5 {
    // 5 points evaluated at t = -2*dt, -dt, 0, dt, 2*dt
    let dt = 1.0 / (params).sampling_rate_hz;
    let two_pi_f = 6.2831853 * (params).center_freq_hz;
    let two_sig_sq = 2.0 * (params).bandwidth_sigma * (params).bandwidth_sigma;

    let t_m2 = 0.0 - (2.0 * dt);
    let t_m1 = 0.0 - dt;
    let t_0 = 0.0;
    let t_p1 = dt;
    let t_p2 = 2.0 * dt;

    let g_m2 = exp((0.0 - (t_m2 * t_m2)) / two_sig_sq);
    let g_m1 = exp((0.0 - (t_m1 * t_m1)) / two_sig_sq);
    let g_0 = 1.0;
    let g_p1 = exp((0.0 - (t_p1 * t_p1)) / two_sig_sq);
    let g_p2 = exp((0.0 - (t_p2 * t_p2)) / two_sig_sq);

    return MorletKernel5 {
        re0: g_m2 * cos(two_pi_f * t_m2),
        re1: g_m1 * cos(two_pi_f * t_m1),
        re2: g_0 * cos(two_pi_f * t_0),
        re3: g_p1 * cos(two_pi_f * t_p1),
        re4: g_p2 * cos(two_pi_f * t_p2),

        im0: g_m2 * sin(two_pi_f * t_m2),
        im1: g_m1 * sin(two_pi_f * t_m1),
        im2: g_0 * sin(two_pi_f * t_0),
        im3: g_p1 * sin(two_pi_f * t_p1),
        im4: g_p2 * sin(two_pi_f * t_p2),
    };
}

pub fn morlet_convolve_5pt(
    x0: Float, x1: Float, x2: Float, x3: Float, x4: Float,
    kernel: &MorletKernel5
) -> WaveletPowerResponse {
    let re = (x0 * (kernel).re0) + (x1 * (kernel).re1) + (x2 * (kernel).re2) + (x3 * (kernel).re3) + (x4 * (kernel).re4);
    let im = (x0 * (kernel).im0) + (x1 * (kernel).im1) + (x2 * (kernel).im2) + (x3 * (kernel).im3) + (x4 * (kernel).im4);

    let pow = (re * re) + (im * im);

    return WaveletPowerResponse {
        real_response: re,
        imag_response: im,
        power: pow,
    };
}
