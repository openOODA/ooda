// # Extracellular Spike Sorting with PCA & K-Means
//
// Logline: Extracts principal component waveform features and clusters extracellular action potentials into distinct single-unit clusters.
//
// Setup: Unsupervised spike sorting pipeline projecting extracted action potential waveforms into low-dimensional PCA space.
//
// Beats:
//   1. Define SpikeWaveform4 (4-point sampled spike snippet) and PCAProjection2D (pc1, pc2).
//   2. Compute projection onto predetermined principal eigenvector axes.
//   3. Perform K-Means cluster assignment and distance centroid updates for 2 neural units.

pub type SpikeWaveform4 = struct {
    s0: Float, s1: Float, s2: Float, s3: Float,
};

pub type PCAProjection2D = struct {
    pc1: Float,
    pc2: Float,
};

pub type ClusterCentroid2D = struct {
    c_pc1: Float,
    c_pc2: Float,
};

pub type SpikeClusterResult = struct {
    cluster_id: Int,      // 0 or 1
    distance_to_center: Float,
};

pub fn spike_pca_project_sample(
    wave: &SpikeWaveform4,
    eig1_0: Float, eig1_1: Float, eig1_2: Float, eig1_3: Float,
    eig2_0: Float, eig2_1: Float, eig2_2: Float, eig2_3: Float
) -> PCAProjection2D {
    let p1 = ((wave).s0 * eig1_0) + ((wave).s1 * eig1_1) + ((wave).s2 * eig1_2) + ((wave).s3 * eig1_3);
    let p2 = ((wave).s0 * eig2_0) + ((wave).s1 * eig2_1) + ((wave).s2 * eig2_2) + ((wave).s3 * eig2_3);

    return PCAProjection2D {
        pc1: p1,
        pc2: p2,
    };
}

pub fn spike_distance_sq(proj: &PCAProjection2D, centroid: &ClusterCentroid2D) -> Float {
    let d1 = (proj).pc1 - (centroid).c_pc1;
    let d2 = (proj).pc2 - (centroid).c_pc2;
    return (d1 * d1) + (d2 * d2);
}

pub fn spike_kmeans_assign_2class(
    proj: &PCAProjection2D,
    center0: &ClusterCentroid2D,
    center1: &ClusterCentroid2D
) -> SpikeClusterResult {
    let dist0_sq = spike_distance_sq(proj, center0);
    let dist1_sq = spike_distance_sq(proj, center1);

    if dist0_sq <= dist1_sq {
        return SpikeClusterResult {
            cluster_id: 0,
            distance_to_center: sqrt(dist0_sq),
        };
    } else {
        return SpikeClusterResult {
            cluster_id: 1,
            distance_to_center: sqrt(dist1_sq),
        };
    }
}

pub fn spike_update_centroid(
    c_curr: &ClusterCentroid2D,
    new_pc1: Float,
    new_pc2: Float,
    learning_rate: Float
) -> ClusterCentroid2D {
    return ClusterCentroid2D {
        c_pc1: (c_curr).c_pc1 + (learning_rate * (new_pc1 - (c_curr).c_pc1)),
        c_pc2: (c_curr).c_pc2 + (learning_rate * (new_pc2 - (c_curr).c_pc2)),
    };
}

pub fn spike_sorting_pca_kmeans_probe() -> Int {
    return 0;
}
