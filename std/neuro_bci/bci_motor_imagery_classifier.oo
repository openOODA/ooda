// # BCI Sensorimotor Rhythm Motor Imagery Classifier
//
// Logline: Classifies left vs right hand motor imagery via event-related desynchronization (ERD) features and Linear Discriminant Analysis (LDA).
//
// Setup: Decodes sensorimotor mu (8-12 Hz) and beta (16-24 Hz) power attenuation over contralateral cortex (C3/C4).
//
// Beats:
//   1. Define LDAModel2D (w1, w2, bias, threshold) and MotorImageryFeatures (erd_c3_mu, erd_c4_mu).
//   2. Compute percentage Event-Related Desynchronization: ERD% = (P_active - P_baseline) / P_baseline * 100.
//   3. Evaluate LDA hyperplane decision function to predict intended motor intention (Left Hand vs Right Hand).

pub type LDAModel2D = struct {
    w1: Float,        // Weight for C3 feature
    w2: Float,        // Weight for C4 feature
    bias: Float,      // Intercept
    threshold: Float // Decision boundary (default 0.0)
};

pub type MotorImageryFeatures = struct {
    erd_c3_pct: Float, // Left hemisphere sensorimotor ERD
    erd_c4_pct: Float // Right hemisphere sensorimotor ERD
};

pub type MotorImageryDecision = struct {
    predicted_class: Int, // 0: Left Hand, 1: Right Hand, -1: Idle / Uncertain
    discriminant_score: Float,
    confidence: Float
};

pub fn lda_model_default() -> LDAModel2D {
    // Left hand produces contralateral C4 ERD (negative), Right hand produces C3 ERD (negative)
    return LDAModel2D {
        w1: 1.0,
        w2: 0.0 - 1.0,
        bias: 0.0,
        threshold: 0.0
    };
}

pub fn compute_erd_percent(active_power: Float, baseline_power: Float) -> Float {
    let safe_base = if baseline_power < 0.000001 { 0.000001 } else { baseline_power };
    return ((active_power - safe_base) / safe_base) * 100.0;
}

pub fn bci_classify_motor_imagery(
    features: &MotorImageryFeatures,
    model: &LDAModel2D
) -> MotorImageryDecision {
    // Linear decision function: y = w1*x1 + w2*x2 + bias
    let score = ((model).w1 * (features).erd_c3_pct) + ((model).w2 * (features).erd_c4_pct) + (model).bias;
    let margin = score - (model).threshold;
    let abs_margin = if margin < 0.0 { 0.0 - margin } else { margin };

    let mut pred = 0; // Left hand
    if margin > 0.0 {
        pred = 1; // Right hand
    }

    let is_uncertain = abs_margin < 5.0; // Deadband around zero
    if is_uncertain {
        pred = 0 - 1; // Neutral
    }

    return MotorImageryDecision {
        predicted_class: pred,
        discriminant_score: score,
        confidence: abs_margin
    };
}
