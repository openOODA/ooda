pub fn neuro_shim_hodgkin_huxley_step(v: Float, m: Float, h: Float, n: Float, i_inj: Float, dt: Float) -> HHState {
    let s = HHState { v: v, m: m, h: h, n: n };
    let p = hh_params_default();
    return hh_euler_step(&s, i_inj, dt, &p);
}

pub fn neuro_shim_izhikevich_step(v: Float, u: Float, i_inj: Float, dt: Float) -> IzhikevichState {
    let s = izhikevich_state_initial(v, u);
    let p = izhikevich_params_regular_spiking();
    return izhikevich_step(&s, i_inj, dt, &p);
}

pub fn neuro_shim_lif_step(v: Float, timer: Float, i_inj: Float, dt: Float) -> LIFState {
    let s = LIFState { v: v, refractory_timer: timer, spiked: false };
    let p = lif_params_default();
    return lif_step(&s, i_inj, dt, &p);
}

pub fn neuro_shim_stdp_weight(delta_t_ms: Float) -> Float {
    let p = stdp_params_default();
    return stdp_compute_delta_w(delta_t_ms, &p);
}

pub fn neuro_shim_wilson_cowan_step(e: Float, i: Float, p_drive: Float, q_drive: Float, dt: Float) -> WilsonCowanState {
    let s = WilsonCowanState { e_activity: e, i_activity: i };
    let p = wilson_cowan_params_default();
    return wilson_cowan_step(&s, p_drive, q_drive, dt, &p);
}

pub fn neuro_shim_jansen_rit_step(y0: Float, y1: Float, y2: Float, p_in: Float, dt: Float) -> JansenRitState {
    let s = JansenRitState { y0: y0, y1: y1, y2: y2, y3: 0.0, y4: 0.0, y5: 0.0 };
    let p = jansen_rit_params_default();
    return jansen_rit_step(&s, p_in, dt, &p);
}

pub fn neuro_shim_kuramoto_order_param(t0: Float, t1: Float, t2: Float, t3: Float) -> Float {
    let mut net = kuramoto_network4_default(1.0);
    net.theta0 = t0;
    net.theta1 = t1;
    net.theta2 = t2;
    net.theta3 = t3;
    let order = kuramoto_compute_order_parameter(&net);
    return (order).coherence_r;
}

pub fn neuro_shim_csp_project(c0: Float, c1: Float, c2: Float, c3: Float) -> CSPProjection2D {
    let filt = csp_filter_default();
    return csp_project_sample(c0, c1, c2, c3, &filt);
}

pub fn neuro_shim_ssvep_classify(s10: Float, s12: Float, s15: Float) -> SSVEPClassification {
    return ssvep_classify_3targets(s10, s12, s15, 0.4);
}

pub fn neuro_shim_motor_imagery_classify(erd_c3: Float, erd_c4: Float) -> MotorImageryDecision {
    let feat = MotorImageryFeatures { erd_c3_pct: erd_c3, erd_c4_pct: erd_c4 };
    let model = lda_model_default();
    return bci_classify_motor_imagery(&feat, &model);
}

pub fn neuro_shim_kalman_predict(px: Float, py: Float, vx: Float, vy: Float) -> KalmanPrediction2D {
    let state = KinematicState2D { pos_x: px, pos_y: py, vel_x: vx, vel_y: vy };
    let cov = kalman_cov_initial();
    let cfg = kalman_decoder_config_default();
    return kalman_predict_state(&state, &cov, &cfg);
}

pub fn neuro_shim_itr_wolpaw(n: Int, p: Float, t_sec: Float) -> ITRMetrics {
    return itr_compute_wolpaw(n, p, t_sec);
}
