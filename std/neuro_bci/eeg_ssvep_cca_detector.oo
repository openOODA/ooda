// # SSVEP Canonical Correlation Analysis (CCA) Frequency Detector
//
// Logline: Decodes Steady-State Visual Evoked Potentials (SSVEP) by computing canonical correlations against harmonic reference signals.
//
// Setup: Multi-channel frequency recognition engine for high-speed SSVEP-based BCI communication interfaces.
//
// Beats:
//   1. Generate sinusoidal and cosinusoidal reference signals for fundamental and harmonic frequencies.
//   2. Compute maximum canonical correlation rho between multi-channel EEG epochs and reference templates.
//   3. Compare correlations across target frequencies (e.g. 10 Hz, 12 Hz, 15 Hz) to select target visual stimulus.

pub type SSVEPTargetScore = struct {
    frequency_hz: Float,
    canonical_correlation: Float,
};

pub type SSVEPClassification = struct {
    selected_frequency_hz: Float,
    max_correlation: Float,
    confidence_margin: Float,
    is_valid_target: Bool,
};

pub fn ssvep_compute_reference_correlation(
    eeg0: Float, eeg1: Float, eeg2: Float, eeg3: Float,
    sin_f: Float, cos_f: Float,
    sin_2f: Float, cos_2f: Float
) -> Float {
    // Simplified multi-channel canonical projection: r = dot(EEG_proj, Ref_proj)
    let eeg_proj = (eeg0 * 0.5) + (eeg1 * 0.8) + (eeg2 * 0.8) + (eeg3 * 0.5); // Occipital weighting (O1, Oz, O2, Iz)
    let ref_proj = (sin_f * 0.5) + (cos_f * 0.5) + (sin_2f * 0.35) + (cos_2f * 0.35);

    let eeg_sq = eeg_proj * eeg_proj;
    let ref_sq = ref_proj * ref_proj;

    let denom = sqrt(if eeg_sq < 0.000001 { 0.000001 } else { eeg_sq }) * sqrt(if ref_sq < 0.000001 { 0.000001 } else { ref_sq });
    let dot = eeg_proj * ref_proj;

    if denom <= 0.0 { return 0.0; }
    let rho = dot / denom;
    return if rho < 0.0 { 0.0 - rho } else { rho };
}

pub fn ssvep_classify_3targets(
    score10: Float,
    score12: Float,
    score15: Float,
    detection_threshold: Float
) -> SSVEPClassification {
    let mut best_freq = 10.0;
    let mut best_score = score10;
    let mut second_best = score12;

    if score12 > best_score {
        second_best = best_score;
        best_score = score12;
        best_freq = 12.0;
    } else if score12 > second_best {
        second_best = score12;
    }

    if score15 > best_score {
        second_best = best_score;
        best_score = score15;
        best_freq = 15.0;
    } else if score15 > second_best {
        second_best = score15;
    }

    let margin = best_score - second_best;
    let valid = best_score >= detection_threshold && margin > 0.05;

    return SSVEPClassification {
        selected_frequency_hz: best_freq,
        max_correlation: best_score,
        confidence_margin: margin,
        is_valid_target: valid,
    };
}
