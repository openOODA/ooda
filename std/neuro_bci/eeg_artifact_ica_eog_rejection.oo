// # ICA Artifact Rejection & Ocular Blink Correction
//
// Logline: Identifies ocular blink and myogenic artifacts via component kurtosis and subtracts contaminated IC projections.
//
// Setup: Blind source separation artifact removal engine restoring clean cerebral EEG potential traces.
//
// Beats:
//   1. Define ICAComponentStats (excess_kurtosis, eog_correlation, is_artifact).
//   2. Calculate sample excess kurtosis to detect super-Gaussian peaky ocular blink dynamics.
//   3. Clean multi-channel potentials by projecting out identified artifact components.

pub type ICAComponentStats = struct {
    excess_kurtosis: Float,   // High positive kurtosis (>2.0) characterizes blinks
    frontal_eog_corr: Float,  // Correlation with frontal Fp1/Fp2 channels
    is_ocular_artifact: Bool,
};

pub type Cleaned4ChannelVoltages = struct {
    c0: Float, c1: Float, c2: Float, c3: Float,
};

pub fn ica_compute_kurtosis_4pt(x0: Float, x1: Float, x2: Float, x3: Float) -> Float {
    let mean = (x0 + x1 + x2 + x3) * 0.25;
    let d0 = x0 - mean;
    let d1 = x1 - mean;
    let d2 = x2 - mean;
    let d3 = x3 - mean;

    let m2 = ((d0 * d0) + (d1 * d1) + (d2 * d2) + (d3 * d3)) * 0.25;
    let m4 = ((d0 * d0 * d0 * d0) + (d1 * d1 * d1 * d1) + (d2 * d2 * d2 * d2) + (d3 * d3 * d3 * d3)) * 0.25;

    let safe_m2 = if m2 < 0.000001 { 0.000001 } else { m2 };
    let kurt = m4 / (safe_m2 * safe_m2);
    return kurt - 3.0; // Excess kurtosis (0 for normal Gaussian)
}

pub fn ica_classify_component(kurtosis: Float, eog_corr: Float) -> ICAComponentStats {
    let abs_corr = if eog_corr < 0.0 { 0.0 - eog_corr } else { eog_corr };
    let is_art = kurtosis > 2.0 || abs_corr > 0.65;

    return ICAComponentStats {
        excess_kurtosis: kurtosis,
        frontal_eog_corr: eog_corr,
        is_ocular_artifact: is_art,
    };
}

pub fn ica_subtract_artifact_component(
    raw0: Float, raw1: Float, raw2: Float, raw3: Float,
    artifact_source_s: Float,
    mix_weight0: Float, mix_weight1: Float, mix_weight2: Float, mix_weight3: Float
) -> Cleaned4ChannelVoltages {
    // X_clean = X_raw - A_col * s_artifact
    return Cleaned4ChannelVoltages {
        c0: raw0 - (mix_weight0 * artifact_source_s),
        c1: raw1 - (mix_weight1 * artifact_source_s),
        c2: raw2 - (mix_weight2 * artifact_source_s),
        c3: raw3 - (mix_weight3 * artifact_source_s),
    };
}
