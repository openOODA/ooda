// # Common Spatial Patterns (CSP) Spatial Filter
//
// Logline: Maximizes variance difference between two cognitive EEG conditions (e.g. left vs right motor imagery).
//
// Setup: Supervised spatial filtering projection for multi-channel brain-computer interface decoders.
//
// Beats:
//   1. Define CSPFilter4x2 (spatial projection weights mapping 4 EEG channels to 2 discriminative CSP components).
//   2. Project multi-channel sensor vectors into spatially filtered surrogate channels z = W * x.
//   3. Compute normalized log-variance feature vectors for binary motor imagery classification.

pub type CSPFilter4x2 = struct {
    // Component 1 (maximizes Class 1 variance)
    w1_0: Float, w1_1: Float, w1_2: Float, w1_3: Float,
    // Component 2 (maximizes Class 2 variance)
    w2_0: Float, w2_1: Float, w2_2: Float, w2_3: Float,
};

pub type CSPProjection2D = struct {
    z1: Float,
    z2: Float,
};

pub type CSPLogVarFeatures = struct {
    feat1: Float, // log(var(z1) / (var(z1) + var(z2)))
    feat2: Float, // log(var(z2) / (var(z1) + var(z2)))
};

pub fn csp_filter_default() -> CSPFilter4x2 {
    // Standard contralateral motor cortex spatial weighting (C3, Cz, C4, Pz)
    return CSPFilter4x2 {
        w1_0: 0.707, w1_1: 0.0 - 0.2, w1_2: 0.0 - 0.707, w1_3: 0.0,
        w2_0: 0.0 - 0.707, w2_1: 0.0 - 0.2, w2_2: 0.707, w2_3: 0.0,
    };
}

pub fn csp_project_sample(
    c0: Float, c1: Float, c2: Float, c3: Float,
    filter: &CSPFilter4x2
) -> CSPProjection2D {
    let z1 = (c0 * (filter).w1_0) + (c1 * (filter).w1_1) + (c2 * (filter).w1_2) + (c3 * (filter).w1_3);
    let z2 = (c0 * (filter).w2_0) + (c1 * (filter).w2_1) + (c2 * (filter).w2_2) + (c3 * (filter).w2_3);

    return CSPProjection2D {
        z1: z1,
        z2: z2,
    };
}

pub fn csp_compute_log_variance_features(var_z1: Float, var_z2: Float) -> CSPLogVarFeatures {
    let sum_var = var_z1 + var_z2;
    let safe_sum = if sum_var < 0.000001 { 0.000001 } else { sum_var };

    let p1 = if var_z1 < 0.000001 { 0.000001 } else { var_z1 } / safe_sum;
    let p2 = if var_z2 < 0.000001 { 0.000001 } else { var_z2 } / safe_sum;

    // Natural log feature
    let f1 = ln(p1);
    let f2 = ln(p2);

    return CSPLogVarFeatures {
        feat1: f1,
        feat2: f2,
    };
}
