// # Dendritic Cable Theory & Multi-Compartment Attenuation
//
// Logline: Simulates passive spatial electrotonus, axial resistance coupling, and synaptic attenuation along dendritic cables.
//
// Setup: Rall cable theory solver discretizing dendritic cylinders into linked electrical compartments.
//
// Beats:
//   1. Define CableSegment (diameter_um, length_um, r_membrane, r_axial, c_membrane).
//   2. Compute electrotonic length constant lambda, membrane time constant tau, and electrotonic distance L = x / lambda.
//   3. Solve multi-compartment voltage propagation across a 4-compartment dendritic arbor.

pub type CableSegment = struct {
    diameter_um: Float,  // Dendrite cylinder diameter in microns (e.g. 2.0)
    length_um: Float,    // Segment physical length in microns (e.g. 50.0)
    r_m_specific: Float, // Specific membrane resistance (Ohm*cm^2, default 20000.0)
    r_a_specific: Float, // Specific axial resistivity (Ohm*cm, default 150.0)
    c_m_specific: Float, // Specific membrane capacitance (uF/cm^2, default 1.0)
};

pub type FourCompartmentVoltages = struct {
    v_soma: Float,
    v_proximal: Float,
    v_medial: Float,
    v_distal: Float,
};

pub fn cable_segment_default() -> CableSegment {
    return CableSegment {
        diameter_um: 2.0,
        length_um: 50.0,
        r_m_specific: 20000.0,
        r_a_specific: 150.0,
        c_m_specific: 1.0,
    };
}

pub fn cable_space_constant_lambda_um(segment: &CableSegment) -> Float {
    // lambda = sqrt((d * R_m) / (4 * R_a)) in cm, converted to um (* 10000)
    let d_cm = (segment).diameter_um * 0.0001;
    let ratio = (d_cm * (segment).r_m_specific) / (4.0 * (segment).r_a_specific);
    if ratio <= 0.0 { return 0.0; }
    let lambda_cm = sqrt(ratio);
    return lambda_cm * 10000.0; // microns
}

pub fn cable_time_constant_tau_ms(segment: &CableSegment) -> Float {
    // tau_m = R_m * C_m in seconds, convert to ms (* 1000)
    // R_m in Ohm*cm^2, C_m in uF/cm^2 (10^-6 F/cm^2) -> R_m * C_m * 10^-6 s = R_m * C_m * 10^-3 ms
    return ((segment).r_m_specific * (segment).c_m_specific) * 0.001;
}

pub fn cable_steady_state_attenuation(distance_um: Float, lambda_um: Float) -> Float {
    if lambda_um <= 0.0 { return 0.0; }
    let electrotonic_x = distance_um / lambda_um;
    return exp(0.0 - electrotonic_x);
}

pub fn cable_step_4compartment(
    state: &FourCompartmentVoltages,
    i_syn_distal: Float,
    e_leak: Float,
    g_leak: Float,
    g_axial: Float,
    dt_ms: Float,
    c_m: Float
) -> FourCompartmentVoltages {
    // Compartment 0: Soma (clamped/boundary or somatic leak)
    // Compartment 1: Proximal dendrite
    // Compartment 2: Medial dendrite
    // Compartment 3: Distal dendrite with synaptic input

    let v0 = (state).v_soma;
    let v1 = (state).v_proximal;
    let v2 = (state).v_medial;
    let v3 = (state).v_distal;

    let dv0 = ((0.0 - (g_leak * (v0 - e_leak))) + (g_axial * (v1 - v0))) / c_m;
    let dv1 = ((0.0 - (g_leak * (v1 - e_leak))) + (g_axial * (v0 - (2.0 * v1) + v2))) / c_m;
    let dv2 = ((0.0 - (g_leak * (v2 - e_leak))) + (g_axial * (v1 - (2.0 * v2) + v3))) / c_m;
    let dv3 = ((0.0 - (g_leak * (v3 - e_leak))) + (g_axial * (v2 - v3)) + i_syn_distal) / c_m;

    return FourCompartmentVoltages {
        v_soma: v0 + (dv0 * dt_ms),
        v_proximal: v1 + (dv1 * dt_ms),
        v_medial: v2 + (dv2 * dt_ms),
        v_distal: v3 + (dv3 * dt_ms),
    };
}
