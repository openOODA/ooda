// # Wilson-Cowan Coupled Neural Population Dynamics
//
// Logline: Simulates macroscopic mean-field firing rate interactions between excitatory and inhibitory cortical populations.
//
// Setup: Canonical nonlinear population model exhibiting limit cycles, bistability, and oscillation hysteresis.
//
// Beats:
//   1. Define WilsonCowanParams (tau_e, tau_i, w_ee, w_ie, w_ei, w_ii, a_e, theta_e, a_i, theta_i).
//   2. Evaluate sigmoid activation functions S(v) converting net synaptic input to mean firing rates.
//   3. Integrate state variables (E: excitatory activity, I: inhibitory activity) under external drive (P, Q).

pub type WilsonCowanParams = struct {
    tau_e_ms: Float,   // Excitatory population time constant (ms, default 10.0)
    tau_i_ms: Float,   // Inhibitory population time constant (ms, default 10.0)
    w_ee: Float,       // Recurrent excitatory weight (default 12.0)
    w_ie: Float,       // Inhibitory to excitatory weight (default 4.0)
    w_ei: Float,       // Excitatory to inhibitory weight (default 13.0)
    w_ii: Float,       // Recurrent inhibitory weight (default 11.0)
    a_e: Float,        // Excitatory sigmoid slope (default 1.2)
    theta_e: Float,    // Excitatory firing threshold (default 2.8)
    a_i: Float,        // Inhibitory sigmoid slope (default 1.0)
    theta_i: Float,    // Inhibitory firing threshold (default 4.0)
};

pub type WilsonCowanState = struct {
    e_activity: Float, // Excitatory population firing fraction in [0, 1]
    i_activity: Float, // Inhibitory population firing fraction in [0, 1]
};

pub type PopulationDerivatives = struct {
    de_dt: Float,
    di_dt: Float,
};

pub fn wilson_cowan_params_default() -> WilsonCowanParams {
    return WilsonCowanParams {
        tau_e_ms: 10.0,
        tau_i_ms: 10.0,
        w_ee: 12.0,
        w_ie: 4.0,
        w_ei: 13.0,
        w_ii: 11.0,
        a_e: 1.2,
        theta_e: 2.8,
        a_i: 1.0,
        theta_i: 4.0,
    };
}

pub fn wilson_cowan_sigmoid(x: Float, a: Float, theta: Float) -> Float {
    let arg = (0.0 - a) * (x - theta);
    return 1.0 / (1.0 + exp(arg));
}

pub fn wilson_cowan_derivatives(
    state: &WilsonCowanState,
    p_drive: Float,
    q_drive: Float,
    params: &WilsonCowanParams
) -> PopulationDerivatives {
    let e_val = (state).e_activity;
    let i_val = (state).i_activity;

    let input_e = ((params).w_ee * e_val) - ((params).w_ie * i_val) + p_drive;
    let input_i = ((params).w_ei * e_val) - ((params).w_ii * i_val) + q_drive;

    let s_e = wilson_cowan_sigmoid(input_e, (params).a_e, (params).theta_e);
    let s_i = wilson_cowan_sigmoid(input_i, (params).a_i, (params).theta_i);

    let de = (0.0 - e_val + s_e) / (params).tau_e_ms;
    let di = (0.0 - i_val + s_i) / (params).tau_i_ms;

    return PopulationDerivatives {
        de_dt: de,
        di_dt: di,
    };
}

pub fn wilson_cowan_step(
    state: &WilsonCowanState,
    p_drive: Float,
    q_drive: Float,
    dt_ms: Float,
    params: &WilsonCowanParams
) -> WilsonCowanState {
    let deriv = wilson_cowan_derivatives(state, p_drive, q_drive, params);

    let mut next_e = (state).e_activity + ((deriv).de_dt * dt_ms);
    let mut next_i = (state).i_activity + ((deriv).di_dt * dt_ms);

    if next_e < 0.0 { next_e = 0.0; } else if next_e > 1.0 { next_e = 1.0; }
    if next_i < 0.0 { next_i = 0.0; } else if next_i > 1.0 { next_i = 1.0; }

    return WilsonCowanState {
        e_activity: next_e,
        i_activity: next_i,
    };
}
