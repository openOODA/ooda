// # Hindmarsh-Rose 3D Bursting Neuronal Model
//
// Logline: Generates complex rhythmic bursting, chaotic spiking, and plateau potentials via slow adaptation coupling.
//
// Setup: Three-variable nonlinear dynamical system for neuronal burst discharge modeling.
//
// Beats:
//   1. Define HRParams (a, b, c, d, r, s, x_r) and HRState (x: membrane potential, y: fast recovery, z: slow adaptation).
//   2. Compute 3D vector field derivatives for fast-slow timescale interactions.
//   3. Step trajectories forward with Runge-Kutta 4th order (RK4) or Euler integration.

pub type HRParams = struct {
    a: Float,   // Cubic potential scaling (default 1.0)
    b: Float,   // Quadratic potential scaling (default 3.0)
    c: Float,   // Constant recovery offset (default 1.0)
    d: Float,   // Quadratic recovery coefficient (default 5.0)
    r: Float,   // Slow adaptation rate (default 0.006)
    s: Float,   // Slow adaptation sensitivity (default 4.0)
    x_r: Float // Resting potential parameter (default -1.6)
};

pub type HRState = struct {
    x: Float,   // Dimensionless membrane potential
    y: Float,   // Fast exchange current / recovery variable
    z: Float   // Slow adaptation / bursting current
};

pub type HRDerivatives = struct {
    dx_dt: Float,
    dy_dt: Float,
    dz_dt: Float
};

pub fn hr_params_default() -> HRParams {
    return HRParams {
        a: 1.0,
        b: 3.0,
        c: 1.0,
        d: 5.0,
        r: 0.006,
        s: 4.0,
        x_r: 0.0 - 1.6
    };
}

pub fn hr_state_initial() -> HRState {
    return HRState {
        x: 0.0 - 1.6,
        y: 0.0 - 10.0,
        z: 0.0
    };
}

pub fn hr_derivatives(state: &HRState, i_stim: Float, params: &HRParams) -> HRDerivatives {
    let x_val = (state).x;
    let y_val = (state).y;
    let z_val = (state).z;

    let dx = y_val - ((params).a * x_val * x_val * x_val) + ((params).b * x_val * x_val) - z_val + i_stim;
    let dy = (params).c - ((params).d * x_val * x_val) - y_val;
    let dz = (params).r * (((params).s * (x_val - (params).x_r)) - z_val);

    return HRDerivatives {
        dx_dt: dx,
        dy_dt: dy,
        dz_dt: dz
    };
}

pub fn hr_step(state: &HRState, i_stim: Float, dt: Float, params: &HRParams) -> HRState {
    let d = hr_derivatives(state, i_stim, params);
    return HRState {
        x: (state).x + ((d).dx_dt * dt),
        y: (state).y + ((d).dy_dt * dt),
        z: (state).z + ((d).dz_dt * dt)
    };
}

pub fn hr_is_bursting(state: &HRState, spike_thresh: Float) -> Bool {
    return (state).x > spike_thresh;
}
