// # Local Field Potential (LFP) Current Source Density (CSD) Analysis
//
// Logline: Estimates laminar current sinks and sources from laminar multielectrode extracellular potentials using discrete Poisson inversion.
//
// Setup: Standard 1D and 2D Current Source Density algorithm for cortical depth profile mapping.
//
// Beats:
//   1. Define CSDConfig (electrode_spacing_um, conductivity_sigma_s_per_m, filter_hamming).
//   2. Compute 1D second spatial derivative finite differences across depth contacts.
//   3. Classify local sinks (depolarizing inward current, positive CSD) and sources (hyperpolarizing outward current, negative CSD).

pub type CSDConfig = struct {
    spacing_um: Float,              // Inter-electrode distance in microns (e.g. 100.0)
    conductivity_s_per_m: Float,    // Extracellular tissue conductivity sigma (default 0.3 S/m)
};

pub type CSDProfile5 = struct {
    csd1: Float, // Sink/Source at interior electrode 1 (uA/mm^3)
    csd2: Float, // Sink/Source at interior electrode 2
    csd3: Float, // Sink/Source at interior electrode 3
};

pub fn csd_config_default() -> CSDConfig {
    return CSDConfig {
        spacing_um: 100.0,
        conductivity_s_per_m: 0.3,
    };
}

pub fn csd_estimate_1d_interior(
    v_prev_mv: Float,
    v_curr_mv: Float,
    v_next_mv: Float,
    config: &CSDConfig
) -> Float {
    // CSD = -sigma * d2V/dz2 = -sigma * (V(z-h) - 2V(z) + V(z+h)) / h^2
    let h_mm = (config).spacing_um * 0.001; // mm
    let h_sq = h_mm * h_mm;
    if h_sq <= 0.0 { return 0.0; }

    let d2v = (v_prev_mv - (2.0 * v_curr_mv) + v_next_mv) / h_sq;
    // -sigma * d2V (mV to V is 1e-3, S/m to S/mm is 1e-3 -> result in uA/mm^3)
    return (0.0 - (config).conductivity_s_per_m) * d2v;
}

pub fn csd_compute_5channel_laminar(
    v0_mv: Float, v1_mv: Float, v2_mv: Float, v3_mv: Float, v4_mv: Float,
    config: &CSDConfig
) -> CSDProfile5 {
    let c1 = csd_estimate_1d_interior(v0_mv, v1_mv, v2_mv, config);
    let c2 = csd_estimate_1d_interior(v1_mv, v2_mv, v3_mv, config);
    let c3 = csd_estimate_1d_interior(v2_mv, v3_mv, v4_mv, config);

    return CSDProfile5 {
        csd1: c1,
        csd2: c2,
        csd3: c3,
    };
}

pub fn csd_is_current_sink(csd_val: Float) -> Bool {
    // Standard convention: negative extracellular potential derivative = inward transmembrane current (sink)
    return csd_val > 0.0;
}
