// # Tsodyks-Markram Short-Term Synaptic Plasticity (STP)
//
// Logline: Models activity-dependent synaptic facilitation and depression via vesicle depletion and calcium utilization.
//
// Setup: Phenomenological short-term plasticity engine governing dynamic filtering in biological neural circuits.
//
// Beats:
//   1. Define STPParams (baseline utilization U, depression time constant tau_d, facilitation time constant tau_f, baseline weight A_se).
//   2. Track available vesicle fraction R in [0, 1] and release probability u in [0, 1].
//   3. Update state upon spike arrival and exponential inter-spike recovery decay.

pub type STPParams = struct {
    u_baseline: Float,  // Baseline release probability U in [0, 1]
    tau_d_ms: Float,    // Vesicle recovery / depression time constant (ms)
    tau_f_ms: Float,    // Calcium-driven facilitation time constant (ms)
    a_se: Float,        // Maximum absolute synaptic efficacy
};

pub type STPState = struct {
    r: Float,           // Fraction of available neurotransmitter resources in [0, 1]
    u: Float,           // Running release probability / utilization in [0, 1]
};

pub type STPSpikeOutput = struct {
    next_state: STPState,
    effective_efficacy: Float,
};

pub fn stp_params_depressing() -> STPParams {
    return STPParams {
        u_baseline: 0.5,
        tau_d_ms: 800.0,
        tau_f_ms: 50.0,
        a_se: 1.0,
    };
}

pub fn stp_params_facilitating() -> STPParams {
    return STPParams {
        u_baseline: 0.15,
        tau_d_ms: 100.0,
        tau_f_ms: 600.0,
        a_se: 1.0,
    };
}

pub fn stp_state_initial(params: &STPParams) -> STPState {
    return STPState {
        r: 1.0,
        u: (params).u_baseline,
    };
}

pub fn stp_decay(state: &STPState, dt_ms: Float, params: &STPParams) -> STPState {
    let r_curr = (state).r;
    let u_curr = (state).u;

    let r_decay = exp((0.0 - dt_ms) / (params).tau_d_ms);
    let u_decay = exp((0.0 - dt_ms) / (params).tau_f_ms);

    let next_r = 1.0 + ((r_curr - 1.0) * r_decay);
    let next_u = (params).u_baseline + ((u_curr - (params).u_baseline) * u_decay);

    return STPState {
        r: next_r,
        u: next_u,
    };
}

pub fn stp_process_spike(state: &STPState, params: &STPParams) -> STPSpikeOutput {
    let r_minus = (state).r;
    let u_minus = (state).u;

    // Facilitation increment: u^+ = u^- + U * (1 - u^-)
    let u_plus = u_minus + ((params).u_baseline * (1.0 - u_minus));

    // Neurotransmitter release amount = u^+ * R^-
    let released_fraction = u_plus * r_minus;
    let effective_eff = (params).a_se * released_fraction;

    // Depression depletion: R^+ = R^- * (1 - u^+)
    let r_plus = r_minus * (1.0 - u_plus);

    return STPSpikeOutput {
        next_state: STPState {
            r: if r_plus < 0.0 { 0.0 } else { r_plus },
            u: if u_plus > 1.0 { 1.0 } else { u_plus },
        },
        effective_efficacy: effective_eff,
    };
}
