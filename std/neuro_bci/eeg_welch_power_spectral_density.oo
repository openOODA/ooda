// # Welch Power Spectral Density & EEG Band Powers
//
// Logline: Computes spectral power distribution, Hanning windowed periodograms, and canonical EEG rhythm band power ratios.
//
// Setup: Non-parametric spectral estimator quantifying frequency band power (delta, theta, alpha, beta, gamma).
//
// Beats:
//   1. Define EEGBandPowers (delta, theta, alpha, beta, gamma, total_power).
//   2. Apply Hanning window taper to minimize spectral leakage.
//   3. Compute absolute and relative band power ratios, including Theta/Beta attentional ratio.

pub type EEGBandPowers = struct {
    delta_power: Float, // 0.5 - 4 Hz
    theta_power: Float, // 4 - 8 Hz
    alpha_power: Float, // 8 - 13 Hz
    beta_power: Float,  // 13 - 30 Hz
    gamma_power: Float, // 30 - 80 Hz
    total_power: Float
};

pub type EEGPowerRatios = struct {
    theta_beta_ratio: Float,  // Attentional engagement index
    alpha_relative: Float,    // Alpha power / total power
    beta_relative: Float     // Beta power / total power
};

pub type WindowedEpoch4 = struct {
    w0: Float,
    w1: Float,
    w2: Float,
    w3: Float
};

pub fn welch_hanning_window_4pt(x0: Float, x1: Float, x2: Float, x3: Float) -> WindowedEpoch4 {
    // 4-point Hanning window: w[n] = 0.5 * (1 - cos(2*pi*n / 3))
    // w0 = 0.0, w1 = 0.75, w2 = 0.75, w3 = 0.0
    return WindowedEpoch4 {
        w0: 0.0,
        w1: x1 * 0.75,
        w2: x2 * 0.75,
        w3: 0.0
    };
}

pub fn eeg_calculate_band_powers(
    delta_p: Float,
    theta_p: Float,
    alpha_p: Float,
    beta_p: Float,
    gamma_p: Float
) -> EEGBandPowers {
    let tot = delta_p + theta_p + alpha_p + beta_p + gamma_p;
    let safe_tot = if tot < 0.000001 { 0.000001 } else { tot };

    return EEGBandPowers {
        delta_power: delta_p,
        theta_power: theta_p,
        alpha_power: alpha_p,
        beta_power: beta_p,
        gamma_power: gamma_p,
        total_power: safe_tot
    };
}

pub fn eeg_compute_power_ratios(bands: &EEGBandPowers) -> EEGPowerRatios {
    let t_pow = (bands).theta_power;
    let b_pow = (bands).beta_power;
    let a_pow = (bands).alpha_power;
    let tot = (bands).total_power;

    let safe_beta = if b_pow < 0.000001 { 0.000001 } else { b_pow };
    let tbr = t_pow / safe_beta;
    let alpha_rel = a_pow / tot;
    let beta_rel = b_pow / tot;

    return EEGPowerRatios {
        theta_beta_ratio: tbr,
        alpha_relative: alpha_rel,
        beta_relative: beta_rel
    };
}
