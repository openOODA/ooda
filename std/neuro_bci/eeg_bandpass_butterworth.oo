// # Butterworth Bandpass IIR Filter for EEG Rhythms
//
// Logline: Implements 2nd-order biquad IIR digital filtering isolated to classical EEG bands (delta, theta, alpha, beta, gamma).
//
// Setup: Direct Form II transposed biquad filter with digital frequency pre-warping.
//
// Beats:
//   1. Define BiquadCoeffs (b0, b1, b2, a1, a2) and BiquadState (z1, z2 delay elements).
//   2. Provide standard coefficient presets for Alpha (8-13 Hz), Beta (13-30 Hz), Theta (4-8 Hz), and Gamma (30-80 Hz) at 250 Hz sampling rate.
//   3. Filter streaming EEG potential samples in Direct Form II transposed topology.

pub type BiquadCoeffs = struct {
    b0: Float,
    b1: Float,
    b2: Float,
    a1: Float, // Denominator normalized such that a0 = 1.0
    a2: Float,
};

pub type BiquadState = struct {
    z1: Float, // First delay register
    z2: Float, // Second delay register
};

pub fn biquad_state_zero() -> BiquadState {
    return BiquadState {
        z1: 0.0,
        z2: 0.0,
    };
}

pub fn eeg_filter_alpha_250hz() -> BiquadCoeffs {
    // 2nd-order Butterworth bandpass: 8.0 Hz to 13.0 Hz, Fs = 250.0 Hz
    return BiquadCoeffs {
        b0: 0.0592,
        b1: 0.0,
        b2: 0.0 - 0.0592,
        a1: 0.0 - 1.8023,
        a2: 0.8816,
    };
}

pub fn eeg_filter_beta_250hz() -> BiquadCoeffs {
    // 2nd-order Butterworth bandpass: 13.0 Hz to 30.0 Hz, Fs = 250.0 Hz
    return BiquadCoeffs {
        b0: 0.1788,
        b1: 0.0,
        b2: 0.0 - 0.1788,
        a1: 0.0 - 1.4285,
        a2: 0.6424,
    };
}

pub fn eeg_filter_theta_250hz() -> BiquadCoeffs {
    // 2nd-order Butterworth bandpass: 4.0 Hz to 8.0 Hz, Fs = 250.0 Hz
    return BiquadCoeffs {
        b0: 0.0481,
        b1: 0.0,
        b2: 0.0 - 0.0481,
        a1: 0.0 - 1.8841,
        a2: 0.9038,
    };
}

pub fn eeg_filter_gamma_250hz() -> BiquadCoeffs {
    // 2nd-order Butterworth bandpass: 30.0 Hz to 70.0 Hz, Fs = 250.0 Hz
    return BiquadCoeffs {
        b0: 0.3806,
        b1: 0.0,
        b2: 0.0 - 0.3806,
        a1: 0.0 - 0.3449,
        a2: 0.2388,
    };
}

pub type FilterStepResult = struct {
    next_state: BiquadState,
    filtered_sample: Float,
};

pub fn biquad_process_sample(
    x: Float,
    state: &BiquadState,
    coeffs: &BiquadCoeffs
) -> FilterStepResult {
    // Direct Form II Transposed topology:
    // y[n] = b0 * x[n] + z1[n-1]
    // z1[n] = b1 * x[n] - a1 * y[n] + z2[n-1]
    // z2[n] = b2 * x[n] - a2 * y[n]

    let y = ((coeffs).b0 * x) + (state).z1;
    let next_z1 = (((coeffs).b1 * x) - ((coeffs).a1 * y)) + (state).z2;
    let next_z2 = ((coeffs).b2 * x) - ((coeffs).a2 * y);

    return FilterStepResult {
        next_state: BiquadState {
            z1: next_z1,
            z2: next_z2,
        },
        filtered_sample: y,
    };
}
