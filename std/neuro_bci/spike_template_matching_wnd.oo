// # Spike Waveform Template Matching & SNR Estimation
//
// Logline: Classifies overlapping action potential snippets using normalized cross-correlation and residual SNR metrics.
//
// Setup: Template matching engine for online spike classification against known single-unit libraries.
//
// Beats:
//   1. Define SpikeTemplate4 (mean waveform, L2 norm, peak-to-peak amplitude).
//   2. Compute normalized cross-correlation coefficient r in [-1, 1].
//   3. Estimate residual noise RMS and template match signal-to-noise ratio (SNR in dB).

pub type SpikeTemplate4 = struct {
    t0: Float, t1: Float, t2: Float, t3: Float,
    norm: Float,
    p2p_amplitude: Float,
};

pub type TemplateMatchResult = struct {
    correlation: Float, // Normalized cross-correlation in [-1, 1]
    residual_rms: Float,
    snr_db: Float,
    is_match: Bool,
};

pub fn spike_template4_new(t0: Float, t1: Float, t2: Float, t3: Float) -> SpikeTemplate4 {
    let norm_sq = (t0 * t0) + (t1 * t1) + (t2 * t2) + (t3 * t3);
    let norm_val = sqrt(if norm_sq < 0.000001 { 0.000001 } else { norm_sq });

    let mut min_val = t0;
    let mut max_val = t0;
    if t1 < min_val { min_val = t1; } if t1 > max_val { max_val = t1; }
    if t2 < min_val { min_val = t2; } if t2 > max_val { max_val = t2; }
    if t3 < min_val { min_val = t3; } if t3 > max_val { max_val = t3; }

    return SpikeTemplate4 {
        t0: t0, t1: t1, t2: t2, t3: t3,
        norm: norm_val,
        p2p_amplitude: max_val - min_val,
    };
}

pub fn spike_match_template(
    w0: Float, w1: Float, w2: Float, w3: Float,
    template: &SpikeTemplate4,
    min_correlation: Float
) -> TemplateMatchResult {
    let w_norm_sq = (w0 * w0) + (w1 * w1) + (w2 * w2) + (w3 * w3);
    let w_norm = sqrt(if w_norm_sq < 0.000001 { 0.000001 } else { w_norm_sq });

    let dot = (w0 * (template).t0) + (w1 * (template).t1) + (w2 * (template).t2) + (w3 * (template).t3);
    let denom = w_norm * (template).norm;
    let r = if denom <= 0.0 { 0.0 } else { dot / denom };

    // Residual difference RMS
    let d0 = w0 - (template).t0;
    let d1 = w1 - (template).t1;
    let d2 = w2 - (template).t2;
    let d3 = w3 - (template).t3;
    let res_ms = ((d0 * d0) + (d1 * d1) + (d2 * d2) + (d3 * d3)) / 4.0;
    let res_rms = sqrt(if res_ms < 0.000001 { 0.000001 } else { res_ms });

    // SNR in dB = 20 * log10(amplitude / noise) ~ approximated
    let ratio = (template).p2p_amplitude / res_rms;
    let snr = if ratio > 1.0 { ratio * 2.0 } else { 0.0 };

    return TemplateMatchResult {
        correlation: r,
        residual_rms: res_rms,
        snr_db: snr,
        is_match: r >= min_correlation,
    };
}
