// # Computational Neuroscience & BCI Hardware Driver Stubs
//
// Logline: Hardware coprocessor and acquisition telemetry shims for Intan RHD, OpenBCI Cyton, and Blackrock NeuroPort frontends.
//
// Setup: Fail-closed driver shims exposing bio-amplification and neural signal processor telemetry.
//
// Beats:
//   1. Stub Intan RHD2000 SPI amplifier frontend 30 kSps raw ADC conversion.
//   2. Provide OpenBCI Cyton ADS1299 24-bit delta-sigma microvolt conversion shims.
//   3. Expose Blackrock NeuroPort and Neuropixels 2.0 digital telemetry metrics.

pub fn neuro_stub_intan_rhd_sample_rate_hz() -> Int {
    // Intan RHD2000 standard multi-channel electrophysiology sampling rate
    return 30000;
}

pub fn neuro_stub_intan_rhd_adc_to_microvolts(raw_adc_16bit: Int) -> Float {
    // 0.195 uV per LSB resolution for Intan RHD2000 series
    let centered = raw_adc_16bit - 32768;
    return (centered as Float) * 0.195;
}

pub fn neuro_stub_openbci_ads1299_adc_to_microvolts(raw_adc_24bit: Int, gain: Float) -> Float {
    // ADS1299: V_ref = 4.5V, 24-bit resolution: (V_ref / (2^23 - 1)) / gain in uV
    let lsb_uv = (4.5 / 8388607.0) * 1000000.0;
    let effective_gain = if gain <= 0.0 { 24.0 } else { gain };
    return ((raw_adc_24bit as Float) * lsb_uv) / effective_gain;
}

pub fn neuro_stub_blackrock_neuroport_channel_count() -> Int {
    // Blackrock Cerebus / NeuroPort 128-channel hub
    return 128;
}

pub fn neuro_stub_neuropixels2_shank_count() -> Int {
    // Neuropixels 2.0 quad-shank probe
    return 4;
}
