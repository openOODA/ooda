// # BCI Information Transfer Rate (ITR) Calculator
//
// Logline: Quantifies BCI channel throughput in bits/minute via Wolpaw's mutual information definition and Nykopp extension.
//
// Setup: Standard BCI communication benchmark metrics for discrete spellers and target selectors.
//
// Beats:
//   1. Implement base-2 logarithm conversion log2(x) = ln(x) / 0.693147.
//   2. Compute bits per selection: B = log2(N) + P*log2(P) + (1-P)*log2((1-P)/(N-1)).
//   3. Scale bits per decision by trial duration T to compute throughput in bits per minute (bpm).

pub type ITRMetrics = struct {
    bits_per_selection: Float,
    bits_per_minute: Float,
    target_count: Int,
    accuracy: Float,
    trial_duration_sec: Float,
};

pub fn itr_log2(x: Float) -> Float {
    if x <= 0.000001 { return 0.0; }
    return ln(x) / 0.69314718;
}

pub fn itr_compute_wolpaw(
    n_targets: Int,
    accuracy_p: Float,
    trial_duration_sec: Float
) -> ITRMetrics {
    if n_targets <= 1 || trial_duration_sec <= 0.0 {
        return ITRMetrics {
            bits_per_selection: 0.0,
            bits_per_minute: 0.0,
            target_count: n_targets,
            accuracy: accuracy_p,
            trial_duration_sec: trial_duration_sec,
        };
    }

    let n_fl: Float = (n_targets as Float);
    let p: Float = if accuracy_p > 0.99999 { 0.99999 } else if accuracy_p < 0.00001 { 0.00001 } else { accuracy_p };

    let term1: Float = itr_log2(n_fl);
    let term2: Float = p * itr_log2(p);
    let term3: Float = (1.0 - p) * itr_log2((1.0 - p) / (n_fl - 1.0));

    let mut b_bits: Float = term1 + term2 + term3;
    if b_bits < 0.0 { b_bits = 0.0; }

    let speed_selections_per_min: Float = 60.0 / trial_duration_sec;
    let itr_bpm: Float = b_bits * speed_selections_per_min;

    return ITRMetrics {
        bits_per_selection: b_bits,
        bits_per_minute: itr_bpm,
        target_count: n_targets,
        accuracy: accuracy_p,
        trial_duration_sec: trial_duration_sec,
    };
}
