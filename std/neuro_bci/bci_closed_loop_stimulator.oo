// # Closed-Loop Phase-Locked Neurostimulation Controller
//
// Logline: Triggers phase-locked electrical or optogenetic stimulation pulses timed precisely to cortical oscillation peaks and troughs.
//
// Setup: Closed-loop neuromodulation engine with refractory blanking to prevent stimulation artifact feedback loops.
//
// Beats:
//   1. Define StimTriggerConfig (target_phase_rad, phase_tolerance_rad, refractory_period_ms, pulse_amplitude_ua, pulse_width_us).
//   2. Check if instantaneous phase matches target trigger angle within specified angular tolerance.
//   3. Dispatch biphasic stimulation command and engage artifact blanking timer.

pub type StimTriggerConfig = struct {
    target_phase_rad: Float,    // Trigger phase angle (e.g. 0.0 for peak, 3.14159 for trough)
    phase_tolerance_rad: Float, // Phase acceptance window (e.g. 0.2 rad)
    refractory_period_ms: Float,// Blanking period after stimulus (ms, default 50.0)
    pulse_amplitude_ua: Float,  // Current amplitude (uA, default 150.0)
    pulse_width_us: Float      // Biphasic pulse width (microseconds, default 200.0)
};

pub type StimControllerState = struct {
    blanking_timer_ms: Float,
    total_pulses_delivered: Int
};

pub type StimDispatchResult = struct {
    next_state: StimControllerState,
    trigger_pulse: Bool,
    pulse_amplitude_ua: Float,
    is_blanking_active: Bool
};

pub fn stim_config_peak_locked() -> StimTriggerConfig {
    return StimTriggerConfig {
        target_phase_rad: 0.0,
        phase_tolerance_rad: 0.25,
        refractory_period_ms: 100.0,
        pulse_amplitude_ua: 150.0,
        pulse_width_us: 200.0
    };
}

pub fn stim_config_trough_locked() -> StimTriggerConfig {
    return StimTriggerConfig {
        target_phase_rad: 3.14159,
        phase_tolerance_rad: 0.25,
        refractory_period_ms: 100.0,
        pulse_amplitude_ua: 150.0,
        pulse_width_us: 200.0
    };
}

pub fn stim_state_initial() -> StimControllerState {
    return StimControllerState {
        blanking_timer_ms: 0.0,
        total_pulses_delivered: 0
    };
}

pub fn stim_evaluate_trigger(
    current_phase_rad: Float,
    dt_ms: Float,
    state: &StimControllerState,
    config: &StimTriggerConfig
) -> StimDispatchResult {
    let mut timer = (state).blanking_timer_ms;
    let mut pulses = (state).total_pulses_delivered;
    let mut trigger = false;

    if timer > 0.0 {
        timer = timer - dt_ms;
        if timer < 0.0 { timer = 0.0; }
    } else {
        // Calculate angular difference
        let dphi = current_phase_rad - (config).target_phase_rad;
        let abs_dphi = if dphi < 0.0 { 0.0 - dphi } else { dphi };

        if abs_dphi <= (config).phase_tolerance_rad {
            trigger = true;
            timer = (config).refractory_period_ms;
            pulses = pulses + 1;
        }
    }

    return StimDispatchResult {
        next_state: StimControllerState {
            blanking_timer_ms: timer,
            total_pulses_delivered: pulses
        },
        trigger_pulse: trigger,
        pulse_amplitude_ua: if trigger { (config).pulse_amplitude_ua } else { 0.0 },
        is_blanking_active: timer > 0.0
    };
}
