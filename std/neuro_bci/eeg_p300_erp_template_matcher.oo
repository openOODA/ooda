// # P300 Event-Related Potential (ERP) Matched Filter
//
// Logline: Detects oddball P300 target deflections (300-500 ms post-stimulus) in brain-computer interface spellers using template cross-correlation.
//
// Setup: Time-locked epoch detector extracting positive parietal ERP components for row/column P300 spellers.
//
// Beats:
//   1. Define P300Template4 (expected positive parietal ERP waveform at 250 ms, 300 ms, 350 ms, 400 ms post-stimulus).
//   2. Compute normalized cross-correlation and peak positive deflection amplitude in target window.
//   3. Score target vs non-target flashed items to determine user selection.

pub type P300Template4 = struct {
    p250_uv: Float, // Early positive deflection
    p300_uv: Float, // Peak P300 component (e.g. +8.0 uV)
    p350_uv: Float, // Late positive peak
    p400_uv: Float, // Return toward baseline
    template_norm: Float
};

pub type P300DetectionScore = struct {
    matched_score: Float,
    peak_amplitude_uv: Float,
    is_target_flash: Bool
};

pub fn p300_template_default() -> P300Template4 {
    let t0 = 2.0;
    let t1 = 8.5;
    let t2 = 7.0;
    let t3 = 2.5;
    let norm_sq = (t0 * t0) + (t1 * t1) + (t2 * t2) + (t3 * t3);
    let n = sqrt(if norm_sq < 0.000001 { 0.000001 } else { norm_sq });

    return P300Template4 {
        p250_uv: t0,
        p300_uv: t1,
        p350_uv: t2,
        p400_uv: t3,
        template_norm: n
    };
}

pub fn p300_score_epoch(
    v250: Float, v300: Float, v350: Float, v400: Float,
    template: &P300Template4,
    detection_threshold: Float
) -> P300DetectionScore {
    let epoch_norm_sq = (v250 * v250) + (v300 * v300) + (v350 * v350) + (v400 * v400);
    let epoch_norm = sqrt(if epoch_norm_sq < 0.000001 { 0.000001 } else { epoch_norm_sq });

    let dot = (v250 * (template).p250_uv) + (v300 * (template).p300_uv) + (v350 * (template).p350_uv) + (v400 * (template).p400_uv);
    let denom = epoch_norm * (template).template_norm;
    let corr = if denom <= 0.0 { 0.0 } else { dot / denom };

    // Max peak in window
    let mut peak = v250;
    if v300 > peak { peak = v300; }
    if v350 > peak { peak = v350; }
    if v400 > peak { peak = v400; }

    let score = corr * peak;
    let is_target = score >= detection_threshold && corr > 0.4;

    return P300DetectionScore {
        matched_score: score,
        peak_amplitude_uv: peak,
        is_target_flash: is_target
    };
}
