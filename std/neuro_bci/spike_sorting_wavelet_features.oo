// # Discrete Wavelet Transform (DWT) Spike Feature Extractor
//
// Logline: Decomposes 4-sample spike waveforms into multi-resolution approximation and detail wavelet coefficients (Haar/D4).
//
// Setup: Wavelet feature selection engine capturing localized transient features in extracellular spike shapes.
//
// Beats:
//   1. Define WaveletCoeffs4 (A2: coarse approximation, D2: level-2 detail, D1_0: fine detail 0, D1_1: fine detail 1).
//   2. Compute 2-level orthonormal Haar discrete wavelet transform.
//   3. Extract feature energy and select optimal coefficients for downstream clustering.

pub type WaveletCoeffs4 = struct {
    a2: Float,    // Low-frequency baseline approximation (s0 + s1 + s2 + s3)/2
    d2: Float,    // Medium-frequency inflection detail (s0 + s1 - s2 - s3)/2
    d1_0: Float,  // High-frequency leading edge detail (s0 - s1)/sqrt(2)
    d1_1: Float  // High-frequency trailing edge detail (s2 - s3)/sqrt(2)
};

pub type TopWaveletFeatures = struct {
    feat1: Float,
    feat2: Float
};

pub fn wavelet_decompose_haar_4pt(s0: Float, s1: Float, s2: Float, s3: Float) -> WaveletCoeffs4 {
    let inv_sqrt2 = 0.70710678;

    // Level 1 decomposition
    let a1_0 = (s0 + s1) * inv_sqrt2;
    let a1_1 = (s2 + s3) * inv_sqrt2;
    let d1_0 = (s0 - s1) * inv_sqrt2;
    let d1_1 = (s2 - s3) * inv_sqrt2;

    // Level 2 decomposition on approximation coefficients
    let a2 = (a1_0 + a1_1) * inv_sqrt2;
    let d2 = (a1_0 - a1_1) * inv_sqrt2;

    return WaveletCoeffs4 {
        a2: a2,
        d2: d2,
        d1_0: d1_0,
        d1_1: d1_1
    };
}

pub fn wavelet_extract_top2_features(coeffs: &WaveletCoeffs4) -> TopWaveletFeatures {
    // In extracellular spike sorting, the high-frequency detail D2 and D1_0 exhibit highest cluster separability
    return TopWaveletFeatures {
        feat1: (coeffs).d2,
        feat2: (coeffs).d1_0
    };
}

pub fn wavelet_coefficient_energy(coeffs: &WaveletCoeffs4) -> Float {
    let a2_sq = (coeffs).a2 * (coeffs).a2;
    let d2_sq = (coeffs).d2 * (coeffs).d2;
    let d10_sq = (coeffs).d1_0 * (coeffs).d1_0;
    let d11_sq = (coeffs).d1_1 * (coeffs).d1_1;
    return a2_sq + d2_sq + d10_sq + d11_sq;
}
