// # Surface Laplacian & Hjorth Temporal Complexity Parameters
//
// Logline: Enhances spatial resolution via nearest-neighbor surface Laplacian derivation and extracts Hjorth time-domain descriptors.
//
// Setup: Spatial high-pass montage filter and statistical waveform complexity analyzer for clinical EEG.
//
// Beats:
//   1. Compute 4-neighbor local small surface Laplacian V_lap = V_center - (1/4)*sum(V_surround).
//   2. Calculate Hjorth Activity (variance of signal), Mobility (mean frequency), and Complexity (frequency spread).
//   3. Classify clinical signal vigilance state based on Hjorth descriptor profiles.

pub type HjorthParameters = struct {
    activity: Float,   // Variance of amplitude (signal power)
    mobility: Float,   // sqrt(var(dy/dt) / var(y)), estimate of mean frequency
    complexity: Float, // Mobility(dy/dt) / Mobility(y), estimate of spectral bandwidth
};

pub fn laplacian_small_surface_4pt(
    v_center: Float,
    v_north: Float,
    v_south: Float,
    v_east: Float,
    v_west: Float
) -> Float {
    let surround_avg = (v_north + v_south + v_east + v_west) * 0.25;
    return v_center - surround_avg;
}

pub fn hjorth_compute_parameters(
    var_y: Float,
    var_dy: Float,
    var_d2y: Float
) -> HjorthParameters {
    let safe_var_y = if var_y < 0.000001 { 0.000001 } else { var_y };
    let safe_var_dy = if var_dy < 0.000001 { 0.000001 } else { var_dy };

    let mobility_y = sqrt(safe_var_dy / safe_var_y);
    let mobility_dy = sqrt((if var_d2y < 0.000001 { 0.000001 } else { var_d2y }) / safe_var_dy);

    let complexity_val = if mobility_y <= 0.000001 { 1.0 } else { mobility_dy / mobility_y };

    return HjorthParameters {
        activity: var_y,
        mobility: mobility_y,
        complexity: complexity_val,
    };
}
