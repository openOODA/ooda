// # Inter-Spike Interval (ISI) Histogram & Refractory Period Validation
//
// Logline: Evaluates single-unit isolation quality by quantifying refractory period violations and burst discharge index.
//
// Setup: Spike quality metrics engine binning ISIs and detecting multi-unit contamination.
//
// Beats:
//   1. Define ISIHistogram5 (bins: <2ms refractory, 2-5ms burst, 5-20ms, 20-100ms, >100ms tonic).
//   2. Accumulate inter-spike intervals into discrete duration bins.
//   3. Compute refractory violation percentage and classify unit isolation quality (Clean Single-Unit vs MUA).

pub type ISIHistogram5 = struct {
    bin_refractory_lt2ms: Int, // Refractory violations (<2 ms)
    bin_burst_2to5ms: Int,     // Bursting spikes (2-5 ms)
    bin_fast_5to20ms: Int,     // Fast firing (5-20 ms)
    bin_medium_20to100ms: Int, // Medium rates (20-100 ms)
    bin_slow_gt100ms: Int,     // Slow / tonic (>100 ms)
    total_spikes: Int
};

pub type UnitIsolationQuality = struct {
    refractory_violation_pct: Float,
    burst_index_pct: Float,
    is_clean_single_unit: Bool
};

pub fn isi_histogram5_empty() -> ISIHistogram5 {
    return ISIHistogram5 {
        bin_refractory_lt2ms: 0,
        bin_burst_2to5ms: 0,
        bin_fast_5to20ms: 0,
        bin_medium_20to100ms: 0,
        bin_slow_gt100ms: 0,
        total_spikes: 0
    };
}

pub fn isi_accumulate_interval(hist: &ISIHistogram5, isi_ms: Float) -> ISIHistogram5 {
    let mut b0 = (hist).bin_refractory_lt2ms;
    let mut b1 = (hist).bin_burst_2to5ms;
    let mut b2 = (hist).bin_fast_5to20ms;
    let mut b3 = (hist).bin_medium_20to100ms;
    let mut b4 = (hist).bin_slow_gt100ms;
    let total = (hist).total_spikes + 1;

    if isi_ms < 2.0 {
        b0 = b0 + 1;
    } else if isi_ms < 5.0 {
        b1 = b1 + 1;
    } else if isi_ms < 20.0 {
        b2 = b2 + 1;
    } else if isi_ms < 100.0 {
        b3 = b3 + 1;
    } else {
        b4 = b4 + 1;
    }

    return ISIHistogram5 {
        bin_refractory_lt2ms: b0,
        bin_burst_2to5ms: b1,
        bin_fast_5to20ms: b2,
        bin_medium_20to100ms: b3,
        bin_slow_gt100ms: b4,
        total_spikes: total
    };
}

pub fn isi_evaluate_isolation_quality(hist: &ISIHistogram5) -> UnitIsolationQuality {
    let total = (hist).total_spikes;
    if total <= 0 {
        return UnitIsolationQuality {
            refractory_violation_pct: 0.0,
            burst_index_pct: 0.0,
            is_clean_single_unit: false
        };
    }

    let viol_pct = (((hist).bin_refractory_lt2ms as Float) * 100.0) / (total as Float);
    let burst_pct = (((hist).bin_burst_2to5ms as Float) * 100.0) / (total as Float);

    // Standard electrophysiology threshold: <0.5% refractory violations indicates clean single-unit isolation
    let is_clean = viol_pct < 0.5;

    return UnitIsolationQuality {
        refractory_violation_pct: viol_pct,
        burst_index_pct: burst_pct,
        is_clean_single_unit: is_clean
    };
}
