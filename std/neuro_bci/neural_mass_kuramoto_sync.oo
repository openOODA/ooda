// # Kuramoto Phase Oscillator Network Synchronization
//
// Logline: Simulates macroscopic phase coherence, collective synchronization transitions, and order parameters in coupled neural oscillators.
//
// Setup: Nonlinear coupled phase oscillator network modeling large-scale brain rhythm binding and functional connectivity.
//
// Beats:
//   1. Define KuramotoNetwork4 (4-oscillator coupled ensemble with phases theta and natural frequencies omega).
//   2. Compute Kuramoto complex order parameter R * exp(i*psi) characterizing phase synchronization [0 = incoherent, 1 = locked].
//   3. Step oscillator phases forward with sinusoidal pairwise interaction coupling K.

pub type KuramotoNetwork4 = struct {
    theta0: Float, theta1: Float, theta2: Float, theta3: Float,
    omega0: Float, omega1: Float, omega2: Float, omega3: Float,
    coupling_k: Float,
};

pub type KuramotoOrderParameter = struct {
    coherence_r: Float,  // Coherence magnitude R in [0, 1]
    mean_phase_psi: Float, // Mean phase psi in [-pi, pi]
};

pub fn kuramoto_network4_default(coupling: Float) -> KuramotoNetwork4 {
    return KuramotoNetwork4 {
        theta0: 0.0,
        theta1: 0.5,
        theta2: 1.0,
        theta3: 1.5,
        omega0: 6.28318 * 10.0, // 10 Hz alpha
        omega1: 6.28318 * 10.2,
        omega2: 6.28318 * 9.8,
        omega3: 6.28318 * 10.1,
        coupling_k: coupling,
    };
}

pub fn kuramoto_compute_order_parameter(net: &KuramotoNetwork4) -> KuramotoOrderParameter {
    let cos_sum = cos((net).theta0) + cos((net).theta1) + cos((net).theta2) + cos((net).theta3);
    let sin_sum = sin((net).theta0) + sin((net).theta1) + sin((net).theta2) + sin((net).theta3);

    let cos_avg = cos_sum / 4.0;
    let sin_avg = sin_sum / 4.0;

    let r_sq = (cos_avg * cos_avg) + (sin_avg * sin_avg);
    let r_val = sqrt(r_sq);

    // Approximate phase angle
    let psi_val = if cos_avg != 0.0 { sin_avg / cos_avg } else { 0.0 };

    return KuramotoOrderParameter {
        coherence_r: if r_val > 1.0 { 1.0 } else { r_val },
        mean_phase_psi: psi_val,
    };
}

pub fn kuramoto_step4(net: &KuramotoNetwork4, dt_sec: Float) -> KuramotoNetwork4 {
    let k_n = (net).coupling_k / 4.0;

    let t0 = (net).theta0;
    let t1 = (net).theta1;
    let t2 = (net).theta2;
    let t3 = (net).theta3;

    let dth0 = (net).omega0 + (k_n * (sin(t0 - t0) + sin(t1 - t0) + sin(t2 - t0) + sin(t3 - t0)));
    let dth1 = (net).omega1 + (k_n * (sin(t0 - t1) + sin(t1 - t1) + sin(t2 - t1) + sin(t3 - t1)));
    let dth2 = (net).omega2 + (k_n * (sin(t0 - t2) + sin(t1 - t2) + sin(t2 - t2) + sin(t3 - t2)));
    let dth3 = (net).omega3 + (k_n * (sin(t0 - t3) + sin(t1 - t3) + sin(t2 - t3) + sin(t3 - t3)));

    return KuramotoNetwork4 {
        theta0: t0 + (dth0 * dt_sec),
        theta1: t1 + (dth1 * dt_sec),
        theta2: t2 + (dth2 * dt_sec),
        theta3: t3 + (dth3 * dt_sec),
        omega0: (net).omega0,
        omega1: (net).omega1,
        omega2: (net).omega2,
        omega3: (net).omega3,
        coupling_k: (net).coupling_k,
    };
}
