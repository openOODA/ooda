// # Unsupervised BCI Covariate Shift & Baseline Drift Tracker
//
// Logline: Tracks non-stationary EEG baseline shifts and impedance drift via online exponential moving mean and variance updates.
//
// Setup: Online adaptive standardization normalizer mitigating inter-session non-stationarity in neural interfaces.
//
// Beats:
//   1. Define DriftTracker2D (running means and variances for 2 sensor feature dimensions).
//   2. Update running statistics with forgetting factor alpha to track slow physiological drift.
//   3. Compute normalized z-score feature outputs: z = (x - mu) / sigma.

pub type DriftTracker2D = struct {
    mean1: Float,
    mean2: Float,
    var1: Float,
    var2: Float,
    alpha_learning_rate: Float
};

pub type NormalizedFeatures2D = struct {
    z1: Float,
    z2: Float
};

pub type DriftUpdateResult = struct {
    next_tracker: DriftTracker2D,
    normalized: NormalizedFeatures2D
};

pub fn drift_tracker_default(alpha: Float) -> DriftTracker2D {
    return DriftTracker2D {
        mean1: 0.0,
        mean2: 0.0,
        var1: 1.0,
        var2: 1.0,
        alpha_learning_rate: if alpha <= 0.0 { 0.01 } else { alpha }
    };
}

pub fn drift_tracker_update(
    tracker: &DriftTracker2D,
    raw1: Float,
    raw2: Float
) -> DriftUpdateResult {
    let a = (tracker).alpha_learning_rate;

    let d1 = raw1 - (tracker).mean1;
    let d2 = raw2 - (tracker).mean2;

    let new_mean1 = (tracker).mean1 + (a * d1);
    let new_mean2 = (tracker).mean2 + (a * d2);

    let new_var1 = ((1.0 - a) * (tracker).var1) + (a * d1 * d1);
    let new_var2 = ((1.0 - a) * (tracker).var2) + (a * d2 * d2);

    let std1 = sqrt(if new_var1 < 0.000001 { 0.000001 } else { new_var1 });
    let std2 = sqrt(if new_var2 < 0.000001 { 0.000001 } else { new_var2 });

    let z_score1 = (raw1 - new_mean1) / std1;
    let z_score2 = (raw2 - new_mean2) / std2;

    return DriftUpdateResult {
        next_tracker: DriftTracker2D {
            mean1: new_mean1,
            mean2: new_mean2,
            var1: new_var1,
            var2: new_var2,
            alpha_learning_rate: a
        },
        normalized: NormalizedFeatures2D {
            z1: z_score1,
            z2: z_score2
        }
    };
}
