// # Izhikevich Simple Spiking Neuron Dynamics
//
// Logline: Simulates 2D quadratic integrate-and-fire dynamics reproducing mammalian cortical firing patterns.
//
// Setup: Dynamical systems neuron model balancing biological plausibility and computational efficiency.
//
// Beats:
//   1. Define IzhikevichState (v, u) and IzhikevichParams (a, b, c, d, v_thresh).
//   2. Provide standard cortical presets: Regular Spiking (RS), Fast Spiking (FS), Intrinsically Bursting (IB), Chattering (CH).
//   3. Advance continuous dynamics and handle discontinuous post-spike voltage/recovery variable reset.

pub type IzhikevichParams = struct {
    a: Float,         // Time scale of recovery variable u
    b: Float,         // Sensitivity of recovery variable u to subthreshold fluctuations
    c: Float,         // After-spike reset value of membrane potential v (mV)
    d: Float,         // After-spike reset increment of recovery variable u
    v_thresh: Float,  // Spike detection threshold (default 30.0 mV)
};

pub type IzhikevichState = struct {
    v: Float,         // Membrane potential (mV)
    u: Float,         // Membrane recovery variable
    spiked: Bool,     // Indicator if a spike occurred in the current step
};

pub fn izhikevich_params_regular_spiking() -> IzhikevichParams {
    return IzhikevichParams {
        a: 0.02,
        b: 0.2,
        c: 0.0 - 65.0,
        d: 8.0,
        v_thresh: 30.0,
    };
}

pub fn izhikevich_params_fast_spiking() -> IzhikevichParams {
    return IzhikevichParams {
        a: 0.1,
        b: 0.2,
        c: 0.0 - 65.0,
        d: 2.0,
        v_thresh: 30.0,
    };
}

pub fn izhikevich_params_intrinsically_bursting() -> IzhikevichParams {
    return IzhikevichParams {
        a: 0.02,
        b: 0.2,
        c: 0.0 - 55.0,
        d: 4.0,
        v_thresh: 30.0,
    };
}

pub fn izhikevich_params_chattering() -> IzhikevichParams {
    return IzhikevichParams {
        a: 0.02,
        b: 0.2,
        c: 0.0 - 50.0,
        d: 2.0,
        v_thresh: 30.0,
    };
}

pub fn izhikevich_params_thalamocortical() -> IzhikevichParams {
    return IzhikevichParams {
        a: 0.02,
        b: 0.25,
        c: 0.0 - 65.0,
        d: 0.05,
        v_thresh: 30.0,
    };
}

pub fn izhikevich_state_initial(v0: Float, u0: Float) -> IzhikevichState {
    return IzhikevichState {
        v: v0,
        u: u0,
        spiked: false,
    };
}

pub fn izhikevich_step(state: &IzhikevichState, i_inj: Float, dt_ms: Float, params: &IzhikevichParams) -> IzhikevichState {
    let mut v_curr = (state).v;
    let mut u_curr = (state).u;

    if v_curr >= (params).v_thresh {
        v_curr = (params).c;
        u_curr = u_curr + (params).d;
    }

    // Two half-steps for numerical stability of quadratic term
    let half_dt = dt_ms * 0.5;
    let dv1 = ((0.04 * v_curr * v_curr) + (5.0 * v_curr) + 140.0 - u_curr + i_inj) * half_dt;
    v_curr = v_curr + dv1;
    let dv2 = ((0.04 * v_curr * v_curr) + (5.0 * v_curr) + 140.0 - u_curr + i_inj) * half_dt;
    v_curr = v_curr + dv2;

    let du = (params).a * (((params).b * v_curr) - u_curr) * dt_ms;
    u_curr = u_curr + du;

    let has_spiked = v_curr >= (params).v_thresh;

    return IzhikevichState {
        v: v_curr,
        u: u_curr,
        spiked: has_spiked,
    };
}
