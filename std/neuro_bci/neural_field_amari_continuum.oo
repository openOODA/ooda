// # Amari Continuous Neural Field & Cortical Bump Attractor
//
// Logline: Simulates 1D continuous cortical spatial activity fields with Mexican-hat lateral inhibition and bump attractor memory states.
//
// Setup: Integro-differential neural field continuum equation modeling spatial pattern formation in sensory cortex.
//
// Beats:
//   1. Define AmariParams (tau_ms, resting_h, a_exc, sigma_exc, a_inh, sigma_inh, firing_threshold).
//   2. Compute Mexican-hat Difference-of-Gaussians (DoG) spatial interaction kernel w(distance).
//   3. Discretize spatial continuum into 5 spatial grid nodes and integrate activity bumps over time.

pub type AmariParams = struct {
    tau_ms: Float,          // Field membrane time constant (ms, default 10.0)
    resting_h: Float,       // Resting baseline potential (default -1.0)
    a_exc: Float,           // Excitatory kernel amplitude (default 2.0)
    sigma_exc: Float,       // Excitatory spatial spread (default 1.0)
    a_inh: Float,           // Inhibitory kernel amplitude (default 1.0)
    sigma_inh: Float,       // Inhibitory spatial spread (default 3.0)
    threshold: Float,       // Non-linear firing threshold (default 0.0)
};

pub type AmariField5 = struct {
    u0: Float, u1: Float, u2: Float, u3: Float, u4: Float,
};

pub fn amari_params_default() -> AmariParams {
    return AmariParams {
        tau_ms: 10.0,
        resting_h: 0.0 - 1.0,
        a_exc: 2.0,
        sigma_exc: 1.0,
        a_inh: 1.0,
        sigma_inh: 3.0,
        threshold: 0.0,
    };
}

pub fn amari_kernel_dog(dist: Float, params: &AmariParams) -> Float {
    // w(d) = A_exc * exp(-d^2 / 2*sig_e^2) - A_inh * exp(-d^2 / 2*sig_i^2)
    let d2 = dist * dist;
    let var_e = 2.0 * (params).sigma_exc * (params).sigma_exc;
    let var_i = 2.0 * (params).sigma_inh * (params).sigma_inh;

    let term_e = (params).a_exc * exp((0.0 - d2) / var_e);
    let term_i = (params).a_inh * exp((0.0 - d2) / var_i);

    return term_e - term_i;
}

pub fn amari_firing_rate(u: Float, threshold: Float) -> Float {
    if u > threshold {
        return 1.0;
    }
    return 0.0;
}

pub fn amari_step5(
    field: &AmariField5,
    stim0: Float, stim1: Float, stim2: Float, stim3: Float, stim4: Float,
    dt_ms: Float,
    params: &AmariParams
) -> AmariField5 {
    let f0 = amari_firing_rate((field).u0, (params).threshold);
    let f1 = amari_firing_rate((field).u1, (params).threshold);
    let f2 = amari_firing_rate((field).u2, (params).threshold);
    let f3 = amari_firing_rate((field).u3, (params).threshold);
    let f4 = amari_firing_rate((field).u4, (params).threshold);

    // Lateral interactions with spatial grid spacing dx = 1.0
    let w0 = amari_kernel_dog(0.0, params);
    let w1 = amari_kernel_dog(1.0, params);
    let w2 = amari_kernel_dog(2.0, params);
    let w3 = amari_kernel_dog(3.0, params);
    let w4 = amari_kernel_dog(4.0, params);

    let conv0 = (w0*f0) + (w1*f1) + (w2*f2) + (w3*f3) + (w4*f4);
    let conv1 = (w1*f0) + (w0*f1) + (w1*f2) + (w2*f3) + (w3*f4);
    let conv2 = (w2*f0) + (w1*f1) + (w0*f2) + (w1*f3) + (w2*f4);
    let conv3 = (w3*f0) + (w2*f1) + (w1*f2) + (w0*f3) + (w1*f4);
    let conv4 = (w4*f0) + (w3*f1) + (w2*f2) + (w1*f3) + (w0*f4);

    let du0 = ((0.0 - (field).u0) + conv0 + stim0 + (params).resting_h) / (params).tau_ms;
    let du1 = ((0.0 - (field).u1) + conv1 + stim1 + (params).resting_h) / (params).tau_ms;
    let du2 = ((0.0 - (field).u2) + conv2 + stim2 + (params).resting_h) / (params).tau_ms;
    let du3 = ((0.0 - (field).u3) + conv3 + stim3 + (params).resting_h) / (params).tau_ms;
    let du4 = ((0.0 - (field).u4) + conv4 + stim4 + (params).resting_h) / (params).tau_ms;

    return AmariField5 {
        u0: (field).u0 + (du0 * dt_ms),
        u1: (field).u1 + (du1 * dt_ms),
        u2: (field).u2 + (du2 * dt_ms),
        u3: (field).u3 + (du3 * dt_ms),
        u4: (field).u4 + (du4 * dt_ms),
    };
}
