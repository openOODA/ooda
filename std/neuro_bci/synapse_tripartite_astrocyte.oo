// # Tripartite Synapse Astrocyte Gliotransmission
//
// Logline: Models astrocyte calcium transients, IP3 signaling, and gliotransmitter-mediated synaptic gain modulation.
//
// Setup: Neuron-glia interaction engine simulating slow astrocytic feedback on tripartite synaptic transmission.
//
// Beats:
//   1. Define AstrocyteParams (tau_ca_ms, ca_rest_um, ca_thresh_um, ip3_prod_rate, gliotransmitter_gain).
//   2. Integrate cytosolic astrocytic Ca2+ concentration driven by presynaptic spike activity.
//   3. Compute gliotransmitter release and multiplicative modulation factor eta for synaptic efficacy.

pub type AstrocyteParams = struct {
    tau_ca_ms: Float,          // Intracellular Ca2+ clearance time constant (ms, default 1500.0)
    ca_rest_um: Float,         // Resting Ca2+ concentration (uM, default 0.1)
    ca_thresh_um: Float,       // Threshold Ca2+ for gliotransmitter vesicle release (uM, default 0.3)
    ca_spike_inc_um: Float,    // Ca2+ increment per presynaptic burst event (uM, default 0.08)
    gliotransmitter_gain: Float,// Potentiation gain factor (default 0.25)
};

pub type AstrocyteState = struct {
    ca_cytosol_um: Float,
    gliotransmitter_conc_um: Float,
};

pub fn astrocyte_params_default() -> AstrocyteParams {
    return AstrocyteParams {
        tau_ca_ms: 1500.0,
        ca_rest_um: 0.1,
        ca_thresh_um: 0.3,
        ca_spike_inc_um: 0.08,
        gliotransmitter_gain: 0.25,
    };
}

pub fn astrocyte_state_initial(params: &AstrocyteParams) -> AstrocyteState {
    return AstrocyteState {
        ca_cytosol_um: (params).ca_rest_um,
        gliotransmitter_conc_um: 0.0,
    };
}

pub fn astrocyte_step(state: &AstrocyteState, pre_spike_count: Int, dt_ms: Float, params: &AstrocyteParams) -> AstrocyteState {
    let mut ca = (state).ca_cytosol_um;

    // Decay toward resting baseline
    let dca = (0.0 - (ca - (params).ca_rest_um)) / (params).tau_ca_ms;
    ca = ca + (dca * dt_ms);

    // Activity-dependent influx
    if pre_spike_count > 0 {
        ca = ca + ((params).ca_spike_inc_um * (pre_spike_count * 1.0));
    }

    // Gliotransmitter release above threshold
    let mut glio = 0.0;
    if ca > (params).ca_thresh_um {
        glio = (ca - (params).ca_thresh_um) * 0.5;
    }

    return AstrocyteState {
        ca_cytosol_um: ca,
        gliotransmitter_conc_um: glio,
    };
}

pub fn astrocyte_compute_synaptic_multiplier(state: &AstrocyteState, params: &AstrocyteParams) -> Float {
    // Multiplier = 1.0 + (gain * [Glio])
    let glio = (state).gliotransmitter_conc_um;
    return 1.0 + ((params).gliotransmitter_gain * glio);
}
