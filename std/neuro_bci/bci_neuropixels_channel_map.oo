// # Neuropixels Silicon Probe Channel Geometry Mapping
//
// Logline: Maps Neuropixels high-density CMOS probe channel indices and bank selectors to micron-scale physical (x, y) coordinates.
//
// Setup: Geometric coordinate translator for laminar dense silicon multi-electrode arrays.
//
// Beats:
//   1. Define NeuropixelsSite (channel_id, shank_id, bank_id, x_um, y_um, is_reference).
//   2. Compute staggered checkerboard electrode coordinates (20 um vertical pitch, 32 um horizontal pitch).
//   3. Calculate pairwise Euclidean distance between probe recording sites for spatial clustering.

pub type NeuropixelsSite = struct {
    channel_id: Int,   // Acquisition channel [0..383]
    shank_id: Int,     // Shank index (0 for NP 1.0, 0..3 for NP 2.0 4-shank)
    bank_id: Int,      // Bank index [0..2]
    x_um: Float,       // Horizontal position on shank in microns
    y_um: Float,       // Depth from tip in microns
    is_reference: Bool
};

pub fn neuropixels_map_channel_1_0(channel_id: Int, bank_id: Int) -> NeuropixelsSite {
    // Physical site index = channel_id + (bank_id * 384)
    let site_idx = channel_id + (bank_id * 384);

    // Staggered pattern on NP 1.0: 4 columns at x = 11, 27, 43, 59 um
    // Vertical row = site_idx / 2, vertical pitch = 20 um
    let row: Int = site_idx / 2;
    let col_mod: Int = site_idx % 4;

    let mut x_pos = 11.0;
    if col_mod == 1 {
        x_pos = 59.0;
    } else if col_mod == 2 {
        x_pos = 27.0;
    } else if col_mod == 3 {
        x_pos = 43.0;
    }

    let y_pos: Float = ((row as Float) * 20.0);

    return NeuropixelsSite {
        channel_id: channel_id,
        shank_id: 0,
        bank_id: bank_id,
        x_um: x_pos,
        y_um: y_pos,
        is_reference: channel_id == 191 // Channel 191 is internal tip reference
    };
}

pub fn neuropixels_site_distance_um(site_a: &NeuropixelsSite, site_b: &NeuropixelsSite) -> Float {
    let dx = (site_a).x_um - (site_b).x_um;
    let dy = (site_a).y_um - (site_b).y_um;
    let dist_sq = (dx * dx) + (dy * dy);
    return sqrt(dist_sq);
}
