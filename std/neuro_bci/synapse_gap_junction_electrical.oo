// # Electrical Synapse Gap Junction Dynamics
//
// Logline: Simulates bidirectional electrotonic coupling, transjunctional voltage gradients, and connexon rectification.
//
// Setup: Direct intercellular channel model enabling ultrafast neuronal synchronization and subthreshold coupling.
//
// Beats:
//   1. Define GapJunctionParams (g_max, g_min, v0_half_mv, slope_factor_a, is_rectifying).
//   2. Compute transjunctional voltage difference V_j = V_pre - V_post.
//   3. Calculate symmetric and rectifying non-linear coupling currents I_gap.

pub type GapJunctionParams = struct {
    g_max: Float,          // Maximum electrical conductance (nS, default 2.0)
    g_min: Float,          // Residual minimum conductance (nS, default 0.2)
    v0_half_mv: Float,     // Half-inactivation transjunctional voltage (mV, default 30.0)
    slope_factor_a: Float, // Voltage sensitivity slope (1/mV, default 0.1)
    is_rectifying: Bool   // Flag for voltage-dependent connexin channel closure
};

pub type GapJunctionCurrents = struct {
    i_into_cell1: Float,
    i_into_cell2: Float
};

pub fn gap_junction_linear_default(g_conductance_ns: Float) -> GapJunctionParams {
    return GapJunctionParams {
        g_max: g_conductance_ns,
        g_min: g_conductance_ns,
        v0_half_mv: 30.0,
        slope_factor_a: 0.1,
        is_rectifying: false
    };
}

pub fn gap_junction_rectifying_default() -> GapJunctionParams {
    return GapJunctionParams {
        g_max: 5.0,
        g_min: 0.5,
        v0_half_mv: 25.0,
        slope_factor_a: 0.15,
        is_rectifying: true
    };
}

pub fn gap_junction_conductance(v_cell1: Float, v_cell2: Float, params: &GapJunctionParams) -> Float {
    if !(params).is_rectifying {
        return (params).g_max;
    }
    let v_j = v_cell1 - v_cell2;
    let abs_v_j = if v_j < 0.0 { 0.0 - v_j } else { v_j };
    let exp_term = exp((params).slope_factor_a * (abs_v_j - (params).v0_half_mv));
    let g_range = (params).g_max - (params).g_min;
    return (g_range / (1.0 + exp_term)) + (params).g_min;
}

pub fn gap_junction_compute_currents(v_cell1: Float, v_cell2: Float, params: &GapJunctionParams) -> GapJunctionCurrents {
    let g = gap_junction_conductance(v_cell1, v_cell2, params);
    // Current flowing from cell 2 into cell 1: I1 = g * (V2 - V1)
    let i1 = g * (v_cell2 - v_cell1);
    let i2 = 0.0 - i1;

    return GapJunctionCurrents {
        i_into_cell1: i1,
        i_into_cell2: i2
    };
}
