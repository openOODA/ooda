// # Jansen-Rit Cortical Neural Mass Model
//
// Logline: Simulates macroscopic EEG alpha rhythms and epileptiform spikes via coupled 2nd-order synaptic impulse responses.
//
// Setup: Canonical 6-state neural mass model parameterizing pyramidal, excitatory, and inhibitory interneuron populations.
//
// Beats:
//   1. Define JansenRitParams (a_epsp, a_inv, b_ipsp, b_inv, c_conn, nu_max, v0, r_slope).
//   2. Model linear 2nd-order differential operators for post-synaptic potential (PSP) convolution.
//   3. Compute EEG lead field projection V_eeg = y1 - y2 (pyramidal excitatory minus inhibitory membrane potential).

pub type JansenRitParams = struct {
    a_amplitude: Float, // Excitatory synaptic gain A (mV, default 3.25)
    a_rate: Float,      // Excitatory decay rate a (1/s, default 100.0)
    b_amplitude: Float, // Inhibitory synaptic gain B (mV, default 22.0)
    b_rate: Float,      // Inhibitory decay rate b (1/s, default 50.0)
    c_base: Float,      // Base connectivity constant C (default 135.0)
    nu_max: Float,      // Maximum firing rate (1/s, default 5.0)
    v0_threshold: Float,// Half-activation threshold (mV, default 6.0)
    r_slope: Float,     // Sigmoid steepness (1/mV, default 0.56)
};

pub type JansenRitState = struct {
    y0: Float, // Pyramidal EPSP output (mV)
    y1: Float, // Excitatory feedback PSP (mV)
    y2: Float, // Inhibitory feedback PSP (mV)
    y3: Float, // Derivative dy0/dt
    y4: Float, // Derivative dy1/dt
    y5: Float, // Derivative dy5/dt
};

pub fn jansen_rit_params_default() -> JansenRitParams {
    return JansenRitParams {
        a_amplitude: 3.25,
        a_rate: 100.0,
        b_amplitude: 22.0,
        b_rate: 50.0,
        c_base: 135.0,
        nu_max: 5.0,
        v0_threshold: 6.0,
        r_slope: 0.56,
    };
}

pub fn jansen_rit_state_initial() -> JansenRitState {
    return JansenRitState {
        y0: 0.0, y1: 0.0, y2: 0.0,
        y3: 0.0, y4: 0.0, y5: 0.0,
    };
}

pub fn jansen_rit_sigmoid(v: Float, params: &JansenRitParams) -> Float {
    let exp_term = exp((params).r_slope * ((params).v0_threshold - v));
    return (2.0 * (params).nu_max) / (1.0 + exp_term);
}

pub fn jansen_rit_step(
    state: &JansenRitState,
    p_input: Float,
    dt_sec: Float,
    params: &JansenRitParams
) -> JansenRitState {
    let a_val = (params).a_rate;
    let b_val = (params).b_rate;
    let a_gain = (params).a_amplitude;
    let b_gain = (params).b_amplitude;
    let c = (params).c_base;

    let c1 = c;
    let c2 = 0.8 * c;
    let c3 = 0.25 * c;
    let c4 = 0.25 * c;

    let sig_pyr = jansen_rit_sigmoid((state).y1 - (state).y2, params);
    let sig_exc = jansen_rit_sigmoid(c1 * (state).y0, params);
    let sig_inh = jansen_rit_sigmoid(c3 * (state).y0, params);

    // dy0/dt = y3, dy3/dt = A*a*S(y1 - y2) - 2*a*y3 - a^2*y0
    let dy0 = (state).y3;
    let dy3 = (a_gain * a_val * sig_pyr) - (2.0 * a_val * (state).y3) - (a_val * a_val * (state).y0);

    // dy1/dt = y4, dy4/dt = A*a*(p + C2*S(C1*y0)) - 2*a*y4 - a^2*y1
    let dy1 = (state).y4;
    let dy4 = (a_gain * a_val * (p_input + (c2 * sig_exc))) - (2.0 * a_val * (state).y4) - (a_val * a_val * (state).y1);

    // dy2/dt = y5, dy5/dt = B*b*(C4*S(C3*y0)) - 2*b*y5 - b^2*y2
    let dy2 = (state).y5;
    let dy5 = (b_gain * b_val * (c4 * sig_inh)) - (2.0 * b_val * (state).y5) - (b_val * b_val * (state).y2);

    return JansenRitState {
        y0: (state).y0 + (dy0 * dt_sec),
        y1: (state).y1 + (dy1 * dt_sec),
        y2: (state).y2 + (dy2 * dt_sec),
        y3: (state).y3 + (dy3 * dt_sec),
        y4: (state).y4 + (dy4 * dt_sec),
        y5: (state).y5 + (dy5 * dt_sec),
    };
}

pub fn jansen_rit_eeg_output(state: &JansenRitState) -> Float {
    return (state).y1 - (state).y2;
}
