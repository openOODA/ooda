// # Leaky Integrate-and-Fire (LIF) Neuron Model
//
// Logline: Simulates linear RC membrane potential charging with absolute refractory period and threshold reset.
//
// Setup: Canonical point-neuron model for large-scale spiking neural networks and neuromorphic architectures.
//
// Beats:
//   1. Define LIFParams (tau_m, v_rest, v_reset, v_thresh, r_membrane, t_refractory).
//   2. Track membrane potential and refractory countdown timer.
//   3. Integrate subthreshold potential, detect threshold crossing, and output binary spike events.

pub type LIFParams = struct {
    tau_m: Float,         // Membrane time constant (ms, default 20.0)
    v_rest: Float,        // Resting potential (mV, default -70.0)
    v_reset: Float,       // Post-spike reset potential (mV, default -75.0)
    v_thresh: Float,      // Action potential firing threshold (mV, default -50.0)
    r_membrane: Float,    // Membrane input resistance (MOhm, default 10.0)
    t_refractory: Float  // Absolute refractory duration (ms, default 2.0)
};

pub type LIFState = struct {
    v: Float,             // Current membrane potential (mV)
    refractory_timer: Float, // Time remaining in refractory period (ms)
    spiked: Bool         // Firing indicator for current time step
};

pub fn lif_params_default() -> LIFParams {
    return LIFParams {
        tau_m: 20.0,
        v_rest: 0.0 - 70.0,
        v_reset: 0.0 - 75.0,
        v_thresh: 0.0 - 50.0,
        r_membrane: 10.0,
        t_refractory: 2.0
    };
}

pub fn lif_state_initial(v_init: Float) -> LIFState {
    return LIFState {
        v: v_init,
        refractory_timer: 0.0,
        spiked: false
    };
}

pub fn lif_analytical_steady_state(i_inj: Float, params: &LIFParams) -> Float {
    return (params).v_rest + ((params).r_membrane * i_inj);
}

pub fn lif_step(state: &LIFState, i_inj: Float, dt_ms: Float, params: &LIFParams) -> LIFState {
    let mut timer = (state).refractory_timer;
    let mut v_curr = (state).v;
    let mut has_spiked = false;

    if timer > 0.0 {
        timer = timer - dt_ms;
        if timer < 0.0 { timer = 0.0; }
        v_curr = (params).v_reset;
    } else {
        // dV/dt = (-(V - V_rest) + R_m * I) / tau_m
        let dv = ((0.0 - (v_curr - (params).v_rest)) + ((params).r_membrane * i_inj)) / (params).tau_m;
        v_curr = v_curr + (dv * dt_ms);

        if v_curr >= (params).v_thresh {
            has_spiked = true;
            v_curr = (params).v_reset;
            timer = (params).t_refractory;
        }
    }

    return LIFState {
        v: v_curr,
        refractory_timer: timer,
        spiked: has_spiked
    };
}

pub fn lif_firing_rate_constant_current(i_inj: Float, params: &LIFParams) -> Float {
    let v_inf = lif_analytical_steady_state(i_inj, params);
    if v_inf <= (params).v_thresh {
        return 0.0;
    }
    let num = v_inf - (params).v_reset;
    let den = v_inf - (params).v_thresh;
    if den <= 0.0 { return 0.0; }
    let ratio = num / den;
    let t_isi = (params).t_refractory + ((params).tau_m * (if ratio > 1.0 { ratio - 1.0 } else { 0.0 }));
    if t_isi <= 0.0 { return 0.0; }
    return 1000.0 / t_isi; // Spikes per second (Hz)
}
