// # Notch Filter for 50Hz / 60Hz Powerline Interference
//
// Logline: Suppresses AC powerline hum artifacts using a high-Q 2nd-order IIR digital notch filter.
//
// Setup: Narrow-band notch filter placing complex conjugate zeros directly on the unit circle at line frequency.
//
// Beats:
//   1. Define NotchCoeffs (b0, b1, b2, a1, a2) and NotchFilterState (d1, d2).
//   2. Design standard notch filters for 50 Hz (EU/Asia) and 60 Hz (US) at standard BCI sampling rates (250 Hz, 500 Hz, 1000 Hz).
//   3. Filter incoming electrophysiological potential stream with zero DC attenuation.

pub type NotchCoeffs = struct {
    b0: Float,
    b1: Float,
    b2: Float,
    a1: Float,
    a2: Float
};

pub type NotchFilterState = struct {
    d1: Float,
    d2: Float
};

pub fn notch_state_zero() -> NotchFilterState {
    return NotchFilterState {
        d1: 0.0,
        d2: 0.0
    };
}

pub fn notch_design_50hz_fs250() -> NotchCoeffs {
    // f0 = 50 Hz, Fs = 250 Hz, w0 = 2*pi*50/250 = 0.4*pi = 1.256637
    // cos(w0) = 0.309017, r = 0.95 -> a2 = r^2 = 0.9025
    // b0 = (1 + r^2)/2 = 0.95125, b1 = -2*cos(w0)*b0, b2 = b0
    // a1 = -2*r*cos(w0) = -0.58713
    return NotchCoeffs {
        b0: 0.95125,
        b1: 0.0 - 0.58793,
        b2: 0.95125,
        a1: 0.0 - 0.58713,
        a2: 0.90250
    };
}

pub fn notch_design_60hz_fs250() -> NotchCoeffs {
    // f0 = 60 Hz, Fs = 250 Hz, w0 = 2*pi*60/250 = 0.48*pi = 1.507964
    // cos(w0) = 0.06279, r = 0.95 -> a2 = 0.9025
    // b0 = 0.95125, b1 = -2*cos(w0)*b0 = -0.11946, b2 = b0
    // a1 = -2*r*cos(w0) = -0.11930
    return NotchCoeffs {
        b0: 0.95125,
        b1: 0.0 - 0.11946,
        b2: 0.95125,
        a1: 0.0 - 0.11930,
        a2: 0.90250
    };
}

pub fn notch_design_50hz_fs500() -> NotchCoeffs {
    // f0 = 50 Hz, Fs = 500 Hz, w0 = 2*pi*50/500 = 0.2*pi = 0.6283185
    // cos(w0) = 0.809017, r = 0.97 -> a2 = 0.9409
    // b0 = (1+r^2)/2 = 0.97045, b1 = -2*cos(w0)*b0 = -1.57016, b2 = b0
    // a1 = -2*r*cos(w0) = -1.56949
    return NotchCoeffs {
        b0: 0.97045,
        b1: 0.0 - 1.57016,
        b2: 0.97045,
        a1: 0.0 - 1.56949,
        a2: 0.94090
    };
}

pub fn notch_design_60hz_fs500() -> NotchCoeffs {
    // f0 = 60 Hz, Fs = 500 Hz, w0 = 2*pi*60/500 = 0.24*pi = 0.75398
    // cos(w0) = 0.728968, r = 0.97 -> a2 = 0.9409
    // b0 = 0.97045, b1 = -2*cos(w0)*b0 = -1.41484, b2 = b0
    // a1 = -2*r*cos(w0) = -1.41419
    return NotchCoeffs {
        b0: 0.97045,
        b1: 0.0 - 1.41484,
        b2: 0.97045,
        a1: 0.0 - 1.41419,
        a2: 0.94090
    };
}

pub type NotchStepResult = struct {
    next_state: NotchFilterState,
    filtered_output: Float
};

pub fn notch_filter_sample(
    x: Float,
    state: &NotchFilterState,
    coeffs: &NotchCoeffs
) -> NotchStepResult {
    let y = ((coeffs).b0 * x) + (state).d1;
    let next_d1 = (((coeffs).b1 * x) - ((coeffs).a1 * y)) + (state).d2;
    let next_d2 = ((coeffs).b2 * x) - ((coeffs).a2 * y);

    return NotchStepResult {
        next_state: NotchFilterState {
            d1: next_d1,
            d2: next_d2
        },
        filtered_output: y
    };
}
