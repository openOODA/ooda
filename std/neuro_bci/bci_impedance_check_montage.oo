// # EEG Electrode Impedance Telemetry & 10-20 Montage Checker
//
// Logline: Validates skin-electrode contact impedance levels across international 10-20 EEG montage channels.
//
// Setup: Pre-flight signal quality verification engine testing 1 kHz AC test current electrode impedance.
//
// Beats:
//   1. Define ElectrodeImpedance (channel_name, impedance_kohm, status_code).
//   2. Classify electrode contact impedance quality (Good: <5 kOhm, Acceptable: 5-20 kOhm, Poor: 20-50 kOhm, Disconnected: >50 kOhm).
//   3. Validate 4-channel montage impedance balance for clinical and BCI recording protocols.

pub type ElectrodeImpedance = struct {
    channel_id: Int,
    impedance_kohm: Float,
    is_good: Bool,
    is_acceptable: Bool
};

pub type MontageQualityReport = struct {
    mean_impedance_kohm: Float,
    max_impedance_kohm: Float,
    all_channels_pass: Bool,
    failed_channel_count: Int
};

pub fn impedance_check_single_channel(channel_id: Int, z_kohm: Float) -> ElectrodeImpedance {
    let good = z_kohm < 5.0 && z_kohm > 0.1;
    let acceptable = z_kohm < 20.0 && z_kohm > 0.05;

    return ElectrodeImpedance {
        channel_id: channel_id,
        impedance_kohm: z_kohm,
        is_good: good,
        is_acceptable: acceptable
    };
}

pub fn montage_evaluate_4channels(
    z0: Float,
    z1: Float,
    z2: Float,
    z3: Float,
    max_allowed_kohm: Float
) -> MontageQualityReport {
    let sum = z0 + z1 + z2 + z3;
    let mean = sum * 0.25;

    let mut max_z = z0;
    if z1 > max_z { max_z = z1; }
    if z2 > max_z { max_z = z2; }
    if z3 > max_z { max_z = z3; }

    let mut failed = 0;
    if z0 > max_allowed_kohm { failed = failed + 1; }
    if z1 > max_allowed_kohm { failed = failed + 1; }
    if z2 > max_allowed_kohm { failed = failed + 1; }
    if z3 > max_allowed_kohm { failed = failed + 1; }

    return MontageQualityReport {
        mean_impedance_kohm: mean,
        max_impedance_kohm: max_z,
        all_channels_pass: failed == 0,
        failed_channel_count: failed
    };
}
