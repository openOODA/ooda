// # Spike Train Cross-Correlogram & Fano Factor Statistics
//
// Logline: Computes temporal cross-correlations, synchrony lag distributions, Fano factor, and coefficient of variation (CV).
//
// Setup: Statistical analysis module for point-process spike train pairs and regularity quantification.
//
// Beats:
//   1. Define CrossCorrelogram5 (discrete lag counts: -2dt, -dt, 0, +dt, +2dt).
//   2. Compute pairwise inter-spike lag histogram between reference and target spike events.
//   3. Calculate Fano Factor (Var[N]/E[N]) and coefficient of variation (CV_ISI) to quantify Poisson firing variability.

pub type CrossCorrelogram5 = struct {
    lag_neg2: Int,
    lag_neg1: Int,
    lag_zero: Int,
    lag_pos1: Int,
    lag_pos2: Int,
    total_pairs: Int
};

pub type SpikeVariabilityStats = struct {
    fano_factor: Float,       // Var(count) / Mean(count), 1.0 = Poisson
    cv_isi: Float,            // std(ISI) / mean(ISI), 1.0 = Poisson, <1.0 = regular, >1.0 = bursting
    is_poisson_like: Bool
};

pub fn correlogram5_empty() -> CrossCorrelogram5 {
    return CrossCorrelogram5 {
        lag_neg2: 0,
        lag_neg1: 0,
        lag_zero: 0,
        lag_pos1: 0,
        lag_pos2: 0,
        total_pairs: 0
    };
}

pub fn correlogram_accumulate_pair(
    corr: &CrossCorrelogram5,
    t_ref_ms: Float,
    t_target_ms: Float,
    bin_width_ms: Float
) -> CrossCorrelogram5 {
    let dt = t_target_ms - t_ref_ms;
    let mut n2 = (corr).lag_neg2;
    let mut n1 = (corr).lag_neg1;
    let mut z0 = (corr).lag_zero;
    let mut p1 = (corr).lag_pos1;
    let mut p2 = (corr).lag_pos2;
    let mut total = (corr).total_pairs;

    let half_bin = bin_width_ms * 0.5;

    if dt >= (0.0 - half_bin) && dt < half_bin {
        z0 = z0 + 1;
        total = total + 1;
    } else if dt >= half_bin && dt < (1.5 * bin_width_ms) {
        p1 = p1 + 1;
        total = total + 1;
    } else if dt >= (1.5 * bin_width_ms) && dt < (2.5 * bin_width_ms) {
        p2 = p2 + 1;
        total = total + 1;
    } else if dt <= (0.0 - half_bin) && dt > (0.0 - (1.5 * bin_width_ms)) {
        n1 = n1 + 1;
        total = total + 1;
    } else if dt <= (0.0 - (1.5 * bin_width_ms)) && dt > (0.0 - (2.5 * bin_width_ms)) {
        n2 = n2 + 1;
        total = total + 1;
    }

    return CrossCorrelogram5 {
        lag_neg2: n2,
        lag_neg1: n1,
        lag_zero: z0,
        lag_pos1: p1,
        lag_pos2: p2,
        total_pairs: total
    };
}

pub fn spike_compute_variability_stats(
    mean_count: Float,
    var_count: Float,
    mean_isi_ms: Float,
    var_isi_ms: Float
) -> SpikeVariabilityStats {
    let ff = if mean_count <= 0.0 { 1.0 } else { var_count / mean_count };
    let std_isi = sqrt(if var_isi_ms < 0.0 { 0.0 } else { var_isi_ms });
    let cv = if mean_isi_ms <= 0.0 { 1.0 } else { std_isi / mean_isi_ms };

    let diff_ff = if ff > 1.0 { ff - 1.0 } else { 1.0 - ff };
    let diff_cv = if cv > 1.0 { cv - 1.0 } else { 1.0 - cv };
    let is_poisson = diff_ff < 0.25 && diff_cv < 0.25;

    return SpikeVariabilityStats {
        fano_factor: ff,
        cv_isi: cv,
        is_poisson_like: is_poisson
    };
}
