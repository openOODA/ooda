// # Morris-Lecar Conductance-Based Oscillator
//
// Logline: Simulates 2D nonlinear voltage-gated Ca2+ and K+ channel dynamics in excitable biological membranes.
//
// Setup: Biophysical oscillator model capturing Hopf and saddle-node on invariant circle (SNIC) bifurcations.
//
// Beats:
//   1. Define MLParams (c_m, g_ca, g_k, g_l, v_ca, v_k, v_l, v1, v2, v3, v4, phi).
//   2. Compute steady-state activation m_inf(V), w_inf(V), and voltage-dependent time scale tau_w(V).
//   3. Integrate state variables (V, w) under injected current stimulation.

pub type MLParams = struct {
    c_m: Float,    // Membrane capacitance (uF/cm^2, default 20.0)
    g_ca: Float,   // Ca2+ channel conductance (mS/cm^2, default 4.4)
    g_k: Float,    // K+ channel conductance (mS/cm^2, default 8.0)
    g_l: Float,    // Leak conductance (mS/cm^2, default 2.0)
    v_ca: Float,   // Ca2+ reversal potential (mV, default 120.0)
    v_k: Float,    // K+ reversal potential (mV, default -84.0)
    v_l: Float,    // Leak reversal potential (mV, default -60.0)
    v1: Float,     // Potential for Ca2+ half-activation (mV, default -1.2)
    v2: Float,     // Slope parameter for Ca2+ activation (mV, default 18.0)
    v3: Float,     // Potential for K+ half-activation (mV, default 2.0)
    v4: Float,     // Slope parameter for K+ activation (mV, default 30.0)
    phi: Float,    // Temperature / rate factor (1/s, default 0.04)
};

pub type MLState = struct {
    v: Float,      // Membrane potential (mV)
    w: Float,      // K+ channel activation variable [0, 1]
};

pub fn ml_params_default() -> MLParams {
    return MLParams {
        c_m: 20.0,
        g_ca: 4.4,
        g_k: 8.0,
        g_l: 2.0,
        v_ca: 120.0,
        v_k: 0.0 - 84.0,
        v_l: 0.0 - 60.0,
        v1: 0.0 - 1.2,
        v2: 18.0,
        v3: 2.0,
        v4: 30.0,
        phi: 0.04,
    };
}

pub fn ml_state_resting() -> MLState {
    return MLState {
        v: 0.0 - 60.0,
        w: 0.015,
    };
}

pub fn ml_m_inf(v: Float, params: &MLParams) -> Float {
    let arg = 2.0 * (v - (params).v1) / (params).v2;
    return 1.0 / (1.0 + exp(0.0 - arg));
}

pub fn ml_w_inf(v: Float, params: &MLParams) -> Float {
    let arg = 2.0 * (v - (params).v3) / (params).v4;
    return 1.0 / (1.0 + exp(0.0 - arg));
}

pub fn ml_tau_w(v: Float, params: &MLParams) -> Float {
    let arg = (v - (params).v3) / (2.0 * (params).v4);
    let cosh_val = 0.5 * (exp(arg) + exp(0.0 - arg));
    if cosh_val == 0.0 { return 1.0; }
    return 1.0 / cosh_val;
}

pub fn ml_step(state: &MLState, i_inj: Float, dt_ms: Float, params: &MLParams) -> MLState {
    let v_curr = (state).v;
    let w_curr = (state).w;

    let m_val = ml_m_inf(v_curr, params);
    let w_inf_val = ml_w_inf(v_curr, params);
    let tau_val = ml_tau_w(v_curr, params);

    let i_ca = (params).g_ca * m_val * (v_curr - (params).v_ca);
    let i_k = (params).g_k * w_curr * (v_curr - (params).v_k);
    let i_l = (params).g_l * (v_curr - (params).v_l);

    let dv = (i_inj - i_ca - i_k - i_l) / (params).c_m;
    let dw = (params).phi * (w_inf_val - w_curr) / (if tau_val <= 0.0 { 1.0 } else { tau_val });

    let mut next_w = w_curr + (dw * dt_ms);
    if next_w < 0.0 { next_w = 0.0; } else if next_w > 1.0 { next_w = 1.0; }

    return MLState {
        v: v_curr + (dv * dt_ms),
        w: next_w,
    };
}
