// # FitzHugh-Nagumo Excitable Dynamical System
//
// Logline: Models 2D cubic nullcline relaxation oscillations capturing biological excitability and threshold phenomena.
//
// Setup: Qualitative phase-plane reduction of Hodgkin-Huxley electrodynamics for fast action potential modeling.
//
// Beats:
//   1. Define FHNParams (a, b, epsilon, threshold) and FHNState (v, w).
//   2. Compute v-nullcline (cubic polynomial) and w-nullcline (linear recovery).
//   3. Integrate state trajectories using explicit Euler or Runge-Kutta steps.

pub type FHNParams = struct {
    a: Float,        // Threshold / resting parameter (default 0.7)
    b: Float,        // Recovery sensitivity parameter (default 0.8)
    epsilon: Float,  // Time scale separation ratio (tau_v / tau_w, default 0.08)
};

pub type FHNState = struct {
    v: Float,        // Fast membrane voltage variable
    w: Float,        // Slow recovery gating variable
};

pub type FHNDerivatives = struct {
    dv_dt: Float,
    dw_dt: Float,
};

pub fn fhn_params_default() -> FHNParams {
    return FHNParams {
        a: 0.7,
        b: 0.8,
        epsilon: 0.08,
    };
}

pub fn fhn_state_resting() -> FHNState {
    return FHNState {
        v: 0.0 - 1.1994,
        w: 0.0 - 0.6243,
    };
}

pub fn fhn_compute_derivatives(state: &FHNState, i_stim: Float, params: &FHNParams) -> FHNDerivatives {
    let v_val = (state).v;
    let w_val = (state).w;

    let dv = v_val - ((v_val * v_val * v_val) / 3.0) - w_val + i_stim;
    let dw = (params).epsilon * (v_val + (params).a - ((params).b * w_val));

    return FHNDerivatives {
        dv_dt: dv,
        dw_dt: dw,
    };
}

pub fn fhn_v_nullcline(v: Float, i_stim: Float) -> Float {
    return v - ((v * v * v) / 3.0) + i_stim;
}

pub fn fhn_w_nullcline(v: Float, params: &FHNParams) -> Float {
    if (params).b == 0.0 { return 0.0; }
    return (v + (params).a) / (params).b;
}

pub fn fhn_euler_step(state: &FHNState, i_stim: Float, dt: Float, params: &FHNParams) -> FHNState {
    let deriv = fhn_compute_derivatives(state, i_stim, params);
    return FHNState {
        v: (state).v + ((deriv).dv_dt * dt),
        w: (state).w + ((deriv).dw_dt * dt),
    };
}

pub fn fhn_is_excited(state: &FHNState, v_threshold: Float) -> Bool {
    return (state).v > v_threshold;
}
