// # BCI Multi-Grasp Prosthetic Hand State Machine
//
// Logline: Converts decoded motor intent into robust robotic prosthetic grasp postures (Rest, Power Grasp, Precision Pinch, Open).
//
// Setup: Finite state machine with debounce hysteresis governing motorized multi-articulating bionic hand actuators.
//
// Beats:
//   1. Define posture codes (0: Rest, 1: Power Grasp, 2: Precision Pinch, 3: Hand Open, 4: Point Finger).
//   2. Track current active posture, target command, and dwell transition timer.
//   3. Apply dwell hysteresis thresholds to prevent accidental grasp state jitter.

pub type ProstheticState = struct {
    current_posture: Int,     // 0: Rest, 1: Power, 2: Pinch, 3: Open, 4: Point
    dwell_counter: Int,       // Consecutive frames required for state change
    grip_force_percent: Float
};

pub type ProstheticControlResult = struct {
    next_state: ProstheticState,
    command_motor_position: Float, // Actuator target 0.0 (open) to 1.0 (closed)
    posture_changed: Bool
};

pub fn prosthetic_posture_rest() -> Int { return 0; }
pub fn prosthetic_posture_power() -> Int { return 1; }
pub fn prosthetic_posture_pinch() -> Int { return 2; }
pub fn prosthetic_posture_open() -> Int { return 3; }
pub fn prosthetic_posture_point() -> Int { return 4; }

pub fn prosthetic_state_default() -> ProstheticState {
    return ProstheticState {
        current_posture: 0,
        dwell_counter: 0,
        grip_force_percent: 0.0
    };
}

pub fn prosthetic_update_posture(
    state: &ProstheticState,
    intended_posture: Int,
    desired_force_pct: Float,
    dwell_threshold_frames: Int
) -> ProstheticControlResult {
    let curr = (state).current_posture;
    let mut dwell = (state).dwell_counter;
    let mut next_pos = curr;
    let mut changed = false;

    if intended_posture == curr {
        dwell = 0;
    } else {
        dwell = dwell + 1;
        if dwell >= dwell_threshold_frames {
            next_pos = intended_posture;
            dwell = 0;
            changed = true;
        }
    }

    // Determine actuator position based on active posture
    let mut motor_target = 0.0;
    if next_pos == 1 {
        motor_target = 1.0; // Full closure for power grasp
    } else if next_pos == 2 {
        motor_target = 0.6; // Partial closure for precision pinch
    } else if next_pos == 3 {
        motor_target = 0.0; // Open hand
    } else if next_pos == 4 {
        motor_target = 0.3; // Pointing finger
    }

    return ProstheticControlResult {
        next_state: ProstheticState {
            current_posture: next_pos,
            dwell_counter: dwell,
            grip_force_percent: desired_force_pct
        },
        command_motor_position: motor_target,
        posture_changed: changed
    };
}
