// # Unified Physics & Multi-Body Dynamics Facade
//
// Logline: Re-exports Particle System, Verlet, Euler, RK4, Rigid Body 2D/3D, Inertia, Manifolds, Impulses, Springs, Cloth, SPH Fluid, Aerodynamics, Buoyancy, N-Body, Orbits, Constraints, Ragdoll, and Stubs.
//
// Setup: Pure module shim and unified facade importing all 24 physics and dynamics companion submodules.
//
// Beats:
//   1. Import 24 modular Physics & Dynamics subcomponents.
//   2. Re-export public constructors, physical simulation records, and integration entry points.
//   3. Maintain full backwards compatibility with downstream openOODA physics callers.

import "./particle_system.oo";
import "./verlet_integrator.oo";
import "./euler_integrator.oo";
import "./rk4_integrator.oo";
import "./rigid_body_2d.oo";
import "./rigid_body_3d.oo";
import "./inertia_tensor.oo";
import "./contact_manifold.oo";
import "./impulse_solver.oo";
import "./spring_damper.oo";
import "./rope_simulation.oo";
import "./cloth_mesh.oo";
import "./soft_body_pressure.oo";
import "./sph_fluid_particle.oo";
import "./sph_fluid_density.oo";
import "./sph_fluid_viscosity.oo";
import "./aerodynamic_drag.oo";
import "./buoyancy_force.oo";
import "./gravitational_nbody.oo";
import "./orbital_mechanics_physics.oo";
import "./constraint_distance.oo";
import "./constraint_hinge.oo";
import "./ragdoll_skeleton.oo";
import "./physics_stubs.oo";

// -------------------------------------------------------------------
// Unified Physics World Facade
// -------------------------------------------------------------------

pub type PhysicsWorld2D = struct {
    gravity_y: Float,
    linear_damping: Float,
    angular_damping: Float,
    substeps: Int
};

pub type PhysicsWorld3D = struct {
    gravity_x: Float,
    gravity_y: Float,
    gravity_z: Float,
    linear_damping: Float,
    angular_damping: Float,
    substeps: Int
};

pub fn physics_world_2d_default() -> PhysicsWorld2D {
    return PhysicsWorld2D {
        gravity_y: -9.81,
        linear_damping: 0.999,
        angular_damping: 0.995,
        substeps: 8
    };
}

pub fn physics_world_3d_default() -> PhysicsWorld3D {
    return PhysicsWorld3D {
        gravity_x: 0.0,
        gravity_y: -9.81,
        gravity_z: 0.0,
        linear_damping: 0.999,
        angular_damping: 0.995,
        substeps: 8
    };
}

// -------------------------------------------------------------------
// Facade Convenience Shims
// -------------------------------------------------------------------

pub fn physics_create_particle(x: Float, y: Float, z: Float, mass: Float, radius: Float) -> ParticlePoint {
    return particle_point_new(x, y, z, mass, radius);
}

pub fn physics_create_rigid_body_2d(x: Float, y: Float, mass: Float, inertia: Float) -> RigidBody2D {
    return rigid_body_2d_new(x, y, mass, inertia);
}

pub fn physics_create_rigid_body_3d(
    px: Float, py: Float, pz: Float,
    mass: Float,
    ixx: Float, iyy: Float, izz: Float
) -> RigidBody3D {
    return rigid_body_3d_new(px, py, pz, mass, ixx, iyy, izz);
}

pub fn physics_create_sph_particle(x: Float, y: Float, z: Float, mass: Float, h: Float) -> SphParticle {
    return sph_particle_new(x, y, z, mass, h);
}

pub fn physics_create_spring_3d(k: Float, c: Float, rest_len: Float) -> SpringDamper3D {
    return spring_damper_3d_new(k, c, rest_len);
}

pub fn physics_create_distance_constraint(
    body_a: Int,
    body_b: Int,
    target_dist: Float,
    stiffness: Float
) -> DistanceConstraint {
    return distance_constraint_new(body_a, body_b, target_dist, stiffness);
}

pub fn physics_create_ragdoll_bone(
    bone_id: Int,
    parent_id: Int,
    px: Float, py: Float, pz: Float,
    mass: Float,
    length: Float
) -> RagdollBone {
    return ragdoll_bone_new(bone_id, parent_id, px, py, pz, mass, length);
}
