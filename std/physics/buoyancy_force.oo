// # Archimedes Buoyancy & Submerged Hydrostatic Mechanics
//
// Logline: Calculates submerged displacement volumes, water plane centroids, Archimedean buoyant uplift, and hydrodynamic damping.
//
// Setup: Hydrostatic Archimedean upward force models for floating and submerged geometric solids in liquid media.
//
// Beats:
//   1. Define FluidMedium, FloatingBody, and BuoyancyResult data structures.
//   2. Compute submerged depth and displacement fractions for spheres and rectangular volumes.
//   3. Evaluate upward Archimedes buoyant force (F_b = rho * V_submerged * g) and hydrodynamic drag.

pub type FluidMedium = struct {
    density: Float, // kg/m^3 (Water = 1000, Seawater = 1025)
    viscosity_drag: Float,
    surface_level_y: Float,
    gravity_y: Float,
};

pub type FloatingBody = struct {
    total_volume: Float,
    mass: Float,
    shape_type: Int, // 0 = Box, 1 = Sphere
    height: Float,   // Height or diameter
    width: Float,
    depth: Float,
};

pub type BuoyancyResult = struct {
    submerged_fraction: Float,
    submerged_volume: Float,
    buoyancy_force_y: Float,
    damping_force_x: Float,
    damping_force_y: Float,
    damping_force_z: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn fluid_medium_water(surface_y: Float) -> FluidMedium {
    return FluidMedium {
        density: 1000.0,
        viscosity_drag: 50.0,
        surface_level_y: surface_y,
        gravity_y: 9.81,
    };
}

pub fn floating_body_box(
    w: Float, h: Float, d: Float,
    mass: Float
) -> FloatingBody {
    return FloatingBody {
        total_volume: w * h * d,
        mass: mass,
        shape_type: 0,
        height: h,
        width: w,
        depth: d,
    };
}

pub fn floating_body_sphere(radius: Float, mass: Float) -> FloatingBody {
    let vol = 1.3333333333333333 * 3.141592653589793 * radius * radius * radius;
    return FloatingBody {
        total_volume: vol,
        mass: mass,
        shape_type: 1,
        height: radius * 2.0,
        width: radius * 2.0,
        depth: radius * 2.0,
    };
}

// -------------------------------------------------------------------
// Submerged Fraction Computations
// -------------------------------------------------------------------

pub fn buoyancy_calc_box_submerged_fraction(
    center_y: Float,
    height: Float,
    surface_y: Float
) -> Float {
    let bottom_y = center_y - (0.5 * height);
    let top_y = center_y + (0.5 * height);

    if bottom_y >= surface_y {
        return 0.0; // Completely above water
    }
    if top_y <= surface_y {
        return 1.0; // Fully submerged
    }

    let submerged_h = surface_y - bottom_y;
    return submerged_h / height;
}

// -------------------------------------------------------------------
// Buoyant Uplift & Hydrodynamic Damping Forces
// -------------------------------------------------------------------

pub fn buoyancy_calculate(
    pos_y: Float,
    vx: Float, vy: Float, vz: Float,
    body: FloatingBody,
    fluid: FluidMedium
) -> BuoyancyResult {
    let fraction = buoyancy_calc_box_submerged_fraction(pos_y, (body).height, (fluid).surface_level_y);
    let sub_vol = fraction * (body).total_volume;

    // F_b = rho * V_sub * g (directed upward along +Y)
    let f_buoyancy_y = (fluid).density * sub_vol * (fluid).gravity_y;

    // Hydrodynamic damping proportional to submerged volume and velocity
    let damp_coeff = (fluid).viscosity_drag * fraction;
    let damp_x = - damp_coeff * vx;
    let damp_y = - damp_coeff * vy;
    let damp_z = - damp_coeff * vz;

    return BuoyancyResult {
        submerged_fraction: fraction,
        submerged_volume: sub_vol,
        buoyancy_force_y: f_buoyancy_y,
        damping_force_x: damp_x,
        damping_force_y: damp_y,
        damping_force_z: damp_z,
    };
}
