// # Rigid Body Dynamics Facade
//
// Logline: Re-exports rigid body types, inertia tensors, force/impulse integration, AABB queries, and physics engine.
//
// Setup: Pure module shim importing rigid body mechanics companion submodules.
//
// Beats:
//   1. Import rigid body structures, force/torque accumulators, AABB bounds, and integration engine.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain backwards compatibility with rigid body physics simulation consumers.

import "./rigid_types.oo";
import "./rigid_ops.oo";
import "./rigid_aabb.oo";
import "./rigid_engine.oo";

pub fn shim_marker_vec3_new() -> Vec3 {
    return vec3_new(1.0, 2.0, 3.0);
}

pub fn shim_marker_vec3_normalize(v_in: Vec3) -> Vec3 {
    return vec3_normalize(v_in);
}

pub fn shim_marker_rigid_body_new(pos: Vec3) -> RigidBody {
    return rigid_body_new(pos, 1.0);
}

pub fn shim_marker_gravity_earth() -> Vec3 {
    return gravity_earth();
}

pub fn shim_marker_aabb_new(min_v: Vec3, max_v: Vec3) -> AABB {
    return aabb_new(min_v, max_v);
}

pub fn shim_marker_aabb_overlaps(a: AABB, b: AABB) -> Int {
    return aabb_overlaps(a, b);
}

pub fn shim_marker_rigid_body_kinetic_energy(rb: &RigidBody) -> Float {
    return rigid_body_kinetic_energy(rb);
}

pub fn shim_marker_rigid_body_momentum(rb: &RigidBody) -> Vec3 {
    return rigid_body_momentum(rb);
}
