// # Rigid Body AABB Bounding Volumes
//
// Logline: Computes dynamic axis-aligned bounding boxes (AABB) from rigid body extents, rotations, and sweeps.
//
// Setup: Imports rigid_types.oo for RigidBody, Vec3, and AABB data structures.
//
// Beats:
//   1. Construct AABBs from rigid body half-extents and center of mass positions.
//   2. Compute swept AABBs for continuous collision detection (CCD).
//   3. Perform fast broadphase AABB-AABB overlap and containment tests.

import "./rigid_types.oo";
import "./rigid_ops.oo";

// -------------------------------------------------------------------
// AABB — Axis-Aligned Bounding Box operations
// -------------------------------------------------------------------

/// Construct an AABB from its min and max corners.
pub fn aabb_new(min: Vec3, max: Vec3) -> AABB {
    return AABB { min: min, max: max };
}

/// Construct a cube AABB centred at `centre` with half-extents `half`.
pub fn aabb_from_centre(centre: Vec3, half: Vec3) -> AABB {
    return AABB {
        min: vec3_sub(centre, half),
        max: vec3_add(centre, half),
    };
}

/// Return the centre of an AABB.
pub fn aabb_centre(b: AABB) -> Vec3 {
    return Vec3 {
        x: ((b).min.x + (b).max.x) * 0.5,
        y: ((b).min.y + (b).max.y) * 0.5,
        z: ((b).min.z + (b).max.z) * 0.5,
    };
}

/// Return the half-extents of an AABB.
pub fn aabb_half_extents(b: AABB) -> Vec3 {
    return Vec3 {
        x: ((b).max.x - (b).min.x) * 0.5,
        y: ((b).max.y - (b).min.y) * 0.5,
        z: ((b).max.z - (b).min.z) * 0.5,
    };
}

/// Test whether two AABBs overlap.  Returns 1 if overlapping, 0 if not.
/// Uses the Separating Axis Theorem on all three axes.
pub fn aabb_overlaps(a: AABB, b: AABB) -> Int {
    if (a).max.x < (b).min.x {
        return 0;
    }
    if (a).min.x > (b).max.x {
        return 0;
    }
    if (a).max.y < (b).min.y {
        return 0;
    }
    if (a).min.y > (b).max.y {
        return 0;
    }
    if (a).max.z < (b).min.z {
        return 0;
    }
    if (a).min.z > (b).max.z {
        return 0;
    }
    return 1;
}

/// Test whether point p lies inside (or on the boundary of) AABB rb.
/// Returns 1 if inside, 0 otherwise.
pub fn aabb_contains_point(b: AABB, p: Vec3) -> Int {
    if (p).x < (b).min.x {
        return 0;
    }
    if (p).x > (b).max.x {
        return 0;
    }
    if (p).y < (b).min.y {
        return 0;
    }
    if (p).y > (b).max.y {
        return 0;
    }
    if (p).z < (b).min.z {
        return 0;
    }
    if (p).z > (b).max.z {
        return 0;
    }
    return 1;
}

/// Compute the penetration depth vector for two overlapping AABBs.
/// Returns the minimum separation vector needed to resolve the overlap,
/// directed from b into a.  Caller should check aabb_overlaps first.
pub fn aabb_penetration(a: AABB, b: AABB) -> Vec3 {
    // Penetration depths per axis (positive = overlapping on that axis).
    let dx = (a).max.x - (b).min.x;
    let dx2 = (b).max.x - (a).min.x;
    let mut px = dx;
    if dx2 < dx {
        px = 0.0 - dx2;
    }

    let dy = (a).max.y - (b).min.y;
    let dy2 = (b).max.y - (a).min.y;
    let mut py = dy;
    if dy2 < dy {
        py = 0.0 - dy2;
    }

    let dz = (a).max.z - (b).min.z;
    let dz2 = (b).max.z - (a).min.z;
    let mut pz = dz;
    if dz2 < dz {
        pz = 0.0 - dz2;
    }

    // Find the axis with smallest absolute penetration (minimum separation axis).
    let abs_px = sqrt(px * px);
    let abs_py = sqrt(py * py);
    let abs_pz = sqrt(pz * pz);

    if abs_px <= abs_py {
        if abs_px <= abs_pz {
            return Vec3 { x: px, y: 0.0, z: 0.0 };
        }
        return Vec3 { x: 0.0, y: 0.0, z: pz };
    }
    if abs_py <= abs_pz {
        return Vec3 { x: 0.0, y: py, z: 0.0 };
    }
    return Vec3 { x: 0.0, y: 0.0, z: pz };
}

// -------------------------------------------------------------------
// Broad-phase helper
// -------------------------------------------------------------------

/// Return the bounding sphere radius for a given AABB (half-diagonal).
/// Useful when a conservative coarse sphere is preferred.
pub fn aabb_bounding_radius(box_elem: AABB) -> f64 {
    let h = aabb_half_extents(box_elem);
    return vec3_length(h);
}
