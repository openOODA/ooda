// # 2D Rigid Body Dynamics & Planar Motion
//
// Logline: Models 2D planar rigid bodies with rotational inertia, angular momentum, linear velocities, and planar forces.
//
// Setup: Planar rigid body equations of motion with torque integration and local/world coordinate transforms.
//
// Beats:
//   1. Define 2D RigidBody2D data structure with mass, moment of inertia, angle, and velocities.
//   2. Apply central and offset forces to generate linear acceleration and rotational torque.
//   3. Implement local-to-world and world-to-local coordinate transformations.

pub type RigidBody2D = struct {
    x: Float,
    y: Float,
    angle: Float,
    vx: Float,
    vy: Float,
    angular_vel: Float,
    fx: Float,
    fy: Float,
    torque: Float,
    mass: Float,
    inv_mass: Float,
    inertia: Float,
    inv_inertia: Float,
    linear_damping: Float,
    angular_damping: Float,
    restitution: Float,
    friction: Float,
    is_static: Int,
};

pub type Point2D = struct {
    x: Float,
    y: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn rigid_body_2d_new(x: Float, y: Float, mass: Float, inertia: Float) -> RigidBody2D {
    let mut inv_m = 0.0;
    let mut inv_i = 0.0;
    let mut is_st = 0;
    if mass > 0.000001 {
        inv_m = 1.0 / mass;
    } else {
        is_st = 1;
    }
    if inertia > 0.000001 {
        inv_i = 1.0 / inertia;
    }
    return RigidBody2D {
        x: x,
        y: y,
        angle: 0.0,
        vx: 0.0,
        vy: 0.0,
        angular_vel: 0.0,
        fx: 0.0,
        fy: 0.0,
        torque: 0.0,
        mass: mass,
        inv_mass: inv_m,
        inertia: inertia,
        inv_inertia: inv_i,
        linear_damping: 0.999,
        angular_damping: 0.995,
        restitution: 0.5,
        friction: 0.3,
        is_static: is_st,
    };
}

pub fn rigid_body_2d_static(x: Float, y: Float) -> RigidBody2D {
    return RigidBody2D {
        x: x,
        y: y,
        angle: 0.0,
        vx: 0.0,
        vy: 0.0,
        angular_vel: 0.0,
        fx: 0.0,
        fy: 0.0,
        torque: 0.0,
        mass: 0.0,
        inv_mass: 0.0,
        inertia: 0.0,
        inv_inertia: 0.0,
        linear_damping: 1.0,
        angular_damping: 1.0,
        restitution: 0.0,
        friction: 0.5,
        is_static: 1,
    };
}

// -------------------------------------------------------------------
// Force & Torque Applications
// -------------------------------------------------------------------

pub fn rigid_body_2d_apply_force(rb: RigidBody2D, fx: Float, fy: Float) -> RigidBody2D {
    if (rb).is_static != 0 {
        return rb;
    }
    return RigidBody2D {
        x: (rb).x,
        y: (rb).y,
        angle: (rb).angle,
        vx: (rb).vx,
        vy: (rb).vy,
        angular_vel: (rb).angular_vel,
        fx: (rb).fx + fx,
        fy: (rb).fy + fy,
        torque: (rb).torque,
        mass: (rb).mass,
        inv_mass: (rb).inv_mass,
        inertia: (rb).inertia,
        inv_inertia: (rb).inv_inertia,
        linear_damping: (rb).linear_damping,
        angular_damping: (rb).angular_damping,
        restitution: (rb).restitution,
        friction: (rb).friction,
        is_static: (rb).is_static,
    };
}

pub fn rigid_body_2d_apply_torque(rb: RigidBody2D, torque: Float) -> RigidBody2D {
    if (rb).is_static != 0 {
        return rb;
    }
    return RigidBody2D {
        x: (rb).x,
        y: (rb).y,
        angle: (rb).angle,
        vx: (rb).vx,
        vy: (rb).vy,
        angular_vel: (rb).angular_vel,
        fx: (rb).fx,
        fy: (rb).fy,
        torque: (rb).torque + torque,
        mass: (rb).mass,
        inv_mass: (rb).inv_mass,
        inertia: (rb).inertia,
        inv_inertia: (rb).inv_inertia,
        linear_damping: (rb).linear_damping,
        angular_damping: (rb).angular_damping,
        restitution: (rb).restitution,
        friction: (rb).friction,
        is_static: (rb).is_static,
    };
}

pub fn rigid_body_2d_apply_force_at_world_point(
    rb: RigidBody2D,
    fx: Float,
    fy: Float,
    px: Float,
    py: Float
) -> RigidBody2D {
    if (rb).is_static != 0 {
        return rb;
    }
    let rx = px - (rb).x;
    let ry = py - (rb).y;
    let gen_torque = (rx * fy) - (ry * fx);

    return RigidBody2D {
        x: (rb).x,
        y: (rb).y,
        angle: (rb).angle,
        vx: (rb).vx,
        vy: (rb).vy,
        angular_vel: (rb).angular_vel,
        fx: (rb).fx + fx,
        fy: (rb).fy + fy,
        torque: (rb).torque + gen_torque,
        mass: (rb).mass,
        inv_mass: (rb).inv_mass,
        inertia: (rb).inertia,
        inv_inertia: (rb).inv_inertia,
        linear_damping: (rb).linear_damping,
        angular_damping: (rb).angular_damping,
        restitution: (rb).restitution,
        friction: (rb).friction,
        is_static: (rb).is_static,
    };
}

// -------------------------------------------------------------------
// Integration Step & Point Velocity
// -------------------------------------------------------------------

pub fn rigid_body_2d_step(rb: RigidBody2D, gx: Float, gy: Float, dt: Float) -> RigidBody2D {
    if (rb).is_static != 0 {
        return rb;
    }
    let ax = ((rb).fx * (rb).inv_mass) + gx;
    let ay = ((rb).fy * (rb).inv_mass) + gy;
    let nvx = ((rb).vx + (ax * dt)) * (rb).linear_damping;
    let nvy = ((rb).vy + (ay * dt)) * (rb).linear_damping;
    let nx = (rb).x + (nvx * dt);
    let ny = (rb).y + (nvy * dt);

    let alpha = (rb).torque * (rb).inv_inertia;
    let n_omega = ((rb).angular_vel + (alpha * dt)) * (rb).angular_damping;
    let n_angle = (rb).angle + (n_omega * dt);

    return RigidBody2D {
        x: nx,
        y: ny,
        angle: n_angle,
        vx: nvx,
        vy: nvy,
        angular_vel: n_omega,
        fx: 0.0,
        fy: 0.0,
        torque: 0.0,
        mass: (rb).mass,
        inv_mass: (rb).inv_mass,
        inertia: (rb).inertia,
        inv_inertia: (rb).inv_inertia,
        linear_damping: (rb).linear_damping,
        angular_damping: (rb).angular_damping,
        restitution: (rb).restitution,
        friction: (rb).friction,
        is_static: (rb).is_static,
    };
}

pub fn rigid_body_2d_get_velocity_at_world_point(
    rb: RigidBody2D,
    px: Float,
    py: Float
) -> Point2D {
    let rx = px - (rb).x;
    let ry = py - (rb).y;
    let p_vx = (rb).vx - ((rb).angular_vel * ry);
    let p_vy = (rb).vy + ((rb).angular_vel * rx);
    return Point2D { x: p_vx, y: p_vy };
}
