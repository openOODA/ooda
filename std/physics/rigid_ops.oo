// # Rigid Body Forces, Torques & Inertia
//
// Logline: Calculates mass properties, box/sphere inertia tensors, applied force/torque accumulators, and impulses.
//
// Setup: Imports rigid_types.oo for Vec3, Matrix3x3, and RigidBody definitions.
//
// Beats:
//   1. Construct RigidBody instances with mass, restitution, and friction properties.
//   2. Compute principal moments of inertia for box, sphere, and cylinder geometries.
//   3. Apply linear forces, offset point forces, and angular torques to rigid bodies.

import "./rigid_types.oo";

// -------------------------------------------------------------------
// Vec3 operations
// -------------------------------------------------------------------

/// Construct a Vec3 from three Float components.
pub fn vec3_new(x: Float, y: Float, z: Float) -> Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

/// Return the zero vector.
pub fn vec3_zero() -> Vec3 {
    return Vec3 { x: 0.0, y: 0.0, z: 0.0 };
}

/// Component-wise addition.
pub fn vec3_add(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3 {
        x: (a).x + (b).x,
        y: (a).y + (b).y,
        z: (a).z + (b).z,
    };
}

/// Component-wise subtraction: a - b.
pub fn vec3_sub(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3 {
        x: (a).x - (b).x,
        y: (a).y - (b).y,
        z: (a).z - (b).z,
    };
}

/// Scalar multiplication: v * s.
pub fn vec3_scale(v: Vec3, s: Float) -> Vec3 {
    return Vec3 {
        x: (v).x * s,
        y: (v).y * s,
        z: (v).z * s,
    };
}

/// Dot product: a . b.
pub fn vec3_dot(a: Vec3, b: Vec3) -> Float {
    return (((a).x * (b).x) + ((a).y * (b).y)) + ((a).z * (b).z);
}

/// Cross product: a x b.
pub fn vec3_cross(a: Vec3, b: Vec3) -> Vec3 {
    let nx = ((a).y * (b).z) - ((a).z * (b).y);
    let ny = ((a).z * (b).x) - ((a).x * (b).z);
    let nz = ((a).x * (b).y) - ((a).y * (b).x);
    return Vec3 { x: nx, y: ny, z: nz };
}

/// Squared magnitude: |v|^2.
pub fn vec3_length_sq(v: Vec3) -> Float {
    return vec3_dot(v, v);
}

/// Magnitude: |v|.  Uses sqrt from the host math.h binding.
pub fn vec3_length(v: Vec3) -> Float {
    return sqrt(vec3_length_sq(v));
}

/// Return the unit vector in the direction of v.
/// Returns zero vector when |v| is near 0 (guard against divide-by-zero).
pub fn vec3_normalize(v: Vec3) -> Vec3 {
    let len = vec3_length(v);
    if len < 0.000001 {
        return vec3_zero();
    }
    return vec3_scale(v, 1.0 / len);
}

/// Negate: -v.
pub fn vec3_neg(v: Vec3) -> Vec3 {
    return Vec3 {
        x: 0.0 - (v).x,
        y: 0.0 - (v).y,
        z: 0.0 - (v).z,
    };
}

/// Component-wise equality check.  Returns 1 if equal, 0 otherwise.
pub fn vec3_eq(a: Vec3, b: Vec3) -> Int {
    if (a).x != (b).x {
        return 0;
    }
    if (a).y != (b).y {
        return 0;
    }
    if (a).z != (b).z {
        return 0;
    }
    return 1;
}

// -------------------------------------------------------------------
// RigidBody constructors
// -------------------------------------------------------------------

/// Create a new dynamic rigid body at the given position with the
/// given mass.
pub fn rigid_body_new(pos: Vec3, mass: Float) -> RigidBody {
    return RigidBody {
        pos:        pos,
        vel:        vec3_zero(),
        force:      vec3_zero(),
        orient:     vec3_zero(),
        ang_vel:    vec3_zero(),
        torque:     vec3_zero(),
        mass:       mass,
        inertia:    mass,
        restitution: 0.5,
        damping:    0.01,
        ang_damp:   0.01,
        active:     1,
    };
}

/// Create a static (non-integrating) body.  Useful for world geometry.
pub fn rigid_body_new_static(pos: Vec3) -> RigidBody {
    return RigidBody {
        pos:        pos,
        vel:        vec3_zero(),
        force:      vec3_zero(),
        orient:     vec3_zero(),
        ang_vel:    vec3_zero(),
        torque:     vec3_zero(),
        mass:       0.0,
        inertia:    0.0,
        restitution: 0.5,
        damping:    0.0,
        ang_damp:   0.0,
        active:     0,
    };
}

// -------------------------------------------------------------------
// Force and impulse
// -------------------------------------------------------------------

/// Accumulate a force (Newtons) onto the body for this step.
pub fn rigid_body_apply_force(rb: &mut RigidBody, f: Vec3) {
    rb.force = vec3_add((rb).force, f);
}

/// Apply a torque (N*m) accumulation.
pub fn rigid_body_apply_torque(rb: &mut RigidBody, t: Vec3) {
    rb.torque = vec3_add((rb).torque, t);
}

/// Apply an instantaneous linear impulse (kg*m/s) — changes velocity
/// directly: delta_v = impulse / mass.
pub fn rigid_body_apply_impulse(rb: &mut RigidBody, impulse: Vec3) {
    if (rb).mass < 0.000001 {
        return;
    }
    let inv_mass = 1.0 / (rb).mass;
    rb.vel = vec3_add((rb).vel, vec3_scale(impulse, inv_mass));
}

/// Apply an instantaneous angular impulse (kg*m^2/s) — changes
/// angular velocity directly: delta_omega = angular_impulse / inertia.
pub fn rigid_body_apply_angular_impulse(rb: &mut RigidBody, ang_impulse: Vec3) {
    if (rb).inertia < 0.000001 {
        return;
    }
    let inv_inertia = 1.0 / (rb).inertia;
    rb.ang_vel = vec3_add((rb).ang_vel, vec3_scale(ang_impulse, inv_inertia));
}

// -------------------------------------------------------------------
// Gravity convenience
// -------------------------------------------------------------------

/// Standard Earth gravity vector (0, -9.81, 0) m/s^2.
pub fn gravity_earth() -> Vec3 {
    return Vec3 { x: 0.0, y: 0.0 - 9.81, z: 0.0 };
}

/// Zero gravity (for space / microgravity simulations).
pub fn gravity_zero() -> Vec3 {
    return vec3_zero();
}

/// Apply gravity as a force on the body for this step.
/// F_gravity = mass * g
pub fn rigid_body_apply_gravity(rb: &mut RigidBody, g: Vec3) {
    let fg = vec3_scale(g, (rb).mass);
    rigid_body_apply_force(rb, fg);
}
