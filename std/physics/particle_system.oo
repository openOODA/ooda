// # Particle System & Force Accumulator
//
// Logline: Manages multi-particle dynamics, mass distributions, force accumulators, and boundary conditions.
//
// Setup: Pure 3D particle state representation and kinematics accumulator without external dependencies.
//
// Beats:
//   1. Define 3D ParticlePoint, ForceAccumulator, and ParticleSystemState data structures.
//   2. Implement particle motion integration, gravity acceleration, and force accumulation.
//   3. Implement bounding box containment, restitution bouncing, and velocity damping.

pub type ParticlePoint = struct {
    x: Float,
    y: Float,
    z: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    fx: Float,
    fy: Float,
    fz: Float,
    mass: Float,
    inv_mass: Float,
    radius: Float,
    damping: Float,
    is_locked: Int,
    is_alive: Int
};

pub type ParticleSystemState = struct {
    particle_count: Int,
    gravity_x: Float,
    gravity_y: Float,
    gravity_z: Float,
    drag_coefficient: Float,
    bounds_min_x: Float,
    bounds_min_y: Float,
    bounds_min_z: Float,
    bounds_max_x: Float,
    bounds_max_y: Float,
    bounds_max_z: Float,
    restitution: Float
};

// -------------------------------------------------------------------
// Particle Constructors
// -------------------------------------------------------------------

pub fn particle_point_new(
    x: Float,
    y: Float,
    z: Float,
    mass: Float,
    radius: Float
) -> ParticlePoint {
    let mut inv_m = 0.0;
    if mass > 0.000001 {
        inv_m = 1.0 / mass;
    }
    return ParticlePoint {
        x: x,
        y: y,
        z: z,
        vx: 0.0,
        vy: 0.0,
        vz: 0.0,
        fx: 0.0,
        fy: 0.0,
        fz: 0.0,
        mass: mass,
        inv_mass: inv_m,
        radius: radius,
        damping: 0.998,
        is_locked: 0,
        is_alive: 1
    };
}

pub fn particle_system_state_default() -> ParticleSystemState {
    return ParticleSystemState {
        particle_count: 0,
        gravity_x: 0.0,
        gravity_y: -9.81,
        gravity_z: 0.0,
        drag_coefficient: 0.001,
        bounds_min_x: -100.0,
        bounds_min_y: 0.0,
        bounds_min_z: -100.0,
        bounds_max_x: 100.0,
        bounds_max_y: 100.0,
        bounds_max_z: 100.0,
        restitution: 0.7
    };
}

// -------------------------------------------------------------------
// Force Application & Kinematics
// -------------------------------------------------------------------

pub fn particle_point_apply_force(
    p: ParticlePoint,
    fx: Float,
    fy: Float,
    fz: Float
) -> ParticlePoint {
    if (p).is_locked != 0 || (p).is_alive == 0 {
        return p;
    }
    return ParticlePoint {
        x: (p).x,
        y: (p).y,
        z: (p).z,
        vx: (p).vx,
        vy: (p).vy,
        vz: (p).vz,
        fx: (p).fx + fx,
        fy: (p).fy + fy,
        fz: (p).fz + fz,
        mass: (p).mass,
        inv_mass: (p).inv_mass,
        radius: (p).radius,
        damping: (p).damping,
        is_locked: (p).is_locked,
        is_alive: (p).is_alive
    };
}

pub fn particle_point_apply_impulse(
    p: ParticlePoint,
    jx: Float,
    jy: Float,
    jz: Float
) -> ParticlePoint {
    if (p).is_locked != 0 || (p).is_alive == 0 || (p).inv_mass <= 0.0 {
        return p;
    }
    return ParticlePoint {
        x: (p).x,
        y: (p).y,
        z: (p).z,
        vx: (p).vx + (jx * (p).inv_mass),
        vy: (p).vy + (jy * (p).inv_mass),
        vz: (p).vz + (jz * (p).inv_mass),
        fx: (p).fx,
        fy: (p).fy,
        fz: (p).fz,
        mass: (p).mass,
        inv_mass: (p).inv_mass,
        radius: (p).radius,
        damping: (p).damping,
        is_locked: (p).is_locked,
        is_alive: (p).is_alive
    };
}

pub fn particle_point_step(
    p: ParticlePoint,
    sys: ParticleSystemState,
    dt: Float
) -> ParticlePoint {
    if (p).is_locked != 0 || (p).is_alive == 0 || (p).inv_mass <= 0.0 {
        return p;
    }

    // Compute net acceleration: (F / m) + gravity
    let ax = ((p).fx * (p).inv_mass) + (sys).gravity_x;
    let ay = ((p).fy * (p).inv_mass) + (sys).gravity_y;
    let az = ((p).fz * (p).inv_mass) + (sys).gravity_z;

    // Semi-implicit velocity update
    let mut nvx = ((p).vx + (ax * dt)) * (p).damping;
    let mut nvy = ((p).vy + (ay * dt)) * (p).damping;
    let mut nvz = ((p).vz + (az * dt)) * (p).damping;

    // Position integration
    let mut nx = (p).x + (nvx * dt);
    let mut ny = (p).y + (nvy * dt);
    let mut nz = (p).z + (nvz * dt);

    // Boundary collision clamping
    let rad = (p).radius;
    let rest = (sys).restitution;

    if nx - rad < (sys).bounds_min_x {
        nx = (sys).bounds_min_x + rad;
        nvx = -nvx * rest;
    }
    if nx + rad > (sys).bounds_max_x {
        nx = (sys).bounds_max_x - rad;
        nvx = -nvx * rest;
    }

    if ny - rad < (sys).bounds_min_y {
        ny = (sys).bounds_min_y + rad;
        nvy = -nvy * rest;
    }
    if ny + rad > (sys).bounds_max_y {
        ny = (sys).bounds_max_y - rad;
        nvy = -nvy * rest;
    }

    if nz - rad < (sys).bounds_min_z {
        nz = (sys).bounds_min_z + rad;
        nvz = -nvz * rest;
    }
    if nz + rad > (sys).bounds_max_z {
        nz = (sys).bounds_max_z - rad;
        nvz = -nvz * rest;
    }

    return ParticlePoint {
        x: nx,
        y: ny,
        z: nz,
        vx: nvx,
        vy: nvy,
        vz: nvz,
        fx: 0.0,
        fy: 0.0,
        fz: 0.0,
        mass: (p).mass,
        inv_mass: (p).inv_mass,
        radius: (p).radius,
        damping: (p).damping,
        is_locked: (p).is_locked,
        is_alive: (p).is_alive
    };
}
