// # Fluid Boundary Domains & AABB Containment
//
// Logline: Manages fluid simulation bounding boxes, solid boundary collisions, and particle reflection kinematics.
//
// Setup: Imports fluid_particle.oo for FluidParticle states and 3D velocity vectors.
//
// Beats:
//   1. Construct FluidDomain simulation bounding boxes and periodic boundary conditions.
//   2. Detect boundary violations and enforce solid wall particle collisions with restitution.
//   3. Compute fluid inflow nozzle injection and outflow sink drainage.

import "./fluid_particle.oo";

pub type FluidDomain = struct {
    min_pos: Vec3,
    max_pos: Vec3,
    restitution: f64,
    friction: f64,
};

/// Construct a new fluid domain box.
pub fn fluid_domain_new(min_pos: Vec3, max_pos: Vec3) -> FluidDomain {
    return FluidDomain {
        min_pos: min_pos,
        max_pos: max_pos,
        restitution: 0.3,
        friction: 0.1,
    };
}

/// Return 1 if pos is strictly inside fluid domain, 0 otherwise.
pub fn fluid_domain_contains(domain: FluidDomain, pos: Vec3) -> Int {
    if ((pos).x) < ((domain).min_pos.x) { return 0; }
    if ((pos).x) > ((domain).max_pos.x) { return 0; }
    if ((pos).y) < ((domain).min_pos.y) { return 0; }
    if ((pos).y) > ((domain).max_pos.y) { return 0; }
    if ((pos).z) < ((domain).min_pos.z) { return 0; }
    if ((pos).z) > ((domain).max_pos.z) { return 0; }
    return 1;
}

/// Clamp position to stay within domain bounds.
pub fn fluid_domain_clamp_pos(domain: FluidDomain, pos: Vec3) -> Vec3 {
    let mut cx = (pos).x;
    let mut cy = (pos).y;
    let mut cz = (pos).z;

    if (cx) < ((domain).min_pos.x) { cx = (domain).min_pos.x; }
    if (cx) > ((domain).max_pos.x) { cx = (domain).max_pos.x; }
    if (cy) < ((domain).min_pos.y) { cy = (domain).min_pos.y; }
    if (cy) > ((domain).max_pos.y) { cy = (domain).max_pos.y; }
    if (cz) < ((domain).min_pos.z) { cz = (domain).min_pos.z; }
    if (cz) > ((domain).max_pos.z) { cz = (domain).max_pos.z; }

    return Vec3 { x: cx, y: cy, z: cz };
}

/// Resolve collision of a fluid particle against domain boundary walls.
pub fn fluid_particle_boundary_collide(p: &mut FluidParticle, domain: FluidDomain) {
    if ((p).active) == 0 {
        return;
    }

    let e = (domain).restitution;
    let fric = 1.0 - ((domain).friction);

    let mut px = (p).pos.x;
    let mut py = (p).pos.y;
    let mut pz = (p).pos.z;

    let mut vx = (p).vel.x;
    let mut vy = (p).vel.y;
    let mut vz = (p).vel.z;

    // X-min boundary
    if (px) < ((domain).min_pos.x) {
        px = (domain).min_pos.x;
        if (vx) < 0.0 {
            vx = (0.0 - (e)) * (vx);
            vy = (vy) * (fric);
            vz = (vz) * (fric);
        }
    }
    // X-max boundary
    if (px) > ((domain).max_pos.x) {
        px = (domain).max_pos.x;
        if (vx) > 0.0 {
            vx = (0.0 - (e)) * (vx);
            vy = (vy) * (fric);
            vz = (vz) * (fric);
        }
    }
    // Y-min boundary
    if (py) < ((domain).min_pos.y) {
        py = (domain).min_pos.y;
        if (vy) < 0.0 {
            vy = (0.0 - (e)) * (vy);
            vx = (vx) * (fric);
            vz = (vz) * (fric);
        }
    }
    // Y-max boundary
    if (py) > ((domain).max_pos.y) {
        py = (domain).max_pos.y;
        if (vy) > 0.0 {
            vy = (0.0 - (e)) * (vy);
            vx = (vx) * (fric);
            vz = (vz) * (fric);
        }
    }
    // Z-min boundary
    if (pz) < ((domain).min_pos.z) {
        pz = (domain).min_pos.z;
        if (vz) < 0.0 {
            vz = (0.0 - (e)) * (vz);
            vx = (vx) * (fric);
            vy = (vy) * (fric);
        }
    }
    // Z-max boundary
    if (pz) > ((domain).max_pos.z) {
        pz = (domain).max_pos.z;
        if (vz) > 0.0 {
            vz = (0.0 - (e)) * (vz);
            vx = (vx) * (fric);
            vy = (vy) * (fric);
        }
    }

    p.pos = Vec3 { x: px, y: py, z: pz };
    p.vel = Vec3 { x: vx, y: vy, z: vz };
}
