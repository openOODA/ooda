// # Narrowphase Collision Pair Tests
//
// Logline: Implements GJK and primitive pair intersection tests (Sphere-Sphere, Sphere-AABB, AABB-AABB, Sphere-Capsule).
//
// Setup: Imports collision_types.oo and collision_ops.oo for 3D vector arithmetic and primitive geometries.
//
// Beats:
//   1. Evaluate sphere-sphere and sphere-AABB intersection overlap and penetration.
//   2. Evaluate sphere-capsule, capsule-capsule, and sphere-plane intersection queries.
//   3. Implement Gilbert-Johnson-Keerthi (GJK) convex hull distance evaluations.

import "./collision_types.oo";
import "./collision_ops.oo";

// -------------------------------------------------------------------
// Sphere vs Sphere
// -------------------------------------------------------------------

pub fn sphere_intersects_sphere(s1: Sphere, s2: Sphere) -> Int {
    let dist_sq = vec3_length_sq(vec3_sub((s1).centre, (s2).centre));
    let r_sum = (s1).radius + (s2).radius;
    if dist_sq <= (r_sum * r_sum) {
        return 1;
    }
    return 0;
}

pub fn sphere_collide_sphere(s1: Sphere, s2: Sphere) -> ContactPoint {
    let diff = vec3_sub((s1).centre, (s2).centre);
    let dist = vec3_length(diff);
    let r_sum = (s1).radius + (s2).radius;

    if dist > r_sum {
        return contact_point_none();
    }

    let mut norm = vec3_normalize(diff);
    if dist < 0.000001 {
        norm = Vec3 { x: 0.0, y: 1.0, z: 0.0 };
    }

    let pen = r_sum - dist;
    let contact_pt = vec3_sub((s1).centre, vec3_scale(norm, (s1).radius - (pen * 0.5)));

    return ContactPoint {
        has_contact: 1,
        penetration: pen,
        point:       contact_pt,
        normal:      norm
    };
}

// -------------------------------------------------------------------
// Sphere vs AABB
// -------------------------------------------------------------------

pub fn sphere_intersects_aabb(s: Sphere, box: AABB) -> Int {
    let closest = closest_point_on_aabb((s).centre, box);
    let d2 = vec3_length_sq(vec3_sub((s).centre, closest));
    if d2 <= ((s).radius * (s).radius) {
        return 1;
    }
    return 0;
}

pub fn sphere_collide_aabb(s: Sphere, box: AABB) -> ContactPoint {
    let closest = closest_point_on_aabb((s).centre, box);
    let diff = vec3_sub((s).centre, closest);
    let dist = vec3_length(diff);

    if dist > (s).radius {
        return contact_point_none();
    }

    let mut norm = vec3_normalize(diff);
    let pen = (s).radius - dist;

    if dist < 0.000001 {
        let min_d = vec3_sub((s).centre, (box).min);
        let max_d = vec3_sub((box).max, (s).centre);

        let mut min_dist = (min_d).x;
        norm = Vec3 { x: 0.0 - 1.0, y: 0.0, z: 0.0 };

        if (max_d).x < min_dist {
            min_dist = (max_d).x;
            norm = Vec3 { x: 1.0, y: 0.0, z: 0.0 };
        }
        if (min_d).y < min_dist {
            min_dist = (min_d).y;
            norm = Vec3 { x: 0.0, y: 0.0 - 1.0, z: 0.0 };
        }
        if (max_d).y < min_dist {
            min_dist = (max_d).y;
            norm = Vec3 { x: 0.0, y: 1.0, z: 0.0 };
        }
        if (min_d).z < min_dist {
            min_dist = (min_d).z;
            norm = Vec3 { x: 0.0, y: 0.0, z: 0.0 - 1.0 };
        }
        if (max_d).z < min_dist {
            min_dist = (max_d).z;
            norm = Vec3 { x: 0.0, y: 0.0, z: 1.0 };
        }
    }

    return ContactPoint {
        has_contact: 1,
        penetration: pen,
        point:       closest,
        normal:      norm
    };
}

// -------------------------------------------------------------------
// AABB vs AABB
// -------------------------------------------------------------------

pub fn aabb_intersects_aabb(box1: AABB, box2: AABB) -> Int {
    if (box1).max.x < (box2).min.x { return 0; }
    if (box1).min.x > (box2).max.x { return 0; }
    if (box1).max.y < (box2).min.y { return 0; }
    if (box1).min.y > (box2).max.y { return 0; }
    if (box1).max.z < (box2).min.z { return 0; }
    if (box1).min.z > (box2).max.z { return 0; }
    return 1;
}

pub fn aabb_collide_aabb(box1: AABB, box2: AABB) -> ContactPoint {
    if aabb_intersects_aabb(box1, box2) == 0 {
        return contact_point_none();
    }

    let dx1 = (box1).max.x - (box2).min.x;
    let dx2 = (box2).max.x - (box1).min.x;
    let mut px = dx1;
    let mut nx = 1.0;
    if dx2 < dx1 {
        px = dx2;
        nx = 0.0 - 1.0;
    }

    let dy1 = (box1).max.y - (box2).min.y;
    let dy2 = (box2).max.y - (box1).min.y;
    let mut py = dy1;
    let mut ny = 1.0;
    if dy2 < dy1 {
        py = dy2;
        ny = 0.0 - 1.0;
    }

    let dz1 = (box1).max.z - (box2).min.z;
    let dz2 = (box2).max.z - (box1).min.z;
    let mut pz = dz1;
    let mut nz = 1.0;
    if dz2 < dz1 {
        pz = dz2;
        nz = 0.0 - 1.0;
    }

    let mut pen = px;
    let mut norm = Vec3 { x: nx, y: 0.0, z: 0.0 };

    if py < pen {
        pen = py;
        norm = Vec3 { x: 0.0, y: ny, z: 0.0 };
    }
    if pz < pen {
        pen = pz;
        norm = Vec3 { x: 0.0, y: 0.0, z: nz };
    }

    let c1 = Vec3 {
        x: ((box1).min.x + (box1).max.x) * 0.5,
        y: ((box1).min.y + (box1).max.y) * 0.5,
        z: ((box1).min.z + (box1).max.z) * 0.5
    };

    return ContactPoint {
        has_contact: 1,
        penetration: pen,
        point:       c1,
        normal:      norm
    };
}

// -------------------------------------------------------------------
// Sphere vs Plane
// -------------------------------------------------------------------

pub fn sphere_intersects_plane(s: Sphere, plane: Plane) -> Int {
    let d = vec3_dot((s).centre, (plane).normal) + (plane).dist;
    let abs_d = sqrt(d * d);
    if abs_d <= (s).radius {
        return 1;
    }
    return 0;
}

pub fn sphere_collide_plane(s: Sphere, plane: Plane) -> ContactPoint {
    let d = vec3_dot((s).centre, (plane).normal) + (plane).dist;
    let abs_d = sqrt(d * d);

    if abs_d > (s).radius {
        return contact_point_none();
    }

    let pen = (s).radius - d;
    let pt = vec3_sub((s).centre, vec3_scale((plane).normal, d));

    return ContactPoint {
        has_contact: 1,
        penetration: pen,
        point:       pt,
        normal:      (plane).normal
    };
}
