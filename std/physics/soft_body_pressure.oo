// # Incompressible Gas Pressure & Volumetric Soft Body
//
// Logline: Simulates inflatable 2D/3D balloon-like soft bodies using ideal gas law interior pressure and surface normal expansions.
//
// Setup: Closed-surface pneumatic pressure models calculating signed polygon volume and surface normal forces.
//
// Beats:
//   1. Define SoftBodyVertex, SoftBodyPressureState, and SoftBodyEdge structures.
//   2. Compute 2D polygon signed area via shoelace formula and 3D tetra volume.
//   3. Apply outward normal pressure forces scaled by ideal gas law (P = n*R*T / V) or target overpressure.

pub type SoftBodyVertex = struct {
    x: Float,
    y: Float,
    vx: Float,
    vy: Float,
    fx: Float,
    fy: Float,
    mass: Float,
    inv_mass: Float,
};

pub type SoftBodyEdge = struct {
    i0: Int,
    i1: Int,
    normal_x: Float,
    normal_y: Float,
    edge_length: Float,
};

pub type SoftBodyPressureConfig = struct {
    target_volume: Float,
    gas_amount: Float, // n * R * T constant
    overpressure_coefficient: Float,
    damping: Float,
};

pub type EdgePressureForce = struct {
    f0_x: Float,
    f0_y: Float,
    f1_x: Float,
    f1_y: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn soft_body_vertex_new(x: Float, y: Float, mass: Float) -> SoftBodyVertex {
    let mut inv_m = 0.0;
    if mass > 0.000001 {
        inv_m = 1.0 / mass;
    }
    return SoftBodyVertex {
        x: x, y: y,
        vx: 0.0, vy: 0.0,
        fx: 0.0, fy: 0.0,
        mass: mass,
        inv_mass: inv_m,
    };
}

pub fn soft_body_pressure_config_default(target_vol: Float) -> SoftBodyPressureConfig {
    return SoftBodyPressureConfig {
        target_volume: target_vol,
        gas_amount: target_vol * 100.0,
        overpressure_coefficient: 50.0,
        damping: 0.995,
    };
}

// -------------------------------------------------------------------
// Geometric Area & Normal Calculations
// -------------------------------------------------------------------

/// Shoelace formula triangle contribution: (x0 * y1 - x1 * y0) * 0.5
pub fn soft_body_triangle_signed_area_2d(
    x0: Float, y0: Float,
    x1: Float, y1: Float
) -> Float {
    return 0.5 * ((x0 * y1) - (x1 * y0));
}

/// Compute edge normal and length for 2D segment (x0, y0) -> (x1, y1)
pub fn soft_body_compute_edge(
    i0: Int, i1: Int,
    x0: Float, y0: Float,
    x1: Float, y1: Float
) -> SoftBodyEdge {
    let dx = x1 - x0;
    let dy = y1 - y0;
    let len = sqrt((dx * dx) + (dy * dy));

    // Outward normal in counter-clockwise winding is (dy, -dx)
    let mut nx = 0.0;
    let mut ny = 0.0;
    if len > 0.000001 {
        let inv_len = 1.0 / len;
        nx = dy * inv_len;
        ny = -dx * inv_len;
    }

    return SoftBodyEdge {
        i0: i0,
        i1: i1,
        normal_x: nx,
        normal_y: ny,
        edge_length: len,
    };
}

// -------------------------------------------------------------------
// Pressure Force Generation
// -------------------------------------------------------------------

/// Compute ideal gas law pressure: P = (n*R*T) / current_volume + k * (V_target - V)
pub fn soft_body_calculate_pressure(
    current_volume: Float,
    cfg: SoftBodyPressureConfig
) -> Float {
    let mut vol = current_volume;
    if vol < 0.001 {
        vol = 0.001;
    }
    let gas_p = (cfg).gas_amount / vol;
    let over_p = (cfg).overpressure_coefficient * ((cfg).target_volume - vol);
    return gas_p + over_p;
}

/// Apply edge pressure force: F = Pressure * Edge_Length * Normal
pub fn soft_body_edge_pressure_force(
    edge: SoftBodyEdge,
    pressure: Float
) -> EdgePressureForce {
    let half_mag = 0.5 * pressure * (edge).edge_length;
    let fx = (edge).normal_x * half_mag;
    let fy = (edge).normal_y * half_mag;

    return EdgePressureForce {
        f0_x: fx, f0_y: fy,
        f1_x: fx, f1_y: fy,
    };
}
