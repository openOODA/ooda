// # Verlet & Velocity Verlet Numerical Integrator
//
// Logline: Implements position Verlet and velocity Verlet numerical integration schemes for conservative physical systems.
//
// Setup: Energy-preserving symplectic integration methods with damping and external accelerations.
//
// Beats:
//   1. Define VerletParticle and VerletIntegratorState data structures.
//   2. Implement classic position Verlet with previous-step position memory.
//   3. Implement velocity Verlet half-step integration for time-reversible dynamics.

pub type VerletParticle = struct {
    x: Float,
    y: Float,
    z: Float,
    old_x: Float,
    old_y: Float,
    old_z: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    ax: Float,
    ay: Float,
    az: Float,
    mass: Float,
    inv_mass: Float,
    damping: Float,
    is_pinned: Int,
};

pub type VerletIntegratorState = struct {
    global_damping: Float,
    gravity_x: Float,
    gravity_y: Float,
    gravity_z: Float,
    substeps: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn verlet_particle_new(
    x: Float,
    y: Float,
    z: Float,
    mass: Float
) -> VerletParticle {
    let mut inv_m = 0.0;
    if mass > 0.000001 {
        inv_m = 1.0 / mass;
    }
    return VerletParticle {
        x: x,
        y: y,
        z: z,
        old_x: x,
        old_y: y,
        old_z: z,
        vx: 0.0,
        vy: 0.0,
        vz: 0.0,
        ax: 0.0,
        ay: 0.0,
        az: 0.0,
        mass: mass,
        inv_mass: inv_m,
        damping: 0.999,
        is_pinned: 0,
    };
}

pub fn verlet_integrator_default() -> VerletIntegratorState {
    return VerletIntegratorState {
        global_damping: 0.999,
        gravity_x: 0.0,
        gravity_y: -9.81,
        gravity_z: 0.0,
        substeps: 4,
    };
}

// -------------------------------------------------------------------
// Position Verlet Integration: x_{n+1} = 2*x_n - x_{n-1} + a*dt^2
// -------------------------------------------------------------------

pub fn verlet_integrate_position(
    p: VerletParticle,
    gx: Float,
    gy: Float,
    gz: Float,
    dt: Float
) -> VerletParticle {
    if (p).is_pinned != 0 || (p).inv_mass <= 0.0 {
        return p;
    }

    let dt_sq = dt * dt;
    let net_ax = (p).ax + gx;
    let net_ay = (p).ay + gy;
    let net_az = (p).az + gz;

    let d = (p).damping;
    let curr_x = (p).x;
    let curr_y = (p).y;
    let curr_z = (p).z;

    // x_{n+1} = x_n + (x_n - x_{n-1}) * damping + a * dt^2
    let next_x = curr_x + ((curr_x - (p).old_x) * d) + (net_ax * dt_sq);
    let next_y = curr_y + ((curr_y - (p).old_y) * d) + (net_ay * dt_sq);
    let next_z = curr_z + ((curr_z - (p).old_z) * d) + (net_az * dt_sq);

    // Reconstruct approximate velocity: v = (x_{n+1} - x_n) / dt
    let inv_dt = if dt > 0.000001 { 1.0 / dt } else { 0.0 };
    let est_vx = (next_x - curr_x) * inv_dt;
    let est_vy = (next_y - curr_y) * inv_dt;
    let est_vz = (next_z - curr_z) * inv_dt;

    return VerletParticle {
        x: next_x,
        y: next_y,
        z: next_z,
        old_x: curr_x,
        old_y: curr_y,
        old_z: curr_z,
        vx: est_vx,
        vy: est_vy,
        vz: est_vz,
        ax: 0.0,
        ay: 0.0,
        az: 0.0,
        mass: (p).mass,
        inv_mass: (p).inv_mass,
        damping: (p).damping,
        is_pinned: (p).is_pinned,
    };
}

// -------------------------------------------------------------------
// Velocity Verlet:
// 1. x(t+dt) = x(t) + v(t)*dt + 0.5*a(t)*dt^2
// 2. v(t+dt/2) = v(t) + 0.5*a(t)*dt
// 3. (recompute a(t+dt))
// 4. v(t+dt) = v(t+dt/2) + 0.5*a(t+dt)*dt
// -------------------------------------------------------------------

pub fn velocity_verlet_step_pos(
    p: VerletParticle,
    gx: Float,
    gy: Float,
    gz: Float,
    dt: Float
) -> VerletParticle {
    if (p).is_pinned != 0 || (p).inv_mass <= 0.0 {
        return p;
    }

    let net_ax = (p).ax + gx;
    let net_ay = (p).ay + gy;
    let net_az = (p).az + gz;

    let half_dt = 0.5 * dt;
    let dt_sq_half = 0.5 * dt * dt;

    let nx = (p).x + ((p).vx * dt) + (net_ax * dt_sq_half);
    let ny = (p).y + ((p).vy * dt) + (net_ay * dt_sq_half);
    let nz = (p).z + ((p).vz * dt) + (net_az * dt_sq_half);

    // Half-step velocity
    let mid_vx = (p).vx + (net_ax * half_dt);
    let mid_vy = (p).vy + (net_ay * half_dt);
    let mid_vz = (p).vz + (net_az * half_dt);

    return VerletParticle {
        x: nx,
        y: ny,
        z: nz,
        old_x: (p).x,
        old_y: (p).y,
        old_z: (p).z,
        vx: mid_vx,
        vy: mid_vy,
        vz: mid_vz,
        ax: net_ax,
        ay: net_ay,
        az: net_az,
        mass: (p).mass,
        inv_mass: (p).inv_mass,
        damping: (p).damping,
        is_pinned: (p).is_pinned,
    };
}

pub fn velocity_verlet_step_vel(
    p: VerletParticle,
    new_ax: Float,
    new_ay: Float,
    new_az: Float,
    dt: Float
) -> VerletParticle {
    if (p).is_pinned != 0 || (p).inv_mass <= 0.0 {
        return p;
    }

    let half_dt = 0.5 * dt;
    let nvx = ((p).vx + (new_ax * half_dt)) * (p).damping;
    let nvy = ((p).vy + (new_ay * half_dt)) * (p).damping;
    let nvz = ((p).vz + (new_az * half_dt)) * (p).damping;

    return VerletParticle {
        x: (p).x,
        y: (p).y,
        z: (p).z,
        old_x: (p).old_x,
        old_y: (p).old_y,
        old_z: (p).old_z,
        vx: nvx,
        vy: nvy,
        vz: nvz,
        ax: 0.0,
        ay: 0.0,
        az: 0.0,
        mass: (p).mass,
        inv_mass: (p).inv_mass,
        damping: (p).damping,
        is_pinned: (p).is_pinned,
    };
}
