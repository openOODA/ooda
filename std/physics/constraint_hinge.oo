// # Revolute Hinge & Angular Limit Constraint
//
// Logline: Restricts 2D and 3D rotations to a single revolute axis with angular limits, motor speeds, and torque limits.
//
// Setup: 1-DOF revolute joint dynamics with anchor point alignment, angular limits, and powered motors.
//
// Beats:
//   1. Define HingeJoint2D, HingeJoint3D, and HingeMotorConfig data structures.
//   2. Solve anchor point positional alignment constraint (p_anchor_A == p_anchor_B).
//   3. Apply angular range limits and motor torque drive along the revolute axis.

pub type HingeMotorConfig = struct {
    is_motor_enabled: Int,
    target_angular_speed: Float,
    max_motor_torque: Float
};

pub type HingeJoint2D = struct {
    body_a_id: Int,
    body_b_id: Int,
    local_anchor_a_x: Float,
    local_anchor_a_y: Float,
    local_anchor_b_x: Float,
    local_anchor_b_y: Float,
    is_limit_enabled: Int,
    lower_angle_rad: Float,
    upper_angle_rad: Float,
    motor: HingeMotorConfig
};

pub type HingeCorrection2D = struct {
    anchor_error_x: Float,
    anchor_error_y: Float,
    angle_error: Float,
    motor_torque: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn hinge_motor_default() -> HingeMotorConfig {
    return HingeMotorConfig {
        is_motor_enabled: 0,
        target_angular_speed: 0.0,
        max_motor_torque: 50.0
    };
}

pub fn hinge_joint_2d_new(
    body_a: Int,
    body_b: Int,
    lax: Float, lay: Float,
    lbx: Float, lby: Float
) -> HingeJoint2D {
    return HingeJoint2D {
        body_a_id: body_a,
        body_b_id: body_b,
        local_anchor_a_x: lax,
        local_anchor_a_y: lay,
        local_anchor_b_x: lbx,
        local_anchor_b_y: lby,
        is_limit_enabled: 0,
        lower_angle_rad: -1.5707963, // -90 deg
        upper_angle_rad: 1.5707963,  // +90 deg
        motor: hinge_motor_default()
    };
}

// -------------------------------------------------------------------
// Anchor Alignment & Angular Limits
// -------------------------------------------------------------------

/// Compute anchor alignment error in world space: p_a - p_b
pub fn hinge_joint_2d_eval_anchor_error(
    joint: HingeJoint2D,
    world_anchor_a_x: Float,
    world_anchor_a_y: Float,
    world_anchor_b_x: Float,
    world_anchor_b_y: Float
) -> HingeCorrection2D {
    let ex = world_anchor_a_x - world_anchor_b_x;
    let ey = world_anchor_a_y - world_anchor_b_y;

    return HingeCorrection2D {
        anchor_error_x: ex,
        anchor_error_y: ey,
        angle_error: 0.0,
        motor_torque: 0.0
    };
}

/// Clamp relative angle between body A and body B to [lower, upper]
pub fn hinge_joint_2d_solve_angle_limits(
    joint: HingeJoint2D,
    current_relative_angle: Float
) -> Float {
    if (joint).is_limit_enabled == 0 {
        return 0.0;
    }

    let mut error = 0.0;
    if current_relative_angle < (joint).lower_angle_rad {
        error = current_relative_angle - (joint).lower_angle_rad;
    } else if current_relative_angle > (joint).upper_angle_rad {
        error = current_relative_angle - (joint).upper_angle_rad;
    }

    return error;
}

/// Compute motor torque drive towards target angular velocity
pub fn hinge_joint_2d_compute_motor_torque(
    joint: HingeJoint2D,
    current_angular_speed: Float
) -> Float {
    if ((joint).motor).is_motor_enabled == 0 {
        return 0.0;
    }

    let target_speed = ((joint).motor).target_angular_speed;
    let max_t = ((joint).motor).max_motor_torque;

    let speed_diff = target_speed - current_angular_speed;
    let gain = 10.0;
    let mut torque = speed_diff * gain;

    if torque > max_t {
        torque = max_t;
    } else if torque < -max_t {
        torque = -max_t;
    }

    return torque;
}
