type RigidBody = struct {
    mass: Int,
    vx: Int
};

pub fn rigid_body_new(mass: Int, vx: Int) -> RigidBody {
    return RigidBody {
        mass: mass,
        vx: vx
    };
}

pub fn rigid_body_mass(b: RigidBody) -> Int {
    return b.mass;
}
