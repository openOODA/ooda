// # Aerodynamic Drag, Lift & Fluid Resistance
//
// Logline: Calculates quadratic drag forces, Magnus effect spin forces, atmospheric density gradients, and airfoil lift profiles.
//
// Setup: Atmospheric density models and aerodynamic force coefficients for projectile, aircraft, and sports ball dynamics.
//
// Beats:
//   1. Define AtmosphereModel, AeroBody, and AeroForces data structures.
//   2. Compute barometric atmospheric density based on altitude (ISA standard model).
//   3. Evaluate Rayleigh quadratic drag, thin-airfoil lift, and Magnus rotational spin forces.

pub type AtmosphereModel = struct {
    sea_level_density: Float, // kg/m^3 (1.225)
    scale_height: Float,      // m (8500)
    temperature_lapse: Float,
};

pub type AeroBody = struct {
    cross_section_area: Float, // m^2
    drag_coefficient_cd: Float,
    lift_slope_cl_alpha: Float,
    magnus_coefficient_cm: Float,
    radius: Float,
};

pub type AeroForces = struct {
    drag_x: Float,
    drag_y: Float,
    drag_z: Float,
    lift_x: Float,
    lift_y: Float,
    lift_z: Float,
    magnus_x: Float,
    magnus_y: Float,
    magnus_z: Float,
    total_x: Float,
    total_y: Float,
    total_z: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn atmosphere_isa_standard() -> AtmosphereModel {
    return AtmosphereModel {
        sea_level_density: 1.225,
        scale_height: 8500.0,
        temperature_lapse: 0.0065,
    };
}

pub fn aero_body_sphere(radius: Float, cd: Float) -> AeroBody {
    let area = 3.141592653589793 * radius * radius;
    return AeroBody {
        cross_section_area: area,
        drag_coefficient_cd: cd,
        lift_slope_cl_alpha: 0.0,
        magnus_coefficient_cm: 0.25,
        radius: radius,
    };
}

pub fn aero_body_airfoil(area: Float, cd0: Float, cl_slope: Float) -> AeroBody {
    return AeroBody {
        cross_section_area: area,
        drag_coefficient_cd: cd0,
        lift_slope_cl_alpha: cl_slope,
        magnus_coefficient_cm: 0.0,
        radius: 1.0,
    };
}

// -------------------------------------------------------------------
// Atmospheric Density vs Altitude
// -------------------------------------------------------------------

/// ISA barometric density approximation: rho = rho_0 * (1 - L*h/T0)^4.256
pub fn atmosphere_density_at_altitude(
    altitude_m: Float,
    atmos: AtmosphereModel
) -> Float {
    if altitude_m <= 0.0 {
        return (atmos).sea_level_density;
    }
    // Exponential scale height approximation
    let h_ratio = altitude_m / (atmos).scale_height;
    if h_ratio > 10.0 {
        return 0.0;
    }
    // Exp approximation via polynomial decay
    let denom = 1.0 + h_ratio + (0.5 * h_ratio * h_ratio);
    return (atmos).sea_level_density / denom;
}

// -------------------------------------------------------------------
// Quadratic Drag & Magnus Effect Forces
// -------------------------------------------------------------------

/// Quadratic Rayleigh Drag: F_drag = - 0.5 * rho * v^2 * Cd * A * v_hat
pub fn aero_calculate_drag(
    vx: Float, vy: Float, vz: Float,
    density: Float,
    body: AeroBody
) -> AeroForces {
    let speed_sq = (vx * vx) + (vy * vy) + (vz * vz);
    if speed_sq < 0.000001 || density <= 0.0 {
        return AeroForces {
            drag_x: 0.0, drag_y: 0.0, drag_z: 0.0,
            lift_x: 0.0, lift_y: 0.0, lift_z: 0.0,
            magnus_x: 0.0, magnus_y: 0.0, magnus_z: 0.0,
            total_x: 0.0, total_y: 0.0, total_z: 0.0,
        };
    }

    let speed = sqrt(speed_sq);
    let inv_speed = 1.0 / speed;

    // Unit velocity vector
    let vhat_x = vx * inv_speed;
    let vhat_y = vy * inv_speed;
    let vhat_z = vz * inv_speed;

    // F_drag magnitude
    let drag_mag = 0.5 * density * speed_sq * (body).drag_coefficient_cd * (body).cross_section_area;

    let f_dx = - drag_mag * vhat_x;
    let f_dy = - drag_mag * vhat_y;
    let f_dz = - drag_mag * vhat_z;

    return AeroForces {
        drag_x: f_dx, drag_y: f_dy, drag_z: f_dz,
        lift_x: 0.0, lift_y: 0.0, lift_z: 0.0,
        magnus_x: 0.0, magnus_y: 0.0, magnus_z: 0.0,
        total_x: f_dx, total_y: f_dy, total_z: f_dz,
    };
}

/// Magnus Effect Spin Force: F_magnus = S * (omega x v)
pub fn aero_calculate_magnus(
    vx: Float, vy: Float, vz: Float,
    wx: Float, wy: Float, wz: Float,
    density: Float,
    body: AeroBody
) -> AeroForces {
    // Cross product: omega x v
    let cx = (wy * vz) - (wz * vy);
    let cy = (wz * vx) - (wx * vz);
    let cz = (wx * vy) - (wy * vx);

    let coeff = 0.5 * density * (body).cross_section_area * (body).radius * (body).magnus_coefficient_cm;

    let fx = coeff * cx;
    let fy = coeff * cy;
    let fz = coeff * cz;

    return AeroForces {
        drag_x: 0.0, drag_y: 0.0, drag_z: 0.0,
        lift_x: 0.0, lift_y: 0.0, lift_z: 0.0,
        magnus_x: fx, magnus_y: fy, magnus_z: fz,
        total_x: fx, total_y: fy, total_z: fz,
    };
}
