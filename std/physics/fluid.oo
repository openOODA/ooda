// # Fluid Mechanics Facade
//
// Logline: Re-exports SPH fluid dynamics, Eulerian grid solvers, particle systems, Navier-Stokes equations, and stubs.
//
// Setup: Pure module shim importing fluid mechanics companion submodules.
//
// Beats:
//   1. Import fluid smoothing kernels, particle dynamics, boundary domains, and Eulerian grids.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain backwards compatibility with computational fluid dynamics consumers.

import "./fluid_math.oo";
import "./fluid_particle.oo";
import "./fluid_domain.oo";
import "./fluid_grid.oo";
import "./fluid_engine.oo";
import "./fluid_stubs.oo";

pub fn shim_marker_vec3_new() -> Vec3 {
    return vec3_new(1.0, 2.0, 3.0);
}

pub fn shim_marker_vec3_normalize(v_in: Vec3) -> Vec3 {
    return vec3_normalize(v_in);
}

pub fn shim_marker_sph_kernel_new() -> SPHKernel {
    return sph_kernel_new(0.1);
}

pub fn shim_marker_fluid_particle_new() -> FluidParticle {
    let p: Vec3 = vec3_new(0.0, 0.0, 0.0);
    let v: Vec3 = vec3_zero();
    return fluid_particle_new(p, v, 1.0);
}

pub fn shim_marker_fluid_domain_new() -> FluidDomain {
    let mn: Vec3 = vec3_new(0.0, 0.0, 0.0);
    let mx: Vec3 = vec3_new(1.0, 1.0, 1.0);
    return fluid_domain_new(mn, mx);
}

pub fn shim_marker_fluid_cell_new() -> FluidCell {
    return fluid_cell_new();
}

pub fn shim_marker_fluid_grid_new() -> FluidGrid {
    return fluid_grid_new(8, 8, 8, 0.1);
}

pub fn shim_marker_fluid_solver_new() -> FluidSolver {
    return fluid_solver_new(0.01, 1000.0, 1000.0, 0.001, 0.1);
}

pub fn shim_marker_fluid_init() -> FluidSystem {
    return fluid_init();
}

pub fn shim_marker_fluid_do_work(obj: &FluidSystem) -> Int {
    return fluid_do_work(obj);
}
