// # Mass Moment of Inertia Tensor Computations
//
// Logline: Computes 3x3 inertia tensors, principal moments of inertia, parallel-axis transforms, and geometric bounding solid matrices.
//
// Setup: Closed-form analytical inertia tensor formulas for classic 3D geometric solids and rigid bodies.
//
// Beats:
//   1. Define 3x3 Matrix3x3 and PrincipalInertia structures.
//   2. Compute analytical inertia tensors for solid boxes, solid spheres, hollow spheres, and cylinders.
//   3. Apply Steiner's parallel-axis theorem to shift inertia tensors to arbitrary anchor offsets.

pub type Mat3x3 = struct {
    m00: Float, m01: Float, m02: Float,
    m10: Float, m11: Float, m12: Float,
    m20: Float, m21: Float, m22: Float,
};

pub type PrincipalInertia = struct {
    ixx: Float,
    iyy: Float,
    izz: Float,
};

// -------------------------------------------------------------------
// Matrix Helpers
// -------------------------------------------------------------------

pub fn mat3x3_identity() -> Mat3x3 {
    return Mat3x3 {
        m00: 1.0, m01: 0.0, m02: 0.0,
        m10: 0.0, m11: 1.0, m12: 0.0,
        m20: 0.0, m21: 0.0, m22: 1.0,
    };
}

pub fn mat3x3_diagonal(ixx: Float, iyy: Float, izz: Float) -> Mat3x3 {
    return Mat3x3 {
        m00: ixx, m01: 0.0, m02: 0.0,
        m10: 0.0, m11: iyy, m12: 0.0,
        m20: 0.0, m21: 0.0, m22: izz,
    };
}

// -------------------------------------------------------------------
// Standard Geometric Solid Inertia Formulas
// -------------------------------------------------------------------

/// Solid Box: Ixx = 1/12 * m * (h^2 + d^2), Iyy = 1/12 * m * (w^2 + d^2), Izz = 1/12 * m * (w^2 + h^2)
pub fn inertia_solid_box(mass: Float, width: Float, height: Float, depth: Float) -> PrincipalInertia {
    let inv12 = 0.08333333333333333;
    let w2 = width * width;
    let h2 = height * height;
    let d2 = depth * depth;

    let ixx = inv12 * mass * (h2 + d2);
    let iyy = inv12 * mass * (w2 + d2);
    let izz = inv12 * mass * (w2 + h2);

    return PrincipalInertia { ixx: ixx, iyy: iyy, izz: izz };
}

/// Solid Sphere: I = 2/5 * m * r^2
pub fn inertia_solid_sphere(mass: Float, radius: Float) -> PrincipalInertia {
    let i = 0.4 * mass * radius * radius;
    return PrincipalInertia { ixx: i, iyy: i, izz: i };
}

/// Hollow Thin-Shelled Sphere: I = 2/3 * m * r^2
pub fn inertia_hollow_sphere(mass: Float, radius: Float) -> PrincipalInertia {
    let i = 0.6666666666666666 * mass * radius * radius;
    return PrincipalInertia { ixx: i, iyy: i, izz: i };
}

/// Solid Cylinder along Y axis: Iyy = 1/2 * m * r^2, Ixx = Izz = 1/12 * m * (3*r^2 + h^2)
pub fn inertia_solid_cylinder_y(mass: Float, radius: Float, height: Float) -> PrincipalInertia {
    let r2 = radius * radius;
    let h2 = height * height;
    let iyy = 0.5 * mass * r2;
    let inv12 = 0.08333333333333333;
    let side_i = inv12 * mass * ((3.0 * r2) + h2);

    return PrincipalInertia { ixx: side_i, iyy: iyy, izz: side_i };
}

/// Capsule along Y axis approximated by cylinder + two hemisphere ends
pub fn inertia_solid_capsule_y(mass: Float, radius: Float, cylinder_height: Float) -> PrincipalInertia {
    let cyl_i = inertia_solid_cylinder_y(mass * 0.7, radius, cylinder_height);
    let cap_i = inertia_solid_sphere(mass * 0.3, radius);
    return PrincipalInertia {
        ixx: (cyl_i).ixx + (cap_i).ixx,
        iyy: (cyl_i).iyy + (cap_i).iyy,
        izz: (cyl_i).izz + (cap_i).izz,
    };
}

// -------------------------------------------------------------------
// Parallel Axis Theorem (Steiner's Theorem):
// I_new = I_cm + m * (d^2 * I - d (x) d)
// -------------------------------------------------------------------

pub fn inertia_parallel_axis_shift(
    base: PrincipalInertia,
    mass: Float,
    dx: Float,
    dy: Float,
    dz: Float
) -> Mat3x3 {
    let dx2 = dx * dx;
    let dy2 = dy * dy;
    let dz2 = dz * dz;

    let m00 = (base).ixx + (mass * (dy2 + dz2));
    let m11 = (base).iyy + (mass * (dx2 + dz2));
    let m22 = (base).izz + (mass * (dx2 + dy2));

    let m01 = -(mass * dx * dy);
    let m02 = -(mass * dx * dz);
    let m12 = -(mass * dy * dz);

    return Mat3x3 {
        m00: m00, m01: m01, m02: m02,
        m10: m01, m11: m11, m12: m12,
        m20: m02, m21: m12, m22: m22,
    };
}
