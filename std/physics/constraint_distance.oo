// # Bilateral Distance & Rod Rigidity Constraint
//
// Logline: Enforces fixed-distance and bounded-distance constraints between two particles or rigid body anchor points.
//
// Setup: Positional and velocity-level bilateral kinematic distance constraints for rigid links and rods.
//
// Beats:
//   1. Define DistanceConstraint and DistanceConstraintState structures.
//   2. Calculate positional constraint error: C(x1, x2) = |x1 - x2| - target_distance.
//   3. Implement Baumgarte positional relaxation impulses and relative velocity damping.

pub type DistanceConstraint = struct {
    body_a_id: Int,
    body_b_id: Int,
    target_distance: Float,
    stiffness: Float,
    damping: Float,
    break_force: Float,
    is_broken: Int,
};

pub type DistanceCorrection = struct {
    p1_dx: Float,
    p1_dy: Float,
    p1_dz: Float,
    p2_dx: Float,
    p2_dy: Float,
    p2_dz: Float,
    current_distance: Float,
    error: Float,
    impulse: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn distance_constraint_new(
    body_a: Int,
    body_b: Int,
    target_dist: Float,
    stiffness: Float
) -> DistanceConstraint {
    return DistanceConstraint {
        body_a_id: body_a,
        body_b_id: body_b,
        target_distance: target_dist,
        stiffness: stiffness,
        damping: 0.1,
        break_force: 100000.0,
        is_broken: 0,
    };
}

// -------------------------------------------------------------------
// Position-Level Constraint Solving (PBD)
// -------------------------------------------------------------------

pub fn distance_constraint_solve_position(
    c: DistanceConstraint,
    p1_x: Float, p1_y: Float, p1_z: Float,
    p2_x: Float, p2_y: Float, p2_z: Float,
    inv_m1: Float, inv_m2: Float
) -> DistanceCorrection {
    if (c).is_broken != 0 {
        return DistanceCorrection {
            p1_dx: 0.0, p1_dy: 0.0, p1_dz: 0.0,
            p2_dx: 0.0, p2_dy: 0.0, p2_dz: 0.0,
            current_distance: 0.0,
            error: 0.0,
            impulse: 0.0,
        };
    }

    let dx = p2_x - p1_x;
    let dy = p2_y - p1_y;
    let dz = p2_z - p1_z;

    let dist = sqrt((dx * dx) + (dy * dy) + (dz * dz));
    if dist < 0.000001 {
        return DistanceCorrection {
            p1_dx: 0.0, p1_dy: 0.0, p1_dz: 0.0,
            p2_dx: 0.0, p2_dy: 0.0, p2_dz: 0.0,
            current_distance: 0.0,
            error: 0.0,
            impulse: 0.0,
        };
    }

    let w_sum = inv_m1 + inv_m2;
    if w_sum <= 0.000001 {
        return DistanceCorrection {
            p1_dx: 0.0, p1_dy: 0.0, p1_dz: 0.0,
            p2_dx: 0.0, p2_dy: 0.0, p2_dz: 0.0,
            current_distance: dist,
            error: 0.0,
            impulse: 0.0,
        };
    }

    // Constraint error: C = dist - target_distance
    let err = dist - (c).target_distance;
    let inv_dist = 1.0 / dist;
    let dir_x = dx * inv_dist;
    let dir_y = dy * inv_dist;
    let dir_z = dz * inv_dist;

    // Delta lambda = - err / w_sum * stiffness
    let delta_lambda = (err / w_sum) * (c).stiffness;

    let p1_dx = dir_x * (inv_m1 * delta_lambda);
    let p1_dy = dir_y * (inv_m1 * delta_lambda);
    let p1_dz = dir_z * (inv_m1 * delta_lambda);

    let p2_dx = - dir_x * (inv_m2 * delta_lambda);
    let p2_dy = - dir_y * (inv_m2 * delta_lambda);
    let p2_dz = - dir_z * (inv_m2 * delta_lambda);

    return DistanceCorrection {
        p1_dx: p1_dx, p1_dy: p1_dy, p1_dz: p1_dz,
        p2_dx: p2_dx, p2_dy: p2_dy, p2_dz: p2_dz,
        current_distance: dist,
        error: err,
        impulse: delta_lambda,
    };
}
