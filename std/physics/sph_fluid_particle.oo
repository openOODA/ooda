// # Smoothed Particle Hydrodynamics (SPH) Particle State
//
// Logline: Defines SPH fluid particles tracking mass, density, pressure, smoothing length h, velocity field, and particle neighbours.
//
// Setup: Lagrange fluid particle data models for Smoothed Particle Hydrodynamics Navier-Stokes solvers.
//
// Beats:
//   1. Define SphParticle and SphFluidConfig data structures.
//   2. Compute Tait's equation of state for pressure field calculation from rest density.
//   3. Implement particle advection, acceleration accumulation, and boundary containment.

pub type SphParticle = struct {
    x: Float,
    y: Float,
    z: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    fx: Float,
    fy: Float,
    fz: Float,
    density: Float,
    pressure: Float,
    mass: Float,
    smoothing_h: Float,
    is_boundary: Int,
};

pub type SphFluidConfig = struct {
    rest_density: Float,
    gas_constant_k: Float,
    viscosity_mu: Float,
    smoothing_radius_h: Float,
    surface_tension_sigma: Float,
    gravity_y: Float,
    speed_of_sound: Float,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn sph_particle_new(
    x: Float, y: Float, z: Float,
    mass: Float,
    h: Float
) -> SphParticle {
    return SphParticle {
        x: x, y: y, z: z,
        vx: 0.0, vy: 0.0, vz: 0.0,
        fx: 0.0, fy: 0.0, fz: 0.0,
        density: 1000.0,
        pressure: 0.0,
        mass: mass,
        smoothing_h: h,
        is_boundary: 0,
    };
}

pub fn sph_fluid_config_default() -> SphFluidConfig {
    return SphFluidConfig {
        rest_density: 1000.0,
        gas_constant_k: 2000.0,
        viscosity_mu: 0.05,
        smoothing_radius_h: 0.0457,
        surface_tension_sigma: 0.0728,
        gravity_y: -9.81,
        speed_of_sound: 50.0,
    };
}

// -------------------------------------------------------------------
// Equation of State (Tait & Ideal Gas)
// -------------------------------------------------------------------

/// Ideal Gas equation of state: P = k * (rho - rho_0)
pub fn sph_compute_pressure_ideal(
    density: Float,
    rest_density: Float,
    k: Float
) -> Float {
    let diff = density - rest_density;
    if diff < 0.0 {
        return 0.0;
    }
    return k * diff;
}

/// Tait Equation of State: P = B * ((rho / rho_0)^gamma - 1)
pub fn sph_compute_pressure_tait(
    density: Float,
    rest_density: Float,
    speed_of_sound: Float
) -> Float {
    let ratio = density / rest_density;
    let b = (rest_density * speed_of_sound * speed_of_sound) / 7.0;
    // Approximating ratio^7 with multiplication
    let r2 = ratio * ratio;
    let r4 = r2 * r2;
    let r7 = r4 * r2 * ratio;
    let p = b * (r7 - 1.0);
    if p < 0.0 {
        return 0.0;
    }
    return p;
}

// -------------------------------------------------------------------
// Advection & Kinematic Stepping
// -------------------------------------------------------------------

pub fn sph_particle_step(
    p: SphParticle,
    gx: Float, gy: Float, gz: Float,
    dt: Float
) -> SphParticle {
    if (p).is_boundary != 0 || (p).density < 0.000001 {
        return p;
    }

    let inv_rho = 1.0 / (p).density;
    let ax = ((p).fx * inv_rho) + gx;
    let ay = ((p).fy * inv_rho) + gy;
    let az = ((p).fz * inv_rho) + gz;

    let nvx = (p).vx + (ax * dt);
    let nvy = (p).vy + (ay * dt);
    let nvz = (p).vz + (az * dt);

    let nx = (p).x + (nvx * dt);
    let ny = (p).y + (nvy * dt);
    let nz = (p).z + (nvz * dt);

    return SphParticle {
        x: nx, y: ny, z: nz,
        vx: nvx, vy: nvy, vz: nvz,
        fx: 0.0, fy: 0.0, fz: 0.0,
        density: (p).density,
        pressure: (p).pressure,
        mass: (p).mass,
        smoothing_h: (p).smoothing_h,
        is_boundary: (p).is_boundary,
    };
}
