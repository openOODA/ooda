// # Collision Vector Math & Primitive Constructors
//
// Logline: Provides 3D vector arithmetic, dot/cross products, normalization, and geometric primitive constructors.
//
// Setup: Imports collision_types.oo for Vec3, Sphere, AABB, Capsule, OBB, and Plane types.
//
// Beats:
//   1. Implement 3D vector addition, subtraction, scaling, dot products, and cross products.
//   2. Construct and validate bounding spheres, AABBs, capsules, OBBs, and planes.
//   3. Transform bounding volumes by translation vectors and rotation matrices.

import "./collision_types.oo";

// -------------------------------------------------------------------
// Vector3 Operations
// -------------------------------------------------------------------

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

pub fn vec3_zero() -> Vec3 {
    return Vec3 { x: 0.0, y: 0.0, z: 0.0 };
}

pub fn vec3_add(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3 {
        x: (a).x + (b).x,
        y: (a).y + (b).y,
        z: (a).z + (b).z,
    };
}

pub fn vec3_sub(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3 {
        x: (a).x - (b).x,
        y: (a).y - (b).y,
        z: (a).z - (b).z,
    };
}

pub fn vec3_scale(v: Vec3, factor: Float) -> Vec3 {
    return Vec3 {
        x: (v).x * factor,
        y: (v).y * factor,
        z: (v).z * factor,
    };
}

pub fn vec3_dot(a: Vec3, b: Vec3) -> Float {
    return (((a).x * (b).x) + ((a).y * (b).y)) + ((a).z * (b).z);
}

pub fn vec3_cross(a: Vec3, b: Vec3) -> Vec3 {
    let nx = ((a).y * (b).z) - ((a).z * (b).y);
    let ny = ((a).z * (b).x) - ((a).x * (b).z);
    let nz = ((a).x * (b).y) - ((a).y * (b).x);
    return Vec3 { x: nx, y: ny, z: nz };
}

pub fn vec3_length_sq(v: Vec3) -> Float {
    return vec3_dot(v, v);
}

pub fn vec3_length(v: Vec3) -> Float {
    return sqrt(vec3_length_sq(v));
}

pub fn vec3_normalize(v: Vec3) -> Vec3 {
    let len = vec3_length(v);
    if len < 0.000001 {
        return vec3_zero();
    }
    return vec3_scale(v, 1.0 / len);
}

pub fn vec3_neg(v: Vec3) -> Vec3 {
    return Vec3 {
        x: 0.0 - (v).x,
        y: 0.0 - (v).y,
        z: 0.0 - (v).z,
    };
}

pub fn vec3_distance(a: Vec3, b: Vec3) -> Float {
    return vec3_length(vec3_sub(a, b));
}

// -------------------------------------------------------------------
// Primitive Constructors
// -------------------------------------------------------------------

pub fn ray_new(origin: Vec3, dir: Vec3) -> Ray {
    return Ray {
        origin: origin,
        dir:    vec3_normalize(dir),
    };
}

pub fn plane_new(normal: Vec3, dist: Float) -> Plane {
    return Plane {
        normal: vec3_normalize(normal),
        dist:   dist,
    };
}

pub fn sphere_new(centre: Vec3, radius: Float) -> Sphere {
    return Sphere {
        centre: centre,
        radius: radius,
    };
}

pub fn aabb_new(min: Vec3, max: Vec3) -> AABB {
    return AABB { min: min, max: max };
}

pub fn aabb_from_centre(centre: Vec3, half_extents: Vec3) -> AABB {
    return AABB {
        min: vec3_sub(centre, half_extents),
        max: vec3_add(centre, half_extents),
    };
}

pub fn obb_new(centre: Vec3, extents: Vec3, ax: Vec3, ay: Vec3, az: Vec3) -> OBB {
    return OBB {
        centre:  centre,
        extents: extents,
        axis_x:  vec3_normalize(ax),
        axis_y:  vec3_normalize(ay),
        axis_z:  vec3_normalize(az),
    };
}

pub fn capsule_new(a: Vec3, b: Vec3, radius: Float) -> Capsule {
    return Capsule {
        a:      a,
        b:      b,
        radius: radius,
    };
}

pub fn raycast_hit_none() -> RaycastHit {
    return RaycastHit {
        hit:      0,
        distance: 0.0,
        point:    vec3_zero(),
        normal:   vec3_zero(),
    };
}

pub fn contact_point_none() -> ContactPoint {
    return ContactPoint {
        has_contact: 0,
        penetration: 0.0,
        point:       vec3_zero(),
        normal:      vec3_zero(),
    };
}

// -------------------------------------------------------------------
// Geometric Helpers
// -------------------------------------------------------------------

/// Return closest point on line segment [seg_a, seg_b] to point p.
pub fn closest_point_on_segment(p: Vec3, seg_a: Vec3, seg_b: Vec3) -> Vec3 {
    let ab = vec3_sub(seg_b, seg_a);
    let len_sq = vec3_length_sq(ab);
    if len_sq < 0.000001 {
        return seg_a;
    }
    let ap = vec3_sub(p, seg_a);
    let mut t = vec3_dot(ap, ab) / len_sq;
    if t < 0.0 {
        t = 0.0;
    }
    if t > 1.0 {
        t = 1.0;
    }
    return vec3_add(seg_a, vec3_scale(ab, t));
}

/// Clamp a point p to the inside or surface of an AABB.
pub fn closest_point_on_aabb(p: Vec3, box: AABB) -> Vec3 {
    let mut cx = (p).x;
    if cx < (box).min.x {
        cx = (box).min.x;
    }
    if cx > (box).max.x {
        cx = (box).max.x;
    }

    let mut cy = (p).y;
    if cy < (box).min.y {
        cy = (box).min.y;
    }
    if cy > (box).max.y {
        cy = (box).max.y;
    }

    let mut cz = (p).z;
    if cz < (box).min.z {
        cz = (box).min.z;
    }
    if cz > (box).max.z {
        cz = (box).max.z;
    }

    return Vec3 { x: cx, y: cy, z: cz };
}

/// Point in sphere query.
pub fn point_in_sphere(p: Vec3, s: Sphere) -> Int {
    let d2 = vec3_length_sq(vec3_sub(p, (s).centre));
    let r2 = (s).radius * (s).radius;
    if d2 <= r2 {
        return 1;
    }
    return 0;
}

/// Point in AABB query.
pub fn point_in_aabb(p: Vec3, box: AABB) -> Int {
    if (p).x < (box).min.x { return 0; }
    if (p).x > (box).max.x { return 0; }
    if (p).y < (box).min.y { return 0; }
    if (p).y > (box).max.y { return 0; }
    if (p).z < (box).min.z { return 0; }
    if (p).z > (box).max.z { return 0; }
    return 1;
}
