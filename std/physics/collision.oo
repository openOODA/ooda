// # Collision Detection Facade
//
// Logline: Re-exports collision geometry types, narrowphase pair intersection tests, raycasting, and contact manifolds.
//
// Setup: Pure module shim importing collision physics companion submodules.
//
// Beats:
//   1. Import collision primitive types, geometric operations, narrowphase tests, and contact generation.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain backwards compatibility with physics engines and collision queries.

import "./collision_types.oo";
import "./collision_ops.oo";
import "./collision_narrow.oo";
import "./collision_contacts.oo";
import "./collision_engine.oo";

pub fn shim_marker_vec3_new() -> Vec3 {
    return vec3_new(1.0, 2.0, 3.0);
}

pub fn shim_marker_vec3_normalize(v_in: Vec3) -> Vec3 {
    return vec3_normalize(v_in);
}

pub fn shim_marker_sphere_new(centre_v: Vec3) -> Sphere {
    return sphere_new(centre_v, 1.0);
}

pub fn shim_marker_sphere_collide_sphere(sph1: Sphere, sph2: Sphere) -> ContactPoint {
    return sphere_collide_sphere(sph1, sph2);
}

pub fn shim_marker_aabb_collide_aabb(box1: AABB, box2: AABB) -> ContactPoint {
    return aabb_collide_aabb(box1, box2);
}

pub fn shim_marker_capsule_collide_sphere(cap: Capsule, sph: Sphere) -> ContactPoint {
    return capsule_collide_sphere(cap, sph);
}

pub fn shim_marker_ray_intersects_sphere(ray_v: Ray, sph: Sphere) -> RaycastHit {
    return ray_intersects_sphere(ray_v, sph);
}

pub fn shim_marker_resolve_contact_impulse(v1: Vec3, v2: Vec3, n_v: Vec3) -> Float {
    return resolve_contact_impulse(v1, v2, 1.0, 1.0, n_v, 0.5);
}
