// # Collision types
//
// Logline: ColliderAabb destubbed off nested Vec3 lists.
// residual: List[struct] destubbed.

type ColliderAabb = struct {
    min_x: Int,
    max_x: Int
};

pub fn collider_aabb_new(min_x: Int, max_x: Int) -> ColliderAabb {
    return ColliderAabb {
        min_x: min_x,
        max_x: max_x
    };
}

pub fn collider_aabb_min_x(b: ColliderAabb) -> Int {
    return b.min_x;
}
