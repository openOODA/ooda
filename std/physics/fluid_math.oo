// # Fluid math
//
// Logline: FluidVec3 destubbed off pub type f64 Vec3.
// residual: destubbed to Int floor.

type FluidVec3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn fluid_vec3_new(x: Int, y: Int, z: Int) -> FluidVec3 {
    return FluidVec3 { x: x, y: y, z: z };
}

pub fn fluid_vec3_x(v: FluidVec3) -> Int {
    return v.x;
}
