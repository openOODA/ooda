// # Keplerian Orbital Mechanics & Conic Sections
//
// Logline: Computes semi-major axis, eccentricity, true anomaly, orbital periods, escape velocities, and vis-viva equation dynamics.
//
// Setup: Two-body celestial orbital dynamics, energy equations, and orbital maneuver calculations.
//
// Beats:
//   1. Define CentralBody, KeplerianOrbit, and OrbitalVectors data structures.
//   2. Compute vis-viva instantaneous speed (v^2 = mu * (2/r - 1/a)) and escape velocities.
//   3. Calculate orbital period via Kepler's third law and Hohmann transfer delta-v requirements.

pub type CentralBody = struct {
    gravitational_parameter_mu: Float, // G * M (m^3 / s^2)
    radius_m: Float,
    mass_kg: Float,
};

pub type KeplerianOrbit = struct {
    semi_major_axis_a: Float,
    eccentricity_e: Float,
    inclination_rad: Float,
    periapsis_radius: Float,
    apoapsis_radius: Float,
    orbital_period_s: Float,
};

pub type HohmannTransfer = struct {
    delta_v_1: Float,
    delta_v_2: Float,
    total_delta_v: Float,
    transfer_time_s: Float,
};

// -------------------------------------------------------------------
// Standard Central Bodies (Earth, Moon, Sun)
// -------------------------------------------------------------------

pub fn central_body_earth() -> CentralBody {
    return CentralBody {
        gravitational_parameter_mu: 398600441800000.0, // 3.986e14 m^3/s^2
        radius_m: 6371000.0,
        mass_kg: 5972000000000000000000000.0,
    };
}

pub fn central_body_moon() -> CentralBody {
    return CentralBody {
        gravitational_parameter_mu: 4904869500000.0,
        radius_m: 1737400.0,
        mass_kg: 73420000000000000000000.0,
    };
}

// -------------------------------------------------------------------
// Orbital Energies & Velocity Formulations
// -------------------------------------------------------------------

/// Vis-Viva Equation: v = sqrt(mu * (2/r - 1/a))
pub fn orbital_vis_viva_speed(
    r: Float,
    semi_major_axis: Float,
    mu: Float
) -> Float {
    if r <= 0.0 || semi_major_axis <= 0.0 || mu <= 0.0 {
        return 0.0;
    }
    let term = (2.0 / r) - (1.0 / semi_major_axis);
    if term <= 0.0 {
        return 0.0;
    }
    return sqrt(mu * term);
}

/// Circular Orbit Speed: v_c = sqrt(mu / r)
pub fn orbital_circular_speed(r: Float, mu: Float) -> Float {
    if r <= 0.0 || mu <= 0.0 {
        return 0.0;
    }
    return sqrt(mu / r);
}

/// Escape Velocity: v_esc = sqrt(2 * mu / r)
pub fn orbital_escape_velocity(r: Float, mu: Float) -> Float {
    if r <= 0.0 || mu <= 0.0 {
        return 0.0;
    }
    return sqrt((2.0 * mu) / r);
}

/// Kepler's Third Law Period: T = 2 * pi * sqrt(a^3 / mu)
pub fn orbital_kepler_period(semi_major_axis: Float, mu: Float) -> Float {
    if semi_major_axis <= 0.0 || mu <= 0.0 {
        return 0.0;
    }
    let a3 = semi_major_axis * semi_major_axis * semi_major_axis;
    let ratio = a3 / mu;
    return 2.0 * 3.141592653589793 * sqrt(ratio);
}

// -------------------------------------------------------------------
// Orbital Maneuvers (Hohmann Transfer)
// -------------------------------------------------------------------

pub fn orbital_hohmann_transfer(
    r1: Float,
    r2: Float,
    mu: Float
) -> HohmannTransfer {
    if r1 <= 0.0 || r2 <= 0.0 || mu <= 0.0 {
        return HohmannTransfer {
            delta_v_1: 0.0,
            delta_v_2: 0.0,
            total_delta_v: 0.0,
            transfer_time_s: 0.0,
        };
    }

    let a_tx = 0.5 * (r1 + r2);
    let v_c1 = orbital_circular_speed(r1, mu);
    let v_c2 = orbital_circular_speed(r2, mu);

    let v_tx1 = orbital_vis_viva_speed(r1, a_tx, mu);
    let v_tx2 = orbital_vis_viva_speed(r2, a_tx, mu);

    let mut dv1 = v_tx1 - v_c1;
    if dv1 < 0.0 { dv1 = -dv1; }

    let mut dv2 = v_c2 - v_tx2;
    if dv2 < 0.0 { dv2 = -dv2; }

    let total_dv = dv1 + dv2;
    let t_period = orbital_kepler_period(a_tx, mu);
    let transfer_t = 0.5 * t_period;

    return HohmannTransfer {
        delta_v_1: dv1,
        delta_v_2: dv2,
        total_delta_v: total_dv,
        transfer_time_s: transfer_t,
    };
}
