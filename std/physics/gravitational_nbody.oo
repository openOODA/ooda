// # Gravitational N-Body & Newton's Universal Gravitation
//
// Logline: Evaluates mutual Newtonian gravitational attractions, softening parameters, centre of mass, and orbital kinetic energies.
//
// Setup: Direct pairwise O(N^2) gravitational interaction evaluations with Plummer potential softening.
//
// Beats:
//   1. Define GravBody, NBodySystem, and GravForcePair data structures.
//   2. Compute softened pairwise gravitational forces (F = G * m1 * m2 * r / (r^2 + eps^2)^(3/2)).
//   3. Compute gravitational potential energy, center of mass, and kinematic integration steps.

pub type GravBody = struct {
    x: Float,
    y: Float,
    z: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    ax: Float,
    ay: Float,
    az: Float,
    mass: Float
};

pub type GravForcePair = struct {
    f1_x: Float,
    f1_y: Float,
    f1_z: Float,
    f2_x: Float,
    f2_y: Float,
    f2_z: Float,
    potential_energy: Float
};

pub type NBodyConfig = struct {
    grav_constant_g: Float,
    softening_epsilon: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn grav_body_new(
    x: Float, y: Float, z: Float,
    vx: Float, vy: Float, vz: Float,
    mass: Float
) -> GravBody {
    return GravBody {
        x: x, y: y, z: z,
        vx: vx, vy: vy, vz: vz,
        ax: 0.0, ay: 0.0, az: 0.0,
        mass: mass
    };
}

pub fn nbody_config_default() -> NBodyConfig {
    return NBodyConfig {
        grav_constant_g: 0.000000000066743,
        softening_epsilon: 1000.0
    };
}

pub fn nbody_config_normalized() -> NBodyConfig {
    return NBodyConfig {
        grav_constant_g: 1.0,
        softening_epsilon: 0.01
    };
}

// -------------------------------------------------------------------
// Softened Pairwise Gravitational Force (Plummer model)
// F_ij = G * m_i * m_j * (r_j - r_i) / (r_ij^2 + eps^2)^(3/2)
// -------------------------------------------------------------------

pub fn grav_compute_pair_force(
    b1: GravBody,
    b2: GravBody,
    cfg: NBodyConfig
) -> GravForcePair {
    let dx = (b2).x - (b1).x;
    let dy = (b2).y - (b1).y;
    let dz = (b2).z - (b1).z;

    let r_sq = (dx * dx) + (dy * dy) + (dz * dz);
    let eps_sq = (cfg).softening_epsilon * (cfg).softening_epsilon;
    let denom_base = r_sq + eps_sq;

    let denom_sqrt = sqrt(denom_base);
    let denom = denom_base * denom_sqrt; // (r^2 + eps^2)^(3/2)

    if denom <= 0.0000000001 {
        return GravForcePair {
            f1_x: 0.0, f1_y: 0.0, f1_z: 0.0,
            f2_x: 0.0, f2_y: 0.0, f2_z: 0.0,
            potential_energy: 0.0
        };
    }

    let g_m1_m2 = (cfg).grav_constant_g * (b1).mass * (b2).mass;
    let factor = g_m1_m2 / denom;

    let fx = factor * dx;
    let fy = factor * dy;
    let fz = factor * dz;

    // Potential energy U = - G * m1 * m2 / sqrt(r^2 + eps^2)
    let pot = - g_m1_m2 / denom_sqrt;

    return GravForcePair {
        f1_x: fx, f1_y: fy, f1_z: fz,
        f2_x: -fx, f2_y: -fy, f2_z: -fz,
        potential_energy: pot
    };
}

// -------------------------------------------------------------------
// Body Integration Step
// -------------------------------------------------------------------

pub fn grav_body_step_euler(b: GravBody, dt: Float) -> GravBody {
    let nvx = (b).vx + ((b).ax * dt);
    let nvy = (b).vy + ((b).ay * dt);
    let nvz = (b).vz + ((b).az * dt);

    let nx = (b).x + (nvx * dt);
    let ny = (b).y + (nvy * dt);
    let nz = (b).z + (nvz * dt);

    return GravBody {
        x: nx, y: ny, z: nz,
        vx: nvx, vy: nvy, vz: nvz,
        ax: 0.0, ay: 0.0, az: 0.0,
        mass: (b).mass
    };
}
