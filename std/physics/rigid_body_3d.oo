// # 3D Rigid Body Spatial Dynamics & Newton-Euler Equations
//
// Logline: Simulates 6-DOF 3D rigid bodies with 3D spatial velocity, angular orientation, mass properties, and torque accumulation.
//
// Setup: Newton-Euler equations of motion with diagonalized inertia tensor and 3D spatial kinematics.
//
// Beats:
//   1. Define 3D RigidBody3D state with linear and angular momentum, torque, and principal inertia.
//   2. Apply spatial forces at arbitrary world points to induce linear and rotational accelerations.
//   3. Implement symplectic spatial stepping, velocity damping, and point velocity evaluations.

pub type Vec3F = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub type RigidBody3D = struct {
    px: Float,
    py: Float,
    pz: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    rot_x: Float,
    rot_y: Float,
    rot_z: Float,
    ang_vx: Float,
    ang_vy: Float,
    ang_vz: Float,
    fx: Float,
    fy: Float,
    fz: Float,
    tx: Float,
    ty: Float,
    tz: Float,
    mass: Float,
    inv_mass: Float,
    ixx: Float,
    iyy: Float,
    izz: Float,
    inv_ixx: Float,
    inv_iyy: Float,
    inv_izz: Float,
    linear_damping: Float,
    angular_damping: Float,
    restitution: Float,
    friction: Float,
    is_static: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn rigid_body_3d_new(
    px: Float, py: Float, pz: Float,
    mass: Float,
    ixx: Float, iyy: Float, izz: Float
) -> RigidBody3D {
    let mut inv_m = 0.0;
    let mut inv_x = 0.0;
    let mut inv_y = 0.0;
    let mut inv_z = 0.0;
    let mut is_st = 0;

    if mass > 0.000001 {
        inv_m = 1.0 / mass;
    } else {
        is_st = 1;
    }
    if ixx > 0.000001 { inv_x = 1.0 / ixx; }
    if iyy > 0.000001 { inv_y = 1.0 / iyy; }
    if izz > 0.000001 { inv_z = 1.0 / izz; }

    return RigidBody3D {
        px: px, py: py, pz: pz,
        vx: 0.0, vy: 0.0, vz: 0.0,
        rot_x: 0.0, rot_y: 0.0, rot_z: 0.0,
        ang_vx: 0.0, ang_vy: 0.0, ang_vz: 0.0,
        fx: 0.0, fy: 0.0, fz: 0.0,
        tx: 0.0, ty: 0.0, tz: 0.0,
        mass: mass, inv_mass: inv_m,
        ixx: ixx, iyy: iyy, izz: izz,
        inv_ixx: inv_x, inv_iyy: inv_y, inv_izz: inv_z,
        linear_damping: 0.999, angular_damping: 0.995,
        restitution: 0.6, friction: 0.4,
        is_static: is_st,
    };
}

// -------------------------------------------------------------------
// Force & Torque Applications
// -------------------------------------------------------------------

pub fn rigid_body_3d_apply_force(rb: RigidBody3D, fx: Float, fy: Float, fz: Float) -> RigidBody3D {
    if (rb).is_static != 0 { return rb; }
    return RigidBody3D {
        px: (rb).px, py: (rb).py, pz: (rb).pz,
        vx: (rb).vx, vy: (rb).vy, vz: (rb).vz,
        rot_x: (rb).rot_x, rot_y: (rb).rot_y, rot_z: (rb).rot_z,
        ang_vx: (rb).ang_vx, ang_vy: (rb).ang_vy, ang_vz: (rb).ang_vz,
        fx: (rb).fx + fx, fy: (rb).fy + fy, fz: (rb).fz + fz,
        tx: (rb).tx, ty: (rb).ty, tz: (rb).tz,
        mass: (rb).mass, inv_mass: (rb).inv_mass,
        ixx: (rb).ixx, iyy: (rb).iyy, izz: (rb).izz,
        inv_ixx: (rb).inv_ixx, inv_iyy: (rb).inv_iyy, inv_izz: (rb).inv_izz,
        linear_damping: (rb).linear_damping, angular_damping: (rb).angular_damping,
        restitution: (rb).restitution, friction: (rb).friction,
        is_static: (rb).is_static,
    };
}

pub fn rigid_body_3d_apply_torque(rb: RigidBody3D, tx: Float, ty: Float, tz: Float) -> RigidBody3D {
    if (rb).is_static != 0 { return rb; }
    return RigidBody3D {
        px: (rb).px, py: (rb).py, pz: (rb).pz,
        vx: (rb).vx, vy: (rb).vy, vz: (rb).vz,
        rot_x: (rb).rot_x, rot_y: (rb).rot_y, rot_z: (rb).rot_z,
        ang_vx: (rb).ang_vx, ang_vy: (rb).ang_vy, ang_vz: (rb).ang_vz,
        fx: (rb).fx, fy: (rb).fy, fz: (rb).fz,
        tx: (rb).tx + tx, ty: (rb).ty + ty, tz: (rb).tz + tz,
        mass: (rb).mass, inv_mass: (rb).inv_mass,
        ixx: (rb).ixx, iyy: (rb).iyy, izz: (rb).izz,
        inv_ixx: (rb).inv_ixx, inv_iyy: (rb).inv_iyy, inv_izz: (rb).inv_izz,
        linear_damping: (rb).linear_damping, angular_damping: (rb).angular_damping,
        restitution: (rb).restitution, friction: (rb).friction,
        is_static: (rb).is_static,
    };
}

pub fn rigid_body_3d_apply_force_at_world_point(
    rb: RigidBody3D,
    fx: Float, fy: Float, fz: Float,
    wx: Float, wy: Float, wz: Float
) -> RigidBody3D {
    if (rb).is_static != 0 { return rb; }
    let rx = wx - (rb).px;
    let ry = wy - (rb).py;
    let rz = wz - (rb).pz;

    // Torque = r x F
    let gen_tx = (ry * fz) - (rz * fy);
    let gen_ty = (rz * fx) - (rx * fz);
    let gen_tz = (rx * fy) - (ry * fx);

    return RigidBody3D {
        px: (rb).px, py: (rb).py, pz: (rb).pz,
        vx: (rb).vx, vy: (rb).vy, vz: (rb).vz,
        rot_x: (rb).rot_x, rot_y: (rb).rot_y, rot_z: (rb).rot_z,
        ang_vx: (rb).ang_vx, ang_vy: (rb).ang_vy, ang_vz: (rb).ang_vz,
        fx: (rb).fx + fx, fy: (rb).fy + fy, fz: (rb).fz + fz,
        tx: (rb).tx + gen_tx, ty: (rb).ty + gen_ty, tz: (rb).tz + gen_tz,
        mass: (rb).mass, inv_mass: (rb).inv_mass,
        ixx: (rb).ixx, iyy: (rb).iyy, izz: (rb).izz,
        inv_ixx: (rb).inv_ixx, inv_iyy: (rb).inv_iyy, inv_izz: (rb).inv_izz,
        linear_damping: (rb).linear_damping, angular_damping: (rb).angular_damping,
        restitution: (rb).restitution, friction: (rb).friction,
        is_static: (rb).is_static,
    };
}

// -------------------------------------------------------------------
// Integration Step & Point Velocity
// -------------------------------------------------------------------

pub fn rigid_body_3d_step(rb: RigidBody3D, gx: Float, gy: Float, gz: Float, dt: Float) -> RigidBody3D {
    if (rb).is_static != 0 { return rb; }

    let ax = ((rb).fx * (rb).inv_mass) + gx;
    let ay = ((rb).fy * (rb).inv_mass) + gy;
    let az = ((rb).fz * (rb).inv_mass) + gz;

    let nvx = ((rb).vx + (ax * dt)) * (rb).linear_damping;
    let nvy = ((rb).vy + (ay * dt)) * (rb).linear_damping;
    let nvz = ((rb).vz + (az * dt)) * (rb).linear_damping;

    let npx = (rb).px + (nvx * dt);
    let npy = (rb).py + (nvy * dt);
    let npz = (rb).pz + (nvz * dt);

    let alpha_x = (rb).tx * (rb).inv_ixx;
    let alpha_y = (rb).ty * (rb).inv_iyy;
    let alpha_z = (rb).tz * (rb).inv_izz;

    let n_ang_vx = ((rb).ang_vx + (alpha_x * dt)) * (rb).angular_damping;
    let n_ang_vy = ((rb).ang_vy + (alpha_y * dt)) * (rb).angular_damping;
    let n_ang_vz = ((rb).ang_vz + (alpha_z * dt)) * (rb).angular_damping;

    let n_rot_x = (rb).rot_x + (n_ang_vx * dt);
    let n_rot_y = (rb).rot_y + (n_ang_vy * dt);
    let n_rot_z = (rb).rot_z + (n_ang_vz * dt);

    return RigidBody3D {
        px: npx, py: npy, pz: npz,
        vx: nvx, vy: nvy, vz: nvz,
        rot_x: n_rot_x, rot_y: n_rot_y, rot_z: n_rot_z,
        ang_vx: n_ang_vx, ang_vy: n_ang_vy, ang_vz: n_ang_vz,
        fx: 0.0, fy: 0.0, fz: 0.0,
        tx: 0.0, ty: 0.0, tz: 0.0,
        mass: (rb).mass, inv_mass: (rb).inv_mass,
        ixx: (rb).ixx, iyy: (rb).iyy, izz: (rb).izz,
        inv_ixx: (rb).inv_ixx, inv_iyy: (rb).inv_iyy, inv_izz: (rb).inv_izz,
        linear_damping: (rb).linear_damping, angular_damping: (rb).angular_damping,
        restitution: (rb).restitution, friction: (rb).friction,
        is_static: (rb).is_static,
    };
}

pub fn rigid_body_3d_get_point_velocity(rb: RigidBody3D, wx: Float, wy: Float, wz: Float) -> Vec3F {
    let rx = wx - (rb).px;
    let ry = wy - (rb).py;
    let rz = wz - (rb).pz;
    // v_point = v_cm + omega x r
    let p_vx = (rb).vx + ((rb).ang_vy * rz) - ((rb).ang_vz * ry);
    let p_vy = (rb).vy + ((rb).ang_vz * rx) - ((rb).ang_vx * rz);
    let p_vz = (rb).vz + ((rb).ang_vx * ry) - ((rb).ang_vy * rx);
    return Vec3F { x: p_vx, y: p_vy, z: p_vz };
}
