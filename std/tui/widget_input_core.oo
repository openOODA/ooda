// # TUI Text Input Field - Editing Primitives
//
// Logline: Defines WidgetInput, edits the value with set_text, insert_char, backspace, and delete, and moves the cursor left, right, home, and end.
//
// Setup: Pure value-returning helpers, no IO. Sibling of widget_input.oo.
//
// Beats:
//   1. WidgetInput struct with id, placeholder, value, cursor, scroll, masked, area.
//   2. set_text replaces the value; insert_char / backspace / delete mutate the buffer.
//   3. move_cursor_left / right / home / end, set_masked toggle.

import "./tui_buffer.oo";

type WidgetInput = struct {
    id: Int,
    placeholder: String,
    value: String,
    cursor_pos: Int,
    scroll_offset: Int,
    max_len: Int,
    is_focused: Bool,
    is_masked: Bool,
    area: BufferArea
};

pub fn widget_input_new(id: Int, placeholder: String, area: BufferArea) -> WidgetInput {
    return WidgetInput {
        id: id,
        placeholder: placeholder,
        value: "",
        cursor_pos: 0,
        scroll_offset: 0,
        max_len: 256,
        is_focused: false,
        is_masked: false,
        area: area
    };
}

pub fn widget_input_set_text(inp: WidgetInput, text: String) -> WidgetInput {
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: text,
        cursor_pos: text.len(),
        scroll_offset: 0,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area
    };
}

pub fn widget_input_insert_char(inp: WidgetInput, ch: String) -> WidgetInput {
    let cur = (inp).value;
    let len = cur.len();
    if len >= (inp).max_len {
        return inp;
    }
    let pos = (inp).cursor_pos;
    let mut str_buf: List[Int] = bytes_new();
    let mut i = 0;
    while i < pos && i < len {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }
    if ch.len() > 0 {
        str_buf = bytes_push(str_buf, byte_at(ch, 0));
    }
    while i < len {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }
    let new_pos = pos + 1;
    let mut scroll = (inp).scroll_offset;
    let view_w = (inp).area.width - 2;
    if (new_pos - scroll) >= view_w {
        scroll = new_pos - view_w + 1;
    }
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: bytes_to_str(str_buf),
        cursor_pos: new_pos,
        scroll_offset: scroll,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area
    };
}

pub fn widget_input_backspace(inp: WidgetInput) -> WidgetInput {
    let pos = (inp).cursor_pos;
    if pos <= 0 {
        return inp;
    }
    let cur = (inp).value;
    let len = cur.len();
    let mut str_buf: List[Int] = bytes_new();
    let mut i = 0;
    while i < (pos - 1) {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }
    i = pos;
    while i < len {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }
    let new_pos = pos - 1;
    let mut scroll = (inp).scroll_offset;
    if new_pos < scroll {
        scroll = new_pos;
    }
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: bytes_to_str(str_buf),
        cursor_pos: new_pos,
        scroll_offset: scroll,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area
    };
}

pub fn widget_input_delete(inp: WidgetInput) -> WidgetInput {
    let pos = (inp).cursor_pos;
    let cur = (inp).value;
    let len = cur.len();
    if pos >= len {
        return inp;
    }
    let mut str_buf: List[Int] = bytes_new();
    let mut i = 0;
    while i < pos {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }
    i = pos + 1;
    while i < len {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: bytes_to_str(str_buf),
        cursor_pos: (inp).cursor_pos,
        scroll_offset: (inp).scroll_offset,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area
    };
}

pub fn widget_input_move_cursor_left(inp: WidgetInput) -> WidgetInput {
    if (inp).cursor_pos > 0 {
        let new_pos = (inp).cursor_pos - 1;
        let mut scroll = (inp).scroll_offset;
        if new_pos < scroll {
            scroll = new_pos;
        }
        return WidgetInput {
            id: (inp).id,
            placeholder: (inp).placeholder,
            value: (inp).value,
            cursor_pos: new_pos,
            scroll_offset: scroll,
            max_len: (inp).max_len,
            is_focused: (inp).is_focused,
            is_masked: (inp).is_masked,
            area: (inp).area
        };
    }
    return inp;
}

pub fn widget_input_move_cursor_right(inp: WidgetInput) -> WidgetInput {
    let len = (inp).value.len();
    if (inp).cursor_pos < len {
        let new_pos = (inp).cursor_pos + 1;
        let mut scroll = (inp).scroll_offset;
        let view_w = (inp).area.width - 2;
        if (new_pos - scroll) >= view_w {
            scroll = new_pos - view_w + 1;
        }
        return WidgetInput {
            id: (inp).id,
            placeholder: (inp).placeholder,
            value: (inp).value,
            cursor_pos: new_pos,
            scroll_offset: scroll,
            max_len: (inp).max_len,
            is_focused: (inp).is_focused,
            is_masked: (inp).is_masked,
            area: (inp).area
        };
    }
    return inp;
}

pub fn widget_input_move_cursor_home(inp: WidgetInput) -> WidgetInput {
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: (inp).value,
        cursor_pos: 0,
        scroll_offset: 0,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area
    };
}

pub fn widget_input_move_cursor_end(inp: WidgetInput) -> WidgetInput {
    let len = (inp).value.len();
    let view_w = (inp).area.width - 2;
    let mut scroll = (inp).scroll_offset;
    if len >= view_w {
        scroll = len - view_w + 1;
    }
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: (inp).value,
        cursor_pos: len,
        scroll_offset: scroll,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area
    };
}

pub fn widget_input_set_masked(inp: WidgetInput, masked: Bool) -> WidgetInput {
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: (inp).value,
        cursor_pos: (inp).cursor_pos,
        scroll_offset: (inp).scroll_offset,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: masked,
        area: (inp).area
    };
}
