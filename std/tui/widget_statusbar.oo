// # TUI Status Bar & Notification Widget
//
// Logline: Bottom-docked status bar with left/right segmented status indicators and mode badges.
//
// Setup: Global application state, keybinding hints, and notification status footer.
//
// Beats:
//   1. Define StatusSegment descriptors with text, colors, and layout alignments.
//   2. Define WidgetStatusBar maintaining left and right aligned telemetry segments.
//   3. Render full-width background bar and segmented status chips into screen buffer.

import "./tui_cell.oo";
import "./tui_buffer.oo";

pub type StatusSegment = struct {
    text: String,
    fg: Int,
    bg: Int,
    align: Int, // 0: Left, 1: Right
};

pub fn status_segment_new(text: String, fg: Int, bg: Int, align: Int) -> StatusSegment {
    return StatusSegment {
        text: text,
        fg: fg,
        bg: bg,
        align: align,
    };
}

pub type WidgetStatusBar = struct {
    id: Int,
    area: BufferArea,
    left_segments: List[StatusSegment],
    right_segments: List[StatusSegment],
    is_active: Bool,
};

pub fn widget_statusbar_new(id: Int, area: BufferArea) -> WidgetStatusBar {
    let l: List[StatusSegment] = list_new();
    let r: List[StatusSegment] = list_new();
    return WidgetStatusBar {
        id: id,
        area: area,
        left_segments: l,
        right_segments: r,
        is_active: true,
    };
}

pub fn widget_statusbar_add_left(sb: &mut WidgetStatusBar, seg: StatusSegment) {
    (sb).left_segments = list_push((sb).left_segments, seg);
}

pub fn widget_statusbar_add_right(sb: &mut WidgetStatusBar, seg: StatusSegment) {
    (sb).right_segments = list_push((sb).right_segments, seg);
}

pub fn widget_statusbar_set_active(sb: &mut WidgetStatusBar, active: Bool) {
    (sb).is_active = active;
}

pub fn widget_statusbar_render(sb: &WidgetStatusBar, buf: &mut TuiBuffer) {
    if !((sb).is_active) {
        return;
    }
    let a = (sb).area;
    if a.width < 1 || a.height < 1 {
        return;
    }

    let default_bg = 4; // Blue/Dark background
    let default_fg = 15;

    // 1. Fill base status line
    let mut x = a.x;
    while x < (a.x + a.width) {
        tui_buffer_set_cell(buf, x, a.y, tui_cell_new(" ", default_fg, default_bg));
        x = x + 1;
    }

    // 2. Render Left Segments
    let num_left = list_len((sb).left_segments);
    let mut cur_x = a.x;
    let mut i = 0;
    while i < num_left && cur_x < (a.x + a.width) {
        let seg: StatusSegment = list_get((sb).left_segments, i);
        let chip = " " + seg.text + " ";
        let chip_len = chip.len();
        tui_buffer_write_string(buf, cur_x, a.y, chip, seg.fg, seg.bg, 1);
        cur_x = cur_x + chip_len;
        i = i + 1;
    }

    // 3. Render Right Segments (from right to left)
    let num_right = list_len((sb).right_segments);
    let mut cur_rx = a.x + a.width;
    let mut j = 0;
    while j < num_right && cur_rx > cur_x {
        let seg: StatusSegment = list_get((sb).right_segments, j);
        let chip = " " + seg.text + " ";
        let chip_len = chip.len();
        cur_rx = cur_rx - chip_len;
        if cur_rx >= cur_x {
            tui_buffer_write_string(buf, cur_rx, a.y, chip, seg.fg, seg.bg, 1);
        }
        j = j + 1;
    }
}
