// # TUI Hierarchical Tree View Widget
//
// Logline: Collapsible hierarchical node tree view with expand/collapse toggles and depth indentation.
//
// Setup: File system, AST, and hierarchical data navigation component for terminal interfaces.
//
// Beats:
//   1. Define TreeNode hierarchical descriptor with depth, parent references, and expansion state.
//   2. Manage node selection navigation and subtree collapse/expansion toggling.
//   3. Render tree branch glyphs, node icons, and selection indicators into screen buffer.

import "./tui_cell.oo";
import "./tui_buffer.oo";

pub type TreeNode = struct {
    id: Int,
    parent_id: Int,
    label: String,
    is_expanded: Bool,
    is_leaf: Bool,
    depth: Int
};

pub fn tree_node_new(id: Int, parent_id: Int, label: String, is_leaf: Bool, depth: Int) -> TreeNode {
    return TreeNode {
        id: id,
        parent_id: parent_id,
        label: label,
        is_expanded: false,
        is_leaf: is_leaf,
        depth: depth
    };
}

pub type WidgetTreeView = struct {
    id: Int,
    area: BufferArea,
    nodes: List[TreeNode],
    selected_index: Int,
    scroll_offset: Int,
    is_focused: Bool
};

pub fn widget_treeview_new(id: Int, area: BufferArea) -> WidgetTreeView {
    let nodes: List[TreeNode] = list_new();
    return WidgetTreeView {
        id: id,
        area: area,
        nodes: nodes,
        selected_index: 0,
        scroll_offset: 0,
        is_focused: false
    };
}

pub fn widget_treeview_add_node(tv: &mut WidgetTreeView, node: TreeNode) {
    (tv).nodes = list_push((tv).nodes, node);
}

pub fn widget_treeview_select_next(tv: &mut WidgetTreeView) {
    let total = list_len((tv).nodes);
    if total == 0 {
        return;
    }
    if (tv).selected_index < (total - 1) {
        (tv).selected_index = (tv).selected_index + 1;
        let view_h = (tv).area.height;
        if ((tv).selected_index - (tv).scroll_offset) >= view_h {
            (tv).scroll_offset = (tv).selected_index - view_h + 1;
        }
    }
}

pub fn widget_treeview_select_prev(tv: &mut WidgetTreeView) {
    if (tv).selected_index > 0 {
        (tv).selected_index = (tv).selected_index - 1;
        if (tv).selected_index < (tv).scroll_offset {
            (tv).scroll_offset = (tv).selected_index;
        }
    }
}

fn replace_tree_node(nodes: List[TreeNode], idx: Int, updated: TreeNode) -> List[TreeNode] {
    let total = list_len(nodes);
    let mut out: List[TreeNode] = list_new();
    let mut i = 0;
    while i < total {
        if i == idx {
            out = list_push(out, updated);
        } else {
            out = list_push(out, list_get(nodes, i));
        }
        i = i + 1;
    }
    return out;
}

pub fn widget_treeview_toggle_expand(tv: &mut WidgetTreeView) {
    let total = list_len((tv).nodes);
    if total == 0 {
        return;
    }
    let idx = (tv).selected_index;
    let mut node: TreeNode = list_get((tv).nodes, idx);
    if !(node.is_leaf) {
        node.is_expanded = !(node.is_expanded);
        (tv).nodes = replace_tree_node((tv).nodes, idx, node);
    }
}

pub fn widget_treeview_render(tv: &WidgetTreeView, buf: &mut TuiBuffer) {
    let a = (tv).area;
    if a.width < 4 || a.height < 1 {
        return;
    }

    let total = list_len((tv).nodes);
    let mut r = 0;
    while r < a.height {
        let actual_idx = (tv).scroll_offset + r;
        let row_y = a.y + r;
        if actual_idx < total {
            let node: TreeNode = list_get((tv).nodes, actual_idx);
            let is_sel = actual_idx == (tv).selected_index;
            let is_foc = (tv).is_focused;

            let fg = if is_sel && is_foc { 0 } else { 15 };
            let bg = if is_sel && is_foc { 14 } else { 0 };

            // Fill line background
            let mut x = a.x;
            while x < (a.x + a.width) {
                tui_buffer_set_cell(buf, x, row_y, tui_cell_new(" ", fg, bg));
                x = x + 1;
            }

            // Indentation
            let mut indent = "";
            let mut d = 0;
            let depth_val = (node).depth;
            while d < depth_val {
                indent = indent + "  ";
                d = d + 1;
            }

            // Node expand icon
            let icon = if (node).is_leaf {
                "• "
            } else if (node).is_expanded {
                "▼ "
            } else {
                "▶ "
            };

            let prefix = indent + icon;
            tui_buffer_write_string(buf, a.x, row_y, prefix, fg, bg, 0);
            tui_buffer_write_string(
                buf,
                a.x + prefix.len(),
                row_y,
                (node).label,
                fg,
                bg,
                if is_sel { 1 } else { 0 }
            );
        }
        r = r + 1;
    }
}
