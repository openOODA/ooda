// # TUI Push Button Widget
//
// Logline: Clickable action push button with focus borders, pressed states, and hotkey underlines.
//
// Setup: Interactive button component triggering application commands and dialog dismissals.
//
// Beats:
//   1. Define WidgetButton model with label, hotkey shortcut, and trigger action ID.
//   2. Manage button focus, pressed visual feedback, and disabled guard states.
//   3. Render bracketed button label, hotkey highlight, and focus border into TuiBuffer.

import "./tui_cell.oo";
import "./tui_buffer.oo";

type WidgetButton = struct {
    id: Int,
    label: String,
    hotkey_char: String,
    is_pressed: Bool,
    is_focused: Bool,
    is_disabled: Bool,
    area: BufferArea,
    action_id: Int,
};

pub fn widget_button_new(id: Int, label: String, area: BufferArea, action_id: Int) -> WidgetButton {
    return WidgetButton {
        id: id,
        label: label,
        hotkey_char: "",
        is_pressed: false,
        is_focused: false,
        is_disabled: false,
        area: area,
        action_id: action_id,
    };
}

pub fn widget_button_set_pressed(btn: WidgetButton, pressed: Bool) -> WidgetButton {
    return WidgetButton {
        id: (btn).id,
        label: (btn).label,
        hotkey_char: (btn).hotkey_char,
        is_pressed: pressed,
        is_focused: (btn).is_focused,
        is_disabled: (btn).is_disabled,
        area: (btn).area,
        action_id: (btn).action_id,
    };
}

pub fn widget_button_set_focus(btn: WidgetButton, focused: Bool) -> WidgetButton {
    return WidgetButton {
        id: (btn).id,
        label: (btn).label,
        hotkey_char: (btn).hotkey_char,
        is_pressed: (btn).is_pressed,
        is_focused: focused,
        is_disabled: (btn).is_disabled,
        area: (btn).area,
        action_id: (btn).action_id,
    };
}

pub fn widget_button_set_disabled(btn: WidgetButton, disabled: Bool) -> WidgetButton {
    return WidgetButton {
        id: (btn).id,
        label: (btn).label,
        hotkey_char: (btn).hotkey_char,
        is_pressed: (btn).is_pressed,
        is_focused: (btn).is_focused,
        is_disabled: disabled,
        area: (btn).area,
        action_id: (btn).action_id,
    };
}

pub fn widget_button_set_hotkey(btn: WidgetButton, hotkey: String) -> WidgetButton {
    return WidgetButton {
        id: (btn).id,
        label: (btn).label,
        hotkey_char: hotkey,
        is_pressed: (btn).is_pressed,
        is_focused: (btn).is_focused,
        is_disabled: (btn).is_disabled,
        area: (btn).area,
        action_id: (btn).action_id,
    };
}

pub fn widget_button_render(btn: WidgetButton, buf: TuiBuffer) -> TuiBuffer {
    let a = (btn).area;
    if a.width < 4 || a.height < 1 {
        return buf;
    }

    let is_dis = (btn).is_disabled;
    let is_foc = (btn).is_focused;
    let is_prs = (btn).is_pressed;

    let fg = if is_dis {
        8
    } else if is_prs {
        0
    } else if is_foc {
        0
    } else {
        15
    };

    let bg = if is_dis {
        0
    } else if is_prs {
        11
    } else if is_foc {
        14
    } else {
        4
    };

    let mut out = buf;
    let mut x = a.x;
    while x < (a.x + a.width) {
        out = tui_buffer_set_cell(out, x, a.y, tui_cell_new(" ", fg, bg));
        x = x + 1;
    }

    out = tui_buffer_set_cell(out, a.x, a.y, tui_cell_new("<", fg, bg));
    out = tui_buffer_set_cell(out, a.x + a.width - 1, a.y, tui_cell_new(">", fg, bg));

    let l = (btn).label;
    let l_len = l.len();
    let text_x = a.x + (a.width - l_len) / 2;
    return tui_buffer_write_string(out, text_x, a.y, l, fg, bg, if is_foc { 1 } else { 0 });
}
