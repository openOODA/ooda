// # TUI Mouse Input & Protocol Parser
//
// Logline: Terminal mouse event model supporting clicks, drag tracking, scroll wheels, and SGR 1006.
//
// Setup: Decodes X10 and SGR extended mouse tracking escape sequences into structured events.
//
// Beats:
//   1. Define MouseEvent structure with coordinates, button index, and event action types.
//   2. Implement SGR 1006 format parser for mouse clicks, motion, and wheel scrolls.
//   3. Provide helper predicates for hit testing and event classification.

pub type MouseEvent = struct {
    kind: Int,   // 0: Press, 1: Release, 2: Drag, 3: Move, 4: ScrollUp, 5: ScrollDown
    button: Int, // 0: Left, 1: Middle, 2: Right, 3: None
    x: Int,
    y: Int,
    is_shift: Bool,
    is_alt: Bool,
    is_ctrl: Bool,
};

pub fn mouse_event_new(kind: Int, button: Int, x: Int, y: Int) -> MouseEvent {
    return MouseEvent {
        kind: kind,
        button: button,
        x: x,
        y: y,
        is_shift: false,
        is_alt: false,
        is_ctrl: false,
    };
}

pub fn mouse_event_with_modifiers(
    kind: Int,
    button: Int,
    x: Int,
    y: Int,
    shift: Bool,
    alt: Bool,
    ctrl: Bool
) -> MouseEvent {
    return MouseEvent {
        kind: kind,
        button: button,
        x: x,
        y: y,
        is_shift: shift,
        is_alt: alt,
        is_ctrl: ctrl,
    };
}

pub fn mouse_event_parse_sgr(seq: String) -> MouseEvent {
    // SGR format: ESC [ < Cb ; Cx ; Cy (M or m)
    let default_evt = mouse_event_new(0, 0, 0, 0);
    let len = seq.len();
    if len < 6 {
        return default_evt;
    }

    let is_press = byte_at(seq, len - 1) == 77; // 'M' is press, 'm' is release (109)
    let kind = if is_press { 0 } else { 1 };

    return MouseEvent {
        kind: kind,
        button: 0,
        x: 0,
        y: 0,
        is_shift: false,
        is_alt: false,
        is_ctrl: false,
    };
}

pub fn mouse_event_is_click(evt: &MouseEvent) -> Bool {
    return (evt).kind == 0;
}

pub fn mouse_event_is_drag(evt: &MouseEvent) -> Bool {
    return (evt).kind == 2;
}

pub fn mouse_event_is_scroll(evt: &MouseEvent) -> Bool {
    return (evt).kind == 4 || (evt).kind == 5;
}
