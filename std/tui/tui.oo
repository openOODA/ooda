import "./widget_statusbar.oo";
import "./widget_progressbar.oo";
import "./widget_treeview.oo";
import "./widget_tabs.oo";
import "./widget_button.oo";
import "./layout_flex.oo";
import "./layout_grid.oo";
import "./layout_split.oo";
import "./key_events.oo";
import "./mouse_events.oo";
import "./cursor_controller.oo";
import "./theme_dark.oo";
import "./theme_light.oo";
import "./tui_stubs.oo";

pub fn shim_marker_tui_cell() -> TuiCell {
    return tui_cell_new("A", 15, 0);
}

pub fn shim_marker_tui_buffer() -> TuiBuffer {
    return tui_buffer_new(80, 24);
}

pub fn shim_marker_tui_renderer() -> TuiRenderer {
    return tui_renderer_new(80, 24);
}

pub fn shim_marker_box_glyphs() -> BoxGlyphs {
    return box_glyphs_rounded();
}

pub fn shim_marker_border_styles() -> BorderStyle {
    return border_style_rounded(14, 0);
}

pub fn shim_marker_widget_window() -> WidgetWindow {
    let area = buffer_area_new(0, 0, 40, 15);
    return widget_window_new(1, "Main Window", area);
}

pub fn shim_marker_widget_dialog() -> WidgetDialog {
    let area = buffer_area_new(10, 5, 40, 10);
    return widget_dialog_new_alert(1, "Alert", "Operation succeeded", area);
}

pub fn shim_marker_widget_table() -> WidgetTable {
    let area = buffer_area_new(0, 0, 60, 20);
    return widget_table_new(1, area);
}

pub fn shim_marker_widget_list() -> WidgetList {
    let area = buffer_area_new(0, 0, 30, 15);
    return widget_list_new(1, area);
}

pub fn shim_marker_widget_input() -> WidgetInput {
    let area = buffer_area_new(0, 0, 30, 1);
    return widget_input_new(1, "Enter text...", area);
}

pub fn shim_marker_widget_statusbar() -> WidgetStatusBar {
    let area = buffer_area_new(0, 23, 80, 1);
    return widget_statusbar_new(1, area);
}

pub fn shim_marker_widget_progressbar() -> WidgetProgressBar {
    let area = buffer_area_new(0, 0, 40, 1);
    return widget_progressbar_new(1, area);
}

pub fn shim_marker_widget_treeview() -> WidgetTreeView {
    let area = buffer_area_new(0, 0, 30, 20);
    return widget_treeview_new(1, area);
}

pub fn shim_marker_widget_tabs() -> WidgetTabs {
    let area = buffer_area_new(0, 0, 80, 1);
    return widget_tabs_new(1, area);
}

pub fn shim_marker_widget_button() -> WidgetButton {
    let area = buffer_area_new(0, 0, 12, 1);
    return widget_button_new(1, "Submit", area, 100);
}

pub fn shim_marker_layout_flex() -> FlexContainer {
    let area = buffer_area_new(0, 0, 80, 24);
    return flex_container_new(area, 0, 0);
}

pub fn shim_marker_layout_grid() -> GridLayout {
    let area = buffer_area_new(0, 0, 80, 24);
    return grid_layout_new(area, 1, 1);
}

pub fn shim_marker_layout_split() -> SplitPane {
    let area = buffer_area_new(0, 0, 80, 24);
    return split_pane_new_vertical(area, 50);
}

pub fn shim_marker_key_events() -> KeyEvent {
    return key_event_new(13, "Enter");
}

pub fn shim_marker_mouse_events() -> MouseEvent {
    return mouse_event_new(0, 0, 10, 5);
}

pub fn shim_marker_cursor_controller() -> CursorController {
    return cursor_controller_new();
}

pub fn shim_marker_theme_dark() -> TuiDarkTheme {
    return theme_dark_default();
}

pub fn shim_marker_theme_light() -> TuiLightTheme {
    return theme_light_default();
}

pub fn shim_marker_tui_stubs(sys: &SysCap, fs_read: &FsReadCap, fs_write: &FsWriteCap) -> Bool {
    let guard = tui_enable_raw_mode(sys);
    let size = tui_get_terminal_size_ioctl(sys);
    let r_res = tui_read_term_input_stream(fs_read, 128);
    let w_res = tui_write_term_output_stream(fs_write, "\x1b[0m");
    return tui_disable_raw_mode(sys, guard);
}
