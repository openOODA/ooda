// # Terminal User Interface (TUI) & Layouts Facade
//
// Logline: Re-exports screen buffers, renderers, widgets, layouts, event models, themes, and terminal stubs.
//
// Setup: Pure standard library facade module importing all 24 companion TUI submodules.
//
// Beats:
//   1. Import all 24 TUI domain companion submodules.
//   2. Provide typed shim markers exercising symbols across buffers, widgets, layouts, and themes.
//   3. Thread &SysCap, &FsReadCap, and &FsWriteCap capabilities for end-to-end tooling integrity.

import "./tui_buffer.oo";
import "./tui_cell.oo";
import "./tui_renderer.oo";
import "./box_drawing.oo";
import "./border_styles.oo";
import "./widget_window.oo";
import "./widget_dialog.oo";
import "./widget_table.oo";
import "./widget_list.oo";
