// # Border Styles & Perimeter Geometry
//
// Logline: Stylized frame borders with customizable sides, colors, and Unicode line styles.
//
// Setup: Compositing logic for rendering structural borders into TUI screen buffers.
//
// Beats:
//   1. Define BorderStyle and BorderSides configuration structures.
//   2. Provide presets for single, double, rounded, heavy, and borderless frames.
//   3. Implement border_draw_perimeter to blit border lines and corner junctions.

import "./tui_cell.oo";
import "./tui_buffer.oo";
import "./box_drawing.oo";

type BorderStyle = struct {
    kind: Int,
    fg: Int,
    bg: Int,
    glyphs: BoxGlyphs,
};

type BorderSides = struct {
    top: Bool,
    right: Bool,
    bottom: Bool,
    left: Bool,
};

pub fn border_sides_all() -> BorderSides {
    return BorderSides {
        top: true,
        right: true,
        bottom: true,
        left: true,
    };
}

pub fn border_sides_horizontal() -> BorderSides {
    return BorderSides {
        top: true,
        right: false,
        bottom: true,
        left: false,
    };
}

pub fn border_sides_vertical() -> BorderSides {
    return BorderSides {
        top: false,
        right: true,
        bottom: false,
        left: true,
    };
}

pub fn border_sides_none() -> BorderSides {
    return BorderSides {
        top: false,
        right: false,
        bottom: false,
        left: false,
    };
}

pub fn border_style_single(fg: Int, bg: Int) -> BorderStyle {
    return BorderStyle {
        kind: 1,
        fg: fg,
        bg: bg,
        glyphs: box_glyphs_single(),
    };
}

pub fn border_style_double(fg: Int, bg: Int) -> BorderStyle {
    return BorderStyle {
        kind: 2,
        fg: fg,
        bg: bg,
        glyphs: box_glyphs_double(),
    };
}

pub fn border_style_rounded(fg: Int, bg: Int) -> BorderStyle {
    return BorderStyle {
        kind: 3,
        fg: fg,
        bg: bg,
        glyphs: box_glyphs_rounded(),
    };
}

pub fn border_style_heavy(fg: Int, bg: Int) -> BorderStyle {
    return BorderStyle {
        kind: 4,
        fg: fg,
        bg: bg,
        glyphs: box_glyphs_heavy(),
    };
}

pub fn border_style_ascii(fg: Int, bg: Int) -> BorderStyle {
    return BorderStyle {
        kind: 5,
        fg: fg,
        bg: bg,
        glyphs: box_glyphs_ascii(),
    };
}

pub fn border_style_none() -> BorderStyle {
    return BorderStyle {
        kind: 0,
        fg: 7,
        bg: 0,
        glyphs: box_glyphs_ascii(),
    };
}

pub fn border_draw_perimeter(
    buf: TuiBuffer,
    area: BufferArea,
    style: BorderStyle,
    sides: BorderSides
) -> TuiBuffer {
    if style.kind == 0 {
        return buf;
    }
    let w = (area).width;
    let h = (area).height;
    if w < 2 || h < 2 {
        return buf;
    }
    let x1 = (area).x;
    let y1 = (area).y;
    let x2 = (area).x + w - 1;
    let y2 = (area).y + h - 1;
    let fg = style.fg;
    let bg = style.bg;
    let g = style.glyphs;
    let mut out = buf;

    if (sides).top {
        let mut x = x1 + 1;
        while x < x2 {
            let cell = tui_cell_new(g.horizontal, fg, bg);
            out = tui_buffer_set_cell(out, x, y1, cell);
            x = x + 1;
        }
    }
    if (sides).bottom {
        let mut x = x1 + 1;
        while x < x2 {
            let cell = tui_cell_new(g.horizontal, fg, bg);
            out = tui_buffer_set_cell(out, x, y2, cell);
            x = x + 1;
        }
    }

    if (sides).left {
        let mut y = y1 + 1;
        while y < y2 {
            let cell = tui_cell_new(g.vertical, fg, bg);
            out = tui_buffer_set_cell(out, x1, y, cell);
            y = y + 1;
        }
    }
    if (sides).right {
        let mut y = y1 + 1;
        while y < y2 {
            let cell = tui_cell_new(g.vertical, fg, bg);
            out = tui_buffer_set_cell(out, x2, y, cell);
            y = y + 1;
        }
    }

    if (sides).top && (sides).left {
        let cell = tui_cell_new(g.top_left, fg, bg);
        out = tui_buffer_set_cell(out, x1, y1, cell);
    }
    if (sides).top && (sides).right {
        let cell = tui_cell_new(g.top_right, fg, bg);
        out = tui_buffer_set_cell(out, x2, y1, cell);
    }
    if (sides).bottom && (sides).left {
        let cell = tui_cell_new(g.bottom_left, fg, bg);
        out = tui_buffer_set_cell(out, x1, y2, cell);
    }
    if (sides).bottom && (sides).right {
        let cell = tui_cell_new(g.bottom_right, fg, bg);
        out = tui_buffer_set_cell(out, x2, y2, cell);
    }
    return out;
}
