// # TUI Terminal Cursor Controller
//
// Logline: Hardware terminal cursor positioning, visibility toggling, blinking, and shape styling.
//
// Setup: Low-level terminal cursor management for interactive text entry and TUI navigation.
//
// Beats:
//   1. Define CursorPosition and CursorController state structures.
//   2. Implement cursor movement, visibility switches, and shape configurations (block, bar, underline).
//   3. Generate ANSI escape sequences controlling the hardware terminal cursor.

type CursorPosition = struct {
    x: Int,
    y: Int,
};

pub fn cursor_position_new(x: Int, y: Int) -> CursorPosition {
    return CursorPosition {
        x: x,
        y: y,
    };
}

type CursorController = struct {
    x: Int,
    y: Int,
    is_visible: Bool,
    shape: Int,
    is_blinking: Bool,
};

pub fn cursor_controller_new() -> CursorController {
    return CursorController {
        x: 0,
        y: 0,
        is_visible: true,
        shape: 1,
        is_blinking: true,
    };
}

pub fn cursor_controller_move(c: CursorController, x: Int, y: Int) -> CursorController {
    return CursorController {
        x: x,
        y: y,
        is_visible: (c).is_visible,
        shape: (c).shape,
        is_blinking: (c).is_blinking,
    };
}

pub fn cursor_controller_set_visible(c: CursorController, visible: Bool) -> CursorController {
    return CursorController {
        x: (c).x,
        y: (c).y,
        is_visible: visible,
        shape: (c).shape,
        is_blinking: (c).is_blinking,
    };
}

pub fn cursor_controller_set_shape(c: CursorController, shape: Int) -> CursorController {
    return CursorController {
        x: (c).x,
        y: (c).y,
        is_visible: (c).is_visible,
        shape: shape,
        is_blinking: (c).is_blinking,
    };
}

pub fn cursor_controller_set_blinking(c: CursorController, blinking: Bool) -> CursorController {
    return CursorController {
        x: (c).x,
        y: (c).y,
        is_visible: (c).is_visible,
        shape: (c).shape,
        is_blinking: blinking,
    };
}

pub fn cursor_controller_to_ansi(c: CursorController) -> String {
    let mut out = "";

    let row = ((c).y + 1).to_string();
    let col = ((c).x + 1).to_string();
    out = out + "\x1b[" + row + ";" + col + "H";

    if (c).is_visible {
        out = out + "\x1b[?25h";
    } else {
        out = out + "\x1b[?25l";
    }

    let base_shape = if (c).shape == 2 {
        3
    } else if (c).shape == 3 {
        5
    } else {
        1
    };

    let shape_code = if (c).is_blinking {
        base_shape
    } else {
        base_shape + 1
    };

    out = out + "\x1b[" + shape_code.to_string() + " q";
    return out;
}
