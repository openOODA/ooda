// # TUI Dark Color Theme & Palettes
//
// Logline: Dark color palettes, semantic UI color tokens, and contrast-optimized themes for TUIs.
//
// Setup: Dark theme specifications providing ANSI color codes for backgrounds, surfaces, and accents.
//
// Beats:
//   1. Define TuiDarkTheme structure containing complete semantic color tokens.
//   2. Provide standard dark themes: Default Dark, Nord, Dracula, and Monokai.
//   3. Implement theme query and color token lookup functions.

pub type TuiDarkTheme = struct {
    bg: Int,
    fg: Int,
    surface: Int,
    accent: Int,
    muted: Int,
    border: Int,
    selection_bg: Int,
    selection_fg: Int,
    success: Int,
    warning: Int,
    error: Int
};

pub fn theme_dark_default() -> TuiDarkTheme {
    return TuiDarkTheme {
        bg: 0,
        fg: 15,
        surface: 8,
        accent: 14,
        muted: 7,
        border: 8,
        selection_bg: 14,
        selection_fg: 0,
        success: 10,
        warning: 11,
        error: 9
    };
}

pub fn theme_dark_nord() -> TuiDarkTheme {
    return TuiDarkTheme {
        bg: 236,
        fg: 253,
        surface: 238,
        accent: 110,
        muted: 244,
        border: 240,
        selection_bg: 110,
        selection_fg: 236,
        success: 108,
        warning: 222,
        error: 167
    };
}

