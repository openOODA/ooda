// # TUI WidgetInput Text Mutators
//
// Logline: set_text, insert_char, backspace, and delete operations on the input buffer.
//
// Setup: Byte-level string editing using bytes_new / bytes_push / byte_at / bytes_to_str.
//
// Beats:
//   1. Replace whole value with set_text.
//   2. Insert one byte at the cursor position.
//   3. Remove the byte before or after the cursor.

import "./tui_cell.oo";
import "./tui_buffer.oo";
import "./widget_input_types.oo";

pub fn widget_input_set_text(inp: WidgetInput, text: String) -> WidgetInput {
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: text,
        cursor_pos: text.len(),
        scroll_offset: 0,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area,
    };
}

pub fn widget_input_insert_char(inp: WidgetInput, ch: String) -> WidgetInput {
    let cur = (inp).value;
    let len = cur.len();
    if len >= (inp).max_len {
        return inp;
    }
    let pos = (inp).cursor_pos;
    let mut str_buf: List[Int] = bytes_new();

    let mut i = 0;
    while i < pos && i < len {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }
    if ch.len() > 0 {
        str_buf = bytes_push(str_buf, byte_at(ch, 0));
    }
    while i < len {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }

    let new_pos = pos + 1;
    let mut scroll = (inp).scroll_offset;
    let view_w = (inp).area.width - 2;
    if (new_pos - scroll) >= view_w {
        scroll = new_pos - view_w + 1;
    }
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: bytes_to_str(str_buf),
        cursor_pos: new_pos,
        scroll_offset: scroll,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area,
    };
}

pub fn widget_input_backspace(inp: WidgetInput) -> WidgetInput {
    let pos = (inp).cursor_pos;
    if pos <= 0 {
        return inp;
    }
    let cur = (inp).value;
    let len = cur.len();
    let mut str_buf: List[Int] = bytes_new();

    let mut i = 0;
    while i < (pos - 1) {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }
    i = pos;
    while i < len {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }

    let new_pos = pos - 1;
    let mut scroll = (inp).scroll_offset;
    if new_pos < scroll {
        scroll = new_pos;
    }
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: bytes_to_str(str_buf),
        cursor_pos: new_pos,
        scroll_offset: scroll,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area,
    };
}

pub fn widget_input_delete(inp: WidgetInput) -> WidgetInput {
    let pos = (inp).cursor_pos;
    let cur = (inp).value;
    let len = cur.len();
    if pos >= len {
        return inp;
    }
    let mut str_buf: List[Int] = bytes_new();

    let mut i = 0;
    while i < pos {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }
    i = pos + 1;
    while i < len {
        str_buf = bytes_push(str_buf, byte_at(cur, i));
        i = i + 1;
    }
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: bytes_to_str(str_buf),
        cursor_pos: (inp).cursor_pos,
        scroll_offset: (inp).scroll_offset,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area,
    };
}
