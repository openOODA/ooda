// # TUI Progress Bar Widget
//
// Logline: Determinate and indeterminate progress indicator bars with customizable fill glyphs.
//
// Setup: Visual feedback widget for tracking task completion percentages and spinner states.
//
// Beats:
//   1. Define WidgetProgressBar configuration with percentage, colors, and glyph characters.
//   2. Support determinate percentage updates (0 to 100) and indeterminate spinner stepping.
//   3. Render progress track, filled bar cells, and percentage numerical badge.

import "./tui_cell.oo";
import "./tui_buffer.oo";

type WidgetProgressBar = struct {
    id: Int,
    area: BufferArea,
    progress_pct: Int,
    show_label: Bool,
    filled_char: String,
    empty_char: String,
    fg_color: Int,
    bg_color: Int,
    is_indeterminate: Bool,
    indeterminate_step: Int
};

pub fn widget_progressbar_new(id: Int, area: BufferArea) -> WidgetProgressBar {
    return WidgetProgressBar {
        id: id,
        area: area,
        progress_pct: 0,
        show_label: true,
        filled_char: "█",
        empty_char: "░",
        fg_color: 10,
        bg_color: 0,
        is_indeterminate: false,
        indeterminate_step: 0
    };
}

pub fn widget_progressbar_set_progress(pb: WidgetProgressBar, pct: Int) -> WidgetProgressBar {
    let mut p = pct;
    if p < 0 {
        p = 0;
    }
    if p > 100 {
        p = 100;
    }
    return WidgetProgressBar {
        id: (pb).id,
        area: (pb).area,
        progress_pct: p,
        show_label: (pb).show_label,
        filled_char: (pb).filled_char,
        empty_char: (pb).empty_char,
        fg_color: (pb).fg_color,
        bg_color: (pb).bg_color,
        is_indeterminate: (pb).is_indeterminate,
        indeterminate_step: (pb).indeterminate_step
    };
}

pub fn widget_progressbar_set_chars(pb: WidgetProgressBar, filled: String, empty: String) -> WidgetProgressBar {
    return WidgetProgressBar {
        id: (pb).id,
        area: (pb).area,
        progress_pct: (pb).progress_pct,
        show_label: (pb).show_label,
        filled_char: filled,
        empty_char: empty,
        fg_color: (pb).fg_color,
        bg_color: (pb).bg_color,
        is_indeterminate: (pb).is_indeterminate,
        indeterminate_step: (pb).indeterminate_step
    };
}

pub fn widget_progressbar_set_colors(pb: WidgetProgressBar, fg: Int, bg: Int) -> WidgetProgressBar {
    return WidgetProgressBar {
        id: (pb).id,
        area: (pb).area,
        progress_pct: (pb).progress_pct,
        show_label: (pb).show_label,
        filled_char: (pb).filled_char,
        empty_char: (pb).empty_char,
        fg_color: fg,
        bg_color: bg,
        is_indeterminate: (pb).is_indeterminate,
        indeterminate_step: (pb).indeterminate_step
    };
}

pub fn widget_progressbar_set_indeterminate(pb: WidgetProgressBar, ind: Bool) -> WidgetProgressBar {
    return WidgetProgressBar {
        id: (pb).id,
        area: (pb).area,
        progress_pct: (pb).progress_pct,
        show_label: (pb).show_label,
        filled_char: (pb).filled_char,
        empty_char: (pb).empty_char,
        fg_color: (pb).fg_color,
        bg_color: (pb).bg_color,
        is_indeterminate: ind,
        indeterminate_step: (pb).indeterminate_step
    };
}

pub fn widget_progressbar_step_indeterminate(pb: WidgetProgressBar) -> WidgetProgressBar {
    return WidgetProgressBar {
        id: (pb).id,
        area: (pb).area,
        progress_pct: (pb).progress_pct,
        show_label: (pb).show_label,
        filled_char: (pb).filled_char,
        empty_char: (pb).empty_char,
        fg_color: (pb).fg_color,
        bg_color: (pb).bg_color,
        is_indeterminate: (pb).is_indeterminate,
        indeterminate_step: ((pb).indeterminate_step + 1) % 100
    };
}

pub fn widget_progressbar_render(pb: WidgetProgressBar, buf: TuiBuffer) -> TuiBuffer {
    let a = (pb).area;
    if a.width < 5 || a.height < 1 {
        return buf;
    }

    let y = a.y;
    let total_w = a.width;
    let mut out = buf;

    if (pb).is_indeterminate {
        let block_w = 4;
        let pos = (pb).indeterminate_step % (total_w + block_w);
        let mut x = 0;
        while x < total_w {
            let cx = a.x + x;
            if x >= (pos - block_w) && x < pos {
                out = tui_buffer_set_cell(out, cx, y, tui_cell_new((pb).filled_char, (pb).fg_color, (pb).bg_color));
            } else {
                out = tui_buffer_set_cell(out, cx, y, tui_cell_new((pb).empty_char, 8, (pb).bg_color));
            }
            x = x + 1;
        }
        return out;
    }

    let label_str = (pb).progress_pct.to_string() + "%";
    let label_len = if (pb).show_label { label_str.len() + 1 } else { 0 };
    let track_w = total_w - label_len;

    let filled_count = ((pb).progress_pct * track_w) / 100;
    let mut i = 0;
    while i < track_w {
        let cx = a.x + i;
        if i < filled_count {
            out = tui_buffer_set_cell(out, cx, y, tui_cell_new((pb).filled_char, (pb).fg_color, (pb).bg_color));
        } else {
            out = tui_buffer_set_cell(out, cx, y, tui_cell_new((pb).empty_char, 8, (pb).bg_color));
        }
        i = i + 1;
    }

    if (pb).show_label {
        out = tui_buffer_write_string(out, a.x + track_w + 1, y, label_str, 15, (pb).bg_color, 1);
    }
    return out;
}
