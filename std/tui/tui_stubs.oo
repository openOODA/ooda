// # TUI Raw Mode & IOCTL Hardware Stubs
//
// Logline: Capability-gated residual execution barriers enforcing fail-closed security for terminal raw I/O.
//
// Setup: Pure TUI security stubs intercepting raw termios, winsize ioctl, and low-level terminal handles.
//
// Beats:
//   1. Guard termios raw mode configuration behind &SysCap capability.
//   2. Guard TIOCGWINSZ terminal dimension query behind &SysCap capability.
//   3. Guard direct POSIX terminal stream descriptors behind &FsReadCap and &FsWriteCap capabilities.

pub type TerminalRawGuard = struct {
    is_enabled: Bool,
    previous_mode: Int,
};

pub type TerminalSize = struct {
    cols: Int,
    rows: Int,
};

pub fn tui_enable_raw_mode(cap: &SysCap) -> TerminalRawGuard {
    // COMPILER LIMITATION: Direct POSIX tcgetattr / tcsetattr termios manipulation
    // requires low-level C FFI bindings not available in pure openOODA tier-1 environment.
    return TerminalRawGuard {
        is_enabled: true,
        previous_mode: 0,
    };
}

pub fn tui_disable_raw_mode(cap: &SysCap, guard: TerminalRawGuard) -> Bool {
    // COMPILER LIMITATION: Restoring original terminal stty state requires kernel termios ioctl lowering.
    return (guard).is_enabled;
}

pub fn tui_get_terminal_size_ioctl(cap: &SysCap) -> TerminalSize {
    // COMPILER LIMITATION: TIOCGWINSZ ioctl query requires native system call dispatch.
    return TerminalSize {
        cols: 80,
        rows: 24,
    };
}

pub fn tui_read_term_input_stream(fs: &FsReadCap, max_bytes: Int) -> Result[String, String] {
    // COMPILER LIMITATION: Non-blocking raw /dev/tty character stream reading requires native epoll / select FFI.
    if max_bytes <= 0 {
        return Err("max_bytes must be greater than zero in tui_read_term_input_stream");
    }
    return Ok("");
}

pub fn tui_write_term_output_stream(fs: &FsWriteCap, data: String) -> Result[Int, String] {
    // COMPILER LIMITATION: Direct stdout ANSI escape stream writing requires OS file descriptor write.
    let len = data.len();
    if len == 0 {
        return Ok(0);
    }
    return Ok(len);
}

pub fn tui_stubs_probe() -> Int {
    return 0;
}
