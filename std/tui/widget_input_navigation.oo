// # TUI WidgetInput Cursor Navigation
//
// Logline: Move cursor left, right, home, end, and toggle password masking.
//
// Setup: Pure cursor arithmetic with horizontal scroll clamp.
//
// Beats:
//   1. Move cursor one position left or right with scroll adjust.
//   2. Snap to home (0) or end (value length).
//   3. Toggle is_masked for password input.

import "./tui_cell.oo";
import "./tui_buffer.oo";
import "./widget_input_types.oo";

pub fn widget_input_move_cursor_left(inp: WidgetInput) -> WidgetInput {
    if (inp).cursor_pos > 0 {
        let new_pos = (inp).cursor_pos - 1;
        let mut scroll = (inp).scroll_offset;
        if new_pos < scroll {
            scroll = new_pos;
        }
        return WidgetInput {
            id: (inp).id,
            placeholder: (inp).placeholder,
            value: (inp).value,
            cursor_pos: new_pos,
            scroll_offset: scroll,
            max_len: (inp).max_len,
            is_focused: (inp).is_focused,
            is_masked: (inp).is_masked,
            area: (inp).area,
        };
    }
    return inp;
}

pub fn widget_input_move_cursor_right(inp: WidgetInput) -> WidgetInput {
    let len = (inp).value.len();
    if (inp).cursor_pos < len {
        let new_pos = (inp).cursor_pos + 1;
        let mut scroll = (inp).scroll_offset;
        let view_w = (inp).area.width - 2;
        if (new_pos - scroll) >= view_w {
            scroll = new_pos - view_w + 1;
        }
        return WidgetInput {
            id: (inp).id,
            placeholder: (inp).placeholder,
            value: (inp).value,
            cursor_pos: new_pos,
            scroll_offset: scroll,
            max_len: (inp).max_len,
            is_focused: (inp).is_focused,
            is_masked: (inp).is_masked,
            area: (inp).area,
        };
    }
    return inp;
}

pub fn widget_input_move_cursor_home(inp: WidgetInput) -> WidgetInput {
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: (inp).value,
        cursor_pos: 0,
        scroll_offset: 0,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area,
    };
}

pub fn widget_input_move_cursor_end(inp: WidgetInput) -> WidgetInput {
    let len = (inp).value.len();
    let view_w = (inp).area.width - 2;
    let mut scroll = (inp).scroll_offset;
    if len >= view_w {
        scroll = len - view_w + 1;
    }
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: (inp).value,
        cursor_pos: len,
        scroll_offset: scroll,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: (inp).is_masked,
        area: (inp).area,
    };
}

pub fn widget_input_set_masked(inp: WidgetInput, masked: Bool) -> WidgetInput {
    return WidgetInput {
        id: (inp).id,
        placeholder: (inp).placeholder,
        value: (inp).value,
        cursor_pos: (inp).cursor_pos,
        scroll_offset: (inp).scroll_offset,
        max_len: (inp).max_len,
        is_focused: (inp).is_focused,
        is_masked: masked,
        area: (inp).area,
    };
}
