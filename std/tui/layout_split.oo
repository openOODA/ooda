// # TUI Split Pane Layout Manager
//
// Logline: Binary split container partitioning space horizontally or vertically with adjustable ratio.
//
// Setup: Two-pane layout manager commonly used for sidebars, diff viewers, and dual-pane explorers.
//
// Beats:
//   1. Define SplitPane configuration with orientation, split percentage, and min size constraints.
//   2. Calculate divider position and resulting first/second child BufferArea rectangles.
//   3. Provide accessor functions for first pane, second pane, and divider coordinate.

import "./tui_buffer.oo";

type SplitPane = struct {
    area: BufferArea,
    is_vertical: Bool,
    ratio_pct: Int,
    min_first_size: Int,
    min_second_size: Int,
    first_area: BufferArea,
    second_area: BufferArea,
    divider_pos: Int
};

pub fn split_pane_calculate(sp: SplitPane) -> SplitPane {
    let a = (sp).area;
    if (sp).is_vertical {
        let total_w = a.width - 1;
        let mut first_w = (total_w * (sp).ratio_pct) / 100;
        if first_w < (sp).min_first_size {
            first_w = (sp).min_first_size;
        }
        let max_first = total_w - (sp).min_second_size;
        if first_w > max_first && max_first >= 0 {
            first_w = max_first;
        }
        let second_w = total_w - first_w;

        return SplitPane {
            area: (sp).area,
            is_vertical: (sp).is_vertical,
            ratio_pct: (sp).ratio_pct,
            min_first_size: (sp).min_first_size,
            min_second_size: (sp).min_second_size,
            first_area: BufferArea {
                x: a.x,
                y: a.y,
                width: first_w,
                height: a.height
            },
            second_area: BufferArea {
                x: a.x + first_w + 1,
                y: a.y,
                width: second_w,
                height: a.height
            },
            divider_pos: a.x + first_w
        };
    }

    let total_h = a.height - 1;
    let mut first_h = (total_h * (sp).ratio_pct) / 100;
    if first_h < (sp).min_first_size {
        first_h = (sp).min_first_size;
    }
    let max_first = total_h - (sp).min_second_size;
    if first_h > max_first && max_first >= 0 {
        first_h = max_first;
    }
    let second_h = total_h - first_h;

    return SplitPane {
        area: (sp).area,
        is_vertical: (sp).is_vertical,
        ratio_pct: (sp).ratio_pct,
        min_first_size: (sp).min_first_size,
        min_second_size: (sp).min_second_size,
        first_area: BufferArea {
            x: a.x,
            y: a.y,
            width: a.width,
            height: first_h
        },
        second_area: BufferArea {
            x: a.x,
            y: a.y + first_h + 1,
            width: a.width,
            height: second_h
        },
        divider_pos: a.y + first_h
    };
}

pub fn split_pane_new_horizontal(area: BufferArea, ratio_pct: Int) -> SplitPane {
    let empty_area = BufferArea { x: 0, y: 0, width: 0, height: 0 };
    let sp = SplitPane {
        area: area,
        is_vertical: false,
        ratio_pct: ratio_pct,
        min_first_size: 1,
        min_second_size: 1,
        first_area: empty_area,
        second_area: empty_area,
        divider_pos: 0
    };
    return split_pane_calculate(sp);
}

pub fn split_pane_new_vertical(area: BufferArea, ratio_pct: Int) -> SplitPane {
    let empty_area = BufferArea { x: 0, y: 0, width: 0, height: 0 };
    let sp = SplitPane {
        area: area,
        is_vertical: true,
        ratio_pct: ratio_pct,
        min_first_size: 1,
        min_second_size: 1,
        first_area: empty_area,
        second_area: empty_area,
        divider_pos: 0
    };
    return split_pane_calculate(sp);
}

pub fn split_pane_set_ratio(sp: SplitPane, ratio_pct: Int) -> SplitPane {
    return split_pane_calculate(SplitPane {
        area: (sp).area,
        is_vertical: (sp).is_vertical,
        ratio_pct: ratio_pct,
        min_first_size: (sp).min_first_size,
        min_second_size: (sp).min_second_size,
        first_area: (sp).first_area,
        second_area: (sp).second_area,
        divider_pos: (sp).divider_pos
    });
}

pub fn split_pane_set_min_sizes(sp: SplitPane, min_first: Int, min_second: Int) -> SplitPane {
    return split_pane_calculate(SplitPane {
        area: (sp).area,
        is_vertical: (sp).is_vertical,
        ratio_pct: (sp).ratio_pct,
        min_first_size: min_first,
        min_second_size: min_second,
        first_area: (sp).first_area,
        second_area: (sp).second_area,
        divider_pos: (sp).divider_pos
    });
}

pub fn split_pane_get_first(sp: SplitPane) -> BufferArea {
    return (sp).first_area;
}

pub fn split_pane_get_second(sp: SplitPane) -> BufferArea {
    return (sp).second_area;
}

pub fn split_pane_get_divider(sp: SplitPane) -> Int {
    return (sp).divider_pos;
}

pub fn layout_split_probe() -> Int {
    return 0;
}
