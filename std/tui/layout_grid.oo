// # TUI 2D Grid Layout Engine
//
// Logline: Two-dimensional grid layout manager with row/column tracks, cell spans, and gutters.
//
// Setup: Matrix-based container partitioning screen areas into multi-column and multi-row grids.
//
// Beats:
//   1. Define GridTrack sizing (fixed cells or fractional weights) and GridSlot spans.
//   2. Construct GridLayout with row and column track definitions and gutter spacing.
//   3. Compute resolved BufferArea bounds for any specified grid cell slot.

import "./tui_buffer.oo";

pub type GridTrack = struct {
    size_px: Int,
    is_auto: Bool,
    weight: Int
};

pub fn grid_track_fixed(size: Int) -> GridTrack {
    return GridTrack {
        size_px: size,
        is_auto: false,
        weight: 0
    };
}

pub fn grid_track_fraction(weight: Int) -> GridTrack {
    return GridTrack {
        size_px: 0,
        is_auto: true,
        weight: weight
    };
}

pub type GridSlot = struct {
    col_start: Int,
    col_span: Int,
    row_start: Int,
    row_span: Int
};

pub fn grid_slot_new(col_start: Int, col_span: Int, row_start: Int, row_span: Int) -> GridSlot {
    return GridSlot {
        col_start: col_start,
        col_span: col_span,
        row_start: row_start,
        row_span: row_span
    };
}

pub type GridLayout = struct {
    area: BufferArea,
    cols: List[GridTrack],
    rows: List[GridTrack],
    col_gap: Int,
    row_gap: Int
};

pub fn grid_layout_new(area: BufferArea, col_gap: Int, row_gap: Int) -> GridLayout {
    let c: List[GridTrack] = list_new();
    let r: List[GridTrack] = list_new();
    return GridLayout {
        area: area,
        cols: c,
        rows: r,
        col_gap: col_gap,
        row_gap: row_gap
    };
}

pub fn grid_layout_add_col(g: &mut GridLayout, track: GridTrack) {
    (g).cols = list_push((g).cols, track);
}

pub fn grid_layout_add_row(g: &mut GridLayout, track: GridTrack) {
    (g).rows = list_push((g).rows, track);
}

pub fn grid_layout_compute_slot(g: &GridLayout, slot: GridSlot) -> BufferArea {
    let num_cols = list_len((g).cols);
    let num_rows = list_len((g).rows);

    let total_w = (g).area.width;
    let total_h = (g).area.height;

    // Calculate column widths
    let mut total_fixed_w = 0;
    let mut total_weight_w = 0;
    let mut i = 0;
    while i < num_cols {
        let t: GridTrack = list_get((g).cols, i);
        if (t).is_auto {
            total_weight_w = total_weight_w + (t).weight;
        } else {
            total_fixed_w = total_fixed_w + (t).size_px;
        }
        i = i + 1;
    }

    let remaining_w = total_w - total_fixed_w - ((num_cols - 1) * (g).col_gap);
    let avail_w = if remaining_w > 0 { remaining_w } else { 0 };

    // Calculate start X and width for slot
    let mut cur_x = (g).area.x;
    let mut slot_x = cur_x;
    let mut slot_w = 0;

    let col_end = (slot).col_start + (slot).col_span;
    i = 0;
    while i < num_cols {
        let t: GridTrack = list_get((g).cols, i);
        let col_w = if (t).is_auto {
            if total_weight_w > 0 { (avail_w * (t).weight) / total_weight_w } else { 0 }
        } else {
            (t).size_px
        };

        if i == (slot).col_start {
            slot_x = cur_x;
        }
        if i >= (slot).col_start && i < col_end {
            slot_w = slot_w + col_w;
            if i > (slot).col_start {
                slot_w = slot_w + (g).col_gap;
            }
        }
        cur_x = cur_x + col_w + (g).col_gap;
        i = i + 1;
    }

    // Calculate row heights
    let mut total_fixed_h = 0;
    let mut total_weight_h = 0;
    let mut j = 0;
    while j < num_rows {
        let t: GridTrack = list_get((g).rows, j);
        if (t).is_auto {
            total_weight_h = total_weight_h + (t).weight;
        } else {
            total_fixed_h = total_fixed_h + (t).size_px;
        }
        j = j + 1;
    }

    let remaining_h = total_h - total_fixed_h - ((num_rows - 1) * (g).row_gap);
    let avail_h = if remaining_h > 0 { remaining_h } else { 0 };

    let mut cur_y = (g).area.y;
    let mut slot_y = cur_y;
    let mut slot_h = 0;

    let row_end = (slot).row_start + (slot).row_span;
    j = 0;
    while j < num_rows {
        let t: GridTrack = list_get((g).rows, j);
        let row_h = if (t).is_auto {
            if total_weight_h > 0 { (avail_h * (t).weight) / total_weight_h } else { 0 }
        } else {
            (t).size_px
        };

        if j == (slot).row_start {
            slot_y = cur_y;
        }
        if j >= (slot).row_start && j < row_end {
            slot_h = slot_h + row_h;
            if j > (slot).row_start {
                slot_h = slot_h + (g).row_gap;
            }
        }
        cur_y = cur_y + row_h + (g).row_gap;
        j = j + 1;
    }

    return BufferArea {
        x: slot_x,
        y: slot_y,
        width: slot_w,
        height: slot_h
    };
}
