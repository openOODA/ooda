// # TUI Terminal Renderer & ANSI Generator
//
// Logline: ANSI escape code generation, terminal state serialization, and differential screen rendering.
//
// Setup: Translation of screen buffer cell grids into high-efficiency VT100 / ANSI escape byte streams.
//
// Beats:
//   1. Generate ANSI cursor positioning, SGR color codes, and text style escape sequences.
//   2. Define TuiRenderer tracking active terminal dimensions and drawing passes.
//   3. Compute differential updates between buffers to minimize terminal I/O latency.

import "./tui_cell.oo";
import "./tui_buffer.oo";

pub type TuiRenderer = struct {
    width: Int,
    height: Int,
    alternate_screen: Bool,
    cursor_visible: Bool,
    draw_calls: Int
};

pub fn tui_renderer_new(width: Int, height: Int) -> TuiRenderer {
    return TuiRenderer {
        width: width,
        height: height,
        alternate_screen: false,
        cursor_visible: true,
        draw_calls: 0
    };
}

pub fn tui_render_ansi_move_to(x: Int, y: Int) -> String {
    let row = (y + 1).to_string();
    let col = (x + 1).to_string();
    return "\x1b[" + row + ";" + col + "H";
}

pub fn tui_render_ansi_color_fg(code: Int) -> String {
    if code >= 0 && code <= 7 {
        let base = 30 + code;
        return "\x1b[" + base.to_string() + "m";
    } else if code >= 8 && code <= 15 {
        let base = 90 + (code - 8);
        return "\x1b[" + base.to_string() + "m";
    } else {
        return "\x1b[38;5;" + code.to_string() + "m";
    }
}

pub fn tui_render_ansi_color_bg(code: Int) -> String {
    if code >= 0 && code <= 7 {
        let base = 40 + code;
        return "\x1b[" + base.to_string() + "m";
    } else if code >= 8 && code <= 15 {
        let base = 100 + (code - 8);
        return "\x1b[" + base.to_string() + "m";
    } else {
        return "\x1b[48;5;" + code.to_string() + "m";
    }
}

pub fn tui_render_ansi_reset() -> String {
    return "\x1b[0m";
}

pub fn tui_render_ansi_clear_screen() -> String {
    return "\x1b[2J\x1b[H";
}

pub fn tui_render_ansi_enter_alternate_screen() -> String {
    return "\x1b[?1049h";
}

pub fn tui_render_ansi_leave_alternate_screen() -> String {
    return "\x1b[?1049l";
}

fn tui_char_to_string(ch: Int) -> String {
    let mut b = bytes_new();
    b = bytes_push(b, ch);
    return bytes_to_str(b);
}

pub fn tui_render_cell_to_ansi(cell: TuiCell) -> String {
    let mut out: String = "";
    out = out + tui_render_ansi_color_fg((cell).fg);
    out = out + tui_render_ansi_color_bg((cell).bg);
    if tui_cell_has_modifier(cell, 1) != 0 {
        out = out + "\x1b[1m"; // Bold
    }
    if tui_cell_has_modifier(cell, 2) != 0 {
        out = out + "\x1b[2m"; // Dim
    }
    if tui_cell_has_modifier(cell, 4) != 0 {
        out = out + "\x1b[3m"; // Italic
    }
    if tui_cell_has_modifier(cell, 8) != 0 {
        out = out + "\x1b[4m"; // Underline
    }
    if tui_cell_has_modifier(cell, 16) != 0 {
        out = out + "\x1b[5m"; // Blink
    }
    if tui_cell_has_modifier(cell, 32) != 0 {
        out = out + "\x1b[7m"; // Reverse
    }
    out = out + tui_char_to_string((cell).ch);
    out = out + tui_render_ansi_reset();
    return out;
}

pub fn tui_render_buffer_full(buf: TuiBuffer) -> String {
    let mut out: String = "\x1b[H";
    let mut y: Int = 0;
    while y < (buf).height {
        let mut x: Int = 0;
        while x < (buf).width {
            let cell: TuiCell = tui_buffer_get_cell(buf, x, y);
            out = out + tui_render_cell_to_ansi(cell);
            x = x + 1;
        }
        if y < ((buf).height - 1) {
            out = out + "\r\n";
        }
        y = y + 1;
    }
    return out;
}

pub fn tui_render_diff(prev: TuiBuffer, next: TuiBuffer) -> String {
    let mut out: String = "";
    let h: Int = (next).height;
    let w: Int = (next).width;
    let mut y: Int = 0;
    while y < h {
        let mut x: Int = 0;
        while x < w {
            let c_prev: TuiCell = tui_buffer_get_cell(prev, x, y);
            let c_next: TuiCell = tui_buffer_get_cell(next, x, y);
            if tui_cell_equals(c_prev, c_next) == 0 {
                out = out + tui_render_ansi_move_to(x, y);
                out = out + tui_render_cell_to_ansi(c_next);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}
