// # TUI Selectable List Widget
//
// Logline: Single and multi-select vertical item list widget with scrollbar support and item tags.
//
// Setup: Interactive menu list widget for option selection, file pickers, and feeds.
//
// Beats:
//   1. Define ListItem model with selection, active status, and badge labels.
//   2. Manage active item focus, selection toggle, and scrolling windows.
//   3. Render item list with custom cursor markers and highlight styling.

import "./tui_cell.oo";
import "./tui_buffer.oo";

pub type ListItem = struct {
    id: Int,
    label: String,
    is_selected: Bool,
    is_disabled: Bool,
};

pub fn list_item_new(id: Int, label: String) -> ListItem {
    return ListItem {
        id: id,
        label: label,
        is_selected: false,
        is_disabled: false,
    };
}

pub type WidgetList = struct {
    id: Int,
    area: BufferArea,
    items: List[ListItem],
    active_index: Int,
    scroll_offset: Int,
    is_focused: Bool,
    is_multiselect: Bool,
};

pub fn widget_list_new(id: Int, area: BufferArea) -> WidgetList {
    let items: List[ListItem] = list_new();
    return WidgetList {
        id: id,
        area: area,
        items: items,
        active_index: 0,
        scroll_offset: 0,
        is_focused: false,
        is_multiselect: false,
    };
}

pub fn widget_list_add_item(lst: &mut WidgetList, item: ListItem) {
    (lst).items = list_push((lst).items, item);
}

pub fn widget_list_select_next(lst: &mut WidgetList) {
    let total = list_len((lst).items);
    if total == 0 {
        return;
    }
    if (lst).active_index < (total - 1) {
        (lst).active_index = (lst).active_index + 1;
        let view_h = (lst).area.height;
        if ((lst).active_index - (lst).scroll_offset) >= view_h {
            (lst).scroll_offset = (lst).active_index - view_h + 1;
        }
    }
}

pub fn widget_list_select_prev(lst: &mut WidgetList) {
    if (lst).active_index > 0 {
        (lst).active_index = (lst).active_index - 1;
        if (lst).active_index < (lst).scroll_offset {
            (lst).scroll_offset = (lst).active_index;
        }
    }
}

fn replace_list_item(items: List[ListItem], idx: Int, updated: ListItem) -> List[ListItem] {
    let total = list_len(items);
    let mut out: List[ListItem] = list_new();
    let mut i = 0;
    while i < total {
        if i == idx {
            out = list_push(out, updated);
        } else {
            out = list_push(out, list_get(items, i));
        }
        i = i + 1;
    }
    return out;
}

pub fn widget_list_toggle_selected(lst: &mut WidgetList) {
    let total = list_len((lst).items);
    if total == 0 {
        return;
    }
    let idx = (lst).active_index;
    let mut item: ListItem = list_get((lst).items, idx);
    if !(item.is_disabled) {
        item.is_selected = !(item.is_selected);
        (lst).items = replace_list_item((lst).items, idx, item);
    }
}

pub fn widget_list_get_selected_index(lst: &WidgetList) -> Int {
    return (lst).active_index;
}

pub fn widget_list_render(lst: &WidgetList, buf: &mut TuiBuffer) {
    let a = (lst).area;
    if a.width < 3 || a.height < 1 {
        return;
    }

    let total = list_len((lst).items);
    let mut r = 0;
    while r < a.height {
        let actual_idx = (lst).scroll_offset + r;
        let row_y = a.y + r;
        if actual_idx < total {
            let item: ListItem = list_get((lst).items, actual_idx);
            let is_active = actual_idx == (lst).active_index;
            let is_foc = (lst).is_focused;

            let fg = if item.is_disabled {
                8
            } else if is_active && is_foc {
                0
            } else {
                15
            };

            let bg = if is_active && is_foc {
                14
            } else {
                0
            };

            // Clear row background
            let mut x = a.x;
            while x < (a.x + a.width) {
                tui_buffer_set_cell(buf, x, row_y, tui_cell_new(" ", fg, bg));
                x = x + 1;
            }

            // Prefix marker
            let marker = if is_active { "▶ " } else { "  " };
            let check = if (lst).is_multiselect {
                if item.is_selected { "[x] " } else { "[ ] " }
            } else {
                ""
            };

            let prefix = marker + check;
            tui_buffer_write_string(buf, a.x, row_y, prefix, fg, bg, if is_active { 1 } else { 0 });
            tui_buffer_write_string(
                buf,
                a.x + prefix.len(),
                row_y,
                item.label,
                fg,
                bg,
                if is_active { 1 } else { 0 }
            );
        }
        r = r + 1;
    }
}
