// # TUI Keyboard Input & Event Model
//
// Logline: Terminal keyboard event parsing, special key codes, modifier keys, and key bindings.
//
// Setup: Universal event representation for VT100 keystrokes and escape sequence decoding.
//
// Beats:
//   1. Define KeyEvent structure tracking key code, char representation, and modifier flags.
//   2. Provide standard keycode constants for arrows, navigation, function, and editing keys.
//   3. Implement escape sequence parser and key classification predicate helpers.

pub type KeyEvent = struct {
    key_code: Int,
    key_char: String,
    is_ctrl: Bool,
    is_alt: Bool,
    is_shift: Bool,
    is_press: Bool
};

pub fn key_event_new(code: Int, ch: String) -> KeyEvent {
    return KeyEvent {
        key_code: code,
        key_char: ch,
        is_ctrl: false,
        is_alt: false,
        is_shift: false,
        is_press: true
    };
}

pub fn key_event_from_char(ch: String) -> KeyEvent {
    let mut code = 0;
    if ch.len() > 0 {
        code = byte_at(ch, 0);
    }
    return KeyEvent {
        key_code: code,
        key_char: ch,
        is_ctrl: false,
        is_alt: false,
        is_shift: false,
        is_press: true
    };
}

pub fn key_event_with_modifiers(
    code: Int,
    ch: String,
    ctrl: Bool,
    alt: Bool,
    shift: Bool
) -> KeyEvent {
    return KeyEvent {
        key_code: code,
        key_char: ch,
        is_ctrl: ctrl,
        is_alt: alt,
        is_shift: shift,
        is_press: true
    };
}

pub fn key_event_parse_escape(seq: String) -> KeyEvent {
    // Standard VT100/XTerm sequences:
    // ESC [ A -> Up (1001)
    // ESC [ B -> Down (1002)
    // ESC [ C -> Right (1004)
    // ESC [ D -> Left (1003)
    // ESC [ H -> Home (1005)
    // ESC [ F -> End (1006)
    // ESC [ 5 ~ -> PageUp (1007)
    // ESC [ 6 ~ -> PageDown (1008)
    if seq == "\x1b[A" {
        return key_event_new(1001, "Up");
    }
    if seq == "\x1b[B" {
        return key_event_new(1002, "Down");
    }
    if seq == "\x1b[C" {
        return key_event_new(1004, "Right");
    }
    if seq == "\x1b[D" {
        return key_event_new(1003, "Left");
    }
    if seq == "\x1b[H" || seq == "\x1b[1~" {
        return key_event_new(1005, "Home");
    }
    if seq == "\x1b[F" || seq == "\x1b[4~" {
        return key_event_new(1006, "End");
    }
    if seq == "\x1b[5~" {
        return key_event_new(1007, "PageUp");
    }
    if seq == "\x1b[6~" {
        return key_event_new(1008, "PageDown");
    }
    if seq == "\x1b[3~" {
        return key_event_new(127, "Delete");
    }
    if seq == "\x1b" {
        return key_event_new(27, "Escape");
    }
    if seq == "\t" {
        return key_event_new(9, "Tab");
    }
    if seq == "\r" || seq == "\n" {
        return key_event_new(13, "Enter");
    }
    return key_event_from_char(seq);
}

pub fn key_event_is_arrow(evt: &KeyEvent) -> Bool {
    let c = (evt).key_code;
    return c == 1001 || c == 1002 || c == 1003 || c == 1004;
}

pub fn key_event_is_navigation(evt: &KeyEvent) -> Bool {
    let c = (evt).key_code;
    return c >= 1001 && c <= 1008;
}

pub fn key_event_is_modifier(evt: &KeyEvent) -> Bool {
    return (evt).is_ctrl || (evt).is_alt || (evt).is_shift;
}
