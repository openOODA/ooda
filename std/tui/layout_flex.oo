// # TUI Flexbox Layout Engine
//
// Logline: Flexible box layout algorithm distributing rectangular areas across rows and columns.
//
// Setup: Declarative 1D flex container dividing screen space proportionally among child widgets.
//
// Beats:
//   1. Define FlexItem sizing constraints (min, max, flex_grow) and FlexContainer properties.
//   2. Compute proportional flex dimension allocations across primary and secondary axes.
//   3. Output resolved BufferArea bounding boxes for each flex child element.

import "./tui_buffer.oo";

pub type FlexItem = struct {
    min_size: Int,
    max_size: Int,
    flex_grow: Int,
    target_size: Int,
};

pub fn flex_item_new(min_size: Int, max_size: Int, flex_grow: Int) -> FlexItem {
    return FlexItem {
        min_size: min_size,
        max_size: max_size,
        flex_grow: flex_grow,
        target_size: 0,
    };
}

pub type FlexContainer = struct {
    area: BufferArea,
    direction: Int, // 0: Row, 1: Column
    justify: Int,   // 0: Start, 1: Center, 2: End, 3: SpaceBetween
    items: List[FlexItem],
};

pub fn flex_container_new(area: BufferArea, direction: Int, justify: Int) -> FlexContainer {
    let items: List[FlexItem] = list_new();
    return FlexContainer {
        area: area,
        direction: direction,
        justify: justify,
        items: items,
    };
}

pub fn flex_container_add_item(fc: &mut FlexContainer, item: FlexItem) {
    (fc).items = list_push((fc).items, item);
}

pub fn flex_layout_compute_row(fc: &FlexContainer) -> List[BufferArea] {
    let mut out: List[BufferArea] = list_new();
    let num_items = list_len((fc).items);
    if num_items == 0 {
        return out;
    }

    let total_w = (fc).area.width;
    let mut total_grow = 0;
    let mut i = 0;
    while i < num_items {
        let item: FlexItem = list_get((fc).items, i);
        let g = (item).flex_grow;
        total_grow = total_grow + if g > 0 { g } else { 1 };
        i = i + 1;
    }

    let mut cur_x = (fc).area.x;
    let h = (fc).area.height;
    let y = (fc).area.y;

    i = 0;
    while i < num_items {
        let item: FlexItem = list_get((fc).items, i);
        let g = (item).flex_grow;
        let weight = if g > 0 { g } else { 1 };
        let mut item_w = (total_w * weight) / total_grow;
        if item_w < (item).min_size {
            item_w = (item).min_size;
        }
        if (item).max_size > 0 && item_w > (item).max_size {
            item_w = (item).max_size;
        }

        let area = BufferArea {
            x: cur_x,
            y: y,
            width: item_w,
            height: h,
        };
        out = list_push(out, area);
        cur_x = cur_x + item_w;
        i = i + 1;
    }
    return out;
}

pub fn flex_layout_compute_column(fc: &FlexContainer) -> List[BufferArea] {
    let mut out: List[BufferArea] = list_new();
    let num_items = list_len((fc).items);
    if num_items == 0 {
        return out;
    }

    let total_h = (fc).area.height;
    let mut total_grow = 0;
    let mut i = 0;
    while i < num_items {
        let item: FlexItem = list_get((fc).items, i);
        let g = (item).flex_grow;
        total_grow = total_grow + if g > 0 { g } else { 1 };
        i = i + 1;
    }

    let mut cur_y = (fc).area.y;
    let w = (fc).area.width;
    let x = (fc).area.x;

    i = 0;
    while i < num_items {
        let item: FlexItem = list_get((fc).items, i);
        let g = (item).flex_grow;
        let weight = if g > 0 { g } else { 1 };
        let mut item_h = (total_h * weight) / total_grow;
        if item_h < (item).min_size {
            item_h = (item).min_size;
        }
        if (item).max_size > 0 && item_h > (item).max_size {
            item_h = (item).max_size;
        }

        let area = BufferArea {
            x: x,
            y: cur_y,
            width: w,
            height: item_h,
        };
        out = list_push(out, area);
        cur_y = cur_y + item_h;
        i = i + 1;
    }
    return out;
}
