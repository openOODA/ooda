// # TUI Character Cell
//
// Logline: Int-floor cell: glyph code, colors, modifier bits. By-value destub.
//
// Setup: ch is ASCII Int (65 = A). No String fields (emit trailing-dot).
//
// Beats:
//   1. tui_cell_new / empty constructors.
//   2. By-value color and modifier setters.
//   3. has_modifier via integer divide-mod bit test.

type TuiCell = struct {
    ch: Int,
    fg: Int,
    bg: Int,
    modifier: Int,
    is_dirty: Int
};

pub fn tui_cell_new(ch: Int, fg: Int, bg: Int) -> TuiCell {
    return TuiCell { ch: ch, fg: fg, bg: bg, modifier: 0, is_dirty: 1 };
}

pub fn tui_cell_empty() -> TuiCell {
    return TuiCell { ch: 32, fg: 7, bg: 0, modifier: 0, is_dirty: 0 };
}

pub fn tui_cell_equals(a: TuiCell, b: TuiCell) -> Int {
    if a.ch != b.ch {
        return 0;
    }
    if a.fg != b.fg {
        return 0;
    }
    if a.bg != b.bg {
        return 0;
    }
    if a.modifier != b.modifier {
        return 0;
    }
    return 1;
}

pub fn tui_cell_set_char(cell: TuiCell, ch: Int) -> TuiCell {
    return TuiCell { ch: ch, fg: cell.fg, bg: cell.bg, modifier: cell.modifier, is_dirty: 1 };
}

pub fn tui_cell_set_colors(cell: TuiCell, fg: Int, bg: Int) -> TuiCell {
    return TuiCell { ch: cell.ch, fg: fg, bg: bg, modifier: cell.modifier, is_dirty: 1 };
}

pub fn tui_cell_set_modifier(cell: TuiCell, modifier: Int) -> TuiCell {
    return TuiCell { ch: cell.ch, fg: cell.fg, bg: cell.bg, modifier: modifier, is_dirty: 1 };
}

pub fn tui_cell_has_modifier(cell: TuiCell, modifier: Int) -> Int {
    if modifier == 0 {
        return 0;
    }
    if ((cell.modifier / modifier) % 2) == 1 {
        return 1;
    }
    return 0;
}

pub fn tui_cell_set_dirty(cell: TuiCell, dirty: Int) -> TuiCell {
    return TuiCell { ch: cell.ch, fg: cell.fg, bg: cell.bg, modifier: cell.modifier, is_dirty: dirty };
}
