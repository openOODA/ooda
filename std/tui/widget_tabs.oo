// # TUI Tab Bar Widget
//
// Logline: Multi-page tab bar container with tab switching, overflow handling, and styled dividers.
//
// Setup: Top-level view switching component for multi-document and multi-panel TUIs.
//
// Beats:
//   1. Define TabItem descriptors and WidgetTabs state tracker.
//   2. Provide tab switching, wrap-around index selection, and active tab arbitration.
//   3. Render active tab highlight, inactive tab headers, and bottom tab separator line.

import "./tui_cell.oo";
import "./tui_buffer.oo";

pub type TabItem = struct {
    id: Int,
    title: String,
    is_disabled: Bool,
};

pub fn tab_item_new(id: Int, title: String) -> TabItem {
    return TabItem {
        id: id,
        title: title,
        is_disabled: false,
    };
}

pub type WidgetTabs = struct {
    id: Int,
    area: BufferArea,
    tabs: List[TabItem],
    active_tab_index: Int,
    is_focused: Bool,
};

pub fn widget_tabs_new(id: Int, area: BufferArea) -> WidgetTabs {
    let t: List[TabItem] = list_new();
    return WidgetTabs {
        id: id,
        area: area,
        tabs: t,
        active_tab_index: 0,
        is_focused: false,
    };
}

pub fn widget_tabs_add_tab(tabs: &mut WidgetTabs, tab: TabItem) {
    (tabs).tabs = list_push((tabs).tabs, tab);
}

pub fn widget_tabs_select_next(tabs: &mut WidgetTabs) {
    let total = list_len((tabs).tabs);
    if total == 0 {
        return;
    }
    (tabs).active_tab_index = ((tabs).active_tab_index + 1) % total;
}

pub fn widget_tabs_select_prev(tabs: &mut WidgetTabs) {
    let total = list_len((tabs).tabs);
    if total == 0 {
        return;
    }
    if (tabs).active_tab_index == 0 {
        (tabs).active_tab_index = total - 1;
    } else {
        (tabs).active_tab_index = (tabs).active_tab_index - 1;
    }
}

pub fn widget_tabs_set_active(tabs: &mut WidgetTabs, index: Int) {
    let total = list_len((tabs).tabs);
    if index >= 0 && index < total {
        (tabs).active_tab_index = index;
    }
}

pub fn widget_tabs_render(tabs: &WidgetTabs, buf: &mut TuiBuffer) {
    let a = (tabs).area;
    if a.width < 5 || a.height < 1 {
        return;
    }

    let tab_y = a.y;
    let total_tabs = list_len((tabs).tabs);
    let mut cur_x = a.x;

    let mut i = 0;
    while i < total_tabs && cur_x < (a.x + a.width) {
        let tab: TabItem = list_get((tabs).tabs, i);
        let is_active = i == (tabs).active_tab_index;
        let is_foc = (tabs).is_focused;

        let fg = if (tab).is_disabled {
            8
        } else if is_active && is_foc {
            0
        } else if is_active {
            15
        } else {
            7
        };

        let bg = if is_active && is_foc {
            14
        } else if is_active {
            4
        } else {
            0
        };

        let header = " [" + (tab).title + "] ";
        let h_len = header.len();

        tui_buffer_write_string(buf, cur_x, tab_y, header, fg, bg, if is_active { 1 } else { 0 });
        cur_x = cur_x + h_len;
        i = i + 1;
    }

    // Fill the rest of the tab header line
    while cur_x < (a.x + a.width) {
        tui_buffer_set_cell(buf, cur_x, tab_y, tui_cell_new("─", 8, 0));
        cur_x = cur_x + 1;
    }
}
