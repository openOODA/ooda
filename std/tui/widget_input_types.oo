// # TUI WidgetInput Data Type
//
// Logline: Single-line interactive text box struct and constructor.
//
// Setup: Form input entry widget holding value string, cursor, and placeholder.
//
// Beats:
//   1. Define WidgetInput structure.
//   2. Default constructor with empty value and cursor at start.

type WidgetInput = struct {
    id: Int,
    placeholder: String,
    value: String,
    cursor_pos: Int,
    scroll_offset: Int,
    max_len: Int,
    is_focused: Bool,
    is_masked: Bool,
    area: BufferArea
};

pub fn widget_input_new(id: Int, placeholder: String, area: BufferArea) -> WidgetInput {
    return WidgetInput {
        id: id,
        placeholder: placeholder,
        value: "",
        cursor_pos: 0,
        scroll_offset: 0,
        max_len: 256,
        is_focused: false,
        is_masked: false,
        area: area
    };
}
