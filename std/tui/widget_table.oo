// # TUI Data Table Widget
//
// Logline: Columnar data grid widget with headers, cell alignment, row selection, and scrolling.
//
// Setup: High-density structured data presentation with automatic column width distribution.
//
// Beats:
//   1. Define TableColumn descriptors and WidgetTable container structure.
//   2. Manage row selection indices and vertical scrolling viewport offsets.
//   3. Render header separator, row highlights, and cell values into screen buffer.

import "./tui_cell.oo";
import "./tui_buffer.oo";
import "./border_styles.oo";

pub type TableColumn = struct {
    title: String,
    width: Int,
    align: Int, // 0: Left, 1: Center, 2: Right
};

pub fn table_column_new(title: String, width: Int, align: Int) -> TableColumn {
    return TableColumn {
        title: title,
        width: width,
        align: align,
    };
}

pub type WidgetTable = struct {
    id: Int,
    area: BufferArea,
    columns: List[TableColumn],
    rows: List[List[String]],
    selected_row: Int,
    scroll_offset: Int,
    is_focused: Bool,
};

pub fn widget_table_new(id: Int, area: BufferArea) -> WidgetTable {
    let cols: List[TableColumn] = list_new();
    let rws: List[List[String]] = list_new();
    return WidgetTable {
        id: id,
        area: area,
        columns: cols,
        rows: rws,
        selected_row: 0,
        scroll_offset: 0,
        is_focused: false,
    };
}

pub fn widget_table_add_column(tbl: &mut WidgetTable, col: TableColumn) {
    (tbl).columns = list_push((tbl).columns, col);
}

pub fn widget_table_add_row(tbl: &mut WidgetTable, row: List[String]) {
    (tbl).rows = list_push((tbl).rows, row);
}

pub fn widget_table_select_next(tbl: &mut WidgetTable) {
    let total = list_len((tbl).rows);
    if total == 0 {
        return;
    }
    if (tbl).selected_row < (total - 1) {
        (tbl).selected_row = (tbl).selected_row + 1;
        let view_height = (tbl).area.height - 3;
        if ((tbl).selected_row - (tbl).scroll_offset) >= view_height {
            (tbl).scroll_offset = (tbl).selected_row - view_height + 1;
        }
    }
}

pub fn widget_table_select_prev(tbl: &mut WidgetTable) {
    if (tbl).selected_row > 0 {
        (tbl).selected_row = (tbl).selected_row - 1;
        if (tbl).selected_row < (tbl).scroll_offset {
            (tbl).scroll_offset = (tbl).selected_row;
        }
    }
}

pub fn widget_table_get_selected_index(tbl: &WidgetTable) -> Int {
    return (tbl).selected_row;
}

pub fn widget_table_render(tbl: &WidgetTable, buf: &mut TuiBuffer) {
    let a = (tbl).area;
    if a.width < 4 || a.height < 3 {
        return;
    }

    // 1. Draw frame border
    let b_style = border_style_single(if (tbl).is_focused { 14 } else { 8 }, 0);
    border_draw_perimeter(buf, a, b_style, border_sides_all());

    // 2. Render Headers
    let num_cols = list_len((tbl).columns);
    let mut cur_x = a.x + 1;
    let header_y = a.y + 1;
    let mut c_idx = 0;
    while c_idx < num_cols && cur_x < (a.x + a.width - 1) {
        let col: TableColumn = list_get((tbl).columns, c_idx);
        tui_buffer_write_string(buf, cur_x, header_y, col.title, 15, 0, 1);
        cur_x = cur_x + col.width + 1;
        if cur_x < (a.x + a.width - 1) {
            tui_buffer_set_cell(buf, cur_x - 1, header_y, tui_cell_new("│", 8, 0));
        }
        c_idx = c_idx + 1;
    }

    // 3. Draw Header Separator
    let sep_y = a.y + 2;
    let mut sx = a.x + 1;
    while sx < (a.x + a.width - 1) {
        tui_buffer_set_cell(buf, sx, sep_y, tui_cell_new("─", 8, 0));
        sx = sx + 1;
    }

    // 4. Render Rows
    let num_rows = list_len((tbl).rows);
    let max_display_rows = a.height - 3;
    let mut r_idx = 0;
    while r_idx < max_display_rows {
        let actual_row_idx = (tbl).scroll_offset + r_idx;
        if actual_row_idx < num_rows {
            let row_data: List[String] = list_get((tbl).rows, actual_row_idx);
            let row_y = a.y + 3 + r_idx;
            let is_sel = actual_row_idx == (tbl).selected_row;
            let fg = if is_sel { 0 } else { 7 };
            let bg = if is_sel { 14 } else { 0 };
            let modifier = if is_sel { 1 } else { 0 };

            // Fill entire row line background if selected
            if is_sel {
                let mut rx = a.x + 1;
                while rx < (a.x + a.width - 1) {
                    tui_buffer_set_cell(buf, rx, row_y, tui_cell_new(" ", fg, bg));
                    rx = rx + 1;
                }
            }

            let num_cells = list_len(row_data);
            let mut cell_x = a.x + 1;
            let mut col_i = 0;
            while col_i < num_cols && col_i < num_cells && cell_x < (a.x + a.width - 1) {
                let cell_txt: String = list_get(row_data, col_i);
                let col_info: TableColumn = list_get((tbl).columns, col_i);
                tui_buffer_write_string(buf, cell_x, row_y, cell_txt, fg, bg, modifier);
                cell_x = cell_x + col_info.width + 1;
                col_i = col_i + 1;
            }
        }
        r_idx = r_idx + 1;
    }
}
