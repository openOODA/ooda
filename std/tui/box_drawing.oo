// # Box Drawing Glyphs & Unicode Frames
//
// Logline: Unicode and ASCII box drawing character sets for window borders, dividers, and tables.
//
// Setup: Glyph tables covering single, double, rounded, heavy, dashed, and ASCII border styles.
//
// Beats:
//   1. Define BoxGlyphs data structure covering all 11 perimeter and intersection elements.
//   2. Provide standard glyph palettes: single, double, rounded, heavy, and ASCII.
//   3. Implement corner and junction lookup helpers for box construction.

type BoxGlyphs = struct {
    horizontal: String,
    vertical: String,
    top_left: String,
    top_right: String,
    bottom_left: String,
    bottom_right: String,
    cross: String,
    tee_down: String,
    tee_up: String,
    tee_right: String,
    tee_left: String
};

pub fn box_glyphs_single() -> BoxGlyphs {
    return BoxGlyphs {
        horizontal: "─",
        vertical: "│",
        top_left: "┌",
        top_right: "┐",
        bottom_left: "└",
        bottom_right: "┘",
        cross: "┼",
        tee_down: "┬",
        tee_up: "┴",
        tee_right: "├",
        tee_left: "┤"
    };
}

pub fn box_glyphs_double() -> BoxGlyphs {
    return BoxGlyphs {
        horizontal: "═",
        vertical: "║",
        top_left: "╔",
        top_right: "╗",
        bottom_left: "╚",
        bottom_right: "╝",
        cross: "╬",
        tee_down: "╦",
        tee_up: "╩",
        tee_right: "╠",
        tee_left: "╣"
    };
}

pub fn box_glyphs_rounded() -> BoxGlyphs {
    return BoxGlyphs {
        horizontal: "─",
        vertical: "│",
        top_left: "╭",
        top_right: "╮",
        bottom_left: "╰",
        bottom_right: "╯",
        cross: "┼",
        tee_down: "┬",
        tee_up: "┴",
        tee_right: "├",
        tee_left: "┤"
    };
}

pub fn box_glyphs_heavy() -> BoxGlyphs {
    return BoxGlyphs {
        horizontal: "━",
        vertical: "┃",
        top_left: "┏",
        top_right: "┓",
        bottom_left: "┗",
        bottom_right: "┛",
        cross: "╋",
        tee_down: "┳",
        tee_up: "┻",
        tee_right: "┣",
        tee_left: "┫"
    };
}

pub fn box_glyphs_ascii() -> BoxGlyphs {
    return BoxGlyphs {
        horizontal: "-",
        vertical: "|",
        top_left: "+",
        top_right: "+",
        bottom_left: "+",
        bottom_right: "+",
        cross: "+",
        tee_down: "+",
        tee_up: "+",
        tee_right: "+",
        tee_left: "+"
    };
}

pub fn box_glyphs_dashed() -> BoxGlyphs {
    return BoxGlyphs {
        horizontal: "┄",
        vertical: "┆",
        top_left: "┌",
        top_right: "┐",
        bottom_left: "└",
        bottom_right: "┘",
        cross: "┼",
        tee_down: "┬",
        tee_up: "┴",
        tee_right: "├",
        tee_left: "┤"
    };
}

pub fn box_glyphs_get_corner(g: &BoxGlyphs, is_top: Bool, is_left: Bool) -> String {
    if is_top && is_left {
        return (g).top_left;
    }
    if is_top && !is_left {
        return (g).top_right;
    }
    if !is_top && is_left {
        return (g).bottom_left;
    }
    return (g).bottom_right;
}

pub fn box_glyphs_get_tee(g: &BoxGlyphs, direction: Int) -> String {
    if direction == 0 {
        return (g).tee_down;
    }
    if direction == 1 {
        return (g).tee_up;
    }
    if direction == 2 {
        return (g).tee_right;
    }
    return (g).tee_left;
}
