// # TUI Light Color Theme & Palettes
//
// Logline: Light color palettes, high-legibility paper tokens, and daytime contrast themes for TUIs.
//
// Setup: Light theme specifications providing ANSI color codes for bright ambient terminal environments.
//
// Beats:
//   1. Define TuiLightTheme structure containing complete semantic color tokens.
//   2. Provide standard light themes: Default Light, Solarized Light, Latte, and Paper.
//   3. Implement theme query and color token lookup functions.

pub type TuiLightTheme = struct {
    bg: Int,
    fg: Int,
    surface: Int,
    accent: Int,
    muted: Int,
    border: Int,
    selection_bg: Int,
    selection_fg: Int,
    success: Int,
    warning: Int,
    error: Int,
};

pub fn theme_light_default() -> TuiLightTheme {
    return TuiLightTheme {
        bg: 15,
        fg: 0,
        surface: 7,
        accent: 4,
        muted: 8,
        border: 7,
        selection_bg: 4,
        selection_fg: 15,
        success: 2,
        warning: 3,
        error: 1,
    };
}

pub fn theme_light_solarized() -> TuiLightTheme {
    return TuiLightTheme {
        bg: 230,
        fg: 240,
        surface: 254,
        accent: 33,
        muted: 244,
        border: 250,
        selection_bg: 33,
        selection_fg: 230,
        success: 64,
        warning: 136,
        error: 160,
    };
}

