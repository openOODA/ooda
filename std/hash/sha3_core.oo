pub fn k_rc(i: Int) -> K64 {
    if i == 0 { return K64 { hi: 0, lo: 1 }; }
    if i == 1 { return K64 { hi: 0, lo: 32898 }; }
    if i == 2 { return K64 { hi: 2147483648, lo: 32906 }; }
    if i == 3 { return K64 { hi: 2147483648, lo: 2147516416 }; }
    if i == 4 { return K64 { hi: 0, lo: 32907 }; }
    if i == 5 { return K64 { hi: 0, lo: 2147483649 }; }
    if i == 6 { return K64 { hi: 2147483648, lo: 2147516545 }; }
    if i == 7 { return K64 { hi: 2147483648, lo: 32777 }; }
    if i == 8 { return K64 { hi: 0, lo: 138 }; }
    if i == 9 { return K64 { hi: 0, lo: 136 }; }
    if i == 10 { return K64 { hi: 0, lo: 2147516425 }; }
    if i == 11 { return K64 { hi: 0, lo: 2147483658 }; }
    if i == 12 { return K64 { hi: 0, lo: 2147516555 }; }
    if i == 13 { return K64 { hi: 2147483648, lo: 139 }; }
    if i == 14 { return K64 { hi: 2147483648, lo: 32905 }; }
    if i == 15 { return K64 { hi: 2147483648, lo: 32771 }; }
    if i == 16 { return K64 { hi: 2147483648, lo: 32770 }; }
    if i == 17 { return K64 { hi: 2147483648, lo: 128 }; }
    if i == 18 { return K64 { hi: 0, lo: 32778 }; }
    if i == 19 { return K64 { hi: 2147483648, lo: 2147483658 }; }
    if i == 20 { return K64 { hi: 2147483648, lo: 2147516545 }; }
    if i == 21 { return K64 { hi: 2147483648, lo: 32896 }; }
    if i == 22 { return K64 { hi: 0, lo: 2147483649 }; }
    return K64 { hi: 2147483648, lo: 2147516424 };
}

pub fn k_theta(s: KSt) -> KSt {
    let c0: K64 = k_xor64(k_xor64(k_xor64(k_xor64(s.a0, s.a5), s.a10), s.a15), s.a20);
    let c1: K64 = k_xor64(k_xor64(k_xor64(k_xor64(s.a1, s.a6), s.a11), s.a16), s.a21);
    let c2: K64 = k_xor64(k_xor64(k_xor64(k_xor64(s.a2, s.a7), s.a12), s.a17), s.a22);
    let c3: K64 = k_xor64(k_xor64(k_xor64(k_xor64(s.a3, s.a8), s.a13), s.a18), s.a23);
    let c4: K64 = k_xor64(k_xor64(k_xor64(k_xor64(s.a4, s.a9), s.a14), s.a19), s.a24);
    let d0: K64 = k_xor64(c4, k_rotl(c1, 1));
    let d1: K64 = k_xor64(c0, k_rotl(c2, 1));
    let d2: K64 = k_xor64(c1, k_rotl(c3, 1));
    let d3: K64 = k_xor64(c2, k_rotl(c4, 1));
    let d4: K64 = k_xor64(c3, k_rotl(c0, 1));
    return KSt {
        a0: k_xor64(s.a0, d0), a1: k_xor64(s.a1, d1), a2: k_xor64(s.a2, d2), a3: k_xor64(s.a3, d3), a4: k_xor64(s.a4, d4),
        a5: k_xor64(s.a5, d0), a6: k_xor64(s.a6, d1), a7: k_xor64(s.a7, d2), a8: k_xor64(s.a8, d3), a9: k_xor64(s.a9, d4),
        a10: k_xor64(s.a10, d0), a11: k_xor64(s.a11, d1), a12: k_xor64(s.a12, d2), a13: k_xor64(s.a13, d3), a14: k_xor64(s.a14, d4),
        a15: k_xor64(s.a15, d0), a16: k_xor64(s.a16, d1), a17: k_xor64(s.a17, d2), a18: k_xor64(s.a18, d3), a19: k_xor64(s.a19, d4),
        a20: k_xor64(s.a20, d0), a21: k_xor64(s.a21, d1), a22: k_xor64(s.a22, d2), a23: k_xor64(s.a23, d3), a24: k_xor64(s.a24, d4)
    };
}
