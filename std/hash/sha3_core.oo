    if i == 11 { return KSt { a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7, a8: s.a8, a9: s.a9, a10: s.a10, a11: v, a12: s.a12, a13: s.a13, a14: s.a14, a15: s.a15, a16: s.a16, a17: s.a17, a18: s.a18, a19: s.a19, a20: s.a20, a21: s.a21, a22: s.a22, a23: s.a23, a24: s.a24 }; }
    if i == 12 { return KSt { a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7, a8: s.a8, a9: s.a9, a10: s.a10, a11: s.a11, a12: v, a13: s.a13, a14: s.a14, a15: s.a15, a16: s.a16, a17: s.a17, a18: s.a18, a19: s.a19, a20: s.a20, a21: s.a21, a22: s.a22, a23: s.a23, a24: s.a24 }; }
    if i == 13 { return KSt { a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7, a8: s.a8, a9: s.a9, a10: s.a10, a11: s.a11, a12: s.a12, a13: v, a14: s.a14, a15: s.a15, a16: s.a16, a17: s.a17, a18: s.a18, a19: s.a19, a20: s.a20, a21: s.a21, a22: s.a22, a23: s.a23, a24: s.a24 }; }
    if i == 14 { return KSt { a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7, a8: s.a8, a9: s.a9, a10: s.a10, a11: s.a11, a12: s.a12, a13: s.a13, a14: v, a15: s.a15, a16: s.a16, a17: s.a17, a18: s.a18, a19: s.a19, a20: s.a20, a21: s.a21, a22: s.a22, a23: s.a23, a24: s.a24 }; }
    if i == 15 { return KSt { a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7, a8: s.a8, a9: s.a9, a10: s.a10, a11: s.a11, a12: s.a12, a13: s.a13, a14: s.a14, a15: v, a16: s.a16, a17: s.a17, a18: s.a18, a19: s.a19, a20: s.a20, a21: s.a21, a22: s.a22, a23: s.a23, a24: s.a24 }; }
    if i == 16 { return KSt { a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7, a8: s.a8, a9: s.a9, a10: s.a10, a11: s.a11, a12: s.a12, a13: s.a13, a14: s.a14, a15: s.a15, a16: v, a17: s.a17, a18: s.a18, a19: s.a19, a20: s.a20, a21: s.a21, a22: s.a22, a23: s.a23, a24: s.a24 }; }
