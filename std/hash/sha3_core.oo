    if i == 20 { return KSt { a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7, a8: s.a8, a9: s.a9, a10: s.a10, a11: s.a11, a12: s.a12, a13: s.a13, a14: s.a14, a15: s.a15, a16: s.a16, a17: s.a17, a18: s.a18, a19: s.a19, a20: v, a21: s.a21, a22: s.a22, a23: s.a23, a24: s.a24 }; }
