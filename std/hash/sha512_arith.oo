// # SHA-512 64-bit Arithmetic Primitives
//
// Logline: Mask, xor, add, rotate-right, shift-right, Ch, and Maj primitives over Sha64 32-bit halves.
//
// Setup: Pure Int 32-bit halves (add/xor/rotr/shr).
//
// Beats:
//   1. s_mask, s_xor, s_add, s_xor64.
//   2. s_rotr, s_shr: 64-bit rotate-right and shift-right across halves.
//   3. s_ch, s_maj: SHA choice and majority functions.

import "./sha512_words.oo";

fn s_mask(x: Int) -> Int {
    return x & 4294967295;
}

fn s_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn s_add(a: Sha64, b: Sha64) -> Sha64 {
    let sum_lo: Int = (a).lo + (b).lo;
    let carry: Int = sum_lo >> 32;
    let nlo: Int = s_mask(sum_lo);
    let nhi: Int = s_mask((a).hi + (b).hi + carry);
    return Sha64 { hi: nhi, lo: nlo };
}

fn s_xor64(a: Sha64, b: Sha64) -> Sha64 {
    return Sha64 { hi: s_xor((a).hi, (b).hi), lo: s_xor((a).lo, (b).lo) };
}

fn s_rotr(a: Sha64, r: Int) -> Sha64 {
    let mut xh: Int = (a).hi;
    let mut xl: Int = (a).lo;
    let mut rr: Int = r;
    if rr >= 32 {
        xh = (a).lo;
        xl = (a).hi;
        rr = r - 32;
    }
    if rr == 0 {
        return Sha64 { hi: xh, lo: xl };
    }
    let sh: Int = 32 - rr;
    let nhi: Int = s_mask((xh >> rr) | (xl << sh));
    let nlo: Int = s_mask((xl >> rr) | (xh << sh));
    return Sha64 { hi: nhi, lo: nlo };
}

fn s_shr(a: Sha64, r: Int) -> Sha64 {
    if r >= 32 {
        return Sha64 { hi: 0, lo: (a).hi >> (r - 32) };
    }
    let sh: Int = 32 - r;
    let nhi: Int = (a).hi >> r;
    let nlo: Int = s_mask(((a).lo >> r) | ((a).hi << sh));
    return Sha64 { hi: nhi, lo: nlo };
}

fn s_ch(x: Sha64, y: Sha64, z: Sha64) -> Sha64 {
    let nxh: Int = s_xor((x).hi, 4294967295);
    let nxl: Int = s_xor((x).lo, 4294967295);
    return Sha64 { hi: s_xor((x).hi & (y).hi, nxh & (z).hi), lo: s_xor((x).lo & (y).lo, nxl & (z).lo) };
}

fn s_maj(x: Sha64, y: Sha64, z: Sha64) -> Sha64 {
    return Sha64 {
        hi: s_xor(s_xor((x).hi & (y).hi, (x).hi & (z).hi), (y).hi & (z).hi),
        lo: s_xor(s_xor((x).lo & (y).lo, (x).lo & (z).lo), (y).lo & (z).lo)
    };
}
