// # SHA-512 Sigma Functions and Hex Nibble Parser
//
// Logline: sig0/sig1/sum0/sum1 rotate/shift patterns and nib/hex parsing helpers.
//
// Setup: Pure Int 32-bit halves arithmetic using sha512_arith primitives.
//
// Beats:
//   1. s_sig0, s_sig1: message schedule sigma functions.
//   2. s_sum0, s_sum1: compression sum functions.
//   3. s_nib: parse a hex nibble char (0-15).
//   4. s_ph32: parse 8 hex chars into one 32-bit word.

import "./sha512_words.oo";
import "./sha512_arith.oo";

fn s_sig0(x: Sha64) -> Sha64 {
    return s_xor64(s_xor64(s_rotr(x, 1), s_rotr(x, 8)), s_shr(x, 7));
}

fn s_sig1(x: Sha64) -> Sha64 {
    return s_xor64(s_xor64(s_rotr(x, 19), s_rotr(x, 61)), s_shr(x, 6));
}

fn s_sum0(x: Sha64) -> Sha64 {
    return s_xor64(s_xor64(s_rotr(x, 28), s_rotr(x, 34)), s_rotr(x, 39));
}

fn s_sum1(x: Sha64) -> Sha64 {
    return s_xor64(s_xor64(s_rotr(x, 14), s_rotr(x, 18)), s_rotr(x, 41));
}

fn s_nib(c: Int) -> Int {
    if c >= 97 {
        return c - 87;
    }
    return c - 48;
}

fn s_ph32(s: String, off: Int) -> Int {
    let mut v: Int = 0;
    let mut j: Int = 0;
    while j < 8 {
        v = (v << 4) + s_nib(byte_at(s, off + j));
        j = j + 1;
    }
    return v;
}
