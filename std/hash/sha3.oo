// # SHA-3 / Keccak one-shot
//
// Logline: One-shot SHA3-256/512 and Keccak-256/512; lowercase hex digest.
//
// Setup: Pure Int 32-bit halves (add/xor/rotl). Keccak-f[1600], 25 lanes. FIPS 202.
//
// Beats:
//   1. Absorb rate bytes, pad domain||10*1, permute after each block.
//   2. 24-round theta/rho/pi/chi/iota on the 1600-bit state.
//   3. Incremental init/update/finalize stay residual.

type K64 = struct {
    hi: Int,
    lo: Int
};

type KSt = struct {
    a0: K64,
    a1: K64,
    a2: K64,
    a3: K64,
    a4: K64,
    a5: K64,
    a6: K64,
    a7: K64,
    a8: K64,
    a9: K64,
    a10: K64,
    a11: K64,
    a12: K64,
    a13: K64,
    a14: K64,
    a15: K64,
    a16: K64,
    a17: K64,
    a18: K64,
    a19: K64,
    a20: K64,
    a21: K64,
    a22: K64,
    a23: K64,
    a24: K64
};

fn k_mask(x: Int) -> Int {
    return x & 4294967295;
}

fn k_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn k_xor64(a: K64, b: K64) -> K64 {
    return K64 { hi: k_xor(a.hi, b.hi), lo: k_xor(a.lo, b.lo) };
}

fn k_and64(a: K64, b: K64) -> K64 {
    return K64 { hi: a.hi & b.hi, lo: a.lo & b.lo };
}

fn k_not64(a: K64) -> K64 {
    return K64 { hi: k_xor(a.hi, 4294967295), lo: k_xor(a.lo, 4294967295) };
}

fn k_rotl(a: K64, r: Int) -> K64 {
    let mut xh: Int = a.hi;
    let mut xl: Int = a.lo;
    let mut rr: Int = r;
    if rr >= 32 {
        xh = a.lo;
        xl = a.hi;
        rr = r - 32;
    }
    if rr == 0 {
        return K64 { hi: xh, lo: xl };
    }
    let sh: Int = 32 - rr;
    let nhi: Int = k_mask((xh << rr) | (xl >> sh));
    let nlo: Int = k_mask((xl << rr) | (xh >> sh));
    return K64 { hi: nhi, lo: nlo };
}

fn k_zero() -> K64 {
    return K64 { hi: 0, lo: 0 };
}

fn k_empty() -> KSt {
    let z: K64 = k_zero();
    return KSt {
        a0: z, a1: z, a2: z, a3: z, a4: z,
        a5: z, a6: z, a7: z, a8: z, a9: z,
        a10: z, a11: z, a12: z, a13: z, a14: z,
        a15: z, a16: z, a17: z, a18: z, a19: z,
        a20: z, a21: z, a22: z, a23: z, a24: z
    };
}

fn k_get(s: KSt, i: Int) -> K64 {
    if i == 0 { return s.a0; }
    if i == 1 { return s.a1; }
    if i == 2 { return s.a2; }
    if i == 3 { return s.a3; }
    if i == 4 { return s.a4; }
    if i == 5 { return s.a5; }
    if i == 6 { return s.a6; }
    if i == 7 { return s.a7; }
    if i == 8 { return s.a8; }
    if i == 9 { return s.a9; }
    if i == 10 { return s.a10; }
    if i == 11 { return s.a11; }
    if i == 12 { return s.a12; }
    if i == 13 { return s.a13; }
    if i == 14 { return s.a14; }
    if i == 15 { return s.a15; }
    if i == 16 { return s.a16; }
    if i == 17 { return s.a17; }
    if i == 18 { return s.a18; }
    if i == 19 { return s.a19; }
    if i == 20 { return s.a20; }
    if i == 21 { return s.a21; }
    if i == 22 { return s.a22; }
    if i == 23 { return s.a23; }
    return s.a24;
}

fn k_set(s: KSt, i: Int, v: K64) -> KSt {
    if i == 0 { return KSt { a0: v, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7, a8: s.a8, a9: s.a9, a10: s.a10, a11: s.a11, a12: s.a12, a13: s.a13, a14: s.a14, a15: s.a15, a16: s.a16, a17: s.a17, a18: s.a18, a19: s.a19, a20: s.a20, a21: s.a21, a22: s.a22, a23: s.a23, a24: s.a24 }; }
