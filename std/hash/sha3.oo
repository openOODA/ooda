        a10: k_xor64(s.a10, d0), a11: k_xor64(s.a11, d1), a12: k_xor64(s.a12, d2), a13: k_xor64(s.a13, d3), a14: k_xor64(s.a14, d4),
        a15: k_xor64(s.a15, d0), a16: k_xor64(s.a16, d1), a17: k_xor64(s.a17, d2), a18: k_xor64(s.a18, d3), a19: k_xor64(s.a19, d4),
        a20: k_xor64(s.a20, d0), a21: k_xor64(s.a21, d1), a22: k_xor64(s.a22, d2), a23: k_xor64(s.a23, d3), a24: k_xor64(s.a24, d4)
    };
}

fn k_rhopi(s: KSt) -> KSt {
    return KSt {
        a0: k_rotl(s.a0, 0),
        a1: k_rotl(s.a6, 44),
        a2: k_rotl(s.a12, 43),
        a3: k_rotl(s.a18, 21),
        a4: k_rotl(s.a24, 14),
        a5: k_rotl(s.a3, 28),
        a6: k_rotl(s.a9, 20),
        a7: k_rotl(s.a10, 3),
        a8: k_rotl(s.a16, 45),
        a9: k_rotl(s.a22, 61),
        a10: k_rotl(s.a1, 1),
        a11: k_rotl(s.a7, 6),
        a12: k_rotl(s.a13, 25),
        a13: k_rotl(s.a19, 8),
        a14: k_rotl(s.a20, 18),
        a15: k_rotl(s.a4, 27),
        a16: k_rotl(s.a5, 36),
        a17: k_rotl(s.a11, 10),
        a18: k_rotl(s.a17, 15),
        a19: k_rotl(s.a23, 56),
        a20: k_rotl(s.a2, 62),
        a21: k_rotl(s.a8, 55),
        a22: k_rotl(s.a14, 39),
        a23: k_rotl(s.a15, 41),
        a24: k_rotl(s.a21, 2)
    };
}

fn k_chi_row(a: K64, b: K64, c: K64, d: K64, e: K64) -> KSt {
    return KSt {
        a0: k_xor64(a, k_and64(k_not64(b), c)),
        a1: k_xor64(b, k_and64(k_not64(c), d)),
        a2: k_xor64(c, k_and64(k_not64(d), e)),
        a3: k_xor64(d, k_and64(k_not64(e), a)),
        a4: k_xor64(e, k_and64(k_not64(a), b)),
        a5: k_zero(), a6: k_zero(), a7: k_zero(), a8: k_zero(), a9: k_zero(),
        a10: k_zero(), a11: k_zero(), a12: k_zero(), a13: k_zero(), a14: k_zero(),
        a15: k_zero(), a16: k_zero(), a17: k_zero(), a18: k_zero(), a19: k_zero(),
        a20: k_zero(), a21: k_zero(), a22: k_zero(), a23: k_zero(), a24: k_zero()
    };
}

fn k_chi(s: KSt) -> KSt {
    let r0: KSt = k_chi_row(s.a0, s.a1, s.a2, s.a3, s.a4);
    let r1: KSt = k_chi_row(s.a5, s.a6, s.a7, s.a8, s.a9);
    let r2: KSt = k_chi_row(s.a10, s.a11, s.a12, s.a13, s.a14);
    let r3: KSt = k_chi_row(s.a15, s.a16, s.a17, s.a18, s.a19);
    let r4: KSt = k_chi_row(s.a20, s.a21, s.a22, s.a23, s.a24);
    return KSt {
        a0: r0.a0, a1: r0.a1, a2: r0.a2, a3: r0.a3, a4: r0.a4,
        a5: r1.a0, a6: r1.a1, a7: r1.a2, a8: r1.a3, a9: r1.a4,
        a10: r2.a0, a11: r2.a1, a12: r2.a2, a13: r2.a3, a14: r2.a4,
        a15: r3.a0, a16: r3.a1, a17: r3.a2, a18: r3.a3, a19: r3.a4,
        a20: r4.a0, a21: r4.a1, a22: r4.a2, a23: r4.a3, a24: r4.a4
    };
}

fn k_f(s0: KSt) -> KSt {
    let mut s: KSt = s0;
    let mut r: Int = 0;
    while r < 24 {
        s = k_theta(s);
        s = k_rhopi(s);
        s = k_chi(s);
        s = KSt {
            a0: k_xor64(s.a0, k_rc(r)),
            a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4,
            a5: s.a5, a6: s.a6, a7: s.a7, a8: s.a8, a9: s.a9,
            a10: s.a10, a11: s.a11, a12: s.a12, a13: s.a13, a14: s.a14,
            a15: s.a15, a16: s.a16, a17: s.a17, a18: s.a18, a19: s.a19,
            a20: s.a20, a21: s.a21, a22: s.a22, a23: s.a23, a24: s.a24
        };
        r = r + 1;
    }
    return s;
}

fn k_padb(data: String, n: Int, total: Int, pos: Int, domain: Int) -> Int {
    if pos < n {
        return byte_at(data, pos);
    }
    let mut b: Int = 0;
    if pos == n {
        b = domain;
    }
    if pos == total - 1 {
        b = b | 128;
    }
    return b;
}

fn k_load8(data: String, n: Int, total: Int, pos: Int, domain: Int) -> K64 {
    let b0: Int = k_padb(data, n, total, pos, domain);
    let b1: Int = k_padb(data, n, total, pos + 1, domain);
    let b2: Int = k_padb(data, n, total, pos + 2, domain);
    let b3: Int = k_padb(data, n, total, pos + 3, domain);
    let b4: Int = k_padb(data, n, total, pos + 4, domain);
    let b5: Int = k_padb(data, n, total, pos + 5, domain);
    let b6: Int = k_padb(data, n, total, pos + 6, domain);
    let b7: Int = k_padb(data, n, total, pos + 7, domain);
    let lo: Int = b0 + (b1 << 8) + (b2 << 16) + (b3 << 24);
    let hi: Int = b4 + (b5 << 8) + (b6 << 16) + (b7 << 24);
    return K64 { hi: hi, lo: lo };
}

fn k_hexb(v: Int) -> String {
    let hx: String = "0123456789abcdef";
    let b: Int = v & 255;
    return char_at(hx, (b >> 4) & 15) + char_at(hx, b & 15);
}

fn k_hex_lane(w: K64) -> String {
    return k_hexb(w.lo) + k_hexb(w.lo >> 8) + k_hexb(w.lo >> 16) + k_hexb(w.lo >> 24) + k_hexb(w.hi) + k_hexb(w.hi >> 8) + k_hexb(w.hi >> 16) + k_hexb(w.hi >> 24);
}

fn k_hex_out(s: KSt, nbytes: Int) -> String {
    let nl: Int = nbytes / 8;
    let mut out: String = "";
    let mut i: Int = 0;
    while i < nl {
        out = out + k_hex_lane(k_get(s, i));
        i = i + 1;
    }
    return out;
}

fn k_hash(data: String, rate: Int, domain: Int, out_len: Int) -> String {
    let n: Int = data.len();
    let total: Int = ((n / rate) + 1) * rate;
    let mut s: KSt = k_empty();
    let lanes: Int = rate / 8;
    let mut pos: Int = 0;
    while pos < total {
        let mut i: Int = 0;
        while i < lanes {
            let w: K64 = k_load8(data, n, total, pos + i * 8, domain);
            s = k_set(s, i, k_xor64(k_get(s, i), w));
            i = i + 1;
        }
        s = k_f(s);
        pos = pos + rate;
    }
    return k_hex_out(s, out_len);
}

pub fn sha3_256(data: String) -> String {
    return k_hash(data, 136, 6, 32);
}

pub fn sha3_512(data: String) -> String {
    return k_hash(data, 72, 6, 64);
}

pub fn keccak256(data: String) -> String {
    return k_hash(data, 136, 1, 32);
}

pub fn keccak512(data: String) -> String {
    return k_hash(data, 72, 1, 64);
}

pub fn sha3_init() -> Int {
    process_exit(1);
    return 0;
}

pub fn sha3_update(ctx: Int, data: String) -> Int {
    process_exit(1);
    return 0;
}

pub fn sha3_final(ctx: Int) -> String {
    process_exit(1);
    return "";
}
