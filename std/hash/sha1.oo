// package: std::hash
// job: SHA-1 hex non-crypto checksum (RFC 3174 legacy digest, not a security function)
// residual: collisions exist; do not use for integrity or passwords

pub fn sha1(data: String) -> String
    requires data.len() >= 0
    ensures result.len() == 40
{
    return crypto_sha1_internal(data);
}

verify sha1 {
    assert_eq!(sha1("").len(), 40);
}
