// package: std::hash
// job: SHA-1 hex digest via sealed runtime floor (path A honesty: real SHA-1)
// residual: none on digest path — crypto_sha1_internal is product CHS

pub fn sha1(data: String) -> String
    requires data.len() >= 0
    ensures result.len() == 40
{
    return crypto_sha1_internal(data);
}

verify sha1 {
    assert_eq!(sha1("").len(), 40);
}
