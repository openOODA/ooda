// # SHA-1 Hex Checksum
//
// Logline: sha1 returns a 40-character hex checksum of any string via crypto_sha1_internal.
//
// Setup: RFC 3174 defines the digest; crypto_sha1_internal is the CHS builtin.
//
// Beats:
//   1. Publish sha1 over any String.
//   2. Forward the bytes to crypto_sha1_internal.
//   3. Contract a 40-character result and verify the empty string.
//
// residual: collisions exist; not for integrity or passwords

pub fn sha1(data: String) -> String
    requires data.len() >= 0
    ensures result.len() == 40
{
    return crypto_sha1_internal(data);
}

verify sha1 {
    assert_eq!(sha1("").len(), 40);
}
