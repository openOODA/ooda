// # Key-Value String Map / Dictionary
//
// Logline: Deterministic associative collection for key-value string storage and lookups.
//
// Setup: Implements structured associative dictionary with delimiter-isolated entries and key iteration.
//
// Beats:
//   1. Construct empty map and test emptiness.
//   2. Insert, update, and remove key-value associations.
//   3. Retrieve values with Result semantics.
//   4. List map keys and values.
// RULES.oot 1.4: Pure data structure, no ambient capabilities.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type HashMap = struct {
    data: String,
    size: Int
};

pub fn map_new() -> HashMap {
    return HashMap {
        data: "",
        size: 0
    };
}

pub fn map_len(m: HashMap) -> Int {
    return m.size;
}

pub fn map_is_empty(m: HashMap) -> Bool {
    return m.size == 0;
}

pub fn map_has(m: HashMap, key: String) -> Bool {
    let target: String = "\n" + key + "\t";
    let wrapped: String = "\n" + m.data;
    return wrapped.contains(target);
}

pub fn map_get(m: HashMap, key: String) -> Result[String, String] {
    let target: String = "\n" + key + "\t";
    let wrapped: String = "\n" + m.data;
    let pos: Int = str_index_of(wrapped, target);
    if pos < 0 {
        return Err("KEY_NOT_FOUND");
    }

    let val_start: Int = pos + chars_len(target);
    let rem: String = str_slice(wrapped, val_start, chars_len(wrapped));
    let end_pos: Int = str_index_of(rem, "\n");
    if end_pos < 0 {
        return Ok(rem);
    }
    let val: String = str_slice(rem, 0, end_pos);
    return Ok(val);
}

pub fn map_get_or(m: HashMap, key: String, default_val: String) -> String {
    let r: Result[String, String] = map_get(m, key);
    return res_unwrap_or(r, default_val);
}

pub fn map_insert(mut m: HashMap, key: String, val: String) -> HashMap {
    if map_has(m, key) {
        m = map_remove(m, key);
    }
    m.data = m.data + key + "\t" + val + "\n";
    m.size = m.size + 1;
    return m;
}

pub fn map_remove(mut m: HashMap, key: String) -> HashMap {
    let target: String = "\n" + key + "\t";
    let wrapped: String = "\n" + m.data;
    let pos: Int = str_index_of(wrapped, target);
    if pos < 0 {
        return m;
    }

    let before: String = str_slice(wrapped, 1, pos);
    let after_start: Int = pos + chars_len(target);
    let rem: String = str_slice(wrapped, after_start, chars_len(wrapped));
    let next_nl: Int = str_index_of(rem, "\n");
    let mut after: String = "";
    if next_nl >= 0 {
        after = str_slice(rem, next_nl + 1, chars_len(rem));
    }

    let mut new_data: String = "";
    if chars_len(before) > 0 {
        new_data = before + "\n";
    }
    new_data = new_data + after;
    m.data = new_data;
    if m.size > 0 {
        m.size = m.size - 1;
    }
    return m;
}

pub fn map_keys(m: HashMap) -> List[String] {
    let mut out: List[String] = list_new();
    let mut cur: String = m.data;
    while chars_len(cur) > 0 {
        let nl_pos: Int = str_index_of(cur, "\n");
        let mut line: String = cur;
        if nl_pos >= 0 {
            line = str_slice(cur, 0, nl_pos);
            cur = str_slice(cur, nl_pos + 1, chars_len(cur));
        } else {
            cur = "";
        }
        let tab_pos: Int = str_index_of(line, "\t");
        if tab_pos >= 0 {
            let k: String = str_slice(line, 0, tab_pos);
            out = list_push(out, k);
        }
    }
    return out;
}

pub fn map_values(m: HashMap) -> List[String] {
    let mut out: List[String] = list_new();
    let mut cur: String = m.data;
    while chars_len(cur) > 0 {
        let nl_pos: Int = str_index_of(cur, "\n");
        let mut line: String = cur;
        if nl_pos >= 0 {
            line = str_slice(cur, 0, nl_pos);
            cur = str_slice(cur, nl_pos + 1, chars_len(cur));
        } else {
            cur = "";
        }
        let tab_pos: Int = str_index_of(line, "\t");
        if tab_pos >= 0 {
            let v: String = str_slice(line, tab_pos + 1, chars_len(line));
            out = list_push(out, v);
        }
    }
    return out;
}
