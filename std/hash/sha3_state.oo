// # SHA-3 State Empty and Get
//
// Logline: k_empty constructs an all-zero 25-lane KSt; k_get reads lane i by index.
//
// Setup: Lane index 0..24.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//

import "./sha3_types.oo";
import "./sha3_64.oo";

fn k_empty() -> KSt {
    let z: K64 = k_zero();
    return KSt {
        a0: z, a1: z, a2: z, a3: z, a4: z,
        a5: z, a6: z, a7: z, a8: z, a9: z,
        a10: z, a11: z, a12: z, a13: z, a14: z,
        a15: z, a16: z, a17: z, a18: z, a19: z,
        a20: z, a21: z, a22: z, a23: z, a24: z
    };
}

fn k_get(s: KSt, i: Int) -> K64 {
    if i == 0 { return s.a0; }
    if i == 1 { return s.a1; }
    if i == 2 { return s.a2; }
    if i == 3 { return s.a3; }
    if i == 4 { return s.a4; }
    if i == 5 { return s.a5; }
    if i == 6 { return s.a6; }
    if i == 7 { return s.a7; }
    if i == 8 { return s.a8; }
    if i == 9 { return s.a9; }
    if i == 10 { return s.a10; }
    if i == 11 { return s.a11; }
    if i == 12 { return s.a12; }
    if i == 13 { return s.a13; }
    if i == 14 { return s.a14; }
    if i == 15 { return s.a15; }
    if i == 16 { return s.a16; }
    if i == 17 { return s.a17; }
    if i == 18 { return s.a18; }
    if i == 19 { return s.a19; }
    if i == 20 { return s.a20; }
    if i == 21 { return s.a21; }
    if i == 22 { return s.a22; }
    if i == 23 { return s.a23; }
    return s.a24;
}
