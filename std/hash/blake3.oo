// # BLAKE3 one-shot
//
// Logline: One-shot unkeyed BLAKE3; 32-byte digest as 64 lowercase hex chars.
//
// Setup: Pure Int 32-bit words (add/xor/rotr). Official 7-round compress + chunk tree.
//
// Beats:
//   1. Compress 64-byte blocks with CHUNK_START / CHUNK_END / ROOT flags.
//   2. Parent nodes merge chunk chaining values when the input exceeds 1024 bytes.
//   3. Incremental hasher and keyed/XOF modes stay residual.

type B16 = struct {
    s0: Int,
    s1: Int,
    s2: Int,
    s3: Int,
    s4: Int,
    s5: Int,
    s6: Int,
    s7: Int,
    s8: Int,
    s9: Int,
    s10: Int,
    s11: Int,
    s12: Int,
    s13: Int,
    s14: Int,
    s15: Int
};

fn b3_mask(x: Int) -> Int {
    return x & 4294967295;
}

fn b3_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn b3_rotr(x: Int, r: Int) -> Int {
    let v: Int = b3_mask(x);
    let right: Int = v >> r;
    let left: Int = (v << (32 - r)) & 4294967295;
    return (left | right) & 4294967295;
}

fn b3_get(s: B16, i: Int) -> Int {
    if i == 0 { return s.s0; }
    if i == 1 { return s.s1; }
    if i == 2 { return s.s2; }
    if i == 3 { return s.s3; }
    if i == 4 { return s.s4; }
    if i == 5 { return s.s5; }
    if i == 6 { return s.s6; }
    if i == 7 { return s.s7; }
    if i == 8 { return s.s8; }
    if i == 9 { return s.s9; }
    if i == 10 { return s.s10; }
    if i == 11 { return s.s11; }
    if i == 12 { return s.s12; }
    if i == 13 { return s.s13; }
    if i == 14 { return s.s14; }
    return s.s15;
}

fn b3_set(s: B16, i: Int, v: Int) -> B16 {
    if i == 0 { return B16 { s0: v, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 1 { return B16 { s0: s.s0, s1: v, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 2 { return B16 { s0: s.s0, s1: s.s1, s2: v, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 3 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: v, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 4 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: v, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 5 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: v, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 6 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: v, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 7 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: v, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 8 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: v, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 9 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: v, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 10 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: v, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 11 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: v, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 12 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: v, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 13 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: v, s14: s.s14, s15: s.s15 }; }
    if i == 14 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: v, s15: s.s15 }; }
    return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: v };
}

fn b3_mix(s: B16, a: Int, b: Int, c: Int, d: Int, mx: Int, my: Int) -> B16 {
    let mut va: Int = b3_get(s, a);
    let mut vb: Int = b3_get(s, b);
    let mut vc: Int = b3_get(s, c);
    let mut vd: Int = b3_get(s, d);
    va = b3_mask(va + vb + mx);
    vd = b3_rotr(b3_xor(vd, va), 16);
    vc = b3_mask(vc + vd);
    vb = b3_rotr(b3_xor(vb, vc), 12);
    va = b3_mask(va + vb + my);
    vd = b3_rotr(b3_xor(vd, va), 8);
    vc = b3_mask(vc + vd);
    vb = b3_rotr(b3_xor(vb, vc), 7);
    let mut t: B16 = b3_set(s, a, va);
    t = b3_set(t, b, vb);
    t = b3_set(t, c, vc);
    t = b3_set(t, d, vd);
    return t;
}

fn b3_round(s: B16, m: B16) -> B16 {
    let mut t: B16 = s;
    t = b3_mix(t, 0, 4, 8, 12, m.s0, m.s1);
    t = b3_mix(t, 1, 5, 9, 13, m.s2, m.s3);
    t = b3_mix(t, 2, 6, 10, 14, m.s4, m.s5);
    t = b3_mix(t, 3, 7, 11, 15, m.s6, m.s7);
    t = b3_mix(t, 0, 5, 10, 15, m.s8, m.s9);
    t = b3_mix(t, 1, 6, 11, 12, m.s10, m.s11);
    t = b3_mix(t, 2, 7, 8, 13, m.s12, m.s13);
    t = b3_mix(t, 3, 4, 9, 14, m.s14, m.s15);
    return t;
}

fn b3_perm(m: B16) -> B16 {
    return B16 {
        s0: m.s2,
        s1: m.s6,
        s2: m.s3,
        s3: m.s10,
        s4: m.s7,
        s5: m.s0,
        s6: m.s4,
        s7: m.s13,
        s8: m.s1,
        s9: m.s11,
        s10: m.s12,
        s11: m.s5,
        s12: m.s9,
        s13: m.s14,
        s14: m.s15,
        s15: m.s8
    };
}

fn b3_iv() -> B16 {
    return B16 {
        s0: 1779033703,
        s1: 3144134277,
        s2: 1013904242,
        s3: 2773480762,
        s4: 1359893119,
        s5: 2600822924,
        s6: 528734635,
        s7: 1541459225,
        s8: 0,
        s9: 0,
        s10: 0,
        s11: 0,
        s12: 0,
        s13: 0,
        s14: 0,
        s15: 0
    };
}

fn b3_compress(cv: B16, m: B16, clo: Int, chi: Int, block_len: Int, flags: Int) -> B16 {
    let mut s: B16 = B16 {
        s0: cv.s0,
        s1: cv.s1,
        s2: cv.s2,
        s3: cv.s3,
        s4: cv.s4,
        s5: cv.s5,
        s6: cv.s6,
        s7: cv.s7,
        s8: 1779033703,
        s9: 3144134277,
        s10: 1013904242,
        s11: 2773480762,
        s12: clo,
        s13: chi,
        s14: block_len,
        s15: flags
    };
    let mut msg: B16 = m;
    let mut r: Int = 0;
    while r < 7 {
        s = b3_round(s, msg);
        msg = b3_perm(msg);
        r = r + 1;
    }
    return B16 {
        s0: b3_xor(s.s0, s.s8),
        s1: b3_xor(s.s1, s.s9),
        s2: b3_xor(s.s2, s.s10),
        s3: b3_xor(s.s3, s.s11),
        s4: b3_xor(s.s4, s.s12),
        s5: b3_xor(s.s5, s.s13),
        s6: b3_xor(s.s6, s.s14),
        s7: b3_xor(s.s7, s.s15),
        s8: 0,
        s9: 0,
        s10: 0,
        s11: 0,
        s12: 0,
        s13: 0,
        s14: 0,
        s15: 0
    };
}

fn b3_word(data: String, n: Int, off: Int) -> Int {
    let mut v: Int = 0;
    let mut i: Int = 0;
    while i < 4 {
        if off + i < n {
            v = v + (byte_at(data, off + i) << (i * 8));
        }
        i = i + 1;
    }
    return v;
}

fn b3_load(data: String, n: Int, base: Int) -> B16 {
    return B16 {
        s0: b3_word(data, n, base),
        s1: b3_word(data, n, base + 4),
        s2: b3_word(data, n, base + 8),
        s3: b3_word(data, n, base + 12),
        s4: b3_word(data, n, base + 16),
        s5: b3_word(data, n, base + 20),
        s6: b3_word(data, n, base + 24),
        s7: b3_word(data, n, base + 28),
        s8: b3_word(data, n, base + 32),
        s9: b3_word(data, n, base + 36),
        s10: b3_word(data, n, base + 40),
        s11: b3_word(data, n, base + 44),
        s12: b3_word(data, n, base + 48),
        s13: b3_word(data, n, base + 52),
        s14: b3_word(data, n, base + 56),
        s15: b3_word(data, n, base + 60)
    };
}

fn b3_chunk(data: String, n: Int, chunk_i: Int, extra: Int) -> B16 {
    let start: Int = chunk_i * 1024;
    let mut clen: Int = n - start;
    if clen > 1024 {
        clen = 1024;
    }
    if clen < 0 {
        clen = 0;
    }
    let mut nblocks: Int = (clen + 63) / 64;
    if clen == 0 {
        nblocks = 1;
    }
    let mut cv: B16 = b3_iv();
    let mut bi: Int = 0;
    while bi < nblocks {
        let base: Int = start + bi * 64;
        let mut blen: Int = n - base;
        if blen > 64 {
            blen = 64;
        }
        if blen < 0 {
            blen = 0;
        }
        if clen == 0 {
            blen = 0;
        }
        let mut flags: Int = extra;
        if bi == 0 {
            flags = flags + 1;
        }
        if bi == nblocks - 1 {
            flags = flags + 2;
        }
        let m: B16 = b3_load(data, n, base);
        cv = b3_compress(cv, m, b3_mask(chunk_i), b3_mask(chunk_i >> 32), blen, flags);
        bi = bi + 1;
    }
    return cv;
}

fn b3_parent(left: B16, right: B16, extra: Int) -> B16 {
    let m: B16 = B16 {
        s0: left.s0,
        s1: left.s1,
        s2: left.s2,
        s3: left.s3,
        s4: left.s4,
        s5: left.s5,
        s6: left.s6,
        s7: left.s7,
        s8: right.s0,
        s9: right.s1,
        s10: right.s2,
        s11: right.s3,
        s12: right.s4,
        s13: right.s5,
        s14: right.s6,
        s15: right.s7
    };
    return b3_compress(b3_iv(), m, 0, 0, 64, 4 + extra);
}

fn b3_hexb(v: Int) -> String {
    let hx: String = "0123456789abcdef";
    let b: Int = v & 255;
    return char_at(hx, (b >> 4) & 15) + char_at(hx, b & 15);
}

fn b3_hexw(w: Int) -> String {
    let v: Int = b3_mask(w);
    return b3_hexb(v) + b3_hexb(v >> 8) + b3_hexb(v >> 16) + b3_hexb(v >> 24);
}

fn b3_hex(cv: B16) -> String {
    return b3_hexw(cv.s0) + b3_hexw(cv.s1) + b3_hexw(cv.s2) + b3_hexw(cv.s3) + b3_hexw(cv.s4) + b3_hexw(cv.s5) + b3_hexw(cv.s6) + b3_hexw(cv.s7);
}

fn b3_nib(c: Int) -> Int {
    if c >= 97 {
        return c - 87;
    }
    return c - 48;
}

fn b3_parsew(s: String, off: Int) -> Int {
    let b0: Int = (b3_nib(byte_at(s, off)) << 4) + b3_nib(byte_at(s, off + 1));
    let b1: Int = (b3_nib(byte_at(s, off + 2)) << 4) + b3_nib(byte_at(s, off + 3));
    let b2: Int = (b3_nib(byte_at(s, off + 4)) << 4) + b3_nib(byte_at(s, off + 5));
    let b3: Int = (b3_nib(byte_at(s, off + 6)) << 4) + b3_nib(byte_at(s, off + 7));
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24);
}

fn b3_parse(s: String, off: Int) -> B16 {
    return B16 {
        s0: b3_parsew(s, off),
        s1: b3_parsew(s, off + 8),
        s2: b3_parsew(s, off + 16),
        s3: b3_parsew(s, off + 24),
        s4: b3_parsew(s, off + 32),
        s5: b3_parsew(s, off + 40),
        s6: b3_parsew(s, off + 48),
        s7: b3_parsew(s, off + 56),
        s8: 0,
        s9: 0,
        s10: 0,
        s11: 0,
        s12: 0,
        s13: 0,
        s14: 0,
        s15: 0
    };
}

fn b3_substr(s: String, start: Int, end: Int) -> String {
    let mut o: String = "";
    let mut i: Int = start;
    while i < end {
        o = o + char_at(s, i);
        i = i + 1;
    }
    return o;
}

pub fn blake3(data: String) -> String {
    let n: Int = data.len();
    if n <= 1024 {
        return b3_hex(b3_chunk(data, n, 0, 8));
    }
    let nchunks: Int = (n + 1023) / 1024;
    let mut stack: String = "";
    let mut ci: Int = 0;
    while ci < nchunks - 1 {
        let mut cv: B16 = b3_chunk(data, n, ci, 0);
        let mut total: Int = ci + 1;
        while (total & 1) == 0 {
            let sl: Int = stack.len();
            let left: B16 = b3_parse(stack, sl - 64);
            stack = b3_substr(stack, 0, sl - 64);
            cv = b3_parent(left, cv, 0);
            total = total / 2;
        }
        stack = stack + b3_hex(cv);
        ci = ci + 1;
    }
    let mut cv: B16 = b3_chunk(data, n, nchunks - 1, 0);
    while stack.len() > 0 {
        let sl: Int = stack.len();
        let left: B16 = b3_parse(stack, sl - 64);
        stack = b3_substr(stack, 0, sl - 64);
        let mut extra: Int = 0;
        if stack.len() == 0 {
            extra = 8;
        }
        cv = b3_parent(left, cv, extra);
    }
    return b3_hex(cv);
}

pub fn blake3_init() -> Int {
    process_exit(1);
    return 0;
}

pub fn blake3_update(ctx: Int, data: String) -> Int {
    process_exit(1);
    return 0;
}

pub fn blake3_final(ctx: Int) -> String {
    process_exit(1);
    return "";
}
