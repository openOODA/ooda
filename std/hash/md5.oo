// package: std::hash
// job: MD5 hex digest via sealed runtime floor (path A honesty: real MD5)
// residual: none on digest path — crypto_md5_internal is product CHS

pub fn md5(data: String) -> String
    requires data.len() >= 0
    ensures result.len() == 32
{
    return crypto_md5_internal(data);
}

verify md5 {
    assert_eq!(md5("").len(), 32);
}
