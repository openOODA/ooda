// package: std::hash
// job: MD5 hex non-crypto checksum (RFC 1321 legacy digest, not a security function)
// residual: collisions exist; do not use for integrity or passwords

pub fn md5(data: String) -> String
    requires data.len() >= 0
    ensures result.len() == 32
{
    return crypto_md5_internal(data);
}

verify md5 {
    assert_eq!(md5("").len(), 32);
}
