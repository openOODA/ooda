// # MD5 Hex Checksum
//
// Logline: md5 returns a 32-character hex checksum of any string via crypto_md5_internal.
//
// Setup: RFC 1321 defines the digest; crypto_md5_internal is the CHS builtin.
//
// Beats:
//   1. Publish md5 over any String.
//   2. Forward the bytes to crypto_md5_internal.
//   3. Contract a 32-character result and verify the empty string.
//
// residual: collisions exist; not for integrity or passwords

pub fn md5(data: String) -> String
    requires data.len() >= 0
    ensures result.len() == 32
{
    return crypto_md5_internal(data);
}

verify md5 {
    assert_eq!(md5("").len(), 32);
}
