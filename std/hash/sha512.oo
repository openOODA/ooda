// # SHA-512 one-shot
//
// Logline: Hashes a byte string with one-shot SHA-512 and returns the 512-bit state as 128 lowercase hex chars.
//
// Setup: Pure Int 32-bit halves. Imports sha512_core.oo.
//
// Beats:
//   1. Pad to 128-byte blocks with 0x80 and 128-bit BE bit length.
//   2. 80-round compression with a 16-word schedule window.
//   3. Emit the 512-bit state as hex.

import "./sha512_core.oo";

type Sha64 = struct {
    hi: Int,
    lo: Int
};

type ShaSt = struct {
    ah: Int, al: Int,
    bh: Int, bl: Int,
    ch: Int, cl: Int,
    dh: Int, dl: Int,
    eh: Int, el: Int,
    fh: Int, fl: Int,
    gh: Int, gl: Int,
    hh: Int, hl: Int
};

pub fn s_compress(st: ShaSt, data: String, base: Int, n: Int, total: Int) -> ShaSt {
    let z: Sha64 = Sha64 { hi: 0, lo: 0 };
    let mut w0: Sha64 = z;
    let mut w1: Sha64 = z;
    let mut w2: Sha64 = z;
    let mut w3: Sha64 = z;
    let mut w4: Sha64 = z;
    let mut w5: Sha64 = z;
    let mut w6: Sha64 = z;
    let mut w7: Sha64 = z;
    let mut w8: Sha64 = z;
    let mut w9: Sha64 = z;
    let mut w10: Sha64 = z;
    let mut w11: Sha64 = z;
    let mut w12: Sha64 = z;
    let mut w13: Sha64 = z;
    let mut w14: Sha64 = z;
    let mut w15: Sha64 = z;
    let mut s: ShaSt = st;
    let mut t: Int = 0;
    while t < 80 {
        let mut wt: Sha64 = z;
        if t < 16 {
            wt = s_be64(data, n, total, base + t * 8);
        } else {
            wt = s_add(s_add(s_sig1(w14), w9), s_add(s_sig0(w1), w0));
        }
        s = s_rnd(s, wt, s_k(t));
        w0 = w1;
        w1 = w2;
        w2 = w3;
        w3 = w4;
        w4 = w5;
        w5 = w6;
        w6 = w7;
        w7 = w8;
        w8 = w9;
        w9 = w10;
        w10 = w11;
        w11 = w12;
        w12 = w13;
        w13 = w14;
        w14 = w15;
        w15 = wt;
        t = t + 1;
    }
    return s_addst(st, s);
}

pub fn s_hexb(v: Int) -> String {
    let hx: String = "0123456789abcdef";
    let b: Int = v & 255;
    return char_at(hx, (b >> 4) & 15) + char_at(hx, b & 15);
}

pub fn s_hexw(w: Sha64) -> String {
    let h: Int = w.hi;
    let l: Int = w.lo;
    return s_hexb(h >> 24) + s_hexb(h >> 16) + s_hexb(h >> 8) + s_hexb(h) + s_hexb(l >> 24) + s_hexb(l >> 16) + s_hexb(l >> 8) + s_hexb(l);
}

pub fn sha512(data: String) -> String {
    let n: Int = data.len();
    let rem: Int = n % 128;
    let mut blocks: Int = n / 128;
    if rem <= 111 {
        blocks = blocks + 1;
    } else {
        blocks = blocks + 2;
    }
    let total: Int = blocks * 128;
    let mut st: ShaSt = ShaSt {
        ah: 1779033703, al: 4089235720,
        bh: 3144134277, bl: 2227873595,
        ch: 1013904242, cl: 4271175723,
        dh: 2773480762, dl: 1595750129,
        eh: 1359893119, el: 2917565137,
        fh: 2600822924, fl: 725511199,
        gh: 528734635, gl: 4215389547,
        hh: 1541459225, hl: 327033209
    };
    let mut blk: Int = 0;
    while blk < blocks {
        let s2: ShaSt = s_compress(st, data, blk * 128, n, total);
        let s0: ShaSt = ShaSt {
            ah: s2.ah, al: s2.al,
            bh: s2.bh, bl: s2.bl,
            ch: s2.ch, cl: s2.cl,
            dh: s2.dh, dl: s2.dl,
            eh: s2.eh, el: s2.el,
            fh: s2.fh, fl: s2.fl,
            gh: s2.gh, gl: s2.gl,
            hh: s2.hh, hl: s2.hl
        };
        st = s0;
        blk = blk + 1;
    }
    return s_hexw(s_word(st, 0)) + s_hexw(s_word(st, 1)) + s_hexw(s_word(st, 2)) + s_hexw(s_word(st, 3)) + s_hexw(s_word(st, 4)) + s_hexw(s_word(st, 5)) + s_hexw(s_word(st, 6)) + s_hexw(s_word(st, 7));
}
