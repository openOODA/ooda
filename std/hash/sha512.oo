// # SHA-512 one-shot
//
// Logline: One-shot SHA-512 over a byte string; 128 lowercase hex chars.
//
// Setup: Pure Int 32-bit halves (add/xor/rotr). FIPS 180-4. No arrays.
//
// Beats:
//   1. Pad to 128-byte blocks with 0x80 and 128-bit BE bit length.
//   2. 80-round compression with a 16-word schedule window.
//   3. Emit the 512-bit state as hex.

type Sha64 = struct {
    hi: Int,
    lo: Int
};

type ShaSt = struct {
    ah: Int,
    al: Int,
    bh: Int,
    bl: Int,
    ch: Int,
    cl: Int,
    dh: Int,
    dl: Int,
    eh: Int,
    el: Int,
    fh: Int,
    fl: Int,
    gh: Int,
    gl: Int,
    hh: Int,
    hl: Int
};

fn s_mask(x: Int) -> Int {
    return x & 4294967295;
}

fn s_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn s_add(a: Sha64, b: Sha64) -> Sha64 {
    let sum_lo: Int = a.lo + b.lo;
    let carry: Int = sum_lo >> 32;
    let nlo: Int = s_mask(sum_lo);
    let nhi: Int = s_mask(a.hi + b.hi + carry);
    return Sha64 { hi: nhi, lo: nlo };
}

fn s_xor64(a: Sha64, b: Sha64) -> Sha64 {
    return Sha64 { hi: s_xor(a.hi, b.hi), lo: s_xor(a.lo, b.lo) };
}

fn s_rotr(a: Sha64, r: Int) -> Sha64 {
    let mut xh: Int = a.hi;
    let mut xl: Int = a.lo;
    let mut rr: Int = r;
    if rr >= 32 {
        xh = a.lo;
        xl = a.hi;
        rr = r - 32;
    }
    if rr == 0 {
        return Sha64 { hi: xh, lo: xl };
    }
    let sh: Int = 32 - rr;
    let nhi: Int = s_mask((xh >> rr) | (xl << sh));
    let nlo: Int = s_mask((xl >> rr) | (xh << sh));
    return Sha64 { hi: nhi, lo: nlo };
}

fn s_shr(a: Sha64, r: Int) -> Sha64 {
    if r >= 32 {
        return Sha64 { hi: 0, lo: a.hi >> (r - 32) };
    }
    let sh: Int = 32 - r;
    let nhi: Int = a.hi >> r;
    let nlo: Int = s_mask((a.lo >> r) | (a.hi << sh));
    return Sha64 { hi: nhi, lo: nlo };
}

fn s_ch(x: Sha64, y: Sha64, z: Sha64) -> Sha64 {
    let nxh: Int = s_xor(x.hi, 4294967295);
    let nxl: Int = s_xor(x.lo, 4294967295);
    return Sha64 { hi: s_xor(x.hi & y.hi, nxh & z.hi), lo: s_xor(x.lo & y.lo, nxl & z.lo) };
}

fn s_maj(x: Sha64, y: Sha64, z: Sha64) -> Sha64 {
    return Sha64 {
        hi: s_xor(s_xor(x.hi & y.hi, x.hi & z.hi), y.hi & z.hi),
        lo: s_xor(s_xor(x.lo & y.lo, x.lo & z.lo), y.lo & z.lo)
    };
}

fn s_sig0(x: Sha64) -> Sha64 {
    return s_xor64(s_xor64(s_rotr(x, 1), s_rotr(x, 8)), s_shr(x, 7));
}

fn s_sig1(x: Sha64) -> Sha64 {
    return s_xor64(s_xor64(s_rotr(x, 19), s_rotr(x, 61)), s_shr(x, 6));
}

fn s_sum0(x: Sha64) -> Sha64 {
    return s_xor64(s_xor64(s_rotr(x, 28), s_rotr(x, 34)), s_rotr(x, 39));
}

fn s_sum1(x: Sha64) -> Sha64 {
    return s_xor64(s_xor64(s_rotr(x, 14), s_rotr(x, 18)), s_rotr(x, 41));
}

fn s_nib(c: Int) -> Int {
    if c >= 97 {
        return c - 87;
    }
    return c - 48;
}

fn s_ph32(s: String, off: Int) -> Int {
    let mut v: Int = 0;
    let mut j: Int = 0;
    while j < 8 {
        v = (v << 4) + s_nib(byte_at(s, off + j));
        j = j + 1;
    }
    return v;
}

fn s_k(i: Int) -> Sha64 {
    let ks: String = "";
    let off: Int = i * 16;
    return Sha64 { hi: s_ph32(ks, off), lo: s_ph32(ks, off + 8) };
}

fn s_padb(data: String, n: Int, total: Int, pos: Int) -> Int {
    if pos < n {
        return byte_at(data, pos);
    }
    if pos == n {
        return 128;
    }
    if pos < total - 8 {
        return 0;
    }
    let shift: Int = (total - 1 - pos) * 8;
    return ((n * 8) >> shift) & 255;
}

fn s_be64(data: String, n: Int, total: Int, pos: Int) -> Sha64 {
    let b0: Int = s_padb(data, n, total, pos);
    let b1: Int = s_padb(data, n, total, pos + 1);
    let b2: Int = s_padb(data, n, total, pos + 2);
    let b3: Int = s_padb(data, n, total, pos + 3);
    let b4: Int = s_padb(data, n, total, pos + 4);
    let b5: Int = s_padb(data, n, total, pos + 5);
    let b6: Int = s_padb(data, n, total, pos + 6);
    let b7: Int = s_padb(data, n, total, pos + 7);
    let hi: Int = (b0 << 24) + (b1 << 16) + (b2 << 8) + b3;
    let lo: Int = (b4 << 24) + (b5 << 16) + (b6 << 8) + b7;
    return Sha64 { hi: hi, lo: lo };
}

fn s_word(s: ShaSt, i: Int) -> Sha64 {
    if i == 0 { return Sha64 { hi: s.ah, lo: s.al }; }
    if i == 1 { return Sha64 { hi: s.bh, lo: s.bl }; }
    if i == 2 { return Sha64 { hi: s.ch, lo: s.cl }; }
    if i == 3 { return Sha64 { hi: s.dh, lo: s.dl }; }
    if i == 4 { return Sha64 { hi: s.eh, lo: s.el }; }
    if i == 5 { return Sha64 { hi: s.fh, lo: s.fl }; }
    if i == 6 { return Sha64 { hi: s.gh, lo: s.gl }; }
    return Sha64 { hi: s.hh, lo: s.hl };
}

fn s_rnd(s: ShaSt, w: Sha64, k: Sha64) -> ShaSt {
    let a: Sha64 = s_word(s, 0);
    let b: Sha64 = s_word(s, 1);
    let c: Sha64 = s_word(s, 2);
    let d: Sha64 = s_word(s, 3);
    let e: Sha64 = s_word(s, 4);
    let f: Sha64 = s_word(s, 5);
    let g: Sha64 = s_word(s, 6);
    let h: Sha64 = s_word(s, 7);
    let t1: Sha64 = s_add(s_add(s_add(s_add(h, s_sum1(e)), s_ch(e, f, g)), k), w);
    let t2: Sha64 = s_add(s_sum0(a), s_maj(a, b, c));
    let e2: Sha64 = s_add(d, t1);
    let a2: Sha64 = s_add(t1, t2);
    return ShaSt {
        ah: a2.hi, al: a2.lo,
        bh: a.hi, bl: a.lo,
        ch: b.hi, cl: b.lo,
        dh: c.hi, dl: c.lo,
        eh: e2.hi, el: e2.lo,
        fh: e.hi, fl: e.lo,
        gh: f.hi, gl: f.lo,
        hh: g.hi, hl: g.lo
    };
}

fn s_addst(x: ShaSt, y: ShaSt) -> ShaSt {
    let a: Sha64 = s_add(s_word(x, 0), s_word(y, 0));
    let b: Sha64 = s_add(s_word(x, 1), s_word(y, 1));
    let c: Sha64 = s_add(s_word(x, 2), s_word(y, 2));
    let d: Sha64 = s_add(s_word(x, 3), s_word(y, 3));
    let e: Sha64 = s_add(s_word(x, 4), s_word(y, 4));
    let f: Sha64 = s_add(s_word(x, 5), s_word(y, 5));
    let g: Sha64 = s_add(s_word(x, 6), s_word(y, 6));
    let h: Sha64 = s_add(s_word(x, 7), s_word(y, 7));
    return ShaSt {
        ah: a.hi, al: a.lo,
        bh: b.hi, bl: b.lo,
        ch: c.hi, cl: c.lo,
        dh: d.hi, dl: d.lo,
        eh: e.hi, el: e.lo,
        fh: f.hi, fl: f.lo,
        gh: g.hi, gl: g.lo,
        hh: h.hi, hl: h.lo
    };
}

fn s_compress(st: ShaSt, data: String, base: Int, n: Int, total: Int) -> ShaSt {
    let z: Sha64 = Sha64 { hi: 0, lo: 0 };
    let mut w0: Sha64 = z;
    let mut w1: Sha64 = z;
    let mut w2: Sha64 = z;
    let mut w3: Sha64 = z;
    let mut w4: Sha64 = z;
    let mut w5: Sha64 = z;
    let mut w6: Sha64 = z;
    let mut w7: Sha64 = z;
    let mut w8: Sha64 = z;
    let mut w9: Sha64 = z;
    let mut w10: Sha64 = z;
    let mut w11: Sha64 = z;
    let mut w12: Sha64 = z;
    let mut w13: Sha64 = z;
    let mut w14: Sha64 = z;
    let mut w15: Sha64 = z;
    let mut s: ShaSt = st;
    let mut t: Int = 0;
    while t < 80 {
        let mut wt: Sha64 = z;
        if t < 16 {
            wt = s_be64(data, n, total, base + t * 8);
        } else {
            wt = s_add(s_add(s_sig1(w14), w9), s_add(s_sig0(w1), w0));
        }
        s = s_rnd(s, wt, s_k(t));
        w0 = w1;
        w1 = w2;
        w2 = w3;
        w3 = w4;
        w4 = w5;
        w5 = w6;
        w6 = w7;
        w7 = w8;
        w8 = w9;
        w9 = w10;
        w10 = w11;
        w11 = w12;
        w12 = w13;
        w13 = w14;
        w14 = w15;
        w15 = wt;
        t = t + 1;
    }
    return s_addst(st, s);
}

fn s_hexb(v: Int) -> String {
    let hx: String = "0123456789abcdef";
    let b: Int = v & 255;
    return char_at(hx, (b >> 4) & 15) + char_at(hx, b & 15);
}

fn s_hexw(w: Sha64) -> String {
    let h: Int = w.hi;
    let l: Int = w.lo;
    return s_hexb(h >> 24) + s_hexb(h >> 16) + s_hexb(h >> 8) + s_hexb(h) + s_hexb(l >> 24) + s_hexb(l >> 16) + s_hexb(l >> 8) + s_hexb(l);
}

pub fn sha512(data: String) -> String {
    let n: Int = data.len();
    let rem: Int = n % 128;
    let mut blocks: Int = n / 128;
    if rem <= 111 {
        blocks = blocks + 1;
    } else {
        blocks = blocks + 2;
    }
    let total: Int = blocks * 128;
    let mut st: ShaSt = ShaSt {
        ah: 1779033703, al: 4089235720,
        bh: 3144134277, bl: 2227873595,
        ch: 1013904242, cl: 4271175723,
        dh: 2773480762, dl: 1595750129,
        eh: 1359893119, el: 2917565137,
        fh: 2600822924, fl: 725511199,
        gh: 528734635, gl: 4215389547,
        hh: 1541459225, hl: 327033209
    };
    let mut blk: Int = 0;
    while blk < blocks {
        st = s_compress(st, data, blk * 128, n, total);
        blk = blk + 1;
    }
    return s_hexw(s_word(st, 0)) + s_hexw(s_word(st, 1)) + s_hexw(s_word(st, 2)) + s_hexw(s_word(st, 3)) + s_hexw(s_word(st, 4)) + s_hexw(s_word(st, 5)) + s_hexw(s_word(st, 6)) + s_hexw(s_word(st, 7));
}
