// # ISO 3309 CRC-32
//
// Logline: Computes IEEE 802.3 CRC-32 with polynomial 0xEDB88320 by bitwise steps and by a 256-entry table.
//
// Setup: Pure. Input is List[Int] 0..255. Residue is 32 bits. Both methods must agree.
//
// Beats:
//   1. Start from all-ones and mix each byte through eight polynomial steps.
//   2. Build the 256-entry table from the same polynomial.
//   3. Table-walk the buffer and final-xor all-ones.
//   4. Keep the residue in 32 bits.

fn crc_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn crc_poly() -> Int {
    return 3988292384;
}

fn crc_mask() -> Int {
    return 4294967295;
}

fn crc_step(crc: Int, b: Int) -> Int {
    let mut c: Int = crc_xor(crc, b);
    let mut k: Int = 0;
    while k < 8 {
        let bit: Int = c & 1;
        c = c >> 1;
        if bit != 0 {
            c = crc_xor(c, crc_poly());
        }
        c = c & crc_mask();
        k = k + 1;
    }
    return c;
}

pub fn crc32_iso_bits(buf: List[Int]) -> Int {
    let mut crc: Int = crc_mask();
    let n: Int = list_len(buf);
    let mut i: Int = 0;
    while i < n {
        crc = crc_step(crc, list_get(buf, i) & 255);
        i = i + 1;
    }
    return crc_xor(crc, crc_mask());
}

fn crc_table() -> List[Int] {
    let mut t: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let mut c: Int = i;
        let mut k: Int = 0;
        while k < 8 {
            let bit: Int = c & 1;
            c = c >> 1;
            if bit != 0 {
                c = crc_xor(c, crc_poly());
            }
            c = c & crc_mask();
            k = k + 1;
        }
        t = list_push(t, c);
        i = i + 1;
    }
    return t;
}

pub fn crc32_iso_table(buf: List[Int]) -> Int {
    let t: List[Int] = crc_table();
    let mut crc: Int = crc_mask();
    let n: Int = list_len(buf);
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(buf, i) & 255;
        let idx: Int = crc_xor(crc, b) & 255;
        crc = crc_xor(list_get(t, idx), crc >> 8);
        crc = crc & crc_mask();
        i = i + 1;
    }
    return crc_xor(crc, crc_mask());
}

pub fn crc32_iso_checkvec() -> Int { return 3421780262; }

pub fn crc32_iso_stat(a: Int, b: Int) -> Result[Int, String] {
    if a != b {
        return Err("crc32 mismatch");
    }
    return Ok(a);
}
