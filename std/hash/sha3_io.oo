// # SHA-3 I/O and One-Shot Hash
//
// Logline: pad rule, lane load, lowercase hex emit, and k_hash fold over rate-sized blocks.
//
// Setup: Keccak domain byte 6 for SHA-3, 1 for Keccak; rate 136 bytes (SHA3-256 / Keccak-256) or 72 bytes (SHA3-512 / Keccak-512).
//
// Beats:
//   1. k_padb: data byte or domain||10*1 padding.
//   2. k_load8: 8 bytes -> K64 (little-endian lo, then hi).
//   3. k_hexb, k_hex_lane, k_hex_out: lowercase hex emission.
//   4. k_hash: fold over rate-sized blocks, finalize to hex.

import "./sha3_types.oo";
import "./sha3_64.oo";
import "./sha3_state.oo";
import "./sha3_state_set.oo";
import "./sha3_round.oo";

fn k_padb(data: String, n: Int, total: Int, pos: Int, domain: Int) -> Int {
    if pos < n {
        return byte_at(data, pos);
    }
    let mut b: Int = 0;
    if pos == n {
        b = domain;
    }
    if pos == total - 1 {
        b = b | 128;
    }
    return b;
}

fn k_load8(data: String, n: Int, total: Int, pos: Int, domain: Int) -> K64 {
    let b0: Int = k_padb(data, n, total, pos, domain);
    let b1: Int = k_padb(data, n, total, pos + 1, domain);
    let b2: Int = k_padb(data, n, total, pos + 2, domain);
    let b3: Int = k_padb(data, n, total, pos + 3, domain);
    let b4: Int = k_padb(data, n, total, pos + 4, domain);
    let b5: Int = k_padb(data, n, total, pos + 5, domain);
    let b6: Int = k_padb(data, n, total, pos + 6, domain);
    let b7: Int = k_padb(data, n, total, pos + 7, domain);
    let lo: Int = b0 + (b1 << 8) + (b2 << 16) + (b3 << 24);
    let hi: Int = b4 + (b5 << 8) + (b6 << 16) + (b7 << 24);
    return K64 { hi: hi, lo: lo };
}

fn k_hexb(v: Int) -> String {
    let hx: String = "0123456789abcdef";
    let b: Int = v & 255;
    return char_at(hx, (b >> 4) & 15) + char_at(hx, b & 15);
}

fn k_hex_lane(w: K64) -> String {
    return k_hexb(w.lo) + k_hexb(w.lo >> 8) + k_hexb(w.lo >> 16) + k_hexb(w.lo >> 24) + k_hexb(w.hi) + k_hexb(w.hi >> 8) + k_hexb(w.hi >> 16) + k_hexb(w.hi >> 24);
}

fn k_hex_out(s: KSt, nbytes: Int) -> String {
    let nl: Int = nbytes / 8;
    let mut out: String = "";
    let mut i: Int = 0;
    while i < nl {
        out = out + k_hex_lane(k_get(s, i));
        i = i + 1;
    }
    return out;
}

pub fn k_hash(data: String, rate: Int, domain: Int, out_len: Int) -> String {
    let n: Int = data.len();
    let total: Int = ((n / rate) + 1) * rate;
    let mut s: KSt = k_empty();
    let lanes: Int = rate / 8;
    let mut pos: Int = 0;
    while pos < total {
        let mut i: Int = 0;
        while i < lanes {
            let w: K64 = k_load8(data, n, total, pos + i * 8, domain);
            s = k_set(s, i, k_xor64(k_get(s, i), w));
            i = i + 1;
        }
        s = k_f(s);
        pos = pos + rate;
    }
    return k_hex_out(s, out_len);
}
