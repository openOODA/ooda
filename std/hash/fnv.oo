// # FNV-1a 32-bit
//
// Logline: Mix each byte with xor and the FNV prime and return the 32-bit residue.
//
// Setup: Pure Int bitwise ops. No caps. Not a process_exit facade.
//
// Beats:
//   1. Start from the FNV offset basis.
//   2. Xor the next byte and multiply by 16777619.
//   3. Keep 32 bits and return.

fn fnv_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

pub fn fnv1a_32(data: String) -> Int {
    let prime: Int = 16777619;
    let mask: Int = 4294967295;
    let mut h: Int = 2166136261;
    let n: Int = data.len();
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(data, i);
        h = fnv_xor(h, b);
        h = h * prime;
        h = h & mask;
        i = i + 1;
    }
    return h;
}
