// # SHA-3 64-bit Lane Helpers
//
// Logline: 32-bit mask, xor/and/not, and 64-bit rotl on K64 hi/lo halves.
//
// Setup: Pure Int 32-bit halves. xor(a,b) = (a|b) - (a&b); rotl 0..63.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//

import "./sha3_types.oo";

fn k_mask(x: Int) -> Int {
    return x & 4294967295;
}

fn k_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn k_xor64(a: K64, b: K64) -> K64 {
    return K64 { hi: k_xor(a.hi, b.hi), lo: k_xor(a.lo, b.lo) };
}

fn k_and64(a: K64, b: K64) -> K64 {
    return K64 { hi: a.hi & b.hi, lo: a.lo & b.lo };
}

fn k_not64(a: K64) -> K64 {
    return K64 { hi: k_xor(a.hi, 4294967295), lo: k_xor(a.lo, 4294967295) };
}

fn k_rotl(a: K64, r: Int) -> K64 {
    let mut xh: Int = a.hi;
    let mut xl: Int = a.lo;
    let mut rr: Int = r;
    if rr >= 32 {
        xh = a.lo;
        xl = a.hi;
        rr = r - 32;
    }
    if rr == 0 {
        return K64 { hi: xh, lo: xl };
    }
    let sh: Int = 32 - rr;
    let nhi: Int = k_mask((xh << rr) | (xl >> sh));
    let nlo: Int = k_mask((xl << rr) | (xh >> sh));
    return K64 { hi: nhi, lo: nlo };
}

fn k_zero() -> K64 {
    return K64 { hi: 0, lo: 0 };
}

pub fn shim_marker_sha3_64() -> K64 {
    let z: K64 = k_zero();
    return z;
}
