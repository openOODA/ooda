// # SHA-256 Forward Leaf
//
// Logline: Forwards a digest to crypto_sha256_internal in the product crypto module.
//
// Setup: Product SHA-256 lives in std/core/crypto.oo (CHS, not FIPS).
//
// Beats:
//   1. Publish one public forward so check sees a body.
//   2. The name is hash_sha256_forward, not a second hash.
//   3. The body returns crypto_sha256_internal of the input.
//
// residual: thin forward; product sha256 is std/core/crypto.oo.

pub fn hash_sha256_forward(data: String) -> String {
    return crypto_sha256_internal(data);
}

