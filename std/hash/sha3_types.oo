// # SHA-3 State Types
//
// Logline: K64 (32-bit hi/lo pair) and KSt (25-lane Keccak-f[1600] state) struct definitions.
//
// Setup: Pure Int 32-bit halves. FIPS 202.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//

type K64 = struct {
    hi: Int,
    lo: Int
};

type KSt = struct {
    a0: K64,
    a1: K64,
    a2: K64,
    a3: K64,
    a4: K64,
    a5: K64,
    a6: K64,
    a7: K64,
    a8: K64,
    a9: K64,
    a10: K64,
    a11: K64,
    a12: K64,
    a13: K64,
    a14: K64,
    a15: K64,
    a16: K64,
    a17: K64,
    a18: K64,
    a19: K64,
    a20: K64,
    a21: K64,
    a22: K64,
    a23: K64,
    a24: K64
};

pub fn shim_marker_sha3_types() -> K64 {
    return K64 { hi: 0, lo: 0 };
}
