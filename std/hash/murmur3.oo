// # MurmurHash3 x86 32-bit
//
// Logline: Mix 4-byte blocks and a tail with the SMHasher 32-bit finalizer.
//
// Setup: Pure Int bitwise ops. One-shot seed 0. No caps.
//
// Beats:
//   1. Mix whole 4-byte little-endian blocks.
//   2. Mix the 1..3 byte tail.
//   3. Finalizer xor length and the two avalanche multiplies.

fn mh_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

fn mh_rotl(x: Int, r: Int) -> Int {
    let mask: Int = 4294967295;
    let v: Int = x & mask;
    let left: Int = (v << r) & mask;
    let right: Int = v >> (32 - r);
    return (left | right) & mask;
}

fn mh_block(data: String, off: Int) -> Int {
    let b0: Int = byte_at(data, off);
    let b1: Int = byte_at(data, off + 1);
    let b2: Int = byte_at(data, off + 2);
    let b3: Int = byte_at(data, off + 3);
    return b0 + (b1 << 8) + (b2 << 16) + (b3 << 24);
}

pub fn murmur3_32(data: String) -> Int {
    let mask: Int = 4294967295;
    let c1: Int = 3432918353;
    let c2: Int = 461845907;
    let mut h: Int = 0;
    let n: Int = data.len();
    let nblocks: Int = n / 4;
    let mut i: Int = 0;
    while i < nblocks {
        let mut k: Int = mh_block(data, i * 4);
        k = (k * c1) & mask;
        k = mh_rotl(k, 15);
        k = (k * c2) & mask;
        h = mh_xor(h, k);
        h = mh_rotl(h, 13);
        h = (h * 5 + 3864292196) & mask;
        i = i + 1;
    }
    let tail: Int = nblocks * 4;
    let rem: Int = n - tail;
    let mut kt: Int = 0;
    if rem >= 3 {
        kt = mh_xor(kt, byte_at(data, tail + 2) << 16);
    }
    if rem >= 2 {
        kt = mh_xor(kt, byte_at(data, tail + 1) << 8);
    }
    if rem >= 1 {
        kt = mh_xor(kt, byte_at(data, tail));
        kt = (kt * c1) & mask;
        kt = mh_rotl(kt, 15);
        kt = (kt * c2) & mask;
        h = mh_xor(h, kt);
    }
    h = mh_xor(h, n);
    h = mh_xor(h, h >> 16);
    h = (h * 2246822507) & mask;
    h = mh_xor(h, h >> 13);
    h = (h * 3266489909) & mask;
    h = mh_xor(h, h >> 16);
    return h;
}
