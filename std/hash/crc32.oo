// # IEEE CRC-32
//
// Logline: Compute the ISO-HDLC CRC-32 of a byte string and return the 32-bit residue.
//
// Setup: Pure Int bitwise ops. No caps. Not a table stub and not process_exit.
//
// Beats:
//   1. Start from all-ones, mix each byte through eight poly steps.
//   2. Keep the residue in 32 bits.
//   3. Final-xor all-ones and return the Int.

fn crc32_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

pub fn crc32(data: String) -> Int {
    let poly: Int = 3988292384;
    let mask: Int = 4294967295;
    let mut crc: Int = mask;
    let n: Int = data.len();
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(data, i);
        crc = crc32_xor(crc, b);
        let mut k: Int = 0;
        while k < 8 {
            let bit: Int = crc & 1;
            crc = crc >> 1;
            if bit != 0 {
                crc = crc32_xor(crc, poly);
            }
            k = k + 1;
        }
        crc = crc & mask;
        i = i + 1;
    }
    return crc32_xor(crc, mask);
}
