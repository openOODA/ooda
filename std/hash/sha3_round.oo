// # SHA-3 Keccak-f[1600] Round
//
// Logline: 24-round theta / rho / pi / chi / iota permutation on a 25-lane KSt.
//
// Setup: Keccak-f[1600] FIPS 202. Round constants via k_rc; lane rotations via k_rotl.
//
// Beats:
//   1. k_rc: 24 round constants.
//   2. k_theta: column parity, broadcast D, xor into each lane.
//   3. k_rhopi: 24 fixed rotations, lane permutation.
//   4. k_chi_row: per-row chi step (a xor (~b & c)).
//   5. k_chi: apply chi_row to all 5 rows, repack.
//   6. k_f: 24 rounds = theta, rhopi, chi, iota(rc).

import "./sha3_types.oo";
import "./sha3_64.oo";
import "./sha3_state.oo";
import "./sha3_state_set.oo";

fn k_rc(i: Int) -> K64 {
    if i == 0 { return K64 { hi: 0, lo: 1 }; }
    if i == 1 { return K64 { hi: 0, lo: 32898 }; }
    if i == 2 { return K64 { hi: 2147483648, lo: 32906 }; }
    if i == 3 { return K64 { hi: 2147483648, lo: 2147516416 }; }
    if i == 4 { return K64 { hi: 0, lo: 32907 }; }
    if i == 5 { return K64 { hi: 0, lo: 2147483649 }; }
    if i == 6 { return K64 { hi: 2147483648, lo: 2147516545 }; }
    if i == 7 { return K64 { hi: 2147483648, lo: 32777 }; }
    if i == 8 { return K64 { hi: 0, lo: 138 }; }
    if i == 9 { return K64 { hi: 0, lo: 136 }; }
    if i == 10 { return K64 { hi: 0, lo: 2147516425 }; }
    if i == 11 { return K64 { hi: 0, lo: 2147483658 }; }
    if i == 12 { return K64 { hi: 0, lo: 2147516555 }; }
    if i == 13 { return K64 { hi: 2147483648, lo: 139 }; }
    if i == 14 { return K64 { hi: 2147483648, lo: 32905 }; }
    if i == 15 { return K64 { hi: 2147483648, lo: 32771 }; }
    if i == 16 { return K64 { hi: 2147483648, lo: 32770 }; }
    if i == 17 { return K64 { hi: 2147483648, lo: 128 }; }
    if i == 18 { return K64 { hi: 0, lo: 32778 }; }
    if i == 19 { return K64 { hi: 2147483648, lo: 2147483658 }; }
    if i == 20 { return K64 { hi: 2147483648, lo: 2147516545 }; }
    if i == 21 { return K64 { hi: 2147483648, lo: 32896 }; }
    if i == 22 { return K64 { hi: 0, lo: 2147483649 }; }
    return K64 { hi: 2147483648, lo: 2147516424 };
}

fn k_theta(s: KSt) -> KSt {
    let c0: K64 = k_xor64(k_xor64(k_xor64(k_xor64(s.a0, s.a5), s.a10), s.a15), s.a20);
    let c1: K64 = k_xor64(k_xor64(k_xor64(k_xor64(s.a1, s.a6), s.a11), s.a16), s.a21);
    let c2: K64 = k_xor64(k_xor64(k_xor64(k_xor64(s.a2, s.a7), s.a12), s.a17), s.a22);
    let c3: K64 = k_xor64(k_xor64(k_xor64(k_xor64(s.a3, s.a8), s.a13), s.a18), s.a23);
    let c4: K64 = k_xor64(k_xor64(k_xor64(k_xor64(s.a4, s.a9), s.a14), s.a19), s.a24);
    let d0: K64 = k_xor64(c4, k_rotl(c1, 1));
    let d1: K64 = k_xor64(c0, k_rotl(c2, 1));
    let d2: K64 = k_xor64(c1, k_rotl(c3, 1));
    let d3: K64 = k_xor64(c2, k_rotl(c4, 1));
    let d4: K64 = k_xor64(c3, k_rotl(c0, 1));
    return KSt {
        a0: k_xor64(s.a0, d0), a1: k_xor64(s.a1, d1), a2: k_xor64(s.a2, d2), a3: k_xor64(s.a3, d3), a4: k_xor64(s.a4, d4),
        a5: k_xor64(s.a5, d0), a6: k_xor64(s.a6, d1), a7: k_xor64(s.a7, d2), a8: k_xor64(s.a8, d3), a9: k_xor64(s.a9, d4),
        a10: k_xor64(s.a10, d0), a11: k_xor64(s.a11, d1), a12: k_xor64(s.a12, d2), a13: k_xor64(s.a13, d3), a14: k_xor64(s.a14, d4),
        a15: k_xor64(s.a15, d0), a16: k_xor64(s.a16, d1), a17: k_xor64(s.a17, d2), a18: k_xor64(s.a18, d3), a19: k_xor64(s.a19, d4),
        a20: k_xor64(s.a20, d0), a21: k_xor64(s.a21, d1), a22: k_xor64(s.a22, d2), a23: k_xor64(s.a23, d3), a24: k_xor64(s.a24, d4)
    };
}

fn k_rhopi(s: KSt) -> KSt {
    return KSt {
        a0: k_rotl(s.a0, 0),
        a1: k_rotl(s.a6, 44),
        a2: k_rotl(s.a12, 43),
        a3: k_rotl(s.a18, 21),
        a4: k_rotl(s.a24, 14),
        a5: k_rotl(s.a3, 28),
        a6: k_rotl(s.a9, 20),
        a7: k_rotl(s.a10, 3),
        a8: k_rotl(s.a16, 45),
        a9: k_rotl(s.a22, 61),
        a10: k_rotl(s.a1, 1),
        a11: k_rotl(s.a7, 6),
        a12: k_rotl(s.a13, 25),
        a13: k_rotl(s.a19, 8),
        a14: k_rotl(s.a20, 18),
        a15: k_rotl(s.a4, 27),
        a16: k_rotl(s.a5, 36),
        a17: k_rotl(s.a11, 10),
        a18: k_rotl(s.a17, 15),
        a19: k_rotl(s.a23, 56),
        a20: k_rotl(s.a2, 62),
        a21: k_rotl(s.a8, 55),
        a22: k_rotl(s.a14, 39),
        a23: k_rotl(s.a15, 41),
        a24: k_rotl(s.a21, 2)
    };
}

fn k_chi_row(a: K64, b: K64, c: K64, d: K64, e: K64) -> KSt {
    return KSt {
        a0: k_xor64(a, k_and64(k_not64(b), c)),
        a1: k_xor64(b, k_and64(k_not64(c), d)),
        a2: k_xor64(c, k_and64(k_not64(d), e)),
        a3: k_xor64(d, k_and64(k_not64(e), a)),
        a4: k_xor64(e, k_and64(k_not64(a), b)),
        a5: k_zero(), a6: k_zero(), a7: k_zero(), a8: k_zero(), a9: k_zero(),
        a10: k_zero(), a11: k_zero(), a12: k_zero(), a13: k_zero(), a14: k_zero(),
        a15: k_zero(), a16: k_zero(), a17: k_zero(), a18: k_zero(), a19: k_zero(),
        a20: k_zero(), a21: k_zero(), a22: k_zero(), a23: k_zero(), a24: k_zero()
    };
}

fn k_chi(s: KSt) -> KSt {
    let r0: KSt = k_chi_row(s.a0, s.a1, s.a2, s.a3, s.a4);
    let r1: KSt = k_chi_row(s.a5, s.a6, s.a7, s.a8, s.a9);
    let r2: KSt = k_chi_row(s.a10, s.a11, s.a12, s.a13, s.a14);
    let r3: KSt = k_chi_row(s.a15, s.a16, s.a17, s.a18, s.a19);
    let r4: KSt = k_chi_row(s.a20, s.a21, s.a22, s.a23, s.a24);
    return KSt {
        a0: r0.a0, a1: r0.a1, a2: r0.a2, a3: r0.a3, a4: r0.a4,
        a5: r1.a0, a6: r1.a1, a7: r1.a2, a8: r1.a3, a9: r1.a4,
        a10: r2.a0, a11: r2.a1, a12: r2.a2, a13: r2.a3, a14: r2.a4,
        a15: r3.a0, a16: r3.a1, a17: r3.a2, a18: r3.a3, a19: r3.a4,
        a20: r4.a0, a21: r4.a1, a22: r4.a2, a23: r4.a3, a24: r4.a4
    };
}

fn k_f(s0: KSt) -> KSt {
    let mut s: KSt = s0;
    let mut r: Int = 0;
    while r < 24 {
        s = k_theta(s);
        s = k_rhopi(s);
        s = k_chi(s);
        s = KSt {
            a0: k_xor64(s.a0, k_rc(r)),
            a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4,
            a5: s.a5, a6: s.a6, a7: s.a7, a8: s.a8, a9: s.a9,
            a10: s.a10, a11: s.a11, a12: s.a12, a13: s.a13, a14: s.a14,
            a15: s.a15, a16: s.a16, a17: s.a17, a18: s.a18, a19: s.a19,
            a20: s.a20, a21: s.a21, a22: s.a22, a23: s.a23, a24: s.a24
        };
        r = r + 1;
    }
    return s;
}
