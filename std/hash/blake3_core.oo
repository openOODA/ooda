// # BLAKE3 State Ops & Compression
//
// Logline: Holds the B16 state, bitwise helpers, mix/round/perm schedule, IV constants, and 7-round compress of a 64-byte block.
//
// Setup: Pure Int 32-bit words. Sibling of blake3.oo and blake3_codec.oo.
//
// Beats:
//   1. State container (B16) plus mask/xor/rotr and indexed get/set.
//   2. mix/round/perm schedule.
//   3. IV constants and 7-round compress of a 64-byte block.

type B16 = struct {
    s0: Int,
    s1: Int,
    s2: Int,
    s3: Int,
    s4: Int,
    s5: Int,
    s6: Int,
    s7: Int,
    s8: Int,
    s9: Int,
    s10: Int,
    s11: Int,
    s12: Int,
    s13: Int,
    s14: Int,
    s15: Int
};

pub fn b3_mask(x: Int) -> Int {
    return x & 4294967295;
}

pub fn b3_xor(a: Int, b: Int) -> Int {
    return (a | b) - (a & b);
}

pub fn b3_rotr(x: Int, r: Int) -> Int {
    let v: Int = b3_mask(x);
    let right: Int = v >> r;
    let left: Int = (v << (32 - r)) & 4294967295;
    return (left | right) & 4294967295;
}

pub fn b3_get(s: B16, i: Int) -> Int {
    if i == 0 { return s.s0; }
    if i == 1 { return s.s1; }
    if i == 2 { return s.s2; }
    if i == 3 { return s.s3; }
    if i == 4 { return s.s4; }
    if i == 5 { return s.s5; }
    if i == 6 { return s.s6; }
    if i == 7 { return s.s7; }
    if i == 8 { return s.s8; }
    if i == 9 { return s.s9; }
    if i == 10 { return s.s10; }
    if i == 11 { return s.s11; }
    if i == 12 { return s.s12; }
    if i == 13 { return s.s13; }
    if i == 14 { return s.s14; }
    return s.s15;
}

pub fn b3_set(s: B16, i: Int, v: Int) -> B16 {
    if i == 0 { return B16 { s0: v, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 1 { return B16 { s0: s.s0, s1: v, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 2 { return B16 { s0: s.s0, s1: s.s1, s2: v, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 3 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: v, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 4 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: v, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 5 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: v, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 6 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: v, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 7 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: v, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 8 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: v, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 9 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: v, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 10 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: v, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 11 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: v, s12: s.s12, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 12 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: v, s13: s.s13, s14: s.s14, s15: s.s15 }; }
    if i == 13 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: v, s14: s.s14, s15: s.s15 }; }
    if i == 14 { return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: v, s15: s.s15 }; }
    return B16 { s0: s.s0, s1: s.s1, s2: s.s2, s3: s.s3, s4: s.s4, s5: s.s5, s6: s.s6, s7: s.s7, s8: s.s8, s9: s.s9, s10: s.s10, s11: s.s11, s12: s.s12, s13: s.s13, s14: s.s14, s15: v };
}

pub fn b3_mix(s: B16, a: Int, b: Int, c: Int, d: Int, mx: Int, my: Int) -> B16 {
    let mut va: Int = b3_get(s, a);
    let mut vb: Int = b3_get(s, b);
    let mut vc: Int = b3_get(s, c);
    let mut vd: Int = b3_get(s, d);
    va = b3_mask(va + vb + mx);
    vd = b3_rotr(b3_xor(vd, va), 16);
    vc = b3_mask(vc + vd);
    vb = b3_rotr(b3_xor(vb, vc), 12);
    va = b3_mask(va + vb + my);
    vd = b3_rotr(b3_xor(vd, va), 8);
    vc = b3_mask(vc + vd);
    vb = b3_rotr(b3_xor(vb, vc), 7);
    let mut t: B16 = b3_set(s, a, va);
    t = b3_set(t, b, vb);
    t = b3_set(t, c, vc);
    t = b3_set(t, d, vd);
    return t;
}

pub fn b3_round(s: B16, m: B16) -> B16 {
    let mut t: B16 = s;
    t = b3_mix(t, 0, 4, 8, 12, m.s0, m.s1);
    t = b3_mix(t, 1, 5, 9, 13, m.s2, m.s3);
    t = b3_mix(t, 2, 6, 10, 14, m.s4, m.s5);
    t = b3_mix(t, 3, 7, 11, 15, m.s6, m.s7);
    t = b3_mix(t, 0, 5, 10, 15, m.s8, m.s9);
    t = b3_mix(t, 1, 6, 11, 12, m.s10, m.s11);
    t = b3_mix(t, 2, 7, 8, 13, m.s12, m.s13);
    t = b3_mix(t, 3, 4, 9, 14, m.s14, m.s15);
    return t;
}

pub fn b3_perm(m: B16) -> B16 {
    return B16 {
        s0: m.s2,
        s1: m.s6,
        s2: m.s3,
        s3: m.s10,
        s4: m.s7,
        s5: m.s0,
        s6: m.s4,
        s7: m.s13,
        s8: m.s1,
        s9: m.s11,
        s10: m.s12,
        s11: m.s5,
        s12: m.s9,
        s13: m.s14,
        s14: m.s15,
        s15: m.s8
    };
}

pub fn b3_iv() -> B16 {
    return B16 {
        s0: 1779033703,
        s1: 3144134277,
        s2: 1013904242,
        s3: 2773480762,
        s4: 1359893119,
        s5: 2600822924,
        s6: 528734635,
        s7: 1541459225,
        s8: 0,
        s9: 0,
        s10: 0,
        s11: 0,
        s12: 0,
        s13: 0,
        s14: 0,
        s15: 0
    };
}

pub fn b3_compress(cv: B16, m: B16, clo: Int, chi: Int, block_len: Int, flags: Int) -> B16 {
    let mut s: B16 = B16 {
        s0: cv.s0,
        s1: cv.s1,
        s2: cv.s2,
        s3: cv.s3,
        s4: cv.s4,
        s5: cv.s5,
        s6: cv.s6,
        s7: cv.s7,
        s8: 1779033703,
        s9: 3144134277,
        s10: 1013904242,
        s11: 2773480762,
        s12: clo,
        s13: chi,
        s14: block_len,
        s15: flags
    };
    let mut msg: B16 = m;
    let mut r: Int = 0;
    while r < 7 {
        s = b3_round(s, msg);
        msg = b3_perm(msg);
        r = r + 1;
    }
    return B16 {
        s0: b3_xor(s.s0, s.s8),
        s1: b3_xor(s.s1, s.s9),
        s2: b3_xor(s.s2, s.s10),
        s3: b3_xor(s.s3, s.s11),
        s4: b3_xor(s.s4, s.s12),
        s5: b3_xor(s.s5, s.s13),
        s6: b3_xor(s.s6, s.s14),
        s7: b3_xor(s.s7, s.s15),
        s8: 0,
        s9: 0,
        s10: 0,
        s11: 0,
        s12: 0,
        s13: 0,
        s14: 0,
        s15: 0
    };
}
