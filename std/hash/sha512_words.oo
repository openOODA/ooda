// # SHA-512 Word and State Types
//
// Logline: Sha64 (hi/lo 32-bit halves) and ShaSt (8-word 512-bit state) for FIPS 180-4 compression.
//
// Setup: Pure Int 32-bit halves (add/xor/rotr).
//
// Beats:
//   1. Sha64: hi, lo 32-bit halves of a 64-bit value.
//   2. ShaSt: ah..hl eight (hi, lo) pairs holding the 512-bit compression state.

type Sha64 = struct {
    hi: Int,
    lo: Int
};

type ShaSt = struct {
    ah: Int,
    al: Int,
    bh: Int,
    bl: Int,
    ch: Int,
    cl: Int,
    dh: Int,
    dl: Int,
    eh: Int,
    el: Int,
    fh: Int,
    fl: Int,
    gh: Int,
    gl: Int,
    hh: Int,
    hl: Int
};

pub fn sha64_zero() -> Sha64 {
    return Sha64 { hi: 0, lo: 0 };
}

pub fn sha512_words_marker() -> Int {
    return 1;
}
