// # RFC 1950 Adler-32
//
// Logline: Computes Adler-32 with s1 = 1 + sum Di mod 65521 and s2 = sum s1 mod 65521.
//
// Setup: Pure. Input is List[Int] 0..255. Empty input yields 1.
//
// Beats:
//   1. Start s1 at 1 and s2 at 0.
//   2. Add each byte into s1 then s1 into s2, both modulo 65521.
//   3. Pack s2 in the high 16 bits and s1 in the low 16 bits.

pub fn adler32_zlib(buf: List[Int]) -> Int {
    let mut s1: Int = 1;
    let mut s2: Int = 0;
    let n: Int = list_len(buf);
    let mut i: Int = 0;
    while i < n {
        s1 = (s1 + (list_get(buf, i) & 255)) % 65521;
        s2 = (s2 + s1) % 65521;
        i = i + 1;
    }
    return s2 * 65536 + s1;
}

pub fn adler32_zlib_s1(buf: List[Int]) -> Int { return adler32_zlib(buf) % 65536; }

pub fn adler32_zlib_s2(buf: List[Int]) -> Int { return adler32_zlib(buf) / 65536; }

pub fn adler32_zlib_stat(v: Int) -> Result[Int, String] {
    if v < 1 {
        return Err("adler32");
    }
    return Ok(v);
}
