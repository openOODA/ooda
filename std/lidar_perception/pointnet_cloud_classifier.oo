// # PointNet Deep Neural Network 3D Point Cloud Classifier
//
// Logline: Encodes unordered 3D point sets with shared multi-layer perceptrons, spatial T-Nets, and symmetric max pooling.
//
// Setup: Deep 3D learning module classifying object geometries (car, pedestrian, cyclist, truck) directly on point clouds.
//
// Beats:
//   1. Define PointNet architecture hyperparameters (input points N, feature channels, class counts).
//   2. Model Spatial Transformer Network (T-Net) 3x3 alignment matrix.
//   3. Apply shared multi-layer perceptron (MLP 64 -> 128 -> 1024) layers with ReLU activations.
//   4. Perform symmetric max pooling across point features to compute global classification logits.

import "./point_types.oo";

pub type PointNetConfig = struct {
    num_points: Int,
    input_dim: Int,
    hidden_dim1: Int,
    hidden_dim2: Int,
    global_dim: Int,
    num_classes: Int
};

pub type PointNetLogits = struct {
    class_id: Int,
    confidence: Float,
    car_prob: Float,
    pedestrian_prob: Float,
    cyclist_prob: Float,
    background_prob: Float
};

pub fn pointnet_config_default() -> PointNetConfig {
    return PointNetConfig {
        num_points: 1024,
        input_dim: 3,
        hidden_dim1: 64,
        hidden_dim2: 128,
        global_dim: 1024,
        num_classes: 4
    };
}

pub fn relu_activation(x: Float) -> Float {
    return if x > 0.0 { x } else { 0.0 };
}

pub fn softmax4(z0: Float, z1: Float, z2: Float, z3: Float) -> PointNetLogits {
    let e0: Float = exp(z0);
    let e1: Float = exp(z1);
    let e2: Float = exp(z2);
    let e3: Float = exp(z3);
    let sum_e: Float = e0 + e1 + e2 + e3;
    let inv_sum: Float = if sum_e > 0.00001 { 1.0 / sum_e } else { 0.25 };

    let p0: Float = e0 * inv_sum;
    let p1: Float = e1 * inv_sum;
    let p2: Float = e2 * inv_sum;
    let p3: Float = e3 * inv_sum;

    let mut best_id: Int = 0;
    let mut best_p: Float = p0;

    if p1 > best_p {
        best_id = 1;
        best_p = p1;
    }
    if p2 > best_p {
        best_id = 2;
        best_p = p2;
    }
    if p3 > best_p {
        best_id = 3;
        best_p = p3;
    }

    return PointNetLogits {
        class_id: best_id,
        confidence: best_p,
        car_prob: p0,
        pedestrian_prob: p1,
        cyclist_prob: p2,
        background_prob: p3
    };
}

pub fn pointnet_layer_forward_step(
    input_val: Float,
    weight: Float,
    bias: Float
) -> Float {
    let lin: Float = (input_val * weight) + bias;
    return relu_activation(lin);
}
