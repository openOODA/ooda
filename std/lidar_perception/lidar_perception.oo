pub type LidarPerceptionPipeline = struct {
    capabilities: LidarHardwareCapabilities,
    profiling: PerceptionProfilingStats,
    is_active: Bool
};

pub fn lidar_perception_pipeline_new() -> LidarPerceptionPipeline {
    return LidarPerceptionPipeline {
        capabilities: lidar_hardware_capabilities_default(),
        profiling: perception_profiling_stats_new(),
        is_active: false
    };
}

pub fn lidar_perception_start(pipeline: &LidarPerceptionPipeline) -> LidarPerceptionPipeline {
    return LidarPerceptionPipeline {
        capabilities: (pipeline).capabilities,
        profiling: (pipeline).profiling,
        is_active: true
    };
}

pub fn lidar_perception_stop(pipeline: &LidarPerceptionPipeline) -> LidarPerceptionPipeline {
    return LidarPerceptionPipeline {
        capabilities: (pipeline).capabilities,
        profiling: (pipeline).profiling,
        is_active: false
    };
}
