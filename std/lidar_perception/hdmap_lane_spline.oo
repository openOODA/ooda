// # HD Map Cubic Hermite & Clothoid Lane Spline Generator
//
// Logline: Interpolates smooth C2-continuous lane centerlines and boundary curves using piecewise cubic Hermite splines.
//
// Setup: Geometric curve modeling module providing continuous position, heading, and curvature derivatives for HD map paths.
//
// Beats:
//   1. Define Cubic Hermite Spline segment (p0, p1, tangent m0, tangent m1).
//   2. Evaluate cubic Hermite basis functions h00(t), h10(t), h01(t), h11(t) for t in [0, 1].
//   3. Compute interpolated Cartesian point (x(t), y(t)) and tangent heading theta(t).
//   4. Calculate road curve radius R(t) = 1 / kappa(t) for vehicle speed profiling.

import "./point_types.oo";

pub type SplineSegment2D = struct {
    x0: Float, y0: Float,
    x1: Float, y1: Float,
    m0_x: Float, m0_y: Float,
    m1_x: Float, m1_y: Float,
    length_m: Float
};

pub fn spline_segment_new(
    x0: Float, y0: Float,
    x1: Float, y1: Float,
    m0_x: Float, m0_y: Float,
    m1_x: Float, m1_y: Float
) -> SplineSegment2D {
    let dx: Float = x1 - x0;
    let dy: Float = y1 - y0;
    let len: Float = sqrt((dx * dx) + (dy * dy));

    return SplineSegment2D {
        x0: x0, y0: y0,
        x1: x1, y1: y1,
        m0_x: m0_x, m0_y: m0_y,
        m1_x: m1_x, m1_y: m1_y,
        length_m: len
    };
}

pub fn eval_hermite_spline(
    seg: &SplineSegment2D,
    t: Float
) -> Point3D {
    let mut clamped_t: Float = t;
    if clamped_t < 0.0 { clamped_t = 0.0; }
    if clamped_t > 1.0 { clamped_t = 1.0; }

    let t2: Float = clamped_t * clamped_t;
    let t3: Float = t2 * clamped_t;

    let h00: Float = (2.0 * t3) - (3.0 * t2) + 1.0;
    let h10: Float = t3 - (2.0 * t2) + clamped_t;
    let h01: Float = (0.0 - (2.0 * t3)) + (3.0 * t2);
    let h11: Float = t3 - t2;

    let x: Float = (h00 * (seg).x0) + (h10 * (seg).m0_x) + (h01 * (seg).x1) + (h11 * (seg).m1_x);
    let y: Float = (h00 * (seg).y0) + (h10 * (seg).m0_y) + (h01 * (seg).y1) + (h11 * (seg).m1_y);

    return Point3D { x: x, y: y, z: 0.0 };
}
