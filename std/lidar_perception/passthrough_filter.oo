// # LiDAR Region-of-Interest Passthrough Filter
//
// Logline: Filters 3D point clouds against user-specified Cartesian bounding limits, cylindrical ranges, and elevation thresholds.
//
// Setup: High-throughput range clipping filter removing ego-vehicle self-returns and out-of-bounds environmental points.
//
// Beats:
//   1. Define 3D Cartesian axis-aligned bounding limits (X_min/max, Y_min/max, Z_min/max).
//   2. Configure cylindrical range and azimuth sector gates.
//   3. Implement self-vehicle blind-spot exclusion zones.
//   4. Evaluate multi-criteria point containment and pass/reject predicates.

import "./point_types.oo";

pub type PassthroughLimits = struct {
    min_x: Float,
    max_x: Float,
    min_y: Float,
    max_y: Float,
    min_z: Float,
    max_z: Float,
    min_range: Float,
    max_range: Float,
    keep_inside: Bool,
};

pub type BlindSpotBox = struct {
    min_x: Float,
    max_x: Float,
    min_y: Float,
    max_y: Float,
    min_z: Float,
    max_z: Float,
};

pub fn passthrough_limits_default() -> PassthroughLimits {
    return PassthroughLimits {
        min_x: 0.0 - 100.0,
        max_x: 100.0,
        min_y: 0.0 - 50.0,
        max_y: 50.0,
        min_z: 0.0 - 5.0,
        max_z: 15.0,
        min_range: 0.5,
        max_range: 120.0,
        keep_inside: true,
    };
}

pub fn passthrough_limits_highway() -> PassthroughLimits {
    return PassthroughLimits {
        min_x: 0.0 - 30.0,
        max_x: 200.0,
        min_y: 0.0 - 40.0,
        max_y: 40.0,
        min_z: 0.0 - 4.0,
        max_z: 10.0,
        min_range: 1.0,
        max_range: 220.0,
        keep_inside: true,
    };
}

pub fn blind_spot_box_default() -> BlindSpotBox {
    // Exclude ego-vehicle body dimensions (approx 4.8m x 2.2m x 1.8m)
    return BlindSpotBox {
        min_x: 0.0 - 2.5,
        max_x: 2.5,
        min_y: 0.0 - 1.2,
        max_y: 1.2,
        min_z: 0.0 - 1.0,
        max_z: 1.0,
    };
}

pub fn is_point_in_blind_spot(p: &Point3D, b: &BlindSpotBox) -> Bool {
    let in_x: Bool = ((p).x >= (b).min_x) && ((p).x <= (b).max_x);
    let in_y: Bool = ((p).y >= (b).min_y) && ((p).y <= (b).max_y);
    let in_z: Bool = ((p).z >= (b).min_z) && ((p).z <= (b).max_z);
    return in_x && in_y && in_z;
}

pub fn passthrough_filter_eval(p: &Point3D, lim: &PassthroughLimits, blind: &BlindSpotBox) -> Bool {
    if is_point_in_blind_spot(p, blind) {
        return false;
    }

    let r_sq: Float = ((p).x * (p).x) + ((p).y * (p).y) + ((p).z * (p).z);
    let min_r_sq: Float = (lim).min_range * (lim).min_range;
    let max_r_sq: Float = (lim).max_range * (lim).max_range;

    if (r_sq < min_r_sq) || (r_sq > max_r_sq) {
        return false;
    }

    let in_box: Bool = ((p).x >= (lim).min_x) && ((p).x <= (lim).max_x) &&
                       ((p).y >= (lim).min_y) && ((p).y <= (lim).max_y) &&
                       ((p).z >= (lim).min_z) && ((p).z <= (lim).max_z);

    if (lim).keep_inside {
        return in_box;
    }
    return !in_box;
}

pub fn passthrough_filter_xyzi(p: &PointXYZI, lim: &PassthroughLimits, blind: &BlindSpotBox) -> Bool {
    let pt: Point3D = Point3D { x: (p).x, y: (p).y, z: (p).z };
    return passthrough_filter_eval(&pt, lim, blind);
}
