// # Joint Probabilistic Data Association (JPDA) 3D Multi-Target Filter
//
// Logline: Resolves ambiguous multi-target tracking in dense traffic clusters by computing probabilistic association weights.
//
// Setup: Soft-assignment tracking module evaluating marginal target-to-measurement association probabilities.
//
// Beats:
//   1. Model spatial validation gates using Gaussian likelihood functions.
//   2. Formulate joint association events across clustered targets and detections.
//   3. Compute normalized association probabilities beta_ij for each target-measurement pair.
//   4. Generate weighted combined innovation updates for Kalman filter correction.

import "./point_types.oo";

pub type JPDATargetWeights = struct {
    target_id: Int,
    beta_0: Float, // Probability of no detection (missed detection)
    beta_1: Float, // Association prob with detection 1
    beta_2: Float // Association prob with detection 2
};

pub fn gaussian_likelihood_2d(
    dx: Float, dy: Float,
    sigma_x: Float, sigma_y: Float
) -> Float {
    let var_x: Float = if sigma_x > 0.01 { sigma_x * sigma_x } else { 0.0001 };
    let var_y: Float = if sigma_y > 0.01 { sigma_y * sigma_y } else { 0.0001 };

    let exp_term: Float = 0.0 - (0.5 * (((dx * dx) / var_x) + ((dy * dy) / var_y)));
    let norm: Float = 1.0 / (2.0 * math_pi() * sigma_x * sigma_y);

    return norm * exp(exp_term);
}

pub fn normalize_jpda_weights(
    p_miss: Float,
    p_det1: Float,
    p_det2: Float
) -> JPDATargetWeights {
    let sum_p: Float = p_miss + p_det1 + p_det2;
    let inv_sum: Float = if sum_p > 0.00001 { 1.0 / sum_p } else { 0.33333 };

    return JPDATargetWeights {
        target_id: 1,
        beta_0: p_miss * inv_sum,
        beta_1: p_det1 * inv_sum,
        beta_2: p_det2 * inv_sum
    };
}

pub fn jpda_combined_innovation(
    beta_1: Float, res1_x: Float, res1_y: Float,
    beta_2: Float, res2_x: Float, res2_y: Float
) -> Point3D {
    let comb_x: Float = (beta_1 * res1_x) + (beta_2 * res2_x);
    let comb_y: Float = (beta_1 * res1_y) + (beta_2 * res2_y);
    return Point3D { x: comb_x, y: comb_y, z: 0.0 };
}
