// # LiDAR 6-DoF Extrinsic Calibration & Sensor Transform
//
// Logline: Applies rigid SE(3) transformation matrices between LiDAR sensor, vehicle base_link, and global map coordinate frames.
//
// Setup: Spatial calibration module parameterizing 3D translation offsets and Roll-Pitch-Yaw / quaternion rotations.
//
// Beats:
//   1. Represent 6-DoF extrinsic pose (tx, ty, tz, roll, pitch, yaw).
//   2. Construct 3x3 SO(3) direction cosine rotation matrices from Euler angles.
//   3. Transform 3D point coordinates from LiDAR frame to base_link / IMU frame.
//   4. Compute inverse transformations for map-to-sensor point cloud reprojection.

import "./point_types.oo";

pub type Transform6D = struct {
    tx: Float,
    ty: Float,
    tz: Float,
    roll_rad: Float,
    pitch_rad: Float,
    yaw_rad: Float,
};

pub type Matrix3x3 = struct {
    r00: Float, r01: Float, r02: Float,
    r10: Float, r11: Float, r12: Float,
    r20: Float, r21: Float, r22: Float,
};

pub fn transform6d_identity() -> Transform6D {
    return Transform6D {
        tx: 0.0, ty: 0.0, tz: 0.0,
        roll_rad: 0.0, pitch_rad: 0.0, yaw_rad: 0.0,
    };
}

pub fn transform6d_new(
    tx: Float, ty: Float, tz: Float,
    roll: Float, pitch: Float, yaw: Float
) -> Transform6D {
    return Transform6D {
        tx: tx, ty: ty, tz: tz,
        roll_rad: roll, pitch_rad: pitch, yaw_rad: yaw,
    };
}

pub fn matrix3x3_from_rpy(roll: Float, pitch: Float, yaw: Float) -> Matrix3x3 {
    let cr: Float = cos(roll);
    let sr: Float = sin(roll);
    let cp: Float = cos(pitch);
    let sp: Float = sin(pitch);
    let cy: Float = cos(yaw);
    let sy: Float = sin(yaw);

    return Matrix3x3 {
        r00: cy * cp,
        r01: (cy * sp * sr) - (sy * cr),
        r02: (cy * sp * cr) + (sy * sr),
        r10: sy * cp,
        r11: (sy * sp * sr) + (cy * cr),
        r12: (sy * sp * cr) - (cy * sr),
        r20: 0.0 - sp,
        r21: cp * sr,
        r22: cp * cr,
    };
}

pub fn matrix3x3_transpose(m: &Matrix3x3) -> Matrix3x3 {
    return Matrix3x3 {
        r00: (m).r00, r01: (m).r10, r02: (m).r20,
        r10: (m).r01, r11: (m).r11, r12: (m).r21,
        r20: (m).r02, r21: (m).r12, r22: (m).r22,
    };
}

pub fn transform_point3d(p: &Point3D, tf: &Transform6D) -> Point3D {
    let r: Matrix3x3 = matrix3x3_from_rpy((tf).roll_rad, (tf).pitch_rad, (tf).yaw_rad);
    let rx: Float = (r.r00 * (p).x) + (r.r01 * (p).y) + (r.r02 * (p).z);
    let ry: Float = (r.r10 * (p).x) + (r.r11 * (p).y) + (r.r12 * (p).z);
    let rz: Float = (r.r20 * (p).x) + (r.r21 * (p).y) + (r.r22 * (p).z);

    return Point3D {
        x: rx + (tf).tx,
        y: ry + (tf).ty,
        z: rz + (tf).tz,
    };
}

pub fn transform_point_xyzi(p: &PointXYZI, tf: &Transform6D) -> PointXYZI {
    let pt: Point3D = Point3D { x: (p).x, y: (p).y, z: (p).z };
    let tf_pt: Point3D = transform_point3d(&pt, tf);
    return PointXYZI {
        x: tf_pt.x,
        y: tf_pt.y,
        z: tf_pt.z,
        intensity: (p).intensity,
    };
}

pub fn inverse_transform_point3d(p: &Point3D, tf: &Transform6D) -> Point3D {
    let dx: Float = (p).x - (tf).tx;
    let dy: Float = (p).y - (tf).ty;
    let dz: Float = (p).z - (tf).tz;

    let r: Matrix3x3 = matrix3x3_from_rpy((tf).roll_rad, (tf).pitch_rad, (tf).yaw_rad);
    let r_inv: Matrix3x3 = matrix3x3_transpose(&r);

    let ix: Float = (r_inv.r00 * dx) + (r_inv.r01 * dy) + (r_inv.r02 * dz);
    let iy: Float = (r_inv.r10 * dx) + (r_inv.r11 * dy) + (r_inv.r12 * dz);
    let iz: Float = (r_inv.r20 * dx) + (r_inv.r21 * dy) + (r_inv.r22 * dz);

    return Point3D { x: ix, y: iy, z: iz };
}
