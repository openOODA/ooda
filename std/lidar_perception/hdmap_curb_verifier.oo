// # 3D Road Curb Detection & HD Map Boundary Verifier
//
// Logline: Extracts 3D curb step height disparities and normal variances to verify and correct HD map boundary alignments.
//
// Setup: Map verification and roadway boundary detection module extracting physical curb edges for centimeter localization.
//
// Beats:
//   1. Configure curb step height detection thresholds (min 0.05m, max 0.30m).
//   2. Analyze vertical point gradient across lateral scan beam profiles.
//   3. Extract continuous 3D curb line polylines.
//   4. Calculate lateral displacement error between detected curbs and HD map lane boundary vectors.

import "./point_types.oo";
import "./hdmap_lanelet2_parser.oo";

pub type CurbDetectorConfig = struct {
    min_step_height_m: Float,
    max_step_height_m: Float,
    lateral_search_radius_m: Float,
};

pub type CurbPoint3D = struct {
    x: Float,
    y: Float,
    z: Float,
    step_height: Float,
    confidence: Float,
};

pub fn curb_detector_config_default() -> CurbDetectorConfig {
    return CurbDetectorConfig {
        min_step_height_m: 0.06,
        max_step_height_m: 0.28,
        lateral_search_radius_m: 1.5,
    };
}

pub fn eval_curb_step_candidate(
    z_road: Float,
    z_sidewalk: Float,
    cfg: &CurbDetectorConfig
) -> Bool {
    let dz: Float = z_sidewalk - z_road;
    return (dz >= (cfg).min_step_height_m) && (dz <= (cfg).max_step_height_m);
}

pub fn calc_curb_map_disparity(
    curb: &CurbPoint3D,
    map_p: &MapPoint3D
) -> Float {
    let dx: Float = (curb).x - (map_p).x;
    let dy: Float = (curb).y - (map_p).y;
    return sqrt((dx * dx) + (dy * dy));
}
