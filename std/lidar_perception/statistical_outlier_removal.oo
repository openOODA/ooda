// # LiDAR Statistical Outlier Removal (SOR) Filter
//
// Logline: Trims airborne dust, fog, retro-reflector blooming, and sparse noise returns using k-NN Gaussian distance statistics.
//
// Setup: Statistical filtering module computing mean neighbor distances and global standard deviation thresholds.
//
// Beats:
//   1. Configure k-nearest neighbors and standard deviation multiplier threshold.
//   2. Model point distance distribution statistics (mean, variance, standard deviation).
//   3. Compute global outlier distance rejection cutoff = mean + (std_mul * std_dev).
//   4. Classify individual returns as inliers or noise outliers.

import "./point_types.oo";

pub type SORConfig = struct {
    mean_k: Int,
    std_mul: Float,
    negative: Bool
};

pub type PointNeighborStats = struct {
    point_idx: Int,
    mean_distance: Float,
    neighbor_count: Int
};

pub type GlobalDistanceDistribution = struct {
    global_mean: Float,
    global_variance: Float,
    global_std_dev: Float,
    rejection_distance: Float,
    total_points: Int
};

pub fn sor_config_new(mean_k: Int, std_mul: Float) -> SORConfig {
    return SORConfig {
        mean_k: mean_k,
        std_mul: std_mul,
        negative: false
    };
}

pub fn sor_config_default() -> SORConfig {
    return SORConfig {
        mean_k: 50,
        std_mul: 1.0,
        negative: false
    };
}

pub fn point_neighbor_stats_new(idx: Int) -> PointNeighborStats {
    return PointNeighborStats {
        point_idx: idx,
        mean_distance: 0.0,
        neighbor_count: 0
    };
}

pub fn point_neighbor_stats_compute(
    idx: Int,
    dist_sum: Float,
    count: Int
) -> PointNeighborStats {
    let mean_d: Float = if count > 0 { dist_sum / (count as Float) } else { 0.0 };
    return PointNeighborStats {
        point_idx: idx,
        mean_distance: mean_d,
        neighbor_count: count
    };
}

pub fn global_distribution_compute(
    mean_dist_sum: Float,
    mean_dist_sq_sum: Float,
    n_points: Int,
    cfg: &SORConfig
) -> GlobalDistanceDistribution {
    if n_points <= 0 {
        return GlobalDistanceDistribution {
            global_mean: 0.0,
            global_variance: 0.0,
            global_std_dev: 0.0,
            rejection_distance: 0.0,
            total_points: 0
        };
    }

    let mu: Float = mean_dist_sum / (n_points as Float);
    let variance: Float = (mean_dist_sq_sum / (n_points as Float)) - (mu * mu);
    let pos_var: Float = if variance > 0.0 { variance } else { 0.0 };
    let sigma: Float = sqrt(pos_var);
    let cutoff: Float = mu + ((cfg).std_mul * sigma);

    return GlobalDistanceDistribution {
        global_mean: mu,
        global_variance: pos_var,
        global_std_dev: sigma,
        rejection_distance: cutoff,
        total_points: n_points
    };
}

pub fn sor_is_inlier(
    stats: &PointNeighborStats,
    distrib: &GlobalDistanceDistribution,
    cfg: &SORConfig
) -> Bool {
    let passed: Bool = (stats).mean_distance <= (distrib).rejection_distance;
    if (cfg).negative {
        return !passed;
    }
    return passed;
}
