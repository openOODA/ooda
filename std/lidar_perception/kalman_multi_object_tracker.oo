// # 3D Multi-Object Tracking (MOT) Constant Velocity Kalman Filter
//
// Logline: Tracks obstacle 3D position, velocity, and orientation over time using state covariance propagation and measurement updates.
//
// Setup: Core temporal tracking module estimating smooth obstacle trajectories and velocities for motion planning.
//
// Beats:
//   1. Represent 8-dimensional state vector (x, y, z, vx, vy, vz, heading, yaw_rate).
//   2. Propagate state estimates forward in time using constant velocity motion model (F matrix).
//   3. Predict error covariance matrix P_pred = F * P * F^T + Q.
//   4. Incorporate new 3D detections via Kalman gain K and measurement residual (z - H * x).

import "./point_types.oo";

pub type KalmanState8D = struct {
    x: Float,
    y: Float,
    z: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    heading_rad: Float,
    yaw_rate: Float,
};

pub type KalmanFilterConfig = struct {
    process_noise_pos: Float,
    process_noise_vel: Float,
    measurement_noise_pos: Float,
};

pub fn kalman_state_new(
    x: Float, y: Float, z: Float,
    heading: Float
) -> KalmanState8D {
    return KalmanState8D {
        x: x, y: y, z: z,
        vx: 0.0, vy: 0.0, vz: 0.0,
        heading_rad: heading,
        yaw_rate: 0.0,
    };
}

pub fn kalman_predict_constant_velocity(
    state: &KalmanState8D,
    dt_sec: Float
) -> KalmanState8D {
    return KalmanState8D {
        x: (state).x + ((state).vx * dt_sec),
        y: (state).y + ((state).vy * dt_sec),
        z: (state).z + ((state).vz * dt_sec),
        vx: (state).vx,
        vy: (state).vy,
        vz: (state).vz,
        heading_rad: (state).heading_rad + ((state).yaw_rate * dt_sec),
        yaw_rate: (state).yaw_rate,
    };
}

pub fn kalman_update_position(
    pred_state: &KalmanState8D,
    meas_x: Float,
    meas_y: Float,
    meas_z: Float,
    meas_heading: Float,
    kalman_gain_pos: Float,
    kalman_gain_vel: Float
) -> KalmanState8D {
    let res_x: Float = meas_x - (pred_state).x;
    let res_y: Float = meas_y - (pred_state).y;
    let res_z: Float = meas_z - (pred_state).z;

    // Angle difference normalization
    let mut res_h: Float = meas_heading - (pred_state).heading_rad;
    let pi_val: Float = math_pi();
    while res_h > pi_val { res_h = res_h - (2.0 * pi_val); }
    while res_h < (0.0 - pi_val) { res_h = res_h + (2.0 * pi_val); }

    let new_x: Float = (pred_state).x + (kalman_gain_pos * res_x);
    let new_y: Float = (pred_state).y + (kalman_gain_pos * res_y);
    let new_z: Float = (pred_state).z + (kalman_gain_pos * res_z);

    let new_vx: Float = (pred_state).vx + (kalman_gain_vel * res_x);
    let new_vy: Float = (pred_state).vy + (kalman_gain_vel * res_y);
    let new_vz: Float = (pred_state).vz + (kalman_gain_vel * res_z);

    let new_h: Float = (pred_state).heading_rad + (kalman_gain_pos * res_h);

    return KalmanState8D {
        x: new_x,
        y: new_y,
        z: new_z,
        vx: new_vx,
        vy: new_vy,
        vz: new_vz,
        heading_rad: new_h,
        yaw_rate: (pred_state).yaw_rate,
    };
}
