// # LOAM Geometric Feature Extractor (Edge & Planar Points)
//
// Logline: Evaluates local point smoothness curvature to extract sharp edge features and flat planar features for LOAM odometry.
//
// Setup: Feature extraction engine powering low-drift real-time LiDAR Odometry and Mapping (LOAM/A-LOAM/LIO-SAM).
//
// Beats:
//   1. Calculate point roughness/curvature c = ||sum(p_i - p_j)|| / (2m * ||p_i||) along laser rings.
//   2. Configure curvature thresholds separating sharp edge lines and smooth planar patches.
//   3. Extract high-curvature edge points (less-flat) from building corners and poles.
//   4. Extract low-curvature planar points (flat surface) from road beds and building facades.

import "./point_types.oo";

pub type LOAMFeatureConfig = struct {
    edge_threshold: Float,
    surf_threshold: Float,
    neighbor_window: Int,
};

pub type FeaturePointType = struct {
    point: PointXYZI,
    curvature: Float,
    is_edge: Bool,
    is_plane: Bool,
};

pub fn loam_feature_config_default() -> LOAMFeatureConfig {
    return LOAMFeatureConfig {
        edge_threshold: 0.1,
        surf_threshold: 0.05,
        neighbor_window: 5,
    };
}

pub fn loam_compute_curvature(
    center_p: &Point3D,
    diff_sum_x: Float,
    diff_sum_y: Float,
    diff_sum_z: Float,
    total_neighbors: Int
) -> Float {
    let range: Float = point3d_range(center_p);
    if range < 0.1 {
        return 0.0;
    }

    let sum_sq: Float = (diff_sum_x * diff_sum_x) + (diff_sum_y * diff_sum_y) + (diff_sum_z * diff_sum_z);
    let diff_norm: Float = sqrt(sum_sq);
    let denom: Float = (total_neighbors as Float) * range;

    return diff_norm / (if denom > 0.0001 { denom } else { 0.0001 });
}

pub fn loam_classify_feature(
    pt: &PointXYZI,
    curvature: Float,
    cfg: &LOAMFeatureConfig
) -> FeaturePointType {
    let is_edge: Bool = curvature > (cfg).edge_threshold;
    let is_plane: Bool = curvature < (cfg).surf_threshold;

    return FeaturePointType {
        point: *pt,
        curvature: curvature,
        is_edge: is_edge,
        is_plane: is_plane,
    };
}
