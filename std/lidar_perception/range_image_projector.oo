// # LiDAR Spherical Range Image Projector
//
// Logline: Projects unorganized 3D point clouds into organized 2D spherical range images indexed by laser beam ring and azimuth.
//
// Setup: Image-based projection engine enabling fast neighborhood indexing, range gradients, and 2D convolution frontends.
//
// Beats:
//   1. Configure spherical image grid resolution (rows/beams, columns/azimuth resolution).
//   2. Convert 3D Cartesian coordinates (x, y, z) into azimuth and elevation angles.
//   3. Map angular coordinates to integer pixel coordinates (row, col).
//   4. Store range depth, intensity, and validity mask per pixel element.

import "./point_types.oo";

pub type RangeImageConfig = struct {
    num_rings: Int,
    num_columns: Int,
    fov_up_rad: Float,
    fov_down_rad: Float,
};

pub type RangePixel = struct {
    range_m: Float,
    intensity: Float,
    is_valid: Bool,
};

pub type PixelCoordinate = struct {
    row: Int,
    col: Int,
};

pub fn range_image_config_default_64beam() -> RangeImageConfig {
    return RangeImageConfig {
        num_rings: 64,
        num_columns: 2048,
        fov_up_rad: 3.0 * (math_pi() / 180.0),      // +3 deg
        fov_down_rad: 0.0 - (25.0 * (math_pi() / 180.0)), // -25 deg
    };
}

pub fn range_image_config_default_128beam() -> RangeImageConfig {
    return RangeImageConfig {
        num_rings: 128,
        num_columns: 2048,
        fov_up_rad: 15.0 * (math_pi() / 180.0),
        fov_down_rad: 0.0 - (25.0 * (math_pi() / 180.0)),
    };
}

pub fn project_point_to_pixel(
    p: &Point3D,
    cfg: &RangeImageConfig
) -> PixelCoordinate {
    let r_xy: Float = point3d_horizontal_range(p);
    let range: Float = point3d_range(p);

    if range < 0.001 {
        return PixelCoordinate { row: 0 - 1, col: 0 - 1 };
    }

    // Azimuth in [-pi, pi] -> col in [0, num_columns - 1]
    let yaw: Float = point3d_azimuth_rad(p);
    let pi_val: Float = math_pi();
    let norm_yaw: Float = (yaw + pi_val) / (2.0 * pi_val); // [0.0, 1.0]
    let mut col: Int = (norm_yaw * ((cfg).num_columns as Float)) as Int;
    if col < 0 { col = 0; }
    if col >= (cfg).num_columns { col = (cfg).num_columns - 1; }

    // Elevation in [fov_down, fov_up] -> row in [0, num_rings - 1]
    let pitch: Float = point3d_elevation_rad(p);
    let total_fov: Float = (cfg).fov_up_rad - (cfg).fov_down_rad;
    let norm_pitch: Float = ((cfg).fov_up_rad - pitch) / total_fov;
    let mut row: Int = (norm_pitch * ((cfg).num_rings as Float)) as Int;
    if row < 0 { row = 0; }
    if row >= (cfg).num_rings { row = (cfg).num_rings - 1; }

    return PixelCoordinate { row: row, col: col };
}

pub fn pixel_coordinate_to_flat_index(
    coord: &PixelCoordinate,
    num_columns: Int
) -> Int {
    if ((coord).row < 0) || ((coord).col < 0) {
        return 0 - 1;
    }
    return ((coord).row * num_columns) + (coord).col;
}
