// # LiDAR point types
//
// Logline: LidarPoint destubbed off nested cloud lists.
// residual: List[struct] destubbed.

type LidarPoint = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn lidar_point_new(x: Int, y: Int, z: Int) -> LidarPoint {
    return LidarPoint { x: x, y: y, z: z };
}

pub fn lidar_point_x(p: LidarPoint) -> Int {
    return p.x;
}

pub type Point3D = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub type PointXYZI = struct {
    x: Float,
    y: Float,
    z: Float,
    intensity: Float,
};

pub fn point3d_new(x: Float, y: Float, z: Float) -> Point3D {
    return Point3D { x: x, y: y, z: z };
}

pub fn point3d_range(p: &Point3D) -> Float {
    return sqrt(((p).x * (p).x) + ((p).y * (p).y) + ((p).z * (p).z));
}

pub fn math_pi() -> Float {
    return 3.141592653589793;
}

pub fn math_abs(val: Float) -> Float {
    if val < 0.0 {
        return 0.0 - val;
    }
    return val;
}
