// # LiDAR point types
//
// Logline: LidarPoint destubbed off nested cloud lists.
// residual: List[struct] destubbed.

type LidarPoint = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn lidar_point_new(x: Int, y: Int, z: Int) -> LidarPoint {
    return LidarPoint { x: x, y: y, z: z };
}

pub fn lidar_point_x(p: LidarPoint) -> Int {
    return p.x;
}
