// # CenterPoint Anchor-Free 3D Heatmap Detector
//
// Logline: Detects 3D bounding boxes by identifying object centers on keypoint heatmaps and regressing continuous sub-voxel properties.
//
// Setup: Anchor-free 3D detector head eliminating complex discrete anchors and hand-crafted rotational bins.
//
// Beats:
//   1. Model center heatmap confidence peaks and local non-maximum suppression (NMS).
//   2. Regress sub-pixel center coordinate offsets (delta_x, delta_y).
//   3. Predict 3D dimensions (log l, log w, log h), elevation z, and continuous heading (sin yaw, cos yaw).
//   4. Decode 2D heatmap peak activations into full 3D oriented bounding boxes.

import "./point_types.oo";

pub type CenterPointHeadOutput = struct {
    heatmap_score: Float,
    grid_x: Int,
    grid_y: Int,
    offset_x: Float,
    offset_y: Float,
    height_z: Float,
    dim_l: Float,
    dim_w: Float,
    dim_h: Float,
    sin_yaw: Float,
    cos_yaw: Float,
    velocity_vx: Float,
    velocity_vy: Float,
    class_id: Int,
};

pub fn sigmoid(x: Float) -> Float {
    return 1.0 / (1.0 + exp(0.0 - x));
}

pub fn decode_centerpoint_box(
    out: &CenterPointHeadOutput,
    grid_res: Float,
    origin_x: Float,
    origin_y: Float
) -> BoundingBox3D {
    let raw_x: Float = origin_x + ((((out).grid_x * 1.0) + (out).offset_x) * grid_res);
    let raw_y: Float = origin_y + ((((out).grid_y * 1.0) + (out).offset_y) * grid_res);
    let raw_z: Float = (out).height_z;

    let yaw_rad: Float = math_atan2((out).sin_yaw, (out).cos_yaw);

    return BoundingBox3D {
        center_x: raw_x,
        center_y: raw_y,
        center_z: raw_z,
        size_x: (out).dim_l,
        size_y: (out).dim_w,
        size_z: (out).dim_h,
        heading_rad: yaw_rad,
        confidence: (out).heatmap_score,
        class_id: (out).class_id,
    };
}
