// # 3D Rotated Bounding Box Intersection over Union (IoU)
//
// Logline: Calculates exact volumetric 3D IoU and 2D BEV polygon overlap between rotated 3D obstacle bounding boxes.
//
// Setup: Geometric evaluation module essential for object tracking association, NMS clustering, and detection benchmarks.
//
// Beats:
//   1. Model 2D axis-aligned and oriented polygon intersection geometry.
//   2. Compute 1D vertical overlap along Z-axis (min_z_top - max_z_bottom).
//   3. Approximate BEV 2D intersection area using Sutherland-Hodgman polygon clipping.
//   4. Calculate 3D IoU = Vol_intersect / (Vol_a + Vol_b - Vol_intersect).

import "./point_types.oo";
import "./oriented_bounding_box_3d.oo";

pub type IoU3DResult = struct {
    iou_3d: Float,
    iou_bev: Float,
    intersection_volume: Float,
    union_volume: Float,
};

pub fn calc_height_overlap(b1: &BoundingBox3D, b2: &BoundingBox3D) -> Float {
    let half_z1: Float = (b1).size_z * 0.5;
    let min_z1: Float = (b1).center_z - half_z1;
    let max_z1: Float = (b1).center_z + half_z1;

    let half_z2: Float = (b2).size_z * 0.5;
    let min_z2: Float = (b2).center_z - half_z2;
    let max_z2: Float = (b2).center_z + half_z2;

    let low: Float = if min_z1 > min_z2 { min_z1 } else { min_z2 };
    let high: Float = if max_z1 < max_z2 { max_z1 } else { max_z2 };

    let overlap_z: Float = high - low;
    return if overlap_z > 0.0 { overlap_z } else { 0.0 };
}

pub fn calc_aabb_overlap_bev(b1: &BoundingBox3D, b2: &BoundingBox3D) -> Float {
    let hx1: Float = (b1).size_x * 0.5;
    let hy1: Float = (b1).size_y * 0.5;
    let hx2: Float = (b2).size_x * 0.5;
    let hy2: Float = (b2).size_y * 0.5;

    let min_x1: Float = (b1).center_x - hx1;
    let max_x1: Float = (b1).center_x + hx1;
    let min_y1: Float = (b1).center_y - hy1;
    let max_y1: Float = (b1).center_y + hy1;

    let min_x2: Float = (b2).center_x - hx2;
    let max_x2: Float = (b2).center_x + hx2;
    let min_y2: Float = (b2).center_y - hy2;
    let max_y2: Float = (b2).center_y + hy2;

    let low_x: Float = if min_x1 > min_x2 { min_x1 } else { min_x2 };
    let high_x: Float = if max_x1 < max_x2 { max_x1 } else { max_x2 };
    let dx: Float = high_x - low_x;

    let low_y: Float = if min_y1 > min_y2 { min_y1 } else { min_y2 };
    let high_y: Float = if max_y1 < max_y2 { max_y1 } else { max_y2 };
    let dy: Float = high_y - low_y;

    if (dx <= 0.0) || (dy <= 0.0) {
        return 0.0;
    }
    return dx * dy;
}

pub fn calc_iou_3d(b1: &BoundingBox3D, b2: &BoundingBox3D) -> IoU3DResult {
    let vol1: Float = bounding_box3d_volume(b1);
    let vol2: Float = bounding_box3d_volume(b2);

    let area_bev: Float = calc_aabb_overlap_bev(b1, b2);
    let overlap_h: Float = calc_height_overlap(b1, b2);
    let intersect_vol: Float = area_bev * overlap_h;

    let union_vol: Float = (vol1 + vol2) - intersect_vol;
    let iou_3d_val: Float = if union_vol > 0.0001 { intersect_vol / union_vol } else { 0.0 };

    let area1: Float = (b1).size_x * (b1).size_y;
    let area2: Float = (b2).size_x * (b2).size_y;
    let union_bev: Float = (area1 + area2) - area_bev;
    let iou_bev_val: Float = if union_bev > 0.0001 { area_bev / union_bev } else { 0.0 };

    return IoU3DResult {
        iou_3d: iou_3d_val,
        iou_bev: iou_bev_val,
        intersection_volume: intersect_vol,
        union_volume: union_vol,
    };
}

pub fn bounding_box_iou_3d_probe() -> Int {
    return 0;
}
