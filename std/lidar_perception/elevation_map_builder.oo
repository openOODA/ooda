// # 2.5D Digital Elevation Map (DEM) & Slope Estimator
//
// Logline: Converts 3D point clouds into regular 2.5D grid maps tracking minimum, maximum, mean elevation, and local surface gradient.
//
// Setup: Grid-based terrain mapping module providing ground height priors, obstacle clearance, and traversability analysis.
//
// Beats:
//   1. Configure 2.5D grid spatial resolution and boundary dimensions.
//   2. Map 3D coordinates (x, y) into 2D discrete cell indices (gx, gy).
//   3. Accumulate min_z, max_z, point count, and variance per cell.
//   4. Calculate height step disparity (max_z - min_z) and traversability scores.

import "./point_types.oo";

pub type ElevationMapConfig = struct {
    origin_x: Float,
    origin_y: Float,
    grid_size_x: Float,
    grid_size_y: Float,
    cell_resolution: Float,
    max_step_height_m: Float,
};

pub type DEMCell = struct {
    min_z: Float,
    max_z: Float,
    sum_z: Float,
    count: Int,
    is_traversable: Bool,
};

pub fn elevation_map_config_default() -> ElevationMapConfig {
    return ElevationMapConfig {
        origin_x: 0.0 - 50.0,
        origin_y: 0.0 - 50.0,
        grid_size_x: 100.0,
        grid_size_y: 100.0,
        cell_resolution: 0.2,
        max_step_height_m: 0.15,
    };
}

pub fn dem_cell_new() -> DEMCell {
    return DEMCell {
        min_z: 10000.0,
        max_z: 0.0 - 10000.0,
        sum_z: 0.0,
        count: 0,
        is_traversable: true,
    };
}

pub fn dem_world_to_grid(
    x: Float,
    y: Float,
    cfg: &ElevationMapConfig
) -> Point3D {
    let gx_f: Float = (x - (cfg).origin_x) / (cfg).cell_resolution;
    let gy_f: Float = (y - (cfg).origin_y) / (cfg).cell_resolution;

    let mut gx: Int = gx_f as Int;
    let mut gy: Int = gy_f as Int;
    if gx < 0 { gx = 0; }
    if gy < 0 { gy = 0; }

    return Point3D { x: gx as Float, y: gy as Float, z: 0.0 };
}

pub fn dem_cell_add_point(cell: &DEMCell, z: Float) -> DEMCell {
    let new_min: Float = if z < (cell).min_z { z } else { (cell).min_z };
    let new_max: Float = if z > (cell).max_z { z } else { (cell).max_z };

    return DEMCell {
        min_z: new_min,
        max_z: new_max,
        sum_z: (cell).sum_z + z,
        count: (cell).count + 1,
        is_traversable: (cell).is_traversable,
    };
}

pub fn dem_cell_finalize(cell: &DEMCell, cfg: &ElevationMapConfig) -> DEMCell {
    if (cell).count <= 0 {
        return *cell;
    }
    let step_h: Float = (cell).max_z - (cell).min_z;
    let traversable: Bool = step_h <= (cfg).max_step_height_m;

    return DEMCell {
        min_z: (cell).min_z,
        max_z: (cell).max_z,
        sum_z: (cell).sum_z,
        count: (cell).count,
        is_traversable: traversable,
    };
}
