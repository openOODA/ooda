// # LiDAR-Camera Early & Late Multi-Modal Sensor Fusion
//
// Logline: Fuses rich 2D RGB semantic features with 3D metric point clouds via camera calibration and cross-modal attention.
//
// Setup: Sensor fusion module mapping RGB pixel semantics, depth completion, and 2D bounding boxes to 3D point clusters.
//
// Beats:
//   1. Represent 3D-to-2D rigid extrinsic calibration matrix and pinhole camera intrinsics.
//   2. Project 3D point cloud onto 2D image plane with depth z gating.
//   3. Interpolate RGB color, semantic class labels, and 2D bounding box scores onto 3D points.
//   4. Fuse 2D vision confidence with 3D LiDAR cluster geometry for high-certainty obstacle classification.

import "./point_types.oo";
import "./frustum_pointnet_proposal.oo";

pub type RGBColor = struct {
    r: Int,
    g: Int,
    b: Int
};

pub type PointXYZIRGB = struct {
    x: Float,
    y: Float,
    z: Float,
    intensity: Float,
    color: RGBColor,
    semantic_class: Int
};

pub fn rgb_color_new(r: Int, g: Int, b: Int) -> RGBColor {
    return RGBColor { r: r, g: g, b: b };
}

pub fn point_xyz_irgb_new(
    x: Float, y: Float, z: Float,
    intensity: Float,
    color: &RGBColor,
    semantic_class: Int
) -> PointXYZIRGB {
    return PointXYZIRGB {
        x: x, y: y, z: z,
        intensity: intensity,
        color: *color,
        semantic_class: semantic_class
    };
}

pub fn fuse_camera_semantics_to_point(
    pt: &Point3D,
    cam_intrinsics: &CameraIntrinsics,
    img_width: Int,
    img_height: Int,
    semantic_class: Int
) -> Int {
    let proj: Point3D = project_point_to_camera_image(pt, cam_intrinsics);
    if proj.z <= 0.2 {
        return 0; // Unclassified / behind camera
    }

    let u_int: Int = proj.x as Int;
    let v_int: Int = proj.y as Int;

    if (u_int >= 0) && (u_int < img_width) && (v_int >= 0) && (v_int < img_height) {
        return semantic_class;
    }

    return 0;
}
