// # 3D DBSCAN Density-Based Point Cloud Clustering
//
// Logline: Discovers arbitrary-shaped point clusters and segregates sparse background noise via core-point density reachability.
//
// Setup: Non-parametric spatial clustering module operating on 3D Euclidean epsilon neighborhoods.
//
// Beats:
//   1. Configure epsilon neighborhood radius (eps) and minimum points (min_pts).
//   2. Define DBSCAN point label states (UNVISITED, NOISE, CORE, BORDER).
//   3. Evaluate core-point condition (neighbors >= min_pts).
//   4. Expand density-reachable connected components and assign cluster IDs.

import "./point_types.oo";

pub type DBSCANConfig = struct {
    epsilon: Float,
    min_pts: Int
};

pub type PointLabelState = struct {
    point_idx: Int,
    cluster_id: Int, // 0 = unvisited, -1 = noise, >0 = cluster ID
    is_core: Bool
};

pub fn dbscan_config_default() -> DBSCANConfig {
    return DBSCANConfig {
        epsilon: 0.6,
        min_pts: 6
    };
}

pub fn point_label_state_new(idx: Int) -> PointLabelState {
    return PointLabelState {
        point_idx: idx,
        cluster_id: 0,
        is_core: false
    };
}

pub fn dbscan_is_core_point(
    neighbor_count: Int,
    cfg: &DBSCANConfig
) -> Bool {
    return neighbor_count >= (cfg).min_pts;
}

pub fn dbscan_mark_noise(state: &PointLabelState) -> PointLabelState {
    return PointLabelState {
        point_idx: (state).point_idx,
        cluster_id: 0 - 1,
        is_core: false
    };
}

pub fn dbscan_assign_cluster(
    state: &PointLabelState,
    cluster_id: Int,
    is_core: Bool
) -> PointLabelState {
    return PointLabelState {
        point_idx: (state).point_idx,
        cluster_id: cluster_id,
        is_core: is_core
    };
}
