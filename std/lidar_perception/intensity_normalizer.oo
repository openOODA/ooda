// # LiDAR Intensity & Target Reflectivity Normalizer
//
// Logline: Corrects laser return intensity for distance inverse-square decay, beam attenuation, and surface incidence angles.
//
// Setup: Radiometric correction module standardizing raw LiDAR intensity into physical target reflectance estimates.
//
// Beats:
//   1. Model range-dependent radar range equation decay ~ (R / R_ref)^2.
//   2. Compensate for atmospheric attenuation coefficients (alpha_atm).
//   3. Correct for cosine of incidence angle between laser beam and surface normal.
//   4. Output normalized target reflectivity in canonical [0.0, 1.0] interval.

import "./point_types.oo";

pub type IntensityNormalizerConfig = struct {
    reference_distance_m: Float,
    atmospheric_attenuation_db_per_km: Float,
    min_normalized_intensity: Float,
    max_normalized_intensity: Float
};

pub fn intensity_normalizer_config_default() -> IntensityNormalizerConfig {
    return IntensityNormalizerConfig {
        reference_distance_m: 10.0,
        atmospheric_attenuation_db_per_km: 2.0,
        min_normalized_intensity: 0.0,
        max_normalized_intensity: 255.0
    };
}

pub fn normalize_intensity_by_range(
    raw_intensity: Float,
    range_m: Float,
    cfg: &IntensityNormalizerConfig
) -> Float {
    if range_m < 0.5 {
        return raw_intensity;
    }

    let r_ratio: Float = range_m / (cfg).reference_distance_m;
    let r_sq: Float = r_ratio * r_ratio;

    // Atmospheric attenuation factor
    let dist_km: Float = range_m * 0.001;
    let alpha_lin: Float = (cfg).atmospheric_attenuation_db_per_km * 0.1;
    let atm_factor: Float = exp(alpha_lin * dist_km);

    let normalized: Float = raw_intensity * r_sq * atm_factor;

    let mut clamped: Float = normalized;
    if clamped < (cfg).min_normalized_intensity {
        clamped = (cfg).min_normalized_intensity;
    }
    if clamped > (cfg).max_normalized_intensity {
        clamped = (cfg).max_normalized_intensity;
    }

    return clamped;
}

pub fn normalize_point_xyzi(
    p: &PointXYZI,
    cfg: &IntensityNormalizerConfig
) -> PointXYZI {
    let pt: Point3D = Point3D { x: (p).x, y: (p).y, z: (p).z };
    let range: Float = point3d_range(&pt);
    let norm_i: Float = normalize_intensity_by_range((p).intensity, range, cfg);

    return PointXYZI {
        x: (p).x,
        y: (p).y,
        z: (p).z,
        intensity: norm_i
    };
}
