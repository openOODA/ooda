// # Polar / Radial Grid Fast LiDAR Clusterer
//
// Logline: Bins non-ground LiDAR returns into polar coordinate wedges to achieve real-time O(N) object clustering.
//
// Setup: Fast polar representation clusterer taking advantage of LiDAR sensor rotational sweep geometry.
//
// Beats:
//   1. Configure radial bin step distance and azimuth angular resolution.
//   2. Compute polar bin coordinates (ring_idx, sector_idx) from Cartesian (X, Y).
//   3. Group adjacent occupied polar cells along radial and tangential directions.
//   4. Generate compact cluster bounding boxes and centroids.

import "./point_types.oo";
import "./euclidean_cluster_extractor.oo";

pub type RadialGridConfig = struct {
    radial_step_m: Float,
    angular_step_deg: Float,
    max_range_m: Float
};

pub type PolarCellIndex = struct {
    radial_idx: Int,
    angular_idx: Int
};

pub fn radial_grid_config_default() -> RadialGridConfig {
    return RadialGridConfig {
        radial_step_m: 0.5,
        angular_step_deg: 1.0,
        max_range_m: 80.0
    };
}

pub fn point_to_polar_cell(p: &Point3D, cfg: &RadialGridConfig) -> PolarCellIndex {
    let r: Float = point3d_horizontal_range(p);
    let mut rad_idx: Int = (r / (cfg).radial_step_m) as Int;
    if rad_idx < 0 { rad_idx = 0; }

    let yaw_rad: Float = point3d_azimuth_rad(p);
    let yaw_deg: Float = yaw_rad * (180.0 / math_pi());
    let mut norm_deg: Float = yaw_deg + 180.0; // [0.0, 360.0]
    if norm_deg < 0.0 { norm_deg = 0.0; }
    if norm_deg >= 360.0 { norm_deg = 359.99; }

    let mut ang_idx: Int = (norm_deg / (cfg).angular_step_deg) as Int;
    if ang_idx < 0 { ang_idx = 0; }

    return PolarCellIndex {
        radial_idx: rad_idx,
        angular_idx: ang_idx
    };
}

pub fn are_polar_cells_adjacent(
    c1: &PolarCellIndex,
    c2: &PolarCellIndex,
    total_ang_bins: Int
) -> Bool {
    let d_rad: Int = (c1).radial_idx - (c2).radial_idx;
    let abs_d_rad: Int = if d_rad < 0 { 0 - d_rad } else { d_rad };

    let mut d_ang: Int = (c1).angular_idx - (c2).angular_idx;
    if d_ang < 0 { d_ang = 0 - d_ang; }
    if d_ang > (total_ang_bins / 2) {
        d_ang = total_ang_bins - d_ang;
    }

    return (abs_d_rad <= 1) && (d_ang <= 1);
}
