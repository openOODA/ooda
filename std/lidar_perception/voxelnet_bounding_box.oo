// # VoxelNet 3D Object Detection & Bounding Box Estimator
//
// Logline: Converts point clouds into volumetric voxel feature encodings (VFE) to predict oriented 3D obstacle bounding boxes.
//
// Setup: End-to-end 3D deep detection module combining point-wise VFE layers, 3D convolutions, and region proposal networks.
//
// Beats:
//   1. Configure 3D voxel grid discretization and VFE layer channel depths.
//   2. Compute point-to-voxel centroid offsets (dx, dy, dz) and augmented features.
//   3. Aggregate voxel feature representations via max-pooling.
//   4. Decode 3D anchor residual regressions (dx, dy, dz, dl, dw, dh, dyaw) into final bounding boxes.

import "./point_types.oo";
import "./voxel_grid_filter.oo";

pub type VoxelNetConfig = struct {
    voxel_size_x: Float,
    voxel_size_y: Float,
    voxel_size_z: Float,
    max_points_per_voxel: Int,
    max_voxels: Int,
    feature_dim: Int,
};

pub type AnchorBox3D = struct {
    x: Float, y: Float, z: Float,
    dx: Float, dy: Float, dz: Float,
    yaw: Float,
};

pub type BoxResidualRegression = struct {
    delta_x: Float,
    delta_y: Float,
    delta_z: Float,
    delta_l: Float,
    delta_w: Float,
    delta_h: Float,
    delta_yaw: Float,
};

pub fn voxelnet_config_default() -> VoxelNetConfig {
    return VoxelNetConfig {
        voxel_size_x: 0.2,
        voxel_size_y: 0.2,
        voxel_size_z: 0.4,
        max_points_per_voxel: 35,
        max_voxels: 20000,
        feature_dim: 128,
    };
}

pub fn anchor_box3d_car() -> AnchorBox3D {
    return AnchorBox3D {
        x: 0.0, y: 0.0, z: 0.0 - 1.0,
        dx: 4.6, dy: 2.0, dz: 1.6,
        yaw: 0.0,
    };
}

pub fn decode_box_regression(
    anchor: &AnchorBox3D,
    res: &BoxResidualRegression,
    confidence: Float,
    class_id: Int
) -> BoundingBox3D {
    // Diagonal in XY plane
    let d_diag: Float = sqrt(((anchor).dx * (anchor).dx) + ((anchor).dy * (anchor).dy));

    let pred_x: Float = (anchor).x + ((res).delta_x * d_diag);
    let pred_y: Float = (anchor).y + ((res).delta_y * d_diag);
    let pred_z: Float = (anchor).z + ((res).delta_z * (anchor).dz);

    let pred_l: Float = (anchor).dx * exp((res).delta_l);
    let pred_w: Float = (anchor).dy * exp((res).delta_w);
    let pred_h: Float = (anchor).dz * exp((res).delta_h);
    let pred_yaw: Float = (anchor).yaw + (res).delta_yaw;

    return BoundingBox3D {
        center_x: pred_x,
        center_y: pred_y,
        center_z: pred_z,
        size_x: pred_l,
        size_y: pred_w,
        size_z: pred_h,
        heading_rad: pred_yaw,
        confidence: confidence,
        class_id: class_id,
    };
}
