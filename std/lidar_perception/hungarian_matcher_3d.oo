// # 3D Hungarian / Munkres Bipartite Matcher for Data Association
//
// Logline: Solves optimal global minimum-cost assignment between active 3D tracklets and new LiDAR detections.
//
// Setup: Combinatorial optimization module pairing predicted obstacles with detections using distance/IoU cost matrices.
//
// Beats:
//   1. Construct NxM cost matrix from 3D Euclidean distances or negative IoU metrics.
//   2. Apply maximum gating distance / threshold cutoff for impossible matches.
//   3. Implement greedy and augmenting-path minimum cost bipartite assignment.
//   4. Output matched pairs, unmatched tracks, and unmatched detection indices.

import "./point_types.oo";
import "./bounding_box_iou_3d.oo";

pub type AssociationPair = struct {
    track_id: Int,
    detection_id: Int,
    cost: Float
};

pub type AssociationConfig = struct {
    max_gating_distance_m: Float,
    min_matching_iou: Float
};

pub fn association_config_default() -> AssociationConfig {
    return AssociationConfig {
        max_gating_distance_m: 3.5,
        min_matching_iou: 0.1
    };
}

pub fn calc_association_cost_distance(
    tx: Float, ty: Float, tz: Float,
    dx: Float, dy: Float, dz: Float
) -> Float {
    let diff_x: Float = tx - dx;
    let diff_y: Float = ty - dy;
    let diff_z: Float = tz - dz;
    return sqrt((diff_x * diff_x) + (diff_y * diff_y) + (diff_z * diff_z));
}

pub fn calc_association_cost_iou(iou_val: Float) -> Float {
    return 1.0 - iou_val;
}

pub fn is_gating_passed(cost: Float, cfg: &AssociationConfig) -> Bool {
    return cost <= (cfg).max_gating_distance_m;
}

pub fn association_pair_new(t_id: Int, d_id: Int, cost: Float) -> AssociationPair {
    return AssociationPair {
        track_id: t_id,
        detection_id: d_id,
        cost: cost
    };
}
