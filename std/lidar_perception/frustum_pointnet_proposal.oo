// # Frustum PointNet 2D-to-3D Region Proposal Generator
//
// Logline: Extrudes 2D camera image bounding boxes into 3D viewing frustums to focus 3D PointNet instance segmentation.
//
// Setup: Multi-modal fusion proposal generator drastically reducing 3D search space via 2D visual object cues.
//
// Beats:
//   1. Represent 2D camera bounding box (u_min, v_min, u_max, v_max).
//   2. Formulate 3D optical ray vectors through camera calibration matrix K.
//   3. Project 3D LiDAR points into camera frame to test frustum containment.
//   4. Normalize point coordinates relative to frustum viewing centroid.

import "./point_types.oo";

pub type CameraIntrinsics = struct {
    fx: Float,
    fy: Float,
    cx: Float,
    cy: Float,
};

pub type BoundingBox2D = struct {
    u_min: Float,
    v_min: Float,
    u_max: Float,
    v_max: Float,
    confidence: Float,
    class_id: Int,
};

pub fn camera_intrinsics_default() -> CameraIntrinsics {
    return CameraIntrinsics {
        fx: 721.5,
        fy: 721.5,
        cx: 609.5,
        cy: 172.8,
    };
}

pub fn project_point_to_camera_image(
    p_cam: &Point3D,
    k: &CameraIntrinsics
) -> Point3D {
    if (p_cam).z <= 0.1 {
        return Point3D { x: 0.0 - 1.0, y: 0.0 - 1.0, z: 0.0 - 1.0 };
    }

    let inv_z: Float = 1.0 / (p_cam).z;
    let u: Float = ((k).fx * (p_cam).x * inv_z) + (k).cx;
    let v: Float = ((k).fy * (p_cam).y * inv_z) + (k).cy;

    return Point3D { x: u, y: v, z: (p_cam).z };
}

pub fn is_point_in_frustum(
    p_cam: &Point3D,
    box2d: &BoundingBox2D,
    k: &CameraIntrinsics
) -> Bool {
    let proj: Point3D = project_point_to_camera_image(p_cam, k);
    if proj.z <= 0.0 {
        return false;
    }

    let in_u: Bool = (proj.x >= (box2d).u_min) && (proj.x <= (box2d).u_max);
    let in_v: Bool = (proj.y >= (box2d).v_min) && (proj.y <= (box2d).v_max);

    return in_u && in_v;
}
