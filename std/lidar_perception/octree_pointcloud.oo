// # 3D Octree Hierarchical Spatial Indexing & Occupancy Grid
//
// Logline: Subdivides 3D point cloud space recursively into 8 octants for fast spatial occupancy and LOD queries.
//
// Setup: Hierarchical spatial partitioning module supporting dynamic octree voxel queries and coarse-to-fine traversal.
//
// Beats:
//   1. Represent 3D Octree node with bounding extents and 8 child node indices.
//   2. Determine child octant index (0..7) based on point position relative to node center.
//   3. Compute octant sub-box bounding origins and half-extents.
//   4. Evaluate voxel occupancy and point containment predicates.

import "./point_types.oo";

pub type OctreeNode = struct {
    center_x: Float,
    center_y: Float,
    center_z: Float,
    half_size: Float,
    depth: Int,
    is_leaf: Bool,
    point_count: Int,
};

pub type OctreeConfig = struct {
    max_depth: Int,
    min_leaf_size: Float,
    max_points_per_leaf: Int,
};

pub fn octree_config_default() -> OctreeConfig {
    return OctreeConfig {
        max_depth: 8,
        min_leaf_size: 0.1,
        max_points_per_leaf: 16,
    };
}

pub fn octree_node_new(cx: Float, cy: Float, cz: Float, half_size: Float, depth: Int) -> OctreeNode {
    return OctreeNode {
        center_x: cx,
        center_y: cy,
        center_z: cz,
        half_size: half_size,
        depth: depth,
        is_leaf: true,
        point_count: 0,
    };
}

pub fn octree_child_index(node: &OctreeNode, p: &Point3D) -> Int {
    let mut idx: Int = 0;
    if (p).x >= (node).center_x {
        idx = idx + 1; // bit 0
    }
    if (p).y >= (node).center_y {
        idx = idx + 2; // bit 1
    }
    if (p).z >= (node).center_z {
        idx = idx + 4; // bit 2
    }
    return idx;
}

pub fn octree_get_child_index(node: &OctreeNode, p: &Point3D) -> Int {
    return octree_child_index(node, p);
}

pub fn octree_child_center(node: &OctreeNode, child_idx: Int) -> Point3D {
    let quarter: Float = (node).half_size * 0.5;
    let offset_x: Float = if (child_idx % 2) == 1 { quarter } else { 0.0 - quarter };
    let offset_y: Float = if ((child_idx / 2) % 2) == 1 { quarter } else { 0.0 - quarter };
    let offset_z: Float = if (child_idx / 4) == 1 { quarter } else { 0.0 - quarter };

    return Point3D {
        x: (node).center_x + offset_x,
        y: (node).center_y + offset_y,
        z: (node).center_z + offset_z,
    };
}

pub fn octree_contains_point(node: &OctreeNode, p: &Point3D) -> Bool {
    let hs: Float = (node).half_size;
    let in_x: Bool = ((p).x >= ((node).center_x - hs)) && ((p).x <= ((node).center_x + hs));
    let in_y: Bool = ((p).y >= ((node).center_y - hs)) && ((p).y <= ((node).center_y + hs));
    let in_z: Bool = ((p).z >= ((node).center_z - hs)) && ((p).z <= ((node).center_z + hs));
    return in_x && in_y && in_z;
}
