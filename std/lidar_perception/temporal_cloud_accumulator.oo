// # Multi-Frame Temporal Point Cloud Accumulator
//
// Logline: Registers and aggregates consecutive LiDAR sweeps into dense spatio-temporal point buffers using ego-motion poses.
//
// Setup: Multi-sweep accumulation module increasing point density for distant object detection and static map generation.
//
// Beats:
//   1. Configure temporal sliding window buffer size (N frames) and decay factor.
//   2. Transform historical point sweeps into the current ego-vehicle coordinate frame.
//   3. Compute relative timestamp delta tags per accumulated point.
//   4. Prune stale sweeps and manage fixed-capacity rolling ring buffers.

import "./point_types.oo";
import "./lidar_extrinsic_calibration.oo";

pub type TemporalAccumulatorConfig = struct {
    max_history_frames: Int,
    max_total_points: Int,
    time_decay_factor: Float,
};

pub type AccumulatedPoint = struct {
    x: Float,
    y: Float,
    z: Float,
    intensity: Float,
    age_seconds: Float,
    frame_idx: Int,
};

pub fn temporal_accumulator_config_default() -> TemporalAccumulatorConfig {
    return TemporalAccumulatorConfig {
        max_history_frames: 5,
        max_total_points: 250000,
        time_decay_factor: 0.9,
    };
}

pub fn transform_point_to_current_frame(
    p_past: &Point3D,
    tf_past_to_current: &Transform6D,
    intensity: Float,
    age_sec: Float,
    frame_idx: Int
) -> AccumulatedPoint {
    let p_curr: Point3D = transform_point3d(p_past, tf_past_to_current);

    return AccumulatedPoint {
        x: p_curr.x,
        y: p_curr.y,
        z: p_curr.z,
        intensity: intensity,
        age_seconds: age_sec,
        frame_idx: frame_idx,
    };
}

pub fn is_accumulated_point_valid(
    p: &AccumulatedPoint,
    max_age_sec: Float
) -> Bool {
    return (p).age_seconds <= max_age_sec;
}
