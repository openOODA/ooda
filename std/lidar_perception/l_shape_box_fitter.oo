// # Search-Based L-Shape Bounding Box Fitter
//
// Logline: Fits oriented rectangular bounding boxes to vehicle LiDAR clusters by optimizing edge alignment criteria across search angles.
//
// Setup: Geometric shape fitting algorithm estimating precise vehicle orientation, length, and width from partial L-shape scans.
//
// Beats:
//   1. Generate candidate heading angles theta in [0, pi/2] search range.
//   2. Project cluster 2D points onto orthogonal candidate coordinate axes.
//   3. Compute variance / area / closeness criterion criterion scores for each angle.
//   4. Select optimal box orientation and compute minimum bounding rectangle.

import "./point_types.oo";

pub type LShapeFitCriterion = struct {
    best_theta_rad: Float,
    best_score: Float,
    min_u: Float,
    max_u: Float,
    min_v: Float,
    max_v: Float
};

pub fn l_shape_criterion_init() -> LShapeFitCriterion {
    return LShapeFitCriterion {
        best_theta_rad: 0.0,
        best_score: 1000000000.0, // Minimize area or variance
        min_u: 0.0,
        max_u: 0.0,
        min_v: 0.0,
        max_v: 0.0
    };
}

pub fn project_point_2d_angle(
    px: Float,
    py: Float,
    theta_rad: Float
) -> Point3D {
    let cos_t: Float = cos(theta_rad);
    let sin_t: Float = sin(theta_rad);

    let u: Float = (px * cos_t) + (py * sin_t);
    let v: Float = ((0.0 - px) * sin_t) + (py * cos_t);

    return Point3D { x: u, y: v, z: 0.0 };
}

pub fn eval_area_criterion(
    min_u: Float, max_u: Float,
    min_v: Float, max_v: Float
) -> Float {
    let len_u: Float = max_u - min_u;
    let len_v: Float = max_v - min_v;
    return len_u * len_v;
}

pub fn update_l_shape_best(
    crit: &LShapeFitCriterion,
    theta: Float,
    score: Float,
    min_u: Float, max_u: Float,
    min_v: Float, max_v: Float
) -> LShapeFitCriterion {
    if score < (crit).best_score {
        return LShapeFitCriterion {
            best_theta_rad: theta,
            best_score: score,
            min_u: min_u,
            max_u: max_u,
            min_v: min_v,
            max_v: max_v
        };
    }
    return *crit;
}

pub fn l_shape_to_bounding_box_3d(
    crit: &LShapeFitCriterion,
    min_z: Float,
    max_z: Float
) -> BoundingBox3D {
    let u_center: Float = ((crit).min_u + (crit).max_u) * 0.5;
    let v_center: Float = ((crit).min_v + (crit).max_v) * 0.5;

    let cos_t: Float = cos((crit).best_theta_rad);
    let sin_t: Float = sin((crit).best_theta_rad);

    let center_x: Float = (u_center * cos_t) - (v_center * sin_t);
    let center_y: Float = (u_center * sin_t) + (v_center * cos_t);
    let center_z: Float = (min_z + max_z) * 0.5;

    let size_x: Float = (crit).max_u - (crit).min_u;
    let size_y: Float = (crit).max_v - (crit).min_v;
    let size_z: Float = max_z - min_z;

    return BoundingBox3D {
        center_x: center_x,
        center_y: center_y,
        center_z: center_z,
        size_x: if size_x > 0.1 { size_x } else { 0.1 },
        size_y: if size_y > 0.1 { size_y } else { 0.1 },
        size_z: if size_z > 0.1 { size_z } else { 0.1 },
        heading_rad: (crit).best_theta_rad,
        confidence: 0.95,
        class_id: 1
    };
}
