// # 3D KD-Tree Spatial Partitioning for Point Clouds
//
// Logline: Organizes 3D point cloud data into a binary space partitioning tree for logarithmic k-NN and radius queries.
//
// Setup: Spatial acceleration structure indexing Cartesian point collections with axis-aligned bounding splitting planes.
//
// Beats:
//   1. Define 3D KD-Tree node representation with point index, splitting axis (0=X, 1=Y, 2=Z), and child node indices.
//   2. Calculate axis-aligned bounding box (AABB) bounds for subtrees.
//   3. Implement recursive single nearest-neighbor (1-NN) distance bounding and pruning.
//   4. Evaluate spherical radius search query containment.

import "./point_types.oo";

pub type KDNode3D = struct {
    point_idx: Int,
    split_axis: Int, // 0=X, 1=Y, 2=Z
    split_value: Float,
    left_child: Int,
    right_child: Int
};

pub type KDTreeQuery1NN = struct {
    best_point_idx: Int,
    best_distance_sq: Float,
    nodes_visited: Int
};

pub fn kdnode_new(idx: Int, axis: Int, val: Float) -> KDNode3D {
    return KDNode3D {
        point_idx: idx,
        split_axis: axis,
        split_value: val,
        left_child: 0 - 1,
        right_child: 0 - 1
    };
}

pub fn kdtree_query_1nn_init() -> KDTreeQuery1NN {
    return KDTreeQuery1NN {
        best_point_idx: 0 - 1,
        best_distance_sq: 1000000000.0,
        nodes_visited: 0
    };
}

pub fn kdtree_update_best(
    query: &KDTreeQuery1NN,
    point_idx: Int,
    dist_sq: Float
) -> KDTreeQuery1NN {
    if dist_sq < (query).best_distance_sq {
        return KDTreeQuery1NN {
            best_point_idx: point_idx,
            best_distance_sq: dist_sq,
            nodes_visited: (query).nodes_visited + 1
        };
    }
    return KDTreeQuery1NN {
        best_point_idx: (query).best_point_idx,
        best_distance_sq: (query).best_distance_sq,
        nodes_visited: (query).nodes_visited + 1
    };
}

pub fn kdtree_axis_diff(p: &Point3D, node: &KDNode3D) -> Float {
    if (node).split_axis == 0 {
        return (p).x - (node).split_value;
    }
    if (node).split_axis == 1 {
        return (p).y - (node).split_value;
    }
    return (p).z - (node).split_value;
}

pub fn kdtree_should_search_other_side(
    axis_diff: Float,
    best_dist_sq: Float
) -> Bool {
    let plane_dist_sq: Float = axis_diff * axis_diff;
    return plane_dist_sq < best_dist_sq;
}
