// # LiDAR Radius Outlier Removal (ROR) Filter
//
// Logline: Prunes isolated noise points by asserting a minimum neighbor count within a local spherical search radius.
//
// Setup: Geometric density filter eliminating phantom clutter, atmospheric backscatter, and low-density artifacts.
//
// Beats:
//   1. Configure search radius sphere and minimum required neighbor points.
//   2. Model spherical query volumes and neighbor count accumulators.
//   3. Evaluate point density against minimum threshold criteria.
//   4. Filter isolated noise and preserve dense object point clusters.

import "./point_types.oo";

pub type RORConfig = struct {
    radius: Float,
    min_neighbors: Int,
    negative: Bool
};

pub type PointRadiusQueryResult = struct {
    point_idx: Int,
    neighbor_count: Int,
    is_valid: Bool
};

pub fn ror_config_new(radius: Float, min_neighbors: Int) -> RORConfig {
    return RORConfig {
        radius: radius,
        min_neighbors: min_neighbors,
        negative: false
    };
}

pub fn ror_config_default() -> RORConfig {
    return RORConfig {
        radius: 0.8,
        min_neighbors: 5,
        negative: false
    };
}

pub fn ror_is_within_sphere(
    query: &Point3D,
    candidate: &Point3D,
    radius_sq: Float
) -> Bool {
    let d_sq: Float = point3d_distance_sq(query, candidate);
    return d_sq <= radius_sq;
}

pub fn ror_eval_density(
    point_idx: Int,
    neighbor_count: Int,
    cfg: &RORConfig
) -> PointRadiusQueryResult {
    let meets_threshold: Bool = neighbor_count >= (cfg).min_neighbors;
    let keep: Bool = if (cfg).negative { !meets_threshold } else { meets_threshold };

    return PointRadiusQueryResult {
        point_idx: point_idx,
        neighbor_count: neighbor_count,
        is_valid: keep
    };
}
