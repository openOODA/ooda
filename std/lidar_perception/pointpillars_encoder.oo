// # PointPillars Fast 2D Pillar Feature Encoder
//
// Logline: Organizes 3D point clouds into infinite vertical columns (pillars) to enable ultra-fast 2D CNN inference.
//
// Setup: Fast 3D perception encoder converting sparse laser returns into 2D pseudo-images for real-time AV compute.
//
// Beats:
//   1. Configure 2D pillar grid resolution (dx, dy in meters) across ground plane.
//   2. Compute 9-dimensional augmented pillar features (x, y, z, r, xc, yc, zc, xp, yp).
//   3. Apply linear projection and max-pooling across points within each pillar.
//   4. Scatter encoded pillar feature vectors into 2D pseudo-image canvas (C x H x W).

import "./point_types.oo";

pub type PillarGridConfig = struct {
    pillar_size_x: Float,
    pillar_size_y: Float,
    min_x: Float,
    max_x: Float,
    min_y: Float,
    max_y: Float,
    max_points_per_pillar: Int,
    max_pillars: Int,
    feature_channels: Int,
};

pub type PillarIndex2D = struct {
    px: Int,
    py: Int,
};

pub type PillarPointAugmented = struct {
    x: Float, y: Float, z: Float,
    intensity: Float,
    dx_to_centroid: Float,
    dy_to_centroid: Float,
    dz_to_centroid: Float,
    dx_to_pillar_center: Float,
    dy_to_pillar_center: Float,
};

pub fn pillar_grid_config_default() -> PillarGridConfig {
    return PillarGridConfig {
        pillar_size_x: 0.16,
        pillar_size_y: 0.16,
        min_x: 0.0 - 50.0,
        max_x: 50.0,
        min_y: 0.0 - 50.0,
        max_y: 50.0,
        max_points_per_pillar: 32,
        max_pillars: 16000,
        feature_channels: 64,
    };
}

pub fn point_to_pillar_index(
    x: Float,
    y: Float,
    cfg: &PillarGridConfig
) -> PillarIndex2D {
    let px_f: Float = (x - (cfg).min_x) / (cfg).pillar_size_x;
    let py_f: Float = (y - (cfg).min_y) / (cfg).pillar_size_y;

    let mut px: Int = px_f as Int;
    let mut py: Int = py_f as Int;
    if px < 0 { px = 0; }
    if py < 0 { py = 0; }

    return PillarIndex2D { px: px, py: py };
}

pub fn pillar_center_coordinates(
    idx: &PillarIndex2D,
    cfg: &PillarGridConfig
) -> Point3D {
    let cx: Float = (cfg).min_x + (((idx).px as Float + 0.5) * (cfg).pillar_size_x);
    let cy: Float = (cfg).min_y + (((idx).py as Float + 0.5) * (cfg).pillar_size_y);
    return Point3D { x: cx, y: cy, z: 0.0 };
}
