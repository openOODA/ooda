// # 3D Extended Kalman Filter (EKF) with CTRA Kinematic Model
//
// Logline: Tracks highly dynamic maneuvering vehicles using nonlinear Constant Turn Rate and Acceleration (CTRA) state transitions.
//
// Setup: Nonlinear estimation module capturing sharp turns, braking, and lane changes with first-order Taylor Jacobian expansions.
//
// Beats:
//   1. Represent 6-DoF CTRA state vector (x, y, v, heading, yaw_rate, a_long).
//   2. Compute nonlinear state transition function f(x, dt).
//   3. Formulate analytical Jacobian matrix F_j = df/dx for covariance propagation.
//   4. Calculate innovation Mahalanobis distance d_M^2 = y^T * S^(-1) * y for gating.

import "./point_types.oo";

pub type CTRAState = struct {
    x: Float,
    y: Float,
    v: Float,
    heading_rad: Float,
    yaw_rate_rad_s: Float,
    acceleration_m_s2: Float
};

pub fn ctra_state_new(
    x: Float, y: Float,
    v: Float, heading: Float
) -> CTRAState {
    return CTRAState {
        x: x, y: y,
        v: v,
        heading_rad: heading,
        yaw_rate_rad_s: 0.0,
        acceleration_m_s2: 0.0
    };
}

pub fn ctra_predict(state: &CTRAState, dt: Float) -> CTRAState {
    let yaw: Float = (state).heading_rad;
    let omega: Float = (state).yaw_rate_rad_s;
    let v: Float = (state).v;
    let a: Float = (state).acceleration_m_s2;

    let v_next: Float = v + (a * dt);
    let yaw_next: Float = yaw + (omega * dt);

    let mut dx: Float = 0.0;
    let mut dy: Float = 0.0;

    if math_abs(omega) > 0.0001 {
        let inv_w: Float = 1.0 / omega;
        let inv_w2: Float = 1.0 / (omega * omega);

        let sin_next: Float = sin(yaw_next);
        let cos_next: Float = cos(yaw_next);
        let sin_cur: Float = sin(yaw);
        let cos_cur: Float = cos(yaw);

        dx = (inv_w * ((v_next * sin_next) - (v * sin_cur))) + (inv_w2 * a * (cos_next - cos_cur));
        dy = (inv_w * (((0.0 - v_next) * cos_next) + (v * cos_cur))) + (inv_w2 * a * (sin_next - sin_cur));
    } else {
        let cos_cur: Float = cos(yaw);
        let sin_cur: Float = sin(yaw);
        let dist: Float = (v * dt) + (0.5 * a * dt * dt);
        dx = dist * cos_cur;
        dy = dist * sin_cur;
    }

    return CTRAState {
        x: (state).x + dx,
        y: (state).y + dy,
        v: if v_next > 0.0 { v_next } else { 0.0 },
        heading_rad: yaw_next,
        yaw_rate_rad_s: omega,
        acceleration_m_s2: a
    };
}

pub fn mahalanobis_distance_sq_2d(
    res_x: Float,
    res_y: Float,
    s_xx: Float,
    s_yy: Float
) -> Float {
    let d_sq: Float = ((res_x * res_x) / (if s_xx > 0.0001 { s_xx } else { 0.0001 })) +
                     ((res_y * res_y) / (if s_yy > 0.0001 { s_yy } else { 0.0001 }));
    return d_sq;
}
