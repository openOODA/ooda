// # Lanelet2 HD Map Geometric & Semantic Parser
//
// Logline: Parses high-definition vector map primitives including 3D Points, LineStrings, Lanelets, Regulatory Elements, and Areas.
//
// Setup: HD map ingestion engine standardizing Lanelet2 roadway topology for autonomous vehicle path routing and localization.
//
// Beats:
//   1. Represent fundamental Lanelet2 primitives (MapPoint3D, LineString3D, Lanelet, RegElement).
//   2. Model left and right boundary linestrings defining drivable lanelet corridors.
//   3. Compute lanelet centerline coordinates and lane width dimensions.
//   4. Query lanelet connectivity, successor/predecessor links, and regulatory constraints.

import "./point_types.oo";

pub type MapPoint3D = struct {
    id: Int,
    x: Float,
    y: Float,
    z: Float
};

pub type LineString3D = struct {
    id: Int,
    point_count: Int,
    length_m: Float
};

pub type Lanelet = struct {
    id: Int,
    left_bound_id: Int,
    right_bound_id: Int,
    speed_limit_kph: Float,
    is_bidirectional: Bool,
    road_type: Int // 0=Urban, 1=Highway, 2=Intersection
};

pub type RegulatoryElement = struct {
    id: Int,
    type_id: Int, // 1=TrafficLight, 2=StopSign, 3=SpeedLimit, 4=Crosswalk
    ref_line_id: Int,
    param_value: Float
};

pub fn map_point3d_new(id: Int, x: Float, y: Float, z: Float) -> MapPoint3D {
    return MapPoint3D { id: id, x: x, y: y, z: z };
}

pub fn lanelet_new(
    id: Int,
    left_id: Int,
    right_id: Int,
    speed_limit: Float
) -> Lanelet {
    return Lanelet {
        id: id,
        left_bound_id: left_id,
        right_bound_id: right_id,
        speed_limit_kph: speed_limit,
        is_bidirectional: false,
        road_type: 0
    };
}

pub fn compute_centerline_point(
    p_left: &MapPoint3D,
    p_right: &MapPoint3D
) -> Point3D {
    return Point3D {
        x: ((p_left).x + (p_right).x) * 0.5,
        y: ((p_left).y + (p_right).y) * 0.5,
        z: ((p_left).z + (p_right).z) * 0.5
    };
}

pub fn compute_lane_width(
    p_left: &MapPoint3D,
    p_right: &MapPoint3D
) -> Float {
    let pt_l: Point3D = Point3D { x: (p_left).x, y: (p_left).y, z: (p_left).z };
    let pt_r: Point3D = Point3D { x: (p_right).x, y: (p_right).y, z: (p_right).z };
    return point3d_distance(&pt_l, &pt_r);
}
