// # 2D Convex Hull & 3D Prism Volume Extrusion
//
// Logline: Computes 2D convex polygon boundaries from unstructured point clusters and extrudes 3D vertical prism hulls.
//
// Setup: Geometric wrapping module modeling non-cuboid obstacles, guardrails, and arbitrary debris geometries.
//
// Beats:
//   1. Implement 2D cross-product orientation test (CCW turn predicate).
//   2. Compute 2D polygon vertex chain wrapping point clusters.
//   3. Calculate 2D polygon area via shoelace formula.
//   4. Extrude 2D footprint vertically across [min_z, max_z] into 3D prism volume.

import "./point_types.oo";

pub type ConvexPolygon2D = struct {
    vertex_count: Int,
    min_z: Float,
    max_z: Float,
    area_2d: Float,
    volume_3d: Float,
};

pub fn ccw_cross_2d(
    ax: Float, ay: Float,
    bx: Float, by: Float,
    cx: Float, cy: Float
) -> Float {
    return ((bx - ax) * (cy - ay)) - ((by - ay) * (cx - ax));
}

pub fn is_counter_clockwise(
    ax: Float, ay: Float,
    bx: Float, by: Float,
    cx: Float, cy: Float
) -> Bool {
    return ccw_cross_2d(ax, ay, bx, by, cx, cy) > 0.0;
}

pub fn shoelace_quad_area_2d(
    x0: Float, y0: Float,
    x1: Float, y1: Float,
    x2: Float, y2: Float,
    x3: Float, y3: Float
) -> Float {
    let term1: Float = (x0 * y1) - (y0 * x1);
    let term2: Float = (x1 * y2) - (y1 * x2);
    let term3: Float = (x2 * y3) - (y2 * x3);
    let term4: Float = (x3 * y0) - (y3 * x0);
    let sum: Float = term1 + term2 + term3 + term4;
    return math_abs(sum) * 0.5;
}

pub fn convex_polygon_prism_new(
    vertex_count: Int,
    area_2d: Float,
    min_z: Float,
    max_z: Float
) -> ConvexPolygon2D {
    let height: Float = max_z - min_z;
    let h_pos: Float = if height > 0.0 { height } else { 0.0 };
    let volume: Float = area_2d * h_pos;

    return ConvexPolygon2D {
        vertex_count: vertex_count,
        min_z: min_z,
        max_z: max_z,
        area_2d: area_2d,
        volume_3d: volume,
    };
}
