// # 3D Normal Distributions Transform (NDT) Scan Matcher
//
// Logline: Converts target point clouds into smooth probability density voxel grids for fast gradient-based scan alignment.
//
// Setup: Probabilistic scan-to-map matching engine used widely in autonomous vehicle HD map localization and LiDAR odometry.
//
// Beats:
//   1. Partition 3D space into regular NDT voxel cells.
//   2. Fit Gaussian probability distribution (mean vector mu, covariance Sigma) per cell.
//   3. Transform source points into target NDT grid and evaluate probability density scores.
//   4. Optimize 6-DoF pose using Newton / gradient-descent score maximization.

import "./point_types.oo";
import "./lidar_extrinsic_calibration.oo";

pub type NDTConfig = struct {
    voxel_resolution: Float,
    outlier_ratio: Float,
    max_iterations: Int,
    step_size: Float,
};

pub type NDTVoxel = struct {
    mean_x: Float,
    mean_y: Float,
    mean_z: Float,
    c00: Float, c01: Float, c02: Float,
    c11: Float, c12: Float,
    c22: Float,
    point_count: Int,
    is_initialized: Bool,
};

pub fn ndt_config_default() -> NDTConfig {
    return NDTConfig {
        voxel_resolution: 1.0,
        outlier_ratio: 0.55,
        max_iterations: 35,
        step_size: 0.1,
    };
}

pub fn ndt_voxel_new() -> NDTVoxel {
    return NDTVoxel {
        mean_x: 0.0, mean_y: 0.0, mean_z: 0.0,
        c00: 0.1, c01: 0.0, c02: 0.0,
        c11: 0.1, c12: 0.0,
        c22: 0.1,
        point_count: 0,
        is_initialized: false,
    };
}

pub fn ndt_eval_point_likelihood(
    pt: &Point3D,
    voxel: &NDTVoxel
) -> Float {
    if !(voxel).is_initialized {
        return 0.0;
    }

    let dx: Float = (pt).x - (voxel).mean_x;
    let dy: Float = (pt).y - (voxel).mean_y;
    let dz: Float = (pt).z - (voxel).mean_z;

    // Fast approximation of Gaussian exponent
    let dist_sq: Float = (dx * dx) + (dy * dy) + (dz * dz);
    let score: Float = exp(0.0 - (0.5 * dist_sq));

    return score;
}
