// # LiDAR Progressive Morphological Filter (PMF)
//
// Logline: Applies morphological opening operations with expanding structural window sizes to separate bare-earth terrain from buildings and vegetation.
//
// Setup: Elevation-based ground filtering module using multi-scale morphological dilation and erosion.
//
// Beats:
//   1. Configure morphological window size sequences and elevation difference thresholds.
//   2. Model 2D elevation grid surface with minimum height cells.
//   3. Apply morphological erosion (min filter) followed by dilation (max filter).
//   4. Compute elevation disparity and classify terrain ground cells.

import "./point_types.oo";

pub type PMFConfig = struct {
    initial_window_size: Int,
    max_window_size: Int,
    elevation_threshold_base: Float,
    slope: Float,
    cell_size: Float,
};

pub type ElevationCell = struct {
    min_z: Float,
    max_z: Float,
    has_point: Bool,
    is_ground: Bool,
};

pub fn pmf_config_default() -> PMFConfig {
    return PMFConfig {
        initial_window_size: 3,
        max_window_size: 15,
        elevation_threshold_base: 0.3,
        slope: 0.1,
        cell_size: 0.5,
    };
}

pub fn elevation_cell_new() -> ElevationCell {
    return ElevationCell {
        min_z: 10000.0,
        max_z: 0.0 - 10000.0,
        has_point: false,
        is_ground: false,
    };
}

pub fn pmf_calc_threshold(window_size: Int, cfg: &PMFConfig) -> Float {
    let half_w: Float = ((window_size - 1) as Float) * 0.5;
    let dist: Float = half_w * (cfg).cell_size;
    return (cfg).elevation_threshold_base + ((cfg).slope * dist);
}

pub fn pmf_is_ground_point(
    point_z: Float,
    opened_surface_z: Float,
    threshold: Float
) -> Bool {
    let dz: Float = point_z - opened_surface_z;
    return dz <= threshold;
}
