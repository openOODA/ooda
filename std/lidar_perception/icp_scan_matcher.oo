// # Iterative Closest Point (ICP) 3D Scan Matcher
//
// Logline: Estimates 6-DoF relative rigid transformation between consecutive point cloud sweeps via point-to-point and point-to-plane ICP.
//
// Setup: Core LiDAR odometry and scan matching engine minimizing spatial Euclidean residuals across nearest-neighbor correspondences.
//
// Beats:
//   1. Configure ICP convergence criteria (max iterations, tolerance, max correspondence distance).
//   2. Compute nearest-neighbor point pairs and Euclidean distance residuals.
//   3. Solve 6-DoF optimal translation and rotation increments (SVD / closed-form).
//   4. Evaluate iteration cost reduction and check transformation convergence.

import "./point_types.oo";
import "./lidar_extrinsic_calibration.oo";

pub type ICPConfig = struct {
    max_iterations: Int,
    max_correspondence_distance: Float,
    transformation_epsilon: Float,
    euclidean_fitness_epsilon: Float
};

pub type ICPMatchResult = struct {
    transform: Transform6D,
    fitness_score: Float,
    iterations_used: Int,
    has_converged: Bool
};

pub fn icp_config_default() -> ICPConfig {
    return ICPConfig {
        max_iterations: 30,
        max_correspondence_distance: 1.0,
        transformation_epsilon: 0.000001,
        euclidean_fitness_epsilon: 0.0001
    };
}

pub fn icp_match_result_new() -> ICPMatchResult {
    return ICPMatchResult {
        transform: transform6d_identity(),
        fitness_score: 1000.0,
        iterations_used: 0,
        has_converged: false
    };
}

pub fn calc_point_to_point_residual(
    src: &Point3D,
    tgt: &Point3D
) -> Float {
    return point3d_distance_sq(src, tgt);
}

pub fn calc_point_to_plane_residual(
    src: &Point3D,
    tgt: &Point3D,
    normal: &Point3D
) -> Float {
    let diff_x: Float = (src).x - (tgt).x;
    let diff_y: Float = (src).y - (tgt).y;
    let diff_z: Float = (src).z - (tgt).z;
    let dot: Float = (diff_x * (normal).x) + (diff_y * (normal).y) + (diff_z * (normal).z);
    return dot * dot;
}

pub fn is_icp_converged(
    prev_fitness: Float,
    curr_fitness: Float,
    cfg: &ICPConfig
) -> Bool {
    let diff: Float = math_abs(prev_fitness - curr_fitness);
    return diff <= (cfg).euclidean_fitness_epsilon;
}
