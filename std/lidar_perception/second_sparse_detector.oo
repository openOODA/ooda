// # SECOND Sparsely Embedded 3D Convolutional Detector
//
// Logline: Exploits spatial sparsity in 3D voxel grids with submanifold sparse convolutions to accelerate 3D LiDAR detection.
//
// Setup: Fast sparse voxel convolution architecture optimizing memory footprint and computation over non-empty voxels.
//
// Beats:
//   1. Model sparse 3D coordinate hash indexing for active non-empty voxels.
//   2. Compute 3x3x3 kernel neighbor offsets and submanifold connection rules.
//   3. Implement sine-difference orientation angle loss parameterization.
//   4. Generate multi-class candidate bounding box predictions.

import "./point_types.oo";
import "./voxel_grid_filter.oo";

pub type SparseVoxel3D = struct {
    x: Int,
    y: Int,
    z: Int,
    feature_index: Int
};

pub type SparseConvConfig = struct {
    kernel_size: Int,
    stride: Int,
    padding: Int,
    in_channels: Int,
    out_channels: Int
};

pub fn sparse_conv_config_default() -> SparseConvConfig {
    return SparseConvConfig {
        kernel_size: 3,
        stride: 1,
        padding: 1,
        in_channels: 16,
        out_channels: 32
    };
}

pub fn is_submanifold_neighbor(
    v1: &SparseVoxel3D,
    v2: &SparseVoxel3D,
    half_k: Int
) -> Bool {
    let dx: Int = (v1).x - (v2).x;
    let dy: Int = (v1).y - (v2).y;
    let dz: Int = (v1).z - (v2).z;

    let abs_dx: Int = if dx < 0 { 0 - dx } else { dx };
    let abs_dy: Int = if dy < 0 { 0 - dy } else { dy };
    let abs_dz: Int = if dz < 0 { 0 - dz } else { dz };

    return (abs_dx <= half_k) && (abs_dy <= half_k) && (abs_dz <= half_k);
}

pub fn second_angle_loss_param(pred_rad: Float, target_rad: Float) -> Float {
    // SECOND uses sin(theta_pred - theta_target) to resolve 180-deg ambiguity
    return sin(pred_rad - target_rad);
}
