// # High-Definition Map Frenet (s, d) Coordinate Transform
//
// Logline: Converts 2D Cartesian vehicle positions (x, y) into roadway curve-relative longitudinal arc-length s and lateral offset d.
//
// Setup: Coordinate transformation module simplifying autonomous vehicle path planning, lane keeping, and collision checking.
//
// Beats:
//   1. Represent Frenet state (s, d, s_dot, d_dot, s_ddot, d_ddot).
//   2. Find closest projection point along piecewise-linear lane centerline spline.
//   3. Compute signed lateral offset d (positive left, negative right of centerline).
//   4. Calculate road reference tangent angle and curvature kappa(s).

import "./point_types.oo";

pub type FrenetCoordinate = struct {
    s: Float, // Longitudinal distance along centerline curve
    d: Float, // Lateral cross-track offset from centerline
    tangent_angle_rad: Float,
    curvature_kappa: Float
};

pub fn frenet_coordinate_new(
    s: Float,
    d: Float,
    tangent: Float,
    kappa: Float
) -> FrenetCoordinate {
    return FrenetCoordinate {
        s: s,
        d: d,
        tangent_angle_rad: tangent,
        curvature_kappa: kappa
    };
}

pub fn project_point_to_line_segment(
    px: Float, py: Float,
    x1: Float, y1: Float,
    x2: Float, y2: Float
) -> Point3D {
    let dx: Float = x2 - x1;
    let dy: Float = y2 - y1;
    let seg_len_sq: Float = (dx * dx) + (dy * dy);

    if seg_len_sq < 0.000001 {
        return Point3D { x: x1, y: y1, z: 0.0 };
    }

    let t: Float = (((px - x1) * dx) + ((py - y1) * dy)) / seg_len_sq;
    let mut clamped_t: Float = t;
    if clamped_t < 0.0 { clamped_t = 0.0; }
    if clamped_t > 1.0 { clamped_t = 1.0; }

    return Point3D {
        x: x1 + (clamped_t * dx),
        y: y1 + (clamped_t * dy),
        z: 0.0
    };
}

pub fn calc_signed_lateral_distance(
    px: Float, py: Float,
    proj_x: Float, proj_y: Float,
    tangent_rad: Float
) -> Float {
    let dx: Float = px - proj_x;
    let dy: Float = py - proj_y;
    let dist: Float = sqrt((dx * dx) + (dy * dy));

    // Cross product with unit tangent vector: (cos(t), sin(t)) x (dx, dy) = cos(t)*dy - sin(t)*dx
    let cross_z: Float = (cos(tangent_rad) * dy) - (sin(tangent_rad) * dx);
    if cross_z < 0.0 {
        return 0.0 - dist; // Right side
    }
    return dist; // Left side
}
