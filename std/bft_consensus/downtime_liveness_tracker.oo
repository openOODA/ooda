// # Validator Downtime & Liveness Tracker
//
// Logline: Tracks signed block counts across a sliding window, penalizing inactive validators with automatic jailing.
//
// Setup: Protects consensus throughput by identifying offline nodes and temporarily removing them from the active set.
//
// Beats:
//   1. Define LivenessWindow, ValidatorLivenessRecord, and DowntimeSlashingParams.
//   2. Record signed block heartbeats into sliding window bitarrays.
//   3. Trigger automated jailing when signed blocks fall below minimum liveness threshold.

pub type ValidatorLivenessRecord = struct {
    validator_address: String,
    window_size: Int,
    missed_blocks: Int,
    max_allowed_missed: Int,
    is_jailed: Bool,
};

pub fn validator_liveness_new(addr: String, window_len: Int, max_missed: Int) -> ValidatorLivenessRecord {
    return ValidatorLivenessRecord {
        validator_address: addr,
        window_size: window_len,
        missed_blocks: 0,
        max_allowed_missed: max_missed,
        is_jailed: false,
    };
}

pub fn validator_record_block_activity(rec: ValidatorLivenessRecord, signed: Bool) -> ValidatorLivenessRecord {
    if (rec).is_jailed {
        return rec;
    }
    if !signed {
        (rec).missed_blocks = (rec).missed_blocks + 1;
        if (rec).missed_blocks > (rec).max_allowed_missed {
            (rec).is_jailed = true;
        }
    } else {
        if (rec).missed_blocks > 0 {
            (rec).missed_blocks = (rec).missed_blocks - 1;
        }
    }
    return rec;
}

pub fn validator_unjail(rec: ValidatorLivenessRecord) -> ValidatorLivenessRecord {
    (rec).is_jailed = false;
    (rec).missed_blocks = 0;
    return rec;
}
