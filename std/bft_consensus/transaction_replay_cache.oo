// # Transaction Replay Protection & Nonce Sliding Cache
//
// Logline: Protects consensus against transaction replay attacks using sliding account nonces and expiration TTLs.
//
// Setup: Tracks verified account sequence numbers and rejects out-of-order or duplicate execution attempts.
//
// Beats:
//   1. Define AccountNonceEntry, ReplayCacheConfig, and NonceValidationResult.
//   2. Validate that transaction nonces match exact expected sequential account state.
//   3. Advance account nonce upon successful block execution.

pub type AccountNonceEntry = struct {
    account_address: String,
    expected_nonce: Int,
    last_updated_height: Int,
};

pub fn account_nonce_entry_new(addr: String, initial_nonce: Int, height: Int) -> AccountNonceEntry {
    return AccountNonceEntry {
        account_address: addr,
        expected_nonce: initial_nonce,
        last_updated_height: height,
    };
}

pub fn account_nonce_is_valid(entry: AccountNonceEntry, tx_nonce: Int) -> Bool {
    return tx_nonce == (entry).expected_nonce;
}

pub fn account_nonce_increment(entry: AccountNonceEntry, height: Int) -> AccountNonceEntry {
    (entry).expected_nonce = (entry).expected_nonce + 1;
    (entry).last_updated_height = height;
    return entry;
}

pub fn account_nonce_is_future(entry: AccountNonceEntry, tx_nonce: Int) -> Bool {
    return tx_nonce > (entry).expected_nonce;
}
