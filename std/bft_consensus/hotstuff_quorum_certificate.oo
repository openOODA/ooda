// # HotStuff Quorum Certificate (QC) & 3-Chain Rule
//
// Logline: Implements Quorum Certificate aggregation and validates the canonical HotStuff 3-chain commit rule.
//
// Setup: Evaluates consecutive QC chains (Prepare, Pre-commit, Commit) to achieve irrevocable block finality.
//
// Beats:
//   1. Define QuorumCertificate and HotStuff3ChainState structures.
//   2. Validate QC signature weights against 2f+1 quorum thresholds.
//   3. Execute the 3-chain commit rule for direct parent-child-grandchild relationships.

pub type QuorumCertificate = struct {
    view: Int,
    block_hash: String,
    step_type: Int, // 1: Generic/Prepare, 2: PreCommit, 3: Commit, 4: Decide
    vote_count: Int,
    signature_aggregate: String,
    is_valid: Bool
};

pub type HotStuff3ChainState = struct {
    node_b0_hash: String, // Child (view v)
    node_b1_hash: String, // Parent (view v-1)
    node_b2_hash: String, // Grandparent (view v-2)
    node_b3_hash: String, // Great-grandparent (view v-3, committed)
    is_committed: Bool
};

pub fn quorum_certificate_new(view: Int, block_hash: String, step: Int, votes: Int) -> QuorumCertificate {
    return QuorumCertificate {
        view: view,
        block_hash: block_hash,
        step_type: step,
        vote_count: votes,
        signature_aggregate: "0x_bls_qc_sig",
        is_valid: true
    };
}

pub fn hotstuff_verify_qc(qc: QuorumCertificate, total_nodes: Int) -> Bool {
    let f: Int = (total_nodes - 1) / 3;
    let threshold: Int = 2 * f + 1;
    return (qc).is_valid && ((qc).vote_count >= threshold);
}

pub fn hotstuff_check_3chain_commit(v0: Int, v1: Int, v2: Int, v3: Int) -> Bool {
    // 3-chain rule requires consecutive direct links: v0 = v1 + 1, v1 = v2 + 1, v2 = v3 + 1
    return (v0 == v1 + 1) && (v1 == v2 + 1) && (v2 == v3 + 1);
}

pub fn hotstuff_evaluate_3chain(
    b0_hash: String, v0: Int,
    b1_hash: String, v1: Int,
    b2_hash: String, v2: Int,
    b3_hash: String, v3: Int
) -> HotStuff3ChainState {
    let commit_ok: Bool = hotstuff_check_3chain_commit(v0, v1, v2, v3);
    return HotStuff3ChainState {
        node_b0_hash: b0_hash,
        node_b1_hash: b1_hash,
        node_b2_hash: b2_hash,
        node_b3_hash: b3_hash,
        is_committed: commit_ok
    };
}
