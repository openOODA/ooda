// # Slashing Equivocation Detector & Fault Proof Generator
//
// Logline: Analyzes incoming consensus votes and proposals to catch Byzantine double-signing faults and generate proof envelopes.
//
// Setup: Real-time invariant monitor comparing cryptographic signatures across identical slots and heights.
//
// Beats:
//   1. Define EquivocationProof, VoteRecord, and FaultRegistry structures.
//   2. Compare incoming vote hash against previously recorded vote for matching round.
//   3. Assemble cryptographically sealed fault proof for automated slashing execution.

pub type VoteRecord = struct {
    voter_id: Int,
    height: Int,
    round: Int,
    block_hash: String,
    signature: String,
};

pub type EquivocationProof = struct {
    offender_id: Int,
    height: Int,
    round: Int,
    hash_a: String,
    hash_b: String,
    is_fault_confirmed: Bool,
};

pub fn equivocation_proof_new(voter_id: Int, h: Int, r: Int) -> EquivocationProof {
    return EquivocationProof {
        offender_id: voter_id,
        height: h,
        round: r,
        hash_a: "",
        hash_b: "",
        is_fault_confirmed: false,
    };
}

pub fn equivocation_check_conflict(first_vote: VoteRecord, second_vote: VoteRecord) -> EquivocationProof {
    let same_voter: Bool = (first_vote).voter_id == (second_vote).voter_id;
    let same_slot: Bool = ((first_vote).height == (second_vote).height) && ((first_vote).round == (second_vote).round);
    let diff_blocks: Bool = (first_vote).block_hash != (second_vote).block_hash;
    let is_fault: Bool = same_voter && same_slot && diff_blocks;
    return EquivocationProof {
        offender_id: (first_vote).voter_id,
        height: (first_vote).height,
        round: (first_vote).round,
        hash_a: (first_vote).block_hash,
        hash_b: (second_vote).block_hash,
        is_fault_confirmed: is_fault,
    };
}
