// # PBFT Checkpoint Proofs & State Digest Aggregation
//
// Logline: Generates and verifies stable checkpoint proofs with 2f+1 signed node state digests.
//
// Setup: Periodic state checkpointing allowing nodes to safely discard older log messages.
//
// Beats:
//   1. Define CheckpointMessage and CheckpointProof structures.
//   2. Aggregate signed checkpoint messages for identical sequence and state digest.
//   3. Certify stable checkpoint once quorum threshold is satisfied.

pub type CheckpointMessage = struct {
    sequence_number: Int,
    state_digest: String,
    node_id: Int,
    signature_valid: Bool,
};

pub type CheckpointProof = struct {
    sequence_number: Int,
    state_digest: String,
    votes_count: Int,
    required_quorum: Int,
    is_stable: Bool,
};

pub fn checkpoint_proof_new(seq: Int, dig: String, total_nodes: Int) -> CheckpointProof {
    let f: Int = (total_nodes - 1) / 3;
    let threshold: Int = 2 * f + 1;
    return CheckpointProof {
        sequence_number: seq,
        state_digest: dig,
        votes_count: 0,
        required_quorum: threshold,
        is_stable: false,
    };
}

pub fn checkpoint_proof_add_vote(proof: CheckpointProof, msg: CheckpointMessage) -> CheckpointProof {
    if (msg).sequence_number != (proof).sequence_number {
        return proof;
    }
    if (msg).state_digest != (proof).state_digest {
        return proof;
    }
    if !(msg).signature_valid {
        return proof;
    }
    (proof).votes_count = (proof).votes_count + 1;
    if (proof).votes_count >= (proof).required_quorum {
        (proof).is_stable = true;
    }
    return proof;
}

pub fn checkpoint_proof_is_stable(proof: CheckpointProof) -> Bool {
    return (proof).is_stable;
}
