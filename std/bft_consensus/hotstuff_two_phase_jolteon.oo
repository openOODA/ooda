// # Jolteon Two-Phase Responsive Commit Rule
//
// Logline: Implements the 2-chain fast responsive commit protocol (Jolteon/Fast-HotStuff) with optimistic latency.
//
// Setup: Achieves optimistic 2-round commit latency when proposer succeeds and falls back to TC on view timeout.
//
// Beats:
//   1. Define JolteonBlock, JolteonCommitState, and QC chain links.
//   2. Evaluate 2-chain commit rule: two consecutive direct QCs commit parent block.
//   3. Handle fallback timeout path when primary fails or delays proposals.

pub type JolteonBlock = struct {
    view: Int,
    block_hash: String,
    parent_hash: String,
    qc_view: Int,
    is_fallback: Bool
};

pub type JolteonCommitState = struct {
    view: Int,
    head_block_hash: String,
    parent_block_hash: String,
    is_committed: Bool
};

pub fn jolteon_check_2chain_commit(child_view: Int, parent_view: Int, is_consecutive: Bool) -> Bool {
    // 2-chain rule requires consecutive direct views: child_view == parent_view + 1
    return is_consecutive && (child_view == parent_view + 1);
}

pub fn jolteon_evaluate_commit(child: JolteonBlock, parent: JolteonBlock) -> JolteonCommitState {
    let consecutive: Bool = (child).view == (parent).view + 1;
    let direct_parent: Bool = (child).parent_hash == (parent).block_hash;
    let committed: Bool = consecutive && direct_parent;
    return JolteonCommitState {
        view: (child).view,
        head_block_hash: (child).block_hash,
        parent_block_hash: (parent).block_hash,
        is_committed: committed
    };
}

pub fn jolteon_is_fallback_needed(timeout_elapsed_ms: Int, max_allowed_ms: Int) -> Bool {
    return timeout_elapsed_ms > max_allowed_ms;
}
