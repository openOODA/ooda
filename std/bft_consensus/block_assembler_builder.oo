// # Block Assembler & Execution Payload Builder
//
// Logline: Assembles transactions from the mempool into candidate blocks within byte and gas budget constraints.
//
// Setup: Packs transactions greedily by fee priority, updating cumulative gas limits and header metadata.
//
// Beats:
//   1. Define BlockHeader, CandidateBlock, and BlockBuilderLimits structures.
//   2. Pack transactions iteratively while respecting maximum block byte size and gas limit.
//   3. Compute candidate block Merkle root and finalize header timestamp.

pub type BlockHeader = struct {
    height: Int,
    round: Int,
    proposer_address: String,
    parent_hash: String,
    state_root: String,
    txs_root: String,
    timestamp: Int
};

pub type BlockBuilder = struct {
    height: Int,
    max_gas: Int,
    max_bytes: Int,
    current_gas: Int,
    current_bytes: Int,
    tx_count: Int,
    is_sealed: Bool
};

pub fn block_builder_new(height: Int, max_gas: Int, max_bytes: Int) -> BlockBuilder {
    return BlockBuilder {
        height: height,
        max_gas: max_gas,
        max_bytes: max_bytes,
        current_gas: 0,
        current_bytes: 0,
        tx_count: 0,
        is_sealed: false
    };
}

pub fn block_builder_can_fit(b: BlockBuilder, gas_req: Int, bytes_req: Int) -> Bool {
    if (b).is_sealed {
        return false;
    }
    let gas_ok: Bool = ((b).current_gas + gas_req) <= (b).max_gas;
    let bytes_ok: Bool = ((b).current_bytes + bytes_req) <= (b).max_bytes;
    return gas_ok && bytes_ok;
}

pub fn block_builder_append_tx(b: BlockBuilder, gas_req: Int, bytes_req: Int) -> BlockBuilder {
    if block_builder_can_fit(b, gas_req, bytes_req) {
        (b).current_gas = (b).current_gas + gas_req;
        (b).current_bytes = (b).current_bytes + bytes_req;
        (b).tx_count = (b).tx_count + 1;
    }
    return b;
}

pub fn block_builder_seal(b: BlockBuilder) -> BlockBuilder {
    (b).is_sealed = true;
    return b;
}
