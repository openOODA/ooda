// # HotStuff Block Tree & Parent Pointer DAG
//
// Logline: Implements the HotStuff block tree structure with QC parent pointers, pruning, and height indexing.
//
// Setup: Maintains chained tree branches and identifies deepest certified blocks for proposal extension.
//
// Beats:
//   1. Define HotStuffBlock node and BlockTree container.
//   2. Insert verified blocks linked to parent hashes and Quorum Certificates.
//   3. Track the highest certified block and branch depths.

pub type HotStuffBlock = struct {
    block_hash: String,
    parent_hash: String,
    view: Int,
    height: Int,
    payload_hash: String,
    qc_view: Int,
    proposer_id: Int
};

pub type BlockTree = struct {
    root_hash: String,
    deepest_hash: String,
    deepest_height: Int,
    total_blocks: Int,
    pruned_height: Int
};

pub fn block_tree_new(genesis_hash: String) -> BlockTree {
    return BlockTree {
        root_hash: genesis_hash,
        deepest_hash: genesis_hash,
        deepest_height: 0,
        total_blocks: 1,
        pruned_height: 0
    };
}

pub fn block_tree_add_block(tree: BlockTree, block: HotStuffBlock) -> BlockTree {
    (tree).total_blocks = (tree).total_blocks + 1;
    if (block).height > (tree).deepest_height {
        (tree).deepest_height = (block).height;
        (tree).deepest_hash = (block).block_hash;
    }
    return tree;
}

pub fn block_tree_prune(tree: BlockTree, committed_height: Int) -> BlockTree {
    if committed_height > (tree).pruned_height {
        (tree).pruned_height = committed_height;
    }
    return tree;
}

pub fn block_is_direct_descendant(child: HotStuffBlock, parent_hash: String) -> Bool {
    return (child).parent_hash == parent_hash;
}
