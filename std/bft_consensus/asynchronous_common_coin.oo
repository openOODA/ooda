// # Asynchronous Common Coin Protocol
//
// Logline: Implements dual-threshold asynchronous common coin (Canetti-Rabin / Cachin-Kursawe-Petzold) for randomized BFT consensus.
//
// Setup: Generates unpredictable common coin values (0 or 1) in purely asynchronous networks to break the FLP impossibility result.
//
// Beats:
//   1. Define CoinShare, CommonCoinSession, and CoinOutcome structures.
//   2. Collect f+1 signature shares on round/epoch coin tag.
//   3. Compute aggregate coin parity bit (0 or 1) once threshold shares are combined.

pub type CoinShare = struct {
    round: Int,
    node_id: Int,
    share_hash: String,
    is_valid: Bool
};

pub type CommonCoinSession = struct {
    round: Int,
    threshold: Int,
    shares_count: Int,
    coin_accumulator: Int,
    is_revealed: Bool
};

pub fn common_coin_session_new(round: Int, total_nodes: Int) -> CommonCoinSession {
    let f: Int = (total_nodes - 1) / 3;
    let threshold: Int = f + 1;
    return CommonCoinSession {
        round: round,
        threshold: threshold,
        shares_count: 0,
        coin_accumulator: 0,
        is_revealed: false
    };
}

pub fn common_coin_add_share(session: CommonCoinSession, share: CoinShare, share_value: Int) -> CommonCoinSession {
    if !(share).is_valid || (share).round != (session).round {
        return session;
    }
    (session).shares_count = (session).shares_count + 1;
    (session).coin_accumulator = (session).coin_accumulator + share_value;
    if (session).shares_count >= (session).threshold {
        (session).is_revealed = true;
    }
    return session;
}

pub fn common_coin_get_bit(session: CommonCoinSession) -> Int {
    if !(session).is_revealed {
        return -1;
    }
    let acc: Int = (session).coin_accumulator;
    if acc < 0 {
        return (-acc) % 2;
    }
    return acc % 2;
}
