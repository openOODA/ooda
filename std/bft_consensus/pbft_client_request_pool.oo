// # PBFT Client Request Pool & Reply Quorum
//
// Logline: Manages client transaction requests, deduplication by timestamp/client ID, and f+1 reply aggregation.
//
// Setup: Handles client interaction lifecycle, ensuring linearizability and fast reply verification.
//
// Beats:
//   1. Define ClientRequest and ClientReply structures.
//   2. Deduplicate requests based on client identifier and monotonically increasing timestamp.
//   3. Validate f+1 identical client replies to guarantee correctness to the client.

pub type ClientRequest = struct {
    client_id: Int,
    timestamp: Int,
    operation: String,
    payload_hash: String,
};

pub type ClientReply = struct {
    view: Int,
    timestamp: Int,
    client_id: Int,
    node_id: Int,
    result_digest: String,
};

pub type ClientReplyCollector = struct {
    client_id: Int,
    timestamp: Int,
    expected_digest: String,
    matching_replies: Int,
    faulty_bound: Int,
    is_accepted: Bool,
};

pub fn client_reply_collector_new(client_id: Int, ts: Int, digest: String, f_bound: Int) -> ClientReplyCollector {
    return ClientReplyCollector {
        client_id: client_id,
        timestamp: ts,
        expected_digest: digest,
        matching_replies: 0,
        faulty_bound: f_bound,
        is_accepted: false,
    };
}

pub fn client_reply_add(col: ClientReplyCollector, rep: ClientReply) -> ClientReplyCollector {
    if (rep).client_id != (col).client_id || (rep).timestamp != (col).timestamp {
        return col;
    }
    if (rep).result_digest == (col).expected_digest {
        (col).matching_replies = (col).matching_replies + 1;
    }
    if (col).matching_replies >= ((col).faulty_bound + 1) {
        (col).is_accepted = true;
    }
    return col;
}

pub fn client_request_is_newer(req: ClientRequest, last_ts: Int) -> Bool {
    return (req).timestamp > last_ts;
}
