// # Consensus Safety & Liveness Invariant Monitor
//
// Logline: Formally verifies fundamental BFT invariants: Agreement (no two distinct commits at height H) and Liveness (progress after GST).
//
// Setup: Fail-closed invariant verification layer running continuously alongside the consensus engine.
//
// Beats:
//   1. Define CommittedHeightRecord and InvariantViolationReport structures.
//   2. Verify Agreement invariant: block hashes committed at identical height must match identically.
//   3. Verify Monotonicity invariant: committed heights must be strictly increasing.

pub type CommittedHeightRecord = struct {
    height: Int,
    block_hash: String,
    state_root: String,
    round: Int,
};

pub type InvariantViolationReport = struct {
    violation_code: Int, // 0: None, 1: DoubleCommit, 2: HeightRegression, 3: InvalidQC
    height: Int,
    description: String,
    is_violated: Bool,
};

pub fn invariant_report_ok() -> InvariantViolationReport {
    return InvariantViolationReport {
        violation_code: 0,
        height: 0,
        description: "All consensus invariants hold",
        is_violated: false,
    };
}

pub fn invariant_check_agreement(rec_a: CommittedHeightRecord, rec_b: CommittedHeightRecord) -> InvariantViolationReport {
    if (rec_a).height == (rec_b).height {
        if (rec_a).block_hash != (rec_b).block_hash {
            return InvariantViolationReport {
                violation_code: 1,
                height: (rec_a).height,
                description: "CRITICAL: Conflicting blocks committed at same height (Safety Violated!)",
                is_violated: true,
            };
        }
    }
    return invariant_report_ok();
}

pub fn invariant_check_height_monotonicity(prev_height: Int, next_height: Int) -> InvariantViolationReport {
    if next_height <= prev_height {
        return InvariantViolationReport {
            violation_code: 2,
            height: next_height,
            description: "CRITICAL: Non-increasing committed height sequence",
            is_violated: true,
        };
    }
    return invariant_report_ok();
}
