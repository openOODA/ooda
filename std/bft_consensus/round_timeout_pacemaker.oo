// # Adaptive Round Timeout & GST Pacemaker
//
// Logline: Implements adaptive exponential backoff timers and post-GST (Global Stabilization Time) delta adjustment.
//
// Setup: Adjusts round duration dynamically based on round completion latencies and consecutive missed proposals.
//
// Beats:
//   1. Define AdaptivePacemakerConfig and PacemakerTimerState structures.
//   2. Increase timeout exponentially on consecutive round failures (delta * 2^k).
//   3. Reset timeout to baseline delta upon successful block commitment.

pub type PacemakerTimerState = struct {
    current_round: Int,
    base_delta_ms: Int,
    current_timeout_ms: Int,
    consecutive_timeouts: Int,
    max_timeout_ms: Int,
    gst_reached: Bool
};

pub fn pacemaker_timer_state_new(base_delta: Int, max_delta: Int) -> PacemakerTimerState {
    return PacemakerTimerState {
        current_round: 1,
        base_delta_ms: base_delta,
        current_timeout_ms: base_delta,
        consecutive_timeouts: 0,
        max_timeout_ms: max_delta,
        gst_reached: false
    };
}

pub fn pacemaker_on_round_timeout(state: PacemakerTimerState) -> PacemakerTimerState {
    (state).current_round = (state).current_round + 1;
    (state).consecutive_timeouts = (state).consecutive_timeouts + 1;
    let mut next_timeout: Int = (state).current_timeout_ms * 2;
    if next_timeout > (state).max_timeout_ms {
        next_timeout = (state).max_timeout_ms;
    }
    (state).current_timeout_ms = next_timeout;
    return state;
}

pub fn pacemaker_on_block_committed(state: PacemakerTimerState, new_round: Int) -> PacemakerTimerState {
    (state).current_round = new_round;
    (state).consecutive_timeouts = 0;
    (state).current_timeout_ms = (state).base_delta_ms;
    return state;
}

pub fn pacemaker_mark_gst(state: PacemakerTimerState) -> PacemakerTimerState {
    (state).gst_reached = true;
    return state;
}
