// # Tendermint ABCI++ Application Interface
//
// Logline: Implements ABCI++ consensus-application boundaries: PrepareProposal, ProcessProposal, ExtendVote, and FinalizeBlock.
//
// Setup: Pure message structures and handlers bridging consensus engine with state machine execution.
//
// Beats:
//   1. Define ABCI request and response envelope structures.
//   2. Validate application proposal acceptance status.
//   3. Commit state root updates upon FinalizeBlock response.

pub type AbciPrepareProposal = struct {
    height: Int,
    max_tx_bytes: Int,
    proposer_address: String
};

pub type AbciProcessProposal = struct {
    height: Int,
    block_hash: String,
    tx_count: Int
};

pub type AbciProcessProposalResponse = struct {
    is_accepted: Bool,
    status_code: Int
};

pub type AbciFinalizeBlockResponse = struct {
    state_root: String,
    retain_height: Int,
    status_code: Int
};

pub fn abci_process_proposal_accept() -> AbciProcessProposalResponse {
    return AbciProcessProposalResponse {
        is_accepted: true,
        status_code: 0
    };
}

pub fn abci_process_proposal_reject(code: Int) -> AbciProcessProposalResponse {
    return AbciProcessProposalResponse {
        is_accepted: false,
        status_code: code
    };
}

pub fn abci_finalize_block_new(root: String, retain: Int) -> AbciFinalizeBlockResponse {
    return AbciFinalizeBlockResponse {
        state_root: root,
        retain_height: retain,
        status_code: 0
    };
}
