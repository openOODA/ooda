// # Network Partition Simulator & Split-Brain Tester
//
// Logline: Simulates asymmetric network partitions, message latency jitter, and quorum isolation between validator groups.
//
// Setup: Validates that consensus halts safely during partition without violating safety invariants.
//
// Beats:
//   1. Define PartitionMatrix, PartitionGroup, and MessageRoutingResult structures.
//   2. Check bidirectional reachability between sender and recipient validator groups.
//   3. Compute quorum availability in isolated partition components.

pub type PartitionGroup = struct {
    group_id: Int,
    member_count: Int,
    voting_power: Int,
    total_network_power: Int
};

pub fn partition_group_new(gid: Int, members: Int, power: Int, total_power: Int) -> PartitionGroup {
    return PartitionGroup {
        group_id: gid,
        member_count: members,
        voting_power: power,
        total_network_power: total_power
    };
}

pub fn partition_group_has_quorum(grp: PartitionGroup) -> Bool {
    let threshold: Int = (2 * (grp).total_network_power / 3) + 1;
    return (grp).voting_power >= threshold;
}

pub fn partition_can_communicate(sender_grp: Int, receiver_grp: Int, is_partition_active: Bool) -> Bool {
    if !is_partition_active {
        return true;
    }
    return sender_grp == receiver_grp;
}
