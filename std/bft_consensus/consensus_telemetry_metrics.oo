// # Consensus Telemetry & Prometheus Metric Gauges
//
// Logline: Aggregates real-time Prometheus-style consensus telemetry: committed height, round durations, and vote aggregation latencies.
//
// Setup: Low-overhead metric collectors for live validator observability and automated alerting.
//
// Beats:
//   1. Define ConsensusMetricsGauge and MetricHistogram structures.
//   2. Record height progressions, round abort counters, and vote quorum latencies.
//   3. Compute average block production time and throughput metrics.

pub type ConsensusMetrics = struct {
    current_committed_height: Int,
    current_view_round: Int,
    total_blocks_committed: Int,
    total_rounds_failed: Int,
    last_block_duration_ms: Int,
    cumulative_duration_ms: Int,
};

pub fn consensus_metrics_new() -> ConsensusMetrics {
    return ConsensusMetrics {
        current_committed_height: 0,
        current_view_round: 1,
        total_blocks_committed: 0,
        total_rounds_failed: 0,
        last_block_duration_ms: 0,
        cumulative_duration_ms: 0,
    };
}

pub fn consensus_metrics_record_commit(m: ConsensusMetrics, height: Int, duration_ms: Int) -> ConsensusMetrics {
    (m).current_committed_height = height;
    (m).total_blocks_committed = (m).total_blocks_committed + 1;
    (m).last_block_duration_ms = duration_ms;
    (m).cumulative_duration_ms = (m).cumulative_duration_ms + duration_ms;
    return m;
}

pub fn consensus_metrics_record_round_fail(m: ConsensusMetrics) -> ConsensusMetrics {
    (m).total_rounds_failed = (m).total_rounds_failed + 1;
    return m;
}

pub fn consensus_metrics_average_block_ms(m: ConsensusMetrics) -> Int {
    if (m).total_blocks_committed <= 0 {
        return 0;
    }
    return (m).cumulative_duration_ms / (m).total_blocks_committed;
}
