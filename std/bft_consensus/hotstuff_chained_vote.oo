// # HotStuff Chained Voting Protocol
//
// Logline: Implements chained vote generation, vote aggregation accumulators, and vote signature validation.
//
// Setup: Single message type serving as Prepare, PreCommit, and Commit votes depending on chain depth.
//
// Beats:
//   1. Define ChainedVote and VoteAccumulator structures.
//   2. Verify vote consistency with proposal block hash and parent QC.
//   3. Accumulate votes until reaching quorum threshold to mint new QC.

pub type ChainedVote = struct {
    view: Int,
    block_hash: String,
    parent_qc_view: Int,
    voter_id: Int,
    signature: String,
};

pub type VoteAccumulator = struct {
    view: Int,
    block_hash: String,
    vote_count: Int,
    required_quorum: Int,
    qc_formed: Bool,
};

pub fn vote_accumulator_new(view: Int, block_hash: String, total_nodes: Int) -> VoteAccumulator {
    let f: Int = (total_nodes - 1) / 3;
    let threshold: Int = 2 * f + 1;
    return VoteAccumulator {
        view: view,
        block_hash: block_hash,
        vote_count: 0,
        required_quorum: threshold,
        qc_formed: false,
    };
}

pub fn vote_accumulator_add(acc: VoteAccumulator, vote: ChainedVote) -> VoteAccumulator {
    if (vote).view != (acc).view {
        return acc;
    }
    if (vote).block_hash.contains((acc).block_hash) == false {
        return acc;
    }
    if (acc).block_hash.contains((vote).block_hash) == false {
        return acc;
    }
    (acc).vote_count = (acc).vote_count + 1;
    if (acc).vote_count >= (acc).required_quorum {
        (acc).qc_formed = true;
    }
    return acc;
}

pub fn vote_is_valid_format(vote: ChainedVote) -> Bool {
    return ((vote).view > 0) && ((vote).voter_id >= 0);
}
