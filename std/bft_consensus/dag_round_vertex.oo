// # DAG-BFT Round Vertex & Parent Edge Validation
//
// Logline: Defines DAG consensus vertices with round numbers, author IDs, payload digests, and strong parent edge references.
//
// Setup: Foundational data structure for Narwhal, Tusk, and Bullshark DAG-based Byzantine consensus protocols.
//
// Beats:
//   1. Define DagVertex, VertexHeader, and StrongParentEdge structures.
//   2. Validate that a vertex connects to at least 2f+1 distinct parent vertices from the preceding round.
//   3. Compute vertex digest and verify round causal monotonicity.

type DagVertex = struct {
    round: Int,
    author_id: Int,
    payload_digest: String,
    parent_count: Int,
    vertex_hash: String,
    is_certified: Bool
};

pub fn dag_vertex_new(round: Int, author: Int, payload: String, parent_count: Int, vhash: String) -> DagVertex {
    return DagVertex {
        round: round,
        author_id: author,
        payload_digest: payload,
        parent_count: parent_count,
        vertex_hash: vhash,
        is_certified: false
    };
}

pub fn dag_vertex_has_sufficient_parents(vertex: DagVertex, total_nodes: Int) -> Bool {
    let f: Int = (total_nodes - 1) / 3;
    let min_parents: Int = 2 * f + 1;
    let pc: Int = vertex.parent_count;
    return pc >= min_parents;
}

pub fn dag_vertex_is_monotonic_child(child_round: Int, parent_round: Int) -> Bool {
    return child_round == parent_round + 1;
}
