// # Mempool Priority Queue & Gas Price Ordering
//
// Logline: Implements fee-priority mempool transaction management with per-account nonce tracking and memory eviction policies.
//
// Setup: Orders pending transactions by gas price while enforcing strict sequential nonce constraints per sender.
//
// Beats:
//   1. Define MempoolTransaction, AccountNonceTracker, and MempoolCapacity structures.
//   2. Insert transactions respecting gas price priority order.
//   3. Evict lowest fee transactions when pool exceeds memory capacity thresholds.

pub type MempoolTx = struct {
    tx_hash: String,
    sender: String,
    nonce: Int,
    gas_price: Int,
    size_bytes: Int,
};

pub type MempoolQueue = struct {
    total_txs: Int,
    total_bytes: Int,
    max_bytes: Int,
    min_gas_price: Int,
};

pub fn mempool_queue_new(max_bytes: Int, min_price: Int) -> MempoolQueue {
    return MempoolQueue {
        total_txs: 0,
        total_bytes: 0,
        max_bytes: max_bytes,
        min_gas_price: min_price,
    };
}

pub fn mempool_can_accept(queue: MempoolQueue, tx: MempoolTx) -> Bool {
    if (tx).gas_price < (queue).min_gas_price {
        return false;
    }
    if ((queue).total_bytes + (tx).size_bytes) > (queue).max_bytes {
        return false;
    }
    return true;
}

pub fn mempool_add_tx(queue: MempoolQueue, tx: MempoolTx) -> MempoolQueue {
    if mempool_can_accept(queue, tx) {
        (queue).total_txs = (queue).total_txs + 1;
        (queue).total_bytes = (queue).total_bytes + (tx).size_bytes;
    }
    return queue;
}

pub fn mempool_remove_tx(queue: MempoolQueue, tx: MempoolTx) -> MempoolQueue {
    if (queue).total_txs > 0 {
        (queue).total_txs = (queue).total_txs - 1;
        (queue).total_bytes = (queue).total_bytes - (tx).size_bytes;
        if (queue).total_bytes < 0 {
            (queue).total_bytes = 0;
        }
    }
    return queue;
}
