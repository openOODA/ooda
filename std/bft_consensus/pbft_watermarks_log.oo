// # PBFT Watermarks & Sliding Log Window
//
// Logline: Manages low and high sequence watermarks (h, H) and sliding execution log garbage collection.
//
// Setup: Prevents sequence number overflow and memory exhaustion by enforcing window boundaries [h, h + L].
//
// Beats:
//   1. Define WatermarkWindow structure and window state parameters.
//   2. Check whether sequence numbers fall within valid sliding bounds.
//   3. Advance low watermark upon stable checkpoint confirmation and prune expired log slots.

pub type WatermarkWindow = struct {
    low_watermark: Int,
    window_size: Int,
    high_watermark: Int,
    last_executed_seq: Int
};

pub fn watermark_window_new(low_h: Int, log_window_size: Int) -> WatermarkWindow {
    return WatermarkWindow {
        low_watermark: low_h,
        window_size: log_window_size,
        high_watermark: low_h + log_window_size,
        last_executed_seq: low_h
    };
}

pub fn watermark_is_in_window(win: WatermarkWindow, seq: Int) -> Bool {
    return (seq > (win).low_watermark) && (seq <= (win).high_watermark);
}

pub fn watermark_advance_checkpoint(win: WatermarkWindow, stable_cp: Int) -> WatermarkWindow {
    if stable_cp > (win).low_watermark {
        (win).low_watermark = stable_cp;
        (win).high_watermark = stable_cp + (win).window_size;
    }
    return win;
}

pub fn watermark_update_executed(win: WatermarkWindow, seq: Int) -> WatermarkWindow {
    if seq > (win).last_executed_seq {
        (win).last_executed_seq = seq;
    }
    return win;
}

pub fn watermark_lag_behind(win: WatermarkWindow) -> Int {
    return (win).high_watermark - (win).last_executed_seq;
}
