// # State Sync Peer Scheduler & Worker Queue
//
// Logline: Schedules state sync chunk requests across available network peers with latency scoring and timeout retry queues.
//
// Setup: Maximizes sync bandwidth by parallelizing requests and blacklisting unresponsive or Byzantine peers.
//
// Beats:
//   1. Define SyncPeer, ChunkRequest, and PeerSchedulerQueue structures.
//   2. Assign chunk fetch tasks to top-ranked peers based on latency and success history.
//   3. Re-queue failed or timed-out requests to alternative candidate peers.

pub type SyncPeer = struct {
    peer_id: Int,
    latency_ms: Int,
    successful_chunks: Int,
    failed_chunks: Int,
    is_banned: Bool,
};

pub type PeerScheduler = struct {
    active_peers_count: Int,
    pending_requests_count: Int,
    completed_requests_count: Int,
};

pub fn peer_scheduler_new(peers_count: Int) -> PeerScheduler {
    return PeerScheduler {
        active_peers_count: peers_count,
        pending_requests_count: 0,
        completed_requests_count: 0,
    };
}

pub fn sync_peer_new(id: Int, latency: Int) -> SyncPeer {
    return SyncPeer {
        peer_id: id,
        latency_ms: latency,
        successful_chunks: 0,
        failed_chunks: 0,
        is_banned: false,
    };
}

pub fn sync_peer_record_success(peer: SyncPeer) -> SyncPeer {
    (peer).successful_chunks = (peer).successful_chunks + 1;
    return peer;
}

pub fn sync_peer_record_failure(peer: SyncPeer, max_fails: Int) -> SyncPeer {
    (peer).failed_chunks = (peer).failed_chunks + 1;
    if (peer).failed_chunks >= max_fails {
        (peer).is_banned = true;
    }
    return peer;
}
