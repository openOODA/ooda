// # Light Client Header Sync & Bisection Verifier
//
// Logline: Implements Tendermint/HotStuff light client verification, trusting period validation, and bisection header proofs.
//
// Setup: Validates consensus block headers with minimal bandwidth by skipping intermediate headers when validator sets overlap.
//
// Beats:
//   1. Define LightHeader, TrustLevel, and LightClientState structures.
//   2. Verify that trusted validator set voting power exceeds 1/3 overlap threshold within trusting period.
//   3. Perform bisection recursion when validator set changes exceed single-hop verification thresholds.

pub type LightHeader = struct {
    height: Int,
    block_hash: String,
    validators_hash: String,
    timestamp: Int,
    is_trusted: Bool,
};

pub type LightClientState = struct {
    trusted_height: Int,
    trusted_header_hash: String,
    trusting_period_seconds: Int,
    trust_level_numerator: Int,
    trust_level_denominator: Int,
};

pub fn light_client_state_new(h: Int, h_hash: String, period_sec: Int) -> LightClientState {
    return LightClientState {
        trusted_height: h,
        trusted_header_hash: h_hash,
        trusting_period_seconds: period_sec,
        trust_level_numerator: 1,
        trust_level_denominator: 3,
    };
}

pub fn light_client_is_within_trust_period(state: LightClientState, current_time: Int, header_time: Int) -> Bool {
    let elapsed: Int = current_time - header_time;
    return (elapsed >= 0) && (elapsed < (state).trusting_period_seconds);
}

pub fn light_client_check_voting_power_overlap(voting_power_overlap: Int, total_power: Int) -> Bool {
    // Requires at least 1/3 overlap: overlap * 3 > total_power
    return (voting_power_overlap * 3) > total_power;
}

pub fn light_client_update_trusted(state: LightClientState, new_header: LightHeader) -> LightClientState {
    (state).trusted_height = (new_header).height;
    (state).trusted_header_hash = (new_header).block_hash;
    return state;
}
