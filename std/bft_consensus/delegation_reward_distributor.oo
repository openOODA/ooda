// # Consensus Delegation Rewards & Commission Distributor
//
// Logline: Calculates pro-rata block rewards, proposer bonuses, validator commission cuts, and delegator payout distributions.
//
// Setup: Pure economic distribution module rewarding consensus participation and high uptime.
//
// Beats:
//   1. Define BlockRewardPool, ValidatorCommission, and DelegatorPayout structures.
//   2. Deduct validator commission rate from total block proposal reward.
//   3. Distribute remaining net rewards proportionally across delegator stake shares.

pub type BlockRewardPool = struct {
    height: Int,
    total_reward_tokens: Int,
    proposer_bonus_rate_percent: Int,
    proposer_address: String
};

pub type RewardDistribution = struct {
    proposer_reward: Int,
    commission_reward: Int,
    pool_for_delegators: Int
};

pub fn reward_distribution_calculate(pool: BlockRewardPool, commission_percent: Int) -> RewardDistribution {
    let bonus: Int = ((pool).total_reward_tokens * (pool).proposer_bonus_rate_percent) / 100;
    let remainder: Int = (pool).total_reward_tokens - bonus;
    let comm: Int = (remainder * commission_percent) / 100;
    let delegator_share: Int = remainder - comm;
    return RewardDistribution {
        proposer_reward: bonus,
        commission_reward: comm,
        pool_for_delegators: delegator_share
    };
}

pub fn compute_delegator_share(delegator_stake: Int, total_val_stake: Int, pool_amount: Int) -> Int {
    if total_val_stake <= 0 {
        return 0;
    }
    return (pool_amount * delegator_stake) / total_val_stake;
}
