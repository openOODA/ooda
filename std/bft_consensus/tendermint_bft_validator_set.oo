// # Tendermint Validator Set & Proposer Selection
//
// Logline: Implements Tendermint weighted validator sets, 2/3+ voting power calculations, and deterministic proposer election.
//
// Setup: Deterministic round-robin priority accumulation algorithm selecting block proposers weighted by stake.
//
// Beats:
//   1. Define Validator and ValidatorSet structures.
//   2. Calculate total voting power and 2/3+ quorum thresholds.
//   3. Execute deterministic proposer selection algorithm via priority increment/decrement.

pub type TendermintValidator = struct {
    address: String,
    voting_power: Int,
    proposer_priority: Int,
    is_active: Bool,
};

pub type TendermintValidatorSet = struct {
    total_voting_power: Int,
    validator_count: Int,
    threshold_2_3: Int,
};

pub fn tendermint_validator_new(addr: String, power: Int) -> TendermintValidator {
    return TendermintValidator {
        address: addr,
        voting_power: power,
        proposer_priority: 0,
        is_active: true,
    };
}

pub fn tendermint_validator_set_new(total_power: Int, count: Int) -> TendermintValidatorSet {
    // 2/3+ threshold: 2 * total / 3 + 1
    let threshold: Int = (2 * total_power / 3) + 1;
    return TendermintValidatorSet {
        total_voting_power: total_power,
        validator_count: count,
        threshold_2_3: threshold,
    };
}

pub fn tendermint_has_two_thirds_majority(power_accumulated: Int, vset: TendermintValidatorSet) -> Bool {
    return power_accumulated >= (vset).threshold_2_3;
}

pub fn tendermint_update_priority(val: TendermintValidator, total_power: Int, is_chosen: Bool) -> TendermintValidator {
    if is_chosen {
        (val).proposer_priority = (val).proposer_priority + (val).voting_power - total_power;
    } else {
        (val).proposer_priority = (val).proposer_priority + (val).voting_power;
    }
    return val;
}
