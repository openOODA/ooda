pub fn bft_consensus_version() -> String {
    return "openOODA-BFT-Consensus-v2.0";
}

pub fn bft_create_pbft_commit_state(view: Int, seq: Int, dig: String, total: Int) -> PbftCommitState {
    return pbft_commit_state_new(view, seq, dig, total);
}

pub fn bft_create_hotstuff_tree(genesis_hash: String) -> BlockTree {
    return block_tree_new(genesis_hash);
}

pub fn bft_create_hotstuff_qc(view: Int, block_hash: String, step: Int, votes: Int) -> QuorumCertificate {
    return quorum_certificate_new(view, block_hash, step, votes);
}

pub fn bft_create_hotstuff_pacemaker(total_nodes: Int, timeout_ms: Int) -> PacemakerRound {
    return pacemaker_new(total_nodes, timeout_ms);
}

pub fn bft_create_tendermint_validator_set(total_power: Int, count: Int) -> TendermintValidatorSet {
    return tendermint_validator_set_new(total_power, count);
}

pub fn bft_create_tendermint_state_machine(height: Int, round: Int) -> ConsensusRoundState {
    return consensus_round_state_new(height, round);
}

pub fn bft_create_dag_vertex(round: Int, author: Int, payload: String, parents: Int, vhash: String) -> DagVertex {
    return dag_vertex_new(round, author, payload, parents, vhash);
}

pub fn bft_create_bls_aggregate(threshold: Int, msg_digest: String) -> BlsAggregateSignature {
    return bls_aggregate_new(threshold, msg_digest);
}

pub fn bft_create_policy() -> BftConsensusPolicy {
    return bft_consensus_policy_default();
}
