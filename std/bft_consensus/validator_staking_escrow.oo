// # Validator Staking Escrow & Bond Accounting
//
// Logline: Tracks staked balances, bonding periods, unbonding queues, and minimum active stake thresholds.
//
// Setup: Core economic accounting module governing consensus participation rights and slashing reserves.
//
// Beats:
//   1. Define ValidatorStake, UnbondingEntry, and StakingEscrow structures.
//   2. Process bond deposits and enforce minimum self-delegation thresholds.
//   3. Manage lockup durations and mature unbonding withdrawals.

pub type ValidatorStake = struct {
    validator_address: String,
    bonded_tokens: Int,
    unbonding_tokens: Int,
    minimum_threshold: Int,
    is_active: Bool
};

pub type StakingEscrow = struct {
    total_bonded: Int,
    total_unbonding: Int,
    active_validators_count: Int
};

pub fn staking_escrow_new() -> StakingEscrow {
    return StakingEscrow {
        total_bonded: 0,
        total_unbonding: 0,
        active_validators_count: 0
    };
}

pub fn validator_stake_new(addr: String, initial_bond: Int, min_req: Int) -> ValidatorStake {
    let active: Bool = initial_bond >= min_req;
    return ValidatorStake {
        validator_address: addr,
        bonded_tokens: initial_bond,
        unbonding_tokens: 0,
        minimum_threshold: min_req,
        is_active: active
    };
}

pub fn validator_stake_deposit(val: ValidatorStake, amount: Int) -> ValidatorStake {
    (val).bonded_tokens = (val).bonded_tokens + amount;
    if (val).bonded_tokens >= (val).minimum_threshold {
        (val).is_active = true;
    }
    return val;
}

pub fn validator_stake_start_unbonding(val: ValidatorStake, amount: Int) -> ValidatorStake {
    if amount <= (val).bonded_tokens {
        (val).bonded_tokens = (val).bonded_tokens - amount;
        (val).unbonding_tokens = (val).unbonding_tokens + amount;
        if (val).bonded_tokens < (val).minimum_threshold {
            (val).is_active = false;
        }
    }
    return val;
}
