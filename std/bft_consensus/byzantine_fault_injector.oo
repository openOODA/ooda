// # Byzantine Fault Injector & Adversarial Simulator
//
// Logline: Simulates adversarial Byzantine behavior patterns: equivocation, silent drops, invalid state roots, and stale round replay.
//
// Setup: Testing harness injecting controlled malicious behaviors to verify BFT consensus resilience.
//
// Beats:
//   1. Define FaultInjectionConfig and InjectedAction structures.
//   2. Configure malicious behaviors: double proposal, withheld votes, forged certificates.
//   3. Intercept outbound messages and mutate or drop based on fault policy.

pub type FaultInjectionConfig = struct {
    inject_equivocation: Bool,
    inject_silent_drop: Bool,
    inject_invalid_state_root: Bool,
    inject_delay_ms: Int,
    target_round: Int,
};

pub fn fault_injection_config_clean() -> FaultInjectionConfig {
    return FaultInjectionConfig {
        inject_equivocation: false,
        inject_silent_drop: false,
        inject_invalid_state_root: false,
        inject_delay_ms: 0,
        target_round: 0,
    };
}

pub fn fault_injection_config_malicious(round: Int) -> FaultInjectionConfig {
    return FaultInjectionConfig {
        inject_equivocation: true,
        inject_silent_drop: false,
        inject_invalid_state_root: true,
        inject_delay_ms: 500,
        target_round: round,
    };
}

pub fn fault_should_drop_message(cfg: FaultInjectionConfig, round: Int) -> Bool {
    return (cfg).inject_silent_drop && ((cfg).target_round == round);
}

pub fn fault_mutate_state_root(cfg: FaultInjectionConfig, original_root: String) -> String {
    if (cfg).inject_invalid_state_root {
        return "0x_corrupted_byzantine_state_root";
    }
    return original_root;
}
