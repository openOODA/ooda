// # Tendermint Consensus State Machine
//
// Logline: Coordinates Tendermint round steps: NewRound, Propose, Prevote, Precommit, and Commit.
//
// Setup: Strict step sequencing enforcing voting rules, timeout steps, and final block commitment.
//
// Beats:
//   1. Define TendermintStep constants and ConsensusRoundState structure.
//   2. Advance consensus round through Propose, Prevote, Precommit, and Commit phases.
//   3. Handle locked round tracking and valid round unlocking rules.

pub fn tendermint_step_new_round() -> Int { return 0; }
pub fn tendermint_step_propose() -> Int { return 1; }
pub fn tendermint_step_prevote() -> Int { return 2; }
pub fn tendermint_step_precommit() -> Int { return 3; }
pub fn tendermint_step_commit() -> Int { return 4; }

pub type ConsensusRoundState = struct {
    height: Int,
    round: Int,
    step: Int,
    locked_round: Int,
    locked_block_hash: String,
    valid_round: Int,
    valid_block_hash: String,
    is_committed: Bool,
};

pub fn consensus_round_state_new(height: Int, round: Int) -> ConsensusRoundState {
    return ConsensusRoundState {
        height: height,
        round: round,
        step: 0,
        locked_round: -1,
        locked_block_hash: "",
        valid_round: -1,
        valid_block_hash: "",
        is_committed: false,
    };
}

pub fn consensus_advance_step(state: ConsensusRoundState, next_step: Int) -> ConsensusRoundState {
    (state).step = next_step;
    if next_step == 4 {
        (state).is_committed = true;
    }
    return state;
}

pub fn consensus_lock_block(state: ConsensusRoundState, round: Int, block_hash: String) -> ConsensusRoundState {
    (state).locked_round = round;
    (state).locked_block_hash = block_hash;
    (state).valid_round = round;
    (state).valid_block_hash = block_hash;
    return state;
}

pub fn consensus_unlock_block(state: ConsensusRoundState) -> ConsensusRoundState {
    (state).locked_round = -1;
    (state).locked_block_hash = "";
    return state;
}
