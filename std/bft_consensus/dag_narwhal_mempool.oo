// # Narwhal Mempool Reliable Broadcast & Availability Certificates
//
// Logline: Implements Narwhal reliable batch broadcast, signature collection, and 2f+1 Availability Certificates (AC).
//
// Setup: Decouples high-throughput data availability dissemination from consensus ordering.
//
// Beats:
//   1. Define NarwhalBatch, BatchDigest, and AvailabilityCertificate structures.
//   2. Disseminate batch digests to validators and collect cryptographic signatures.
//   3. Assemble 2f+1 signed Availability Certificates for inclusion in round vertices.

pub type NarwhalBatch = struct {
    batch_id: String,
    author_id: Int,
    size_bytes: Int,
    tx_count: Int
};

pub type AvailabilityCertificate = struct {
    batch_id: String,
    round: Int,
    author_id: Int,
    signatures_count: Int,
    required_quorum: Int,
    is_available: Bool
};

pub fn availability_certificate_new(bid: String, round: Int, author: Int, total_nodes: Int) -> AvailabilityCertificate {
    let f: Int = (total_nodes - 1) / 3;
    let threshold: Int = 2 * f + 1;
    return AvailabilityCertificate {
        batch_id: bid,
        round: round,
        author_id: author,
        signatures_count: 0,
        required_quorum: threshold,
        is_available: false
    };
}

pub fn availability_certificate_add_signature(cert: AvailabilityCertificate) -> AvailabilityCertificate {
    (cert).signatures_count = (cert).signatures_count + 1;
    if (cert).signatures_count >= (cert).required_quorum {
        (cert).is_available = true;
    }
    return cert;
}

pub fn availability_certificate_is_valid(cert: AvailabilityCertificate) -> Bool {
    return (cert).is_available;
}
