// # PBFT View Change State Machine
//
// Logline: Implements PBFT view change triggering, ViewChange message aggregation, and NewView certificate construction.
//
// Setup: Pure protocol transition handling primary timeout, checkpoint proofs, and safe view advancement.
//
// Beats:
//   1. Define ViewChange and NewView protocol messages and vote registry.
//   2. Aggregate valid ViewChange messages to satisfy the 2f+1 threshold.
//   3. Produce canonical NewView message with verified stable checkpoint and prepared requests.

pub type ViewChangeMessage = struct {
    next_view: Int,
    sequence_number: Int,
    stable_checkpoint_seq: Int,
    checkpoint_digest: String,
    node_id: Int
};

pub type NewViewMessage = struct {
    next_view: Int,
    primary_id: Int,
    quorum_count: Int,
    stable_checkpoint_seq: Int,
    is_valid: Bool
};

pub type ViewChangeRegistry = struct {
    target_view: Int,
    total_nodes: Int,
    faulty_nodes: Int,
    received_count: Int,
    highest_stable_checkpoint: Int,
    is_view_change_complete: Bool
};

pub fn view_change_registry_new(target_view: Int, total_nodes: Int) -> ViewChangeRegistry {
    let f: Int = (total_nodes - 1) / 3;
    return ViewChangeRegistry {
        target_view: target_view,
        total_nodes: total_nodes,
        faulty_nodes: f,
        received_count: 0,
        highest_stable_checkpoint: 0,
        is_view_change_complete: false
    };
}

pub fn view_change_add_message(reg: ViewChangeRegistry, msg: ViewChangeMessage) -> ViewChangeRegistry {
    if (msg).next_view != (reg).target_view {
        return reg;
    }
    (reg).received_count = (reg).received_count + 1;
    if (msg).stable_checkpoint_seq > (reg).highest_stable_checkpoint {
        (reg).highest_stable_checkpoint = (msg).stable_checkpoint_seq;
    }
    let threshold: Int = 2 * (reg).faulty_nodes + 1;
    if (reg).received_count >= threshold {
        (reg).is_view_change_complete = true;
    }
    return reg;
}

pub fn view_change_create_new_view(reg: ViewChangeRegistry, new_primary_id: Int) -> NewViewMessage {
    let threshold: Int = 2 * (reg).faulty_nodes + 1;
    let valid: Bool = (reg).received_count >= threshold;
    return NewViewMessage {
        next_view: (reg).target_view,
        primary_id: new_primary_id,
        quorum_count: (reg).received_count,
        stable_checkpoint_seq: (reg).highest_stable_checkpoint,
        is_valid: valid
    };
}

pub fn view_change_elect_primary(view: Int, total_nodes: Int) -> Int {
    if total_nodes <= 0 {
        return 0;
    }
    return view % total_nodes;
}
