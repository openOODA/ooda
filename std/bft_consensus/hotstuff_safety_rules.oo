// # HotStuff Safety Rules & Locked QC Predicate
//
// Logline: Enforces HotStuff safety rules: the locked QC rule and the extend-from-parent rule.
//
// Setup: Guarantees that a correct node votes only when safety predicates are satisfied, preventing safety violations.
//
// Beats:
//   1. Define SafetyState containing locked QC and highest voted round.
//   2. Evaluate the HotStuff voting predicate: block extends locked QC or has higher view than locked QC.
//   3. Update locked QC and commit QC atomically upon observing valid proofs.

pub type SafetyState = struct {
    locked_qc_view: Int,
    locked_qc_hash: String,
    highest_voted_view: Int,
    node_id: Int,
};

pub fn safety_state_new(node_id: Int) -> SafetyState {
    return SafetyState {
        locked_qc_view: 0,
        locked_qc_hash: "0x_genesis",
        highest_voted_view: 0,
        node_id: node_id,
    };
}

pub fn safety_can_vote(state: SafetyState, proposal_view: Int, justify_qc_view: Int, justify_qc_hash: String) -> Bool {
    // Monotonicity check: must be strictly greater than highest voted view
    if proposal_view <= (state).highest_voted_view {
        return false;
    }
    // Safety rule: justify QC view > locked QC view OR justify QC block equals locked QC block
    let extends_locked: Bool = justify_qc_hash == (state).locked_qc_hash;
    let higher_view: Bool = justify_qc_view > (state).locked_qc_view;
    return extends_locked || higher_view;
}

pub fn safety_record_vote(state: SafetyState, voted_view: Int) -> SafetyState {
    if voted_view > (state).highest_voted_view {
        (state).highest_voted_view = voted_view;
    }
    return state;
}

pub fn safety_update_locked_qc(state: SafetyState, new_qc_view: Int, new_qc_hash: String) -> SafetyState {
    if new_qc_view > (state).locked_qc_view {
        (state).locked_qc_view = new_qc_view;
        (state).locked_qc_hash = new_qc_hash;
    }
    return state;
}
