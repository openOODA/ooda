// # Practical Byzantine Fault Tolerance (PBFT) Three-Phase Commit
//
// Logline: Implements the core PBFT three-phase commit protocol comprising Pre-Prepare, Prepare, and Commit message phases.
//
// Setup: Pure consensus state tracking message quorums, digest validation, and 2f+1 threshold certificates.
//
// Beats:
//   1. Define PBFT message types and commit state structures.
//   2. Validate pre-prepare proposal and verify matching prepare/commit message quorums.
//   3. Compute quorum certificate validity and commit eligibility.

pub type PbftPrePrepare = struct {
    view: Int,
    sequence_number: Int,
    digest: String,
    primary_id: Int,
};

pub type PbftPrepare = struct {
    view: Int,
    sequence_number: Int,
    digest: String,
    backup_id: Int,
};

pub type PbftCommit = struct {
    view: Int,
    sequence_number: Int,
    digest: String,
    node_id: Int,
};

pub type PbftCommitState = struct {
    view: Int,
    sequence_number: Int,
    digest: String,
    pre_prepared: Bool,
    prepare_count: Int,
    commit_count: Int,
    prepared: Bool,
    committed: Bool,
    total_nodes: Int,
    faulty_nodes: Int,
};

pub fn pbft_commit_state_new(view: Int, seq: Int, dig: String, total: Int) -> PbftCommitState {
    let f: Int = (total - 1) / 3;
    return PbftCommitState {
        view: view,
        sequence_number: seq,
        digest: dig,
        pre_prepared: false,
        prepare_count: 0,
        commit_count: 0,
        prepared: false,
        committed: false,
        total_nodes: total,
        faulty_nodes: f,
    };
}

pub fn pbft_quorum_threshold(total: Int) -> Int {
    let f: Int = (total - 1) / 3;
    return 2 * f + 1;
}

pub fn pbft_on_pre_prepare(state: PbftCommitState, msg: PbftPrePrepare) -> PbftCommitState {
    if (msg).view != (state).view || (msg).sequence_number != (state).sequence_number {
        return state;
    }
    (state).digest = (msg).digest;
    (state).pre_prepared = true;
    return state;
}

pub fn pbft_on_prepare(state: PbftCommitState, msg: PbftPrepare) -> PbftCommitState {
    if (msg).view != (state).view || (msg).sequence_number != (state).sequence_number {
        return state;
    }
    if (msg).digest != (state).digest {
        return state;
    }
    (state).prepare_count = (state).prepare_count + 1;
    let threshold: Int = pbft_quorum_threshold((state).total_nodes);
    if (state).pre_prepared && (state).prepare_count >= threshold {
        (state).prepared = true;
    }
    return state;
}

pub fn pbft_on_commit(state: PbftCommitState, msg: PbftCommit) -> PbftCommitState {
    if (msg).view != (state).view || (msg).sequence_number != (state).sequence_number {
        return state;
    }
    if (msg).digest != (state).digest {
        return state;
    }
    (state).commit_count = (state).commit_count + 1;
    let threshold: Int = pbft_quorum_threshold((state).total_nodes);
    if (state).prepared && (state).commit_count >= threshold {
        (state).committed = true;
    }
    return state;
}

pub fn pbft_is_committed(state: PbftCommitState) -> Bool {
    return (state).committed;
}
