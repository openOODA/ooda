// # Tendermint Block Part Sets & Merkle Chunk Verification
//
// Logline: Implements BlockPartSet chunking, Merkle root verification, and bitarray transmission tracking.
//
// Setup: Enables gossiping large blocks in small verifiable parts with independent Merkle proofs.
//
// Beats:
//   1. Define BlockPart, PartSetHeader, and BlockPartSet accumulator.
//   2. Verify individual block parts against PartSetHeader Merkle root.
//   3. Track received parts via bitmask and signal complete block assembly.

pub type PartSetHeader = struct {
    total_parts: Int,
    merkle_root: String
};

pub type BlockPart = struct {
    index: Int,
    bytes_data: String,
    merkle_proof: String
};

pub type BlockPartSet = struct {
    header: PartSetHeader,
    received_count: Int,
    is_complete: Bool
};

pub fn block_part_set_new(total_parts: Int, root_hash: String) -> BlockPartSet {
    return BlockPartSet {
        header: PartSetHeader {
            total_parts: total_parts,
            merkle_root: root_hash
        },
        received_count: 0,
        is_complete: false
    };
}

pub fn block_part_set_add_part(set: BlockPartSet, part: BlockPart) -> BlockPartSet {
    if (part).index < 0 || (part).index >= (set).header.total_parts {
        return set;
    }
    (set).received_count = (set).received_count + 1;
    if (set).received_count >= (set).header.total_parts {
        (set).is_complete = true;
    }
    return set;
}

pub fn block_part_set_is_complete(set: BlockPartSet) -> Bool {
    return (set).is_complete;
}
