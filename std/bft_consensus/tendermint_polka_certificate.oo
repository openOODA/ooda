// # Tendermint Polka Certificates & Lock-Round Updates
//
// Logline: Evaluates Polka certificates (2/3+ prevotes for a block or nil) and manages validator lock rounds.
//
// Setup: Prevents dual-proposal commits across rounds by proving 2/3+ network agreement on a proposal.
//
// Beats:
//   1. Define PolkaCertificate and PrevoteVote structures.
//   2. Accumulate prevote power for specific block hashes or nil.
//   3. Certify Polka threshold and determine lock / unlock state updates.

pub type PolkaCertificate = struct {
    height: Int,
    round: Int,
    block_hash: String,
    accumulated_power: Int,
    total_voting_power: Int,
    is_polka: Bool,
    is_nil_polka: Bool
};

pub fn polka_certificate_new(height: Int, round: Int, block_hash: String, total_power: Int) -> PolkaCertificate {
    let is_nil: Bool = block_hash == "nil" || block_hash == "";
    return PolkaCertificate {
        height: height,
        round: round,
        block_hash: block_hash,
        accumulated_power: 0,
        total_voting_power: total_power,
        is_polka: false,
        is_nil_polka: is_nil
    };
}

pub fn polka_certificate_add_power(cert: PolkaCertificate, power: Int) -> PolkaCertificate {
    (cert).accumulated_power = (cert).accumulated_power + power;
    let threshold: Int = (2 * (cert).total_voting_power / 3) + 1;
    if (cert).accumulated_power >= threshold {
        (cert).is_polka = true;
    }
    return cert;
}

pub fn polka_can_unlock(current_locked_round: Int, polka_round: Int) -> Bool {
    return polka_round > current_locked_round;
}
