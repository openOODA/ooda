// # P2P GossipSub Mesh Router & Peer Scoring
//
// Logline: Implements GossipSub topic mesh routing (Proposals, Votes, Blocks) with peer scoring and sybil attack mitigation.
//
// Setup: Maintains bounded degree overlay mesh (D_low, D, D_high) per consensus topic with behavioral penalization.
//
// Beats:
//   1. Define GossipTopicMesh, PeerScoreRecord, and GossipRouterState structures.
//   2. Graft and prune peers to keep mesh degree within optimal limits [D_low, D_high].
//   3. Update peer scores based on valid message delivery latency and invalid message penalties.

pub type PeerScoreRecord = struct {
    peer_id: Int,
    score: Int,
    valid_deliveries: Int,
    invalid_messages: Int,
    is_grafted: Bool
};

pub type GossipTopicMesh = struct {
    topic_name: String,
    d_target: Int,
    d_low: Int,
    d_high: Int,
    active_mesh_peers: Int
};

pub fn gossip_topic_mesh_new(topic: String, d_target: Int, d_low: Int, d_high: Int) -> GossipTopicMesh {
    return GossipTopicMesh {
        topic_name: topic,
        d_target: d_target,
        d_low: d_low,
        d_high: d_high,
        active_mesh_peers: 0
    };
}

pub fn peer_score_record_new(peer_id: Int) -> PeerScoreRecord {
    return PeerScoreRecord {
        peer_id: peer_id,
        score: 100,
        valid_deliveries: 0,
        invalid_messages: 0,
        is_grafted: true
    };
}

pub fn peer_score_on_valid_msg(rec: PeerScoreRecord) -> PeerScoreRecord {
    (rec).valid_deliveries = (rec).valid_deliveries + 1;
    (rec).score = (rec).score + 5;
    return rec;
}

pub fn peer_score_on_invalid_msg(rec: PeerScoreRecord) -> PeerScoreRecord {
    (rec).invalid_messages = (rec).invalid_messages + 1;
    (rec).score = (rec).score - 50;
    return rec;
}

pub fn gossip_mesh_needs_graft(mesh: GossipTopicMesh) -> Bool {
    return (mesh).active_mesh_peers < (mesh).d_low;
}

pub fn gossip_mesh_needs_prune(mesh: GossipTopicMesh) -> Bool {
    return (mesh).active_mesh_peers > (mesh).d_high;
}
