// # HotStuff Pipelined Pacemaker & Leader Rotation
//
// Logline: Coordinates round timeouts, leader rotation schedules, and Timeout Certificates (TC) for pipelined HotStuff.
//
// Setup: Ensures liveness across round transitions under partial synchrony by synchronizing pacemakers.
//
// Beats:
//   1. Define PacemakerRound, TimeoutMessage, and TimeoutCertificate structures.
//   2. Aggregate timeout messages to build high-view Timeout Certificates (TC).
//   3. Compute deterministic leader election and adaptive timeout deadlines.

pub type PacemakerRound = struct {
    current_round: Int,
    round_timeout_ms: Int,
    highest_qc_round: Int,
    highest_tc_round: Int,
    current_leader: Int,
    total_validators: Int,
};

pub type TimeoutMessage = struct {
    round: Int,
    validator_id: Int,
    high_qc_round: Int,
    signature: String,
};

pub type TimeoutCertificate = struct {
    round: Int,
    votes_count: Int,
    highest_qc_round: Int,
    is_valid: Bool,
};

pub fn pacemaker_new(total_nodes: Int, base_timeout_ms: Int) -> PacemakerRound {
    return PacemakerRound {
        current_round: 1,
        round_timeout_ms: base_timeout_ms,
        highest_qc_round: 0,
        highest_tc_round: 0,
        current_leader: 0,
        total_validators: total_nodes,
    };
}

pub fn pacemaker_get_leader(round_num: Int, total_nodes: Int) -> Int {
    if total_nodes <= 0 {
        return 0;
    }
    return round_num % total_nodes;
}

pub fn pacemaker_advance_round(pm: PacemakerRound, new_round: Int) -> PacemakerRound {
    if new_round > (pm).current_round {
        (pm).current_round = new_round;
        (pm).current_leader = pacemaker_get_leader(new_round, (pm).total_validators);
    }
    return pm;
}

pub fn pacemaker_create_tc(round: Int, count: Int, total_nodes: Int, high_qc: Int) -> TimeoutCertificate {
    let f: Int = (total_nodes - 1) / 3;
    let threshold: Int = 2 * f + 1;
    let valid: Bool = count >= threshold;
    return TimeoutCertificate {
        round: round,
        votes_count: count,
        highest_qc_round: high_qc,
        is_valid: valid,
    };
}

pub fn pacemaker_backoff_timeout(base_ms: Int, consecutive_timeouts: Int) -> Int {
    let mut timeout: Int = base_ms;
    let mut i: Int = 0;
    while i < consecutive_timeouts {
        if timeout < 60000 {
            timeout = timeout * 2;
        }
        i = i + 1;
    }
    return timeout;
}
