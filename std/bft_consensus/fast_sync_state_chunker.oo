// # Fast Sync State Chunker & Merkle Leaf Range Prover
//
// Logline: Chunks state Merkle tries into verifiable range slices for parallel fast synchronization.
//
// Setup: Allows lagging consensus nodes to quickly catch up to state root without executing every historical block.
//
// Beats:
//   1. Define StateChunk, StateChunkProof, and ChunkerSession structures.
//   2. Partition state keyspace into bounded chunk indices with leaf inclusion proofs.
//   3. Validate state chunk root matches certified consensus state root.

pub type StateChunk = struct {
    chunk_index: Int,
    total_chunks: Int,
    leaf_count: Int,
    chunk_root: String,
    is_verified: Bool
};

pub type ChunkerSession = struct {
    target_height: Int,
    target_state_root: String,
    total_chunks: Int,
    downloaded_chunks: Int,
    is_sync_complete: Bool
};

pub fn chunker_session_new(height: Int, state_root: String, total_chunks: Int) -> ChunkerSession {
    return ChunkerSession {
        target_height: height,
        target_state_root: state_root,
        total_chunks: total_chunks,
        downloaded_chunks: 0,
        is_sync_complete: false
    };
}

pub fn chunker_session_add_chunk(session: ChunkerSession, chunk: StateChunk) -> ChunkerSession {
    if !(chunk).is_verified {
        return session;
    }
    (session).downloaded_chunks = (session).downloaded_chunks + 1;
    if (session).downloaded_chunks >= (session).total_chunks {
        (session).is_sync_complete = true;
    }
    return session;
}

pub fn chunker_session_is_complete(session: ChunkerSession) -> Bool {
    return (session).is_sync_complete;
}
