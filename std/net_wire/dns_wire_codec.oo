// # RFC 1035 DNS wire names
//
// Logline: Parses DNS labels and compression pointers with a jump cap of 16 to stop loops.
//
// Setup: Pure. Bytes are List[Int] 0..255. Pointers have high bits 11. More than 16 jumps is Err.
//
// Beats:
//   1. Walk length-prefixed labels.
//   2. Follow a 14-bit compression pointer.
//   3. Count jumps and stop at 16.
//   4. Reject a truncated name or a loop.

pub type DnsOut = struct {
    flag: Int,
    err: String,
    nlab: Int,
    jumps: Int,
    pos: Int
};

fn dns_err(m: String) -> DnsOut {
    return DnsOut { flag: 0, err: "ERR\tdns: " + m, nlab: 0, jumps: 0, pos: 0 };
}

pub fn dns_wire_codec_name(buf: List[Int], start: Int) -> DnsOut {
    let n: Int = list_len(buf);
    if start < 0 {
        return dns_err("pos");
    }
    if start >= n {
        return dns_err("short");
    }
    let mut i: Int = start;
    let mut jumps: Int = 0;
    let mut nlab: Int = 0;
    let mut guard: Int = 0;
    while guard < 128 {
        if i >= n {
            return dns_err("short");
        }
        let b: Int = list_get(buf, i);
        if b == 0 {
            return DnsOut { flag: 1, err: "", nlab: nlab, jumps: jumps, pos: i + 1 };
        }
        if (b & 192) == 192 {
            if i + 1 >= n {
                return dns_err("short");
            }
            jumps = jumps + 1;
            if jumps > 16 {
                return dns_err("jumps");
            }
            i = ((b & 63) * 256) + list_get(buf, i + 1);
            if i >= n {
                return dns_err("ptr");
            }
        } else {
            if (b & 192) != 0 {
                return dns_err("flag");
            }
            if i + 1 + b > n {
                return dns_err("short");
            }
            nlab = nlab + 1;
            i = i + 1 + b;
        }
        guard = guard + 1;
    }
    return dns_err("loop");
}

pub fn dns_wire_codec_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn dns_wire_codec_flag(o: DnsOut) -> Int {
    return o.flag;
}
pub fn dns_wire_codec_err(o: DnsOut) -> String {
    return o.err;
}
