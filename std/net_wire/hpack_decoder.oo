// # RFC 7541 HPACK integer and table
//
// Logline: Decodes an HPACK prefixed integer and looks up static and dynamic table indices.
//
// Setup: Pure. Prefix N is 1..8. Index 0 is Err. A truncated integer is Err.
//
// Beats:
//   1. Read the N-bit prefix.
//   2. Continue with 7-bit chunks while the high bit is set.
//   3. Resolve a static token for indices 1..4.
//   4. Reject index 0 and a short buffer.

pub type HpOut = struct {
    flag: Int,
    err: String,
    value: Int,
    consumed: Int
};

fn hp_err(m: String) -> HpOut {
    return HpOut { flag: 0, err: "ERR\thpack: " + m, value: 0, consumed: 0 };
}

pub fn hpack_decoder_int(buf: List[Int], prefix: Int) -> HpOut {
    if prefix < 1 {
        return hp_err("prefix");
    }
    if prefix > 8 {
        return hp_err("prefix");
    }
    if list_len(buf) < 1 {
        return hp_err("short");
    }
    let maxp: Int = (1 << prefix) - 1;
    let b0: Int = list_get(buf, 0) & 255;
    let mut v: Int = b0 & maxp;
    if v < maxp {
        return HpOut { flag: 1, err: "", value: v, consumed: 1 };
    }
    let mut i: Int = 1;
    let mut m: Int = 0;
    while i < list_len(buf) {
        let b: Int = list_get(buf, i) & 255;
        v = v + (b & 127) * (1 << m);
        i = i + 1;
        if (b & 128) == 0 {
            return HpOut { flag: 1, err: "", value: v, consumed: i };
        }
        m = m + 7;
        if m > 28 {
            return hp_err("over");
        }
    }
    return hp_err("short");
}

pub fn hpack_decoder_index(idx: Int) -> Result[Int, String] {
    if idx < 1 {
        return Err("ERR\thpack: index");
    }
    if idx == 1 {
        return Ok(1);
    }
    if idx == 2 {
        return Ok(2);
    }
    if idx == 3 {
        return Ok(3);
    }
    if idx == 4 {
        return Ok(4);
    }
    if idx > 61 {
        return Err("ERR\thpack: dyn");
    }
    return Ok(idx);
}

pub fn hpack_decoder_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn hpack_decoder_flag(o: HpOut) -> Int {
    return o.flag;
}
pub fn hpack_decoder_err(o: HpOut) -> String {
    return o.err;
}
