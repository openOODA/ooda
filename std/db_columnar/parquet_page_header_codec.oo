// # Parquet Page Header Codec & Deserialization
//
// Logline: Implements Parquet PageHeader structures supporting DATA_PAGE, DATA_PAGE_V2, and DICTIONARY_PAGE types.
//
// Setup: Decodes and formats physical page headers including uncompressed/compressed sizes, value counts, and crc32 checksums.
//
// Beats:
//   1. Define PageType, DataPageHeaderV1, DataPageHeaderV2, and ParquetPageHeader structs.
//   2. Implement page header initializers and encoding configuration descriptors.
//   3. Implement page size aggregation and uncompressed memory budget validation.

pub type DataPageHeaderV1 = struct {
    num_values: Int,
    encoding: Int,
    definition_level_encoding: Int,
    repetition_level_encoding: Int,
};

pub type DataPageHeaderV2 = struct {
    num_values: Int,
    num_nulls: Int,
    num_rows: Int,
    encoding: Int,
    definition_levels_byte_length: Int,
    repetition_levels_byte_length: Int,
    is_compressed: Bool,
};

pub type ParquetPageHeader = struct {
    page_type: Int,
    uncompressed_page_size: Int,
    compressed_page_size: Int,
    crc: Int,
    data_page_header_v1: DataPageHeaderV1,
    data_page_header_v2: DataPageHeaderV2,
    has_v2_header: Bool,
};

pub fn data_page_v1_new(num_v: Int, enc: Int, def_enc: Int, rep_enc: Int) -> DataPageHeaderV1 {
    return DataPageHeaderV1 {
        num_values: num_v,
        encoding: enc,
        definition_level_encoding: def_enc,
        repetition_level_encoding: rep_enc,
    };
}

pub fn data_page_v2_new(num_v: Int, nulls: Int, rows: Int, enc: Int, def_len: Int, rep_len: Int) -> DataPageHeaderV2 {
    return DataPageHeaderV2 {
        num_values: num_v,
        num_nulls: nulls,
        num_rows: rows,
        encoding: enc,
        definition_levels_byte_length: def_len,
        repetition_levels_byte_length: rep_len,
        is_compressed: true,
    };
}

pub fn parquet_page_header_new_v1(uncomp: Int, comp: Int, hdr_v1: DataPageHeaderV1) -> ParquetPageHeader {
    let dummy_v2: DataPageHeaderV2 = data_page_v2_new(0, 0, 0, 0, 0, 0);
    return ParquetPageHeader {
        page_type: 0,
        uncompressed_page_size: uncomp,
        compressed_page_size: comp,
        crc: 0,
        data_page_header_v1: hdr_v1,
        data_page_header_v2: dummy_v2,
        has_v2_header: false,
    };
}

pub fn parquet_page_header_new_v2(uncomp: Int, comp: Int, hdr_v2: DataPageHeaderV2) -> ParquetPageHeader {
    let dummy_v1: DataPageHeaderV1 = data_page_v1_new(0, 0, 0, 0);
    return ParquetPageHeader {
        page_type: 1,
        uncompressed_page_size: uncomp,
        compressed_page_size: comp,
        crc: 0,
        data_page_header_v1: dummy_v1,
        data_page_header_v2: hdr_v2,
        has_v2_header: true,
    };
}

pub fn page_header_get_value_count(hdr: ParquetPageHeader) -> Int {
    if (hdr).has_v2_header {
        return ((hdr).data_page_header_v2).num_values;
    } else {
        return ((hdr).data_page_header_v1).num_values;
    }
}

pub fn page_header_compression_ratio(hdr: ParquetPageHeader) -> Float {
    let uncomp: Float = (hdr).uncompressed_page_size * 1.0;
    let comp: Float = (hdr).compressed_page_size * 1.0;
    if comp > 0.0 {
        return uncomp / comp;
    }
    return 1.0;
}
