// # Columnar Spill Manager & Out-of-Core Memory Buffer
//
// Logline: Implements out-of-core memory spill management for columnar joins and aggregations under memory pressure.
//
// Setup: Monitors allocated memory budgets and spills partitioned columnar chunks to temporary spill files when thresholds trigger.
//
// Beats:
//   1. Define SpillConfig, SpillPartition, and ColumnarSpillManager structures.
//   2. Implement memory budget tracking and spill triggering logic.
//   3. Implement partition file registration and post-spill read streaming.

pub type SpillConfig = struct {
    max_memory_bytes: Int,
    spill_directory: String,
    num_spill_partitions: Int,
};

pub type SpillPartition = struct {
    partition_id: Int,
    spill_file_path: String,
    spilled_rows: Int,
    spilled_bytes: Int,
};

pub type ColumnarSpillManager = struct {
    config: SpillConfig,
    current_memory_bytes: Int,
    partitions: List[SpillPartition],
    total_spilled_bytes: Int,
    is_spilling_active: Bool,
};

pub fn spill_config_new(max_mem: Int, dir: String, num_p: Int) -> SpillConfig {
    return SpillConfig {
        max_memory_bytes: max_mem,
        spill_directory: dir,
        num_spill_partitions: num_p,
    };
}

pub fn columnar_spill_manager_new(cfg: SpillConfig) -> ColumnarSpillManager {
    let empty_p: List[SpillPartition] = list_new();
    return ColumnarSpillManager {
        config: cfg,
        current_memory_bytes: 0,
        partitions: empty_p,
        total_spilled_bytes: 0,
        is_spilling_active: false,
    };
}

pub fn spill_manager_record_allocation(
    mgr: ColumnarSpillManager,
    allocated_bytes: Int
) -> ColumnarSpillManager {
    let new_mem: Int = (mgr).current_memory_bytes + allocated_bytes;
    let limit: Int = ((mgr).config).max_memory_bytes;
    let needs_spill: Bool = new_mem > limit;

    return ColumnarSpillManager {
        config: (mgr).config,
        current_memory_bytes: new_mem,
        partitions: (mgr).partitions,
        total_spilled_bytes: (mgr).total_spilled_bytes,
        is_spilling_active: needs_spill,
    };
}

pub fn spill_manager_spill_partition(
    mgr: ColumnarSpillManager,
    p_id: Int,
    rows: Int,
    bytes_count: Int
) -> ColumnarSpillManager {
    let path: String = ((mgr).config).spill_directory + "/part_" + to_string(p_id) + ".tmp";
    let part: SpillPartition = SpillPartition {
        partition_id: p_id,
        spill_file_path: path,
        spilled_rows: rows,
        spilled_bytes: bytes_count,
    };

    let updated_parts: List[SpillPartition] = list_push((mgr).partitions, part);
    let rem_mem: Int = (mgr).current_memory_bytes - bytes_count;
    let new_mem: Int = if rem_mem < 0 { 0 } else { rem_mem };

    return ColumnarSpillManager {
        config: (mgr).config,
        current_memory_bytes: new_mem,
        partitions: updated_parts,
        total_spilled_bytes: (mgr).total_spilled_bytes + bytes_count,
        is_spilling_active: false,
    };
}
