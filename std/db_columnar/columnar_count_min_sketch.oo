// # Columnar Count-Min Sketch Frequency Estimator
//
// Logline: Implements 2D Count-Min Sketch frequency tables for sub-linear item frequency estimation over columnar streams.
//
// Setup: Hashes items across d depth rows with w width columns taking min counter values as conservative frequency estimates.
//
// Beats:
//   1. Define CmsConfig and CountMinSketch structures.
//   2. Implement multi-hash row hashing and cell incrementation.
//   3. Implement point frequency queries taking the minimum across sketch depth rows.

pub type CmsConfig = struct {
    depth_d: Int,
    width_w: Int
};

pub type CountMinSketch = struct {
    depth_d: Int,
    width_w: Int,
    table_cells: List[Int],
    total_count: Int
};

pub fn count_min_sketch_new(depth: Int, width: Int) -> CountMinSketch {
    let total_cells: Int = depth * width;
    let mut cells: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total_cells {
        cells = list_push(cells, 0);
        i = i + 1;
    }
    return CountMinSketch {
        depth_d: depth,
        width_w: width,
        table_cells: cells,
        total_count: 0
    };
}

pub fn cms_hash_int(item: Int, seed: Int, width: Int) -> Int {
    let abs_item: Int = if item < 0 { -item } else { item };
    let h: Int = (abs_item * (seed + 31) + 17) % width;
    return if h < 0 { -h } else { h };
}

pub fn count_min_sketch_add(sketch: CountMinSketch, item: Int) -> CountMinSketch {
    let d: Int = (sketch).depth_d;
    let w: Int = (sketch).width_w;
    let cells: List[Int] = (sketch).table_cells;
    let mut new_cells: List[Int] = cells;

    let mut row: Int = 0;
    while row < d {
        let col: Int = cms_hash_int(item, row, w);
        let cell_idx: Int = (row * w) + col;
        let curr_val: Int = list_get(new_cells, cell_idx);

        let mut updated: List[Int] = list_new();
        let n: Int = list_len(new_cells);
        let mut k: Int = 0;
        while k < n {
            if k == cell_idx {
                updated = list_push(updated, curr_val + 1);
            } else {
                updated = list_push(updated, list_get(new_cells, k));
            }
            k = k + 1;
        }
        new_cells = updated;
        row = row + 1;
    }

    return CountMinSketch {
        depth_d: d,
        width_w: w,
        table_cells: new_cells,
        total_count: (sketch).total_count + 1
    };
}

pub fn count_min_sketch_estimate(sketch: CountMinSketch, item: Int) -> Int {
    let d: Int = (sketch).depth_d;
    let w: Int = (sketch).width_w;
    let cells: List[Int] = (sketch).table_cells;
    let mut min_count: Int = 2147483647;

    let mut row: Int = 0;
    while row < d {
        let col: Int = cms_hash_int(item, row, w);
        let cell_idx: Int = (row * w) + col;
        let c_val: Int = list_get(cells, cell_idx);
        if c_val < min_count {
            min_count = c_val;
        }
        row = row + 1;
    }

    return if min_count == 2147483647 { 0 } else { min_count };
}
