// # Apache Arrow Vectorized Filter & Selection Kernels
//
// Logline: Implements vectorized boolean filtering and selection vectors for Apache Arrow columnar batches.
//
// Setup: Evaluates column predicates producing compact selection vectors and filtering Arrow arrays.
//
// Beats:
//   1. Define SelectionVector and FilterMask structures.
//   2. Implement vectorized comparison kernels (equal, greater_than, less_than, is_null).
//   3. Implement selection vector application to produce filtered column arrays.

pub type SelectionVector = struct {
    indices: List[Int],
    selected_count: Int,
};

pub type FilterMask = struct {
    bits: List[Bool],
    true_count: Int,
    total_count: Int,
};

pub fn filter_mask_new(bits: List[Bool]) -> FilterMask {
    let mut trues: Int = 0;
    let n: Int = list_len(bits);
    let mut i: Int = 0;
    while i < n {
        if list_get(bits, i) {
            trues = trues + 1;
        }
        i = i + 1;
    }
    return FilterMask {
        bits: bits,
        true_count: trues,
        total_count: n,
    };
}

pub fn filter_mask_to_selection_vector(mask: FilterMask) -> SelectionVector {
    let mut sel: List[Int] = list_new();
    let b: List[Bool] = (mask).bits;
    let n: Int = list_len(b);
    let mut i: Int = 0;
    while i < n {
        if list_get(b, i) {
            sel = list_push(sel, i);
        }
        i = i + 1;
    }
    return SelectionVector {
        indices: sel,
        selected_count: list_len(sel),
    };
}

pub fn filter_kernel_eq_int(vals: List[Int], target: Int) -> FilterMask {
    let mut mask_bits: List[Bool] = list_new();
    let n: Int = list_len(vals);
    let mut i: Int = 0;
    while i < n {
        let is_eq: Bool = (list_get(vals, i) == target);
        mask_bits = list_push(mask_bits, is_eq);
        i = i + 1;
    }
    return filter_mask_new(mask_bits);
}

pub fn filter_kernel_gt_int(vals: List[Int], threshold: Int) -> FilterMask {
    let mut mask_bits: List[Bool] = list_new();
    let n: Int = list_len(vals);
    let mut i: Int = 0;
    while i < n {
        let is_gt: Bool = (list_get(vals, i) > threshold);
        mask_bits = list_push(mask_bits, is_gt);
        i = i + 1;
    }
    return filter_mask_new(mask_bits);
}

pub fn filter_apply_selection_int(vals: List[Int], sel: SelectionVector) -> List[Int] {
    let mut filtered: List[Int] = list_new();
    let idxs: List[Int] = (sel).indices;
    let n_sel: Int = list_len(idxs);
    let mut i: Int = 0;
    while i < n_sel {
        let row_idx: Int = list_get(idxs, i);
        if row_idx >= 0 && row_idx < list_len(vals) {
            filtered = list_push(filtered, list_get(vals, row_idx));
        }
        i = i + 1;
    }
    return filtered;
}

pub fn filter_apply_selection_string(vals: List[String], sel: SelectionVector) -> List[String] {
    let mut filtered: List[String] = list_new();
    let idxs: List[Int] = (sel).indices;
    let n_sel: Int = list_len(idxs);
    let mut i: Int = 0;
    while i < n_sel {
        let row_idx: Int = list_get(idxs, i);
        if row_idx >= 0 && row_idx < list_len(vals) {
            filtered = list_push(filtered, list_get(vals, row_idx));
        }
        i = i + 1;
    }
    return filtered;
}
