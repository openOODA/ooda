// # Apache Arrow Vectorized Filter & Selection Kernels
//
// Logline: Implements vectorized boolean filtering and selection vectors for Apache Arrow columnar batches.
//
// Setup: Evaluates column predicates producing compact selection vectors and filtering Arrow arrays.
//
// Beats:
//   1. Define SelectionVector and FilterMask structures.
//   2. Implement vectorized comparison kernels (equal, greater_than, less_than, is_null).
//   3. Implement selection vector application to produce filtered column arrays.

type SelectionVector = struct {
    selected_count: Int,
    total_count: Int
};

type FilterMask = struct {
    true_count: Int,
    total_count: Int
};

pub fn filter_kernel_eq_count(vals: List[Int], target: Int) -> FilterMask {
    let mut trues: Int = 0;
    let n: Int = list_len(vals);
    let mut i: Int = 0;
    while i < n {
        if list_get(vals, i) == target {
            trues = trues + 1;
        }
        i = i + 1;
    }
    return FilterMask {
        true_count: trues,
        total_count: n
    };
}

pub fn filter_kernel_gt_count(vals: List[Int], threshold: Int) -> FilterMask {
    let mut trues: Int = 0;
    let n: Int = list_len(vals);
    let mut i: Int = 0;
    while i < n {
        if list_get(vals, i) > threshold {
            trues = trues + 1;
        }
        i = i + 1;
    }
    return FilterMask {
        true_count: trues,
        total_count: n
    };
}

pub fn filter_kernel_eq_indices(vals: List[Int], target: Int) -> List[Int] {
    let mut sel: List[Int] = list_new();
    let n: Int = list_len(vals);
    let mut i: Int = 0;
    while i < n {
        if list_get(vals, i) == target {
            sel = list_push(sel, i);
        }
        i = i + 1;
    }
    return sel;
}

pub fn filter_kernel_gt_indices(vals: List[Int], threshold: Int) -> List[Int] {
    let mut sel: List[Int] = list_new();
    let n: Int = list_len(vals);
    let mut i: Int = 0;
    while i < n {
        if list_get(vals, i) > threshold {
            sel = list_push(sel, i);
        }
        i = i + 1;
    }
    return sel;
}

pub fn filter_apply_selection(vals: List[Int], indices: List[Int]) -> List[Int] {
    let mut filtered: List[Int] = list_new();
    let n_sel: Int = list_len(indices);
    let mut i: Int = 0;
    while i < n_sel {
        let row_idx: Int = list_get(indices, i);
        if row_idx >= 0 && row_idx < list_len(vals) {
            filtered = list_push(filtered, list_get(vals, row_idx));
        }
        i = i + 1;
    }
    return filtered;
}
