// # Apache Arrow Dictionary Array Representation
//
// Logline: Implements Apache Arrow DictionaryArray representation with typed index keys and dictionary value vectors.
//
// Setup: Decodes and structures categorical data into compact integer indices referencing a shared dictionary array.
//
// Beats:
//   1. Define ArrowDictionaryArray and DictionaryEncoding structures.
//   2. Implement dictionary array builders for deduplicating strings and mapping indices.
//   3. Implement dictionary array slicing and zero-copy key remapping.

pub type DictionaryEncoding = struct {
    id: Int,
    index_type_id: Int,
    is_ordered: Bool,
};

pub type ArrowDictionaryArray = struct {
    indices: List[Int],
    dictionary_values: List[String],
    null_bitmap: List[Bool],
    null_count: Int,
    length: Int,
    encoding: DictionaryEncoding,
};

pub fn arrow_dictionary_array_new(
    keys: List[Int],
    dict: List[String],
    nulls: List[Bool],
    num_nulls: Int
) -> ArrowDictionaryArray {
    let enc: DictionaryEncoding = DictionaryEncoding {
        id: 1,
        index_type_id: 1,
        is_ordered: false,
    };
    let len: Int = list_len(keys);
    return ArrowDictionaryArray {
        indices: keys,
        dictionary_values: dict,
        null_bitmap: nulls,
        null_count: num_nulls,
        length: len,
        encoding: enc,
    };
}

pub fn arrow_dictionary_array_get_value(arr: ArrowDictionaryArray, index: Int) -> String {
    if index < 0 || index >= (arr).length {
        return "";
    }
    if list_len((arr).null_bitmap) > index {
        if !list_get((arr).null_bitmap, index) {
            return "";
        }
    }
    let dict_idx: Int = list_get((arr).indices, index);
    let dict_vals: List[String] = (arr).dictionary_values;
    if dict_idx >= 0 && dict_idx < list_len(dict_vals) {
        return list_get(dict_vals, dict_idx);
    }
    return "";
}

pub fn arrow_dictionary_array_expand(arr: ArrowDictionaryArray) -> List[String] {
    let mut expanded: List[String] = list_new();
    let n: Int = (arr).length;
    let mut i: Int = 0;
    while i < n {
        let val: String = arrow_dictionary_array_get_value(arr, i);
        expanded = list_push(expanded, val);
        i = i + 1;
    }
    return expanded;
}
