// # Columnar Dataset Compact Manifest
//
// Logline: Implements dataset manifest catalogs tracking columnar file paths, row counts, and summary statistics.
//
// Setup: Coordinates multi-file Parquet/Arrow dataset catalogs for query planning and dataset compaction.
//
// Beats:
//   1. Define ManifestFileEntry and ColumnarDatasetManifest structures.
//   2. Implement file registration, cumulative row counter tracking, and byte size accounting.
//   3. Implement manifest-level range query filtering selecting relevant candidate files.

pub type ManifestFileEntry = struct {
    file_path: String,
    num_rows: Int,
    file_size_bytes: Int,
    min_key: Int,
    max_key: Int
};

pub type ColumnarDatasetManifest = struct {
    dataset_name: String,
    schema_version: Int,
    files: List[ManifestFileEntry],
    total_files: Int,
    total_rows: Int,
    total_bytes: Int
};

pub fn columnar_manifest_new(name: String, ver: Int) -> ColumnarDatasetManifest {
    let empty_f: List[ManifestFileEntry] = list_new();
    return ColumnarDatasetManifest {
        dataset_name: name,
        schema_version: ver,
        files: empty_f,
        total_files: 0,
        total_rows: 0,
        total_bytes: 0
    };
}

pub fn columnar_manifest_add_file(
    manifest: ColumnarDatasetManifest,
    path: String,
    rows: Int,
    bytes_count: Int,
    min_k: Int,
    max_k: Int
) -> ColumnarDatasetManifest {
    let entry: ManifestFileEntry = ManifestFileEntry {
        file_path: path,
        num_rows: rows,
        file_size_bytes: bytes_count,
        min_key: min_k,
        max_key: max_k
    };
    let updated_files: List[ManifestFileEntry] = list_push((manifest).files, entry);
    return ColumnarDatasetManifest {
        dataset_name: (manifest).dataset_name,
        schema_version: (manifest).schema_version,
        files: updated_files,
        total_files: (manifest).total_files + 1,
        total_rows: (manifest).total_rows + rows,
        total_bytes: (manifest).total_bytes + bytes_count
    };
}

pub fn columnar_manifest_find_files_for_key(
    manifest: ColumnarDatasetManifest,
    target_key: Int
) -> List[String] {
    let mut matching_paths: List[String] = list_new();
    let f_list: List[ManifestFileEntry] = (manifest).files;
    let n: Int = list_len(f_list);
    let mut i: Int = 0;

    while i < n {
        let f: ManifestFileEntry = list_get(f_list, i);
        if target_key >= (f).min_key && target_key <= (f).max_key {
            matching_paths = list_push(matching_paths, (f).file_path);
        }
        i = i + 1;
    }

    return matching_paths;
}
