// # Columnar Vectorized Rolling Window Aggregator
//
// Logline: Implements vectorized sliding window frames (moving sum, moving avg, row_number) over columnar arrays.
//
// Setup: Slides fixed-size or unbounded preceding windows over ordered column vectors updating running sums in O(1) time.
//
// Beats:
//   1. Define WindowFrameConfig and WindowAggResult structures.
//   2. Implement sliding window queue addition and leading edge eviction.
//   3. Implement vectorized rolling sum and moving average computation.

pub type WindowFrameConfig = struct {
    window_size: Int,
    is_cumulative: Bool
};

pub type WindowAggResult = struct {
    running_sums: List[Int],
    running_avgs: List[Int],
    row_numbers: List[Int],
    total_rows: Int
};

pub fn window_frame_config_sliding(size: Int) -> WindowFrameConfig {
    return WindowFrameConfig {
        window_size: size,
        is_cumulative: false
    };
}

pub fn window_frame_config_cumulative() -> WindowFrameConfig {
    return WindowFrameConfig {
        window_size: 0,
        is_cumulative: true
    };
}

pub fn columnar_compute_rolling_window(
    vals: List[Int],
    cfg: WindowFrameConfig
) -> WindowAggResult {
    let n: Int = list_len(vals);
    let mut sums: List[Int] = list_new();
    let mut avgs: List[Int] = list_new();
    let mut row_nums: List[Int] = list_new();

    let mut running_sum: Int = 0;
    let w_size: Int = (cfg).window_size;
    let is_cum: Bool = (cfg).is_cumulative;

    let mut i: Int = 0;
    while i < n {
        let v: Int = list_get(vals, i);
        running_sum = running_sum + v;

        if !is_cum && i >= w_size {
            let evicted: Int = list_get(vals, i - w_size);
            running_sum = running_sum - evicted;
        }

        let current_count: Int = if is_cum { i + 1 } else { if (i + 1) < w_size { i + 1 } else { w_size } };
        let avg: Int = if current_count > 0 { running_sum / current_count } else { 0 };

        sums = list_push(sums, running_sum);
        avgs = list_push(avgs, avg);
        row_nums = list_push(row_nums, i + 1);

        i = i + 1;
    }

    return WindowAggResult {
        running_sums: sums,
        running_avgs: avgs,
        row_numbers: row_nums,
        total_rows: n
    };
}
