// # Columnar Frame of Reference (FoR) Integer Compression
//
// Logline: Block min baseline + bit-width of max delta.
// residual: pub type destubbed; nested header flattened to one payload.

type ForCompressedBlock = struct {
    base_value: Int,
    bit_width: Int,
    n_values: Int,
    d0: Int,
    d1: Int,
    d2: Int
};

pub fn for_calc_bit_width(max_delta: Int) -> Int {
    if max_delta <= 0 {
        return 0;
    }
    if max_delta < 2 {
        return 1;
    }
    if max_delta < 4 {
        return 2;
    }
    if max_delta < 16 {
        return 4;
    }
    if max_delta < 256 {
        return 8;
    }
    if max_delta < 65536 {
        return 16;
    }
    return 32;
}

pub fn for_compress_triple(a: Int, b: Int, c: Int) -> ForCompressedBlock {
    let mut min_val: Int = a;
    if b < min_val {
        min_val = b;
    }
    if c < min_val {
        min_val = c;
    }
    let mut max_val: Int = a;
    if b > max_val {
        max_val = b;
    }
    if c > max_val {
        max_val = c;
    }
    let max_delta: Int = max_val - min_val;
    let bw: Int = for_calc_bit_width(max_delta);
    return ForCompressedBlock {
        base_value: min_val,
        bit_width: bw,
        n_values: 3,
        d0: a - min_val,
        d1: b - min_val,
        d2: c - min_val
    };
}

pub fn for_restore_at(block: ForCompressedBlock, idx: Int) -> Int {
    if idx == 0 {
        return block.base_value + block.d0;
    }
    if idx == 1 {
        return block.base_value + block.d1;
    }
    if idx == 2 {
        return block.base_value + block.d2;
    }
    return block.base_value;
}

pub fn for_block_bit_width(block: ForCompressedBlock) -> Int {
    return block.bit_width;
}

pub fn for_block_base(block: ForCompressedBlock) -> Int {
    return block.base_value;
}
