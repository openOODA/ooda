// # Columnar Zstandard (ZSTD) Block Codec
//
// Logline: Implements Zstandard (ZSTD) frame headers, block descriptors, and Finite State Entropy (FSE) tables.
//
// Setup: Parses ZSTD block framing and entropy compression states for ultra-compact columnar storage.
//
// Beats:
//   1. Define ZstdFrameHeader, ZstdBlockHeader, and FseTableEntry structures.
//   2. Implement ZSTD frame magic verification and block type decoding.
//   3. Implement FSE state transitions and bitstream progression.

pub type ZstdFrameHeader = struct {
    magic_number: Int,
    window_size: Int,
    content_size: Int,
    has_checksum: Bool
};

pub type ZstdBlockHeader = struct {
    last_block: Bool,
    block_type: Int,
    block_size: Int
};

pub type FseTableEntry = struct {
    baseline: Int,
    num_bits: Int,
    next_state: Int
};

pub fn zstd_frame_header_default() -> ZstdFrameHeader {
    return ZstdFrameHeader {
        magic_number: 424776221,
        window_size: 131072,
        content_size: 0,
        has_checksum: true
    };
}

pub fn zstd_parse_block_header(header_int: Int) -> ZstdBlockHeader {
    let is_last: Bool = (header_int % 2) == 1;
    let b_type: Int = (header_int / 2) % 4;
    let b_size: Int = header_int / 8;
    return ZstdBlockHeader {
        last_block: is_last,
        block_type: b_type,
        block_size: b_size
    };
}

pub fn fse_table_entry_new(base: Int, n_bits: Int, n_state: Int) -> FseTableEntry {
    return FseTableEntry {
        baseline: base,
        num_bits: n_bits,
        next_state: n_state
    };
}

pub fn fse_decode_symbol(state: Int, entry: FseTableEntry, bit_val: Int) -> Int {
    let symbol: Int = (entry).baseline + bit_val;
    return symbol;
}
