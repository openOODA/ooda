pub fn db_columnar_file_metadata_default() -> FileMetaData {
    return file_metadata_new(2, "openOODA-parquet-engine");
}

pub fn db_columnar_record_batch_default() -> ArrowRecordBatch {
    return arrow_record_batch_new(0);
}

pub fn db_columnar_memory_pool_default() -> ColumnarMemoryPool {
    return columnar_memory_pool_new(1073741824);
}

pub fn db_columnar_hash_table_default() -> ColumnarHashTable {
    return columnar_hash_table_new(1024);
}

pub fn db_columnar_hash_agg_default() -> HashAggTable {
    return hash_agg_table_new();
}

pub fn db_columnar_security_policy_default() -> ColumnarSecurityPolicy {
    return columnar_security_policy_default();
}
