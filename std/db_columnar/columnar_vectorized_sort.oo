// # Columnar Vectorized Permutation Sorting
//
// Logline: Implements vectorized sorting via permutation index vectors for zero-copy columnar table ordering.
//
// Setup: Computes permutation index vectors on sort key columns and applies them to rearrange dependent payload columns.
//
// Beats:
//   1. Define PermutationVector and ColumnarSortConfig structures.
//   2. Implement ascending and descending permutation index sort kernels.
//   3. Implement columnar permutation rearrangement for integer and string arrays.

pub type PermutationVector = struct {
    indices: List[Int],
    length: Int,
    is_ascending: Bool,
};

pub type ColumnarSortConfig = struct {
    ascending: Bool,
    nulls_first: Bool,
};

pub fn permutation_vector_identity(len: Int) -> PermutationVector {
    let mut idxs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < len {
        idxs = list_push(idxs, i);
        i = i + 1;
    }
    return PermutationVector {
        indices: idxs,
        length: len,
        is_ascending: true,
    };
}

pub fn columnar_sort_compute_permutation_int(keys: List[Int], ascending: Bool) -> PermutationVector {
    let n: Int = list_len(keys);
    let mut perm: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        perm = list_push(perm, i);
        i = i + 1;
    }

    // Stable insertion sort on permutation indices
    let mut a: Int = 1;
    while a < n {
        let current_perm_idx: Int = list_get(perm, a);
        let current_key: Int = list_get(keys, current_perm_idx);
        let mut b: Int = a;

        while b > 0 {
            let prev_perm_idx: Int = list_get(perm, b - 1);
            let prev_key: Int = list_get(keys, prev_perm_idx);
            let should_swap: Bool = if ascending { current_key < prev_key } else { current_key > prev_key };
            if should_swap {
                let mut updated_perm: List[Int] = list_new();
                let mut k: Int = 0;
                while k < n {
                    if k == (b - 1) {
                        updated_perm = list_push(updated_perm, current_perm_idx);
                    } else if k == b {
                        updated_perm = list_push(updated_perm, prev_perm_idx);
                    } else {
                        updated_perm = list_push(updated_perm, list_get(perm, k));
                    }
                    k = k + 1;
                }
                perm = updated_perm;
                b = b - 1;
            } else {
                b = 0;
            }
        }
        a = a + 1;
    }

    return PermutationVector {
        indices: perm,
        length: n,
        is_ascending: ascending,
    };
}

pub fn columnar_sort_apply_permutation_int(vals: List[Int], perm: PermutationVector) -> List[Int] {
    let mut rearranged: List[Int] = list_new();
    let idxs: List[Int] = (perm).indices;
    let n: Int = list_len(idxs);
    let mut i: Int = 0;
    while i < n {
        let original_idx: Int = list_get(idxs, i);
        if original_idx >= 0 && original_idx < list_len(vals) {
            rearranged = list_push(rearranged, list_get(vals, original_idx));
        }
        i = i + 1;
    }
    return rearranged;
}
