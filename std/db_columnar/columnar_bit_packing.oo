// # Columnar Integer Bit-Packing Codec
//
// Logline: Implements dense bit-packing and unpacking routines for columnar integers with variable bit-widths.
//
// Setup: Packs integer arrays with narrow bit ranges into dense 32/64-bit words minimizing memory bandwidth.
//
// Beats:
//   1. Define BitPackingConfig and BitPackedBlock structures.
//   2. Implement bit-packing encoders for arbitrary bit widths (1 to 16 bits per integer).
//   3. Implement unpacking decoders expanding packed words into flat integer vectors.

pub type BitPackingConfig = struct {
    bit_width: Int,
    block_size: Int
};

pub type BitPackedBlock = struct {
    bit_width: Int,
    packed_words: List[Int],
    value_count: Int
};

pub fn bit_packing_config_new(bw: Int, b_size: Int) -> BitPackingConfig {
    return BitPackingConfig {
        bit_width: bw,
        block_size: b_size
    };
}

pub fn bit_packing_pack_8bit(vals: List[Int], bit_width: Int) -> BitPackedBlock {
    let n: Int = list_len(vals);
    let vals_per_word: Int = if bit_width > 0 { 32 / bit_width } else { 1 };
    let mut packed: List[Int] = list_new();
    let mut current_word: Int = 0;
    let mut in_word_count: Int = 0;
    let mut multiplier: Int = 1;

    let mut i: Int = 0;
    while i < n {
        let v: Int = list_get(vals, i);
        current_word = current_word + (v * multiplier);
        in_word_count = in_word_count + 1;

        let mut next_mult: Int = 1;
        let mut m_i: Int = 0;
        while m_i < (in_word_count * bit_width) {
            next_mult = next_mult * 2;
            m_i = m_i + 1;
        }
        multiplier = next_mult;

        if in_word_count >= vals_per_word {
            packed = list_push(packed, current_word);
            current_word = 0;
            in_word_count = 0;
            multiplier = 1;
        }
        i = i + 1;
    }

    if in_word_count > 0 {
        packed = list_push(packed, current_word);
    }

    return BitPackedBlock {
        bit_width: bit_width,
        packed_words: packed,
        value_count: n
    };
}

pub fn bit_packing_unpack_block(block: BitPackedBlock) -> List[Int] {
    let mut unpacked: List[Int] = list_new();
    let bw: Int = (block).bit_width;
    let total_v: Int = (block).value_count;
    let words: List[Int] = (block).packed_words;
    let n_words: Int = list_len(words);

    let mut mask: Int = 1;
    let mut m_k: Int = 0;
    while m_k < bw {
        mask = mask * 2;
        m_k = m_k + 1;
    }
    let divisor: Int = mask;

    let vals_per_word: Int = if bw > 0 { 32 / bw } else { 1 };
    let mut w_i: Int = 0;
    while w_i < n_words && list_len(unpacked) < total_v {
        let mut w: Int = list_get(words, w_i);
        let mut sub_i: Int = 0;
        while sub_i < vals_per_word && list_len(unpacked) < total_v {
            let v: Int = w % divisor;
            unpacked = list_push(unpacked, v);
            w = w / divisor;
            sub_i = sub_i + 1;
        }
        w_i = w_i + 1;
    }

    return unpacked;
}
