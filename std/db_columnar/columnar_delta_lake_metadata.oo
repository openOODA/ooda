// # Columnar Delta Lake / Iceberg Snapshot Metadata
//
// Logline: Implements Delta Lake and Apache Iceberg table snapshot commit logs and add/remove file action reconciliation.
//
// Setup: Tracks commit log JSON/Parquet actions maintaining active physical columnar data file sets across table versions.
//
// Beats:
//   1. Define DeltaAddFileAction, DeltaRemoveFileAction, and DeltaTableSnapshot structures.
//   2. Implement commit log transaction log action application.
//   3. Implement active file set reconciliation and table snapshot time travel.

pub type DeltaAddFileAction = struct {
    path: String,
    size_bytes: Int,
    modification_time: Int,
    data_change: Bool,
    num_records: Int,
};

pub type DeltaRemoveFileAction = struct {
    path: String,
    deletion_timestamp: Int,
    data_change: Bool,
};

pub type DeltaTableSnapshot = struct {
    table_version: Int,
    active_files: List[DeltaAddFileAction],
    total_records: Int,
    total_size_bytes: Int,
};

pub fn delta_table_snapshot_new(ver: Int) -> DeltaTableSnapshot {
    let empty_files: List[DeltaAddFileAction] = list_new();
    return DeltaTableSnapshot {
        table_version: ver,
        active_files: empty_files,
        total_records: 0,
        total_size_bytes: 0,
    };
}

pub fn delta_snapshot_add_file(
    snapshot: DeltaTableSnapshot,
    action: DeltaAddFileAction
) -> DeltaTableSnapshot {
    let updated: List[DeltaAddFileAction] = list_push((snapshot).active_files, action);
    return DeltaTableSnapshot {
        table_version: (snapshot).table_version,
        active_files: updated,
        total_records: (snapshot).total_records + (action).num_records,
        total_size_bytes: (snapshot).total_size_bytes + (action).size_bytes,
    };
}

pub fn delta_snapshot_remove_file(
    snapshot: DeltaTableSnapshot,
    action: DeltaRemoveFileAction
) -> DeltaTableSnapshot {
    let files: List[DeltaAddFileAction] = (snapshot).active_files;
    let n: Int = list_len(files);
    let mut kept: List[DeltaAddFileAction] = list_new();
    let mut removed_records: Int = 0;
    let mut removed_bytes: Int = 0;

    let mut i: Int = 0;
    while i < n {
        let f: DeltaAddFileAction = list_get(files, i);
        if (f).path == (action).path {
            removed_records = (f).num_records;
            removed_bytes = (f).size_bytes;
        } else {
            kept = list_push(kept, f);
        }
        i = i + 1;
    }

    return DeltaTableSnapshot {
        table_version: (snapshot).table_version + 1,
        active_files: kept,
        total_records: (snapshot).total_records - removed_records,
        total_size_bytes: (snapshot).total_size_bytes - removed_bytes,
    };
}
