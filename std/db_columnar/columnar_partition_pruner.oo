// # Columnar Partition Pruner & Hive Path Indexer
//
// Logline: Implements Hive-style partition path parsing (/key=value/) and static directory pruning for columnar datasets.
//
// Setup: Parses directory structure into partition key-value tuples and skips entire partition paths based on query filters.
//
// Beats:
//   1. Define PartitionKeyValue, PartitionDirectory, and PartitionPruningRule structures.
//   2. Implement URI path tokenization and partition key-value extraction.
//   3. Implement predicate evaluation eliminating non-qualifying file partition paths.

pub type PartitionKeyValue = struct {
    key: String,
    int_value: Int,
    str_value: String,
    is_int: Bool
};

pub type PartitionDirectory = struct {
    path_uri: String,
    keys: List[PartitionKeyValue],
    file_count: Int
};

pub fn partition_key_value_new_int(k: String, v: Int) -> PartitionKeyValue {
    return PartitionKeyValue {
        key: k,
        int_value: v,
        str_value: "",
        is_int: true
    };
}

pub fn partition_key_value_new_string(k: String, v: String) -> PartitionKeyValue {
    return PartitionKeyValue {
        key: k,
        int_value: 0,
        str_value: v,
        is_int: false
    };
}

pub fn partition_directory_new(uri: String) -> PartitionDirectory {
    let empty_k: List[PartitionKeyValue] = list_new();
    return PartitionDirectory {
        path_uri: uri,
        keys: empty_k,
        file_count: 0
    };
}

pub fn partition_directory_add_key(dir: PartitionDirectory, kv: PartitionKeyValue) -> PartitionDirectory {
    let updated: List[PartitionKeyValue] = list_push((dir).keys, kv);
    return PartitionDirectory {
        path_uri: (dir).path_uri,
        keys: updated,
        file_count: (dir).file_count
    };
}

pub fn partition_directory_matches_int(
    dir: PartitionDirectory,
    key_name: String,
    expected_val: Int
) -> Bool {
    let keys_list: List[PartitionKeyValue] = (dir).keys;
    let n: Int = list_len(keys_list);
    let mut i: Int = 0;
    while i < n {
        let kv: PartitionKeyValue = list_get(keys_list, i);
        if (kv).key == key_name {
            if (kv).is_int {
                return (kv).int_value == expected_val;
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn partition_prune_directories_int(
    dirs: List[PartitionDirectory],
    key_name: String,
    target_val: Int
) -> List[PartitionDirectory] {
    let mut kept: List[PartitionDirectory] = list_new();
    let n: Int = list_len(dirs);
    let mut i: Int = 0;
    while i < n {
        let d: PartitionDirectory = list_get(dirs, i);
        if partition_directory_matches_int(d, key_name, target_val) {
            kept = list_push(kept, d);
        }
        i = i + 1;
    }
    return kept;
}
