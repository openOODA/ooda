// # Columnar Dremel Record Shredding & Assembly
//
// Logline: Implements Dremel record shredding and state-machine record assembly using definition and repetition levels.
//
// Setup: Deconstructs nested document records into flat columnar streams with (r, d, value) triples and reconstructs them.
//
// Beats:
//   1. Define ShreddedColumnStream and DremelSchemaNode structures.
//   2. Implement nested record shredding computing definition and repetition levels.
//   3. Implement columnar level-driven state machine reassembling structured records.

pub type DremelSchemaNode = struct {
    field_name: String,
    max_def_level: Int,
    max_rep_level: Int,
    is_repeated: Bool
};

pub type ShreddedColumnStream = struct {
    node: DremelSchemaNode,
    def_levels: List[Int],
    rep_levels: List[Int],
    int_values: List[Int],
    total_triples: Int
};

pub fn dremel_schema_node_new(name: String, max_d: Int, max_r: Int, rep: Bool) -> DremelSchemaNode {
    return DremelSchemaNode {
        field_name: name,
        max_def_level: max_d,
        max_rep_level: max_r,
        is_repeated: rep
    };
}

pub fn shredded_column_stream_new(node: DremelSchemaNode) -> ShreddedColumnStream {
    let d: List[Int] = list_new();
    let r: List[Int] = list_new();
    let v: List[Int] = list_new();
    return ShreddedColumnStream {
        node: node,
        def_levels: d,
        rep_levels: r,
        int_values: v,
        total_triples: 0
    };
}

pub fn shredded_stream_append_value(
    stream: ShreddedColumnStream,
    def_lvl: Int,
    rep_lvl: Int,
    val: Int
) -> ShreddedColumnStream {
    let updated_d: List[Int] = list_push((stream).def_levels, def_lvl);
    let updated_r: List[Int] = list_push((stream).rep_levels, rep_lvl);
    let updated_v: List[Int] = list_push((stream).int_values, val);

    return ShreddedColumnStream {
        node: (stream).node,
        def_levels: updated_d,
        rep_levels: updated_r,
        int_values: updated_v,
        total_triples: (stream).total_triples + 1
    };
}

pub fn dremel_count_defined_values(stream: ShreddedColumnStream) -> Int {
    let max_d: Int = ((stream).node).max_def_level;
    let d_list: List[Int] = (stream).def_levels;
    let n: Int = list_len(d_list);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if list_get(d_list, i) == max_d {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
