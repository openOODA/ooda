// # Columnar Late Materialization Engine
//
// Logline: Implements late materialization postponing wide column fetches until after highly selective predicate filtering.
//
// Setup: Carries compact position row-ID vectors through filter pipelines, fetching payload columns only for surviving rows.
//
// Beats:
//   1. Define PositionVector and LateMaterializationPlan structures.
//   2. Implement candidate row ID pruning through cascading columnar predicates.
//   3. Implement point-lookup column gathering for surviving position vectors.

pub type PositionVector = struct {
    row_ids: List[Int],
    count: Int
};

pub type LateMaterializationPlan = struct {
    filter_column_indices: List[Int],
    payload_column_indices: List[Int],
    estimated_selectivity: Float
};

pub fn position_vector_new(initial_count: Int) -> PositionVector {
    let mut ids: List[Int] = list_new();
    let mut i: Int = 0;
    while i < initial_count {
        ids = list_push(ids, i);
        i = i + 1;
    }
    return PositionVector {
        row_ids: ids,
        count: initial_count
    };
}

pub fn late_filter_step_gt(
    pos: PositionVector,
    col_vals: List[Int],
    threshold: Int
) -> PositionVector {
    let mut surviving: List[Int] = list_new();
    let ids: List[Int] = (pos).row_ids;
    let n: Int = list_len(ids);
    let mut i: Int = 0;

    while i < n {
        let r_id: Int = list_get(ids, i);
        if r_id >= 0 && r_id < list_len(col_vals) {
            let v: Int = list_get(col_vals, r_id);
            if v > threshold {
                surviving = list_push(surviving, r_id);
            }
        }
        i = i + 1;
    }

    return PositionVector {
        row_ids: surviving,
        count: list_len(surviving)
    };
}

pub fn late_gather_column_int(pos: PositionVector, full_col: List[Int]) -> List[Int] {
    let mut gathered: List[Int] = list_new();
    let ids: List[Int] = (pos).row_ids;
    let n: Int = list_len(ids);
    let mut i: Int = 0;

    while i < n {
        let r_id: Int = list_get(ids, i);
        if r_id >= 0 && r_id < list_len(full_col) {
            gathered = list_push(gathered, list_get(full_col, r_id));
        }
        i = i + 1;
    }

    return gathered;
}
