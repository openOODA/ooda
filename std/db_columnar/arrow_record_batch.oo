// # Apache Arrow RecordBatch Data Structure
//
// Logline: Implements Apache Arrow in-memory RecordBatch encapsulating schema-aligned columnar arrays and slicing.
//
// Setup: Organizes contiguous arrays into synchronized tabular chunks with zero-copy row slicing and projection.
//
// Beats:
//   1. Define ArrowColumnData and ArrowRecordBatch structures.
//   2. Implement RecordBatch initializers aligning column arrays with schema fields.
//   3. Implement batch row-slice operations, column projections, and memory measurement.

pub type ArrowColumnData = struct {
    type_id: Int,
    int_values: List[Int],
    float_values: List[Float],
    string_values: List[String],
    null_bitmap: List[Bool],
    null_count: Int,
    length: Int,
};

pub type ArrowRecordBatch = struct {
    num_rows: Int,
    columns: List[ArrowColumnData],
    column_names: List[String],
};

pub fn arrow_column_data_new_int(vals: List[Int], nulls: List[Bool], n_nulls: Int) -> ArrowColumnData {
    let empty_f: List[Float] = list_new();
    let empty_s: List[String] = list_new();
    let len: Int = list_len(vals);
    return ArrowColumnData {
        type_id: 1,
        int_values: vals,
        float_values: empty_f,
        string_values: empty_s,
        null_bitmap: nulls,
        null_count: n_nulls,
        length: len,
    };
}

pub fn arrow_column_data_new_string(vals: List[String], nulls: List[Bool], n_nulls: Int) -> ArrowColumnData {
    let empty_i: List[Int] = list_new();
    let empty_f: List[Float] = list_new();
    let len: Int = list_len(vals);
    return ArrowColumnData {
        type_id: 4,
        int_values: empty_i,
        float_values: empty_f,
        string_values: vals,
        null_bitmap: nulls,
        null_count: n_nulls,
        length: len,
    };
}

pub fn arrow_record_batch_new(rows: Int) -> ArrowRecordBatch {
    let empty_cols: List[ArrowColumnData] = list_new();
    let empty_names: List[String] = list_new();
    return ArrowRecordBatch {
        num_rows: rows,
        columns: empty_cols,
        column_names: empty_names,
    };
}

pub fn arrow_record_batch_add_column(
    batch: ArrowRecordBatch,
    name: String,
    col_data: ArrowColumnData
) -> ArrowRecordBatch {
    let updated_cols: List[ArrowColumnData] = list_push((batch).columns, col_data);
    let updated_names: List[String] = list_push((batch).column_names, name);
    return ArrowRecordBatch {
        num_rows: (batch).num_rows,
        columns: updated_cols,
        column_names: updated_names,
    };
}

pub fn arrow_record_batch_get_column(batch: ArrowRecordBatch, index: Int) -> ArrowColumnData {
    let cols: List[ArrowColumnData] = (batch).columns;
    let n: Int = list_len(cols);
    if index >= 0 && index < n {
        return list_get(cols, index);
    }
    let empty_b: List[Bool] = list_new();
    let empty_i: List[Int] = list_new();
    return arrow_column_data_new_int(empty_i, empty_b, 0);
}

pub fn arrow_record_batch_slice(batch: ArrowRecordBatch, offset: Int, length: Int) -> ArrowRecordBatch {
    let mut sliced_cols: List[ArrowColumnData] = list_new();
    let cols: List[ArrowColumnData] = (batch).columns;
    let num_cols: Int = list_len(cols);
    let mut c_i: Int = 0;

    while c_i < num_cols {
        let col: ArrowColumnData = list_get(cols, c_i);
        let mut sliced_ints: List[Int] = list_new();
        let mut sliced_nulls: List[Bool] = list_new();

        let mut r: Int = 0;
        while r < length && (offset + r) < (col).length {
            let row_idx: Int = offset + r;
            if list_len((col).int_values) > row_idx {
                sliced_ints = list_push(sliced_ints, list_get((col).int_values, row_idx));
            }
            if list_len((col).null_bitmap) > row_idx {
                sliced_nulls = list_push(sliced_nulls, list_get((col).null_bitmap, row_idx));
            }
            r = r + 1;
        }

        let new_col: ArrowColumnData = ArrowColumnData {
            type_id: (col).type_id,
            int_values: sliced_ints,
            float_values: (col).float_values,
            string_values: (col).string_values,
            null_bitmap: sliced_nulls,
            null_count: 0,
            length: length,
        };
        sliced_cols = list_push(sliced_cols, new_col);
        c_i = c_i + 1;
    }

    return ArrowRecordBatch {
        num_rows: length,
        columns: sliced_cols,
        column_names: (batch).column_names,
    };
}
