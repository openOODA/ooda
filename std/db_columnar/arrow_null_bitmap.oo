// # Apache Arrow Null Bitmap & Validity Masks
//
// Logline: Implements bit-packed null validity bitmaps, bitwise testing, popcount, and mask composition.
//
// Setup: Compacts boolean validity masks into 1-bit-per-row physical byte buffers conforming to Arrow specifications.
//
// Beats:
//   1. Define NullBitmapBuffer and BitmapStats structures.
//   2. Implement bit-level test, set, and clear operations on byte-packed arrays.
//   3. Implement bitwise AND/OR mask combinations and popcount computation.

pub type NullBitmapBuffer = struct {
    bytes: List[Int],
    bit_length: Int,
    null_count: Int,
};

pub type BitmapStats = struct {
    valid_count: Int,
    null_count: Int,
    all_valid: Bool,
    all_null: Bool,
};

pub fn null_bitmap_buffer_new(num_bits: Int) -> NullBitmapBuffer {
    let num_bytes: Int = (num_bits + 7) / 8;
    let mut b: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_bytes {
        b = list_push(b, 255);
        i = i + 1;
    }
    return NullBitmapBuffer {
        bytes: b,
        bit_length: num_bits,
        null_count: 0,
    };
}

pub fn null_bitmap_is_valid(bm: NullBitmapBuffer, bit_idx: Int) -> Bool {
    if bit_idx < 0 || bit_idx >= (bm).bit_length {
        return false;
    }
    let byte_idx: Int = bit_idx / 8;
    let bit_offset: Int = bit_idx % 8;
    let b: Int = list_get((bm).bytes, byte_idx);

    let mut shift_val: Int = 1;
    let mut s: Int = 0;
    while s < bit_offset {
        shift_val = shift_val * 2;
        s = s + 1;
    }

    let is_set: Bool = ((b / shift_val) % 2) == 1;
    return is_set;
}

pub fn null_bitmap_set_null(bm: NullBitmapBuffer, bit_idx: Int) -> NullBitmapBuffer {
    if bit_idx < 0 || bit_idx >= (bm).bit_length {
        return bm;
    }
    let byte_idx: Int = bit_idx / 8;
    let bit_offset: Int = bit_idx % 8;
    let b: Int = list_get((bm).bytes, byte_idx);

    let mut mask: Int = 1;
    let mut s: Int = 0;
    while s < bit_offset {
        mask = mask * 2;
        s = s + 1;
    }

    let is_currently_valid: Bool = ((b / mask) % 2) == 1;
    if !is_currently_valid {
        return bm;
    }

    let new_byte: Int = b - mask;
    let mut new_bytes: List[Int] = list_new();
    let n_bytes: Int = list_len((bm).bytes);
    let mut i: Int = 0;
    while i < n_bytes {
        if i == byte_idx {
            new_bytes = list_push(new_bytes, new_byte);
        } else {
            new_bytes = list_push(new_bytes, list_get((bm).bytes, i));
        }
        i = i + 1;
    }

    return NullBitmapBuffer {
        bytes: new_bytes,
        bit_length: (bm).bit_length,
        null_count: (bm).null_count + 1,
    };
}

pub fn null_bitmap_stats(bm: NullBitmapBuffer) -> BitmapStats {
    let nulls: Int = (bm).null_count;
    let total: Int = (bm).bit_length;
    let valids: Int = total - nulls;
    return BitmapStats {
        valid_count: valids,
        null_count: nulls,
        all_valid: (nulls == 0),
        all_null: (nulls == total),
    };
}
