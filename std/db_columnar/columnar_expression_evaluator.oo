// # Columnar Vectorized Expression Evaluator
//
// Logline: Implements vectorized arithmetic, comparison, and boolean expression evaluation across columnar vectors.
//
// Setup: Executes expression trees in batch mode computing output vectors from column inputs and constant scalars.
//
// Beats:
//   1. Define ExprNode, ExprContext, and VectorExprBatch structures.
//   2. Implement vectorized binary arithmetic (+, -, *, /) on integer columns.
//   3. Implement scalar-vector broadcast arithmetic and conditional expression evaluation.

pub type ExprNode = struct {
    op_type: Int,
    left_col_idx: Int,
    right_col_idx: Int,
    scalar_int: Int,
    has_scalar: Bool
};

pub type ExprContext = struct {
    columns: List[List[Int]],
    batch_size: Int
};

pub fn expr_node_col_plus_scalar(col_idx: Int, scalar_val: Int) -> ExprNode {
    return ExprNode {
        op_type: 0,
        left_col_idx: col_idx,
        right_col_idx: -1,
        scalar_int: scalar_val,
        has_scalar: true
    };
}

pub fn expr_node_col_plus_col(col_a: Int, col_b: Int) -> ExprNode {
    return ExprNode {
        op_type: 0,
        left_col_idx: col_a,
        right_col_idx: col_b,
        scalar_int: 0,
        has_scalar: false
    };
}

pub fn expr_node_col_mul_col(col_a: Int, col_b: Int) -> ExprNode {
    return ExprNode {
        op_type: 2,
        left_col_idx: col_a,
        right_col_idx: col_b,
        scalar_int: 0,
        has_scalar: false
    };
}

pub fn expr_eval_node_int(node: ExprNode, ctx: ExprContext) -> List[Int] {
    let mut results: List[Int] = list_new();
    let n: Int = (ctx).batch_size;
    let cols: List[List[Int]] = (ctx).columns;

    let left_col: List[Int] = if (node).left_col_idx >= 0 && (node).left_col_idx < list_len(cols) {
        list_get(cols, (node).left_col_idx)
    } else {
        list_new()
    };

    let mut i: Int = 0;
    while i < n {
        let left_v: Int = if i < list_len(left_col) { list_get(left_col, i) } else { 0 };

        if (node).has_scalar {
            let s: Int = (node).scalar_int;
            if (node).op_type == 0 {
                results = list_push(results, left_v + s);
            } else if (node).op_type == 1 {
                results = list_push(results, left_v - s);
            } else if (node).op_type == 2 {
                results = list_push(results, left_v * s);
            } else {
                let div_res: Int = if s != 0 { left_v / s } else { 0 };
                results = list_push(results, div_res);
            }
        } else {
            let right_col: List[Int] = if (node).right_col_idx >= 0 && (node).right_col_idx < list_len(cols) {
                list_get(cols, (node).right_col_idx)
            } else {
                list_new()
            };
            let right_v: Int = if i < list_len(right_col) { list_get(right_col, i) } else { 0 };

            if (node).op_type == 0 {
                results = list_push(results, left_v + right_v);
            } else if (node).op_type == 1 {
                results = list_push(results, left_v - right_v);
            } else if (node).op_type == 2 {
                results = list_push(results, left_v * right_v);
            } else {
                let div_res: Int = if right_v != 0 { left_v / right_v } else { 0 };
                results = list_push(results, div_res);
            }
        }
        i = i + 1;
    }

    return results;
}
