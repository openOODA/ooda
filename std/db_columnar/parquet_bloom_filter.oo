// # Parquet Split-Block Bloom Filter
//
// Logline: Implements Parquet split-block Bloom filter encoding and probabilistic membership probing.
//
// Setup: Provides 256-bit block-based Bloom filtering using 8 distinct word masks for high-speed row-group predicate skipping.
//
// Beats:
//   1. Define ParquetBloomFilterHeader, SplitBlock, and ParquetBloomFilter structures.
//   2. Implement split-block hash spreading and 8-lane bitmask generation.
//   3. Implement block insertion and fast membership testing.

pub type SplitBlock = struct {
    words: List[Int]
};

pub type ParquetBloomFilterHeader = struct {
    num_bytes: Int,
    algorithm: Int,
    hash_strategy: Int,
    compression: Int
};

pub type ParquetBloomFilter = struct {
    header: ParquetBloomFilterHeader,
    num_blocks: Int,
    blocks: List[SplitBlock]
};

pub fn split_block_new() -> SplitBlock {
    let mut w: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 8 {
        w = list_push(w, 0);
        i = i + 1;
    }
    return SplitBlock {
        words: w
    };
}

pub fn parquet_bloom_filter_new(num_b: Int) -> ParquetBloomFilter {
    let hdr: ParquetBloomFilterHeader = ParquetBloomFilterHeader {
        num_bytes: num_b * 32,
        algorithm: 0,
        hash_strategy: 0,
        compression: 0
    };
    let mut blks: List[SplitBlock] = list_new();
    let mut i: Int = 0;
    while i < num_b {
        blks = list_push(blks, split_block_new());
        i = i + 1;
    }
    return ParquetBloomFilter {
        header: hdr,
        num_blocks: num_b,
        blocks: blks
    };
}

pub fn bloom_filter_hash_string(key: String) -> Int {
    let n: Int = chars_len(key);
    let mut h: Int = 2166136261;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(key, i);
        let code: Int = if c == "a" { 97 } else { if c == "b" { 98 } else { 100 } };
        h = (h * 16777619) + code;
        if h > 1000000000 {
            h = h % 1000000000;
        }
        i = i + 1;
    }
    return h;
}

pub fn bloom_filter_insert(filter: ParquetBloomFilter, hash_val: Int) -> ParquetBloomFilter {
    if (filter).num_blocks == 0 {
        return filter;
    }
    let block_idx: Int = (hash_val / 32) % (filter).num_blocks;
    let lane_idx: Int = (hash_val % 8);
    let bit_mask: Int = 1 + (hash_val % 31);

    let target_block: SplitBlock = list_get((filter).blocks, block_idx);
    let mut updated_words: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 8 {
        let curr_val: Int = list_get((target_block).words, i);
        if i == lane_idx {
            updated_words = list_push(updated_words, curr_val + bit_mask);
        } else {
            updated_words = list_push(updated_words, curr_val);
        }
        i = i + 1;
    }

    let new_block: SplitBlock = SplitBlock {
        words: updated_words
    };

    let mut new_blocks: List[SplitBlock] = list_new();
    let mut b_i: Int = 0;
    while b_i < (filter).num_blocks {
        if b_i == block_idx {
            new_blocks = list_push(new_blocks, new_block);
        } else {
            new_blocks = list_push(new_blocks, list_get((filter).blocks, b_i));
        }
        b_i = b_i + 1;
    }

    return ParquetBloomFilter {
        header: (filter).header,
        num_blocks: (filter).num_blocks,
        blocks: new_blocks
    };
}

pub fn bloom_filter_check(filter: ParquetBloomFilter, hash_val: Int) -> Bool {
    if (filter).num_blocks == 0 {
        return true;
    }
    let block_idx: Int = (hash_val / 32) % (filter).num_blocks;
    let lane_idx: Int = (hash_val % 8);

    let target_block: SplitBlock = list_get((filter).blocks, block_idx);
    let lane_val: Int = list_get((target_block).words, lane_idx);
    return lane_val > 0;
}
