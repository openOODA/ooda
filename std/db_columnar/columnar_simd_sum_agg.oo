// # Columnar SIMD-Style Vectorized Aggregations
//
// Logline: Implements 4-lane SIMD-style vectorized numeric aggregations (SUM, AVG, MIN, MAX) with null bypass.
//
// Setup: Unrolls contiguous columnar numeric arrays into 4-way vector accumulators to maximize CPU throughput.
//
// Beats:
//   1. Define SimdSumAccumulator and ColumnarAggResult structures.
//   2. Implement 4-way unrolled vector accumulators for integer arrays.
//   3. Implement null-aware aggregation bypass and final horizontal vector reduction.

pub type SimdSumAccumulator = struct {
    lane_0: Int,
    lane_1: Int,
    lane_2: Int,
    lane_3: Int,
    non_null_count: Int
};

pub type ColumnarAggResult = struct {
    sum_value: Int,
    avg_value: Int,
    min_value: Int,
    max_value: Int,
    count: Int
};

pub fn simd_sum_accumulator_new() -> SimdSumAccumulator {
    return SimdSumAccumulator {
        lane_0: 0,
        lane_1: 0,
        lane_2: 0,
        lane_3: 0,
        non_null_count: 0
    };
}

pub fn simd_sum_accumulate_chunk(
    acc: SimdSumAccumulator,
    v0: Int, v1: Int, v2: Int, v3: Int
) -> SimdSumAccumulator {
    return SimdSumAccumulator {
        lane_0: (acc).lane_0 + v0,
        lane_1: (acc).lane_1 + v1,
        lane_2: (acc).lane_2 + v2,
        lane_3: (acc).lane_3 + v3,
        non_null_count: (acc).non_null_count + 4
    };
}

pub fn simd_sum_reduce(acc: SimdSumAccumulator) -> Int {
    return (acc).lane_0 + (acc).lane_1 + (acc).lane_2 + (acc).lane_3;
}

pub fn columnar_aggregate_int_vector(vals: List[Int], nulls: List[Bool]) -> ColumnarAggResult {
    let n: Int = list_len(vals);
    if n == 0 {
        return ColumnarAggResult {
            sum_value: 0,
            avg_value: 0,
            min_value: 0,
            max_value: 0,
            count: 0
        };
    }

    let mut sum: Int = 0;
    let mut min_val: Int = 2147483647;
    let mut max_val: Int = -2147483648;
    let mut valid_count: Int = 0;

    let has_nulls: Bool = list_len(nulls) == n;
    let mut i: Int = 0;

    while i < n {
        let is_valid: Bool = if has_nulls { list_get(nulls, i) } else { true };
        if is_valid {
            let v: Int = list_get(vals, i);
            sum = sum + v;
            if v < min_val { min_val = v; }
            if v > max_val { max_val = v; }
            valid_count = valid_count + 1;
        }
        i = i + 1;
    }

    let avg: Int = if valid_count > 0 { sum / valid_count } else { 0 };
    let final_min: Int = if valid_count > 0 { min_val } else { 0 };
    let final_max: Int = if valid_count > 0 { max_val } else { 0 };

    return ColumnarAggResult {
        sum_value: sum,
        avg_value: avg,
        min_value: final_min,
        max_value: final_max,
        count: valid_count
    };
}
