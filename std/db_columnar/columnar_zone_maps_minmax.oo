// # Columnar Zone Maps & Min-Max Block Indexing
//
// Logline: Implements page and block-level Zone Maps for skipping unneeded data blocks during predicate evaluation.
//
// Setup: Maintains boundary statistics per page and row group, pruning I/O for range and point query filters.
//
// Beats:
//   1. Define ZoneMapEntry and ZoneMapTable structures.
//   2. Implement block registration and min/max envelope tracking.
//   3. Implement predicate evaluation functions determining block match or skip decisions.

pub type ZoneMapEntry = struct {
    block_id: Int,
    min_int: Int,
    max_int: Int,
    has_nulls: Bool,
    row_count: Int
};

pub type ZoneMapTable = struct {
    column_name: String,
    entries: List[ZoneMapEntry],
    total_blocks: Int
};

pub fn zone_map_table_new(name: String) -> ZoneMapTable {
    let empty_entries: List[ZoneMapEntry] = list_new();
    return ZoneMapTable {
        column_name: name,
        entries: empty_entries,
        total_blocks: 0
    };
}

pub fn zone_map_add_block(
    table: ZoneMapTable,
    b_id: Int,
    min_v: Int,
    max_v: Int,
    nulls: Bool,
    rows: Int
) -> ZoneMapTable {
    let entry: ZoneMapEntry = ZoneMapEntry {
        block_id: b_id,
        min_int: min_v,
        max_int: max_v,
        has_nulls: nulls,
        row_count: rows
    };
    let updated: List[ZoneMapEntry] = list_push((table).entries, entry);
    return ZoneMapTable {
        column_name: (table).column_name,
        entries: updated,
        total_blocks: (table).total_blocks + 1
    };
}

pub fn zone_map_filter_equals(table: ZoneMapTable, target: Int) -> List[Int] {
    let mut matching_blocks: List[Int] = list_new();
    let entries_list: List[ZoneMapEntry] = (table).entries;
    let n: Int = list_len(entries_list);
    let mut i: Int = 0;

    while i < n {
        let e: ZoneMapEntry = list_get(entries_list, i);
        if target >= (e).min_int && target <= (e).max_int {
            matching_blocks = list_push(matching_blocks, (e).block_id);
        }
        i = i + 1;
    }

    return matching_blocks;
}

pub fn zone_map_filter_range(table: ZoneMapTable, lower: Int, upper: Int) -> List[Int] {
    let mut matching_blocks: List[Int] = list_new();
    let entries_list: List[ZoneMapEntry] = (table).entries;
    let n: Int = list_len(entries_list);
    let mut i: Int = 0;

    while i < n {
        let e: ZoneMapEntry = list_get(entries_list, i);
        if !((e).max_int < lower || (e).min_int > upper) {
            matching_blocks = list_push(matching_blocks, (e).block_id);
        }
        i = i + 1;
    }

    return matching_blocks;
}
