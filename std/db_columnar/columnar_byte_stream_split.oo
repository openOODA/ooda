// # Columnar Byte Stream Split Floating-Point Encoding
//
// Logline: Implements Parquet/Arrow BYTE_STREAM_SPLIT encoding separating contiguous float bytes into homogeneous streams.
//
// Setup: Scatters IEEE 754 float/double bytes across disjoint streams to dramatically improve SIMD/ZSTD compression ratios.
//
// Beats:
//   1. Define SplitStream4Byte and ByteStreamSplitResult structures.
//   2. Implement 4-byte stream scattering separating 0th, 1st, 2nd, and 3rd byte positions.
//   3. Implement 4-byte stream gathering reconstituting original floating-point byte order.

pub type SplitStream4Byte = struct {
    stream_0: List[Int],
    stream_1: List[Int],
    stream_2: List[Int],
    stream_3: List[Int],
    num_floats: Int
};

pub type ByteStreamSplitResult = struct {
    reconstructed_bytes: List[Int],
    total_floats: Int
};

pub fn split_stream_4byte_new() -> SplitStream4Byte {
    let s0: List[Int] = list_new();
    let s1: List[Int] = list_new();
    let s2: List[Int] = list_new();
    let s3: List[Int] = list_new();
    return SplitStream4Byte {
        stream_0: s0,
        stream_1: s1,
        stream_2: s2,
        stream_3: s3,
        num_floats: 0
    };
}

pub fn byte_stream_split_encode_4byte(raw_bytes: List[Int]) -> SplitStream4Byte {
    let total_bytes: Int = list_len(raw_bytes);
    let num_f: Int = total_bytes / 4;
    let mut s0: List[Int] = list_new();
    let mut s1: List[Int] = list_new();
    let mut s2: List[Int] = list_new();
    let mut s3: List[Int] = list_new();

    let mut i: Int = 0;
    while i < num_f {
        let base_idx: Int = i * 4;
        s0 = list_push(s0, list_get(raw_bytes, base_idx));
        s1 = list_push(s1, list_get(raw_bytes, base_idx + 1));
        s2 = list_push(s2, list_get(raw_bytes, base_idx + 2));
        s3 = list_push(s3, list_get(raw_bytes, base_idx + 3));
        i = i + 1;
    }

    return SplitStream4Byte {
        stream_0: s0,
        stream_1: s1,
        stream_2: s2,
        stream_3: s3,
        num_floats: num_f
    };
}

pub fn byte_stream_split_decode_4byte(split: SplitStream4Byte) -> ByteStreamSplitResult {
    let num_f: Int = (split).num_floats;
    let mut reconstructed: List[Int] = list_new();
    let mut i: Int = 0;

    while i < num_f {
        let b0: Int = list_get((split).stream_0, i);
        let b1: Int = list_get((split).stream_1, i);
        let b2: Int = list_get((split).stream_2, i);
        let b3: Int = list_get((split).stream_3, i);

        reconstructed = list_push(reconstructed, b0);
        reconstructed = list_push(reconstructed, b1);
        reconstructed = list_push(reconstructed, b2);
        reconstructed = list_push(reconstructed, b3);
        i = i + 1;
    }

    return ByteStreamSplitResult {
        reconstructed_bytes: reconstructed,
        total_floats: num_f
    };
}
