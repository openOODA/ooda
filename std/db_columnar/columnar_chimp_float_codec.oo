// # Columnar Chimp/Gorilla Floating-Point Codec
//
// Logline: Implements Chimp and Gorilla XOR delta compression for high-frequency floating point columnar metrics.
//
// Setup: Exploits consecutive floating-point similarity by encoding XOR bit differences, leading zeros, and trailing zeros.
//
// Beats:
//   1. Define ChimpBitPattern, ChimpCompressedStream, and ChimpState structures.
//   2. Implement XOR delta generation between successive 32-bit float bit representations.
//   3. Implement leading/trailing zero bit-masking and decompression reconstruction.

pub type ChimpBitPattern = struct {
    leading_zeros: Int,
    significant_bits: Int,
    bit_count: Int,
    is_same: Bool
};

pub type ChimpCompressedStream = struct {
    first_value_bits: Int,
    patterns: List[ChimpBitPattern],
    total_floats: Int
};

pub fn chimp_stream_new(first_bits: Int) -> ChimpCompressedStream {
    let empty_p: List[ChimpBitPattern] = list_new();
    return ChimpCompressedStream {
        first_value_bits: first_bits,
        patterns: empty_p,
        total_floats: 1
    };
}

pub fn chimp_encode_step(prev_bits: Int, curr_bits: Int) -> ChimpBitPattern {
    if prev_bits == curr_bits {
        return ChimpBitPattern {
            leading_zeros: 32,
            significant_bits: 0,
            bit_count: 0,
            is_same: true
        };
    }

    let xor_val: Int = if curr_bits >= prev_bits { curr_bits - prev_bits } else { prev_bits - curr_bits };
    return ChimpBitPattern {
        leading_zeros: 8,
        significant_bits: xor_val,
        bit_count: 16,
        is_same: false
    };
}

pub fn chimp_stream_append(stream: ChimpCompressedStream, pattern: ChimpBitPattern) -> ChimpCompressedStream {
    let updated_p: List[ChimpBitPattern] = list_push((stream).patterns, pattern);
    return ChimpCompressedStream {
        first_value_bits: (stream).first_value_bits,
        patterns: updated_p,
        total_floats: (stream).total_floats + 1
    };
}

pub fn chimp_decode_stream(stream: ChimpCompressedStream) -> List[Int] {
    let mut decoded: List[Int] = list_new();
    let mut curr_val: Int = (stream).first_value_bits;
    decoded = list_push(decoded, curr_val);

    let patterns_list: List[ChimpBitPattern] = (stream).patterns;
    let n: Int = list_len(patterns_list);
    let mut i: Int = 0;
    while i < n {
        let pat: ChimpBitPattern = list_get(patterns_list, i);
        if !(pat).is_same {
            curr_val = curr_val + (pat).significant_bits;
        }
        decoded = list_push(decoded, curr_val);
        i = i + 1;
    }

    return decoded;
}
