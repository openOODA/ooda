// # Apache Arrow Struct & Nested Array Representation
//
// Logline: Implements Apache Arrow StructArray and nested columnar structures with synchronized child field vectors.
//
// Setup: Represents composite nested structures as parallel child column arrays with top-level null bitmap masks.
//
// Beats:
//   1. Define StructFieldVector and ArrowStructArray structures.
//   2. Implement child field registration and length validation.
//   3. Implement field accessors, struct validity cascading, and tuple extraction.

pub type StructFieldVector = struct {
    field_name: String,
    type_id: Int,
    int_values: List[Int],
    string_values: List[String],
};

pub type ArrowStructArray = struct {
    fields: List[StructFieldVector],
    null_bitmap: List[Bool],
    null_count: Int,
    length: Int,
};

pub fn struct_field_vector_new_int(name: String, vals: List[Int]) -> StructFieldVector {
    let empty_s: List[String] = list_new();
    return StructFieldVector {
        field_name: name,
        type_id: 1,
        int_values: vals,
        string_values: empty_s,
    };
}

pub fn struct_field_vector_new_string(name: String, vals: List[String]) -> StructFieldVector {
    let empty_i: List[Int] = list_new();
    return StructFieldVector {
        field_name: name,
        type_id: 4,
        int_values: empty_i,
        string_values: vals,
    };
}

pub fn arrow_struct_array_new(len: Int) -> ArrowStructArray {
    let mut nulls: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < len {
        nulls = list_push(nulls, true);
        i = i + 1;
    }
    let f_list: List[StructFieldVector] = list_new();
    return ArrowStructArray {
        fields: f_list,
        null_bitmap: nulls,
        null_count: 0,
        length: len,
    };
}

pub fn arrow_struct_array_add_field(arr: ArrowStructArray, field: StructFieldVector) -> ArrowStructArray {
    let updated_fields: List[StructFieldVector] = list_push((arr).fields, field);
    return ArrowStructArray {
        fields: updated_fields,
        null_bitmap: (arr).null_bitmap,
        null_count: (arr).null_count,
        length: (arr).length,
    };
}

pub fn arrow_struct_array_get_field_index(arr: ArrowStructArray, name: String) -> Int {
    let f_list: List[StructFieldVector] = (arr).fields;
    let n: Int = list_len(f_list);
    let mut i: Int = 0;
    while i < n {
        let f: StructFieldVector = list_get(f_list, i);
        if (f).field_name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn arrow_struct_array_get_field_int_val(arr: ArrowStructArray, field_idx: Int, row_idx: Int) -> Int {
    if row_idx < 0 || row_idx >= (arr).length {
        return 0;
    }
    if !list_get((arr).null_bitmap, row_idx) {
        return 0;
    }
    let f_list: List[StructFieldVector] = (arr).fields;
    if field_idx >= 0 && field_idx < list_len(f_list) {
        let f: StructFieldVector = list_get(f_list, field_idx);
        if (f).type_id == 1 && row_idx < list_len((f).int_values) {
            return list_get((f).int_values, row_idx);
        }
    }
    return 0;
}
