// # Apache Arrow Schema & Field Descriptors
//
// Logline: Implements Apache Arrow in-memory columnar schema specifications, type descriptors, and field metadata.
//
// Setup: Provides standard in-memory metadata modeling Arrow data types, nullability flags, and field collections.
//
// Beats:
//   1. Define ArrowField, ArrowKeyValue, and ArrowSchema structures.
//   2. Implement field constructors for primitive, temporal, binary, and nested types.
//   3. Implement schema projection, column name lookup, and field compatibility verification.

pub type ArrowKeyValue = struct {
    key: String,
    value: String
};

pub type ArrowField = struct {
    name: String,
    type_id: Int,
    nullable: Bool,
    metadata: List[ArrowKeyValue]
};

pub type ArrowSchema = struct {
    fields: List[ArrowField],
    metadata: List[ArrowKeyValue]
};

pub fn arrow_field_new(f_name: String, t_id: Int, is_null: Bool) -> ArrowField {
    let empty_meta: List[ArrowKeyValue] = list_new();
    return ArrowField {
        name: f_name,
        type_id: t_id,
        nullable: is_null,
        metadata: empty_meta
    };
}

pub fn arrow_schema_new(f_list: List[ArrowField]) -> ArrowSchema {
    let empty_meta: List[ArrowKeyValue] = list_new();
    return ArrowSchema {
        fields: f_list,
        metadata: empty_meta
    };
}

pub fn arrow_schema_num_fields(schema: ArrowSchema) -> Int {
    return list_len((schema).fields);
}

pub fn arrow_schema_get_field(schema: ArrowSchema, index: Int) -> ArrowField {
    let f: List[ArrowField] = (schema).fields;
    let n: Int = list_len(f);
    if index >= 0 && index < n {
        return list_get(f, index);
    }
    return arrow_field_new("", 0, false);
}

pub fn arrow_schema_index_of(schema: ArrowSchema, name: String) -> Int {
    let f: List[ArrowField] = (schema).fields;
    let n: Int = list_len(f);
    let mut i: Int = 0;
    while i < n {
        let field: ArrowField = list_get(f, i);
        if (field).name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn arrow_schema_project(schema: ArrowSchema, indices: List[Int]) -> ArrowSchema {
    let mut projected_fields: List[ArrowField] = list_new();
    let num_idx: Int = list_len(indices);
    let mut i: Int = 0;
    while i < num_idx {
        let idx: Int = list_get(indices, i);
        let field: ArrowField = arrow_schema_get_field(schema, idx);
        projected_fields = list_push(projected_fields, field);
        i = i + 1;
    }
    return arrow_schema_new(projected_fields);
}
