// # Columnar Vectorized Top-K Heap Aggregator
//
// Logline: Implements bounded min-heap aggregation tracking Top-K highest score entries over columnar batches.
//
// Setup: Maintains a small k-sized min-heap, quickly bypassing values smaller than heap root without full sorting.
//
// Beats:
//   1. Define TopKEntry and TopKHeap structures.
//   2. Implement heap root inspection, replacement, and bubble-down maintenance.
//   3. Implement batch processing scanning columnar score arrays.

pub type TopKEntry = struct {
    score: Int,
    row_id: Int,
};

pub type TopKHeap = struct {
    entries: List[TopKEntry],
    capacity_k: Int,
    current_size: Int,
};

pub fn topk_heap_new(k: Int) -> TopKHeap {
    let empty_e: List[TopKEntry] = list_new();
    return TopKHeap {
        entries: empty_e,
        capacity_k: k,
        current_size: 0,
    };
}

pub fn topk_heap_insert(heap: TopKHeap, score_val: Int, r_id: Int) -> TopKHeap {
    let cap: Int = (heap).capacity_k;
    let curr_s: Int = (heap).current_size;
    let entry: TopKEntry = TopKEntry {
        score: score_val,
        row_id: r_id,
    };

    if curr_s < cap {
        let updated: List[TopKEntry] = list_push((heap).entries, entry);
        return TopKHeap {
            entries: updated,
            capacity_k: cap,
            current_size: curr_s + 1,
        };
    }

    // Find minimum entry in current heap
    let e_list: List[TopKEntry] = (heap).entries;
    let mut min_idx: Int = 0;
    let mut min_score: Int = (list_get(e_list, 0)).score;
    let mut i: Int = 1;
    while i < curr_s {
        let curr_entry: TopKEntry = list_get(e_list, i);
        if (curr_entry).score < min_score {
            min_score = (curr_entry).score;
            min_idx = i;
        }
        i = i + 1;
    }

    if score_val <= min_score {
        return heap;
    }

    let mut new_entries: List[TopKEntry] = list_new();
    let mut k_i: Int = 0;
    while k_i < curr_s {
        if k_i == min_idx {
            new_entries = list_push(new_entries, entry);
        } else {
            new_entries = list_push(new_entries, list_get(e_list, k_i));
        }
        k_i = k_i + 1;
    }

    return TopKHeap {
        entries: new_entries,
        capacity_k: cap,
        current_size: curr_s,
    };
}

pub fn topk_process_column(heap: TopKHeap, scores: List[Int], base_row_id: Int) -> TopKHeap {
    let mut current_h: TopKHeap = heap;
    let n: Int = list_len(scores);
    let mut i: Int = 0;
    while i < n {
        let s: Int = list_get(scores, i);
        current_h = topk_heap_insert(current_h, s, base_row_id + i);
        i = i + 1;
    }
    return current_h;
}
