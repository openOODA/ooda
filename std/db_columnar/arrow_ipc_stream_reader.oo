// # Apache Arrow IPC Streaming Protocol & Reader
//
// Logline: Implements Apache Arrow IPC streaming format and encapsulated message decoding.
//
// Setup: Parses 8-byte continuation and message framing headers, extracting schemas, record batches, and dictionary batches.
//
// Beats:
//   1. Define IpcMessageHeader, IpcBufferDesc, and ArrowIpcStreamReader structures.
//   2. Implement message framing decoding (continuation indicator, metadata length, body length).
//   3. Implement stream sequence state machine reading schemas followed by successive record batches.

pub type IpcBufferDesc = struct {
    offset: Int,
    length: Int
};

pub type IpcMessageHeader = struct {
    message_type: Int,
    metadata_length: Int,
    body_length: Int,
    version: Int
};

pub type ArrowIpcStreamReader = struct {
    current_message_idx: Int,
    has_schema: Bool,
    batches_read: Int,
    total_rows_read: Int,
    is_eos: Bool
};

pub fn ipc_message_header_new(msg_t: Int, meta_len: Int, body_len: Int) -> IpcMessageHeader {
    return IpcMessageHeader {
        message_type: msg_t,
        metadata_length: meta_len,
        body_length: body_len,
        version: 5
    };
}

pub fn arrow_ipc_stream_reader_new() -> ArrowIpcStreamReader {
    return ArrowIpcStreamReader {
        current_message_idx: 0,
        has_schema: false,
        batches_read: 0,
        total_rows_read: 0,
        is_eos: false
    };
}

pub fn arrow_ipc_decode_framing(meta_len_header: Int) -> Int {
    if meta_len_header == 0 {
        return 0;
    }
    return meta_len_header;
}

pub fn arrow_ipc_reader_consume_message(
    reader: ArrowIpcStreamReader,
    header: IpcMessageHeader,
    batch_rows: Int
) -> ArrowIpcStreamReader {
    if (header).metadata_length == 0 {
        return ArrowIpcStreamReader {
            current_message_idx: (reader).current_message_idx + 1,
            has_schema: (reader).has_schema,
            batches_read: (reader).batches_read,
            total_rows_read: (reader).total_rows_read,
            is_eos: true
        };
    }

    if (header).message_type == 0 {
        return ArrowIpcStreamReader {
            current_message_idx: (reader).current_message_idx + 1,
            has_schema: true,
            batches_read: (reader).batches_read,
            total_rows_read: (reader).total_rows_read,
            is_eos: false
        };
    } else if (header).message_type == 1 {
        return ArrowIpcStreamReader {
            current_message_idx: (reader).current_message_idx + 1,
            has_schema: (reader).has_schema,
            batches_read: (reader).batches_read + 1,
            total_rows_read: (reader).total_rows_read + batch_rows,
            is_eos: false
        };
    }

    return ArrowIpcStreamReader {
        current_message_idx: (reader).current_message_idx + 1,
        has_schema: (reader).has_schema,
        batches_read: (reader).batches_read,
        total_rows_read: (reader).total_rows_read,
        is_eos: false
    };
}
