// # Apache Arrow Chunked Array Management
//
// Logline: Implements Apache Arrow ChunkedArray structures combining multiple contiguous array buffers into a logical column.
//
// Setup: Coordinates non-contiguous memory chunks, resolving logical row indexes to specific chunk offsets.
//
// Beats:
//   1. Define ChunkLocation and ArrowChunkedArray structures.
//   2. Implement logical row index resolution and chunk offset translation.
//   3. Implement chunk addition, total length calculation, and flattened extraction.

pub type ChunkLocation = struct {
    chunk_index: Int,
    offset_in_chunk: Int,
};

pub type ArrowChunkedArray = struct {
    type_id: Int,
    chunks_int: List[List[Int]],
    chunk_lengths: List[Int],
    total_length: Int,
    num_chunks: Int,
};

pub fn arrow_chunked_array_new(t_id: Int) -> ArrowChunkedArray {
    let empty_chunks: List[List[Int]] = list_new();
    let empty_lens: List[Int] = list_new();
    return ArrowChunkedArray {
        type_id: t_id,
        chunks_int: empty_chunks,
        chunk_lengths: empty_lens,
        total_length: 0,
        num_chunks: 0,
    };
}

pub fn arrow_chunked_array_add_chunk(arr: ArrowChunkedArray, chunk: List[Int]) -> ArrowChunkedArray {
    let c_len: Int = list_len(chunk);
    let updated_chunks: List[List[Int]] = list_push((arr).chunks_int, chunk);
    let updated_lens: List[Int] = list_push((arr).chunk_lengths, c_len);
    return ArrowChunkedArray {
        type_id: (arr).type_id,
        chunks_int: updated_chunks,
        chunk_lengths: updated_lens,
        total_length: (arr).total_length + c_len,
        num_chunks: (arr).num_chunks + 1,
    };
}

pub fn arrow_chunked_array_locate(arr: ArrowChunkedArray, logical_row: Int) -> ChunkLocation {
    let n_chunks: Int = (arr).num_chunks;
    let mut remaining: Int = logical_row;
    let mut c_i: Int = 0;
    while c_i < n_chunks {
        let c_len: Int = list_get((arr).chunk_lengths, c_i);
        if remaining < c_len {
            return ChunkLocation {
                chunk_index: c_i,
                offset_in_chunk: remaining,
            };
        }
        remaining = remaining - c_len;
        c_i = c_i + 1;
    }
    return ChunkLocation {
        chunk_index: -1,
        offset_in_chunk: 0,
    };
}

pub fn arrow_chunked_array_get_int(arr: ArrowChunkedArray, logical_row: Int) -> Int {
    let loc: ChunkLocation = arrow_chunked_array_locate(arr, logical_row);
    if (loc).chunk_index >= 0 && (loc).chunk_index < (arr).num_chunks {
        let target_chunk: List[Int] = list_get((arr).chunks_int, (loc).chunk_index);
        let offset: Int = (loc).offset_in_chunk;
        if offset >= 0 && offset < list_len(target_chunk) {
            return list_get(target_chunk, offset);
        }
    }
    return 0;
}
