// # Columnar Parquet Physical Scan Operator
//
// Logline: Implements the physical Parquet scan execution operator emitting Arrow-compatible vectorized column chunks.
//
// Setup: Coordinates row-group skipping, projection pushdown, page decoding, and batch emission.
//
// Beats:
//   1. Define ParquetScanConfig, ScanOperatorState, and ParquetScanBatch structures.
//   2. Implement row group iteration and column chunk streaming.
//   3. Implement vectorized batch production yielding typed columnar chunks.

pub type ParquetScanConfig = struct {
    batch_size: Int,
    enable_filter_pushdown: Bool,
    projected_column_indices: List[Int],
};

pub type ScanOperatorState = struct {
    total_row_groups: Int,
    current_row_group_idx: Int,
    rows_emitted: Int,
    is_completed: Bool,
};

pub type ParquetScanBatch = struct {
    int_columns: List[List[Int]],
    num_rows: Int,
    has_more: Bool,
};

pub fn parquet_scan_config_default(proj_indices: List[Int]) -> ParquetScanConfig {
    return ParquetScanConfig {
        batch_size: 2048,
        enable_filter_pushdown: true,
        projected_column_indices: proj_indices,
    };
}

pub fn scan_operator_state_new(num_rgs: Int) -> ScanOperatorState {
    return ScanOperatorState {
        total_row_groups: num_rgs,
        current_row_group_idx: 0,
        rows_emitted: 0,
        is_completed: (num_rgs == 0),
    };
}

pub fn parquet_scan_emit_batch(
    state: ScanOperatorState,
    rg_data: List[List[Int]],
    batch_size: Int
) -> ParquetScanBatch {
    let num_rows_available: Int = if list_len(rg_data) > 0 { list_len(list_get(rg_data, 0)) } else { 0 };
    let has_more_rgs: Bool = ((state).current_row_group_idx + 1) < (state).total_row_groups;

    return ParquetScanBatch {
        int_columns: rg_data,
        num_rows: num_rows_available,
        has_more: has_more_rgs,
    };
}

pub fn scan_operator_advance(state: ScanOperatorState, rows_in_batch: Int) -> ScanOperatorState {
    let next_rg: Int = (state).current_row_group_idx + 1;
    let complete: Bool = next_rg >= (state).total_row_groups;
    return ScanOperatorState {
        total_row_groups: (state).total_row_groups,
        current_row_group_idx: next_rg,
        rows_emitted: (state).rows_emitted + rows_in_batch,
        is_completed: complete,
    };
}
