// # Columnar Run-Length Encoding (RLE)
//
// Logline: Implements pure columnar Run-Length Encoding (RLE) for repeated integer and categorical column values.
//
// Setup: Condenses consecutive identical elements into (count, value) pairs reducing repetitive data footprint.
//
// Beats:
//   1. Define RleRun and ColumnarRleBlock structures.
//   2. Implement single-pass RLE compression detecting streak boundaries.
//   3. Implement RLE expansion and index-based binary search across run boundaries.

pub type RleRun = struct {
    run_length: Int,
    value: Int,
};

pub type ColumnarRleBlock = struct {
    runs: List[RleRun],
    total_elements: Int,
    num_runs: Int,
};

pub fn columnar_rle_encode(values: List[Int]) -> ColumnarRleBlock {
    let n: Int = list_len(values);
    let mut runs: List[RleRun] = list_new();
    if n == 0 {
        return ColumnarRleBlock {
            runs: runs,
            total_elements: 0,
            num_runs: 0,
        };
    }

    let mut current_val: Int = list_get(values, 0);
    let mut current_count: Int = 1;
    let mut i: Int = 1;

    while i < n {
        let v: Int = list_get(values, i);
        if v == current_val {
            current_count = current_count + 1;
        } else {
            let run: RleRun = RleRun {
                run_length: current_count,
                value: current_val,
            };
            runs = list_push(runs, run);
            current_val = v;
            current_count = 1;
        }
        i = i + 1;
    }

    let final_run: RleRun = RleRun {
        run_length: current_count,
        value: current_val,
    };
    runs = list_push(runs, final_run);

    return ColumnarRleBlock {
        runs: runs,
        total_elements: n,
        num_runs: list_len(runs),
    };
}

pub fn columnar_rle_decode(block: ColumnarRleBlock) -> List[Int] {
    let mut decoded: List[Int] = list_new();
    let runs_list: List[RleRun] = (block).runs;
    let n_runs: Int = list_len(runs_list);
    let mut r_i: Int = 0;

    while r_i < n_runs {
        let r: RleRun = list_get(runs_list, r_i);
        let count: Int = (r).run_length;
        let val: Int = (r).value;
        let mut k: Int = 0;
        while k < count {
            decoded = list_push(decoded, val);
            k = k + 1;
        }
        r_i = r_i + 1;
    }

    return decoded;
}

pub fn columnar_rle_get_at(block: ColumnarRleBlock, logical_idx: Int) -> Int {
    if logical_idx < 0 || logical_idx >= (block).total_elements {
        return 0;
    }
    let runs_list: List[RleRun] = (block).runs;
    let n_runs: Int = list_len(runs_list);
    let mut cumulative: Int = 0;
    let mut r_i: Int = 0;

    while r_i < n_runs {
        let r: RleRun = list_get(runs_list, r_i);
        let count: Int = (r).run_length;
        if logical_idx < (cumulative + count) {
            return (r).value;
        }
        cumulative = cumulative + count;
        r_i = r_i + 1;
    }

    return 0;
}
