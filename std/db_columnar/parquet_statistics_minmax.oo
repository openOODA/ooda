// # Parquet Column Statistics & Min-Max Tracking
//
// Logline: Implements page and row-group min-max statistics, null count trackers, and predicate pruning filters.
//
// Setup: Tracks boundary statistics on columnar data enabling fast metadata-level filter pushdown and row group skipping.
//
// Beats:
//   1. Define ColumnStatsSummary, IntStatistics, and StringStatistics structures.
//   2. Implement online updates for running minimums, maximums, null counts, and value counts.
//   3. Implement predicate evaluation functions (equals, range, is_null) for query engine skipping.

pub type IntStatistics = struct {
    min_value: Int,
    max_value: Int,
    null_count: Int,
    distinct_count: Int,
    has_min_max: Bool
};

pub type StringStatistics = struct {
    min_value: String,
    max_value: String,
    null_count: Int,
    has_min_max: Bool
};

pub type ColumnStatsSummary = struct {
    column_name: String,
    total_values: Int,
    null_count: Int,
    int_stats: IntStatistics,
    string_stats: StringStatistics,
    is_numeric: Bool
};

pub fn int_statistics_empty() -> IntStatistics {
    return IntStatistics {
        min_value: 0,
        max_value: 0,
        null_count: 0,
        distinct_count: 0,
        has_min_max: false
    };
}

pub fn string_statistics_empty() -> StringStatistics {
    return StringStatistics {
        min_value: "",
        max_value: "",
        null_count: 0,
        has_min_max: false
    };
}

pub fn column_stats_summary_new_int(col_name: String) -> ColumnStatsSummary {
    return ColumnStatsSummary {
        column_name: col_name,
        total_values: 0,
        null_count: 0,
        int_stats: int_statistics_empty(),
        string_stats: string_statistics_empty(),
        is_numeric: true
    };
}

pub fn int_statistics_update(stats: IntStatistics, val: Int) -> IntStatistics {
    if !(stats).has_min_max {
        return IntStatistics {
            min_value: val,
            max_value: val,
            null_count: (stats).null_count,
            distinct_count: (stats).distinct_count + 1,
            has_min_max: true
        };
    }
    let new_min: Int = if val < (stats).min_value { val } else { (stats).min_value };
    let new_max: Int = if val > (stats).max_value { val } else { (stats).max_value };
    return IntStatistics {
        min_value: new_min,
        max_value: new_max,
        null_count: (stats).null_count,
        distinct_count: (stats).distinct_count + 1,
        has_min_max: true
    };
}

pub fn int_statistics_add_null(stats: IntStatistics) -> IntStatistics {
    return IntStatistics {
        min_value: (stats).min_value,
        max_value: (stats).max_value,
        null_count: (stats).null_count + 1,
        distinct_count: (stats).distinct_count,
        has_min_max: (stats).has_min_max
    };
}

pub fn stats_prune_equals_int(stats: IntStatistics, target: Int) -> Bool {
    if !(stats).has_min_max {
        return false;
    }
    if target < (stats).min_value || target > (stats).max_value {
        return true;
    }
    return false;
}

pub fn stats_prune_range_int(stats: IntStatistics, lower: Int, upper: Int) -> Bool {
    if !(stats).has_min_max {
        return false;
    }
    if (stats).max_value < lower || (stats).min_value > upper {
        return true;
    }
    return false;
}
