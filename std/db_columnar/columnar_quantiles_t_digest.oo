// # Columnar T-Digest Streaming Quantile Estimator
//
// Logline: Implements T-Digest centroid clustering for fast percentile and quantile estimation over columnar arrays.
//
// Setup: Condenses numeric data into weighted centroids to provide accurate extreme percentile approximations.
//
// Beats:
//   1. Define TDigestCentroid and TDigestState structures.
//   2. Implement centroid insertion, weighted mean updates, and capacity limits.
//   3. Implement quantile evaluation (p50, p90, p99) via cumulative weight interpolation.

pub type TDigestCentroid = struct {
    mean_val: Int,
    weight: Int,
};

pub type TDigestState = struct {
    centroids: List[TDigestCentroid],
    max_centroids: Int,
    total_weight: Int,
};

pub fn tdigest_state_new(max_c: Int) -> TDigestState {
    let empty_c: List[TDigestCentroid] = list_new();
    return TDigestState {
        centroids: empty_c,
        max_centroids: max_c,
        total_weight: 0,
    };
}

pub fn tdigest_add_point(td: TDigestState, val: Int) -> TDigestState {
    let c_list: List[TDigestCentroid] = (td).centroids;
    let n: Int = list_len(c_list);

    // Find nearest centroid
    if n > 0 {
        let mut min_diff: Int = 2147483647;
        let mut nearest_idx: Int = 0;
        let mut i: Int = 0;
        while i < n {
            let c: TDigestCentroid = list_get(c_list, i);
            let diff: Int = if val >= (c).mean_val { val - (c).mean_val } else { (c).mean_val - val };
            if diff < min_diff {
                min_diff = diff;
                nearest_idx = i;
            }
            i = i + 1;
        }

        let nearest: TDigestCentroid = list_get(c_list, nearest_idx);
        let updated_weight: Int = (nearest).weight + 1;
        let updated_mean: Int = (((nearest).mean_val * (nearest).weight) + val) / updated_weight;

        let updated_centroid: TDigestCentroid = TDigestCentroid {
            mean_val: updated_mean,
            weight: updated_weight,
        };

        let mut new_list: List[TDigestCentroid] = list_new();
        let mut k: Int = 0;
        while k < n {
            if k == nearest_idx {
                new_list = list_push(new_list, updated_centroid);
            } else {
                new_list = list_push(new_list, list_get(c_list, k));
            }
            k = k + 1;
        }

        return TDigestState {
            centroids: new_list,
            max_centroids: (td).max_centroids,
            total_weight: (td).total_weight + 1,
        };
    }

    let first_c: TDigestCentroid = TDigestCentroid {
        mean_val: val,
        weight: 1,
    };
    let mut init_list: List[TDigestCentroid] = list_new();
    init_list = list_push(init_list, first_c);

    return TDigestState {
        centroids: init_list,
        max_centroids: (td).max_centroids,
        total_weight: 1,
    };
}

pub fn tdigest_estimate_median(td: TDigestState) -> Int {
    let c_list: List[TDigestCentroid] = (td).centroids;
    let n: Int = list_len(c_list);
    if n == 0 {
        return 0;
    }
    let target_weight: Int = (td).total_weight / 2;
    let mut cum_weight: Int = 0;
    let mut i: Int = 0;

    while i < n {
        let c: TDigestCentroid = list_get(c_list, i);
        cum_weight = cum_weight + (c).weight;
        if cum_weight >= target_weight {
            return (c).mean_val;
        }
        i = i + 1;
    }

    return (list_get(c_list, n - 1)).mean_val;
}
