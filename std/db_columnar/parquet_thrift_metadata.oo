// # Parquet Thrift Metadata Schema & File Layout
//
// Logline: Implements Parquet metadata structures including FileMetaData, RowGroups, ColumnChunks, and SchemaElements.
//
// Setup: Encapsulates Apache Parquet format metadata specification for columnar file parsing and serialization.
//
// Beats:
//   1. Define Thrift metadata structs for schema elements, column chunks, row groups, and file footer.
//   2. Provide constructors and helper functions for building Parquet schemas and column descriptors.
//   3. Implement schema lookup, column projection validation, and row group size aggregation.

pub type SchemaElement = struct {
    name: String,
    type_code: Int,
    repetition_type: Int,
    num_children: Int,
    scale: Int,
    precision: Int,
    field_id: Int
};

pub type ColumnMetaData = struct {
    column_name: String,
    type_code: Int,
    codec: Int,
    num_values: Int,
    total_uncompressed_size: Int,
    total_compressed_size: Int,
    data_page_offset: Int,
    dictionary_page_offset: Int,
    has_dictionary: Bool
};

pub type ColumnChunk = struct {
    file_path: String,
    file_offset: Int,
    meta_data: ColumnMetaData
};

pub type RowGroup = struct {
    columns: List[ColumnChunk],
    total_byte_size: Int,
    num_rows: Int,
    file_offset: Int
};

pub type FileMetaData = struct {
    version: Int,
    schema: List[SchemaElement],
    num_rows: Int,
    row_groups: List[RowGroup],
    created_by: String
};

pub fn schema_element_new(name: String, t_code: Int, rep_type: Int, num_child: Int) -> SchemaElement {
    return SchemaElement {
        name: name,
        type_code: t_code,
        repetition_type: rep_type,
        num_children: num_child,
        scale: 0,
        precision: 0,
        field_id: 0
    };
}

pub fn column_metadata_new(
    name: String,
    t_code: Int,
    codec_id: Int,
    values_count: Int,
    uncompressed: Int,
    compressed: Int,
    page_off: Int
) -> ColumnMetaData {
    return ColumnMetaData {
        column_name: name,
        type_code: t_code,
        codec: codec_id,
        num_values: values_count,
        total_uncompressed_size: uncompressed,
        total_compressed_size: compressed,
        data_page_offset: page_off,
        dictionary_page_offset: 0,
        has_dictionary: false
    };
}

pub fn row_group_new(num_r: Int, offset: Int) -> RowGroup {
    let empty_cols: List[ColumnChunk] = list_new();
    return RowGroup {
        columns: empty_cols,
        total_byte_size: 0,
        num_rows: num_r,
        file_offset: offset
    };
}

pub fn row_group_add_column(rg: RowGroup, col: ColumnChunk) -> RowGroup {
    let cols: List[ColumnChunk] = list_push((rg).columns, col);
    let added_size: Int = ((col).meta_data).total_compressed_size;
    return RowGroup {
        columns: cols,
        total_byte_size: (rg).total_byte_size + added_size,
        num_rows: (rg).num_rows,
        file_offset: (rg).file_offset
    };
}

pub fn file_metadata_new(ver: Int, creator: String) -> FileMetaData {
    let empty_schema: List[SchemaElement] = list_new();
    let empty_rgs: List[RowGroup] = list_new();
    return FileMetaData {
        version: ver,
        schema: empty_schema,
        num_rows: 0,
        row_groups: empty_rgs,
        created_by: creator
    };
}

pub fn file_metadata_add_row_group(fmd: FileMetaData, rg: RowGroup) -> FileMetaData {
    let rgs: List[RowGroup] = list_push((fmd).row_groups, rg);
    return FileMetaData {
        version: (fmd).version,
        schema: (fmd).schema,
        num_rows: (fmd).num_rows + (rg).num_rows,
        row_groups: rgs,
        created_by: (fmd).created_by
    };
}

pub fn file_metadata_find_column_index(fmd: FileMetaData, name: String) -> Int {
    let schema_list: List[SchemaElement] = (fmd).schema;
    let n: Int = list_len(schema_list);
    let mut i: Int = 0;
    while i < n {
        let elem: SchemaElement = list_get(schema_list, i);
        if (elem).name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}
