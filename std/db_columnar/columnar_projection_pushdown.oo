// # Columnar Projection Pushdown & Column Pruning
//
// Logline: Implements query projection pushdown pruning unreferenced physical column chunks prior to I/O and decoding.
//
// Setup: Masks and filters table schemas down to requested column indices, preventing disk read and memory allocation for unused attributes.
//
// Beats:
//   1. Define ColumnProjectionRequest and ProjectedColumnLayout structures.
//   2. Implement projection mask compilation and unused column chunk pruning.
//   3. Implement projected columnar schema mapping and index translation.

pub type ColumnProjectionRequest = struct {
    projected_names: List[String],
    num_projected: Int
};

pub type ProjectedColumnLayout = struct {
    physical_indices: List[Int],
    column_names: List[String],
    num_columns: Int,
    pruned_column_count: Int
};

pub fn column_projection_request_new(names: List[String]) -> ColumnProjectionRequest {
    return ColumnProjectionRequest {
        projected_names: names,
        num_projected: list_len(names)
    };
}

pub fn projection_pushdown_plan(
    all_columns: List[String],
    req: ColumnProjectionRequest
) -> ProjectedColumnLayout {
    let mut selected_indices: List[Int] = list_new();
    let mut selected_names: List[String] = list_new();
    let total_physical: Int = list_len(all_columns);
    let target_names: List[String] = (req).projected_names;
    let n_targets: Int = list_len(target_names);

    let mut t_i: Int = 0;
    while t_i < n_targets {
        let target: String = list_get(target_names, t_i);
        let mut p_i: Int = 0;
        let mut found: Bool = false;
        while p_i < total_physical && !found {
            if list_get(all_columns, p_i) == target {
                selected_indices = list_push(selected_indices, p_i);
                selected_names = list_push(selected_names, target);
                found = true;
            }
            p_i = p_i + 1;
        }
        t_i = t_i + 1;
    }

    let kept_count: Int = list_len(selected_indices);
    let pruned_count: Int = total_physical - kept_count;

    return ProjectedColumnLayout {
        physical_indices: selected_indices,
        column_names: selected_names,
        num_columns: kept_count,
        pruned_column_count: pruned_count
    };
}

pub fn projection_is_column_required(layout: ProjectedColumnLayout, physical_idx: Int) -> Bool {
    let indices: List[Int] = (layout).physical_indices;
    let n: Int = list_len(indices);
    let mut i: Int = 0;
    while i < n {
        if list_get(indices, i) == physical_idx {
            return true;
        }
        i = i + 1;
    }
    return false;
}
