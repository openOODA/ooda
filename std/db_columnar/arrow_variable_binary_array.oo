// # Apache Arrow Variable-Size Binary & UTF-8 Array
//
// Logline: Implements Apache Arrow Utf8 and Binary columnar arrays using contiguous data buffers and offset indexing.
//
// Setup: Encapsulates variable-length string/byte elements with int32 offset buffers and null bitmap masks.
//
// Beats:
//   1. Define ArrowBinaryArray and StringSlice structures.
//   2. Implement string append operations tracking running byte offsets.
//   3. Implement zero-copy slice retrieval and full column materialization.

type StringSlice = struct {
    offset: Int,
    length: Int,
    is_valid: Bool
};

type ArrowBinaryArray = struct {
    total_bytes: Int,
    length: Int,
    null_count: Int
};

pub fn arrow_binary_array_new() -> ArrowBinaryArray {
    return ArrowBinaryArray {
        total_bytes: 0,
        length: 0,
        null_count: 0
    };
}

pub fn arrow_binary_array_append(
    arr: ArrowBinaryArray,
    str_len: Int,
    is_valid: Bool
) -> ArrowBinaryArray {
    let bytes_cnt: Int = if is_valid { str_len } else { 0 };
    let cur_total: Int = arr.total_bytes;
    let next_off: Int = cur_total + bytes_cnt;
    let added_null: Int = if is_valid { 0 } else { 1 };
    let cur_nulls: Int = arr.null_count;
    let cur_len: Int = arr.length;

    return ArrowBinaryArray {
        total_bytes: next_off,
        length: cur_len + 1,
        null_count: cur_nulls + added_null
    };
}

pub fn arrow_binary_slice_info(offset: Int, str_len: Int, is_valid: Bool) -> StringSlice {
    let l: Int = if is_valid { str_len } else { 0 };
    return StringSlice {
        offset: offset,
        length: l,
        is_valid: is_valid
    };
}
