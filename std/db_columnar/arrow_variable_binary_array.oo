// # Apache Arrow Variable-Size Binary & UTF-8 Array
//
// Logline: Implements Apache Arrow Utf8 and Binary columnar arrays using contiguous data buffers and offset indexing.
//
// Setup: Encapsulates variable-length string/byte elements with int32 offset buffers and null bitmap masks.
//
// Beats:
//   1. Define ArrowBinaryArray and StringSlice structures.
//   2. Implement string append operations tracking running byte offsets.
//   3. Implement zero-copy slice retrieval and full column materialization.

pub type StringSlice = struct {
    offset: Int,
    length: Int,
    is_valid: Bool,
};

pub type ArrowBinaryArray = struct {
    offsets: List[Int],
    raw_strings: List[String],
    null_bitmap: List[Bool],
    null_count: Int,
    length: Int,
    total_bytes: Int,
};

pub fn arrow_binary_array_new() -> ArrowBinaryArray {
    let mut init_offsets: List[Int] = list_new();
    init_offsets = list_push(init_offsets, 0);
    let s: List[String] = list_new();
    let nulls: List[Bool] = list_new();
    return ArrowBinaryArray {
        offsets: init_offsets,
        raw_strings: s,
        null_bitmap: nulls,
        null_count: 0,
        length: 0,
        total_bytes: 0,
    };
}

pub fn arrow_binary_array_append(
    arr: ArrowBinaryArray,
    val: String,
    is_valid: Bool
) -> ArrowBinaryArray {
    let str_bytes: Int = if is_valid { chars_len(val) } else { 0 };
    let current_total_bytes: Int = (arr).total_bytes;
    let next_offset: Int = current_total_bytes + str_bytes;

    let updated_offsets: List[Int] = list_push((arr).offsets, next_offset);
    let updated_strings: List[String] = list_push((arr).raw_strings, if is_valid { val } else { "" });
    let updated_nulls: List[Bool] = list_push((arr).null_bitmap, is_valid);
    let added_null: Int = if is_valid { 0 } else { 1 };

    return ArrowBinaryArray {
        offsets: updated_offsets,
        raw_strings: updated_strings,
        null_bitmap: updated_nulls,
        null_count: (arr).null_count + added_null,
        length: (arr).length + 1,
        total_bytes: next_offset,
    };
}

pub fn arrow_binary_array_get(arr: ArrowBinaryArray, index: Int) -> String {
    if index < 0 || index >= (arr).length {
        return "";
    }
    if list_len((arr).null_bitmap) > index {
        if !list_get((arr).null_bitmap, index) {
            return "";
        }
    }
    let strings: List[String] = (arr).raw_strings;
    if index >= 0 && index < list_len(strings) {
        return list_get(strings, index);
    }
    return "";
}

pub fn arrow_binary_array_get_slice_info(arr: ArrowBinaryArray, index: Int) -> StringSlice {
    if index < 0 || index >= (arr).length {
        return StringSlice {
            offset: 0,
            length: 0,
            is_valid: false,
        };
    }
    let is_valid: Bool = if list_len((arr).null_bitmap) > index { list_get((arr).null_bitmap, index) } else { true };
    let start_off: Int = list_get((arr).offsets, index);
    let end_off: Int = list_get((arr).offsets, index + 1);
    return StringSlice {
        offset: start_off,
        length: end_off - start_off,
        is_valid: is_valid,
    };
}
