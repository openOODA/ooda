// # Parquet Dictionary Page Encoding & Decoder
//
// Logline: Implements Parquet dictionary pages for string and integer symbol compression and decompression.
//
// Setup: Decodes and constructs dictionary pages containing distinct values and index streams for compact columnar pages.
//
// Beats:
//   1. Define DictionaryPageHeader, ParquetDictionaryPage, and DictionaryTable structures.
//   2. Implement dictionary insertion, deduplication, and index array generation.
//   3. Implement dictionary value lookup and integer index mapping into materialized columns.

pub type DictionaryPageHeader = struct {
    num_values: Int,
    encoding: Int,
    is_sorted: Bool,
    uncompressed_page_size: Int,
    compressed_page_size: Int,
};

pub type DictionaryTable = struct {
    distinct_strings: List[String],
    distinct_ints: List[Int],
    entry_count: Int,
    total_bytes: Int,
};

pub type ParquetDictionaryPage = struct {
    header: DictionaryPageHeader,
    dictionary: DictionaryTable,
    indices: List[Int],
};

pub fn dictionary_table_new() -> DictionaryTable {
    let s: List[String] = list_new();
    let ints: List[Int] = list_new();
    return DictionaryTable {
        distinct_strings: s,
        distinct_ints: ints,
        entry_count: 0,
        total_bytes: 0,
    };
}

pub fn dictionary_table_find_string(dict: DictionaryTable, target: String) -> Int {
    let entries: List[String] = (dict).distinct_strings;
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        if list_get(entries, i) == target {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn dictionary_table_insert_string(dict: DictionaryTable, val: String) -> DictionaryTable {
    let existing: Int = dictionary_table_find_string(dict, val);
    if existing >= 0 {
        return dict;
    }
    let updated_entries: List[String] = list_push((dict).distinct_strings, val);
    let str_bytes: Int = chars_len(val);
    return DictionaryTable {
        distinct_strings: updated_entries,
        distinct_ints: (dict).distinct_ints,
        entry_count: (dict).entry_count + 1,
        total_bytes: (dict).total_bytes + str_bytes,
    };
}

pub fn parquet_dictionary_page_new(num_v: Int, enc: Int) -> ParquetDictionaryPage {
    let hdr: DictionaryPageHeader = DictionaryPageHeader {
        num_values: num_v,
        encoding: enc,
        is_sorted: false,
        uncompressed_page_size: 0,
        compressed_page_size: 0,
    };
    let empty_indices: List[Int] = list_new();
    return ParquetDictionaryPage {
        header: hdr,
        dictionary: dictionary_table_new(),
        indices: empty_indices,
    };
}

pub fn dictionary_page_lookup_string(page: ParquetDictionaryPage, index: Int) -> String {
    let dict: DictionaryTable = (page).dictionary;
    let entries: List[String] = (dict).distinct_strings;
    let n: Int = list_len(entries);
    if index >= 0 && index < n {
        return list_get(entries, index);
    }
    return "";
}

pub fn dictionary_page_materialize_strings(page: ParquetDictionaryPage) -> List[String] {
    let mut materialized: List[String] = list_new();
    let idx_list: List[Int] = (page).indices;
    let n: Int = list_len(idx_list);
    let mut i: Int = 0;
    while i < n {
        let idx: Int = list_get(idx_list, i);
        let s: String = dictionary_page_lookup_string(page, idx);
        materialized = list_push(materialized, s);
        i = i + 1;
    }
    return materialized;
}
