// # Parquet Column Chunk Reader & Page Iterator
//
// Logline: Implements sequential page iteration, buffer slicing, and offset tracking for Parquet column chunks.
//
// Setup: Traverses physical column chunk byte streams, reading headers, dictionary pages, and sequential data pages.
//
// Beats:
//   1. Define PageSlice, ColumnChunkReaderConfig, and ColumnChunkReader structures.
//   2. Implement page boundary iteration, byte offset progression, and slice extraction.
//   3. Implement column-level progress tracking and total value counter verification.

pub type PageSlice = struct {
    page_index: Int,
    byte_offset: Int,
    compressed_bytes: Int,
    uncompressed_bytes: Int,
    num_values: Int,
    is_dictionary: Bool,
};

pub type ColumnChunkReaderConfig = struct {
    max_page_buffer_bytes: Int,
    prefetch_pages: Bool,
};

pub type ColumnChunkReader = struct {
    column_name: String,
    total_values: Int,
    values_read: Int,
    current_byte_offset: Int,
    total_compressed_bytes: Int,
    page_slices: List[PageSlice],
    current_page_idx: Int,
    is_exhausted: Bool,
};

pub fn column_chunk_reader_new(name: String, total_vals: Int, comp_bytes: Int) -> ColumnChunkReader {
    let empty_slices: List[PageSlice] = list_new();
    return ColumnChunkReader {
        column_name: name,
        total_values: total_vals,
        values_read: 0,
        current_byte_offset: 0,
        total_compressed_bytes: comp_bytes,
        page_slices: empty_slices,
        current_page_idx: 0,
        is_exhausted: false,
    };
}

pub fn column_chunk_reader_add_page(
    reader: ColumnChunkReader,
    comp_size: Int,
    uncomp_size: Int,
    vals_in_page: Int,
    is_dict: Bool
) -> ColumnChunkReader {
    let slice_idx: Int = list_len((reader).page_slices);
    let slice: PageSlice = PageSlice {
        page_index: slice_idx,
        byte_offset: (reader).current_byte_offset,
        compressed_bytes: comp_size,
        uncompressed_bytes: uncomp_size,
        num_values: vals_in_page,
        is_dictionary: is_dict,
    };

    let updated_slices: List[PageSlice] = list_push((reader).page_slices, slice);
    return ColumnChunkReader {
        column_name: (reader).column_name,
        total_values: (reader).total_values,
        values_read: (reader).values_read,
        current_byte_offset: (reader).current_byte_offset + comp_size,
        total_compressed_bytes: (reader).total_compressed_bytes,
        page_slices: updated_slices,
        current_page_idx: (reader).current_page_idx,
        is_exhausted: (reader).is_exhausted,
    };
}

pub fn column_chunk_reader_next_page(reader: ColumnChunkReader) -> ColumnChunkReader {
    let total_pages: Int = list_len((reader).page_slices);
    let next_idx: Int = (reader).current_page_idx + 1;
    if next_idx >= total_pages {
        return ColumnChunkReader {
            column_name: (reader).column_name,
            total_values: (reader).total_values,
            values_read: (reader).values_read,
            current_byte_offset: (reader).current_byte_offset,
            total_compressed_bytes: (reader).total_compressed_bytes,
            page_slices: (reader).page_slices,
            current_page_idx: next_idx,
            is_exhausted: true,
        };
    }

    let curr_slice: PageSlice = list_get((reader).page_slices, (reader).current_page_idx);
    let added_vals: Int = (curr_slice).num_values;

    return ColumnChunkReader {
        column_name: (reader).column_name,
        total_values: (reader).total_values,
        values_read: (reader).values_read + added_vals,
        current_byte_offset: (reader).current_byte_offset,
        total_compressed_bytes: (reader).total_compressed_bytes,
        page_slices: (reader).page_slices,
        current_page_idx: next_idx,
        is_exhausted: false,
    };
}

pub fn column_chunk_reader_current_slice(reader: ColumnChunkReader) -> PageSlice {
    let idx: Int = (reader).current_page_idx;
    let slices: List[PageSlice] = (reader).page_slices;
    if idx >= 0 && idx < list_len(slices) {
        return list_get(slices, idx);
    }
    return PageSlice {
        page_index: -1,
        byte_offset: 0,
        compressed_bytes: 0,
        uncompressed_bytes: 0,
        num_values: 0,
        is_dictionary: false,
    };
}
