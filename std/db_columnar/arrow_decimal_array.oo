// # Apache Arrow Decimal128 Array Representation
//
// Logline: Implements Apache Arrow Decimal128 fixed-width columnar array representation with precision and scale.
//
// Setup: Encapsulates 128-bit high-precision integers (high/low 64-bit parts) supporting exact financial and decimal math.
//
// Beats:
//   1. Define Decimal128, DecimalConfig, and ArrowDecimalArray structures.
//   2. Implement two's complement arithmetic and scaling factor operations.
//   3. Implement string formatting and column-level arithmetic summations.

type Decimal128 = struct {
    high: Int,
    low: Int,
    is_negative: Bool
};

type DecimalConfig = struct {
    precision: Int,
    scale: Int
};

type ArrowDecimalArray = struct {
    null_count: Int,
    length: Int,
    config: DecimalConfig
};

pub fn decimal128_from_int(val: Int) -> Decimal128 {
    let neg: Bool = val < 0;
    let abs_val: Int = if neg { 0 - val } else { val };
    return Decimal128 {
        high: 0,
        low: abs_val,
        is_negative: neg
    };
}

pub fn decimal128_add(a: Decimal128, b: Decimal128) -> Decimal128 {
    if a.is_negative == b.is_negative {
        let sum_low: Int = a.low + b.low;
        let carry: Int = sum_low / 1000000000;
        let low_rem: Int = sum_low % 1000000000;
        let sum_high: Int = a.high + b.high + carry;
        return Decimal128 {
            high: sum_high,
            low: low_rem,
            is_negative: a.is_negative
        };
    } else {
        if a.low >= b.low {
            return Decimal128 {
                high: a.high - b.high,
                low: a.low - b.low,
                is_negative: a.is_negative
            };
        } else {
            return Decimal128 {
                high: b.high - a.high,
                low: b.low - a.low,
                is_negative: b.is_negative
            };
        }
    }
}

pub fn arrow_decimal_array_new(prec: Int, sc: Int) -> ArrowDecimalArray {
    let cfg: DecimalConfig = DecimalConfig {
        precision: prec,
        scale: sc
    };
    return ArrowDecimalArray {
        null_count: 0,
        length: 0,
        config: cfg
    };
}

pub fn arrow_decimal_array_push(
    arr: ArrowDecimalArray,
    val: Decimal128,
    is_valid: Bool
) -> ArrowDecimalArray {
    let added_null: Int = if is_valid { 0 } else { 1 };
    return ArrowDecimalArray {
        null_count: arr.null_count + added_null,
        length: arr.length + 1,
        config: arr.config
    };
}
