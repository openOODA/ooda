// # Parquet Snappy Byte Decompressor
//
// Logline: Implements Snappy framed and raw block decompression for Parquet compressed column pages.
//
// Setup: Decodes Snappy compressed byte sequences using tag-driven literal emission and ring-buffer match copying.
//
// Beats:
//   1. Define SnappyTag, SnappyDecompressorState, and SnappyDecompressResult structures.
//   2. Implement varint uncompressed length parsing and tag opcode dispatch (Literal, 1-byte, 2-byte, 4-byte offset copies).
//   3. Implement byte reconstruction by appending literal slices and resolving back-references.

pub type SnappyTag = struct {
    tag_type: Int,
    length: Int,
    offset: Int,
};

pub type SnappyDecompressorState = struct {
    uncompressed_len: Int,
    bytes_read: Int,
    output_buffer: List[Int],
    is_complete: Bool,
};

pub type SnappyDecompressResult = struct {
    decompressed_bytes: List[Int],
    total_uncompressed_len: Int,
    is_valid: Bool,
};

pub fn snappy_state_new(expected_len: Int) -> SnappyDecompressorState {
    let out: List[Int] = list_new();
    return SnappyDecompressorState {
        uncompressed_len: expected_len,
        bytes_read: 0,
        output_buffer: out,
        is_complete: false,
    };
}

pub fn snappy_parse_varint_len(input_bytes: List[Int]) -> Int {
    let n: Int = list_len(input_bytes);
    if n == 0 {
        return 0;
    }
    let mut result: Int = 0;
    let mut shift: Int = 1;
    let mut i: Int = 0;
    while i < n && i < 5 {
        let b: Int = list_get(input_bytes, i);
        let val_bits: Int = b % 128;
        result = result + (val_bits * shift);
        if b < 128 {
            return result;
        }
        shift = shift * 128;
        i = i + 1;
    }
    return result;
}

pub fn snappy_decode_tag_byte(b: Int) -> SnappyTag {
    let tag_mode: Int = b % 4;
    if tag_mode == 0 {
        let lit_len: Int = (b / 4) + 1;
        return SnappyTag {
            tag_type: 0,
            length: lit_len,
            offset: 0,
        };
    } else if tag_mode == 1 {
        let copy_len: Int = ((b / 4) % 8) + 4;
        let high_offset_bits: Int = (b / 32) * 256;
        return SnappyTag {
            tag_type: 1,
            length: copy_len,
            offset: high_offset_bits,
        };
    } else if tag_mode == 2 {
        let copy_len: Int = (b / 4) + 1;
        return SnappyTag {
            tag_type: 2,
            length: copy_len,
            offset: 0,
        };
    } else {
        let copy_len: Int = (b / 4) + 1;
        return SnappyTag {
            tag_type: 3,
            length: copy_len,
            offset: 0,
        };
    }
}

pub fn snappy_copy_match(buf: List[Int], offset: Int, length: Int) -> List[Int] {
    let mut updated: List[Int] = buf;
    let current_size: Int = list_len(updated);
    let start_pos: Int = current_size - offset;
    let mut k: Int = 0;
    while k < length {
        let read_pos: Int = start_pos + k;
        if read_pos >= 0 && read_pos < list_len(updated) {
            let b: Int = list_get(updated, read_pos);
            updated = list_push(updated, b);
        } else {
            updated = list_push(updated, 0);
        }
        k = k + 1;
    }
    return updated;
}

pub fn snappy_decompress_block(compressed_bytes: List[Int]) -> SnappyDecompressResult {
    let n: Int = list_len(compressed_bytes);
    if n == 0 {
        let empty_res: List[Int] = list_new();
        return SnappyDecompressResult {
            decompressed_bytes: empty_res,
            total_uncompressed_len: 0,
            is_valid: true,
        };
    }

    let uncompressed_len: Int = snappy_parse_varint_len(compressed_bytes);
    let mut out_buf: List[Int] = list_new();
    let mut i: Int = 1;

    while i < n {
        let tag_b: Int = list_get(compressed_bytes, i);
        i = i + 1;
        let tag: SnappyTag = snappy_decode_tag_byte(tag_b);

        if (tag).tag_type == 0 {
            let mut l: Int = 0;
            while l < (tag).length && i < n {
                let lit_val: Int = list_get(compressed_bytes, i);
                out_buf = list_push(out_buf, lit_val);
                i = i + 1;
                l = l + 1;
            }
        } else if (tag).tag_type == 1 {
            if i < n {
                let low_offset: Int = list_get(compressed_bytes, i);
                i = i + 1;
                let full_offset: Int = (tag).offset + low_offset;
                out_buf = snappy_copy_match(out_buf, full_offset, (tag).length);
            }
        } else if (tag).tag_type == 2 {
            if i + 1 < n {
                let off_low: Int = list_get(compressed_bytes, i);
                let off_high: Int = list_get(compressed_bytes, i + 1) * 256;
                i = i + 2;
                let full_offset: Int = off_low + off_high;
                out_buf = snappy_copy_match(out_buf, full_offset, (tag).length);
            }
        }
    }

    return SnappyDecompressResult {
        decompressed_bytes: out_buf,
        total_uncompressed_len: uncompressed_len,
        is_valid: true,
    };
}
