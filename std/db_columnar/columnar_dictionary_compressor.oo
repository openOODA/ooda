// # Columnar Adaptive Dictionary Compressor
//
// Logline: Implements adaptive dictionary compression with automatic cardinality tracking and plain encoding fallback.
//
// Setup: Encodes string/symbol columns into dictionary indices, gracefully falling back to plain encoding if distinct ratio exceeds threshold.
//
// Beats:
//   1. Define DictCompressorConfig, DynamicDictState, and CompressedColumnPage structures.
//   2. Implement distinct value insertion, index mapping, and cardinality ratio calculation.
//   3. Implement adaptive fallback mechanism switching to plain columnar encoding when threshold triggers.

pub type DictCompressorConfig = struct {
    max_dictionary_entries: Int,
    max_cardinality_ratio: Float,
};

pub type DynamicDictState = struct {
    config: DictCompressorConfig,
    dictionary: List[String],
    encoded_indices: List[Int],
    total_elements: Int,
    is_fallback_triggered: Bool,
};

pub type CompressedColumnPage = struct {
    encoding_type: Int,
    dictionary_entries: List[String],
    indices: List[Int],
    raw_elements: List[String],
    num_rows: Int,
};

pub fn dict_compressor_config_default() -> DictCompressorConfig {
    return DictCompressorConfig {
        max_dictionary_entries: 4096,
        max_cardinality_ratio: 0.5,
    };
}

pub fn dynamic_dict_state_new(cfg: DictCompressorConfig) -> DynamicDictState {
    let d: List[String] = list_new();
    let idxs: List[Int] = list_new();
    return DynamicDictState {
        config: cfg,
        dictionary: d,
        encoded_indices: idxs,
        total_elements: 0,
        is_fallback_triggered: false,
    };
}

pub fn dynamic_dict_find_index(dict: List[String], target: String) -> Int {
    let n: Int = list_len(dict);
    let mut i: Int = 0;
    while i < n {
        if list_get(dict, i) == target {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn dynamic_dict_append(state: DynamicDictState, val: String) -> DynamicDictState {
    if (state).is_fallback_triggered {
        return state;
    }

    let existing_idx: Int = dynamic_dict_find_index((state).dictionary, val);
    if existing_idx >= 0 {
        let updated_indices: List[Int] = list_push((state).encoded_indices, existing_idx);
        return DynamicDictState {
            config: (state).config,
            dictionary: (state).dictionary,
            encoded_indices: updated_indices,
            total_elements: (state).total_elements + 1,
            is_fallback_triggered: false,
        };
    }

    let current_dict_size: Int = list_len((state).dictionary);
    let cfg: DictCompressorConfig = (state).config;
    if current_dict_size >= (cfg).max_dictionary_entries {
        return DynamicDictState {
            config: (state).config,
            dictionary: (state).dictionary,
            encoded_indices: (state).encoded_indices,
            total_elements: (state).total_elements + 1,
            is_fallback_triggered: true,
        };
    }

    let updated_dict: List[String] = list_push((state).dictionary, val);
    let updated_indices: List[Int] = list_push((state).encoded_indices, current_dict_size);

    return DynamicDictState {
        config: (state).config,
        dictionary: updated_dict,
        encoded_indices: updated_indices,
        total_elements: (state).total_elements + 1,
        is_fallback_triggered: false,
    };
}

pub fn dynamic_dict_finish_page(state: DynamicDictState, original_raw: List[String]) -> CompressedColumnPage {
    if (state).is_fallback_triggered {
        let empty_d: List[String] = list_new();
        let empty_i: List[Int] = list_new();
        return CompressedColumnPage {
            encoding_type: 0,
            dictionary_entries: empty_d,
            indices: empty_i,
            raw_elements: original_raw,
            num_rows: list_len(original_raw),
        };
    }

    let empty_r: List[String] = list_new();
    return CompressedColumnPage {
        encoding_type: 1,
        dictionary_entries: (state).dictionary,
        indices: (state).encoded_indices,
        raw_elements: empty_r,
        num_rows: (state).total_elements,
    };
}
