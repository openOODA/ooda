// # Tarjan's Strongly Connected Components (SCC) Algorithm
//
// Logline: Discovers strongly connected components in directed graphs using lowlink values and DFS call stacks.
//
// Setup: Single-pass linear-time depth-first search partitioner operating over GraphAdjList representations.
//
// Beats:
//   1. Track discovery indices, lowlink values, and active stack membership for each node.
//   2. Identify SCC roots upon backtrack when index equals lowlink.
//   3. Pop component subgraphs, assign component IDs, and test overall strong connectivity.

import "./graph_adjacency_list.oo";

pub type TarjanSccResult = struct {
    component_ids: List[Int],
    scc_count: Int,
    num_vertices: Int
};

pub fn tarjan_scc_find(g: &GraphAdjList, num_vertices: Int) -> TarjanSccResult {
    let mut indices: List[Int] = list_new();
    let mut lowlinks: List[Int] = list_new();
    let mut on_stack: List[Bool] = list_new();
    let mut comp_ids: List[Int] = list_new();

    let mut i: Int = 0;
    while i < num_vertices {
        indices = list_push(indices, -1);
        lowlinks = list_push(lowlinks, -1);
        on_stack = list_push(on_stack, false);
        comp_ids = list_push(comp_ids, -1);
        i = i + 1;
    }

    let mut timer: Int = 0;
    let mut stack: List[Int] = list_new();
    let mut scc_count: Int = 0;

    let mut v: Int = 0;
    while v < num_vertices {
        if list_get(indices, v) == -1 {
            let mut call_stack: List[Int] = list_new();
            call_stack = list_push(call_stack, v);

            while list_len(call_stack) > 0 {
                let u: Int = list_get(call_stack, list_len(call_stack) - 1);
                
                if list_get(indices, u) == -1 {
                    // Discovery
                    let mut upd_idx: List[Int] = list_new();
                    let mut upd_low: List[Int] = list_new();
                    let mut upd_on: List[Bool] = list_new();
                    let mut k: Int = 0;
                    while k < num_vertices {
                        if k == u {
                            upd_idx = list_push(upd_idx, timer);
                            upd_low = list_push(upd_low, timer);
                            upd_on = list_push(upd_on, true);
                        } else {
                            upd_idx = list_push(upd_idx, list_get(indices, k));
                            upd_low = list_push(upd_low, list_get(lowlinks, k));
                            upd_on = list_push(upd_on, list_get(on_stack, k));
                        }
                        k = k + 1;
                    }
                    indices = upd_idx;
                    lowlinks = upd_low;
                    on_stack = upd_on;
                    timer = timer + 1;
                    stack = list_push(stack, u);
                }

                // Look for unvisited neighbor to push to call_stack
                let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, u);
                let num_nbrs: Int = list_len(nbrs);
                let mut pushed: Bool = false;
                let mut j: Int = 0;
                while j < num_nbrs && !pushed {
                    let w: Int = (list_get(nbrs, j)).target;
                    if w >= 0 && w < num_vertices {
                        if list_get(indices, w) == -1 {
                            call_stack = list_push(call_stack, w);
                            pushed = true;
                        } else if list_get(on_stack, w) {
                            let low_u: Int = list_get(lowlinks, u);
                            let idx_w: Int = list_get(indices, w);
                            if idx_w < low_u {
                                let mut upd_low2: List[Int] = list_new();
                                let mut m: Int = 0;
                                while m < num_vertices {
                                    if m == u { upd_low2 = list_push(upd_low2, idx_w); } else { upd_low2 = list_push(upd_low2, list_get(lowlinks, m)); }
                                    m = m + 1;
                                }
                                lowlinks = upd_low2;
                            }
                        }
                    }
                    j = j + 1;
                }

                if !pushed {
                    // Backtrack
                    let mut new_call_stack: List[Int] = list_new();
                    let mut cs: Int = 0;
                    while cs < list_len(call_stack) - 1 {
                        new_call_stack = list_push(new_call_stack, list_get(call_stack, cs));
                        cs = cs + 1;
                    }
                    call_stack = new_call_stack;

                    if list_len(call_stack) > 0 {
                        let parent_node: Int = list_get(call_stack, list_len(call_stack) - 1);
                        let low_u: Int = list_get(lowlinks, u);
                        let low_p: Int = list_get(lowlinks, parent_node);
                        if low_u < low_p {
                            let mut upd_low3: List[Int] = list_new();
                            let mut m: Int = 0;
                            while m < num_vertices {
                                if m == parent_node { upd_low3 = list_push(upd_low3, low_u); } else { upd_low3 = list_push(upd_low3, list_get(lowlinks, m)); }
                                m = m + 1;
                            }
                            lowlinks = upd_low3;
                        }
                    }

                    // Check if root of SCC
                    if list_get(lowlinks, u) == list_get(indices, u) {
                        let mut done_pop: Bool = false;
                        while !done_pop && list_len(stack) > 0 {
                            let top_node: Int = list_get(stack, list_len(stack) - 1);
                            
                            // Pop stack
                            let mut new_s: List[Int] = list_new();
                            let mut s: Int = 0;
                            while s < list_len(stack) - 1 {
                                new_s = list_push(new_s, list_get(stack, s));
                                s = s + 1;
                            }
                            stack = new_s;

                            let mut upd_comp: List[Int] = list_new();
                            let mut upd_on2: List[Bool] = list_new();
                            let mut k: Int = 0;
                            while k < num_vertices {
                                if k == top_node {
                                    upd_comp = list_push(upd_comp, scc_count);
                                    upd_on2 = list_push(upd_on2, false);
                                } else {
                                    upd_comp = list_push(upd_comp, list_get(comp_ids, k));
                                    upd_on2 = list_push(upd_on2, list_get(on_stack, k));
                                }
                                k = k + 1;
                            }
                            comp_ids = upd_comp;
                            on_stack = upd_on2;

                            if top_node == u {
                                done_pop = true;
                            }
                        }
                        scc_count = scc_count + 1;
                    }
                }
            }
        }
        v = v + 1;
    }

    return TarjanSccResult {
        component_ids: comp_ids,
        scc_count: scc_count,
        num_vertices: num_vertices
    };
}

pub fn tarjan_is_strongly_connected(res: &TarjanSccResult) -> Bool {
    return (res).scc_count == 1 && (res).num_vertices > 0;
}

pub fn tarjan_get_component_id(res: &TarjanSccResult, vertex: Int) -> Int {
    if vertex < 0 || vertex >= (res).num_vertices {
        return -1;
    }
    return list_get((res).component_ids, vertex);
}
