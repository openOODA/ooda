// # k-Core Graph Decomposition Algorithm
//
// Logline: Decomposes graphs into nested k-core subgraphs via iterative lowest-degree vertex pruning.
//
// Setup: Degree-peeling coreness engine operating over GraphAdjList representations.
//
// Beats:
//   1. Track dynamic residual degrees across all active graph vertices.
//   2. Progressively prune lowest-degree nodes and decrement neighbor degrees.
//   3. Record coreness numbers, determine maximum graph core, and filter k-shell vertices.

import "./graph_adjacency_list.oo";

pub type KCoreResult = struct {
    coreness: List[Int],
    max_core: Int,
    num_vertices: Int,
};

pub fn k_core_decompose(g: &GraphAdjList, num_vertices: Int) -> KCoreResult {
    let mut degrees: List[Int] = list_new();
    let mut coreness: List[Int] = list_new();
    let mut removed: List[Bool] = list_new();

    let mut i: Int = 0;
    while i < num_vertices {
        let deg: Int = adj_list_degree(g, i);
        degrees = list_push(degrees, deg);
        coreness = list_push(coreness, 0);
        removed = list_push(removed, false);
        i = i + 1;
    }

    let mut max_k: Int = 0;
    let mut remaining: Int = num_vertices;

    while remaining > 0 {
        // Find vertex with minimum active degree
        let mut min_u: Int = -1;
        let mut min_deg: Int = 1000000000;
        let mut v: Int = 0;
        while v < num_vertices {
            if !list_get(removed, v) {
                let d: Int = list_get(degrees, v);
                if d < min_deg {
                    min_deg = d;
                    min_u = v;
                }
            }
            v = v + 1;
        }

        if min_u == -1 {
            remaining = 0;
        } else {
            if min_deg > max_k {
                max_k = min_deg;
            }

            // Set coreness for min_u
            let mut upd_core: List[Int] = list_new();
            let mut upd_rem: List[Bool] = list_new();
            let mut k: Int = 0;
            while k < num_vertices {
                if k == min_u {
                    upd_core = list_push(upd_core, max_k);
                    upd_rem = list_push(upd_rem, true);
                } else {
                    upd_core = list_push(upd_core, list_get(coreness, k));
                    upd_rem = list_push(upd_rem, list_get(removed, k));
                }
                k = k + 1;
            }
            coreness = upd_core;
            removed = upd_rem;
            remaining = remaining - 1;

            // Decrement active neighbor degrees
            let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, min_u);
            let num_nbrs: Int = list_len(nbrs);
            let mut j: Int = 0;
            while j < num_nbrs {
                let target: Int = (list_get(nbrs, j)).target;
                if target >= 0 && target < num_vertices && !list_get(removed, target) {
                    let cur_d: Int = list_get(degrees, target);
                    if cur_d > 0 {
                        let mut upd_deg: List[Int] = list_new();
                        let mut m: Int = 0;
                        while m < num_vertices {
                            if m == target { upd_deg = list_push(upd_deg, cur_d - 1); } else { upd_deg = list_push(upd_deg, list_get(degrees, m)); }
                            m = m + 1;
                        }
                        degrees = upd_deg;
                    }
                }
                j = j + 1;
            }
        }
    }

    return KCoreResult {
        coreness: coreness,
        max_core: max_k,
        num_vertices: num_vertices,
    };
}

pub fn k_core_get_coreness(res: &KCoreResult, vertex: Int) -> Int {
    if vertex < 0 || vertex >= (res).num_vertices {
        return 0;
    }
    return list_get((res).coreness, vertex);
}

pub fn k_core_filter_k(res: &KCoreResult, k: Int) -> List[Int] {
    let mut vertices: List[Int] = list_new();
    let n: Int = (res).num_vertices;
    let mut i: Int = 0;
    while i < n {
        if list_get((res).coreness, i) >= k {
            vertices = list_push(vertices, i);
        }
        i = i + 1;
    }
    return vertices;
}
