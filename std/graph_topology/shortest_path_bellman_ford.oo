// # Bellman-Ford Shortest Path Algorithm
//
// Logline: Computes single-source shortest paths on weighted graphs with arbitrary edge weights and negative cycle detection.
//
// Setup: Iterative edge relaxation engine operating over GraphEdgeList representations.
//
// Beats:
//   1. Execute V-1 relaxation passes across all directed edges to compute minimum path costs.
//   2. Run an additional cycle-detection pass to flag negative weight cycles.
//   3. Extract shortest paths and provide distance queries with sentinel infinity guards.

import "./graph_edge_list.oo";

pub type BellmanFordResult = struct {
    distances: List[Int],
    predecessors: List[Int],
    source: Int,
    has_negative_cycle: Bool
};

pub fn bellman_ford_shortest_path(edges: &GraphEdgeList, source: Int, num_vertices: Int) -> BellmanFordResult {
    let inf_dist: Int = 1000000000;
    let mut dist: List[Int] = list_new();
    let mut pred: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_vertices {
        if i == source {
            dist = list_push(dist, 0);
        } else {
            dist = list_push(dist, inf_dist);
        }
        pred = list_push(pred, -1);
        i = i + 1;
    }

    let edge_list: List[GraphEdge] = (edges).edges;
    let num_edges: Int = list_len(edge_list);

    // V - 1 passes
    let mut pass: Int = 0;
    while pass < num_vertices - 1 {
        let mut e_idx: Int = 0;
        let mut any_relaxed: Bool = false;
        while e_idx < num_edges {
            let e: GraphEdge = list_get(edge_list, e_idx);
            let u: Int = (e).src;
            let v: Int = (e).dst;
            let w: Int = (e).weight;
            if u >= 0 && u < num_vertices && v >= 0 && v < num_vertices {
                let dist_u: Int = list_get(dist, u);
                if dist_u != inf_dist {
                    let new_d: Int = dist_u + w;
                    if new_d < list_get(dist, v) {
                        let mut upd_dist: List[Int] = list_new();
                        let mut upd_pred: List[Int] = list_new();
                        let mut k: Int = 0;
                        while k < num_vertices {
                            if k == v {
                                upd_dist = list_push(upd_dist, new_d);
                                upd_pred = list_push(upd_pred, u);
                            } else {
                                upd_dist = list_push(upd_dist, list_get(dist, k));
                                upd_pred = list_push(upd_pred, list_get(pred, k));
                            }
                            k = k + 1;
                        }
                        dist = upd_dist;
                        pred = upd_pred;
                        any_relaxed = true;
                    }
                }
            }
            e_idx = e_idx + 1;
        }
        if !any_relaxed {
            pass = num_vertices;
        } else {
            pass = pass + 1;
        }
    }

    // Check negative cycle
    let mut has_neg_cycle: Bool = false;
    let mut c_idx: Int = 0;
    while c_idx < num_edges {
        let e: GraphEdge = list_get(edge_list, c_idx);
        let u: Int = (e).src;
        let v: Int = (e).dst;
        let w: Int = (e).weight;
        if u >= 0 && u < num_vertices && v >= 0 && v < num_vertices {
            let dist_u: Int = list_get(dist, u);
            if dist_u != inf_dist {
                if dist_u + w < list_get(dist, v) {
                    has_neg_cycle = true;
                }
            }
        }
        c_idx = c_idx + 1;
    }

    return BellmanFordResult {
        distances: dist,
        predecessors: pred,
        source: source,
        has_negative_cycle: has_neg_cycle
    };
}

pub fn bellman_ford_has_negative_cycle(res: &BellmanFordResult) -> Bool {
    return (res).has_negative_cycle;
}

pub fn bellman_ford_get_path(res: &BellmanFordResult, target: Int) -> List[Int] {
    let mut path: List[Int] = list_new();
    if (res).has_negative_cycle {
        return path;
    }
    if target < 0 || target >= list_len((res).distances) {
        return path;
    }
    if list_get((res).distances, target) >= 1000000000 {
        return path;
    }

    let mut curr: Int = target;
    let mut rev_path: List[Int] = list_new();
    while curr != -1 {
        rev_path = list_push(rev_path, curr);
        if curr == (res).source {
            curr = -1;
        } else {
            curr = list_get((res).predecessors, curr);
        }
    }

    let n: Int = list_len(rev_path);
    let mut idx: Int = n - 1;
    while idx >= 0 {
        path = list_push(path, list_get(rev_path, idx));
        idx = idx - 1;
    }
    return path;
}

pub fn shortest_path_bellman_ford_probe() -> Int {
    return 0;
}
