// # PageRank Power Iteration Algorithm
//
// Logline: Computes node centrality rankings using fixed-point power iteration with damping factors.
//
// Setup: Iterative stochastic matrix eigenvalue solver operating over GraphAdjList representations.
//
// Beats:
//   1. Distribute uniform initial probability masses across all graph vertices.
//   2. Iteratively transfer rank mass along outgoing links with damping teleportation.
//   3. Check absolute delta convergence and extract top-ranking authority nodes.

import "./graph_adjacency_list.oo";

pub type PageRankResult = struct {
    ranks: List[Int],
    iterations: Int,
    converged: Bool,
    vertex_count: Int,
};

pub fn pagerank_power_iteration(
    g: &GraphAdjList,
    num_vertices: Int,
    damping_pct: Int, // e.g. 85 for 0.85
    max_iters: Int
) -> PageRankResult {
    let scale: Int = 10000;
    if num_vertices <= 0 {
        let empty: List[Int] = list_new();
        return PageRankResult {
            ranks: empty,
            iterations: 0,
            converged: true,
            vertex_count: 0,
        };
    }

    let init_val: Int = scale / num_vertices;
    let mut ranks: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_vertices {
        ranks = list_push(ranks, init_val);
        i = i + 1;
    }

    let base_teleport: Int = ((100 - damping_pct) * scale) / (100 * num_vertices);
    let mut iter: Int = 0;
    let mut converged: Bool = false;

    while iter < max_iters && !converged {
        let mut next_ranks: List[Int] = list_new();
        let mut v_init: Int = 0;
        while v_init < num_vertices {
            next_ranks = list_push(next_ranks, base_teleport);
            v_init = v_init + 1;
        }

        // Distribute ranks
        let mut u: Int = 0;
        while u < num_vertices {
            let deg: Int = adj_list_degree(g, u);
            let r_u: Int = list_get(ranks, u);
            if deg > 0 {
                let share: Int = (r_u * damping_pct) / (100 * deg);
                let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, u);
                let num_nbrs: Int = list_len(nbrs);
                let mut j: Int = 0;
                while j < num_nbrs {
                    let target: Int = (list_get(nbrs, j)).target;
                    if target >= 0 && target < num_vertices {
                        let cur_nr: Int = list_get(next_ranks, target);
                        let mut upd_nr: List[Int] = list_new();
                        let mut k: Int = 0;
                        while k < num_vertices {
                            if k == target { upd_nr = list_push(upd_nr, cur_nr + share); } else { upd_nr = list_push(upd_nr, list_get(next_ranks, k)); }
                            k = k + 1;
                        }
                        next_ranks = upd_nr;
                    }
                    j = j + 1;
                }
            } else {
                // Dangling node: distribute evenly
                let dangle_share: Int = (r_u * damping_pct) / (100 * num_vertices);
                let mut k: Int = 0;
                let mut upd_nr: List[Int] = list_new();
                while k < num_vertices {
                    upd_nr = list_push(upd_nr, list_get(next_ranks, k) + dangle_share);
                    k = k + 1;
                }
                next_ranks = upd_nr;
            }
            u = u + 1;
        }

        // Check convergence (L1 norm delta < threshold)
        let mut max_diff: Int = 0;
        let mut c: Int = 0;
        while c < num_vertices {
            let diff: Int = list_get(next_ranks, c) - list_get(ranks, c);
            let abs_diff: Int = if diff < 0 { 0 - diff } else { diff };
            if abs_diff > max_diff {
                max_diff = abs_diff;
            }
            c = c + 1;
        }

        ranks = next_ranks;
        iter = iter + 1;
        if max_diff < 1 {
            converged = true;
        }
    }

    return PageRankResult {
        ranks: ranks,
        iterations: iter,
        converged: converged,
        vertex_count: num_vertices,
    };
}

pub fn pagerank_get_rank(res: &PageRankResult, vertex: Int) -> Int {
    if vertex < 0 || vertex >= (res).vertex_count {
        return 0;
    }
    return list_get((res).ranks, vertex);
}

pub fn pagerank_top_vertex(res: &PageRankResult) -> Int {
    let n: Int = (res).vertex_count;
    if n <= 0 {
        return -1;
    }
    let mut best_v: Int = 0;
    let mut max_r: Int = list_get((res).ranks, 0);
    let mut i: Int = 1;
    while i < n {
        let r: Int = list_get((res).ranks, i);
        if r > max_r {
            max_r = r;
            best_v = i;
        }
        i = i + 1;
    }
    return best_v;
}
