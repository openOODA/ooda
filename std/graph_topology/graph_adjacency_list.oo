// # Graph Adjacency List Representation
//
// Logline: Implements an adjacency list graph structure supporting directed and undirected weighted graphs.
//
// Setup: Pure memory-efficient graph representation using indexed vertex records and dynamic edge lists.
//
// Beats:
//   1. Define AdjEdge, AdjVertex, and GraphAdjList core data structures.
//   2. Provide vertex addition, edge insertion, and neighbor query primitives.
//   3. Implement degree inspection, connectivity checks, and adjacency iterators.

pub type AdjEdge = struct {
    target: Int,
    weight: Int,
};

pub type AdjVertex = struct {
    id: Int,
    edges: List[AdjEdge],
    degree: Int,
};

pub type GraphAdjList = struct {
    vertices: List[AdjVertex],
    is_directed: Bool,
    vertex_count: Int,
    edge_count: Int,
};

pub fn adj_edge_new(target: Int, weight: Int) -> AdjEdge {
    return AdjEdge {
        target: target,
        weight: weight,
    };
}

pub fn adj_list_create(is_directed: Bool) -> GraphAdjList {
    let empty_vertices: List[AdjVertex] = list_new();
    return GraphAdjList {
        vertices: empty_vertices,
        is_directed: is_directed,
        vertex_count: 0,
        edge_count: 0,
    };
}

pub fn adj_list_find_vertex_index(g: &GraphAdjList, vertex_id: Int) -> Int {
    let verts: List[AdjVertex] = (g).vertices;
    let n: Int = list_len(verts);
    let mut i: Int = 0;
    while i < n {
        let v: AdjVertex = list_get(verts, i);
        if (v).id == vertex_id {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn adj_list_add_vertex(g: &mut GraphAdjList, vertex_id: Int) -> Bool {
    let existing_idx: Int = adj_list_find_vertex_index(g, vertex_id);
    if existing_idx >= 0 {
        return false;
    }
    let empty_edges: List[AdjEdge] = list_new();
    let new_vertex: AdjVertex = AdjVertex {
        id: vertex_id,
        edges: empty_edges,
        degree: 0,
    };
    (g).vertices = list_push((g).vertices, new_vertex);
    (g).vertex_count = (g).vertex_count + 1;
    return true;
}

pub fn adj_list_add_edge_directed(g: &mut GraphAdjList, u: Int, v: Int, weight: Int) -> Bool {
    let u_idx: Int = adj_list_find_vertex_index(g, u);
    let v_idx: Int = adj_list_find_vertex_index(g, v);
    if u_idx < 0 || v_idx < 0 {
        return false;
    }
    let verts: List[AdjVertex] = (g).vertices;
    let mut new_verts: List[AdjVertex] = list_new();
    let n: Int = list_len(verts);
    let mut i: Int = 0;
    while i < n {
        let cur_v: AdjVertex = list_get(verts, i);
        if (cur_v).id == u {
            let edge: AdjEdge = adj_edge_new(v, weight);
            let updated_edges: List[AdjEdge] = list_push((cur_v).edges, edge);
            let updated_v: AdjVertex = AdjVertex {
                id: (cur_v).id,
                edges: updated_edges,
                degree: (cur_v).degree + 1,
            };
            new_verts = list_push(new_verts, updated_v);
        } else {
            new_verts = list_push(new_verts, cur_v);
        }
        i = i + 1;
    }
    (g).vertices = new_verts;
    (g).edge_count = (g).edge_count + 1;
    return true;
}

pub fn adj_list_add_edge(g: &mut GraphAdjList, u: Int, v: Int, weight: Int) -> Bool {
    adj_list_add_vertex(g, u);
    adj_list_add_vertex(g, v);
    let ok1: Bool = adj_list_add_edge_directed(g, u, v, weight);
    if !(g).is_directed && ok1 {
        adj_list_add_edge_directed(g, v, u, weight);
    }
    return ok1;
}

pub fn adj_list_get_neighbors(g: &GraphAdjList, u: Int) -> List[AdjEdge] {
    let u_idx: Int = adj_list_find_vertex_index(g, u);
    if u_idx < 0 {
        let empty: List[AdjEdge] = list_new();
        return empty;
    }
    let v: AdjVertex = list_get((g).vertices, u_idx);
    return (v).edges;
}

pub fn adj_list_has_edge(g: &GraphAdjList, u: Int, v: Int) -> Bool {
    let edges: List[AdjEdge] = adj_list_get_neighbors(g, u);
    let n: Int = list_len(edges);
    let mut i: Int = 0;
    while i < n {
        let edge: AdjEdge = list_get(edges, i);
        if (edge).target == v {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn adj_list_get_edge_weight(g: &GraphAdjList, u: Int, v: Int) -> Int {
    let edges: List[AdjEdge] = adj_list_get_neighbors(g, u);
    let n: Int = list_len(edges);
    let mut i: Int = 0;
    while i < n {
        let edge: AdjEdge = list_get(edges, i);
        if (edge).target == v {
            return (edge).weight;
        }
        i = i + 1;
    }
    return -1;
}

pub fn adj_list_vertex_count(g: &GraphAdjList) -> Int {
    return (g).vertex_count;
}

pub fn adj_list_edge_count(g: &GraphAdjList) -> Int {
    return (g).edge_count;
}

pub fn adj_list_degree(g: &GraphAdjList, u: Int) -> Int {
    let u_idx: Int = adj_list_find_vertex_index(g, u);
    if u_idx < 0 {
        return 0;
    }
    let v: AdjVertex = list_get((g).vertices, u_idx);
    return (v).degree;
}
