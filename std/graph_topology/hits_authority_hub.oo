// # HITS (Hyperlink-Induced Topic Search) Algorithm
//
// Logline: Computes authority and hub centrality scores on directed graphs via mutual reinforcement iteration.
//
// Setup: Link analysis engine operating over GraphAdjMatrix representations.
//
// Beats:
//   1. Initialize uniform authority and hub weights across all graph vertices.
//   2. Iteratively update authority scores from pointing hubs and hub scores from pointed authorities.
//   3. Normalize score vectors and extract leading authority and hub vertices.

import "./graph_adjacency_matrix.oo";

pub type HitsResult = struct {
    authority_scores: List[Int],
    hub_scores: List[Int],
    iterations: Int,
    vertex_count: Int,
};

pub fn hits_compute_scores(adj_mat: &GraphAdjMatrix, max_iters: Int) -> HitsResult {
    let n: Int = (adj_mat).vertex_capacity;
    let scale: Int = 10000;

    let mut auth: List[Int] = list_new();
    let mut hub: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        auth = list_push(auth, scale);
        hub = list_push(hub, scale);
        i = i + 1;
    }

    let mut iter: Int = 0;
    while iter < max_iters {
        // Step 1: Update authority scores: auth(p) = sum(hub(q) for q -> p)
        let mut next_auth: List[Int] = list_new();
        let mut p: Int = 0;
        let mut auth_norm: Int = 0;
        while p < n {
            let mut sum_h: Int = 0;
            let mut q: Int = 0;
            while q < n {
                if adj_matrix_has_edge(adj_mat, q, p) {
                    sum_h = sum_h + list_get(hub, q);
                }
                q = q + 1;
            }
            next_auth = list_push(next_auth, sum_h);
            auth_norm = auth_norm + sum_h;
            p = p + 1;
        }

        // Normalize auth
        if auth_norm > 0 {
            let mut norm_auth: List[Int] = list_new();
            let mut k: Int = 0;
            while k < n {
                let scaled_val: Int = (list_get(next_auth, k) * scale) / auth_norm;
                norm_auth = list_push(norm_auth, scaled_val);
                k = k + 1;
            }
            auth = norm_auth;
        }

        // Step 2: Update hub scores: hub(p) = sum(auth(q) for p -> q)
        let mut next_hub: List[Int] = list_new();
        p = 0;
        let mut hub_norm: Int = 0;
        while p < n {
            let mut sum_a: Int = 0;
            let mut q: Int = 0;
            while q < n {
                if adj_matrix_has_edge(adj_mat, p, q) {
                    sum_a = sum_a + list_get(auth, q);
                }
                q = q + 1;
            }
            next_hub = list_push(next_hub, sum_a);
            hub_norm = hub_norm + sum_a;
            p = p + 1;
        }

        // Normalize hub
        if hub_norm > 0 {
            let mut norm_hub: List[Int] = list_new();
            let mut k: Int = 0;
            while k < n {
                let scaled_val: Int = (list_get(next_hub, k) * scale) / hub_norm;
                norm_hub = list_push(norm_hub, scaled_val);
                k = k + 1;
            }
            hub = norm_hub;
        }

        iter = iter + 1;
    }

    return HitsResult {
        authority_scores: auth,
        hub_scores: hub,
        iterations: iter,
        vertex_count: n,
    };
}

pub fn hits_get_authority(res: &HitsResult, vertex: Int) -> Int {
    if vertex < 0 || vertex >= (res).vertex_count {
        return 0;
    }
    return list_get((res).authority_scores, vertex);
}

pub fn hits_get_hub(res: &HitsResult, vertex: Int) -> Int {
    if vertex < 0 || vertex >= (res).vertex_count {
        return 0;
    }
    return list_get((res).hub_scores, vertex);
}

pub fn hits_top_authority(res: &HitsResult) -> Int {
    let n: Int = (res).vertex_count;
    if n <= 0 {
        return -1;
    }
    let mut best_v: Int = 0;
    let mut max_val: Int = list_get((res).authority_scores, 0);
    let mut i: Int = 1;
    while i < n {
        let val: Int = list_get((res).authority_scores, i);
        if val > max_val {
            max_val = val;
            best_v = i;
        }
        i = i + 1;
    }
    return best_v;
}

pub fn hits_top_hub(res: &HitsResult) -> Int {
    let n: Int = (res).vertex_count;
    if n <= 0 {
        return -1;
    }
    let mut best_v: Int = 0;
    let mut max_val: Int = list_get((res).hub_scores, 0);
    let mut i: Int = 1;
    while i < n {
        let val: Int = list_get((res).hub_scores, i);
        if val > max_val {
            max_val = val;
            best_v = i;
        }
        i = i + 1;
    }
    return best_v;
}

pub fn hits_authority_hub_probe() -> Int {
    return 0;
}
