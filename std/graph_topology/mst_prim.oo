// # Prim's Minimum Spanning Tree Algorithm
//
// Logline: Computes a Minimum Spanning Tree (MST) on connected undirected graphs via priority vertex growth.
//
// Setup: Priority cut relaxation engine operating over GraphAdjList representations.
//
// Beats:
//   1. Maintain cut boundary distances and key weights for all unvisited vertices.
//   2. Greedily select the minimum-weight frontier edge and grow the tree partition.
//   3. Record tree edges, accumulate spanning weights, and check connectivity.

import "./graph_adjacency_list.oo";
import "./graph_edge_list.oo";

pub type PrimMstResult = struct {
    mst_edges: List[GraphEdge],
    total_weight: Int,
    vertex_count: Int,
    is_spanning: Bool,
};

pub fn prim_mst(g: &GraphAdjList, num_vertices: Int, start_vertex: Int) -> PrimMstResult {
    let inf_val: Int = 1000000000;
    let mut key: List[Int] = list_new();
    let mut parent: List[Int] = list_new();
    let mut in_mst: List[Bool] = list_new();

    let mut i: Int = 0;
    while i < num_vertices {
        if i == start_vertex {
            key = list_push(key, 0);
        } else {
            key = list_push(key, inf_val);
        }
        parent = list_push(parent, -1);
        in_mst = list_push(in_mst, false);
        i = i + 1;
    }

    let mut mst_edges: List[GraphEdge] = list_new();
    let mut total_weight: Int = 0;

    let mut count: Int = 0;
    while count < num_vertices {
        // Find min key vertex not yet in MST
        let mut min_u: Int = -1;
        let mut min_k: Int = inf_val;
        let mut v: Int = 0;
        while v < num_vertices {
            if !list_get(in_mst, v) {
                let k_val: Int = list_get(key, v);
                if k_val < min_k {
                    min_k = k_val;
                    min_u = v;
                }
            }
            v = v + 1;
        }

        if min_u == -1 || min_k == inf_val {
            count = num_vertices;
        } else {
            // Include in MST
            let mut upd_in_mst: List[Bool] = list_new();
            let mut k: Int = 0;
            while k < num_vertices {
                if k == min_u { upd_in_mst = list_push(upd_in_mst, true); } else { upd_in_mst = list_push(upd_in_mst, list_get(in_mst, k)); }
                k = k + 1;
            }
            in_mst = upd_in_mst;

            let p: Int = list_get(parent, min_u);
            if p != -1 {
                let e: GraphEdge = graph_edge_new(p, min_u, min_k);
                mst_edges = list_push(mst_edges, e);
                total_weight = total_weight + min_k;
            }

            // Relax neighbors
            let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, min_u);
            let num_nbrs: Int = list_len(nbrs);
            let mut j: Int = 0;
            while j < num_nbrs {
                let edge: AdjEdge = list_get(nbrs, j);
                let target: Int = (edge).target;
                let weight: Int = (edge).weight;
                if target >= 0 && target < num_vertices && !list_get(in_mst, target) {
                    if weight < list_get(key, target) {
                        let mut upd_key: List[Int] = list_new();
                        let mut upd_parent: List[Int] = list_new();
                        let mut m: Int = 0;
                        while m < num_vertices {
                            if m == target {
                                upd_key = list_push(upd_key, weight);
                                upd_parent = list_push(upd_parent, min_u);
                            } else {
                                upd_key = list_push(upd_key, list_get(key, m));
                                upd_parent = list_push(upd_parent, list_get(parent, m));
                            }
                            m = m + 1;
                        }
                        key = upd_key;
                        parent = upd_parent;
                    }
                }
                j = j + 1;
            }
            count = count + 1;
        }
    }

    let is_spanning: Bool = list_len(mst_edges) == num_vertices - 1;
    return PrimMstResult {
        mst_edges: mst_edges,
        total_weight: total_weight,
        vertex_count: num_vertices,
        is_spanning: is_spanning,
    };
}

pub fn prim_mst_weight(res: &PrimMstResult) -> Int {
    return (res).total_weight;
}

pub fn prim_mst_edge_count(res: &PrimMstResult) -> Int {
    return list_len((res).mst_edges);
}
