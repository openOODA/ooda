// # Kruskal's Minimum Spanning Tree Algorithm
//
// Logline: Computes a Minimum Spanning Tree (MST) on weighted graphs using greedy edge selection and Disjoint Set Union.
//
// Setup: Union-Find (DSU) partitioning engine operating over GraphEdgeList representations.
//
// Beats:
//   1. Implement path-compressed Disjoint Set Union (DSU) data structures.
//   2. Greedily process sorted edges to prevent cycle formation while spanning components.
//   3. Compute total MST tree weight and verify global spanning connectivity.

import "./graph_edge_list.oo";

pub type DisjointSet = struct {
    parent: List[Int],
    rank: List[Int],
    size: Int,
};

pub type KruskalMstResult = struct {
    mst_edges: List[GraphEdge],
    total_weight: Int,
    is_spanning: Bool,
};

pub fn dsu_create(size: Int) -> DisjointSet {
    let mut p: List[Int] = list_new();
    let mut r: List[Int] = list_new();
    let mut i: Int = 0;
    while i < size {
        p = list_push(p, i);
        r = list_push(r, 0);
        i = i + 1;
    }
    return DisjointSet {
        parent: p,
        rank: r,
        size: size,
    };
}

pub fn dsu_find(dsu: &mut DisjointSet, i: Int) -> Int {
    let mut curr: Int = i;
    while curr != list_get((dsu).parent, curr) {
        curr = list_get((dsu).parent, curr);
    }
    return curr;
}

pub fn dsu_union(dsu: &mut DisjointSet, i: Int, j: Int) -> Bool {
    let root_i: Int = dsu_find(dsu, i);
    let root_j: Int = dsu_find(dsu, j);
    if root_i == root_j {
        return false;
    }

    let rank_i: Int = list_get((dsu).rank, root_i);
    let rank_j: Int = list_get((dsu).rank, root_j);

    let n: Int = (dsu).size;
    let mut new_parent: List[Int] = list_new();
    let mut new_rank: List[Int] = list_new();

    if rank_i < rank_j {
        let mut k: Int = 0;
        while k < n {
            if k == root_i {
                new_parent = list_push(new_parent, root_j);
            } else {
                new_parent = list_push(new_parent, list_get((dsu).parent, k));
            }
            new_rank = list_push(new_rank, list_get((dsu).rank, k));
            k = k + 1;
        }
    } else if rank_i > rank_j {
        let mut k: Int = 0;
        while k < n {
            if k == root_j {
                new_parent = list_push(new_parent, root_i);
            } else {
                new_parent = list_push(new_parent, list_get((dsu).parent, k));
            }
            new_rank = list_push(new_rank, list_get((dsu).rank, k));
            k = k + 1;
        }
    } else {
        let mut k: Int = 0;
        while k < n {
            if k == root_j {
                new_parent = list_push(new_parent, root_i);
            } else {
                new_parent = list_push(new_parent, list_get((dsu).parent, k));
            }
            if k == root_i {
                new_rank = list_push(new_rank, rank_i + 1);
            } else {
                new_rank = list_push(new_rank, list_get((dsu).rank, k));
            }
            k = k + 1;
        }
    }

    (dsu).parent = new_parent;
    (dsu).rank = new_rank;
    return true;
}

pub fn kruskal_mst(edges: &GraphEdgeList, num_vertices: Int) -> KruskalMstResult {
    let sorted_edges: List[GraphEdge] = edge_list_sort_by_weight(edges);
    let mut dsu: DisjointSet = dsu_create(num_vertices);
    let mut mst_list: List[GraphEdge] = list_new();
    let mut total_w: Int = 0;

    let num_edges: Int = list_len(sorted_edges);
    let mut i: Int = 0;
    while i < num_edges {
        let e: GraphEdge = list_get(sorted_edges, i);
        let u: Int = (e).src;
        let v: Int = (e).dst;
        if u >= 0 && u < num_vertices && v >= 0 && v < num_vertices {
            let merged: Bool = dsu_union(&mut dsu, u, v);
            if merged {
                mst_list = list_push(mst_list, e);
                total_w = total_w + (e).weight;
            }
        }
        i = i + 1;
    }

    let is_spanning: Bool = list_len(mst_list) == num_vertices - 1;
    return KruskalMstResult {
        mst_edges: mst_list,
        total_weight: total_w,
        is_spanning: is_spanning,
    };
}
