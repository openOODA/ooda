// # Depth-First Search (DFS) Graph Traversal
//
// Logline: Implements depth-first search for cycle detection, topological ordering, and path exploration.
//
// Setup: Stack-driven recursive/iterative DFS engine operating over GraphAdjList representations.
//
// Beats:
//   1. Execute stack-driven depth-first exploration tracking discovery and finish order.
//   2. Detect back-edges to identify cycles in directed and undirected graphs.
//   3. Compute connected components and find path existence between arbitrary vertices.

import "./graph_adjacency_list.oo";

pub type DfsResult = struct {
    discovery_order: List[Int],
    finish_order: List[Int],
    has_cycle: Bool,
    visited_count: Int,
};

pub fn dfs_traverse(g: &GraphAdjList, start_vertex: Int, num_vertices: Int) -> DfsResult {
    let mut visited: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < num_vertices {
        visited = list_push(visited, false);
        i = i + 1;
    }

    let mut discovery: List[Int] = list_new();
    let mut finish: List[Int] = list_new();
    let mut stack: List[Int] = list_new();
    let mut has_cycle: Bool = false;

    if start_vertex >= 0 && start_vertex < num_vertices {
        stack = list_push(stack, start_vertex);
    }

    while list_len(stack) > 0 {
        let top_idx: Int = list_len(stack) - 1;
        let curr: Int = list_get(stack, top_idx);
        
        let mut new_stack: List[Int] = list_new();
        let mut s: Int = 0;
        while s < top_idx {
            new_stack = list_push(new_stack, list_get(stack, s));
            s = s + 1;
        }
        stack = new_stack;

        if !list_get(visited, curr) {
            let mut upd_vis: List[Bool] = list_new();
            let mut k: Int = 0;
            while k < num_vertices {
                if k == curr { upd_vis = list_push(upd_vis, true); } else { upd_vis = list_push(upd_vis, list_get(visited, k)); }
                k = k + 1;
            }
            visited = upd_vis;
            discovery = list_push(discovery, curr);

            let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, curr);
            let num_nbrs: Int = list_len(nbrs);
            let mut j: Int = 0;
            while j < num_nbrs {
                let nxt: Int = (list_get(nbrs, j)).target;
                if nxt >= 0 && nxt < num_vertices {
                    if !list_get(visited, nxt) { stack = list_push(stack, nxt); } else { has_cycle = true; }
                }
                j = j + 1;
            }
            finish = list_push(finish, curr);
        }
    }

    return DfsResult {
        discovery_order: discovery,
        finish_order: finish,
        has_cycle: has_cycle,
        visited_count: list_len(discovery),
    };
}

pub fn dfs_find_path(g: &GraphAdjList, start_vertex: Int, end_vertex: Int, num_vertices: Int) -> List[Int] {
    let mut visited: List[Bool] = list_new();
    let mut pred: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_vertices {
        visited = list_push(visited, false);
        pred = list_push(pred, -1);
        i = i + 1;
    }

    let mut stack: List[Int] = list_new();
    stack = list_push(stack, start_vertex);
    let mut found: Bool = false;

    while list_len(stack) > 0 && !found {
        let top_idx: Int = list_len(stack) - 1;
        let curr: Int = list_get(stack, top_idx);
        
        let mut new_stack: List[Int] = list_new();
        let mut s: Int = 0;
        while s < top_idx {
            new_stack = list_push(new_stack, list_get(stack, s));
            s = s + 1;
        }
        stack = new_stack;

        if curr == end_vertex {
            found = true;
        } else if !list_get(visited, curr) {
            let mut upd_vis: List[Bool] = list_new();
            let mut k: Int = 0;
            while k < num_vertices {
                if k == curr { upd_vis = list_push(upd_vis, true); } else { upd_vis = list_push(upd_vis, list_get(visited, k)); }
                k = k + 1;
            }
            visited = upd_vis;

            let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, curr);
            let num_nbrs: Int = list_len(nbrs);
            let mut j: Int = 0;
            while j < num_nbrs {
                let nxt: Int = (list_get(nbrs, j)).target;
                if nxt >= 0 && nxt < num_vertices && !list_get(visited, nxt) {
                    let mut upd_pred: List[Int] = list_new();
                    let mut m: Int = 0;
                    while m < num_vertices {
                        if m == nxt && list_get(pred, m) == -1 { upd_pred = list_push(upd_pred, curr); } else { upd_pred = list_push(upd_pred, list_get(pred, m)); }
                        m = m + 1;
                    }
                    pred = upd_pred;
                    stack = list_push(stack, nxt);
                }
                j = j + 1;
            }
        }
    }

    let mut path: List[Int] = list_new();
    if !found && start_vertex != end_vertex { return path; }

    let mut curr_node: Int = end_vertex;
    let mut rev_path: List[Int] = list_new();
    while curr_node != -1 {
        rev_path = list_push(rev_path, curr_node);
        if curr_node == start_vertex { curr_node = -1; } else { curr_node = list_get(pred, curr_node); }
    }

    let n: Int = list_len(rev_path);
    let mut idx: Int = n - 1;
    while idx >= 0 {
        path = list_push(path, list_get(rev_path, idx));
        idx = idx - 1;
    }
    return path;
}

pub fn dfs_detect_cycle_directed(g: &GraphAdjList, num_vertices: Int) -> Bool {
    let mut state: List[Int] = list_new(); // 0 = unvisited, 1 = visiting, 2 = visited
    let mut i: Int = 0;
    while i < num_vertices {
        state = list_push(state, 0);
        i = i + 1;
    }

    let mut v: Int = 0;
    while v < num_vertices {
        if list_get(state, v) == 0 {
            let mut stack: List[Int] = list_new();
            stack = list_push(stack, v);
            while list_len(stack) > 0 {
                let curr: Int = list_get(stack, list_len(stack) - 1);
                let st: Int = list_get(state, curr);
                if st == 0 {
                    let mut upd_st: List[Int] = list_new();
                    let mut k: Int = 0;
                    while k < num_vertices {
                        if k == curr { upd_st = list_push(upd_st, 1); } else { upd_st = list_push(upd_st, list_get(state, k)); }
                        k = k + 1;
                    }
                    state = upd_st;

                    let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, curr);
                    let num_nbrs: Int = list_len(nbrs);
                    let mut j: Int = 0;
                    while j < num_nbrs {
                        let nxt: Int = (list_get(nbrs, j)).target;
                        if nxt >= 0 && nxt < num_vertices {
                            let nxt_st: Int = list_get(state, nxt);
                            if nxt_st == 1 { return true; }
                            if nxt_st == 0 { stack = list_push(stack, nxt); }
                        }
                        j = j + 1;
                    }
                } else {
                    let mut new_s: List[Int] = list_new();
                    let mut s: Int = 0;
                    while s < list_len(stack) - 1 {
                        new_s = list_push(new_s, list_get(stack, s));
                        s = s + 1;
                    }
                    stack = new_s;
                    let mut upd_st2: List[Int] = list_new();
                    let mut m: Int = 0;
                    while m < num_vertices {
                        if m == curr { upd_st2 = list_push(upd_st2, 2); } else { upd_st2 = list_push(upd_st2, list_get(state, m)); }
                        m = m + 1;
                    }
                    state = upd_st2;
                }
            }
        }
        v = v + 1;
    }
    return false;
}

pub fn dfs_connected_components(g: &GraphAdjList, num_vertices: Int) -> Int {
    let mut visited: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < num_vertices {
        visited = list_push(visited, false);
        i = i + 1;
    }

    let mut components: Int = 0;
    let mut v: Int = 0;
    while v < num_vertices {
        if !list_get(visited, v) {
            components = components + 1;
            let res: DfsResult = dfs_traverse(g, v, num_vertices);
            let vis_order: List[Int] = (res).discovery_order;
            let n: Int = list_len(vis_order);
            let mut j: Int = 0;
            while j < n {
                let u: Int = list_get(vis_order, j);
                let mut upd_vis: List[Bool] = list_new();
                let mut k: Int = 0;
                while k < num_vertices {
                    if k == u { upd_vis = list_push(upd_vis, true); } else { upd_vis = list_push(upd_vis, list_get(visited, k)); }
                    k = k + 1;
                }
                visited = upd_vis;
                j = j + 1;
            }
        }
        v = v + 1;
    }
    return components;
}
