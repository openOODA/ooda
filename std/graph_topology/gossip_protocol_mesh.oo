// # Epidemic Gossip Protocol Mesh Subsystem
//
// Logline: Implements decentralized epidemic gossip dissemination, fanout routing, and peer mesh state tracking.
//
// Setup: Probabilistic distributed message dissemination engine over dynamic peer overlay networks.
//
// Beats:
//   1. Maintain active peer registries, round counters, and message deduplication logs.
//   2. Disseminate broadcast gossip packets across pseudo-random peer fanout subsets.
//   3. Advance simulation rounds, decrement packet TTLs, and prune expired gossip records.

pub type GossipPeer = struct {
    peer_id: Int,
    addr: String,
    round_seen: Int,
    is_active: Bool,
};

pub type GossipMessage = struct {
    origin_peer: Int,
    seq_num: Int,
    payload: String,
    ttl: Int,
};

pub type GossipMesh = struct {
    peers: List[GossipPeer],
    message_log: List[GossipMessage],
    fanout: Int,
    current_round: Int,
};

pub fn gossip_mesh_create(fanout: Int) -> GossipMesh {
    let empty_peers: List[GossipPeer] = list_new();
    let empty_msgs: List[GossipMessage] = list_new();
    return GossipMesh {
        peers: empty_peers,
        message_log: empty_msgs,
        fanout: fanout,
        current_round: 0,
    };
}

pub fn gossip_add_peer(mesh: &mut GossipMesh, peer_id: Int, addr: String) -> Bool {
    let peer_list: List[GossipPeer] = (mesh).peers;
    let n: Int = list_len(peer_list);
    let mut i: Int = 0;
    while i < n {
        let p: GossipPeer = list_get(peer_list, i);
        if (p).peer_id == peer_id {
            return false;
        }
        i = i + 1;
    }

    let new_peer: GossipPeer = GossipPeer {
        peer_id: peer_id,
        addr: addr,
        round_seen: (mesh).current_round,
        is_active: true,
    };
    (mesh).peers = list_push((mesh).peers, new_peer);
    return true;
}

pub fn gossip_disseminate(
    mesh: &mut GossipMesh,
    origin: Int,
    seq_num: Int,
    payload: String,
    ttl: Int
) -> Int {
    // Check deduplication
    let logs: List[GossipMessage] = (mesh).message_log;
    let n: Int = list_len(logs);
    let mut i: Int = 0;
    while i < n {
        let m: GossipMessage = list_get(logs, i);
        if (m).origin_peer == origin && (m).seq_num == seq_num {
            return 0; // Already seen
        }
        i = i + 1;
    }

    let msg: GossipMessage = GossipMessage {
        origin_peer: origin,
        seq_num: seq_num,
        payload: payload,
        ttl: ttl,
    };
    (mesh).message_log = list_push((mesh).message_log, msg);

    // Compute fanout target count
    let num_peers: Int = list_len((mesh).peers);
    let target_count: Int = if (mesh).fanout < num_peers { (mesh).fanout } else { num_peers };
    return target_count;
}

pub fn gossip_tick_round(mesh: &mut GossipMesh) -> Int {
    (mesh).current_round = (mesh).current_round + 1;

    let logs: List[GossipMessage] = (mesh).message_log;
    let n: Int = list_len(logs);
    let mut active_msgs: List[GossipMessage] = list_new();
    let mut i: Int = 0;
    while i < n {
        let m: GossipMessage = list_get(logs, i);
        if (m).ttl > 1 {
            let updated_m: GossipMessage = GossipMessage {
                origin_peer: (m).origin_peer,
                seq_num: (m).seq_num,
                payload: (m).payload,
                ttl: (m).ttl - 1,
            };
            active_msgs = list_push(active_msgs, updated_m);
        }
        i = i + 1;
    }
    (mesh).message_log = active_msgs;
    return list_len(active_msgs);
}

pub fn gossip_peer_count(mesh: &GossipMesh) -> Int {
    return list_len((mesh).peers);
}

pub fn gossip_message_count(mesh: &GossipMesh) -> Int {
    return list_len((mesh).message_log);
}
