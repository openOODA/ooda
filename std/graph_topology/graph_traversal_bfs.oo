// # Breadth-First Search (BFS) Graph Traversal
//
// Logline: Implements level-order breadth-first search for unweighted shortest paths and connectivity analysis.
//
// Setup: Queue-driven iterative BFS engine operating over GraphAdjList representations.
//
// Beats:
//   1. Execute queue-based level-order traversal tracking distance and predecessor pointers.
//   2. Reconstruct shortest paths in unweighted graphs from predecessor chains.
//   3. Provide global connectivity and 2-color bipartite verification routines.

import "./graph_adjacency_list.oo";

pub type BfsResult = struct {
    visited_order: List[Int],
    distances: List[Int],
    predecessors: List[Int],
    visited_count: Int
};

pub fn bfs_traverse(g: &GraphAdjList, start_vertex: Int, num_vertices: Int) -> BfsResult {
    let mut distances: List[Int] = list_new();
    let mut predecessors: List[Int] = list_new();
    let mut visited: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < num_vertices {
        distances = list_push(distances, -1);
        predecessors = list_push(predecessors, -1);
        visited = list_push(visited, false);
        i = i + 1;
    }

    let mut queue: List[Int] = list_new();
    let mut visited_order: List[Int] = list_new();
    let mut q_head: Int = 0;

    if start_vertex >= 0 && start_vertex < num_vertices {
        queue = list_push(queue, start_vertex);
        let mut new_visited: List[Bool] = list_new();
        let mut new_dist: List[Int] = list_new();
        let mut k: Int = 0;
        while k < num_vertices {
            if k == start_vertex {
                new_visited = list_push(new_visited, true);
                new_dist = list_push(new_dist, 0);
            } else {
                new_visited = list_push(new_visited, list_get(visited, k));
                new_dist = list_push(new_dist, list_get(distances, k));
            }
            k = k + 1;
        }
        visited = new_visited;
        distances = new_dist;
    }

    while q_head < list_len(queue) {
        let curr: Int = list_get(queue, q_head);
        q_head = q_head + 1;
        visited_order = list_push(visited_order, curr);

        let curr_dist: Int = list_get(distances, curr);
        let neighbors: List[AdjEdge] = adj_list_get_neighbors(g, curr);
        let num_nbrs: Int = list_len(neighbors);
        let mut j: Int = 0;
        while j < num_nbrs {
            let edge: AdjEdge = list_get(neighbors, j);
            let nxt: Int = (edge).target;
            if nxt >= 0 && nxt < num_vertices {
                let is_vis: Bool = list_get(visited, nxt);
                if !is_vis {
                    queue = list_push(queue, nxt);
                    let mut upd_vis: List[Bool] = list_new();
                    let mut upd_dist: List[Int] = list_new();
                    let mut upd_pred: List[Int] = list_new();
                    let mut m: Int = 0;
                    while m < num_vertices {
                        if m == nxt {
                            upd_vis = list_push(upd_vis, true);
                            upd_dist = list_push(upd_dist, curr_dist + 1);
                            upd_pred = list_push(upd_pred, curr);
                        } else {
                            upd_vis = list_push(upd_vis, list_get(visited, m));
                            upd_dist = list_push(upd_dist, list_get(distances, m));
                            upd_pred = list_push(upd_pred, list_get(predecessors, m));
                        }
                        m = m + 1;
                    }
                    visited = upd_vis;
                    distances = upd_dist;
                    predecessors = upd_pred;
                }
            }
            j = j + 1;
        }
    }

    return BfsResult {
        visited_order: visited_order,
        distances: distances,
        predecessors: predecessors,
        visited_count: list_len(visited_order)
    };
}

pub fn bfs_shortest_path(g: &GraphAdjList, start_vertex: Int, end_vertex: Int, num_vertices: Int) -> List[Int] {
    let res: BfsResult = bfs_traverse(g, start_vertex, num_vertices);
    let mut path: List[Int] = list_new();
    let target_dist: Int = list_get((res).distances, end_vertex);
    if target_dist == -1 {
        return path;
    }

    let mut curr: Int = end_vertex;
    let mut rev_path: List[Int] = list_new();
    while curr != -1 {
        rev_path = list_push(rev_path, curr);
        if curr == start_vertex {
            curr = -1;
        } else {
            curr = list_get((res).predecessors, curr);
        }
    }

    let n: Int = list_len(rev_path);
    let mut idx: Int = n - 1;
    while idx >= 0 {
        path = list_push(path, list_get(rev_path, idx));
        idx = idx - 1;
    }
    return path;
}

pub fn bfs_is_connected(g: &GraphAdjList, num_vertices: Int) -> Bool {
    if num_vertices <= 1 {
        return true;
    }
    let res: BfsResult = bfs_traverse(g, 0, num_vertices);
    return (res).visited_count == num_vertices;
}

pub fn bfs_bipartite_check(g: &GraphAdjList, num_vertices: Int) -> Bool {
    let mut color: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_vertices {
        color = list_push(color, -1);
        i = i + 1;
    }

    let mut v: Int = 0;
    while v < num_vertices {
        if list_get(color, v) == -1 {
            let mut q: List[Int] = list_new();
            let mut head: Int = 0;
            q = list_push(q, v);
            
            let mut upd_c: List[Int] = list_new();
            let mut k: Int = 0;
            while k < num_vertices {
                if k == v { upd_c = list_push(upd_c, 0); } else { upd_c = list_push(upd_c, list_get(color, k)); }
                k = k + 1;
            }
            color = upd_c;

            while head < list_len(q) {
                let curr: Int = list_get(q, head);
                head = head + 1;
                let c_curr: Int = list_get(color, curr);
                let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, curr);
                let num_nbrs: Int = list_len(nbrs);
                let mut j: Int = 0;
                while j < num_nbrs {
                    let nxt: Int = (list_get(nbrs, j)).target;
                    if nxt >= 0 && nxt < num_vertices {
                        let c_nxt: Int = list_get(color, nxt);
                        if c_nxt == -1 {
                            let next_color: Int = 1 - c_curr;
                            let mut nc_list: List[Int] = list_new();
                            let mut m: Int = 0;
                            while m < num_vertices {
                                if m == nxt { nc_list = list_push(nc_list, next_color); } else { nc_list = list_push(nc_list, list_get(color, m)); }
                                m = m + 1;
                            }
                            color = nc_list;
                            q = list_push(q, nxt);
                        } else if c_nxt == c_curr {
                            return false;
                        }
                    }
                    j = j + 1;
                }
            }
        }
        v = v + 1;
    }
    return true;
}
