// # Floyd-Warshall All-Pairs Shortest Paths
//
// Logline: Computes all-pairs shortest paths and transitive closure on dense graphs via dynamic programming.
//
// Setup: Triply-nested matrix relaxation engine operating over GraphAdjMatrix representations.
//
// Beats:
//   1. Initialize dense distance matrix with edge weights and zero-diagonal baselines.
//   2. Dynamically relax all intermediate path triples (i, k, j) across vertex order.
//   3. Extract pairwise distances, detect negative cycles, and compute transitive closures.

import "./graph_adjacency_matrix.oo";

pub type FloydWarshallResult = struct {
    dist_matrix: List[Int],
    vertex_count: Int,
    has_negative_cycle: Bool
};

pub fn floyd_warshall_compute(adj_mat: &GraphAdjMatrix) -> FloydWarshallResult {
    let n: Int = (adj_mat).vertex_capacity;
    let inf_dist: Int = 1000000000;
    let total_cells: Int = n * n;

    let mut dist: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let mut j: Int = 0;
        while j < n {
            if i == j {
                dist = list_push(dist, 0);
            } else {
                let w: Int = adj_matrix_get_edge(adj_mat, i, j);
                if w != (adj_mat).no_edge_val {
                    dist = list_push(dist, w);
                } else {
                    dist = list_push(dist, inf_dist);
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Dynamic programming triples (k, i, j)
    let mut k: Int = 0;
    while k < n {
        let mut u: Int = 0;
        while u < n {
            let mut v: Int = 0;
            while v < n {
                let idx_uv: Int = (u * n) + v;
                let idx_uk: Int = (u * n) + k;
                let idx_kv: Int = (k * n) + v;

                let d_uk: Int = list_get(dist, idx_uk);
                let d_kv: Int = list_get(dist, idx_kv);
                let d_uv: Int = list_get(dist, idx_uv);

                if d_uk != inf_dist && d_kv != inf_dist {
                    let new_d: Int = d_uk + d_kv;
                    if new_d < d_uv {
                        let mut upd_dist: List[Int] = list_new();
                        let mut idx: Int = 0;
                        while idx < total_cells {
                            if idx == idx_uv {
                                upd_dist = list_push(upd_dist, new_d);
                            } else {
                                upd_dist = list_push(upd_dist, list_get(dist, idx));
                            }
                            idx = idx + 1;
                        }
                        dist = upd_dist;
                    }
                }
                v = v + 1;
            }
            u = u + 1;
        }
        k = k + 1;
    }

    // Check diagonal for negative cycles
    let mut has_neg_cycle: Bool = false;
    let mut diag: Int = 0;
    while diag < n {
        let idx_diag: Int = (diag * n) + diag;
        if list_get(dist, idx_diag) < 0 {
            has_neg_cycle = true;
        }
        diag = diag + 1;
    }

    return FloydWarshallResult {
        dist_matrix: dist,
        vertex_count: n,
        has_negative_cycle: has_neg_cycle
    };
}

pub fn floyd_warshall_get_distance(res: &FloydWarshallResult, u: Int, v: Int) -> Int {
    let n: Int = (res).vertex_count;
    if u < 0 || u >= n || v < 0 || v >= n {
        return -1;
    }
    let idx: Int = (u * n) + v;
    return list_get((res).dist_matrix, idx);
}

pub fn floyd_warshall_transitive_closure(adj_mat: &GraphAdjMatrix) -> List[Bool] {
    let n: Int = (adj_mat).vertex_capacity;
    let res: FloydWarshallResult = floyd_warshall_compute(adj_mat);
    let mut closure: List[Bool] = list_new();
    let total_cells: Int = n * n;
    let mut i: Int = 0;
    while i < total_cells {
        let d: Int = list_get((res).dist_matrix, i);
        if d < 1000000000 {
            closure = list_push(closure, true);
        } else {
            closure = list_push(closure, false);
        }
        i = i + 1;
    }
    return closure;
}

pub fn all_pairs_floyd_warshall_probe() -> Int {
    return 0;
}
