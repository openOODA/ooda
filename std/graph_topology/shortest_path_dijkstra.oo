// # Dijkstra's Shortest Path Algorithm
//
// Logline: Computes single-source shortest paths on non-negative weighted graphs via greedy priority relaxation.
//
// Setup: Distance relaxation engine operating over GraphAdjList representations.
//
// Beats:
//   1. Maintain minimum distance estimates and predecessor vectors across all vertices.
//   2. Greedily extract unvisited minimum-distance candidates and relax outgoing edges.
//   3. Reconstruct optimal shortest paths from source to any reachable destination vertex.

import "./graph_adjacency_list.oo";

pub type DijkstraResult = struct {
    distances: List[Int],
    predecessors: List[Int],
    source: Int,
    reachable_count: Int,
};

pub fn dijkstra_shortest_path(g: &GraphAdjList, source: Int, num_vertices: Int) -> DijkstraResult {
    let inf_dist: Int = 2147483647;
    let mut dist: List[Int] = list_new();
    let mut pred: List[Int] = list_new();
    let mut visited: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < num_vertices {
        if i == source {
            dist = list_push(dist, 0);
        } else {
            dist = list_push(dist, inf_dist);
        }
        pred = list_push(pred, -1);
        visited = list_push(visited, false);
        i = i + 1;
    }

    let mut reachable: Int = 0;
    let mut step: Int = 0;
    while step < num_vertices {
        // Find unvisited vertex with smallest distance
        let mut min_u: Int = -1;
        let mut min_val: Int = inf_dist;
        let mut v: Int = 0;
        while v < num_vertices {
            if !list_get(visited, v) {
                let d: Int = list_get(dist, v);
                if d < min_val {
                    min_val = d;
                    min_u = v;
                }
            }
            v = v + 1;
        }

        if min_u == -1 || min_val == inf_dist {
            step = num_vertices; // Break loop
        } else {
            // Mark visited
            let mut upd_vis: List[Bool] = list_new();
            let mut k: Int = 0;
            while k < num_vertices {
                if k == min_u { upd_vis = list_push(upd_vis, true); } else { upd_vis = list_push(upd_vis, list_get(visited, k)); }
                k = k + 1;
            }
            visited = upd_vis;
            reachable = reachable + 1;

            // Relax outgoing edges
            let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, min_u);
            let num_nbrs: Int = list_len(nbrs);
            let mut j: Int = 0;
            while j < num_nbrs {
                let edge: AdjEdge = list_get(nbrs, j);
                let target: Int = (edge).target;
                let weight: Int = (edge).weight;
                if target >= 0 && target < num_vertices && !list_get(visited, target) {
                    let new_d: Int = min_val + weight;
                    if new_d < list_get(dist, target) {
                        let mut upd_dist: List[Int] = list_new();
                        let mut upd_pred: List[Int] = list_new();
                        let mut m: Int = 0;
                        while m < num_vertices {
                            if m == target {
                                upd_dist = list_push(upd_dist, new_d);
                                upd_pred = list_push(upd_pred, min_u);
                            } else {
                                upd_dist = list_push(upd_dist, list_get(dist, m));
                                upd_pred = list_push(upd_pred, list_get(pred, m));
                            }
                            m = m + 1;
                        }
                        dist = upd_dist;
                        pred = upd_pred;
                    }
                }
                j = j + 1;
            }
            step = step + 1;
        }
    }

    return DijkstraResult {
        distances: dist,
        predecessors: pred,
        source: source,
        reachable_count: reachable,
    };
}

pub fn dijkstra_get_distance(res: &DijkstraResult, target: Int) -> Int {
    if target < 0 || target >= list_len((res).distances) {
        return -1;
    }
    return list_get((res).distances, target);
}

pub fn dijkstra_get_path(res: &DijkstraResult, target: Int) -> List[Int] {
    let mut path: List[Int] = list_new();
    let d: Int = dijkstra_get_distance(res, target);
    if d == 2147483647 || d == -1 {
        return path;
    }

    let mut curr: Int = target;
    let mut rev_path: List[Int] = list_new();
    while curr != -1 {
        rev_path = list_push(rev_path, curr);
        if curr == (res).source {
            curr = -1;
        } else {
            curr = list_get((res).predecessors, curr);
        }
    }

    let n: Int = list_len(rev_path);
    let mut idx: Int = n - 1;
    while idx >= 0 {
        path = list_push(path, list_get(rev_path, idx));
        idx = idx - 1;
    }
    return path;
}
