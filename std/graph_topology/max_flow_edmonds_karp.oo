// # Edmonds-Karp Maximum Network Flow Algorithm
//
// Logline: Computes maximum network flow in capacity networks via BFS augmenting path exploration.
//
// Setup: Residual capacity network solver operating over GraphAdjMatrix representations.
//
// Beats:
//   1. Search shortest augmenting paths from source to sink using BFS on residual capacities.
//   2. Calculate bottleneck capacities along identified paths and augment total flow.
//   3. Maintain anti-symmetric residual flow matrix and query edge saturation states.

import "./graph_adjacency_matrix.oo";

pub type MaxFlowResult = struct {
    max_flow: Int,
    flow_matrix: List[Int],
    source: Int,
    sink: Int,
    vertex_count: Int
};

pub fn edmonds_karp_max_flow(capacity_mat: &GraphAdjMatrix, source: Int, sink: Int) -> MaxFlowResult {
    let n: Int = (capacity_mat).vertex_capacity;
    let total_cells: Int = n * n;

    // Initialize flow matrix to 0
    let mut flow: List[Int] = list_new();
    let mut idx: Int = 0;
    while idx < total_cells {
        flow = list_push(flow, 0);
        idx = idx + 1;
    }

    let mut total_flow: Int = 0;
    let mut path_found: Bool = true;

    while path_found {
        // BFS to find augmenting path
        let mut pred: List[Int] = list_new();
        let mut i: Int = 0;
        while i < n {
            pred = list_push(pred, -1);
            i = i + 1;
        }

        let mut queue: List[Int] = list_new();
        queue = list_push(queue, source);
        let mut q_head: Int = 0;

        let mut reached_sink: Bool = false;
        while q_head < list_len(queue) && !reached_sink {
            let u: Int = list_get(queue, q_head);
            q_head = q_head + 1;

            let mut v: Int = 0;
            while v < n && !reached_sink {
                let cell_idx: Int = (u * n) + v;
                let cap: Int = adj_matrix_get_edge(capacity_mat, u, v);
                let cur_fl: Int = list_get(flow, cell_idx);
                let residual: Int = cap - cur_fl;

                if residual > 0 && list_get(pred, v) == -1 && v != source {
                    let mut upd_pred: List[Int] = list_new();
                    let mut k: Int = 0;
                    while k < n {
                        if k == v { upd_pred = list_push(upd_pred, u); } else { upd_pred = list_push(upd_pred, list_get(pred, k)); }
                        k = k + 1;
                    }
                    pred = upd_pred;
                    queue = list_push(queue, v);
                    if v == sink {
                        reached_sink = true;
                    }
                }
                v = v + 1;
            }
        }

        if !reached_sink {
            path_found = false;
        } else {
            // Find bottleneck capacity
            let mut bottleneck: Int = 1000000000;
            let mut curr: Int = sink;
            while curr != source {
                let p: Int = list_get(pred, curr);
                let cell_idx: Int = (p * n) + curr;
                let cap: Int = adj_matrix_get_edge(capacity_mat, p, curr);
                let cur_fl: Int = list_get(flow, cell_idx);
                let res_cap: Int = cap - cur_fl;
                if res_cap < bottleneck {
                    bottleneck = res_cap;
                }
                curr = p;
            }

            // Augment flow
            curr = sink;
            while curr != source {
                let p: Int = list_get(pred, curr);
                let forward_idx: Int = (p * n) + curr;
                let reverse_idx: Int = (curr * n) + p;

                let old_f: Int = list_get(flow, forward_idx);
                let old_r: Int = list_get(flow, reverse_idx);

                let mut upd_flow: List[Int] = list_new();
                let mut cell: Int = 0;
                while cell < total_cells {
                    if cell == forward_idx {
                        upd_flow = list_push(upd_flow, old_f + bottleneck);
                    } else if cell == reverse_idx {
                        upd_flow = list_push(upd_flow, old_r - bottleneck);
                    } else {
                        upd_flow = list_push(upd_flow, list_get(flow, cell));
                    }
                    cell = cell + 1;
                }
                flow = upd_flow;
                curr = p;
            }
            total_flow = total_flow + bottleneck;
        }
    }

    return MaxFlowResult {
        max_flow: total_flow,
        flow_matrix: flow,
        source: source,
        sink: sink,
        vertex_count: n
    };
}

pub fn edmonds_karp_get_flow(res: &MaxFlowResult, u: Int, v: Int) -> Int {
    let n: Int = (res).vertex_count;
    if u < 0 || u >= n || v < 0 || v >= n {
        return 0;
    }
    let cell_idx: Int = (u * n) + v;
    return list_get((res).flow_matrix, cell_idx);
}

pub fn edmonds_karp_is_saturated(res: &MaxFlowResult, u: Int, v: Int, capacity_mat: &GraphAdjMatrix) -> Bool {
    let cap: Int = adj_matrix_get_edge(capacity_mat, u, v);
    let f: Int = edmonds_karp_get_flow(res, u, v);
    return f >= cap && cap > 0;
}

pub fn max_flow_edmonds_karp_probe() -> Int {
    return 0;
}
