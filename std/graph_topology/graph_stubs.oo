pub type GraphHardwareAccel = struct {
    device_id: Int,
    is_active: Bool
};

pub fn graph_hardware_accel_init(device_id: Int) -> GraphHardwareAccel {
    return GraphHardwareAccel {
        device_id: device_id,
        is_active: false
    };
}

pub fn graph_graphblas_mxm_native(
    sys: &SysCap,
