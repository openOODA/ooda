// # Graph Adjacency Matrix Representation
//
// Logline: Implements a 2D matrix graph representation for constant-time edge lookups and dense topology modeling.
//
// Setup: Pure memory-backed flattened 2D matrix structure supporting weighted directed and undirected graphs.
//
// Beats:
//   1. Define GraphAdjMatrix structure with configurable vertex capacity and sentinel values.
//   2. Implement constant-time edge insertion, removal, weight query, and existence checks.
//   3. Provide degree calculation routines and dense row/column iterators.

pub type GraphAdjMatrix = struct {
    data: List[Int],
    vertex_capacity: Int,
    is_directed: Bool,
    edge_count: Int,
    no_edge_val: Int
};

pub fn adj_matrix_create(vertex_capacity: Int, is_directed: Bool) -> GraphAdjMatrix {
    let mut matrix_data: List[Int] = list_new();
    let total_cells: Int = vertex_capacity * vertex_capacity;
    let mut i: Int = 0;
    while i < total_cells {
        matrix_data = list_push(matrix_data, 0);
        i = i + 1;
    }
    return GraphAdjMatrix {
        data: matrix_data,
        vertex_capacity: vertex_capacity,
        is_directed: is_directed,
        edge_count: 0,
        no_edge_val: 0
    };
}

pub fn adj_matrix_get_index(cap: Int, u: Int, v: Int) -> Int {
    return (u * cap) + v;
}

pub fn adj_matrix_get_edge(g: &GraphAdjMatrix, u: Int, v: Int) -> Int {
    let cap: Int = (g).vertex_capacity;
    if u < 0 || u >= cap || v < 0 || v >= cap {
        return (g).no_edge_val;
    }
    let idx: Int = adj_matrix_get_index(cap, u, v);
    return list_get((g).data, idx);
}

pub fn adj_matrix_has_edge(g: &GraphAdjMatrix, u: Int, v: Int) -> Bool {
    let weight: Int = adj_matrix_get_edge(g, u, v);
    return weight != (g).no_edge_val;
}

pub fn adj_matrix_add_edge(g: &mut GraphAdjMatrix, u: Int, v: Int, weight: Int) -> Bool {
    let cap: Int = (g).vertex_capacity;
    if u < 0 || u >= cap || v < 0 || v >= cap {
        return false;
    }
    let idx: Int = adj_matrix_get_index(cap, u, v);
    let had_edge: Bool = list_get((g).data, idx) != (g).no_edge_val;
    
    let total_cells: Int = cap * cap;
    let mut new_data: List[Int] = list_new();
    let sym_idx: Int = adj_matrix_get_index(cap, v, u);
    let mut i: Int = 0;
    while i < total_cells {
        if i == idx {
            new_data = list_push(new_data, weight);
        } else if !(g).is_directed && i == sym_idx {
            new_data = list_push(new_data, weight);
        } else {
            let old_val: Int = list_get((g).data, i);
            new_data = list_push(new_data, old_val);
        }
        i = i + 1;
    }
    (g).data = new_data;
    if !had_edge {
        (g).edge_count = (g).edge_count + 1;
    }
    return true;
}

pub fn adj_matrix_remove_edge(g: &mut GraphAdjMatrix, u: Int, v: Int) -> Bool {
    let cap: Int = (g).vertex_capacity;
    if u < 0 || u >= cap || v < 0 || v >= cap {
        return false;
    }
    let idx: Int = adj_matrix_get_index(cap, u, v);
    let had_edge: Bool = list_get((g).data, idx) != (g).no_edge_val;
    if !had_edge {
        return false;
    }
    
    let total_cells: Int = cap * cap;
    let mut new_data: List[Int] = list_new();
    let sym_idx: Int = adj_matrix_get_index(cap, v, u);
    let mut i: Int = 0;
    while i < total_cells {
        if i == idx {
            new_data = list_push(new_data, (g).no_edge_val);
        } else if !(g).is_directed && i == sym_idx {
            new_data = list_push(new_data, (g).no_edge_val);
        } else {
            let old_val: Int = list_get((g).data, i);
            new_data = list_push(new_data, old_val);
        }
        i = i + 1;
    }
    (g).data = new_data;
    (g).edge_count = (g).edge_count - 1;
    return true;
}

pub fn adj_matrix_out_degree(g: &GraphAdjMatrix, u: Int) -> Int {
    let cap: Int = (g).vertex_capacity;
    if u < 0 || u >= cap {
        return 0;
    }
    let mut deg: Int = 0;
    let mut v: Int = 0;
    while v < cap {
        if adj_matrix_has_edge(g, u, v) {
            deg = deg + 1;
        }
        v = v + 1;
    }
    return deg;
}

pub fn adj_matrix_in_degree(g: &GraphAdjMatrix, v: Int) -> Int {
    let cap: Int = (g).vertex_capacity;
    if v < 0 || v >= cap {
        return 0;
    }
    let mut deg: Int = 0;
    let mut u: Int = 0;
    while u < cap {
        if adj_matrix_has_edge(g, u, v) {
            deg = deg + 1;
        }
        u = u + 1;
    }
    return deg;
}

pub fn adj_matrix_vertex_count(g: &GraphAdjMatrix) -> Int {
    return (g).vertex_capacity;
}

pub fn adj_matrix_edge_count(g: &GraphAdjMatrix) -> Int {
    return (g).edge_count;
}
