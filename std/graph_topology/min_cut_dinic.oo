// # Dinic's Minimum Cut Algorithm
//
// Logline: Computes the minimum s-t cut capacity and partitions nodes into source/sink reachability sets.
//
// Setup: Level graph and blocking flow engine operating over GraphAdjMatrix representations.
//
// Beats:
//   1. Construct BFS level graphs to establish shortest layered flow paths.
//   2. Compute maximum flow and residual reachability from source.
//   3. Identify bottleneck cut edges traversing the source-to-sink partition boundary.

import "./graph_adjacency_matrix.oo";
import "./graph_edge_list.oo";

pub type DinicCutResult = struct {
    min_cut_capacity: Int,
    cut_edges: List[GraphEdge],
    source_partition_size: Int,
    sink_partition_size: Int
};

pub fn dinic_min_cut(capacity_mat: &GraphAdjMatrix, source: Int, sink: Int) -> DinicCutResult {
    let n: Int = (capacity_mat).vertex_capacity;
    let total_cells: Int = n * n;

    let mut flow: List[Int] = list_new();
    let mut idx: Int = 0;
    while idx < total_cells {
        flow = list_push(flow, 0);
        idx = idx + 1;
    }

    let mut total_flow: Int = 0;
    let mut running: Bool = true;

    while running {
        let mut level: List[Int] = list_new();
        let mut i: Int = 0;
        while i < n {
            if i == source { level = list_push(level, 0); } else { level = list_push(level, -1); }
            i = i + 1;
        }

        let mut queue: List[Int] = list_new();
        queue = list_push(queue, source);
        let mut q_head: Int = 0;

        while q_head < list_len(queue) {
            let u: Int = list_get(queue, q_head);
            q_head = q_head + 1;
            let u_lvl: Int = list_get(level, u);

            let mut v: Int = 0;
            while v < n {
                let cell_idx: Int = (u * n) + v;
                let cap: Int = adj_matrix_get_edge(capacity_mat, u, v);
                let cur_f: Int = list_get(flow, cell_idx);
                if cap - cur_f > 0 && list_get(level, v) == -1 {
                    let mut nxt_lvl: List[Int] = list_new();
                    let mut m: Int = 0;
                    while m < n {
                        if m == v { nxt_lvl = list_push(nxt_lvl, u_lvl + 1); } else { nxt_lvl = list_push(nxt_lvl, list_get(level, m)); }
                        m = m + 1;
                    }
                    level = nxt_lvl;
                    queue = list_push(queue, v);
                }
                v = v + 1;
            }
        }

        if list_get(level, sink) == -1 {
            running = false;
        } else {
            let mut pushed_any: Bool = true;
            while pushed_any {
                let mut stack: List[Int] = list_new();
                let mut pred: List[Int] = list_new();
                let mut p_idx: Int = 0;
                while p_idx < n {
                    pred = list_push(pred, -1);
                    p_idx = p_idx + 1;
                }
                stack = list_push(stack, source);
                let mut found_path: Bool = false;

                while list_len(stack) > 0 && !found_path {
                    let curr: Int = list_get(stack, list_len(stack) - 1);
                    if curr == sink {
                        found_path = true;
                    } else {
                        let mut next_v: Int = -1;
                        let mut cand: Int = 0;
                        while cand < n && next_v == -1 {
                            let cell_idx: Int = (curr * n) + cand;
                            let cap: Int = adj_matrix_get_edge(capacity_mat, curr, cand);
                            let cur_f: Int = list_get(flow, cell_idx);
                            if cap - cur_f > 0 && list_get(level, cand) == list_get(level, curr) + 1 && list_get(pred, cand) == -1 && cand != source {
                                next_v = cand;
                            }
                            cand = cand + 1;
                        }

                        if next_v != -1 {
                            let mut upd_p: List[Int] = list_new();
                            let mut m: Int = 0;
                            while m < n {
                                if m == next_v { upd_p = list_push(upd_p, curr); } else { upd_p = list_push(upd_p, list_get(pred, m)); }
                                m = m + 1;
                            }
                            pred = upd_p;
                            stack = list_push(stack, next_v);
                        } else {
                            let mut new_st: List[Int] = list_new();
                            let mut s: Int = 0;
                            while s < list_len(stack) - 1 {
                                new_st = list_push(new_st, list_get(stack, s));
                                s = s + 1;
                            }
                            stack = new_st;
                        }
                    }
                }

                if !found_path {
                    pushed_any = false;
                } else {
                    let mut b_neck: Int = 1000000000;
                    let mut c_node: Int = sink;
                    while c_node != source {
                        let p: Int = list_get(pred, c_node);
                        let cell_idx: Int = (p * n) + c_node;
                        let cap: Int = adj_matrix_get_edge(capacity_mat, p, c_node);
                        let res_cap: Int = cap - list_get(flow, cell_idx);
                        if res_cap < b_neck { b_neck = res_cap; }
                        c_node = p;
                    }

                    c_node = sink;
                    while c_node != source {
                        let p: Int = list_get(pred, c_node);
                        let forward_idx: Int = (p * n) + c_node;
                        let reverse_idx: Int = (c_node * n) + p;
                        let old_f: Int = list_get(flow, forward_idx);
                        let old_r: Int = list_get(flow, reverse_idx);

                        let mut upd_flow: List[Int] = list_new();
                        let mut cell: Int = 0;
                        while cell < total_cells {
                            if cell == forward_idx { upd_flow = list_push(upd_flow, old_f + b_neck); }
                            else if cell == reverse_idx { upd_flow = list_push(upd_flow, old_r - b_neck); }
                            else { upd_flow = list_push(upd_flow, list_get(flow, cell)); }
                            cell = cell + 1;
                        }
                        flow = upd_flow;
                        c_node = p;
                    }
                    total_flow = total_flow + b_neck;
                }
            }
        }
    }

    let mut reachable: List[Bool] = list_new();
    let mut r_idx: Int = 0;
    while r_idx < n {
        if r_idx == source { reachable = list_push(reachable, true); } else { reachable = list_push(reachable, false); }
        r_idx = r_idx + 1;
    }

    let mut q: List[Int] = list_new();
    q = list_push(q, source);
    let mut q_h: Int = 0;

    while q_h < list_len(q) {
        let u: Int = list_get(q, q_h);
        q_h = q_h + 1;
        let mut v: Int = 0;
        while v < n {
            let cell_idx: Int = (u * n) + v;
            let cap: Int = adj_matrix_get_edge(capacity_mat, u, v);
            let cur_f: Int = list_get(flow, cell_idx);
            if cap - cur_f > 0 && !list_get(reachable, v) {
                let mut nxt_r: List[Bool] = list_new();
                let mut m: Int = 0;
                while m < n {
                    if m == v { nxt_r = list_push(nxt_r, true); } else { nxt_r = list_push(nxt_r, list_get(reachable, m)); }
                    m = m + 1;
                }
                reachable = nxt_r;
                q = list_push(q, v);
            }
            v = v + 1;
        }
    }

    let mut cut_edges: List[GraphEdge] = list_new();
    let mut src_count: Int = 0;
    let mut u_node: Int = 0;
    while u_node < n {
        if list_get(reachable, u_node) {
            src_count = src_count + 1;
            let mut v_node: Int = 0;
            while v_node < n {
                if !list_get(reachable, v_node) {
                    let cap: Int = adj_matrix_get_edge(capacity_mat, u_node, v_node);
                    if cap > 0 {
                        let e: GraphEdge = graph_edge_new(u_node, v_node, cap);
                        cut_edges = list_push(cut_edges, e);
                    }
                }
                v_node = v_node + 1;
            }
        }
        u_node = u_node + 1;
    }

    return DinicCutResult {
        min_cut_capacity: total_flow,
        cut_edges: cut_edges,
        source_partition_size: src_count,
        sink_partition_size: n - src_count
    };
}

pub fn dinic_cut_size(res: &DinicCutResult) -> Int {
    return list_len((res).cut_edges);
}

pub fn dinic_cut_capacity(res: &DinicCutResult) -> Int {
    return (res).min_cut_capacity;
}
