// # Kahn's Topological Sorting Algorithm
//
// Logline: Computes a linear topological ordering of vertices in directed acyclic graphs (DAGs) using in-degree reduction.
//
// Setup: In-degree queue processing engine with cyclic dependency validation.
//
// Beats:
//   1. Compute precise in-degree distributions across all directed graph vertices.
//   2. Iteratively dequeue zero-in-degree nodes and relax downstream dependencies.
//   3. Validate DAG acyclicity by comparing processed vertex count against graph order.

import "./graph_adjacency_list.oo";

pub type TopoSortResult = struct {
    order: List[Int],
    is_dag: Bool,
    processed_count: Int,
};

pub fn kahn_compute_in_degrees(g: &GraphAdjList, num_vertices: Int) -> List[Int] {
    let mut in_degree: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_vertices {
        in_degree = list_push(in_degree, 0);
        i = i + 1;
    }

    let mut u: Int = 0;
    while u < num_vertices {
        let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, u);
        let n: Int = list_len(nbrs);
        let mut j: Int = 0;
        while j < n {
            let v: Int = (list_get(nbrs, j)).target;
            if v >= 0 && v < num_vertices {
                let cur_deg: Int = list_get(in_degree, v);
                let mut upd_deg: List[Int] = list_new();
                let mut k: Int = 0;
                while k < num_vertices {
                    if k == v { upd_deg = list_push(upd_deg, cur_deg + 1); } else { upd_deg = list_push(upd_deg, list_get(in_degree, k)); }
                    k = k + 1;
                }
                in_degree = upd_deg;
            }
            j = j + 1;
        }
        u = u + 1;
    }
    return in_degree;
}

pub fn kahn_topological_sort(g: &GraphAdjList, num_vertices: Int) -> TopoSortResult {
    let mut in_degrees: List[Int] = kahn_compute_in_degrees(g, num_vertices);
    let mut queue: List[Int] = list_new();
    let mut q_head: Int = 0;

    let mut i: Int = 0;
    while i < num_vertices {
        if list_get(in_degrees, i) == 0 {
            queue = list_push(queue, i);
        }
        i = i + 1;
    }

    let mut topo_order: List[Int] = list_new();
    while q_head < list_len(queue) {
        let u: Int = list_get(queue, q_head);
        q_head = q_head + 1;
        topo_order = list_push(topo_order, u);

        let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, u);
        let num_nbrs: Int = list_len(nbrs);
        let mut j: Int = 0;
        while j < num_nbrs {
            let v: Int = (list_get(nbrs, j)).target;
            if v >= 0 && v < num_vertices {
                let cur_deg: Int = list_get(in_degrees, v);
                let new_deg: Int = cur_deg - 1;
                let mut upd_deg: List[Int] = list_new();
                let mut k: Int = 0;
                while k < num_vertices {
                    if k == v { upd_deg = list_push(upd_deg, new_deg); } else { upd_deg = list_push(upd_deg, list_get(in_degrees, k)); }
                    k = k + 1;
                }
                in_degrees = upd_deg;
                if new_deg == 0 {
                    queue = list_push(queue, v);
                }
            }
            j = j + 1;
        }
    }

    let processed: Int = list_len(topo_order);
    let is_dag: Bool = processed == num_vertices;
    return TopoSortResult {
        order: topo_order,
        is_dag: is_dag,
        processed_count: processed,
    };
}

pub fn kahn_is_acyclic(g: &GraphAdjList, num_vertices: Int) -> Bool {
    let res: TopoSortResult = kahn_topological_sort(g, num_vertices);
    return (res).is_dag;
}
