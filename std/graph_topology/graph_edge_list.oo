// # Graph Edge List Representation
//
// Logline: Implements a sequential edge-list graph representation tailored for spanning trees and flow algorithms.
//
// Setup: Pure lightweight collection of weighted source-to-destination graph edges.
//
// Beats:
//   1. Define GraphEdge and GraphEdgeList structures for linear edge iteration.
//   2. Implement edge addition, query, lookup, and capacity inspection.
//   3. Provide edge sorting and filtering routines for greedy graph algorithms.

pub type GraphEdge = struct {
    src: Int,
    dst: Int,
    weight: Int
};

pub type GraphEdgeList = struct {
    edges: List[GraphEdge],
    is_directed: Bool,
    edge_count: Int
};

pub fn graph_edge_new(src: Int, dst: Int, weight: Int) -> GraphEdge {
    return GraphEdge {
        src: src,
        dst: dst,
        weight: weight
    };
}

pub fn edge_list_create(is_directed: Bool) -> GraphEdgeList {
    let empty_edges: List[GraphEdge] = list_new();
    return GraphEdgeList {
        edges: empty_edges,
        is_directed: is_directed,
        edge_count: 0
    };
}

pub fn edge_list_add_edge(g: &mut GraphEdgeList, src: Int, dst: Int, weight: Int) -> Bool {
    let edge: GraphEdge = graph_edge_new(src, dst, weight);
    (g).edges = list_push((g).edges, edge);
    (g).edge_count = (g).edge_count + 1;
    if !(g).is_directed {
        let rev_edge: GraphEdge = graph_edge_new(dst, src, weight);
        (g).edges = list_push((g).edges, rev_edge);
        (g).edge_count = (g).edge_count + 1;
    }
    return true;
}

pub fn edge_list_get_edge(g: &GraphEdgeList, index: Int) -> Option[GraphEdge] {
    if index < 0 || index >= (g).edge_count {
        return None;
    }
    let e: GraphEdge = list_get((g).edges, index);
    return Some(e);
}

pub fn edge_list_edge_count(g: &GraphEdgeList) -> Int {
    return (g).edge_count;
}

pub fn edge_list_find_edge(g: &GraphEdgeList, src: Int, dst: Int) -> Option[GraphEdge] {
    let edge_list: List[GraphEdge] = (g).edges;
    let n: Int = list_len(edge_list);
    let mut i: Int = 0;
    while i < n {
        let e: GraphEdge = list_get(edge_list, i);
        if (e).src == src && (e).dst == dst {
            return Some(e);
        }
        i = i + 1;
    }
    return None;
}

pub fn edge_list_sort_by_weight(g: &GraphEdgeList) -> List[GraphEdge] {
    let edges: List[GraphEdge] = (g).edges;
    let n: Int = list_len(edges);
    let mut sorted: List[GraphEdge] = list_new();
    let mut i: Int = 0;
    while i < n {
        sorted = list_push(sorted, list_get(edges, i));
        i = i + 1;
    }
    
    // Bubble sort for deterministic MST edge ordering
    let mut a: Int = 0;
    while a < n {
        let mut b: Int = 0;
        while b < n - 1 - a {
            let e1: GraphEdge = list_get(sorted, b);
            let e2: GraphEdge = list_get(sorted, b + 1);
            if (e1).weight > (e2).weight {
                let mut temp: List[GraphEdge] = list_new();
                let mut k: Int = 0;
                while k < n {
                    if k == b {
                        temp = list_push(temp, e2);
                    } else if k == b + 1 {
                        temp = list_push(temp, e1);
                    } else {
                        temp = list_push(temp, list_get(sorted, k));
                    }
                    k = k + 1;
                }
                sorted = temp;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return sorted;
}
