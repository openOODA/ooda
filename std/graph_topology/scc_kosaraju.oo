// # Kosaraju-Sharir Strongly Connected Components Algorithm
//
// Logline: Computes strongly connected components in directed graphs via two DFS passes on graph and transpose.
//
// Setup: Double-pass depth-first traversal engine operating over forward and transposed GraphAdjList representations.
//
// Beats:
//   1. Perform forward DFS pass to accumulate vertices in order of finishing times.
//   2. Compute transposed graph by reversing all directed adjacency relations.
//   3. Perform reverse DFS pass along finish order to partition strongly connected components.

import "./graph_adjacency_list.oo";

pub type KosarajuSccResult = struct {
    component_ids: List[Int],
    scc_count: Int,
    num_vertices: Int
};

pub fn graph_transpose(g: &GraphAdjList, num_vertices: Int) -> GraphAdjList {
    let mut gt: GraphAdjList = adj_list_create(true);
    let mut v: Int = 0;
    while v < num_vertices {
        adj_list_add_vertex(&mut gt, v);
        v = v + 1;
    }

    let mut u: Int = 0;
    while u < num_vertices {
        let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, u);
        let n: Int = list_len(nbrs);
        let mut j: Int = 0;
        while j < n {
            let edge: AdjEdge = list_get(nbrs, j);
            let w: Int = (edge).target;
            let weight: Int = (edge).weight;
            adj_list_add_edge_directed(&mut gt, w, u, weight);
            j = j + 1;
        }
        u = u + 1;
    }
    return gt;
}

pub fn kosaraju_scc_find(g: &GraphAdjList, num_vertices: Int) -> KosarajuSccResult {
    let mut visited: List[Bool] = list_new();
    let mut comp_ids: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_vertices {
        visited = list_push(visited, false);
        comp_ids = list_push(comp_ids, -1);
        i = i + 1;
    }

    // Step 1: Forward pass to get finish order
    let mut finish_stack: List[Int] = list_new();
    let mut v: Int = 0;
    while v < num_vertices {
        if !list_get(visited, v) {
            let mut stack: List[Int] = list_new();
            stack = list_push(stack, v);
            while list_len(stack) > 0 {
                let curr: Int = list_get(stack, list_len(stack) - 1);
                if !list_get(visited, curr) {
                    let mut upd_vis: List[Bool] = list_new();
                    let mut k: Int = 0;
                    while k < num_vertices {
                        if k == curr { upd_vis = list_push(upd_vis, true); } else { upd_vis = list_push(upd_vis, list_get(visited, k)); }
                        k = k + 1;
                    }
                    visited = upd_vis;

                    let nbrs: List[AdjEdge] = adj_list_get_neighbors(g, curr);
                    let n: Int = list_len(nbrs);
                    let mut j: Int = 0;
                    while j < n {
                        let nxt: Int = (list_get(nbrs, j)).target;
                        if nxt >= 0 && nxt < num_vertices && !list_get(visited, nxt) {
                            stack = list_push(stack, nxt);
                        }
                        j = j + 1;
                    }
                } else {
                    let mut new_s: List[Int] = list_new();
                    let mut s: Int = 0;
                    while s < list_len(stack) - 1 {
                        new_s = list_push(new_s, list_get(stack, s));
                        s = s + 1;
                    }
                    stack = new_s;
                    finish_stack = list_push(finish_stack, curr);
                }
            }
        }
        v = v + 1;
    }

    // Step 2: Transpose
    let gt: GraphAdjList = graph_transpose(g, num_vertices);

    // Step 3: DFS on transpose in reverse finish order
    let mut visited2: List[Bool] = list_new();
    let mut idx: Int = 0;
    while idx < num_vertices {
        visited2 = list_push(visited2, false);
        idx = idx + 1;
    }

    let mut scc_count: Int = 0;
    let mut f_idx: Int = list_len(finish_stack) - 1;
    while f_idx >= 0 {
        let u: Int = list_get(finish_stack, f_idx);
        if !list_get(visited2, u) {
            let mut q: List[Int] = list_new();
            q = list_push(q, u);
            let mut q_head: Int = 0;

            let mut upd_vis2: List[Bool] = list_new();
            let mut upd_comp: List[Int] = list_new();
            let mut k: Int = 0;
            while k < num_vertices {
                if k == u {
                    upd_vis2 = list_push(upd_vis2, true);
                    upd_comp = list_push(upd_comp, scc_count);
                } else {
                    upd_vis2 = list_push(upd_vis2, list_get(visited2, k));
                    upd_comp = list_push(upd_comp, list_get(comp_ids, k));
                }
                k = k + 1;
            }
            visited2 = upd_vis2;
            comp_ids = upd_comp;

            while q_head < list_len(q) {
                let curr_node: Int = list_get(q, q_head);
                q_head = q_head + 1;

                let nbrs: List[AdjEdge] = adj_list_get_neighbors(&gt, curr_node);
                let n: Int = list_len(nbrs);
                let mut j: Int = 0;
                while j < n {
                    let nxt: Int = (list_get(nbrs, j)).target;
                    if nxt >= 0 && nxt < num_vertices && !list_get(visited2, nxt) {
                        q = list_push(q, nxt);
                        let mut upd_v: List[Bool] = list_new();
                        let mut upd_c: List[Int] = list_new();
                        let mut m: Int = 0;
                        while m < num_vertices {
                            if m == nxt {
                                upd_v = list_push(upd_v, true);
                                upd_c = list_push(upd_c, scc_count);
                            } else {
                                upd_v = list_push(upd_v, list_get(visited2, m));
                                upd_c = list_push(upd_c, list_get(comp_ids, m));
                            }
                            m = m + 1;
                        }
                        visited2 = upd_v;
                        comp_ids = upd_c;
                    }
                    j = j + 1;
                }
            }
            scc_count = scc_count + 1;
        }
        f_idx = f_idx - 1;
    }

    return KosarajuSccResult {
        component_ids: comp_ids,
        scc_count: scc_count,
        num_vertices: num_vertices
    };
}

pub fn kosaraju_same_component(res: &KosarajuSccResult, u: Int, v: Int) -> Bool {
    if u < 0 || u >= (res).num_vertices || v < 0 || v >= (res).num_vertices {
        return false;
    }
    return list_get((res).component_ids, u) == list_get((res).component_ids, v);
}
