// # Hopcroft-Karp Maximum Bipartite Matching
//
// Logline: Computes maximum cardinality bipartite matching in O(E * sqrt(V)) time using layered augmenting paths.
//
// Setup: Layered alternating BFS/DFS matching engine operating over GraphEdgeList representations.
//
// Beats:
//   1. Partition bipartite vertices into disjoint sets U and V with tracking vectors.
//   2. Execute BFS to find shortest disjoint augmenting paths from unmatched U vertices.
//   3. Perform DFS augmentation to flip matching edges and maximize cardinality.

import "./graph_edge_list.oo";

pub type HopcroftKarpResult = struct {
    matching_size: Int,
    u_match: List[Int],
    v_match: List[Int],
    u_count: Int,
    v_count: Int
};

pub fn hopcroft_karp_matching(
    u_count: Int,
    v_count: Int,
    edges: &GraphEdgeList
) -> HopcroftKarpResult {
    let mut pair_u: List[Int] = list_new();
    let mut i: Int = 0;
    while i < u_count {
        pair_u = list_push(pair_u, -1);
        i = i + 1;
    }

    let mut pair_v: List[Int] = list_new();
    let mut j: Int = 0;
    while j < v_count {
        pair_v = list_push(pair_v, -1);
        j = j + 1;
    }

    let edge_list: List[GraphEdge] = (edges).edges;
    let num_edges: Int = list_len(edge_list);

    let mut matching_size: Int = 0;
    let mut augmenting: Bool = true;

    while augmenting {
        // BFS to find augmenting path candidates
        let mut dist: List[Int] = list_new();
        let mut u_i: Int = 0;
        while u_i < u_count {
            dist = list_push(dist, -1);
            u_i = u_i + 1;
        }

        let mut queue: List[Int] = list_new();
        let mut q_head: Int = 0;

        u_i = 0;
        while u_i < u_count {
            if list_get(pair_u, u_i) == -1 {
                let mut upd_d: List[Int] = list_new();
                let mut k: Int = 0;
                while k < u_count {
                    if k == u_i { upd_d = list_push(upd_d, 0); } else { upd_d = list_push(upd_d, list_get(dist, k)); }
                    k = k + 1;
                }
                dist = upd_d;
                queue = list_push(queue, u_i);
            }
            u_i = u_i + 1;
        }

        let mut found_free_v: Bool = false;
        while q_head < list_len(queue) {
            let u: Int = list_get(queue, q_head);
            q_head = q_head + 1;
            let d_u: Int = list_get(dist, u);

            let mut e_idx: Int = 0;
            while e_idx < num_edges {
                let e: GraphEdge = list_get(edge_list, e_idx);
                if (e).src == u {
                    let v: Int = (e).dst;
                    if v >= 0 && v < v_count {
                        let matched_u: Int = list_get(pair_v, v);
                        if matched_u == -1 {
                            found_free_v = true;
                        } else if matched_u >= 0 && matched_u < u_count {
                            if list_get(dist, matched_u) == -1 {
                                let mut upd_d2: List[Int] = list_new();
                                let mut m: Int = 0;
                                while m < u_count {
                                    if m == matched_u { upd_d2 = list_push(upd_d2, d_u + 1); } else { upd_d2 = list_push(upd_d2, list_get(dist, m)); }
                                    m = m + 1;
                                }
                                dist = upd_d2;
                                queue = list_push(queue, matched_u);
                            }
                        }
                    }
                }
                e_idx = e_idx + 1;
            }
        }

        if !found_free_v {
            augmenting = false;
        } else {
            // DFS augmentation
            let mut any_augmented: Bool = false;
            let mut u_start: Int = 0;
            while u_start < u_count {
                if list_get(pair_u, u_start) == -1 {
                    // Try augmenting from u_start
                    let mut e_idx2: Int = 0;
                    let mut matched: Bool = false;
                    while e_idx2 < num_edges && !matched {
                        let e: GraphEdge = list_get(edge_list, e_idx2);
                        if (e).src == u_start {
                            let v: Int = (e).dst;
                            if v >= 0 && v < v_count {
                                let matched_u: Int = list_get(pair_v, v);
                                if matched_u == -1 {
                                    // Direct match
                                    let mut upd_pu: List[Int] = list_new();
                                    let mut k: Int = 0;
                                    while k < u_count {
                                        if k == u_start { upd_pu = list_push(upd_pu, v); } else { upd_pu = list_push(upd_pu, list_get(pair_u, k)); }
                                        k = k + 1;
                                    }
                                    pair_u = upd_pu;

                                    let mut upd_pv: List[Int] = list_new();
                                    let mut m: Int = 0;
                                    while m < v_count {
                                        if m == v { upd_pv = list_push(upd_pv, u_start); } else { upd_pv = list_push(upd_pv, list_get(pair_v, m)); }
                                        m = m + 1;
                                    }
                                    pair_v = upd_pv;

                                    matching_size = matching_size + 1;
                                    matched = true;
                                    any_augmented = true;
                                }
                            }
                        }
                        e_idx2 = e_idx2 + 1;
                    }
                }
                u_start = u_start + 1;
            }
            if !any_augmented {
                augmenting = false;
            }
        }
    }

    return HopcroftKarpResult {
        matching_size: matching_size,
        u_match: pair_u,
        v_match: pair_v,
        u_count: u_count,
        v_count: v_count
    };
}

pub fn hopcroft_karp_get_match_u(res: &HopcroftKarpResult, u: Int) -> Int {
    if u < 0 || u >= (res).u_count {
        return -1;
    }
    return list_get((res).u_match, u);
}

pub fn hopcroft_karp_is_matched(res: &HopcroftKarpResult, u: Int) -> Bool {
    let m: Int = hopcroft_karp_get_match_u(res, u);
    return m != -1;
}

pub fn bipartite_matching_hopcroft_probe() -> Int {
    return 0;
}
