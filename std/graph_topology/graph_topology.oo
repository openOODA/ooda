// # Graph Theory, Topology & Distributed Networks Unified Facade
//
// Logline: Re-exports representations, traversals, shortest paths, spanning trees, flows, centrality, and P2P routing.
//
// Setup: Pure module shim and facade importing all 24 companion graph and network topology submodules.
//
// Beats:
//   1. Import 24 modular Graph Theory, Network Analysis, and Distributed Topology subcomponents.
//   2. Re-export public constructors, capability-gated interfaces, and routing entry points.
//   3. Maintain full compatibility with downstream openOODA graph and network consumers.

import "./graph_adjacency_list.oo";
import "./graph_adjacency_matrix.oo";
import "./graph_edge_list.oo";
import "./graph_traversal_bfs.oo";
import "./graph_traversal_dfs.oo";
import "./topological_sort_kahn.oo";
import "./shortest_path_dijkstra.oo";
import "./shortest_path_bellman_ford.oo";
import "./all_pairs_floyd_warshall.oo";
import "./mst_kruskal.oo";
import "./mst_prim.oo";
import "./scc_tarjan.oo";
import "./scc_kosaraju.oo";
import "./max_flow_edmonds_karp.oo";
import "./min_cut_dinic.oo";
import "./pagerank_power_iteration.oo";
import "./hits_authority_hub.oo";
import "./louvain_community_detect.oo";
import "./k_core_decomposition.oo";
import "./bipartite_matching_hopcroft.oo";
import "./graph_isomorphism_vf2.oo";
import "./gossip_protocol_mesh.oo";
import "./kademlia_dht_routing.oo";
import "./graph_stubs.oo";

pub fn graph_shim_adj_list_create(is_directed: Bool) -> GraphAdjList {
    return adj_list_create(is_directed);
}

pub fn graph_shim_adj_matrix_create(cap: Int, is_directed: Bool) -> GraphAdjMatrix {
    return adj_matrix_create(cap, is_directed);
}

pub fn graph_shim_edge_list_create(is_directed: Bool) -> GraphEdgeList {
    return edge_list_create(is_directed);
}

pub fn graph_shim_bfs(g: &GraphAdjList, start_vertex: Int, num_vertices: Int) -> BfsResult {
    return bfs_traverse(g, start_vertex, num_vertices);
}

pub fn graph_shim_dfs(g: &GraphAdjList, start_vertex: Int, num_vertices: Int) -> DfsResult {
    return dfs_traverse(g, start_vertex, num_vertices);
}

pub fn graph_shim_kahn_topo(g: &GraphAdjList, num_vertices: Int) -> TopoSortResult {
    return kahn_topological_sort(g, num_vertices);
}

pub fn graph_shim_dijkstra(g: &GraphAdjList, source: Int, num_vertices: Int) -> DijkstraResult {
    return dijkstra_shortest_path(g, source, num_vertices);
}

pub fn graph_shim_bellman_ford(edges: &GraphEdgeList, source: Int, num_vertices: Int) -> BellmanFordResult {
    return bellman_ford_shortest_path(edges, source, num_vertices);
}

pub fn graph_shim_floyd_warshall(adj_mat: &GraphAdjMatrix) -> FloydWarshallResult {
    return floyd_warshall_compute(adj_mat);
}

pub fn graph_shim_kruskal(edges: &GraphEdgeList, num_vertices: Int) -> KruskalMstResult {
    return kruskal_mst(edges, num_vertices);
}

pub fn graph_shim_prim(g: &GraphAdjList, num_vertices: Int, start_vertex: Int) -> PrimMstResult {
    return prim_mst(g, num_vertices, start_vertex);
}

pub fn graph_shim_tarjan_scc(g: &GraphAdjList, num_vertices: Int) -> TarjanSccResult {
    return tarjan_scc_find(g, num_vertices);
}

pub fn graph_shim_kosaraju_scc(g: &GraphAdjList, num_vertices: Int) -> KosarajuSccResult {
    return kosaraju_scc_find(g, num_vertices);
}

pub fn graph_shim_edmonds_karp(capacity_mat: &GraphAdjMatrix, source: Int, sink: Int) -> MaxFlowResult {
    return edmonds_karp_max_flow(capacity_mat, source, sink);
}

pub fn graph_shim_dinic_cut(capacity_mat: &GraphAdjMatrix, source: Int, sink: Int) -> DinicCutResult {
    return dinic_min_cut(capacity_mat, source, sink);
}

pub fn graph_shim_pagerank(g: &GraphAdjList, num_vertices: Int, damping: Int, max_iters: Int) -> PageRankResult {
    return pagerank_power_iteration(g, num_vertices, damping, max_iters);
}

pub fn graph_shim_hits(adj_mat: &GraphAdjMatrix, max_iters: Int) -> HitsResult {
    return hits_compute_scores(adj_mat, max_iters);
}

pub fn graph_shim_louvain(g: &GraphAdjList, num_vertices: Int, max_passes: Int) -> LouvainResult {
    return louvain_detect_communities(g, num_vertices, max_passes);
}

pub fn graph_shim_k_core(g: &GraphAdjList, num_vertices: Int) -> KCoreResult {
    return k_core_decompose(g, num_vertices);
}

pub fn graph_shim_hopcroft_matching(u_count: Int, v_count: Int, edges: &GraphEdgeList) -> HopcroftKarpResult {
    return hopcroft_karp_matching(u_count, v_count, edges);
}

pub fn graph_shim_vf2(g1: &GraphAdjMatrix, g2: &GraphAdjMatrix) -> Vf2Result {
    return vf2_is_isomorphic(g1, g2);
}

pub fn graph_shim_gossip_mesh(fanout: Int) -> GossipMesh {
    return gossip_mesh_create(fanout);
}

pub fn graph_shim_kademlia_table(local_id: Int, k_size: Int) -> KademliaRoutingTable {
    return kademlia_table_create(local_id, k_size);
}

pub fn graph_shim_hardware_accel(dev_id: Int) -> GraphHardwareAccel {
    return graph_hardware_accel_init(dev_id);
}
