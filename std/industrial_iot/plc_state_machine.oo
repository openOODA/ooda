// # IEC 61131-3 & ISA-88 PLC State Machine
//
// Logline: PackML discrete PLC states with command transitions and scan ticks.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type PlcStateMachine = struct {
    current_state: Int,
    previous_state: Int,
    step_counter: Int,
    cycle_time_ms: Int,
    error_code: Int
};

pub fn plc_state_machine_new() -> PlcStateMachine {
    return PlcStateMachine {
        current_state: 0,
        previous_state: 0,
        step_counter: 0,
        cycle_time_ms: 0,
        error_code: 0
    };
}

pub fn plc_state_name_code(state: Int) -> Int {
    if state < 0 {
        return 0 - 1;
    }
    if state > 13 {
        return 0 - 1;
    }
    return state;
}

pub fn plc_state_machine_command(sm: PlcStateMachine, cmd: Int) -> PlcStateMachine {
    let cur: Int = sm.current_state;
    if cmd == 7 {
        if cur != 10 {
            if cur != 11 {
                return PlcStateMachine {
                    current_state: 10,
                    previous_state: cur,
                    step_counter: 0,
                    cycle_time_ms: sm.cycle_time_ms,
                    error_code: 0
                };
            }
        }
        return sm;
    }
    if cmd == 2 {
        if cur == 1 || cur == 2 || cur == 3 || cur == 4 || cur == 6 || cur == 7 || cur == 8 {
            return PlcStateMachine {
                current_state: 9,
                previous_state: cur,
                step_counter: 0,
                cycle_time_ms: sm.cycle_time_ms,
                error_code: 0
            };
        }
        return sm;
    }
    let mut next: Int = 0 - 1;
    if cur == 0 {
        if cmd == 8 {
            next = 12;
        } else {
            if cmd == 1 {
                next = 1;
            }
        }
    } else {
        if cur == 2 {
            if cmd == 3 {
                next = 3;
            } else {
                if cmd == 5 {
                    next = 6;
                }
            }
        } else {
            if cur == 4 {
                if cmd == 4 {
                    next = 5;
                }
            } else {
                if cur == 7 {
                    if cmd == 6 {
                        next = 8;
                    }
                } else {
                    if cur == 11 {
                        if cmd == 8 {
                            next = 12;
                        }
                    }
                }
            }
        }
    }
    if next < 0 {
        return sm;
    }
    return PlcStateMachine {
        current_state: next,
        previous_state: cur,
        step_counter: 0,
        cycle_time_ms: sm.cycle_time_ms,
        error_code: 0
    };
}

pub fn plc_state_machine_tick(sm: PlcStateMachine, dt_ms: Int) -> PlcStateMachine {
    let steps: Int = sm.step_counter + 1;
    let cycle: Int = sm.cycle_time_ms + dt_ms;
    let cur: Int = sm.current_state;
    let mut next: Int = cur;
    let mut next_steps: Int = steps;
    if steps >= 5 {
        if cur == 1 {
            next = 2;
            next_steps = 0;
        } else {
            if cur == 3 {
                next = 4;
                next_steps = 0;
            } else {
                if cur == 5 {
                    next = 2;
                    next_steps = 0;
                } else {
                    if cur == 6 {
                        next = 7;
                        next_steps = 0;
                    } else {
                        if cur == 8 {
                            next = 2;
                            next_steps = 0;
                        } else {
                            if cur == 9 {
                                next = 0;
                                next_steps = 0;
                            } else {
                                if cur == 10 {
                                    next = 11;
                                    next_steps = 0;
                                } else {
                                    if cur == 12 {
                                        next = 0;
                                        next_steps = 0;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return PlcStateMachine {
        current_state: next,
        previous_state: sm.previous_state,
        step_counter: next_steps,
        cycle_time_ms: cycle,
        error_code: sm.error_code
    };
}
