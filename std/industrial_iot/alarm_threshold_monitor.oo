// # Industrial Alarm Threshold Monitoring (ISA-18.2)
//
// Logline: 4-tier alarm limits, deadband hysteresis, and ISA-18.2 lifecycle.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type AlarmThresholds = struct {
    low_low_limit: Float,
    low_limit: Float,
    high_limit: Float,
    high_high_limit: Float,
    deadband: Float
};

type ProcessAlarm = struct {
    tag_code: Int,
    thresholds: AlarmThresholds,
    current_severity: Int,
    state_code: Int,
    is_active: Bool,
    is_latched: Bool,
    active_count: Int
};

pub fn alarm_thresholds_new(ll: Float, l: Float, h: Float, hh: Float, deadband: Float) -> AlarmThresholds {
    return AlarmThresholds {
        low_low_limit: ll,
        low_limit: l,
        high_limit: h,
        high_high_limit: hh,
        deadband: deadband
    };
}

pub fn process_alarm_new(tag_code: Int, thresholds: AlarmThresholds) -> ProcessAlarm {
    return ProcessAlarm {
        tag_code: tag_code,
        thresholds: thresholds,
        current_severity: 0,
        state_code: 0,
        is_active: false,
        is_latched: false,
        active_count: 0
    };
}

pub fn alarm_monitor_evaluate(alarm: ProcessAlarm, pv: Float) -> ProcessAlarm {
    let th: AlarmThresholds = alarm.thresholds;
    let db: Float = th.deadband;
    let mut new_sev: Int = 0;
    if pv >= th.high_high_limit {
        new_sev = 4;
    } else {
        if pv >= th.high_limit {
            new_sev = 2;
        } else {
            if pv <= th.low_low_limit {
                new_sev = 3;
            } else {
                if pv <= th.low_limit {
                    new_sev = 1;
                } else {
                    let cur: Int = alarm.current_severity;
                    if cur == 2 {
                        if pv > (th.high_limit - db) {
                            new_sev = 2;
                        }
                    } else {
                        if cur == 4 {
                            if pv > (th.high_high_limit - db) {
                                new_sev = 4;
                            }
                        } else {
                            if cur == 1 {
                                if pv < (th.low_limit + db) {
                                    new_sev = 1;
                                }
                            } else {
                                if cur == 3 {
                                    if pv < (th.low_low_limit + db) {
                                        new_sev = 3;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    let mut is_active: Bool = alarm.is_active;
    let mut state_code: Int = alarm.state_code;
    let mut active_count: Int = alarm.active_count;
    if new_sev > 0 {
        if is_active == false {
            is_active = true;
            state_code = 1;
            active_count = active_count + 1;
        }
    } else {
        if is_active {
            is_active = false;
            if state_code == 1 {
                state_code = 3;
            } else {
                state_code = 0;
            }
        }
    }
    return ProcessAlarm {
        tag_code: alarm.tag_code,
        thresholds: alarm.thresholds,
        current_severity: new_sev,
        state_code: state_code,
        is_active: is_active,
        is_latched: alarm.is_latched,
        active_count: active_count
    };
}

pub fn alarm_acknowledge(alarm: ProcessAlarm) -> ProcessAlarm {
    let mut state_code: Int = alarm.state_code;
    if state_code == 1 {
        state_code = 2;
    } else {
        if state_code == 3 {
            state_code = 0;
        }
    }
    return ProcessAlarm {
        tag_code: alarm.tag_code,
        thresholds: alarm.thresholds,
        current_severity: alarm.current_severity,
        state_code: state_code,
        is_active: alarm.is_active,
        is_latched: alarm.is_latched,
        active_count: alarm.active_count
    };
}

pub fn alarm_shelve(alarm: ProcessAlarm) -> ProcessAlarm {
    return ProcessAlarm {
        tag_code: alarm.tag_code,
        thresholds: alarm.thresholds,
        current_severity: alarm.current_severity,
        state_code: 4,
        is_active: alarm.is_active,
        is_latched: alarm.is_latched,
        active_count: alarm.active_count
    };
}
