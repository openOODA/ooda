// # Industrial Signal Deadband Filtering
//
// Logline: Absolute deadband suppression and rate-of-change limiters.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type DeadbandFilter = struct {
    deadband_value: Float,
    last_reported_value: Float,
    is_initialized: Bool,
    total_samples: Int,
    passed_samples: Int
};

type RateOfChangeLimiter = struct {
    max_rate_per_sec: Float,
    last_value: Float,
    last_timestamp_sec: Float,
    is_initialized: Bool
};

pub fn deadband_filter_new(deadband: Float) -> DeadbandFilter {
    return DeadbandFilter {
        deadband_value: deadband,
        last_reported_value: 0.0,
        is_initialized: false,
        total_samples: 0,
        passed_samples: 0
    };
}

fn deadband_abs(val: Float) -> Float {
    if val < 0.0 {
        return 0.0 - val;
    }
    return val;
}

pub fn deadband_filter_update(filter: DeadbandFilter, new_value: Float) -> DeadbandFilter {
    let total: Int = filter.total_samples + 1;
    if filter.is_initialized == false {
        return DeadbandFilter {
            deadband_value: filter.deadband_value,
            last_reported_value: new_value,
            is_initialized: true,
            total_samples: total,
            passed_samples: filter.passed_samples + 1
        };
    }
    let diff: Float = deadband_abs(new_value - filter.last_reported_value);
    if diff >= filter.deadband_value {
        return DeadbandFilter {
            deadband_value: filter.deadband_value,
            last_reported_value: new_value,
            is_initialized: true,
            total_samples: total,
            passed_samples: filter.passed_samples + 1
        };
    }
    return DeadbandFilter {
        deadband_value: filter.deadband_value,
        last_reported_value: filter.last_reported_value,
        is_initialized: true,
        total_samples: total,
        passed_samples: filter.passed_samples
    };
}

pub fn rate_limiter_new(max_rate: Float) -> RateOfChangeLimiter {
    return RateOfChangeLimiter {
        max_rate_per_sec: max_rate,
        last_value: 0.0,
        last_timestamp_sec: 0.0,
        is_initialized: false
    };
}

pub fn rate_limiter_update(limiter: RateOfChangeLimiter, target_value: Float, timestamp_sec: Float) -> RateOfChangeLimiter {
    if limiter.is_initialized == false {
        return RateOfChangeLimiter {
            max_rate_per_sec: limiter.max_rate_per_sec,
            last_value: target_value,
            last_timestamp_sec: timestamp_sec,
            is_initialized: true
        };
    }
    let dt: Float = timestamp_sec - limiter.last_timestamp_sec;
    if dt <= 0.0 {
        return limiter;
    }
    let max_delta: Float = limiter.max_rate_per_sec * dt;
    let actual_delta: Float = target_value - limiter.last_value;
    let mut output: Float = target_value;
    if actual_delta > max_delta {
        output = limiter.last_value + max_delta;
    } else {
        if actual_delta < (0.0 - max_delta) {
            output = limiter.last_value - max_delta;
        }
    }
    return RateOfChangeLimiter {
        max_rate_per_sec: limiter.max_rate_per_sec,
        last_value: output,
        last_timestamp_sec: timestamp_sec,
        is_initialized: true
    };
}
