// # Industrial IoT & Automation Unified Facade
//
// Logline: Re-exports Modbus, MQTT, OPC UA, CoAP, BACnet, CANopen, Sensor Telemetry, PID, Alarms, and PLC State Machine primitives.
//
// Setup: Pure module shim and facade importing all 24 companion Industrial Automation and IoT submodules.
//
// Beats:
//   1. Import 24 modular Industrial Automation & IoT protocol components.
//   2. Re-export public constructors, serializers, filters, and capability-gated interfaces.
//   3. Maintain complete compatibility with downstream openOODA industrial callers.

import "./modbus_rtu_frame.oo";
import "./modbus_tcp_header.oo";
import "./modbus_client.oo";
import "./modbus_server.oo";
import "./mqtt_packet.oo";
import "./mqtt_client.oo";
import "./mqtt_topic_match.oo";
import "./opcua_binary_header.oo";
import "./opcua_node_id.oo";
import "./opcua_encoder.oo";
import "./opcua_decoder.oo";
import "./coap_header.oo";
import "./coap_options.oo";
import "./coap_client.oo";
import "./bacnet_bvlc.oo";
import "./canopen_sdo.oo";
import "./canopen_pdo.oo";
import "./sensor_telemetry_frame.oo";
import "./sensor_calibration.oo";
import "./deadband_filter.oo";
import "./pid_controller_industrial.oo";
import "./alarm_threshold_monitor.oo";
import "./plc_state_machine.oo";
import "./iot_stubs.oo";

pub fn iiot_shim_modbus_rtu_frame(slave: Int, fc: Int, data: List[Int]) -> ModbusRtuFrame {
    return modbus_rtu_frame_new(slave, fc, data);
}

pub fn iiot_shim_modbus_tcp_adu(tx_id: Int, uid: Int, fc: Int, pdu: List[Int]) -> ModbusTcpAdu {
    return modbus_tcp_adu_new(tx_id, uid, fc, pdu);
}

pub fn iiot_shim_modbus_client(host: String, port: Int, uid: Int) -> ModbusClient {
    return modbus_client_new(host, port, uid);
}

pub fn iiot_shim_modbus_server(uid: Int, size: Int) -> ModbusServer {
    return modbus_server_new(uid, size);
}

pub fn iiot_shim_mqtt_client(cid: String, host: String, port: Int) -> MqttClientSession {
    return mqtt_client_new(cid, host, port);
}

pub fn iiot_shim_mqtt_topic_matches(filter: String, topic: String) -> Bool {
    return mqtt_topic_matches(filter, topic);
}

pub fn iiot_shim_opcua_header(mtype: String, ctype: String, size: Int, ch: Int) -> OpcUaMessageHeader {
    return opcua_header_new(mtype, ctype, size, ch);
}

pub fn iiot_shim_opcua_node_numeric(ns: Int, id: Int) -> OpcUaNodeId {
    return opcua_node_id_numeric(ns, id);
}

pub fn iiot_shim_opcua_node_string(ns: Int, name: String) -> OpcUaNodeId {
    return opcua_node_id_string(ns, name);
}

pub fn iiot_shim_coap_header(mtype: Int, c_class: Int, c_detail: Int, mid: Int, tok: List[Int]) -> CoapHeader {
    return coap_header_new(mtype, c_class, c_detail, mid, tok);
}

pub fn iiot_shim_coap_client(host: String, port: Int) -> CoapClientSession {
    return coap_client_new(host, port);
}

pub fn iiot_shim_bacnet_unicast(npdu: &List[Int]) -> List[Int] {
    return bacnet_bvlc_build_unicast_npdu(npdu);
}

pub fn iiot_shim_canopen_sdo_download(idx: Int, subidx: Int, val: Int, cnt: Int) -> List[Int] {
    return canopen_sdo_expedited_download_req(idx, subidx, val, cnt);
}

pub fn iiot_shim_canopen_pdo_config(base: Int, node: Int, ttype: Int, timer: Int) -> CanopenPdoConfig {
    return canopen_pdo_config_new(base, node, ttype, timer);
}

pub fn iiot_shim_sensor_telemetry(
    dev: Int, ts: Int, seq: Int, temp: Float,
    vib_r: Float, vib_p: Float, press: Float, curr: Float,
    volt: Float, flow: Float, rpm: Float, qual: Int
) -> SensorTelemetryFrame {
    return sensor_telemetry_new(dev, ts, seq, temp, vib_r, vib_p, press, curr, volt, flow, rpm, qual);
}

pub fn iiot_shim_linear_calibration(rz: Float, rs: Float, ez: Float, es: Float) -> LinearCalibration {
    return linear_calibration_new(rz, rs, ez, es);
}

pub fn iiot_shim_deadband_filter(db: Float) -> DeadbandFilter {
    return deadband_filter_new(db);
}

pub fn iiot_shim_pid_controller(kp: Float, ki: Float, kd: Float, omin: Float, omax: Float) -> IndustrialPid {
    return pid_controller_new(kp, ki, kd, omin, omax);
}

pub fn iiot_shim_process_alarm(tag: String, th: AlarmThresholds) -> ProcessAlarm {
    return process_alarm_new(tag, th);
}

pub fn iiot_shim_plc_state_machine() -> PlcStateMachine {
    return plc_state_machine_new();
}

pub fn iiot_shim_modbus_net_dispatch(
    net: &NetCap,
    client: &mut ModbusClient,
    fc: Int,
    pdu: List[Int]
) -> Result[ModbusTcpAdu, String] {
    return modbus_client_send_transaction(net, client, fc, pdu);
}

pub fn iiot_shim_mqtt_net_publish(
    net: &NetCap,
    client: &mut MqttClientSession,
    topic: String,
    payload: String,
    qos: Int,
    retain: Bool
) -> Result<List[Int], String> {
    return mqtt_client_publish(net, client, topic, payload, qos, retain);
}

pub fn iiot_shim_coap_net_get(
    net: &NetCap,
    client: &mut CoapClientSession,
    uri_path: String
) -> Result<List[Int], String> {
    return coap_client_get(net, client, uri_path);
}

pub fn iiot_shim_fail_closed_gpio(sys: &SysCap, pin: Int) -> Int {
    return iot_raw_gpio_write(sys, pin, true);
}
