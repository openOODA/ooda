// # Industrial Sensor Telemetry Framing
//
// Logline: Encapsulates high-density multi-channel industrial sensor measurements, timestamps, quality flags, and integrity verification.
//
// Setup: Pure telemetry frame representation for condition monitoring and predictive maintenance.
//
// Beats:
//   1. Model 8-channel process telemetry (temperature, vibration, pressure, current, voltage, flow, rpm).
//   2. Track ISO/IEC measurement quality flags (Good, Uncertain, Bad) and sequential frame indexes.
//   3. Compute frame validation checksums and serialize into compact comma-separated representations.

pub type SensorTelemetryFrame = struct {
    device_id: Int,
    timestamp_ms: Int,
    sequence_num: Int,
    temperature_c: Float,
    vibration_rms_g: Float,
    vibration_peak_g: Float,
    pressure_bar: Float,
    current_amps: Float,
    voltage_volts: Float,
    flow_rate_lpm: Float,
    rpm: Float,
    quality_code: Int, // 0=Bad, 1=Uncertain, 2=Good
    checksum: Int,
};

/// Calculate additive 16-bit frame verification checksum.
pub fn sensor_telemetry_checksum(
    dev: Int,
    ts: Int,
    seq: Int,
    quality: Int
) -> Int {
    let sum1: Int = (dev + ts + seq + quality) % 65535;
    return sum1;
}

/// Construct a new SensorTelemetryFrame with validated checksum.
pub fn sensor_telemetry_new(
    dev_id: Int,
    ts_ms: Int,
    seq: Int,
    temp: Float,
    vib_rms: Float,
    vib_peak: Float,
    press: Float,
    curr: Float,
    volt: Float,
    flow: Float,
    rpm: Float,
    quality: Int
) -> SensorTelemetryFrame {
    let chk: Int = sensor_telemetry_checksum(dev_id, ts_ms, seq, quality);
    return SensorTelemetryFrame {
        device_id: dev_id,
        timestamp_ms: ts_ms,
        sequence_num: seq,
        temperature_c: temp,
        vibration_rms_g: vib_rms,
        vibration_peak_g: vib_peak,
        pressure_bar: press,
        current_amps: curr,
        voltage_volts: volt,
        flow_rate_lpm: flow,
        rpm: rpm,
        quality_code: quality,
        checksum: chk,
    };
}

/// Verify integrity of a SensorTelemetryFrame.
pub fn sensor_telemetry_is_valid(frame: &SensorTelemetryFrame) -> Bool {
    let expected: Int = sensor_telemetry_checksum(
        (frame).device_id,
        (frame).timestamp_ms,
        (frame).sequence_num,
        (frame).quality_code
    );
    return (frame).checksum == expected;
}

/// Check if telemetry quality flag is Good (2).
pub fn sensor_telemetry_is_good(frame: &SensorTelemetryFrame) -> Bool {
    return (frame).quality_code == 2;
}
