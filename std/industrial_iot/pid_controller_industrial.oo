// # Advanced Industrial PID Controller
//
// Logline: ISA PID with derivative-on-measurement, anti-windup, bumpless transfer.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type IndustrialPid = struct {
    kp: Float,
    ki: Float,
    kd: Float,
    setpoint: Float,
    out_min: Float,
    out_max: Float,
    integral_sum: Float,
    last_pv: Float,
    last_derivative: Float,
    derivative_filter_alpha: Float,
    is_auto: Bool,
    manual_output: Float
};

pub fn pid_controller_new(kp: Float, ki: Float, kd: Float, out_min: Float, out_max: Float) -> IndustrialPid {
    return IndustrialPid {
        kp: kp,
        ki: ki,
        kd: kd,
        setpoint: 0.0,
        out_min: out_min,
        out_max: out_max,
        integral_sum: 0.0,
        last_pv: 0.0,
        last_derivative: 0.0,
        derivative_filter_alpha: 0.1,
        is_auto: true,
        manual_output: 0.0
    };
}

pub fn pid_set_setpoint(pid: IndustrialPid, sp: Float) -> IndustrialPid {
    return IndustrialPid {
        kp: pid.kp,
        ki: pid.ki,
        kd: pid.kd,
        setpoint: sp,
        out_min: pid.out_min,
        out_max: pid.out_max,
        integral_sum: pid.integral_sum,
        last_pv: pid.last_pv,
        last_derivative: pid.last_derivative,
        derivative_filter_alpha: pid.derivative_filter_alpha,
        is_auto: pid.is_auto,
        manual_output: pid.manual_output
    };
}

pub fn pid_controller_step(pid: IndustrialPid, pv: Float, dt_sec: Float, feedforward: Float) -> IndustrialPid {
    if pid.is_auto == false {
        return IndustrialPid {
            kp: pid.kp,
            ki: pid.ki,
            kd: pid.kd,
            setpoint: pid.setpoint,
            out_min: pid.out_min,
            out_max: pid.out_max,
            integral_sum: pid.manual_output,
            last_pv: pv,
            last_derivative: pid.last_derivative,
            derivative_filter_alpha: pid.derivative_filter_alpha,
            is_auto: false,
            manual_output: pid.manual_output
        };
    }
    if dt_sec <= 0.0 {
        return pid;
    }

    let error: Float = pid.setpoint - pv;
    let p_term: Float = pid.kp * error;
    let dpv: Float = (pv - pid.last_pv) / dt_sec;
    let filtered_dpv: Float = (pid.derivative_filter_alpha * dpv) + ((1.0 - pid.derivative_filter_alpha) * pid.last_derivative);
    let d_term: Float = 0.0 - (pid.kd * filtered_dpv);
    let raw_out_no_i: Float = p_term + d_term + pid.integral_sum + feedforward;
    let mut i_term: Float = pid.integral_sum;
    let i_delta: Float = pid.ki * error * dt_sec;
    let test_out: Float = raw_out_no_i + i_delta;
    if test_out >= pid.out_min {
        if test_out <= pid.out_max {
            i_term = i_term + i_delta;
        } else {
            if test_out > pid.out_max {
                if error < 0.0 {
                    i_term = i_term + i_delta;
                }
            }
        }
    } else {
        if test_out < pid.out_min {
            if error > 0.0 {
                i_term = i_term + i_delta;
            }
        }
    }

    let mut total_output: Float = p_term + i_term + d_term + feedforward;
    if total_output > pid.out_max {
        total_output = pid.out_max;
    }
    if total_output < pid.out_min {
        total_output = pid.out_min;
    }
    return IndustrialPid {
        kp: pid.kp,
        ki: pid.ki,
        kd: pid.kd,
        setpoint: pid.setpoint,
        out_min: pid.out_min,
        out_max: pid.out_max,
        integral_sum: i_term,
        last_pv: pv,
        last_derivative: filtered_dpv,
        derivative_filter_alpha: pid.derivative_filter_alpha,
        is_auto: true,
        manual_output: total_output
    };
}

pub fn pid_set_manual(pid: IndustrialPid, manual_out: Float) -> IndustrialPid {
    return IndustrialPid {
        kp: pid.kp,
        ki: pid.ki,
        kd: pid.kd,
        setpoint: pid.setpoint,
        out_min: pid.out_min,
        out_max: pid.out_max,
        integral_sum: pid.integral_sum,
        last_pv: pid.last_pv,
        last_derivative: pid.last_derivative,
        derivative_filter_alpha: pid.derivative_filter_alpha,
        is_auto: false,
        manual_output: manual_out
    };
}

pub fn pid_set_auto(pid: IndustrialPid) -> IndustrialPid {
    return IndustrialPid {
        kp: pid.kp,
        ki: pid.ki,
        kd: pid.kd,
        setpoint: pid.setpoint,
        out_min: pid.out_min,
        out_max: pid.out_max,
        integral_sum: pid.integral_sum,
        last_pv: pid.last_pv,
        last_derivative: pid.last_derivative,
        derivative_filter_alpha: pid.derivative_filter_alpha,
        is_auto: true,
        manual_output: pid.manual_output
    };
}

pub fn pid_output_milli(pid: IndustrialPid) -> Int {
    let mut acc: Int = 0;
    let mut rem: Float = pid.manual_output;
    if rem < 0.0 {
        rem = 0.0 - rem;
    }
    while rem >= 1.0 {
        acc = acc + 1000;
        rem = rem - 1.0;
    }
    while rem >= 0.001 {
        acc = acc + 1;
        rem = rem - 0.001;
    }
    if pid.manual_output < 0.0 {
        return 0 - acc;
    }
    return acc;
}
