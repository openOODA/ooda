// # OPC UA Binary Data Stream Decoder
//
// Logline: Implements OPC UA binary stream deserialization with offset tracking and bounds verification.
//
// Setup: Pure little-endian byte decoder for reading industrial OPC UA binary structures.
//
// Beats:
//   1. Decode primitive Boolean, Byte, Int16, and Int32 scalar values.
//   2. Parse length-prefixed strings and 32-bit OPC UA StatusCode values.
//   3. Maintain cursor position and validate buffer boundaries against overruns.

pub type OpcUaDecoder = struct {
    buffer: List[Int],
    offset: Int,
    size: Int
};

/// Initialize a new OPC UA binary decoder instance.
pub fn opcua_decoder_new(bytes: List[Int]) -> OpcUaDecoder {
    let sz: Int = list_len(bytes);
    return OpcUaDecoder {
        buffer: bytes,
        offset: 0,
        size: sz
    };
}

/// Decode 1-byte Boolean value.
pub fn opcua_decode_bool(dec: &mut OpcUaDecoder) -> Result[Bool, String] {
    if (dec).offset >= (dec).size {
        return Err("Unexpected EOF while decoding Boolean");
    }
    let b: Int = list_get((dec).buffer, (dec).offset);
    (dec).offset = (dec).offset + 1;
    return Ok(b != 0);
}

/// Decode 1-byte unsigned byte.
pub fn opcua_decode_byte(dec: &mut OpcUaDecoder) -> Result[Int, String] {
    if (dec).offset >= (dec).size {
        return Err("Unexpected EOF while decoding Byte");
    }
    let b: Int = list_get((dec).buffer, (dec).offset);
    (dec).offset = (dec).offset + 1;
    return Ok(b);
}

/// Decode 16-bit integer (little-endian).
pub fn opcua_decode_int16(dec: &mut OpcUaDecoder) -> Result[Int, String] {
    if ((dec).offset + 2) > (dec).size {
        return Err("Unexpected EOF while decoding Int16");
    }
    let b0: Int = list_get((dec).buffer, (dec).offset);
    let b1: Int = list_get((dec).buffer, (dec).offset + 1);
    (dec).offset = (dec).offset + 2;
    return Ok(b0 + (b1 * 256));
}

/// Decode 32-bit integer (little-endian).
pub fn opcua_decode_int32(dec: &mut OpcUaDecoder) -> Result[Int, String] {
    if ((dec).offset + 4) > (dec).size {
        return Err("Unexpected EOF while decoding Int32");
    }
    let b0: Int = list_get((dec).buffer, (dec).offset);
    let b1: Int = list_get((dec).buffer, (dec).offset + 1);
    let b2: Int = list_get((dec).buffer, (dec).offset + 2);
    let b3: Int = list_get((dec).buffer, (dec).offset + 3);
    (dec).offset = (dec).offset + 4;
    return Ok(b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216));
}

/// Decode OPC UA length-prefixed String (Int32 length + UTF-8 payload).
pub fn opcua_decode_string(dec: &mut OpcUaDecoder) -> Result[String, String] {
    let len_res: Result[Int, String] = opcua_decode_int32(dec);
    if !len_res.is_ok() {
        return Err(len_res.unwrap_err());
    }

    let slen: Int = len_res.unwrap();
    if slen == -1 {
        return Ok(""); // Null string
    }
    if slen < 0 {
        return Err("Negative string length in OPC UA stream");
    }
    if ((dec).offset + slen) > (dec).size {
        return Err("Unexpected EOF while reading string content");
    }

    let mut buf: List[Int] = bytes_new();
    let mut i: Int = 0;
    while i < slen {
        buf = bytes_push(buf, list_get((dec).buffer, (dec).offset + i));
        i = i + 1;
    }
    (dec).offset = (dec).offset + slen;
    return Ok(bytes_to_str(buf));
}

/// Decode OPC UA StatusCode (32-bit UInt32).
pub fn opcua_decode_status_code(dec: &mut OpcUaDecoder) -> Result[Int, String] {
    return opcua_decode_int32(dec);
}

/// Check if StatusCode represents Good (top 2 bits == 0).
pub fn opcua_status_is_good(code: Int) -> Bool {
    return (code / 1073741824) == 0;
}
