// # MQTT Topic Filter Matching Engine
//
// Logline: Implements MQTT standard topic matching with single-level (+) and multi-level (#) wildcards.
//
// Setup: Pure algorithmic parser matching published MQTT topics against subscription filter hierarchies.
//
// Beats:
//   1. Split hierarchical topic strings into slash-separated levels.
//   2. Validate topic filter syntax according to MQTT 3.1.1 section 4.7 specifications.
//   3. Match topic filter patterns with system topic ($) isolation and multi-level expansions.

/// Split a forward-slash delimited string into individual level tokens.
pub fn mqtt_topic_split(topic: String) -> List[String] {
    let mut levels: List[String] = list_new();
    let len: Int = topic.len();
    let mut cur: String = "";
    let mut i: Int = 0;

    while i < len {
        let ch: Int = byte_at(topic, i);
        if ch == 47 { // '/'
            levels = list_push(levels, cur);
            cur = "";
        } else {
            let mut buf: List[Int] = bytes_new();
            buf = bytes_push(buf, ch);
            cur = cur + bytes_to_str(buf);
        }
        i = i + 1;
    }
    levels = list_push(levels, cur);
    return levels;
}

/// Validate that topic publish name contains no wildcards (+, #).
pub fn mqtt_topic_is_valid_name(topic: String) -> Bool {
    let len: Int = topic.len();
    if len == 0 {
        return false;
    }
    let mut i: Int = 0;
    while i < len {
        let ch: Int = byte_at(topic, i);
        if ch == 43 || ch == 35 { // '+' or '#'
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Validate that a subscription topic filter follows MQTT syntax rules.
pub fn mqtt_topic_is_valid_filter(filter: String) -> Bool {
    let len: Int = filter.len();
    if len == 0 {
        return false;
    }
    let levels: List[String] = mqtt_topic_split(filter);
    let n_levels: Int = list_len(levels);

    let mut i: Int = 0;
    while i < n_levels {
        let seg: String = list_get(levels, i);
        let seg_len: Int = seg.len();

        if seg == "#" {
            // '#' must be the very last level
            if i != (n_levels - 1) {
                return false;
            }
        } else if seg == "+" {
            // '+' alone as a level is valid
        } else {
            // Cannot have '+' or '#' embedded within a token
            let mut j: Int = 0;
            while j < seg_len {
                let c: Int = byte_at(seg, j);
                if c == 43 || c == 35 {
                    return false;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return true;
}

/// Evaluate whether a published topic matches a subscription topic filter.
pub fn mqtt_topic_matches(filter: String, topic: String) -> Bool {
    if !mqtt_topic_is_valid_filter(filter) || !mqtt_topic_is_valid_name(topic) {
        return false;
    }

    // System topics starting with '$' cannot match wildcard filters starting with '+' or '#'
    let t_len: Int = topic.len();
    let f_len: Int = filter.len();
    if t_len > 0 && byte_at(topic, 0) == 36 { // '$'
        if f_len > 0 && (byte_at(filter, 0) == 43 || byte_at(filter, 0) == 35) {
            return false;
        }
    }

    let f_segs: List[String] = mqtt_topic_split(filter);
    let t_segs: List[String] = mqtt_topic_split(topic);

    let f_count: Int = list_len(f_segs);
    let t_count: Int = list_len(t_segs);

    let mut fi: Int = 0;
    let mut ti: Int = 0;

    while fi < f_count && ti < t_count {
        let f_item: String = list_get(f_segs, fi);
        let t_item: String = list_get(t_segs, ti);

        if f_item == "#" {
            return true;
        } else if f_item == "+" || f_item == t_item {
            fi = fi + 1;
            ti = ti + 1;
        } else {
            return false;
        }
    }

    if fi < f_count && list_get(f_segs, fi) == "#" {
        return true;
    }

    return fi == f_count && ti == t_count;
}
