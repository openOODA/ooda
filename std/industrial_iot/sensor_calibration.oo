// # Industrial Sensor Signal Calibration & Compensation
//
// Logline: Implements multi-point linear scaling, second-order polynomial calibration, and thermal drift compensation.
//
// Setup: Pure numerical calibration routines converting raw ADC counts into calibrated engineering units.
//
// Beats:
//   1. Apply 2-point linear zero/span scaling across arbitrary sensor ranges.
//   2. Compute second-order polynomial non-linear sensor curve corrections.
//   3. Apply temperature drift compensation using material thermal sensitivity coefficients.

pub type LinearCalibration = struct {
    raw_zero: Float,
    raw_span: Float,
    eng_zero: Float,
    eng_span: Float
};

pub type PolynomialCalibration = struct {
    c0: Float, // Offset
    c1: Float, // Linear coefficient
    c2: Float // Quadratic coefficient
};

pub type ThermalCompensation = struct {
    ref_temp_c: Float,
    alpha_temp_coef: Float // e.g. 0.00385 for Pt100 RTD
};

/// Construct standard 2-point linear calibration parameters.
pub fn linear_calibration_new(
    raw_zero: Float,
    raw_span: Float,
    eng_zero: Float,
    eng_span: Float
) -> LinearCalibration {
    return LinearCalibration {
        raw_zero: raw_zero,
        raw_span: raw_span,
        eng_zero: eng_zero,
        eng_span: eng_span
    };
}

/// Convert raw input counts to calibrated engineering units.
pub fn linear_calibration_apply(cal: &LinearCalibration, raw_val: Float) -> Float {
    let raw_range: Float = (cal).raw_span - (cal).raw_zero;
    if raw_range == 0.0 {
        return (cal).eng_zero;
    }
    let eng_range: Float = (cal).eng_span - (cal).eng_zero;
    let fraction: Float = (raw_val - (cal).raw_zero) / raw_range;
    return (cal).eng_zero + (fraction * eng_range);
}

/// Apply second-order polynomial calibration curve: y = c0 + c1*x + c2*x^2.
pub fn polynomial_calibration_apply(poly: &PolynomialCalibration, raw_val: Float) -> Float {
    let term0: Float = (poly).c0;
    let term1: Float = (poly).c1 * raw_val;
    let term2: Float = (poly).c2 * raw_val * raw_val;
    return term0 + term1 + term2;
}

/// Apply thermal drift compensation to calibrated measurement: y_comp = y / (1 + alpha*(T - T_ref)).
pub fn thermal_compensation_apply(
    comp: &ThermalCompensation,
    uncompensated_val: Float,
    current_temp_c: Float
) -> Float {
    let dt: Float = current_temp_c - (comp).ref_temp_c;
    let factor: Float = 1.0 + ((comp).alpha_temp_coef * dt);
    if factor == 0.0 {
        return uncompensated_val;
    }
    return uncompensated_val / factor;
}
