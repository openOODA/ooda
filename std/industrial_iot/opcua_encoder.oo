// # OPC UA Binary Data Stream Encoder
//
// Logline: OPC UA Part 6 little-endian binary encoder for primitives.
// residual: &mut destubbed to by-value.

type OpcUaEncoder = struct {
    buffer: List[Int],
    bytes_written: Int
};

pub fn opcua_encoder_new() -> OpcUaEncoder {
    return OpcUaEncoder {
        buffer: list_new(),
        bytes_written: 0
    };
}

pub fn opcua_encode_bool(enc: OpcUaEncoder, val: Bool) -> OpcUaEncoder {
    let mut b: Int = 0;
    if val {
        b = 1;
    }
    return OpcUaEncoder {
        buffer: list_push(enc.buffer, b),
        bytes_written: enc.bytes_written + 1
    };
}

pub fn opcua_encode_byte(enc: OpcUaEncoder, val: Int) -> OpcUaEncoder {
    return OpcUaEncoder {
        buffer: list_push(enc.buffer, val % 256),
        bytes_written: enc.bytes_written + 1
    };
}

pub fn opcua_encode_int16(enc: OpcUaEncoder, val: Int) -> OpcUaEncoder {
    let b0: Int = val % 256;
    let b1: Int = (val / 256) % 256;
    let buf1: List[Int] = list_push(enc.buffer, b0);
    return OpcUaEncoder {
        buffer: list_push(buf1, b1),
        bytes_written: enc.bytes_written + 2
    };
}

pub fn opcua_encode_int32(enc: OpcUaEncoder, val: Int) -> OpcUaEncoder {
    let b0: Int = val % 256;
    let b1: Int = (val / 256) % 256;
    let b2: Int = (val / 65536) % 256;
    let b3: Int = (val / 16777216) % 256;
    let buf1: List[Int] = list_push(enc.buffer, b0);
    let buf2: List[Int] = list_push(buf1, b1);
    let buf3: List[Int] = list_push(buf2, b2);
    return OpcUaEncoder {
        buffer: list_push(buf3, b3),
        bytes_written: enc.bytes_written + 4
    };
}

pub fn opcua_encode_int64(enc: OpcUaEncoder, low: Int, high: Int) -> OpcUaEncoder {
    let mid: OpcUaEncoder = opcua_encode_int32(enc, low);
    return opcua_encode_int32(mid, high);
}

pub fn opcua_encode_status_code(enc: OpcUaEncoder, code: Int) -> OpcUaEncoder {
    return opcua_encode_int32(enc, code);
}

pub fn opcua_encoder_byte_at(enc: OpcUaEncoder, idx: Int) -> Int {
    return list_get(enc.buffer, idx);
}

pub fn opcua_encoder_len(enc: OpcUaEncoder) -> Int {
    return enc.bytes_written;
}
