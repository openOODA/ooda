// # QUIC Stream Multiplexing & Buffer Controller
//
// Logline: Coordinates bidirectional request and unidirectional control/QPACK streams over QUIC.
//
// Setup: Pure stream state machine managing byte buffers, FIN flags, and stream lifecycle.
//
// Beats:
//   1. Represent stream identity, directionality, and transmission buffers.
//   2. Append data chunks and manage receive offsets.
//   3. Handle graceful stream termination with FIN flag signaling.
//   4. Coordinate concurrent stream lookups across active connection sessions.

pub type QuicStream = struct {
    stream_id: Int,
    is_unidirectional: Bool,
    is_client_initiated: Bool,
    rx_buffer: List[Int],
    tx_buffer: List[Int],
    is_fin_received: Bool,
    is_closed: Bool
};

/// Initialize a new QUIC stream.
pub fn quic_stream_new(stream_id: Int, is_unidirectional: Bool, is_client: Bool) -> QuicStream {
    let empty_rx: List[Int] = list_new();
    let empty_tx: List[Int] = list_new();
    return QuicStream {
        stream_id: stream_id,
        is_unidirectional: is_unidirectional,
        is_client_initiated: is_client,
        rx_buffer: empty_rx,
        tx_buffer: empty_tx,
        is_fin_received: false,
        is_closed: false
    };
}

/// Append received byte chunk to stream RX buffer and return updated stream.
pub fn quic_stream_append_rx(qs: QuicStream, data: List[Int], fin: Bool) -> QuicStream {
    if (qs).is_closed {
        return qs;
    }
    let mut cur_rx: List[Int] = (qs).rx_buffer;
    let n: Int = list_len(data);
    let mut i: Int = 0;
    while i < n {
        cur_rx = list_push(cur_rx, list_get(data, i));
        i = i + 1;
    }
    let fin_flag: Bool = if fin { true } else { (qs).is_fin_received };
    return QuicStream {
        stream_id: (qs).stream_id,
        is_unidirectional: (qs).is_unidirectional,
        is_client_initiated: (qs).is_client_initiated,
        rx_buffer: cur_rx,
        tx_buffer: (qs).tx_buffer,
        is_fin_received: fin_flag,
        is_closed: (qs).is_closed
    };
}

/// Close stream and return updated closed stream.
pub fn quic_stream_close(qs: QuicStream) -> QuicStream { return QuicStream {
        stream_id: (qs).stream_id,
        is_unidirectional: (qs).is_unidirectional,
        is_client_initiated: (qs).is_client_initiated,
        rx_buffer: (qs).rx_buffer,
        tx_buffer: (qs).tx_buffer,
        is_fin_received: (qs).is_fin_received,
        is_closed: true
    }; }
