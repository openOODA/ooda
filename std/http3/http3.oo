// # Sovereign HTTP/3 & QUIC Protocol Engine Master Façade
//
// Logline: Unified standard library package providing RFC 9114 HTTP/3 framing, RFC 9000 varints, and QUIC flow control.
//
// Setup: Pure network protocol package re-exporting varint codecs, frame parsers, and stream controllers.
//
// Beats:
//   1. Re-export RFC 9000 variable-length integer encoders and decoders.
//   2. Re-export RFC 9114 HTTP/3 frame types and payload serialization.
//   3. Re-export QUIC credit flow controllers and stream multiplexers.

import "./varint.oo";
import "./frame.oo";
import "./flow.oo";
import "./stream.oo";

pub type Http3Connection = struct {
    is_client: Bool,
    flow: QuicFlowController,
    next_stream_id: Int,
    is_closed: Bool
};

/// Initialize a new HTTP/3 connection.
pub fn http3_conn_new(is_client: Bool, initial_window: Int) -> Result[Http3Connection, String] {
    if initial_window <= 0 {
        return Err("ERR\thttp3_conn_new: initial_window must be positive");
    }
    let fl: QuicFlowController = quic_flow_new(initial_window, initial_window / 2);
    let start_stream: Int = 0;
    if !is_client {
        start_stream = 1;
    }
    return Ok(Http3Connection {
        is_client: is_client,
        flow: fl,
        next_stream_id: start_stream,
        is_closed: false
    });
}
