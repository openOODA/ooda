// # QUIC Flow Control & Credit Allocation Engine
//
// Logline: Tracks connection and stream level credit windows to prevent buffer overruns in QUIC and HTTP/3.
//
// Setup: Pure flow controller maintaining credit balances with fail-closed overflow detection.
//
// Beats:
//   1. Track maximum permitted bytes, sent bytes, and received bytes.
//   2. Consume flow control credits upon data transmission with limit enforcement.
//   3. Grant additional credit windows upon buffer drain acknowledgment.
//   4. Detect blocked state when available credit drops to zero.

pub type QuicFlowController = struct {
    max_data: Int,
    data_sent: Int,
    data_received: Int,
    max_stream_data: Int,
    window_size: Int
};

/// Initialize a new QUIC flow controller with initial window sizes.
pub fn quic_flow_new(initial_max_data: Int, initial_stream_data: Int) -> QuicFlowController { return QuicFlowController {
        max_data: initial_max_data,
        data_sent: 0,
        data_received: 0,
        max_stream_data: initial_stream_data,
        window_size: initial_max_data
    }; }

/// Consume flow control credit for outgoing data bytes and return updated controller.
pub fn quic_flow_consume(flow: QuicFlowController, bytes: Int) -> Result[QuicFlowController, String] {
    if bytes < 0 {
        return Err("ERR\tquic_flow: negative byte count");
    }
    let available: Int = (flow).max_data - (flow).data_sent;
    if bytes > available {
        return Err("ERR\tquic_flow: flow control limit exceeded (DATA_BLOCKED)");
    }
    let next_sent: Int = (flow).data_sent + bytes;
    return Ok(QuicFlowController {
        max_data: (flow).max_data,
        data_sent: next_sent,
        data_received: (flow).data_received,
        max_stream_data: (flow).max_stream_data,
        window_size: (flow).window_size
    });
}

/// Grant additional credit to peer and return updated controller.
pub fn quic_flow_grant_window(flow: QuicFlowController, additional_credit: Int) -> Result[QuicFlowController, String] {
    if additional_credit < 0 {
        return Err("ERR\tquic_flow: negative credit grant");
    }
    let next_max: Int = (flow).max_data + additional_credit;
    return Ok(QuicFlowController {
        max_data: next_max,
        data_sent: (flow).data_sent,
        data_received: (flow).data_received,
        max_stream_data: (flow).max_stream_data,
        window_size: (flow).window_size
    });
}

/// Check if sender is currently blocked on flow control.
pub fn quic_flow_is_blocked(flow: &QuicFlowController) -> Bool { return (flow).data_sent >= (flow).max_data; }

/// Return available send window.
pub fn quic_flow_available(flow: &QuicFlowController) -> Int {
    let avail: Int = (flow).max_data - (flow).data_sent;
    if avail < 0 {
        return 0;
    }
    return avail;
}
