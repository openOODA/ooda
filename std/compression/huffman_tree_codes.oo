// # Huffman canonical codes and prefix-free proofs
//
// Logline: Assigns canonical codes from bit lengths and proves Kraft completeness plus the prefix-free invariant.
//
// Setup: Pure. Imports length helpers. Lengths are 0..31 per symbol.
//
// Beats:
//   1. Count symbols per bit length and emit canonical codes in symbol order.
//   2. Test Kraft equality for a complete prefix-free tree.
//   3. Scan every shorter code against longer codes and reject a prefix hit.

import "std/compression/huffman_tree_len.oo";

pub fn huffman_tree_codes(lens: List[Int]) -> List[Int] {
    let mut bl: List[Int] = huff_z(33);
    let mut i: Int = 0;
    while i < 256 {
        let l: Int = list_get(lens, i);
        if l > 0 {
            if l < 33 {
                bl = huff_set(bl, l, list_get(bl, l) + 1);
            }
        }
        i = i + 1;
    }
    let mut next: List[Int] = huff_z(33);
    let mut code: Int = 0;
    i = 1;
    while i < 33 {
        code = (code + list_get(bl, i - 1)) * 2;
        next = huff_set(next, i, code);
        i = i + 1;
    }
    let mut codes: List[Int] = huff_z(256);
    i = 0;
    while i < 256 {
        let l: Int = list_get(lens, i);
        if l > 0 {
            if l < 33 {
                codes = huff_set(codes, i, list_get(next, l));
                next = huff_set(next, l, list_get(next, l) + 1);
            }
        }
        i = i + 1;
    }
    return codes;
}

pub fn huffman_tree_kraft_ok(lens: List[Int]) -> Bool {
    let mut maxl: Int = 0;
    let mut i: Int = 0;
    let mut pos: Int = 0;
    while i < 256 {
        let l: Int = list_get(lens, i);
        if l > maxl {
            maxl = l;
        }
        if l > 0 {
            pos = pos + 1;
        }
        i = i + 1;
    }
    if pos == 0 {
        return true;
    }
    if maxl < 1 {
        return false;
    }
    if maxl > 31 {
        return false;
    }
    let mut need: Int = 1;
    let mut k: Int = 0;
    while k < maxl {
        need = need * 2;
        k = k + 1;
    }
    let mut sum: Int = 0;
    i = 0;
    while i < 256 {
        let l: Int = list_get(lens, i);
        if l > 0 {
            let mut p: Int = 1;
            k = 0;
            while k < (maxl - l) {
                p = p * 2;
                k = k + 1;
            }
            sum = sum + p;
        }
        i = i + 1;
    }
    if sum == need {
        return true;
    }
    return false;
}

pub fn huffman_tree_prefix_free(lens: List[Int]) -> Bool {
    let codes: List[Int] = huffman_tree_codes(lens);
    let mut i: Int = 0;
    while i < 256 {
        let li: Int = list_get(lens, i);
        if li > 0 {
            let ci: Int = list_get(codes, i);
            let mut j: Int = 0;
            while j < 256 {
                let lj: Int = list_get(lens, j);
                if lj > li {
                    let cj: Int = list_get(codes, j);
                    let mut sh: Int = 1;
                    let mut t: Int = 0;
                    while t < (lj - li) {
                        sh = sh * 2;
                        t = t + 1;
                    }
                    if (cj / sh) == ci {
                        return false;
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return true;
}
