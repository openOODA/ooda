// # Huffman lengths and canonical codes
//
// Logline: Counts byte frequencies, merges the two lightest nodes, and assigns canonical bit lengths and codes.
//
// Setup: Pure. Alphabet 0..255. Callers pass List[Int] bytes. No list_set.
//
// Beats:
//   1. Count frequencies and reject empty or hostile out-of-range bytes at encode time.
//   2. Merge the two lightest live nodes until one root remains.
//   3. Walk parents to bit lengths and complete a single-symbol tree with a dummy sibling.
//   4. Assign canonical codes and test Kraft completeness plus the prefix-free property.

pub fn huff_z(n: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        o = list_push(o, 0);
        i = i + 1;
    }
    return o;
}

pub fn huff_set(xs: List[Int], idx: Int, v: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let n: Int = list_len(xs);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            o = list_push(o, v);
        } else {
            o = list_push(o, list_get(xs, i));
        }
        i = i + 1;
    }
    return o;
}

pub fn huffman_tree_freq(src: List[Int]) -> List[Int] {
    let mut f: List[Int] = huff_z(256);
    let mut i: Int = 0;
    while i < list_len(src) {
        let b: Int = list_get(src, i) & 255;
        f = huff_set(f, b, list_get(f, b) + 1);
        i = i + 1;
    }
    return f;
}

fn huff_live(f: List[Int]) -> Int {
    let mut live: Int = 0;
    let mut i: Int = 0;
    while i < 256 {
        if list_get(f, i) > 0 {
            live = live + 1;
        }
        i = i + 1;
    }
    return live;
}

fn huff_pick2(w: List[Int], parent: List[Int], nxt: Int) -> List[Int] {
    let mut a: Int = 0 - 1;
    let mut b: Int = 0 - 1;
    let mut wa: Int = 1000000000;
    let mut wb: Int = 1000000000;
    let mut i: Int = 0;
    while i < nxt {
        if list_get(parent, i) < 0 {
            let wi: Int = list_get(w, i);
            if i < 256 {
                if wi < 1 {
                    i = i + 1;
                    continue;
                }
            }
            if wi < wa {
                wb = wa;
                b = a;
                wa = wi;
                a = i;
            } else {
                if wi < wb {
                    wb = wi;
                    b = i;
                }
            }
        }
        i = i + 1;
    }
    let mut rec: List[Int] = list_new();
    rec = list_push(rec, a);
    rec = list_push(rec, b);
    rec = list_push(rec, wa);
    rec = list_push(rec, wb);
    return rec;
}

pub fn huffman_tree_lengths(src: List[Int]) -> List[Int] {
    let f: List[Int] = huffman_tree_freq(src);
    let mut len: List[Int] = huff_z(256);
    let live: Int = huff_live(f);
    if live == 0 {
        return len;
    }
    if live == 1 {
        let mut i: Int = 0;
        let mut hit: Int = 0 - 1;
        while i < 256 {
            if list_get(f, i) > 0 {
                len = huff_set(len, i, 1);
                hit = i;
            }
            i = i + 1;
        }
        i = 0;
        while i < 256 {
            if i != hit {
                if list_get(len, i) == 0 {
                    len = huff_set(len, i, 1);
                    return len;
                }
            }
            i = i + 1;
        }
        return len;
    }
    return huff_merge_len(f, live, len);
}

fn huff_merge_len(f: List[Int], live: Int, len0: List[Int]) -> List[Int] {
    let mut w: List[Int] = huff_z(512);
    let mut parent: List[Int] = huff_z(512);
    let mut i: Int = 0;
    while i < 512 {
        parent = huff_set(parent, i, 0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < 256 {
        w = huff_set(w, i, list_get(f, i));
        i = i + 1;
    }
    let mut nxt: Int = 256;
    let mut used: Int = live;
    while used > 1 {
        let rec: List[Int] = huff_pick2(w, parent, nxt);
        let a: Int = list_get(rec, 0);
        let b: Int = list_get(rec, 1);
        if a < 0 {
            break;
        }
        if b < 0 {
            break;
        }
        parent = huff_set(parent, a, nxt);
        parent = huff_set(parent, b, nxt);
        w = huff_set(w, nxt, list_get(rec, 2) + list_get(rec, 3));
        nxt = nxt + 1;
        used = used - 1;
    }
    let mut len: List[Int] = len0;
    i = 0;
    while i < 256 {
        if list_get(f, i) > 0 {
            let mut l: Int = 0;
            let mut x: Int = i;
            while list_get(parent, x) >= 0 {
                x = list_get(parent, x);
                l = l + 1;
            }
            if l < 1 {
                l = 1;
            }
            len = huff_set(len, i, l);
        }
        i = i + 1;
    }
    return len;
}
