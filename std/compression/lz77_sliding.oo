// # LZ77 sliding window
//
// Logline: Compresses bytes to (offset, length, next) tuples in a sliding window and restores the source with a decompress state machine.
//
// Setup: Pure. Window 32 bytes. Match length at least 3.
//
// Beats:
//   1. Search the window for the longest match of the lookahead.
//   2. Emit offset, length, and the next unmatched byte.
//   3. Advance the window.
//   4. Decompress by copying from the output buffer.

pub fn lz77_sliding_compress(src: List[Int]) -> Result[List[Int], String] {
    let n: Int = list_len(src);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let win0: Int = i - 32;
        let mut wstart: Int = 0;
        if win0 > 0 { wstart = win0; }
        let mut best_off: Int = 0;
        let mut best_len: Int = 0;
        let mut p: Int = wstart;
        while p < i {
            let mut l: Int = 0;
            while i + l < n {
                if p + l >= i { break; }
                if list_get(src, p + l) != list_get(src, i + l) { break; }
                l = l + 1;
                if l >= 16 { break; }
            }
            if l >= 3 {
                if l > best_len {
                    best_len = l;
                    best_off = i - p;
                }
            }
            p = p + 1;
        }
        if best_len >= 3 {
            let endm: Int = i + best_len;
            if endm < n {
                out = list_push(out, best_off);
                out = list_push(out, best_len);
                out = list_push(out, list_get(src, endm) & 255);
                i = endm + 1;
            } else {
                if best_len > 3 {
                    out = list_push(out, best_off);
                    out = list_push(out, best_len - 1);
                    out = list_push(out, list_get(src, n - 1) & 255);
                    i = n;
                } else {
                    out = list_push(out, 0);
                    out = list_push(out, 0);
                    out = list_push(out, list_get(src, i) & 255);
                    i = i + 1;
                }
            }
        } else {
            out = list_push(out, 0);
            out = list_push(out, 0);
            out = list_push(out, list_get(src, i) & 255);
            i = i + 1;
        }
    }
    return Ok(out);
}

pub fn lz77_sliding_decompress(toks: List[Int]) -> Result[List[Int], String] {
    if list_len(toks) % 3 != 0 { return Err("lz77 tuple alignment"); }
    let mut out: List[Int] = list_new();
    let mut t: Int = 0;
    while t < list_len(toks) {
        let off: Int = list_get(toks, t);
        let ln: Int = list_get(toks, t + 1);
        let nx: Int = list_get(toks, t + 2);
        if ln > 0 {
            if off < 1 { return Err("lz77 offset"); }
            if off > list_len(out) { return Err("lz77 offset past window"); }
            let start: Int = list_len(out) - off;
            let mut k: Int = 0;
            while k < ln {
                out = list_push(out, list_get(out, start + k));
                k = k + 1;
            }
        }
        out = list_push(out, nx);
        t = t + 3;
    }
    return Ok(out);
}
