// # RFC 7932 Brotli prefix and window
//
// Logline: Reads a prefix-coded symbol and copies from a sliding window ring.
//
// Setup: Pure. Window capacity is a positive power-of-two-ish length. Offset 0 is Err.
//
// Beats:
//   1. Decode one prefix symbol from bit lengths.
//   2. Push a literal into the ring.
//   3. Copy a match from a nonzero offset.
//   4. Reject a truncated code or offset 0.

pub type BrOut = struct {
    flag: Int,
    err: String,
    sym: Int,
    n: Int,
    last: Int
};

fn br_err(m: String) -> BrOut {
    return BrOut { flag: 0, err: "ERR\tbrotli: " + m, sym: 0, n: 0, last: 0 };
}

pub fn brotli_stream_prefix(lens: List[Int], bits: List[Int]) -> BrOut {
    if list_len(lens) < 1 {
        return br_err("lens");
    }
    if list_len(bits) < 1 {
        return br_err("bits");
    }
    let mut code: Int = 0;
    let mut i: Int = 0;
    while i < list_len(lens) {
        let L: Int = list_get(lens, i);
        if L < 1 {
            return br_err("len");
        }
        if list_len(bits) < L {
            return br_err("short");
        }
        let mut v: Int = 0;
        let mut j: Int = 0;
        while j < L {
            v = v * 2 + (list_get(bits, j) & 1);
            j = j + 1;
        }
        if v == code {
            return BrOut { flag: 1, err: "", sym: i, n: L, last: 0 };
        }
        code = code + 1;
        i = i + 1;
    }
    return br_err("sym");
}

pub fn brotli_stream_window(ring: List[Int], lit: Int, off: Int, mlen: Int) -> BrOut {
    let mut r: List[Int] = ring;
    if lit >= 0 {
        r = list_push(r, lit & 255);
    }
    if mlen > 0 {
        if off < 1 {
            return br_err("offset");
        }
        let start: Int = list_len(r) - off;
        if start < 0 {
            return br_err("offset");
        }
        let mut m: Int = 0;
        while m < mlen {
            let src: Int = start + m;
            if src >= list_len(r) {
                return br_err("offset");
            }
            r = list_push(r, list_get(r, src));
            m = m + 1;
        }
    }
    let n: Int = list_len(r);
    if n < 1 {
        return br_err("empty");
    }
    return BrOut { flag: 1, err: "", sym: 0, n: n, last: list_get(r, n - 1) };
}

pub fn brotli_stream_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn brotli_stream_flag(o: BrOut) -> Int {
    return o.flag;
}
pub fn brotli_stream_err(o: BrOut) -> String {
    return o.err;
}
