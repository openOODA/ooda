// # Huffman codec
//
// Logline: Counts byte frequencies, builds Huffman lengths from a parent tree, and encodes then decodes a byte list.
//
// Setup: Pure. Alphabet 0..255. Empty input is Ok of empty.
//
// Beats:
//   1. Count frequencies of each byte.
//   2. Merge the two lightest nodes and record parents.
//   3. Assign canonical codes by increasing bit length.
//   4. Encode bits and decode them back to the source bytes.

fn huffman_tree_freq(src: List[Int]) -> List[Int] {
    let mut f: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        f = list_push(f, 0);
        i = i + 1;
    }
    i = 0;
    while i < list_len(src) {
        let b: Int = list_get(src, i) & 255;
        f = list_set(f, b, list_get(f, b) + 1);
        i = i + 1;
    }
    return f;
}

fn huffman_tree_z(n: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        o = list_push(o, 0);
        i = i + 1;
    }
    return o;
}

pub fn huffman_tree_lengths(src: List[Int]) -> List[Int] {
    let f: List[Int] = huffman_tree_freq(src);
    let mut len: List[Int] = huffman_tree_z(256);
    let mut live: Int = 0;
    let mut i: Int = 0;
    while i < 256 {
        if list_get(f, i) > 0 { live = live + 1; }
        i = i + 1;
    }
    if live == 0 { return len; }
    if live == 1 {
        i = 0;
        while i < 256 {
            if list_get(f, i) > 0 { len = list_set(len, i, 1); }
            i = i + 1;
        }
        return len;
    }
    let mut w: List[Int] = huffman_tree_z(512);
    let mut parent: List[Int] = huffman_tree_z(512);
    i = 0;
    while i < 512 {
        parent = list_set(parent, i, 0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < 256 {
        w = list_set(w, i, list_get(f, i));
        i = i + 1;
    }
    let mut nxt: Int = 256;
    let mut used: Int = live;
    while used > 1 {
        let mut a: Int = 0 - 1;
        let mut b: Int = 0 - 1;
        let mut wa: Int = 1000000000;
        let mut wb: Int = 1000000000;
        i = 0;
        while i < nxt {
            if list_get(parent, i) < 0 {
                let wi: Int = list_get(w, i);
                if i < 256 {
                    if wi < 1 {
                        i = i + 1;
                        continue;
                    }
                }
                if wi < wa {
                    wb = wa;
                    b = a;
                    wa = wi;
                    a = i;
                } else {
                    if wi < wb {
                        wb = wi;
                        b = i;
                    }
                }
            }
            i = i + 1;
        }
        if a < 0 { break; }
        if b < 0 { break; }
        parent = list_set(parent, a, nxt);
        parent = list_set(parent, b, nxt);
        w = list_set(w, nxt, wa + wb);
        nxt = nxt + 1;
        used = used - 1;
    }
    i = 0;
    while i < 256 {
        if list_get(f, i) > 0 {
            let mut l: Int = 0;
            let mut x: Int = i;
            while list_get(parent, x) >= 0 {
                x = list_get(parent, x);
                l = l + 1;
            }
            if l < 1 { l = 1; }
            len = list_set(len, i, l);
        }
        i = i + 1;
    }
    return len;
}

fn huffman_tree_codes(lens: List[Int]) -> List[Int] {
    let mut bl: List[Int] = huffman_tree_z(33);
    let mut i: Int = 0;
    while i < 256 {
        let l: Int = list_get(lens, i);
        if l > 0 {
            if l < 33 { bl = list_set(bl, l, list_get(bl, l) + 1); }
        }
        i = i + 1;
    }
    let mut next: List[Int] = huffman_tree_z(33);
    let mut code: Int = 0;
    i = 1;
    while i < 33 {
        code = (code + list_get(bl, i - 1)) * 2;
        next = list_set(next, i, code);
        i = i + 1;
    }
    let mut codes: List[Int] = huffman_tree_z(256);
    i = 0;
    while i < 256 {
        let l: Int = list_get(lens, i);
        if l > 0 {
            if l < 33 {
                codes = list_set(codes, i, list_get(next, l));
                next = list_set(next, l, list_get(next, l) + 1);
            }
        }
        i = i + 1;
    }
    return codes;
}

pub fn huffman_tree_encode(src: List[Int]) -> Result[List[Int], String] {
    let lens: List[Int] = huffman_tree_lengths(src);
    let codes: List[Int] = huffman_tree_codes(lens);
    let mut bits: List[Int] = list_new();
    let mut i: Int = 0;
    while i < list_len(src) {
        let s: Int = list_get(src, i) & 255;
        let l: Int = list_get(lens, s);
        if l < 1 { return Err("huffman missing code"); }
        let c: Int = list_get(codes, s);
        let mut k: Int = l - 1;
        while k >= 0 {
            bits = list_push(bits, (c >> k) & 1);
            k = k - 1;
        }
        i = i + 1;
    }
    let mut out: List[Int] = list_new();
    i = 0;
    while i < 256 {
        out = list_push(out, list_get(lens, i));
        i = i + 1;
    }
    out = list_push(out, list_len(src));
    i = 0;
    while i < list_len(bits) {
        out = list_push(out, list_get(bits, i));
        i = i + 1;
    }
    return Ok(out);
}

pub fn huffman_tree_decode(pack: List[Int]) -> Result[List[Int], String] {
    if list_len(pack) < 257 { return Err("huffman pack short"); }
    let mut lens: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        lens = list_push(lens, list_get(pack, i));
        i = i + 1;
    }
    let codes: List[Int] = huffman_tree_codes(lens);
    let n: Int = list_get(pack, 256);
    let mut pos: Int = 257;
    let mut out: List[Int] = list_new();
    i = 0;
    while i < n {
        let mut acc: Int = 0;
        let mut got: Int = 0;
        let mut found: Int = 0 - 1;
        while got < 32 {
            if pos >= list_len(pack) { return Err("huffman decode"); }
            acc = acc * 2 + list_get(pack, pos);
            pos = pos + 1;
            got = got + 1;
            let mut s: Int = 0;
            while s < 256 {
                if list_get(lens, s) == got {
                    if list_get(codes, s) == acc {
                        found = s;
                        s = 256;
                    }
                }
                s = s + 1;
            }
            if found >= 0 { break; }
        }
        if found < 0 { return Err("huffman decode"); }
        out = list_push(out, found);
        i = i + 1;
    }
    return Ok(out);
}
