// # H.264 Annex B NAL Unit Parser & RBSP Unescaper
//
// Logline: Scans Annex B start codes, decodes NAL headers, and removes 0x000003 emulation prevention bytes.
//
// Setup: Pure video bitstream parser operating with fail-closed bounds checking.
//
// Beats:
//   1. Scan byte streams to locate 3-byte (0x000001) and 4-byte (0x00000001) start codes.
//   2. Parse 1-byte NAL header extracting forbidden_zero_bit, nal_ref_idc, and nal_unit_type.
//   3. Strip 0x03 emulation prevention bytes to produce clean Raw Byte Sequence Payload (RBSP).
//   4. Partition full Annex B byte streams into discrete NAL unit sequences.

import "./h264_types.oo";

/// Find next Annex B start code index in byte stream.
pub fn h264_find_next_start_code(bytes: List[Int], start_idx: Int) -> Result[Int, String] {
    let n: Int = list_len(bytes);
    let mut i: Int = start_idx;
    while i < (n - 2) {
        let b0: Int = list_get(bytes, i);
        let b1: Int = list_get(bytes, i + 1);
        let b2: Int = list_get(bytes, i + 2);
        if b0 == 0 && b1 == 0 && b2 == 1 {
            return Ok(i);
        }
        if i < (n - 3) {
            let b3: Int = list_get(bytes, i + 3);
            if b0 == 0 && b1 == 0 && b2 == 0 && b3 == 1 {
                return Ok(i);
            }
        }
        i = i + 1;
    }
    return Err("ERR\th264_nal: no start code found");
}

/// Parse 1-byte NAL header.
pub fn h264_parse_nal_header(header_byte: Int) -> Result[H264NalUnit, String] {
    let forbidden: Int = (header_byte >> 7) & 1;
    if forbidden != 0 {
        return Err("ERR\th264_nal: forbidden_zero_bit is set");
    }
    let ref_idc: Int = (header_byte >> 5) & 3;
    let unit_type: Int = header_byte & 31;
    let empty_payload: List[Int] = list_new();
    return Ok(H264NalUnit {
        forbidden_zero_bit: 0,
        nal_ref_idc: ref_idc,
        nal_unit_type: unit_type,
        payload: empty_payload,
        offset: 0,
        length: 0
    });
}

/// Unescape 0x000003 emulation prevention bytes from payload to produce clean RBSP.
pub fn h264_unescape_rbsp(escaped_bytes: List[Int]) -> List[Int] {
    let n: Int = list_len(escaped_bytes);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if (i + 2) < n {
            let b0: Int = list_get(escaped_bytes, i);
            let b1: Int = list_get(escaped_bytes, i + 1);
            let b2: Int = list_get(escaped_bytes, i + 2);
            if b0 == 0 && b1 == 0 && b2 == 3 {
                out = list_push(out, 0);
                out = list_push(out, 0);
                i = i + 3;
                continue;
            }
        }
        out = list_push(out, list_get(escaped_bytes, i));
        i = i + 1;
    }
    return out;
}
