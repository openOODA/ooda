// # Quite OK Image (QOI) High-Level Codec Façade
//
// Logline: Unified QOI image encoding, decoding, and bit-exact round-trip identity verification.
//
// Setup: Pure image codec package re-exporting QoiImage encode and decode functions.
//
// Beats:
//   1. Encode QoiImage structures to raw compressed byte streams.
//   2. Decode raw compressed byte streams to QoiImage rasters.
//   3. Verify bit-exact round-trip encoding and decoding identity.

import "./qoi_types.oo";
import "./qoi_enc.oo";
import "./qoi_dec.oo";

pub fn qoi_image_encode(img: QoiImage) -> Result[List[Int], String] { return qoi_encode(img); }

pub fn qoi_image_decode(bytes: List[Int]) -> Result[QoiImage, String] { return qoi_decode(bytes); }
