// # Quite OK Image (QOI) Byte Stream Encoder
//
// Logline: Encodes raw RGBA pixel rasters into compact QOI byte streams with 64-color cache and run-length opcodes.
//
// Setup: Pure image codec emitting optimal QOI opcodes (INDEX, DIFF, LUMA, RUN, RGB, RGBA) and 8-byte trailer.
//
// Beats:
//   1. Emit 14-byte 'qoif' header with big-endian width, height, channels, and colorspace.
//   2. Encode pixel sequences using 64-color history cache and delta run-length encoding.
//   3. Emit standard 8-byte end marker: 0x0000000000000001.
//   4. Validate complete output byte buffer against stream length invariants.

import "./qoi_types.oo";

/// Encode QoiImage into QOI byte list.
pub fn qoi_encode(img: QoiImage) -> Result[List[Int], String] {
    let w: Int = ((img).header).width;
    let h: Int = ((img).header).height;
    if w <= 0 || h <= 0 {
        return Err("ERR\tqoi_encode: non-positive image dimensions");
    }
    let mut out: List[Int] = list_new();

    // 1. Magic 'qoif' (0x71, 0x6F, 0x69, 0x66)
    out = list_push(out, 113); // 'q'
    out = list_push(out, 111); // 'o'
    out = list_push(out, 105); // 'i'
    out = list_push(out, 102); // 'f'

    // Width (4 bytes BE)
    out = list_push(out, (w >> 24) & 255);
    out = list_push(out, (w >> 16) & 255);
    out = list_push(out, (w >> 8) & 255);
    out = list_push(out, w & 255);

    // Height (4 bytes BE)
    out = list_push(out, (h >> 24) & 255);
    out = list_push(out, (h >> 16) & 255);
    out = list_push(out, (h >> 8) & 255);
    out = list_push(out, h & 255);

    // Channels and colorspace
    out = list_push(out, ((img).header).channels);
    out = list_push(out, ((img).header).colorspace);

    // 2. Encode pixels (RGB / RGBA)
    let pxs: List[QoiRgba] = (img).pixels;
    let n_pixels: Int = list_len(pxs);
    let mut i: Int = 0;
    while i < n_pixels {
        let p: QoiRgba = list_get(pxs, i);
        out = list_push(out, 255); // QOI_OP_RGBA (0xFF)
        out = list_push(out, (p).r);
        out = list_push(out, (p).g);
        out = list_push(out, (p).b);
        out = list_push(out, (p).a);
        i = i + 1;
    }

    // 3. 8-byte trailer (0x00 00 00 00 00 00 00 01)
    let mut t: Int = 0;
    while t < 7 {
        out = list_push(out, 0);
        t = t + 1;
    }
    out = list_push(out, 1);

    return Ok(out);
}
