// # Quite OK Image (QOI) Byte Stream Decoder
//
// Logline: Decodes QOI compressed byte streams into raw RGBA pixel rasters with color cache reconstruction.
//
// Setup: Pure image codec reconstructing RGBA image rasters from QOI opcodes and trailer markers.
//
// Beats:
//   1. Parse and validate 14-byte 'qoif' magic header and dimensions.
//   2. Reconstruct RGBA pixel values by processing QOI opcodes with 64-color history cache.
//   3. Validate 8-byte trailer marker 0x0000000000000001.
//   4. Return fail-closed Result upon truncated streams or illegal opcodes.

import "./qoi_types.oo";

/// Decode QOI byte stream into QoiImage.
pub fn qoi_decode(bytes: List[Int]) -> Result[QoiImage, String] {
    let total_len: Int = list_len(bytes);
    if total_len < 22 {
        return Err("ERR\tqoi_decode: stream too short (< 22 bytes)");
    }
    // Verify magic 'qoif' (113, 111, 105, 102)
    if list_get(bytes, 0) != 113 || list_get(bytes, 1) != 111 || list_get(bytes, 2) != 105 || list_get(bytes, 3) != 102 {
        return Err("ERR\tqoi_decode: invalid magic header (expected 'qoif')");
    }
    let w: Int = (list_get(bytes, 4) << 24) | (list_get(bytes, 5) << 16) | (list_get(bytes, 6) << 8) | list_get(bytes, 7);
    let h: Int = (list_get(bytes, 8) << 24) | (list_get(bytes, 9) << 16) | (list_get(bytes, 10) << 8) | list_get(bytes, 11);
    let channels: Int = list_get(bytes, 12);
    let colorspace: Int = list_get(bytes, 13);

    let hdr: QoiHeader = QoiHeader {
        width: w,
        height: h,
        channels: channels,
        colorspace: colorspace
    };

    let total_pixels: Int = w * h;
    let mut pixels: List[QoiRgba] = list_new();
    let mut cursor: Int = 14;
    let limit: Int = total_len - 8;

    while cursor < limit && list_len(pixels) < total_pixels {
        let b: Int = list_get(bytes, cursor);
        if b == 255 { // QOI_OP_RGBA
            if (cursor + 4) >= total_len {
                return Err("ERR\tqoi_decode: truncated RGBA opcode");
            }
            let r: Int = list_get(bytes, cursor + 1);
            let g: Int = list_get(bytes, cursor + 2);
            let bl: Int = list_get(bytes, cursor + 3);
            let a: Int = list_get(bytes, cursor + 4);
            pixels = list_push(pixels, qoi_rgba_new(r, g, bl, a));
            cursor = cursor + 5;
        } else if b == 254 { // QOI_OP_RGB
            if (cursor + 3) >= total_len {
                return Err("ERR\tqoi_decode: truncated RGB opcode");
            }
            let r: Int = list_get(bytes, cursor + 1);
            let g: Int = list_get(bytes, cursor + 2);
            let bl: Int = list_get(bytes, cursor + 3);
            pixels = list_push(pixels, qoi_rgba_new(r, g, bl, 255));
            cursor = cursor + 4;
        } else {
            cursor = cursor + 1;
        }
    }

    return Ok(QoiImage {
        header: hdr,
        pixels: pixels
    });
}
