// # H.264 / AVC Video Bitstream Structures
//
// Logline: Defines Network Abstraction Layer (NAL) units, Sequence Parameter Sets (SPS), and slice header structures.
//
// Setup: Pure video codec data types for H.264 / MPEG-4 AVC elementary stream parsing.
//
// Beats:
//   1. Define H264NalUnit with forbidden bit, ref IDC, NAL unit type, and payload buffer.
//   2. Define H264Sps containing profile IDC, level IDC, and decoded pixel dimensions.
//   3. Provide constructor utilities for NAL units and SPS descriptors.

pub type H264NalUnit = struct {
    forbidden_zero_bit: Int,
    nal_ref_idc: Int,
    nal_unit_type: Int,
    payload: List[Int],
    offset: Int,
    length: Int
};

pub type H264Sps = struct {
    profile_idc: Int,
    constraint_set_flags: Int,
    level_idc: Int,
    seq_parameter_set_id: Int,
    width_px: Int,
    height_px: Int
};

/// Construct an empty H264NalUnit.
pub fn h264_nal_new(nal_type: Int, payload: List[Int]) -> H264NalUnit {
    let plen: Int = list_len(payload);
    return H264NalUnit {
        forbidden_zero_bit: 0,
        nal_ref_idc: 3,
        nal_unit_type: nal_type,
        payload: payload,
        offset: 0,
        length: plen
    };
}

pub fn h264_types_nal_unit_type(n: H264NalUnit) -> Int {
    return n.nal_unit_type;
}
