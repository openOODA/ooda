// # RIFF / WAVE PCM Audio Structures & Formats
//
// Logline: Defines RIFF WAVE audio container headers, sample tracks, and mixed audio buffers.
//
// Setup: Pure audio codec data structures with zero struct trailing commas.
//
// Beats:
//   1. Define WavHeader with channel count, sample rate, bits per sample, and data length.
//   2. Define AudioTrack holding sample buffers and gain multipliers.
//   3. Define MixedAudio for combined multi-track output buffers.

pub type WavHeader = struct {
    num_channels: Int,
    sample_rate: Int,
    bits_per_sample: Int,
    byte_rate: Int,
    block_align: Int,
    data_size: Int
};

pub type AudioTrack = struct {
    gain: Float,
    samples: List[Int]
};

pub type MixedAudio = struct {
    num_channels: Int,
    sample_rate: Int,
    samples: List[Int]
};
