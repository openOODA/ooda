// # Quite OK Image (QOI) Format Structures & Color Cache
//
// Logline: Defines QOI image containers, RGBA pixel structs, 14-byte headers, and 64-color hash indexing.
//
// Setup: Pure image codec data definitions with zero struct trailing commas.
//
// Beats:
//   1. Define QoiRgba representing 8-bit red, green, blue, alpha color channels.
//   2. Define QoiHeader for 14-byte file header (width, height, channels, colorspace).
//   3. Compute 64-entry color cache hash: (r*3 + g*5 + b*7 + a*11) % 64.
//   4. Define QoiImage holding header and complete pixel array.

pub type QoiRgba = struct {
    r: Int,
    g: Int,
    b: Int,
    a: Int
};

pub type QoiHeader = struct {
    width: Int,
    height: Int,
    channels: Int,
    colorspace: Int
};

pub type QoiImage = struct {
    header: QoiHeader,
    pixels: List[QoiRgba]
};

/// Calculate QOI 64-color cache hash index.
pub fn qoi_color_hash(r: Int, g: Int, b: Int, a: Int) -> Int { return (r * 3 + g * 5 + b * 7 + a * 11) % 64; }

/// Create a new QoiRgba pixel.
pub fn qoi_rgba_new(r: Int, g: Int, b: Int, a: Int) -> QoiRgba { return QoiRgba {
        r: r & 255,
        g: g & 255,
        b: b & 255,
        a: a & 255
    }; }
