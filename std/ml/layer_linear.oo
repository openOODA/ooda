// # Fully-Connected Linear Transformation Layer
//
// Logline: Implements dense affine layer transformation y = x * W + b with forward evaluation and parameter gradients.
//
// Setup: Pure neural network layer applying matrix weight transformations and bias offsets.
//
// Beats:
//   1. Define LinearLayer with weight matrix W, bias vector b, and gradient accumulators.
//   2. Initialize weights using Xavier/Glorot uniform initialization.
//   3. Compute forward affine pass y = x * W + b using 2D matrix multiplication.
//   4. Compute backward parameter gradients for backpropagation.

import "std/tensor/tensor.oo";

pub type LinearLayer = struct {
    in_features: Int,
    out_features: Int,
    weight: Tensor,
    bias: Tensor
};

/// Initialize a new LinearLayer.
pub fn linear_new(in_features: Int, out_features: Int) -> Result[LinearLayer, String] {
    if in_features <= 0 || out_features <= 0 {
        return Err("ERR\tlinear_new: dimensions must be positive");
    }
    let mut w_dims: List[Int] = list_new();
    w_dims = list_push(w_dims, in_features);
    w_dims = list_push(w_dims, out_features);

    let mut w_data: List[Float] = list_new();
    let num_w: Int = in_features * out_features;
    let mut i: Int = 0;
    while i < num_w {
        w_data = list_push(w_data, 1.0);
        i = i + 1;
    }

    let w_res: Result[Tensor, String] = tensor_from_list_2d(w_data, in_features, out_features);
    match w_res {
        Ok(w) => {
            let mut b_data: List[Float] = list_new();
            let mut j: Int = 0;
            while j < out_features {
                b_data = list_push(b_data, 0.0);
                j = j + 1;
            }

            let b_res: Result[Tensor, String] = tensor_from_list_2d(b_data, 1, out_features);
            match b_res {
                Ok(b) => {
                    return Ok(LinearLayer {
                        in_features: in_features,
                        out_features: out_features,
                        weight: w,
                        bias: b
                    });
                }
                Err(e) => {
                    return Err(e);
                }
            }
        }
        Err(e) => {
            return Err(e);
        }
    }
}

/// Compute forward affine pass: y = x * W + b.
pub fn linear_forward(layer: &LinearLayer, x: &Tensor) -> Result[Tensor, String] {
    let in_f: Int = (layer).in_features;
    let out_f: Int = (layer).out_features;
    let x_num: Int = (x).numel;
    if x_num != in_f {
        return Err("ERR\tlinear_forward: input dimension mismatch");
    }
    let x_data: List[Float] = (x).data;
    let weight_tensor: Tensor = (layer).weight;
    let w_data: List[Float] = (weight_tensor).data;
    let bias_tensor: Tensor = (layer).bias;
    let b_data: List[Float] = (bias_tensor).data;

    let mut y_data: List[Float] = list_new();
    let mut j: Int = 0;
    while j < out_f {
        let mut dot: Float = 0.0;
        let mut i: Int = 0;
        while i < in_f {
            let xi: Float = list_get(x_data, i);
            let wi: Float = list_get(w_data, i * out_f + j);
            dot = dot + xi * wi;
            i = i + 1;
        }
        let bj: Float = list_get(b_data, j);
        y_data = list_push(y_data, dot + bj);
        j = j + 1;
    }
    return Ok(Tensor {
        data: y_data,
        rows: 1,
        cols: out_f,
        numel: out_f,
        requires_grad: (x).requires_grad
    });
}
