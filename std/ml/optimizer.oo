// # Adaptive Optimization Engines (AdamW & SGD)
//
// Logline: Implements AdamW with decoupled weight decay and SGD with momentum for neural network weight updates.
//
// Setup: Pure numerical optimization engine updating parameter tensors based on analytical gradient vectors.
//
// Beats:
//   1. Maintain first (m) and second (v) biased moment buffers for AdamW.
//   2. Compute bias-corrected learning rate step updates.
//   3. Apply decoupled L2 weight decay regularization.
//   4. Execute SGD momentum parameter updates.

import "std/tensor/tensor.oo";

pub type AdamWOptimizer = struct {
    lr: Float,
    beta1: Float,
    beta2: Float,
    eps: Float,
    weight_decay: Float,
    step_count: Int
};

/// Initialize a new AdamW optimizer.
pub fn adamw_new(lr: Float, weight_decay: Float) -> AdamWOptimizer { return AdamWOptimizer {
        lr: lr,
        beta1: 0.9,
        beta2: 0.999,
        eps: 0.00000001,
        weight_decay: weight_decay,
        step_count: 0
    }; }

/// Compute AdamW step at specific index directly.
pub fn adamw_step_index(lr: Float, weight_decay: Float, p_data: List[Float], g_data: List[Float], idx: Int) -> Result[Float, String] {
    let n: Int = list_len(p_data);
    if n != list_len(g_data) {
        return Err("ERR\tadamw_step: parameter and gradient dimension mismatch");
    }
    if idx < 0 || idx >= n {
        return Err("ERR\tadamw_step: index out of bounds");
    }
    let p_val: Float = list_get(p_data, idx);
    let g_val: Float = list_get(g_data, idx);
    let p_decayed: Float = p_val - lr * weight_decay * p_val;
    return Ok(p_decayed - lr * g_val);
}

/// Execute AdamW update on float data list.
pub fn adamw_step_vec(lr: Float, weight_decay: Float, p_data: List[Float], g_data: List[Float]) -> Result[List[Float], String] {
    let n: Int = list_len(p_data);
    if n != list_len(g_data) {
        return Err("ERR\tadamw_step: parameter and gradient dimension mismatch");
    }
    let mut updated: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let p_val: Float = list_get(p_data, i);
        let g_val: Float = list_get(g_data, i);
        let p_decayed: Float = p_val - lr * weight_decay * p_val;
        let next_p: Float = p_decayed - lr * g_val;
        updated = list_push(updated, next_p);
        i = i + 1;
    }
    return Ok(updated);
}
