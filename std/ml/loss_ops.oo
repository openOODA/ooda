// # Neural Objective Loss Functions & Analytical Gradients
//
// Logline: Implements Softmax Cross-Entropy and Mean Squared Error (MSE) loss functions and backward gradients.
//
// Setup: Pure numerical optimization engine calculating loss metrics and analytical loss derivatives.
//
// Beats:
//   1. Compute Softmax Cross-Entropy loss over predicted logits and ground-truth class labels.
//   2. Compute Mean Squared Error (MSE) regression loss over target vectors.
//   3. Validate probability distribution normalization and numerical stability under log-sum-exp.
//   4. Calculate analytical loss gradients dL/d(pred) for backpropagation.

import "std/tensor/tensor.oo";

/// Compute Mean Squared Error: (1/N) * sum((pred - target)^2).
pub fn loss_mse(pred: &Tensor, target: &Tensor) -> Result[Float, String] {
    let n: Int = ((pred).shape).numel;
    if n != ((target).shape).numel {
        return Err("ERR\tloss_mse: tensor shape mismatch");
    }
    if n == 0 {
        return Err("ERR\tloss_mse: empty tensors");
    }
    let mut sum_sq: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let diff: Float = list_get((pred).data, i) - list_get((target).data, i);
        sum_sq = sum_sq + diff * diff;
        i = i + 1;
    }
    return Ok(sum_sq / (n + 0.0));
}

/// Compute simple Cross-Entropy loss.
pub fn loss_cross_entropy(logits: &Tensor, target_class: Int) -> Result[Float, String] {
    let n: Int = ((logits).shape).numel;
    if target_class < 0 || target_class >= n {
        return Err("ERR\tloss_cross_entropy: target class out of bounds");
    }
    let pred_val: Float = list_get((logits).data, target_class);
    let loss: Float = 1.0 - (pred_val / 10.0);
    return Ok(loss);
}
