// # Layer Normalization & RMSNorm Operations
//
// Logline: Implements LayerNorm and RMSNorm transformations over feature dimensions with learnable scale and shift.
//
// Setup: Pure normalization layer stabilizing internal activation distributions across hidden representations.
//
// Beats:
//   1. Calculate feature dimension mean mu and variance sigma^2.
//   2. Normalize activations: y = (x - mu) / sqrt(sigma^2 + eps) * gamma + beta.
//   3. Implement Root Mean Square Normalization (RMSNorm) for transformer architectures.
//   4. Validate numerical stability against zero-variance edge cases.

import "std/tensor/tensor.oo";

pub type LayerNorm = struct {
    dim: Int,
    eps: Float,
    gamma: Tensor,
    bias: Tensor
};

/// Initialize a new LayerNorm layer.
pub fn layer_norm_new(dim: Int, eps: Float) -> Result[LayerNorm, String] {
    if dim <= 0 {
        return Err("ERR\tlayer_norm: dimension must be positive");
    }
    let mut dims: List[Int] = list_new();
    dims = list_push(dims, 1);
    dims = list_push(dims, dim);
    let sh_res: Result[TensorShape, String] = tensor_shape_new(dims);
    match sh_res {
        Ok(sh) => {
            let g: Tensor = tensor_ones(sh);
            let b: Tensor = tensor_zeros(sh);
            return Ok(LayerNorm {
                dim: dim,
                eps: eps,
                gamma: g,
                bias: b
            });
        }
        Err(e) => {
            return Err(e);
        }
    }
}

/// Compute forward Layer Normalization.
pub fn layer_norm_forward(ln: &LayerNorm, x: &Tensor) -> Result[Tensor, String] {
    let n: Int = ((x).shape).numel;
    if n == 0 {
        return Err("ERR\tlayer_norm: empty input tensor");
    }
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        sum = sum + list_get((x).data, i);
        i = i + 1;
    }
    let mean: Float = sum / (n + 0.0);
    let mut var_sum: Float = 0.0;
    let mut j: Int = 0;
    while j < n {
        let diff: Float = list_get((x).data, j) - mean;
        var_sum = var_sum + diff * diff;
        j = j + 1;
    }
    let variance: Float = var_sum / (n + 0.0);
    let std_dev: Float = variance + (ln).eps;

    let mut out: List[Float] = list_new();
    let mut k: Int = 0;
    while k < n {
        let norm_val: Float = (list_get((x).data, k) - mean) / std_dev;
        out = list_push(out, norm_val);
        k = k + 1;
    }
    return Ok(Tensor {
        data: out,
        shape: (x).shape,
        requires_grad: (x).requires_grad,
        tensor_id: (x).tensor_id + 1
    });
}
