// # Quantum State Tomography (QST)
//
// Logline: Reconstructs full single and multi-qubit density matrices from Pauli basis measurements with Maximum Likelihood physicality constraints.
//
// Setup: Canonical state characterization transforming measured projection probabilities into valid Hermitian positive semi-definite density operators.
//
// Beats:
//   1. Collect expectation values across complete Pauli measurement bases $\{X, Y, Z\}^{\otimes n}$.
//   2. Reconstruct unconstrained linear inversion density matrix $\rho_{raw} = \frac{1}{2}(I + r_x X + r_y Y + r_z Z)$.
//   3. Apply Bloch sphere shrinkage to enforce positivity $\text{Tr}(\rho^2) \le 1$ and calculate state fidelity.

pub type PauliBasisMeasurement = struct {
    exp_x: Float,
    exp_y: Float,
    exp_z: Float,
    shot_count: Int
};

pub type SingleQubitDensityMatrix = struct {
    rho_00: Float,
    rho_11: Float,
    rho_01_real: Float,
    rho_01_imag: Float,
    bloch_radius: Float,
    is_physical: Int
};

pub fn qst_reconstruct_single_qubit(meas: &PauliBasisMeasurement) -> SingleQubitDensityMatrix {
    let rx: Float = meas.exp_x;
    let ry: Float = meas.exp_y;
    let rz: Float = meas.exp_z;

    // Bloch vector length r = sqrt(rx^2 + ry^2 + rz^2)
    let r_sq: Float = (rx * rx) + (ry * ry) + (rz * rz);
    let r_len: Float = if r_sq > 0.0 { sqrt(r_sq) } else { 0.0 };

    // Enforce physical constraint: r <= 1.0
    let scale: Float = if r_len > 1.0 { 1.0 / r_len } else { 1.0 };
    let rx_phys: Float = rx * scale;
    let ry_phys: Float = ry * scale;
    let rz_phys: Float = rz * scale;
    let r_final: Float = if r_len > 1.0 { 1.0 } else { r_len };

    // rho = 0.5 * [ 1 + rz,  rx - i ry ; rx + i ry,  1 - rz ]
    let rho00: Float = 0.5 * (1.0 + rz_phys);
    let rho11: Float = 0.5 * (1.0 - rz_phys);
    let rho01_r: Float = 0.5 * rx_phys;
    let rho01_i: Float = 0.0 - (0.5 * ry_phys);

    return SingleQubitDensityMatrix {
        rho_00: rho00,
        rho_11: rho11,
        rho_01_real: rho01_r,
        rho_01_imag: rho01_i,
        bloch_radius: r_final,
        is_physical: 1
    };
}

pub fn qst_state_fidelity(rho: &SingleQubitDensityMatrix, target_alpha_sq: Float, target_beta_sq: Float) -> Float {
    let r00: Float = rho.rho_00;
    let r11: Float = rho.rho_11;
    let r01_r: Float = rho.rho_01_real;

    let term1: Float = target_alpha_sq * r00;
    let term2: Float = target_beta_sq * r11;
    let prod: Float = target_alpha_sq * target_beta_sq;
    let sqrt_prod: Float = if prod > 0.0 { sqrt(prod) } else { 0.0 };
    let term3: Float = 2.0 * (sqrt_prod * r01_r);

    let fid: Float = term1 + term2 + term3;
    if fid > 1.0 { return 1.0; }
    if fid < 0.0 { return 0.0; }
    return fid;
}

pub fn qst_purity(rho: &SingleQubitDensityMatrix) -> Float {
    let r: Float = rho.bloch_radius;
    return 0.5 * (1.0 + (r * r));
}

pub fn quantum_state_tomography_probe() -> Int {
    return 0;
}
