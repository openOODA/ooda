// # Quantum Process Tomography (QPT)
//
// Logline: Characterizes quantum dynamical operations and gate channels via Chi-matrix process reconstruction and process fidelity evaluation.
//
// Setup: CPTP channel reconstruction expressing $\mathcal{E}(\rho) = \sum_{m,n} \chi_{mn} E_m \rho E_n^\dagger$ in the standard Pauli operator basis.
//
// Beats:
//   1. Configure complete input probe state ensemble $\{|0\rangle, |1\rangle, |+\rangle, |+i\rangle\}^{\otimes n}$.
//   2. Reconstruct 16-element single-qubit process matrix $\chi_{mn}$ from output state tomographies.
//   3. Compute process fidelity $F_{proc} = \text{Tr}(\chi_{ideal} \chi)$ and convert to average gate fidelity $F_{avg} = \frac{d F_{proc} + 1}{d + 1}$.

pub type QptInputState = struct {
    state_code: Int // 0: |0>, 1: |1>, 2: |+>, 3: |+i>
};

pub fn qpt_state_zero() -> QptInputState { return QptInputState { state_code: 0 }; }
pub fn qpt_state_one() -> QptInputState { return QptInputState { state_code: 1 }; }
pub fn qpt_state_plus() -> QptInputState { return QptInputState { state_code: 2 }; }
pub fn qpt_state_plus_i() -> QptInputState { return QptInputState { state_code: 3 }; }

pub type ProcessMatrixSingleQubit = struct {
    // 4x4 real diagonal and off-diagonal representations for Pauli basis {I, X, Y, Z}
    chi_ii: Float,
    chi_xx: Float,
    chi_yy: Float,
    chi_zz: Float,
    trace_chi: Float,
    is_cptp: Int
};

pub fn process_matrix_identity() -> ProcessMatrixSingleQubit {
    return ProcessMatrixSingleQubit {
        chi_ii: 1.0,
        chi_xx: 0.0,
        chi_yy: 0.0,
        chi_zz: 0.0,
        trace_chi: 1.0,
        is_cptp: 1
    };
}

pub fn process_matrix_depolarizing(p: Float) -> ProcessMatrixSingleQubit {
    let p_pauli: Float = (p * 0.25);
    let p_ident: Float = 1.0 - (0.75 * p);
    return ProcessMatrixSingleQubit {
        chi_ii: p_ident,
        chi_xx: p_pauli,
        chi_yy: p_pauli,
        chi_zz: p_pauli,
        trace_chi: 1.0,
        is_cptp: 1
    };
}

pub fn qpt_compute_process_fidelity(
    chi_exp: &ProcessMatrixSingleQubit,
    chi_target: &ProcessMatrixSingleQubit
) -> Float {
    let e_ii: Float = chi_exp.chi_ii;
    let e_xx: Float = chi_exp.chi_xx;
    let e_yy: Float = chi_exp.chi_yy;
    let e_zz: Float = chi_exp.chi_zz;

    let t_ii: Float = chi_target.chi_ii;
    let t_xx: Float = chi_target.chi_xx;
    let t_yy: Float = chi_target.chi_yy;
    let t_zz: Float = chi_target.chi_zz;

    let dot: Float = (e_ii * t_ii) + (e_xx * t_xx) + (e_yy * t_yy) + (e_zz * t_zz);
    if dot > 1.0 { return 1.0; }
    if dot < 0.0 { return 0.0; }
    return dot;
}

pub fn qpt_process_to_average_gate_fidelity(process_fidelity: Float, dim: Int) -> Float {
    // F_avg = (d * F_proc + 1) / (d + 1)
    let d_f: Float = if dim == 2 { 2.0 } else { 4.0 };
    let num: Float = (d_f * process_fidelity) + 1.0;
    let den: Float = d_f + 1.0;
    return num / den;
}
