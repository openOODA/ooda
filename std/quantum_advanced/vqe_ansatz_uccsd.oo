// # VQE Unitary Coupled Cluster Singles and Doubles (UCCSD)
//
// Logline: Generates fermionic single and double excitation operators mapped to Pauli strings for quantum chemistry VQE ansatz circuits.
//
// Setup: Chemically-inspired quantum state ansatz parameterized by single and double cluster amplitudes.
//
// Beats:
//   1. Enumerate spatial orbital single (T1) and double (T2) excitation indices for occupied/virtual orbitals.
//   2. Construct Jordan-Wigner anti-Hermitian excitation operators G = T - T^\dagger.
//   3. Compute Trotterized Pauli product sequences and parameter allocations.

pub type SingleExcitation = struct {
    occupied: Int,
    virtual_orb: Int,
    param_index: Int,
};

pub type DoubleExcitation = struct {
    occ1: Int,
    occ2: Int,
    virt1: Int,
    virt2: Int,
    param_index: Int,
};

pub type UccsdConfig = struct {
    num_spatial_orbitals: Int,
    num_spin_orbitals: Int,
    num_electrons: Int,
    num_singles: Int,
    num_doubles: Int,
    total_amplitudes: Int,
};

pub fn uccsd_config_new(spatial_orbitals: Int, electrons: Int) -> UccsdConfig {
    let spin_orbitals: Int = spatial_orbitals * 2;
    let n_occ: Int = electrons;
    let n_virt: Int = spin_orbitals - electrons;

    let n_singles: Int = n_occ * n_virt;
    let n_doubles: Int = ((n_occ * (n_occ - 1)) / 2) * ((n_virt * (n_virt - 1)) / 2);
    let total: Int = n_singles + n_doubles;

    return UccsdConfig {
        num_spatial_orbitals: spatial_orbitals,
        num_spin_orbitals: spin_orbitals,
        num_electrons: electrons,
        num_singles: n_singles,
        num_doubles: n_doubles,
        total_amplitudes: total,
    };
}

pub fn uccsd_get_singles(cfg: &UccsdConfig) -> List[SingleExcitation] {
    let mut list: List[SingleExcitation] = list_new();
    let n_occ: Int = cfg.num_electrons;
    let n_spin: Int = cfg.num_spin_orbitals;
    let mut param_idx: Int = 0;

    let mut i: Int = 0;
    while i < n_occ {
        let mut a: Int = n_occ;
        while a < n_spin {
            let s: SingleExcitation = SingleExcitation {
                occupied: i,
                virtual_orb: a,
                param_index: param_idx,
            };
            list_push(list, s);
            param_idx = param_idx + 1;
            a = a + 1;
        }
        i = i + 1;
    }
    return list;
}

pub fn uccsd_get_doubles(cfg: &UccsdConfig) -> List[DoubleExcitation] {
    let mut list: List[DoubleExcitation] = list_new();
    let n_occ: Int = cfg.num_electrons;
    let n_spin: Int = cfg.num_spin_orbitals;
    let mut param_idx: Int = cfg.num_singles;

    let mut i: Int = 0;
    while i < n_occ {
        let mut j: Int = i + 1;
        while j < n_occ {
            let mut a: Int = n_occ;
            while a < n_spin {
                let mut b: Int = a + 1;
                while b < n_spin {
                    let d: DoubleExcitation = DoubleExcitation {
                        occ1: i,
                        occ2: j,
                        virt1: a,
                        virt2: b,
                        param_index: param_idx,
                    };
                    list_push(list, d);
                    param_idx = param_idx + 1;
                    b = b + 1;
                }
                a = a + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return list;
}

pub fn uccsd_initial_hartree_fock_bitstring(cfg: &UccsdConfig) -> List[Int] {
    let mut bits: List[Int] = list_new();
    let n_spin: Int = cfg.num_spin_orbitals;
    let n_occ: Int = cfg.num_electrons;

    let mut i: Int = 0;
    while i < n_spin {
        if i < n_occ {
            list_push(bits, 1);
        } else {
            list_push(bits, 0);
        }
        i = i + 1;
    }
    return bits;
}

pub fn uccsd_trotter_step_count(cfg: &UccsdConfig, trotter_order: Int) -> Int {
    let total_ops: Int = (cfg.num_singles * 2) + (cfg.num_doubles * 8);
    return total_ops * trotter_order;
}
