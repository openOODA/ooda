// # OpenQASM 3.0 Transpiler Abstract Syntax Tree (AST)
//
// Logline: Represents OpenQASM 3.0 AST nodes including quantum registers, parameterized gates, defcal pulse definitions, and timing barriers.
//
// Setup: Intermediate representation for modern hybrid quantum compilation and pulse-level hardware lowering.
//
// Beats:
//   1. Define OpenQASM 3.0 statement types (qubit decl, bit decl, gate call, defcal, barrier, reset).
//   2. Model parameterized gate nodes with symbolic or concrete angle values and target operand lists.
//   3. Construct AST node sequences, pulse calibration mappings, and circuit serialization metadata.

pub type Qasm3NodeType = struct {
    code: Int // 0: QubitDecl, 1: BitDecl, 2: GateCall, 3: DefcalPulse, 4: Barrier, 5: Reset
};

pub fn qasm3_node_qubit_decl() -> Qasm3NodeType { return Qasm3NodeType { code: 0 }; }
pub fn qasm3_node_gate_call() -> Qasm3NodeType { return Qasm3NodeType { code: 2 }; }
pub fn qasm3_node_defcal() -> Qasm3NodeType { return Qasm3NodeType { code: 3 }; }
pub fn qasm3_node_barrier() -> Qasm3NodeType { return Qasm3NodeType { code: 4 }; }

pub type Qasm3GateNode = struct {
    gate_name_code: Int, // 0: CX, 1: CZ, 2: RZ, 3: SX, 4: X, 5: H
    qubit_1: Int,
    qubit_2: Int,
    param_theta: Float,
    duration_dt: Int
};

pub type Qasm3Program = struct {
    num_qubits: Int,
    num_clbits: Int,
    num_instructions: Int,
    gates: List[Qasm3GateNode]
};

pub fn qasm3_program_new(num_qubits: Int, num_clbits: Int) -> Qasm3Program {
    let empty_gates: List[Qasm3GateNode] = list_new();
    return Qasm3Program {
        num_qubits: num_qubits,
        num_clbits: num_clbits,
        num_instructions: 0,
        gates: empty_gates
    };
}

pub fn qasm3_append_gate(
    prog: &mut Qasm3Program,
    gate_code: Int,
    q1: Int,
    q2: Int,
    theta: Float,
    duration: Int
) {
    let node: Qasm3GateNode = Qasm3GateNode {
        gate_name_code: gate_code,
        qubit_1: q1,
        qubit_2: q2,
        param_theta: theta,
        duration_dt: duration
    };
    list_push(prog.gates, node);
    prog.num_instructions = prog.num_instructions + 1;
}

pub fn qasm3_total_duration(prog: &Qasm3Program) -> Int {
    let count: Int = prog.num_instructions;
    let list: List[Qasm3GateNode] = prog.gates;
    let mut total_dt: Int = 0;

    let mut i: Int = 0;
    while i < count {
        let node: Qasm3GateNode = list_get(list, i);
        let dt: Int = node.duration_dt;
        total_dt = total_dt + dt;
        i = i + 1;
    }
    return total_dt;
}
