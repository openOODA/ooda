// # 2D Topological Quantum Color Code
//
// Logline: Models 2D triangular and hexagonal color code lattices supporting transversal execution of the entire Clifford group.
//
// Setup: Self-dual CSS topological code defined on 3-colorable, 3-valent planar graphs with coincident X and Z face checks.
//
// Beats:
//   1. Configure 2D color code lattice geometry (triangular 6.6.6 vs 4.8.8) and calculate physical qubit counts.
//   2. Define 3-colorable face stabilizers (Red, Green, Blue faces with matching X and Z generators).
//   3. Implement transversal Clifford gate mappings (transversal H, S, and CNOT operations).

pub type ColorCodeFaceColor = struct {
    color_id: Int, // 0: Red, 1: Green, 2: Blue
};

pub fn color_red() -> ColorCodeFaceColor { return ColorCodeFaceColor { color_id: 0 }; }
pub fn color_green() -> ColorCodeFaceColor { return ColorCodeFaceColor { color_id: 1 }; }
pub fn color_blue() -> ColorCodeFaceColor { return ColorCodeFaceColor { color_id: 2 }; }

pub type ColorCodeLattice = struct {
    distance_d: Int,
    num_data_qubits: Int,
    num_faces: Int,
};

pub fn color_code_triangular_d3() -> ColorCodeLattice {
    // d=3 triangular color code has 7 data qubits and 3 faces (1 Red, 1 Green, 1 Blue)
    return ColorCodeLattice {
        distance_d: 3,
        num_data_qubits: 7,
        num_faces: 3,
    };
}

pub fn color_code_triangular_d5() -> ColorCodeLattice {
    // d=5 triangular color code has 19 data qubits and 9 faces
    return ColorCodeLattice {
        distance_d: 5,
        num_data_qubits: 19,
        num_faces: 9,
    };
}

pub type ColorCodeFaceCheck = struct {
    face_id: Int,
    color: ColorCodeFaceColor,
    num_qubits: Int,
    qubits: List[Int],
};

pub fn color_code_d3_face_checks() -> List[ColorCodeFaceCheck] {
    let mut faces: List[ColorCodeFaceCheck] = list_new();

    // Red face on qubits [0, 1, 2, 3]
    let mut r_q: List[Int] = list_new();
    list_push(r_q, 0); list_push(r_q, 1); list_push(r_q, 2); list_push(r_q, 3);
    let f_red: ColorCodeFaceCheck = ColorCodeFaceCheck {
        face_id: 0,
        color: color_red(),
        num_qubits: 4,
        qubits: r_q,
    };
    list_push(faces, f_red);

    // Green face on qubits [1, 2, 4, 5]
    let mut g_q: List[Int] = list_new();
    list_push(g_q, 1); list_push(g_q, 2); list_push(g_q, 4); list_push(g_q, 5);
    let f_green: ColorCodeFaceCheck = ColorCodeFaceCheck {
        face_id: 1,
        color: color_green(),
        num_qubits: 4,
        qubits: g_q,
    };
    list_push(faces, f_green);

    // Blue face on qubits [2, 3, 5, 6]
    let mut b_q: List[Int] = list_new();
    list_push(b_q, 2); list_push(b_q, 3); list_push(b_q, 5); list_push(b_q, 6);
    let f_blue: ColorCodeFaceCheck = ColorCodeFaceCheck {
        face_id: 2,
        color: color_blue(),
        num_qubits: 4,
        qubits: b_q,
    };
    list_push(faces, f_blue);

    return faces;
}

pub fn color_code_transversal_phase_gate(lattice: &ColorCodeLattice) -> Int {
    // In 2D color codes, logical S is transversal: S_L = \bigotimes S_j
    return lattice.num_data_qubits;
}
