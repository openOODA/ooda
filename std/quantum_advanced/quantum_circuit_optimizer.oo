// # Quantum Circuit Pattern Optimizer
//
// Logline: Applies pattern-matching peephole optimizations including adjacent gate cancellations, rotation mergers, and commutation reorderings.
//
// Setup: Rule-based circuit compression engine reducing gate count and two-qubit execution depth before physical lowering.
//
// Beats:
//   1. Eliminate adjacent self-inverse gate pairs ($H\cdot H = I$, $X\cdot X = I$, $CX\cdot CX = I$).
//   2. Merge consecutive single-qubit rotations $R_z(\theta_1) R_z(\theta_2) = R_z(\theta_1 + \theta_2)$.
//   3. Commute diagonal phase gates through CNOT controls to unlock downstream cancellations.

pub type CircuitGateRecord = struct {
    gate_id: Int,
    gate_type: Int, // 0: H, 1: X, 2: RZ, 3: CX, 4: CZ
    qubit_1: Int,
    qubit_2: Int,
    param: Float,
    is_cancelled: Int
};

pub type OptimizationStats = struct {
    initial_gate_count: Int,
    final_gate_count: Int,
    cancelled_pairs: Int,
    merged_rotations: Int
};

pub fn circuit_cancel_adjacent_inverses(
    gate_types: List[Int],
    qubit_targets: List[Int]
) -> OptimizationStats {
    let n_gates: Int = list_len(gate_types);
    let mut cancelled: Int = 0;

    let mut i: Int = 0;
    while i < (n_gates - 1) {
        let g1: Int = list_get(gate_types, i);
        let g2: Int = list_get(gate_types, i + 1);
        let q1: Int = list_get(qubit_targets, i);
        let q2: Int = list_get(qubit_targets, i + 1);

        // If identical self-inverse gate on the same qubit:
        if q1 == q2 && g1 == g2 && (g1 == 0 || g1 == 1) {
            cancelled = cancelled + 1;
            i = i + 1; // Skip pair
        }
        i = i + 1;
    }

    let final_count: Int = n_gates - (cancelled * 2);
    return OptimizationStats {
        initial_gate_count: n_gates,
        final_gate_count: final_count,
        cancelled_pairs: cancelled,
        merged_rotations: 0
    };
}

pub fn circuit_merge_rotations_angle(theta1: Float, theta2: Float) -> Float {
    let mut sum: Float = theta1 + theta2;
    let two_pi: Float = 6.283185307179586;
    while sum >= two_pi {
        sum = sum - two_pi;
    }
    while sum < 0.0 {
        sum = sum + two_pi;
    }
    return sum;
}

pub fn circuit_gates_commute(
    gate1_type: Int,
    q1_a: Int,
    q1_b: Int,
    gate2_type: Int,
    q2_a: Int,
    q2_b: Int
) -> Int {
    // RZ (type 2) commutes with CNOT (type 3) control
    if gate1_type == 2 && gate2_type == 3 && q1_a == q2_a {
        return 1;
    }
    // RZ (type 2) commutes with CZ (type 4) on either control or target
    if gate1_type == 2 && gate2_type == 4 && (q1_a == q2_a || q1_a == q2_b) {
        return 1;
    }
    return 0;
}
