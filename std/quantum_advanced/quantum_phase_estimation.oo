// # Quantum Phase Estimation (QPE)
//
// Logline: Generates Quantum Phase Estimation circuits and iterative single-ancilla phase estimators for extracting unitary eigenvalues.
//
// Setup: Fundamental quantum subroutine estimating phase $\theta$ in $U |\psi\rangle = e^{2\pi i \theta} |\psi\rangle$.
//
// Beats:
//   1. Configure precision counting registers and target eigenstate qubit allocations.
//   2. Compute controlled unitary powers $U^{2^k}$ and inverse QFT transformation schedules.
//   3. Implement Iterative Phase Estimation (IPE) single-qubit classical feedback updates.

pub type QpeConfig = struct {
    num_counting_qubits: Int,
    num_target_qubits: Int,
    precision_bits: Int,
};

pub fn qpe_config_new(counting_qubits: Int, target_qubits: Int) -> QpeConfig {
    return QpeConfig {
        num_counting_qubits: counting_qubits,
        num_target_qubits: target_qubits,
        precision_bits: counting_qubits,
    };
}

pub type QpeControlledPower = struct {
    control_qubit: Int,
    power_exponent: Int, // 2^k
};

pub fn qpe_generate_power_schedule(cfg: &QpeConfig) -> List[QpeControlledPower] {
    let mut schedule: List[QpeControlledPower] = list_new();
    let n_count: Int = cfg.num_counting_qubits;
    let mut exp_val: Int = 1;

    let mut k: Int = 0;
    while k < n_count {
        let entry: QpeControlledPower = QpeControlledPower {
            control_qubit: k,
            power_exponent: exp_val,
        };
        list_push(schedule, entry);
        exp_val = exp_val * 2;
        k = k + 1;
    }
    return schedule;
}

pub fn qpe_binary_fraction_to_float(bits: List[Int]) -> Float {
    let count: Int = list_len(bits);
    let mut phase: Float = 0.0;
    let mut weight: Float = 0.5;

    let mut i: Int = 0;
    while i < count {
        let b: Int = list_get(bits, i);
        if b == 1 {
            phase = phase + weight;
        }
        weight = weight * 0.5;
        i = i + 1;
    }
    return phase;
}

pub type IpeState = struct {
    num_bits: Int,
    current_bit_index: Int,
    accumulated_phase: Float,
    measured_bits: List[Int],
};

pub fn ipe_state_new(num_bits: Int) -> IpeState {
    let empty_bits: List[Int] = list_new();
    return IpeState {
        num_bits: num_bits,
        current_bit_index: num_bits - 1, // Start from least significant bit
        accumulated_phase: 0.0,
        measured_bits: empty_bits,
    };
}

pub fn ipe_compute_feedback_angle(state: &IpeState) -> Float {
    let bits: List[Int] = state.measured_bits;
    let n_measured: Int = list_len(bits);
    let mut angle: Float = 0.0;
    let mut factor: Float = 0.5;

    let mut i: Int = 0;
    while i < n_measured {
        let b: Int = list_get(bits, i);
        if b == 1 {
            angle = angle + factor;
        }
        factor = factor * 0.5;
        i = i + 1;
    }
    // Phase correction in radians = 2 * pi * angle
    return 6.283185307179586 * angle;
}

pub fn ipe_record_measurement(state: &mut IpeState, bit_val: Int) {
    list_push(state.measured_bits, bit_val);
    state.current_bit_index = state.current_bit_index - 1;
}
