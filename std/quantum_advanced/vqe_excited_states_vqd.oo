// # Variational Quantum Deflation (VQD) for Excited States
//
// Logline: Computes excited state energy spectra using Variational Quantum Deflation with state overlap penalties and subspace orthogonalization.
//
// Setup: Multi-level eigenvalue solver extending VQE beyond the ground state using quantum swap test penalties.
//
// Beats:
//   1. Configure VQD target energy state level (k-th excited state) and overlap penalty weights beta_j.
//   2. Formulate deflated cost function $L(\theta) = \langle H \rangle + \sum_j \beta_j |\langle \psi(\theta) | \psi_j \rangle|^2$.
//   3. Manage previously converged eigenstates and evaluate excited state energy gaps.

pub type VqdLevel = struct {
    level_index: Int, // 0 = ground state, 1 = 1st excited state, etc.
    energy: Float,
    converged: Int,
    parameters: List[Float]
};

pub type VqdDeflationConfig = struct {
    target_level: Int,
    beta_penalty: Float,
    max_levels: Int
};

pub fn vqd_config_new(target: Int, beta: Float, max_levels: Int) -> VqdDeflationConfig {
    return VqdDeflationConfig {
        target_level: target,
        beta_penalty: beta,
        max_levels: max_levels
    };
}

pub type VqdSpectrum = struct {
    num_levels_found: Int,
    levels: List[VqdLevel]
};

pub fn vqd_spectrum_new() -> VqdSpectrum {
    let empty: List[VqdLevel] = list_new();
    return VqdSpectrum {
        num_levels_found: 0,
        levels: empty
    };
}

pub fn vqd_spectrum_add_level(
    spectrum: &mut VqdSpectrum,
    level_idx: Int,
    energy: Float,
    params: List[Float]
) {
    let lvl: VqdLevel = VqdLevel {
        level_index: level_idx,
        energy: energy,
        converged: 1,
        parameters: params
    };
    list_push(spectrum.levels, lvl);
    spectrum.num_levels_found = spectrum.num_levels_found + 1;
}

pub fn vqd_compute_deflated_cost(
    base_energy: Float,
    overlaps_sq: List[Float],
    beta_weights: List[Float]
) -> Float {
    let mut total: Float = base_energy;
    let count: Int = list_len(overlaps_sq);
    let mut i: Int = 0;
    while i < count {
        let ov: Float = list_get(overlaps_sq, i);
        let w: Float = list_get(beta_weights, i);
        total = total + (w * ov);
        i = i + 1;
    }
    return total;
}

pub fn vqd_energy_gap(spectrum: &VqdSpectrum, level_a: Int, level_b: Int) -> Float {
    let count: Int = spectrum.num_levels_found;
    if level_a >= count || level_b >= count {
        return 0.0;
    }
    let lvl_a: VqdLevel = list_get(spectrum.levels, level_a);
    let lvl_b: VqdLevel = list_get(spectrum.levels, level_b);
    let diff: Float = lvl_b.energy - lvl_a.energy;
    return if diff < 0.0 { 0.0 - diff } else { diff };
}

pub fn vqd_swap_test_overlap(prob_zero: Float) -> Float {
    // In a Swap Test, P(0) = 0.5 + 0.5 * |<psi|phi>|^2 => |<psi|phi>|^2 = 2 * P(0) - 1
    let ov_sq: Float = (2.0 * prob_zero) - 1.0;
    if ov_sq < 0.0 {
        return 0.0;
    }
    if ov_sq > 1.0 {
        return 1.0;
    }
    return ov_sq;
}
