// # Molecular Hamiltonian Integrals Representation
//
// Logline: Stores 1-electron and 2-electron molecular orbital integrals, nuclear repulsion energies, and maps to electronic Hamiltonians.
//
// Setup: Quantum chemistry electronic structure integral tensor storage for VQE and Hartree-Fock initializations.
//
// Beats:
//   1. Define 1-electron kinetic/nuclear-attraction integral matrix $h_{pq}$ and nuclear repulsion scalar.
//   2. Define 2-electron Coulomb/exchange electron-repulsion tensor $g_{pqrs}$ with 8-fold index symmetry.
//   3. Compute Hartree-Fock mean-field energy and convert integrals to Jordan-Wigner Hamiltonian coefficients.

pub type OneElectronIntegral = struct {
    p: Int,
    q: Int,
    value: Float,
};

pub type TwoElectronIntegral = struct {
    p: Int,
    q: Int,
    r: Int,
    s: Int,
    value: Float,
};

pub type MolecularIntegrals = struct {
    num_orbitals: Int,
    nuclear_repulsion_energy: Float,
    num_one_body: Int,
    one_body_integrals: List[OneElectronIntegral],
    num_two_body: Int,
    two_body_integrals: List[TwoElectronIntegral],
};

pub fn molecular_integrals_new(num_orbitals: Int, e_nuc: Float) -> MolecularIntegrals {
    let empty_one: List[OneElectronIntegral] = list_new();
    let empty_two: List[TwoElectronIntegral] = list_new();
    return MolecularIntegrals {
        num_orbitals: num_orbitals,
        nuclear_repulsion_energy: e_nuc,
        num_one_body: 0,
        one_body_integrals: empty_one,
        num_two_body: 0,
        two_body_integrals: empty_two,
    };
}

pub fn molecular_integrals_add_one_body(mol: &mut MolecularIntegrals, p: Int, q: Int, val: Float) {
    let elem: OneElectronIntegral = OneElectronIntegral { p: p, q: q, value: val };
    list_push(mol.one_body_integrals, elem);
    mol.num_one_body = mol.num_one_body + 1;
}

pub fn molecular_integrals_add_two_body(
    mol: &mut MolecularIntegrals,
    p: Int,
    q: Int,
    r: Int,
    s: Int,
    val: Float
) {
    let elem: TwoElectronIntegral = TwoElectronIntegral {
        p: p,
        q: q,
        r: r,
        s: s,
        value: val,
    };
    list_push(mol.two_body_integrals, elem);
    mol.num_two_body = mol.num_two_body + 1;
}

pub fn molecular_integrals_hf_energy(mol: &MolecularIntegrals, num_occupied: Int) -> Float {
    let mut e_tot: Float = mol.nuclear_repulsion_energy;

    // Sum over occupied 1-electron integrals: 2 * \sum_i h_{ii}
    let n1: Int = mol.num_one_body;
    let list1: List[OneElectronIntegral] = mol.one_body_integrals;
    let mut i: Int = 0;
    while i < n1 {
        let term: OneElectronIntegral = list_get(list1, i);
        let p: Int = term.p;
        let q: Int = term.q;
        let v: Float = term.value;
        if p == q && p < num_occupied {
            e_tot = e_tot + (2.0 * v);
        }
        i = i + 1;
    }

    // Sum over occupied 2-electron integrals: \sum_{ij} (2 J_{ij} - K_{ij})
    let n2: Int = mol.num_two_body;
    let list2: List[TwoElectronIntegral] = mol.two_body_integrals;
    let mut j: Int = 0;
    while j < n2 {
        let term2: TwoElectronIntegral = list_get(list2, j);
        let tp: Int = term2.p;
        let tq: Int = term2.q;
        let tr: Int = term2.r;
        let ts: Int = term2.s;
        let tv: Float = term2.value;
        if tp < num_occupied && tq < num_occupied {
            if tp == tr && tq == ts {
                // Direct Coulomb J_{ij}
                e_tot = e_tot + (2.0 * tv);
            }
            if tp == ts && tq == tr {
                // Exchange K_{ij}
                e_tot = e_tot - tv;
            }
        }
        j = j + 1;
    }

    return e_tot;
}
