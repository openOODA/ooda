// # Quantum Universal Basis Gate Transpiler
//
// Logline: Transpiles arbitrary quantum gates and rotation unitaries into native hardware basis gate sets (CX/RZ/SX/X vs CZ/RX/RY).
//
// Setup: Canonical single/two-qubit Euler angle decomposition lowering abstract circuits to physical execution sets.
//
// Beats:
//   1. Decompose arbitrary single-qubit unitaries $U(\theta, \phi, \lambda)$ into $RZ - SX - RZ - SX - RZ$ microwave sequences.
//   2. Lower Hadamard, Pauli-Y, and Phase gates to IBM $\{CX, RZ, SX, X\}$ native instructions.
//   3. Transpile two-qubit CNOT gates to native Controlled-Z (CZ) with flanking Hadamards.

pub type NativeBasisType = struct {
    mode: Int // 0: IBM_CX_RZ_SX, 1: Rigetti_CZ_RX_RY, 2: IonQ_MS
};

pub fn basis_ibm() -> NativeBasisType { return NativeBasisType { mode: 0 }; }
pub fn basis_rigetti() -> NativeBasisType { return NativeBasisType { mode: 1 }; }
pub fn basis_ionq() -> NativeBasisType { return NativeBasisType { mode: 2 }; }

pub type TranspiledGate = struct {
    gate_name_code: Int, // 0: RZ, 1: SX, 2: X, 3: CX, 4: CZ, 5: RX, 6: RY
    target_qubit: Int,
    control_qubit: Int,
    parameter: Float
};

pub fn transpile_hadamard_to_ibm(target: Int) -> List[TranspiledGate] {
    let mut gates: List[TranspiledGate] = list_new();
    let half_pi: Float = 1.5707963267948966;

    // H = RZ(pi/2) * SX * RZ(pi/2)
    let g1: TranspiledGate = TranspiledGate { gate_name_code: 0, target_qubit: target, control_qubit: 0 - 1, parameter: half_pi };
    let g2: TranspiledGate = TranspiledGate { gate_name_code: 1, target_qubit: target, control_qubit: 0 - 1, parameter: 0.0 };
    let g3: TranspiledGate = TranspiledGate { gate_name_code: 0, target_qubit: target, control_qubit: 0 - 1, parameter: half_pi };

    list_push(gates, g1);
    list_push(gates, g2);
    list_push(gates, g3);

    return gates;
}

pub fn transpile_cnot_to_cz(control: Int, target: Int) -> List[TranspiledGate] {
    let mut gates: List[TranspiledGate] = list_new();

    // CNOT(c, t) = H(t) * CZ(c, t) * H(t)
    let h_before: List[TranspiledGate] = transpile_hadamard_to_ibm(target);
    let n1: Int = list_len(h_before);
    let mut i: Int = 0;
    while i < n1 {
        let g: TranspiledGate = list_get(h_before, i);
        list_push(gates, g);
        i = i + 1;
    }

    let cz: TranspiledGate = TranspiledGate { gate_name_code: 4, target_qubit: target, control_qubit: control, parameter: 0.0 };
    list_push(gates, cz);

    let h_after: List[TranspiledGate] = transpile_hadamard_to_ibm(target);
    let n2: Int = list_len(h_after);
    let mut j: Int = 0;
    while j < n2 {
        let g: TranspiledGate = list_get(h_after, j);
        list_push(gates, g);
        j = j + 1;
    }

    return gates;
}
