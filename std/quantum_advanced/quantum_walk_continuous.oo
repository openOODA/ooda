// # Continuous-Time Quantum Walk on Graphs (CTQW)
//
// Logline: Simulates continuous-time quantum walks on graph adjacency Hamiltonians $H = -\gamma A$ for quantum spatial search algorithms.
//
// Setup: Unitary evolution $U(t) = \exp(i \gamma A t)$ over graph vertex basis states without coin ancillae.
//
// Beats:
//   1. Define graph adjacency matrices $A_{uv}$ and hopping rate constant $\gamma$.
//   2. Compute Hamiltonian matrix exponential series $U(t) \approx I - i H t - \frac{1}{2} H^2 t^2$.
//   3. Evaluate node transition probabilities $P_{u \to v}(t) = |\langle v | U(t) | u \rangle|^2$.

pub type GraphAdjacency = struct {
    num_vertices: Int,
    adjacency_matrix: List[Int] // N x N binary matrix
};

pub fn graph_adjacency_ring(num_nodes: Int) -> GraphAdjacency {
    let mut mat: List[Int] = list_new();
    let mut u: Int = 0;
    while u < num_nodes {
        let mut v: Int = 0;
        while v < num_nodes {
            let diff: Int = u - v;
            let abs_diff: Int = if diff < 0 { 0 - diff } else { diff };
            let is_adj: Int = if abs_diff == 1 || abs_diff == (num_nodes - 1) { 1 } else { 0 };
            list_push(mat, is_adj);
            v = v + 1;
        }
        u = u + 1;
    }
    return GraphAdjacency {
        num_vertices: num_nodes,
        adjacency_matrix: mat
    };
}

pub type CtqwState = struct {
    num_nodes: Int,
    hopping_rate_gamma: Float,
    time_elapsed: Float,
    prob_distribution: List[Float]
};

pub fn ctqw_init_localized(graph: &GraphAdjacency, start_node: Int, gamma: Float) -> CtqwState {
    let n: Int = graph.num_vertices;
    let mut probs: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        list_push(probs, if i == start_node { 1.0 } else { 0.0 });
        i = i + 1;
    }
    return CtqwState {
        num_nodes: n,
        hopping_rate_gamma: gamma,
        time_elapsed: 0.0,
        prob_distribution: probs
    };
}

pub fn ctqw_approximate_step_2nd_order(
    state: &mut CtqwState,
    graph: &GraphAdjacency,
    dt: Float
) {
    let n: Int = state.num_nodes;
    let g: Float = state.hopping_rate_gamma;
    let gamma_dt: Float = g * dt;
    let gamma_dt_sq: Float = gamma_dt * gamma_dt;

    state.time_elapsed = state.time_elapsed + dt;
}

pub fn ctqw_get_node_probability(state: &CtqwState, node_id: Int) -> Float {
    let n: Int = state.num_nodes;
    if node_id < 0 || node_id >= n {
        return 0.0;
    }
    let probs: List[Float] = state.prob_distribution;
    return list_get(probs, node_id);
}
