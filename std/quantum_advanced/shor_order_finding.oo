// # Shor's Quantum Order Finding Subroutine
//
// Logline: Configures quantum order-finding registers and modular exponentiation unitary gates to find the period of $a \pmod N$.
//
// Setup: Core polynomial-time quantum subroutine powering Shor's algorithm for discrete logarithms and integer factorization.
//
// Beats:
//   1. Compute register width requirements ($2L+1$ counting qubits for $L = \lceil\log_2 N\rceil$).
//   2. Generate controlled modular multiplication powers $a^{2^k} \pmod N$.
//   3. Implement classical modular exponentiation verification $a^r \equiv 1 \pmod N$.

pub type OrderFindingConfig = struct {
    base_a: Int,
    modulus_n: Int,
    target_qubits: Int,
    counting_qubits: Int,
    total_qubits: Int
};

pub fn bit_length(n: Int) -> Int {
    let mut bits: Int = 0;
    let mut val: Int = n;
    while val > 0 {
        bits = bits + 1;
        val = val / 2;
    }
    return if bits == 0 { 1 } else { bits };
}

pub fn order_finding_config_new(a: Int, n: Int) -> OrderFindingConfig {
    let l_bits: Int = bit_length(n);
    let count_q: Int = (2 * l_bits) + 1;
    let target_q: Int = l_bits;
    let total_q: Int = count_q + target_q;

    return OrderFindingConfig {
        base_a: a,
        modulus_n: n,
        target_qubits: target_q,
        counting_qubits: count_q,
        total_qubits: total_q
    };
}

pub fn mod_pow(base: Int, exp: Int, modulus: Int) -> Int {
    if modulus == 1 {
        return 0;
    }
    let mut res: Int = 1;
    let mut b: Int = base % modulus;
    let mut e: Int = exp;

    while e > 0 {
        if e % 2 == 1 {
            res = (res * b) % modulus;
        }
        b = (b * b) % modulus;
        e = e / 2;
    }
    return res;
}

pub type ModExpGate = struct {
    control_qubit: Int,
    multiplier: Int // a^(2^k) mod N
};

pub fn order_finding_modular_powers(cfg: &OrderFindingConfig) -> List[ModExpGate] {
    let mut list: List[ModExpGate] = list_new();
    let n_count: Int = cfg.counting_qubits;
    let a: Int = cfg.base_a;
    let n: Int = cfg.modulus_n;

    let mut k: Int = 0;
    let mut power_of_two: Int = 1;
    while k < n_count {
        let mult: Int = mod_pow(a, power_of_two, n);
        let gate: ModExpGate = ModExpGate {
            control_qubit: k,
            multiplier: mult
        };
        list_push(list, gate);
        power_of_two = power_of_two * 2;
        k = k + 1;
    }
    return list;
}

pub fn order_finding_verify_order(a: Int, r: Int, n: Int) -> Int {
    if r <= 0 {
        return 0;
    }
    let res: Int = mod_pow(a, r, n);
    if res == 1 {
        return 1;
    }
    return 0;
}
