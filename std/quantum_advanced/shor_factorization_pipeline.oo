// # Shor's Integer Factorization Pipeline
//
// Logline: Coordinates end-to-end quantum integer factorization, preprocessing classical GCD checks, and extracting non-trivial factors from period r.
//
// Setup: Master pipeline orchestrating quantum order finding and classical number-theoretic post-processing.
//
// Beats:
//   1. Perform classical coprimality checks and handle trivial even/composite cases.
//   2. Validate period conditions: $r$ must be even and $a^{r/2} \not\equiv -1 \pmod N$.
//   3. Compute non-trivial factors $p = \gcd(a^{r/2} - 1, N)$ and $q = \gcd(a^{r/2} + 1, N)$.

pub type FactorizationResult = struct {
    modulus_n: Int,
    base_a: Int,
    period_r: Int,
    factor_1: Int,
    factor_2: Int,
    success: Int,
};

pub fn shor_gcd(a_in: Int, b_in: Int) -> Int {
    let mut a: Int = if a_in < 0 { 0 - a_in } else { a_in };
    let mut b: Int = if b_in < 0 { 0 - b_in } else { b_in };
    while b != 0 {
        let t: Int = b;
        b = a % b;
        a = t;
    }
    return a;
}

pub fn shor_mod_pow(base: Int, exp: Int, modulus: Int) -> Int {
    let mut res: Int = 1;
    let mut b: Int = base % modulus;
    let mut e: Int = exp;
    while e > 0 {
        if e % 2 == 1 {
            res = (res * b) % modulus;
        }
        b = (b * b) % modulus;
        e = e / 2;
    }
    return res;
}

pub fn shor_try_factor_from_order(n: Int, a: Int, r: Int) -> FactorizationResult {
    // Check 1: period r must be even
    if r % 2 != 0 {
        return FactorizationResult {
            modulus_n: n,
            base_a: a,
            period_r: r,
            factor_1: 1,
            factor_2: n,
            success: 0,
        };
    }

    // Check 2: a^(r/2) mod N
    let half_r: Int = r / 2;
    let a_half: Int = shor_mod_pow(a, half_r, n);

    // If a^(r/2) == N - 1 (i.e. -1 mod N), failure
    if a_half == (n - 1) {
        return FactorizationResult {
            modulus_n: n,
            base_a: a,
            period_r: r,
            factor_1: 1,
            factor_2: n,
            success: 0,
        };
    }

    // Factor 1 = gcd(a^(r/2) - 1, N)
    let term1: Int = if a_half > 0 { a_half - 1 } else { n - 1 };
    let f1: Int = shor_gcd(term1, n);

    // Factor 2 = gcd(a^(r/2) + 1, N)
    let term2: Int = a_half + 1;
    let f2: Int = shor_gcd(term2, n);

    let is_valid_f1: Int = if f1 > 1 && f1 < n { 1 } else { 0 };
    let is_valid_f2: Int = if f2 > 1 && f2 < n { 1 } else { 0 };

    if is_valid_f1 == 1 || is_valid_f2 == 1 {
        let final_f1: Int = if is_valid_f1 == 1 { f1 } else { f2 };
        let final_f2: Int = n / final_f1;
        return FactorizationResult {
            modulus_n: n,
            base_a: a,
            period_r: r,
            factor_1: final_f1,
            factor_2: final_f2,
            success: 1,
        };
    }

    return FactorizationResult {
        modulus_n: n,
        base_a: a,
        period_r: r,
        factor_1: 1,
        factor_2: n,
        success: 0,
    };
}

pub fn shor_classical_precheck(n: Int) -> FactorizationResult {
    // If N is even
    if n % 2 == 0 {
        return FactorizationResult {
            modulus_n: n,
            base_a: 2,
            period_r: 1,
            factor_1: 2,
            factor_2: n / 2,
            success: 1,
        };
    }
    return FactorizationResult {
        modulus_n: n,
        base_a: 0,
        period_r: 0,
        factor_1: 1,
        factor_2: n,
        success: 0,
    };
}
