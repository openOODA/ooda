// # Quantum Reversible Modular Multiplier
//
// Logline: Synthesizes reversible shift-and-add quantum circuits for modular multiplication |x>|0> -> |x>|ax mod N> and uncomputations.
//
// Setup: High-level reversible arithmetic engine powering Shor's modular exponentiation sequences.
//
// Beats:
//   1. Configure modular multiplier parameters (constant multiplier $a$, modulus $N$, register width $n$).
//   2. Generate controlled shift-and-add gate sequences.
//   3. Compute circuit depth, Toffoli count, ancilla allocations, and uncomputation schedules.

pub type ModularMultiplierConfig = struct {
    multiplier_a: Int,
    modulus_n: Int,
    register_width: Int,
    num_ancillae: Int,
};

pub fn modular_multiplier_config_new(a: Int, n: Int, width: Int) -> ModularMultiplierConfig {
    return ModularMultiplierConfig {
        multiplier_a: a % n,
        modulus_n: n,
        register_width: width,
        num_ancillae: width + 2,
    };
}

pub type MultiplierResourceEstimate = struct {
    num_toffoli_gates: Int,
    num_cnot_gates: Int,
    total_circuit_depth: Int,
    total_qubits_required: Int,
};

pub fn modular_multiplier_estimate_resources(cfg: &ModularMultiplierConfig) -> MultiplierResourceEstimate {
    let n: Int = cfg.register_width;
    // Standard shift-and-add modular multiplier uses ~ 2 * n modular additions
    // Each n-bit modular addition uses ~ 4 * n Toffoli gates and ~ 6 * n CNOTs
    let toffolis: Int = 8 * n * n;
    let cnots: Int = 12 * n * n;
    let depth: Int = 20 * n * n;
    let total_q: Int = (2 * n) + cfg.num_ancillae;

    return MultiplierResourceEstimate {
        num_toffoli_gates: toffolis,
        num_cnot_gates: cnots,
        total_circuit_depth: depth,
        total_qubits_required: total_q,
    };
}

pub type ShiftAddStage = struct {
    bit_index: Int,
    shifted_constant: Int,
};

pub fn modular_multiplier_get_stages(cfg: &ModularMultiplierConfig) -> List[ShiftAddStage] {
    let mut stages: List[ShiftAddStage] = list_new();
    let n_bits: Int = cfg.register_width;
    let a: Int = cfg.multiplier_a;
    let modulus: Int = cfg.modulus_n;

    let mut i: Int = 0;
    let mut shift_val: Int = a;
    while i < n_bits {
        let stage: ShiftAddStage = ShiftAddStage {
            bit_index: i,
            shifted_constant: shift_val,
        };
        list_push(stages, stage);
        shift_val = (shift_val * 2) % modulus;
        i = i + 1;
    }

    return stages;
}
