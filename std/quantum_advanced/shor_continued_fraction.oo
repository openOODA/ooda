// # Continued Fraction Period Extraction for Shor's Algorithm
//
// Logline: Converts measured quantum phase fractions into irreducible rational convergents p/q to recover period r.
//
// Setup: Classical post-processing step executing Euclid's continued fraction expansion on measured phase estimates.
//
// Beats:
//   1. Expand rational phase approximation $\frac{x}{2^t}$ into continued fraction partial quotients $[a_0, a_1, a_2, \dots]$.
//   2. Compute successive rational convergents $p_k / q_k$ via 3-term recurrence relations.
//   3. Filter candidate denominators $q_k < N$ and verify order conditions $a^{q_k} \equiv 1 \pmod N$.

pub type FractionConvergent = struct {
    p_numerator: Int,
    q_denominator: Int
};

pub type ContinuedFractionResult = struct {
    num_convergents: Int,
    convergents: List[FractionConvergent]
};

pub fn gcd(a_in: Int, b_in: Int) -> Int {
    let mut a: Int = if a_in < 0 { 0 - a_in } else { a_in };
    let mut b: Int = if b_in < 0 { 0 - b_in } else { b_in };
    while b != 0 {
        let t: Int = b;
        b = a % b;
        a = t;
    }
    return a;
}

pub fn continued_fraction_expand(
    measured_numerator: Int,
    denominator_power: Int,
    max_denominator: Int
) -> ContinuedFractionResult {
    let mut conv_list: List[FractionConvergent] = list_new();

    let mut num: Int = measured_numerator;
    let mut den: Int = denominator_power;

    let mut p0: Int = 0;
    let mut p1: Int = 1;
    let mut q0: Int = 1;
    let mut q1: Int = 0;

    let mut count: Int = 0;
    let mut iterations: Int = 0;

    while den > 0 && iterations < 30 {
        let a_k: Int = num / den;
        let rem: Int = num % den;

        let pk: Int = (a_k * p1) + p0;
        let qk: Int = (a_k * q1) + q0;

        if qk > max_denominator && count > 0 {
            // Stop if denominator exceeds modulus N
            den = 0;
        } else {
            let conv: FractionConvergent = FractionConvergent {
                p_numerator: pk,
                q_denominator: qk
            };
            list_push(conv_list, conv);
            count = count + 1;

            p0 = p1;
            p1 = pk;
            q0 = q1;
            q1 = qk;

            num = den;
            den = rem;
        }
        iterations = iterations + 1;
    }

    return ContinuedFractionResult {
        num_convergents: count,
        convergents: conv_list
    };
}

pub fn find_candidate_period(
    result: &ContinuedFractionResult,
    base_a: Int,
    modulus_n: Int
) -> Int {
    let n_conv: Int = result.num_convergents;
    let list: List[FractionConvergent] = result.convergents;

    let mut i: Int = 0;
    while i < n_conv {
        let c: FractionConvergent = list_get(list, i);
        let r_cand: Int = c.q_denominator;
        if r_cand > 0 && r_cand < modulus_n {
            // Verify if candidate r satisfies a^r == 1 mod N
            let mut pow_val: Int = 1;
            let mut b: Int = base_a % modulus_n;
            let mut e: Int = r_cand;
            while e > 0 {
                if e % 2 == 1 {
                    pow_val = (pow_val * b) % modulus_n;
                }
                b = (b * b) % modulus_n;
                e = e / 2;
            }
            if pow_val == 1 {
                return r_cand;
            }
        }
        i = i + 1;
    }
    return 0; // Period not found in convergents
}
