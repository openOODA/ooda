// # VQE Hardware-Efficient Ansatz (HEA)
//
// Logline: Constructs parameterized hardware-efficient trial wavefunctions with single-qubit rotations and entangling layers.
//
// Setup: Parameterized quantum circuit representation optimized for NISQ architectures and depth-constrained QPUs.
//
// Beats:
//   1. Configure HEA depth layers, entanglement topologies (linear, circular, full), and 2-qubit entanglers.
//   2. Compute parameter index mappings for alternating Ry(theta) and Rz(phi) rotation blocks.
//   3. Generate parameterized gate descriptors and trial state expectation circuits.

pub type EntanglementType = struct {
    mode: Int, // 0: Linear, 1: Circular, 2: AllToAll
};

pub fn entangle_linear() -> EntanglementType { return EntanglementType { mode: 0 }; }
pub fn entangle_circular() -> EntanglementType { return EntanglementType { mode: 1 }; }
pub fn entangle_all_to_all() -> EntanglementType { return EntanglementType { mode: 2 }; }

pub type HeaConfig = struct {
    num_qubits: Int,
    num_layers: Int,
    entanglement: EntanglementType,
    use_cz_gate: Int, // 1 for CZ, 0 for CX
    total_params: Int,
};

pub fn hea_config_new(num_qubits: Int, num_layers: Int, ent_type: EntanglementType, use_cz: Int) -> HeaConfig {
    let params_per_layer: Int = num_qubits * 2;
    let total: Int = (num_layers + 1) * params_per_layer;
    return HeaConfig {
        num_qubits: num_qubits,
        num_layers: num_layers,
        entanglement: ent_type,
        use_cz_gate: use_cz,
        total_params: total,
    };
}

pub fn hea_get_param_count(cfg: &HeaConfig) -> Int {
    return cfg.total_params;
}

pub fn hea_get_param_index(cfg: &HeaConfig, layer: Int, qubit: Int, is_rz: Int) -> Int {
    let n_q: Int = cfg.num_qubits;
    let base: Int = layer * (n_q * 2);
    let offset: Int = (qubit * 2) + is_rz;
    return base + offset;
}

pub type EntanglementPair = struct {
    control: Int,
    target: Int,
};

pub fn hea_get_entangling_pairs(cfg: &HeaConfig) -> List[EntanglementPair] {
    let mut pairs: List[EntanglementPair] = list_new();
    let n_q: Int = cfg.num_qubits;
    let ent: EntanglementType = cfg.entanglement;
    let mode: Int = ent.mode;

    if mode == 0 {
        // Linear nearest-neighbor
        let mut i: Int = 0;
        let limit: Int = n_q - 1;
        while i < limit {
            let p: EntanglementPair = EntanglementPair { control: i, target: i + 1 };
            list_push(pairs, p);
            i = i + 1;
        }
    } else if mode == 1 {
        // Circular / Periodic
        let mut i: Int = 0;
        let limit: Int = n_q - 1;
        while i < limit {
            let p: EntanglementPair = EntanglementPair { control: i, target: i + 1 };
            list_push(pairs, p);
            i = i + 1;
        }
        if n_q > 2 {
            let p_last: EntanglementPair = EntanglementPair { control: n_q - 1, target: 0 };
            list_push(pairs, p_last);
        }
    } else {
        // All-to-all
        let mut i: Int = 0;
        while i < n_q {
            let mut j: Int = i + 1;
            while j < n_q {
                let p: EntanglementPair = EntanglementPair { control: i, target: j };
                list_push(pairs, p);
                j = j + 1;
            }
            i = i + 1;
        }
    }
    return pairs;
}

pub fn hea_initial_parameters(cfg: &HeaConfig, initial_val: Float) -> List[Float] {
    let total: Int = cfg.total_params;
    let mut params: List[Float] = list_new();
    let mut i: Int = 0;
    while i < total {
        list_push(params, initial_val);
        i = i + 1;
    }
    return params;
}
