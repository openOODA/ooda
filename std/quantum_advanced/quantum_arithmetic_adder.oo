// # Quantum Arithmetic Adders & Modular Adders
//
// Logline: Implements Draper QFT-based phase adders and Cuccaro ripple-carry reversible addition circuits.
//
// Setup: Core arithmetic primitives for quantum modular exponentiation and reversible numerical computing.
//
// Beats:
//   1. Generate Draper QFT phase addition phase angle schedules $\Delta \phi = 2\pi b / 2^{k}$.
//   2. Construct Cuccaro Majority (MAJ) and 2-qubit Unmajority-and-Add (UMA) reversible blocks.
//   3. Build controlled modular addition circuits $(a + b) \pmod N$ with overflow ancilla.

pub type AdderType = struct {
    mode: Int // 0: DraperQFT, 1: CuccaroRippleCarry
};

pub fn adder_draper_qft() -> AdderType { return AdderType { mode: 0 }; }
pub fn adder_cuccaro() -> AdderType { return AdderType { mode: 1 }; }

pub type PhaseRotationStep = struct {
    target_qubit: Int,
    control_qubit: Int,
    phase_radians: Float
};

pub type DraperAdderSchedule = struct {
    num_qubits: Int,
    rotations: List[PhaseRotationStep]
};

pub fn draper_phase_angle(k: Int) -> Float {
    // 2 * pi / 2^k
    let mut denom: Float = 1.0;
    let mut i: Int = 0;
    while i < k {
        denom = denom * 2.0;
        i = i + 1;
    }
    return 6.283185307179586 / denom;
}

pub fn draper_adder_generate(num_qubits: Int) -> DraperAdderSchedule {
    let mut steps: List[PhaseRotationStep] = list_new();

    let mut j: Int = 0;
    while j < num_qubits {
        let mut i: Int = 0;
        while i <= j {
            let k: Int = (j - i) + 1;
            let angle: Float = draper_phase_angle(k);
            let rot: PhaseRotationStep = PhaseRotationStep {
                target_qubit: j,
                control_qubit: i,
                phase_radians: angle
            };
            list_push(steps, rot);
            i = i + 1;
        }
        j = j + 1;
    }

    return DraperAdderSchedule {
        num_qubits: num_qubits,
        rotations: steps
    };
}

pub type CuccaroGate = struct {
    gate_type: Int, // 0: CNOT, 1: TOFFOLI, 2: X
    qubit_1: Int,
    qubit_2: Int,
    qubit_3: Int
};

pub type CuccaroAdderCircuit = struct {
    num_bits: Int,
    gates: List[CuccaroGate]
};

pub fn cuccaro_adder_generate(n_bits: Int) -> CuccaroAdderCircuit {
    let mut gates: List[CuccaroGate] = list_new();

    // Forward MAJ ladder: MAJ(cin, b[i], a[i])
    let mut i: Int = 0;
    while i < n_bits {
        let g1: CuccaroGate = CuccaroGate { gate_type: 0, qubit_1: i, qubit_2: i + 1, qubit_3: 0 };
        let g2: CuccaroGate = CuccaroGate { gate_type: 0, qubit_1: i, qubit_2: i + 2, qubit_3: 0 };
        let g3: CuccaroGate = CuccaroGate { gate_type: 1, qubit_1: i + 1, qubit_2: i + 2, qubit_3: i };
        list_push(gates, g1);
        list_push(gates, g2);
        list_push(gates, g3);
        i = i + 1;
    }

    return CuccaroAdderCircuit {
        num_bits: n_bits,
        gates: gates
    };
}
