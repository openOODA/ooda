// # Exact Quantum Fourier Transform (QFT) Circuit Generator
//
// Logline: Synthesizes exact n-qubit Quantum Fourier Transform and Inverse QFT circuits with parameterized controlled phase rotations and SWAP layers.
//
// Setup: Canonical frequency-domain transform mapping $|j\rangle \to \frac{1}{\sqrt{N}} \sum_{k=0}^{N-1} e^{2\pi i j k / N} |k\rangle$.
//
// Beats:
//   1. Build forward n-qubit QFT ladder with Hadamards and controlled-$R_k$ phase gates.
//   2. Generate bit-reversal SWAP network across symmetric qubit pairs.
//   3. Synthesize exact Inverse QFT circuits with inverted phase rotation angles $-\theta$.

pub type QftGate = struct {
    gate_type: Int, // 0: H, 1: CR_k, 2: SWAP
    target: Int,
    control: Int,
    phase_radians: Float,
};

pub type QftCircuit = struct {
    num_qubits: Int,
    is_inverse: Int,
    gates: List[QftGate],
};

pub fn qft_calc_angle(k: Int, is_inv: Int) -> Float {
    let mut denom: Float = 1.0;
    let mut i: Int = 0;
    while i < k {
        denom = denom * 2.0;
        i = i + 1;
    }
    let base_angle: Float = 6.283185307179586 / denom;
    if is_inv == 1 {
        return 0.0 - base_angle;
    }
    return base_angle;
}

pub fn qft_circuit_new(num_qubits: Int, is_inverse: Int) -> QftCircuit {
    let mut gates: List[QftGate] = list_new();

    if is_inverse == 0 {
        // Forward QFT
        let mut i: Int = 0;
        while i < num_qubits {
            // Hadamard on qubit i
            let h_gate: QftGate = QftGate { gate_type: 0, target: i, control: 0, phase_radians: 0.0 };
            list_push(gates, h_gate);

            // Controlled phase rotations from subsequent qubits
            let mut j: Int = i + 1;
            while j < num_qubits {
                let k: Int = (j - i) + 1;
                let angle: Float = qft_calc_angle(k, 0);
                let cr_gate: QftGate = QftGate { gate_type: 1, target: i, control: j, phase_radians: angle };
                list_push(gates, cr_gate);
                j = j + 1;
            }
            i = i + 1;
        }

        // SWAP layer
        let mut s: Int = 0;
        let half: Int = num_qubits / 2;
        while s < half {
            let swap_gate: QftGate = QftGate {
                gate_type: 2,
                target: s,
                control: (num_qubits - 1) - s,
                phase_radians: 0.0,
            };
            list_push(gates, swap_gate);
            s = s + 1;
        }
    } else {
        // Inverse QFT: SWAP layer first
        let mut s: Int = 0;
        let half: Int = num_qubits / 2;
        while s < half {
            let swap_gate: QftGate = QftGate {
                gate_type: 2,
                target: s,
                control: (num_qubits - 1) - s,
                phase_radians: 0.0,
            };
            list_push(gates, swap_gate);
            s = s + 1;
        }

        // Reverse ladder
        let mut i: Int = num_qubits - 1;
        while i >= 0 {
            let mut j: Int = num_qubits - 1;
            while j > i {
                let k: Int = (j - i) + 1;
                let angle: Float = qft_calc_angle(k, 1);
                let cr_gate: QftGate = QftGate { gate_type: 1, target: i, control: j, phase_radians: angle };
                list_push(gates, cr_gate);
                j = j - 1;
            }

            let h_gate: QftGate = QftGate { gate_type: 0, target: i, control: 0, phase_radians: 0.0 };
            list_push(gates, h_gate);
            i = i - 1;
        }
    }

    return QftCircuit {
        num_qubits: num_qubits,
        is_inverse: is_inverse,
        gates: gates,
    };
}

pub fn qft_gate_count(circ: &QftCircuit) -> Int {
    let gates_list: List[QftGate] = circ.gates;
    return list_len(gates_list);
}
