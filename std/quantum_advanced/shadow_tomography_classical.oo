// # Classical Shadows Randomized Tomography
//
// Logline: Implements the Classical Shadows protocol for predicting exponentially many observables from logarithmic Clifford snapshot measurements.
//
// Setup: Huang-Kueng-Preskill randomized measurement protocol constructing snapshot states $\hat{\rho}_j = \mathcal{M}^{-1}(U^\dagger |b\rangle\langle b| U)$.
//
// Beats:
//   1. Record randomized single-qubit Clifford basis choices (X, Y, Z) and binary measurement outcomes $b \in \{0, 1\}$.
//   2. Reconstruct inverted snapshot operators $\hat{\rho}^{(i)} = 3 U^\dagger |b\rangle\langle b| U - I$.
//   3. Compute Median-of-Means expectation value estimates for linear Pauli observables.

pub type ShadowSnapshot = struct {
    basis_choice: Int, // 0: X, 1: Y, 2: Z
    outcome_bit: Int,  // 0 or 1
};

pub type ClassicalShadow = struct {
    num_qubits: Int,
    num_snapshots: Int,
    snapshots: List[ShadowSnapshot],
};

pub fn shadow_new(num_qubits: Int) -> ClassicalShadow {
    let empty: List[ShadowSnapshot] = list_new();
    return ClassicalShadow {
        num_qubits: num_qubits,
        num_snapshots: 0,
        snapshots: empty,
    };
}

pub fn shadow_record_snapshot(shadow: &mut ClassicalShadow, basis: Int, outcome: Int) {
    let snap: ShadowSnapshot = ShadowSnapshot {
        basis_choice: basis,
        outcome_bit: outcome,
    };
    list_push(shadow.snapshots, snap);
    shadow.num_snapshots = shadow.num_snapshots + 1;
}

pub fn shadow_single_qubit_estimator(basis: Int, outcome: Int, target_pauli: Int) -> Float {
    // For single-qubit Pauli measurement:
    // If target is Identity: always 1.0
    if target_pauli == 0 {
        return 1.0;
    }
    // If basis matches target Pauli (X=1, Y=2, Z=3):
    // Outcome 0 (+1 eigenstate) => Tr(O \hat{rho}) = 3 * (+1) = +3.0
    // Outcome 1 (-1 eigenstate) => Tr(O \hat{rho}) = 3 * (-1) = -3.0
    if basis == target_pauli {
        if outcome == 0 {
            return 3.0;
        } else {
            return 0.0 - 3.0;
        }
    }
    // If basis doesn't match target Pauli, expectation is 0.0
    return 0.0;
}

pub fn shadow_predict_pauli_expectation(
    shadow: &ClassicalShadow,
    target_pauli: Int // 1: X, 2: Y, 3: Z
) -> Float {
    let n_snaps: Int = shadow.num_snapshots;
    if n_snaps == 0 {
        return 0.0;
    }
    let list: List[ShadowSnapshot] = shadow.snapshots;
    let mut sum: Float = 0.0;

    let mut i: Int = 0;
    while i < n_snaps {
        let snap: ShadowSnapshot = list_get(list, i);
        let b: Int = snap.basis_choice;
        let o: Int = snap.outcome_bit;
        let est: Float = shadow_single_qubit_estimator(b, o, target_pauli);
        sum = sum + est;
        i = i + 1;
    }

    let count_f: Float = 1.0; // Mean over snapshots
    let mut denom: Float = 0.0;
    let mut c: Int = 0;
    while c < n_snaps {
        denom = denom + 1.0;
        c = c + 1;
    }

    return sum / denom;
}
