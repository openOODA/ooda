// # Discrete-Time Coined Quantum Walk
//
// Logline: Simulates discrete coined quantum walks on discrete 1D lattices demonstrating ballistic quantum propagation ($\sigma \propto t$).
//
// Setup: Composite Hilbert space $\mathcal{H}_C \otimes \mathcal{H}_P$ evolving under alternating coin rotation and conditional position shift operators.
//
// Beats:
//   1. Configure 1D lattice size $N$, coin state $|c\rangle \in \{|0\rangle, |1\rangle\}$, and position register.
//   2. Apply Hadamard/Grover coin operator $C = H \otimes I$ to mix coin directions.
//   3. Execute conditional position shift $S = |0\rangle\langle 0| \otimes \sum |x+1\rangle\langle x| + |1\rangle\langle 1| \otimes \sum |x-1\rangle\langle x|$.

pub type WalkCoinState = struct {
    amp_left_real: Float,
    amp_left_imag: Float,
    amp_right_real: Float,
    amp_right_imag: Float
};

pub type CoinedWalk1D = struct {
    num_positions: Int,
    origin_index: Int,
    current_step: Int,
    // Flattened real/imag amplitudes per site: (left_re, left_im, right_re, right_im)
    amplitudes: List[Float]
};

pub fn walk_coin_state_hadamard(coin: &WalkCoinState) -> WalkCoinState {
    // Hadamard matrix: 1/sqrt(2) * [1, 1; 1, -1]
    let isqrt2: Float = 0.7071067811865475;
    let l_r: Float = coin.amp_left_real;
    let l_i: Float = coin.amp_left_imag;
    let r_r: Float = coin.amp_right_real;
    let r_i: Float = coin.amp_right_imag;

    let new_l_r: Float = isqrt2 * (l_r + r_r);
    let new_l_i: Float = isqrt2 * (l_i + r_i);
    let new_r_r: Float = isqrt2 * (l_r - r_r);
    let new_r_i: Float = isqrt2 * (l_i - r_i);

    return WalkCoinState {
        amp_left_real: new_l_r,
        amp_left_imag: new_l_i,
        amp_right_real: new_r_r,
        amp_right_imag: new_r_i
    };
}

pub fn coined_walk_init(size: Int) -> CoinedWalk1D {
    let mut amps: List[Float] = list_new();
    let total_elements: Int = size * 4;
    let mid: Int = size / 2;

    let mut i: Int = 0;
    while i < size {
        if i == mid {
            // Initial state: 1/sqrt(2) (|L> + i |R>)
            let isqrt2: Float = 0.7071067811865475;
            list_push(amps, isqrt2); // Left real
            list_push(amps, 0.0);    // Left imag
            list_push(amps, 0.0);    // Right real
            list_push(amps, isqrt2); // Right imag
        } else {
            list_push(amps, 0.0);
            list_push(amps, 0.0);
            list_push(amps, 0.0);
            list_push(amps, 0.0);
        }
        i = i + 1;
    }

    return CoinedWalk1D {
        num_positions: size,
        origin_index: mid,
        current_step: 0,
        amplitudes: amps
    };
}

pub fn coined_walk_probability_at_site(walk: &CoinedWalk1D, site: Int) -> Float {
    let base: Int = site * 4;
    let list: List[Float] = walk.amplitudes;
    let lr: Float = list_get(list, base);
    let li: Float = list_get(list, base + 1);
    let rr: Float = list_get(list, base + 2);
    let ri: Float = list_get(list, base + 3);

    let p_left: Float = (lr * lr) + (li * li);
    let p_right: Float = (rr * rr) + (ri * ri);
    return p_left + p_right;
}
