// # Quantum Crosstalk Mitigation & Dynamical Decoupling (DD)
//
// Logline: Suppresses ZZ crosstalk and dephasing on spectator idle qubits via CPMG and XY4 dynamical decoupling refocusing pulse sequences.
//
// Setup: Crosstalk-aware scheduler inserting symmetric $\pi$-pulse trains into idle intervals to extend effective coherence times $T_2$.
//
// Beats:
//   1. Configure Dynamical Decoupling pulse sequences (Hahn Echo, CPMG-2, XY4, XY8).
//   2. Calculate pulse spacing offsets $\tau$ for symmetric idle interval padding.
//   3. Mitigate static parasitic $ZZ$ coupling phase accumulation $\theta_{ZZ} = \zeta_{ZZ} \cdot t_{idle}$.

pub type DdSequenceType = struct {
    mode: Int, // 0: HahnEcho, 1: CPMG, 2: XY4, 3: XY8
};

pub fn dd_hahn_echo() -> DdSequenceType { return DdSequenceType { mode: 0 }; }
pub fn dd_cpmg() -> DdSequenceType { return DdSequenceType { mode: 1 }; }
pub fn dd_xy4() -> DdSequenceType { return DdSequenceType { mode: 2 }; }
pub fn dd_xy8() -> DdSequenceType { return DdSequenceType { mode: 3 }; }

pub type DdPulse = struct {
    axis_code: Int, // 1: X_pi, 2: Y_pi
    time_offset_ns: Float,
};

pub type DdSchedule = struct {
    qubit_id: Int,
    idle_duration_ns: Float,
    sequence: DdSequenceType,
    num_pulses: Int,
    pulses: List[DdPulse],
};

pub fn dd_generate_xy4_schedule(qubit: Int, total_idle_ns: Float) -> DdSchedule {
    let mut pulse_list: List[DdPulse] = list_new();
    // XY4 places 4 pulses at t = 1/8, 3/8, 5/8, 7/8 of the idle window
    // Pulses: X, Y, X, Y
    let dt: Float = total_idle_ns / 8.0;

    let p1: DdPulse = DdPulse { axis_code: 1, time_offset_ns: 1.0 * dt };
    let p2: DdPulse = DdPulse { axis_code: 2, time_offset_ns: 3.0 * dt };
    let p3: DdPulse = DdPulse { axis_code: 1, time_offset_ns: 5.0 * dt };
    let p4: DdPulse = DdPulse { axis_code: 2, time_offset_ns: 7.0 * dt };

    list_push(pulse_list, p1);
    list_push(pulse_list, p2);
    list_push(pulse_list, p3);
    list_push(pulse_list, p4);

    return DdSchedule {
        qubit_id: qubit,
        idle_duration_ns: total_idle_ns,
        sequence: dd_xy4(),
        num_pulses: 4,
        pulses: pulse_list,
    };
}

pub fn crosstalk_zz_phase_accumulation(zz_coupling_khz: Float, duration_ns: Float) -> Float {
    // Phase phi = 2 * pi * (zeta_ZZ in GHz) * (duration in ns)
    let freq_ghz: Float = zz_coupling_khz * 0.000001;
    return 6.283185307179586 * (freq_ghz * duration_ns);
}
