// # Surface Code Lattice Surgery Operations
//
// Logline: Implements topological lattice surgery primitives including patch merges, splits, twist defects, and multi-patch logical CNOTs.
//
// Setup: Fault-tolerant 2D routing fabric manipulating logical surface code boundaries without physical qubit transport.
//
// Beats:
//   1. Configure planar patch coordinates, boundary types (smooth X vs rough Z), and ancilla routing channels.
//   2. Model joint parity measurement operations (Rough Merge for logical $Z \otimes Z$ and Smooth Merge for $X \otimes X$).
//   3. Execute fault-tolerant logical CNOT gate protocol across separated patches via routing ancilla patches.

pub type BoundaryType = struct {
    mode: Int, // 0: Rough (Z-type), 1: Smooth (X-type)
};

pub fn boundary_rough() -> BoundaryType { return BoundaryType { mode: 0 }; }
pub fn boundary_smooth() -> BoundaryType { return BoundaryType { mode: 1 }; }

pub type SurfacePatch = struct {
    patch_id: Int,
    origin_x: Int,
    origin_y: Int,
    distance_d: Int,
    is_active: Int,
};

pub fn surface_patch_new(id: Int, ox: Int, oy: Int, d: Int) -> SurfacePatch {
    return SurfacePatch {
        patch_id: id,
        origin_x: ox,
        origin_y: oy,
        distance_d: d,
        is_active: 1,
    };
}

pub type SurgeryOperation = struct {
    op_type: Int, // 0: RoughMerge (ZZ), 1: SmoothMerge (XX), 2: Split, 3: Twist
    patch_control: Int,
    patch_target: Int,
    ancilla_patch: Int,
    duration_cycles: Int, // Number of measurement syndrome rounds (typically d rounds)
};

pub fn surgery_merge_zz(p1: Int, p2: Int, d: Int) -> SurgeryOperation {
    return SurgeryOperation {
        op_type: 0,
        patch_control: p1,
        patch_target: p2,
        ancilla_patch: 0 - 1,
        duration_cycles: d,
    };
}

pub fn surgery_merge_xx(p1: Int, p2: Int, d: Int) -> SurgeryOperation {
    return SurgeryOperation {
        op_type: 1,
        patch_control: p1,
        patch_target: p2,
        ancilla_patch: 0 - 1,
        duration_cycles: d,
    };
}

pub fn surgery_logical_cnot_sequence(
    control_id: Int,
    target_id: Int,
    ancilla_id: Int,
    distance: Int
) -> List[SurgeryOperation] {
    let mut seq: List[SurgeryOperation] = list_new();

    // Step 1: Initialize ancilla patch in |+>
    // Step 2: Smooth merge (XX) between target and ancilla
    let op1: SurgeryOperation = SurgeryOperation {
        op_type: 1,
        patch_control: target_id,
        patch_target: ancilla_id,
        ancilla_patch: 0 - 1,
        duration_cycles: distance,
    };
    list_push(seq, op1);

    // Step 3: Rough merge (ZZ) between control and ancilla
    let op2: SurgeryOperation = SurgeryOperation {
        op_type: 0,
        patch_control: control_id,
        patch_target: ancilla_id,
        ancilla_patch: 0 - 1,
        duration_cycles: distance,
    };
    list_push(seq, op2);

    // Step 4: Split ancilla and measure out in X basis
    let op3: SurgeryOperation = SurgeryOperation {
        op_type: 2,
        patch_control: ancilla_id,
        patch_target: 0 - 1,
        ancilla_patch: 0 - 1,
        duration_cycles: 1,
    };
    list_push(seq, op3);

    return seq;
}
