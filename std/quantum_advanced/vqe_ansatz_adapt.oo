// # ADAPT-VQE Adaptive Ansatz Synthesis
//
// Logline: Implements the ADAPT-VQE algorithm for dynamically growing quantum ansatz circuits by iteratively appending operators with maximal energy gradients.
//
// Setup: Gradient-driven operator pool selection to minimize circuit depth in variational eigensolvers.
//
// Beats:
//   1. Define operator pool types (Fermionic, Qubit, Paired) and candidate pool entries.
//   2. Compute gradient-based operator ranking $\left|\langle \psi | [H, A_k] | \psi \rangle\right|$.
//   3. Manage iterative ansatz growth, threshold convergence checks, and parameter vectors.

pub type AdaptPoolType = struct {
    mode: Int // 0: FermionicSD, 1: QubitExcitation, 2: IndividualPauli
};

pub fn adapt_pool_fermionic() -> AdaptPoolType { return AdaptPoolType { mode: 0 }; }
pub fn adapt_pool_qubit() -> AdaptPoolType { return AdaptPoolType { mode: 1 }; }
pub fn adapt_pool_pauli() -> AdaptPoolType { return AdaptPoolType { mode: 2 }; }

pub type PoolOperator = struct {
    operator_id: Int,
    pool_type: AdaptPoolType,
    qubits_involved: Int,
    label_code: Int
};

pub type AdaptVqeState = struct {
    max_iterations: Int,
    gradient_threshold: Float,
    current_iteration: Int,
    converged: Int,
    selected_operator_ids: List[Int],
    parameters: List[Float],
    energy_history: List[Float],
    max_gradient_norm: Float
};

pub fn adapt_vqe_new(max_iter: Int, grad_tol: Float) -> AdaptVqeState {
    let empty_ids: List[Int] = list_new();
    let empty_params: List[Float] = list_new();
    let empty_energy: List[Float] = list_new();
    return AdaptVqeState {
        max_iterations: max_iter,
        gradient_threshold: grad_tol,
        current_iteration: 0,
        converged: 0,
        selected_operator_ids: empty_ids,
        parameters: empty_params,
        energy_history: empty_energy,
        max_gradient_norm: 1.0
    };
}

pub fn adapt_vqe_operator_count(state: &AdaptVqeState) -> Int {
    let ids: List[Int] = state.selected_operator_ids;
    return list_len(ids);
}

pub fn adapt_vqe_append_operator(state: &mut AdaptVqeState, op_id: Int, init_param: Float, current_energy: Float, max_grad: Float) {
    list_push(state.selected_operator_ids, op_id);
    list_push(state.parameters, init_param);
    list_push(state.energy_history, current_energy);
    state.current_iteration = state.current_iteration + 1;
    state.max_gradient_norm = max_grad;

    if max_grad < state.gradient_threshold {
        state.converged = 1;
    } else if state.current_iteration >= state.max_iterations {
        state.converged = 0;
    }
}

pub fn adapt_vqe_select_max_gradient(gradients: List[Float]) -> Int {
    let count: Int = list_len(gradients);
    if count == 0 {
        return 0 - 1;
    }
    let mut best_idx: Int = 0;
    let mut best_val: Float = 0.0;

    let mut i: Int = 0;
    while i < count {
        let g: Float = list_get(gradients, i);
        let abs_g: Float = if g < 0.0 { 0.0 - g } else { g };
        if abs_g > best_val {
            best_val = abs_g;
            best_idx = i;
        }
        i = i + 1;
    }
    return best_idx;
}

pub fn adapt_vqe_compute_gradient_norm(gradients: List[Float]) -> Float {
    let count: Int = list_len(gradients);
    let mut sum_sq: Float = 0.0;
    let mut i: Int = 0;
    while i < count {
        let g: Float = list_get(gradients, i);
        sum_sq = sum_sq + (g * g);
        i = i + 1;
    }
    if sum_sq <= 0.0 {
        return 0.0;
    }
    return sqrt(sum_sq);
}
