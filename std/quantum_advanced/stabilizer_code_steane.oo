// # [[7,1,3]] Steane CSS Quantum Error Correcting Code
//
// Logline: Implements the 7-qubit Steane CSS code with transversal Clifford operations and classical Hamming syndrome decoding.
//
// Setup: Canonical distance-3 CSS code correcting arbitrary single-qubit errors via dual 3-bit syndrome measurements.
//
// Beats:
//   1. Define 6 Steane stabilizer generators (3 X-type and 3 Z-type from [7,4,3] Hamming parity checks).
//   2. Compute transversal Clifford operations (logical Hadamard $H^{\otimes 7}$, Phase $S^{\dagger \otimes 7}$, and CNOT).
//   3. Implement syndrome decoding mapping 3-bit X/Z syndromes to error qubit locations.

pub type SteaneStabilizer = struct {
    is_x_type: Int, // 1 for X, 0 for Z
    q0: Int,
    q1: Int,
    q2: Int,
    q3: Int,
};

pub fn steane_get_stabilizers() -> List[SteaneStabilizer] {
    let mut stabs: List[SteaneStabilizer] = list_new();

    // 3 X-stabilizers (Hamming check rows)
    let x1: SteaneStabilizer = SteaneStabilizer { is_x_type: 1, q0: 3, q1: 4, q2: 5, q3: 6 };
    let x2: SteaneStabilizer = SteaneStabilizer { is_x_type: 1, q0: 1, q1: 2, q2: 5, q3: 6 };
    let x3: SteaneStabilizer = SteaneStabilizer { is_x_type: 1, q0: 0, q1: 2, q2: 4, q3: 6 };
    list_push(stabs, x1);
    list_push(stabs, x2);
    list_push(stabs, x3);

    // 3 Z-stabilizers
    let z1: SteaneStabilizer = SteaneStabilizer { is_x_type: 0, q0: 3, q1: 4, q2: 5, q3: 6 };
    let z2: SteaneStabilizer = SteaneStabilizer { is_x_type: 0, q0: 1, q1: 2, q2: 5, q3: 6 };
    let z3: SteaneStabilizer = SteaneStabilizer { is_x_type: 0, q0: 0, q1: 2, q2: 4, q3: 6 };
    list_push(stabs, z1);
    list_push(stabs, z2);
    list_push(stabs, z3);

    return stabs;
}

pub type SteaneSyndrome = struct {
    s0: Int,
    s1: Int,
    s2: Int,
};

pub fn steane_syndrome_to_error_location(syn: &SteaneSyndrome) -> Int {
    // Binary syndrome integer value: s0*4 + s1*2 + s2*1
    let val: Int = (syn.s0 * 4) + (syn.s1 * 2) + syn.s2;
    if val == 0 {
        return 0 - 1; // No error detected
    }
    // 1-indexed Hamming position maps to 0-indexed qubit: val - 1
    return val - 1;
}

pub type SteaneCorrection = struct {
    has_error: Int,
    error_qubit: Int,
    needs_x_correction: Int,
    needs_z_correction: Int,
};

pub fn steane_decode(z_syndrome: &SteaneSyndrome, x_syndrome: &SteaneSyndrome) -> SteaneCorrection {
    // Z-syndrome detects bit-flip (X error)
    let bit_flip_loc: Int = steane_syndrome_to_error_location(z_syndrome);
    // X-syndrome detects phase-flip (Z error)
    let phase_flip_loc: Int = steane_syndrome_to_error_location(x_syndrome);

    let has_x_err: Int = if bit_flip_loc >= 0 { 1 } else { 0 };
    let has_z_err: Int = if phase_flip_loc >= 0 { 1 } else { 0 };

    let mut target_q: Int = 0 - 1;
    if has_x_err == 1 {
        target_q = bit_flip_loc;
    } else if has_z_err == 1 {
        target_q = phase_flip_loc;
    }

    let any_err: Int = if has_x_err == 1 || has_z_err == 1 { 1 } else { 0 };

    return SteaneCorrection {
        has_error: any_err,
        error_qubit: target_q,
        needs_x_correction: has_x_err,
        needs_z_correction: has_z_err,
    };
}
