// # Quantum Counting Algorithm
//
// Logline: Combines Quantum Phase Estimation with Grover iteration operators to count marked database elements with quadratic speedup.
//
// Setup: Amplitude estimation framework estimating $M$ marked solutions out of search space $N = 2^n$.
//
// Beats:
//   1. Configure counting precision qubits $t$ and database search register $n$.
//   2. Extract Grover rotation eigenphase $\theta$ from measured QPE bitstrings.
//   3. Compute estimated solution count $M = N \sin^2(\theta / 2)$ and analytical error bounds.

pub type QuantumCountingConfig = struct {
    num_search_qubits: Int,   // n qubits => N = 2^n search space
    num_counting_qubits: Int, // t precision qubits
    search_space_size: Int,   // N = 2^n
};

pub fn int_pow2_qc(n: Int) -> Int {
    let mut res: Int = 1;
    let mut i: Int = 0;
    while i < n {
        res = res * 2;
        i = i + 1;
    }
    return res;
}

pub fn int_to_float_qc(n_int: Int) -> Float {
    let mut f: Float = 0.0;
    let mut i: Int = 0;
    let mut count: Int = n_int;
    if count < 0 {
        count = 0 - count;
    }
    while count >= 1000000 {
        f = f + 1000000.0;
        count = count - 1000000;
    }
    while count >= 1000 {
        f = f + 1000.0;
        count = count - 1000;
    }
    while count >= 100 {
        f = f + 100.0;
        count = count - 100;
    }
    while count >= 10 {
        f = f + 10.0;
        count = count - 10;
    }
    while i < count {
        f = f + 1.0;
        i = i + 1;
    }
    if n_int < 0 {
        return 0.0 - f;
    }
    return f;
}

pub fn quantum_counting_config_new(n_search: Int, t_count: Int) -> QuantumCountingConfig {
    let total_n: Int = int_pow2_qc(n_search);
    return QuantumCountingConfig {
        num_search_qubits: n_search,
        num_counting_qubits: t_count,
        search_space_size: total_n,
    };
}

pub type CountingResult = struct {
    measured_integer: Int,
    estimated_theta: Float,
    estimated_count_m: Float,
    relative_error_bound: Float,
};

pub fn quantum_counting_estimate(cfg: &QuantumCountingConfig, measured_int: Int) -> CountingResult {
    let t_bits: Int = cfg.num_counting_qubits;
    let two_to_t: Float = int_to_float_qc(int_pow2_qc(t_bits));
    let measured_f: Float = int_to_float_qc(measured_int);

    // Phase theta in [0, 2*pi]: theta = 2 * pi * (measured_int / 2^t)
    let phase_fraction: Float = measured_f / two_to_t;
    let theta: Float = 6.283185307179586 * phase_fraction;

    // Half angle theta / 2
    let half_theta: Float = theta * 0.5;
    let s: Float = sin(half_theta);
    let sin_sq: Float = s * s;

    // M = N * sin^2(theta / 2)
    let n_f: Float = int_to_float_qc(cfg.search_space_size);
    let m_est: Float = n_f * sin_sq;

    let bound: Float = 3.141592653589793 / two_to_t;

    return CountingResult {
        measured_integer: measured_int,
        estimated_theta: theta,
        estimated_count_m: m_est,
        relative_error_bound: bound,
    };
}

pub fn quantum_counting_optimum_iterations(m_estimate: Float, n_total: Int) -> Int {
    if m_estimate <= 0.0001 {
        return 1;
    }
    let n_f: Float = int_to_float_qc(n_total);
    let ratio: Float = n_f / m_estimate;
    let sqrt_ratio: Float = sqrt(ratio);
    let opt_float: Float = (3.141592653589793 / 4.0) * sqrt_ratio;
    let mut steps: Int = 1;
    let mut counter: Float = 1.0;
    while counter < opt_float {
        steps = steps + 1;
        counter = counter + 1.0;
    }
    return steps;
}
