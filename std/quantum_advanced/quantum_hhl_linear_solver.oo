// # Harrow-Hassidim-Lloyd (HHL) Quantum Linear Solver
//
// Logline: Implements the HHL algorithm for solving sparse linear systems of equations $A|x\rangle = |b\rangle$ with exponential speedup.
//
// Setup: Quantum linear algebra pipeline utilizing QPE, controlled reciprocal eigenvalue rotation, and clock uncomputation.
//
// Beats:
//   1. Configure HHL clock register width, matrix condition number $\kappa$, and eigenvalue scaling constant $C \le \lambda_{min}$.
//   2. Compute controlled ancilla rotation angles $\theta_j = \arcsin(C / \lambda_j)$ for reciprocal eigenvalue mapping.
//   3. Estimate post-selection success probability $P_{success} = \mathcal{O}(1/\kappa^2)$ and circuit depth scaling $\mathcal{O}(\kappa^2 s^2 \log(N)/\epsilon)$.

pub type HhlConfig = struct {
    num_clock_qubits: Int,
    matrix_dim: Int,
    condition_number_kappa: Float,
    c_scale_constant: Float,
};

pub fn hhl_config_new(clock_qubits: Int, dim: Int, kappa: Float, c_const: Float) -> HhlConfig {
    return HhlConfig {
        num_clock_qubits: clock_qubits,
        matrix_dim: dim,
        condition_number_kappa: kappa,
        c_scale_constant: c_const,
    };
}

pub type HhlRotationStep = struct {
    clock_integer_value: Int,
    eigenvalue_lambda: Float,
    rotation_angle_radians: Float,
};

pub fn math_asin_hhl(x: Float) -> Float {
    let clamped: Float = if x < 0.0 - 1.0 { 0.0 - 1.0 } else if x > 1.0 { 1.0 } else { x };
    let den: Float = 1.0 - (clamped * clamped);
    let sqrt_den: Float = if den > 0.0 { sqrt(den) } else { 0.0001 };
    // Taylor approximation near 0: asin(x) ~ x + x^3/6
    let x3: Float = clamped * clamped * clamped;
    return clamped + (x3 / 6.0);
}

pub fn hhl_compute_rotation_angle(c_scale: Float, lambda_val: Float) -> Float {
    if lambda_val <= 0.0001 {
        return 0.0;
    }
    let ratio: Float = c_scale / lambda_val;
    let clamped_ratio: Float = if ratio > 1.0 { 1.0 } else { ratio };
    let theta: Float = math_asin_hhl(clamped_ratio);
    return 2.0 * theta;
}

pub fn hhl_success_probability(c_scale: Float, lambda_max: Float) -> Float {
    if lambda_max <= 0.0001 {
        return 0.0;
    }
    let ratio: Float = c_scale / lambda_max;
    return ratio * ratio;
}
