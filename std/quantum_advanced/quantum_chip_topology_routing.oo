// # Hardware Chip Coupling Map & SWAP Routing
//
// Logline: Models physical qubit connectivity graphs (heavy-hex, square grid, linear) and computes shortest-path SWAP insertion chains.
//
// Setup: Hardware layout routing engine mapping logical two-qubit gates to hardware-constrained nearest-neighbor coupling topologies.
//
// Beats:
//   1. Configure coupling graphs for Linear, Square Grid, and Heavy-Hex layouts.
//   2. Compute all-pairs shortest paths and distance matrices across physical nodes.
//   3. Insert minimal SWAP gate sequences to route distant logical interaction pairs.

pub type ChipTopologyType = struct {
    mode: Int, // 0: Linear, 1: Grid2D, 2: HeavyHex
};

pub fn chip_linear() -> ChipTopologyType { return ChipTopologyType { mode: 0 }; }
pub fn chip_grid() -> ChipTopologyType { return ChipTopologyType { mode: 1 }; }
pub fn chip_heavy_hex() -> ChipTopologyType { return ChipTopologyType { mode: 2 }; }

pub type CouplingEdge = struct {
    qubit_u: Int,
    qubit_v: Int,
};

pub type QuantumChipGraph = struct {
    num_qubits: Int,
    topology: ChipTopologyType,
    num_edges: Int,
    edges: List[CouplingEdge],
};

pub fn chip_graph_linear(n: Int) -> QuantumChipGraph {
    let mut edge_list: List[CouplingEdge] = list_new();
    let mut i: Int = 0;
    let limit: Int = n - 1;
    while i < limit {
        let e: CouplingEdge = CouplingEdge { qubit_u: i, qubit_v: i + 1 };
        list_push(edge_list, e);
        i = i + 1;
    }
    return QuantumChipGraph {
        num_qubits: n,
        topology: chip_linear(),
        num_edges: limit,
        edges: edge_list,
    };
}

pub fn chip_are_connected(graph: &QuantumChipGraph, u: Int, v: Int) -> Int {
    let n_e: Int = graph.num_edges;
    let list: List[CouplingEdge] = graph.edges;
    let mut i: Int = 0;
    while i < n_e {
        let e: CouplingEdge = list_get(list, i);
        let eu: Int = e.qubit_u;
        let ev: Int = e.qubit_v;
        if (eu == u && ev == v) || (eu == v && ev == u) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

pub type SwapGateStep = struct {
    physical_q1: Int,
    physical_q2: Int,
};

pub fn chip_route_linear_pair(u: Int, v: Int) -> List[SwapGateStep] {
    let mut swaps: List[SwapGateStep] = list_new();
    let min_q: Int = if u < v { u } else { v };
    let max_q: Int = if u < v { v } else { u };

    let mut curr: Int = min_q;
    let target: Int = max_q - 1;
    while curr < target {
        let step: SwapGateStep = SwapGateStep { physical_q1: curr, physical_q2: curr + 1 };
        list_push(swaps, step);
        curr = curr + 1;
    }
    return swaps;
}
