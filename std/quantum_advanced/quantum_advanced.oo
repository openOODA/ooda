// -------------------------------------------------------------------
// Unified Quantum Advanced Runtime Config
// -------------------------------------------------------------------

pub type AdvancedQuantumRuntime = struct {
    default_shots: Int,
    target_error_tolerance: Float,
    enable_zne_mitigation: Int,
    enable_dynamical_decoupling: Int
};

pub fn advanced_quantum_runtime_default() -> AdvancedQuantumRuntime {
    return AdvancedQuantumRuntime {
        default_shots: 4096,
        target_error_tolerance: 0.001,
        enable_zne_mitigation: 1,
        enable_dynamical_decoupling: 1
    };
}

// -------------------------------------------------------------------
// High-Level Facade Convenience Shims
// -------------------------------------------------------------------

pub fn qa_vqe_hamiltonian_create(num_qubits: Int) -> PauliHamiltonian {
    return pauli_hamiltonian_new(num_qubits);
}

pub fn qa_hea_config_create(num_qubits: Int, num_layers: Int) -> HeaConfig {
    return hea_config_new(num_qubits, num_layers, entangle_linear(), 0);
}

pub fn qa_uccsd_config_create(spatial_orbitals: Int, electrons: Int) -> UccsdConfig {
    return uccsd_config_new(spatial_orbitals, electrons);
}

pub fn qa_shor_factor(modulus_n: Int, base_a: Int, period_r: Int) -> FactorizationResult {
    return shor_try_factor_from_order(modulus_n, base_a, period_r);
}

pub fn qa_qpe_config_create(counting_qubits: Int, target_qubits: Int) -> QpeConfig {
    return qpe_config_new(counting_qubits, target_qubits);
}

pub fn qa_steane_decode_syndromes(z_syn: &SteaneSyndrome, x_syn: &SteaneSyndrome) -> SteaneCorrection {
    return steane_decode(z_syn, x_syn);
}

pub fn qa_surface_code_create(distance: Int) -> SurfaceCodeType {
    return surface_code_new(distance);
}

pub fn qa_zne_extrapolate(p1: &ZneDataPoint, p2: &ZneDataPoint) -> ZneMitigatedResult {
    return zne_extrapolate_linear(p1, p2);
}

pub fn qa_qasm3_program_create(num_qubits: Int, num_clbits: Int) -> Qasm3Program {
    return qasm3_program_new(num_qubits, num_clbits);
}

pub fn qa_qaoa_graph_create(num_nodes: Int) -> QaoaProblemGraph {
    return qaoa_graph_new(num_nodes);
}

pub fn qa_qubo_matrix_create(num_vars: Int) -> QuboMatrix {
    return qubo_matrix_new(num_vars);
}

pub fn qa_trotter_schedule_create_2nd_order(num_terms: Int) -> TrotterStageSchedule {
    return trotter_build_2nd_order_schedule(num_terms);
}
