// # Probabilistic Error Cancellation (PEC)
//
// Logline: Inverts local noise channels via quasi-probability operator decompositions and Monte Carlo circuit sampling.
//
// Setup: Unbiased quantum error mitigation representing $\mathcal{N}^{-1} = \sum_k \gamma_k \mathcal{B}_k$ with sampling overhead $\gamma = \sum |\gamma_k|$.
//
// Beats:
//   1. Decompose noisy gate operations into linear combinations of Pauli basis channels with quasi-probability weights $\gamma_k$.
//   2. Compute total sampling overhead $\gamma_{tot} = \prod_j \gamma_j$ and sample size requirements $N_{samples} \propto \gamma_{tot}^2 / \epsilon^2$.
//   3. Implement Monte Carlo quasi-probability sampler and unbiased expectation accumulator.

pub type QuasiProbabilityTerm = struct {
    basis_op_code: Int, // 0: I, 1: X, 2: Y, 3: Z
    weight_gamma: Float,
    sampling_prob: Float,
};

pub type PecChannelModel = struct {
    gamma_norm: Float, // \sum |\gamma_k|
    num_terms: Int,
    terms: List[QuasiProbabilityTerm],
};

pub fn pec_depolarizing_inversion(error_rate_p: Float) -> PecChannelModel {
    // For single-qubit depolarizing noise N(rho) = (1-p)rho + p/3(X rho X + Y rho Y + Z rho Z):
    // N^-1 = (1 + 3p/4)/(1-p) I - p/(4(1-p)) (X + Y + Z)
    let denom: Float = if (1.0 - error_rate_p) > 0.001 { 1.0 - error_rate_p } else { 0.001 };
    let g_ident: Float = (1.0 + ((3.0 * error_rate_p) * 0.25)) / denom;
    let g_pauli: Float = (0.0 - (error_rate_p * 0.25)) / denom;

    let abs_ident: Float = if g_ident < 0.0 { 0.0 - g_ident } else { g_ident };
    let abs_pauli: Float = if g_pauli < 0.0 { 0.0 - g_pauli } else { g_pauli };
    let gamma_tot: Float = abs_ident + (3.0 * abs_pauli);

    let mut terms: List[QuasiProbabilityTerm] = list_new();

    let t_i: QuasiProbabilityTerm = QuasiProbabilityTerm { basis_op_code: 0, weight_gamma: g_ident, sampling_prob: abs_ident / gamma_tot };
    let t_x: QuasiProbabilityTerm = QuasiProbabilityTerm { basis_op_code: 1, weight_gamma: g_pauli, sampling_prob: abs_pauli / gamma_tot };
    let t_y: QuasiProbabilityTerm = QuasiProbabilityTerm { basis_op_code: 2, weight_gamma: g_pauli, sampling_prob: abs_pauli / gamma_tot };
    let t_z: QuasiProbabilityTerm = QuasiProbabilityTerm { basis_op_code: 3, weight_gamma: g_pauli, sampling_prob: abs_pauli / gamma_tot };

    list_push(terms, t_i);
    list_push(terms, t_x);
    list_push(terms, t_y);
    list_push(terms, t_z);

    return PecChannelModel {
        gamma_norm: gamma_tot,
        num_terms: 4,
        terms: terms,
    };
}

pub fn pec_circuit_sampling_overhead(channel_gamma: Float, num_gates: Int) -> Float {
    let mut total_gamma: Float = 1.0;
    let mut i: Int = 0;
    while i < num_gates {
        total_gamma = total_gamma * channel_gamma;
        i = i + 1;
    }
    return total_gamma;
}

pub fn pec_required_sample_count(total_gamma: Float, target_precision: Float) -> Int {
    let prec: Float = if target_precision > 0.0001 { target_precision } else { 0.0001 };
    let ratio: Float = total_gamma / prec;
    let n_f: Float = ratio * ratio;

    let mut count: Int = 100;
    let mut f: Float = 100.0;
    while f < n_f && count < 1000000 {
        count = count + 1000;
        f = f + 1000.0;
    }
    return count;
}
