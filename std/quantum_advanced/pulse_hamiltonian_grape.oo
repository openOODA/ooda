// # GRAPE Quantum Optimal Control Pulse Engine
//
// Logline: Synthesizes high-fidelity microwave drive control pulses via Gradient Ascent Pulse Engineering (GRAPE) on driven Hamiltonians.
//
// Setup: Optimal control framework maximizing target unitary overlap fidelity $\Phi = \frac{1}{d}|\text{Tr}(U_{target}^\dagger U_{actual})|$.
//
// Beats:
//   1. Configure time-sliced control amplitudes $u_k(t)$ and drift Hamiltonian $H_0$.
//   2. Compute piecewise unitary propagators $U_j = \exp(-i (H_0 + \sum u_k H_k) \Delta t)$.
//   3. Compute analytic overlap gradients $\frac{\partial \Phi}{\partial u_k(j)}$ and perform pulse gradient updates.

pub type GrapeControlField = struct {
    field_id: Int,
    num_slices: Int,
    dt_step_ns: Float,
    amplitudes: List[Float]
};

pub type GrapeOptimizerConfig = struct {
    learning_rate: Float,
    max_iterations: Int,
    target_fidelity: Float,
    total_duration_ns: Float,
    num_time_slices: Int
};

pub fn grape_config_new(duration: Float, slices: Int, lr: Float) -> GrapeOptimizerConfig {
    return GrapeOptimizerConfig {
        learning_rate: lr,
        max_iterations: 100,
        target_fidelity: 0.9999,
        total_duration_ns: duration,
        num_time_slices: slices
    };
}

pub type GrapeIterationResult = struct {
    current_fidelity: Float,
    gradient_norm: Float,
    converged: Int
};

pub fn grape_fidelity_overlap(trace_overlap_real: Float, trace_overlap_imag: Float, dim: Int) -> Float {
    let d_f: Float = if dim == 2 { 2.0 } else { 4.0 };
    let re: Float = trace_overlap_real;
    let im: Float = trace_overlap_imag;
    let abs_sq: Float = (re * re) + (im * im);
    let fid: Float = abs_sq / (d_f * d_f);
    if fid > 1.0 { return 1.0; }
    if fid < 0.0 { return 0.0; }
    return fid;
}

pub fn grape_update_slice(
    old_amplitude: Float,
    gradient: Float,
    learning_rate: Float,
    max_rabi_rate: Float
) -> Float {
    let delta: Float = learning_rate * gradient;
    let mut updated: Float = old_amplitude + delta;

    // Amplitude clipping
    if updated > max_rabi_rate {
        updated = max_rabi_rate;
    }
    let neg_max: Float = 0.0 - max_rabi_rate;
    if updated < neg_max {
        updated = neg_max;
    }
    return updated;
}
