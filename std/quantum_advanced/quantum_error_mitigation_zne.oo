// # Quantum Error Mitigation - Zero-Noise Extrapolation (ZNE)
//
// Logline: Mitigates hardware noise by scaling circuit noise levels via unitary folding and extrapolating expectation values to the zero-noise limit.
//
// Setup: Non-unitary error mitigation framework combining digital circuit stretching with Richardson and polynomial extrapolation.
//
// Beats:
//   1. Configure noise scale factors $\lambda \in \{1, 3, 5, \dots\}$ and compute unitary folding counts $m = (\lambda - 1) / 2$.
//   2. Apply digital unitary folding $G \to G (G^\dagger G)^m$ on two-qubit Clifford and CX gates.
//   3. Execute Richardson and linear extrapolation polynomials to determine zero-noise expectation values $\langle O \rangle_0$.

pub fn int_to_float_zne(n_int: Int) -> Float {
    let mut f: Float = 0.0;
    let mut i: Int = 0;
    let mut count: Int = n_int;
    if count < 0 {
        count = 0 - count;
    }
    while count >= 1000 {
        f = f + 1000.0;
        count = count - 1000;
    }
    while count >= 100 {
        f = f + 100.0;
        count = count - 100;
    }
    while count >= 10 {
        f = f + 10.0;
        count = count - 10;
    }
    while i < count {
        f = f + 1.0;
        i = i + 1;
    }
    if n_int < 0 {
        return 0.0 - f;
    }
    return f;
}

pub type ZneScaleFactor = struct {
    scale: Float,
    fold_multiplicity: Int
};

pub fn zne_scale_factor_new(scale: Float) -> ZneScaleFactor {
    let mut mult: Int = 0;
    if scale >= 3.0 {
        mult = 1;
    }
    if scale >= 5.0 {
        mult = 2;
    }
    return ZneScaleFactor {
        scale: scale,
        fold_multiplicity: mult
    };
}

pub type ZneDataPoint = struct {
    noise_scale: Float,
    measured_expectation: Float,
    variance: Float
};

pub type ZneMitigatedResult = struct {
    zero_noise_value: Float,
    fit_model_code: Int, // 0: Linear, 1: Richardson, 2: Quadratic
    residual_error: Float
};

pub fn zne_extrapolate_linear(p1: &ZneDataPoint, p2: &ZneDataPoint) -> ZneMitigatedResult {
    let x1: Float = p1.noise_scale;
    let y1: Float = p1.measured_expectation;
    let x2: Float = p2.noise_scale;
    let y2: Float = p2.measured_expectation;

    let slope: Float = (y2 - y1) / (x2 - x1);
    let zero_val: Float = y1 - (x1 * slope);

    return ZneMitigatedResult {
        zero_noise_value: zero_val,
        fit_model_code: 0,
        residual_error: 0.0
    };
}

pub fn zne_extrapolate_richardson_3pt(
    p1: &ZneDataPoint,
    p2: &ZneDataPoint,
    p3: &ZneDataPoint
) -> ZneMitigatedResult {
    let y1: Float = p1.measured_expectation;
    let y2: Float = p2.measured_expectation;
    let y3: Float = p3.measured_expectation;

    let x1: Float = p1.noise_scale;
    let x2: Float = p2.noise_scale;
    let x3: Float = p3.noise_scale;

    let l1: Float = (x2 * x3) / ((x1 - x2) * (x1 - x3));
    let l2: Float = (x1 * x3) / ((x2 - x1) * (x2 - x3));
    let l3: Float = (x1 * x2) / ((x3 - x1) * (x3 - x2));

    let zero_val: Float = (l1 * y1) + (l2 * y2) + (l3 * y3);

    return ZneMitigatedResult {
        zero_noise_value: zero_val,
        fit_model_code: 1,
        residual_error: 0.0
    };
}

pub fn zne_compute_unitary_folds(circuit_depth: Int, scale_factor: Float) -> Int {
    let s: Float = if scale_factor < 1.0 { 1.0 } else { scale_factor };
    let extra_factor: Float = (s - 1.0) * 0.5;
    let depth_f: Float = int_to_float_zne(circuit_depth);
    let total_extra: Float = extra_factor * depth_f;

    let mut added_gates: Int = 0;
    let mut counter: Float = 1.0;
    while counter < total_extra {
        added_gates = added_gates + 1;
        counter = counter + 1.0;
    }
    return added_gates * 2;
}
