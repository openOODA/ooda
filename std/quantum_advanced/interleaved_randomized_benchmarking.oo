// # Interleaved Randomized Benchmarking (IRB)
//
// Logline: Measures isolated fault rates and gate fidelities for specific target quantum gates (CNOT, CZ, SX) via interleaved Clifford decay sequences.
//
// Setup: Specialized QCVV protocol extracting gate-specific infidelity $r_T = \frac{d-1}{d}(1 - p_{int}/p_{ref})$.
//
// Beats:
//   1. Generate interleaved Clifford sequences alternating between random Clifford elements and target gate $C_T$.
//   2. Compute simultaneous reference decay $p_{ref}$ and interleaved decay $p_{int}$.
//   3. Extract target gate error rate $r_T$, gate fidelity $F_T$, and error bound bounds.

pub type InterleavedTargetGate = struct {
    gate_name_code: Int, // 0: CNOT, 1: CZ, 2: SX, 3: T
    num_qubits: Int
};

pub fn irb_target_cnot() -> InterleavedTargetGate { return InterleavedTargetGate { gate_name_code: 0, num_qubits: 2 }; }
pub fn irb_target_cz() -> InterleavedTargetGate { return InterleavedTargetGate { gate_name_code: 1, num_qubits: 2 }; }
pub fn irb_target_sx() -> InterleavedTargetGate { return InterleavedTargetGate { gate_name_code: 2, num_qubits: 1 }; }

pub type InterleavedRbResult = struct {
    target_gate: InterleavedTargetGate,
    reference_p: Float,
    interleaved_p: Float,
    target_error_rate: Float,
    target_gate_fidelity: Float,
    uncertainty_bound: Float
};

pub fn irb_compute_target_fidelity(
    target: InterleavedTargetGate,
    p_ref: Float,
    p_int: Float
) -> InterleavedRbResult {
    let d: Float = if target.num_qubits == 1 { 2.0 } else { 4.0 };
    let factor: Float = (d - 1.0) / d;

    // r_T = (d-1)/d * (1 - p_int / p_ref)
    let p_ratio: Float = if p_ref > 0.0001 { p_int / p_ref } else { 0.0 };
    let clamped_ratio: Float = if p_ratio > 1.0 { 1.0 } else if p_ratio < 0.0 { 0.0 } else { p_ratio };

    let r_target: Float = factor * (1.0 - clamped_ratio);
    let f_target: Float = 1.0 - r_target;

    // Theoretical uncertainty bound ~ (d-1)/d * (sqrt(1-p_ref) + sqrt(1-p_int))
    let uncert: Float = factor * (sqrt(1.0 - p_ref) + sqrt(1.0 - p_int));

    return InterleavedRbResult {
        target_gate: target,
        reference_p: p_ref,
        interleaved_p: p_int,
        target_error_rate: r_target,
        target_gate_fidelity: f_target,
        uncertainty_bound: uncert
    };
}
