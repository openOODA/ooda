// # DRAG Pulse Waveform Synthesis & Leakage Compensation
//
// Logline: Generates Derivative Removal by Adiabatic Gate (DRAG) pulse envelopes to eliminate transmon qubit leakage into the second excited state.
//
// Setup: Microwave pulse shaping combining Gaussian in-phase $I(t)$ and derivative quadrature $Q(t) = -\frac{\dot{I}(t)}{\alpha}$ waveforms.
//
// Beats:
//   1. Configure transmon anharmonicity $\alpha = \omega_{12} - \omega_{01}$ and pulse duration $\sigma$.
//   2. Compute in-phase Gaussian envelope $I(t) = A \exp(-(t - t_c)^2 / (2\sigma^2))$.
//   3. Compute quadrature DRAG correction $Q(t) = -\beta \frac{\dot{I}(t)}{\alpha}$ and dynamic phase detunings.

pub type DragPulseConfig = struct {
    amplitude_a: Float,
    duration_ns: Float,
    sigma_ns: Float,
    anharmonicity_ghz: Float, // Typically -0.300 GHz (-300 MHz)
    beta_drag_coeff: Float,
    num_samples: Int
};

pub fn drag_pulse_config_default(amp: Float, duration: Float) -> DragPulseConfig {
    let sigma: Float = duration / 4.0;
    return DragPulseConfig {
        amplitude_a: amp,
        duration_ns: duration,
        sigma_ns: sigma,
        anharmonicity_ghz: 0.0 - 0.3,
        beta_drag_coeff: 0.5,
        num_samples: 64
    };
}

pub type PulseSample = struct {
    time_ns: Float,
    in_phase_i: Float,
    quadrature_q: Float
};

pub fn drag_sample_point(cfg: &DragPulseConfig, t: Float) -> PulseSample {
    let dur: Float = cfg.duration_ns;
    let s: Float = cfg.sigma_ns;
    let amp: Float = cfg.amplitude_a;
    let alpha: Float = cfg.anharmonicity_ghz;
    let beta: Float = cfg.beta_drag_coeff;

    let tc: Float = dur * 0.5;
    let dt: Float = t - tc;
    let s2: Float = s * s;

    // Gaussian envelope I(t) = A * exp(- (t-tc)^2 / (2 * sigma^2))
    let exp_arg: Float = (0.0 - (dt * dt)) / (2.0 * s2);
    let g: Float = exp(exp_arg);
    let i_val: Float = amp * g;

    // Derivative: dI/dt = - (t-tc)/sigma^2 * I(t)
    let deriv: Float = (0.0 - (dt / s2)) * i_val;

    // Q(t) = - beta * (dI/dt) / alpha
    let safe_alpha: Float = if alpha == 0.0 { 0.0 - 0.3 } else { alpha };
    let q_val: Float = (0.0 - beta) * (deriv / safe_alpha);

    return PulseSample {
        time_ns: t,
        in_phase_i: i_val,
        quadrature_q: q_val
    };
}

pub fn drag_peak_amplitude(cfg: &DragPulseConfig) -> Float {
    return cfg.amplitude_a;
}
