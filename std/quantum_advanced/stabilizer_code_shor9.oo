// # [[9,1,3]] Shor Concatenated Quantum Error Code
//
// Logline: Implements Peter Shor's 9-qubit code concatenating 3-qubit bit-flip and phase-flip codes with 8 stabilizer checks.
//
// Setup: First quantum error correction code historically proposed, correcting arbitrary single physical qubit errors.
//
// Beats:
//   1. Define 8 stabilizer generators (6 two-body $Z_i Z_j$ bit-flip checks and 2 six-body $X^{\otimes 6}$ phase checks).
//   2. Encode logical states $|\bar{0}\rangle = \frac{1}{2\sqrt{2}}(|000\rangle+|111\rangle)^{\otimes 3}$ and $|\bar{1}\rangle$.
//   3. Implement two-stage syndrome decoder resolving bit-flip triplets and block phase parity.

pub type Shor9Stabilizer = struct {
    stab_id: Int,
    is_x_type: Int,
    qubit_mask: List[Int], // 9 integers: 1 if participating, 0 otherwise
};

pub fn shor9_make_mask(q_indices: List[Int]) -> List[Int] {
    let mut mask: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 9 {
        let mut found: Int = 0;
        let count: Int = list_len(q_indices);
        let mut k: Int = 0;
        while k < count {
            if list_get(q_indices, k) == i {
                found = 1;
            }
            k = k + 1;
        }
        list_push(mask, found);
        i = i + 1;
    }
    return mask;
}

pub fn shor9_get_stabilizers() -> List[Shor9Stabilizer] {
    let mut stabs: List[Shor9Stabilizer] = list_new();

    // 6 Bit-flip stabilizers: Z0Z1, Z1Z2, Z3Z4, Z4Z5, Z6Z7, Z7Z8
    let mut b0: List[Int] = list_new(); list_push(b0, 0); list_push(b0, 1);
    let mut b1: List[Int] = list_new(); list_push(b1, 1); list_push(b1, 2);
    let mut b2: List[Int] = list_new(); list_push(b2, 3); list_push(b2, 4);
    let mut b3: List[Int] = list_new(); list_push(b3, 4); list_push(b3, 5);
    let mut b4: List[Int] = list_new(); list_push(b4, 6); list_push(b4, 7);
    let mut b5: List[Int] = list_new(); list_push(b5, 7); list_push(b5, 8);

    let m0: List[Int] = shor9_make_mask(b0);
    let s0: Shor9Stabilizer = Shor9Stabilizer { stab_id: 0, is_x_type: 0, qubit_mask: m0 };
    list_push(stabs, s0);

    let m1: List[Int] = shor9_make_mask(b1);
    let s1: Shor9Stabilizer = Shor9Stabilizer { stab_id: 1, is_x_type: 0, qubit_mask: m1 };
    list_push(stabs, s1);

    let m2: List[Int] = shor9_make_mask(b2);
    let s2: Shor9Stabilizer = Shor9Stabilizer { stab_id: 2, is_x_type: 0, qubit_mask: m2 };
    list_push(stabs, s2);

    let m3: List[Int] = shor9_make_mask(b3);
    let s3: Shor9Stabilizer = Shor9Stabilizer { stab_id: 3, is_x_type: 0, qubit_mask: m3 };
    list_push(stabs, s3);

    let m4: List[Int] = shor9_make_mask(b4);
    let s4: Shor9Stabilizer = Shor9Stabilizer { stab_id: 4, is_x_type: 0, qubit_mask: m4 };
    list_push(stabs, s4);

    let m5: List[Int] = shor9_make_mask(b5);
    let s5: Shor9Stabilizer = Shor9Stabilizer { stab_id: 5, is_x_type: 0, qubit_mask: m5 };
    list_push(stabs, s5);

    // 2 Phase-flip stabilizers: X0X1X2 X3X4X5 and X3X4X5 X6X7X8
    let mut p0: List[Int] = list_new();
    list_push(p0, 0); list_push(p0, 1); list_push(p0, 2);
    list_push(p0, 3); list_push(p0, 4); list_push(p0, 5);

    let mut p1: List[Int] = list_new();
    list_push(p1, 3); list_push(p1, 4); list_push(p1, 5);
    list_push(p1, 6); list_push(p1, 7); list_push(p1, 8);

    let mp0: List[Int] = shor9_make_mask(p0);
    let sp0: Shor9Stabilizer = Shor9Stabilizer { stab_id: 6, is_x_type: 1, qubit_mask: mp0 };
    list_push(stabs, sp0);

    let mp1: List[Int] = shor9_make_mask(p1);
    let sp1: Shor9Stabilizer = Shor9Stabilizer { stab_id: 7, is_x_type: 1, qubit_mask: mp1 };
    list_push(stabs, sp1);

    return stabs;
}

pub type Shor9Correction = struct {
    error_qubit: Int,
    is_x_error: Int,
    is_z_error: Int,
};

pub fn shor9_decode_syndrome(
    z_syndromes: List[Int], // 6 bits
    x_syndromes: List[Int]  // 2 bits
) -> Shor9Correction {
    // Stage 1: Triplet bit-flip localization
    let mut bit_err_q: Int = 0 - 1;
    let mut block_idx: Int = 0;

    while block_idx < 3 {
        let s0: Int = list_get(z_syndromes, block_idx * 2);
        let s1: Int = list_get(z_syndromes, (block_idx * 2) + 1);

        if s0 == 1 && s1 == 0 {
            bit_err_q = (block_idx * 3) + 0;
        } else if s0 == 1 && s1 == 1 {
            bit_err_q = (block_idx * 3) + 1;
        } else if s0 == 0 && s1 == 1 {
            bit_err_q = (block_idx * 3) + 2;
        }
        block_idx = block_idx + 1;
    }

    // Stage 2: Phase-flip block localization
    let px0: Int = list_get(x_syndromes, 0);
    let px1: Int = list_get(x_syndromes, 1);
    let mut phase_err_block: Int = 0 - 1;

    if px0 == 1 && px1 == 0 {
        phase_err_block = 0;
    } else if px0 == 1 && px1 == 1 {
        phase_err_block = 1;
    } else if px0 == 0 && px1 == 1 {
        phase_err_block = 2;
    }

    let is_x: Int = if bit_err_q >= 0 { 1 } else { 0 };
    let is_z: Int = if phase_err_block >= 0 { 1 } else { 0 };
    let target_q: Int = if is_x == 1 { bit_err_q } else if is_z == 1 { phase_err_block * 3 } else { 0 - 1 };

    return Shor9Correction {
        error_qubit: target_q,
        is_x_error: is_x,
        is_z_error: is_z,
    };
}
