// # Higher-Order Trotter-Suzuki Product Formulas
//
// Logline: Generates 1st, 2nd, and 4th order Trotter-Suzuki decomposition schedules for quantum simulation of non-commuting Hamiltonians.
//
// Setup: Unitary product formula approximation $e^{-i (A+B) t} \approx (e^{-i A t/2r} e^{-i B t/r} e^{-i A t/2r})^r$ with analytic error bounds.
//
// Beats:
//   1. Configure Trotter orders ($k \in \{1, 2, 4\}$) and target evolution duration $T$.
//   2. Compute Suzuki 4th-order fractal time-step scaling coefficients $p = \frac{1}{4 - 4^{1/3}} \approx 0.41449$.
//   3. Estimate minimal Trotter step counts $r$ satisfying user error tolerance $\epsilon$.

pub type TrotterOrderType = struct {
    order_k: Int, // 1: 1st-order, 2: 2nd-order (Strang), 4: 4th-order (Suzuki)
};

pub fn trotter_order_1() -> TrotterOrderType { return TrotterOrderType { order_k: 1 }; }
pub fn trotter_order_2() -> TrotterOrderType { return TrotterOrderType { order_k: 2 }; }
pub fn trotter_order_4() -> TrotterOrderType { return TrotterOrderType { order_k: 4 }; }

pub type TrotterSubstep = struct {
    term_index: Int,
    time_weight_fraction: Float,
};

pub type TrotterStageSchedule = struct {
    order: TrotterOrderType,
    num_substeps: Int,
    substeps: List[TrotterSubstep],
};

pub fn suzuki_p_constant() -> Float {
    return 0.4144907717943757;
}

pub fn trotter_build_2nd_order_schedule(num_hamiltonian_terms: Int) -> TrotterStageSchedule {
    let mut steps_list: List[TrotterSubstep] = list_new();

    // Forward half-steps: term 0 .. L-1 with weight 0.5
    let mut i: Int = 0;
    while i < num_hamiltonian_terms {
        let s: TrotterSubstep = TrotterSubstep { term_index: i, time_weight_fraction: 0.5 };
        list_push(steps_list, s);
        i = i + 1;
    }

    // Backward half-steps: term L-1 .. 0 with weight 0.5
    let mut j: Int = num_hamiltonian_terms - 1;
    while j >= 0 {
        let s: TrotterSubstep = TrotterSubstep { term_index: j, time_weight_fraction: 0.5 };
        list_push(steps_list, s);
        j = j - 1;
    }

    let total: Int = list_len(steps_list);
    return TrotterStageSchedule {
        order: trotter_order_2(),
        num_substeps: total,
        substeps: steps_list,
    };
}

pub fn trotter_estimate_step_count_2nd_order(
    total_time_t: Float,
    commutator_norm: Float,
    target_error_eps: Float
) -> Int {
    if target_error_eps <= 0.0 {
        return 100;
    }
    let t3: Float = total_time_t * total_time_t * total_time_t;
    let num: Float = commutator_norm * t3;
    let den: Float = 24.0 * target_error_eps;
    let ratio: Float = num / den;
    let sqrt_r: Float = if ratio > 0.0 { sqrt(ratio) } else { 1.0 };

    let mut r_steps: Int = 1;
    let mut counter: Float = 1.0;
    while counter < sqrt_r && r_steps < 100000 {
        r_steps = r_steps + 1;
        counter = counter + 1.0;
    }
    return r_steps;
}
