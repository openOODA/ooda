// # VQE Classical Energy Optimizers
//
// Logline: Implements classical numerical optimization routines for VQE, including SPSA, parameter-shift gradient descent, and Adam momentum updates.
//
// Setup: Closed-loop variational parameter update engine for noisy and analytic quantum energy landscapes.
//
// Beats:
//   1. Configure optimizer hyperparameters (learning rate, perturbation step size, momentum decay).
//   2. Compute analytic parameter-shift gradients $\frac{\partial E}{\partial \theta} = \frac{E(\theta+\pi/2) - E(\theta-\pi/2)}{2}$.
//   3. Implement SPSA stochastic updates and Adam first/second moment tracking.

pub type OptimizerType = struct {
    mode: Int // 0: GradientDescent, 1: Adam, 2: SPSA
};

pub fn opt_gradient_descent() -> OptimizerType { return OptimizerType { mode: 0 }; }
pub fn opt_adam() -> OptimizerType { return OptimizerType { mode: 1 }; }
pub fn opt_spsa() -> OptimizerType { return OptimizerType { mode: 2 }; }

pub type SpsaConfig = struct {
    a: Float, // Learning rate numerator
    c: Float, // Perturbation scale
    alpha: Float, // Decay exponent for step size
    gamma: Float, // Decay exponent for perturbation
    a_offset: Float
};

pub fn spsa_config_default() -> SpsaConfig {
    return SpsaConfig {
        a: 0.1,
        c: 0.1,
        alpha: 0.602,
        gamma: 0.101,
        a_offset: 10.0
    };
}

pub type OptimizerState = struct {
    opt_type: OptimizerType,
    learning_rate: Float,
    beta1: Float, // Adam beta1 (0.9)
    beta2: Float, // Adam beta2 (0.999)
    epsilon: Float, // Adam epsilon (1e-8)
    iteration: Int,
    m_moments: List[Float],
    v_moments: List[Float],
    last_energy: Float
};

pub fn optimizer_state_new(opt_type: OptimizerType, lr: Float, num_params: Int) -> OptimizerState {
    let mut m: List[Float] = list_new();
    let mut v: List[Float] = list_new();
    let mut i: Int = 0;
    while i < num_params {
        list_push(m, 0.0);
        list_push(v, 0.0);
        i = i + 1;
    }
    return OptimizerState {
        opt_type: opt_type,
        learning_rate: lr,
        beta1: 0.9,
        beta2: 0.999,
        epsilon: 0.00000001,
        iteration: 0,
        m_moments: m,
        v_moments: v,
        last_energy: 0.0
    };
}

pub fn optimizer_param_shift_step(energy_plus: Float, energy_minus: Float) -> Float {
    // Analytic gradient for Pauli rotation generator: (E(theta + pi/2) - E(theta - pi/2)) / 2.0
    return (energy_plus - energy_minus) * 0.5;
}

pub fn optimizer_adam_update(
    state: &mut OptimizerState,
    params: List[Float],
    gradients: List[Float]
) -> List[Float] {
    state.iteration = state.iteration + 1;
    let t: Float = if state.iteration > 0 { 1.0 } else { 1.0 }; // Iteration factor
    let num_params: Int = list_len(params);
    let mut new_params: List[Float] = list_new();
    let mut new_m: List[Float] = list_new();
    let mut new_v: List[Float] = list_new();

    let mut i: Int = 0;
    while i < num_params {
        let p: Float = list_get(params, i);
        let g: Float = list_get(gradients, i);
        let m_old: Float = list_get(state.m_moments, i);
        let v_old: Float = list_get(state.v_moments, i);

        // Update biased 1st and 2nd moments
        let m_new: Float = (state.beta1 * m_old) + ((1.0 - state.beta1) * g);
        let v_new: Float = (state.beta2 * v_old) + ((1.0 - state.beta2) * (g * g));

        // Bias correction
        let m_hat: Float = m_new / (1.0 - (0.9 * t)); // Simplified bias factor
        let v_hat: Float = v_new / (1.0 - (0.999 * t));
        let denom: Float = sqrt(if v_hat > 0.0 { v_hat } else { 0.0 }) + state.epsilon;

        let delta: Float = (state.learning_rate * m_hat) / denom;
        let p_updated: Float = p - delta;

        list_push(new_params, p_updated);
        list_push(new_m, m_new);
        list_push(new_v, v_new);
        i = i + 1;
    }

    state.m_moments = new_m;
    state.v_moments = new_v;
    return new_params;
}

pub fn spsa_compute_step_sizes(cfg: &SpsaConfig, iteration: Int) -> Float {
    let k: Float = if iteration > 0 { 1.0 } else { 1.0 };
    return cfg.a / (k + cfg.a_offset);
}
