// # Surface Code Syndrome Extraction Circuits
//
// Logline: Configures rotated planar surface code lattices, X-type star and Z-type plaquette ancillae, and syndrome measurement schedules.
//
// Setup: High-threshold 2D topological quantum memory detecting localized anyonic error pairs on square grids.
//
// Beats:
//   1. Configure rotated surface code parameters for code distance $d$ ($d^2$ data qubits and $d^2-1$ ancillae).
//   2. Define weight-2 and weight-4 X/Z syndrome stabilizer check coordinates.
//   3. Generate 4-step CNOT entangling schedules (North, West, East, South) for syndrome extraction.

pub type SurfaceCodeType = struct {
    distance_d: Int,
    num_data_qubits: Int,
    num_x_ancillae: Int,
    num_z_ancillae: Int,
    total_qubits: Int
};

pub fn surface_code_new(distance: Int) -> SurfaceCodeType {
    let d: Int = distance;
    let n_data: Int = d * d;
    let n_anc: Int = (d * d) - 1;
    let n_x: Int = n_anc / 2;
    let n_z: Int = n_anc - n_x;
    let total: Int = n_data + n_anc;

    return SurfaceCodeType {
        distance_d: d,
        num_data_qubits: n_data,
        num_x_ancillae: n_x,
        num_z_ancillae: n_z,
        total_qubits: total
    };
}

pub type SyndromeCheck = struct {
    check_id: Int,
    is_x_type: Int, // 1 for X-check (star), 0 for Z-check (plaquette)
    center_x: Int,
    center_y: Int,
    data_north: Int,
    data_west: Int,
    data_east: Int,
    data_south: Int,
    weight: Int // 2 or 4
};

pub fn surface_code_d3_checks() -> List[SyndromeCheck] {
    let mut checks: List[SyndromeCheck] = list_new();

    // Distance-3 rotated surface code has 9 data qubits (0..8) and 8 ancillae
    // 4 X-type checks (2 weight-2 boundary, 2 weight-4 bulk)
    let x0: SyndromeCheck = SyndromeCheck { check_id: 0, is_x_type: 1, center_x: 1, center_y: 0, data_north: 0, data_west: 1, data_east: 0 - 1, data_south: 0 - 1, weight: 2 };
    let x1: SyndromeCheck = SyndromeCheck { check_id: 1, is_x_type: 1, center_x: 0, center_y: 1, data_north: 0, data_west: 3, data_east: 1, data_south: 4, weight: 4 };
    let x2: SyndromeCheck = SyndromeCheck { check_id: 2, is_x_type: 1, center_x: 2, center_y: 1, data_north: 1, data_west: 4, data_east: 2, data_south: 5, weight: 4 };
    let x3: SyndromeCheck = SyndromeCheck { check_id: 3, is_x_type: 1, center_x: 1, center_y: 2, data_north: 0 - 1, data_west: 0 - 1, data_east: 4, data_south: 5, weight: 2 };

    list_push(checks, x0);
    list_push(checks, x1);
    list_push(checks, x2);
    list_push(checks, x3);

    // 4 Z-type checks
    let z0: SyndromeCheck = SyndromeCheck { check_id: 4, is_x_type: 0, center_x: 0, center_y: 0, data_north: 0 - 1, data_west: 0, data_east: 0 - 1, data_south: 3, weight: 2 };
    let z1: SyndromeCheck = SyndromeCheck { check_id: 5, is_x_type: 0, center_x: 1, center_y: 1, data_north: 1, data_west: 2, data_east: 4, data_south: 5, weight: 4 };
    let z2: SyndromeCheck = SyndromeCheck { check_id: 6, is_x_type: 0, center_x: 2, center_y: 0, data_north: 2, data_west: 0 - 1, data_east: 5, data_south: 0 - 1, weight: 2 };
    let z3: SyndromeCheck = SyndromeCheck { check_id: 7, is_x_type: 0, center_x: 1, center_y: 2, data_north: 3, data_west: 4, data_east: 6, data_south: 7, weight: 4 };

    list_push(checks, z0);
    list_push(checks, z1);
    list_push(checks, z2);
    list_push(checks, z3);

    return checks;
}

pub type SyndromeDifference = struct {
    num_defects: Int,
    defect_check_ids: List[Int]
};

pub fn surface_code_compute_defects(
    current_syndrome: List[Int],
    previous_syndrome: List[Int]
) -> SyndromeDifference {
    let mut defects: List[Int] = list_new();
    let count: Int = list_len(current_syndrome);

    let mut i: Int = 0;
    while i < count {
        let cur: Int = list_get(current_syndrome, i);
        let prev: Int = list_get(previous_syndrome, i);
        let diff: Int = (cur + prev) % 2;
        if diff == 1 {
            list_push(defects, i);
        }
        i = i + 1;
    }

    let n_def: Int = list_len(defects);
    return SyndromeDifference {
        num_defects: n_def,
        defect_check_ids: defects
    };
}
