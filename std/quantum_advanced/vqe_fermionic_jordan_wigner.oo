// # Fermionic Jordan-Wigner Transformation
//
// Logline: Maps second-quantized fermionic creation, annihilation, and hopping operators to qubit Pauli string representations.
//
// Setup: Canonical isomorphic mapping preserving anticommutation relations $\{a_p, a_q^\dagger\} = \delta_{pq}$ via non-local Pauli Z parity strings.
//
// Beats:
//   1. Construct Jordan-Wigner parity strings $Z^{\otimes (p-1)}$ for fermionic mode indexing.
//   2. Transform 1-body number operators $a_p^\dagger a_p = \frac{1}{2}(I - Z_p)$ into qubit Hamiltonians.
//   3. Transform 1-body hopping terms $a_p^\dagger a_q + a_q^\dagger a_p$ into 2-qubit Pauli products with intervening Z strings.

pub type JwPauliString = struct {
    num_qubits: Int,
    coeff: Float,
    paulis: List[Int] // 0: I, 1: X, 2: Y, 3: Z
};

pub fn jw_pauli_string_new(n_qubits: Int, coeff: Float) -> JwPauliString {
    let mut ops: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n_qubits {
        list_push(ops, 0); // Identity default
        i = i + 1;
    }
    return JwPauliString {
        num_qubits: n_qubits,
        coeff: coeff,
        paulis: ops
    };
}

pub fn jw_number_operator(num_qubits: Int, site: Int) -> List[JwPauliString] {
    let mut terms: List[JwPauliString] = list_new();

    // 0.5 * I
    let t_ident: JwPauliString = jw_pauli_string_new(num_qubits, 0.5);
    list_push(terms, t_ident);

    // -0.5 * Z_site
    let mut t_z: JwPauliString = jw_pauli_string_new(num_qubits, 0.0 - 0.5);
    let mut new_ops: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_qubits {
        if i == site {
            list_push(new_ops, 3); // Z
        } else {
            list_push(new_ops, 0);
        }
        i = i + 1;
    }
    t_z.paulis = new_ops;
    list_push(terms, t_z);

    return terms;
}

pub fn jw_hopping_operator(num_qubits: Int, p: Int, q: Int, coeff: Float) -> List[JwPauliString] {
    let mut terms: List[JwPauliString] = list_new();
    let min_idx: Int = if p < q { p } else { q };
    let max_idx: Int = if p < q { q } else { p };
    let half_coeff: Float = coeff * 0.5;

    // Term 1: 0.5 * X_p Z...Z X_q
    let mut t_xx: JwPauliString = jw_pauli_string_new(num_qubits, half_coeff);
    let mut ops_xx: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_qubits {
        if i == min_idx || i == max_idx {
            list_push(ops_xx, 1); // X
        } else if i > min_idx && i < max_idx {
            list_push(ops_xx, 3); // Z parity string
        } else {
            list_push(ops_xx, 0);
        }
        i = i + 1;
    }
    t_xx.paulis = ops_xx;
    list_push(terms, t_xx);

    // Term 2: 0.5 * Y_p Z...Z Y_q
    let mut t_yy: JwPauliString = jw_pauli_string_new(num_qubits, half_coeff);
    let mut ops_yy: List[Int] = list_new();
    let mut j: Int = 0;
    while j < num_qubits {
        if j == min_idx || j == max_idx {
            list_push(ops_yy, 2); // Y
        } else if j > min_idx && j < max_idx {
            list_push(ops_yy, 3); // Z parity string
        } else {
            list_push(ops_yy, 0);
        }
        j = j + 1;
    }
    t_yy.paulis = ops_yy;
    list_push(terms, t_yy);

    return terms;
}

pub fn jw_coulomb_operator(num_qubits: Int, p: Int, q: Int, coeff: Float) -> List[JwPauliString] {
    // n_p * n_q = 0.25 * (I - Z_p - Z_q + Z_p Z_q)
    let mut terms: List[JwPauliString] = list_new();
    let quarter: Float = coeff * 0.25;

    let t1: JwPauliString = jw_pauli_string_new(num_qubits, quarter); // I
    list_push(terms, t1);

    // - quarter * Z_p
    let mut t2: JwPauliString = jw_pauli_string_new(num_qubits, 0.0 - quarter);
    let mut ops2: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_qubits {
        list_push(ops2, if i == p { 3 } else { 0 });
        i = i + 1;
    }
    t2.paulis = ops2;
    list_push(terms, t2);

    // - quarter * Z_q
    let mut t3: JwPauliString = jw_pauli_string_new(num_qubits, 0.0 - quarter);
    let mut ops3: List[Int] = list_new();
    let mut j: Int = 0;
    while j < num_qubits {
        list_push(ops3, if j == q { 3 } else { 0 });
        j = j + 1;
    }
    t3.paulis = ops3;
    list_push(terms, t3);

    // + quarter * Z_p Z_q
    let mut t4: JwPauliString = jw_pauli_string_new(num_qubits, quarter);
    let mut ops4: List[Int] = list_new();
    let mut k: Int = 0;
    while k < num_qubits {
        list_push(ops4, if k == p || k == q { 3 } else { 0 });
        k = k + 1;
    }
    t4.paulis = ops4;
    list_push(terms, t4);

    return terms;
}
