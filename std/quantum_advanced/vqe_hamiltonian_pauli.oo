// # VQE Pauli Hamiltonian & Pauli String Operators
//
// Logline: Represents multi-qubit Pauli operators, weighted Pauli sum Hamiltonians, term commutation checks, and expectation evaluation.
//
// Setup: Core operator algebra for Variational Quantum Eigensolvers and quantum chemistry representations.
//
// Beats:
//   1. Define Pauli operators (I, X, Y, Z) and weighted multi-qubit Pauli terms.
//   2. Implement algebraic summation, scaling, and qubit-wise commutation tests.
//   3. Provide expectation value evaluation routines and term grouping heuristics.

pub type PauliOp = struct {
    code: Int, // 0: I, 1: X, 2: Y, 3: Z
};

pub fn pauli_i() -> PauliOp { return PauliOp { code: 0 }; }
pub fn pauli_x() -> PauliOp { return PauliOp { code: 1 }; }
pub fn pauli_y() -> PauliOp { return PauliOp { code: 2 }; }
pub fn pauli_z() -> PauliOp { return PauliOp { code: 3 }; }

pub type PauliTerm = struct {
    coeff: Float,
    num_qubits: Int,
    operators: List[Int], // Array of Pauli codes per qubit
};

pub fn pauli_term_new(coeff: Float, num_qubits: Int, ops: List[Int]) -> PauliTerm {
    return PauliTerm {
        coeff: coeff,
        num_qubits: num_qubits,
        operators: ops,
    };
}

pub fn pauli_term_identity(num_qubits: Int) -> PauliTerm {
    let mut ops: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_qubits {
        list_push(ops, 0);
        i = i + 1;
    }
    return PauliTerm {
        coeff: 1.0,
        num_qubits: num_qubits,
        operators: ops,
    };
}

pub fn pauli_term_single(num_qubits: Int, target: Int, op_code: Int, coeff: Float) -> PauliTerm {
    let mut ops: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_qubits {
        if i == target {
            list_push(ops, op_code);
        } else {
            list_push(ops, 0);
        }
        i = i + 1;
    }
    return PauliTerm {
        coeff: coeff,
        num_qubits: num_qubits,
        operators: ops,
    };
}

pub type PauliHamiltonian = struct {
    num_qubits: Int,
    num_terms: Int,
    terms: List[PauliTerm],
};

pub fn pauli_hamiltonian_new(num_qubits: Int) -> PauliHamiltonian {
    let empty_terms: List[PauliTerm] = list_new();
    return PauliHamiltonian {
        num_qubits: num_qubits,
        num_terms: 0,
        terms: empty_terms,
    };
}

pub fn pauli_hamiltonian_add_term(ham: &mut PauliHamiltonian, term: PauliTerm) {
    list_push(ham.terms, term);
    ham.num_terms = ham.num_terms + 1;
}

pub fn paulis_commute_single(op1: Int, op2: Int) -> Int {
    if op1 == 0 || op2 == 0 {
        return 1;
    }
    if op1 == op2 {
        return 1;
    }
    return 0;
}

pub fn pauli_terms_qubitwise_commute(t1: &PauliTerm, t2: &PauliTerm) -> Int {
    let n: Int = t1.num_qubits;
    let mut i: Int = 0;
    while i < n {
        let o1: Int = list_get(t1.operators, i);
        let o2: Int = list_get(t2.operators, i);
        if paulis_commute_single(o1, o2) == 0 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

pub fn pauli_terms_commute_general(t1: &PauliTerm, t2: &PauliTerm) -> Int {
    let n: Int = t1.num_qubits;
    let mut anticommuting_count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let o1: Int = list_get(t1.operators, i);
        let o2: Int = list_get(t2.operators, i);
        if o1 != 0 && o2 != 0 && o1 != o2 {
            anticommuting_count = anticommuting_count + 1;
        }
        i = i + 1;
    }
    if anticommuting_count % 2 == 0 {
        return 1;
    }
    return 0;
}

pub fn pauli_hamiltonian_evaluate_z_only(ham: &PauliHamiltonian, z_exp_vals: List[Float]) -> Float {
    let mut total_energy: Float = 0.0;
    let n_terms: Int = ham.num_terms;
    let terms_list: List[PauliTerm] = ham.terms;
    let mut i: Int = 0;
    while i < n_terms {
        let term: PauliTerm = list_get(terms_list, i);
        let mut term_val: Float = term.coeff;
        let num_q: Int = term.num_qubits;
        let ops: List[Int] = term.operators;
        let mut q: Int = 0;
        while q < num_q {
            let op: Int = list_get(ops, q);
            if op == 3 {
                let z_val: Float = list_get(z_exp_vals, q);
                term_val = term_val * z_val;
            }
            q = q + 1;
        }
        total_energy = total_energy + term_val;
        i = i + 1;
    }
    return total_energy;
}
