// # Standard Clifford Randomized Benchmarking (RB)
//
// Logline: Measures average quantum gate fidelities and error rates per Clifford operation via random sequence decays.
//
// Setup: Scalable QCVV protocol robust against state preparation and measurement (SPAM) errors.
//
// Beats:
//   1. Configure sequence lengths $m \in \{1, 2, 4, 8, 16, 32, 64, \dots\}$ and Clifford group sampling.
//   2. Compute inversion gate $C_{inv} = (C_m \dots C_1)^\dagger$ returning register to $|0\dots0\rangle$.
//   3. Fit exponential decay curve $P(m) = A p^m + B$ to extract depolarizing parameter $p$ and average error per Clifford $r_{Clifford}$.

pub type RbConfig = struct {
    num_qubits: Int,
    dimension_d: Int, // 2^n
    num_seeds_per_length: Int,
    max_sequence_length: Int
};

pub fn rb_config_new(num_qubits: Int, seeds: Int, max_len: Int) -> RbConfig {
    let mut dim: Int = 1;
    let mut i: Int = 0;
    while i < num_qubits {
        dim = dim * 2;
        i = i + 1;
    }
    return RbConfig {
        num_qubits: num_qubits,
        dimension_d: dim,
        num_seeds_per_length: seeds,
        max_sequence_length: max_len
    };
}

pub type RbDataPoint = struct {
    sequence_length: Int,
    survival_probability: Float,
    standard_deviation: Float
};

pub type RbFitResult = struct {
    depolarizing_param_p: Float,
    amplitude_a: Float,
    offset_b: Float,
    average_gate_fidelity: Float,
    error_per_clifford: Float
};

pub fn rb_compute_fidelity(cfg: &RbConfig, p_param: Float) -> RbFitResult {
    let d_f: Float = if cfg.dimension_d == 2 { 2.0 } else { 4.0 };
    // F_avg = 1 - (d-1)/d * (1 - p) = (1 + (d-1)*p) / d
    let factor: Float = (d_f - 1.0) / d_f;
    let r_cliff: Float = factor * (1.0 - p_param);
    let f_avg: Float = 1.0 - r_cliff;

    return RbFitResult {
        depolarizing_param_p: p_param,
        amplitude_a: 0.5,
        offset_b: 0.5,
        average_gate_fidelity: f_avg,
        error_per_clifford: r_cliff
    };
}

pub fn rb_clifford_to_primitive_gate_error(error_per_clifford: Float, avg_primitive_gates_per_clifford: Float) -> Float {
    if avg_primitive_gates_per_clifford <= 0.0 {
        return error_per_clifford;
    }
    return error_per_clifford / avg_primitive_gates_per_clifford;
}
