// # Memory Leak and Heap Growth Detector
//
// Logline: Track allocated heap bytes, arena watermarks, and object counts to prove 0-byte memory leak over sustained soak cycles.
//
// Setup: Used by the soak runner to inspect heap deltas before and after workload execution.
//
// Beats:
//   1. Sample initial baseline memory usage and object counts.
//   2. Record periodic memory snapshots during workload processing.
//   3. Compute net memory delta between baseline and final state.
//   4. Assert that net memory growth equals exactly zero bytes.

pub type SoakLeakDetectorSnapshot = struct {
    snapshot_id: Int,
    allocated_bytes: Int,
    active_objects: Int,
    freelist_nodes: Int
};

pub type SoakLeakDetectorReport = struct {
    initial_bytes: Int,
    final_bytes: Int,
    net_growth_bytes: Int,
    is_zero_leak_verified: Bool
};

pub fn soak_leak_detector_snapshot_new(id: Int, alloc_b: Int, objs: Int, free_n: Int) -> SoakLeakDetectorSnapshot { return SoakLeakDetectorSnapshot {
        snapshot_id: id,
        allocated_bytes: alloc_b,
        active_objects: objs,
        freelist_nodes: free_n
    }; }

pub fn soak_leak_detector_evaluate(initial: SoakLeakDetectorSnapshot, final_snap: SoakLeakDetectorSnapshot) -> SoakLeakDetectorReport {
    let init_b: Int = initial.allocated_bytes;
    let fin_b: Int = final_snap.allocated_bytes;
    let diff: Int = fin_b - init_b;
    let is_zero: Bool = (diff == 0);

    return SoakLeakDetectorReport {
        initial_bytes: init_b,
        final_bytes: fin_b,
        net_growth_bytes: diff,
        is_zero_leak_verified: is_zero
    };
}
