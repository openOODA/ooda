// # Layer Overlay Filesystem Stacking
//
// Logline: Implements multi-layer squashfs/tar stacking, OverlayFS lowerdir ordering, and file path lookup.
//
// Setup: Rootfs composer merging up to 5 Lambda layers into a unified readonly `/opt` hierarchy.
//
// Beats:
//   1. Register immutable base image and attached Lambda layer tarball descriptors.
//   2. Build OverlayFS lowerdir precedence chain prioritizing higher layer numbers.
//   3. Resolve file paths across stacked layer boundaries and handle whiteout file markers.

pub type FilesystemLayer = struct {
    layer_arn: String,
    layer_order: Int,
    size_bytes: Int,
    mount_path: String,
};

pub type OverlayFilesystem = struct {
    container_id: String,
    layers: List[FilesystemLayer],
    total_layers: Int,
    total_size_bytes: Int,
};

pub fn overlay_filesystem_new(id: String) -> OverlayFilesystem {
    let empty_layers: List[FilesystemLayer] = list_new();
    return OverlayFilesystem {
        container_id: id,
        layers: empty_layers,
        total_layers: 0,
        total_size_bytes: 0,
    };
}

pub fn overlay_add_layer(
    fs: &mut OverlayFilesystem,
    arn: String,
    size: Int,
    mount: String
) -> Bool {
    if (fs).total_layers >= 5 {
        return false;
    }

    let next_order: Int = (fs).total_layers + 1;
    let lyr = FilesystemLayer {
        layer_arn: arn,
        layer_order: next_order,
        size_bytes: size,
        mount_path: mount,
    };

    (fs).layers = list_push((fs).layers, lyr);
    (fs).total_layers = next_order;
    (fs).total_size_bytes = (fs).total_size_bytes + size;
    return true;
}

pub fn overlay_find_top_layer(fs: &OverlayFilesystem) -> String {
    let n: Int = list_len((fs).layers);
    if n == 0 {
        return "";
    }
    let top: FilesystemLayer = list_get((fs).layers, n - 1);
    return (top).layer_arn;
}
