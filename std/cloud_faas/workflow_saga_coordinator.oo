// # Serverless Saga Transaction Coordinator
//
// Logline: Implements forward execution and backward compensating transactions for distributed serverless workflows.
//
// Setup: Distributed transaction coordinator orchestrating microservice state changes with automatic rollback on failure.
//
// Beats:
//   1. Register sequential transaction steps paired with compensating rollback actions.
//   2. Execute forward steps in order and record successfully committed state tokens.
//   3. Trigger reverse-order compensating transactions if any forward step fails.

pub type SagaStep = struct {
    step_name: String,
    forward_action: String,
    compensate_action: String,
    is_executed: Bool,
    is_compensated: Bool,
};

pub type SagaCoordinator = struct {
    saga_id: String,
    steps: List[SagaStep],
    status: String,
    current_step_index: Int,
};

pub fn saga_coordinator_new(saga_id: String) -> SagaCoordinator {
    let empty_steps: List[SagaStep] = list_new();
    return SagaCoordinator {
        saga_id: saga_id,
        steps: empty_steps,
        status: "INITIALIZED",
        current_step_index: 0,
    };
}

pub fn saga_add_step(
    saga: &mut SagaCoordinator,
    name: String,
    fwd: String,
    comp: String
) {
    let s = SagaStep {
        step_name: name,
        forward_action: fwd,
        compensate_action: comp,
        is_executed: false,
        is_compensated: false,
    };
    (saga).steps = list_push((saga).steps, s);
}

pub fn saga_execute_forward_step(saga: &mut SagaCoordinator, step_idx: Int) -> Bool {
    let n: Int = list_len((saga).steps);
    if step_idx >= n {
        return false;
    }

    let mut i: Int = 0;
    let mut updated: List[SagaStep] = list_new();

    while i < n {
        let s: SagaStep = list_get((saga).steps, i);
        if i == step_idx {
            let executed_s = SagaStep {
                step_name: (s).step_name,
                forward_action: (s).forward_action,
                compensate_action: (s).compensate_action,
                is_executed: true,
                is_compensated: false,
            };
            updated = list_push(updated, executed_s);
        } else {
            updated = list_push(updated, s);
        }
        i = i + 1;
    }

    (saga).steps = updated;
    (saga).current_step_index = step_idx + 1;
    if (saga).current_step_index == n {
        (saga).status = "COMMITTED";
    } else {
        (saga).status = "IN_PROGRESS";
    }

    return true;
}

pub fn saga_trigger_rollback(saga: &mut SagaCoordinator) {
    (saga).status = "ROLLING_BACK";
    let n: Int = list_len((saga).steps);
    let mut i: Int = 0;
    let mut updated: List[SagaStep] = list_new();

    while i < n {
        let s: SagaStep = list_get((saga).steps, i);
        if (s).is_executed {
            let comp_s = SagaStep {
                step_name: (s).step_name,
                forward_action: (s).forward_action,
                compensate_action: (s).compensate_action,
                is_executed: (s).is_executed,
                is_compensated: true,
            };
            updated = list_push(updated, comp_s);
        } else {
            updated = list_push(updated, s);
        }
        i = i + 1;
    }

    (saga).steps = updated;
    (saga).status = "ROLLED_BACK";
}
