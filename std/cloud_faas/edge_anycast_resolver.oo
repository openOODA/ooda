// # Edge Anycast Worker Resolver
//
// Logline: Implements Edge Point-of-Presence (PoP) geo-routing and lowest-RTT worker selection.
//
// Setup: Global serverless DNS and Anycast BGP routing layer steering client invocations to the closest edge node.
//
// Beats:
//   1. Maintain global registry of Edge PoP locations, latencies, and worker capacity.
//   2. Calculate lowest Round-Trip-Time (RTT) destination for client geographic region.
//   3. Seamlessly fail over to secondary regional PoPs upon primary edge node degradation.

pub type EdgePopNode = struct {
    pop_id: String,
    region_code: String,
    estimated_rtt_ms: Int,
    available_capacity: Int,
    is_healthy: Bool,
};

pub type EdgeAnycastResolver = struct {
    client_region: String,
    pops: List[EdgePopNode],
    total_resolutions: Int,
};

pub fn edge_anycast_resolver_new(client_region: String) -> EdgeAnycastResolver {
    let empty_pops: List[EdgePopNode] = list_new();
    return EdgeAnycastResolver {
        client_region: client_region,
        pops: empty_pops,
        total_resolutions: 0,
    };
}

pub fn edge_resolver_add_pop(
    resolver: &mut EdgeAnycastResolver,
    pop_id: String,
    region: String,
    rtt: Int,
    cap: Int
) {
    let p = EdgePopNode {
        pop_id: pop_id,
        region_code: region,
        estimated_rtt_ms: rtt,
        available_capacity: cap,
        is_healthy: true,
    };
    (resolver).pops = list_push((resolver).pops, p);
}

pub fn edge_resolver_find_nearest(resolver: &mut EdgeAnycastResolver) -> String {
    (resolver).total_resolutions = (resolver).total_resolutions + 1;
    let n: Int = list_len((resolver).pops);
    let mut i: Int = 0;
    let mut best_pop: String = "";
    let mut min_rtt: Int = 999999;

    while i < n {
        let p: EdgePopNode = list_get((resolver).pops, i);
        if (p).is_healthy && (p).available_capacity > 0 {
            if (p).estimated_rtt_ms < min_rtt {
                min_rtt = (p).estimated_rtt_ms;
                best_pop = (p).pop_id;
            }
        }
        i = i + 1;
    }

    return best_pop;
}
