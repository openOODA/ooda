// # Execution Timeout Watchdog
//
// Logline: Implements hard and soft invocation deadline watchdog timers with thread interrupt signals.
//
// Setup: Precision timer arming preemptive thread interrupts before hard container termination triggers.
//
// Beats:
//   1. Arm execution timer with soft alert deadline and hard container kill threshold.
//   2. Fire soft timeout signal to trigger in-memory stack trace logging and abort handlers.
//   3. Force kill unresponsive worker processes upon hard execution deadline expiration.
//
// Int-floor destub. last_tick: 0 IDLE, 1 RUNNING, 2 SOFT_WARNING, 3 HARD_TIMEOUT.
// Soft threshold is 90 percent of duration: (timeout_duration_ms * 9) / 10.
// Flags are Int 0/1.

type WatchdogTimer = struct {
    invocation_id: Int,
    timeout_duration_ms: Int,
    started_at_ms: Int,
    is_armed: Int,
    soft_deadline_fired: Int,
    hard_deadline_fired: Int,
    last_tick: Int
};

pub fn execution_watchdog_new(id: Int, duration_ms: Int) -> WatchdogTimer {
    return WatchdogTimer {
        invocation_id: id,
        timeout_duration_ms: duration_ms,
        started_at_ms: 0,
        is_armed: 0,
        soft_deadline_fired: 0,
        hard_deadline_fired: 0,
        last_tick: 0
    };
}

pub fn watchdog_arm(timer: WatchdogTimer, now_ms: Int) -> WatchdogTimer {
    return WatchdogTimer {
        invocation_id: timer.invocation_id,
        timeout_duration_ms: timer.timeout_duration_ms,
        started_at_ms: now_ms,
        is_armed: 1,
        soft_deadline_fired: 0,
        hard_deadline_fired: 0,
        last_tick: timer.last_tick
    };
}

pub fn watchdog_disarm(timer: WatchdogTimer) -> WatchdogTimer {
    return WatchdogTimer {
        invocation_id: timer.invocation_id,
        timeout_duration_ms: timer.timeout_duration_ms,
        started_at_ms: timer.started_at_ms,
        is_armed: 0,
        soft_deadline_fired: timer.soft_deadline_fired,
        hard_deadline_fired: timer.hard_deadline_fired,
        last_tick: timer.last_tick
    };
}

pub fn watchdog_tick(timer: WatchdogTimer, now_ms: Int) -> WatchdogTimer {
    if timer.is_armed == 0 {
        return WatchdogTimer {
            invocation_id: timer.invocation_id,
            timeout_duration_ms: timer.timeout_duration_ms,
            started_at_ms: timer.started_at_ms,
            is_armed: 0,
            soft_deadline_fired: timer.soft_deadline_fired,
            hard_deadline_fired: timer.hard_deadline_fired,
            last_tick: 0
        };
    }
    let elapsed: Int = now_ms - timer.started_at_ms;
    if elapsed >= timer.timeout_duration_ms {
        return WatchdogTimer {
            invocation_id: timer.invocation_id,
            timeout_duration_ms: timer.timeout_duration_ms,
            started_at_ms: timer.started_at_ms,
            is_armed: 0,
            soft_deadline_fired: timer.soft_deadline_fired,
            hard_deadline_fired: 1,
            last_tick: 3
        };
    }
    let soft_thresh: Int = (timer.timeout_duration_ms * 9) / 10;
    if elapsed >= soft_thresh {
        if timer.soft_deadline_fired == 0 {
            return WatchdogTimer {
                invocation_id: timer.invocation_id,
                timeout_duration_ms: timer.timeout_duration_ms,
                started_at_ms: timer.started_at_ms,
                is_armed: 1,
                soft_deadline_fired: 1,
                hard_deadline_fired: 0,
                last_tick: 2
            };
        }
    }
    return WatchdogTimer {
        invocation_id: timer.invocation_id,
        timeout_duration_ms: timer.timeout_duration_ms,
        started_at_ms: timer.started_at_ms,
        is_armed: 1,
        soft_deadline_fired: timer.soft_deadline_fired,
        hard_deadline_fired: 0,
        last_tick: 1
    };
}
