// # Serverless Cost Calculator & Metering
//
// Logline: Implements GB-second memory duration metering, request pricing accounting, and tier billing.
//
// Setup: Financial metering engine calculating precise execution costs based on memory tier and execution duration.
//
// Beats:
//   1. Measure duration in 1ms rounded increments and memory allocation in megabytes.
//   2. Compute total GB-seconds consumed across invocation batches.
//   3. Apply unit pricing rates per million requests and per GB-second tier.

pub type InvocationBillingRecord = struct {
    duration_ms: Int,
    memory_mb: Int,
    gb_seconds_micro: Int,
    cost_micro_usd: Int
};

pub type ServerlessCostCalculator = struct {
    cost_per_million_requests_cents: Int,
    cost_per_gb_second_micro_cents: Int,
    total_invocations: Int,
    total_gb_seconds_micro: Int,
    total_cost_micro_cents: Int
};

pub fn serverless_cost_calculator_new() -> ServerlessCostCalculator {
    return ServerlessCostCalculator {
        cost_per_million_requests_cents: 20, // $0.20 per 1M requests
        cost_per_gb_second_micro_cents: 1667, // $0.00001667 per GB-s
        total_invocations: 0,
        total_gb_seconds_micro: 0,
        total_cost_micro_cents: 0
    };
}

pub fn cost_calculator_meter_invocation(
    calc: &mut ServerlessCostCalculator,
    duration_ms: Int,
    memory_mb: Int
) -> InvocationBillingRecord {
    // GB-seconds = (memory_mb / 1024) * (duration_ms / 1000)
    // Micro GB-seconds = (memory_mb * duration_ms * 1000) / 1024
    let gb_sec_micro: Int = (memory_mb * duration_ms * 1000) / 1024;
    let cost_duration: Int = (gb_sec_micro * (calc).cost_per_gb_second_micro_cents) / 1000000;
    let cost_request: Int = (calc).cost_per_million_requests_cents / 1000;
    let total_item_cost: Int = cost_duration + cost_request;

    (calc).total_invocations = (calc).total_invocations + 1;
    (calc).total_gb_seconds_micro = (calc).total_gb_seconds_micro + gb_sec_micro;
    (calc).total_cost_micro_cents = (calc).total_cost_micro_cents + total_item_cost;

    return InvocationBillingRecord {
        duration_ms: duration_ms,
        memory_mb: memory_mb,
        gb_seconds_micro: gb_sec_micro,
        cost_micro_usd: total_item_cost
    };
}
