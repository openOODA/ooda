// # Function Execution Context & Deadline Clock
//
// Logline: Implements invocation metadata headers, remaining execution deadline clock, and client context.
//
// Setup: Context object injected into function runtime handlers providing execution bounds and tracing links.
//
// Beats:
//   1. Store invocation ARN, request ID, memory limit, and log stream identifiers.
//   2. Calculate remaining execution time in milliseconds against hard deadline.
//   3. Extract client context headers and distributed tracing span propagation IDs.

pub type FunctionExecutionContext = struct {
    aws_request_id: String,
    invoked_function_arn: String,
    memory_limit_in_mb: Int,
    log_group_name: String,
    log_stream_name: String,
    deadline_ms: Int,
    trace_id: String,
};

pub fn function_execution_context_new(
    req_id: String,
    arn: String,
    mem_mb: Int,
    timeout_ms: Int,
    start_ms: Int,
    trace_id: String
) -> FunctionExecutionContext {
    return FunctionExecutionContext {
        aws_request_id: req_id,
        invoked_function_arn: arn,
        memory_limit_in_mb: mem_mb,
        log_group_name: "/aws/lambda/default",
        log_stream_name: "stream-001",
        deadline_ms: start_ms + timeout_ms,
        trace_id: trace_id,
    };
}

pub fn context_get_remaining_time_ms(ctx: &FunctionExecutionContext, now_ms: Int) -> Int {
    let rem: Int = (ctx).deadline_ms - now_ms;
    if rem < 0 {
        return 0;
    }
    return rem;
}

pub fn context_is_expired(ctx: &FunctionExecutionContext, now_ms: Int) -> Bool {
    return now_ms >= (ctx).deadline_ms;
}
