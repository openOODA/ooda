// # Telemetry API Subscription Manager
//
// Logline: Implements Lambda Telemetry API event subscription and dispatch for APM observability extensions.
//
// Setup: Internal telemetry broker streaming platform, function, and extension events directly to companion daemons.
//
// Beats:
//   1. Register extension subscriber listeners for platform and function event streams.
//   2. Configure buffering policies (maxItems, maxBytes, timeoutMs) per extension.
//   3. Dispatch telemetry batches and monitor subscriber buffer pressure.

pub type TelemetrySubscriber = struct {
    extension_name: String,
    destination_uri: String,
    types_mask: Int, // 1: platform, 2: function, 4: extension
    max_items: Int,
    is_active: Bool,
};

pub type TelemetryApiManager = struct {
    subscribers: List[TelemetrySubscriber],
    total_events_dispatched: Int,
};

pub fn telemetry_api_manager_new() -> TelemetryApiManager {
    let empty_subs: List[TelemetrySubscriber] = list_new();
    return TelemetryApiManager {
        subscribers: empty_subs,
        total_events_dispatched: 0,
    };
}

pub fn telemetry_subscribe(
    mgr: &mut TelemetryApiManager,
    name: String,
    uri: String,
    mask: Int,
    max_items: Int
) {
    let sub = TelemetrySubscriber {
        extension_name: name,
        destination_uri: uri,
        types_mask: mask,
        max_items: max_items,
        is_active: true,
    };
    (mgr).subscribers = list_push((mgr).subscribers, sub);
}

pub fn telemetry_dispatch_event(
    mgr: &mut TelemetryApiManager,
    event_type_bit: Int
) -> Int {
    let n: Int = list_len((mgr).subscribers);
    let mut i: Int = 0;
    let mut dispatched: Int = 0;

    while i < n {
        let sub: TelemetrySubscriber = list_get((mgr).subscribers, i);
        if (sub).is_active {
            // Check bitwise mask match (assuming positive non-zero check)
            if (sub).types_mask >= event_type_bit {
                dispatched = dispatched + 1;
            }
        }
        i = i + 1;
    }

    (mgr).total_events_dispatched = (mgr).total_events_dispatched + dispatched;
    return dispatched;
}
