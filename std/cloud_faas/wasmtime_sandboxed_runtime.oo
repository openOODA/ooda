// # Wasmtime Sandboxed Runtime Engine
//
// Logline: Implements WebAssembly Wasmtime sandbox instance pooling, fuel consumption metering, and memory bounds.
//
// Setup: Ultra-lightweight sub-millisecond WebAssembly serverless execution runtime with deterministic metering.
//
// Beats:
//   1. Pool pre-compiled Wasm modules and instantiate isolated instances with linear memory limits.
//   2. Meter instruction execution cycles using deterministic fuel consumption limits.
//   3. Recycle instances on execution completion or trap on out-of-fuel and memory faults.

pub type WasmInstance = struct {
    instance_id: String,
    module_name: String,
    initial_fuel: Int,
    remaining_fuel: Int,
    max_memory_pages: Int,
    is_busy: Bool
};

pub type WasmtimeRuntimePool = struct {
    pool_id: String,
    instances: List[WasmInstance],
    max_pool_size: Int,
    total_invocations: Int,
    out_of_fuel_count: Int
};

pub fn wasmtime_runtime_pool_new(pool_id: String, max_size: Int) -> WasmtimeRuntimePool {
    let empty_instances: List[WasmInstance] = list_new();
    return WasmtimeRuntimePool {
        pool_id: pool_id,
        instances: empty_instances,
        max_pool_size: max_size,
        total_invocations: 0,
        out_of_fuel_count: 0
    };
}

pub fn wasmtime_register_instance(
    pool: &mut WasmtimeRuntimePool,
    inst_id: String,
    mod_name: String,
    fuel_limit: Int,
    max_pages: Int
) -> Bool {
    let count: Int = list_len((pool).instances);
    if count >= (pool).max_pool_size {
        return false;
    }

    let inst = WasmInstance {
        instance_id: inst_id,
        module_name: mod_name,
        initial_fuel: fuel_limit,
        remaining_fuel: fuel_limit,
        max_memory_pages: max_pages,
        is_busy: false
    };

    (pool).instances = list_push((pool).instances, inst);
    return true;
}

pub fn wasmtime_execute(
    pool: &mut WasmtimeRuntimePool,
    inst_id: String,
    fuel_consumed: Int
) -> Bool {
    let n: Int = list_len((pool).instances);
    let mut i: Int = 0;
    let mut updated: List[WasmInstance] = list_new();
    let mut success: Bool = false;

    while i < n {
        let inst: WasmInstance = list_get((pool).instances, i);
        if (inst).instance_id == inst_id && !(inst).is_busy {
            (pool).total_invocations = (pool).total_invocations + 1;
            if fuel_consumed > (inst).remaining_fuel {
                (pool).out_of_fuel_count = (pool).out_of_fuel_count + 1;
                let faulted = WasmInstance {
                    instance_id: (inst).instance_id,
                    module_name: (inst).module_name,
                    initial_fuel: (inst).initial_fuel,
                    remaining_fuel: 0,
                    max_memory_pages: (inst).max_memory_pages,
                    is_busy: false
                };
                updated = list_push(updated, faulted);
            } else {
                let executed = WasmInstance {
                    instance_id: (inst).instance_id,
                    module_name: (inst).module_name,
                    initial_fuel: (inst).initial_fuel,
                    remaining_fuel: (inst).remaining_fuel - fuel_consumed,
                    max_memory_pages: (inst).max_memory_pages,
                    is_busy: false
                };
                updated = list_push(updated, executed);
                success = true;
            }
        } else {
            updated = list_push(updated, inst);
        }
        i = i + 1;
    }

    (pool).instances = updated;
    return success;
}

pub fn wasmtime_reset_instance_fuel(pool: &mut WasmtimeRuntimePool, inst_id: String) {
    let n: Int = list_len((pool).instances);
    let mut i: Int = 0;
    let mut updated: List[WasmInstance] = list_new();

    while i < n {
        let inst: WasmInstance = list_get((pool).instances, i);
        if (inst).instance_id == inst_id {
            let reset_inst = WasmInstance {
                instance_id: (inst).instance_id,
                module_name: (inst).module_name,
                initial_fuel: (inst).initial_fuel,
                remaining_fuel: (inst).initial_fuel,
                max_memory_pages: (inst).max_memory_pages,
                is_busy: false
            };
            updated = list_push(updated, reset_inst);
        } else {
            updated = list_push(updated, inst);
        }
        i = i + 1;
    }

    (pool).instances = updated;
}
