// # Event Source Mapping Poller & Bisector
//
// Logline: Implements event source batch windowing, tumbling windows, and batch bisection on error.
//
// Setup: Stream/queue poller feeding event batches into serverless functions with auto-bisection on unhandled exceptions.
//
// Beats:
//   1. Configure batch size, max batching window in seconds, and bisect-on-error flags.
//   2. Accumulate incoming records until batch size or batch window expires.
//   3. Bisect failed batches into two smaller sub-batches to pinpoint problematic poison records.

pub type StreamRecord = struct {
    record_id: String,
    data_length_bytes: Int,
    is_poison: Bool,
};

pub type EventSourceMapping = struct {
    mapping_uuid: String,
    target_function_arn: String,
    batch_size: Int,
    batch_window_seconds: Int,
    bisect_batch_on_error: Bool,
    current_records: List[StreamRecord],
    total_batches_processed: Int,
    total_bisections: Int,
};

pub fn event_source_mapping_new(
    uuid: String,
    fn_arn: String,
    batch_size: Int,
    window_sec: Int,
    bisect: Bool
) -> EventSourceMapping {
    let empty_records: List[StreamRecord] = list_new();
    return EventSourceMapping {
        mapping_uuid: uuid,
        target_function_arn: fn_arn,
        batch_size: batch_size,
        batch_window_seconds: window_sec,
        bisect_batch_on_error: bisect,
        current_records: empty_records,
        total_batches_processed: 0,
        total_bisections: 0,
    };
}

pub fn esm_add_record(
    esm: &mut EventSourceMapping,
    rec_id: String,
    len_bytes: Int,
    poison: Bool
) -> Bool {
    let rec = StreamRecord {
        record_id: rec_id,
        data_length_bytes: len_bytes,
        is_poison: poison,
    };

    (esm).current_records = list_push((esm).current_records, rec);
    let count: Int = list_len((esm).current_records);
    return count >= (esm).batch_size;
}

pub fn esm_flush_batch(esm: &mut EventSourceMapping) -> Int {
    let count: Int = list_len((esm).current_records);
    let empty_records: List[StreamRecord] = list_new();
    (esm).current_records = empty_records;
    (esm).total_batches_processed = (esm).total_batches_processed + 1;
    return count;
}

pub fn esm_trigger_bisect(esm: &mut EventSourceMapping) -> Int {
    let count: Int = list_len((esm).current_records);
    if !(esm).bisect_batch_on_error || count <= 1 {
        return count;
    }

    (esm).total_bisections = (esm).total_bisections + 1;
    return count / 2;
}
