// # Snapshot Diff Brancher & Delta Tree
//
// Logline: Implements Copy-on-Write (COW) memory snapshot branching and layered delta trees for instant fork-exec.
//
// Setup: Hierarchical snapshot manager enabling thousands of functions to branch from shared base runtime states.
//
// Beats:
//   1. Establish tree of immutable base snapshots and mutable child delta branches.
//   2. Fork new execution sandboxes with zero initial memory copy overhead.
//   3. Track branch modifications in local delta overlays while referencing parent nodes.

pub type SnapshotBranch = struct {
    branch_id: String,
    parent_id: String,
    delta_bytes: Int,
    created_at_ms: Int,
    is_frozen: Bool
};

pub type SnapshotDeltaTree = struct {
    root_id: String,
    branches: List[SnapshotBranch],
    total_forks: Int
};

pub fn snapshot_delta_tree_new(root_id: String) -> SnapshotDeltaTree {
    let empty_branches: List[SnapshotBranch] = list_new();
    let root = SnapshotBranch {
        branch_id: root_id,
        parent_id: "",
        delta_bytes: 0,
        created_at_ms: 0,
        is_frozen: true
    };
    let initial: List[SnapshotBranch] = list_push(empty_branches, root);

    return SnapshotDeltaTree {
        root_id: root_id,
        branches: initial,
        total_forks: 0
    };
}

pub fn snapshot_fork_branch(
    tree: &mut SnapshotDeltaTree,
    parent_id: String,
    new_id: String,
    now_ms: Int
) -> Bool {
    let branch = SnapshotBranch {
        branch_id: new_id,
        parent_id: parent_id,
        delta_bytes: 0,
        created_at_ms: now_ms,
        is_frozen: false
    };

    (tree).branches = list_push((tree).branches, branch);
    (tree).total_forks = (tree).total_forks + 1;
    return true;
}

pub fn snapshot_record_delta(
    tree: &mut SnapshotDeltaTree,
    branch_id: String,
    bytes_written: Int
) -> Bool {
    let n: Int = list_len((tree).branches);
    let mut i: Int = 0;
    let mut updated: List[SnapshotBranch] = list_new();
    let mut found: Bool = false;

    while i < n {
        let b: SnapshotBranch = list_get((tree).branches, i);
        if (b).branch_id == branch_id && !(b).is_frozen {
            let updated_b = SnapshotBranch {
                branch_id: (b).branch_id,
                parent_id: (b).parent_id,
                delta_bytes: (b).delta_bytes + bytes_written,
                created_at_ms: (b).created_at_ms,
                is_frozen: false
            };
            updated = list_push(updated, updated_b);
            found = true;
        } else {
            updated = list_push(updated, b);
        }
        i = i + 1;
    }

    (tree).branches = updated;
    return found;
}
