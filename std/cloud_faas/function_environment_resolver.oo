// # Function Environment Variable Resolver
//
// Logline: Implements environment configuration injection, secret resolution, and KMS decryption caching.
//
// Setup: Configuration provider injecting decrypted environment variables and secret tokens into worker instances.
//
// Beats:
//   1. Store key-value pairs representing function environment variables.
//   2. Resolve encrypted parameter references and decrypt secret ciphertext.
//   3. Cache decrypted secret plaintext to avoid repeated KMS calls during warm invocations.

pub type EnvVar = struct {
    key: String,
    value: String,
    is_secret: Bool,
    is_decrypted: Bool,
};

pub type EnvironmentResolver = struct {
    function_name: String,
    variables: List[EnvVar],
    cache_hits: Int,
    decryption_count: Int,
};

pub fn environment_resolver_new(fn_name: String) -> EnvironmentResolver {
    let empty_vars: List[EnvVar] = list_new();
    return EnvironmentResolver {
        function_name: fn_name,
        variables: empty_vars,
        cache_hits: 0,
        decryption_count: 0,
    };
}

pub fn environment_set_var(
    res: &mut EnvironmentResolver,
    k: String,
    v: String,
    secret: Bool
) {
    let variable = EnvVar {
        key: k,
        value: v,
        is_secret: secret,
        is_decrypted: !secret,
    };
    (res).variables = list_push((res).variables, variable);
}

pub fn environment_resolve_var(
    res: &mut EnvironmentResolver,
    k: String,
    decrypted_secret_val: String
) -> String {
    let n: Int = list_len((res).variables);
    let mut i: Int = 0;
    let mut updated: List[EnvVar] = list_new();
    let mut resolved_val: String = "";

    while i < n {
        let v: EnvVar = list_get((res).variables, i);
        if (v).key == k {
            if (v).is_secret {
                if (v).is_decrypted {
                    (res).cache_hits = (res).cache_hits + 1;
                    resolved_val = (v).value;
                    updated = list_push(updated, v);
                } else {
                    (res).decryption_count = (res).decryption_count + 1;
                    resolved_val = decrypted_secret_val;
                    let decrypted_v = EnvVar {
                        key: (v).key,
                        value: decrypted_secret_val,
                        is_secret: true,
                        is_decrypted: true,
                    };
                    updated = list_push(updated, decrypted_v);
                }
            } else {
                resolved_val = (v).value;
                updated = list_push(updated, v);
            }
        } else {
            updated = list_push(updated, v);
        }
        i = i + 1;
    }

    (res).variables = updated;
    return resolved_val;
}
