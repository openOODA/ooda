// # State Machine Choice Rule Evaluator
//
// Logline: Implements Boolean comparison operators (StringEquals, NumericGreaterThan, IsPresent) for workflow branching.
//
// Setup: Choice state evaluator inspecting input variables to decide workflow branch transitions.
//
// Beats:
//   1. Define Choice rule conditions with variable path, operator, and expected value.
//   2. Evaluate integer and string equality/relational comparison operators.
//   3. Return next transition target state or proceed to default fallback state.

pub type ChoiceCondition = struct {
    variable_name: String,
    operator: String,
    expected_int_value: Int,
    next_state: String,
};

pub type ChoiceRuleEvaluator = struct {
    default_state: String,
    conditions: List[ChoiceCondition],
};

pub fn choice_evaluator_new(default_state: String) -> ChoiceRuleEvaluator {
    let empty_conditions: List[ChoiceCondition] = list_new();
    return ChoiceRuleEvaluator {
        default_state: default_state,
        conditions: empty_conditions,
    };
}

pub fn choice_add_condition(
    evaluator: &mut ChoiceRuleEvaluator,
    var_name: String,
    op: String,
    expected_val: Int,
    next_st: String
) {
    let cond = ChoiceCondition {
        variable_name: var_name,
        operator: op,
        expected_int_value: expected_val,
        next_state: next_st,
    };
    (evaluator).conditions = list_push((evaluator).conditions, cond);
}

pub fn choice_evaluate_int(
    evaluator: &ChoiceRuleEvaluator,
    var_name: String,
    actual_val: Int
) -> String {
    let n: Int = list_len((evaluator).conditions);
    let mut i: Int = 0;

    while i < n {
        let cond: ChoiceCondition = list_get((evaluator).conditions, i);
        if (cond).variable_name == var_name {
            if (cond).operator == "NumericEquals" && actual_val == (cond).expected_int_value {
                return (cond).next_state;
            }
            if (cond).operator == "NumericGreaterThan" && actual_val > (cond).expected_int_value {
                return (cond).next_state;
            }
            if (cond).operator == "NumericLessThan" && actual_val < (cond).expected_int_value {
                return (cond).next_state;
            }
        }
        i = i + 1;
    }

    return (evaluator).default_state;
}
