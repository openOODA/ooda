pub fn cloud_faas_firecracker(vm_id: String, vcpus: Int, mem_mb: Int) -> FirecrackerSnapshotManager {
    return firecracker_snapshot_manager_new(vm_id, vcpus, mem_mb);
}

pub fn cloud_faas_gvisor(sandbox_id: String) -> GvisorSentryInterceptor {
    return gvisor_interceptor_new(sandbox_id);
}

pub fn cloud_faas_wasmtime(pool_id: String, max_size: Int) -> WasmtimeRuntimePool {
    return wasmtime_runtime_pool_new(pool_id, max_size);
}

pub fn cloud_faas_cold_start_opt(fn_name: String, min_w: Int, max_w: Int) -> ColdStartOptimizer {
    return cold_start_optimizer_new(fn_name, min_w, max_w);
}

pub fn cloud_faas_router(router_id: String) -> FaasInvocationRouter {
    return faas_invocation_router_new(router_id);
}

pub fn cloud_faas_eventbridge(bus: String) -> EventBridgeRouter {
    return eventbridge_router_new(bus);
}

pub fn cloud_faas_concurrency(region: String, limit: Int) -> RegionalConcurrencyPool {
    return regional_concurrency_pool_new(region, limit);
}

pub fn cloud_faas_execution_context(
    req_id: String,
    arn: String,
    mem_mb: Int,
    timeout_ms: Int,
    start_ms: Int,
    trace_id: String
) -> FunctionExecutionContext {
    return function_execution_context_new(req_id, arn, mem_mb, timeout_ms, start_ms, trace_id);
}

pub fn cloud_faas_state_machine(arn: String, start_state: String) -> StateMachineExecution {
    return state_machine_execution_new(arn, start_state);
}

pub fn cloud_faas_cost_calc() -> ServerlessCostCalculator {
    return serverless_cost_calculator_new();
}
