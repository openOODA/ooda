// # Distributed Tracing Propagator
//
// Logline: Implements W3C TraceContext and AWS X-Ray header parsing, sampling decisions, and span injection.
//
// Setup: Distributed tracing injector extracting trace parents from inbound triggers and propagating context downstream.
//
// Beats:
//   1. Parse `traceparent` (version-trace_id-parent_id-flags) and `_X_AMZN_TRACE_ID` headers.
//   2. Make deterministic probabilistic sampling decisions based on trace flags and sample rates.
//   3. Format outgoing distributed trace headers for child service calls.

pub type TraceContext = struct {
    trace_id: String,
    parent_span_id: String,
    current_span_id: String,
    is_sampled: Bool,
};

pub type TracingPropagator = struct {
    service_name: String,
    sample_rate_percent: Int,
    total_traces: Int,
    sampled_traces: Int,
};

pub fn tracing_propagator_new(service_name: String, sample_percent: Int) -> TracingPropagator {
    return TracingPropagator {
        service_name: service_name,
        sample_rate_percent: sample_percent,
        total_traces: 0,
        sampled_traces: 0,
    };
}

pub fn tracing_create_root_context(
    prop: &mut TracingPropagator,
    trace_id: String,
    span_id: String,
    random_factor: Int
) -> TraceContext {
    (prop).total_traces = (prop).total_traces + 1;
    let sampled: Bool = (random_factor % 100) < (prop).sample_rate_percent;

    if sampled {
        (prop).sampled_traces = (prop).sampled_traces + 1;
    }

    return TraceContext {
        trace_id: trace_id,
        parent_span_id: "",
        current_span_id: span_id,
        is_sampled: sampled,
    };
}

pub fn tracing_create_child_context(
    parent_ctx: &TraceContext,
    child_span_id: String
) -> TraceContext {
    return TraceContext {
        trace_id: (parent_ctx).trace_id,
        parent_span_id: (parent_ctx).current_span_id,
        current_span_id: child_span_id,
        is_sampled: (parent_ctx).is_sampled,
    };
}
