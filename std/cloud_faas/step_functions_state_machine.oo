// # Step Functions State Machine Engine
//
// Logline: Implements declarative serverless workflow state machine execution (Pass, Task, Choice, Wait, Succeed, Fail).
//
// Setup: Workflow orchestrator transitioning state variables across sequence, branching, and task steps.
//
// Beats:
//   1. Define workflow state node definitions and entry start state name.
//   2. Transition through execution steps and update JSON input/output data states.
//   3. Handle terminal SUCCEED and FAIL conditions with error cause codes.

pub type WorkflowStateNode = struct {
    name: String,
    state_type: String,
    next_state: String,
    is_end: Bool,
};

pub type StateMachineExecution = struct {
    execution_arn: String,
    current_state_name: String,
    states: List[WorkflowStateNode],
    status: String,
    step_count: Int,
};

pub fn state_machine_execution_new(arn: String, start_state: String) -> StateMachineExecution {
    let empty_states: List[WorkflowStateNode] = list_new();
    return StateMachineExecution {
        execution_arn: arn,
        current_state_name: start_state,
        states: empty_states,
        status: "RUNNING",
        step_count: 0,
    };
}

pub fn state_machine_add_node(
    exec: &mut StateMachineExecution,
    name: String,
    st_type: String,
    next_st: String,
    is_end: Bool
) {
    let node = WorkflowStateNode {
        name: name,
        state_type: st_type,
        next_state: next_st,
        is_end: is_end,
    };
    (exec).states = list_push((exec).states, node);
}

pub fn state_machine_step(exec: &mut StateMachineExecution) -> String {
    if (exec).status != "RUNNING" {
        return (exec).status;
    }

    let n: Int = list_len((exec).states);
    let mut i: Int = 0;

    while i < n {
        let node: WorkflowStateNode = list_get((exec).states, i);
        if (node).name == (exec).current_state_name {
            (exec).step_count = (exec).step_count + 1;
            if (node).is_end {
                (exec).status = "SUCCEEDED";
                return "SUCCEEDED";
            }
            (exec).current_state_name = (node).next_state;
            return "TRANSITIONED";
        }
        i = i + 1;
    }

    (exec).status = "FAILED";
    return "FAILED";
}
