// # Asynchronous Request Buffered Queue
//
// Logline: Implements bounded priority invocation queues with head-of-line blocking prevention for async FaaS.
//
// Setup: Internal buffering pipeline holding asynchronous invocation events before worker scheduling.
//
// Beats:
//   1. Enqueue asynchronous invocation payloads with priority tier and timestamp tags.
//   2. Dequeue events in priority and FIFO sequence within configured burst limits.
//   3. Handle queue depth overflow by shedding low-priority requests to dead-letter storage.
//
// Int-floor destub: request ids are Int; parallel List[Int] slots.
// Implemented order is FIFO (head index 0), matching the prior push/pop body.

type RequestBufferedQueue = struct {
    queue_id: Int,
    capacity: Int,
    req_ids: List[Int],
    priorities: List[Int],
    sizes: List[Int],
    enqueued_at: List[Int],
    dropped_total: Int,
    enqueued_total: Int,
    dequeued_total: Int,
    last_pop_id: Int,
    last_ok: Int
};

pub fn request_buffered_queue_new(id: Int, capacity: Int) -> RequestBufferedQueue {
    let empty_ids: List[Int] = list_new();
    let empty_pri: List[Int] = list_new();
    let empty_sizes: List[Int] = list_new();
    let empty_at: List[Int] = list_new();
    return RequestBufferedQueue {
        queue_id: id,
        capacity: capacity,
        req_ids: empty_ids,
        priorities: empty_pri,
        sizes: empty_sizes,
        enqueued_at: empty_at,
        dropped_total: 0,
        enqueued_total: 0,
        dequeued_total: 0,
        last_pop_id: 0,
        last_ok: 0
    };
}

pub fn request_queue_push(
    queue: RequestBufferedQueue,
    req_id: Int,
    priority: Int,
    size_bytes: Int,
    now_ms: Int
) -> RequestBufferedQueue {
    let current: Int = list_len(queue.req_ids);
    if current >= queue.capacity {
        return RequestBufferedQueue {
            queue_id: queue.queue_id,
            capacity: queue.capacity,
            req_ids: queue.req_ids,
            priorities: queue.priorities,
            sizes: queue.sizes,
            enqueued_at: queue.enqueued_at,
            dropped_total: queue.dropped_total + 1,
            enqueued_total: queue.enqueued_total,
            dequeued_total: queue.dequeued_total,
            last_pop_id: queue.last_pop_id,
            last_ok: 0
        };
    }
    return RequestBufferedQueue {
        queue_id: queue.queue_id,
        capacity: queue.capacity,
        req_ids: list_push(queue.req_ids, req_id),
        priorities: list_push(queue.priorities, priority),
        sizes: list_push(queue.sizes, size_bytes),
        enqueued_at: list_push(queue.enqueued_at, now_ms),
        dropped_total: queue.dropped_total,
        enqueued_total: queue.enqueued_total + 1,
        dequeued_total: queue.dequeued_total,
        last_pop_id: queue.last_pop_id,
        last_ok: 1
    };
}

pub fn request_queue_pop(queue: RequestBufferedQueue) -> RequestBufferedQueue {
    let current: Int = list_len(queue.req_ids);
    if current == 0 {
        return RequestBufferedQueue {
            queue_id: queue.queue_id,
            capacity: queue.capacity,
            req_ids: queue.req_ids,
            priorities: queue.priorities,
            sizes: queue.sizes,
            enqueued_at: queue.enqueued_at,
            dropped_total: queue.dropped_total,
            enqueued_total: queue.enqueued_total,
            dequeued_total: queue.dequeued_total,
            last_pop_id: 0,
            last_ok: 0
        };
    }
    let head_id: Int = list_get(queue.req_ids, 0);
    let mut rest_ids: List[Int] = list_new();
    let mut rest_pri: List[Int] = list_new();
    let mut rest_sizes: List[Int] = list_new();
    let mut rest_at: List[Int] = list_new();
    let mut i: Int = 1;
    while i < current {
        rest_ids = list_push(rest_ids, list_get(queue.req_ids, i));
        rest_pri = list_push(rest_pri, list_get(queue.priorities, i));
        rest_sizes = list_push(rest_sizes, list_get(queue.sizes, i));
        rest_at = list_push(rest_at, list_get(queue.enqueued_at, i));
        i = i + 1;
    }
    return RequestBufferedQueue {
        queue_id: queue.queue_id,
        capacity: queue.capacity,
        req_ids: rest_ids,
        priorities: rest_pri,
        sizes: rest_sizes,
        enqueued_at: rest_at,
        dropped_total: queue.dropped_total,
        enqueued_total: queue.enqueued_total,
        dequeued_total: queue.dequeued_total + 1,
        last_pop_id: head_id,
        last_ok: 1
    };
}
