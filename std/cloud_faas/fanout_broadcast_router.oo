// # Topic Fan-out Broadcast Router
//
// Logline: Implements SNS/PubSub topic fan-out broadcasting with attribute filters and subscription endpoints.
//
// Setup: Asynchronous broadcast router delivering single event publications to hundreds of subscriber queues and lambdas.
//
// Beats:
//   1. Register topic subscription endpoints (SQS, Lambda, HTTP Webhook).
//   2. Evaluate subscription attribute filters against published event messages.
//   3. Fan out matching message envelopes in parallel to subscriber destination targets.

pub type SubscriptionTarget = struct {
    subscription_id: String,
    protocol: String,
    endpoint_arn: String,
    filter_tag: String,
    is_active: Bool,
};

pub type FanoutTopicRouter = struct {
    topic_arn: String,
    subscriptions: List[SubscriptionTarget],
    total_published: Int,
    total_deliveries: Int,
};

pub fn fanout_topic_router_new(arn: String) -> FanoutTopicRouter {
    let empty_subs: List[SubscriptionTarget] = list_new();
    return FanoutTopicRouter {
        topic_arn: arn,
        subscriptions: empty_subs,
        total_published: 0,
        total_deliveries: 0,
    };
}

pub fn fanout_subscribe(
    router: &mut FanoutTopicRouter,
    sub_id: String,
    proto: String,
    endpoint: String,
    tag: String
) {
    let sub = SubscriptionTarget {
        subscription_id: sub_id,
        protocol: proto,
        endpoint_arn: endpoint,
        filter_tag: tag,
        is_active: true,
    };
    (router).subscriptions = list_push((router).subscriptions, sub);
}

pub fn fanout_publish(
    router: &mut FanoutTopicRouter,
    message_tag: String
) -> Int {
    (router).total_published = (router).total_published + 1;
    let n: Int = list_len((router).subscriptions);
    let mut i: Int = 0;
    let mut matched_count: Int = 0;

    while i < n {
        let sub: SubscriptionTarget = list_get((router).subscriptions, i);
        if (sub).is_active {
            if (sub).filter_tag == "*" || (sub).filter_tag == message_tag {
                matched_count = matched_count + 1;
            }
        }
        i = i + 1;
    }

    (router).total_deliveries = (router).total_deliveries + matched_count;
    return matched_count;
}
