// # Connection Pool Warm Cache
//
// Logline: Implements database and HTTP client connection pooling across serverless invocations with health verification.
//
// Setup: Connection cache retaining open TCP/TLS sockets in global scope across warm invocations.
//
// Beats:
//   1. Retain active database connections in global execution context across invocations.
//   2. Validate socket liveness via ping/heartbeat health probes before serving new queries.
//   3. Prune idle or terminated connections to prevent connection leaks on database clusters.

pub type CachedConnection = struct {
    connection_id: String,
    endpoint: String,
    created_at_ms: Int,
    last_used_at_ms: Int,
    is_healthy: Bool,
    is_leased: Bool
};

pub type ConnectionPoolWarmCache = struct {
    max_pool_size: Int,
    idle_ttl_ms: Int,
    connections: List[CachedConnection],
    total_reused: Int
};

pub fn connection_pool_warm_cache_new(
    max_size: Int,
    ttl_ms: Int
) -> ConnectionPoolWarmCache {
    let empty_conns: List[CachedConnection] = list_new();
    return ConnectionPoolWarmCache {
        max_pool_size: max_size,
        idle_ttl_ms: ttl_ms,
        connections: empty_conns,
        total_reused: 0
    };
}

pub fn connection_pool_add(
    pool: &mut ConnectionPoolWarmCache,
    conn_id: String,
    endpoint: String,
    now_ms: Int
) -> Bool {
    let count: Int = list_len((pool).connections);
    if count >= (pool).max_pool_size {
        return false;
    }

    let conn = CachedConnection {
        connection_id: conn_id,
        endpoint: endpoint,
        created_at_ms: now_ms,
        last_used_at_ms: now_ms,
        is_healthy: true,
        is_leased: false
    };

    (pool).connections = list_push((pool).connections, conn);
    return true;
}

pub fn connection_pool_acquire(
    pool: &mut ConnectionPoolWarmCache,
    now_ms: Int
) -> String {
    let n: Int = list_len((pool).connections);
    let mut i: Int = 0;
    let mut updated: List[CachedConnection] = list_new();
    let mut acquired_id: String = "";

    while i < n {
        let c: CachedConnection = list_get((pool).connections, i);
        let is_expired: Bool = (now_ms - (c).last_used_at_ms) > (pool).idle_ttl_ms;

        if (c).is_healthy && !(c).is_leased && !is_expired && acquired_id == "" {
            acquired_id = (c).connection_id;
            let leased_conn = CachedConnection {
                connection_id: (c).connection_id,
                endpoint: (c).endpoint,
                created_at_ms: (c).created_at_ms,
                last_used_at_ms: now_ms,
                is_healthy: true,
                is_leased: true
            };
            updated = list_push(updated, leased_conn);
            (pool).total_reused = (pool).total_reused + 1;
        } else {
            updated = list_push(updated, c);
        }
        i = i + 1;
    }

    (pool).connections = updated;
    return acquired_id;
}

pub fn connection_pool_release(
    pool: &mut ConnectionPoolWarmCache,
    conn_id: String,
    now_ms: Int
) {
    let n: Int = list_len((pool).connections);
    let mut i: Int = 0;
    let mut updated: List[CachedConnection] = list_new();

    while i < n {
        let c: CachedConnection = list_get((pool).connections, i);
        if (c).connection_id == conn_id {
            let freed_conn = CachedConnection {
                connection_id: (c).connection_id,
                endpoint: (c).endpoint,
                created_at_ms: (c).created_at_ms,
                last_used_at_ms: now_ms,
                is_healthy: (c).is_healthy,
                is_leased: false
            };
            updated = list_push(updated, freed_conn);
        } else {
            updated = list_push(updated, c);
        }
        i = i + 1;
    }

    (pool).connections = updated;
}
