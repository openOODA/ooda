// # Execution Metrics & Telemetry Aggregator
//
// Logline: Implements latency histogram percentiles (p50/p90/p99), cold start ratio, and error rate tracking.
//
// Setup: Operational observability engine aggregating high-cardinality performance telemetry for serverless functions.
//
// Beats:
//   1. Track invocation durations, init durations, and HTTP status codes.
//   2. Calculate cold-start percentages and error rates across sliding time windows.
//   3. Export structured summary records to observability backends.

pub type InvocationMetric = struct {
    duration_ms: Int,
    init_duration_ms: Int,
    is_cold_start: Bool,
    is_error: Bool
};

pub type MetricsAggregator = struct {
    function_name: String,
    metrics: List[InvocationMetric],
    total_invocations: Int,
    total_cold_starts: Int,
    total_errors: Int,
    sum_duration_ms: Int
};

pub fn metrics_aggregator_new(fn_name: String) -> MetricsAggregator {
    let empty_metrics: List[InvocationMetric] = list_new();
    return MetricsAggregator {
        function_name: fn_name,
        metrics: empty_metrics,
        total_invocations: 0,
        total_cold_starts: 0,
        total_errors: 0,
        sum_duration_ms: 0
    };
}

pub fn metrics_record_invocation(
    agg: &mut MetricsAggregator,
    duration_ms: Int,
    init_ms: Int,
    cold: Bool,
    err: Bool
) {
    let m = InvocationMetric {
        duration_ms: duration_ms,
        init_duration_ms: init_ms,
        is_cold_start: cold,
        is_error: err
    };

    (agg).metrics = list_push((agg).metrics, m);
    (agg).total_invocations = (agg).total_invocations + 1;
    (agg).sum_duration_ms = (agg).sum_duration_ms + duration_ms;

    if cold {
        (agg).total_cold_starts = (agg).total_cold_starts + 1;
    }
    if err {
        (agg).total_errors = (agg).total_errors + 1;
    }
}

pub fn metrics_get_cold_start_percent(agg: &MetricsAggregator) -> Int {
    if (agg).total_invocations == 0 {
        return 0;
    }
    return ((agg).total_cold_starts * 100) / (agg).total_invocations;
}

pub fn metrics_get_error_percent(agg: &MetricsAggregator) -> Int {
    if (agg).total_invocations == 0 {
        return 0;
    }
    return ((agg).total_errors * 100) / (agg).total_invocations;
}

pub fn metrics_get_avg_duration_ms(agg: &MetricsAggregator) -> Int {
    if (agg).total_invocations == 0 {
        return 0;
    }
    return (agg).sum_duration_ms / (agg).total_invocations;
}
