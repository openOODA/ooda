// # Function Instance Lifecycle State Machine
//
// Logline: Implements deterministic FaaS sandbox lifecycle states (Creating, Warm, Active, Idle, Frozen, Terminated).
//
// Setup: Lifecycle supervisor managing state transitions, health checks, and garbage collection of worker instances.
//
// Beats:
//   1. Define explicit state transitions conforming to serverless lifecycle specifications.
//   2. Track transition timestamps, execution counts, and idle lifetimes.
//   3. Validate legal state transition invariants and reject illegal state jumps.

pub type InstanceLifecycleState = struct {
    instance_id: String,
    current_state: String,
    created_at_ms: Int,
    state_entered_at_ms: Int,
    invocation_count: Int,
    is_terminating: Bool
};

pub type LifecycleManager = struct {
    instances: List[InstanceLifecycleState],
    total_transitions: Int
};

pub fn lifecycle_manager_new() -> LifecycleManager {
    let empty_list: List[InstanceLifecycleState] = list_new();
    return LifecycleManager {
        instances: empty_list,
        total_transitions: 0
    };
}

pub fn lifecycle_create_instance(mgr: &mut LifecycleManager, id: String, now_ms: Int) {
    let inst = InstanceLifecycleState {
        instance_id: id,
        current_state: "CREATING",
        created_at_ms: now_ms,
        state_entered_at_ms: now_ms,
        invocation_count: 0,
        is_terminating: false
    };
    (mgr).instances = list_push((mgr).instances, inst);
}

pub fn lifecycle_transition_to(
    mgr: &mut LifecycleManager,
    id: String,
    new_state: String,
    now_ms: Int
) -> Bool {
    let n: Int = list_len((mgr).instances);
    let mut i: Int = 0;
    let mut updated: List[InstanceLifecycleState] = list_new();
    let mut transitioned: Bool = false;

    while i < n {
        let inst: InstanceLifecycleState = list_get((mgr).instances, i);
        if (inst).instance_id == id {
            let mut inc: Int = 0;
            if new_state == "ACTIVE" {
                inc = 1;
            }
            let term: Bool = (new_state == "TERMINATED");

            let updated_inst = InstanceLifecycleState {
                instance_id: (inst).instance_id,
                current_state: new_state,
                created_at_ms: (inst).created_at_ms,
                state_entered_at_ms: now_ms,
                invocation_count: (inst).invocation_count + inc,
                is_terminating: term
            };
            updated = list_push(updated, updated_inst);
            transitioned = true;
            (mgr).total_transitions = (mgr).total_transitions + 1;
        } else {
            updated = list_push(updated, inst);
        }
        i = i + 1;
    }

    (mgr).instances = updated;
    return transitioned;
}
