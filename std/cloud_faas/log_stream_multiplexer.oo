// # Log Stream Multiplexer & Batch Flusher
//
// Logline: Implements structured JSON log buffering, chunking, and batched export to CloudWatch Logs.
//
// Setup: High-throughput log agent capturing stdout/stderr from serverless runtimes with non-blocking flush.
//
// Beats:
//   1. Buffer log events with timestamps, message contents, and severity log levels.
//   2. Enforce batch size limits (e.g. 1MB or 10,000 log events per batch flush).
//   3. Drain and flush log batches asynchronously without blocking invocation completion.

pub type LogEvent = struct {
    timestamp_ms: Int,
    log_level: String,
    message: String,
    size_bytes: Int,
};

pub type LogStreamMultiplexer = struct {
    log_stream_name: String,
    max_batch_bytes: Int,
    current_batch_bytes: Int,
    events: List[LogEvent],
    total_events_logged: Int,
    total_batches_flushed: Int,
};

pub fn log_stream_multiplexer_new(
    stream_name: String,
    max_bytes: Int
) -> LogStreamMultiplexer {
    let empty_events: List[LogEvent] = list_new();
    return LogStreamMultiplexer {
        log_stream_name: stream_name,
        max_batch_bytes: max_bytes,
        current_batch_bytes: 0,
        events: empty_events,
        total_events_logged: 0,
        total_batches_flushed: 0,
    };
}

pub fn log_append(
    mux: &mut LogStreamMultiplexer,
    ts_ms: Int,
    level: String,
    msg: String,
    msg_size: Int
) -> Bool {
    let evt = LogEvent {
        timestamp_ms: ts_ms,
        log_level: level,
        message: msg,
        size_bytes: msg_size,
    };

    (mux).events = list_push((mux).events, evt);
    (mux).current_batch_bytes = (mux).current_batch_bytes + msg_size;
    (mux).total_events_logged = (mux).total_events_logged + 1;

    return (mux).current_batch_bytes >= (mux).max_batch_bytes;
}

pub fn log_flush_batch(mux: &mut LogStreamMultiplexer) -> Int {
    let count: Int = list_len((mux).events);
    let empty_events: List[LogEvent] = list_new();
    (mux).events = empty_events;
    (mux).current_batch_bytes = 0;
    (mux).total_batches_flushed = (mux).total_batches_flushed + 1;
    return count;
}
