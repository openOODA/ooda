// # Custom Runtime Bootstrap HTTP API
//
// Logline: Implements AWS Lambda Custom Runtime API loop endpoints (/next, /response, /error).
//
// Setup: HTTP serverless interface facilitating communication between container runtime and custom code handler.
//
// Beats:
//   1. Poll `/runtime/invocation/next` for the next invocation event and request ID.
//   2. Post execution result payload to `/runtime/invocation/{AwsRequestId}/response`.
//   3. Handle handler errors and runtime initialization crashes via error reporting endpoints.

pub type InvocationPayload = struct {
    aws_request_id: String,
    payload_json: String,
    trace_header: String,
    deadline_ms: Int
};

pub type RuntimeBootstrapApi = struct {
    endpoint_host: String,
    port: Int,
    current_invocation: InvocationPayload,
    is_polling: Bool,
    successful_responses: Int,
    reported_errors: Int
};

pub fn runtime_bootstrap_api_new(host: String, port: Int) -> RuntimeBootstrapApi {
    let empty_payload = InvocationPayload {
        aws_request_id: "",
        payload_json: "",
        trace_header: "",
        deadline_ms: 0
    };

    return RuntimeBootstrapApi {
        endpoint_host: host,
        port: port,
        current_invocation: empty_payload,
        is_polling: false,
        successful_responses: 0,
        reported_errors: 0
    };
}

pub fn runtime_api_receive_next(
    api: &mut RuntimeBootstrapApi,
    req_id: String,
    payload: String,
    trace: String,
    deadline: Int
) {
    (api).current_invocation.aws_request_id = req_id;
    (api).current_invocation.payload_json = payload;
    (api).current_invocation.trace_header = trace;
    (api).current_invocation.deadline_ms = deadline;
    (api).is_polling = true;
}

pub fn runtime_api_send_response(api: &mut RuntimeBootstrapApi, req_id: String) -> Bool {
    if (api).current_invocation.aws_request_id == req_id {
        (api).successful_responses = (api).successful_responses + 1;
        (api).is_polling = false;
        return true;
    }
    return false;
}

pub fn runtime_api_send_error(api: &mut RuntimeBootstrapApi, req_id: String) -> Bool {
    if (api).current_invocation.aws_request_id == req_id {
        (api).reported_errors = (api).reported_errors + 1;
        (api).is_polling = false;
        return true;
    }
    return false;
}
