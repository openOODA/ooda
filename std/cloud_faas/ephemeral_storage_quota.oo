// # Ephemeral Storage Scratch Quota Manager
//
// Logline: Implements /tmp scratch storage quota enforcement, file allocation tracking, and sandbox disk bounds.
//
// Setup: Filesystem quota supervisor bounding ephemeral disk consumption between 512MB and 10GB per container.
//
// Beats:
//   1. Track /tmp directory allocation size against provisioned storage quota.
//   2. Authorize or reject file write operations exceeding maximum megabyte thresholds.
//   3. Reclaim deleted scratch files and calculate remaining free storage bytes.

pub type EphemeralFile = struct {
    file_path: String,
    size_mb: Int,
    is_deleted: Bool,
};

pub type EphemeralStorageQuota = struct {
    sandbox_id: String,
    max_quota_mb: Int,
    used_mb: Int,
    files: List[EphemeralFile],
    quota_exceeded_count: Int,
};

pub fn ephemeral_storage_quota_new(id: String, quota_mb: Int) -> EphemeralStorageQuota {
    let empty_files: List[EphemeralFile] = list_new();
    return EphemeralStorageQuota {
        sandbox_id: id,
        max_quota_mb: quota_mb,
        used_mb: 0,
        files: empty_files,
        quota_exceeded_count: 0,
    };
}

pub fn ephemeral_storage_allocate(
    storage: &mut EphemeralStorageQuota,
    path: String,
    size_mb: Int
) -> Bool {
    if (storage).used_mb + size_mb > (storage).max_quota_mb {
        (storage).quota_exceeded_count = (storage).quota_exceeded_count + 1;
        return false;
    }

    let f = EphemeralFile {
        file_path: path,
        size_mb: size_mb,
        is_deleted: false,
    };

    (storage).files = list_push((storage).files, f);
    (storage).used_mb = (storage).used_mb + size_mb;
    return true;
}

pub fn ephemeral_storage_delete_file(
    storage: &mut EphemeralStorageQuota,
    path: String
) -> Bool {
    let n: Int = list_len((storage).files);
    let mut i: Int = 0;
    let mut updated: List[EphemeralFile] = list_new();
    let mut found: Bool = false;

    while i < n {
        let f: EphemeralFile = list_get((storage).files, i);
        if (f).file_path == path && !(f).is_deleted {
            let del_f = EphemeralFile {
                file_path: (f).file_path,
                size_mb: (f).size_mb,
                is_deleted: true,
            };
            updated = list_push(updated, del_f);
            (storage).used_mb = (storage).used_mb - (f).size_mb;
            found = true;
        } else {
            updated = list_push(updated, f);
        }
        i = i + 1;
    }

    (storage).files = updated;
    return found;
}
