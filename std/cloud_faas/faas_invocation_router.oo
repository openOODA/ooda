// # FaaS Invocation Router & Load Balancer
//
// Logline: Implements latency-aware, affinity-based function invocation routing and worker dispatch.
//
// Setup: High-throughput invocation gateway routing synchronous and asynchronous execution payloads to worker hosts.
//
// Beats:
//   1. Register worker host capacities, active execution counts, and locality affinity keys.
//   2. Select optimal worker host using least-connections and warm-instance affinity heuristics.
//   3. Update worker load states and handle failover retries on worker unavailability.

pub type WorkerNode = struct {
    worker_id: String,
    region: String,
    active_invocations: Int,
    max_capacity: Int,
    is_healthy: Bool,
};

pub type FaasInvocationRouter = struct {
    router_id: String,
    workers: List[WorkerNode],
    total_routed: Int,
    total_rejected: Int,
};

pub fn faas_invocation_router_new(router_id: String) -> FaasInvocationRouter {
    let empty_workers: List[WorkerNode] = list_new();
    return FaasInvocationRouter {
        router_id: router_id,
        workers: empty_workers,
        total_routed: 0,
        total_rejected: 0,
    };
}

pub fn faas_router_add_worker(
    router: &mut FaasInvocationRouter,
    w_id: String,
    region: String,
    cap: Int
) {
    let w = WorkerNode {
        worker_id: w_id,
        region: region,
        active_invocations: 0,
        max_capacity: cap,
        is_healthy: true,
    };
    (router).workers = list_push((router).workers, w);
}

pub fn faas_router_dispatch(router: &mut FaasInvocationRouter) -> String {
    let n: Int = list_len((router).workers);
    let mut i: Int = 0;
    let mut best_worker_id: String = "";
    let mut min_load: Int = 99999999;

    while i < n {
        let w: WorkerNode = list_get((router).workers, i);
        if (w).is_healthy && (w).active_invocations < (w).max_capacity {
            if (w).active_invocations < min_load {
                min_load = (w).active_invocations;
                best_worker_id = (w).worker_id;
            }
        }
        i = i + 1;
    }

    if best_worker_id == "" {
        (router).total_rejected = (router).total_rejected + 1;
        return "";
    }

    // Increment active count on selected worker
    let mut updated: List[WorkerNode] = list_new();
    i = 0;
    while i < n {
        let w: WorkerNode = list_get((router).workers, i);
        if (w).worker_id == best_worker_id {
            let updated_w = WorkerNode {
                worker_id: (w).worker_id,
                region: (w).region,
                active_invocations: (w).active_invocations + 1,
                max_capacity: (w).max_capacity,
                is_healthy: (w).is_healthy,
            };
            updated = list_push(updated, updated_w);
        } else {
            updated = list_push(updated, w);
        }
        i = i + 1;
    }

    (router).workers = updated;
    (router).total_routed = (router).total_routed + 1;
    return best_worker_id;
}

pub fn faas_router_complete(router: &mut FaasInvocationRouter, w_id: String) {
    let n: Int = list_len((router).workers);
    let mut i: Int = 0;
    let mut updated: List[WorkerNode] = list_new();

    while i < n {
        let w: WorkerNode = list_get((router).workers, i);
        if (w).worker_id == w_id {
            let mut new_active: Int = (w).active_invocations - 1;
            if new_active < 0 {
                new_active = 0;
            }
            let updated_w = WorkerNode {
                worker_id: (w).worker_id,
                region: (w).region,
                active_invocations: new_active,
                max_capacity: (w).max_capacity,
                is_healthy: (w).is_healthy,
            };
            updated = list_push(updated, updated_w);
        } else {
            updated = list_push(updated, w);
        }
        i = i + 1;
    }

    (router).workers = updated;
}
