// # Serverless Autoscaler PID Controller
//
// Logline: Implements Proportional-Integral-Derivative (PID) loop feedback for worker fleet autoscaling.
//
// Setup: Reactive and predictive autoscaling controller adjusting worker pool capacity based on queue backlog and latency.
//
// Beats:
//   1. Measure error delta between target concurrency utilization and current observed worker load.
//   2. Compute proportional, integral (historical error sum), and derivative (rate of change) adjustments.
//   3. Scale worker target capacity clamped within configured minimum and maximum limits.

pub type PidControllerState = struct {
    kp: Int,
    ki: Int,
    kd: Int,
    target_concurrency: Int,
    integral_error: Int,
    last_error: Int,
    current_workers: Int,
    min_workers: Int,
    max_workers: Int
};

pub fn autoscaler_pid_new(
    kp: Int,
    ki: Int,
    kd: Int,
    target: Int,
    min_w: Int,
    max_w: Int
) -> PidControllerState {
    return PidControllerState {
        kp: kp,
        ki: ki,
        kd: kd,
        target_concurrency: target,
        integral_error: 0,
        last_error: 0,
        current_workers: min_w,
        min_workers: min_w,
        max_workers: max_w
    };
}

pub fn autoscaler_calculate_target(
    pid: &mut PidControllerState,
    observed_concurrency: Int
) -> Int {
    let error: Int = observed_concurrency - (pid).target_concurrency;
    (pid).integral_error = (pid).integral_error + error;
    let derivative: Int = error - (pid).last_error;
    (pid).last_error = error;

    let p_term: Int = (pid).kp * error;
    let i_term: Int = (pid).ki * (pid).integral_error;
    let d_term: Int = (pid).kd * derivative;

    let adjustment: Int = (p_term + i_term + d_term) / 100;
    let mut new_workers: Int = (pid).current_workers + adjustment;

    if new_workers < (pid).min_workers {
        new_workers = (pid).min_workers;
    }
    if new_workers > (pid).max_workers {
        new_workers = (pid).max_workers;
    }

    (pid).current_workers = new_workers;
    return new_workers;
}
