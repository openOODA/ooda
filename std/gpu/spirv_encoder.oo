// # SPIR-V 32-bit word encoder
//
// Logline: Emits a Vulkan SPIR-V compute header and named Op words as a deterministic 32-bit word stream.
//
// Setup: Imports spirv_types.oo. Pure. No capability tokens. Not a device launch.
//
// Beats:
//   1. Emit the five-word header: magic, version, generator, bound, schema.
//   2. Build OpCapability, OpMemoryModel, OpTypeFloat, OpTypeVector, OpFunction, and OpMatrixTimesVector.
//   3. Append word lists so a fixture can assemble one compute module stream.

import "./spirv_types.oo";

pub fn spirv_encoder_header(version: Int, generator: Int, bound: Int, schema: Int) -> List[Int] {
    let mut w: List[Int] = list_new();
    w = list_push(w, spirv_types_magic());
    w = list_push(w, version);
    w = list_push(w, generator);
    w = list_push(w, bound);
    w = list_push(w, schema);
    return w;
}

pub fn spirv_encoder_header_default(bound: Int) -> List[Int] {
    return spirv_encoder_header(
        spirv_types_version(),
        spirv_types_generator(),
        bound,
        spirv_types_schema()
    );
}

pub fn spirv_encoder_append(dst: List[Int], src: List[Int]) -> List[Int] {
    let mut out: List[Int] = dst;
    let n: Int = list_len(src);
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, list_get(src, i));
        i = i + 1;
    }
    return out;
}

pub fn spirv_encoder_op_capability(cap: Int) -> List[Int] {
    let mut w: List[Int] = list_new();
    w = list_push(w, spirv_types_word(2, spirv_types_op_capability()));
    w = list_push(w, cap);
    return w;
}

pub fn spirv_encoder_op_memory_model(addr: Int, mem: Int) -> List[Int] {
    let mut w: List[Int] = list_new();
    w = list_push(w, spirv_types_word(3, spirv_types_op_memory_model()));
    w = list_push(w, addr);
    w = list_push(w, mem);
    return w;
}

pub fn spirv_encoder_op_type_float(result_id: Int, width: Int) -> List[Int] {
    let mut w: List[Int] = list_new();
    w = list_push(w, spirv_types_word(3, spirv_types_op_type_float()));
    w = list_push(w, result_id);
    w = list_push(w, width);
    return w;
}

pub fn spirv_encoder_op_type_vector(result_id: Int, comp_type: Int, count: Int) -> List[Int] {
    let mut w: List[Int] = list_new();
    w = list_push(w, spirv_types_word(4, spirv_types_op_type_vector()));
    w = list_push(w, result_id);
    w = list_push(w, comp_type);
    w = list_push(w, count);
    return w;
}

pub fn spirv_encoder_op_function(result_type: Int, result_id: Int, control: Int, fn_type: Int) -> List[Int] {
    let mut w: List[Int] = list_new();
    w = list_push(w, spirv_types_word(5, spirv_types_op_function()));
    w = list_push(w, result_type);
    w = list_push(w, result_id);
    w = list_push(w, control);
    w = list_push(w, fn_type);
    return w;
}

pub fn spirv_encoder_op_matrix_times_vector(result_type: Int, result_id: Int, matrix: Int, vector: Int) -> List[Int] {
    let mut w: List[Int] = list_new();
    w = list_push(w, spirv_types_word(5, spirv_types_op_matrix_times_vector()));
    w = list_push(w, result_type);
    w = list_push(w, result_id);
    w = list_push(w, matrix);
    w = list_push(w, vector);
    return w;
}
