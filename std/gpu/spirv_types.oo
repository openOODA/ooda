// # SPIR-V word and opcode constants
//
// Logline: Names the Vulkan SPIR-V magic, header fields, and compute-shader opcodes used by the 32-bit word emitter.
//
// Setup: Pure constants. No capability tokens. Callers import this file.
//
// Beats:
//   1. Publish magic 0x07230203, version, generator, and schema defaults.
//   2. Publish OpCapability, OpMemoryModel, OpTypeFloat, OpTypeVector, OpFunction, and OpMatrixTimesVector.
//   3. Pack an instruction first word as (word_count << 16) | opcode.

pub fn spirv_types_magic() -> Int { return 119734787; }
pub fn spirv_types_version() -> Int { return 66816; }
pub fn spirv_types_generator() -> Int { return 5197636; }
pub fn spirv_types_schema() -> Int { return 0; }

pub fn spirv_types_op_capability() -> Int { return 17; }
pub fn spirv_types_op_memory_model() -> Int { return 14; }
pub fn spirv_types_op_type_float() -> Int { return 22; }
pub fn spirv_types_op_type_vector() -> Int { return 23; }
pub fn spirv_types_op_function() -> Int { return 54; }
pub fn spirv_types_op_matrix_times_vector() -> Int { return 91; }

pub fn spirv_types_cap_shader() -> Int { return 1; }
pub fn spirv_types_addr_logical() -> Int { return 0; }
pub fn spirv_types_mem_glsl450() -> Int { return 1; }

pub fn spirv_types_word(count: Int, opcode: Int) -> Int {
    let hi: Int = (count & 65535) << 16;
    let lo: Int = opcode & 65535;
    return hi + lo;
}

pub fn spirv_types_opcode_of(word: Int) -> Int { return word & 65535; }
pub fn spirv_types_count_of(word: Int) -> Int { return (word >> 16) & 65535; }
