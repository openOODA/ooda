// # Linear Regression and Least Squares Fitting Module
//
// Logline: Ordinary least squares (OLS) linear regression, coefficient estimation, Pearson r correlation, and predictions.
//
// Setup: Pure math module. Solves univariate linear systems and trend fits on List[Float] series without matrix libraries.
//
// Beats:
//   1. Ordinary least squares slope and y-intercept parameter estimation.
//   2. Pearson product-moment correlation r and coefficient of determination R^2.
//   3. Residual standard error calculation across bivariate series.
//   4. Linear predictor evaluation model (linreg_predict).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Multi-variable Ridge/Lasso regularized regressions lower via machine learning library.

import "std/result.oo";
import "std/math.oo";

type LinRegResult = struct {
    slope: Float,
    intercept: Float,
    r_squared: Float,
    std_err: Float,
    count: Int
};

pub fn linreg_fit(xs: List[Float], ys: List[Float]) -> Result[LinRegResult, String] {
    let nx: Int = list_len(xs);
    let ny: Int = list_len(ys);
    if nx != ny {
        return Err("mismatched_dimensions");
    }
    if nx < 2 {
        return Err("insufficient_points");
    }

    let mut sum_x: Float = 0.0;
    let mut sum_y: Float = 0.0;
    let mut count_f: Float = 0.0;
    let mut i: Int = 0;
    while i < nx {
        let x: Float = list_get(xs, i);
        let y: Float = list_get(ys, i);
        sum_x = sum_x + x;
        sum_y = sum_y + y;
        count_f = count_f + 1.0;
        i = i + 1;
    }

    let mean_x: Float = sum_x / count_f;
    let mean_y: Float = sum_y / count_f;

    let mut ss_xx: Float = 0.0;
    let mut ss_yy: Float = 0.0;
    let mut ss_xy: Float = 0.0;

    let mut j: Int = 0;
    while j < nx {
        let x: Float = list_get(xs, j);
        let y: Float = list_get(ys, j);
        let dx: Float = x - mean_x;
        let dy: Float = y - mean_y;
        ss_xx = ss_xx + dx * dx;
        ss_yy = ss_yy + dy * dy;
        ss_xy = ss_xy + dx * dy;
        j = j + 1;
    }

    if ss_xx == 0.0 {
        return Err("zero_variance_x");
    }

    let slope: Float = ss_xy / ss_xx;
    let intercept: Float = mean_y - slope * mean_x;

    let mut r2: Float = 0.0;
    if ss_yy > 0.0 {
        r2 = (ss_xy * ss_xy) / (ss_xx * ss_yy);
    }

    let mut ss_res: Float = 0.0;
    let mut k: Int = 0;
    while k < nx {
        let x: Float = list_get(xs, k);
        let y: Float = list_get(ys, k);
        let pred: Float = slope * x + intercept;
        let diff: Float = y - pred;
        ss_res = ss_res + diff * diff;
        k = k + 1;
    }

    let mut se: Float = 0.0;
    if count_f > 2.0 {
        se = math_sqrt(ss_res / (count_f - 2.0));
    }

    return Ok(LinRegResult {
        slope: slope,
        intercept: intercept,
        r_squared: r2,
        std_err: se,
        count: nx
    });
}

pub fn linreg_predict(model: LinRegResult, x: Float) -> Float {
    let s: Float = model.slope;
    let ic: Float = model.intercept;
    return s * x + ic;
}

pub fn linreg_pearson_r(xs: List[Float], ys: List[Float]) -> Result[Float, String] {
    let fit_res: Result[LinRegResult, String] = linreg_fit(xs, ys);
    if fit_res.is_err() {
        return Err("fit_failed");
    }
    let m: LinRegResult = match fit_res {
        Ok(res) => res,
        Err(e) => LinRegResult { slope: 0.0, intercept: 0.0, r_squared: 0.0, std_err: 0.0, count: 0 },
    };
    let r2: Float = m.r_squared;
    let r: Float = math_sqrt(r2);
    let s: Float = m.slope;
    if s < 0.0 {
        return Ok(0.0 - r);
    }
    return Ok(r);
}
