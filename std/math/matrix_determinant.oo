// # 4x4 Matrix Determinant Module
//
// Logline: Determinant calculation for 4x4 floating-point matrices via 2x2 Laplace expansion.
//
// Setup: Pure math module. Evaluates transformation matrix scaling factor.
//
// Beats:
//   1. Define 4x4 matrix representation.
//   2. Compute 2x2 sub-determinants.
//   3. Compute 4x4 determinant via Laplace expansion.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/simd/simd_vec4f.oo";

type Mat4Det = struct {
    r0: Vec4f,
    r1: Vec4f,
    r2: Vec4f,
    r3: Vec4f
};

pub fn mat4_det_new(r0: Vec4f, r1: Vec4f, r2: Vec4f, r3: Vec4f) -> Mat4Det {
    return Mat4Det { r0: r0, r1: r1, r2: r2, r3: r3 };
}

pub fn mat4_det_compute(m: Mat4Det) -> Float {
    let a00: Float = vec4f_get(m.r0, 0); let a01: Float = vec4f_get(m.r0, 1);
    let a02: Float = vec4f_get(m.r0, 2); let a03: Float = vec4f_get(m.r0, 3);

    let a10: Float = vec4f_get(m.r1, 0); let a11: Float = vec4f_get(m.r1, 1);
    let a12: Float = vec4f_get(m.r1, 2); let a13: Float = vec4f_get(m.r1, 3);

    let a20: Float = vec4f_get(m.r2, 0); let a21: Float = vec4f_get(m.r2, 1);
    let a22: Float = vec4f_get(m.r2, 2); let a23: Float = vec4f_get(m.r2, 3);

    let a30: Float = vec4f_get(m.r3, 0); let a31: Float = vec4f_get(m.r3, 1);
    let a32: Float = vec4f_get(m.r3, 2); let a33: Float = vec4f_get(m.r3, 3);

    let s0: Float = a00 * a11 - a01 * a10;
    let s1: Float = a00 * a12 - a02 * a10;
    let s2: Float = a00 * a13 - a03 * a10;
    let s3: Float = a01 * a12 - a02 * a11;
    let s4: Float = a01 * a13 - a03 * a11;
    let s5: Float = a02 * a13 - a03 * a12;

    let c5: Float = a22 * a33 - a23 * a32;
    let c4: Float = a21 * a33 - a23 * a31;
    let c3: Float = a21 * a32 - a22 * a31;
    let c2: Float = a20 * a33 - a23 * a30;
    let c1: Float = a20 * a32 - a22 * a30;
    let c0: Float = a20 * a31 - a21 * a30;

    return s0 * c5 - s1 * c4 + s2 * c3 + s3 * c2 - s4 * c1 + s5 * c0;
}
