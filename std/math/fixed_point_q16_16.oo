// # Q16.16 Fixed-Point Numeric Arithmetic Module
//
// Logline: 32-bit deterministic Q16.16 fixed-point arithmetic for reproducible simulations without float drift.
//
// Setup: 16-bit integer and 16-bit fractional bit representation (scale factor 65536).
//
// Beats:
//   1. Convert integer and fractional parts to Q16.16 raw values.
//   2. Add and subtract Q16.16 values.
//   3. Multiply and divide Q16.16 numbers with precision scaling.
//   4. Extract whole integer and fractional parts.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type Q16 = struct {
    raw: Int
};

pub fn q16_from_int(v: Int) -> Q16 {
    return Q16 { raw: v * 65536 };
}

pub fn q16_to_int(q: Q16) -> Int {
    let r: Int = q.raw;
    return r / 65536;
}

pub fn q16_add(a: Q16, b: Q16) -> Q16 {
    let ar: Int = a.raw;
    let br: Int = b.raw;
    return Q16 { raw: ar + br };
}

pub fn q16_sub(a: Q16, b: Q16) -> Q16 {
    let ar: Int = a.raw;
    let br: Int = b.raw;
    return Q16 { raw: ar - br };
}

pub fn q16_mul(a: Q16, b: Q16) -> Q16 {
    let ar: Int = a.raw;
    let br: Int = b.raw;
    return Q16 { raw: (ar * br) / 65536 };
}

pub fn q16_div(a: Q16, b: Q16) -> Q16 {
    let ar: Int = a.raw;
    let br: Int = b.raw;
    if br == 0 {
        return Q16 { raw: 0 };
    }
    return Q16 { raw: (ar * 65536) / br };
}
