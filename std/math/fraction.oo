// # Rational Fraction Arithmetic Module
//
// Logline: Exact rational number representation, GCD/LCM reductions, and arithmetic operations.
//
// Setup: Pure math module. Implements exact rational arithmetic with automatic canonical GCD reduction.
//
// Beats:
//   1. Euclidean greatest common divisor (GCD) and least common multiple (LCM).
//   2. Canonical fraction constructor with sign normalization and zero-denominator guard.
//   3. Exact addition, subtraction, multiplication, division, and reciprocal.
//   4. Rational comparisons and string formatting (e.g. "3/4" or "5").
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Operations on 64-bit integers wrap if intermediate numerator/denominator exceeds integer bounds.

type Fraction = struct {
    num: Int,
    den: Int
};

pub fn math_gcd(a: Int, b: Int) -> Int {
    let mut x: Int = a;
    let mut y: Int = b;
    if x < 0 { x = 0 - x; }
    if y < 0 { y = 0 - y; }
    while y != 0 {
        let t: Int = y;
        y = x % y;
        x = t;
    }
    return x;
}

pub fn math_lcm(a: Int, b: Int) -> Int {
    if a == 0 || b == 0 {
        return 0;
    }
    let g: Int = math_gcd(a, b);
    let mut abs_a: Int = a;
    if abs_a < 0 { abs_a = 0 - abs_a; }
    return (abs_a / g) * b;
}

pub fn fraction_simplify(f: Fraction) -> Fraction {
    let mut n: Int = f.num;
    let mut d: Int = f.den;
    if d == 0 {
        return Fraction { num: 0, den: 1 };
    }
    if d < 0 {
        n = 0 - n;
        d = 0 - d;
    }
    let g: Int = math_gcd(n, d);
    if g > 1 {
        n = n / g;
        d = d / g;
    }
    return Fraction { num: n, den: d };
}

pub fn fraction_new(num: Int, den: Int) -> Fraction {
    let raw: Fraction = Fraction { num: num, den: den };
    return fraction_simplify(raw);
}

pub fn fraction_add(a: Fraction, b: Fraction) -> Fraction {
    let an: Int = a.num;
    let ad: Int = a.den;
    let bn: Int = b.num;
    let bd: Int = b.den;
    let new_num: Int = an * bd + bn * ad;
    let new_den: Int = ad * bd;
    return fraction_new(new_num, new_den);
}

pub fn fraction_sub(a: Fraction, b: Fraction) -> Fraction {
    let an: Int = a.num;
    let ad: Int = a.den;
    let bn: Int = b.num;
    let bd: Int = b.den;
    let new_num: Int = an * bd - bn * ad;
    let new_den: Int = ad * bd;
    return fraction_new(new_num, new_den);
}

pub fn fraction_mul(a: Fraction, b: Fraction) -> Fraction {
    let an: Int = a.num;
    let ad: Int = a.den;
    let bn: Int = b.num;
    let bd: Int = b.den;
    return fraction_new(an * bn, ad * bd);
}

pub fn fraction_div(a: Fraction, b: Fraction) -> Fraction {
    let an: Int = a.num;
    let ad: Int = a.den;
    let bn: Int = b.num;
    let bd: Int = b.den;
    return fraction_new(an * bd, ad * bn);
}

pub fn fraction_reciprocal(f: Fraction) -> Fraction {
    let fn_val: Int = f.num;
    let fd_val: Int = f.den;
    return fraction_new(fd_val, fn_val);
}

pub fn fraction_neg(f: Fraction) -> Fraction {
    let fn_val: Int = f.num;
    let fd_val: Int = f.den;
    return Fraction {
        num: 0 - fn_val,
        den: fd_val
    };
}

pub fn fraction_cmp(a: Fraction, b: Fraction) -> Int {
    let diff: Fraction = fraction_sub(a, b);
    let dn: Int = diff.num;
    if dn < 0 { return -1; }
    if dn > 0 { return 1; }
    return 0;
}

pub fn fraction_to_str(f: Fraction) -> String {
    let s: Fraction = fraction_simplify(f);
    let n: Int = s.num;
    let d: Int = s.den;
    if d == 1 {
        return n.to_string();
    }
    return n.to_string() + "/" + d.to_string();
}
