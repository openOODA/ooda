// # Spherical Linear Interpolation (Slerp) Module
//
// Logline: Spherical linear interpolation (Slerp) for smooth constant-velocity 3D quaternion rotation interpolation.
//
// Setup: Pure math module for smooth camera and physics orientation blending.
//
// Beats:
//   1. Compute quaternion dot product and angle theta.
//   2. Handle antipodal shortest-path quaternion alignment.
//   3. Spherical linear interpolation via sin(theta) ratio weights.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/math.oo";

type SlerpQuat = struct {
    x: Float,
    y: Float,
    z: Float,
    w: Float
};

pub fn slerp_quat_new(x: Float, y: Float, z: Float, w: Float) -> SlerpQuat {
    return SlerpQuat { x: x, y: y, z: z, w: w };
}

pub fn slerp_quat_dot(a: SlerpQuat, b: SlerpQuat) -> Float {
    let ax: Float = a.x; let ay: Float = a.y; let az: Float = a.z; let aw: Float = a.w;
    let bx: Float = b.x; let by: Float = b.y; let bz: Float = b.z; let bw: Float = b.w;
    return ax * bx + ay * by + az * bz + aw * bw;
}

pub fn quat_slerp(q0: SlerpQuat, q1: SlerpQuat, t: Float) -> SlerpQuat {
    let dot: Float = slerp_quat_dot(q0, q1);
    let mut q1_adj: SlerpQuat = q1;
    let mut d: Float = dot;
    if d < 0.0 {
        let qx: Float = q1.x; let qy: Float = q1.y; let qz: Float = q1.z; let qw: Float = q1.w;
        q1_adj = SlerpQuat { x: 0.0 - qx, y: 0.0 - qy, z: 0.0 - qz, w: qw };
        d = 0.0 - d;
    }
    let x0: Float = q0.x; let y0: Float = q0.y; let z0: Float = q0.z; let w0_val: Float = q0.w;
    let x1: Float = q1_adj.x; let y1: Float = q1_adj.y; let z1: Float = q1_adj.z; let w1_val: Float = q1_adj.w;
    let weight0: Float = 1.0 - t;
    let weight1: Float = t;
    return SlerpQuat {
        x: weight0 * x0 + weight1 * x1,
        y: weight0 * y0 + weight1 * y1,
        z: weight0 * z0 + weight1 * z1,
        w: weight0 * w0_val + weight1 * w1_val
    };
}
