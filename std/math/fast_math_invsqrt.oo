// # Fast Inverse Square Root Module
//
// Logline: Fast inverse square root 1/sqrt(x) approximation with Newton-Raphson quadratic refinement steps.
//
// Setup: Pure math module. High-throughput numerical 1/sqrt(x) for normalization.
//
// Beats:
//   1. Evaluate seed reciprocal square root.
//   2. Apply Newton-Raphson iteration step: y = y * (1.5 - 0.5 * x * y * y).
//   3. Compute normalized vector magnitude.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/math.oo";

pub fn fast_inv_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let base_sqrt: Float = math_sqrt(x);
    if base_sqrt == 0.0 { return 0.0; }
    let y0: Float = 1.0 / base_sqrt;
    let three_halfs: Float = 1.5;
    let half_x: Float = x * 0.5;
    let y1: Float = y0 * (three_halfs - (half_x * y0 * y0));
    return y1;
}

pub fn fast_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let inv: Float = fast_inv_sqrt(x);
    if inv == 0.0 { return 0.0; }
    return 1.0 / inv;
}
