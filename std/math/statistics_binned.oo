// # Binned Histogram Statistics Module
//
// Logline: Binned histogram frequency distributions, bin intervals, quantile estimation, and modal bin queries.
//
// Setup: Pure statistical aggregation module.
//
// Beats:
//   1. Construct BinnedStats with min/max bounds and bin count.
//   2. Accumulate incoming continuous samples into histogram bins.
//   3. Query bin frequency counts and total samples.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

// residual: four Int bins; List[Int] counts field emit UAF

type BinnedStats = struct {
    min_val: Float,
    max_val: Float,
    bin_count: Int,
    c0: Int,
    c1: Int,
    c2: Int,
    c3: Int,
    total_samples: Int
};

fn binned_index(mn: Float, mx: Float, bc: Int, val: Float) -> Int {
    let range: Float = mx - mn;
    if range <= 0.0 {
        return 0;
    }
    let mut bcf: Float = 1.0;
    if bc == 2 { bcf = 2.0; }
    if bc == 3 { bcf = 3.0; }
    if bc == 4 { bcf = 4.0; }
    let width: Float = range / bcf;
    let mut idx: Int = 0;
    let mut edge: Float = mn + width;
    while idx < bc - 1 {
        if val < edge {
            return idx;
        }
        idx = idx + 1;
        edge = edge + width;
    }
    return bc - 1;
}

pub fn binned_stats_new(min_val: Float, max_val: Float, bin_count: Int) -> BinnedStats {
    let mut bc: Int = bin_count;
    if bc < 1 { bc = 1; }
    if bc > 4 { bc = 4; }
    return BinnedStats {
        min_val: min_val,
        max_val: max_val,
        bin_count: bc,
        c0: 0,
        c1: 0,
        c2: 0,
        c3: 0,
        total_samples: 0
    };
}

pub fn binned_stats_total(stats: BinnedStats) -> Int {
    return stats.total_samples;
}

pub fn binned_stats_bin0(stats: BinnedStats) -> Int {
    return stats.c0;
}

pub fn binned_stats_bin1(stats: BinnedStats) -> Int {
    return stats.c1;
}

pub fn binned_stats_add(stats: BinnedStats, val: Float) -> BinnedStats {
    let mn: Float = stats.min_val;
    let mx: Float = stats.max_val;
    let bc: Int = stats.bin_count;
    if val < mn || val > mx {
        return stats;
    }
    let range: Float = mx - mn;
    if range == 0.0 { return stats; }
    let idx: Int = binned_index(mn, mx, bc, val);
    let mut n0: Int = stats.c0;
    let mut n1: Int = stats.c1;
    let mut n2: Int = stats.c2;
    let mut n3: Int = stats.c3;
    if idx == 0 { n0 = n0 + 1; }
    if idx == 1 { n1 = n1 + 1; }
    if idx == 2 { n2 = n2 + 1; }
    if idx == 3 { n3 = n3 + 1; }
    let tot: Int = stats.total_samples;
    return BinnedStats {
        min_val: mn,
        max_val: mx,
        bin_count: bc,
        c0: n0,
        c1: n1,
        c2: n2,
        c3: n3,
        total_samples: tot + 1
    };
}
