// # Arbitrary-Precision Rational Numbers Module
//
// Logline: Exact fraction representation (numerator/denominator) with greatest common divisor (GCD) canonicalization.
//
// Setup: Pure math module preventing floating point representation error.
//
// Beats:
//   1. Construct Rational from numerator and denominator with GCD reduction.
//   2. Add, subtract, multiply, and divide rational numbers.
//   3. Compare rational equality and ordering.
//   4. Convert rational to Float approximation.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type Rational = struct {
    num: Int,
    den: Int
};

fn rational_gcd(a: Int, b: Int) -> Int {
    let mut x: Int = a;
    let mut y: Int = b;
    if x < 0 { x = 0 - x; }
    if y < 0 { y = 0 - y; }
    while y != 0 {
        let t: Int = y;
        y = x % y;
        x = t;
    }
    if x == 0 { return 1; }
    return x;
}

pub fn rational_new(num: Int, den: Int) -> Rational {
    if den == 0 {
        return Rational { num: 0, den: 1 };
    }
    let mut n: Int = num;
    let mut d: Int = den;
    if d < 0 {
        n = 0 - n;
        d = 0 - d;
    }
    let g: Int = rational_gcd(n, d);
    return Rational {
        num: n / g,
        den: d / g
    };
}

pub fn rational_add(a: Rational, b: Rational) -> Rational {
    let an: Int = a.num; let ad: Int = a.den;
    let bn: Int = b.num; let bd: Int = b.den;
    return rational_new(an * bd + bn * ad, ad * bd);
}

pub fn rational_sub(a: Rational, b: Rational) -> Rational {
    let an: Int = a.num; let ad: Int = a.den;
    let bn: Int = b.num; let bd: Int = b.den;
    return rational_new(an * bd - bn * ad, ad * bd);
}

pub fn rational_mul(a: Rational, b: Rational) -> Rational {
    let an: Int = a.num; let ad: Int = a.den;
    let bn: Int = b.num; let bd: Int = b.den;
    return rational_new(an * bn, ad * bd);
}

pub fn rational_div(a: Rational, b: Rational) -> Rational {
    let an: Int = a.num; let ad: Int = a.den;
    let bn: Int = b.num; let bd: Int = b.den;
    return rational_new(an * bd, ad * bn);
}
