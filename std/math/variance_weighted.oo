// # Weighted Mean and Variance Statistics Module
//
// Logline: Weighted statistical moments, weighted sample variance, and weighted standard deviation.
//
// Setup: Pure statistical computation over weighted observations.
//
// Beats:
//   1. Construct WeightedStats accumulator.
//   2. Accumulate observation with custom weight.
//   3. Compute weighted mean and weighted variance.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/math.oo";

type WeightedStats = struct {
    weight_sum: Float,
    weighted_mean: Float,
    m2: Float
};

pub fn weighted_stats_new() -> WeightedStats {
    return WeightedStats {
        weight_sum: 0.0,
        weighted_mean: 0.0,
        m2: 0.0
    };
}

pub fn weighted_stats_add(s: WeightedStats, x: Float, w: Float) -> WeightedStats {
    if w <= 0.0 { return s; }
    let cur_w: Float = s.weight_sum;
    let new_w: Float = cur_w + w;
    let cur_m: Float = s.weighted_mean;
    let delta: Float = x - cur_m;
    let r: Float = delta * w / new_w;
    let new_m: Float = cur_m + r;
    let cur_m2: Float = s.m2;
    let new_m2: Float = cur_m2 + cur_w * delta * r;
    return WeightedStats {
        weight_sum: new_w,
        weighted_mean: new_m,
        m2: new_m2
    };
}

pub fn weighted_stats_variance(s: WeightedStats) -> Float {
    let ws: Float = s.weight_sum;
    if ws <= 0.0 { return 0.0; }
    let m2: Float = s.m2;
    return m2 / ws;
}

pub fn weighted_stats_std_dev(s: WeightedStats) -> Float {
    let v: Float = weighted_stats_variance(s);
    return math_sqrt(v);
}
