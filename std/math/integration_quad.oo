// # Numerical Quadrature and Integration Module
//
// Logline: Numerical integration and quadrature methods (Trapezoidal, Simpson's 1/3, Simpson's 3/8, Gauss-Legendre, and Romberg extrapolation).
//
// Setup: Pure math module. Evaluates definite integrals over discrete sample points and Gaussian quadrature nodes.
//
// Beats:
//   1. Construct QuadResult data structure with value estimate, error estimate, and subinterval count.
//   2. Trapezoidal and composite Simpson's 1/3 and 3/8 quadrature formulas.
//   3. 2-point and 3-point Gauss-Legendre quadrature weighting.
//   4. Richardson / Romberg extrapolation for accelerated quadrature convergence.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Adaptive mesh refinement (Clenshaw-Curtis / Gauss-Kronrod) uses base quadrature rules.

type QuadResult = struct {
    value: Float,
    error_est: Float,
    intervals: Int
};

// Composite trapezoidal rule over sampled function values f_vals with step size h.
pub fn integrate_trapezoidal(f_vals: List[Float], h: Float) -> Float {
    let n: Int = list_len(f_vals);
    if n < 2 {
        return 0.0;
    }
    let f0: Float = list_get(f_vals, 0);
    let fn_val: Float = list_get(f_vals, n - 1);
    let mut sum_mid: Float = 0.0;
    let mut i: Int = 1;
    while i < n - 1 {
        sum_mid = sum_mid + list_get(f_vals, i);
        i = i + 1;
    }
    return h * (0.5 * f0 + sum_mid + 0.5 * fn_val);
}

// Composite Simpson's 1/3 rule over sampled function values.
pub fn integrate_simpson(f_vals: List[Float], h: Float) -> Float {
    let n: Int = list_len(f_vals);
    if n < 3 {
        return integrate_trapezoidal(f_vals, h);
    }
    let f0: Float = list_get(f_vals, 0);
    let fn_val: Float = list_get(f_vals, n - 1);
    let mut sum_odd: Float = 0.0;
    let mut sum_even: Float = 0.0;
    let mut i: Int = 1;
    while i < n - 1 {
        let v: Float = list_get(f_vals, i);
        if i % 2 == 1 {
            sum_odd = sum_odd + v;
        } else {
            sum_even = sum_even + v;
        }
        i = i + 1;
    }
    return (h / 3.0) * (f0 + 4.0 * sum_odd + 2.0 * sum_even + fn_val);
}

// Composite Simpson's 3/8 rule.
pub fn integrate_simpson_38(f_vals: List[Float], h: Float) -> Float {
    let n: Int = list_len(f_vals);
    if n < 4 {
        return integrate_trapezoidal(f_vals, h);
    }
    let f0: Float = list_get(f_vals, 0);
    let fn_val: Float = list_get(f_vals, n - 1);
    let mut sum_all: Float = 0.0;
    let mut i: Int = 1;
    while i < n - 1 {
        let v: Float = list_get(f_vals, i);
        if i % 3 == 0 {
            sum_all = sum_all + 2.0 * v;
        } else {
            sum_all = sum_all + 3.0 * v;
        }
        i = i + 1;
    }
    return (3.0 * h / 8.0) * (f0 + sum_all + fn_val);
}

// 2-point Gauss-Legendre quadrature on interval [a, b].
pub fn quad_gauss_legendre_2pt(y0: Float, y1: Float, a: Float, b: Float) -> Float {
    let half_len: Float = 0.5 * (b - a);
    return half_len * (y0 + y1);
}

// 3-point Gauss-Legendre quadrature on interval [a, b].
pub fn quad_gauss_legendre_3pt(y0: Float, y1: Float, y2: Float, a: Float, b: Float) -> Float {
    let half_len: Float = 0.5 * (b - a);
    let w0: Float = 5.0 / 9.0;
    let w1: Float = 8.0 / 9.0;
    let w2: Float = 5.0 / 9.0;
    return half_len * (w0 * y0 + w1 * y1 + w2 * y2);
}

// Romberg step: Extrapolate coarse and fine trapezoidal estimates.
pub fn quad_romberg_step(t_coarse: Float, t_fine: Float) -> Float {
    return (4.0 * t_fine - t_coarse) / 3.0;
}

// Full Simpson quadrature result bundle.
pub fn quad_simpson_bundle(f_vals: List[Float], h: Float) -> QuadResult {
    let n: Int = list_len(f_vals);
    let simp: Float = integrate_simpson(f_vals, h);
    let trap: Float = integrate_trapezoidal(f_vals, h);
    let mut err: Float = simp - trap;
    if err < 0.0 { err = 0.0 - err; }
    return QuadResult {
        value: simp,
        error_est: err,
        intervals: n - 1
    };
}
