// # Flat row-major integer tensor
//
// Logline: tensor_new, tensor_get, tensor_set, and tensor_len walk a flat List[Int] in row-major order.
//
// Setup: This module is pure. Storage is List[Int], not nested List[List] and not ndarray.
//
// Beats:
//   1. tensor_new fills rows*cols zeros in row-major order.
//   2. tensor_get reads index r*cols+c.
//   3. tensor_set rebuilds the list with one replaced element; tensor_len is rows*cols.
//
// residual: no List[List[Int]] product; no pointer arithmetic; no ND >2 product.

// Zero-filled flat tensor of rows*cols elements (row-major).
pub fn tensor_new(rows: Int, cols: Int) -> List[Int]
    requires rows >= 0
    requires cols >= 0
{
    let mut t: List[Int] = list_new();
    let n = rows * cols;
    let mut i = 0;
    while i < n {
        t = list_push(t, 0);
        i = i + 1;
    }
    return t;
}

// Element at (r, c) in row-major flat storage: index = r*cols + c.
pub fn tensor_get(flat: List[Int], r: Int, c: Int, cols: Int) -> Int
    requires cols > 0
    requires r >= 0
    requires c >= 0
    requires c < cols
{
    return list_get(flat, r * cols + c);
}

// Pure rebuild set: copy flat with element (r,c) replaced by v (no in-place).
// residual: not true mutable tensor_set; rebuilds List via list_push.
pub fn tensor_set(flat: List[Int], r: Int, c: Int, cols: Int, v: Int) -> List[Int]
    requires cols > 0
    requires r >= 0
    requires c >= 0
    requires c < cols
{
    let idx = r * cols + c;
    let mut out: List[Int] = list_new();
    let n = list_len(flat);
    let mut i = 0;
    while i < n {
        if i == idx {
            out = list_push(out, v);
        } else {
            out = list_push(out, list_get(flat, i));
        }
        i = i + 1;
    }
    return out;
}

// Flat length of a rows×cols tensor.
pub fn tensor_len(rows: Int, cols: Int) -> Int
    requires rows >= 0
    requires cols >= 0
{
    return rows * cols;
}
