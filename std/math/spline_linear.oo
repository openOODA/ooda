// # Piecewise Linear Spline Interpolation Module
//
// Logline: 1D piecewise linear spline interpolation across ordered knot coordinates (x_i, y_i).
//
// Setup: Pure mathematical interpolation module.
//
// Beats:
//   1. Define 2D Knot coordinate pair.
//   2. Evaluate linear interpolation between two adjacent knot segments.
//   3. Clamp out-of-range evaluation to boundary values.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type Knot = struct {
    x: Float,
    y: Float
};

pub fn knot_new(x: Float, y: Float) -> Knot {
    return Knot { x: x, y: y };
}

pub fn spline_linear_eval_seg(k0: Knot, k1: Knot, x: Float) -> Float {
    let x0: Float = k0.x; let y0: Float = k0.y;
    let x1: Float = k1.x; let y1: Float = k1.y;
    let dx: Float = x1 - x0;
    if dx == 0.0 { return y0; }
    let t: Float = (x - x0) / dx;
    return y0 + t * (y1 - y0);
}
