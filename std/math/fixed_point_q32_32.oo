// # Q32.32 Fixed-Point Numeric Arithmetic Module
//
// Logline: 64-bit deterministic Q32.32 fixed-point numbers supporting high-precision fractional computations.
//
// Setup: Scale factor 4294967296 for high precision finance and physics.
//
// Beats:
//   1. Convert integer values to Q32.32 raw representation.
//   2. Add and subtract Q32.32 values.
//   3. Scale and shift Q32.32 numbers.
//   4. Extract whole integer parts.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type Q32 = struct {
    raw: Int
};

pub fn q32_from_int(v: Int) -> Q32 {
    let scale: Int = 4294967296;
    return Q32 { raw: v * scale };
}

pub fn q32_to_int(q: Q32) -> Int {
    let scale: Int = 4294967296;
    let r: Int = q.raw;
    return r / scale;
}

pub fn q32_add(a: Q32, b: Q32) -> Q32 {
    let ar: Int = a.raw;
    let br: Int = b.raw;
    return Q32 { raw: ar + br };
}

pub fn q32_sub(a: Q32, b: Q32) -> Q32 {
    let ar: Int = a.raw;
    let br: Int = b.raw;
    return Q32 { raw: ar - br };
}
