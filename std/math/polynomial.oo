// # Polynomial Algebra and Root Finding Module
//
// Logline: Polynomial algebra, Horner's evaluation, formal differentiation, integration, and Newton-Raphson root finding.
//
// Setup: Pure math module. Stores polynomial coefficients [c0, c1, ..., cn] for P(x) = c0 + c1*x + ... + cn*x^n.
//
// Beats:
//   1. Construct Polynomial structure from coefficient list and determine polynomial degree.
//   2. Fast polynomial evaluation via Horner's method and scalar scaling.
//   3. Polynomial addition, subtraction, multiplication (Cauchy product).
//   4. Formal calculus (derivative and anti-derivative) and Newton-Raphson root approximation.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Chebyshev approximations and fast FFT polynomial multiplication use base polynomial primitives.

type Polynomial = struct {
    coeffs: List[Float]
};

// Create a new Polynomial from coefficient list [c0, c1, ..., cn].
pub fn poly_new(coeffs: List[Float]) -> Polynomial {
    return Polynomial { coeffs: coeffs };
}

// Return degree of polynomial (highest non-zero power, or 0).
pub fn poly_degree(p: Polynomial) -> Int {
    let n: Int = list_len(p.coeffs);
    if n <= 1 {
        return 0;
    }
    let mut deg: Int = n - 1;
    while deg > 0 {
        let cv: Float = list_get(p.coeffs, deg);
        if cv != 0.0 {
            return deg;
        }
        deg = deg - 1;
    }
    return 0;
}

// Evaluate P(x) via Horner's method: c0 + x*(c1 + x*(c2 + ...)).
pub fn poly_eval(p: Polynomial, x: Float) -> Float {
    let n: Int = list_len(p.coeffs);
    if n == 0 {
        return 0.0;
    }
    let mut res: Float = list_get(p.coeffs, n - 1);
    let mut i: Int = n - 2;
    while i >= 0 {
        let c: Float = list_get(p.coeffs, i);
        res = res * x + c;
        i = i - 1;
    }
    return res;
}

// Add two polynomials: P1(x) + P2(x).
pub fn poly_add(p1: Polynomial, p2: Polynomial) -> Polynomial {
    let n1: Int = list_len(p1.coeffs);
    let n2: Int = list_len(p2.coeffs);
    let mut max_n: Int = n1;
    if n2 > max_n {
        max_n = n2;
    }
    let mut new_c: List[Float] = list_new();
    let mut i: Int = 0;
    while i < max_n {
        let mut v1: Float = 0.0;
        if i < n1 { v1 = list_get(p1.coeffs, i); }
        let mut v2: Float = 0.0;
        if i < n2 { v2 = list_get(p2.coeffs, i); }
        new_c = list_push(new_c, v1 + v2);
        i = i + 1;
    }
    return Polynomial { coeffs: new_c };
}

// Subtract two polynomials: P1(x) - P2(x).
pub fn poly_sub(p1: Polynomial, p2: Polynomial) -> Polynomial {
    let n1: Int = list_len(p1.coeffs);
    let n2: Int = list_len(p2.coeffs);
    let mut max_n: Int = n1;
    if n2 > max_n {
        max_n = n2;
    }
    let mut new_c: List[Float] = list_new();
    let mut i: Int = 0;
    while i < max_n {
        let mut v1: Float = 0.0;
        if i < n1 { v1 = list_get(p1.coeffs, i); }
        let mut v2: Float = 0.0;
        if i < n2 { v2 = list_get(p2.coeffs, i); }
        new_c = list_push(new_c, v1 - v2);
        i = i + 1;
    }
    return Polynomial { coeffs: new_c };
}

// Scale polynomial coefficients by scalar s.
pub fn poly_scale(p: Polynomial, s: Float) -> Polynomial {
    let n: Int = list_len(p.coeffs);
    let mut new_c: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let v: Float = list_get(p.coeffs, i);
        new_c = list_push(new_c, v * s);
        i = i + 1;
    }
    return Polynomial { coeffs: new_c };
}

// Multiply two polynomials: P1(x) * P2(x) via discrete convolution.
pub fn poly_mul(p1: Polynomial, p2: Polynomial) -> Polynomial {
    let n1: Int = list_len(p1.coeffs);
    let n2: Int = list_len(p2.coeffs);
    if n1 == 0 || n2 == 0 {
        let empty_c: List[Float] = list_new();
        return Polynomial { coeffs: empty_c };
    }
    let total_len: Int = n1 + n2 - 1;
    let mut new_c: List[Float] = list_new();
    let mut k: Int = 0;
    while k < total_len {
        let mut sum_k: Float = 0.0;
        let mut i: Int = 0;
        while i < n1 {
            let j: Int = k - i;
            if j >= 0 && j < n2 {
                let v1: Float = list_get(p1.coeffs, i);
                let v2: Float = list_get(p2.coeffs, j);
                sum_k = sum_k + v1 * v2;
            }
            i = i + 1;
        }
        new_c = list_push(new_c, sum_k);
        k = k + 1;
    }
    return Polynomial { coeffs: new_c };
}

// Formal derivative: d/dx P(x) = c1 + 2*c2*x + 3*c3*x^2 + ...
pub fn poly_derivative(p: Polynomial) -> Polynomial {
    let n: Int = list_len(p.coeffs);
    if n <= 1 {
        let mut zero_c: List[Float] = list_new();
        zero_c = list_push(zero_c, 0.0);
        return Polynomial { coeffs: zero_c };
    }
    let mut new_c: List[Float] = list_new();
    let mut i: Int = 1;
    while i < n {
        let v: Float = list_get(p.coeffs, i);
        let pwr: Float = 0.0 + i;
        new_c = list_push(new_c, v * pwr);
        i = i + 1;
    }
    return Polynomial { coeffs: new_c };
}

// Formal integral: int P(x) dx = c_const + c0*x + (c1/2)*x^2 + ...
pub fn poly_integral(p: Polynomial, c_const: Float) -> Polynomial {
    let n: Int = list_len(p.coeffs);
    let mut new_c: List[Float] = list_new();
    new_c = list_push(new_c, c_const);
    let mut i: Int = 0;
    while i < n {
        let v: Float = list_get(p.coeffs, i);
        let pwr: Float = 1.0 + i;
        new_c = list_push(new_c, v / pwr);
        i = i + 1;
    }
    return Polynomial { coeffs: new_c };
}

// Root finding via Newton-Raphson iteration: x_{k+1} = x_k - P(x_k)/P'(x_k).
pub fn poly_root_newton(
    p: Polynomial,
    x0: Float,
    max_iter: Int,
    tol: Float
) -> Float {
    let d_poly: Polynomial = poly_derivative(p);
    let mut cur_x: Float = x0;
    let mut iter: Int = 0;
    while iter < max_iter {
        let fx: Float = poly_eval(p, cur_x);
        let mut abs_fx: Float = fx;
        if abs_fx < 0.0 { abs_fx = 0.0 - abs_fx; }
        if abs_fx < tol {
            return cur_x;
        }
        let dfx: Float = poly_eval(d_poly, cur_x);
        if dfx == 0.0 {
            return cur_x;
        }
        cur_x = cur_x - fx / dfx;
        iter = iter + 1;
    }
    return cur_x;
}
