// # Polynomial Algebra Module
//
// Logline: Quadratic Horner evaluation and addition without List fields.
//
// Setup: Pure math. Emit-c maps List[Float] to OoSList and frees List struct fields.
//
// Beats:
//   1. Construct a quadratic c0 + c1*x + c2*x^2.
//   2. Evaluate via Horner: c0 + x*(c1 + x*c2).
//   3. Add two quadratics coefficient-wise.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: degree > 2 and List[Float] coeff vectors

type Polynomial = struct {
    c0: Float,
    c1: Float,
    c2: Float
};

pub fn poly_eval3(c0: Float, c1: Float, c2: Float, x: Float) -> Float {
    return c0 + x * (c1 + x * c2);
}

pub fn poly_new(c0: Float, c1: Float, c2: Float) -> Polynomial {
    return Polynomial {
        c0: c0,
        c1: c1,
        c2: c2
    };
}

pub fn poly_degree(p: Polynomial) -> Int {
    let c2: Float = p.c2;
    let c1: Float = p.c1;
    if c2 != 0.0 {
        return 2;
    }
    if c1 != 0.0 {
        return 1;
    }
    return 0;
}

pub fn poly_eval(p: Polynomial, x: Float) -> Float {
    let c0: Float = p.c0;
    let c1: Float = p.c1;
    let c2: Float = p.c2;
    return poly_eval3(c0, c1, c2, x);
}

pub fn poly_add(a: Polynomial, b: Polynomial) -> Polynomial {
    let a0: Float = a.c0;
    let a1: Float = a.c1;
    let a2: Float = a.c2;
    let b0: Float = b.c0;
    let b1: Float = b.c1;
    let b2: Float = b.c2;
    return Polynomial {
        c0: a0 + b0,
        c1: a1 + b1,
        c2: a2 + b2
    };
}
