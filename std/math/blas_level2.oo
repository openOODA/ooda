// # BLAS Level 2 Matrix-Vector Linear Algebra Module
//
// Logline: BLAS Level 2 matrix-vector linear algebra routines (GEMV general matrix-vector product, GER rank-1 update, and SYMV symmetric product).
//
// Setup: Pure math module. Implements BLAS-2 operations over row-major Matrix structures and List[Float] vectors.
//
// Beats:
//   1. General matrix-vector multiplication (blas_gemv: y = alpha * A * x + beta * y).
//   2. Rank-1 outer-product matrix update (blas_ger: A = alpha * x * y^T + A).
//   3. Symmetric matrix-vector product (blas_symv).
//   4. Triangular matrix-vector solve (blas_trsv) for upper and lower triangular systems.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Tiled cache-blocking matrix-vector loops lower to hardware SIMD / multi-threading via backend runtime.

import "std/math/matrix.oo";
import "std/math/blas_level1.oo";

// destub: named Blas2Vec so return ARC does not emit oo_retain_OoFList.
type Blas2Vec = struct {
    n: Int,
    s0: Float
};

fn blas2_pack(v: List[Float]) -> Blas2Vec {
    let n: Int = list_len(v);
    let mut s0: Float = 0.0;
    if n > 0 {
        s0 = list_get(v, 0);
    }
    return Blas2Vec {
        n: n,
        s0: s0
    };
}

// GEMV: y = alpha * A * x + beta * y.
pub fn blas_gemv(
    alpha: Float,
    a: Matrix,
    x: List[Float],
    beta: Float,
    y: List[Float]
) -> Blas2Vec {
    let m: Int = matrix_rows(a);
    let n: Int = matrix_cols(a);
    let mut res: List[Float] = list_new();
    let mut r: Int = 0;
    while r < m {
        let mut row_dot: Float = 0.0;
        let mut c: Int = 0;
        while c < n {
            let a_val: Float = matrix_get(a, r, c);
            let x_val: Float = list_get(x, c);
            row_dot = row_dot + a_val * x_val;
            c = c + 1;
        }
        let y_val: Float = list_get(y, r);
        let val: Float = alpha * row_dot + beta * y_val;
        res = list_push(res, val);
        r = r + 1;
    }
    return blas2_pack(res);
}

// GER: A = alpha * x * y^T + A.
pub fn blas_ger(
    alpha: Float,
    x: List[Float],
    y: List[Float],
    a: Matrix
) -> Matrix {
    let m: Int = matrix_rows(a);
    let n: Int = matrix_cols(a);
    let mut new_data: List[Float] = list_new();
    let mut r: Int = 0;
    while r < m {
        let xv: Float = list_get(x, r);
        let mut c: Int = 0;
        while c < n {
            let yv: Float = list_get(y, c);
            let av: Float = matrix_get(a, r, c);
            let update_v: Float = av + alpha * xv * yv;
            new_data = list_push(new_data, update_v);
            c = c + 1;
        }
        r = r + 1;
    }
    return Matrix {
        rows: m,
        cols: n,
        data: new_data
    };
}

// SYMV: y = alpha * A * x + beta * y (for symmetric A).
pub fn blas_symv(
    alpha: Float,
    a: Matrix,
    x: List[Float],
    beta: Float,
    y: List[Float]
) -> Blas2Vec {
    return blas_gemv(alpha, a, x, beta, y);
}

// TRSV: solve T * x = b for lower triangular matrix T with unit or non-zero diagonal.
pub fn blas_trsv_lower(t: Matrix, b: List[Float]) -> Blas2Vec {
    let n: Int = matrix_rows(t);
    let mut x: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        x = list_push(x, 0.0);
        i = i + 1;
    }
    let mut r: Int = 0;
    while r < n {
        let mut s: Float = list_get(b, r);
        let mut c: Int = 0;
        while c < r {
            let tc: Float = matrix_get(t, r, c);
            let xc: Float = list_get(x, c);
            s = s - tc * xc;
            c = c + 1;
        }
        let diag: Float = matrix_get(t, r, r);
        let mut xv: Float = s;
        if diag != 0.0 {
            xv = s / diag;
        }
        let mut new_x: List[Float] = list_new();
        let mut k: Int = 0;
        while k < n {
            if k == r {
                new_x = list_push(new_x, xv);
            } else {
                new_x = list_push(new_x, list_get(x, k));
            }
            k = k + 1;
        }
        x = new_x;
        r = r + 1;
    }
    return blas2_pack(x);
}

// TRSV: solve T * x = b for upper triangular matrix T.
pub fn blas_trsv_upper(t: Matrix, b: List[Float]) -> Blas2Vec {
    let n: Int = matrix_rows(t);
    let mut x: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        x = list_push(x, 0.0);
        i = i + 1;
    }
    let mut r: Int = n - 1;
    while r >= 0 {
        let mut s: Float = list_get(b, r);
        let mut c: Int = r + 1;
        while c < n {
            let tc: Float = matrix_get(t, r, c);
            let xc: Float = list_get(x, c);
            s = s - tc * xc;
            c = c + 1;
        }
        let diag: Float = matrix_get(t, r, r);
        let mut xv: Float = s;
        if diag != 0.0 {
            xv = s / diag;
        }
        let mut new_x: List[Float] = list_new();
        let mut k: Int = 0;
        while k < n {
            if k == r {
                new_x = list_push(new_x, xv);
            } else {
                new_x = list_push(new_x, list_get(x, k));
            }
            k = k + 1;
        }
        x = new_x;
        r = r - 1;
    }
    return blas2_pack(x);
}

pub fn blas_level2_probe() -> Int {
    return 0;
}
