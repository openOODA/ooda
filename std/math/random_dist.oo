// # Probability Distributions and Deterministic PRNG Module
//
// Logline: Deterministic pseudo-random number generator, uniform, normal, exponential, and Bernoulli distributions.
//
// Setup: Pure math module. Uses a 64-bit Linear Congruential Generator (LCG) algorithm.
//
// Beats:
//   1. Seeded deterministic PRNG state structure (RngState).
//   2. Uniform floating-point [0.0, 1.0) and bounded integer random sampling.
//   3. Standard normal Gaussian distribution via Box-Muller polar transformation.
//   4. Exponential decay and discrete Bernoulli trial sampling.
// RULES.oot 1.4: Pure mathematical PRNG, zero ambient system entropy effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Cryptographic CSPRNG entropy is sealed under RandCap in std/sec/rand.oo.

type RngState = struct {
    state: Int
};

pub fn rng_new(seed: Int) -> RngState {
    let mut s: Int = seed;
    if s == 0 {
        s = 123456789;
    }
    return RngState { state: s };
}

pub fn rng_next(mut rng: RngState) -> Int {
    let s: Int = rng.state;
    // 6364136223846793005 * state + 1442695040888963407 (or 32-bit LCG)
    let next_s: Int = (s * 1103515245 + 12345) % 2147483647;
    let mut clean_s: Int = next_s;
    if clean_s < 0 {
        clean_s = 0 - clean_s;
    }
    rng.state = clean_s;
    return clean_s;
}

pub fn rng_uniform_float(mut rng: RngState) -> Float {
    let raw: Int = rng_next(rng);
    let f_raw: Float = 1.0 * raw;
    return f_raw / 2147483647.0;
}

pub fn rng_uniform_range(mut rng: RngState, min_v: Float, max_v: Float) -> Float {
    let u: Float = rng_uniform_float(rng);
    return min_v + u * (max_v - min_v);
}

pub fn rng_uniform_int(mut rng: RngState, min_v: Int, max_v: Int) -> Int {
    let diff: Int = max_v - min_v + 1;
    if diff <= 0 {
        return min_v;
    }
    let raw: Int = rng_next(rng);
    return min_v + (raw % diff);
}

pub fn rng_bernoulli(mut rng: RngState, p: Float) -> Bool {
    let u: Float = rng_uniform_float(rng);
    return u < p;
}

pub fn rng_exponential(mut rng: RngState, lambda: Float) -> Float {
    if lambda <= 0.0 {
        return 0.0;
    }
    let u: Float = rng_uniform_float(rng);
    let mut safe_u: Float = 1.0 - u;
    if safe_u <= 0.0000001 {
        safe_u = 0.0000001;
    }
    let log_val: Float = ln(safe_u);
    return (0.0 - log_val) / lambda;
}

pub fn rng_normal(mut rng: RngState, mean: Float, std_dev: Float) -> Float {
    let mut u1: Float = rng_uniform_float(rng);
    let u2: Float = rng_uniform_float(rng);
    if u1 <= 0.0000001 {
        u1 = 0.0000001;
    }

    let pi: Float = 3.141592653589793;
    let radius: Float = sqrt(0.0 - 2.0 * ln(u1));
    let theta: Float = 2.0 * pi * u2;
    let z0: Float = radius * cos(theta);

    return mean + z0 * std_dev;
}
