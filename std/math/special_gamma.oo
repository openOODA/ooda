// # Special Functions Gamma and Log-Gamma Module
//
// Logline: Lanczos approximation of Euler's gamma function, log-gamma, digamma, and factorial evaluation.
//
// Setup: Pure math module. Calculates special transcendental functions without ambient effects.
//
// Beats:
//   1. Lanczos g=7 precision polynomial series approximation of Gamma(x).
//   2. Logarithm of Gamma function ln_gamma(x) for large argument overflow prevention.
//   3. Digamma derivative function psi(x) = d/dx ln(Gamma(x)).
//   4. Factorial evaluation on floating-point arguments.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Complex-plane analytic continuation lowers via complex analysis library.

import "std/math.oo";

// Log-Gamma function ln(Gamma(x)) using Lanczos approximation.
pub fn math_lgamma(x: Float) -> Float {
    if x <= 0.0 {
        return 0.0;
    }
    // Lanczos g=7 coefficients
    let c0: Float = 0.99999999999980993;
    let c1: Float = 676.5203681218851;
    let c2: Float = 0.0 - 1259.1392167224028;
    let c3: Float = 771.32342877765313;
    let c4: Float = 0.0 - 176.61502916214059;
    let c5: Float = 12.507343278686905;
    let c6: Float = 0.0 - 0.13857109583115912;
    let c7: Float = 0.0000099843695780195716;
    let c8: Float = 0.00000015056327351493116;

    let z: Float = x - 1.0;
    let mut ag: Float = c0;
    ag = ag + c1 / (z + 1.0);
    ag = ag + c2 / (z + 2.0);
    ag = ag + c3 / (z + 3.0);
    ag = ag + c4 / (z + 4.0);
    ag = ag + c5 / (z + 5.0);
    ag = ag + c6 / (z + 6.0);
    ag = ag + c7 / (z + 7.0);
    ag = ag + c8 / (z + 8.0);

    let t: Float = z + 7.5;
    let half_ln_2pi: Float = 0.9189385332046727;
    return half_ln_2pi + (z + 0.5) * math_ln(t) - t + math_ln(ag);
}

// Euler's Gamma function Gamma(x) = exp(lgamma(x)).
pub fn math_gamma(x: Float) -> Float {
    if x > 171.0 {
        return 999999999999999.0;
    }
    let lg: Float = math_lgamma(x);
    return math_exp(lg);
}

// Factorial n! = Gamma(n + 1).
pub fn math_factorial_float(n: Float) -> Float {
    return math_gamma(n + 1.0);
}

// Digamma function psi(x) approximation.
pub fn math_digamma(x: Float) -> Float {
    if x <= 0.0 {
        return 0.0;
    }
    let eps: Float = 0.0001;
    let lg1: Float = math_lgamma(x + eps);
    let lg0: Float = math_lgamma(x - eps);
    return (lg1 - lg0) / (2.0 * eps);
}
