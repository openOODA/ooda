// # 2D Bilinear Surface Interpolation Module
//
// Logline: 2D bilinear surface interpolation over four corner grid values: Q00, Q10, Q01, Q11.
//
// Setup: Pure mathematical 2D spatial surface interpolation.
//
// Beats:
//   1. Compute normalized grid coordinates (u, v) in [0, 1].
//   2. Perform horizontal 1D interpolation along bottom and top edges.
//   3. Perform vertical 1D interpolation between edge results.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

pub fn bilinear_interp(q00: Float, q10: Float, q01: Float, q11: Float, u: Float, v: Float) -> Float {
    let r0: Float = q00 + u * (q10 - q00);
    let r1: Float = q01 + u * (q11 - q01);
    return r0 + v * (r1 - r0);
}
