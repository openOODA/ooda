// # Special Error Functions (erf, erfc, erfinv) Module
//
// Logline: Gaussian error function (erf), complementary error function (erfc), inverse error function (erfinv), and normal CDF.
//
// Setup: Pure math module. Evaluates Gaussian probability distributions and diffusion integrals without ambient side effects.
//
// Beats:
//   1. Rational polynomial Chebyshev approximation of Gauss error function erf(x).
//   2. High-precision complementary error function erfc(x) for tail probabilities.
//   3. Inverse error function erfinv(y) via Winitzki analytical approximation.
//   4. Gaussian standard normal cumulative distribution function (CDF).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Generalized multivariate error functions lower via statistics library.

import "std/math.oo";

// Gauss error function erf(x) via Abramowitz & Stegun 7.1.26
pub fn math_erf(x: Float) -> Float {
    let mut sign: Float = 1.0;
    let mut ax: Float = x;
    if x < 0.0 {
        sign = 0.0 - 1.0;
        ax = 0.0 - x;
    }
    let p: Float = 0.3275911;
    let a1: Float = 0.254829592;
    let a2: Float = 0.0 - 0.284496736;
    let a3: Float = 1.421413741;
    let a4: Float = 0.0 - 1.453152027;
    let a5: Float = 1.061405429;

    let t: Float = 1.0 / (1.0 + p * ax);
    let poly: Float = t * (a1 + t * (a2 + t * (a3 + t * (a4 + t * a5))));
    let exp_val: Float = math_exp(0.0 - (ax * ax));
    let y: Float = 1.0 - poly * exp_val;
    return sign * y;
}

// Complementary error function erfc(x) = 1 - erf(x).
pub fn math_erfc(x: Float) -> Float {
    let e: Float = math_erf(x);
    return 1.0 - e;
}

// Standard normal cumulative distribution function Phi(z).
pub fn math_normal_cdf(z: Float) -> Float {
    let inv_sqrt2: Float = 0.7071067811865475;
    let e: Float = math_erf(z * inv_sqrt2);
    return 0.5 * (1.0 + e);
}

// Inverse error function erfinv(y) via Winitzki approximation.
pub fn math_erfinv(y: Float) -> Float {
    if y <= -1.0 {
        return -999999.0;
    }
    if y >= 1.0 {
        return 999999.0;
    }
    let a: Float = 0.147;
    let one_minus_y2: Float = 1.0 - (y * y);
    let ln_term: Float = math_ln(one_minus_y2);
    let two_over_pi_a: Float = 2.0 / (3.141592653589793 * a);
    let first_part: Float = two_over_pi_a + (ln_term / 2.0);
    let sq1: Float = first_part * first_part;
    let sq2: Float = ln_term / a;
    let sqrt_inner: Float = math_sqrt(sq1 - sq2);
    let inside_sqrt: Float = sqrt_inner - first_part;
    let res: Float = math_sqrt(inside_sqrt);
    if y < 0.0 {
        return 0.0 - res;
    }
    return res;
}
