// # Fixed-Point Q16.16 Numeric Arithmetic Module
//
// Logline: Deterministic Q16.16 fixed-point numeric arithmetic for fractional computation without float variance.
//
// Setup: Pure math module. Employs 65536-scaled integer fixed-point representations.
//
// Beats:
//   1. Define Fixed64 data structure representing Q16.16 fixed point values.
//   2. Conversions between integer parts, fractional ratios, and Fixed64.
//   3. Exact arithmetic (+, -, *, /) with scaling and rounding.
//   4. Comparisons, absolute value, negation, and decimal string formatting.
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Higher fractional precision (e.g. Q32.32) can be scaled similarly using 64-bit bounds.

type Fixed64 = struct {
    raw: Int
};

pub fn fixed_scale() -> Int {
    return 65536;
}

pub fn fixed_from_int(v: Int) -> Fixed64 {
    return Fixed64 { raw: v * 65536 };
}

pub fn fixed_to_int(f: Fixed64) -> Int {
    let r: Int = f.raw;
    return r / 65536;
}

pub fn fixed_from_parts(integral: Int, frac_num: Int, frac_den: Int) -> Fixed64 {
    if frac_den == 0 {
        return fixed_from_int(integral);
    }
    let frac_scaled: Int = (frac_num * 65536) / frac_den;
    let base: Int = integral * 65536;
    if integral < 0 {
        return Fixed64 { raw: base - frac_scaled };
    }
    return Fixed64 { raw: base + frac_scaled };
}

pub fn fixed_add(a: Fixed64, b: Fixed64) -> Fixed64 {
    let ar: Int = a.raw;
    let br: Int = b.raw;
    return Fixed64 { raw: ar + br };
}

pub fn fixed_sub(a: Fixed64, b: Fixed64) -> Fixed64 {
    let ar: Int = a.raw;
    let br: Int = b.raw;
    return Fixed64 { raw: ar - br };
}

pub fn fixed_mul(a: Fixed64, b: Fixed64) -> Fixed64 {
    let ar: Int = a.raw;
    let br: Int = b.raw;
    let prod: Int = (ar * br) / 65536;
    return Fixed64 { raw: prod };
}

pub fn fixed_div(a: Fixed64, b: Fixed64) -> Fixed64 {
    let ar: Int = a.raw;
    let br: Int = b.raw;
    if br == 0 {
        return Fixed64 { raw: 0 };
    }
    let quot: Int = (ar * 65536) / br;
    return Fixed64 { raw: quot };
}

pub fn fixed_neg(f: Fixed64) -> Fixed64 {
    let r: Int = f.raw;
    return Fixed64 { raw: 0 - r };
}

pub fn fixed_abs(f: Fixed64) -> Fixed64 {
    let r: Int = f.raw;
    if r < 0 {
        return Fixed64 { raw: 0 - r };
    }
    return f;
}

pub fn fixed_cmp(a: Fixed64, b: Fixed64) -> Int {
    let ar: Int = a.raw;
    let br: Int = b.raw;
    if ar < br { return -1; }
    if ar > br { return 1; }
    return 0;
}

pub fn fixed_to_str(f: Fixed64) -> String {
    let r: Int = f.raw;
    let mut is_neg: Bool = false;
    let mut abs_r: Int = r;
    if abs_r < 0 {
        is_neg = true;
        abs_r = 0 - abs_r;
    }

    let int_part: Int = abs_r / 65536;
    let frac_raw: Int = abs_r % 65536;
    let frac_dec: Int = (frac_raw * 10000) / 65536;

    let mut frac_str: String = frac_dec.to_string();
    let flen: Int = chars_len(frac_str);
    let mut i: Int = 0;
    while i < 4 - flen {
        frac_str = "0" + frac_str;
        i = i + 1;
    }

    let mut out: String = "";
    if is_neg {
        out = "-";
    }
    return out + int_part.to_string() + "." + frac_str;
}
