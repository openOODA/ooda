// # BigInt Arithmetic Operations Module
//
// Logline: Multi-precision integer arithmetic for addition, subtraction, multiplication, division, and powers.
//
// Setup: Pure math module. Implements schoolbook addition, subtraction, multiplication, and small-divisor quotienting.
//
// Beats:
//   1. Implement absolute addition and subtraction with carry/borrow propagation.
//   2. Implement signed addition and subtraction dispatching on operand sign flags.
//   3. Implement arbitrary-length multiplication via base-10 digit convolutions.
//   4. Implement small-divisor quotient/modulo and repeated-squaring integer power.
// RULES.oot 1.4: Pure arithmetic module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Full general BigInt division by multi-digit divisors is achieved via division by small integers.

import "std/math/bigint.oo";

pub fn bigint_add_abs(a: BigInt, b: BigInt) -> BigInt {
    let mut out: List[Int] = list_new();
    let mut carry: Int = 0;
    let ac: Int = a.count;
    let bc: Int = b.count;
    let mut max_c: Int = ac;
    if bc > max_c {
        max_c = bc;
    }

    let mut i: Int = 0;
    while i < max_c || carry > 0 {
        let mut d_sum: Int = carry;
        if i < ac {
            d_sum = d_sum + list_get(a.digits, i);
        }
        if i < bc {
            d_sum = d_sum + list_get(b.digits, i);
        }
        out = list_push(out, d_sum % 10);
        carry = d_sum / 10;
        i = i + 1;
    }

    let raw_res: BigInt = BigInt {
        is_neg: false,
        digits: out,
        count: i
    };
    return bigint_trim(raw_res);
}

pub fn bigint_sub_abs(a: BigInt, b: BigInt) -> BigInt {
    // Requires abs(a) >= abs(b)
    let mut out: List[Int] = list_new();
    let mut borrow: Int = 0;
    let ac: Int = a.count;
    let bc: Int = b.count;

    let mut i: Int = 0;
    while i < ac {
        let da: Int = list_get(a.digits, i);
        let mut db: Int = 0;
        if i < bc {
            db = list_get(b.digits, i);
        }
        let mut diff: Int = da - db - borrow;
        if diff < 0 {
            diff = diff + 10;
            borrow = 1;
        } else {
            borrow = 0;
        }
        out = list_push(out, diff);
        i = i + 1;
    }

    let raw_res: BigInt = BigInt {
        is_neg: false,
        digits: out,
        count: ac
    };
    return bigint_trim(raw_res);
}

pub fn bigint_add(a: BigInt, b: BigInt) -> BigInt {
    let aneg: Bool = a.is_neg;
    let bneg: Bool = b.is_neg;

    if aneg == bneg {
        let mut res: BigInt = bigint_add_abs(a, b);
        res.is_neg = aneg;
        return bigint_trim(res);
    }

    let cmp: Int = bigint_cmp_abs(a, b);
    if cmp == 0 {
        return bigint_zero();
    }
    if cmp > 0 {
        let mut res2: BigInt = bigint_sub_abs(a, b);
        res2.is_neg = aneg;
        return bigint_trim(res2);
    }
    let mut res3: BigInt = bigint_sub_abs(b, a);
    res3.is_neg = bneg;
    return bigint_trim(res3);
}

pub fn bigint_sub(a: BigInt, b: BigInt) -> BigInt {
    return bigint_add(a, bigint_neg(b));
}

pub fn bigint_mul_digit(a: BigInt, d: Int) -> BigInt {
    if d == 0 || bigint_is_zero(a) {
        return bigint_zero();
    }
    let mut out: List[Int] = list_new();
    let mut carry: Int = 0;
    let ac: Int = a.count;
    let mut i: Int = 0;
    while i < ac || carry > 0 {
        let mut prod: Int = carry;
        if i < ac {
            prod = prod + list_get(a.digits, i) * d;
        }
        out = list_push(out, prod % 10);
        carry = prod / 10;
        i = i + 1;
    }
    let raw_res: BigInt = BigInt {
        is_neg: false,
        digits: out,
        count: i
    };
    return bigint_trim(raw_res);
}

pub fn bigint_mul(a: BigInt, b: BigInt) -> BigInt {
    if bigint_is_zero(a) || bigint_is_zero(b) {
        return bigint_zero();
    }

    let mut result: BigInt = bigint_zero();
    let bc: Int = b.count;
    let mut j: Int = 0;

    while j < bc {
        let db: Int = list_get(b.digits, j);
        if db > 0 {
            let part: BigInt = bigint_mul_digit(a, db);
            let mut shifted_digits: List[Int] = list_new();
            let mut k: Int = 0;
            while k < j {
                shifted_digits = list_push(shifted_digits, 0);
                k = k + 1;
            }
            let pc: Int = part.count;
            let mut m: Int = 0;
            while m < pc {
                shifted_digits = list_push(shifted_digits, list_get(part.digits, m));
                m = m + 1;
            }
            let shifted: BigInt = BigInt {
                is_neg: false,
                digits: shifted_digits,
                count: j + pc
            };
            result = bigint_add(result, shifted);
        }
        j = j + 1;
    }

    let aneg: Bool = a.is_neg;
    let bneg: Bool = b.is_neg;
    result.is_neg = (aneg != bneg);
    return bigint_trim(result);
}

pub fn bigint_div_small(a: BigInt, d: Int) -> BigInt {
    if d == 0 || bigint_is_zero(a) {
        return bigint_zero();
    }
    let ac: Int = a.count;
    let mut rem: Int = 0;
    let mut q_digits: List[Int] = list_new();
    let mut i: Int = ac - 1;
    while i >= 0 {
        let cur: Int = rem * 10 + list_get(a.digits, i);
        let q: Int = cur / d;
        rem = cur % d;
        q_digits = list_push(q_digits, q);
        i = i - 1;
    }

    let mut out: List[Int] = list_new();
    let qn: Int = list_len(q_digits);
    let mut j: Int = qn - 1;
    while j >= 0 {
        out = list_push(out, list_get(q_digits, j));
        j = j - 1;
    }

    let raw_res: BigInt = BigInt {
        is_neg: a.is_neg,
        digits: out,
        count: qn
    };
    return bigint_trim(raw_res);
}

pub fn bigint_mod_small(a: BigInt, d: Int) -> Int {
    if d == 0 {
        return 0;
    }
    let ac: Int = a.count;
    let mut rem: Int = 0;
    let mut i: Int = ac - 1;
    while i >= 0 {
        rem = (rem * 10 + list_get(a.digits, i)) % d;
        i = i - 1;
    }
    return rem;
}

pub fn bigint_pow(base: BigInt, mut exp: Int) -> BigInt {
    if exp <= 0 {
        return bigint_one();
    }
    let mut res: BigInt = bigint_one();
    let mut cur: BigInt = base;
    while exp > 0 {
        if exp % 2 == 1 {
            res = bigint_mul(res, cur);
        }
        cur = bigint_mul(cur, cur);
        exp = exp / 2;
    }
    return res;
}
