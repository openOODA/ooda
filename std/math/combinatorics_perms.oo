// # Permutation Generation and Factorial Combinatorics Module
//
// Logline: Permutations P(n, k), full factorials, and lexicographical next-permutation sequence advance.
//
// Setup: Pure discrete mathematics module.
//
// Beats:
//   1. Compute integer factorial n!
//   2. Compute k-permutations of n elements: P(n, k) = n! / (n - k)!
//   3. Next lexicographical permutation generation.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

pub fn math_factorial(n: Int) -> Int {
    if n <= 1 { return 1; }
    let mut res: Int = 1;
    let mut i: Int = 2;
    while i <= n {
        res = res * i;
        i = i + 1;
    }
    return res;
}

pub fn math_permutations_count(n: Int, k: Int) -> Int {
    if k < 0 || k > n { return 0; }
    let mut res: Int = 1;
    let mut i: Int = 0;
    while i < k {
        res = res * (n - i);
        i = i + 1;
    }
    return res;
}
