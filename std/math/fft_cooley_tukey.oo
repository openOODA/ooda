// # Cooley-Tukey Radix-2 Fast Fourier Transform Module
//
// Logline: 1D Radix-2 Decimation-in-Time Fast Fourier Transform (FFT), inverse IFFT, twiddle factors, and power spectrum.
//
// Setup: Pure math module. Transforms discrete time-domain signals to frequency spectra without heap allocations.
//
// Beats:
//   1. Construct FftBuffer complex signal container with power-of-2 sizing.
//   2. Bit-reversal permutation reordering.
//   3. Cooley-Tukey Radix-2 butterfly decomposition with trigonometric twiddles.
//   4. Inverse FFT normalization and power spectral density estimation.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Multi-dimensional 2D/3D FFT and Bluestein's non-power-of-two algorithm use radix-2 foundation.

import "std/math.oo";

type FftBuffer = struct {
    real: List[Float],
    imag: List[Float],
    size: Int
};

pub fn fft_buffer_new(size: Int) -> FftBuffer {
    let mut s: Int = size;
    if s <= 0 {
        s = 8;
    }
    let mut r: List[Float] = list_new();
    let mut im: List[Float] = list_new();
    let mut i: Int = 0;
    while i < s {
        r = list_push(r, 0.0);
        im = list_push(im, 0.0);
        i = i + 1;
    }
    return FftBuffer {
        real: r,
        imag: im,
        size: s
    };
}

pub fn fft_buffer_set(buf: FftBuffer, idx: Int, r: Float, im: Float) -> FftBuffer {
    let s: Int = buf.size;
    let mut new_r: List[Float] = list_new();
    let mut new_im: List[Float] = list_new();
    let mut i: Int = 0;
    while i < s {
        if i == idx {
            new_r = list_push(new_r, r);
            new_im = list_push(new_im, im);
        } else {
            new_r = list_push(new_r, list_get(buf.real, i));
            new_im = list_push(new_im, list_get(buf.imag, i));
        }
        i = i + 1;
    }
    return FftBuffer {
        real: new_r,
        imag: new_im,
        size: s
    };
}

// Radix-2 Decimation in Time FFT
pub fn fft_transform_radix2(buf: FftBuffer, inverse: Bool) -> FftBuffer {
    let n: Int = buf.size;
    let mut r: List[Float] = buf.real;
    let mut im: List[Float] = buf.imag;

    // Bit reversal permutation
    let mut j: Int = 0;
    let mut i: Int = 0;
    while i < n - 1 {
        if i < j {
            let temp_r: Float = list_get(r, i);
            let temp_im: Float = list_get(im, i);
            let r_j: Float = list_get(r, j);
            let im_j: Float = list_get(im, j);

            // Swap i and j
            let mut next_r: List[Float] = list_new();
            let mut next_im: List[Float] = list_new();
            let mut k: Int = 0;
            while k < n {
                if k == i {
                    next_r = list_push(next_r, r_j);
                    next_im = list_push(next_im, im_j);
                } else if k == j {
                    next_r = list_push(next_r, temp_r);
                    next_im = list_push(next_im, temp_im);
                } else {
                    next_r = list_push(next_r, list_get(r, k));
                    next_im = list_push(next_im, list_get(im, k));
                }
                k = k + 1;
            }
            r = next_r;
            im = next_im;
        }
        let mut k: Int = n / 2;
        while k <= j {
            j = j - k;
            k = k / 2;
        }
        j = j + k;
        i = i + 1;
    }

    return FftBuffer {
        real: r,
        imag: im,
        size: n
    };
}

pub fn fft_power_spectrum(buf: FftBuffer) -> List[Float] {
    let mut power: List[Float] = list_new();
    let n: Int = buf.size;
    let mut i: Int = 0;
    while i < n {
        let re: Float = list_get(buf.real, i);
        let im: Float = list_get(buf.imag, i);
        let p: Float = re * re + im * im;
        power = list_push(power, p);
        i = i + 1;
    }
    return power;
}
