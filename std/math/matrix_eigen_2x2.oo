// # 2x2 Matrix Eigenvalues and Eigenvectors Module
//
// Logline: Closed-form characteristic equation solver for 2x2 matrix eigenvalues and trace/determinant roots.
//
// Setup: Pure math module. Solves lambda^2 - tr(A)*lambda + det(A) = 0.
//
// Beats:
//   1. Compute 2x2 matrix trace and determinant.
//   2. Compute discriminant = tr^2 - 4*det.
//   3. Compute real eigenvalues lambda1, lambda2.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/math.oo";

type Eigen2x2 = struct {
    lambda1: Float,
    lambda2: Float,
    has_real_roots: Bool
};

// Closed-form 2x2 eigen: lambda^2 - tr*lambda + det = 0. No SIMD import.
pub fn matrix_eigen_2x2_solve(m00: Float, m01: Float, m10: Float, m11: Float) -> Eigen2x2 {
    let tr: Float = m00 + m11;
    let det: Float = m00 * m11 - m01 * m10;
    let disc: Float = tr * tr - 4.0 * det;
    if disc < 0.0 {
        return Eigen2x2 {
            lambda1: 0.0,
            lambda2: 0.0,
            has_real_roots: false
        };
    }
    let sqrt_disc: Float = math_sqrt(disc);
    let l1: Float = (tr + sqrt_disc) * 0.5;
    let l2: Float = (tr - sqrt_disc) * 0.5;
    return Eigen2x2 {
        lambda1: l1,
        lambda2: l2,
        has_real_roots: true
    };
}
