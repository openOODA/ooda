// # BigDecimal add and subtract
//
// Logline: Align scales and add or subtract unscaled BigInt magnitudes.
//
// Setup: Imports bigdecimal plus bigint string/ops. Pure math. No caps.
//
// Beats:
//   1. Align both operands to the larger scale.
//   2. Add unscaled BigInt values and keep the scale.
//   3. Subtract by adding the negation.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/math/bigdecimal.oo";
import "std/math/bigint.oo";
import "std/math/bigint_ops.oo";
import "std/math/bigint_str.oo";

pub fn bigdec_add(a: BigDecimal, b: BigDecimal) -> BigDecimal {
    let sa: Int = bigdec_scale_of(a);
    let sb: Int = bigdec_scale_of(b);
    let mut max_s: Int = sa;
    if sb > max_s {
        max_s = sb;
    }

    let a_aligned: BigDecimal = bigdec_align_scale(a, max_s);
    let b_aligned: BigDecimal = bigdec_align_scale(b, max_s);

    let mut big_a: BigInt = bigint_from_str(bigdec_unscaled(a_aligned));
    if bigdec_is_neg(a_aligned) {
        big_a = bigint_neg(big_a);
    }

    let mut big_b: BigInt = bigint_from_str(bigdec_unscaled(b_aligned));
    if bigdec_is_neg(b_aligned) {
        big_b = bigint_neg(big_b);
    }

    let sum_big: BigInt = bigint_add(big_a, big_b);
    let res_neg: Bool = bigint_is_neg(sum_big);
    let res_abs: BigInt = bigint_abs(sum_big);

    return BigDecimal {
        is_neg: res_neg,
        unscaled_str: bigint_to_str(res_abs),
        scale: max_s
    };
}

pub fn bigdec_sub(a: BigDecimal, b: BigDecimal) -> BigDecimal {
    return bigdec_add(a, bigdec_neg(b));
}
