// # 3D Vector Orthogonal Projection Module
//
// Logline: Orthogonal vector projection of vector U onto vector V and Gram-Schmidt orthogonalization.
//
// Setup: Pure math module. Computes proj_v(u) = (u . v / v . v) * v.
//
// Beats:
//   1. Define 3D Vector structure.
//   2. Compute vector dot product and magnitude squared.
//   3. Compute orthogonal projection of U onto V.
//   4. Scalar projection length (component).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type Vec3 = struct {
    x: Float,
    y: Float,
    z: Float
};

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

pub fn vec3_get_x(v: Vec3) -> Float { return v.x; }
pub fn vec3_get_y(v: Vec3) -> Float { return v.y; }
pub fn vec3_get_z(v: Vec3) -> Float { return v.z; }

pub fn vec3_dot(a: Vec3, b: Vec3) -> Float {
    let ax: Float = a.x; let ay: Float = a.y; let az: Float = a.z;
    let bx: Float = b.x; let by: Float = b.y; let bz: Float = b.z;
    return ax * bx + ay * by + az * bz;
}

pub fn vec3_mag_sq(v: Vec3) -> Float {
    return vec3_dot(v, v);
}

pub fn vec3_project(u: Vec3, v: Vec3) -> Vec3 {
    let denom: Float = vec3_mag_sq(v);
    if denom == 0.0 {
        return vec3_new(0.0, 0.0, 0.0);
    }
    let num: Float = vec3_dot(u, v);
    let s: Float = num / denom;
    let vx: Float = v.x;
    let vy: Float = v.y;
    let vz: Float = v.z;
    return Vec3 {
        x: vx * s,
        y: vy * s,
        z: vz * s
    };
}

pub fn vec3_scalar_proj(u: Vec3, v: Vec3) -> Float {
    let denom: Float = vec3_mag_sq(v);
    if denom == 0.0 { return 0.0; }
    let num: Float = vec3_dot(u, v);
    return num / denom;
}
