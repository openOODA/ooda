// # BigInt String and Hex Parsing / Serialization Module
//
// Logline: Convert arbitrary precision BigInt numbers to and from decimal and hexadecimal strings.
//
// Setup: Pure math module. Translates ASCII representations into structured BigInt digit arrays.
//
// Beats:
//   1. Parse signed base-10 decimal strings into BigInt.
//   2. Format BigInt values as standard decimal strings.
//   3. Convert machine native integers (Int) to BigInt instances.
//   4. Format and parse hexadecimal strings (0-9, a-f).
// RULES.oot 1.4: Pure conversion module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Octal and arbitrary radix formatting beyond 10 and 16 use repeated division.

import "std/math/bigint.oo";
import "std/math/bigint_ops.oo";

pub fn bigint_from_int(n: Int) -> BigInt {
    if n == 0 {
        return bigint_zero();
    }
    let mut is_neg: Bool = false;
    let mut val: Int = n;
    if val < 0 {
        is_neg = true;
        val = 0 - val;
    }

    let mut digits: List[Int] = list_new();
    let mut count: Int = 0;
    while val > 0 {
        digits = list_push(digits, val % 10);
        val = val / 10;
        count = count + 1;
    }

    let raw: BigInt = BigInt {
        is_neg: is_neg,
        digits: digits,
        count: count
    };
    return bigint_trim(raw);
}

pub fn bigint_to_int(b: BigInt) -> Int {
    let mut res: Int = 0;
    let c: Int = b.count;
    let mut i: Int = c - 1;
    while i >= 0 {
        res = res * 10 + list_get(b.digits, i);
        i = i - 1;
    }
    let is_neg: Bool = b.is_neg;
    if is_neg {
        return 0 - res;
    }
    return res;
}

pub fn bigint_from_str(s: String) -> BigInt {
    let n: Int = chars_len(s);
    if n == 0 {
        return bigint_zero();
    }

    let mut is_neg: Bool = false;
    let mut start: Int = 0;
    if char_at(s, 0) == "-" {
        is_neg = true;
        start = 1;
    } else if char_at(s, 0) == "+" {
        start = 1;
    }

    let mut digits: List[Int] = list_new();
    let mut i: Int = n - 1;
    let mut count: Int = 0;
    while i >= start {
        let ch: String = char_at(s, i);
        let mut d: Int = 0;
        if ch == "0" { d = 0; }
        else if ch == "1" { d = 1; }
        else if ch == "2" { d = 2; }
        else if ch == "3" { d = 3; }
        else if ch == "4" { d = 4; }
        else if ch == "5" { d = 5; }
        else if ch == "6" { d = 6; }
        else if ch == "7" { d = 7; }
        else if ch == "8" { d = 8; }
        else if ch == "9" { d = 9; }
        digits = list_push(digits, d);
        count = count + 1;
        i = i - 1;
    }

    if count == 0 {
        return bigint_zero();
    }

    let raw: BigInt = BigInt {
        is_neg: is_neg,
        digits: digits,
        count: count
    };
    return bigint_trim(raw);
}

pub fn bigint_to_str(b: BigInt) -> String {
    let c: Int = b.count;
    if c == 0 {
        return "0";
    }
    let mut out: String = "";
    let is_neg: Bool = b.is_neg;
    if is_neg && !bigint_is_zero(b) {
        out = "-";
    }

    let mut i: Int = c - 1;
    while i >= 0 {
        let d: Int = list_get(b.digits, i);
        out = out + d.to_string();
        i = i - 1;
    }
    return out;
}

fn bigint_hex_char(val: Int) -> String {
    if val == 0 { return "0"; }
    if val == 1 { return "1"; }
    if val == 2 { return "2"; }
    if val == 3 { return "3"; }
    if val == 4 { return "4"; }
    if val == 5 { return "5"; }
    if val == 6 { return "6"; }
    if val == 7 { return "7"; }
    if val == 8 { return "8"; }
    if val == 9 { return "9"; }
    if val == 10 { return "a"; }
    if val == 11 { return "b"; }
    if val == 12 { return "c"; }
    if val == 13 { return "d"; }
    if val == 14 { return "e"; }
    if val == 15 { return "f"; }
    return "0";
}

pub fn bigint_to_hex(b: BigInt) -> String {
    if bigint_is_zero(b) {
        return "0";
    }
    let mut cur: BigInt = b;
    let mut hex_digits: String = "";
    while !bigint_is_zero(cur) {
        let rem: Int = bigint_mod_small(cur, 16);
        hex_digits = bigint_hex_char(rem) + hex_digits;
        cur = bigint_div_small(cur, 16);
    }
    return hex_digits;
}

fn bigint_parse_hex_digit(ch: String) -> Int {
    if ch == "0" { return 0; }
    if ch == "1" { return 1; }
    if ch == "2" { return 2; }
    if ch == "3" { return 3; }
    if ch == "4" { return 4; }
    if ch == "5" { return 5; }
    if ch == "6" { return 6; }
    if ch == "7" { return 7; }
    if ch == "8" { return 8; }
    if ch == "9" { return 9; }
    if ch == "a" || ch == "A" { return 10; }
    if ch == "b" || ch == "B" { return 11; }
    if ch == "c" || ch == "C" { return 12; }
    if ch == "d" || ch == "D" { return 13; }
    if ch == "e" || ch == "E" { return 14; }
    if ch == "f" || ch == "F" { return 15; }
    return 0;
}

pub fn bigint_from_hex(s: String) -> BigInt {
    let n: Int = chars_len(s);
    let mut res: BigInt = bigint_zero();
    let sixteen: BigInt = bigint_from_int(16);
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        let d: Int = bigint_parse_hex_digit(ch);
        res = bigint_mul(res, sixteen);
        res = bigint_add(res, bigint_from_int(d));
        i = i + 1;
    }
    return res;
}
