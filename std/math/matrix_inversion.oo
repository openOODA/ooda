// # 3x3 Matrix Inversion Module
//
// Logline: Matrix inversion for 3x3 floating-point matrices using cofactor adjugate and determinant division.
//
// Setup: Pure math module. Inverts 3x3 transformation and coordinate matrices.
//
// Beats:
//   1. Define 3x3 matrix structure.
//   2. Compute 3x3 determinant.
//   3. Compute cofactor adjugate matrix.
//   4. Divide adjugate by determinant to produce inverse.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type Mat3Inv = struct {
    m00: Float, m01: Float, m02: Float,
    m10: Float, m11: Float, m12: Float,
    m20: Float, m21: Float, m22: Float
};

pub fn mat3_inv_new(
    m00: Float, m01: Float, m02: Float,
    m10: Float, m11: Float, m12: Float,
    m20: Float, m21: Float, m22: Float
) -> Mat3Inv {
    return Mat3Inv {
        m00: m00, m01: m01, m02: m02,
        m10: m10, m11: m11, m12: m12,
        m20: m20, m21: m21, m22: m22
    };
}

pub fn mat3_det_calc(m: Mat3Inv) -> Float {
    let a: Float = m.m00; let b: Float = m.m01; let c: Float = m.m02;
    let d: Float = m.m10; let e: Float = m.m11; let f: Float = m.m12;
    let g: Float = m.m20; let h: Float = m.m21; let i: Float = m.m22;
    return a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g);
}

pub fn mat3_invert(m: Mat3Inv) -> Result[Mat3Inv, String] {
    let det: Float = mat3_det_calc(m);
    if det == 0.0 {
        return Err("SINGULAR_MATRIX");
    }
    let inv_det: Float = 1.0 / det;
    let a: Float = m.m00; let b: Float = m.m01; let c: Float = m.m02;
    let d: Float = m.m10; let e: Float = m.m11; let f: Float = m.m12;
    let g: Float = m.m20; let h: Float = m.m21; let i: Float = m.m22;

    let c00: Float = (e * i - f * h) * inv_det;
    let c01: Float = (c * h - b * i) * inv_det;
    let c02: Float = (b * f - c * e) * inv_det;

    let c10: Float = (f * g - d * i) * inv_det;
    let c11: Float = (a * i - c * g) * inv_det;
    let c12: Float = (c * d - a * f) * inv_det;

    let c20: Float = (d * h - e * g) * inv_det;
    let c21: Float = (b * g - a * h) * inv_det;
    let c22: Float = (a * e - b * d) * inv_det;

    return Ok(Mat3Inv {
        m00: c00, m01: c01, m02: c02,
        m10: c10, m11: c11, m12: c12,
        m20: c20, m21: c21, m22: c22
    });
}
