// # QR Matrix Factorization and Least Squares Module
//
// Logline: QR Matrix Factorization via Modified Gram-Schmidt orthogonalization (A = QR), linear system solver, and least squares.
//
// Setup: Pure math module. Decomposes m x n matrices into orthogonal Q (m x n) and upper triangular R (n x n) factors.
//
// Beats:
//   1. Construct QrDecomp data structure with orthogonal Q and upper triangular R factors.
//   2. Factorize general m x n rectangular matrix A into A = Q * R using Modified Gram-Schmidt.
//   3. Solve linear system A * x = b via Q^T transformation and back substitution on R.
//   4. Compute linear least squares solution for overdetermined systems (A * x ~= b).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Householder reflections and Givens rotations lower to high-performance BLAS routines via backend.

import "std/result.oo";
import "std/math/matrix.oo";
import "std/math/blas_level1.oo";
import "std/math/blas_level2.oo";

type QrDecomp = struct {
    q: Matrix,
    r: Matrix
};

// Factorize m x n matrix into A = Q * R using Modified Gram-Schmidt.
pub fn matrix_qr(a: Matrix) -> QrDecomp {
    let m: Int = matrix_rows(a);
    let n: Int = matrix_cols(a);
    let mut q: Matrix = matrix_zeros(m, n);
    let mut r: Matrix = matrix_zeros(n, n);

    let mut j: Int = 0;
    while j < n {
        let mut i: Int = 0;
        while i < m {
            let v: Float = matrix_get(a, i, j);
            q = matrix_set(q, i, j, v);
            i = i + 1;
        }
        j = j + 1;
    }

    let mut k: Int = 0;
    while k < n {
        let mut v_k: List[Float] = list_new();
        let mut i: Int = 0;
        while i < m {
            v_k = list_push(v_k, matrix_get(q, i, k));
            i = i + 1;
        }
        let nrm: Float = blas_nrm2(v_k);
        r = matrix_set(r, k, k, nrm);
        if nrm > 0.0 {
            let mut i2: Int = 0;
            while i2 < m {
                let q_val: Float = list_get(v_k, i2) / nrm;
                q = matrix_set(q, i2, k, q_val);
                i2 = i2 + 1;
            }
        }

        let mut q_k: List[Float] = list_new();
        let mut i3: Int = 0;
        while i3 < m {
            q_k = list_push(q_k, matrix_get(q, i3, k));
            i3 = i3 + 1;
        }

        let mut j2: Int = k + 1;
        while j2 < n {
            let mut v_j: List[Float] = list_new();
            let mut i4: Int = 0;
            while i4 < m {
                v_j = list_push(v_j, matrix_get(q, i4, j2));
                i4 = i4 + 1;
            }
            let dot: Float = blas_dot(q_k, v_j);
            r = matrix_set(r, k, j2, dot);
            let mut i5: Int = 0;
            while i5 < m {
                let cur_q: Float = matrix_get(q, i5, j2);
                let qk_val: Float = list_get(q_k, i5);
                q = matrix_set(q, i5, j2, cur_q - dot * qk_val);
                i5 = i5 + 1;
            }
            j2 = j2 + 1;
        }

        k = k + 1;
    }

    return QrDecomp {
        q: q,
        r: r
    };
}

// Solve A * x = b using QR decomposition (R * x = Q^T * b).
pub fn qr_solve(qr: QrDecomp, b: List[Float]) -> Result[List[Float], String] {
    let qt: Matrix = matrix_transpose(qr.q);
    let n: Int = matrix_rows(qt);
    let mut zeros_y: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        zeros_y = list_push(zeros_y, 0.0);
        i = i + 1;
    }
    let y: List[Float] = blas_gemv(1.0, qt, b, 0.0, zeros_y);
    let x: List[Float] = blas_trsv_upper(qr.r, y);
    return Ok(x);
}

// Least squares fit for overdetermined system A * x ~= b.
pub fn qr_least_squares(a: Matrix, b: List[Float]) -> List[Float] {
    let qr: QrDecomp = matrix_qr(a);
    let qt: Matrix = matrix_transpose(qr.q);
    let n: Int = matrix_rows(qt);
    let mut zeros_y: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        zeros_y = list_push(zeros_y, 0.0);
        i = i + 1;
    }
    let y: List[Float] = blas_gemv(1.0, qt, b, 0.0, zeros_y);
    return blas_trsv_upper(qr.r, y);
}
