// # Combinations and Binomial Coefficients Module
//
// Logline: Binomial coefficients C(n, k) = n! / (k! * (n-k)!) and Pascal triangle row evaluations.
//
// Setup: Pure discrete mathematics module with overflow-resistant multiplicative calculations.
//
// Beats:
//   1. Compute binomial coefficient C(n, k).
//   2. Compute complete row of Pascal triangle.
//   3. Multinomial coefficient evaluations.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

pub fn math_combinations_count(n: Int, k: Int) -> Int {
    if k < 0 || k > n { return 0; }
    let mut r: Int = k;
    if r > n - r {
        r = n - r;
    }
    let mut res: Int = 1;
    let mut i: Int = 1;
    while i <= r {
        res = (res * (n - i + 1)) / i;
        i = i + 1;
    }
    return res;
}

pub fn math_pascal_row(row_idx: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut k: Int = 0;
    while k <= row_idx {
        out = list_push(out, math_combinations_count(row_idx, k));
        k = k + 1;
    }
    return out;
}
