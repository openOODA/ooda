// # Cubic Hermite 1D Spline Interpolation Module
//
// Logline: Cubic Hermite spline curve evaluation with position endpoints and tangent derivatives.
//
// Setup: Pure math module. Evaluates smooth C1 continuous cubic polynomials.
//
// Beats:
//   1. Evaluate Hermite basis functions h00, h10, h01, h11.
//   2. Interpolate position and tangents across unit interval t in [0, 1].
//   3. Evaluate first derivative velocity tangent.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

pub fn hermite_eval(p0: Float, m0: Float, p1: Float, m1: Float, t: Float) -> Float {
    let t2: Float = t * t;
    let t3: Float = t2 * t;

    let h00: Float = 2.0 * t3 - 3.0 * t2 + 1.0;
    let h10: Float = t3 - 2.0 * t2 + t;
    let h01: Float = (0.0 - 2.0) * t3 + 3.0 * t2;
    let h11: Float = t3 - t2;

    return h00 * p0 + h10 * m0 + h01 * p1 + h11 * m1;
}

pub fn hermite_velocity(p0: Float, m0: Float, p1: Float, m1: Float, t: Float) -> Float {
    let t2: Float = t * t;

    let dh00: Float = 6.0 * t2 - 6.0 * t;
    let dh10: Float = 3.0 * t2 - 4.0 * t + 1.0;
    let dh01: Float = (0.0 - 6.0) * t2 + 6.0 * t;
    let dh11: Float = 3.0 * t2 - 2.0 * t;

    return dh00 * p0 + dh10 * m0 + dh01 * p1 + dh11 * m1;
}
