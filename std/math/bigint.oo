// # Arbitrary Precision BigInt Representation Module
//
// Logline: Arbitrary precision integer struct with signed sign-magnitude representation, comparisons, and normalization.
//
// Setup: Pure math module. Stores arbitrarily large integers as little-endian base-10 digit lists.
//
// Beats:
//   1. Define BigInt data structure with explicit negative sign flag and digit count.
//   2. Construct zero, unit, and sign-flipped BigInt instances.
//   3. Implement absolute-value and signed three-way comparisons (-1, 0, 1).
//   4. Normalize leading zeros via bigint_trim.
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Storage uses base-10 digits for straightforward radix conversions without 64-bit overflow.

type BigInt = struct {
    is_neg: Bool,
    digits: List[Int],
    count: Int
};

pub fn bigint_zero() -> BigInt {
    let mut d: List[Int] = list_new();
    d = list_push(d, 0);
    return BigInt {
        is_neg: false,
        digits: d,
        count: 1
    };
}

pub fn bigint_one() -> BigInt {
    let mut d: List[Int] = list_new();
    d = list_push(d, 1);
    return BigInt {
        is_neg: false,
        digits: d,
        count: 1
    };
}

pub fn bigint_count(b: BigInt) -> Int {
    return b.count;
}

pub fn bigint_digit_at(b: BigInt, i: Int) -> Int {
    return list_get(b.digits, i);
}

pub fn bigint_is_zero(b: BigInt) -> Bool {
    let c: Int = b.count;
    if c == 0 {
        return true;
    }
    if c == 1 {
        if list_get(b.digits, 0) == 0 {
            return true;
        }
    }
    return false;
}

pub fn bigint_is_neg(b: BigInt) -> Bool {
    if bigint_is_zero(b) {
        return false;
    }
    return b.is_neg;
}

pub fn bigint_abs(b: BigInt) -> BigInt {
    return BigInt {
        is_neg: false,
        digits: b.digits,
        count: b.count
    };
}

pub fn bigint_neg(b: BigInt) -> BigInt {
    if bigint_is_zero(b) {
        return b;
    }
    let neg: Bool = b.is_neg;
    let mut new_neg: Bool = true;
    if neg == true {
        new_neg = false;
    }
    return BigInt {
        is_neg: new_neg,
        digits: b.digits,
        count: b.count
    };
}

pub fn bigint_trim(b: BigInt) -> BigInt {
    let mut c: Int = b.count;
    while c > 1 {
        let last_d: Int = list_get(b.digits, c - 1);
        if last_d == 0 {
            c = c - 1;
        } else {
            break;
        }
    }
    let mut res_is_neg: Bool = b.is_neg;
    if c == 1 && list_get(b.digits, 0) == 0 {
        res_is_neg = false;
    }
    return BigInt {
        is_neg: res_is_neg,
        digits: b.digits,
        count: c
    };
}

pub fn bigint_cmp_abs(a: BigInt, b: BigInt) -> Int {
    let ac: Int = a.count;
    let bc: Int = b.count;
    if ac < bc { return -1; }
    if ac > bc { return 1; }

    let mut i: Int = ac - 1;
    while i >= 0 {
        let da: Int = list_get(a.digits, i);
        let db: Int = list_get(b.digits, i);
        if da < db { return -1; }
        if da > db { return 1; }
        i = i - 1;
    }
    return 0;
}

pub fn bigint_cmp(a: BigInt, b: BigInt) -> Int {
    let a_zero: Bool = bigint_is_zero(a);
    let b_zero: Bool = bigint_is_zero(b);
    if a_zero && b_zero {
        return 0;
    }
    let aneg: Bool = a.is_neg;
    let bneg: Bool = b.is_neg;
    if aneg && !bneg { return -1; }
    if !aneg && bneg { return 1; }

    let abs_res: Int = bigint_cmp_abs(a, b);
    if aneg {
        return 0 - abs_res;
    }
    return abs_res;
}

pub fn bigint_eq(a: BigInt, b: BigInt) -> Bool {
    return bigint_cmp(a, b) == 0;
}

pub fn bigint_lt(a: BigInt, b: BigInt) -> Bool {
    return bigint_cmp(a, b) < 0;
}

pub fn bigint_gt(a: BigInt, b: BigInt) -> Bool {
    return bigint_cmp(a, b) > 0;
}
