// # 3D Rotation Quaternion Module
//
// Logline: Quaternion algebra, Hamilton products, unit normalization, and spatial rotation conversions.
//
// Setup: Pure math module. Implements 4D hypercomplex quaternions (w + xi + yj + zk) for 3D orientation.
//
// Beats:
//   1. Construct unit identity and arbitrary 4D Quaternion instances.
//   2. Hamilton quaternion multiplication (non-commutative composition).
//   3. Conjugation, Euclidean norm, unit normalization, and multiplicative inversion.
//   4. Construct rotation quaternion from arbitrary 3D axis and angle.
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Dual quaternions and continuous SLERP curve splines use base quaternion primitives.

type Quaternion = struct {
    w: Float,
    x: Float,
    y: Float,
    z: Float
};

pub fn quat_identity() -> Quaternion {
    return Quaternion {
        w: 1.0,
        x: 0.0,
        y: 0.0,
        z: 0.0
    };
}

pub fn quat_new(w: Float, x: Float, y: Float, z: Float) -> Quaternion {
    return Quaternion {
        w: w,
        x: x,
        y: y,
        z: z
    };
}

pub fn quat_add(a: Quaternion, b: Quaternion) -> Quaternion {
    let aw: Float = a.w;
    let ax: Float = a.x;
    let ay: Float = a.y;
    let az: Float = a.z;
    let bw: Float = b.w;
    let bx: Float = b.x;
    let by: Float = b.y;
    let bz: Float = b.z;
    return Quaternion {
        w: aw + bw,
        x: ax + bx,
        y: ay + by,
        z: az + bz
    };
}

pub fn quat_sub(a: Quaternion, b: Quaternion) -> Quaternion {
    let aw: Float = a.w;
    let ax: Float = a.x;
    let ay: Float = a.y;
    let az: Float = a.z;
    let bw: Float = b.w;
    let bx: Float = b.x;
    let by: Float = b.y;
    let bz: Float = b.z;
    return Quaternion {
        w: aw - bw,
        x: ax - bx,
        y: ay - by,
        z: az - bz
    };
}

pub fn quat_mul(a: Quaternion, b: Quaternion) -> Quaternion {
    let aw: Float = a.w;
    let ax: Float = a.x;
    let ay: Float = a.y;
    let az: Float = a.z;
    let bw: Float = b.w;
    let bx: Float = b.x;
    let by: Float = b.y;
    let bz: Float = b.z;

    let nw: Float = aw * bw - ax * bx - ay * by - az * bz;
    let nx: Float = aw * bx + ax * bw + ay * bz - az * by;
    let ny: Float = aw * by - ax * bz + ay * bw + az * bx;
    let nz: Float = aw * bz + ax * by - ay * bx + az * bw;

    return Quaternion {
        w: nw,
        x: nx,
        y: ny,
        z: nz
    };
}

pub fn quat_scale(q: Quaternion, s: Float) -> Quaternion {
    let qw: Float = q.w;
    let qx: Float = q.x;
    let qy: Float = q.y;
    let qz: Float = q.z;
    return Quaternion {
        w: qw * s,
        x: qx * s,
        y: qy * s,
        z: qz * s
    };
}

pub fn quat_conjugate(q: Quaternion) -> Quaternion {
    let qw: Float = q.w;
    let qx: Float = q.x;
    let qy: Float = q.y;
    let qz: Float = q.z;
    return Quaternion {
        w: qw,
        x: 0.0 - qx,
        y: 0.0 - qy,
        z: 0.0 - qz
    };
}

pub fn quat_norm_sq(q: Quaternion) -> Float {
    let qw: Float = q.w;
    let qx: Float = q.x;
    let qy: Float = q.y;
    let qz: Float = q.z;
    return qw * qw + qx * qx + qy * qy + qz * qz;
}

pub fn quat_norm(q: Quaternion) -> Float {
    let sq: Float = quat_norm_sq(q);
    return sqrt(sq);
}

pub fn quat_normalize(q: Quaternion) -> Quaternion {
    let n: Float = quat_norm(q);
    if n == 0.0 {
        return quat_identity();
    }
    return quat_scale(q, 1.0 / n);
}

pub fn quat_inverse(q: Quaternion) -> Quaternion {
    let sq: Float = quat_norm_sq(q);
    if sq == 0.0 {
        return quat_identity();
    }
    let conj: Quaternion = quat_conjugate(q);
    return quat_scale(conj, 1.0 / sq);
}

pub fn quat_dot(a: Quaternion, b: Quaternion) -> Float {
    let aw: Float = a.w;
    let ax: Float = a.x;
    let ay: Float = a.y;
    let az: Float = a.z;
    let bw: Float = b.w;
    let bx: Float = b.x;
    let by: Float = b.y;
    let bz: Float = b.z;
    return aw * bw + ax * bx + ay * by + az * bz;
}

pub fn quat_from_axis_angle(ax: Float, ay: Float, az: Float, angle_rad: Float) -> Quaternion {
    let axis_len: Float = sqrt(ax * ax + ay * ay + az * az);
    if axis_len == 0.0 {
        return quat_identity();
    }
    let half_angle: Float = angle_rad * 0.5;
    let s: Float = sin(half_angle) / axis_len;
    let c: Float = cos(half_angle);
    return Quaternion {
        w: c,
        x: ax * s,
        y: ay * s,
        z: az * s
    };
}
