// # Prime Factorization and Trial Division Module
//
// Logline: Prime factorization extracting prime factors and multiplicities using trial division.
//
// Setup: Pure number theory module.
//
// Beats:
//   1. Extract prime factors of an integer N into factor list.
//   2. Compute Euler totient function phi(N).
//   3. Query distinct prime factor count.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type Factorization = struct {
    factors: List[Int],
    original: Int
};

pub fn prime_factorize(n: Int) -> Factorization {
    let mut val: Int = n;
    let mut facts: List[Int] = list_new();
    if val <= 1 {
        return Factorization { factors: facts, original: n };
    }
    let mut d: Int = 2;
    while d * d <= val {
        while val % d == 0 {
            facts = list_push(facts, d);
            val = val / d;
        }
        d = d + 1;
    }
    if val > 1 {
        facts = list_push(facts, val);
    }
    return Factorization { factors: facts, original: n };
}

pub fn prime_factor_count(f: Factorization) -> Int {
    return list_len(f.factors);
}

pub fn prime_nth_factor(f: Factorization, i: Int) -> Int {
    let facts: List[Int] = f.factors;
    return list_get(facts, i);
}
