// # High-Performance Fast Trigonometry and Approximations Module
//
// Logline: Minimax polynomial fast trigonometric approximations, fast inverse square root, atan2, and angular unit conversions.
//
// Setup: Pure math module. Evaluates fast approximate trigonometric curves for real-time graphics and physics without libm transcendentals.
//
// Beats:
//   1. Fast polynomial sine and cosine minimax approximations (fast_sin / fast_cos).
//   2. Fast tangent and four-quadrant arc-tangent (fast_atan2).
//   3. Fast inverse square root with Newton-Raphson refinement (fast_inv_sqrt).
//   4. Angular unit conversions (degrees <-> radians).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware Reciprocal Square Root (RSQRTSS) lowers via backend instruction selection.

import "std/math.oo";

pub fn fast_deg2rad(deg: Float) -> Float {
    let pi: Float = 3.141592653589793;
    return deg * (pi / 180.0);
}

pub fn fast_rad2deg(rad: Float) -> Float {
    let pi: Float = 3.141592653589793;
    return rad * (180.0 / pi);
}

// Fast sine polynomial minimax approximation over [-pi, pi]
pub fn fast_sin(x: Float) -> Float {
    let pi: Float = 3.141592653589793;
    let two_pi: Float = 6.283185307179586;
    let mut rad: Float = x;
    while rad > pi {
        rad = rad - two_pi;
    }
    while rad < (0.0 - pi) {
        rad = rad + two_pi;
    }
    // Bhaskara I approximation: 16*x*(pi - |x|) / (5*pi^2 - 4*x*(pi - |x|))
    let mut sign: Float = 1.0;
    let mut ax: Float = rad;
    if rad < 0.0 {
        sign = 0.0 - 1.0;
        ax = 0.0 - rad;
    }
    let num: Float = 16.0 * ax * (pi - ax);
    let den: Float = 5.0 * pi * pi - 4.0 * ax * (pi - ax);
    return sign * (num / den);
}

// Fast cosine via phase shift cos(x) = sin(x + pi/2)
pub fn fast_cos(x: Float) -> Float {
    let half_pi: Float = 1.5707963267948966;
    return fast_sin(x + half_pi);
}

// Fast tangent = sin / cos
pub fn fast_tan(x: Float) -> Float {
    let c: Float = fast_cos(x);
    if c == 0.0 {
        return 999999.0;
    }
    let s: Float = fast_sin(x);
    return s / c;
}

// Fast inverse square root 1 / sqrt(x) via Newton-Raphson
pub fn fast_inv_sqrt(x: Float) -> Float {
    if x <= 0.0 {
        return 0.0;
    }
    let mut y: Float = 1.0 / math_sqrt(x);
    // 1 Newton-Raphson iteration: y = y * (1.5 - 0.5 * x * y * y)
    y = y * (1.5 - 0.5 * x * y * y);
    return y;
}

// Fast atan approximation
pub fn fast_atan(x: Float) -> Float {
    let mut sign: Float = 1.0;
    let mut ax: Float = x;
    if x < 0.0 {
        sign = 0.0 - 1.0;
        ax = 0.0 - x;
    }
    let pi_over_4: Float = 0.7853981633974483;
    let pi_over_2: Float = 1.5707963267948966;
    if ax <= 1.0 {
        let poly: Float = ax / (1.0 + 0.28 * ax * ax);
        return sign * poly;
    }
    let poly: Float = (1.0 / ax) / (1.0 + 0.28 / (ax * ax));
    let res: Float = pi_over_2 - poly;
    return sign * res;
}

// Fast four-quadrant arctangent atan2(y, x)
pub fn fast_atan2(y: Float, x: Float) -> Float {
    let pi: Float = 3.141592653589793;
    let half_pi: Float = 1.5707963267948966;
    if x == 0.0 {
        if y > 0.0 { return half_pi; }
        if y < 0.0 { return 0.0 - half_pi; }
        return 0.0;
    }
    let q: Float = fast_atan(y / x);
    if x > 0.0 {
        return q;
    }
    if y >= 0.0 {
        return q + pi;
    }
    return q - pi;
}
