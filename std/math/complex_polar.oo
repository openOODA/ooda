// # Polar Coordinate Complex Number Module
//
// Logline: Complex numbers represented in polar form (magnitude r, angle theta) with Euler formula conversion.
//
// Setup: Pure math module for signal processing, phasor calculations, and rotations.
//
// Beats:
//   1. Construct ComplexPolar with radius r and angle theta radians.
//   2. Multiply and divide polar complex numbers (r1*r2, theta1+theta2).
//   3. Exponentiation to integer powers (De Moivre theorem).
//   4. Convert between Cartesian (x, y) and polar (r, theta).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/math.oo";

type ComplexPolar = struct {
    r: Float,
    theta: Float
};

pub fn complex_polar_new(r: Float, theta: Float) -> ComplexPolar {
    let mut rad: Float = r;
    if rad < 0.0 { rad = 0.0 - rad; }
    return ComplexPolar { r: rad, theta: theta };
}

pub fn complex_polar_mul(a: ComplexPolar, b: ComplexPolar) -> ComplexPolar {
    let ar: Float = a.r; let at: Float = a.theta;
    let br: Float = b.r; let bt: Float = b.theta;
    return ComplexPolar {
        r: ar * br,
        theta: at + bt
    };
}

pub fn complex_polar_div(a: ComplexPolar, b: ComplexPolar) -> ComplexPolar {
    let ar: Float = a.r; let at: Float = a.theta;
    let br: Float = b.r; let bt: Float = b.theta;
    if br == 0.0 {
        return ComplexPolar { r: 0.0, theta: 0.0 };
    }
    return ComplexPolar {
        r: ar / br,
        theta: at - bt
    };
}

pub fn complex_polar_pow(c: ComplexPolar, n: Float) -> ComplexPolar {
    let cr: Float = c.r; let ct: Float = c.theta;
    let new_r: Float = math_pow(cr, n);
    return ComplexPolar {
        r: new_r,
        theta: ct * n
    };
}
