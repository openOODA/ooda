// # Complex Number Arithmetic and Polar Operations Module
//
// Logline: Complex number struct, Cartesian arithmetic, conjugation, norm, and exponential functions.
//
// Setup: Pure math module. Employs IEEE-754 double floats for real and imaginary components.
//
// Beats:
//   1. Construct Complex numbers with Cartesian real and imaginary components.
//   2. Complex addition, subtraction, multiplication, and reciprocal division.
//   3. Complex conjugation, squared magnitude, and absolute Euclidean norm.
//   4. Complex exponential function via Euler's formula: exp(a + bi) = exp(a)*(cos(b) + i*sin(b)).
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Complex roots and trigonometric transcendental functions use polar projections.

type Complex = struct {
    re: Float,
    im: Float
};

pub fn complex_new(re: Float, im: Float) -> Complex {
    return Complex {
        re: re,
        im: im
    };
}

pub fn complex_zero() -> Complex {
    return Complex { re: 0.0, im: 0.0 };
}

pub fn complex_one() -> Complex {
    return Complex { re: 1.0, im: 0.0 };
}

pub fn complex_i() -> Complex {
    return Complex { re: 0.0, im: 1.0 };
}

pub fn complex_add(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.re;
    let ai: Float = a.im;
    let br: Float = b.re;
    let bi: Float = b.im;
    return Complex {
        re: ar + br,
        im: ai + bi
    };
}

pub fn complex_sub(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.re;
    let ai: Float = a.im;
    let br: Float = b.re;
    let bi: Float = b.im;
    return Complex {
        re: ar - br,
        im: ai - bi
    };
}

pub fn complex_mul(a: Complex, b: Complex) -> Complex {
    let ar: Float = a.re;
    let ai: Float = a.im;
    let br: Float = b.re;
    let bi: Float = b.im;
    return Complex {
        re: ar * br - ai * bi,
        im: ar * bi + ai * br
    };
}

pub fn complex_mag_sq(c: Complex) -> Float {
    let cr: Float = c.re;
    let ci: Float = c.im;
    return cr * cr + ci * ci;
}

pub fn complex_mag(c: Complex) -> Float {
    let sq: Float = complex_mag_sq(c);
    return sqrt(sq);
}

pub fn complex_div(a: Complex, b: Complex) -> Complex {
    let denom: Float = complex_mag_sq(b);
    if denom == 0.0 {
        return Complex { re: 0.0, im: 0.0 };
    }
    let ar: Float = a.re;
    let ai: Float = a.im;
    let br: Float = b.re;
    let bi: Float = b.im;
    let new_re: Float = (ar * br + ai * bi) / denom;
    let new_im: Float = (ai * br - ar * bi) / denom;
    return Complex {
        re: new_re,
        im: new_im
    };
}

pub fn complex_conjugate(c: Complex) -> Complex {
    let cr: Float = c.re;
    let ci: Float = c.im;
    return Complex {
        re: cr,
        im: 0.0 - ci
    };
}

pub fn complex_scale(c: Complex, s: Float) -> Complex {
    let cr: Float = c.re;
    let ci: Float = c.im;
    return Complex {
        re: cr * s,
        im: ci * s
    };
}

pub fn complex_neg(c: Complex) -> Complex {
    let cr: Float = c.re;
    let ci: Float = c.im;
    return Complex {
        re: 0.0 - cr,
        im: 0.0 - ci
    };
}

pub fn complex_exp(c: Complex) -> Complex {
    let cr: Float = c.re;
    let ci: Float = c.im;
    let r: Float = exp(cr);
    let cos_val: Float = cos(ci);
    let sin_val: Float = sin(ci);
    return Complex {
        re: r * cos_val,
        im: r * sin_val
    };
}
