// # Statistical Analysis and Summary Moments Module
//
// Logline: Descriptive statistics, moments, sample variance, standard deviation, covariance, and correlation.
//
// Setup: Pure math module. Calculates statistical indicators on List[Float] datasets.
//
// Beats:
//   1. Compute sample sum, arithmetic mean, minimum, maximum, and range.
//   2. Calculate two-pass sample variance and standard deviation.
//   3. Aggregate comprehensive descriptive statistics into StatsSummary.
//   4. Calculate bivariate sample covariance and Pearson correlation coefficient.
// RULES.oot 1.4: Pure mathematical statistics, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Weighted histograms and multi-dimensional regression fits use baseline moment statistics.

type StatsSummary = struct {
    count: Int,
    sum: Float,
    mean: Float,
    min_val: Float,
    max_val: Float,
    variance: Float,
    std_dev: Float
};

pub fn stats_sum(xs: List[Float]) -> Float {
    let n: Int = list_len(xs);
    let mut s: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        s = s + list_get(xs, i);
        i = i + 1;
    }
    return s;
}

pub fn stats_mean(xs: List[Float]) -> Float {
    let n: Int = list_len(xs);
    if n == 0 {
        return 0.0;
    }
    let s: Float = stats_sum(xs);
    let f_n: Float = 1.0 * n;
    return s / f_n;
}

pub fn stats_min(xs: List[Float]) -> Float {
    let n: Int = list_len(xs);
    if n == 0 {
        return 0.0;
    }
    let mut m: Float = list_get(xs, 0);
    let mut i: Int = 1;
    while i < n {
        let v: Float = list_get(xs, i);
        if v < m {
            m = v;
        }
        i = i + 1;
    }
    return m;
}

pub fn stats_max(xs: List[Float]) -> Float {
    let n: Int = list_len(xs);
    if n == 0 {
        return 0.0;
    }
    let mut m: Float = list_get(xs, 0);
    let mut i: Int = 1;
    while i < n {
        let v: Float = list_get(xs, i);
        if v > m {
            m = v;
        }
        i = i + 1;
    }
    return m;
}

pub fn stats_range(xs: List[Float]) -> Float {
    let mx: Float = stats_max(xs);
    let mn: Float = stats_min(xs);
    return mx - mn;
}

pub fn stats_variance(xs: List[Float]) -> Float {
    let n: Int = list_len(xs);
    if n <= 1 {
        return 0.0;
    }
    let m: Float = stats_mean(xs);
    let mut sum_sq: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let v: Float = list_get(xs, i);
        let diff: Float = v - m;
        sum_sq = sum_sq + diff * diff;
        i = i + 1;
    }
    let denom: Float = 1.0 * (n - 1);
    return sum_sq / denom;
}

pub fn stats_std_dev(xs: List[Float]) -> Float {
    let var_val: Float = stats_variance(xs);
    return sqrt(var_val);
}

pub fn stats_summary(xs: List[Float]) -> StatsSummary {
    let n: Int = list_len(xs);
    let s: Float = stats_sum(xs);
    let m: Float = stats_mean(xs);
    let mn: Float = stats_min(xs);
    let mx: Float = stats_max(xs);
    let v: Float = stats_variance(xs);
    let sd: Float = sqrt(v);
    return StatsSummary {
        count: n,
        sum: s,
        mean: m,
        min_val: mn,
        max_val: mx,
        variance: v,
        std_dev: sd
    };
}

pub fn stats_covariance(xs: List[Float], ys: List[Float]) -> Float {
    let nx: Int = list_len(xs);
    let ny: Int = list_len(ys);
    let mut n: Int = nx;
    if ny < n {
        n = ny;
    }
    if n <= 1 {
        return 0.0;
    }
    let mx: Float = stats_mean(xs);
    let my: Float = stats_mean(ys);
    let mut cov_sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let vx: Float = list_get(xs, i);
        let vy: Float = list_get(ys, i);
        cov_sum = cov_sum + (vx - mx) * (vy - my);
        i = i + 1;
    }
    let denom: Float = 1.0 * (n - 1);
    return cov_sum / denom;
}

pub fn stats_correlation(xs: List[Float], ys: List[Float]) -> Float {
    let cov: Float = stats_covariance(xs, ys);
    let sx: Float = stats_std_dev(xs);
    let sy: Float = stats_std_dev(ys);
    let denom: Float = sx * sy;
    if denom == 0.0 {
        return 0.0;
    }
    return cov / denom;
}
