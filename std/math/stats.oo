// # Statistical Analysis and Summary Moments Module
//
// Logline: Sum, mean, min, max, and range on List[Int] samples.
//
// Setup: Pure math. Emit-c lowers List[Float] add as string concat, so samples are Int.
//
// Beats:
//   1. Compute sample sum, integer mean, min, max, and range.
//   2. Empty list sum/mean is 0.
// RULES.oot 1.4: Pure mathematical statistics, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: List[Float] emit concat; variance/covariance stay off this floor

pub fn stats_fadd(a: Float, b: Float) -> Float {
    return a + b;
}

pub fn stats_sum(xs: List[Int]) -> Int {
    let n: Int = list_len(xs);
    let mut s: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let v: Int = list_get(xs, i);
        s = s + v;
        i = i + 1;
    }
    return s;
}

pub fn stats_mean(xs: List[Int]) -> Int {
    let n: Int = list_len(xs);
    if n == 0 {
        return 0;
    }
    let s: Int = stats_sum(xs);
    return s / n;
}

pub fn stats_min(xs: List[Int]) -> Int {
    let n: Int = list_len(xs);
    if n == 0 {
        return 0;
    }
    let mut m: Int = list_get(xs, 0);
    let mut i: Int = 1;
    while i < n {
        let v: Int = list_get(xs, i);
        if v < m {
            m = v;
        }
        i = i + 1;
    }
    return m;
}

pub fn stats_max(xs: List[Int]) -> Int {
    let n: Int = list_len(xs);
    if n == 0 {
        return 0;
    }
    let mut m: Int = list_get(xs, 0);
    let mut i: Int = 1;
    while i < n {
        let v: Int = list_get(xs, i);
        if v > m {
            m = v;
        }
        i = i + 1;
    }
    return m;
}

pub fn stats_range(xs: List[Int]) -> Int {
    let mx: Int = stats_max(xs);
    let mn: Int = stats_min(xs);
    return mx - mn;
}
