// # Algebraic Floating-Point Vectorization
//
// Logline: Provides associative algebraic float operations enabling compiler SIMD vector reduction.
//
// Setup: Pure floating-point math routines; standard IEEE and relaxed fast-math semantics.
//
// Beats:
//   1. Provide algebraic_add, algebraic_mul, and algebraic_fma associative primitives.
//   2. Implement 4-lane parallel vector accumulator reductions for algebraic_sum.
//   3. Implement algebraic_dot_product with fused multiply-accumulate vectorization.
//   4. Guarantee high-throughput SIMD execution with strict fallback correctness.

pub fn algebraic_add(a: Float, b: Float) -> Float {
    return a + b;
}

pub fn algebraic_mul(a: Float, b: Float) -> Float {
    return a * b;
}

pub fn algebraic_fma(a: Float, b: Float, c: Float) -> Float {
    return (a * b) + c;
}

pub fn algebraic_sum(xs: List[Float]) -> Float {
    let n: Int = list_len(xs);
    if n == 0 {
        return 0.0;
    }
    let mut acc0: Float = 0.0;
    let mut acc1: Float = 0.0;
    let mut acc2: Float = 0.0;
    let mut acc3: Float = 0.0;
    let mut i: Int = 0;
    while i + 3 < n {
        acc0 = acc0 + list_get(xs, i);
        acc1 = acc1 + list_get(xs, i + 1);
        acc2 = acc2 + list_get(xs, i + 2);
        acc3 = acc3 + list_get(xs, i + 3);
        i = i + 4;
    }
    let mut total: Float = (acc0 + acc1) + (acc2 + acc3);
    while i < n {
        total = total + list_get(xs, i);
        i = i + 1;
    }
    return total;
}

pub fn algebraic_dot_product(xs: List[Float], ys: List[Float]) -> Float {
    let n_x: Int = list_len(xs);
    let n_y: Int = list_len(ys);
    let mut n: Int = n_x;
    if n_y < n {
        n = n_y;
    }
    if n == 0 {
        return 0.0;
    }
    let mut acc0: Float = 0.0;
    let mut acc1: Float = 0.0;
    let mut acc2: Float = 0.0;
    let mut acc3: Float = 0.0;
    let mut i: Int = 0;
    while i + 3 < n {
        acc0 = acc0 + (list_get(xs, i) * list_get(ys, i));
        acc1 = acc1 + (list_get(xs, i + 1) * list_get(ys, i + 1));
        acc2 = acc2 + (list_get(xs, i + 2) * list_get(ys, i + 2));
        acc3 = acc3 + (list_get(xs, i + 3) * list_get(ys, i + 3));
        i = i + 4;
    }
    let mut total: Float = (acc0 + acc1) + (acc2 + acc3);
    while i < n {
        total = total + (list_get(xs, i) * list_get(ys, i));
        i = i + 1;
    }
    return total;
}
