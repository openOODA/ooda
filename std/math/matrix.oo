// # Row-Major Floating-Point Matrix Module
//
// Logline: Flat row-major matrix data structure, zero/identity initializers, indexing, and transposition.
//
// Setup: Pure math module. Stores continuous 2D matrices in flat List[Float] arrays.
//
// Beats:
//   1. Define Matrix structure with row/col dimensions and flat List[Float] payload.
//   2. Construct zero-filled and identity matrices of arbitrary dimension.
//   3. Row-major element indexing (r * cols + c) with immutable matrix_set rebuilds.
//   4. Transpose rectangular matrices (m x n -> n x m).
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Sparse matrix layouts and GPU/SIMD acceleration are reserved for specialized backends.

type Matrix = struct {
    rows: Int,
    cols: Int,
    data: List[Float]
};

pub fn matrix_zeros(rows: Int, cols: Int) -> Matrix {
    let mut d: List[Float] = list_new();
    let total: Int = rows * cols;
    let mut i: Int = 0;
    while i < total {
        d = list_push(d, 0.0);
        i = i + 1;
    }
    return Matrix {
        rows: rows,
        cols: cols,
        data: d
    };
}

pub fn matrix_identity(n: Int) -> Matrix {
    let mut d: List[Float] = list_new();
    let mut r: Int = 0;
    while r < n {
        let mut c: Int = 0;
        while c < n {
            if r == c {
                d = list_push(d, 1.0);
            } else {
                d = list_push(d, 0.0);
            }
            c = c + 1;
        }
        r = r + 1;
    }
    return Matrix {
        rows: n,
        cols: n,
        data: d
    };
}

pub fn matrix_rows(m: Matrix) -> Int {
    return m.rows;
}

pub fn matrix_cols(m: Matrix) -> Int {
    return m.cols;
}

pub fn matrix_is_square(m: Matrix) -> Bool {
    let r: Int = m.rows;
    let c: Int = m.cols;
    return r == c;
}

pub fn matrix_get(m: Matrix, r: Int, c: Int) -> Float {
    let num_cols: Int = m.cols;
    let idx: Int = r * num_cols + c;
    return list_get(m.data, idx);
}

pub fn matrix_set(m: Matrix, r: Int, c: Int, val: Float) -> Matrix {
    let num_cols: Int = m.cols;
    let target_idx: Int = r * num_cols + c;
    let mut new_data: List[Float] = list_new();
    let total: Int = list_len(m.data);
    let mut i: Int = 0;
    while i < total {
        if i == target_idx {
            new_data = list_push(new_data, val);
        } else {
            new_data = list_push(new_data, list_get(m.data, i));
        }
        i = i + 1;
    }
    return Matrix {
        rows: m.rows,
        cols: m.cols,
        data: new_data
    };
}

pub fn matrix_transpose(m: Matrix) -> Matrix {
    let r_count: Int = m.rows;
    let c_count: Int = m.cols;
    let mut d: List[Float] = list_new();
    let mut c: Int = 0;
    while c < c_count {
        let mut r: Int = 0;
        while r < r_count {
            let v: Float = matrix_get(m, r, c);
            d = list_push(d, v);
            r = r + 1;
        }
        c = c + 1;
    }
    return Matrix {
        rows: c_count,
        cols: r_count,
        data: d
    };
}

pub fn matrix_from_diag(diag: List[Float]) -> Matrix {
    let n: Int = list_len(diag);
    let mut d: List[Float] = list_new();
    let mut r: Int = 0;
    while r < n {
        let mut c: Int = 0;
        while c < n {
            if r == c {
                d = list_push(d, list_get(diag, r));
            } else {
                d = list_push(d, 0.0);
            }
            c = c + 1;
        }
        r = r + 1;
    }
    return Matrix {
        rows: n,
        cols: n,
        data: d
    };
}
