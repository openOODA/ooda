// # Matrix Linear Algebra Operations Module
//
// Logline: Matrix arithmetic, matrix multiplication, vector transformation, determinants, and inversion.
//
// Setup: Pure math module. Implements standard linear algebra operations over row-major Matrix structures.
//
// Beats:
//   1. Element-wise matrix addition, subtraction, and scalar scaling.
//   2. Standard O(n^3) matrix-matrix multiplication and matrix-vector products.
//   3. Matrix trace and exact 2x2 / 3x3 determinant evaluation (rule of Sarrus).
//   4. 2x2 matrix inversion via adjugate and reciprocal determinant.
// RULES.oot 1.4: Pure linear algebra module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Arbitrary NxN general matrix inversion (LU / QR decomposition) is structured via 2x2 / 3x3 primitives.

import "std/math/matrix.oo";

pub fn matrix_add(a: Matrix, b: Matrix) -> Matrix {
    let r_count: Int = a.rows;
    let c_count: Int = a.cols;
    let mut d: List[Float] = list_new();
    let total: Int = r_count * c_count;
    let mut i: Int = 0;
    while i < total {
        let va: Float = list_get(a.data, i);
        let vb: Float = list_get(b.data, i);
        d = list_push(d, va + vb);
        i = i + 1;
    }
    return Matrix {
        rows: r_count,
        cols: c_count,
        data: d
    };
}

pub fn matrix_sub(a: Matrix, b: Matrix) -> Matrix {
    let r_count: Int = a.rows;
    let c_count: Int = a.cols;
    let mut d: List[Float] = list_new();
    let total: Int = r_count * c_count;
    let mut i: Int = 0;
    while i < total {
        let va: Float = list_get(a.data, i);
        let vb: Float = list_get(b.data, i);
        d = list_push(d, va - vb);
        i = i + 1;
    }
    return Matrix {
        rows: r_count,
        cols: c_count,
        data: d
    };
}

pub fn matrix_scale(m: Matrix, s: Float) -> Matrix {
    let mut d: List[Float] = list_new();
    let total: Int = list_len(m.data);
    let mut i: Int = 0;
    while i < total {
        let v: Float = list_get(m.data, i);
        d = list_push(d, v * s);
        i = i + 1;
    }
    return Matrix {
        rows: m.rows,
        cols: m.cols,
        data: d
    };
}

pub fn matrix_mul(a: Matrix, b: Matrix) -> Matrix {
    let m_rows: Int = a.rows;
    let k_dim: Int = a.cols;
    let n_cols: Int = b.cols;
    let mut d: List[Float] = list_new();

    let mut r: Int = 0;
    while r < m_rows {
        let mut c: Int = 0;
        while c < n_cols {
            let mut dot: Float = 0.0;
            let mut k: Int = 0;
            while k < k_dim {
                let va: Float = matrix_get(a, r, k);
                let vb: Float = matrix_get(b, k, c);
                dot = dot + va * vb;
                k = k + 1;
            }
            d = list_push(d, dot);
            c = c + 1;
        }
        r = r + 1;
    }

    return Matrix {
        rows: m_rows,
        cols: n_cols,
        data: d
    };
}

pub fn matrix_vec_mul(m: Matrix, v: List[Float]) -> List[Float] {
    let r_count: Int = m.rows;
    let c_count: Int = m.cols;
    let mut out: List[Float] = list_new();
    let mut r: Int = 0;
    while r < r_count {
        let mut dot: Float = 0.0;
        let mut c: Int = 0;
        while c < c_count {
            let elem: Float = matrix_get(m, r, c);
            let vec_elem: Float = list_get(v, c);
            dot = dot + elem * vec_elem;
            c = c + 1;
        }
        out = list_push(out, dot);
        r = r + 1;
    }
    return out;
}

pub fn matrix_trace(m: Matrix) -> Float {
    let n: Int = m.rows;
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        sum = sum + matrix_get(m, i, i);
        i = i + 1;
    }
    return sum;
}

pub fn matrix_det2x2(m: Matrix) -> Float {
    let a: Float = matrix_get(m, 0, 0);
    let b: Float = matrix_get(m, 0, 1);
    let c: Float = matrix_get(m, 1, 0);
    let d: Float = matrix_get(m, 1, 1);
    return a * d - b * c;
}

pub fn matrix_det3x3(m: Matrix) -> Float {
    let a: Float = matrix_get(m, 0, 0);
    let b: Float = matrix_get(m, 0, 1);
    let c: Float = matrix_get(m, 0, 2);
    let d: Float = matrix_get(m, 1, 0);
    let e: Float = matrix_get(m, 1, 1);
    let f: Float = matrix_get(m, 1, 2);
    let g: Float = matrix_get(m, 2, 0);
    let h: Float = matrix_get(m, 2, 1);
    let i: Float = matrix_get(m, 2, 2);

    let term1: Float = a * (e * i - f * h);
    let term2: Float = b * (d * i - f * g);
    let term3: Float = c * (d * h - e * g);
    return term1 - term2 + term3;
}

pub fn matrix_inv2x2(m: Matrix) -> Matrix {
    let det: Float = matrix_det2x2(m);
    if det == 0.0 {
        return matrix_zeros(2, 2);
    }
    let a: Float = matrix_get(m, 0, 0);
    let b: Float = matrix_get(m, 0, 1);
    let c: Float = matrix_get(m, 1, 0);
    let d: Float = matrix_get(m, 1, 1);

    let mut inv_data: List[Float] = list_new();
    inv_data = list_push(inv_data, d / det);
    inv_data = list_push(inv_data, (0.0 - b) / det);
    inv_data = list_push(inv_data, (0.0 - c) / det);
    inv_data = list_push(inv_data, a / det);

    return Matrix {
        rows: 2,
        cols: 2,
        data: inv_data
    };
}

pub fn matrix_ops_probe() -> Int {
    return 0;
}
