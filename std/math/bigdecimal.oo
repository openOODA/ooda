// # Arbitrary Precision BigDecimal Module
//
// Logline: Arbitrary precision decimal arithmetic with exact decimal scaling, string parsing, and formatting.
//
// Setup: Pure math module. Stores exact decimal numbers as an unscaled BigInt/string with an explicit scale exponent.
//
// Beats:
//   1. Define BigDecimal structure storing unscaled digits and scale exponent.
//   2. Parse decimal string representations with optional sign and decimal points.
//   3. Scale alignment between operands for exact decimal addition and subtraction.
//   4. Format BigDecimal values back to standard decimal notation.
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Repeating decimal quotients (such as 1/3) require an explicit caller precision limit.

import "std/math/bigint.oo";
import "std/math/bigint_ops.oo";
import "std/math/bigint_str.oo";

type BigDecimal = struct {
    is_neg: Bool,
    unscaled_str: String,
    scale: Int
};

pub fn bigdec_zero() -> BigDecimal {
    return BigDecimal {
        is_neg: false,
        unscaled_str: "0",
        scale: 0
    };
}

pub fn bigdec_one() -> BigDecimal {
    return BigDecimal {
        is_neg: false,
        unscaled_str: "1",
        scale: 0
    };
}

pub fn bigdec_is_zero(d: BigDecimal) -> Bool {
    let u: String = d.unscaled_str;
    if u == "0" || u == "" {
        return true;
    }
    let n: Int = chars_len(u);
    let mut i: Int = 0;
    while i < n {
        if char_at(u, i) != "0" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn bigdec_is_neg(d: BigDecimal) -> Bool {
    if bigdec_is_zero(d) {
        return false;
    }
    return d.is_neg;
}

pub fn bigdec_neg(d: BigDecimal) -> BigDecimal {
    if bigdec_is_zero(d) {
        return d;
    }
    let neg: Bool = d.is_neg;
    let new_neg: Bool = !neg;
    return BigDecimal {
        is_neg: new_neg,
        unscaled_str: d.unscaled_str,
        scale: d.scale
    };
}

pub fn bigdec_abs(d: BigDecimal) -> BigDecimal {
    return BigDecimal {
        is_neg: false,
        unscaled_str: d.unscaled_str,
        scale: d.scale
    };
}

pub fn bigdec_from_int(v: Int) -> BigDecimal {
    let mut is_neg: Bool = false;
    let mut val: Int = v;
    if val < 0 {
        is_neg = true;
        val = 0 - val;
    }
    return BigDecimal {
        is_neg: is_neg,
        unscaled_str: val.to_string(),
        scale: 0
    };
}

pub fn bigdec_from_str(s: String) -> BigDecimal {
    let n: Int = chars_len(s);
    if n == 0 {
        return bigdec_zero();
    }

    let mut is_neg: Bool = false;
    let mut start: Int = 0;
    if char_at(s, 0) == "-" {
        is_neg = true;
        start = 1;
    } else if char_at(s, 0) == "+" {
        start = 1;
    }

    let dot_pos: Int = str_index_of(s, ".");
    if dot_pos < 0 {
        let unscaled: String = str_slice(s, start, n);
        return BigDecimal {
            is_neg: is_neg,
            unscaled_str: unscaled,
            scale: 0
        };
    }

    let int_part: String = str_slice(s, start, dot_pos);
    let frac_part: String = str_slice(s, dot_pos + 1, n);
    let scale: Int = chars_len(frac_part);
    let unscaled2: String = int_part + frac_part;

    return BigDecimal {
        is_neg: is_neg,
        unscaled_str: unscaled2,
        scale: scale
    };
}

pub fn bigdec_to_str(d: BigDecimal) -> String {
    if bigdec_is_zero(d) {
        return "0";
    }
    let u: String = d.unscaled_str;
    let s: Int = d.scale;
    let mut out: String = "";
    let neg: Bool = d.is_neg;
    if neg {
        out = "-";
    }

    let ulen: Int = chars_len(u);
    if s == 0 {
        return out + u;
    }

    if ulen <= s {
        out = out + "0.";
        let zeros_needed: Int = s - ulen;
        let mut i: Int = 0;
        while i < zeros_needed {
            out = out + "0";
            i = i + 1;
        }
        out = out + u;
        return out;
    }

    let int_len: Int = ulen - s;
    let int_part: String = str_slice(u, 0, int_len);
    let frac_part: String = str_slice(u, int_len, ulen);
    return out + int_part + "." + frac_part;
}

pub fn bigdec_align_scale(d: BigDecimal, target_scale: Int) -> BigDecimal {
    let cur_scale: Int = d.scale;
    if cur_scale >= target_scale {
        return d;
    }
    let zeros_to_add: Int = target_scale - cur_scale;
    let mut new_u: String = d.unscaled_str;
    let mut i: Int = 0;
    while i < zeros_to_add {
        new_u = new_u + "0";
        i = i + 1;
    }
    return BigDecimal {
        is_neg: d.is_neg,
        unscaled_str: new_u,
        scale: target_scale
    };
}

pub fn bigdec_add(a: BigDecimal, b: BigDecimal) -> BigDecimal {
    let sa: Int = a.scale;
    let sb: Int = b.scale;
    let mut max_s: Int = sa;
    if sb > max_s {
        max_s = sb;
    }

    let a_aligned: BigDecimal = bigdec_align_scale(a, max_s);
    let b_aligned: BigDecimal = bigdec_align_scale(b, max_s);

    let mut big_a: BigInt = bigint_from_str(a_aligned.unscaled_str);
    big_a.is_neg = a_aligned.is_neg;

    let mut big_b: BigInt = bigint_from_str(b_aligned.unscaled_str);
    big_b.is_neg = b_aligned.is_neg;

    let sum_big: BigInt = bigint_add(big_a, big_b);
    let res_neg: Bool = bigint_is_neg(sum_big);
    let res_abs: BigInt = bigint_abs(sum_big);

    return BigDecimal {
        is_neg: res_neg,
        unscaled_str: bigint_to_str(res_abs),
        scale: max_s
    };
}

pub fn bigdec_sub(a: BigDecimal, b: BigDecimal) -> BigDecimal {
    return bigdec_add(a, bigdec_neg(b));
}
