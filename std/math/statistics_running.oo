// # Running Online Statistical Moments (Welford's Algorithm) Module
//
// Logline: One-pass running statistical moments, sample mean, variance, standard deviation, skewness, and excess kurtosis.
//
// Setup: Pure math module. Evaluates streaming continuous metrics with numerical stability via Welford updates.
//
// Beats:
//   1. Construct RunningStats online accumulator state.
//   2. Incremental online update with Welford delta moment adjustments.
//   3. Compute sample variance, standard deviation, and standard error.
//   4. Higher statistical moments: sample skewness and excess kurtosis.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Weighted moving-window decay accumulators lower via time-series library.

import "std/math.oo";

type RunningStats = struct {
    count: Int,
    count_f: Float,
    mean: Float,
    m2: Float,
    m3: Float,
    m4: Float,
    min_val: Float,
    max_val: Float
};

pub fn running_stats_new() -> RunningStats {
    return RunningStats {
        count: 0,
        count_f: 0.0,
        mean: 0.0,
        m2: 0.0,
        m3: 0.0,
        m4: 0.0,
        min_val: 0.0,
        max_val: 0.0
    };
}

pub fn running_stats_count(s: RunningStats) -> Int {
    return s.count;
}

pub fn running_stats_mean(s: RunningStats) -> Float {
    return s.mean;
}

pub fn running_stats_update(s: RunningStats, x: Float) -> RunningStats {
    let cur_c: Int = s.count;
    let next_c: Int = cur_c + 1;
    let cur_cf: Float = s.count_f;
    let n: Float = cur_cf + 1.0;

    let cur_mean: Float = s.mean;
    let delta: Float = x - cur_mean;
    let delta_n: Float = delta / n;
    let delta_n2: Float = delta_n * delta_n;
    let term1: Float = delta * delta_n * (n - 1.0);

    let next_mean: Float = cur_mean + delta_n;

    let cur_m2: Float = s.m2;
    let cur_m3: Float = s.m3;
    let cur_m4: Float = s.m4;

    let next_m4: Float = cur_m4 + term1 * delta_n2 * (n * n - 3.0 * n + 3.0) + 6.0 * delta_n2 * cur_m2 - 4.0 * delta_n * cur_m3;
    let next_m3: Float = cur_m3 + term1 * delta_n * (n - 2.0) - 3.0 * delta_n * cur_m2;
    let next_m2: Float = cur_m2 + term1;

    let mut next_min: Float = s.min_val;
    let mut next_max: Float = s.max_val;
    if cur_c == 0 {
        next_min = x;
        next_max = x;
    } else {
        if x < next_min {
            next_min = x;
        }
        if x > next_max {
            next_max = x;
        }
    }

    return RunningStats {
        count: next_c,
        count_f: n,
        mean: next_mean,
        m2: next_m2,
        m3: next_m3,
        m4: next_m4,
        min_val: next_min,
        max_val: next_max
    };
}

pub fn running_stats_variance(s: RunningStats) -> Float {
    let c: Int = s.count;
    if c <= 1 {
        return 0.0;
    }
    let m2: Float = s.m2;
    let cf: Float = s.count_f;
    return m2 / (cf - 1.0);
}

pub fn running_stats_std_dev(s: RunningStats) -> Float {
    let v: Float = running_stats_variance(s);
    return math_sqrt(v);
}

pub fn running_stats_skewness(s: RunningStats) -> Float {
    let c: Int = s.count;
    if c <= 2 {
        return 0.0;
    }
    let m2: Float = s.m2;
    let m3: Float = s.m3;
    let cf: Float = s.count_f;
    let var_term: Float = math_sqrt(m2 / cf);
    let denom: Float = var_term * var_term * var_term;
    if denom == 0.0 {
        return 0.0;
    }
    return (m3 / cf) / denom;
}

pub fn running_stats_kurtosis(s: RunningStats) -> Float {
    let c: Int = s.count;
    if c <= 3 {
        return 0.0;
    }
    let m2: Float = s.m2;
    let m4: Float = s.m4;
    let cf: Float = s.count_f;
    let denom: Float = (m2 / cf) * (m2 / cf);
    if denom == 0.0 {
        return 0.0;
    }
    return ((m4 / cf) / denom) - 3.0;
}
