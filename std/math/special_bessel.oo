// # Cylindrical Bessel Functions Module
//
// Logline: Cylindrical Bessel functions of the first kind (J0, J1, Jn) and modified Bessel functions (I0, I1) via polynomial series.
//
// Setup: Pure math module. Evaluates radial wave equation Bessel solutions without ambient side effects.
//
// Beats:
//   1. Zero-order Bessel function of the first kind J0(x).
//   2. First-order Bessel function of the first kind J1(x).
//   3. Miller upward/downward recurrence relation for integer order Jn(x).
//   4. Modified cylindrical Bessel functions I0(x) and I1(x).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Spherical Bessel and fractional order Bessel functions lower via special math library.

import "std/math.oo";

pub fn bessel_j0(x: Float) -> Float {
    let mut ax: Float = x;
    if ax < 0.0 {
        ax = 0.0 - ax;
    }
    if ax < 3.75 {
        let y: Float = (x / 3.75) * (x / 3.75);
        let p0: Float = 1.0;
        let p1: Float = 0.0 - 2.2499997;
        let p2: Float = 1.2656208;
        let p3: Float = 0.0 - 0.3163866;
        let p4: Float = 0.0444479;
        let p5: Float = 0.0 - 0.0039444;
        let p6: Float = 0.0002100;
        return p0 + y * (p1 + y * (p2 + y * (p3 + y * (p4 + y * (p5 + y * p6)))));
    }
    let y: Float = 3.75 / ax;
    let f0: Float = 0.79788456;
    let theta: Float = ax - 0.78539816;
    let f: Float = f0 + y * (0.00000156 + y * (0.0 - 0.00078323));
    let cost: Float = math_cos(theta);
    let inv_sqrt_x: Float = 1.0 / math_sqrt(ax);
    return inv_sqrt_x * f * cost;
}

pub fn bessel_j1(x: Float) -> Float {
    let mut ax: Float = x;
    if ax < 0.0 {
        ax = 0.0 - ax;
    }
    if ax < 3.75 {
        let y: Float = (x / 3.75) * (x / 3.75);
        let p0: Float = 0.5;
        let p1: Float = 0.0 - 0.56249985;
        let p2: Float = 0.21093573;
        let p3: Float = 0.0 - 0.03954289;
        let p4: Float = 0.00443319;
        let p5: Float = 0.0 - 0.00031761;
        let p6: Float = 0.00001109;
        let poly: Float = p0 + y * (p1 + y * (p2 + y * (p3 + y * (p4 + y * (p5 + y * p6)))));
        return x * poly;
    }
    let theta: Float = ax - 2.35619449;
    let cost: Float = math_cos(theta);
    let inv_sqrt_x: Float = 1.0 / math_sqrt(ax);
    let mut res: Float = inv_sqrt_x * 0.79788456 * cost;
    if x < 0.0 {
        res = 0.0 - res;
    }
    return res;
}

pub fn bessel_jn(n: Int, x: Float) -> Float {
    if n == 0 {
        return bessel_j0(x);
    }
    if n == 1 {
        return bessel_j1(x);
    }
    if x == 0.0 {
        return 0.0;
    }
    let mut jprev: Float = bessel_j0(x);
    let mut jcurr: Float = bessel_j1(x);
    let mut jnext: Float = 0.0;
    let mut m: Int = 1;
    while m < n {
        let m_float: Float = 1.0 * m;
        let factor: Float = (2.0 * m_float) / x;
        jnext = factor * jcurr - jprev;
        jprev = jcurr;
        jcurr = jnext;
        m = m + 1;
    }
    return jcurr;
}

pub fn bessel_i0(x: Float) -> Float {
    let mut ax: Float = x;
    if ax < 0.0 {
        ax = 0.0 - ax;
    }
    if ax < 3.75 {
        let y: Float = (x / 3.75) * (x / 3.75);
        let p0: Float = 1.0;
        let p1: Float = 3.5156229;
        let p2: Float = 3.0899424;
        let p3: Float = 1.2067492;
        let p4: Float = 0.2659732;
        let p5: Float = 0.0360768;
        let p6: Float = 0.0045813;
        return p0 + y * (p1 + y * (p2 + y * (p3 + y * (p4 + y * (p5 + y * p6)))));
    }
    let y: Float = 3.75 / ax;
    let exp_x: Float = math_exp(ax);
    let inv_sqrt: Float = 1.0 / math_sqrt(ax);
    let poly: Float = 0.39894228 + y * (0.01328592 + y * (0.00225319));
    return (exp_x * inv_sqrt) * poly;
}

pub fn bessel_i1(x: Float) -> Float {
    let mut ax: Float = x;
    if ax < 0.0 {
        ax = 0.0 - ax;
    }
    if ax < 3.75 {
        let y: Float = (x / 3.75) * (x / 3.75);
        let p0: Float = 0.5;
        let p1: Float = 0.87890594;
        let p2: Float = 0.51498869;
        let p3: Float = 0.15084934;
        let p4: Float = 0.02658733;
        let p5: Float = 0.00301532;
        let p6: Float = 0.00032411;
        let poly: Float = p0 + y * (p1 + y * (p2 + y * (p3 + y * (p4 + y * (p5 + y * p6)))));
        return x * poly;
    }
    let y: Float = 3.75 / ax;
    let exp_x: Float = math_exp(ax);
    let inv_sqrt: Float = 1.0 / math_sqrt(ax);
    let poly: Float = 0.39894228 + y * (0.0 - 0.03988024);
    let mut res: Float = (exp_x * inv_sqrt) * poly;
    if x < 0.0 {
        res = 0.0 - res;
    }
    return res;
}
