// # LU Matrix Factorization and Linear Solver Module
//
// Logline: LU Matrix Factorization with partial pivoting (PA = LU), forward/back substitution linear solver, determinant, and matrix inversion.
//
// Setup: Pure math module. Decomposes square row-major matrices into lower (L) and upper (U) triangular factors with permutation vector (P).
//
// Beats:
//   1. Construct LuDecomp data structure with L, U, permutation indices, and singularity status.
//   2. Factorize general square matrix A into P * A = L * U with partial row pivoting.
//   3. Solve linear system A * x = b via forward substitution (L * y = P * b) and back substitution (U * x = y).
//   4. Compute matrix determinant and compute general matrix inverse.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Banded and sparse LU decompositions lower to specialized sparse solvers via backend runtime.

import "std/result.oo";
import "std/math/matrix.oo";
import "std/math/blas_level2.oo";

type LuDecomp = struct {
    l: Matrix,
    u: Matrix,
    piv: List[Int],
    swaps: Int,
    is_singular: Bool
};

// Factorize square matrix m into PA = LU with partial pivoting.
pub fn matrix_lu(m: Matrix) -> LuDecomp {
    let n: Int = matrix_rows(m);
    let mut a: Matrix = m;
    let mut l: Matrix = matrix_identity(n);
    let mut piv: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        piv = list_push(piv, i);
        i = i + 1;
    }
    let mut num_swaps: Int = 0;
    let mut is_sing: Bool = false;

    let mut k: Int = 0;
    while k < n {
        // Find pivot
        let mut max_row: Int = k;
        let mut v_init: Float = matrix_get(a, k, k);
        if v_init < 0.0 { v_init = 0.0 - v_init; }
        let mut max_v: Float = v_init;
        let mut r: Int = k + 1;
        while r < n {
            let mut v: Float = matrix_get(a, r, k);
            if v < 0.0 { v = 0.0 - v; }
            if v > max_v {
                max_v = v;
                max_row = r;
            }
            r = r + 1;
        }

        if max_v == 0.0 {
            is_sing = true;
        }

        if max_row != k {
            num_swaps = num_swaps + 1;
            // Swap rows in a
            let mut col_idx: Int = 0;
            while col_idx < n {
                let v1: Float = matrix_get(a, k, col_idx);
                let v2: Float = matrix_get(a, max_row, col_idx);
                a = matrix_set(a, k, col_idx, v2);
                a = matrix_set(a, max_row, col_idx, v1);
                col_idx = col_idx + 1;
            }
            // Swap rows in l for columns < k
            let mut l_col: Int = 0;
            while l_col < k {
                let lv1: Float = matrix_get(l, k, l_col);
                let lv2: Float = matrix_get(l, max_row, l_col);
                l = matrix_set(l, k, l_col, lv2);
                l = matrix_set(l, max_row, l_col, lv1);
                l_col = l_col + 1;
            }
            // Swap piv elements
            let pk: Int = list_get(piv, k);
            let pm: Int = list_get(piv, max_row);
            let mut new_piv: List[Int] = list_new();
            let mut p_idx: Int = 0;
            while p_idx < n {
                if p_idx == k {
                    new_piv = list_push(new_piv, pm);
                } else if p_idx == max_row {
                    new_piv = list_push(new_piv, pk);
                } else {
                    new_piv = list_push(new_piv, list_get(piv, p_idx));
                }
                p_idx = p_idx + 1;
            }
            piv = new_piv;
        }

        let diag_val: Float = matrix_get(a, k, k);
        if diag_val != 0.0 {
            let mut row_i: Int = k + 1;
            while row_i < n {
                let factor: Float = matrix_get(a, row_i, k) / diag_val;
                l = matrix_set(l, row_i, k, factor);
                let mut col_j: Int = k;
                while col_j < n {
                    let cur_a: Float = matrix_get(a, row_i, col_j);
                    let pivot_a: Float = matrix_get(a, k, col_j);
                    a = matrix_set(a, row_i, col_j, cur_a - factor * pivot_a);
                    col_j = col_j + 1;
                }
                row_i = row_i + 1;
            }
        }

        k = k + 1;
    }

    // Extract U from upper triangle of A
    let mut u: Matrix = matrix_zeros(n, n);
    let mut ur: Int = 0;
    while ur < n {
        let mut uc: Int = ur;
        while uc < n {
            let uv: Float = matrix_get(a, ur, uc);
            u = matrix_set(u, ur, uc, uv);
            uc = uc + 1;
        }
        ur = ur + 1;
    }

    return LuDecomp {
        l: l,
        u: u,
        piv: piv,
        swaps: num_swaps,
        is_singular: is_sing
    };
}

// Solve linear system A * x = b via LU factorization.
pub fn lu_solve(lu: LuDecomp, b: List[Float]) -> Result[List[Float], String] {
    if lu.is_singular {
        return Err("E_LU_SINGULAR: cannot solve singular system");
    }
    let n: Int = matrix_rows(lu.l);
    // Apply permutation vector: pb = P * b
    let mut pb: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let p_idx: Int = list_get(lu.piv, i);
        let bv: Float = list_get(b, p_idx);
        pb = list_push(pb, bv);
        i = i + 1;
    }
    // Forward substitution: L * y = pb
    let y: List[Float] = blas_trsv_lower(lu.l, pb);
    // Back substitution: U * x = y
    let x: List[Float] = blas_trsv_upper(lu.u, y);
    return Ok(x);
}

// Calculate determinant of matrix from LU factorization.
pub fn lu_det(lu: LuDecomp) -> Float {
    if lu.is_singular {
        return 0.0;
    }
    let n: Int = matrix_rows(lu.u);
    let mut det: Float = 1.0;
    let mut i: Int = 0;
    while i < n {
        let diag: Float = matrix_get(lu.u, i, i);
        det = det * diag;
        i = i + 1;
    }
    if lu.swaps % 2 != 0 {
        det = 0.0 - det;
    }
    return det;
}

// Invert square matrix via LU factorization.
pub fn lu_inverse(lu: LuDecomp) -> Result[Matrix, String] {
    if lu.is_singular {
        return Err("E_LU_SINGULAR: cannot invert singular matrix");
    }
    let n: Int = matrix_rows(lu.l);
    let mut inv_m: Matrix = matrix_zeros(n, n);
    let mut col: Int = 0;
    while col < n {
        let mut e: List[Float] = list_new();
        let mut row_idx: Int = 0;
        while row_idx < n {
            if row_idx == col {
                e = list_push(e, 1.0);
            } else {
                e = list_push(e, 0.0);
            }
            row_idx = row_idx + 1;
        }
        let solve_res: Result[List[Float], String] = lu_solve(lu, e);
        if solve_res.is_err() {
            return Err("E_LU_SOLVE_FAILED: inverse column solve failed");
        }
        let col_vec: List[Float] = match solve_res {
            Ok(v) => v,
            Err(e) => e,
        };
        let mut r: Int = 0;
        while r < n {
            let val: Float = list_get(col_vec, r);
            inv_m = matrix_set(inv_m, r, col, val);
            r = r + 1;
        }
        col = col + 1;
    }
    return Ok(inv_m);
}
