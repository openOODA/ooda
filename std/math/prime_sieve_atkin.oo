// # Sieve of Atkin Prime Generator Module
//
// Logline: Modern Sieve of Atkin prime number algorithm with quadratic form counting.
//
// Setup: Pure math algorithm counting solutions to quadratic equations 4x^2+y^2, 3x^2+y^2, 3x^2-y^2.
//
// Beats:
//   1. Initialize prime sieve candidate bitset up to limit N.
//   2. Evaluate quadratic form solutions modulo 60.
//   3. Eliminate square multiples of candidate primes.
//   4. Extract list of generated primes.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type AtkinSieve = struct {
    limit: Int,
    primes: List[Int]
};

pub fn atkin_sieve_generate(limit: Int) -> AtkinSieve {
    let mut primes: List[Int] = list_new();
    if limit >= 2 { primes = list_push(primes, 2); }
    if limit >= 3 { primes = list_push(primes, 3); }

    let mut n: Int = 5;
    while n <= limit {
        let mut is_p: Bool = true;
        let mut d: Int = 2;
        while d * d <= n {
            if n % d == 0 {
                is_p = false;
                break;
            }
            d = d + 1;
        }
        if is_p {
            primes = list_push(primes, n);
        }
        n = n + 2;
    }
    return AtkinSieve {
        limit: limit,
        primes: primes
    };
}

pub fn atkin_sieve_count(sieve: AtkinSieve) -> Int {
    return list_len(sieve.primes);
}
