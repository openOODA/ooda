// # BLAS Level 1 Vector Linear Algebra Module
//
// Logline: BLAS Level 1 vector-vector linear algebra routines (dot product, axpy, norm2, absolute sum, scale, copy, and argmax).
//
// Setup: Pure math module. Implements standard BLAS-1 operations over continuous flat List[Float] vectors.
//
// Beats:
//   1. Vector dot product (blas_dot) and fused multiply-accumulate vector addition (blas_axpy).
//   2. Scalar scaling (blas_scal), vector copy (blas_copy), and vector cloning.
//   3. Euclidean 2-norm (blas_nrm2) and 1-norm absolute sum (blas_asum).
//   4. Index of maximum absolute value (blas_iamax) and vector bounds.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware SIMD vectorization lowers to AVX2/NEON routines via compiler backend.

// Dot product of two vectors: sum(x[i] * y[i]).
pub fn blas_dot(x: List[Float], y: List[Float]) -> Float {
    let nx: Int = list_len(x);
    let ny: Int = list_len(y);
    let mut n: Int = nx;
    if ny < n {
        n = ny;
    }
    let mut acc: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let vx: Float = list_get(x, i);
        let vy: Float = list_get(y, i);
        acc = acc + vx * vy;
        i = i + 1;
    }
    return acc;
}

// AXPY: y = alpha * x + y.
pub fn blas_axpy(alpha: Float, x: List[Float], y: List[Float]) -> List[Float] {
    let nx: Int = list_len(x);
    let ny: Int = list_len(y);
    let mut n: Int = nx;
    if ny < n {
        n = ny;
    }
    let mut res: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let vx: Float = list_get(x, i);
        let vy: Float = list_get(y, i);
        res = list_push(res, alpha * vx + vy);
        i = i + 1;
    }
    return res;
}

// SCAL: res = alpha * x.
pub fn blas_scal(alpha: Float, x: List[Float]) -> List[Float] {
    let n: Int = list_len(x);
    let mut res: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let vx: Float = list_get(x, i);
        res = list_push(res, vx * alpha);
        i = i + 1;
    }
    return res;
}

// NRM2: Euclidean 2-norm: sqrt(sum(x[i]^2)).
pub fn blas_nrm2(x: List[Float]) -> Float {
    let sq: Float = blas_dot(x, x);
    return sqrt(sq);
}

// ASUM: Sum of absolute values: sum(|x[i]|).
pub fn blas_asum(x: List[Float]) -> Float {
    let n: Int = list_len(x);
    let mut acc: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let vx: Float = list_get(x, i);
        let mut abs_v: Float = vx;
        if abs_v < 0.0 {
            abs_v = 0.0 - abs_v;
        }
        acc = acc + abs_v;
        i = i + 1;
    }
    return acc;
}

// IAMAX: Index of maximum absolute value (0-based).
pub fn blas_iamax(x: List[Float]) -> Int {
    let n: Int = list_len(x);
    if n == 0 {
        return 0;
    }
    let mut max_idx: Int = 0;
    let mut v0: Float = list_get(x, 0);
    if v0 < 0.0 {
        v0 = 0.0 - v0;
    }
    let mut max_val: Float = v0;
    let mut i: Int = 1;
    while i < n {
        let vx: Float = list_get(x, i);
        let mut abs_v: Float = vx;
        if abs_v < 0.0 {
            abs_v = 0.0 - abs_v;
        }
        if abs_v > max_val {
            max_val = abs_v;
            max_idx = i;
        }
        i = i + 1;
    }
    return max_idx;
}

// COPY: Copy vector x into a new list.
pub fn blas_copy(x: List[Float]) -> List[Float] {
    let n: Int = list_len(x);
    let mut res: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let vx: Float = list_get(x, i);
        res = list_push(res, vx);
        i = i + 1;
    }
    return res;
}
