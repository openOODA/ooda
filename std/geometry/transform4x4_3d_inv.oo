// # 4x4 analytic inverse
//
// Logline: Inverts a 4x4 matrix via the adjugate and determinant and fails closed when the matrix is singular.
//
// Setup: Pure. |det| <= 1e-7 yields Err singular matrix: det is 0. Column-major 16 Floats.
//
// Beats:
//   1. Compute each 3x3 minor determinant.
//   2. Assemble the cofactor transpose as the adjugate.
//   3. Divide by det when |det| is above 1e-7.
//   4. Return Result[Int, String] status plus the inverse list.

import "std/geometry/transform4x4_3d.oo";

fn tf_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

fn tf_det3(a: Float, b: Float, c: Float, d: Float, e: Float, f: Float, g: Float, h: Float, i: Float) -> Float {
    return a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g);
}

fn tf_minor(m: List[Float], rr: Int, cc: Int) -> Float {
    let mut vals: List[Float] = list_new();
    let mut r: Int = 0;
    while r < 4 {
        if r != rr {
            let mut c: Int = 0;
            while c < 4 {
                if c != cc {
                    vals = list_push(vals, transform4x4_get(m, r, c));
                }
                c = c + 1;
            }
        }
        r = r + 1;
    }
    return tf_det3(
        list_get(vals, 0),
        list_get(vals, 1),
        list_get(vals, 2),
        list_get(vals, 3),
        list_get(vals, 4),
        list_get(vals, 5),
        list_get(vals, 6),
        list_get(vals, 7),
        list_get(vals, 8)
    );
}

pub fn transform4x4_det(m: List[Float]) -> Float {
    let mut s: Float = 0.0;
    let mut c: Int = 0;
    while c < 4 {
        let cof: Float = tf_minor(m, 0, c);
        let mut cofs: Float = cof;
        if (c & 1) == 1 {
            cofs = 0.0 - cof;
        }
        s = s + transform4x4_get(m, 0, c) * cofs;
        c = c + 1;
    }
    return s;
}

fn tf_adjugate(m: List[Float]) -> List[Float] {
    let mut o: List[Float] = list_new();
    let mut c: Int = 0;
    while c < 4 {
        let mut r: Int = 0;
        while r < 4 {
            let cof: Float = tf_minor(m, c, r);
            let mut cofs: Float = cof;
            if ((r + c) & 1) == 1 {
                cofs = 0.0 - cof;
            }
            o = list_push(o, cofs);
            r = r + 1;
        }
        c = c + 1;
    }
    return o;
}

pub fn transform4x4_inverse(m: List[Float]) -> List[Float] {
    let d: Float = transform4x4_det(m);
    if tf_abs(d) <= 0.0000001 {
        return list_new();
    }
    let adj: List[Float] = tf_adjugate(m);
    let mut o: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        o = list_push(o, list_get(adj, i) / d);
        i = i + 1;
    }
    return o;
}

pub fn transform4x4_invert(m: List[Float]) -> Result[Int, String] {
    if list_len(m) != 16 {
        return Err("singular matrix: det is 0");
    }
    let d: Float = transform4x4_det(m);
    if tf_abs(d) <= 0.0000001 {
        return Err("singular matrix: det is 0");
    }
    return Ok(1);
}
