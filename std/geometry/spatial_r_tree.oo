// # R-tree bounding-box index
//
// Logline: Inserts 2D boxes into an R-tree and answers overlap and nearest-neighbor queries.
//
// Setup: Pure. Items pack as xmin,ymin,xmax,ymax. One leaf holds at most 8 boxes.
//
// Beats:
//   1. Pack boxes as xmin,ymin,xmax,ymax after a six-float header.
//   2. Copy the tree, then enlarge the root box to cover an insert.
//   3. Query overlap by walking packed boxes.
//   4. Query nearest by center distance. Choose the least area growth.

fn rt_area(x0: Float, y0: Float, x1: Float, y1: Float) -> Float {
    return (x1 - x0) * (y1 - y0);
}

fn rt_n(tree: List[Float]) -> Int {
    let x: Float = list_get(tree, 5);
    if x < 0.5 { return 0; }
    if x < 1.5 { return 1; }
    if x < 2.5 { return 2; }
    if x < 3.5 { return 3; }
    if x < 4.5 { return 4; }
    if x < 5.5 { return 5; }
    if x < 6.5 { return 6; }
    if x < 7.5 { return 7; }
    return 8;
}

fn rt_ov(ax0: Float, ay0: Float, ax1: Float, ay1: Float, bx0: Float, by0: Float, bx1: Float, by1: Float) -> Bool {
    if ax1 < bx0 { return false; }
    if bx1 < ax0 { return false; }
    if ay1 < by0 { return false; }
    if by1 < ay0 { return false; }
    return true;
}

fn rt_copy(tree: List[Float]) -> List[Float] {
    let mut o: List[Float] = list_new();
    let mut i: Int = 0;
    while i < list_len(tree) {
        o = list_push(o, list_get(tree, i));
        i = i + 1;
    }
    return o;
}

pub fn spatial_r_tree_new() -> List[Float] {
    let mut t: List[Float] = list_new();
    t = list_push(t, 0.0);
    t = list_push(t, 0.0);
    t = list_push(t, 0.0);
    t = list_push(t, 0.0);
    t = list_push(t, 1.0);
    t = list_push(t, 0.0);
    return t;
}

pub fn spatial_r_tree_insert(tree: List[Float], x0: Float, y0: Float, x1: Float, y1: Float) -> Result[List[Float], String] {
    if x1 < x0 { return Err("rtree box"); }
    if y1 < y0 { return Err("rtree box"); }
    let mut o: List[Float] = rt_copy(tree);
    let n: Int = rt_n(o);
    if n >= 8 {
        return Err("rtree full leaf");
    }
    if n < 1 {
        o = list_set(o, 0, x0);
        o = list_set(o, 1, y0);
        o = list_set(o, 2, x1);
        o = list_set(o, 3, y1);
    } else {
        if x0 < list_get(o, 0) { o = list_set(o, 0, x0); }
        if y0 < list_get(o, 1) { o = list_set(o, 1, y0); }
        if x1 > list_get(o, 2) { o = list_set(o, 2, x1); }
        if y1 > list_get(o, 3) { o = list_set(o, 3, y1); }
    }
    o = list_push(o, x0);
    o = list_push(o, y0);
    o = list_push(o, x1);
    o = list_push(o, y1);
    o = list_set(o, 5, list_get(o, 5) + 1.0);
    return Ok(o);
}

pub fn spatial_r_tree_overlap(tree: List[Float], x0: Float, y0: Float, x1: Float, y1: Float) -> Result[Int, String] {
    if list_len(tree) < 6 { return Err("rtree empty"); }
    let n: Int = rt_n(tree);
    let mut i: Int = 0;
    while i < n {
        let b: Int = 6 + i * 4;
        let bx0: Float = list_get(tree, b);
        let by0: Float = list_get(tree, b + 1);
        let bx1: Float = list_get(tree, b + 2);
        let by1: Float = list_get(tree, b + 3);
        if rt_ov(x0, y0, x1, y1, bx0, by0, bx1, by1) {
            return Ok(i);
        }
        i = i + 1;
    }
    return Err("rtree no overlap");
}

pub fn spatial_r_tree_nearest(tree: List[Float], x: Float, y: Float) -> Result[Int, String] {
    if list_len(tree) < 6 { return Err("rtree empty"); }
    let n: Int = rt_n(tree);
    if n < 1 { return Err("rtree empty"); }
    let mut best: Int = 0;
    let mut bd: Float = 1000000000.0;
    let mut i: Int = 0;
    while i < n {
        let b: Int = 6 + i * 4;
        let cx: Float = 0.5 * (list_get(tree, b) + list_get(tree, b + 2));
        let cy: Float = 0.5 * (list_get(tree, b + 1) + list_get(tree, b + 3));
        let dx: Float = cx - x;
        let dy: Float = cy - y;
        let d: Float = dx * dx + dy * dy;
        if d < bd {
            bd = d;
            best = i;
        }
        i = i + 1;
    }
    return Ok(best);
}

pub fn spatial_r_tree_choose(tree: List[Float], x0: Float, y0: Float, x1: Float, y1: Float) -> Result[Int, String] {
    if list_len(tree) < 6 { return Err("rtree empty"); }
    let n: Int = rt_n(tree);
    if n < 1 { return Err("rtree empty"); }
    let mut best: Int = 0;
    let mut bg: Float = 1000000000.0;
    let mut i: Int = 0;
    while i < n {
        let b: Int = 6 + i * 4;
        let ax0: Float = list_get(tree, b);
        let ay0: Float = list_get(tree, b + 1);
        let ax1: Float = list_get(tree, b + 2);
        let ay1: Float = list_get(tree, b + 3);
        let a0: Float = rt_area(ax0, ay0, ax1, ay1);
        let mut nx0: Float = ax0;
        let mut ny0: Float = ay0;
        let mut nx1: Float = ax1;
        let mut ny1: Float = ay1;
        if x0 < nx0 { nx0 = x0; }
        if y0 < ny0 { ny0 = y0; }
        if x1 > nx1 { nx1 = x1; }
        if y1 > ny1 { ny1 = y1; }
        let g: Float = rt_area(nx0, ny0, nx1, ny1) - a0;
        if g < bg {
            bg = g;
            best = i;
        }
        i = i + 1;
    }
    return Ok(best);
}
