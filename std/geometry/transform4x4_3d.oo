// # 4x4 homogeneous transforms
//
// Logline: Builds translation, axis-angle rotation, non-uniform scale, and perspective 4x4 matrices and multiplies them.
//
// Setup: Pure. Matrices are 16 Floats, column-major. Angles are radians.
//
// Beats:
//   1. Write identity, translate, and non-uniform scale.
//   2. Write Rodrigues axis-angle rotation into the upper 3x3.
//   3. Write a perspective projection matrix.
//   4. Multiply two 4x4 matrices.

pub fn transform4x4_ident() -> List[Float] {
    let mut m: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        let mut v: Float = 0.0;
        if i % 5 == 0 {
            v = 1.0;
        }
        m = list_push(m, v);
        i = i + 1;
    }
    return m;
}

pub fn transform4x4_translate(x: Float, y: Float, z: Float) -> List[Float] {
    let mut m: List[Float] = transform4x4_ident();
    let mut o: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        if i == 12 {
            o = list_push(o, x);
        } else {
            if i == 13 {
                o = list_push(o, y);
            } else {
                if i == 14 {
                    o = list_push(o, z);
                } else {
                    o = list_push(o, list_get(m, i));
                }
            }
        }
        i = i + 1;
    }
    return o;
}

pub fn transform4x4_scale(x: Float, y: Float, z: Float) -> List[Float] {
    let mut o: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        let mut v: Float = 0.0;
        if i == 0 {
            v = x;
        }
        if i == 5 {
            v = y;
        }
        if i == 10 {
            v = z;
        }
        if i == 15 {
            v = 1.0;
        }
        o = list_push(o, v);
        i = i + 1;
    }
    return o;
}

fn tf_put(m: List[Float], idx: Int, v: Float) -> List[Float] {
    let mut o: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        if i == idx {
            o = list_push(o, v);
        } else {
            o = list_push(o, list_get(m, i));
        }
        i = i + 1;
    }
    return o;
}

pub fn transform4x4_rotate_axis(ax: Float, ay: Float, az: Float, rad: Float) -> List[Float] {
    let len2: Float = ax * ax + ay * ay + az * az;
    if len2 <= 0.000000000000001 {
        return transform4x4_ident();
    }
    let len: Float = sqrt(len2);
    let ux: Float = ax / len;
    let uy: Float = ay / len;
    let uz: Float = az / len;
    let c: Float = cos(rad);
    let s: Float = sin(rad);
    let t: Float = 1.0 - c;
    let mut m: List[Float] = transform4x4_ident();
    m = tf_put(m, 0, c + ux * ux * t);
    m = tf_put(m, 1, uy * ux * t + uz * s);
    m = tf_put(m, 2, uz * ux * t - uy * s);
    m = tf_put(m, 4, ux * uy * t - uz * s);
    m = tf_put(m, 5, c + uy * uy * t);
    m = tf_put(m, 6, uz * uy * t + ux * s);
    m = tf_put(m, 8, ux * uz * t + uy * s);
    m = tf_put(m, 9, uy * uz * t - ux * s);
    m = tf_put(m, 10, c + uz * uz * t);
    return m;
}

pub fn transform4x4_perspective(fovy: Float, aspect: Float, znear: Float, zfar: Float) -> List[Float] {
    let mut m: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        m = list_push(m, 0.0);
        i = i + 1;
    }
    if znear <= 0.0 {
        return m;
    }
    if zfar <= znear {
        return m;
    }
    let half: Float = fovy * 0.5;
    let tn: Float = sin(half) / cos(half);
    m = tf_put(m, 0, 1.0 / (aspect * tn));
    m = tf_put(m, 5, 1.0 / tn);
    m = tf_put(m, 10, 0.0 - (zfar + znear) / (zfar - znear));
    m = tf_put(m, 11, 0.0 - 1.0);
    m = tf_put(m, 14, 0.0 - 2.0 * zfar * znear / (zfar - znear));
    return m;
}

pub fn transform4x4_mul(a: List[Float], b: List[Float]) -> List[Float] {
    let mut o: List[Float] = list_new();
    let mut c: Int = 0;
    while c < 4 {
        let mut r: Int = 0;
        while r < 4 {
            let mut s: Float = 0.0;
            let mut k: Int = 0;
            while k < 4 {
                s = s + list_get(a, r + k * 4) * list_get(b, k + c * 4);
                k = k + 1;
            }
            o = list_push(o, s);
            r = r + 1;
        }
        c = c + 1;
    }
    return o;
}

pub fn transform4x4_get(m: List[Float], r: Int, c: Int) -> Float { return list_get(m, r + c * 4); }
