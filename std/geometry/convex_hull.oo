// # Monotone-chain convex hull
//
// Logline: Builds the 2D convex hull of a point set and computes the polygon area with the shoelace formula.
//
// Setup: Pure. Points pack as x,y Float pairs. Need at least 3 points.
//
// Beats:
//   1. Sort points by x then y.
//   2. Build the lower chain with a right-turn test.
//   3. Build the upper chain the same way.
//   4. Close the hull and compute a positive area.

fn ch_x(p: List[Float], i: Int) -> Float { return list_get(p, i * 2); }
fn ch_y(p: List[Float], i: Int) -> Float { return list_get(p, i * 2 + 1); }

fn ch_cross(px: Float, py: Float, qx: Float, qy: Float, rx: Float, ry: Float) -> Float {
    return (qx - px) * (ry - py) - (qy - py) * (rx - px);
}

fn ch_sort(p: List[Float]) -> List[Float] {
    let n: Int = list_len(p) / 2;
    let mut o: List[Float] = list_new();
    let mut c: Int = 0;
    while c < list_len(p) {
        o = list_push(o, list_get(p, c));
        c = c + 1;
    }
    let mut i: Int = 0;
    while i < n {
        let mut j: Int = i + 1;
        while j < n {
            let xi: Float = ch_x(o, i);
            let xj: Float = ch_x(o, j);
            if xj < xi {
                let tx: Float = xi;
                let ty: Float = ch_y(o, i);
                o = list_set(o, i * 2, xj);
                o = list_set(o, i * 2 + 1, ch_y(o, j));
                o = list_set(o, j * 2, tx);
                o = list_set(o, j * 2 + 1, ty);
            } else {
                if xj == xi {
                    if ch_y(o, j) < ch_y(o, i) {
                        let ty: Float = ch_y(o, i);
                        o = list_set(o, i * 2 + 1, ch_y(o, j));
                        o = list_set(o, j * 2 + 1, ty);
                    }
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return o;
}

pub fn convex_hull_build(pts: List[Float]) -> Result[List[Float], String] {
    if list_len(pts) < 6 { return Err("hull few points"); }
    if list_len(pts) % 2 != 0 { return Err("hull xy"); }
    let s: List[Float] = ch_sort(pts);
    let n: Int = list_len(s) / 2;
    let mut lower: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        while list_len(lower) >= 2 {
            let a: Int = list_get(lower, list_len(lower) - 2);
            let b: Int = list_get(lower, list_len(lower) - 1);
            if ch_cross(ch_x(s, a), ch_y(s, a), ch_x(s, b), ch_y(s, b), ch_x(s, i), ch_y(s, i)) <= 0.0 {
                let mut nl: List[Int] = list_new();
                let mut k: Int = 0;
                while k < list_len(lower) - 1 {
                    nl = list_push(nl, list_get(lower, k));
                    k = k + 1;
                }
                lower = nl;
            } else {
                break;
            }
        }
        lower = list_push(lower, i);
        i = i + 1;
    }
    let mut upper: List[Int] = list_new();
    i = n - 1;
    while i >= 0 {
        while list_len(upper) >= 2 {
            let a2: Int = list_get(upper, list_len(upper) - 2);
            let b2: Int = list_get(upper, list_len(upper) - 1);
            if ch_cross(ch_x(s, a2), ch_y(s, a2), ch_x(s, b2), ch_y(s, b2), ch_x(s, i), ch_y(s, i)) <= 0.0 {
                let mut nu: List[Int] = list_new();
                let mut k2: Int = 0;
                while k2 < list_len(upper) - 1 {
                    nu = list_push(nu, list_get(upper, k2));
                    k2 = k2 + 1;
                }
                upper = nu;
            } else {
                break;
            }
        }
        upper = list_push(upper, i);
        i = i - 1;
    }
    let mut hull: List[Float] = list_new();
    i = 0;
    while i < list_len(lower) - 1 {
        let pi: Int = list_get(lower, i);
        hull = list_push(hull, ch_x(s, pi));
        hull = list_push(hull, ch_y(s, pi));
        i = i + 1;
    }
    i = 0;
    while i < list_len(upper) - 1 {
        let qi: Int = list_get(upper, i);
        hull = list_push(hull, ch_x(s, qi));
        hull = list_push(hull, ch_y(s, qi));
        i = i + 1;
    }
    if list_len(hull) < 6 { return Err("hull degenerate"); }
    return Ok(hull);
}

pub fn convex_hull_area(hull: List[Float]) -> Result[Float, String] {
    if list_len(hull) < 6 { return Err("hull area"); }
    let n: Int = list_len(hull) / 2;
    let mut a: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let j: Int = (i + 1) % n;
        a = a + list_get(hull, i * 2) * list_get(hull, j * 2 + 1);
        a = a - list_get(hull, j * 2) * list_get(hull, i * 2 + 1);
        i = i + 1;
    }
    if a < 0.0 { a = 0.0 - a; }
    return Ok(a * 0.5);
}
