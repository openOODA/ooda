// # 4x4 transform matrices
//
// Logline: Builds translation, Euler and quaternion rotation, scale, look_at, and perspective 4x4 matrices and inverts an affine transform.
//
// Setup: Pure. Matrices are 16 Floats, column-major. Angles are radians.
//
// Beats:
//   1. Write identity, translate, scale, and rotate.
//   2. Multiply two 4x4 matrices.
//   3. Build look_at and perspective.
//   4. Invert an affine matrix so T then T inverse recovers a point.

pub fn mat4_transform_ident() -> List[Float] {
    let mut m: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        let mut v: Float = 0.0;
        if i % 5 == 0 { v = 1.0; }
        m = list_push(m, v);
        i = i + 1;
    }
    return m;
}

pub fn mat4_transform_mul(a: List[Float], b: List[Float]) -> Result[List[Float], String] {
    if list_len(a) != 16 { return Err("mat4"); }
    if list_len(b) != 16 { return Err("mat4"); }
    let mut o: List[Float] = list_new();
    let mut c: Int = 0;
    while c < 4 {
        let mut r: Int = 0;
        while r < 4 {
            let mut s: Float = 0.0;
            let mut k: Int = 0;
            while k < 4 {
                s = s + list_get(a, r + k * 4) * list_get(b, k + c * 4);
                k = k + 1;
            }
            o = list_push(o, s);
            r = r + 1;
        }
        c = c + 1;
    }
    return Ok(o);
}

pub fn mat4_transform_translate(x: Float, y: Float, z: Float) -> List[Float] {
    let mut m: List[Float] = mat4_transform_ident();
    m = list_set(m, 12, x);
    m = list_set(m, 13, y);
    m = list_set(m, 14, z);
    return m;
}

pub fn mat4_transform_scale(x: Float, y: Float, z: Float) -> List[Float] {
    let mut m: List[Float] = mat4_transform_ident();
    m = list_set(m, 0, x);
    m = list_set(m, 5, y);
    m = list_set(m, 10, z);
    return m;
}

pub fn mat4_transform_rotate_z(rad: Float) -> List[Float] {
    let mut m: List[Float] = mat4_transform_ident();
    let c: Float = cos(rad);
    let s: Float = sin(rad);
    m = list_set(m, 0, c);
    m = list_set(m, 1, s);
    m = list_set(m, 4, 0.0 - s);
    m = list_set(m, 5, c);
    return m;
}

pub fn mat4_transform_quat(x: Float, y: Float, z: Float, w: Float) -> List[Float] {
    let mut m: List[Float] = mat4_transform_ident();
    let xx: Float = x * x;
    let yy: Float = y * y;
    let zz: Float = z * z;
    m = list_set(m, 0, 1.0 - 2.0 * (yy + zz));
    m = list_set(m, 1, 2.0 * (x * y + z * w));
    m = list_set(m, 2, 2.0 * (x * z - y * w));
    m = list_set(m, 4, 2.0 * (x * y - z * w));
    m = list_set(m, 5, 1.0 - 2.0 * (xx + zz));
    m = list_set(m, 6, 2.0 * (y * z + x * w));
    m = list_set(m, 8, 2.0 * (x * z + y * w));
    m = list_set(m, 9, 2.0 * (y * z - x * w));
    m = list_set(m, 10, 1.0 - 2.0 * (xx + yy));
    return m;
}

fn m3_cross(ax: Float, ay: Float, az: Float, bx: Float, by: Float, bz: Float, i: Int) -> Float {
    if i == 0 { return ay * bz - az * by; }
    if i == 1 { return az * bx - ax * bz; }
    return ax * by - ay * bx;
}

pub fn mat4_transform_look_at(ex: Float, ey: Float, ez: Float, cx: Float, cy: Float, cz: Float, ux: Float, uy: Float, uz: Float) -> List[Float] {
    let fx: Float = cx - ex;
    let fy: Float = cy - ey;
    let fz: Float = cz - ez;
    let fl: Float = sqrt(fx * fx + fy * fy + fz * fz);
    let f0: Float = fx / fl;
    let f1: Float = fy / fl;
    let f2: Float = fz / fl;
    let sx: Float = m3_cross(f0, f1, f2, ux, uy, uz, 0);
    let sy: Float = m3_cross(f0, f1, f2, ux, uy, uz, 1);
    let sz: Float = m3_cross(f0, f1, f2, ux, uy, uz, 2);
    let sl: Float = sqrt(sx * sx + sy * sy + sz * sz);
    let s0: Float = sx / sl;
    let s1: Float = sy / sl;
    let s2: Float = sz / sl;
    let u0: Float = m3_cross(s0, s1, s2, f0, f1, f2, 0);
    let u1: Float = m3_cross(s0, s1, s2, f0, f1, f2, 1);
    let u2: Float = m3_cross(s0, s1, s2, f0, f1, f2, 2);
    let mut m: List[Float] = mat4_transform_ident();
    m = list_set(m, 0, s0);
    m = list_set(m, 4, s1);
    m = list_set(m, 8, s2);
    m = list_set(m, 1, u0);
    m = list_set(m, 5, u1);
    m = list_set(m, 9, u2);
    m = list_set(m, 2, 0.0 - f0);
    m = list_set(m, 6, 0.0 - f1);
    m = list_set(m, 10, 0.0 - f2);
    m = list_set(m, 12, 0.0 - (s0 * ex + s1 * ey + s2 * ez));
    m = list_set(m, 13, 0.0 - (u0 * ex + u1 * ey + u2 * ez));
    m = list_set(m, 14, f0 * ex + f1 * ey + f2 * ez);
    return m;
}

pub fn mat4_transform_perspective(fovy: Float, aspect: Float, znear: Float, zfar: Float) -> Result[List[Float], String] {
    if znear <= 0.0 { return Err("mat4 near"); }
    if zfar <= znear { return Err("mat4 far"); }
    let t: Float = sin(fovy * 0.5) / cos(fovy * 0.5);
    let mut m: List[Float] = list_new();
    let mut i: Int = 0;
    while i < 16 {
        m = list_push(m, 0.0);
        i = i + 1;
    }
    m = list_set(m, 0, 1.0 / (aspect * t));
    m = list_set(m, 5, 1.0 / t);
    m = list_set(m, 10, 0.0 - (zfar + znear) / (zfar - znear));
    m = list_set(m, 11, 0.0 - 1.0);
    m = list_set(m, 14, 0.0 - 2.0 * zfar * znear / (zfar - znear));
    return Ok(m);
}

pub fn mat4_transform_apply(m: List[Float], x: Float, y: Float, z: Float) -> Result[List[Float], String] {
    if list_len(m) != 16 { return Err("mat4"); }
    let mut o: List[Float] = list_new();
    o = list_push(o, list_get(m, 0) * x + list_get(m, 4) * y + list_get(m, 8) * z + list_get(m, 12));
    o = list_push(o, list_get(m, 1) * x + list_get(m, 5) * y + list_get(m, 9) * z + list_get(m, 13));
    o = list_push(o, list_get(m, 2) * x + list_get(m, 6) * y + list_get(m, 10) * z + list_get(m, 14));
    return Ok(o);
}

pub fn mat4_transform_invert_affine(m: List[Float]) -> Result[List[Float], String] {
    if list_len(m) != 16 { return Err("mat4"); }
    let mut r: List[Float] = mat4_transform_ident();
    r = list_set(r, 0, list_get(m, 0));
    r = list_set(r, 1, list_get(m, 4));
    r = list_set(r, 2, list_get(m, 8));
    r = list_set(r, 4, list_get(m, 1));
    r = list_set(r, 5, list_get(m, 5));
    r = list_set(r, 6, list_get(m, 9));
    r = list_set(r, 8, list_get(m, 2));
    r = list_set(r, 9, list_get(m, 6));
    r = list_set(r, 10, list_get(m, 10));
    let tx: Float = list_get(m, 12);
    let ty: Float = list_get(m, 13);
    let tz: Float = list_get(m, 14);
    r = list_set(r, 12, 0.0 - (list_get(r, 0) * tx + list_get(r, 4) * ty + list_get(r, 8) * tz));
    r = list_set(r, 13, 0.0 - (list_get(r, 1) * tx + list_get(r, 5) * ty + list_get(r, 9) * tz));
    r = list_set(r, 14, 0.0 - (list_get(r, 2) * tx + list_get(r, 6) * ty + list_get(r, 10) * tz));
    return Ok(r);
}
