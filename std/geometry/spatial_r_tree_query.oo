// # R-tree spatial queries
//
// Logline: Query 2D box overlap, nearest-neighbor, and node subtree choice in an R-tree.
//
// Setup: Pure. Uses stack-based DFS traversal over R-tree packed list representation.
//
// Beats:
//   1. Query overlap by walking MBRs and skipping disjoint subtrees.
//   2. Query nearest neighbor by Euclidean distance to box center.
//   3. Choose subtree for insertion with minimum MBR area expansion.
//   4. Fail closed with Result Err when tree is empty or box is missing.

fn rt_query_b(ni: Int) -> Int {
    return 3 + ni * 26;
}

pub fn spatial_r_tree_g(t: List[Float], ni: Int, off: Int) -> Float {
    return list_get(t, rt_query_b(ni) + off);
}

pub fn spatial_r_tree_fi(x: Float) -> Int {
    let mut i: Int = 0;
    let mut f: Float = 0.0;
    while i < 64 {
        if x < f + 0.5 {
            return i;
        }
        f = f + 1.0;
        i = i + 1;
    }
    return 63;
}

pub fn spatial_r_tree_e(i: Int) -> Int {
    return 6 + i * 5;
}

pub fn spatial_r_tree_leaf(t: List[Float], ni: Int) -> Bool {
    return spatial_r_tree_g(t, ni, 4) >= 0.5;
}

pub fn spatial_r_tree_n(t: List[Float], ni: Int) -> Int {
    return spatial_r_tree_fi(spatial_r_tree_g(t, ni, 5));
}

pub fn spatial_r_tree_ch(t: List[Float], ni: Int, i: Int) -> Int {
    return spatial_r_tree_fi(spatial_r_tree_g(t, ni, spatial_r_tree_e(i) + 4));
}

pub fn spatial_r_tree_ov(ax0: Float, ay0: Float, ax1: Float, ay1: Float, bx0: Float, by0: Float, bx1: Float, by1: Float) -> Bool {
    if ax1 < bx0 { return false; }
    if bx1 < ax0 { return false; }
    if ay1 < by0 { return false; }
    if by1 < ay0 { return false; }
    return true;
}

pub fn spatial_r_tree_comp(t: List[Float], ni: Int, i: Int, c: Int) -> Float {
    if spatial_r_tree_leaf(t, ni) {
        return spatial_r_tree_g(t, ni, spatial_r_tree_e(i) + c);
    }
    return spatial_r_tree_g(t, spatial_r_tree_ch(t, ni, i), c);
}

pub fn spatial_r_tree_pick_child(t: List[Float], ni: Int, x0: Float, y0: Float, x1: Float, y1: Float) -> Int {
    let n: Int = spatial_r_tree_n(t, ni);
    let mut best: Int = 0;
    let mut bg: Float = 1000000000.0;
    let mut i: Int = 0;
    while i < n {
        let ax0: Float = spatial_r_tree_comp(t, ni, i, 0);
        let ay0: Float = spatial_r_tree_comp(t, ni, i, 1);
        let ax1: Float = spatial_r_tree_comp(t, ni, i, 2);
        let ay1: Float = spatial_r_tree_comp(t, ni, i, 3);
        let a0: Float = (ax1 - ax0) * (ay1 - ay0);
        let mut nx0: Float = ax0;
        let mut ny0: Float = ay0;
        let mut nx1: Float = ax1;
        let mut ny1: Float = ay1;
        if x0 < nx0 { nx0 = x0; }
        if y0 < ny0 { ny0 = y0; }
        if x1 > nx1 { nx1 = x1; }
        if y1 > ny1 { ny1 = y1; }
        let g: Float = (nx1 - nx0) * (ny1 - ny0) - a0;
        if g < bg {
            bg = g;
            best = i;
        }
        i = i + 1;
    }
    return best;
}

pub fn spatial_r_tree_query_overlap(tree: List[Float], x0: Float, y0: Float, x1: Float, y1: Float) -> Result[Int, String] {
    if list_get(tree, 2) < 0.5 {
        return Err("rtree empty");
    }
    let mut st: List[Int] = list_new();
    st = list_push(st, spatial_r_tree_fi(list_get(tree, 0)));
    let mut head: Int = 0;
    while head < list_len(st) {
        let ni: Int = list_get(st, head);
        head = head + 1;
        let gx0: Float = spatial_r_tree_g(tree, ni, 0);
        let gy0: Float = spatial_r_tree_g(tree, ni, 1);
        let gx1: Float = spatial_r_tree_g(tree, ni, 2);
        let gy1: Float = spatial_r_tree_g(tree, ni, 3);
        if spatial_r_tree_ov(x0, y0, x1, y1, gx0, gy0, gx1, gy1) == false {
            continue;
        }
        if spatial_r_tree_leaf(tree, ni) {
            let n: Int = spatial_r_tree_n(tree, ni);
            let mut i: Int = 0;
            while i < n {
                let bx0: Float = spatial_r_tree_comp(tree, ni, i, 0);
                let by0: Float = spatial_r_tree_comp(tree, ni, i, 1);
                let bx1: Float = spatial_r_tree_comp(tree, ni, i, 2);
                let by1: Float = spatial_r_tree_comp(tree, ni, i, 3);
                if spatial_r_tree_ov(x0, y0, x1, y1, bx0, by0, bx1, by1) {
                    return Ok(spatial_r_tree_fi(spatial_r_tree_g(tree, ni, spatial_r_tree_e(i) + 4)));
                }
                i = i + 1;
            }
        } else {
            let n2: Int = spatial_r_tree_n(tree, ni);
            let mut j: Int = 0;
            while j < n2 {
                st = list_push(st, spatial_r_tree_ch(tree, ni, j));
                j = j + 1;
            }
        }
    }
    return Err("rtree no overlap");
}

pub fn spatial_r_tree_query_nearest(tree: List[Float], x: Float, y: Float) -> Result[Int, String] {
    if list_get(tree, 2) < 0.5 {
        return Err("rtree empty");
    }
    let mut best: Int = 0;
    let mut bd: Float = 1000000000.0;
    let mut st: List[Int] = list_new();
    st = list_push(st, spatial_r_tree_fi(list_get(tree, 0)));
    let mut head: Int = 0;
    while head < list_len(st) {
        let ni: Int = list_get(st, head);
        head = head + 1;
        let n: Int = spatial_r_tree_n(tree, ni);
        if spatial_r_tree_leaf(tree, ni) {
            let mut i: Int = 0;
            while i < n {
                let cx: Float = 0.5 * (spatial_r_tree_comp(tree, ni, i, 0) + spatial_r_tree_comp(tree, ni, i, 2));
                let cy: Float = 0.5 * (spatial_r_tree_comp(tree, ni, i, 1) + spatial_r_tree_comp(tree, ni, i, 3));
                let dx: Float = cx - x;
                let dy: Float = cy - y;
                let d: Float = dx * dx + dy * dy;
                if d < bd {
                    bd = d;
                    best = spatial_r_tree_fi(spatial_r_tree_g(tree, ni, spatial_r_tree_e(i) + 4));
                }
                i = i + 1;
            }
        } else {
            let mut j: Int = 0;
            while j < n {
                st = list_push(st, spatial_r_tree_ch(tree, ni, j));
                j = j + 1;
            }
        }
    }
    return Ok(best);
}

pub fn spatial_r_tree_query_choose(tree: List[Float], x0: Float, y0: Float, x1: Float, y1: Float) -> Result[Int, String] {
    if list_get(tree, 2) < 0.5 {
        return Err("rtree empty");
    }
    let ni: Int = spatial_r_tree_fi(list_get(tree, 0));
    if spatial_r_tree_n(tree, ni) < 1 {
        return Err("rtree empty");
    }
    return Ok(spatial_r_tree_pick_child(tree, ni, x0, y0, x1, y1));
}
