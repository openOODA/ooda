// # Financial Order Routing Operations
//
// Logline: Fill updates, cancel, fill-rate, and execution net. Destubbed off &mut.
//
// Setup: Imports routing_types.oo. By-value route reconstruct; last_ok on miss.
//
// Beats:
//   1. Remaining qty and complete when rem==0 or inactive.
//   2. Apply fill (reject inactive / overfill); cancel sets status 4.
//   3. Fill rate = filled*100/total; buy net = qty*px+fee; sell = qty*px-fee.
// residual: &mut destubbed to by-value.

import "./routing_types.oo";

pub fn order_route_remaining_qty(route: OrderRoute) -> Int {
    return route.remaining_qty;
}

pub fn order_route_is_complete(route: OrderRoute) -> Int {
    if route.remaining_qty == 0 {
        return 1;
    }
    if route.is_active == 0 {
        return 1;
    }
    return 0;
}

pub fn order_route_update_fill(route: OrderRoute, fill_qty: Int, fill_price: Int) -> OrderRoute {
    if route.is_active == 0 {
        return OrderRoute {
            side: route.side,
            total_qty: route.total_qty,
            limit_price: route.limit_price,
            filled_qty: route.filled_qty,
            remaining_qty: route.remaining_qty,
            status: route.status,
            is_active: 0,
            last_ok: 0
        };
    }
    if route.side == 1 {
        if fill_price > route.limit_price {
            return OrderRoute {
                side: route.side,
                total_qty: route.total_qty,
                limit_price: route.limit_price,
                filled_qty: route.filled_qty,
                remaining_qty: route.remaining_qty,
                status: route.status,
                is_active: route.is_active,
                last_ok: 0
            };
        }
    } else {
        if fill_price < route.limit_price {
            return OrderRoute {
                side: route.side,
                total_qty: route.total_qty,
                limit_price: route.limit_price,
                filled_qty: route.filled_qty,
                remaining_qty: route.remaining_qty,
                status: route.status,
                is_active: route.is_active,
                last_ok: 0
            };
        }
    }
    let rem: Int = route.remaining_qty;
    if fill_qty > rem {
        return OrderRoute {
            side: route.side,
            total_qty: route.total_qty,
            limit_price: route.limit_price,
            filled_qty: route.filled_qty,
            remaining_qty: route.remaining_qty,
            status: route.status,
            is_active: route.is_active,
            last_ok: 0
        };
    }
    let new_filled: Int = route.filled_qty + fill_qty;
    let new_rem: Int = rem - fill_qty;
    let mut new_status: Int = 2;
    let mut new_active: Int = 1;
    if new_rem == 0 {
        new_status = 3;
        new_active = 0;
    }
    return OrderRoute {
        side: route.side,
        total_qty: route.total_qty,
        limit_price: route.limit_price,
        filled_qty: new_filled,
        remaining_qty: new_rem,
        status: new_status,
        is_active: new_active,
        last_ok: 1
    };
}

pub fn order_route_cancel(route: OrderRoute) -> OrderRoute {
    if route.is_active == 0 {
        return OrderRoute {
            side: route.side,
            total_qty: route.total_qty,
            limit_price: route.limit_price,
            filled_qty: route.filled_qty,
            remaining_qty: route.remaining_qty,
            status: route.status,
            is_active: 0,
            last_ok: 0
        };
    }
    return OrderRoute {
        side: route.side,
        total_qty: route.total_qty,
        limit_price: route.limit_price,
        filled_qty: route.filled_qty,
        remaining_qty: route.remaining_qty,
        status: 4,
        is_active: 0,
        last_ok: 1
    };
}

pub fn order_route_calculate_fill_rate(route: OrderRoute) -> Int {
    let total: Int = route.total_qty;
    if total <= 0 {
        return 0;
    }
    let filled: Int = route.filled_qty;
    return (filled * 100) / total;
}

pub fn execution_report_is_fill(report: ExecutionReport) -> Int {
    return report.is_fill;
}

pub fn execution_report_total_value(report: ExecutionReport) -> Int {
    let qty: Int = report.exec_qty;
    let price: Int = report.exec_price;
    return qty * price;
}

pub fn execution_report_net_amount(report: ExecutionReport) -> Int {
    let val: Int = execution_report_total_value(report);
    let fee: Int = report.fee;
    if report.side == 1 {
        return val + fee;
    }
    return val - fee;
}
