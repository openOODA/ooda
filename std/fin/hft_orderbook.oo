// ===================================================================
// openOODA Standard Library — ooda::fin::hft_orderbook
// Order book snapshot construction & imbalance helpers
// (split from hft.oo, M172)
// ===================================================================
// RULES.oot 1.4 / 1.3: default-deny privileged effects; fail-closed residual.

import "./hft_types.oo";

// -------------------------------------------------------------------
// Constructor
// -------------------------------------------------------------------

pub fn orderbook_snapshot_create(
    symbol: String,
    best_bid: Int,
    best_ask: Int,
    bid_depth: Int,
    ask_depth: Int,
    timestamp_ns: Int
) -> OrderBookSnapshot {
    let mut spd: Int = 0;
    if best_ask > best_bid {
        if best_bid > 0 {
            spd = best_ask - best_bid;
        }
    }
    let mut mid: Int = 0;
    if best_bid > 0 {
        if best_ask > 0 {
            mid = (best_bid + best_ask) / 2;
        }
    }
    let mut micro: Int = mid;
    let total_depth: Int = bid_depth + ask_depth;
    if total_depth > 0 {
        micro = ((best_bid * ask_depth) + (best_ask * bid_depth)) / total_depth;
    }

    return OrderBookSnapshot {
        symbol: symbol,
        best_bid: best_bid,
        best_ask: best_ask,
        bid_depth_qty: bid_depth,
        ask_depth_qty: ask_depth,
        spread: spd,
        mid_price: mid,
        micro_price: micro,
        timestamp_ns: timestamp_ns,
    };
}

// -------------------------------------------------------------------
// Snapshot helpers
// -------------------------------------------------------------------

pub fn orderbook_snapshot_imbalance_bps(snapshot: &OrderBookSnapshot) -> Int {
    let b_qty: Int = (snapshot).bid_depth_qty;
    let a_qty: Int = (snapshot).ask_depth_qty;
    let total_qty: Int = b_qty + a_qty;
    if total_qty <= 0 {
        return 0;
    }
    let diff: Int = b_qty - a_qty;
    return (diff * 10000) / total_qty;
}

pub fn orderbook_snapshot_is_crossed(snapshot: &OrderBookSnapshot) -> Bool {
    let ask: Int = (snapshot).best_ask;
    let bid: Int = (snapshot).best_bid;
    if ask <= 0 {
        return false;
    }
    if bid <= 0 {
        return false;
    }
    return bid >= ask;
}
