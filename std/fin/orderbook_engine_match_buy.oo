// # Order Book Buy-Side Limit Order Crossing
//
// Logline: Cross a buy limit order against the resting ask queue and insert the residual as a bid.
//
// Setup: Imports orderbook_ops.oo for the OrderBook, LimitOrder, and orderbook_add_order operations.
//
// Beats:
//   1. Walk the ask0 and ask1 slots, filling at the limit price or better.
//   2. Insert any unfilled residual as a new resting bid via orderbook_add_order.

import "./orderbook_ops.oo";

pub fn orderbook_match_buy(book: OrderBook, incoming: LimitOrder) -> OrderBook {
    let mut ob: OrderBook = book;
    let in_price: Int = (incoming).price;
    let mut in_rem: Int = limit_order_remaining_qty(incoming);

    if in_rem <= 0 {
        return ob;
    }

    if (ob).ask0_live == 1 {
        if (ob).ask0_price <= in_price {
            if in_rem > 0 {
                let ask_qty: Int = (ob).ask0_qty;
                if ask_qty <= in_rem {
                    in_rem = in_rem - ask_qty;
                    ob = OrderBook {
                        bid_count: (ob).bid_count,
                        ask_count: (ob).ask_count,
                        last_trade_price: (ob).ask0_price,
                        bid0_id: (ob).bid0_id,
                        bid0_price: (ob).bid0_price,
                        bid0_qty: (ob).bid0_qty,
                        bid0_live: (ob).bid0_live,
                        bid1_id: (ob).bid1_id,
                        bid1_price: (ob).bid1_price,
                        bid1_qty: (ob).bid1_qty,
                        bid1_live: (ob).bid1_live,
                        ask0_id: (ob).ask0_id,
                        ask0_price: (ob).ask0_price,
                        ask0_qty: 0,
                        ask0_live: 0,
                        ask1_id: (ob).ask1_id,
                        ask1_price: (ob).ask1_price,
                        ask1_qty: (ob).ask1_qty,
                        ask1_live: (ob).ask1_live,
                        processed: (ob).processed + 1
                    };
                } else {
                    let rem_ask: Int = ask_qty - in_rem;
                    in_rem = 0;
                    ob = OrderBook {
                        bid_count: (ob).bid_count,
                        ask_count: (ob).ask_count,
                        last_trade_price: (ob).ask0_price,
                        bid0_id: (ob).bid0_id,
                        bid0_price: (ob).bid0_price,
                        bid0_qty: (ob).bid0_qty,
                        bid0_live: (ob).bid0_live,
                        bid1_id: (ob).bid1_id,
                        bid1_price: (ob).bid1_price,
                        bid1_qty: (ob).bid1_qty,
                        bid1_live: (ob).bid1_live,
                        ask0_id: (ob).ask0_id,
                        ask0_price: (ob).ask0_price,
                        ask0_qty: rem_ask,
                        ask0_live: 1,
                        ask1_id: (ob).ask1_id,
                        ask1_price: (ob).ask1_price,
                        ask1_qty: (ob).ask1_qty,
                        ask1_live: (ob).ask1_live,
                        processed: (ob).processed + 1
                    };
                }
            }
        }
    }
    if (ob).ask1_live == 1 {
        if (ob).ask1_price <= in_price {
            if in_rem > 0 {
                let ask_qty: Int = (ob).ask1_qty;
                if ask_qty <= in_rem {
                    in_rem = in_rem - ask_qty;
                    ob = OrderBook {
                        bid_count: (ob).bid_count,
                        ask_count: (ob).ask_count,
                        last_trade_price: (ob).ask1_price,
                        bid0_id: (ob).bid0_id,
                        bid0_price: (ob).bid0_price,
                        bid0_qty: (ob).bid0_qty,
                        bid0_live: (ob).bid0_live,
                        bid1_id: (ob).bid1_id,
                        bid1_price: (ob).bid1_price,
                        bid1_qty: (ob).bid1_qty,
                        bid1_live: (ob).bid1_live,
                        ask0_id: (ob).ask0_id,
                        ask0_price: (ob).ask0_price,
                        ask0_qty: (ob).ask0_qty,
                        ask0_live: (ob).ask0_live,
                        ask1_id: (ob).ask1_id,
                        ask1_price: (ob).ask1_price,
                        ask1_qty: 0,
                        ask1_live: 0,
                        processed: (ob).processed + 1
                    };
                } else {
                    let rem_ask: Int = ask_qty - in_rem;
                    in_rem = 0;
                    ob = OrderBook {
                        bid_count: (ob).bid_count,
                        ask_count: (ob).ask_count,
                        last_trade_price: (ob).ask1_price,
                        bid0_id: (ob).bid0_id,
                        bid0_price: (ob).bid0_price,
                        bid0_qty: (ob).bid0_qty,
                        bid0_live: (ob).bid0_live,
                        bid1_id: (ob).bid1_id,
                        bid1_price: (ob).bid1_price,
                        bid1_qty: (ob).bid1_qty,
                        bid1_live: (ob).bid1_live,
                        ask0_id: (ob).ask0_id,
                        ask0_price: (ob).ask0_price,
                        ask0_qty: (ob).ask0_qty,
                        ask0_live: (ob).ask0_live,
                        ask1_id: (ob).ask1_id,
                        ask1_price: (ob).ask1_price,
                        ask1_qty: rem_ask,
                        ask1_live: 1,
                        processed: (ob).processed + 1
                    };
                }
            }
        }
    }
    if in_rem > 0 {
        let resting: LimitOrder = LimitOrder {
            order_id: (incoming).order_id,
            price: (incoming).price,
            quantity: (incoming).quantity,
            filled: (incoming).quantity - in_rem,
            is_buy: 1,
            is_canceled: 0
        };
        ob = orderbook_add_order(ob, resting);
    }

    return ob;
}
