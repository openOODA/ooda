type TickData = struct {
    price: Int,
    quantity: Int,
    seq_num: Int
};

pub fn hft_tick_new(price: Int, quantity: Int, seq_num: Int) -> TickData {
    return TickData {
        price: price,
        quantity: quantity,
        seq_num: seq_num
    };
}

pub fn hft_tick_price(t: TickData) -> Int {
    return t.price;
}
