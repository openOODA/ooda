// ===================================================================
// openOODA Standard Library — ooda::fin::hft_engine
// HFT engine init, risk gates, fills, circuit breaker
// ===================================================================

type HftEngine = struct {
    engine_id: String,
    max_position: Int,
    current_position: Int,
    max_order_rate_per_sec: Int,
    orders_sent_last_sec: Int,
    min_profit_margin_bps: Int,
    circuit_breaker_triggered: Bool,
    total_orders_sent: Int,
    total_volume_traded: Int,
    total_pnl: Int,
    is_active: Bool
};

pub fn hft_engine_init(
    engine_id: String,
    max_pos: Int,
    max_rate: Int,
    min_margin: Int
) -> HftEngine {
    return HftEngine {
        engine_id: engine_id,
        max_position: max_pos,
        current_position: 0,
        max_order_rate_per_sec: max_rate,
        orders_sent_last_sec: 0,
        min_profit_margin_bps: min_margin,
        circuit_breaker_triggered: false,
        total_orders_sent: 0,
        total_volume_traded: 0,
        total_pnl: 0,
        is_active: true
    };
}

pub fn hft_engine_can_submit_order(engine: HftEngine, side: Int, qty: Int) -> Bool {
    if engine.is_active == false {
        return false;
    }
    if engine.circuit_breaker_triggered == true {
        return false;
    }
    if engine.orders_sent_last_sec >= engine.max_order_rate_per_sec {
        return false;
    }
    let mut pos_change: Int = qty;
    if side == 2 {
        pos_change = 0 - qty;
    }
    let next_pos: Int = engine.current_position + pos_change;
    let mut abs_pos: Int = next_pos;
    if next_pos < 0 {
        abs_pos = 0 - next_pos;
    }
    if abs_pos > engine.max_position {
        return false;
    }
    return true;
}

pub fn hft_engine_record_fill(engine: HftEngine, fill_qty: Int, fill_price: Int, side: Int) -> HftEngine {
    let _px: Int = fill_price;
    let mut next_pos: Int = engine.current_position;
    if side == 1 {
        next_pos = engine.current_position + fill_qty;
    } else {
        next_pos = engine.current_position - fill_qty;
    }
    return HftEngine {
        engine_id: engine.engine_id,
        max_position: engine.max_position,
        current_position: next_pos,
        max_order_rate_per_sec: engine.max_order_rate_per_sec,
        orders_sent_last_sec: engine.orders_sent_last_sec + 1,
        min_profit_margin_bps: engine.min_profit_margin_bps,
        circuit_breaker_triggered: engine.circuit_breaker_triggered,
        total_orders_sent: engine.total_orders_sent + 1,
        total_volume_traded: engine.total_volume_traded + fill_qty,
        total_pnl: engine.total_pnl,
        is_active: engine.is_active
    };
}

pub fn hft_engine_trigger_circuit_breaker(engine: HftEngine) -> HftEngine {
    return HftEngine {
        engine_id: engine.engine_id,
        max_position: engine.max_position,
        current_position: engine.current_position,
        max_order_rate_per_sec: engine.max_order_rate_per_sec,
        orders_sent_last_sec: engine.orders_sent_last_sec,
        min_profit_margin_bps: engine.min_profit_margin_bps,
        circuit_breaker_triggered: true,
        total_orders_sent: engine.total_orders_sent,
        total_volume_traded: engine.total_volume_traded,
        total_pnl: engine.total_pnl,
        is_active: false
    };
}
