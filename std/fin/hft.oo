// ===================================================================
// openOODA Standard Library — ooda::fin::hft
// HFT Re-export Shim (by-value destub)
// ===================================================================

import "./hft_tick_order.oo";
import "./hft_latency.oo";
import "./hft_engine.oo";

pub fn shim_marker_tick_create() -> TickData {
    return tick_data_create("", 0, 0, 0, 0, 0, 0, 0, 0, "", false);
}

pub fn shim_marker_order_create() -> MarketOrder {
    return market_order_create(0, "", 1, 0, 0, 0, 0);
}

pub fn shim_marker_latency_init() -> LatencyMetrics {
    return latency_metrics_init();
}

pub fn shim_marker_engine_init() -> HftEngine {
    return hft_engine_init("SHIM", 0, 1, 0);
}

pub fn shim_marker_apply_fill(order: MarketOrder, fill_qty: Int, fill_price: Int) -> MarketOrder {
    return market_order_apply_fill(order, fill_qty, fill_price);
}

pub fn shim_marker_record_fill(engine: HftEngine, fill_qty: Int, fill_price: Int, side: Int) -> HftEngine {
    return hft_engine_record_fill(engine, fill_qty, fill_price, side);
}

pub fn shim_marker_trip_breaker(engine: HftEngine) -> HftEngine {
    return hft_engine_trigger_circuit_breaker(engine);
}
