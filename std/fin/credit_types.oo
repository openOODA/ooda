// # Credit types
//
// Logline: CreditScore destubbed off pub type Float BorrowerProfile.
// residual: List[struct] destubbed to Int floor.

type CreditScore = struct {
    score: Int,
    rating_tier: Int,
    is_valid: Int
};

pub fn credit_score_new(score: Int, rating_tier: Int, is_valid: Int) -> CreditScore {
    return CreditScore {
        score: score,
        rating_tier: rating_tier,
        is_valid: is_valid
    };
}

pub fn credit_score_value(c: CreditScore) -> Int {
    return c.score;
}
