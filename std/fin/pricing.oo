// # Financial Options Pricing Facade
//
// Logline: Re-exports option contract models, Black-Scholes pricing engine, and volatility calibration.
//
// Setup: Pure module shim importing by-value engine and vol companions.
//
// Beats:
//   1. Import options pricing engine and vol companions.
//   2. Re-export public symbols with typed shim markers.

import "./pricing_engine.oo";
import "./pricing_vol.oo";

pub fn shim_marker_option_new() -> OptionContract {
    return option_contract_new(true, false, 100.0, 100.0, 1.0, 0.05, 0.0, 0.20);
}

pub fn shim_marker_normal_pdf() -> Float {
    return std_normal_pdf(0.0);
}

pub fn shim_marker_normal_cdf() -> Float {
    return std_normal_cdf(0.0);
}

pub fn shim_marker_price_bs(contract: OptionContract) -> PricingResult {
    return price_black_scholes(contract);
}

pub fn shim_marker_price_american(contract: OptionContract) -> PricingResult {
    return price_american_option_approx(contract);
}

pub fn shim_marker_engine_init() -> PricingEngine {
    return pricing_engine_init(0.20, 0.05);
}

pub fn shim_marker_implied_vol(contract: OptionContract) -> Float {
    return calculate_implied_volatility(contract, 10.0, 100, 0.0001);
}

pub fn shim_marker_vol_surface() -> VolatilitySurface {
    return volatility_surface_new(0.20, 0.0, 0.0, 0.0, 100.0);
}

pub fn shim_marker_eval_vol(surface: VolatilitySurface) -> Float {
    return evaluate_surface_volatility(surface, 100.0, 100.0, 1.0);
}

pub fn shim_marker_apply_vol(contract: OptionContract, surface: VolatilitySurface) -> OptionContract {
    return apply_volatility_surface(contract, surface);
}
