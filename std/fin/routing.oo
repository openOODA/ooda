// # Financial Order Routing Facade
//
// Logline: Re-exports smart order routing models, route state management, venue quotes, and execution interfaces.
//
// Setup: Pure module shim importing types, operations, venue analytics, and hardware stubs submodules.
//
// Beats:
//   1. Import routing types, operations, venue analytics, and stubs companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Preserve API compatibility for order routing engines.

import "./routing_types.oo";
import "./routing_ops.oo";
import "./routing_venue.oo";
import "./routing_stubs.oo";

pub fn shim_marker_order_route_init() -> OrderRoute {
    return order_route_init("R1", "O1", "AAPL", 1, 100, 15000, "V1", "TWAP", 1000);
}

pub fn shim_marker_venue_quote_init() -> VenueQuote {
    return venue_quote_init("Q1", "V1", "AAPL", 14995, 500, 15005, 500, 100, 2, 1000);
}

pub fn shim_marker_execution_report_init() -> ExecutionReport {
    return execution_report_init("E1", "O1", "R1", "V1", "AAPL", 1, 100, 15000, 5, 3, 1001);
}

pub fn shim_marker_router_config_init() -> SmartOrderRouter {
    return router_config_init("SR1", 5, 80, 500);
}

pub fn shim_marker_route_leg_init() -> RouteLeg {
    return route_leg_init("L1", "V1", 50, 15000);
}

pub fn shim_marker_venue_metrics_init() -> VenueMetrics {
    return venue_metrics_init("V1", 10, 95, 1, 0);
}

pub fn shim_marker_route_fill(route: &mut OrderRoute) -> Result[Bool, String] {
    return order_route_update_fill(route, 50, 15000);
}

pub fn shim_marker_route_cancel(route: &mut OrderRoute) -> Result[Bool, String] {
    return order_route_cancel(route);
}

pub fn shim_marker_quote_spread(quote: &VenueQuote) -> Int {
    return venue_quote_get_spread(quote);
}

pub fn shim_marker_best_quote(q1: VenueQuote, q2: VenueQuote) -> VenueQuote {
    return routing_select_best_venue_quote(q1, q2, true);
}
