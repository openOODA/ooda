// # Financial Volatility Modeling & Calibration
//
// Logline: Calculates Newton-Raphson implied volatility and evaluates parameterized volatility surfaces.
//
// Setup: Imports pricing_engine.oo for Black-Scholes pricing and Vega sensitivity evaluations.
//
// Beats:
//   1. Solve implied volatility from market price using Newton-Raphson iteration.
//   2. Construct and interpolate parametric volatility surfaces factoring skew and smile.
//   3. Apply calibrated surface volatilities to option contract definitions.

import "./pricing_engine.oo";

pub fn calculate_implied_volatility(
    contract: OptionContract,
    target_price: Float,
    max_iterations: Int,
    tolerance: Float
) -> Float {
    let mut current_vol: Float = 0.20;
    let mut iter: Int = 0;
    while iter < max_iterations {
        let temp_contract: OptionContract = OptionContract {
            is_call: contract.is_call,
            is_american: contract.is_american,
            strike: contract.strike,
            spot: contract.spot,
            time_to_expiry: contract.time_to_expiry,
            risk_free_rate: contract.risk_free_rate,
            dividend_yield: contract.dividend_yield,
            volatility: current_vol
        };
        let res: PricingResult = price_black_scholes(temp_contract);
        let diff: Float = res.price - target_price;
        let mut abs_diff: Float = diff;
        if diff < 0.0 {
            abs_diff = 0.0 - diff;
        }
        if abs_diff < tolerance {
            return current_vol;
        }
        if res.vega <= 0.00001 {
            return current_vol;
        }
        current_vol = current_vol - (diff / res.vega);
        if current_vol < 0.001 {
            current_vol = 0.001;
        }
        iter = iter + 1;
    }
    return current_vol;
}

pub fn volatility_surface_new(
    base_vol: Float,
    skew: Float,
    smile: Float,
    term_slope: Float,
    ref_spot: Float
) -> VolatilitySurface {
    return VolatilitySurface {
        base_volatility: base_vol,
        skew_coefficient: skew,
        smile_coefficient: smile,
        term_structure_slope: term_slope,
        reference_spot: ref_spot
    };
}

pub fn evaluate_surface_volatility(
    surface: VolatilitySurface,
    strike: Float,
    spot: Float,
    time_to_expiry: Float
) -> Float {
    let mut ref_s: Float = surface.reference_spot;
    if ref_s <= 0.0 {
        ref_s = spot;
    }
    if spot <= 0.0 {
        return surface.base_volatility;
    }
    let moneyness: Float = (strike / spot) - 1.0;
    let t_sqrt: Float = sqrt(time_to_expiry);
    let vol: Float = surface.base_volatility
        + (surface.skew_coefficient * moneyness)
        + (surface.smile_coefficient * moneyness * moneyness)
        + (surface.term_structure_slope * t_sqrt);
    if vol < 0.001 {
        return 0.001;
    }
    return vol;
}

pub fn apply_volatility_surface(contract: OptionContract, surface: VolatilitySurface) -> OptionContract {
    let new_vol: Float = evaluate_surface_volatility(
        surface,
        contract.strike,
        contract.spot,
        contract.time_to_expiry
    );
    return OptionContract {
        is_call: contract.is_call,
        is_american: contract.is_american,
        strike: contract.strike,
        spot: contract.spot,
        time_to_expiry: contract.time_to_expiry,
        risk_free_rate: contract.risk_free_rate,
        dividend_yield: contract.dividend_yield,
        volatility: new_vol
    };
}
