// # HFT Microstructure Signals & Execution Reports
//
// Logline: Define MicrostructureSignal and ExecutionReport records; compute order imbalance, VWAP delta, and book pressure.
//
// Setup: Imports hft_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. MicrostructureSignal: bind order_imbalance and vwap_delta.
//   2. ExecutionReport: bind fill_qty, fill_price, and remaining_qty.
//   3. signal_order_imbalance_calc: derive imbalance from bid and ask sizes.
//   4. execution_report_full_fill: flip is_full_fill and freeze remaining_qty.
//
// residual: not a real HFT engine; integrate vetted trading stack.

// RULES.oot 1.4 / 1.3: default-deny privileged effects; fail-closed residual.

import "./hft_types.oo";

pub type MicrostructureSignal = struct {
    symbol: String,
    order_imbalance: Float,
    vwap_delta: Float,
    book_pressure: Float,
    trade_flow_toxicity: Float,
    signal_strength: Float,
    timestamp_ns: Int,
};

pub type ExecutionReport = struct {
    exec_id: Int,
    order_id: Int,
    symbol: String,
    side: Int,
    fill_qty: Int,
    fill_price: Int,
    remaining_qty: Int,
    fee_or_rebate_bps: Int,
    is_full_fill: Bool,
    timestamp_ns: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn microstructure_signal_create(
    symbol: String,
    imbalance: Float,
    vwap_d: Float,
    pressure: Float,
    toxicity: Float,
    timestamp: Int
) -> MicrostructureSignal {
    let strength: Float = (imbalance * 0.4) + (vwap_d * 0.3) + (pressure * 0.3);
    return MicrostructureSignal {
        symbol: symbol,
        order_imbalance: imbalance,
        vwap_delta: vwap_d,
        book_pressure: pressure,
        trade_flow_toxicity: toxicity,
        signal_strength: strength,
        timestamp_ns: timestamp,
    };
}

pub fn execution_report_create(
    exec_id: Int,
    order_id: Int,
    symbol: String,
    side: Int,
    fill_qty: Int,
    fill_price: Int,
    rem_qty: Int,
    fee_bps: Int,
    timestamp: Int
) -> ExecutionReport {
    let full: Bool = rem_qty == 0;
    return ExecutionReport {
        exec_id: exec_id,
        order_id: order_id,
        symbol: symbol,
        side: side,
        fill_qty: fill_qty,
        fill_price: fill_price,
        remaining_qty: rem_qty,
        fee_or_rebate_bps: fee_bps,
        is_full_fill: full,
        timestamp_ns: timestamp,
    };
}

// -------------------------------------------------------------------
// Signal direction helpers
// -------------------------------------------------------------------

pub fn microstructure_signal_is_bullish(signal: &MicrostructureSignal) -> Bool {
    let imb: Float = (signal).order_imbalance;
    let str: Float = (signal).signal_strength;
    if imb > 0.2 {
        if str > 0.3 {
            return true;
        }
    }
    return false;
}

pub fn microstructure_signal_is_bearish(signal: &MicrostructureSignal) -> Bool {
    let imb: Float = (signal).order_imbalance;
    let str: Float = (signal).signal_strength;
    let neg_imb_thresh: Float = 0.0 - 0.2;
    let neg_str_thresh: Float = 0.0 - 0.3;
    if imb < neg_imb_thresh {
        if str < neg_str_thresh {
            return true;
        }
    }
    return false;
}
