// # HFT Latency Metrics Constructors & SLA Helpers
//
// Logline: Construct LatencyMetrics; accumulate wire-to-wire, parsing, strategy, and ack latencies.
//
// Setup: Self-contained latency module. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. latency_metrics_init: build empty LatencyMetrics struct.
//   2. latency_metrics_record: refresh min, max, jitter, and sample_count.
//   3. latency_metrics_sla_pass: gate latency_max against SLA budget.
//   4. latency_metrics_rtt_calc: derive rtt_ns from wire and ack fields.
//
// residual: not a real HFT engine; integrate vetted trading stack.

type LatencyMetrics = struct {
    wire_to_wire_ns: Int,
    parsing_latency_ns: Int,
    strategy_eval_ns: Int,
    order_submit_ns: Int,
    ack_latency_ns: Int,
    rtt_ns: Int,
    jitter_ns: Int,
    min_latency_ns: Int,
    max_latency_ns: Int,
    sample_count: Int
};

pub fn latency_metrics_init() -> LatencyMetrics {
    return LatencyMetrics {
        wire_to_wire_ns: 0,
        parsing_latency_ns: 0,
        strategy_eval_ns: 0,
        order_submit_ns: 0,
        ack_latency_ns: 0,
        rtt_ns: 0,
        jitter_ns: 0,
        min_latency_ns: 0,
        max_latency_ns: 0,
        sample_count: 0
    };
}

pub fn latency_metrics_create(
    wire: Int,
    parse: Int,
    strat: Int,
    submit: Int,
    ack: Int,
    rtt: Int
) -> LatencyMetrics {
    let total_pipe: Int = parse + strat + submit;
    return LatencyMetrics {
        wire_to_wire_ns: wire,
        parsing_latency_ns: parse,
        strategy_eval_ns: strat,
        order_submit_ns: submit,
        ack_latency_ns: ack,
        rtt_ns: rtt,
        jitter_ns: 0,
        min_latency_ns: total_pipe,
        max_latency_ns: total_pipe,
        sample_count: 1
    };
}

pub fn latency_metrics_total_pipeline_ns(metrics: LatencyMetrics) -> Int {
    return metrics.parsing_latency_ns + metrics.strategy_eval_ns + metrics.order_submit_ns;
}

pub fn latency_metrics_is_within_sla(metrics: LatencyMetrics, max_allowed_ns: Int) -> Bool {
    let total: Int = latency_metrics_total_pipeline_ns(metrics);
    return total <= max_allowed_ns;
}

pub fn latency_metrics_add_sample(
    metrics: LatencyMetrics,
    wire_ns: Int,
    parse_ns: Int,
    strat_ns: Int,
    submit_ns: Int,
    ack_ns: Int
) -> LatencyMetrics {
    let total_ns: Int = parse_ns + strat_ns + submit_ns;
    let samples: Int = metrics.sample_count;
    let mut min_lat: Int = metrics.min_latency_ns;
    let mut max_lat: Int = metrics.max_latency_ns;
    if samples == 0 {
        min_lat = total_ns;
        max_lat = total_ns;
    } else {
        if total_ns < min_lat {
            min_lat = total_ns;
        }
        if total_ns > max_lat {
            max_lat = total_ns;
        }
    }
    return LatencyMetrics {
        wire_to_wire_ns: wire_ns,
        parsing_latency_ns: parse_ns,
        strategy_eval_ns: strat_ns,
        order_submit_ns: submit_ns,
        ack_latency_ns: ack_ns,
        rtt_ns: wire_ns + ack_ns,
        jitter_ns: metrics.jitter_ns,
        min_latency_ns: min_lat,
        max_latency_ns: max_lat,
        sample_count: samples + 1
    };
}
