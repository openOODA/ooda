// # Financial Order Book Types
//
// Logline: Limit order destubbed off List[LimitOrder] to fixed bid/ask slots.
//
// Setup: Two live bid slots and two live ask slots plus book tallies.
//
// Beats:
//   1. limit_order_new id/price/qty.
//   2. orderbook_new empty last_trade 0.
// residual: List[LimitOrder] destubbed.

type LimitOrder = struct {
    order_id: Int,
    price: Int,
    quantity: Int,
    filled: Int,
    is_buy: Int,
    is_canceled: Int
};

pub fn limit_order_new(order_id: Int, price: Int, quantity: Int) -> LimitOrder {
    return LimitOrder {
        order_id: order_id,
        price: price,
        quantity: quantity,
        filled: 0,
        is_buy: 1,
        is_canceled: 0
    };
}

pub fn limit_order_make(order_id: Int, price: Int, quantity: Int, is_buy: Int) -> LimitOrder {
    return LimitOrder {
        order_id: order_id,
        price: price,
        quantity: quantity,
        filled: 0,
        is_buy: is_buy,
        is_canceled: 0
    };
}

type OrderBook = struct {
    bid_count: Int,
    ask_count: Int,
    last_trade_price: Int,
    bid0_id: Int,
    bid0_price: Int,
    bid0_qty: Int,
    bid0_live: Int,
    bid1_id: Int,
    bid1_price: Int,
    bid1_qty: Int,
    bid1_live: Int,
    ask0_id: Int,
    ask0_price: Int,
    ask0_qty: Int,
    ask0_live: Int,
    ask1_id: Int,
    ask1_price: Int,
    ask1_qty: Int,
    ask1_live: Int,
    processed: Int
};

pub fn orderbook_new() -> OrderBook {
    return OrderBook {
        bid_count: 0,
        ask_count: 0,
        last_trade_price: 0,
        bid0_id: 0,
        bid0_price: 0,
        bid0_qty: 0,
        bid0_live: 0,
        bid1_id: 0,
        bid1_price: 0,
        bid1_qty: 0,
        bid1_live: 0,
        ask0_id: 0,
        ask0_price: 0,
        ask0_qty: 0,
        ask0_live: 0,
        ask1_id: 0,
        ask1_price: 0,
        ask1_qty: 0,
        ask1_live: 0,
        processed: 0
    };
}

pub fn orderbook_add_bid(ob: OrderBook, price: Int) -> OrderBook {
    let n: Int = ob.bid_count;
    let mut bid0_id: Int = ob.bid0_id;
    let mut bid0_price: Int = ob.bid0_price;
    let mut bid0_qty: Int = ob.bid0_qty;
    let mut bid0_live: Int = ob.bid0_live;
    let mut bid1_id: Int = ob.bid1_id;
    let mut bid1_price: Int = ob.bid1_price;
    let mut bid1_qty: Int = ob.bid1_qty;
    let mut bid1_live: Int = ob.bid1_live;
    if bid0_live == 0 {
        bid0_id = n + 1;
        bid0_price = price;
        bid0_qty = 1;
        bid0_live = 1;
    } else {
        if bid1_live == 0 {
            bid1_id = n + 1;
            bid1_price = price;
            bid1_qty = 1;
            bid1_live = 1;
        } else {
            bid1_id = n + 1;
            bid1_price = price;
            bid1_qty = 1;
            bid1_live = 1;
        }
    }
    return OrderBook {
        bid_count: n + 1,
        ask_count: ob.ask_count,
        last_trade_price: price,
        bid0_id: bid0_id,
        bid0_price: bid0_price,
        bid0_qty: bid0_qty,
        bid0_live: bid0_live,
        bid1_id: bid1_id,
        bid1_price: bid1_price,
        bid1_qty: bid1_qty,
        bid1_live: bid1_live,
        ask0_id: ob.ask0_id,
        ask0_price: ob.ask0_price,
        ask0_qty: ob.ask0_qty,
        ask0_live: ob.ask0_live,
        ask1_id: ob.ask1_id,
        ask1_price: ob.ask1_price,
        ask1_qty: ob.ask1_qty,
        ask1_live: ob.ask1_live,
        processed: ob.processed + 1
    };
}

type OrderBookLevel = struct {
    price: Int,
    total_qty: Int,
    n_orders: Int,
    is_buy: Int
};
