// # Financial Venue Analytics & Selection
//
// Logline: Evaluates quote spreads, venue health metrics, net trade costs, and best execution venue selection.
//
// Setup: Imports routing_types.oo for VenueQuote and VenueMetrics representations.
//
// Beats:
//   1. Calculate quote bid-ask spreads, mid prices, and latency validity.
//   2. Calculate fee-adjusted net execution cost across buy and sell orders.
//   3. Compare and select optimal market venue quotes using best execution logic.

import "./routing_types.oo";

pub fn venue_quote_get_spread(quote: &VenueQuote) -> Int {
    let ask: Int = (quote).ask_price;
    let bid: Int = (quote).bid_price;
    if ask >= bid {
        return ask - bid;
    }
    return 0;
}

pub fn venue_quote_get_mid_price(quote: &VenueQuote) -> Int {
    let ask: Int = (quote).ask_price;
    let bid: Int = (quote).bid_price;
    return (ask + bid) / 2;
}

pub fn venue_quote_is_valid(quote: &VenueQuote, max_latency_ns: Int) -> Bool {
    let valid: Bool = (quote).is_valid;
    if valid == false {
        return false;
    }
    let lat: Int = (quote).latency_ns;
    if lat > max_latency_ns {
        return false;
    }
    return true;
}

pub fn venue_quote_calculate_net_cost(quote: &VenueQuote, qty: Int, is_buy: Bool) -> Int {
    let mut price: Int = 0;
    if is_buy {
        price = (quote).ask_price;
    } else {
        price = (quote).bid_price;
    }

    let gross_cost: Int = price * qty;
    let bps: Int = (quote).fee_bps;
    let fee_part: Int = (gross_cost * bps) / 10000;

    if is_buy {
        return gross_cost + fee_part;
    } else {
        return gross_cost - fee_part;
    }
}

pub fn venue_metrics_is_acceptable(
    metrics: &VenueMetrics,
    min_fill_rate: Int,
    max_slippage: Int
) -> Bool {
    let h: Bool = (metrics).is_healthy;
    if h == false {
        return false;
    }
    let fr: Int = (metrics).fill_rate_pct;
    if fr < min_fill_rate {
        return false;
    }
    let slip: Int = (metrics).slippage_bps;
    if slip > max_slippage {
        return false;
    }
    return true;
}

pub fn routing_select_best_venue_quote(
    q1: VenueQuote,
    q2: VenueQuote,
    is_buy: Bool
) -> VenueQuote {
    let v1: Bool = q1.is_valid;
    let v2: Bool = q2.is_valid;

    if v1 == true && v2 == false {
        return q1;
    }
    if v1 == false && v2 == true {
        return q2;
    }
    if v1 == false && v2 == false {
        return q1;
    }

    if is_buy {
        let p1: Int = q1.ask_price;
        let p2: Int = q2.ask_price;
        if p1 <= p2 {
            return q1;
        } else {
            return q2;
        }
    } else {
        let p1: Int = q1.bid_price;
        let p2: Int = q2.bid_price;
        if p1 >= p2 {
            return q1;
        } else {
            return q2;
        }
    }
}

pub fn routing_compare_venues_for_order(
    q1: &VenueQuote,
    q2: &VenueQuote,
    target_qty: Int,
    is_buy: Bool
) -> Int {
    let c1: Int = venue_quote_calculate_net_cost(q1, target_qty, is_buy);
    let c2: Int = venue_quote_calculate_net_cost(q2, target_qty, is_buy);

    if is_buy {
        // For buying, lower cost is better
        if c1 < c2 {
            return 1;
        }
        if c2 < c1 {
            return 2;
        }
        return 0;
    } else {
        // For selling, higher proceeds is better
        if c1 > c2 {
            return 1;
        }
        if c2 > c1 {
            return 2;
        }
        return 0;
    }
}
