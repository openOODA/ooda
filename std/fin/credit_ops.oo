// # Financial Credit Risk Operations
//
// Logline: Calculates debt-to-income ratios, leverage, loan-to-value coverage, and rating classifications.
//
// Setup: Borrower, score, default-probability, and facility schemas with by-value updates.
//
// Beats:
//   1. Compute borrower leverage and debt-to-income coverage ratios.
//   2. Calculate loan-to-value and debt service coverage metrics on credit facilities.
//   3. Map numerical credit scores to categorical rating grades and investment grade status.

type BorrowerProfile = struct {
    borrower_id: String,
    annual_income: Float,
    total_debt: Float,
    monthly_debt_payments: Float,
    credit_history_months: Int,
    number_of_open_accounts: Int,
    number_of_late_payments: Int,
    number_of_derogatory_recs: Int,
    revolving_credit_utilization: Float,
    number_of_inquiries: Int,
    is_verified: Bool
};

type CreditScore = struct {
    score: Int,
    category: String,
    rating_grade: String,
    payment_history_subscore: Int,
    utilization_subscore: Int,
    history_length_subscore: Int,
    debt_to_income_subscore: Int,
    is_valid: Bool
};

type DefaultProbability = struct {
    probability_1y: Float,
    probability_cumulative: Float,
    exposure_at_default: Float,
    loss_given_default: Float,
    expected_loss: Float,
    rating_tier: Int,
    credit_spread_bps: Int,
    is_high_risk: Bool
};

type CreditFacility = struct {
    facility_id: String,
    borrower_id: String,
    principal_amount: Float,
    interest_rate: Float,
    tenor_months: Int,
    collateral_value: Float,
    loan_to_value: Float
};

type CreditRiskAssessment = struct {
    borrower_id: String,
    credit_score: CreditScore,
    default_prob: DefaultProbability,
    max_credit_limit: Float,
    recommended_interest_rate: Float,
    risk_weight_category: String,
    approval_status: Int
};

pub fn borrower_profile_new(
    borrower_id: String,
    annual_income: Float,
    total_debt: Float,
    monthly_debt_payments: Float,
    credit_history_months: Int,
    number_of_open_accounts: Int,
    number_of_late_payments: Int,
    number_of_derogatory_recs: Int,
    revolving_credit_utilization: Float,
    number_of_inquiries: Int,
    is_verified: Bool
) -> BorrowerProfile {
    return BorrowerProfile {
        borrower_id: borrower_id,
        annual_income: annual_income,
        total_debt: total_debt,
        monthly_debt_payments: monthly_debt_payments,
        credit_history_months: credit_history_months,
        number_of_open_accounts: number_of_open_accounts,
        number_of_late_payments: number_of_late_payments,
        number_of_derogatory_recs: number_of_derogatory_recs,
        revolving_credit_utilization: revolving_credit_utilization,
        number_of_inquiries: number_of_inquiries,
        is_verified: is_verified
    };
}

pub fn credit_facility_new(
    facility_id: String,
    borrower_id: String,
    principal_amount: Float,
    interest_rate: Float,
    tenor_months: Int,
    collateral_value: Float
) -> CreditFacility {
    let mut ltv: Float = 1.0;
    if collateral_value > 0.0 {
        ltv = principal_amount / collateral_value;
    }
    return CreditFacility {
        facility_id: facility_id,
        borrower_id: borrower_id,
        principal_amount: principal_amount,
        interest_rate: interest_rate,
        tenor_months: tenor_months,
        collateral_value: collateral_value,
        loan_to_value: ltv
    };
}

pub fn borrower_calculate_dti(prof: &BorrowerProfile) -> Float {
    let inc: Float = (prof).annual_income;
    if inc <= 0.0 {
        return 1.0;
    }
    let monthly: Float = (prof).monthly_debt_payments;
    let annual_payments: Float = monthly * 12.0;
    return annual_payments / inc;
}

pub fn borrower_calculate_leverage(prof: &BorrowerProfile) -> Float {
    let inc: Float = (prof).annual_income;
    if inc <= 0.0 {
        return 0.0;
    }
    return (prof).total_debt / inc;
}

pub fn credit_facility_calculate_ltv(fac: CreditFacility) -> Float {
    let col: Float = (fac).collateral_value;
    if col <= 0.0 {
        return 1.0;
    }
    return (fac).principal_amount / col;
}

pub fn credit_facility_calculate_dscr(net_operating_income: Float, annual_debt_service: Float) -> Float {
    if annual_debt_service <= 0.0 {
        return 0.0;
    }
    return net_operating_income / annual_debt_service;
}

pub fn credit_score_category_from_score(score_val: Int) -> String {
    if score_val >= 800 {
        return "EXCELLENT";
    }
    if score_val >= 740 {
        return "VERY_GOOD";
    }
    if score_val >= 670 {
        return "GOOD";
    }
    if score_val >= 580 {
        return "FAIR";
    }
    return "POOR";
}

pub fn credit_score_rating_grade_from_score(score_val: Int) -> String {
    if score_val >= 800 {
        return "AAA";
    }
    if score_val >= 750 {
        return "AA";
    }
    if score_val >= 700 {
        return "A";
    }
    if score_val >= 650 {
        return "BBB";
    }
    if score_val >= 600 {
        return "BB";
    }
    if score_val >= 550 {
        return "B";
    }
    return "CCC";
}

pub fn credit_score_is_investment_grade(cs: CreditScore) -> Bool {
    if (cs).score >= 650 {
        return true;
    }
    return false;
}

pub fn default_probability_is_acceptable(dp: DefaultProbability, max_pd: Float) -> Bool {
    if (dp).probability_1y <= max_pd {
        return true;
    }
    return false;
}

pub fn credit_facility_update_collateral(fac: CreditFacility, new_collateral_value: Float) -> CreditFacility {
    let mut ltv: Float = 1.0;
    if new_collateral_value > 0.0 {
        ltv = (fac).principal_amount / new_collateral_value;
    }
    return CreditFacility {
        facility_id: (fac).facility_id,
        borrower_id: (fac).borrower_id,
        principal_amount: (fac).principal_amount,
        interest_rate: (fac).interest_rate,
        tenor_months: (fac).tenor_months,
        collateral_value: new_collateral_value,
        loan_to_value: ltv
    };
}
