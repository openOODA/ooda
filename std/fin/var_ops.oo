// # Financial Value at Risk Operations
//
// Logline: Calculates statistical z-scores, horizon scaling factors, portfolio exposure, and risk capital limits.
//
// Setup: Portfolio value and VaR result data models with by-value updates.
//
// Beats:
//   1. Map confidence levels to normal distribution critical z-scores and horizon square-root factors.
//   2. Compute portfolio effective exposure, total PnL, and volatility adjustments.
//   3. Evaluate VaR limit breaches and compute regulatory risk capital multipliers.

type PortfolioValue = struct {
    total_value: Float,
    invested_capital: Float,
    unrealized_pnl: Float,
    realized_pnl: Float,
    leverage_ratio: Float,
    is_leveraged: Bool,
    daily_volatility: Float,
    annualized_volatility: Float
};

type VarResult = struct {
    var_amount: Float,
    var_percentage: Float,
    horizon_days: Int,
    is_breached: Bool
};

pub fn portfolio_value_new(
    total_value: Float,
    invested_capital: Float,
    unrealized_pnl: Float,
    realized_pnl: Float,
    leverage_ratio: Float,
    daily_volatility: Float
) -> PortfolioValue {
    let lev: Bool = leverage_ratio > 1.0;
    return PortfolioValue {
        total_value: total_value,
        invested_capital: invested_capital,
        unrealized_pnl: unrealized_pnl,
        realized_pnl: realized_pnl,
        leverage_ratio: leverage_ratio,
        is_leveraged: lev,
        daily_volatility: daily_volatility,
        annualized_volatility: daily_volatility * 15.874507866
    };
}

pub fn var_result_new(var_amount: Float, var_percentage: Float, horizon_days: Int) -> VarResult {
    return VarResult {
        var_amount: var_amount,
        var_percentage: var_percentage,
        horizon_days: horizon_days,
        is_breached: false
    };
}

pub fn z_score_for_confidence(confidence_level: Float) -> Float {
    if confidence_level >= 0.99 {
        return 2.326348;
    }
    if confidence_level >= 0.975 {
        return 1.959964;
    }
    if confidence_level >= 0.95 {
        return 1.6448536;
    }
    if confidence_level >= 0.90 {
        return 1.281552;
    }
    return 1.6448536;
}

pub fn time_horizon_sqrt_factor(days: Int) -> Float {
    if days <= 1 {
        return 1.0;
    }
    if days == 2 {
        return 1.41421356;
    }
    if days == 5 {
        return 2.23606798;
    }
    if days == 10 {
        return 3.16227766;
    }
    if days == 20 {
        return 4.47213595;
    }
    if days == 30 {
        return 5.47722557;
    }
    if days == 60 {
        return 7.74596669;
    }
    if days == 90 {
        return 9.48683298;
    }
    if days == 180 {
        return 13.41640786;
    }
    if days == 252 {
        return 15.87450787;
    }
    return 1.0;
}

pub fn portfolio_total_pnl(pv: PortfolioValue) -> Float {
    return pv.unrealized_pnl + pv.realized_pnl;
}

pub fn portfolio_return_on_capital(pv: PortfolioValue) -> Float {
    let invested: Float = pv.invested_capital;
    if invested <= 0.0 {
        return 0.0;
    }
    return portfolio_total_pnl(pv) / invested;
}

pub fn portfolio_effective_exposure(pv: PortfolioValue) -> Float {
    if pv.leverage_ratio <= 0.0 {
        return pv.total_value;
    }
    return pv.total_value * pv.leverage_ratio;
}

pub fn portfolio_update_volatility(pv: PortfolioValue, new_daily_vol: Float) -> PortfolioValue {
    if new_daily_vol < 0.0 {
        return pv;
    }
    return PortfolioValue {
        total_value: pv.total_value,
        invested_capital: pv.invested_capital,
        unrealized_pnl: pv.unrealized_pnl,
        realized_pnl: pv.realized_pnl,
        leverage_ratio: pv.leverage_ratio,
        is_leveraged: pv.is_leveraged,
        daily_volatility: new_daily_vol,
        annualized_volatility: new_daily_vol * 15.874507866
    };
}

pub fn portfolio_set_leverage(pv: PortfolioValue, ratio: Float) -> PortfolioValue {
    if ratio < 1.0 {
        return pv;
    }
    let lev: Bool = ratio > 1.0;
    return PortfolioValue {
        total_value: pv.total_value,
        invested_capital: pv.invested_capital,
        unrealized_pnl: pv.unrealized_pnl,
        realized_pnl: pv.realized_pnl,
        leverage_ratio: ratio,
        is_leveraged: lev,
        daily_volatility: pv.daily_volatility,
        annualized_volatility: pv.annualized_volatility
    };
}

pub fn var_check_limit(result: VarResult, max_allowed_var_pct: Float) -> Bool {
    if result.var_percentage <= max_allowed_var_pct {
        return true;
    }
    return false;
}

pub fn var_evaluate_breach(result: VarResult, actual_loss: Float) -> VarResult {
    let breached: Bool = actual_loss > result.var_amount;
    return VarResult {
        var_amount: result.var_amount,
        var_percentage: result.var_percentage,
        horizon_days: result.horizon_days,
        is_breached: breached
    };
}

pub fn var_calculate_risk_capital(result: VarResult, multiplier: Float) -> Float {
    if multiplier <= 0.0 {
        return result.var_amount * 3.0;
    }
    return result.var_amount * multiplier;
}
