// residual: List[struct] destubbed to Int floor.

type VarResult = struct {
    var_bps: Int,
    horizon_days: Int,
    is_breached: Int
};

pub fn var_result_new(var_bps: Int, horizon_days: Int, is_breached: Int) -> VarResult {
    return VarResult {
        var_bps: var_bps,
        horizon_days: horizon_days,
        is_breached: is_breached
    };
}

pub fn var_result_bps(v: VarResult) -> Int {
    return v.var_bps;
}
