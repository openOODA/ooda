// # Yield Curve String Helpers & Pure Discount Math
//
// Logline: Map compounding and curve type tags to strings; compute pure discount factor math.
//
// Setup: Imports yield_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. compounding_type_to_string: map 0..3 compounding tags to labels.
//   2. curve_type_to_string: map curve class to treasury, swap, OIS.
//   3. calculate_discount_factor_bps: derive factor from rate and tenor.
//   4. calculate_zero_rate_bps: invert discount factor to zero rate.
//
// residual: pure math only; no curve or boot state.

// RULES.oot 1.4 / 1.3: default-deny privileged effects; fail-closed residual.

import "./yield_types.oo";

pub fn compounding_type_to_string(comp_type: Int) -> String {
    if comp_type == 0 {
        return "ANNUAL";
    }
    if comp_type == 1 {
        return "SEMI_ANNUAL";
    }
    if comp_type == 2 {
        return "CONTINUOUS";
    }
    if comp_type == 3 {
        return "SIMPLE";
    }
    return "UNKNOWN";
}

pub fn curve_type_to_string(c_type: Int) -> String {
    if c_type == 0 {
        return "TREASURY";
    }
    if c_type == 1 {
        return "SOFR_SWAP";
    }
    if c_type == 2 {
        return "LIBOR_SWAP";
    }
    if c_type == 3 {
        return "CORPORATE_AAA";
    }
    if c_type == 4 {
        return "ZERO_COUPON";
    }
    return "UNKNOWN";
}

// -------------------------------------------------------------------
// Pure Financial & Mathematical Helper Calculations
// -------------------------------------------------------------------

pub fn calculate_discount_factor_bps(tenor_months: Int, rate_bps: Int, comp_type: Int) -> Int {
    if tenor_months <= 0 {
        return 10000;
    }
    if rate_bps <= 0 {
        return 10000;
    }

    if comp_type == 3 {
        // SIMPLE compounding: DF = 10000 / (1 + r * T / 12)
        // Scaled: DF = 1200000000 / (120000 + rate_bps * tenor_months)
        let denom: Int = 120000 + (rate_bps * tenor_months);
        let df: Int = 120000000 / denom; // Scaled to 10000 base
        return df;
    }

    if comp_type == 2 {
        // CONTINUOUS compounding: Taylor approximation DF = 10000 * (1 - r*T/120000 + (r*T)^2 / (2 * 120000^2))
        let rt: Int = (rate_bps * tenor_months) / 12; // r * T_years in bps
        let term1: Int = 10000;
        let term2: Int = rt;
        let term3: Int = (rt * rt) / 20000;
        let df_calc: Int = (term1 - term2) + term3;
        if df_calc < 0 {
            return 0;
        }
        return df_calc;
    }

    // Default ANNUAL / SEMI_ANNUAL compounding:
    // DF = 10000 / (1 + r/10000)^(T/12) ~ 100000000 / (10000 + rate_bps * tenor_months / 12)
    let rt_ann: Int = (rate_bps * tenor_months) / 12;
    let denom_ann: Int = 10000 + rt_ann;
    let df_ann: Int = 100000000 / denom_ann;
    return df_ann;
}

pub fn calculate_zero_rate_from_df(tenor_months: Int, factor_bps: Int) -> Int {
    if tenor_months <= 0 {
        return 0;
    }
    if factor_bps >= 10000 {
        return 0;
    }
    if factor_bps <= 0 {
        return 10000; // Cap at 100% (10000 bps)
    }

    // Zero rate r_bps = (10000 - factor_bps) * 120000 / (factor_bps * tenor_months)
    let diff: Int = 10000 - factor_bps;
    let num: Int = diff * 120000;
    let denom: Int = factor_bps * tenor_months;
    let rate: Int = num / denom;
    return rate;
}

pub fn interpolate_linear_rate(tenor1: Int, rate1: Int, tenor2: Int, rate2: Int, target_tenor: Int) -> Int {
    if target_tenor <= tenor1 {
        return rate1;
    }
    if target_tenor >= tenor2 {
        return rate2;
    }
    let tenor_diff: Int = tenor2 - tenor1;
    if tenor_diff <= 0 {
        return rate1;
    }

    let rate_diff: Int = rate2 - rate1;
    let target_diff: Int = target_tenor - tenor1;
    let interpolated: Int = rate1 + ((rate_diff * target_diff) / tenor_diff);
    return interpolated;
}
