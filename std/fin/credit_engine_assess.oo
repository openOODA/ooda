// # Credit Risk Engine Borrower Assessment
//
// Logline: Combine the credit score and default probability into a holistic borrower risk assessment with approval status.
//
// Setup: Imports credit_ops.oo for types and credit_engine_compute.oo for score and probability functions.
//
// Beats:
//   1. Compute the maximum credit limit and recommended interest rate.
//   2. Map the score, DTI, and PD into a discrete approval status.
//   3. Produce the final CreditRiskAssessment with risk weight category.

import "./credit_engine_compute.oo";

pub fn assess_borrower_credit(
    prof: &BorrowerProfile,
    fac: &CreditFacility
) -> CreditRiskAssessment {
    let cs: CreditScore = compute_credit_score(prof);
    let dp: DefaultProbability = compute_default_probability(&cs, prof, fac);

    let mut max_limit: Float = (prof).annual_income * 0.40;
    let sc_val: Int = (cs).score;
    if sc_val >= 750 {
        max_limit = (prof).annual_income * 0.60;
    } else if sc_val < 600 {
        max_limit = (prof).annual_income * 0.15;
    }

    let spread_float: Float = int_to_float((dp).credit_spread_bps) / 10000.0;
    let rec_rate: Float = 0.045 + spread_float;

    let mut status: Int = 0; // 0 = REJECTED
    let dti: Float = borrower_calculate_dti(prof);
    let pd_val: Float = (dp).probability_1y;

    if sc_val >= 650 {
        if dti <= 0.45 {
            if pd_val <= 0.10 {
                status = 1; // APPROVED
            } else {
                status = 2; // MANUAL_REVIEW
            }
        } else {
            status = 2; // MANUAL_REVIEW
        }
    } else if sc_val >= 580 {
        status = 2; // MANUAL_REVIEW
    } else {
        status = 0; // REJECTED
    }

    let mut risk_cat: String = "STANDARD";
    if (dp).is_high_risk {
        risk_cat = "HIGH_RISK";
    } else if sc_val >= 750 {
        risk_cat = "LOW_RISK";
    }

    return CreditRiskAssessment {
        borrower_id: (prof).borrower_id,
        credit_score: cs,
        default_prob: dp,
        max_credit_limit: max_limit,
        recommended_interest_rate: rec_rate,
        risk_weight_category: risk_cat,
        approval_status: status
    };
}
