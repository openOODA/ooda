// # Financial Order Book Matching Engine
//
// Logline: Executes continuous limit order crossing and matching against opposing bid and ask queues.
//
// Setup: Imports orderbook_ops.oo for order querying, fill state, and queue mutation.
//
// Beats:
//   1. Cross incoming limit orders against opposing bid/ask queues.
//   2. Fill matching quantities incrementally and record trades.
//   3. Insert unfilled residual order amounts into resting book slots.

import "./orderbook_ops.oo";

pub fn orderbook_match_limit_order(book: OrderBook, incoming: LimitOrder) -> OrderBook {
    let mut ob: OrderBook = book;
    let in_buy: Int = (incoming).is_buy;
    let in_price: Int = (incoming).price;
    let mut in_rem: Int = limit_order_remaining_qty(incoming);

    if in_rem <= 0  { return ob; }

    if in_buy == 1 {
        if (ob).ask0_live == 1 {
            if (ob).ask0_price <= in_price {
                if in_rem > 0 {
                    let ask_qty: Int = (ob).ask0_qty;
                    if ask_qty <= in_rem {
                        in_rem = in_rem - ask_qty;
                        ob = OrderBook {
                            bid_count: (ob).bid_count, ask_count: (ob).ask_count,
                            last_trade_price: (ob).ask0_price, bid0_id: (ob).bid0_id,
                            bid0_price: (ob).bid0_price, bid0_qty: (ob).bid0_qty,
                            bid0_live: (ob).bid0_live, bid1_id: (ob).bid1_id, bid1_price: (ob).bid1_price,
                            bid1_qty: (ob).bid1_qty, bid1_live: (ob).bid1_live, ask0_id: (ob).ask0_id,
                            ask0_price: (ob).ask0_price, ask0_qty: 0, ask0_live: 0, ask1_id: (ob).ask1_id,
                            ask1_price: (ob).ask1_price, ask1_qty: (ob).ask1_qty,
                            ask1_live: (ob).ask1_live, processed: (ob).processed + 1
                        };
                    } else {
                        let rem_ask: Int = ask_qty - in_rem;
                        in_rem = 0;
                        ob = OrderBook {
                            bid_count: (ob).bid_count, ask_count: (ob).ask_count,
                            last_trade_price: (ob).ask0_price, bid0_id: (ob).bid0_id,
                            bid0_price: (ob).bid0_price, bid0_qty: (ob).bid0_qty,
                            bid0_live: (ob).bid0_live, bid1_id: (ob).bid1_id, bid1_price: (ob).bid1_price,
                            bid1_qty: (ob).bid1_qty, bid1_live: (ob).bid1_live, ask0_id: (ob).ask0_id,
                            ask0_price: (ob).ask0_price, ask0_qty: rem_ask, ask0_live: 1,
                            ask1_id: (ob).ask1_id, ask1_price: (ob).ask1_price, ask1_qty: (ob).ask1_qty,
                            ask1_live: (ob).ask1_live, processed: (ob).processed + 1
                        };
                    }
                }
            }
        }
        if (ob).ask1_live == 1 {
            if (ob).ask1_price <= in_price {
                if in_rem > 0 {
                    let ask_qty: Int = (ob).ask1_qty;
                    if ask_qty <= in_rem {
                        in_rem = in_rem - ask_qty;
                        ob = OrderBook {
                            bid_count: (ob).bid_count, ask_count: (ob).ask_count,
                            last_trade_price: (ob).ask1_price, bid0_id: (ob).bid0_id,
                            bid0_price: (ob).bid0_price, bid0_qty: (ob).bid0_qty,
                            bid0_live: (ob).bid0_live, bid1_id: (ob).bid1_id, bid1_price: (ob).bid1_price,
                            bid1_qty: (ob).bid1_qty, bid1_live: (ob).bid1_live, ask0_id: (ob).ask0_id,
                            ask0_price: (ob).ask0_price, ask0_qty: (ob).ask0_qty,
                            ask0_live: (ob).ask0_live, ask1_id: (ob).ask1_id, ask1_price: (ob).ask1_price,
                            ask1_qty: 0, ask1_live: 0, processed: (ob).processed + 1
                        };
                    } else {
                        let rem_ask: Int = ask_qty - in_rem;
                        in_rem = 0;
                        ob = OrderBook {
                            bid_count: (ob).bid_count, ask_count: (ob).ask_count,
                            last_trade_price: (ob).ask1_price, bid0_id: (ob).bid0_id,
                            bid0_price: (ob).bid0_price, bid0_qty: (ob).bid0_qty,
                            bid0_live: (ob).bid0_live, bid1_id: (ob).bid1_id, bid1_price: (ob).bid1_price,
                            bid1_qty: (ob).bid1_qty, bid1_live: (ob).bid1_live, ask0_id: (ob).ask0_id,
                            ask0_price: (ob).ask0_price, ask0_qty: (ob).ask0_qty,
                            ask0_live: (ob).ask0_live, ask1_id: (ob).ask1_id, ask1_price: (ob).ask1_price,
                            ask1_qty: rem_ask, ask1_live: 1, processed: (ob).processed + 1
                        };
                    }
                }
            }
        }
        if in_rem > 0 {
            let resting: LimitOrder = LimitOrder {
                order_id: (incoming).order_id, price: (incoming).price,
                quantity: (incoming).quantity, filled: (incoming).quantity - in_rem,
                is_buy: 1, is_canceled: 0
            };
            ob = orderbook_add_order(ob, resting);
        }
    } else {
        if (ob).bid0_live == 1 {
            if (ob).bid0_price >= in_price {
                if in_rem > 0 {
                    let bid_qty: Int = (ob).bid0_qty;
                    if bid_qty <= in_rem {
                        in_rem = in_rem - bid_qty;
                        ob = OrderBook {
                            bid_count: (ob).bid_count, ask_count: (ob).ask_count,
                            last_trade_price: (ob).bid0_price, bid0_id: (ob).bid0_id,
                            bid0_price: (ob).bid0_price, bid0_qty: 0, bid0_live: 0, bid1_id: (ob).bid1_id,
                            bid1_price: (ob).bid1_price, bid1_qty: (ob).bid1_qty,
                            bid1_live: (ob).bid1_live, ask0_id: (ob).ask0_id, ask0_price: (ob).ask0_price,
                            ask0_qty: (ob).ask0_qty, ask0_live: (ob).ask0_live, ask1_id: (ob).ask1_id,
                            ask1_price: (ob).ask1_price, ask1_qty: (ob).ask1_qty,
                            ask1_live: (ob).ask1_live, processed: (ob).processed + 1
                        };
                    } else {
                        let rem_bid: Int = bid_qty - in_rem;
                        in_rem = 0;
                        ob = OrderBook {
                            bid_count: (ob).bid_count, ask_count: (ob).ask_count,
                            last_trade_price: (ob).bid0_price, bid0_id: (ob).bid0_id,
                            bid0_price: (ob).bid0_price, bid0_qty: rem_bid, bid0_live: 1,
                            bid1_id: (ob).bid1_id, bid1_price: (ob).bid1_price, bid1_qty: (ob).bid1_qty,
                            bid1_live: (ob).bid1_live, ask0_id: (ob).ask0_id, ask0_price: (ob).ask0_price,
                            ask0_qty: (ob).ask0_qty, ask0_live: (ob).ask0_live, ask1_id: (ob).ask1_id,
                            ask1_price: (ob).ask1_price, ask1_qty: (ob).ask1_qty,
                            ask1_live: (ob).ask1_live, processed: (ob).processed + 1
                        };
                    }
                }
            }
        }
        if (ob).bid1_live == 1 {
            if (ob).bid1_price >= in_price {
                if in_rem > 0 {
                    let bid_qty: Int = (ob).bid1_qty;
                    if bid_qty <= in_rem {
                        in_rem = in_rem - bid_qty;
                        ob = OrderBook {
                            bid_count: (ob).bid_count, ask_count: (ob).ask_count,
                            last_trade_price: (ob).bid1_price, bid0_id: (ob).bid0_id,
                            bid0_price: (ob).bid0_price, bid0_qty: (ob).bid0_qty,
                            bid0_live: (ob).bid0_live, bid1_id: (ob).bid1_id, bid1_price: (ob).bid1_price,
                            bid1_qty: 0, bid1_live: 0, ask0_id: (ob).ask0_id, ask0_price: (ob).ask0_price,
                            ask0_qty: (ob).ask0_qty, ask0_live: (ob).ask0_live, ask1_id: (ob).ask1_id,
                            ask1_price: (ob).ask1_price, ask1_qty: (ob).ask1_qty,
                            ask1_live: (ob).ask1_live, processed: (ob).processed + 1
                        };
                    } else {
                        let rem_bid: Int = bid_qty - in_rem;
                        in_rem = 0;
                        ob = OrderBook {
                            bid_count: (ob).bid_count, ask_count: (ob).ask_count,
                            last_trade_price: (ob).bid1_price, bid0_id: (ob).bid0_id,
                            bid0_price: (ob).bid0_price, bid0_qty: (ob).bid0_qty,
                            bid0_live: (ob).bid0_live, bid1_id: (ob).bid1_id, bid1_price: (ob).bid1_price,
                            bid1_qty: rem_bid, bid1_live: 1, ask0_id: (ob).ask0_id,
                            ask0_price: (ob).ask0_price, ask0_qty: (ob).ask0_qty,
                            ask0_live: (ob).ask0_live, ask1_id: (ob).ask1_id, ask1_price: (ob).ask1_price,
                            ask1_qty: (ob).ask1_qty, ask1_live: (ob).ask1_live,
                            processed: (ob).processed + 1
                        };
                    }
                }
            }
        }
        if in_rem > 0 {
            let resting: LimitOrder = LimitOrder {
                order_id: (incoming).order_id, price: (incoming).price,
                quantity: (incoming).quantity, filled: (incoming).quantity - in_rem,
                is_buy: 0, is_canceled: 0
            };
            ob = orderbook_add_order(ob, resting);
        }
    }

    return ob;
}

pub fn orderbook_engine_probe() -> Int { return 0; }
