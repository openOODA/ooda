// # Financial Order Book Matching Engine
//
// Logline: Executes continuous limit order crossing and matching against opposing bid and ask queues.
//
// Setup: Imports orderbook_ops.oo for order querying, fill state, and queue mutation.
//
// Beats:
//   1. Traverse opposing order queue to locate crossing prices for incoming orders.
//   2. Fill matching quantities incrementally and generate MatchResult records.
//   3. Insert unfilled residual order amounts into the appropriate resting book queue.

import "./orderbook_ops.oo";

pub fn orderbook_match_order(book: &mut OrderBook, incoming: LimitOrder, timestamp: Int) -> List[MatchResult] {
    let mut matches: List[MatchResult] = list_new();
    let mut rem_incoming = limit_order_remaining_qty(&incoming);
    if rem_incoming <= 0 {
        return matches;
    }

    let mut inc_order: LimitOrder = incoming;
    let inc_price: Int = inc_order.price;

    if inc_order.is_buy {
        let mut new_asks: List[LimitOrder] = list_new();
        let n_asks = list_len((book).asks);
        let mut i = 0;

        while i < n_asks {
            let mut ask_order: LimitOrder = list_get((book).asks, i);
            let ask_rem = limit_order_remaining_qty(&ask_order);

            if ask_order.is_canceled == false {
                if ask_rem > 0 {
                    if rem_incoming > 0 {
                        let ask_price: Int = ask_order.price;
                        if ask_price <= inc_price {
                            let mut fill_qty = rem_incoming;
                            if ask_rem < fill_qty {
                                fill_qty = ask_rem;
                            }

                            ask_order.filled_quantity = ask_order.filled_quantity + fill_qty;
                            inc_order.filled_quantity = inc_order.filled_quantity + fill_qty;
                            rem_incoming = rem_incoming - fill_qty;

                            let fully_filled = limit_order_is_filled(&inc_order);
                            let match_rec = match_result_create(
                                (book).next_match_id,
                                inc_order.order_id,
                                ask_order.order_id,
                                ask_price,
                                fill_qty,
                                timestamp,
                                fully_filled
                            );

                            (book).next_match_id = (book).next_match_id + 1;
                            (book).total_volume_traded = (book).total_volume_traded + fill_qty;
                            (book).last_trade_price = ask_price;
                            matches = list_push(matches, match_rec);
                        }
                    }
                }
            }
            new_asks = list_push(new_asks, ask_order);
            i = i + 1;
        }

        (book).asks = new_asks;

        if limit_order_is_filled(&inc_order) == false {
            if inc_order.is_canceled == false {
                (book).bids = list_push((book).bids, inc_order);
            }
        }
    } else {
        let mut new_bids: List[LimitOrder] = list_new();
        let n_bids = list_len((book).bids);
        let mut j = 0;

        while j < n_bids {
            let mut bid_order: LimitOrder = list_get((book).bids, j);
            let bid_rem = limit_order_remaining_qty(&bid_order);

            if bid_order.is_canceled == false {
                if bid_rem > 0 {
                    if rem_incoming > 0 {
                        let bid_price: Int = bid_order.price;
                        if bid_price >= inc_price {
                            let mut fill_qty = rem_incoming;
                            if bid_rem < fill_qty {
                                fill_qty = bid_rem;
                            }

                            bid_order.filled_quantity = bid_order.filled_quantity + fill_qty;
                            inc_order.filled_quantity = inc_order.filled_quantity + fill_qty;
                            rem_incoming = rem_incoming - fill_qty;

                            let fully_filled = limit_order_is_filled(&inc_order);
                            let match_rec = match_result_create(
                                (book).next_match_id,
                                bid_order.order_id,
                                inc_order.order_id,
                                bid_price,
                                fill_qty,
                                timestamp,
                                fully_filled
                            );

                            (book).next_match_id = (book).next_match_id + 1;
                            (book).total_volume_traded = (book).total_volume_traded + fill_qty;
                            (book).last_trade_price = bid_price;
                            matches = list_push(matches, match_rec);
                        }
                    }
                }
            }
            new_bids = list_push(new_bids, bid_order);
            j = j + 1;
        }

        (book).bids = new_bids;

        if limit_order_is_filled(&inc_order) == false {
            if inc_order.is_canceled == false {
                (book).asks = list_push((book).asks, inc_order);
            }
        }
    }

    (book).total_orders_processed = (book).total_orders_processed + 1;
    return matches;
}
