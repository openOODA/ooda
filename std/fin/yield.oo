// # Yield Curve Re-export Shim
//
// Logline: Re-export shim for yield curve submodules; forwards compounding, curve, discount, and engine constructors.
//
// Setup: Imports yield_types, yield_ops, yield_curve, yield_engine, and yield_stubs. CWD must be ooda/.
//
// Beats:
//   1. shim_marker_comp_string: forward compounding_type_to_string.
//   2. shim_marker_curve_string: forward curve_type_to_string.
//   3. shim_marker_df_create: forward discount_factor_create.
//   4. shim_marker_curve_init: forward yield_curve_init.
//   5. shim_marker_interpolate: forward yield_curve_interpolate_rate.
//
// residual: by-value destub; shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648.

// Original ~738-line yield.oo split at functional seams into
// yield_types / yield_ops / yield_curve / yield_engine / yield_stubs
// (each ≤256 lines). This shim re-exports public names so existing
// callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./yield_types.oo";
import "./yield_ops.oo";
import "./yield_curve.oo";
import "./yield_engine.oo";
import "./yield_stubs.oo";

pub fn shim_marker_comp_string() -> String {
    return compounding_type_to_string(0);
}

pub fn shim_marker_curve_string() -> String {
    return curve_type_to_string(0);
}

pub fn shim_marker_df_create() -> DiscountFactor {
    return discount_factor_create(12, 500, 0);
}

pub fn shim_marker_df_valid(df: &DiscountFactor) -> Bool {
    return discount_factor_is_valid(df);
}

pub fn shim_marker_swap_create() -> SwapRate {
    return swap_rate_create("SOFR_2Y", 24, 450, 2, 4);
}

pub fn shim_marker_curve_create() -> YieldCurve {
    return yield_curve_create("US_TREASURY", 0, 20260811, 0);
}

pub fn shim_marker_point_create() -> YieldCurvePoint {
    return yield_curve_point_create(12, 400, 0);
}

pub fn shim_marker_interp_linear() -> Int {
    return interpolate_linear_rate(12, 400, 24, 450, 18);
}
