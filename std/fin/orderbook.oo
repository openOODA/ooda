// # Financial Order Book Facade
//
// Logline: Re-exports limit order structures, order book state, matching engine logic, and low-level protocol stubs.
//
// Setup: Pure module shim importing types, operations, matching engine, and stubs submodules.
//
// Beats:
//   1. Import order book types, ops, engine, and stubs companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Retain backwards-compatible API surface for financial order book consumers.

import "./orderbook_types.oo";
import "./orderbook_ops.oo";
import "./orderbook_engine.oo";
import "./orderbook_stubs.oo";

pub fn shim_marker_order_create() -> LimitOrder {
    return limit_order_create(1, "TRADER1", "AAPL", 15000, 100, true, 1000);
}

pub fn shim_marker_orderbook_init() -> OrderBook {
    return orderbook_init("AAPL");
}

pub fn shim_marker_add_order(book: &mut OrderBook, order: LimitOrder) {
    orderbook_add_order(book, order);
}

pub fn shim_marker_cancel_order(book: &mut OrderBook) -> Bool {
    return orderbook_cancel_order(book, 1);
}

pub fn shim_marker_best_bid(book: &OrderBook) -> Int {
    return orderbook_get_best_bid(book);
}

pub fn shim_marker_best_ask(book: &OrderBook) -> Int {
    return orderbook_get_best_ask(book);
}

pub fn shim_marker_spread(book: &OrderBook) -> Int {
    return orderbook_get_spread(book);
}

pub fn shim_marker_mid_price(book: &OrderBook) -> Int {
    return orderbook_get_mid_price(book);
}

pub fn shim_marker_level_depth(book: &OrderBook) -> OrderBookLevel {
    return orderbook_get_level_depth(book, 15000, true);
}

pub fn shim_marker_match_order(book: &mut OrderBook, incoming: LimitOrder) -> List[MatchResult] {
    return orderbook_match_order(book, incoming, 1001);
}
