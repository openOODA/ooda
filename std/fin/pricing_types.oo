// # Pricing types
//
// Logline: OptionContract destubbed off pub type Float Greeks.
// residual: List[struct] destubbed to Int floor.

type OptionContract = struct {
    is_call: Int,
    strike: Int,
    spot: Int
};

pub fn option_contract_new(is_call: Int, strike: Int, spot: Int) -> OptionContract {
    return OptionContract {
        is_call: is_call,
        strike: strike,
        spot: spot
    };
}

pub fn option_contract_strike(c: OptionContract) -> Int {
    return c.strike;
}
