// # AML types
//
// Logline: AmlRisk destubbed off pub type String TransactionNode.
// residual: List[struct] destubbed to Int floor.

type AmlRisk = struct {
    entity_id: Int,
    final_score: Int,
    requires_sar: Int
};

pub fn aml_risk_new(entity_id: Int, final_score: Int, requires_sar: Int) -> AmlRisk {
    return AmlRisk {
        entity_id: entity_id,
        final_score: final_score,
        requires_sar: requires_sar
    };
}

pub fn aml_risk_score(r: AmlRisk) -> Int {
    return r.final_score;
}
