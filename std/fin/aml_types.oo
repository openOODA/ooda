// # AML types
//
// Logline: Data structures and constructors for transactions, risk scoring, pattern rules, and compliance profiles.
//
// Setup: Pure data structures for financial compliance and AML transaction monitoring.
//
// Beats:
//   1. Define transaction nodes, risk scores, and pattern rules.
//   2. Define sanctions entities, AML alerts, and compliance profiles.
//   3. Retain AmlRisk compatibility constructor.

type AmlRisk = struct {
    entity_id: Int,
    final_score: Int,
    requires_sar: Int
};

pub fn aml_risk_new(entity_id: Int, final_score: Int, requires_sar: Int) -> AmlRisk {
    return AmlRisk {
        entity_id: entity_id,
        final_score: final_score,
        requires_sar: requires_sar
    };
}

pub fn aml_risk_score(r: AmlRisk) -> Int {
    return (r).final_score;
}

type TransactionNode = struct {
    tx_id: String,
    sender: String,
    receiver: String,
    amount: Int,
    timestamp: Int,
    tx_type: String,
    country_code: String,
    is_flagged: Bool
};

pub fn transaction_node_new(tx_id: String, sender: String, receiver: String, amount: Int, timestamp: Int, tx_type: String, country_code: String, is_flagged: Bool) -> TransactionNode {
    return TransactionNode {
        tx_id: tx_id,
        sender: sender,
        receiver: receiver,
        amount: amount,
        timestamp: timestamp,
        tx_type: tx_type,
        country_code: country_code,
        is_flagged: is_flagged
    };
}

type RiskScore = struct {
    entity_id: String,
    base_score: Int,
    structuring_score: Int,
    jurisdiction_risk: Int,
    velocity_risk: Int,
    final_score: Int,
    risk_level: String,
    requires_sar: Bool
};

pub fn risk_score_new(entity_id: String, base_score: Int, structuring_score: Int, jurisdiction_risk: Int, velocity_risk: Int) -> RiskScore {
    let mut total: Int = base_score + structuring_score + jurisdiction_risk + velocity_risk;
    if total > 100 {
        total = 100;
    }
    let lvl: String = if total >= 80 { "CRITICAL" } else { if total >= 60 { "HIGH" } else { if total >= 30 { "MEDIUM" } else { "LOW" } } };
    let req: Bool = total >= 80;
    return RiskScore {
        entity_id: entity_id,
        base_score: base_score,
        structuring_score: structuring_score,
        jurisdiction_risk: jurisdiction_risk,
        velocity_risk: velocity_risk,
        final_score: total,
        risk_level: lvl,
        requires_sar: req
    };
}

type PatternRule = struct {
    rule_id: String,
    rule_name: String,
    threshold_amount: Int,
    window_seconds: Int,
    max_tx_count: Int,
    risk_weight: Int,
    is_enabled: Bool
};

pub fn pattern_rule_new(rule_id: String, rule_name: String, threshold_amount: Int, window_seconds: Int, max_tx_count: Int, risk_weight: Int, is_enabled: Bool) -> PatternRule {
    return PatternRule {
        rule_id: rule_id,
        rule_name: rule_name,
        threshold_amount: threshold_amount,
        window_seconds: window_seconds,
        max_tx_count: max_tx_count,
        risk_weight: risk_weight,
        is_enabled: is_enabled
    };
}

type SanctionEntity = struct {
    entity_id: String,
    entity_name: String,
    country: String,
    risk_category: String,
    is_active: Bool
};

pub fn sanction_entity_new(entity_id: String, entity_name: String, country: String, risk_category: String, is_active: Bool) -> SanctionEntity {
    return SanctionEntity {
        entity_id: entity_id,
        entity_name: entity_name,
        country: country,
        risk_category: risk_category,
        is_active: is_active
    };
}

type AMLAlert = struct {
    alert_id: String,
    rule_id: String,
    entity_id: String,
    severity: String,
    reason: String,
    timestamp: Int
};

pub fn aml_alert_new(alert_id: String, rule_id: String, entity_id: String, severity: String, reason: String, timestamp: Int) -> AMLAlert {
    return AMLAlert {
        alert_id: alert_id,
        rule_id: rule_id,
        entity_id: entity_id,
        severity: severity,
        reason: reason,
        timestamp: timestamp
    };
}

type ComplianceProfile = struct {
    entity_id: String,
    kyc_verified: Bool,
    risk_rating: String,
    pep_status: Bool,
    total_volume: Int,
    flagged_count: Int
};

pub fn compliance_profile_new(entity_id: String, kyc_verified: Bool, pep_status: Bool) -> ComplianceProfile {
    return ComplianceProfile {
        entity_id: entity_id,
        kyc_verified: kyc_verified,
        risk_rating: "LOW",
        pep_status: pep_status,
        total_volume: 0,
        flagged_count: 0
    };
}
