// # AML Pure Risk Assessment & Pattern Evaluation
//
// Logline: Score risk, classify levels, and detect structuring / velocity / geographic patterns.
//
// Setup: Imports aml_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. aml_risk_init: bind entity_id, final_score, and sar flag.
//   2. aml_classify_risk_level: map score to LOW/MEDIUM/HIGH/CRITICAL.
//   3. aml_check_structuring_pattern: detect sub-threshold splits.
//   4. aml_check_velocity: scan time-window tx count.
//
// residual: ML / graph detection are process_exit in aml_stubs.

import "./aml_types.oo";

pub fn aml_risk_init(entity_id: Int, final_score: Int, requires_sar: Int) -> AmlRisk {
    return aml_risk_new(entity_id, final_score, requires_sar);
}

pub fn aml_classify_risk_level(score: Int) -> String {
    if score >= 80 {
        return "CRITICAL";
    }
    if score >= 60 {
        return "HIGH";
    }
    if score >= 30 {
        return "MEDIUM";
    }
    return "LOW";
}

pub fn aml_check_structuring_pattern(amount: Int, reporting_threshold: Int) -> Bool {
    if reporting_threshold <= 0 {
        return false;
    }
    let lower_bound: Int = reporting_threshold - (reporting_threshold / 10);
    if amount >= lower_bound {
        if amount < reporting_threshold {
            return true;
        }
    }
    return false;
}

pub fn aml_check_jurisdiction_risk(country_code: String) -> Int {
    if country_code == "IR" {
        return 50;
    }
    if country_code == "KP" {
        return 50;
    }
    if country_code == "RU" {
        return 40;
    }
    if country_code == "KY" {
        return 30;
    }
    if country_code == "PA" {
        return 30;
    }
    if country_code == "VG" {
        return 25;
    }
    return 0;
}

pub fn aml_calculate_velocity_risk(tx_count: Int, window_seconds: Int) -> Int {
    if window_seconds <= 0 {
        return 0;
    }
    let rate: Int = (tx_count * 3600) / window_seconds;
    if rate > 100 {
        return 40;
    }
    if rate > 50 {
        return 25;
    }
    if rate > 20 {
        return 10;
    }
    return 0;
}

pub fn aml_evaluate_risk_score(
    entity_id: String,
    base_score: Int,
    structuring_score: Int,
    jurisdiction_risk: Int,
    velocity_risk: Int
) -> RiskScore {
    return risk_score_new(entity_id, base_score, structuring_score, jurisdiction_risk, velocity_risk);
}

pub fn aml_evaluate_transaction_rule(tx: TransactionNode, rule: PatternRule) -> Bool {
    let enabled: Bool = (rule).is_enabled;
    if !enabled {
        return false;
    }
    let amt: Int = (tx).amount;
    let thresh: Int = (rule).threshold_amount;
    if amt >= thresh {
        return true;
    }
    let flagged: Bool = (tx).is_flagged;
    if flagged {
        return true;
    }
    return false;
}

pub fn aml_check_sanction_match(entity_name: String, sanction_name: String) -> Bool {
    if entity_name == "" {
        return false;
    }
    if sanction_name == "" {
        return false;
    }
    if entity_name == sanction_name {
        return true;
    }
    return false;
}
