// # Order Book Limit Order Match Entry
//
// Logline: Dispatch a limit order to the buy-side or sell-side match sibling based on direction.
//
// Setup: Imports orderbook_ops.oo and the buy/sell match siblings.
//
// Beats:
//   1. Inspect the buy flag and dispatch to the buy or sell match sibling.

import "./orderbook_engine_match_buy.oo";
import "./orderbook_engine_match_sell.oo";

pub fn orderbook_match_limit_order(book: OrderBook, incoming: LimitOrder) -> OrderBook {
    let in_buy: Int = (incoming).is_buy;
    if in_buy == 1 {
        return orderbook_match_buy(book, incoming);
    }
    return orderbook_match_sell(book, incoming);
}
