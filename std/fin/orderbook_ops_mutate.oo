// # Order Book Add and Cancel Mutators
//
// Logline: Add a live limit order to the next free bid or ask slot, and cancel by order_id across all four slots.
//
// Setup: Imports orderbook_types.oo and orderbook_ops_query for remaining_qty helper.
//
// Beats:
//   1. orderbook_add_order: slot into bid0/bid1 or ask0/ask1 and bump bid/ask_count.
//   2. orderbook_cancel_order: zero the matching slot's live flag.
//
// residual: List[struct] destubbed to fixed Int slots.

import "./orderbook_types.oo";
import "./orderbook_ops_query.oo";

pub fn orderbook_add_order(book: OrderBook, order: LimitOrder) -> OrderBook {
    let oid: Int = (order).order_id;
    let px: Int = (order).price;
    let qty: Int = (order).quantity;
    let rem: Int = limit_order_remaining_qty(order);
    let mut live: Int = 0;
    if (order).is_canceled == 0 {
        if rem > 0 {
            live = 1;
        }
    }
    if (order).is_buy == 1 {
        let mut bid0_id: Int = (book).bid0_id;
        let mut bid0_price: Int = (book).bid0_price;
        let mut bid0_qty: Int = (book).bid0_qty;
        let mut bid0_live: Int = (book).bid0_live;
        let mut bid1_id: Int = (book).bid1_id;
        let mut bid1_price: Int = (book).bid1_price;
        let mut bid1_qty: Int = (book).bid1_qty;
        let mut bid1_live: Int = (book).bid1_live;
        if bid0_live == 0 {
            bid0_id = oid;
            bid0_price = px;
            bid0_qty = rem;
            bid0_live = live;
        } else {
            if bid1_live == 0 {
                bid1_id = oid;
                bid1_price = px;
                bid1_qty = rem;
                bid1_live = live;
            } else {
                bid1_id = oid;
                bid1_price = px;
                bid1_qty = rem;
                bid1_live = live;
            }
        }
        return OrderBook {
            bid_count: (book).bid_count + 1,
            ask_count: (book).ask_count,
            last_trade_price: (book).last_trade_price,
            bid0_id: bid0_id,
            bid0_price: bid0_price,
            bid0_qty: bid0_qty,
            bid0_live: bid0_live,
            bid1_id: bid1_id,
            bid1_price: bid1_price,
            bid1_qty: bid1_qty,
            bid1_live: bid1_live,
            ask0_id: (book).ask0_id,
            ask0_price: (book).ask0_price,
            ask0_qty: (book).ask0_qty,
            ask0_live: (book).ask0_live,
            ask1_id: (book).ask1_id,
            ask1_price: (book).ask1_price,
            ask1_qty: (book).ask1_qty,
            ask1_live: (book).ask1_live,
            processed: (book).processed + 1
        };
    }
    let mut ask0_id: Int = (book).ask0_id;
    let mut ask0_price: Int = (book).ask0_price;
    let mut ask0_qty: Int = (book).ask0_qty;
    let mut ask0_live: Int = (book).ask0_live;
    let mut ask1_id: Int = (book).ask1_id;
    let mut ask1_price: Int = (book).ask1_price;
    let mut ask1_qty: Int = (book).ask1_qty;
    let mut ask1_live: Int = (book).ask1_live;
    if ask0_live == 0 {
        ask0_id = oid;
        ask0_price = px;
        ask0_qty = rem;
        ask0_live = live;
    } else {
        if ask1_live == 0 {
            ask1_id = oid;
            ask1_price = px;
            ask1_qty = rem;
            ask1_live = live;
        } else {
            ask1_id = oid;
            ask1_price = px;
            ask1_qty = rem;
            ask1_live = live;
        }
    }
    return OrderBook {
        bid_count: (book).bid_count,
        ask_count: (book).ask_count + 1,
        last_trade_price: (book).last_trade_price,
        bid0_id: (book).bid0_id,
        bid0_price: (book).bid0_price,
        bid0_qty: (book).bid0_qty,
        bid0_live: (book).bid0_live,
        bid1_id: (book).bid1_id,
        bid1_price: (book).bid1_price,
        bid1_qty: (book).bid1_qty,
        bid1_live: (book).bid1_live,
        ask0_id: ask0_id,
        ask0_price: ask0_price,
        ask0_qty: ask0_qty,
        ask0_live: ask0_live,
        ask1_id: ask1_id,
        ask1_price: ask1_price,
        ask1_qty: ask1_qty,
        ask1_live: ask1_live,
        processed: (book).processed + 1
    };
}

pub fn orderbook_cancel_order(book: OrderBook, target_order_id: Int) -> OrderBook {
    let mut bid0_live: Int = (book).bid0_live;
    let mut bid1_live: Int = (book).bid1_live;
    let mut ask0_live: Int = (book).ask0_live;
    let mut ask1_live: Int = (book).ask1_live;
    let mut found: Int = 0;
    if (book).bid0_id == target_order_id {
        bid0_live = 0;
        found = 1;
    }
    if (book).bid1_id == target_order_id {
        bid1_live = 0;
        found = 1;
    }
    if (book).ask0_id == target_order_id {
        ask0_live = 0;
        found = 1;
    }
    if (book).ask1_id == target_order_id {
        ask1_live = 0;
        found = 1;
    }
    return OrderBook {
        bid_count: (book).bid_count,
        ask_count: (book).ask_count,
        last_trade_price: (book).last_trade_price,
        bid0_id: (book).bid0_id,
        bid0_price: (book).bid0_price,
        bid0_qty: (book).bid0_qty,
        bid0_live: bid0_live,
        bid1_id: (book).bid1_id,
        bid1_price: (book).bid1_price,
        bid1_qty: (book).bid1_qty,
        bid1_live: bid1_live,
        ask0_id: (book).ask0_id,
        ask0_price: (book).ask0_price,
        ask0_qty: (book).ask0_qty,
        ask0_live: ask0_live,
        ask1_id: (book).ask1_id,
        ask1_price: (book).ask1_price,
        ask1_qty: (book).ask1_qty,
        ask1_live: ask1_live,
        processed: (book).processed + found
    };
}
