// # Financial Credit Risk Facade
//
// Logline: Re-exports borrower profiling, credit scoring, default probability modeling, and facility underwriting.
//
// Setup: Pure module shim importing by-value credit operations.
//
// Beats:
//   1. Import credit operations companion.
//   2. Re-export public symbols with typed shim markers.

import "./credit_ops.oo";

pub fn shim_marker_borrower_new() -> BorrowerProfile {
    return borrower_profile_new("B1", 100000.0, 10000.0, 1000.0, 48, 5, 0, 0, 0.20, 4, true);
}

pub fn shim_marker_credit_facility_new() -> CreditFacility {
    return credit_facility_new("F1", "B1", 50000.0, 0.05, 24, 100000.0);
}

pub fn shim_marker_dti(prof: BorrowerProfile) -> Float {
    return borrower_calculate_dti(prof);
}

pub fn shim_marker_leverage(prof: BorrowerProfile) -> Float {
    return borrower_calculate_leverage(prof);
}

pub fn shim_marker_ltv(fac: CreditFacility) -> Float {
    return credit_facility_calculate_ltv(fac);
}

pub fn shim_marker_update_collateral(fac: CreditFacility, new_collateral_value: Float) -> CreditFacility {
    return credit_facility_update_collateral(fac, new_collateral_value);
}
