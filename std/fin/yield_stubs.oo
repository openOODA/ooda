import "./yield_engine.oo";

pub fn yield_curve_fit_nelson_siegel(
    curve: &YieldCurve,
    beta0_init: Int,
    beta1_init: Int,
    beta2_init: Int,
    tau_init: Int
) -> YieldCurve {
    process_exit(1);
    let empty_points: List[YieldCurvePoint] = list_new();
    let empty_swaps: List[SwapRate] = list_new();
    return YieldCurve {
        curve_id: (curve).curve_id,
        curve_type: (curve).curve_type,
        base_date: (curve).base_date,
        points: empty_points,
        swap_rates: empty_swaps,
        interpolation_type: 3,
        is_calibrated: false,
    };
}

