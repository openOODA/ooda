//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: List[struct] destubbed to Int floor.

type OrderRoute = struct {
    side: Int,
    total_qty: Int,
    limit_price: Int,
    filled_qty: Int,
    remaining_qty: Int,
    status: Int,
    is_active: Int,
    last_ok: Int
};

pub fn order_route_new(side: Int, total_qty: Int, limit_price: Int) -> OrderRoute {
    return OrderRoute {
        side: side,
        total_qty: total_qty,
        limit_price: limit_price,
        filled_qty: 0,
        remaining_qty: total_qty,
        status: 1,
        is_active: 1,
        last_ok: 1
    };
}

pub fn order_route_qty(r: OrderRoute) -> Int {
    return r.total_qty;
}

type ExecutionReport = struct {
    exec_qty: Int,
    exec_price: Int,
    fee: Int,
    side: Int,
    is_fill: Int
};

pub fn execution_report_new(exec_qty: Int, exec_price: Int, fee: Int, side: Int) -> ExecutionReport {
    return ExecutionReport {
        exec_qty: exec_qty,
        exec_price: exec_price,
        fee: fee,
        side: side,
        is_fill: 1
    };
}
