// # Financial Value at Risk Engine
//
// Logline: Computes Parametric Delta-Normal VaR, Expected Shortfall (CVaR), and stressed scenario adjustments.
//
// Setup: Imports var_ops.oo for z-scores, exposure scaling, and risk capital limits.
//
// Beats:
//   1. Compute Parametric VaR and Expected Shortfall from portfolio volatility and exposure.
//   2. Compute VaR from pre-aggregated RiskMetrics structs.
//   3. Apply multi-factor stress scenario shocks to market values and volatility.

import "./var_ops.oo";

pub fn var_calculate_parametric(
    portfolio: &PortfolioValue,
    confidence_level: Float,
    time_horizon_days: Int,
) -> VarResult {
    if (portfolio).total_value <= 0.0 {
        return VarResult {
            var_amount: 0.0,
            var_percentage: 0.0,
            expected_shortfall: 0.0,
            confidence_level: confidence_level,
            time_horizon_days: time_horizon_days,
            is_breached: false,
            method_code: 1,
        };
    }

    let z = z_score_for_confidence(confidence_level);
    let time_factor = time_horizon_sqrt_factor(time_horizon_days);
    let effective_val = portfolio_effective_exposure(portfolio);

    let var_pct = (portfolio).daily_volatility * z * time_factor;
    let var_amt = effective_val * var_pct;

    let es_amt = var_amt * 1.25;

    return VarResult {
        var_amount: var_amt,
        var_percentage: var_pct,
        expected_shortfall: es_amt,
        confidence_level: confidence_level,
        time_horizon_days: time_horizon_days,
        is_breached: false,
        method_code: 1,
    };
}

pub fn var_calculate_from_metrics(
    metrics: &RiskMetrics,
    portfolio_value: Float,
) -> VarResult {
    if portfolio_value <= 0.0 {
        return VarResult {
            var_amount: 0.0,
            var_percentage: 0.0,
            expected_shortfall: 0.0,
            confidence_level: (metrics).var_confidence_level,
            time_horizon_days: (metrics).time_horizon_days,
            is_breached: false,
            method_code: 1,
        };
    }

    let conf = (metrics).var_confidence_level;
    let days = (metrics).time_horizon_days;
    let z = z_score_for_confidence(conf);
    let time_factor = time_horizon_sqrt_factor(days);

    let var_pct = (metrics).volatility * z * time_factor;
    let var_amt = portfolio_value * var_pct;
    let es_amt = var_amt * 1.25;

    return VarResult {
        var_amount: var_amt,
        var_percentage: var_pct,
        expected_shortfall: es_amt,
        confidence_level: conf,
        time_horizon_days: days,
        is_breached: false,
        method_code: 1,
    };
}

pub fn var_apply_stress_scenario(
    portfolio: &PortfolioValue,
    scenario: &StressScenario,
    confidence_level: Float,
    time_horizon_days: Int,
) -> VarResult {
    let base_vol = (portfolio).daily_volatility;
    let stressed_vol = base_vol * (scenario).volatility_multiplier;

    let z = z_score_for_confidence(confidence_level);
    let time_factor = time_horizon_sqrt_factor(time_horizon_days);

    let val = (portfolio).total_value;
    let shocked_val = val * (1.0 - (scenario).market_shock_pct);

    let var_pct = stressed_vol * z * time_factor;
    let var_amt = shocked_val * var_pct;
    let es_amt = var_amt * 1.30;

    return VarResult {
        var_amount: var_amt,
        var_percentage: var_pct,
        expected_shortfall: es_amt,
        confidence_level: confidence_level,
        time_horizon_days: time_horizon_days,
        is_breached: false,
        method_code: 4,
    };
}
