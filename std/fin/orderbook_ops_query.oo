// # Order Book Query Operations
//
// Logline: Remaining qty, best bid/ask, spread, and mid-price queries over a two-bid / two-ask book.
//
// Setup: Imports orderbook_types.oo. Two live bid slots and two live ask slots.
//
// Beats:
//   1. limit_order_remaining_qty, limit_order_is_filled.
//   2. orderbook_get_bids_count, orderbook_get_asks_count.
//   3. orderbook_get_best_bid, orderbook_get_best_ask, orderbook_get_spread, orderbook_get_mid_price.
//
// residual: List[struct] destubbed to fixed Int slots.

import "./orderbook_types.oo";

pub fn limit_order_remaining_qty(order: LimitOrder) -> Int {
    let q: Int = (order).quantity;
    let f: Int = (order).filled;
    let rem: Int = q - f;
    if rem < 0 {
        return 0;
    }
    return rem;
}

pub fn limit_order_is_filled(order: LimitOrder) -> Int {
    let rem: Int = limit_order_remaining_qty(order);
    if rem == 0 {
        return 1;
    }
    return 0;
}

pub fn orderbook_get_bids_count(book: OrderBook) -> Int {
    return (book).bid_count;
}

pub fn orderbook_get_asks_count(book: OrderBook) -> Int {
    return (book).ask_count;
}

pub fn orderbook_get_best_bid(book: OrderBook) -> Int {
    let mut max_price: Int = 0;
    if (book).bid0_live == 1 {
        if (book).bid0_qty > 0 {
            if (book).bid0_price > max_price {
                max_price = (book).bid0_price;
            }
        }
    }
    if (book).bid1_live == 1 {
        if (book).bid1_qty > 0 {
            if (book).bid1_price > max_price {
                max_price = (book).bid1_price;
            }
        }
    }
    return max_price;
}

pub fn orderbook_get_best_ask(book: OrderBook) -> Int {
    let mut min_price: Int = 0;
    if (book).ask0_live == 1 {
        if (book).ask0_qty > 0 {
            min_price = (book).ask0_price;
        }
    }
    if (book).ask1_live == 1 {
        if (book).ask1_qty > 0 {
            if min_price == 0 {
                min_price = (book).ask1_price;
            } else {
                if (book).ask1_price < min_price {
                    min_price = (book).ask1_price;
                }
            }
        }
    }
    return min_price;
}

pub fn orderbook_get_spread(book: OrderBook) -> Int {
    let best_bid: Int = orderbook_get_best_bid(book);
    let best_ask: Int = orderbook_get_best_ask(book);
    if best_bid == 0 {
        return 0;
    }
    if best_ask == 0 {
        return 0;
    }
    if best_ask > best_bid {
        return best_ask - best_bid;
    }
    return 0;
}

pub fn orderbook_get_mid_price(book: OrderBook) -> Int {
    let best_bid: Int = orderbook_get_best_bid(book);
    let best_ask: Int = orderbook_get_best_ask(book);
    if best_bid == 0 {
        return best_ask;
    }
    if best_ask == 0 {
        return best_bid;
    }
    return (best_bid + best_ask) / 2;
}
