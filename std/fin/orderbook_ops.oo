// # Financial Order Book Operations
//
// Logline: Remaining qty, best bid/ask, spread, mid, cancel. Destubbed off &mut List[LimitOrder].
//
// Setup: Imports orderbook_types.oo. Two live bid slots and two live ask slots.
//
// Beats:
//   1. Remaining = qty - filled, clamped at 0.
//   2. Best bid is max live bid price; best ask is min live ask price.
//   3. Spread = ask - bid; mid = (bid + ask) / 2.
// residual: List[struct] destubbed to fixed Int slots.

import "./orderbook_types.oo";

pub fn limit_order_remaining_qty(order: LimitOrder) -> Int {
    let q: Int = order.quantity;
    let f: Int = order.filled;
    let rem: Int = q - f;
    if rem < 0  { return 0; }
    return rem;
}

pub fn limit_order_is_filled(order: LimitOrder) -> Int {
    let rem: Int = limit_order_remaining_qty(order);
    if rem == 0  { return 1; }
    return 0;
}

pub fn orderbook_get_bids_count(book: OrderBook) -> Int { return book.bid_count; }

pub fn orderbook_get_asks_count(book: OrderBook) -> Int { return book.ask_count; }

pub fn orderbook_get_best_bid(book: OrderBook) -> Int {
    let mut max_price: Int = 0;
    if book.bid0_live == 1 {
        if book.bid0_qty > 0 {
            if book.bid0_price > max_price  { max_price = book.bid0_price; }
        }
    }
    if book.bid1_live == 1 {
        if book.bid1_qty > 0 {
            if book.bid1_price > max_price  { max_price = book.bid1_price; }
        }
    }
    return max_price;
}

pub fn orderbook_get_best_ask(book: OrderBook) -> Int {
    let mut min_price: Int = 0;
    if book.ask0_live == 1 {
        if book.ask0_qty > 0  { min_price = book.ask0_price; }
    }
    if book.ask1_live == 1 {
        if book.ask1_qty > 0 {
            if min_price == 0 {
                min_price = book.ask1_price;
            } else {
                if book.ask1_price < min_price  { min_price = book.ask1_price; }
            }
        }
    }
    return min_price;
}

pub fn orderbook_get_spread(book: OrderBook) -> Int {
    let best_bid: Int = orderbook_get_best_bid(book);
    let best_ask: Int = orderbook_get_best_ask(book);
    if best_bid == 0  { return 0; }
    if best_ask == 0  { return 0; }
    if best_ask > best_bid  { return best_ask - best_bid; }
    return 0;
}

pub fn orderbook_get_mid_price(book: OrderBook) -> Int {
    let best_bid: Int = orderbook_get_best_bid(book);
    let best_ask: Int = orderbook_get_best_ask(book);
    if best_bid == 0  { return best_ask; }
    if best_ask == 0  { return best_bid; }
    return (best_bid + best_ask) / 2;
}

pub fn orderbook_get_level_depth(book: OrderBook, target_price: Int, is_buy: Int) -> OrderBookLevel {
    let mut total_qty: Int = 0;
    let mut n_orders: Int = 0;
    if is_buy == 1 {
        if book.bid0_live == 1 {
            if book.bid0_price == target_price {
                if book.bid0_qty > 0 {
                    total_qty = total_qty + book.bid0_qty;
                    n_orders = n_orders + 1;
                }
            }
        }
        if book.bid1_live == 1 {
            if book.bid1_price == target_price {
                if book.bid1_qty > 0 {
                    total_qty = total_qty + book.bid1_qty;
                    n_orders = n_orders + 1;
                }
            }
        }
    } else {
        if book.ask0_live == 1 {
            if book.ask0_price == target_price {
                if book.ask0_qty > 0 {
                    total_qty = total_qty + book.ask0_qty;
                    n_orders = n_orders + 1;
                }
            }
        }
        if book.ask1_live == 1 {
            if book.ask1_price == target_price {
                if book.ask1_qty > 0 {
                    total_qty = total_qty + book.ask1_qty;
                    n_orders = n_orders + 1;
                }
            }
        }
    }
    return OrderBookLevel {
        price: target_price, total_qty: total_qty, n_orders: n_orders,
        is_buy: is_buy
    };
}

pub fn orderbook_add_order(book: OrderBook, order: LimitOrder) -> OrderBook {
    let oid: Int = order.order_id;
    let px: Int = order.price;
    let qty: Int = order.quantity;
    let rem: Int = limit_order_remaining_qty(order);
    let mut live: Int = 0;
    if order.is_canceled == 0 {
        if rem > 0  { live = 1; }
    }
    if order.is_buy == 1 {
        let mut bid0_id: Int = book.bid0_id;
        let mut bid0_price: Int = book.bid0_price;
        let mut bid0_qty: Int = book.bid0_qty;
        let mut bid0_live: Int = book.bid0_live;
        let mut bid1_id: Int = book.bid1_id;
        let mut bid1_price: Int = book.bid1_price;
        let mut bid1_qty: Int = book.bid1_qty;
        let mut bid1_live: Int = book.bid1_live;
        if bid0_live == 0 {
            bid0_id = oid;
            bid0_price = px;
            bid0_qty = rem;
            bid0_live = live;
        } else {
            if bid1_live == 0 {
                bid1_id = oid;
                bid1_price = px;
                bid1_qty = rem;
                bid1_live = live;
            } else {
                bid1_id = oid;
                bid1_price = px;
                bid1_qty = rem;
                bid1_live = live;
            }
        }
        return OrderBook {
            bid_count: book.bid_count + 1, ask_count: book.ask_count,
            last_trade_price: book.last_trade_price, bid0_id: bid0_id,
            bid0_price: bid0_price, bid0_qty: bid0_qty, bid0_live: bid0_live,
            bid1_id: bid1_id, bid1_price: bid1_price, bid1_qty: bid1_qty,
            bid1_live: bid1_live, ask0_id: book.ask0_id, ask0_price: book.ask0_price,
            ask0_qty: book.ask0_qty, ask0_live: book.ask0_live, ask1_id: book.ask1_id,
            ask1_price: book.ask1_price, ask1_qty: book.ask1_qty,
            ask1_live: book.ask1_live, processed: book.processed + 1
        };
    }
    let mut ask0_id: Int = book.ask0_id;
    let mut ask0_price: Int = book.ask0_price;
    let mut ask0_qty: Int = book.ask0_qty;
    let mut ask0_live: Int = book.ask0_live;
    let mut ask1_id: Int = book.ask1_id;
    let mut ask1_price: Int = book.ask1_price;
    let mut ask1_qty: Int = book.ask1_qty;
    let mut ask1_live: Int = book.ask1_live;
    if ask0_live == 0 {
        ask0_id = oid;
        ask0_price = px;
        ask0_qty = rem;
        ask0_live = live;
    } else {
        if ask1_live == 0 {
            ask1_id = oid;
            ask1_price = px;
            ask1_qty = rem;
            ask1_live = live;
        } else {
            ask1_id = oid;
            ask1_price = px;
            ask1_qty = rem;
            ask1_live = live;
        }
    }
    return OrderBook {
        bid_count: book.bid_count, ask_count: book.ask_count + 1,
        last_trade_price: book.last_trade_price, bid0_id: book.bid0_id,
        bid0_price: book.bid0_price, bid0_qty: book.bid0_qty,
        bid0_live: book.bid0_live, bid1_id: book.bid1_id, bid1_price: book.bid1_price,
        bid1_qty: book.bid1_qty, bid1_live: book.bid1_live, ask0_id: ask0_id,
        ask0_price: ask0_price, ask0_qty: ask0_qty, ask0_live: ask0_live,
        ask1_id: ask1_id, ask1_price: ask1_price, ask1_qty: ask1_qty,
        ask1_live: ask1_live, processed: book.processed + 1
    };
}

pub fn orderbook_cancel_order(book: OrderBook, target_order_id: Int) -> OrderBook {
    let mut bid0_live: Int = book.bid0_live;
    let mut bid1_live: Int = book.bid1_live;
    let mut ask0_live: Int = book.ask0_live;
    let mut ask1_live: Int = book.ask1_live;
    let mut found: Int = 0;
    if book.bid0_id == target_order_id {
        bid0_live = 0;
        found = 1;
    }
    if book.bid1_id == target_order_id {
        bid1_live = 0;
        found = 1;
    }
    if book.ask0_id == target_order_id {
        ask0_live = 0;
        found = 1;
    }
    if book.ask1_id == target_order_id {
        ask1_live = 0;
        found = 1;
    }
    return OrderBook {
        bid_count: book.bid_count, ask_count: book.ask_count,
        last_trade_price: book.last_trade_price, bid0_id: book.bid0_id,
        bid0_price: book.bid0_price, bid0_qty: book.bid0_qty, bid0_live: bid0_live,
        bid1_id: book.bid1_id, bid1_price: book.bid1_price, bid1_qty: book.bid1_qty,
        bid1_live: bid1_live, ask0_id: book.ask0_id, ask0_price: book.ask0_price,
        ask0_qty: book.ask0_qty, ask0_live: ask0_live, ask1_id: book.ask1_id,
        ask1_price: book.ask1_price, ask1_qty: book.ask1_qty, ask1_live: ask1_live,
        processed: book.processed + found
    };
}
