// residual: List[struct] destubbed to Int tenor/factor.

type DiscountFactor = struct {
    tenor_months: Int,
    factor_bps: Int
};

pub fn discount_factor_new(tenor_months: Int, factor_bps: Int) -> DiscountFactor {
    return DiscountFactor {
        tenor_months: tenor_months,
        factor_bps: factor_bps
    };
}

pub fn discount_factor_tenor(d: DiscountFactor) -> Int {
    return d.tenor_months;
}
