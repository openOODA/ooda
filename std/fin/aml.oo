// ===================================================================
// openOODA Standard Library — ooda::fin::aml
// AML Re-export Shim (Issue #15 split)
// ===================================================================
// The original ~490-line aml.oo was split at functional seams
// into 4 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.

import "./aml_types.oo";
import "./aml_risk.oo";
import "./aml_ops.oo";
import "./aml_stubs.oo";

pub fn shim_marker_tx_new() -> TransactionNode {
    return transaction_node_new("TX1", "S", "R", 100, 1, "WIRE", "US", false);
}

pub fn shim_marker_risk_new() -> RiskScore {
    return risk_score_new("E1", 10, 20, 30, 25);
}

pub fn shim_marker_rule_new() -> PatternRule {
    return pattern_rule_new("R1", "rule", 500000, 86400, 5, 30, true);
}

pub fn shim_marker_sanction_new() -> SanctionEntity {
    return sanction_entity_new("S1", "ACME", "US", "HIGH", true);
}

pub fn shim_marker_alert_new() -> AMLAlert {
    return aml_alert_new("A1", "R1", "E1", "HIGH", "reason", 1);
}

pub fn shim_marker_profile_new() -> ComplianceProfile {
    return compliance_profile_new("E1", true, false);
}

pub fn shim_marker_classify() -> String {
    return aml_classify_risk_level(75);
}

pub fn shim_marker_structuring() -> Bool {
    return aml_check_structuring_pattern(9500, 10000);
}

pub fn shim_marker_jurisdiction() -> Int {
    return aml_check_jurisdiction_risk("KY");
}

pub fn shim_marker_velocity() -> Int {
    return aml_calculate_velocity_risk(60, 3600);
}

pub fn shim_marker_eval_risk() -> RiskScore {
    return aml_evaluate_risk_score("E1", 10, 45, 30, 25);
}

pub fn shim_marker_eval_rule(tx: TransactionNode, rule: PatternRule) -> Bool {
    return aml_evaluate_transaction_rule(tx, rule);
}

pub fn shim_marker_sanction_match() -> Bool {
    return aml_check_sanction_match("ACME CORP", "ACME CORP");
}

pub fn shim_marker_sar(risk: RiskScore) -> String {
    return aml_format_sar_report("E1", risk, "reason");
}

pub fn shim_marker_batch(txs: List[TransactionNode], rule: PatternRule) -> Int {
    return aml_batch_evaluate_transactions(txs, rule);
}

pub fn shim_marker_update_profile(p: ComplianceProfile) -> ComplianceProfile {
    return aml_update_compliance_profile(p, 100, true);
}

pub fn shim_marker_graph(nodes: List[TransactionNode]) -> List[String] {
    return aml_graph_community_detection(nodes, 1);
}

pub fn shim_marker_ml(tx: TransactionNode) -> Int {
    return aml_ml_anomaly_inference(tx, "weights");
}

pub fn shim_marker_fuzzy() -> Bool {
    return aml_fuzzy_name_matching("a", "b", 1);
}

pub fn shim_marker_utxo() -> List[TransactionNode] {
    return aml_blockchain_utxo_trace("hash", 2);
}
