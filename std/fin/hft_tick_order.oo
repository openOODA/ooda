// # HFT Tick Data & Market Order Constructors
//
// Logline: Build TickData and MarketOrder records; record cancels and average fill price.
//
// Setup: Self-contained microstruct module. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. tick_data_create: bind symbol, price, quantity, and seq_num.
//   2. market_order_create: bind side, quantity, time_in_force.
//   3. market_order_apply_fill: refresh filled_quantity and avg_fill_price.
//   4. market_order_cancel: flip is_canceled and freeze state.
//
// residual: not a real HFT engine; integrate vetted trading stack.

type TickData = struct {
    symbol: String,
    price: Int,
    quantity: Int,
    bid_price: Int,
    ask_price: Int,
    bid_qty: Int,
    ask_qty: Int,
    timestamp_ns: Int,
    seq_num: Int,
    exchange_id: String,
    is_trade: Bool
};

type MarketOrder = struct {
    order_id: Int,
    symbol: String,
    side: Int,
    quantity: Int,
    filled_quantity: Int,
    price_limit: Int,
    time_in_force: Int,
    timestamp_ns: Int,
    is_canceled: Bool,
    avg_fill_price: Int
};

pub fn tick_data_create(
    symbol: String,
    price: Int,
    quantity: Int,
    bid_price: Int,
    ask_price: Int,
    bid_qty: Int,
    ask_qty: Int,
    timestamp_ns: Int,
    seq_num: Int,
    exchange_id: String,
    is_trade: Bool
) -> TickData {
    return TickData {
        symbol: symbol,
        price: price,
        quantity: quantity,
        bid_price: bid_price,
        ask_price: ask_price,
        bid_qty: bid_qty,
        ask_qty: ask_qty,
        timestamp_ns: timestamp_ns,
        seq_num: seq_num,
        exchange_id: exchange_id,
        is_trade: is_trade
    };
}

pub fn market_order_create(
    order_id: Int,
    symbol: String,
    side: Int,
    quantity: Int,
    price_limit: Int,
    time_in_force: Int,
    timestamp_ns: Int
) -> MarketOrder {
    return MarketOrder {
        order_id: order_id,
        symbol: symbol,
        side: side,
        quantity: quantity,
        filled_quantity: 0,
        price_limit: price_limit,
        time_in_force: time_in_force,
        timestamp_ns: timestamp_ns,
        is_canceled: false,
        avg_fill_price: 0
    };
}

pub fn tick_data_calculate_spread(tick: TickData) -> Int {
    let b: Int = tick.bid_price;
    let a: Int = tick.ask_price;
    if a <= 0 {
        return 0;
    }
    if b <= 0 {
        return 0;
    }
    if a <= b {
        return 0;
    }
    return a - b;
}

pub fn tick_data_calculate_mid_price(tick: TickData) -> Int {
    let b: Int = tick.bid_price;
    let a: Int = tick.ask_price;
    if b <= 0 {
        return a;
    }
    if a <= 0 {
        return b;
    }
    return (b + a) / 2;
}

pub fn tick_data_calculate_micro_price(tick: TickData) -> Int {
    let b_px: Int = tick.bid_price;
    let a_px: Int = tick.ask_price;
    let b_sz: Int = tick.bid_qty;
    let a_sz: Int = tick.ask_qty;
    let total_sz: Int = b_sz + a_sz;
    if total_sz <= 0 {
        return tick_data_calculate_mid_price(tick);
    }
    let num: Int = (b_px * a_sz) + (a_px * b_sz);
    return num / total_sz;
}

pub fn market_order_remaining_qty(order: MarketOrder) -> Int {
    let rem: Int = order.quantity - order.filled_quantity;
    if rem < 0 {
        return 0;
    }
    return rem;
}

pub fn market_order_is_filled(order: MarketOrder) -> Bool {
    let rem: Int = market_order_remaining_qty(order);
    return rem == 0;
}

pub fn market_order_can_cross(order: MarketOrder, best_opposite_price: Int) -> Bool {
    if best_opposite_price <= 0 {
        return false;
    }
    let side: Int = order.side;
    let limit_px: Int = order.price_limit;
    if side == 1 {
        if limit_px == 0 {
            return true;
        }
        return limit_px >= best_opposite_price;
    }
    if side == 2 {
        if limit_px == 0 {
            return true;
        }
        return limit_px <= best_opposite_price;
    }
    return false;
}

pub fn market_order_apply_fill(order: MarketOrder, fill_qty: Int, fill_price: Int) -> MarketOrder {
    let current_filled: Int = order.filled_quantity;
    let current_avg: Int = order.avg_fill_price;
    let new_filled: Int = current_filled + fill_qty;
    let mut avg: Int = current_avg;
    if fill_price > 0 {
        if new_filled > 0 {
            let prev_val: Int = current_filled * current_avg;
            let new_val: Int = fill_qty * fill_price;
            avg = (prev_val + new_val) / new_filled;
        }
    }
    return MarketOrder {
        order_id: order.order_id,
        symbol: order.symbol,
        side: order.side,
        quantity: order.quantity,
        filled_quantity: new_filled,
        price_limit: order.price_limit,
        time_in_force: order.time_in_force,
        timestamp_ns: order.timestamp_ns,
        is_canceled: order.is_canceled,
        avg_fill_price: avg
    };
}
