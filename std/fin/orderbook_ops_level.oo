// # Order Book Level Depth Aggregation
//
// Logline: Aggregate total qty and n_orders at a target price across the two live slots on bid or ask side.
//
// Setup: Imports orderbook_types.oo.
//
// Beats:
//   1. orderbook_get_level_depth: walk bid or ask slots and aggregate matches.
//
// residual: List[struct] destubbed to fixed Int slots.

import "./orderbook_types.oo";

pub fn orderbook_get_level_depth(book: OrderBook, target_price: Int, is_buy: Int) -> OrderBookLevel {
    let mut total_qty: Int = 0;
    let mut n_orders: Int = 0;
    if is_buy == 1 {
        if (book).bid0_live == 1 {
            if (book).bid0_price == target_price {
                if (book).bid0_qty > 0 {
                    total_qty = total_qty + (book).bid0_qty;
                    n_orders = n_orders + 1;
                }
            }
        }
        if (book).bid1_live == 1 {
            if (book).bid1_price == target_price {
                if (book).bid1_qty > 0 {
                    total_qty = total_qty + (book).bid1_qty;
                    n_orders = n_orders + 1;
                }
            }
        }
    } else {
        if (book).ask0_live == 1 {
            if (book).ask0_price == target_price {
                if (book).ask0_qty > 0 {
                    total_qty = total_qty + (book).ask0_qty;
                    n_orders = n_orders + 1;
                }
            }
        }
        if (book).ask1_live == 1 {
            if (book).ask1_price == target_price {
                if (book).ask1_qty > 0 {
                    total_qty = total_qty + (book).ask1_qty;
                    n_orders = n_orders + 1;
                }
            }
        }
    }
    return OrderBookLevel {
        price: target_price,
        total_qty: total_qty,
        n_orders: n_orders,
        is_buy: is_buy
    };
}
