// # Financial Value at Risk Facade
//
// Logline: Re-exports portfolio risk metrics, Parametric VaR, Expected Shortfall, and stress testing models.
//
// Setup: Pure module shim importing types, operations, calculation engine, and simulation stubs.
//
// Beats:
//   1. Import VaR types, operations, engine, and stubs companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Retain unified interface for portfolio risk and capital adequacy analysis.

import "./var_types.oo";
import "./var_ops.oo";
import "./var_engine.oo";
import "./var_stubs.oo";

pub fn shim_marker_portfolio_new() -> PortfolioValue {
    return portfolio_value_new(1000000.0, 100000.0, 900000.0, 0.015, 20);
}

pub fn shim_marker_risk_metrics_new() -> RiskMetrics {
    return risk_metrics_new(0.015, 1.5, 0.10, 1.0, 0.95, 1);
}

pub fn shim_marker_var_config_default() -> VarConfig {
    return var_config_default();
}

pub fn shim_marker_stress_new() -> StressScenario {
    return stress_scenario_new(0.10, 1.5, 0.2);
}

pub fn shim_marker_z_score() -> Float {
    return z_score_for_confidence(0.95);
}

pub fn shim_marker_time_factor() -> Float {
    return time_horizon_sqrt_factor(10);
}

pub fn shim_marker_portfolio_pnl(pv: &PortfolioValue) -> Float {
    return portfolio_total_pnl(pv);
}

pub fn shim_marker_var_calc_parametric(pv: &PortfolioValue) -> VarResult {
    return var_calculate_parametric(pv, 0.95, 1);
}

pub fn shim_marker_var_calc_metrics(m: &RiskMetrics) -> VarResult {
    return var_calculate_from_metrics(m, 1000000.0);
}

pub fn shim_marker_var_stress(pv: &PortfolioValue, sc: &StressScenario) -> VarResult {
    return var_apply_stress_scenario(pv, sc, 0.95, 1);
}
