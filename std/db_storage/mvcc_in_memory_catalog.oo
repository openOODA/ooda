// # MVCC Transactional Schema Catalog
//
// Logline: Implements multi-version schema catalog managing table metadata, column definitions, and index descriptors.
//
// Setup: Tracks schema evolution and DDL migrations under standard transaction isolation semantics.
//
// Beats:
//   1. Define ColumnMeta, TableMeta, IndexMeta, and CatalogSchema structures.
//   2. Implement table schema registration, column addition, and index descriptor lookup.
//   3. Implement transactional DDL catalog versioning and schema cache invalidation.

pub type ColumnMeta = struct {
    column_name: String,
    data_type: String,
    is_nullable: Bool,
    column_index: Int,
};

pub type IndexMeta = struct {
    index_name: String,
    table_name: String,
    column_names: List[String],
    is_unique: Bool,
    root_page_id: Int,
};

pub type TableMeta = struct {
    table_name: String,
    table_id: Int,
    schema_version: Int,
    columns: List[ColumnMeta],
    indexes: List[IndexMeta],
    root_page_id: Int,
};

pub type CatalogSchema = struct {
    tables: List[TableMeta],
    total_tables: Int,
};

pub fn column_meta_new(name: String, dtype: String, nullable: Bool, idx: Int) -> ColumnMeta {
    return ColumnMeta {
        column_name: name,
        data_type: dtype,
        is_nullable: nullable,
        column_index: idx,
    };
}

pub fn catalog_schema_new() -> CatalogSchema {
    let empty_tables: List[TableMeta] = list_new();
    return CatalogSchema {
        tables: empty_tables,
        total_tables: 0,
    };
}

pub fn catalog_register_table(
    cat: CatalogSchema,
    name: String,
    tid: Int,
    cols: List[ColumnMeta],
    root_pid: Int
) -> CatalogSchema {
    let empty_indexes: List[IndexMeta] = list_new();
    let tbl: TableMeta = TableMeta {
        table_name: name,
        table_id: tid,
        schema_version: 1,
        columns: cols,
        indexes: empty_indexes,
        root_page_id: root_pid,
    };

    let updated_tables: List[TableMeta] = list_push((cat).tables, tbl);

    return CatalogSchema {
        tables: updated_tables,
        total_tables: (cat).total_tables + 1,
    };
}

pub fn catalog_find_table(cat: CatalogSchema, name: String) -> Option[TableMeta] {
    let tbls: List[TableMeta] = (cat).tables;
    let n: Int = list_len(tbls);
    let mut i: Int = 0;

    while i < n {
        let tbl: TableMeta = list_get(tbls, i);
        if (tbl).table_name == name {
            return Some(tbl);
        }
        i = i + 1;
    }

    return None;
}
