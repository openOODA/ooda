// # LSM SSTable Reader & Point Lookup Iterator
//
// Logline: Implements block-indexed SSTable reading, binary searching index records, and key point lookups.
//
// Setup: Two-level index navigation for fast point query resolution and range seek execution.
//
// Beats:
//   1. Define SSTableIndex, SSTableDataBlock, and SSTableReader structures.
//   2. Implement binary search over index blocks to locate candidate data blocks.
//   3. Implement intra-block search and key-value extraction with tombstone detection.

import "./lsm_sstable_builder.oo";

pub type SSTableDataBlock = struct {
    offset: Int,
    keys: List[String],
    values: List[String],
};

pub type SSTableReader = struct {
    file_id: Int,
    smallest_key: String,
    largest_key: String,
    index_entries: List[SSTableIndexEntry],
    blocks: List[SSTableDataBlock],
    footer: SSTableFooter,
};

pub fn sstable_reader_new(
    fid: Int,
    min_k: String,
    max_k: String,
    idx: List[SSTableIndexEntry],
    blk_list: List[SSTableDataBlock],
    ftr: SSTableFooter
) -> SSTableReader {
    return SSTableReader {
        file_id: fid,
        smallest_key: min_k,
        largest_key: max_k,
        index_entries: idx,
        blocks: blk_list,
        footer: ftr,
    };
}

pub fn sstable_reader_may_contain(reader: SSTableReader, target_key: String) -> Bool {
    if (reader).smallest_key == "" && (reader).largest_key == "" {
        return false;
    }
    if target_key < (reader).smallest_key || target_key > (reader).largest_key {
        return false;
    }
    return true;
}

pub fn sstable_reader_find_block_index(reader: SSTableReader, target_key: String) -> Int {
    let entries: List[SSTableIndexEntry] = (reader).index_entries;
    let n: Int = list_len(entries);
    if n == 0 {
        return -1;
    }
    let mut low: Int = 0;
    let mut high: Int = n - 1;
    let mut candidate: Int = -1;

    while low <= high {
        let mid: Int = low + ((high - low) / 2);
        let entry: SSTableIndexEntry = list_get(entries, mid);
        if (entry).last_key >= target_key {
            candidate = mid;
            high = mid - 1;
        } else {
            low = mid + 1;
        }
    }

    return candidate;
}

pub fn sstable_reader_get(reader: SSTableReader, target_key: String) -> Option[String] {
    if !sstable_reader_may_contain(reader, target_key) {
        return None;
    }

    let blk_idx: Int = sstable_reader_find_block_index(reader, target_key);
    if blk_idx < 0 || blk_idx >= list_len((reader).blocks) {
        return None;
    }

    let block: SSTableDataBlock = list_get((reader).blocks, blk_idx);
    let keys: List[String] = (block).keys;
    let vals: List[String] = (block).values;
    let num_keys: Int = list_len(keys);
    let mut i: Int = 0;

    while i < num_keys {
        let k: String = list_get(keys, i);
        if k == target_key {
            let v: String = list_get(vals, i);
            return Some(v);
        }
        i = i + 1;
    }

    return None;
}
