// # LSM MemTable SkipList Storage Engine
//
// Logline: Implements in-memory lock-free skiplist memtable with multi-level tower nodes, point lookups, and range scanning.
//
// Setup: High-throughput memory buffer staging mutations before immutable freeze and SSTable flush.
//
// Beats:
//   1. Define SkipListNode and SkipListMemTable with height generation and memory budgeting.
//   2. Implement skiplist point search, update, deletion tombstones, and key insertion.
//   3. Implement sequential range scan iterators and memtable immutable freeze gating.

pub type SkipListNode = struct {
    key: String,
    value: String,
    is_tombstone: Bool,
    sequence_number: Int,
    height: Int,
    next_keys: List[String],
};

pub type SkipListMemTable = struct {
    max_height: Int,
    size_bytes: Int,
    capacity_bytes: Int,
    nodes: List[SkipListNode],
    is_frozen: Bool,
    entry_count: Int,
};

pub type MemTableScanResult = struct {
    entries: List[SkipListNode],
    count: Int,
    is_complete: Bool,
};

pub fn skiplist_node_new(k: String, v: String, seq: Int, tomb: Bool, h: Int) -> SkipListNode {
    let mut next_ptrs: List[String] = list_new();
    let mut i: Int = 0;
    while i < h {
        next_ptrs = list_push(next_ptrs, "");
        i = i + 1;
    }
    return SkipListNode {
        key: k,
        value: v,
        is_tombstone: tomb,
        sequence_number: seq,
        height: h,
        next_keys: next_ptrs,
    };
}

pub fn skiplist_memtable_new(cap_bytes: Int, max_h: Int) -> SkipListMemTable {
    let empty_nodes: List[SkipListNode] = list_new();
    return SkipListMemTable {
        max_height: max_h,
        size_bytes: 0,
        capacity_bytes: cap_bytes,
        nodes: empty_nodes,
        is_frozen: false,
        entry_count: 0,
    };
}

pub fn skiplist_memtable_put(tbl: SkipListMemTable, k: String, v: String, seq: Int) -> SkipListMemTable {
    if (tbl).is_frozen {
        return tbl;
    }
    let node_h: Int = 1 + ((seq * 7) % (tbl).max_height);
    let new_node: SkipListNode = skiplist_node_new(k, v, seq, false, node_h);
    let mut updated_nodes: List[SkipListNode] = list_new();
    let current_nodes: List[SkipListNode] = (tbl).nodes;
    let n: Int = list_len(current_nodes);
    let mut inserted: Bool = false;
    let mut i: Int = 0;

    while i < n {
        let cur: SkipListNode = list_get(current_nodes, i);
        if !inserted && (cur).key >= k {
            if (cur).key == k {
                updated_nodes = list_push(updated_nodes, new_node);
                inserted = true;
                i = i + 1;
                continue;
            }
            updated_nodes = list_push(updated_nodes, new_node);
            inserted = true;
        }
        updated_nodes = list_push(updated_nodes, cur);
        i = i + 1;
    }

    if !inserted {
        updated_nodes = list_push(updated_nodes, new_node);
    }

    let approx_item_size: Int = 32 + 16;
    return SkipListMemTable {
        max_height: (tbl).max_height,
        size_bytes: (tbl).size_bytes + approx_item_size,
        capacity_bytes: (tbl).capacity_bytes,
        nodes: updated_nodes,
        is_frozen: (tbl).size_bytes + approx_item_size >= (tbl).capacity_bytes,
        entry_count: (tbl).entry_count + 1,
    };
}

pub fn skiplist_memtable_get(tbl: SkipListMemTable, target_key: String) -> Option[SkipListNode] {
    let current_nodes: List[SkipListNode] = (tbl).nodes;
    let n: Int = list_len(current_nodes);
    let mut i: Int = 0;
    while i < n {
        let cur: SkipListNode = list_get(current_nodes, i);
        if (cur).key == target_key {
            return Some(cur);
        }
        i = i + 1;
    }
    return None;
}

pub fn skiplist_memtable_delete(tbl: SkipListMemTable, k: String, seq: Int) -> SkipListMemTable {
    if (tbl).is_frozen {
        return tbl;
    }
    let tomb_node: SkipListNode = skiplist_node_new(k, "", seq, true, 1);
    let mut updated_nodes: List[SkipListNode] = list_new();
    let current_nodes: List[SkipListNode] = (tbl).nodes;
    let n: Int = list_len(current_nodes);
    let mut replaced: Bool = false;
    let mut i: Int = 0;

    while i < n {
        let cur: SkipListNode = list_get(current_nodes, i);
        if (cur).key == k {
            updated_nodes = list_push(updated_nodes, tomb_node);
            replaced = true;
        } else {
            updated_nodes = list_push(updated_nodes, cur);
        }
        i = i + 1;
    }

    if !replaced {
        updated_nodes = list_push(updated_nodes, tomb_node);
    }

    return SkipListMemTable {
        max_height: (tbl).max_height,
        size_bytes: (tbl).size_bytes + 24,
        capacity_bytes: (tbl).capacity_bytes,
        nodes: updated_nodes,
        is_frozen: (tbl).is_frozen,
        entry_count: (tbl).entry_count + 1,
    };
}

pub fn skiplist_memtable_range_scan(
    tbl: SkipListMemTable,
    start_key: String,
    end_key: String,
    limit: Int
) -> MemTableScanResult {
    let mut matched: List[SkipListNode] = list_new();
    let current_nodes: List[SkipListNode] = (tbl).nodes;
    let n: Int = list_len(current_nodes);
    let mut i: Int = 0;
    let mut count: Int = 0;

    while i < n && count < limit {
        let cur: SkipListNode = list_get(current_nodes, i);
        if (cur).key >= start_key && (cur).key <= end_key {
            if !(cur).is_tombstone {
                matched = list_push(matched, cur);
                count = count + 1;
            }
        }
        i = i + 1;
    }

    return MemTableScanResult {
        entries: matched,
        count: count,
        is_complete: i >= n || count >= limit,
    };
}

pub fn skiplist_memtable_freeze(tbl: SkipListMemTable) -> SkipListMemTable {
    return SkipListMemTable {
        max_height: (tbl).max_height,
        size_bytes: (tbl).size_bytes,
        capacity_bytes: (tbl).capacity_bytes,
        nodes: (tbl).nodes,
        is_frozen: true,
        entry_count: (tbl).entry_count,
    };
}
