// # Buffer Pool Frame & Page Table Manager
//
// Logline: Manages buffer pool frame allocation, page table mapping, disk read staging, and asynchronous dirty flushing.
//
// Setup: Bridges physical disk page I/O with memory-resident database buffer frames.
//
// Beats:
//   1. Define BufferFrameDescriptor, PageTableMapping, and BufferPoolManager structures.
//   2. Implement page lookup, cache hit detection, and free frame allocation.
//   3. Implement dirty page batch selection for background writer flushing.

pub type BufferFrameDescriptor = struct {
    frame_id: Int,
    page_id: Int,
    is_dirty: Bool,
    pin_count: Int,
    last_lsn: Int,
};

pub type PageTableEntry = struct {
    page_id: Int,
    frame_id: Int,
    is_valid: Bool,
};

pub type BufferPoolManager = struct {
    pool_size: Int,
    page_table: List[PageTableEntry],
    frames: List[BufferFrameDescriptor],
    cache_hits: Int,
    cache_misses: Int,
};

pub fn buffer_pool_manager_new(size: Int) -> BufferPoolManager {
    let mut initial_frames: List[BufferFrameDescriptor] = list_new();
    let mut initial_table: List[PageTableEntry] = list_new();
    let mut i: Int = 0;
    while i < size {
        let frame: BufferFrameDescriptor = BufferFrameDescriptor {
            frame_id: i,
            page_id: -1,
            is_dirty: false,
            pin_count: 0,
            last_lsn: 0,
        };
        initial_frames = list_push(initial_frames, frame);
        i = i + 1;
    }

    return BufferPoolManager {
        pool_size: size,
        page_table: initial_table,
        frames: initial_frames,
        cache_hits: 0,
        cache_misses: 0,
    };
}

pub fn buffer_pool_find_frame(bpm: BufferPoolManager, target_pid: Int) -> Option[Int] {
    let tbl: List[PageTableEntry] = (bpm).page_table;
    let n: Int = list_len(tbl);
    let mut i: Int = 0;

    while i < n {
        let entry: PageTableEntry = list_get(tbl, i);
        if (entry).is_valid && (entry).page_id == target_pid {
            return Some((entry).frame_id);
        }
        i = i + 1;
    }

    return None;
}

pub fn buffer_pool_record_hit(bpm: BufferPoolManager) -> BufferPoolManager {
    return BufferPoolManager {
        pool_size: (bpm).pool_size,
        page_table: (bpm).page_table,
        frames: (bpm).frames,
        cache_hits: (bpm).cache_hits + 1,
        cache_misses: (bpm).cache_misses,
    };
}

pub fn buffer_pool_record_miss(bpm: BufferPoolManager) -> BufferPoolManager {
    return BufferPoolManager {
        pool_size: (bpm).pool_size,
        page_table: (bpm).page_table,
        frames: (bpm).frames,
        cache_hits: (bpm).cache_hits,
        cache_misses: (bpm).cache_misses + 1,
    };
}
