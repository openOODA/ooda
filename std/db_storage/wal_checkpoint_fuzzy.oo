// # WAL Fuzzy Checkpoint & Snapshot Coordinator
//
// Logline: Implements non-blocking fuzzy checkpointing recording Active Transaction Table (ATT) and Dirty Page Table (DPT).
//
// Setup: Bounds recovery log replay length by periodically capturing runtime memory dirty state without stopping transactions.
//
// Beats:
//   1. Define ActiveTxRecord, DirtyPageEntry, and FuzzyCheckpointRecord structures.
//   2. Implement checkpoint begin record emission and in-flight transaction snapshot capture.
//   3. Finalize checkpoint end record with minimum recovery RecLSN watermark computation.

pub type ActiveTxRecord = struct {
    tx_id: Int,
    last_lsn: Int,
    status: String
};

pub type DirtyPageEntry = struct {
    page_id: Int,
    rec_lsn: Int
};

pub type FuzzyCheckpointRecord = struct {
    checkpoint_id: Int,
    begin_lsn: Int,
    end_lsn: Int,
    active_txns: List[ActiveTxRecord],
    dirty_pages: List[DirtyPageEntry],
    min_rec_lsn: Int
};

pub fn fuzzy_checkpoint_record_new(cid: Int, b_lsn: Int) -> FuzzyCheckpointRecord {
    let empty_txns: List[ActiveTxRecord] = list_new();
    let empty_dpt: List[DirtyPageEntry] = list_new();
    return FuzzyCheckpointRecord {
        checkpoint_id: cid,
        begin_lsn: b_lsn,
        end_lsn: 0,
        active_txns: empty_txns,
        dirty_pages: empty_dpt,
        min_rec_lsn: b_lsn
    };
}

pub fn checkpoint_add_active_tx(
    ckpt: FuzzyCheckpointRecord,
    tx: Int,
    lsn: Int,
    stat: String
) -> FuzzyCheckpointRecord {
    let item: ActiveTxRecord = ActiveTxRecord {
        tx_id: tx,
        last_lsn: lsn,
        status: stat
    };
    let updated: List[ActiveTxRecord] = list_push((ckpt).active_txns, item);
    return FuzzyCheckpointRecord {
        checkpoint_id: (ckpt).checkpoint_id,
        begin_lsn: (ckpt).begin_lsn,
        end_lsn: (ckpt).end_lsn,
        active_txns: updated,
        dirty_pages: (ckpt).dirty_pages,
        min_rec_lsn: (ckpt).min_rec_lsn
    };
}

pub fn checkpoint_add_dirty_page(
    ckpt: FuzzyCheckpointRecord,
    pid: Int,
    r_lsn: Int
) -> FuzzyCheckpointRecord {
    let entry: DirtyPageEntry = DirtyPageEntry {
        page_id: pid,
        rec_lsn: r_lsn
    };
    let updated: List[DirtyPageEntry] = list_push((ckpt).dirty_pages, entry);
    let mut min_l: Int = (ckpt).min_rec_lsn;
    if r_lsn < min_l {
        min_l = r_lsn;
    }

    return FuzzyCheckpointRecord {
        checkpoint_id: (ckpt).checkpoint_id,
        begin_lsn: (ckpt).begin_lsn,
        end_lsn: (ckpt).end_lsn,
        active_txns: (ckpt).active_txns,
        dirty_pages: updated,
        min_rec_lsn: min_l
    };
}

pub fn checkpoint_finalize(ckpt: FuzzyCheckpointRecord, e_lsn: Int) -> FuzzyCheckpointRecord {
    return FuzzyCheckpointRecord {
        checkpoint_id: (ckpt).checkpoint_id,
        begin_lsn: (ckpt).begin_lsn,
        end_lsn: e_lsn,
        active_txns: (ckpt).active_txns,
        dirty_pages: (ckpt).dirty_pages,
        min_rec_lsn: (ckpt).min_rec_lsn
    };
}
