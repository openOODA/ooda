// # MVCC Savepoint & Nested Transaction Manager
//
// Logline: Implements nested transaction savepoints, partial rollback, and mutation delta log unwinding.
//
// Setup: Enables fine-grained error recovery within ongoing transactions without requiring full transaction aborts.
//
// Beats:
//   1. Define SavepointRecord, MutationDelta, and SavepointManager structures.
//   2. Implement savepoint creation capturing mutation stack depth offsets.
//   3. Implement rollback to savepoint reversing uncommitted mutations and restoring snapshot state.

pub type MutationDelta = struct {
    row_id: Int,
    old_value: String,
    new_value: String
};

pub type SavepointRecord = struct {
    savepoint_name: String,
    mutation_index_offset: Int,
    is_active: Bool
};

pub type SavepointManager = struct {
    tx_id: Int,
    savepoints: List[SavepointRecord],
    mutation_history: List[MutationDelta]
};

pub fn savepoint_manager_new(tx: Int) -> SavepointManager {
    let empty_sp: List[SavepointRecord] = list_new();
    let empty_mutations: List[MutationDelta] = list_new();
    return SavepointManager {
        tx_id: tx,
        savepoints: empty_sp,
        mutation_history: empty_mutations
    };
}

pub fn savepoint_create(mgr: SavepointManager, name: String) -> SavepointManager {
    let offset: Int = list_len((mgr).mutation_history);
    let sp: SavepointRecord = SavepointRecord {
        savepoint_name: name,
        mutation_index_offset: offset,
        is_active: true
    };
    let updated_sps: List[SavepointRecord] = list_push((mgr).savepoints, sp);

    return SavepointManager {
        tx_id: (mgr).tx_id,
        savepoints: updated_sps,
        mutation_history: (mgr).mutation_history
    };
}

pub fn savepoint_record_mutation(
    mgr: SavepointManager,
    rid: Int,
    old_val: String,
    new_val: String
) -> SavepointManager {
    let delta: MutationDelta = MutationDelta {
        row_id: rid,
        old_value: old_val,
        new_value: new_val
    };
    let updated_history: List[MutationDelta] = list_push((mgr).mutation_history, delta);

    return SavepointManager {
        tx_id: (mgr).tx_id,
        savepoints: (mgr).savepoints,
        mutation_history: updated_history
    };
}

pub fn savepoint_find_offset(mgr: SavepointManager, name: String) -> Option[Int] {
    let sps: List[SavepointRecord] = (mgr).savepoints;
    let n: Int = list_len(sps);
    let mut i: Int = 0;

    while i < n {
        let sp: SavepointRecord = list_get(sps, i);
        if (sp).is_active && (sp).savepoint_name == name {
            return Some((sp).mutation_index_offset);
        }
        i = i + 1;
    }

    return None;
}
