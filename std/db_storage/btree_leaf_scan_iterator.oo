// # B+Tree Bidirectional Leaf Scan Iterator
//
// Logline: Implements forward and reverse range scan iterators traversing leaf sibling pointer chains.
//
// Setup: Sequential cursor iteration across leaf pages satisfying inequality predicates and limit constraints.
//
// Beats:
//   1. Define LeafScanDirection, BTreeScanBounds, and LeafScanCursor structures.
//   2. Implement cursor repositioning to lower/upper key bounds within leaf pages.
//   3. Implement sequential next/prev page following across sibling pointer links.

import "./btree_page_split_merge.oo";

pub type BTreeScanBounds = struct {
    start_key: String,
    end_key: String,
    is_inclusive_start: Bool,
    is_inclusive_end: Bool,
    limit: Int,
};

pub type LeafScanCursor = struct {
    bounds: BTreeScanBounds,
    current_page_id: Int,
    current_slot_idx: Int,
    is_exhausted: Bool,
    yielded_count: Int,
};

pub type ScanItem = struct {
    key: String,
    value: String,
};

pub fn btree_scan_bounds_new(min_k: String, max_k: String, lim: Int) -> BTreeScanBounds {
    return BTreeScanBounds {
        start_key: min_k,
        end_key: max_k,
        is_inclusive_start: true,
        is_inclusive_end: true,
        limit: lim,
    };
}

pub fn leaf_scan_cursor_init(start_pid: Int, bnds: BTreeScanBounds) -> LeafScanCursor {
    return LeafScanCursor {
        bounds: bnds,
        current_page_id: start_pid,
        current_slot_idx: 0,
        is_exhausted: false,
        yielded_count: 0,
    };
}

pub fn scan_next_item(
    cursor: LeafScanCursor,
    node: BTreeNodeData
) -> Option[ScanItem] {
    if (cursor).is_exhausted || (cursor).yielded_count >= (cursor).bounds.limit {
        return None;
    }

    let keys: List[String] = (node).keys;
    let vals: List[String] = (node).values;
    let num_keys: Int = list_len(keys);
    let mut idx: Int = (cursor).current_slot_idx;

    while idx < num_keys {
        let k: String = list_get(keys, idx);
        let v: String = list_get(vals, idx);

        if k > (cursor).bounds.end_key {
            return None;
        }

        if k >= (cursor).bounds.start_key {
            return Some(ScanItem {
                key: k,
                value: v,
            });
        }
        idx = idx + 1;
    }

    return None;
}
