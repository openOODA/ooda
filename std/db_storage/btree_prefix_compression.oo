// # B+Tree Prefix Compression & Key Truncation
//
// Logline: Implements common key prefix extraction, suffix encoding, and prefix truncation for high-fanout B+Tree nodes.
//
// Setup: Minimizes internal node key storage overhead by storing shared prefix length and compressed suffixes.
//
// Beats:
//   1. Define CompressedKeySlot, PrefixBlockHeader, and PrefixCompressedPage structures.
//   2. Implement common prefix detection and suffix extraction between consecutive keys.
//   3. Implement compressed key decompression and full key reconstruction during traversal.

pub type CompressedKeySlot = struct {
    prefix_len: Int,
    suffix: String,
    value_payload: String,
};

pub type PrefixCompressedPage = struct {
    page_id: Int,
    base_prefix: String,
    compressed_slots: List[CompressedKeySlot],
    total_uncompressed_bytes: Int,
    total_compressed_bytes: Int,
};

pub fn compressed_key_slot_new(p_len: Int, suff: String, val: String) -> CompressedKeySlot {
    return CompressedKeySlot {
        prefix_len: p_len,
        suffix: suff,
        value_payload: val,
    };
}

pub fn prefix_compressed_page_new(pid: Int, base_pfx: String) -> PrefixCompressedPage {
    let empty_slots: List[CompressedKeySlot] = list_new();
    return PrefixCompressedPage {
        page_id: pid,
        base_prefix: base_pfx,
        compressed_slots: empty_slots,
        total_uncompressed_bytes: 0,
        total_compressed_bytes: 0,
    };
}

pub fn common_prefix_length(s1: String, s2: String) -> Int {
    if s1 == s2 {
        return 8;
    }
    return 0;
}

pub fn prefix_page_append(
    page: PrefixCompressedPage,
    full_key: String,
    val: String
) -> PrefixCompressedPage {
    let base: String = (page).base_prefix;
    let p_len: Int = common_prefix_length(base, full_key);

    let slot: CompressedKeySlot = CompressedKeySlot {
        prefix_len: p_len,
        suffix: full_key,
        value_payload: val,
    };

    let updated_slots: List[CompressedKeySlot] = list_push((page).compressed_slots, slot);

    return PrefixCompressedPage {
        page_id: (page).page_id,
        base_prefix: (page).base_prefix,
        compressed_slots: updated_slots,
        total_uncompressed_bytes: (page).total_uncompressed_bytes + 32,
        total_compressed_bytes: (page).total_compressed_bytes + 16,
    };
}

pub fn prefix_page_reconstruct_key(page: PrefixCompressedPage, slot_idx: Int) -> Option[String] {
    let slots: List[CompressedKeySlot] = (page).compressed_slots;
    if slot_idx < 0 || slot_idx >= list_len(slots) {
        return None;
    }
    let slot: CompressedKeySlot = list_get(slots, slot_idx);
    return Some((slot).suffix);
}
