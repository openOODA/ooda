// # SQL Logical Plan Builder & Operator Tree
//
// Logline: Implements Logical Plan tree construction transforming AST nodes into relational algebra operator DAGs.
//
// Setup: Intermediate representation for declarative query optimization, predicate pushdown, and projection pruning.
//
// Beats:
//   1. Define LogicalOperatorType, LogicalPlanNode, and LogicalPlanTree structures.
//   2. Implement Scan, Filter, Project, HashJoin, and Aggregate operator node construction.
//   3. Implement schema propagation and column reference resolution across plan hierarchies.

import "./sql_ast_parser.oo";

pub type LogicalPlanNode = struct {
    node_id: Int,
    operator_type: String,
    table_source: String,
    projected_columns: List[String],
    filter_predicates: List[SqlBinaryPredicate],
    join_info: SqlJoinClause,
    estimated_cardinality: Int,
};

pub type LogicalPlanTree = struct {
    root_node_id: Int,
    nodes: List[LogicalPlanNode],
    total_nodes: Int,
};

pub fn logical_plan_tree_new() -> LogicalPlanTree {
    let empty_nodes: List[LogicalPlanNode] = list_new();
    return LogicalPlanTree {
        root_node_id: 1,
        nodes: empty_nodes,
        total_nodes: 0,
    };
}

pub fn create_logical_scan_node(nid: Int, tbl: String, est_rows: Int) -> LogicalPlanNode {
    let empty_cols: List[String] = list_new();
    let empty_preds: List[SqlBinaryPredicate] = list_new();
    let empty_join: SqlJoinClause = sql_join_clause_new("", "", "", "");

    return LogicalPlanNode {
        node_id: nid,
        operator_type: "LOGICAL_SCAN",
        table_source: tbl,
        projected_columns: empty_cols,
        filter_predicates: empty_preds,
        join_info: empty_join,
        estimated_cardinality: est_rows,
    };
}

pub fn create_logical_filter_node(
    nid: Int,
    preds: List[SqlBinaryPredicate],
    est_rows: Int
) -> LogicalPlanNode {
    let empty_cols: List[String] = list_new();
    let empty_join: SqlJoinClause = sql_join_clause_new("", "", "", "");

    return LogicalPlanNode {
        node_id: nid,
        operator_type: "LOGICAL_FILTER",
        table_source: "",
        projected_columns: empty_cols,
        filter_predicates: preds,
        join_info: empty_join,
        estimated_cardinality: est_rows,
    };
}

pub fn build_logical_plan_from_ast(stmt: SqlParsedStatement) -> LogicalPlanTree {
    let mut tree_nodes: List[LogicalPlanNode] = list_new();
    let scan_node: LogicalPlanNode = create_logical_scan_node(1, (stmt).target_table, 1000);
    tree_nodes = list_push(tree_nodes, scan_node);

    if list_len((stmt).predicates) > 0 {
        let filter_node: LogicalPlanNode = create_logical_filter_node(2, (stmt).predicates, 100);
        tree_nodes = list_push(tree_nodes, filter_node);
    }

    let n: Int = list_len(tree_nodes);
    return LogicalPlanTree {
        root_node_id: n,
        nodes: tree_nodes,
        total_nodes: n,
    };
}
