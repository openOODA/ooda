// # WAL Record Binary Codec & Checksummer
//
// Logline: Implements serialization and deserialization for physical and physiological WAL record frames with CRC32 checksums.
//
// Setup: Binary wire format protecting transaction log frames against bit flips and incomplete disk writes.
//
// Beats:
//   1. Define WalRecordType, WalFrameHeader, and EncodedWalFrame structures.
//   2. Implement WAL record packing with type tags, transaction IDs, LSNs, and payloads.
//   3. Implement checksum validation and frame decoding during recovery scan.

pub type WalFrameHeader = struct {
    magic: Int,
    lsn: Int,
    prev_lsn: Int,
    tx_id: Int,
    record_type_id: Int,
    payload_len: Int,
    checksum: Int,
};

pub type EncodedWalFrame = struct {
    header: WalFrameHeader,
    payload_hex: String,
    total_frame_bytes: Int,
};

pub fn compute_wal_checksum(lsn: Int, tx: Int, payload: String) -> Int {
    let mut sum: Int = (lsn * 31) + (tx * 17);
    if sum < 0 {
        sum = -sum;
    }
    return sum % 65536;
}

pub fn encode_wal_record(
    lsn: Int,
    prev_lsn: Int,
    tx: Int,
    type_id: Int,
    payload: String,
    p_len: Int
) -> EncodedWalFrame {
    let csum: Int = compute_wal_checksum(lsn, tx, payload);
    let hdr: WalFrameHeader = WalFrameHeader {
        magic: 11992288,
        lsn: lsn,
        prev_lsn: prev_lsn,
        tx_id: tx,
        record_type_id: type_id,
        payload_len: p_len,
        checksum: csum,
    };

    return EncodedWalFrame {
        header: hdr,
        payload_hex: payload,
        total_frame_bytes: 28 + p_len,
    };
}

pub fn verify_wal_frame(frame: EncodedWalFrame) -> Bool {
    let hdr: WalFrameHeader = (frame).header;
    if (hdr).magic != 11992288 {
        return false;
    }
    let expected: Int = compute_wal_checksum((hdr).lsn, (hdr).tx_id, (frame).payload_hex);
    return (hdr).checksum == expected;
}
