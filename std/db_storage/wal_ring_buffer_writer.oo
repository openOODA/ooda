// # WAL Ring Buffer Writer & LSN Allocator
//
// Logline: Implements circular in-memory ring buffer for low-latency WAL record staging and monotonic LSN sequence assignment.
//
// Setup: High-concurrency log buffering decoupling transaction execution threads from synchronous disk fsync flushes.
//
// Beats:
//   1. Define WalRecordItem, WalRingBuffer, and WalFlushCursor structures.
//   2. Implement atomic LSN sequencing and slot assignment in circular buffer.
//   3. Implement batch log record draining and flushed LSN watermark advancement.

pub type WalRecordItem = struct {
    lsn: Int,
    tx_id: Int,
    record_type: String,
    page_id: Int,
    payload: String
};

pub type WalRingBuffer = struct {
    capacity_slots: Int,
    head_lsn: Int,
    flushed_lsn: Int,
    records: List[WalRecordItem],
    is_full: Bool
};

pub type WalFlushBatch = struct {
    records_to_flush: List[WalRecordItem],
    target_flushed_lsn: Int,
    batch_count: Int
};

pub fn wal_ring_buffer_new(cap_slots: Int) -> WalRingBuffer {
    let empty_records: List[WalRecordItem] = list_new();
    return WalRingBuffer {
        capacity_slots: cap_slots,
        head_lsn: 1,
        flushed_lsn: 0,
        records: empty_records,
        is_full: false
    };
}

pub fn wal_ring_buffer_append(
    buf: WalRingBuffer,
    tx: Int,
    rec_type: String,
    pid: Int,
    data: String
) -> WalRingBuffer {
    let new_lsn: Int = (buf).head_lsn;
    let item: WalRecordItem = WalRecordItem {
        lsn: new_lsn,
        tx_id: tx,
        record_type: rec_type,
        page_id: pid,
        payload: data
    };

    let updated_records: List[WalRecordItem] = list_push((buf).records, item);
    let count: Int = list_len(updated_records);
    let full: Bool = count >= (buf).capacity_slots;

    return WalRingBuffer {
        capacity_slots: (buf).capacity_slots,
        head_lsn: new_lsn + 1,
        flushed_lsn: (buf).flushed_lsn,
        records: updated_records,
        is_full: full
    };
}

pub fn wal_ring_buffer_drain_for_flush(buf: WalRingBuffer) -> WalFlushBatch {
    let recs: List[WalRecordItem] = (buf).records;
    let n: Int = list_len(recs);
    let mut max_lsn: Int = (buf).flushed_lsn;

    if n > 0 {
        let last_rec: WalRecordItem = list_get(recs, n - 1);
        max_lsn = (last_rec).lsn;
    }

    return WalFlushBatch {
        records_to_flush: recs,
        target_flushed_lsn: max_lsn,
        batch_count: n
    };
}

pub fn wal_ring_buffer_advance_flushed(buf: WalRingBuffer, new_flushed_lsn: Int) -> WalRingBuffer {
    let empty_recs: List[WalRecordItem] = list_new();
    return WalRingBuffer {
        capacity_slots: (buf).capacity_slots,
        head_lsn: (buf).head_lsn,
        flushed_lsn: new_flushed_lsn,
        records: empty_recs,
        is_full: false
    };
}
