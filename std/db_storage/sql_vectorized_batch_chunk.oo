// # SQL Columnar Vectorized Batch Chunk
//
// Logline: Implements columnar vectorized batch chunk execution with selection vectors and cache-aligned memory layout.
//
// Setup: High-performance vectorized query execution (e.g., DuckDB/MonetDB model) processing batches of tuples per CPU cycle.
//
// Beats:
//   1. Define ColumnVector, SelectionVector, and VectorizedDataChunk structures.
//   2. Implement columnar batch allocation and selection vector indexing.
//   3. Implement batch predicate filtering writing active indices into selection vectors.

pub type ColumnVector = struct {
    column_name: String,
    data_type: String,
    int_array: List[Int],
    str_array: List[String],
};

pub type SelectionVector = struct {
    indices: List[Int],
    selected_count: Int,
};

pub type VectorizedDataChunk = struct {
    capacity_tuples: Int,
    current_tuples: Int,
    columns: List[ColumnVector],
    sel_vector: SelectionVector,
};

pub fn column_vector_new(name: String, dtype: String) -> ColumnVector {
    let empty_ints: List[Int] = list_new();
    let empty_strs: List[String] = list_new();
    return ColumnVector {
        column_name: name,
        data_type: dtype,
        int_array: empty_ints,
        str_array: empty_strs,
    };
}

pub fn vectorized_chunk_new(cap: Int) -> VectorizedDataChunk {
    let empty_cols: List[ColumnVector] = list_new();
    let empty_indices: List[Int] = list_new();
    let sel: SelectionVector = SelectionVector {
        indices: empty_indices,
        selected_count: 0,
    };

    return VectorizedDataChunk {
        capacity_tuples: cap,
        current_tuples: 0,
        columns: empty_cols,
        sel_vector: sel,
    };
}

pub fn filter_vector_int_eq(
    vec: ColumnVector,
    target_val: Int
) -> SelectionVector {
    let ints: List[Int] = (vec).int_array;
    let n: Int = list_len(ints);
    let mut passed_indices: List[Int] = list_new();
    let mut count: Int = 0;
    let mut i: Int = 0;

    while i < n {
        let val: Int = list_get(ints, i);
        if val == target_val {
            passed_indices = list_push(passed_indices, i);
            count = count + 1;
        }
        i = i + 1;
    }

    return SelectionVector {
        indices: passed_indices,
        selected_count: count,
    };
}
