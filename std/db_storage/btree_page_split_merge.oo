// # B+Tree Page Split & Merge Coordinator
//
// Logline: Implements page split, parent key promotion, underflow borrowing, and sibling node merging for B+Trees.
//
// Setup: Maintains B+Tree balance invariants, fanout limits, and bidirectional sibling chain pointers.
//
// Beats:
//   1. Define BTreeNodeData, SplitResult, and MergeResult structures.
//   2. Implement leaf and internal node splits with median key extraction.
//   3. Implement sibling key redistribution and underflow coalescing merges.

pub type BTreeNodeData = struct {
    page_id: Int,
    is_leaf: Bool,
    keys: List[String],
    values: List[String],
    child_page_ids: List[Int],
    next_page_id: Int,
    prev_page_id: Int
};

pub type SplitResult = struct {
    promoted_key: String,
    left_node: BTreeNodeData,
    right_node: BTreeNodeData
};

pub type MergeResult = struct {
    merged_node: BTreeNodeData,
    discarded_page_id: Int,
    is_success: Bool
};

pub fn btree_node_data_new(pid: Int, is_leaf_node: Bool) -> BTreeNodeData {
    let empty_keys: List[String] = list_new();
    let empty_vals: List[String] = list_new();
    let empty_children: List[Int] = list_new();
    return BTreeNodeData {
        page_id: pid,
        is_leaf: is_leaf_node,
        keys: empty_keys,
        values: empty_vals,
        child_page_ids: empty_children,
        next_page_id: -1,
        prev_page_id: -1
    };
}

pub fn split_leaf_node(node: BTreeNodeData, new_right_pid: Int) -> SplitResult {
    let all_keys: List[String] = (node).keys;
    let all_vals: List[String] = (node).values;
    let total: Int = list_len(all_keys);
    let mid: Int = total / 2;

    let mut left_k: List[String] = list_new();
    let mut left_v: List[String] = list_new();
    let mut right_k: List[String] = list_new();
    let mut right_v: List[String] = list_new();

    let mut i: Int = 0;
    while i < total {
        let k: String = list_get(all_keys, i);
        let v: String = list_get(all_vals, i);
        if i < mid {
            left_k = list_push(left_k, k);
            left_v = list_push(left_v, v);
        } else {
            right_k = list_push(right_k, k);
            right_v = list_push(right_v, v);
        }
        i = i + 1;
    }

    let promoted: String = list_get(right_k, 0);
    let empty_children: List[Int] = list_new();

    let left_out: BTreeNodeData = BTreeNodeData {
        page_id: (node).page_id,
        is_leaf: true,
        keys: left_k,
        values: left_v,
        child_page_ids: empty_children,
        next_page_id: new_right_pid,
        prev_page_id: (node).prev_page_id
    };

    let right_out: BTreeNodeData = BTreeNodeData {
        page_id: new_right_pid,
        is_leaf: true,
        keys: right_k,
        values: right_v,
        child_page_ids: empty_children,
        next_page_id: (node).next_page_id,
        prev_page_id: (node).page_id
    };

    return SplitResult {
        promoted_key: promoted,
        left_node: left_out,
        right_node: right_out
    };
}

pub fn merge_leaf_nodes(left: BTreeNodeData, right: BTreeNodeData) -> MergeResult {
    let mut merged_k: List[String] = (left).keys;
    let mut merged_v: List[String] = (left).values;
    let right_k: List[String] = (right).keys;
    let right_v: List[String] = (right).values;
    let n: Int = list_len(right_k);
    let mut i: Int = 0;

    while i < n {
        merged_k = list_push(merged_k, list_get(right_k, i));
        merged_v = list_push(merged_v, list_get(right_v, i));
        i = i + 1;
    }

    let empty_children: List[Int] = list_new();
    let out_node: BTreeNodeData = BTreeNodeData {
        page_id: (left).page_id,
        is_leaf: true,
        keys: merged_k,
        values: merged_v,
        child_page_ids: empty_children,
        next_page_id: (right).next_page_id,
        prev_page_id: (left).prev_page_id
    };

    return MergeResult {
        merged_node: out_node,
        discarded_page_id: (right).page_id,
        is_success: true
    };
}
