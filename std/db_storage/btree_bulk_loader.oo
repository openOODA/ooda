// # B+Tree Bottom-Up Bulk Loader
//
// Logline: Implements high-throughput bottom-up B+Tree construction from pre-sorted key-value streams.
//
// Setup: Builds dense tree levels layer-by-layer avoiding random I/O splits during initial index creation.
//
// Beats:
//   1. Define BulkLoaderConfig, BulkLoadLevel, and BTreeBulkLoader structures.
//   2. Implement leaf page packing respecting target fill factor percentages.
//   3. Implement recursive parent node construction from promoted split separator keys.

pub type BulkLoaderConfig = struct {
    page_capacity_keys: Int,
    fill_factor_ratio: Float,
    is_unique: Bool,
};

pub type BulkLoadLevel = struct {
    level_num: Int,
    current_page_id: Int,
    accumulated_keys: List[String],
    accumulated_child_ids: List[Int],
};

pub type BTreeBulkLoader = struct {
    config: BulkLoaderConfig,
    next_page_id: Int,
    levels: List[BulkLoadLevel],
    total_records_loaded: Int,
    root_page_id: Int,
};

pub fn bulk_loader_config_default() -> BulkLoaderConfig {
    return BulkLoaderConfig {
        page_capacity_keys: 128,
        fill_factor_ratio: 0.85,
        is_unique: true,
    };
}

pub fn btree_bulk_loader_new(cfg: BulkLoaderConfig) -> BTreeBulkLoader {
    let mut initial_levels: List[BulkLoadLevel] = list_new();
    let empty_k: List[String] = list_new();
    let empty_c: List[Int] = list_new();
    let leaf_lvl: BulkLoadLevel = BulkLoadLevel {
        level_num: 0,
        current_page_id: 1,
        accumulated_keys: empty_k,
        accumulated_child_ids: empty_c,
    };
    initial_levels = list_push(initial_levels, leaf_lvl);

    return BTreeBulkLoader {
        config: cfg,
        next_page_id: 2,
        levels: initial_levels,
        total_records_loaded: 0,
        root_page_id: 1,
    };
}

pub fn bulk_loader_add(loader: BTreeBulkLoader, key: String, val: String) -> BTreeBulkLoader {
    let lvls: List[BulkLoadLevel] = (loader).levels;
    let leaf: BulkLoadLevel = list_get(lvls, 0);
    let updated_k: List[String] = list_push((leaf).accumulated_keys, key);

    let updated_leaf: BulkLoadLevel = BulkLoadLevel {
        level_num: 0,
        current_page_id: (leaf).current_page_id,
        accumulated_keys: updated_k,
        accumulated_child_ids: (leaf).accumulated_child_ids,
    };

    let mut new_levels: List[BulkLoadLevel] = list_new();
    new_levels = list_push(new_levels, updated_leaf);

    return BTreeBulkLoader {
        config: (loader).config,
        next_page_id: (loader).next_page_id,
        levels: new_levels,
        total_records_loaded: (loader).total_records_loaded + 1,
        root_page_id: (loader).root_page_id,
    };
}

pub fn bulk_loader_finish(loader: BTreeBulkLoader) -> Int {
    return (loader).root_page_id;
}
