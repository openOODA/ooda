// # MVCC Undo Log Garbage Collector & Vacuum
//
// Logline: Implements background vacuum and undo segment garbage collection below oldest active snapshot watermarks.
//
// Setup: Reclaims dead tuple storage and unlinks unreachable undo log delta records to bound storage bloat.
//
// Beats:
//   1. Define UndoSegment, VacuumWatermark, and UndoGarbageCollector structures.
//   2. Implement oldest active transaction watermark evaluation.
//   3. Implement dead tuple pruning and undo log segment compaction.

pub type UndoLogRecord = struct {
    undo_lsn: Int,
    tx_id: Int,
    row_id: Int,
    delta_payload: String,
    is_reclaimed: Bool,
};

pub type UndoSegment = struct {
    segment_id: Int,
    records: List[UndoLogRecord],
    total_records: Int,
};

pub type UndoGarbageCollector = struct {
    oldest_active_tx_watermark: Int,
    segments: List[UndoSegment],
    total_reclaimed_records: Int,
};

pub fn undo_segment_new(sid: Int) -> UndoSegment {
    let empty_recs: List[UndoLogRecord] = list_new();
    return UndoSegment {
        segment_id: sid,
        records: empty_recs,
        total_records: 0,
    };
}

pub fn undo_garbage_collector_new() -> UndoGarbageCollector {
    let empty_segs: List[UndoSegment] = list_new();
    return UndoGarbageCollector {
        oldest_active_tx_watermark: 0,
        segments: empty_segs,
        total_reclaimed_records: 0,
    };
}

pub fn gc_advance_watermark(
    gc: UndoGarbageCollector,
    new_watermark: Int
) -> UndoGarbageCollector {
    return UndoGarbageCollector {
        oldest_active_tx_watermark: new_watermark,
        segments: (gc).segments,
        total_reclaimed_records: (gc).total_reclaimed_records,
    };
}

pub fn gc_collect_segment(
    gc: UndoGarbageCollector,
    seg: UndoSegment
) -> UndoSegment {
    let wmark: Int = (gc).oldest_active_tx_watermark;
    let old_recs: List[UndoLogRecord] = (seg).records;
    let n: Int = list_len(old_recs);
    let mut cleaned_recs: List[UndoLogRecord] = list_new();
    let mut i: Int = 0;

    while i < n {
        let rec: UndoLogRecord = list_get(old_recs, i);
        if (rec).tx_id < wmark {
            let reclaimed: UndoLogRecord = UndoLogRecord {
                undo_lsn: (rec).undo_lsn,
                tx_id: (rec).tx_id,
                row_id: (rec).row_id,
                delta_payload: "",
                is_reclaimed: true,
            };
            cleaned_recs = list_push(cleaned_recs, reclaimed);
        } else {
            cleaned_recs = list_push(cleaned_recs, rec);
        }
        i = i + 1;
    }

    return UndoSegment {
        segment_id: (seg).segment_id,
        records: cleaned_recs,
        total_records: (seg).total_records,
    };
}
