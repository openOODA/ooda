// # SQL Volcano Iterator Execution Engine
//
// Logline: Implements Volcano query execution iterator (Init/Next/Close) for sequential table scans and index scans.
//
// Setup: Pipelined pull-based tuple execution model streaming tuples between relational operators.
//
// Beats:
//   1. Define ExecutionTuple, VolcanoIteratorState, and SeqScanIterator structures.
//   2. Implement Init, Next, and Close lifecycle methods for table scans.
//   3. Implement tuple extraction, qualification against filter predicates, and cursor advancement.

pub type ExecutionTuple = struct {
    tuple_id: Int,
    fields: List[String],
    is_valid: Bool,
};

pub type SeqScanIterator = struct {
    table_name: String,
    current_cursor: Int,
    total_tuples: Int,
    tuples: List[ExecutionTuple],
    is_open: Bool,
};

pub fn seq_scan_iterator_new(tbl: String, data: List[ExecutionTuple]) -> SeqScanIterator {
    return SeqScanIterator {
        table_name: tbl,
        current_cursor: 0,
        total_tuples: list_len(data),
        tuples: data,
        is_open: false,
    };
}

pub fn seq_scan_open(iter: SeqScanIterator) -> SeqScanIterator {
    return SeqScanIterator {
        table_name: (iter).table_name,
        current_cursor: 0,
        total_tuples: (iter).total_tuples,
        tuples: (iter).tuples,
        is_open: true,
    };
}

pub fn seq_scan_next(iter: SeqScanIterator) -> Option[ExecutionTuple] {
    if !(iter).is_open {
        return None;
    }
    let cur: Int = (iter).current_cursor;
    let tot: Int = (iter).total_tuples;
    if cur >= tot {
        return None;
    }

    let tuple_item: ExecutionTuple = list_get((iter).tuples, cur);
    return Some(tuple_item);
}

pub fn seq_scan_advance(iter: SeqScanIterator) -> SeqScanIterator {
    return SeqScanIterator {
        table_name: (iter).table_name,
        current_cursor: (iter).current_cursor + 1,
        total_tuples: (iter).total_tuples,
        tuples: (iter).tuples,
        is_open: (iter).is_open,
    };
}

pub fn seq_scan_close(iter: SeqScanIterator) -> SeqScanIterator {
    return SeqScanIterator {
        table_name: (iter).table_name,
        current_cursor: (iter).current_cursor,
        total_tuples: (iter).total_tuples,
        tuples: (iter).tuples,
        is_open: false,
    };
}
