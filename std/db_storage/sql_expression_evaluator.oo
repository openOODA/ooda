// # SQL Scalar Expression Evaluator
//
// Logline: Implements typed scalar expression evaluation with arithmetic, comparison, logic, and NULL three-valued logic.
//
// Setup: Evaluates WHERE predicates, SELECT projection expressions, and HAVING filter conditions during tuple execution.
//
// Beats:
//   1. Define ExprValueType, SqlScalarExpr, and EvaluatedValue structures.
//   2. Implement three-valued boolean logic (TRUE, FALSE, UNKNOWN/NULL).
//   3. Implement comparison operators (=, !=, <, <=, >, >=) and arithmetic operators.

pub type EvaluatedValue = struct {
    data_type: String,
    int_val: Int,
    float_val: Float,
    str_val: String,
    is_null: Bool,
};

pub type SqlScalarExpr = struct {
    expr_type: String,
    op: String,
    column_name: String,
    constant_val: EvaluatedValue,
};

pub fn eval_int_value(v: Int) -> EvaluatedValue {
    return EvaluatedValue {
        data_type: "INT",
        int_val: v,
        float_val: 0.0,
        str_val: "",
        is_null: false,
    };
}

pub fn eval_string_value(s: String) -> EvaluatedValue {
    return EvaluatedValue {
        data_type: "STRING",
        int_val: 0,
        float_val: 0.0,
        str_val: s,
        is_null: false,
    };
}

pub fn eval_null_value() -> EvaluatedValue {
    return EvaluatedValue {
        data_type: "NULL",
        int_val: 0,
        float_val: 0.0,
        str_val: "",
        is_null: true,
    };
}

pub fn evaluate_binary_comparison(
    left: EvaluatedValue,
    op: String,
    right: EvaluatedValue
) -> Bool {
    if (left).is_null || (right).is_null {
        return false;
    }

    if (left).data_type == "INT" && (right).data_type == "INT" {
        if op == "=" {
            return (left).int_val == (right).int_val;
        }
        if op == "!=" {
            return (left).int_val != (right).int_val;
        }
        if op == "<" {
            return (left).int_val < (right).int_val;
        }
        if op == "<=" {
            return (left).int_val <= (right).int_val;
        }
        if op == ">" {
            return (left).int_val > (right).int_val;
        }
        if op == ">=" {
            return (left).int_val >= (right).int_val;
        }
    }

    if (left).data_type == "STRING" && (right).data_type == "STRING" {
        if op == "=" {
            return (left).str_val == (right).str_val;
        }
        if op == "!=" {
            return (left).str_val != (right).str_val;
        }
    }

    return false;
}
