// # MVCC Commit Timestamp Manager & Hybrid Logical Clock
//
// Logline: Implements monotonic commit timestamp allocation using Hybrid Logical Clocks (HLC) for linearizable ordering.
//
// Setup: Generates causality-preserving transaction commit timestamps without central hardware clock synchronization dependencies.
//
// Beats:
//   1. Define HlcTimestamp, CommitTimestampRecord, and TimestampManager structures.
//   2. Implement HLC physical and logical counter advancement upon message receipt.
//   3. Implement monotonic commit timestamp allocation and transaction serialization ordering.

pub type HlcTimestamp = struct {
    physical_time_ms: Int,
    logical_counter: Int,
};

pub type CommitTimestampRecord = struct {
    tx_id: Int,
    commit_ts: HlcTimestamp,
};

pub type TimestampManager = struct {
    latest_hlc: HlcTimestamp,
    commit_records: List[CommitTimestampRecord],
    total_allocated: Int,
};

pub fn hlc_timestamp_new(phys: Int, log: Int) -> HlcTimestamp {
    return HlcTimestamp {
        physical_time_ms: phys,
        logical_counter: log,
    };
}

pub fn timestamp_manager_new() -> TimestampManager {
    let empty_records: List[CommitTimestampRecord] = list_new();
    let initial_hlc: HlcTimestamp = hlc_timestamp_new(0, 0);

    return TimestampManager {
        latest_hlc: initial_hlc,
        commit_records: empty_records,
        total_allocated: 0,
    };
}

pub fn hlc_compare(t1: HlcTimestamp, t2: HlcTimestamp) -> Int {
    if (t1).physical_time_ms < (t2).physical_time_ms {
        return -1;
    }
    if (t1).physical_time_ms > (t2).physical_time_ms {
        return 1;
    }
    if (t1).logical_counter < (t2).logical_counter {
        return -1;
    }
    if (t1).logical_counter > (t2).logical_counter {
        return 1;
    }
    return 0;
}

pub fn allocate_commit_timestamp(
    mgr: TimestampManager,
    tx: Int,
    physical_now_ms: Int
) -> TimestampManager {
    let prev: HlcTimestamp = (mgr).latest_hlc;
    let mut next_phys: Int = physical_now_ms;
    let mut next_log: Int = 0;

    if physical_now_ms > (prev).physical_time_ms {
        next_phys = physical_now_ms;
        next_log = 0;
    } else {
        next_phys = (prev).physical_time_ms;
        next_log = (prev).logical_counter + 1;
    }

    let allocated_ts: HlcTimestamp = hlc_timestamp_new(next_phys, next_log);
    let record: CommitTimestampRecord = CommitTimestampRecord {
        tx_id: tx,
        commit_ts: allocated_ts,
    };

    let updated_records: List[CommitTimestampRecord] = list_push((mgr).commit_records, record);

    return TimestampManager {
        latest_hlc: allocated_ts,
        commit_records: updated_records,
        total_allocated: (mgr).total_allocated + 1,
    };
}
