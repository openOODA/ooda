// # B+Tree Slotted Page Memory & Disk Layout
//
// Logline: Implements slotted page layout with bidirectional slot directory, variable-length tuple packing, and defragmentation.
//
// Setup: Canonical 8KB / 16KB database page format with slot pointers growing forward and payload data growing backward.
//
// Beats:
//   1. Define PageSlot, SlottedPageHeader, and SlottedPage structures.
//   2. Implement tuple slot allocation, space availability checks, and record placement.
//   3. Implement slot marking, tombstone deletion, and contiguous free space defragmentation.

pub type PageSlot = struct {
    offset: Int,
    length: Int,
    is_deleted: Bool
};

pub type SlottedPageHeader = struct {
    page_id: Int,
    lsn: Int,
    slot_count: Int,
    free_space_pointer: Int,
    lower_offset: Int,
    upper_offset: Int,
    is_leaf: Bool
};

pub type SlottedPage = struct {
    header: SlottedPageHeader,
    page_size: Int,
    slots: List[PageSlot],
    payload_data: List[String]
};

pub fn slotted_page_new(pid: Int, is_leaf_page: Bool, psize: Int) -> SlottedPage {
    let empty_slots: List[PageSlot] = list_new();
    let empty_payload: List[String] = list_new();
    let hdr: SlottedPageHeader = SlottedPageHeader {
        page_id: pid,
        lsn: 0,
        slot_count: 0,
        free_space_pointer: psize,
        lower_offset: 32,
        upper_offset: psize,
        is_leaf: is_leaf_page
    };
    return SlottedPage {
        header: hdr,
        page_size: psize,
        slots: empty_slots,
        payload_data: empty_payload
    };
}

pub fn slotted_page_free_space(page: SlottedPage) -> Int {
    let lower: Int = (page).header.lower_offset;
    let upper: Int = (page).header.upper_offset;
    if upper <= lower {
        return 0;
    }
    return upper - lower;
}

pub fn slotted_page_insert_tuple(page: SlottedPage, tuple_str: String, tuple_len: Int) -> Option[SlottedPage] {
    let slot_overhead: Int = 8;
    let required_space: Int = tuple_len + slot_overhead;
    let available: Int = slotted_page_free_space(page);

    if available < required_space {
        return None;
    }

    let hdr: SlottedPageHeader = (page).header;
    let new_upper: Int = (hdr).upper_offset - tuple_len;
    let new_lower: Int = (hdr).lower_offset + slot_overhead;

    let slot: PageSlot = PageSlot {
        offset: new_upper,
        length: tuple_len,
        is_deleted: false
    };

    let updated_slots: List[PageSlot] = list_push((page).slots, slot);
    let updated_data: List[String] = list_push((page).payload_data, tuple_str);

    let updated_hdr: SlottedPageHeader = SlottedPageHeader {
        page_id: (hdr).page_id,
        lsn: (hdr).lsn + 1,
        slot_count: (hdr).slot_count + 1,
        free_space_pointer: new_upper,
        lower_offset: new_lower,
        upper_offset: new_upper,
        is_leaf: (hdr).is_leaf
    };

    return Some(SlottedPage {
        header: updated_hdr,
        page_size: (page).page_size,
        slots: updated_slots,
        payload_data: updated_data
    });
}

pub fn slotted_page_delete_slot(page: SlottedPage, slot_idx: Int) -> SlottedPage {
    let old_slots: List[PageSlot] = (page).slots;
    let n: Int = list_len(old_slots);
    let mut new_slots: List[PageSlot] = list_new();
    let mut i: Int = 0;

    while i < n {
        let s: PageSlot = list_get(old_slots, i);
        if i == slot_idx {
            let deleted_slot: PageSlot = PageSlot {
                offset: (s).offset,
                length: (s).length,
                is_deleted: true
            };
            new_slots = list_push(new_slots, deleted_slot);
        } else {
            new_slots = list_push(new_slots, s);
        }
        i = i + 1;
    }

    return SlottedPage {
        header: (page).header,
        page_size: (page).page_size,
        slots: new_slots,
        payload_data: (page).payload_data
    };
}
