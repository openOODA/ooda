// # MVCC Snapshot Isolation & Transaction Context
//
// Logline: Implements Snapshot Isolation (SI) transaction context, point-in-time read snapshots, and first-committer-wins validation.
//
// Setup: Provides repeatable read semantics and detects concurrent write conflicts under Snapshot Isolation.
//
// Beats:
//   1. Define TxSnapshotDescriptor, TransactionContext, and IsolationLevel structures.
//   2. Implement point-in-time snapshot capture registering active in-flight transaction IDs.
//   3. Implement write-write conflict detection and first-committer-wins validation.

pub type TxSnapshotDescriptor = struct {
    snapshot_tx_id: Int,
    snapshot_xmin: Int,
    snapshot_xmax: Int,
    active_tx_ids: List[Int],
};

pub type TransactionContext = struct {
    tx_id: Int,
    isolation_level: String,
    snapshot: TxSnapshotDescriptor,
    write_set_row_ids: List[Int],
    is_committed: Bool,
    is_aborted: Bool,
};

pub fn snapshot_descriptor_create(
    tx: Int,
    xmin_val: Int,
    xmax_val: Int,
    active_list: List[Int]
) -> TxSnapshotDescriptor {
    return TxSnapshotDescriptor {
        snapshot_tx_id: tx,
        snapshot_xmin: xmin_val,
        snapshot_xmax: xmax_val,
        active_tx_ids: active_list,
    };
}

pub fn transaction_context_begin(
    tx: Int,
    iso_lvl: String,
    snap: TxSnapshotDescriptor
) -> TransactionContext {
    let empty_writes: List[Int] = list_new();
    return TransactionContext {
        tx_id: tx,
        isolation_level: iso_lvl,
        snapshot: snap,
        write_set_row_ids: empty_writes,
        is_committed: false,
        is_aborted: false,
    };
}

pub fn tx_record_write(ctx: TransactionContext, row_id: Int) -> TransactionContext {
    let updated_writes: List[Int] = list_push((ctx).write_set_row_ids, row_id);
    return TransactionContext {
        tx_id: (ctx).tx_id,
        isolation_level: (ctx).isolation_level,
        snapshot: (ctx).snapshot,
        write_set_row_ids: updated_writes,
        is_committed: false,
        is_aborted: false,
    };
}

pub fn check_write_conflict(
    ctx: TransactionContext,
    committed_writes: List[Int]
) -> Bool {
    let my_writes: List[Int] = (ctx).write_set_row_ids;
    let n_mine: Int = list_len(my_writes);
    let n_comm: Int = list_len(committed_writes);

    let mut i: Int = 0;
    while i < n_mine {
        let r1: Int = list_get(my_writes, i);
        let mut j: Int = 0;
        while j < n_comm {
            let r2: Int = list_get(committed_writes, j);
            if r1 == r2 {
                return true;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    return false;
}
