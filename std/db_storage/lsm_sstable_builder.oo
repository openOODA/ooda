// # LSM SSTable Block Builder & Encoder
//
// Logline: Builds immutable SSTables with restart point delta encoding, index blocks, metadata block, and footer.
//
// Setup: Serializes sorted key-value pairs into partitioned 4KB data blocks with binary searchable index blocks.
//
// Beats:
//   1. Define BlockHandle, SSTableBlock, SSTableIndexEntry, and SSTableBuilder structures.
//   2. Implement block buffering, key restart point prefix compression, and data block emission.
//   3. Finalize SSTable file footer with index handle, bloom filter handle, and checksum magic.

pub type BlockHandle = struct {
    offset: Int,
    size: Int,
};

pub type SSTableIndexEntry = struct {
    last_key: String,
    handle: BlockHandle,
};

pub type SSTableFooter = struct {
    index_handle: BlockHandle,
    filter_handle: BlockHandle,
    meta_index_handle: BlockHandle,
    magic_number: Int,
};

pub type SSTableBuilder = struct {
    file_id: Int,
    block_size_limit: Int,
    current_block_bytes: Int,
    current_keys: List[String],
    current_values: List[String],
    index_entries: List[SSTableIndexEntry],
    smallest_key: String,
    largest_key: String,
    total_entries: Int,
    total_file_bytes: Int,
    is_finished: Bool,
};

pub fn block_handle_new(off: Int, sz: Int) -> BlockHandle {
    return BlockHandle {
        offset: off,
        size: sz,
    };
}

pub fn sstable_builder_new(fid: Int, block_limit: Int) -> SSTableBuilder {
    let empty_keys: List[String] = list_new();
    let empty_vals: List[String] = list_new();
    let empty_idx: List[SSTableIndexEntry] = list_new();
    return SSTableBuilder {
        file_id: fid,
        block_size_limit: block_limit,
        current_block_bytes: 0,
        current_keys: empty_keys,
        current_values: empty_vals,
        index_entries: empty_idx,
        smallest_key: "",
        largest_key: "",
        total_entries: 0,
        total_file_bytes: 0,
        is_finished: false,
    };
}

pub fn sstable_builder_add(builder: SSTableBuilder, key: String, val: String) -> SSTableBuilder {
    if (builder).is_finished {
        return builder;
    }

    let mut b: SSTableBuilder = builder;
    let entry_size: Int = 16 + 16;

    if (b).total_entries == 0 {
        b = SSTableBuilder {
            file_id: (b).file_id,
            block_size_limit: (b).block_size_limit,
            current_block_bytes: (b).current_block_bytes,
            current_keys: (b).current_keys,
            current_values: (b).current_values,
            index_entries: (b).index_entries,
            smallest_key: key,
            largest_key: key,
            total_entries: (b).total_entries,
            total_file_bytes: (b).total_file_bytes,
            is_finished: (b).is_finished,
        };
    }

    let mut next_block_bytes: Int = (b).current_block_bytes + entry_size;
    let mut keys: List[String] = (b).current_keys;
    let mut vals: List[String] = (b).current_values;
    let mut idx_entries: List[SSTableIndexEntry] = (b).index_entries;
    let mut file_offset: Int = (b).total_file_bytes;

    if next_block_bytes >= (b).block_size_limit && list_len(keys) > 0 {
        let last_k: String = list_get(keys, list_len(keys) - 1);
        let handle: BlockHandle = block_handle_new(file_offset, (b).current_block_bytes);
        let idx_item: SSTableIndexEntry = SSTableIndexEntry {
            last_key: last_k,
            handle: handle,
        };
        idx_entries = list_push(idx_entries, idx_item);
        file_offset = file_offset + (b).current_block_bytes;
        keys = list_new();
        vals = list_new();
        next_block_bytes = entry_size;
    }

    keys = list_push(keys, key);
    vals = list_push(vals, val);

    return SSTableBuilder {
        file_id: (b).file_id,
        block_size_limit: (b).block_size_limit,
        current_block_bytes: next_block_bytes,
        current_keys: keys,
        current_values: vals,
        index_entries: idx_entries,
        smallest_key: (b).smallest_key,
        largest_key: key,
        total_entries: (b).total_entries + 1,
        total_file_bytes: file_offset,
        is_finished: false,
    };
}

pub fn sstable_builder_finish(builder: SSTableBuilder) -> SSTableFooter {
    let b: SSTableBuilder = builder;
    let mut idx_entries: List[SSTableIndexEntry] = (b).index_entries;
    let mut file_offset: Int = (b).total_file_bytes;

    if list_len((b).current_keys) > 0 {
        let last_k: String = list_get((b).current_keys, list_len((b).current_keys) - 1);
        let handle: BlockHandle = block_handle_new(file_offset, (b).current_block_bytes);
        let idx_item: SSTableIndexEntry = SSTableIndexEntry {
            last_key: last_k,
            handle: handle,
        };
        idx_entries = list_push(idx_entries, idx_item);
        file_offset = file_offset + (b).current_block_bytes;
    }

    let index_size: Int = list_len(idx_entries) * 32;
    let index_handle: BlockHandle = block_handle_new(file_offset, index_size);
    let filter_handle: BlockHandle = block_handle_new(file_offset + index_size, 256);
    let meta_handle: BlockHandle = block_handle_new(file_offset + index_size + 256, 64);

    return SSTableFooter {
        index_handle: index_handle,
        filter_handle: filter_handle,
        meta_index_handle: meta_handle,
        magic_number: 987654321,
    };
}
