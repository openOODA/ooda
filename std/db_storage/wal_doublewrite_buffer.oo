// # WAL Doublewrite Buffer & Torn-Page Guard
//
// Logline: Implements doublewrite buffer protecting storage pages from torn-page writes during OS crashes.
//
// Setup: Stages full dirty pages into contiguous doublewrite disk slots before flushing to their final data file offsets.
//
// Beats:
//   1. Define DoublewriteSlot, DoublewriteBufferConfig, and DoublewriteBuffer structures.
//   2. Implement contiguous slot batching and sequential doublewrite disk sync.
//   3. Implement crash recovery torn-page detection and doublewrite page restoration.

pub type DoublewriteSlot = struct {
    slot_id: Int,
    page_id: Int,
    lsn: Int,
    page_payload: String,
    is_valid: Bool
};

pub type DoublewriteBuffer = struct {
    total_slots: Int,
    slots: List[DoublewriteSlot],
    flushed_count: Int
};

pub fn doublewrite_buffer_new(num_slots: Int) -> DoublewriteBuffer {
    let mut initial_slots: List[DoublewriteSlot] = list_new();
    let mut i: Int = 0;
    while i < num_slots {
        let slot: DoublewriteSlot = DoublewriteSlot {
            slot_id: i,
            page_id: -1,
            lsn: 0,
            page_payload: "",
            is_valid: false
        };
        initial_slots = list_push(initial_slots, slot);
        i = i + 1;
    }

    return DoublewriteBuffer {
        total_slots: num_slots,
        slots: initial_slots,
        flushed_count: 0
    };
}

pub fn doublewrite_stage_page(
    buf: DoublewriteBuffer,
    slot_idx: Int,
    pid: Int,
    lsn: Int,
    data: String
) -> DoublewriteBuffer {
    let old_slots: List[DoublewriteSlot] = (buf).slots;
    let n: Int = list_len(old_slots);
    let mut updated: List[DoublewriteSlot] = list_new();
    let mut i: Int = 0;

    while i < n {
        let s: DoublewriteSlot = list_get(old_slots, i);
        if (s).slot_id == slot_idx {
            let staged: DoublewriteSlot = DoublewriteSlot {
                slot_id: slot_idx,
                page_id: pid,
                lsn: lsn,
                page_payload: data,
                is_valid: true
            };
            updated = list_push(updated, staged);
        } else {
            updated = list_push(updated, s);
        }
        i = i + 1;
    }

    return DoublewriteBuffer {
        total_slots: (buf).total_slots,
        slots: updated,
        flushed_count: (buf).flushed_count + 1
    };
}

pub fn doublewrite_recover_page(buf: DoublewriteBuffer, target_pid: Int) -> Option[DoublewriteSlot] {
    let slots_list: List[DoublewriteSlot] = (buf).slots;
    let n: Int = list_len(slots_list);
    let mut i: Int = 0;

    while i < n {
        let s: DoublewriteSlot = list_get(slots_list, i);
        if (s).is_valid && (s).page_id == target_pid {
            return Some(s);
        }
        i = i + 1;
    }

    return None;
}
