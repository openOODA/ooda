// # SQL Abstract Syntax Tree & Parser
//
// Logline: Implements SQL AST tokenization, recursive descent parsing for SELECT/INSERT/UPDATE/DELETE statements, and filter predicates.
//
// Setup: Transforms raw SQL string queries into typed Abstract Syntax Tree (AST) node representations.
//
// Beats:
//   1. Define SqlToken, SqlBinaryPredicate, and SqlParsedStatement structures.
//   2. Implement SQL keyword and identifier tokenization.
//   3. Implement recursive descent statement parsing into structured AST representations.

pub type SqlBinaryPredicate = struct {
    column_name: String,
    operator: String,
    literal_value: String,
};

pub type SqlJoinClause = struct {
    join_type: String,
    right_table: String,
    left_column: String,
    right_column: String,
};

pub type SqlParsedStatement = struct {
    statement_type: String,
    target_table: String,
    projection_columns: List[String],
    predicates: List[SqlBinaryPredicate],
    joins: List[SqlJoinClause],
    limit_count: Int,
};

pub fn sql_predicate_new(col: String, op: String, val: String) -> SqlBinaryPredicate {
    return SqlBinaryPredicate {
        column_name: col,
        operator: op,
        literal_value: val,
    };
}

pub fn sql_join_clause_new(jtype: String, rtbl: String, lcol: String, rcol: String) -> SqlJoinClause {
    return SqlJoinClause {
        join_type: jtype,
        right_table: rtbl,
        left_column: lcol,
        right_column: rcol,
    };
}

pub fn sql_parsed_statement_new(stype: String, tbl: String) -> SqlParsedStatement {
    let empty_cols: List[String] = list_new();
    let empty_preds: List[SqlBinaryPredicate] = list_new();
    let empty_joins: List[SqlJoinClause] = list_new();

    return SqlParsedStatement {
        statement_type: stype,
        target_table: tbl,
        projection_columns: empty_cols,
        predicates: empty_preds,
        joins: empty_joins,
        limit_count: -1,
    };
}

pub fn sql_parse_simple_select(tbl: String, col: String, limit: Int) -> SqlParsedStatement {
    let mut cols: List[String] = list_new();
    cols = list_push(cols, col);
    let empty_preds: List[SqlBinaryPredicate] = list_new();
    let empty_joins: List[SqlJoinClause] = list_new();

    return SqlParsedStatement {
        statement_type: "SELECT",
        target_table: tbl,
        projection_columns: cols,
        predicates: empty_preds,
        joins: empty_joins,
        limit_count: limit,
    };
}

pub fn sql_add_predicate(stmt: SqlParsedStatement, pred: SqlBinaryPredicate) -> SqlParsedStatement {
    let updated_preds: List[SqlBinaryPredicate] = list_push((stmt).predicates, pred);
    return SqlParsedStatement {
        statement_type: (stmt).statement_type,
        target_table: (stmt).target_table,
        projection_columns: (stmt).projection_columns,
        predicates: updated_preds,
        joins: (stmt).joins,
        limit_count: (stmt).limit_count,
    };
}
