// # LSM LRU & 2Q Block Cache
//
// Logline: Implements in-memory page and block caching with LRU eviction, memory budgeting, and hit/miss telemetry.
//
// Setup: Uncompressed data and index block cache eliminating redundant disk block decompression.
//
// Beats:
//   1. Define BlockCacheEntry, BlockCacheConfig, and LruBlockCache structures.
//   2. Implement cache insertion, touch on access, and least-recently-used eviction.
//   3. Implement cache purge, capacity re-sizing, and hit-ratio telemetry accounting.

pub type BlockCacheEntry = struct {
    cache_key: String,
    block_bytes: Int,
    access_timestamp: Int,
    payload_preview: String
};

pub type BlockCacheConfig = struct {
    capacity_bytes: Int,
    max_entries: Int,
    high_priority_ratio: Float
};

pub type LruBlockCache = struct {
    config: BlockCacheConfig,
    current_bytes: Int,
    entries: List[BlockCacheEntry],
    hits: Int,
    misses: Int,
    evictions: Int
};

pub fn block_cache_config_default() -> BlockCacheConfig {
    return BlockCacheConfig {
        capacity_bytes: 67108864,
        max_entries: 4096,
        high_priority_ratio: 0.25
    };
}

pub fn lru_block_cache_new(cfg: BlockCacheConfig) -> LruBlockCache {
    let empty_entries: List[BlockCacheEntry] = list_new();
    return LruBlockCache {
        config: cfg,
        current_bytes: 0,
        entries: empty_entries,
        hits: 0,
        misses: 0,
        evictions: 0
    };
}

pub fn lru_block_cache_get(cache: LruBlockCache, key: String, now_ts: Int) -> Option[BlockCacheEntry] {
    let entries: List[BlockCacheEntry] = (cache).entries;
    let n: Int = list_len(entries);
    let mut i: Int = 0;

    while i < n {
        let entry: BlockCacheEntry = list_get(entries, i);
        if (entry).cache_key == key {
            return Some(entry);
        }
        i = i + 1;
    }

    return None;
}

pub fn lru_block_cache_put(
    cache: LruBlockCache,
    key: String,
    sz: Int,
    preview: String,
    now_ts: Int
) -> LruBlockCache {
    let new_entry: BlockCacheEntry = BlockCacheEntry {
        cache_key: key,
        block_bytes: sz,
        access_timestamp: now_ts,
        payload_preview: preview
    };

    let old_entries: List[BlockCacheEntry] = (cache).entries;
    let mut filtered_entries: List[BlockCacheEntry] = list_new();
    let mut current_bytes: Int = 0;
    let n: Int = list_len(old_entries);
    let mut i: Int = 0;

    while i < n {
        let e: BlockCacheEntry = list_get(old_entries, i);
        if (e).cache_key != key {
            filtered_entries = list_push(filtered_entries, e);
            current_bytes = current_bytes + (e).block_bytes;
        }
        i = i + 1;
    }

    filtered_entries = list_push(filtered_entries, new_entry);
    current_bytes = current_bytes + sz;

    let max_cap: Int = (cache).config.capacity_bytes;
    let mut final_entries: List[BlockCacheEntry] = list_new();
    let mut evicted_count: Int = (cache).evictions;

    let count_filtered: Int = list_len(filtered_entries);
    let mut j: Int = 0;
    while j < count_filtered {
        let item: BlockCacheEntry = list_get(filtered_entries, j);
        if current_bytes > max_cap && j == 0 && count_filtered > 1 {
            current_bytes = current_bytes - (item).block_bytes;
            evicted_count = evicted_count + 1;
        } else {
            final_entries = list_push(final_entries, item);
        }
        j = j + 1;
    }

    return LruBlockCache {
        config: (cache).config,
        current_bytes: current_bytes,
        entries: final_entries,
        hits: (cache).hits,
        misses: (cache).misses,
        evictions: evicted_count
    };
}
