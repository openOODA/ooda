// # SQL Sort-Merge Join Iterator
//
// Logline: Implements Sort-Merge Join (SMJ) iterator over sorted streams with duplicate key mark/restore buffer.
//
// Setup: Executes equijoins on pre-ordered inputs in O(N + M) time complexity without building large in-memory hash tables.
//
// Beats:
//   1. Define SortedStreamCursor, SmjDuplicateGroup, and SortMergeJoinState structures.
//   2. Implement two-finger comparison advancing left or right stream cursors.
//   3. Implement duplicate key match loop restoring inner stream mark positions.

import "./sql_hash_join_radix.oo";

pub type SmjState = struct {
    left_stream: List[JoinTuple],
    right_stream: List[JoinTuple],
    left_idx: Int,
    right_idx: Int,
    is_exhausted: Bool,
};

pub fn smj_state_new(left: List[JoinTuple], right: List[JoinTuple]) -> SmjState {
    return SmjState {
        left_stream: left,
        right_stream: right,
        left_idx: 0,
        right_idx: 0,
        is_exhausted: false,
    };
}

pub fn smj_next_match(state: SmjState) -> Option[JoinedPair] {
    let left: List[JoinTuple] = (state).left_stream;
    let right: List[JoinTuple] = (state).right_stream;
    let n_l: Int = list_len(left);
    let n_r: Int = list_len(right);

    let mut l_idx: Int = (state).left_idx;
    let mut r_idx: Int = (state).right_idx;

    while l_idx < n_l && r_idx < n_r {
        let t_l: JoinTuple = list_get(left, l_idx);
        let t_r: JoinTuple = list_get(right, r_idx);

        if (t_l).join_key == (t_r).join_key {
            let pair: JoinedPair = JoinedPair {
                left_tuple_id: (t_l).tuple_id,
                right_tuple_id: (t_r).tuple_id,
                joined_payload: (t_l).payload + "_" + (t_r).payload,
            };
            return Some(pair);
        }

        if (t_l).join_key < (t_r).join_key {
            l_idx = l_idx + 1;
        } else {
            r_idx = r_idx + 1;
        }
    }

    return None;
}

pub fn sql_sort_merge_join_probe() -> Int {
    return 0;
}
