// # Buffer Pool Clock-Sweep Page Replacement
//
// Logline: Implements circular clock-sweep eviction algorithm tracking reference bits, pin counts, and dirty state.
//
// Setup: Low-overhead O(1) buffer frame eviction candidate selector for relational database storage engines.
//
// Beats:
//   1. Define ClockFrame, ClockSweepConfig, and ClockSweepReplacer structures.
//   2. Implement circular hand advancement, reference bit clearing, and unpinned victim search.
//   3. Implement pin/unpin lifecycle management and dirty frame eviction flush signals.

pub type ClockFrame = struct {
    frame_id: Int,
    page_id: Int,
    pin_count: Int,
    reference_bit: Bool,
    is_dirty: Bool
};

pub type ClockSweepReplacer = struct {
    capacity_frames: Int,
    clock_hand: Int,
    frames: List[ClockFrame],
    total_sweeps: Int,
    total_evictions: Int
};

pub fn clock_frame_new(fid: Int, pid: Int) -> ClockFrame {
    return ClockFrame {
        frame_id: fid,
        page_id: pid,
        pin_count: 0,
        reference_bit: true,
        is_dirty: false
    };
}

pub fn clock_sweep_replacer_new(num_frames: Int) -> ClockSweepReplacer {
    let mut initial_frames: List[ClockFrame] = list_new();
    let mut i: Int = 0;
    while i < num_frames {
        initial_frames = list_push(initial_frames, clock_frame_new(i, -1));
        i = i + 1;
    }
    return ClockSweepReplacer {
        capacity_frames: num_frames,
        clock_hand: 0,
        frames: initial_frames,
        total_sweeps: 0,
        total_evictions: 0
    };
}

pub fn clock_sweep_pin(replacer: ClockSweepReplacer, fid: Int) -> ClockSweepReplacer {
    let old_frames: List[ClockFrame] = (replacer).frames;
    let n: Int = list_len(old_frames);
    let mut updated: List[ClockFrame] = list_new();
    let mut i: Int = 0;

    while i < n {
        let f: ClockFrame = list_get(old_frames, i);
        if (f).frame_id == fid {
            let pinned: ClockFrame = ClockFrame {
                frame_id: (f).frame_id,
                page_id: (f).page_id,
                pin_count: (f).pin_count + 1,
                reference_bit: true,
                is_dirty: (f).is_dirty
            };
            updated = list_push(updated, pinned);
        } else {
            updated = list_push(updated, f);
        }
        i = i + 1;
    }

    return ClockSweepReplacer {
        capacity_frames: (replacer).capacity_frames,
        clock_hand: (replacer).clock_hand,
        frames: updated,
        total_sweeps: (replacer).total_sweeps,
        total_evictions: (replacer).total_evictions
    };
}

pub fn clock_sweep_unpin(replacer: ClockSweepReplacer, fid: Int, is_dirty_flag: Bool) -> ClockSweepReplacer {
    let old_frames: List[ClockFrame] = (replacer).frames;
    let n: Int = list_len(old_frames);
    let mut updated: List[ClockFrame] = list_new();
    let mut i: Int = 0;

    while i < n {
        let f: ClockFrame = list_get(old_frames, i);
        if (f).frame_id == fid {
            let mut new_pins: Int = (f).pin_count - 1;
            if new_pins < 0 {
                new_pins = 0;
            }
            let unpinned: ClockFrame = ClockFrame {
                frame_id: (f).frame_id,
                page_id: (f).page_id,
                pin_count: new_pins,
                reference_bit: (f).reference_bit,
                is_dirty: (f).is_dirty || is_dirty_flag
            };
            updated = list_push(updated, unpinned);
        } else {
            updated = list_push(updated, f);
        }
        i = i + 1;
    }

    return ClockSweepReplacer {
        capacity_frames: (replacer).capacity_frames,
        clock_hand: (replacer).clock_hand,
        frames: updated,
        total_sweeps: (replacer).total_sweeps,
        total_evictions: (replacer).total_evictions
    };
}

pub fn clock_sweep_find_victim(replacer: ClockSweepReplacer) -> Option[Int] {
    let frames_list: List[ClockFrame] = (replacer).frames;
    let n: Int = list_len(frames_list);
    let mut i: Int = 0;

    while i < n {
        let f: ClockFrame = list_get(frames_list, i);
        if (f).pin_count == 0 {
            return Some((f).frame_id);
        }
        i = i + 1;
    }

    return None;
}
