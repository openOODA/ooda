pub fn db_storage_memtable_default() -> SkipListMemTable {
    return skiplist_memtable_new(67108864, 16);
}

pub fn db_storage_sstable_builder_default(fid: Int) -> SSTableBuilder {
    return sstable_builder_new(fid, 4096);
}

pub fn db_storage_bloom_default() -> BloomFilterBlock {
    return bloom_filter_block_new(1024, 7);
}

pub fn db_storage_slotted_page_default(pid: Int) -> SlottedPage {
    return slotted_page_new(pid, true, 8192);
}

pub fn db_storage_wal_buffer_default() -> WalRingBuffer {
    return wal_ring_buffer_new(1024);
}

pub fn db_storage_aries_state_default(ckpt_lsn: Int) -> AriesRecoveryState {
    return aries_recovery_state_init(ckpt_lsn);
}

pub fn db_storage_version_chain_default(rid: Int, tx: Int, data: String) -> VersionChain {
    return version_chain_new(rid, tx, data);
}

pub fn db_storage_hnsw_default() -> HnswGraphIndex {
    return hnsw_index_new(hnsw_config_default());
}

pub fn db_storage_policy_default() -> StorageEnginePolicy {
    return storage_engine_policy_default();
}
