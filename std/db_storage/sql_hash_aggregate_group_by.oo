// # SQL Hash-Based Group By Aggregator
//
// Logline: Implements hash-based GROUP BY aggregation maintaining per-group accumulator states for COUNT, SUM, AVG, MIN, and MAX.
//
// Setup: Pipelined aggregation operator grouping input stream tuples by composite keys without prior sorting.
//
// Beats:
//   1. Define AggregateAccumulator, GroupAggregateEntry, and HashAggregateTable structures.
//   2. Implement aggregate accumulator update rules (COUNT++, SUM+=val, MIN/MAX compare).
//   3. Implement final aggregate evaluation and output grouped result row emission.

pub type AggregateAccumulator = struct {
    count: Int,
    sum: Int,
    min_val: Int,
    max_val: Int
};

pub type GroupAggregateEntry = struct {
    group_key: String,
    accumulator: AggregateAccumulator
};

pub type HashAggregateTable = struct {
    groups: List[GroupAggregateEntry],
    total_groups: Int
};

pub fn aggregate_accumulator_new() -> AggregateAccumulator {
    return AggregateAccumulator {
        count: 0,
        sum: 0,
        min_val: 999999999,
        max_val: -999999999
    };
}

pub fn hash_aggregate_table_new() -> HashAggregateTable {
    let empty_groups: List[GroupAggregateEntry] = list_new();
    return HashAggregateTable {
        groups: empty_groups,
        total_groups: 0
    };
}

pub fn hash_aggregate_accumulate(
    table: HashAggregateTable,
    g_key: String,
    val: Int
) -> HashAggregateTable {
    let old_groups: List[GroupAggregateEntry] = (table).groups;
    let n: Int = list_len(old_groups);
    let mut updated_groups: List[GroupAggregateEntry] = list_new();
    let mut found: Bool = false;
    let mut i: Int = 0;

    while i < n {
        let g: GroupAggregateEntry = list_get(old_groups, i);
        if (g).group_key == g_key {
            let acc: AggregateAccumulator = (g).accumulator;
            let mut min_v: Int = (acc).min_val;
            let mut max_v: Int = (acc).max_val;
            if val < min_v {
                min_v = val;
            }
            if val > max_v {
                max_v = val;
            }

            let new_acc: AggregateAccumulator = AggregateAccumulator {
                count: (acc).count + 1,
                sum: (acc).sum + val,
                min_val: min_v,
                max_val: max_v
            };

            let updated_g: GroupAggregateEntry = GroupAggregateEntry {
                group_key: g_key,
                accumulator: new_acc
            };
            updated_groups = list_push(updated_groups, updated_g);
            found = true;
        } else {
            updated_groups = list_push(updated_groups, g);
        }
        i = i + 1;
    }

    if !found {
        let initial_acc: AggregateAccumulator = AggregateAccumulator {
            count: 1,
            sum: val,
            min_val: val,
            max_val: val
        };
        let new_g: GroupAggregateEntry = GroupAggregateEntry {
            group_key: g_key,
            accumulator: initial_acc
        };
        updated_groups = list_push(updated_groups, new_g);
    }

    return HashAggregateTable {
        groups: updated_groups,
        total_groups: list_len(updated_groups)
    };
}
