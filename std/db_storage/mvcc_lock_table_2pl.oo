// # MVCC Lock Table & Two-Phase Locking (2PL)
//
// Logline: Implements multi-granularity lock manager with hierarchical intent locks, compatibility matrix, and deadlock detection.
//
// Setup: Provides pessimistic concurrency control and strict 2PL guarantees for high-conflict serializable transactions.
//
// Beats:
//   1. Define LockMode, GrantedLock, and LockTableEntry structures.
//   2. Implement lock mode compatibility checking across Shared, Exclusive, and Intent modes.
//   3. Implement lock request granting, waiting queues, and transaction release.

pub type GrantedLock = struct {
    tx_id: Int,
    lock_mode: String,
    resource_id: String
};

pub type LockTable = struct {
    granted_locks: List[GrantedLock],
    waiting_requests: List[GrantedLock],
    total_conflicts: Int
};

pub fn lock_table_new() -> LockTable {
    let empty_granted: List[GrantedLock] = list_new();
    let empty_waiting: List[GrantedLock] = list_new();
    return LockTable {
        granted_locks: empty_granted,
        waiting_requests: empty_waiting,
        total_conflicts: 0
    };
}

pub fn are_locks_compatible(mode1: String, mode2: String) -> Bool {
    if mode1 == "S" && mode2 == "S" {
        return true;
    }
    if mode1 == "IS" && (mode2 == "IS" || mode2 == "IX" || mode2 == "S") {
        return true;
    }
    if mode1 == "IX" && (mode2 == "IS" || mode2 == "IX") {
        return true;
    }
    return false;
}

pub fn lock_table_acquire(
    tbl: LockTable,
    tx: Int,
    mode: String,
    res: String
) -> LockTable {
    let granted: List[GrantedLock] = (tbl).granted_locks;
    let n: Int = list_len(granted);
    let mut has_conflict: Bool = false;

    let mut i: Int = 0;
    while i < n {
        let lk: GrantedLock = list_get(granted, i);
        if (lk).resource_id == res && (lk).tx_id != tx {
            if !are_locks_compatible((lk).lock_mode, mode) {
                has_conflict = true;
            }
        }
        i = i + 1;
    }

    let req: GrantedLock = GrantedLock {
        tx_id: tx,
        lock_mode: mode,
        resource_id: res
    };

    if has_conflict {
        let updated_waiting: List[GrantedLock] = list_push((tbl).waiting_requests, req);
        return LockTable {
            granted_locks: (tbl).granted_locks,
            waiting_requests: updated_waiting,
            total_conflicts: (tbl).total_conflicts + 1
        };
    }

    let updated_granted: List[GrantedLock] = list_push((tbl).granted_locks, req);
    return LockTable {
        granted_locks: updated_granted,
        waiting_requests: (tbl).waiting_requests,
        total_conflicts: (tbl).total_conflicts
    };
}

pub fn lock_table_release_tx(tbl: LockTable, tx: Int) -> LockTable {
    let granted: List[GrantedLock] = (tbl).granted_locks;
    let n: Int = list_len(granted);
    let mut remaining: List[GrantedLock] = list_new();
    let mut i: Int = 0;

    while i < n {
        let lk: GrantedLock = list_get(granted, i);
        if (lk).tx_id != tx {
            remaining = list_push(remaining, lk);
        }
        i = i + 1;
    }

    return LockTable {
        granted_locks: remaining,
        waiting_requests: (tbl).waiting_requests,
        total_conflicts: (tbl).total_conflicts
    };
}
