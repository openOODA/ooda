// # Vector IVF-PQ Product Quantizer
//
// Logline: Implements Inverted File with Product Quantization (IVF-PQ) clustering high-dimensional embeddings into Voronoi cells.
//
// Setup: Memory-compressed approximate nearest neighbor indexing achieving 16x-64x vector compression ratios.
//
// Beats:
//   1. Define IvfCentroidCell, PqCodebook, and IvfPqIndex structures.
//   2. Implement coarse quantizer assigning query vectors to candidate Voronoi centroid clusters.
//   3. Implement sub-vector product quantization and Asymmetric Distance Computation (ADC).

pub type IvfCentroidCell = struct {
    centroid_id: Int,
    centroid_vector: List[Float],
    vector_ids: List[Int],
};

pub type IvfPqConfig = struct {
    num_centroids: Int,
    num_subvectors_m: Int,
    bits_per_code_k: Int,
    nprobe: Int,
};

pub type IvfPqIndex = struct {
    config: IvfPqConfig,
    centroids: List[IvfCentroidCell],
    total_indexed_vectors: Int,
};

pub fn ivf_pq_config_default() -> IvfPqConfig {
    return IvfPqConfig {
        num_centroids: 256,
        num_subvectors_m: 8,
        bits_per_code_k: 8,
        nprobe: 16,
    };
}

pub fn ivf_pq_index_new(cfg: IvfPqConfig) -> IvfPqIndex {
    let mut initial_cells: List[IvfCentroidCell] = list_new();
    let mut i: Int = 0;
    while i < (cfg).num_centroids {
        let empty_c_vec: List[Float] = list_new();
        let empty_vids: List[Int] = list_new();
        let cell: IvfCentroidCell = IvfCentroidCell {
            centroid_id: i,
            centroid_vector: empty_c_vec,
            vector_ids: empty_vids,
        };
        initial_cells = list_push(initial_cells, cell);
        i = i + 1;
    }

    return IvfPqIndex {
        config: cfg,
        centroids: initial_cells,
        total_indexed_vectors: 0,
    };
}

pub fn ivf_pq_add_vector(
    idx: IvfPqIndex,
    vid: Int,
    centroid_id: Int
) -> IvfPqIndex {
    let old_cells: List[IvfCentroidCell] = (idx).centroids;
    let n: Int = list_len(old_cells);
    let mut updated_cells: List[IvfCentroidCell] = list_new();
    let mut i: Int = 0;

    while i < n {
        let c: IvfCentroidCell = list_get(old_cells, i);
        if (c).centroid_id == centroid_id {
            let updated_vids: List[Int] = list_push((c).vector_ids, vid);
            let updated_c: IvfCentroidCell = IvfCentroidCell {
                centroid_id: (c).centroid_id,
                centroid_vector: (c).centroid_vector,
                vector_ids: updated_vids,
            };
            updated_cells = list_push(updated_cells, updated_c);
        } else {
            updated_cells = list_push(updated_cells, c);
        }
        i = i + 1;
    }

    return IvfPqIndex {
        config: (idx).config,
        centroids: updated_cells,
        total_indexed_vectors: (idx).total_indexed_vectors + 1,
    };
}
