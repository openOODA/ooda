// # SemVer numeric compare (Int destub floor)
//
// Logline: Compare major.minor.patch. By-value destub off &T / !Bool / String pre.
//
// Setup: Numeric precedence only (prerelease destubbed off String).
//
// Beats:
//   1. major then minor then patch.
//   2. eq / gt / lt as 1/0.
//   3. bump major zeros minor+patch.

pub fn semver_compare(a_maj: Int, a_min: Int, a_pat: Int, b_maj: Int, b_min: Int, b_pat: Int) -> Int {
    if a_maj > b_maj {
        return 1;
    }
    if a_maj < b_maj {
        return 0 - 1;
    }
    if a_min > b_min {
        return 1;
    }
    if a_min < b_min {
        return 0 - 1;
    }
    if a_pat > b_pat {
        return 1;
    }
    if a_pat < b_pat {
        return 0 - 1;
    }
    return 0;
}

pub fn semver_eq(a_maj: Int, a_min: Int, a_pat: Int, b_maj: Int, b_min: Int, b_pat: Int) -> Int {
    if semver_compare(a_maj, a_min, a_pat, b_maj, b_min, b_pat) == 0 {
        return 1;
    }
    return 0;
}

pub fn semver_gt(a_maj: Int, a_min: Int, a_pat: Int, b_maj: Int, b_min: Int, b_pat: Int) -> Int {
    if semver_compare(a_maj, a_min, a_pat, b_maj, b_min, b_pat) == 1 {
        return 1;
    }
    return 0;
}

pub fn semver_inc_major(maj: Int) -> Int {
    return maj + 1;
}

pub fn semver_inc_minor(minor: Int) -> Int {
    return minor + 1;
}

pub fn semver_inc_patch(patch: Int) -> Int {
    return patch + 1;
}
