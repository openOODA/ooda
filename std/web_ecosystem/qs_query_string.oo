// # Query string pair count / get (Int destub floor)
//
// Logline: n_pairs = ampersands+1; get by Int key. Destubbed off List[String].
//
// Setup: Two key/val slots.
//
// Beats:
//   1. empty query has 0 pairs.
//   2. k ampersands -> k+1 pairs.
//   3. get returns matching val else default.

pub fn qs_pair_n(query_n: Int, ampersand_n: Int) -> Int {
    if query_n <= 0 {
        return 0;
    }
    return ampersand_n + 1;
}

pub fn qs_get(k0: Int, v0: Int, k1: Int, v1: Int, key: Int, default_val: Int) -> Int {
    if k0 == key {
        return v0;
    }
    if k1 == key {
        return v1;
    }
    return default_val;
}
