// # Lodash throttle (by-value Int destub)
//
// Logline: At most one execute per interval_ms. Destubbed off pub type / &T.
//
// Setup: last_exec starts far in the past so first call is allowed.
//
// Beats:
//   1. can_execute if now - last_exec >= interval.
//   2. execute records now and increments executed.
//   3. record_drop increments throttled.

type ThrottleState = struct {
    interval_ms: Int,
    last_exec_ms: Int,
    total_executed: Int,
    total_throttled: Int
};

pub fn throttle_new(interval_ms: Int) -> ThrottleState {
    return ThrottleState {
        interval_ms: interval_ms,
        last_exec_ms: 0 - 1000000000,
        total_executed: 0,
        total_throttled: 0
    };
}

pub fn throttle_can_execute(state: ThrottleState, now_ms: Int) -> Int {
    let elapsed: Int = now_ms - state.last_exec_ms;
    if elapsed >= state.interval_ms {
        return 1;
    }
    return 0;
}

pub fn throttle_execute(state: ThrottleState, now_ms: Int) -> ThrottleState {
    return ThrottleState {
        interval_ms: state.interval_ms,
        last_exec_ms: now_ms,
        total_executed: state.total_executed + 1,
        total_throttled: state.total_throttled
    };
}

pub fn throttle_record_drop(state: ThrottleState) -> ThrottleState {
    return ThrottleState {
        interval_ms: state.interval_ms,
        last_exec_ms: state.last_exec_ms,
        total_executed: state.total_executed,
        total_throttled: state.total_throttled + 1
    };
}
