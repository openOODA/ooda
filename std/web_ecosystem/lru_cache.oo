// # LRU cache (2-slot Int destub floor)
//
// Logline: Fixed capacity 2; get updates recency; evict oldest on overflow.
//
// Setup: List[struct]/String destubbed to two Int keys + stamps.
//
// Beats:
//   1. put writes empty slot or evicts older stamp.
//   2. get hits increment hits and refresh stamp.
//   3. miss increments misses.

type LruCache = struct {
    k0: Int,
    t0: Int,
    k1: Int,
    t1: Int,
    hits: Int,
    misses: Int
};

pub fn lru_cache_new() -> LruCache {
    return LruCache { k0: 0, t0: 0, k1: 0, t1: 0, hits: 0, misses: 0 };
}

pub fn lru_cache_put(cache: LruCache, key: Int, now_ms: Int) -> LruCache {
    if cache.k0 == key {
        return LruCache { k0: key, t0: now_ms, k1: cache.k1, t1: cache.t1, hits: cache.hits, misses: cache.misses };
    }
    if cache.k1 == key {
        return LruCache { k0: cache.k0, t0: cache.t0, k1: key, t1: now_ms, hits: cache.hits, misses: cache.misses };
    }
    if cache.k0 == 0 {
        return LruCache { k0: key, t0: now_ms, k1: cache.k1, t1: cache.t1, hits: cache.hits, misses: cache.misses };
    }
    if cache.k1 == 0 {
        return LruCache { k0: cache.k0, t0: cache.t0, k1: key, t1: now_ms, hits: cache.hits, misses: cache.misses };
    }
    if cache.t0 <= cache.t1 {
        return LruCache { k0: key, t0: now_ms, k1: cache.k1, t1: cache.t1, hits: cache.hits, misses: cache.misses };
    }
    return LruCache { k0: cache.k0, t0: cache.t0, k1: key, t1: now_ms, hits: cache.hits, misses: cache.misses };
}

pub fn lru_cache_get(cache: LruCache, key: Int, now_ms: Int) -> LruCache {
    if cache.k0 == key {
        return LruCache { k0: cache.k0, t0: now_ms, k1: cache.k1, t1: cache.t1, hits: cache.hits + 1, misses: cache.misses };
    }
    if cache.k1 == key {
        return LruCache { k0: cache.k0, t0: cache.t0, k1: cache.k1, t1: now_ms, hits: cache.hits + 1, misses: cache.misses };
    }
    return LruCache { k0: cache.k0, t0: cache.t0, k1: cache.k1, t1: cache.t1, hits: cache.hits, misses: cache.misses + 1 };
}

pub fn lru_cache_hits(cache: LruCache) -> Int {
    return cache.hits;
}

pub fn lru_cache_misses(cache: LruCache) -> Int {
    return cache.misses;
}
