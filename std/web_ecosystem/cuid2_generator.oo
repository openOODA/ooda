// # CUID2 hash step (Int destub floor)
//
// Logline: FNV-style mix (h xor val) * 16777619 mod 2147483647.
//
// Setup: String Base36 destubbed. Prove the published mix.
//
// Beats:
//   1. cuid2_hash_step is the mixer.
//   2. default length 24.
//   3. alphabet length 36.

pub fn cuid2_hash_step(h: Int, val: Int) -> Int {
    let prime: Int = 16777619;
    let mixed: Int = (h ^ val) * prime;
    let m: Int = 2147483647;
    let res: Int = mixed % m;
    if res < 0 {
        return 0 - res;
    }
    return res;
}

pub fn cuid2_default_length() -> Int {
    return 24;
}

pub fn cuid2_alphabet_len() -> Int {
    return 36;
}
