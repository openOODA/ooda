// # Terminal table widths (Int destub floor)
//
// Logline: Pad cells; measure col max; line = 1 + n_cols*(cell+1). Off pub type / String / List.
//
// Setup: Default pad 1, width 15. use_ascii 0/1. n_cols / n_rows not count.
//
// Beats:
//   1. pad_n is max(s_n, width); cell_n is pad + inner + pad.
//   2. col_width is max(header, c0, c1).
//   3. format_n is 3 dividers + header + n_rows, each plus newline; 0 cols is 0.

type TableConfig = struct {
    col_padding: Int,
    use_ascii: Int
};

pub fn table_config_default() -> TableConfig {
    return TableConfig {
        col_padding: 1,
        use_ascii: 0
    };
}

pub fn table_pad_n(s_n: Int, width: Int) -> Int {
    if s_n < width {
        return width;
    }
    return s_n;
}

pub fn table_col_width(header_n: Int, c0_n: Int, c1_n: Int) -> Int {
    let m0: Int = if header_n > c0_n { header_n } else { c0_n };
    if m0 > c1_n {
        return m0;
    }
    return c1_n;
}

pub fn table_cell_n(content_n: Int, width: Int, pad: Int) -> Int {
    let inner: Int = table_pad_n(content_n, width);
    return pad + inner + pad;
}

pub fn table_line_n(n_cols: Int, cell_n: Int) -> Int {
    if n_cols <= 0 {
        return 0;
    }
    return 1 + (n_cols * (cell_n + 1));
}

pub fn table_format_n(n_cols: Int, n_rows: Int) -> Int {
    if n_cols <= 0 {
        return 0;
    }
    let cell_n: Int = table_cell_n(0, 15, 1);
    let line_n: Int = table_line_n(n_cols, cell_n);
    let block: Int = line_n + 1;
    return (block * 3) + (block * (n_rows + 1));
}
