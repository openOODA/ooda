// # JWT Base64URL alphabet + 3-part token (Int destub)
//
// Logline: RFC 4648 Base64 index. Destubbed off String segments / pub type.
//
// Setup: A=0 ... Z=25 a=26 0=52 +/ or -_ .
//
// Beats:
//   1. base64_char_index for A/a/0/-/_.
//   2. token valid if three parts non-empty (n>0).
//   3. compact parts = 3.

pub fn jwt_b64_index(ch: Int) -> Int {
    if ch >= 65 && ch <= 90 {
        return ch - 65;
    }
    if ch >= 97 && ch <= 122 {
        return (ch - 97) + 26;
    }
    if ch >= 48 && ch <= 57 {
        return (ch - 48) + 52;
    }
    if ch == 45 {
        return 62;
    }
    if ch == 95 {
        return 63;
    }
    return 0 - 1;
}

pub fn jwt_parts_valid(h_n: Int, p_n: Int, s_n: Int) -> Int {
    if h_n > 0 {
        if p_n > 0 {
            if s_n > 0 {
                return 1;
            }
        }
    }
    return 0;
}

pub fn jwt_compact_part_n() -> Int {
    return 3;
}
