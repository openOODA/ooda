// # NanoID LCG (Int destub floor)
//
// Logline: glibc LCG next = (1103515245*s + 12345) mod 2147483647.
//
// Setup: String alphabet destubbed; prove the published LCG step.
//
// Beats:
//   1. nanoid_next_rand is the LCG.
//   2. index = rand % alphabet_len.
//   3. default size 21.

pub fn nanoid_next_rand(state: Int) -> Int {
    let a: Int = 1103515245;
    let c: Int = 12345;
    let m: Int = 2147483647;
    let next: Int = (state * a + c) % m;
    if next < 0 {
        return 0 - next;
    }
    return next;
}

pub fn nanoid_index(state: Int, alphabet_len: Int) -> Int {
    if alphabet_len <= 0 {
        return 0;
    }
    let r: Int = nanoid_next_rand(state);
    return r % alphabet_len;
}

pub fn nanoid_default_size() -> Int {
    return 21;
}
