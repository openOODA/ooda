// # MIME Types and Content-Type Resolver
//
// Logline: Resolves MIME media types, file extension mappings, and content classification.
//
// Setup: Pure MIME lookup module providing mime-types / mime database parity.
//
// Beats:
//   1. Map standard file extensions (.json, .html, .css, .js, .wasm, .png, etc.) to MIME strings.
//   2. Extract extension from path strings and resolve full Content-Type headers.
//   3. Classify MIME media types as textual or binary payloads.

pub fn mime_lookup_extension(ext: String) -> String {
    let clean: String = if chars_len(ext) > 0 && char_at(ext, 0) == "." {
        str_slice(ext, 1, chars_len(ext))
    } else {
        ext
    };

    if clean == "json" { return "application/json"; }
    if clean == "html" || clean == "htm" { return "text/html"; }
    if clean == "css" { return "text/css"; }
    if clean == "js" || clean == "mjs" { return "application/javascript"; }
    if clean == "ts" { return "application/typescript"; }
    if clean == "wasm" { return "application/wasm"; }
    if clean == "txt" { return "text/plain"; }
    if clean == "xml" { return "application/xml"; }
    if clean == "png" { return "image/png"; }
    if clean == "jpg" || clean == "jpeg" { return "image/jpeg"; }
    if clean == "gif" { return "image/gif"; }
    if clean == "svg" { return "image/svg+xml"; }
    if clean == "webp" { return "image/webp"; }
    if clean == "pdf" { return "application/pdf"; }
    if clean == "zip" { return "application/zip"; }
    if clean == "oo" { return "text/x-openooda"; }

    return "application/octet-stream";
}

pub fn mime_lookup_content_type(path: String) -> String {
    let n: Int = chars_len(path);
    let mut dot_idx: Int = -1;
    let mut i: Int = n - 1;

    while i >= 0 {
        if char_at(path, i) == "." {
            dot_idx = i;
            i = -1;
        } else if char_at(path, i) == "/" {
            i = -1;
        } else {
            i = i - 1;
        }
    }

    if dot_idx == -1 {
        return "application/octet-stream";
    }

    let ext: String = str_slice(path, dot_idx + 1, n);
    return mime_lookup_extension(ext);
}

pub fn mime_is_text(content_type: String) -> Bool {
    let n: Int = chars_len(content_type);
    if n >= 5 && str_slice(content_type, 0, 5) == "text/" {
        return true;
    }
    if content_type == "application/json" || content_type == "application/javascript"
        || content_type == "application/xml" || content_type == "image/svg+xml" {
        return true;
    }
    return false;
}

pub fn mime_is_binary(content_type: String) -> Bool {
    let t: Bool = mime_is_text(content_type);
    if t == false {
        return true;
    }
    return false;
}
