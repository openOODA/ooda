// # CLI spinner frames (Int destub floor)
//
// Logline: Frame index is step % n_frames. Dots 10@80ms. Off pub type / String / List.
//
// Setup: kind 1=dots 2=line 3=circle. done=1 fail=2. n_frames not count.
//
// Beats:
//   1. dots 10 frames 80ms; line 4@130; circle 4@120.
//   2. frame = step % n_frames (0 if n_frames<=0).
//   3. line glyphs - \ | / as 45 92 124 47.

type Spinner = struct {
    kind: Int,
    n_frames: Int,
    interval_ms: Int
};

pub fn spinner_dots() -> Spinner {
    return Spinner {
        kind: 1,
        n_frames: 10,
        interval_ms: 80
    };
}

pub fn spinner_line() -> Spinner {
    return Spinner {
        kind: 2,
        n_frames: 4,
        interval_ms: 130
    };
}

pub fn spinner_circle() -> Spinner {
    return Spinner {
        kind: 3,
        n_frames: 4,
        interval_ms: 120
    };
}

pub fn spinner_dots_n() -> Int {
    return 10;
}

pub fn spinner_dots_interval_ms() -> Int {
    return 80;
}

pub fn spinner_frame(step: Int, n_frames: Int) -> Int {
    if n_frames <= 0 {
        return 0;
    }
    return step % n_frames;
}

pub fn spinner_get_frame(s: Spinner, step: Int) -> Int {
    return spinner_frame(step, s.n_frames);
}

pub fn spinner_line_glyph(step: Int) -> Int {
    let idx: Int = spinner_frame(step, 4);
    if idx == 0 {
        return 45;
    }
    if idx == 1 {
        return 92;
    }
    if idx == 2 {
        return 124;
    }
    return 47;
}

pub fn spinner_done_code() -> Int {
    return 1;
}

pub fn spinner_fail_code() -> Int {
    return 2;
}

pub fn spinner_success_symbol() -> Int {
    return 1;
}

pub fn spinner_error_symbol() -> Int {
    return 2;
}

pub fn spinner_info_symbol() -> Int {
    return 3;
}

pub fn spinner_warning_symbol() -> Int {
    return 4;
}
