// # Event emitter 2-slot (Int destub floor)
//
// Logline: on/once/off/emit over two listener slots. Off pub type / String / List / &T.
//
// Setup: event_id + listener_id + is_once. filled / n_on not count. max 10.
//
// Beats:
//   1. on pushes is_once=0; once pushes is_once=1 (max 2).
//   2. listener_n scans matching event_id.
//   3. off drops matching event+listener and compacts.

type EventEmitter = struct {
    e0: Int,
    l0: Int,
    once0: Int,
    e1: Int,
    l1: Int,
    once1: Int,
    filled: Int,
    max_listeners: Int
};

pub fn event_emitter_new() -> EventEmitter {
    return EventEmitter {
        e0: 0,
        l0: 0,
        once0: 0,
        e1: 0,
        l1: 0,
        once1: 0,
        filled: 0,
        max_listeners: 10
    };
}

pub fn event_emitter_on(ee: EventEmitter, event_id: Int, listener_id: Int) -> EventEmitter {
    if ee.filled == 0 {
        return EventEmitter {
            e0: event_id,
            l0: listener_id,
            once0: 0,
            e1: ee.e1,
            l1: ee.l1,
            once1: ee.once1,
            filled: 1,
            max_listeners: ee.max_listeners
        };
    }
    if ee.filled == 1 {
        return EventEmitter {
            e0: ee.e0,
            l0: ee.l0,
            once0: ee.once0,
            e1: event_id,
            l1: listener_id,
            once1: 0,
            filled: 2,
            max_listeners: ee.max_listeners
        };
    }
    return ee;
}

pub fn event_emitter_once(ee: EventEmitter, event_id: Int, listener_id: Int) -> EventEmitter {
    if ee.filled == 0 {
        return EventEmitter {
            e0: event_id,
            l0: listener_id,
            once0: 1,
            e1: ee.e1,
            l1: ee.l1,
            once1: ee.once1,
            filled: 1,
            max_listeners: ee.max_listeners
        };
    }
    if ee.filled == 1 {
        return EventEmitter {
            e0: ee.e0,
            l0: ee.l0,
            once0: ee.once0,
            e1: event_id,
            l1: listener_id,
            once1: 1,
            filled: 2,
            max_listeners: ee.max_listeners
        };
    }
    return ee;
}

pub fn event_emitter_off(ee: EventEmitter, event_id: Int, listener_id: Int) -> EventEmitter {
    let m0: Int = if ee.filled > 0 {
        if ee.e0 == event_id {
            if ee.l0 == listener_id { 1 } else { 0 }
        } else {
            0
        }
    } else {
        0
    };
    let m1: Int = if ee.filled > 1 {
        if ee.e1 == event_id {
            if ee.l1 == listener_id { 1 } else { 0 }
        } else {
            0
        }
    } else {
        0
    };
    if m0 == 0 {
        if m1 == 0 {
            return ee;
        }
        return EventEmitter {
            e0: ee.e0,
            l0: ee.l0,
            once0: ee.once0,
            e1: 0,
            l1: 0,
            once1: 0,
            filled: 1,
            max_listeners: ee.max_listeners
        };
    }
    if ee.filled > 1 {
        if m1 == 0 {
            return EventEmitter {
                e0: ee.e1,
                l0: ee.l1,
                once0: ee.once1,
                e1: 0,
                l1: 0,
                once1: 0,
                filled: 1,
                max_listeners: ee.max_listeners
            };
        }
    }
    return EventEmitter {
        e0: 0,
        l0: 0,
        once0: 0,
        e1: 0,
        l1: 0,
        once1: 0,
        filled: 0,
        max_listeners: ee.max_listeners
    };
}

pub fn event_emitter_listener_n(ee: EventEmitter, event_id: Int) -> Int {
    let n0: Int = if ee.filled > 0 {
        if ee.e0 == event_id { 1 } else { 0 }
    } else {
        0
    };
    let n1: Int = if ee.filled > 1 {
        if ee.e1 == event_id { 1 } else { 0 }
    } else {
        0
    };
    return n0 + n1;
}

pub fn event_emitter_emit_n(ee: EventEmitter, event_id: Int) -> Int {
    return event_emitter_listener_n(ee, event_id);
}
