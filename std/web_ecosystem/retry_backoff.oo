// # Exponential Backoff and Retry Strategy
//
// Logline: Exponential delay with cap. By-value destub off pub type / &T.
//
// Setup: max_attempts, initial_delay_ms, max_delay_ms, backoff_multiplier.
//
// Beats:
//   1. default is 5 attempts, 100ms, cap 30000, multiplier 2.
//   2. should_retry if attempt < max_attempts.
//   3. delay = min(initial * multiplier^attempt, max_delay).

type RetryStrategy = struct {
    max_attempts: Int,
    initial_delay_ms: Int,
    max_delay_ms: Int,
    backoff_multiplier: Int
};

pub fn retry_strategy_default() -> RetryStrategy {
    return RetryStrategy {
        max_attempts: 5,
        initial_delay_ms: 100,
        max_delay_ms: 30000,
        backoff_multiplier: 2
    };
}

pub fn retry_strategy_custom(max_attempts: Int, initial_ms: Int, max_ms: Int, multiplier: Int) -> RetryStrategy {
    return RetryStrategy {
        max_attempts: max_attempts,
        initial_delay_ms: initial_ms,
        max_delay_ms: max_ms,
        backoff_multiplier: multiplier
    };
}

pub fn retry_should_retry(strat: RetryStrategy, attempt: Int) -> Int {
    if attempt < strat.max_attempts {
        return 1;
    }
    return 0;
}

fn retry_mul_cap(delay: Int, multiplier: Int, cap: Int) -> Int {
    let next: Int = delay * multiplier;
    if next >= cap {
        return cap;
    }
    return next;
}

pub fn retry_calculate_delay(strat: RetryStrategy, attempt: Int) -> Int {
    if attempt <= 0 {
        return strat.initial_delay_ms;
    }
    let d0: Int = strat.initial_delay_ms;
    let d1: Int = retry_mul_cap(d0, strat.backoff_multiplier, strat.max_delay_ms);
    if attempt == 1 {
        return d1;
    }
    let d2: Int = retry_mul_cap(d1, strat.backoff_multiplier, strat.max_delay_ms);
    if attempt == 2 {
        return d2;
    }
    let d3: Int = retry_mul_cap(d2, strat.backoff_multiplier, strat.max_delay_ms);
    if attempt == 3 {
        return d3;
    }
    let d4: Int = retry_mul_cap(d3, strat.backoff_multiplier, strat.max_delay_ms);
    if attempt == 4 {
        return d4;
    }
    return retry_mul_cap(d4, strat.backoff_multiplier, strat.max_delay_ms);
}
