// # JSON Web Token (JWT) Base64URL Encoder
//
// Logline: Encodes headers, claims, and signatures into RFC 7519 standard JSON Web Tokens.
//
// Setup: Pure JWT serialization engine implementing RFC 4648 Base64URL encoding.
//
// Beats:
//   1. Implement RFC 4648 Base64URL encoding with unpadded hyphen and underscore substitution.
//   2. Serialize JWT JOSE header dictionaries with specified algorithm and token type.
//   3. Assemble canonical three-part dot-separated compact JWT token representations.

pub fn base64_table() -> String {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
}

pub fn base64url_table() -> String {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
}

pub fn base64url_encode(input: String) -> String {
    let n: Int = chars_len(input);
    if n == 0 {
        return "";
    }

    let alpha: String = base64url_table();
    let mut out: String = "";
    let mut i: Int = 0;

    while i < n {
        let b0: Int = byte_at(input, i);
        let b1: Int = if i + 1 < n { byte_at(input, i + 1) } else { 0 };
        let b2: Int = if i + 2 < n { byte_at(input, i + 2) } else { 0 };

        let idx0: Int = (b0 >> 2) & 63;
        let idx1: Int = (((b0 & 3) << 4) | ((b1 >> 4) & 15)) & 63;
        let idx2: Int = (((b1 & 15) << 2) | ((b2 >> 6) & 3)) & 63;
        let idx3: Int = b2 & 63;

        out = out + char_at(alpha, idx0);
        out = out + char_at(alpha, idx1);

        if i + 1 < n {
            out = out + char_at(alpha, idx2);
        }
        if i + 2 < n {
            out = out + char_at(alpha, idx3);
        }

        i = i + 3;
    }

    return out;
}

pub fn jwt_encode_header(alg: String, typ: String) -> String {
    let header_json: String = "{\"alg\":\"" + alg + "\",\"typ\":\"" + typ + "\"}";
    return base64url_encode(header_json);
}

pub fn jwt_encode_payload(claims_json: String) -> String {
    return base64url_encode(claims_json);
}

pub fn jwt_encode_token(header_b64: String, payload_b64: String, signature_b64: String) -> String {
    return header_b64 + "." + payload_b64 + "." + signature_b64;
}
