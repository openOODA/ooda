// # String Slugification and Case Conversion Engine
//
// Logline: Converts text into URL slugs and standard identifiers across kebab-case, snake_case, camelCase, and PascalCase.
//
// Setup: Pure string transformation module providing slugify and change-case parity.
//
// Beats:
//   1. Convert ASCII characters between uppercase and lowercase representations.
//   2. Replace spaces and punctuation symbols with normalized hyphen separators.
//   3. Transform strings into camelCase, snake_case, kebab-case, and PascalCase.

pub fn to_char_lower(ch: String) -> String {
    let c: Int = ord(ch);
    if c >= 65 && c <= 90 {
        return bytes_to_str(bytes_push(bytes_new(), c + 32));
    }
    return ch;
}

pub fn to_char_upper(ch: String) -> String {
    let c: Int = ord(ch);
    if c >= 97 && c <= 122 {
        return bytes_to_str(bytes_push(bytes_new(), c - 32));
    }
    return ch;
}

pub fn slugify(input: String) -> String {
    let n: Int = chars_len(input);
    let mut out: String = "";
    let mut prev_was_dash: Bool = true;
    let mut i: Int = 0;

    while i < n {
        let ch: String = char_at(input, i);
        let c: Int = ord(ch);
        let is_alphanumeric: Bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57);

        if is_alphanumeric {
            out = out + to_char_lower(ch);
            prev_was_dash = false;
        } else if prev_was_dash == false {
            out = out + "-";
            prev_was_dash = true;
        }

        i = i + 1;
    }

    // Trim trailing dash
    let out_len: Int = chars_len(out);
    if out_len > 0 && char_at(out, out_len - 1) == "-" {
        return str_slice(out, 0, out_len - 1);
    }

    return out;
}

pub fn to_snake_case(input: String) -> String {
    let slug: String = slugify(input);
    let n: Int = chars_len(slug);
    let mut out: String = "";
    let mut i: Int = 0;

    while i < n {
        let ch: String = char_at(slug, i);
        if ch == "-" {
            out = out + "_";
        } else {
            out = out + ch;
        }
        i = i + 1;
    }

    return out;
}

pub fn to_kebab_case(input: String) -> String {
    return slugify(input);
}

pub fn to_camel_case(input: String) -> String {
    let slug: String = slugify(input);
    let n: Int = chars_len(slug);
    let mut out: String = "";
    let mut capitalize_next: Bool = false;
    let mut i: Int = 0;

    while i < n {
        let ch: String = char_at(slug, i);
        if ch == "-" {
            capitalize_next = true;
        } else if capitalize_next {
            out = out + to_char_upper(ch);
            capitalize_next = false;
        } else {
            out = out + ch;
        }
        i = i + 1;
    }

    return out;
}

pub fn to_pascal_case(input: String) -> String {
    let camel: String = to_camel_case(input);
    let n: Int = chars_len(camel);
    if n == 0 {
        return "";
    }
    let first: String = to_char_upper(char_at(camel, 0));
    return first + str_slice(camel, 1, n);
}
