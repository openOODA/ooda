// # Lodash flatten / concat / set sizes (Int destub floor)
//
// Logline: Flatten length = a + b. Union/intersect/diff on two Ints.
//
// Setup: List[String] destubbed to lengths and two members.
//
// Beats:
//   1. flatten_n is sum of inner lengths.
//   2. concat_n is a+b.
//   3. intersect 1 if equal else 0.

pub fn lodash_flatten_n(inner0: Int, inner1: Int) -> Int {
    return inner0 + inner1;
}

pub fn lodash_concat_n(a_n: Int, b_n: Int) -> Int {
    return a_n + b_n;
}

pub fn lodash_intersect_eq(a: Int, b: Int) -> Int {
    if a == b {
        return 1;
    }
    return 0;
}

pub fn lodash_diff_eq(a: Int, b: Int) -> Int {
    if a == b {
        return 0;
    }
    return 1;
}
