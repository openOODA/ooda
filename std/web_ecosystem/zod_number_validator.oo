// # Zod number validator (by-value Int destub)
//
// Logline: min/max/sign/multiple_of accumulate error_count. Off List[ZodIssue].
//
// Setup: Imports destubbed ZodResult. Bool flags are 0/1.
//
// Beats:
//   1. Builder chain sets min, max, positive, negative, nonnegative, multiple_of.
//   2. Each failed constraint adds one error.
//   3. zero errors is success.

import "./zod_schema_types.oo";

type ZodNumberSchema = struct {
    min_val: Int,
    max_val: Int,
    is_positive: Int,
    is_negative: Int,
    is_nonnegative: Int,
    multiple_of: Int
};

pub fn zod_number() -> ZodNumberSchema {
    return ZodNumberSchema {
        min_val: 0 - 2147483647,
        max_val: 2147483647,
        is_positive: 0,
        is_negative: 0,
        is_nonnegative: 0,
        multiple_of: 0
    };
}

pub fn zod_number_min(s: ZodNumberSchema, min: Int) -> ZodNumberSchema {
    return ZodNumberSchema {
        min_val: min,
        max_val: s.max_val,
        is_positive: s.is_positive,
        is_negative: s.is_negative,
        is_nonnegative: s.is_nonnegative,
        multiple_of: s.multiple_of
    };
}

pub fn zod_number_max(s: ZodNumberSchema, max: Int) -> ZodNumberSchema {
    return ZodNumberSchema {
        min_val: s.min_val,
        max_val: max,
        is_positive: s.is_positive,
        is_negative: s.is_negative,
        is_nonnegative: s.is_nonnegative,
        multiple_of: s.multiple_of
    };
}

pub fn zod_number_positive(s: ZodNumberSchema) -> ZodNumberSchema {
    return ZodNumberSchema {
        min_val: s.min_val,
        max_val: s.max_val,
        is_positive: 1,
        is_negative: 0,
        is_nonnegative: 0,
        multiple_of: s.multiple_of
    };
}

pub fn zod_number_negative(s: ZodNumberSchema) -> ZodNumberSchema {
    return ZodNumberSchema {
        min_val: s.min_val,
        max_val: s.max_val,
        is_positive: 0,
        is_negative: 1,
        is_nonnegative: 0,
        multiple_of: s.multiple_of
    };
}

pub fn zod_number_nonnegative(s: ZodNumberSchema) -> ZodNumberSchema {
    return ZodNumberSchema {
        min_val: s.min_val,
        max_val: s.max_val,
        is_positive: 0,
        is_negative: 0,
        is_nonnegative: 1,
        multiple_of: s.multiple_of
    };
}

pub fn zod_number_multiple_of(s: ZodNumberSchema, factor: Int) -> ZodNumberSchema {
    return ZodNumberSchema {
        min_val: s.min_val,
        max_val: s.max_val,
        is_positive: s.is_positive,
        is_negative: s.is_negative,
        is_nonnegative: s.is_nonnegative,
        multiple_of: factor
    };
}

pub fn zod_validate_number(schema: ZodNumberSchema, val: Int) -> ZodResult {
    let e0: Int = if val < schema.min_val { 1 } else { 0 };
    let e1: Int = if val > schema.max_val { 1 } else { 0 };
    let e2: Int = if schema.is_positive == 1 && val <= 0 { 1 } else { 0 };
    let e3: Int = if schema.is_negative == 1 && val >= 0 { 1 } else { 0 };
    let e4: Int = if schema.is_nonnegative == 1 && val < 0 { 1 } else { 0 };
    let e5: Int = if schema.multiple_of > 0 && (val % schema.multiple_of) != 0 { 1 } else { 0 };
    let n_err: Int = e0 + e1 + e2 + e3 + e4 + e5;
    if n_err == 0 {
        return zod_result_success();
    }
    return zod_result_failure(n_err);
}
