// # Mustache lookup (Int destub floor)
//
// Logline: Find key in 2-slot context. Destubbed off String/List.
//
// Setup: Two key/val slots.
//
// Beats:
//   1. find returns matching val else 0.
//   2. missing key is 0.
//   3. first slot wins.

pub fn mustache_find_var(k0: Int, v0: Int, k1: Int, v1: Int, key: Int) -> Int {
    if k0 == key {
        return v0;
    }
    if k1 == key {
        return v1;
    }
    return 0;
}

pub fn mustache_section_show(truthy: Int) -> Int {
    if truthy != 0 {
        return 1;
    }
    return 0;
}

pub fn mustache_inverted_show(truthy: Int) -> Int {
    if truthy == 0 {
        return 1;
    }
    return 0;
}
