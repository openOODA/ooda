// # Handlebars escape / mustache (Int destub floor)
//
// Logline: HTML entity kinds; {{ vs {{{; 2-slot lookup. Off String / List[struct].
//
// Setup: &amp;=1 &lt;=2 &gt;=3 &quot;=4 &#x27;=5. Two key/val slots.
//
// Beats:
//   1. escape_n: &amp; 5, &lt;/&gt; 4, &quot;/&#x27; 6, else 1.
//   2. triple 123,123,123; double 123,123.
//   3. find first matching key else 0; triple is raw.

pub fn handlebars_escape_kind(ch: Int) -> Int {
    if ch == 38 {
        return 1;
    }
    if ch == 60 {
        return 2;
    }
    if ch == 62 {
        return 3;
    }
    if ch == 34 {
        return 4;
    }
    if ch == 39 {
        return 5;
    }
    return 0;
}

pub fn handlebars_escape_n(ch: Int) -> Int {
    if ch == 38 {
        return 5;
    }
    if ch == 60 {
        return 4;
    }
    if ch == 62 {
        return 4;
    }
    if ch == 34 {
        return 6;
    }
    if ch == 39 {
        return 6;
    }
    return 1;
}

pub fn handlebars_is_triple(c0: Int, c1: Int, c2: Int) -> Int {
    if c0 == 123 {
        if c1 == 123 {
            if c2 == 123 {
                return 1;
            }
        }
    }
    return 0;
}

pub fn handlebars_is_double(c0: Int, c1: Int) -> Int {
    if c0 == 123 {
        if c1 == 123 {
            return 1;
        }
    }
    return 0;
}

pub fn handlebars_find_var(k0: Int, v0: Int, k1: Int, v1: Int, key: Int) -> Int {
    if k0 == key {
        return v0;
    }
    if k1 == key {
        return v1;
    }
    return 0;
}

pub fn handlebars_interp_n(is_triple: Int, ch: Int) -> Int {
    if is_triple == 1 {
        return 1;
    }
    return handlebars_escape_n(ch);
}
