// # Lodash partition Implementation
//
// Logline: Prefix-match partition into 4-slot match / reject PartBag, using int_has_prefix as the matcher.
//
// Setup: Prefix match walks item /10 up to 4 times. Match and reject sides each cap at 4 items.
//
// Beats:
//   1. int_has_prefix: walk item /10 up to 4 times, return 1 if any step equals prefix.
//   2. part_push_match / part_push_reject: append into next empty slot of the matching side.
//   3. part_take: dispatch by int_has_prefix.
//   4. lodash_partition_prefix: fold items.e0..e3 honoring live slots.

import "./lodash_groupby_types.oo";


pub fn int_has_prefix(item: Int, prefix: Int) -> Int {
    if item == prefix {
        return 1;
    }
    let d1: Int = item / 10;
    if d1 == prefix {
        return 1;
    }
    if d1 == 0 {
        return 0;
    }
    let d2: Int = d1 / 10;
    if d2 == prefix {
        return 1;
    }
    if d2 == 0 {
        return 0;
    }
    let d3: Int = d2 / 10;
    if d3 == prefix {
        return 1;
    }
    if d3 == 0 {
        return 0;
    }
    let d4: Int = d3 / 10;
    if d4 == prefix {
        return 1;
    }
    return 0;
}

fn part_push_match(p: PartBag, item: Int) -> PartBag {
    if p.n_match == 0 {
        return PartBag {
            m0: item,
            m1: p.m1,
            m2: p.m2,
            m3: p.m3,
            n_match: 1,
            r0: p.r0,
            r1: p.r1,
            r2: p.r2,
            r3: p.r3,
            n_reject: p.n_reject
        };
    }
    if p.n_match == 1 {
        return PartBag {
            m0: p.m0,
            m1: item,
            m2: p.m2,
            m3: p.m3,
            n_match: 2,
            r0: p.r0,
            r1: p.r1,
            r2: p.r2,
            r3: p.r3,
            n_reject: p.n_reject
        };
    }
    if p.n_match == 2 {
        return PartBag {
            m0: p.m0,
            m1: p.m1,
            m2: item,
            m3: p.m3,
            n_match: 3,
            r0: p.r0,
            r1: p.r1,
            r2: p.r2,
            r3: p.r3,
            n_reject: p.n_reject
        };
    }
    if p.n_match == 3 {
        return PartBag {
            m0: p.m0,
            m1: p.m1,
            m2: p.m2,
            m3: item,
            n_match: 4,
            r0: p.r0,
            r1: p.r1,
            r2: p.r2,
            r3: p.r3,
            n_reject: p.n_reject
        };
    }
    return p;
}

fn part_push_reject(p: PartBag, item: Int) -> PartBag {
    if p.n_reject == 0 {
        return PartBag {
            m0: p.m0,
            m1: p.m1,
            m2: p.m2,
            m3: p.m3,
            n_match: p.n_match,
            r0: item,
            r1: p.r1,
            r2: p.r2,
            r3: p.r3,
            n_reject: 1
        };
    }
    if p.n_reject == 1 {
        return PartBag {
            m0: p.m0,
            m1: p.m1,
            m2: p.m2,
            m3: p.m3,
            n_match: p.n_match,
            r0: p.r0,
            r1: item,
            r2: p.r2,
            r3: p.r3,
            n_reject: 2
        };
    }
    if p.n_reject == 2 {
        return PartBag {
            m0: p.m0,
            m1: p.m1,
            m2: p.m2,
            m3: p.m3,
            n_match: p.n_match,
            r0: p.r0,
            r1: p.r1,
            r2: item,
            r3: p.r3,
            n_reject: 3
        };
    }
    if p.n_reject == 3 {
        return PartBag {
            m0: p.m0,
            m1: p.m1,
            m2: p.m2,
            m3: p.m3,
            n_match: p.n_match,
            r0: p.r0,
            r1: p.r1,
            r2: p.r2,
            r3: item,
            n_reject: 4
        };
    }
    return p;
}

fn part_take(p: PartBag, item: Int, live: Int, prefix: Int) -> PartBag {
    if live == 0 {
        return p;
    }
    if int_has_prefix(item, prefix) == 1 {
        return part_push_match(p, item);
    }
    return part_push_reject(p, item);
}

pub fn lodash_partition_prefix(items: Int4, prefix: Int) -> PartBag {
    let empty: PartBag = PartBag {
        m0: 0,
        m1: 0,
        m2: 0,
        m3: 0,
        n_match: 0,
        r0: 0,
        r1: 0,
        r2: 0,
        r3: 0,
        n_reject: 0
    };
    let l0: Int = slot_live(items.filled, 0);
    let l1: Int = slot_live(items.filled, 1);
    let l2: Int = slot_live(items.filled, 2);
    let l3: Int = slot_live(items.filled, 3);
    let s0: PartBag = part_take(empty, items.e0, l0, prefix);
    let s1: PartBag = part_take(s0, items.e1, l1, prefix);
    let s2: PartBag = part_take(s1, items.e2, l2, prefix);
    return part_take(s2, items.e3, l3, prefix);
}
