// # Deep clone 2-slot Int map (destub floor)
//
// Logline: Copy key/val slots so dest != src. List[String] destubbed.
//
// Setup: Two Int pairs.
//
// Beats:
//   1. clone copies both slots.
//   2. clone is independent (mutate dest does not change src).
//   3. kv_pair_new.

type KeyValuePair = struct {
    key: Int,
    val: Int
};

pub fn kv_pair_new(key: Int, val: Int) -> KeyValuePair {
    return KeyValuePair { key: key, val: val };
}

type Kv2 = struct {
    k0: Int,
    v0: Int,
    k1: Int,
    v1: Int
};

pub fn kv2_new(k0: Int, v0: Int, k1: Int, v1: Int) -> Kv2 {
    return Kv2 { k0: k0, v0: v0, k1: k1, v1: v1 };
}

pub fn clone_kv2(src: Kv2) -> Kv2 {
    return kv2_new(src.k0, src.v0, src.k1, src.v1);
}

pub fn clone_int(x: Int) -> Int {
    return x;
}
