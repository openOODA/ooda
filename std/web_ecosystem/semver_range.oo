// # SemVer caret/tilde ranges (Int destub floor)
//
// Logline: ^ locks major; ~ locks major.minor. Destubbed off &T / String.
//
// Setup: Uses numeric compare only.
//
// Beats:
//   1. caret: >= target and same major (if major>0).
//   2. tilde: same major and minor, patch >= target.
//   3. 0.x caret locks minor.

pub fn semver_cmp(a_maj: Int, a_min: Int, a_pat: Int, b_maj: Int, b_min: Int, b_pat: Int) -> Int {
    if a_maj > b_maj { return 1; }
    if a_maj < b_maj { return 0 - 1; }
    if a_min > b_min { return 1; }
    if a_min < b_min { return 0 - 1; }
    if a_pat > b_pat { return 1; }
    if a_pat < b_pat { return 0 - 1; }
    return 0;
}

pub fn semver_satisfies_caret(v_maj: Int, v_min: Int, v_pat: Int, t_maj: Int, t_min: Int, t_pat: Int) -> Int {
    if semver_cmp(v_maj, v_min, v_pat, t_maj, t_min, t_pat) < 0 {
        return 0;
    }
    if t_maj > 0 {
        if v_maj == t_maj {
            return 1;
        }
        return 0;
    }
    if t_min > 0 {
        if v_maj == 0 {
            if v_min == t_min {
                return 1;
            }
        }
        return 0;
    }
    if v_maj == 0 {
        if v_min == 0 {
            if v_pat == t_pat {
                return 1;
            }
        }
    }
    return 0;
}

pub fn semver_satisfies_tilde(v_maj: Int, v_min: Int, v_pat: Int, t_maj: Int, t_min: Int, t_pat: Int) -> Int {
    if semver_cmp(v_maj, v_min, v_pat, t_maj, t_min, t_pat) < 0 {
        return 0;
    }
    if v_maj == t_maj {
        if v_min == t_min {
            return 1;
        }
    }
    return 0;
}
