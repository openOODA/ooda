// # Patch apply (Int destub floor)
//
// Logline: EQUAL/INSERT append; DELETE omit. Replace-all length. Off pub type / String / List.
//
// Setup: Ops from destubbed diff_match_patch. Two chunk slots. n_out not len.
//
// Beats:
//   1. EQUAL and INSERT add chunk_n; DELETE leaves out_n.
//   2. replace_n: target_n==0 keeps orig; else orig + hits*(repl-target).
//   3. replace_slot swaps a matching cell.

import "./diff_match_patch.oo";

type PatchResult = struct {
    n_out: Int,
    applied: Int
};

pub fn patch_result_ok(n_out: Int) -> PatchResult {
    return PatchResult {
        n_out: n_out,
        applied: 1
    };
}

pub fn patch_result_err() -> PatchResult {
    return PatchResult {
        n_out: 0,
        applied: 0
    };
}

pub fn patch_apply_op(out_n: Int, op: Int, chunk_n: Int) -> Int {
    if op == diff_chunk_equal() {
        return out_n + chunk_n;
    }
    if op == diff_chunk_insert() {
        return out_n + chunk_n;
    }
    return out_n;
}

pub fn patch_apply_two(op0: Int, n0: Int, op1: Int, n1: Int) -> Int {
    let mid: Int = patch_apply_op(0, op0, n0);
    return patch_apply_op(mid, op1, n1);
}

pub fn patch_apply_chunks(op0: Int, n0: Int, op1: Int, n1: Int) -> PatchResult {
    let n_out: Int = patch_apply_two(op0, n0, op1, n1);
    return patch_result_ok(n_out);
}

pub fn patch_replace_n(orig_n: Int, target_n: Int, repl_n: Int, hits: Int) -> Int {
    if target_n == 0 {
        return orig_n;
    }
    return orig_n + (hits * (repl_n - target_n));
}

pub fn patch_replace_slot(cell: Int, target: Int, repl: Int) -> Int {
    if cell == target {
        return repl;
    }
    return cell;
}
