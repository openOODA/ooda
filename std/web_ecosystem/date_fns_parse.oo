// # Date-fns ISO 8601 Parser and Epoch Converter
//
// Logline: Parses ISO 8601 strings and calculates Unix epoch timestamps in milliseconds.
//
// Setup: Datetime parsing engine importing date_fns_format.oo with epoch time calculation.
//
// Beats:
//   1. Parse fixed-width ISO 8601 calendar date and time tokens.
//   2. Convert structured DateTime objects to Unix epoch timestamps in milliseconds.
//   3. Reconstruct DateTime representations from raw epoch millisecond integers.

import "./date_fns_format.oo";

pub fn parse_digit(ch: String) -> Int {
    if ch == "0" { return 0; }
    if ch == "1" { return 1; }
    if ch == "2" { return 2; }
    if ch == "3" { return 3; }
    if ch == "4" { return 4; }
    if ch == "5" { return 5; }
    if ch == "6" { return 6; }
    if ch == "7" { return 7; }
    if ch == "8" { return 8; }
    if ch == "9" { return 9; }
    return 0;
}

pub fn parse_int_2(s: String, idx: Int) -> Int {
    if idx + 2 > chars_len(s) {
        return 0;
    }
    let d1: Int = parse_digit(char_at(s, idx));
    let d2: Int = parse_digit(char_at(s, idx + 1));
    return d1 * 10 + d2;
}

pub fn parse_int_4(s: String, idx: Int) -> Int {
    if idx + 4 > chars_len(s) {
        return 0;
    }
    let d1: Int = parse_digit(char_at(s, idx));
    let d2: Int = parse_digit(char_at(s, idx + 1));
    let d3: Int = parse_digit(char_at(s, idx + 2));
    let d4: Int = parse_digit(char_at(s, idx + 3));
    return d1 * 1000 + d2 * 100 + d3 * 10 + d4;
}

pub fn parse_iso(raw: String) -> DateTime {
    let n: Int = chars_len(raw);
    if n < 10 {
        return datetime_invalid();
    }

    let year: Int = parse_int_4(raw, 0);
    let month: Int = parse_int_2(raw, 5);
    let day: Int = parse_int_2(raw, 8);

    let mut hour: Int = 0;
    let mut min: Int = 0;
    let mut sec: Int = 0;
    let mut ms: Int = 0;

    if n >= 19 {
        hour = parse_int_2(raw, 11);
        min = parse_int_2(raw, 14);
        sec = parse_int_2(raw, 17);
    }

    if n >= 23 && char_at(raw, 19) == "." {
        let d1: Int = parse_digit(char_at(raw, 20));
        let d2: Int = parse_digit(char_at(raw, 21));
        let d3: Int = parse_digit(char_at(raw, 22));
        ms = d1 * 100 + d2 * 10 + d3;
    }

    if month < 1 || month > 12 || day < 1 || day > 31 || hour < 0 || hour > 23 || min < 0 || min > 59 || sec < 0 || sec > 59 {
        return datetime_invalid();
    }

    return datetime_new(year, month, day, hour, min, sec, ms);
}

pub fn is_leap_year_val(year: Int) -> Bool {
    return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
}

pub fn days_in_month_val(year: Int, month: Int) -> Int {
    if month == 2 {
        return if is_leap_year_val(year) { 29 } else { 28 };
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30;
    }
    return 31;
}

pub fn days_from_epoch(year: Int, month: Int, day: Int) -> Int {
    let mut total_days: Int = 0;
    let mut y: Int = 1970;

    while y < year {
        total_days = total_days + (if is_leap_year_val(y) { 366 } else { 365 });
        y = y + 1;
    }

    let mut m: Int = 1;
    while m < month {
        total_days = total_days + days_in_month_val(year, m);
        m = m + 1;
    }

    total_days = total_days + (day - 1);
    return total_days;
}

pub fn date_to_timestamp_ms(dt: &DateTime) -> Int {
    if !(dt).is_valid {
        return 0;
    }
    let total_days: Int = days_from_epoch((dt).year, (dt).month, (dt).day);
    let seconds: Int = total_days * 86400 + (dt).hour * 3600 + (dt).minute * 60 + (dt).second;
    return seconds * 1000 + (dt).millisecond;
}

pub fn timestamp_ms_to_date(ms: Int) -> DateTime {
    let total_sec: Int = ms / 1000;
    let rem_ms: Int = ms % 1000;

    let mut total_days: Int = total_sec / 86400;
    let sec_in_day: Int = total_sec % 86400;

    let hour: Int = sec_in_day / 3600;
    let min: Int = (sec_in_day % 3600) / 60;
    let sec: Int = sec_in_day % 60;

    let mut y: Int = 1970;
    while true {
        let d_year: Int = if is_leap_year_val(y) { 366 } else { 365 };
        if total_days >= d_year {
            total_days = total_days - d_year;
            y = y + 1;
        } else {
            break;
        }
    }

    let mut m: Int = 1;
    while m <= 12 {
        let d_month: Int = days_in_month_val(y, m);
        if total_days >= d_month {
            total_days = total_days - d_month;
            m = m + 1;
        } else {
            break;
        }
    }
    let day: Int = total_days + 1;

    return datetime_new(y, m, day, hour, min, sec, rem_ms);
}
