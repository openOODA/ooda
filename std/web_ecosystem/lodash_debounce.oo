// # Lodash debounce (by-value Int destub)
//
// Logline: Ready after wait_ms idle since last trigger. Destubbed off String/Bool/&T.
//
// Setup: pending 0/1. call_n not count (emit).
//
// Beats:
//   1. trigger sets pending and last_call.
//   2. ready if pending and elapsed >= wait.
//   3. flush clears pending.

type DebounceState = struct {
    wait_ms: Int,
    last_call_ms: Int,
    is_pending: Int,
    call_n: Int
};

pub fn debounce_new(wait_ms: Int) -> DebounceState {
    return DebounceState { wait_ms: wait_ms, last_call_ms: 0, is_pending: 0, call_n: 0 };
}

pub fn debounce_trigger(state: DebounceState, now_ms: Int) -> DebounceState {
    return DebounceState {
        wait_ms: state.wait_ms,
        last_call_ms: now_ms,
        is_pending: 1,
        call_n: state.call_n + 1
    };
}

pub fn debounce_is_ready(state: DebounceState, now_ms: Int) -> Int {
    if state.is_pending == 0 {
        return 0;
    }
    let elapsed: Int = now_ms - state.last_call_ms;
    if elapsed >= state.wait_ms {
        return 1;
    }
    return 0;
}

pub fn debounce_flush(state: DebounceState) -> DebounceState {
    return DebounceState {
        wait_ms: state.wait_ms,
        last_call_ms: state.last_call_ms,
        is_pending: 0,
        call_n: state.call_n
    };
}
