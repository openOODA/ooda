// # Multipart boundary hash (Int destub floor)
//
// Logline: FNV-ish (seed*16777619) mod 1e9; delim scan. Off pub type / String / List.
//
// Setup: Seed 0 becomes 54321. Four body slots. n_parts not count.
//
// Beats:
//   1. boundary hash is abs((s*16777619)%1000000000).
//   2. delim width is 2 + boundary_n ("--"+boundary).
//   3. parse parts = delim hits minus one (need two delims).

type MultipartPart = struct {
    name: Int,
    filename: Int,
    content_type: Int,
    data: Int
};

pub fn multipart_part_new(name: Int, filename: Int, content_type: Int, data: Int) -> MultipartPart {
    return MultipartPart {
        name: name,
        filename: filename,
        content_type: content_type,
        data: data
    };
}

pub fn multipart_is_file(part: MultipartPart) -> Int {
    if part.filename != 0 {
        return 1;
    }
    return 0;
}

pub fn multipart_boundary_hash(seed: Int) -> Int {
    let prime: Int = 16777619;
    let s: Int = if seed != 0 { seed } else { 54321 };
    let hash_val: Int = (s * prime) % 1000000000;
    if hash_val < 0 {
        return 0 - hash_val;
    }
    return hash_val;
}

pub fn multipart_delim_n(boundary_n: Int) -> Int {
    return 2 + boundary_n;
}

pub fn multipart_parse_n(s0: Int, s1: Int, s2: Int, s3: Int, delim: Int) -> Int {
    let h0: Int = if s0 == delim { 1 } else { 0 };
    let h1: Int = if s1 == delim { 1 } else { 0 };
    let h2: Int = if s2 == delim { 1 } else { 0 };
    let h3: Int = if s3 == delim { 1 } else { 0 };
    let hits: Int = h0 + h1 + h2 + h3;
    if hits <= 1 {
        return 0;
    }
    return hits - 1;
}
