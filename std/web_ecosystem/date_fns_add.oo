// # Date-fns Arithmetic and Duration Addition Engine
//
// Logline: Performs calendar and duration addition and subtraction operations across years, months, days, hours, and seconds.
//
// Setup: Pure datetime arithmetic module importing date_fns_format.oo and date_fns_parse.oo.
//
// Beats:
//   1. Add and subtract sub-day durations (milliseconds, seconds, minutes, hours).
//   2. Add and subtract day counts with calendar boundary wrapping.
//   3. Add and subtract month and year units adjusting for varying month lengths.

import "./date_fns_format.oo";
import "./date_fns_parse.oo";

pub fn add_milliseconds(dt: &DateTime, amount: Int) -> DateTime {
    if !(dt).is_valid {
        return datetime_invalid();
    }
    let cur_ms: Int = date_to_timestamp_ms(dt);
    return timestamp_ms_to_date(cur_ms + amount);
}

pub fn add_seconds(dt: &DateTime, amount: Int) -> DateTime {
    return add_milliseconds(dt, amount * 1000);
}

pub fn add_minutes(dt: &DateTime, amount: Int) -> DateTime {
    return add_milliseconds(dt, amount * 60000);
}

pub fn add_hours(dt: &DateTime, amount: Int) -> DateTime {
    return add_milliseconds(dt, amount * 3600000);
}

pub fn add_days(dt: &DateTime, amount: Int) -> DateTime {
    return add_milliseconds(dt, amount * 86400000);
}

pub fn sub_days(dt: &DateTime, amount: Int) -> DateTime {
    return add_days(dt, 0 - amount);
}

pub fn add_months(dt: &DateTime, amount: Int) -> DateTime {
    if !(dt).is_valid {
        return datetime_invalid();
    }
    let total_months: Int = (dt).year * 12 + ((dt).month - 1) + amount;
    let new_year: Int = total_months / 12;
    let new_month: Int = (total_months % 12) + 1;

    let max_days: Int = days_in_month_val(new_year, new_month);
    let new_day: Int = if (dt).day > max_days { max_days } else { (dt).day };

    return datetime_new(new_year, new_month, new_day, (dt).hour, (dt).minute, (dt).second, (dt).millisecond);
}

pub fn sub_months(dt: &DateTime, amount: Int) -> DateTime {
    return add_months(dt, 0 - amount);
}

pub fn add_years(dt: &DateTime, amount: Int) -> DateTime {
    if !(dt).is_valid {
        return datetime_invalid();
    }
    let new_year: Int = (dt).year + amount;
    let max_days: Int = days_in_month_val(new_year, (dt).month);
    let new_day: Int = if (dt).day > max_days { max_days } else { (dt).day };

    return datetime_new(new_year, (dt).month, new_day, (dt).hour, (dt).minute, (dt).second, (dt).millisecond);
}

pub fn sub_years(dt: &DateTime, amount: Int) -> DateTime {
    return add_years(dt, 0 - amount);
}
