// # Lodash chunk / take / drop (List[Int] destub floor)
//
// Logline: Chunk count, take prefix length, drop remainder. List[String] destubbed.
//
// Setup: Lengths only — emit cannot lower List[String] chunks.
//
// Beats:
//   1. chunk_n = ceil(total / size).
//   2. take_n = min(need, total).
//   3. drop_n = max(total - drop, 0).

pub fn lodash_chunk_n(total: Int, size: Int) -> Int {
    if size <= 0 {
        return 0;
    }
    if total <= 0 {
        return 0;
    }
    return (total + size - 1) / size;
}

pub fn lodash_take_n(total: Int, need: Int) -> Int {
    if need <= 0 {
        return 0;
    }
    if need > total {
        return total;
    }
    return need;
}

pub fn lodash_drop_n(total: Int, drop: Int) -> Int {
    if drop <= 0 {
        return total;
    }
    if drop >= total {
        return 0;
    }
    return total - drop;
}

pub fn lodash_compact_n(nonzero: Int) -> Int {
    if nonzero < 0 {
        return 0;
    }
    return nonzero;
}
