// # Path-to-regexp static + one-param match (Int destub)
//
// Logline: Exact match or prefix+rest param. Destubbed off String/List.
//
// Setup: Lengths and Int param id.
//
// Beats:
//   1. static match if path id equals pattern id.
//   2. param match if path_n > prefix_n.
//   3. fail otherwise.

pub fn route_static_match(pattern_id: Int, path_id: Int) -> Int {
    if pattern_id == path_id {
        return 1;
    }
    return 0;
}

pub fn route_param_match(path_n: Int, prefix_n: Int) -> Int {
    if path_n > prefix_n {
        return 1;
    }
    return 0;
}

pub fn route_param_rest(path_n: Int, prefix_n: Int) -> Int {
    if path_n > prefix_n {
        return path_n - prefix_n;
    }
    return 0;
}
