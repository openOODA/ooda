// # Zod array length validator (Int destub floor)
//
// Logline: min/max item counts. Destubbed off String type / &T / pub type.
//
// Setup: nonempty is min>=1.
//
// Beats:
//   1. default min 0 max 1000000000.
//   2. nonempty sets min 1.
//   3. parse fails outside [min,max].

type ZodArraySchema = struct {
    min_items: Int,
    max_items: Int
};

pub fn zod_array() -> ZodArraySchema {
    return ZodArraySchema { min_items: 0, max_items: 1000000000 };
}

pub fn zod_array_min(s: ZodArraySchema, min_items: Int) -> ZodArraySchema {
    return ZodArraySchema { min_items: min_items, max_items: s.max_items };
}

pub fn zod_array_max(s: ZodArraySchema, max_items: Int) -> ZodArraySchema {
    return ZodArraySchema { min_items: s.min_items, max_items: max_items };
}

pub fn zod_array_nonempty(s: ZodArraySchema) -> ZodArraySchema {
    return ZodArraySchema { min_items: 1, max_items: s.max_items };
}

pub fn zod_array_parse_n(s: ZodArraySchema, n: Int) -> Int {
    if n < s.min_items {
        return 0;
    }
    if n > s.max_items {
        return 0;
    }
    return 1;
}
