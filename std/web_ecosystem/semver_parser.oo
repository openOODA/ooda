// # Semantic Versioning (SemVer 2.0.0) Parser
//
// Logline: Parses, cleans, and formats SemVer 2.0.0 strings into typed major, minor, patch, prerelease, and build components.
//
// Setup: Pure parser adhering to RFC Semantic Versioning 2.0.0 specification with zero external dependencies.
//
// Beats:
//   1. Define SemverVersion struct containing version numbers and metadata.
//   2. Clean input strings by stripping leading whitespace, 'v', and '=' prefixes.
//   3. Parse major.minor.patch digits, hyphen-delimited prereleases, and plus-delimited build metadata.

type SemverVersion = struct {
    major: Int,
    minor: Int,
    patch: Int,
    prerelease: String,
    build: String,
    is_valid: Bool,
};

pub fn semver_parse_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut val: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        if char_is_digit(ch) {
            let d: Int = if ch == "0" { 0 }
            else if ch == "1" { 1 }
            else if ch == "2" { 2 }
            else if ch == "3" { 3 }
            else if ch == "4" { 4 }
            else if ch == "5" { 5 }
            else if ch == "6" { 6 }
            else if ch == "7" { 7 }
            else if ch == "8" { 8 }
            else { 9 };
            val = (val * 10) + d;
        }
        i = i + 1;
    }
    return val;
}

pub fn semver_new(major: Int, minor: Int, patch: Int, prerelease: String, build: String) -> SemverVersion {
    return SemverVersion {
        major: major,
        minor: minor,
        patch: patch,
        prerelease: prerelease,
        build: build,
        is_valid: true,
    };
}

pub fn semver_invalid() -> SemverVersion {
    return SemverVersion {
        major: 0,
        minor: 0,
        patch: 0,
        prerelease: "",
        build: "",
        is_valid: false,
    };
}

pub fn semver_clean(raw: String) -> String {
    let n: Int = chars_len(raw);
    let mut start: Int = 0;
    let mut end: Int = n;

    while start < end && (char_at(raw, start) == " " || char_at(raw, start) == "\t") {
        start = start + 1;
    }
    while end > start && (char_at(raw, end - 1) == " " || char_at(raw, end - 1) == "\t") {
        end = end - 1;
    }

    if start < end && (char_at(raw, start) == "v" || char_at(raw, start) == "V" || char_at(raw, start) == "=") {
        start = start + 1;
    }
    if start >= end {
        return "";
    }
    return str_slice(raw, start, end);
}

pub fn semver_parse(raw: String) -> SemverVersion {
    let clean: String = semver_clean(raw);
    let n: Int = chars_len(clean);
    if n == 0 {
        return semver_invalid();
    }

    let mut i: Int = 0;
    let mut major_str: String = "";
    while i < n && char_at(clean, i) != "." && char_at(clean, i) != "-" && char_at(clean, i) != "+" {
        let c: String = char_at(clean, i);
        if !char_is_digit(c) {
            return semver_invalid();
        }
        major_str = major_str + c;
        i = i + 1;
    }
    if chars_len(major_str) == 0 || i >= n || char_at(clean, i) != "." {
        return semver_invalid();
    }
    i = i + 1;

    let mut minor_str: String = "";
    while i < n && char_at(clean, i) != "." && char_at(clean, i) != "-" && char_at(clean, i) != "+" {
        let c: String = char_at(clean, i);
        if !char_is_digit(c) {
            return semver_invalid();
        }
        minor_str = minor_str + c;
        i = i + 1;
    }
    if chars_len(minor_str) == 0 || i >= n || char_at(clean, i) != "." {
        return semver_invalid();
    }
    i = i + 1;

    let mut patch_str: String = "";
    while i < n && char_at(clean, i) != "-" && char_at(clean, i) != "+" {
        let c: String = char_at(clean, i);
        if !char_is_digit(c) {
            return semver_invalid();
        }
        patch_str = patch_str + c;
        i = i + 1;
    }
    if chars_len(patch_str) == 0 {
        return semver_invalid();
    }

    let mut prerelease: String = "";
    if i < n && char_at(clean, i) == "-" {
        i = i + 1;
        let pre_start: Int = i;
        while i < n && char_at(clean, i) != "+" {
            i = i + 1;
        }
        prerelease = str_slice(clean, pre_start, i);
    }

    let mut build: String = "";
    if i < n && char_at(clean, i) == "+" {
        i = i + 1;
        build = str_slice(clean, i, n);
    }

    let maj: Int = semver_parse_int(major_str);
    let min: Int = semver_parse_int(minor_str);
    let pat: Int = semver_parse_int(patch_str);

    return semver_new(maj, min, pat, prerelease, build);
}

pub fn semver_format(v: &SemverVersion) -> String {
    if !(v).is_valid {
        return "";
    }
    let mut out: String = to_string((v).major) + "." + to_string((v).minor) + "." + to_string((v).patch);
    if chars_len((v).prerelease) > 0 {
        out = out + "-" + (v).prerelease;
    }
    if chars_len((v).build) > 0 {
        out = out + "+" + (v).build;
    }
    return out;
}

pub fn semver_valid(raw: String) -> Bool {
    let v: SemverVersion = semver_parse(raw);
    return v.is_valid;
}
