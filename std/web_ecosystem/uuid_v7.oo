// # UUIDv7 (RFC 9562 Int destub)
//
// Logline: 48-bit time split, version 7, variant 8. By-value Int destub.
//
// Setup: hex digits are ASCII codes. time_high = ts/65536, time_mid = ts%65536.
//
// Beats:
//   1. hex_digit: 0-9 -> 48+m, 10-15 -> 87+m ('a'-'f').
//   2. generate: version 7, variant 8, node = rand_a*31+rand_b, rand slots %4096.
//   3. validate: n_chars==36, hyphens at 8/13/18/23, ver '7', var 8/9/a/b/A/B.

type UuidV7 = struct {
    time_high: Int,
    time_mid: Int,
    version: Int,
    rand_a: Int,
    variant: Int,
    rand_b: Int,
    node: Int,
    is_valid: Int
};

pub fn uuid_v7_new(time_high: Int, time_mid: Int, rand_a: Int, rand_b: Int, node: Int) -> UuidV7 {
    return UuidV7 {
        time_high: time_high,
        time_mid: time_mid,
        version: 7,
        rand_a: rand_a,
        variant: 8,
        rand_b: rand_b,
        node: node,
        is_valid: 1
    };
}

pub fn uuid_v7_invalid() -> UuidV7 {
    return UuidV7 {
        time_high: 0,
        time_mid: 0,
        version: 0,
        rand_a: 0,
        variant: 0,
        rand_b: 0,
        node: 0,
        is_valid: 0
    };
}

pub fn hex_digit(v: Int) -> Int {
    let m: Int = v % 16;
    if m < 10 {
        return 48 + m;
    }
    return 87 + m;
}

pub fn hex_pad4_nibble(val: Int, idx: Int) -> Int {
    if idx == 0 {
        return hex_digit((val / 4096) % 16);
    }
    if idx == 1 {
        return hex_digit((val / 256) % 16);
    }
    if idx == 2 {
        return hex_digit((val / 16) % 16);
    }
    return hex_digit(val % 16);
}

pub fn uuid_v7_generate(timestamp_ms: Int, rand_a: Int, rand_b: Int) -> UuidV7 {
    let time_high: Int = timestamp_ms / 65536;
    let time_mid: Int = timestamp_ms % 65536;
    let a12: Int = rand_a % 4096;
    let b12: Int = rand_b % 4096;
    let node: Int = (rand_a * 31) + rand_b;
    return UuidV7 {
        time_high: time_high,
        time_mid: time_mid,
        version: 7,
        rand_a: a12,
        variant: 8,
        rand_b: b12,
        node: node,
        is_valid: 1
    };
}

pub fn uuid_v7_validate(n_chars: Int, h8: Int, h13: Int, h18: Int, h23: Int, ver_ch: Int, var_ch: Int) -> Int {
    if n_chars != 36 {
        return 0;
    }
    if h8 != 45 {
        return 0;
    }
    if h13 != 45 {
        return 0;
    }
    if h18 != 45 {
        return 0;
    }
    if h23 != 45 {
        return 0;
    }
    if ver_ch != 55 {
        return 0;
    }
    if var_ch == 56 {
        return 1;
    }
    if var_ch == 57 {
        return 1;
    }
    if var_ch == 97 {
        return 1;
    }
    if var_ch == 98 {
        return 1;
    }
    if var_ch == 65 {
        return 1;
    }
    if var_ch == 66 {
        return 1;
    }
    return 0;
}
