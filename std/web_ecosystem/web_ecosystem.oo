pub fn web_semver_parse(raw: String) -> SemverVersion {
    return semver_parse(raw);
}

pub fn web_semver_satisfies(v_str: String, range_str: String) -> Bool {
    return semver_satisfies(v_str, range_str);
}

pub fn web_date_format_iso(dt: &DateTime) -> String {
    return format_iso(dt);
}

pub fn web_date_parse_iso(raw: String) -> DateTime {
    return parse_iso(raw);
}

pub fn web_zod_string() -> ZodStringSchema {
    return zod_string();
}

pub fn web_zod_number() -> ZodNumberSchema {
    return zod_number();
}

pub fn web_uuid_v7(ts_ms: Int, rand_a: Int, rand_b: Int) -> String {
    return uuid_v7_generate(ts_ms, rand_a, rand_b);
}

pub fn web_nanoid(seed: Int, size: Int) -> String {
    return nanoid_generate(seed, size);
}

pub fn web_ulid(ts_ms: Int, seed: Int) -> String {
    return ulid_generate(ts_ms, seed);
}

pub fn web_cuid2(counter: Int, ts_ms: Int, fp: Int, len: Int) -> String {
    return cuid2_generate(counter, ts_ms, fp, len);
}

pub fn web_jwt_encode(h_b64: String, p_b64: String, sig: String) -> String {
    return jwt_encode_token(h_b64, p_b64, sig);
}

pub fn web_jwt_decode_claims(token: String) -> String {
    return jwt_decode_claims(token);
}

pub fn web_markdown_render(md: String) -> String {
    return markdown_to_html(md);
}

pub fn web_html_sanitize(html: String) -> String {
    let opts: SanitizeOptions = sanitize_options_default();
    return sanitize_html(html, &opts);
}

pub fn web_qs_parse(query: String) -> List[KeyValuePair] {
    return qs_parse(query);
}

pub fn web_qs_stringify(params: List[KeyValuePair]) -> String {
    return qs_stringify(params);
}

pub fn web_mime_lookup(path: String) -> String {
    return mime_lookup_content_type(path);
}

pub fn web_url_parse(raw_url: String) -> UrlComponents {
    return url_parse(raw_url);
}

pub fn web_slugify(input: String) -> String {
    return slugify(input);
}

pub fn web_lru_cache_new(cap: Int) -> LruCache {
    return lru_cache_new(cap);
}

pub fn web_humanize_bytes(bytes_count: Int) -> String {
    return humanize_bytes(bytes_count);
}
