// # Markdown to HTML Parser and Renderer
//
// Logline: Converts CommonMark Markdown documents into sanitized HTML syntax trees and markup strings.
//
// Setup: Pure Markdown compiler converting headers, code blocks, bold/italics, quotes, and links.
//
// Beats:
//   1. Parse block elements including h1-h6 headers, fenced code blocks, and blockquotes.
//   2. Parse inline spans for bold, italic, inline code, and hyperlink elements.
//   3. Assemble well-formed HTML output documents with standard paragraph encapsulation.

pub fn md_render_inline(line: String) -> String {
    let n: Int = chars_len(line);
    let mut out: String = "";
    let mut i: Int = 0;

    while i < n {
        // Inline code: `code`
        if char_at(line, i) == "`" {
            let mut j: Int = i + 1;
            while j < n && char_at(line, j) != "`" {
                j = j + 1;
            }
            if j < n {
                let code_content: String = str_slice(line, i + 1, j);
                out = out + "<code>" + code_content + "</code>";
                i = j + 1;
            } else {
                out = out + "`";
                i = i + 1;
            }
        }
        // Bold: **text**
        else if i + 2 <= n && str_slice(line, i, i + 2) == "**" {
            let mut j: Int = i + 2;
            while j + 2 <= n && str_slice(line, j, j + 2) != "**" {
                j = j + 1;
            }
            if j + 2 <= n {
                let bold_content: String = str_slice(line, i + 2, j);
                out = out + "<strong>" + bold_content + "</strong>";
                i = j + 2;
            } else {
                out = out + "**";
                i = i + 2;
            }
        }
        // Link: [text](url)
        else if char_at(line, i) == "[" {
            let mut j: Int = i + 1;
            while j < n && char_at(line, j) != "]" {
                j = j + 1;
            }
            if j + 1 < n && char_at(line, j + 1) == "(" {
                let mut k: Int = j + 2;
                while k < n && char_at(line, k) != ")" {
                    k = k + 1;
                }
                if k < n {
                    let label: String = str_slice(line, i + 1, j);
                    let url: String = str_slice(line, j + 2, k);
                    out = out + "<a href=\"" + url + "\">" + label + "</a>";
                    i = k + 1;
                } else {
                    out = out + "[";
                    i = i + 1;
                }
            } else {
                out = out + "[";
                i = i + 1;
            }
        } else {
            out = out + char_at(line, i);
            i = i + 1;
        }
    }

    return out;
}

pub fn markdown_to_html(md: String) -> String {
    let n: Int = chars_len(md);
    let mut out: String = "";
    let mut i: Int = 0;
    let mut in_code_block: Bool = false;

    while i < n {
        // Read line
        let mut line_end: Int = i;
        while line_end < n && char_at(md, line_end) != "\n" {
            line_end = line_end + 1;
        }
        let line: String = str_slice(md, i, line_end);
        let l_len: Int = chars_len(line);

        // Fenced code block check
        if l_len >= 3 && str_slice(line, 0, 3) == "```" {
            if in_code_block {
                out = out + "</code></pre>\n";
                in_code_block = false;
            } else {
                out = out + "<pre><code>";
                in_code_block = true;
            }
        } else if in_code_block {
            out = out + line + "\n";
        } else if l_len > 2 && str_slice(line, 0, 2) == "# " {
            let h1: String = str_slice(line, 2, l_len);
            out = out + "<h1>" + md_render_inline(h1) + "</h1>\n";
        } else if l_len > 3 && str_slice(line, 0, 3) == "## " {
            let h2: String = str_slice(line, 3, l_len);
            out = out + "<h2>" + md_render_inline(h2) + "</h2>\n";
        } else if l_len > 4 && str_slice(line, 0, 4) == "### " {
            let h3: String = str_slice(line, 4, l_len);
            out = out + "<h3>" + md_render_inline(h3) + "</h3>\n";
        } else if l_len > 2 && str_slice(line, 0, 2) == "> " {
            let quote: String = str_slice(line, 2, l_len);
            out = out + "<blockquote><p>" + md_render_inline(quote) + "</p></blockquote>\n";
        } else if l_len > 2 && (str_slice(line, 0, 2) == "- " || str_slice(line, 0, 2) == "* ") {
            let item: String = str_slice(line, 2, l_len);
            out = out + "<li>" + md_render_inline(item) + "</li>\n";
        } else if l_len > 0 {
            out = out + "<p>" + md_render_inline(line) + "</p>\n";
        }

        i = line_end + 1;
    }

    if in_code_block {
        out = out + "</code></pre>\n";
    }

    return out;
}
