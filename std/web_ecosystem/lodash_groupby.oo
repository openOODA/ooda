// # Lodash countBy / partition (4-slot Int destub)
//
// Logline: Frequency buckets and prefix partition. List[String] destubbed.
//
// Setup: Four key/n_ slots. Prefix match is item repeatedly /10 until prefix.
//
// Beats:
//   1. count_by increments matching key or opens next empty slot.
//   2. partition sends prefix-matching items to matches else rejects.
//   3. n_match / n_reject report occupancy (no field named count).

type CountBag = struct {
    k0: Int, n0: Int, k1: Int, n1: Int, k2: Int, n2: Int, k3: Int, n3: Int,
    filled: Int
};

type PartBag = struct {
    m0: Int, m1: Int, m2: Int, m3: Int, n_match: Int, r0: Int, r1: Int, r2: Int,
    r3: Int, n_reject: Int
};

type Int4 = struct { e0: Int, e1: Int, e2: Int, e3: Int, filled: Int };

pub fn count_bag_new() -> CountBag {
    return CountBag { k0: 0, n0: 0, k1: 0, n1: 0, k2: 0, n2: 0, k3: 0, n3: 0, filled: 0 };
}

fn count_add(bag: CountBag, item: Int, live: Int) -> CountBag {
    if live == 0  { return bag; }
    if bag.filled > 0 && bag.k0 == item {
        return CountBag {
            k0: bag.k0, n0: bag.n0 + 1, k1: bag.k1, n1: bag.n1, k2: bag.k2, n2: bag.n2,
            k3: bag.k3, n3: bag.n3, filled: bag.filled
        };
    }
    if bag.filled > 1 && bag.k1 == item {
        return CountBag {
            k0: bag.k0, n0: bag.n0, k1: bag.k1, n1: bag.n1 + 1, k2: bag.k2, n2: bag.n2,
            k3: bag.k3, n3: bag.n3, filled: bag.filled
        };
    }
    if bag.filled > 2 && bag.k2 == item {
        return CountBag {
            k0: bag.k0, n0: bag.n0, k1: bag.k1, n1: bag.n1, k2: bag.k2, n2: bag.n2 + 1,
            k3: bag.k3, n3: bag.n3, filled: bag.filled
        };
    }
    if bag.filled > 3 && bag.k3 == item {
        return CountBag {
            k0: bag.k0, n0: bag.n0, k1: bag.k1, n1: bag.n1, k2: bag.k2, n2: bag.n2,
            k3: bag.k3, n3: bag.n3 + 1, filled: bag.filled
        };
    }
    if bag.filled == 0 {
        return CountBag { k0: item, n0: 1, k1: 0, n1: 0, k2: 0, n2: 0, k3: 0, n3: 0, filled: 1 };
    }
    if bag.filled == 1 {
        return CountBag {
            k0: bag.k0, n0: bag.n0, k1: item, n1: 1, k2: 0, n2: 0, k3: 0, n3: 0,
            filled: 2
        };
    }
    if bag.filled == 2 {
        return CountBag {
            k0: bag.k0, n0: bag.n0, k1: bag.k1, n1: bag.n1, k2: item, n2: 1, k3: 0,
            n3: 0, filled: 3
        };
    }
    if bag.filled == 3 {
        return CountBag {
            k0: bag.k0, n0: bag.n0, k1: bag.k1, n1: bag.n1, k2: bag.k2, n2: bag.n2,
            k3: item, n3: 1, filled: 4
        };
    }
    return bag;
}

fn slot_live(filled: Int, idx: Int) -> Int {
    if filled > idx  { return 1; }
    return 0;
}

pub fn lodash_count_by(items: Int4) -> CountBag {
    let l0: Int = slot_live(items.filled, 0);
    let l1: Int = slot_live(items.filled, 1);
    let l2: Int = slot_live(items.filled, 2);
    let l3: Int = slot_live(items.filled, 3);
    let s0: CountBag = count_add(count_bag_new(), items.e0, l0);
    let s1: CountBag = count_add(s0, items.e1, l1);
    let s2: CountBag = count_add(s1, items.e2, l2);
    return count_add(s2, items.e3, l3);
}

pub fn int_has_prefix(item: Int, prefix: Int) -> Int {
    if item == prefix  { return 1; }
    let d1: Int = item / 10;
    if d1 == prefix  { return 1; }
    if d1 == 0  { return 0; }
    let d2: Int = d1 / 10;
    if d2 == prefix  { return 1; }
    if d2 == 0  { return 0; }
    let d3: Int = d2 / 10;
    if d3 == prefix  { return 1; }
    if d3 == 0  { return 0; }
    let d4: Int = d3 / 10;
    if d4 == prefix  { return 1; }
    return 0;
}

fn part_push_match(p: PartBag, item: Int) -> PartBag {
    if p.n_match == 0 {
        return PartBag {
            m0: item, m1: p.m1, m2: p.m2, m3: p.m3, n_match: 1, r0: p.r0, r1: p.r1,
            r2: p.r2, r3: p.r3, n_reject: p.n_reject
        };
    }
    if p.n_match == 1 {
        return PartBag {
            m0: p.m0, m1: item, m2: p.m2, m3: p.m3, n_match: 2, r0: p.r0, r1: p.r1,
            r2: p.r2, r3: p.r3, n_reject: p.n_reject
        };
    }
    if p.n_match == 2 {
        return PartBag {
            m0: p.m0, m1: p.m1, m2: item, m3: p.m3, n_match: 3, r0: p.r0, r1: p.r1,
            r2: p.r2, r3: p.r3, n_reject: p.n_reject
        };
    }
    if p.n_match == 3 {
        return PartBag {
            m0: p.m0, m1: p.m1, m2: p.m2, m3: item, n_match: 4, r0: p.r0, r1: p.r1,
            r2: p.r2, r3: p.r3, n_reject: p.n_reject
        };
    }
    return p;
}

fn part_push_reject(p: PartBag, item: Int) -> PartBag {
    if p.n_reject == 0 {
        return PartBag {
            m0: p.m0, m1: p.m1, m2: p.m2, m3: p.m3, n_match: p.n_match, r0: item,
            r1: p.r1, r2: p.r2, r3: p.r3, n_reject: 1
        };
    }
    if p.n_reject == 1 {
        return PartBag {
            m0: p.m0, m1: p.m1, m2: p.m2, m3: p.m3, n_match: p.n_match, r0: p.r0,
            r1: item, r2: p.r2, r3: p.r3, n_reject: 2
        };
    }
    if p.n_reject == 2 {
        return PartBag {
            m0: p.m0, m1: p.m1, m2: p.m2, m3: p.m3, n_match: p.n_match, r0: p.r0,
            r1: p.r1, r2: item, r3: p.r3, n_reject: 3
        };
    }
    if p.n_reject == 3 {
        return PartBag {
            m0: p.m0, m1: p.m1, m2: p.m2, m3: p.m3, n_match: p.n_match, r0: p.r0,
            r1: p.r1, r2: p.r2, r3: item, n_reject: 4
        };
    }
    return p;
}

fn part_take(p: PartBag, item: Int, live: Int, prefix: Int) -> PartBag {
    if live == 0  { return p; }
    if int_has_prefix(item, prefix) == 1  { return part_push_match(p, item); }
    return part_push_reject(p, item);
}

pub fn lodash_partition_prefix(items: Int4, prefix: Int) -> PartBag {
    let empty: PartBag = PartBag {
        m0: 0, m1: 0, m2: 0, m3: 0, n_match: 0, r0: 0, r1: 0, r2: 0, r3: 0,
        n_reject: 0
    };
    let l0: Int = slot_live(items.filled, 0);
    let l1: Int = slot_live(items.filled, 1);
    let l2: Int = slot_live(items.filled, 2);
    let l3: Int = slot_live(items.filled, 3);
    let s0: PartBag = part_take(empty, items.e0, l0, prefix);
    let s1: PartBag = part_take(s0, items.e1, l1, prefix);
    let s2: PartBag = part_take(s1, items.e2, l2, prefix);
    return part_take(s2, items.e3, l3, prefix);
}

pub fn int4_of(e0: Int, e1: Int, e2: Int, e3: Int, filled: Int) -> Int4 {
    return Int4 { e0: e0, e1: e1, e2: e2, e3: e3, filled: filled };
}
