// # URL default ports (Int destub floor)
//
// Logline: http=80 https=443 ftp=21 ws=80 wss=443. Destubbed off String URL parse.
//
// Setup: scheme codes 1=http 2=https 3=ftp 4=ws 5=wss.
//
// Beats:
//   1. default port by scheme.
//   2. explicit port wins if >0.
//   3. unknown scheme port 0.

pub fn url_scheme_http() -> Int { return 1; }
pub fn url_scheme_https() -> Int { return 2; }
pub fn url_scheme_ftp() -> Int { return 3; }

pub fn url_default_port(scheme: Int) -> Int {
    if scheme == 1 {
        return 80;
    }
    if scheme == 2 {
        return 443;
    }
    if scheme == 3 {
        return 21;
    }
    if scheme == 4 {
        return 80;
    }
    if scheme == 5 {
        return 443;
    }
    return 0;
}

pub fn url_effective_port(scheme: Int, explicit_port: Int) -> Int {
    if explicit_port > 0 {
        return explicit_port;
    }
    return url_default_port(scheme);
}
