// # Fast glob match (Int destub floor)
//
// Logline: Star / exact / prefix* / *.suffix. Off String / List[String].
//
// Setup: Lengths and Int ids. n_match not count.
//
// Beats:
//   1. * and ** match any.
//   2. exact if pattern_id == text_id.
//   3. prefix/suffix wildcards require text_n >= needle_n and id match.

pub fn glob_match_star() -> Int {
    return 1;
}

pub fn glob_match_exact(pattern_id: Int, text_id: Int) -> Int {
    if pattern_id == text_id {
        return 1;
    }
    return 0;
}

pub fn glob_match_suffix(text_n: Int, suffix_n: Int) -> Int {
    if text_n >= suffix_n {
        return 1;
    }
    return 0;
}

pub fn glob_match_prefix(text_n: Int, prefix_n: Int) -> Int {
    if text_n >= prefix_n {
        return 1;
    }
    return 0;
}

pub fn glob_star_suffix(text_suffix: Int, pat_suffix: Int, text_n: Int, suffix_n: Int) -> Int {
    if text_n < suffix_n {
        return 0;
    }
    if text_suffix == pat_suffix {
        return 1;
    }
    return 0;
}

pub fn glob_star_prefix(text_prefix: Int, pat_prefix: Int, text_n: Int, prefix_n: Int) -> Int {
    if text_n < prefix_n {
        return 0;
    }
    if text_prefix == pat_prefix {
        return 1;
    }
    return 0;
}

pub fn glob_filter_n(path0_ok: Int, path1_ok: Int) -> Int {
    let n0: Int = if path0_ok == 1 { 1 } else { 0 };
    let n1: Int = if path1_ok == 1 { 1 } else { 0 };
    return n0 + n1;
}
