// # Zod string length validator (Int destub floor)
//
// Logline: min/max length checks. Destubbed off String formats / &T / pub type.
//
// Setup: Prefix/email/url destubbed. Length only.
//
// Beats:
//   1. default min 0 max 1000000000.
//   2. min/max builders.
//   3. parse fails if n < min or n > max.

type ZodStringSchema = struct {
    min_n: Int,
    max_n: Int
};

pub fn zod_string() -> ZodStringSchema {
    return ZodStringSchema { min_n: 0, max_n: 1000000000 };
}

pub fn zod_string_min(s: ZodStringSchema, min: Int) -> ZodStringSchema {
    return ZodStringSchema { min_n: min, max_n: s.max_n };
}

pub fn zod_string_max(s: ZodStringSchema, max: Int) -> ZodStringSchema {
    return ZodStringSchema { min_n: s.min_n, max_n: max };
}

pub fn zod_string_parse_len(s: ZodStringSchema, n: Int) -> Int {
    if n < s.min_n {
        return 0;
    }
    if n > s.max_n {
        return 0;
    }
    return 1;
}
