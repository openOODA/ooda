// # JWT exp/nbf/iat checks (Int destub floor)
//
// Logline: exp must be > now-skew; nbf <= now+skew. Destubbed off String claims.
//
// Setup: clock_tolerance_sec default 60.
//
// Beats:
//   1. expired if exp + skew < now.
//   2. not-yet if nbf > now + skew.
//   3. ok otherwise.

pub fn jwt_clock_skew_default() -> Int {
    return 60;
}

pub fn jwt_exp_ok(exp: Int, now: Int, skew: Int) -> Int {
    if (exp + skew) < now {
        return 0;
    }
    return 1;
}

pub fn jwt_nbf_ok(nbf: Int, now: Int, skew: Int) -> Int {
    if nbf > (now + skew) {
        return 0;
    }
    return 1;
}

pub fn jwt_time_ok(exp: Int, nbf: Int, now: Int, skew: Int) -> Int {
    if jwt_exp_ok(exp, now, skew) == 0 {
        return 0;
    }
    if jwt_nbf_ok(nbf, now, skew) == 0 {
        return 0;
    }
    return 1;
}
