// # Lodash merge/defaults/pick (4-slot Int destub)
//
// Logline: Source overwrites matching keys; defaults fill zeros. List[struct] destubbed.
//
// Setup: Four key/val slots.
//
// Beats:
//   1. get returns val for key else default.
//   2. merge overwrites matching key.
//   3. defaults fills empty val.

type KvMap = struct {
    k0: Int,
    v0: Int,
    k1: Int,
    v1: Int
};

pub fn kv_map_new(k0: Int, v0: Int, k1: Int, v1: Int) -> KvMap {
    return KvMap { k0: k0, v0: v0, k1: k1, v1: v1 };
}

pub fn lodash_get_kv(m: KvMap, key: Int, default_val: Int) -> Int {
    if m.k0 == key {
        return m.v0;
    }
    if m.k1 == key {
        return m.v1;
    }
    return default_val;
}

fn kv_pick(k: Int, v: Int, key: Int, cur: Int) -> Int {
    if k == key {
        return v;
    }
    return cur;
}

pub fn lodash_merge_kv(target: KvMap, source: KvMap) -> KvMap {
    let v0a: Int = kv_pick(source.k0, source.v0, target.k0, target.v0);
    let v0: Int = kv_pick(source.k1, source.v1, target.k0, v0a);
    let v1a: Int = kv_pick(source.k0, source.v0, target.k1, target.v1);
    let v1: Int = kv_pick(source.k1, source.v1, target.k1, v1a);
    return KvMap { k0: target.k0, v0: v0, k1: target.k1, v1: v1 };
}

fn kv_default(cur: Int, dk: Int, dv: Int, key: Int) -> Int {
    if cur == 0 {
        if dk == key {
            return dv;
        }
    }
    return cur;
}

pub fn lodash_defaults_kv(target: KvMap, defaults: KvMap) -> KvMap {
    let v0a: Int = kv_default(target.v0, defaults.k0, defaults.v0, target.k0);
    let v0: Int = kv_default(v0a, defaults.k1, defaults.v1, target.k0);
    let v1a: Int = kv_default(target.v1, defaults.k0, defaults.v0, target.k1);
    let v1: Int = kv_default(v1a, defaults.k1, defaults.v1, target.k1);
    return KvMap { k0: target.k0, v0: v0, k1: target.k1, v1: v1 };
}
