// # HTTP form-data fields (Int destub floor)
//
// Logline: Text vs file fields; urlencoded pair fill. Off pub type / String / List.
//
// Setup: Two key/val slots. filled not count. Imports destubbed qs pair_n.
//
// Beats:
//   1. text field is_file=0; file field is_file=1.
//   2. empty query filled=0; ampersands+1 pairs (cap 2).
//   3. encode tokens = pairs + separators.

import "./qs_query_string.oo";

type FormDataField = struct {
    name: Int,
    value: Int,
    is_file: Int,
    filename: Int
};

type FormData = struct {
    k0: Int,
    v0: Int,
    k1: Int,
    v1: Int,
    filled: Int
};

pub fn form_field_text(name: Int, value: Int) -> FormDataField {
    return FormDataField {
        name: name,
        value: value,
        is_file: 0,
        filename: 0
    };
}

pub fn form_field_file(name: Int, filename: Int, value: Int) -> FormDataField {
    return FormDataField {
        name: name,
        value: value,
        is_file: 1,
        filename: filename
    };
}

pub fn form_data_parse_urlencoded(query_n: Int, ampersand_n: Int, k0: Int, v0: Int, k1: Int, v1: Int) -> FormData {
    let n_pairs: Int = qs_pair_n(query_n, ampersand_n);
    if n_pairs <= 0 {
        return FormData {
            k0: 0,
            v0: 0,
            k1: 0,
            v1: 0,
            filled: 0
        };
    }
    if n_pairs == 1 {
        return FormData {
            k0: k0,
            v0: v0,
            k1: 0,
            v1: 0,
            filled: 1
        };
    }
    return FormData {
        k0: k0,
        v0: v0,
        k1: k1,
        v1: v1,
        filled: 2
    };
}

pub fn form_data_get(data: FormData, key: Int, default_val: Int) -> Int {
    return qs_get(data.k0, data.v0, data.k1, data.v1, key, default_val);
}

pub fn form_data_encode_n(filled: Int) -> Int {
    if filled <= 0 {
        return 0;
    }
    return filled + (filled - 1);
}
