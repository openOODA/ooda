// # Zod object required-field count (Int destub floor)
//
// Logline: missing = required - present (floored 0). Destubbed off List[struct].
//
// Setup: strict unused at this floor.
//
// Beats:
//   1. parse ok if present >= required.
//   2. missing = required - present.
//   3. extra keys fail if strict and extra > 0.

pub fn zod_object_missing(required_n: Int, present_n: Int) -> Int {
    if present_n >= required_n {
        return 0;
    }
    return required_n - present_n;
}

pub fn zod_object_ok(required_n: Int, present_n: Int) -> Int {
    if zod_object_missing(required_n, present_n) == 0 {
        return 1;
    }
    return 0;
}

pub fn zod_object_strict_ok(extra_n: Int, is_strict: Int) -> Int {
    if is_strict == 1 {
        if extra_n > 0 {
            return 0;
        }
    }
    return 1;
}
