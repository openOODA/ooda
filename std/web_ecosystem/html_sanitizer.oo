// # HTML dangerous-tag classifier (Int destub floor)
//
// Logline: script/iframe/object/embed/style/form/input/button/meta are dangerous.
//
// Setup: Tag codes: 1 script 2 iframe 3 object 4 embed 5 style 6 form 7 input 8 button 9 meta.
//
// Beats:
//   1. is_dangerous returns 1 for those codes.
//   2. allow_links default 1.
//   3. strip_tags of empty input is 0 remaining.

pub fn html_tag_script() -> Int { return 1; }
pub fn html_tag_iframe() -> Int { return 2; }
pub fn html_tag_div() -> Int { return 10; }

pub fn html_is_dangerous_tag(tag: Int) -> Int {
    if tag >= 1 {
        if tag <= 9 {
            return 1;
        }
    }
    return 0;
}

pub fn html_allow_links_default() -> Int {
    return 1;
}
