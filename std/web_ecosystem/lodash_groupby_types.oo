// # Lodash countBy / partition Types
//
// Logline: CountBag, PartBag, and Int4 struct definitions plus default constructors and int4_of.
//
// Setup: Four key/n_ slots in CountBag, four m_/r_ slots in PartBag, four e_ slots in Int4.
//
// Beats:
//   1. Define CountBag, PartBag, Int4.
//   2. count_bag_new: all slots zero, filled 0.
//   3. int4_of: build an Int4 with explicit e0..e3 and filled.

type CountBag = struct {
    k0: Int,
    n0: Int,
    k1: Int,
    n1: Int,
    k2: Int,
    n2: Int,
    k3: Int,
    n3: Int,
    filled: Int
};

type PartBag = struct {
    m0: Int,
    m1: Int,
    m2: Int,
    m3: Int,
    n_match: Int,
    r0: Int,
    r1: Int,
    r2: Int,
    r3: Int,
    n_reject: Int
};

type Int4 = struct {
    e0: Int,
    e1: Int,
    e2: Int,
    e3: Int,
    filled: Int
};

pub fn count_bag_new() -> CountBag {
    return CountBag {
        k0: 0,
        n0: 0,
        k1: 0,
        n1: 0,
        k2: 0,
        n2: 0,
        k3: 0,
        n3: 0,
        filled: 0
    };
}

pub fn int4_of(e0: Int, e1: Int, e2: Int, e3: Int, filled: Int) -> Int4 {
    return Int4 { e0: e0, e1: e1, e2: e2, e3: e3, filled: filled };
}

pub fn slot_live(filled: Int, idx: Int) -> Int {
    if filled > idx {
        return 1;
    }
    return 0;
}
