// # Human-Readable Bytes, Durations, and Metrics Formatter
//
// Logline: Converts raw byte counts, millisecond durations, and large integers into readable human-friendly representations.
//
// Setup: Pure text formatting module providing pretty-bytes and ms parity.
//
// Beats:
//   1. Format byte counts into B, KB, MB, GB, and TB units with decimal precision.
//   2. Format millisecond spans into days, hours, minutes, seconds, and milliseconds.
//   3. Format large integer metrics with metric suffix units (k, M, B).

pub fn humanize_bytes(bytes_count: Int) -> String {
    if bytes_count < 1024 {
        return to_string(bytes_count) + " B";
    }
    if bytes_count < 1048576 {
        let kb: Int = bytes_count / 1024;
        let rem: Int = (bytes_count % 1024) * 10 / 1024;
        return to_string(kb) + "." + to_string(rem) + " KB";
    }
    if bytes_count < 1073741824 {
        let mb: Int = bytes_count / 1048576;
        let rem: Int = (bytes_count % 1048576) * 10 / 1048576;
        return to_string(mb) + "." + to_string(rem) + " MB";
    }

    let gb: Int = bytes_count / 1073741824;
    let rem: Int = (bytes_count % 1073741824) * 10 / 1073741824;
    return to_string(gb) + "." + to_string(rem) + " GB";
}

pub fn humanize_duration(ms: Int) -> String {
    if ms < 1000 {
        return to_string(ms) + "ms";
    }
    if ms < 60000 {
        let s: Int = ms / 1000;
        let rem: Int = (ms % 1000) / 100;
        return to_string(s) + "." + to_string(rem) + "s";
    }
    if ms < 3600000 {
        let m: Int = ms / 60000;
        let s: Int = (ms % 60000) / 1000;
        return to_string(m) + "m " + to_string(s) + "s";
    }

    let h: Int = ms / 3600000;
    let m: Int = (ms % 3600000) / 60000;
    return to_string(h) + "h " + to_string(m) + "m";
}

pub fn humanize_metric_number(val: Int) -> String {
    if val < 1000 {
        return to_string(val);
    }
    if val < 1000000 {
        let k: Int = val / 1000;
        let rem: Int = (val % 1000) / 100;
        return to_string(k) + "." + to_string(rem) + "k";
    }

    let m: Int = val / 1000000;
    let rem: Int = (val % 1000000) / 100000;
    return to_string(m) + "." + to_string(rem) + "M";
}
