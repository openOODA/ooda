// # ULID (Universally Unique Lexicographically Sortable Identifier) Generator
//
// Logline: Encodes 48-bit timestamp and 80-bit randomness into Crockford Base32 26-character sortable identifiers.
//
// Setup: Pure ULID specification generator with monotonic lexical sorting.
//
// Beats:
//   1. Implement Crockford Base32 alphabet encoding excluding ambiguous characters (I, L, O, U).
//   2. Encode high 10 characters from Unix epoch millisecond timestamp.
//   3. Generate trailing 16 characters from pseudo-random entropy state.

pub fn crockford_base32_alphabet() -> String {
    return "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
}

pub fn ulid_next_rand(state: Int) -> Int {
    let a: Int = 1664525;
    let c: Int = 1013904223;
    let m: Int = 2147483647;
    let next: Int = (state * a + c) % m;
    return if next < 0 { 0 - next } else { next };
}

pub fn ulid_encode_time(timestamp_ms: Int, len: Int) -> String {
    let alpha: String = crockford_base32_alphabet();
    let mut out: String = "";
    let mut v: Int = timestamp_ms;
    let mut i: Int = 0;

    while i < len {
        let rem: Int = v % 32;
        out = char_at(alpha, rem) + out;
        v = v / 32;
        i = i + 1;
    }

    return out;
}

pub fn ulid_encode_random(seed: Int, len: Int) -> String {
    let alpha: String = crockford_base32_alphabet();
    let mut out: String = "";
    let mut cur: Int = if seed != 0 { seed } else { 9876543 };
    let mut i: Int = 0;

    while i < len {
        cur = ulid_next_rand(cur);
        let rem: Int = cur % 32;
        out = out + char_at(alpha, rem);
        i = i + 1;
    }

    return out;
}

pub fn ulid_generate(timestamp_ms: Int, seed: Int) -> String {
    let time_part: String = ulid_encode_time(timestamp_ms, 10);
    let rand_part: String = ulid_encode_random(seed, 16);
    return time_part + rand_part;
}

pub fn ulid_is_valid(ulid_str: String) -> Bool {
    if chars_len(ulid_str) != 26 {
        return false;
    }
    let alpha: String = crockford_base32_alphabet();
    let mut i: Int = 0;

    while i < 26 {
        let ch: String = char_at(ulid_str, i);
        let mut found: Bool = false;
        let mut j: Int = 0;
        while j < 32 {
            if char_at(alpha, j) == ch {
                found = true;
            }
            j = j + 1;
        }
        if !found {
            return false;
        }
        i = i + 1;
    }

    return true;
}
