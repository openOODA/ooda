// # Chalk ANSI Terminal Color and Styling Engine
//
// Logline: Applies ANSI escape sequences for text formatting, foreground colors, and ANSI code stripping.
//
// Setup: Pure terminal styling module providing Chalk API compatibility.
//
// Beats:
//   1. Apply ANSI formatting styles (bold, dim, underline, reset).
//   2. Apply 8-color foreground codes (red, green, yellow, blue, magenta, cyan, gray).
//   3. Strip ANSI escape sequences from styled terminal output.

pub fn chalk_wrap(open_code: String, text: String, close_code: String) -> String {
    let esc: String = bytes_to_str(bytes_push(bytes_new(), 27));
    return esc + "[" + open_code + "m" + text + esc + "[" + close_code + "m";
}

pub fn chalk_bold(text: String) -> String {
    return chalk_wrap("1", text, "22");
}

pub fn chalk_dim(text: String) -> String {
    return chalk_wrap("2", text, "22");
}

pub fn chalk_underline(text: String) -> String {
    return chalk_wrap("4", text, "24");
}

pub fn chalk_red(text: String) -> String {
    return chalk_wrap("31", text, "39");
}

pub fn chalk_green(text: String) -> String {
    return chalk_wrap("32", text, "39");
}

pub fn chalk_yellow(text: String) -> String {
    return chalk_wrap("33", text, "39");
}

pub fn chalk_blue(text: String) -> String {
    return chalk_wrap("34", text, "39");
}

pub fn chalk_magenta(text: String) -> String {
    return chalk_wrap("35", text, "39");
}

pub fn chalk_cyan(text: String) -> String {
    return chalk_wrap("36", text, "39");
}

pub fn chalk_gray(text: String) -> String {
    return chalk_wrap("90", text, "39");
}

pub fn chalk_strip_ansi(styled: String) -> String {
    let n: Int = chars_len(styled);
    let mut out: String = "";
    let mut i: Int = 0;

    while i < n {
        let b: Int = byte_at(styled, i);
        if b == 27 && i + 1 < n && char_at(styled, i + 1) == "[" {
            let mut j: Int = i + 2;
            while j < n && char_at(styled, j) != "m" {
                j = j + 1;
            }
            i = if j < n { j + 1 } else { j };
        } else {
            out = out + char_at(styled, i);
            i = i + 1;
        }
    }

    return out;
}
