// # Lodash countBy Implementation
//
// Logline: Frequency-bucket by item Int key into a 4-slot CountBag.
//
// Setup: Bump existing slot if k0..k3 matches, else open next empty slot; cap at 4 keys.
//
// Beats:
//   1. count_add (private): if live=0 return bag; else if filled>0 and k0==item bump n0, etc.
//   2. Else, if filled==0..3, open slot and write key.
//   3. slot_live: 1 if filled>idx else 0.
//   4. lodash_count_by: fold items.e0..e3 into a CountBag honoring live slots.

import "./lodash_groupby_types.oo";

fn count_add(bag: CountBag, item: Int, live: Int) -> CountBag {
    if live == 0 {
        return bag;
    }
    if bag.filled > 0 && bag.k0 == item {
        return CountBag {
            k0: bag.k0,
            n0: bag.n0 + 1,
            k1: bag.k1,
            n1: bag.n1,
            k2: bag.k2,
            n2: bag.n2,
            k3: bag.k3,
            n3: bag.n3,
            filled: bag.filled
        };
    }
    if bag.filled > 1 && bag.k1 == item {
        return CountBag {
            k0: bag.k0,
            n0: bag.n0,
            k1: bag.k1,
            n1: bag.n1 + 1,
            k2: bag.k2,
            n2: bag.n2,
            k3: bag.k3,
            n3: bag.n3,
            filled: bag.filled
        };
    }
    if bag.filled > 2 && bag.k2 == item {
        return CountBag {
            k0: bag.k0,
            n0: bag.n0,
            k1: bag.k1,
            n1: bag.n1,
            k2: bag.k2,
            n2: bag.n2 + 1,
            k3: bag.k3,
            n3: bag.n3,
            filled: bag.filled
        };
    }
    if bag.filled > 3 && bag.k3 == item {
        return CountBag {
            k0: bag.k0,
            n0: bag.n0,
            k1: bag.k1,
            n1: bag.n1,
            k2: bag.k2,
            n2: bag.n2,
            k3: bag.k3,
            n3: bag.n3 + 1,
            filled: bag.filled
        };
    }
    if bag.filled == 0 {
        return CountBag {
            k0: item,
            n0: 1,
            k1: 0,
            n1: 0,
            k2: 0,
            n2: 0,
            k3: 0,
            n3: 0,
            filled: 1
        };
    }
    if bag.filled == 1 {
        return CountBag {
            k0: bag.k0,
            n0: bag.n0,
            k1: item,
            n1: 1,
            k2: 0,
            n2: 0,
            k3: 0,
            n3: 0,
            filled: 2
        };
    }
    if bag.filled == 2 {
        return CountBag {
            k0: bag.k0,
            n0: bag.n0,
            k1: bag.k1,
            n1: bag.n1,
            k2: item,
            n2: 1,
            k3: 0,
            n3: 0,
            filled: 3
        };
    }
    if bag.filled == 3 {
        return CountBag {
            k0: bag.k0,
            n0: bag.n0,
            k1: bag.k1,
            n1: bag.n1,
            k2: bag.k2,
            n2: bag.n2,
            k3: item,
            n3: 1,
            filled: 4
        };
    }
    return bag;
}

pub fn lodash_count_by(items: Int4) -> CountBag {
    let l0: Int = slot_live(items.filled, 0);
    let l1: Int = slot_live(items.filled, 1);
    let l2: Int = slot_live(items.filled, 2);
    let l3: Int = slot_live(items.filled, 3);
    let s0: CountBag = count_add(count_bag_new(), items.e0, l0);
    let s1: CountBag = count_add(s0, items.e1, l1);
    let s2: CountBag = count_add(s1, items.e2, l2);
    return count_add(s2, items.e3, l3);
}
