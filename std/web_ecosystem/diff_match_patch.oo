// # Diff prefix/suffix/Levenshtein (Int destub floor)
//
// Logline: EQUAL=0 INSERT=1 DELETE=-1; mid lengths after prefix/suffix. Off pub type / String / List.
//
// Setup: Lengths only. Prefix clamped to min(n1,n2); suffix clamped to remainder.
//
// Beats:
//   1. compute_simple: EQUAL prefix, DELETE mid1, INSERT mid2, EQUAL suffix.
//   2. empty side Levenshtein is the other length.
//   3. else Levenshtein is max(n1,n2)-prefix (published remainder-max).

type DiffScript = struct {
    prefix_n: Int,
    del_n: Int,
    ins_n: Int,
    suffix_n: Int
};

pub fn diff_chunk_equal() -> Int {
    return 0;
}

pub fn diff_chunk_insert() -> Int {
    return 1;
}

pub fn diff_chunk_delete() -> Int {
    return 0 - 1;
}

pub fn diff_clamp_prefix(n1: Int, n2: Int, match_n: Int) -> Int {
    let min_len: Int = if n1 < n2 { n1 } else { n2 };
    if match_n < min_len {
        return match_n;
    }
    return min_len;
}

pub fn diff_compute_simple(n1: Int, n2: Int, prefix_n: Int, suffix_n: Int) -> DiffScript {
    let p: Int = diff_clamp_prefix(n1, n2, prefix_n);
    let min_len: Int = if n1 < n2 { n1 } else { n2 };
    let max_s: Int = min_len - p;
    let s: Int = if suffix_n < max_s { suffix_n } else { max_s };
    let mid1: Int = n1 - s;
    let mid2: Int = n2 - s;
    let del_n: Int = if mid1 > p { mid1 - p } else { 0 };
    let ins_n: Int = if mid2 > p { mid2 - p } else { 0 };
    return DiffScript {
        prefix_n: p,
        del_n: del_n,
        ins_n: ins_n,
        suffix_n: s
    };
}

pub fn diff_levenshtein(n1: Int, n2: Int, prefix_n: Int) -> Int {
    if n1 == 0 {
        return n2;
    }
    if n2 == 0 {
        return n1;
    }
    let p: Int = diff_clamp_prefix(n1, n2, prefix_n);
    let rem1: Int = n1 - p;
    let rem2: Int = n2 - p;
    if rem1 > rem2 {
        return rem1;
    }
    return rem2;
}
