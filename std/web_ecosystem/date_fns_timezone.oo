// # Date-fns timezone offset (Int destub floor)
//
// Logline: Signed minute offsets; UTC convert is add/sub. Off pub type / String / &T.
//
// Setup: Hours = abs(offset)/60; minute part = abs%60. tz_id 0 is UTC.
//
// Beats:
//   1. UTC offset is 0; sign is -1/0/+1.
//   2. convert_utc_to_tz adds offset minutes.
//   3. convert_tz_to_utc subtracts offset minutes.

type TimeZone = struct {
    tz_id: Int,
    offset_minutes: Int
};

pub fn timezone_new(tz_id: Int, offset_minutes: Int) -> TimeZone {
    return TimeZone {
        tz_id: tz_id,
        offset_minutes: offset_minutes
    };
}

pub fn timezone_utc() -> TimeZone {
    return TimeZone {
        tz_id: 0,
        offset_minutes: 0
    };
}

pub fn timezone_abs_minutes(offset_min: Int) -> Int {
    if offset_min >= 0 {
        return offset_min;
    }
    return 0 - offset_min;
}

pub fn timezone_offset_hours(offset_min: Int) -> Int {
    let abs_min: Int = timezone_abs_minutes(offset_min);
    return abs_min / 60;
}

pub fn timezone_offset_minute_part(offset_min: Int) -> Int {
    let abs_min: Int = timezone_abs_minutes(offset_min);
    return abs_min % 60;
}

pub fn timezone_sign(offset_min: Int) -> Int {
    if offset_min > 0 {
        return 1;
    }
    if offset_min < 0 {
        return 0 - 1;
    }
    return 0;
}

pub fn convert_utc_to_tz(utc_minutes: Int, offset_min: Int) -> Int {
    return utc_minutes + offset_min;
}

pub fn convert_tz_to_utc(tz_minutes: Int, offset_min: Int) -> Int {
    return tz_minutes - offset_min;
}
