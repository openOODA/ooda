// # Date-fns Difference and Comparison Engine
//
// Logline: Calculates granular elapsed durations and relational time orderings between DateTime instances.
//
// Setup: Pure comparison and duration calculation engine importing date_fns_format.oo and date_fns_parse.oo.
//
// Beats:
//   1. Compute precise difference intervals across millisecond, second, minute, hour, and day units.
//   2. Evaluate chronological orderings (is_before, is_after, is_equal_date).
//   3. Handle invalid date cases gracefully with deterministic zero intervals.

import "./date_fns_format.oo";
import "./date_fns_parse.oo";

pub fn difference_in_milliseconds(d_left: &DateTime, d_right: &DateTime) -> Int {
    if !(d_left).is_valid || !(d_right).is_valid {
        return 0;
    }
    let ms_l: Int = date_to_timestamp_ms(d_left);
    let ms_r: Int = date_to_timestamp_ms(d_right);
    return ms_l - ms_r;
}

pub fn difference_in_seconds(d_left: &DateTime, d_right: &DateTime) -> Int {
    return difference_in_milliseconds(d_left, d_right) / 1000;
}

pub fn difference_in_minutes(d_left: &DateTime, d_right: &DateTime) -> Int {
    return difference_in_milliseconds(d_left, d_right) / 60000;
}

pub fn difference_in_hours(d_left: &DateTime, d_right: &DateTime) -> Int {
    return difference_in_milliseconds(d_left, d_right) / 3600000;
}

pub fn difference_in_days(d_left: &DateTime, d_right: &DateTime) -> Int {
    return difference_in_milliseconds(d_left, d_right) / 86400000;
}

pub fn is_before(d_left: &DateTime, d_right: &DateTime) -> Bool {
    return difference_in_milliseconds(d_left, d_right) < 0;
}

pub fn is_after(d_left: &DateTime, d_right: &DateTime) -> Bool {
    return difference_in_milliseconds(d_left, d_right) > 0;
}

pub fn is_equal_date(d_left: &DateTime, d_right: &DateTime) -> Bool {
    return difference_in_milliseconds(d_left, d_right) == 0;
}
