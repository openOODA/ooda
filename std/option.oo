// # Optional string helpers
//
// Logline: Optional strings ride Result[String, String]: Ok is Some and empty Err is None.
//
// Setup: Backend-C lowers Result[String, String] only; callers import these helpers instead of Option constructors.
//
// Beats:
//   1. Some(v) is Ok(v); None is Err("").
//   2. Tests read is_ok as Some and is_err as None.
//   3. Unwrap yields the Some string or the given default.
//
// residual: Option[T] is NOT a real sum type; Ok = Some(v), Err("") = None.

// Some(v) as Ok(v).
pub fn opt_some(v: String) -> Result[String, String] {
    return Ok(v);
}

// None as Err("").
pub fn opt_none() -> Result[String, String] {
    return Err("");
}

// True when Some.
pub fn opt_is_some(o: Result[String, String]) -> Bool {
    return o.is_ok();
}

// True when None.
pub fn opt_is_none(o: Result[String, String]) -> Bool {
    return o.is_err();
}

// Some payload or default.
pub fn opt_unwrap_or(o: Result[String, String], d: String) -> String {
    if o.is_ok() {
        let v = match o {
            Ok(x) => x,
            Err(y) => y,
        };
        return v;
    }
    return d;
}

// Monadic map: apply transform if Some, maintain None.
pub fn opt_map(o: Result[String, String], suffix: String) -> Result[String, String] {
    if o.is_err() {
        return o;
    }
    let v: String = opt_unwrap_or(o, "");
    return Ok(v + suffix);
}

// Monadic and_then: chain dependent operation if Some, maintain None.
pub fn opt_and_then(o: Result[String, String], next_val: String) -> Result[String, String] {
    if o.is_err() {
        return o;
    }
    return Ok(next_val);
}

