// package: std — optional string helpers (pure path)
// job: Some/None-shaped API over Result[String,String] (OoResS)
// caps: none
// residual: Option[T] sum emit is NOT pure-lowered; use these helpers instead.
//   Ok = Some(v), Err("") = None. Match with res_*/opt_* + annotations.

// Some(v) as Ok(v).
pub fn opt_some(v: String) -> Result[String, String] {
    return Ok(v);
}

// None as Err("").
pub fn opt_none() -> Result[String, String] {
    return Err("");
}

// True when Some.
pub fn opt_is_some(o: Result[String, String]) -> Bool {
    return o.is_ok();
}

// True when None.
pub fn opt_is_none(o: Result[String, String]) -> Bool {
    return o.is_err();
}

// Some payload or default.
pub fn opt_unwrap_or(o: Result[String, String], d: String) -> String {
    if o.is_ok() {
        let v = match o {
            Ok(x) => x,
            Err(y) => y,
        };
        return v;
    }
    return d;
}
