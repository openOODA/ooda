// # Edelbaum Low-Thrust Combined Altitude & Inclination Transfer
//
// Logline: Calculates Edelbaum low-thrust quasi-circular orbital transfer, continuous thrust combined plane change, spiral duration, and propellant mass.
//
// Setup: Solves analytical optimal thrust yaw steering angle for simultaneous orbit altitude raising and orbital plane change.
//
// Beats:
//   1. Define initial and final circular orbit velocities (v1, v2) and total plane change angle (Delta_i).
//   2. Compute Edelbaum total velocity increment (Delta_V) and optimal constant yaw steering angle (beta).
//   3. Calculate low-thrust spiral duration, continuous electric propulsion burn time, and propellant consumption.

import "./space_propulsion_constants.oo";

pub type EdelbaumTransferSpec = struct {
    r_initial_m: Float, // e.g. LEO r = 6778 km
    r_final_m: Float, // e.g. GEO r = 42164 km
    plane_change_deg: Float, // e.g. 28.5 deg (Cape Canaveral to GSO)
    spacecraft_mass_initial_kg: Float,
    thruster_thrust_n: Float, // e.g. 2.5 N (Hall thruster string)
    thruster_isp_s: Float, // e.g. 2200 s
    mu: Float,
};

pub type EdelbaumTransferResult = struct {
    initial_velocity_m_s: Float,
    final_velocity_m_s: Float,
    edelbaum_delta_v_m_s: Float,
    optimal_yaw_angle_deg: Float,
    transfer_duration_days: Float,
    propellant_consumed_kg: Float,
    final_spacecraft_mass_kg: Float,
};

pub fn edelbaum_spec_default_leo_to_geo() -> EdelbaumTransferSpec {
    return EdelbaumTransferSpec {
        r_initial_m: const_radius_earth() + 400000.0, // 400 km LEO
        r_final_m: 42164000.0, // GEO
        plane_change_deg: 28.5,
        spacecraft_mass_initial_kg: 2500.0,
        thruster_thrust_n: 2.5,
        thruster_isp_s: 2100.0,
        mu: const_mu_earth(),
    };
}

pub fn edelbaum_compute_transfer(spec: EdelbaumTransferSpec) -> EdelbaumTransferResult {
    let r1: Float = (spec).r_initial_m;
    let r2: Float = (spec).r_final_m;
    let di_deg: Float = (spec).plane_change_deg;
    let di_rad: Float = di_deg * const_deg_to_rad();
    let m0: Float = (spec).spacecraft_mass_initial_kg;
    let thrust: Float = (spec).thruster_thrust_n;
    let isp: Float = (spec).thruster_isp_s;
    let mu: Float = (spec).mu;

    // Circular velocities: v1 = sqrt(mu/r1), v2 = sqrt(mu/r2)
    let v1: Float = sqrt(mu / r1);
    let v2: Float = sqrt(mu / r2);

    // Edelbaum analytical combined delta-V formula:
    // Delta_V = sqrt( v1^2 - 2*v1*v2*cos(pi/2 * Delta_i) + v2^2 )
    let angle_term: Float = (const_pi() / 2.0) * di_rad;
    let dv_sq: Float = (v1 * v1) - (2.0 * v1 * v2 * cos(angle_term)) + (v2 * v2);
    let dv_edelbaum: Float = sqrt(dv_sq);

    // Optimal constant out-of-plane steering angle: tan(beta) = sin(pi/2 * Delta_i) / (v1/v2 - cos(pi/2 * Delta_i))
    let num_beta: Float = sin(angle_term);
    let den_beta: Float = (v1 / v2) - cos(angle_term);
    let beta_rad: Float = math_atan2(num_beta, den_beta);
    let beta_deg: Float = beta_rad * const_rad_to_deg();

    // Mass consumed: m_prop = m0 * (1 - exp(-Delta_V / c))
    let c_eff: Float = isp * const_g0();
    let mass_ratio: Float = math_exp(0.0 - (dv_edelbaum / c_eff));
    let m_final: Float = m0 * mass_ratio;
    let m_prop: Float = m0 - m_final;

    // Transfer time: t_burn = (m_prop * c) / Thrust = (m0 * c * (1 - exp(-Delta_V/c))) / T
    let t_burn_s: Float = (m_prop * c_eff) / thrust;
    let t_burn_days: Float = t_burn_s / 86400.0;

    return EdelbaumTransferResult {
        initial_velocity_m_s: v1,
        final_velocity_m_s: v2,
        edelbaum_delta_v_m_s: dv_edelbaum,
        optimal_yaw_angle_deg: beta_deg,
        transfer_duration_days: t_burn_days,
        propellant_consumed_kg: m_prop,
        final_spacecraft_mass_kg: m_final,
    };
}
