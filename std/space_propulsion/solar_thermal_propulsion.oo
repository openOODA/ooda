// # Solar Thermal Propulsion (STP) Cavity Absorber & Hydrogen Thrust
//
// Logline: Calculates solar concentrator collector optics, high-temperature cavity absorber heat exchanger, hydrogen propellant flow, and moderate Isp.
//
// Setup: Analyzes parabolic inflatable/rigid concentrators focusing solar flux onto rhenium/graphite blackbody heat exchanger cavities.
//
// Beats:
//   1. Define concentrator aperture area, optical reflectance, and concentration ratio.
//   2. Compute cavity absorber equilibrium temperature, reradiation losses, and hydrogen heating.
//   3. Calculate supersonic nozzle exhaust velocity, specific impulse (800s - 950s), and thrust.

import "./space_propulsion_constants.oo";

pub type SolarThermalSpec = struct {
    concentrator_area_m2: Float, // e.g. 50 m2
    optical_reflectance: Float, // e.g. 0.92
    concentration_ratio: Float, // e.g. 3000:1
    cavity_emissivity: Float, // e.g. 0.85
    hydrogen_mass_flow_g_s: Float, // e.g. 1.2 g/s
    nozzle_expansion_ratio: Float
};

pub type SolarThermalPerformance = struct {
    concentrated_solar_power_kw: Float,
    cavity_temp_k: Float,
    reradiation_loss_kw: Float,
    net_gas_power_kw: Float,
    thrust_n: Float,
    specific_impulse_s: Float
};

pub fn solar_thermal_spec_default() -> SolarThermalSpec {
    return SolarThermalSpec {
        concentrator_area_m2: 45.0,
        optical_reflectance: 0.91,
        concentration_ratio: 2800.0,
        cavity_emissivity: 0.88,
        hydrogen_mass_flow_g_s: 1.5,
        nozzle_expansion_ratio: 80.0
    };
}

pub fn solar_thermal_compute_performance(
    spec: SolarThermalSpec,
    sun_dist_au: Float
) -> SolarThermalPerformance {
    let a_conc: Float = (spec).concentrator_area_m2;
    let rho_opt: Float = (spec).optical_reflectance;
    let c_ratio: Float = (spec).concentration_ratio;
    let eps_cav: Float = (spec).cavity_emissivity;
    let m_dot_g: Float = (spec).hydrogen_mass_flow_g_s;
    let m_dot_kg_s: Float = m_dot_g * 0.001;

    // Solar flux at distance: S = S0 / d^2
    let s_flux: Float = const_solar_flux_1au() / (sun_dist_au * sun_dist_au);
    let p_solar_in_w: Float = s_flux * a_conc * rho_opt;
    let p_solar_in_kw: Float = p_solar_in_w / 1000.0;

    // Cavity aperture area: A_ap = A_conc / C_ratio
    let a_aperture: Float = a_conc / c_ratio;

    // Cavity equilibrium temperature estimate (iterative radiation + gas enthalpy balance)
    // P_in = P_rerad + P_gas = A_ap * eps * sigma * T^4 + m_dot * Cp * (T - T_in)
    let cp_h2: Float = 14800.0; // J/(kg*K)
    let t_in_k: Float = 40.0;
    let sigma: Float = 0.00000005670374419;

    let mut t_cav: Float = 2400.0; // nominal operating point
    let t4: Float = t_cav * t_cav * t_cav * t_cav;
    let p_rerad_w: Float = a_aperture * eps_cav * sigma * t4;
    let mut p_gas_w: Float = p_solar_in_w - p_rerad_w;
    if p_gas_w < 1000.0 { p_gas_w = 1000.0; }

    let dt_gas: Float = p_gas_w / (m_dot_kg_s * cp_h2 + 0.00001);
    t_cav = t_in_k + dt_gas;
    if t_cav > 2700.0 { t_cav = 2700.0; } // refractory metal/carbide cavity limit

    // Exhaust velocity from hydrogen enthalpy: v_ex = sqrt(2 * gamma / (gamma - 1) * R * T_cav)
    let gamma: Float = 1.38;
    let mw: Float = 2.016;
    let rs: Float = const_r_univ() / mw;
    let g1: Float = gamma - 1.0;
    let v_ex: Float = sqrt(((2.0 * gamma) / g1) * rs * t_cav * 0.95);

    let thrust_n: Float = m_dot_kg_s * v_ex;
    let isp: Float = v_ex / const_g0();

    return SolarThermalPerformance {
        concentrated_solar_power_kw: p_solar_in_kw,
        cavity_temp_k: t_cav,
        reradiation_loss_kw: p_rerad_w / 1000.0,
        net_gas_power_kw: p_gas_w / 1000.0,
        thrust_n: thrust_n,
        specific_impulse_s: isp
    };
}
