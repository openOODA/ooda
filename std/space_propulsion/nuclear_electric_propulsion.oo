// # Nuclear Electric Propulsion (NEP) Closed Brayton Power & Thrust
//
// Logline: Evaluates space nuclear reactor Brayton power conversion, radiator heat rejection area, shadow shield mass, and low-thrust NEP scaling.
//
// Setup: Analyzes megawatt-class space nuclear fission reactor coupled with high-efficiency Closed Brayton Cycle (CBC) and ion/MPD electric thrusters.
//
// Beats:
//   1. Define reactor thermal power, Brayton turbine inlet temperature, and compressor pressure ratio.
//   2. Compute thermodynamic conversion efficiency, net electrical power, and heat rejection radiator area.
//   3. Calculate specific alpha mass (kg/kWe), electric thruster continuous thrust, and deep space payload fraction.

import "./space_propulsion_constants.oo";

pub type NepSystemSpec = struct {
    reactor_thermal_power_kw: Float, // e.g. 5000 kWth (5 MWth)
    turbine_inlet_temp_k: Float, // e.g. 1350 K
    radiator_temp_k: Float, // e.g. 450 K
    brayton_efficiency: Float, // e.g. 0.32
    thruster_isp_s: Float, // e.g. 5000 s
    thruster_efficiency: Float, // e.g. 0.70
};

pub type NepPerformance = struct {
    electrical_power_kwe: Float,
    heat_rejected_kwth: Float,
    radiator_area_m2: Float,
    total_thrust_n: Float,
    mass_flow_g_s: Float,
    specific_mass_kg_per_kwe: Float,
};

pub fn nep_system_spec_default_1mwe() -> NepSystemSpec {
    return NepSystemSpec {
        reactor_thermal_power_kw: 3200.0,
        turbine_inlet_temp_k: 1300.0,
        radiator_temp_k: 460.0,
        brayton_efficiency: 0.3125, // 1000 kWe net output
        thruster_isp_s: 4500.0,
        thruster_efficiency: 0.68,
    };
}

pub fn nep_compute_performance(spec: NepSystemSpec) -> NepPerformance {
    let p_th: Float = (spec).reactor_thermal_power_kw;
    let eta_b: Float = (spec).brayton_efficiency;
    let t_rad: Float = (spec).radiator_temp_k;
    let isp: Float = (spec).thruster_isp_s;
    let eta_t: Float = (spec).thruster_efficiency;

    // Electrical power generated
    let p_elec_kwe: Float = p_th * eta_b;
    let p_elec_w: Float = p_elec_kwe * 1000.0;

    // Waste heat rejected
    let q_waste_kw: Float = p_th - p_elec_kwe;
    let q_waste_w: Float = q_waste_kw * 1000.0;

    // Radiator area: Q = epsilon * sigma * A * T^4 (epsilon ~ 0.88, 2-sided radiation)
    let eps_rad: Float = 0.88;
    let sigma: Float = 0.00000005670374419; // Stefan-Boltzmann
    let t4: Float = t_rad * t_rad * t_rad * t_rad;
    let q_per_m2: Float = 2.0 * eps_rad * sigma * t4; // 2-sided flat panel
    let a_rad: Float = q_waste_w / (q_per_m2 + 0.0001);

    // Thruster beam jet power: P_jet = eta_t * P_elec = 0.5 * m_dot * v_ex^2 = 0.5 * F * v_ex
    let v_ex: Float = isp * const_g0();
    let p_jet_w: Float = p_elec_w * eta_t;
    let thrust_n: Float = (2.0 * p_jet_w) / v_ex;
    let m_dot_kg_s: Float = thrust_n / v_ex;
    let m_dot_g_s: Float = m_dot_kg_s * 1000.0;

    // Specific mass alpha (typical 15 to 30 kg/kWe for 1 MWe systems)
    let alpha_spec: Float = 22.0 + (1000.0 / (p_elec_kwe + 10.0));

    return NepPerformance {
        electrical_power_kwe: p_elec_kwe,
        heat_rejected_kwth: q_waste_kw,
        radiator_area_m2: a_rad,
        total_thrust_n: thrust_n,
        mass_flow_g_s: m_dot_g_s,
        specific_mass_kg_per_kwe: alpha_spec,
    };
}
