// # Magnetoplasmadynamic (MPD) Thruster Self-Field Lorentz Acceleration
//
// Logline: Calculates self-field and applied-field MPD thruster Lorentz body force acceleration, Maecker equation, and Alfvén critical velocity.
//
// Setup: Solves high-power (hundreds of kW to MW) plasma electromagnetic acceleration in coaxial thruster geometries.
//
// Beats:
//   1. Define coaxial cathode/anode radii, arc discharge current, and propellant mass flow.
//   2. Compute Maecker self-field electromagnetic thrust and applied-field Hall/swirl boost.
//   3. Evaluate Alfvén critical ionization velocity (CIV), onset current limit, and thrust efficiency.

import "./space_propulsion_constants.oo";

pub type MpdThrusterSpec = struct {
    anode_radius_m: Float,
    cathode_radius_m: Float,
    discharge_current_ka: Float, // e.g. 10 kA to 50 kA
    mass_flow_g_s: Float, // e.g. 5.0 g/s Argon / Hydrogen
    applied_b_field_tesla: Float, // 0.0 for self-field, >0 for applied-field
    propellant_civ_m_s: Float // critical ionization velocity (e.g. 8700 m/s for Argon, 51000 for H2)
};

pub type MpdPerformance = struct {
    thrust_self_field_n: Float,
    thrust_applied_field_n: Float,
    thrust_total_n: Float,
    exhaust_velocity_m_s: Float,
    specific_impulse_s: Float,
    onset_current_limit_ka: Float
};

pub fn mpd_thruster_spec_default_argon() -> MpdThrusterSpec {
    return MpdThrusterSpec {
        anode_radius_m: 0.05, // 5 cm
        cathode_radius_m: 0.01, // 1 cm
        discharge_current_ka: 20.0,
        mass_flow_g_s: 3.5,
        applied_b_field_tesla: 0.15,
        propellant_civ_m_s: 8700.0
    };
}

pub fn mpd_compute_performance(spec: MpdThrusterSpec) -> MpdPerformance {
    let ra: Float = (spec).anode_radius_m;
    let rc: Float = (spec).cathode_radius_m;
    let i_ka: Float = (spec).discharge_current_ka;
    let i_amps: Float = i_ka * 1000.0;
    let m_dot_kg_s: Float = (spec).mass_flow_g_s * 0.001;
    let b_app: Float = (spec).applied_b_field_tesla;

    let mu_0: Float = 0.0000012566370614359173; // N/A^2

    // Maecker self-field electromagnetic thrust equation:
    // F_self = (mu_0 * J^2 / 4*pi) * [ln(r_a / r_c) + 3/4]
    let geom_factor: Float = math_ln(ra / rc) + 0.75;
    let f_self: Float = ((mu_0 * (i_amps * i_amps)) / (4.0 * const_pi())) * geom_factor;

    // Applied-field Hall azimuthal current Lorentz thrust approx:
    // F_applied ~ (1/3) * J * B_z * r_a * L_arc
    let l_arc: Float = 0.04;
    let f_app: Float = 0.333 * i_amps * b_app * ra;

    let f_total: Float = f_self + f_app;

    // Effective exhaust velocity: c_eff = F / m_dot
    let c_eff: Float = f_total / (m_dot_kg_s + 0.00001);
    let isp: Float = c_eff / const_g0();

    // Onset current limit (J^2 / m_dot parameter reaching critical ionization)
    // J_onset = sqrt( (4*pi * m_dot * CIV) / (mu_0 * geom_factor) )
    let civ: Float = (spec).propellant_civ_m_s;
    let j_onset_sq: Float = (4.0 * const_pi() * m_dot_kg_s * civ) / (mu_0 * geom_factor);
    let j_onset_ka: Float = sqrt(j_onset_sq) / 1000.0;

    return MpdPerformance {
        thrust_self_field_n: f_self,
        thrust_applied_field_n: f_app,
        thrust_total_n: f_total,
        exhaust_velocity_m_s: c_eff,
        specific_impulse_s: isp,
        onset_current_limit_ka: j_onset_ka
    };
}
