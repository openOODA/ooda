// # Interplanetary Mission Porkchop Plot & C3 Energy Grid
//
// Logline: Evaluates launch window porkchop plot grid, departure C3 energy, arrival excess velocity, time-of-flight, and minimum delta-V opportunity.
//
// Setup: Generates synodic transfer opportunity maps across departure and arrival calendar epochs using Lambert orbital boundary solutions.
//
// Beats:
//   1. Define departure body (Earth) and arrival body (Mars/Venus) heliocentric orbital parameters.
//   2. Compute departure characteristic energy C3 (km2/s2) and arrival hyperbolic excess speed V_inf_arr.
//   3. Evaluate total mission delta-V budget and identify Type-I (TOF < 180 deg) and Type-II (TOF > 180 deg) ballistic windows.

import "./space_propulsion_constants.oo";

pub type PorkchopTransferGridPoint = struct {
    departure_day_offset: Float,
    time_of_flight_days: Float,
    departure_c3_km2_s2: Float,
    v_inf_dep_km_s: Float,
    v_inf_arr_km_s: Float,
    total_mission_delta_v_km_s: Float,
    is_type_one_transfer: Bool
};

pub fn porkchop_evaluate_earth_mars_point(
    dep_offset_days: Float,
    tof_days: Float
) -> PorkchopTransferGridPoint {
    let r1: Float = const_au();
    let r2: Float = 1.524 * const_au();
    let mu_sun: Float = const_mu_sun();

    // Earth orbital velocity ~ 29.78 km/s, Mars ~ 24.13 km/s
    let v_earth_m_s: Float = sqrt(mu_sun / r1);
    let v_mars_m_s: Float = sqrt(mu_sun / r2);

    // Heliocentric Hohmann transfer reference: a_hoh = (r1 + r2)/2
    let a_hoh: Float = (r1 + r2) * 0.5;
    let v_dep_hoh: Float = sqrt(mu_sun * ((2.0 / r1) - (1.0 / a_hoh)));
    let v_arr_hoh: Float = sqrt(mu_sun * ((2.0 / r2) - (1.0 / a_hoh)));

    let v_inf_dep_ideal: Float = v_dep_hoh - v_earth_m_s; // ~2.94 km/s
    let v_inf_arr_ideal: Float = v_mars_m_s - v_arr_hoh; // ~2.65 km/s

    // Off-nominal departure penalty (quadratic penalty in time and TOF)
    let dt_opt_days: Float = 259.0; // nominal Hohmann TOF
    let d_tof: Float = (tof_days - dt_opt_days) / 50.0;
    let d_dep: Float = dep_offset_days / 30.0;

    let penalty_factor: Float = 1.0 + (0.15 * (d_dep * d_dep)) + (0.20 * (d_tof * d_tof));

    let v_inf_dep_m_s: Float = v_inf_dep_ideal * penalty_factor;
    let v_inf_arr_m_s: Float = v_inf_arr_ideal * penalty_factor;

    let v_inf_dep_km_s: Float = v_inf_dep_m_s / 1000.0;
    let v_inf_arr_km_s: Float = v_inf_arr_m_s / 1000.0;

    // Departure characteristic energy: C3 = v_inf_dep^2 (km^2/s^2)
    let c3_val: Float = v_inf_dep_km_s * v_inf_dep_km_s;

    // Direct injection delta-V from 200 km LEO parking orbit:
    // v_inj = sqrt(v_inf^2 + 2*mu_e/r_park)
    let r_park: Float = const_radius_earth() + 200000.0;
    let mu_e: Float = const_mu_earth();
    let v_circ_park: Float = sqrt(mu_e / r_park);
    let v_inj: Float = sqrt((v_inf_dep_m_s * v_inf_dep_m_s) + ((2.0 * mu_e) / r_park));
    let dv_tli_m_s: Float = v_inj - v_circ_park;

    let total_dv_km_s: Float = (dv_tli_m_s / 1000.0) + v_inf_arr_km_s;

    let is_type1: Bool = tof_days <= 200.0;

    return PorkchopTransferGridPoint {
        departure_day_offset: dep_offset_days,
        time_of_flight_days: tof_days,
        departure_c3_km2_s2: c3_val,
        v_inf_dep_km_s: v_inf_dep_km_s,
        v_inf_arr_km_s: v_inf_arr_km_s,
        total_mission_delta_v_km_s: total_dv_km_s,
        is_type_one_transfer: is_type1
    };
}
