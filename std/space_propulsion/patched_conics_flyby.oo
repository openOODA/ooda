// # Planetary Patched Conics Flyby & Gravity Assist Dynamics
//
// Logline: Calculates planetary gravity assist flybys, hyperbolic turning angle, asymptotic excess velocities, and heliocentric energy gain.
//
// Setup: Solves planetocentric hyperbolic passage, periapsis altitude targeting, and heliocentric velocity vector rotation.
//
// Beats:
//   1. Define planet gravitational parameter (mu), planet heliocentric velocity vector, and incoming v_infinity.
//   2. Compute hyperbolic excess speed, periapsis radius, eccentricity, and bend angle (delta).
//   3. Calculate outgoing asymptotic velocity, net heliocentric delta-V gain, and C3 energy boost.

import "./space_propulsion_constants.oo";

pub type FlybyPlanetarySpec = struct {
    planet_mu: Float,
    planet_radius_m: Float,
    planet_velocity_vec: Vector3D,
    periapsis_altitude_m: Float,
};

pub type FlybyResult = struct {
    v_infinity_in_m_s: Float,
    hyperbolic_eccentricity: Float,
    turning_angle_deg: Float,
    heliocentric_delta_v_m_s: Float,
    v_infinity_out_vec: Vector3D,
    periapsis_velocity_m_s: Float,
};

pub fn flyby_spec_default_venus() -> FlybyPlanetarySpec {
    return FlybyPlanetarySpec {
        planet_mu: const_mu_venus(),
        planet_radius_m: const_radius_venus(),
        planet_velocity_vec: vec3_new(0.0, 35020.0, 0.0), // Venus orbital speed ~35 km/s
        periapsis_altitude_m: 350000.0, // 350 km flyby altitude
    };
}

pub fn flyby_compute_gravity_assist(
    spec: FlybyPlanetarySpec,
    v_inf_in_vec: Vector3D
) -> FlybyResult {
    let mu_p: Float = (spec).planet_mu;
    let r_p: Float = (spec).planet_radius_m + (spec).periapsis_altitude_m;
    let v_pl: Vector3D = (spec).planet_velocity_vec;

    let v_inf: Float = vec3_norm(v_inf_in_vec);

    // Hyperbolic eccentricity: e = 1 + (r_p * v_inf^2 / mu)
    let e_hyp: Float = 1.0 + ((r_p * (v_inf * v_inf)) / mu_p);

    // Hyperbolic turning angle: delta = 2 * asin(1 / e)
    let delta_rad: Float = 2.0 * math_asin(1.0 / e_hyp);
    let delta_deg: Float = delta_rad * const_rad_to_deg();

    // Periapsis speed: v_peri = sqrt(v_inf^2 + 2*mu/r_p)
    let v_peri: Float = sqrt((v_inf * v_inf) + ((2.0 * mu_p) / r_p));

    // Heliocentric delta-V gained by gravity assist: |Delta_V_helio| = 2 * v_inf * sin(delta / 2)
    let dv_mag: Float = 2.0 * v_inf * sin(delta_rad * 0.5);

    // Rotate incoming v_inf vector by delta angle in encounter plane
    let u_in: Vector3D = vec3_normalize(v_inf_in_vec);
    let cos_d: Float = cos(delta_rad);
    let sin_d: Float = sin(delta_rad);

    // Transverse unit vector in orbital plane
    let u_perp: Vector3D = vec3_new(0.0 - (u_in).y, (u_in).x, 0.0);
    let v_out_dir: Vector3D = vec3_add(vec3_scale(u_in, cos_d), vec3_scale(u_perp, sin_d));
    let v_inf_out: Vector3D = vec3_scale(v_out_dir, v_inf);

    return FlybyResult {
        v_infinity_in_m_s: v_inf,
        hyperbolic_eccentricity: e_hyp,
        turning_angle_deg: delta_deg,
        heliocentric_delta_v_m_s: dv_mag,
        v_infinity_out_vec: v_inf_out,
        periapsis_velocity_m_s: v_peri,
    };
}
