// # Resistojet Electrothermal Propellant Heating Dynamics
//
// Logline: Calculates resistojet electrothermal heating, high-temperature heat exchanger efficiency, frozen flow loss, and augmented Isp.
//
// Setup: Analyzes electric resistance wire heating (tungsten/rhenium) of gaseous propellants (N2, NH3, H2, Water).
//
// Beats:
//   1. Define heater element electrical power, gas mass flow, and thermodynamic heat exchanger geometry.
//   2. Compute stagnation temperature rise, convective heat transfer coefficient, and heater surface temperature.
//   3. Calculate thermal expansion nozzle exhaust velocity, thrust, and electric power efficiency.

import "./space_propulsion_constants.oo";

pub type ResistojetSpec = struct {
    propellant_type: Int, // 1: Nitrogen, 2: Ammonia (NH3), 3: Water vapor (H2O), 4: Hydrogen
    electrical_power_w: Float, // e.g. 500 W to 1500 W
    mass_flow_g_s: Float, // e.g. 0.3 g/s
    heater_efficiency: Float, // e.g. 0.85
    expansion_ratio: Float,
};

pub type ResistojetPerformance = struct {
    stagnation_temp_k: Float,
    exhaust_velocity_m_s: Float,
    thrust_mn: Float,
    specific_impulse_s: Float,
    frozen_flow_efficiency: Float,
};

pub fn resistojet_spec_default_ammonia() -> ResistojetSpec {
    return ResistojetSpec {
        propellant_type: 2, // Ammonia
        electrical_power_w: 750.0,
        mass_flow_g_s: 0.25,
        heater_efficiency: 0.82,
        expansion_ratio: 30.0,
    };
}

pub fn resistojet_compute_performance(spec: ResistojetSpec) -> ResistojetPerformance {
    let p_type: Int = (spec).propellant_type;
    let p_elec: Float = (spec).electrical_power_w;
    let m_dot_g: Float = (spec).mass_flow_g_s;
    let m_dot_kg_s: Float = m_dot_g * 0.001;
    let eta_h: Float = (spec).heater_efficiency;

    let mut cp: Float = 1040.0;
    let mut mw: Float = 28.0;
    let mut gamma: Float = 1.40;
    let mut eta_frozen: Float = 0.98;

    if p_type == 1 {
        // N2
        cp = 1040.0;
        mw = 28.0;
        gamma = 1.40;
        eta_frozen = 0.98;
    } else if p_type == 2 {
        // NH3 (dissociates into N2 + 3H2 at high T)
        cp = 2200.0;
        mw = 17.0;
        gamma = 1.33;
        eta_frozen = 0.88; // dissociation loss
    } else if p_type == 3 {
        // H2O (Steam)
        cp = 1900.0;
        mw = 18.0;
        gamma = 1.33;
        eta_frozen = 0.92;
    } else {
        // H2
        cp = 14300.0;
        mw = 2.016;
        gamma = 1.41;
        eta_frozen = 0.95;
    }

    // Heat absorbed: Q_dot = eta_h * P_elec = m_dot * cp * (T_0 - T_in)
    let t_in_k: Float = 300.0;
    let q_dot: Float = eta_h * p_elec;
    let dt: Float = q_dot / (m_dot_kg_s * cp);
    let mut t0: Float = t_in_k + dt;
    if t0 > 2600.0 { t0 = 2600.0; } // Tungsten heater material limit

    // Ideal isentropic expansion exhaust velocity: v_ex = sqrt( 2 * gamma / (gamma - 1) * R * T0 * (1 - (Pe/P0)^((g-1)/g)) )
    let rs: Float = const_r_univ() / mw;
    let g1: Float = gamma - 1.0;
    let pr_term: Float = 1.0 - math_pow(0.01, g1 / gamma); // 100:1 pressure ratio approx
    let v_ideal: Float = sqrt(((2.0 * gamma) / g1) * rs * t0 * pr_term);

    // Apply frozen flow & nozzle friction efficiency
    let v_actual: Float = v_ideal * eta_frozen * 0.96;

    let thrust_n: Float = m_dot_kg_s * v_actual;
    let thrust_mn: Float = thrust_n * 1000.0;
    let isp: Float = v_actual / const_g0();

    return ResistojetPerformance {
        stagnation_temp_k: t0,
        exhaust_velocity_m_s: v_actual,
        thrust_mn: thrust_mn,
        specific_impulse_s: isp,
        frozen_flow_efficiency: eta_frozen,
    };
}
