// # Isentropic Rocket Propulsion & Nozzle Gas Dynamics
//
// Logline: Calculates 1D isentropic compressible nozzle flow, sonic throat conditions, characteristic velocity, and thrust coefficient.
//
// Setup: Implements ideal de Laval convergent-divergent rocket nozzle gas dynamics for variable expansion ratios.
//
// Beats:
//   1. Define rocket combustion chamber state and nozzle geometry parameters.
//   2. Compute sonic throat state, characteristic exhaust velocity (c*), and supersonic exit Mach.
//   3. Calculate thrust coefficient (CF), exit pressure, and vacuum/sea-level specific impulse.

import "./space_propulsion_constants.oo";

pub type RocketChamberState = struct {
    chamber_pressure_pa: Float,
    chamber_temp_k: Float,
    gamma: Float,
    molecular_weight_kg_kmol: Float,
    expansion_ratio: Float,
};

pub type NozzlePerformance = struct {
    c_star_m_s: Float,
    thrust_coeff_cf: Float,
    isp_vacuum_s: Float,
    exit_mach: Float,
    exit_pressure_pa: Float,
    throat_pressure_pa: Float,
};

pub fn rocket_chamber_state_default() -> RocketChamberState {
    return RocketChamberState {
        chamber_pressure_pa: 10000000.0, // 10 MPa (100 bar)
        chamber_temp_k: 3500.0,
        gamma: 1.22,
        molecular_weight_kg_kmol: 16.0,
        expansion_ratio: 40.0,
    };
}

pub fn nozzle_compute_c_star(chamber: RocketChamberState) -> Float {
    let g: Float = (chamber).gamma;
    let rs: Float = const_r_univ() / (chamber).molecular_weight_kg_kmol;
    let tc: Float = (chamber).chamber_temp_k;
    let g_exp: Float = (g + 1.0) / (g - 1.0);
    let term: Float = math_pow(2.0 / (g + 1.0), g_exp);
    let gamma_factor: Float = g * sqrt(term);
    if gamma_factor <= 0.0001 {
        return 1500.0;
    }
    return sqrt(g * rs * tc) / gamma_factor;
}

pub fn nozzle_estimate_exit_mach(area_ratio: Float, gamma: Float) -> Float {
    if area_ratio <= 1.0 {
        return 1.0;
    }
    let g1: Float = gamma - 1.0;
    let p1: Float = (gamma + 1.0) / (2.0 * g1);
    let m_approx: Float = sqrt((2.0 / g1) * (math_pow(area_ratio, 1.0 / p1) - 1.0));
    if m_approx < 1.0 {
        return 1.0;
    }
    return m_approx;
}

pub fn nozzle_compute_performance(chamber: RocketChamberState) -> NozzlePerformance {
    let g: Float = (chamber).gamma;
    let pc: Float = (chamber).chamber_pressure_pa;
    let eps: Float = (chamber).expansion_ratio;
    let c_star: Float = nozzle_compute_c_star(chamber);
    let me: Float = nozzle_estimate_exit_mach(eps, g);

    let g_exp: Float = (g + 1.0) / (2.0 * (g - 1.0));
    let throat_p_ratio: Float = math_pow(2.0 / (g + 1.0), g / (g - 1.0));
    let pt: Float = pc * throat_p_ratio;

    let me_term: Float = 1.0 + (((g - 1.0) / 2.0) * (me * me));
    let pe: Float = pc * math_pow(me_term, 0.0 - (g / (g - 1.0)));

    let cf_p1: Float = (2.0 * (g * g)) / (g - 1.0);
    let cf_p2: Float = math_pow(2.0 / (g + 1.0), (g + 1.0) / (g - 1.0));
    let cf_p3: Float = 1.0 - math_pow(pe / pc, (g - 1.0) / g);
    let cf_momentum: Float = sqrt(cf_p1 * cf_p2 * cf_p3);
    let cf_pressure: Float = (pe / pc) * eps;
    let cf_vac: Float = cf_momentum + cf_pressure;

    let v_e_vac: Float = c_star * cf_vac;
    let isp_vac: Float = v_e_vac / const_g0();

    return NozzlePerformance {
        c_star_m_s: c_star,
        thrust_coeff_cf: cf_vac,
        isp_vacuum_s: isp_vac,
        exit_mach: me,
        exit_pressure_pa: pe,
        throat_pressure_pa: pt,
    };
}
