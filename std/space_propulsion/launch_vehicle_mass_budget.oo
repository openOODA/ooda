// # Launch Vehicle Mass Budget & Structural Fraction Breakdown
//
// Logline: Calculates launch vehicle dry mass breakdown, propellant loads, payload reserve margins, fairing jettison, and structural mass fraction.
//
// Setup: Synthesizes aerospace mass estimation relationships (MERs) for tanks, propulsion, avionics, thermal protection, and separation systems.
//
// Beats:
//   1. Define vehicle diameter, stage propellant capacity, engine cluster count, and payload target.
//   2. Compute component dry masses (tanks, thrust structure, feed lines, TVC actuators, avionics, interstage).
//   3. Calculate stage structural mass fraction, unpressurized fairing mass, and reserve propellant residuals.

import "./space_propulsion_constants.oo";

pub type StageMassInputs = struct {
    propellant_capacity_kg: Float,
    num_engines: Int,
    single_engine_dry_mass_kg: Float,
    tank_diameter_m: Float,
    tank_material_type: Int, // 1: Aluminum-Lithium, 2: Stainless Steel, 3: Carbon Composite
    is_booster_stage: Bool
};

pub type StageMassBreakdown = struct {
    tank_structure_mass_kg: Float,
    propulsion_system_mass_kg: Float,
    thrust_structure_mass_kg: Float,
    avionics_power_mass_kg: Float,
    residual_propellant_kg: Float,
    total_stage_dry_mass_kg: Float,
    stage_structural_fraction: Float
};

pub fn stage_mass_inputs_default_booster() -> StageMassInputs {
    return StageMassInputs {
        propellant_capacity_kg: 3400000.0, // 3400 tons propellant
        num_engines: 33, // Super Heavy booster
        single_engine_dry_mass_kg: 1600.0, // Raptor 2/3
        tank_diameter_m: 9.0,
        tank_material_type: 2, // Stainless steel
        is_booster_stage: true
    };
}

pub fn stage_compute_mass_budget(inputs: StageMassInputs) -> StageMassBreakdown {
    let m_prop: Float = (inputs).propellant_capacity_kg;
    let n_eng: Float = (inputs).num_engines + 0.0;
    let m_eng_single: Float = (inputs).single_engine_dry_mass_kg;
    let mat_type: Int = (inputs).tank_material_type;
    let is_booster: Bool = (inputs).is_booster_stage;

    // Tank structure mass factor: Al-Li ~ 0.015, Steel ~ 0.022, Composite ~ 0.012
    let mut k_tank: Float = 0.016;
    if mat_type == 2 {
        k_tank = 0.024;
    } else if mat_type == 3 {
        k_tank = 0.012;
    }
    let m_tank: Float = m_prop * k_tank;

    // Total engine cluster mass + feedlines (15% of engine dry mass)
    let m_engines_total: Float = n_eng * m_eng_single;
    let m_feedlines: Float = m_engines_total * 0.15;
    let m_propulsion: Float = m_engines_total + m_feedlines;

    // Thrust structure puck & load transfer dome (approx 25% of engine cluster mass)
    let m_thrust_struct: Float = m_engines_total * 0.28;

    // Avionics, batteries, wiring harness, telemetry, flight computers
    let mut m_avionics: Float = 1200.0;
    if is_booster {
        m_avionics = 2500.0; // includes grid fins / aero actuators
    }

    // Residual unburnable propellant + ullage gas hold (approx 1.2% of loaded prop)
    let m_residual: Float = m_prop * 0.012;

    let m_dry_total: Float = m_tank + m_propulsion + m_thrust_struct + m_avionics;
    let struct_frac: Float = m_dry_total / (m_dry_total + m_prop);

    return StageMassBreakdown {
        tank_structure_mass_kg: m_tank,
        propulsion_system_mass_kg: m_propulsion,
        thrust_structure_mass_kg: m_thrust_struct,
        avionics_power_mass_kg: m_avionics,
        residual_propellant_kg: m_residual,
        total_stage_dry_mass_kg: m_dry_total,
        stage_structural_fraction: struct_frac
    };
}
