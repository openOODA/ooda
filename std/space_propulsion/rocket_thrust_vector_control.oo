// # Rocket Engine Thrust Vector Control (TVC) Dynamics
//
// Logline: Calculates gimbal actuator mechanics, deflection angles, thrust vectoring side-force, and vehicle attitude control moment.
//
// Setup: Models electro-mechanical / hydraulic TVC gimbal actuators for pitch and yaw steering moments during powered ascent.
//
// Beats:
//   1. Define gimbal pivot geometry, actuator stroke limits, and engine thrust magnitude.
//   2. Compute pitch and yaw gimbal deflection angles from actuator linear displacement.
//   3. Calculate lateral steering force, axial thrust loss, and moment generated about vehicle center of mass.

import "./space_propulsion_constants.oo";

pub type TvcGimbalSpec = struct {
    thrust_nominal_n: Float,
    dist_gimbal_to_cg_m: Float, // moment arm L_cg
    actuator_moment_arm_m: Float, // distance from pivot to actuator attach point
    max_gimbal_angle_deg: Float
};

pub type TvcActuationState = struct {
    pitch_angle_rad: Float,
    yaw_angle_rad: Float,
    actuator_pitch_stroke_m: Float,
    actuator_yaw_stroke_m: Float
};

pub type TvcControlMoments = struct {
    thrust_axial_n: Float,
    force_pitch_lateral_n: Float,
    force_yaw_lateral_n: Float,
    moment_pitch_nm: Float,
    moment_yaw_nm: Float,
    cosine_loss_factor: Float
};

pub fn tvc_gimbal_spec_default() -> TvcGimbalSpec {
    return TvcGimbalSpec {
        thrust_nominal_n: 2200000.0, // 2.2 MN (Raptor / BE-4 scale)
        dist_gimbal_to_cg_m: 25.0, // 25 meters behind vehicle CG
        actuator_moment_arm_m: 0.85,
        max_gimbal_angle_deg: 8.0
    };
}

pub fn tvc_compute_actuator_stroke(spec: TvcGimbalSpec, delta_angle_rad: Float) -> Float {
    let r_act: Float = (spec).actuator_moment_arm_m;
    return r_act * delta_angle_rad;
}

pub fn tvc_evaluate_moments(spec: TvcGimbalSpec, state: TvcActuationState) -> TvcControlMoments {
    let t_nom: Float = (spec).thrust_nominal_n;
    let l_cg: Float = (spec).dist_gimbal_to_cg_m;
    let delta_p: Float = (state).pitch_angle_rad;
    let delta_y: Float = (state).yaw_angle_rad;

    let cos_p: Float = cos(delta_p);
    let sin_p: Float = sin(delta_p);
    let cos_y: Float = cos(delta_y);
    let sin_y: Float = sin(delta_y);

    let t_axial: Float = t_nom * cos_p * cos_y;
    let f_lat_pitch: Float = t_nom * sin_p;
    let f_lat_yaw: Float = t_nom * sin_y;

    let m_pitch: Float = f_lat_pitch * l_cg;
    let m_yaw: Float = f_lat_yaw * l_cg;
    let loss: Float = 1.0 - (cos_p * cos_y);

    return TvcControlMoments {
        thrust_axial_n: t_axial,
        force_pitch_lateral_n: f_lat_pitch,
        force_yaw_lateral_n: f_lat_yaw,
        moment_pitch_nm: m_pitch,
        moment_yaw_nm: m_yaw,
        cosine_loss_factor: loss
    };
}
