// # Solar Sail Radiation Pressure & Photon Momentum Thrust
//
// Logline: Calculates solar radiation photon momentum pressure, specular/diffuse reflectivity, sail pitch attitude vector, and characteristic acceleration.
//
// Setup: Analyzes non-ideal reflective membrane optical parameters, distance scaling, and orbital acceleration vector in deep space.
//
// Beats:
//   1. Define sail surface area, total spacecraft mass, optical reflectivity, and heliocentric distance.
//   2. Compute incident, specular reflected, and diffuse re-emitted radiation pressure components.
//   3. Calculate normal and transverse thrust forces, pitch angle steering envelope, and characteristic acceleration (a0).

import "./space_propulsion_constants.oo";

pub type SolarSailSpec = struct {
    sail_area_m2: Float, // e.g. 1000 m2
    spacecraft_total_mass_kg: Float, // e.g. 150 kg
    reflectivity_specular: Float, // rho_s ~ 0.85
    reflectivity_diffuse: Float, // rho_d ~ 0.05
    absorptivity: Float, // alpha ~ 0.10
    front_emissivity: Float, // e_f ~ 0.05
    back_emissivity: Float // e_b ~ 0.55
};

pub type SolarSailForces = struct {
    force_normal_n: Float,
    force_transverse_n: Float,
    force_magnitude_n: Float,
    characteristic_accel_mm_s2: Float, // at 1 AU
    sail_loading_g_m2: Float
};

pub fn solar_sail_spec_default() -> SolarSailSpec {
    return SolarSailSpec {
        sail_area_m2: 1200.0,
        spacecraft_total_mass_kg: 120.0,
        reflectivity_specular: 0.88,
        reflectivity_diffuse: 0.04,
        absorptivity: 0.08,
        front_emissivity: 0.05,
        back_emissivity: 0.55
    };
}

pub fn solar_sail_compute_forces(
    spec: SolarSailSpec,
    sun_dist_au: Float,
    pitch_angle_deg: Float
) -> SolarSailForces {
    let a_sail: Float = (spec).sail_area_m2;
    let m_sc: Float = (spec).spacecraft_total_mass_kg;
    let rho_s: Float = (spec).reflectivity_specular;
    let rho_d: Float = (spec).reflectivity_diffuse;
    let alpha: Float = (spec).absorptivity;
    let ef: Float = (spec).front_emissivity;
    let eb: Float = (spec).back_emissivity;

    // Solar radiation pressure at 1 AU: P0 = W0 / c = 1361 / 299792458 ~ 4.54 uPa
    let p0: Float = const_solar_flux_1au() / const_c();
    let p_local: Float = p0 / (sun_dist_au * sun_dist_au);

    let alpha_rad: Float = pitch_angle_deg * const_deg_to_rad();
    let cos_a: Float = cos(alpha_rad);
    let sin_a: Float = sin(alpha_rad);

    // Non-ideal sail force coefficients (Wright / McInnes model):
    // Force normal = P * A * cos(alpha) * [ (1 + rho_s)*cos(alpha) + B * (1 - rho_s) ]
    let b_factor: Float = (0.5 * (1.0 - rho_s) * (ef - eb)) / (ef + eb + 0.0001);
    let fn_term: Float = ((1.0 + rho_s) * cos_a) + b_factor;
    let f_normal: Float = p_local * a_sail * cos_a * fn_term;

    // Force transverse = P * A * cos(alpha) * (1 - rho_s) * sin(alpha)
    let f_transverse: Float = p_local * a_sail * cos_a * (1.0 - rho_s) * sin_a;

    let f_mag: Float = sqrt((f_normal * f_normal) + (f_transverse * f_transverse));

    // Characteristic acceleration at 1 AU normal incidence (alpha = 0)
    let f0: Float = p0 * a_sail * (1.0 + rho_s + b_factor);
    let a0_m_s2: Float = f0 / m_sc;
    let a0_mm_s2: Float = a0_m_s2 * 1000.0;

    let loading: Float = (m_sc * 1000.0) / a_sail; // g/m^2

    return SolarSailForces {
        force_normal_n: f_normal,
        force_transverse_n: f_transverse,
        force_magnitude_n: f_mag,
        characteristic_accel_mm_s2: a0_mm_s2,
        sail_loading_g_m2: loading
    };
}
