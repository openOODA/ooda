// # Rocket Injector Element Hydraulics & Droplet Atomization
//
// Logline: Calculates injector element orifice hydraulics, discharge coefficients, pressure drop, momentum ratio, and droplet atomization Sauter Mean Diameter (SMD).
//
// Setup: Analyzes coaxial swirl, impinging doublet, and pintle injector elements for liquid rocket combustion heads.
//
// Beats:
//   1. Define injector orifice geometry, propellant densities, and mass flow rates.
//   2. Compute orifice pressure drop, injection velocity, and momentum ratio.
//   3. Estimate Sauter Mean Diameter (SMD) and combustion vaporization distance.

import "./space_propulsion_constants.oo";

pub type InjectorElement = struct {
    element_type: Int, // 1: Coaxial swirl, 2: Impinging doublet, 3: Pintle
    area_ox_m2: Float,
    area_fuel_m2: Float,
    cd_ox: Float,
    cd_fuel: Float,
    rho_ox: Float,
    rho_fuel: Float
};

pub type InjectorHydraulics = struct {
    vel_ox_m_s: Float,
    vel_fuel_m_s: Float,
    dp_ox_bar: Float,
    dp_fuel_bar: Float,
    momentum_ratio: Float,
    smd_droplet_microns: Float
};

pub fn injector_coaxial_swirl_default() -> InjectorElement {
    return InjectorElement {
        element_type: 1,
        area_ox_m2: 0.00003, // 30 mm^2
        area_fuel_m2: 0.00004, // 40 mm^2
        cd_ox: 0.72,
        cd_fuel: 0.68,
        rho_ox: 1140.0, // LOX
        rho_fuel: 422.0 // LCH4
    };
}

pub fn injector_compute_hydraulics(
    elem: InjectorElement,
    m_dot_ox_kg_s: Float,
    m_dot_fuel_kg_s: Float
) -> InjectorHydraulics {
    let a_ox: Float = (elem).area_ox_m2;
    let a_f: Float = (elem).area_fuel_m2;
    let cd_ox: Float = (elem).cd_ox;
    let cd_f: Float = (elem).cd_fuel;
    let rho_ox: Float = (elem).rho_ox;
    let rho_f: Float = (elem).rho_fuel;

    // v = m_dot / (rho * A * Cd)
    let v_ox: Float = m_dot_ox_kg_s / (rho_ox * a_ox * cd_ox);
    let v_f: Float = m_dot_fuel_kg_s / (rho_f * a_f * cd_f);

    // Delta P = (1 / (2 * rho)) * (m_dot / (Cd * A))^2
    let dp_ox_pa: Float = 0.5 * rho_ox * (v_ox * v_ox);
    let dp_f_pa: Float = 0.5 * rho_f * (v_f * v_f);

    // Momentum ratio: (m_dot_ox * v_ox) / (m_dot_f * v_f)
    let mom_ox: Float = m_dot_ox_kg_s * v_ox;
    let mom_f: Float = m_dot_fuel_kg_s * v_f;
    let j_mom: Float = mom_ox / (mom_f + 0.0001);

    // Wolfe-Andersen empirical Sauter Mean Diameter (SMD) approx in microns
    // SMD ~ C * (v_rel)^(-0.6) * (d_orifice)^0.4
    let v_rel: Float = math_abs(v_ox - v_f) + 10.0;
    let d_eq: Float = sqrt((4.0 * a_ox) / const_pi());
    let smd: Float = 120.0 * math_pow(30.0 / v_rel, 0.6) * math_pow(d_eq / 0.003, 0.4);

    return InjectorHydraulics {
        vel_ox_m_s: v_ox,
        vel_fuel_m_s: v_f,
        dp_ox_bar: dp_ox_pa / 100000.0,
        dp_fuel_bar: dp_f_pa / 100000.0,
        momentum_ratio: j_mom,
        smd_droplet_microns: smd
    };
}
