// # Nuclear Thermal Rocket (NTR) Hydrogen Flow & Core Thermodynamics
//
// Logline: Calculates solid-core nuclear thermal rocket (NTR) reactor core heat transfer, hydrogen propellant flow, core reactivity power, and 900s Isp scaling.
//
// Setup: Analyzes NERVA/Timberwind-style graphite/carbide solid-core nuclear fission reactor fuel elements cooled by cryogenic hydrogen.
//
// Beats:
//   1. Define reactor thermal power, fuel element matrix geometry, and hydrogen flow properties.
//   2. Compute axial power peaking factor, core fuel centerline temperature, and hydrogen enthalpy gain.
//   3. Calculate rocket nozzle expansion velocity, 900s vacuum specific impulse, and thrust-to-weight ratio.

import "./space_propulsion_constants.oo";

pub type NtrReactorSpec = struct {
    thermal_power_mw: Float, // e.g. 500 MW to 1500 MW
    core_diameter_m: Float,
    core_length_m: Float,
    max_fuel_temp_k: Float, // e.g. 2700 K to 3000 K (ZrC/UC fuel)
    hydrogen_mass_flow_kg_s: Float, // e.g. 30 kg/s to 50 kg/s
    chamber_pressure_bar: Float,
    expansion_ratio: Float
};

pub type NtrPerformance = struct {
    hydrogen_exit_temp_k: Float,
    c_star_m_s: Float,
    thrust_kn: Float,
    specific_impulse_s: Float,
    core_pressure_drop_bar: Float
};

pub fn ntr_spec_default_nerva() -> NtrReactorSpec {
    return NtrReactorSpec {
        thermal_power_mw: 1100.0, // 1.1 GW thermal
        core_diameter_m: 0.90,
        core_length_m: 1.30,
        max_fuel_temp_k: 2750.0,
        hydrogen_mass_flow_kg_s: 32.5,
        chamber_pressure_bar: 45.0,
        expansion_ratio: 100.0
    };
}

pub fn ntr_compute_performance(spec: NtrReactorSpec) -> NtrPerformance {
    let p_th_mw: Float = (spec).thermal_power_mw;
    let p_th_w: Float = p_th_mw * 1000000.0;
    let m_dot: Float = (spec).hydrogen_mass_flow_kg_s;
    let t_max_fuel: Float = (spec).max_fuel_temp_k;
    let pc_bar: Float = (spec).chamber_pressure_bar;
    let eps: Float = (spec).expansion_ratio;

    // Hydrogen mean specific heat at high temp ~ 15000 J/(kg*K)
    let cp_h2: Float = 15200.0;
    let t_in: Float = 60.0; // Cryogenic LH2 preheated through nozzle jacket

    // Enthalpy balance: P_th = m_dot * cp * (T_out - T_in)
    let dt_h2: Float = p_th_w / (m_dot * cp_h2);
    let mut t_exit: Float = t_in + dt_h2;
    if t_exit > t_max_fuel - 150.0 {
        t_exit = t_max_fuel - 150.0; // thermal limit from fuel cladding
    }

    // Hydrogen molecular weight: MW = 2.016 kg/kmol, gamma = 1.35
    let mw_h2: Float = 2.016;
    let gamma_h2: Float = 1.35;
    let rs: Float = const_r_univ() / mw_h2;

    // c* = sqrt(gamma * R * T_exit) / gamma_factor
    let g_exp: Float = (gamma_h2 + 1.0) / (gamma_h2 - 1.0);
    let term: Float = math_pow(2.0 / (gamma_h2 + 1.0), g_exp);
    let gamma_factor: Float = gamma_h2 * sqrt(term);
    let c_star: Float = sqrt(gamma_h2 * rs * t_exit) / gamma_factor;

    // Vacuum thrust coefficient for eps ~ 100: CF_vac ~ 1.85
    let cf_vac: Float = 1.85;
    let v_e_vac: Float = c_star * cf_vac;
    let thrust_n: Float = m_dot * v_e_vac;
    let thrust_kn: Float = thrust_n / 1000.0;

    let isp_vac: Float = v_e_vac / const_g0();

    // Core hydraulic pressure drop approx
    let dp_core_bar: Float = 5.5 * (m_dot / 30.0);

    return NtrPerformance {
        hydrogen_exit_temp_k: t_exit,
        c_star_m_s: c_star,
        thrust_kn: thrust_kn,
        specific_impulse_s: isp_vac,
        core_pressure_drop_bar: dp_core_bar
    };
}
