// # Space Propulsion Benchmarks, Test Fixtures & Mission Stubs
//
// Logline: Provides standardized validation benchmarks, reference rocket engine models, electric thruster telemetry, and trajectory fixtures.
//
// Setup: Generates calibrated reference states for testing rocket gas dynamics, ion propulsion, staging, Lambert solvers, and aerocapture corridors.
//
// Beats:
//   1. Provide reference SpaceX Raptor 2/3, Saturn V F-1, and RL10-B2 rocket engine configuration fixtures.
//   2. Provide NASA NEXT Gridded Ion and Hall-effect electric propulsion test telemetry stubs.
//   3. Provide Earth-Mars Lambert transfer, Artemis lunar staging, and Mars aerocapture validation benchmarks.

import "./space_propulsion_constants.oo";
import "./rocket_propulsion_isentropic.oo";
import "./rocket_combustion_chamber.oo";
import "./rocket_nozzle_method_characteristics.oo";
import "./rocket_regenerative_cooling.oo";
import "./ion_thruster_gridded_grid.oo";
import "./hall_effect_thruster_discharge.oo";
import "./nuclear_thermal_hydrogen_flow.oo";
import "./staging_tsiolkovsky_multistage.oo";
import "./lambert_universal_variables.oo";
import "./mars_aerocapture_corridor.oo";
import "./chapman_reentry_stagnation_heat.oo";

pub type PropulsionBenchmarkRecord = struct {
    benchmark_id: Int,
    engine_name_code: Int, // 1: Raptor, 2: F-1, 3: RL10, 4: NEXT Ion, 5: NERVA
    thrust_vacuum_kn: Float,
    isp_vacuum_s: Float,
    chamber_pressure_bar: Float
};

pub fn stub_raptor_methalox_fixture() -> NozzlePerformance {
    let chamber: RocketChamberState = RocketChamberState {
        chamber_pressure_pa: 30000000.0, // 300 bar
        chamber_temp_k: 3550.0,
        gamma: 1.24,
        molecular_weight_kg_kmol: 21.5,
        expansion_ratio: 34.0
    };
    return nozzle_compute_performance(chamber);
}

pub fn stub_f1_kerolox_fixture() -> NozzlePerformance {
    let chamber: RocketChamberState = RocketChamberState {
        chamber_pressure_pa: 7000000.0, // 70 bar
        chamber_temp_k: 3670.0,
        gamma: 1.24,
        molecular_weight_kg_kmol: 23.8,
        expansion_ratio: 16.0
    };
    return nozzle_compute_performance(chamber);
}

pub fn stub_rl10_hydrolox_fixture() -> NozzlePerformance {
    let chamber: RocketChamberState = RocketChamberState {
        chamber_pressure_pa: 4400000.0, // 44 bar
        chamber_temp_k: 3450.0,
        gamma: 1.22,
        molecular_weight_kg_kmol: 14.5,
        expansion_ratio: 280.0 // RL10-B2 extendable carbon-carbon nozzle
    };
    return nozzle_compute_performance(chamber);
}

pub fn stub_next_ion_fixture() -> GriddedIonPerformance {
    let spec: GriddedIonSpec = GriddedIonSpec {
        screen_voltage_v: 1800.0,
        accel_voltage_v: 0.0 - 250.0,
        grid_gap_m: 0.00065,
        aperture_diameter_m: 0.0019,
        num_apertures: 4200,
        ion_mass_amu: 131.29,
        propellant_utilization_eff: 0.88
    };
    return ion_compute_performance(spec);
}

pub fn stub_nerva_nuclear_fixture() -> NtrPerformance {
    let spec: NtrReactorSpec = ntr_spec_default_nerva();
    return ntr_compute_performance(spec);
}

pub fn stub_earth_mars_lambert_fixture() -> LambertSolution {
    let prob: LambertProblem = lambert_problem_default_earth_mars();
    return lambert_solve_universal(prob);
}

pub fn stub_mars_aerocapture_fixture() -> AerocaptureCorridorResult {
    let spec: MarsAerocaptureSpec = mars_aerocapture_spec_default();
    return aerocapture_compute_corridor(spec);
}
