// # Gridded Ion Thruster Grid Optics & Space-Charge Limit
//
// Logline: Evaluates Child-Langmuir space-charge limited current, screen-accel grid optics, perveance, and beam extraction efficiency in gridded ion thrusters.
//
// Setup: Solves multi-aperture electrostatic ion extraction, beam divergence, and thrust scaling for xenon/krypton ion thrusters.
//
// Beats:
//   1. Define ion grid geometry (screen aperture, accel aperture, grid gap) and discharge voltage.
//   2. Compute Child-Langmuir space-charge maximum current density and perveance limit.
//   3. Calculate extracted beam current, exhaust velocity, thrust, and specific impulse.

import "./space_propulsion_constants.oo";

pub type GriddedIonSpec = struct {
    screen_voltage_v: Float, // e.g. 1500 V
    accel_voltage_v: Float, // e.g. -250 V
    grid_gap_m: Float, // e.g. 0.0006 m (0.6 mm)
    aperture_diameter_m: Float,
    num_apertures: Int,
    ion_mass_amu: Float, // 131.29 for Xenon, 83.80 for Krypton
    propellant_utilization_eff: Float
};

pub type GriddedIonPerformance = struct {
    beam_velocity_m_s: Float,
    child_langmuir_j_max_a_m2: Float,
    total_beam_current_a: Float,
    thrust_n: Float,
    specific_impulse_s: Float,
    beam_power_w: Float
};

pub fn gridded_ion_spec_default_xenon() -> GriddedIonSpec {
    return GriddedIonSpec {
        screen_voltage_v: 1800.0,
        accel_voltage_v: 0.0 - 250.0,
        grid_gap_m: 0.0007,
        aperture_diameter_m: 0.0019,
        num_apertures: 4200,
        ion_mass_amu: 131.29,
        propellant_utilization_eff: 0.90
    };
}

pub fn ion_compute_performance(spec: GriddedIonSpec) -> GriddedIonPerformance {
    let v_screen: Float = (spec).screen_voltage_v;
    let v_accel: Float = (spec).accel_voltage_v;
    let v_total: Float = v_screen - v_accel; // total acceleration potential
    let d_gap: Float = (spec).grid_gap_m;
    let d_hole: Float = (spec).aperture_diameter_m;
    let n_holes: Float = (spec).num_apertures + 0.0;
    let amu: Float = (spec).ion_mass_amu;
    let eta_u: Float = (spec).propellant_utilization_eff;

    // Ion mass in kg: 1 amu = 1.66053906660e-27 kg
    let m_ion: Float = amu * 0.000000000000000000000000001660539;
    let q_e: Float = 0.0000000000000000001602176634; // elementary charge C
    let eps_0: Float = 0.0000000000088541878128; // permittivity F/m

    // Beam exit velocity: v_b = sqrt(2 * q * V_screen / m_ion)
    let v_beam: Float = sqrt((2.0 * q_e * v_screen) / m_ion);

    // Child-Langmuir current density limit: J_CL = (4/9) * eps_0 * sqrt(2*q/m) * (V_tot^1.5 / d^2)
    let factor: Float = (4.0 / 9.0) * eps_0 * sqrt((2.0 * q_e) / m_ion);
    let v_15: Float = math_pow(v_total, 1.5);
    let j_cl: Float = (factor * v_15) / (d_gap * d_gap);

    // Single hole extraction current (operational at ~50% of Child-Langmuir limit for stability)
    let a_single: Float = const_pi() * ((d_hole * 0.5) * (d_hole * 0.5));
    let i_single: Float = 0.50 * j_cl * a_single;
    let i_beam: Float = i_single * n_holes;

    // Mass flow rate of ions: m_dot_ions = (I_beam * m_ion) / q_e
    let m_dot_ions: Float = (i_beam * m_ion) / q_e;
    let m_dot_total: Float = m_dot_ions / eta_u;

    // Thrust: F = gamma_div * I_beam * sqrt(2 * m_ion * V_screen / q_e)
    let gamma_div: Float = 0.98; // divergence correction factor
    let thrust: Float = gamma_div * i_beam * sqrt((2.0 * m_ion * v_screen) / q_e);

    // Specific impulse: Isp = F / (m_dot_total * g0)
    let isp: Float = thrust / (m_dot_total * const_g0());
    let p_beam: Float = i_beam * v_screen;

    return GriddedIonPerformance {
        beam_velocity_m_s: v_beam,
        child_langmuir_j_max_a_m2: j_cl,
        total_beam_current_a: i_beam,
        thrust_n: thrust,
        specific_impulse_s: isp,
        beam_power_w: p_beam
    };
}
