// # Re-entry Stagnation Point Aerothermodynamic Heating (Sutton-Graves)
//
// Logline: Calculates Chapman-Sutton-Graves convective and radiative stagnation point aerothermodynamic heat flux, nose radius scaling, and TPS sizing.
//
// Setup: Predicts extreme hypersonic shock layer heating rates and integrated heat load for Earth, Mars, and Venus entry capsules.
//
// Beats:
//   1. Define vehicle nose bluntness radius, entry velocity, atmospheric density, and gas composition factor.
//   2. Compute convective stagnation point heat flux (q_dot_conv) via Sutton-Graves / Fay-Riddell correlations.
//   3. Calculate shock layer radiative heat flux (q_dot_rad) and integrated heat load for Thermal Protection System (TPS) thickness sizing.

import "./space_propulsion_constants.oo";

pub type StagnationHeatingSpec = struct {
    nose_radius_m: Float, // e.g. 0.60 m to 2.0 m blunt heatshield
    entry_velocity_m_s: Float, // e.g. 7800 m/s (LEO) to 11200 m/s (Lunar return)
    atmospheric_density_kg_m3: Float,
    planetary_gas_type: Int // 1: Earth (N2/O2), 2: Mars (CO2/N2), 3: Venus (CO2)
};

pub type StagnationHeatingResult = struct {
    convective_heat_flux_w_cm2: Float,
    radiative_heat_flux_w_cm2: Float,
    total_heat_flux_w_cm2: Float,
    total_heat_flux_mw_m2: Float,
    stagnation_enthalpy_mj_kg: Float,
    equilibrium_wall_temp_k: Float
};

pub fn stagnation_spec_default_lunar_return() -> StagnationHeatingSpec {
    return StagnationHeatingSpec {
        nose_radius_m: 1.2,
        entry_velocity_m_s: 11000.0, // 11 km/s Apollo / Artemis lunar return
        atmospheric_density_kg_m3: 0.00015, // at ~65 km peak heating altitude
        planetary_gas_type: 1 // Earth
    };
}

pub fn heating_compute_stagnation(spec: StagnationHeatingSpec) -> StagnationHeatingResult {
    let rn: Float = (spec).nose_radius_m;
    let v: Float = (spec).entry_velocity_m_s;
    let rho: Float = (spec).atmospheric_density_kg_m3;
    let p_type: Int = (spec).planetary_gas_type;

    // Sutton-Graves convective coefficient k_sg:
    // Earth (N2/O2) ~ 1.7415e-4 kg^0.5 / m
    // Mars (CO2) ~ 1.898e-4
    // Venus (CO2) ~ 1.950e-4
    let mut k_sg: Float = 0.00017415;
    if p_type == 2 {
        k_sg = 0.0001898;
    } else if p_type == 3 {
        k_sg = 0.0001950;
    }

    // Convective stagnation heat flux (Sutton-Graves formula):
    // q_dot_conv = k_sg * sqrt(rho / Rn) * v^3 (in W/m^2)
    let v3: Float = v * v * v;
    let q_conv_w_m2: Float = k_sg * sqrt(rho / (rn + 0.0001)) * v3;

    // Radiative shock layer heat flux approx (Tauber-Sutton model):
    // q_dot_rad ~ C * Rn^a * rho^b * f(v)
    let mut q_rad_w_m2: Float = 0.0;
    if v > 9000.0 {
        // High-speed shock ionization radiative regime
        let v_norm: Float = v / 10000.0;
        let v8: Float = math_pow(v_norm, 8.5);
        let rho_norm: Float = math_pow(rho / 0.001, 1.2);
        q_rad_w_m2 = 1200000.0 * rn * rho_norm * v8;
    }

    let q_total_w_m2: Float = q_conv_w_m2 + q_rad_w_m2;
    let q_total_w_cm2: Float = q_total_w_m2 / 10000.0; // W/cm^2
    let q_conv_w_cm2: Float = q_conv_w_m2 / 10000.0;
    let q_rad_w_cm2: Float = q_rad_w_m2 / 10000.0;
    let q_mw_m2: Float = q_total_w_m2 / 1000000.0;

    // Stagnation total enthalpy: H0 = 0.5 * v^2 (MJ/kg)
    let h0_mj_kg: Float = (0.5 * v * v) / 1000000.0;

    // Equilibrium radiation wall temperature: T_w = (q_total / (eps * sigma))^(1/4)
    let eps_tps: Float = 0.85;
    let sigma: Float = 0.00000005670374419;
    let t_rad4: Float = q_total_w_m2 / (eps_tps * sigma + 0.0000001);
    let t_eq_k: Float = math_pow(t_rad4, 0.25);

    return StagnationHeatingResult {
        convective_heat_flux_w_cm2: q_conv_w_cm2,
        radiative_heat_flux_w_cm2: q_rad_w_cm2,
        total_heat_flux_w_cm2: q_total_w_cm2,
        total_heat_flux_mw_m2: q_mw_m2,
        stagnation_enthalpy_mj_kg: h0_mj_kg,
        equilibrium_wall_temp_k: t_eq_k
    };
}
