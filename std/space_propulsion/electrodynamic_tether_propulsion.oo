// # Electrodynamic Tether (EDT) Lorentz Propulsion & Deorbit Drag
//
// Logline: Evaluates orbital conductive electrodynamic tether Lorentz I(L x B) thrust and electrodynamic drag deorbiting, ionospheric plasma contactor, and induced EMF.
//
// Setup: Solves orbital motion in planetary geomagnetic field, motional EMF generation, ionospheric current collection, and Lorentz force.
//
// Beats:
//   1. Define bare tether conductor length, cross-sectional area, material conductivity, and orbital velocity.
//   2. Compute motional electromotive force (EMF) and bare tether OML electron collection current.
//   3. Calculate electrodynamic Lorentz thrust/drag force, power generation mode, and orbit altitude decay rate.

import "./space_propulsion_constants.oo";

pub type EdtSystemSpec = struct {
    tether_length_km: Float, // e.g. 5.0 km
    wire_diameter_mm: Float, // e.g. 0.6 mm Aluminum
    plasma_density_m3: Float, // e.g. 1e11 m^-3 (LEO ionosphere)
    orbital_velocity_m_s: Float, // e.g. 7600 m/s
    geomagnetic_field_micro_tesla: Float, // e.g. 35 uT in LEO
    mode_thrust_or_drag: Int, // 1: Drag (passive deorbit), 2: Thrust (active power supply)
    power_supply_voltage_v: Float
};

pub type EdtPerformance = struct {
    induced_motional_emf_v: Float,
    tether_current_a: Float,
    lorentz_force_n: Float,
    electrical_power_w: Float,
    altitude_decay_rate_km_day: Float
};

pub fn edt_spec_default_leo_deorbit() -> EdtSystemSpec {
    return EdtSystemSpec {
        tether_length_km: 5.0,
        wire_diameter_mm: 0.8,
        plasma_density_m3: 200000000000.0,
        orbital_velocity_m_s: 7600.0,
        geomagnetic_field_micro_tesla: 32.0,
        mode_thrust_or_drag: 1, // Drag mode
        power_supply_voltage_v: 0.0
    };
}

pub fn edt_compute_performance(spec: EdtSystemSpec, satellite_mass_kg: Float) -> EdtPerformance {
    let l_km: Float = (spec).tether_length_km;
    let l_m: Float = l_km * 1000.0;
    let d_mm: Float = (spec).wire_diameter_mm;
    let d_m: Float = d_mm * 0.001;
    let v_orb: Float = (spec).orbital_velocity_m_s;
    let b_ut: Float = (spec).geomagnetic_field_micro_tesla;
    let b_tesla: Float = b_ut * 0.000001;
    let mode: Int = (spec).mode_thrust_or_drag;
    let v_ext: Float = (spec).power_supply_voltage_v;

    // Motional EMF: V_ind = (v_orb x B) * L = v_orb * B * L (perpendicular approx)
    let v_emf: Float = v_orb * b_tesla * l_m;

    // Tether electrical resistance: R = rho_res * L / A (Aluminum rho ~ 2.82e-8 Ohm*m)
    let a_wire: Float = const_pi() * ((d_m * 0.5) * (d_m * 0.5));
    let r_wire: Float = (0.0000000282 * l_m) / (a_wire + 0.0000000001);

    // Bare tether current collection (OML theory simplified average current)
    let mut i_avg: Float = 0.0;
    let mut p_elec: Float = 0.0;

    if mode == 1 {
        // Drag mode: load dissipation
        let r_total: Float = r_wire + 200.0; // wire + plasma contactor impedance
        i_avg = v_emf / r_total;
        if i_avg > 2.5 { i_avg = 2.5; } // plasma collection saturation limit
        p_elec = i_avg * v_emf;
    } else {
        // Thrust mode: active reverse current
        if v_ext > v_emf {
            let dv: Float = v_ext - v_emf;
            i_avg = dv / (r_wire + 200.0);
            p_elec = i_avg * v_ext;
        }
    }

    // Lorentz force: F = I * (L x B) = I * L * B
    let f_lorentz: Float = i_avg * l_m * b_tesla;

    // Daily altitude decay rate in drag mode: dh/dt ~ 2 * v_orb * F_drag / (m * g0)
    let mut dh_dt_km_day: Float = 0.0;
    if mode == 1 {
        let decel: Float = f_lorentz / satellite_mass_kg;
        let dh_s: Float = 2.0 * decel * (v_orb / 9.8);
        dh_dt_km_day = (dh_s * 86400.0) / 1000.0;
    }

    return EdtPerformance {
        induced_motional_emf_v: v_emf,
        tether_current_a: i_avg,
        lorentz_force_n: f_lorentz,
        electrical_power_w: p_elec,
        altitude_decay_rate_km_day: dh_dt_km_day
    };
}
