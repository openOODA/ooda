// # Capillary Propellant Management Device (PMD) & Zero-G Retention
//
// Logline: Evaluates surface tension propellant management device (PMD) capillary vanes, sponges, traps, bubble point pressure, and zero-g liquid retention.
//
// Setup: Solves zero-g liquid reorientation, Bond number scaling, screen bubble point breakthrough, and gas-free restart feeding.
//
// Beats:
//   1. Define PMD mesh screen pore radius, contact angle, surface tension, and settling acceleration.
//   2. Compute capillary bubble point pressure and maximum hydrostatic liquid column retention.
//   3. Calculate capillary vane pumping flow rate and restart trap usable propellant volume.

import "./space_propulsion_constants.oo";

pub type CapillaryPmdSpec = struct {
    screen_pore_radius_um: Float, // e.g. 15.0 microns (325x2300 Dutch twill mesh)
    liquid_surface_tension_n_m: Float, // e.g. 0.030 N/m (Hydrazine / N2O4 / LOX)
    contact_angle_deg: Float, // 0 deg (perfect wetting)
    propellant_density_kg_m3: Float,
    settling_acceleration_g: Float, // e.g. 0.005 g residual RCS acceleration
    trap_internal_volume_liters: Float, // e.g. 8.0 L start-basket trap
};

pub type PmdRetentionPerformance = struct {
    bubble_point_pressure_pa: Float,
    max_retained_head_m: Float,
    bond_number: Float,
    usable_restart_mass_kg: Float,
    is_bubble_resistant: Bool,
};

pub fn capillary_pmd_spec_default_hydrazine() -> CapillaryPmdSpec {
    return CapillaryPmdSpec {
        screen_pore_radius_um: 12.0,
        liquid_surface_tension_n_m: 0.066, // Hydrazine surface tension
        contact_angle_deg: 0.0, // perfect wetting
        propellant_density_kg_m3: 1004.0,
        settling_acceleration_g: 0.002, // 2 milli-g settling
        trap_internal_volume_liters: 12.5,
    };
}

pub fn pmd_compute_retention(
    spec: CapillaryPmdSpec,
    applied_delta_p_pa: Float
) -> PmdRetentionPerformance {
    let r_pore_m: Float = (spec).screen_pore_radius_um * 0.000001;
    let sigma_st: Float = (spec).liquid_surface_tension_n_m;
    let theta_rad: Float = (spec).contact_angle_deg * const_deg_to_rad();
    let rho: Float = (spec).propellant_density_kg_m3;
    let g_eff: Float = (spec).settling_acceleration_g * const_g0();
    let v_trap_l: Float = (spec).trap_internal_volume_liters;

    // Bubble point pressure (Young-Laplace): Delta_P_bp = (2 * sigma * cos(theta)) / r_pore
    let dp_bp: Float = (2.0 * sigma_st * cos(theta_rad)) / r_pore_m;

    // Maximum hydrostatic retention height under acceleration: h_max = Delta_P_bp / (rho * g_eff)
    let h_max: Float = dp_bp / (rho * g_eff + 0.000001);

    // Bond number: Bo = (rho * g_eff * L^2) / sigma (for L = 0.2 m trap scale)
    let l_char: Float = 0.20;
    let bo: Float = (rho * g_eff * (l_char * l_char)) / sigma_st;

    // Usable restart propellant mass (kg)
    let m_usable: Float = (v_trap_l * 0.001) * rho * 0.95;

    let resistant: Bool = applied_delta_p_pa < (dp_bp * 0.70); // 30% margin

    return PmdRetentionPerformance {
        bubble_point_pressure_pa: dp_bp,
        max_retained_head_m: h_max,
        bond_number: bo,
        usable_restart_mass_kg: m_usable,
        is_bubble_resistant: resistant,
    };
}
