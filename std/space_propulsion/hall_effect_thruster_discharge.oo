// # Hall Effect Thruster Cross-Field Discharge & E x B Drift
//
// Logline: Calculates Hall effect thruster ExB electron drift, azimuthal current, ionization efficiency, and thrust scaling.
//
// Setup: Models annular channel plasma dynamics, radial magnetic barrier, axial electrostatic acceleration, and thrust efficiency.
//
// Beats:
//   1. Define annular channel geometry, magnetic field strength, discharge voltage, and gas flow.
//   2. Compute ExB azimuthal Hall current and electron Larmor radius confinement.
//   3. Calculate ion beam acceleration, thrust, specific impulse, and electrical thrust-to-power ratio.

import "./space_propulsion_constants.oo";

pub type HallThrusterSpec = struct {
    discharge_voltage_v: Float, // e.g. 300 V - 600 V
    discharge_current_a: Float, // e.g. 15 A
    magnetic_field_tesla: Float, // e.g. 0.02 T (200 Gauss)
    anode_mass_flow_mg_s: Float, // e.g. 10 mg/s Xenon
    propellant_amu: Float
};

pub type HallThrusterPerformance = struct {
    thrust_mn: Float,
    specific_impulse_s: Float,
    discharge_power_w: Float,
    anode_efficiency: Float,
    thrust_to_power_mn_per_kw: Float,
    electron_larmor_radius_mm: Float
};

pub fn hall_thruster_spec_default_5kw() -> HallThrusterSpec {
    return HallThrusterSpec {
        discharge_voltage_v: 300.0,
        discharge_current_a: 15.0,
        magnetic_field_tesla: 0.02,
        anode_mass_flow_mg_s: 10.0,
        propellant_amu: 131.29 // Xenon
    };
}

pub fn hall_compute_performance(spec: HallThrusterSpec) -> HallThrusterPerformance {
    let vd: Float = (spec).discharge_voltage_v;
    let id: Float = (spec).discharge_current_a;
    let b_field: Float = (spec).magnetic_field_tesla;
    let m_dot_mg: Float = (spec).anode_mass_flow_mg_s;
    let m_dot_kg_s: Float = m_dot_mg * 0.000001;
    let amu: Float = (spec).propellant_amu;

    let m_ion: Float = amu * 0.000000000000000000000000001660539;
    let q_e: Float = 0.0000000000000000001602176634;
    let m_e: Float = 0.000000000000000000000000000000910938;

    // Discharge power
    let p_disch: Float = vd * id;

    // Electron Larmor radius in channel (assuming electron temperature ~ 20 eV -> v_th ~ 2.6e6 m/s)
    let v_e_th: Float = 2650000.0;
    let r_larmor: Float = (m_e * v_e_th) / (q_e * b_field);
    let r_larmor_mm: Float = r_larmor * 1000.0;

    // Current utilization fraction (ion current / discharge current ~ 0.80 - 0.88)
    let eta_curr: Float = 0.85;
    let i_ion: Float = id * eta_curr;

    // Voltage utilization (effective acceleration potential ~ 0.90 * Vd)
    let eta_v: Float = 0.90;
    let v_eff_accel: Float = vd * eta_v;

    // Ion exhaust velocity: v_ex = sqrt(2 * q * V_eff / m_ion)
    let v_exhaust: Float = sqrt((2.0 * q_e * v_eff_accel) / m_ion);

    // Thrust: F = gamma * m_dot_ions * v_exhaust (gamma ~ 0.95 for divergence)
    let gamma_div: Float = 0.95;
    let m_dot_ions: Float = (i_ion * m_ion) / q_e;
    let thrust_n: Float = gamma_div * m_dot_ions * v_exhaust;
    let thrust_mn: Float = thrust_n * 1000.0;

    // Specific impulse: Isp = F / (m_dot_total * g0)
    let isp: Float = thrust_n / (m_dot_kg_s * const_g0());

    // Anode efficiency: eta_a = F^2 / (2 * m_dot * P_disch)
    let eta_anode: Float = (thrust_n * thrust_n) / (2.0 * m_dot_kg_s * p_disch);

    let t_to_p: Float = thrust_mn / (p_disch / 1000.0);

    return HallThrusterPerformance {
        thrust_mn: thrust_mn,
        specific_impulse_s: isp,
        discharge_power_w: p_disch,
        anode_efficiency: eta_anode,
        thrust_to_power_mn_per_kw: t_to_p,
        electron_larmor_radius_mm: r_larmor_mm
    };
}
