// # Rocket Thrust Chamber Film Cooling & Barrier Layer Model
//
// Logline: Evaluates liquid/gas film cooling barrier layer model, adiabatic wall effectiveness, and core gas entrainment.
//
// Setup: Predicts axial temperature decay along combustion chamber liner protected by secondary coolant film injection.
//
// Beats:
//   1. Define film injection slot geometry, coolant mass fraction, and injection velocity ratio.
//   2. Compute Hatch-Papell adiabatic wall effectiveness as a function of downstream distance.
//   3. Calculate effective adiabatic wall temperature and reduced heat flux to chamber liner.

import "./space_propulsion_constants.oo";

pub type FilmCoolingSpec = struct {
    film_mass_fraction: Float, // e.g. 0.05 (5% of fuel)
    slot_height_m: Float,
    injection_temp_k: Float,
    core_gas_temp_k: Float,
    blowing_ratio: Float, // (rho_f * v_f) / (rho_g * v_g)
};

pub type FilmCoolingProfile = struct {
    effectiveness_at_x: Float,
    t_adiabatic_wall_k: Float,
    heat_flux_reduction_ratio: Float,
};

pub fn film_cooling_spec_default() -> FilmCoolingSpec {
    return FilmCoolingSpec {
        film_mass_fraction: 0.04,
        slot_height_m: 0.0015,
        injection_temp_k: 280.0,
        core_gas_temp_k: 3400.0,
        blowing_ratio: 0.85,
    };
}

pub fn film_compute_effectiveness(x_dist_m: Float, spec: FilmCoolingSpec) -> Float {
    let s: Float = (spec).slot_height_m;
    let m_ratio: Float = (spec).blowing_ratio;
    if x_dist_m <= 0.0 { return 1.0; }
    let x_s: Float = x_dist_m / s;
    // Standard Hatch-Papell empirical correlation: eta = 1 / (1 + 0.25 * (x / (M * s))^0.8)
    let m_term: Float = x_s / (m_ratio + 0.0001);
    let denom: Float = 1.0 + (0.25 * math_pow(m_term, 0.8));
    return 1.0 / denom;
}

pub fn film_evaluate_at_distance(x_dist_m: Float, spec: FilmCoolingSpec) -> FilmCoolingProfile {
    let eta: Float = film_compute_effectiveness(x_dist_m, spec);
    let tg: Float = (spec).core_gas_temp_k;
    let tf: Float = (spec).injection_temp_k;

    // T_aw = T_g - eta * (T_g - T_f)
    let t_aw: Float = tg - (eta * (tg - tf));
    let q_reduction: Float = 1.0 - eta;

    return FilmCoolingProfile {
        effectiveness_at_x: eta,
        t_adiabatic_wall_k: t_aw,
        heat_flux_reduction_ratio: q_reduction,
    };
}
