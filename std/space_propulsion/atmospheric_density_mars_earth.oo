// # Planetary Atmosphere Density & Temperature Models (Earth & Mars)
//
// Logline: Models Earth US Standard Atmosphere 1976 and Mars CO2 exponential / MGCM atmospheric density, temperature, and pressure profiles across altitudes.
//
// Setup: Solves barometric hydrostatic equilibrium, multi-layer lapse rates, speed of sound, and dynamic viscosity for trajectory simulation.
//
// Beats:
//   1. Define planetary atmosphere selection (Earth vs Mars), altitude range (0 to 120 km), and surface conditions.
//   2. Compute piecewise linear temperature lapse rates across troposphere, stratosphere, mesosphere, and thermosphere.
//   3. Calculate atmospheric pressure, local mass density, speed of sound, and Sutherland dynamic viscosity.

import "./space_propulsion_constants.oo";

pub type AtmosphereState = struct {
    altitude_m: Float,
    temperature_k: Float,
    pressure_pa: Float,
    density_kg_m3: Float,
    speed_of_sound_m_s: Float,
    dynamic_viscosity_pa_s: Float,
};

pub fn atmosphere_earth_us76(alt_m: Float) -> AtmosphereState {
    let mut h: Float = alt_m;
    if h < 0.0 { h = 0.0; }
    if h > 85000.0 { h = 85000.0; }

    let mut t: Float = 288.15;
    let mut p: Float = 101325.0;

    if h <= 11000.0 {
        // Troposphere: -6.5 K/km lapse rate
        let lapse: Float = 0.0 - 0.0065;
        t = 288.15 + (lapse * h);
        p = 101325.0 * math_pow(t / 288.15, 5.255877);
    } else if h <= 20000.0 {
        // Tropopause (isothermal 216.65 K)
        t = 216.65;
        p = 22632.0 * math_exp((0.0 - const_g0()) * (h - 11000.0) / (287.05 * 216.65));
    } else if h <= 32000.0 {
        // Stratosphere 1: +1.0 K/km
        t = 216.65 + (0.0010 * (h - 20000.0));
        p = 5474.8 * math_pow(t / 216.65, 0.0 - 34.163);
    } else if h <= 47000.0 {
        // Stratosphere 2: +2.8 K/km
        t = 228.65 + (0.0028 * (h - 32000.0));
        p = 868.01 * math_pow(t / 228.65, 0.0 - 12.201);
    } else {
        // Mesosphere: -2.8 K/km
        t = 270.65 - (0.0028 * (h - 47000.0));
        p = 110.90 * math_pow(t / 270.65, 12.201);
    }

    let r_air: Float = 287.05; // J/(kg*K)
    let rho: Float = p / (r_air * t);
    let gamma: Float = 1.40;
    let a_sound: Float = sqrt(gamma * r_air * t);

    // Sutherland viscosity law: mu = mu0 * (T/T0)^1.5 * (T0 + S) / (T + S)
    let mu0: Float = 0.00001716;
    let s_suth: Float = 110.4;
    let mu: Float = mu0 * math_pow(t / 273.15, 1.5) * ((273.15 + s_suth) / (t + s_suth));

    return AtmosphereState {
        altitude_m: h,
        temperature_k: t,
        pressure_pa: p,
        density_kg_m3: rho,
        speed_of_sound_m_s: a_sound,
        dynamic_viscosity_pa_s: mu,
    };
}

pub fn atmosphere_mars_mgcm(alt_m: Float) -> AtmosphereState {
    let mut h: Float = alt_m;
    if h < 0.0 { h = 0.0; }
    if h > 100000.0 { h = 100000.0; }

    // Mars surface reference: T0 ~ 210 K, P0 ~ 610 Pa
    let t: Float = 210.0 - (0.0016 * h); // ~ -1.6 K/km average lapse
    let h_scale: Float = 11100.0; // 11.1 km scale height
    let p: Float = 610.0 * math_exp(0.0 - (h / h_scale));

    let r_co2: Float = 188.92; // J/(kg*K) for CO2
    let rho: Float = p / (r_co2 * t);
    let gamma_co2: Float = 1.29;
    let a_sound: Float = sqrt(gamma_co2 * r_co2 * t);

    let mu: Float = 0.0000148 * math_pow(t / 240.0, 0.7);

    return AtmosphereState {
        altitude_m: h,
        temperature_k: t,
        pressure_pa: p,
        density_kg_m3: rho,
        speed_of_sound_m_s: a_sound,
        dynamic_viscosity_pa_s: mu,
    };
}
