// # Arcjet Thruster Electric Arc Discharge & Plasma Heating
//
// Logline: Solves constricted electric arc discharge plasma heating, anode/cathode voltage falls, frozen flow dissociation losses, and arcjet Isp.
//
// Setup: Models high-temperature constricted arc in constrictor nozzle throat with high-power electrothermal expansion.
//
// Beats:
//   1. Define arc current, constrictor diameter, propellant gas flow, and electrode sheath falls.
//   2. Compute core arc column temperature (10000 K - 20000 K) and thermal conduction to surrounding gas sheath.
//   3. Calculate nozzle expansion velocity, frozen dissociation efficiency loss, and specific impulse.

import "./space_propulsion_constants.oo";

pub type ArcjetSpec = struct {
    arc_current_a: Float, // e.g. 10 A to 50 A
    arc_voltage_v: Float, // e.g. 100 V to 200 V
    mass_flow_mg_s: Float, // e.g. 50 mg/s Hydrazine / Ammonia / Hydrogen
    constrictor_diameter_mm: Float, // e.g. 0.6 mm
    anode_fall_v: Float,
    cathode_fall_v: Float,
    propellant_type: Int, // 1: Hydrazine (N2H4), 2: Ammonia, 3: Hydrogen
};

pub type ArcjetPerformance = struct {
    total_power_kw: Float,
    core_arc_temp_k: Float,
    bulk_gas_temp_k: Float,
    exhaust_velocity_m_s: Float,
    thrust_n: Float,
    specific_impulse_s: Float,
    thermal_efficiency: Float,
};

pub fn arcjet_spec_default_hydrazine() -> ArcjetSpec {
    return ArcjetSpec {
        arc_current_a: 10.5,
        arc_voltage_v: 110.0,
        mass_flow_mg_s: 50.0, // 0.05 g/s
        constrictor_diameter_mm: 0.63,
        anode_fall_v: 15.0,
        cathode_fall_v: 8.0,
        propellant_type: 1, // Hydrazine
    };
}

pub fn arcjet_compute_performance(spec: ArcjetSpec) -> ArcjetPerformance {
    let i_arc: Float = (spec).arc_current_a;
    let v_arc: Float = (spec).arc_voltage_v;
    let m_dot_mg: Float = (spec).mass_flow_mg_s;
    let m_dot_kg_s: Float = m_dot_mg * 0.000001;
    let p_type: Int = (spec).propellant_type;

    let p_elec_w: Float = i_arc * v_arc;
    let p_elec_kw: Float = p_elec_w / 1000.0;

    // Electrode sheath losses: P_loss = I * (V_anode + V_cathode)
    let v_sheaths: Float = (spec).anode_fall_v + (spec).cathode_fall_v;
    let p_column_w: Float = i_arc * (v_arc - v_sheaths);

    // Core arc column reaches ~ 15000 K, but bulk flow mixed gas T ~ 3000 K - 5000 K
    let t_core: Float = 14000.0 + (50.0 * i_arc);

    let mut cp_bulk: Float = 3000.0;
    let mut mw_eff: Float = 10.7; // Hydrazine decomposed: N2 + 2H2 -> MW ~ 10.7
    let mut eta_frozen: Float = 0.65; // high dissociation energy lost in H atoms

    if p_type == 2 {
        // Ammonia
        cp_bulk = 3200.0;
        mw_eff = 8.5;
        eta_frozen = 0.60;
    } else if p_type == 3 {
        // Hydrogen
        cp_bulk = 16000.0;
        mw_eff = 2.016;
        eta_frozen = 0.72;
    }

    // Thermal power deposited into bulk flow: Q_bulk = eta_transfer * P_column
    let eta_transfer: Float = 0.55;
    let q_bulk_w: Float = p_column_w * eta_transfer;
    let dt_bulk: Float = q_bulk_w / (m_dot_kg_s * cp_bulk + 0.00001);
    let t_bulk: Float = 300.0 + dt_bulk;

    // Exhaust velocity from thermal enthalpy: v_ex = sqrt(2 * eta_frozen * Cp * T_bulk)
    let v_ex: Float = sqrt(2.0 * eta_frozen * cp_bulk * t_bulk);
    let thrust_n: Float = m_dot_kg_s * v_ex;
    let isp: Float = v_ex / const_g0();

    let eta_th: Float = (0.5 * m_dot_kg_s * (v_ex * v_ex)) / p_elec_w;

    return ArcjetPerformance {
        total_power_kw: p_elec_kw,
        core_arc_temp_k: t_core,
        bulk_gas_temp_k: t_bulk,
        exhaust_velocity_m_s: v_ex,
        thrust_n: thrust_n,
        specific_impulse_s: isp,
        thermal_efficiency: eta_th,
    };
}
