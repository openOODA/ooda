// # Rocket Combustion Chamber Thermochemistry & O/F Ratio
//
// Logline: Evaluates thermochemical rocket combustion equilibrium, oxidizer-to-fuel (O/F) mixture ratio, adiabatic flame temperature, and characteristic exhaust velocity.
//
// Setup: Models chemical equilibrium combustion for liquid bipropellants (Hydrolox, Methalox, Kerolox) across chamber pressures.
//
// Beats:
//   1. Define bipropellant mixture parameters (LOX/LH2, LOX/CH4, LOX/RP-1).
//   2. Compute adiabatic flame temperature and mean molecular weight as functions of O/F ratio.
//   3. Determine optimal O/F ratio for maximum characteristic exhaust velocity (c*).

import "./space_propulsion_constants.oo";

pub type PropellantCombination = struct {
    prop_type: Int, // 1: Hydrolox, 2: Methalox, 3: Kerolox
    of_ratio: Float,
    chamber_pressure_bar: Float
};

pub type CombustionState = struct {
    flame_temp_k: Float,
    molecular_weight: Float,
    gamma: Float,
    c_star_m_s: Float,
    density_mix_kg_m3: Float
};

pub fn combustion_hydrolox_default() -> PropellantCombination {
    return PropellantCombination {
        prop_type: 1,
        of_ratio: 5.5,
        chamber_pressure_bar: 100.0
    };
}

pub fn combustion_methalox_default() -> PropellantCombination {
    return PropellantCombination {
        prop_type: 2,
        of_ratio: 3.6,
        chamber_pressure_bar: 200.0
    };
}

pub fn combustion_kerolox_default() -> PropellantCombination {
    return PropellantCombination {
        prop_type: 3,
        of_ratio: 2.6,
        chamber_pressure_bar: 100.0
    };
}

pub fn combustion_evaluate_state(comb: PropellantCombination) -> CombustionState {
    let p_type: Int = (comb).prop_type;
    let of: Float = (comb).of_ratio;
    let pc: Float = (comb).chamber_pressure_bar;

    let mut t_flame: Float = 3300.0;
    let mut mw: Float = 22.0;
    let mut gamma: Float = 1.23;
    let mut rho: Float = 1000.0;

    if p_type == 1 {
        // Hydrolox (LOX / LH2)
        // Peak T ~ 3600 K around OF=5.0, MW varies 12-18
        let d_of: Float = of - 5.5;
        t_flame = 3500.0 - (100.0 * (d_of * d_of)) + (20.0 * math_ln(pc / 50.0));
        mw = 13.0 + (1.2 * of);
        gamma = 1.22;
        rho = (1140.0 * of + 71.0) / (of + 1.0);
    } else if p_type == 2 {
        // Methalox (LOX / CH4)
        // Peak T ~ 3550 K around OF=3.6, MW varies 18-24
        let d_of: Float = of - 3.6;
        t_flame = 3550.0 - (150.0 * (d_of * d_of)) + (15.0 * math_ln(pc / 50.0));
        mw = 16.0 + (1.5 * of);
        gamma = 1.24;
        rho = (1140.0 * of + 422.0) / (of + 1.0);
    } else {
        // Kerolox (LOX / RP-1)
        // Peak T ~ 3700 K around OF=2.6, MW varies 21-25
        let d_of: Float = of - 2.6;
        t_flame = 3670.0 - (200.0 * (d_of * d_of)) + (12.0 * math_ln(pc / 50.0));
        mw = 18.0 + (2.0 * of);
        gamma = 1.24;
        rho = (1140.0 * of + 810.0) / (of + 1.0);
    }

    let rs: Float = const_r_univ() / mw;
    let g_exp: Float = (gamma + 1.0) / (gamma - 1.0);
    let term: Float = math_pow(2.0 / (gamma + 1.0), g_exp);
    let gamma_factor: Float = gamma * sqrt(term);
    let c_star: Float = sqrt(gamma * rs * t_flame) / gamma_factor;

    return CombustionState {
        flame_temp_k: t_flame,
        molecular_weight: mw,
        gamma: gamma,
        c_star_m_s: c_star,
        density_mix_kg_m3: rho
    };
}
