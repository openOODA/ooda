// # Propellant Line Water Hammer Surge & Valve Transient Dynamics
//
// Logline: Calculates Joukowsky rapid-closure water hammer surge pressure, hydraulic acoustic wave speed, propellant line elasticity, and peak pressure.
//
// Setup: Predicts fluid transient shockwaves caused by rapid engine main propellant valve (MPV) shutdown and chilldown line priming.
//
// Beats:
//   1. Define pipe diameter, wall thickness, material Young's modulus, propellant density, and bulk modulus.
//   2. Compute elastic wave propagation speed (c_eff) in thin-walled propellant duct.
//   3. Calculate Joukowsky peak pressure surge for instantaneous/gradual valve closure times.

import "./space_propulsion_constants.oo";

pub type PropellantLineSpec = struct {
    pipe_diameter_m: Float,
    pipe_wall_thickness_m: Float,
    line_length_m: Float,
    propellant_density_kg_m3: Float,
    propellant_bulk_modulus_gpa: Float, // e.g. 1.2 GPa for LOX, 0.9 GPa for LCH4
    pipe_youngs_modulus_gpa: Float, // e.g. 200 GPa for Stainless, 70 GPa for Aluminum
    steady_flow_velocity_m_s: Float,
    valve_closure_time_s: Float,
    steady_line_pressure_bar: Float,
};

pub type WaterHammerResult = struct {
    acoustic_wave_speed_m_s: Float,
    pipe_elasticity_factor: Float,
    critical_closure_time_s: Float,
    joukowsky_pressure_surge_bar: Float,
    peak_line_pressure_bar: Float,
    is_rapid_closure: Bool,
};

pub fn propellant_line_spec_default_lox() -> PropellantLineSpec {
    return PropellantLineSpec {
        pipe_diameter_m: 0.20, // 200 mm diameter feed duct
        pipe_wall_thickness_m: 0.003, // 3 mm
        line_length_m: 12.0,
        propellant_density_kg_m3: 1140.0,
        propellant_bulk_modulus_gpa: 1.25,
        pipe_youngs_modulus_gpa: 200.0,
        steady_flow_velocity_m_s: 8.5,
        valve_closure_time_s: 0.025, // 25 ms rapid valve closure
        steady_line_pressure_bar: 5.0,
    };
}

pub fn water_hammer_compute_surge(spec: PropellantLineSpec) -> WaterHammerResult {
    let d: Float = (spec).pipe_diameter_m;
    let e_w: Float = (spec).pipe_wall_thickness_m;
    let l_line: Float = (spec).line_length_m;
    let rho: Float = (spec).propellant_density_kg_m3;
    let k_bulk: Float = (spec).propellant_bulk_modulus_gpa * 1000000000.0;
    let e_mod: Float = (spec).pipe_youngs_modulus_gpa * 1000000000.0;
    let v0: Float = (spec).steady_flow_velocity_m_s;
    let t_close: Float = (spec).valve_closure_time_s;
    let p_stat: Float = (spec).steady_line_pressure_bar;

    // Acoustic wave speed in pipe with elastic walls (Korteweg formula):
    // a = sqrt( (K / rho) / (1 + (K / E) * (D / e)) )
    let pipe_factor: Float = (k_bulk / e_mod) * (d / e_w);
    let c_sound_pure: Float = sqrt(k_bulk / rho);
    let a_wave: Float = c_sound_pure / sqrt(1.0 + pipe_factor);

    // Critical pipeline round-trip reflection time: t_crit = 2 * L / a
    let t_crit: Float = (2.0 * l_line) / a_wave;
    let is_rapid: Bool = t_close <= t_crit;

    // Joukowsky maximum pressure surge: Delta_P_max = rho * a * v0
    let dp_joukowsky_pa: Float = rho * a_wave * v0;

    // If gradual closure (t_close > t_crit), surge is attenuated by (t_crit / t_close)
    let mut dp_effective_pa: Float = dp_joukowsky_pa;
    if t_close > t_crit {
        dp_effective_pa = dp_joukowsky_pa * (t_crit / t_close);
    }

    let dp_bar: Float = dp_effective_pa / 100000.0;
    let p_peak: Float = p_stat + dp_bar;

    return WaterHammerResult {
        acoustic_wave_speed_m_s: a_wave,
        pipe_elasticity_factor: pipe_factor,
        critical_closure_time_s: t_crit,
        joukowsky_pressure_surge_bar: dp_bar,
        peak_line_pressure_bar: p_peak,
        is_rapid_closure: is_rapid,
    };
}
