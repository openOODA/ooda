// # Interplanetary B-Plane Targeting & Trajectory Correction
//
// Logline: Calculates interplanetary hyperbolic B-plane target vector (B_dot_R, B_dot_T), semi-minor axis, theta angle, and trajectory correction maneuver (TCM).
//
// Setup: Solves hyperbolic encounter asymptotic plane targeting for Mars/Venus orbit insertion, atmospheric entry, and flybys.
//
// Beats:
//   1. Define planet gravitational parameter, incoming asymptotic velocity S_hat, and target periapsis radius.
//   2. Compute hyperbolic semi-minor axis (impact parameter b), B-vector magnitude, and theta orientation angle.
//   3. Calculate B-plane components (B_dot_T, B_dot_R) and required mid-course trajectory correction delta-V (TCM).

import "./space_propulsion_constants.oo";

pub type BPlaneTargetSpec = struct {
    planet_mu: Float,
    planet_radius_m: Float,
    v_infinity_m_s: Float,
    target_periapsis_alt_m: Float,
    target_theta_deg: Float, // orientation angle in B-plane
};

pub type BPlaneCoordinates = struct {
    b_magnitude_m: Float,
    b_dot_t_m: Float,
    b_dot_r_m: Float,
    semi_minor_axis_m: Float,
    hyperbolic_eccentricity: Float,
    tcm_delta_v_m_s: Float, // for 100 km miss correction at 10 days out
};

pub fn b_plane_target_spec_default_mars() -> BPlaneTargetSpec {
    return BPlaneTargetSpec {
        planet_mu: const_mu_mars(),
        planet_radius_m: const_radius_mars(),
        v_infinity_m_s: 5650.0, // 5.65 km/s arrival v_inf
        target_periapsis_alt_m: 250000.0, // 250 km capture periapsis
        target_theta_deg: 45.0,
    };
}

pub fn b_plane_compute_coordinates(spec: BPlaneTargetSpec) -> BPlaneCoordinates {
    let mu_p: Float = (spec).planet_mu;
    let r_p: Float = (spec).planet_radius_m + (spec).target_periapsis_alt_m;
    let v_inf: Float = (spec).v_infinity_m_s;
    let theta_deg: Float = (spec).target_theta_deg;
    let theta_rad: Float = theta_deg * const_deg_to_rad();

    // Hyperbolic semi-major axis: a = -mu / v_inf^2
    let a_sma: Float = (0.0 - mu_p) / (v_inf * v_inf);
    // Eccentricity: e = 1 + (r_p * v_inf^2 / mu)
    let e_hyp: Float = 1.0 + ((r_p * (v_inf * v_inf)) / mu_p);

    // Hyperbolic semi-minor axis (impact parameter magnitude B):
    // b = |a| * sqrt(e^2 - 1) = r_p * sqrt(1 + 2*mu / (r_p * v_inf^2))
    let b_mag: Float = math_abs(a_sma) * sqrt((e_hyp * e_hyp) - 1.0);

    // B-plane components in R-T reference frame:
    // B_dot_T = B * cos(theta)
    // B_dot_R = B * sin(theta)
    let b_t: Float = b_mag * cos(theta_rad);
    let b_r: Float = b_mag * sin(theta_rad);

    // Midcourse trajectory correction maneuver Delta_V sensitivity:
    // Delta_V_tcm ~ (Delta_B / t_go)
    let t_go_s: Float = 10.0 * 86400.0; // 10 days out
    let delta_b_miss: Float = 100000.0; // 100 km target adjustment
    let dv_tcm: Float = delta_b_miss / t_go_s; // ~0.11 m/s

    return BPlaneCoordinates {
        b_magnitude_m: b_mag,
        b_dot_t_m: b_t,
        b_dot_r_m: b_r,
        semi_minor_axis_m: b_mag,
        hyperbolic_eccentricity: e_hyp,
        tcm_delta_v_m_s: dv_tcm,
    };
}
