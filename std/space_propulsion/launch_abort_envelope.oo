// # Launch Abort System (LAS) Envelope & Separation Clearance
//
// Logline: Evaluates pad abort and in-flight launch escape system (LES) solid rocket motor tower, abort trajectory escape velocity, and clearance envelope.
//
// Setup: Analyzes crew capsule emergency abort dynamics from pad (0-0 abort) through high dynamic pressure Max-Q ascent abort regimes.
//
// Beats:
//   1. Define capsule mass, escape motor thrust, burn duration, and launch vehicle ascent velocity.
//   2. Compute abort pull-away acceleration, aerodynamic drag, and lateral pitch-steering clearance vector.
//   3. Calculate altitude gain, separation distance from failing booster, and parachute deployment envelope.

import "./space_propulsion_constants.oo";

pub type LaunchAbortSpec = struct {
    capsule_mass_kg: Float, // e.g. 10000 kg (Orion / Dragon scale)
    escape_thrust_kn: Float, // e.g. 1800 kN (high-thrust solid abort motor)
    burn_duration_s: Float, // e.g. 4.5 s
    pitch_angle_deg: Float, // lateral kick angle ~ 15 deg
    capsule_cd_area_m2: Float,
};

pub type AbortTrajectoryResult = struct {
    peak_accel_g: Float,
    separation_velocity_m_s: Float,
    altitude_gain_m: Float,
    downrange_separation_m: Float,
    clearance_at_1s_m: Float,
    can_safely_parachute: Bool,
};

pub fn launch_abort_spec_default() -> LaunchAbortSpec {
    return LaunchAbortSpec {
        capsule_mass_kg: 10500.0,
        escape_thrust_kn: 1750.0,
        burn_duration_s: 4.2,
        pitch_angle_deg: 14.0,
        capsule_cd_area_m2: 8.5,
    };
}

pub fn abort_evaluate_pad_escape(spec: LaunchAbortSpec) -> AbortTrajectoryResult {
    let m_cap: Float = (spec).capsule_mass_kg;
    let t_abort: Float = (spec).escape_thrust_kn * 1000.0;
    let t_burn: Float = (spec).burn_duration_s;
    let theta_rad: Float = (spec).pitch_angle_deg * const_deg_to_rad();
    let cd_a: Float = (spec).capsule_cd_area_m2;

    // Net acceleration: a_net = T / m - g0 * cos(theta)
    let a_thrust: Float = t_abort / m_cap;
    let a_g: Float = a_thrust / const_g0();

    let a_axial: Float = a_thrust - (const_g0() * cos(theta_rad));
    let a_lateral: Float = a_thrust * sin(theta_rad);

    // Escape velocity at burnout: v_bo = a_axial * t_burn (minus average aero drag ~ 15%)
    let v_sep: Float = (a_axial * t_burn) * 0.85;

    // Altitude gained during burn + coast to apogee:
    // h_burn = 0.5 * a_axial * t_burn^2
    // h_coast = v_sep^2 / (2 * g0)
    let h_burn: Float = 0.5 * a_axial * (t_burn * t_burn) * cos(theta_rad);
    let h_coast: Float = ((v_sep * cos(theta_rad)) * (v_sep * cos(theta_rad))) / (2.0 * const_g0());
    let h_total: Float = h_burn + h_coast;

    // Downrange distance gained
    let x_burn: Float = 0.5 * a_lateral * (t_burn * t_burn);
    let x_coast: Float = (v_sep * sin(theta_rad)) * ((v_sep * cos(theta_rad)) / const_g0());
    let x_total: Float = x_burn + x_coast;

    // Clearance distance at t = 1.0 second
    let d_1s: Float = 0.5 * a_thrust * (1.0 * 1.0);

    let safe_chutes: Bool = h_total >= 1200.0; // Minimum 1.2 km altitude for main chute deployment

    return AbortTrajectoryResult {
        peak_accel_g: a_g,
        separation_velocity_m_s: v_sep,
        altitude_gain_m: h_total,
        downrange_separation_m: x_total,
        clearance_at_1s_m: d_1s,
        can_safely_parachute: safe_chutes,
    };
}
