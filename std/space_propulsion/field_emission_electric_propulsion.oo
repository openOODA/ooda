// # Field Emission Electric Propulsion (FEEP) & Electrospray Physics
//
// Logline: Calculates Taylor cone liquid metal / ionic liquid field evaporation, micro-Newton thrust precision, emitter array extraction, and beam optics.
//
// Setup: Models electrohydrodynamic cone formation, pure ionic regime beam emission, and ultra-high precision drag compensation.
//
// Beats:
//   1. Define emitter crown/porous tip radius, extraction voltage, surface tension, and liquid density.
//   2. Compute Taylor cone onset voltage and electric field at needle apex.
//   3. Calculate emitted ion current, micro-Newton thrust, beam divergence loss, and specific impulse.

import "./space_propulsion_constants.oo";

pub type FeepEmitterSpec = struct {
    num_emitters: Int,
    extraction_voltage_v: Float, // e.g. 5000 V to 10000 V
    tip_radius_um: Float, // e.g. 5.0 microns
    liquid_surface_tension_n_m: Float, // e.g. 0.72 N/m for Indium / Gallium
    ion_mass_amu: Float, // 114.82 for Indium
    emitter_spacing_m: Float,
};

pub type FeepPerformance = struct {
    onset_voltage_v: Float,
    thrust_micro_newtons: Float,
    specific_impulse_s: Float,
    emitter_current_u_a: Float,
    electrical_power_w: Float,
};

pub fn feep_spec_default_indium() -> FeepEmitterSpec {
    return FeepEmitterSpec {
        num_emitters: 28, // crown emitter with 28 needles
        extraction_voltage_v: 6500.0,
        tip_radius_um: 6.0,
        liquid_surface_tension_n_m: 0.56,
        ion_mass_amu: 114.82,
        emitter_spacing_m: 0.001,
    };
}

pub fn feep_compute_performance(spec: FeepEmitterSpec) -> FeepPerformance {
    let n_emit: Float = (spec).num_emitters + 0.0;
    let v_ext: Float = (spec).extraction_voltage_v;
    let r_tip_m: Float = (spec).tip_radius_um * 0.000001;
    let gamma_st: Float = (spec).liquid_surface_tension_n_m;
    let d_gap: Float = (spec).emitter_spacing_m;
    let amu: Float = (spec).ion_mass_amu;

    let eps_0: Float = 0.0000000000088541878128;
    let q_e: Float = 0.0000000000000000001602176634;
    let m_ion: Float = amu * 0.000000000000000000000000001660539;

    // Taylor cone onset voltage: V_on = sqrt( (gamma * r_tip) / (2 * eps_0) ) * ln(4 * d / r_tip)
    let term_v: Float = sqrt((gamma_st * r_tip_m) / (2.0 * eps_0));
    let v_onset: Float = term_v * math_ln((4.0 * d_gap) / r_tip_m);

    // Current per needle above onset: I = G * (V - V_on)
    let mut i_per_needle_ua: Float = 0.0;
    if v_ext > v_onset {
        let dv: Float = v_ext - v_onset;
        i_per_needle_ua = 0.08 * dv; // approx 80 nA / V
    }
    let i_total_ua: Float = i_per_needle_ua * n_emit;
    let i_total_amps: Float = i_total_ua * 0.000001;

    // Ion exhaust velocity: v_ex = sqrt(2 * q * V / m)
    let v_ex: Float = sqrt((2.0 * q_e * v_ext) / m_ion);

    // Thrust: F = gamma_div * I * sqrt(2 * m * V / q)
    let gamma_div: Float = 0.96;
    let thrust_n: Float = gamma_div * i_total_amps * sqrt((2.0 * m_ion * v_ext) / q_e);
    let thrust_u_n: Float = thrust_n * 1000000.0;

    let m_dot_kg_s: Float = (i_total_amps * m_ion) / q_e;
    let isp: Float = thrust_n / (m_dot_kg_s * const_g0() + 0.00000000001);
    let p_elec: Float = i_total_amps * v_ext;

    return FeepPerformance {
        onset_voltage_v: v_onset,
        thrust_micro_newtons: thrust_u_n,
        specific_impulse_s: isp,
        emitter_current_u_a: i_total_ua,
        electrical_power_w: p_elec,
    };
}
