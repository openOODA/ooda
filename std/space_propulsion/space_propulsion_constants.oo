// # Fundamental Space Propulsion Constants & Orbital Parameters
//
// Logline: Defines standard astrophysical constants, propulsion gas parameters, planetary bodies, and mathematical functions.
//
// Setup: Core constants and pure numerical functions for deep space propulsion, rocket engine design, and orbital trajectory analysis.
//
// Beats:
//   1. Define universal physical constants (c, g0, Ru, G, sigma, solar flux, AU).
//   2. Define planetary gravitational parameters (mu), radii, and SOI distances.
//   3. Implement comprehensive math helpers (ln, exp, pow, trigonometry, hyperbolic, Stumpff) and 3D vector math.

pub type Vector3D = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vector3D {
    return Vector3D { x: x, y: y, z: z };
}

pub fn vec3_add(a: Vector3D, b: Vector3D) -> Vector3D {
    return Vector3D { x: (a).x + (b).x, y: (a).y + (b).y, z: (a).z + (b).z };
}

pub fn vec3_sub(a: Vector3D, b: Vector3D) -> Vector3D {
    return Vector3D { x: (a).x - (b).x, y: (a).y - (b).y, z: (a).z - (b).z };
}

pub fn vec3_scale(v: Vector3D, s: Float) -> Vector3D {
    return Vector3D { x: (v).x * s, y: (v).y * s, z: (v).z * s };
}

pub fn vec3_dot(a: Vector3D, b: Vector3D) -> Float {
    return ((a).x * (b).x) + ((a).y * (b).y) + ((a).z * (b).z);
}

pub fn vec3_cross(a: Vector3D, b: Vector3D) -> Vector3D {
    return Vector3D {
        x: ((a).y * (b).z) - ((a).z * (b).y),
        y: ((a).z * (b).x) - ((a).x * (b).z),
        z: ((a).x * (b).y) - ((a).y * (b).x),
    };
}

pub fn vec3_norm(v: Vector3D) -> Float {
    return sqrt(vec3_dot(v, v));
}

pub fn vec3_normalize(v: Vector3D) -> Vector3D {
    let n: Float = vec3_norm(v);
    if n <= 0.0000000001 { return Vector3D { x: 0.0, y: 0.0, z: 0.0 }; }
    return vec3_scale(v, 1.0 / n);
}

pub fn const_pi() -> Float { return 3.141592653589793; }
pub fn const_two_pi() -> Float { return 6.283185307179586; }
pub fn const_deg_to_rad() -> Float { return 0.017453292519943295; }
pub fn const_rad_to_deg() -> Float { return 57.29577951308232; }
pub fn const_c() -> Float { return 299792458.0; }
pub fn const_g0() -> Float { return 9.80665; }
pub fn const_r_univ() -> Float { return 8314.462618; }
pub fn const_solar_flux_1au() -> Float { return 1361.0; }
pub fn const_au() -> Float { return 149597870700.0; }

pub fn const_mu_earth() -> Float { return 398600441800000.0; }
pub fn const_radius_earth() -> Float { return 6378137.0; }
pub fn const_mu_moon() -> Float { return 4902800066000.0; }
pub fn const_radius_moon() -> Float { return 1737400.0; }
pub fn const_mu_sun() -> Float { return 132712440018000000000.0; }
pub fn const_mu_mars() -> Float { return 42828375214000.0; }
pub fn const_radius_mars() -> Float { return 3389500.0; }
pub fn const_mu_venus() -> Float { return 324859000000000.0; }
pub fn const_radius_venus() -> Float { return 6051800.0; }

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x; }
    return x;
}

pub fn math_min(a: Float, b: Float) -> Float {
    if a < b { return a; }
    return b;
}

pub fn math_max(a: Float, b: Float) -> Float {
    if a > b { return a; }
    return b;
}

pub fn math_clamp(v: Float, lo: Float, hi: Float) -> Float {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn math_atan_unit(z: Float) -> Float {
    let z2: Float = z * z;
    let poly: Float = z2 * (0.3333333333333333 - (z2 * (0.2 - (z2 * (0.14285714285714285 - (z2 * 0.1111111111111111))))));
    return z * (1.0 - poly);
}

pub fn math_atan(z: Float) -> Float {
    let abs_z: Float = math_abs(z);
    if abs_z <= 1.0 {
        let res: Float = math_atan_unit(abs_z);
        if z < 0.0 { return 0.0 - res; }
        return res;
    }
    let half_pi: Float = const_pi() / 2.0;
    let res: Float = half_pi - math_atan_unit(1.0 / abs_z);
    if z < 0.0 { return 0.0 - res; }
    return res;
}

pub fn math_atan2(y: Float, x: Float) -> Float {
    let pi_val: Float = const_pi();
    if x > 0.0 { return math_atan(y / x); }
    if x < 0.0 {
        if y >= 0.0 { return math_atan(y / x) + pi_val; }
        return math_atan(y / x) - pi_val;
    }
    if y > 0.0 { return pi_val / 2.0; }
    if y < 0.0 { return 0.0 - (pi_val / 2.0); }
    return 0.0;
}

pub fn math_acos(x: Float) -> Float {
    let clamped: Float = math_clamp(x, 0.0 - 1.0, 1.0);
    let s: Float = sqrt(1.0 - (clamped * clamped));
    return math_atan2(s, clamped);
}

pub fn math_asin(x: Float) -> Float {
    let clamped: Float = math_clamp(x, 0.0 - 1.0, 1.0);
    let c: Float = sqrt(1.0 - (clamped * clamped));
    return math_atan2(clamped, c);
}

fn ln_series(y: Float) -> Float {
    let y2: Float = y * y;
    let term: Float = y * (1.0 + (y2 * (0.3333333333333333 + (y2 * (0.2 + (y2 * 0.14285714285714285))))));
    return 2.0 * term;
}

pub fn math_ln(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut val: Float = x;
    let mut k: Float = 0.0;
    while val > 2.0 {
        val = val / 2.718281828459045;
        k = k + 1.0;
    }
    while val < 0.5 {
        val = val * 2.718281828459045;
        k = k - 1.0;
    }
    let y: Float = (val - 1.0) / (val + 1.0);
    return ln_series(y) + (k * 0.9999999999999999);
}

pub fn math_exp(x: Float) -> Float {
    let mut sum: Float = 1.0;
    let mut term: Float = 1.0;
    let mut i: Float = 1.0;
    while i <= 14.0 {
        term = term * (x / i);
        sum = sum + term;
        i = i + 1.0;
    }
    return sum;
}

pub fn math_pow(base: Float, exponent: Float) -> Float {
    if base <= 0.0 { return 0.0; }
    return math_exp(exponent * math_ln(base));
}

pub fn math_sinh(x: Float) -> Float {
    return (math_exp(x) - math_exp(0.0 - x)) * 0.5;
}

pub fn math_cosh(x: Float) -> Float {
    return (math_exp(x) + math_exp(0.0 - x)) * 0.5;
}

pub fn math_tanh(x: Float) -> Float {
    let ep: Float = math_exp(x);
    let em: Float = math_exp(0.0 - x);
    return (ep - em) / (ep + em);
}

pub fn stumpff_c(z: Float) -> Float {
    if z > 0.0001 {
        let sz: Float = sqrt(z);
        return (1.0 - cos(sz)) / z;
    }
    if z < 0.0 - 0.0001 {
        let sz: Float = sqrt(0.0 - z);
        return (math_cosh(sz) - 1.0) / (0.0 - z);
    }
    return 0.5 - (z / 24.0) + ((z * z) / 720.0);
}

pub fn stumpff_s(z: Float) -> Float {
    if z > 0.0001 {
        let sz: Float = sqrt(z);
        return (sz - sin(sz)) / (sz * z);
    }
    if z < 0.0 - 0.0001 {
        let sz: Float = sqrt(0.0 - z);
        return (math_sinh(sz) - sz) / (sz * (0.0 - z));
    }
    return (1.0 / 6.0) - (z / 120.0) + ((z * z) / 5040.0);
}
