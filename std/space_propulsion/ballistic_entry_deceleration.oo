// # Ballistic Atmospheric Entry & Allen-Eggers Deceleration Profile
//
// Logline: Calculates steep ballistic atmospheric entry Allen-Eggers analytical deceleration profile, maximum deceleration point, and terminal impact velocity.
//
// Setup: Implements classical Allen-Eggers analytical closed-form solution for zero-lift ballistic missile and meteorite planetary entry.
//
// Beats:
//   1. Define entry velocity, entry flight path angle (gamma_E), ballistic coefficient (m / Cd*A), and scale height.
//   2. Compute maximum deceleration magnitude (independent of ballistic coefficient) and altitude of peak g-force.
//   3. Calculate velocity at maximum deceleration (v_peak = V_E / sqrt(e)) and low-altitude terminal subsonic impact velocity.

import "./space_propulsion_constants.oo";

pub type BallisticEntrySpec = struct {
    entry_velocity_m_s: Float, // e.g. 7000 m/s
    entry_gamma_deg: Float, // steep angle e.g. -20.0 deg to -45.0 deg
    ballistic_coeff_kg_m2: Float, // m / (Cd * A) e.g. 500 to 2000 kg/m2
    atmosphere_scale_height_m: Float, // H ~ 7200 m (Earth)
    sea_level_density_kg_m3: Float // rho0 = 1.225 kg/m3
};

pub type AllenEggersResult = struct {
    max_deceleration_g: Float,
    altitude_of_max_decel_m: Float,
    velocity_at_max_decel_m_s: Float,
    density_at_max_decel_kg_m3: Float,
    terminal_impact_velocity_m_s: Float
};

pub fn ballistic_entry_spec_default() -> BallisticEntrySpec {
    return BallisticEntrySpec {
        entry_velocity_m_s: 7200.0,
        entry_gamma_deg: 0.0 - 25.0, // -25 deg steep entry
        ballistic_coeff_kg_m2: 850.0, // High ballistic coefficient warhead/probe
        atmosphere_scale_height_m: 7200.0,
        sea_level_density_kg_m3: 1.225
    };
}

pub fn ballistic_compute_allen_eggers(spec: BallisticEntrySpec) -> AllenEggersResult {
    let v_e: Float = (spec).entry_velocity_m_s;
    let gamma_deg: Float = (spec).entry_gamma_deg;
    let sin_gamma: Float = math_abs(sin(gamma_deg * const_deg_to_rad()));
    let bc: Float = (spec).ballistic_coeff_kg_m2;
    let h_scale: Float = (spec).atmosphere_scale_height_m;
    let rho0: Float = (spec).sea_level_density_kg_m3;

    // Allen-Eggers Theorem 1: Maximum deceleration is independent of ballistic coefficient!
    // (-v_dot)_max = (V_E^2 * sin(gamma_E)) / (2 * e * H)
    // where e = 2.718281828459045
    let e_const: Float = 2.718281828459045;
    let a_max_m_s2: Float = (v_e * v_e * sin_gamma) / (2.0 * e_const * h_scale);
    let g_max: Float = a_max_m_s2 / const_g0();

    // Allen-Eggers Theorem 2: Velocity at maximum deceleration is always V_E / sqrt(e) ~ 0.6065 * V_E
    let v_at_max_g: Float = v_e / sqrt(e_const);

    // Allen-Eggers Theorem 3: Density at max deceleration is rho_max = (BC * sin(gamma_E)) / H
    let rho_at_max_g: Float = (bc * sin_gamma) / h_scale;

    // Altitude of max deceleration: h_max = H * ln(rho0 / rho_max)
    let mut h_at_max_g: Float = 0.0;
    if rho_at_max_g > 0.0 && rho_at_max_g < rho0 {
        h_at_max_g = h_scale * math_ln(rho0 / rho_at_max_g);
    }

    // Terminal velocity at sea level: v_term = sqrt( (2 * g0 * BC) / rho0 )
    let v_term: Float = sqrt((2.0 * const_g0() * bc) / rho0);

    return AllenEggersResult {
        max_deceleration_g: g_max,
        altitude_of_max_decel_m: h_at_max_g,
        velocity_at_max_decel_m_s: v_at_max_g,
        density_at_max_decel_kg_m3: rho_at_max_g,
        terminal_impact_velocity_m_s: v_term
    };
}
