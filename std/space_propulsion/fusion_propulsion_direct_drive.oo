// # Direct Drive Fusion Propulsion & Magnetic Nozzle Acceleration
//
// Logline: Evaluates direct fusion drive (DFD) aneutronic D-He3 magnetic mirror confinement, fusion alpha particle heating, magnetic nozzle thrust, and 100,000s Isp.
//
// Setup: Solves field-reversed configuration (FRC) plasma equilibrium, charged fusion product energy transfer, and magnetic nozzle thrust conversion.
//
// Beats:
//   1. Define fusion fuel mix (D-He3 / D-T), plasma ion temperature (50-100 keV), and magnetic field confinement.
//   2. Compute fusion reaction rate, charged particle power fraction, and cool propellant (H2) scrape-off-layer heating.
//   3. Calculate magnetic nozzle plasma detachment velocity, variable Isp scaling (10,000s - 100,000s), and thrust.

import "./space_propulsion_constants.oo";

pub type DirectFusionSpec = struct {
    fusion_fuel_type: Int, // 1: D-He3 (aneutronic), 2: D-T
    fusion_power_mw: Float, // e.g. 10 MW to 50 MW
    charged_power_fraction: Float, // 0.85 for D-He3, 0.20 for D-T
    hydrogen_dilution_mass_flow_g_s: Float, // scrape-off-layer flow
    magnetic_throat_tesla: Float, // e.g. 5.0 T superconducting coil
    magnetic_expansion_ratio: Float // e.g. 50
};

pub type DirectFusionPerformance = struct {
    charged_jet_power_mw: Float,
    exhaust_velocity_km_s: Float,
    thrust_n: Float,
    specific_impulse_s: Float,
    thrust_power_efficiency: Float
};

pub fn direct_fusion_spec_default_d_he3() -> DirectFusionSpec {
    return DirectFusionSpec {
        fusion_fuel_type: 1, // D-He3
        fusion_power_mw: 20.0, // 20 MW fusion output
        charged_power_fraction: 0.85,
        hydrogen_dilution_mass_flow_g_s: 0.80, // 0.8 g/s added for thrust tuning
        magnetic_throat_tesla: 6.0,
        magnetic_expansion_ratio: 40.0
    };
}

pub fn direct_fusion_compute_performance(spec: DirectFusionSpec) -> DirectFusionPerformance {
    let p_fus: Float = (spec).fusion_power_mw;
    let f_charged: Float = (spec).charged_power_fraction;
    let m_dot_g: Float = (spec).hydrogen_dilution_mass_flow_g_s;
    let m_dot_kg_s: Float = (m_dot_g * 0.001) + 0.000001; // total flow including fusion ashes

    // Charged particle jet power: P_jet = eta_nozzle * f_charged * P_fus
    let eta_nozzle: Float = 0.80; // magnetic nozzle expansion efficiency
    let p_charged_mw: Float = p_fus * f_charged;
    let p_jet_mw: Float = p_charged_mw * eta_nozzle;
    let p_jet_w: Float = p_jet_mw * 1000000.0;

    // Directed exhaust velocity: v_ex = sqrt(2 * P_jet / m_dot)
    let v_ex_m_s: Float = sqrt((2.0 * p_jet_w) / m_dot_kg_s);
    let v_ex_km_s: Float = v_ex_m_s / 1000.0;

    // Thrust: F = m_dot * v_ex
    let thrust_n: Float = m_dot_kg_s * v_ex_m_s;
    let isp: Float = v_ex_m_s / const_g0();

    return DirectFusionPerformance {
        charged_jet_power_mw: p_jet_mw,
        exhaust_velocity_km_s: v_ex_km_s,
        thrust_n: thrust_n,
        specific_impulse_s: isp,
        thrust_power_efficiency: eta_nozzle
    };
}
