// # Rocket Turbopump Power Balance & Engine Cycles
//
// Logline: Evaluates power balance for gas-generator, staged-combustion, and expander cycle rocket engines, pump head rise, and turbine enthalpy.
//
// Setup: Solves shaft power equilibrium between centrifugal propellant pumps and drive turbines.
//
// Beats:
//   1. Define pump suction/discharge pressures, propellant densities, and hydraulic efficiencies.
//   2. Compute required pump shaft power for oxidizer and fuel circuits.
//   3. Solve turbine drive gas mass flow, expansion pressure ratio, and overall engine cycle efficiency.

import "./space_propulsion_constants.oo";

pub type TurbopumpSpec = struct {
    cycle_type: Int, // 1: Gas Generator, 2: Full-Flow Staged Combustion, 3: Expander
    p_tank_ox_bar: Float,
    p_tank_fuel_bar: Float,
    p_chamber_bar: Float,
    p_injector_loss_factor: Float, // e.g. 1.25x chamber pressure
    eta_pump_ox: Float,
    eta_pump_fuel: Float,
    eta_turbine: Float
};

pub type TurbopumpPowerBalance = struct {
    p_pump_ox_bar: Float,
    p_pump_fuel_bar: Float,
    power_pump_ox_kw: Float,
    power_pump_fuel_kw: Float,
    total_shaft_power_kw: Float,
    turbine_mass_flow_fraction: Float
};

pub fn turbopump_spec_default_ffsc() -> TurbopumpSpec {
    return TurbopumpSpec {
        cycle_type: 2, // Full-flow staged combustion (Raptor-style)
        p_tank_ox_bar: 3.5,
        p_tank_fuel_bar: 3.5,
        p_chamber_bar: 300.0,
        p_injector_loss_factor: 1.30,
        eta_pump_ox: 0.78,
        eta_pump_fuel: 0.76,
        eta_turbine: 0.82
    };
}

pub fn turbopump_compute_power(
    spec: TurbopumpSpec,
    m_dot_ox_kg_s: Float,
    m_dot_fuel_kg_s: Float,
    rho_ox_kg_m3: Float,
    rho_fuel_kg_m3: Float
) -> TurbopumpPowerBalance {
    let pc: Float = (spec).p_chamber_bar;
    let factor: Float = (spec).p_injector_loss_factor;

    // Pump discharge pressure needed
    let p_disch_ox: Float = pc * factor;
    let p_disch_f: Float = pc * factor;

    let dp_ox_pa: Float = (p_disch_ox - (spec).p_tank_ox_bar) * 100000.0;
    let dp_f_pa: Float = (p_disch_f - (spec).p_tank_fuel_bar) * 100000.0;

    // Pump power: W_dot = (m_dot * Delta_P) / (rho * eta_pump)
    let pwr_ox_w: Float = (m_dot_ox_kg_s * dp_ox_pa) / (rho_ox_kg_m3 * (spec).eta_pump_ox);
    let pwr_f_w: Float = (m_dot_fuel_kg_s * dp_f_pa) / (rho_fuel_kg_m3 * (spec).eta_pump_fuel);

    let pwr_ox_kw: Float = pwr_ox_w / 1000.0;
    let pwr_f_kw: Float = pwr_f_w / 1000.0;
    let total_pwr_kw: Float = pwr_ox_kw + pwr_f_kw;

    // Turbine mass flow fraction estimate
    let mut f_turb: Float = 0.025; // typical 2.5% for GG cycle
    if (spec).cycle_type == 2 {
        f_turb = 1.0; // 100% full-flow through preburners
    } else if (spec).cycle_type == 3 {
        f_turb = 1.0; // 100% fuel through expander channels
    }

    return TurbopumpPowerBalance {
        p_pump_ox_bar: p_disch_ox,
        p_pump_fuel_bar: p_disch_f,
        power_pump_ox_kw: pwr_ox_kw,
        power_pump_fuel_kw: pwr_f_kw,
        total_shaft_power_kw: total_pwr_kw,
        turbine_mass_flow_fraction: f_turb
    };
}
