// # Pulsed Plasma Thruster (PPT) LCR Discharge & Lorentz Impulse
//
// Logline: Models Pulsed Plasma Thruster (PPT) PTFE solid propellant ablation, capacitor bank LCR discharge, and Lorentz body force acceleration.
//
// Setup: Solves unsteady pulsed electromagnetic discharge, peak discharge current, impulse bit, and specific impulse for CubeSats.
//
// Beats:
//   1. Define pulse-forming network parameters (capacitance, voltage, inductance, circuit resistance).
//   2. Compute resonant LCR discharge peak current and pulse half-period duration.
//   3. Calculate magnetic Lorentz force impulse bit, ablated Teflon mass per shot, and specific impulse.

import "./space_propulsion_constants.oo";

pub type PptCircuitSpec = struct {
    capacitance_uf: Float, // e.g. 5.0 uF
    charge_voltage_v: Float, // e.g. 1800 V
    inductance_nh: Float, // e.g. 80 nH
    resistance_mohm: Float, // e.g. 35 mOhm
    electrode_spacing_m: Float, // e.g. 0.025 m (2.5 cm)
    electrode_width_m: Float,
};

pub type PptPulsePerformance = struct {
    stored_energy_joules: Float,
    peak_current_ka: Float,
    pulse_duration_us: Float,
    impulse_bit_u_ns: Float, // micro-Newton-seconds
    mass_per_shot_ug: Float, // micro-grams Teflon ablated
    specific_impulse_s: Float,
};

pub fn ppt_circuit_spec_default() -> PptCircuitSpec {
    return PptCircuitSpec {
        capacitance_uf: 4.0,
        charge_voltage_v: 2000.0,
        inductance_nh: 60.0,
        resistance_mohm: 40.0,
        electrode_spacing_m: 0.02,
        electrode_width_m: 0.02,
    };
}

pub fn ppt_compute_pulse(spec: PptCircuitSpec) -> PptPulsePerformance {
    let c_farads: Float = (spec).capacitance_uf * 0.000001;
    let v0: Float = (spec).charge_voltage_v;
    let l_henry: Float = (spec).inductance_nh * 0.000000001;
    let r_ohm: Float = (spec).resistance_mohm * 0.001;
    let h_elec: Float = (spec).electrode_spacing_m;
    let w_elec: Float = (spec).electrode_width_m;

    // Stored electrostatic energy: E = 0.5 * C * V^2
    let energy_j: Float = 0.5 * c_farads * (v0 * v0);

    // Natural frequency and characteristic impedance: Z0 = sqrt(L / C)
    let z0: Float = sqrt(l_henry / c_farads);
    let peak_i: Float = v0 / (z0 + r_ohm); // peak current approx Amps
    let peak_i_ka: Float = peak_i / 1000.0;

    // Pulse duration approx half-period: tau = pi * sqrt(L * C)
    let tau_s: Float = const_pi() * sqrt(l_henry * c_farads);
    let tau_us: Float = tau_s * 1000000.0;

    // Inductance gradient along rail: L' ~ mu_0 * (h / w)
    let mu_0: Float = 0.0000012566370614359173; // N/A^2
    let l_prime: Float = mu_0 * (h_elec / (w_elec + 0.00001));

    // Electromagnetic impulse bit: I_em = 0.5 * L' * integral(I^2 dt) ~ 0.5 * L' * (0.5 * I_peak^2 * tau)
    let i_sq_integral: Float = 0.5 * (peak_i * peak_i) * tau_s;
    let impulse_em_ns: Float = 0.5 * l_prime * i_sq_integral;

    // Gasdynamic thermal ablation impulse contribution (~30% of EM impulse)
    let impulse_total_ns: Float = impulse_em_ns * 1.30;
    let impulse_u_ns: Float = impulse_total_ns * 1000000.0;

    // Teflon mass ablated per shot ~ 8 to 20 ug/J of energy
    let mass_ug: Float = 12.0 * energy_j;
    let mass_kg: Float = mass_ug * 0.000000001;

    // Specific impulse: Isp = I_total / (m_shot * g0)
    let isp: Float = impulse_total_ns / (mass_kg * const_g0());

    return PptPulsePerformance {
        stored_energy_joules: energy_j,
        peak_current_ka: peak_i_ka,
        pulse_duration_us: tau_us,
        impulse_bit_u_ns: impulse_u_ns,
        mass_per_shot_ug: mass_ug,
        specific_impulse_s: isp,
    };
}
