// # Multi-Revolution Lambert Orbital Boundary Value Solver
//
// Logline: Solves multi-revolution Lambert boundary value problems, N-rev orbital transfer branches, and minimum delta-V selection.
//
// Setup: Solves multiple complete revolutions (N >= 1) between planetary bodies for long-duration resonant orbital phasing transfers.
//
// Beats:
//   1. Define initial and final orbital radii, transfer angle, and target revolution count (N = 0, 1, 2).
//   2. Compute Battin multi-rev time-of-flight curve, left and right branch solutions, and minimum energy threshold.
//   3. Select optimal multi-rev trajectory branch minimizing total departure and arrival delta-V.

import "./space_propulsion_constants.oo";

pub type MultiRevLambertSpec = struct {
    r1_mag_m: Float,
    r2_mag_m: Float,
    transfer_angle_rad: Float,
    time_of_flight_s: Float,
    num_revolutions: Int, // N = 0 (direct), N = 1 (1-rev), etc.
    mu: Float,
};

pub type MultiRevBranchSolution = struct {
    num_revolutions: Int,
    semi_major_axis_m: Float,
    departure_velocity_m_s: Float,
    arrival_velocity_m_s: Float,
    total_delta_v_m_s: Float,
    solution_exists: Bool,
};

pub fn multi_rev_spec_default_earth_mars_1rev() -> MultiRevLambertSpec {
    return MultiRevLambertSpec {
        r1_mag_m: const_au(), // 1 AU
        r2_mag_m: 1.524 * const_au(), // 1.524 AU
        transfer_angle_rad: 3.80, // ~218 degrees
        time_of_flight_s: 48000000.0, // ~555 days (1-rev transfer)
        num_revolutions: 1,
        mu: const_mu_sun(),
    };
}

pub fn lambert_solve_multi_rev(spec: MultiRevLambertSpec) -> MultiRevBranchSolution {
    let r1: Float = (spec).r1_mag_m;
    let r2: Float = (spec).r2_mag_m;
    let d_nu: Float = (spec).transfer_angle_rad;
    let dt: Float = (spec).time_of_flight_s;
    let n_rev: Int = (spec).num_revolutions;
    let mu: Float = (spec).mu;

    // Chord length: c = sqrt(r1^2 + r2^2 - 2*r1*r2*cos(d_nu))
    let c_chord: Float = sqrt((r1 * r1) + (r2 * r2) - (2.0 * r1 * r2 * cos(d_nu)));
    // Semi-perimeter: s = (r1 + r2 + c) / 2
    let s_semi: Float = (r1 + r2 + c_chord) * 0.5;

    // Minimum energy ellipse semi-major axis: a_min = s / 2
    let a_min: Float = s_semi * 0.5;

    // Minimum time of flight for N revolutions: T_min_rev = 2*pi * N * sqrt(a_min^3 / mu)
    let t_period_min: Float = const_two_pi() * sqrt((a_min * a_min * a_min) / mu);
    let t_min_n_rev: Float = (n_rev + 0.0) * t_period_min;

    let mut exists: Bool = true;
    if n_rev > 0 && dt < t_min_n_rev {
        exists = false; // no solution for this time of flight on N-rev branch
    }

    // Estimate semi-major axis for target flight time
    // For N-revs: a ~ (mu * (dt / (2*pi*(N + 0.5)))^2 )^(1/3)
    let n_eff: Float = (n_rev + 0.0) + (d_nu / const_two_pi());
    let mean_motion: Float = const_two_pi() * n_eff / dt;
    let a_est: Float = math_pow(mu / (mean_motion * mean_motion), 0.3333333333333333);

    // Orbital velocities at r1 and r2 on transfer ellipse:
    // v1 = sqrt(mu * (2/r1 - 1/a))
    // v2 = sqrt(mu * (2/r2 - 1/a))
    let v1: Float = sqrt(math_max(100.0, mu * ((2.0 / r1) - (1.0 / a_est))));
    let v2: Float = sqrt(math_max(100.0, mu * ((2.0 / r2) - (1.0 / a_est))));

    // Planetary circular velocities
    let v_circ1: Float = sqrt(mu / r1);
    let v_circ2: Float = sqrt(mu / r2);

    let dv1: Float = math_abs(v1 - v_circ1);
    let dv2: Float = math_abs(v2 - v_circ2);
    let dv_tot: Float = dv1 + dv2;

    return MultiRevBranchSolution {
        num_revolutions: n_rev,
        semi_major_axis_m: a_est,
        departure_velocity_m_s: v1,
        arrival_velocity_m_s: v2,
        total_delta_v_m_s: dv_tot,
        solution_exists: exists,
    };
}
