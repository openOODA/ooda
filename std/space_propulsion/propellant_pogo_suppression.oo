// # Propulsion Pogo Oscillation Stability & Gas Accumulator Sizing
//
// Logline: Evaluates structural-propulsion coupled Pogo oscillation stability, turbopump inducer cavitation compliance, and gas accumulator tuning.
//
// Setup: Solves closed-loop stability of vehicle longitudinal vibration coupled with propulsion suction feed line flow pulsations.
//
// Beats:
//   1. Define vehicle longitudinal structural frequency, propellant suction duct inertance, and engine gain.
//   2. Compute inducer cavitation bubble compliance and open-loop Pogo transfer function gain margin.
//   3. Size gaseous nitrogen/helium Pogo accumulator volume and resonance notch frequency to suppress instability.

import "./space_propulsion_constants.oo";

pub type PogoSystemSpec = struct {
    structural_frequency_hz: Float, // e.g. 18.0 Hz (1st longitudinal vehicle mode)
    suction_duct_length_m: Float,
    suction_duct_area_m2: Float,
    propellant_density_kg_m3: Float,
    inducer_cavitation_compliance_m4_n: Float, // e.g. 2e-8 m^4/N
    engine_thrust_gain_factor: Float, // Delta_F / Delta_P_suction
    accumulator_gas_volume_liters: Float, // e.g. 15.0 L
    accumulator_gas_pressure_bar: Float,
};

pub type PogoStabilityResult = struct {
    propellant_line_inertance_kg_m4: Float,
    feedline_natural_frequency_hz: Float,
    accumulator_compliance_m4_n: Float,
    tuned_notch_frequency_hz: Float,
    pogo_stability_margin_db: Float,
    is_pogo_stable: Bool,
};

pub fn pogo_spec_default() -> PogoSystemSpec {
    return PogoSystemSpec {
        structural_frequency_hz: 16.5,
        suction_duct_length_m: 14.0,
        suction_duct_area_m2: 0.045,
        propellant_density_kg_m3: 1140.0,
        inducer_cavitation_compliance_m4_n: 0.000000025,
        engine_thrust_gain_factor: 120.0,
        accumulator_gas_volume_liters: 22.0,
        accumulator_gas_pressure_bar: 4.5,
    };
}

pub fn pogo_evaluate_stability(spec: PogoSystemSpec) -> PogoStabilityResult {
    let f_struct: Float = (spec).structural_frequency_hz;
    let l_duct: Float = (spec).suction_duct_length_m;
    let a_duct: Float = (spec).suction_duct_area_m2;
    let rho: Float = (spec).propellant_density_kg_m3;
    let c_cav: Float = (spec).inducer_cavitation_compliance_m4_n;
    let v_acc_l: Float = (spec).accumulator_gas_volume_liters;
    let p_acc_bar: Float = (spec).accumulator_gas_pressure_bar;
    let p_acc_pa: Float = p_acc_bar * 100000.0;

    // Acoustic inertance of liquid column: L_fluid = rho * L / A (kg / m^4)
    let inertance: Float = (rho * l_duct) / a_duct;

    // Feedline unmitigated hydraulic natural frequency: f_hyd = 1 / (2*pi * sqrt(L_fluid * C_cav))
    let f_hyd: Float = 1.0 / (2.0 * const_pi() * sqrt(inertance * c_cav + 0.00000000001));

    // Gas accumulator compliance: C_acc = V_gas / (gamma * P_gas)
    let v_gas_m3: Float = v_acc_l * 0.001;
    let gamma_gas: Float = 1.40;
    let c_acc: Float = v_gas_m3 / (gamma_gas * p_acc_pa);

    // Total compliance with suppressor: C_total = C_cav + C_acc
    let c_total: Float = c_cav + c_acc;
    let f_tuned: Float = 1.0 / (2.0 * const_pi() * sqrt(inertance * c_total));

    // Frequency separation margin: Delta_f = |f_tuned - f_struct|
    let df: Float = math_abs(f_tuned - f_struct);
    let margin_db: Float = 20.0 * (df / f_struct);

    // Stable if suppressed notch frequency is well separated (>30% shift) or damping high
    let stable: Bool = df >= 4.0;

    return PogoStabilityResult {
        propellant_line_inertance_kg_m4: inertance,
        feedline_natural_frequency_hz: f_hyd,
        accumulator_compliance_m4_n: c_acc,
        tuned_notch_frequency_hz: f_tuned,
        pogo_stability_margin_db: margin_db,
        is_pogo_stable: stable,
    };
}
