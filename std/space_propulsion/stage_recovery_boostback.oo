// # Reusable Booster Stage Recovery Burns & Suicide Landing
//
// Logline: Models reusable first stage boostback burn, re-entry deceleration burn, aerodynamic grid fin angle-of-attack guidance, and landing suicide burn.
//
// Setup: Calculates propellant delta-V allocation and timing for Return-to-Launch-Site (RTLS) and Autonomous Spaceport Drone Ship (ASDS) recoveries.
//
// Beats:
//   1. Define separation state (velocity, altitude, downrange) and recovery mode (RTLS vs Drone Ship).
//   2. Compute boostback burn delta-V, re-entry aero-heating reduction burn, and atmospheric terminal velocity.
//   3. Calculate final suicide burn ignition altitude, constant thrust deceleration distance, and landing propellant reserve.

import "./space_propulsion_constants.oo";

pub type BoosterRecoverySpec = struct {
    separation_velocity_m_s: Float, // e.g. 1750 m/s at staging
    separation_altitude_m: Float, // e.g. 68000 m
    booster_dry_mass_kg: Float, // e.g. 180000 kg (Super Heavy scale)
    landing_engine_thrust_n: Float, // 1 to 3 engines lit for landing
    landing_engine_isp_s: Float,
    is_rtls_return_to_launch_site: Bool
};

pub type BoosterRecoveryProfile = struct {
    boostback_delta_v_m_s: Float,
    reentry_delta_v_m_s: Float,
    landing_burn_delta_v_m_s: Float,
    total_recovery_delta_v_m_s: Float,
    landing_propellant_reserve_kg: Float,
    suicide_burn_altitude_m: Float
};

pub fn booster_recovery_spec_default() -> BoosterRecoverySpec {
    return BoosterRecoverySpec {
        separation_velocity_m_s: 1650.0,
        separation_altitude_m: 65000.0,
        booster_dry_mass_kg: 200000.0,
        landing_engine_thrust_n: 6600000.0, // 3 center engines lit
        landing_engine_isp_s: 327.0,
        is_rtls_return_to_launch_site: true
    };
}

pub fn recovery_compute_burns(spec: BoosterRecoverySpec) -> BoosterRecoveryProfile {
    let v_sep: Float = (spec).separation_velocity_m_s;
    let m_dry: Float = (spec).booster_dry_mass_kg;
    let t_land: Float = (spec).landing_engine_thrust_n;
    let isp: Float = (spec).landing_engine_isp_s;
    let is_rtls: Bool = (spec).is_rtls_return_to_launch_site;

    let c_eff: Float = isp * const_g0();

    // Boostback burn: cancels downrange velocity and sends trajectory back toward launch pad
    let mut dv_boostback: Float = 0.0;
    if is_rtls {
        dv_boostback = (v_sep * 0.55) + 350.0; // ~1200 m/s
    } else {
        dv_boostback = 0.0; // ASDS downrange barge landing requires no boostback
    }

    // Re-entry burn: decelerates booster from hypersonic (~Mach 5) to supersonic (~Mach 2.5) in upper atmosphere
    let dv_reentry: Float = 450.0;

    // Atmospheric terminal velocity with grid fins deployed ~ 250 - 320 m/s
    let v_terminal: Float = 280.0;

    // Suicide landing burn: decelerates from v_terminal to 0 m/s at touchdown
    let dv_landing: Float = v_terminal + 80.0; // +80 m/s gravity loss

    let dv_total: Float = dv_boostback + dv_reentry + dv_landing;

    // Total recovery propellant reserve needed: m_prop = m_dry * (exp(Delta_V / c) - 1)
    let mass_ratio: Float = math_exp(dv_total / c_eff);
    let m_prop_reserve: Float = m_dry * (mass_ratio - 1.0);

    // Suicide burn ignition altitude: h_ign = v_terminal^2 / (2 * (a_net))
    // a_net = (T_land / m_landing) - g0
    let m_landing_instant: Float = m_dry + (m_prop_reserve * 0.25);
    let a_net: Float = (t_land / m_landing_instant) - const_g0();
    let h_ign: Float = (v_terminal * v_terminal) / (2.0 * a_net + 0.0001);

    return BoosterRecoveryProfile {
        boostback_delta_v_m_s: dv_boostback,
        reentry_delta_v_m_s: dv_reentry,
        landing_burn_delta_v_m_s: dv_landing,
        total_recovery_delta_v_m_s: dv_total,
        landing_propellant_reserve_kg: m_prop_reserve,
        suicide_burn_altitude_m: h_ign
    };
}
