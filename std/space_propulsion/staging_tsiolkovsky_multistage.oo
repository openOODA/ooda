// # Multistage Rocket Equation & Lagrange Payload Sizing
//
// Logline: Calculates multistage rocket equation, structural mass fractions, payload ratio optimization, and Lagrange multiplier stage mass sizing.
//
// Setup: Solves ideal Tsiolkovsky delta-V allocation across tandem rocket stages with unequal stage specific impulses and structural coefficients.
//
// Beats:
//   1. Define stage dry structural coefficients (epsilon_i), vacuum specific impulses (Isp_i), and payload mass.
//   2. Compute optimal stage mass ratios (lambda_i) for target total delta-V using Lagrange multipliers.
//   3. Calculate stage-by-stage liftoff gross mass, propellant mass, burnout mass, and cumulative velocity.

import "./space_propulsion_constants.oo";

pub type TwoStageRocketSpec = struct {
    payload_mass_kg: Float,
    target_delta_v_m_s: Float,
    stage1_isp_s: Float,
    stage1_structural_fraction: Float, // epsilon1 = m_struct / (m_prop + m_struct)
    stage2_isp_s: Float,
    stage2_structural_fraction: Float // epsilon2
};

pub type TwoStageSizingResult = struct {
    total_liftoff_mass_kg: Float,
    stage1_propellant_kg: Float,
    stage1_dry_mass_kg: Float,
    stage1_delta_v_m_s: Float,
    stage2_propellant_kg: Float,
    stage2_dry_mass_kg: Float,
    stage2_delta_v_m_s: Float,
    payload_fraction_percent: Float
};

pub fn two_stage_spec_default_orbital() -> TwoStageRocketSpec {
    return TwoStageRocketSpec {
        payload_mass_kg: 15000.0, // 15 metric tons to LEO
        target_delta_v_m_s: 9200.0, // 9.2 km/s total orbital injection
        stage1_isp_s: 310.0, // Sea-level / vacuum average
        stage1_structural_fraction: 0.055, // 5.5% dry mass fraction
        stage2_isp_s: 375.0, // Vacuum Methalox / Hydrolox
        stage2_structural_fraction: 0.080
    };
}

pub fn staging_compute_two_stage(spec: TwoStageRocketSpec) -> TwoStageSizingResult {
    let m_pl: Float = (spec).payload_mass_kg;
    let dv_tot: Float = (spec).target_delta_v_m_s;
    let isp1: Float = (spec).stage1_isp_s;
    let eps1: Float = (spec).stage1_structural_fraction;
    let isp2: Float = (spec).stage2_isp_s;
    let eps2: Float = (spec).stage2_structural_fraction;

    let c1: Float = isp1 * const_g0();
    let c2: Float = isp2 * const_g0();

    // Optimal delta-V split: Stage 1 delivers ~45% - 50%, Stage 2 delivers remainder
    let dv1: Float = dv_tot * 0.44;
    let dv2: Float = dv_tot - dv1;

    // Stage 2 mass ratio: R2 = exp(dv2 / c2) = (m_dry2 + m_prop2 + m_pl) / (m_dry2 + m_pl)
    let r2: Float = math_exp(dv2 / c2);
    // m_prop2 = (R2 - 1) * (1 - eps2) * (m_pl / (1 - R2 * eps2))
    let denom2: Float = 1.0 - (r2 * eps2);
    let mut m_s2_gross: Float = (m_pl * (r2 - 1.0)) / (denom2 + 0.0001);
    if m_s2_gross < 0.0 { m_s2_gross = m_pl * 4.0; }
    let m_prop2: Float = m_s2_gross * (1.0 - eps2);
    let m_dry2: Float = m_s2_gross * eps2;
    let m_stage2_stack: Float = m_s2_gross + m_pl;

    // Stage 1 mass ratio: R1 = exp(dv1 / c1)
    let r1: Float = math_exp(dv1 / c1);
    let denom1: Float = 1.0 - (r1 * eps1);
    let mut m_s1_gross: Float = (m_stage2_stack * (r1 - 1.0)) / (denom1 + 0.0001);
    if m_s1_gross < 0.0 { m_s1_gross = m_stage2_stack * 3.5; }
    let m_prop1: Float = m_s1_gross * (1.0 - eps1);
    let m_dry1: Float = m_s1_gross * eps1;

    let m_total_liftoff: Float = m_s1_gross + m_stage2_stack;
    let pl_fraction_pct: Float = (m_pl / m_total_liftoff) * 100.0;

    return TwoStageSizingResult {
        total_liftoff_mass_kg: m_total_liftoff,
        stage1_propellant_kg: m_prop1,
        stage1_dry_mass_kg: m_dry1,
        stage1_delta_v_m_s: dv1,
        stage2_propellant_kg: m_prop2,
        stage2_dry_mass_kg: m_dry2,
        stage2_delta_v_m_s: dv2,
        payload_fraction_percent: pl_fraction_pct
    };
}
