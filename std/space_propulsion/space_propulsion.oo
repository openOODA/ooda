pub type SpacePropulsionEngineSystem = struct {
    engine_name_id: Int,
    thrust_vac_n: Float,
    isp_vac_s: Float,
    mass_flow_kg_s: Float,
    chamber_pressure_bar: Float
};

pub fn space_propulsion_engine_default() -> SpacePropulsionEngineSystem {
    return SpacePropulsionEngineSystem {
        engine_name_id: 1, // Raptor
        thrust_vac_n: 2450000.0,
        isp_vac_s: 350.0,
        mass_flow_kg_s: 714.0,
        chamber_pressure_bar: 300.0
    };
}

pub fn space_propulsion_solve_rocket_performance(chamber: RocketChamberState) -> NozzlePerformance {
    return nozzle_compute_performance(chamber);
}

pub fn space_propulsion_solve_ion_performance(spec: GriddedIonSpec) -> GriddedIonPerformance {
    return ion_compute_performance(spec);
}

pub fn space_propulsion_solve_lambert(prob: LambertProblem) -> LambertSolution {
    return lambert_solve_universal(prob);
}

pub fn space_propulsion_solve_aerocapture(spec: MarsAerocaptureSpec) -> AerocaptureCorridorResult {
    return aerocapture_compute_corridor(spec);
}
