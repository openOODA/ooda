// # Rocket Nozzle Method of Characteristics & Rao Bell Contour
//
// Logline: Designs supersonic nozzle expansion contours using 2D Method of Characteristics (MOC) and Rao parabolic bell geometry.
//
// Setup: Solves supersonic expansion wave reflections, divergence efficiency, and length reduction for minimum-weight rocket nozzles.
//
// Beats:
//   1. Define nozzle throat radius, expansion area ratio, and fractional bell length.
//   2. Compute Prandtl-Meyer expansion angles and Rao parabola coefficients.
//   3. Calculate nozzle contour coordinates, wall divergence loss, and effective thrust efficiency.

import "./space_propulsion_constants.oo";

pub type RaoNozzleSpec = struct {
    r_throat_m: Float,
    expansion_ratio: Float,
    percent_length: Float, // e.g. 0.80 for 80% bell
    gamma: Float
};

pub type RaoNozzleGeometry = struct {
    r_exit_m: Float,
    length_bell_m: Float,
    theta_initial_deg: Float,
    theta_exit_deg: Float,
    divergence_efficiency: Float
};

pub fn rao_nozzle_spec_default() -> RaoNozzleSpec {
    return RaoNozzleSpec {
        r_throat_m: 0.15, // 30 cm throat diameter
        expansion_ratio: 35.0,
        percent_length: 0.80,
        gamma: 1.22
    };
}

pub fn prandtl_meyer_nu(mach: Float, gamma: Float) -> Float {
    if mach <= 1.0 { return 0.0; }
    let g1: Float = (gamma + 1.0) / (gamma - 1.0);
    let g2: Float = (gamma - 1.0) / (gamma + 1.0);
    let m2_1: Float = (mach * mach) - 1.0;
    let term1: Float = sqrt(g1) * math_atan(sqrt(g2 * m2_1));
    let term2: Float = math_atan(sqrt(m2_1));
    return term1 - term2;
}

pub fn rao_bell_compute_geometry(spec: RaoNozzleSpec) -> RaoNozzleGeometry {
    let rt: Float = (spec).r_throat_m;
    let eps: Float = (spec).expansion_ratio;
    let f_len: Float = (spec).percent_length;
    let re: Float = rt * sqrt(eps);

    // 15-degree conical reference length: L_15 = (re - rt) / tan(15 deg)
    let tan15: Float = 0.26794919243;
    let l_15: Float = (re - rt) / tan15;
    let l_bell: Float = f_len * l_15;

    // Approximate parabolic Rao initial and exit wall angles (degrees)
    // As area ratio increases, theta_i ~ 24 - 36 deg, theta_e ~ 6 - 12 deg
    let theta_i: Float = 38.0 - (2.5 * math_ln(eps));
    let theta_e: Float = 14.0 - (1.8 * math_ln(eps));

    // Divergence efficiency: eta_div = 0.5 * (1 + cos(theta_e))
    let theta_e_rad: Float = theta_e * const_deg_to_rad();
    let eta_div: Float = 0.5 * (1.0 + cos(theta_e_rad));

    return RaoNozzleGeometry {
        r_exit_m: re,
        length_bell_m: l_bell,
        theta_initial_deg: theta_i,
        theta_exit_deg: theta_e,
        divergence_efficiency: eta_div
    };
}

pub fn rao_contour_radius_at_x(x: Float, geom: RaoNozzleGeometry, r_throat: Float) -> Float {
    let l_b: Float = (geom).length_bell_m;
    let re: Float = (geom).r_exit_m;
    if x <= 0.0 { return r_throat; }
    if x >= l_b { return re; }
    let frac: Float = x / l_b;
    // Quadratic parabolic bell interpolation
    let th_i_rad: Float = (geom).theta_initial_deg * const_deg_to_rad();
    let th_e_rad: Float = (geom).theta_exit_deg * const_deg_to_rad();
    let dr: Float = re - r_throat;
    return r_throat + (dr * (frac * (2.0 - frac)));
}
