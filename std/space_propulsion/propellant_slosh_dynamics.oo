// # Propellant Slosh Mechanical Analogy & Baffle Hydrodynamics
//
// Logline: Evaluates equivalent mechanical pendulum / spring-mass analogies for liquid propellant sloshing, natural frequencies, and baffle damping.
//
// Setup: Implements Abramson cylindrical/spherical propellant sloshing models for launch vehicle flight control stability.
//
// Beats:
//   1. Define tank geometry (radius, liquid fill height, propellant density) and axial acceleration.
//   2. Compute sloshing modal mass fraction, rigid mass fraction, and fundamental slosh frequency.
//   3. Calculate pendulum arm length, ring baffle viscous damping ratio, and lateral slosh force.

import "./space_propulsion_constants.oo";

pub type TankSloshSpec = struct {
    tank_radius_m: Float,
    liquid_height_m: Float,
    propellant_density_kg_m3: Float,
    axial_acceleration_m_s2: Float,
    ring_baffle_width_m: Float,
    num_ring_baffles: Int,
};

pub type SloshMechanicalAnalogy = struct {
    total_liquid_mass_kg: Float,
    slosh_modal_mass_kg: Float,
    rigid_modal_mass_kg: Float,
    natural_frequency_rad_s: Float,
    pendulum_arm_length_m: Float,
    damping_ratio_zeta: Float,
};

pub fn tank_slosh_spec_default() -> TankSloshSpec {
    return TankSloshSpec {
        tank_radius_m: 2.5, // 5m diameter stage
        liquid_height_m: 6.0,
        propellant_density_kg_m3: 1140.0, // LOX
        axial_acceleration_m_s2: 24.5, // ~2.5g during flight
        ring_baffle_width_m: 0.18,
        num_ring_baffles: 4,
    };
}

pub fn slosh_compute_mechanical_model(spec: TankSloshSpec) -> SloshMechanicalAnalogy {
    let r_tank: Float = (spec).tank_radius_m;
    let h_liq: Float = (spec).liquid_height_m;
    let rho: Float = (spec).propellant_density_kg_m3;
    let a_axial: Float = (spec).axial_acceleration_m_s2;
    let w_baffle: Float = (spec).ring_baffle_width_m;

    // Total liquid mass in cylinder: M_total = pi * R^2 * h * rho
    let m_total: Float = const_pi() * (r_tank * r_tank) * h_liq * rho;

    // Abramson fundamental slosh mode:
    // First roots of Bessel derivative J1'(eps11) = 0 -> eps11 = 1.8412
    let eps11: Float = 1.8412;
    let h_r: Float = h_liq / r_tank;
    let tanh_kh: Float = math_tanh(eps11 * h_r);

    // Natural frequency: omega_n = sqrt( (g_eff * eps11 / R) * tanh(eps11 * h / R) )
    let omega_sq: Float = ((a_axial * eps11) / r_tank) * tanh_kh;
    let omega_n: Float = sqrt(omega_sq);

    // Sloshing mass fraction: M_slosh / M_total = (2 * R / (eps11 * h)) * (tanh(eps11 * h / R) / (eps11^2 - 1))
    let denom: Float = (eps11 * eps11) - 1.0; // 2.390
    let m_slosh_frac: Float = ((2.0 * r_tank) / (eps11 * h_liq)) * (tanh_kh / denom);
    let m_slosh: Float = m_total * math_min(m_slosh_frac, 0.65);
    let m_rigid: Float = m_total - m_slosh;

    // Equivalent pendulum length: L_p = g_eff / omega_n^2 = (R / eps11) / tanh(eps11 * h / R)
    let l_pendulum: Float = (r_tank / eps11) / (tanh_kh + 0.0001);

    // Miles-Miles ring baffle damping ratio estimation: zeta ~ 0.05 + 0.15 * (w_baffle / R)^1.5
    let w_ratio: Float = w_baffle / r_tank;
    let zeta_base: Float = 0.005; // smooth wall natural damping
    let zeta_baffles: Float = 0.60 * math_pow(w_ratio, 1.5);
    let zeta_total: Float = zeta_base + zeta_baffles;

    return SloshMechanicalAnalogy {
        total_liquid_mass_kg: m_total,
        slosh_modal_mass_kg: m_slosh,
        rigid_modal_mass_kg: m_rigid,
        natural_frequency_rad_s: omega_n,
        pendulum_arm_length_m: l_pendulum,
        damping_ratio_zeta: zeta_total,
    };
}
