// # KML Placemark & Coordinate Parser
//
// Logline: Extracts geographic placemarks, coordinate strings, and styles from OGC KML XML documents.
//
// Setup: Pure string scanning and geometry extraction functions for KML markup.
//
// Beats:
//   1. Identify KML XML tag tokens and geometry element types.
//   2. Parse 3D geographic coordinates (lon, lat, altitude) from coordinate tokens.
//   3. Construct validated KmlPlacemark records with bounding metadata.

pub type KmlPlacemark = struct {
    name: String,
    geom_type: Int,
    lon: Float,
    lat: Float,
    alt: Float,
    is_valid: Bool
};

pub type KmlDocumentMeta = struct {
    name: String,
    placemark_count: Int,
    is_open: Bool
};

// Tag type constants:
// 1=Placemark, 2=Point, 3=LineString, 4=Polygon, 5=LinearRing, 6=coordinates, 7=Document
pub fn kml_identify_tag(tag_name: String) -> Int {
    if tag_name == "Placemark" {
        return 1;
    }
    if tag_name == "Point" {
        return 2;
    }
    if tag_name == "LineString" {
        return 3;
    }
    if tag_name == "Polygon" {
        return 4;
    }
    if tag_name == "LinearRing" {
        return 5;
    }
    if tag_name == "coordinates" {
        return 6;
    }
    if tag_name == "Document" {
        return 7;
    }
    return 0;
}

pub fn kml_validate_latlon(lat: Float, lon: Float) -> Bool {
    if lat < -90.0 {
        return false;
    }
    if lat > 90.0 {
        return false;
    }
    if lon < -180.0 {
        return false;
    }
    if lon > 180.0 {
        return false;
    }
    return true;
}

pub fn kml_parse_placemark(
    name: String,
    geom_type: Int,
    lon: Float,
    lat: Float,
    alt: Float
) -> KmlPlacemark {
    let valid = kml_validate_latlon(lat, lon);
    return KmlPlacemark {
        name: name,
        geom_type: geom_type,
        lon: lon,
        lat: lat,
        alt: alt,
        is_valid: valid
    };
}

pub fn kml_document_meta_new(name: String, count: Int) -> KmlDocumentMeta {
    return KmlDocumentMeta {
        name: name,
        placemark_count: count,
        is_open: true
    };
}
