// # Convex edge inside and segment intersection
//
// Logline: Classifies a point against a directed clip edge and intersects two segments with P1 + t(P2-P1).
//
// Setup: Pure. Clip edges are CCW. Parallel edges use a near-zero denominator guard.
//
// Beats:
//   1. Cross product of the clip edge with (P - C1) decides inside, including on-edge.
//   2. Intersect subject segment with clip edge using t = cross / den.
//   3. Return the start point when the denominator is near zero.

pub fn poly_cross(ax: Float, ay: Float, bx: Float, by: Float) -> Float { return ax * by - ay * bx; }

pub fn poly_inside(px: Float, py: Float, c1x: Float, c1y: Float, c2x: Float, c2y: Float) -> Bool {
    let cr: Float = poly_cross(c2x - c1x, c2y - c1y, px - c1x, py - c1y);
    if cr >= 0.0 {
        return true;
    }
    return false;
}

pub fn poly_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

pub fn poly_intersect(p1x: Float, p1y: Float, p2x: Float, p2y: Float, c1x: Float, c1y: Float, c2x: Float, c2y: Float) -> List[Float] {
    let dpx: Float = p2x - p1x;
    let dpy: Float = p2y - p1y;
    let dcx: Float = c2x - c1x;
    let dcy: Float = c2y - c1y;
    let den: Float = poly_cross(dpx, dpy, dcx, dcy);
    let mut o: List[Float] = list_new();
    if poly_abs(den) <= 0.000000000000001 {
        o = list_push(o, p1x);
        o = list_push(o, p1y);
        return o;
    }
    let t: Float = poly_cross(c1x - p1x, c1y - p1y, dcx, dcy) / den;
    o = list_push(o, p1x + t * dpx);
    o = list_push(o, p1y + t * dpy);
    return o;
}

pub fn poly_n(xy: List[Float]) -> Int { return list_len(xy) / 2; }

pub fn poly_x(xy: List[Float], i: Int) -> Float { return list_get(xy, i * 2); }

pub fn poly_y(xy: List[Float], i: Int) -> Float { return list_get(xy, i * 2 + 1); }

pub fn poly_push(xy: List[Float], x: Float, y: Float) -> List[Float] {
    let mut o: List[Float] = xy;
    o = list_push(o, x);
    o = list_push(o, y);
    return o;
}
