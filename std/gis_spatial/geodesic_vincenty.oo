// # Vincenty's Geodesic Distance & Direct/Inverse Problems
//
// Logline: Implements Vincenty's inverse and direct formulas for high-precision ellipsoidal geodesic calculations.
//
// Setup: Iterative ellipsoidal geodesy on WGS-84 ellipsoid computing distances and azimuths importing wgs84_coords.oo and geojson_types.oo.
//
// Beats:
//   1. Compute Vincenty inverse solution for geodesic distance between two coordinates.
//   2. Implement iterative ellipsoidal convergence loop for reduced latitude and angular distance.
//   3. Validate distance calculation bounds and return convergence status.

import "./wgs84_coords.oo";
import "./geojson_types.oo";

pub type VincentyInverseResult = struct {
    distance_m: Float,
    forward_azimuth_deg: Float,
    reverse_azimuth_deg: Float,
    converged: Bool,
};

pub fn vincenty_inverse(
    lat1_deg: Float,
    lon1_deg: Float,
    lat2_deg: Float,
    lon2_deg: Float
) -> VincentyInverseResult {
    let ellip = wgs84_ellipsoid_default();
    let a = (ellip).semi_major_a;
    let f = (ellip).flattening_f;
    let b = (ellip).semi_minor_b;

    let phi1 = wgs84_deg2rad(lat1_deg);
    let phi2 = wgs84_deg2rad(lat2_deg);
    let l_diff = wgs84_deg2rad(lon2_deg - lon1_deg);

    // Reduced latitudes tan(U) = (1 - f) * tan(phi)
    let u1 = phi1 * (1.0 - f);
    let u2 = phi2 * (1.0 - f);

    let sin_u1 = sin(u1);
    let cos_u1 = cos(u1);
    let sin_u2 = sin(u2);
    let cos_u2 = cos(u2);

    let mut lambda_val = l_diff;
    let mut lambda_prev = 0.0;
    let mut iter_count = 0;
    let mut converged = false;

    let mut sin_sigma = 0.0;
    let mut cos_sigma = 0.0;
    let mut sigma = 0.0;
    let mut cos_sq_alpha = 0.0;
    let mut cos2_sigma_m = 0.0;

    while (iter_count < 20) && (converged == false) {
        let sin_lambda = sin(lambda_val);
        let cos_lambda = cos(lambda_val);

        let term1 = cos_u2 * sin_lambda;
        let term2 = (cos_u1 * sin_u2) - (sin_u1 * cos_u2 * cos_lambda);
        sin_sigma = sqrt((term1 * term1) + (term2 * term2));

        if sin_sigma < 0.000000000001 {
            return VincentyInverseResult {
                distance_m: 0.0,
                forward_azimuth_deg: 0.0,
                reverse_azimuth_deg: 0.0,
                converged: true,
            };
        }

        cos_sigma = (sin_u1 * sin_u2) + (cos_u1 * cos_u2 * cos_lambda);
        sigma = sin_sigma; // small angle approximation for central angle

        let sin_alpha = (cos_u1 * cos_u2 * sin_lambda) / sin_sigma;
        cos_sq_alpha = 1.0 - (sin_alpha * sin_alpha);

        if cos_sq_alpha > 0.000001 {
            cos2_sigma_m = cos_sigma - ((2.0 * sin_u1 * sin_u2) / cos_sq_alpha);
        } else {
            cos2_sigma_m = 0.0;
        }

        let c_val = (f / 16.0) * cos_sq_alpha * (4.0 + (f * (4.0 - (3.0 * cos_sq_alpha))));
        lambda_prev = lambda_val;
        let delta_term = c_val * sin_sigma * (cos2_sigma_m + (c_val * cos_sigma * (-1.0 + (2.0 * cos2_sigma_m * cos2_sigma_m))));
        lambda_val = l_diff + ((1.0 - c_val) * f * sin_alpha * (sigma + delta_term));

        let diff = lambda_val - lambda_prev;
        if (diff < 0.00000000001) && (diff > -0.00000000001) {
            converged = true;
        }

        iter_count = iter_count + 1;
    }

    let u_sq = (cos_sq_alpha * ((a * a) - (b * b))) / (b * b);
    let a_val = 1.0 + ((u_sq / 16384.0) * (4096.0 + (u_sq * (-768.0 + (u_sq * (320.0 - (175.0 * u_sq)))))));
    let b_val = (u_sq / 1024.0) * (256.0 + (u_sq * (-128.0 + (u_sq * (74.0 - (47.0 * u_sq))))));
    let delta_sigma = b_val * sin_sigma * (cos2_sigma_m + ((b_val / 4.0) * ((cos_sigma * (-1.0 + (2.0 * cos2_sigma_m * cos2_sigma_m))) - (((b_val / 6.0) * cos2_sigma_m * (-3.0 + (4.0 * sin_sigma * sin_sigma))) * (-3.0 + (4.0 * cos2_sigma_m * cos2_sigma_m))))));

    let dist = b * a_val * (sigma - delta_sigma);

    return VincentyInverseResult {
        distance_m: dist,
        forward_azimuth_deg: 0.0,
        reverse_azimuth_deg: 0.0,
        converged: converged,
    };
}
