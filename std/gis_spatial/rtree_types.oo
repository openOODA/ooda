type RTreeBox = struct {
    min_x: Int,
    max_x: Int
};

pub fn rtree_box_new(min_x: Int, max_x: Int) -> RTreeBox {
    return RTreeBox {
        min_x: min_x,
        max_x: max_x
    };
}

pub fn rtree_box_min_x(b: RTreeBox) -> Int {
    return b.min_x;
}
