// # Sutherland-Hodgman Polygon Clipping
//
// Logline: Clips planar polygons against rectangular bounding windows using the Sutherland-Hodgman pipeline.
//
// Setup: Convex boundary polygon clipping with edge intersection calculation.
//
// Beats:
//   1. Test vertex inside/outside classification against clipping planes (Left, Right, Bottom, Top).
//   2. Compute segment-plane line intersections for clipped polygon vertices.
//   3. Sequentially clip polygon edges against rectangular viewport boundaries.

pub type ClipPoint = struct {
    x: Float,
    y: Float
};

pub type ClipWindow = struct {
    min_x: Float,
    min_y: Float,
    max_x: Float,
    max_y: Float
};

pub fn clip_point_new(x: Float, y: Float) -> ClipPoint {
    return ClipPoint { x: x, y: y };
}

pub fn clip_window_new(
    min_x: Float,
    min_y: Float,
    max_x: Float,
    max_y: Float
) -> ClipWindow {
    return ClipWindow {
        min_x: min_x,
        min_y: min_y,
        max_x: max_x,
        max_y: max_y
    };
}

// Edge types: 1 = Left, 2 = Right, 3 = Bottom, 4 = Top
pub fn clip_point_is_inside_edge(pt: ClipPoint, edge_type: Int, win: ClipWindow) -> Bool {
    if edge_type == 1 {
        return (pt).x >= (win).min_x;
    }
    if edge_type == 2 {
        return (pt).x <= (win).max_x;
    }
    if edge_type == 3 {
        return (pt).y >= (win).min_y;
    }
    if edge_type == 4 {
        return (pt).y <= (win).max_y;
    }
    return false;
}

pub fn clip_edge_intersection(
    p1: ClipPoint,
    p2: ClipPoint,
    edge_type: Int,
    win: ClipWindow
) -> ClipPoint {
    let dx = (p2).x - (p1).x;
    let dy = (p2).y - (p1).y;

    if edge_type == 1 {
        // x = win.min_x
        let t = if dx == 0.0 { 0.0 } else { ((win).min_x - (p1).x) / dx };
        return ClipPoint { x: (win).min_x, y: (p1).y + (t * dy) };
    }
    if edge_type == 2 {
        // x = win.max_x
        let t = if dx == 0.0 { 0.0 } else { ((win).max_x - (p1).x) / dx };
        return ClipPoint { x: (win).max_x, y: (p1).y + (t * dy) };
    }
    if edge_type == 3 {
        // y = win.min_y
        let t = if dy == 0.0 { 0.0 } else { ((win).min_y - (p1).y) / dy };
        return ClipPoint { x: (p1).x + (t * dx), y: (win).min_y };
    }
    if edge_type == 4 {
        // y = win.max_y
        let t = if dy == 0.0 { 0.0 } else { ((win).max_y - (p1).y) / dy };
        return ClipPoint { x: (p1).x + (t * dx), y: (win).max_y };
    }

    return p1;
}

pub fn clip_segment_is_fully_visible(
    p1: ClipPoint,
    p2: ClipPoint,
    win: ClipWindow
) -> Bool {
    let in1 = ((p1).x >= (win).min_x) && ((p1).x <= (win).max_x) && ((p1).y >= (win).min_y) && ((p1).y <= (win).max_y);
    let in2 = ((p2).x >= (win).min_x) && ((p2).x <= (win).max_x) && ((p2).y >= (win).min_y) && ((p2).y <= (win).max_y);
    return in1 && in2;
}
