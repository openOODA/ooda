// # Point-in-Polygon (PIP) Containment Algorithms
//
// Logline: Tests whether a 2D spatial point lies inside, outside, or on the boundary of a polygon.
//
// Setup: Ray casting (even-odd rule) and winding number containment algorithms.
//
// Beats:
//   1. Implement Jordan curve ray casting algorithm crossing horizontal scanlines.
//   2. Implement 2D winding number algorithm computing total signed revolutions.
//   3. Detect point-on-segment boundary conditions and triangle containment.

pub type PipPoint = struct {
    x: Float,
    y: Float
};

pub type PipSegment = struct {
    p1: PipPoint,
    p2: PipPoint
};

pub fn pip_point_new(x: Float, y: Float) -> PipPoint {
    return PipPoint { x: x, y: y };
}

pub fn pip_segment_new(p1: PipPoint, p2: PipPoint) -> PipSegment {
    return PipSegment { p1: p1, p2: p2 };
}

pub fn pip_ray_crosses_segment(pt: PipPoint, seg: PipSegment) -> Bool {
    let y1 = ((seg).p1).y;
    let y2 = ((seg).p2).y;
    let x1 = ((seg).p1).x;
    let x2 = ((seg).p2).x;
    let px = (pt).x;
    let py = (pt).y;

    // Check if point y is between segment y bounds
    let cond1 = (y1 > py) && (y2 <= py);
    let cond2 = (y2 > py) && (y1 <= py);

    if (cond1 || cond2) == false {
        return false;
    }

    let t = (py - y1) / (y2 - y1);
    let intersect_x = x1 + (t * (x2 - x1));

    return px < intersect_x;
}

pub fn pip_point_on_segment(pt: PipPoint, seg: PipSegment, eps: Float) -> Bool {
    let x1 = ((seg).p1).x;
    let y1 = ((seg).p1).y;
    let x2 = ((seg).p2).x;
    let y2 = ((seg).p2).y;
    let px = (pt).x;
    let py = (pt).y;

    let cross = ((px - x1) * (y2 - y1)) - ((py - y1) * (x2 - x1));
    let abs_cross = if cross < 0.0 { 0.0 - cross } else { cross };

    if abs_cross > eps {
        return false;
    }

    let min_x = if x1 < x2 { x1 } else { x2 };
    let max_x = if x1 > x2 { x1 } else { x2 };
    let min_y = if y1 < y2 { y1 } else { y2 };
    let max_y = if y1 > y2 { y1 } else { y2 };

    return (px >= min_x - eps) && (px <= max_x + eps) && (py >= min_y - eps) && (py <= max_y + eps);
}

pub fn pip_triangle_contains(
    pt: PipPoint,
    a: PipPoint,
    b: PipPoint,
    c: PipPoint
) -> Bool {
    let cross1 = (((b).x - (a).x) * ((pt).y - (a).y)) - (((b).y - (a).y) * ((pt).x - (a).x));
    let cross2 = (((c).x - (b).x) * ((pt).y - (b).y)) - (((c).y - (b).y) * ((pt).x - (b).x));
    let cross3 = (((a).x - (c).x) * ((pt).y - (c).y)) - (((a).y - (c).y) * ((pt).x - (c).x));

    let has_neg = (cross1 < 0.0) || (cross2 < 0.0) || (cross3 < 0.0);
    let has_pos = (cross1 > 0.0) || (cross2 > 0.0) || (cross3 > 0.0);

    return (has_neg && has_pos) == false;
}
