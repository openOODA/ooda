// # GIS & Spatial Geometry Unified Facade
//
// Logline: Re-exports GeoJSON, KML, WGS84, UTM, Web Mercator, Geodesics, R-Tree, k-d Tree, Clipping, and Transforms.
//
// Setup: Pure module shim and facade importing all companion GIS and spatial geometry submodules.
//
// Beats:
//   1. Import 24 modular GIS and spatial geometry subcomponents.
//   2. Re-export public constructors, coordinate converters, and spatial indexing entry points.
//   3. Maintain full compatibility with downstream openOODA GIS and spatial consumers.

import "./geojson_types.oo";
import "./geojson_parser.oo";
import "./geojson_writer.oo";
import "./kml_parser.oo";
import "./kml_writer.oo";
import "./wgs84_coords.oo";
import "./utm_projection.oo";
import "./web_mercator.oo";
import "./geodesic_vincenty.oo";
import "./haversine.oo";
import "./rtree_types.oo";
import "./rtree_ops.oo";
import "./rtree_engine.oo";
import "./kdtree_spatial.oo";
import "./polygon_clip_sutherland.oo";
import "./polygon_contains_point.oo";
import "./spatial_envelope.oo";
import "./spatial_buffer.oo";
import "./geohash.oo";
import "./h3_hex_grid.oo";
import "./elevation_grid.oo";
import "./coordinate_transform.oo";
import "./shapefile_header.oo";
import "./gis_stubs.oo";

pub fn gis_shim_point2d(lon: Float, lat: Float) -> GeoPoint2D {
    return geo_point2d_new(lon, lat);
}

pub fn gis_shim_geojson_parse(lon: Float, lat: Float) -> GeoJsonParseResult {
    return geojson_parse_point_coords(lon, lat);
}

pub fn gis_shim_geojson_format_point(lon: Float, lat: Float) -> GeoJsonGeometry {
    return geojson_writer_point(lon, lat);
}

pub fn gis_shim_kml_placemark(name: String, lon: Float, lat: Float, alt: Float) -> KmlPlacemark {
    return kml_writer_point_placemark(name, lon, lat, alt);
}

pub fn gis_shim_wgs84_ellipsoid() -> Wgs84Ellipsoid {
    return wgs84_ellipsoid_default();
}

pub fn gis_shim_utm_project(lat: Float, lon: Float) -> UtmCoordinate {
    return utm_forward_project(lat, lon);
}

pub fn gis_shim_web_mercator(lat: Float, lon: Float) -> MercatorPoint {
    return web_mercator_forward(lat, lon);
}

pub fn gis_shim_vincenty_distance(lat1: Float, lon1: Float, lat2: Float, lon2: Float) -> Float {
    let res = vincenty_inverse(lat1, lon1, lat2, lon2);
    return (res).distance_m;
}

pub fn gis_shim_haversine_distance(lat1: Float, lon1: Float, lat2: Float, lon2: Float) -> Float {
    return haversine_distance(lat1, lon1, lat2, lon2);
}

pub fn gis_shim_rtree_engine() -> RTreeEngine {
    return rtree_engine_init();
}

pub fn gis_shim_kdtree_init() -> KdTree2D {
    return kd_tree_init();
}

pub fn gis_shim_clip_point(x: Float, y: Float) -> ClipPoint {
    return clip_point_new(x, y);
}

pub fn gis_shim_pip_ray_crosses(pt: PipPoint, seg: PipSegment) -> Bool {
    return pip_ray_crosses_segment(pt, seg);
}

pub fn gis_shim_envelope_new(min_x: Float, min_y: Float, max_x: Float, max_y: Float) -> Envelope2D {
    return envelope2d_new(min_x, min_y, max_x, max_y);
}

pub fn gis_shim_buffer_point(x: Float, y: Float, radius: Float) -> Envelope2D {
    return spatial_buffer_point_envelope(x, y, radius);
}

pub fn gis_shim_geohash_bbox(min_lat: Float, min_lon: Float, max_lat: Float, max_lon: Float) -> GeohashBBox {
    return geohash_bbox_new(min_lat, min_lon, max_lat, max_lon);
}

pub fn gis_shim_h3_cell(high: Int, low: Int, res: Int, base: Int) -> H3CellIndex {
    return h3_cell_new(high, low, res, base);
}

pub fn gis_shim_dem_slope(z1: Float, z2: Float, z3: Float, z4: Float, z6: Float, z7: Float, z8: Float, z9: Float, cell_size: Float) -> Float {
    return dem_calc_slope_horn(z1, z2, z3, z4, z6, z7, z8, z9, cell_size);
}

pub fn gis_shim_ecef_transform(lat: Float, lon: Float, alt: Float) -> TransformPoint3D {
    return transform_wgs84_to_ecef(lat, lon, alt);
}

pub fn gis_shim_shapefile_header(shape_type: Int, min_x: Float, min_y: Float, max_x: Float, max_y: Float) -> ShapefileHeader {
    return shapefile_header_new_2d(shape_type, 50, min_x, min_y, max_x, max_y);
}

pub fn gis_shim_hardware_accel(dev_id: Int) -> GisHardwareAccel {
    return gis_hardware_accel_init(dev_id);
}
