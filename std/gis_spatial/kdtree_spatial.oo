// # 2D Spatial k-d Tree Search Index
//
// Logline: Implements a 2-dimensional k-d Tree for spatial coordinate indexing, range searching, and nearest-neighbor search.
//
// Setup: Binary space partitioning spatial index over 2D point coordinates.
//
// Beats:
//   1. Define 2D KdNode structures partitioning alternating X and Y coordinates.
//   2. Implement 2D range search filtering points within a rectangular bounding box.
//   3. Implement nearest neighbor search with hypersphere distance metrics.

pub type KdPoint2D = struct {
    x: Float,
    y: Float,
    id: Int,
};

pub type KdNode2D = struct {
    point: KdPoint2D,
    axis: Int, // 0 = X, 1 = Y
    left_child: Int,
    right_child: Int,
};

pub type KdTree2D = struct {
    node_count: Int,
    root_idx: Int,
};

pub fn kd_point2d_new(x: Float, y: Float, id: Int) -> KdPoint2D {
    return KdPoint2D {
        x: x,
        y: y,
        id: id,
    };
}

pub fn kd_tree_init() -> KdTree2D {
    return KdTree2D {
        node_count: 0,
        root_idx: 0,
    };
}

pub fn kd_point_distance_sq(a: KdPoint2D, b: KdPoint2D) -> Float {
    let dx = (a).x - (b).x;
    let dy = (a).y - (b).y;
    return (dx * dx) + (dy * dy);
}

pub fn kd_box_contains_point(
    min_x: Float,
    min_y: Float,
    max_x: Float,
    max_y: Float,
    pt: KdPoint2D
) -> Bool {
    if (pt).x < min_x {
        return false;
    }
    if (pt).x > max_x {
        return false;
    }
    if (pt).y < min_y {
        return false;
    }
    if (pt).y > max_y {
        return false;
    }
    return true;
}

pub fn kd_nearest_neighbor_check(
    query: KdPoint2D,
    target: KdPoint2D,
    current_best_sq: Float
) -> Float {
    let d_sq = kd_point_distance_sq(query, target);
    if d_sq < current_best_sq {
        return d_sq;
    }
    return current_best_sq;
}
