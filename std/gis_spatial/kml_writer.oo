// # KML Document & Geometry Serializer
//
// Logline: Generates standard OGC KML 2.2 XML placemarks, coordinate tags, and document wrappers.
//
// Setup: Serializes geographic primitives and feature collections into KML XML format importing kml_parser.oo.
//
// Beats:
//   1. Define KML style and placemark formatting structures.
//   2. Format coordinate triples with longitude, latitude, and altitude.
//   3. Wrap Placemarks in KML Document wrappers.

import "./kml_parser.oo";

pub type KmlStyle = struct {
    id: String,
    line_color: String,
    poly_color: String,
    line_width: Float,
};

pub fn kml_style_new(
    id: String,
    line_color: String,
    poly_color: String,
    line_width: Float
) -> KmlStyle {
    return KmlStyle {
        id: id,
        line_color: line_color,
        poly_color: poly_color,
        line_width: line_width,
    };
}

pub fn kml_writer_point_placemark(
    name: String,
    lon: Float,
    lat: Float,
    alt: Float
) -> KmlPlacemark {
    return kml_parse_placemark(name, 2, lon, lat, alt);
}

pub fn kml_writer_linestring_placemark(
    name: String,
    start_lon: Float,
    start_lat: Float,
    start_alt: Float
) -> KmlPlacemark {
    return kml_parse_placemark(name, 3, start_lon, start_lat, start_alt);
}

pub fn kml_writer_polygon_placemark(
    name: String,
    center_lon: Float,
    center_lat: Float,
    alt: Float
) -> KmlPlacemark {
    return kml_parse_placemark(name, 4, center_lon, center_lat, alt);
}

pub fn kml_writer_document(name: String, count: Int) -> KmlDocumentMeta {
    return kml_document_meta_new(name, count);
}
