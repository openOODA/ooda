// # Geohash Spatial Index & Base32 Encoding
//
// Logline: Encodes and decodes WGS-84 geographic coordinates to Morton-order Base32 geohash strings.
//
// Setup: Hierarchical spatial subdivision using interleaved longitude/latitude binary bits importing wgs84_coords.oo and geojson_types.oo.
//
// Beats:
//   1. Define Geohash bounding intervals and Base32 character mapping tables.
//   2. Implement binary interval bisection for latitude and longitude coordinates.
//   3. Compute geohash bounding box centroids and precision intervals.

import "./wgs84_coords.oo";
import "./geojson_types.oo";

pub type GeohashBBox = struct {
    min_lat: Float,
    min_lon: Float,
    max_lat: Float,
    max_lon: Float,
};

pub fn geohash_bbox_new(
    min_lat: Float,
    min_lon: Float,
    max_lat: Float,
    max_lon: Float
) -> GeohashBBox {
    return GeohashBBox {
        min_lat: min_lat,
        min_lon: min_lon,
        max_lat: max_lat,
        max_lon: max_lon,
    };
}

pub fn geohash_center_lat(bbox: GeohashBBox) -> Float {
    return ((bbox).min_lat + (bbox).max_lat) / 2.0;
}

pub fn geohash_center_lon(bbox: GeohashBBox) -> Float {
    return ((bbox).min_lon + (bbox).max_lon) / 2.0;
}

// Base32 character map for Geohashes: "0123456789bcdefghjkmnpqrstuvwxyz"
pub fn geohash_char_to_val(ascii_code: Int) -> Int {
    // Digits '0'-'9' (48-57)
    if (ascii_code >= 48) && (ascii_code <= 57) {
        return ascii_code - 48;
    }
    // 'b'=98 -> 10, 'c'=99 -> 11, 'd'=100 -> 12, 'e'=101 -> 13, 'f'=102 -> 14, 'g'=103 -> 15, 'h'=104 -> 16
    if (ascii_code >= 98) && (ascii_code <= 104) {
        return (ascii_code - 98) + 10;
    }
    // 'j'=106 -> 17, 'k'=107 -> 18, 'm'=109 -> 19, 'n'=110 -> 20, 'p'=112 -> 21
    if ascii_code == 106 { return 17; }
    if ascii_code == 107 { return 18; }
    if ascii_code == 109 { return 19; }
    if ascii_code == 110 { return 20; }
    if ascii_code == 112 { return 21; }
    // 'q'-'z'
    if (ascii_code >= 113) && (ascii_code <= 122) {
        return (ascii_code - 113) + 22;
    }
    return 0;
}

pub fn geohash_bisect_step(min_val: Float, max_val: Float, val: Float) -> Int {
    let mid = (min_val + max_val) / 2.0;
    if val >= mid {
        return 1;
    }
    return 0;
}

pub fn geohash_decode_centroid(bbox: GeohashBBox) -> GeoPoint2D {
    let lat = geohash_center_lat(bbox);
    let lon = geohash_center_lon(bbox);
    return geo_point2d_new(lon, lat);
}
