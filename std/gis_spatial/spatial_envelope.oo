// # Spatial Envelope & Minimum Bounding Box
//
// Logline: Computes 2D/3D Minimum Bounding Boxes (AABB) for spatial geometry collections and envelope algebra.
//
// Setup: Bounding box expansion, containment testing, intersection, and union operations.
//
// Beats:
//   1. Define 2D/3D bounding envelopes and empty initializers.
//   2. Expand envelopes by accumulating points and child bounding boxes.
//   3. Test envelope containment, overlap, and compute dimensional metrics.

pub type Envelope2D = struct {
    min_x: Float,
    min_y: Float,
    max_x: Float,
    max_y: Float,
    is_empty: Bool
};

pub fn envelope2d_empty() -> Envelope2D {
    return Envelope2D {
        min_x: 0.0,
        min_y: 0.0,
        max_x: 0.0,
        max_y: 0.0,
        is_empty: true
    };
}

pub fn envelope2d_new(
    min_x: Float,
    min_y: Float,
    max_x: Float,
    max_y: Float
) -> Envelope2D {
    return Envelope2D {
        min_x: min_x,
        min_y: min_y,
        max_x: max_x,
        max_y: max_y,
        is_empty: false
    };
}

pub fn envelope2d_expand_point(env: Envelope2D, x: Float, y: Float) -> Envelope2D {
    if (env).is_empty {
        return envelope2d_new(x, y, x, y);
    }
    let min_x = if x < (env).min_x { x } else { (env).min_x };
    let min_y = if y < (env).min_y { y } else { (env).min_y };
    let max_x = if x > (env).max_x { x } else { (env).max_x };
    let max_y = if y > (env).max_y { y } else { (env).max_y };
    return envelope2d_new(min_x, min_y, max_x, max_y);
}

pub fn envelope2d_union(a: Envelope2D, b: Envelope2D) -> Envelope2D {
    if (a).is_empty {
        return b;
    }
    if (b).is_empty {
        return a;
    }
    let min_x = if (a).min_x < (b).min_x { (a).min_x } else { (b).min_x };
    let min_y = if (a).min_y < (b).min_y { (a).min_y } else { (b).min_y };
    let max_x = if (a).max_x > (b).max_x { (a).max_x } else { (b).max_x };
    let max_y = if (a).max_y > (b).max_y { (a).max_y } else { (b).max_y };
    return envelope2d_new(min_x, min_y, max_x, max_y);
}

pub fn envelope2d_intersects(a: Envelope2D, b: Envelope2D) -> Bool {
    if (a).is_empty || (b).is_empty {
        return false;
    }
    if (a).min_x > (b).max_x {
        return false;
    }
    if (a).max_x < (b).min_x {
        return false;
    }
    if (a).min_y > (b).max_y {
        return false;
    }
    if (a).max_y < (b).min_y {
        return false;
    }
    return true;
}

pub fn envelope2d_contains_point(env: Envelope2D, x: Float, y: Float) -> Bool {
    if (env).is_empty {
        return false;
    }
    return (x >= (env).min_x) && (x <= (env).max_x) && (y >= (env).min_y) && (y <= (env).max_y);
}

pub fn envelope2d_width(env: Envelope2D) -> Float {
    if (env).is_empty {
        return 0.0;
    }
    return (env).max_x - (env).min_x;
}

pub fn envelope2d_height(env: Envelope2D) -> Float {
    if (env).is_empty {
        return 0.0;
    }
    return (env).max_y - (env).min_y;
}

pub fn envelope2d_center_x(env: Envelope2D) -> Float {
    return ((env).min_x + (env).max_x) / 2.0;
}

pub fn envelope2d_center_y(env: Envelope2D) -> Float {
    return ((env).min_y + (env).max_y) / 2.0;
}

pub fn envelope2d_area(env: Envelope2D) -> Float {
    return envelope2d_width(env) * envelope2d_height(env);
}
