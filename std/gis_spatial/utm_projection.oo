// # Universal Transverse Mercator (UTM) Projection
//
// Logline: Converts between WGS-84 geodetic coordinates and UTM zone projected easting and northing.
//
// Setup: Forward and inverse transverse mercator projection equations importing wgs84_coords.oo.
//
// Beats:
//   1. Compute UTM longitudinal zone (1-60) and central meridian for given coordinates.
//   2. Project geodetic latitude/longitude to UTM Easting and Northing.
//   3. Validate UTM coordinate bounding intervals and hemisphere indicators.

import "./wgs84_coords.oo";

pub type UtmCoordinate = struct {
    zone: Int,
    is_northern: Bool,
    easting: Float,
    northing: Float
};

pub fn utm_calc_zone(lon_deg: Float) -> Int {
    let norm_lon = wgs84_normalize_lon(lon_deg);
    let mut z = 1;
    let mut boundary = -174.0;
    while (norm_lon > boundary) && (z < 60) {
        z = z + 1;
        boundary = boundary + 6.0;
    }
    return z;
}

pub fn utm_central_meridian(zone: Int) -> Float {
    let mut cm = -177.0;
    let mut current_z = 1;
    while (current_z < zone) && (current_z < 60) {
        cm = cm + 6.0;
        current_z = current_z + 1;
    }
    return cm;
}

pub fn utm_is_valid_easting(easting: Float) -> Bool {
    return (easting >= 100000.0) && (easting <= 900000.0);
}

pub fn utm_is_valid_northing(northing: Float) -> Bool {
    return (northing >= 0.0) && (northing <= 10000000.0);
}

pub fn utm_forward_project(lat_deg: Float, lon_deg: Float) -> UtmCoordinate {
    let zone = utm_calc_zone(lon_deg);
    let cm = utm_central_meridian(zone);
    let is_north = lat_deg >= 0.0;

    let lat_rad = wgs84_deg2rad(lat_deg);
    let lon_rad = wgs84_deg2rad(lon_deg);
    let cm_rad = wgs84_deg2rad(cm);

    let k0: Float = 0.9996;
    let ellip = wgs84_ellipsoid_default();
    let a = (ellip).semi_major_a;
    let e_sq = (ellip).ecc_sq;

    let sin_lat = sin(lat_rad);
    let cos_lat = cos(lat_rad);

    let n_rad = a / sqrt(1.0 - (e_sq * sin_lat * sin_lat));
    let t_val = sin_lat / cos_lat; // tan(lat)
    let t_sq = t_val * t_val;
    let c_val = (e_sq / (1.0 - e_sq)) * cos_lat * cos_lat;
    let delta_lon = lon_rad - cm_rad;
    let a_term = delta_lon * cos_lat;

    // Meridional distance approximation
    let m_dist = a * (((1.0 - (e_sq / 4.0)) * lat_rad) - (((3.0 * e_sq) / 8.0) * sin(2.0 * lat_rad)));

    let a_sq = a_term * a_term;
    let a_p4 = a_sq * a_sq;

    let easting_offset = n_rad * (a_term + (((1.0 - t_sq + c_val) * a_sq * a_term) / 6.0));
    let easting = 500000.0 + (k0 * easting_offset);

    let northing_offset = m_dist + (n_rad * t_val * ((a_sq / 2.0) + (((5.0 - t_sq + (9.0 * c_val)) * a_p4) / 24.0)));
    let mut northing = k0 * northing_offset;

    if is_north == false {
        northing = 10000000.0 + northing;
    }

    return UtmCoordinate {
        zone: zone,
        is_northern: is_north,
        easting: easting,
        northing: northing
    };
}
