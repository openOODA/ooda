// # ESRI Shapefile File Header & Metadata
//
// Logline: Parses and constructs the standard 100-byte ESRI Shapefile (.shp/.shx) binary main file header.
//
// Setup: Pure binary header record structures and bounding box definitions for Shapefiles.
//
// Beats:
//   1. Define Shapefile 100-byte main file header structure and shape type codes.
//   2. Validate Shapefile magic file code (9994) and version (1000).
//   3. Construct Shapefile bounding envelope fields and record length descriptors.

// Shapefile Shape Types:
// 0 = Null, 1 = Point, 3 = PolyLine, 5 = Polygon, 8 = MultiPoint,
// 11 = PointZ, 13 = PolyLineZ, 15 = PolygonZ, 18 = MultiPointZ

pub type ShapefileHeader = struct {
    file_code: Int,
    file_length_words: Int,
    version: Int,
    shape_type: Int,
    min_x: Float,
    min_y: Float,
    max_x: Float,
    max_y: Float,
    min_z: Float,
    max_z: Float,
    min_m: Float,
    max_m: Float,
};

pub fn shapefile_header_new_2d(
    shape_type: Int,
    file_len_words: Int,
    min_x: Float,
    min_y: Float,
    max_x: Float,
    max_y: Float
) -> ShapefileHeader {
    return ShapefileHeader {
        file_code: 9994,
        file_length_words: file_len_words,
        version: 1000,
        shape_type: shape_type,
        min_x: min_x,
        min_y: min_y,
        max_x: max_x,
        max_y: max_y,
        min_z: 0.0,
        max_z: 0.0,
        min_m: 0.0,
        max_m: 0.0,
    };
}

pub fn shapefile_header_is_valid(hdr: &ShapefileHeader) -> Bool {
    if (hdr).file_code != 9994 {
        return false;
    }
    if (hdr).version != 1000 {
        return false;
    }
    if (hdr).file_length_words < 50 {
        return false;
    }
    return true;
}

pub fn shapefile_type_name(shape_type: Int) -> String {
    if shape_type == 0 {
        return "NullShape";
    }
    if shape_type == 1 {
        return "Point";
    }
    if shape_type == 3 {
        return "PolyLine";
    }
    if shape_type == 5 {
        return "Polygon";
    }
    if shape_type == 8 {
        return "MultiPoint";
    }
    if shape_type == 11 {
        return "PointZ";
    }
    if shape_type == 13 {
        return "PolyLineZ";
    }
    if shape_type == 15 {
        return "PolygonZ";
    }
    if shape_type == 18 {
        return "MultiPointZ";
    }
    return "Unknown";
}
