// # Digital Elevation Model (DEM) & Terrain Analysis
//
// Logline: Interpolates raster elevation grids, calculates terrain slope, aspect, and hillshade illumination.
//
// Setup: Terrain analysis algorithms over regular grid digital elevation models importing wgs84_coords.oo.
//
// Beats:
//   1. Interpolate elevation at arbitrary coordinates using bilinear interpolation.
//   2. Compute terrain surface slope angle and aspect azimuth using Horn's 3x3 filter.
//   3. Compute solar hillshade illumination from sun azimuth and elevation angles.

import "./wgs84_coords.oo";

pub type ElevationCell = struct {
    elev_m: Float,
    is_nodata: Bool,
};

pub type TerrainAnalysis = struct {
    elevation_m: Float,
    slope_deg: Float,
    aspect_deg: Float,
    hillshade: Int,
};

pub fn elevation_cell_new(elev_m: Float, is_nodata: Bool) -> ElevationCell {
    return ElevationCell {
        elev_m: elev_m,
        is_nodata: is_nodata,
    };
}

pub fn dem_bilinear_interpolate(
    q11: Float,
    q12: Float,
    q21: Float,
    q22: Float,
    fx: Float,
    fy: Float
) -> Float {
    let r1 = ((1.0 - fx) * q11) + (fx * q21);
    let r2 = ((1.0 - fx) * q12) + (fx * q22);
    return ((1.0 - fy) * r1) + (fy * r2);
}

// Horn's 3x3 filter for surface gradient:
// [z1 z2 z3]
// [z4 z5 z6]
// [z7 z8 z9]
pub fn dem_calc_slope_horn(
    z1: Float,
    z2: Float,
    z3: Float,
    z4: Float,
    z6: Float,
    z7: Float,
    z8: Float,
    z9: Float,
    cell_size: Float
) -> Float {
    let dz_dx = (((z3 + (2.0 * z6) + z9) - (z1 + (2.0 * z4) + z7))) / (8.0 * cell_size);
    let dz_dy = (((z7 + (2.0 * z8) + z9) - (z1 + (2.0 * z2) + z3))) / (8.0 * cell_size);

    let grad_sq = (dz_dx * dz_dx) + (dz_dy * dz_dy);
    let slope_rad = sqrt(grad_sq); // small-angle approximation tan(slope) ~ slope
    return wgs84_rad2deg(slope_rad);
}

pub fn dem_calc_hillshade(
    slope_deg: Float,
    aspect_deg: Float,
    sun_azimuth_deg: Float,
    sun_elevation_deg: Float
) -> Int {
    let zen_rad = wgs84_deg2rad(90.0 - sun_elevation_deg);
    let az_rad = wgs84_deg2rad(sun_azimuth_deg);
    let slp_rad = wgs84_deg2rad(slope_deg);
    let asp_rad = wgs84_deg2rad(aspect_deg);

    let cos_val = (cos(zen_rad) * cos(slp_rad)) + (sin(zen_rad) * sin(slp_rad) * cos(az_rad - asp_rad));
    let mut shade = cos_val * 255.0;
    if shade < 0.0 {
        shade = 0.0;
    }
    if shade > 255.0 {
        shade = 255.0;
    }

    // integer truncation loop
    let mut shade_int = 0;
    let mut rem = shade;
    while rem >= 1.0 {
        shade_int = shade_int + 1;
        rem = rem - 1.0;
    }

    return shade_int;
}
