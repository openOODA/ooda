// # GeoJSON Text & Structure Parser
//
// Logline: Parses GeoJSON string tokens into structured geometry representations and identifies geometry types.
//
// Setup: Imports geojson_types.oo for GeoPoint2D, GeoBBox, and geometry structures.
//
// Beats:
//   1. Identify GeoJSON geometry types from string identifiers.
//   2. Parse and validate geographic coordinate ranges for longitude and latitude.
//   3. Parse BoundingBox envelopes and feature records with error status codes.

import "./geojson_types.oo";

pub type GeoJsonParseResult = struct {
    is_valid: Bool,
    geom_type: Int,
    point: GeoPoint2D,
    bbox: GeoBBox,
    error_code: Int
};

pub fn geojson_parse_result_ok(geom_type: Int, pt: GeoPoint2D, bbox: GeoBBox) -> GeoJsonParseResult {
    return GeoJsonParseResult {
        is_valid: true,
        geom_type: geom_type,
        point: pt,
        bbox: bbox,
        error_code: 0
    };
}

pub fn geojson_parse_result_err(error_code: Int) -> GeoJsonParseResult {
    let dummy_pt = geo_point2d_new(0.0, 0.0);
    let dummy_bbox = geo_bbox_empty();
    return GeoJsonParseResult {
        is_valid: false,
        geom_type: 0,
        point: dummy_pt,
        bbox: dummy_bbox,
        error_code: error_code
    };
}

// Map GeoJSON string name to geometry type code.
// 1=Point, 2=LineString, 3=Polygon, 4=MultiPoint, 5=MultiLineString, 6=MultiPolygon, 7=GeometryCollection
pub fn geojson_identify_type(type_name: String) -> Int {
    if type_name == "Point" {
        return 1;
    }
    if type_name == "LineString" {
        return 2;
    }
    if type_name == "Polygon" {
        return 3;
    }
    if type_name == "MultiPoint" {
        return 4;
    }
    if type_name == "MultiLineString" {
        return 5;
    }
    if type_name == "MultiPolygon" {
        return 6;
    }
    if type_name == "GeometryCollection" {
        return 7;
    }
    if type_name == "Feature" {
        return 8;
    }
    if type_name == "FeatureCollection" {
        return 9;
    }
    return 0;
}

// Validate coordinate bounds: Lon [-180.0, 180.0], Lat [-90.0, 90.0]
pub fn geojson_validate_coords(lon: Float, lat: Float) -> Bool {
    if lon < -180.0 {
        return false;
    }
    if lon > 180.0 {
        return false;
    }
    if lat < -90.0 {
        return false;
    }
    if lat > 90.0 {
        return false;
    }
    return true;
}

// Parse and validate a 2D coordinate pair.
pub fn geojson_parse_point_coords(lon: Float, lat: Float) -> GeoJsonParseResult {
    if geojson_validate_coords(lon, lat) == false {
        return geojson_parse_result_err(1); // 1 = Invalid coordinate range
    }
    let pt = geo_point2d_new(lon, lat);
    let bbox = geo_bbox_new(lon, lat, lon, lat);
    return geojson_parse_result_ok(1, pt, bbox);
}

// Parse and validate bounding box coordinate values.
pub fn geojson_parse_bbox(min_lon: Float, min_lat: Float, max_lon: Float, max_lat: Float) -> GeoBBox {
    if geojson_validate_coords(min_lon, min_lat) && geojson_validate_coords(max_lon, max_lat) {
        return geo_bbox_new(min_lon, min_lat, max_lon, max_lat);
    }
    return geo_bbox_empty();
}

// Parse a single GeoJSON Feature token.
pub fn geojson_parse_simple_feature(type_str: String, lon: Float, lat: Float) -> GeoJsonParseResult {
    let g_type = geojson_identify_type(type_str);
    if g_type == 0 {
        return geojson_parse_result_err(2); // 2 = Unknown geometry type
    }
    if geojson_validate_coords(lon, lat) == false {
        return geojson_parse_result_err(1); // 1 = Invalid coordinates
    }
    let pt = geo_point2d_new(lon, lat);
    let bbox = geo_bbox_new(lon, lat, lon, lat);
    return geojson_parse_result_ok(g_type, pt, bbox);
}
