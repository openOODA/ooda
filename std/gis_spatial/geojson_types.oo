// # GeoJSON types
//
// Logline: GeoPoint2D destubbed off nested geometry lists.
// residual: List[struct] destubbed.

type GeoPoint2D = struct {
    x: Int,
    y: Int
};

pub fn geo_point_new(x: Int, y: Int) -> GeoPoint2D {
    return GeoPoint2D {
        x: x,
        y: y
    };
}

pub fn geo_point_x(p: GeoPoint2D) -> Int {
    return p.x;
}
