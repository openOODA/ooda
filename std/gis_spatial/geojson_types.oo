// # GeoJSON types
//
// Logline: GeoPoint2D destubbed off nested geometry lists.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: List[struct] destubbed.

pub type GeoPoint2D = struct {
    x: Float,
    y: Float
};

pub type GeoBBox = struct {
    min_x: Float,
    min_y: Float,
    max_x: Float,
    max_y: Float
};

pub fn geo_point_new(x: Int, y: Int) -> GeoPoint2D {
    return GeoPoint2D {
        x: x as Float,
        y: y as Float
    };
}

pub fn geo_point_x(p: GeoPoint2D) -> Int {
    return p.x as Int;
}

pub fn geo_point2d_new(x: Float, y: Float) -> GeoPoint2D {
    return GeoPoint2D {
        x: x,
        y: y
    };
}

pub fn geo_bbox_new(min_x: Float, min_y: Float, max_x: Float, max_y: Float) -> GeoBBox {
    return GeoBBox {
        min_x: min_x,
        min_y: min_y,
        max_x: max_x,
        max_y: max_y
    };
}

pub fn geo_bbox_empty() -> GeoBBox {
    return GeoBBox {
        min_x: 0.0,
        min_y: 0.0,
        max_x: 0.0,
        max_y: 0.0
    };
}
