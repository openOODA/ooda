// # WGS84 Geodetic Reference System & Coordinates
//
// Logline: Provides WGS-84 reference ellipsoid parameters, geodetic latitude/longitude validation, and angular conversions.
//
// Setup: Geodetic coordinate validation, DMS formatting, and reference ellipsoid constants.
//
// Beats:
//   1. Define WGS84 ellipsoid constants (semi-major axis a, flattening f, eccentricity e^2).
//   2. Validate latitude [-90, 90] and longitude [-180, 180] geodetic bounds.
//   3. Convert between decimal degrees, radians, and degrees-minutes-seconds (DMS).

pub type Wgs84Ellipsoid = struct {
    semi_major_a: Float,
    flattening_f: Float,
    semi_minor_b: Float,
    ecc_sq: Float
};

pub type DmsCoordinate = struct {
    degrees: Int,
    minutes: Int,
    seconds: Float,
    is_negative: Bool
};

pub fn wgs84_math_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn wgs84_deg2rad(deg: Float) -> Float {
    return (deg * wgs84_math_pi()) / 180.0;
}

pub fn wgs84_rad2deg(rad: Float) -> Float {
    return (rad * 180.0) / wgs84_math_pi();
}

pub fn wgs84_ellipsoid_default() -> Wgs84Ellipsoid {
    let a: Float = 6378137.0;
    let f: Float = 1.0 / 298.257223563;
    let b: Float = a * (1.0 - f);
    let e_sq: Float = (2.0 * f) - (f * f);
    return Wgs84Ellipsoid {
        semi_major_a: a,
        flattening_f: f,
        semi_minor_b: b,
        ecc_sq: e_sq
    };
}

pub fn wgs84_is_valid_lat(lat: Float) -> Bool {
    return (lat >= -90.0) && (lat <= 90.0);
}

pub fn wgs84_is_valid_lon(lon: Float) -> Bool {
    return (lon >= -180.0) && (lon <= 180.0);
}

pub fn wgs84_validate(lat: Float, lon: Float) -> Bool {
    return wgs84_is_valid_lat(lat) && wgs84_is_valid_lon(lon);
}

pub fn wgs84_normalize_lon(lon: Float) -> Float {
    let mut n_lon = lon;
    while n_lon > 180.0 {
        n_lon = n_lon - 360.0;
    }
    while n_lon < -180.0 {
        n_lon = n_lon + 360.0;
    }
    return n_lon;
}

pub fn wgs84_deg_to_dms(deg: Float) -> DmsCoordinate {
    let is_neg = deg < 0.0;
    let mut abs_deg = deg;
    if is_neg {
        abs_deg = 0.0 - deg;
    }

    let d_int = abs_deg;
    // approximate integer truncation
    let mut d_count = 0;
    let mut rem = abs_deg;
    while rem >= 1.0 {
        d_count = d_count + 1;
        rem = rem - 1.0;
    }

    let min_float = rem * 60.0;
    let mut m_count = 0;
    let mut sec_rem = min_float;
    while sec_rem >= 1.0 {
        m_count = m_count + 1;
        sec_rem = sec_rem - 1.0;
    }
    let sec_float = sec_rem * 60.0;

    return DmsCoordinate {
        degrees: d_count,
        minutes: m_count,
        seconds: sec_float,
        is_negative: is_neg
    };
}

pub fn wgs84_dms_to_deg(dms: DmsCoordinate) -> Float {
    let d_f = (dms).degrees;
    let m_f = (dms).minutes;
    let total = d_f + (m_f / 60.0) + ((dms).seconds / 3600.0);
    if (dms).is_negative {
        return 0.0 - total;
    }
    return total;
}

pub fn wgs84_antipodal_lat(lat: Float) -> Float {
    return 0.0 - lat;
}

pub fn wgs84_antipodal_lon(lon: Float) -> Float {
    if lon > 0.0 {
        return lon - 180.0;
    }
    return lon + 180.0;
}
