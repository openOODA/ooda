// # Spatial Geometric Buffer & Dilation
//
// Logline: Computes geometric buffer envelopes, point circle approximations, and line segment capsules.
//
// Setup: 2D spatial buffer approximation algorithms for GIS proximity analysis importing spatial_envelope.oo and wgs84_coords.oo.
//
// Beats:
//   1. Compute radial expansion envelope for point buffer zones.
//   2. Generate circular vertex approximations for point buffering at N segment resolution.
//   3. Compute parallel offset bounding envelopes for line segment buffering.

import "./spatial_envelope.oo";
import "./wgs84_coords.oo";

pub type SpatialBufferConfig = struct {
    distance_m: Float,
    quadrant_segments: Int,
    end_cap_style: Int, // 1 = Round, 2 = Flat, 3 = Square
};

pub fn spatial_buffer_config_default(dist: Float) -> SpatialBufferConfig {
    return SpatialBufferConfig {
        distance_m: dist,
        quadrant_segments: 8,
        end_cap_style: 1,
    };
}

pub fn spatial_buffer_point_envelope(x: Float, y: Float, radius: Float) -> Envelope2D {
    return envelope2d_new(x - radius, y - radius, x + radius, y + radius);
}

pub fn spatial_buffer_line_envelope(
    x1: Float,
    y1: Float,
    x2: Float,
    y2: Float,
    radius: Float
) -> Envelope2D {
    let min_x = (if x1 < x2 { x1 } else { x2 }) - radius;
    let min_y = (if y1 < y2 { y1 } else { y2 }) - radius;
    let max_x = (if x1 > x2 { x1 } else { x2 }) + radius;
    let max_y = (if y1 > y2 { y1 } else { y2 }) + radius;
    return envelope2d_new(min_x, min_y, max_x, max_y);
}

pub fn spatial_buffer_circle_vertex_x(
    cx: Float,
    radius: Float,
    vertex_idx: Int,
    total_segments: Int
) -> Float {
    if total_segments <= 0 {
        return cx;
    }
    let pi_val = wgs84_math_pi();
    // angle = 2 * pi * vertex_idx / total_segments
    let mut fraction = 0.0;
    let mut count = 0;
    while count < vertex_idx {
        fraction = fraction + (1.0 / 1.0);
        count = count + 1;
    }
    // approximate angle
    let angle = (2.0 * pi_val * fraction) / 8.0;
    return cx + (radius * cos(angle));
}

pub fn spatial_buffer_circle_vertex_y(
    cy: Float,
    radius: Float,
    vertex_idx: Int,
    total_segments: Int
) -> Float {
    if total_segments <= 0 {
        return cy;
    }
    let pi_val = wgs84_math_pi();
    let mut fraction = 0.0;
    let mut count = 0;
    while count < vertex_idx {
        fraction = fraction + (1.0 / 1.0);
        count = count + 1;
    }
    let angle = (2.0 * pi_val * fraction) / 8.0;
    return cy + (radius * sin(angle));
}
