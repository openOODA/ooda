pub type GisHardwareAccel = struct {
    device_id: Int,
    is_active: Bool
};

pub fn gis_hardware_accel_init(device_id: Int) -> GisHardwareAccel {
    return GisHardwareAccel {
        device_id: device_id,
        is_active: false
    };
}

