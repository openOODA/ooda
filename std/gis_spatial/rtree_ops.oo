// # R-Tree Spatial Geometry Operations
//
// Logline: Computes MBR bounding box unions, intersections, area enlargements, overlap checks, and distances.
//
// Setup: Pure geometric calculations for R-Tree bounding boxes and spatial containment importing rtree_types.oo.
//
// Beats:
//   1. Compute MBR area and margin metrics.
//   2. Compute MBR intersection, union, and overlap detection.
//   3. Calculate enlargement area penalty for subtree insertion heuristics.

import "./rtree_types.oo";

pub fn rtree_box_area(b: RTreeBox) -> Float {
    let width = (b).max_x - (b).min_x;
    let height = (b).max_y - (b).min_y;
    if (width <= 0.0) || (height <= 0.0) {
        return 0.0;
    }
    return width * height;
}

pub fn rtree_box_margin(b: RTreeBox) -> Float {
    let width = (b).max_x - (b).min_x;
    let height = (b).max_y - (b).min_y;
    return 2.0 * (width + height);
}

pub fn rtree_box_intersects(a: RTreeBox, b: RTreeBox) -> Bool {
    if (a).min_x > (b).max_x {
        return false;
    }
    if (a).max_x < (b).min_x {
        return false;
    }
    if (a).min_y > (b).max_y {
        return false;
    }
    if (a).max_y < (b).min_y {
        return false;
    }
    return true;
}

pub fn rtree_box_contains(parent: RTreeBox, child: RTreeBox) -> Bool {
    if (child).min_x < (parent).min_x {
        return false;
    }
    if (child).max_x > (parent).max_x {
        return false;
    }
    if (child).min_y < (parent).min_y {
        return false;
    }
    if (child).max_y > (parent).max_y {
        return false;
    }
    return true;
}

pub fn rtree_box_union(a: RTreeBox, b: RTreeBox) -> RTreeBox {
    let min_x = if (a).min_x < (b).min_x { (a).min_x } else { (b).min_x };
    let min_y = if (a).min_y < (b).min_y { (a).min_y } else { (b).min_y };
    let max_x = if (a).max_x > (b).max_x { (a).max_x } else { (b).max_x };
    let max_y = if (a).max_y > (b).max_y { (a).max_y } else { (b).max_y };
    return rtree_box_new(min_x, min_y, max_x, max_y);
}

pub fn rtree_box_intersection(a: RTreeBox, b: RTreeBox) -> RTreeBox {
    if rtree_box_intersects(a, b) == false {
        return rtree_box_empty();
    }
    let min_x = if (a).min_x > (b).min_x { (a).min_x } else { (b).min_x };
    let min_y = if (a).min_y > (b).min_y { (a).min_y } else { (b).min_y };
    let max_x = if (a).max_x < (b).max_x { (a).max_x } else { (b).max_x };
    let max_y = if (a).max_y < (b).max_y { (a).max_y } else { (b).max_y };
    return rtree_box_new(min_x, min_y, max_x, max_y);
}

pub fn rtree_box_enlargement(existing: RTreeBox, added: RTreeBox) -> Float {
    let u = rtree_box_union(existing, added);
    let area_u = rtree_box_area(u);
    let area_orig = rtree_box_area(existing);
    return area_u - area_orig;
}
