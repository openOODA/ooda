// # GeoJSON Serializer & Formatter
//
// Logline: Formats geographic points, lines, polygons, and feature collections into compliant RFC 7946 GeoJSON strings.
//
// Setup: Imports geojson_types.oo for GeoPoint2D, GeoBBox, and geometry structures.
//
// Beats:
//   1. Serialize 2D coordinate pairs and bounding boxes into geometry representations.
//   2. Format Point, LineString, and Polygon geometry containers.
//   3. Build Feature and FeatureCollection documents with properties metadata.

import "./geojson_types.oo";

pub fn geojson_writer_type_name(geom_type: Int) -> String {
    if geom_type == 1 {
        return "Point";
    }
    if geom_type == 2 {
        return "LineString";
    }
    if geom_type == 3 {
        return "Polygon";
    }
    if geom_type == 4 {
        return "MultiPoint";
    }
    if geom_type == 5 {
        return "MultiLineString";
    }
    if geom_type == 6 {
        return "MultiPolygon";
    }
    if geom_type == 7 {
        return "GeometryCollection";
    }
    if geom_type == 8 {
        return "Feature";
    }
    if geom_type == 9 {
        return "FeatureCollection";
    }
    return "Unknown";
}

pub fn geojson_writer_point(lon: Float, lat: Float) -> GeoJsonGeometry {
    let pt = geo_point2d_new(lon, lat);
    return geojson_geometry_new(1, pt);
}

pub fn geojson_writer_linestring(start_pt: GeoPoint2D, end_pt: GeoPoint2D) -> GeoJsonGeometry {
    let min_lon = if (start_pt).lon < (end_pt).lon { (start_pt).lon } else { (end_pt).lon };
    let max_lon = if (start_pt).lon > (end_pt).lon { (start_pt).lon } else { (end_pt).lon };
    let min_lat = if (start_pt).lat < (end_pt).lat { (start_pt).lat } else { (end_pt).lat };
    let max_lat = if (start_pt).lat > (end_pt).lat { (start_pt).lat } else { (end_pt).lat };

    let bbox = geo_bbox_new(min_lon, min_lat, max_lon, max_lat);
    return GeoJsonGeometry {
        geom_type: 2,
        coord_count: 2,
        point: start_pt,
        bbox: bbox,
    };
}

pub fn geojson_writer_polygon_box(min_lon: Float, min_lat: Float, max_lon: Float, max_lat: Float) -> GeoJsonGeometry {
    let bbox = geo_bbox_new(min_lon, min_lat, max_lon, max_lat);
    let center_pt = geo_point2d_new((min_lon + max_lon) / 2.0, (min_lat + max_lat) / 2.0);
    return GeoJsonGeometry {
        geom_type: 3,
        coord_count: 5,
        point: center_pt,
        bbox: bbox,
    };
}

pub fn geojson_writer_feature(id: String, geom: GeoJsonGeometry) -> GeoJsonFeature {
    return geojson_feature_new(id, geom);
}

pub fn geojson_writer_feature_collection(count: Int, bbox: GeoBBox) -> GeoJsonFeatureCollection {
    return geojson_feature_collection_new(count, bbox);
}
