// # Sutherland-Hodgman polygon clip
//
// Logline: Clips a subject polygon against an arbitrary convex clip polygon using sequential half-plane cuts.
//
// Setup: Pure. Vertices are interleaved List[Float] x,y. Clip polygon is convex and CCW.
//
// Beats:
//   1. Reject a subject or clip list with an odd length or fewer than 3 clip vertices.
//   2. Clip against each directed clip edge in order.
//   3. Emit intersection points on crossing edges, including vertex-on-edge hits.
//   4. Return an empty vertex list when the subject is fully outside.

pub type PolyOut = struct {
    flag: Int,
    err: String,
    n: Int,
    xy: List[Float]
};

fn poly_n(xy: List[Float]) -> Int {
    return list_len(xy) / 2;
}

fn poly_x(xy: List[Float], i: Int) -> Float {
    return list_get(xy, i * 2);
}

fn poly_y(xy: List[Float], i: Int) -> Float {
    return list_get(xy, i * 2 + 1);
}

fn poly_push(xy: List[Float], x: Float, y: Float) -> List[Float] {
    let mut o: List[Float] = xy;
    o = list_push(o, x);
    o = list_push(o, y);
    return o;
}

fn poly_cross(ax: Float, ay: Float, bx: Float, by: Float) -> Float {
    return ax * by - ay * bx;
}

fn poly_inside(px: Float, py: Float, c1x: Float, c1y: Float, c2x: Float, c2y: Float) -> Int {
    let cr: Float = poly_cross(c2x - c1x, c2y - c1y, px - c1x, py - c1y);
    if cr >= 0.0 {
        return 1;
    }
    return 0;
}

fn poly_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

fn poly_intersect_x(p1x: Float, p1y: Float, p2x: Float, p2y: Float, c1x: Float, c1y: Float, c2x: Float, c2y: Float) -> Float {
    let dpx: Float = p2x - p1x;
    let dpy: Float = p2y - p1y;
    let dcx: Float = c2x - c1x;
    let dcy: Float = c2y - c1y;
    let den: Float = poly_cross(dpx, dpy, dcx, dcy);
    if poly_abs(den) <= 0.000000000000001 {
        return p1x;
    }
    let t: Float = poly_cross(c1x - p1x, c1y - p1y, dcx, dcy) / den;
    return p1x + t * dpx;
}

fn poly_intersect_y(p1x: Float, p1y: Float, p2x: Float, p2y: Float, c1x: Float, c1y: Float, c2x: Float, c2y: Float) -> Float {
    let dpx: Float = p2x - p1x;
    let dpy: Float = p2y - p1y;
    let dcx: Float = c2x - c1x;
    let dcy: Float = c2y - c1y;
    let den: Float = poly_cross(dpx, dpy, dcx, dcy);
    if poly_abs(den) <= 0.000000000000001 {
        return p1y;
    }
    let t: Float = poly_cross(c1x - p1x, c1y - p1y, dcx, dcy) / den;
    return p1y + t * dpy;
}

fn poly_ok(xy: List[Float]) -> PolyOut {
    return PolyOut { flag: 1, err: "", n: list_len(xy) / 2, xy: xy };
}

fn poly_err(m: String) -> PolyOut {
    let empty: List[Float] = list_new();
    return PolyOut { flag: 0, err: m, n: 0, xy: empty };
}

fn poly_clip_edge(subj: List[Float], c1x: Float, c1y: Float, c2x: Float, c2y: Float) -> List[Float] {
    let m: Int = list_len(subj) / 2;
    let mut out: List[Float] = list_new();
    if m < 1 {
        return out;
    }
    let mut i: Int = 0;
    while i < m {
        let mut j2: Int = i + 1;
        if j2 >= m {
            j2 = 0;
        }
        let x1: Float = list_get(subj, i * 2);
        let y1: Float = list_get(subj, i * 2 + 1);
        let x2: Float = list_get(subj, j2 * 2);
        let y2: Float = list_get(subj, j2 * 2 + 1);
        let in1: Int = poly_inside(x1, y1, c1x, c1y, c2x, c2y);
        let in2: Int = poly_inside(x2, y2, c1x, c1y, c2x, c2y);
        if in2 > 0 {
            if in1 < 1 {
                out = list_push(out, poly_intersect_x(x1, y1, x2, y2, c1x, c1y, c2x, c2y));
                out = list_push(out, poly_intersect_y(x1, y1, x2, y2, c1x, c1y, c2x, c2y));
            }
            out = list_push(out, x2);
            out = list_push(out, y2);
        } else {
            if in1 > 0 {
                out = list_push(out, poly_intersect_x(x1, y1, x2, y2, c1x, c1y, c2x, c2y));
                out = list_push(out, poly_intersect_y(x1, y1, x2, y2, c1x, c1y, c2x, c2y));
            }
        }
        i = i + 1;
    }
    return out;
}

pub fn poly_clip_2d(subj: List[Float], clip: List[Float]) -> PolyOut {
    if list_len(subj) % 2 != 0 {
        return poly_err("poly odd");
    }
    if list_len(clip) % 2 != 0 {
        return poly_err("poly odd");
    }
    let cn: Int = list_len(clip) / 2;
    if cn < 3 {
        return poly_err("poly clip");
    }
    let mut cur: List[Float] = subj;
    let mut e: Int = 0;
    while e < cn {
        let e2: Int = e + 1;
        let mut e2m: Int = e2;
        if e2m >= cn {
            e2m = 0;
        }
        cur = poly_clip_edge(cur, list_get(clip, e * 2), list_get(clip, e * 2 + 1), list_get(clip, e2m * 2), list_get(clip, e2m * 2 + 1));
        e = e + 1;
    }
    return poly_ok(cur);
}

pub fn poly_clip_2d_stat(subj: List[Float], clip: List[Float]) -> Result[Int, String] {
    let o: PolyOut = poly_clip_2d(subj, clip);
    if o.flag < 1 {
        return Err(o.err);
    }
    return Ok(o.n);
}
