// # Untrusted peer mark
//
// Logline: Detects peer text that must not flow into patch, process_exec, or policy write.
//
// Setup: The process policy key OODA_UNTRUSTED holds the exact blob. Empty means no mark.
//
// Beats:
//   1. untrusted_blob_in is true when the haystack contains the blob.
//   2. untrusted_sink_denied is true for patch, process_exec, and policy write when marked.
//   3. Trusted workspace text with no mark is allowed.

fn untrusted_has_sub(s: String, sub: String) -> Bool {
    let n: Int = chars_len(s);
    let m: Int = chars_len(sub);
    if m == 0 {
        return true;
    }
    if m > n {
        return false;
    }
    let mut i: Int = 0;
    while i + m <= n {
        if str_slice(s, i, i + m) == sub {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn untrusted_blob_in(hay: String, blob: String) -> Bool {
    if blob == "" {
        return false;
    }
    return untrusted_has_sub(hay, blob);
}

pub fn untrusted_sink_denied(sink: String, marked: Bool) -> Bool {
    if !marked {
        return false;
    }
    if sink == "patch" {
        return true;
    }
    if sink == "process_exec" {
        return true;
    }
    if sink == "policy" {
        return true;
    }
    return false;
}
