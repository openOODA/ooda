// # Agent send hop gate
//
// Logline: Sends a peer text message only at hop 0 or hop 1 and refuses a capability in the body.
//
// Setup: OODA_MSG_HOP must be 0 or 1. Empty is denied. OODA_FS_WRITEDIR is the mailbox dir.
//
// Beats:
//   1. Empty hop, hop 2, and any other hop value fail closed.
//   2. A body that names &NameCap or oo_cap_grant fails closed.
//   3. A hop 0 or hop 1 send writes the body to a mailbox file and does not write a token.

import "std/sec/untrusted.oo";

fn hop_ok(raw: String) -> Bool {
    if raw == "0" {
        return true;
    }
    if raw == "1" {
        return true;
    }
    return false;
}

fn is_ascii_letter(c: String) -> Bool {
    let letters: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
    let n: Int = chars_len(letters);
    let mut i: Int = 0;
    while i < n {
        if char_at(letters, i) == c {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn peer_ok(peer: String) -> Bool {
    if peer == "" {
        return false;
    }
    let n: Int = chars_len(peer);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(peer, i);
        if c == "/" {
            return false;
        }
        if c == "." {
            return false;
        }
        if c == "\\" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn msg_carries_token(body: String) -> Bool {
    if untrusted_blob_in(body, "oo_cap_grant") {
        return true;
    }
    let n: Int = chars_len(body);
    let mut i: Int = 0;
    while i < n {
        if char_at(body, i) == "&" {
            let mut j: Int = i + 1;
            while j < n {
                if !is_ascii_letter(char_at(body, j)) {
                    break;
                }
                j = j + 1;
            }
            if j >= i + 5 {
                if str_slice(body, j - 3, j) == "Cap" {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn msg_hop_allowed(hop: String) -> Bool {
    return hop_ok(hop);
}

pub fn agent_send(env: &EnvCap, fw: &FsWriteCap, peer: String, body: String) -> Result[Bool, String] {
    if !peer_ok(peer) {
        return Err("agent_send denied: bad peer");
    }
    if msg_carries_token(body) {
        return Err("agent_send denied: capability in message");
    }
    let hr: Result[String, String] = env_get(env, "OODA_MSG_HOP");
    let hop: String = match hr {
        Ok(s) => s,
        Err(_) => ""
    };
    if !hop_ok(hop) {
        return Err("agent_send denied: hop");
    }
    let dr: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
    if dr.is_err() {
        return Err("agent_send denied: no writedir");
    }
    let dir: String = match dr {
        Ok(s) => s,
        Err(m) => m
    };
    let path: String = dir + "/mbox-" + peer;
    let wr = write_file(fw, path, body);
    if wr.is_err() {
        return Err("agent_send denied: mailbox write");
    }
    return Ok(true);
}
