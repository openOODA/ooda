// # Agent send hop gate
//
// Logline: Sends a peer text message only at hop 0 or hop 1 and refuses a capability in the body.
//
// Setup: OODA_MSG_HOP is 0, 1, or empty (treated as 0). OODA_FS_WRITEDIR is the mailbox dir.
//
// Beats:
//   1. Hop 2 and any other hop value fail closed.
//   2. A body that names a capability token fails closed.
//   3. A hop 0 or hop 1 send writes the body to a mailbox file and does not write a token.

import "std/sec/untrusted.oo";

fn hop_ok(raw: String) -> Bool {
    if raw == "" {
        return true;
    }
    if raw == "0" {
        return true;
    }
    if raw == "1" {
        return true;
    }
    return false;
}

fn peer_ok(peer: String) -> Bool {
    if peer == "" {
        return false;
    }
    let n: Int = chars_len(peer);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(peer, i);
        if c == "/" {
            return false;
        }
        if c == "." {
            return false;
        }
        if c == "\\" {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn msg_carries_token(body: String) -> Bool {
    if untrusted_blob_in(body, "oo_cap_grant") {
        return true;
    }
    if untrusted_blob_in(body, "&FsWriteCap") {
        return true;
    }
    if untrusted_blob_in(body, "&FsReadCap") {
        return true;
    }
    if untrusted_blob_in(body, "&ProcessCap") {
        return true;
    }
    if untrusted_blob_in(body, "&SysCap") {
        return true;
    }
    if untrusted_blob_in(body, "&NetCap") {
        return true;
    }
    if untrusted_blob_in(body, "&MsgCap") {
        return true;
    }
    if untrusted_blob_in(body, "&EnvCap") {
        return true;
    }
    if untrusted_blob_in(body, "&TimeCap") {
        return true;
    }
    if untrusted_blob_in(body, "&HttpCap") {
        return true;
    }
    if untrusted_blob_in(body, "&TcpCap") {
        return true;
    }
    if untrusted_blob_in(body, "&UdpCap") {
        return true;
    }
    if untrusted_blob_in(body, "&AllocCap") {
        return true;
    }
    if untrusted_blob_in(body, "&ThreadCap") {
        return true;
    }
    if untrusted_blob_in(body, "&RandCap") {
        return true;
    }
    return false;
}

pub fn msg_hop_allowed(hop: String) -> Bool {
    return hop_ok(hop);
}

pub fn agent_send(env: &EnvCap, fw: &FsWriteCap, peer: String, body: String) -> Result[Bool, String] {
    if !peer_ok(peer) {
        return Err("agent_send denied: bad peer");
    }
    if msg_carries_token(body) {
        return Err("agent_send denied: capability in message");
    }
    let hr: Result[String, String] = env_get(env, "OODA_MSG_HOP");
    let hop: String = match hr {
        Ok(s) => s,
        Err(_) => ""
    };
    if !hop_ok(hop) {
        return Err("agent_send denied: hop");
    }
    let dr: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
    if dr.is_err() {
        return Err("agent_send denied: no writedir");
    }
    let dir: String = match dr {
        Ok(s) => s,
        Err(m) => m
    };
    let path: String = dir + "/mbox-" + peer;
    let wr = write_file(fw, path, body);
    if wr.is_err() {
        return Err("agent_send denied: mailbox write");
    }
    return Ok(true);
}
