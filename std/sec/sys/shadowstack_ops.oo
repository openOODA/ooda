// # Hardware Shadow Stack Operations
//
// Logline: Push/pop/peek/verify on four return-address slots. Destubbed off List[ShadowStackFrame].
//
// Setup: Imports shadowstack_types.oo. last_ok 0 on overflow/underflow.
//
// Beats:
//   1. Push stores ret at top; pop decrements; overflow when top>=max or top>=4.
//   2. Verify top matches expected return address.
//   3. Policy: user-mode SS requires hardware SS.
// residual: List[struct] destubbed to fixed Int slots.

import "./shadowstack_types.oo";

pub fn shadowstack_frame_create(frame_id_val: Int, ret_addr: Int) -> ShadowStackFrame {
    return shadow_stack_frame_new(frame_id_val, ret_addr);
}

pub fn shadowstack_new(max_depth_val: Int) -> ShadowStack {
    return shadow_stack_new(max_depth_val);
}

pub fn shadowstack_policy_default() -> ShadowStackPolicy {
    return shadow_stack_policy_new(1, 1, 1);
}

pub fn shadowstack_policy_validate(p: ShadowStackPolicy) -> Int {
    if p.enable_hardware_ss == 0 {
        if p.enable_user_mode_ss == 1 {
            return 0;
        }
    }
    return 1;
}

pub fn shadowstack_slot_cap() -> Int {
    return 4;
}

pub fn shadowstack_push(stack: ShadowStack, frame: ShadowStackFrame) -> ShadowStack {
    let t: Int = stack.top_index;
    let m: Int = stack.max_depth;
    if t >= m {
        return ShadowStack {
            top_index: t,
            max_depth: m,
            ret0: stack.ret0,
            ret1: stack.ret1,
            ret2: stack.ret2,
            ret3: stack.ret3,
            last_ok: 0
        };
    }
    if t >= 4 {
        return ShadowStack {
            top_index: t,
            max_depth: m,
            ret0: stack.ret0,
            ret1: stack.ret1,
            ret2: stack.ret2,
            ret3: stack.ret3,
            last_ok: 0
        };
    }
    let addr: Int = frame.return_address;
    let mut r0: Int = stack.ret0;
    let mut r1: Int = stack.ret1;
    let mut r2: Int = stack.ret2;
    let mut r3: Int = stack.ret3;
    if t == 0 {
        r0 = addr;
    }
    if t == 1 {
        r1 = addr;
    }
    if t == 2 {
        r2 = addr;
    }
    if t == 3 {
        r3 = addr;
    }
    return ShadowStack {
        top_index: t + 1,
        max_depth: m,
        ret0: r0,
        ret1: r1,
        ret2: r2,
        ret3: r3,
        last_ok: 1
    };
}

pub fn shadowstack_pop(stack: ShadowStack) -> ShadowStack {
    let t: Int = stack.top_index;
    if t == 0 {
        return ShadowStack {
            top_index: 0,
            max_depth: stack.max_depth,
            ret0: stack.ret0,
            ret1: stack.ret1,
            ret2: stack.ret2,
            ret3: stack.ret3,
            last_ok: 0
        };
    }
    return ShadowStack {
        top_index: t - 1,
        max_depth: stack.max_depth,
        ret0: stack.ret0,
        ret1: stack.ret1,
        ret2: stack.ret2,
        ret3: stack.ret3,
        last_ok: 1
    };
}

pub fn shadowstack_top_addr(stack: ShadowStack) -> Int {
    let t: Int = stack.top_index;
    if t == 0 {
        return 0;
    }
    if t == 1 {
        return stack.ret0;
    }
    if t == 2 {
        return stack.ret1;
    }
    if t == 3 {
        return stack.ret2;
    }
    return stack.ret3;
}

pub fn shadowstack_verify_top(stack: ShadowStack, expected_ret_addr: Int) -> Int {
    if stack.top_index == 0 {
        return 0;
    }
    let top: Int = shadowstack_top_addr(stack);
    if top == expected_ret_addr {
        return 1;
    }
    return 0;
}
