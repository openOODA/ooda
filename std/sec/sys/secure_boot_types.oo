type SecureBootViolation = struct {
    violation_type: Int,
    action_taken: Int
};

pub fn sboot_violation_new(violation_type: Int, action_taken: Int) -> SecureBootViolation {
    return SecureBootViolation {
        violation_type: violation_type,
        action_taken: action_taken
    };
}

pub fn sboot_violation_type(v: SecureBootViolation) -> Int {
    return v.violation_type;
}
