// ===================================================================
// openOODA Standard Library — ooda::sec::sys::objcap_rights
// Capability rights masks and cap constructors
// (split from objcap.oo, M172)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./objcap_types.oo";

pub fn capability_rights_from_mask(mask_val: Int) -> CapabilityRights {
    let r_r: Bool = (mask_val / 1) % 2 != 0;
    let r_w: Bool = (mask_val / 2) % 2 != 0;
    let r_x: Bool = (mask_val / 4) % 2 != 0;
    let r_d: Bool = (mask_val / 8) % 2 != 0;
    let r_v: Bool = (mask_val / 16) % 2 != 0;
    return CapabilityRights {
        allow_read: r_r,
        allow_write: r_w,
        allow_execute: r_x,
        allow_delegate: r_d,
        allow_revoke: r_v,
    };
}

pub fn capability_rights_to_mask(rights_struct: CapabilityRights) -> Int {
    let mut mask_res: Int = 0;
    if rights_struct.allow_read {
        mask_res = mask_res + 1;
    }
    if rights_struct.allow_write {
        mask_res = mask_res + 2;
    }
    if rights_struct.allow_execute {
        mask_res = mask_res + 4;
    }
    if rights_struct.allow_delegate {
        mask_res = mask_res + 8;
    }
    if rights_struct.allow_revoke {
        mask_res = mask_res + 16;
    }
    return mask_res;
}

pub fn capability_rights_format_str(rights_struct: CapabilityRights) -> String {
    let mut res: String = "";
    if rights_struct.allow_read {
        res = res + "r";
    } else {
        res = res + "-";
    }
    if rights_struct.allow_write {
        res = res + "w";
    } else {
        res = res + "-";
    }
    if rights_struct.allow_execute {
        res = res + "x";
    } else {
        res = res + "-";
    }
    if rights_struct.allow_delegate {
        res = res + "d";
    } else {
        res = res + "-";
    }
    if rights_struct.allow_revoke {
        res = res + "v";
    } else {
        res = res + "-";
    }
    return res;
}

pub fn capability_rights_has_permission(granted_mask_val: Int, required_mask_val: Int) -> Bool {
    let granted_r: CapabilityRights = capability_rights_from_mask(granted_mask_val);
    let req_r: CapabilityRights = capability_rights_from_mask(required_mask_val);

    if req_r.allow_read && (granted_r.allow_read == false) {
        return false;
    }
    if req_r.allow_write && (granted_r.allow_write == false) {
        return false;
    }
    if req_r.allow_execute && (granted_r.allow_execute == false) {
        return false;
    }
    if req_r.allow_delegate && (granted_r.allow_delegate == false) {
        return false;
    }
    if req_r.allow_revoke && (granted_r.allow_revoke == false) {
        return false;
    }
    return true;
}

// -------------------------------------------------------------------
// ObjectCapability Constructors & Inspection
// -------------------------------------------------------------------

pub fn objcap_create(
    cap_id_val: String,
    res_uri_val: String,
    owner_id_val: String,
    rights_bitmask: Int,
    timestamp_val: Int,
    ttl_val: Int
) -> ObjectCapability {
    let r_struct: CapabilityRights = capability_rights_from_mask(rights_bitmask);
    let r_str: String = capability_rights_format_str(r_struct);
    let mut expires: Int = 0;
    if ttl_val > 0 {
        expires = timestamp_val + ttl_val;
    }
    let mut valid: Bool = true;
    let cid_len: Int = cap_id_val.len();
    let ruri_len: Int = res_uri_val.len();
    if cid_len == 0 || ruri_len == 0 {
        valid = false;
    }
    return ObjectCapability {
        cap_id: cap_id_val,
        resource_uri: res_uri_val,
        owner_id: owner_id_val,
        rights: rights_bitmask,
        rights_mask: r_str,
        parent_cap_id: "",
        attenuation_id: "",
        revocation_id: "",
        issued_at: timestamp_val,
        expires_at: expires,
        is_sealed: false,
        is_valid: valid,
    };
}

pub fn objcap_is_expired(cap_ref: &ObjectCapability, current_time: Int) -> Bool {
    let exp: Int = (cap_ref).expires_at;
    if exp > 0 {
        if current_time >= exp {
            return true;
        }
    }
    return false;
}

pub fn objcap_validate(cap_ref: &ObjectCapability, current_time: Int) -> Bool {
    if (cap_ref).is_valid == false {
        return false;
    }
    if (cap_ref).is_sealed {
        return false;
    }
    let c_id: String = (cap_ref).cap_id;
    let cid_len: Int = c_id.len();
    if cid_len == 0 {
        return false;
    }
    let r_uri: String = (cap_ref).resource_uri;
    let ruri_len: Int = r_uri.len();
    if ruri_len == 0 {
        return false;
    }
    if objcap_is_expired(cap_ref, current_time) {
        return false;
    }
    return true;
}

pub fn objcap_has_right(cap_ref: &ObjectCapability, required_right_val: Int) -> Bool {
    if (cap_ref).is_valid == false {
        return false;
    }
    let c_rights: Int = (cap_ref).rights;
    return capability_rights_has_permission(c_rights, required_right_val);
}
