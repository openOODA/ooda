// # Linux Kernel Audit Operations & Filtering
//
// Logline: Implements event constructors, permission bitmask arithmetic, rule evaluation, and well-known watch templates.
//
// Setup: Imports kernel_audit_types.oo and kernel_audit_const.oo for pure filtering and rule generation.
//
// Beats:
//   1. Construct audit events, rules, and default daemon status.
//   2. Compute permission bitmask combinations and removals safely.
//   3. Implement event filtering logic and standard watch rule templates (/etc/passwd, shadow, sudoers, execve).

import "./kernel_audit_types.oo";
import "./kernel_audit_const.oo";

pub fn audit_event_new(
    event_id_val: String,
    ts_val: Int,
    syscall_nr_val: Int,
    pid_val: Int,
    uid_val: Int,
    auid_val: Int,
    success_val: Bool,
    exe_val: String,
    key_val: String
) -> AuditEvent {
    return AuditEvent {
        event_id: event_id_val,
        timestamp: ts_val,
        syscall_nr: syscall_nr_val,
        pid: pid_val,
        uid: uid_val,
        auid: auid_val,
        success: success_val,
        exe: exe_val,
        key: key_val,
        raw_record: "",
    };
}

pub fn audit_event_with_raw(
    event_id_val: String,
    ts_val: Int,
    syscall_nr_val: Int,
    pid_val: Int,
    uid_val: Int,
    auid_val: Int,
    success_val: Bool,
    exe_val: String,
    key_val: String,
    raw_val: String
) -> AuditEvent {
    return AuditEvent {
        event_id: event_id_val,
        timestamp: ts_val,
        syscall_nr: syscall_nr_val,
        pid: pid_val,
        uid: uid_val,
        auid: auid_val,
        success: success_val,
        exe: exe_val,
        key: key_val,
        raw_record: raw_val,
    };
}

pub fn audit_rule_new(
    rule_id_val: String,
    watch_val: String,
    perm_mask_val: Int,
    key_val: String
) -> AuditRule {
    return AuditRule {
        rule_id: rule_id_val,
        watch_list: watch_val,
        perm_mask: perm_mask_val,
        key: key_val,
        list: audit_list_watch(),
        action: audit_action_always(),
        fields: list_new(),
        enabled: true,
    };
}

pub fn audit_status_default() -> AuditStatus {
    return AuditStatus {
        status_id: "AUDIT_STATUS_DEFAULT",
        enabled: true,
        backlog_limit: 1024,
        backlog_count: 0,
        lost_events: 0,
        rate_limit: 0,
        is_active: true,
    };
}

pub fn audit_perm_has(mask: Int, perm: Int) -> Bool {
    let anded: Int = mask & perm;
    return anded != 0;
}

pub fn audit_perm_add(mask: Int, perm: Int) -> Int {
    return mask | perm;
}

pub fn audit_perm_remove(mask: Int, perm: Int) -> Int {
    let inv: Int = 2147483647 - (perm - 1);
    return mask & inv;
}

pub fn audit_should_emit(rule: &AuditRule, syscall_nr: Int, success: Bool) -> Bool {
    if (rule).enabled == false {
        return false;
    }
    if (rule).action == 0 {
        return false;
    }
    return true;
}

pub fn audit_filter_by_pid(events: &List[AuditEvent], pid_lookup: Int) -> Int {
    let n: Int = list_len(events);
    let mut matches: Int = 0;
    let mut i = 0;
    while i < n {
        let e = list_get(events, i);
        if e.pid == pid_lookup {
            let cur_m: Int = matches;
            let one: Int = 1;
            matches = cur_m + one;
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return matches;
}

pub fn audit_filter_by_key(events: &List[AuditEvent], key_lookup: String) -> Int {
    let n: Int = list_len(events);
    let mut matches: Int = 0;
    let mut i = 0;
    while i < n {
        let e = list_get(events, i);
        if e.key == key_lookup {
            let cur_m: Int = matches;
            let one: Int = 1;
            matches = cur_m + one;
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return matches;
}

pub fn audit_rule_watch_passwd() -> AuditRule {
    return audit_rule_new(
        "AUDIT_RULE_PASSWD",
        "/etc/passwd",
        audit_perm_write() + audit_perm_attr(),
        "passwd-change"
    );
}

pub fn audit_rule_watch_shadow() -> AuditRule {
    return audit_rule_new(
        "AUDIT_RULE_SHADOW",
        "/etc/shadow",
        audit_perm_write() + audit_perm_attr(),
        "shadow-change"
    );
}

pub fn audit_rule_watch_sudoers() -> AuditRule {
    return audit_rule_new(
        "AUDIT_RULE_SUDOERS",
        "/etc/sudoers",
        audit_perm_write() + audit_perm_attr(),
        "sudoers-change"
    );
}

pub fn audit_rule_syscall_execve() -> AuditRule {
    return audit_rule_new(
        "AUDIT_RULE_EXECVE",
        "execve",
        audit_perm_exec(),
        "exec"
    );
}

pub fn __dummy_std_src_ooda_sec_sys_kernel_audit_ops_oo() -> Int {
    return 0;
}
