// # Hardware Shadow Stack Control Stubs
//
// Logline: Provides fail-closed residual stubs for CPU CR4.CET activation, WRSS, and RDSS shadow stack pointer MSRs.
//
// Setup: Requires SysCap token; terminates fail-closed due to compiler native CPU CET MSR boundary limitations.
//
// Beats:
//   1. Provide stub for activating CPU hardware shadow stack controls (CR4.CET).
//   2. Provide stub for writing shadow stack pointer (WRSSPQ/WRUSSQ).
//   3. Provide stub for reading shadow stack pointer (RDSSPQ/RDUSSQ).

import "./shadowstack_types.oo";

pub type SysCap = struct {};

pub fn shadowstack_activate_hardware(sys: &SysCap, p: &ShadowStackPolicy) -> Result[Bool, String] {
    // COMPILER LIMITATION: openOODA lacks CR4 CET-bit (CR4.CET=23) and ARCH_CET controls for activating
    // Intel CET-SS / ARM PAC shadow-stack hardware pages.
    process_exit(1);
    return Err("Unimplemented: hardware shadow-stack activation requires CPU CET control FFI lowering");
}

pub fn shadowstack_write_ssp(sys: &SysCap, value: Int) -> Result[Bool, String] {
    // COMPILER LIMITATION: openOODA lacks WRSSPQ/WRUSSQ MSR writes for shadow-stack pointer control.
    process_exit(1);
    return Err("Unimplemented: SSP write requires WRSS* MSR intrinsic lowering");
}

pub fn shadowstack_read_ssp(sys: &SysCap) -> Result[Int, String] {
    // COMPILER LIMITATION: openOODA lacks RDSSPQ/RDUSSQ MSR reads for shadow-stack pointer query.
    process_exit(1);
    return Err("Unimplemented: SSP read requires RDSS* MSR intrinsic lowering");
}

pub fn __dummy_std_src_ooda_sec_sys_shadowstack_stubs_oo() -> Int {
    return 0;
}
