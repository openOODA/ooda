pub fn shim_marker_gadget_type_pop_reg() -> Int {
    return gadget_type_pop_reg();
}

pub fn shim_marker_rop_arch_x86_64() -> Int {
    return rop_arch_x86_64();
}

pub fn shim_marker_rop_gadget_create() -> RopGadget {
    let insts: List[String] = list_new();
    let bytes: List[Int] = list_new();
    return rop_gadget_create("g1", 4194304, insts, bytes, 8, 1);
}

pub fn shim_marker_gadget_chain_new() -> GadgetChain {
    return gadget_chain_new("c1", "x86_64");
}

pub fn shim_marker_gadget_scanner_new() -> GadgetScanner {
    return gadget_scanner_new("s1", "binary", 10);
}

pub fn shim_marker_gadget_scanner_do_work(scanner: &GadgetScanner) -> Int {
    return gadget_scanner_do_work(scanner);
}

