// # ELF Specification Constants
//
// Logline: Provide ELF magic, EI_CLASS, EI_DATA, E_TYPE, E_MACHINE, P_TYPE, and SH_TYPE constant tags.
//
// Setup: Imports elf_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. elf_magic_0..3: return 0x7F, 'E', 'L', 'F' bytes.
//   2. elf_class_*: return 32/64 class tags.
//   3. elf_data_*: return 2LSB/2MSB data tags.
//   4. elf_em_*: return machine tags (x86_64, aarch64, riscv64).
//
// residual: constants only.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./elf_types.oo";

// -------------------------------------------------------------------
// ELF Specification Constants
// -------------------------------------------------------------------

pub fn elf_magic_0() -> Int {
    return 127; // 0x7F
}

pub fn elf_magic_1() -> Int {
    return 69; // 'E'
}

pub fn elf_magic_2() -> Int {
    return 76; // 'L'
}

pub fn elf_magic_3() -> Int {
    return 70; // 'F'
}

pub fn elf_class_none() -> Int {
    return 0;
}

pub fn elf_class_32() -> Int {
    return 1;
}

pub fn elf_class_64() -> Int {
    return 2;
}

pub fn elf_data_none() -> Int {
    return 0;
}

pub fn elf_data_2lsb() -> Int {
    return 1; // Little Endian
}

pub fn elf_data_2msb() -> Int {
    return 2; // Big Endian
}

pub fn elf_et_none() -> Int {
    return 0;
}

pub fn elf_et_rel() -> Int {
    return 1; // Relocatable file
}

pub fn elf_et_exec() -> Int {
    return 2; // Executable file
}

pub fn elf_et_dyn() -> Int {
    return 3; // Shared object or Position Independent Executable
}

pub fn elf_et_core() -> Int {
    return 4; // Core file
}

pub fn elf_em_none() -> Int {
    return 0;
}

pub fn elf_em_386() -> Int {
    return 3; // Intel 80386
}

pub fn elf_em_arm() -> Int {
    return 40; // ARM 32-bit
}

pub fn elf_em_x86_64() -> Int {
    return 62; // AMD x86-64
}

pub fn elf_em_aarch64() -> Int {
    return 183; // ARM 64-bit
}

pub fn elf_em_riscv() -> Int {
    return 243; // RISC-V
}

pub fn pt_null() -> Int {
    return 0;
}

pub fn pt_load() -> Int {
    return 1;
}

pub fn pt_dynamic() -> Int {
    return 2;
}

pub fn pt_interp() -> Int {
    return 3;
}

pub fn pt_note() -> Int {
    return 4;
}

pub fn pt_phdr() -> Int {
    return 6;
}

pub fn pt_gnu_eh_frame() -> Int {
    return 1685382480; // 0x6474e550
}

pub fn pt_gnu_stack() -> Int {
    return 1685382481; // 0x6474e551
}

pub fn pt_gnu_relro() -> Int {
    return 1685382482; // 0x6474e552
}

pub fn pf_x() -> Int {
    return 1;
}

pub fn pf_w() -> Int {
    return 2;
}

pub fn pf_r() -> Int {
    return 4;
}

pub fn sht_null() -> Int {
    return 0;
}

pub fn sht_progbits() -> Int {
    return 1;
}

pub fn sht_symtab() -> Int {
    return 2;
}

pub fn sht_strtab() -> Int {
    return 3;
}

pub fn sht_rela() -> Int {
    return 4;
}

pub fn sht_hash() -> Int {
    return 5;
}

pub fn sht_dynamic() -> Int {
    return 6;
}

pub fn sht_nobits() -> Int {
    return 8;
}

pub fn sht_rel() -> Int {
    return 9;
}

pub fn sht_dynsym() -> Int {
    return 11;
}

pub fn shf_write() -> Int {
    return 1;
}

pub fn shf_alloc() -> Int {
    return 2;
}

pub fn shf_execinstr() -> Int {
    return 4;
}
