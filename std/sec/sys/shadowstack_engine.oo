// # Hardware Shadow Stack Engine
//
// Logline: Manages shadow stack state, pushes/pops frames, detects return address mismatches, and tracks violations.
//
// Setup: Imports shadowstack_types.oo and shadowstack_ops.oo for stateful shadow stack simulation.
//
// Beats:
//   1. Initialize ShadowStackEngine with policy and sized shadow stack.
//   2. Execute engine frame pushes and pops with capacity checks.
//   3. Verify return addresses on epilogue, log mismatch violations, and compute metrics.

import "./shadowstack_types.oo";
import "./shadowstack_ops.oo";

pub fn shadowstack_engine_init(engine_id_val: String, p: ShadowStackPolicy) -> ShadowStackEngine {
    let mut stack = shadowstack_new(engine_id_val + "_stack", shadowstack_default_max_depth());
    return ShadowStackEngine {
        engine_id: engine_id_val,
        policy: p,
        stack: stack,
        violations: list_new(),
        pushes: 0,
        pops: 0,
        mismatches: 0,
        is_halted: false,
    };
}

pub fn shadowstack_engine_push(
    engine: &mut ShadowStackEngine,
    frame: ShadowStackFrame
) -> Result[Bool, String] {
    let mut eng = engine;
    let res = shadowstack_push(eng.stack, frame);
    let new_stack = match res {
        Ok(s) => s,
        Err(e) => return Err(e),
    };
    eng.stack = new_stack;
    let old_p: Int = eng.pushes;
    let new_p: Int = old_p + 1;
    eng.pushes = new_p;
    return Ok(true);
}

pub fn shadowstack_engine_pop(engine: &mut ShadowStackEngine) -> Result[Bool, String] {
    let mut eng = engine;
    let res = shadowstack_pop(eng.stack);
    let new_stack = match res {
        Ok(s) => s,
        Err(e) => return Err(e),
    };
    eng.stack = new_stack;
    let old_p: Int = eng.pops;
    let new_p: Int = old_p + 1;
    eng.pops = new_p;
    return Ok(true);
}

pub fn shadowstack_engine_verify(
    engine: &mut ShadowStackEngine,
    expected_ret_addr: Int,
    pid_val: Int,
    ts_val: Int
) -> Bool {
    let mut eng = engine;
    let ok = shadowstack_verify_top(&eng.stack, expected_ret_addr);
    if ok == false {
        let n: Int = list_len(eng.stack.frames);
        let mut frame_id_v: Int = 0;
        if n > 0 {
            let top = list_get(eng.stack.frames, n - 1);
            let fid: Int = top.frame_id;
            frame_id_v = fid;
        }
        let v = shadowstack_violation_create(
            expected_ret_addr,
            0,
            frame_id_v,
            pid_val,
            ts_val,
            "Return address mismatch at function epilogue"
        );
        let old = eng.violations;
        let mut updated: List[ShadowStackViolation] = list_new();
        let m = list_len(old);
        let mut i = 0;
        while i < m {
            let cur = list_get(old, i);
            updated = list_push(updated, cur);
            i = i + 1;
        }
        updated = list_push(updated, v);
        eng.violations = updated;
        let old_m: Int = eng.mismatches;
        let new_m: Int = old_m + 1;
        eng.mismatches = new_m;
        return false;
    }
    return true;
}

pub fn shadowstack_engine_do_work(engine: &ShadowStackEngine) -> Int {
    let p: Int = (engine).pushes;
    let po: Int = (engine).pops;
    let m: Int = (engine).mismatches;
    return p + po + m;
}

pub fn __dummy_std_src_ooda_sec_sys_shadowstack_engine_oo() -> Int {
    return 0;
}
