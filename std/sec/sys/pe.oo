// # Portable Executable (PE/COFF) Parser Facade
//
// Logline: Re-exports Portable Executable and COFF header parsing, section inspection, security score auditing, and binary telemetry.
//
// Setup: Pure module shim importing PE subsystem components via companion stubs.
//
// Beats:
//   1. Import PE/COFF stubs companion module.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream system security consumers.
//
// ===================================================================
// openOODA Standard Library — ooda::sec::sys::pe
// PE Re-export Shim (M172 split)
// ===================================================================
// The original ~986-line pe.oo was split at functional seams
// into 6 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./pe_stubs.oo";

pub fn shim_marker_dos_magic() -> Int {
    return pe_dos_magic();
}

pub fn shim_marker_signature() -> Int {
    return pe_signature();
}

pub fn shim_marker_dos_header_new() -> DosHeader {
    return dos_header_new();
}

pub fn shim_marker_pe_header_new() -> PeHeader {
    return pe_header_new();
}

pub fn shim_marker_image_new() -> PeImage {
    return pe_image_new("test.exe");
}

pub fn shim_marker_machine_name() -> String {
    return pe_get_machine_name(pe_machine_amd64());
}

pub fn shim_marker_image_do_work(image: &PeImage) -> Int {
    return pe_image_do_work(image);
}
