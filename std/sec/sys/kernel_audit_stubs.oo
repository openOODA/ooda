// # Linux Kernel Audit Netlink Stubs
//
// Logline: Provides fail-closed residual stubs for NETLINK_AUDIT socket communication and kernel event reading.
//
// Setup: Requires SysCap token; terminates fail-closed due to compiler native netlink socket boundary limitations.
//
// Beats:
//   1. Provide stub for opening NETLINK_AUDIT sockets.
//   2. Provide stubs for adding rules and toggling audit enablement.
//   3. Provide stub for receiving audit event records.

import "./kernel_audit_types.oo";

pub type SysCap = struct {};

pub fn audit_open_netlink(sys: &SysCap) -> Result[Int, String] {
    // COMPILER LIMITATION: openOODA lacks native host C-FFI for NETLINK_AUDIT socket(AF_NETLINK, NETLINK_AUDIT) binding.
    process_exit(1);
    return Err("Unimplemented: NETLINK_AUDIT socket open requires host syscall FFI lowering");
}

pub fn audit_send_rule(sys: &SysCap, rule: &AuditRule) -> Result[Bool, String] {
    // COMPILER LIMITATION: openOODA lacks NETLINK_AUDIT rule-add message marshaling (AUDIT_ADD_RULE).
    process_exit(1);
    return Err("Unimplemented: NETLINK_AUDIT rule addition requires audit-rule netlink marshaling FFI");
}

pub fn audit_read_event(sys: &SysCap, fd: Int) -> Result[AuditEvent, String] {
    // COMPILER LIMITATION: openOODA lacks NETLINK_AUDIT recv() message parsing for AUDIT_EVENT format.
    process_exit(1);
    return Err("Unimplemented: NETLINK_AUDIT event recv parsing requires netlink message FFI lowering");
}

pub fn audit_set_enabled(sys: &SysCap, enabled_v: Bool) -> Result[Bool, String] {
    // COMPILER LIMITATION: openOODA lacks NETLINK_AUDIT AUDIT_SET enable/disable message marshaling.
    process_exit(1);
    return Err("Unimplemented: kernel audit enable/disable requires NETLINK_AUDIT set FFI lowering");
}

pub fn __dummy_std_src_ooda_sec_sys_kernel_audit_stubs_oo() -> Int {
    return 0;
