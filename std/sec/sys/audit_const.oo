// # Audit Message Types, Filters, Actions & Arch Identifiers
//
// Logline: Provide Linux audit message type, filter list, action, and architecture constants.
//
// Setup: Imports audit_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. audit_type_*: map AUDIT_SYSCALL/PATH/IPC/SOCKETCALL/CONFIG_CHANGE/EXECVE/USER_AUTH.
//   2. audit_filter_exit/always/never: return filter list tag.
//   3. audit_action_always/never: return action tag.
//   4. audit_arch_x86_64/arm64: return architecture tag.
//
// residual: constants only; live netlink is process_exit in audit_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./audit_types.oo";

// -------------------------------------------------------------------
// Linux Audit Message Type Identifiers
// -------------------------------------------------------------------

pub fn audit_type_syscall() -> Int {
    return 1300; // AUDIT_SYSCALL
}

pub fn audit_type_path() -> Int {
    return 1302; // AUDIT_PATH
}

pub fn audit_type_ipc() -> Int {
    return 1303; // AUDIT_IPC
}

pub fn audit_type_socketcall() -> Int {
    return 1304; // AUDIT_SOCKETCALL
}

pub fn audit_type_config_change() -> Int {
    return 1305; // AUDIT_CONFIG_CHANGE
}

pub fn audit_type_execve() -> Int {
    return 1309; // AUDIT_EXECVE
}

pub fn audit_type_user_auth() -> Int {
    return 1100; // AUDIT_USER_AUTH
}

pub fn audit_type_user_acct() -> Int {
    return 1101; // AUDIT_USER_ACCT
}

pub fn audit_type_user_start() -> Int {
    return 1102; // AUDIT_USER_START
}

pub fn audit_type_user_end() -> Int {
    return 1103; // AUDIT_USER_END
}

// -------------------------------------------------------------------
// Audit Filter Lists & Rule Actions
// -------------------------------------------------------------------

pub fn audit_filter_task() -> Int {
    return 0; // AUDIT_FILTER_TASK
}

pub fn audit_filter_entry() -> Int {
    return 1; // AUDIT_FILTER_ENTRY
}

pub fn audit_filter_watch() -> Int {
    return 2; // AUDIT_FILTER_WATCH
}

pub fn audit_filter_exit() -> Int {
    return 4; // AUDIT_FILTER_EXIT
}

pub fn audit_filter_user() -> Int {
    return 5; // AUDIT_FILTER_USER
}

pub fn audit_filter_exclude() -> Int {
    return 6; // AUDIT_FILTER_EXCLUDE
}

pub fn audit_never() -> Int {
    return 0; // AUDIT_NEVER
}

pub fn audit_possible() -> Int {
    return 1; // AUDIT_POSSIBLE
}

pub fn audit_always() -> Int {
    return 2; // AUDIT_ALWAYS
}

// -------------------------------------------------------------------
// Architecture Audit Identifiers
// -------------------------------------------------------------------

pub fn audit_arch_x86_64() -> Int {
    return 62; // AUDIT_ARCH_X86_64
}

pub fn audit_arch_aarch64() -> Int {
    return 183; // AUDIT_ARCH_AARCH64
}

pub fn audit_arch_riscv64() -> Int {
    return 243; // AUDIT_ARCH_RISCV64
}

pub type Fail = struct {};
pub type Default = struct {};


pub fn __dummy_std_src_ooda_sec_sys_audit_const_oo() -> Int {
    return 0;
}
