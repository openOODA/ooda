// ===================================================================
// openOODA Standard Library — ooda::sec::sys::landlock_types
// Landlock domain types (split from landlock.oo, M172)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

pub type AccessRights = struct {
    fs_execute: Bool,
    fs_write_file: Bool,
    fs_read_file: Bool,
    fs_read_dir: Bool,
    fs_remove_dir: Bool,
    fs_remove_file: Bool,
    fs_make_char: Bool,
    fs_make_dir: Bool,
    fs_make_reg: Bool,
    fs_make_sock: Bool,
    fs_make_fifo: Bool,
    fs_make_block: Bool,
    fs_make_sym: Bool,
    fs_refer: Bool,
    fs_truncate: Bool,
    net_bind_tcp: Bool,
    net_connect_tcp: Bool,
    scope_abstract_unix_socket: Bool,
    scope_signal: Bool,
};

pub type PathBeneathAttr = struct {
    allowed_access: Int,
    parent_fd: Int,
    path: String,
};

pub type NetPortAttr = struct {
    allowed_access: Int,
    port: Int,
};

pub type LandlockRuleset = struct {
    name: String,
    handled_access_fs: Int,
    handled_access_net: Int,
    handled_scoped: Int,
    path_rules: List[PathBeneathAttr],
    net_rules: List[NetPortAttr],
    ruleset_fd: Int,
    is_created: Bool,
    is_enforced: Bool,
    flags: Int,
    stats_rules_added: Int,
    stats_evaluations: Int,
    stats_denials: Int,
};

pub type LandlockEvaluationResult = struct {
    allowed: Bool,
    target: String,
    requested_access: Int,
    matched_rule_index: Int,
    denial_reason: String,
};

/// Module load marker — oodac requires ≥1 fn in types-only units.
pub fn landlock_types_module_loaded() -> Int {
    return 1;
}
