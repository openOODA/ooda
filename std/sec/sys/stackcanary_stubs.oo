    // Hardware frame unwinding must be performed by host runtime unwinder.
    process_exit(1);
    return Err("Unimplemented: hardware frame pointer unwinding requires DWARF unwinder native host bindings");
}

pub fn stack_canary_emit_kernel_sigabrt(sys: &SysCap, frame_name: String) -> Result[Bool, String] {
