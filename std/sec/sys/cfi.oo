// # Control-Flow Integrity Protection Facade
//
// Logline: Re-exports control-flow integrity policies, indirect call site verification, graph validation, and violation telemetry.
//
// Setup: Pure module shim importing types, constants, operations, engine, and stub submodules.
//
// Beats:
//   1. Import CFI types, constants, ops, engine, and stubs companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream system security consumers.
//
// ===================================================================
// openOODA Standard Library — ooda::sec::sys::cfi
// CFI Re-export Shim (M172 split)
// ===================================================================
// Original ~627-line cfi.oo split at functional seams into
// cfi_types / cfi_const / cfi_ops / cfi_engine / cfi_stubs
// (each ≤256 lines). This shim re-exports public names so existing
// callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./cfi_types.oo";
import "./cfi_const.oo";
import "./cfi_ops.oo";
import "./cfi_engine.oo";
import "./cfi_stubs.oo";

pub fn shim_marker_mode_disabled() -> Int {
    return cfi_mode_disabled();
}

pub fn shim_marker_mode_full_protection() -> Int {
    return cfi_mode_full_protection();
}

pub fn shim_marker_violation_none() -> Int {
    return cfi_violation_none();
}

pub fn shim_marker_hw_feature_intel_ibt() -> Int {
    return cfi_hw_feature_intel_ibt();
}

pub fn shim_marker_policy_init() -> CfiPolicy {
    return cfi_policy_init("default", true, true, true);
}

pub fn shim_marker_cfg_new() -> ControlFlowGraph {
    return control_flow_graph_new("cfg1", "module");
}

pub fn shim_marker_call_site_create() -> IndirectCallSite {
    return indirect_call_site_create("s1", 4096, 42, "caller", true);
}

pub fn shim_marker_engine_do_work(engine: &CfiEngine) -> Int {
    return cfi_engine_do_work(engine);
}

pub type Large = struct {};


pub fn __dummy_std_src_ooda_sec_sys_cfi_oo() -> Int {
    return 0;
}
