// # ROP Gadget and Chain Operations
//
// Logline: Gadget validity, chain stack-delta sum, syscall/pivot flags. Destubbed off List[RopGadget].
//
// Setup: Imports rop_types.oo and rop_const.oo. Three fixed gadget slots.
//
// Beats:
//   1. Gadget invalid when address==0 or stack_delta<0.
//   2. Add gadget: total_stack += delta; type 4 sets has_syscall.
//   3. Safety: forbidden if any invalid; pivot if type 5 or pivot_address!=0.
// residual: List[struct] destubbed to fixed Int slots.

import "./rop_types.oo";
import "./rop_const.oo";

pub fn rop_gadget_create(address_val: Int, stack_delta_val: Int, gadget_type_val: Int) -> RopGadget {
    return rop_gadget_new(address_val, stack_delta_val, gadget_type_val);
}

pub fn rop_gadget_verify(gadget: RopGadget) -> Int {
    if gadget.is_valid == 0 {
        return 0;
    }
    if gadget.address == 0 {
        return 0;
    }
    return 1;
}

pub fn gadget_chain_new() -> GadgetChain {
    return gadget_chain_empty();
}

pub fn gadget_chain_add_gadget(chain: GadgetChain, gadget: RopGadget) -> GadgetChain {
    let n: Int = chain.n_gad;
    if n >= 3 {
        return GadgetChain {
            g0_addr: chain.g0_addr,
            g0_delta: chain.g0_delta,
            g0_type: chain.g0_type,
            g0_valid: chain.g0_valid,
            g1_addr: chain.g1_addr,
            g1_delta: chain.g1_delta,
            g1_type: chain.g1_type,
            g1_valid: chain.g1_valid,
            g2_addr: chain.g2_addr,
            g2_delta: chain.g2_delta,
            g2_type: chain.g2_type,
            g2_valid: chain.g2_valid,
            n_gad: n,
            total_stack: chain.total_stack,
            has_syscall: chain.has_syscall,
            pivot_address: chain.pivot_address,
            last_ok: 0
        };
    }
    let sys_type: Int = gadget_type_syscall();
    let mut has_sys: Int = chain.has_syscall;
    if gadget.gadget_type == sys_type {
        has_sys = 1;
    }
    let new_stack: Int = chain.total_stack + gadget.stack_delta;
    if n == 0 {
        return GadgetChain {
            g0_addr: gadget.address,
            g0_delta: gadget.stack_delta,
            g0_type: gadget.gadget_type,
            g0_valid: gadget.is_valid,
            g1_addr: chain.g1_addr,
            g1_delta: chain.g1_delta,
            g1_type: chain.g1_type,
            g1_valid: chain.g1_valid,
            g2_addr: chain.g2_addr,
            g2_delta: chain.g2_delta,
            g2_type: chain.g2_type,
            g2_valid: chain.g2_valid,
            n_gad: 1,
            total_stack: new_stack,
            has_syscall: has_sys,
            pivot_address: chain.pivot_address,
            last_ok: 1
        };
    }
    if n == 1 {
        return GadgetChain {
            g0_addr: chain.g0_addr,
            g0_delta: chain.g0_delta,
            g0_type: chain.g0_type,
            g0_valid: chain.g0_valid,
            g1_addr: gadget.address,
            g1_delta: gadget.stack_delta,
            g1_type: gadget.gadget_type,
            g1_valid: gadget.is_valid,
            g2_addr: chain.g2_addr,
            g2_delta: chain.g2_delta,
            g2_type: chain.g2_type,
            g2_valid: chain.g2_valid,
            n_gad: 2,
            total_stack: new_stack,
            has_syscall: has_sys,
            pivot_address: chain.pivot_address,
            last_ok: 1
        };
    }
    return GadgetChain {
        g0_addr: chain.g0_addr,
        g0_delta: chain.g0_delta,
        g0_type: chain.g0_type,
        g0_valid: chain.g0_valid,
        g1_addr: chain.g1_addr,
        g1_delta: chain.g1_delta,
        g1_type: chain.g1_type,
        g1_valid: chain.g1_valid,
        g2_addr: gadget.address,
        g2_delta: gadget.stack_delta,
        g2_type: gadget.gadget_type,
        g2_valid: gadget.is_valid,
        n_gad: 3,
        total_stack: new_stack,
        has_syscall: has_sys,
        pivot_address: chain.pivot_address,
        last_ok: 1
    };
}

pub fn gadget_chain_set_pivot(chain: GadgetChain, pivot_addr_val: Int) -> GadgetChain {
    return GadgetChain {
        g0_addr: chain.g0_addr,
        g0_delta: chain.g0_delta,
        g0_type: chain.g0_type,
        g0_valid: chain.g0_valid,
        g1_addr: chain.g1_addr,
        g1_delta: chain.g1_delta,
        g1_type: chain.g1_type,
        g1_valid: chain.g1_valid,
        g2_addr: chain.g2_addr,
        g2_delta: chain.g2_delta,
        g2_type: chain.g2_type,
        g2_valid: chain.g2_valid,
        n_gad: chain.n_gad,
        total_stack: chain.total_stack,
        has_syscall: chain.has_syscall,
        pivot_address: pivot_addr_val,
        last_ok: chain.last_ok
    };
}

pub fn gadget_chain_validate(chain: GadgetChain) -> Int {
    if chain.n_gad == 0 {
        return 0;
    }
    if chain.g0_valid == 0 {
        return 0;
    }
    if chain.n_gad >= 2 {
        if chain.g1_valid == 0 {
            return 0;
        }
    }
    if chain.n_gad >= 3 {
        if chain.g2_valid == 0 {
            return 0;
        }
    }
    return 1;
}

pub fn gadget_chain_has_forbidden(chain: GadgetChain) -> Int {
    if chain.n_gad >= 1 {
        if chain.g0_valid == 0 {
            return 1;
        }
    }
    if chain.n_gad >= 2 {
        if chain.g1_valid == 0 {
            return 1;
        }
    }
    if chain.n_gad >= 3 {
        if chain.g2_valid == 0 {
            return 1;
        }
    }
    return 0;
}

pub fn gadget_chain_has_pivot(chain: GadgetChain) -> Int {
    if chain.pivot_address != 0 {
        return 1;
    }
    let pivot_type: Int = gadget_type_stack_pivot();
    if chain.n_gad >= 1 {
        if chain.g0_type == pivot_type {
            return 1;
        }
    }
    if chain.n_gad >= 2 {
        if chain.g1_type == pivot_type {
            return 1;
        }
    }
    if chain.n_gad >= 3 {
        if chain.g2_type == pivot_type {
            return 1;
        }
    }
    return 0;
}

pub fn gadget_chain_is_safe(chain: GadgetChain) -> Int {
    if gadget_chain_has_forbidden(chain) == 1 {
        return 0;
    }
    if chain.n_gad == 0 {
        return 0;
    }
    return 1;
}
