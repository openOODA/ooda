type SmapStatus = struct {
    violation_count: Int,
    last_violation_addr: Int
};

pub fn smap_status_new() -> SmapStatus {
    return SmapStatus {
        violation_count: 0,
        last_violation_addr: 0
    };
}

pub fn smap_status_record(s: SmapStatus, addr: Int) -> SmapStatus {
    let n: Int = s.violation_count;
    return SmapStatus {
        violation_count: n + 1,
        last_violation_addr: addr
    };
}
