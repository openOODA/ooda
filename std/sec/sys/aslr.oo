import "./aslr_types.oo";
import "./aslr_const.oo";
import "./aslr_ops.oo";
import "./aslr_engine.oo";
import "./aslr_stubs.oo";

pub fn shim_marker_aslr_mode_disabled() -> Int {
    return aslr_mode_disabled();
}

pub fn shim_marker_aslr_mode_full() -> Int {
    return aslr_mode_full();
}

pub fn shim_marker_aslr_violation_unexpected_addr() -> Int {
    return aslr_violation_unexpected_addr();
}

pub fn shim_marker_aslr_config_default() -> AslrConfig {
    return aslr_config_default();
}

pub fn shim_marker_aslr_region_create() -> AslrRegion {
    return aslr_region_create("text", 4194304, 65536, true, false);
}

pub fn shim_marker_aslr_layout_new() -> AslrLayout {
    return aslr_layout_new("layout1");
}

pub fn shim_marker_aslr_addr_in_range() -> Bool {
    return aslr_addr_in_range(4194384, 4194304, 65536);
}

pub fn shim_marker_aslr_compute_entropy() -> Int {
    return aslr_compute_entropy(65536);
}

pub fn shim_marker_aslr_engine_init() -> AslrEngine {
    return aslr_engine_init("eng1", aslr_config_default());
}

pub fn shim_marker_aslr_engine_stats(engine: &AslrEngine) -> Int {
    return aslr_engine_stats(engine);
}

pub fn shim_marker_aslr_engine_do_work(engine: &AslrEngine) -> Int {
    return aslr_engine_do_work(engine);
}

