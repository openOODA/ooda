// # PE RVA, Section Find, Summary, Compliance Helpers
//
// Logline: Convert RVA to file offset, find sections by name, summarize imports, and score compliance.
//
// Setup: Imports pe_engine.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. pe_rva_to_offset: walk sections and translate RVA to file offset.
//   2. pe_find_section_by_name: scan section list for matching name.
//   3. pe_imports_summary: tally imported dlls and functions.
//   4. pe_compliance_score: aggregate DEP/ASLR/CFG presence into a score.
//
// residual: live PE load is process_exit in pe_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./pe_engine.oo";

pub fn pe_rva_to_offset(image: &PeImage, rva: Int) -> Int {
    let secs: List[SectionHeader] = image.sections;
    let count: Int = list_len(secs);
    let mut i: Int = 0;
    while i < count {
        let sec: SectionHeader = list_get(secs, i);
        let sec_start: Int = sec.virtual_address;
        let sec_end: Int = sec_start + sec.virtual_size;
        if rva >= sec_start {
            if rva < sec_end {
                let delta: Int = rva - sec_start;
                return sec.pointer_to_raw_data + delta;
            }
        }
        i = i + 1;
    }
    return -1;
}

pub fn pe_find_section_by_name(image: &PeImage, name: String) -> Result[SectionHeader, String] {
    let secs: List[SectionHeader] = image.sections;
    let count: Int = list_len(secs);
    let mut i: Int = 0;
    while i < count {
        let sec: SectionHeader = list_get(secs, i);
        if sec.name == name {
            return Ok(sec);
        }
        i = i + 1;
    }
    return Err("Section not found: " + name);
}

pub fn pe_find_section_by_rva(image: &PeImage, rva: Int) -> Result[SectionHeader, String] {
    let secs: List[SectionHeader] = image.sections;
    let count: Int = list_len(secs);
    let mut i: Int = 0;
    while i < count {
        let sec: SectionHeader = list_get(secs, i);
        let sec_start: Int = sec.virtual_address;
        let sec_end: Int = sec_start + sec.virtual_size;
        if rva >= sec_start {
            if rva < sec_end {
                return Ok(sec);
            }
        }
        i = i + 1;
    }
    let rva_str: String = rva.to_string();
    return Err("No section contains RVA: " + rva_str);
}

pub fn pe_get_machine_name(machine: Int) -> String {
    if machine == pe_machine_i386() { return "Intel x86 (i386)"; }
    if machine == pe_machine_amd64() { return "AMD64 / x86_64"; }
    if machine == pe_machine_arm() { return "ARM Little-Endian"; }
    if machine == pe_machine_arm64() { return "ARM64 Little-Endian"; }
    if machine == pe_machine_riscv64() { return "RISC-V 64-bit"; }
    let m_str: String = machine.to_string();
    return "Unknown Architecture (" + m_str + ")";
}

pub fn pe_get_subsystem_name(subsystem: Int) -> String {
    if subsystem == pe_subsystem_native() { return "Native System Driver"; }
    if subsystem == pe_subsystem_windows_gui() { return "Windows GUI Application"; }
    if subsystem == pe_subsystem_windows_cui() { return "Windows Console Application (CUI)"; }
    if subsystem == pe_subsystem_posix_cui() { return "POSIX Console Application"; }
    if subsystem == pe_subsystem_efi_application() { return "EFI Application"; }
    let s_str: String = subsystem.to_string();
    return "Unknown Subsystem (" + s_str + ")";
}

pub fn pe_format_summary(image: &PeImage) -> String {
    let mach_val: Int = image.pe_header.machine;
    let arch_name: String = pe_get_machine_name(mach_val);
    let subsys_val: Int = image.optional_header.subsystem;
    let sub_name: String = pe_get_subsystem_name(subsys_val);
    let sec_cnt_int: Int = list_len(image.sections);
    let sec_cnt: String = sec_cnt_int.to_string();
    let score_val: Int = image.audit.security_score;
    let score_str: String = score_val.to_string();
    let filepath_str: String = image.filepath;
    let mut res: String = "PE Binary Summary for " + filepath_str + ":\n";
    res = res + " Architecture: " + arch_name + "\n";
    res = res + " Subsystem: " + sub_name + "\n";
    res = res + " Number of Sections: " + sec_cnt + "\n";
    res = res + " Security Score: " + score_str + "/100\n";
    let is_aslr: Bool = image.audit.has_aslr;
    let is_dep: Bool = image.audit.has_dep_nx;
    let is_cfg: Bool = image.audit.has_cfg;
    let is_wx: Bool = image.audit.has_wx_sections;
    res = res + " ASLR Enabled: " + (if is_aslr { "Yes" } else { "No" }) + "\n";
    res = res + " DEP/NX Enabled: " + (if is_dep { "Yes" } else { "No" }) + "\n";
    res = res + " Control Flow Guard: " + (if is_cfg { "Yes" } else { "No" }) + "\n";
    res = res + " W^X Violation: " + (if is_wx { "YES (DANGER)" } else { "No" });
    return res;
}

pub fn pe_image_is_security_compliant(image: &PeImage) -> Bool {
    let is_aslr: Bool = image.audit.has_aslr;
    let is_dep: Bool = image.audit.has_dep_nx;
    let is_wx: Bool = image.audit.has_wx_sections;
    if is_aslr == false { return false; }
    if is_dep == false { return false; }
    if is_wx == true { return false; }
    return true;
}

pub fn pe_image_do_work(image: &PeImage) -> Int {
    let sec_count: Int = list_len(image.sections);
    let dir_count: Int = list_len(image.data_directories);
    let score: Int = image.audit.security_score;
    return sec_count + dir_count + score;
}
