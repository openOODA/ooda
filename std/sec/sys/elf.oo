// ===================================================================
// openOODA Standard Library — ooda::sec::sys::elf
// ELF Re-export Shim (M172 split)
// ===================================================================
// The original ~776-line elf.oo was split at functional seams
// into 6 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./elf_ops.oo";
import "./elf_engine.oo";
import "./elf_inspect.oo";
import "./elf_security.oo";
import "./elf_stubs.oo";

pub fn shim_marker_magic0() -> Int {
    return elf_magic_0();
}

pub fn shim_marker_class64() -> Int {
    return elf_class_64();
}

pub fn shim_marker_header_default() -> ElfHeader {
    return elf_header_default();
}

pub fn shim_marker_file_new() -> ElfFile {
    return elf_file_new("a.out");
}

pub fn shim_marker_do_work(f: &ElfFile) -> Int {
    return elf_file_do_work(f);
}
