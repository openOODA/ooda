// # ELF Re-export Shim
//
// Logline: Re-export shim for the split ELF engine (M172). Forwards identity markers across the split seam.
//
// Setup: Imports elf_ops, elf_engine, elf_inspect, elf_security, and elf_stubs. Needs OO_LIST_AMBIENT_QUOTA=2147483648 to monomorphize the shim.
//
// Beats:
//   1. shim_marker_*: forward magic, class, header, file, and work markers.
//   2. shim_marker_do_work: forward elf_file_do_work across the split seam.
//   3. shim_marker_magic0 / shim_marker_class64: pass through ELF constants.
//   4. imports: keep all five split submodules visible at the public surface.
//
// residual: large-struct cross-module call markers thinned; oodac typechecker can confuse struct ids.

import "./elf_ops.oo";
import "./elf_engine.oo";
import "./elf_inspect.oo";
import "./elf_security.oo";
import "./elf_stubs.oo";

pub fn shim_marker_magic0() -> Int {
    return elf_magic_0();
}

pub fn shim_marker_class64() -> Int {
    return elf_class_64();
}

pub fn shim_marker_header_default() -> ElfHeader {
    return elf_header_default();
}

pub fn shim_marker_file_new() -> ElfFile {
    return elf_file_new("a.out");
}

pub fn shim_marker_do_work(f: &ElfFile) -> Int {
    return elf_file_do_work(f);
}
