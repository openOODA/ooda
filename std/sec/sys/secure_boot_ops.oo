// # Secure Boot Operations & Image Verification
//
// Logline: Implements key/signature constructors, policy validation, and pure firmware image verification algorithms.
//
// Setup: Imports secure_boot_types.oo and secure_boot_const.oo for firmware image integrity evaluation.
//
// Beats:
//   1. Construct operating modes, signatures, keys, and policy presets.
//   2. Search keys by fingerprint and signatures by image digest.
//   3. Verify firmware image digests against enrolled DB/DBX keystores and evaluate violation status.

import "./secure_boot_types.oo";
import "./secure_boot_const.oo";

pub fn sboot_mode_default() -> SecureBootMode {
    return SecureBootMode {
        mode_id: "SBOOT_MODE_DEFAULT",
        secure_boot_enabled: true,
        setup_mode: false,
        audit_mode: false,
        deployed_mode: true,
        recovery_mode: false,
        vendor_keys_present: true,
        platform_key_present: true,
    };
}

pub fn sboot_signature_create(
    sig_id_val: String,
    sig_type_val: Int,
    owner_val: String,
    signer_cert_val: String,
    digest_val: String
) -> SecureBootSignature {
    return SecureBootSignature {
        signature_id: sig_id_val,
        signature_type: sig_type_val,
        owner: owner_val,
        signer_cert: signer_cert_val,
        digest: digest_val,
        enrolled: true,
    };
}

pub fn sboot_key_create(
    key_id_val: String,
    key_type_val: String,
    key_bytes_val: String,
    fingerprint_val: String
) -> SecureBootKey {
    return SecureBootKey {
        key_id: key_id_val,
        key_type: key_type_val,
        key_bytes: key_bytes_val,
        fingerprint: fingerprint_val,
        enrolled_in_db: true,
        enrolled_in_dbx: false,
        revoked: false,
    };
}

pub fn sboot_policy_default() -> SecureBootPolicy {
    return SecureBootPolicy {
        policy_id: "SBOOT_POLICY_DEFAULT",
        enforce_secure_boot: true,
        allow_custom_keys: false,
        deny_mok_manager: false,
        require_db_enrollment: true,
        fail_closed: true,
        is_valid: true,
    };
}

pub fn sboot_policy_validate(p: &SecureBootPolicy) -> Result[Bool, String] {
    if (p).enforce_secure_boot == true {
        if (p).allow_custom_keys == false {
            if (p).require_db_enrollment == false {
                return Err("SbootError: enforce with no custom keys still requires db enrollment");
            }
        }
    }
    return Ok(true);
}

pub fn sboot_violation_create(
    image_val: String,
    expected_sig_val: String,
    violation_type_val: Int,
    ts_val: Int,
    action_val: Int
) -> SecureBootViolation {
    let vid = "sboot-violation";
    return SecureBootViolation {
        violation_id: vid,
        attempted_image: image_val,
        expected_signature: expected_sig_val,
        violation_type: violation_type_val,
        timestamp: ts_val,
        action_taken: action_val,
    };
}

pub fn sboot_find_key_by_fp(keys: &List[SecureBootKey], fp: String) -> Int {
    let n: Int = list_len(keys);
    let mut i = 0;
    while i < n {
        let k = list_get(keys, i);
        if k.fingerprint == fp {
            return i;
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return -1;
}

pub fn sboot_find_signature_by_digest(sigs: &List[SecureBootSignature], digest: String) -> Int {
    let n: Int = list_len(sigs);
    let mut i = 0;
    while i < n {
        let s = list_get(sigs, i);
        if s.digest == digest {
            return i;
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return -1;
}

pub fn sboot_verify_image(
    engine: &SecureBootEngine,
    image_digest: String
) -> Int {
    if (engine).mode.secure_boot_enabled == false {
        return sboot_action_log_only();
    }
    if (engine).mode.setup_mode == true {
        return sboot_violation_setup_mode();
    }
    let sig_idx = sboot_find_signature_by_digest(&(engine).signatures, image_digest);
    if sig_idx < 0 {
        return sboot_violation_unsigned();
    }
    let sig = list_get((engine).signatures, sig_idx);
    let key_idx = sboot_find_key_by_fp(&(engine).keys, sig.signer_cert);
    if key_idx < 0 {
        return sboot_violation_unknown_signer();
    }
    let key = list_get((engine).keys, key_idx);
    if key.revoked == true {
        return sboot_violation_revoked();
    }
    return 0;
}

pub fn sboot_is_violation(code: Int) -> Bool {
    if code == 0 {
        return false;
    }
    return true;
}

pub fn __dummy_std_src_ooda_sec_sys_secure_boot_ops_oo() -> Int {
    return 0;
}
