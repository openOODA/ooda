// # PE Constructors & Little-Endian Readers
//
// Logline: Build DosHeader, PeHeader, and OptionalHeader records; provide read_u16_le and read_u32_le.
//
// Setup: Imports pe_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. dos_header_new: build zeroed DosHeader with is_valid=false.
//   2. pe_header_new: build zeroed PeHeader with characteristics=0.
//   3. read_u16_le: read 16-bit little-endian from data offset.
//   4. read_u32_le: read 32-bit little-endian from data offset.
//
// residual: live PE load is process_exit in pe_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./pe_types.oo";

pub fn dos_header_new() -> DosHeader {
    return DosHeader {
        e_magic: 0,
        e_cblp: 0,
        e_cp: 0,
        e_crlc: 0,
        e_cparhdr: 0,
        e_minalloc: 0,
        e_maxalloc: 0,
        e_ss: 0,
        e_sp: 0,
        e_csum: 0,
        e_ip: 0,
        e_cs: 0,
        e_lfarlc: 0,
        e_ovno: 0,
        e_lfanew: 0,
        is_valid: false
    };
}

pub fn pe_header_new() -> PeHeader {
    return PeHeader {
        machine: 0,
        number_of_sections: 0,
        time_date_stamp: 0,
        pointer_to_symbol_table: 0,
        number_of_symbols: 0,
        size_of_optional_header: 0,
        characteristics: 0,
        is_valid: false
    };
}

pub fn optional_header_new() -> OptionalHeader {
    return OptionalHeader {
        magic: 0,
        major_linker_version: 0,
        minor_linker_version: 0,
        size_of_code: 0,
        size_of_initialized_data: 0,
        size_of_uninitialized_data: 0,
        address_of_entry_point: 0,
        base_of_code: 0,
        image_base: 0,
        section_alignment: 0,
        file_alignment: 0,
        major_os_version: 0,
        minor_os_version: 0,
        major_image_version: 0,
        minor_image_version: 0,
        major_subsystem_version: 0,
        minor_subsystem_version: 0,
        win32_version_value: 0,
        size_of_image: 0,
        size_of_headers: 0,
        checksum: 0,
        subsystem: 0,
        dll_characteristics: 0,
        size_of_stack_reserve: 0,
        size_of_stack_commit: 0,
        size_of_heap_reserve: 0,
        size_of_heap_commit: 0,
        loader_flags: 0,
        number_of_rva_and_sizes: 0,
        is_64bit: false,
        is_valid: false
    };
}

pub fn data_directory_new(name: String, rva: Int, size: Int) -> DataDirectory {
    let present: Bool = size > 0;
    return DataDirectory {
        name: name,
        virtual_address: rva,
        size: size,
        is_present: present
    };
}

pub fn section_header_new(name: String) -> SectionHeader {
    return SectionHeader {
        name: name,
        virtual_size: 0,
        virtual_address: 0,
        size_of_raw_data: 0,
        pointer_to_raw_data: 0,
        pointer_to_relocations: 0,
        pointer_to_linenumbers: 0,
        number_of_relocations: 0,
        number_of_linenumbers: 0,
        characteristics: 0,
        is_executable: false,
        is_readable: false,
        is_writable: false
    };
}

pub fn pe_security_audit_new() -> PeSecurityAudit {
    return PeSecurityAudit {
        has_aslr: false,
        has_high_entropy_va: false,
        has_dep_nx: false,
        has_cfg: false,
        has_force_integrity: false,
        has_no_seh: false,
        has_authenticode: false,
        has_wx_sections: false,
        is_dll: false,
        security_score: 0
    };
}

pub fn pe_image_new(filepath: String) -> PeImage {
    let empty_dirs: List[DataDirectory] = list_new();
    let empty_sections: List[SectionHeader] = list_new();
    return PeImage {
        filepath: filepath,
        dos_header: dos_header_new(),
        pe_header: pe_header_new(),
        optional_header: optional_header_new(),
        data_directories: empty_dirs,
        sections: empty_sections,
        audit: pe_security_audit_new(),
        is_64bit: false,
        is_valid: false,
        raw_size: 0
    };
}

pub fn pe_export_symbol_new(name: String, ordinal: Int, rva: Int) -> PeExportSymbol {
    return PeExportSymbol {
        name: name,
        ordinal: ordinal,
        rva: rva,
        is_forwarder: false,
        forwarder_name: ""
    };
}

pub fn pe_import_symbol_new(dll_name: String, symbol_name: String, ordinal: Int, hint: Int) -> PeImportSymbol {
    let by_ord: Bool = ordinal > 0;
    return PeImportSymbol {
        dll_name: dll_name,
        symbol_name: symbol_name,
        ordinal: ordinal,
        hint: hint,
        import_by_ordinal: by_ord
    };
}

// -------------------------------------------------------------------
// Binary Reader Helper Functions (Little-Endian)
// -------------------------------------------------------------------

pub fn read_u16_le(data: String, offset: Int) -> Int {
    let len: Int = data.len();
    if offset + 2 > len {
        return 0;
    }
    let b0: Int = byte_at(data, offset);
    let b1: Int = byte_at(data, offset + 1);
    return b0 + (b1 * 256);
}

pub fn read_u32_le(data: String, offset: Int) -> Int {
    let len: Int = data.len();
    if offset + 4 > len {
        return 0;
    }
    let b0: Int = byte_at(data, offset);
    let b1: Int = byte_at(data, offset + 1);
    let b2: Int = byte_at(data, offset + 2);
    let b3: Int = byte_at(data, offset + 3);
    return b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216);
}

pub fn read_fixed_string(data: String, offset: Int, length: Int) -> String {
    let data_len: Int = data.len();
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < length {
        let idx: Int = offset + i;
        if idx < data_len {
            let ch: Int = byte_at(data, idx);
            if ch != 0 {
                buf = bytes_push(buf, ch);
            }
        }
        i = i + 1;
    }
    return bytes_to_str(buf);
}
