// # SMAP Operations & Register Bit Arithmetic
//
// Logline: Implements status/policy constructors, CR4 and RFLAGS bitwise manipulation, and access-decision logic.
//
// Setup: Imports smap_types.oo and smap_const.oo for CPU register bitwise modeling.
//
// Beats:
//   1. Construct default SMAP status, policies, and violation records with validation.
//   2. Perform pure bitwise testing, setting, and clearing for CR4 and RFLAGS AC bit.
//   3. Implement kernel access blocking and enforcement action decision algorithms.

import "./smap_types.oo";
import "./smap_const.oo";

pub fn smap_status_new(status_id_val: String, enabled_val: Bool) -> SmapStatus {
    return SmapStatus {
        status_id: status_id_val,
        enabled: enabled_val,
        ac_flag_state: true,
        smap_violation_count: 0,
        last_violation_addr: 0,
        last_violation_pid: 0,
        is_active: true,
    };
}

pub fn smap_policy_default() -> SmapPolicy {
    return SmapPolicy {
        policy_id: "SMAP_POLICY_DEFAULT",
        enable_smap: true,
        allow_user_copy_override: true,
        panic_on_violation: true,
        audit_only: false,
        fail_closed: true,
        is_valid: true,
    };
}

pub fn smap_policy_validate(p: &SmapPolicy) -> Result[Bool, String] {
    if (p).enable_smap == true {
        if (p).allow_user_copy_override == false {
            if (p).audit_only == true {
                return Err("SmapError: Cannot enable SMAP, disable override, AND audit-only — incompatible");
            }
        }
    }
    return Ok(true);
}

pub fn smap_violation_create(
    attempted_addr_val: Int,
    pid_val: Int,
    access_type_val: Int,
    ts_val: Int
) -> SmapViolation {
    let vid = "smap-violation";
    return SmapViolation {
        violation_id: vid,
        attempted_addr: attempted_addr_val,
        pid: pid_val,
        access_type: access_type_val,
        timestamp: ts_val,
        blocked: true,
    };
}

pub fn smap_has_cr4_bit(cr4: Int) -> Bool {
    let bit: Int = smap_cr4_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    let masked: Int = cr4 & m;
    return masked != 0;
}

pub fn smap_set_cr4_bit(cr4: Int) -> Int {
    let bit: Int = smap_cr4_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    return cr4 | m;
}

pub fn smap_clear_cr4_bit(cr4: Int) -> Int {
    let bit: Int = smap_cr4_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    let inv: Int = 2147483647 - (m - 1);
    return cr4 & inv;
}

pub fn smap_ac_flag_set(rflags: Int) -> Int {
    let bit: Int = smap_rflags_ac_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    return rflags | m;
}

pub fn smap_ac_flag_clear(rflags: Int) -> Int {
    let bit: Int = smap_rflags_ac_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    let inv: Int = 2147483647 - (m - 1);
    return rflags & inv;
}

pub fn smap_ac_flag_is_set(rflags: Int) -> Bool {
    let bit: Int = smap_rflags_ac_bit();
    let mask_one: Int = 1;
    let mut m: Int = mask_one;
    let mut i: Int = 0;
    while i < bit {
        let m2: Int = m * 2;
        m = m2;
        i = i + 1;
    }
    let masked: Int = rflags & m;
    return masked != 0;
}

pub fn smap_should_block_access(
    addr_user_space: Bool,
    smap_enabled: Bool,
    ac_flag_set: Bool
) -> Bool {
    if smap_enabled == false {
        return false;
    }
    if addr_user_space == false {
        return false;
    }
    if ac_flag_set == true {
        return false;
    }
    return true;
}

pub fn smap_decide_action(policy: &SmapPolicy, addr_user_space: Bool, ac_flag_set: Bool) -> Int {
    let block = smap_should_block_access(addr_user_space, (policy).enable_smap, ac_flag_set);
    if block {
        if (policy).panic_on_violation {
            return 2;
        }
        return 1;
    }
    return 0;
}

