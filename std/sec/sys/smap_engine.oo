// # SMAP Simulation Engine
//
// Logline: Manages runtime SMAP engine state, logs user-access violations, and tracks telemetry metrics.
//
// Setup: Imports smap_types.oo and smap_ops.oo for stateful CPU access enforcement modeling.
//
// Beats:
//   1. Initialize SmapEngine with policy and default hardware status.
//   2. Record memory access violations and update engine violation tallies.
//   3. Compute engine workload telemetry and operation counts.

import "./smap_types.oo";
import "./smap_ops.oo";

pub fn smap_engine_init(engine_id_val: String, p: SmapPolicy) -> SmapEngine {
    let mut st = smap_status_new(engine_id_val + "_status", p.enable_smap);
    return SmapEngine {
        engine_id: engine_id_val,
        policy: p,
        status: st,
        violations: list_new(),
        is_halted: false,
    };
}

pub fn smap_engine_record_violation(engine: &mut SmapEngine, v: SmapViolation) {
    let mut eng = engine;
    let old = eng.violations;
    let mut updated: List[SmapViolation] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        i = i + 1;
    }
    updated = list_push(updated, v);
    eng.violations = updated;
    let old_cnt: Int = eng.status.smap_violation_count;
    let new_cnt: Int = old_cnt + 1;
    eng.status.smap_violation_count = new_cnt;
    eng.status.last_violation_addr = v.attempted_addr;
    eng.status.last_violation_pid = v.pid;
}

pub fn smap_engine_do_work(engine: &SmapEngine) -> Int {
    let cnt: Int = (engine).status.smap_violation_count;
    let n = list_len((engine).violations);
    return cnt + n;
}

