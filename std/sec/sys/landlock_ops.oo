// # Landlock AccessRights & Path/Net Attribute Constructors
//
// Logline: Build AccessRights, PathBeneathAttr, and NetPortAttr records; provide read-only and full presets.
//
// Setup: Imports landlock_const.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. access_rights_empty: zeroed AccessRights with all false flags.
//   2. access_rights_read_only: enable fs_read_file and fs_read_dir.
//   3. path_beneath_attr_create: bind allowed_access, parent_fd, path.
//   4. net_port_attr_create: bind allowed_access and port.
//
// residual: live kernel landlock_add_rule is process_exit in landlock_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./landlock_const.oo";

pub fn access_rights_empty() -> AccessRights {
    return AccessRights {
        fs_execute: false,
        fs_write_file: false,
        fs_read_file: false,
        fs_read_dir: false,
        fs_remove_dir: false,
        fs_remove_file: false,
        fs_make_char: false,
        fs_make_dir: false,
        fs_make_reg: false,
        fs_make_sock: false,
        fs_make_fifo: false,
        fs_make_block: false,
        fs_make_sym: false,
        fs_refer: false,
        fs_truncate: false,
        net_bind_tcp: false,
        net_connect_tcp: false,
        scope_abstract_unix_socket: false,
        scope_signal: false,
    };
}

pub fn access_rights_read_only() -> AccessRights {
    return AccessRights {
        fs_execute: false,
        fs_write_file: false,
        fs_read_file: true,
        fs_read_dir: true,
        fs_remove_dir: false,
        fs_remove_file: false,
        fs_make_char: false,
        fs_make_dir: false,
        fs_make_reg: false,
        fs_make_sock: false,
        fs_make_fifo: false,
        fs_make_block: false,
        fs_make_sym: false,
        fs_refer: false,
        fs_truncate: false,
        net_bind_tcp: false,
        net_connect_tcp: false,
        scope_abstract_unix_socket: false,
        scope_signal: false,
    };
}

pub fn access_rights_read_write() -> AccessRights {
    return AccessRights {
        fs_execute: false,
        fs_write_file: true,
        fs_read_file: true,
        fs_read_dir: true,
        fs_remove_dir: false,
        fs_remove_file: true,
        fs_make_char: false,
        fs_make_dir: true,
        fs_make_reg: true,
        fs_make_sock: false,
        fs_make_fifo: false,
        fs_make_block: false,
        fs_make_sym: false,
        fs_refer: false,
        fs_truncate: true,
        net_bind_tcp: false,
        net_connect_tcp: false,
        scope_abstract_unix_socket: false,
        scope_signal: false,
    };
}

pub fn access_rights_all_fs() -> AccessRights {
    return AccessRights {
        fs_execute: true,
        fs_write_file: true,
        fs_read_file: true,
        fs_read_dir: true,
        fs_remove_dir: true,
        fs_remove_file: true,
        fs_make_char: true,
        fs_make_dir: true,
        fs_make_reg: true,
        fs_make_sock: true,
        fs_make_fifo: true,
        fs_make_block: true,
        fs_make_sym: true,
        fs_refer: true,
        fs_truncate: true,
        net_bind_tcp: false,
        net_connect_tcp: false,
        scope_abstract_unix_socket: false,
        scope_signal: false,
    };
}

pub fn access_rights_to_fs_mask(rights: AccessRights) -> Int {
    let mut mask = 0;
    if rights.fs_execute { mask = mask + 1; }
    if rights.fs_write_file { mask = mask + 2; }
    if rights.fs_read_file { mask = mask + 4; }
    if rights.fs_read_dir { mask = mask + 8; }
    if rights.fs_remove_dir { mask = mask + 16; }
    if rights.fs_remove_file { mask = mask + 32; }
    if rights.fs_make_char { mask = mask + 64; }
    if rights.fs_make_dir { mask = mask + 128; }
    if rights.fs_make_reg { mask = mask + 256; }
    if rights.fs_make_sock { mask = mask + 512; }
    if rights.fs_make_fifo { mask = mask + 1024; }
    if rights.fs_make_block { mask = mask + 2048; }
    if rights.fs_make_sym { mask = mask + 4096; }
    if rights.fs_refer { mask = mask + 8192; }
    if rights.fs_truncate { mask = mask + 16384; }
    return mask;
}

pub fn access_rights_from_fs_mask(mask: Int) -> AccessRights {
    let r_exec = (mask / 1) % 2 != 0;
    let r_wf = (mask / 2) % 2 != 0;
    let r_rf = (mask / 4) % 2 != 0;
    let r_rd = (mask / 8) % 2 != 0;
    let r_rmd = (mask / 16) % 2 != 0;
    let r_rmf = (mask / 32) % 2 != 0;
    let r_mc = (mask / 64) % 2 != 0;
    let r_md = (mask / 128) % 2 != 0;
    let r_mr = (mask / 256) % 2 != 0;
    let r_ms = (mask / 512) % 2 != 0;
    let r_mf = (mask / 1024) % 2 != 0;
    let r_mb = (mask / 2048) % 2 != 0;
    let r_msym = (mask / 4096) % 2 != 0;
    let r_ref = (mask / 8192) % 2 != 0;
    let r_trunc = (mask / 16384) % 2 != 0;

    return AccessRights {
        fs_execute: r_exec,
        fs_write_file: r_wf,
        fs_read_file: r_rf,
        fs_read_dir: r_rd,
        fs_remove_dir: r_rmd,
        fs_remove_file: r_rmf,
        fs_make_char: r_mc,
        fs_make_dir: r_md,
        fs_make_reg: r_mr,
        fs_make_sock: r_ms,
        fs_make_fifo: r_mf,
        fs_make_block: r_mb,
        fs_make_sym: r_msym,
        fs_refer: r_ref,
        fs_truncate: r_trunc,
        net_bind_tcp: false,
        net_connect_tcp: false,
        scope_abstract_unix_socket: false,
        scope_signal: false,
    };
}

pub fn access_rights_to_net_mask(rights: AccessRights) -> Int {
    let mut mask = 0;
    if rights.net_bind_tcp { mask = mask + 1; }
    if rights.net_connect_tcp { mask = mask + 2; }
    return mask;
}

pub fn access_rights_from_net_mask(mask: Int) -> AccessRights {
    let r_bind = (mask / 1) % 2 != 0;
    let r_conn = (mask / 2) % 2 != 0;

    let mut rights = access_rights_empty();
    rights.net_bind_tcp = r_bind;
    rights.net_connect_tcp = r_conn;
    return rights;
}

pub fn access_rights_has_fs_permission(granted_mask: Int, required_mask: Int) -> Bool {
    let req_rights = access_rights_from_fs_mask(required_mask);
    let g_rights = access_rights_from_fs_mask(granted_mask);

    if req_rights.fs_execute && (g_rights.fs_execute == false) { return false; }
    if req_rights.fs_write_file && (g_rights.fs_write_file == false) { return false; }
    if req_rights.fs_read_file && (g_rights.fs_read_file == false) { return false; }
    if req_rights.fs_read_dir && (g_rights.fs_read_dir == false) { return false; }
    if req_rights.fs_remove_dir && (g_rights.fs_remove_dir == false) { return false; }
    if req_rights.fs_remove_file && (g_rights.fs_remove_file == false) { return false; }
    if req_rights.fs_make_char && (g_rights.fs_make_char == false) { return false; }
    if req_rights.fs_make_dir && (g_rights.fs_make_dir == false) { return false; }
    if req_rights.fs_make_reg && (g_rights.fs_make_reg == false) { return false; }
    if req_rights.fs_make_sock && (g_rights.fs_make_sock == false) { return false; }
    if req_rights.fs_make_fifo && (g_rights.fs_make_fifo == false) { return false; }
    if req_rights.fs_make_block && (g_rights.fs_make_block == false) { return false; }
    if req_rights.fs_make_sym && (g_rights.fs_make_sym == false) { return false; }
    if req_rights.fs_refer && (g_rights.fs_refer == false) { return false; }
    if req_rights.fs_truncate && (g_rights.fs_truncate == false) { return false; }
    return true;
}

pub fn access_rights_format_fs_str(rights: AccessRights) -> String {
    let mut res = "";
    if rights.fs_read_file { res = res + "r"; } else { res = res + "-"; }
    if rights.fs_write_file { res = res + "w"; } else { res = res + "-"; }
    if rights.fs_execute { res = res + "x"; } else { res = res + "-"; }
    if rights.fs_read_dir { res = res + "d"; } else { res = res + "-"; }
    if rights.fs_remove_file { res = res + "d"; } else { res = res + "-"; }
    return res;
}

// -------------------------------------------------------------------
// PathBeneathAttr & NetPortAttr Constructors & Helpers
// -------------------------------------------------------------------

pub fn path_beneath_attr_create(path: String, allowed_access: Int, parent_fd: Int) -> PathBeneathAttr {
    return PathBeneathAttr {
        allowed_access: allowed_access,
        parent_fd: parent_fd,
        path: path,
    };
}

pub fn net_port_attr_create(port: Int, allowed_access: Int) -> NetPortAttr {
    return NetPortAttr {
        allowed_access: allowed_access,
        port: port,
    };
}
