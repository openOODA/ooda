// # IMA Measurement, Rule, Policy, Signature & Appraisal Constructors
//
// Logline: Build ImaMeasurement, ImaRule, ImaPolicy, and EvmSignature records; provide pure helpers.
//
// Setup: Imports ima_const.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. ima_measurement_create: bind pcr, template, digest_algo, measurement/file digests.
//   2. ima_measurement_validate: gate against negative PCR and empty digest.
//   3. ima_rule_init: build ImaRule with action, func, mask, and digest_algo.
//   4. ima_policy_init: build ImaPolicy with default_appraise and is_locked.
//
// residual: live securityfs / TPM is process_exit in ima_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./ima_const.oo";

// -------------------------------------------------------------------
// ImaMeasurement Constructors & Helpers
// -------------------------------------------------------------------

pub fn ima_measurement_create(
    pcr: Int,
    template_name: String,
    digest_algo: String,
    measurement_digest: String,
    file_name: String,
    file_digest: String
) -> ImaMeasurement {
    let verified = (measurement_digest.len() > 0) && (file_name.len() > 0);
    return ImaMeasurement {
        pcr: pcr,
        template_name: template_name,
        digest_algo: digest_algo,
        measurement_digest: measurement_digest,
        file_name: file_name,
        file_digest: file_digest,
        is_verified: verified,
    };
}

pub fn ima_measurement_validate(m: &ImaMeasurement) -> Result[Bool, String] {
    if (m).pcr < 0 {
        return Err("IMA Validation Error: PCR index cannot be negative");
    }
    if (m).measurement_digest.len() == 0 {
        return Err("IMA Validation Error: Measurement digest cannot be empty");
    }
    if (m).file_name.len() == 0 {
        return Err("IMA Validation Error: File name cannot be empty");
    }
    return Ok(true);
}

// -------------------------------------------------------------------
// ImaRule & ImaPolicy Constructors & Helpers
// -------------------------------------------------------------------

pub fn ima_rule_create(action: Int, func: Int, mask: Int) -> ImaRule {
    return ImaRule {
        action: action,
        func: func,
        mask: mask,
        fowner: 0,
        obj_user: "",
        obj_role: "",
        obj_type: "",
        digest_algo: "sha256",
        appraise_type: "imasig",
        is_enabled: true,
    };
}

pub fn ima_rule_with_fowner(rule: ImaRule, fowner: Int) -> ImaRule {
    return ImaRule {
        action: rule.action,
        func: rule.func,
        mask: rule.mask,
        fowner: fowner,
        obj_user: rule.obj_user,
        obj_role: rule.obj_role,
        obj_type: rule.obj_type,
        digest_algo: rule.digest_algo,
        appraise_type: rule.appraise_type,
        is_enabled: rule.is_enabled,
    };
}

pub fn ima_mask_has_flag(mask: Int, flag: Int) -> Bool {
    if flag <= 0 {
        return false;
    }
    return (mask / flag) % 2 != 0;
}

pub fn ima_rule_matches(rule: &ImaRule, hook_func: Int, mask_val: Int) -> Bool {
    if (rule).is_enabled == false {
        return false;
    }
    if (rule).func != hook_func {
        return false;
    }
    if ima_mask_has_flag((rule).mask, mask_val) == false {
        return false;
    }
    return true;
}

pub fn ima_policy_new(name: String) -> ImaPolicy {
    let empty_rules: List[ImaRule] = list_new();
    return ImaPolicy {
        name: name,
        rules: empty_rules,
        default_appraise: false,
        default_measure: true,
        policy_version: 1,
        is_active: true,
        is_locked: false,
    };
}

pub fn ima_policy_add_rule(policy: ImaPolicy, rule: ImaRule) -> ImaPolicy {
    let mut updated_rules: List[ImaRule] = list_new();
    let old_rules: List[ImaRule] = policy.rules;
    let n = list_len(old_rules);
    let mut i = 0;
    while i < n {
        let r_elem: ImaRule = list_get(old_rules, i);
        updated_rules = list_push(updated_rules, r_elem);
        i = i + 1;
    }
    updated_rules = list_push(updated_rules, rule);

    return ImaPolicy {
        name: policy.name,
        rules: updated_rules,
        default_appraise: policy.default_appraise,
        default_measure: policy.default_measure,
        policy_version: policy.policy_version,
        is_active: policy.is_active,
        is_locked: policy.is_locked,
    };
}

pub fn ima_policy_validate(policy: &ImaPolicy) -> Result[Bool, String] {
    if (policy).name.len() == 0 {
        return Err("IMA Policy Validation Error: Policy name cannot be empty");
    }
    if list_len((policy).rules) == 0 {
        return Err("IMA Policy Validation Error: Policy must contain at least one rule");
    }
    return Ok(true);
}

// -------------------------------------------------------------------
// EvmSignature Constructors & Helpers
// -------------------------------------------------------------------

pub fn evm_signature_create(
    algo: Int,
    key_id: String,
    sig_data: String,
    hash_algo: String
) -> EvmSignature {
    let sig_len = sig_data.len();
    let is_valid = (sig_len > 0) && (key_id.len() > 0);
    return EvmSignature {
        algo: algo,
        key_id: key_id,
        sig_data: sig_data,
        hash_algo: hash_algo,
        sig_len: sig_len,
        is_valid: is_valid,
    };
}

pub fn evm_signature_is_valid_format(sig: &EvmSignature) -> Bool {
    if (sig).sig_len <= 0 {
        return false;
    }
    if (sig).key_id.len() == 0 {
        return false;
    }
    return (sig).is_valid;
}

// -------------------------------------------------------------------
// ImaAppraisalResult Constructors & Helpers
// -------------------------------------------------------------------

pub fn ima_appraisal_result_create(
    status: Int,
    target_path: String,
    expected_digest: String,
    actual_digest: String,
    matched_rule_index: Int,
    reason: String
) -> ImaAppraisalResult {
    return ImaAppraisalResult {
        status: status,
        target_path: target_path,
        expected_digest: expected_digest,
        actual_digest: actual_digest,
        matched_rule_index: matched_rule_index,
        reason: reason,
    };
}

pub type Fail = struct {};
pub type Default = struct {};


