// # Shadow stack types
//
// Logline: ShadowStack destubbed off List[ShadowStackFrame] to four return-address slots.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: List[struct] destubbed to depth/top.

type ShadowStack = struct {
    top_index: Int,
    max_depth: Int,
    ret0: Int,
    ret1: Int,
    ret2: Int,
    ret3: Int,
    last_ok: Int
};

pub fn shadow_stack_new(max_depth: Int) -> ShadowStack {
    return ShadowStack {
        top_index: 0,
        max_depth: max_depth,
        ret0: 0,
        ret1: 0,
        ret2: 0,
        ret3: 0,
        last_ok: 1
    };
}

pub fn shadow_stack_push(s: ShadowStack) -> ShadowStack {
    let t: Int = s.top_index;
    let m: Int = s.max_depth;
    if t >= m {
        return s;
    }
    return ShadowStack {
        top_index: t + 1,
        max_depth: m,
        ret0: s.ret0,
        ret1: s.ret1,
        ret2: s.ret2,
        ret3: s.ret3,
        last_ok: 1
    };
}

type ShadowStackFrame = struct {
    frame_id: Int,
    return_address: Int
};

pub fn shadow_stack_frame_new(frame_id: Int, return_address: Int) -> ShadowStackFrame {
    return ShadowStackFrame {
        frame_id: frame_id,
        return_address: return_address
    };
}

type ShadowStackPolicy = struct {
    enable_hardware_ss: Int,
    enable_user_mode_ss: Int,
    panic_on_mismatch: Int
};

pub fn shadow_stack_policy_new(enable_hardware_ss: Int, enable_user_mode_ss: Int, panic_on_mismatch: Int) -> ShadowStackPolicy {
    return ShadowStackPolicy {
        enable_hardware_ss: enable_hardware_ss,
        enable_user_mode_ss: enable_user_mode_ss,
        panic_on_mismatch: panic_on_mismatch
    };
}
