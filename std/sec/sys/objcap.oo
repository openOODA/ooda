// # Object Capability Security Model Facade
//
// Logline: Re-exports object-capability rights, attenuation, cryptographic sealing, and registry management primitives.
//
// Setup: Pure module shim importing object capability subsystem components via companion stubs.
//
// Beats:
//   1. Import Object Capability stubs companion module.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream system security consumers.
//
// ===================================================================
// openOODA Standard Library — ooda::sec::sys::objcap
// Objcap Re-export Shim (M172 split)
// ===================================================================
// The original ~774-line objcap.oo was split at functional seams
// into 7 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./objcap_stubs.oo";

pub fn shim_marker_rights_from_mask() -> CapabilityRights {
    return capability_rights_from_mask(7);
}

pub fn shim_marker_objcap_create() -> ObjectCapability {
    return objcap_create("c1", "res://x", "owner", 7, 1000, 3600);
}

pub fn shim_marker_registry_init() -> ObjectCapabilityRegistry {
    return objcap_registry_init("reg1");
}

pub fn shim_marker_seal_checksum() -> Int {
    return objcap_seal_checksum("payload");
}

pub fn shim_marker_do_work(reg: &ObjectCapabilityRegistry) -> Int {
    return objcap_registry_do_work(reg);
}
