// # ELF Constructors & Factories
//
// Logline: Build ElfHeader, ProgramHeader, SectionHeader, and ElfFile records from spec constants.
//
// Setup: Imports elf_ops.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. elf_header_default: build 64-bit little-endian ElfHeader.
//   2. program_header_create: bind p_type, p_flags, p_offset, p_vaddr, p_filesz, p_memsz.
//   3. section_header_create: bind sh_name, sh_type, sh_flags, sh_addr, sh_size.
//   4. elf_file_new: assemble ElfHeader, program headers, and section headers into ElfFile.
//
// residual: live ELF patch is process_exit in elf_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./elf_ops.oo";

// -------------------------------------------------------------------
// Constructors & Factory Functions
// -------------------------------------------------------------------

pub fn elf_header_default() -> ElfHeader {
    return ElfHeader {
        magic_valid: false,
        ei_class: elf_class_64(),
        ei_data: elf_data_2lsb(),
        ei_version: 1,
        ei_osabi: 0,
        e_type: elf_et_none(),
        e_machine: elf_em_x86_64(),
        e_version: 1,
        e_entry: 0,
        e_phoff: 0,
        e_shoff: 0,
        e_flags: 0,
        e_ehsize: 64,
        e_phentsize: 56,
        e_phnum: 0,
        e_shentsize: 64,
        e_shnum: 0,
        e_shstrndx: 0,
    };
}

pub fn program_header_create(
    p_type: Int,
    p_flags: Int,
    p_offset: Int,
    p_vaddr: Int,
    p_paddr: Int,
    p_filesz: Int,
    p_memsz: Int,
    p_align: Int
) -> ProgramHeader {
    let mut is_x: Bool = false;
    let mut is_w: Bool = false;
    let mut is_r: Bool = false;
    if (p_flags / 1) % 2 != 0 {
        is_x = true;
    }
    if (p_flags / 2) % 2 != 0 {
        is_w = true;
    }
    if (p_flags / 4) % 2 != 0 {
        is_r = true;
    }
    return ProgramHeader {
        p_type: p_type,
        p_flags: p_flags,
        p_offset: p_offset,
        p_vaddr: p_vaddr,
        p_paddr: p_paddr,
        p_filesz: p_filesz,
        p_memsz: p_memsz,
        p_align: p_align,
        is_executable: is_x,
        is_writable: is_w,
        is_readable: is_r,
    };
}

pub fn section_header_create(
    sh_name: Int,
    sh_name_str: String,
    sh_type: Int,
    sh_flags: Int,
    sh_addr: Int,
    sh_offset: Int,
    sh_size: Int,
    sh_link: Int,
    sh_info: Int,
    sh_addralign: Int,
    sh_entsize: Int
) -> SectionHeader {
    let mut is_w: Bool = false;
    let mut is_a: Bool = false;
    let mut is_x: Bool = false;
    if (sh_flags / 1) % 2 != 0 {
        is_w = true;
    }
    if (sh_flags / 2) % 2 != 0 {
        is_a = true;
    }
    if (sh_flags / 4) % 2 != 0 {
        is_x = true;
    }
    return SectionHeader {
        sh_name: sh_name,
        sh_name_str: sh_name_str,
        sh_type: sh_type,
        sh_flags: sh_flags,
        sh_addr: sh_addr,
        sh_offset: sh_offset,
        sh_size: sh_size,
        sh_link: sh_link,
        sh_info: sh_info,
        sh_addralign: sh_addralign,
        sh_entsize: sh_entsize,
        is_alloc: is_a,
        is_exec: is_x,
        is_write: is_w,
    };
}

pub fn elf_symbol_create(
    name_str: String,
    st_value: Int,
    st_size: Int,
    st_info: Int,
    st_shndx: Int
) -> ElfSymbol {
    let bind_type: Int = st_info % 16;
    let bind_sym: Int = st_info / 16;
    let is_glob: Bool = bind_sym == 1;
    let is_func: Bool = bind_type == 2;
    let is_obj: Bool = bind_type == 1;
    return ElfSymbol {
        st_name: 0,
        st_name_str: name_str,
        st_info: st_info,
        st_other: 0,
        st_shndx: st_shndx,
        st_value: st_value,
        st_size: st_size,
        is_global: is_glob,
        is_function: is_func,
        is_object: is_obj,
    };
}

pub fn elf_security_report_default() -> ElfSecurityReport {
    return ElfSecurityReport {
        has_nx_stack: true,
        has_relro: false,
        has_bind_now: false,
        has_canary_symbol: false,
        is_pie: false,
        has_rpath: false,
        has_executable_stack: false,
        security_score: 0,
        violation_count: 0,
        is_compliant: false,
    };
}

pub fn elf_file_new(filename: String) -> ElfFile {
    let empty_ph: List[ProgramHeader] = list_new();
    let empty_sh: List[SectionHeader] = list_new();
    let empty_sym: List[ElfSymbol] = list_new();
    return ElfFile {
        filename: filename,
        header: elf_header_default(),
        program_headers: empty_ph,
        section_headers: empty_sh,
        symbols: empty_sym,
        is_parsed: false,
        security_report: elf_security_report_default(),
    };
}

pub fn elf_engine_ready() -> Int {
    return 1;
}
