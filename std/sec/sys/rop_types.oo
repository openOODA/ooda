// # ROP types
//
// Logline: RopGadget destubbed off List[String] instructions. Chain is three fixed slots.
// residual: List[String] destubbed to Int floor.

type RopGadget = struct {
    address: Int,
    stack_delta: Int,
    gadget_type: Int,
    is_valid: Int
};

pub fn rop_gadget_new(address: Int, stack_delta: Int, gadget_type: Int) -> RopGadget {
    let mut valid: Int = 1;
    if address == 0 {
        valid = 0;
    }
    if stack_delta < 0 {
        valid = 0;
    }
    return RopGadget {
        address: address,
        stack_delta: stack_delta,
        gadget_type: gadget_type,
        is_valid: valid
    };
}

pub fn rop_gadget_addr(g: RopGadget) -> Int {
    return g.address;
}

type GadgetChain = struct {
    g0_addr: Int,
    g0_delta: Int,
    g0_type: Int,
    g0_valid: Int,
    g1_addr: Int,
    g1_delta: Int,
    g1_type: Int,
    g1_valid: Int,
    g2_addr: Int,
    g2_delta: Int,
    g2_type: Int,
    g2_valid: Int,
    n_gad: Int,
    total_stack: Int,
    has_syscall: Int,
    pivot_address: Int,
    last_ok: Int
};

pub fn gadget_chain_empty() -> GadgetChain {
    return GadgetChain {
        g0_addr: 0,
        g0_delta: 0,
        g0_type: 0,
        g0_valid: 0,
        g1_addr: 0,
        g1_delta: 0,
        g1_type: 0,
        g1_valid: 0,
        g2_addr: 0,
        g2_delta: 0,
        g2_type: 0,
        g2_valid: 0,
        n_gad: 0,
        total_stack: 0,
        has_syscall: 0,
        pivot_address: 0,
        last_ok: 1
    };
}
