// # PE Struct Types & Magic Helpers
//
// Logline: Define DosHeader, PeHeader, OptionalHeader, SectionHeader, DataDirectory, and PeImage records.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. DosHeader: bind e_magic, e_cblp, e_cp, e_lfanew, is_valid.
//   2. PeHeader: bind machine, number_of_sections, time_date_stamp, characteristics.
//   3. OptionalHeader: bind magic, entry_point, image_base, section_alignment, is_valid.
//   4. pe_dos_magic: return MZ 0x5A4D tag.
//
// residual: struct + magic only.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

pub type DosHeader = struct {
    e_magic: Int,
    e_cblp: Int,
    e_cp: Int,
    e_crlc: Int,
    e_cparhdr: Int,
    e_minalloc: Int,
    e_maxalloc: Int,
    e_ss: Int,
    e_sp: Int,
    e_csum: Int,
    e_ip: Int,
    e_cs: Int,
    e_lfarlc: Int,
    e_ovno: Int,
    e_lfanew: Int,
    is_valid: Bool,
};

pub type PeHeader = struct {
    machine: Int,
    number_of_sections: Int,
    time_date_stamp: Int,
    pointer_to_symbol_table: Int,
    number_of_symbols: Int,
    size_of_optional_header: Int,
    characteristics: Int,
    is_valid: Bool,
};

pub type OptionalHeader = struct {
    magic: Int,
    major_linker_version: Int,
    minor_linker_version: Int,
    size_of_code: Int,
    size_of_initialized_data: Int,
    size_of_uninitialized_data: Int,
    address_of_entry_point: Int,
    base_of_code: Int,
    image_base: Int,
    section_alignment: Int,
    file_alignment: Int,
    major_os_version: Int,
    minor_os_version: Int,
    major_image_version: Int,
    minor_image_version: Int,
    major_subsystem_version: Int,
    minor_subsystem_version: Int,
    win32_version_value: Int,
    size_of_image: Int,
    size_of_headers: Int,
    checksum: Int,
    subsystem: Int,
    dll_characteristics: Int,
    size_of_stack_reserve: Int,
    size_of_stack_commit: Int,
    size_of_heap_reserve: Int,
    size_of_heap_commit: Int,
    loader_flags: Int,
    number_of_rva_and_sizes: Int,
    is_64bit: Bool,
    is_valid: Bool,
};

pub type DataDirectory = struct {
    name: String,
    virtual_address: Int,
    size: Int,
    is_present: Bool,
};

pub type SectionHeader = struct {
    name: String,
    virtual_size: Int,
    virtual_address: Int,
    size_of_raw_data: Int,
    pointer_to_raw_data: Int,
    pointer_to_relocations: Int,
    pointer_to_linenumbers: Int,
    number_of_relocations: Int,
    number_of_linenumbers: Int,
    characteristics: Int,
    is_executable: Bool,
    is_readable: Bool,
    is_writable: Bool,
};

pub type PeSecurityAudit = struct {
    has_aslr: Bool,
    has_high_entropy_va: Bool,
    has_dep_nx: Bool,
    has_cfg: Bool,
    has_force_integrity: Bool,
    has_no_seh: Bool,
    has_authenticode: Bool,
    has_wx_sections: Bool,
    is_dll: Bool,
    security_score: Int,
};

pub type PeImage = struct {
    filepath: String,
    dos_header: DosHeader,
    pe_header: PeHeader,
    optional_header: OptionalHeader,
    data_directories: List[DataDirectory],
    sections: List[SectionHeader],
    audit: PeSecurityAudit,
    is_64bit: Bool,
    is_valid: Bool,
    raw_size: Int,
};

pub type PeExportSymbol = struct {
    name: String,
    ordinal: Int,
    rva: Int,
    is_forwarder: Bool,
    forwarder_name: String,
};

pub type PeImportSymbol = struct {
    dll_name: String,
    symbol_name: String,
    ordinal: Int,
    hint: Int,
    import_by_ordinal: Bool,
};

// -------------------------------------------------------------------
// PE/COFF Constants & Machine / Flag Definition Functions
// -------------------------------------------------------------------

pub fn pe_dos_magic() -> Int {
    return 23117; // 0x5A4D ("MZ")
}

pub fn pe_signature() -> Int {
    return 17744; // 0x4550 ("PE\0\0")
}

pub fn pe32_magic() -> Int {
    return 267; // 0x010B (PE32 32-bit executable)
}

pub fn pe32_plus_magic() -> Int {
    return 523; // 0x020B (PE32+ 64-bit executable)
}

pub fn pe_machine_i386() -> Int {
    return 332; // 0x014C (Intel 386)
}

pub fn pe_machine_amd64() -> Int {
    return 34404; // 0x8664 (AMD64 / x86_64)
}

pub fn pe_machine_arm() -> Int {
    return 448; // 0x01C0 (ARM Little-Endian)
}

pub fn pe_machine_arm64() -> Int {
    return 43620; // 0xAA64 (ARM64 Little-Endian)
}

pub fn pe_machine_riscv64() -> Int {
    return 20580; // 0x5064 (RISC-V 64-bit)
}

pub fn pe_dllchar_high_entropy_va() -> Int {
    return 32; // 0x0020
}

pub fn pe_dllchar_dynamic_base() -> Int {
    return 64; // 0x0040 (ASLR)
}

pub fn pe_dllchar_force_integrity() -> Int {
    return 128; // 0x0080
}

pub fn pe_dllchar_nx_compat() -> Int {
    return 256; // 0x0100 (DEP / NX)
}

pub fn pe_dllchar_no_isolation() -> Int {
    return 512; // 0x0200
}

pub fn pe_dllchar_no_seh() -> Int {
    return 1024; // 0x0400
}

pub fn pe_dllchar_no_bind() -> Int {
    return 2048; // 0x0800
}

pub fn pe_dllchar_appcontainer() -> Int {
    return 4096; // 0x1000
}

pub fn pe_dllchar_wdm_driver() -> Int {
    return 8192; // 0x2000
}

pub fn pe_dllchar_guard_cf() -> Int {
    return 16384; // 0x4000 (Control Flow Guard)
}

pub fn pe_dllchar_terminal_server_aware() -> Int {
    return 32768; // 0x8000
}

pub fn pe_subsystem_native() -> Int {
    return 1;
}

pub fn pe_subsystem_windows_gui() -> Int {
    return 2;
}

pub fn pe_subsystem_windows_cui() -> Int {
    return 3;
}

pub fn pe_subsystem_posix_cui() -> Int {
    return 7;
}

pub fn pe_subsystem_efi_application() -> Int {
    return 10;
}

