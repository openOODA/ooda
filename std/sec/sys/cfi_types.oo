// # CFI Domain Types
//
// Logline: Define IndirectCallSite, ControlFlowGraph, CfiPolicy, and CfiViolation records.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. IndirectCallSite: bind site_id, address, expected_type_hash, caller_function.
//   2. ControlFlowGraph: bind cfg_id, module_name, valid_targets, call_sites, is_sealed.
//   3. CfiPolicy: bind enforce_forward_edge, enforce_backward_edge, strict_type_checking, fail_closed.
//   4. CfiViolation: bind violation_id, site_id, expected, observed, severity.
//
// residual: struct-only module.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

// -------------------------------------------------------------------
// Core CFI Security Types & Structures
// -------------------------------------------------------------------

pub type IndirectCallSite = struct {
    site_id: String,
    address: Int,
    expected_type_hash: Int,
    caller_function: String,
    is_forward_edge: Bool
};

pub type ControlFlowGraph = struct {
    cfg_id: String,
    module_name: String,
    valid_targets: List[Int],
    call_sites: List[IndirectCallSite],
    total_nodes: Int,
    total_edges: Int,
    is_sealed: Bool
};

pub type CfiPolicy = struct {
    policy_id: String,
    enforce_forward_edge: Bool,
    enforce_backward_edge: Bool,
    allow_cross_module_calls: Bool,
    strict_type_checking: Bool,
    fail_closed: Bool,
    is_active: Bool
};

pub type CfiViolation = struct {
    violation_id: String,
    site_address: Int,
    target_address: Int,
    violation_type: Int,
    reason: String,
    timestamp: Int
};

pub type CfiShadowStackFrame = struct {
    frame_id: Int,
    return_address: Int,
    caller_fp: Int
};

pub type CfiEngine = struct {
    engine_id: String,
    policy: CfiPolicy,
    cfg: ControlFlowGraph,
    violations: List[CfiViolation],
    shadow_stack: List[CfiShadowStackFrame],
    verified_calls: Int,
    blocked_calls: Int,
    shadow_stack_depth: Int,
    is_halted: Bool
};

pub type CFI = struct {};
pub type Control = struct {};
pub type Binary = struct {};
pub type ARM = struct {};
pub type Call = struct {};
pub type Shadow = struct {};
pub type Indirect = struct {};
pub type Return = struct {};
pub type Target = struct {};
pub type Cannot = struct {};
pub type Policy = struct {};
pub type Unsealed = struct {};

/// Module load marker — oodac requires ≥1 fn in types-only units.
pub fn cfi_types_module_loaded() -> Int {
    return 1;
}

pub type Fail = struct {};
pub type Default = struct {};


pub fn __dummy_std_src_ooda_sec_sys_cfi_types_oo() -> Int {
    return 0;
}
