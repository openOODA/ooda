// # ASLR entropy bits
//
// Logline: Count how many times size can be halved; that is the entropy bit count.
//
// Setup: Pure Int. No structs. No caps.
//
// Beats:
//   1. Size <= 0 is 0 bits.
//   2. Halve until 1.
//   3. Return the step count.

pub fn aslr_compute_entropy(size: Int) -> Int {
    if size <= 0 {
        return 0;
    }
    let mut bits: Int = 0;
    let mut n: Int = size;
    while n > 1 {
        let half: Int = n / 2;
        n = half;
        bits = bits + 1;
    }
    return bits;
}
