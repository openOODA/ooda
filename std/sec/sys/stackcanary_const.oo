// # Stack Canary Constants and Protection Levels
//
// Logline: Provides protection level flags and default magic cookie values for stack canary initialization.
//
// Setup: Pure constant helper functions mirroring compiler stack protector levels (-fstack-protector).
//
// Beats:
//   1. Define protection levels (disabled, standard, strong, all, shadow stack).
//   2. Define default magic canary cookie constant.

pub fn canary_level_disabled() -> Int {
    return 0;
}

pub fn canary_level_standard() -> Int {
    return 1;
}

pub fn canary_level_strong() -> Int {
    return 2;
}

pub fn canary_level_all() -> Int {
    return 3;
}

pub fn canary_level_shadow_stack() -> Int {
    return 4;
}

pub fn canary_default_magic_cookie() -> Int {
    return 3735928559;
}

pub fn __dummy_std_src_ooda_sec_sys_stackcanary_const_oo() -> Int {
    return 0;
}
