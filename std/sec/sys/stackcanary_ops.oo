// # Stack Frame Operations & Canary Calculations
//
// Logline: Implements stack frame constructors, deterministic canary hash generation, and integrity report constructors.
//
// Setup: Imports stackcanary_types.oo and stackcanary_const.oo for stack frame hashing and evaluation.
//
// Beats:
//   1. Construct and validate StackFrame records with bounds checking.
//   2. Compute and verify expected canary values using secret and frame pointers.
//   3. Construct StackIntegrity evaluation reports.

import "./stackcanary_types.oo";
import "./stackcanary_const.oo";

pub fn stack_frame_create(
    frame_id: String,
    function_name: String,
    frame_pointer: Int,
    stack_pointer: Int,
    frame_size: Int,
    return_address: Int,
    canary_value: Int
) -> StackFrame {
    let mut valid: Bool = true;
    if frame_size < 0 {
        valid = false;
    }
    if frame_pointer < stack_pointer {
        valid = false;
    }
    return StackFrame {
        frame_id: frame_id,
        function_name: function_name,
        frame_pointer: frame_pointer,
        stack_pointer: stack_pointer,
        frame_size: frame_size,
        canary_value: canary_value,
        return_address: return_address,
        is_valid: valid,
        allocated_bytes: frame_size
    };
}

pub fn stack_frame_compute_canary(secret: Int, frame_pointer: Int, func_name: String) -> Int {
    let name_len: Int = func_name.len();
    let computed: Int = secret + frame_pointer * 31 + name_len * 17;
    return computed;
}

pub fn stack_frame_verify(frame: &StackFrame, expected_secret: Int) -> Bool {
    if (frame).is_valid == false {
        return false;
    }
    let expected_canary: Int = stack_frame_compute_canary(
        expected_secret,
        (frame).frame_pointer,
        (frame).function_name
    );
    return (frame).canary_value == expected_canary;
}

pub fn stack_integrity_create(
    integrity_id: String,
    total: Int,
    passed: Int,
    corrupted: Int,
    canary_errs: Int,
    ret_errs: Int,
    healthy: Bool,
    ts: Int,
    msg: String
) -> StackIntegrity {
    return StackIntegrity {
        integrity_id: integrity_id,
        total_frames_checked: total,
        passed_frames: passed,
        corrupted_frames: corrupted,
        canary_mismatches: canary_errs,
        return_address_mismatches: ret_errs,
        is_stack_healthy: healthy,
        timestamp: ts,
        diagnostic_message: msg
    };
}

pub fn stack_integrity_is_ok(si: &StackIntegrity) -> Bool {
    return (si).is_stack_healthy;
}

