// # Linux Landlock LSM Sandboxing Facade
//
// Logline: Re-exports Landlock LSM sandbox ruleset configuration, filesystem and network access rights enforcement, and kernel syscall interfaces.
//
// Setup: Pure module shim importing Landlock subsystem components via companion stubs.
//
// Beats:
//   1. Import Landlock LSM stubs companion module.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream system security consumers.
//
// ===================================================================
// openOODA Standard Library — ooda::sec::sys::landlock
// Landlock Re-export Shim (M172 split)
// ===================================================================
// Original ~728-line landlock.oo split at functional seams into
// landlock_types / landlock_const / landlock_ops / landlock_ruleset /
// landlock_engine / landlock_stubs (each ≤256 lines). This shim re-exports
// public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./landlock_stubs.oo";

pub fn shim_marker_access_fs_read_file() -> Int {
    return landlock_access_fs_read_file();
}

pub fn shim_marker_access_fs_all() -> Int {
    return landlock_access_fs_all();
}

pub fn shim_marker_access_rights_empty() -> AccessRights {
    return access_rights_empty();
}

pub fn shim_marker_access_rights_read_only() -> AccessRights {
    return access_rights_read_only();
}

pub fn shim_marker_path_beneath() -> PathBeneathAttr {
    return path_beneath_attr_create("/tmp", landlock_access_fs_read_file(), -1);
}

pub fn shim_marker_net_port() -> NetPortAttr {
    return net_port_attr_create(443, landlock_access_net_connect_tcp());
}

pub fn shim_marker_ruleset_new() -> LandlockRuleset {
    return landlock_ruleset_new("default", landlock_access_fs_all(), landlock_access_net_all());
}

pub fn shim_marker_check_path_prefix() -> Bool {
    return landlock_check_path_prefix("/home", "/home/user/file");
}

pub fn shim_marker_ruleset_do_work(ruleset: &LandlockRuleset) -> Int {
    return landlock_ruleset_do_work(ruleset);
}
