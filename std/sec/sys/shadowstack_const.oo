// # Hardware Shadow Stack Constants
//
// Logline: Provides default stack sizing limits, page dimensions, and violation classification codes for shadow stacks.
//
// Setup: Pure constant helper functions mirroring CPU architecture shadow stack geometries.
//
// Beats:
//   1. Define default maximum frame depth and shadow stack page size.
//   2. Define violation codes (return address mismatch, underflow, overflow).

pub fn shadowstack_default_max_depth() -> Int {
    return 1024;
}

pub fn shadowstack_default_page_size() -> Int {
    return 4096;
}

pub fn shadowstack_violation_ret_mismatch() -> Int {
    return 1;
}

pub fn shadowstack_violation_underflow() -> Int {
    return 2;
}

pub fn shadowstack_violation_overflow() -> Int {
    return 3;
}

pub fn __dummy_std_src_ooda_sec_sys_shadowstack_const_oo() -> Int {
    return 0;
}
