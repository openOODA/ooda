// ===================================================================
// openOODA Standard Library — ooda::sec::sys::audit
// Linux Audit Re-export Shim (M172 split)
// ===================================================================
// Original ~625-line audit.oo split at functional seams into
// audit_types / audit_const / audit_ops / audit_engine / audit_stubs
// (each ≤256 lines). This shim re-exports public names so existing
// callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./audit_types.oo";
import "./audit_const.oo";
import "./audit_ops.oo";
import "./audit_engine.oo";
import "./audit_stubs.oo";

pub fn shim_marker_type_syscall() -> Int {
    return audit_type_syscall();
}

pub fn shim_marker_always() -> Int {
    return audit_always();
}

pub fn shim_marker_arch_x86_64() -> Int {
    return audit_arch_x86_64();
}

pub fn shim_marker_rule_new() -> AuditRule {
    return audit_rule_new("/etc/passwd", "identity", "wa");
}

pub fn shim_marker_event_empty() -> AuditEvent {
    return audit_event_empty();
}

pub fn shim_marker_client_new() -> AuditdClient {
    return auditd_client_new("shim-audit");
}

pub fn shim_marker_status_default() -> AuditStatus {
    return audit_status_default();
}

pub fn shim_marker_check_path_prefix() -> Bool {
    return audit_check_path_prefix("/home", "/home/user/file");
}

pub fn shim_marker_client_do_work(client: &AuditdClient) -> Int {
    return auditd_client_do_work(client);
}

pub type Large = struct {};


pub fn __dummy_std_src_ooda_sec_sys_audit_oo() -> Int {
    return 0;
}
