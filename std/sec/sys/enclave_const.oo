// # Enclave Constants and Attribute Flags
//
// Logline: Provides vendor IDs and hardware security attribute bitmasks for SGX, TDX, SEV, and TrustZone enclaves.
//
// Setup: Pure constant helper functions mirroring confidential computing hardware ABIs.
//
// Beats:
//   1. Define hardware vendor identifiers (Intel, AMD, ARM).
//   2. Define SGX and TEE attribute bitflags (debug, 64-bit mode, provisioning, KSS, AEX).

pub fn enclave_vendor_intel() -> Int {
    return 1;
}

pub fn enclave_vendor_amd() -> Int {
    return 2;
}

pub fn enclave_vendor_arm() -> Int {
    return 3;
}

pub fn enclave_attr_debug() -> Int {
    return 1;
}

pub fn enclave_attr_mode64bit() -> Int {
    return 2;
}

pub fn enclave_attr_provision_key() -> Int {
    return 4;
}

pub fn enclave_attr_einittoken_key() -> Int {
    return 8;
}

pub fn enclave_attr_kss() -> Int {
    return 16;
}

pub fn enclave_attr_aex_notify() -> Int {
    return 32;
}

pub fn __dummy_std_src_ooda_sec_sys_enclave_const_oo() -> Int {
    return 0;
}
