// ===================================================================
// openOODA Standard Library — ooda::sec::sys::ima
// IMA/EVM Re-export Shim (M172 split)
// ===================================================================
// Original ~631-line ima.oo split at functional seams into
// ima_types / ima_const / ima_ops / ima_engine / ima_stubs
// (each ≤256 lines). This shim re-exports public names so existing
// callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./ima_types.oo";
import "./ima_const.oo";
import "./ima_ops.oo";
import "./ima_engine.oo";
import "./ima_stubs.oo";

pub fn shim_marker_action_measure() -> Int {
    return ima_action_measure();
}

pub fn shim_marker_action_appraise() -> Int {
    return ima_action_appraise();
}

pub fn shim_marker_default_pcr() -> Int {
    return ima_default_pcr();
}

pub fn shim_marker_integrity_pass() -> Int {
    return integrity_pass();
}

pub fn shim_marker_policy_new() -> ImaPolicy {
    return ima_policy_new("default");
}

pub fn shim_marker_rule_create() -> ImaRule {
    return ima_rule_create(ima_action_appraise(), ima_func_file_check(), ima_may_exec());
}

pub fn shim_marker_context_new() -> ImaContext {
    return ima_context_new("ima");
}

pub fn shim_marker_context_do_work(ctx: &ImaContext) -> Int {
    return ima_context_do_work(ctx);
}

pub type Large = struct {};


pub fn __dummy_std_src_ooda_sec_sys_ima_oo() -> Int {
    return 0;
}
