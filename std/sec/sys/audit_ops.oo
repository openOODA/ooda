// # Audit Rule, Event, Client Constructors & Builders
//
// Logline: Build AuditRule, AuditEvent, and AuditdClient records; bind syscall, action, and arch fields.
//
// Setup: Imports audit_const.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. audit_rule_new: build path-keyed AuditRule with default action.
//   2. audit_rule_syscall: build syscall-number-keyed AuditRule.
//   3. audit_event_empty: zeroed AuditEvent record.
//   4. auditd_client_init: build AuditdClient with seq_num and pid.
//
// residual: live netlink transport is process_exit in audit_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./audit_const.oo";

// -------------------------------------------------------------------
// Constructors & Builders
// -------------------------------------------------------------------

pub fn audit_rule_new(path: String, key: String, permissions: String) -> AuditRule {
    return AuditRule {
        path: path,
        syscall_nr: -1,
        action: audit_always(),
        filter_list: audit_filter_exit(),
        key: key,
        permissions: permissions,
        arch: audit_arch_x86_64(),
        is_enabled: true
    };
}

pub fn audit_rule_syscall(syscall_nr: Int, action: Int, filter_list: Int, key: String) -> AuditRule {
    return AuditRule {
        path: "",
        syscall_nr: syscall_nr,
        action: action,
        filter_list: filter_list,
        key: key,
        permissions: "",
        arch: audit_arch_x86_64(),
        is_enabled: true
    };
}

pub fn audit_rule_create(
    path: String,
    syscall_nr: Int,
    action: Int,
    filter_list: Int,
    key: String,
    permissions: String,
    arch: Int
) -> AuditRule {
    return AuditRule {
        path: path,
        syscall_nr: syscall_nr,
        action: action,
        filter_list: filter_list,
        key: key,
        permissions: permissions,
        arch: arch,
        is_enabled: true
    };
}

pub fn audit_event_empty() -> AuditEvent {
    return AuditEvent {
        event_id: 0,
        timestamp_sec: 0,
        type_id: 0,
        pid: 0,
        uid: 0,
        gid: 0,
        auid: 0,
        exe: "",
        comm: "",
        syscall_nr: -1,
        success: true,
        exit_code: 0,
        key: "",
        raw_message: ""
    };
}

pub fn audit_event_create(
    event_id: Int,
    timestamp_sec: Int,
    type_id: Int,
    pid: Int,
    uid: Int,
    auid: Int,
    exe: String,
    comm: String,
    syscall_nr: Int,
    success: Bool,
    exit_code: Int,
    key: String,
    raw_message: String
) -> AuditEvent {
    return AuditEvent {
        event_id: event_id,
        timestamp_sec: timestamp_sec,
        type_id: type_id,
        pid: pid,
        uid: uid,
        gid: 0,
        auid: auid,
        exe: exe,
        comm: comm,
        syscall_nr: syscall_nr,
        success: success,
        exit_code: exit_code,
        key: key,
        raw_message: raw_message
    };
}

pub fn auditd_client_new(name: String) -> AuditdClient {
    let empty_rules: List[AuditRule] = list_new();
    return AuditdClient {
        name: name,
        socket_fd: -1,
        seq_num: 1,
        pid: 0,
        is_connected: false,
        is_enabled: true,
        rate_limit: 0,
        backlog_limit: 8192,
        rules: empty_rules,
        stats_events_received: 0,
        stats_rules_loaded: 0,
        stats_failures: 0
    };
}

pub fn auditd_client_init(name: String, pid: Int, rate_limit: Int, backlog_limit: Int) -> AuditdClient {
    let empty_rules: List[AuditRule] = list_new();
    return AuditdClient {
        name: name,
        socket_fd: -1,
        seq_num: 1,
        pid: pid,
        is_connected: false,
        is_enabled: true,
        rate_limit: rate_limit,
        backlog_limit: backlog_limit,
        rules: empty_rules,
        stats_events_received: 0,
        stats_rules_loaded: 0,
        stats_failures: 0
    };
}

pub fn auditd_client_add_rule(client: AuditdClient, rule: AuditRule) -> AuditdClient {
    let mut updated_rules: List[AuditRule] = list_new();
    let old_rules: List[AuditRule] = client.rules;
    let n: Int = list_len(old_rules);
    let mut i: Int = 0;
    while i < n {
        let r: AuditRule = list_get(old_rules, i);
        updated_rules = list_push(updated_rules, r);
        i = i + 1;
    }
    updated_rules = list_push(updated_rules, rule);

    let loaded: Int = client.stats_rules_loaded;
    return AuditdClient {
        name: client.name,
        socket_fd: client.socket_fd,
        seq_num: client.seq_num,
        pid: client.pid,
        is_connected: client.is_connected,
        is_enabled: client.is_enabled,
        rate_limit: client.rate_limit,
        backlog_limit: client.backlog_limit,
        rules: updated_rules,
        stats_events_received: client.stats_events_received,
        stats_rules_loaded: loaded + 1,
        stats_failures: client.stats_failures
    };
}

pub fn audit_status_default() -> AuditStatus {
    return AuditStatus {
        enabled: 1,
        failure: 1,
        pid: 0,
        rate_limit: 0,
        backlog_limit: 8192,
        lost: 0,
        backlog: 0
    };
}

// -------------------------------------------------------------------
// Verification & Validation
// -------------------------------------------------------------------

pub fn audit_rule_validate(rule: &AuditRule) -> Result[Bool, String] {
    let r_path: String = rule.path;
    let path_len: Int = r_path.len();
    let r_key: String = rule.key;
    let key_len: Int = r_key.len();
    if path_len == 0 && rule.syscall_nr < 0 && key_len == 0 {
        return Err("Audit Validation Error: Rule must specify path, syscall_nr, or key");
    }
    return Ok(true);
}

pub fn audit_event_validate(event: &AuditEvent) -> Result[Bool, String] {
    if event.timestamp_sec < 0 {
        return Err("Audit Validation Error: Timestamp cannot be negative");
    }
    if event.pid < 0 {
        return Err("Audit Validation Error: PID cannot be negative");
    }
    return Ok(true);
}

pub fn auditd_client_validate(client: &AuditdClient) -> Result[Bool, String] {
    let c_name: String = client.name;
    let name_len: Int = c_name.len();
    if name_len == 0 {
        return Err("Audit Validation Error: Client name cannot be empty");
    }
    if client.backlog_limit <= 0 {
        return Err("Audit Validation Error: Backlog limit must be greater than zero");
    }
    return Ok(true);
}

pub type Fail = struct {};
pub type Default = struct {};


