// # CFI Call-Site, CFG, Policy & Engine Constructors
//
// Logline: Build IndirectCallSite, ControlFlowGraph, CfiPolicy, and CfiEngine records; provide pure helpers.
//
// Setup: Imports cfi_const.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. indirect_call_site_create: bind site_id, address, expected_type_hash.
//   2. indirect_call_site_verify_type: gate against expected_type_hash.
//   3. control_flow_graph_new: build CFG with empty valid_targets and call_sites.
//   4. cfi_policy_init: build strict CfiPolicy with fail_closed and is_active.
//
// residual: live CFI FFI is process_exit in stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./cfi_const.oo";

// -------------------------------------------------------------------
// Constructors & Pure Helper Functions
// -------------------------------------------------------------------

pub fn indirect_call_site_create(
    site_id_val: String,
    address_val: Int,
    expected_type_hash_val: Int,
    caller_function_val: String,
    is_forward_edge_val: Bool
) -> IndirectCallSite {
    return IndirectCallSite {
        site_id: site_id_val,
        address: address_val,
        expected_type_hash: expected_type_hash_val,
        caller_function: caller_function_val,
        is_forward_edge: is_forward_edge_val
    };
}

pub fn indirect_call_site_verify_type(site_ref: &IndirectCallSite, target_type_hash_val: Int) -> Bool {
    let exp: Int = (site_ref).expected_type_hash;
    if exp == 0 {
        return true;
    }
    return exp == target_type_hash_val;
}

pub fn control_flow_graph_new(cfg_id_val: String, module_name_val: String) -> ControlFlowGraph {
    let empty_targets: List[Int] = list_new();
    let empty_sites: List[IndirectCallSite] = list_new();
    return ControlFlowGraph {
        cfg_id: cfg_id_val,
        module_name: module_name_val,
        valid_targets: empty_targets,
        call_sites: empty_sites,
        total_nodes: 0,
        total_edges: 0,
        is_sealed: false
    };
}

pub fn control_flow_graph_add_target(cfg_val: ControlFlowGraph, target_address_val: Int) -> ControlFlowGraph {
    let mut updated_targets: List[Int] = list_new();
    let old_targets: List[Int] = cfg_val.valid_targets;
    let n: Int = list_len(old_targets);
    let mut i: Int = 0;
    while i < n {
        let t: Int = list_get(old_targets, i);
        updated_targets = list_push(updated_targets, t);
        i = i + 1;
    }
    updated_targets = list_push(updated_targets, target_address_val);
    let cur_nodes: Int = cfg_val.total_nodes;
    let new_nodes: Int = cur_nodes + 1;

    return ControlFlowGraph {
        cfg_id: cfg_val.cfg_id,
        module_name: cfg_val.module_name,
        valid_targets: updated_targets,
        call_sites: cfg_val.call_sites,
        total_nodes: new_nodes,
        total_edges: cfg_val.total_edges,
        is_sealed: cfg_val.is_sealed
    };
}

pub fn control_flow_graph_add_call_site(cfg_val: ControlFlowGraph, site_val: IndirectCallSite) -> ControlFlowGraph {
    let mut updated_sites: List[IndirectCallSite] = list_new();
    let old_sites: List[IndirectCallSite] = cfg_val.call_sites;
    let n: Int = list_len(old_sites);
    let mut i: Int = 0;
    while i < n {
        let s: IndirectCallSite = list_get(old_sites, i);
        updated_sites = list_push(updated_sites, s);
        i = i + 1;
    }
    updated_sites = list_push(updated_sites, site_val);
    let cur_edges: Int = cfg_val.total_edges;
    let new_edges: Int = cur_edges + 1;

    return ControlFlowGraph {
        cfg_id: cfg_val.cfg_id,
        module_name: cfg_val.module_name,
        valid_targets: cfg_val.valid_targets,
        call_sites: updated_sites,
        total_nodes: cfg_val.total_nodes,
        total_edges: new_edges,
        is_sealed: cfg_val.is_sealed
    };
}

pub fn control_flow_graph_seal(cfg_val: ControlFlowGraph) -> ControlFlowGraph {
    return ControlFlowGraph {
        cfg_id: cfg_val.cfg_id,
        module_name: cfg_val.module_name,
        valid_targets: cfg_val.valid_targets,
        call_sites: cfg_val.call_sites,
        total_nodes: cfg_val.total_nodes,
        total_edges: cfg_val.total_edges,
        is_sealed: true
    };
}

pub fn control_flow_graph_contains_target(cfg_ref: &ControlFlowGraph, target_address_val: Int) -> Bool {
    let targets: List[Int] = (cfg_ref).valid_targets;
    let n: Int = list_len(targets);
    let mut i: Int = 0;
    while i < n {
        let t: Int = list_get(targets, i);
        if t == target_address_val {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn control_flow_graph_find_site(
    cfg_ref: &ControlFlowGraph,
    site_address_val: Int
) -> Result[IndirectCallSite, String] {
    let sites: List[IndirectCallSite] = (cfg_ref).call_sites;
    let n: Int = list_len(sites);
    let mut i: Int = 0;
    while i < n {
        let s: IndirectCallSite = list_get(sites, i);
        let s_addr: Int = s.address;
        if s_addr == site_address_val {
            return Ok(s);
        }
        i = i + 1;
    }
    return Err("CFI_CFG_ERR: Call site address not found in control flow graph");
}

pub fn cfi_policy_init(
    policy_id_val: String,
    enforce_forward_val: Bool,
    enforce_backward_val: Bool,
    fail_closed_val: Bool
) -> CfiPolicy {
    return CfiPolicy {
        policy_id: policy_id_val,
        enforce_forward_edge: enforce_forward_val,
        enforce_backward_edge: enforce_backward_val,
        allow_cross_module_calls: false,
        strict_type_checking: true,
        fail_closed: fail_closed_val,
        is_active: true
    };
}

pub fn cfi_policy_validate(policy_ref: &CfiPolicy) -> Result[Bool, String] {
    let pid: String = (policy_ref).policy_id;
    let pid_len: Int = pid.len();
    if pid_len == 0 {
        return Err("CFI_POLICY_ERR: Policy ID cannot be empty");
    }
    if (policy_ref).is_active == false {
        return Err("CFI_POLICY_ERR: Policy is inactive");
    }
    return Ok(true);
}

pub fn cfi_violation_create(
    violation_id_val: String,
    site_address_val: Int,
    target_address_val: Int,
    violation_type_val: Int,
    reason_val: String,
    timestamp_val: Int
) -> CfiViolation {
    return CfiViolation {
        violation_id: violation_id_val,
        site_address: site_address_val,
        target_address: target_address_val,
        violation_type: violation_type_val,
        reason: reason_val,
        timestamp: timestamp_val
    };
}

pub fn cfi_engine_init(
    engine_id_val: String,
    policy_val: CfiPolicy,
    cfg_val: ControlFlowGraph
) -> CfiEngine {
    let empty_violations: List[CfiViolation] = list_new();
    let empty_stack: List[CfiShadowStackFrame] = list_new();
    return CfiEngine {
        engine_id: engine_id_val,
        policy: policy_val,
        cfg: cfg_val,
        violations: empty_violations,
        shadow_stack: empty_stack,
        verified_calls: 0,
        blocked_calls: 0,
        shadow_stack_depth: 0,
        is_halted: false
    };
}

pub fn cfi_export_cfg_summary(cfg_ref: &ControlFlowGraph) -> String {
    let cid: String = (cfg_ref).cfg_id;
    let mod_name: String = (cfg_ref).module_name;
    let targets: List[Int] = (cfg_ref).valid_targets;
    let sites: List[IndirectCallSite] = (cfg_ref).call_sites;
    let n_t: Int = list_len(targets);
    let n_s: Int = list_len(sites);
    let mut sealed_str: String = "UNSEALED";
    if (cfg_ref).is_sealed {
        sealed_str = "SEALED";
    }

    let nt_str: String = n_t.to_string();
    let ns_str: String = n_s.to_string();
    return "CFG[" + cid + "] Module: " + mod_name + " (" + sealed_str + ") - Targets: " + nt_str + ", Sites: " + ns_str;
}

pub type Fail = struct {};
pub type Default = struct {};


pub fn __dummy_std_src_ooda_sec_sys_cfi_ops_oo() -> Int {
    return 0;
}
