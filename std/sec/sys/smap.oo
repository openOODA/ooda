pub fn shim_marker_smap_cr4_bit() -> Int {
    return smap_cr4_bit();
}

pub fn shim_marker_smap_access_read() -> Int {
    return smap_access_read();
}

pub fn shim_marker_smap_status_new() -> SmapStatus {
    return smap_status_new("st1", true);
}

pub fn shim_marker_smap_policy_default() -> SmapPolicy {
    return smap_policy_default();
}

pub fn shim_marker_smap_violation_create() -> SmapViolation {
    return smap_violation_create(4194304, 100, 1, 1000);
}

pub fn shim_marker_smap_has_cr4_bit() -> Bool {
    return smap_has_cr4_bit(2097152);
}

pub fn shim_marker_smap_engine_init() -> SmapEngine {
    return smap_engine_init("eng1", smap_policy_default());
}

pub fn shim_marker_smap_engine_do_work(engine: &SmapEngine) -> Int {
    return smap_engine_do_work(engine);
}

