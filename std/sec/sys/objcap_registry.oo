// ===================================================================
// openOODA Standard Library — ooda::sec::sys::objcap_registry
// Registry init, register, lookup, is_revoked
// (split from objcap.oo, M172)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./objcap_seal.oo";

pub fn objcap_registry_init(registry_id_val: String) -> ObjectCapabilityRegistry {
    let empty_caps: List[ObjectCapability] = list_new();
    let empty_revs: List[CapabilityRevocation] = list_new();
    let empty_atts: List[CapabilityAttenuation] = list_new();
    let empty_audits: List[CapabilityAuditRecord] = list_new();
    return ObjectCapabilityRegistry {
        registry_id: registry_id_val,
        capabilities: empty_caps,
        revocations: empty_revs,
        attenuations: empty_atts,
        audits: empty_audits,
        total_exercised: 0,
        total_revoked: 0,
        strict_mode: true,
        is_halted: false,
    };
}

pub fn objcap_registry_register_cap(
    mut_reg_ref: &mut ObjectCapabilityRegistry,
    cap_val: ObjectCapability
) -> Result[Bool, String] {
    if (mut_reg_ref).is_halted {
        return Err("OBJCAP_REGISTRY_ERR: Registry is halted");
    }
    if cap_val.is_valid == false {
        return Err("OBJCAP_REGISTRY_ERR: Cannot register invalid capability");
    }
    let cur_caps = (mut_reg_ref).capabilities;
    let new_caps = list_push(cur_caps, cap_val);
    (mut_reg_ref).capabilities = new_caps;
    return Ok(true);
}

pub fn objcap_registry_register_revocation(
    mut_reg_ref: &mut ObjectCapabilityRegistry,
    rev_val: CapabilityRevocation
) -> Result[Bool, String] {
    if (mut_reg_ref).is_halted {
        return Err("OBJCAP_REGISTRY_ERR: Registry is halted");
    }
    let cur_revs = (mut_reg_ref).revocations;
    let new_revs = list_push(cur_revs, rev_val);
    (mut_reg_ref).revocations = new_revs;
    return Ok(true);
}

pub fn objcap_registry_register_attenuation(
    mut_reg_ref: &mut ObjectCapabilityRegistry,
    att_val: CapabilityAttenuation
) -> Result[Bool, String] {
    if (mut_reg_ref).is_halted {
        return Err("OBJCAP_REGISTRY_ERR: Registry is halted");
    }
    let cur_atts = (mut_reg_ref).attenuations;
    let new_atts = list_push(cur_atts, att_val);
    (mut_reg_ref).attenuations = new_atts;
    return Ok(true);
}

pub fn objcap_registry_lookup(
    reg_ref: &ObjectCapabilityRegistry,
    target_cap_id_val: String
) -> Result[ObjectCapability, String] {
    let caps = (reg_ref).capabilities;
    let n: Int = list_len(caps);
    let mut i: Int = 0;
    while i < n {
        let item = list_get(caps, i);
        let cid: String = item.cap_id;
        if cid == target_cap_id_val {
            return Ok(item);
        }
        i = i + 1;
    }
    return Err("OBJCAP_NOT_FOUND: Capability ID not found in registry");
}

pub fn objcap_registry_is_revoked(
    reg_ref: &ObjectCapabilityRegistry,
    target_cap_id_val: String
) -> Bool {
    let revs = (reg_ref).revocations;
    let n: Int = list_len(revs);
    let mut i: Int = 0;
    while i < n {
        let item = list_get(revs, i);
        let r_cid: String = item.cap_id;
        let is_rev: Bool = item.is_revoked;
        if r_cid == target_cap_id_val && is_rev {
            return true;
        }
        i = i + 1;
    }
    return false;
}
