// ===================================================================
// openOODA Standard Library — ooda::sec::sys::elf_types
// ELF structs
// (split from elf.oo, M172)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

// -------------------------------------------------------------------
// Core ELF Types & Data Structures
// -------------------------------------------------------------------

pub type ElfHeader = struct {
    magic_valid: Bool,
    ei_class: Int,
    ei_data: Int,
    ei_version: Int,
    ei_osabi: Int,
    e_type: Int,
    e_machine: Int,
    e_version: Int,
    e_entry: Int,
    e_phoff: Int,
    e_shoff: Int,
    e_flags: Int,
    e_ehsize: Int,
    e_phentsize: Int,
    e_phnum: Int,
    e_shentsize: Int,
    e_shnum: Int,
    e_shstrndx: Int,
};

pub type ProgramHeader = struct {
    p_type: Int,
    p_flags: Int,
    p_offset: Int,
    p_vaddr: Int,
    p_paddr: Int,
    p_filesz: Int,
    p_memsz: Int,
    p_align: Int,
    is_executable: Bool,
    is_writable: Bool,
    is_readable: Bool,
};

pub type SectionHeader = struct {
    sh_name: Int,
    sh_name_str: String,
    sh_type: Int,
    sh_flags: Int,
    sh_addr: Int,
    sh_offset: Int,
    sh_size: Int,
    sh_link: Int,
    sh_info: Int,
    sh_addralign: Int,
    sh_entsize: Int,
    is_alloc: Bool,
    is_exec: Bool,
    is_write: Bool,
};

pub type ElfSymbol = struct {
    st_name: Int,
    st_name_str: String,
    st_info: Int,
    st_other: Int,
    st_shndx: Int,
    st_value: Int,
    st_size: Int,
    is_global: Bool,
    is_function: Bool,
    is_object: Bool,
};

pub type ElfSecurityReport = struct {
    has_nx_stack: Bool,
    has_relro: Bool,
    has_bind_now: Bool,
    has_canary_symbol: Bool,
    is_pie: Bool,
    has_rpath: Bool,
    has_executable_stack: Bool,
    security_score: Int,
    violation_count: Int,
    is_compliant: Bool,
};

pub type ElfFile = struct {
    filename: String,
    header: ElfHeader,
    program_headers: List[ProgramHeader],
    section_headers: List[SectionHeader],
    symbols: List[ElfSymbol],
    is_parsed: Bool,
    security_report: ElfSecurityReport,
};

pub fn elf_types_marker() -> Int {
    return 127;
}
