// # UEFI Secure Boot & Verified Boot Facade
//
// Logline: Re-exports secure boot operating modes, image verification, keystore management, and policy engine.
//
// Setup: Pure module shim importing types, constants, operations, engine, and stubs submodules.
//
// Beats:
//   1. Import secure boot types, constants, operations, engine, and stubs companion modules.
//   2. Re-export public symbols with typed shim markers.

import "./secure_boot_types.oo";
import "./secure_boot_const.oo";
import "./secure_boot_ops.oo";
import "./secure_boot_engine.oo";
import "./secure_boot_stubs.oo";

pub fn shim_marker_sboot_cert_x509() -> Int {
    return sboot_cert_x509();
}

pub fn shim_marker_sboot_action_deny() -> Int {
    return sboot_action_deny();
}

pub fn shim_marker_sboot_mode_default() -> SecureBootMode {
    return sboot_mode_default();
}

pub fn shim_marker_sboot_signature_create() -> SecureBootSignature {
    return sboot_signature_create("sig1", 1, "owner", "fp1", "digest1");
}

pub fn shim_marker_sboot_key_create() -> SecureBootKey {
    return sboot_key_create("k1", "RSA", "bytes", "fp1");
}

pub fn shim_marker_sboot_policy_default() -> SecureBootPolicy {
    return sboot_policy_default();
}

pub fn shim_marker_sboot_is_violation() -> Bool {
    return sboot_is_violation(0);
}

pub fn shim_marker_sboot_engine_init() -> SecureBootEngine {
    return sboot_engine_init("eng1");
}

pub fn shim_marker_sboot_engine_do_work(engine: &SecureBootEngine) -> Int {
    return sboot_engine_do_work(engine);
}

pub type Large = struct {};

pub fn __dummy_std_src_ooda_sec_sys_secure_boot_oo() -> Int {
    return 0;
