// # Linux Kernel Audit (auditd) Facade
//
// Logline: Re-exports kernel audit types, permission masks, rule templates, filtering, and engine primitives.
//
// Setup: Pure module shim importing types, constants, operations, engine, and stubs submodules.
//
// Beats:
//   1. Import kernel audit types, constants, operations, engine, and stubs companion modules.
//   2. Re-export public symbols with typed shim markers.

import "./kernel_audit_types.oo";
import "./kernel_audit_const.oo";
import "./kernel_audit_ops.oo";
import "./kernel_audit_engine.oo";
import "./kernel_audit_stubs.oo";

pub fn shim_marker_audit_perm_exec() -> Int {
    return audit_perm_exec();
}

pub fn shim_marker_audit_list_watch() -> Int {
    return audit_list_watch();
}

pub fn shim_marker_audit_event_new() -> AuditEvent {
    return audit_event_new("ev1", 1000, 59, 100, 1000, 1000, true, "/bin/ls", "exec");
}

pub fn shim_marker_audit_rule_new() -> AuditRule {
    return audit_rule_new("r1", "/etc/passwd", 2, "pwd");
}

pub fn shim_marker_audit_status_default() -> AuditStatus {
    return audit_status_default();
}

pub fn shim_marker_audit_rule_watch_passwd() -> AuditRule {
    return audit_rule_watch_passwd();
}

pub fn shim_marker_audit_engine_init() -> AuditEngine {
    return audit_engine_init("eng1");
}

pub fn shim_marker_audit_engine_do_work(engine: &AuditEngine) -> Int {
    return audit_engine_do_work(engine);
}

pub type Large = struct {};

pub fn __dummy_std_src_ooda_sec_sys_kernel_audit_oo() -> Int {
    return 0;
}