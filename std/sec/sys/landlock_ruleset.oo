// ===================================================================
// openOODA Standard Library — ooda::sec::sys::landlock_ruleset
// Ruleset construction and validation (split from landlock.oo, M172)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./landlock_ops.oo";

pub fn landlock_ruleset_new(name: String, handled_fs: Int, handled_net: Int) -> LandlockRuleset {
    let empty_paths: List[PathBeneathAttr] = list_new();
    let empty_nets: List[NetPortAttr] = list_new();
    return LandlockRuleset {
        name: name,
        handled_access_fs: handled_fs,
        handled_access_net: handled_net,
        handled_scoped: 0,
        path_rules: empty_paths,
        net_rules: empty_nets,
        ruleset_fd: -1,
        is_created: false,
        is_enforced: false,
        flags: 0,
        stats_rules_added: 0,
        stats_evaluations: 0,
        stats_denials: 0,
    };
}

pub fn landlock_ruleset_with_scopes(
    name: String,
    handled_fs: Int,
    handled_net: Int,
    handled_scoped: Int
) -> LandlockRuleset {
    let empty_paths: List[PathBeneathAttr] = list_new();
    let empty_nets: List[NetPortAttr] = list_new();
    return LandlockRuleset {
        name: name,
        handled_access_fs: handled_fs,
        handled_access_net: handled_net,
        handled_scoped: handled_scoped,
        path_rules: empty_paths,
        net_rules: empty_nets,
        ruleset_fd: -1,
        is_created: false,
        is_enforced: false,
        flags: 0,
        stats_rules_added: 0,
        stats_evaluations: 0,
        stats_denials: 0,
    };
}

pub fn landlock_ruleset_add_path_rule(ruleset: LandlockRuleset, path_item: PathBeneathAttr) -> LandlockRuleset {
    let mut updated_paths: List[PathBeneathAttr] = list_new();
    let old_paths: List[PathBeneathAttr] = ruleset.path_rules;
    let n = list_len(old_paths);
    let mut i = 0;
    while i < n {
        let p_elem: PathBeneathAttr = list_get(old_paths, i);
        updated_paths = list_push(updated_paths, p_elem);
        i = i + 1;
    }
    updated_paths = list_push(updated_paths, path_item);

    return LandlockRuleset {
        name: ruleset.name,
        handled_access_fs: ruleset.handled_access_fs,
        handled_access_net: ruleset.handled_access_net,
        handled_scoped: ruleset.handled_scoped,
        path_rules: updated_paths,
        net_rules: ruleset.net_rules,
        ruleset_fd: ruleset.ruleset_fd,
        is_created: ruleset.is_created,
        is_enforced: ruleset.is_enforced,
        flags: ruleset.flags,
        stats_rules_added: ruleset.stats_rules_added + 1,
        stats_evaluations: ruleset.stats_evaluations,
        stats_denials: ruleset.stats_denials,
    };
}

pub fn landlock_ruleset_add_net_rule(ruleset: LandlockRuleset, net_item: NetPortAttr) -> LandlockRuleset {
    let mut updated_nets: List[NetPortAttr] = list_new();
    let old_nets: List[NetPortAttr] = ruleset.net_rules;
    let n = list_len(old_nets);
    let mut i = 0;
    while i < n {
        let n_elem: NetPortAttr = list_get(old_nets, i);
        updated_nets = list_push(updated_nets, n_elem);
        i = i + 1;
    }
    updated_nets = list_push(updated_nets, net_item);

    return LandlockRuleset {
        name: ruleset.name,
        handled_access_fs: ruleset.handled_access_fs,
        handled_access_net: ruleset.handled_access_net,
        handled_scoped: ruleset.handled_scoped,
        path_rules: ruleset.path_rules,
        net_rules: updated_nets,
        ruleset_fd: ruleset.ruleset_fd,
        is_created: ruleset.is_created,
        is_enforced: ruleset.is_enforced,
        flags: ruleset.flags,
        stats_rules_added: ruleset.stats_rules_added + 1,
        stats_evaluations: ruleset.stats_evaluations,
        stats_denials: ruleset.stats_denials,
    };
}

pub fn landlock_ruleset_validate(ruleset: &LandlockRuleset) -> Result[Bool, String] {
    if ruleset.name.len() == 0 {
        return Err("Landlock Validation Error: Ruleset name cannot be empty");
    }
    if ruleset.handled_access_fs == 0 && ruleset.handled_access_net == 0 && ruleset.handled_scoped == 0 {
        return Err("Landlock Validation Error: Ruleset must handle at least one access category (fs, net, or scoped)");
    }
    return Ok(true);
}
