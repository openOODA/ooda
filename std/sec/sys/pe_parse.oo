// # PE DOS, File & Optional Header Parsing
//
// Logline: Parse DOS header, validate MZ magic, locate PE header, and parse optional header fields.
//
// Setup: Imports pe_ops.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. pe_parse_dos_header: validate e_magic MZ and e_lfanew bounds.
//   2. pe_parse_pe_header: read machine, sections, characteristics.
//   3. pe_parse_optional_header: read magic and data directory count.
//   4. pe_parse_validate: gate against minimum file size and magic.
//
// residual: live PE load is process_exit in pe_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./pe_ops.oo";

pub fn pe_parse_dos_header(data: String) -> Result[DosHeader, String] {
    let data_len: Int = data.len();
    if data_len < 64 {
        return Err("PE Parse Error: File size smaller than minimum DOS header size (64 bytes)");
    }
    let magic: Int = read_u16_le(data, 0);
    if magic != pe_dos_magic() {
        return Err("PE Parse Error: Invalid DOS magic number (expected MZ / 0x5A4D)");
    }
    let lfanew: Int = read_u32_le(data, 60);
    if lfanew <= 0 {
        return Err("PE Parse Error: Invalid e_lfanew offset in DOS header");
    }
    if lfanew + 24 > data_len {
        return Err("PE Parse Error: e_lfanew points outside file boundaries");
    }

    let header: DosHeader = DosHeader {
        e_magic: magic,
        e_cblp: read_u16_le(data, 2),
        e_cp: read_u16_le(data, 4),
        e_crlc: read_u16_le(data, 6),
        e_cparhdr: read_u16_le(data, 8),
        e_minalloc: read_u16_le(data, 10),
        e_maxalloc: read_u16_le(data, 12),
        e_ss: read_u16_le(data, 14),
        e_sp: read_u16_le(data, 16),
        e_csum: read_u16_le(data, 18),
        e_ip: read_u16_le(data, 20),
        e_cs: read_u16_le(data, 22),
        e_lfarlc: read_u16_le(data, 24),
        e_ovno: read_u16_le(data, 26),
        e_lfanew: lfanew,
        is_valid: true,
    };
    return Ok(header);
}

pub fn pe_parse_file_header(data: String, pe_offset: Int) -> Result[PeHeader, String] {
    let data_len: Int = data.len();
    if pe_offset + 24 > data_len {
        return Err("PE Parse Error: Insufficient data for PE COFF file header");
    }
    let sig: Int = read_u16_le(data, pe_offset);
    if sig != pe_signature() {
        return Err("PE Parse Error: Invalid PE signature (expected PE\\0\\0)");
    }

    let file_header_offset: Int = pe_offset + 4;
    let machine: Int = read_u16_le(data, file_header_offset);
    let num_sections: Int = read_u16_le(data, file_header_offset + 2);
    let time_stamp: Int = read_u32_le(data, file_header_offset + 4);
    let sym_table: Int = read_u32_le(data, file_header_offset + 8);
    let num_syms: Int = read_u32_le(data, file_header_offset + 12);
    let size_opt: Int = read_u16_le(data, file_header_offset + 16);
    let charact: Int = read_u16_le(data, file_header_offset + 18);

    let header: PeHeader = PeHeader {
        machine: machine,
        number_of_sections: num_sections,
        time_date_stamp: time_stamp,
        pointer_to_symbol_table: sym_table,
        number_of_symbols: num_syms,
        size_of_optional_header: size_opt,
        characteristics: charact,
        is_valid: true,
    };
    return Ok(header);
}

pub fn pe_parse_optional_header(data: String, opt_offset: Int) -> Result[OptionalHeader, String] {
    let data_len: Int = data.len();
    if opt_offset + 28 > data_len {
        return Err("PE Parse Error: Insufficient data for Optional Header magic");
    }
    let magic: Int = read_u16_le(data, opt_offset);
    let is_64: Bool = magic == pe32_plus_magic();

    let maj_link: Int = byte_at(data, opt_offset + 2);
    let min_link: Int = byte_at(data, opt_offset + 3);
    let size_code: Int = read_u32_le(data, opt_offset + 4);
    let size_init: Int = read_u32_le(data, opt_offset + 8);
    let size_uninit: Int = read_u32_le(data, opt_offset + 12);
    let entry_pt: Int = read_u32_le(data, opt_offset + 16);
    let base_code: Int = read_u32_le(data, opt_offset + 20);

    let mut img_base: Int = 0;
    let mut sec_align: Int = 0;
    let mut file_align: Int = 0;
    let mut maj_os: Int = 0;
    let mut min_os: Int = 0;
    let mut maj_img: Int = 0;
    let mut min_img: Int = 0;
    let mut maj_sub: Int = 0;
    let mut min_sub: Int = 0;
    let mut win32_val: Int = 0;
    let mut size_img: Int = 0;
    let mut size_hdrs: Int = 0;
    let mut csum: Int = 0;
    let mut subsys: Int = 0;
    let mut dll_char: Int = 0;
    let mut stack_res: Int = 0;
    let mut stack_com: Int = 0;
    let mut heap_res: Int = 0;
    let mut heap_com: Int = 0;
    let mut load_flg: Int = 0;
    let mut num_rva: Int = 0;

    if is_64 {
        img_base = read_u32_le(data, opt_offset + 24);
        sec_align = read_u32_le(data, opt_offset + 32);
        file_align = read_u32_le(data, opt_offset + 36);
        maj_os = read_u16_le(data, opt_offset + 40);
        min_os = read_u16_le(data, opt_offset + 42);
        maj_img = read_u16_le(data, opt_offset + 44);
        min_img = read_u16_le(data, opt_offset + 46);
        maj_sub = read_u16_le(data, opt_offset + 48);
        min_sub = read_u16_le(data, opt_offset + 50);
        win32_val = read_u32_le(data, opt_offset + 52);
        size_img = read_u32_le(data, opt_offset + 56);
        size_hdrs = read_u32_le(data, opt_offset + 60);
        csum = read_u32_le(data, opt_offset + 64);
        subsys = read_u16_le(data, opt_offset + 68);
        dll_char = read_u16_le(data, opt_offset + 70);
        stack_res = read_u32_le(data, opt_offset + 72);
        stack_com = read_u32_le(data, opt_offset + 80);
        heap_res = read_u32_le(data, opt_offset + 88);
        heap_com = read_u32_le(data, opt_offset + 96);
        load_flg = read_u32_le(data, opt_offset + 104);
        num_rva = read_u32_le(data, opt_offset + 108);
    } else {
        img_base = read_u32_le(data, opt_offset + 28);
        sec_align = read_u32_le(data, opt_offset + 32);
        file_align = read_u32_le(data, opt_offset + 36);
        maj_os = read_u16_le(data, opt_offset + 40);
        min_os = read_u16_le(data, opt_offset + 42);
        maj_img = read_u16_le(data, opt_offset + 44);
        min_img = read_u16_le(data, opt_offset + 46);
        maj_sub = read_u16_le(data, opt_offset + 48);
        min_sub = read_u16_le(data, opt_offset + 50);
        win32_val = read_u32_le(data, opt_offset + 52);
        size_img = read_u32_le(data, opt_offset + 56);
        size_hdrs = read_u32_le(data, opt_offset + 60);
        csum = read_u32_le(data, opt_offset + 64);
        subsys = read_u16_le(data, opt_offset + 68);
        dll_char = read_u16_le(data, opt_offset + 70);
        stack_res = read_u32_le(data, opt_offset + 72);
        stack_com = read_u32_le(data, opt_offset + 76);
        heap_res = read_u32_le(data, opt_offset + 80);
        heap_com = read_u32_le(data, opt_offset + 84);
        load_flg = read_u32_le(data, opt_offset + 88);
        num_rva = read_u32_le(data, opt_offset + 92);
    }

    let header: OptionalHeader = OptionalHeader {
        magic: magic,
        major_linker_version: maj_link,
        minor_linker_version: min_link,
        size_of_code: size_code,
        size_of_initialized_data: size_init,
        size_of_uninitialized_data: size_uninit,
        address_of_entry_point: entry_pt,
        base_of_code: base_code,
        image_base: img_base,
        section_alignment: sec_align,
        file_alignment: file_align,
        major_os_version: maj_os,
        minor_os_version: min_os,
        major_image_version: maj_img,
        minor_image_version: min_img,
        major_subsystem_version: maj_sub,
        minor_subsystem_version: min_sub,
        win32_version_value: win32_val,
        size_of_image: size_img,
        size_of_headers: size_hdrs,
        checksum: csum,
        subsystem: subsys,
        dll_characteristics: dll_char,
        size_of_stack_reserve: stack_res,
        size_of_stack_commit: stack_com,
        size_of_heap_reserve: heap_res,
        size_of_heap_commit: heap_com,
        loader_flags: load_flg,
        number_of_rva_and_sizes: num_rva,
        is_64bit: is_64,
        is_valid: true,
    };
    return Ok(header);
}
