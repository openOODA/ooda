// # IMA/EVM Domain Types
//
// Logline: Define ImaMeasurement, ImaRule, ImaPolicy, and EvmSignature records.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. ImaMeasurement: bind pcr, template_name, digest_algo, measurement/file digests, is_verified.
//   2. ImaRule: bind action, func, mask, fowner, obj_user/role/type, appraise_type.
//   3. ImaPolicy: bind rules list, default_appraise, policy_version, is_locked.
//   4. EvmSignature: bind sig_id, key_id, sig_bytes, sig_algo.
//
// residual: struct-only module.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

pub type ImaMeasurement = struct {
    pcr: Int,
    template_name: String,
    digest_algo: String,
    measurement_digest: String,
    file_name: String,
    file_digest: String,
    is_verified: Bool,
};

pub type ImaRule = struct {
    action: Int,
    func: Int,
    mask: Int,
    fowner: Int,
    obj_user: String,
    obj_role: String,
    obj_type: String,
    digest_algo: String,
    appraise_type: String,
    is_enabled: Bool,
};

pub type ImaPolicy = struct {
    name: String,
    rules: List[ImaRule],
    default_appraise: Bool,
    default_measure: Bool,
    policy_version: Int,
    is_active: Bool,
    is_locked: Bool,
};

pub type EvmSignature = struct {
    algo: Int,
    key_id: String,
    sig_data: String,
    hash_algo: String,
    sig_len: Int,
    is_valid: Bool,
};

pub type ImaAppraisalResult = struct {
    status: Int,
    target_path: String,
    expected_digest: String,
    actual_digest: String,
    matched_rule_index: Int,
    reason: String,
};

pub type ImaContext = struct {
    context_name: String,
    policy: ImaPolicy,
    measurements: List[ImaMeasurement],
    signatures: List[EvmSignature],
    total_measurements: Int,
    total_appraisals: Int,
    total_violations: Int,
    pcr_aggregate: String,
    is_initialized: Bool,
};

pub type Measurement = struct {};
pub type PCR = struct {};
pub type File = struct {};
pub type Policy = struct {};

/// Module load marker — oodac requires ≥1 fn in types-only units.
pub fn ima_types_module_loaded() -> Int {
    return 1;
}

pub type Fail = struct {};
pub type Default = struct {};


pub fn __dummy_std_src_ooda_sec_sys_ima_types_oo() -> Int {
    return 0;
}
