// ===================================================================
// openOODA Standard Library — ooda::sec::sys::elf_inspect
// ELF inspection & modification
// (split from elf.oo, M172)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./elf_engine.oo";

// -------------------------------------------------------------------
// ELF Inspection & Modification Functions
// -------------------------------------------------------------------

pub fn elf_file_add_program_header(file: ElfFile, ph: ProgramHeader) -> ElfFile {
    let mut updated_ph: List[ProgramHeader] = list_new();
    let old_ph = file.program_headers;
    let n = list_len(old_ph);
    let mut i = 0;
    while i < n {
        let p = list_get(old_ph, i);
        updated_ph = list_push(updated_ph, p);
        i = i + 1;
    }
    updated_ph = list_push(updated_ph, ph);

    let old_hdr = (file).header;
    let updated_hdr = ElfHeader {
        magic_valid: old_hdr.magic_valid,
        ei_class: old_hdr.ei_class,
        ei_data: old_hdr.ei_data,
        ei_version: old_hdr.ei_version,
        ei_osabi: old_hdr.ei_osabi,
        e_type: old_hdr.e_type,
        e_machine: old_hdr.e_machine,
        e_version: old_hdr.e_version,
        e_entry: old_hdr.e_entry,
        e_phoff: old_hdr.e_phoff,
        e_shoff: old_hdr.e_shoff,
        e_flags: old_hdr.e_flags,
        e_ehsize: old_hdr.e_ehsize,
        e_phentsize: old_hdr.e_phentsize,
        e_phnum: list_len(updated_ph),
        e_shentsize: old_hdr.e_shentsize,
        e_shnum: old_hdr.e_shnum,
        e_shstrndx: old_hdr.e_shstrndx,
    };

    return ElfFile {
        filename: file.filename,
        header: updated_hdr,
        program_headers: updated_ph,
        section_headers: file.section_headers,
        symbols: file.symbols,
        is_parsed: file.is_parsed,
        security_report: file.security_report,
    };
}

