pub fn elf_file_add_symbol(file: ElfFile, sym: ElfSymbol) -> ElfFile {
    let mut updated_sym: List[ElfSymbol] = list_new();
    let old_sym = file.symbols;
    let n = list_len(old_sym);
    let mut i = 0;
    while i < n {
        let s = list_get(old_sym, i);
        updated_sym = list_push(updated_sym, s);
        i = i + 1;
    }
    updated_sym = list_push(updated_sym, sym);

    return ElfFile {
        filename: file.filename,
        header: file.header,
        program_headers: file.program_headers,
        section_headers: file.section_headers,
        symbols: updated_sym,
        is_parsed: file.is_parsed,
        security_report: file.security_report,
    };
}

pub fn elf_header_validate(hdr: &ElfHeader) -> Result[Bool, String] {
    if (hdr).magic_valid == false {
        return Err("ELF Header Error: Invalid magic number sequence");
    }
    let cls: Int = (hdr).ei_class;
    if cls != 1 {
        if cls != 2 {
            return Err("ELF Header Error: Invalid ELF architecture class");
        }
    }
    let dat: Int = (hdr).ei_data;
    if dat != 1 {
        if dat != 2 {
            return Err("ELF Header Error: Invalid ELF data encoding");
        }
    }
    return Ok(true);
}

pub fn elf_find_section_by_name(file: &ElfFile, name: String) -> Option[SectionHeader] {
    let sections = (file).section_headers;
    let n = list_len(sections);
    let mut i = 0;
    while i < n {
        let sh = list_get(sections, i);
        if sh.sh_name_str == name {
            return Some(sh);
        }
        i = i + 1;
    }
    return None;
}

pub fn elf_find_symbol_by_name(file: &ElfFile, name: String) -> Option[ElfSymbol] {
    let syms = (file).symbols;
    let n = list_len(syms);
    let mut i = 0;
    while i < n {
        let sym = list_get(syms, i);
        if sym.st_name_str == name {
            return Some(sym);
        }
        i = i + 1;
    }
    return None;
}

pub fn elf_get_loadable_segments(file: &ElfFile) -> List[ProgramHeader] {
    let mut res: List[ProgramHeader] = list_new();
    let phs = (file).program_headers;
    let n = list_len(phs);
    let target_type = pt_load();
    let mut i = 0;
    while i < n {
        let p = list_get(phs, i);
        if p.p_type == target_type {
            res = list_push(res, p);
        }
        i = i + 1;
    }
    return res;
}

pub fn elf_get_executable_sections(file: &ElfFile) -> List[SectionHeader] {
    let mut res: List[SectionHeader] = list_new();
    let shs = (file).section_headers;
    let n = list_len(shs);
    let mut i = 0;
    while i < n {
        let s = list_get(shs, i);
        if s.is_exec == true {
            res = list_push(res, s);
        }
        i = i + 1;
    }
    return res;
}
