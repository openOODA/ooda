// # Linux Audit Domain Types
//
// Logline: Define AuditRule, AuditEvent, and AuditdClient records; bind path, syscall_nr, arch, and is_enabled.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. AuditRule: bind path, syscall_nr, action, filter_list, key, permissions, arch.
//   2. AuditEvent: bind event_id, timestamp_sec, type_id, pid, uid, exe, syscall_nr, success.
//   3. AuditdClient: bind name, socket_fd, seq_num, pid.
//   4. audit_event_kind_to_int: map event kind tag to int.
//
// residual: struct-only module.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

pub type AuditRule = struct {
    path: String,
    syscall_nr: Int,
    action: Int,
    filter_list: Int,
    key: String,
    permissions: String,
    arch: Int,
    is_enabled: Bool,
};

pub type AuditEvent = struct {
    event_id: Int,
    timestamp_sec: Int,
    type_id: Int,
    pid: Int,
    uid: Int,
    gid: Int,
    auid: Int,
    exe: String,
    comm: String,
    syscall_nr: Int,
    success: Bool,
    exit_code: Int,
    key: String,
    raw_message: String,
};

pub type AuditdClient = struct {
    name: String,
    socket_fd: Int,
    seq_num: Int,
    pid: Int,
    is_connected: Bool,
    is_enabled: Bool,
    rate_limit: Int,
    backlog_limit: Int,
    rules: List[AuditRule],
    stats_events_received: Int,
    stats_rules_loaded: Int,
    stats_failures: Int,
};

pub type AuditStatus = struct {
    enabled: Int,
    failure: Int,
    pid: Int,
    rate_limit: Int,
    backlog_limit: Int,
    lost: Int,
    backlog: Int,
};

pub type AuditEvaluationResult = struct {
    matched: Bool,
    matched_rule_index: Int,
    rule_key: String,
    action: Int,
    reason: String,
};

/// Module load marker — oodac requires ≥1 fn in types-only units.
pub fn audit_types_module_loaded() -> Int {
    return 1;
}

pub type Rule = struct {};
pub type Client = struct {};
pub type PID = struct {};
pub type Backlog = struct {};
pub type Timestamp = struct {};
pub type Fail = struct {};
pub type Default = struct {};


pub fn __dummy_std_src_ooda_sec_sys_audit_types_oo() -> Int {
    return 0;
}
