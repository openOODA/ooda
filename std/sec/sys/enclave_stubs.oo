// # Enclave Hardware & Kernel Stubs
//
// Logline: Provides fail-closed residual stubs for low-level SGX ENCLS instructions, KVM ioctls, and remote attestation.
//
// Setup: Requires SysCap token; terminates fail-closed due to compiler native CPU instruction and ioctl boundary limitations.
//
// Beats:
//   1. Provide stubs for Intel SGX ENCLS[ECREATE], ENCLS[EINIT], and quote serialization.
//   2. Provide stubs for AMD SEV-SNP and Intel TDX KVM guest initialization.
//   3. Provide stub for network-based remote attestation collateral retrieval.

import "./enclave_types.oo";

pub type SysCap = struct {};

pub fn enclave_sgx_ecreate(sys: &SysCap, size_bytes: Int) -> Result[Int, String] {
    // COMPILER LIMITATION: openOODA lacks ENCLS[ECREATE] leaf instruction intrinsic for SGX ECREATE.
    process_exit(1);
    return Err("Unimplemented: SGX ECREATE requires ENCLS leaf FFI lowering");
}

