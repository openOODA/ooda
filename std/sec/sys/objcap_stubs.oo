    // COMPILER LIMITATION: Dynamic proxy membrane reflection traps and dynamic function pointer redirection
    // are not supported by the openOODA static typechecker IR.
    // Keeping fail-closed stub.
    process_exit(1);
    return Err("Proxy membrane interceptor traps require runtime VM reflection");
}

pub fn objcap_remote_rpc_marshal_capability(cap_ref: &ObjectCapability) -> Result[String, String] {
    // COMPILER LIMITATION: Zero-copy RPC object capability descriptor network serialization over TLS channels
    // is unsupported in oodac compiler check stage.
    // Keeping fail-closed stub.
    process_exit(1);
    return Err("RPC capability network serialization unsupported");
}
