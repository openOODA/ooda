type EnclaveType = struct {
    vendor: Int,
    is_sgx: Int
};

pub fn enclave_type_new(vendor: Int, is_sgx: Int) -> EnclaveType {
    return EnclaveType {
        vendor: vendor,
        is_sgx: is_sgx
    };
}

pub fn enclave_type_vendor(e: EnclaveType) -> Int {
    return e.vendor;
}
