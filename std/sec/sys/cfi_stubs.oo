    // COMPILER LIMITATION: openOODA lacks native C-FFI lowering for x86_64 ARCH_SET_CPUID / prctl(PR_SET_TAGGED_ADDR_CTRL) or Intel CET MSR register setup.
    // Hardware Indirect Branch Tracking (IBT) and Shadow Stack (SS) must be enabled by kernel/host runtime.
    process_exit(1);
    return Err("Unimplemented: kernel hardware CET setup requires native host FFI lowering");
}

