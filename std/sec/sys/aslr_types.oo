// # ASLR Types
//
// Logline: AslrConfig destubbed off List[AslrRegion]. Layout uses two fixed regions.
//
// Setup: Pure Int entropy config plus two-slot layout.
//
// Beats:
//   1. aslr_config_new entropy_bits.
// residual: List[AslrRegion] destubbed.

type AslrConfig = struct {
    entropy_bits: Int,
    enabled: Int,
    rand_mask: Int
};

pub fn aslr_config_new(entropy_bits: Int) -> AslrConfig {
    return AslrConfig {
        entropy_bits: entropy_bits,
        enabled: 1,
        rand_mask: 7
    };
}

pub fn aslr_config_entropy(c: AslrConfig) -> Int {
    return c.entropy_bits;
}

type AslrRegion = struct {
    base_addr: Int,
    size_bytes: Int,
    entropy_bits: Int,
    is_exec: Int,
    is_write: Int
};

pub fn aslr_region_new(base_addr: Int, size_bytes: Int, is_exec: Int, is_write: Int) -> AslrRegion {
    return AslrRegion {
        base_addr: base_addr,
        size_bytes: size_bytes,
        entropy_bits: 0,
        is_exec: is_exec,
        is_write: is_write
    };
}

type AslrLayout = struct {
    r0_base: Int,
    r0_size: Int,
    r1_base: Int,
    r1_size: Int,
    n_regions: Int,
    layout_entropy: Int,
    is_sealed: Int,
    last_ok: Int
};

pub fn aslr_layout_empty() -> AslrLayout {
    return AslrLayout {
        r0_base: 0,
        r0_size: 0,
        r1_base: 0,
        r1_size: 0,
        n_regions: 0,
        layout_entropy: 0,
        is_sealed: 0,
        last_ok: 1
    };
}
