// # ROP Binary Scanner and Engine
//
// Logline: Manages gadget discovery state, registers inspected gadgets, and checks verification outcomes.
//
// Setup: Imports rop_types.oo and rop_ops.oo for stateful gadget scanning.
//
// Beats:
//   1. Construct GadgetScanner instances with custom bad-byte filtering.
//   2. Register discovered gadgets and validate bad-byte constraints.
//   3. Manage scanner active state, work accounting, and verification result constructors.

import "./rop_types.oo";
import "./rop_ops.oo";

pub fn gadget_scanner_new(
    scanner_id_val: String,
    binary_name_val: String,
    max_gadget_len_val: Int
) -> GadgetScanner {
    let empty_gadgets: List[RopGadget] = list_new();
    let empty_bad: List[Int] = list_new();
    return GadgetScanner {
        scanner_id: scanner_id_val,
        binary_name: binary_name_val,
        max_gadget_len: max_gadget_len_val,
        found_gadgets: empty_gadgets,
        total_scanned_bytes: 0,
        allow_bad_bytes: false,
        bad_bytes: empty_bad,
        is_active: true,
    };
}

pub fn gadget_scanner_add_bad_byte(scanner_val: GadgetScanner, bad_byte_val: Int) -> GadgetScanner {
    let old_bad: List[Int] = scanner_val.bad_bytes;
    let n: Int = list_len(old_bad);
    let mut updated_bad: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(old_bad, i);
        updated_bad = list_push(updated_bad, b);
        i = i + 1;
    }
    updated_bad = list_push(updated_bad, bad_byte_val);

    return GadgetScanner {
        scanner_id: scanner_val.scanner_id,
        binary_name: scanner_val.binary_name,
        max_gadget_len: scanner_val.max_gadget_len,
        found_gadgets: scanner_val.found_gadgets,
        total_scanned_bytes: scanner_val.total_scanned_bytes,
        allow_bad_bytes: scanner_val.allow_bad_bytes,
        bad_bytes: updated_bad,
        is_active: scanner_val.is_active,
    };
}

pub fn gadget_scanner_contains_bad_byte(scanner_ref: &GadgetScanner, byte_val: Int) -> Bool {
    let bads: List[Int] = (scanner_ref).bad_bytes;
    let n: Int = list_len(bads);
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(bads, i);
        if b == byte_val {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn gadget_scanner_register_gadget(
    scanner_ref: &mut GadgetScanner,
    gadget_val: RopGadget
) -> Result[Bool, String] {
    let is_act: Bool = (scanner_ref).is_active;
    if is_act == false {
        return Err("GADGET_SCANNER_ERR: Scanner is not active");
    }
    let allow_bad: Bool = (scanner_ref).allow_bad_bytes;
    if allow_bad == false {
        let bad_list: List[Int] = (scanner_ref).bad_bytes;
        if rop_gadget_contains_bad_byte(&gadget_val, bad_list) {
            return Err("GADGET_SCANNER_ERR: Gadget contains forbidden bad bytes");
        }
    }
    let cur_gadgets: List[RopGadget] = (scanner_ref).found_gadgets;
    let updated_gadgets: List[RopGadget] = list_push(cur_gadgets, gadget_val);
    (scanner_ref).found_gadgets = updated_gadgets;
    return Ok(true);
}

pub fn gadget_scanner_set_active(scanner_ref: &mut GadgetScanner, active_val: Bool) {
    (scanner_ref).is_active = active_val;
}

pub fn gadget_scanner_do_work(scanner_ref: &GadgetScanner) -> Int {
    let gadgets: List[RopGadget] = (scanner_ref).found_gadgets;
    let n_gadgets: Int = list_len(gadgets);
    let bytes_scanned: Int = (scanner_ref).total_scanned_bytes;
    let max_len: Int = (scanner_ref).max_gadget_len;
    return n_gadgets * 10 + bytes_scanned + max_len;
}

pub fn gadget_verification_result_create(
    result_id_val: String,
    chain_id_val: String,
    gadget_count_val: Int,
    total_stack_delta_val: Int,
    has_stack_pivot_val: Bool,
    has_forbidden_gadget_val: Bool,
    is_safe_val: Bool,
    timestamp_val: Int,
    summary_val: String
) -> GadgetVerificationResult {
    return GadgetVerificationResult {
        result_id: result_id_val,
        chain_id: chain_id_val,
        gadget_count: gadget_count_val,
        total_stack_delta: total_stack_delta_val,
        has_stack_pivot: has_stack_pivot_val,
        has_forbidden_gadget: has_forbidden_gadget_val,
        is_safe: is_safe_val,
        timestamp: timestamp_val,
        summary: summary_val,
    };
}

pub fn gadget_verification_result_is_ok(res_ref: &GadgetVerificationResult) -> Bool {
    return (res_ref).is_safe;
}

pub fn __dummy_std_src_ooda_sec_sys_rop_engine_oo() -> Int {
    return 0;
}
