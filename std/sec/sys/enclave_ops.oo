// # Enclave Operations & Verification
//
// Logline: Implements constructors for TEE architectures, measurements, quotes, and pure verification algorithms.
//
// Setup: Imports enclave_types.oo and enclave_const.oo for enclave quote and policy evaluation.
//
// Beats:
//   1. Construct specific TEE configurations (Intel SGX, AMD SEV, AMD SEV-SNP, Intel TDX, ARM TrustZone).
//   2. Create measurements, default policies, and structured enclave quotes.
//   3. Verify quotes against policy SVN thresholds, debug flags, and attribute masks.

import "./enclave_types.oo";
import "./enclave_const.oo";

pub fn enclave_type_intel_sgx() -> EnclaveType {
    return EnclaveType {
        type_id: "ENCLAVE_TYPE_INTEL_SGX",
        vendor: 1,
        is_sgx: true,
        is_sev: false,
        is_sev_es: false,
        is_sev_snp: false,
        is_tdx: false,
        is_trustzone: false,
    };
}

