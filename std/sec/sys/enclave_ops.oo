pub fn enclave_measurement_create(
    mr_enclave_val: String,
    mr_signer_val: String,
    isv_prod_id_val: Int,
    isv_svn_val: Int
) -> EnclaveMeasurement {
    return EnclaveMeasurement {
        meas_id: "meas",
        mr_enclave: mr_enclave_val,
        mr_signer: mr_signer_val,
        isv_prod_id: isv_prod_id_val,
        isv_svn: isv_svn_val,
        report_data: "",
    };
}

pub fn enclave_policy_default() -> EnclavePolicy {
    return EnclavePolicy {
        policy_id: "ENCLAVE_POLICY_DEFAULT",
        require_debug_disabled: true,
        min_isv_svn: 0,
        allowed_attributes_mask: 2,
        fail_closed: true,
        is_valid: true,
    };
}

pub fn enclave_policy_validate(p: &EnclavePolicy) -> Result[Bool, String] {
    if (p).require_debug_disabled == true {
        let debug_bit: Int = 1;
        let am: Int = (p).allowed_attributes_mask;
        let blocked: Int = am & debug_bit;
        if blocked != 0 {
            return Err("EnclaveError: Debug bit set in allowed mask while require_debug_disabled=true");
        }
    }
    if (p).min_isv_svn < 0 {
        return Err("EnclaveError: min_isv_svn cannot be negative");
    }
    return Ok(true);
}

pub fn enclave_attr_has(attr_mask: Int, attr_bit: Int) -> Bool {
    let anded: Int = attr_mask & attr_bit;
    return anded != 0;
}

pub fn enclave_quote_create(
    quote_id_val: String,
    r: EnclaveReport,
    sig_val: String
) -> EnclaveQuote {
    return EnclaveQuote {
        quote_id: quote_id_val,
        report: r,
        signature: sig_val,
        collateral: "",
        is_valid: true,
    };
}

pub fn enclave_verify_quote(engine: &EnclaveEngine, q: &EnclaveQuote) -> Int {
    let q_v: EnclaveQuote = q;
    let eng_v: EnclaveEngine = engine;
    if q_v.is_valid == false {
        return 1;
    }
    let rep: EnclaveReport = q_v.report;
    let meas: EnclaveMeasurement = rep.measurement;
    let svn: Int = meas.isv_svn;
    let pol: EnclavePolicy = eng_v.policy;
    let min_svn: Int = pol.min_isv_svn;
    if svn < min_svn {
        return 2;
    }
    if pol.require_debug_disabled {
        let has_debug = enclave_attr_has(rep.attributes, enclave_attr_debug());
        if has_debug {
            return 3;
        }
    }
    let allowed: Int = pol.allowed_attributes_mask;
    let r_attrs: Int = rep.attributes;
    let masked: Int = r_attrs & allowed;
    if masked != r_attrs {
        return 4;
    }
    return 0;
}

pub fn enclave_quote_is_ok(code: Int) -> Bool {
    if code == 0 {
        return true;
    }
    return false;
}

