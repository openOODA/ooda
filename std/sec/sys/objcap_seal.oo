// ===================================================================
// openOODA Standard Library — ooda::sec::sys::objcap_seal
// Revocation and sealer/unsealer pattern
// (split from objcap.oo, M172)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./objcap_attenuate.oo";

pub fn objcap_revocation_create(
    rev_id_val: String,
    cap_id_val: String,
    issuer_id_val: String,
    cascade_val: Bool
) -> CapabilityRevocation {
    return CapabilityRevocation {
        revocation_id: rev_id_val,
        cap_id: cap_id_val,
        issuer_id: issuer_id_val,
        is_revoked: false,
        revoked_at: 0,
        reason: "",
        cascade_to_children: cascade_val,
    };
}

pub fn objcap_revocation_trigger(
    mut_rev_ref: &mut CapabilityRevocation,
    reason_val: String,
    current_time: Int
) {
    (mut_rev_ref).is_revoked = true;
    (mut_rev_ref).revoked_at = current_time;
    (mut_rev_ref).reason = reason_val;
}

pub fn objcap_revocation_is_active(rev_ref: &CapabilityRevocation) -> Bool {
    return (rev_ref).is_revoked;
}

// -------------------------------------------------------------------
// Capability Sealing & Unsealing (Sealer / Unsealer Pattern)
// -------------------------------------------------------------------

pub fn objcap_seal_checksum(str_payload: String) -> Int {
    let len: Int = str_payload.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < len {
        let ch: Int = byte_at(str_payload, i);
        hash = hash * 33 + ch;
        i = i + 1;
    }
    return hash;
}

pub fn objcap_seal_create(
    seal_id_val: String,
    cap_ref: &ObjectCapability,
    sealer_id_val: String
) -> CapabilitySeal {
    let cid: String = (cap_ref).cap_id;
    let ruri: String = (cap_ref).resource_uri;
    let payload: String = cid + ruri + sealer_id_val;
    let chk: Int = objcap_seal_checksum(payload);
    return CapabilitySeal {
        seal_id: seal_id_val,
        cap_id: cid,
        sealer_id: sealer_id_val,
        checksum: chk,
        is_locked: true,
    };
}

pub fn objcap_seal_unseal(
    seal_ref: &CapabilitySeal,
    expected_sealer_id_val: String,
    cap_target_ref: &ObjectCapability
) -> Result[Bool, String] {
    if (seal_ref).is_locked == false {
        return Err("OBJCAP_UNSEAL_ERR: Seal is not locked");
    }
    let s_sealer: String = (seal_ref).sealer_id;
    if s_sealer != expected_sealer_id_val {
        return Err("OBJCAP_UNSEAL_ERR: Sealer authority mismatch");
    }
    let s_cid: String = (seal_ref).cap_id;
    let target_cid: String = (cap_target_ref).cap_id;
    if s_cid != target_cid {
        return Err("OBJCAP_UNSEAL_ERR: Target capability ID mismatch");
    }
    let target_ruri: String = (cap_target_ref).resource_uri;
    let payload: String = target_cid + target_ruri + expected_sealer_id_val;
    let expected_chk: Int = objcap_seal_checksum(payload);
    let s_chk: Int = (seal_ref).checksum;
    if s_chk != expected_chk {
        return Err("OBJCAP_UNSEAL_ERR: Integrity checksum mismatch");
    }
    return Ok(true);
}
