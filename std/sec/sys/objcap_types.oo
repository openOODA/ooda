// # Object Capability Types & Structures
//
// Logline: Define CapabilityRights, ObjectCapability, CapabilityRevocation, and CapabilityAttenuation records.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. CapabilityRights: bind allow_read/write/execute/delegate/revoke.
//   2. ObjectCapability: bind cap_id, resource_uri, owner_id, rights, parent_cap_id, is_sealed, is_valid.
//   3. CapabilityRevocation: bind revocation_id, cap_id, issuer_id, is_revoked, cascade_to_children.
//   4. CapabilityAttenuation: bind attenuation_id, source_cap_id, allowed_rights_mask, max_use_count, is_active.
//
// residual: struct-only module.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

type CapabilityRights = struct {
    allow_read: Bool,
    allow_write: Bool,
    allow_execute: Bool,
    allow_delegate: Bool,
    allow_revoke: Bool
};

type ObjectCapability = struct {
    cap_id: String,
    resource_uri: String,
    owner_id: String,
    rights: Int,
    rights_mask: String,
    parent_cap_id: String,
    attenuation_id: String,
    revocation_id: String,
    issued_at: Int,
    expires_at: Int,
    is_sealed: Bool,
    is_valid: Bool
};

type CapabilityRevocation = struct {
    revocation_id: String,
    cap_id: String,
    issuer_id: String,
    is_revoked: Bool,
    revoked_at: Int,
    reason: String,
    cascade_to_children: Bool
};

type CapabilityAttenuation = struct {
    attenuation_id: String,
    source_cap_id: String,
    allowed_rights_mask: Int,
    path_prefix_restriction: String,
    max_use_count: Int,
    uses_consumed: Int,
    valid_after: Int,
    valid_until: Int,
    is_active: Bool
};

type CapabilitySeal = struct {
    seal_id: String,
    cap_id: String,
    sealer_id: String,
    checksum: Int,
    is_locked: Bool
};

type SealedCapability = struct {
    seal_id: String,
    cap_id: String,
    sealer_id: String,
    payload: String,
    is_valid: Bool
};

type CapabilityAuditRecord = struct {
    record_id: String,
    cap_id: String,
    action: String,
    principal_id: String,
    timestamp: Int,
    outcome: String
};

type ObjectCapabilityRegistry = struct {
    registry_id: String,
    capabilities: List[String],
    revocations: List[String],
    attenuations: List[String],
    audits: List[String],
    total_exercised: Int,
    total_revoked: Int,
    strict_mode: Bool,
    is_halted: Bool
};

// Anchor constructors so oodac check monomorphizes type layouts (types-only units OOB).
pub fn capability_rights_none() -> CapabilityRights {
    return CapabilityRights {
        allow_read: false,
        allow_write: false,
        allow_execute: false,
        allow_delegate: false,
        allow_revoke: false
    };
}

pub fn objcap_empty() -> ObjectCapability {
    return ObjectCapability {
        cap_id: "",
        resource_uri: "",
        owner_id: "",
        rights: 0,
        rights_mask: "-----",
        parent_cap_id: "",
        attenuation_id: "",
        revocation_id: "",
        issued_at: 0,
        expires_at: 0,
        is_sealed: false,
        is_valid: false
    };
}
