// # Kernel audit types
//
// Logline: AuditRule destubbed off List[Int] fields to perm_mask.
// residual: List[struct] destubbed.

type AuditRule = struct {
    perm_mask: Int,
    action: Int
};

pub fn audit_rule_new(perm_mask: Int, action: Int) -> AuditRule {
    return AuditRule {
        perm_mask: perm_mask,
        action: action
    };
}

pub fn audit_rule_perm(r: AuditRule) -> Int {
    return r.perm_mask;
}
