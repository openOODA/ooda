// # ROP Constants and Target Architecture IDs
//
// Logline: Provides enumeration constants for ROP gadget classifications and processor architecture identifiers.
//
// Setup: Pure constant helper functions mirroring ELF machine headers and gadget classification schemes.
//
// Beats:
//   1. Define gadget type classifications (pop reg, mov reg, arithmetic, syscall, stack pivot, jmp/call).
//   2. Define target CPU architecture constants (x86_64, AArch64, RISC-V 64).

pub fn gadget_type_unknown() -> Int {
    return 0;
}

pub fn gadget_type_pop_reg() -> Int {
    return 1;
}

pub fn gadget_type_mov_reg() -> Int {
    return 2;
}

pub fn gadget_type_arithmetic() -> Int {
    return 3;
}

pub fn gadget_type_syscall() -> Int {
    return 4;
}

pub fn gadget_type_stack_pivot() -> Int {
    return 5;
}

pub fn gadget_type_jmp_call() -> Int {
    return 6;
}

pub fn rop_arch_x86_64() -> Int {
    return 62;
}

pub fn rop_arch_aarch64() -> Int {
    return 183;
}

pub fn rop_arch_riscv64() -> Int {
    return 243;
}

pub fn __dummy_std_src_ooda_sec_sys_rop_const_oo() -> Int {
    return 0;
}
