// # Redteam types
//
// Logline: Vulnerability destubbed off List[AttackVector].
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: List[struct] destubbed.

type Vulnerability = struct {
    vuln_id: Int,
    severity: Int
};

pub fn vulnerability_new(vuln_id: Int, severity: Int) -> Vulnerability {
    return Vulnerability {
        vuln_id: vuln_id,
        severity: severity
    };
}

pub fn vulnerability_severity(v: Vulnerability) -> Int {
    return v.severity;
}
