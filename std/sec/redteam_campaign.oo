// # Redteam Campaign and Campaign Management
//
// Logline: Manages red team security evaluation campaigns and attack scenarios.
//
// Setup: Imports redteam_types.oo for campaign structures.
//
// Beats:
//   1. Create and initialize security testing campaigns.
//   2. Register attack vectors and evaluation targets.
//   3. Aggregate findings and compute vulnerability metrics.

import "./redteam_types.oo";

// -------------------------------------------------------------------
// Red Team Campaign Operations
// -------------------------------------------------------------------

pub fn redteam_campaign_create(
    campaign_id_cc: Int,
    name_cc: String,
    target_system_cc: String,
    strict_fail_closed_cc: Bool
) -> RedTeamCampaign {
    let vecs_cc: List[AttackVector] = list_new();
    let vulns_cc: List[Vulnerability] = list_new();
    return RedTeamCampaign {
        campaign_id: campaign_id_cc,
        name: name_cc,
        target_system: target_system_cc,
        vectors: vecs_cc,
        vulnerabilities: vulns_cc,
        total_tests_run: 0,
        blocked_attacks: 0,
        successful_exploits: 0,
        strict_fail_closed: strict_fail_closed_cc,
        is_active: true,
    };
}

pub fn redteam_campaign_add_vector(camp_av: &mut RedTeamCampaign, vec_av: AttackVector) {
    let mut new_vecs_av: List[AttackVector] = list_new();
    let old_vecs_av = camp_av.vectors;
    let n_av = list_len(old_vecs_av);
    let mut i_av = 0;
    let mut rep_av = false;
    let v_param_av: AttackVector = vec_av;
    let target_id_av: Int = v_param_av.id;

    while i_av < n_av {
        let v_item_av = list_get(old_vecs_av, i_av);
        let vid_av: Int = v_item_av.id;
        let is_match_av: Bool = vid_av == target_id_av;
        if is_match_av == true {
            new_vecs_av = list_push(new_vecs_av, vec_av);
            rep_av = true;
        } else {
            new_vecs_av = list_push(new_vecs_av, v_item_av);
        }
        i_av = i_av + 1;
    }

    if rep_av == false {
        new_vecs_av = list_push(new_vecs_av, vec_av);
    }

    camp_av.vectors = new_vecs_av;
}

pub fn redteam_campaign_add_vulnerability(camp_avu: &mut RedTeamCampaign, vuln_avu: Vulnerability) {
    let mut new_vulns_avu: List[Vulnerability] = list_new();
    let old_vulns_avu = camp_avu.vulnerabilities;
    let n_avu = list_len(old_vulns_avu);
    let mut i_avu = 0;
    let mut rep_avu = false;
    let v_param_avu: Vulnerability = vuln_avu;
    let target_vid_avu: Int = v_param_avu.vuln_id;

    while i_avu < n_avu {
        let v_item_avu = list_get(old_vulns_avu, i_avu);
        let vid_avu: Int = v_item_avu.vuln_id;
        let is_match_avu: Bool = vid_avu == target_vid_avu;
        if is_match_avu == true {
            new_vulns_avu = list_push(new_vulns_avu, vuln_avu);
            rep_avu = true;
        } else {
            new_vulns_avu = list_push(new_vulns_avu, v_item_avu);
        }
        i_avu = i_avu + 1;
    }

    if rep_avu == false {
        new_vulns_avu = list_push(new_vulns_avu, vuln_avu);
    }

    camp_avu.vulnerabilities = new_vulns_avu;
}

pub fn redteam_campaign_mark_mitigated(camp_mm: &mut RedTeamCampaign, vuln_id_mm: Int) -> Bool {
    let mut new_vulns_mm: List[Vulnerability] = list_new();
    let old_vulns_mm = camp_mm.vulnerabilities;
    let n_mm = list_len(old_vulns_mm);
    let mut i_mm = 0;
    let mut found_mm = false;

    while i_mm < n_mm {
        let v_item_mm = list_get(old_vulns_mm, i_mm);
        let vid_mm: Int = v_item_mm.vuln_id;
        let is_match_mm: Bool = vid_mm == vuln_id_mm;
        if is_match_mm == true {
            found_mm = true;
            let updated_v_mm = Vulnerability {
                vuln_id: v_item_mm.vuln_id,
                vector_id: v_item_mm.vector_id,
                title: v_item_mm.title,
                description: v_item_mm.description,
                severity: v_item_mm.severity,
                cvss_score: v_item_mm.cvss_score,
                mitigated: true,
            };
            new_vulns_mm = list_push(new_vulns_mm, updated_v_mm);
        } else {
            new_vulns_mm = list_push(new_vulns_mm, v_item_mm);
        }
        i_mm = i_mm + 1;
    }

    if found_mm == true {
        camp_mm.vulnerabilities = new_vulns_mm;
    }

    return found_mm;
}

pub fn redteam_campaign_evaluate_vector(
    camp_ev: &mut RedTeamCampaign,
    vector_id_ev: Int,
    payload_sanitized_ev: Bool
) -> Result[Bool, String] {
    let act_ev: Bool = camp_ev.is_active;
    if act_ev == false {
        return Err("REDTEAM_INACTIVE: Campaign is not active");
    }

    let vecs_ev = camp_ev.vectors;
    let n_ev = list_len(vecs_ev);
    let mut i_ev = 0;
    let mut found_ev = false;
    let mut target_vec_ev = attack_vector_create(0, "", "", 0, "", "");

    while i_ev < n_ev {
        let v_item_ev = list_get(vecs_ev, i_ev);
        let vid_ev: Int = v_item_ev.id;
        let is_match_ev: Bool = vid_ev == vector_id_ev;
        if is_match_ev == true {
            found_ev = true;
            target_vec_ev = v_item_ev;
        }
        i_ev = i_ev + 1;
    }

    if found_ev == false {
        return Err("VECTOR_NOT_FOUND: Attack vector ID not found in campaign");
    }

    let tests_ev = camp_ev.total_tests_run;
    camp_ev.total_tests_run = tests_ev + 1;

    if payload_sanitized_ev == true {
        let blocked_ev = camp_ev.blocked_attacks;
        camp_ev.blocked_attacks = blocked_ev + 1;
        return Ok(true);
    } else {
        let exploits_ev = camp_ev.successful_exploits;
        camp_ev.successful_exploits = exploits_ev + 1;

        let vid_new_ev = vector_id_ev * 100 + exploits_ev + 1;
        let t_id_ev: Int = target_vec_ev.id;
        let t_name_ev: String = target_vec_ev.name;
        let t_comp_ev: String = target_vec_ev.target_component;
        let t_sev_ev: Int = target_vec_ev.severity;
        let new_vuln_ev = vulnerability_create(
            vid_new_ev,
            t_id_ev,
            "Exploit Success: " + t_name_ev,
            "Attack payload executed without sanitization against component: " + t_comp_ev,
            t_sev_ev,
            t_sev_ev * 25
        );
        redteam_campaign_add_vulnerability(camp_ev, new_vuln_ev);

        let sfc_ev: Bool = camp_ev.strict_fail_closed;
        if sfc_ev == true {
            camp_ev.is_active = false;
            return Err("REDTEAM_EXPLOIT_HALT: Campaign halted due to unblocked exploit in fail-closed mode");
        }

        return Ok(false);
    }
}

pub fn redteam_campaign_get_security_score(camp_ss: &RedTeamCampaign) -> Int {
    let total_ss: Int = camp_ss.total_tests_run;
    let is_zero_ss: Bool = total_ss == 0;
    if is_zero_ss == true {
        return 100;
    }
    let blocked_ss: Int = camp_ss.blocked_attacks;
    return (blocked_ss * 100) / total_ss;
}

pub fn redteam_campaign_is_secure(camp_is: &RedTeamCampaign, min_score_is: Int) -> Bool {
    let act_is: Bool = camp_is.is_active;
    if act_is == false {
        let sfc_is: Bool = camp_is.strict_fail_closed;
        if sfc_is == true {
            return false;
        }
    }
    let score_is: Int = redteam_campaign_get_security_score(camp_is);
    let is_ge_is: Bool = score_is >= min_score_is;
    return is_ge_is;
}
