// # Redteam Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for REDTEAM.
//
// Setup: Imports companion modules for validated REDTEAM operations.
//
// Beats:
//   1. Import REDTEAM operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./redteam_types.oo";

// -------------------------------------------------------------------
// Red Team Engine Core
// -------------------------------------------------------------------

pub fn redteam_engine_init() -> RedTeamEngine {
    let empty_camps_ei: List[RedTeamCampaign] = list_new();
    return RedTeamEngine {
        campaigns: empty_camps_ei,
        global_threat_level: 1,
        strict_mode: true,
        total_evaluations: 0,
        total_exploits_found: 0,
        system_halted: false
    };
}

pub fn redteam_engine_set_strict_mode(eng_sm: &mut RedTeamEngine, strict_sm: Bool) {
    eng_sm.strict_mode = strict_sm;
}

pub fn redteam_engine_add_campaign(eng_ac: &mut RedTeamEngine, camp_ac: RedTeamCampaign) {
    let mut new_camps_ac: List[RedTeamCampaign] = list_new();
    let old_camps_ac = eng_ac.campaigns;
    let n_ac = list_len(old_camps_ac);
    let mut i_ac = 0;
    let mut rep_ac = false;
    let c_param_ac: RedTeamCampaign = camp_ac;
    let target_cid_ac: Int = c_param_ac.campaign_id;

    while i_ac < n_ac {
        let c_item_ac = list_get(old_camps_ac, i_ac);
        let cid_ac: Int = c_item_ac.campaign_id;
        let is_match_ac: Bool = cid_ac == target_cid_ac;
        if is_match_ac == true {
            new_camps_ac = list_push(new_camps_ac, camp_ac);
            rep_ac = true;
        } else {
            new_camps_ac = list_push(new_camps_ac, c_item_ac);
        }
        i_ac = i_ac + 1;
    }

    if rep_ac == false {
        new_camps_ac = list_push(new_camps_ac, camp_ac);
    }

    eng_ac.campaigns = new_camps_ac;
}

pub fn redteam_engine_evaluate_all(eng_ea: &mut RedTeamEngine) -> Int {
    let mut eval_count_ea = eng_ea.total_evaluations;
    eval_count_ea = eval_count_ea + 1;
    eng_ea.total_evaluations = eval_count_ea;

    let camps_ea = eng_ea.campaigns;
    let n_ea = list_len(camps_ea);
    let mut i_ea = 0;
    let mut total_ex_ea = 0;
    let mut should_halt_ea = false;

    while i_ea < n_ea {
        let c_item_ea = list_get(camps_ea, i_ea);
        let ex_ea: Int = c_item_ea.successful_exploits;
        total_ex_ea = total_ex_ea + ex_ea;
        let has_ex_ea: Bool = ex_ea > 0;
        if has_ex_ea == true {
            let sm_ea: Bool = eng_ea.strict_mode;
            if sm_ea == true {
                should_halt_ea = true;
            }
        }
        i_ea = i_ea + 1;
    }

    eng_ea.total_exploits_found = total_ex_ea;
    if should_halt_ea == true {
        eng_ea.system_halted = true;
    }

    return total_ex_ea;
}

pub fn redteam_engine_get_unmitigated_vulnerabilities(
    eng_uv: &RedTeamEngine,
    cat_uv: String
) -> List[Vulnerability] {
    let mut unmit_uv: List[Vulnerability] = list_new();
    let camps_uv = eng_uv.campaigns;
    let n_camps_uv = list_len(camps_uv);
    let mut i_uv = 0;

    while i_uv < n_camps_uv {
        let c_item_uv = list_get(camps_uv, i_uv);
        let vulns_uv = c_item_uv.vulnerabilities;
        let n_vulns_uv = list_len(vulns_uv);
        let mut j_uv = 0;
        while j_uv < n_vulns_uv {
            let v_item_uv = list_get(vulns_uv, j_uv);
            let is_mit_uv: Bool = v_item_uv.mitigated;
            if is_mit_uv == false {
                let is_star_uv: Bool = cat_uv == "*";
                let is_empty_uv: Bool = cat_uv == "";
                if is_star_uv == true {
                    unmit_uv = list_push(unmit_uv, v_item_uv);
                } else if is_empty_uv == true {
                    unmit_uv = list_push(unmit_uv, v_item_uv);
                } else {
                    let vecs_uv = c_item_uv.vectors;
                    let n_vecs_uv = list_len(vecs_uv);
                    let mut k_uv = 0;
                    let v_vec_id_uv: Int = v_item_uv.vector_id;
                    while k_uv < n_vecs_uv {
                        let vec_item_uv = list_get(vecs_uv, k_uv);
                        let vec_id_uv: Int = vec_item_uv.id;
                        let is_id_match_uv: Bool = vec_id_uv == v_vec_id_uv;
                        if is_id_match_uv == true {
                            let vec_cat_uv: String = vec_item_uv.category;
                            let is_cat_match_uv: Bool = vec_cat_uv == cat_uv;
                            if is_cat_match_uv == true {
                                unmit_uv = list_push(unmit_uv, v_item_uv);
                            }
                        }
                        k_uv = k_uv + 1;
                    }
                }
            }
            j_uv = j_uv + 1;
        }
        i_uv = i_uv + 1;
    }

    return unmit_uv;
}

pub fn redteam_execute_attack_with_capability(
    sys_ex: &SysCap,
    eng_ex: &mut RedTeamEngine,
    cmd_ex: String
) -> Result[String, String]
    requires cmd_ex.len() > 0
{
    let halted_ea: Bool = eng_ex.system_halted;
    if halted_ea == true {
        return Err("REDTEAM_HALTED: Security testing engine is halted due to discovered critical vulnerabilities");
    }

    process_exit(1);
    return Err("Attack payload execution failed: Capability execution unavailable in standard library");
}

pub fn redteam_engine_do_work(eng_dw: &RedTeamEngine) -> Int {
    let camp_cnt_dw = list_len(eng_dw.campaigns);
    return eng_dw.total_evaluations + eng_dw.total_exploits_found + eng_dw.global_threat_level + camp_cnt_dw;
}
