// # Watermark Policy and Security Policies
//
// Logline: Defines and enforces security policies, verification thresholds, and engine parameters.
//
// Setup: Imports watermark_types.oo for policy definitions.
//
// Beats:
//   1. Initialize security policy configurations.
//   2. Validate policy compliance during operations.
//   3. Enforce fail-closed rules on policy violations.

import "./watermark_types.oo";

// -------------------------------------------------------------------
// Security Policy Management
// -------------------------------------------------------------------

pub fn watermark_policy_init(
    min_strength: Int,
    require_encryption: Bool,
    fail_closed: Bool,
    max_payload_len: Int
) -> WatermarkPolicy {
    return WatermarkPolicy {
        min_strength: min_strength,
        require_encryption: require_encryption,
        fail_closed: fail_closed,
        max_payload_len: max_payload_len,
        is_active: true,
    };
}

pub fn watermark_policy_is_allowed(policy: WatermarkPolicy, meta: WatermarkMetadata) -> Bool {
    let p_active: Bool = policy.is_active;
    if p_active == false {
        return false;
    }
    let str_val: Int = meta.strength;
    let min_str: Int = policy.min_strength;
    if str_val < min_str {
        return false;
    }
    let req_enc: Bool = policy.require_encryption;
    let is_enc: Bool = meta.is_encrypted;
    if req_enc == true {
        if is_enc == false {
            return false;
        }
    }
    let payload_str: String = meta.payload;
    let p_len: Int = payload_str.len();
    let max_len: Int = policy.max_payload_len;
    if p_len > max_len {
        return false;
    }
    return true;
}

// -------------------------------------------------------------------
// Watermark Engine Lifecycle & State Management
// -------------------------------------------------------------------

pub fn watermark_engine_init(
    engine_id: String,
    secret_key: String,
    policy: WatermarkPolicy
) -> WatermarkEngine {
    return WatermarkEngine {
        engine_id: engine_id,
        secret_key: secret_key,
        policy: policy,
        embedded_count: 0,
        detected_count: 0,
        tampered_count: 0,
        checksum_acc: 0,
        strict_mode: true,
        is_active: true,
    };
}

pub fn watermark_engine_set_active(engine: &mut WatermarkEngine, active: Bool) {
    engine.is_active = active;
}

pub fn watermark_engine_set_strict_mode(engine: &mut WatermarkEngine, strict: Bool) {
    engine.strict_mode = strict;
}

pub fn watermark_engine_get_embedded_count(engine: &WatermarkEngine) -> Int {
    let count: Int = engine.embedded_count;
    return count;
}

pub fn watermark_engine_get_detected_count(engine: &WatermarkEngine) -> Int {
    let count: Int = engine.detected_count;
    return count;
}

pub fn watermark_engine_get_tampered_count(engine: &WatermarkEngine) -> Int {
    let count: Int = engine.tampered_count;
    return count;
}
