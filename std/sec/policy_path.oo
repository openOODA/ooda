// # Policy path lock
//
// Logline: Marks next-session identity and policy files so ordinary workspace write cannot change them.
//
// Setup: Pure string tests. Runtime write_file uses the same basename and /.config/ooda/ rules.
//
// Beats:
//   1. policy_path_is_locked is true for SOUL.md, soul.md, .bashrc, ooda.lock, *.agent.pin.
//   2. A path that contains /.config/ooda/ is locked.
//   3. policy_pin_line builds name@version#sha#CapName.

fn ends_with(s: String, suf: String) -> Bool {
    let n: Int = chars_len(s);
    let m: Int = chars_len(suf);
    if m > n {
        return false;
    }
    return str_slice(s, n - m, n) == suf;
}

fn policy_has_sub(s: String, sub: String) -> Bool {
    let n: Int = chars_len(s);
    let m: Int = chars_len(sub);
    if m == 0 {
        return true;
    }
    if m > n {
        return false;
    }
    let mut i: Int = 0;
    while i + m <= n {
        if str_slice(s, i, i + m) == sub {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn path_base(path: String) -> String {
    let n: Int = chars_len(path);
    let mut i: Int = n;
    while i > 0 {
        if char_at(path, i - 1) == "/" {
            return str_slice(path, i, n);
        }
        i = i - 1;
    }
    return path;
}

pub fn policy_path_is_locked(path: String) -> Bool {
    if policy_has_sub(path, "/.config/ooda/") {
        return true;
    }
    let b: String = path_base(path);
    if b == "SOUL.md" {
        return true;
    }
    if b == "soul.md" {
        return true;
    }
    if b == ".bashrc" {
        return true;
    }
    if b == "ooda.lock" {
        return true;
    }
    if ends_with(b, ".agent.pin") {
        return true;
    }
    return false;
}

pub fn policy_pin_line(name: String, ver: String, sha: String, cap: String) -> String {
    return name + "@" + ver + "#" + sha + "#" + cap;
}
