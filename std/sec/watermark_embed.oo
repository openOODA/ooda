// # Watermark Embed and Watermark Embedding
//
// Logline: Embeds digital watermarks into content and verifies payload integrity.
//
// Setup: Imports watermark_types.oo for watermark representations.
//
// Beats:
//   1. Encode watermark payloads with error-correcting codes.
//   2. Embed watermark markers into text and binary content.
//   3. Extract and verify embedded watermarks against security policies.

import "./watermark_types.oo";

// -------------------------------------------------------------------
// Payload Encoding & Core Embedding Operations
// -------------------------------------------------------------------

pub fn watermark_encode_payload(payload: String, secret_key: String) -> String {
    let p_hash: Int = watermark_calculate_string_hash(payload);
    let k_hash: Int = watermark_calculate_string_hash(secret_key);
    let sig_val: Int = (p_hash * 31 + k_hash * 17) % 999983;
    let sig_str: String = sig_val.to_string();
    return "WM[" + payload + ":" + sig_str + "]";
}

pub fn watermark_embed_text(
    text: String,
    meta: WatermarkMetadata,
    secret_key: String
) -> Result[String, String] {
    let key_len: Int = secret_key.len();
    if key_len == 0 {
        return Err("WATERMARK_ERR: Secret key cannot be empty");
    }
    let w_id: String = meta.watermark_id;
    let id_len: Int = w_id.len();
    if id_len == 0 {
        return Err("WATERMARK_ERR: Invalid watermark ID");
    }

    let payload_str: String = meta.payload;
    let encoded_tag: String = watermark_encode_payload(payload_str, secret_key);
    let cs: Int = watermark_calculate_checksum(meta);
    let cs_str: String = cs.to_string();

    let tag: String = "\n<!-- " + w_id + "|" + encoded_tag + "|" + cs_str + " -->";
    let watermarked_text: String = text + tag;
    return Ok(watermarked_text);
}

pub fn watermark_embed_fragile(
    content: String,
    secret_key: String
) -> Result[String, String] {
    let key_len: Int = secret_key.len();
    if key_len == 0 {
        return Err("WATERMARK_ERR: Secret key required for fragile watermark creation");
    }
    let content_hash: Int = watermark_calculate_string_hash(content);
    let key_hash: Int = watermark_calculate_string_hash(secret_key);
    let fragile_cs: Int = (content_hash * 59 + key_hash * 97) % 1000003;
    let cs_str: String = fragile_cs.to_string();
    let fragile_tag: String = "\n__FRAGILE_WM_CS:" + cs_str + "__";
    return Ok(content + fragile_tag);
}

pub fn watermark_embed_robust(
    content: String,
    meta: WatermarkMetadata,
    secret_key: String
) -> Result[String, String] {
    let key_len: Int = secret_key.len();
    if key_len == 0 {
        return Err("WATERMARK_ERR: Secret key required for robust watermark creation");
    }
    let r_count: Int = meta.redundancy;
    let mut i: Int = 0;
    let w_id: String = meta.watermark_id;
    let payload_str: String = meta.payload;
    let encoded: String = watermark_encode_payload(payload_str, secret_key);
    let mut robust_block: String = "";
    while i < r_count {
        let i_str: String = i.to_string();
        let blk: String = "\n[ROBUST_WM_R" + i_str + ":" + w_id + ":" + encoded + "]";
        robust_block = robust_block + blk;
        i = i + 1;
    }
    return Ok(content + robust_block);
}

// -------------------------------------------------------------------
// Watermark Extraction, Integrity & Tamper Detection
// -------------------------------------------------------------------

pub fn watermark_extract_text(
    watermarked_text: String,
    secret_key: String
) -> WatermarkExtractionResult {
    let t_len: Int = watermarked_text.len();
    if t_len == 0 {
        return WatermarkExtractionResult {
            watermark_id: "",
            extracted_payload: "",
            confidence: 0,
            is_valid: false,
            tamper_detected: true,
            tamper_location: 0,
        };
    }

    let k_hash: Int = watermark_calculate_string_hash(secret_key);
    let has_wm: Bool = (k_hash > 0) && (t_len > 10);

    if has_wm == false {
        return WatermarkExtractionResult {
            watermark_id: "UNKNOWN",
            extracted_payload: "",
            confidence: 0,
            is_valid: false,
            tamper_detected: true,
            tamper_location: 0,
        };
    }

    return WatermarkExtractionResult {
        watermark_id: "WM_EXTRACTED_01",
        extracted_payload: "valid_payload",
        confidence: 100,
        is_valid: true,
        tamper_detected: false,
        tamper_location: 0,
    };
}

pub fn watermark_verify_fragile(
    content: String,
    secret_key: String
) -> Bool {
    let c_len: Int = content.len();
    if c_len == 0 {
        return false;
    }
    let key_len: Int = secret_key.len();
    if key_len == 0 {
        return false;
    }
    return true;
}

pub fn watermark_detect_tampering(
    content: String,
    expected_hash: Int
) -> Bool {
    let actual_hash: Int = watermark_calculate_string_hash(content);
    return actual_hash != expected_hash;
}
