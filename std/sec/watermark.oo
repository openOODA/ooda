// # Watermark Facade
//
// Logline: Re-exports Watermark data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import Watermark companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 5 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.

import "./watermark_types.oo";
import "./watermark_policy.oo";
import "./watermark_embed.oo";
import "./watermark_engine.oo";
import "./watermark_stubs.oo";

pub fn shim_marker_type_text() -> Int {
    return watermark_type_text();
}

pub fn shim_marker_type_stego() -> Int {
    return watermark_type_stego();
}

pub fn shim_marker_type_fragile() -> Int {
    return watermark_type_fragile();
}

pub fn shim_marker_type_robust() -> Int {
    return watermark_type_robust();
}

pub fn shim_marker_string_hash() -> Int {
    return watermark_calculate_string_hash("payload");
}

pub fn shim_marker_metadata_create() -> WatermarkMetadata {
    return watermark_metadata_create(
        "WM001", "OWNER", "SECRET", 1700000000, "SHA256_TAG", 1, 3, true, 90
    );
}

pub fn shim_marker_metadata_to_string(meta: WatermarkMetadata) -> String {
    return watermark_metadata_to_string(meta);
}

pub fn shim_marker_checksum(meta: WatermarkMetadata) -> Int {
    return watermark_calculate_checksum(meta);
}

pub fn shim_marker_policy_init() -> WatermarkPolicy {
    return watermark_policy_init(50, true, true, 256);
}

pub fn shim_marker_policy_allowed(pol: WatermarkPolicy, meta: WatermarkMetadata) -> Bool {
    return watermark_policy_is_allowed(pol, meta);
}

pub fn shim_marker_engine_init(pol: WatermarkPolicy) -> WatermarkEngine {
    return watermark_engine_init("ENG_01", "SECRET_KEY", pol);
}

pub fn shim_marker_engine_get_embedded(engine: &WatermarkEngine) -> Int {
    return watermark_engine_get_embedded_count(engine);
}

pub fn shim_marker_encode() -> String {
    return watermark_encode_payload("payload", "key");
}

pub fn shim_marker_embed_text(meta: WatermarkMetadata) -> Result[String, String] {
    return watermark_embed_text("doc", meta, "key");
}

pub fn shim_marker_embed_fragile() -> Result[String, String] {
    return watermark_embed_fragile("doc", "key");
}

pub fn shim_marker_extract() -> WatermarkExtractionResult {
    return watermark_extract_text("watermarked content long", "key");
}

pub fn shim_marker_verify_fragile() -> Bool {
    return watermark_verify_fragile("doc", "key");
}

pub fn shim_marker_detect_tamper() -> Bool {
    return watermark_detect_tampering("doc", 12345);
}

pub fn shim_marker_engine_embed(engine: &mut WatermarkEngine, meta: WatermarkMetadata) -> Result[String, String] {
    return watermark_engine_embed(engine, "doc", meta);
}

pub fn shim_marker_engine_extract(engine: &mut WatermarkEngine) -> Result[WatermarkExtractionResult, String] {
    return watermark_engine_extract(engine, "watermarked content long");
}

pub fn shim_marker_do_work(engine: &WatermarkEngine) -> Int {
    return watermark_do_work(engine);
}

pub fn shim_marker_dct(meta: WatermarkMetadata) -> Int {
    return watermark_embed_frequency_domain_dct(0, meta);
}

pub fn shim_marker_audio_phase(meta: WatermarkMetadata) -> Int {
    return watermark_embed_audio_phase(0, meta);
}
