// # Fuel budget (effort, not wall clock)
//
// Logline: A remaining-cost counter the program passes. Empty or non-positive take denies.
//
// Setup: Pure struct. Not a compiler token. Not &TimeCap. Not maxcycles in oodac.
//
// Beats:
//   1. fuel_new(n) with n<=0 is empty.
//   2. fuel_can is false when cost<=0 or cost>left.
//   3. fuel_after returns the new left, or -1 when denied.
//
// residual: not FuelCap; callers wrap their own loops

type FuelBudget = struct {
    left: Int
};

pub fn fuel_new(n: Int) -> FuelBudget {
    if n <= 0 {
        return FuelBudget { left: 0 };
    }
    return FuelBudget { left: n };
}

pub fn fuel_left(b: FuelBudget) -> Int {
    let have: Int = b.left;
    return have;
}

pub fn fuel_can(b: FuelBudget, cost: Int) -> Bool {
    if cost <= 0 {
        return false;
    }
    let have: Int = b.left;
    if cost > have {
        return false;
    }
    return true;
}

pub fn fuel_after(b: FuelBudget, cost: Int) -> Int {
    if !fuel_can(b, cost) {
        return -1;
    }
    let have: Int = b.left;
    return have - cost;
}
