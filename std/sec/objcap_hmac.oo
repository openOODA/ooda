// # HMAC object-capability seal
//
// Logline: Seal a capability payload string with HMAC-SHA256.
//
// Setup: OPEN-37/38. Wraps crypto_hmac_sha256_internal. No .len(). Not kernel object caps.
//
// Beats:
//   1. Take a secret key and a capability string (uri + rights).
//   2. Return the HMAC-SHA256 hex digest.
//   3. Attenuation and tamper are different payloads and different seals.

pub fn objcap_hmac_seal(key: String, payload: String) -> String {
    return crypto_hmac_sha256_internal(key, payload);
}
