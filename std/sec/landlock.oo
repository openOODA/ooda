// # Landlock Sandbox Module
//
// Logline: Kernel-enforced filesystem sandboxing and PR_SET_NO_NEW_PRIVS confinement.
//
// Setup: Bridges to Linux Landlock syscalls to restrict filesystem access to authorized directories only.
//
// Beats:
//   1. Query kernel Landlock availability.
//   2. Apply path-restricted filesystem boundaries (read allowlist, write allowlist).
//   3. Enforce unprivileged process confinement.
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

pub fn landlock_is_supported() -> Bool {
    let avail: Int = oo_landlock_is_available();
    return avail > 0;
}

pub fn landlock_restrict_process(
    sys_cap: &SysCap,
    read_dirs_colon: String,
    write_dirs_colon: String
) -> Result[Bool, String] {
    let res: Result[String, String] = oo_landlock_restrict(sys_cap, read_dirs_colon, write_dirs_colon);
    if res.is_ok() {
        return Ok(true);
    }
    return Err("LANDLOCK_ERR: restriction failed");
}
