// # Attestation Facade
//
// Logline: Re-exports Attestation data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import Attestation companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 4 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Some large-struct cross-module call markers omitted —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many large by-value calls in one unit.

import "./attestation_engine.oo";
import "./attestation_stubs.oo";

pub fn shim_marker_measurement_create() -> AttestationMeasurement {
    return attestation_measurement_create("m1", "boot", "deadbeef", 0);
}

pub fn shim_marker_measurement_verify() -> Bool {
    let m: AttestationMeasurement = attestation_measurement_create("m1", "boot", "deadbeef", 0);
    return attestation_measurement_verify(m, "deadbeef");
}

pub fn shim_marker_policy_init() -> AttestationPolicy {
    return attestation_policy_init("pol-1", true, false, 50, true);
}

pub fn shim_marker_token_create() -> AttestationToken {
    return attestation_token_create("tok1", "sub", "att", "q1", 90, 1000, 3600);
}

pub fn shim_marker_token_valid() -> Bool {
    let t: AttestationToken = attestation_token_create("tok1", "sub", "att", "q1", 90, 1000, 3600);
    return attestation_token_is_valid(&t, 1500);
}

pub fn shim_marker_quote_create() -> AttestationQuote {
    return attestation_quote_create("q1", "nonce", "sig", "pk1", 1000);
}

pub fn shim_marker_quote_checksum() -> Int {
    let q: AttestationQuote = attestation_quote_create("q1", "nonce", "sig", "pk1", 1000);
    return attestation_quote_calculate_checksum(&q);
}

pub fn shim_marker_quote_trust() -> Int {
    let q: AttestationQuote = attestation_quote_create("q1", "nonce", "sig", "pk1", 1000);
    return attestation_quote_calculate_trust_score(&q);
}

pub fn shim_marker_quote_nonce() -> Bool {
    let q: AttestationQuote = attestation_quote_create("q1", "nonce", "sig", "pk1", 1000);
    return attestation_quote_validate_nonce(&q, "nonce");
}

pub fn shim_marker_engine_init() -> AttestationEngine {
    let pol: AttestationPolicy = attestation_policy_init("pol-1", true, false, 50, true);
    return attestation_engine_init("eng-1", pol);
}

pub fn shim_marker_engine_do_work() -> Int {
    let pol: AttestationPolicy = attestation_policy_init("pol-1", true, false, 50, true);
    let e: AttestationEngine = attestation_engine_init("eng-1", pol);
    return attestation_engine_do_work(&e);
}

pub fn shim_marker_engine_report() -> AttestationReport {
    let pol: AttestationPolicy = attestation_policy_init("pol-1", true, false, 50, true);
    let e: AttestationEngine = attestation_engine_init("eng-1", pol);
    return attestation_engine_generate_report(&e, 1000);
}

pub fn shim_marker_tpm(sys: &SysCap) -> Result[String, String] {
    return attestation_read_hardware_tpm_pcr(sys, 0);
}

pub fn shim_marker_sgx(sys: &SysCap) -> Int {
    return attestation_verify_sgx_enclave_quote(sys, 0);
}
