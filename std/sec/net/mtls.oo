// ===================================================================
// openOODA Standard Library — ooda::sec::net::mtls
// mTLS Re-export Shim (M172 split)
// ===================================================================
// The original 925-line mtls.oo was split at functional seams
// into 5 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// CAP-G6: effectful TLS/TCP session params prefer &TcpCap;
// &NetCap still works via supersede (legacy one-wave compat).
//
// HONESTY (T5 residual): evaluate_* (mtls_engine_evaluate_handshake) is
// policy/chain/revocation only; crypto/TLS stubs are process_exit-gated
// and not wired. Soft-success is NOT a TLS/crypto seal.
//
// HONESTY: Some large-struct cross-module call markers omitted —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many large by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Known residual: certificate_chain_add_intermediate and several
// policy/engine markers are not referenced here for that reason.

import "./mtls_types.oo";
import "./mtls_cert.oo";
import "./mtls_ops.oo";
import "./mtls_engine.oo";
import "./mtls_stubs.oo";

pub fn shim_marker_checksum() -> Int {
    return checksum_calculate("abc");
}

pub fn shim_marker_bytes_eq() -> Bool {
    return bytes_constant_time_eq("ab", "ab");
}

pub fn shim_marker_str_eq() -> Bool {
    return str_eq("a", "a");
}

pub fn shim_marker_cert_empty() -> MtlsCertificate {
    return mtls_certificate_empty();
}

pub fn shim_marker_chain_empty() -> CertificateChain {
    return certificate_chain_empty();
}

pub fn shim_marker_hs_init() -> TlsHandshakeState {
    return tls_handshake_state_init("sess-1");
}

pub fn shim_marker_peer_empty() -> PeerIdentity {
    return peer_identity_empty();
}

pub fn shim_marker_cert_create() -> Result[MtlsCertificate, String] {
    return mtls_certificate_create("c1", "cn", "issuer", "ser1", "RSA", "SHA256", 0, 999, false, "pemdata");
}

pub fn shim_marker_cert_add_san() -> MtlsCertificate {
    let c: MtlsCertificate = mtls_certificate_empty();
    return mtls_certificate_add_san(c, "example.com");
}

pub fn shim_marker_cert_validate() -> Bool {
    let c: MtlsCertificate = mtls_certificate_empty();
    let cref = &c;
    return mtls_certificate_validate(cref, 100);
}

pub fn shim_marker_chain_create() -> CertificateChain {
    let leaf: MtlsCertificate = mtls_certificate_empty();
    let root: MtlsCertificate = mtls_certificate_empty();
    return certificate_chain_create("ch1", leaf, root);
}

pub fn shim_marker_chain_verify() -> Result[Bool, String] {
    let ch: CertificateChain = certificate_chain_empty();
    let chref = &ch;
    return certificate_chain_verify(chref, 100, 4);
}

pub fn shim_marker_hs_transition() -> Result[TlsHandshakeState, String] {
    let st: TlsHandshakeState = tls_handshake_state_init("sess-1");
    return tls_handshake_state_transition(st, "CLIENT_HELLO");
}

pub fn shim_marker_config_default() -> MtlsConfig {
    return mtls_config_default();
}

pub fn shim_marker_config_validate() -> Bool {
    let cfg: MtlsConfig = mtls_config_default();
    let cfgref = &cfg;
    return mtls_config_validate(cfgref);
}

pub fn shim_marker_peer_create() -> PeerIdentity {
    let c: MtlsCertificate = mtls_certificate_empty();
    let cref = &c;
    return peer_identity_create(cref, 50);
}

pub fn shim_marker_peer_add_san() -> PeerIdentity {
    let p: PeerIdentity = peer_identity_empty();
    return peer_identity_add_san_domain(p, "example.com");
}

pub fn shim_marker_policy_init() -> MtlsSecurityPolicy {
    return mtls_policy_init("pol-1", "TLSv1.3", true, 4, true);
}

pub fn shim_marker_engine_init() -> MtlsEngine {
    let pol: MtlsSecurityPolicy = mtls_policy_init("pol-1", "TLSv1.3", true, 4, true);
    return mtls_engine_init("eng-1", pol);
}

pub fn shim_marker_parse_x509(sys: &SysCap) -> Result[MtlsCertificate, String] {
    return mtls_parse_x509_der_asn1(sys, "der");
}

pub fn shim_marker_socket_hs(tcp: &TcpCap) -> Result[MtlsSession, String] {
    // CAP-G6: preferred &TcpCap; &NetCap still works via supersede.
    let cfg: MtlsConfig = mtls_config_default();
    let cfgref = &cfg;
    return mtls_perform_socket_handshake_raw(tcp, "localhost", 443, cfgref);
}

pub fn shim_marker_ocsp(tcp: &TcpCap) -> Result[Bool, String] {
    // CAP-G6: preferred &TcpCap; &NetCap still works via supersede.
    return mtls_verify_ocsp_stapling_response(tcp, "http://ocsp", "ser1");
}

pub fn shim_marker_ebpf(sys: &SysCap) -> Result[Int, String] {
    return mtls_attach_ebpf_mtls_filter(sys, "eth0", "sess-1");
}

pub fn shim_marker_hsm(sys: &SysCap) -> Result[String, String] {
    return mtls_hardware_hsm_sign_handshake(sys, 0, "digest");
}
