// # WAF Inspection Engine & Telemetry
//
// Logline: Re-exports the halted-gate, IP allow/block, body-size, custom-rule, and ruleset-walk entry points and emits the WafInspectionResult and WafTelemetry records.
//
// Setup: Imports waf_types.oo, waf_http.oo, waf_rule.oo, and waf_engine.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. waf_engine_inspect_request: gate against system_halted first.
//   2. waf_rule_match: walk enabled rules and check category match.
//   3. waf_threat_score: aggregate risk_score from matched rules.
//   4. waf_engine_telemetry: emit inspection_time_ms and counts.
//
// residual: TLS decrypt-and-inspect is process_exit in waf_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

import "./waf_types.oo";
import "./waf_http.oo";
import "./waf_rule.oo";
import "./waf_engine.oo";
import "./waf_inspect_engine.oo";
import "./waf_inspect_rulesets.oo";

// -------------------------------------------------------------------
// WAF Inspection Engine Re-export Shim
// -------------------------------------------------------------------
//
// waf_inspect.oo was originally a 264-line monolithic file. It is
// split at functional seams into waf_inspect_engine.oo (halted-gate,
// IP allow/block, body-size, custom-rule) and waf_inspect_rulesets.oo
// (ruleset walker and telemetry builder). Each of those sibling
// files is independently type-checked. This file keeps the public
// surface stable for callers via re-export.

pub fn waf_engine_inspect_request(
    engine: &WafEngine,
    req: &HttpRequest,
    current_time_ms: Int
) -> Result[WafInspectionResult, String] {
    let e0: WafEngine = engine;
    let r0: HttpRequest = req;
    return inspect_engine_inspect_request(e0, r0, current_time_ms);
}

pub fn waf_engine_check_ip_allowlist(
    allow_ips: List[String],
    req: &HttpRequest
) -> Result[WafInspectionResult, String] {
    let r0: HttpRequest = req;
    return inspect_engine_check_ip_allowlist(allow_ips, r0);
}

pub fn waf_engine_check_ip_blocklist(
    block_ips: List[String],
    req: &HttpRequest,
    engine: &WafEngine
) -> Result[WafInspectionResult, String] {
    let r0: HttpRequest = req;
    let e0: WafEngine = engine;
    return inspect_engine_check_ip_blocklist(block_ips, r0, e0);
}

pub fn waf_engine_check_custom_rules(
    engine: &WafEngine,
    req: &HttpRequest,
    is_enforce: Bool
) -> Result[WafInspectionResult, String] {
    let e0: WafEngine = engine;
    let r0: HttpRequest = req;
    return inspect_engine_check_custom_rules(e0, r0, is_enforce);
}

pub fn waf_engine_inspect_rulesets(
    engine: &WafEngine,
    req: &HttpRequest,
    is_enforce: Bool
) -> Result[WafInspectionResult, String] {
    let e0: WafEngine = engine;
    let r0: HttpRequest = req;
    return inspect_rulesets_inspect_rulesets(e0, r0, is_enforce);
}

pub fn waf_telemetry_create(
    req: &HttpRequest,
    result: &WafInspectionResult,
    current_time_ms: Int
) -> WafTelemetry {
    let r0: HttpRequest = req;
    let res0: WafInspectionResult = result;
    return inspect_rulesets_telemetry_create(r0, res0, current_time_ms);
}
