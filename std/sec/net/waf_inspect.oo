// ===================================================================
// openOODA Standard Library — ooda::sec::net::waf_inspect
// WAF inspection engine + telemetry (split from waf.oo, M172)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

import "./waf_types.oo";
import "./waf_http.oo";
import "./waf_rule.oo";
import "./waf_engine.oo";

// -------------------------------------------------------------------
// WAF Inspection Engine Logic
// -------------------------------------------------------------------

pub fn waf_engine_inspect_request(
    engine: &WafEngine,
    req: &HttpRequest,
    current_time_ms: Int
) -> Result[WafInspectionResult, String] {
    let halted_v: Bool = engine.system_halted;
    let fail_closed_v: Bool = engine.config.fail_closed;
    let is_halted: Bool = halted_v;
    let should_block_halt: Bool = is_halted;
    if should_block_halt {
        let act = waf_action_block(503, "WAF Engine system halted (Fail-Closed)");
        let res = WafInspectionResult {
            is_allowed: false,
            action: act,
            matched_rule_id: "SYSTEM_HALTED",
            matched_rule_name: "Engine Halted",
            threat_category: "SYSTEM_HALT",
            risk_score: 10,
            inspection_time_ms: 0,
        };
        return Ok(res);
    }
    let _unused_fc: Bool = fail_closed_v;

    let is_valid_req: Bool = http_request_is_valid(req);
    let is_invalid: Bool = is_valid_req == false;
    if is_invalid {
        let act = waf_action_block(400, "Malformed or invalid HTTP request");
        let res = WafInspectionResult {
            is_allowed: false,
            action: act,
            matched_rule_id: "MALFORMED_REQ",
            matched_rule_name: "Invalid Request Format",
            threat_category: "PROTOCOL_VIOLATION",
            risk_score: 8,
            inspection_time_ms: 1,
        };
        return Ok(res);
    }

    let allow_ips: List[String] = engine.allowed_ips;
    let allow_len: Int = list_len(allow_ips);
    let has_allowlist: Bool = allow_len > 0;
    if has_allowlist {
        let a_res = waf_engine_check_ip_allowlist(allow_ips, req);
        if a_res.is_ok() {
            let r = match a_res { Ok(s) => s, Err(_) => WafInspectionResult {
                is_allowed: true, action: waf_action_allow(), matched_rule_id: "",
                matched_rule_name: "", threat_category: "", risk_score: 0, inspection_time_ms: 0 } };
            return Ok(r);
        }
    }

    let block_ips: List[String] = engine.blocked_ips;
    let block_len: Int = list_len(block_ips);
    let has_blocklist: Bool = block_len > 0;
    if has_blocklist {
        let b_res = waf_engine_check_ip_blocklist(block_ips, req, engine);
        if b_res.is_ok() {
            let r = match b_res { Ok(s) => s, Err(_) => WafInspectionResult {
                is_allowed: true, action: waf_action_allow(), matched_rule_id: "",
                matched_rule_name: "", threat_category: "", risk_score: 0, inspection_time_ms: 0 } };
            return Ok(r);
        }
    }

    let body_str: String = req.body;
    let body_len: Int = body_str.len();
    let max_body: Int = engine.config.max_body_bytes;
    let body_too_big: Bool = body_len > max_body;
    if body_too_big {
        let act = waf_action_block(413, "Request body size exceeds configured threshold");
        let res = WafInspectionResult {
            is_allowed: false, action: act, matched_rule_id: "BODY_SIZE_EXCEEDED",
            matched_rule_name: "Max Body Size Violation", threat_category: "DOS_PREVENTION",
            risk_score: 7, inspection_time_ms: 1 };
        return Ok(res);
    }

    let is_enforce: Bool = str_eq(engine.config.mode, "ENFORCE");
    let c_res = waf_engine_check_custom_rules(engine, req, is_enforce);
    if c_res.is_ok() {
        let r = match c_res { Ok(s) => s, Err(_) => WafInspectionResult {
            is_allowed: true, action: waf_action_allow(), matched_rule_id: "",
            matched_rule_name: "", threat_category: "", risk_score: 0, inspection_time_ms: 0 } };
        return Ok(r);
    }

    let s_res = waf_engine_inspect_rulesets(engine, req, is_enforce);
    if s_res.is_ok() {
        let r = match s_res { Ok(s) => s, Err(_) => WafInspectionResult {
            is_allowed: true, action: waf_action_allow(), matched_rule_id: "",
            matched_rule_name: "", threat_category: "", risk_score: 0, inspection_time_ms: 0 } };
        return Ok(r);
    }

    let clean_act = waf_action_allow();
    let clean_res = WafInspectionResult {
        is_allowed: true, action: clean_act, matched_rule_id: "NONE",
        matched_rule_name: "No Threat Detected", threat_category: "NONE",
        risk_score: 0, inspection_time_ms: current_time_ms };
    return Ok(clean_res);
}

pub fn waf_engine_check_ip_allowlist(
    allow_ips: List[String],
    req: &HttpRequest
) -> Result[WafInspectionResult, String] {
    let allow_len: Int = list_len(allow_ips);
    let mut a_idx: Int = 0;
    while a_idx < allow_len {
        let a_ip: String = list_get(allow_ips, a_idx);
        let ip_match: Bool = str_eq(a_ip, req.client_ip);
        if ip_match {
            let act = waf_action_allow();
            let res = WafInspectionResult {
                is_allowed: true, action: act, matched_rule_id: "IP_ALLOWLIST",
                matched_rule_name: "Explicit IP Whitelist Match", threat_category: "NONE",
                risk_score: 0, inspection_time_ms: 1 };
            return Ok(res);
        }
        a_idx = a_idx + 1;
    }
    return Err("NOT_IN_ALLOWLIST");
}

pub fn waf_engine_check_ip_blocklist(
    block_ips: List[String],
    req: &HttpRequest,
    engine: &WafEngine
) -> Result[WafInspectionResult, String] {
    let block_len: Int = list_len(block_ips);
    let mut b_idx: Int = 0;
    while b_idx < block_len {
        let b_ip: String = list_get(block_ips, b_idx);
        let ip_blocked: Bool = str_eq(b_ip, req.client_ip);
        if ip_blocked {
            let act = waf_action_block(engine.config.block_status_code, "Client IP is blacklisted");
            let res = WafInspectionResult {
                is_allowed: false, action: act, matched_rule_id: "IP_BLOCKLIST",
                matched_rule_name: "Blacklisted Client IP", threat_category: "IP_REPUTATION",
                risk_score: 9, inspection_time_ms: 1 };
            return Ok(res);
        }
        b_idx = b_idx + 1;
    }
    return Err("NOT_BLOCKED");
}

pub fn waf_engine_check_custom_rules(
    engine: &WafEngine,
    req: &HttpRequest,
    is_enforce: Bool
) -> Result[WafInspectionResult, String] {
    let c_rules: List[WafRule] = engine.custom_rules;
    let num_c_rules: Int = list_len(c_rules);
    let mut c_idx: Int = 0;
    while c_idx < num_c_rules {
        let r_item: WafRule = list_get(c_rules, c_idx);
        let match_v: Bool = waf_rule_matches_request(&r_item, req);
        if match_v {
            let act = waf_action_block(engine.config.block_status_code, r_item.name);
            let log_mode: Bool = is_enforce == false;
            let final_act: WafAction = act;
            let is_allowed_v: Bool = log_mode;
            let res = WafInspectionResult {
                is_allowed: is_allowed_v, action: final_act, matched_rule_id: r_item.rule_id,
                matched_rule_name: r_item.name, threat_category: r_item.category,
                risk_score: r_item.severity, inspection_time_ms: 2 };
            return Ok(res);
        }
        c_idx = c_idx + 1;
    }
    return Err("NO_CUSTOM_MATCH");
}

pub fn waf_engine_inspect_rulesets(
    engine: &WafEngine,
    req: &HttpRequest,
    is_enforce: Bool
) -> Result[WafInspectionResult, String] {
    let sets: List[WafRuleSet] = engine.rule_sets;
    let num_sets: Int = list_len(sets);
    let mut s_idx: Int = 0;
    while s_idx < num_sets {
        let set_item: WafRuleSet = list_get(sets, s_idx);
        let x_active: Bool = set_item.enabled;
        if x_active == false {
            s_idx = s_idx + 1;
        } else {
            let rules_field: List[WafRule] = set_item.rules;
            let r_list: List[WafRule] = rules_field;
            let num_r: Int = list_len(r_list);
            let mut r_idx: Int = 0;
            while r_idx < num_r {
                let rule_obj: WafRule = list_get(r_list, r_idx);
                if waf_rule_matches_request(&rule_obj, req) {
                    let mut act = waf_action_block(engine.config.block_status_code, rule_obj.name);
                    let is_log_mode: Bool = is_enforce == false;
                    if is_log_mode {
                        act = waf_action_log(rule_obj.name);
                    }
                    let is_allowed_v: Bool = is_log_mode;
                    let res = WafInspectionResult {
                        is_allowed: is_allowed_v,
                        action: act,
                        matched_rule_id: rule_obj.rule_id,
                        matched_rule_name: rule_obj.name,
                        threat_category: rule_obj.category,
                        risk_score: rule_obj.severity,
                        inspection_time_ms: 3,
                    };
                    return Ok(res);
                }
                r_idx = r_idx + 1;
            }
        }
        s_idx = s_idx + 1;
    }
    return Err("NO_RULESET_MATCH");
}

pub fn waf_telemetry_create(
    req: &HttpRequest,
    result: &WafInspectionResult,
    current_time_ms: Int
) -> WafTelemetry {
    let result_action: WafAction = result.action;
    let result_at: String = result_action.action_type;
    return WafTelemetry {
        request_uri: req.uri,
        client_ip: req.client_ip,
        action_taken: result_at,
        rule_triggered: result.matched_rule_id,
        risk_score: result.risk_score,
        timestamp: current_time_ms,
    };
}
