// # WAF Rule & Ruleset Constructors & Matching
//
// Logline: Build WafRule and WafRuleset records; enable, disable, and match pattern fields.
//
// Setup: Imports waf_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. waf_rule_create: bind rule_id, name, category, and pattern.
//   2. waf_rule_enable: flip enabled to true.
//   3. waf_rule_disable: flip enabled to false.
//   4. waf_ruleset_add_rule: append rule to WafRuleset rule list.
//
// residual: PCRE2 JIT match is process_exit in waf_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

import "./waf_types.oo";

// -------------------------------------------------------------------
// WAF Rule Constructors & Matching
// -------------------------------------------------------------------

pub fn waf_rule_create(
    rule_id: String,
    name: String,
    category: String,
    pattern: String,
    target_field: String,
    action: String,
    severity: Int
) -> WafRule {
    return WafRule {
        rule_id: rule_id,
        name: name,
        category: category,
        pattern: pattern,
        target_field: target_field,
        action: action,
        severity: severity,
        enabled: true,
    };
}

pub fn waf_rule_enable(rule: WafRule) -> WafRule {
    return WafRule {
        rule_id: rule.rule_id,
        name: rule.name,
        category: rule.category,
        pattern: rule.pattern,
        target_field: rule.target_field,
        action: rule.action,
        severity: rule.severity,
        enabled: true,
    };
}

pub fn waf_rule_disable(rule: WafRule) -> WafRule {
    return WafRule {
        rule_id: rule.rule_id,
        name: rule.name,
        category: rule.category,
        pattern: rule.pattern,
        target_field: rule.target_field,
        action: rule.action,
        severity: rule.severity,
        enabled: false,
    };
}

pub fn waf_rule_matches_request(rule: &WafRule, req: &HttpRequest) -> Bool {
    if rule.enabled == false {
        return false;
    }
    let pat: String = rule.pattern;
    let p_len: Int = pat.len();
    if p_len == 0 {
        return false;
    }

    let tf: String = rule.target_field;

    if str_eq(tf, "URI") {
        return str_contains_ic(req.uri, pat);
    }

    if str_eq(tf, "BODY") {
        return str_contains_ic(req.body, pat);
    }

    if str_eq(tf, "IP") {
        return str_contains_ic(req.client_ip, pat);
    }

    if str_eq(tf, "HEADER") {
        let vals: List[String] = req.headers_vals;
        let v_len: Int = list_len(vals);
        let mut i: Int = 0;
        while i < v_len {
            let v_item: String = list_get(vals, i);
            if str_contains_ic(v_item, pat) {
                return true;
            }
            i = i + 1;
        }
        let user_agent: String = req.user_agent;
        if str_contains_ic(user_agent, pat) {
            return true;
        }
        return false;
    }

    if str_eq(tf, "ALL") {
        if str_contains_ic(req.uri, pat) {
            return true;
        }
        if str_contains_ic(req.body, pat) {
            return true;
        }
        if str_contains_ic(req.client_ip, pat) {
            return true;
        }
        if str_contains_ic(req.user_agent, pat) {
            return true;
        }
        let h_vals: List[String] = req.headers_vals;
        let hv_len: Int = list_len(h_vals);
        let mut j: Int = 0;
        while j < hv_len {
            let item_val: String = list_get(h_vals, j);
            if str_contains_ic(item_val, pat) {
                return true;
            }
            j = j + 1;
        }
        return false;
    }

    return false;
}

// -------------------------------------------------------------------
// WAF RuleSet Constructors & Factory
// -------------------------------------------------------------------

pub fn waf_ruleset_create(ruleset_id: String, name: String) -> WafRuleSet {
    let empty_rules: List[WafRule] = list_new();
    return WafRuleSet {
        ruleset_id: ruleset_id,
        name: name,
        rules: empty_rules,
        total_rules: 0,
        enabled: true,
    };
}

pub fn waf_ruleset_add_rule(ruleset: WafRuleSet, rule: WafRule) -> WafRuleSet {
    let cur_rules: List[WafRule] = ruleset.rules;
    let new_rules: List[WafRule] = list_push(cur_rules, rule);
    let cur_total_v: Int = ruleset.total_rules;
    let one: Int = 1;
    let new_total: Int = cur_total_v + one;
    return WafRuleSet {
        ruleset_id: ruleset.ruleset_id,
        name: ruleset.name,
        rules: new_rules,
        total_rules: new_total,
        enabled: ruleset.enabled,
    };
}

pub fn waf_ruleset_default_owasp_top10() -> WafRuleSet {
    let mut rs: WafRuleSet = waf_ruleset_create("OWASP_TOP10", "OWASP Top 10 Security Rule Set");

    let r_sqli: WafRule = waf_rule_create("RULE_1001", "SQL Injection Attempt", "SQLI", "' OR ", "ALL", "BLOCK", 9);
    let r_xss: WafRule = waf_rule_create("RULE_1002", "Cross-Site Scripting", "XSS", "<script", "ALL", "BLOCK", 8);
    let r_rce: WafRule = waf_rule_create("RULE_1003", "Remote Code Execution", "RCE", "/bin/sh", "ALL", "BLOCK", 10);
    let r_lfi: WafRule = waf_rule_create("RULE_1004", "Local File Inclusion", "LFI", "/etc/passwd", "ALL", "BLOCK", 8);
    let r_bot: WafRule = waf_rule_create("RULE_1005", "Malicious Vulnerability Scanner", "BOT", "sqlmap", "HEADER", "BLOCK", 7);

    rs = waf_ruleset_add_rule(rs, r_sqli);
    rs = waf_ruleset_add_rule(rs, r_xss);
    rs = waf_ruleset_add_rule(rs, r_rce);
    rs = waf_ruleset_add_rule(rs, r_lfi);
    rs = waf_ruleset_add_rule(rs, r_bot);

    return rs;
}

pub fn waf_rule_ready() -> Int {
    return 1;
}
