// ===================================================================
// openOODA Standard Library — ooda::sec::net::jwt_types
// JWT core types (split from jwt.oo, M171)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required where applicable.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

// -------------------------------------------------------------------
// Core Data Structures & Realistic Types
// -------------------------------------------------------------------

pub type JwtHeader = struct {
    alg: String,
    typ: String,
    cty: String,
    kid: String,
    is_valid: Bool,
};

pub type JwtPayload = struct {
    sub: String,
    iss: String,
    aud: String,
    exp: Int,
    nbf: Int,
    iat: Int,
    jti: String,
    roles: List[String],
    custom_claim_keys: List[String],
    custom_claim_vals: List[String],
    is_valid: Bool,
};

pub type JwtToken = struct {
    raw_token: String,
    header: JwtHeader,
    payload: JwtPayload,
    signature: String,
    signing_algorithm: String,
    issued_at: Int,
    expires_at: Int,
    is_verified: Bool,
    is_revoked: Bool,
    is_valid: Bool,
};

pub type JwtConfig = struct {
    secret: String,
    algorithm: String,
    issuer: String,
    audience: String,
    default_ttl_seconds: Int,
    is_valid: Bool,
};

pub type JwtValidationRules = struct {
    require_exp: Bool,
    require_nbf: Bool,
    require_iss: Bool,
    require_aud: Bool,
    expected_issuer: String,
    expected_audience: String,
    clock_skew_seconds: Int,
    allowed_algorithms: List[String],
    is_active: Bool,
};

pub type JwtVerificationResult = struct {
    is_valid: Bool,
    subject: String,
    issuer: String,
    error_code: String,
    error_description: String,
    verification_time: Int,
};

pub type JwtEngine = struct {
    engine_id: String,
    config: JwtConfig,
    validation_rules: JwtValidationRules,
    issued_tokens: List[JwtToken],
    revoked_jtis: List[String],
    tokens_issued: Int,
    tokens_verified: Int,
    tokens_rejected: Int,
    system_halted: Bool,
};

// Marker so standalone oodac check has a function body.
pub fn jwt_types_marker() -> Int {
    return 0;
}

pub type Fail = struct {};
pub type Default = struct {};


pub fn __dummy_std_src_ooda_sec_net_jwt_types_oo() -> Int {
    return 0;
}
