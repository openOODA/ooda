// ===================================================================
// openOODA Standard Library — ooda::sec::net::mtls_types
// mTLS types & helpers (split from mtls.oo, M172)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects.
// CAP-G6: preferred &TcpCap for TLS/TCP session effects; &NetCap still works via supersede.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

// -------------------------------------------------------------------
// Core Data Structures & Realistic mTLS Types
// -------------------------------------------------------------------

pub type MtlsCertificate = struct {
    cert_id: String,
    subject_cn: String,
    issuer_cn: String,
    sans: List[String],
    serial_number: String,
    public_key_algorithm: String,
    signature_algorithm: String,
    not_before: Int,
    not_after: Int,
    is_ca: Bool,
    is_self_signed: Bool,
    raw_pem: String,
    checksum: Int,
    is_valid: Bool,
};

pub type CertificateChain = struct {
    chain_id: String,
    leaf: MtlsCertificate,
    intermediates: List[MtlsCertificate],
    root: MtlsCertificate,
    depth: Int,
    is_verified: Bool,
    error_code: String,
};

pub type TlsHandshakeState = struct {
    session_id: String,
    stage: String,
    cipher_suite: String,
    tls_version: String,
    client_random: String,
    server_random: String,
    pre_master_secret_hash: String,
    client_auth_requested: Bool,
    client_auth_completed: Bool,
    is_handshake_complete: Bool,
    error_message: String,
};

pub type MtlsConfig = struct {
    config_id: String,
    server_name_indication: String,
    require_client_cert: Bool,
    verify_hostname: Bool,
    min_tls_version: String,
    allowed_cipher_suites: List[String],
    max_chain_depth: Int,
    ca_roots: List[MtlsCertificate],
    client_cert: MtlsCertificate,
    client_chain: CertificateChain,
    session_timeout_seconds: Int,
    enforce_revocation_check: Bool,
    is_valid: Bool,
};

pub type PeerIdentity = struct {
    peer_id: String,
    common_name: String,
    organization: String,
    san_domains: List[String],
    san_ips: List[String],
    cert_serial: String,
    fingerprint_sha256: String,
    trust_score: Int,
    is_authenticated: Bool,
};

pub type MtlsSession = struct {
    session_id: String,
    config: MtlsConfig,
    peer_identity: PeerIdentity,
    handshake_state: TlsHandshakeState,
    negotiated_cipher: String,
    negotiated_version: String,
    established_at: Int,
    expires_at: Int,
    bytes_sent: Int,
    bytes_received: Int,
    is_active: Bool,
    is_renegotiated: Bool,
};

pub type MtlsSecurityPolicy = struct {
    policy_id: String,
    min_tls_version: String,
    mandatory_client_auth: Bool,
    require_san_match: Bool,
    max_cert_chain_depth: Int,
    allowed_sans: List[String],
    revocation_check_strict: Bool,
    fail_closed: Bool,
    is_active: Bool,
};

pub type MtlsVerificationResult = struct {
    is_success: Bool,
    session_id: String,
    peer_id: String,
    chain_depth: Int,
    error_code: String,
    error_description: String,
    timestamp: Int,
};

pub type MtlsHandshakeResult = struct {
    is_successful: Bool,
    session_id: String,
    negotiated_cipher: String,
    peer_common_name: String,
    handshake_duration_ms: Int,
    error_code: String,
};

pub type MtlsEngine = struct {
    engine_id: String,
    policy: MtlsSecurityPolicy,
    active_sessions: List[MtlsSession],
    revoked_cert_serials: List[String],
    total_handshakes: Int,
    successful_handshakes: Int,
    failed_handshakes: Int,
    system_halted: Bool,
};

// -------------------------------------------------------------------
// Helper Functions & Utilities
// -------------------------------------------------------------------

pub fn checksum_calculate(raw_bytes: String) -> Int {
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < raw_len {
        let ch: Int = byte_at(raw_bytes, i);
        let hash_x33: Int = hash * 33;
        hash = hash_x33 + ch;
        i = i + 1;
    }
    return hash;
}

pub fn bytes_constant_time_eq(s1: String, s2: String) -> Bool {
    let s1_len: Int = s1.len();
    let s2_len: Int = s2.len();
    if s1_len != s2_len {
        return false;
    }
    let mut i: Int = 0;
    let mut diff: Int = 0;
    while i < s1_len {
        let b1: Int = byte_at(s1, i);
        let b2: Int = byte_at(s2, i);
        if b1 != b2 {
            diff = diff + 1;
        }
        i = i + 1;
    }
    return diff == 0;
}

pub fn str_eq(s1: String, s2: String) -> Bool {
    let s1_len: Int = s1.len();
    let s2_len: Int = s2.len();
    if s1_len != s2_len {
        return false;
    }
    let mut i: Int = 0;
    while i < s1_len {
        let b1: Int = byte_at(s1, i);
        let b2: Int = byte_at(s2, i);
        if b1 != b2 {
            return false;
        }
        i = i + 1;
    }
    return true;
}
