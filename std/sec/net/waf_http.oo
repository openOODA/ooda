// ===================================================================
// openOODA Standard Library — ooda::sec::net::waf_http
// HTTP request + WAF action constructors (split from waf.oo, M172)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

import "./waf_types.oo";

// -------------------------------------------------------------------
// HTTP Request Constructors & Helpers
// -------------------------------------------------------------------

pub fn http_request_create(
    method: String,
    uri: String,
    body: String,
    client_ip: String,
    user_agent: String
) -> HttpRequest {
    let empty_keys: List[String] = list_new();
    let empty_vals: List[String] = list_new();
    let m_len: Int = method.len();
    let u_len: Int = uri.len();
    let mut valid: Bool = true;
    if m_len == 0 {
        valid = false;
    }
    if u_len == 0 {
        valid = false;
    }
    return HttpRequest {
        method: method,
        uri: uri,
        headers_keys: empty_keys,
        headers_vals: empty_vals,
        body: body,
        client_ip: client_ip,
        user_agent: user_agent,
        is_valid: valid,
    };
}

pub fn http_request_add_header(req: HttpRequest, key: String, val: String) -> HttpRequest {
    let cur_keys: List[String] = req.headers_keys;
    let cur_vals: List[String] = req.headers_vals;
    let new_keys: List[String] = list_push(cur_keys, key);
    let new_vals: List[String] = list_push(cur_vals, val);
    return HttpRequest {
        method: req.method,
        uri: req.uri,
        headers_keys: new_keys,
        headers_vals: new_vals,
        body: req.body,
        client_ip: req.client_ip,
        user_agent: req.user_agent,
        is_valid: req.is_valid,
    };
}

pub fn http_request_get_header(req: &HttpRequest, key: String) -> Result[String, String] {
    let keys: List[String] = req.headers_keys;
    let vals: List[String] = req.headers_vals;
    let k_len: Int = list_len(keys);
    let mut i: Int = 0;
    while i < k_len {
        let k_item: String = list_get(keys, i);
        if str_eq(k_item, key) {
            let v_item: String = list_get(vals, i);
            return Ok(v_item);
        }
        i = i + 1;
    }
    return Err("HEADER_NOT_FOUND");
}

pub fn http_request_is_valid(req: &HttpRequest) -> Bool {
    let is_v: Bool = req.is_valid;
    if is_v == false {
        return false;
    }
    let m_str: String = req.method;
    let m_len: Int = m_str.len();
    if m_len == 0 {
        return false;
    }
    let u_str: String = req.uri;
    let u_len: Int = u_str.len();
    if u_len == 0 {
        return false;
    }
    return true;
}

// -------------------------------------------------------------------
// WAF Action Constructors & Helpers
// -------------------------------------------------------------------

pub fn waf_action_allow() -> WafAction {
    return WafAction {
        action_type: "ALLOW",
        status_code: 200,
        reason: "Request passed WAF security inspection",
        is_blocked: false,
    };
}

pub fn waf_action_block(status_code: Int, reason: String) -> WafAction {
    return WafAction {
        action_type: "BLOCK",
        status_code: status_code,
        reason: reason,
        is_blocked: true,
    };
}

pub fn waf_action_challenge(reason: String) -> WafAction {
    return WafAction {
        action_type: "CHALLENGE",
        status_code: 429,
        reason: reason,
        is_blocked: true,
    };
}

pub fn waf_action_log(reason: String) -> WafAction {
    return WafAction {
        action_type: "LOG",
        status_code: 200,
        reason: reason,
        is_blocked: false,
    };
}

pub fn waf_http_ready() -> Int {
    return 1;
}
