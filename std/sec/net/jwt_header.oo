// # JWT Header Construction & Algorithm Safety
//
// Logline: Implements JWT header constructors, algorithm validation, and none-algorithm rejection.
//
// Setup: Imports jwt_types.oo and jwt_util.oo for JWT header processing.
//
// Beats:
//   1. Construct default and parameterized JwtHeader structures.
//   2. Validate header metadata and algorithm compatibility.
//   3. Reject insecure 'none' algorithm variants in strict fail-closed mode.

import "./jwt_util.oo";

pub fn jwt_header_default() -> JwtHeader {
    return JwtHeader {
        alg: "HS256",
        typ: "JWT",
        cty: "",
        kid: "",
        is_valid: true
    };
}

pub fn jwt_header_create(alg: String, kid: String) -> JwtHeader {
    let alg_len: Int = alg.len();
    let mut valid: Bool = true;
    if alg_len == 0 {
        valid = false;
    }
    return JwtHeader {
        alg: alg,
        typ: "JWT",
        cty: "",
        kid: kid,
        is_valid: valid
    };
}

pub fn jwt_header_validate(hdr: JwtHeader) -> Bool {
    let is_v: Bool = hdr.is_valid;
    if is_v == false {
        return false;
    }
    let alg: String = hdr.alg;
    let alg_len: Int = alg.len();
    if alg_len == 0 {
        return false;
    }
    if jwt_alg_is_safe(alg) == false {
        return false;
    }
    let typ: String = hdr.typ;
    if jwt_str_eq(typ, "JWT") == false {
        return false;
    }
    return true;
}

pub fn jwt_alg_is_safe(alg: String) -> Bool {
    let alg_len: Int = alg.len();
    if alg_len == 0 {
        return false;
    }
    if alg_len != 4 {
        return true;
    }
    let b0: Int = byte_at(alg, 0);
    if b0 != 110 {
        if b0 != 78 {
            return true;
        }
    }
    let b1: Int = byte_at(alg, 1);
    if b1 != 111 {
        if b1 != 79 {
            return true;
        }
    }
    let b2: Int = byte_at(alg, 2);
    if b2 != 110 {
        if b2 != 78 {
            return true;
        }
    }
    let b3: Int = byte_at(alg, 3);
    if b3 != 101 {
        if b3 != 69 {
            return true;
        }
    }
    return false;
}

pub fn __dummy_std_src_ooda_sec_net_jwt_header_oo() -> Int {
    return 0;
}
