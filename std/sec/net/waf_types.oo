// # WAF Core Types & String Helpers
//
// Logline: Define HttpRequest, WafAction, WafRule, and WafEngine records; provide str_eq, str_contains_ic.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. HttpRequest: bind method, uri, headers, body, client_ip, user_agent.
//   2. WafAction: bind action_type, status_code, reason, is_blocked.
//   3. WafRule: bind rule_id, name, category, pattern, target_field, action.
//   4. str_eq: byte-equal String comparison.
//
// residual: struct + pure helpers only.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

// -------------------------------------------------------------------
// Core WAF Types & Structures
// -------------------------------------------------------------------

pub type HttpRequest = struct {
    method: String,
    uri: String,
    headers_keys: List[String],
    headers_vals: List[String],
    body: String,
    client_ip: String,
    user_agent: String,
    is_valid: Bool,
};

pub type WafAction = struct {
    action_type: String,
    status_code: Int,
    reason: String,
    is_blocked: Bool,
};

pub type WafRule = struct {
    rule_id: String,
    name: String,
    category: String,
    pattern: String,
    target_field: String,
    action: String,
    severity: Int,
    enabled: Bool,
};

pub type WafRuleSet = struct {
    ruleset_id: String,
    name: String,
    rules: List[WafRule],
    total_rules: Int,
    enabled: Bool,
};

pub type WafInspectionResult = struct {
    is_allowed: Bool,
    action: WafAction,
    matched_rule_id: String,
    matched_rule_name: String,
    threat_category: String,
    risk_score: Int,
    inspection_time_ms: Int,
};

pub type WafEngineConfig = struct {
    engine_name: String,
    mode: String,
    max_body_bytes: Int,
    block_status_code: Int,
    enable_sqli_protection: Bool,
    enable_xss_protection: Bool,
    enable_rce_protection: Bool,
    enable_lfi_protection: Bool,
    rate_limit_requests_per_sec: Int,
    fail_closed: Bool,
};

pub type WafEngine = struct {
    config: WafEngineConfig,
    rule_sets: List[WafRuleSet],
    custom_rules: List[WafRule],
    blocked_ips: List[String],
    allowed_ips: List[String],
    total_inspected: Int,
    total_blocked: Int,
    total_allowed: Int,
    system_halted: Bool,
};

pub type WafTelemetry = struct {
    request_uri: String,
    client_ip: String,
    action_taken: String,
    rule_triggered: String,
    risk_score: Int,
    timestamp: Int,
};

// -------------------------------------------------------------------
// Helper Functions & String Manipulations
// -------------------------------------------------------------------

pub fn str_eq(s1: String, s2: String) -> Bool {
    let len1: Int = s1.len();
    let len2: Int = s2.len();
    if len1 != len2 {
        return false;
    }
    let mut i: Int = 0;
    while i < len1 {
        let b1: Int = byte_at(s1, i);
        let b2: Int = byte_at(s2, i);
        if b1 != b2 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn to_lower_char(b: Int) -> Int {
    if b >= 65 {
        if b <= 90 {
            return b + 32;
        }
    }
    return b;
}

pub fn str_contains_ic(haystack: String, needle: String) -> Bool {
    let h_len: Int = haystack.len();
    let n_len: Int = needle.len();
    if n_len == 0 {
        return true;
    }
    if h_len < n_len {
        return false;
    }
    let max_idx: Int = h_len - n_len;
    let mut i: Int = 0;
    while i <= max_idx {
        let mut match_found: Bool = true;
        let mut j: Int = 0;
        while j < n_len {
            let b1: Int = to_lower_char(byte_at(haystack, i + j));
            let b2: Int = to_lower_char(byte_at(needle, j));
            if b1 != b2 {
                match_found = false;
            }
            j = j + 1;
        }
        if match_found {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn str_starts_with(s: String, prefix: String) -> Bool {
    let s_len: Int = s.len();
    let p_len: Int = prefix.len();
    if s_len < p_len {
        return false;
    }
    let mut i: Int = 0;
    while i < p_len {
        let b1: Int = byte_at(s, i);
        let b2: Int = byte_at(prefix, i);
        if b1 != b2 {
            return false;
        }
        i = i + 1;
    }
    return true;
}
