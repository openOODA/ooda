// ===================================================================
// openOODA Standard Library — ooda::sec::net::waf
// WAF Re-export Shim (M172 split)
// ===================================================================
// The original 904-line waf.oo was split at functional seams
// into 6 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: HTTP request shape, rule match, and inspect policy paths are
// partial-real pure-data logic. TLS decrypt-and-inspect stream and other
// network/crypto residual are fail-closed in waf_stubs.oo. Not a
// production edge WAF; do not treat rule hits as decrypted-traffic proof.

import "./waf_types.oo";
import "./waf_http.oo";
import "./waf_rule.oo";
import "./waf_engine.oo";
import "./waf_inspect.oo";
import "./waf_stubs.oo";

pub fn shim_marker_str_eq() -> Bool {
    return str_eq("a", "a");
}

pub fn shim_marker_str_contains_ic() -> Bool {
    return str_contains_ic("Hello", "ell");
}

pub fn shim_marker_str_starts_with() -> Bool {
    return str_starts_with("abc", "ab");
}

pub fn shim_marker_http_request_create() -> HttpRequest {
    return http_request_create("GET", "/", "", "127.0.0.1", "test-agent");
}

pub fn shim_marker_http_request_add_header(req: HttpRequest) -> HttpRequest {
    return http_request_add_header(req, "Host", "example.com");
}

pub fn shim_marker_http_request_get_header(req: &HttpRequest) -> Result[String, String] {
    return http_request_get_header(req, "Host");
}

pub fn shim_marker_http_request_is_valid(req: &HttpRequest) -> Bool {
    return http_request_is_valid(req);
}

pub fn shim_marker_waf_action_allow() -> WafAction {
    return waf_action_allow();
}

pub fn shim_marker_waf_action_block() -> WafAction {
    return waf_action_block(403, "blocked");
}

pub fn shim_marker_waf_action_challenge() -> WafAction {
    return waf_action_challenge("rate limit");
}

pub fn shim_marker_waf_action_log() -> WafAction {
    return waf_action_log("logged");
}

pub fn shim_marker_waf_rule_create() -> WafRule {
    return waf_rule_create("R1", "test", "SQLI", "' OR ", "ALL", "BLOCK", 9);
}

pub fn shim_marker_waf_rule_enable(rule: WafRule) -> WafRule {
    return waf_rule_enable(rule);
}

pub fn shim_marker_waf_rule_disable(rule: WafRule) -> WafRule {
    return waf_rule_disable(rule);
}

pub fn shim_marker_waf_rule_matches(rule: &WafRule, req: &HttpRequest) -> Bool {
    return waf_rule_matches_request(rule, req);
}

pub fn shim_marker_waf_ruleset_create() -> WafRuleSet {
    return waf_ruleset_create("rs-1", "default");
}

pub fn shim_marker_waf_ruleset_add(rs: WafRuleSet, rule: WafRule) -> WafRuleSet {
    return waf_ruleset_add_rule(rs, rule);
}

pub fn shim_marker_waf_ruleset_owasp() -> WafRuleSet {
    return waf_ruleset_default_owasp_top10();
}

pub fn shim_marker_waf_config_default() -> WafEngineConfig {
    return waf_config_default();
}

pub fn shim_marker_waf_config_detection_only() -> WafEngineConfig {
    return waf_config_detection_only();
}

pub fn shim_marker_waf_engine_init() -> WafEngine {
    let cfg: WafEngineConfig = waf_config_default();
    return waf_engine_init(cfg);
}

pub fn shim_marker_waf_engine_add_ruleset(e: WafEngine, rs: WafRuleSet) -> WafEngine {
    return waf_engine_add_ruleset(e, rs);
}

pub fn shim_marker_waf_engine_add_custom(e: WafEngine, rule: WafRule) -> WafEngine {
    return waf_engine_add_custom_rule(e, rule);
}

pub fn shim_marker_waf_engine_block_ip(e: WafEngine) -> WafEngine {
    return waf_engine_block_ip(e, "1.2.3.4");
}

pub fn shim_marker_waf_engine_allow_ip(e: WafEngine) -> WafEngine {
    return waf_engine_allow_ip(e, "10.0.0.1");
}

pub fn shim_marker_waf_engine_halt(e: WafEngine) -> WafEngine {
    return waf_engine_halt(e);
}

pub fn shim_marker_waf_engine_inspect(e: &WafEngine, req: &HttpRequest) -> Result[WafInspectionResult, String] {
    return waf_engine_inspect_request(e, req, 0);
}

pub fn shim_marker_waf_check_allowlist(req: &HttpRequest) -> Result[WafInspectionResult, String] {
    let empty: List[String] = list_new();
    return waf_engine_check_ip_allowlist(empty, req);
}

pub fn shim_marker_waf_check_blocklist(e: &WafEngine, req: &HttpRequest) -> Result[WafInspectionResult, String] {
    let empty: List[String] = list_new();
    return waf_engine_check_ip_blocklist(empty, req, e);
}

pub fn shim_marker_waf_check_custom(e: &WafEngine, req: &HttpRequest) -> Result[WafInspectionResult, String] {
    return waf_engine_check_custom_rules(e, req, true);
}

pub fn shim_marker_waf_inspect_rulesets(e: &WafEngine, req: &HttpRequest) -> Result[WafInspectionResult, String] {
    return waf_engine_inspect_rulesets(e, req, true);
}

pub fn shim_marker_waf_telemetry(req: &HttpRequest, result: &WafInspectionResult) -> WafTelemetry {
    return waf_telemetry_create(req, result, 0);
}

pub fn shim_marker_waf_pcre2() -> Result[Bool, String] {
    return waf_pcre2_regex_match(".*", "text");
}

pub fn shim_marker_waf_tls_decrypt(sys: &SysCap) -> Result[HttpRequest, String] {
    return waf_tls_decrypt_and_inspect_stream(sys, "key", "packet");
}

pub fn shim_marker_waf_xdp(sys: &SysCap) -> Result[Int, String] {
    return waf_attach_xdp_bpf_filter(sys, "eth0", "OWASP_TOP10");
}

pub fn shim_marker_waf_ml(sys: &SysCap, req: &HttpRequest) -> Result[Int, String] {
    return waf_ml_anomaly_score_inference(sys, "/models/waf.onnx", req);
}

pub fn shim_marker_waf_rate_limit(sys: &SysCap) -> Result[Int, String] {
    return waf_distributed_rate_limit_redis_sync(sys, "redis://localhost", "1.2.3.4", 60);
}

pub type SysCap = struct {};


pub fn __dummy_std_src_ooda_sec_net_waf_oo() -> Int {
    return 0;
}
