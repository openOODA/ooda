// # JWT Re-export Shim
//
// Logline: Re-export shim for JWT submodules; forwards config, validation rules, and engine constructors.
//
// Setup: Imports jwt_token_config, jwt_verify, and jwt_stubs. CWD must be ooda/.
//
// Beats:
//   1. shim_marker_str_eq: forward jwt_str_eq.
//   2. shim_marker_str_starts_with: forward jwt_str_starts_with.
//   3. shim_marker_header_default: forward jwt_header_default.
//   4. shim_marker_header_create: forward jwt_header_create.
//
// residual: shim only; crypto verify is process_exit in jwt_stubs.

// The original 865-line jwt.oo was split at functional seams
// into 7 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// Import only leaf modules. Re-importing types/util/header_payload/engine
// alongside them can trigger oodac slist_get OOB or ambient List quota.
//
// HONESTY: Header/payload/claim validation and config plumbing are real
// (string/time checks). Cryptographic JWT ops — sign/verify/decode,
// Base64URL, HS256/RS256/ES256 — live in jwt_stubs.oo and are fail-closed
// process_exit(1) until HMAC/RSA/ECDSA + byte-array builtins land.
// Do not greenwash: a passing claims check is NOT a verified signature.
// Coordinate crypto primitive work with sec/crypto (DE1).

import "./jwt_token_config.oo";
import "./jwt_verify.oo";
import "./jwt_stubs.oo";

pub fn shim_marker_str_eq() -> Bool {
    return jwt_str_eq("a", "a");
}

pub fn shim_marker_str_starts_with() -> Bool {
    return jwt_str_starts_with("abc", "ab");
}

pub fn shim_marker_header_default() -> JwtHeader {
    return jwt_header_default();
}

pub fn shim_marker_header_create() -> Result[JwtHeader, String] {
    return jwt_header_create("HS256", "kid1");
}

pub fn shim_marker_header_validate(h: JwtHeader) -> Bool {
    return jwt_header_validate(h);
}

pub fn shim_marker_payload_default() -> JwtPayload {
    return jwt_payload_default();
}

pub fn shim_marker_payload_create() -> Result[JwtPayload, String] {
    return jwt_payload_create("sub", "iss", "aud", 1000, 3600, "jti-1");
}

pub fn shim_marker_payload_has_role(p: JwtPayload) -> Bool {
    return jwt_payload_has_role(p, "admin");
}

pub fn shim_marker_token_create(h: JwtHeader, p: JwtPayload) -> Result[JwtToken, String] {
    return jwt_token_create(h, p, "raw.token.sig", "sig");
}

pub fn shim_marker_token_is_valid(t: JwtToken, c: JwtConfig) -> Bool {
    return jwt_token_is_valid(t, 1000, c);
}

pub fn shim_marker_config_init() -> Result[JwtConfig, String] {
    return jwt_config_init("secret_key_pad", "HS256", "iss", "aud", 3600);
}

pub fn shim_marker_rules_default() -> JwtValidationRules {
    return jwt_validation_rules_default();
}

pub fn shim_marker_engine_init(c: JwtConfig, r: JwtValidationRules) -> JwtEngine {
    return jwt_engine_init("eng-1", c, r);
}

pub fn shim_marker_engine_halt(e: JwtEngine) -> JwtEngine {
    return jwt_engine_halt(e);
}

pub fn shim_marker_verify_claims(p: JwtPayload, r: JwtValidationRules) -> Result[Bool, String] {
    return jwt_verify_payload_claims(p, r, 1000);
}

pub fn shim_marker_evaluate(sys: &SysCap, e: JwtEngine, t: JwtToken) -> Result[JwtVerificationResult, String] {
    return jwt_engine_evaluate_token(sys, e, t, 1000);
}

pub fn shim_marker_sign(c: JwtConfig, p: JwtPayload) -> Result[JwtToken, String] {
    return jwt_sign(c, p);
}

pub fn shim_marker_decode() -> Result[JwtToken, String] {
    return jwt_decode("a.b.c");
}

pub fn shim_marker_b64_encode() -> String {
    return jwt_base64url_encode("data");
}

pub fn shim_marker_rs256(sys: &SysCap, h: JwtHeader, p: JwtPayload) -> Result[String, String] {
    return jwt_sign_rs256(sys, h, p, "pem");
}

pub fn shim_marker_es256(sys: &SysCap, h: JwtHeader, p: JwtPayload) -> Result[String, String] {
    return jwt_sign_es256(sys, h, p, "pem");
}

pub type SysCap = struct {};


pub fn __dummy_std_src_ooda_sec_net_jwt_oo() -> Int {
    return 0;
}
