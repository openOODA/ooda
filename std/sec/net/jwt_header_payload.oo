import "./jwt_header.oo";
import "./jwt_payload.oo";

pub fn shim_marker_jwt_header_default() -> JwtHeader {
    return jwt_header_default();
}

pub fn shim_marker_jwt_header_validate(h: JwtHeader) -> Bool {
    return jwt_header_validate(h);
}

pub fn shim_marker_jwt_payload_default() -> JwtPayload {
    return jwt_payload_default();
}

pub fn shim_marker_jwt_payload_create() -> Result[JwtPayload, String] {
    return jwt_payload_create("sub", "iss", "aud", 1000, 3600, "jti");
}

pub fn shim_marker_jwt_payload_has_role(p: JwtPayload) -> Bool {
    return jwt_payload_has_role(p, "admin");
}

