// # JWT Claims Payload Management & Validation
//
// Logline: Implements JWT payload constructors, role and custom claim manipulations, and time-bound validation.
//
// Setup: Imports jwt_types.oo and jwt_util.oo for claim and expiry validation.
//
// Beats:
//   1. Construct default and initialized JwtPayload structures with TTL.
//   2. Append and query user roles and custom key-value claims.
//   3. Validate payload expiration (exp) and not-before (nbf) time bounds with clock skew.

import "./jwt_types.oo";
import "./jwt_util.oo";

pub fn jwt_payload_default() -> JwtPayload {
    let empty_roles: List[String] = list_new();
    let empty_keys: List[String] = list_new();
    let empty_vals: List[String] = list_new();
    return JwtPayload {
        sub: "",
        iss: "",
        aud: "",
        exp: 0,
        nbf: 0,
        iat: 0,
        jti: "",
        roles: empty_roles,
        custom_claim_keys: empty_keys,
        custom_claim_vals: empty_vals,
        is_valid: false,
    };
}

pub fn jwt_payload_create(
    sub: String,
    iss: String,
    aud: String,
    iat: Int,
    ttl: Int,
    jti: String
) -> Result[JwtPayload, String] {
    let sub_len: Int = sub.len();
    if sub_len == 0 {
        return Err("INVALID_PAYLOAD: Subject (sub) cannot be empty");
    }
    let iss_len: Int = iss.len();
    if iss_len == 0 {
        return Err("INVALID_PAYLOAD: Issuer (iss) cannot be empty");
    }
    if ttl <= 0 {
        return Err("INVALID_TTL: Time-to-live must be positive");
    }

    let exp_time: Int = iat + ttl;
    let empty_roles: List[String] = list_new();
    let empty_keys: List[String] = list_new();
    let empty_vals: List[String] = list_new();

    let payload = JwtPayload {
        sub: sub,
        iss: iss,
        aud: aud,
        exp: exp_time,
        nbf: iat,
        iat: iat,
        jti: jti,
        roles: empty_roles,
        custom_claim_keys: empty_keys,
        custom_claim_vals: empty_vals,
        is_valid: true,
    };
    return Ok(payload);
}

pub fn jwt_payload_add_role(payload: JwtPayload, role: String) -> JwtPayload {
    let cur_roles: List[String] = payload.roles;
    let new_roles: List[String] = list_push(cur_roles, role);
    return JwtPayload {
        sub: payload.sub,
        iss: payload.iss,
        aud: payload.aud,
        exp: payload.exp,
        nbf: payload.nbf,
        iat: payload.iat,
        jti: payload.jti,
        roles: new_roles,
        custom_claim_keys: payload.custom_claim_keys,
        custom_claim_vals: payload.custom_claim_vals,
        is_valid: payload.is_valid,
    };
}

pub fn jwt_payload_add_custom_claim(payload: JwtPayload, key: String, val: String) -> JwtPayload {
    let cur_keys: List[String] = payload.custom_claim_keys;
    let cur_vals: List[String] = payload.custom_claim_vals;
    let new_keys: List[String] = list_push(cur_keys, key);
    let new_vals: List[String] = list_push(cur_vals, val);
    return JwtPayload {
        sub: payload.sub,
        iss: payload.iss,
        aud: payload.aud,
        exp: payload.exp,
        nbf: payload.nbf,
        iat: payload.iat,
        jti: payload.jti,
        roles: payload.roles,
        custom_claim_keys: new_keys,
        custom_claim_vals: new_vals,
        is_valid: payload.is_valid,
    };
}

pub fn jwt_payload_has_role(payload: JwtPayload, target_role: String) -> Bool {
    let roles_list: List[String] = payload.roles;
    let count: Int = list_len(roles_list);
    let mut idx: Int = 0;
    while idx < count {
        let r_item: String = list_get(roles_list, idx);
        let match_r: Bool = jwt_str_eq(r_item, target_role);
        if match_r {
            return true;
        }
        idx = idx + 1;
    }
    return false;
}

pub fn jwt_payload_get_custom_claim(payload: JwtPayload, key: String) -> Result[String, String] {
    let keys_list: List[String] = payload.custom_claim_keys;
    let vals_list: List[String] = payload.custom_claim_vals;
    let count: Int = list_len(keys_list);
    let mut idx: Int = 0;
    while idx < count {
        let k_item: String = list_get(keys_list, idx);
        let match_k: Bool = jwt_str_eq(k_item, key);
        if match_k {
            let v_item: String = list_get(vals_list, idx);
            return Ok(v_item);
        }
        idx = idx + 1;
    }
    return Err("CLAIM_NOT_FOUND");
}

pub fn jwt_payload_validate(payload: JwtPayload, current_time: Int, clock_skew: Int) -> Bool {
    let is_v: Bool = payload.is_valid;
    if is_v == false {
        return false;
    }
    let sub: String = payload.sub;
    let sub_len: Int = sub.len();
    if sub_len == 0 {
        return false;
    }
    let exp: Int = payload.exp;
    let exp_bound: Int = exp + clock_skew;
    if current_time >= exp_bound {
        return false;
    }
    let nbf: Int = payload.nbf;
    let nbf_bound: Int = nbf - clock_skew;
    if current_time < nbf_bound {
        return false;
    }
    return true;
}

pub fn __dummy_std_src_ooda_sec_net_jwt_payload_oo() -> Int {
    return 0;
}
