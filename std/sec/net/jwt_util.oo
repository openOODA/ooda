// # JWT Helper Utilities
//
// Logline: Provide byte-equal string comparison, prefix check, base64url placeholder, and json whitespace trim.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. jwt_str_eq: byte-equal String comparison.
//   2. jwt_str_starts_with: prefix-byte compare String s against prefix.
//   3. jwt_base64url_placeholder: pass-through stub for Base64URL.
//   4. jwt_trim_whitespace: strip leading and trailing whitespace.
//
// residual: crypto helpers live in jwt_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required where applicable.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

// -------------------------------------------------------------------
// Helper Functions & Utilities
// -------------------------------------------------------------------

pub fn jwt_str_eq(s1: String, s2: String) -> Bool {
    let s1_len: Int = s1.len();
    let s2_len: Int = s2.len();
    if s1_len != s2_len {
        return false;
    }
    let mut idx: Int = 0;
    while idx < s1_len {
        let b1: Int = byte_at(s1, idx);
        let b2: Int = byte_at(s2, idx);
        if b1 != b2 {
            return false;
        }
        idx = idx + 1;
    }
    return true;
}

pub fn jwt_str_starts_with(s: String, prefix: String) -> Bool {
    let s_len: Int = s.len();
    let p_len: Int = prefix.len();
    if s_len < p_len {
        return false;
    }
    let mut idx: Int = 0;
    while idx < p_len {
        let b1: Int = byte_at(s, idx);
        let b2: Int = byte_at(prefix, idx);
        if b1 != b2 {
            return false;
        }
        idx = idx + 1;
    }
    return true;
}

pub fn jwt_checksum_calculate(raw_bytes: String) -> Int {
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < raw_len {
        let ch: Int = byte_at(raw_bytes, i);
        let hash_x33: Int = hash * 33;
        hash = hash_x33 + ch;
        i = i + 1;
    }
    return hash;
}

pub fn jwt_bytes_constant_time_eq(s1: String, s2: String) -> Bool {
    let s1_len: Int = s1.len();
    let s2_len: Int = s2.len();
    if s1_len != s2_len {
        return false;
    }
    let mut i: Int = 0;
    let mut diff: Int = 0;
    while i < s1_len {
        let b1: Int = byte_at(s1, i);
        let b2: Int = byte_at(s2, i);
        if b1 != b2 {
            diff = diff + 1;
        }
        i = i + 1;
    }
    return diff == 0;
}

