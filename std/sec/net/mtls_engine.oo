// ===================================================================
// openOODA Standard Library — ooda::sec::net::mtls_engine
// mTLS policy & engine ops (split from mtls.oo, M172)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects.
// CAP-G6: preferred &TcpCap for TLS/TCP session effects; &NetCap still works via supersede.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

import "./mtls_types.oo";
import "./mtls_cert.oo";
import "./mtls_ops.oo";

// -------------------------------------------------------------------
// MtlsSecurityPolicy Operations
// -------------------------------------------------------------------

pub fn mtls_policy_init(
    policy_id: String,
    min_tls_version: String,
    mandatory_client_auth: Bool,
    max_depth: Int,
    fail_closed: Bool
) -> MtlsSecurityPolicy {
    let empty_sans: List[String] = [];
    return MtlsSecurityPolicy {
        policy_id: policy_id,
        min_tls_version: min_tls_version,
        mandatory_client_auth: mandatory_client_auth,
        require_san_match: false,
        max_cert_chain_depth: max_depth,
        allowed_sans: empty_sans,
        revocation_check_strict: true,
        fail_closed: fail_closed,
        is_active: true,
    };
}

pub fn mtls_policy_add_allowed_san(policy: MtlsSecurityPolicy, san: String) -> MtlsSecurityPolicy {
    let cur_sans: List[String] = policy.allowed_sans;
    let new_sans: List[String] = list_push(cur_sans, san);
    return MtlsSecurityPolicy {
        policy_id: policy.policy_id,
        min_tls_version: policy.min_tls_version,
        mandatory_client_auth: policy.mandatory_client_auth,
        require_san_match: policy.require_san_match,
        max_cert_chain_depth: policy.max_cert_chain_depth,
        allowed_sans: new_sans,
        revocation_check_strict: policy.revocation_check_strict,
        fail_closed: policy.fail_closed,
        is_active: policy.is_active,
    };
}

pub fn mtls_policy_evaluate_peer(
    policy_ref: &MtlsSecurityPolicy,
    peer_ref: &PeerIdentity
) -> Result[Bool, String] {
    let is_act: Bool = policy_ref.is_active;
    if is_act == false {
        return Err("POLICY_INACTIVE: mTLS security policy is inactive");
    }
    let mand: Bool = policy_ref.mandatory_client_auth;
    if mand {
        let auth: Bool = peer_ref.is_authenticated;
        if auth == false {
            return Err("UNAUTHENTICATED_PEER: Mandatory client authentication failed");
        }
    }

    let allowed: List[String] = policy_ref.allowed_sans;
    let allowed_count: Int = list_len(allowed);
    if allowed_count > 0 {
        let peer_sans: List[String] = peer_ref.san_domains;
        let p_count: Int = list_len(peer_sans);
        let peer_cn: String = peer_ref.common_name;
        let mut matched: Bool = false;
        let mut i: Int = 0;
        while i < allowed_count {
            let target_san: String = list_get(allowed, i);
            let mut j: Int = 0;
            while j < p_count {
                let p_san: String = list_get(peer_sans, j);
                if str_eq(target_san, p_san) {
                    matched = true;
                }
                j = j + 1;
            }
            if str_eq(target_san, peer_cn) {
                matched = true;
            }
            i = i + 1;
        }
        if matched == false {
            return Err("SAN_MISMATCH: Peer domain/SAN not allowed by policy");
        }
    }

    return Ok(true);
}

// -------------------------------------------------------------------
// MtlsEngine Operations
// -------------------------------------------------------------------

pub fn mtls_engine_init(engine_id: String, policy: MtlsSecurityPolicy) -> MtlsEngine {
    let empty_sessions: List[MtlsSession] = [];
    let empty_revoked: List[String] = [];
    return MtlsEngine {
        engine_id: engine_id,
        policy: policy,
        active_sessions: empty_sessions,
        revoked_cert_serials: empty_revoked,
        total_handshakes: 0,
        successful_handshakes: 0,
        failed_handshakes: 0,
        system_halted: false,
    };
}

pub fn mtls_engine_is_serial_revoked(eng_ref: &MtlsEngine, serial: String) -> Bool {
    let revoked: List[String] = eng_ref.revoked_cert_serials;
    let count: Int = list_len(revoked);
    let mut i: Int = 0;
    while i < count {
        let r_serial: String = list_get(revoked, i);
        if str_eq(r_serial, serial) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn mtls_engine_revoke_serial(mut_engine: &mut MtlsEngine, serial: String) -> Bool {
    if mut_engine.system_halted {
        return false;
    }
    let cur_rev: List[String] = mut_engine.revoked_cert_serials;
    let new_rev: List[String] = list_push(cur_rev, serial);
    mut_engine.revoked_cert_serials = new_rev;
    return true;
}

pub fn mtls_engine_evaluate_handshake(
    tcp: &TcpCap,
    mut_engine: &mut MtlsEngine,
    session_id: String,
    peer_cert_ref: &MtlsCertificate,
    chain_ref: &CertificateChain,
    current_time: Int
) -> Result[MtlsHandshakeResult, String] {
    // CAP-G6: preferred &TcpCap (TLS/TCP session); &NetCap still works via supersede.
    // HONESTY (T5 residual): evaluate_* is policy/chain/revocation only.
    // Crypto/TLS gates (mtls_parse_x509_der_asn1, mtls_perform_socket_handshake_raw)
    // are process_exit fail-closed and are NOT wired here. Soft-success Ok(result)
    // is NOT a cryptographic/TLS seal — no product tls_connect / ASN.1 path.
    let halted: Bool = mut_engine.system_halted;
    if halted {
        return Err("ENGINE_HALTED: mTLS Engine system is halted");
    }

    let cur_tot: Int = mut_engine.total_handshakes;
    mut_engine.total_handshakes = cur_tot + 1;

    let pol: MtlsSecurityPolicy = mut_engine.policy;
    let pol_ref = &pol;
    let is_act: Bool = pol.is_active;
    if is_act == false {
        let failed_cnt: Int = mut_engine.failed_handshakes;
        mut_engine.failed_handshakes = failed_cnt + 1;
        return Err("POLICY_INACTIVE: Policy is inactive");
    }

    let serial: String = peer_cert_ref.serial_number;
    let subj_cn: String = peer_cert_ref.subject_cn;
    let is_rev: Bool = mtls_engine_is_serial_revoked(mut_engine, serial);
    if is_rev {
        let failed_cnt: Int = mut_engine.failed_handshakes;
        mut_engine.failed_handshakes = failed_cnt + 1;
        if pol.fail_closed {
            mut_engine.system_halted = true;
        }
        return Ok(MtlsHandshakeResult {
            is_successful: false,
            session_id: session_id,
            negotiated_cipher: "NONE",
            peer_common_name: subj_cn,
            handshake_duration_ms: 0,
            error_code: "CERTIFICATE_REVOKED",
        });
    }

    let max_depth: Int = pol.max_cert_chain_depth;
    let chain_res: Result[Bool, String] = certificate_chain_verify(chain_ref, current_time, max_depth);
    let chain_ok: Bool = match chain_res {
        Ok(v) => v,
        Err(e) => false,
    };

    if chain_ok == false {
        let failed_cnt: Int = mut_engine.failed_handshakes;
        mut_engine.failed_handshakes = failed_cnt + 1;
        if pol.fail_closed {
            mut_engine.system_halted = true;
        }
        return Ok(MtlsHandshakeResult {
            is_successful: false,
            session_id: session_id,
            negotiated_cipher: "NONE",
            peer_common_name: subj_cn,
            handshake_duration_ms: 0,
            error_code: "CERT_CHAIN_VERIFICATION_FAILED",
        });
    }

    let peer_id: PeerIdentity = peer_identity_create(peer_cert_ref, 100);
    let peer_ref = &peer_id;
    let pol_eval: Result[Bool, String] = mtls_policy_evaluate_peer(pol_ref, peer_ref);
    let pol_ok: Bool = match pol_eval {
        Ok(v) => v,
        Err(e) => false,
    };

    if pol_ok == false {
        let failed_cnt: Int = mut_engine.failed_handshakes;
        mut_engine.failed_handshakes = failed_cnt + 1;
        if pol.fail_closed {
            mut_engine.system_halted = true;
        }
        return Ok(MtlsHandshakeResult {
            is_successful: false,
            session_id: session_id,
            negotiated_cipher: "NONE",
            peer_common_name: subj_cn,
            handshake_duration_ms: 0,
            error_code: "PEER_POLICY_REJECTED",
        });
    }

    let succ_cnt: Int = mut_engine.successful_handshakes;
    mut_engine.successful_handshakes = succ_cnt + 1;
    // HONESTY (T5): policy-only soft-success — not crypto/TLS verified.
    return Ok(MtlsHandshakeResult {
        is_successful: true,
        session_id: session_id,
        negotiated_cipher: "TLS_AES_256_GCM_SHA384",
        peer_common_name: subj_cn,
        handshake_duration_ms: 12,
        error_code: "POLICY_OK_NO_TLS_IO",
    });
}

pub fn mtls_engine_halt(mut_engine: &mut MtlsEngine) {
    mut_engine.system_halted = true;
}
