// # WAF Engine Config & Management
//
// Logline: Build WafEngineConfig defaults, detect-only mode, and create WafEngine state.
//
// Setup: Imports waf_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. waf_config_default: build strict ENFORCE config with all protections on.
//   2. waf_config_detection_only: build DETECTION_ONLY config.
//   3. waf_engine_init: register config and empty stats counters.
//   4. waf_engine_halt: flip system_halted to fail-closed.
//
// residual: TLS decrypt-and-inspect is process_exit in waf_stubs.

// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

import "./waf_types.oo";

// -------------------------------------------------------------------
// WAF Engine Config & Management
// -------------------------------------------------------------------

pub fn waf_config_default() -> WafEngineConfig {
    return WafEngineConfig {
        engine_name: "openOODA-WAF",
        mode: "ENFORCE",
        max_body_bytes: 1048576,
        block_status_code: 403,
        enable_sqli_protection: true,
        enable_xss_protection: true,
        enable_rce_protection: true,
        enable_lfi_protection: true,
        rate_limit_requests_per_sec: 100,
        fail_closed: true,
    };
}

pub fn waf_config_detection_only() -> WafEngineConfig {
    return WafEngineConfig {
        engine_name: "openOODA-WAF",
        mode: "DETECTION_ONLY",
        max_body_bytes: 1048576,
        block_status_code: 403,
        enable_sqli_protection: true,
        enable_xss_protection: true,
        enable_rce_protection: true,
        enable_lfi_protection: true,
        rate_limit_requests_per_sec: 100,
        fail_closed: true,
    };
}

pub fn waf_engine_init(config: WafEngineConfig) -> WafEngine {
    let empty_sets: List[WafRuleSet] = list_new();
    let empty_custom: List[WafRule] = list_new();
    let empty_blocked: List[String] = list_new();
    let empty_allowed: List[String] = list_new();

    return WafEngine {
        config: config,
        rule_sets: empty_sets,
        custom_rules: empty_custom,
        blocked_ips: empty_blocked,
        allowed_ips: empty_allowed,
        total_inspected: 0,
        total_blocked: 0,
        total_allowed: 0,
        system_halted: false,
    };
}

pub fn waf_engine_add_ruleset(engine: WafEngine, ruleset: WafRuleSet) -> WafEngine {
    let cur_sets: List[WafRuleSet] = engine.rule_sets;
    let new_sets: List[WafRuleSet] = list_push(cur_sets, ruleset);
    return WafEngine {
        config: engine.config,
        rule_sets: new_sets,
        custom_rules: engine.custom_rules,
        blocked_ips: engine.blocked_ips,
        allowed_ips: engine.allowed_ips,
        total_inspected: engine.total_inspected,
        total_blocked: engine.total_blocked,
        total_allowed: engine.total_allowed,
        system_halted: engine.system_halted,
    };
}

pub fn waf_engine_add_custom_rule(engine: WafEngine, rule: WafRule) -> WafEngine {
    let cur_custom: List[WafRule] = engine.custom_rules;
    let new_custom: List[WafRule] = list_push(cur_custom, rule);
    return WafEngine {
        config: engine.config,
        rule_sets: engine.rule_sets,
        custom_rules: new_custom,
        blocked_ips: engine.blocked_ips,
        allowed_ips: engine.allowed_ips,
        total_inspected: engine.total_inspected,
        total_blocked: engine.total_blocked,
        total_allowed: engine.total_allowed,
        system_halted: engine.system_halted,
    };
}

pub fn waf_engine_block_ip(engine: WafEngine, ip: String) -> WafEngine {
    let cur_blocked: List[String] = engine.blocked_ips;
    let new_blocked: List[String] = list_push(cur_blocked, ip);
    return WafEngine {
        config: engine.config,
        rule_sets: engine.rule_sets,
        custom_rules: engine.custom_rules,
        blocked_ips: new_blocked,
        allowed_ips: engine.allowed_ips,
        total_inspected: engine.total_inspected,
        total_blocked: engine.total_blocked,
        total_allowed: engine.total_allowed,
        system_halted: engine.system_halted,
    };
}

pub fn waf_engine_allow_ip(engine: WafEngine, ip: String) -> WafEngine {
    let cur_allowed: List[String] = engine.allowed_ips;
    let new_allowed: List[String] = list_push(cur_allowed, ip);
    return WafEngine {
        config: engine.config,
        rule_sets: engine.rule_sets,
        custom_rules: engine.custom_rules,
        blocked_ips: engine.blocked_ips,
        allowed_ips: new_allowed,
        total_inspected: engine.total_inspected,
        total_blocked: engine.total_blocked,
        total_allowed: engine.total_allowed,
        system_halted: engine.system_halted,
    };
}

pub fn waf_engine_halt(engine: WafEngine) -> WafEngine {
    return WafEngine {
        config: engine.config,
        rule_sets: engine.rule_sets,
        custom_rules: engine.custom_rules,
        blocked_ips: engine.blocked_ips,
        allowed_ips: engine.allowed_ips,
        total_inspected: engine.total_inspected,
        total_blocked: engine.total_blocked,
        total_allowed: engine.total_allowed,
        system_halted: true,
    };
}

pub fn waf_engine_ready() -> Int {
    return 1;
}
