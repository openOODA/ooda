// # BFV Codec and Plaintext Encodings
//
// Logline: Encodes and decodes plaintexts and polynomial representations for BFV.
//
// Setup: Imports bfv_types.oo for codec structures.
//
// Beats:
//   1. Encode scalar values and vectors into BFV plaintexts.
//   2. Decode decrypted ciphertexts back to plain text representations.
//   3. Provide batch encoding and decoding utilities.

import "./bfv_types.oo";

pub fn bfv_encoder_init(encoder_id: String, params: BfvParameters) -> BfvEncoder {
    let slots: Int = params.poly_modulus_degree;
    let valid: Bool = params.is_valid;
    return BfvEncoder {
        encoder_id: encoder_id,
        slots: slots,
        params: params,
        is_initialized: valid,
    };
}

pub fn bfv_encode_int(encoder_ref: &BfvEncoder, value: Int) -> BfvPlaintext {
    let p_mod: Int = (encoder_ref).params.plain_modulus;
    let mut val: Int = value;
    if p_mod > 0 {
        val = value % p_mod;
    }
    let p_str: String = val.to_string();
    let enc_id: String = (encoder_ref).encoder_id;
    let enc_init: Bool = (encoder_ref).is_initialized;
    let pid: String = "plain_" + enc_id + "_" + p_str;
    return BfvPlaintext {
        plain_id: pid,
        value: val,
        poly_repr: p_str,
        scale: 1,
        is_ntt_form: false,
        is_valid: enc_init,
    };
}

pub fn bfv_decode_int(encoder_ref: &BfvEncoder, plain_ref: &BfvPlaintext) -> Result[Int, String] {
    let enc_init: Bool = (encoder_ref).is_initialized;
    let plain_valid: Bool = (plain_ref).is_valid;
    let val: Int = (plain_ref).value;

    if enc_init == false {
        return Err("Encoder is not initialized");
    }
    if plain_valid == false {
        return Err("Plaintext is invalid");
    }
    return Ok(val);
}
