// # Double Ratchet types
//
// Logline: ChainKey and MessageHeader definitions for Double Ratchet.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//

type ChainKey = struct {
    index: Int,
    checksum: Int,
    is_valid: Int
};

pub fn ratchet_chain_new(index: Int, checksum: Int, is_valid: Int) -> ChainKey {
    return ChainKey {
        index: index,
        checksum: checksum,
        is_valid: is_valid
    };
}

pub fn ratchet_chain_index(c: ChainKey) -> Int {
    return c.index;
}

type MessageHeader = struct {
    header_id: String,
    dh_pub: String,
    pn: Int,
    n: Int,
    checksum: Int,
    is_valid: Bool
};

type DHKeyPair = struct {
    key_id: String,
    public_key: String,
    private_key: String,
    checksum: Int,
    is_valid: Bool
};

pub fn dh_keypair_new(key_id: String, public_key: String, private_key: String) -> DHKeyPair {
    return DHKeyPair {
        key_id: key_id,
        public_key: public_key,
        private_key: private_key,
        checksum: 0,
        is_valid: true
    };
}

pub fn dh_keypair_create(key_id: String, public_key: String, private_key: String) -> Result[DHKeyPair, String] {
    let kp = DHKeyPair {
        key_id: key_id,
        public_key: public_key,
        private_key: private_key,
        checksum: 0,
        is_valid: true
    };
    return Ok(kp);
}

pub fn dh_keypair_validate(kp: &DHKeyPair) -> Bool {
    return (kp).is_valid;
}

type RatchetState = struct {
    session_id: String,
    dh_self: DHKeyPair,
    dh_remote_pub: String,
    root_key: String,
    send_chain: ChainKey,
    recv_chain: ChainKey,
    n_send: Int,
    n_recv: Int,
    pn: Int,
    skipped_count: Int,
    max_skipped_keys: Int,
    is_alice: Bool,
    is_initialized: Bool,
    is_active: Bool
};
