// # Double Ratchet types
//
// Logline: ChainKey destubbed off List[SkippedMessageKey].
// residual: List[struct] destubbed to Int floor.

type ChainKey = struct {
    index: Int,
    checksum: Int,
    is_valid: Int
};

pub fn ratchet_chain_new(index: Int, checksum: Int, is_valid: Int) -> ChainKey {
    return ChainKey {
        index: index,
        checksum: checksum,
        is_valid: is_valid
    };
}

pub fn ratchet_chain_index(c: ChainKey) -> Int {
    return c.index;
}
