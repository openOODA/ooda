// # Shamir types
//
// Logline: SecretShare destubbed off List[SecretShare].
// residual: List[struct] destubbed to Int floor.

type SecretShare = struct {
    x: Int,
    y_value: Int,
    checksum: Int
};

pub fn shamir_share_new(x: Int, y_value: Int, checksum: Int) -> SecretShare {
    return SecretShare {
        x: x,
        y_value: y_value,
        checksum: checksum
    };
}

pub fn shamir_share_x(s: SecretShare) -> Int {
    return s.x;
}
