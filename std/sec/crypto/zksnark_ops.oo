// # zk-SNARK Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for ZKSNARK.
//
// Setup: Imports zksnark_types.oo for data structure definitions.
//
// Beats:
//   1. Import ZKSNARK types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./zksnark_hash.oo";

pub fn zk_proof_create(
    proof_id: String,
    a_g1: String,
    b_g2: String,
    c_g1: String,
    protocol: String,
    curve: String,
    public_inputs: List[String]
) -> ZkProof {
    let mut valid: Bool = true;
    let a_len: Int = a_g1.len();
    if a_len == 0 { valid = false; }
    let b_len: Int = b_g2.len();
    if b_len == 0 { valid = false; }
    let c_len: Int = c_g1.len();
    if c_len == 0 { valid = false; }

    return ZkProof {
        proof_id: proof_id,
        a_g1: a_g1,
        b_g2: b_g2,
        c_g1: c_g1,
        protocol: protocol,
        curve: curve,
        public_inputs: public_inputs,
        is_valid: valid
    };
}

pub fn verification_key_create(
    vk_id: String,
    alpha_g1: String,
    beta_g2: String,
    gamma_g2: String,
    delta_g2: String,
    ic: List[String],
    protocol: String,
    curve: String,
    num_public_inputs: Int
) -> VerificationKey {
    let mut active: Bool = true;
    let a_len: Int = alpha_g1.len();
    if a_len == 0 { active = false; }
    let b_len: Int = beta_g2.len();
    if b_len == 0 { active = false; }

    return VerificationKey {
        vk_id: vk_id,
        alpha_g1: alpha_g1,
        beta_g2: beta_g2,
        gamma_g2: gamma_g2,
        delta_g2: delta_g2,
        ic: ic,
        protocol: protocol,
        curve: curve,
        num_public_inputs: num_public_inputs,
        is_active: active
    };
}

pub fn proving_key_create(
    pk_id: String,
    vk_id: String,
    circuit_hash: String,
    constraint_count: Int,
    variable_count: Int,
    protocol: String,
    curve: String,
    proving_data: String
) -> ProvingKey {
    let mut ready: Bool = true;
    if constraint_count <= 0 { ready = false; }
    let pd_len: Int = proving_data.len();
    if pd_len == 0 { ready = false; }

    return ProvingKey {
        pk_id: pk_id,
        vk_id: vk_id,
        circuit_hash: circuit_hash,
        constraint_count: constraint_count,
        variable_count: variable_count,
        protocol: protocol,
        curve: curve,
        proving_data: proving_data,
        is_ready: ready
    };
}

pub fn zk_snark_circuit_create(
    circuit_id: String,
    name: String,
    num_constraints: Int,
    num_variables: Int,
    num_inputs: Int
) -> ZkSnarkCircuit {
    let chash_val: Int = zksnark_calculate_string_hash(circuit_id + "_" + name);
    let chash_str: String = chash_val.to_string();

    let mut satisfied: Bool = true;
    if num_constraints <= 0 { satisfied = false; }

    return ZkSnarkCircuit {
        circuit_id: circuit_id,
        name: name,
        num_constraints: num_constraints,
        num_variables: num_variables,
        num_public_inputs: num_inputs,
        num_private_inputs: num_variables - num_inputs,
        circuit_hash: chash_str,
        is_satisfied: satisfied
    };
}

pub fn zk_snark_witness_create(
    witness_id: String,
    circuit_id: String,
    public_signals: List[String],
    secret_signals: List[String]
) -> ZkSnarkWitness {
    let pub_len: Int = list_len(public_signals);
    let sec_len: Int = list_len(secret_signals);
    let tot_len: Int = pub_len + sec_len;

    let mut valid: Bool = true;
    if tot_len == 0 { valid = false; }

    return ZkSnarkWitness {
        witness_id: witness_id,
        circuit_id: circuit_id,
        public_signals: public_signals,
        secret_signals: secret_signals,
        num_signals: tot_len,
        is_valid: valid
    };
}

pub fn zk_snark_policy_init(
    policy_id: String,
    min_bits: Int,
    allowed_curve: String,
    fail_closed: Bool
) -> ZkSnarkPolicy {
    return ZkSnarkPolicy {
        policy_id: policy_id,
        require_trusted_setup: true,
        min_security_bits: min_bits,
        allowed_curve: allowed_curve,
        fail_closed: fail_closed,
        is_active: true
    };
}
