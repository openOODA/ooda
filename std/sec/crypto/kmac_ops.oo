// # KMAC Construction and NIST SP 800-185 Encoding Operations
//
// Logline: Implements NIST SP 800-185 left/right encoding, bytepad framing, and KMAC parameter validators.
//
// Setup: Imports kmac_types.oo for data structure definitions.
//
// Beats:
//   1. Import KMAC data types and structures.
//   2. Implement NIST SP 800-185 integer and string prefix encoding routines.
//   3. Provide constructors and validation rules for keys, configs, and authentication tags.

import "./kmac_types.oo";

// -------------------------------------------------------------------
// NIST SP 800-185 Building Blocks
// -------------------------------------------------------------------

pub fn left_encode(val: Int) -> Result[String, String] {
    if val < 0 {
        return Err("INVALID_LEFT_ENCODE: Value cannot be negative");
    }
    if val == 0 {
        let mut b: List[Int] = bytes_new();
        b = bytes_push(b, 1);
        b = bytes_push(b, 0);
        return Ok(bytes_to_str(b));
    }
    let mut temp: Int = val;
    let mut num_bytes: Int = 0;
    while temp > 0 {
        num_bytes = num_bytes + 1;
        temp = temp / 256;
    }
    let mut raw_bytes: List[Int] = bytes_new();
    let mut shift_idx: Int = num_bytes - 1;
    while shift_idx >= 0 {
        let mut divisor: Int = 1;
        let mut d_count: Int = 0;
        while d_count < shift_idx {
            divisor = divisor * 256;
            d_count = d_count + 1;
        }
        let b_val: Int = (val / divisor) % 256;
        raw_bytes = bytes_push(raw_bytes, b_val);
        shift_idx = shift_idx - 1;
    }
    let mut res: List[Int] = bytes_new();
    res = bytes_push(res, num_bytes);
    let mut i: Int = 0;
    let raw_str: String = bytes_to_str(raw_bytes);
    let raw_len: Int = raw_str.len();
    while i < raw_len {
        let b_elem: Int = byte_at(raw_str, i);
        res = bytes_push(res, b_elem);
        i = i + 1;
    }
    return Ok(bytes_to_str(res));
}

pub fn right_encode(val: Int) -> Result[String, String] {
    if val < 0 {
        return Err("INVALID_RIGHT_ENCODE: Value cannot be negative");
    }
    if val == 0 {
        let mut b: List[Int] = bytes_new();
        b = bytes_push(b, 0);
        b = bytes_push(b, 1);
        return Ok(bytes_to_str(b));
    }
    let mut temp: Int = val;
    let mut num_bytes: Int = 0;
    while temp > 0 {
        num_bytes = num_bytes + 1;
        temp = temp / 256;
    }
    let mut raw_bytes: List[Int] = bytes_new();
    let mut shift_idx: Int = num_bytes - 1;
    while shift_idx >= 0 {
        let mut divisor: Int = 1;
        let mut d_count: Int = 0;
        while d_count < shift_idx {
            divisor = divisor * 256;
            d_count = d_count + 1;
        }
        let b_val: Int = (val / divisor) % 256;
        raw_bytes = bytes_push(raw_bytes, b_val);
        shift_idx = shift_idx - 1;
    }
    let mut res: List[Int] = bytes_new();
    let mut i: Int = 0;
    let raw_str: String = bytes_to_str(raw_bytes);
    let raw_len: Int = raw_str.len();
    while i < raw_len {
        let b_elem: Int = byte_at(raw_str, i);
        res = bytes_push(res, b_elem);
        i = i + 1;
    }
    res = bytes_push(res, num_bytes);
    return Ok(bytes_to_str(res));
}

pub fn encode_string(s: String) -> Result[String, String] {
    let s_len_bits: Int = s.len() * 8;
    let prefix_res: Result[String, String] = left_encode(s_len_bits);
    return match prefix_res {
        Ok(prefix) => Ok(prefix + s),
        Err(e) => Err(e),
    };
}

pub fn bytepad(x: String, w: Int) -> Result[String, String] {
    if w <= 0 {
        return Err("INVALID_BYTEPAD_WIDTH: Rate width w must be positive");
    }
    let prefix_res: Result[String, String] = left_encode(w);
    let prefix: String = match prefix_res {
        Ok(p) => p,
        Err(e) => return Err(e),
    };
    let mut z: String = prefix + x;
    let rem: Int = z.len() % w;
    if rem != 0 {
        let pad_len: Int = w - rem;
        let mut pad_buf: List[Int] = bytes_new();
        let mut i: Int = 0;
        while i < pad_len {
            pad_buf = bytes_push(pad_buf, 0);
            i = i + 1;
        }
        z = z + bytes_to_str(pad_buf);
    }
    return Ok(z);
}

// -------------------------------------------------------------------
// Type Constructors & Validation Helpers
// -------------------------------------------------------------------

pub fn kmac_key_create(key_id: String, key_bytes: String) -> Result[KmacKey, String] {
    let k_len: Int = key_bytes.len();
    if k_len == 0 {
        return Err("INVALID_KEY: KMAC key bytes cannot be empty");
    }
    let chk: Int = kmac_checksum(key_bytes);
    return Ok(KmacKey {
        key_id: key_id,
        key_bytes: key_bytes,
        len: k_len,
        checksum: chk,
        is_valid: true,
    });
}

pub fn kmac_key_validate(key: &KmacKey) -> Bool {
    if (key).is_valid == false {
        return false;
    }
    let raw: String = (key).key_bytes;
    if raw.len() != (key).len {
        return false;
    }
    return (key).checksum == kmac_checksum(raw);
}

pub fn kmac_config_128(config_id: String, output_bits: Int, custom_str: String) -> Result[KmacConfig, String] {
    if output_bits <= 0 {
        return Err("INVALID_CONFIG: Output bit length must be greater than zero");
    }
    return Ok(KmacConfig {
        config_id: config_id,
        variant: "KMAC128",
        rate: 1344,
        capacity: 256,
        output_bits: output_bits,
        custom_str: custom_str,
        fail_closed: true,
        is_valid: true,
    });
}

pub fn kmac_config_256(config_id: String, output_bits: Int, custom_str: String) -> Result[KmacConfig, String] {
    if output_bits <= 0 {
        return Err("INVALID_CONFIG: Output bit length must be greater than zero");
    }
    return Ok(KmacConfig {
        config_id: config_id,
        variant: "KMAC256",
        rate: 1088,
        capacity: 512,
        output_bits: output_bits,
        custom_str: custom_str,
        fail_closed: true,
        is_valid: true,
    });
}

pub fn kmac_config_validate(config: &KmacConfig) -> Bool {
    if (config).is_valid == false {
        return false;
    }
    if (config).rate + (config).capacity != 1600 {
        return false;
    }
    return (config).output_bits > 0;
}

pub fn kmac_tag_create(tag_id: String, algorithm: String, raw_bytes: String) -> Result[KmacTag, String] {
    let raw_len: Int = raw_bytes.len();
    if raw_len == 0 {
        return Err("INVALID_TAG: Tag bytes cannot be empty");
    }
    let hex_val: String = kmac_hex_encode(raw_bytes);
    let chk: Int = kmac_checksum(raw_bytes);
    return Ok(KmacTag {
        tag_id: tag_id,
        algorithm: algorithm,
        raw_bytes: raw_bytes,
        hex_str: hex_val,
        bit_length: raw_len * 8,
        byte_length: raw_len,
        checksum: chk,
        is_valid: true,
    });
}

pub fn kmac_tag_validate(tag: &KmacTag) -> Bool {
    if (tag).is_valid == false {
        return false;
    }
    let raw: String = (tag).raw_bytes;
    if raw.len() != (tag).byte_length {
        return false;
    }
    return (tag).checksum == kmac_checksum(raw);
}
