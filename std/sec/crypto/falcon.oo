// # Falcon Facade
//
// Logline: Re-exports Falcon data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import Falcon companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 6 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./falcon_stubs.oo";

pub fn shim_marker_degree() -> Int {
    return falcon_512_degree();
}

pub fn shim_marker_params() -> FalconParams {
    return falcon_params_init(512);
}

pub fn shim_marker_poly_zero() -> FalconPolynomial {
    return falcon_polynomial_zero(8);
}

pub fn shim_marker_checksum() -> Int {
    return falcon_checksum_string("abc");
}

pub fn shim_marker_batch_init() -> FalconBatchVerifier {
    return falcon_batch_verifier_init("B1", 512);
}

pub fn shim_marker_stubs_probe() -> Int {
    return falcon_stubs_probe();
}
