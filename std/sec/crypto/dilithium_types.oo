// # Dilithium Post-Quantum Signature Types
//
// Logline: Parameter definitions, key pairs, signature records, security policies, and engine types for Dilithium.
//
// Setup: Pure data structures and parameter set initializers for NIST ML-DSA / CRYSTALS-Dilithium.
//
// Beats:
//   1. Declare Dilithium security parameter structures for modes 2, 3, and 5.
//   2. Define keypair, signature, and verification result schemas.
//   3. Implement parameter set initializer and validity checkers.
//   4. Define security policy and engine state structures with mode enforcement helpers.

pub type DilithiumParams = struct {
    mode: Int,
    k: Int,
    l: Int,
    eta: Int,
    tau: Int,
    beta: Int,
    gamma1: Int,
    gamma2: Int,
    omega: Int,
    public_key_bytes: Int,
    secret_key_bytes: Int,
    signature_bytes: Int,
    name: String,
    is_valid: Bool
};

pub type DilithiumKeyPair = struct {
    key_id: String,
    public_key: String,
    secret_key: String,
    params: DilithiumParams,
    created_at: Int,
    is_active: Bool
};

pub type DilithiumSignature = struct {
    signature_id: String,
    key_id: String,
    sig_bytes: String,
    message_digest: String,
    params_mode: Int,
    is_valid: Bool,
    timestamp: Int
};

pub type DilithiumSecurityPolicy = struct {
    min_mode: Int,
    require_hardware_cap: Bool,
    fail_closed: Bool,
    allow_deprecated_modes: Bool,
    is_active: Bool
};

pub type DilithiumVerificationResult = struct {
    is_valid: Bool,
    key_id: String,
    message_digest: String,
    error_code: String,
    verification_time: Int
};

pub type DilithiumEngine = struct {
    engine_id: String,
    policy: DilithiumSecurityPolicy,
    key_pairs: List[DilithiumKeyPair],
    signed_count: Int,
    verified_count: Int,
    rejected_count: Int,
    strict_mode: Bool,
    system_halted: Bool
};

pub fn dilithium_params_init(mode: Int) -> DilithiumParams {
    if mode == 2 {
        return DilithiumParams {
            mode: 2,
            k: 4,
            l: 4,
            eta: 2,
            tau: 39,
            beta: 78,
            gamma1: 131072,
            gamma2: 95232,
            omega: 80,
            public_key_bytes: 1312,
            secret_key_bytes: 2528,
            signature_bytes: 2420,
            name: "Dilithium2",
            is_valid: true
        };
    }
    if mode == 3 {
        return DilithiumParams {
            mode: 3,
            k: 6,
            l: 5,
            eta: 4,
            tau: 49,
            beta: 196,
            gamma1: 524288,
            gamma2: 261888,
            omega: 55,
            public_key_bytes: 1952,
            secret_key_bytes: 4000,
            signature_bytes: 3293,
            name: "Dilithium3",
            is_valid: true
        };
    }
    if mode == 5 {
        return DilithiumParams {
            mode: 5,
            k: 8,
            l: 7,
            eta: 2,
            tau: 60,
            beta: 120,
            gamma1: 524288,
            gamma2: 261888,
            omega: 75,
            public_key_bytes: 2592,
            secret_key_bytes: 4864,
            signature_bytes: 4595,
            name: "Dilithium5",
            is_valid: true
        };
    }

    return DilithiumParams {
        mode: 0,
        k: 0,
        l: 0,
        eta: 0,
        tau: 0,
        beta: 0,
        gamma1: 0,
        gamma2: 0,
        omega: 0,
        public_key_bytes: 0,
        secret_key_bytes: 0,
        signature_bytes: 0,
        name: "INVALID",
        is_valid: false
    };
}

pub fn dilithium_params_is_valid(params: DilithiumParams) -> Bool {
    return params.is_valid;
}

pub fn dilithium_policy_init(
    min_mode: Int,
    require_hardware_cap: Bool,
    fail_closed: Bool
) -> DilithiumSecurityPolicy {
    return DilithiumSecurityPolicy {
        min_mode: min_mode,
        require_hardware_cap: require_hardware_cap,
        fail_closed: fail_closed,
        allow_deprecated_modes: false,
        is_active: true
    };
}

pub fn dilithium_policy_allows_mode(policy: &DilithiumSecurityPolicy, mode: Int) -> Bool {
    if (policy).is_active == false {
        return false;
    }
    let min_m: Int = (policy).min_mode;
    if mode < min_m {
        return false;
    }
    return true;
}
