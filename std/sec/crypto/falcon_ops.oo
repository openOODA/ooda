// # Falcon Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for FALCON.
//
// Setup: Imports falcon_types.oo for data structure definitions.
//
// Beats:
//   1. Import FALCON types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./falcon_poly.oo";

pub fn falcon_polynomial_schoolbook_mul(p1: FalconPolynomial, p2: FalconPolynomial, modulus: Int) -> FalconPolynomial {
    let deg: Int = (p1).degree;
    let mut res: FalconPolynomial = falcon_polynomial_zero(deg);
    let c1: List[Int] = (p1).coefficients;
    let c2: List[Int] = (p2).coefficients;
    let mut i: Int = 0;
    while i < deg {
        let a: Int = list_get(c1, i);
        if a != 0 {
            let mut j: Int = 0;
            while j < deg {
                let b: Int = list_get(c2, j);
                if b != 0 {
                    let prod: Int = a * b;
                    let idx: Int = i + j;
                    if idx < deg {
                        let current: Int = falcon_polynomial_get(res, idx);
                        let next_val: Int = (current + prod) % modulus;
                        res = falcon_polynomial_set(res, idx, next_val);
                    } else {
                        let target_idx: Int = idx - deg;
                        let current: Int = falcon_polynomial_get(res, target_idx);
                        let mut next_val: Int = (current - prod) % modulus;
                        if next_val < 0 {
                            next_val = next_val + modulus;
                        }
                        res = falcon_polynomial_set(res, target_idx, next_val);
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return res;
}

pub fn falcon_polynomial_squared_norm(p: FalconPolynomial) -> Int {
    let coeffs: List[Int] = (p).coefficients;
    let len: Int = list_len(coeffs);
    let mut i: Int = 0;
    let mut norm: Int = 0;
    while i < len {
        let c: Int = list_get(coeffs, i);
        norm = norm + (c * c);
        i = i + 1;
    }
    return norm;
}

pub fn falcon_polynomial_centered_squared_norm(p: FalconPolynomial, modulus: Int) -> Int {
    let coeffs: List[Int] = (p).coefficients;
    let len: Int = list_len(coeffs);
    let mut i: Int = 0;
    let mut norm: Int = 0;
    while i < len {
        let c: Int = list_get(coeffs, i);
        let centered: Int = falcon_polynomial_center_mod(c, modulus);
        norm = norm + (centered * centered);
        i = i + 1;
    }
    return norm;
}

// -------------------------------------------------------------------
// Parameter Initialization & Checksums
// -------------------------------------------------------------------

pub fn falcon_params_init(degree: Int) -> FalconParams {
    if degree == 512 {
        return FalconParams {
            degree: 512,
            modulus: 12289,
            beta_sq: 34034724,
            salt_bytes: 40,
            sig_bytes: 666,
            pk_bytes: 897,
            is_valid: true
        };
    }
    if degree == 1024 {
        return FalconParams {
            degree: 1024,
            modulus: 12289,
            beta_sq: 70265242,
            salt_bytes: 40,
            sig_bytes: 1280,
            pk_bytes: 1793,
            is_valid: true
        };
    }
    return FalconParams {
        degree: degree,
        modulus: 12289,
        beta_sq: 0,
        salt_bytes: 40,
        sig_bytes: 0,
        pk_bytes: 0,
        is_valid: false
    };
}

pub fn falcon_checksum_string(str_val: String) -> Int {
    let len: Int = str_val.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < len {
        let ch: Int = byte_at(str_val, i);
        hash = (hash * 33) + ch;
        i = i + 1;
    }
    return hash;
}

pub fn falcon_checksum_poly(p: FalconPolynomial) -> Int {
    let coeffs: List[Int] = (p).coefficients;
    let len: Int = list_len(coeffs);
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < len {
        let val: Int = list_get(coeffs, i);
        hash = (hash * 33) + val;
        i = i + 1;
    }
    return hash;
}
