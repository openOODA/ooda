// # HMAC Facade and Re-Export Shim
//
// Logline: Re-exports RFC 2104 / FIPS 198-1 HMAC types, key/tag constructors, streaming engine, and fail-closed stubs.
//
// Setup: Pure module shim importing types, operations, engine, and stubs companion submodules.
//
// Beats:
//   1. Import HMAC types, operations, engine, and stubs companion modules.
//   2. Provide typed shim markers ensuring monomorphization coverage.
//   3. Execute self-verification suite to validate key creation, tag generation, verification, and streaming updates.

import "./hmac_types.oo";
import "./hmac_ops.oo";
import "./hmac_engine.oo";
import "./hmac_stubs.oo";

pub fn shim_marker_config_default() -> HmacConfig {
    return hmac_config_default();
}

pub fn shim_marker_key_create() -> Result[HmacKey, String] {
    return hmac_key_create("k_shim", "secret_key_bytes_123456789012");
}

pub fn shim_marker_policy_default() -> HmacSecurityPolicy {
    return hmac_security_policy_default();
}

pub fn shim_marker_engine_init() -> HmacEngine {
    let pol: HmacSecurityPolicy = hmac_security_policy_default();
    return hmac_engine_init("eng_shim", pol);
}

verify hmac {
    let key_str: String = "secret_key_12345";
    let msg: String = "The quick brown fox jumps over the lazy dog";

    let k_res: Result[HmacKey, String] = hmac_key_create("KEY001", key_str);
    let key: HmacKey = match k_res {
        Ok(k) => k,
        Err(e) => HmacKey { key_id: "", raw_bytes: "", len: 0, checksum: 0, is_valid: false },
    };
    assert_eq!(key.is_valid, true);
    assert_eq!(hmac_key_validate(&key), true);

    let hex_sig: String = hmac_sha256(key_str, msg);
    assert_eq!(hex_sig.len() > 0, true);

    let tag_res: Result[MacTag, String] = hmac_sha256_bytes(&key, msg);
    let tag: MacTag = match tag_res {
        Ok(t) => t,
        Err(e) => MacTag { tag_id: "", tag_bytes: "", hex_str: "", len: 0, checksum: 0, algorithm: "", is_valid: false },
    };
    assert_eq!(tag.is_valid, true);
    assert_eq!(mac_tag_validate(&tag), true);

    let v_res: HmacVerificationResult = hmac_sha256_verify(&key, msg, &tag);
    assert_eq!(v_res.is_valid, true);
    assert_eq!(v_res.error_code, "OK");

    let cfg: HmacConfig = hmac_config_default();
    assert_eq!(cfg.is_valid, true);

    let ctx_res: Result[HmacCtx, String] = hmac_ctx_init("CTX001", key, cfg);
    let mut ctx: HmacCtx = match ctx_res {
        Ok(c) => c,
        Err(e) => HmacCtx {
            ctx_id: "",
            key: key,
            config: cfg,
            ipad_state: "",
            opad_state: "",
            buffer: "",
            bytes_processed: 0,
            is_initialized: false,
        },
    };
    assert_eq!(ctx.is_initialized, true);
    assert_eq!(hmac_ctx_validate(&ctx), true);

    let up_res1: Result[Bool, String] = hmac_update(&mut ctx, "The quick brown fox ");
    assert_eq!(up_res1, Ok(true));
    let up_res2: Result[Bool, String] = hmac_update(&mut ctx, "jumps over the lazy dog");
    assert_eq!(up_res2, Ok(true));

    let fin_tag_res: Result[MacTag, String] = hmac_finalize(&mut ctx);
    let fin_tag: MacTag = match fin_tag_res {
        Ok(t) => t,
        Err(e) => MacTag { tag_id: "", tag_bytes: "", hex_str: "", len: 0, checksum: 0, algorithm: "", is_valid: false },
    };
    assert_eq!(fin_tag.is_valid, true);

    let fin_v_res: HmacVerificationResult = hmac_verify(&ctx, msg, &fin_tag);
    assert_eq!(fin_v_res.is_valid, true);
}
