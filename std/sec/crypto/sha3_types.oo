// # SHA-3 types
//
// Logline: Sha3State destubbed off pub type nested sponge.
// residual: destubbed to Int floor. Not a PQC impl.

type Sha3State = struct {
    rate: Int,
    capacity: Int,
    digest_len: Int
};

pub fn sha3_state_new(rate: Int, capacity: Int, digest_len: Int) -> Sha3State {
    return Sha3State {
        rate: rate,
        capacity: capacity,
        digest_len: digest_len
    };
}

pub fn sha3_state_rate(s: Sha3State) -> Int {
    return s.rate;
}
