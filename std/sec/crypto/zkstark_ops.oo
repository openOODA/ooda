// # ZK-STARK AIR Constraints and Field Operations
//
// Logline: Implements finite field arithmetic and AIR constraints for ZK-STARK.
//
// Setup: Imports zkstark_types.oo for data structure definitions.
//
// Beats:
//   1. Import ZK-STARK data types and finite field arithmetic.
//   2. Construct and evaluate boundary and transition AIR constraints.

import "./zkstark_types.oo";

pub fn stark_mod_add(a: Int, b: Int, modulus: Int) -> Int {
    if modulus <= 0 { return 0; }
    let sum: Int = a + b;
    return sum % modulus;
}

pub fn stark_mod_sub(a: Int, b: Int, modulus: Int) -> Int {
    if modulus <= 0 { return 0; }
    let diff: Int = (a - b) % modulus;
    if diff < 0 {
        return diff + modulus;
    }
    return diff;
}

pub fn stark_mod_mul(a: Int, b: Int, modulus: Int) -> Int {
    if modulus <= 0 { return 0; }
    let prod: Int = a * b;
    return prod % modulus;
}

pub fn stark_mod_pow(base: Int, exponent: Int, modulus: Int) -> Int {
    if modulus <= 1 { return 0; }
    let mut result: Int = 1;
    let mut b: Int = base % modulus;
    let mut e: Int = exponent;
    while e > 0 {
        if e % 2 == 1 {
            result = (result * b) % modulus;
        }
        e = e / 2;
        b = (b * b) % modulus;
    }
    return result;
}
