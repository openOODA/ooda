// # CKKS Data Types and Encodings
//
// Logline: Defines core data structures, metadata, and helper functions for CKKS.
//
// Setup: Pure data definitions and helper transformations.
//
// Beats:
//   1. Define core CKKS structures and configuration types.
//   2. Implement constructor and helper utilities.
//   3. Provide validation and conversion routines.

// -------------------------------------------------------------------
// Struct Definitions
// -------------------------------------------------------------------

pub type CkksParams = struct {
    poly_modulus_degree: Int,
    scale: Float,
    prime_bits: Int,
    security_level: Int,
    max_level: Int,
    slots_count: Int,
    is_valid: Bool
};

pub type CkksComplex = struct {
    real: Float,
    imag: Float
};

pub type CkksPlaintext = struct {
    plain_id: String,
    slots: List[CkksComplex],
    slots_count: Int,
    scale: Float,
    level: Int,
    poly_repr: String,
    is_valid: Bool
};

pub type CkksCiphertext = struct {
    cipher_id: String,
    c0_poly: String,
    c1_poly: String,
    c2_poly: String,
    degree: Int,
    scale: Float,
    level: Int,
    slots_count: Int,
    noise_budget: Int,
    checksum: Int,
    is_valid: Bool
};

pub type CkksPublicKey = struct {
    key_id: String,
    pk0_poly: String,
    pk1_poly: String,
    checksum: Int,
    is_valid: Bool
};

pub type CkksSecretKey = struct {
    key_id: String,
    sk_poly: String,
    checksum: Int,
    is_wiped: Bool,
    is_valid: Bool
};

pub type CkksRelinKey = struct {
    key_id: String,
    relin_data: List[String],
    decomposition_base_degree: Int,
    checksum: Int,
    is_valid: Bool
};

pub type CkksGaloisKey = struct {
    key_id: String,
    galois_elts: List[Int],
    galois_data: List[String],
    checksum: Int,
    is_valid: Bool
};

pub type CkksKeyPair = struct {
    pair_id: String,
    public_key: CkksPublicKey,
    secret_key: CkksSecretKey,
    relin_key: CkksRelinKey,
    galois_key: CkksGaloisKey,
    params: CkksParams,
    is_valid: Bool
};

pub type CkksEncoder = struct {
    encoder_id: String,
    slots: Int,
    default_scale: Float,
    params: CkksParams,
    is_initialized: Bool
};

pub type CkksEncryptor = struct {
    encryptor_id: String,
    public_key: CkksPublicKey,
    secret_key: CkksSecretKey,
    params: CkksParams,
    uses_secret_key: Bool
};

pub type CkksDecryptor = struct {
    decryptor_id: String,
    secret_key: CkksSecretKey,
    params: CkksParams
};

pub type CkksEvaluator = struct {
    evaluator_id: String,
    params: CkksParams,
    relin_key: CkksRelinKey,
    galois_key: CkksGaloisKey,
    ops_count: Int
};

pub type CkksContext = struct {
    context_id: String,
    params: CkksParams,
    key_pair: CkksKeyPair,
    ops_count: Int,
    is_initialized: Bool
};

// -------------------------------------------------------------------
// Helper Functions & Checksums
// -------------------------------------------------------------------

pub fn ckks_calculate_checksum(input_data: String) -> Int {
    let len: Int = input_data.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < len {
        let ch: Int = byte_at(input_data, i);
        hash = (hash * 33) + ch;
        i = i + 1;
    }
    return hash;
}

pub fn ckks_complex_create(real: Float, imag: Float) -> CkksComplex {
    return CkksComplex {
        real: real,
        imag: imag
    };
}

pub fn ckks_complex_add(a: CkksComplex, b: CkksComplex) -> CkksComplex {
    let ar: Float = a.real;
    let br: Float = b.real;
    let ai: Float = a.imag;
    let bi: Float = b.imag;
    let r: Float = ar + br;
    let i: Float = ai + bi;
    return CkksComplex {
        real: r,
        imag: i
    };
}

pub fn ckks_complex_sub(a: CkksComplex, b: CkksComplex) -> CkksComplex {
    let ar: Float = a.real;
    let br: Float = b.real;
    let ai: Float = a.imag;
    let bi: Float = b.imag;
    let r: Float = ar - br;
    let i: Float = ai - bi;
    return CkksComplex {
        real: r,
        imag: i
    };
}

pub fn ckks_complex_mul(a: CkksComplex, b: CkksComplex) -> CkksComplex {
    let ar: Float = a.real;
    let ai: Float = a.imag;
    let br: Float = b.real;
    let bi: Float = b.imag;
    let r: Float = (ar * br) - (ai * bi);
    let i: Float = (ar * bi) + (ai * br);
    return CkksComplex {
        real: r,
        imag: i
    };
}

pub fn ckks_params_create(
    poly_deg: Int,
    scale: Float,
    prime_bits: Int,
    sec_level: Int
) -> CkksParams {
    let mut valid: Bool = true;
    if poly_deg < 1024 {
        valid = false;
    }
    if scale <= 0.0 {
        valid = false;
    }
    if prime_bits < 16 {
        valid = false;
    }
    let slots: Int = poly_deg / 2;
    return CkksParams {
        poly_modulus_degree: poly_deg,
        scale: scale,
        prime_bits: prime_bits,
        security_level: sec_level,
        max_level: 8,
        slots_count: slots,
        is_valid: valid
    };
}

pub fn ckks_params_validate(params_ref: &CkksParams) -> Result[Bool, String] {
    let poly_deg: Int = (params_ref).poly_modulus_degree;
    if poly_deg < 1024 {
        return Err("Invalid CKKS Parameters: Polynomial modulus degree must be at least 1024");
    }
    let scale_val: Float = (params_ref).scale;
    if scale_val <= 0.0 {
        return Err("Invalid CKKS Parameters: Scale factor must be positive");
    }
    let p_bits: Int = (params_ref).prime_bits;
    if p_bits < 16 {
        return Err("Invalid CKKS Parameters: Prime bits must be at least 16");
    }
    let valid: Bool = (params_ref).is_valid;
    if valid == false {
        return Err("Invalid CKKS Parameters: Parameter validation flag is false");
    }
    return Ok(true);
}
