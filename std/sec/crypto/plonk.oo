// # PLONK Facade
//
// Logline: Re-exports PLONK data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import PLONK companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// Original ~742-line plonk.oo split at functional seams into
// plonk_types / plonk_ops / plonk_circuit / plonk_prover /
// plonk_verifier / plonk_stubs (each ≤256 lines). This shim re-exports
// public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./plonk_stubs.oo";

pub fn shim_marker_mod_add() -> Int {
    return plonk_mod_add(3, 4, 1009);
}

pub fn shim_marker_custom_gate_create() -> CustomGate {
    return custom_gate_create("g1", 1, 1, 1, 0, 0 - 1, 0);
}

pub fn shim_marker_custom_gate_eval() -> Int {
    let g: CustomGate = custom_gate_create("g1", 1, 1, 1, 0, 0 - 1, 0);
    return custom_gate_eval(g, 3, 4, 7, 1009);
}

pub fn shim_marker_vk_create() -> PlonkVk {
    return plonk_vk_create("vk1", 8, 1, 1, 1, 0, 0 - 1, 0, 2, 3, 4, 5, 6, 11);
}

pub fn shim_marker_circuit_init() -> PlonkCircuit {
    return plonk_circuit_init("circ1", 1009);
}

pub fn shim_marker_witness_create() -> PlonkWitness {
    return plonk_witness_create("w1", 3, 4, 7, 1);
}

pub fn shim_marker_transcript_init() -> PlonkTranscript {
    return plonk_transcript_init("t1");
}

pub fn shim_marker_batch_init() -> PlonkBatchVerifier {
    return plonk_batch_verifier_init("B1");
}

pub fn shim_marker_do_work(prover: &PlonkProver, verifier: &PlonkVerifier) -> Int {
    return plonk_do_work(prover, verifier);
}
