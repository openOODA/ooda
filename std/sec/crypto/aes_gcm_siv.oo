// # AES-GCM-SIV Facade and Re-Export Shim
//
// Logline: Re-exports AES-GCM-SIV types, key constructors, nonces, auth tags, and fail-closed primitives.
//
// Setup: Pure module shim importing types, operations, and stubs companion submodules.
//
// Beats:
//   1. Import AES-GCM-SIV types, operations, and fail-closed stubs companion modules.
//   2. Provide typed shim markers ensuring monomorphization coverage.
//   3. Execute self-verification suite to validate key, nonce, tag, and hex roundtrips.

import "./aes_gcm_siv_types.oo";
import "./aes_gcm_siv_ops.oo";
import "./aes_gcm_siv_stubs.oo";

pub fn shim_marker_aes_key() -> Result[AesKey, String] {
    return aes_key_create("test_k", "0123456789abcdef", "AES-128");
}

pub fn shim_marker_nonce() -> Result[Nonce, String] {
    return nonce_create("test_n", "012345678901");
}

pub fn shim_marker_auth_tag() -> Result[AuthTag, String] {
    return auth_tag_create("0123456789abcdef");
}

pub fn shim_marker_hex_encode(raw: String) -> String {
    return hex_encode(raw);
}

verify aes_gcm_siv {
    let key_bytes: String = "0123456789abcdef"; // 16 bytes = 128 bits
    let k_res: Result[AesKey, String] = aes_key_create("K1", key_bytes, "AES-128-GCM-SIV");
    let key: AesKey = match k_res {
        Ok(k) => k,
        Err(e) => AesKey { key_id: "", raw_bytes: "", bit_length: 0, algorithm: "", checksum: 0, is_valid: false }
    };
    assert_eq!(key.is_valid, true);
    assert_eq!(aes_key_validate(&key), true);

    let nonce_bytes: String = "0123456789ab"; // 12 bytes = 96 bits
    let n_res: Result[Nonce, String] = nonce_create("N1", nonce_bytes);
    let nonce: Nonce = match n_res {
        Ok(n) => n,
        Err(e) => Nonce { nonce_id: "", raw_bytes: "", len: 0, counter: 0, is_valid: false }
    };
    assert_eq!(nonce.is_valid, true);
    assert_eq!(nonce_validate(&nonce), true);

    let tag_bytes: String = "0123456789abcdef"; // 16 bytes = 128 bits
    let t_res: Result[AuthTag, String] = auth_tag_create(tag_bytes);
    let tag: AuthTag = match t_res {
        Ok(t) => t,
        Err(e) => AuthTag { tag_bytes: "", len: 0, checksum: 0, is_valid: false }
    };
    assert_eq!(tag.is_valid, true);
    assert_eq!(auth_tag_validate(&tag), true);

    let ct: Ciphertext = ciphertext_create("encrypted_payload", tag, nonce);
    assert_eq!(ct.is_valid, true);
    assert_eq!(ciphertext_validate(&ct), true);

    let hex_val: String = hex_encode("hi");
    assert_eq!(hex_val, "6869");
    let dec_res: Result[String, String] = hex_decode("6869");
    let dec_str: String = match dec_res {
        Ok(s) => s,
        Err(e) => ""
    };
    assert_eq!(dec_str, "hi");

    let eq_res: Bool = bytes_constant_time_eq("abc", "abc");
    assert_eq!(eq_res, true);
    let neq_res: Bool = bytes_constant_time_eq("abc", "xyz");
    assert_eq!(neq_res, false);
}
