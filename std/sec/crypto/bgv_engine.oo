// # BGV Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for BGV.
//
// Setup: Imports companion modules for validated BGV operations.
//
// Beats:
//   1. Import BGV operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./bgv_types.oo";

pub fn bgv_negate(
    eval_ref: &mut BgvEvaluator,
    c_ref: &BgvCiphertext
) -> Result[BgvCiphertext, String] {
    let c_valid: Bool = (c_ref).is_valid;
    if c_valid == false {
        return Err("INVALID_CIPHERTEXT: Ciphertext operand is invalid");
    }

    let ops: Int = (eval_ref).ops_count;
    (eval_ref).ops_count = ops + 1;

    let c_c0: String = (c_ref).c0_poly;
    let c_c1: String = (c_ref).c1_poly;
    let c_id: String = (c_ref).cipher_id;
    let deg: Int = (c_ref).degree;
    let scale: Int = (c_ref).scale;
    let lvl: Int = (c_ref).level;
    let noise: Int = (c_ref).noise_budget;

    let c0: String = "-(" + c_c0 + ")";
    let c1: String = "-(" + c_c1 + ")";
    let cid: String = "bgv_neg_" + c_id;
    let chk: Int = bgv_calculate_checksum(c0 + c1);

    let res: BgvCiphertext = BgvCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: "",
        degree: deg,
        scale: scale,
        level: lvl,
        noise_budget: noise,
        checksum: chk,
        is_valid: true,
    };
    return Ok(res);
}

pub fn bgv_multiply(
    eval_ref: &mut BgvEvaluator,
    c1_ref: &BgvCiphertext,
    c2_ref: &BgvCiphertext
) -> Result[BgvCiphertext, String] {
    let c1_valid: Bool = (c1_ref).is_valid;
    let c2_valid: Bool = (c2_ref).is_valid;
    if c1_valid == false {
        return Err("INVALID_CIPHERTEXT: First operand is invalid");
    }
    if c2_valid == false {
        return Err("INVALID_CIPHERTEXT: Second operand is invalid");
    }

    let n1: Int = (c1_ref).noise_budget;
    let n2: Int = (c2_ref).noise_budget;
    if n1 <= 15 || n2 <= 15 {
        return Err("NOISE_EXHAUSTED: Insufficient noise budget for homomorphic multiplication");
    }

    let ops: Int = (eval_ref).ops_count;
    (eval_ref).ops_count = ops + 1;

    let c1_c0: String = (c1_ref).c0_poly;
    let c1_c1: String = (c1_ref).c1_poly;
    let c2_c0: String = (c2_ref).c0_poly;
    let c2_c1: String = (c2_ref).c1_poly;
    let c1_id: String = (c1_ref).cipher_id;
    let c2_id: String = (c2_ref).cipher_id;
    let s1: Int = (c1_ref).scale;
    let s2: Int = (c2_ref).scale;
    let lvl: Int = (c1_ref).level;

    let c0: String = "(" + c1_c0 + " * " + c2_c0 + ")";
    let c1: String = "(" + c1_c0 + " * " + c2_c1 + " + " + c1_c1 + " * " + c2_c0 + ")";
    let c2: String = "(" + c1_c1 + " * " + c2_c1 + ")";
    let cid: String = "bgv_mul_" + c1_id + "_" + c2_id;
    let chk: Int = bgv_calculate_checksum(c0 + c1 + c2);

    let min_noise: Int = if n1 < n2 { n1 } else { n2 };
    let new_noise: Int = min_noise - 20;

    let res: BgvCiphertext = BgvCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: c2,
        degree: 3,
        scale: s1 * s2,
        level: lvl,
        noise_budget: new_noise,
        checksum: chk,
        is_valid: true,
    };
    return Ok(res);
}

pub fn bgv_multiply_plain(
    eval_ref: &mut BgvEvaluator,
    c_ref: &BgvCiphertext,
    p_ref: &BgvPlaintext
) -> Result[BgvCiphertext, String] {
    let c_valid: Bool = (c_ref).is_valid;
    let p_valid: Bool = (p_ref).is_valid;
    if c_valid == false {
        return Err("INVALID_CIPHERTEXT: Ciphertext operand is invalid");
    }
    if p_valid == false {
        return Err("INVALID_PLAINTEXT: Plaintext operand is invalid");
    }

    let ops: Int = (eval_ref).ops_count;
    (eval_ref).ops_count = ops + 1;

    let c_c0: String = (c_ref).c0_poly;
    let c_c1: String = (c_ref).c1_poly;
    let c_c2: String = (c_ref).c2_poly;
    let p_repr: String = (p_ref).poly_repr;
    let c_id: String = (c_ref).cipher_id;
    let p_id: String = (p_ref).plain_id;
    let deg: Int = (c_ref).degree;
    let c_scale: Int = (c_ref).scale;
    let p_scale: Int = (p_ref).scale;
    let lvl: Int = (c_ref).level;
    let noise: Int = (c_ref).noise_budget;

    let c0: String = "(" + c_c0 + " * " + p_repr + ")";
    let c1: String = "(" + c_c1 + " * " + p_repr + ")";
    let cid: String = "bgv_mulp_" + c_id + "_" + p_id;
    let chk: Int = bgv_calculate_checksum(c0 + c1);

    let res: BgvCiphertext = BgvCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: c_c2,
        degree: deg,
        scale: c_scale * p_scale,
        level: lvl,
        noise_budget: noise - 4,
        checksum: chk,
        is_valid: true,
    };
    return Ok(res);
}

pub fn bgv_relinearize(
    eval_ref: &mut BgvEvaluator,
    c_ref: &BgvCiphertext
) -> Result[BgvCiphertext, String] {
    let c_valid: Bool = (c_ref).is_valid;
    let rk_valid: Bool = (eval_ref).relin_keys.is_valid;
    if c_valid == false {
        return Err("INVALID_CIPHERTEXT: Cannot relinearize invalid ciphertext");
    }
    if rk_valid == false {
        return Err("INVALID_KEY: Relinearization keys are not available or invalid");
    }

    let deg: Int = (c_ref).degree;
    let c_id: String = (c_ref).cipher_id;
    let c0: String = (c_ref).c0_poly;
    let c1: String = (c_ref).c1_poly;
    let c2: String = (c_ref).c2_poly;
    let scale: Int = (c_ref).scale;
    let lvl: Int = (c_ref).level;
    let noise: Int = (c_ref).noise_budget;
    let chk_orig: Int = (c_ref).checksum;

    if deg <= 2 {
        return Ok(BgvCiphertext {
            cipher_id: c_id,
            c0_poly: c0,
            c1_poly: c1,
            c2_poly: "",
            degree: 2,
            scale: scale,
            level: lvl,
            noise_budget: noise,
            checksum: chk_orig,
            is_valid: true,
        });
    }

    let ops: Int = (eval_ref).ops_count;
    (eval_ref).ops_count = ops + 1;

    let new_c0: String = c0 + " + bgv_relin(" + c2 + ")";
    let new_c1: String = c1 + " + bgv_relin_prime(" + c2 + ")";
    let cid: String = "bgv_relin_" + c_id;
    let chk: Int = bgv_calculate_checksum(new_c0 + new_c1);

    let res: BgvCiphertext = BgvCiphertext {
        cipher_id: cid,
        c0_poly: new_c0,
        c1_poly: new_c1,
        c2_poly: "",
        degree: 2,
        scale: scale,
        level: lvl,
        noise_budget: noise - 3,
        checksum: chk,
        is_valid: true,
    };
    return Ok(res);
}
