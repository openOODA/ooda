// # BGV Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for BGV.
//
// Setup: Imports destubbed bgv_types.oo (Int-floor BgvParams).
//
// Beats:
//   1. Import BGV operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./bgv_types.oo";

pub fn bgv_engine_init(poly_degree: Int, plain_mod: Int, coeff_bits: Int) -> BgvParams {
    return bgv_params_new(poly_degree, plain_mod, coeff_bits);
}

pub fn bgv_engine_degree(p: BgvParams) -> Int {
    return bgv_params_degree(p);
}

pub fn bgv_engine_flags(p: BgvParams) -> Int {
    return bgv_params_flags(p);
}

pub fn bgv_engine_work(poly_degree: Int, plain_mod: Int, coeff_bits: Int) -> Int {
    let p: BgvParams = bgv_params_new(poly_degree, plain_mod, coeff_bits);
    return bgv_params_flags(p) + bgv_params_degree(p);
}
