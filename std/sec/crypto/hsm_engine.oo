// # HSM Engine
//
// Logline: Destubbed onto ./hsm_types.oo Int-floor KeyHandle API.
//
// Setup: Companion types destubbed; keep fail-closed real calls.
//
// Beats:
//   1. Import destubbed companion.
//   2. Wrap constructor and Int query.
//   3. Deterministic work helper for prove.

import "./hsm_types.oo";

pub fn hsm_engine_init(handle_id: Int, checksum: Int, is_valid: Int) -> KeyHandle {
    return hsm_handle_new(handle_id, checksum, is_valid);
}

pub fn hsm_engine_work(handle_id: Int, checksum: Int, is_valid: Int) -> Int {
    let h: KeyHandle = hsm_handle_new(handle_id, checksum, is_valid);
    return h.handle_id + h.checksum + h.is_valid;
}
