// # HSM Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for HSM.
//
// Setup: Imports companion modules for validated HSM operations.
//
// Beats:
//   1. Import HSM operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./hsm_ops.oo";

pub fn hsm_policy_default() -> HsmSecurityPolicy {
    return HsmSecurityPolicy {
        require_sys_cap: true,
        min_pin_len: 4,
        enforce_hardware_token: true,
        fail_closed: true,
        is_active: true,
    };
}

pub fn hsm_policy_strict() -> HsmSecurityPolicy {
    return HsmSecurityPolicy {
        require_sys_cap: true,
        min_pin_len: 8,
        enforce_hardware_token: true,
        fail_closed: true,
        is_active: true,
    };
}

pub fn hsm_engine_init(engine_id: String, policy: HsmSecurityPolicy) -> HsmEngine {
    let empty_sessions: List[HsmSession] = list_new();
    let empty_handles: List[KeyHandle] = list_new();
    return HsmEngine {
        engine_id: engine_id,
        policy: policy,
        active_sessions: empty_sessions,
        registered_handles: empty_handles,
        operations_count: 0,
        failed_operations: 0,
        strict_mode: true,
        system_halted: false,
    };
}

pub fn hsm_engine_register_session(
    engine: &mut HsmEngine,
    session: HsmSession
) -> Result[Bool, String] {
    if (engine).system_halted {
        return Err("HSM_ENGINE_HALTED: Engine is in halted state");
    }
    let is_val: Bool = hsm_session_validate(&session);
    if is_val == false {
        (engine).failed_operations = (engine).failed_operations + 1;
        return Err("HSM_INVALID_SESSION: Session validation failed");
    }
    let cur_sessions: List[HsmSession] = (engine).active_sessions;
    let new_sessions: List[HsmSession] = list_push(cur_sessions, session);
    (engine).active_sessions = new_sessions;
    return Ok(true);
}

pub fn hsm_engine_close_session(
    engine: &mut HsmEngine,
    session_handle: Int
) -> Result[Bool, String] {
    if (engine).system_halted {
        return Err("HSM_ENGINE_HALTED: Engine is halted");
    }
    let cur_sessions: List[HsmSession] = (engine).active_sessions;
    let count: Int = list_len(cur_sessions);
    let mut i: Int = 0;
    let mut found: Bool = false;
    let mut updated_sessions: List[HsmSession] = list_new();

    while i < count {
        let mut sess: HsmSession = list_get(cur_sessions, i);
        if sess.session_handle == session_handle {
            found = true;
            sess.is_active = false;
        } else {
            updated_sessions = list_push(updated_sessions, sess);
        }
        i = i + 1;
    }

    if found == false {
        (engine).failed_operations = (engine).failed_operations + 1;
        return Err("HSM_SESSION_NOT_FOUND: Active session handle not registered");
    }

    (engine).active_sessions = updated_sessions;
    return Ok(true);
}

pub fn hsm_engine_find_session(
    engine: &HsmEngine,
    session_handle: Int
) -> Result[HsmSession, String] {
    let cur_sessions: List[HsmSession] = (engine).active_sessions;
    let count: Int = list_len(cur_sessions);
    let mut i: Int = 0;

    while i < count {
        let sess: HsmSession = list_get(cur_sessions, i);
        if sess.session_handle == session_handle {
            if sess.is_active {
                return Ok(sess);
            }
        }
        i = i + 1;
    }

    return Err("HSM_SESSION_NOT_FOUND: Session handle not found or inactive");
}

pub fn hsm_engine_register_key_handle(
    engine: &mut HsmEngine,
    kh: KeyHandle
) -> Result[Bool, String] {
    if (engine).system_halted {
        return Err("HSM_ENGINE_HALTED: Engine is halted");
    }
    let is_val: Bool = hsm_key_handle_validate(&kh);
    if is_val == false {
        (engine).failed_operations = (engine).failed_operations + 1;
        return Err("HSM_INVALID_KEY_HANDLE: Key handle validation failed");
    }
    let cur_handles: List[KeyHandle] = (engine).registered_handles;
    let new_handles: List[KeyHandle] = list_push(cur_handles, kh);
    (engine).registered_handles = new_handles;
    return Ok(true);
}

pub fn hsm_engine_find_key_handle(
    engine: &HsmEngine,
    target_id: String
) -> Result[KeyHandle, String] {
    let cur_handles: List[KeyHandle] = (engine).registered_handles;
    let count: Int = list_len(cur_handles);
    let mut i: Int = 0;

    while i < count {
        let kh: KeyHandle = list_get(cur_handles, i);
        let kid: String = kh.key_id;
        if kid == target_id {
            if kh.is_valid {
                return Ok(kh);
            }
        }
        i = i + 1;
    }

    return Err("HSM_KEY_NOT_FOUND: Target key handle not found");
}

pub fn hsm_engine_do_work(engine: &HsmEngine) -> Int {
    let s_len: Int = list_len((engine).active_sessions);
    let h_len: Int = list_len((engine).registered_handles);
    let ops: Int = (engine).operations_count;
    let fails: Int = (engine).failed_operations;
    return s_len + h_len * 2 + ops * 3 + fails * 5;
}
