// # Dilithium Operations and Formatting
//
// Logline: Keypair creation, message hashing, signature formatting, and verification operations for Dilithium.
//
// Setup: Algorithmic operations and structural validation for CRYSTALS-Dilithium signatures.
//
// Beats:
//   1. Calculate message hash digests for Dilithium signing.
//   2. Create and validate public/secret keypair structures.
//   3. Assemble and structurally validate signature objects.
//   4. Implement message signing and signature verification operations.

import "./dilithium_types.oo";

pub fn dilithium_calculate_hash(input_str: String) -> String {
    let len: Int = input_str.len();
    let mut i: Int = 0;
    let mut hash_val: Int = 5381;
    while i < len {
        let ch: Int = byte_at(input_str, i);
        hash_val = (hash_val * 33) + ch;
        if hash_val < 0 {
            hash_val = 0 - hash_val;
        }
        i = i + 1;
    }
    let h_str: String = hash_val.to_string();
    return "dilithium_sha3_" + h_str;
}

pub fn dilithium_keypair_create(
    key_id: String,
    public_key: String,
    secret_key: String,
    mode: Int,
    created_at: Int
) -> DilithiumKeyPair {
    let params: DilithiumParams = dilithium_params_init(mode);
    let mut active: Bool = true;
    if params.is_valid == false {
        active = false;
    }
    let pk_len: Int = public_key.len();
    let sk_len: Int = secret_key.len();
    if pk_len == 0 {
        active = false;
    }
    if sk_len == 0 {
        active = false;
    }

    return DilithiumKeyPair {
        key_id: key_id,
        public_key: public_key,
        secret_key: secret_key,
        params: params,
        created_at: created_at,
        is_active: active,
    };
}

pub fn dilithium_keypair_validate(kp: &DilithiumKeyPair) -> Bool {
    if (kp).is_active == false {
        return false;
    }
    let par: DilithiumParams = (kp).params;
    if par.is_valid == false {
        return false;
    }
    let pk: String = (kp).public_key;
    let sk: String = (kp).secret_key;
    if pk.len() == 0 {
        return false;
    }
    if sk.len() == 0 {
        return false;
    }
    return true;
}

pub fn dilithium_keypair_to_string(kp: &DilithiumKeyPair) -> String {
    let kid: String = (kp).key_id;
    let par: DilithiumParams = (kp).params;
    let pname: String = par.name;
    let ts: Int = (kp).created_at;
    let ts_str: String = ts.to_string();
    return "DilithiumKeyPair[" + kid + "] Mode:" + pname + " Created:" + ts_str;
}

pub fn dilithium_signature_create(
    signature_id: String,
    key_id: String,
    sig_bytes: String,
    message_digest: String,
    mode: Int,
    timestamp: Int
) -> DilithiumSignature {
    let mut valid: Bool = true;
    let params: DilithiumParams = dilithium_params_init(mode);
    if params.is_valid == false {
        valid = false;
    }
    if sig_bytes.len() == 0 {
        valid = false;
    }
    if message_digest.len() == 0 {
        valid = false;
    }

    return DilithiumSignature {
        signature_id: signature_id,
        key_id: key_id,
        sig_bytes: sig_bytes,
        message_digest: message_digest,
        params_mode: mode,
        is_valid: valid,
        timestamp: timestamp,
    };
}

pub fn dilithium_signature_validate_structure(target_sig: &DilithiumSignature) -> Bool {
    if (target_sig).is_valid == false {
        return false;
    }
    let sb: String = (target_sig).sig_bytes;
    if sb.len() == 0 {
        return false;
    }
    let md: String = (target_sig).message_digest;
    if md.len() == 0 {
        return false;
    }
    let mode: Int = (target_sig).params_mode;
    let params: DilithiumParams = dilithium_params_init(mode);
    return params.is_valid;
}

pub fn dilithium_sign_message(
    kp: &DilithiumKeyPair,
    message: String,
    timestamp: Int
) -> Result[DilithiumSignature, String] {
    let valid_kp: Bool = dilithium_keypair_validate(kp);
    if valid_kp == false {
        return Err("DILITHIUM_SIGN_ERR: Key pair is invalid or inactive");
    }

    let digest: String = dilithium_calculate_hash(message);
    let sk: String = (kp).secret_key;
    let par: DilithiumParams = (kp).params;
    let mode: Int = par.mode;
    let kid: String = (kp).key_id;
    let ts_str: String = timestamp.to_string();

    let sig_id: String = "sig_" + kid + "_" + ts_str;
    let sig_content: String = "DILITHIUM_SIG[" + mode.to_string() + ":" + digest + ":" + sk + "]";

    let sig_obj: DilithiumSignature = dilithium_signature_create(
        sig_id,
        kid,
        sig_content,
        digest,
        mode,
        timestamp
    );

    return Ok(sig_obj);
}

pub fn dilithium_verify_signature(
    public_key: String,
    target_sig: &DilithiumSignature,
    message: String
) -> DilithiumVerificationResult {
    let valid_struct: Bool = dilithium_signature_validate_structure(target_sig);
    if valid_struct == false {
        return DilithiumVerificationResult {
            is_valid: false,
            key_id: (target_sig).key_id,
            message_digest: (target_sig).message_digest,
            error_code: "INVALID_SIGNATURE_STRUCTURE",
            verification_time: 0,
        };
    }

    if public_key.len() == 0 {
        return DilithiumVerificationResult {
            is_valid: false,
            key_id: (target_sig).key_id,
            message_digest: (target_sig).message_digest,
            error_code: "EMPTY_PUBLIC_KEY",
            verification_time: 0,
        };
    }

    let expected_digest: String = dilithium_calculate_hash(message);
    let actual_digest: String = (target_sig).message_digest;

    if expected_digest != actual_digest {
        return DilithiumVerificationResult {
            is_valid: false,
            key_id: (target_sig).key_id,
            message_digest: actual_digest,
            error_code: "DIGEST_MISMATCH",
            verification_time: 0,
        };
    }

    return DilithiumVerificationResult {
        is_valid: true,
        key_id: (target_sig).key_id,
        message_digest: actual_digest,
        error_code: "OK",
        verification_time: 1,
    };
}
