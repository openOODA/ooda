// # TSS Engine Lifecycle and Policy Management
//
// Logline: Manages TSS execution engine lifecycle, key share registration, and capability-gated verification.
//
// Setup: Imports tss_ops.oo for validated parameter and keyshare operations.
//
// Beats:
//   1. Import TSS operations and types.
//   2. Initialize TSS security policies and execution engine contexts.
//   3. Register and search active participant key shares.
//   4. Calculate workload telemetry and enforce capability-gated subprocess commands.

import "./tss_ops.oo";

pub fn tss_policy_init(require_sys_cap: Bool, fail_closed: Bool, min_threshold: Int) -> TssSecurityPolicy {
    return TssSecurityPolicy {
        require_sys_cap: require_sys_cap,
        fail_closed: fail_closed,
        min_threshold: min_threshold,
        allow_legacy: false,
        is_active: true,
    };
}

pub fn tss_engine_init(
    engine_id: String,
    policy_val: TssSecurityPolicy,
    params_val: ThresholdParams
) -> TssEngine {
    let empty_shares: List[ThresholdKeyShare] = list_new();
    return TssEngine {
        engine_id: engine_id,
        policy: policy_val,
        params: params_val,
        key_shares: empty_shares,
        signed_count: 0,
        verified_count: 0,
        rejected_count: 0,
        strict_mode: true,
        system_halted: false,
    };
}

pub fn tss_engine_register_share(
    engine_ref: &mut TssEngine,
    share_val: ThresholdKeyShare
) -> Result[Bool, String] {
    if (engine_ref).system_halted {
        return Err("TSS_ENGINE_ERR: Engine is halted");
    }
    let share_obj: ThresholdKeyShare = share_val;
    if tss_keyshare_validate(share_obj) == false {
        return Err("TSS_ENGINE_ERR: Key share validation failed");
    }
    let old_shares: List[ThresholdKeyShare] = (engine_ref).key_shares;
    (engine_ref).key_shares = list_push(old_shares, share_obj);
    return Ok(true);
}

pub fn tss_engine_find_share(
    engine_val: TssEngine,
    participant_index: Int
) -> Result[ThresholdKeyShare, String] {
    let engine_obj: TssEngine = engine_val;
    let shares_list: List[ThresholdKeyShare] = engine_obj.key_shares;
    let share_count: Int = list_len(shares_list);
    let mut idx: Int = 0;
    while idx < share_count {
        let share_item: ThresholdKeyShare = list_get(shares_list, idx);
        if share_item.participant_index == participant_index {
            return Ok(share_item);
        }
        idx = idx + 1;
    }
    return Err("KEY_SHARE_NOT_FOUND");
}

pub fn tss_engine_do_work(engine_val: TssEngine) -> Int {
    let engine_obj: TssEngine = engine_val;
    let sc: Int = engine_obj.signed_count;
    let vc: Int = engine_obj.verified_count;
    let rc: Int = engine_obj.rejected_count;
    let s_count: Int = list_len(engine_obj.key_shares);
    let sum1: Int = sc + (vc * 2);
    let sum2: Int = sum1 + (rc * 3);
    return sum2 + (s_count * 5);
}

pub fn tss_engine_verify_with_capability(
    sys_cap: &SysCap,
    engine_ref: &mut TssEngine,
    command_str: String
) -> Result[String, String]
    requires command_str.len() > 0
{
    if (engine_ref).system_halted {
        return Err("TSS_ENGINE_HALTED: Security subsystem is disabled");
    }
    let proc_res: Result[String, String] = sys_exec(sys_cap, command_str);
    return match proc_res {
        Ok(output) => Ok("TSS_CAP_EXEC: " + output),
        Err(err) => {
            if (engine_ref).policy.fail_closed {
                (engine_ref).system_halted = true;
            }
            Err("TSS_CAP_ERR: " + err)
        },
    };
}
