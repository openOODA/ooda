// # ZK-STARK types
//
// Logline: AirConstraint destubbed off List[AirConstraint].
// residual: List[struct] destubbed to Int floor.

type AirConstraint = struct {
    degree: Int,
    coefficient: Int,
    target_step: Int
};

pub fn air_constraint_new(degree: Int, coefficient: Int, target_step: Int) -> AirConstraint {
    return AirConstraint {
        degree: degree,
        coefficient: coefficient,
        target_step: target_step
    };
}

pub fn air_constraint_degree(c: AirConstraint) -> Int {
    return c.degree;
}
