// # SPHINCS+ Key, Tree State, and Signature Operations
//
// Logline: Implements keypair creation, hypertree state advancement, and signature structure validators.
//
// Setup: Imports sphincs_types.oo for data structure definitions.
//
// Beats:
//   1. Import SPHINCS+ data types and structures.
//   2. Provide keypair creation, validation, and fingerprint calculation routines.
//   3. Implement hypertree state progression, reset, and progress tracking.
//   4. Construct and validate WOTS+, FORS, and SPHINCS+ signatures.

import "./sphincs_types.oo";

pub fn sphincs_keypair_create(
    pub_seed: String,
    pub_root: String,
    sec_seed: String,
    sec_prf: String,
    key_id: String,
    params: SphincsParams
) -> SphincsKeyPair {
    let mut valid: Bool = true;
    if pub_seed.len() == 0 {
        valid = false;
    }
    if pub_root.len() == 0 {
        valid = false;
    }
    if sec_seed.len() == 0 {
        valid = false;
    }
    return SphincsKeyPair {
        pub_seed: pub_seed,
        pub_root: pub_root,
        sec_seed: sec_seed,
        sec_prf: sec_prf,
        key_id: key_id,
        params: params,
        is_valid: valid,
    };
}

pub fn sphincs_keypair_validate(keypair_ref: &SphincsKeyPair) -> Bool {
    if (keypair_ref).is_valid == false {
        return false;
    }
    if (keypair_ref).pub_seed.len() == 0 {
        return false;
    }
    if (keypair_ref).pub_root.len() == 0 {
        return false;
    }
    return (keypair_ref).sec_seed.len() > 0;
}

pub fn sphincs_keypair_get_public_key_fingerprint(keypair_ref: &SphincsKeyPair) -> Int {
    let ps: String = (keypair_ref).pub_seed;
    let pr: String = (keypair_ref).pub_root;
    let kid: String = (keypair_ref).key_id;
    let mut fp: Int = 314159;
    fp = fp + ps.len() * 17;
    fp = fp + pr.len() * 31;
    fp = fp + kid.len() * 43;
    if (keypair_ref).is_valid {
        fp = fp + 10000;
    }
    return fp;
}

pub fn sphincs_tree_state_init(tree_height: Int, total_layers: Int) -> SphincsTreeState {
    return SphincsTreeState {
        tree_address: 0,
        leaf_address: 0,
        tree_height: tree_height,
        layer_index: 0,
        signatures_counter: 0,
        is_active: true,
    };
}

pub fn sphincs_tree_state_advance(mut_state: &mut SphincsTreeState) -> Bool {
    if (mut_state).is_active == false {
        return false;
    }
    let cur_leaf: Int = (mut_state).leaf_address;
    let cur_cnt: Int = (mut_state).signatures_counter;
    let cur_tree: Int = (mut_state).tree_address;
    (mut_state).leaf_address = cur_leaf + 1;
    (mut_state).signatures_counter = cur_cnt + 1;
    let max_leaf: Int = 1024;
    if (mut_state).leaf_address >= max_leaf {
        (mut_state).leaf_address = 0;
        (mut_state).tree_address = cur_tree + 1;
    }
    return true;
}

pub fn sphincs_tree_state_reset(mut_state: &mut SphincsTreeState) {
    (mut_state).tree_address = 0;
    (mut_state).leaf_address = 0;
    (mut_state).signatures_counter = 0;
    (mut_state).is_active = true;
}

pub fn sphincs_tree_state_calculate_progress(state_ref: &SphincsTreeState) -> Int {
    let t_addr: Int = (state_ref).tree_address;
    let l_addr: Int = (state_ref).leaf_address;
    let sig_cnt: Int = (state_ref).signatures_counter;
    return t_addr * 1000 + l_addr + sig_cnt;
}

pub fn sphincs_wots_signature_create(sig_chains: List[String], checksum: Int) -> SphincsWotsSignature {
    return SphincsWotsSignature {
        wots_sig_chains: sig_chains,
        wots_pk_checksum: checksum,
    };
}

pub fn sphincs_wots_signature_validate(wots_ref: &SphincsWotsSignature, expected_chain_len: Int) -> Bool {
    let chains: List[String] = (wots_ref).wots_sig_chains;
    if list_len(chains) == 0 {
        return false;
    }
    return (wots_ref).wots_pk_checksum >= 0;
}

pub fn sphincs_fors_signature_create(roots: List[String], auth_paths: List[String]) -> SphincsForsSignature {
    return SphincsForsSignature {
        tree_roots: roots,
        auth_paths: auth_paths,
    };
}

pub fn sphincs_signature_create(
    sig_id: String,
    r_randomness: String,
    fors_sig: SphincsForsSignature,
    hypertree_sig: List[String],
    tree_idx: Int,
    leaf_idx: Int,
    sig_len: Int
) -> SphincsSignature {
    let mut valid: Bool = true;
    if sig_id.len() == 0 {
        valid = false;
    }
    if r_randomness.len() == 0 {
        valid = false;
    }
    if sig_len <= 0 {
        valid = false;
    }
    return SphincsSignature {
        sig_id: sig_id,
        r_randomness: r_randomness,
        fors_sig: fors_sig,
        hypertree_sig: hypertree_sig,
        tree_index: tree_idx,
        leaf_index: leaf_idx,
        sig_len_bytes: sig_len,
        is_valid: valid,
    };
}

pub fn sphincs_signature_calculate_checksum(sig_ref: &SphincsSignature) -> Int {
    let s_len: Int = (sig_ref).sig_id.len();
    let r_len: Int = (sig_ref).r_randomness.len();
    let ht_cnt: Int = list_len((sig_ref).hypertree_sig);
    let t_idx: Int = (sig_ref).tree_index;
    let l_idx: Int = (sig_ref).leaf_index;
    let mut chk: Int = 17389;
    chk = chk + s_len * 19;
    chk = chk + r_len * 31;
    chk = chk + ht_cnt * 97;
    chk = chk + t_idx * 13;
    chk = chk + l_idx * 7;
    if (sig_ref).is_valid {
        chk = chk + 50000;
    }
    return chk;
}

pub fn sphincs_signature_is_valid_structure(sig_ref: &SphincsSignature) -> Bool {
    if (sig_ref).is_valid == false {
        return false;
    }
    if (sig_ref).sig_len_bytes <= 0 {
        return false;
    }
    return list_len((sig_ref).hypertree_sig) > 0;
}
