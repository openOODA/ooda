// # RSA-PSS Engine
//
// Logline: Provides rsa-pss engine primitives and operations for openOODA standard library.
//
// Setup: Imports companion modules for RSA operations.
//
// Beats:
//   1. Import RSA types and dependencies.
//   2. Execute rsa-pss engine operations.
//   3. Provide validation and lifecycle routines.

import "./rsa_pss_types.oo";

// -------------------------------------------------------------------
// Security Policy & Engine Management
// -------------------------------------------------------------------

pub fn rsa_pss_policy_default() -> RsaPssSecurityPolicy {
    return RsaPssSecurityPolicy {
        is_active: true,
        min_key_bits: 2048,
        require_sha256_or_higher: true,
        fail_closed: true,
        allow_legacy_padding: false,
    };
}

pub fn rsa_pss_policy_strict() -> RsaPssSecurityPolicy {
    return RsaPssSecurityPolicy {
        is_active: true,
        min_key_bits: 3072,
        require_sha256_or_higher: true,
        fail_closed: true,
        allow_legacy_padding: false,
    };
}

pub fn rsa_pss_engine_create(engine_id: String, policy: RsaPssSecurityPolicy) -> RsaPssEngine {
    let empty_keys: List[RsaPssKeyPair] = list_new();
    return RsaPssEngine {
        engine_id: engine_id,
        policy: policy,
        key_pairs: empty_keys,
        signed_count: 0,
        verified_count: 0,
        rejected_count: 0,
        strict_mode: true,
        system_halted: false,
    };
}

pub fn rsa_pss_engine_register_keypair(engine: RsaPssEngine, kp: RsaPssKeyPair) -> RsaPssEngine {
    if engine.system_halted == true {
        return engine;
    }
    let kp_params: RsaPssParams = kp.params;
    let bits: Int = kp_params.key_bits;
    let pol: RsaPssSecurityPolicy = engine.policy;
    let min_bits: Int = pol.min_key_bits;
    if bits < min_bits {
        let cur_rej: Int = engine.rejected_count;
        let new_rej: Int = cur_rej + 1;
        return RsaPssEngine {
            engine_id: engine.engine_id,
            policy: engine.policy,
            key_pairs: engine.key_pairs,
            signed_count: engine.signed_count,
            verified_count: engine.verified_count,
            rejected_count: new_rej,
            strict_mode: engine.strict_mode,
            system_halted: engine.system_halted,
        };
    }
    let mut key_list: List[RsaPssKeyPair] = engine.key_pairs;
    key_list = list_push(key_list, kp);
    return RsaPssEngine {
        engine_id: engine.engine_id,
        policy: engine.policy,
        key_pairs: key_list,
        signed_count: engine.signed_count,
        verified_count: engine.verified_count,
        rejected_count: engine.rejected_count,
        strict_mode: engine.strict_mode,
        system_halted: engine.system_halted,
    };
}
