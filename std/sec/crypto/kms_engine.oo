// # KMS Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for KMS.
//
// Setup: Imports companion modules for validated KMS operations.
//
// Beats:
//   1. Import KMS operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./kms_keys.oo";

pub fn kms_engine_init(engine_id: String) -> KmsEngine {
    let empty_keys: List[KmsKey] = list_new();
    let empty_grants: List[KmsGrant] = list_new();
    let empty_rotations: List[KmsKeyRotation] = list_new();
    let empty_logs: List[KmsAuditLog] = list_new();

    return KmsEngine {
        engine_id: engine_id,
        keys: empty_keys,
        grants: empty_grants,
        rotations: empty_rotations,
        audit_logs: empty_logs,
        operations_count: 0,
        system_halted: false
    };
}

pub fn kms_engine_register_key(mut_engine: &mut KmsEngine, key: KmsKey) -> Result[Bool, String] {
    if (mut_engine).system_halted {
        return Err("ENGINE_HALTED: KMS engine is currently halted");
    }
    let valid: Bool = kms_key_validate(&key);
    if !valid {
        return Err("REGISTER_FAILED: Key failed validation checks");
    }
    let old_keys: List[KmsKey] = (mut_engine).keys;
    let new_keys: List[KmsKey] = list_push(old_keys, key);
    (mut_engine).keys = new_keys;
    (mut_engine).operations_count = (mut_engine).operations_count + 1;
    return Ok(true);
}

pub fn kms_engine_find_key(engine: &KmsEngine, target_key_id: String) -> Result[KmsKey, String] {
    let key_list: List[KmsKey] = (engine).keys;
    let count: Int = list_len(key_list);
    let mut i: Int = 0;
    while i < count {
        let key_item: KmsKey = list_get(key_list, i);
        let kid: String = key_item.key_id;
        if kid == target_key_id {
            return Ok(key_item);
        }
        i = i + 1;
    }
    return Err("KEY_NOT_FOUND: Master key ID not found in KMS engine");
}

pub fn kms_engine_issue_grant(mut_engine: &mut KmsEngine, grant: KmsGrant) -> Result[Bool, String] {
    if (mut_engine).system_halted {
        return Err("ENGINE_HALTED: KMS engine is currently halted");
    }
    let old_grants: List[KmsGrant] = (mut_engine).grants;
    let new_grants: List[KmsGrant] = list_push(old_grants, grant);
    (mut_engine).grants = new_grants;
    (mut_engine).operations_count = (mut_engine).operations_count + 1;
    return Ok(true);
}

pub fn kms_engine_revoke_grant(mut_engine: &mut KmsEngine, target_grant_id: String) -> Bool {
    if (mut_engine).system_halted {
        return false;
    }
    let cur_grants: List[KmsGrant] = (mut_engine).grants;
    let count: Int = list_len(cur_grants);
    let mut i: Int = 0;
    let mut found: Bool = false;
    while i < count {
        let grant_item: KmsGrant = list_get(cur_grants, i);
        let gid: String = grant_item.grant_id;
        if gid == target_grant_id {
            found = true;
        }
        i = i + 1;
    }
    if found {
        (mut_engine).operations_count = (mut_engine).operations_count + 1;
    }
    return found;
}

pub fn kms_engine_log_action(
    mut_engine: &mut KmsEngine,
    key_id: String,
    action: String,
    principal: String,
    timestamp: Int,
    status: String
) {
    let eng_id: String = (mut_engine).engine_id;
    let ts_str: String = timestamp.to_string();
    let op_cnt_num: Int = (mut_engine).operations_count;
    let op_cnt_str: String = op_cnt_num.to_string();
    let log_id: String = "log_" + eng_id + "_" + ts_str + "_" + op_cnt_str;

    let log_entry = KmsAuditLog {
        log_id: log_id,
        key_id: key_id,
        action: action,
        principal: principal,
        timestamp: timestamp,
        status: status
    };

    let cur_logs: List[KmsAuditLog] = (mut_engine).audit_logs;
    let new_logs: List[KmsAuditLog] = list_push(cur_logs, log_entry);
    (mut_engine).audit_logs = new_logs;
}

pub fn kms_engine_do_work(engine: &KmsEngine) -> Int {
    let k_list: List[KmsKey] = (engine).keys;
    let g_list: List[KmsGrant] = (engine).grants;
    let r_list: List[KmsKeyRotation] = (engine).rotations;
    let l_list: List[KmsAuditLog] = (engine).audit_logs;
    let n_k: Int = list_len(k_list);
    let n_g: Int = list_len(g_list);
    let n_r: Int = list_len(r_list);
    let n_l: Int = list_len(l_list);
    let ops: Int = (engine).operations_count;
    return n_k + (n_g * 2) + (n_r * 3) + (n_l * 5) + ops;
}


