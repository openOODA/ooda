// residual: destubbed to Int floor.

type ThresholdParams = struct {
    threshold: Int,
    total_shares: Int,
    curve_id: Int
};

pub fn tss_params_new(threshold: Int, total_shares: Int, curve_id: Int) -> ThresholdParams {
    return ThresholdParams {
        threshold: threshold,
        total_shares: total_shares,
        curve_id: curve_id
    };
}

pub fn tss_params_t(p: ThresholdParams) -> Int {
    return p.threshold;
}
