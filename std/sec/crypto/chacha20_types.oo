// # ChaCha20 types
//
// Logline: Data structures, matrix state, keys, nonces, tags, and engine models for ChaCha20-Poly1305.
//
// Setup: Pure data definitions and configuration models.
//
// Beats:
//   1. Define ChaChaKey, ChaChaNonce, and Poly1305Tag structures.
//   2. Define ChaChaState, ChaCha20Ciphertext, ChaCha20Poly1305Ctx, policy, and engine structures.
//   3. Implement constructor and helper utilities.

type ChaChaKey = struct {
    key_id: String,
    raw_bytes: String,
    bit_length: Int,
    checksum: Int,
    is_valid: Bool
};

type ChaChaNonce = struct {
    nonce_id: String,
    raw_bytes: String,
    len_bytes: Int,
    counter: Int,
    is_valid: Bool
};

type Poly1305Tag = struct {
    tag_bytes: String,
    len_bytes: Int,
    checksum: Int,
    is_valid: Bool
};

type Poly1305State = struct {
    r_key: String,
    s_key: String,
    accumulator: String,
    leftover: String,
    leftover_len: Int,
    is_finalized: Bool
};

type ChaChaState = struct {
    matrix: List[Int],
    rounds: Int,
    block_counter: Int,
    is_initialized: Bool
};

type ChaCha20Ciphertext = struct {
    data: String,
    tag: Poly1305Tag,
    nonce: ChaChaNonce,
    len_bytes: Int,
    is_valid: Bool
};

type ChaCha20Poly1305Ctx = struct {
    ctx_id: String,
    key: ChaChaKey,
    state: ChaChaState,
    nonce_len: Int,
    tag_len: Int,
    is_initialized: Bool
};

type ChaCha20SecurityPolicy = struct {
    min_rounds: Int,
    require_poly1305: Bool,
    fail_closed: Bool,
    is_active: Bool
};

type ChaCha20Engine = struct {
    engine_id: String,
    policy: ChaCha20SecurityPolicy,
    key: ChaChaKey,
    state: ChaChaState,
    bytes_encrypted: Int,
    bytes_decrypted: Int,
    system_halted: Bool
};

type ChaCha20EncryptResult = struct {
    ciphertext: ChaCha20Ciphertext,
    status_code: Int,
    error_msg: String
};

type ChaCha20DecryptResult = struct {
    plaintext: String,
    status_code: Int,
    error_msg: String
};

pub fn chacha_state_new(rounds: Int, block_counter: Int, is_initialized: Int) -> ChaChaState {
    let empty_mat: List[Int] = list_new();
    let mut valid: Bool = false;
    if is_initialized != 0 { valid = true; }
    return ChaChaState {
        matrix: empty_mat,
        rounds: rounds,
        block_counter: block_counter,
        is_initialized: valid
    };
}

pub fn chacha_state_rounds(s: ChaChaState) -> Int {
    return (s).rounds;
}
