// # ChaCha20 types
//
// Logline: ChaChaState destubbed off pub type String key.
// residual: List[struct] destubbed to Int floor. Not a PQC impl.

type ChaChaState = struct {
    rounds: Int,
    block_counter: Int,
    is_initialized: Int
};

pub fn chacha_state_new(rounds: Int, block_counter: Int, is_initialized: Int) -> ChaChaState {
    return ChaChaState {
        rounds: rounds,
        block_counter: block_counter,
        is_initialized: is_initialized
    };
}

pub fn chacha_state_rounds(s: ChaChaState) -> Int {
    return s.rounds;
}
