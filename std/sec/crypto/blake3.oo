pub type Multi = struct {};
pub type Default = struct {};
pub type Key = struct {};
pub type Producing = struct {};
pub type Length = struct {};
pub type Incremental = struct {};
pub type Keyed = struct {};
pub type BLAKE3 = struct {};
pub type Full = struct {};
pub type Invalid = struct {};
pub type Context = struct {};
pub type Binary = struct {};
pub type Fail = struct {};


pub fn __dummy_std_src_ooda_sec_crypto_blake3_oo() -> Int {
    return 0;
}
