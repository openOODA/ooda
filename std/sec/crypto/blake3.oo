// # BLAKE3 Facade
//
// Logline: Re-exports BLAKE3 data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import BLAKE3 companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 5 files (each ≤256 lines for parts, shim ≤120, oodac check green).
// This shim re-exports the public names so existing callers continue to work.
//
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

import "./blake3_types.oo";
import "./blake3_ops.oo";
import "./blake3_engine.oo";
import "./blake3_stubs.oo";

// Thin markers keep the monomorphizer aware of core paths without
// re-hosting large by-value APIs in this unit (same pattern as kmac).

pub fn shim_marker_checksum() -> Int {
    return blake3_checksum("abc");
}

pub fn shim_marker_hex_encode() -> String {
    return hex_encode("ab");
}

pub fn shim_marker_policy_default() -> Blake3SecurityPolicy {
    return blake3_security_policy_default();
}

pub fn shim_marker_xof_reader() -> Blake3XofReader {
    return blake3_xof_reader_init("r1");
}

pub fn shim_marker_flag_root() -> Int {
    return blake3_flag_root();
}

pub type Buffer = struct {};
pub type Final = struct {};
