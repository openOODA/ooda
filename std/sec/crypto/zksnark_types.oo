// # zk-SNARK Data Types and Encodings
//
// Logline: Defines core data structures, metadata, and helper functions for ZKSNARK.
//
// Setup: Pure data definitions and helper transformations.
//
// Beats:
//   1. Define core ZKSNARK structures and configuration types.
//   2. Implement constructor and helper utilities.
//   3. Provide validation and conversion routines.

pub fn zksnark_protocol_groth16() -> Int {
    return 1;
}

pub fn zksnark_protocol_plonk() -> Int {
    return 2;
}

pub fn zksnark_protocol_marlin() -> Int {
    return 3;
}

pub fn zksnark_curve_bn254() -> Int {
    return 10;
}

pub fn zksnark_curve_bls12_381() -> Int {
    return 20;
}

// -------------------------------------------------------------------
// Core Data Structures
// -------------------------------------------------------------------

pub type ZkProof = struct {
    proof_id: String,
    a_g1: String,
    b_g2: String,
    c_g1: String,
    protocol: String,
    curve: String,
    public_inputs: List[String],
    is_valid: Bool
};

pub type VerificationKey = struct {
    vk_id: String,
    alpha_g1: String,
    beta_g2: String,
    gamma_g2: String,
    delta_g2: String,
    ic: List[String],
    protocol: String,
    curve: String,
    num_public_inputs: Int,
    is_active: Bool
};

pub type ProvingKey = struct {
    pk_id: String,
    vk_id: String,
    circuit_hash: String,
    constraint_count: Int,
    variable_count: Int,
    protocol: String,
    curve: String,
    proving_data: String,
    is_ready: Bool
};

pub type ZkSnarkCircuit = struct {
    circuit_id: String,
    name: String,
    num_constraints: Int,
    num_variables: Int,
    num_public_inputs: Int,
    num_private_inputs: Int,
    circuit_hash: String,
    is_satisfied: Bool
};

pub type ZkSnarkWitness = struct {
    witness_id: String,
    circuit_id: String,
    public_signals: List[String],
    secret_signals: List[String],
    num_signals: Int,
    is_valid: Bool
};

pub type ZkSnarkPolicy = struct {
    policy_id: String,
    require_trusted_setup: Bool,
    min_security_bits: Int,
    allowed_curve: String,
    fail_closed: Bool,
    is_active: Bool
};

pub type ZkSnarkProver = struct {
    prover_id: String,
    proving_key: ProvingKey,
    proofs_generated: Int,
    strict_mode: Bool,
    is_active: Bool
};

pub type ZkSnarkVerifier = struct {
    verifier_id: String,
    verification_key: VerificationKey,
    proofs_verified: Int,
    proofs_rejected: Int,
    strict_mode: Bool,
    is_active: Bool
};

pub type ZkSnarkBatchVerifier = struct {
    batch_id: String,
    proofs: List[ZkProof],
    verification_keys: List[VerificationKey],
    verified_count: Int,
    failed_count: Int,
    is_completed: Bool
};

// Anchor constructors so oodac check monomorphizes type layouts (types-only units OOB).
pub fn zk_proof_empty() -> ZkProof {
    let empty: List[String] = list_new();
    return ZkProof {
        proof_id: "",
        a_g1: "",
        b_g2: "",
        c_g1: "",
        protocol: "",
        curve: "",
        public_inputs: empty,
        is_valid: false
    };
}

pub fn verification_key_empty() -> VerificationKey {
    let empty: List[String] = list_new();
    return VerificationKey {
        vk_id: "",
        alpha_g1: "",
        beta_g2: "",
        gamma_g2: "",
        delta_g2: "",
        ic: empty,
        protocol: "",
        curve: "",
        num_public_inputs: 0,
        is_active: false
    };
}
