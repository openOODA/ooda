// # Groth16 Proof and Key Operations
//
// Logline: Public input management, proof construction, verifying key validation, and IC element lookups.
//
// Setup: Pure helper operations and validation functions for Groth16 cryptographic artifacts.
//
// Beats:
//   1. Implement public inputs creation, validation, value mutation, and digest hashing.
//   2. Construct and validate Groth16 proof format and point components.
//   3. Construct and validate verifying key (VK) structures and IC element lengths.
//   4. Format proof strings and look up indexed IC public input elements.

import "./groth16_types.oo";

pub fn groth16_ops_init(curve_id: Int, num_public_inputs: Int) -> Groth16Setup {
    return groth16_setup_new(curve_id, num_public_inputs);
}

pub fn public_inputs_compute_hash(inputs_ref: &PublicInputs) -> String {
    let inp_id: String = (inputs_ref).input_id;
    let vals: List[String] = (inputs_ref).values;
    let count: Int = list_len(vals);
    let mut i: Int = 0;
    let count_str: String = count.to_string();
    let mut acc: String = inp_id + "_" + count_str;
    while i < count {
        let v: String = list_get(vals, i);
        acc = acc + ":" + v;
        i = i + 1;
    }
    return acc;
}

pub fn public_inputs_create(input_id: String, values: List[String]) -> PublicInputs {
    let count: Int = list_len(values);
    let mut well_formed: Bool = true;
    if count == 0 {
        well_formed = false;
    }
    let mut i: Int = 0;
    while i < count {
        let v: String = list_get(values, i);
        if v.len() == 0 {
            well_formed = false;
        }
        i = i + 1;
    }

    let mut temp_inputs: PublicInputs = PublicInputs {
        input_id: input_id,
        values: values,
        scalar_count: count,
        hash_digest: "",
        is_well_formed: well_formed
    };
    temp_inputs.hash_digest = public_inputs_compute_hash(&temp_inputs);
    return temp_inputs;
}

pub fn public_inputs_validate(inputs_ref: &PublicInputs, expected_count: Int) -> Bool {
    let is_wf: Bool = (inputs_ref).is_well_formed;
    if is_wf == false {
        return false;
    }
    let s_count: Int = (inputs_ref).scalar_count;
    return s_count == expected_count;
}

pub fn public_inputs_get_value(inputs_ref: &PublicInputs, index: Int) -> Result[String, String] {
    let vals: List[String] = (inputs_ref).values;
    let count: Int = list_len(vals);
    if index < 0 {
        return Err("Index below zero");
    }
    if index >= count {
        return Err("Index out of bounds");
    }
    let v: String = list_get(vals, index);
    return Ok(v);
}

pub fn public_inputs_add_value(inputs_mut: &mut PublicInputs, value: String) {
    let old_vals: List[String] = (inputs_mut).values;
    let new_vals: List[String] = list_push(old_vals, value);
    (inputs_mut).values = new_vals;
    (inputs_mut).scalar_count = list_len(new_vals);
    (inputs_mut).hash_digest = public_inputs_compute_hash(inputs_mut);
}

pub fn groth16_proof_create(
    proof_id: String,
    curve_id: Int,
    a_x: String,
    a_y: String,
    b_x0: String,
    b_x1: String,
    b_y0: String,
    b_y1: String,
    c_x: String,
    c_y: String,
    compressed: Bool
) -> Groth16Proof {
    let mut valid: Bool = true;
    if a_x.len() == 0 { valid = false; }
    if a_y.len() == 0 { valid = false; }
    if b_x0.len() == 0 { valid = false; }
    if b_x1.len() == 0 { valid = false; }
    if b_y0.len() == 0 { valid = false; }
    if b_y1.len() == 0 { valid = false; }
    if c_x.len() == 0 { valid = false; }
    if c_y.len() == 0 { valid = false; }

    return Groth16Proof {
        proof_id: proof_id,
        curve_id: curve_id,
        a_g1_x: a_x,
        a_g1_y: a_y,
        b_g2_x0: b_x0,
        b_g2_x1: b_x1,
        b_g2_y0: b_y0,
        b_g2_y1: b_y1,
        c_g1_x: c_x,
        c_g1_y: c_y,
        is_compressed: compressed,
        is_valid: valid
    };
}

pub fn groth16_proof_validate_format(proof_ref: &Groth16Proof) -> Bool {
    let is_v: Bool = (proof_ref).is_valid;
    if is_v == false {
        return false;
    }
    let cur_id: Int = (proof_ref).curve_id;
    if cur_id <= 0 {
        return false;
    }
    let ax: String = (proof_ref).a_g1_x;
    if ax.len() == 0 { return false; }
    let ay: String = (proof_ref).a_g1_y;
    if ay.len() == 0 { return false; }
    let cx: String = (proof_ref).c_g1_x;
    if cx.len() == 0 { return false; }
    let cy: String = (proof_ref).c_g1_y;
    if cy.len() == 0 { return false; }
    return true;
}

pub fn groth16_proof_to_string(proof_ref: &Groth16Proof) -> String {
    let pid: String = (proof_ref).proof_id;
    let cur_id: Int = (proof_ref).curve_id;
    let cid: String = cur_id.to_string();
    let ax: String = (proof_ref).a_g1_x;
    let cx: String = (proof_ref).c_g1_x;
    return "Groth16Proof[" + pid + ", Curve:" + cid + "] A_x:" + ax + " C_x:" + cx;
}

pub fn groth16_vk_create(
    vk_id: String,
    curve_id: Int,
    num_pub_inputs: Int,
    alpha_x: String,
    alpha_y: String,
    beta_x0: String,
    beta_x1: String,
    beta_y0: String,
    beta_y1: String,
    gamma_x0: String,
    gamma_x1: String,
    gamma_y0: String,
    gamma_y1: String,
    delta_x0: String,
    delta_x1: String,
    delta_y0: String,
    delta_y1: String,
    ic_x: List[String],
    ic_y: List[String]
) -> Groth16Vk {
    let mut valid: Bool = true;
    let ic_len_x: Int = list_len(ic_x);
    let ic_len_y: Int = list_len(ic_y);

    if num_pub_inputs < 0 { valid = false; }
    let expected_ic_count: Int = num_pub_inputs + 1;
    if ic_len_x != expected_ic_count { valid = false; }
    if ic_len_y != expected_ic_count { valid = false; }
    if alpha_x.len() == 0 { valid = false; }
    if alpha_y.len() == 0 { valid = false; }
    if delta_x0.len() == 0 { valid = false; }

    return Groth16Vk {
        vk_id: vk_id,
        curve_id: curve_id,
        num_public_inputs: num_pub_inputs,
        alpha_g1_x: alpha_x,
        alpha_g1_y: alpha_y,
        beta_g2_x0: beta_x0,
        beta_g2_x1: beta_x1,
        beta_g2_y0: beta_y0,
        beta_g2_y1: beta_y1,
        gamma_g2_x0: gamma_x0,
        gamma_g2_x1: gamma_x1,
        gamma_g2_y0: gamma_y0,
        gamma_g2_y1: gamma_y1,
        delta_g2_x0: delta_x0,
        delta_g2_x1: delta_x1,
        delta_g2_y0: delta_y0,
        delta_g2_y1: delta_y1,
        ic_g1_x: ic_x,
        ic_g1_y: ic_y,
        is_valid: valid
    };
}

pub fn groth16_vk_validate(vk_ref: &Groth16Vk) -> Bool {
    let is_v: Bool = (vk_ref).is_valid;
    if is_v == false { return false; }
    let num_in: Int = (vk_ref).num_public_inputs;
    let expected_ic_len: Int = num_in + 1;
    let ic_x: List[String] = (vk_ref).ic_g1_x;
    let ic_y: List[String] = (vk_ref).ic_g1_y;
    let actual_ic_x: Int = list_len(ic_x);
    let actual_ic_y: Int = list_len(ic_y);
    if actual_ic_x != expected_ic_len { return false; }
    if actual_ic_y != expected_ic_len { return false; }
    return true;
}

pub fn groth16_vk_get_ic_element(vk_ref: &Groth16Vk, index: Int) -> Result[String, String] {
    let ic_x: List[String] = (vk_ref).ic_g1_x;
    let ic_y: List[String] = (vk_ref).ic_g1_y;
    let total: Int = list_len(ic_x);
    if index < 0 { return Err("IC index below zero"); }
    if index >= total { return Err("IC index out of bounds"); }
    let px: String = list_get(ic_x, index);
    let py: String = list_get(ic_y, index);
    let idx_str: String = index.to_string();
    return Ok("IC[" + idx_str + "](" + px + ", " + py + ")");
}
