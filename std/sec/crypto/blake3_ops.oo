pub fn blake3_iv_words() -> List[Int] {
    let mut iv: List[Int] = list_new();
    iv = list_push(iv, 1779033703);
    iv = list_push(iv, 3144134277);
    iv = list_push(iv, 1013904242);
    iv = list_push(iv, 2773480762);
    iv = list_push(iv, 1359899263);
    iv = list_push(iv, 2600822924);
    iv = list_push(iv, 528734635);
    iv = list_push(iv, 1541459737);
    return iv;
}

pub fn blake3_msg_permutation() -> List[Int] {
    let mut perm: List[Int] = list_new();
    perm = list_push(perm, 2);
    perm = list_push(perm, 6);
    perm = list_push(perm, 3);
    perm = list_push(perm, 10);
    perm = list_push(perm, 7);
    perm = list_push(perm, 0);
    perm = list_push(perm, 4);
    perm = list_push(perm, 13);
    perm = list_push(perm, 1);
    perm = list_push(perm, 11);
    perm = list_push(perm, 12);
    perm = list_push(perm, 5);
    perm = list_push(perm, 9);
    perm = list_push(perm, 14);
    perm = list_push(perm, 15);
    perm = list_push(perm, 8);
    return perm;
}

pub fn blake3_flag_chunk_start() -> Int {
    return 1;
}

pub fn blake3_flag_chunk_end() -> Int {
    return 2;
}

pub fn blake3_flag_parent() -> Int {
    return 4;
}

pub fn blake3_flag_root() -> Int {
    return 8;
}

pub fn blake3_flag_keyed_hash() -> Int {
    return 16;
}

pub fn blake3_flag_derive_key_context() -> Int {
    return 32;
}

pub fn blake3_flag_derive_key_material() -> Int {
    return 64;
}

// -------------------------------------------------------------------
// Key / Chunk Constructors & Validation
// -------------------------------------------------------------------

pub fn blake3_key_create(key_id: String, raw_bytes: String) -> Result[Blake3Key, String] {
    let raw_len: Int = raw_bytes.len();
    if raw_len != 32 {
        return Err("INVALID_KEY_SIZE: BLAKE3 key must be exactly 32 bytes (256 bits)");
    }
    let chk: Int = blake3_checksum(raw_bytes);
    let key = Blake3Key {
        key_id: key_id,
        key_bytes: raw_bytes,
        checksum: chk,
        is_valid: true
    };
    return Ok(key);
}

pub fn blake3_key_validate(key: &Blake3Key) -> Bool {
    let k_valid: Bool = (key).is_valid;
    if k_valid == false {
        return false;
    }
    let raw: String = (key).key_bytes;
    let raw_len: Int = raw.len();
    if raw_len != 32 {
        return false;
    }
    let expected_chk: Int = blake3_checksum(raw);
    let k_chk: Int = (key).checksum;
    return k_chk == expected_chk;
}

pub fn blake3_chunk_state_init(cv: List[Int], chunk_counter: Int, flags: Int) -> Blake3ChunkState {
    return Blake3ChunkState {
        cv: cv,
        chunk_counter: chunk_counter,
        buf: "",
        buf_len: 0,
        blocks_compressed: 0,
        flags: flags,
        is_initialized: true
    };
}

pub fn blake3_chunk_state_validate(cs: &Blake3ChunkState) -> Bool {
    let is_init: Bool = (cs).is_initialized;
    if is_init == false {
        return false;
    }
    let cv_len: Int = list_len((cs).cv);
    if cv_len != 8 {
        return false;
    }
    let b_len: Int = (cs).buf_len;
    let buf_str: String = (cs).buf;
    let actual_buf_len: Int = buf_str.len();
    return b_len == actual_buf_len;
}


