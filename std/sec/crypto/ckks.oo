// # CKKS Facade
//
// Logline: Re-exports CKKS data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import CKKS companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 7 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./ckks_keys.oo";
import "./ckks_codec.oo";
import "./ckks_crypt.oo";
import "./ckks_ops.oo";
import "./ckks_engine.oo";
import "./ckks_stubs.oo";

pub fn shim_marker_checksum() -> Int {
    return ckks_calculate_checksum("abc");
}

pub fn shim_marker_params_create() -> CkksParams {
    return ckks_params_create(4096, 1073741824.0, 40, 128);
}

pub fn shim_marker_params_validate(p: &CkksParams) -> Result[Bool, String] {
    return ckks_params_validate(p);
}

pub fn shim_marker_public_key_create() -> CkksPublicKey {
    return ckks_public_key_create("pk1", "pk0_poly", "pk1_poly");
}

pub fn shim_marker_secret_key_create() -> CkksSecretKey {
    return ckks_secret_key_create("sk1", "sk_poly");
}

pub fn shim_marker_keypair_generate() -> CkksKeyPair {
    let p: CkksParams = ckks_params_create(4096, 1073741824.0, 40, 128);
    return ckks_keypair_generate("pair1", p);
}

pub fn shim_marker_encoder_init() -> CkksEncoder {
    let p: CkksParams = ckks_params_create(4096, 1073741824.0, 40, 128);
    return ckks_encoder_init("enc1", p, 1073741824.0);
}

pub fn shim_marker_context_init() -> CkksContext {
    let p: CkksParams = ckks_params_create(4096, 1073741824.0, 40, 128);
    let kp: CkksKeyPair = ckks_keypair_generate("pair1", p);
    return ckks_context_init("ctx1", kp);
}

pub fn shim_marker_context_do_work(ctx: &CkksContext) -> Int {
    return ckks_context_do_work(ctx);
}
