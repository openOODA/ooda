// # Falcon Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for FALCON.
//
// Setup: Imports companion modules for validated FALCON operations.
//
// Beats:
//   1. Import FALCON operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./falcon_keys.oo";

pub fn falcon_verify(
    public_key: FalconPublicKey,
    message: String,
    sig: FalconSignature
) -> FalconVerificationResult {
    if public_key.is_valid == false {
        return FalconVerificationResult {
            is_valid: false,
            norm_squared: 0,
            beta_threshold: 0,
            error_message: "Invalid public key",
        };
    }
    if sig.is_valid == false {
        return FalconVerificationResult {
            is_valid: false,
            norm_squared: 0,
            beta_threshold: 0,
            error_message: "Invalid signature payload",
        };
    }
    let degree: Int = public_key.degree;
    let sig_deg: Int = sig.degree;
    if sig_deg != degree {
        return FalconVerificationResult {
            is_valid: false,
            norm_squared: 0,
            beta_threshold: 0,
            error_message: "Mismatched Falcon polynomial degree",
        };
    }
    
    let params: FalconParams = falcon_params_init(degree);
    if params.is_valid == false {
        return FalconVerificationResult {
            is_valid: false,
            norm_squared: 0,
            beta_threshold: 0,
            error_message: "Unsupported Falcon degree",
        };
    }
    
    let q: Int = params.modulus;
    let beta_sq: Int = params.beta_sq;
    let pk_h: FalconPolynomial = public_key.h_poly;
    let sig_s2: FalconPolynomial = sig.s2_poly;
    let sig_salt: String = sig.nonce_salt;
    
    // 1. Hash message and salt to polynomial c in Z_q[x]/(x^N + 1)
    let c_poly: FalconPolynomial = falcon_hash_to_point(message, sig_salt, degree, q);
    
    // 2. Compute s2 * h mod (x^N + 1) mod q
    let s2_h_poly: FalconPolynomial = falcon_polynomial_schoolbook_mul(sig_s2, pk_h, q);
    
    // 3. Compute s1 = c - s2 * h mod q
    let s1_poly: FalconPolynomial = falcon_polynomial_sub(c_poly, s2_h_poly, q);
    
    // 4. Calculate centered norm squared of (s1, s2)
    let norm1: Int = falcon_polynomial_centered_squared_norm(s1_poly, q);
    let norm2: Int = falcon_polynomial_centered_squared_norm(sig_s2, q);
    let total_norm: Int = norm1 + norm2;
    
    // 5. Verify total squared norm does not exceed beta^2 threshold
    if total_norm > beta_sq {
        return FalconVerificationResult {
            is_valid: false,
            norm_squared: total_norm,
            beta_threshold: beta_sq,
            error_message: "Signature norm exceeds Falcon beta_sq threshold",
        };
    }
    
    return FalconVerificationResult {
        is_valid: true,
        norm_squared: total_norm,
        beta_threshold: beta_sq,
        error_message: "OK",
    };
}

pub fn falcon_batch_verifier_init(batch_id: String, degree: Int) -> FalconBatchVerifier {
    return FalconBatchVerifier {
        batch_id: batch_id,
        degree: degree,
        total_signatures: 0,
        valid_count: 0,
        invalid_count: 0,
        is_completed: false,
    };
}

pub fn falcon_batch_verifier_add(
    bv_ref: &mut FalconBatchVerifier,
    pk: FalconPublicKey,
    message: String,
    sig: FalconSignature
) {
    let ver_res: FalconVerificationResult = falcon_verify(pk, message, sig);
    (bv_ref).total_signatures = (bv_ref).total_signatures + 1;
    let ok: Bool = ver_res.is_valid;
    if ok {
        (bv_ref).valid_count = (bv_ref).valid_count + 1;
    } else {
        (bv_ref).invalid_count = (bv_ref).invalid_count + 1;
    }
}
