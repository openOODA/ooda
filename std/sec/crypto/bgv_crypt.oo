// # BGV Crypt and Homomorphic Evaluation
//
// Logline: Implements encryption, decryption, and evaluation routines for BGV.
//
// Setup: Imports companion modules for BGV evaluation.
//
// Beats:
//   1. Execute BGV encryption and decryption operations.
//   2. Implement homomorphic addition, multiplication, and relinearization.
//   3. Maintain noise budget and ciphertext correctness.

import "./bgv_types.oo";

pub fn bgv_encryptor_init(
    encryptor_id: String,
    pk: BgvPublicKey,
    params: BgvParams
) -> BgvEncryptor {
    let dummy_sk: BgvSecretKey = BgvSecretKey {
        key_id: "",
        sk_poly: "",
        checksum: 0,
        is_wiped: true,
        is_valid: false,
    };
    return BgvEncryptor {
        encryptor_id: encryptor_id,
        public_key: pk,
        secret_key: dummy_sk,
        params: params,
        uses_secret_key: false,
    };
}

pub fn bgv_encrypt(
    encryptor_ref: &BgvEncryptor,
    plain_ref: &BgvPlaintext
) -> Result[BgvCiphertext, String] {
    let pk_valid: Bool = (encryptor_ref).public_key.is_valid;
    if pk_valid == false {
        return Err("INVALID_KEY: Public key is invalid for asymmetric encryption");
    }
    let p_valid: Bool = (plain_ref).is_valid;
    if p_valid == false {
        return Err("INVALID_PLAINTEXT: Cannot encrypt invalid plaintext");
    }

    let poly_repr: String = (plain_ref).poly_repr;
    let c0: String = "bgv_c0_enc(" + poly_repr + ")";
    let c1: String = "bgv_c1_enc(" + poly_repr + ")";
    let enc_id: String = (encryptor_ref).encryptor_id;
    let p_id: String = (plain_ref).plain_id;
    let cid: String = "bgv_cipher_" + enc_id + "_" + p_id;
    let chk: Int = bgv_calculate_checksum(c0 + c1);
    let p_scale: Int = (plain_ref).scale;
    let p_level: Int = (plain_ref).level;

    let ciphertext: BgvCiphertext = BgvCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: "",
        degree: 2,
        scale: p_scale,
        level: p_level,
        noise_budget: 130,
        checksum: chk,
        is_valid: true,
    };
    return Ok(ciphertext);
}

pub fn bgv_encrypt_symmetric(
    encryptor_ref: &BgvEncryptor,
    sk_ref: &BgvSecretKey,
    plain_ref: &BgvPlaintext
) -> Result[BgvCiphertext, String] {
    let sk_valid: Bool = (sk_ref).is_valid;
    let sk_wiped: Bool = (sk_ref).is_wiped;
    if sk_valid == false || sk_wiped == true {
        return Err("INVALID_KEY: Secret key is invalid or wiped for symmetric encryption");
    }
    let p_valid: Bool = (plain_ref).is_valid;
    if p_valid == false {
        return Err("INVALID_PLAINTEXT: Cannot encrypt invalid plaintext");
    }

    let poly_repr: String = (plain_ref).poly_repr;
    let c0: String = "bgv_c0_sym_enc(" + poly_repr + ")";
    let c1: String = "bgv_c1_sym_enc(" + poly_repr + ")";
    let enc_id: String = (encryptor_ref).encryptor_id;
    let p_id: String = (plain_ref).plain_id;
    let cid: String = "bgv_cipher_sym_" + enc_id + "_" + p_id;
    let chk: Int = bgv_calculate_checksum(c0 + c1);
    let p_scale: Int = (plain_ref).scale;
    let p_level: Int = (plain_ref).level;

    let ciphertext: BgvCiphertext = BgvCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: "",
        degree: 2,
        scale: p_scale,
        level: p_level,
        noise_budget: 150,
        checksum: chk,
        is_valid: true,
    };
    return Ok(ciphertext);
}

pub fn bgv_encrypt_with_capability(
    sys_cap: &SysCap,
    encryptor_ref: &BgvEncryptor,
    plain_ref: &BgvPlaintext
) -> Result[BgvCiphertext, String] {
    return bgv_encrypt(encryptor_ref, plain_ref);
}

pub fn bgv_decryptor_init(
    decryptor_id: String,
    sk: BgvSecretKey,
    params: BgvParams
) -> BgvDecryptor {
    return BgvDecryptor {
        decryptor_id: decryptor_id,
        secret_key: sk,
        params: params,
    };
}

pub fn bgv_decrypt(
    decryptor_ref: &BgvDecryptor,
    cipher_ref: &BgvCiphertext
) -> Result[BgvPlaintext, String] {
    let sk_valid: Bool = (decryptor_ref).secret_key.is_valid;
    let sk_wiped: Bool = (decryptor_ref).secret_key.is_wiped;
    if sk_valid == false || sk_wiped == true {
        return Err("INVALID_KEY: Secret key is invalid or wiped for decryption");
    }
    let c_valid: Bool = (cipher_ref).is_valid;
    if c_valid == false {
        return Err("INVALID_CIPHERTEXT: Cannot decrypt invalid ciphertext");
    }
    let noise: Int = (cipher_ref).noise_budget;
    if noise <= 0 {
        return Err("NOISE_EXHAUSTED: Noise budget depleted, decryption impossible");
    }

    let chk: Int = (cipher_ref).checksum;
    let p_mod: Int = (decryptor_ref).params.plain_modulus;
    let plain_val: Int = chk % p_mod;
    let c_id: String = (cipher_ref).cipher_id;
    let pid: String = "bgv_dec_" + c_id;
    let c_scale: Int = (cipher_ref).scale;
    let c_level: Int = (cipher_ref).level;

    let plain: BgvPlaintext = BgvPlaintext {
        plain_id: pid,
        value: plain_val,
        poly_repr: plain_val.to_string(),
        scale: c_scale,
        level: c_level,
        is_ntt_form: false,
        is_valid: true,
    };
    return Ok(plain);
}

pub fn bgv_decrypt_with_capability(
    sys_cap: &SysCap,
    decryptor_ref: &BgvDecryptor,
    cipher_ref: &BgvCiphertext
) -> Result[BgvPlaintext, String] {
    return bgv_decrypt(decryptor_ref, cipher_ref);
}

pub fn bgv_crypt_probe() -> Int {
    return 0;
}
