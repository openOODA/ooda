// # RSA-PSS Params
//
// Logline: Provides rsa-pss params primitives and operations for openOODA standard library.
//
// Setup: Imports companion modules for RSA operations.
//
// Beats:
//   1. Import RSA types and dependencies.
//   2. Execute rsa-pss params operations.
//   3. Provide validation and lifecycle routines.

import "./rsa_pss_types.oo";

// -------------------------------------------------------------------
// Parameter Set Initialization & Validation
// -------------------------------------------------------------------

pub fn rsa_pss_params_2048() -> RsaPssParams {
    return RsaPssParams {
        is_valid: true,
        key_bits: 2048,
        hash_alg: "SHA-256",
        mgf_alg: "MGF1-SHA256",
        salt_len: 32,
        trailer_field: 188,
    };
}

pub fn rsa_pss_params_3072() -> RsaPssParams {
    return RsaPssParams {
        is_valid: true,
        key_bits: 3072,
        hash_alg: "SHA-384",
        mgf_alg: "MGF1-SHA384",
        salt_len: 48,
        trailer_field: 188,
    };
}

pub fn rsa_pss_params_4096() -> RsaPssParams {
    return RsaPssParams {
        is_valid: true,
        key_bits: 4096,
        hash_alg: "SHA-512",
        mgf_alg: "MGF1-SHA512",
        salt_len: 64,
        trailer_field: 188,
    };
}

pub fn rsa_pss_params_init(key_bits: Int, hash_alg: String, salt_len: Int) -> RsaPssParams {
    if key_bits < 2048 {
        return RsaPssParams {
            is_valid: false,
            key_bits: key_bits,
            hash_alg: hash_alg,
            mgf_alg: "INVALID",
            salt_len: 0,
            trailer_field: 0,
        };
    }
    let mgf_name: String = "MGF1-" + hash_alg;
    return RsaPssParams {
        is_valid: true,
        key_bits: key_bits,
        hash_alg: hash_alg,
        mgf_alg: mgf_name,
        salt_len: salt_len,
        trailer_field: 188,
    };
}

pub fn rsa_pss_params_validate(params: RsaPssParams) -> Result[Bool, String] {
    if params.is_valid == false {
        return Err("RsaPssError: Invalid parameter set");
    }
    if params.key_bits < 2048 {
        return Err("RsaPssError: RSA key size must be at least 2048 bits");
    }
    if params.salt_len < 0 {
        return Err("RsaPssError: Salt length cannot be negative");
    }
    if params.trailer_field != 188 {
        return Err("RsaPssError: Trailer field must be 0xBC (188)");
    }
    return Ok(true);
}

// -------------------------------------------------------------------
// Helper Functions & Field Calculations
// -------------------------------------------------------------------

pub fn rsa_checksum(raw_bytes: String) -> Int {
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < raw_len {
        let ch: Int = byte_at(raw_bytes, i);
        let hash_x33: Int = hash * 33;
        hash = hash_x33 + ch;
        i = i + 1;
    }
    return hash;
}

pub fn byte_to_hex_pair(val_byte: Int) -> String {
    let hex_chars: String = "0123456789abcdef";
    let div16: Int = val_byte / 16;
    let hi: Int = div16 % 16;
    let lo: Int = val_byte % 16;
    let mut res: List[Int] = bytes_new();
    res = bytes_push(res, byte_at(hex_chars, hi));
    res = bytes_push(res, byte_at(hex_chars, lo));
    return bytes_to_str(res);
}

pub fn rsa_key_validate(pub_key: RsaPublicKey) -> Bool {
    if pub_key.is_valid == false {
        return false;
    }
    if pub_key.bit_len < 2048 {
        return false;
    }
    if pub_key.exponent_e <= 1 {
        return false;
    }
    let mod_n: String = pub_key.modulus_n;
    let mod_len: Int = mod_n.len();
    if mod_len == 0 {
        return false;
    }
    return true;
}

pub fn rsa_priv_key_validate(priv_key: RsaPrivateKey) -> Bool {
    if priv_key.is_valid == false {
        return false;
    }
    if priv_key.bit_len < 2048 {
        return false;
    }
    let priv_d: String = priv_key.private_d;
    let d_len: Int = priv_d.len();
    if d_len == 0 {
        return false;
    }
    return true;
}
