// # zk-SNARK Hash and Hash Utilities
//
// Logline: Calculates cryptographic digests, Fiat-Shamir challenges, and string hashes for ZKSNARK.
//
// Setup: Imports zksnark_types.oo for hash structures.
//
// Beats:
//   1. Compute cryptographic hashes over transcripts and statements.
//   2. Generate Fiat-Shamir challenge scalars.
//   3. Provide checksum and string formatting utilities.

import "./zksnark_types.oo";

pub fn zksnark_calculate_string_hash(s: String) -> Int {
    let len: Int = s.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < len {
        let ch: Int = byte_at(s, i);
        hash = (hash * 33) + ch;
        if hash < 0 {
            hash = 0 - hash;
        }
        i = i + 1;
    }
    return hash;
}

pub fn zksnark_proof_calculate_checksum(proof: ZkProof) -> Int {
    let pid_h: Int = zksnark_calculate_string_hash(proof.proof_id);
    let a_h: Int = zksnark_calculate_string_hash(proof.a_g1);
    let b_h: Int = zksnark_calculate_string_hash(proof.b_g2);
    let c_h: Int = zksnark_calculate_string_hash(proof.c_g1);
    let proto_h: Int = zksnark_calculate_string_hash(proof.protocol);
    let curve_h: Int = zksnark_calculate_string_hash(proof.curve);
    let inputs: List[String] = proof.public_inputs;
    let input_count: Int = list_len(inputs);

    let mut cs: Int = pid_h * 13 + a_h * 17 + b_h * 19 + c_h * 23 + proto_h * 29 + curve_h * 31 + input_count * 37;
    if proof.is_valid {
        cs = cs + 10007;
    }
    if cs < 0 {
        cs = 0 - cs;
    }
    return cs;
}

pub fn zksnark_vk_calculate_checksum(vk: VerificationKey) -> Int {
    let vkid_h: Int = zksnark_calculate_string_hash(vk.vk_id);
    let alpha_h: Int = zksnark_calculate_string_hash(vk.alpha_g1);
    let beta_h: Int = zksnark_calculate_string_hash(vk.beta_g2);
    let gamma_h: Int = zksnark_calculate_string_hash(vk.gamma_g2);
    let delta_h: Int = zksnark_calculate_string_hash(vk.delta_g2);
    let ic_len: Int = list_len(vk.ic);
    let num_inputs: Int = vk.num_public_inputs;

    let mut cs: Int = vkid_h * 11 + alpha_h * 13 + beta_h * 17 + gamma_h * 19 + delta_h * 23 + ic_len * 29 + num_inputs * 31;
    if vk.is_active {
        cs = cs + 20011;
    }
    if cs < 0 {
        cs = 0 - cs;
    }
    return cs;
}

pub fn zk_proof_to_string(proof: ZkProof) -> String {
    let pid: String = proof.proof_id;
    let proto: String = proof.protocol;
    let curve: String = proof.curve;
    let inputs: List[String] = proof.public_inputs;
    let input_len: Int = list_len(inputs);
    let input_len_str: String = input_len.to_string();

    return "ZkProof[" + pid + "] Proto:" + proto + " Curve:" + curve + " InputsCount:" + input_len_str;
}

pub fn verification_key_to_string(vk: VerificationKey) -> String {
    let vkid: String = vk.vk_id;
    let proto: String = vk.protocol;
    let curve: String = vk.curve;
    let num_in: Int = vk.num_public_inputs;
    let num_in_str: String = num_in.to_string();

    return "VerificationKey[" + vkid + "] Proto:" + proto + " Curve:" + curve + " MaxInputs:" + num_in_str;
}

pub fn proving_key_to_string(pk: ProvingKey) -> String {
    let pkid: String = pk.pk_id;
    let vkid: String = pk.vk_id;
    let constraints: Int = pk.constraint_count;
    let c_str: String = constraints.to_string();

    return "ProvingKey[" + pkid + "] LinkedVK:" + vkid + " Constraints:" + c_str;
}
