// # BGV Codec and Plaintext Encodings
//
// Logline: Encodes and decodes plaintexts and polynomial representations for BGV.
//
// Setup: Imports bgv_types.oo for codec structures.
//
// Beats:
//   1. Encode scalar values and vectors into BGV plaintexts.
//   2. Decode decrypted ciphertexts back to plain text representations.
//   3. Provide batch encoding and decoding utilities.

import "./bgv_types.oo";

// -------------------------------------------------------------------
// Encoder & Encryption Pipeline
// -------------------------------------------------------------------

pub fn bgv_encoder_init(encoder_id: String, params: BgvParams) -> BgvEncoder {
    let slots: Int = params.poly_modulus_degree;
    let valid: Bool = params.is_valid;
    return BgvEncoder {
        encoder_id: encoder_id,
        slots: slots,
        params: params,
        is_initialized: valid,
    };
}

pub fn bgv_encode_int(encoder_ref: &BgvEncoder, value: Int) -> BgvPlaintext {
    let p_mod: Int = (encoder_ref).params.plain_modulus;
    let mut val: Int = value;
    if p_mod > 0 {
        val = value % p_mod;
    }
    let p_str: String = val.to_string();
    let enc_id: String = (encoder_ref).encoder_id;
    let enc_init: Bool = (encoder_ref).is_initialized;
    let pid: String = "bgv_plain_" + enc_id + "_" + p_str;
    return BgvPlaintext {
        plain_id: pid,
        value: val,
        poly_repr: p_str,
        scale: 1,
        level: 0,
        is_ntt_form: false,
        is_valid: enc_init,
    };
}

pub fn bgv_encode_vector(
    encoder_ref: &BgvEncoder,
    values: List[Int]
) -> Result[BgvPlaintext, String] {
    let enc_init: Bool = (encoder_ref).is_initialized;
    if enc_init == false {
        return Err("INVALID_ENCODER: BGV encoder is not initialized");
    }
    let val_len: Int = list_len(values);
    let max_slots: Int = (encoder_ref).slots;
    if val_len > max_slots {
        return Err("SLOT_OVERFLOW: Input vector length exceeds slot count");
    }

    let mut poly_str: String = "bgv_poly_vec[";
    let mut i: Int = 0;
    let p_mod: Int = (encoder_ref).params.plain_modulus;
    while i < val_len {
        let raw_v: Int = list_get(values, i);
        let v: Int = if p_mod > 0 { raw_v % p_mod } else { raw_v };
        let idx_str: String = v.to_string();
        poly_str = poly_str + idx_str + ",";
        i = i + 1;
    }
    poly_str = poly_str + "]";

    let enc_id: String = (encoder_ref).encoder_id;
    let len_str: String = val_len.to_string();
    let pid: String = "bgv_plain_vec_" + enc_id + "_" + len_str;
    let plain: BgvPlaintext = BgvPlaintext {
        plain_id: pid,
        value: val_len,
        poly_repr: poly_str,
        scale: 1,
        level: 0,
        is_ntt_form: false,
        is_valid: true,
    };
    return Ok(plain);
}

pub fn bgv_decode_int(encoder_ref: &BgvEncoder, plain_ref: &BgvPlaintext) -> Result[Int, String] {
    let enc_init: Bool = (encoder_ref).is_initialized;
    let plain_valid: Bool = (plain_ref).is_valid;
    let val: Int = (plain_ref).value;

    if enc_init == false {
        return Err("Encoder is not initialized");
    }
    if plain_valid == false {
        return Err("Plaintext is invalid");
    }
    return Ok(val);
}

pub fn bgv_decode_vector(
    encoder_ref: &BgvEncoder,
    plain_ref: &BgvPlaintext
) -> Result[List[Int], String] {
    let enc_init: Bool = (encoder_ref).is_initialized;
    let plain_valid: Bool = (plain_ref).is_valid;

    if enc_init == false {
        return Err("INVALID_ENCODER: Encoder is not initialized");
    }
    if plain_valid == false {
        return Err("INVALID_PLAINTEXT: Cannot decode invalid plaintext");
    }

    let n: Int = (plain_ref).value;
    let mut decoded_vec: List[Int] = [];
    let mut i: Int = 0;
    while i < n {
        decoded_vec = list_push(decoded_vec, i);
        i = i + 1;
    }
    return Ok(decoded_vec);
}
