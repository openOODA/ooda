// # Groth16 Verifier Engine and Batching
//
// Logline: Structural proof verification, input matching, batch verifiers, and setup parameter models for Groth16.
//
// Setup: Stateful verifier execution and batch proof processing for zk-SNARK circuits.
//
// Beats:
//   1. Initialize Groth16 verifier instance with verifying key and strict mode settings.
//   2. Perform structural proof verification and public input count matching.
//   3. Manage batch verifier queue insertion, size tracking, and reset operations.
//   4. Compute operational work metrics and validate circuit trusted setup completeness.

import "./groth16_types.oo";
import "./groth16_ops.oo";

pub fn groth16_verifier_init(verifier_id: String, vk: Groth16Vk, strict_mode: Bool) -> Groth16Verifier {
    let is_v: Bool = vk.is_valid;
    let mut active: Bool = true;
    if is_v == false {
        active = false;
    }
    return Groth16Verifier {
        verifier_id: verifier_id,
        vk: vk,
        verified_count: 0,
        rejected_count: 0,
        strict_mode: strict_mode,
        is_active: active,
    };
}

pub fn groth16_verify_input_match(vk_ref: &Groth16Vk, inputs_ref: &PublicInputs) -> Bool {
    let in_cnt: Int = (inputs_ref).scalar_count;
    let vk_cnt: Int = (vk_ref).num_public_inputs;
    if in_cnt != vk_cnt {
        return false;
    }
    return true;
}

pub fn groth16_verifier_verify_structural(
    verifier_mut: &mut Groth16Verifier,
    proof_ref: &Groth16Proof,
    inputs_ref: &PublicInputs
) -> Groth16VerificationResult {
    let is_act: Bool = (verifier_mut).is_active;
    if is_act == false {
        let r_cnt: Int = (verifier_mut).rejected_count;
        (verifier_mut).rejected_count = r_cnt + 1;
        return Groth16VerificationResult {
            is_valid: false,
            pairing_satisfied: false,
            inputs_matched: false,
            error_message: "Verifier is inactive",
        };
    }

    let vk_ref: &Groth16Vk = &((verifier_mut).vk);
    if groth16_vk_validate(vk_ref) == false {
        let r_cnt: Int = (verifier_mut).rejected_count;
        (verifier_mut).rejected_count = r_cnt + 1;
        return Groth16VerificationResult {
            is_valid: false,
            pairing_satisfied: false,
            inputs_matched: false,
            error_message: "Verifying key invalid",
        };
    }

    if groth16_proof_validate_format(proof_ref) == false {
        let r_cnt: Int = (verifier_mut).rejected_count;
        (verifier_mut).rejected_count = r_cnt + 1;
        return Groth16VerificationResult {
            is_valid: false,
            pairing_satisfied: false,
            inputs_matched: false,
            error_message: "Proof format invalid",
        };
    }

    let p_cid: Int = (proof_ref).curve_id;
    let vk_cid: Int = vk_ref.curve_id;
    if p_cid != vk_cid {
        let r_cnt: Int = (verifier_mut).rejected_count;
        (verifier_mut).rejected_count = r_cnt + 1;
        return Groth16VerificationResult {
            is_valid: false,
            pairing_satisfied: false,
            inputs_matched: false,
            error_message: "Curve ID mismatch between proof and VK",
        };
    }

    let inputs_ok: Bool = groth16_verify_input_match(vk_ref, inputs_ref);
    if inputs_ok == false {
        let r_cnt: Int = (verifier_mut).rejected_count;
        (verifier_mut).rejected_count = r_cnt + 1;
        return Groth16VerificationResult {
            is_valid: false,
            pairing_satisfied: false,
            inputs_matched: false,
            error_message: "Public inputs count does not match verifying key",
        };
    }

    let is_wf: Bool = (inputs_ref).is_well_formed;
    if is_wf == false {
        let r_cnt: Int = (verifier_mut).rejected_count;
        (verifier_mut).rejected_count = r_cnt + 1;
        return Groth16VerificationResult {
            is_valid: false,
            pairing_satisfied: false,
            inputs_matched: true,
            error_message: "Public inputs are malformed",
        };
    }

    let v_cnt: Int = (verifier_mut).verified_count;
    (verifier_mut).verified_count = v_cnt + 1;
    return Groth16VerificationResult {
        is_valid: true,
        pairing_satisfied: true,
        inputs_matched: true,
        error_message: "",
    };
}

pub fn groth16_batch_verifier_init(batch_id: String) -> Groth16BatchVerifier {
    let empty_proofs: List[Groth16Proof] = list_new();
    let empty_inputs: List[PublicInputs] = list_new();
    return Groth16BatchVerifier {
        batch_id: batch_id,
        proofs: empty_proofs,
        inputs_list: empty_inputs,
        batch_size: 0,
        is_closed: false,
    };
}

pub fn groth16_batch_verifier_add(
    batch_mut: &mut Groth16BatchVerifier,
    proof: Groth16Proof,
    inputs: PublicInputs
) -> Bool {
    let is_c: Bool = (batch_mut).is_closed;
    if is_c {
        return false;
    }
    let cur_p: List[Groth16Proof] = (batch_mut).proofs;
    let cur_i: List[PublicInputs] = (batch_mut).inputs_list;

    let new_p: List[Groth16Proof] = list_push(cur_p, proof);
    let new_i: List[PublicInputs] = list_push(cur_i, inputs);

    (batch_mut).proofs = new_p;
    (batch_mut).inputs_list = new_i;
    (batch_mut).batch_size = list_len(new_p);
    return true;
}

pub fn groth16_batch_verifier_clear(batch_mut: &mut Groth16BatchVerifier) {
    let empty_proofs: List[Groth16Proof] = list_new();
    let empty_inputs: List[PublicInputs] = list_new();
    (batch_mut).proofs = empty_proofs;
    (batch_mut).inputs_list = empty_inputs;
    (batch_mut).batch_size = 0;
    (batch_mut).is_closed = false;
}

pub fn groth16_setup_params_init(
    circuit_name: String,
    curve_id: Int,
    num_constraints: Int,
    num_variables: Int,
    num_public_inputs: Int
) -> Groth16SetupParams {
    let mut complete: Bool = true;
    if num_constraints <= 0 { complete = false; }
    if num_variables <= 0 { complete = false; }
    if num_public_inputs <= 0 { complete = false; }

    return Groth16SetupParams {
        circuit_name: circuit_name,
        curve_id: curve_id,
        num_constraints: num_constraints,
        num_variables: num_variables,
        num_public_inputs: num_public_inputs,
        is_trusted_setup_complete: complete,
    };
}

pub fn groth16_do_work(verifier_ref: &Groth16Verifier) -> Int {
    let v_cnt: Int = (verifier_ref).verified_count;
    let r_cnt: Int = (verifier_ref).rejected_count;
    let vk_ref: &Groth16Vk = &((verifier_ref).vk);
    let num_in: Int = vk_ref.num_public_inputs;
    return v_cnt + r_cnt * 2 + num_in * 3;
}
