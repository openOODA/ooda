pub fn shim_marker_tpm_checksum() -> Int {
    return tpm_checksum("abc");
}

pub fn shim_marker_hex_encode() -> String {
    return tpm_hex_encode("TPM2.0");
}

pub fn shim_marker_hex_decode(s: String) -> Result[String, String] {
    return tpm_hex_decode(s);
}

pub fn shim_marker_nv_new(id: Int, sz: Int, flags: Int) -> TpmNvIndex {
    return tpm_nv_new(id, sz, flags);
}

pub fn shim_marker_constant_time_eq(a: String, b: String) -> Bool {
    return tpm_constant_time_eq(a, b);
}

