// # TPM 2.0 Attestation and Cryptography Facade
//
// Logline: Re-exports TPM 2.0 data types, operations, engine management, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import TPM companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream attestation consumers.

import "./tpm_types.oo";
import "./tpm_ops.oo";
import "./tpm_engine.oo";
import "./tpm_stubs.oo";

pub fn shim_marker_tpm_checksum() -> Int {
    return tpm_checksum("abc");
}

pub fn shim_marker_nv_index() -> Result[TpmNvIndex, String] {
    return tpm_nv_index_create(1, "NV_TEST", 32, "DATA");
}

pub fn shim_marker_pcr_bank() -> PcrBank {
    return tpm_pcr_bank_init("SHA256", "SHA256");
}

pub fn shim_marker_key_handle() -> TpmKeyHandle {
    return tpm_key_handle_create(1, "TPM_RH_OWNER", "RSA2048", "PUB");
}

pub fn shim_marker_engine_init() -> TpmEngine {
    let p: TpmSecurityPolicy = tpm_security_policy_default();
    let b: PcrBank = tpm_pcr_bank_init("SHA256", "SHA256");
    return tpm_engine_init("eng_tpm", p, b);
}

verify tpm {
    let raw: String = "TPM2.0";
    let encoded: String = tpm_hex_encode(raw);
    let decoded_res: Result[String, String] = tpm_hex_decode(encoded);
    let decoded: String = match decoded_res {
        Ok(s) => s,
        Err(e) => "",
    };
    assert_eq!(decoded, raw);

    let eq_res: Bool = tpm_constant_time_eq("nonce123", "nonce123");
    assert_eq!(eq_res, true);
    let ne_res: Bool = tpm_constant_time_eq("nonce123", "nonce456");
    assert_eq!(ne_res, false);

    let nv_res: Result[TpmNvIndex, String] = tpm_nv_index_create(1, "NV_LOCK_STATE", 64, "LOCKED_SECURE_BOOT");
    let nv: TpmNvIndex = match nv_res {
        Ok(idx) => idx,
        Err(e) => TpmNvIndex {
            key_id: "NV_1",
            index_id: 0,
            name: "",
            data_size: 0,
            attr_flags: 0,
            auth_policy: "",
            data: "",
            checksum: 0,
            is_valid: false,
        },
    };
    assert_eq!(nv.is_valid, true);
    assert_eq!(tpm_nv_index_validate(&nv), true);

    let mut bank: PcrBank = tpm_pcr_bank_init("SHA256", "SHA256");
    assert_eq!(tpm_pcr_bank_validate(&bank), true);
    let ext_res: Result[Bool, String] = tpm_pcr_extend_soft(&mut bank, 7, "a1b2c3d4e5f6");
    let ext_ok: Bool = match ext_res {
        Ok(b) => b,
        Err(e) => false,
    };
    assert_eq!(ext_ok, true);

    let key: TpmKeyHandle = tpm_key_handle_create(2147483649, "TPM_RH_OWNER", "RSA2048", "PUB_KEY_BYTES_3072");
    assert_eq!(tpm_key_handle_validate(&key), true);

    let clk_info: TpmClockInfo = tpm_clock_info_create(1234567, 1, 2);
    let att_res: Result[TpmAttestation, String] = tpm_attestation_create(
        "QUOTE_001",
        "AIK_SIGNER_001",
        "NONCE_CHALLENGE_99",
        clk_info,
        bank,
        "RSASSA-SHA256",
        "SIG_BYTES_DATA"
    );
    let att: TpmAttestation = match att_res {
        Ok(a) => a,
        Err(e) => TpmAttestation {
            key_id: "",
            quote_id: "",
            magic: 0,
            attestation_type: "",
            qualified_signer: "",
            extra_data: "",
            clock_info: clk_info,
            firmware_version: 0,
            pcr_bank: bank,
            pcr_digest: "",
            signature_alg: "",
            signature_bytes: "",
            checksum: 0,
            is_valid: false,
        },
    };
    assert_eq!(att.is_valid, true);
    assert_eq!(tpm_attestation_validate(&att), true);

    let q_res: TpmQuoteResult = tpm_attestation_verify_soft(&att, "NONCE_CHALLENGE_99");
    assert_eq!(q_res.is_valid, true);

    let pol: TpmSecurityPolicy = tpm_security_policy_default();
    let mut engine: TpmEngine = tpm_engine_init("TPM_ENGINE_01", pol, bank);

    let reg_nv: Result[Bool, String] = tpm_engine_register_nv_index(&mut engine, nv);
    let reg_nv_ok: Bool = match reg_nv { Ok(b) => b, Err(e) => false };
    assert_eq!(reg_nv_ok, true);

    let reg_key: Result[Bool, String] = tpm_engine_register_key(&mut engine, key);
    let reg_key_ok: Bool = match reg_key { Ok(b) => b, Err(e) => false };
    assert_eq!(reg_key_ok, true);

    let reg_att: Result[Bool, String] = tpm_engine_register_attestation(&mut engine, att);
    let reg_att_ok: Bool = match reg_att { Ok(b) => b, Err(e) => false };
    assert_eq!(reg_att_ok, true);

    let work_val: Int = tpm_engine_do_work(&engine);
    assert_eq!(work_val > 0, true);
}
