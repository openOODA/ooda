// # BFV Crypt and Homomorphic Evaluation
//
// Logline: Implements encryption, decryption, and evaluation routines for BFV.
//
// Setup: Imports destubbed bfv_types.oo (Int-floor BfvParameters).
//
// Beats:
//   1. Execute BFV encryption and decryption operations.
//   2. Implement homomorphic addition, multiplication, and relinearization.
//   3. Maintain noise budget and ciphertext correctness.

import "./bfv_types.oo";

pub fn bfv_encryptor_init(poly_degree: Int, plain_mod: Int, coeff_bits: Int) -> BfvParameters {
    return bfv_params_new(poly_degree, plain_mod, coeff_bits);
}

pub fn bfv_encrypt_flags(p: BfvParameters) -> Int {
    return bfv_params_flags(p);
}

pub fn bfv_encrypt_degree(p: BfvParameters) -> Int {
    return bfv_params_degree(p);
}

pub fn bfv_crypt_work(poly_degree: Int, plain_mod: Int, coeff_bits: Int) -> Int {
    let p: BfvParameters = bfv_params_new(poly_degree, plain_mod, coeff_bits);
    return bfv_params_flags(p) + bfv_params_degree(p);
}
