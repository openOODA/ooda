// # BFV Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for BFV.
//
// Setup: Imports bfv_types.oo for data structure definitions.
//
// Beats:
//   1. Import BFV types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./bfv_types.oo";

pub fn bfv_evaluator_init(
    evaluator_id: String,
    params: BfvParameters,
    relin_keys: BfvRelinKeys,
    galois_keys: BfvGaloisKeys
) -> BfvEvaluator {
    return BfvEvaluator {
        evaluator_id: evaluator_id,
        params: params,
        relin_keys: relin_keys,
        galois_keys: galois_keys,
        ops_count: 0
    };
}

pub fn bfv_add(
    eval_ref: &mut BfvEvaluator,
    c1_ref: &BfvCiphertext,
    c2_ref: &BfvCiphertext
) -> Result[BfvCiphertext, String] {
    let c1_valid: Bool = (c1_ref).is_valid;
    let c2_valid: Bool = (c2_ref).is_valid;
    if c1_valid == false {
        return Err("INVALID_CIPHERTEXT: First operand is invalid");
    }
    if c2_valid == false {
        return Err("INVALID_CIPHERTEXT: Second operand is invalid");
    }

    let ops: Int = (eval_ref).ops_count;
    (eval_ref).ops_count = ops + 1;

    let c1_c0: String = (c1_ref).c0_poly;
    let c1_c1: String = (c1_ref).c1_poly;
    let c2_c0: String = (c2_ref).c0_poly;
    let c2_c1: String = (c2_ref).c1_poly;
    let c1_id: String = (c1_ref).cipher_id;
    let c2_id: String = (c2_ref).cipher_id;
    let n1: Int = (c1_ref).noise_budget;
    let n2: Int = (c2_ref).noise_budget;
    let scale: Int = (c1_ref).scale;
    let lvl: Int = (c1_ref).level;

    let c0: String = "(" + c1_c0 + " + " + c2_c0 + ")";
    let c1: String = "(" + c1_c1 + " + " + c2_c1 + ")";
    let cid: String = "add_" + c1_id + "_" + c2_id;
    let chk: Int = bfv_calculate_checksum(c0 + c1);

    let min_noise: Int = if n1 < n2 { n1 } else { n2 };
    let new_noise: Int = min_noise - 1;

    let res: BfvCiphertext = BfvCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: "",
        degree: 2,
        scale: scale,
        level: lvl,
        noise_budget: new_noise,
        checksum: chk,
        is_valid: true
    };
    return Ok(res);
}

pub fn bfv_add_plain(
    eval_ref: &mut BfvEvaluator,
    c_ref: &BfvCiphertext,
    p_ref: &BfvPlaintext
) -> Result[BfvCiphertext, String] {
    let c_valid: Bool = (c_ref).is_valid;
    let p_valid: Bool = (p_ref).is_valid;
    if c_valid == false {
        return Err("INVALID_CIPHERTEXT: Ciphertext operand is invalid");
    }
    if p_valid == false {
        return Err("INVALID_PLAINTEXT: Plaintext operand is invalid");
    }

    let ops: Int = (eval_ref).ops_count;
    (eval_ref).ops_count = ops + 1;

    let c_c0: String = (c_ref).c0_poly;
    let c_c1: String = (c_ref).c1_poly;
    let p_repr: String = (p_ref).poly_repr;
    let c_id: String = (c_ref).cipher_id;
    let p_id: String = (p_ref).plain_id;
    let n_budget: Int = (c_ref).noise_budget;
    let scale: Int = (c_ref).scale;
    let lvl: Int = (c_ref).level;

    let c0: String = "(" + c_c0 + " + " + p_repr + ")";
    let c1: String = c_c1;
    let cid: String = "addp_" + c_id + "_" + p_id;
    let chk: Int = bfv_calculate_checksum(c0 + c1);

    let res: BfvCiphertext = BfvCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: "",
        degree: 2,
        scale: scale,
        level: lvl,
        noise_budget: n_budget - 1,
        checksum: chk,
        is_valid: true
    };
    return Ok(res);
}

pub fn bfv_sub(
    eval_ref: &mut BfvEvaluator,
    c1_ref: &BfvCiphertext,
    c2_ref: &BfvCiphertext
) -> Result[BfvCiphertext, String] {
    let c1_valid: Bool = (c1_ref).is_valid;
    let c2_valid: Bool = (c2_ref).is_valid;
    if c1_valid == false {
        return Err("INVALID_CIPHERTEXT: First operand is invalid");
    }
    if c2_valid == false {
        return Err("INVALID_CIPHERTEXT: Second operand is invalid");
    }

    let ops: Int = (eval_ref).ops_count;
    (eval_ref).ops_count = ops + 1;

    let c1_c0: String = (c1_ref).c0_poly;
    let c1_c1: String = (c1_ref).c1_poly;
    let c2_c0: String = (c2_ref).c0_poly;
    let c2_c1: String = (c2_ref).c1_poly;
    let c1_id: String = (c1_ref).cipher_id;
    let c2_id: String = (c2_ref).cipher_id;
    let n1: Int = (c1_ref).noise_budget;
    let n2: Int = (c2_ref).noise_budget;
    let scale: Int = (c1_ref).scale;
    let lvl: Int = (c1_ref).level;

    let c0: String = "(" + c1_c0 + " - " + c2_c0 + ")";
    let c1: String = "(" + c1_c1 + " - " + c2_c1 + ")";
    let cid: String = "sub_" + c1_id + "_" + c2_id;
    let chk: Int = bfv_calculate_checksum(c0 + c1);

    let min_noise: Int = if n1 < n2 { n1 } else { n2 };
    let new_noise: Int = min_noise - 1;

    let res: BfvCiphertext = BfvCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: "",
        degree: 2,
        scale: scale,
        level: lvl,
        noise_budget: new_noise,
        checksum: chk,
        is_valid: true
    };
    return Ok(res);
}

