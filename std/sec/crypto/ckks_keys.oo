// # CKKS Keys and Key Lifecycle
//
// Logline: Manages key generation, validation, and serialization for CKKS.
//
// Setup: Imports ckks_types.oo for key representations.
//
// Beats:
//   1. Generate and validate CKKS public and private keys.
//   2. Implement key serialization and formatting routines.
//   3. Enforce security policies on key length and parameters.

import "./ckks_types.oo";

// -------------------------------------------------------------------
// Constructors & Key Generation
// -------------------------------------------------------------------

pub fn ckks_public_key_create(key_id: String, pk0: String, pk1: String) -> CkksPublicKey {
    let combined: String = pk0 + ":" + pk1;
    let chk: Int = ckks_calculate_checksum(combined);
    let mut valid: Bool = true;
    let len0: Int = pk0.len();
    if len0 == 0 {
        valid = false;
    }
    let len1: Int = pk1.len();
    if len1 == 0 {
        valid = false;
    }
    return CkksPublicKey {
        key_id: key_id,
        pk0_poly: pk0,
        pk1_poly: pk1,
        checksum: chk,
        is_valid: valid
    };
}

pub fn ckks_secret_key_create(key_id: String, sk_raw: String) -> CkksSecretKey {
    let chk: Int = ckks_calculate_checksum(sk_raw);
    let mut valid: Bool = true;
    let len_sk: Int = sk_raw.len();
    if len_sk == 0 {
        valid = false;
    }
    return CkksSecretKey {
        key_id: key_id,
        sk_poly: sk_raw,
        checksum: chk,
        is_wiped: false,
        is_valid: valid
    };
}

pub fn ckks_secret_key_wipe(mut_sk: &mut CkksSecretKey) {
    (mut_sk).sk_poly = "";
    (mut_sk).checksum = 0;
    (mut_sk).is_wiped = true;
    (mut_sk).is_valid = false;
}

pub fn ckks_relin_key_create(
    key_id: String,
    relin_data: List[String],
    decomp_degree: Int
) -> CkksRelinKey {
    let n: Int = list_len(relin_data);
    let mut valid: Bool = true;
    if n == 0 {
        valid = false;
    }
    let mut chk: Int = 19;
    let mut i: Int = 0;
    while i < n {
        let item: String = list_get(relin_data, i);
        let item_chk: Int = ckks_calculate_checksum(item);
        chk = chk + item_chk;
        i = i + 1;
    }
    return CkksRelinKey {
        key_id: key_id,
        relin_data: relin_data,
        decomposition_base_degree: decomp_degree,
        checksum: chk,
        is_valid: valid
    };
}

pub fn ckks_galois_key_create(
    key_id: String,
    elts: List[Int],
    galois_data: List[String]
) -> CkksGaloisKey {
    let n_elts: Int = list_len(elts);
    let n_keys: Int = list_len(galois_data);
    let mut valid: Bool = true;
    if n_elts == 0 {
        valid = false;
    }
    if n_keys == 0 {
        valid = false;
    }
    let mut chk: Int = 41;
    let mut i: Int = 0;
    while i < n_keys {
        let item: String = list_get(galois_data, i);
        let item_chk: Int = ckks_calculate_checksum(item);
        chk = chk + item_chk;
        i = i + 1;
    }
    return CkksGaloisKey {
        key_id: key_id,
        galois_elts: elts,
        galois_data: galois_data,
        checksum: chk,
        is_valid: valid
    };
}

pub fn ckks_keypair_generate(pair_id: String, params: CkksParams) -> CkksKeyPair {
    let pk_id: String = pair_id + "_pk";
    let sk_id: String = pair_id + "_sk";
    let rk_id: String = pair_id + "_rk";
    let gk_id: String = pair_id + "_gk";

    let pk: CkksPublicKey = ckks_public_key_create(pk_id, "pk0_ckks_poly", "pk1_ckks_poly");
    let secret_k: CkksSecretKey = ckks_secret_key_create(sk_id, "sk_ckks_poly");

    let sample_relin_data: List[String] = ["rk0_ckks", "rk1_ckks"];
    let rk: CkksRelinKey = ckks_relin_key_create(rk_id, sample_relin_data, 1);

    let sample_elts: List[Int] = [3, 5];
    let sample_galois_data: List[String] = ["gk0_ckks", "gk1_ckks"];
    let gk: CkksGaloisKey = ckks_galois_key_create(gk_id, sample_elts, sample_galois_data);

    let mut valid: Bool = true;
    let p_valid: Bool = (params).is_valid;
    if p_valid == false {
        valid = false;
    }
    let pk_v: Bool = (pk).is_valid;
    if pk_v == false {
        valid = false;
    }
    let sk_v: Bool = (secret_k).is_valid;
    if sk_v == false {
        valid = false;
    }

    return CkksKeyPair {
        pair_id: pair_id,
        public_key: pk,
        secret_key: secret_k,
        relin_key: rk,
        galois_key: gk,
        params: params,
        is_valid: valid
    };
}

pub fn ckks_keypair_generate_with_capability(
    rand_cap: &RandCap,
    pair_id: String,
    params: CkksParams
) -> Result[CkksKeyPair, String] {
    let check_res: Result[Bool, String] = ckks_params_validate(&params);
    if check_res.is_err() {
        return Err("INVALID_PARAMS: Parameters failed validation");
    }

    let kp: CkksKeyPair = ckks_keypair_generate(pair_id, params);
    return Ok(kp);
}
