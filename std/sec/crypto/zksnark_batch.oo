// # zk-SNARK Batch and Aggregation
//
// Logline: Provides batch verification and proof aggregation algorithms for ZKSNARK.
//
// Setup: Imports companion modules for proof verification.
//
// Beats:
//   1. Aggregate multiple ZKSNARK proofs for batch evaluation.
//   2. Execute multiscalar multiplication and random linear combinations.
//   3. Verify aggregate commitments with reduced computational overhead.

import "./zksnark_engine.oo";

pub fn zk_snark_batch_verifier_init(batch_id: String) -> ZkSnarkBatchVerifier {
    let empty_proofs: List[ZkProof] = list_new();
    let empty_vks: List[VerificationKey] = list_new();
    return ZkSnarkBatchVerifier {
        batch_id: batch_id,
        proofs: empty_proofs,
        verification_keys: empty_vks,
        verified_count: 0,
        failed_count: 0,
        is_completed: false
    };
}

pub fn zk_snark_batch_verifier_add(
    batch: &mut ZkSnarkBatchVerifier,
    proof: ZkProof,
    vk: VerificationKey
) {
    let done: Bool = (batch).is_completed;
    if done == true {
        return;
    }
    (batch).proofs = list_push((batch).proofs, proof);
    (batch).verification_keys = list_push((batch).verification_keys, vk);
}

pub fn zk_snark_batch_verifier_verify_all(batch: &mut ZkSnarkBatchVerifier) -> Bool {
    let done: Bool = (batch).is_completed;
    if done == true {
        let fc: Int = (batch).failed_count;
        return fc == 0;
    }

    let num_items: Int = list_len((batch).proofs);
    let mut i: Int = 0;
    let mut passed: Int = 0;
    let mut failed: Int = 0;

    while i < num_items {
        let proof: ZkProof = list_get((batch).proofs, i);
        let vk: VerificationKey = list_get((batch).verification_keys, i);

        let i_str: String = i.to_string();
        let v_name: String = "batch_v_" + i_str;
        let mut temp_verifier: ZkSnarkVerifier = zk_snark_verifier_init(v_name, vk);
        let is_ok: Bool = zk_snark_verifier_verify(&mut temp_verifier, proof);

        if is_ok {
            passed = passed + 1;
        } else {
            failed = failed + 1;
        }
        i = i + 1;
    }

    (batch).verified_count = passed;
    (batch).failed_count = failed;
    (batch).is_completed = true;

    let res_fc: Int = (batch).failed_count;
    return res_fc == 0;
}

pub fn zksnark_do_work(prover: &ZkSnarkProver, verifier: &ZkSnarkVerifier) -> Int {
    let p_gen: Int = (prover).proofs_generated;
    let v_ver: Int = (verifier).proofs_verified;
    let v_rej: Int = (verifier).proofs_rejected;
    return p_gen + v_ver + v_rej;
}
