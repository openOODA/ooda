// # KMAC Context and Execution Engine
//
// Logline: Coordinates KMAC context lifecycle, security policy governance, and tag verification routines.
//
// Setup: Imports kmac_ops.oo for validated parameter constructors.
//
// Beats:
//   1. Import KMAC operational helpers and types.
//   2. Initialize and validate KMAC contexts and security policies.
//   3. Instantiate execution engines and XOF stream readers.
//   4. Perform constant-time tag comparison and verification result generation.

import "./kmac_ops.oo";

pub fn kmac_ctx_init(ctx_id: String, key: KmacKey, config: KmacConfig) -> Result[KmacCtx, String] {
    let k_ref = &key;
    let k_valid: Bool = kmac_key_validate(k_ref);
    if k_valid == false {
        return Err("INVALID_KEY: KmacKey failed validation");
    }
    let c_ref = &config;
    let c_valid: Bool = kmac_config_validate(c_ref);
    if c_valid == false {
        return Err("INVALID_CONFIG: KmacConfig failed validation");
    }
    let k_id: String = key.key_id;
    let c_id: String = config.config_id;
    let chk_input: String = ctx_id + ":" + k_id + ":" + c_id;
    let chk: Int = kmac_checksum(chk_input);
    let ctx = KmacCtx {
        ctx_id: ctx_id,
        config: config,
        key: key,
        custom_str: config.custom_str,
        bytes_absorbed: 0,
        is_squeezing: false,
        checksum: chk,
        is_initialized: true,
        is_active: true,
    };
    return Ok(ctx);
}

pub fn kmac_ctx_validate(ctx: &KmacCtx) -> Bool {
    let is_active: Bool = (ctx).is_active;
    if is_active == false {
        return false;
    }
    let is_init: Bool = (ctx).is_initialized;
    if is_init == false {
        return false;
    }
    let k_ref = &(ctx).key;
    let k_valid: Bool = kmac_key_validate(k_ref);
    if k_valid == false {
        return false;
    }
    let c_ref = &(ctx).config;
    return kmac_config_validate(c_ref);
}

pub fn kmac_security_policy_default() -> KmacSecurityPolicy {
    return KmacSecurityPolicy {
        min_key_bits: 128,
        allow_empty_customization: true,
        fail_closed: true,
        is_active: true,
    };
}

pub fn kmac_engine_init(engine_id: String, policy: KmacSecurityPolicy) -> Result[KmacEngine, String] {
    let dummy_key_res: Result[KmacKey, String] = kmac_key_create("default_k", "0123456789abcdef");
    let dummy_key: KmacKey = match dummy_key_res {
        Ok(k) => k,
        Err(e) => return Err(e),
    };
    let dummy_cfg_res: Result[KmacConfig, String] = kmac_config_256("default_cfg", 256, "");
    let dummy_cfg: KmacConfig = match dummy_cfg_res {
        Ok(c) => c,
        Err(e) => return Err(e),
    };
    let ctx_res: Result[KmacCtx, String] = kmac_ctx_init(engine_id + "_ctx", dummy_key, dummy_cfg);
    let ctx: KmacCtx = match ctx_res {
        Ok(c) => c,
        Err(e) => return Err(e),
    };
    let eng = KmacEngine {
        engine_id: engine_id,
        policy: policy,
        ctx: ctx,
        macs_computed: 0,
        bytes_processed: 0,
        system_halted: false,
    };
    return Ok(eng);
}

pub fn kmac_xof_reader_init(reader_id: String, ctx_id: String) -> KmacXofReader {
    return KmacXofReader {
        reader_id: reader_id,
        ctx_id: ctx_id,
        bytes_read: 0,
        is_active: true,
    };
}

pub fn kmac_verify_tag(expected_tag: &KmacTag, candidate_tag: &KmacTag) -> KmacVerificationResult {
    let e_valid: Bool = kmac_tag_validate(expected_tag);
    if e_valid == false {
        return KmacVerificationResult {
            is_valid: false,
            key_id: "",
            tag_id: (candidate_tag).tag_id,
            algorithm: (candidate_tag).algorithm,
            error_code: "EXPECTED_TAG_INVALID",
            verification_time: 0,
        };
    }
    let c_valid: Bool = kmac_tag_validate(candidate_tag);
    if c_valid == false {
        return KmacVerificationResult {
            is_valid: false,
            key_id: "",
            tag_id: (candidate_tag).tag_id,
            algorithm: (candidate_tag).algorithm,
            error_code: "CANDIDATE_TAG_INVALID",
            verification_time: 0,
        };
    }
    let is_eq: Bool = kmac_constant_time_eq((expected_tag).raw_bytes, (candidate_tag).raw_bytes);
    if is_eq {
        return KmacVerificationResult {
            is_valid: true,
            key_id: "",
            tag_id: (candidate_tag).tag_id,
            algorithm: (candidate_tag).algorithm,
            error_code: "OK",
            verification_time: 0,
        };
    }
    return KmacVerificationResult {
        is_valid: false,
        key_id: "",
        tag_id: (candidate_tag).tag_id,
        algorithm: (candidate_tag).algorithm,
        error_code: "TAG_MISMATCH",
        verification_time: 0,
    };
}
