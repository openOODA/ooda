// # KMAC Engine
//
// Logline: Destubbed onto ./kmac_types.oo Int-floor KmacConfig API.
//
// Setup: Companion types destubbed; keep fail-closed real calls.
//
// Beats:
//   1. Import destubbed companion.
//   2. Wrap constructor and Int query.
//   3. Deterministic work helper for prove.

import "./kmac_types.oo";

pub fn kmac_engine_init(rate: Int, capacity: Int, output_bits: Int) -> KmacConfig {
    return kmac_config_new(rate, capacity, output_bits);
}

pub fn kmac_engine_rate(c: KmacConfig) -> Int {
    return kmac_config_rate(c);
}

pub fn kmac_engine_work(rate: Int, capacity: Int, output_bits: Int) -> Int {
    let c: KmacConfig = kmac_config_new(rate, capacity, output_bits);
    return kmac_config_rate(c) + (c).capacity + (c).output_bits;
}
