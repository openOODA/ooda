// # KMAC types
//
// Logline: KmacConfig destubbed off Result[struct] / String key.
// residual: destubbed to Int floor. Field not named len.

type KmacConfig = struct {
    rate: Int,
    capacity: Int,
    output_bits: Int
};

pub fn kmac_config_new(rate: Int, capacity: Int, output_bits: Int) -> KmacConfig {
    return KmacConfig {
        rate: rate,
        capacity: capacity,
        output_bits: output_bits
    };
}

pub fn kmac_config_rate(c: KmacConfig) -> Int {
    return c.rate;
}
