// # Shamir Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for SHAMIR.
//
// Setup: Imports shamir_types.oo for data structure definitions.
//
// Beats:
//   1. Import SHAMIR types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./shamir_types.oo";

pub fn byte_to_hex_pair(val_byte: Int) -> String {
    let hex_chars: String = "0123456789abcdef";
    let div16: Int = val_byte / 16;
    let hi: Int = div16 % 16;
    let lo: Int = val_byte % 16;
    let mut res: List[Int] = bytes_new();
    res = bytes_push(res, byte_at(hex_chars, hi));
    res = bytes_push(res, byte_at(hex_chars, lo));
    return bytes_to_str(res);
}

pub fn hex_char_to_val(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 {
            return ch - 48;
        }
    }
    if ch >= 97 {
        if ch <= 102 {
            return ch - 87;
        }
    }
    if ch >= 65 {
        if ch <= 70 {
            return ch - 55;
        }
    }
    return -1;
}

pub fn shamir_hex_encode(raw_bytes: String) -> String {
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut out: String = "";
    while i < raw_len {
        let val_byte: Int = byte_at(raw_bytes, i);
        let pair: String = byte_to_hex_pair(val_byte);
        out = out + pair;
        i = i + 1;
    }
    return out;
}

pub fn shamir_hex_decode(hex_str: String) -> Result[String, String] {
    let hex_len: Int = hex_str.len();
    let rem: Int = hex_len % 2;
    if rem != 0 {
        return Err("INVALID_HEX: Length must be even");
    }
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < hex_len {
        let hi_ch: Int = byte_at(hex_str, i);
        let next_i: Int = i + 1;
        let lo_ch: Int = byte_at(hex_str, next_i);
        let hi_v: Int = hex_char_to_val(hi_ch);
        let lo_v: Int = hex_char_to_val(lo_ch);
        if hi_v < 0 {
            return Err("INVALID_HEX: Invalid character");
        }
        if lo_v < 0 {
            return Err("INVALID_HEX: Invalid character");
        }
        let hi_mult: Int = hi_v * 16;
        let byte_val: Int = hi_mult + lo_v;
        buf = bytes_push(buf, byte_val);
        i = i + 2;
    }
    return Ok(bytes_to_str(buf));
}

pub fn shamir_constant_time_eq(s1: String, s2: String) -> Bool {
    let s1_len: Int = s1.len();
    let s2_len: Int = s2.len();
    if s1_len != s2_len {
        return false;
    }
    let mut i: Int = 0;
    let mut diff: Int = 0;
    while i < s1_len {
        let b1: Int = byte_at(s1, i);
        let b2: Int = byte_at(s2, i);
        if b1 != b2 {
            diff = diff + 1;
        }
        i = i + 1;
    }
    return diff == 0;
}

pub fn shamir_mod_add(add_a: Int, add_b: Int, modulus: Int) -> Int {
    if modulus <= 0 {
        return add_a + add_b;
    }
    let mut res: Int = (add_a + add_b) % modulus;
    if res < 0 {
        res = res + modulus;
    }
    return res;
}

pub fn shamir_mod_sub(sub_a: Int, sub_b: Int, modulus: Int) -> Int {
    if modulus <= 0 {
        return sub_a - sub_b;
    }
    let mut res: Int = (sub_a - sub_b) % modulus;
    if res < 0 {
        res = res + modulus;
    }
    return res;
}

pub fn shamir_mod_mul(mul_a: Int, mul_b: Int, modulus: Int) -> Int {
    if modulus <= 0 {
        return mul_a * mul_b;
    }
    let a_mod: Int = mul_a % modulus;
    let b_mod: Int = mul_b % modulus;
    let mut res: Int = (a_mod * b_mod) % modulus;
    if res < 0 {
        res = res + modulus;
    }
    return res;
}

pub fn shamir_mod_pow(base_val: Int, exp_val: Int, modulus: Int) -> Int {
    if modulus <= 1 {
        return 0;
    }
    let mut m_res: Int = 1;
    let mut m_base: Int = base_val % modulus;
    if m_base < 0 {
        m_base = m_base + modulus;
    }
    let mut m_exp: Int = exp_val;
    while m_exp > 0 {
        if (m_exp % 2) == 1 {
            m_res = (m_res * m_base) % modulus;
        }
        m_exp = m_exp / 2;
        m_base = (m_base * m_base) % modulus;
    }
    return m_res;
}

pub fn shamir_mod_inv(val: Int, modulus: Int) -> Int {
    if modulus <= 1 {
        return 0;
    }
    let exp_val: Int = modulus - 2;
    return shamir_mod_pow(val, exp_val, modulus);
}

// -------------------------------------------------------------------
// Polynomial Operations & Lagrange Interpolation
// -------------------------------------------------------------------

pub fn polynomial_create(
    poly_id: String,
    degree: Int,
    coefficients: List[Int],
    modulus: Int
) -> Result[Polynomial, String] {
    let coeff_len: Int = list_len(coefficients);
    let expected_len: Int = degree + 1;
    if coeff_len != expected_len {
        return Err("INVALID_POLYNOMIAL: Coefficient count must equal degree + 1");
    }
    let p: Polynomial = Polynomial {
        poly_id: poly_id,
        degree: degree,
        coefficients: coefficients,
        modulus: modulus,
        is_valid: true,
    };
    return Ok(p);
}

pub fn polynomial_validate(poly: &Polynomial) -> Bool {
    let p_valid: Bool = (poly).is_valid;
    if p_valid == false {
        return false;
    }
    let coeffs: List[Int] = (poly).coefficients;
    let coeff_len: Int = list_len(coeffs);
    let deg: Int = (poly).degree;
    let expected_len: Int = deg + 1;
    return coeff_len == expected_len;
}

pub fn polynomial_evaluate(poly: &Polynomial, x: Int) -> Int {
    let coeffs: List[Int] = (poly).coefficients;
    let coeff_count: Int = list_len(coeffs);
    let mod_val: Int = (poly).modulus;
    let mut result: Int = 0;
    let mut x_pow: Int = 1;
    let mut i: Int = 0;

    while i < coeff_count {
        let c: Int = list_get(coeffs, i);
        let term: Int = shamir_mod_mul(c, x_pow, mod_val);
        result = shamir_mod_add(result, term, mod_val);
        x_pow = shamir_mod_mul(x_pow, x, mod_val);
        i = i + 1;
    }
    return result;
}

pub fn lagrange_basis_at_zero(i_idx: Int, x_coords: List[Int], modulus: Int) -> Int {
    let coords_count: Int = list_len(x_coords);
    let xi: Int = list_get(x_coords, i_idx);
    let mut num: Int = 1;
    let mut den: Int = 1;
    let mut j: Int = 0;

    while j < coords_count {
        if j != i_idx {
            let xj: Int = list_get(x_coords, j);
            let num_term: Int = shamir_mod_sub(0, xj, modulus);
            let den_term: Int = shamir_mod_sub(xi, xj, modulus);

            num = shamir_mod_mul(num, num_term, modulus);
            den = shamir_mod_mul(den, den_term, modulus);
        }
        j = j + 1;
    }

    let den_inv: Int = shamir_mod_inv(den, modulus);
    return shamir_mod_mul(num, den_inv, modulus);
}
