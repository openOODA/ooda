// # ChaCha20 Facade
//
// Logline: Re-exports ChaCha20 data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import ChaCha20 companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 5 files (each ≤256 lines for parts, shim ≤120, oodac check green).
// This shim re-exports the public names so existing callers continue to work.
//
// RULES.oot 1.4: Default-deny for privileged effects. Explicit &SysCap required.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins / compiler limitations.

import "./chacha20_types.oo";
import "./chacha20_ops.oo";
import "./chacha20_engine.oo";
import "./chacha20_stubs.oo";

// Thin markers keep the monomorphizer aware of core paths without
// re-hosting large by-value APIs in this unit (same pattern as blake3/kmac).

pub fn shim_marker_checksum() -> Int {
    return checksum_calculate("abc");
}

pub fn shim_marker_hex_encode() -> String {
    return hex_encode("ab");
}

pub fn shim_marker_policy_default() -> ChaCha20SecurityPolicy {
    return chacha20_security_policy_default();
}

pub fn shim_marker_pad16() -> String {
    return pad_to_16_bytes("x");
}

pub type Default = struct {};
pub type Nonce = struct {};
pub type Key = struct {};
pub type Length = struct {};
pub type ChaCha20 = struct {};
pub type Poly1305 = struct {};
pub type Generating = struct {};
pub type Full = struct {};
pub type Invalid = struct {};
pub type Fail = struct {};


pub fn __dummy_std_src_ooda_sec_crypto_chacha20_oo() -> Int {
    return 0;
}
