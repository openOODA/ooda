// # Groth16 zk-SNARK Facade and Re-Export Shim
//
// Logline: Re-exports Groth16 proof structures, verifying keys, batch engines, and fail-closed stubs.
//
// Setup: Pure module shim importing types, operations, engine, and stubs companion submodules.
//
// Beats:
//   1. Import Groth16 types, operations, engine, and stubs companion modules.
//   2. Provide typed shim markers ensuring monomorphization coverage.
//   3. Execute self-verification suite to validate proof construction, VK format, and structural verification.

import "./groth16_types.oo";
import "./groth16_ops.oo";
import "./groth16_engine.oo";
import "./groth16_stubs.oo";

pub fn shim_marker_curve_bn254() -> Int {
    return groth16_curve_bn254();
}

pub fn shim_marker_proof() -> Groth16Proof {
    return groth16_proof_create("p0", 1, "1", "2", "3", "4", "5", "6", "7", "8", true);
}

pub fn shim_marker_public_inputs() -> PublicInputs {
    let mut vals: List[String] = list_new();
    vals = list_push(vals, "0x1");
    return public_inputs_create("in0", vals);
}

pub fn shim_marker_setup_params() -> Groth16SetupParams {
    return groth16_setup_params_init("circuit", 1, 100, 200, 2);
}

verify groth16 {
    let bn254_id: Int = groth16_curve_bn254();
    assert_eq!(bn254_id, 1);
    assert_eq!(groth16_curve_name(1), "BN254");
    assert_eq!(groth16_curve_name(2), "BLS12-381");

    let val1: String = "0x123456789abcdef";
    let val2: String = "0x987654321fedcba";
    let mut val_list: List[String] = list_new();
    val_list = list_push(val_list, val1);
    val_list = list_push(val_list, val2);

    let mut pub_in: PublicInputs = public_inputs_create("pub_in_01", val_list);
    assert_eq!(pub_in.scalar_count, 2);
    assert_eq!(pub_in.is_well_formed, true);
    assert_eq!(public_inputs_validate(&pub_in, 2), true);
    assert_eq!(public_inputs_validate(&pub_in, 3), false);

    let val_res0: Result[String, String] = public_inputs_get_value(&pub_in, 0);
    assert_eq!(val_res0, Ok("0x123456789abcdef"));

    public_inputs_add_value(&mut pub_in, "0x55555555");
    assert_eq!(pub_in.scalar_count, 3);

    let proof: Groth16Proof = groth16_proof_create(
        "proof_001",
        1,
        "0x111", "0x222",
        "0x333", "0x444", "0x555", "0x666",
        "0x777", "0x888",
        true
    );
    assert_eq!(proof.is_valid, true);
    assert_eq!(groth16_proof_validate_format(&proof), true);

    let mut ic_x: List[String] = list_new();
    let mut ic_y: List[String] = list_new();
    ic_x = list_push(ic_x, "0xic0_x");
    ic_y = list_push(ic_y, "0xic0_y");
    ic_x = list_push(ic_x, "0xic1_x");
    ic_y = list_push(ic_y, "0xic1_y");
    ic_x = list_push(ic_x, "0xic2_x");
    ic_y = list_push(ic_y, "0xic2_y");
    ic_x = list_push(ic_x, "0xic3_x");
    ic_y = list_push(ic_y, "0xic3_y");

    let vk: Groth16Vk = groth16_vk_create(
        "vk_001",
        1,
        3,
        "0xax", "0xay",
        "0xbx0", "0xbx1", "0xby0", "0xby1",
        "0xgx0", "0xgx1", "0xgy0", "0xgy1",
        "0xdx0", "0xdx1", "0xdy0", "0xdy1",
        ic_x, ic_y
    );

    assert_eq!(vk.is_valid, true);
    assert_eq!(groth16_vk_validate(&vk), true);

    let ic_elem_res: Result[String, String] = groth16_vk_get_ic_element(&vk, 0);
    assert_eq!(ic_elem_res, Ok("IC[0](0xic0_x, 0xic0_y)"));

    let mut verifier: Groth16Verifier = groth16_verifier_init("verifier_01", vk, true);
    assert_eq!(verifier.is_active, true);

    let match_inputs: Bool = groth16_verify_input_match(&(verifier.vk), &pub_in);
    assert_eq!(match_inputs, true);

    let struct_res: Groth16VerificationResult = groth16_verifier_verify_structural(&mut verifier, &proof, &pub_in);
    assert_eq!(struct_res.is_valid, true);
    assert_eq!(verifier.verified_count, 1);

    let mut batch: Groth16BatchVerifier = groth16_batch_verifier_init("batch_01");
    let added: Bool = groth16_batch_verifier_add(&mut batch, proof, pub_in);
    assert_eq!(added, true);
    assert_eq!(batch.batch_size, 1);

    groth16_batch_verifier_clear(&mut batch);
    assert_eq!(batch.batch_size, 0);

    let params: Groth16SetupParams = groth16_setup_params_init("merkle_tree_circuit", 1, 1024, 2048, 3);
    assert_eq!(params.is_trusted_setup_complete, true);
}
