// # SHA-3 and Keccak State Constructors and Operations
//
// Logline: Implements sponge state initializers, XOF parameters, and digest validator routines.
//
// Setup: Imports sha3_types.oo for data structure definitions.
//
// Beats:
//   1. Import SHA-3 and Keccak types.
//   2. Provide state initializers for SHA3-224, 256, 384, 512 and Keccak-256, 512.
//   3. Initialize and validate SHAKE XOF instances.
//   4. Create and validate Keccak digest containers and default configurations.

import "./sha3_types.oo";

pub fn sha3_state_init(
    state_id: String,
    rate: Int,
    capacity: Int,
    suffix_delim: Int,
    digest_len: Int
) -> Result[Sha3State, String] {
    let state_sum: Int = rate + capacity;
    if state_sum != 1600 {
        return Err("INVALID_SPONGE_STATE: Rate + capacity must equal 1600 bits for Keccak-f[1600]");
    }
    if rate <= 0 {
        return Err("INVALID_RATE: Rate must be greater than zero");
    }
    if capacity <= 0 {
        return Err("INVALID_CAPACITY: Capacity must be greater than zero");
    }
    let chk_str: String = state_id + ":" + bytes_to_str(bytes_push(bytes_new(), suffix_delim));
    let chk: Int = sha3_checksum(chk_str);
    let state = Sha3State {
        state_id: state_id,
        rate: rate,
        capacity: capacity,
        byte_index: 0,
        suffix_delim: suffix_delim,
        digest_len: digest_len,
        is_squeezing: false,
        checksum: chk,
        is_initialized: true,
    };
    return Ok(state);
}

pub fn sha3_state_validate(st: &Sha3State) -> Bool {
    if (st).is_initialized == false {
        return false;
    }
    let r: Int = (st).rate;
    let c: Int = (st).capacity;
    if r + c != 1600 {
        return false;
    }
    let idx: Int = (st).byte_index;
    let r_bytes: Int = r / 8;
    if idx < 0 {
        return false;
    }
    if idx > r_bytes {
        return false;
    }
    return true;
}

pub fn sha3_224_init(state_id: String) -> Result[Sha3State, String] {
    return sha3_state_init(state_id, 1152, 448, 6, 28);
}

pub fn sha3_256_init(state_id: String) -> Result[Sha3State, String] {
    return sha3_state_init(state_id, 1088, 512, 6, 32);
}

pub fn sha3_384_init(state_id: String) -> Result[Sha3State, String] {
    return sha3_state_init(state_id, 832, 768, 6, 48);
}

pub fn sha3_512_init(state_id: String) -> Result[Sha3State, String] {
    return sha3_state_init(state_id, 576, 1024, 6, 64);
}

pub fn keccak_256_init(state_id: String) -> Result[Sha3State, String] {
    return sha3_state_init(state_id, 1088, 512, 1, 32);
}

pub fn keccak_512_init(state_id: String) -> Result[Sha3State, String] {
    return sha3_state_init(state_id, 576, 1024, 1, 64);
}

pub fn shake_xof_init(xof_id: String, variant: String) -> Result[ShakeXof, String] {
    let mut rate: Int = 0;
    let mut capacity: Int = 0;
    if variant == "SHAKE128" {
        rate = 1344;
        capacity = 256;
    } else {
        if variant == "SHAKE256" {
            rate = 1088;
            capacity = 512;
        } else {
            return Err("INVALID_SHAKE_VARIANT: Expected SHAKE128 or SHAKE256");
        }
    }
    let st_res: Result[Sha3State, String] = sha3_state_init(xof_id + "_st", rate, capacity, 31, 0);
    let st: Sha3State = match st_res {
        Ok(s) => s,
        Err(e) => return Err(e),
    };
    let xof = ShakeXof {
        xof_id: xof_id,
        variant: variant,
        rate: rate,
        capacity: capacity,
        bytes_squeezed: 0,
        is_customized: false,
        custom_str: "",
        function_name: "",
        state: st,
        is_active: true,
    };
    return Ok(xof);
}

pub fn shake_xof_validate(xof: &ShakeXof) -> Bool {
    if (xof).is_active == false {
        return false;
    }
    let st_ref: &Sha3State = &(xof).state;
    if sha3_state_validate(st_ref) == false {
        return false;
    }
    return (xof).bytes_squeezed >= 0;
}

pub fn keccak_digest_create(
    digest_id: String,
    algorithm: String,
    raw_bytes: String
) -> Result[KeccakDigest, String] {
    let raw_len: Int = raw_bytes.len();
    if raw_len == 0 {
        return Err("EMPTY_DIGEST: Digest bytes cannot be empty");
    }
    let hex_val: String = sha3_hex_encode(raw_bytes);
    let chk: Int = sha3_checksum(raw_bytes);
    let bit_len: Int = raw_len * 8;
    return Ok(KeccakDigest {
        digest_id: digest_id,
        algorithm: algorithm,
        raw_bytes: raw_bytes,
        hex_str: hex_val,
        bit_length: bit_len,
        byte_length: raw_len,
        checksum: chk,
        is_valid: true,
    });
}

pub fn keccak_digest_validate(dig: &KeccakDigest) -> Bool {
    if (dig).is_valid == false {
        return false;
    }
    let raw: String = (dig).raw_bytes;
    if raw.len() != (dig).byte_length {
        return false;
    }
    return (dig).checksum == sha3_checksum(raw);
}

pub fn sha3_config_default() -> Sha3Config {
    return Sha3Config {
        config_id: "CFG_SHA3_256_DEFAULT",
        variant: "SHA3-256",
        rate: 1088,
        capacity: 512,
        output_bits: 256,
        domain_separator: 6,
        fail_closed: true,
        is_valid: true,
    };
}
