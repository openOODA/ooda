// # SHA-3 and Keccak Operations and Helpers
//
// Logline: Implements checksums, hex encoding/decoding, and constant-time comparisons for SHA-3.
//
// Setup: Imports sha3_types.oo for data structure definitions.
//
// Beats:
//   1. Import SHA-3 and Keccak types.
//   2. Provide checksum and encoding utilities.
//   3. Implement constant-time equality checks.

import "./sha3_types.oo";

pub fn sha3_checksum(raw_bytes: String) -> Int {
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < raw_len {
        let ch: Int = byte_at(raw_bytes, i);
        let hash_x33: Int = hash * 33;
        hash = hash_x33 + ch;
        i = i + 1;
    }
    return hash;
}

pub fn sha3_hex_encode(raw_bytes: String) -> String {
    let hex_chars: String = "0123456789abcdef";
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut out: String = "";
    while i < raw_len {
        let val_byte: Int = byte_at(raw_bytes, i);
        let div16: Int = val_byte / 16;
        let hi: Int = div16 % 16;
        let lo: Int = val_byte % 16;
        let mut res: List[Int] = bytes_new();
        res = bytes_push(res, byte_at(hex_chars, hi));
        res = bytes_push(res, byte_at(hex_chars, lo));
        out = out + bytes_to_str(res);
        i = i + 1;
    }
    return out;
}

pub fn sha3_hex_decode(hex_str: String) -> Result[String, String] {
    let hex_len: Int = hex_str.len();
    let rem: Int = hex_len % 2;
    if rem != 0 {
        return Err("INVALID_HEX: Length must be even");
    }
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < hex_len {
        let hi_ch: Int = byte_at(hex_str, i);
        let next_i: Int = i + 1;
        let lo_ch: Int = byte_at(hex_str, next_i);
        let mut hi_v: Int = -1;
        if hi_ch >= 48 && hi_ch <= 57 { hi_v = hi_ch - 48; }
        if hi_ch >= 97 && hi_ch <= 102 { hi_v = hi_ch - 87; }
        let mut lo_v: Int = -1;
        if lo_ch >= 48 && lo_ch <= 57 { lo_v = lo_ch - 48; }
        if lo_ch >= 97 && lo_ch <= 102 { lo_v = lo_ch - 87; }
        if hi_v < 0 || lo_v < 0 {
            return Err("INVALID_HEX: Invalid character");
        }
        let byte_val: Int = (hi_v * 16) + lo_v;
        buf = bytes_push(buf, byte_val);
        i = i + 2;
    }
    return Ok(bytes_to_str(buf));
}

pub fn sha3_constant_time_eq(s1: String, s2: String) -> Bool {
    let s1_len: Int = s1.len();
    let s2_len: Int = s2.len();
    if s1_len != s2_len {
        return false;
    }
    let mut i: Int = 0;
    let mut diff: Int = 0;
    while i < s1_len {
        let b1: Int = byte_at(s1, i);
        let b2: Int = byte_at(s2, i);
        if b1 != b2 {
            diff = diff + 1;
        }
        i = i + 1;
    }
    return diff == 0;
}
