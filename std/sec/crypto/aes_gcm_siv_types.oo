// # AES-GCM-SIV Types and Structures
//
// Logline: Core data structures, keys, tags, contexts, and validation constructors for AES-GCM-SIV.
//
// Setup: Pure type definitions and structural validation logic for RFC 8452 authenticated encryption.
//
// Beats:
//   1. Define AES key, nonce, auth tag, ciphertext, context, and result structures.
//   2. Implement key, nonce, and tag initialization constructors with size validation.
//   3. Implement structural validators verifying length and checksum invariants.
//   4. Define context initialization and counter derivation routines.

import "./aes_gcm_siv_ops.oo";

pub type AesKey = struct {
    key_id: String,
    raw_bytes: String,
    bit_length: Int,
    algorithm: String,
    checksum: Int,
    is_valid: Bool,
};

pub type Nonce = struct {
    nonce_id: String,
    raw_bytes: String,
    len: Int,
    counter: Int,
    is_valid: Bool,
};

pub type AuthTag = struct {
    tag_bytes: String,
    len: Int,
    checksum: Int,
    is_valid: Bool,
};

pub type Ciphertext = struct {
    data: String,
    len: Int,
    tag: AuthTag,
    nonce: Nonce,
    is_valid: Bool,
};

pub type AesGcmSivCtx = struct {
    ctx_id: String,
    key: AesKey,
    nonce_len: Int,
    tag_len: Int,
    is_initialized: Bool,
};

pub type EncryptResult = struct {
    ciphertext: Ciphertext,
    status_code: Int,
    error_msg: String,
};

pub type DecryptResult = struct {
    plaintext: String,
    status_code: Int,
    error_msg: String,
};

pub type PolyvalState = struct {
    accum: String,
    key_h: String,
    is_initialized: Bool,
};

pub fn derive_siv_counter(tag: &AuthTag) -> Int {
    let raw: String = (tag).tag_bytes;
    let tag_len: Int = raw.len();
    if tag_len < 4 {
        return 0;
    }
    let b0: Int = byte_at(raw, 0);
    let b1: Int = byte_at(raw, 1);
    let b2: Int = byte_at(raw, 2);
    let b3: Int = byte_at(raw, 3);
    return b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216);
}

pub fn aes_key_create(key_id: String, raw_bytes: String, algorithm: String) -> Result[AesKey, String] {
    let raw_len: Int = raw_bytes.len();
    let bits: Int = raw_len * 8;
    if bits != 128 {
        if bits != 192 {
            if bits != 256 {
                return Err("INVALID_KEY_SIZE: AES key must be 128, 192, or 256 bits");
            }
        }
    }
    let chk: Int = checksum_calculate(raw_bytes);
    let key = AesKey {
        key_id: key_id,
        raw_bytes: raw_bytes,
        bit_length: bits,
        algorithm: algorithm,
        checksum: chk,
        is_valid: true,
    };
    return Ok(key);
}

pub fn aes_key_validate(key: &AesKey) -> Bool {
    let k_valid: Bool = (key).is_valid;
    if k_valid == false {
        return false;
    }
    let raw: String = (key).raw_bytes;
    let expected_chk: Int = checksum_calculate(raw);
    let k_chk: Int = (key).checksum;
    if k_chk != expected_chk {
        return false;
    }
    let bits: Int = (key).bit_length;
    if bits != 128 {
        if bits != 192 {
            if bits != 256 {
                return false;
            }
        }
    }
    return true;
}

pub fn nonce_create(nonce_id: String, raw_bytes: String) -> Result[Nonce, String] {
    let raw_len: Int = raw_bytes.len();
    if raw_len != 12 {
        return Err("INVALID_NONCE_SIZE: AES-GCM-SIV nonce must be 12 bytes (96 bits)");
    }
    let nonce = Nonce {
        nonce_id: nonce_id,
        raw_bytes: raw_bytes,
        len: raw_len,
        counter: 0,
        is_valid: true,
    };
    return Ok(nonce);
}

pub fn nonce_validate(nonce: &Nonce) -> Bool {
    let n_valid: Bool = (nonce).is_valid;
    if n_valid == false {
        return false;
    }
    let raw: String = (nonce).raw_bytes;
    let raw_len: Int = raw.len();
    return raw_len == 12;
}

pub fn auth_tag_create(tag_bytes: String) -> Result[AuthTag, String] {
    let tag_len: Int = tag_bytes.len();
    if tag_len != 16 {
        return Err("INVALID_TAG_SIZE: Authentication tag must be 16 bytes (128 bits)");
    }
    let chk: Int = checksum_calculate(tag_bytes);
    let tag = AuthTag {
        tag_bytes: tag_bytes,
        len: tag_len,
        checksum: chk,
        is_valid: true,
    };
    return Ok(tag);
}

pub fn auth_tag_validate(tag: &AuthTag) -> Bool {
    let t_valid: Bool = (tag).is_valid;
    if t_valid == false {
        return false;
    }
    let raw: String = (tag).tag_bytes;
    let tag_len: Int = raw.len();
    if tag_len != 16 {
        return false;
    }
    let expected_chk: Int = checksum_calculate(raw);
    let t_chk: Int = (tag).checksum;
    return t_chk == expected_chk;
}

pub fn ciphertext_create(data: String, tag: AuthTag, nonce: Nonce) -> Ciphertext {
    let data_len: Int = data.len();
    let t_valid: Bool = tag.is_valid;
    let n_valid: Bool = nonce.is_valid;
    let valid: Bool = t_valid && n_valid;
    return Ciphertext {
        data: data,
        len: data_len,
        tag: tag,
        nonce: nonce,
        is_valid: valid,
    };
}

pub fn ciphertext_validate(c: &Ciphertext) -> Bool {
    let c_valid: Bool = (c).is_valid;
    if c_valid == false {
        return false;
    }
    let t_ref = &(c).tag;
    let n_ref = &(c).nonce;
    let t_valid: Bool = auth_tag_validate(t_ref);
    let n_valid: Bool = nonce_validate(n_ref);
    if t_valid == false {
        return false;
    }
    if n_valid == false {
        return false;
    }
    let raw_data: String = (c).data;
    let d_len: Int = raw_data.len();
    let c_len: Int = (c).len;
    return c_len == d_len;
}

pub fn aes_gcm_siv_ctx_init(ctx_id: String, key: AesKey) -> Result[AesGcmSivCtx, String] {
    let k_ref = &key;
    let k_valid: Bool = aes_key_validate(k_ref);
    if k_valid == false {
        return Err("INVALID_KEY: AesKey failed validation checks");
    }
    let ctx = AesGcmSivCtx {
        ctx_id: ctx_id,
        key: key,
        nonce_len: 12,
        tag_len: 16,
        is_initialized: true,
    };
    return Ok(ctx);
}

pub fn aes_gcm_siv_ctx_validate(ctx: &AesGcmSivCtx) -> Bool {
    let is_init: Bool = (ctx).is_initialized;
    if is_init == false {
        return false;
    }
    let k_ref = &(ctx).key;
    return aes_key_validate(k_ref);
}
