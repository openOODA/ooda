// # PLONK Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for PLONK.
//
// Setup: Imports plonk_types.oo for data structure definitions.
//
// Beats:
//   1. Import PLONK types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./plonk_types.oo";

pub fn plonk_mod_pow(base_val: Int, exp_val: Int, mod_val: Int) -> Int {
    if mod_val <= 1 {
        return 0;
    }
    let mut m_res = 1;
    let mut m_base = base_val % mod_val;
    if m_base < 0 {
        m_base = m_base + mod_val;
    }
    let mut m_exp = exp_val;
    while m_exp > 0 {
        if (m_exp % 2) == 1 {
            m_res = (m_res * m_base) % mod_val;
        }
        m_exp = m_exp / 2;
        m_base = (m_base * m_base) % mod_val;
    }
    return m_res;
}

pub fn plonk_mod_mul(mul_a: Int, mul_b: Int, mod_val: Int) -> Int {
    if mod_val <= 0 {
        return 0;
    }
    let a_mod = mul_a % mod_val;
    let b_mod = mul_b % mod_val;
    let mut mul_res = (a_mod * b_mod) % mod_val;
    if mul_res < 0 {
        mul_res = mul_res + mod_val;
    }
    return mul_res;
}

pub fn plonk_mod_add(add_a: Int, add_b: Int, mod_val: Int) -> Int {
    if mod_val <= 0 {
        return 0;
    }
    let mut add_res = (add_a + add_b) % mod_val;
    if add_res < 0 {
        add_res = add_res + mod_val;
    }
    return add_res;
}

pub fn plonk_mod_sub(sub_a: Int, sub_b: Int, mod_val: Int) -> Int {
    if mod_val <= 0 {
        return 0;
    }
    let mut sub_res = (sub_a - sub_b) % mod_val;
    if sub_res < 0 {
        sub_res = sub_res + mod_val;
    }
    return sub_res;
}

pub fn plonk_mod_inv(val: Int, mod_val: Int) -> Int {
    if mod_val <= 1 {
        return 0;
    }
    let exp_val = mod_val - 2;
    return plonk_mod_pow(val, exp_val, mod_val);
}

// -------------------------------------------------------------------
// Custom Gate Operations
// -------------------------------------------------------------------

pub fn custom_gate_create(
    id: String,
    gate_type: Int,
    q_l: Int,
    q_r: Int,
    q_m: Int,
    q_o: Int,
    q_c: Int
) -> CustomGate {
    return CustomGate {
        gate_id: id,
        gate_type: gate_type,
        q_l_coeff: q_l,
        q_r_coeff: q_r,
        q_m_coeff: q_m,
        q_o_coeff: q_o,
        q_c_coeff: q_c,
        q_lookup: 0,
        degree: 3,
        is_enabled: true
    };
}

pub fn custom_gate_eval(gate: CustomGate, a: Int, b: Int, c: Int, mod_val: Int) -> Int {
    if (gate.is_enabled) == false {
        return 0;
    }
    // Equation: q_L * a + q_R * b + q_M * a * b + q_O * c + q_C
    let term_l = plonk_mod_mul(gate.q_l_coeff, a, mod_val);
    let term_r = plonk_mod_mul(gate.q_r_coeff, b, mod_val);
    let ab = plonk_mod_mul(a, b, mod_val);
    let term_m = plonk_mod_mul(gate.q_m_coeff, ab, mod_val);
    let term_o = plonk_mod_mul(gate.q_o_coeff, c, mod_val);

    let sum1 = plonk_mod_add(term_l, term_r, mod_val);
    let sum2 = plonk_mod_add(sum1, term_m, mod_val);
    let sum3 = plonk_mod_add(sum2, term_o, mod_val);
    let res = plonk_mod_add(sum3, gate.q_c_coeff, mod_val);

    return res;
}

pub fn custom_gate_to_string(gate: CustomGate) -> String {
    let g_id = gate.gate_id;
    let ql_s = (gate.q_l_coeff).to_string();
    let qr_s = (gate.q_r_coeff).to_string();
    let qm_s = (gate.q_m_coeff).to_string();
    let qo_s = (gate.q_o_coeff).to_string();
    let qc_s = (gate.q_c_coeff).to_string();
    return "CustomGate[" + g_id + "](qL=" + ql_s + ", qR=" + qr_s + ", qM=" + qm_s + ", qO=" + qo_s + ", qC=" + qc_s + ")";
}

// -------------------------------------------------------------------
// Verifying Key Operations
// -------------------------------------------------------------------

pub fn plonk_vk_create(
    id: String,
    domain_size: Int,
    num_inputs: Int,
    q_l: Int,
    q_r: Int,
    q_m: Int,
    q_o: Int,
    q_c: Int,
    s1: Int,
    s2: Int,
    s3: Int,
    k1: Int,
    k2: Int,
    omega: Int
) -> PlonkVk {
    return PlonkVk {
        vk_id: id,
        domain_size: domain_size,
        num_inputs: num_inputs,
        q_l: q_l,
        q_r: q_r,
        q_m: q_m,
        q_o: q_o,
        q_c: q_c,
        s_sigma1: s1,
        s_sigma2: s2,
        s_sigma3: s3,
        k1: k1,
        k2: k2,
        omega: omega,
        is_active: true
    };
}

pub fn plonk_vk_to_string(vk: PlonkVk) -> String {
    let v_id = vk.vk_id;
    let ds_s = (vk.domain_size).to_string();
    let ni_s = (vk.num_inputs).to_string();
    return "PlonkVk[" + v_id + "](Domain=" + ds_s + ", Inputs=" + ni_s + ")";
}
