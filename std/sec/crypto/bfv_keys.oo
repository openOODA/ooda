// # BFV Keys and Key Lifecycle
//
// Logline: Manages key generation, validation, and serialization for BFV.
//
// Setup: Imports bfv_types.oo for key representations.
//
// Beats:
//   1. Generate and validate BFV public and private keys.
//   2. Implement key serialization and formatting routines.
//   3. Enforce security policies on key length and parameters.

import "./bfv_types.oo";

pub fn bfv_plaintext_create(plain_id: String, value: Int, poly_repr: String) -> BfvPlaintext {
    return BfvPlaintext {
        plain_id: plain_id,
        value: value,
        poly_repr: poly_repr,
        scale: 1,
        is_ntt_form: false,
        is_valid: true,
    };
}

pub fn bfv_plaintext_zero(plain_id: String) -> BfvPlaintext {
    return BfvPlaintext {
        plain_id: plain_id,
        value: 0,
        poly_repr: "0",
        scale: 1,
        is_ntt_form: false,
        is_valid: true,
    };
}

pub fn bfv_public_key_create(key_id: String, pk0: String, pk1: String) -> BfvPublicKey {
    let combined: String = pk0 + ":" + pk1;
    let chk: Int = bfv_calculate_checksum(combined);
    let mut valid: Bool = true;
    if pk0.len() == 0 {
        valid = false;
    }
    if pk1.len() == 0 {
        valid = false;
    }
    return BfvPublicKey {
        key_id: key_id,
        pk0_poly: pk0,
        pk1_poly: pk1,
        checksum: chk,
        is_valid: valid,
    };
}

pub fn bfv_secret_key_create(key_id: String, sk: String) -> BfvSecretKey {
    let chk: Int = bfv_calculate_checksum(sk);
    let mut valid: Bool = true;
    if sk.len() == 0 {
        valid = false;
    }
    return BfvSecretKey {
        key_id: key_id,
        sk_poly: sk,
        checksum: chk,
        is_wiped: false,
        is_valid: valid,
    };
}

pub fn bfv_secret_key_wipe(mut_sk: &mut BfvSecretKey) {
    (mut_sk).sk_poly = "";
    (mut_sk).checksum = 0;
    (mut_sk).is_wiped = true;
    (mut_sk).is_valid = false;
}

pub fn bfv_relin_keys_create(
    key_id: String,
    keys_data: List[String],
    decomp_degree: Int
) -> BfvRelinKeys {
    let n: Int = list_len(keys_data);
    let mut valid: Bool = true;
    if n == 0 {
        valid = false;
    }
    let mut chk: Int = 17;
    let mut i: Int = 0;
    while i < n {
        let item: String = list_get(keys_data, i);
        chk = chk + bfv_calculate_checksum(item);
        i = i + 1;
    }
    return BfvRelinKeys {
        key_id: key_id,
        keys_data: keys_data,
        decomposition_base_degree: decomp_degree,
        checksum: chk,
        is_valid: valid,
    };
}

pub fn bfv_galois_keys_create(
    key_id: String,
    elts: List[Int],
    keys_data: List[String]
) -> BfvGaloisKeys {
    let n_elts: Int = list_len(elts);
    let n_keys: Int = list_len(keys_data);
    let mut valid: Bool = true;
    if n_elts == 0 {
        valid = false;
    }
    if n_keys == 0 {
        valid = false;
    }
    let mut chk: Int = 31;
    let mut i: Int = 0;
    while i < n_keys {
        let item: String = list_get(keys_data, i);
        chk = chk + bfv_calculate_checksum(item);
        i = i + 1;
    }
    return BfvGaloisKeys {
        key_id: key_id,
        galois_elts: elts,
        keys_data: keys_data,
        checksum: chk,
        is_valid: valid,
    };
}

pub fn bfv_keypair_generate(pair_id: String, params: BfvParameters) -> BfvKeyPair {
    let pk_id: String = pair_id + "_pk";
    let sk_id: String = pair_id + "_sk";
    let rk_id: String = pair_id + "_rk";
    let gk_id: String = pair_id + "_gk";

    let pk: BfvPublicKey = bfv_public_key_create(pk_id, "pk0_sample_poly", "pk1_sample_poly");
    let sk: BfvSecretKey = bfv_secret_key_create(sk_id, "sk_sample_poly");

    let empty_relin_data: List[String] = ["rk0_poly", "rk1_poly"];
    let rk: BfvRelinKeys = bfv_relin_keys_create(rk_id, empty_relin_data, 1);

    let empty_elts: List[Int] = [3, 5];
    let empty_galois_data: List[String] = ["gk0_poly", "gk1_poly"];
    let gk: BfvGaloisKeys = bfv_galois_keys_create(gk_id, empty_elts, empty_galois_data);

    let p_valid: Bool = (params).is_valid;
    let pk_valid: Bool = (pk).is_valid;
    let sk_valid: Bool = (sk).is_valid;
    let valid: Bool = p_valid && pk_valid && sk_valid;

    return BfvKeyPair {
        pair_id: pair_id,
        public_key: pk,
        secret_key: sk,
        relin_keys: rk,
        galois_keys: gk,
        params: params,
        is_valid: valid,
    };
}
