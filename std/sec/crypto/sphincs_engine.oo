// # SPHINCS+ Engine Lifecycle and Administration
//
// Logline: Manages SPHINCS+ execution engine lifecycle, state tracking, and halt controls.
//
// Setup: Imports sphincs_ops.oo for key and state manipulation helpers.
//
// Beats:
//   1. Import SPHINCS+ operations and types.
//   2. Initialize and configure SPHINCS+ execution engines.
//   3. Monitor engine operational status and telemetry.
//   4. Implement emergency halt and state reset administrative routines.

import "./sphincs_ops.oo";

pub fn sphincs_engine_init(engine_id: String, key_pair: SphincsKeyPair) -> SphincsEngine {
    let p: SphincsParams = key_pair.params;
    let t_height: Int = p.h_hypertree_height;
    let t_layers: Int = p.d_tree_layers;
    let t_state: SphincsTreeState = sphincs_tree_state_init(t_height, t_layers);
    return SphincsEngine {
        engine_id: engine_id,
        key_pair: key_pair,
        tree_state: t_state,
        policy_strict: true,
        signatures_created: 0,
        signatures_verified: 0,
        system_halted: false,
    };
}

pub fn sphincs_engine_status(engine_ref: &SphincsEngine) -> Int {
    let halted: Bool = (engine_ref).system_halted;
    if halted {
        return 0;
    }
    let sc: Int = (engine_ref).signatures_created;
    let sv: Int = (engine_ref).signatures_verified;
    let ts_ref: SphincsTreeState = (engine_ref).tree_state;
    let st: Int = sphincs_tree_state_calculate_progress(&ts_ref);
    return sc * 100 + sv * 10 + st;
}

pub fn sphincs_engine_halt(mut_engine: &mut SphincsEngine) {
    (mut_engine).system_halted = true;
    let mut ts: SphincsTreeState = (mut_engine).tree_state;
    ts.is_active = false;
    (mut_engine).tree_state = ts;
}

pub fn sphincs_engine_reset(mut_engine: &mut SphincsEngine) {
    (mut_engine).system_halted = false;
    (mut_engine).signatures_created = 0;
    (mut_engine).signatures_verified = 0;
    let mut ts: SphincsTreeState = (mut_engine).tree_state;
    sphincs_tree_state_reset(&mut ts);
    (mut_engine).tree_state = ts;
}
