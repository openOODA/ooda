// # PLONK Circuit and Gate Definitions
//
// Logline: Constructs arithmetic circuits, constraint systems, and gate layouts for PLONK.
//
// Setup: Imports plonk_ops.oo for gate evaluations.
//
// Beats:
//   1. Define constraint systems and gate topologies for PLONK.
//   2. Compile witness assignments into circuit equations.
//   3. Verify circuit satisfiability and gate consistency.

import "./plonk_ops.oo";

pub fn plonk_circuit_init(id: String, mod_val: Int) -> PlonkCircuit {
    let empty_gates: List[CustomGate] = list_new();
    let empty_inputs: List[Int] = list_new();
    return PlonkCircuit {
        circuit_id: id,
        num_variables: 0,
        gates: empty_gates,
        public_inputs: empty_inputs,
        modulus: mod_val,
        is_compiled: false
    };
}

pub fn plonk_circuit_add_gate(circuit: &mut PlonkCircuit, gate: CustomGate) {
    if ((circuit).is_compiled) == true {
        return;
    }
    (circuit).gates = list_push((circuit).gates, gate);
    (circuit).num_variables = ((circuit).num_variables) + 1;
}

pub fn plonk_witness_create(
    id: String,
    a: Int,
    b: Int,
    c: Int,
    pub_in: Int
) -> PlonkWitness {
    return PlonkWitness {
        witness_id: id,
        wire_a_val: a,
        wire_b_val: b,
        wire_c_val: c,
        public_input: pub_in,
        is_valid: true
    };
}

pub fn plonk_circuit_eval_witness(circuit: PlonkCircuit, witness: PlonkWitness) -> Bool {
    if (witness.is_valid) == false {
        return false;
    }
    let n_gates = list_len(circuit.gates);
    let mut idx = 0;
    while idx < n_gates {
        let gate = list_get(circuit.gates, idx);
        let eval_res = custom_gate_eval(gate, witness.wire_a_val, witness.wire_b_val, witness.wire_c_val, circuit.modulus);
        if eval_res != 0 {
            return false;
        }
        idx = idx + 1;
    }
    return true;
}

// -------------------------------------------------------------------
// Fiat-Shamir Transcript Operations
// -------------------------------------------------------------------

pub fn plonk_transcript_init(id: String) -> PlonkTranscript {
    return PlonkTranscript {
        transcript_id: id,
        state: 5381,
        round: 0
    };
}

pub fn plonk_transcript_append(t: &mut PlonkTranscript, value: Int, mod_val: Int) {
    let mut st = (t).state;
    st = (st * 33) + value;
    if st < 0 {
        st = 0 - st;
    }
    if mod_val > 1 {
        st = st % mod_val;
    }
    (t).state = st;
    (t).round = ((t).round) + 1;
}

pub fn plonk_transcript_squeeze(t: &mut PlonkTranscript, mod_val: Int) -> Int {
    let mut st = (t).state;
    st = (st * 33) + ((t).round);
    if st < 0 {
        st = 0 - st;
    }
    (t).state = st;
    (t).round = ((t).round) + 1;
    if mod_val <= 1 {
        return 1;
    }
    let chal = (st % (mod_val - 1)) + 1;
    return chal;
}
