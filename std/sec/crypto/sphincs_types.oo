// # SPHINCS+ Cryptographic Data Types and Presets
//
// Logline: Defines post-quantum stateless hash-based signature parameter types, key representations, and preset configurations.
//
// Setup: Pure data definitions and hypertree geometry configurations.
//
// Beats:
//   1. Define SPHINCS+ parameters, hypertree config, keypair, and tree state structures.
//   2. Define WOTS+ and FORS signature data models.
//   3. Define SPHINCS+ signature and execution engine state containers.
//   4. Provide standard preset parameter and configuration constructors.

// -------------------------------------------------------------------
// Parameter & Configuration Types
// -------------------------------------------------------------------

pub type SphincsParams = struct {
    variant: String,
    n_hash_bytes: Int,
    h_hypertree_height: Int,
    d_tree_layers: Int,
    b_fors_height: Int,
    k_fors_trees: Int,
    w_wots_param: Int,
    is_robust: Bool
};

pub type SphincsHypertreeConfig = struct {
    hypertree_height: Int,
    tree_layers: Int,
    subtree_height: Int,
    total_leaves: Int
};

// -------------------------------------------------------------------
// Core Security Structures
// -------------------------------------------------------------------

pub type SphincsKeyPair = struct {
    pub_seed: String,
    pub_root: String,
    sec_seed: String,
    sec_prf: String,
    key_id: String,
    params: SphincsParams,
    is_valid: Bool
};

pub type SphincsTreeState = struct {
    tree_address: Int,
    leaf_address: Int,
    tree_height: Int,
    layer_index: Int,
    signatures_counter: Int,
    is_active: Bool
};

pub type SphincsForsSignature = struct {
    tree_roots: List[String],
    auth_paths: List[String]
};

pub type SphincsWotsSignature = struct {
    wots_sig_chains: List[String],
    wots_pk_checksum: Int
};

pub type SphincsSignature = struct {
    sig_id: String,
    r_randomness: String,
    fors_sig: SphincsForsSignature,
    hypertree_sig: List[String],
    tree_index: Int,
    leaf_index: Int,
    sig_len_bytes: Int,
    is_valid: Bool
};

pub type SphincsEngine = struct {
    engine_id: String,
    key_pair: SphincsKeyPair,
    tree_state: SphincsTreeState,
    policy_strict: Bool,
    signatures_created: Int,
    signatures_verified: Int,
    system_halted: Bool
};

// -------------------------------------------------------------------
// Preset Constructors
// -------------------------------------------------------------------

pub fn sphincs_params_shake256f() -> SphincsParams {
    return SphincsParams {
        variant: "SPHINCS+-SHAKE-256f-simple",
        n_hash_bytes: 32,
        h_hypertree_height: 68,
        d_tree_layers: 17,
        b_fors_height: 9,
        k_fors_trees: 35,
        w_wots_param: 16,
        is_robust: false
    };
}

pub fn sphincs_params_sha256s() -> SphincsParams {
    return SphincsParams {
        variant: "SPHINCS+-SHA2-128s-robust",
        n_hash_bytes: 16,
        h_hypertree_height: 63,
        d_tree_layers: 7,
        b_fors_height: 14,
        k_fors_trees: 14,
        w_wots_param: 16,
        is_robust: true
    };
}

pub fn sphincs_params_haraka256f() -> SphincsParams {
    return SphincsParams {
        variant: "SPHINCS+-Haraka-192f-simple",
        n_hash_bytes: 24,
        h_hypertree_height: 66,
        d_tree_layers: 22,
        b_fors_height: 8,
        k_fors_trees: 33,
        w_wots_param: 16,
        is_robust: false
    };
}

pub fn sphincs_hypertree_config_init(h: Int, d: Int) -> SphincsHypertreeConfig {
    let sub_h: Int = h / d;
    let leaves: Int = sub_h * d;
    return SphincsHypertreeConfig {
        hypertree_height: h,
        tree_layers: d,
        subtree_height: sub_h,
        total_leaves: leaves
    };
}

pub fn sphincs_hypertree_config_subtree_height(cfg_ref: &SphincsHypertreeConfig) -> Int {
    let sub_h: Int = (cfg_ref).subtree_height;
    return sub_h;
}
