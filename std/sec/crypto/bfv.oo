// # BFV Facade
//
// Logline: Re-exports BFV data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import BFV companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 7 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./bfv_keys.oo";
import "./bfv_codec.oo";
import "./bfv_crypt.oo";
import "./bfv_ops.oo";
import "./bfv_engine.oo";
import "./bfv_stubs.oo";

pub fn shim_marker_checksum() -> Int {
    return bfv_calculate_checksum("abc");
}

pub fn shim_marker_params_create() -> BfvParameters {
    return bfv_params_create(4096, 65537, 40, 128);
}

pub fn shim_marker_params_validate(p: &BfvParameters) -> Result[Bool, String] {
    return bfv_params_validate(p);
}

pub fn shim_marker_public_key_create() -> BfvPublicKey {
    return bfv_public_key_create("pk1", "pk0_poly", "pk1_poly");
}

pub fn shim_marker_secret_key_create() -> BfvSecretKey {
    return bfv_secret_key_create("sk1", "sk_poly");
}

pub fn shim_marker_keypair_generate() -> BfvKeyPair {
    let p: BfvParameters = bfv_params_create(4096, 65537, 40, 128);
    return bfv_keypair_generate("pair1", p);
}

pub fn shim_marker_encoder_init() -> BfvEncoder {
    let p: BfvParameters = bfv_params_create(4096, 65537, 40, 128);
    return bfv_encoder_init("enc1", p);
}

pub fn shim_marker_evaluator_do_work(ev: &BfvEvaluator) -> Int {
    return bfv_evaluator_do_work(ev);
}
