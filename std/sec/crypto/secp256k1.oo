// # Secp256K1 Facade
//
// Logline: Re-exports Secp256K1 data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import Secp256K1 companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 4 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./secp256k1_stubs.oo";

pub fn shim_marker_params() -> Secp256k1Params {
    return secp256k1_params_init();
}

pub fn shim_marker_checksum() -> Int {
    return secp256k1_checksum("abc");
}

pub fn shim_marker_hex_encode() -> String {
    return secp256k1_hex_encode("ab");
}

pub fn shim_marker_point_inf() -> Secp256k1Point {
    return secp256k1_point_infinity();
}

pub fn shim_marker_policy() -> Secp256k1SecurityPolicy {
    return secp256k1_policy_init(true, true);
}

pub fn shim_marker_engine() -> Secp256k1Engine {
    let p: Secp256k1SecurityPolicy = secp256k1_policy_init(true, true);
    return secp256k1_engine_init("e1", p);
}
