// # ChaCha20 Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for CHACHA20.
//
// Setup: Imports companion modules for validated CHACHA20 operations.
//
// Beats:
//   1. Import CHACHA20 operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./chacha20_ops.oo";

pub fn chacha_state_init(key: &ChaChaKey, nonce: &ChaChaNonce, initial_counter: Int) -> Result[ChaChaState, String] {
    let k_valid: Bool = chacha_key_validate(key);
    if k_valid == false {
        return Err("INVALID_KEY: Key validation failed");
    }
    let n_valid: Bool = chacha_nonce_validate(nonce);
    if n_valid == false {
        return Err("INVALID_NONCE: Nonce validation failed");
    }
    let mut mat: List[Int] = list_new();
    mat = list_push(mat, 1634760805);
    mat = list_push(mat, 858927202);
    mat = list_push(mat, 2037898541);
    mat = list_push(mat, 1797285172);
    let mut i: Int = 0;
    while i < 8 {
        mat = list_push(mat, 0);
        i = i + 1;
    }
    mat = list_push(mat, initial_counter);
    let mut j: Int = 0;
    while j < 3 {
        mat = list_push(mat, 0);
        j = j + 1;
    }
    let state: ChaChaState = ChaChaState {
        matrix: mat,
        rounds: 20,
        block_counter: initial_counter,
        is_initialized: true
    };
    return Ok(state);
}

pub fn chacha_state_validate(state: &ChaChaState) -> Bool {
    let is_init: Bool = (state).is_initialized;
    if is_init == false {
        return false;
    }
    let r: Int = (state).rounds;
    if r != 20 {
        if r != 12 {
            if r != 8 {
                return false;
            }
        }
    }
    return true;
}

pub fn chacha20_ciphertext_create(data: String, tag: Poly1305Tag, nonce: ChaChaNonce) -> ChaCha20Ciphertext {
    let data_len: Int = data.len();
    let t_valid: Bool = (tag).is_valid;
    let n_valid: Bool = (nonce).is_valid;
    let valid: Bool = t_valid && n_valid;
    return ChaCha20Ciphertext {
        data: data,
        tag: tag,
        nonce: nonce,
        len_bytes: data_len,
        is_valid: valid
    };
}

pub fn chacha20_ciphertext_validate(ct: &ChaCha20Ciphertext) -> Bool {
    let c_valid: Bool = (ct).is_valid;
    if c_valid == false {
        return false;
    }
    let t: Poly1305Tag = (ct).tag;
    let n: ChaChaNonce = (ct).nonce;
    let t_valid: Bool = poly1305_tag_validate(&t);
    let n_valid: Bool = chacha_nonce_validate(&n);
    if t_valid == false {
        return false;
    }
    if n_valid == false {
        return false;
    }
    let raw_data: String = (ct).data;
    let d_len: Int = raw_data.len();
    let c_len: Int = (ct).len_bytes;
    return c_len == d_len;
}

pub fn chacha20_poly1305_ctx_init(ctx_id: String, key: ChaChaKey) -> Result[ChaCha20Poly1305Ctx, String] {
    let k_valid: Bool = chacha_key_validate(&key);
    if k_valid == false {
        return Err("INVALID_KEY: ChaChaKey failed validation checks");
    }
    let mut mat: List[Int] = list_new();
    let st: ChaChaState = ChaChaState {
        matrix: mat,
        rounds: 20,
        block_counter: 0,
        is_initialized: true
    };
    return Ok(ChaCha20Poly1305Ctx {
        ctx_id: ctx_id,
        key: key,
        state: st,
        nonce_len: 12,
        tag_len: 16,
        is_initialized: true
    });
}

pub fn chacha20_poly1305_ctx_validate(ctx: &ChaCha20Poly1305Ctx) -> Bool {
    let is_init: Bool = (ctx).is_initialized;
    if is_init == false {
        return false;
    }
    let k: ChaChaKey = (ctx).key;
    let k_valid: Bool = chacha_key_validate(&k);
    if k_valid == false {
        return false;
    }
    let st: ChaChaState = (ctx).state;
    return chacha_state_validate(&st);
}

pub fn chacha20_security_policy_default() -> ChaCha20SecurityPolicy {
    return ChaCha20SecurityPolicy {
        min_rounds: 20,
        require_poly1305: true,
        fail_closed: true,
        is_active: true
    };
}

pub fn chacha20_engine_init(engine_id: String, key: ChaChaKey) -> Result[ChaCha20Engine, String] {
    let k_valid: Bool = chacha_key_validate(&key);
    if k_valid == false {
        return Err("INVALID_KEY: Key validation failed");
    }
    let policy: ChaCha20SecurityPolicy = chacha20_security_policy_default();
    let mut mat: List[Int] = list_new();
    let st: ChaChaState = ChaChaState {
        matrix: mat,
        rounds: 20,
        block_counter: 0,
        is_initialized: true
    };
    return Ok(ChaCha20Engine {
        engine_id: engine_id,
        policy: policy,
        key: key,
        state: st,
        bytes_encrypted: 0,
        bytes_decrypted: 0,
        system_halted: false
    });
}

