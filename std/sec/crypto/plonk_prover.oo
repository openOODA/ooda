// # PLONK Prover and Proof Generation
//
// Logline: Implements prover algorithms and proof generation steps for PLONK.
//
// Setup: Imports companion modules for circuit and commitment representations.
//
// Beats:
//   1. Initialize prover state and witness assignments.
//   2. Compute polynomial commitments and evaluation proofs.
//   3. Assemble complete {prefix.upper()} zero-knowledge proof.

import "./plonk_circuit.oo";

pub fn plonk_prover_init(
    id: String,
    circuit: PlonkCircuit,
    mod_val: Int,
    gen: Int
) -> PlonkProver {
    return PlonkProver {
        prover_id: id,
        circuit: circuit,
        proofs_generated: 0,
        modulus: mod_val,
        generator: gen,
        is_active: true,
    };
}

pub fn plonk_prover_set_active(prover: &mut PlonkProver, active: Bool) {
    (prover).is_active = active;
}

pub fn plonk_prover_create_proof(
    prover: &mut PlonkProver,
    witness: PlonkWitness
) -> PlonkProof {
    if ((prover).is_active) == false {
        return PlonkProof {
            proof_id: "ERR_INACTIVE_PROVER",
            a_comm: 0,
            b_comm: 0,
            c_comm: 0,
            z_comm: 0,
            t_lo_comm: 0,
            t_mid_comm: 0,
            t_hi_comm: 0,
            a_eval: 0,
            b_eval: 0,
            c_eval: 0,
            s1_eval: 0,
            s2_eval: 0,
            z_omega_eval: 0,
            zw_opening: 0,
            public_input: witness.public_input,
            is_valid: false,
        };
    }

    let p_cnt = ((prover).proofs_generated) + 1;
    (prover).proofs_generated = p_cnt;

    let p_mod = (prover).modulus;

    // Simulate polynomial commitments and openings over scalar field
    let a_c = plonk_mod_pow((prover).generator, witness.wire_a_val, p_mod);
    let b_c = plonk_mod_pow((prover).generator, witness.wire_b_val, p_mod);
    let c_c = plonk_mod_pow((prover).generator, witness.wire_c_val, p_mod);

    let prv_name = (prover).prover_id;
    let mut tr = plonk_transcript_init(prv_name);
    plonk_transcript_append(&mut tr, a_c, p_mod);
    plonk_transcript_append(&mut tr, b_c, p_mod);
    plonk_transcript_append(&mut tr, c_c, p_mod);

    let beta = plonk_transcript_squeeze(&mut tr, p_mod);
    let gamma = plonk_transcript_squeeze(&mut tr, p_mod);

    let z_c = plonk_mod_mul(beta, gamma, p_mod);
    plonk_transcript_append(&mut tr, z_c, p_mod);

    let alpha = plonk_transcript_squeeze(&mut tr, p_mod);
    let zeta = plonk_transcript_squeeze(&mut tr, p_mod);

    let t_lo = plonk_mod_mul(alpha, zeta, p_mod);
    let t_mid = plonk_mod_pow(zeta, 2, p_mod);
    let t_hi = plonk_mod_pow(zeta, 3, p_mod);

    let a_e = plonk_mod_add(witness.wire_a_val, 0, p_mod);
    let b_e = plonk_mod_add(witness.wire_b_val, 0, p_mod);
    let c_e = plonk_mod_add(witness.wire_c_val, 0, p_mod);
    let s1_e = plonk_mod_add(a_e, beta, p_mod);
    let s2_e = plonk_mod_add(b_e, gamma, p_mod);
    let zw_e = plonk_mod_mul(z_c, zeta, p_mod);
    let zw_open = plonk_mod_add(zw_e, alpha, p_mod);

    let p_id = prv_name + "_proof_" + (p_cnt.to_string());

    return PlonkProof {
        proof_id: p_id,
        a_comm: a_c,
        b_comm: b_c,
        c_comm: c_c,
        z_comm: z_c,
        t_lo_comm: t_lo,
        t_mid_comm: t_mid,
        t_hi_comm: t_hi,
        a_eval: a_e,
        b_eval: b_e,
        c_eval: c_e,
        s1_eval: s1_e,
        s2_eval: s2_e,
        z_omega_eval: zw_e,
        zw_opening: zw_open,
        public_input: witness.public_input,
        is_valid: true,
    };
}
