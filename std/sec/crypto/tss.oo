// # Threshold Signature Scheme Facade
//
// Logline: Re-exports TSS and FROST data types, operational constructors, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import TSS companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream threshold cryptography consumers.

import "./tss_types.oo";
import "./tss_ops.oo";
import "./tss_engine.oo";
import "./tss_stubs.oo";

pub fn shim_marker_tss_checksum() -> Int {
    return tss_checksum("abc");
}

pub fn shim_marker_tss_params() -> Result[ThresholdParams, String] {
    return tss_params_create(2, 3, 1, "FROST-Ed25519-SHA512");
}

pub fn shim_marker_keyshare() -> Result[ThresholdKeyShare, String] {
    let p: ThresholdParams = match tss_params_create(2, 3, 1, "FROST-Ed25519-SHA512") {
        Ok(tp) => tp,
        Err(e) => tss_params_default(),
    };
    return tss_keyshare_create("s1", 1, "sec", "pub", "gpk", p);
}

pub fn shim_marker_frost_sig() -> Result[FrostSignature, String] {
    let empty_indices: List[Int] = list_new();
    return frost_signature_create("sig1", "gpk", "r", "z", empty_indices, "digest", 0);
}

pub fn shim_marker_engine_init() -> TssEngine {
    let p: ThresholdParams = match tss_params_create(2, 3, 1, "FROST-Ed25519-SHA512") {
        Ok(tp) => tp,
        Err(e) => tss_params_default(),
    };
    let pol: TssSecurityPolicy = tss_policy_init(false, true, 2);
    return tss_engine_init("eng_tss", pol, p);
}

verify tss {
    let tparams_res: Result[ThresholdParams, String] = tss_params_create(2, 3, 1, "FROST-Ed25519-SHA512");
    let tparams: ThresholdParams = match tparams_res {
        Ok(tp) => tp,
        Err(err_msg) => tss_params_default(),
    };
    assert_eq!(tparams.threshold, 2);
    assert_eq!(tparams.total_shares, 3);
    assert_eq!(tparams.curve_id, 1);
    assert_eq!(tparams.is_valid, true);
    assert_eq!(tss_params_validate(tparams), true);

    let sec_share1: String = "0123456789abcdef0123456789abcdef";
    let pub_share1: String = "fedcba9876543210fedcba9876543210";
    let group_pk: String = "11223344556677889900aabbccddeeff";

    let share_res: Result[ThresholdKeyShare, String] = tss_keyshare_create(
        "SHARE_01",
        1,
        sec_share1,
        pub_share1,
        group_pk,
        tparams
    );
    let share1: ThresholdKeyShare = match share_res {
        Ok(sh) => sh,
        Err(err_msg) => tss_keyshare_default(),
    };
    assert_eq!(share1.is_valid, true);
    assert_eq!(tss_keyshare_validate(share1), true);

    let comm1_res: Result[FrostNonceCommitment, String] = frost_nonce_commitment_create(
        "COMM_01",
        1,
        "hiding_commitment_data_01",
        "binding_commitment_data_01"
    );
    let comm1: FrostNonceCommitment = match comm1_res {
        Ok(cm) => cm,
        Err(err_msg) => frost_nonce_commitment_default(),
    };
    assert_eq!(comm1.is_valid, true);

    let mut comm_list: List[FrostNonceCommitment] = list_new();
    comm_list = list_push(comm_list, comm1);

    let comm2_res: Result[FrostNonceCommitment, String] = frost_nonce_commitment_create(
        "COMM_02",
        2,
        "hiding_commitment_data_02",
        "binding_commitment_data_02"
    );
    let comm2: FrostNonceCommitment = match comm2_res {
        Ok(cm) => cm,
        Err(err_msg) => frost_nonce_commitment_default(),
    };
    comm_list = list_push(comm_list, comm2);

    let pkg_res: Result[FrostSigningPackage, String] = frost_signing_package_create(
        "PKG_01",
        "Message to be signed with 2-of-3 threshold",
        comm_list,
        tparams
    );
    let pkg: FrostSigningPackage = match pkg_res {
        Ok(pk) => pk,
        Err(err_msg) => frost_signing_package_default(),
    };
    assert_eq!(pkg.is_valid, true);

    let ps_res: Result[FrostPartialSignature, String] = frost_partial_signature_create(
        "PS_01",
        1,
        "partial_sig_z1_response_scalar",
        comm1
    );
    let ps1: FrostPartialSignature = match ps_res {
        Ok(psig) => psig,
        Err(err_msg) => frost_partial_signature_default(),
    };
    assert_eq!(ps1.is_valid, true);

    let mut indices: List[Int] = list_new();
    indices = list_push(indices, 1);
    indices = list_push(indices, 2);

    let r_raw: String = "11111111111111111111111111111111";
    let z_raw: String = "22222222222222222222222222222222";

    let frost_sig_res: Result[FrostSignature, String] = frost_signature_create(
        "SIG_FROST_01",
        group_pk,
        r_raw,
        z_raw,
        indices,
        "msg_digest_hash_val",
        1700000000
    );
    let frost_sig: FrostSignature = match frost_sig_res {
        Ok(fsig) => fsig,
        Err(err_msg) => frost_signature_default(),
    };
    assert_eq!(frost_sig.is_valid, true);
    assert_eq!(frost_signature_validate(frost_sig), true);

    let serialized_sig: String = frost_signature_serialize(frost_sig);
    assert_eq!(serialized_sig.len() > 0, true);

    let des_res: Result[FrostSignature, String] = frost_signature_deserialize(frost_sig.raw_bytes);
    let des_sig: FrostSignature = match des_res {
        Ok(fsig) => fsig,
        Err(err_msg) => frost_signature_default(),
    };
    assert_eq!(des_sig.is_valid, true);

    let tss_pol: TssSecurityPolicy = tss_policy_init(false, true, 2);
    let mut tss_engine: TssEngine = tss_engine_init("ENG_TSS_01", tss_pol, tparams);

    let reg_res: Result[Bool, String] = tss_engine_register_share(&mut tss_engine, share1);
    let reg_ok: Bool = match reg_res {
        Ok(flag) => flag,
        Err(err_msg) => false,
    };
    assert_eq!(reg_ok, true);

    let find_res: Result[ThresholdKeyShare, String] = tss_engine_find_share(tss_engine, 1);
    let found_share: ThresholdKeyShare = match find_res {
        Ok(sh) => sh,
        Err(err_msg) => tss_keyshare_default(),
    };
    assert_eq!(found_share.share_id, "SHARE_01");

    let hex_encoded: String = tss_hex_encode("abc");
    assert_eq!(hex_encoded, "616263");

    let hex_decoded_res: Result[String, String] = tss_hex_decode("616263");
    let hex_decoded: String = match hex_decoded_res {
        Ok(str_val) => str_val,
        Err(err_msg) => "",
    };
    assert_eq!(hex_decoded, "abc");

    let eq_test: Bool = tss_constant_time_eq("hello", "hello");
    assert_eq!(eq_test, true);
    let ne_test: Bool = tss_constant_time_eq("hello", "world");
    assert_eq!(ne_test, false);

    let mut share_to_wipe: ThresholdKeyShare = share1;
    tss_keyshare_wipe(&mut share_to_wipe);
    assert_eq!(share_to_wipe.is_wiped, true);
    assert_eq!(tss_keyshare_validate(share_to_wipe), false);
}
