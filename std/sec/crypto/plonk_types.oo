// # PLONK Data Types and Encodings
//
// Logline: Defines core data structures, metadata, and helper functions for PLONK.
//
// Setup: Pure data definitions and helper transformations.
//
// Beats:
//   1. Define core PLONK structures and configuration types.
//   2. Implement constructor and helper utilities.
//   3. Provide validation and conversion routines.

pub type CustomGate = struct {
    gate_id: String,
    gate_type: Int,
    q_l_coeff: Int,
    q_r_coeff: Int,
    q_m_coeff: Int,
    q_o_coeff: Int,
    q_c_coeff: Int,
    q_lookup: Int,
    degree: Int,
    is_enabled: Bool
};

pub type PlonkVk = struct {
    vk_id: String,
    domain_size: Int,
    num_inputs: Int,
    q_l: Int,
    q_r: Int,
    q_m: Int,
    q_o: Int,
    q_c: Int,
    s_sigma1: Int,
    s_sigma2: Int,
    s_sigma3: Int,
    k1: Int,
    k2: Int,
    omega: Int,
    is_active: Bool
};

pub type PlonkProof = struct {
    proof_id: String,
    a_comm: Int,
    b_comm: Int,
    c_comm: Int,
    z_comm: Int,
    t_lo_comm: Int,
    t_mid_comm: Int,
    t_hi_comm: Int,
    a_eval: Int,
    b_eval: Int,
    c_eval: Int,
    s1_eval: Int,
    s2_eval: Int,
    z_omega_eval: Int,
    zw_opening: Int,
    public_input: Int,
    is_valid: Bool
};

pub type PlonkCircuit = struct {
    circuit_id: String,
    num_variables: Int,
    gates: List[CustomGate],
    public_inputs: List[Int],
    modulus: Int,
    is_compiled: Bool
};

pub type PlonkWitness = struct {
    witness_id: String,
    wire_a_val: Int,
    wire_b_val: Int,
    wire_c_val: Int,
    public_input: Int,
    is_valid: Bool
};

pub type PlonkTranscript = struct {
    transcript_id: String,
    state: Int,
    round: Int
};

pub type PlonkProver = struct {
    prover_id: String,
    circuit: PlonkCircuit,
    proofs_generated: Int,
    modulus: Int,
    generator: Int,
    is_active: Bool
};

pub type PlonkVerifier = struct {
    verifier_id: String,
    vk: PlonkVk,
    proofs_verified: Int,
    proofs_rejected: Int,
    modulus: Int,
    generator: Int,
    strict_mode: Bool,
    is_active: Bool
};

pub type PlonkBatchVerifier = struct {
    batch_id: String,
    proofs: List[PlonkProof],
    vks: List[PlonkVk],
    verified_count: Int,
    failed_count: Int,
    is_completed: Bool
};

/// Module load marker — oodac requires ≥1 fn in types-only units.
pub fn plonk_types_module_loaded() -> Int {
    return 1;
}
