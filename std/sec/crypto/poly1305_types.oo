// # Poly1305 types
//
// Logline: Poly1305Tag destubbed off pub type String bytes.
// residual: destubbed to Int floor. Field not named len.

type Poly1305Tag = struct {
    checksum: Int,
    filled: Int,
    is_valid: Int
};

pub fn poly1305_tag_new(checksum: Int, filled: Int, is_valid: Int) -> Poly1305Tag {
    return Poly1305Tag {
        checksum: checksum,
        filled: filled,
        is_valid: is_valid
    };
}

pub fn poly1305_tag_checksum(t: Poly1305Tag) -> Int {
    return t.checksum;
}
