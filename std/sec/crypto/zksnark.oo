// # zk-SNARK Facade
//
// Logline: Re-exports zk-SNARK data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import zk-SNARK companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 7 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./zksnark_stubs.oo";

pub fn shim_marker_protocol() -> Int {
    return zksnark_protocol_groth16();
}

pub fn shim_marker_string_hash() -> Int {
    return zksnark_calculate_string_hash("abc");
}

pub fn shim_marker_policy() -> ZkSnarkPolicy {
    return zk_snark_policy_init("P1", 128, "BN254", true);
}

pub fn shim_marker_batch_init() -> ZkSnarkBatchVerifier {
    return zk_snark_batch_verifier_init("B1");
}

pub fn shim_marker_do_work(p: &ZkSnarkProver, v: &ZkSnarkVerifier) -> Int {
    return zksnark_do_work(p, v);
}
