// # Shamir Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for SHAMIR.
//
// Setup: Imports companion modules for validated SHAMIR operations.
//
// Beats:
//   1. Import SHAMIR operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./shamir_ops.oo";

// -------------------------------------------------------------------
// Type Constructors & Validators
// -------------------------------------------------------------------

pub fn shamir_config_create(
    config_id: String,
    total_shares: Int,
    threshold: Int,
    prime_modulus: Int
) -> Result[ShamirConfig, String] {
    if threshold < 2 {
        return Err("INVALID_CONFIG: Threshold K must be at least 2");
    }
    if total_shares < threshold {
        return Err("INVALID_CONFIG: Total shares N must be greater than or equal to threshold K");
    }
    let cfg: ShamirConfig = ShamirConfig {
        config_id: config_id,
        total_shares: total_shares,
        threshold: threshold,
        prime_modulus: prime_modulus,
        use_gf256: false,
        security_level: 256,
        is_active: true,
    };
    return Ok(cfg);
}

pub fn shamir_config_validate(config: &ShamirConfig) -> Bool {
    let cfg_active: Bool = (config).is_active;
    if cfg_active == false {
        return false;
    }
    let k: Int = (config).threshold;
    let n: Int = (config).total_shares;
    if k < 2 {
        return false;
    }
    if n < k {
        return false;
    }
    return true;
}

pub fn shamir_config_default() -> ShamirConfig {
    return ShamirConfig {
        config_id: "default_cfg",
        total_shares: 5,
        threshold: 3,
        prime_modulus: 65537,
        use_gf256: false,
        security_level: 256,
        is_active: true,
    };
}

pub fn secret_share_create(
    share_id: String,
    x: Int,
    y_value: Int,
    raw_data: String
) -> Result[SecretShare, String] {
    if x <= 0 {
        return Err("INVALID_SHARE: Evaluation point x must be positive (x > 0)");
    }
    let chk: Int = shamir_checksum(raw_data) + x + y_value;
    let share: SecretShare = SecretShare {
        share_id: share_id,
        x: x,
        y_value: y_value,
        raw_data: raw_data,
        checksum: chk,
        is_valid: true,
    };
    return Ok(share);
}

pub fn secret_share_validate(share: &SecretShare) -> Bool {
    let s_valid: Bool = (share).is_valid;
    if s_valid == false {
        return false;
    }
    let sx: Int = (share).x;
    if sx <= 0 {
        return false;
    }
    let raw: String = (share).raw_data;
    let sy: Int = (share).y_value;
    let expected_chk: Int = shamir_checksum(raw) + sx + sy;
    let chk: Int = (share).checksum;
    return chk == expected_chk;
}

pub fn secret_share_serialize(share: &SecretShare) -> String {
    let sid: String = (share).share_id;
    let sx: Int = (share).x;
    let sy: Int = (share).y_value;
    let raw: String = (share).raw_data;
    let x_str: String = sx.to_string();
    let y_str: String = sy.to_string();
    let hex_raw: String = shamir_hex_encode(raw);
    return "SHARE:" + sid + ":" + x_str + ":" + y_str + ":" + hex_raw;
}

pub fn secret_share_deserialize(encoded: String) -> Result[SecretShare, String] {
    let elen: Int = encoded.len();
    if elen < 8 {
        return Err("INVALID_ENCODING: Share string too short");
    }
    let chk: Int = shamir_checksum(encoded);
    let s: SecretShare = SecretShare {
        share_id: "deserialized",
        x: 1,
        y_value: chk % 65537,
        raw_data: encoded,
        checksum: shamir_checksum(encoded) + 1 + (chk % 65537),
        is_valid: true,
    };
    return Ok(s);
}

pub fn secret_reconstruction_create(
    reconstruction_id: String,
    secret_str: String,
    secret_val: Int,
    shares_count: Int,
    threshold: Int
) -> SecretReconstruction {
    let mut success: Bool = true;
    let mut status: Int = 0;
    let mut err: String = "OK";
    if shares_count < threshold {
        success = false;
        status = -1;
        err = "INSUFFICIENT_SHARES: Shares provided less than threshold K";
    }

    return SecretReconstruction {
        reconstruction_id: reconstruction_id,
        recovered_secret: secret_str,
        recovered_value: secret_val,
        shares_provided: shares_count,
        threshold_required: threshold,
        is_successful: success,
        status_code: status,
        error_msg: err,
    };
}

pub fn secret_reconstruction_validate(rec: &SecretReconstruction) -> Bool {
    let r_succ: Bool = (rec).is_successful;
    if r_succ == false {
        return false;
    }
    let prov: Int = (rec).shares_provided;
    let req: Int = (rec).threshold_required;
    if prov < req {
        return false;
    }
    return true;
}
