// # HMAC Computation and Verification Engine
//
// Logline: Streaming HMAC buffer updates, tag finalization, SHA-256 tag verification, and dispatch engine.
//
// Setup: Core evaluation and streaming authentication routines for HMAC operations.
//
// Beats:
//   1. Generate and verify raw bytes SHA-256 authentication tags.
//   2. Dispatch HMAC computation across supported algorithms with fail-closed traps.
//   3. Dispatch constant-time tag verification against expected message digests.
//   4. Update streaming buffer state and finalize cryptographic authentication tags.

import "./hmac_types.oo";
import "./hmac_ops.oo";

pub fn hmac_sha256_bytes(key: &HmacKey, message: String) -> Result[MacTag, String] {
    let k_valid: Bool = hmac_key_validate(key);
    if k_valid == false {
        return Err("INVALID_KEY: Key validation failed");
    }
    let raw_k: String = (key).raw_bytes;
    let hex_sig: String = hmac_sha256(raw_k, message);
    let dec_res: Result[String, String] = hex_decode(hex_sig);
    if !dec_res.is_ok() {
        return Err("INVALID_HEX: Decode failed");
    }
    let raw_tag: String = match dec_res {
        Ok(t) => t,
        Err(_) => "",
    };
    return mac_tag_create("sha256_tag", raw_tag, "SHA-256");
}

pub fn hmac_sha256_verify(key: &HmacKey, message: String, tag: &MacTag) -> HmacVerificationResult {
    let k_valid: Bool = hmac_key_validate(key);
    if k_valid == false {
        return HmacVerificationResult {
            is_valid: false,
            key_id: (key).key_id,
            tag_id: (tag).tag_id,
            algorithm: "SHA-256",
            error_code: "INVALID_KEY",
            verification_time: 0,
        };
    }
    let t_valid: Bool = mac_tag_validate(tag);
    if t_valid == false {
        return HmacVerificationResult {
            is_valid: false,
            key_id: (key).key_id,
            tag_id: (tag).tag_id,
            algorithm: "SHA-256",
            error_code: "INVALID_TAG",
            verification_time: 0,
        };
    }
    let raw_k: String = (key).raw_bytes;
    let expected_hex: String = hmac_sha256(raw_k, message);
    let actual_hex: String = (tag).hex_str;
    let is_eq: Bool = bytes_constant_time_eq(expected_hex, actual_hex);
    if is_eq {
        return HmacVerificationResult {
            is_valid: true,
            key_id: (key).key_id,
            tag_id: (tag).tag_id,
            algorithm: "SHA-256",
            error_code: "OK",
            verification_time: 0,
        };
    }
    return HmacVerificationResult {
        is_valid: false,
        key_id: (key).key_id,
        tag_id: (tag).tag_id,
        algorithm: "SHA-256",
        error_code: "TAG_MISMATCH",
        verification_time: 0,
    };
}

pub fn hmac_compute(ctx: &HmacCtx, message: String) -> Result[MacTag, String] {
    let c_valid: Bool = hmac_ctx_validate(ctx);
    if c_valid == false {
        return Err("INVALID_CTX: HMAC context validation failed");
    }
    let cfg_ref: &HmacConfig = &(ctx).config;
    let alg: String = (cfg_ref).algorithm;
    if alg == "SHA-256" {
        let k_ref: &HmacKey = &(ctx).key;
        return hmac_sha256_bytes(k_ref, message);
    }
    // Fail-closed for algorithms unsupported by compiler runtime
    process_exit(1);
    let dummy_tag: MacTag = MacTag {
        tag_id: "stub",
        tag_bytes: "",
        hex_str: "",
        len: 0,
        checksum: 0,
        algorithm: alg,
        is_valid: false,
    };
    return Ok(dummy_tag);
}

pub fn hmac_verify(ctx: &HmacCtx, message: String, tag: &MacTag) -> HmacVerificationResult {
    let c_valid: Bool = hmac_ctx_validate(ctx);
    if c_valid == false {
        return HmacVerificationResult {
            is_valid: false,
            key_id: (ctx).key.key_id,
            tag_id: (tag).tag_id,
            algorithm: (ctx).config.algorithm,
            error_code: "INVALID_CTX",
            verification_time: 0,
        };
    }
    let cfg_ref: &HmacConfig = &(ctx).config;
    let alg: String = (cfg_ref).algorithm;
    if alg == "SHA-256" {
        let k_ref: &HmacKey = &(ctx).key;
        return hmac_sha256_verify(k_ref, message, tag);
    }
    // Fail-closed stub for other algorithms
    process_exit(1);
    return HmacVerificationResult {
        is_valid: false,
        key_id: (ctx).key.key_id,
        tag_id: (tag).tag_id,
        algorithm: alg,
        error_code: "UNSUPPORTED_ALGORITHM",
        verification_time: 0,
    };
}

pub fn hmac_update(ctx: &mut HmacCtx, chunk: String) -> Result[Bool, String] {
    let c_valid: Bool = hmac_ctx_validate(ctx);
    if c_valid == false {
        return Err("INVALID_CTX: Context invalid");
    }
    let chunk_len: Int = chunk.len();
    let old_buf: String = (ctx).buffer;
    let old_proc: Int = (ctx).bytes_processed;
    (ctx).buffer = old_buf + chunk;
    (ctx).bytes_processed = old_proc + chunk_len;
    return Ok(true);
}

pub fn hmac_finalize(ctx: &mut HmacCtx) -> Result[MacTag, String] {
    let c_valid: Bool = hmac_ctx_validate(ctx);
    if c_valid == false {
        return Err("INVALID_CTX: Context invalid");
    }
    let full_msg: String = (ctx).buffer;
    let res: Result[MacTag, String] = hmac_compute(ctx, full_msg);
    // Reset buffer after finalization
    (ctx).buffer = "";
    (ctx).bytes_processed = 0;
    return res;
}

pub fn hmac_engine_probe() -> Int {
    return 0;
}
