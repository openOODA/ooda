// # SPHINCS+ Post-Quantum Signature Facade
//
// Logline: Re-exports SPHINCS+ data types, parameter presets, operations, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import SPHINCS+ companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream post-quantum consumers.

import "./sphincs_types.oo";
import "./sphincs_ops.oo";
import "./sphincs_engine.oo";
import "./sphincs_stubs.oo";

pub fn shim_marker_params_shake256f() -> SphincsParams {
    return sphincs_params_shake256f();
}

pub fn shim_marker_params_sha256s() -> SphincsParams {
    return sphincs_params_sha256s();
}

pub fn shim_marker_params_haraka() -> SphincsParams {
    return sphincs_params_haraka256f();
}

pub fn shim_marker_hypertree_config() -> SphincsHypertreeConfig {
    return sphincs_hypertree_config_init(68, 17);
}

pub fn shim_marker_keypair_create() -> SphincsKeyPair {
    let p = sphincs_params_shake256f();
    return sphincs_keypair_create("seed", "root", "sec_seed", "sec_prf", "k1", p);
}

pub fn shim_marker_tree_state() -> SphincsTreeState {
    return sphincs_tree_state_init(68, 17);
}

pub fn shim_marker_wots_sig() -> SphincsWotsSignature {
    let empty_chains: List[String] = [];
    return sphincs_wots_signature_create(empty_chains, 1234);
}

pub fn shim_marker_fors_sig() -> SphincsForsSignature {
    let empty_roots: List[String] = [];
    let empty_auth: List[String] = [];
    return sphincs_fors_signature_create(empty_roots, empty_auth);
}

pub fn shim_marker_engine_init() -> SphincsEngine {
    let p = sphincs_params_shake256f();
    let kp = sphincs_keypair_create("seed", "root", "sec_seed", "sec_prf", "k1", p);
    return sphincs_engine_init("eng_sphincs", kp);
}
