// # Ed25519 Signature Types and Constructors
//
// Logline: Data structures, key representations, and signature constructors for Ed25519.
//
// Setup: Core pure cryptographic data structures for RFC 8032 Edwards-curve digital signatures.
//
// Beats:
//   1. Declare public key, secret key, key pair, and signature data structures.
//   2. Define security policy, batch verifier, and verification result schemas.
//   3. Implement structural key validation, key creation, and secret key wiping.
//   4. Define keypair and signature constructors and validation routines.

import "./ed25519_ops.oo";

pub type Ed25519PublicKey = struct {
    key_id: String,
    raw_bytes: String,
    hex_str: String,
    checksum: Int,
    is_valid: Bool
};

pub type Ed25519SecretKey = struct {
    key_id: String,
    seed_bytes: String,
    expanded_bytes: String,
    checksum: Int,
    is_wiped: Bool
};

pub type Ed25519KeyPair = struct {
    key_id: String,
    public_key: Ed25519PublicKey,
    secret_key: Ed25519SecretKey,
    created_at: Int,
    is_valid: Bool
};

pub type Ed25519Signature = struct {
    sig_id: String,
    key_id: String,
    r_bytes: String,
    s_bytes: String,
    raw_bytes: String,
    checksum: Int,
    created_at: Int,
    is_valid: Bool
};

pub type Ed25519VerificationResult = struct {
    is_valid: Bool,
    key_id: String,
    message_digest: String,
    error_code: String,
    verification_time: Int
};

pub type Ed25519SecurityPolicy = struct {
    require_sys_cap: Bool,
    fail_closed: Bool,
    allow_legacy_ph: Bool,
    is_active: Bool
};

pub type Ed25519Engine = struct {
    engine_id: String,
    policy: Ed25519SecurityPolicy,
    key_pairs: List[Ed25519KeyPair],
    signed_count: Int,
    verified_count: Int,
    rejected_count: Int,
    strict_mode: Bool,
    system_halted: Bool
};

pub type Ed25519BatchVerifier = struct {
    batch_id: String,
    total_signatures: Int,
    valid_count: Int,
    invalid_count: Int,
    is_completed: Bool
};

pub fn ed25519_public_key_create(key_id: String, raw_bytes: String) -> Result[Ed25519PublicKey, String] {
    let raw_len: Int = raw_bytes.len();
    if raw_len != 32 {
        return Err("INVALID_PUBLIC_KEY_SIZE: Ed25519 public key must be 32 bytes (256 bits)");
    }
    let hex_val: String = ed25519_hex_encode(raw_bytes);
    let chk: Int = ed25519_checksum(raw_bytes);
    let pk: Ed25519PublicKey = Ed25519PublicKey {
        key_id: key_id,
        raw_bytes: raw_bytes,
        hex_str: hex_val,
        checksum: chk,
        is_valid: true
    };
    return Ok(pk);
}

pub fn ed25519_public_key_validate(pk: &Ed25519PublicKey) -> Bool {
    let p_valid: Bool = (pk).is_valid;
    if p_valid == false {
        return false;
    }
    let raw: String = (pk).raw_bytes;
    let raw_len: Int = raw.len();
    if raw_len != 32 {
        return false;
    }
    let expected_chk: Int = ed25519_checksum(raw);
    let p_chk: Int = (pk).checksum;
    return p_chk == expected_chk;
}

pub fn ed25519_secret_key_create(key_id: String, seed_bytes: String) -> Result[Ed25519SecretKey, String] {
    let seed_len: Int = seed_bytes.len();
    if seed_len != 32 {
        return Err("INVALID_SECRET_KEY_SIZE: Ed25519 secret seed must be 32 bytes (256 bits)");
    }
    let chk: Int = ed25519_checksum(seed_bytes);
    let sk: Ed25519SecretKey = Ed25519SecretKey {
        key_id: key_id,
        seed_bytes: seed_bytes,
        expanded_bytes: "",
        checksum: chk,
        is_wiped: false
    };
    return Ok(sk);
}

pub fn ed25519_secret_key_validate(sk: &Ed25519SecretKey) -> Bool {
    let wiped: Bool = (sk).is_wiped;
    if wiped {
        return false;
    }
    let raw: String = (sk).seed_bytes;
    let raw_len: Int = raw.len();
    if raw_len != 32 {
        return false;
    }
    let expected_chk: Int = ed25519_checksum(raw);
    let s_chk: Int = (sk).checksum;
    return s_chk == expected_chk;
}

pub fn ed25519_secret_key_wipe(sk: Ed25519SecretKey) -> Ed25519SecretKey {
    let kid: String = sk.key_id;
    return Ed25519SecretKey {
        key_id: kid,
        seed_bytes: "",
        expanded_bytes: "",
        checksum: 0,
        is_wiped: true
    };
}

pub fn ed25519_keypair_create(
    key_id: String,
    public_key: Ed25519PublicKey,
    secret_key: Ed25519SecretKey,
    created_at: Int
) -> Result[Ed25519KeyPair, String] {
    let pk_ref: &Ed25519PublicKey = &public_key;
    let sk_ref: &Ed25519SecretKey = &secret_key;
    let p_valid: Bool = ed25519_public_key_validate(pk_ref);
    if p_valid == false {
        return Err("INVALID_KEYPAIR: Public key failed validation");
    }
    let s_valid: Bool = ed25519_secret_key_validate(sk_ref);
    if s_valid == false {
        return Err("INVALID_KEYPAIR: Secret key failed validation");
    }
    let kp: Ed25519KeyPair = Ed25519KeyPair {
        key_id: key_id,
        public_key: public_key,
        secret_key: secret_key,
        created_at: created_at,
        is_valid: true
    };
    return Ok(kp);
}

pub fn ed25519_keypair_validate(kp: &Ed25519KeyPair) -> Bool {
    let k_valid: Bool = (kp).is_valid;
    if k_valid == false {
        return false;
    }
    let pk_ref: &Ed25519PublicKey = &(kp).public_key;
    let sk_ref: &Ed25519SecretKey = &(kp).secret_key;
    let p_valid: Bool = ed25519_public_key_validate(pk_ref);
    let s_valid: Bool = ed25519_secret_key_validate(sk_ref);
    let res: Bool = p_valid && s_valid;
    return res;
}

pub fn ed25519_signature_create(
    sig_id: String,
    key_id: String,
    r_bytes: String,
    s_bytes: String,
    created_at: Int
) -> Result[Ed25519Signature, String] {
    let r_len: Int = r_bytes.len();
    if r_len != 32 {
        return Err("INVALID_SIGNATURE_R_SIZE: Ed25519 signature R component must be 32 bytes");
    }
    let s_len: Int = s_bytes.len();
    if s_len != 32 {
        return Err("INVALID_SIGNATURE_S_SIZE: Ed25519 signature S component must be 32 bytes");
    }
    let combined_raw: String = r_bytes + s_bytes;
    let chk: Int = ed25519_checksum(combined_raw);
    let sig: Ed25519Signature = Ed25519Signature {
        sig_id: sig_id,
        key_id: key_id,
        r_bytes: r_bytes,
        s_bytes: s_bytes,
        raw_bytes: combined_raw,
        checksum: chk,
        created_at: created_at,
        is_valid: true
    };
    return Ok(sig);
}

pub fn ed25519_signature_validate(sig: &Ed25519Signature) -> Bool {
    let s_valid: Bool = (sig).is_valid;
    if s_valid == false {
        return false;
    }
    let r_str: String = (sig).r_bytes;
    let r_len: Int = r_str.len();
    let s_str: String = (sig).s_bytes;
    let s_len: Int = s_str.len();
    if r_len != 32 {
        return false;
    }
    if s_len != 32 {
        return false;
    }
    let raw: String = (sig).raw_bytes;
    let raw_len: Int = raw.len();
    if raw_len != 64 {
        return false;
    }
    let expected_chk: Int = ed25519_checksum(raw);
    let s_chk: Int = (sig).checksum;
    return s_chk == expected_chk;
}
