// # ZK-STARK Cryptography Facade
//
// Logline: Re-exports ZK-STARK data types, AIR operations, prover/verifier engines, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import ZK-STARK companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream zero-knowledge consumers.

import "./zkstark_types.oo";
import "./zkstark_ops.oo";
import "./zkstark_engine.oo";
import "./zkstark_stubs.oo";

pub fn shim_marker_mod_pow() -> Int {
    return stark_mod_pow(2, 8, 1009);
}

pub fn shim_marker_air_init() -> StarkAir {
    return stark_air_init("air1", 4, 4, 16);
}

pub fn shim_marker_prover_init() -> StarkProver {
    let a: StarkAir = stark_air_init("air1", 4, 4, 16);
    return stark_prover_init("prv1", a, 128, 4, 32);
}

pub fn shim_marker_verifier_init() -> StarkVerifier {
    let a: StarkAir = stark_air_init("air1", 4, 4, 16);
    return stark_verifier_init("ver1", a, 128);
}

pub fn shim_marker_batch_verifier() -> StarkBatchVerifier {
    return stark_batch_verifier_init("b1");
}

verify zkstark {
    let prime_modulus: Int = 1009;
    let mut air: StarkAir = stark_air_init("AIR_FIB", 4, 4, 16);
    let c1: AirConstraint = air_constraint_create("C_INITIAL", 1, 1, 0, 1, true);
    let c2: AirConstraint = air_constraint_create("C_TRANSITION", 1, 1, 0, 0, false);
    stark_air_add_constraint(&mut air, c1);
    stark_air_add_constraint(&mut air, c2);

    let mut trace_vals: List[Int] = list_new();
    trace_vals = list_push(trace_vals, 1);
    trace_vals = list_push(trace_vals, 1);
    trace_vals = list_push(trace_vals, 2);
    trace_vals = list_push(trace_vals, 3);
    let trace: StarkTrace = stark_trace_create("TR_01", 4, 1, trace_vals);

    let mut prover: StarkProver = stark_prover_init("PROVER_1", air, 128, 4, 32);
    let mut verifier: StarkVerifier = stark_verifier_init("VERIFIER_1", air, 128);

    let mut pub_in: List[Int] = list_new();
    pub_in = list_push(pub_in, 1);
    pub_in = list_push(pub_in, 3);

    let proof: StarkProof = stark_prover_generate_proof(&mut prover, trace, pub_in, prime_modulus);
    assert_eq!(prover.proofs_generated, 1);
    assert_eq!(proof.is_verified, true);

    let v_ok: Bool = stark_verifier_verify_proof(&mut verifier, proof, prime_modulus);
    assert_eq!(v_ok, true);
    assert_eq!(verifier.proofs_verified, 1);

    let mut batch: StarkBatchVerifier = stark_batch_verifier_init("BATCH_1");
    stark_batch_verifier_add(&mut batch, proof);
    let batch_ok: Bool = stark_batch_verifier_verify_all(&mut verifier, &mut batch, prime_modulus);
    assert_eq!(batch_ok, true);

    let proof_str: String = stark_proof_to_string(proof);
    assert_eq!(proof_str.len() > 0, true);
}
