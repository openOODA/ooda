import "./zkstark_types.oo";
import "./zkstark_ops.oo";

pub fn shim_marker_mod_pow() -> Int {
    return stark_mod_pow(2, 8, 1009);
}

pub fn shim_marker_mod_mul() -> Int {
    return stark_mod_mul(3, 7, 1009);
}

pub fn shim_marker_mod_add() -> Int {
    return stark_mod_add(10, 20, 1009);
}

pub fn shim_marker_mod_sub() -> Int {
    return stark_mod_sub(20, 10, 1009);
}

pub fn shim_marker_air_constraint_new(deg: Int, coef: Int, step: Int) -> AirConstraint {
    return air_constraint_new(deg, coef, step);
}

pub fn shim_marker_air_constraint_degree(c: AirConstraint) -> Int {
    return air_constraint_degree(c);
}

