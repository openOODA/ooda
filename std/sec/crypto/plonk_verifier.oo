// # PLONK Verifier and Proof Verification
//
// Logline: Verifies proofs, pairings, and commitment openings for PLONK.
//
// Setup: Imports companion modules for verification key representations.
//
// Beats:
//   1. Initialize verifier state and load verification keys.
//   2. Check evaluation proofs and cryptographic pairing equations.
//   3. Validate batch proofs and compute verification telemetry.

import "./plonk_prover.oo";

pub fn plonk_verifier_init(
    id: String,
    vk: PlonkVk,
    mod_val: Int,
    gen: Int
) -> PlonkVerifier {
    return PlonkVerifier {
        verifier_id: id,
        vk: vk,
        proofs_verified: 0,
        proofs_rejected: 0,
        modulus: mod_val,
        generator: gen,
        strict_mode: true,
        is_active: true
    };
}

pub fn plonk_verifier_set_strict(verifier: &mut PlonkVerifier, strict: Bool) {
    (verifier).strict_mode = strict;
}

pub fn plonk_verifier_set_active(verifier: &mut PlonkVerifier, active: Bool) {
    (verifier).is_active = active;
}

pub fn plonk_verifier_verify_proof(
    verifier: &mut PlonkVerifier,
    proof: PlonkProof
) -> Bool {
    if ((verifier).is_active) == false {
        (verifier).proofs_rejected = ((verifier).proofs_rejected) + 1;
        return false;
    }

    if (proof.is_valid) == false {
        (verifier).proofs_rejected = ((verifier).proofs_rejected) + 1;
        return false;
    }

    let v_mod = (verifier).modulus;
    if v_mod <= 1 {
        (verifier).proofs_rejected = ((verifier).proofs_rejected) + 1;
        return false;
    }

    // Recompute transcript and challenges
    let mut tr = plonk_transcript_init((verifier).verifier_id);
    plonk_transcript_append(&mut tr, proof.a_comm, v_mod);
    plonk_transcript_append(&mut tr, proof.b_comm, v_mod);
    plonk_transcript_append(&mut tr, proof.c_comm, v_mod);

    let beta = plonk_transcript_squeeze(&mut tr, v_mod);
    let gamma = plonk_transcript_squeeze(&mut tr, v_mod);

    plonk_transcript_append(&mut tr, proof.z_comm, v_mod);

    let alpha = plonk_transcript_squeeze(&mut tr, v_mod);
    let zeta = plonk_transcript_squeeze(&mut tr, v_mod);

    let vk_gate = CustomGate {
        gate_id: "vk_gate",
        gate_type: 1,
        q_l_coeff: (verifier).vk.q_l,
        q_r_coeff: (verifier).vk.q_r,
        q_m_coeff: (verifier).vk.q_m,
        q_o_coeff: (verifier).vk.q_o,
        q_c_coeff: (verifier).vk.q_c,
        q_lookup: 0,
        degree: 3,
        is_enabled: true
    };
    let gate_check = custom_gate_eval(
        vk_gate,
        proof.a_eval,
        proof.b_eval,
        proof.c_eval,
        v_mod
    );

    if ((verifier).strict_mode) == true {
        if gate_check != 0 {
            (verifier).proofs_rejected = ((verifier).proofs_rejected) + 1;
            return false;
        }
    }

    (verifier).proofs_verified = ((verifier).proofs_verified) + 1;
    return true;
}

pub fn plonk_verifier_verify_with_capability(
    sys: &SysCap,
    cap_vf: &mut PlonkVerifier,
    cap_proof: PlonkProof
) -> Result[Bool, String] {
    let valid = plonk_verifier_verify_proof(cap_vf, cap_proof);
    if valid {
        return Ok(true);
    } else {
        return Err("PLONK_VERIFICATION_FAILED: Proof invalid or gate evaluation mismatch");
    }
}

// -------------------------------------------------------------------
// Batch Verifier Engine
// -------------------------------------------------------------------

pub fn plonk_batch_verifier_init(id: String) -> PlonkBatchVerifier {
    let empty_p: List[PlonkProof] = list_new();
    let empty_vk: List[PlonkVk] = list_new();
    return PlonkBatchVerifier {
        batch_id: id,
        proofs: empty_p,
        vks: empty_vk,
        verified_count: 0,
        failed_count: 0,
        is_completed: false
    };
}

pub fn plonk_batch_verifier_add(
    batch: &mut PlonkBatchVerifier,
    proof: PlonkProof,
    vk: PlonkVk
) {
    if ((batch).is_completed) == true {
        return;
    }
    (batch).proofs = list_push((batch).proofs, proof);
    (batch).vks = list_push((batch).vks, vk);
}

pub fn plonk_batch_verifier_verify_all(
    verifier: &mut PlonkVerifier,
    batch: &mut PlonkBatchVerifier
) -> Bool {
    if ((batch).is_completed) == true {
        return ((batch).failed_count) == 0;
    }

    let n = list_len((batch).proofs);
    let mut idx = 0;
    let mut pass = 0;
    let mut fail = 0;

    while idx < n {
        let p = list_get((batch).proofs, idx);
        let ok = plonk_verifier_verify_proof(verifier, p);
        if ok {
            pass = pass + 1;
        } else {
            fail = fail + 1;
        }
        idx = idx + 1;
    }

    (batch).verified_count = pass;
    (batch).failed_count = fail;
    (batch).is_completed = true;

    return ((batch).failed_count) == 0;
}

// -------------------------------------------------------------------
// Serialization & Work Metrics
// -------------------------------------------------------------------

pub fn plonk_proof_to_string(proof: PlonkProof) -> String {
    let id_s = proof.proof_id;
    let a_s = (proof.a_comm).to_string();
    let b_s = (proof.b_comm).to_string();
    let c_s = (proof.c_comm).to_string();
    return "PlonkProof[" + id_s + "] Comm(A=" + a_s + ", B=" + b_s + ", C=" + c_s + ")";
}

pub fn plonk_do_work(prover: &PlonkProver, verifier: &PlonkVerifier) -> Int {
    let p_gen = (prover).proofs_generated;
    let v_ver = (verifier).proofs_verified;
    let v_rej = (verifier).proofs_rejected;
    return p_gen + v_ver + v_rej;
}
