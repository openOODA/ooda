// # Bulletproofs types
//
// Logline: Data structures, generators, inner product proofs, and range proof types for Bulletproofs.
//
// Setup: Pure data definitions and configuration models.
//
// Beats:
//   1. Define Pedersen commitment, generator layouts, and IPP structures.
//   2. Define RangeProof structure and validation routines.
//   3. Implement constructor and helper utilities.

pub type PedersenCommitment = struct {
    commitment: Int,
    generator_g: Int,
    generator_h: Int,
    blinding_factor: Int,
    value: Int,
    modulus: Int,
    is_valid: Bool
};

pub type BulletproofGenerators = struct {
    gens_capacity: Int,
    party_capacity: Int,
    g_base: Int,
    h_base: Int,
    g_vec: List[Int],
    h_vec: List[Int],
    modulus: Int,
    is_valid: Bool
};

pub type InnerProductProof = struct {
    l_vec: List[Int],
    r_vec: List[Int],
    a_final: Int,
    b_final: Int,
    is_valid: Bool
};

pub type RangeProof = struct {
    commitment: Int,
    a_commitment: Int,
    s_commitment: Int,
    t1_commitment: Int,
    t2_commitment: Int,
    tau_x: Int,
    mu: Int,
    t_hat: Int,
    ipp: InnerProductProof,
    bit_length: Int,
    min_value: Int,
    max_value: Int,
    is_valid: Bool
};

pub fn bp_range_new(bit_width: Int, min_value: Int) -> RangeProof {
    let empty_l: List[Int] = list_new();
    let empty_r: List[Int] = list_new();
    let empty_ipp: InnerProductProof = InnerProductProof {
        l_vec: empty_l,
        r_vec: empty_r,
        a_final: 0,
        b_final: 0,
        is_valid: false
    };
    return RangeProof {
        commitment: 0,
        a_commitment: 0,
        s_commitment: 0,
        t1_commitment: 0,
        t2_commitment: 0,
        tau_x: 0,
        mu: 0,
        t_hat: 0,
        ipp: empty_ipp,
        bit_length: bit_width,
        min_value: min_value,
        max_value: min_value + 100,
        is_valid: true
    };
}

pub fn bp_range_rounds(p: RangeProof) -> Int {
    return (p).bit_length;
}

pub fn bp_range_flags(p: RangeProof) -> Int {
    if (p).is_valid { return 1; }
    return 0;
}
