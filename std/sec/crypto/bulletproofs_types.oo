// # Bulletproofs types
//
// Logline: RangeProof destubbed off pub type nested InnerProductProof.
// residual: List[struct] destubbed to Int floor.

type RangeProof = struct {
    bit_width: Int,
    ipp_rounds: Int,
    flag_bits: Int
};

pub fn bp_range_new(bit_width: Int, min_value: Int) -> RangeProof {
    let mut rounds: Int = 0;
    let mut w: Int = bit_width;
    while w > 1 {
        let rem: Int = w % 2;
        w = w / 2;
        if rem == 0 {
            rounds = rounds + 1;
        }
    }
    let mut valid: Int = 0;
    if bit_width >= 8 {
        if min_value >= 0 {
            valid = 1;
        }
    }
    return RangeProof {
        bit_width: bit_width,
        ipp_rounds: rounds,
        flag_bits: valid
    };
}

pub fn bp_range_rounds(p: RangeProof) -> Int {
    return p.ipp_rounds;
}

pub fn bp_range_flags(p: RangeProof) -> Int {
    return p.flag_bits;
}
