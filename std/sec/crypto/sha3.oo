// # SHA-3 Cryptography Facade
//
// Logline: Re-exports SHA-3 data types, state constructors, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import SHA-3 companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream crypto consumers.

import "./sha3_types.oo";
import "./sha3_ops.oo";
import "./sha3_engine.oo";
import "./sha3_stubs.oo";

pub fn shim_marker_sha3_checksum() -> Int {
    return sha3_checksum("abc");
}

pub fn shim_marker_sha3_256_init() -> Result[Sha3State, String] {
    return sha3_256_init("st_256");
}

pub fn shim_marker_shake_init() -> Result[ShakeXof, String] {
    return shake_xof_init("xof_1", "SHAKE128");
}

pub fn shim_marker_digest_create() -> Result[KeccakDigest, String] {
    return keccak_digest_create("dig1", "SHA3-256", "0123456789abcdef");
}

pub fn shim_marker_engine_init() -> Result[Sha3Engine, Result[Sha3Engine, String]] {
    let p: Sha3SecurityPolicy = sha3_security_policy_default();
    return sha3_engine_init("eng_sha3", p);
}

verify sha3 {
    let st256_res: Result[Sha3State, String] = sha3_256_init("ST_SHA3_256");
    let st256: Sha3State = match st256_res {
        Ok(s) => s,
        Err(e) => Sha3State {
            state_id: "",
            rate: 0,
            capacity: 0,
            byte_index: 0,
            suffix_delim: 0,
            digest_len: 0,
            is_squeezing: false,
            checksum: 0,
            is_initialized: false,
        },
    };
    let st256_ok: Bool = sha3_state_validate(&st256);
    assert_eq!(st256_ok, true);

    let st512_res: Result[Sha3State, String] = sha3_512_init("ST_SHA3_512");
    let st512: Sha3State = match st512_res {
        Ok(s) => s,
        Err(e) => Sha3State {
            state_id: "",
            rate: 0,
            capacity: 0,
            byte_index: 0,
            suffix_delim: 0,
            digest_len: 0,
            is_squeezing: false,
            checksum: 0,
            is_initialized: false,
        },
    };
    let st512_ok: Bool = sha3_state_validate(&st512);
    assert_eq!(st512_ok, true);

    let xof_res: Result[ShakeXof, String] = shake_xof_init("XOF_SHAKE128", "SHAKE128");
    let xof: ShakeXof = match xof_res {
        Ok(x) => x,
        Err(e) => ShakeXof {
            xof_id: "",
            variant: "",
            rate: 0,
            capacity: 0,
            bytes_squeezed: 0,
            is_customized: false,
            custom_str: "",
            function_name: "",
            state: st256,
            is_active: false,
        },
    };
    let xof_ok: Bool = shake_xof_validate(&xof);
    assert_eq!(xof_ok, true);

    let raw_dig_bytes: String = "0123456789abcdef0123456789abcdef";
    let dig_res: Result[KeccakDigest, String] = keccak_digest_create("DIG_01", "SHA3-256", raw_dig_bytes);
    let dig: KeccakDigest = match dig_res {
        Ok(d) => d,
        Err(e) => KeccakDigest {
            digest_id: "",
            algorithm: "",
            raw_bytes: "",
            hex_str: "",
            bit_length: 0,
            byte_length: 0,
            checksum: 0,
            is_valid: false,
        },
    };
    let dig_ok: Bool = keccak_digest_validate(&dig);
    assert_eq!(dig_ok, true);

    let hex_encoded: String = sha3_hex_encode("abc");
    assert_eq!(hex_encoded, "616263");

    let hex_decoded_res: Result[String, String] = sha3_hex_decode("616263");
    let hex_decoded: String = match hex_decoded_res {
        Ok(s) => s,
        Err(e) => "",
    };
    assert_eq!(hex_decoded, "abc");

    let eq_test: Bool = sha3_constant_time_eq("keccak", "keccak");
    assert_eq!(eq_test, true);
    let ne_test: Bool = sha3_constant_time_eq("keccak", "sha3");
    assert_eq!(ne_test, false);

    let pol: Sha3SecurityPolicy = sha3_security_policy_default();
    let eng_res: Result[Sha3Engine, Result[Sha3Engine, String]] = sha3_engine_init("ENG_SHA3_01", pol);
    let eng: Sha3Engine = match eng_res {
        Ok(e) => e,
        Err(e) => Sha3Engine {
            engine_id: "",
            policy: pol,
            state: st256,
            hashes_computed: 0,
            bytes_processed: 0,
            strict_mode: false,
            system_halted: true,
        },
    };
    let work_val: Int = sha3_engine_do_work(&eng);
    assert_eq!(work_val > 0, true);
}
