import "./sha3_types.oo";
import "./sha3_ops.oo";

pub fn shim_marker_sha3_checksum() -> Int {
    return sha3_checksum("abc");
}

pub fn shim_marker_hex_encode() -> String {
    return sha3_hex_encode("abc");
}

pub fn shim_marker_hex_decode(s: String) -> Result[String, String] {
    return sha3_hex_decode(s);
}

pub fn shim_marker_constant_time_eq(a: String, b: String) -> Bool {
    return sha3_constant_time_eq(a, b);
}

pub fn shim_marker_state_new(rate: Int, capacity: Int, digest_len: Int) -> Sha3State {
    return sha3_state_new(rate, capacity, digest_len);
}

