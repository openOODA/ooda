// # HSM Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for HSM.
//
// Setup: Imports hsm_types.oo for data structure definitions.
//
// Beats:
//   1. Import HSM types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./hsm_types.oo";

pub fn hsm_key_handle_create(
    handle_id: Int,
    key_id: String,
    key_type: String,
    key_class: String,
    is_token: Bool,
    is_extractable: Bool,
    is_sensitive: Bool
) -> Result[KeyHandle, String] {
    if handle_id <= 0 {
        return Err("INVALID_HANDLE: Handle ID must be positive");
    }
    let id_len: Int = key_id.len();
    if id_len == 0 {
        return Err("INVALID_KEY_ID: Key identifier cannot be empty");
    }
    let raw_desc: String = key_id + ":" + key_type + ":" + key_class;
    let chk: Int = hsm_checksum(raw_desc);
    let kh = KeyHandle {
        handle_id: handle_id,
        key_id: key_id,
        key_type: key_type,
        key_class: key_class,
        is_token_object: is_token,
        is_extractable: is_extractable,
        is_sensitive: is_sensitive,
        checksum: chk,
        is_valid: true,
    };
    return Ok(kh);
}

pub fn hsm_key_handle_validate(kh: &KeyHandle) -> Bool {
    if (kh).is_valid == false {
        return false;
    }
    if (kh).handle_id <= 0 {
        return false;
    }
    let kid: String = (kh).key_id;
    let id_len: Int = kid.len();
    if id_len == 0 {
        return false;
    }
    let ktype: String = (kh).key_type;
    let kclass: String = (kh).key_class;
    let raw_desc: String = kid + ":" + ktype + ":" + kclass;
    let expected_chk: Int = hsm_checksum(raw_desc);
    return (kh).checksum == expected_chk;
}

pub fn hsm_mechanism_create(
    mech_type: Int,
    name: String,
    params: String
) -> Result[P11Mechanism, String] {
    let n_len: Int = name.len();
    if n_len == 0 {
        return Err("INVALID_MECHANISM_NAME: Mechanism name required");
    }
    let p_len: Int = params.len();
    let mech = P11Mechanism {
        mechanism_type: mech_type,
        mechanism_name: name,
        parameter_bytes: params,
        parameter_len: p_len,
        is_valid: true,
    };
    return Ok(mech);
}

pub fn hsm_mechanism_rsa_pss(salt_len: Int) -> P11Mechanism {
    let s_len_str: String = salt_len.to_string();
    return P11Mechanism {
        mechanism_type: 13,
        mechanism_name: "CKM_RSA_PKCS_PSS",
        parameter_bytes: "SALT_LEN=" + s_len_str,
        parameter_len: salt_len,
        is_valid: true,
    };
}

pub fn hsm_mechanism_ecdsa() -> P11Mechanism {
    return P11Mechanism {
        mechanism_type: 4161,
        mechanism_name: "CKM_ECDSA",
        parameter_bytes: "",
        parameter_len: 0,
        is_valid: true,
    };
}

pub fn hsm_mechanism_aes_gcm(iv: String) -> P11Mechanism {
    let iv_len: Int = iv.len();
    return P11Mechanism {
        mechanism_type: 4231,
        mechanism_name: "CKM_AES_GCM",
        parameter_bytes: iv,
        parameter_len: iv_len,
        is_valid: true,
    };
}

pub fn hsm_mechanism_validate(mech: &P11Mechanism) -> Bool {
    if (mech).is_valid == false {
        return false;
    }
    let name: String = (mech).mechanism_name;
    let n_len: Int = name.len();
    if n_len == 0 {
        return false;
    }
    return (mech).mechanism_type > 0;
}

pub fn hsm_slot_info_create(
    slot_id: Int,
    description: String,
    manufacturer: String,
    hw_ver: String,
    fw_ver: String,
    is_present: Bool,
    is_hw: Bool
) -> HsmSlotInfo {
    return HsmSlotInfo {
        slot_id: slot_id,
        slot_description: description,
        manufacturer_id: manufacturer,
        hardware_version: hw_ver,
        firmware_version: fw_ver,
        is_token_present: is_present,
        is_hardware_slot: is_hw,
    };
}

pub fn hsm_token_info_create(
    label: String,
    manufacturer: String,
    model: String,
    serial: String,
    flags: Int,
    max_sessions: Int,
    pin_protected: Bool
) -> HsmTokenInfo {
    return HsmTokenInfo {
        label: label,
        manufacturer_id: manufacturer,
        model: model,
        serial_number: serial,
        flags: flags,
        max_session_count: max_sessions,
        session_count: 0,
        is_initialized: true,
        is_pin_protected: pin_protected,
    };
}

pub fn hsm_session_create(
    session_handle: Int,
    slot_id: Int,
    is_rw: Bool,
    created_at: Int
) -> Result[HsmSession, String] {
    if session_handle <= 0 {
        return Err("INVALID_SESSION_HANDLE: Handle must be positive");
    }
    let mut initial_state: Int = 0;
    if is_rw {
        initial_state = 2;
    }
    let sess = HsmSession {
        session_handle: session_handle,
        slot_id: slot_id,
        state: initial_state,
        is_read_write: is_rw,
        is_logged_in: false,
        user_type: 0,
        created_at: created_at,
        is_active: true,
    };
    return Ok(sess);
}

pub fn hsm_session_validate(sess: &HsmSession) -> Bool {
    if (sess).is_active == false {
        return false;
    }
    if (sess).session_handle <= 0 {
        return false;
    }
    return (sess).slot_id >= 0;
}

pub fn hsm_session_is_logged_in(sess: &HsmSession) -> Bool {
    if (sess).is_active == false {
        return false;
    }
    return (sess).is_logged_in;
}

pub fn hsm_session_logout(sess: &mut HsmSession) {
    (sess).is_logged_in = false;
    (sess).user_type = 0;
    if (sess).is_read_write {
        (sess).state = 2;
    } else {
        (sess).state = 0;
    }
}

pub fn hsm_attribute_create(
    type_code: Int,
    type_name: String,
    value_str: String,
    value_int: Int,
    value_bool: Bool
) -> HsmAttribute {
    return HsmAttribute {
        type_code: type_code,
        type_name: type_name,
        value_str: value_str,
        value_int: value_int,
        value_bool: value_bool,
    };
}

