// # KMS Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for KMS.
//
// Setup: Imports kms_types.oo for data structure definitions.
//
// Beats:
//   1. Import KMS types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./kms_types.oo";

pub fn kms_key_policy_create(
    policy_id: String,
    allowed_operations: String,
    max_uses: Int,
    exportable: Bool,
    auto_rotate: Bool,
    rotation_interval_days: Int,
    fail_closed: Bool
) -> KmsKeyPolicy {
    return KmsKeyPolicy {
        policy_id: policy_id,
        allowed_operations: allowed_operations,
        max_uses: max_uses,
        exportable: exportable,
        auto_rotate: auto_rotate,
        rotation_interval_days: rotation_interval_days,
        fail_closed: fail_closed,
        is_active: true,
    };
}

pub fn kms_key_policy_validate(pol: &KmsKeyPolicy) -> Bool {
    let act: Bool = (pol).is_active;
    if !act {
        return false;
    }
    let pid: String = (pol).policy_id;
    let pid_len: Int = pid.len();
    if pid_len == 0 {
        return false;
    }
    let max_u: Int = (pol).max_uses;
    if max_u < 0 {
        return false;
    }
    let rot_int: Int = (pol).rotation_interval_days;
    if rot_int < 0 {
        return false;
    }
    return true;
}

pub fn kms_key_policy_allows_operation(pol: &KmsKeyPolicy, op: String) -> Bool {
    let act: Bool = (pol).is_active;
    if !act {
        return false;
    }
    let ops: String = (pol).allowed_operations;
    let ops_len: Int = ops.len();
    if ops_len == 0 {
        return false;
    }
    if ops == "*" {
        return true;
    }
    if ops == op {
        return true;
    }
    let op_len: Int = op.len();
    let mut i: Int = 0;
    let max_idx: Int = ops_len - op_len;
    while i <= max_idx {
        let mut match_found: Bool = true;
        let mut j: Int = 0;
        while j < op_len {
            let b1: Int = byte_at(ops, i + j);
            let b2: Int = byte_at(op, j);
            if b1 != b2 {
                match_found = false;
            }
            j = j + 1;
        }
        if match_found {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn key_envelope_create(
    envelope_id: String,
    kms_key_id: String,
    encrypted_dek: String,
    iv: String,
    tag: String,
    algorithm: String,
    key_version: Int,
    created_at: Int
) -> Result[KeyEnvelope, String] {
    let dek_len: Int = encrypted_dek.len();
    if dek_len == 0 {
        return Err("INVALID_ENVELOPE: Encrypted DEK cannot be empty");
    }
    let iv_len: Int = iv.len();
    if iv_len == 0 {
        return Err("INVALID_ENVELOPE: IV cannot be empty");
    }
    let tag_len: Int = tag.len();
    if tag_len == 0 {
        return Err("INVALID_ENVELOPE: Auth tag cannot be empty");
    }
    if key_version <= 0 {
        return Err("INVALID_ENVELOPE: Key version must be positive");
    }
    let env = KeyEnvelope {
        envelope_id: envelope_id,
        kms_key_id: kms_key_id,
        encrypted_dek: encrypted_dek,
        iv: iv,
        tag: tag,
        algorithm: algorithm,
        key_version: key_version,
        created_at: created_at,
        is_valid: true,
    };
    return Ok(env);
}

pub fn key_envelope_validate(env: &KeyEnvelope) -> Bool {
    let valid: Bool = (env).is_valid;
    if !valid {
        return false;
    }
    let dek: String = (env).encrypted_dek;
    let dek_len: Int = dek.len();
    if dek_len == 0 {
        return false;
    }
    let iv: String = (env).iv;
    let iv_len: Int = iv.len();
    if iv_len == 0 {
        return false;
    }
    let tag: String = (env).tag;
    let tag_len: Int = tag.len();
    if tag_len == 0 {
        return false;
    }
    let ver: Int = (env).key_version;
    if ver <= 0 {
        return false;
    }
    return true;
}

pub fn key_envelope_to_string(env: &KeyEnvelope) -> String {
    let eid: String = (env).envelope_id;
    let kid: String = (env).kms_key_id;
    let ver_num: Int = (env).key_version;
    let ver: String = ver_num.to_string();
    let alg: String = (env).algorithm;
    return "Envelope[" + eid + "] Key:" + kid + " v" + ver + " Alg:" + alg;
}

pub fn kms_key_rotation_create(
    rotation_id: String,
    key_id: String,
    previous_version: Int,
    new_version: Int,
    rotated_at: Int,
    reason: String
) -> Result[KmsKeyRotation, String] {
    if new_version <= previous_version {
        return Err("INVALID_ROTATION: New version must be greater than previous version");
    }
    let rot = KmsKeyRotation {
        rotation_id: rotation_id,
        key_id: key_id,
        previous_version: previous_version,
        new_version: new_version,
        rotated_at: rotated_at,
        reason: reason,
        is_successful: true,
    };
    return Ok(rot);
}

pub fn kms_key_rotation_validate(rot: &KmsKeyRotation) -> Bool {
    let succ: Bool = (rot).is_successful;
    if !succ {
        return false;
    }
    let prev: Int = (rot).previous_version;
    let next: Int = (rot).new_version;
    if next <= prev {
        return false;
    }
    return true;
}

