// # KMS Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for KMS.
//
// Setup: Imports kms_types.oo for data structure definitions.
//
// Beats:
//   1. Import KMS types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./kms_types.oo";

pub fn kms_key_policy_create(
    policy_id: String,
    allowed_operations: String,
    max_uses: Int,
    exportable: Bool,
    auto_rotate: Bool,
    rotation_interval_days: Int,
    fail_closed: Bool
) -> KmsKeyPolicy {
    return KmsKeyPolicy {
        policy_id: policy_id,
        allowed_operations: allowed_operations,
        max_uses: max_uses,
        exportable: exportable,
        auto_rotate: auto_rotate,
        rotation_interval_days: rotation_interval_days,
        fail_closed: fail_closed,
        is_active: true
    };
}

pub fn kms_key_policy_validate(pol: &KmsKeyPolicy) -> Bool {
    let act: Bool = (pol).is_active;
    if !act { return false; }
    let pid: String = (pol).policy_id;
    if pid.len() == 0 { return false; }
    let max_u: Int = (pol).max_uses;
    if max_u < 0 { return false; }
    let rot_int: Int = (pol).rotation_interval_days;
    if rot_int < 0 { return false; }
    return true;
}

pub fn kms_key_policy_allows_operation(pol: &KmsKeyPolicy, op: String) -> Bool {
    let act: Bool = (pol).is_active;
    if !act { return false; }
    let ops: String = (pol).allowed_operations;
    let ops_len: Int = ops.len();
    if ops_len == 0 { return false; }
    if ops == "*" { return true; }
    if ops == op { return true; }
    let op_len: Int = op.len();
    let mut i: Int = 0;
    let max_idx: Int = ops_len - op_len;
    while i <= max_idx {
        let mut match_found: Bool = true;
        let mut j: Int = 0;
        while j < op_len {
            let b1: Int = byte_at(ops, i + j);
            let b2: Int = byte_at(op, j);
            if b1 != b2 { match_found = false; }
            j = j + 1;
        }
        if match_found { return true; }
        i = i + 1;
    }
    return false;
}

pub fn key_envelope_create(
    envelope_id: String,
    kms_key_id: String,
    encrypted_dek: String,
    iv: String,
    tag: String,
    algorithm: String,
    key_version: Int,
    created_at: Int
) -> Result[KeyEnvelope, String] {
    if encrypted_dek.len() == 0 { return Err("INVALID_ENVELOPE: Encrypted DEK cannot be empty"); }
    if iv.len() == 0 { return Err("INVALID_ENVELOPE: IV cannot be empty"); }
    if tag.len() == 0 { return Err("INVALID_ENVELOPE: Auth tag cannot be empty"); }
    if key_version <= 0 { return Err("INVALID_ENVELOPE: Key version must be positive"); }
    return Ok(KeyEnvelope {
        envelope_id: envelope_id,
        kms_key_id: kms_key_id,
        encrypted_dek: encrypted_dek,
        iv: iv,
        tag: tag,
        algorithm: algorithm,
        key_version: key_version,
        created_at: created_at,
        is_valid: true
    });
}

pub fn key_envelope_validate(env: &KeyEnvelope) -> Bool {
    let valid: Bool = (env).is_valid;
    if !valid { return false; }
    let dek: String = (env).encrypted_dek;
    if dek.len() == 0 { return false; }
    let iv: String = (env).iv;
    if iv.len() == 0 { return false; }
    let tag: String = (env).tag;
    if tag.len() == 0 { return false; }
    let ver: Int = (env).key_version;
    if ver <= 0 { return false; }
    return true;
}

pub fn key_envelope_to_string(env: &KeyEnvelope) -> String {
    let eid: String = (env).envelope_id;
    let kid: String = (env).kms_key_id;
    let ver_num: Int = (env).key_version;
    let ver: String = ver_num.to_string();
    let alg: String = (env).algorithm;
    return "Envelope[" + eid + "] Key:" + kid + " v" + ver + " Alg:" + alg;
}

pub fn kms_key_rotation_create(
    rotation_id: String,
    key_id: String,
    previous_version: Int,
    new_version: Int,
    rotated_at: Int,
    reason: String
) -> Result[KmsKeyRotation, String] {
    if new_version <= previous_version {
        return Err("INVALID_ROTATION: New version must be greater than previous version");
    }
    return Ok(KmsKeyRotation {
        rotation_id: rotation_id,
        key_id: key_id,
        previous_version: previous_version,
        new_version: new_version,
        rotated_at: rotated_at,
        reason: reason,
        is_successful: true
    });
}

pub fn kms_key_rotation_validate(rot: &KmsKeyRotation) -> Bool {
    let succ: Bool = (rot).is_successful;
    if !succ { return false; }
    let prev: Int = (rot).previous_version;
    let next: Int = (rot).new_version;
    if next <= prev { return false; }
    return true;
}

pub fn kms_checksum(data: String) -> Int {
    let len: Int = data.len();
    let mut sum: Int = 0;
    let mut i: Int = 0;
    while i < len {
        sum = (sum * 31 + byte_at(data, i)) & 2147483647;
        i = i + 1;
    }
    return sum;
}

pub fn kms_hex_encode(input_str: String) -> String {
    let len: Int = input_str.len();
    let hex_chars: String = "0123456789abcdef";
    let mut result: String = "";
    let mut i: Int = 0;
    while i < len {
        let b: Int = byte_at(input_str, i);
        let hi: Int = (b >> 4) & 15;
        let lo: Int = b & 15;
        let c1: String = char_at(hex_chars, hi);
        let c2: String = char_at(hex_chars, lo);
        result = result + c1 + c2;
        i = i + 1;
    }
    return result;
}

pub fn kms_hex_decode(hex_str: String) -> Result[String, String] {
    let len: Int = hex_str.len();
    if len % 2 != 0 {
        return Err("Hex string length must be even");
    }
    return Ok(hex_str);
}

pub fn kms_constant_time_eq(a: String, b: String) -> Bool {
    let a_len: Int = a.len();
    let b_len: Int = b.len();
    if a_len != b_len { return false; }
    let mut diff: Int = 0;
    let mut i: Int = 0;
    while i < a_len {
        let b1: Int = byte_at(a, i);
        let b2: Int = byte_at(b, i);
        diff = diff | (b1 ^ b2);
        i = i + 1;
    }
    return diff == 0;
}
