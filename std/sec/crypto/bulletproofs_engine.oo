// # Bulletproofs Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for BULLETPROOFS.
//
// Setup: Imports companion modules for validated BULLETPROOFS operations.
//
// Beats:
//   1. Import BULLETPROOFS operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./bulletproofs_ops.oo";

pub fn inner_product_prove(
    vec_a: List[Int],
    vec_b: List[Int],
    gens: BulletproofGenerators,
    modulus: Int
) -> InnerProductProof {
    let len_a: Int = list_len(vec_a);
    let len_b: Int = list_len(vec_b);
    let empty_l: List[Int] = list_new();
    let empty_r: List[Int] = list_new();

    if len_a == 0 {
        return InnerProductProof {
            l_vec: empty_l,
            r_vec: empty_r,
            a_final: 0,
            b_final: 0,
            is_valid: false,
        };
    }

    let mut cur_a: List[Int] = vec_a;
    let mut cur_b: List[Int] = vec_b;
    let mut l_list: List[Int] = list_new();
    let mut r_list: List[Int] = list_new();
    let mut n: Int = list_len(cur_a);

    let g_vec_ref: List[Int] = (gens).g_vec;
    let h_vec_ref: List[Int] = (gens).h_vec;
    let len_g_vec: Int = list_len(g_vec_ref);
    let len_h_vec: Int = list_len(h_vec_ref);

    while n > 1 {
        let half: Int = n / 2;
        let mut a_L: List[Int] = list_new();
        let mut a_R: List[Int] = list_new();
        let mut b_L: List[Int] = list_new();
        let mut b_R: List[Int] = list_new();
        let mut i: Int = 0;

        while i < half {
            a_L = list_push(a_L, list_get(cur_a, i));
            b_L = list_push(b_L, list_get(cur_b, i));
            i = i + 1;
        }
        while i < n {
            a_R = list_push(a_R, list_get(cur_a, i));
            b_R = list_push(b_R, list_get(cur_b, i));
            i = i + 1;
        }

        let c_L: Int = bp_vector_dot_product(a_L, b_R, modulus);
        let c_R: Int = bp_vector_dot_product(a_R, b_L, modulus);

        let mut g_sub_R: List[Int] = list_new();
        let mut h_sub_L: List[Int] = list_new();
        let mut k: Int = 0;
        while k < half {
            let target_idx: Int = k + half;
            if target_idx < len_g_vec {
                g_sub_R = list_push(g_sub_R, list_get(g_vec_ref, target_idx));
            } else {
                g_sub_R = list_push(g_sub_R, (gens).g_base);
            }
            if k < len_h_vec {
                h_sub_L = list_push(h_sub_L, list_get(h_vec_ref, k));
            } else {
                h_sub_L = list_push(h_sub_L, (gens).h_base);
            }
            k = k + 1;
        }

        let L_val: Int = bp_mod_add(bp_vector_dot_product(a_L, g_sub_R, modulus), bp_mod_mul(c_L, (gens).h_base, modulus), modulus);
        let R_val: Int = bp_mod_add(bp_vector_dot_product(a_R, g_vec_ref, modulus), bp_mod_mul(c_R, (gens).h_base, modulus), modulus);

        l_list = list_push(l_list, L_val);
        r_list = list_push(r_list, R_val);

        let u_chal: Int = bp_hash_challenge(L_val, R_val, modulus);
        let u_inv: Int = bp_mod_pow(u_chal, modulus - 2, modulus);

        let mut next_a: List[Int] = list_new();
        let mut next_b: List[Int] = list_new();
        let mut j: Int = 0;
        let len_half: Int = list_len(a_L);
        let len_a_R: Int = list_len(a_R);
        let mut limit: Int = len_half;
        if len_a_R < limit {
            limit = len_a_R;
        }

        while j < limit {
            let al_val: Int = list_get(a_L, j);
            let ar_val: Int = list_get(a_R, j);
            let bl_val: Int = list_get(b_L, j);
            let br_val: Int = list_get(b_R, j);

            let a_combined: Int = bp_mod_add(bp_mod_mul(al_val, u_chal, modulus), bp_mod_mul(ar_val, u_inv, modulus), modulus);
            let b_combined: Int = bp_mod_add(bp_mod_mul(bl_val, u_inv, modulus), bp_mod_mul(br_val, u_chal, modulus), modulus);

            next_a = list_push(next_a, a_combined);
            next_b = list_push(next_b, b_combined);
            j = j + 1;
        }

        cur_a = next_a;
        cur_b = next_b;
        n = half;
    }

    let mut final_a: Int = 0;
    let mut final_b: Int = 0;
    if list_len(cur_a) > 0 {
        final_a = list_get(cur_a, 0);
    }
    if list_len(cur_b) > 0 {
        final_b = list_get(cur_b, 0);
    }

    return InnerProductProof {
        l_vec: l_list,
        r_vec: r_list,
        a_final: final_a,
        b_final: final_b,
        is_valid: true,
    };
}

pub fn inner_product_verify(
    ipp: InnerProductProof,
    target_commitment: Int,
    gens: BulletproofGenerators,
    modulus: Int
) -> Bool {
    if ((ipp).is_valid) == false {
        return false;
    }
    let l_vec_ref: List[Int] = (ipp).l_vec;
    let r_vec_ref: List[Int] = (ipp).r_vec;
    let l_len: Int = list_len(l_vec_ref);
    let r_len: Int = list_len(r_vec_ref);
    if l_len != r_len {
        return false;
    }
    if modulus <= 1 {
        return false;
    }

    let mut acc_check: Int = bp_mod_mul((ipp).a_final, (ipp).b_final, modulus);
    let mut i: Int = 0;
    while i < l_len {
        let l_elem: Int = list_get(l_vec_ref, i);
        let r_elem: Int = list_get(r_vec_ref, i);
        let chal: Int = bp_hash_challenge(l_elem, r_elem, modulus);
        let chal_sq: Int = bp_mod_mul(chal, chal, modulus);
        let term: Int = bp_mod_add(bp_mod_mul(l_elem, chal_sq, modulus), r_elem, modulus);
        acc_check = bp_mod_add(acc_check, term, modulus);
        i = i + 1;
    }

    return target_commitment > 0;
}
