// # Bulletproofs Prover and Proof Generation
//
// Logline: Implements prover algorithms and proof generation steps for BULLETPROOFS.
//
// Setup: Imports companion modules for circuit and commitment representations.
//
// Beats:
//   1. Initialize prover state and witness assignments.
//   2. Compute polynomial commitments and evaluation proofs.
//   3. Assemble complete {prefix.upper()} zero-knowledge proof.

import "./bulletproofs_range.oo";

pub fn bulletproof_prover_init(
    prv_id: String,
    gens: BulletproofGenerators,
    modulus: Int
) -> BulletproofProver {
    return BulletproofProver {
        prover_id: prv_id,
        generators: gens,
        modulus: modulus,
        proofs_generated: 0,
        is_active: true,
    };
}

pub fn bulletproof_prover_set_active(prover: &mut BulletproofProver, active: Bool) {
    (prover).is_active = active;
}

pub fn bulletproof_prover_create_range_proof(
    prover: &mut BulletproofProver,
    val: Int,
    min_val: Int,
    max_val: Int,
    blinding: Int,
    bit_len: Int
) -> RangeProof {
    if ((prover).is_active) == false {
        let empty_l: List[Int] = [];
        let empty_r: List[Int] = [];
        let empty_ipp: InnerProductProof = InnerProductProof {
            l_vec: empty_l,
            r_vec: empty_r,
            a_final: 0,
            b_final: 0,
            is_valid: false,
        };
        return RangeProof {
            commitment: 0,
            a_commitment: 0,
            s_commitment: 0,
            t1_commitment: 0,
            t2_commitment: 0,
            tau_x: 0,
            mu: 0,
            t_hat: 0,
            ipp: empty_ipp,
            bit_length: bit_len,
            min_value: min_val,
            max_value: max_val,
            is_valid: false,
        };
    }

    let prv_gens: BulletproofGenerators = (prover).generators;
    let prv_mod: Int = (prover).modulus;
    let proof: RangeProof = bulletproof_range_prove(
        val,
        min_val,
        max_val,
        blinding,
        bit_len,
        prv_gens,
        prv_mod
    );

    if proof.is_valid {
        let cur_gen: Int = ((prover).proofs_generated) + 1;
        (prover).proofs_generated = cur_gen;
    }

    return proof;
}

// -------------------------------------------------------------------
// Bulletproof Verifier Lifecycle
// -------------------------------------------------------------------

pub fn bulletproof_verifier_init(
    vf_id: String,
    gens: BulletproofGenerators,
    modulus: Int
) -> BulletproofVerifier {
    return BulletproofVerifier {
        verifier_id: vf_id,
        generators: gens,
        modulus: modulus,
        proofs_verified: 0,
        proofs_rejected: 0,
        strict_mode: true,
        is_active: true,
    };
}

pub fn bulletproof_verifier_set_strict_mode(verifier: &mut BulletproofVerifier, strict: Bool) {
    (verifier).strict_mode = strict;
}

pub fn bulletproof_verifier_set_active(verifier: &mut BulletproofVerifier, active: Bool) {
    (verifier).is_active = active;
}

pub fn bulletproof_verifier_verify_range_proof(
    verifier: &mut BulletproofVerifier,
    proof: RangeProof,
    commitment_v: Int
) -> Bool {
    if ((verifier).is_active) == false {
        let rej_cnt: Int = ((verifier).proofs_rejected) + 1;
        (verifier).proofs_rejected = rej_cnt;
        return false;
    }

    let vf_gens: BulletproofGenerators = (verifier).generators;
    let vf_mod: Int = (verifier).modulus;
    let is_ok: Bool = bulletproof_range_verify(proof, commitment_v, vf_gens, vf_mod);

    if is_ok {
        let ver_cnt: Int = ((verifier).proofs_verified) + 1;
        (verifier).proofs_verified = ver_cnt;
        return true;
    } else {
        let rej_cnt2: Int = ((verifier).proofs_rejected) + 1;
        (verifier).proofs_rejected = rej_cnt2;
        return false;
    }
}

pub fn bulletproof_verifier_verify_with_capability(
    sys: &SysCap,
    verifier: &mut BulletproofVerifier,
    proof: RangeProof,
    commitment_v: Int
) -> Result[Bool, String] {
    let is_valid: Bool = bulletproof_verifier_verify_range_proof(verifier, proof, commitment_v);
    if is_valid {
        return Ok(true);
    } else {
        return Err("BULLETPROOF_VERIFICATION_FAILED: Range proof invalid or commitment mismatch");
    }
}

// -------------------------------------------------------------------
// Bulletproof Batch Verification Engine
// -------------------------------------------------------------------

pub fn bulletproof_batch_verifier_init(bv_id: String) -> BulletproofBatchVerifier {
    let empty_proofs: List[RangeProof] = [];
    let empty_comms: List[PedersenCommitment] = [];
    return BulletproofBatchVerifier {
        batch_id: bv_id,
        proofs: empty_proofs,
        commitments: empty_comms,
        verified_count: 0,
        failed_count: 0,
        is_completed: false,
    };
}

pub fn bulletproof_batch_verifier_add(
    batch: &mut BulletproofBatchVerifier,
    proof: RangeProof,
    comm: PedersenCommitment
) {
    if ((batch).is_completed) == true {
        return;
    }
    let cur_p: List[RangeProof] = (batch).proofs;
    let new_p: List[RangeProof] = list_push(cur_p, proof);
    (batch).proofs = new_p;

    let cur_c: List[PedersenCommitment] = (batch).commitments;
    let new_c: List[PedersenCommitment] = list_push(cur_c, comm);
    (batch).commitments = new_c;
}

pub fn bulletproof_batch_verifier_verify_all(
    verifier: &mut BulletproofVerifier,
    batch: &mut BulletproofBatchVerifier
) -> Bool {
    if ((batch).is_completed) == true {
        return ((batch).failed_count) == 0;
    }

    let b_proofs: List[RangeProof] = (batch).proofs;
    let b_comms: List[PedersenCommitment] = (batch).commitments;
    let count: Int = list_len(b_proofs);
    let mut i: Int = 0;
    let mut pass_cnt: Int = 0;
    let mut fail_cnt: Int = 0;

    while i < count {
        let p: RangeProof = list_get(b_proofs, i);
        let c: PedersenCommitment = list_get(b_comms, i);
        let c_comm: Int = c.commitment;

        let ok: Bool = bulletproof_verifier_verify_range_proof(verifier, p, c_comm);
        if ok {
            pass_cnt = pass_cnt + 1;
        } else {
            fail_cnt = fail_cnt + 1;
        }
        i = i + 1;
    }

    (batch).verified_count = pass_cnt;
    (batch).failed_count = fail_cnt;
    (batch).is_completed = true;

    return ((batch).failed_count) == 0;
}

pub fn bulletproof_do_work(prover: &BulletproofProver, verifier: &BulletproofVerifier) -> Int {
    let p_gen: Int = (prover).proofs_generated;
    let v_ver: Int = (verifier).proofs_verified;
    let v_rej: Int = (verifier).proofs_rejected;
    return p_gen + v_ver * 2 + v_rej * 3;
}
