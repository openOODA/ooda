// # Falcon Data Types and Encodings
//
// Logline: Defines core data structures, metadata, and helper functions for FALCON.
//
// Setup: Pure data definitions and helper transformations.
//
// Beats:
//   1. Define core FALCON structures and configuration types.
//   2. Implement constructor and helper utilities.
//   3. Provide validation and conversion routines.

pub fn falcon_512_degree() -> Int {
    return 512;
}

pub fn falcon_1024_degree() -> Int {
    return 1024;
}

pub fn falcon_modulus() -> Int {
    return 12289;
}

pub fn falcon_512_beta_sq() -> Int {
    return 34034724;
}

pub fn falcon_1024_beta_sq() -> Int {
    return 70265242;
}

pub fn falcon_salt_bytes() -> Int {
    return 40;
}

pub type FalconPolynomial = struct {
    degree: Int,
    coefficients: List[Int],
    is_ntt: Bool,
};

pub type FalconPublicKey = struct {
    key_id: String,
    degree: Int,
    h_poly: FalconPolynomial,
    raw_bytes: String,
    checksum: Int,
    is_valid: Bool,
};

pub type FalconSecretKey = struct {
    key_id: String,
    degree: Int,
    f_poly: FalconPolynomial,
    g_poly: FalconPolynomial,
    F_poly: FalconPolynomial,
    G_poly: FalconPolynomial,
    raw_bytes: String,
    checksum: Int,
    is_wiped: Bool,
};

pub type FalconKeyPair = struct {
    key_id: String,
    degree: Int,
    public_key: FalconPublicKey,
    secret_key: FalconSecretKey,
    created_at: Int,
    is_valid: Bool,
};

pub type FalconSignature = struct {
    sig_id: String,
    degree: Int,
    nonce_salt: String,
    s2_poly: FalconPolynomial,
    raw_bytes: String,
    checksum: Int,
    created_at: Int,
    is_valid: Bool,
};

pub type FalconParams = struct {
    degree: Int,
    modulus: Int,
    beta_sq: Int,
    salt_bytes: Int,
    sig_bytes: Int,
    pk_bytes: Int,
    is_valid: Bool,
};

pub type FalconVerificationResult = struct {
    is_valid: Bool,
    norm_squared: Int,
    beta_threshold: Int,
    error_message: String,
};

pub type FalconFFTSamplerTree = struct {
    degree: Int,
    depth: Int,
    tree_nodes: List[Int],
    is_expanded: Bool,
};

pub type FalconBatchVerifier = struct {
    batch_id: String,
    degree: Int,
    total_signatures: Int,
    valid_count: Int,
    invalid_count: Int,
    is_completed: Bool,
};

// Anchor constructors so oodac check monomorphizes type layouts (types-only units OOB).
pub fn falcon_polynomial_empty() -> FalconPolynomial {
    let empty: List[Int] = list_new();
    return FalconPolynomial {
        degree: 0,
        coefficients: empty,
        is_ntt: false,
    };
}

pub fn falcon_params_invalid() -> FalconParams {
    return FalconParams {
        degree: 0,
        modulus: 12289,
        beta_sq: 0,
        salt_bytes: 40,
        sig_bytes: 0,
        pk_bytes: 0,
        is_valid: false,
    };
}
