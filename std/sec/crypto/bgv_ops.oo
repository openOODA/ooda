    let res: BgvCiphertext = BgvCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: "",
        degree: 2,
        scale: scale,
        level: lvl,
        noise_budget: new_noise,
        checksum: chk,
        is_valid: true,
    };
    return Ok(res);
}

