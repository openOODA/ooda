// # Secp256K1 Data Types and Encodings
//
// Logline: Defines core data structures, metadata, and helper functions for SECP256K1.
//
// Setup: Pure data definitions and helper transformations.
//
// Beats:
//   1. Define core SECP256K1 structures and configuration types.
//   2. Implement constructor and helper utilities.
//   3. Provide validation and conversion routines.

// -------------------------------------------------------------------
// Core secp256k1 Types & Structures
// -------------------------------------------------------------------

pub type Secp256k1Params = struct {
    p_hex: String,
    a_int: Int,
    b_int: Int,
    gx_hex: String,
    gy_hex: String,
    n_hex: String,
    h_int: Int,
    field_bits: Int,
    is_valid: Bool,
};

pub type Secp256k1Point = struct {
    x: String,
    y: String,
    is_infinity: Bool,
    is_compressed: Bool,
    is_valid: Bool,
};

pub type Secp256k1PublicKey = struct {
    key_id: String,
    point: Secp256k1Point,
    raw_bytes: String,
    hex_str: String,
    is_compressed: Bool,
    checksum: Int,
    is_valid: Bool,
};

pub type Secp256k1SecretKey = struct {
    key_id: String,
    raw_bytes: String,
    hex_str: String,
    checksum: Int,
    is_wiped: Bool,
};

pub type Secp256k1KeyPair = struct {
    key_id: String,
    public_key: Secp256k1PublicKey,
    secret_key: Secp256k1SecretKey,
    created_at: Int,
    is_valid: Bool,
};

pub type EcdsaSignature = struct {
    sig_id: String,
    key_id: String,
    r_bytes: String,
    s_bytes: String,
    v_rec: Int,
    raw_bytes: String,
    der_hex: String,
    checksum: Int,
    created_at: Int,
    is_valid: Bool,
};

pub type SchnorrSignature = struct {
    sig_id: String,
    key_id: String,
    rx_bytes: String,
    s_bytes: String,
    raw_bytes: String,
    checksum: Int,
    is_valid: Bool,
};

pub type Secp256k1VerificationResult = struct {
    is_valid: Bool,
    key_id: String,
    message_digest: String,
    error_code: String,
    verification_time: Int,
};

pub type Secp256k1SecurityPolicy = struct {
    enforce_low_s: Bool,
    require_sys_cap: Bool,
    fail_closed: Bool,
    allow_uncompressed: Bool,
    is_active: Bool,
};

pub type Secp256k1Engine = struct {
    engine_id: String,
    policy: Secp256k1SecurityPolicy,
    key_pairs: List[Secp256k1KeyPair],
    signed_count: Int,
    verified_count: Int,
    rejected_count: Int,
    strict_mode: Bool,
    system_halted: Bool,
};

// -------------------------------------------------------------------
// Helper Functions & Field Calculations
// -------------------------------------------------------------------

pub fn secp256k1_params_init() -> Secp256k1Params {
    return Secp256k1Params {
        p_hex: "fffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2f",
        a_int: 0,
        b_int: 7,
        gx_hex: "79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798",
        gy_hex: "483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8",
        n_hex: "fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141",
        h_int: 1,
        field_bits: 256,
        is_valid: true,
    };
}

pub fn secp256k1_checksum(raw_bytes: String) -> Int {
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < raw_len {
        let ch: Int = byte_at(raw_bytes, i);
        let hash_x33: Int = hash * 33;
        hash = hash_x33 + ch;
        i = i + 1;
    }
    return hash;
}

pub fn byte_to_hex_pair(val_byte: Int) -> String {
    let hex_chars: String = "0123456789abcdef";
    let div16: Int = val_byte / 16;
    let hi: Int = div16 % 16;
    let lo: Int = val_byte % 16;
    let mut res: List[Int] = bytes_new();
    res = bytes_push(res, byte_at(hex_chars, hi));
    res = bytes_push(res, byte_at(hex_chars, lo));
    return bytes_to_str(res);
}

pub fn hex_char_to_val(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 {
            return ch - 48;
        }
    }
    if ch >= 97 {
        if ch <= 102 {
            return ch - 87;
        }
    }
    if ch >= 65 {
        if ch <= 70 {
            return ch - 55;
        }
    }
    return -1;
}

pub fn secp256k1_hex_encode(raw_bytes: String) -> String {
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut out: String = "";
    while i < raw_len {
        let val_byte: Int = byte_at(raw_bytes, i);
        out = out + byte_to_hex_pair(val_byte);
        i = i + 1;
    }
    return out;
}

pub fn secp256k1_hex_decode(hex_str: String) -> Result[String, String] {
    let hex_len: Int = hex_str.len();
    let rem: Int = hex_len % 2;
    if rem != 0 {
        return Err("INVALID_HEX: Length must be even");
    }
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < hex_len {
        let hi_ch: Int = byte_at(hex_str, i);
        let next_i: Int = i + 1;
        let lo_ch: Int = byte_at(hex_str, next_i);
        let hi_v: Int = hex_char_to_val(hi_ch);
        let lo_v: Int = hex_char_to_val(lo_ch);
        if hi_v < 0 {
            return Err("INVALID_HEX: Invalid character");
        }
        if lo_v < 0 {
            return Err("INVALID_HEX: Invalid character");
        }
        let hi_mult: Int = hi_v * 16;
        let byte_val: Int = hi_mult + lo_v;
        buf = bytes_push(buf, byte_val);
        i = i + 2;
    }
    return Ok(bytes_to_str(buf));
}

pub fn secp256k1_constant_time_eq(s1: String, s2: String) -> Bool {
    let s1_len: Int = s1.len();
    let s2_len: Int = s2.len();
    if s1_len != s2_len {
        return false;
    }
    let mut i: Int = 0;
    let mut diff: Int = 0;
    while i < s1_len {
        let b1: Int = byte_at(s1, i);
        let b2: Int = byte_at(s2, i);
        if b1 != b2 {
            diff = diff + 1;
        }
        i = i + 1;
    }
    return diff == 0;
}
