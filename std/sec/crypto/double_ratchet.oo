// # Double Ratchet Facade and Re-Export Shim
//
// Logline: Re-exports Signal Double Ratchet types, session lifecycle engines, key operations, and fail-closed stubs.
//
// Setup: Pure module shim importing types, operations, engine, and stubs companion submodules.
//
// Beats:
//   1. Import Double Ratchet types, operations, engine, and stubs companion modules.
//   2. Provide typed shim markers ensuring monomorphization coverage.
//   3. Execute self-verification suite to validate state initialization and key validations.

import "./double_ratchet_types.oo";
import "./double_ratchet_ops.oo";
import "./double_ratchet_engine.oo";
import "./double_ratchet_stubs.oo";

pub fn shim_marker_dh_keypair() -> Result[DHKeyPair, String] {
    let dummy_32: String = "01234567890123456789012345678901";
    return dh_keypair_create("dh_shim", dummy_32, dummy_32);
}

pub fn shim_marker_chain_key() -> Result[ChainKey, String] {
    let dummy_32: String = "01234567890123456789012345678901";
    return chain_key_create("ck_shim", dummy_32, 0, true);
}

pub fn shim_marker_message_header() -> Result[MessageHeader, String] {
    let dummy_32: String = "01234567890123456789012345678901";
    return message_header_create(dummy_32, 0, 0);
}

pub fn shim_marker_policy() -> RatchetSecurityPolicy {
    return ratchet_security_policy_default();
}

verify double_ratchet {
    let self_test_ok: Bool = double_ratchet_self_test();
    assert_eq!(self_test_ok, true);

    let dummy_32: String = "01234567890123456789012345678901";
    let kp_res: Result[DHKeyPair, String] = dh_keypair_create("DH_01", dummy_32, dummy_32);
    let kp: DHKeyPair = match kp_res {
        Ok(k) => k,
        Err(e) => DHKeyPair { key_id: "", public_key: "", private_key: "", created_at: 0, checksum: 0, is_valid: false },
    };
    assert_eq!(kp.is_valid, true);
    assert_eq!(dh_keypair_validate(&kp), true);

    let ck_res: Result[ChainKey, String] = chain_key_create("CK_01", dummy_32, 5, true);
    let ck: ChainKey = match ck_res {
        Ok(c) => c,
        Err(e) => ChainKey { chain_id: "", key_bytes: "", index: 0, is_send: false, checksum: 0, is_valid: false },
    };
    assert_eq!(ck.is_valid, true);
    assert_eq!(chain_key_validate(&ck), true);

    let mk_res: Result[MessageKey, String] = message_key_create("MK_01", dummy_32, 1);
    let mk: MessageKey = match mk_res {
        Ok(m) => m,
        Err(e) => MessageKey { key_id: "", key_bytes: "", message_num: 0, checksum: 0, is_used: false },
    };
    assert_eq!(message_key_validate(&mk), true);

    let hdr_res: Result[MessageHeader, String] = message_header_create(dummy_32, 0, 1);
    let hdr: MessageHeader = match hdr_res {
        Ok(h) => h,
        Err(e) => MessageHeader { header_id: "", dh_pub: "", pn: 0, n: 0, checksum: 0, is_valid: false },
    };
    assert_eq!(hdr.is_valid, true);
    assert_eq!(message_header_validate(&hdr), true);

    let hex_pub: String = message_header_serialize(&hdr);
    assert_eq!(hex_pub.len() > 0, true);

    let eq_check: Bool = double_ratchet_constant_time_eq("key_abc", "key_abc");
    assert_eq!(eq_check, true);
    let neq_check: Bool = double_ratchet_constant_time_eq("key_abc", "key_xyz");
    assert_eq!(neq_check, false);
}
