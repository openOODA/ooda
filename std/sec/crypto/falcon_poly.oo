// # Falcon Poly and Arithmetic
//
// Logline: Provides polynomial ring operations and coefficient manipulations for FALCON.
//
// Setup: Imports falcon_types.oo for polynomial definitions.
//
// Beats:
//   1. Define polynomial structures for FALCON.
//   2. Implement polynomial addition, multiplication, and NTT transforms.
//   3. Provide coefficient sampling and reduction routines.

import "./falcon_types.oo";

pub fn falcon_polynomial_create(degree: Int, coeffs: List[Int], is_ntt: Bool) -> FalconPolynomial {
    return FalconPolynomial {
        degree: degree,
        coefficients: coeffs,
        is_ntt: is_ntt
    };
}

pub fn falcon_polynomial_zero(degree: Int) -> FalconPolynomial {
    let mut empty_coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < degree {
        empty_coeffs = list_push(empty_coeffs, 0);
        i = i + 1;
    }
    return FalconPolynomial {
        degree: degree,
        coefficients: empty_coeffs,
        is_ntt: false
    };
}

pub fn falcon_polynomial_get(p: FalconPolynomial, idx: Int) -> Int {
    let len: Int = list_len((p).coefficients);
    if idx < 0 {
        return 0;
    }
    if idx >= len {
        return 0;
    }
    return list_get((p).coefficients, idx);
}

pub fn falcon_polynomial_set(p: FalconPolynomial, idx: Int, val: Int) -> FalconPolynomial {
    let old_coeffs: List[Int] = (p).coefficients;
    let len: Int = list_len(old_coeffs);
    let mut new_coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < len {
        if i == idx {
            new_coeffs = list_push(new_coeffs, val);
        } else {
            let item: Int = list_get(old_coeffs, i);
            new_coeffs = list_push(new_coeffs, item);
        }
        i = i + 1;
    }
    return FalconPolynomial {
        degree: (p).degree,
        coefficients: new_coeffs,
        is_ntt: (p).is_ntt
    };
}

pub fn falcon_polynomial_center_mod(val: Int, modulus: Int) -> Int {
    let mut m: Int = val % modulus;
    if m < 0 {
        m = m + modulus;
    }
    let half: Int = modulus / 2;
    if m > half {
        m = m - modulus;
    }
    return m;
}

pub fn falcon_polynomial_add(p1: FalconPolynomial, p2: FalconPolynomial, modulus: Int) -> FalconPolynomial {
    let deg: Int = (p1).degree;
    let c1: List[Int] = (p1).coefficients;
    let c2: List[Int] = (p2).coefficients;
    let len: Int = list_len(c1);
    let mut res_coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < len {
        let v1: Int = list_get(c1, i);
        let v2: Int = list_get(c2, i);
        let sum_val: Int = (v1 + v2) % modulus;
        res_coeffs = list_push(res_coeffs, sum_val);
        i = i + 1;
    }
    return FalconPolynomial {
        degree: deg,
        coefficients: res_coeffs,
        is_ntt: (p1).is_ntt
    };
}

pub fn falcon_polynomial_sub(p1: FalconPolynomial, p2: FalconPolynomial, modulus: Int) -> FalconPolynomial {
    let deg: Int = (p1).degree;
    let c1: List[Int] = (p1).coefficients;
    let c2: List[Int] = (p2).coefficients;
    let len: Int = list_len(c1);
    let mut res_coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < len {
        let v1: Int = list_get(c1, i);
        let v2: Int = list_get(c2, i);
        let mut diff: Int = (v1 - v2) % modulus;
        if diff < 0 {
            diff = diff + modulus;
        }
        res_coeffs = list_push(res_coeffs, diff);
        i = i + 1;
    }
    return FalconPolynomial {
        degree: deg,
        coefficients: res_coeffs,
        is_ntt: (p1).is_ntt
    };
}

pub fn falcon_polynomial_scalar_mul(p: FalconPolynomial, scalar: Int, modulus: Int) -> FalconPolynomial {
    let deg: Int = (p).degree;
    let coeffs: List[Int] = (p).coefficients;
    let len: Int = list_len(coeffs);
    let mut res_coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < len {
        let v: Int = list_get(coeffs, i);
        let prod: Int = (v * scalar) % modulus;
        res_coeffs = list_push(res_coeffs, prod);
        i = i + 1;
    }
    return FalconPolynomial {
        degree: deg,
        coefficients: res_coeffs,
        is_ntt: (p).is_ntt
    };
}
