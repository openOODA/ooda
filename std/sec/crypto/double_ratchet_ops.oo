// # Double Ratchet Operations and Encoding Utilities
//
// Logline: Checksums, hexadecimal encoding, constant-time comparisons, and message header operations for Double Ratchet.
//
// Setup: Pure helper operations for cryptographic key formatting, validation, and digest calculation.
//
// Beats:
//   1. Calculate DJB2 checksum hashes over binary strings.
//   2. Encode and decode hexadecimal strings with constant-time equality checks.
//   3. Implement constructors and structural validators for message headers.
//   4. Serialize and format message headers for wire transmission.

import "./double_ratchet_types.oo";

pub fn double_ratchet_checksum(raw_bytes: String) -> Int {
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < raw_len {
        let ch: Int = byte_at(raw_bytes, i);
        let hash_x33: Int = hash * 33;
        hash = hash_x33 + ch;
        i = i + 1;
    }
    return hash;
}

pub fn byte_to_hex_pair(val_byte: Int) -> String {
    let hex_chars: String = "0123456789abcdef";
    let div16: Int = val_byte / 16;
    let hi: Int = div16 % 16;
    let lo: Int = val_byte % 16;
    let mut res: List[Int] = bytes_new();
    res = bytes_push(res, byte_at(hex_chars, hi));
    res = bytes_push(res, byte_at(hex_chars, lo));
    return bytes_to_str(res);
}

pub fn hex_char_to_val(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 {
            return ch - 48;
        }
    }
    if ch >= 97 {
        if ch <= 102 {
            return ch - 87;
        }
    }
    if ch >= 65 {
        if ch <= 70 {
            return ch - 55;
        }
    }
    return -1;
}

pub fn double_ratchet_hex_encode(raw_bytes: String) -> String {
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut out: String = "";
    while i < raw_len {
        let val_byte: Int = byte_at(raw_bytes, i);
        out = out + byte_to_hex_pair(val_byte);
        i = i + 1;
    }
    return out;
}

pub fn double_ratchet_hex_decode(hex_str: String) -> Result[String, String] {
    let hex_len: Int = hex_str.len();
    let rem: Int = hex_len % 2;
    if rem != 0 {
        return Err("INVALID_HEX: Length must be even");
    }
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < hex_len {
        let hi_ch: Int = byte_at(hex_str, i);
        let next_i: Int = i + 1;
        let lo_ch: Int = byte_at(hex_str, next_i);
        let hi_v: Int = hex_char_to_val(hi_ch);
        let lo_v: Int = hex_char_to_val(lo_ch);
        if hi_v < 0 {
            return Err("INVALID_HEX: Invalid character");
        }
        if lo_v < 0 {
            return Err("INVALID_HEX: Invalid character");
        }
        let hi_mult: Int = hi_v * 16;
        let byte_val: Int = hi_mult + lo_v;
        buf = bytes_push(buf, byte_val);
        i = i + 2;
    }
    return Ok(bytes_to_str(buf));
}

pub fn double_ratchet_constant_time_eq(s1: String, s2: String) -> Bool {
    let s1_len: Int = s1.len();
    let s2_len: Int = s2.len();
    if s1_len != s2_len {
        return false;
    }
    let mut i: Int = 0;
    let mut diff: Int = 0;
    while i < s1_len {
        let b1: Int = byte_at(s1, i);
        let b2: Int = byte_at(s2, i);
        if b1 != b2 {
            diff = diff + 1;
        }
        i = i + 1;
    }
    return diff == 0;
}

pub fn message_header_create(dh_pub: String, pn: Int, n: Int) -> Result[MessageHeader, String] {
    let pub_len: Int = dh_pub.len();
    if pub_len != 32 {
        return Err("INVALID_HEADER: Public key must be 32 bytes");
    }
    if pn < 0 {
        return Err("INVALID_HEADER: Negative pn sequence number");
    }
    if n < 0 {
        return Err("INVALID_HEADER: Negative n sequence number");
    }
    let chk: Int = double_ratchet_checksum(dh_pub) + pn + n;
    let hdr = MessageHeader {
        header_id: "hdr_0",
        dh_pub: dh_pub,
        pn: pn,
        n: n,
        checksum: chk,
        is_valid: true
    };
    return Ok(hdr);
}

pub fn message_header_validate(hdr: &MessageHeader) -> Bool {
    let is_v: Bool = (hdr).is_valid;
    if !is_v {
        return false;
    }
    let dh_p: String = (hdr).dh_pub;
    let pub_len: Int = dh_p.len();
    if pub_len != 32 {
        return false;
    }
    let pn_val: Int = (hdr).pn;
    if pn_val < 0 {
        return false;
    }
    let n_val: Int = (hdr).n;
    if n_val < 0 {
        return false;
    }
    return true;
}

pub fn message_header_serialize(hdr: &MessageHeader) -> String {
    let dh_p: String = (hdr).dh_pub;
    let pub_hex: String = double_ratchet_hex_encode(dh_p);
    return pub_hex;
}

pub fn message_header_to_string(hdr: &MessageHeader) -> String {
    let hid: String = (hdr).header_id;
    let dh_p: String = (hdr).dh_pub;
    let hex_p: String = double_ratchet_hex_encode(dh_p);
    return "Header[" + hid + "] DH:" + hex_p;
}
