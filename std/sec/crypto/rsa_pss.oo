// # RSA-PSS
//
// Logline: Provides rsa-pss primitives and operations for openOODA standard library.
//
// Setup: Imports companion modules for RSA operations.
//
// Beats:
//   1. Import RSA types and dependencies.
//   2. Execute rsa-pss operations.
//   3. Provide validation and lifecycle routines.

// into 4 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids (e.g. RsaPssParams vs
// String) when the shim monomorphizes too many by-value calls.
// Real implementations remain in split modules (check green alone).

import "./rsa_pss_types.oo";
import "./rsa_pss_params.oo";
import "./rsa_pss_engine.oo";
import "./rsa_pss_stubs.oo";

pub fn shim_marker_params_2048() -> RsaPssParams {
    return rsa_pss_params_2048();
}

pub fn shim_marker_params_3072() -> RsaPssParams {
    return rsa_pss_params_3072();
}

pub fn shim_marker_params_4096() -> RsaPssParams {
    return rsa_pss_params_4096();
}

pub fn shim_marker_params_init() -> RsaPssParams {
    return rsa_pss_params_init(2048, "SHA-256", 32);
}

pub fn shim_marker_checksum() -> Int {
    return rsa_checksum("n-modulus");
}

pub fn shim_marker_hex() -> String {
    return byte_to_hex_pair(255);
}

pub fn shim_marker_policy_default() -> RsaPssSecurityPolicy {
    return rsa_pss_policy_default();
}

pub fn shim_marker_policy_strict() -> RsaPssSecurityPolicy {
    return rsa_pss_policy_strict();
}

pub fn shim_marker_engine_create() -> RsaPssEngine {
    let pol: RsaPssSecurityPolicy = rsa_pss_policy_default();
    return rsa_pss_engine_create("eng-1", pol);
}

pub fn shim_marker_legacy_pub() -> RSAPubKey {
    return rsa_legacy_pub("n", 65537);
}

pub fn shim_marker_legacy_priv() -> RSAPrivKey {
    return rsa_legacy_priv("n", "d", "p", "q");
}

pub fn shim_marker_legacy_sig() -> PSSSignature {
    return rsa_pss_sig_empty();
}
