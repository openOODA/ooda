// # Dilithium Facade and Re-Export Shim
//
// Logline: Re-exports CRYSTALS-Dilithium post-quantum signatures, parameters, keypairs, and fail-closed stubs.
//
// Setup: Pure module shim importing types, operations, engine, and stubs companion submodules.
//
// Beats:
//   1. Import Dilithium types, operations, engine, and stubs companion modules.
//   2. Provide typed shim markers ensuring monomorphization coverage.
//   3. Execute self-verification suite to validate parameter sets, signatures, and engine operations.

import "./dilithium_types.oo";
import "./dilithium_ops.oo";
import "./dilithium_engine.oo";
import "./dilithium_stubs.oo";

pub fn shim_marker_dilithium_params() -> DilithiumParams {
    return dilithium_params_init(2);
}

pub fn shim_marker_dilithium_keypair() -> DilithiumKeyPair {
    return dilithium_keypair_create("K0", "PUB", "SEC", 2, 0);
}

pub fn shim_marker_dilithium_policy() -> DilithiumSecurityPolicy {
    return dilithium_policy_init(2, false, true);
}

verify dilithium {
    let p2: DilithiumParams = dilithium_params_init(2);
    assert_eq!(p2.mode, 2);
    assert_eq!(p2.k, 4);
    assert_eq!(p2.l, 4);
    assert_eq!(p2.is_valid, true);

    let p3: DilithiumParams = dilithium_params_init(3);
    assert_eq!(p3.mode, 3);
    assert_eq!(p3.k, 6);
    assert_eq!(p3.is_valid, true);

    let p5: DilithiumParams = dilithium_params_init(5);
    assert_eq!(p5.mode, 5);
    assert_eq!(p5.k, 8);
    assert_eq!(p5.is_valid, true);

    let kp: DilithiumKeyPair = dilithium_keypair_create(
        "K001",
        "PUB_KEY_DILITHIUM2_DATA_0123456789",
        "SEC_KEY_DILITHIUM2_DATA_9876543210",
        2,
        1700000000
    );

    assert_eq!(dilithium_keypair_validate(&kp), true);

    let msg: String = "Confidential Quantum-Safe Payload";
    let sig_res: Result[DilithiumSignature, String] = dilithium_sign_message(&kp, msg, 1700000005);
    let sig_obj: DilithiumSignature = match sig_res {
        Ok(s) => s,
        Err(e) => dilithium_signature_create("", "", "", "", 0, 0)
    };

    assert_eq!(sig_obj.is_valid, true);
    assert_eq!(sig_obj.key_id, "K001");

    let ver_res: DilithiumVerificationResult = dilithium_verify_signature(kp.public_key, &sig_obj, msg);
    assert_eq!(ver_res.is_valid, true);

    let pol: DilithiumSecurityPolicy = dilithium_policy_init(2, false, true);
    let mut engine: DilithiumEngine = dilithium_engine_init("ENG_DILITHIUM_01", pol);

    let reg_res: Result[Bool, String] = dilithium_engine_register_keypair(&mut engine, kp);
    let reg_ok: Bool = match reg_res {
        Ok(b) => b,
        Err(e) => false
    };
    assert_eq!(reg_ok, true);

    let eng_sig_res: Result[DilithiumSignature, String] = dilithium_engine_sign(&mut engine, "K001", msg, 1700000010);
    let eng_sig: DilithiumSignature = match eng_sig_res {
        Ok(s) => s,
        Err(e) => dilithium_signature_create("", "", "", "", 0, 0)
    };
    assert_eq!(eng_sig.is_valid, true);

    let eng_ver_res: Result[Bool, String] = dilithium_engine_verify(&mut engine, &eng_sig, msg);
    let eng_ver_ok: Bool = match eng_ver_res {
        Ok(b) => b,
        Err(e) => false
    };
    assert_eq!(eng_ver_ok, true);

    let work_val: Int = dilithium_engine_do_work(&engine);
    assert_eq!(work_val > 0, true);
}
