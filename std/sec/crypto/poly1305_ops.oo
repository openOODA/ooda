// # Poly1305 Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for POLY1305.
//
// Setup: Imports poly1305_types.oo for data structure definitions.
//
// Beats:
//   1. Import POLY1305 types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./poly1305_types.oo";

// -------------------------------------------------------------------
// Helper Functions & Encoding Utilities
// -------------------------------------------------------------------

pub fn checksum_calculate(raw_bytes: String) -> Int {
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut hash: Int = 5381;
    while i < raw_len {
        let ch: Int = byte_at(raw_bytes, i);
        let hash_x33: Int = hash * 33;
        hash = hash_x33 + ch;
        i = i + 1;
    }
    return hash;
}

pub fn byte_to_hex_pair(val_byte: Int) -> String {
    let hex_chars: String = "0123456789abcdef";
    let div16: Int = val_byte / 16;
    let hi: Int = div16 % 16;
    let lo: Int = val_byte % 16;
    let mut res: List[Int] = bytes_new();
    res = bytes_push(res, byte_at(hex_chars, hi));
    res = bytes_push(res, byte_at(hex_chars, lo));
    return bytes_to_str(res);
}

pub fn hex_char_to_val(ch: Int) -> Int {
    if ch >= 48 {
        if ch <= 57 {
            return ch - 48;
        }
    }
    if ch >= 97 {
        if ch <= 102 {
            return ch - 87;
        }
    }
    if ch >= 65 {
        if ch <= 70 {
            return ch - 55;
        }
    }
    return -1;
}

pub fn hex_encode(raw_bytes: String) -> String {
    let raw_len: Int = raw_bytes.len();
    let mut i: Int = 0;
    let mut out: String = "";
    while i < raw_len {
        let val_byte: Int = byte_at(raw_bytes, i);
        out = out + byte_to_hex_pair(val_byte);
        i = i + 1;
    }
    return out;
}

pub fn hex_decode(hex_str: String) -> Result[String, String] {
    let hex_len: Int = hex_str.len();
    let rem: Int = hex_len % 2;
    if rem != 0 {
        return Err("INVALID_HEX: Length must be even");
    }
    let mut i: Int = 0;
    let mut buf: List[Int] = bytes_new();
    while i < hex_len {
        let hi_ch: Int = byte_at(hex_str, i);
        let next_i: Int = i + 1;
        let lo_ch: Int = byte_at(hex_str, next_i);
        let hi_v: Int = hex_char_to_val(hi_ch);
        let lo_v: Int = hex_char_to_val(lo_ch);
        if hi_v < 0 {
            return Err("INVALID_HEX: Invalid character");
        }
        if lo_v < 0 {
            return Err("INVALID_HEX: Invalid character");
        }
        let hi_mult: Int = hi_v * 16;
        let byte_val: Int = hi_mult + lo_v;
        buf = bytes_push(buf, byte_val);
        i = i + 2;
    }
    return Ok(bytes_to_str(buf));
}

pub fn bytes_constant_time_eq(s1: String, s2: String) -> Bool {
    let s1_len: Int = s1.len();
    let s2_len: Int = s2.len();
    if s1_len != s2_len {
        return false;
    }
    let mut i: Int = 0;
    let mut diff: Int = 0;
    while i < s1_len {
        let b1: Int = byte_at(s1, i);
        let b2: Int = byte_at(s2, i);
        if b1 != b2 {
            diff = diff + 1;
        }
        i = i + 1;
    }
    return diff == 0;
}

pub fn pad_to_16_bytes(data: String) -> String {
    let data_len: Int = data.len();
    let rem: Int = data_len % 16;
    if rem == 0 {
        return data;
    }
    let pad_len: Int = 16 - rem;
    let mut pad_buf: List[Int] = bytes_new();
    let mut i: Int = 0;
    while i < pad_len {
        pad_buf = bytes_push(pad_buf, 0);
        i = i + 1;
    }
    let pad_str: String = bytes_to_str(pad_buf);
    return data + pad_str;
}

pub fn str_slice(s: String, start: Int, end: Int) -> String {
    let s_len: Int = s.len();
    let mut real_start: Int = start;
    if real_start < 0 {
        real_start = 0;
    }
    let mut real_end: Int = end;
    if real_end > s_len {
        real_end = s_len;
    }
    if real_start >= real_end {
        return "";
    }
    let mut i: Int = real_start;
    let mut buf: List[Int] = bytes_new();
    while i < real_end {
        let b: Int = byte_at(s, i);
        buf = bytes_push(buf, b);
        i = i + 1;
    }
    return bytes_to_str(buf);
}

// -------------------------------------------------------------------
// Key / Tag Constructors & Validation Helpers
// -------------------------------------------------------------------

pub fn poly1305_key_create(key_id: String, raw_bytes: String) -> Result[Poly1305Key, String] {
    let raw_len: Int = raw_bytes.len();
    if raw_len != 32 {
        return Err("INVALID_KEY_SIZE: Poly1305 key must be exactly 32 bytes (256 bits)");
    }
    let r: String = str_slice(raw_bytes, 0, 16);
    let s: String = str_slice(raw_bytes, 16, 32);
    let chk: Int = checksum_calculate(raw_bytes);
    let key: Poly1305Key = Poly1305Key {
        key_id: key_id,
        raw_bytes: raw_bytes,
        r_bytes: r,
        s_bytes: s,
        bit_length: 256,
        checksum: chk,
        is_valid: true
    };
    return Ok(key);
}

pub fn poly1305_key_validate(key: &Poly1305Key) -> Bool {
    let k_valid: Bool = (key).is_valid;
    if k_valid == false {
        return false;
    }
    let raw: String = (key).raw_bytes;
    let raw_len: Int = raw.len();
    if raw_len != 32 {
        return false;
    }
    let r_str: String = (key).r_bytes;
    let r_len: Int = r_str.len();
    if r_len != 16 {
        return false;
    }
    let s_str: String = (key).s_bytes;
    let s_len: Int = s_str.len();
    if s_len != 16 {
        return false;
    }
    let bits: Int = (key).bit_length;
    if bits != 256 {
        return false;
    }
    let expected_chk: Int = checksum_calculate(raw);
    let k_chk: Int = (key).checksum;
    return k_chk == expected_chk;
}

pub fn poly1305_tag_create(tag_bytes: String) -> Result[Poly1305Tag, String] {
    let tag_len: Int = tag_bytes.len();
    if tag_len != 16 {
        return Err("INVALID_TAG_SIZE: Poly1305 authentication tag must be 16 bytes (128 bits)");
    }
    let chk: Int = checksum_calculate(tag_bytes);
    let hex_s: String = hex_encode(tag_bytes);
    let tag: Poly1305Tag = Poly1305Tag {
        tag_bytes: tag_bytes,
        hex_str: hex_s,
        len: tag_len,
        checksum: chk,
        is_valid: true
    };
    return Ok(tag);
}

pub fn poly1305_tag_validate(tag: &Poly1305Tag) -> Bool {
    let t_valid: Bool = (tag).is_valid;
    if t_valid == false {
        return false;
    }
    let raw: String = (tag).tag_bytes;
    let tag_len: Int = raw.len();
    if tag_len != 16 {
        return false;
    }
    let expected_chk: Int = checksum_calculate(raw);
    let t_chk: Int = (tag).checksum;
    return t_chk == expected_chk;
}


