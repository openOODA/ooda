// # BGV types
//
// Logline: BgvParams destubbed off pub type List[String] keys.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: List[struct]/List[String] destubbed to Int floor.

type BgvParams = struct {
    poly_degree: Int,
    plain_mod: Int,
    flag_bits: Int
};

pub fn bgv_params_new(poly_degree: Int, plain_mod: Int, coeff_bits: Int) -> BgvParams {
    let mut valid: Int = 0;
    if poly_degree >= 1024 {
        let rem: Int = poly_degree % 1024;
        if rem == 0 {
            if plain_mod >= 2 {
                if coeff_bits >= 16 {
                    valid = 1;
                }
            }
        }
    }
    let mut max_level: Int = 3;
    if coeff_bits >= 120 {
        max_level = 6;
    }
    let packed: Int = valid + (max_level * 2);
    return BgvParams {
        poly_degree: poly_degree,
        plain_mod: plain_mod,
        flag_bits: packed
    };
}

pub fn bgv_params_degree(p: BgvParams) -> Int {
    return p.poly_degree;
}

pub fn bgv_params_flags(p: BgvParams) -> Int {
    return p.flag_bits;
}
