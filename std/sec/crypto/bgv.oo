// # BGV Facade
//
// Logline: Re-exports BGV data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import BGV companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 7 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./bgv_keys.oo";
import "./bgv_codec.oo";
import "./bgv_crypt.oo";
import "./bgv_ops.oo";
import "./bgv_engine.oo";
import "./bgv_stubs.oo";

pub fn shim_marker_checksum() -> Int {
    return bgv_calculate_checksum("abc");
}

pub fn shim_marker_params_create() -> BgvParams {
    return bgv_params_create(4096, 65537, 40, 128);
}

pub fn shim_marker_params_validate(p: &BgvParams) -> Result[Bool, String] {
    return bgv_params_validate(p);
}

pub fn shim_marker_public_key_create() -> BgvPublicKey {
    return bgv_public_key_create("pk1", "pk0_poly", "pk1_poly");
}

pub fn shim_marker_secret_key_create() -> BgvSecretKey {
    return bgv_secret_key_create("sk1", "sk_poly");
}

pub fn shim_marker_keypair_generate() -> BgvKeyPair {
    let p: BgvParams = bgv_params_create(4096, 65537, 40, 128);
    return bgv_keypair_generate("pair1", p);
}

pub fn shim_marker_encoder_init() -> BgvEncoder {
    let p: BgvParams = bgv_params_create(4096, 65537, 40, 128);
    return bgv_encoder_init("enc1", p);
}

pub fn shim_marker_evaluator_do_work(ev: &BgvEvaluator) -> Int {
    return bgv_evaluator_do_work(ev);
}
