// # CKKS Engine and Policy Management
//
// Logline: Manages execution engine lifecycle, security policies, and performance accounting for CKKS.
//
// Setup: Imports companion modules for validated CKKS operations.
//
// Beats:
//   1. Import CKKS operations and types.
//   2. Initialize security policies and execution engine contexts.
//   3. Compute engine workload telemetry and operation metrics.

import "./ckks_types.oo";

pub fn ckks_negate(
    eval_ref: &mut CkksEvaluator,
    c_ref: &CkksCiphertext
) -> Result[CkksCiphertext, String] {
    let c_v: Bool = (c_ref).is_valid;
    if c_v == false {
        return Err("INVALID_CIPHERTEXT: Ciphertext operand is invalid");
    }

    (eval_ref).ops_count = (eval_ref).ops_count + 1;

    let c_c0: String = (c_ref).c0_poly;
    let c_c1: String = (c_ref).c1_poly;
    let c_id: String = (c_ref).cipher_id;
    let c_deg: Int = (c_ref).degree;
    let c_scale: Float = (c_ref).scale;
    let c_level: Int = (c_ref).level;
    let c_slots: Int = (c_ref).slots_count;
    let c_noise: Int = (c_ref).noise_budget;

    let c0: String = "-(" + c_c0 + ")";
    let c1: String = "-(" + c_c1 + ")";
    let cid: String = "ckks_neg_" + c_id;
    let chk_src: String = c0 + c1;
    let chk: Int = ckks_calculate_checksum(chk_src);

    let res: CkksCiphertext = CkksCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: "",
        degree: c_deg,
        scale: c_scale,
        level: c_level,
        slots_count: c_slots,
        noise_budget: c_noise,
        checksum: chk,
        is_valid: true,
    };
    return Ok(res);
}

pub fn ckks_multiply(
    eval_ref: &mut CkksEvaluator,
    c1_ref: &CkksCiphertext,
    c2_ref: &CkksCiphertext
) -> Result[CkksCiphertext, String] {
    let c1_v: Bool = (c1_ref).is_valid;
    if c1_v == false {
        return Err("INVALID_CIPHERTEXT: First operand is invalid");
    }
    let c2_v: Bool = (c2_ref).is_valid;
    if c2_v == false {
        return Err("INVALID_CIPHERTEXT: Second operand is invalid");
    }
    let c1_noise: Int = (c1_ref).noise_budget;
    let c2_noise: Int = (c2_ref).noise_budget;
    if c1_noise <= 15 || c2_noise <= 15 {
        return Err("NOISE_EXHAUSTED: Insufficient noise budget for CKKS homomorphic multiplication");
    }

    (eval_ref).ops_count = (eval_ref).ops_count + 1;

    let c1_c0: String = (c1_ref).c0_poly;
    let c2_c0: String = (c2_ref).c0_poly;
    let c1_c1: String = (c1_ref).c1_poly;
    let c2_c1: String = (c2_ref).c1_poly;
    let c1_id: String = (c1_ref).cipher_id;
    let c2_id: String = (c2_ref).cipher_id;
    let c1_scale: Float = (c1_ref).scale;
    let c2_scale: Float = (c2_ref).scale;
    let c1_level: Int = (c1_ref).level;
    let c1_slots: Int = (c1_ref).slots_count;

    let c0: String = "(" + c1_c0 + " * " + c2_c0 + ")";
    let c1: String = "(" + c1_c0 + " * " + c2_c1 + " + " + c1_c1 + " * " + c2_c0 + ")";
    let c2: String = "(" + c1_c1 + " * " + c2_c1 + ")";
    let cid: String = "ckks_mul_" + c1_id + "_" + c2_id;
    let chk_src: String = c0 + c1 + c2;
    let chk: Int = ckks_calculate_checksum(chk_src);

    let mut min_noise: Int = c1_noise;
    if c2_noise < min_noise {
        min_noise = c2_noise;
    }
    let new_noise: Int = min_noise - 20;
    let new_scale: Float = c1_scale * c2_scale;

    let res: CkksCiphertext = CkksCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: c2,
        degree: 3,
        scale: new_scale,
        level: c1_level,
        slots_count: c1_slots,
        noise_budget: new_noise,
        checksum: chk,
        is_valid: true,
    };
    return Ok(res);
}

pub fn ckks_multiply_plain(
    eval_ref: &mut CkksEvaluator,
    c_ref: &CkksCiphertext,
    p_ref: &CkksPlaintext
) -> Result[CkksCiphertext, String] {
    let c_v: Bool = (c_ref).is_valid;
    if c_v == false {
        return Err("INVALID_CIPHERTEXT: Ciphertext operand is invalid");
    }
    let p_v: Bool = (p_ref).is_valid;
    if p_v == false {
        return Err("INVALID_PLAINTEXT: Plaintext operand is invalid");
    }

    (eval_ref).ops_count = (eval_ref).ops_count + 1;

    let c_c0: String = (c_ref).c0_poly;
    let c_c1: String = (c_ref).c1_poly;
    let c_c2: String = (c_ref).c2_poly;
    let p_poly: String = (p_ref).poly_repr;
    let c_id: String = (c_ref).cipher_id;
    let p_id: String = (p_ref).plain_id;
    let c_deg: Int = (c_ref).degree;
    let c_scale: Float = (c_ref).scale;
    let p_scale: Float = (p_ref).scale;
    let c_level: Int = (c_ref).level;
    let c_slots: Int = (c_ref).slots_count;
    let c_noise: Int = (c_ref).noise_budget;

    let c0: String = "(" + c_c0 + " * " + p_poly + ")";
    let c1: String = "(" + c_c1 + " * " + p_poly + ")";
    let cid: String = "ckks_mulp_" + c_id + "_" + p_id;
    let chk_src: String = c0 + c1;
    let chk: Int = ckks_calculate_checksum(chk_src);
    let new_scale: Float = c_scale * p_scale;

    let res: CkksCiphertext = CkksCiphertext {
        cipher_id: cid,
        c0_poly: c0,
        c1_poly: c1,
        c2_poly: c_c2,
        degree: c_deg,
        scale: new_scale,
        level: c_level,
        slots_count: c_slots,
        noise_budget: c_noise - 5,
        checksum: chk,
        is_valid: true,
    };
    return Ok(res);
}

pub fn ckks_relinearize(
    eval_ref: &mut CkksEvaluator,
    c_ref: &CkksCiphertext
) -> Result[CkksCiphertext, String] {
    let c_v: Bool = (c_ref).is_valid;
    if c_v == false {
        return Err("INVALID_CIPHERTEXT: Cannot relinearize invalid ciphertext");
    }
    let rk_v: Bool = (eval_ref).relin_key.is_valid;
    if rk_v == false {
        return Err("INVALID_KEY: Relinearization key is not available or invalid");
    }

    let deg: Int = (c_ref).degree;
    let c_id: String = (c_ref).cipher_id;
    let c_c0: String = (c_ref).c0_poly;
    let c_c1: String = (c_ref).c1_poly;
    let c_c2: String = (c_ref).c2_poly;
    let c_scale: Float = (c_ref).scale;
    let c_level: Int = (c_ref).level;
    let c_slots: Int = (c_ref).slots_count;
    let c_noise: Int = (c_ref).noise_budget;
    let c_chk: Int = (c_ref).checksum;

    if deg <= 2 {
        let passthrough: CkksCiphertext = CkksCiphertext {
            cipher_id: c_id,
            c0_poly: c_c0,
            c1_poly: c_c1,
            c2_poly: "",
            degree: 2,
            scale: c_scale,
            level: c_level,
            slots_count: c_slots,
            noise_budget: c_noise,
            checksum: c_chk,
            is_valid: true,
        };
        return Ok(passthrough);
    }

    (eval_ref).ops_count = (eval_ref).ops_count + 1;
    let new_c0: String = c_c0 + " + relin_ckks(" + c_c2 + ")";
    let new_c1: String = c_c1 + " + relin_prime_ckks(" + c_c2 + ")";
    let cid: String = "ckks_relin_" + c_id;
    let chk_src: String = new_c0 + new_c1;
    let chk: Int = ckks_calculate_checksum(chk_src);

    let res: CkksCiphertext = CkksCiphertext {
        cipher_id: cid,
        c0_poly: new_c0,
        c1_poly: new_c1,
        c2_poly: "",
        degree: 2,
        scale: c_scale,
        level: c_level,
        slots_count: c_slots,
        noise_budget: c_noise - 3,
        checksum: chk,
        is_valid: true,
    };
    return Ok(res);
}
