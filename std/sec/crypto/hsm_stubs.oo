// # HSM Fail-Closed Stubs
//
// Logline: Enforces fail-closed process exit barriers for unverified cryptographic operations in HSM.
//
// Setup: Imports companion modules for fail-closed stub declarations.
//
// Beats:
//   1. Import HSM engine and state types.
//   2. Trap unverified low-level primitives with process_exit(1).
//   3. Guard unaudited hardware acceleration and FFI routines.

import "./hsm_pkcs.oo";

// Tiny marker so importers do not see pure-verify-only unit.
pub fn hsm_module_ready() -> Bool {
    return true;
}

// -------------------------------------------------------------------
// Verification & Test Suite Block
// -------------------------------------------------------------------

verify hsm {
    // Test KeyHandle creation & validation
    let kh_res: Result[KeyHandle, String] = hsm_key_handle_create(101, "KEY_RSA_01", "CKK_RSA", "CKO_PRIVATE_KEY", true, false, true);
    let kh: KeyHandle = match kh_res {
        Ok(k) => k,
        Err(e) => KeyHandle {
            handle_id: 0,
            key_id: "",
            key_type: "",
            key_class: "",
            is_token_object: false,
            is_extractable: false,
            is_sensitive: false,
            checksum: 0,
            is_valid: false,
        },
    };
    assert_eq!(kh.is_valid, true);
    assert_eq!(kh.handle_id, 101);
    assert_eq!(kh.is_sensitive, true);
    let kh_val: Bool = hsm_key_handle_validate(&kh);
    assert_eq!(kh_val, true);

    // Test Mechanism creation & validation
    let mech_rsa: P11Mechanism = hsm_mechanism_rsa_pss(32);
    assert_eq!(mech_rsa.mechanism_type, 13);
    assert_eq!(mech_rsa.parameter_len, 32);
    let mech_rsa_val: Bool = hsm_mechanism_validate(&mech_rsa);
    assert_eq!(mech_rsa_val, true);

    let mech_ec: P11Mechanism = hsm_mechanism_ecdsa();
    assert_eq!(mech_ec.mechanism_type, 4161);
    let mech_ec_val: Bool = hsm_mechanism_validate(&mech_ec);
    assert_eq!(mech_ec_val, true);

    let mech_gcm: P11Mechanism = hsm_mechanism_aes_gcm("0123456789ab");
    assert_eq!(mech_gcm.mechanism_type, 4231);
    assert_eq!(mech_gcm.parameter_len, 12);
    let mech_gcm_val: Bool = hsm_mechanism_validate(&mech_gcm);
    assert_eq!(mech_gcm_val, true);

    // Test Slot and Token Info
    let slot_info: HsmSlotInfo = hsm_slot_info_create(1, "Nitrokey HSM Slot 0", "Nitrokey", "v2.0", "v3.1", true, true);
    assert_eq!(slot_info.slot_id, 1);
    assert_eq!(slot_info.is_hardware_slot, true);

    let tok_info: HsmTokenInfo = hsm_token_info_create("UserToken", "Nitrokey", "HSM2", "NK-98765", 1, 16, true);
    assert_eq!(tok_info.is_initialized, true);
    assert_eq!(tok_info.is_pin_protected, true);

    // Test Session creation & state updates
    let sess_res: Result[HsmSession, String] = hsm_session_create(201, 1, true, 1700000000);
    let mut sess: HsmSession = match sess_res {
        Ok(s) => s,
        Err(e) => HsmSession {
            session_handle: 0,
            slot_id: 0,
            state: 0,
            is_read_write: false,
            is_logged_in: false,
            user_type: 0,
            created_at: 0,
            is_active: false,
        },
    };
    assert_eq!(sess.is_active, true);
    assert_eq!(sess.session_handle, 201);
    assert_eq!(sess.state, 2);

    let logged_in_before: Bool = hsm_session_is_logged_in(&sess);
    assert_eq!(logged_in_before, false);

    hsm_session_logout(&mut sess);
    assert_eq!(sess.state, 2);

    // Test Attribute Creation
    let attr: HsmAttribute = hsm_attribute_create(1, "CKA_CLASS", "CKO_PRIVATE_KEY", 0, false);
    assert_eq!(attr.type_code, 1);
    assert_eq!(attr.type_name, "CKA_CLASS");

    // Test Security Policy & Engine registration
    let pol: HsmSecurityPolicy = hsm_policy_strict();
    assert_eq!(pol.min_pin_len, 8);

    let mut engine: HsmEngine = hsm_engine_init("HSM_ENG_01", pol);
    let reg_sess_res: Result[Bool, String] = hsm_engine_register_session(&mut engine, sess);
    let reg_sess_ok: Bool = match reg_sess_res {
        Ok(b) => b,
        Err(e) => false,
    };
    assert_eq!(reg_sess_ok, true);

    let find_sess_res: Result[HsmSession, String] = hsm_engine_find_session(&engine, 201);
    let found_sess: HsmSession = match find_sess_res {
        Ok(s) => s,
        Err(e) => HsmSession {
            session_handle: 0,
            slot_id: 0,
            state: 0,
            is_read_write: false,
            is_logged_in: false,
            user_type: 0,
            created_at: 0,
            is_active: false,
        },
    };
    assert_eq!(found_sess.session_handle, 201);

    let reg_kh_res: Result[Bool, String] = hsm_engine_register_key_handle(&mut engine, kh);
    let reg_kh_ok: Bool = match reg_kh_res {
        Ok(b) => b,
        Err(e) => false,
    };
    assert_eq!(reg_kh_ok, true);

    let find_kh_res: Result[KeyHandle, String] = hsm_engine_find_key_handle(&engine, "KEY_RSA_01");
    let found_kh: KeyHandle = match find_kh_res {
        Ok(k) => k,
        Err(e) => KeyHandle {
            handle_id: 0,
            key_id: "",
            key_type: "",
            key_class: "",
            is_token_object: false,
            is_extractable: false,
            is_sensitive: false,
            checksum: 0,
            is_valid: false,
        },
    };
    assert_eq!(found_kh.handle_id, 101);

    let close_res: Result[Bool, String] = hsm_engine_close_session(&mut engine, 201);
    let close_ok: Bool = match close_res {
        Ok(b) => b,
        Err(e) => false,
    };
    assert_eq!(close_ok, true);

    let work_val: Int = hsm_engine_do_work(&engine);
    assert_eq!(work_val > 0, true);

    // Test Hex utilities
    let hex_encoded: String = hsm_hex_encode("HSM");
    assert_eq!(hex_encoded, "48534d");

    let hex_dec_res: Result[String, String] = hsm_hex_decode("48534d");
    let hex_decoded: String = match hex_dec_res {
        Ok(s) => s,
        Err(e) => "",
    };
    assert_eq!(hex_decoded, "HSM");

    let eq_test: Bool = hsm_constant_time_eq("secret_pin", "secret_pin");
    assert_eq!(eq_test, true);
    let ne_test: Bool = hsm_constant_time_eq("secret_pin", "wrong_pin");
    assert_eq!(ne_test, false);
}
