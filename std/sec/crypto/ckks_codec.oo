// # CKKS Codec and Plaintext Encodings
//
// Logline: Encodes and decodes plaintexts and polynomial representations for CKKS.
//
// Setup: Imports ckks_types.oo for codec structures.
//
// Beats:
//   1. Encode scalar values and vectors into CKKS plaintexts.
//   2. Decode decrypted ciphertexts back to plain text representations.
//   3. Provide batch encoding and decoding utilities.

import "./ckks_types.oo";

// -------------------------------------------------------------------
// Encoder & Plaintext Pipeline
// -------------------------------------------------------------------

pub fn ckks_encoder_init(
    encoder_id: String,
    params: CkksParams,
    scale: Float
) -> CkksEncoder {
    let slots: Int = params.slots_count;
    let valid: Bool = params.is_valid;
    return CkksEncoder {
        encoder_id: encoder_id,
        slots: slots,
        default_scale: scale,
        params: params,
        is_initialized: valid,
    };
}

pub fn ckks_encode_vector(
    encoder_ref: &CkksEncoder,
    values: List[Float]
) -> Result[CkksPlaintext, String] {
    let is_init: Bool = (encoder_ref).is_initialized;
    if is_init == false {
        return Err("INVALID_ENCODER: CKKS encoder is not initialized");
    }
    let val_len: Int = list_len(values);
    let max_slots: Int = (encoder_ref).slots;
    if val_len > max_slots {
        return Err("SLOT_OVERFLOW: Input vector size exceeds slot capacity");
    }

    let mut complex_slots: List[CkksComplex] = [];
    let mut i: Int = 0;
    let mut poly_str: String = "poly_ckks[";
    while i < val_len {
        let v: Float = list_get(values, i);
        let c: CkksComplex = ckks_complex_create(v, 0.0);
        complex_slots = list_push(complex_slots, c);
        let idx_str: String = i.to_string();
        poly_str = poly_str + idx_str + ",";
        i = i + 1;
    }
    poly_str = poly_str + "]";

    let enc_id: String = (encoder_ref).encoder_id;
    let len_str: String = val_len.to_string();
    let pid: String = "plain_" + enc_id + "_" + len_str;
    let def_scale: Float = (encoder_ref).default_scale;

    let plain: CkksPlaintext = CkksPlaintext {
        plain_id: pid,
        slots: complex_slots,
        slots_count: val_len,
        scale: def_scale,
        level: 0,
        poly_repr: poly_str,
        is_valid: true,
    };
    return Ok(plain);
}

pub fn ckks_encode_complex_vector(
    encoder_ref: &CkksEncoder,
    values: List[CkksComplex]
) -> Result[CkksPlaintext, String] {
    let is_init: Bool = (encoder_ref).is_initialized;
    if is_init == false {
        return Err("INVALID_ENCODER: CKKS encoder is not initialized");
    }
    let val_len: Int = list_len(values);
    let max_slots: Int = (encoder_ref).slots;
    if val_len > max_slots {
        return Err("SLOT_OVERFLOW: Input complex vector size exceeds slot capacity");
    }

    let mut poly_str: String = "poly_ckks_cplx[";
    let mut i: Int = 0;
    while i < val_len {
        let idx_str: String = i.to_string();
        poly_str = poly_str + idx_str + ",";
        i = i + 1;
    }
    poly_str = poly_str + "]";

    let cplx_enc_id: String = (encoder_ref).encoder_id;
    let cplx_len_str: String = val_len.to_string();
    let pid_cplx: String = "plain_cplx_" + cplx_enc_id + "_" + cplx_len_str;
    let def_scale: Float = (encoder_ref).default_scale;

    let plain: CkksPlaintext = CkksPlaintext {
        plain_id: pid_cplx,
        slots: values,
        slots_count: val_len,
        scale: def_scale,
        level: 0,
        poly_repr: poly_str,
        is_valid: true,
    };
    return Ok(plain);
}

pub fn ckks_decode_vector(
    encoder_ref: &CkksEncoder,
    plain_ref: &CkksPlaintext
) -> Result[List[Float], String] {
    let is_init: Bool = (encoder_ref).is_initialized;
    if is_init == false {
        return Err("INVALID_ENCODER: Encoder is not initialized");
    }
    let is_v: Bool = (plain_ref).is_valid;
    if is_v == false {
        return Err("INVALID_PLAINTEXT: Cannot decode invalid plaintext");
    }

    let n: Int = (plain_ref).slots_count;
    let slots_list: List[CkksComplex] = (plain_ref).slots;
    let mut real_values: List[Float] = [];
    let mut i: Int = 0;
    while i < n {
        let c: CkksComplex = list_get(slots_list, i);
        let r_val: Float = c.real;
        real_values = list_push(real_values, r_val);
        i = i + 1;
    }
    return Ok(real_values);
}

pub fn ckks_decode_complex_vector(
    encoder_ref: &CkksEncoder,
    plain_ref: &CkksPlaintext
) -> Result[List[CkksComplex], String] {
    let is_init: Bool = (encoder_ref).is_initialized;
    if is_init == false {
        return Err("INVALID_ENCODER: Encoder is not initialized");
    }
    let is_v: Bool = (plain_ref).is_valid;
    if is_v == false {
        return Err("INVALID_PLAINTEXT: Cannot decode invalid plaintext");
    }
    let slots_list: List[CkksComplex] = (plain_ref).slots;
    return Ok(slots_list);
}
