// # KMS types
//
// Logline: KmsKeyPolicy destubbed off Result[struct].
// residual: destubbed to Int floor.

type KmsKeyPolicy = struct {
    max_uses: Int,
    rotation_days: Int,
    fail_closed: Int
};

pub fn kms_policy_new(max_uses: Int, rotation_days: Int, fail_closed: Int) -> KmsKeyPolicy {
    return KmsKeyPolicy {
        max_uses: max_uses,
        rotation_days: rotation_days,
        fail_closed: fail_closed
    };
}

pub fn kms_policy_uses(p: KmsKeyPolicy) -> Int {
    return p.max_uses;
}
