// # KMS types
//
// Logline: Data structures, key representations, envelopes, policies, and engine types for KMS.
//
// Setup: Pure data definitions and configuration types.
//
// Beats:
//   1. Define KMS key, policy, envelope, rotation, and grant structures.
//   2. Define KMS audit logging and engine context types.
//   3. Implement constructor and helper utilities.

type KmsKeyPolicy = struct {
    policy_id: String,
    allowed_operations: String,
    max_uses: Int,
    exportable: Bool,
    auto_rotate: Bool,
    rotation_interval_days: Int,
    fail_closed: Bool,
    is_active: Bool,
};

type KmsKey = struct {
    key_id: String,
    arn: String,
    algorithm: String,
    current_version: Int,
    policy: KmsKeyPolicy,
    raw_key_bytes: String,
    checksum: Int,
    created_at: Int,
    is_enabled: Bool,
    is_destroyed: Bool,
};

type KeyEnvelope = struct {
    envelope_id: String,
    kms_key_id: String,
    encrypted_dek: String,
    iv: String,
    tag: String,
    algorithm: String,
    key_version: Int,
    created_at: Int,
    is_valid: Bool,
};

type KmsKeyRotation = struct {
    rotation_id: String,
    key_id: String,
    previous_version: Int,
    new_version: Int,
    rotated_at: Int,
    reason: String,
    is_successful: Bool,
};

type KmsGrant = struct {
    grant_id: String,
    key_id: String,
    grantee_principal: String,
    operations: String,
    issued_at: Int,
    expires_at: Int,
    is_revoked: Bool,
};

type KmsAuditLog = struct {
    log_id: String,
    key_id: String,
    action: String,
    principal: String,
    timestamp: Int,
    status: String,
};

type KmsEngine = struct {
    engine_id: String,
    keys: List[KmsKey],
    grants: List[KmsGrant],
    rotations: List[KmsKeyRotation],
    audit_logs: List[KmsAuditLog],
    operations_count: Int,
    system_halted: Bool,
};

type KmsEncryptResult = struct {
    envelope: KeyEnvelope,
    status_code: Int,
    error_msg: String,
};

type KmsDecryptResult = struct {
    plaintext_dek: String,
    status_code: Int,
    error_msg: String,
    is_valid: Bool,
};

pub fn kms_policy_new(max_uses: Int, rotation_days: Int, fail_closed: Int) -> KmsKeyPolicy {
    let mut fc: Bool = false;
    if fail_closed != 0 {
        fc = true;
    }
    return KmsKeyPolicy {
        policy_id: "default",
        allowed_operations: "*",
        max_uses: max_uses,
        exportable: false,
        auto_rotate: true,
        rotation_interval_days: rotation_days,
        fail_closed: fc,
        is_active: true,
    };
}

pub fn kms_policy_uses(p: KmsKeyPolicy) -> Int {
    return p.max_uses;
}
