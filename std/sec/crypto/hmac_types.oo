// # HMAC types and definitions
//
// Logline: Data structures, keys, tags, contexts, and configuration models for HMAC.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//

import "./hmac_ops.oo";

type HmacKey = struct {
    key_id: String,
    raw_bytes: String,
    bit_length: Int,
    checksum: Int,
    is_valid: Bool
};

type MacTag = struct {
    tag_id: String,
    tag_bytes: String,
    hex_str: String,
    len: Int,
    checksum: Int,
    algorithm: String,
    is_valid: Bool
};

type HmacVerificationResult = struct {
    is_valid: Bool,
    key_id: String,
    tag_id: String,
    algorithm: String,
    error_code: String,
    verification_time: Int
};

type HmacConfig = struct {
    algorithm: String,
    block_size: Int,
    output_size: Int,
    is_valid: Bool
};

type HmacCtx = struct {
    ctx_id: String,
    key: HmacKey,
    config: HmacConfig,
    buffer: String,
    bytes_processed: Int,
    is_initialized: Bool
};

pub fn hmac_key_new(key_id: Int, key_bytes: Int, block_size: Int, output_size: Int) -> HmacKey {
    let mut used: Int = key_bytes;
    if key_bytes > block_size {
        used = output_size;
    }
    let mut valid: Bool = false;
    if key_bytes > 0 {
        if block_size > 0 {
            if output_size > 0 {
                valid = true;
            }
        }
    }
    return HmacKey {
        key_id: key_id.to_string(),
        raw_bytes: "",
        bit_length: used * 8,
        checksum: 0,
        is_valid: valid
    };
}

pub fn hmac_key_used(k: HmacKey) -> Int {
    return (k).bit_length / 8;
}

pub fn hmac_key_flags(k: HmacKey) -> Int {
    if (k).is_valid {
        return 1;
    }
    return 0;
}

pub fn hmac_key_create(key_id: String, raw_bytes: String) -> Result[HmacKey, String] {
    let chk: Int = checksum_calculate(raw_bytes);
    let k: HmacKey = HmacKey {
        key_id: key_id,
        raw_bytes: raw_bytes,
        bit_length: raw_bytes.len() * 8,
        checksum: chk,
        is_valid: true
    };
    return Ok(k);
}

pub fn hmac_key_validate(key: &HmacKey) -> Bool {
    return (key).is_valid;
}

pub fn mac_tag_create(tag_id: String, raw_tag: String, alg: String) -> Result[MacTag, String] {
    let hex_val: String = hex_encode(raw_tag);
    let chk: Int = checksum_calculate(raw_tag);
    let tag: MacTag = MacTag {
        tag_id: tag_id,
        tag_bytes: raw_tag,
        hex_str: hex_val,
        len: raw_tag.len(),
        checksum: chk,
        algorithm: alg,
        is_valid: true
    };
    return Ok(tag);
}

pub fn mac_tag_validate(tag: &MacTag) -> Bool {
    return (tag).is_valid;
}

pub fn hmac_ctx_validate(ctx: &HmacCtx) -> Bool {
    return (ctx).is_initialized;
}
