// # HMAC types
//
// Logline: HmacKey destubbed off pub type nested HmacCtx.
// residual: String / field len destubbed to Int floor.

type HmacKey = struct {
    key_id: Int,
    key_used: Int,
    flag_bits: Int
};

pub fn hmac_key_new(key_id: Int, key_bytes: Int, block_size: Int, output_size: Int) -> HmacKey {
    let mut used: Int = key_bytes;
    if key_bytes > block_size {
        used = output_size;
    }
    let mut valid: Int = 0;
    if key_bytes > 0 {
        if block_size > 0 {
            if output_size > 0 {
                valid = 1;
            }
        }
    }
    return HmacKey {
        key_id: key_id,
        key_used: used,
        flag_bits: valid
    };
}

pub fn hmac_key_used(k: HmacKey) -> Int {
    return k.key_used;
}

pub fn hmac_key_flags(k: HmacKey) -> Int {
    return k.flag_bits;
}
