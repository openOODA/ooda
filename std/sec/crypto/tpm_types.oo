// residual: destubbed to Int floor.

type TpmNvIndex = struct {
    index_id: Int,
    data_size: Int,
    attr_flags: Int
};

pub fn tpm_nv_new(index_id: Int, data_size: Int, attr_flags: Int) -> TpmNvIndex {
    return TpmNvIndex {
        index_id: index_id,
        data_size: data_size,
        attr_flags: attr_flags
    };
}

pub fn tpm_nv_id(n: TpmNvIndex) -> Int {
    return n.index_id;
}
