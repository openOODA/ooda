// # KMS Facade
//
// Logline: Re-exports KMS data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import KMS companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 6 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./kms_ops.oo";
import "./kms_keys.oo";
import "./kms_engine.oo";
import "./kms_stubs.oo";

pub fn shim_marker_checksum() -> Int {
    return kms_checksum("abc");
}

pub fn shim_marker_hex() -> String {
    return kms_hex_encode("KMS");
}

pub fn shim_marker_policy_create() -> KmsKeyPolicy {
    return kms_key_policy_create("pol1", "encrypt,decrypt", 1000, false, true, 90, true);
}

pub fn shim_marker_engine_init() -> KmsEngine {
    return kms_engine_init("KMS_ENG_01");
}

pub fn shim_marker_engine_do_work(engine: &KmsEngine) -> Int {
    return kms_engine_do_work(engine);
}

pub fn shim_marker_module_ready() -> Bool {
    return kms_module_ready();
}
