// # Ed25519 Facade and Re-Export Shim
//
// Logline: Re-exports RFC 8032 Ed25519 public/secret keys, keypairs, signatures, and fail-closed stubs.
//
// Setup: Pure module shim importing types, operations, engine, and stubs companion submodules.
//
// Beats:
//   1. Import Ed25519 types, operations, engine, and stubs companion modules.
//   2. Provide typed shim markers ensuring monomorphization coverage.
//   3. Execute self-verification suite to validate keypair creation, signature serialization, and engine operations.

import "./ed25519_types.oo";
import "./ed25519_ops.oo";
import "./ed25519_engine.oo";
import "./ed25519_stubs.oo";

pub fn shim_marker_public_key() -> Result[Ed25519PublicKey, String] {
    let dummy_32: String = "01234567890123456789012345678901";
    return ed25519_public_key_create("pk_shim", dummy_32);
}

pub fn shim_marker_secret_key() -> Result[Ed25519SecretKey, String] {
    let dummy_32: String = "01234567890123456789012345678901";
    return ed25519_secret_key_create("sk_shim", dummy_32);
}

pub fn shim_marker_signature() -> Result[Ed25519Signature, String] {
    let dummy_32: String = "01234567890123456789012345678901";
    return ed25519_signature_create("sig_shim", "kp_shim", dummy_32, dummy_32, 0);
}

pub fn shim_marker_policy() -> Ed25519SecurityPolicy {
    return ed25519_policy_init(false, true);
}

verify ed25519 {
    let pk_raw: String = "01234567890123456789012345678901";
    let sk_raw: String = "98765432109876543210987654321098";
    let r_raw: String = "11111111111111111111111111111111";
    let s_raw: String = "22222222222222222222222222222222";

    let pk_res: Result[Ed25519PublicKey, String] = ed25519_public_key_create("PK001", pk_raw);
    let pk: Ed25519PublicKey = match pk_res {
        Ok(k) => k,
        Err(e) => Ed25519PublicKey { key_id: "", raw_bytes: "", hex_str: "", checksum: 0, is_valid: false }
    };
    let pk_val: Bool = pk.is_valid;
    assert_eq!(pk_val, true);
    let pk_val_check: Bool = ed25519_public_key_validate(&pk);
    assert_eq!(pk_val_check, true);

    let sk_res: Result[Ed25519SecretKey, String] = ed25519_secret_key_create("SK001", sk_raw);
    let sk: Ed25519SecretKey = match sk_res {
        Ok(k) => k,
        Err(e) => Ed25519SecretKey { key_id: "", seed_bytes: "", expanded_bytes: "", checksum: 0, is_wiped: true }
    };
    let sk_wiped: Bool = sk.is_wiped;
    assert_eq!(sk_wiped, false);
    let sk_val_check: Bool = ed25519_secret_key_validate(&sk);
    assert_eq!(sk_val_check, true);

    let kp_res: Result[Ed25519KeyPair, String] = ed25519_keypair_create("KP001", pk, sk, 1700000000);
    let kp: Ed25519KeyPair = match kp_res {
        Ok(p) => p,
        Err(e) => Ed25519KeyPair { key_id: "", public_key: pk, secret_key: sk, created_at: 0, is_valid: false }
    };
    let kp_val: Bool = kp.is_valid;
    assert_eq!(kp_val, true);
    let kp_val_check: Bool = ed25519_keypair_validate(&kp);
    assert_eq!(kp_val_check, true);

    let sig_res: Result[Ed25519Signature, String] = ed25519_signature_create("SIG001", "KP001", r_raw, s_raw, 1700000005);
    let sig: Ed25519Signature = match sig_res {
        Ok(s) => s,
        Err(e) => Ed25519Signature { sig_id: "", key_id: "", r_bytes: "", s_bytes: "", raw_bytes: "", checksum: 0, created_at: 0, is_valid: false }
    };
    let sig_val: Bool = sig.is_valid;
    assert_eq!(sig_val, true);
    let sig_val_check: Bool = ed25519_signature_validate(&sig);
    assert_eq!(sig_val_check, true);

    let serialized: String = ed25519_signature_serialize(&sig);
    let ser_len: Int = serialized.len();
    assert_eq!(ser_len > 0, true);

    let raw_sig_bytes: String = sig.raw_bytes;
    let des_res: Result[Ed25519Signature, String] = ed25519_signature_deserialize(raw_sig_bytes);
    let des_sig: Ed25519Signature = match des_res {
        Ok(s) => s,
        Err(e) => Ed25519Signature { sig_id: "", key_id: "", r_bytes: "", s_bytes: "", raw_bytes: "", checksum: 0, created_at: 0, is_valid: false }
    };
    let des_val: Bool = des_sig.is_valid;
    assert_eq!(des_val, true);

    let pol: Ed25519SecurityPolicy = ed25519_policy_init(false, true);
    let mut engine: Ed25519Engine = ed25519_engine_init("ENG_ED25519_01", pol);
    let reg_res: Result[Bool, String] = ed25519_engine_register_keypair(&mut engine, kp);
    let reg_ok: Bool = match reg_res {
        Ok(b) => b,
        Err(e) => false
    };
    assert_eq!(reg_ok, true);

    let find_res: Result[Ed25519KeyPair, String] = ed25519_engine_find_keypair(&engine, "KP001");
    let found_kp: Ed25519KeyPair = match find_res {
        Ok(p) => p,
        Err(e) => Ed25519KeyPair { key_id: "", public_key: pk, secret_key: sk, created_at: 0, is_valid: false }
    };
    let found_id: String = found_kp.key_id;
    assert_eq!(found_id, "KP001");

    let bv: Ed25519BatchVerifier = ed25519_batch_verifier_init("BATCH_01");
    let bv_total: Int = bv.total_signatures;
    assert_eq!(bv_total, 0);

    let hex_encoded: String = ed25519_hex_encode("abc");
    assert_eq!(hex_encoded, "616263");
    let hex_decoded_res: Result[String, String] = ed25519_hex_decode("616263");
    let hex_decoded: String = match hex_decoded_res {
        Ok(s) => s,
        Err(e) => ""
    };
    assert_eq!(hex_decoded, "abc");

    let eq_test: Bool = ed25519_constant_time_eq("hello", "hello");
    assert_eq!(eq_test, true);
    let ne_test: Bool = ed25519_constant_time_eq("hello", "world");
    assert_eq!(ne_test, false);

    let sk_to_wipe: Ed25519SecretKey = sk;
    let wiped_sk: Ed25519SecretKey = ed25519_secret_key_wipe(sk_to_wipe);
    let wiped_state: Bool = wiped_sk.is_wiped;
    assert_eq!(wiped_state, true);
    let wiped_val_check: Bool = ed25519_secret_key_validate(&wiped_sk);
    assert_eq!(wiped_val_check, false);
}
