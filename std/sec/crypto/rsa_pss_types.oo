// # RSA-PSS Data Types
//
// Logline: Provides rsa-pss data types primitives and operations for openOODA standard library.
//
// Setup: Imports companion modules for RSA operations.
//
// Beats:
//   1. Import RSA types and dependencies.
//   2. Execute rsa-pss data types operations.
//   3. Provide validation and lifecycle routines.

// -------------------------------------------------------------------
// Core Data Structures & Realistic RSA-PSS Types
// -------------------------------------------------------------------

pub type RsaPublicKey = struct {
    is_valid: Bool,
    key_id: String,
    modulus_n: String,
    exponent_e: Int,
    bit_len: Int,
    checksum: Int
};

pub type RsaPrivateKey = struct {
    is_valid: Bool,
    key_id: String,
    modulus_n: String,
    exponent_e: Int,
    private_d: String,
    prime_p: String,
    prime_q: String,
    dp: String,
    dq: String,
    qinv: String,
    bit_len: Int,
    checksum: Int
};

pub type RsaPssSignature = struct {
    is_valid: Bool,
    sig_id: String,
    key_id: String,
    sig_bytes: String,
    salt_bytes: String,
    len: Int,
    checksum: Int,
    timestamp: Int
};

pub type RsaPssParams = struct {
    is_valid: Bool,
    key_bits: Int,
    hash_alg: String,
    mgf_alg: String,
    salt_len: Int,
    trailer_field: Int
};

pub type RsaPssKeyPair = struct {
    is_valid: Bool,
    key_id: String,
    public_key: RsaPublicKey,
    private_key: RsaPrivateKey,
    params: RsaPssParams,
    created_at: Int
};

pub type RsaPssVerificationResult = struct {
    is_valid: Bool,
    key_id: String,
    message_digest: String,
    error_code: String,
    verification_time: Int
};

pub type RsaPssSecurityPolicy = struct {
    is_active: Bool,
    min_key_bits: Int,
    require_sha256_or_higher: Bool,
    fail_closed: Bool,
    allow_legacy_padding: Bool
};

pub type RsaPssEngine = struct {
    engine_id: String,
    policy: RsaPssSecurityPolicy,
    key_pairs: List[RsaPssKeyPair],
    signed_count: Int,
    verified_count: Int,
    rejected_count: Int,
    strict_mode: Bool,
    system_halted: Bool
};

// Legacy alias structs for backward compatibility
pub type RSAPubKey = struct {
    n_modulus: String,
    e_exponent: Int
};

pub type RSAPrivKey = struct {
    n_modulus: String,
    d_private: String,
    p_prime: String,
    q_prime: String
};

pub type PSSSignature = struct {
    sig_bytes: String,
    len: Int
};

// -------------------------------------------------------------------
// Lightweight constructors (keep types unit checkable)
// -------------------------------------------------------------------

pub fn rsa_pub_key_empty() -> RsaPublicKey {
    return RsaPublicKey {
        is_valid: false,
        key_id: "",
        modulus_n: "",
        exponent_e: 65537,
        bit_len: 0,
        checksum: 0
    };
}

pub fn rsa_legacy_pub(n: String, e: Int) -> RSAPubKey {
    return RSAPubKey {
        n_modulus: n,
        e_exponent: e
    };
}

pub fn rsa_legacy_priv(n: String, d: String, p: String, q: String) -> RSAPrivKey {
    return RSAPrivKey {
        n_modulus: n,
        d_private: d,
        p_prime: p,
        q_prime: q
    };
}

pub fn rsa_pss_sig_empty() -> PSSSignature {
    return PSSSignature {
        sig_bytes: "",
        len: 0
    };
}

