// # Bulletproofs Facade
//
// Logline: Re-exports Bulletproofs data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import Bulletproofs companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 6 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./bulletproofs_prover.oo";

pub fn shim_marker_mod_pow() -> Int {
    return bp_mod_pow(2, 10, 1009);
}

pub fn shim_marker_pedersen() -> PedersenCommitment {
    return pedersen_commitment_create(11, 17, 42, 99, 1009);
}

pub fn shim_marker_generators() -> BulletproofGenerators {
    return bulletproof_generators_create(8, 1, 11, 17, 1009);
}

pub fn shim_marker_prover_init() -> BulletproofProver {
    let gens: BulletproofGenerators = bulletproof_generators_create(8, 1, 11, 17, 1009);
    return bulletproof_prover_init("Prover1", gens, 1009);
}

pub fn shim_marker_verifier_init() -> BulletproofVerifier {
    let gens: BulletproofGenerators = bulletproof_generators_create(8, 1, 11, 17, 1009);
    return bulletproof_verifier_init("Verifier1", gens, 1009);
}

pub fn shim_marker_do_work(p: &BulletproofProver, v: &BulletproofVerifier) -> Int {
    return bulletproof_do_work(p, v);
}
