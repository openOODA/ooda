// # KMAC Cryptography Facade
//
// Logline: Re-exports KMAC data structures, encoding operations, context engine, and fail-closed stubs.
//
// Setup: Pure module shim importing types, operations, engine, and stub submodules.
//
// Beats:
//   1. Import KMAC types, operations, engine, and stub companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream cryptography consumers.

import "./kmac_types.oo";
import "./kmac_ops.oo";
import "./kmac_engine.oo";
import "./kmac_stubs.oo";

pub fn shim_marker_checksum() -> Int {
    return kmac_checksum("abc");
}

pub fn shim_marker_key_create() -> Result[KmacKey, String] {
    return kmac_key_create("k1", "0123456789abcdef");
}

pub fn shim_marker_config_128() -> Result[KmacConfig, String] {
    return kmac_config_128("cfg1", 256, "custom");
}

pub fn shim_marker_config_256() -> Result[KmacConfig, String] {
    return kmac_config_256("cfg2", 512, "custom");
}

pub fn shim_marker_tag_create() -> Result[KmacTag, String] {
    return kmac_tag_create("tag1", "KMAC256", "0123456789abcdef");
}

pub fn shim_marker_engine_init() -> Result[KmacEngine, String] {
    let p: KmacSecurityPolicy = kmac_security_policy_default();
    return kmac_engine_init("eng1", p);
}

pub fn shim_marker_xof_reader() -> KmacXofReader {
    return kmac_xof_reader_init("r1", "ctx1");
}

verify kmac {
    let le_res: Result[String, String] = left_encode(0);
    let le0: String = match le_res {
        Ok(s) => s,
        Err(e) => "",
    };
    assert_eq!(le0.len(), 2);
    assert_eq!(byte_at(le0, 0), 1);
    assert_eq!(byte_at(le0, 1), 0);

    let le128_res: Result[String, String] = left_encode(128);
    let le128: String = match le128_res {
        Ok(s) => s,
        Err(e) => "",
    };
    assert_eq!(le128.len(), 2);
    assert_eq!(byte_at(le128, 0), 1);
    assert_eq!(byte_at(le128, 1), 128);

    let re0_res: Result[String, String] = right_encode(0);
    let re0: String = match re0_res {
        Ok(s) => s,
        Err(e) => "",
    };
    assert_eq!(re0.len(), 2);
    assert_eq!(byte_at(re0, 0), 0);
    assert_eq!(byte_at(re0, 1), 1);

    let enc_str_res: Result[String, String] = encode_string("ABC");
    let enc_str: String = match enc_str_res {
        Ok(s) => s,
        Err(e) => "",
    };
    assert_eq!(enc_str.len(), 5);
    assert_eq!(byte_at(enc_str, 0), 1);
    assert_eq!(byte_at(enc_str, 1), 24);

    let bpad_res: Result[String, String] = bytepad("test", 168);
    let bpad: String = match bpad_res {
        Ok(s) => s,
        Err(e) => "",
    };
    assert_eq!(bpad.len(), 168);

    let k_res: Result[KmacKey, String] = kmac_key_create("KEY_01", "0123456789abcdef0123456789abcdef");
    let key: KmacKey = match k_res {
        Ok(k) => k,
        Err(e) => KmacKey {
            key_id: "",
            key_bytes: "",
            len: 0,
            checksum: 0,
            is_valid: false,
        },
    };
    let k_ok: Bool = kmac_key_validate(&key);
    assert_eq!(k_ok, true);

    let cfg128_res: Result[KmacConfig, String] = kmac_config_128("CFG_128", 256, "MyCustomization");
    let cfg128: KmacConfig = match cfg128_res {
        Ok(c) => c,
        Err(e) => KmacConfig {
            config_id: "",
            variant: "",
            rate: 0,
            capacity: 0,
            output_bits: 0,
            custom_str: "",
            fail_closed: false,
            is_valid: false,
        },
    };
    let cfg128_ok: Bool = kmac_config_validate(&cfg128);
    assert_eq!(cfg128_ok, true);

    let cfg256_res: Result[KmacConfig, String] = kmac_config_256("CFG_256", 512, "MyCustomization");
    let cfg256: KmacConfig = match cfg256_res {
        Ok(c) => c,
        Err(e) => KmacConfig {
            config_id: "",
            variant: "",
            rate: 0,
            capacity: 0,
            output_bits: 0,
            custom_str: "",
            fail_closed: false,
            is_valid: false,
        },
    };
    let cfg256_ok: Bool = kmac_config_validate(&cfg256);
    assert_eq!(cfg256_ok, true);

    let ctx_res: Result[KmacCtx, String] = kmac_ctx_init("CTX_01", key, cfg256);
    let ctx: KmacCtx = match ctx_res {
        Ok(c) => c,
        Err(e) => KmacCtx {
            ctx_id: "",
            config: cfg256,
            key: key,
            custom_str: "",
            bytes_absorbed: 0,
            is_squeezing: false,
            checksum: 0,
            is_initialized: false,
            is_active: false,
        },
    };
    let ctx_ok: Bool = kmac_ctx_validate(&ctx);
    assert_eq!(ctx_ok, true);

    let tag_raw: String = "0123456789abcdef0123456789abcdef";
    let tag_res: Result[KmacTag, String] = kmac_tag_create("TAG_01", "KMAC256", tag_raw);
    let tag1: KmacTag = match tag_res {
        Ok(t) => t,
        Err(e) => KmacTag {
            tag_id: "",
            algorithm: "",
            raw_bytes: "",
            hex_str: "",
            bit_length: 0,
            byte_length: 0,
            checksum: 0,
            is_valid: false,
        },
    };
    let tag1_ok: Bool = kmac_tag_validate(&tag1);
    assert_eq!(tag1_ok, true);

    let hex_encoded: String = kmac_hex_encode("KMAC");
    assert_eq!(hex_encoded, "4b4d4143");

    let hex_decoded_res: Result[String, String] = kmac_hex_decode("4b4d4143");
    let hex_decoded: String = match hex_decoded_res {
        Ok(s) => s,
        Err(e) => "",
    };
    assert_eq!(hex_decoded, "KMAC");

    let tag2_res: Result[KmacTag, String] = kmac_tag_create("TAG_02", "KMAC256", tag_raw);
    let tag2: KmacTag = match tag2_res {
        Ok(t) => t,
        Err(e) => tag1,
    };
    let v_res: KmacVerificationResult = kmac_verify_tag(&tag1, &tag2);
    assert_eq!(v_res.is_valid, true);

    let pol: KmacSecurityPolicy = kmac_security_policy_default();
    let eng_res: Result[KmacEngine, String] = kmac_engine_init("ENG_01", pol);
    let eng_ok: Bool = match eng_res {
        Ok(e) => true,
        Err(e) => false,
    };
    assert_eq!(eng_ok, true);

    let reader: KmacXofReader = kmac_xof_reader_init("READER_01", "CTX_01");
    assert_eq!(reader.is_active, true);
}
