import "./kmac_types.oo";
import "./kmac_ops.oo";

pub fn shim_marker_left_encode(val: Int) -> Result[String, String] {
    return left_encode(val);
}

pub fn shim_marker_right_encode(val: Int) -> Result[String, String] {
    return right_encode(val);
}

pub fn shim_marker_encode_string(s: String) -> Result[String, String] {
    return encode_string(s);
}

pub fn shim_marker_bytepad(x: String, w: Int) -> Result[String, String] {
    return bytepad(x, w);
}

pub fn shim_marker_config_new(rate: Int, capacity: Int, bits: Int) -> KmacConfig {
    return kmac_config_new(rate, capacity, bits);
}

pub fn __dummy_std_src_ooda_sec_crypto_kmac_oo() -> Int {
    return 0;
