// # HSM Facade
//
// Logline: Re-exports HSM data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import HSM companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 5 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids when the shim
// monomorphizes too many by-value calls in one unit.
// Real implementations remain in split modules (check green alone).
// Shim unit needs OO_LIST_AMBIENT_QUOTA=2147483648 (huge monomorphize).

import "./hsm_ops.oo";
import "./hsm_engine.oo";
import "./hsm_pkcs.oo";
import "./hsm_stubs.oo";

pub fn shim_marker_checksum() -> Int {
    return hsm_checksum("abc");
}

pub fn shim_marker_hex() -> String {
    return hsm_hex_encode("HSM");
}

pub fn shim_marker_policy_default() -> HsmSecurityPolicy {
    return hsm_policy_default();
}

pub fn shim_marker_policy_strict() -> HsmSecurityPolicy {
    return hsm_policy_strict();
}

pub fn shim_marker_engine_init() -> HsmEngine {
    let pol: HsmSecurityPolicy = hsm_policy_default();
    return hsm_engine_init("HSM_ENG_01", pol);
}

pub fn shim_marker_engine_do_work(engine: &HsmEngine) -> Int {
    return hsm_engine_do_work(engine);
}

pub fn shim_marker_mechanism_ecdsa() -> P11Mechanism {
    return hsm_mechanism_ecdsa();
}

pub fn shim_marker_module_ready() -> Bool {
    return hsm_module_ready();
}
