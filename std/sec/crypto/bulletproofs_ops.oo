// # Bulletproofs Operations and Helpers
//
// Logline: Implements mathematical operations, parameter builders, and transformation helpers for BULLETPROOFS.
//
// Setup: Imports bulletproofs_types.oo for data structure definitions.
//
// Beats:
//   1. Import BULLETPROOFS types.
//   2. Implement core algorithmic operations and validations.
//   3. Provide encoding, decoding, and conversion routines.

import "./bulletproofs_types.oo";

pub fn bp_mod_add(a: Int, b: Int, modulus: Int) -> Int {
    if modulus <= 0 { return 0; }
    let sum: Int = (a + b) % modulus;
    if sum < 0 { return sum + modulus; }
    return sum;
}

pub fn bp_mod_sub(a: Int, b: Int, modulus: Int) -> Int {
    if modulus <= 0 { return 0; }
    let diff: Int = (a - b) % modulus;
    if diff < 0 { return diff + modulus; }
    return diff;
}

pub fn bp_mod_mul(a: Int, b: Int, modulus: Int) -> Int {
    if modulus <= 0 { return 0; }
    let prod: Int = (a * b) % modulus;
    if prod < 0 { return prod + modulus; }
    return prod;
}

pub fn bp_mod_pow(base: Int, exp: Int, modulus: Int) -> Int {
    if modulus <= 1 { return 0; }
    let mut res: Int = 1;
    let mut b: Int = base % modulus;
    if b < 0 { b = b + modulus; }
    let mut e: Int = exp;
    while e > 0 {
        if e % 2 == 1 {
            res = (res * b) % modulus;
        }
        e = e / 2;
        b = (b * b) % modulus;
    }
    return res;
}

pub fn bp_vector_dot_product(vec_a: List[Int], vec_b: List[Int], modulus: Int) -> Int {
    let len_a: Int = list_len(vec_a);
    let len_b: Int = list_len(vec_b);
    let mut count: Int = len_a;
    if len_b < count { count = len_b; }
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < count {
        let va: Int = list_get(vec_a, i);
        let vb: Int = list_get(vec_b, i);
        let term: Int = bp_mod_mul(va, vb, modulus);
        acc = bp_mod_add(acc, term, modulus);
        i = i + 1;
    }
    return acc;
}

pub fn bp_hash_challenge(a: Int, b: Int, modulus: Int) -> Int {
    let h: Int = (a * 31 + b) & 2147483647;
    if modulus > 0 {
        return h % modulus;
    }
    return h;
}

pub fn pedersen_commitment_create(
    pc_g: Int,
    pc_h: Int,
    pc_val: Int,
    pc_r: Int,
    modulus: Int
) -> PedersenCommitment {
    if modulus <= 1 {
        return PedersenCommitment {
            commitment: 0,
            generator_g: pc_g,
            generator_h: pc_h,
            blinding_factor: pc_r,
            value: pc_val,
            modulus: modulus,
            is_valid: false,
        };
    }
    let pc_gv: Int = bp_mod_pow(pc_g, pc_val, modulus);
    let pc_hr: Int = bp_mod_pow(pc_h, pc_r, modulus);
    let pc_calc_comm: Int = bp_mod_mul(pc_gv, pc_hr, modulus);

    return PedersenCommitment {
        commitment: pc_calc_comm,
        generator_g: pc_g,
        generator_h: pc_h,
        blinding_factor: pc_r,
        value: pc_val,
        modulus: modulus,
        is_valid: true,
    };
}

pub fn pedersen_commitment_verify(target_pcomm: PedersenCommitment, target_comm_val: Int) -> Bool {
    if (target_pcomm.is_valid) == false {
        return false;
    }
    let pc_expected: PedersenCommitment = pedersen_commitment_create(
        target_pcomm.generator_g,
        target_pcomm.generator_h,
        target_pcomm.value,
        target_pcomm.blinding_factor,
        target_pcomm.modulus
    );
    if (pc_expected.commitment) == target_comm_val {
        return true;
    }
    return false;
}

pub fn pedersen_commitment_homomorphic_add(
    pcomm1: PedersenCommitment,
    pcomm2: PedersenCommitment
) -> PedersenCommitment {
    if (pcomm1.is_valid) == false { return pcomm2; }
    if (pcomm2.is_valid) == false { return pcomm1; }
    let pcomm_comb_c: Int = bp_mod_mul(pcomm1.commitment, pcomm2.commitment, pcomm1.modulus);
    let pcomm_comb_v: Int = (pcomm1.value) + (pcomm2.value);
    let pcomm_comb_r: Int = (pcomm1.blinding_factor) + (pcomm2.blinding_factor);

    return PedersenCommitment {
        commitment: pcomm_comb_c,
        generator_g: pcomm1.generator_g,
        generator_h: pcomm1.generator_h,
        blinding_factor: pcomm_comb_r,
        value: pcomm_comb_v,
        modulus: pcomm1.modulus,
        is_valid: true,
    };
}

pub fn pedersen_commitment_to_string(pcomm: PedersenCommitment) -> String {
    let c_str: String = (pcomm.commitment).to_string();
    let v_str: String = (pcomm.value).to_string();
    let r_str: String = (pcomm.blinding_factor).to_string();
    return "PedersenCommitment(C=" + c_str + ", V=" + v_str + ", R=" + r_str + ")";
}

pub fn bulletproof_generators_create(
    gens_capacity: Int,
    party_capacity: Int,
    g_base: Int,
    h_base: Int,
    modulus: Int
) -> BulletproofGenerators {
    let mut g_list: List[Int] = list_new();
    let mut h_list: List[Int] = list_new();
    if modulus <= 1 {
        return BulletproofGenerators {
            gens_capacity: gens_capacity,
            party_capacity: party_capacity,
            g_base: g_base,
            h_base: h_base,
            g_vec: g_list,
            h_vec: h_list,
            modulus: modulus,
            is_valid: false,
        };
    }

    let total_gens: Int = gens_capacity * party_capacity;
    let mut i: Int = 0;
    while i < total_gens {
        let g_elem: Int = bp_mod_add(g_base, (i + 1) * 7, modulus);
        let h_elem: Int = bp_mod_add(h_base, (i + 1) * 13, modulus);
        g_list = list_push(g_list, g_elem);
        h_list = list_push(h_list, h_elem);
        i = i + 1;
    }

    return BulletproofGenerators {
        gens_capacity: gens_capacity,
        party_capacity: party_capacity,
        g_base: g_base,
        h_base: h_base,
        g_vec: g_list,
        h_vec: h_list,
        modulus: modulus,
        is_valid: true,
    };
}

pub fn bulletproof_generators_verify(gens: BulletproofGenerators) -> Bool {
    if (gens.is_valid) == false { return false; }
    let total_expected: Int = (gens.gens_capacity) * (gens.party_capacity);
    let len_g: Int = list_len(gens.g_vec);
    let len_h: Int = list_len(gens.h_vec);
    if len_g != total_expected { return false; }
    if len_h != total_expected { return false; }
    return true;
}
