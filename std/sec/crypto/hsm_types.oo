// # HSM types
//
// Logline: KeyHandle, P11Mechanism, slot, token, and session data definitions for HSM.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//

type KeyHandle = struct {
    handle_id: Int,
    key_id: String,
    key_type: String,
    key_class: String,
    is_token_object: Bool,
    is_extractable: Bool,
    is_sensitive: Bool,
    checksum: Int,
    is_valid: Bool
};

type P11Mechanism = struct {
    mechanism_type: Int,
    mechanism_name: String,
    parameter_bytes: String,
    parameter_len: Int,
    is_valid: Bool
};

type HsmSlotInfo = struct {
    slot_id: Int,
    slot_description: String,
    manufacturer_id: String,
    hardware_version: String,
    firmware_version: String,
    is_token_present: Bool,
    is_hardware_slot: Bool
};

type HsmTokenInfo = struct {
    label: String,
    manufacturer_id: String,
    model: String,
    serial_number: String,
    flags: Int,
    max_session_count: Int,
    session_count: Int,
    is_initialized: Bool,
    is_pin_protected: Bool
};

type HsmSession = struct {
    session_handle: Int,
    slot_id: Int,
    state: Int,
    is_read_write: Bool,
    is_logged_in: Bool,
    user_type: Int,
    created_at: Int,
    is_active: Bool
};

type HsmAttribute = struct {
    type_code: Int,
    type_name: String,
    value_str: String,
    value_int: Int,
    value_bool: Bool
};

pub fn hsm_handle_new(handle_id: Int, checksum: Int, is_valid: Int) -> KeyHandle {
    let mut valid: Bool = false;
    if is_valid != 0 { valid = true; }
    return KeyHandle {
        handle_id: handle_id,
        key_id: handle_id.to_string(),
        key_type: "GENERIC",
        key_class: "SECRET",
        is_token_object: false,
        is_extractable: true,
        is_sensitive: false,
        checksum: checksum,
        is_valid: valid
    };
}

pub fn hsm_handle_id(h: KeyHandle) -> Int {
    return (h).handle_id;
}
