// # HSM types
//
// Logline: KeyHandle destubbed off Result[struct].
// residual: destubbed to Int floor.

type KeyHandle = struct {
    handle_id: Int,
    checksum: Int,
    is_valid: Int
};

pub fn hsm_handle_new(handle_id: Int, checksum: Int, is_valid: Int) -> KeyHandle {
    return KeyHandle {
        handle_id: handle_id,
        checksum: checksum,
        is_valid: is_valid
    };
}

pub fn hsm_handle_id(h: KeyHandle) -> Int {
    return h.handle_id;
}
