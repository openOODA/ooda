// # BLAKE3 types
//
// Logline: Blake3Key destubbed off pub type String.
// residual: destubbed to Int floor. Not a PQC impl.

type Blake3Key = struct {
    checksum: Int,
    is_valid: Int,
    flags: Int
};

pub fn blake3_key_new(checksum: Int, is_valid: Int, flags: Int) -> Blake3Key {
    return Blake3Key {
        checksum: checksum,
        is_valid: is_valid,
        flags: flags
    };
}

pub fn blake3_key_sum(k: Blake3Key) -> Int {
    return k.checksum;
}
