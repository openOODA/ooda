// # BLAKE3 types
//
// Logline: Data structures, chunk state, tree state, hasher, and digest models for BLAKE3.
//
// Setup: Pure data definitions and configuration models.
//
// Beats:
//   1. Define BLAKE3 key, chunk state, and tree state structures.
//   2. Define hasher, digest, security policy, XOF reader, and engine structures.
//   3. Implement constructor and helper utilities.

type Blake3Key = struct {
    key_id: String,
    key_bytes: String,
    checksum: Int,
    is_valid: Bool
};

type Blake3ChunkState = struct {
    cv: List[Int],
    chunk_counter: Int,
    buf: String,
    buf_len: Int,
    blocks_compressed: Int,
    flags: Int,
    is_initialized: Bool
};

type Blake3TreeState = struct {
    cv_stack: List[Int],
    stack_depth: Int,
    total_chunks: Int,
    total_bytes: Int,
    is_keyed: Bool,
    is_derive_key: Bool,
    is_initialized: Bool
};

type Blake3Hasher = struct {
    hasher_id: String,
    key: Blake3Key,
    chunk_state: Blake3ChunkState,
    tree_state: Blake3TreeState,
    hasher_mode: Int,
    context_string: String,
    is_initialized: Bool
};

type Blake3Digest = struct {
    raw_bytes: String,
    hex_str: String,
    len_bytes: Int,
    checksum: Int,
    is_valid: Bool
};

type Blake3SecurityPolicy = struct {
    fail_closed: Bool,
    allow_custom_xof_len: Bool,
    require_keyed: Bool,
    is_active: Bool
};

type Blake3Engine = struct {
    engine_id: String,
    policy: Blake3SecurityPolicy,
    hasher: Blake3Hasher,
    bytes_hashed: Int,
    chunks_processed: Int,
    system_halted: Bool
};

type Blake3XofReader = struct {
    hasher_id: String,
    position: Int,
    is_active: Bool
};

pub fn blake3_key_new(checksum: Int, is_valid: Int, flags: Int) -> Blake3Key {
    let mut valid: Bool = false;
    if is_valid != 0 { valid = true; }
    return Blake3Key {
        key_id: "default",
        key_bytes: "",
        checksum: checksum,
        is_valid: valid
    };
}

pub fn blake3_key_sum(k: Blake3Key) -> Int {
    return (k).checksum;
}
