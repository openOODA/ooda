// # Groth16 types
//
// Logline: Data types, verifying key, proof, and setup models for Groth16 zk-SNARK.
//
// Setup: Pure data definitions and helper transformations.
//
// Beats:
//   1. Define Groth16 structures and configuration types.
//   2. Implement constructor and helper utilities.
//   3. Provide validation and conversion routines.

pub fn groth16_curve_bn254() -> Int {
    return 1;
}

pub fn groth16_curve_bls12_381() -> Int {
    return 2;
}

pub fn groth16_curve_name(curve_id: Int) -> String {
    if curve_id == 1 { return "BN254"; }
    if curve_id == 2 { return "BLS12-381"; }
    return "UNKNOWN";
}

type Groth16Proof = struct {
    proof_id: String,
    curve_id: Int,
    a_g1_x: String,
    a_g1_y: String,
    b_g2_x0: String,
    b_g2_x1: String,
    b_g2_y0: String,
    b_g2_y1: String,
    c_g1_x: String,
    c_g1_y: String,
    is_compressed: Bool,
    is_valid: Bool
};

type PublicInputs = struct {
    input_id: String,
    values: List[String],
    scalar_count: Int,
    hash_digest: String,
    is_well_formed: Bool
};

type Groth16Vk = struct {
    vk_id: String,
    curve_id: Int,
    num_public_inputs: Int,
    alpha_g1_x: String,
    alpha_g1_y: String,
    beta_g2_x0: String,
    beta_g2_x1: String,
    beta_g2_y0: String,
    beta_g2_y1: String,
    gamma_g2_x0: String,
    gamma_g2_x1: String,
    gamma_g2_y0: String,
    gamma_g2_y1: String,
    delta_g2_x0: String,
    delta_g2_x1: String,
    delta_g2_y0: String,
    delta_g2_y1: String,
    ic_g1_x: List[String],
    ic_g1_y: List[String],
    is_valid: Bool
};

type Groth16Verifier = struct {
    verifier_id: String,
    vk: Groth16Vk,
    verified_count: Int,
    rejected_count: Int,
    strict_mode: Bool,
    is_active: Bool
};

type Groth16VerificationResult = struct {
    is_valid: Bool,
    pairing_satisfied: Bool,
    inputs_matched: Bool,
    error_message: String
};

type Groth16BatchVerifier = struct {
    batch_id: String,
    proofs: List[Groth16Proof],
    inputs_list: List[PublicInputs],
    batch_size: Int,
    is_closed: Bool
};

type Groth16SetupParams = struct {
    circuit_name: String,
    curve_id: Int,
    num_constraints: Int,
    num_variables: Int,
    num_public_inputs: Int,
    is_trusted_setup_complete: Bool
};

type Groth16Setup = struct {
    curve_id: Int,
    proof_bytes: Int,
    flag_bits: Int
};

pub fn groth16_setup_new(curve_id: Int, num_public_inputs: Int) -> Groth16Setup {
    let mut proof_bytes: Int = 0;
    if curve_id == 1 {
        proof_bytes = 192;
    }
    if curve_id == 2 {
        proof_bytes = 288;
    }
    let mut valid: Int = 0;
    if proof_bytes > 0 {
        if num_public_inputs >= 0 {
            valid = 1;
        }
    }
    let packed: Int = valid + (num_public_inputs * 2);
    return Groth16Setup {
        curve_id: curve_id,
        proof_bytes: proof_bytes,
        flag_bits: packed
    };
}

pub fn groth16_setup_bytes(s: Groth16Setup) -> Int {
    return s.proof_bytes;
}

pub fn groth16_setup_flags(s: Groth16Setup) -> Int {
    return s.flag_bits;
}
