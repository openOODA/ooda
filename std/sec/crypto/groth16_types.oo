// # Groth16 types
//
// Logline: Groth16Setup destubbed off pub type List[String] VK.
// residual: List[String]/List[struct] destubbed to Int floor.

type Groth16Setup = struct {
    curve_id: Int,
    proof_bytes: Int,
    flag_bits: Int
};

pub fn groth16_setup_new(curve_id: Int, num_public_inputs: Int) -> Groth16Setup {
    let mut proof_bytes: Int = 0;
    if curve_id == 1 {
        proof_bytes = 192;
    }
    if curve_id == 2 {
        proof_bytes = 288;
    }
    let mut valid: Int = 0;
    if proof_bytes > 0 {
        if num_public_inputs >= 0 {
            valid = 1;
        }
    }
    let packed: Int = valid + (num_public_inputs * 2);
    return Groth16Setup {
        curve_id: curve_id,
        proof_bytes: proof_bytes,
        flag_bits: packed
    };
}

pub fn groth16_setup_bytes(s: Groth16Setup) -> Int {
    return s.proof_bytes;
}

pub fn groth16_setup_flags(s: Groth16Setup) -> Int {
    return s.flag_bits;
}
