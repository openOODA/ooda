// # BFV types
//
// Logline: BfvParameters destubbed off pub type List[String] keys.
// residual: List[struct]/List[String] destubbed to Int floor.

type BfvParameters = struct {
    poly_degree: Int,
    plain_mod: Int,
    flag_bits: Int
};

pub fn bfv_params_new(poly_degree: Int, plain_mod: Int, coeff_bits: Int) -> BfvParameters {
    let mut valid: Int = 0;
    if poly_degree >= 1024 {
        let rem: Int = poly_degree % 1024;
        if rem == 0 {
            if plain_mod >= 2 {
                if coeff_bits >= 16 {
                    valid = 1;
                }
            }
        }
    }
    let max_level: Int = coeff_bits / 20;
    let packed: Int = valid + (max_level * 2);
    return BfvParameters {
        poly_degree: poly_degree,
        plain_mod: plain_mod,
        flag_bits: packed
    };
}

pub fn bfv_params_degree(p: BfvParameters) -> Int {
    return p.poly_degree;
}

pub fn bfv_params_flags(p: BfvParameters) -> Int {
    return p.flag_bits;
}
