pub fn kmac_absorb(ctx: &mut KmacCtx, data: String) -> Result[Bool, String] {
    // COMPILER LIMITATION: Incremental KMAC data absorption requires packing bytes into 64-bit little-endian words,
    // updating Keccak rate lanes, and triggering Keccak-f[1600] sponge permutations upon reaching rate boundaries.
    // Keeping process_exit(1) as a fail-closed stub.
    process_exit(1);
    return Ok(false);
}

pub fn kmac_finalize(ctx: &mut KmacCtx) -> Result[KmacTag, String] {
    // COMPILER LIMITATION: KMAC finalization requires right_encode(L) output length formatting,
