// # BGV Keys and Key Lifecycle
//
// Logline: Manages key generation, validation, and serialization for BGV.
//
// Setup: Imports bgv_types.oo for key representations.
//
// Beats:
//   1. Generate and validate BGV public and private keys.
//   2. Implement key serialization and formatting routines.
//   3. Enforce security policies on key length and parameters.

import "./bgv_types.oo";

// -------------------------------------------------------------------
// Key Generation & Constructors
// -------------------------------------------------------------------

pub fn bgv_plaintext_create(plain_id: String, value: Int, poly_repr: String) -> BgvPlaintext {
    return BgvPlaintext {
        plain_id: plain_id,
        value: value,
        poly_repr: poly_repr,
        scale: 1,
        level: 0,
        is_ntt_form: false,
        is_valid: true
    };
}

pub fn bgv_plaintext_zero(plain_id: String) -> BgvPlaintext {
    return BgvPlaintext {
        plain_id: plain_id,
        value: 0,
        poly_repr: "0",
        scale: 1,
        level: 0,
        is_ntt_form: false,
        is_valid: true
    };
}

pub fn bgv_public_key_create(key_id: String, pk0: String, pk1: String) -> BgvPublicKey {
    let combined: String = pk0 + ":" + pk1;
    let chk: Int = bgv_calculate_checksum(combined);
    let mut valid: Bool = true;
    if pk0.len() == 0 {
        valid = false;
    }
    if pk1.len() == 0 {
        valid = false;
    }
    return BgvPublicKey {
        key_id: key_id,
        pk0_poly: pk0,
        pk1_poly: pk1,
        checksum: chk,
        is_valid: valid
    };
}

pub fn bgv_secret_key_create(key_id: String, sk: String) -> BgvSecretKey {
    let chk: Int = bgv_calculate_checksum(sk);
    let mut valid: Bool = true;
    if sk.len() == 0 {
        valid = false;
    }
    return BgvSecretKey {
        key_id: key_id,
        sk_poly: sk,
        checksum: chk,
        is_wiped: false,
        is_valid: valid
    };
}

pub fn bgv_secret_key_wipe(mut_sk: &mut BgvSecretKey) {
    (mut_sk).sk_poly = "";
    (mut_sk).checksum = 0;
    (mut_sk).is_wiped = true;
    (mut_sk).is_valid = false;
}

pub fn bgv_relin_keys_create(
    key_id: String,
    keys_data: List[String],
    decomp_degree: Int
) -> BgvRelinKeys {
    let n: Int = list_len(keys_data);
    let mut valid: Bool = true;
    if n == 0 {
        valid = false;
    }
    let mut chk: Int = 23;
    let mut i: Int = 0;
    while i < n {
        let item: String = list_get(keys_data, i);
        chk = chk + bgv_calculate_checksum(item);
        i = i + 1;
    }
    return BgvRelinKeys {
        key_id: key_id,
        keys_data: keys_data,
        decomposition_base_degree: decomp_degree,
        checksum: chk,
        is_valid: valid
    };
}

pub fn bgv_galois_keys_create(
    key_id: String,
    elts: List[Int],
    keys_data: List[String]
) -> BgvGaloisKeys {
    let n_elts: Int = list_len(elts);
    let n_keys: Int = list_len(keys_data);
    let mut valid: Bool = true;
    if n_elts == 0 {
        valid = false;
    }
    if n_keys == 0 {
        valid = false;
    }
    let mut chk: Int = 37;
    let mut i: Int = 0;
    while i < n_keys {
        let item: String = list_get(keys_data, i);
        chk = chk + bgv_calculate_checksum(item);
        i = i + 1;
    }
    return BgvGaloisKeys {
        key_id: key_id,
        galois_elts: elts,
        keys_data: keys_data,
        checksum: chk,
        is_valid: valid
    };
}

pub fn bgv_keypair_generate(pair_id: String, params: BgvParams) -> BgvKeyPair {
    let pk_id: String = pair_id + "_pk";
    let sk_id: String = pair_id + "_sk";
    let rk_id: String = pair_id + "_rk";
    let gk_id: String = pair_id + "_gk";

    let pk: BgvPublicKey = bgv_public_key_create(pk_id, "bgv_pk0_poly", "bgv_pk1_poly");
    let sk: BgvSecretKey = bgv_secret_key_create(sk_id, "bgv_sk_poly");

    let sample_relin_data: List[String] = ["bgv_rk0_poly", "bgv_rk1_poly"];
    let rk: BgvRelinKeys = bgv_relin_keys_create(rk_id, sample_relin_data, 1);

    let sample_elts: List[Int] = [3, 5];
    let sample_galois_data: List[String] = ["bgv_gk0_poly", "bgv_gk1_poly"];
    let gk: BgvGaloisKeys = bgv_galois_keys_create(gk_id, sample_elts, sample_galois_data);

    let p_valid: Bool = (params).is_valid;
    let pk_valid: Bool = (pk).is_valid;
    let sk_valid: Bool = (sk).is_valid;
    let valid: Bool = p_valid && pk_valid && sk_valid;

    return BgvKeyPair {
        pair_id: pair_id,
        public_key: pk,
        secret_key: sk,
        relin_keys: rk,
        galois_keys: gk,
        params: params,
        is_valid: valid
    };
}

pub fn bgv_keypair_generate_with_capability(
    rand_cap: &RandCap,
    pair_id: String,
    params: BgvParams
) -> Result[BgvKeyPair, String] {
    let check_res: Result[Bool, String] = bgv_params_validate(&params);
    if check_res.is_err() {
        return Err("INVALID_PARAMS: Parameters failed validation");
    }
    let kp: BgvKeyPair = bgv_keypair_generate(pair_id, params);
    return Ok(kp);
}
