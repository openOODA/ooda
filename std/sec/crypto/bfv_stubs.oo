// # BFV Fail-Closed Stubs
//
// Logline: Enforces fail-closed process exit barriers for unverified cryptographic operations in BFV.
//
// Setup: Imports destubbed bfv_types.oo (Int-floor BfvParameters).
//
// Beats:
//   1. Import BFV engine and state types.
//   2. Trap unverified low-level primitives with process_exit(1).
//   3. Guard unaudited hardware acceleration and FFI routines.

import "./bfv_types.oo";

pub fn bfv_stubs_init(poly_degree: Int, plain_mod: Int, coeff_bits: Int) -> BfvParameters {
    return bfv_params_new(poly_degree, plain_mod, coeff_bits);
}

pub fn bfv_stubs_flags(p: BfvParameters) -> Int {
    return bfv_params_flags(p);
}

pub fn bfv_npu_rotate(sys_cap: &SysCap, raw_cipher_ptr: Int) -> Int {
    process_exit(1);
    return 0;
}
