    // Hard compiler limitation: openOODA compiler lacks bitwise permutation primitives
    // and column/diagonal vector indexing needed for 7 rounds of BLAKE3 state transformation.
    // Keeping fail-closed stub.
    process_exit(1);
    return state;
}

