pub fn blake3_g_function(a: Int, b: Int, c: Int, d: Int, mx: Int, my: Int) -> List[Int] {
    // Hard compiler limitation: openOODA lacks bitwise XOR (^), right rotation (>>>),
    // and 32-bit unsigned wrapping addition required to execute the BLAKE3 G quarter round:
    // a = (a + b + mx) mod 2^32; d = (d ^ a) >>> 16; c = (c + d) mod 2^32; b = (b ^ c) >>> 12;
    // a = (a + b + my) mod 2^32; d = (d ^ a) >>> 8;  c = (c + d) mod 2^32; b = (b ^ c) >>> 7;
    // Keeping fail-closed stub.
    process_exit(1);
    return list_new();
}

