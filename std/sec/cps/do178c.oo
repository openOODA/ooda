// # DO-178C Avionics Software Compliance Module
//
// Logline: Define DalLevel, SoftwareRequirement, and SoftwareTestCase; track objectives, trace, and review.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. dal_level_init: bind level and failure_condition.
//   2. software_requirement_init: bind parent_id, trace_up, and trace_down.
//   3. software_test_case_init: bind test_procedure and expected_result.
//   4. do178c_objective_count: return required objectives for level.
//
// residual: tool qualification is process_exit in stubs.

// RULES.oot 1.4: Default-deny for privileged effects.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

// -------------------------------------------------------------------
// Core DO-178C Types
// -------------------------------------------------------------------

pub type DalLevel = struct {
    dal_id: String,
    level: Int,
    name: String,
    failure_condition: String,
    objectives: Int,
};

pub type SoftwareRequirement = struct {
    req_id: String,
    dal: Int,
    description: String,
    parent_id: String,
    trace_up: String,
    trace_down: String,
    verified: Bool,
};

pub type SoftwareTestCase = struct {
    tc_id: String,
    req_id: String,
    dal: Int,
    test_procedure: String,
    expected_result: String,
    actual_result: String,
    passed: Bool,
    executed_at: Int,
    reviewed: Bool,
};

pub type SoftwareReview = struct {
    review_id: String,
    artifact: String,
    reviewer: String,
    review_method: Int,
    findings: Int,
    critical_findings: Int,
    approved: Bool,
    timestamp: Int,
};

pub type SoftwareConfiguration = struct {
    cci_id: String,
    problem_report: String,
    change_description: String,
    baseline_id: String,
    status: Int,
    is_valid: Bool,
};

pub type DalEngine = struct {
    engine_id: String,
    requirements: List[SoftwareRequirement],
    test_cases: List[SoftwareTestCase],
    reviews: List[SoftwareReview],
    configurations: List[SoftwareConfiguration],
    total_reqs: Int,
    verified_reqs: Int,
    is_halted: Bool,
};

// -------------------------------------------------------------------
// DAL Level Constants (DO-178C Table 1-1)
// -------------------------------------------------------------------

pub fn dal_level_e() -> Int {
    return 0;
}

pub fn dal_level_d() -> Int {
    return 1;
}

pub fn dal_level_c() -> Int {
    return 2;
}

pub fn dal_level_b() -> Int {
    return 3;
}

pub fn dal_level_a() -> Int {
    return 4;
}

// -------------------------------------------------------------------
// Review Method Constants
// -------------------------------------------------------------------

pub fn review_method_inspection() -> Int {
    return 1;
}

pub fn review_method_walkthrough() -> Int {
    return 2;
}

pub fn review_method_peer_review() -> Int {
    return 3;
}

pub fn review_method_independent_review() -> Int {
    return 4;
}

// -------------------------------------------------------------------
// Configuration Status Constants
// -------------------------------------------------------------------

pub fn cci_status_draft() -> Int {
    return 1;
}

pub fn cci_status_review() -> Int {
    return 2;
}

pub fn cci_status_approved() -> Int {
    return 3;
}

pub fn cci_status_released() -> Int {
    return 4;
}

pub fn cci_status_rejected() -> Int {
    return 5;
}

// -------------------------------------------------------------------
// Required Objectives by DAL (DO-178C Table 1-1, simplified)
// -------------------------------------------------------------------

pub fn dal_required_test_coverage_pct(dal_v: Int) -> Int {
    if dal_v >= 4 {
        return 100;
    }
    if dal_v >= 3 {
        return 100;
    }
    if dal_v >= 2 {
        return 100;
    }
    if dal_v >= 1 {
        return 50;
    }
    return 0;
}

pub fn dal_required_review_method(dal_v: Int) -> Int {
    if dal_v >= 4 {
        return review_method_inspection();
    }
    if dal_v >= 3 {
        return review_method_inspection();
    }
    if dal_v >= 2 {
        return review_method_peer_review();
    }
    if dal_v >= 1 {
        return review_method_peer_review();
    }
    return review_method_walkthrough();
}

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn dal_level_a_struct() -> DalLevel {
    return DalLevel {
        dal_id: "DAL_A",
        level: 4,
        name: "Level A",
        failure_condition: "Catastrophic",
        objectives: 71,
    };
}

pub fn dal_level_b_struct() -> DalLevel {
    return DalLevel {
        dal_id: "DAL_B",
        level: 3,
        name: "Level B",
        failure_condition: "Hazardous",
        objectives: 65,
    };
}

pub fn dal_level_c_struct() -> DalLevel {
    return DalLevel {
        dal_id: "DAL_C",
        level: 2,
        name: "Level C",
        failure_condition: "Major",
        objectives: 38,
    };
}

pub fn dal_level_d_struct() -> DalLevel {
    return DalLevel {
        dal_id: "DAL_D",
        level: 1,
        name: "Level D",
        failure_condition: "Minor",
        objectives: 26,
    };
}

pub fn dal_level_e_struct() -> DalLevel {
    return DalLevel {
        dal_id: "DAL_E",
        level: 0,
        name: "Level E",
        failure_condition: "No Effect",
        objectives: 0,
    };
}

pub fn software_requirement_create(
    req_id_val: String,
    dal_v: Int,
    desc_val: String,
    parent_id_val: String,
    trace_up_val: String
) -> SoftwareRequirement {
    return SoftwareRequirement {
        req_id: req_id_val,
        dal: dal_v,
        description: desc_val,
        parent_id: parent_id_val,
        trace_up: trace_up_val,
        trace_down: "",
        verified: false,
    };
}

pub fn software_test_case_create(
    tc_id_val: String,
    req_id_val: String,
    dal_v: Int,
    procedure_val: String,
    expected_val: String
) -> SoftwareTestCase {
    return SoftwareTestCase {
        tc_id: tc_id_val,
        req_id: req_id_val,
        dal: dal_v,
        test_procedure: procedure_val,
        expected_result: expected_val,
        actual_result: "",
        passed: false,
        executed_at: 0,
        reviewed: false,
    };
}

pub fn software_review_create(
    review_id_val: String,
    artifact_val: String,
    reviewer_val: String,
    method_v: Int,
    findings_v: Int,
    critical_v: Int,
    ts: Int
) -> SoftwareReview {
    let approved_v: Bool = critical_v == 0;
    return SoftwareReview {
        review_id: review_id_val,
        artifact: artifact_val,
        reviewer: reviewer_val,
        review_method: method_v,
        findings: findings_v,
        critical_findings: critical_v,
        approved: approved_v,
        timestamp: ts,
    };
}

// -------------------------------------------------------------------
// Validation (Pure)
// -------------------------------------------------------------------

pub fn software_requirement_verified(r: &SoftwareRequirement) -> Bool {
    return (r).verified;
}

pub fn software_requirement_trace_complete(r: &SoftwareRequirement) -> Bool {
    let up_str: String = (r).trace_up;
    let up_len: Int = up_str.len();
    if up_len == 0 {
        return false;
    }
    return true;
}

pub fn software_dal_objective_count(dal_v: Int) -> Int {
    if dal_v >= 4 {
        return 71;
    }
    if dal_v >= 3 {
        return 65;
    }
    if dal_v >= 2 {
        return 38;
    }
    if dal_v >= 1 {
        return 26;
    }
    return 0;
}

pub fn software_review_method_sufficient(review: &SoftwareReview, dal_v: Int) -> Bool {
    let required: Int = dal_required_review_method(dal_v);
    let actual: Int = (review).review_method;
    if actual < required {
        return false;
    }
    return true;
}

pub fn software_test_passes(t: &SoftwareTestCase) -> Bool {
    return (t).passed;
}

// -------------------------------------------------------------------
// Engine (Pure)
// -------------------------------------------------------------------

pub fn dal_engine_init(engine_id_val: String) -> DalEngine {
    return DalEngine {
        engine_id: engine_id_val,
        requirements: list_new(),
        test_cases: list_new(),
        reviews: list_new(),
        configurations: list_new(),
        total_reqs: 0,
        verified_reqs: 0,
        is_halted: false,
    };
}

pub fn dal_engine_add_requirement(engine: &mut DalEngine, r: SoftwareRequirement) {
    let mut eng = engine;
    let old = eng.requirements;
    let mut updated: List[SoftwareRequirement] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, r);
    eng.requirements = updated;
    let inc_one: Int = 1;
    let cur_t: Int = eng.total_reqs;
    eng.total_reqs = cur_t + inc_one;
    if r.verified {
        let cur_v: Int = eng.verified_reqs;
        eng.verified_reqs = cur_v + inc_one;
    }
}

pub fn dal_engine_do_work(engine: &DalEngine) -> Int {
    let r_n = list_len((engine).requirements);
    let t_n = list_len((engine).test_cases);
    let rv_n = list_len((engine).reviews);
    return r_n + t_n + rv_n;
}

