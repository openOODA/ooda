// # SecOC Pure Decision Logic
//
// Logline: Key validity, freshness tolerance, MAC length check, MAC compare stub, and full frame verification result builder.
//
// Setup: Pure functions; no IO, no CAPs.
//
// Beats:
//   1. secoc_key_valid: now within [valid_from, valid_until].
//   2. secoc_freshness_within_tolerance: recv_counter >= local and within tolerance.
//   3. secoc_mac_length_match.
//   4. secoc_verify_mac_stub.
//   5. secoc_verify_frame: build SecOcVerifyResult with mac_valid, freshness_valid, reason.

import "./secoc_types.oo";

pub fn secoc_key_valid(key: &SecOcKey, now: Int) -> Bool {
    if (key).valid_from > now {
        return false;
    }
    if (key).valid_until < now {
        return false;
    }
    return true;
}

pub fn secoc_freshness_within_tolerance(local_counter: Int, recv_counter: Int, tolerance: Int) -> Bool {
    if recv_counter < local_counter {
        return false;
    }
    let diff: Int = recv_counter - local_counter;
    if diff > tolerance {
        return false;
    }
    return true;
}

pub fn secoc_mac_length_match(mac: String, expected: Int) -> Bool {
    let l: Int = mac.len();
    if l != expected {
        return false;
    }
    return true;
}

pub fn secoc_verify_mac_stub(truncated_mac: String, expected_mac: String) -> Bool {
    if truncated_mac == expected_mac {
        return true;
    }
    return false;
}

pub fn secoc_verify_frame(
    engine: &SecOcEngine,
    frame: &SecOcAuthenticatedFrame,
    expected_mac: String,
    freshness_tolerance: Int
) -> SecOcVerifyResult {
    let mac_ok: Bool = secoc_verify_mac_stub((frame).truncated_mac, expected_mac);
    let fresh_ok: Bool = secoc_freshness_within_tolerance(
        (engine).freshness.counter,
        (frame).freshness.counter,
        freshness_tolerance
    );
    let reason_v: String = "ok";
    let mut result = SecOcVerifyResult {
        verify_id: "verify",
        pdu_id: (frame).pdu_id,
        mac_valid: mac_ok,
        freshness_valid: fresh_ok,
        reason: reason_v,
        timestamp: 0
    };
    if mac_ok == false {
        let new_reason: String = "mac mismatch";
        result = SecOcVerifyResult {
            verify_id: "verify",
            pdu_id: (frame).pdu_id,
            mac_valid: mac_ok,
            freshness_valid: fresh_ok,
            reason: new_reason,
            timestamp: 0
        };
    }
    return result;
}
