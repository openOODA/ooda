// # BFT Quorum Computation and View Consistency
//
// Logline: Quorum size 2f+1, fault tolerance 3f+1, prepare/commit quorum check, and view consistency walk.
//
// Setup: Imports bft_types.oo. Pure computations on BftMessage / BftPrepare / BftCommit lists.
//
// Beats:
//   1. bft_quorum_size: 2*f + 1.
//   2. bft_can_tolerate: n >= 3*f.
//   3. bft_prepare_quorum_reached / bft_commit_quorum_reached: count >= required.
//   4. bft_check_view_consistency: walk messages and verify view matches.
//
// residual: signature verification is process_exit in stubs.

import "./bft_types.oo";

pub fn bft_quorum_size(n: Int, f: Int) -> Int {
    let two_f: Int = f + f;
    let two_f_plus_one: Int = two_f + 1;
    return two_f_plus_one;
}

pub fn bft_can_tolerate(n: Int, f: Int) -> Bool {
    let need: Int = 3 * f;
    let cur: Int = n;
    if cur < need {
        return false;
    }
    return true;
}

pub fn bft_prepare_quorum_reached(prepares: &List[BftPrepare], required: Int) -> Bool {
    let n: Int = list_len(prepares);
    if n >= required {
        return true;
    }
    return false;
}

pub fn bft_commit_quorum_reached(commits: &List[BftCommit], required: Int) -> Bool {
    let n: Int = list_len(commits);
    if n >= required {
        return true;
    }
    return false;
}

pub fn bft_check_view_consistency(messages: &List[BftMessage], view_v: Int) -> Bool {
    let n: Int = list_len(messages);
    let mut i = 0;
    while i < n {
        let m = list_get(messages, i);
        let mv: Int = m.view;
        if mv != view_v {
            return false;
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return true;
}
