    // COMPILER LIMITATION: openOODA lacks DNP3-SA HMAC-SHA256 truncated verify + replay-window check FFI.
    process_exit(1);
    return Err("Unimplemented: DNP3-SA HMAC verify requires CryptoCap FFI lowering");
}