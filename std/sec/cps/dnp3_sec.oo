// ===================================================================
// openOODA Standard Library — ooda::sec::cps::dnp3_sec
// DNP3 Secure Authentication (DNP3-SA) Module
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. CAP-G6: DNP3 TCP prefers &TcpCap.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

// -------------------------------------------------------------------
// Core DNP3 Types
// -------------------------------------------------------------------

pub type Dnp3Challenge = struct {
    challenge_id: String,
    challenge_bytes: String,
    timestamp: Int,
    sequence_number: Int,
};

pub type Dnp3SessionKey = struct {
    key_id: String,
    update_key: String,
    session_key: String,
    derived_at: Int,
    lifetime_seconds: Int,
    session_index: Int,
    is_active: Bool,
};

pub type Dnp3UserRole = struct {
    role_id: String,
    user_number: Int,
    role_name: String,
    permissions: Int,
    valid_until: Int,
};

pub type Dnp3AuthError = struct {
    error_id: String,
    error_code: Int,
    reason: String,
    timestamp: Int,
    source_addr: String,
};

pub type Dnp3Auth = struct {
    auth_id: String,
    user_number: Int,
    sequence_number: Int,
    hmac: String,
    challenge_response: String,
    timestamp: Int,
    is_valid: Bool,
};

pub type Dnp3Policy = struct {
    policy_id: String,
    require_secure_auth: Bool,
    require_challenge_response: Bool,
    enforce_key_lifetime: Bool,
    allowed_aggressive_mode: Bool,
    fail_closed: Bool,
    is_valid: Bool,
};

pub type Dnp3Engine = struct {
    engine_id: String,
    policy: Dnp3Policy,
    session_keys: List[Dnp3SessionKey],
    user_roles: List[Dnp3UserRole],
    auth_errors: List[Dnp3AuthError],
    challenges_issued: Int,
    auth_failures: Int,
    auth_successes: Int,
    is_halted: Bool,
};

// -------------------------------------------------------------------
// Auth Mode Constants (IEEE 1815-2012)
// -------------------------------------------------------------------

pub fn dnp3_auth_mode_none() -> Int {
    return 0;
}

pub fn dnp3_auth_mode_aggressive() -> Int {
    return 1;
}

pub fn dnp3_auth_mode_normal() -> Int {
    return 2;
}

// -------------------------------------------------------------------
// Error Code Constants (DNP3-SA)
// -------------------------------------------------------------------

pub fn dnp3_err_unknown_user() -> Int {
    return 1;
}

pub fn dnp3_err_session_timeout() -> Int {
    return 2;
}

pub fn dnp3_err_bad_hmac() -> Int {
    return 3;
}

pub fn dnp3_err_sequence_mismatch() -> Int {
    return 4;
}

pub fn dnp3_err_key_expired() -> Int {
    return 5;
}

pub fn dnp3_err_challenge_failed() -> Int {
    return 6;
}

// -------------------------------------------------------------------
// Permission Bit Constants
// -------------------------------------------------------------------

pub fn dnp3_perm_read() -> Int {
    return 1;
}

pub fn dnp3_perm_write() -> Int {
    return 2;
}

pub fn dnp3_perm_select_operate() -> Int {
    return 4;
}

pub fn dnp3_perm_direct_operate() -> Int {
    return 8;
}

pub fn dnp3_perm_config() -> Int {
    return 16;
}

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn dnp3_challenge_new(challenge_id_val: String, bytes_val: String, ts: Int, seq: Int) -> Dnp3Challenge {
    return Dnp3Challenge {
        challenge_id: challenge_id_val,
        challenge_bytes: bytes_val,
        timestamp: ts,
        sequence_number: seq,
    };
}

pub fn dnp3_session_key_create(
    key_id_val: String,
    update_key_val: String,
    lifetime_sec: Int
) -> Dnp3SessionKey {
    return Dnp3SessionKey {
        key_id: key_id_val,
        update_key: update_key_val,
        session_key: "",
        derived_at: 0,
        lifetime_seconds: lifetime_sec,
        session_index: 0,
        is_active: true,
    };
}

pub fn dnp3_user_role_create(user_num: Int, role_name_val: String, perms: Int, valid_until_v: Int) -> Dnp3UserRole {
    return Dnp3UserRole {
        role_id: "dnp3-user-" + int_to_str_basic_dnp3(user_num),
        user_number: user_num,
        role_name: role_name_val,
        permissions: perms,
        valid_until: valid_until_v,
    };
}

pub fn int_to_str_basic_dnp3(value: Int) -> String {
    if value == 0 {
        return "0";
    }
    let digits: String = "0123456789";
    let mut v: Int = value;
    let mut buf: List[Int] = bytes_new();
    while v > 0 {
        let d: Int = v - ((v / 10) * 10);
        let ch: Int = byte_at(digits, d);
        buf = bytes_push(buf, ch);
        let q: Int = v / 10;
        v = q;
    }
    let n: Int = list_len(buf);
    let mut out: List[Int] = bytes_new();
    let mut i: Int = n - 1;
    while i >= 0 {
        let b: Int = list_get(buf, i);
        out = bytes_push(out, b);
        let ni: Int = i - 1;
        i = ni;
    }
    return bytes_to_str(out);
}

pub fn dnp3_auth_create(
    auth_id_val: String,
    user_num: Int,
    seq: Int,
    hmac_val: String,
    chal_resp: String,
    ts: Int
) -> Dnp3Auth {
    return Dnp3Auth {
        auth_id: auth_id_val,
        user_number: user_num,
        sequence_number: seq,
        hmac: hmac_val,
        challenge_response: chal_resp,
        timestamp: ts,
        is_valid: true,
    };
}

pub fn dnp3_policy_default() -> Dnp3Policy {
    return Dnp3Policy {
        policy_id: "DNP3_POLICY_DEFAULT",
        require_secure_auth: true,
        require_challenge_response: true,
        enforce_key_lifetime: true,
        allowed_aggressive_mode: false,
        fail_closed: true,
        is_valid: true,
    };
}

// -------------------------------------------------------------------
// Decision Logic (Pure)
// -------------------------------------------------------------------

pub fn dnp3_has_perm(role: &Dnp3UserRole, perm: Int) -> Bool {
    let p: Int = (role).permissions;
    let anded: Int = p & perm;
    return anded != 0;
}

pub fn dnp3_session_valid(key: &Dnp3SessionKey, now: Int) -> Bool {
    if (key).is_active == false {
        return false;
    }
    let derived: Int = (key).derived_at;
    let lifetime: Int = (key).lifetime_seconds;
    let expires: Int = derived + lifetime;
    if now > expires {
        return false;
    }
    return true;
}

pub fn dnp3_auth_valid(auth: &Dnp3Auth, last_seq: Int) -> Int {
    if (auth).is_valid == false {
        return dnp3_err_challenge_failed();
    }
    let hmac_str: String = (auth).hmac;
    let auth_len: Int = hmac_str.len();
    if auth_len == 0 {
        return dnp3_err_bad_hmac();
    }
    let auth_seq: Int = (auth).sequence_number;
    let diff: Int = auth_seq - last_seq;
    if diff <= 0 {
        return dnp3_err_sequence_mismatch();
    }
    return 0;
}

pub fn dnp3_should_accept_critical(policy: &Dnp3Policy, op_code: Int) -> Bool {
    if (policy).require_secure_auth == false {
        return true;
    }
    let is_select = op_code == 3;
    let is_direct_op = op_code == 5;
    let is_dir_op_nr = op_code == 6;
    if is_select {
        return true;
    }
    if is_direct_op {
        if (policy).allowed_aggressive_mode {
            return true;
        }
        return false;
    }
    if is_dir_op_nr {
        return true;
    }
    return true;
}

// -------------------------------------------------------------------
// Engine (Pure)
// -------------------------------------------------------------------

pub fn dnp3_engine_init(engine_id_val: String) -> Dnp3Engine {
    return Dnp3Engine {
        engine_id: engine_id_val,
        policy: dnp3_policy_default(),
        session_keys: list_new(),
        user_roles: list_new(),
        auth_errors: list_new(),
        challenges_issued: 0,
        auth_failures: 0,
        auth_successes: 0,
        is_halted: false,
    };
}

pub fn dnp3_engine_add_user_role(engine: &mut Dnp3Engine, r: Dnp3UserRole) {
    let mut eng = engine;
    let old = eng.user_roles;
    let mut updated: List[Dnp3UserRole] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, r);
    eng.user_roles = updated;
}

pub fn dnp3_engine_record_auth(engine: &mut Dnp3Engine, ok: Bool) {
    let mut eng = engine;
    let inc_one: Int = 1;
    if ok {
        let cur: Int = eng.auth_successes;
        eng.auth_successes = cur + inc_one;
    } else {
        let cur: Int = eng.auth_failures;
        eng.auth_failures = cur + inc_one;
    }
}

pub fn dnp3_engine_record_error(engine: &mut Dnp3Engine, e: Dnp3AuthError) {
    let mut eng = engine;
    let old = eng.auth_errors;
    let mut updated: List[Dnp3AuthError] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, e);
    eng.auth_errors = updated;
}

pub fn dnp3_engine_do_work(engine: &Dnp3Engine) -> Int {
    let u = list_len((engine).user_roles);
    let e = list_len((engine).auth_errors);
    return (engine).auth_successes + (engine).auth_failures + u + e;
}

