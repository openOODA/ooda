    // COMPILER LIMITATION: openOODA lacks DNP3 outstation/master TCP 20000 socket FFI.
    // CAP-G6: TCP-ish path prefers &TcpCap (NetCap supersede remains valid at sealed layer).
    process_exit(1);
    return Err("Unimplemented: DNP3 TCP outstation socket requires TcpCap+TCP FFI lowering");
}

pub fn dnp3_issue_challenge(tcp: &TcpCap, fd: Int) -> Result[Dnp3Challenge, String] {
    // COMPILER LIMITATION: openOODA lacks DNP3 g120v2 challenge object fragment FFI.
    // CAP-G6: challenge rides an already-open DNP3 TCP session — &TcpCap.
    process_exit(1);
    return Err("Unimplemented: DNP3 challenge issue requires TcpCap+DNP3 object FFI lowering");
}

