// # ESD Constructors
//
// Logline: Construct EsdTest, EsdVoltage presets, EsdDevice, EsdEnvironment, EsdPolicy and validate the policy.
//
// Setup: Default passed/air/contact flags false, device installed/healthy true, env humidity 40% temperature 22.0C, policy fail_closed.
//
// Beats:
//   1. esd_test_new.
//   2. esd_voltage_iec_8kv_contact / esd_voltage_iec_15kv_air.
//   3. esd_device_create.
//   4. esd_environment_default.
//   5. esd_policy_default and esd_policy_validate.

import "./esd_types.oo";
import "./esd_constants.oo";

pub fn esd_test_new(
    test_id_val: String,
    test_type_val: Int,
    voltage_v: Int,
    pulse_count_v: Int
) -> EsdTest {
    return EsdTest {
        test_id: test_id_val,
        test_type: test_type_val,
        voltage_v: voltage_v,
        pulse_count: pulse_count_v,
        contact_discharge: false,
        air_discharge: false,
        passed: false,
        timestamp: 0
    };
}

pub fn esd_voltage_iec_8kv_contact() -> EsdVoltage {
    return EsdVoltage {
        voltage_id: "IEC_8KV_CONTACT",
        voltage_kv_x10: 80,
        polarity: esd_polarity_positive(),
        rise_time_ps: 1000,
        decay_time_ns: 30,
        peak_current_a_x100: 3000
    };
}

pub fn esd_voltage_iec_15kv_air() -> EsdVoltage {
    return EsdVoltage {
        voltage_id: "IEC_15KV_AIR",
        voltage_kv_x10: 150,
        polarity: esd_polarity_positive(),
        rise_time_ps: 5000,
        decay_time_ns: 30,
        peak_current_a_x100: 5000
    };
}

pub fn esd_device_create(
    device_id_val: String,
    device_type_val: Int,
    rated_v: Int,
    clamping_v: Int
) -> EsdDevice {
    return EsdDevice {
        device_id: device_id_val,
        device_type: device_type_val,
        rated_voltage_v: rated_v,
        clamping_voltage_v: clamping_v,
        capacitance_pf: 0,
        response_time_ns: 0,
        installed: true,
        healthy: true
    };
}

pub fn esd_environment_default() -> EsdEnvironment {
    return EsdEnvironment {
        env_id: "ESD_ENV_DEFAULT",
        humidity_pct: 40,
        temperature_c_x10: 220,
        floor_conductive: true,
        wrist_strap_required: true,
        ionization_active: true,
        esd_floor_ohms: 1000000
    };
}

pub fn esd_policy_default() -> EsdPolicy {
    return EsdPolicy {
        policy_id: "ESD_POLICY_DEFAULT",
        max_contact_kv: 8,
        max_air_kv: 15,
        require_wrist_strap: true,
        require_ionizer: true,
        fail_closed: true,
        is_valid: true
    };
}

pub fn esd_policy_validate(p: &EsdPolicy) -> Result[Bool, String] {
    if (p).max_contact_kv < 0 {
        return Err("ESDError: max_contact_kv cannot be negative");
    }
    if (p).max_air_kv < 0 {
        return Err("ESDError: max_air_kv cannot be negative");
    }
    if (p).max_air_kv < (p).max_contact_kv {
        return Err("ESDError: max_air_kv should be >= max_contact_kv");
    }
    return Ok(true);
}
