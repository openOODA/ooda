// # SecOC Engine (Pure)
//
// Logline: Engine constructor, key list append, freshness counter advance, verified/rejected accounting, do_work accounting.
//
// Setup: Uses list_new / list_push / list_len / list_get for the keys list.
//
// Beats:
//   1. secoc_engine_init: bind profile, default freshness, empty keys.
//   2. secoc_engine_add_key: append to keys list.
//   3. secoc_engine_advance_freshness: replace counter.
//   4. secoc_engine_record_verify: bump verified or rejected.
//   5. secoc_engine_do_work: return verified + rejected + key count.

import "./secoc_types.oo";
import "./secoc_construct.oo";

pub fn secoc_engine_init(engine_id_val: String, p: SecOcProfile) -> SecOcEngine {
    let fresh = secoc_freshness_new("fresh-default", 0, 0, 0);
    return SecOcEngine {
        engine_id: engine_id_val,
        profile: p,
        keys: list_new(),
        freshness: fresh,
        verified: 0,
        rejected: 0,
        is_halted: false,
    };
}

pub fn secoc_engine_add_key(engine: &mut SecOcEngine, k: SecOcKey) {
    let mut eng = engine;
    let old = eng.keys;
    let mut updated: List[SecOcKey] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, k);
    eng.keys = updated;
}

pub fn secoc_engine_advance_freshness(engine: &mut SecOcEngine, new_counter: Int) {
    let mut eng = engine;
    eng.freshness.counter = new_counter;
}

pub fn secoc_engine_record_verify(engine: &mut SecOcEngine, ok: Bool) {
    let mut eng = engine;
    let inc_one: Int = 1;
    if ok {
        let cur: Int = eng.verified;
        eng.verified = cur + inc_one;
    } else {
        let cur: Int = eng.rejected;
        eng.rejected = cur + inc_one;
    }
}

pub fn secoc_engine_do_work(engine: &SecOcEngine) -> Int {
    let k = list_len((engine).keys);
    return (engine).verified + (engine).rejected + k;
}
