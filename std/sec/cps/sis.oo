// ===================================================================
// openOODA Standard Library — ooda::sec::cps::sis
// Safety Instrumented System (SIS) Module
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. CAP-G6: SIS TCP paths prefer &TcpCap.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

// -------------------------------------------------------------------
// Core SIS Types
// -------------------------------------------------------------------

pub type SisFunction = struct {
    function_id: String,
    name: String,
    sil_target: Int,
    sensor_count: Int,
    logic_solver_id: String,
    final_element_count: Int,
    bypass_allowed: Bool,
    bypass_active: Bool,
};

pub type SisSensor = struct {
    sensor_id: String,
    function_id: String,
    sensor_type: String,
    tag_name: String,
    healthy: Bool,
    bypassed: Bool,
    last_test_ts: Int,
    proof_test_due_ts: Int,
};

pub type SisFinalElement = struct {
    element_id: String,
    function_id: String,
    element_type: String,
    tag_name: String,
    actuated_state: Int,
    target_state: Int,
    healthy: Bool,
    bypassed: Bool,
};

pub type SisLogicSolver = struct {
    solver_id: String,
    name: String,
    vendor: String,
    model: String,
    firmware: String,
    sil_capable: Int,
    redundant: Bool,
    healthy: Bool,
};

pub type SisEvent = struct {
    event_id: String,
    function_id: String,
    event_type: Int,
    timestamp: Int,
    description: String,
};

pub type SisEngine = struct {
    engine_id: String,
    functions: List[SisFunction],
    sensors: List[SisSensor],
    final_elements: List[SisFinalElement],
    logic_solvers: List[SisLogicSolver],
    events: List[SisEvent],
    total_events: Int,
    shutdown_count: Int,
    is_halted: Bool,
};

// -------------------------------------------------------------------
// Event Type Constants
// -------------------------------------------------------------------

pub fn sis_event_demand() -> Int {
    return 1;
}

pub fn sis_event_proof_test() -> Int {
    return 2;
}

pub fn sis_event_bypass_on() -> Int {
    return 3;
}

pub fn sis_event_bypass_off() -> Int {
    return 4;
}

pub fn sis_event_sensor_fault() -> Int {
    return 5;
}

pub fn sis_event_shutdown() -> Int {
    return 6;
}

pub fn sis_event_partial_stroke() -> Int {
    return 7;
}

pub fn sis_event_false_trip() -> Int {
    return 8;
}

// -------------------------------------------------------------------
// Actuated State Constants
// -------------------------------------------------------------------

pub fn sis_state_unknown() -> Int {
    return 0;
}

pub fn sis_state_open() -> Int {
    return 1;
}

pub fn sis_state_closed() -> Int {
    return 2;
}

pub fn sis_state_moving() -> Int {
    return 3;
}

pub fn sis_state_stuck() -> Int {
    return 4;
}

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn sis_function_create(
    function_id_val: String,
    name_val: String,
    sil_target_val: Int,
    sensor_count_val: Int,
    solver_id_val: String,
    fe_count_val: Int
) -> SisFunction {
    return SisFunction {
        function_id: function_id_val,
        name: name_val,
        sil_target: sil_target_val,
        sensor_count: sensor_count_val,
        logic_solver_id: solver_id_val,
        final_element_count: fe_count_val,
        bypass_allowed: false,
        bypass_active: false,
    };
}

pub fn sis_sensor_create(
    sensor_id_val: String,
    function_id_val: String,
    sensor_type_val: String,
    tag_val: String
) -> SisSensor {
    return SisSensor {
        sensor_id: sensor_id_val,
        function_id: function_id_val,
        sensor_type: sensor_type_val,
        tag_name: tag_val,
        healthy: true,
        bypassed: false,
        last_test_ts: 0,
        proof_test_due_ts: 0,
    };
}

pub fn sis_final_element_create(
    element_id_val: String,
    function_id_val: String,
    element_type_val: String,
    tag_val: String
) -> SisFinalElement {
    return SisFinalElement {
        element_id: element_id_val,
        function_id: function_id_val,
        element_type: element_type_val,
        tag_name: tag_val,
        actuated_state: sis_state_unknown(),
        target_state: sis_state_closed(),
        healthy: true,
        bypassed: false,
    };
}

pub fn sis_logic_solver_create(
    solver_id_val: String,
    name_val: String,
    vendor_val: String,
    model_val: String,
    sil_capable_val: Int
) -> SisLogicSolver {
    return SisLogicSolver {
        solver_id: solver_id_val,
        name: name_val,
        vendor: vendor_val,
        model: model_val,
        firmware: "",
        sil_capable: sil_capable_val,
        redundant: false,
        healthy: true,
    };
}

// -------------------------------------------------------------------
// Decision Logic (Pure)
// -------------------------------------------------------------------

pub fn sis_should_shutdown(function: &SisFunction, sensors: &List[SisSensor]) -> Bool {
    if (function).bypass_active == true {
        return false;
    }
    let n: Int = list_len(sensors);
    let mut any_demanding = false;
    let mut i = 0;
    while i < n {
        let s = list_get(sensors, i);
        let s_fid: String = s.function_id;
        let f_fid: String = (function).function_id;
        if s_fid == f_fid {
            if s.bypassed == false {
                if s.healthy == false {
                    any_demanding = true;
                }
            }
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return any_demanding;
}

pub fn sis_count_healthy_sensors(function: &SisFunction, sensors: &List[SisSensor]) -> Int {
    let n: Int = list_len(sensors);
    let mut count: Int = 0;
    let mut i = 0;
    let inc_one: Int = 1;
    while i < n {
        let s = list_get(sensors, i);
        let s_fid: String = s.function_id;
        let f_fid: String = (function).function_id;
        if s_fid == f_fid {
            if s.healthy == true {
                let cv: Int = count;
                count = cv + inc_one;
            }
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return count;
}

pub fn sis_count_bypassed(function: &SisFunction, sensors: &List[SisSensor]) -> Int {
    let n: Int = list_len(sensors);
    let mut count: Int = 0;
    let mut i = 0;
    let inc_one: Int = 1;
    while i < n {
        let s = list_get(sensors, i);
        let s_fid: String = s.function_id;
        let f_fid: String = (function).function_id;
        if s_fid == f_fid {
            if s.bypassed == true {
                let cv: Int = count;
                count = cv + inc_one;
            }
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return count;
}

pub fn sis_should_allow_bypass(function: &SisFunction, key: String) -> Bool {
    if (function).bypass_allowed == false {
        return false;
    }
    let need_key: String = "BYPASS_KEY";
    if key == need_key {
        return true;
    }
    return false;
}

// -------------------------------------------------------------------
// Engine (Pure)
// -------------------------------------------------------------------

pub fn sis_engine_init(engine_id_val: String) -> SisEngine {
    return SisEngine {
        engine_id: engine_id_val,
        functions: list_new(),
        sensors: list_new(),
        final_elements: list_new(),
        logic_solvers: list_new(),
        events: list_new(),
        total_events: 0,
        shutdown_count: 0,
        is_halted: false,
    };
}

pub fn sis_engine_add_function(engine: &mut SisEngine, f: SisFunction) {
    let mut eng = engine;
    let old = eng.functions;
    let mut updated: List[SisFunction] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, f);
    eng.functions = updated;
}

pub fn sis_engine_record_event(engine: &mut SisEngine, e: SisEvent) {
    let mut eng = engine;
    let old = eng.events;
    let mut updated: List[SisEvent] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, e);
    eng.events = updated;
    let old_t: Int = eng.total_events;
    let inc_one: Int = 1;
    eng.total_events = old_t + inc_one;
    if e.event_type == sis_event_shutdown() {
        let cur_s: Int = eng.shutdown_count;
        eng.shutdown_count = cur_s + inc_one;
    }
}

pub fn sis_engine_do_work(engine: &SisEngine) -> Int {
    let f_n = list_len((engine).functions);
    let s_n = list_len((engine).sensors);
    let fe_n = list_len((engine).final_elements);
    return f_n + s_n + fe_n;
}

// -------------------------------------------------------------------
// Fail-Closed PLC Stubs
// -------------------------------------------------------------------

pub fn sis_modbus_read_coil(tcp: &TcpCap, addr: Int, coil: Int) -> Result[Bool, String] {
    // COMPILER LIMITATION: openOODA lacks Modbus TCP client FFI for reading safety coil from PLC.
    // CAP-G6: SIS Modbus TCP path prefers &TcpCap.
    process_exit(1);
    return Err("Unimplemented: Modbus TCP read requires TcpCap+Modbus FFI lowering");
}

pub fn sis_write_shutdown_command(tcp: &TcpCap, function_id_val: String) -> Result[Bool, String] {
    // COMPILER LIMITATION: openOODA lacks SIS shutdown command write (OPC UA / Modbus / ProfiSafe) FFI.
    // CAP-G6: TCP-ish PLC command path prefers &TcpCap (multi-protocol residual honesty).
    process_exit(1);
    return Err("Unimplemented: SIS shutdown write requires TcpCap+PLC protocol FFI lowering");
}