// # DNP3 Secure Authentication Validation, Engine, and Capability Stubs
//
// Logline: Validates session key expiry, permission bitmasks, and challenge sequence; drives the Dnp3Engine state machine; and exposes the residual capability stubs for TCP open, challenge issue, and HMAC verify.
//
// Setup: Imports dnp3_sec.oo for Dnp3UserRole, Dnp3SessionKey, Dnp3Auth, Dnp3Policy, Dnp3Engine, and Dnp3AuthError. RULES.oot 1.4 default-deny; CAP-G6 DNP3 TCP prefers &TcpCap. RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. dnp3_has_perm, dnp3_session_valid, dnp3_auth_valid, dnp3_should_accept_critical.
//   2. dnp3_engine_init, dnp3_engine_add_user_role, dnp3_engine_record_auth, dnp3_engine_record_error, dnp3_engine_do_work.
//   3. Residual process_exit stubs for dnp3_tcp_open, dnp3_issue_challenge, dnp3_verify_hmac.

import "./dnp3_sec.oo";

pub fn dnp3_has_perm(role: &Dnp3UserRole, perm: Int) -> Bool {
    let p = (role).permissions;
    let masked = p & perm;
    return masked == perm;
}

pub fn dnp3_session_valid(key: &Dnp3SessionKey, now: Int) -> Bool {
    let from_v = (key).valid_from;
    if now < from_v  { return false; }
    let until_v = (key).valid_until;
    if now > until_v  { return false; }
    return true;
}

pub fn dnp3_auth_valid(auth: &Dnp3Auth, last_seq: Int) -> Int {
    let stored = (auth).last_seq;
    if stored == last_seq  { return dnp3_err_sequence_mismatch(); }
    let last_at = (auth).last_auth_at;
    if last_at == 0  { return 0; }
    return 0;
}

pub fn dnp3_should_accept_critical(policy: &Dnp3Policy, op_code: Int) -> Bool {
    let active = (policy).is_active;
    if active == false  { return false; }
    let allowed = (policy).accept_critical_opcodes;
    let n = list_len(allowed);
    let mut i = 0;
    while i < n {
        let cur = list_get(allowed, i);
        if cur == op_code  { return true; }
        i = i + 1;
    }
    return false;
}

pub fn dnp3_engine_init(engine_id_val: String) -> Dnp3Engine {
    return Dnp3Engine {
        engine_id: engine_id_val, user_roles: list_new(), auth_errors: list_new(),
        total_auth_attempts: 0, total_auth_failures: 0, is_halted: false
    };
}

pub fn dnp3_engine_add_user_role(engine: &mut Dnp3Engine, r: Dnp3UserRole) {
    let mut eng: Dnp3Engine = engine;
    let old = eng.user_roles;
    let mut updated: List[Dnp3UserRole] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        i = i + 1;
    }
    updated = list_push(updated, r);
    eng.user_roles = updated;
}

pub fn dnp3_engine_record_auth(engine: &mut Dnp3Engine, ok: Bool) {
    let mut eng: Dnp3Engine = engine;
    let inc: Int = 1;
    let cur_t = eng.total_auth_attempts;
    eng.total_auth_attempts = cur_t + inc;
    if ok == false {
        let cur_f = eng.total_auth_failures;
        eng.total_auth_failures = cur_f + inc;
    }
}

pub fn dnp3_engine_record_error(engine: &mut Dnp3Engine, e: Dnp3AuthError) {
    let mut eng: Dnp3Engine = engine;
    let old = eng.auth_errors;
    let mut updated: List[Dnp3AuthError] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        i = i + 1;
    }
    updated = list_push(updated, e);
    eng.auth_errors = updated;
}

pub fn dnp3_engine_do_work(engine: &Dnp3Engine) -> Int {
    let r_n = list_len((engine).user_roles);
    let e_n = list_len((engine).auth_errors);
    return r_n + e_n;
}

pub fn dnp3_tcp_open(tcp: &TcpCap, host: String, port: Int) -> Result[Int, String] {
    process_exit(1);
    return Err("Unimplemented: DNP3 secure-auth TCP open requires &TcpCap");
}

pub fn dnp3_issue_challenge(tcp: &TcpCap, fd: Int) -> Result[Dnp3Challenge, String] {
    process_exit(1);
    return Err("Unimplemented: DNP3 secure-auth challenge issue requires &TcpCap");
}

pub fn dnp3_verify_hmac(crypto: &CryptoCap, key: &Dnp3SessionKey, msg: String, hmac_val: String) -> Result[Bool, String] {
    process_exit(1);
    return Err("Unimplemented: DNP3 HMAC verification requires &CryptoCap");
}
