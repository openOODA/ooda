// ===================================================================
// openOODA Standard Library — ooda::sec::cps::bft
// Byzantine Fault Tolerance Consensus Module
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. CAP-G6: prepare fan-out prefers &TcpCap.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

// -------------------------------------------------------------------
// Core BFT Types
// -------------------------------------------------------------------

pub type BftNode = struct {
    node_id: String,
    address: String,
    pub_key: String,
    is_byzantine: Bool,
    is_active: Bool,
    last_seen_ts: Int,
};

pub type BftMessage = struct {
    msg_id: String,
    view: Int,
    seq: Int,
    sender_id: String,
    msg_type: Int,
    payload: String,
    digest: String,
    signature: String,
    timestamp: Int,
};

pub type BftPrepare = struct {
    prepare_id: String,
    view: Int,
    seq: Int,
    digest: String,
    node_id: String,
};

pub type BftCommit = struct {
    commit_id: String,
    view: Int,
    seq: Int,
    digest: String,
    node_id: String,
};

pub type BftCertificate = struct {
    cert_id: String,
    view: Int,
    seq: Int,
    digest: String,
    prepares: List[BftPrepare],
    commits: List[BftCommit],
    quorum_size: Int,
    is_valid: Bool,
};

pub type BftPolicy = struct {
    policy_id: String,
    required_quorum: Int,
    max_byzantine: Int,
    enable_view_change: Bool,
    require_signature: Bool,
    fail_closed: Bool,
    is_valid: Bool,
};

pub type BftEngine = struct {
    engine_id: String,
    policy: BftPolicy,
    nodes: List[BftNode],
    total_nodes: Int,
    byzantine_count: Int,
    committed: Int,
    rejected: Int,
    is_halted: Bool,
};

// -------------------------------------------------------------------
// Message Type Constants
// -------------------------------------------------------------------

pub fn bft_msg_pre_prepare() -> Int {
    return 1;
}

pub fn bft_msg_prepare() -> Int {
    return 2;
}

pub fn bft_msg_commit() -> Int {
    return 3;
}

pub fn bft_msg_view_change() -> Int {
    return 4;
}

pub fn bft_msg_new_view() -> Int {
    return 5;
}

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn bft_node_create(
    node_id_val: String,
    addr_val: String,
    pub_key_val: String,
    is_byz: Bool
) -> BftNode {
    return BftNode {
        node_id: node_id_val,
        address: addr_val,
        pub_key: pub_key_val,
        is_byzantine: is_byz,
        is_active: true,
        last_seen_ts: 0,
    };
}

pub fn bft_message_new(
    msg_id_val: String,
    view_v: Int,
    seq_v: Int,
    sender_id_val: String,
    msg_type_v: Int,
    payload_val: String
) -> BftMessage {
    return BftMessage {
        msg_id: msg_id_val,
        view: view_v,
        seq: seq_v,
        sender_id: sender_id_val,
        msg_type: msg_type_v,
        payload: payload_val,
        digest: "",
        signature: "",
        timestamp: 0,
    };
}

pub fn bft_prepare_new(prepare_id_val: String, view_v: Int, seq_v: Int, digest_val: String, node_id_val: String) -> BftPrepare {
    return BftPrepare {
        prepare_id: prepare_id_val,
        view: view_v,
        seq: seq_v,
        digest: digest_val,
        node_id: node_id_val,
    };
}

pub fn bft_commit_new(commit_id_val: String, view_v: Int, seq_v: Int, digest_val: String, node_id_val: String) -> BftCommit {
    return BftCommit {
        commit_id: commit_id_val,
        view: view_v,
        seq: seq_v,
        digest: digest_val,
        node_id: node_id_val,
    };
}

pub fn bft_policy_default() -> BftPolicy {
    return BftPolicy {
        policy_id: "BFT_POLICY_DEFAULT",
        required_quorum: 3,
        max_byzantine: 1,
        enable_view_change: true,
        require_signature: true,
        fail_closed: true,
        is_valid: true,
    };
}

pub fn bft_policy_validate(p: &BftPolicy) -> Result[Bool, String] {
    if (p).required_quorum < 1 {
        return Err("BFTErrror: required_quorum must be positive");
    }
    if (p).max_byzantine < 0 {
        return Err("BFTErrror: max_byzantine cannot be negative");
    }
    return Ok(true);
}

// -------------------------------------------------------------------
// Quorum Computation (Pure)
// -------------------------------------------------------------------

pub fn bft_quorum_size(n: Int, f: Int) -> Int {
    let two_f: Int = f + f;
    let two_f_plus_one: Int = two_f + 1;
    return two_f_plus_one;
}

pub fn bft_can_tolerate(n: Int, f: Int) -> Bool {
    let need: Int = 3 * f;
    let cur: Int = n;
    if cur < need {
        return false;
    }
    return true;
}

pub fn bft_prepare_quorum_reached(prepares: &List[BftPrepare], required: Int) -> Bool {
    let n: Int = list_len(prepares);
    if n >= required {
        return true;
    }
    return false;
}

pub fn bft_commit_quorum_reached(commits: &List[BftCommit], required: Int) -> Bool {
    let n: Int = list_len(commits);
    if n >= required {
        return true;
    }
    return false;
}

pub fn bft_check_view_consistency(messages: &List[BftMessage], view_v: Int) -> Bool {
    let n: Int = list_len(messages);
    let mut i = 0;
    while i < n {
        let m = list_get(messages, i);
        let mv: Int = m.view;
        if mv != view_v {
            return false;
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return true;
}

// -------------------------------------------------------------------
// Engine (Pure)
// -------------------------------------------------------------------

pub fn bft_engine_init(engine_id_val: String) -> BftEngine {
    return BftEngine {
        engine_id: engine_id_val,
        policy: bft_policy_default(),
        nodes: list_new(),
        total_nodes: 0,
        byzantine_count: 0,
        committed: 0,
        rejected: 0,
        is_halted: false,
    };
}

pub fn bft_engine_add_node(engine: &mut BftEngine, new_node: BftNode) {
    let mut eng = engine;
    let old = eng.nodes;
    let mut updated: List[BftNode] = list_new();
    let cnt = list_len(old);
    let mut i = 0;
    while i < cnt {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, new_node);
    eng.nodes = updated;
    let inc_one: Int = 1;
    let cur_t: Int = eng.total_nodes;
    eng.total_nodes = cur_t + inc_one;
    let is_byz: Bool = new_node.is_byzantine;
    if is_byz {
        let cur_b: Int = eng.byzantine_count;
        eng.byzantine_count = cur_b + inc_one;
    }
}

pub fn bft_engine_record_outcome(engine: &mut BftEngine, committed_v: Bool) {
    let mut eng = engine;
    let inc_one: Int = 1;
    if committed_v {
        let cur: Int = eng.committed;
        eng.committed = cur + inc_one;
    } else {
        let cur: Int = eng.rejected;
        eng.rejected = cur + inc_one;
    }
}

pub fn bft_engine_do_work(engine: &BftEngine) -> Int {
    let n = list_len((engine).nodes);
    return (engine).committed + (engine).rejected + n;
}

// -------------------------------------------------------------------
// Fail-Closed Network Stubs
// -------------------------------------------------------------------

pub fn bft_broadcast_prepare(tcp: &TcpCap, p: &BftPrepare) -> Result[Bool, String] {
    // COMPILER LIMITATION: openOODA lacks signed replica fan-out FFI for PBFT prepare phase.
    // CAP-G6: prefer &TcpCap for point-to-point replica mesh (typical PBFT). True multiprotocol
    // UDP/IP broadcast remains residual honesty (no SoftGranular broadcast token).
    process_exit(1);
    return Err("Unimplemented: BFT prepare broadcast requires TcpCap replica mesh + CryptoCap FFI lowering");
}

pub fn bft_verify_signature(crypto: &CryptoCap, m: &BftMessage) -> Result[Bool, String] {
    // COMPILER LIMITATION: openOODA lacks BFT message Ed25519/ECDSA signature verify FFI.
    process_exit(1);
    return Err("Unimplemented: BFT message signature verify requires CryptoCap FFI lowering");
}