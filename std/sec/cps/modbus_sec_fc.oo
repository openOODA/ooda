// # Modbus Function Code & Violation Type Constants
//
// Logline: Modbus spec function codes (read coils/discrete/holding/input, write single/multi coil/register, diag, report slave id) and violation IDs.
//
// Setup: FC 1/2/3/4 read-only; 5/6/15/16 writes; 8 diag; 17 report slave id. Violations 1=write_unauth, 2=diag_unauth, 3=rate_limit, 4=invalid_frame.
//
// Beats:
//   1. Function code IDs.
//   2. Violation type IDs.

pub fn modbus_fc_read_coils() -> Int {
    return 1;
}

pub fn modbus_fc_read_discrete_inputs() -> Int {
    return 2;
}

pub fn modbus_fc_read_holding_registers() -> Int {
    return 3;
}

pub fn modbus_fc_read_input_registers() -> Int {
    return 4;
}

pub fn modbus_fc_write_single_coil() -> Int {
    return 5;
}

pub fn modbus_fc_write_single_register() -> Int {
    return 6;
}

pub fn modbus_fc_write_multiple_coils() -> Int {
    return 15;
}

pub fn modbus_fc_write_multiple_registers() -> Int {
    return 16;
}

pub fn modbus_fc_diag() -> Int {
    return 8;
}

pub fn modbus_fc_report_slave_id() -> Int {
    return 17;
}

pub fn modbus_violation_write_unauth() -> Int {
    return 1;
}

pub fn modbus_violation_diag_unauth() -> Int {
    return 2;
}

pub fn modbus_violation_rate_limit() -> Int {
    return 3;
}

pub fn modbus_violation_invalid_frame() -> Int {
    return 4;
}
