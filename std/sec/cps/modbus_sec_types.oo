// # Modbus Security Data Types
//
// Logline: ModbusFrame, ModbusFunction, ModbusPolicy, ModbusSession, ModbusViolation, ModbusEngine struct definitions.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. Define the six Modbus security carriers.

pub type ModbusFrame = struct {
    frame_id: String,
    transaction_id: Int,
    protocol_id: Int,
    unit_id: Int,
    function_code: Int,
    pdu: String,
    timestamp: Int,
    is_valid: Bool
};

pub type ModbusFunction = struct {
    function_id: String,
    code: Int,
    name: String,
    is_dangerous: Bool,
    requires_authorization: Bool,
    description: String
};

pub type ModbusPolicy = struct {
    policy_id: String,
    allow_read_only: Bool,
    allow_write_coils: Bool,
    allow_write_holding: Bool,
    allow_diag_funcs: Bool,
    rate_limit_per_sec: Int,
    require_authorization: Bool,
    fail_closed: Bool,
    is_valid: Bool
};

pub type ModbusSession = struct {
    session_id: String,
    peer_addr: String,
    peer_port: Int,
    unit_id: Int,
    authenticated: Bool,
    authorized_for_writes: Bool,
    request_count: Int,
    start_ts: Int
};

pub type ModbusViolation = struct {
    violation_id: String,
    violation_type: Int,
    function_code: Int,
    source_addr: String,
    timestamp: Int,
    description: String
};

pub type ModbusEngine = struct {
    engine_id: String,
    policy: ModbusPolicy,
    sessions: List[ModbusSession],
    violations: List[ModbusViolation],
    requests_total: Int,
    requests_allowed: Int,
    requests_denied: Int,
    is_halted: Bool
};
