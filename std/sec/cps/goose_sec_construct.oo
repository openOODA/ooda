// # GOOSE Constructors
//
// Logline: Construct GooseFrame, GooseSignature, GooseKey, GooseSubscription, and GoosePolicy from primitives.
//
// Setup: Default dat_set empty, conf_rev 0, nds_com false, simulation false, is_valid true.
//
// Beats:
//   1. goose_frame_new.
//   2. goose_signature_new.
//   3. goose_key_create.
//   4. goose_subscription_new.
//   5. goose_policy_default: require_signature, require_test_false_in_prod, max_sq_num_gap=10, fail_closed.

import "./goose_sec_types.oo";

pub fn goose_frame_new(
    frame_id_val: String,
    gocb_ref_val: String,
    go_id_val: String,
    test_v: Bool,
    st_num_v: Int,
    sq_num_v: Int,
    payload_v: String,
    ts_us: Int
) -> GooseFrame {
    return GooseFrame {
        frame_id: frame_id_val,
        gocb_ref: gocb_ref_val,
        dat_set: "",
        go_id: go_id_val,
        test: test_v,
        conf_rev: 0,
        nds_com: false,
        st_num: st_num_v,
        sq_num: sq_num_v,
        simulation: false,
        payload: payload_v,
        timestamp_us: ts_us,
        is_valid: true,
    };
}

pub fn goose_signature_new(
    sig_id_val: String,
    go_id_val: String,
    st_num_v: Int,
    sq_num_v: Int,
    signer_cert_val: String,
    sig_bytes_val: String,
    algo_val: String
) -> GooseSignature {
    return GooseSignature {
        sig_id: sig_id_val,
        go_id: go_id_val,
        st_num: st_num_v,
        sq_num: sq_num_v,
        timestamp_us: 0,
        signer_cert: signer_cert_val,
        signature_bytes: sig_bytes_val,
        algorithm: algo_val,
    };
}

pub fn goose_key_create(
    key_id_val: String,
    algo_val: String,
    fingerprint_val: String,
    is_mc: Bool,
    valid_until_v: Int
) -> GooseKey {
    return GooseKey {
        key_id: key_id_val,
        name: "",
        algorithm: algo_val,
        fingerprint: fingerprint_val,
        is_multicast_key: is_mc,
        valid_until: valid_until_v,
    };
}

pub fn goose_subscription_new(
    sub_id_val: String,
    gocb_ref_val: String,
    max_gap: Int
) -> GooseSubscription {
    return GooseSubscription {
        sub_id: sub_id_val,
        gocb_ref: gocb_ref_val,
        dat_set: "",
        min_st_num: 0,
        max_sq_num_gap: max_gap,
        allowed_signers: list_new(),
        enabled: true,
    };
}

pub fn goose_policy_default() -> GoosePolicy {
    return GoosePolicy {
        policy_id: "GOOSE_POLICY_DEFAULT",
        require_signature: true,
        require_test_false_in_prod: true,
        max_sq_num_gap: 10,
        allowed_signers_required: true,
        fail_closed: true,
        is_valid: true,
    };
}
