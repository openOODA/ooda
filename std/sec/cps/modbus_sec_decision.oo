// # Modbus Pure Decision Logic
//
// Logline: modbus_should_allow gates read-only / diag / write operations against policy and session authorization.
//
// Setup: Pure function; no IO, no CAPs. Uses modbus_is_read_only, modbus_is_write_coil, modbus_is_write_register, modbus_fc_diag.
//
// Beats:
//   1. Read-only: gate on policy.allow_read_only.
//   2. Diag: gate on policy.allow_diag_funcs and require_authorization (session.authenticated).
//   3. Write: gate on policy.allow_write_coils or allow_write_holding; require_authorization with auth + authorized_for_writes.

import "./modbus_sec_types.oo";
import "./modbus_sec_fc.oo";
import "./modbus_sec_classify.oo";

pub fn modbus_should_allow(policy: &ModbusPolicy, session: &ModbusSession, fc: Int) -> Bool {
    let read_only_v = modbus_is_read_only(fc);
    if read_only_v {
        if (policy).allow_read_only == false {
            return false;
        }
        return true;
    }
    let is_diag = fc == modbus_fc_diag();
    if is_diag {
        if (policy).allow_diag_funcs == false {
            return false;
        }
        if (policy).require_authorization {
            if (session).authenticated == false {
                return false;
            }
        }
        return true;
    }
    let is_write = modbus_is_write_coil(fc) || modbus_is_write_register(fc);
    if is_write {
        let is_coil = modbus_is_write_coil(fc);
        if is_coil {
            if (policy).allow_write_coils == false {
                return false;
            }
        } else {
            if (policy).allow_write_holding == false {
                return false;
            }
        }
        if (policy).require_authorization {
            if (session).authenticated == false {
                return false;
            }
            if (session).authorized_for_writes == false {
                return false;
            }
        }
        return true;
    }
    return false;
}
