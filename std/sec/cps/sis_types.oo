// # Safety Instrumented Systems (SIS) Types
//
// Logline: Define SisSensor, SisLogicSolver, and SisActuator models.
//
// Setup: Core data types and structured models.
//
// Beats:
//   1. Declare SIS sensor input configurations.
//   2. Declare 1oo2/2oo3 voting logic solver models.
//   3. Declare final element actuator metrics.

pub type SisFunction = struct {
    function_id: String, name: String, sil_target: Int, sensor_count: Int,
    logic_solver_id: String, final_element_count: Int, bypass_allowed: Bool,
    bypass_active: Bool
};
pub type SisSensor = struct {
    sensor_id: String, function_id: String, sensor_type: String,
    tag_name: String, healthy: Bool, bypassed: Bool, last_test_ts: Int,
    proof_test_due_ts: Int
};
pub type SisFinalElement = struct {
    element_id: String, function_id: String, element_type: String,
    tag_name: String, actuated_state: Int, target_state: Int, healthy: Bool,
    bypassed: Bool
};
pub type SisLogicSolver = struct {
    solver_id: String, name: String, vendor: String, model: String,
    firmware: String, sil_capable: Int, redundant: Bool, healthy: Bool
};
pub type SisEvent = struct {
    event_id: String, function_id: String, event_type: Int, timestamp: Int,
    description: String
};
pub type SisEngine = struct {
    engine_id: String, functions: List[SisFunction], sensors: List[SisSensor],
    final_elements: List[SisFinalElement], logic_solvers: List[SisLogicSolver],
    events: List[SisEvent], total_events: Int, shutdown_count: Int,
    is_halted: Bool
};
