// # GOOSE Pure Decision Logic
//
// Logline: Frame test check, st_num regression check, sq_num gap check, allowed signers scan.
//
// Setup: Pure functions; no IO, no CAPs.
//
// Beats:
//   1. goose_is_test_frame.
//   2. goose_st_num_regressed: new_st < prev_st.
//   3. goose_sq_num_gap_excessive: new_sq <= prev_sq or diff > max_gap.
//   4. goose_signer_allowed: linear scan allowed_signers.

import "./goose_sec_types.oo";

pub fn goose_is_test_frame(frame: &GooseFrame) -> Bool {
    return (frame).test;
}

pub fn goose_st_num_regressed(prev_st: Int, new_st: Int) -> Bool {
    if new_st < prev_st {
        return true;
    }
    return false;
}

pub fn goose_sq_num_gap_excessive(prev_sq: Int, new_sq: Int, max_gap: Int) -> Bool {
    if new_sq <= prev_sq {
        return true;
    }
    let diff: Int = new_sq - prev_sq;
    if diff > max_gap {
        return true;
    }
    return false;
}

pub fn goose_signer_allowed(signers: &List[String], fp: String) -> Bool {
    let n: Int = list_len(signers);
    let mut i = 0;
    while i < n {
        let signer_entry: String = list_get(signers, i);
        let matches: Bool = signer_entry == fp;
        if matches {
            return true;
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return false;
}
