// # SecOC Fail-Closed CMAC Stubs
//
// Logline: CAP-bound stubs for AES-128 CMAC compute and secure-NV freshness counter load/save that fail-closed via process_exit(1).
//
// Setup: live CAN / FlexRay bus is process_exit in stubs.
//
// Beats:
//   1. secoc_compute_cmac: CryptoCap-bound CMAC compute stub.
//   2. secoc_persisted_freshness_load: FsReadCap-bound NV read stub.
//   3. secoc_persisted_freshness_save: FsWriteCap-bound NV write stub.

pub fn secoc_compute_cmac(crypto: &CryptoCap, key: &SecOcKey, data: String) -> Result[String, String] {
    process_exit(1);
    return Err("Unimplemented: AES-128 CMAC compute requires CryptoCap FFI lowering");
}

pub fn secoc_persisted_freshness_load(fs: &FsReadCap) -> Result[Int, String] {
    process_exit(1);
    return Err("Unimplemented: persisted freshness counter load requires FsReadCap FFI lowering");
}

pub fn secoc_persisted_freshness_save(fs: &FsWriteCap, counter_v: Int) -> Result[Bool, String] {
    process_exit(1);
    return Err("Unimplemented: persisted freshness counter save requires FsWriteCap FFI lowering");
}
