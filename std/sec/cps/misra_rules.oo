// # MISRA-C / MISRA-C++ Validation, Engine, and Capability Stubs
//
// Logline: Validates required violations, counts by category, drives the MisraEngine state, and exposes the residual capability stubs for linter run and deviation register.
//
// Setup: Imports misra.oo for MisraRule, MisraViolation, MisraConfig, MisraReport, and MisraEngine. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. misra_is_required, misra_should_fail_build, misra_is_required_via_id.
//   2. misra_count_required, misra_count_by_category.
//   3. misra_engine_record_violation, misra_engine_add_report, misra_engine_do_work.
//   4. Residual process_exit stubs for misra_run_linter and misra_deviation_register with capability tokens.

import "./misra.oo";

pub fn misra_is_required(severity: Int) -> Bool {
    return severity >= 3;
}

pub fn misra_should_fail_build(config: &MisraConfig, v: &MisraViolation) -> Bool {
    let req = (v).is_required;
    if req == true {
        return (config).fail_on_required;
    }
    return (config).fail_on_advisory;
}

pub fn misra_is_required_via_id(rule_id_val: String, config: &MisraConfig) -> Bool {
    let rules = (config).max_required_violations;
    if rules < 0  { return true; }
    let s = (config).config_id;
    if s == rule_id_val  { return true; }
    return false;
}

pub fn misra_count_required(violations: &List[MisraViolation]) -> Int {
    let n = list_len(violations);
    let mut i = 0;
    let mut cnt = 0;
    while i < n {
        let v = list_get(violations, i);
        if (v).is_required == true  { cnt = cnt + 1; }
        i = i + 1;
    }
    return cnt;
}

pub fn misra_count_by_category(violations: &List[MisraViolation], category_v: Int) -> Int {
    let n = list_len(violations);
    let mut i = 0;
    let mut cnt = 0;
    while i < n {
        let v = list_get(violations, i);
        if (v).severity == category_v  { cnt = cnt + 1; }
        i = i + 1;
    }
    return cnt;
}

pub fn misra_engine_record_violation(engine: &mut MisraEngine, v: MisraViolation) {
    let mut eng: MisraEngine = engine;
    let old = eng.rules;
    let mut updated: List[MisraRule] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        i = i + 1;
    }
    let inc: Int = 1;
    if (v).is_required {
        let cur_t = eng.total_required;
        eng.total_required = cur_t + inc;
    } else {
        let cur_a = eng.total_advisory;
        eng.total_advisory = cur_a + inc;
    }
    eng.rules = updated;
}

pub fn misra_engine_add_report(engine: &mut MisraEngine, r: MisraReport) {
    let mut eng: MisraEngine = engine;
    let old = eng.reports;
    let mut updated: List[MisraReport] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        i = i + 1;
    }
    updated = list_push(updated, r);
    eng.reports = updated;
}

pub fn misra_engine_do_work(engine: &MisraEngine) -> Int {
    let r_n = list_len((engine).rules);
    let rep_n = list_len((engine).reports);
    return r_n + rep_n;
}

pub fn misra_run_linter(fs: &FsReadCap, file_path_val: String) -> Result[MisraReport, String] {
    process_exit(1);
    return Err("Unimplemented: MISRA-C linter run requires &FsReadCap");
}

pub fn misra_deviation_register(fs: &FsWriteCap, rule_id_val: String, justification_val: String) -> Result[Bool, String] {
    process_exit(1);
    return Err("Unimplemented: MISRA-C deviation register requires &FsWriteCap");
}
