// # ISO 26262 Safety Classification, Validation, and Engine
//
// Logline: Classifies hazard severity/controllability/exposure into an ASIL tag, builds SafetyGoal / SafetyRequirement / SafetyFmea records, validates goal acceptance, aggregates ASIL, and drives the SafetyEngine state plus fail-closed stubs.
//
// Setup: Imports iso26262.oo for ASIL and FTT constants and AsilLevel constructors. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. asil_classify: map (severity, controllability, exposure) to ASIL tag.
//   2. safety_goal_create, safety_requirement_create, safety_fmea_create.
//   3. safety_diagnostic_coverage_for, safety_min_ftt_for_asil, safety_goal_acceptable, safety_aggregate_asil.
//   4. safety_engine_init, safety_engine_add_goal, safety_engine_do_work, plus residual process_exit stubs.

import "./iso26262.oo";

pub fn asil_classify(severity: Int, controllability: Int, exposure: Int) -> Int {
    if severity == 0 {
        return asil_qm();
    }
    if exposure == 0 {
        return asil_qm();
    }
    if controllability == 0 {
        return asil_qm();
    }
    if severity >= 3 {
        if controllability >= 3 {
            if exposure >= 4 {
                return asil_d();
            }
            if exposure >= 3 {
                return asil_c();
            }
            return asil_b();
        }
        if controllability >= 2 {
            if exposure >= 4 {
                return asil_c();
            }
            return asil_b();
        }
        return asil_a();
    }
    if severity >= 2 {
        if controllability >= 3 {
            return asil_b();
        }
        return asil_a();
    }
    return asil_a();
}

pub fn safety_goal_create(goal_id_val: String, asil_v: Int, desc_val: String, safe_state_val: String, ftt_v: Int) -> SafetyGoal {
    let dc: Int = 60;
    let accepted_v = true;
    if asil_v == 4 {
        let dc2: Int = 99;
        let accepted2 = true;
        return SafetyGoal {
            goal_id: goal_id_val, asil: asil_v, description: desc_val,
            safe_state: safe_state_val, ftt: ftt_v, diagnostic_coverage: dc2, accepted: accepted2
        };
    }
    return SafetyGoal {
        goal_id: goal_id_val, asil: asil_v, description: desc_val,
        safe_state: safe_state_val, ftt: ftt_v, diagnostic_coverage: dc, accepted: accepted_v
    };
}

pub fn safety_requirement_create(req_id_val: String, parent_goal_id_val: String, asil_inherited_v: Int, desc_val: String, test_method_v: Int) -> SafetyRequirement {
    return SafetyRequirement {
        req_id: req_id_val, parent_goal_id: parent_goal_id_val,
        asil_inherited: asil_inherited_v, description: desc_val,
        test_method: test_method_v, residual_risk: 0, implemented: false
    };
}

pub fn safety_fmea_create(fmea_id_val: String, element_id_val: String, failure_mode_val: String, effect_val: String, sev: Int, occ: Int, det: Int) -> SafetyFmea {
    let r: Int = sev * occ * det;
    return SafetyFmea {
        fmea_id: fmea_id_val, element_id: element_id_val,
        failure_mode: failure_mode_val, effect: effect_val, severity: sev,
        occurrence: occ, detection: det, rpn: r, action: ""
    };
}

pub fn safety_diagnostic_coverage_for(asil_v: Int) -> Int {
    if asil_v >= 4  { return 99; }
    if asil_v >= 3  { return 95; }
    if asil_v >= 2  { return 90; }
    return 60;
}

pub fn safety_min_ftt_for_asil(asil_v: Int) -> Int {
    if asil_v >= 4  { return iso26262_ftt_triple(); }
    if asil_v >= 3  { return iso26262_ftt_double(); }
    if asil_v >= 2  { return iso26262_ftt_single(); }
    return iso26262_ftt_zero();
}

pub fn safety_goal_acceptable(g: &SafetyGoal) -> Bool {
    let accepted: Bool = (g).accepted;
    if accepted == false  { return false; }
    let req_dc: Int = safety_diagnostic_coverage_for((g).asil);
    let cur_dc: Int = (g).diagnostic_coverage;
    if cur_dc < req_dc  { return false; }
    let min_ftt: Int = safety_min_ftt_for_asil((g).asil);
    let cur_ftt: Int = (g).ftt;
    if cur_ftt < min_ftt  { return false; }
    return true;
}

pub fn safety_aggregate_asil(goals: &List[SafetyGoal]) -> Int {
    let n: Int = list_len(goals);
    if n == 0  { return 0; }
    let first = list_get(goals, 0);
    let mut max_v: Int = first.asil;
    let mut i = 1;
    while i < n {
        let g = list_get(goals, i);
        let lv: Int = g.asil;
        let cur_max: Int = max_v;
        if lv > cur_max  { max_v = lv; }
        i = i + 1;
    }
    return max_v;
}

pub fn safety_engine_init(engine_id_val: String) -> SafetyEngine {
    let _eid: String = engine_id_val;
    let goals: List[SafetyGoal] = list_new();
    let requirements: List[SafetyRequirement] = list_new();
    let fmeas: List[SafetyFmea] = list_new();
    let processes: List[SafetyProcess] = list_new();
    let eng: SafetyEngine = SafetyEngine {
        engine_id: _eid, goals: goals, requirements: requirements,
        fmeas: fmeas, processes: processes, total_goals: 0,
        accepted_goals: 0, is_halted: false
    };
    return eng;
}

pub fn safety_engine_add_goal(engine: &mut SafetyEngine, g: SafetyGoal) {
    let cur_t: Int = (engine).total_goals;
    let inc_one: Int = 1;
    (engine).total_goals = cur_t + inc_one;
    let acceptable: Bool = safety_goal_acceptable(&g);
    if acceptable {
        let cur_a: Int = (engine).accepted_goals;
        (engine).accepted_goals = cur_a + inc_one;
    }
}

pub fn safety_engine_do_work(engine: &SafetyEngine) -> Int {
    let g_n: Int = (engine).total_goals;
    let a_n: Int = (engine).accepted_goals;
    return g_n + a_n;
}

pub fn safety_register_goal(sys: &SysCap, g: &SafetyGoal) -> Result[Bool, String] {
    process_exit(1);
    return Err("Unimplemented: ISO 26262 safety-case tool integration requires SysCap FFI lowering");
}
