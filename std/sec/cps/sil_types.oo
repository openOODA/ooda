// # Safety Integrity Level (SIL) Types
//
// Logline: Define SilLevel, SilPfd, and SilArchitecture models.
//
// Setup: Core data types and structured models.
//
// Beats:
//   1. Declare IEC 61508 SIL target definitions.
//   2. Declare probability of failure on demand (PFD) metrics.
//   3. Declare hardware fault tolerance architectures.

pub type SilLevel = struct {
    level_id: String, level: Int, pfhd_low: Int, pfhd_high: Int, rrf_low: Int,
    rrf_high: Int, probability_per_hour: Int
};
pub type SilTarget = struct {
    target_id: String, sil_level: Int, function_name: String,
    required_pfhd: Int, proof_test_interval_hours: Int, acceptable: Bool
};
pub type SilComponent = struct {
    component_id: String, name: String, sil_claimed: Int, sil_achieved: Int,
    safe_failure_fraction: Int, diagnostic_coverage: Int, failure_count: Int,
    last_failure_ts: Int
};
pub type SilAssessment = struct {
    assessment_id: String, target: SilTarget, components: List[SilComponent],
    aggregate_sil: Int, residual_risk_acceptable: Bool, notes: String,
    is_valid: Bool
};
pub type SilEngine = struct {
    engine_id: String, target: SilTarget, components: List[SilComponent],
    assessments: List[SilAssessment], is_halted: Bool
};
