// # GOOSE Security Data Types
//
// Logline: GooseFrame, GooseSignature, GooseKey, GooseSubscription, GooseViolation, GoosePolicy, GooseEngine struct definitions.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. Frame, signature, key, subscription, violation, policy, engine carriers.

pub type GooseFrame = struct {
    frame_id: String,
    gocb_ref: String,
    dat_set: String,
    go_id: String,
    test: Bool,
    conf_rev: Int,
    nds_com: Bool,
    st_num: Int,
    sq_num: Int,
    simulation: Bool,
    payload: String,
    timestamp_us: Int,
    is_valid: Bool,
};

pub type GooseSignature = struct {
    sig_id: String,
    go_id: String,
    st_num: Int,
    sq_num: Int,
    timestamp_us: Int,
    signer_cert: String,
    signature_bytes: String,
    algorithm: String,
};

pub type GooseKey = struct {
    key_id: String,
    name: String,
    algorithm: String,
    fingerprint: String,
    is_multicast_key: Bool,
    valid_until: Int,
};

pub type GooseSubscription = struct {
    sub_id: String,
    gocb_ref: String,
    dat_set: String,
    min_st_num: Int,
    max_sq_num_gap: Int,
    allowed_signers: List[String],
    enabled: Bool,
};

pub type GooseViolation = struct {
    violation_id: String,
    violation_type: Int,
    go_id: String,
    reason: String,
    timestamp: Int,
};

pub type GoosePolicy = struct {
    policy_id: String,
    require_signature: Bool,
    require_test_false_in_prod: Bool,
    max_sq_num_gap: Int,
    allowed_signers_required: Bool,
    fail_closed: Bool,
    is_valid: Bool,
};

pub type GooseEngine = struct {
    engine_id: String,
    policy: GoosePolicy,
    subscriptions: List[GooseSubscription],
    keys: List[GooseKey],
    violations: List[GooseViolation],
    frames_seen: Int,
    frames_accepted: Int,
    frames_rejected: Int,
    is_halted: Bool,
};
