// # GOOSE Violation Type Constants
//
// Logline: Integer IDs for the six GooseViolation.violation_type categories.
//
// Setup: 1=test_in_prod, 2=unauthenticated, 3=st_num_regression, 4=sq_num_gap, 5=unknown_signer, 6=bad_signature.
//
// Beats:
//   1. The six violation ID helpers.

pub fn goose_violation_test_in_prod() -> Int {
    return 1;
}

pub fn goose_violation_unauthenticated() -> Int {
    return 2;
}

pub fn goose_violation_st_num_regression() -> Int {
    return 3;
}

pub fn goose_violation_sq_num_gap() -> Int {
    return 4;
}

pub fn goose_violation_unknown_signer() -> Int {
    return 5;
}

pub fn goose_violation_bad_signature() -> Int {
    return 6;
}
