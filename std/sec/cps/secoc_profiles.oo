// # SecOC MAC & Profile Constants
//
// Logline: MAC algorithm ID constants and SecOcProfile presets (PDU_8, PDU_12, PDU_24).
//
// Setup: CMAC-AES-128 = 1, HMAC-SHA-256 = 2, JASMIN = 3.
//
// Beats:
//   1. secoc_mac_cmac_aes128 / hmac_sha256 / jasmin.
//   2. secoc_profile_pdu8 (8-byte truncated MAC), pdu12, pdu24 (full 16-byte MAC).

import "./secoc_types.oo";

pub fn secoc_mac_cmac_aes128() -> Int {
    return 1;
}

pub fn secoc_mac_hmac_sha256() -> Int {
    return 2;
}

pub fn secoc_mac_jasmin() -> Int {
    return 3;
}

pub fn secoc_profile_pdu8() -> SecOcProfile {
    return SecOcProfile {
        profile_id: "PDU_8",
        name: "8-byte truncated MAC",
        mac_algorithm: "CMAC-AES-128",
        mac_length_bytes: 8,
        freshness_length_bytes: 4,
        require_secure_nv: true,
    };
}

pub fn secoc_profile_pdu12() -> SecOcProfile {
    return SecOcProfile {
        profile_id: "PDU_12",
        name: "12-byte truncated MAC",
        mac_algorithm: "CMAC-AES-128",
        mac_length_bytes: 12,
        freshness_length_bytes: 4,
        require_secure_nv: true,
    };
}

pub fn secoc_profile_pdu24() -> SecOcProfile {
    return SecOcProfile {
        profile_id: "PDU_24",
        name: "24-byte full MAC",
        mac_algorithm: "CMAC-AES-128",
        mac_length_bytes: 16,
        freshness_length_bytes: 8,
        require_secure_nv: true,
    };
}
