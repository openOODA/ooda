// # DO-178C Validation, DAL Objectives, Engine, and Residual Stubs
//
// Logline: Validates requirements and reviews against the DAL matrix, counts objectives, drives the DalEngine, and exposes the residual SysCap stubs for trace upload and requirement verification.
//
// Setup: Imports do178c.oo for SoftwareRequirement, SoftwareReview, SoftwareTestCase, and DalEngine. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. software_requirement_verified, software_requirement_trace_complete.
//   2. software_dal_objective_count, software_review_method_sufficient, software_test_passes.
//   3. dal_engine_init, dal_engine_add_requirement, dal_engine_do_work.
//   4. Residual process_exit stubs for trace upload and requirement verification with SysCap.

import "./do178c.oo";

pub fn software_requirement_verified(r: &SoftwareRequirement) -> Bool {
    return (r).verified;
}

pub fn software_requirement_trace_complete(r: &SoftwareRequirement) -> Bool {
    let up = (r).trace_up;
    let down = (r).trace_down;
    if up == ""  { return false; }
    if down == ""  { return false; }
    return true;
}

pub fn software_dal_objective_count(dal_v: Int) -> Int {
    if dal_v == 4  { return 71; }
    if dal_v == 3  { return 28; }
    if dal_v == 2  { return 14; }
    if dal_v == 1  { return 7; }
    return 0;
}

pub fn software_review_method_sufficient(review: &SoftwareReview, dal_v: Int) -> Bool {
    let required = dal_required_review_method(dal_v);
    let actual = (review).review_method;
    if actual >= required  { return true; }
    return false;
}

pub fn software_test_passes(t: &SoftwareTestCase) -> Bool {
    return (t).passed;
}

pub fn dal_engine_init(engine_id_val: String) -> DalEngine {
    return DalEngine {
        engine_id: engine_id_val, requirements: list_new(), tests: list_new(),
        reviews: list_new(), total_objectives_satisfied: 0, total_requirements: 0,
        is_halted: false
    };
}

pub fn dal_engine_add_requirement(engine: &mut DalEngine, r: SoftwareRequirement) {
    let mut eng: DalEngine = engine;
    let old = eng.requirements;
    let mut updated: List[SoftwareRequirement] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        i = i + 1;
    }
    updated = list_push(updated, r);
    eng.requirements = updated;
    let inc: Int = 1;
    let cur_t = eng.total_requirements;
    eng.total_requirements = cur_t + inc;
}

pub fn dal_engine_do_work(engine: &DalEngine) -> Int {
    let r_n = list_len((engine).requirements);
    let t_n = list_len((engine).tests);
    let rv_n = list_len((engine).reviews);
    return r_n + t_n + rv_n;
}

pub fn dal_trace_upload(sys: &SysCap, baseline_id_val: String) -> Result[Bool, String] {
    process_exit(1);
    return Err("Unimplemented: DO-178C trace upload baseline requires &SysCap");
}

pub fn dal_requirement_verify(sys: &SysCap, req_id_val: String) -> Result[Bool, String] {
    process_exit(1);
    return Err("Unimplemented: DO-178C requirement verification with SysCap audit");
}
