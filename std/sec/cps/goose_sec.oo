// ===================================================================
// openOODA Standard Library — ooda::sec::cps::goose_sec
// IEC 61850 GOOSE Multicast Security Module
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects. CAP-G6: L2 GOOSE stays &NetCap residual.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

// -------------------------------------------------------------------
// Core GOOSE Types
// -------------------------------------------------------------------

pub type GooseFrame = struct {
    frame_id: String,
    gocb_ref: String,
    dat_set: String,
    go_id: String,
    test: Bool,
    conf_rev: Int,
    nds_com: Bool,
    st_num: Int,
    sq_num: Int,
    simulation: Bool,
    payload: String,
    timestamp_us: Int,
    is_valid: Bool,
};

pub type GooseSignature = struct {
    sig_id: String,
    go_id: String,
    st_num: Int,
    sq_num: Int,
    timestamp_us: Int,
    signer_cert: String,
    signature_bytes: String,
    algorithm: String,
};

pub type GooseKey = struct {
    key_id: String,
    name: String,
    algorithm: String,
    fingerprint: String,
    is_multicast_key: Bool,
    valid_until: Int,
};

pub type GooseSubscription = struct {
    sub_id: String,
    gocb_ref: String,
    dat_set: String,
    min_st_num: Int,
    max_sq_num_gap: Int,
    allowed_signers: List[String],
    enabled: Bool,
};

pub type GooseViolation = struct {
    violation_id: String,
    violation_type: Int,
    go_id: String,
    reason: String,
    timestamp: Int,
};

pub type GoosePolicy = struct {
    policy_id: String,
    require_signature: Bool,
    require_test_false_in_prod: Bool,
    max_sq_num_gap: Int,
    allowed_signers_required: Bool,
    fail_closed: Bool,
    is_valid: Bool,
};

pub type GooseEngine = struct {
    engine_id: String,
    policy: GoosePolicy,
    subscriptions: List[GooseSubscription],
    keys: List[GooseKey],
    violations: List[GooseViolation],
    frames_seen: Int,
    frames_accepted: Int,
    frames_rejected: Int,
    is_halted: Bool,
};

// -------------------------------------------------------------------
// Violation Type Constants
// -------------------------------------------------------------------

pub fn goose_violation_test_in_prod() -> Int {
    return 1;
}

pub fn goose_violation_unauthenticated() -> Int {
    return 2;
}

pub fn goose_violation_st_num_regression() -> Int {
    return 3;
}

pub fn goose_violation_sq_num_gap() -> Int {
    return 4;
}

pub fn goose_violation_unknown_signer() -> Int {
    return 5;
}

pub fn goose_violation_bad_signature() -> Int {
    return 6;
}

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn goose_frame_new(
    frame_id_val: String,
    gocb_ref_val: String,
    go_id_val: String,
    test_v: Bool,
    st_num_v: Int,
    sq_num_v: Int,
    payload_v: String,
    ts_us: Int
) -> GooseFrame {
    return GooseFrame {
        frame_id: frame_id_val,
        gocb_ref: gocb_ref_val,
        dat_set: "",
        go_id: go_id_val,
        test: test_v,
        conf_rev: 0,
        nds_com: false,
        st_num: st_num_v,
        sq_num: sq_num_v,
        simulation: false,
        payload: payload_v,
        timestamp_us: ts_us,
        is_valid: true,
    };
}

pub fn goose_signature_new(
    sig_id_val: String,
    go_id_val: String,
    st_num_v: Int,
    sq_num_v: Int,
    signer_cert_val: String,
    sig_bytes_val: String,
    algo_val: String
) -> GooseSignature {
    return GooseSignature {
        sig_id: sig_id_val,
        go_id: go_id_val,
        st_num: st_num_v,
        sq_num: sq_num_v,
        timestamp_us: 0,
        signer_cert: signer_cert_val,
        signature_bytes: sig_bytes_val,
        algorithm: algo_val,
    };
}

pub fn goose_key_create(
    key_id_val: String,
    algo_val: String,
    fingerprint_val: String,
    is_mc: Bool,
    valid_until_v: Int
) -> GooseKey {
    return GooseKey {
        key_id: key_id_val,
        name: "",
        algorithm: algo_val,
        fingerprint: fingerprint_val,
        is_multicast_key: is_mc,
        valid_until: valid_until_v,
    };
}

pub fn goose_subscription_new(
    sub_id_val: String,
    gocb_ref_val: String,
    max_gap: Int
) -> GooseSubscription {
    return GooseSubscription {
        sub_id: sub_id_val,
        gocb_ref: gocb_ref_val,
        dat_set: "",
        min_st_num: 0,
        max_sq_num_gap: max_gap,
        allowed_signers: list_new(),
        enabled: true,
    };
}

pub fn goose_policy_default() -> GoosePolicy {
    return GoosePolicy {
        policy_id: "GOOSE_POLICY_DEFAULT",
        require_signature: true,
        require_test_false_in_prod: true,
        max_sq_num_gap: 10,
        allowed_signers_required: true,
        fail_closed: true,
        is_valid: true,
    };
}

// -------------------------------------------------------------------
// Decision Logic (Pure)
// -------------------------------------------------------------------

pub fn goose_is_test_frame(frame: &GooseFrame) -> Bool {
    return (frame).test;
}

pub fn goose_st_num_regressed(prev_st: Int, new_st: Int) -> Bool {
    if new_st < prev_st {
        return true;
    }
    return false;
}

pub fn goose_sq_num_gap_excessive(prev_sq: Int, new_sq: Int, max_gap: Int) -> Bool {
    if new_sq <= prev_sq {
        return true;
    }
    let diff: Int = new_sq - prev_sq;
    if diff > max_gap {
        return true;
    }
    return false;
}

pub fn goose_signer_allowed(signers: &List[String], fp: String) -> Bool {
    let n: Int = list_len(signers);
    let mut i = 0;
    while i < n {
        let signer_entry: String = list_get(signers, i);
        let matches: Bool = signer_entry == fp;
        if matches {
            return true;
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return false;
}

// -------------------------------------------------------------------
// Engine (Pure)
// -------------------------------------------------------------------

pub fn goose_engine_init(engine_id_val: String) -> GooseEngine {
    return GooseEngine {
        engine_id: engine_id_val,
        policy: goose_policy_default(),
        subscriptions: list_new(),
        keys: list_new(),
        violations: list_new(),
        frames_seen: 0,
        frames_accepted: 0,
        frames_rejected: 0,
        is_halted: false,
    };
}

pub fn goose_engine_add_subscription(engine: &mut GooseEngine, s: GooseSubscription) {
    let mut eng = engine;
    let old = eng.subscriptions;
    let mut updated: List[GooseSubscription] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, s);
    eng.subscriptions = updated;
}

pub fn goose_engine_record_frame(engine: &mut GooseEngine, accepted: Bool) {
    let mut eng = engine;
    let inc_one: Int = 1;
    let cur_s: Int = eng.frames_seen;
    eng.frames_seen = cur_s + inc_one;
    if accepted {
        let cur_a: Int = eng.frames_accepted;
        eng.frames_accepted = cur_a + inc_one;
    } else {
        let cur_r: Int = eng.frames_rejected;
        eng.frames_rejected = cur_r + inc_one;
    }
}

pub fn goose_engine_record_violation(engine: &mut GooseEngine, v: GooseViolation) {
    let mut eng = engine;
    let old = eng.violations;
    let mut updated: List[GooseViolation] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, v);
    eng.violations = updated;
}

pub fn goose_engine_do_work(engine: &GooseEngine) -> Int {
    return (engine).frames_seen + (engine).frames_accepted + (engine).frames_rejected;
}

// -------------------------------------------------------------------
// Fail-Closed Multicast Stubs
// -------------------------------------------------------------------

pub fn goose_join_multicast(net: &NetCap, mac: String) -> Result[Int, String] {
    // COMPILER LIMITATION: openOODA lacks L2/IGMP multicast join for IEC 61850 GOOSE 01-0C-CD-01-xx-xx.
    // CAP-G6: raw residual, no SoftGranular — GOOSE is ethertype 0x88B8 L2 multicast (not UdpCap/TcpCap).
    process_exit(1);
    return Err("Unimplemented: GOOSE multicast join requires NetCap raw residual (no SoftGranular) FFI lowering");
}

pub fn goose_verify_signature(crypto: &CryptoCap, frame: &GooseFrame, sig: &GooseSignature) -> Result[Bool, String] {
    // COMPILER LIMITATION: openOODA lacks IEC 61850-9-3 Ed25519/RSA GOOSE signature verify FFI.
    process_exit(1);
    return Err("Unimplemented: GOOSE signature verify requires CryptoCap FFI lowering");
}