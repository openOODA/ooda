// # MISRA C Compliance Verification Types
//
// Logline: Define MisraRule, MisraViolation, and MisraSuppression models.
//
// Setup: Core data types and structured models.
//
// Beats:
//   1. Declare MISRA standard rule categorizations.
//   2. Declare violation event records and file locations.
//   3. Declare deviation justification records.

pub type MisraRule = struct {
    rule_id: String, category: Int, severity: Int, required: Bool,
    description: String, deviation_justification: String
};
pub type MisraViolation = struct {
    violation_id: String, rule_id: String, file: String, line: Int, column: Int,
    excerpt: String, rationale: String
};
pub type MisraReport = struct {
    report_id: String, file_path: String, scanned_lines: Int,
    total_violations: Int, required_violations: Int, advisory_violations: Int,
    violations: List[MisraViolation], deviation_approved: Bool
};
pub type MisraConfig = struct {
    config_id: String, enforce_required: Bool, enforce_advisory: Bool,
    allow_deviations: Bool, target_cpp: Bool, fail_closed: Bool, is_valid: Bool
};
pub type MisraEngine = struct {
    engine_id: String, config: MisraConfig, rules: List[MisraRule],
    reports: List[MisraReport], total_violations: Int, required_violations: Int,
    is_halted: Bool
};

pub fn misra_severity_required() -> Int { return 1; }
pub fn misra_severity_advisory() -> Int { return 2; }

pub fn misra_severity_document() -> Int { return 3; }
pub fn misra_category_environment() -> Int { return 1; }
pub fn misra_category_language_extension() -> Int { return 2; }
pub fn misra_category_naming() -> Int { return 3; }
pub fn misra_category_type_safety() -> Int { return 4; }
pub fn misra_category_control_flow() -> Int { return 5; }
pub fn misra_config_default() -> MisraConfig {
    return MisraConfig {
        config_id: "MISRA_CFG_DEFAULT", enforce_required: true,
        enforce_advisory: false, allow_deviations: true, target_cpp: false,
        fail_closed: true, is_valid: true
    };
}
pub fn misra_rule_set_default() -> List[MisraRule] {
    let mut rules: List[MisraRule] = list_new();
    let r1 = misra_rule_create(
        "R1.1",
        misra_category_environment(),
        misra_severity_required(),
        true,
        "The compiler shall not be invoked with non-standard language extensions"
    );
    rules = list_push(rules, r1);
    let r2 = misra_rule_create(
        "R2.1",
        misra_category_language_extension(),
        misra_severity_required(),
        true,
        "A project shall not contain unreachable code"
    );
    rules = list_push(rules, r2);
    let r3 = misra_rule_create(
        "R5.1",
        misra_category_naming(),
        misra_severity_advisory(),
        false,
        "External identifiers shall be distinct"
    );
    rules = list_push(rules, r3);
    let r4 = misra_rule_create(
        "R10.4",
        misra_category_type_safety(),
        misra_severity_required(),
        true,
        "The operands of an operator shall not have essential type category other than int"
    );
    rules = list_push(rules, r4);
    let r5 = misra_rule_create(
        "R14.3",
        misra_category_control_flow(),
        misra_severity_required(),
        true,
        "Controlling expressions shall not be invariant"
    );
    rules = list_push(rules, r5);
    let r6 = misra_rule_create(
        "R21.6",
        misra_category_environment(),
        misra_severity_required(),
        true,
        "The Standard Library input/output functions shall not be used"
    );
    rules = list_push(rules, r6);
    return rules;
}
pub fn misra_engine_init(engine_id_val: String) -> MisraEngine {
    return MisraEngine {
        engine_id: engine_id_val, config: misra_config_default(),
        rules: misra_rule_set_default(), reports: list_new(), total_violations: 0,
        required_violations: 0, is_halted: false
    };
}
