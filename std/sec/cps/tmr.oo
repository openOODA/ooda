// # Triple Modular Redundancy Voter Module
//
// Logline: Define TmrVote, TmrTriple, and TmrResult; vote on majority, detect disagreement, log failure source.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. tmr_vote_init: bind source_id, value, and tag.
//   2. tmr_triple_init: build TmrTriple from three TmrVotes.
//   3. tmr_vote_majority: gate consensus on 2-of-3 match.
//   4. tmr_record_disagreement: bump violation counter and log source.
//
// residual: live sensor I/O is process_exit in stubs.

// RULES.oot 1.4: Default-deny for privileged effects.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

// -------------------------------------------------------------------
// Core TMR Types
// -------------------------------------------------------------------

pub type TmrVote = struct {
    vote_id: String,
    source_id: Int,
    value: Int,
    tag: String,
    timestamp: Int,
};

pub type TmrTriple = struct {
    triple_id: String,
    a: TmrVote,
    b: TmrVote,
    c: TmrVote,
};

pub type TmrResult = struct {
    result_id: String,
    chosen_value: Int,
    voter_count: Int,
    consensus: Bool,
    failure_detected: Bool,
    disagreement_source: Int,
    timestamp: Int,
};

pub type TmrPolicy = struct {
    policy_id: String,
    require_majority: Bool,
    detect_disagreement: Bool,
    fail_to_safe_on_disagreement: Bool,
    reset_on_failure: Bool,
    fail_closed: Bool,
    is_valid: Bool,
};

pub type TmrEngine = struct {
    engine_id: String,
    policy: TmrPolicy,
    triples_processed: Int,
    consensus_reached: Int,
    disagreements: Int,
    is_halted: Bool,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn tmr_vote_new(vote_id_val: String, source_id_v: Int, value_v: Int, ts: Int) -> TmrVote {
    return TmrVote {
        vote_id: vote_id_val,
        source_id: source_id_v,
        value: value_v,
        tag: "",
        timestamp: ts,
    };
}

pub fn tmr_triple_new(triple_id_val: String, a_v: TmrVote, b_v: TmrVote, c_v: TmrVote) -> TmrTriple {
    return TmrTriple {
        triple_id: triple_id_val,
        a: a_v,
        b: b_v,
        c: c_v,
    };
}

pub fn tmr_policy_default() -> TmrPolicy {
    return TmrPolicy {
        policy_id: "TMR_POLICY_DEFAULT",
        require_majority: true,
        detect_disagreement: true,
        fail_to_safe_on_disagreement: true,
        reset_on_failure: false,
        fail_closed: true,
        is_valid: true,
    };
}

// -------------------------------------------------------------------
// Voter Logic (Pure)
// -------------------------------------------------------------------

pub fn tmr_votes_agree(a: &TmrVote, b: &TmrVote) -> Bool {
    return (a).value == (b).value;
}

pub fn tmr_all_three_agree(a: &TmrVote, b: &TmrVote, c: &TmrVote) -> Bool {
    let ab: Bool = tmr_votes_agree(a, b);
    if ab == false {
        return false;
    }
    return (a).value == (c).value;
}

pub fn tmr_majority_value(a: &TmrVote, b: &TmrVote, c: &TmrVote) -> TmrResult {
    let a_b: Bool = tmr_votes_agree(a, b);
    let a_val: Int = (a).value;
    let b_val: Int = (b).value;
    let c_val: Int = (c).value;
    let a_c: Bool = a_val == c_val;
    let b_c: Bool = b_val == c_val;

    let mut chosen: Int = a_val;
    let mut consensus_v: Bool = false;
    let mut disagree_source: Int = 0;
    if a_b {
        if a_c {
            chosen = a_val;
            consensus_v = true;
        } else {
            chosen = a_val;
            consensus_v = true;
            disagree_source = (c).source_id;
        }
    } else {
        if a_c {
            chosen = a_val;
            consensus_v = true;
            disagree_source = (b).source_id;
        } else {
            if b_c {
                chosen = b_val;
                consensus_v = true;
                disagree_source = (a).source_id;
            } else {
                chosen = a_val;
                consensus_v = false;
                disagree_source = -1;
            }
        }
    }
    let mut voter_count_v: Int = 3;
    if consensus_v == false {
        voter_count_v = 0;
    }
    return TmrResult {
        result_id: "tmr-result",
        chosen_value: chosen,
        voter_count: voter_count_v,
        consensus: consensus_v,
        failure_detected: consensus_v == false,
        disagreement_source: disagree_source,
        timestamp: 0,
    };
}

pub fn tmr_safe_value() -> Int {
    return 0;
}

// -------------------------------------------------------------------
// Engine (Pure)
// -------------------------------------------------------------------

pub fn tmr_engine_init(engine_id_val: String) -> TmrEngine {
    return TmrEngine {
        engine_id: engine_id_val,
        policy: tmr_policy_default(),
        triples_processed: 0,
        consensus_reached: 0,
        disagreements: 0,
        is_halted: false,
    };
}

pub fn tmr_engine_run(engine: &mut TmrEngine, t: TmrTriple) -> TmrResult {
    let mut eng = engine;
    let inc_one: Int = 1;
    let cur_t: Int = eng.triples_processed;
    eng.triples_processed = cur_t + inc_one;
    let res = tmr_majority_value(&t.a, &t.b, &t.c);
    if res.consensus {
        let cur_c: Int = eng.consensus_reached;
        eng.consensus_reached = cur_c + inc_one;
    } else {
        let cur_d: Int = eng.disagreements;
        eng.disagreements = cur_d + inc_one;
    }
    return res;
}

pub fn tmr_engine_do_work(engine: &TmrEngine) -> Int {
    return (engine).triples_processed + (engine).consensus_reached + (engine).disagreements;
}