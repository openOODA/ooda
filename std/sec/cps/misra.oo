// # MISRA-C / MISRA-C++ Types, Constants, and Constructors
//
// Logline: Defines MisraRule, MisraViolation, MisraConfig, MisraReport, and MisraEngine record types, plus rule and violation constructors and the strict config preset.
//
// Setup: Imports misra_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. MisraRule / MisraViolation / MisraConfig / MisraReport / MisraEngine record types.
//   2. misra_rule_create, misra_violation_create, misra_report_new.
//   3. misra_config_strict preset and int_to_str_misra helper.
//   4. Re-export shim: misra_deviation_approve to satisfy the legacy public surface.

pub type MisraRule = struct {
    rule_id: String, category: String, severity: Int, required: Bool,
    description: String, rationale: String
};

pub type MisraViolation = struct {
    rule_id: String, file_path: String, line: Int, column: Int,
    message: String, severity: Int, is_required: Bool
};

pub type MisraConfig = struct {
    config_id: String, max_required_violations: Int, max_advisory_violations: Int,
    fail_on_required: Bool, fail_on_advisory: Bool, is_strict: Bool
};

pub type MisraReport = struct {
    report_id: String, file_path: String, scanned_lines: Int,
    required_violations: Int, advisory_violations: Int, deviation_approved: Bool
};

pub type MisraEngine = struct {
    engine_id: String, rules: List[MisraRule], reports: List[MisraReport],
    total_required: Int, total_advisory: Int, is_halted: Bool
};

pub fn misra_rule_create(rule_id_val: String, category_v: String, severity_v: Int, required_v: Bool, desc_v: String, rationale_v: String) -> MisraRule {
    return MisraRule {
        rule_id: rule_id_val, category: category_v, severity: severity_v,
        required: required_v, description: desc_v, rationale: rationale_v
    };
}

pub fn misra_violation_create(rule_id_val: String, file_path_v: String, line_v: Int, col_v: Int, msg_v: String, severity_v: Int) -> MisraViolation {
    return MisraViolation {
        rule_id: rule_id_val, file_path: file_path_v, line: line_v, column: col_v,
        message: msg_v, severity: severity_v, is_required: severity_v >= 3
    };
}

pub fn misra_report_new(report_id_val: String, file_path_val: String, scanned_lines_v: Int) -> MisraReport {
    return MisraReport {
        report_id: report_id_val, file_path: file_path_val, scanned_lines: scanned_lines_v,
        required_violations: 0, advisory_violations: 0, deviation_approved: false
    };
}

pub fn misra_config_strict() -> MisraConfig {
    return MisraConfig {
        config_id: "strict", max_required_violations: 0, max_advisory_violations: 0,
        fail_on_required: true, fail_on_advisory: true, is_strict: true
    };
}

pub fn int_to_str_misra(value: Int) -> String {
    if value == 0 { return "0"; }
    if value == 1 { return "1"; }
    if value == 2 { return "2"; }
    if value == 3 { return "3"; }
    if value == 4 { return "4"; }
    return "N";
}

pub fn misra_deviation_approve(r: &mut MisraReport) {
    let mut r: MisraReport = r;
    (r).deviation_approved = true;
}
