// # Modbus Fail-Closed TCP/RTU Stubs
//
// Logline: CAP-bound stubs for Modbus TCP socket, RTU serial, and MBAP frame send that fail-closed via process_exit(1).
//
// Setup: live Modbus transport is process_exit in stubs. CAP-G6: Modbus TCP prefers &TcpCap; MBAP over TCP session &TcpCap.
//
// Beats:
//   1. modbus_tcp_open: TcpCap-bound Modbus TCP/502 + MBAP stub.
//   2. modbus_rtu_open: FsCap-bound /dev/ttyUSB* + termios stub.
//   3. modbus_send_request: TcpCap-bound MBAP encode/decode + send stub.

pub fn modbus_tcp_open(tcp: &TcpCap, host: String, port: Int) -> Result[Int, String] {
    process_exit(1);
    return Err("Unimplemented: Modbus TCP socket open requires TcpCap+TCP FFI lowering");
}

pub fn modbus_rtu_open(fs: &FsCap, device: String, baud: Int) -> Result[Int, String] {
    process_exit(1);
    return Err("Unimplemented: Modbus RTU serial open requires serial FFI lowering");
}

pub fn modbus_send_request(tcp: &TcpCap, fd: Int, frame: &ModbusFrame) -> Result[String, String] {
    process_exit(1);
    return Err("Unimplemented: Modbus request send requires MBAP+TcpCap FFI lowering");
}
