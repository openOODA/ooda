// # ESD Test / Device / Polarity Constants
//
// Logline: Integer IDs for the IEC 61000-4-2 test types, device types, and polarity categories.
//
// Setup: 1=HCP/VCP/Air/Contact/TVS/Varistor/Capacitor/ConductiveFloor/Ionizer/WristStrap/Positive; 2=VCP/Air/Varistor/Negative.
//
// Beats:
//   1. Test type IDs.
//   2. Device type IDs.
//   3. Polarity IDs.

pub fn esd_test_hcp() -> Int {
    return 1;
}

pub fn esd_test_vcp() -> Int {
    return 2;
}

pub fn esd_test_air_discharge() -> Int {
    return 3;
}

pub fn esd_test_contact_discharge() -> Int {
    return 4;
}

pub fn esd_device_tvs() -> Int {
    return 1;
}

pub fn esd_device_varistor() -> Int {
    return 2;
}

pub fn esd_device_capacitor() -> Int {
    return 3;
}

pub fn esd_device_conductive_floor() -> Int {
    return 4;
}

pub fn esd_device_ionizer() -> Int {
    return 5;
}

pub fn esd_device_wrist_strap() -> Int {
    return 6;
}

pub fn esd_polarity_positive() -> Int {
    return 1;
}

pub fn esd_polarity_negative() -> Int {
    return 2;
}
