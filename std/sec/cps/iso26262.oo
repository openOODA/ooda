// # ISO 26262 Automotive Functional Safety Module
//
// Logline: Define AsilLevel, SafetyGoal, and SafetyRequirement; score exposure, severity, and controllability.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. asil_level_init: bind severity, controllability, and exposure.
//   2. safety_goal_init: bind safe_state, ftt, and diagnostic_coverage.
//   3. safety_requirement_init: bind parent_goal_id and test_method.
//   4. iso26262_asil_classify: map three scores to QM..D ASIL tag.
//
// residual: live FMEA import is process_exit in stubs.

// RULES.oot 1.4: Default-deny for privileged effects.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

// -------------------------------------------------------------------
// Core ISO 26262 Types
// -------------------------------------------------------------------

pub type AsilLevel = struct {
    asil_id: String,
    level: Int,
    severity: Int,
    controllability: Int,
    exposure: Int,
    full_name: String,
};

pub type SafetyGoal = struct {
    goal_id: String,
    asil: Int,
    description: String,
    safe_state: String,
    ftt: Int,
    diagnostic_coverage: Int,
    accepted: Bool,
};

pub type SafetyRequirement = struct {
    req_id: String,
    parent_goal_id: String,
    asil_inherited: Int,
    description: String,
    test_method: Int,
    residual_risk: Int,
    implemented: Bool,
};

pub type SafetyFmea = struct {
    fmea_id: String,
    element_id: String,
    failure_mode: String,
    effect: String,
    severity: Int,
    occurrence: Int,
    detection: Int,
    rpn: Int,
    action: String,
};

pub type SafetyProcess = struct {
    process_id: String,
    element_id: String,
    current_phase: Int,
    last_review_ts: Int,
    review_notes: String,
    is_valid: Bool,
};

pub type SafetyEngine = struct {
    engine_id: String,
    goals: List[SafetyGoal],
    requirements: List[SafetyRequirement],
    fmeas: List[SafetyFmea],
    processes: List[SafetyProcess],
    total_goals: Int,
    accepted_goals: Int,
    is_halted: Bool,
};

// -------------------------------------------------------------------
// ASIL Level Constants (ISO 26262-3:2018 Table 4)
// -------------------------------------------------------------------

pub fn asil_qm() -> Int {
    return 0;
}

pub fn asil_a() -> Int {
    return 1;
}

pub fn asil_b() -> Int {
    return 2;
}

pub fn asil_c() -> Int {
    return 3;
}

pub fn asil_d() -> Int {
    return 4;
}

// -------------------------------------------------------------------
// Severity Constants
// -------------------------------------------------------------------

pub fn iso26262_severity_s0() -> Int {
    return 0;
}

pub fn iso26262_severity_s1() -> Int {
    return 1;
}

pub fn iso26262_severity_s2() -> Int {
    return 2;
}

pub fn iso26262_severity_s3() -> Int {
    return 3;
}

pub fn iso26262_controllability_c0() -> Int {
    return 0;
}

pub fn iso26262_controllability_c1() -> Int {
    return 1;
}

pub fn iso26262_controllability_c2() -> Int {
    return 2;
}

pub fn iso26262_controllability_c3() -> Int {
    return 3;
}

pub fn iso26262_exposure_e0() -> Int {
    return 0;
}

pub fn iso26262_exposure_e1() -> Int {
    return 1;
}

pub fn iso26262_exposure_e2() -> Int {
    return 2;
}

pub fn iso26262_exposure_e3() -> Int {
    return 3;
}

pub fn iso26262_exposure_e4() -> Int {
    return 4;
}

// -------------------------------------------------------------------
// Fault Tolerant Time Interval
// -------------------------------------------------------------------

pub fn iso26262_ftt_zero() -> Int {
    return 0;
}

pub fn iso26262_ftt_single() -> Int {
    return 1;
}

pub fn iso26262_ftt_double() -> Int {
    return 2;
}

pub fn iso26262_ftt_triple() -> Int {
    return 3;
}

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn asil_level_d() -> AsilLevel {
    return AsilLevel {
        asil_id: "ASIL_D",
        level: 4,
        severity: 3,
        controllability: 3,
        exposure: 4,
        full_name: "D",
    };
}

pub fn asil_level_c() -> AsilLevel {
    return AsilLevel {
        asil_id: "ASIL_C",
        level: 3,
        severity: 3,
        controllability: 2,
        exposure: 4,
        full_name: "C",
    };
}

pub fn asil_level_b() -> AsilLevel {
    return AsilLevel {
        asil_id: "ASIL_B",
        level: 2,
        severity: 2,
        controllability: 2,
        exposure: 3,
        full_name: "B",
    };
}

pub fn asil_level_a() -> AsilLevel {
    return AsilLevel {
        asil_id: "ASIL_A",
        level: 1,
        severity: 1,
        controllability: 1,
        exposure: 3,
        full_name: "A",
    };
}

pub fn asil_level_qm() -> AsilLevel {
    return AsilLevel {
        asil_id: "ASIL_QM",
        level: 0,
        severity: 0,
        controllability: 0,
        exposure: 0,
        full_name: "QM",
    };
}

pub fn asil_classify(severity: Int, controllability: Int, exposure: Int) -> Int {
    if severity == 0 {
        return asil_qm();
    }
    if exposure == 0 {
        return asil_qm();
    }
    if controllability == 0 {
        return asil_qm();
    }
    if severity >= 3 {
        if controllability >= 3 {
            if exposure >= 4 {
                return asil_d();
            }
            if exposure >= 3 {
                return asil_c();
            }
            return asil_b();
        }
        if controllability >= 2 {
            if exposure >= 4 {
                return asil_c();
            }
            return asil_b();
        }
        return asil_a();
    }
    if severity >= 2 {
        if controllability >= 3 {
            return asil_b();
        }
        return asil_a();
    }
    return asil_a();
}

pub fn safety_goal_create(
    goal_id_val: String,
    asil_v: Int,
    desc_val: String,
    safe_state_val: String,
    ftt_v: Int
) -> SafetyGoal {
    let dc: Int = 60;
    let accepted_v = true;
    if asil_v == 4 {
        let dc2: Int = 99;
        let accepted2 = true;
        return SafetyGoal {
            goal_id: goal_id_val,
            asil: asil_v,
            description: desc_val,
            safe_state: safe_state_val,
            ftt: ftt_v,
            diagnostic_coverage: dc2,
            accepted: accepted2,
        };
    }
    return SafetyGoal {
        goal_id: goal_id_val,
        asil: asil_v,
        description: desc_val,
        safe_state: safe_state_val,
        ftt: ftt_v,
        diagnostic_coverage: dc,
        accepted: accepted_v,
    };
}

pub fn safety_requirement_create(
    req_id_val: String,
    parent_goal_id_val: String,
    asil_inherited_v: Int,
    desc_val: String,
    test_method_v: Int
) -> SafetyRequirement {
    return SafetyRequirement {
        req_id: req_id_val,
        parent_goal_id: parent_goal_id_val,
        asil_inherited: asil_inherited_v,
        description: desc_val,
        test_method: test_method_v,
        residual_risk: 0,
        implemented: false,
    };
}

pub fn safety_fmea_create(
    fmea_id_val: String,
    element_id_val: String,
    failure_mode_val: String,
    effect_val: String,
    sev: Int,
    occ: Int,
    det: Int
) -> SafetyFmea {
    let r: Int = sev * occ * det;
    return SafetyFmea {
        fmea_id: fmea_id_val,
        element_id: element_id_val,
        failure_mode: failure_mode_val,
        effect: effect_val,
        severity: sev,
        occurrence: occ,
        detection: det,
        rpn: r,
        action: "",
    };
}

// -------------------------------------------------------------------
// Validation (Pure)
// -------------------------------------------------------------------

pub fn safety_diagnostic_coverage_for(asil_v: Int) -> Int {
    if asil_v >= 4 {
        return 99;
    }
    if asil_v >= 3 {
        return 95;
    }
    if asil_v >= 2 {
        return 90;
    }
    return 60;
}

pub fn safety_min_ftt_for_asil(asil_v: Int) -> Int {
    if asil_v >= 4 {
        return iso26262_ftt_triple();
    }
    if asil_v >= 3 {
        return iso26262_ftt_double();
    }
    if asil_v >= 2 {
        return iso26262_ftt_single();
    }
    return iso26262_ftt_zero();
}

pub fn safety_goal_acceptable(g: &SafetyGoal) -> Bool {
    if (g).accepted == false {
        return false;
    }
    let req_dc: Int = safety_diagnostic_coverage_for((g).asil);
    let cur_dc: Int = (g).diagnostic_coverage;
    if cur_dc < req_dc {
        return false;
    }
    let min_ftt: Int = safety_min_ftt_for_asil((g).asil);
    let cur_ftt: Int = (g).ftt;
    if cur_ftt < min_ftt {
        return false;
    }
    return true;
}

pub fn safety_aggregate_asil(goals: &List[SafetyGoal]) -> Int {
    let n: Int = list_len(goals);
    if n == 0 {
        return 0;
    }
    let first = list_get(goals, 0);
    let mut max_v: Int = first.asil;
    let mut i = 1;
    while i < n {
        let g = list_get(goals, i);
        let lv: Int = g.asil;
        let cur_max: Int = max_v;
        if lv > cur_max {
            max_v = lv;
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return max_v;
}

// -------------------------------------------------------------------
// Engine (Pure)
// -------------------------------------------------------------------

pub fn safety_engine_init(engine_id_val: String) -> SafetyEngine {
    return SafetyEngine {
        engine_id: engine_id_val,
        goals: list_new(),
        requirements: list_new(),
        fmeas: list_new(),
        processes: list_new(),
        total_goals: 0,
        accepted_goals: 0,
        is_halted: false,
    };
}

pub fn safety_engine_add_goal(engine: &mut SafetyEngine, g: SafetyGoal) {
    let mut eng = engine;
    let old = eng.goals;
    let mut updated: List[SafetyGoal] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, g);
    eng.goals = updated;
    let inc_one: Int = 1;
    let cur_t: Int = eng.total_goals;
    eng.total_goals = cur_t + inc_one;
    let acceptable: Bool = safety_goal_acceptable(&g);
    if acceptable {
        let cur_a: Int = eng.accepted_goals;
        eng.accepted_goals = cur_a + inc_one;
    }
}

pub fn safety_engine_do_work(engine: &SafetyEngine) -> Int {
    let g_n = list_len((engine).goals);
    let r_n = list_len((engine).requirements);
    let f_n = list_len((engine).fmeas);
    return g_n + r_n + f_n;
}

