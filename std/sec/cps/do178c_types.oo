// # DO-178C Avionics Safety Software Types
//
// Logline: Define Do178Requirement, Do178TraceLink, and Do178Coverage models.
//
// Setup: Core data types and structured models.
//
// Beats:
//   1. Declare DO-178C software requirement representations.
//   2. Declare bidirectional traceability links.
//   3. Declare MCDC and structural coverage records.

pub type DalLevel = struct {
    dal_id: String, level: Int, name: String, failure_condition: String,
    objectives: Int
};
pub type SoftwareRequirement = struct {
    req_id: String, dal: Int, description: String, parent_id: String,
    trace_up: String, trace_down: String, verified: Bool
};
pub type SoftwareTestCase = struct {
    tc_id: String, req_id: String, dal: Int, test_procedure: String,
    expected_result: String, actual_result: String, passed: Bool,
    executed_at: Int, reviewed: Bool
};
pub type SoftwareReview = struct {
    review_id: String, artifact: String, reviewer: String, review_method: Int,
    findings: Int, critical_findings: Int, approved: Bool, timestamp: Int
};
pub type SoftwareConfiguration = struct {
    cci_id: String, problem_report: String, change_description: String,
    baseline_id: String, status: Int, is_valid: Bool
};
pub type DalEngine = struct {
    engine_id: String, requirements: List[SoftwareRequirement],
    test_cases: List[SoftwareTestCase], reviews: List[SoftwareReview],
    configurations: List[SoftwareConfiguration], total_reqs: Int,
    verified_reqs: Int, is_halted: Bool
};
