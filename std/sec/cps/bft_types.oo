// # BFT Core Types
//
// Logline: BftNode, BftMessage, BftPrepare, BftCommit, BftCertificate, BftPolicy, and BftEngine structs.
//
// Setup: RULES.oot 1.4 default-deny; CAP-G6 prepare fan-out prefers &TcpCap. RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. BftNode: node_id, address, pub_key, is_byzantine, is_active, last_seen_ts.
//   2. BftMessage / BftPrepare / BftCommit: per-round message types.
//   3. BftCertificate: prepare and commit sets with quorum_size.
//   4. BftPolicy: required_quorum, max_byzantine, view_change, fail_closed, require_signature.
//   5. BftEngine: aggregates nodes, totals, and is_halted.
//
// residual: signature verification is process_exit in stubs.

pub type BftNode = struct {
    node_id: String,
    address: String,
    pub_key: String,
    is_byzantine: Bool,
    is_active: Bool,
    last_seen_ts: Int,
};

pub type BftMessage = struct {
    msg_id: String,
    view: Int,
    seq: Int,
    sender_id: String,
    msg_type: Int,
    payload: String,
    digest: String,
    signature: String,
    timestamp: Int,
};

pub type BftPrepare = struct {
    prepare_id: String,
    view: Int,
    seq: Int,
    digest: String,
    node_id: String,
};

pub type BftCommit = struct {
    commit_id: String,
    view: Int,
    seq: Int,
    digest: String,
    node_id: String,
};

pub type BftCertificate = struct {
    cert_id: String,
    view: Int,
    seq: Int,
    digest: String,
    prepares: List[BftPrepare],
    commits: List[BftCommit],
    quorum_size: Int,
    is_valid: Bool,
};

pub type BftPolicy = struct {
    policy_id: String,
    required_quorum: Int,
    max_byzantine: Int,
    enable_view_change: Bool,
    require_signature: Bool,
    fail_closed: Bool,
    is_valid: Bool,
};

pub type BftEngine = struct {
    engine_id: String,
    policy: BftPolicy,
    nodes: List[BftNode],
    total_nodes: Int,
    byzantine_count: Int,
    committed: Int,
    rejected: Int,
    is_halted: Bool,
};

pub fn bft_msg_pre_prepare() -> Int {
    return 1;
}

pub fn bft_msg_prepare() -> Int {
    return 2;
}

pub fn bft_msg_commit() -> Int {
    return 3;
}

pub fn bft_msg_view_change() -> Int {
    return 4;
}

pub fn bft_msg_new_view() -> Int {
    return 5;
}
