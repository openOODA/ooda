// ===================================================================
// openOODA Standard Library — ooda::sec::cps::secoc
// AUTOSAR Secure Onboard Communication (SecOC) Module
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

// -------------------------------------------------------------------
// Core SecOC Types
// -------------------------------------------------------------------

pub type SecOcFreshness = struct {
    freshness_id: String,
    counter: Int,
    timestamp: Int,
    trip_counter: Int,
    reset_flag: Bool,
    freshness_value: String,
};

pub type SecOcKey = struct {
    key_id: String,
    name: String,
    algorithm: String,
    key_bytes: String,
    profile: String,
    valid_from: Int,
    valid_until: Int,
};

pub type SecOcAuthenticatedFrame = struct {
    frame_id: String,
    pdu_id: Int,
    payload: String,
    freshness: SecOcFreshness,
    truncated_mac: String,
    full_mac: String,
    timestamp: Int,
};

pub type SecOcVerifyResult = struct {
    verify_id: String,
    pdu_id: Int,
    mac_valid: Bool,
    freshness_valid: Bool,
    reason: String,
    timestamp: Int,
};

pub type SecOcProfile = struct {
    profile_id: String,
    name: String,
    mac_algorithm: String,
    mac_length_bytes: Int,
    freshness_length_bytes: Int,
    require_secure_nv: Bool,
};

pub type SecOcEngine = struct {
    engine_id: String,
    profile: SecOcProfile,
    keys: List[SecOcKey],
    freshness: SecOcFreshness,
    verified: Int,
    rejected: Int,
    is_halted: Bool,
};

// -------------------------------------------------------------------
// MAC Algorithm Constants
// -------------------------------------------------------------------

pub fn secoc_mac_cmac_aes128() -> Int {
    return 1;
}

pub fn secoc_mac_hmac_sha256() -> Int {
    return 2;
}

pub fn secoc_mac_jasmin() -> Int {
    return 3;
}

// -------------------------------------------------------------------
// Profile Constants
// -------------------------------------------------------------------

pub fn secoc_profile_pdu8() -> SecOcProfile {
    return SecOcProfile {
        profile_id: "PDU_8",
        name: "8-byte truncated MAC",
        mac_algorithm: "CMAC-AES-128",
        mac_length_bytes: 8,
        freshness_length_bytes: 4,
        require_secure_nv: true,
    };
}

pub fn secoc_profile_pdu12() -> SecOcProfile {
    return SecOcProfile {
        profile_id: "PDU_12",
        name: "12-byte truncated MAC",
        mac_algorithm: "CMAC-AES-128",
        mac_length_bytes: 12,
        freshness_length_bytes: 4,
        require_secure_nv: true,
    };
}

pub fn secoc_profile_pdu24() -> SecOcProfile {
    return SecOcProfile {
        profile_id: "PDU_24",
        name: "24-byte full MAC",
        mac_algorithm: "CMAC-AES-128",
        mac_length_bytes: 16,
        freshness_length_bytes: 8,
        require_secure_nv: true,
    };
}

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn secoc_freshness_new(freshness_id_val: String, counter_v: Int, ts: Int, trip: Int) -> SecOcFreshness {
    return SecOcFreshness {
        freshness_id: freshness_id_val,
        counter: counter_v,
        timestamp: ts,
        trip_counter: trip,
        reset_flag: false,
        freshness_value: "",
    };
}

pub fn secoc_key_create(
    key_id_val: String,
    algo_val: String,
    bytes_val: String,
    profile_val: String,
    valid_from_v: Int,
    valid_until_v: Int
) -> SecOcKey {
    return SecOcKey {
        key_id: key_id_val,
        name: "",
        algorithm: algo_val,
        key_bytes: bytes_val,
        profile: profile_val,
        valid_from: valid_from_v,
        valid_until: valid_until_v,
    };
}

pub fn secoc_authenticated_frame_new(
    frame_id_val: String,
    pdu_id_v: Int,
    payload_v: String,
    f: SecOcFreshness,
    mac_val: String
) -> SecOcAuthenticatedFrame {
    return SecOcAuthenticatedFrame {
        frame_id: frame_id_val,
        pdu_id: pdu_id_v,
        payload: payload_v,
        freshness: f,
        truncated_mac: mac_val,
        full_mac: "",
        timestamp: 0,
    };
}

// -------------------------------------------------------------------
// Decision Logic (Pure)
// -------------------------------------------------------------------

pub fn secoc_key_valid(key: &SecOcKey, now: Int) -> Bool {
    if (key).valid_from > now {
        return false;
    }
    if (key).valid_until < now {
        return false;
    }
    return true;
}

pub fn secoc_freshness_within_tolerance(local_counter: Int, recv_counter: Int, tolerance: Int) -> Bool {
    if recv_counter < local_counter {
        return false;
    }
    let diff: Int = recv_counter - local_counter;
    if diff > tolerance {
        return false;
    }
    return true;
}

pub fn secoc_mac_length_match(mac: String, expected: Int) -> Bool {
    let l: Int = mac.len();
    if l != expected {
        return false;
    }
    return true;
}

pub fn secoc_verify_mac_stub(truncated_mac: String, expected_mac: String) -> Bool {
    if truncated_mac == expected_mac {
        return true;
    }
    return false;
}

pub fn secoc_verify_frame(
    engine: &SecOcEngine,
    frame: &SecOcAuthenticatedFrame,
    expected_mac: String,
    freshness_tolerance: Int
) -> SecOcVerifyResult {
    let mac_ok: Bool = secoc_verify_mac_stub((frame).truncated_mac, expected_mac);
    let fresh_ok: Bool = secoc_freshness_within_tolerance(
        (engine).freshness.counter,
        (frame).freshness.counter,
        freshness_tolerance
    );
    let reason_v: String = "ok";
    let mut result = SecOcVerifyResult {
        verify_id: "verify",
        pdu_id: (frame).pdu_id,
        mac_valid: mac_ok,
        freshness_valid: fresh_ok,
        reason: reason_v,
        timestamp: 0,
    };
    if mac_ok == false {
        let new_reason: String = "mac mismatch";
        result = SecOcVerifyResult {
            verify_id: "verify",
            pdu_id: (frame).pdu_id,
            mac_valid: mac_ok,
            freshness_valid: fresh_ok,
            reason: new_reason,
            timestamp: 0,
        };
    }
    return result;
}

// -------------------------------------------------------------------
// Engine (Pure)
// -------------------------------------------------------------------

pub fn secoc_engine_init(engine_id_val: String, p: SecOcProfile) -> SecOcEngine {
    let fresh = secoc_freshness_new("fresh-default", 0, 0, 0);
    return SecOcEngine {
        engine_id: engine_id_val,
        profile: p,
        keys: list_new(),
        freshness: fresh,
        verified: 0,
        rejected: 0,
        is_halted: false,
    };
}

pub fn secoc_engine_add_key(engine: &mut SecOcEngine, k: SecOcKey) {
    let mut eng = engine;
    let old = eng.keys;
    let mut updated: List[SecOcKey] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, k);
    eng.keys = updated;
}

pub fn secoc_engine_advance_freshness(engine: &mut SecOcEngine, new_counter: Int) {
    let mut eng = engine;
    eng.freshness.counter = new_counter;
}

pub fn secoc_engine_record_verify(engine: &mut SecOcEngine, ok: Bool) {
    let mut eng = engine;
    let inc_one: Int = 1;
    if ok {
        let cur: Int = eng.verified;
        eng.verified = cur + inc_one;
    } else {
        let cur: Int = eng.rejected;
        eng.rejected = cur + inc_one;
    }
}

pub fn secoc_engine_do_work(engine: &SecOcEngine) -> Int {
    let k = list_len((engine).keys);
    return (engine).verified + (engine).rejected + k;
}

