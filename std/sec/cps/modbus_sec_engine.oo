// # Modbus Engine (Pure)
//
// Logline: Engine constructor, request accounting, violation record, do_work accounting.
//
// Setup: Uses list_new / list_push / list_len / list_get for sessions and violations lists.
//
// Beats:
//   1. modbus_engine_init: bind default policy, empty sessions / violations.
//   2. modbus_engine_record_request: bump total, then allowed or denied.
//   3. modbus_engine_record_violation: append to violations list.
//   4. modbus_engine_do_work: return sessions + violations + allowed.

import "./modbus_sec_types.oo";
import "./modbus_sec_construct.oo";

pub fn modbus_engine_init(engine_id_val: String) -> ModbusEngine {
    return ModbusEngine {
        engine_id: engine_id_val,
        policy: modbus_policy_default(),
        sessions: list_new(),
        violations: list_new(),
        requests_total: 0,
        requests_allowed: 0,
        requests_denied: 0,
        is_halted: false
    };
}

pub fn modbus_engine_record_request(engine: &mut ModbusEngine, allowed_v: Bool) {
    let mut eng = engine;
    let inc_one: Int = 1;
    let cur_t: Int = eng.requests_total;
    eng.requests_total = cur_t + inc_one;
    if allowed_v {
        let cur_a: Int = eng.requests_allowed;
        eng.requests_allowed = cur_a + inc_one;
    } else {
        let cur_d: Int = eng.requests_denied;
        eng.requests_denied = cur_d + inc_one;
    }
}

pub fn modbus_engine_record_violation(engine: &mut ModbusEngine, v: ModbusViolation) {
    let mut eng = engine;
    let old = eng.violations;
    let mut updated: List[ModbusViolation] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, v);
    eng.violations = updated;
}

pub fn modbus_engine_do_work(engine: &ModbusEngine) -> Int {
    let s_n = list_len((engine).sessions);
    let v_n = list_len((engine).violations);
    let allowed: Int = (engine).requests_allowed;
    return s_n + v_n + allowed;
}
