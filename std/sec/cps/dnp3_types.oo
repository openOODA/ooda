// # DNP3 Secure Authentication Types
//
// Logline: Define Dnp3Challenge, Dnp3SessionKey, and Dnp3UserRole structures.
//
// Setup: Core data types and structured models.
//
// Beats:
//   1. Declare DNP3 cryptographic challenge models.
//   2. Declare session key and permission bitmask structures.
//   3. Declare authentication error records.

pub type Dnp3Challenge = struct {
    challenge_id: String, challenge_bytes: String, timestamp: Int,
    sequence_number: Int
};
pub type Dnp3SessionKey = struct {
    key_id: String, update_key: String, session_key: String, derived_at: Int,
    lifetime_seconds: Int, session_index: Int, is_active: Bool
};
pub type Dnp3UserRole = struct {
    role_id: String, user_number: Int, role_name: String, permissions: Int,
    valid_until: Int
};
pub type Dnp3AuthError = struct {
    error_id: String, error_code: Int, reason: String, timestamp: Int,
    source_addr: String
};
pub type Dnp3Auth = struct {
    auth_id: String, user_number: Int, sequence_number: Int, hmac: String,
    challenge_response: String, timestamp: Int, is_valid: Bool
};
pub type Dnp3Policy = struct {
    policy_id: String, require_secure_auth: Bool,
    require_challenge_response: Bool, enforce_key_lifetime: Bool,
    allowed_aggressive_mode: Bool, fail_closed: Bool, is_valid: Bool
};
pub type Dnp3Engine = struct {
    engine_id: String, policy: Dnp3Policy, session_keys: List[Dnp3SessionKey],
    user_roles: List[Dnp3UserRole], auth_errors: List[Dnp3AuthError],
    challenges_issued: Int, auth_failures: Int, auth_successes: Int,
    is_halted: Bool
};
