// # BFT Engine Node Registration, Outcome Recording, and Fail-Closed Stubs
//
// Logline: Initialize engine, append BftNode, record commit/reject, and stubbed broadcast/verify primitives.
//
// Setup: Imports bft_types.oo and bft_construct for the default policy. RULES.oot 1.4 default-deny; CAP-G6.
//
// Beats:
//   1. bft_engine_init: zero counters and load default policy.
//   2. bft_engine_add_node: push BftNode into the list and bump total/byzantine counts.
//   3. bft_engine_record_outcome / bft_engine_do_work: track committed/rejected.
//   4. bft_broadcast_prepare / bft_verify_signature: fail-closed process_exit stubs.
//
// residual: signature verification is process_exit in stubs.

import "./bft_types.oo";
import "./bft_construct.oo";

pub fn bft_engine_init(engine_id_val: String) -> BftEngine {
    return BftEngine {
        engine_id: engine_id_val,
        policy: bft_policy_default(),
        nodes: list_new(),
        total_nodes: 0,
        byzantine_count: 0,
        committed: 0,
        rejected: 0,
        is_halted: false,
    };
}

pub fn bft_engine_add_node(engine: &mut BftEngine, new_node: BftNode) {
    let mut eng = engine;
    let old = eng.nodes;
    let mut updated: List[BftNode] = list_new();
    let cnt = list_len(old);
    let mut i = 0;
    while i < cnt {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, new_node);
    eng.nodes = updated;
    let inc_one: Int = 1;
    let cur_t: Int = eng.total_nodes;
    eng.total_nodes = cur_t + inc_one;
    let is_byz: Bool = (new_node).is_byzantine;
    if is_byz {
        let cur_b: Int = eng.byzantine_count;
        eng.byzantine_count = cur_b + inc_one;
    }
}

pub fn bft_engine_record_outcome(engine: &mut BftEngine, committed_v: Bool) {
    let mut eng = engine;
    let inc_one: Int = 1;
    if committed_v {
        let cur: Int = eng.committed;
        eng.committed = cur + inc_one;
    } else {
        let cur: Int = eng.rejected;
        eng.rejected = cur + inc_one;
    }
}

pub fn bft_engine_do_work(engine: &BftEngine) -> Int {
    let n = list_len((engine).nodes);
    return (engine).committed + (engine).rejected + n;
}

pub fn bft_broadcast_prepare(tcp: &TcpCap, p: &BftPrepare) -> Result[Bool, String] {
    process_exit(1);
    return Err("Unimplemented: BFT prepare broadcast requires TcpCap replica mesh + CryptoCap FFI lowering");
}

pub fn bft_verify_signature(crypto: &CryptoCap, m: &BftMessage) -> Result[Bool, String] {
    process_exit(1);
    return Err("Unimplemented: BFT message signature verify requires CryptoCap FFI lowering");
}
