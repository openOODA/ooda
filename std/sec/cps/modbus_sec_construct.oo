// # Modbus Constructors
//
// Logline: Construct ModbusFrame, ModbusSession, and ModbusPolicy default.
//
// Setup: Default policy: read-only allowed, writes denied, diag denied, rate 100/s, require auth, fail closed.
//
// Beats:
//   1. modbus_frame_create.
//   2. modbus_session_create.
//   3. modbus_policy_default.

import "./modbus_sec_types.oo";

pub fn modbus_frame_create(
    tx_id: Int,
    unit_id_v: Int,
    fc: Int,
    pdu_v: String,
    ts: Int
) -> ModbusFrame {
    return ModbusFrame {
        frame_id: "mb-frame",
        transaction_id: tx_id,
        protocol_id: 0,
        unit_id: unit_id_v,
        function_code: fc,
        pdu: pdu_v,
        timestamp: ts,
        is_valid: true,
    };
}

pub fn modbus_session_create(
    session_id_val: String,
    peer_addr_val: String,
    peer_port_v: Int,
    unit_id_v: Int
) -> ModbusSession {
    return ModbusSession {
        session_id: session_id_val,
        peer_addr: peer_addr_val,
        peer_port: peer_port_v,
        unit_id: unit_id_v,
        authenticated: false,
        authorized_for_writes: false,
        request_count: 0,
        start_ts: 0,
    };
}

pub fn modbus_policy_default() -> ModbusPolicy {
    return ModbusPolicy {
        policy_id: "MODBUS_POLICY_DEFAULT",
        allow_read_only: true,
        allow_write_coils: false,
        allow_write_holding: false,
        allow_diag_funcs: false,
        rate_limit_per_sec: 100,
        require_authorization: true,
        fail_closed: true,
        is_valid: true,
    };
}
