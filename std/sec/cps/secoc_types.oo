// # SecOC Data Types
//
// Logline: SecOcFreshness, SecOcKey, SecOcAuthenticatedFrame, SecOcVerifyResult, SecOcProfile, SecOcEngine struct definitions.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. Freshness, key, frame, verify result, profile, and engine carriers.

pub type SecOcFreshness = struct {
    freshness_id: String,
    counter: Int,
    timestamp: Int,
    trip_counter: Int,
    reset_flag: Bool,
    freshness_value: String,
};

pub type SecOcKey = struct {
    key_id: String,
    name: String,
    algorithm: String,
    key_bytes: String,
    profile: String,
    valid_from: Int,
    valid_until: Int,
};

pub type SecOcAuthenticatedFrame = struct {
    frame_id: String,
    pdu_id: Int,
    payload: String,
    freshness: SecOcFreshness,
    truncated_mac: String,
    full_mac: String,
    timestamp: Int,
};

pub type SecOcVerifyResult = struct {
    verify_id: String,
    pdu_id: Int,
    mac_valid: Bool,
    freshness_valid: Bool,
    reason: String,
    timestamp: Int,
};

pub type SecOcProfile = struct {
    profile_id: String,
    name: String,
    mac_algorithm: String,
    mac_length_bytes: Int,
    freshness_length_bytes: Int,
    require_secure_nv: Bool,
};

pub type SecOcEngine = struct {
    engine_id: String,
    profile: SecOcProfile,
    keys: List[SecOcKey],
    freshness: SecOcFreshness,
    verified: Int,
    rejected: Int,
    is_halted: Bool,
};
