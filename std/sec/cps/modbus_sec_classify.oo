// # Modbus Function Classification
//
// Logline: Pure predicates: is_read_only, is_write_coil, is_write_register, is_dangerous (writes or diag/report).
//
// Setup: Pure functions over function code int. Uses modbus_is_write_coil / modbus_is_write_register for the dangerous composite.
//
// Beats:
//   1. modbus_is_read_only: FC 1..4.
//   2. modbus_is_write_coil: FC 5, 15.
//   3. modbus_is_write_register: FC 6, 16.
//   4. modbus_is_dangerous: write or diag or report slave id.

import "./modbus_sec_fc.oo";

pub fn modbus_is_read_only(fc: Int) -> Bool {
    if fc == 1 {
        return true;
    }
    if fc == 2 {
        return true;
    }
    if fc == 3 {
        return true;
    }
    if fc == 4 {
        return true;
    }
    return false;
}

pub fn modbus_is_write_coil(fc: Int) -> Bool {
    if fc == 5 {
        return true;
    }
    if fc == 15 {
        return true;
    }
    return false;
}

pub fn modbus_is_write_register(fc: Int) -> Bool {
    if fc == 6 {
        return true;
    }
    if fc == 16 {
        return true;
    }
    return false;
}

pub fn modbus_is_dangerous(fc: Int) -> Bool {
    if modbus_is_write_coil(fc) {
        return true;
    }
    if modbus_is_write_register(fc) {
        return true;
    }
    if fc == 8 {
        return true;
    }
    if fc == 17 {
        return true;
    }
    return false;
}
