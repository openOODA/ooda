// # BFT Constructors and Policy Validation
//
// Logline: Build BftNode, BftMessage, BftPrepare, BftCommit, default BftPolicy, and validate policy.
//
// Setup: Imports bft_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. bft_node_create, bft_message_new, bft_prepare_new, bft_commit_new.
//   2. bft_policy_default: quorum=3, f=1, fail-closed.
//   3. bft_policy_validate: required_quorum>0, max_byzantine>=0.
//
// residual: signature verification is process_exit in stubs.

import "./bft_types.oo";

pub fn bft_node_create(
    node_id_val: String,
    addr_val: String,
    pub_key_val: String,
    is_byz: Bool
) -> BftNode {
    return BftNode {
        node_id: node_id_val,
        address: addr_val,
        pub_key: pub_key_val,
        is_byzantine: is_byz,
        is_active: true,
        last_seen_ts: 0
    };
}

pub fn bft_message_new(
    msg_id_val: String,
    view_v: Int,
    seq_v: Int,
    sender_id_val: String,
    msg_type_v: Int,
    payload_val: String
) -> BftMessage {
    return BftMessage {
        msg_id: msg_id_val,
        view: view_v,
        seq: seq_v,
        sender_id: sender_id_val,
        msg_type: msg_type_v,
        payload: payload_val,
        digest: "",
        signature: "",
        timestamp: 0
    };
}

pub fn bft_prepare_new(prepare_id_val: String, view_v: Int, seq_v: Int, digest_val: String, node_id_val: String) -> BftPrepare {
    return BftPrepare {
        prepare_id: prepare_id_val,
        view: view_v,
        seq: seq_v,
        digest: digest_val,
        node_id: node_id_val
    };
}

pub fn bft_commit_new(commit_id_val: String, view_v: Int, seq_v: Int, digest_val: String, node_id_val: String) -> BftCommit {
    return BftCommit {
        commit_id: commit_id_val,
        view: view_v,
        seq: seq_v,
        digest: digest_val,
        node_id: node_id_val
    };
}

pub fn bft_policy_default() -> BftPolicy {
    return BftPolicy {
        policy_id: "BFT_POLICY_DEFAULT",
        required_quorum: 3,
        max_byzantine: 1,
        enable_view_change: true,
        require_signature: true,
        fail_closed: true,
        is_valid: true
    };
}

pub fn bft_policy_validate(p: &BftPolicy) -> Result[Bool, String] {
    if (p).required_quorum < 1 {
        return Err("BFTError: required_quorum must be positive");
    }
    if (p).max_byzantine < 0 {
        return Err("BFTError: max_byzantine cannot be negative");
    }
    return Ok(true);
}
