// # IEC 61508 Safety Integrity Level Module
//
// Logline: Define SilLevel, SilTarget, and SilComponent; track PFH and proof-test intervals.
//
// Setup: RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. sil_level_init: bind pfhd range and rrf range.
//   2. sil_target_init: register required_pfhd and proof_test_interval.
//   3. sil_component_init: bind safe_failure_fraction and diagnostic_coverage.
//   4. sil_classify: gate achieved against claimed SIL.
//
// residual: live SIS proof-test data is process_exit in stubs.

// Core SIL Types

import "./sil_types.oo";

// SIL Level Constants (IEC 61508-1 Table 2 / Table 3)

pub fn sil_level_none() -> Int { return 0; }

pub fn sil_level_sil1() -> Int { return 1; }

pub fn sil_level_sil2() -> Int { return 2; }

pub fn sil_level_sil3() -> Int { return 3; }

pub fn sil_level_sil4() -> Int { return 4; }

// SIL PFHd Thresholds (scaled by 10^-9 per hour; value = fraction * 1e9)
// SIL 1: 100 to 10 (10^-6 to 10^-7)
// SIL 2: 10 to 1 (10^-7 to 10^-8)
// SIL 3: 1 to 0.1 (10^-8 to 10^-9)
// SIL 4: 0.1 to 0.01 (10^-9 to 10^-10)

pub fn sil_pfhd_max(level: Int) -> Int {
    if level == 1  { return 100; }
    if level == 2  { return 10; }
    if level == 3  { return 1; }
    if level == 4  { return 1; }
    return 1000000;
}

pub fn sil_pfhd_min(level: Int) -> Int {
    if level == 1  { return 10; }
    if level == 2  { return 1; }
    if level == 3  { return 1; }
    if level == 4  { return 1; }
    return 0;
}

// Constructors

pub fn sil_level_sil1_struct() -> SilLevel {
    return SilLevel {
        level_id: "SIL_1", level: 1, pfhd_low: 10, pfhd_high: 100, rrf_low: 10000,
        rrf_high: 100000, probability_per_hour: 100
    };
}

pub fn sil_level_sil2_struct() -> SilLevel {
    return SilLevel {
        level_id: "SIL_2", level: 2, pfhd_low: 1, pfhd_high: 10, rrf_low: 1000,
        rrf_high: 10000, probability_per_hour: 10
    };
}

pub fn sil_level_sil3_struct() -> SilLevel {
    return SilLevel {
        level_id: "SIL_3", level: 3, pfhd_low: 1, pfhd_high: 1, rrf_low: 100,
        rrf_high: 1000, probability_per_hour: 1
    };
}

pub fn sil_level_sil4_struct() -> SilLevel {
    return SilLevel {
        level_id: "SIL_4", level: 4, pfhd_low: 1, pfhd_high: 1, rrf_low: 10,
        rrf_high: 100, probability_per_hour: 1
    };
}

pub fn sil_target_create(
    target_id_val: String,
    sil_level_val: Int,
    function_name_val: String,
    pfhd_val: Int,
    proof_test_hours_val: Int
) -> SilTarget {
    let mut acceptable_v: Bool = true;
    let max: Int = sil_pfhd_max(sil_level_val);
    let min: Int = sil_pfhd_min(sil_level_val);
    if pfhd_val > max  { acceptable_v = false; }
    if pfhd_val < min  { acceptable_v = false; }
    return SilTarget {
        target_id: target_id_val, sil_level: sil_level_val,
        function_name: function_name_val, required_pfhd: pfhd_val,
        proof_test_interval_hours: proof_test_hours_val, acceptable: acceptable_v
    };
}

pub fn sil_component_create(
    component_id_val: String,
    name_val: String,
    sil_claimed_val: Int,
    sff_val: Int,
    dc_val: Int
) -> SilComponent {
    return SilComponent {
        component_id: component_id_val, name: name_val,
        sil_claimed: sil_claimed_val, sil_achieved: sil_claimed_val,
        safe_failure_fraction: sff_val, diagnostic_coverage: dc_val, failure_count: 0,
        last_failure_ts: 0
    };
}

// Aggregation & Decision (Pure)

pub fn sil_min_level(levels: &List[Int]) -> Int {
    let n: Int = list_len(levels);
    if n == 0  { return 0; }
    let first: Int = list_get(levels, 0);
    let mut min_v: Int = first;
    let mut i = 1;
    while i < n {
        let lv: Int = list_get(levels, i);
        let cur_min: Int = min_v;
        if lv < cur_min  { min_v = lv; }
        i = i + 1;
    }
    return min_v;
}

pub fn sil_assess_component(component: &SilComponent, target_level: Int) -> Bool {
    let achieved: Int = (component).sil_achieved;
    let dc: Int = (component).diagnostic_coverage;
    let sff: Int = (component).safe_failure_fraction;
    if achieved < target_level  { return false; }
    if dc < 60  { return false; }
    if sff < 60  { return false; }
    return true;
}

pub fn sil_assess_all(components: &List[SilComponent], target_level: Int) -> Bool {
    let n: Int = list_len(components);
    let mut i = 0;
    while i < n {
        let c = list_get(components, i);
        let ok: Bool = sil_assess_component(&c, target_level);
        if ok == false  { return false; }
        i = i + 1;
    }
    return true;
}

pub fn sil_aggregate(components: &List[SilComponent]) -> Int {
    let n: Int = list_len(components);
    if n == 0  { return 0; }
    let first_c = list_get(components, 0);
    let mut min_v: Int = first_c.sil_achieved;
    let mut i = 1;
    while i < n {
        let c = list_get(components, i);
        let lv: Int = c.sil_achieved;
        let cur_min: Int = min_v;
        if lv < cur_min  { min_v = lv; }
        i = i + 1;
    }
    return min_v;
}

// Engine (Pure)

pub fn sil_engine_init(engine_id_val: String, target: SilTarget) -> SilEngine {
    return SilEngine {
        engine_id: engine_id_val, target: target, components: list_new(),
        assessments: list_new(), is_halted: false
    };
}

pub fn sil_engine_add_component(engine: &mut SilEngine, c: SilComponent) {
    let mut eng = engine;
    let old = eng.components;
    let mut updated: List[SilComponent] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        i = i + 1;
    }
    updated = list_push(updated, c);
    eng.components = updated;
}

pub fn sil_engine_run_assessment(engine: &mut SilEngine, assessment_id_val: String) -> SilAssessment {
    let mut eng = engine;
    let lvl: Int = eng.target.sil_level;
    let pfhd: Int = eng.target.required_pfhd;
    let name_s: String = eng.target.function_name;
    let target_id_s: String = eng.target.target_id;
    let agg: Int = sil_aggregate(&eng.components);
    let all_ok: Bool = sil_assess_all(&eng.components, lvl);
    let mut notes_v: String = "ok";
    if all_ok == false  { notes_v = "one or more components below target SIL"; }
    let ass = SilAssessment {
        assessment_id: assessment_id_val,
        target: SilTarget {
            target_id: target_id_s,
            sil_level: lvl,
            function_name: name_s,
            required_pfhd: pfhd,
            proof_test_interval_hours: eng.target.proof_test_interval_hours,
            acceptable: eng.target.acceptable
        },
        components: eng.components,
        aggregate_sil: agg,
        residual_risk_acceptable: all_ok,
        notes: notes_v,
        is_valid: true
    };
    let old = eng.assessments;
    let mut updated: List[SilAssessment] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        i = i + 1;
    }
    updated = list_push(updated, ass);
    eng.assessments = updated;
    return ass;
}

pub fn sil_engine_do_work(engine: &SilEngine) -> Int {
    let n = list_len((engine).components);
    let a = list_len((engine).assessments);
    return n + a;
}

