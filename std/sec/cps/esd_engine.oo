// # ESD Engine (Pure)
//
// Logline: Engine constructor, test record with pass/fail accounting, device list append, do_work accounting.
//
// Setup: Uses list_new / list_push / list_len / list_get for devices and tests lists.
//
// Beats:
//   1. esd_engine_init: bind default policy + environment, empty devices / tests.
//   2. esd_engine_record_test: append test, bump passes or fails.
//   3. esd_engine_add_device: append device.
//   4. esd_engine_do_work: return devices + tests count.

import "./esd_types.oo";
import "./esd_construct.oo";

pub fn esd_engine_init(engine_id_val: String) -> EsdEngine {
    return EsdEngine {
        engine_id: engine_id_val,
        policy: esd_policy_default(),
        environment: esd_environment_default(),
        devices: list_new(),
        tests: list_new(),
        passes: 0,
        fails: 0,
        is_halted: false,
    };
}

pub fn esd_engine_record_test(engine: &mut EsdEngine, t: EsdTest) {
    let mut eng = engine;
    let old = eng.tests;
    let mut updated: List[EsdTest] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, t);
    eng.tests = updated;
    let inc_one: Int = 1;
    if t.passed {
        let cur_p: Int = eng.passes;
        eng.passes = cur_p + inc_one;
    } else {
        let cur_f: Int = eng.fails;
        eng.fails = cur_f + inc_one;
    }
}

pub fn esd_engine_add_device(engine: &mut EsdEngine, d: EsdDevice) {
    let mut eng = engine;
    let old = eng.devices;
    let mut updated: List[EsdDevice] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, d);
    eng.devices = updated;
}

pub fn esd_engine_do_work(engine: &EsdEngine) -> Int {
    let d_n = list_len((engine).devices);
    let t_n = list_len((engine).tests);
    return d_n + t_n;
}
