// # Electrostatic Discharge Protection Types
//
// Logline: Define EsdTest, EsdVoltage, and EsdDevice models.
//
// Setup: Core data types and structured models.
//
// Beats:
//   1. Declare ESD pulse test event definitions.
//   2. Declare discharge voltage and waveform models.
//   3. Declare protection device health structures.

pub type EsdTest = struct {
    test_id: String, test_type: Int, voltage_v: Int, pulse_count: Int,
    contact_discharge: Bool, air_discharge: Bool, passed: Bool, timestamp: Int
};
pub type EsdVoltage = struct {
    voltage_id: String, voltage_kv_x10: Int, polarity: Int, rise_time_ps: Int,
    decay_time_ns: Int, peak_current_a_x100: Int
};
pub type EsdDevice = struct {
    device_id: String, device_type: Int, rated_voltage_v: Int,
    clamping_voltage_v: Int, capacitance_pf: Int, response_time_ns: Int,
    installed: Bool, healthy: Bool
};
pub type EsdEnvironment = struct {
    env_id: String, humidity_pct: Int, temperature_c_x10: Int,
    floor_conductive: Bool, wrist_strap_required: Bool, ionization_active: Bool,
    esd_floor_ohms: Int
};
pub type EsdPolicy = struct {
    policy_id: String, max_contact_kv: Int, max_air_kv: Int,
    require_wrist_strap: Bool, require_ionizer: Bool, fail_closed: Bool,
    is_valid: Bool
};
pub type EsdEngine = struct {
    engine_id: String, policy: EsdPolicy, environment: EsdEnvironment,
    devices: List[EsdDevice], tests: List[EsdTest], passes: Int, fails: Int,
    is_halted: Bool
};
