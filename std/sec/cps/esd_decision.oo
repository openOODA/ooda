// # ESD Pure Decision Logic
//
// Logline: Test pass/fail against contact and air discharge thresholds, environment safety, wrist-strap current range.
//
// Setup: Pure functions; no IO, no CAPs.
//
// Beats:
//   1. esd_test_passes: voltage_kv against policy.max_contact_kv or max_air_kv.
//   2. esd_environment_safe: humidity 30..70, floor conductive or no wrist strap required.
//   3. esd_wrist_strap_check: current in [lower, upper] microamps.

import "./esd_types.oo";
import "./esd_constants.oo";

pub fn esd_test_passes(test: &EsdTest, policy: &EsdPolicy) -> Bool {
    let test_type_v: Int = (test).test_type;
    let raw_v: Int = (test).voltage_v;
    let thousand: Int = 1000;
    let voltage_kv: Int = raw_v / thousand;
    if test_type_v == esd_test_contact_discharge() {
        let max_c: Int = (policy).max_contact_kv;
        if voltage_kv > max_c {
            return false;
        }
        return true;
    }
    if test_type_v == esd_test_air_discharge() {
        let max_a: Int = (policy).max_air_kv;
        if voltage_kv > max_a {
            return false;
        }
        return true;
    }
    return false;
}

pub fn esd_environment_safe(env: &EsdEnvironment) -> Bool {
    if (env).humidity_pct < 30 {
        return false;
    }
    if (env).humidity_pct > 70 {
        return false;
    }
    if (env).floor_conductive == false {
        if (env).wrist_strap_required == true {
            return false;
        }
    }
    return true;
}

pub fn esd_wrist_strap_check(strap_current_uamps: Int, lower_uamps: Int, upper_uamps: Int) -> Bool {
    if strap_current_uamps < lower_uamps {
        return false;
    }
    if strap_current_uamps > upper_uamps {
        return false;
    }
    return true;
}
