// # GOOSE Engine (Pure)
//
// Logline: GooseEngine constructor, subscription append, frame accept/reject accounting, violation record, do_work accounting.
//
// Setup: Uses list_new / list_push / list_len / list_get for subscriptions and violations lists.
//
// Beats:
//   1. goose_engine_init: bind default policy, empty subscriptions/keys/violations.
//   2. goose_engine_add_subscription: append to subscriptions list.
//   3. goose_engine_record_frame: bump frames_seen, then frames_accepted or frames_rejected.
//   4. goose_engine_record_violation: append to violations list.
//   5. goose_engine_do_work: return frames_seen + accepted + rejected.

import "./goose_sec_types.oo";
import "./goose_sec_construct.oo";

pub fn goose_engine_init(engine_id_val: String) -> GooseEngine {
    return GooseEngine {
        engine_id: engine_id_val,
        policy: goose_policy_default(),
        subscriptions: list_new(),
        keys: list_new(),
        violations: list_new(),
        frames_seen: 0,
        frames_accepted: 0,
        frames_rejected: 0,
        is_halted: false,
    };
}

pub fn goose_engine_add_subscription(engine: &mut GooseEngine, s: GooseSubscription) {
    let mut eng = engine;
    let old = eng.subscriptions;
    let mut updated: List[GooseSubscription] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, s);
    eng.subscriptions = updated;
}

pub fn goose_engine_record_frame(engine: &mut GooseEngine, accepted: Bool) {
    let mut eng = engine;
    let inc_one: Int = 1;
    let cur_s: Int = eng.frames_seen;
    eng.frames_seen = cur_s + inc_one;
    if accepted {
        let cur_a: Int = eng.frames_accepted;
        eng.frames_accepted = cur_a + inc_one;
    } else {
        let cur_r: Int = eng.frames_rejected;
        eng.frames_rejected = cur_r + inc_one;
    }
}

pub fn goose_engine_record_violation(engine: &mut GooseEngine, v: GooseViolation) {
    let mut eng = engine;
    let old = eng.violations;
    let mut updated: List[GooseViolation] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, v);
    eng.violations = updated;
}

pub fn goose_engine_do_work(engine: &GooseEngine) -> Int {
    return (engine).frames_seen + (engine).frames_accepted + (engine).frames_rejected;
}
