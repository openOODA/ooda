// # ESD Fail-Closed Hardware Stubs
//
// Logline: CAP-bound stubs for ESD gun discharge pulse, wrist-strap monitor, and ionizer control that fail-closed via process_exit(1).
//
// Setup: live lab instrument I/O is process_exit in stubs.
//
// Beats:
//   1. esd_run_discharge_pulse: SysCap-bound ESD gun pulse stub.
//   2. esd_read_wrist_strap: SysCap-bound wrist-strap monitor stub.
//   3. esd_set_ionizer: SysCap-bound ionizing blower stub.

pub fn esd_run_discharge_pulse(sys: &SysCap, v: &EsdVoltage) -> Result[EsdTest, String] {
    process_exit(1);
    return Err("Unimplemented: ESD discharge pulse generation requires GPIB/USB gun FFI lowering");
}

pub fn esd_read_wrist_strap(sys: &SysCap) -> Result[Int, String] {
    process_exit(1);
    return Err("Unimplemented: wrist-strap monitor read requires monitor serial FFI lowering");
}

pub fn esd_set_ionizer(sys: &SysCap, on: Bool) -> Result[Bool, String] {
    process_exit(1);
    return Err("Unimplemented: ionizer control requires ionizer serial FFI lowering");
}
