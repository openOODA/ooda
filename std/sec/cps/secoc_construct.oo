// # SecOC Constructors
//
// Logline: Construct SecOcFreshness, SecOcKey, and SecOcAuthenticatedFrame from primitives.
//
// Setup: Default reset_flag = false, full_mac = empty, timestamp = 0.
//
// Beats:
//   1. secoc_freshness_new.
//   2. secoc_key_create.
//   3. secoc_authenticated_frame_new.

import "./secoc_types.oo";

pub fn secoc_freshness_new(freshness_id_val: String, counter_v: Int, ts: Int, trip: Int) -> SecOcFreshness {
    return SecOcFreshness {
        freshness_id: freshness_id_val,
        counter: counter_v,
        timestamp: ts,
        trip_counter: trip,
        reset_flag: false,
        freshness_value: "",
    };
}

pub fn secoc_key_create(
    key_id_val: String,
    algo_val: String,
    bytes_val: String,
    profile_val: String,
    valid_from_v: Int,
    valid_until_v: Int
) -> SecOcKey {
    return SecOcKey {
        key_id: key_id_val,
        name: "",
        algorithm: algo_val,
        key_bytes: bytes_val,
        profile: profile_val,
        valid_from: valid_from_v,
        valid_until: valid_until_v,
    };
}

pub fn secoc_authenticated_frame_new(
    frame_id_val: String,
    pdu_id_v: Int,
    payload_v: String,
    f: SecOcFreshness,
    mac_val: String
) -> SecOcAuthenticatedFrame {
    return SecOcAuthenticatedFrame {
        frame_id: frame_id_val,
        pdu_id: pdu_id_v,
        payload: payload_v,
        freshness: f,
        truncated_mac: mac_val,
        full_mac: "",
        timestamp: 0,
    };
}
