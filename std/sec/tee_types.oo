// # TEE Attestation Quote Types & Constants
//
// Logline: Defines the parsed-quote record types and structural constants for AMD SEV-SNP and Apple Secure Enclave hardware attestation quotes, plus helpers to extract measurement hashes, platform versions, chip IDs, and signature blocks.
//
// Setup: Pure data definitions for Stage 15 (Unikernels & Confidential Enclaves). No IO. Decimal literals are used in place of hex because the .oo lexer does not accept 0xNN constants.
//
// Beats:
//   1. Define SevSnpQuoteHeader and AppleSecureEnclaveQuote record types.
//   2. Define TEE vendor IDs and quote version constants as zero-arg functions (the .oo language has no const keyword).
//   3. Provide constructors for both quote types with sane defaults.
//   4. Provide field accessors for measurement, platform_version, chip_id, and signature blocks.

// AMD SEV-SNP quote vendor ID. The on-disk bytes are 0x4E 0x53 0x5F 0x31
// ("NS1_" backwards) read as a 4-byte word. We expose the 4-byte ASCII string
// length and a vendor-id marker Int (decimal 0x4E535F31 = 1314003249) so that
// verifiers can match without needing hex.
pub fn tee_vendor_sev_snp() -> Int { return 1314003249; }
pub fn tee_vendor_apple_se() -> Int { return 1314003249; } // distinct vendor namespace reserved.

// AMD SEV-SNP attestation quote version supported by this parser. The current
// production spec is version 3; we accept versions 1..3 inclusive.
pub fn tee_sev_snp_version_min() -> Int { return 1; }
pub fn tee_sev_snp_version_max() -> Int { return 3; }

// Apple Secure Enclave attestation version. The current production spec is
// version 4; we accept versions 1..4 inclusive.
pub fn tee_apple_se_version_min() -> Int { return 1; }
pub fn tee_apple_se_version_max() -> Int { return 4; }

// Canonical SEV-SNP measurement length (48 bytes = SHA-384 hash digest).
pub fn tee_sev_snp_measurement_len() -> Int { return 48; }

// Canonical Apple Secure Enclave chip-id length (8 bytes).
pub fn tee_apple_se_chip_id_len() -> Int { return 8; }

// Canonical Apple Secure Enclave public-key-hash length (32 bytes = SHA-256).
pub fn tee_apple_se_pubkey_hash_len() -> Int { return 32; }

// Canonical SEV-SNP signature length (512 bytes = 4 * 128-bit r/s pairs).
pub fn tee_sev_snp_signature_len() -> Int { return 512; }

// Canonical Apple Secure Enclave signature length (64 bytes = ECDSA P-256 r/s).
pub fn tee_apple_se_signature_len() -> Int { return 64; }

pub type SevSnpQuoteHeader = struct {
    version: Int,
    guest_svn: Int,
    policy: Int,
    family_id: Int,
    image_id: Int,
    vmpl: Int,
    sig_algo: Int,
    vendor_id: Int,
    measurement: List[Int],
    host_data: List[Int],
    id_key_digest: List[Int],
    report_id: List[Int],
    signature: List[Int],
    is_valid: Bool
};

pub type AppleSecureEnclaveQuote = struct {
    version: Int,
    chip_id: List[Int],
    device_type: List[Int],
    platform_version: List[Int],
    os_version: List[Int],
    public_key_hash: List[Int],
    measurement: List[Int],
    signature: List[Int],
    is_valid: Bool
};

pub fn sev_snp_quote_new() -> SevSnpQuoteHeader {
    let empty_meas: List[Int] = list_new();
    let empty_host: List[Int] = list_new();
    let empty_digest: List[Int] = list_new();
    let empty_report: List[Int] = list_new();
    let empty_sig: List[Int] = list_new();
    return SevSnpQuoteHeader {
        version: 0,
        guest_svn: 0,
        policy: 0,
        family_id: 0,
        image_id: 0,
        vmpl: 0,
        sig_algo: 0,
        vendor_id: tee_vendor_sev_snp(),
        measurement: empty_meas,
        host_data: empty_host,
        id_key_digest: empty_digest,
        report_id: empty_report,
        signature: empty_sig,
        is_valid: false
    };
}

pub fn apple_se_quote_new() -> AppleSecureEnclaveQuote {
    let empty_chip: List[Int] = list_new();
    let empty_dev: List[Int] = list_new();
    let empty_plat: List[Int] = list_new();
    let empty_os: List[Int] = list_new();
    let empty_pkh: List[Int] = list_new();
    let empty_meas: List[Int] = list_new();
    let empty_sig: List[Int] = list_new();
    return AppleSecureEnclaveQuote {
        version: 0,
        chip_id: empty_chip,
        device_type: empty_dev,
        platform_version: empty_plat,
        os_version: empty_os,
        public_key_hash: empty_pkh,
        measurement: empty_meas,
        signature: empty_sig,
        is_valid: false
    };
}

pub fn sev_snp_quote_measurement(q: &SevSnpQuoteHeader) -> List[Int] {
    return (q).measurement;
}

pub fn apple_se_quote_chip_id(q: &AppleSecureEnclaveQuote) -> List[Int] {
    return (q).chip_id;
}

pub fn apple_se_quote_platform_version(q: &AppleSecureEnclaveQuote) -> List[Int] {
    return (q).platform_version;
}

pub fn apple_se_quote_signature(q: &AppleSecureEnclaveQuote) -> List[Int] {
    return (q).signature;
}

pub fn sev_snp_quote_signature(q: &SevSnpQuoteHeader) -> List[Int] {
    return (q).signature;
}
