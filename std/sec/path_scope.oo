// # Path scope (library, not Landlock)
//
// Logline: Decide if a path string sits under a prefix. Fail closed on empty, .., and prefix tricks.
//
// Setup: Pure strings. Does not read_file. Callers still need &FsReadCap.
//
// Beats:
//   1. Empty prefix is denied.
//   2. A .. segment is denied.
//   3. /tmp allows /tmp and /tmp/a, not /tmp2.

import "std/str.oo";

fn has_pct_trav(path: String) -> Bool {
    let n: Int = chars_len(path);
    let mut i: Int = 0;
    while i + 3 <= n {
        if char_at(path, i) == "%" {
            let a: String = char_at(path, i + 1);
            let b: String = char_at(path, i + 2);
            if a == "2" {
                if b == "e" || b == "E" || b == "f" || b == "F" {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

fn has_backslash(path: String) -> Bool {
    let n: Int = chars_len(path);
    let mut i: Int = 0;
    while i < n {
        if char_at(path, i) == "\\" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn has_dotdot(path: String) -> Bool {
    let n: Int = chars_len(path);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(path, i) == "/" {
            if i - start == 2 {
                if char_at(path, start) == "." {
                    if char_at(path, start + 1) == "." {
                        return true;
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

pub fn path_scope_allows(prefix: String, path: String) -> Bool {
    if prefix == "" {
        return false;
    }
    if prefix == ".." {
        return false;
    }
    if path == "" {
        return false;
    }
    if has_backslash(prefix) {
        return false;
    }
    if has_backslash(path) {
        return false;
    }
    if has_pct_trav(prefix) {
        return false;
    }
    if has_pct_trav(path) {
        return false;
    }
    if has_dotdot(prefix) {
        return false;
    }
    if has_dotdot(path) {
        return false;
    }
    if path == prefix {
        return true;
    }
    let n: Int = chars_len(prefix);
    let m: Int = chars_len(path);
    if m <= n {
        return false;
    }
    if str_slice(path, 0, n) != prefix {
        return false;
    }
    if char_at(prefix, n - 1) == "/" {
        return true;
    }
    if char_at(path, n) == "/" {
        return true;
    }
    return false;
}

pub fn path_scope_join(prefix: String, rel: String) -> Result[String, String] {
    if prefix == "" {
        return Err("path scope denied: empty prefix");
    }
    if rel == "" {
        return Err("path scope denied: empty rel");
    }
    if prefix == ".." {
        return Err("path scope denied: ..");
    }
    if has_backslash(prefix) {
        return Err("path scope denied: slash");
    }
    if has_backslash(rel) {
        return Err("path scope denied: slash");
    }
    if has_dotdot(rel) {
        return Err("path scope denied: ..");
    }
    if char_at(rel, 0) == "/" {
        return Err("path scope denied: absolute");
    }
    if has_dotdot(prefix) {
        return Err("path scope denied: ..");
    }
    let n: Int = chars_len(prefix);
    let mut out: String = prefix;
    if char_at(prefix, n - 1) != "/" {
        out = out + "/";
    }
    out = out + rel;
    if !path_scope_allows(prefix, out) {
        return Err("path scope denied: join");
    }
    return Ok(out);
}
