// # Exhaustive Mutation Testing Engine
//
// Logline: Generates AST mutants across relational, arithmetic, and logical operators to evaluate test suite resilience.
//
// Setup: Mutation testing framework introducing systematic synthetic defects to verify test efficacy.
//
// Beats:
//   1. Define MutantKind, AstMutant, and MutationScore structures.
//   2. Apply boundary mutation (< to <=, > to >=, == to !=).
//   3. Apply arithmetic mutation (+ to -, * to /).
//   4. Compute mutation score (killed mutants / total mutants generated).
// RULES.oot 1.4: Pure data AST mutation testing.
// RULES.oot 1.7: Strictly under 256 lines.

pub type AstMutant = struct {
    mutant_id: Int,
    target_line: Int,
    original_op: String,
    mutated_op: String,
    is_killed: Bool
};

pub type MutationScore = struct {
    total_mutants: Int,
    killed_mutants: Int,
    surviving_mutants: Int,
    score_percentage: Int,
    is_hardened: Bool
};

pub fn mutation_engine_mutant_new(id: Int, line: Int, orig: String, mut_op: String) -> AstMutant {
    return AstMutant {
        mutant_id: id,
        target_line: line,
        original_op: orig,
        mutated_op: mut_op,
        is_killed: false
    };
}

pub fn mutation_engine_mutate_relational(op: String) -> String {
    if op == "<" { return "<="; }
    if op == ">" { return ">="; }
    if op == "==" { return "!="; }
    if op == "!=" { return "=="; }
    return op;
}

pub fn mutation_engine_calculate_score(total: Int, killed: Int) -> MutationScore {
    let mut score: Int = 0;
    if total > 0 {
        score = (killed * 100) / total;
    }
    let survived: Int = total - killed;
    let hardened: Bool = score >= 85;
    return MutationScore {
        total_mutants: total,
        killed_mutants: killed,
        surviving_mutants: survived,
        score_percentage: score,
        is_hardened: hardened
    };
}
