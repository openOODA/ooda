// # Prompt Filter Re-export Shim
//
// Logline: Re-export shim for prompt filter submodules; forwards category, action, pattern, and policy constructors.
//
// Setup: Imports prompt_filter_types, prompt_filter_policy, prompt_filter_engine, and prompt_filter_stubs. CWD must be ooda/.
//
// Beats:
//   1. shim_marker_cat_direct: forward injection_cat_direct_override.
//   2. shim_marker_cat_jailbreak: forward injection_cat_jailbreak.
//   3. shim_marker_action_block: forward injection_action_block.
//   4. shim_marker_pattern_create: forward injection_pattern_create.
//
// residual: by-value destub; not a real prompt filter.

// The original ~344-line prompt_filter.oo was split at functional seams
// into 4 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.

import "./prompt_filter_types.oo";
import "./prompt_filter_policy.oo";
import "./prompt_filter_engine.oo";
import "./prompt_filter_stubs.oo";

pub fn shim_marker_cat_direct() -> Int {
    return injection_cat_direct_override();
}

pub fn shim_marker_cat_jailbreak() -> Int {
    return injection_cat_jailbreak();
}

pub fn shim_marker_action_block() -> Int {
    return injection_action_block();
}

pub fn shim_marker_pattern_create() -> InjectionPattern {
    return injection_pattern_create("p1", "name", "regex", 3, 1, 3, "desc");
}

pub fn shim_marker_policy_default() -> PromptPolicy {
    return prompt_policy_default();
}

pub fn shim_marker_policy_strict() -> PromptPolicy {
    return prompt_policy_strict();
}

pub fn shim_marker_stats_new() -> PromptFilterStats {
    return prompt_filter_stats_new();
}

pub fn shim_marker_should_block() -> Bool {
    let pol: PromptPolicy = prompt_policy_default();
    return prompt_should_block(&pol, 90);
}

pub fn shim_marker_above_min() -> Bool {
    let pol: PromptPolicy = prompt_policy_default();
    return prompt_above_min_confidence(&pol, 80);
}

pub fn shim_marker_severity_conf() -> Int {
    return prompt_severity_to_confidence(3);
}

pub fn shim_marker_max_conf() -> Int {
    let mut vals: List[Int] = list_new();
    vals = list_push(vals, 10);
    vals = list_push(vals, 40);
    return prompt_max_confidence(&vals);
}

pub fn shim_marker_default_patterns() -> List[InjectionPattern] {
    return prompt_default_patterns();
}

pub fn shim_marker_engine_init() -> PromptEngine {
    return prompt_engine_init("eng-1");
}

pub fn shim_marker_engine_do_work() -> Int {
    let e: PromptEngine = prompt_engine_init("eng-1");
    return prompt_engine_do_work(&e);
}

pub fn shim_marker_redact() -> String {
    return prompt_redact_pii("ssn 123-45-6789");
}

pub fn shim_marker_scan_llm(http: &HttpCap) -> Result[Bool, String] {
    // CAP-G6: remote LLM scan residual prefers &HttpCap.
    return prompt_scan_with_llm(http, "ignore previous");
}
