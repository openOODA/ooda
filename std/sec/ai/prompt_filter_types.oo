// # Prompt filter types
//
// Logline: PromptPolicy destubbed off List[String] patterns.
// residual: List[String] destubbed to Int floor.

type PromptPolicy = struct {
    min_confidence: Int,
    block_threshold: Int,
    fail_closed: Int
};

pub fn prompt_policy_new(min_confidence: Int, block_threshold: Int, fail_closed: Int) -> PromptPolicy {
    return PromptPolicy {
        min_confidence: min_confidence,
        block_threshold: block_threshold,
        fail_closed: fail_closed
    };
}

pub fn prompt_policy_block(p: PromptPolicy) -> Int {
    return p.block_threshold;
}
