pub fn prompt_scan_with_llm(http: &HttpCap, text: String) -> Result[Bool, String] {
    // COMPILER LIMITATION: openOODA lacks off-policy prompt-injection classifier LLM inference FFI.
    // CAP-G6: remote inference residual prefers &HttpCap (not broad NetCap / not TcpCap alone).
    process_exit(1);
    return Err("Unimplemented: LLM-based prompt injection classifier requires HttpCap remote-inference residual FFI lowering");
}

pub fn prompt_redact_pii(text: String) -> String {
