// # Prompt Filter Decision Logic & Pattern Library
//
// Logline: Decide block vs allow, build built-in patterns, and map severity to confidence.
//
// Setup: Imports prompt_filter_types.oo. RULES.oot 1.4 default-deny; RULES.oot 1.3 fail-closed residual.
//
// Beats:
//   1. prompt_should_block: gate confidence against policy block threshold.
//   2. prompt_above_min_confidence: floor against min_confidence.
//   3. prompt_severity_to_confidence: map severity tag to confidence int.
//   4. prompt_builtin_patterns: return direct, jailbreak, and exfil list.
//
// residual: ML classification is process_exit in prompt_filter_stubs.

// RULES.oot 1.4: Default-deny for privileged effects.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./prompt_filter_types.oo";

// -------------------------------------------------------------------
// Decision Logic (Pure)
// -------------------------------------------------------------------

pub fn prompt_should_block(policy: &PromptPolicy, confidence: Int) -> Bool {
    let th: Int = policy.block_threshold;
    if confidence >= th {
        return true;
    }
    return false;
}

pub fn prompt_above_min_confidence(policy: &PromptPolicy, confidence: Int) -> Bool {
    let mc: Int = policy.min_confidence;
    if confidence >= mc {
        return true;
    }
    return false;
}

pub fn prompt_severity_to_confidence(severity: Int) -> Int {
    if severity >= 4 {
        return 95;
    }
    if severity >= 3 {
        return 80;
    }
    if severity >= 2 {
        return 60;
    }
    if severity >= 1 {
        return 40;
    }
    return 0;
}

pub fn prompt_max_confidence(values: &List[Int]) -> Int {
    let n: Int = list_len(values);
    if n == 0 {
        return 0;
    }
    let first: Int = list_get(values, 0);
    let mut max_v: Int = first;
    let mut i = 1;
    while i < n {
        let v: Int = list_get(values, i);
        let cur: Int = max_v;
        if v > cur {
            max_v = v;
        }
        let ni: Int = i + 1;
        i = ni;
    }
    return max_v;
}

// -------------------------------------------------------------------
// Built-in Pattern Library (Pure Data)
// -------------------------------------------------------------------

pub fn prompt_default_patterns() -> List[InjectionPattern] {
    let mut pats: List[InjectionPattern] = list_new();
    let p1 = injection_pattern_create(
        "PAT_IGNORE_PREVIOUS",
        "ignore previous instructions",
        "(?i)ignore (all )?(previous|prior|above)",
        3,
        injection_cat_direct_override(),
        injection_action_block(),
        "Direct instruction override attempt"
    );
    pats = list_push(pats, p1);
    let p2 = injection_pattern_create(
        "PAT_SYSTEM_PROMPT",
        "system prompt disclosure",
        "(?i)(reveal|show|print) (your|the) (system )?prompt",
        2,
        injection_cat_direct_override(),
        injection_action_block(),
        "Attempt to extract system prompt"
    );
    pats = list_push(pats, p2);
    let p3 = injection_pattern_create(
        "PAT_DAN",
        "DAN jailbreak",
        "(?i)\\bdan\\b.*mode",
        3,
        injection_cat_jailbreak(),
        injection_action_block(),
        "DAN-style jailbreak attempt"
    );
    pats = list_push(pats, p3);
    let p4 = injection_pattern_create(
        "PAT_ROLEPLAY_BYPASS",
        "roleplay bypass",
        "(?i)pretend (to be|you are)",
        2,
        injection_cat_role_play(),
        injection_action_warn(),
        "Roleplay-based bypass attempt"
    );
    pats = list_push(pats, p4);
    let p5 = injection_pattern_create(
        "PAT_INDIRECT",
        "indirect injection",
        "(?i)when (the )?(user|assistant) (asks|says|types)",
        3,
        injection_cat_indirect_injection(),
        injection_action_block(),
        "Indirect injection attempt via tool output"
    );
    pats = list_push(pats, p5);
    return pats;
}
