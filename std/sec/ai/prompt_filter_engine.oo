// ===================================================================
// openOODA Standard Library — ooda::sec::ai::prompt_filter_engine
// Prompt filter engine init, record_scan, do_work
// (split from prompt_filter.oo, Issue #15)
// ===================================================================
// RULES.oot 1.4: Default-deny for privileged effects.
// RULES.oot 1.3: Fail-closed residual for unimplemented builtins.

import "./prompt_filter_types.oo";
import "./prompt_filter_policy.oo";

// -------------------------------------------------------------------
// Engine (Pure)
// -------------------------------------------------------------------

pub fn prompt_engine_init(engine_id_val: String) -> PromptEngine {
    return PromptEngine {
        engine_id: engine_id_val,
        policy: prompt_policy_default(),
        patterns: prompt_default_patterns(),
        scans: list_new(),
        stats: prompt_filter_stats_new(),
        is_halted: false,
    };
}

pub fn prompt_engine_record_scan(engine: &mut PromptEngine, s: PromptScan) {
    let mut eng = engine;
    let old = eng.scans;
    let mut updated: List[PromptScan] = list_new();
    let n = list_len(old);
    let mut i = 0;
    while i < n {
        let cur = list_get(old, i);
        updated = list_push(updated, cur);
        let ni: Int = i + 1;
        i = ni;
    }
    updated = list_push(updated, s);
    eng.scans = updated;
    let inc_one: Int = 1;
    let cur_t: Int = eng.stats.total_scans;
    eng.stats.total_scans = cur_t + inc_one;
    if s.is_injection {
        let cur_b: Int = eng.stats.injections_blocked;
        eng.stats.injections_blocked = cur_b + inc_one;
    }
}

pub fn prompt_engine_do_work(engine: &PromptEngine) -> Int {
    let p = list_len(engine.patterns);
    let s = list_len(engine.scans);
    return p + s + engine.stats.total_scans;
}
