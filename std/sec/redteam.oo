// # Redteam Facade
//
// Logline: Re-exports Redteam data types, operations, engine lifecycle, and fail-closed stubs.
//
// Setup: Pure module shim importing companion submodules.
//
// Beats:
//   1. Import Redteam companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

// into 4 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.
//
// HONESTY: Large-struct cross-module call markers thinned —
// oodac typechecker confuses struct type-ids (e.g. Vulnerability vs
// AttackVector) when the shim monomorphizes too many by-value calls.
// Real implementations remain in split modules (check green alone).
// Import leaf modules only (campaign/engine/stubs pull types transitively).

import "./redteam_campaign.oo";
import "./redteam_engine.oo";
import "./redteam_stubs.oo";

pub fn shim_marker_vector_create() -> AttackVector {
    return attack_vector_create(1, "sqli", "INJECTION", 3, "payload", "db");
}

pub fn shim_marker_vector_risk() -> Int {
    let v: AttackVector = attack_vector_create(1, "sqli", "INJECTION", 3, "payload", "db");
    return attack_vector_calculate_risk(v);
}

pub fn shim_marker_campaign_create() -> RedTeamCampaign {
    return redteam_campaign_create(1, "camp", "target", true);
}

pub fn shim_marker_campaign_score() -> Int {
    let c: RedTeamCampaign = redteam_campaign_create(1, "camp", "target", true);
    return redteam_campaign_get_security_score(&c);
}

pub fn shim_marker_campaign_secure() -> Bool {
    let c: RedTeamCampaign = redteam_campaign_create(1, "camp", "target", true);
    return redteam_campaign_is_secure(&c, 50);
}

pub fn shim_marker_engine_init() -> RedTeamEngine {
    return redteam_engine_init();
}

pub fn shim_marker_engine_evaluate() -> Int {
    let mut e: RedTeamEngine = redteam_engine_init();
    return redteam_engine_evaluate_all(&mut e);
}

pub fn shim_marker_engine_do_work() -> Int {
    let e: RedTeamEngine = redteam_engine_init();
    return redteam_engine_do_work(&e);
}

pub fn shim_marker_shellcode() -> Bool {
    let e: RedTeamEngine = redteam_engine_init();
    return redteam_inject_kernel_shellcode(&e, 0);
}
