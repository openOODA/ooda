// # Attestation types
//
// Logline: Data structures, measurements, policies, tokens, quotes, and reports for hardware attestation.
//
// Setup: Pure data definitions and configuration models.
//
// Beats:
//   1. Define measurement, policy, quote, and token structures.
//   2. Define report and engine state types.
//   3. Implement constructor and helper utilities.

type AttestationMeasurement = struct {
    measurement_id: String,
    component_name: String,
    hash_value: String,
    pcr_index: Int,
    is_valid: Bool
};

type AttestationPolicy = struct {
    policy_id: String,
    require_enclave: Bool,
    allow_debug: Bool,
    min_trust_score: Int,
    strict_pcr_match: Bool,
    fail_closed: Bool,
    is_active: Bool
};

type AttestationQuote = struct {
    quote_id: String,
    nonce: String,
    signature: String,
    public_key_id: String,
    measurements: List[AttestationMeasurement],
    created_at: Int,
    is_trusted: Bool
};

type AttestationToken = struct {
    token_id: String,
    subject: String,
    attester_id: String,
    quote_id: String,
    trust_level: Int,
    issued_at: Int,
    expires_at: Int,
    is_revoked: Bool
};

type AttestationReport = struct {
    report_id: String,
    total_quotes: Int,
    passed_quotes: Int,
    failed_quotes: Int,
    compliance_score: Int,
    is_compliant: Bool,
    timestamp: Int
};

type AttestationEngine = struct {
    engine_id: String,
    policy: AttestationPolicy,
    quotes: List[AttestationQuote],
    tokens: List[AttestationToken],
    verified_count: Int,
    rejected_count: Int,
    revoked_count: Int,
    total_attestations: Int,
    system_halted: Bool
};

pub fn attestation_measurement_create(
    measurement_id: String,
    component_name: String,
    hash_value: String,
    pcr_index: Int
) -> AttestationMeasurement {
    let mut valid: Bool = true;
    if hash_value.len() == 0 { valid = false; }
    if pcr_index < 0 { valid = false; }
    return AttestationMeasurement {
        measurement_id: measurement_id,
        component_name: component_name,
        hash_value: hash_value,
        pcr_index: pcr_index,
        is_valid: valid
    };
}

pub fn attestation_measurement_verify(m: AttestationMeasurement, expected_hash: String) -> Bool {
    if (m).is_valid == false { return false; }
    return (m).hash_value == expected_hash;
}

pub fn attestation_policy_init(
    policy_id: String,
    require_enclave: Bool,
    allow_debug: Bool,
    min_trust_score: Int,
    strict_pcr_match: Bool
) -> AttestationPolicy {
    return AttestationPolicy {
        policy_id: policy_id,
        require_enclave: require_enclave,
        allow_debug: allow_debug,
        min_trust_score: min_trust_score,
        strict_pcr_match: strict_pcr_match,
        fail_closed: true,
        is_active: true
    };
}

pub fn attestation_policy_validate(pol_ref: &AttestationPolicy) -> Bool {
    let act: Bool = (pol_ref).is_active;
    if act == false { return false; }
    let pid: String = (pol_ref).policy_id;
    if pid.len() == 0 { return false; }
    let score: Int = (pol_ref).min_trust_score;
    if score < 0 { return false; }
    if score > 100 { return false; }
    return true;
}

pub fn attestation_token_create(
    token_id: String,
    subject: String,
    attester_id: String,
    quote_id: String,
    trust_level: Int,
    issued_at: Int,
    validity_seconds: Int
) -> AttestationToken {
    return AttestationToken {
        token_id: token_id,
        subject: subject,
        attester_id: attester_id,
        quote_id: quote_id,
        trust_level: trust_level,
        issued_at: issued_at,
        expires_at: issued_at + validity_seconds,
        is_revoked: false
    };
}

pub fn attestation_token_is_valid(tok_ref: &AttestationToken, current_time: Int) -> Bool {
    let rev: Bool = (tok_ref).is_revoked;
    if rev { return false; }
    let exp: Int = (tok_ref).expires_at;
    return current_time <= exp;
}

pub fn attestation_token_revoke(tok_ref: &mut AttestationToken) {
    (tok_ref).is_revoked = true;
}

pub fn attestation_policy_new(min_trust_score: Int, allowed_pcr_mask: Int) -> AttestationPolicy {
    return AttestationPolicy {
        policy_id: "default",
        require_enclave: false,
        allow_debug: false,
        min_trust_score: min_trust_score,
        strict_pcr_match: allowed_pcr_mask > 0,
        fail_closed: true,
        is_active: true
    };
}

pub fn attestation_policy_score(p: AttestationPolicy) -> Int {
    return (p).min_trust_score;
}
