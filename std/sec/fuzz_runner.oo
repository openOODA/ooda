// # Automated Mutation Campaign Runner
//
// Logline: Runs mutation testing campaigns, measures test suite kill rates, and generates resilience reports.
//
// Setup: Fuzzing and mutation harness certifying comprehensive test coverage beyond line coverage.
//
// Beats:
//   1. Define CampaignConfig and CampaignReport structures.
//   2. Execute test harness against each generated code mutant.
//   3. Classify mutants into killed (detected by test failure) vs survived (undetected).
//   4. Enforce strict 85% mutation score threshold for gate approval.
// RULES.oot 1.4: Strict QA verification metrics.
// RULES.oot 1.7: Strictly under 256 lines.

import "sec/mutation_engine.oo";

pub type CampaignConfig = struct {
    max_mutants: Int,
    timeout_ms: Int,
    target_score: Int
};

pub type CampaignReport = struct {
    mutants_tested: Int,
    score: MutationScore,
    passed_gate: Bool
};

pub fn fuzz_runner_config_default() -> CampaignConfig {
    return CampaignConfig {
        max_mutants: 100,
        timeout_ms: 5000,
        target_score: 85
    };
}

pub fn fuzz_runner_run_campaign(cfg: CampaignConfig, killed_count: Int, total_count: Int) -> CampaignReport {
    let score: MutationScore = mutation_engine_calculate_score(total_count, killed_count);
    let ok: Bool = score.is_hardened;
    return CampaignReport {
        mutants_tested: total_count,
        score: score,
        passed_gate: ok
    };
}
