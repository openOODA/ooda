pub fn security_defense_version() -> String {
    return "1.0.0";
}

pub fn security_defense_module_count() -> Int {
    return 50;
}

pub fn security_defense_landlock_ruleset_default() -> LandlockRuleset {
    return landlock_ruleset_new(3);
}

pub fn security_defense_seccomp_filter_default() -> SeccompFilter {
    let def_act: SeccompAction = seccomp_action_kill();
    return seccomp_filter_new(3221225534, def_act); // AUDIT_ARCH_X86_64
}

pub fn security_defense_sandbox_profile_default() -> SandboxProfile {
    return sandbox_profile_rootless_default("default_sandbox");
}

pub fn security_defense_shadow_stack_default() -> ShadowStack {
    return shadow_stack_new(1024);
}

pub fn security_defense_forward_cfi_default() -> ForwardCfiTable {
    return forward_cfi_table_new("TABLE_DEFAULT");
}

pub fn security_defense_backward_cfi_default() -> BackwardCfiContext {
    return backward_cfi_context_new("CTX_DEFAULT");
}

pub fn security_defense_test_fixture() -> MockDefenseFixture {
    return mock_defense_fixture_default();
}
