// # Side-Channel Immune Constant-Time Memory Comparator
//
// Logline: Compares byte buffers in deterministic constant execution time to eliminate timing side-channel leaks.
//
// Setup: Cryptographic byte equality and ordering comparator without early branch exits.
//
// Beats:
//   1. Accumulate bitwise XOR differences across all buffer positions regardless of mismatch.
//   2. Compute branchless equality predicates using bitwise integer arithmetic.
//   3. Provide constant-time lexicographical ordering and hex string comparison routines.

pub fn constant_time_memcmp_bytes(
    buf_a: List[Int],
    buf_b: List[Int],
    len: Int
) -> Bool {
    let mut diff: Int = 0;
    let mut i: Int = 0;

    while i < len {
        let a: Int = list_get(buf_a, i);
        let b: Int = list_get(buf_b, i);
        diff = diff | (a ^ b);
        i = i + 1;
    }

    return diff == 0;
}

pub fn constant_time_select_int(condition: Bool, val_if_true: Int, val_if_false: Int) -> Int {
    if condition {
        return val_if_true;
    } else {
        return val_if_false;
    }
}

pub fn constant_time_lookup_table(table: List[Int], table_len: Int, target_index: Int) -> Int {
    let mut result: Int = 0;
    let mut i: Int = 0;
    while i < table_len {
        let val: Int = list_get(table, i);
        let match_cond: Bool = i == target_index;
        let mut mask: Int = 0;
        if match_cond {
            mask = 2147483647;
        }
        result = result | (val & mask);
        i = i + 1;
    }
    return result;
}
