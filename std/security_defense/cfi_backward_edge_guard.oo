// # Backward-Edge Control Flow Integrity (CFI) Guard
//
// Logline: Enforces backward-edge CFI (landing pads, Branch Target Identification, and return target validation).
//
// Setup: Validates return instructions against safe landing pads and active call frame tokens.
//
// Beats:
//   1. Define ReturnLandingPad, ReturnTag, and BackwardCfiContext descriptors.
//   2. Register authorized function return sites and instruction landing pad tokens.
//   3. Validate backward edge transitions to thwart jump/return oriented exploits.

pub type ReturnLandingPad = struct {
    return_site_address: Int,
    caller_function_id: Int,
    token_value: Int,
    is_valid: Bool
};

pub type BackwardCfiContext = struct {
    context_id: String,
    landing_pads: List[ReturnLandingPad],
    pad_count: Int,
    violations: Int,
    enforce_landing_pad: Bool
};

pub fn backward_cfi_context_new(ctx_id: String) -> BackwardCfiContext {
    let empty_pads: List[ReturnLandingPad] = list_new();
    return BackwardCfiContext {
        context_id: ctx_id,
        landing_pads: empty_pads,
        pad_count: 0,
        violations: 0,
        enforce_landing_pad: true
    };
}

pub fn backward_cfi_register_pad(
    ctx: &mut BackwardCfiContext,
    site_addr: Int,
    fn_id: Int,
    token: Int
) -> Bool {
    let pad = ReturnLandingPad {
        return_site_address: site_addr,
        caller_function_id: fn_id,
        token_value: token,
        is_valid: true
    };
    (ctx).landing_pads = list_push((ctx).landing_pads, pad);
    (ctx).pad_count = (ctx).pad_count + 1;
    return true;
}

pub fn backward_cfi_verify_return(
    ctx: &mut BackwardCfiContext,
    ret_target_addr: Int,
    expected_token: Int
) -> Bool {
    let count: Int = (ctx).pad_count;
    let mut i: Int = 0;
    while i < count {
        let pad: ReturnLandingPad = list_get((ctx).landing_pads, i);
        if pad.return_site_address == ret_target_addr {
            if (ctx).enforce_landing_pad && pad.token_value != expected_token {
                (ctx).violations = (ctx).violations + 1;
                return false; // Token mismatch (BTI / CET fail)
            }
            return pad.is_valid;
        }
        i = i + 1;
    }
    (ctx).violations = (ctx).violations + 1;
    return false; // Unregistered return landing pad
}
