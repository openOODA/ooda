// # SafeStack Dual-Stack Memory Allocator & Splitter
//
// Logline: Partitions execution state into a Safe Stack (return addresses, non-addressed locals) and an Unsafe Stack (buffers, arrays).
//
// Setup: Thwarts stack-based control-flow hijacking by physically separating vulnerable buffers from critical control state.
//
// Beats:
//   1. Define SafeStackFrame, UnsafeStackBuffer, and DualStackContext descriptors.
//   2. Allocate local scalar variables to the Safe Stack and arrays/strings to the Unsafe Stack.
//   3. Validate dual stack bounds and prevent unsafe stack overflow propagation to safe control frames.

pub type SafeStackFrame = struct {
    frame_id: Int,
    safe_sp: Int,
    return_address: Int,
    saved_fp: Int,
};

pub type UnsafeStackBuffer = struct {
    buffer_id: Int,
    unsafe_sp: Int,
    size_bytes: Int,
    is_addressed: Bool,
};

pub type DualStackContext = struct {
    safe_stack_base: Int,
    safe_stack_size: Int,
    unsafe_stack_base: Int,
    unsafe_stack_size: Int,
    safe_frames: List[SafeStackFrame],
    safe_count: Int,
    unsafe_buffers: List[UnsafeStackBuffer],
    unsafe_count: Int,
};

pub fn dual_stack_context_new(
    s_base: Int,
    s_sz: Int,
    u_base: Int,
    u_sz: Int
) -> DualStackContext {
    let empty_frames: List[SafeStackFrame] = list_new();
    let empty_bufs: List[UnsafeStackBuffer] = list_new();
    return DualStackContext {
        safe_stack_base: s_base,
        safe_stack_size: s_sz,
        unsafe_stack_base: u_base,
        unsafe_stack_size: u_sz,
        safe_frames: empty_frames,
        safe_count: 0,
        unsafe_buffers: empty_bufs,
        unsafe_count: 0,
    };
}

pub fn dual_stack_push_safe_frame(
    ctx: &mut DualStackContext,
    sp: Int,
    ret_addr: Int,
    fp: Int
) -> Bool {
    if sp < (ctx).safe_stack_base || sp > ((ctx).safe_stack_base + (ctx).safe_stack_size) {
        return false;
    }
    let frame_id: Int = (ctx).safe_count + 1;
    let f = SafeStackFrame {
        frame_id: frame_id,
        safe_sp: sp,
        return_address: ret_addr,
        saved_fp: fp,
    };
    (ctx).safe_frames = list_push((ctx).safe_frames, f);
    (ctx).safe_count = (ctx).safe_count + 1;
    return true;
}

pub fn dual_stack_alloc_unsafe_buffer(
    ctx: &mut DualStackContext,
    sp: Int,
    sz: Int
) -> Bool {
    if sp < (ctx).unsafe_stack_base || (sp + sz) > ((ctx).unsafe_stack_base + (ctx).unsafe_stack_size) {
        return false;
    }
    let buf_id: Int = (ctx).unsafe_count + 1;
    let b = UnsafeStackBuffer {
        buffer_id: buf_id,
        unsafe_sp: sp,
        size_bytes: sz,
        is_addressed: true,
    };
    (ctx).unsafe_buffers = list_push((ctx).unsafe_buffers, b);
    (ctx).unsafe_count = (ctx).unsafe_count + 1;
    return true;
}

pub fn dual_stack_is_isolated(ctx: &DualStackContext) -> Bool {
    // Verify safe stack memory and unsafe stack memory do not overlap
    let s_start: Int = (ctx).safe_stack_base;
    let s_end: Int = (ctx).safe_stack_base + (ctx).safe_stack_size;
    let u_start: Int = (ctx).unsafe_stack_base;
    let u_end: Int = (ctx).unsafe_stack_base + (ctx).unsafe_stack_size;

    if s_end <= u_start || u_end <= s_start {
        return true;
    }
    return false;
}
