// # Dead Code & Junk Byte Emitter
//
// Logline: Injects non-functional instruction sequences, unreachable basic blocks, and junk bytes to confuse disassemblers.
//
// Setup: Standalone binary obfuscation emitter for anti-static analysis.
//
// Beats:
//   1. Define JunkPattern (NOP sleds, neutral arithmetic, conditional dead branches).
//   2. Generate benign dead instruction blocks that cancel out register effects.
//   3. Insert opaque branch traps jumping over randomized junk data payloads.

pub type JunkInstruction = struct {
    mnemonic: String,
    size_bytes: Int,
    is_dead_branch: Bool
};

pub type DeadCodeGenerator = struct {
    seed: Int,
    junk_blocks_emitted: Int,
    total_junk_bytes: Int
};

pub fn dead_code_generator_new(seed: Int) -> DeadCodeGenerator {
    return DeadCodeGenerator {
        seed: seed,
        junk_blocks_emitted: 0,
        total_junk_bytes: 0
    };
}

pub fn dead_code_emit_neutral_sequence(
    gen: &mut DeadCodeGenerator,
    reg_id: Int
) -> List[JunkInstruction] {
    let mut seq: List[JunkInstruction] = list_new();

    // 1. ADD reg, 0
    let insn1 = JunkInstruction { mnemonic: "add_imm", size_bytes: 3, is_dead_branch: false };
    seq = list_push(seq, insn1);

    // 2. OR reg, reg
    let insn2 = JunkInstruction { mnemonic: "or_reg", size_bytes: 2, is_dead_branch: false };
    seq = list_push(seq, insn2);

    // 3. NOP
    let insn3 = JunkInstruction { mnemonic: "nop", size_bytes: 1, is_dead_branch: false };
    seq = list_push(seq, insn3);

    (gen).junk_blocks_emitted = (gen).junk_blocks_emitted + 1;
    (gen).total_junk_bytes = (gen).total_junk_bytes + 6;

    return seq;
}

pub fn dead_code_emit_opaque_skip(
    gen: &mut DeadCodeGenerator,
    junk_payload_len: Int
) -> List[JunkInstruction] {
    let mut seq: List[JunkInstruction] = list_new();

    // Conditional branch that is always taken: JZ over payload
    let branch_insn = JunkInstruction {
        mnemonic: "jz_always",
        size_bytes: 2,
        is_dead_branch: true
    };
    seq = list_push(seq, branch_insn);

    // Junk payload instructions
    let junk_payload = JunkInstruction {
        mnemonic: "junk_bytes",
        size_bytes: junk_payload_len,
        is_dead_branch: false
    };
    seq = list_push(seq, junk_payload);

    (gen).junk_blocks_emitted = (gen).junk_blocks_emitted + 1;
    (gen).total_junk_bytes = (gen).total_junk_bytes + 2 + junk_payload_len;

    return seq;
}
