// # Equivalent Instruction Substitutor & Metamorphic Engine
//
// Logline: Applies algebraic identities and equivalent opcode transforms to mutate binary instruction streams.
//
// Setup: Standalone compiler pass for instruction substitution and metamorphism.
//
// Beats:
//   1. Define InstructionPattern, SubstitutionRule, and InstructionSequence descriptors.
//   2. Substitute common idioms (e.g., zeroing registers via xor/sub/mov, add/sub by constants).
//   3. Apply multi-instruction expansion and compression passes while maintaining register state.

pub type Instruction = struct {
    opcode: Int, // 0: MOV_IMM, 1: XOR_REG, 2: SUB_REG, 3: ADD_IMM, 4: SUB_IMM, 5: NOP
    dst_reg: Int,
    src_reg: Int,
    imm_val: Int,
};

pub type SubstitutionRule = struct {
    rule_id: Int,
    match_opcode: Int,
    requires_zero_imm: Bool,
    replacement_opcode: Int,
};

pub type InstructionStream = struct {
    instructions: List[Instruction],
    count: Int,
    mutations_applied: Int,
};

pub fn instruction_stream_new() -> InstructionStream {
    let empty_insns: List[Instruction] = list_new();
    return InstructionStream {
        instructions: empty_insns,
        count: 0,
        mutations_applied: 0,
    };
}

pub fn instruction_stream_append(
    stream: &mut InstructionStream,
    op: Int,
    dst: Int,
    src: Int,
    imm: Int
) -> Bool {
    let insn = Instruction {
        opcode: op,
        dst_reg: dst,
        src_reg: src,
        imm_val: imm,
    };
    (stream).instructions = list_push((stream).instructions, insn);
    (stream).count = (stream).count + 1;
    return true;
}

pub fn instruction_substitute_zeroing(stream: &mut InstructionStream, seed: Int) -> Int {
    let count: Int = (stream).count;
    let mut i: Int = 0;
    let mut substituted: Int = 0;
    let mut new_list: List[Instruction] = list_new();

    while i < count {
        let insn: Instruction = list_get((stream).instructions, i);
        let op: Int = (insn).opcode;
        let imm: Int = (insn).imm_val;
        let dst: Int = (insn).dst_reg;

        // If MOV reg, 0 -> can substitute with XOR reg, reg or SUB reg, reg
        if op == 0 && imm == 0 {
            let choice: Int = (seed + i) % 2;
            let mut new_op: Int = 1; // XOR
            if choice == 1 {
                new_op = 2; // SUB
            }
            let sub_insn = Instruction {
                opcode: new_op,
                dst_reg: dst,
                src_reg: dst,
                imm_val: 0,
            };
            new_list = list_push(new_list, sub_insn);
            substituted = substituted + 1;
        } else {
            new_list = list_push(new_list, insn);
        }
        i = i + 1;
    }

    (stream).instructions = new_list;
    (stream).mutations_applied = (stream).mutations_applied + substituted;
    return substituted;
}
