// # Basic Block Permutator & Control Flow Diversity Engine
//
// Logline: Shuffles basic blocks in compilation units and inserts unconditional branch fixups to thwart signature analysis.
//
// Setup: Standalone compiler pass for binary layout diversification and topological ordering preservation.
//
// Beats:
//   1. Define BasicBlock, BranchFixup, and FunctionCfg structures.
//   2. Permute basic block layout order using pseudo-random seeds.
//   3. Insert explicit jump instructions to preserve original runtime control flow semantics.

pub type BasicBlock = struct {
    block_id: Int,
    original_index: Int,
    inst_count: Int,
    fallthrough_target: Int,
    branch_target: Int
};

pub type FunctionCfg = struct {
    function_name: String,
    blocks: List[BasicBlock],
    block_count: Int,
    entry_block_id: Int,
    is_permuted: Bool
};

pub fn function_cfg_new(name: String, entry_id: Int) -> FunctionCfg {
    let empty_blocks: List[BasicBlock] = list_new();
    return FunctionCfg {
        function_name: name,
        blocks: empty_blocks,
        block_count: 0,
        entry_block_id: entry_id,
        is_permuted: false
    };
}

pub fn function_cfg_add_block(
    cfg: &mut FunctionCfg,
    id: Int,
    insts: Int,
    ft: Int,
    br: Int
) -> Bool {
    let idx: Int = (cfg).block_count;
    let b = BasicBlock {
        block_id: id,
        original_index: idx,
        inst_count: insts,
        fallthrough_target: ft,
        branch_target: br
    };
    (cfg).blocks = list_push((cfg).blocks, b);
    (cfg).block_count = (cfg).block_count + 1;
    return true;
}

pub fn basic_block_permute_cfg(cfg: &mut FunctionCfg, seed: Int) -> Bool {
    let count: Int = (cfg).block_count;
    if count <= 1 {
        return true;
    }
    let mut permuted: List[BasicBlock] = list_new();
    let mut offset: Int = (seed % count);
    if offset < 0 { offset = 0 - offset; }

    let mut i: Int = 0;
    while i < count {
        let pick_idx: Int = (i + offset) % count;
        let b: BasicBlock = list_get((cfg).blocks, pick_idx);
        permuted = list_push(permuted, b);
        i = i + 1;
    }

    (cfg).blocks = permuted;
    (cfg).is_permuted = true;
    return true;
}

pub fn function_cfg_total_instructions(cfg: &FunctionCfg) -> Int {
    let count: Int = (cfg).block_count;
    let mut tot: Int = 0;
    let mut i: Int = 0;
    while i < count {
        let b: BasicBlock = list_get((cfg).blocks, i);
        let ic: Int = (b).inst_count;
        tot = tot + ic;
        i = i + 1;
    }
    return tot;
}
