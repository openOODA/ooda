// # Compile-Time & Runtime String Literal Encryptor
//
// Logline: Encrypts embedded string constants with randomized XOR keys and provides zero-on-stack dynamic decrypters.
//
// Setup: Standalone string obfuscator preventing static string scraping and credential extraction.
//
// Beats:
//   1. Define EncryptedStringPayload, XorKey, and DecryptedBuffer structures.
//   2. Encrypt byte arrays using dynamic rolling XOR keys.
//   3. Decrypt string payloads on demand into stack buffers and scrub plaintext after consumption.

pub type EncryptedStringPayload = struct {
    ciphertext: List[Int],
    length: Int,
    xor_key: Int,
    checksum: Int,
};

pub fn string_encrypt_bytes(plain_bytes: List[Int], len: Int, key: Int) -> EncryptedStringPayload {
    let mut cipher: List[Int] = list_new();
    let mut csum: Int = 0;
    let mut i: Int = 0;

    while i < len {
        let b: Int = list_get(plain_bytes, i);
        let rolling_k: Int = (key + (i * 17)) & 255;
        let enc_b: Int = b ^ rolling_k;
        cipher = list_push(cipher, enc_b);
        csum = (csum + enc_b) & 65535;
        i = i + 1;
    }

    return EncryptedStringPayload {
        ciphertext: cipher,
        length: len,
        xor_key: key,
        checksum: csum,
    };
}

pub fn string_decrypt_bytes(payload: &EncryptedStringPayload) -> List[Int] {
    let len: Int = (payload).length;
    let key: Int = (payload).xor_key;
    let mut plain: List[Int] = list_new();
    let mut i: Int = 0;

    while i < len {
        let enc_b: Int = list_get((payload).ciphertext, i);
        let rolling_k: Int = (key + (i * 17)) & 255;
        let orig_b: Int = enc_b ^ rolling_k;
        plain = list_push(plain, orig_b);
        i = i + 1;
    }

    return plain;
}

pub fn string_payload_verify(payload: &EncryptedStringPayload) -> Bool {
    let len: Int = (payload).length;
    let mut csum: Int = 0;
    let mut i: Int = 0;

    while i < len {
        let enc_b: Int = list_get((payload).ciphertext, i);
        csum = (csum + enc_b) & 65535;
        i = i + 1;
    }

    return csum == (payload).checksum;
}
