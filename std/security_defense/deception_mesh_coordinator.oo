// # Cyber Deception Mesh & Breadcrumb Canary Coordinator
//
// Logline: Plants synthetic canary credentials, fake API keys, and deceptive database records to pinpoint internal intruders.
//
// Setup: Standalone deception mesh coordinator for active defense and early-stage adversary detection.
//
// Beats:
//   1. Define DeceptionBreadcrumb (type: API_KEY, DB_TOKEN, ENV_VAR, CERT), CanaryToken descriptors.
//   2. Deploy canary tokens across configuration and filesystem surfaces.
//   3. Monitor token usage alerts to detect credential stuffing and lateral movement.

pub type DeceptionBreadcrumb = struct {
    breadcrumb_id: Int,
    token_type: Int, // 0: API_KEY, 1: DB_CONN_STR, 2: ENV_VAR, 3: SSH_KEY
    token_value: String,
    target_location: String,
    is_touched: Bool,
};

pub type DeceptionMesh = struct {
    breadcrumbs: List[DeceptionBreadcrumb],
    breadcrumb_count: Int,
    intrusion_alerts: Int,
};

pub fn deception_mesh_new() -> DeceptionMesh {
    let empty_crumbs: List[DeceptionBreadcrumb] = list_new();
    return DeceptionMesh {
        breadcrumbs: empty_crumbs,
        breadcrumb_count: 0,
        intrusion_alerts: 0,
    };
}

pub fn deception_mesh_plant_breadcrumb(
    mesh: &mut DeceptionMesh,
    id: Int,
    t_type: Int,
    val: String,
    loc: String
) -> Bool {
    let crumb = DeceptionBreadcrumb {
        breadcrumb_id: id,
        token_type: t_type,
        token_value: val,
        target_location: loc,
        is_touched: false,
    };
    (mesh).breadcrumbs = list_push((mesh).breadcrumbs, crumb);
    (mesh).breadcrumb_count = (mesh).breadcrumb_count + 1;
    return true;
}

pub fn deception_mesh_check_token_access(
    mesh: &mut DeceptionMesh,
    observed_token_val: String
) -> Bool {
    let count: Int = (mesh).breadcrumb_count;
    let mut i: Int = 0;
    while i < count {
        let mut c: DeceptionBreadcrumb = list_get((mesh).breadcrumbs, i);
        if (c).token_value == observed_token_val {
            (c).is_touched = true;
            (mesh).intrusion_alerts = (mesh).intrusion_alerts + 1;
            return true; // Breadcrumb accessed by adversary!
        }
        i = i + 1;
    }
    return false;
}
