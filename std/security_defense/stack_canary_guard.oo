// # Stack Canary & Guard Page Integrity Verifier
//
// Logline: Generates randomized and null-terminator stack guard canaries and validates buffer smashing protections.
//
// Setup: Standalone compiler-level stack smashing protection (SSP) simulator.
//
// Beats:
//   1. Define CanaryTypes (Random, Terminator, Null, Custom) and stack frame metadata.
//   2. Generate entropy-infused canary integers with terminator byte defense.
//   3. Validate stack frames against canary corruption before epilogue execution.

pub type StackCanary = struct {
    canary_type: Int, // 0: RANDOM, 1: TERMINATOR (0x000AFF00), 2: NULL
    canary_value: Int,
    frame_address: Int,
    is_armed: Bool,
};

pub type StackGuardMonitor = struct {
    master_canary_seed: Int,
    active_canaries: List[StackCanary],
    active_count: Int,
    smash_detected_count: Int,
};

pub fn stack_canary_generate_terminator() -> Int {
    // 0x000AFF00 -> null byte (0x00), line feed (0x0A), 0xFF, null byte
    return 720640;
}

pub fn stack_canary_generate_random(seed: Int, frame_addr: Int) -> Int {
    let mixed: Int = (seed * 1103515245 + frame_addr * 12345 + 54321) & 2147483647;
    // Force highest byte or lowest byte to contain null byte to stop strcpy
    let masked: Int = mixed & 2147418112; // Clear lower bits
    return masked;
}

pub fn stack_guard_monitor_new(seed: Int) -> StackGuardMonitor {
    let empty_canaries: List[StackCanary] = list_new();
    return StackGuardMonitor {
        master_canary_seed: seed,
        active_canaries: empty_canaries,
        active_count: 0,
        smash_detected_count: 0,
    };
}

pub fn stack_guard_arm_frame(
    mon: &mut StackGuardMonitor,
    frame_addr: Int,
    canary_type: Int
) -> Int {
    let mut val: Int = 0;
    if canary_type == 1 {
        val = stack_canary_generate_terminator();
    } else {
        val = stack_canary_generate_random((mon).master_canary_seed, frame_addr);
    }
    let sc = StackCanary {
        canary_type: canary_type,
        canary_value: val,
        frame_address: frame_addr,
        is_armed: true,
    };
    (mon).active_canaries = list_push((mon).active_canaries, sc);
    (mon).active_count = (mon).active_count + 1;
    return val;
}

pub fn stack_guard_verify_frame(
    mon: &mut StackGuardMonitor,
    frame_addr: Int,
    observed_val: Int
) -> Bool {
    let count: Int = (mon).active_count;
    let mut i: Int = 0;
    while i < count {
        let sc: StackCanary = list_get((mon).active_canaries, i);
        if sc.frame_address == frame_addr && sc.is_armed {
            if sc.canary_value == observed_val {
                return true;
            } else {
                (mon).smash_detected_count = (mon).smash_detected_count + 1;
                return false; // Buffer overflow stack smash detected!
            }
        }
        i = i + 1;
    }
    return false;
}
