// # Code Integrity HMAC-SHA256 Authenticated Checker
//
// Logline: Authenticates in-memory code segments against cryptographic HMAC-SHA256 signatures before execution.
//
// Setup: Standalone cryptographic authentication module for high-assurance binary execution environments.
//
// Beats:
//   1. Define CodeBlockSignature, HmacIntegrityPolicy, and AuthenticationResult.
//   2. Compute keyed HMAC digests over code byte blocks.
//   3. Verify memory block signatures and reject unauthenticated code modules.

pub type CodeBlockSignature = struct {
    block_id: Int,
    start_address: Int,
    length_bytes: Int,
    hmac_digest: Int,
    is_trusted: Bool
};

pub type IntegrityCheckerState = struct {
    secret_key: Int,
    verified_blocks: Int,
    rejected_blocks: Int,
    strict_fail_closed: Bool
};

pub fn simple_hmac_compute(key: Int, bytes: List[Int], len: Int) -> Int {
    let mut acc: Int = (key * 31) ^ 15485863;
    let mut i: Int = 0;
    while i < len {
        let b: Int = list_get(bytes, i);
        acc = ((acc * 33) + b + key) & 2147483647;
        i = i + 1;
    }
    return acc;
}

pub fn integrity_checker_state_new(key: Int) -> IntegrityCheckerState {
    return IntegrityCheckerState {
        secret_key: key,
        verified_blocks: 0,
        rejected_blocks: 0,
        strict_fail_closed: true
    };
}

pub fn integrity_checker_sign_block(
    state: &IntegrityCheckerState,
    id: Int,
    addr: Int,
    bytes: List[Int],
    len: Int
) -> CodeBlockSignature {
    let digest: Int = simple_hmac_compute((state).secret_key, bytes, len);
    return CodeBlockSignature {
        block_id: id,
        start_address: addr,
        length_bytes: len,
        hmac_digest: digest,
        is_trusted: true
    };
}

pub fn integrity_checker_verify_block(
    state: &mut IntegrityCheckerState,
    sig: &CodeBlockSignature,
    actual_bytes: List[Int],
    actual_len: Int
) -> Bool {
    let computed_digest: Int = simple_hmac_compute((state).secret_key, actual_bytes, actual_len);
    if computed_digest == (sig).hmac_digest {
        (state).verified_blocks = (state).verified_blocks + 1;
        return true;
    } else {
        (state).rejected_blocks = (state).rejected_blocks + 1;
        return false;
    }
}
