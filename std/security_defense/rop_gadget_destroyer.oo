// # ROP/JOP Gadget Destroyer & Bytecode Padder
//
// Logline: Detects unintended ROP/JOP gadget byte patterns (0xC3, 0xFF 0x25, 0xFF 0xE0) in binary sequences and injects alignment padding.
//
// Setup: Standalone exploit mitigation filter eliminating accidental return/jump instructions.
//
// Beats:
//   1. Define GadgetSignature (ret=0xC3, call_rax=0xFF 0xD0, jmp_rax=0xFF 0xE0).
//   2. Scan compiled byte streams for unintended gadget substrings across instruction boundaries.
//   3. Insert safe multi-byte NOPs or reorder operands to break unintended gadget opcodes.

pub type BytecodeBuffer = struct {
    bytes: List[Int],
    length: Int,
    gadgets_neutralized: Int
};

pub fn bytecode_buffer_new() -> BytecodeBuffer {
    let empty_b: List[Int] = list_new();
    return BytecodeBuffer {
        bytes: empty_b,
        length: 0,
        gadgets_neutralized: 0
    };
}

pub fn bytecode_buffer_append(buf: &mut BytecodeBuffer, b: Int) {
    (buf).bytes = list_push((buf).bytes, b & 255);
    (buf).length = (buf).length + 1;
}

pub fn rop_gadget_destroyer_scan_and_pad(buf: &mut BytecodeBuffer) -> Int {
    let len: Int = (buf).length;
    if len < 2 {
        return 0;
    }
    let mut cleaned: List[Int] = list_new();
    let mut neutralized: Int = 0;
    let mut i: Int = 0;

    while i < len {
        let b: Int = list_get((buf).bytes, i);
        // Check for 0xC3 (RET) occurring in immediate or offset positions (not end of function)
        if b == 195 && i < (len - 1) { // 195 is 0xC3
            // Insert safe NOP (0x90 = 144) to break alignment
            cleaned = list_push(cleaned, 144);
            cleaned = list_push(cleaned, b);
            neutralized = neutralized + 1;
        } else {
            cleaned = list_push(cleaned, b);
        }
        i = i + 1;
    }

    (buf).bytes = cleaned;
    (buf).length = list_len(cleaned);
    (buf).gadgets_neutralized = (buf).gadgets_neutralized + neutralized;
    return neutralized;
}
