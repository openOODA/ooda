// # Virtual Machine & Sandbox Environment Detector
//
// Logline: Probes CPU hypervisor bits, hardware MAC addresses, known sandbox files, and VM vendor signatures.
//
// Setup: Standalone sandbox detection module for dynamic analysis evasion defense.
//
// Beats:
//   1. Define VmProbeResult, HypervisorSignature, and SandboxArtifact descriptors.
//   2. Match hypervisor vendor strings ("VMwareVMware", "KVMKVMKVM", "Microsoft Hv", "XenVMMXenVMM").
//   3. Aggregate sandbox indicators into confidence scores and evasion action triggers.

pub type HypervisorSignature = struct {
    vendor_name: String,
    hypervisor_bit: Bool,
    cpuid_leaf_val: Int,
};

pub type SandboxDetectionResult = struct {
    vm_detected: Bool,
    confidence_score: Int, // 0 to 100
    matched_vendor: String,
    sandbox_artifacts_found: Int,
};

pub fn hypervisor_signature_match(vendor_str: String) -> String {
    if vendor_str == "VMwareVMware" { return "VMWARE"; }
    if vendor_str == "KVMKVMKVM\0\0\0" { return "KVM"; }
    if vendor_str == "Microsoft Hv" { return "HYPERV"; }
    if vendor_str == "XenVMMXenVMM" { return "XEN"; }
    if vendor_str == "prl hyperv  " { return "PARALLELS"; }
    if vendor_str == "TCGTCGTCGTCG" { return "QEMU"; }
    return "UNKNOWN";
}

pub fn evaluate_sandbox_environment(
    hypervisor_bit_set: Bool,
    vendor_str: String,
    mac_prefix_match: Bool,
    known_file_count: Int
) -> SandboxDetectionResult {
    let mut score: Int = 0;
    if hypervisor_bit_set { score = score + 40; }
    let vendor: String = hypervisor_signature_match(vendor_str);
    if vendor != "UNKNOWN" { score = score + 40; }
    if mac_prefix_match { score = score + 20; }
    if known_file_count > 0 { score = score + 20; }

    if score > 100 { score = 100; }
    let detected: Bool = score >= 50;

    return SandboxDetectionResult {
        vm_detected: detected,
        confidence_score: score,
        matched_vendor: vendor,
        sandbox_artifacts_found: known_file_count,
    };
}
