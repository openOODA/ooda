// # Register Allocator Randomizer & Calling Convention Shuffler
//
// Logline: Randomizes hardware register assignment priority in the compiler backend to break binary fingerprinting.
//
// Setup: Standalone compiler register allocation diversity pass.
//
// Beats:
//   1. Define RegisterClass, PhysicalRegister, and RegisterAllocationMap structures.
//   2. Shuffle register preference order per function using deterministic seeds.
//   3. Map virtual registers to randomized physical register sets while observing ABI constraints.

pub type PhysicalRegister = struct {
    reg_id: Int, // 0: RAX, 1: RBX, 2: RCX, 3: RDX, 4: RSI, 5: RDI, 6: R8, 7: R9, etc.
    is_callee_saved: Bool,
    is_argument: Bool,
    is_reserved: Bool,
};

pub type RegisterAllocationMap = struct {
    virtual_reg_id: Int,
    assigned_phys_reg: Int,
};

pub type RandomRegContext = struct {
    seed: Int,
    available_regs: List[PhysicalRegister],
    reg_count: Int,
    allocations: List[RegisterAllocationMap],
    alloc_count: Int,
};

pub fn random_reg_context_new(seed: Int) -> RandomRegContext {
    let mut regs: List[PhysicalRegister] = list_new();
    // Add general purpose registers (RAX, RBX, RCX, RDX, RSI, RDI, R8, R9)
    let r0 = PhysicalRegister { reg_id: 0, is_callee_saved: false, is_argument: false, is_reserved: false };
    let r1 = PhysicalRegister { reg_id: 1, is_callee_saved: true,  is_argument: false, is_reserved: false };
    let r2 = PhysicalRegister { reg_id: 2, is_callee_saved: false, is_argument: true,  is_reserved: false };
    let r3 = PhysicalRegister { reg_id: 3, is_callee_saved: false, is_argument: true,  is_reserved: false };
    let r4 = PhysicalRegister { reg_id: 4, is_callee_saved: false, is_argument: true,  is_reserved: false };
    let r5 = PhysicalRegister { reg_id: 5, is_callee_saved: false, is_argument: true,  is_reserved: false };
    let r6 = PhysicalRegister { reg_id: 6, is_callee_saved: false, is_argument: true,  is_reserved: false };
    let r7 = PhysicalRegister { reg_id: 7, is_callee_saved: false, is_argument: true,  is_reserved: false };

    regs = list_push(regs, r0);
    regs = list_push(regs, r1);
    regs = list_push(regs, r2);
    regs = list_push(regs, r3);
    regs = list_push(regs, r4);
    regs = list_push(regs, r5);
    regs = list_push(regs, r6);
    regs = list_push(regs, r7);

    let empty_allocs: List[RegisterAllocationMap] = list_new();
    return RandomRegContext {
        seed: seed,
        available_regs: regs,
        reg_count: 8,
        allocations: empty_allocs,
        alloc_count: 0,
    };
}

pub fn random_reg_allocate_vreg(
    ctx: &mut RandomRegContext,
    vreg: Int
) -> Int {
    let count: Int = (ctx).reg_count;
    let chosen_idx: Int = ((ctx).seed + vreg * 7) % count;
    let chosen_reg: PhysicalRegister = list_get((ctx).available_regs, chosen_idx);
    let phys_id: Int = (chosen_reg).reg_id;

    let alloc = RegisterAllocationMap {
        virtual_reg_id: vreg,
        assigned_phys_reg: phys_id,
    };
    (ctx).allocations = list_push((ctx).allocations, alloc);
    (ctx).alloc_count = (ctx).alloc_count + 1;

    return phys_id;
}
