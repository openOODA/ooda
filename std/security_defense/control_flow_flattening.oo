// # Control Flow Flattening & Dispatcher State Machine
//
// Logline: Flattens hierarchical control flow graphs into switch-dispatcher state machines (Chenxi Wang algorithm).
//
// Setup: Transforms structured if/while control flows into flat state machine loops with encrypted state indices.
//
// Beats:
//   1. Define FlattenedBlock, StateTransition, and FlattenedFunction descriptors.
//   2. Encode basic block jump logic into state variable transitions.
//   3. Build centralized dispatcher loops to obscure high-level function control logic.

pub type FlattenedBlock = struct {
    state_id: Int,
    inst_count: Int,
    next_state_default: Int,
    conditional_next_state: Int,
    is_terminal: Bool
};

pub type FlattenedFunction = struct {
    function_name: String,
    initial_state: Int,
    exit_state: Int,
    blocks: List[FlattenedBlock],
    block_count: Int,
    dispatcher_switch_var: Int
};

pub fn flattened_function_new(name: String, init_st: Int, exit_st: Int) -> FlattenedFunction {
    let empty_blocks: List[FlattenedBlock] = list_new();
    return FlattenedFunction {
        function_name: name,
        initial_state: init_st,
        exit_state: exit_st,
        blocks: empty_blocks,
        block_count: 0,
        dispatcher_switch_var: init_st
    };
}

pub fn flattened_function_add_block(
    ff: &mut FlattenedFunction,
    st_id: Int,
    insts: Int,
    next_st: Int,
    cond_next: Int,
    is_term: Bool
) -> Bool {
    let b = FlattenedBlock {
        state_id: st_id,
        inst_count: insts,
        next_state_default: next_st,
        conditional_next_state: cond_next,
        is_terminal: is_term
    };
    (ff).blocks = list_push((ff).blocks, b);
    (ff).block_count = (ff).block_count + 1;
    return true;
}

pub fn flattened_function_step(
    ff: &mut FlattenedFunction,
    branch_cond: Bool
) -> Bool {
    let cur_state: Int = (ff).dispatcher_switch_var;
    if cur_state == (ff).exit_state {
        return false; // Reached exit
    }

    let count: Int = (ff).block_count;
    let mut i: Int = 0;
    while i < count {
        let b: FlattenedBlock = list_get((ff).blocks, i);
        if (b).state_id == cur_state {
            if (b).is_terminal {
                (ff).dispatcher_switch_var = (ff).exit_state;
                return false;
            }
            if branch_cond && (b).conditional_next_state != -1 {
                (ff).dispatcher_switch_var = (b).conditional_next_state;
            } else {
                (ff).dispatcher_switch_var = (b).next_state_default;
            }
            return true;
        }
        i = i + 1;
    }

    // State not found -> terminate
    (ff).dispatcher_switch_var = (ff).exit_state;
    return false;
}
