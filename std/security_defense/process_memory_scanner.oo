// # In-Memory Shellcode & Signature Pattern Scanner
//
// Logline: Scans process memory buffers for malicious byte sequences (NOP sleds, egg hunters, known shellcode stubs).
//
// Setup: Standalone in-memory scanner for detecting injected code and malicious payloads.
//
// Beats:
//   1. Define MaliciousPattern, ScanResult, and MemoryScannerState descriptors.
//   2. Scan byte buffers for consecutive NOP sequences (0x90 sleds).
//   3. Match multi-byte shellcode signatures and calculate memory region threat scores.

pub type MaliciousPattern = struct {
    pattern_id: Int,
    signature_name: String,
    signature_bytes: List[Int],
    sig_len: Int,
    severity: Int
};

pub type MemoryScannerState = struct {
    patterns: List[MaliciousPattern],
    pattern_count: Int,
    threats_detected: Int
};

pub fn memory_scanner_new() -> MemoryScannerState {
    let empty_patterns: List[MaliciousPattern] = list_new();
    return MemoryScannerState {
        patterns: empty_patterns,
        pattern_count: 0,
        threats_detected: 0
    };
}

pub fn memory_scanner_add_pattern(
    scanner: &mut MemoryScannerState,
    id: Int,
    name: String,
    sig: List[Int],
    len: Int,
    sev: Int
) -> Bool {
    let p = MaliciousPattern {
        pattern_id: id,
        signature_name: name,
        signature_bytes: sig,
        sig_len: len,
        severity: sev
    };
    (scanner).patterns = list_push((scanner).patterns, p);
    (scanner).pattern_count = (scanner).pattern_count + 1;
    return true;
}

pub fn memory_scanner_detect_nop_sled(bytes: List[Int], len: Int, min_consecutive: Int) -> Bool {
    let mut consecutive_nops: Int = 0;
    let mut i: Int = 0;
    while i < len {
        let b: Int = list_get(bytes, i);
        if b == 144 { // 0x90 NOP
            consecutive_nops = consecutive_nops + 1;
            if consecutive_nops >= min_consecutive {
                return true;
            }
        } else {
            consecutive_nops = 0;
        }
        i = i + 1;
    }
    return false;
}
