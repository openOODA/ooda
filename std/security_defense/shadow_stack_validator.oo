// # Shadow Stack Return Address Validator
//
// Logline: Implements dual-stack return address validation to thwart Return-Oriented Programming (ROP) attacks.
//
// Setup: Standalone hardware-assisted / software shadow stack integrity monitor.
//
// Beats:
//   1. Define ShadowStack frames, return address slots, and stack pointer state.
//   2. Push return addresses during call frames to both primary and shadow stacks.
//   3. Validate return addresses before ret instructions and trigger faults on ROP corruption.

pub type ShadowFrame = struct {
    frame_id: Int,
    function_id: Int,
    return_address: Int,
    canary: Int,
};

pub type ShadowStack = struct {
    stack_limit: Int,
    frames: List[ShadowFrame],
    depth: Int,
    violations: Int,
    is_locked: Bool,
};

pub fn shadow_stack_new(max_depth: Int) -> ShadowStack {
    let empty_frames: List[ShadowFrame] = list_new();
    return ShadowStack {
        stack_limit: max_depth,
        frames: empty_frames,
        depth: 0,
        violations: 0,
        is_locked: false,
    };
}

pub fn shadow_stack_push(
    stack: &mut ShadowStack,
    fn_id: Int,
    ret_addr: Int,
    canary_val: Int
) -> Bool {
    if (stack).is_locked || (stack).depth >= (stack).stack_limit {
        return false;
    }
    let next_id: Int = (stack).depth + 1;
    let frame = ShadowFrame {
        frame_id: next_id,
        function_id: fn_id,
        return_address: ret_addr,
        canary: canary_val,
    };
    (stack).frames = list_push((stack).frames, frame);
    (stack).depth = (stack).depth + 1;
    return true;
}

pub fn shadow_stack_validate_and_pop(
    stack: &mut ShadowStack,
    primary_ret_addr: Int,
    primary_canary: Int
) -> Bool {
    if (stack).depth <= 0 {
        (stack).violations = (stack).violations + 1;
        return false;
    }
    let top_idx: Int = (stack).depth - 1;
    let top_frame: ShadowFrame = list_get((stack).frames, top_idx);

    if top_frame.return_address != primary_ret_addr {
        (stack).violations = (stack).violations + 1;
        (stack).is_locked = true; // ROP attack detected!
        return false;
    }

    if top_frame.canary != primary_canary {
        (stack).violations = (stack).violations + 1;
        (stack).is_locked = true; // Stack canary tampering!
        return false;
    }

    (stack).depth = (stack).depth - 1;
    return true;
}

pub fn shadow_stack_is_healthy(stack: &ShadowStack) -> Bool {
    return ((stack).violations == 0) && ((stack).is_locked == false);
}
