// # Linux Capability Delegation & Privilege Dropping Auditor
//
// Logline: Audits Linux capabilities bounding sets, verifies least-privilege drops, and tracks delegation chains.
//
// Setup: Standalone POSIX capability auditing and permission transition verifier.
//
// Beats:
//   1. Define standard Linux capabilities (CAP_SYS_ADMIN, CAP_NET_BIND, CAP_SYS_PTRACE, etc.).
//   2. Model effective, permitted, inheritable, and bounding capability sets.
//   3. Validate safe privilege drop sequences and detect residual dangerous capabilities.

pub type CapabilitySet = struct {
    cap_chown: Bool,            // CAP 0
    cap_dac_override: Bool,     // CAP 1
    cap_dac_read_search: Bool,  // CAP 2
    cap_fowner: Bool,           // CAP 3
    cap_fsetid: Bool,           // CAP 4
    cap_kill: Bool,             // CAP 5
    cap_setgid: Bool,           // CAP 6
    cap_setuid: Bool,           // CAP 7
    cap_net_bind_service: Bool, // CAP 10
    cap_net_admin: Bool,        // CAP 12
    cap_net_raw: Bool,          // CAP 13
    cap_sys_ptrace: Bool,       // CAP 19
    cap_sys_admin: Bool,        // CAP 21
    cap_sys_rawio: Bool,        // CAP 17
    cap_sys_module: Bool       // CAP 16
};

pub type ProcessCapabilityState = struct {
    pid: Int,
    effective: CapabilitySet,
    permitted: CapabilitySet,
    inheritable: CapabilitySet,
    bounding: CapabilitySet,
    is_non_root: Bool
};

pub fn capability_set_empty() -> CapabilitySet {
    return CapabilitySet {
        cap_chown: false,
        cap_dac_override: false,
        cap_dac_read_search: false,
        cap_fowner: false,
        cap_fsetid: false,
        cap_kill: false,
        cap_setgid: false,
        cap_setuid: false,
        cap_net_bind_service: false,
        cap_net_admin: false,
        cap_net_raw: false,
        cap_sys_ptrace: false,
        cap_sys_admin: false,
        cap_sys_rawio: false,
        cap_sys_module: false
    };
}

pub fn capability_set_has_dangerous(caps: &CapabilitySet) -> Bool {
    if (caps).cap_sys_admin { return true; }
    if (caps).cap_sys_module { return true; }
    if (caps).cap_sys_rawio { return true; }
    if (caps).cap_sys_ptrace { return true; }
    if (caps).cap_dac_override { return true; }
    return false;
}

pub fn process_cap_state_new(pid: Int) -> ProcessCapabilityState {
    let empty_caps: CapabilitySet = capability_set_empty();
    return ProcessCapabilityState {
        pid: pid,
        effective: empty_caps,
        permitted: empty_caps,
        inheritable: empty_caps,
        bounding: empty_caps,
        is_non_root: true
    };
}

pub fn capability_audit_verify_drop(state: &ProcessCapabilityState) -> Bool {
    if (state).is_non_root == false {
        return false;
    }
    // Effective set must not have dangerous capabilities
    if capability_set_has_dangerous(&(state).effective) {
        return false;
    }
    // Bounding set must not contain cap_sys_admin or cap_sys_module
    if (state).bounding.cap_sys_admin || (state).bounding.cap_sys_module {
        return false;
    }
    return true;
}
