// # Hardware Breakpoint & Debug Register (DR0-DR7) Detector
//
// Logline: Inspects x86/ARM hardware debug registers (DR0..DR3, DR6, DR7) and traps to detect active hardware watchpoints.
//
// Setup: Standalone low-level anti-debugging inspection module.
//
// Beats:
//   1. Define DebugRegistersState, WatchpointConfig, and BreakpointDetectionReport.
//   2. Parse DR0-DR3 address registers and DR7 control enable bits.
//   3. Detect active hardware breakpoints and watchpoint traps on data/code access.

pub type DebugRegistersState = struct {
    dr0: Int,
    dr1: Int,
    dr2: Int,
    dr3: Int,
    dr6_status: Int,
    dr7_control: Int,
};

pub type HardwareBreakpointReport = struct {
    hardware_bp_detected: Bool,
    active_dr0: Bool,
    active_dr1: Bool,
    active_dr2: Bool,
    active_dr3: Bool,
    trap_triggered: Bool,
};

pub fn debug_registers_state_clean() -> DebugRegistersState {
    return DebugRegistersState {
        dr0: 0,
        dr1: 0,
        dr2: 0,
        dr3: 0,
        dr6_status: 0,
        dr7_control: 0,
    };
}

pub fn hardware_breakpoint_inspect(regs: &DebugRegistersState) -> HardwareBreakpointReport {
    let dr0_act: Bool = (regs).dr0 != 0;
    let dr1_act: Bool = (regs).dr1 != 0;
    let dr2_act: Bool = (regs).dr2 != 0;
    let dr3_act: Bool = (regs).dr3 != 0;

    // DR7 lower 8 bits contain local/global enable flags for DR0-DR3
    let dr7_enabled: Bool = ((regs).dr7_control & 255) != 0;

    // DR6 bit 0..3 indicates trap trigger condition
    let trap_hit: Bool = ((regs).dr6_status & 15) != 0;

    let detected: Bool = (dr0_act || dr1_act || dr2_act || dr3_act || dr7_enabled || trap_hit);

    return HardwareBreakpointReport {
        hardware_bp_detected: detected,
        active_dr0: dr0_act,
        active_dr1: dr1_act,
        active_dr2: dr2_act,
        active_dr3: dr3_act,
        trap_triggered: trap_hit,
    };
}
