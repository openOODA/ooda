// # Forward-Edge Control Flow Integrity (CFI) Guard
//
// Logline: Enforces type-safe indirect call dispatch and validates function target addresses against static CFI tables.
//
// Setup: Validates call sites against expected function signatures and authorized target whitelists.
//
// Beats:
//   1. Define CFITarget, CallSiteSignature, and ForwardCfiTable descriptors.
//   2. Compute deterministic signature hashes for function argument types and return types.
//   3. Validate runtime indirect call target addresses against authorized signature sets.

pub type CFITarget = struct {
    function_address: Int,
    signature_hash: Int,
    is_valid_entry_point: Bool,
};

pub type ForwardCfiTable = struct {
    table_id: String,
    targets: List[CFITarget],
    target_count: Int,
    allowed_signatures: List[Int],
    sig_count: Int,
    violations: Int,
};

pub fn forward_cfi_table_new(id: String) -> ForwardCfiTable {
    let empty_targets: List[CFITarget] = list_new();
    let empty_sigs: List[Int] = list_new();
    return ForwardCfiTable {
        table_id: id,
        targets: empty_targets,
        target_count: 0,
        allowed_signatures: empty_sigs,
        sig_count: 0,
        violations: 0,
    };
}

pub fn cfi_compute_signature(arg_count: Int, ret_type_id: Int, is_variadic: Bool) -> Int {
    let mut sig: Int = (arg_count * 31) + (ret_type_id * 101);
    if is_variadic {
        sig = sig + 997;
    }
    return sig & 2147483647;
}

pub fn forward_cfi_add_target(
    tbl: &mut ForwardCfiTable,
    fn_addr: Int,
    sig_hash: Int
) -> Bool {
    let t = CFITarget {
        function_address: fn_addr,
        signature_hash: sig_hash,
        is_valid_entry_point: true,
    };
    (tbl).targets = list_push((tbl).targets, t);
    (tbl).target_count = (tbl).target_count + 1;
    return true;
}

pub fn forward_cfi_validate_call(
    tbl: &mut ForwardCfiTable,
    target_addr: Int,
    expected_sig_hash: Int
) -> Bool {
    let count: Int = (tbl).target_count;
    let mut i: Int = 0;
    while i < count {
        let t: CFITarget = list_get((tbl).targets, i);
        if t.function_address == target_addr {
            if t.is_valid_entry_point && t.signature_hash == expected_sig_hash {
                return true; // Valid CFI forward call target
            } else {
                (tbl).violations = (tbl).violations + 1;
                return false; // Signature mismatch / invalid target entry
            }
        }
        i = i + 1;
    }
    (tbl).violations = (tbl).violations + 1;
    return false; // Target not found in CFI whitelist
}
