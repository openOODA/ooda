// # Active Defense & Exploit Mitigation Test Fixtures and Mock Stubs
//
// Logline: Provides mock attack payloads, simulated ROP gadgets, synthetic trace records, and deterministic test fixtures.
//
// Setup: Standalone test fixture module for the security defense verification suite.
//
// Beats:
//   1. Define MockExploitPayload, MockTelemetryFeed, and MockSecurityContext structures.
//   2. Generate synthetic NOP sleds, shellcode byte sequences, and tampered stack frames.
//   3. Provide deterministic mock sandbox profiles and audit fixtures for automated testing.

pub type MockExploitPayload = struct {
    payload_name: String,
    raw_bytes: List[Int],
    length: Int,
    target_vulnerability: String,
};

pub type MockDefenseFixture = struct {
    fixture_id: String,
    simulated_aslr_base: Int,
    test_canary_value: Int,
    is_hardened_env: Bool,
};

pub fn mock_exploit_payload_nop_sled(sled_len: Int) -> MockExploitPayload {
    let mut bytes: List[Int] = list_new();
    let mut i: Int = 0;
    while i < sled_len {
        bytes = list_push(bytes, 144); // 0x90
        i = i + 1;
    }
    // Append shellcode trailer: 0xCC (INT3 / breakpoint trap)
    bytes = list_push(bytes, 204);

    return MockExploitPayload {
        payload_name: "NOP_SLED_TRAILER",
        raw_bytes: bytes,
        length: sled_len + 1,
        target_vulnerability: "BUFFER_OVERFLOW",
    };
}

pub fn mock_defense_fixture_default() -> MockDefenseFixture {
    return MockDefenseFixture {
        fixture_id: "DEFENSE_FIXTURE_X86_64_LINUX",
        simulated_aslr_base: 140723869270016, // 0x7FFF00000000
        test_canary_value: 720640,
        is_hardened_env: true,
    };
}

pub fn mock_generate_random_key_bytes(seed: Int, count: Int) -> List[Int] {
    let mut k_list: List[Int] = list_new();
    let mut i: Int = 0;
    let mut cur: Int = seed;
    while i < count {
        cur = (cur * 1103515245 + 12345) & 2147483647;
        let b: Int = cur & 255;
        k_list = list_push(k_list, b);
        i = i + 1;
    }
    return k_list;
}

pub fn mock_is_security_test_suite_ready() -> Bool {
    return true;
}
