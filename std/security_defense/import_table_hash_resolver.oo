// # Dynamic Import Address Table (IAT) Hash Resolver
//
// Logline: Resolves dynamic library symbols and APIs via compile-time hashes (ROR13 / Murmur3) to conceal Import Tables.
//
// Setup: Standalone API obfuscation resolver eliminating static import strings from binary headers.
//
// Beats:
//   1. Define HashedSymbol, ExportDirectoryEntry, and DynamicResolverContext descriptors.
//   2. Compute ROR13 (Rotate Right 13) deterministic symbol hashes over ASCII names.
//   3. Locate matching export entries and resolve function addresses without string literals.

pub type HashedSymbol = struct {
    symbol_hash: Int,
    resolved_address: Int,
    is_resolved: Bool,
};

pub type ExportDirectoryEntry = struct {
    name_hash: Int,
    virtual_address: Int,
};

pub type DynamicResolverContext = struct {
    module_base: Int,
    exports: List[ExportDirectoryEntry],
    export_count: Int,
};

pub fn ror13_hash_step(current_hash: Int, ch: Int) -> Int {
    // 32-bit ROR 13: ((hash >> 13) | (hash << 19)) + ch
    let hi: Int = current_hash / 8192; // hash >> 13
    let lo: Int = (current_hash * 524288) & 2147483647; // hash << 19 approx
    let rotated: Int = (hi | lo) & 2147483647;
    return (rotated + ch) & 2147483647;
}

pub fn compute_symbol_ror13_hash(name_chars: List[Int], len: Int) -> Int {
    let mut h: Int = 0;
    let mut i: Int = 0;
    while i < len {
        let ch: Int = list_get(name_chars, i);
        h = ror13_hash_step(h, ch);
        i = i + 1;
    }
    return h;
}

pub fn dynamic_resolver_context_new(base: Int) -> DynamicResolverContext {
    let empty_exports: List[ExportDirectoryEntry] = list_new();
    return DynamicResolverContext {
        module_base: base,
        exports: empty_exports,
        export_count: 0,
    };
}

pub fn dynamic_resolver_add_export(
    ctx: &mut DynamicResolverContext,
    hash: Int,
    va: Int
) -> Bool {
    let entry = ExportDirectoryEntry {
        name_hash: hash,
        virtual_address: va,
    };
    (ctx).exports = list_push((ctx).exports, entry);
    (ctx).export_count = (ctx).export_count + 1;
    return true;
}

pub fn dynamic_resolver_find_symbol(
    ctx: &DynamicResolverContext,
    target_hash: Int
) -> Int {
    let count: Int = (ctx).export_count;
    let mut i: Int = 0;
    while i < count {
        let e: ExportDirectoryEntry = list_get((ctx).exports, i);
        if (e).name_hash == target_hash {
            return (ctx).module_base + (e).virtual_address;
        }
        i = i + 1;
    }
    return 0; // Not found
}
