// # Sub-THz and Terahertz Path Loss Models
//
// Logline: Calculates Close-In (CI) and Floating-Intercept (FI) path loss with atmospheric molecular absorption for 100-1000 GHz.
//
// Setup: Pure standard library implementation of 3GPP and NYU wireless sub-THz path loss standards for D-band, G-band, and H-band channels.
//
// Beats:
//   1. Define Free Space Path Loss (FSPL) and 1-meter reference path loss at sub-THz frequencies.
//   2. Compute Close-In (CI) free-space reference distance path loss with path loss exponent n.
//   3. Compute Floating-Intercept (FI) empirical path loss and aggregate total attenuation.

pub type SubThzPathLossConfig = struct {
    carrier_frequency_ghz: Float,
    reference_distance_m: Float,
    path_loss_exponent_n: Float,
    shadow_fading_std_db: Float,
    atmospheric_loss_db_km: Float
};

pub type SubThzPathLossResult = struct {
    distance_m: Float,
    fspl_1m_db: Float,
    ci_path_loss_db: Float,
    molecular_loss_db: Float,
    total_path_loss_db: Float,
    received_power_dbm: Float
};

pub fn sub_thz_path_loss_config_dband_los() -> SubThzPathLossConfig {
    return SubThzPathLossConfig {
        carrier_frequency_ghz: 140.0,
        reference_distance_m: 1.0,
        path_loss_exponent_n: 2.0, // Free space LoS
        shadow_fading_std_db: 1.5,
        atmospheric_loss_db_km: 0.4
    };
}

pub fn sub_thz_path_loss_config_dband_nlos() -> SubThzPathLossConfig {
    return SubThzPathLossConfig {
        carrier_frequency_ghz: 140.0,
        reference_distance_m: 1.0,
        path_loss_exponent_n: 3.2, // Indoor office NLoS
        shadow_fading_std_db: 6.8,
        atmospheric_loss_db_km: 0.4
    };
}

pub fn sub_thz_path_loss_config_300ghz_los() -> SubThzPathLossConfig {
    return SubThzPathLossConfig {
        carrier_frequency_ghz: 300.0,
        reference_distance_m: 1.0,
        path_loss_exponent_n: 2.02,
        shadow_fading_std_db: 2.1,
        atmospheric_loss_db_km: 3.5 // 300 GHz absorption window
    };
}

pub fn sub_thz_fspl_1m_db(freq_ghz: Float) -> Float {
    let speed_of_light: Float = 299792458.0;
    let lambda_m: Float = speed_of_light / (freq_ghz * 1000000000.0);
    let pi: Float = 3.141592653589793;
    let ratio: Float = (4.0 * pi * 1.0) / lambda_m;
    let ln_ratio: Float = ln(ratio);
    let ln10: Float = 2.302585092994046;
    return 20.0 * (ln_ratio / ln10);
}

pub fn sub_thz_path_loss_eval(cfg: SubThzPathLossConfig, distance_m: Float, tx_power_dbm: Float, tx_gain_dbi: Float, rx_gain_dbi: Float) -> SubThzPathLossResult {
    let d_ref: Float = cfg.reference_distance_m;
    let mut d: Float = distance_m;
    if distance_m < d_ref {
        d = d_ref;
    }
    let freq: Float = cfg.carrier_frequency_ghz;
    let fspl_1m: Float = sub_thz_fspl_1m_db(freq);

    let ln10: Float = 2.302585092994046;
    let log_dist: Float = ln(d / d_ref) / ln10;
    let n_exp: Float = cfg.path_loss_exponent_n;
    let ci_loss: Float = fspl_1m + (10.0 * n_exp * log_dist);

    let att_rate: Float = cfg.atmospheric_loss_db_km;
    let mol_loss: Float = att_rate * (d / 1000.0);
    let total_loss: Float = ci_loss + mol_loss;
    let rx_pwr: Float = tx_power_dbm + tx_gain_dbi + rx_gain_dbi - total_loss;

    return SubThzPathLossResult {
        distance_m: d,
        fspl_1m_db: fspl_1m,
        ci_path_loss_db: ci_loss,
        molecular_loss_db: mol_loss,
        total_path_loss_db: total_loss,
        received_power_dbm: rx_pwr
    };
}
