// # Photonic Terahertz Generation & UTC-PD Photomixing
//
// Logline: Models continuous-wave (CW) THz generation via Uni-Traveling-Carrier Photodiodes (UTC-PD) optical heterodyning.
//
// Setup: Pure standard library implementation of optical heterodyne photomixing and emitted THz radiated power scaling.
//
// Beats:
//   1. Model two laser optical carrier frequencies, optical beat note, and mixing wavelength.
//   2. Compute UTC-PD photocurrent generation, responsivity, and carrier transit-time RC cutoff.
//   3. Calculate emitted THz radiation power into antenna load impedance.

pub type UtcPhotodiodeConfig = struct {
    optical_responsivity_a_w: Float,
    junction_capacitance_ff: Float,
    series_resistance_ohm: Float,
    antenna_radiation_resistance_ohm: Float,
    carrier_transit_time_ps: Float,
    max_photocurrent_ma: Float,
};

pub type PhotomixingResult = struct {
    laser_beat_frequency_ghz: Float,
    optical_power_mw: Float,
    generated_photocurrent_ma: Float,
    emitted_thz_power_uw: Float,
    emitted_thz_power_dbm: Float,
    conversion_efficiency_pct: Float,
};

pub fn utc_pd_config_high_speed() -> UtcPhotodiodeConfig {
    return UtcPhotodiodeConfig {
        optical_responsivity_a_w: 0.25,
        junction_capacitance_ff: 15.0, // 15 fF
        series_resistance_ohm: 12.0,
        antenna_radiation_resistance_ohm: 72.0, // Bow-tie / log-periodic antenna
        carrier_transit_time_ps: 0.8,
        max_photocurrent_ma: 20.0,
    };
}

pub fn thz_photonic_emission_eval(cfg: UtcPhotodiodeConfig, lambda1_nm: Float, lambda2_nm: Float, opt_pwr_mw: Float) -> PhotomixingResult {
    let c: Float = 299792458.0;
    let f1_hz: Float = c / (lambda1_nm * 0.000000001);
    let f2_hz: Float = c / (lambda2_nm * 0.000000001);
    let mut beat_hz: Float = f1_hz - f2_hz;
    if beat_hz < 0.0 {
        beat_hz = 0.0 - beat_hz;
    }
    let beat_ghz: Float = beat_hz / 1000000000.0;

    // Extract struct fields cleanly
    let resp: Float = cfg.optical_responsivity_a_w;
    let max_i: Float = cfg.max_photocurrent_ma;
    let c_j: Float = cfg.junction_capacitance_ff;
    let r_s: Float = cfg.series_resistance_ohm;
    let r_ant: Float = cfg.antenna_radiation_resistance_ohm;
    let tau_tr_ps: Float = cfg.carrier_transit_time_ps;

    // Generated DC / RF photocurrent I_ph = R * P_opt
    let mut i_ph_ma: Float = resp * opt_pwr_mw;
    if i_ph_ma > max_i {
        i_ph_ma = max_i;
    }
    let i_ph_a: Float = i_ph_ma * 0.001;

    // Frequency roll-off from RC time constant and transit time
    let pi: Float = 3.141592653589793;
    let c_tot_f: Float = c_j * 0.000000000000001;
    let r_tot_ohm: Float = r_s + r_ant;
    let tau_rc_s: Float = r_tot_ohm * c_tot_f;
    let omega: Float = 2.0 * pi * beat_hz;

    let rc_roll: Float = 1.0 / (1.0 + (omega * omega * tau_rc_s * tau_rc_s));
    let tau_tr_s: Float = tau_tr_ps * 0.000000000001;
    let tr_roll: Float = 1.0 / (1.0 + (omega * omega * tau_tr_s * tau_tr_s));

    // Emitted THz power P_THz = 0.5 * I_ph^2 * R_ant * roll_off
    let p_thz_w: Float = 0.5 * i_ph_a * i_ph_a * r_ant * rc_roll * tr_roll;
    let p_thz_uw: Float = p_thz_w * 1000000.0;

    let p_thz_mw: Float = p_thz_w * 1000.0;
    let ln10: Float = 2.302585092994046;
    let mut safe_mw: Float = p_thz_mw;
    if p_thz_mw < 0.000000001 {
        safe_mw = 0.000000001;
    }
    let p_dbm: Float = 10.0 * (ln(safe_mw) / ln10);
    let mut eff_pct: Float = 0.0;
    if opt_pwr_mw > 0.0 {
        eff_pct = (p_thz_mw / opt_pwr_mw) * 100.0;
    }

    return PhotomixingResult {
        laser_beat_frequency_ghz: beat_ghz,
        optical_power_mw: opt_pwr_mw,
        generated_photocurrent_ma: i_ph_ma,
        emitted_thz_power_uw: p_thz_uw,
        emitted_thz_power_dbm: p_dbm,
        conversion_efficiency_pct: eff_pct,
    };
}
