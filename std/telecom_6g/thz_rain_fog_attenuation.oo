// # Hydrometeor Rain and Fog Attenuation at THz Bands
//
// Logline: Extends ITU-R P.838 and P.840 specific attenuation models for rain, fog, and cloud droplets to 1 THz.
//
// Setup: Pure standard library implementation of hydrometeor scattering and absorption at millimeter and terahertz wavelengths.
//
// Beats:
//   1. Define rain rate (mm/h) and fog liquid water density (g/m^3) environmental profiles.
//   2. Compute specific rain attenuation via power-law coefficient regression gamma_r = k * R^alpha.
//   3. Compute Rayleigh dielectric absorption for fog droplets and total hydrometeor extinction.

pub type HydrometeorProfile = struct {
    rain_rate_mm_h: Float,
    fog_liquid_density_g_m3: Float,
    visibility_m: Float,
    temperature_celsius: Float,
};

pub type HydrometeorLossResult = struct {
    frequency_ghz: Float,
    rain_attenuation_db_km: Float,
    fog_attenuation_db_km: Float,
    total_hydrometeor_db_km: Float,
};

pub fn hydrometeor_profile_heavy_rain() -> HydrometeorProfile {
    return HydrometeorProfile {
        rain_rate_mm_h: 25.0, // Heavy rain
        fog_liquid_density_g_m3: 0.0,
        visibility_m: 2000.0,
        temperature_celsius: 15.0,
    };
}

pub fn hydrometeor_profile_dense_fog() -> HydrometeorProfile {
    return HydrometeorProfile {
        rain_rate_mm_h: 0.0,
        fog_liquid_density_g_m3: 0.5, // Dense fog
        visibility_m: 50.0,
        temperature_celsius: 10.0,
    };
}

pub fn thz_rain_specific_attenuation(freq_ghz: Float, rain_rate_mm_h: Float) -> Float {
    if rain_rate_mm_h <= 0.0 {
        return 0.0;
    }
    // High-frequency asymptotic rain parameters (100 - 1000 GHz)
    let f_norm: Float = freq_ghz / 100.0;
    let k_coeff: Float = 0.95 * (f_norm / (1.0 + (0.35 * f_norm)));
    let alpha_exp: Float = 0.72;

    let ln_r: Float = ln(rain_rate_mm_h);
    let r_pow: Float = exp(alpha_exp * ln_r);
    return k_coeff * r_pow;
}

pub fn thz_fog_specific_attenuation(freq_ghz: Float, fog_density_g_m3: Float, temp_c: Float) -> Float {
    if fog_density_g_m3 <= 0.0 {
        return 0.0;
    }
    let theta: Float = 300.0 / (temp_c + 273.15);
    // Double Debye model relaxation factor for water at THz
    let f_p: Float = 20.09 - (142.0 * (theta - 1.0));
    let kl: Float = (0.819 * freq_ghz) / (1.0 + (freq_ghz * freq_ghz / (f_p * f_p)));
    return kl * fog_density_g_m3;
}

pub fn thz_calc_hydrometeor_loss(freq_ghz: Float, profile: &HydrometeorProfile) -> HydrometeorLossResult {
    let rain_db_km: Float = thz_rain_specific_attenuation(freq_ghz, profile.rain_rate_mm_h);
    let fog_db_km: Float = thz_fog_specific_attenuation(freq_ghz, profile.fog_liquid_density_g_m3, profile.temperature_celsius);
    let total_db_km: Float = rain_db_km + fog_db_km;

    return HydrometeorLossResult {
        frequency_ghz: freq_ghz,
        rain_attenuation_db_km: rain_db_km,
        fog_attenuation_db_km: fog_db_km,
        total_hydrometeor_db_km: total_db_km,
    };
}
