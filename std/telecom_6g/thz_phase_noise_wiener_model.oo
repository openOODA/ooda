// # Terahertz Phase Noise & Wiener Random Walk Model
//
// Logline: Models high-frequency oscillator phase noise, Wiener process random walk, and Common Phase Error (CPE) compensation.
//
// Setup: Pure standard library implementation of phase jitter and Inter-Carrier Interference (ICI) in sub-THz OFDM receivers.
//
// Beats:
//   1. Configure oscillator 3dB linewidth Delta_f (e.g. 10 kHz to 1 MHz) and sample period T_s.
//   2. Generate Wiener phase drift variance: sigma_phi^2 = 2 * pi * Delta_f * T_s.
//   3. Separate phase noise into Common Phase Error (CPE) constellation rotation and ICI additive noise.

pub type PhaseNoiseModelConfig = struct {
    oscillator_linewidth_hz: Float,
    sampling_period_ns: Float,
    num_ofdm_subcarriers: Int,
    pilot_cpe_estimation_enabled: Bool,
};

pub type PhaseNoiseImpact = struct {
    wiener_step_variance_rad2: Float,
    wiener_step_std_rad: Float,
    cpe_angle_rad: Float,
    ici_power_linear: Float,
    effective_snr_ceiling_db: Float,
};

pub fn phase_noise_config_sub_thz_pll() -> PhaseNoiseModelConfig {
    return PhaseNoiseModelConfig {
        oscillator_linewidth_hz: 50000.0, // 50 kHz linewidth (challenging at 140 GHz)
        sampling_period_ns: 0.5,           // 2 Gsps ADC
        num_ofdm_subcarriers: 1024,
        pilot_cpe_estimation_enabled: true,
    };
}

pub fn phase_noise_eval(cfg: PhaseNoiseModelConfig, total_accumulated_steps: Int) -> PhaseNoiseImpact {
    let lw: Float = cfg.oscillator_linewidth_hz;
    let t_s_ns: Float = cfg.sampling_period_ns;
    let t_s: Float = t_s_ns * 0.000000001;

    let pi: Float = 3.141592653589793;
    // Step variance: sigma^2 = 2 * pi * Delta_f * T_s
    let step_var: Float = 2.0 * pi * lw * t_s;
    let step_std: Float = sqrt(step_var);

    // Accumulated CPE over N steps
    let steps_f: Float = pn_int_to_float(total_accumulated_steps);
    let total_var: Float = step_var * steps_f;
    let cpe_std: Float = sqrt(total_var);

    // ICI power approx: sigma_ICI^2 = (pi / 3) * Delta_f * T_sym
    let n_sub_f: Float = pn_int_to_float(cfg.num_ofdm_subcarriers);
    let t_sym: Float = t_s * n_sub_f;
    let ici_pwr: Float = (pi / 3.0) * lw * t_sym;

    // Phase noise SNR ceiling = 1 / sigma_ICI^2
    let mut snr_ceil_lin: Float = 1000.0;
    if ici_pwr > 0.000001 {
        snr_ceil_lin = 1.0 / ici_pwr;
    }
    let ln10: Float = 2.302585092994046;
    let snr_ceil_db: Float = 10.0 * (ln(snr_ceil_lin) / ln10);

    return PhaseNoiseImpact {
        wiener_step_variance_rad2: step_var,
        wiener_step_std_rad: step_std,
        cpe_angle_rad: cpe_std,
        ici_power_linear: ici_pwr,
        effective_snr_ceiling_db: snr_ceil_db,
    };
}

pub fn pn_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
