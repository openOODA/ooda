// # Optical Wireless Communication (OWC) & VLC Channel
//
// Logline: Models Lambertian optical radiation patterns, photodiode Field-of-View (FoV), and optical DC channel gain.
//
// Setup: Pure standard library implementation of Visible Light Communication (VLC) and infrared optical wireless links.
//
// Beats:
//   1. Configure LED semi-angle at half power Phi_1/2 and Lambertian order m = -ln(2) / ln(cos(Phi_1/2)).
//   2. Compute photodiode receiver collection area, optical filter transmission, and non-imaging concentrator gain.
//   3. Calculate line-of-sight (LoS) optical DC channel gain H_vlc(0) and received optical power.

pub type VlcTransceiverConfig = struct {
    led_semi_angle_deg: Float,
    photodiode_area_cm2: Float,
    receiver_fov_deg: Float,
    optical_filter_gain: Float,
    refractive_index_concentrator: Float
};

pub type VlcLinkResult = struct {
    lambertian_order_m: Float,
    concentrator_optical_gain: Float,
    channel_dc_gain: Float,
    received_optical_power_mw: Float,
    is_within_fov: Bool
};

pub fn vlc_config_indoor_default() -> VlcTransceiverConfig {
    return VlcTransceiverConfig {
        led_semi_angle_deg: 60.0,
        photodiode_area_cm2: 1.0, // 1 cm^2 PD
        receiver_fov_deg: 70.0,
        optical_filter_gain: 0.9,
        refractive_index_concentrator: 1.5
    };
}

pub fn vlc_eval_channel(cfg: VlcTransceiverConfig, dist_m: Float, phi_rad: Float, psi_rad: Float, tx_power_w: Float) -> VlcLinkResult {
    let phi_half_deg: Float = cfg.led_semi_angle_deg;
    let a_pd_cm2: Float = cfg.photodiode_area_cm2;
    let fov_deg: Float = cfg.receiver_fov_deg;
    let t_s: Float = cfg.optical_filter_gain;
    let n_lens: Float = cfg.refractive_index_concentrator;

    let pi: Float = 3.141592653589793;
    let phi_half_rad: Float = (phi_half_deg * pi) / 180.0;
    let fov_rad: Float = (fov_deg * pi) / 180.0;

    // Lambertian emission order: m = -ln(2) / ln(cos(Phi_1/2))
    let cos_half: Float = cos(phi_half_rad);
    let ln2: Float = 0.6931471805599453;
    let mut m_order: Float = 1.0;
    if cos_half > 0.001 {
        m_order = (0.0 - ln2) / ln(cos_half);
    }

    // Optical concentrator gain: g(psi) = n^2 / sin^2(FOV) for psi <= FOV
    let sin_fov: Float = sin(fov_rad);
    let mut g_conc: Float = 1.0;
    if sin_fov > 0.001 {
        g_conc = (n_lens * n_lens) / (sin_fov * sin_fov);
    }

    let is_in_fov: Bool = psi_rad <= fov_rad;
    let mut h_dc: Float = 0.0;

    if is_in_fov && dist_m > 0.001 {
        let a_pd_m2: Float = a_pd_cm2 * 0.0001;
        let cos_phi: Float = cos(phi_rad);
        let cos_psi: Float = cos(psi_rad);

        // Power of cos_phi^m approx
        let mut cos_m: Float = 1.0;
        let mut i: Int = 0;
        let m_int: Int = if m_order >= 1.0 { 1 } else { 0 };
        if cos_phi > 0.0 { cos_m = cos_phi; }

        let num: Float = (m_order + 1.0) * a_pd_m2 * cos_m * cos_psi * t_s * g_conc;
        let denom: Float = 2.0 * pi * dist_m * dist_m;
        h_dc = num / denom;
    }

    let rx_pwr_w: Float = tx_power_w * h_dc;
    let rx_pwr_mw: Float = rx_pwr_w * 1000.0;

    return VlcLinkResult {
        lambertian_order_m: m_order,
        concentrator_optical_gain: g_conc,
        channel_dc_gain: h_dc,
        received_optical_power_mw: rx_pwr_mw,
        is_within_fov: is_in_fov
    };
}
