// # Simultaneous Transmitting and Reflecting RIS (STAR-RIS)
//
// Logline: Models 360-degree omnidirectional coverage via Energy Splitting (ES), Mode Switching (MS), and Time Splitting (TS).
//
// Setup: Pure standard library implementation of dual-sided transmission and reflection metasurfaces for full-space coverage.
//
// Beats:
//   1. Define STAR-RIS operating modes: Energy Splitting (ES), Mode Switching (MS), Time Splitting (TS).
//   2. Enforce energy conservation law: beta_r^2 + beta_t^2 <= 1 for reflection and transmission coefficients.
//   3. Compute achievable rate and coverage gain for users in front (reflection) and rear (transmission) spaces.

pub type StarRisConfig = struct {
    num_elements: Int,
    mode: Int, // 1: Energy Splitting (ES), 2: Mode Switching (MS), 3: Time Splitting (TS)
    energy_split_beta_r: Float, // Amplitude reflection coefficient (0.0 to 1.0)
    time_split_fraction_r: Float, // Time fraction for reflection (0.0 to 1.0)
    element_insertion_loss_db: Float
};

pub type StarRisDualSpaceMetrics = struct {
    reflection_power_fraction: Float,
    transmission_power_fraction: Float,
    reflection_phase_shift_rad: Float,
    transmission_phase_shift_rad: Float,
    front_user_snr_gain_db: Float,
    rear_user_snr_gain_db: Float
};

pub fn star_ris_config_energy_splitting(beta_r: Float) -> StarRisConfig {
    return StarRisConfig {
        num_elements: 256,
        mode: 1,
        energy_split_beta_r: beta_r,
        time_split_fraction_r: 0.5,
        element_insertion_loss_db: 0.8
    };
}

pub fn star_ris_config_mode_switching() -> StarRisConfig {
    return StarRisConfig {
        num_elements: 256,
        mode: 2,
        energy_split_beta_r: 1.0,
        time_split_fraction_r: 0.5,
        element_insertion_loss_db: 0.8
    };
}

pub fn star_ris_eval(cfg: StarRisConfig, base_snr_linear: Float) -> StarRisDualSpaceMetrics {
    let mode: Int = cfg.mode;
    let beta_r: Float = cfg.energy_split_beta_r;
    let time_split: Float = cfg.time_split_fraction_r;

    let mut p_r: Float = 0.5;
    let mut p_t: Float = 0.5;

    if mode == 1 {
        // Energy Splitting: beta_r^2 + beta_t^2 = 1
        p_r = beta_r * beta_r;
        p_t = 1.0 - p_r;
        if p_t < 0.0 { p_t = 0.0; }
    } else {
        if mode == 2 {
            // Mode Switching: half elements dedicated to R, half to T
            p_r = 0.5;
            p_t = 0.5;
        } else {
            // Time Splitting
            p_r = time_split;
            p_t = 1.0 - p_r;
        }
    }

    let ln10: Float = 2.302585092994046;
    let mut safe_pr: Float = p_r;
    if safe_pr < 0.0001 { safe_pr = 0.0001; }
    let mut safe_pt: Float = p_t;
    if safe_pt < 0.0001 { safe_pt = 0.0001; }

    let r_gain_db: Float = 10.0 * (ln(safe_pr * base_snr_linear) / ln10);
    let t_gain_db: Float = 10.0 * (ln(safe_pt * base_snr_linear) / ln10);

    return StarRisDualSpaceMetrics {
        reflection_power_fraction: p_r,
        transmission_power_fraction: p_t,
        reflection_phase_shift_rad: 0.0,
        transmission_phase_shift_rad: 1.5707963267948966, // pi/2 typical phase difference
        front_user_snr_gain_db: r_gain_db,
        rear_user_snr_gain_db: t_gain_db
    };
}
