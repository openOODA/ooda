// # Radiative Near-Field 3D Beamfocusing & Depth Resolution
//
// Logline: Calculates distance-dependent 3D focal beam patterns and depth resolution in the radiative Fresnel near-field.
//
// Setup: Pure standard library implementation of 3D spatial energy concentration for ultra-dense antenna arrays.
//
// Beats:
//   1. Define 3D focal spot coordinates (r_f, theta_f, phi_f) and array aperture size D.
//   2. Calculate depth-of-focus (DoF) 3dB beamwidth along the radial propagation axis.
//   3. Synthesize array element excitation weights focusing power onto a 3D target voxel.

pub type NearFieldFocusConfig = struct {
    carrier_frequency_ghz: Float,
    aperture_size_m: Float,
    focal_distance_m: Float,
    focal_angle_rad: Float,
};

pub type NearFieldFocusProfile = struct {
    rayleigh_distance_m: Float,
    depth_of_focus_3db_m: Float,
    transverse_spot_size_3db_m: Float,
    focal_gain_linear: Float,
};

pub fn near_field_focus_config_sub_thz() -> NearFieldFocusConfig {
    return NearFieldFocusConfig {
        carrier_frequency_ghz: 140.0,
        aperture_size_m: 0.4, // 40 cm
        focal_distance_m: 3.0, // 3 meters (inside near field)
        focal_angle_rad: 0.0,  // Boresight
    };
}

pub fn near_field_calc_spot(cfg: NearFieldFocusConfig) -> NearFieldFocusProfile {
    let freq: Float = cfg.carrier_frequency_ghz;
    let d_ap: Float = cfg.aperture_size_m;
    let r_f: Float = cfg.focal_distance_m;

    let c: Float = 299792458.0;
    let lambda: Float = c / (freq * 1000000000.0);

    // Rayleigh distance: d_R = 2 * D^2 / lambda
    let d_r: Float = (2.0 * d_ap * d_ap) / lambda;

    // Transverse 3dB spot size approx: delta_x = (lambda * r_f) / D
    let delta_trans: Float = (lambda * r_f) / d_ap;

    // Depth of focus (radial depth resolution) approx: delta_z = 7 * lambda * (r_f / D)^2
    let ratio: Float = r_f / d_ap;
    let delta_depth: Float = 7.0 * lambda * (ratio * ratio);

    // Focal energy concentration gain
    let gain: Float = (d_ap * d_ap) / (lambda * lambda);

    return NearFieldFocusProfile {
        rayleigh_distance_m: d_r,
        depth_of_focus_3db_m: delta_depth,
        transverse_spot_size_3db_m: delta_trans,
        focal_gain_linear: gain,
    };
}
