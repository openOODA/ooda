// # XL-MIMO Spatial Non-Stationarity & Visibility Regions
//
// Logline: Models spatial non-stationarity, energy decay across array panels, and user Visibility Regions (VR) for ELAA.
//
// Setup: Pure standard library implementation of Extremely Large Aperture Array (ELAA) spatial channel variation models.
//
// Beats:
//   1. Segment large-scale array into modular antenna subarrays / panels.
//   2. Compute panel-to-user Euclidean distance and angle-of-arrival variations.
//   3. Determine dynamic Visibility Region (VR) mask and non-stationary power profile.

pub type XlMimoArray = struct {
    total_panels: Int,
    antennas_per_panel: Int,
    panel_spacing_m: Float,
    vr_threshold_power_ratio: Float // Relative power threshold to be in Visibility Region
};

pub type PanelEnergyProfile = struct {
    panel_index: Int,
    distance_to_ue_m: Float,
    normalized_received_power: Float,
    is_in_visibility_region: Bool
};

pub fn xl_mimo_array_default_1024() -> XlMimoArray {
    return XlMimoArray {
        total_panels: 16,
        antennas_per_panel: 64, // 16 * 64 = 1024 antennas
        panel_spacing_m: 0.15,  // 15 cm panel width
        vr_threshold_power_ratio: 0.1 // -10 dB relative threshold
    };
}

pub fn xl_mimo_panel_center_x(panel_idx: Int, total_panels: Int, panel_spacing_m: Float) -> Float {
    let p_idx: Float = xl_mimo_int_to_float(panel_idx);
    let tot_f: Float = xl_mimo_int_to_float(total_panels);
    let center_offset: Float = (p_idx - (0.5 * tot_f)) * panel_spacing_m;
    return center_offset;
}

pub fn xl_mimo_eval_panel(panel_idx: Int, array_cfg: XlMimoArray, ue_x_m: Float, ue_y_m: Float, min_dist_m: Float) -> PanelEnergyProfile {
    let tot_p: Int = array_cfg.total_panels;
    let p_spacing: Float = array_cfg.panel_spacing_m;
    let p_x: Float = xl_mimo_panel_center_x(panel_idx, tot_p, p_spacing);

    let dx: Float = ue_x_m - p_x;
    let dy: Float = ue_y_m; // UE orthogonal distance
    let dist_sq: Float = (dx * dx) + (dy * dy);
    let dist: Float = sqrt(dist_sq);

    // Free space path loss scaling: P proportional to 1 / d^2
    let min_sq: Float = min_dist_m * min_dist_m;
    let mut power_ratio: Float = 1.0;
    if dist_sq > min_sq {
        power_ratio = min_sq / dist_sq;
    }

    let vr_thresh: Float = array_cfg.vr_threshold_power_ratio;
    let is_vr: Bool = power_ratio >= vr_thresh;

    return PanelEnergyProfile {
        panel_index: panel_idx,
        distance_to_ue_m: dist,
        normalized_received_power: power_ratio,
        is_in_visibility_region: is_vr
    };
}

pub fn xl_mimo_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
