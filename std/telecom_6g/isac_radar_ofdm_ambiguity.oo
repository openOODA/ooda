// # ISAC OFDM 2D Range-Doppler Ambiguity Function
//
// Logline: Evaluates 2D delay-Doppler ambiguity functions, range/velocity resolutions, and cross-correlation sidelobes for OFDM ISAC.
//
// Setup: Pure standard library implementation of radar ambiguity evaluation for joint communication and radar sensing waveforms.
//
// Beats:
//   1. Configure OFDM ISAC subcarrier spacing Delta_f, symbol duration T_sym, and total subcarrier bandwidth.
//   2. Compute fundamental range resolution Delta_R = c / (2 * B) and maximum unambiguous range R_max.
//   3. Compute Doppler velocity resolution Delta_v = lambda / (2 * T_frame) and evaluate 2D ambiguity response.

pub type IsacOfdmWaveformConfig = struct {
    carrier_frequency_ghz: Float,
    subcarrier_spacing_khz: Float,
    num_subcarriers: Int,
    num_symbols_in_frame: Int,
    cyclic_prefix_ratio: Float,
};

pub type IsacResolutionMetrics = struct {
    total_bandwidth_mhz: Float,
    frame_duration_ms: Float,
    range_resolution_m: Float,
    max_unambiguous_range_m: Float,
    velocity_resolution_m_s: Float,
    max_unambiguous_velocity_m_s: Float,
};

pub fn isac_ofdm_config_sub_thz_default() -> IsacOfdmWaveformConfig {
    return IsacOfdmWaveformConfig {
        carrier_frequency_ghz: 140.0,
        subcarrier_spacing_khz: 960.0, // 960 kHz SCS (6G numerology)
        num_subcarriers: 2048,
        num_symbols_in_frame: 140, // 10 slots of 14 symbols
        cyclic_prefix_ratio: 0.07,
    };
}

pub fn isac_eval_resolutions(cfg: IsacOfdmWaveformConfig) -> IsacResolutionMetrics {
    let scs_khz: Float = cfg.subcarrier_spacing_khz;
    let n_sub: Int = cfg.num_subcarriers;
    let n_sym: Int = cfg.num_symbols_in_frame;
    let cp_rat: Float = cfg.cyclic_prefix_ratio;
    let freq_ghz: Float = cfg.carrier_frequency_ghz;

    let n_sub_f: Float = isac_int_to_float(n_sub);
    let n_sym_f: Float = isac_int_to_float(n_sym);

    let bw_khz: Float = n_sub_f * scs_khz;
    let bw_mhz: Float = bw_khz / 1000.0;
    let bw_hz: Float = bw_khz * 1000.0;

    let c: Float = 299792458.0;
    let lambda: Float = c / (freq_ghz * 1000000000.0);

    // Range resolution: Delta_R = c / (2 * B)
    let delta_r: Float = c / (2.0 * bw_hz);

    // Symbol duration T_sym = (1 + CP) / Delta_f
    let scs_hz: Float = scs_khz * 1000.0;
    let t_sym_s: Float = (1.0 + cp_rat) / scs_hz;
    let t_frame_s: Float = n_sym_f * t_sym_s;
    let t_frame_ms: Float = t_frame_s * 1000.0;

    // Max unambiguous range R_max = c * T_sym / 2
    let r_max: Float = (c * t_sym_s) / 2.0;

    // Velocity resolution: Delta_v = lambda / (2 * T_frame)
    let delta_v: Float = lambda / (2.0 * t_frame_s);

    // Max unambiguous velocity: v_max = lambda / (4 * T_sym)
    let v_max: Float = lambda / (4.0 * t_sym_s);

    return IsacResolutionMetrics {
        total_bandwidth_mhz: bw_mhz,
        frame_duration_ms: t_frame_ms,
        range_resolution_m: delta_r,
        max_unambiguous_range_m: r_max,
        velocity_resolution_m_s: delta_v,
        max_unambiguous_velocity_m_s: v_max,
    };
}

pub fn isac_ambiguity_2d_response(delay_tau_s: Float, doppler_fd_hz: Float, bw_hz: Float, t_dur_s: Float) -> Float {
    let pi: Float = 3.141592653589793;
    let u_delay: Float = pi * bw_hz * delay_tau_s;
    let mut sinc_delay: Float = 1.0;
    if u_delay > 0.001 || u_delay < (0.0 - 0.001) {
        sinc_delay = sin(u_delay) / u_delay;
    }

    let u_doppler: Float = pi * doppler_fd_hz * t_dur_s;
    let mut sinc_doppler: Float = 1.0;
    if u_doppler > 0.001 || u_doppler < (0.0 - 0.001) {
        sinc_doppler = sin(u_doppler) / u_doppler;
    }

    let val: Float = sinc_delay * sinc_doppler;
    return val * val; // Ambiguity power magnitude
}

pub fn isac_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
