// # RIS Multi-User MAC Layer Time & Spatial Scheduling
//
// Logline: Schedules time-division and spatial-division RIS reflection beam configurations for multi-user downlink/uplink.
//
// Setup: Pure standard library implementation of MAC layer framing and beam-alignment scheduling for intelligent surfaces.
//
// Beats:
//   1. Define multi-user traffic queues, QoS latency targets, and RIS configuration switching slots.
//   2. Compute proportional fairness metric for user beam scheduling and RIS profile assignment.
//   3. Manage RIS controller configuration switching overhead (microseconds) and frame throughput.

pub type UserMacRequest = struct {
    user_id: Int,
    queue_bytes: Int,
    channel_quality_cqi: Int,
    target_ris_beam_index: Int,
    latency_deadline_slots: Int
};

pub type RisScheduledSlot = struct {
    slot_index: Int,
    scheduled_user_id: Int,
    applied_ris_beam_index: Int,
    switching_guard_time_us: Float,
    allocated_data_bytes: Int
};

pub fn ris_user_request_new(uid: Int, bytes: Int, cqi: Int, beam_idx: Int) -> UserMacRequest {
    return UserMacRequest {
        user_id: uid,
        queue_bytes: bytes,
        channel_quality_cqi: cqi,
        target_ris_beam_index: beam_idx,
        latency_deadline_slots: 10
    };
}

pub fn ris_calc_proportional_fairness_metric(cqi: Int, avg_throughput_kbps: Float) -> Float {
    let cqi_f: Float = ris_mac_int_to_float(cqi);
    let r_inst: Float = cqi_f * 2.5; // Estimated instantaneous rate in Mbps
    let r_avg: Float = (avg_throughput_kbps / 1000.0) + 0.1; // Baseline
    return r_inst / r_avg;
}

pub fn ris_schedule_user_slot(slot: Int, user: UserMacRequest, prev_beam_index: Int) -> RisScheduledSlot {
    let uid: Int = user.user_id;
    let target_beam: Int = user.target_ris_beam_index;
    let cqi: Int = user.channel_quality_cqi;

    // If beam changes, 2.5 us PIN diode switching guard time
    let mut guard_us: Float = 0.0;
    if target_beam != prev_beam_index {
        guard_us = 2.5;
    }

    let bytes_per_slot: Int = cqi * 256;
    let mut alloc_bytes: Int = user.queue_bytes;
    if alloc_bytes > bytes_per_slot {
        alloc_bytes = bytes_per_slot;
    }

    return RisScheduledSlot {
        slot_index: slot,
        scheduled_user_id: uid,
        applied_ris_beam_index: target_beam,
        switching_guard_time_us: guard_us,
        allocated_data_bytes: alloc_bytes
    };
}

pub fn ris_mac_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
