// # Power-Domain NOMA & Successive Interference Cancellation (SIC)
//
// Logline: Models 2-user power-domain NOMA power allocation, SIC decoding order, and individual user achievable rates.
//
// Setup: Pure standard library implementation of non-orthogonal multiple access protocols for 6G massive connectivity.
//
// Beats:
//   1. Configure near-user (strong channel |h_1|) and far-user (weak channel |h_2|) channel gains.
//   2. Allocate transmit power fractions alpha_1 (near) and alpha_2 (far) such that alpha_1 + alpha_2 = 1.
//   3. Compute SIC residual cancellation error, SINR, and sum-rate gain over orthogonal OMA.

pub type NomaUserPairConfig = struct {
    near_user_channel_gain_sq: Float,
    far_user_channel_gain_sq: Float,
    near_user_power_fraction_alpha1: Float, // Far user gets 1.0 - alpha1 (alpha2 > alpha1)
    total_tx_power_w: Float,
    noise_power_w: Float,
    sic_cancellation_factor: Float, // 0.0: Perfect SIC, 0.05: 5% residual power
};

pub type NomaRateResult = struct {
    near_user_rate_bps_hz: Float,
    far_user_rate_bps_hz: Float,
    noma_sum_rate_bps_hz: Float,
    oma_sum_rate_bps_hz: Float,
    noma_gain_percent: Float,
};

pub fn noma_config_default() -> NomaUserPairConfig {
    return NomaUserPairConfig {
        near_user_channel_gain_sq: 1.0,   // Strong user close to BS
        far_user_channel_gain_sq: 0.1,   // Weak user near cell edge
        near_user_power_fraction_alpha1: 0.2, // 20% power to near, 80% to far
        total_tx_power_w: 1.0,
        noise_power_w: 0.01,
        sic_cancellation_factor: 0.01,
    };
}

pub fn noma_eval_rates(cfg: NomaUserPairConfig) -> NomaRateResult {
    let g1: Float = cfg.near_user_channel_gain_sq;
    let g2: Float = cfg.far_user_channel_gain_sq;
    let a1: Float = cfg.near_user_power_fraction_alpha1;
    let a2: Float = 1.0 - a1;
    let p_tot: Float = cfg.total_tx_power_w;
    let n_0: Float = cfg.noise_power_w;
    let xi_sic: Float = cfg.sic_cancellation_factor;

    let ln2: Float = 0.6931471805599453;

    // Far user directly decodes its signal treating near user as interference:
    // SINR_2 = (a2 * P * g2) / (a1 * P * g2 + N0)
    let num2: Float = a2 * p_tot * g2;
    let denom2: Float = (a1 * p_tot * g2) + n_0;
    let sinr2: Float = num2 / denom2;
    let r2: Float = ln(1.0 + sinr2) / ln2;

    // Near user performs SIC (subtracts far user message):
    // SINR_1 = (a1 * P * g1) / (xi * a2 * P * g1 + N0)
    let num1: Float = a1 * p_tot * g1;
    let denom1: Float = (xi_sic * a2 * p_tot * g1) + n_0;
    let sinr1: Float = num1 / denom1;
    let r1: Float = ln(1.0 + sinr1) / ln2;

    let r_noma_sum: Float = r1 + r2;

    // Orthogonal Multiple Access (TDMA / OFDMA half-resource allocation baseline):
    let r1_oma: Float = 0.5 * (ln(1.0 + (p_tot * g1 / n_0)) / ln2);
    let r2_oma: Float = 0.5 * (ln(1.0 + (p_tot * g2 / n_0)) / ln2);
    let r_oma_sum: Float = r1_oma + r2_oma;

    let mut gain_pct: Float = 0.0;
    if r_oma_sum > 0.0001 {
        gain_pct = ((r_noma_sum - r_oma_sum) / r_oma_sum) * 100.0;
    }

    return NomaRateResult {
        near_user_rate_bps_hz: r1,
        far_user_rate_bps_hz: r2,
        noma_sum_rate_bps_hz: r_noma_sum,
        oma_sum_rate_bps_hz: r_oma_sum,
        noma_gain_percent: gain_pct,
    };
}
