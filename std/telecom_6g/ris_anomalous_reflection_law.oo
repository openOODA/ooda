// # Generalized Snell's Law & Anomalous Metasurface Reflection
//
// Logline: Calculates phase gradient, anomalous reflection angles, and critical total internal reflection limits for metasurfaces.
//
// Setup: Pure standard library implementation of phase-gradient metasurface refraction and anomalous beam deflection laws.
//
// Beats:
//   1. Implement Generalized Snell's Law: sin(theta_r) - sin(theta_i) = (lambda / (2*pi)) * (dPhi / dx).
//   2. Determine the required constant phase gradient across unit cells for desired deflection angle.
//   3. Compute critical incident angle beyond which surface waves / evanescent modes are launched.

pub type PhaseGradientMetasurface = struct {
    carrier_frequency_ghz: Float,
    unit_cell_period_m: Float,
    phase_gradient_rad_m: Float,
};

pub type AnomalousReflectionResult = struct {
    incident_angle_rad: Float,
    reflected_angle_rad: Float,
    is_evanescent: Bool,
    efficiency_factor: Float,
};

pub fn metasurface_gradient_new(freq_ghz: Float, cell_pitch_m: Float, target_theta_i_rad: Float, target_theta_r_rad: Float) -> PhaseGradientMetasurface {
    let c: Float = 299792458.0;
    let lambda_m: Float = c / (freq_ghz * 1000000000.0);
    let pi: Float = 3.141592653589793;
    let k_0: Float = (2.0 * pi) / lambda_m;

    // dPhi / dx = k_0 * (sin(theta_r) - sin(theta_i))
    let sin_diff: Float = sin(target_theta_r_rad) - sin(target_theta_i_rad);
    let dphi_dx: Float = k_0 * sin_diff;

    return PhaseGradientMetasurface {
        carrier_frequency_ghz: freq_ghz,
        unit_cell_period_m: cell_pitch_m,
        phase_gradient_rad_m: dphi_dx,
    };
}

pub fn ris_eval_anomalous_reflection(surface: PhaseGradientMetasurface, theta_i_rad: Float) -> AnomalousReflectionResult {
    let freq: Float = surface.carrier_frequency_ghz;
    let dphi: Float = surface.phase_gradient_rad_m;

    let c: Float = 299792458.0;
    let lambda_m: Float = c / (freq * 1000000000.0);
    let pi: Float = 3.141592653589793;
    let k_0: Float = (2.0 * pi) / lambda_m;

    // sin(theta_r) = sin(theta_i) + (1 / k_0) * (dPhi / dx)
    let sin_r: Float = sin(theta_i_rad) + (dphi / k_0);

    let mut is_eva: Bool = false;
    let mut theta_r: Float = 0.0;
    let mut eff: Float = 1.0;

    if sin_r > 1.0 || sin_r < (0.0 - 1.0) {
        // Evanescent wave launched along the surface
        is_eva = true;
        eff = 0.0;
        theta_r = 0.5 * pi; // 90 degrees grazing
    } else {
        // asin approximation for angle
        theta_r = ris_asin_approx(sin_r);
        // Cosine projection efficiency factor
        let cos_r: Float = cos(theta_r);
        let cos_i: Float = cos(theta_i_rad);
        if cos_i > 0.0001 {
            eff = cos_r / cos_i;
            if eff > 1.0 { eff = 1.0; }
        }
    }

    return AnomalousReflectionResult {
        incident_angle_rad: theta_i_rad,
        reflected_angle_rad: theta_r,
        is_evanescent: is_eva,
        efficiency_factor: eff,
    };
}

pub fn ris_asin_approx(x: Float) -> Float {
    let mut v: Float = x;
    if v > 1.0 { v = 1.0; }
    if v < (0.0 - 1.0) { v = 0.0 - 1.0; }
    // Taylor series: x + x^3/6 + 3x^5/40
    let x3: Float = v * v * v;
    let x5: Float = x3 * v * v;
    return v + (x3 / 6.0) + (3.0 * x5 / 40.0);
}
