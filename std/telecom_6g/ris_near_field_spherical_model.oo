// # RIS Near-Field Spherical Wavefront & Beamfocusing
//
// Logline: Models spherical wavefront curvature, Rayleigh Fraunhofer boundary, and radiative near-field 3D focal spots.
//
// Setup: Pure standard library implementation of Fresnel spherical distance modeling for large aperture RIS.
//
// Beats:
//   1. Compute Fraunhofer Rayleigh distance d_R = 2 * D^2 / lambda for large intelligent surfaces.
//   2. Calculate exact spherical distance from each RIS element to focal point (x_f, y_f, z_f).
//   3. Synthesize quadratic phase profile for precise spatial depth beamfocusing.

pub type RisNearFieldConfig = struct {
    carrier_frequency_ghz: Float,
    surface_aperture_diameter_m: Float,
    num_elements_x: Int,
    num_elements_y: Int,
    element_pitch_m: Float,
};

pub type NearFieldFocusPoint = struct {
    focus_x_m: Float,
    focus_y_m: Float,
    focus_z_m: Float,
};

pub type NearFieldProfile = struct {
    rayleigh_distance_m: Float,
    focal_distance_m: Float,
    is_in_near_field: Bool,
    center_element_phase_rad: Float,
    edge_element_phase_rad: Float,
};

pub fn ris_near_field_config_150ghz_1m() -> RisNearFieldConfig {
    return RisNearFieldConfig {
        carrier_frequency_ghz: 150.0,
        surface_aperture_diameter_m: 0.5, // 50 cm aperture
        num_elements_x: 250,
        num_elements_y: 250,
        element_pitch_m: 0.001, // 1 mm
    };
}

pub fn ris_calc_rayleigh_distance(freq_ghz: Float, aperture_diameter_m: Float) -> Float {
    let c: Float = 299792458.0;
    let lambda_m: Float = c / (freq_ghz * 1000000000.0);
    if lambda_m <= 0.000001 { return 1000.0; }
    // Rayleigh distance d_R = 2 * D^2 / lambda
    return (2.0 * aperture_diameter_m * aperture_diameter_m) / lambda_m;
}

pub fn ris_spherical_element_distance(elem_x_m: Float, elem_y_m: Float, focus: NearFieldFocusPoint) -> Float {
    let fx: Float = focus.focus_x_m;
    let fy: Float = focus.focus_y_m;
    let fz: Float = focus.focus_z_m;

    let dx: Float = elem_x_m - fx;
    let dy: Float = elem_y_m - fy;
    let dz: Float = 0.0 - fz; // Surface is at z = 0

    let sum_sq: Float = (dx * dx) + (dy * dy) + (dz * dz);
    return sqrt(sum_sq);
}

pub fn ris_spherical_focus_phase(dist_m: Float, freq_ghz: Float) -> Float {
    let c: Float = 299792458.0;
    let lambda_m: Float = c / (freq_ghz * 1000000000.0);
    let pi: Float = 3.141592653589793;
    let k: Float = (2.0 * pi) / lambda_m;
    let phase: Float = 0.0 - (k * dist_m);

    let two_pi: Float = 2.0 * pi;
    let mut p_mod: Float = phase;
    while p_mod < 0.0 { p_mod = p_mod + two_pi; }
    while p_mod >= two_pi { p_mod = p_mod - two_pi; }
    return p_mod;
}

pub fn ris_eval_near_field(cfg: RisNearFieldConfig, focus: NearFieldFocusPoint) -> NearFieldProfile {
    let freq: Float = cfg.carrier_frequency_ghz;
    let d_ap: Float = cfg.surface_aperture_diameter_m;
    let d_rayleigh: Float = ris_calc_rayleigh_distance(freq, d_ap);

    let dist_center: Float = ris_spherical_element_distance(0.0, 0.0, focus);
    let edge_x: Float = d_ap * 0.5;
    let edge_y: Float = d_ap * 0.5;
    let dist_edge: Float = ris_spherical_element_distance(edge_x, edge_y, focus);

    let is_nf: Bool = dist_center < d_rayleigh;
    let p_center: Float = ris_spherical_focus_phase(dist_center, freq);
    let p_edge: Float = ris_spherical_focus_phase(dist_edge, freq);

    return NearFieldProfile {
        rayleigh_distance_m: d_rayleigh,
        focal_distance_m: dist_center,
        is_in_near_field: is_nf,
        center_element_phase_rad: p_center,
        edge_element_phase_rad: p_edge,
    };
}
