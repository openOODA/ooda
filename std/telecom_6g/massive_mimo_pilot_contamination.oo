// # Massive MIMO Pilot Contamination & Asymptotic Limits
//
// Logline: Evaluates inter-cell pilot reuse, MMSE channel estimation degradation, and asymptotic multi-cell SINR ceilings.
//
// Setup: Pure standard library implementation of non-cooperative cellular network pilot interference bounds.
//
// Beats:
//   1. Define pilot reuse factor (1, 3, 7) and multi-cell path loss interference geometry.
//   2. Compute MMSE channel estimation error under correlated pilot interference.
//   3. Calculate asymptotic Uplink/Downlink SINR limit as base station antennas M -> infinity.

pub type PilotContaminationConfig = struct {
    num_bs_antennas: Int,
    pilot_reuse_factor: Int, // 1 (universal reuse) or 3
    serving_channel_power: Float,
    interfering_channel_power: Float,
    uplink_snr_linear: Float,
};

pub type PilotContaminationResult = struct {
    channel_estimation_nmse: Float,
    asymptotic_sinr_linear: Float,
    asymptotic_sinr_db: Float,
    spectral_efficiency_bps_hz: Float,
};

pub fn pilot_contamination_config_universal_reuse() -> PilotContaminationConfig {
    return PilotContaminationConfig {
        num_bs_antennas: 128,
        pilot_reuse_factor: 1,
        serving_channel_power: 1.0,
        interfering_channel_power: 0.15, // Neighbor cell interference
        uplink_snr_linear: 10.0,
    };
}

pub fn pilot_eval_contamination(cfg: PilotContaminationConfig) -> PilotContaminationResult {
    let beta_serving: Float = cfg.serving_channel_power;
    let beta_interferer: Float = cfg.interfering_channel_power;
    let snr: Float = cfg.uplink_snr_linear;
    let reuse: Int = cfg.pilot_reuse_factor;

    let mut eff_interf: Float = beta_interferer;
    if reuse >= 3 {
        eff_interf = beta_interferer * 0.1; // Reduced interference with orthogonal pilot reuse
    }

    // MMSE Normalized Mean Square Error (NMSE):
    // NMSE = (eff_interf + 1/SNR) / (beta_serving + eff_interf + 1/SNR)
    let noise_term: Float = if snr > 0.001 { 1.0 / snr } else { 1.0 };
    let num_nmse: Float = eff_interf + noise_term;
    let denom_nmse: Float = beta_serving + eff_interf + noise_term;
    let nmse: Float = num_nmse / denom_nmse;

    // Asymptotic SINR as M -> infinity: SINR_inf = beta_serving^2 / eff_interf^2
    let mut sinr_inf: Float = 100.0;
    if eff_interf > 0.0001 {
        sinr_inf = (beta_serving * beta_serving) / (eff_interf * eff_interf);
    }

    let ln10: Float = 2.302585092994046;
    let ln2: Float = 0.6931471805599453;
    let sinr_db: Float = 10.0 * (ln(sinr_inf) / ln10);
    let se_bps: Float = ln(1.0 + sinr_inf) / ln2;

    return PilotContaminationResult {
        channel_estimation_nmse: nmse,
        asymptotic_sinr_linear: sinr_inf,
        asymptotic_sinr_db: sinr_db,
        spectral_efficiency_bps_hz: se_bps,
    };
}
