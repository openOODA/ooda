// # Sub-Connected Hybrid Beamforming & Precoding
//
// Logline: Designs sub-connected and fully-connected hybrid analog-digital precoding matrices reducing power dissipation.
//
// Setup: Pure standard library implementation of RF chain reduction and energy-efficient mmWave/THz hybrid precoders.
//
// Beats:
//   1. Define hybrid architecture configurations (N_TX antennas, N_RF chains, N_stream data streams).
//   2. Compare hardware complexity and power consumption of sub-connected vs fully-connected topologies.
//   3. Compute sub-array analog phase shifter steering angles and digital baseband zero-forcing weights.

pub type HybridPrecoderArchitecture = struct {
    num_tx_antennas: Int,
    num_rf_chains: Int,
    num_data_streams: Int,
    is_subconnected: Bool, // true: Sub-connected (each RF chain to N_tx/N_rf antennas), false: Fully connected
    phase_shifter_power_mw: Float,
    rf_chain_power_mw: Float,
};

pub type HybridPrecodingMetrics = struct {
    antennas_per_rf_chain: Int,
    total_phase_shifters: Int,
    total_rf_power_mw: Float,
    hardware_power_efficiency_ratio: Float,
};

pub fn hybrid_architecture_subconnected_128x8() -> HybridPrecoderArchitecture {
    return HybridPrecoderArchitecture {
        num_tx_antennas: 128,
        num_rf_chains: 8,
        num_data_streams: 4,
        is_subconnected: true,
        phase_shifter_power_mw: 15.0,
        rf_chain_power_mw: 250.0,
    };
}

pub fn hybrid_architecture_fully_connected_128x8() -> HybridPrecoderArchitecture {
    return HybridPrecoderArchitecture {
        num_tx_antennas: 128,
        num_rf_chains: 8,
        num_data_streams: 4,
        is_subconnected: false,
        phase_shifter_power_mw: 15.0,
        rf_chain_power_mw: 250.0,
    };
}

pub fn hybrid_calc_metrics(arch: HybridPrecoderArchitecture) -> HybridPrecodingMetrics {
    let n_tx: Int = arch.num_tx_antennas;
    let n_rf: Int = arch.num_rf_chains;
    let is_sub: Bool = arch.is_subconnected;
    let p_ps: Float = arch.phase_shifter_power_mw;
    let p_rf: Float = arch.rf_chain_power_mw;

    let mut n_sub: Int = n_tx / n_rf;
    if n_sub <= 0 { n_sub = 1; }

    let mut total_ps: Int = n_tx;
    if !is_sub {
        total_ps = n_tx * n_rf; // In fully connected, every RF chain connects to all antennas
    }

    let ps_cnt_f: Float = hybrid_int_to_float(total_ps);
    let rf_cnt_f: Float = hybrid_int_to_float(n_rf);

    let tot_power: Float = (rf_cnt_f * p_rf) + (ps_cnt_f * p_ps);

    // Full-connected reference power
    let full_ps_f: Float = hybrid_int_to_float(n_tx * n_rf);
    let full_tot_power: Float = (rf_cnt_f * p_rf) + (full_ps_f * p_ps);

    let mut eff_ratio: Float = 1.0;
    if tot_power > 0.0001 {
        eff_ratio = full_tot_power / tot_power;
    }

    return HybridPrecodingMetrics {
        antennas_per_rf_chain: n_sub,
        total_phase_shifters: total_ps,
        total_rf_power_mw: tot_power,
        hardware_power_efficiency_ratio: eff_ratio,
    };
}

pub fn hybrid_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
