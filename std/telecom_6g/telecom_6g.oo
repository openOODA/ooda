pub type Telecom6gSystemConfig = struct {
    carrier_frequency_ghz: Float,
    channel_bandwidth_mhz: Float,
    num_tx_antennas: Int,
    num_rx_antennas: Int,
    num_ris_elements: Int,
    subcarrier_spacing_khz: Float,
    is_isac_enabled: Bool
};

pub fn telecom_6g_system_config_default_d_band() -> Telecom6gSystemConfig {
    return Telecom6gSystemConfig {
        carrier_frequency_ghz: 140.0, // 140 GHz D-band
        channel_bandwidth_mhz: 2000.0, // 2 GHz ultra-wide channel
        num_tx_antennas: 64,
        num_rx_antennas: 64,
        num_ris_elements: 256,
        subcarrier_spacing_khz: 960.0, // 960 kHz 6G subcarrier spacing
        is_isac_enabled: true
    };
}

pub fn telecom_6g_system_config_300ghz_thz() -> Telecom6gSystemConfig {
    return Telecom6gSystemConfig {
        carrier_frequency_ghz: 300.0, // 300 GHz THz band
        channel_bandwidth_mhz: 10000.0, // 10 GHz bandwidth
        num_tx_antennas: 256,
        num_rx_antennas: 256,
        num_ris_elements: 1024,
        subcarrier_spacing_khz: 1920.0,
        is_isac_enabled: true
    };
}

pub fn telecom_6g_create_gas_medium() -> ThzGasMedium {
    return thz_gas_medium_standard_sea_level();
}

pub fn telecom_6g_create_ris_array_config() -> RisArrayConfig {
    return ris_array_config_default_64x64();
}

pub fn telecom_6g_create_isac_waveform() -> IsacOfdmWaveformConfig {
    return isac_ofdm_config_sub_thz_default();
}

pub fn telecom_6g_create_oam_mode(l: Int) -> OamModeConfig {
    return oam_mode_config_default(l);
}

pub fn telecom_6g_create_otfs_grid() -> OtfsGridConfig {
    return otfs_grid_config_default_64x32();
}

pub fn telecom_6g_create_fbl_config() -> FiniteBlocklengthConfig {
    return fbl_config_urllc_critical();
}
