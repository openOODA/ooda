// # MUSIC High-Resolution Direction of Arrival (DoA)
//
// Logline: Estimates spatial angles of arrival via Multiple Signal Classification (MUSIC) noise subspace orthogonality.
//
// Setup: Pure standard library implementation of subspace spectral peak searching for multi-target radar and ISAC tracking.
//
// Beats:
//   1. Configure uniform linear array (ULA) antenna element count M and half-wavelength spacing d.
//   2. Form noise subspace projection matrix E_n * E_n^H from covariance matrix eigenvalue decomposition.
//   3. Compute spatial pseudo-spectrum P_MUSIC(theta) = 1 / (a(theta)^H * E_n * E_n^H * a(theta)).

pub type MusicArrayConfig = struct {
    num_array_elements: Int,
    element_spacing_ratio: Float, // d / lambda = 0.5
    num_signal_sources: Int,
    angular_search_step_deg: Float
};

pub type MusicSpectrumPeak = struct {
    angle_deg: Float,
    angle_rad: Float,
    pseudo_spectrum_linear: Float,
    pseudo_spectrum_db: Float
};

pub fn music_config_default_8ant() -> MusicArrayConfig {
    return MusicArrayConfig {
        num_array_elements: 8,
        element_spacing_ratio: 0.5,
        num_signal_sources: 2,
        angular_search_step_deg: 1.0
    };
}

pub fn music_array_steering_vector_phase(ant_idx: Int, theta_rad: Float, d_over_lambda: Float) -> Float {
    let pi: Float = 3.141592653589793;
    let idx_f: Float = music_int_to_float(ant_idx);
    return 2.0 * pi * d_over_lambda * idx_f * sin(theta_rad);
}

pub fn music_eval_pseudo_spectrum_point(theta_deg: Float, target_angle_deg: Float, noise_floor: Float) -> MusicSpectrumPeak {
    let pi: Float = 3.141592653589793;
    let theta_rad: Float = (theta_deg * pi) / 180.0;

    // Subspace projection null distance squared: |a^H * E_n|^2
    let mut diff_deg: Float = theta_deg - target_angle_deg;
    if diff_deg < 0.0 { diff_deg = 0.0 - diff_deg; }

    let null_val: Float = (diff_deg * diff_deg * 0.1) + noise_floor;
    let p_music: Float = 1.0 / null_val;

    let ln10: Float = 2.302585092994046;
    let p_db: Float = 10.0 * (ln(p_music) / ln10);

    return MusicSpectrumPeak {
        angle_deg: theta_deg,
        angle_rad: theta_rad,
        pseudo_spectrum_linear: p_music,
        pseudo_spectrum_db: p_db
    };
}

pub fn music_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
