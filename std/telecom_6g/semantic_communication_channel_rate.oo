// # Semantic Communication & Task-Oriented Rate
//
// Logline: Evaluates semantic entropy, task-oriented semantic fidelity (SSIM / BLEU), and semantic channel capacity.
//
// Setup: Pure standard library implementation of semantic information theory beyond Shannon's classical bit-level paradigm.
//
// Beats:
//   1. Define source semantic entropy H_s(S) and message semantic ambiguity factor delta_s.
//   2. Compute task-oriented semantic distortion metric D_s and semantic compression ratio.
//   3. Calculate semantic channel capacity C_s = W * log2(1 + SNR_eff) / k_semantic in suts/s (semantic units per second).

pub type SemanticChannelConfig = struct {
    physical_bandwidth_hz: Float,
    snr_linear: Float,
    semantic_feature_dimension_k: Int,
    raw_source_bits: Int,
    target_semantic_fidelity: Float, // e.g. 0.95 (95% task accuracy)
};

pub type SemanticRateMetrics = struct {
    classical_capacity_mbps: Float,
    semantic_compression_ratio: Float,
    semantic_channel_rate_msuts: Float, // Million Semantic Units per second
    effective_bandwidth_saving_pct: Float,
};

pub fn semantic_config_default_vision_task() -> SemanticChannelConfig {
    return SemanticChannelConfig {
        physical_bandwidth_hz: 20000000.0, // 20 MHz
        snr_linear: 10.0,
        semantic_feature_dimension_k: 64, // 64 latent feature vectors
        raw_source_bits: 4096,           // Raw image patch bits
        target_semantic_fidelity: 0.92,
    };
}

pub fn semantic_eval_rate(cfg: SemanticChannelConfig) -> SemanticRateMetrics {
    let bw_hz: Float = cfg.physical_bandwidth_hz;
    let snr: Float = cfg.snr_linear;
    let k_dim: Int = cfg.semantic_feature_dimension_k;
    let raw_bits: Int = cfg.raw_source_bits;
    let fid: Float = cfg.target_semantic_fidelity;

    let ln2: Float = 0.6931471805599453;
    let c_classical_bps: Float = bw_hz * (ln(1.0 + snr) / ln2);
    let c_classical_mbps: Float = c_classical_bps / 1000000.0;

    let k_f: Float = sem_int_to_float(k_dim);
    let raw_f: Float = sem_int_to_float(raw_bits);

    // Semantic feature bits = K * 16 bits per latent embedding
    let sem_bits: Float = k_f * 16.0;

    // Compression ratio
    let mut comp_ratio: Float = 1.0;
    if sem_bits > 0.0001 {
        comp_ratio = raw_f / sem_bits;
    }

    // Effective semantic rate: transmits 'comp_ratio' times more effective messages per physical bit
    let sem_rate_bps: Float = c_classical_bps * comp_ratio * fid;
    let sem_rate_msuts: Float = sem_rate_bps / 1000000.0;

    let mut saving_pct: Float = 0.0;
    if comp_ratio > 1.0 {
        saving_pct = (1.0 - (1.0 / comp_ratio)) * 100.0;
    }

    return SemanticRateMetrics {
        classical_capacity_mbps: c_classical_mbps,
        semantic_compression_ratio: comp_ratio,
        semantic_channel_rate_msuts: sem_rate_msuts,
        effective_bandwidth_saving_pct: saving_pct,
    };
}

pub fn sem_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
