// # ITU-R Atmospheric Attenuation for Sub-THz and THz Bands
//
// Logline: Implements ITU-R P.676 atmospheric gaseous attenuation, dry air, water vapor, and zenith slant path loss.
//
// Setup: Pure standard library implementation of international telecommunication standards for millimeter-wave and sub-terahertz propagation.
//
// Beats:
//   1. Define atmospheric profile parameters including dry air pressure and vapor density.
//   2. Compute specific attenuation for dry air (gamma_o) and water vapor (gamma_w) in dB/km.
//   3. Calculate slant path zenith attenuation and effective atmospheric height.

pub type AtmosphericProfile = struct {
    total_pressure_hpa: Float,
    dry_pressure_hpa: Float,
    water_vapor_density_g_m3: Float,
    temperature_celsius: Float,
};

pub type GaseousAttenuation = struct {
    frequency_ghz: Float,
    dry_air_attenuation_db_km: Float,
    water_vapor_attenuation_db_km: Float,
    total_specific_attenuation_db_km: Float,
    zenith_total_attenuation_db: Float,
};

pub fn atmospheric_profile_standard() -> AtmosphericProfile {
    return AtmosphericProfile {
        total_pressure_hpa: 1013.25,
        dry_pressure_hpa: 1005.75,
        water_vapor_density_g_m3: 7.5,
        temperature_celsius: 15.0,
    };
}

pub fn atmospheric_profile_dry_cold() -> AtmosphericProfile {
    return AtmosphericProfile {
        total_pressure_hpa: 1013.25,
        dry_pressure_hpa: 1011.25,
        water_vapor_density_g_m3: 1.0,
        temperature_celsius: 0.0,
    };
}

pub fn thz_dry_air_specific_attenuation_db_km(freq_ghz: Float, p_dry: Float, temp_c: Float) -> Float {
    let theta: Float = 300.0 / (temp_c + 273.15);
    let p_ratio: Float = p_dry / 1013.25;
    let mut gamma: Float = 0.001;

    // 60 GHz Oxygen absorption complex band
    if freq_ghz >= 50.0 && freq_ghz <= 70.0 {
        let f_diff: Float = freq_ghz - 60.0;
        gamma = gamma + (15.0 * p_ratio * theta * exp(0.0 - (f_diff * f_diff / 50.0)));
    }

    // 118.75 GHz Oxygen single line
    let df_118: Float = freq_ghz - 118.75;
    let o2_118: Float = (2.0 * p_ratio * theta) / (1.0 + (df_118 * df_118 / 4.0));
    gamma = gamma + o2_118;

    // Continuum scaling with square of normalized pressure
    let f_thz: Float = freq_ghz / 1000.0;
    let continuum: Float = 0.05 * (f_thz * f_thz) * p_ratio * p_ratio;
    gamma = gamma + continuum;

    return gamma;
}

pub fn thz_water_vapor_specific_attenuation_db_km(freq_ghz: Float, rho_v: Float, temp_c: Float) -> Float {
    let theta: Float = 300.0 / (temp_c + 273.15);
    let mut gamma: Float = 0.0001;

    // 183.31 GHz Water line
    let df_183: Float = freq_ghz - 183.31;
    let h2o_183: Float = (30.0 * (rho_v / 7.5) * theta) / (1.0 + (df_183 * df_183 / 9.0));
    gamma = gamma + h2o_183;

    // 325.15 GHz Water line
    let df_325: Float = freq_ghz - 325.15;
    let h2o_325: Float = (15.0 * (rho_v / 7.5) * theta) / (1.0 + (df_325 * df_325 / 12.0));
    gamma = gamma + h2o_325;

    // 380 GHz Water line
    let df_380: Float = freq_ghz - 380.0;
    let h2o_380: Float = (45.0 * (rho_v / 7.5) * theta) / (1.0 + (df_380 * df_380 / 16.0));
    gamma = gamma + h2o_380;

    // Continuum water absorption
    let f_thz: Float = freq_ghz / 1000.0;
    let cont_w: Float = 0.25 * (f_thz * f_thz) * (rho_v / 7.5);
    gamma = gamma + cont_w;

    return gamma;
}

pub fn thz_calc_gaseous_attenuation(freq_ghz: Float, profile: &AtmosphericProfile) -> GaseousAttenuation {
    let gamma_o: Float = thz_dry_air_specific_attenuation_db_km(freq_ghz, profile.dry_pressure_hpa, profile.temperature_celsius);
    let gamma_w: Float = thz_water_vapor_specific_attenuation_db_km(freq_ghz, profile.water_vapor_density_g_m3, profile.temperature_celsius);
    let gamma_total: Float = gamma_o + gamma_w;

    // Effective scale heights (ITU-R P.676): h_o approx 6 km, h_w approx 2 km
    let h_eff_o_km: Float = 6.0;
    let h_eff_w_km: Float = 2.0;
    let zenith_att_db: Float = (gamma_o * h_eff_o_km) + (gamma_w * h_eff_w_km);

    return GaseousAttenuation {
        frequency_ghz: freq_ghz,
        dry_air_attenuation_db_km: gamma_o,
        water_vapor_attenuation_db_km: gamma_w,
        total_specific_attenuation_db_km: gamma_total,
        zenith_total_attenuation_db: zenith_att_db,
    };
}
