// # Rate-Splitting Multiple Access (RSMA)
//
// Logline: Implements 1-layer Rate-Splitting Multiple Access, splitting user messages into common and private sub-streams.
//
// Setup: Pure standard library implementation of generalized robust multi-user interference management for 6G networks.
//
// Beats:
//   1. Split user messages into common public stream s_c and private user streams s_1, s_2.
//   2. Allocate transmit power budget P = P_c + P_1 + P_2 across common and private streams.
//   3. Decode common stream at both users and private streams after common stream SIC removal.

pub type RsmaConfig = struct {
    common_power_fraction: Float, // P_c / P
    user1_private_power_fraction: Float,
    user2_private_power_fraction: Float,
    total_power_w: Float,
    channel_gain_user1_sq: Float,
    channel_gain_user2_sq: Float,
    noise_power_w: Float,
};

pub type RsmaRateAllocation = struct {
    common_stream_rate_bps_hz: Float,
    user1_private_rate_bps_hz: Float,
    user2_private_rate_bps_hz: Float,
    user1_total_rate_bps_hz: Float,
    user2_total_rate_bps_hz: Float,
    rsma_sum_rate_bps_hz: Float,
};

pub fn rsma_config_default() -> RsmaConfig {
    return RsmaConfig {
        common_power_fraction: 0.4,
        user1_private_power_fraction: 0.3,
        user2_private_power_fraction: 0.3,
        total_power_w: 1.0,
        channel_gain_user1_sq: 1.0,
        channel_gain_user2_sq: 0.5,
        noise_power_w: 0.05,
    };
}

pub fn rsma_eval_rates(cfg: RsmaConfig) -> RsmaRateAllocation {
    let p_tot: Float = cfg.total_power_w;
    let a_c: Float = cfg.common_power_fraction;
    let a_1: Float = cfg.user1_private_power_fraction;
    let a_2: Float = cfg.user2_private_power_fraction;

    let g1: Float = cfg.channel_gain_user1_sq;
    let g2: Float = cfg.channel_gain_user2_sq;
    let n_0: Float = cfg.noise_power_w;

    let p_c: Float = a_c * p_tot;
    let p_1: Float = a_1 * p_tot;
    let p_2: Float = a_2 * p_tot;

    let ln2: Float = 0.6931471805599453;

    // Common stream SINR at User 1:
    // SINR_c1 = (P_c * g1) / (P_1 * g1 + P_2 * g1 + N0)
    let sinr_c1: Float = (p_c * g1) / ((p_1 * g1) + (p_2 * g1) + n_0);
    let r_c1: Float = ln(1.0 + sinr_c1) / ln2;

    // Common stream SINR at User 2:
    let sinr_c2: Float = (p_c * g2) / ((p_1 * g2) + (p_2 * g2) + n_0);
    let r_c2: Float = ln(1.0 + sinr_c2) / ln2;

    // Common rate must be decodable by both: R_c = min(R_c1, R_c2)
    let mut r_c: Float = r_c1;
    if r_c2 < r_c1 {
        r_c = r_c2;
    }

    // Private stream 1 (User 1 decodes private after removing common stream):
    // SINR_p1 = (P_1 * g1) / (P_2 * g1 + N0)
    let sinr_p1: Float = (p_1 * g1) / ((p_2 * g1) + n_0);
    let r_p1: Float = ln(1.0 + sinr_p1) / ln2;

    // Private stream 2:
    let sinr_p2: Float = (p_2 * g2) / ((p_1 * g2) + n_0);
    let r_p2: Float = ln(1.0 + sinr_p2) / ln2;

    // Split common stream equally between users
    let r_u1: Float = (0.5 * r_c) + r_p1;
    let r_u2: Float = (0.5 * r_c) + r_p2;
    let r_sum: Float = r_c + r_p1 + r_p2;

    return RsmaRateAllocation {
        common_stream_rate_bps_hz: r_c,
        user1_private_rate_bps_hz: r_p1,
        user2_private_rate_bps_hz: r_p2,
        user1_total_rate_bps_hz: r_u1,
        user2_total_rate_bps_hz: r_u2,
        rsma_sum_rate_bps_hz: r_sum,
    };
}
