// # 3D DFT Dual-Polarized Grid-of-Beams Codebook
//
// Logline: Generates 3D Grid-of-Beams (GoB) DFT codebooks across azimuth and elevation for dual-polarized massive arrays.
//
// Setup: Pure standard library implementation of 3D multi-panel DFT beam steering matrices for 6G FR3 and sub-THz.
//
// Beats:
//   1. Define 2D uniform planar array (UPA) panel dimensions (N_h x N_v) and oversampling factors (O_h, O_v).
//   2. Compute Kronecker-product 3D DFT steering vectors for each (i, j) beam index.
//   3. Apply dual-polarization co-phasing factors (1, j, -1, -j) for rank-1 and rank-2 transmission.

pub type Dft3dCodebookConfig = struct {
    num_horizontal_antennas: Int,
    num_vertical_antennas: Int,
    oversampling_horizontal: Int,
    oversampling_vertical: Int,
    is_dual_polarized: Bool,
};

pub type DftBeamVectorElement = struct {
    antenna_index_h: Int,
    antenna_index_v: Int,
    polarization_idx: Int,
    phase_rad: Float,
};

pub fn dft_3d_config_default_8x8() -> Dft3dCodebookConfig {
    return Dft3dCodebookConfig {
        num_horizontal_antennas: 8,
        num_vertical_antennas: 8,
        oversampling_horizontal: 4, // 32 azimuth beams
        oversampling_vertical: 2,   // 16 elevation beams
        is_dual_polarized: true,
    };
}

pub fn dft_3d_total_beams(cfg: Dft3dCodebookConfig) -> Int {
    let nh: Int = cfg.num_horizontal_antennas;
    let nv: Int = cfg.num_vertical_antennas;
    let oh: Int = cfg.oversampling_horizontal;
    let ov: Int = cfg.oversampling_vertical;
    return (nh * oh) * (nv * ov);
}

pub fn dft_beam_phase(ant_h: Int, ant_v: Int, beam_i: Int, beam_j: Int, cfg: Dft3dCodebookConfig) -> Float {
    let nh: Int = cfg.num_horizontal_antennas;
    let nv: Int = cfg.num_vertical_antennas;
    let oh: Int = cfg.oversampling_horizontal;
    let ov: Int = cfg.oversampling_vertical;

    let pi: Float = 3.141592653589793;
    let ah_f: Float = dft_int_to_float(ant_h);
    let av_f: Float = dft_int_to_float(ant_v);
    let bi_f: Float = dft_int_to_float(beam_i);
    let bj_f: Float = dft_int_to_float(beam_j);

    let tot_h_f: Float = dft_int_to_float(nh * oh);
    let tot_v_f: Float = dft_int_to_float(nv * ov);

    let phase_h: Float = (2.0 * pi * ah_f * bi_f) / tot_h_f;
    let phase_v: Float = (2.0 * pi * av_f * bj_f) / tot_v_f;
    let tot_phase: Float = phase_h + phase_v;

    let two_pi: Float = 2.0 * pi;
    let mut p_mod: Float = tot_phase;
    while p_mod < 0.0 { p_mod = p_mod + two_pi; }
    while p_mod >= two_pi { p_mod = p_mod - two_pi; }
    return p_mod;
}

pub fn dft_eval_element(ant_h: Int, ant_v: Int, pol_idx: Int, beam_i: Int, beam_j: Int, cfg: Dft3dCodebookConfig) -> DftBeamVectorElement {
    let base_phase: Float = dft_beam_phase(ant_h, ant_v, beam_i, beam_j, cfg);
    let mut final_phase: Float = base_phase;
    if pol_idx == 1 {
        // Orthogonal polarization phase offset (+pi/2)
        final_phase = final_phase + 1.5707963267948966;
    }

    return DftBeamVectorElement {
        antenna_index_h: ant_h,
        antenna_index_v: ant_v,
        polarization_idx: pol_idx,
        phase_rad: final_phase,
    };
}

pub fn dft_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
