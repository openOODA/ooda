// # Terahertz Molecular Absorption & HITRAN Line Model
//
// Logline: Calculates frequency-dependent atmospheric molecular absorption coefficients and transmittance for sub-THz and THz bands.
//
// Setup: Pure standard library implementation of HITRAN-derived molecular resonance models for water vapor and oxygen absorption.
//
// Beats:
//   1. Define atmospheric gas medium thermodynamic states and molecular density.
//   2. Model resonant line absorption peaks for H2O and O2 across 100 GHz to 1 THz.
//   3. Compute medium absorption coefficient in m^-1, total absorption loss in dB, and transmittance.

pub type ThzGasMedium = struct {
    temperature_k: Float,
    pressure_hpa: Float,
    relative_humidity_pct: Float,
    water_vapor_density_g_m3: Float,
};

pub type ThzAbsorptionResult = struct {
    frequency_ghz: Float,
    distance_m: Float,
    absorption_coeff_m_inv: Float,
    attenuation_db_per_km: Float,
    total_loss_db: Float,
    transmittance_factor: Float,
};

pub fn thz_gas_medium_standard_sea_level() -> ThzGasMedium {
    return ThzGasMedium {
        temperature_k: 293.15,
        pressure_hpa: 1013.25,
        relative_humidity_pct: 50.0,
        water_vapor_density_g_m3: 7.5,
    };
}

pub fn thz_gas_medium_dry_atmosphere() -> ThzGasMedium {
    return ThzGasMedium {
        temperature_k: 288.15,
        pressure_hpa: 1013.25,
        relative_humidity_pct: 10.0,
        water_vapor_density_g_m3: 1.5,
    };
}

pub fn thz_calc_water_vapor_density(temp_k: Float, rel_humidity_pct: Float) -> Float {
    let t_c: Float = temp_k - 273.15;
    let sat_vapor_press_hpa: Float = 6.1121 * exp((17.502 * t_c) / (t_c + 240.97));
    let actual_vapor_press_hpa: Float = sat_vapor_press_hpa * (rel_humidity_pct / 100.0);
    return (216.7 * actual_vapor_press_hpa) / temp_k;
}

pub fn thz_h2o_resonance_peak_coeff(freq_ghz: Float, rho_v: Float, peak_ghz: Float, gamma_ghz: Float, strength: Float) -> Float {
    let delta_f: Float = freq_ghz - peak_ghz;
    let denom: Float = (delta_f * delta_f) + (gamma_ghz * gamma_ghz);
    if denom <= 0.0001 {
        return 0.0;
    }
    let lorentz_shape: Float = (gamma_ghz / 3.141592653589793) / denom;
    return strength * rho_v * lorentz_shape;
}

pub fn thz_molecular_absorption_coeff(freq_ghz: Float, medium: &ThzGasMedium) -> Float {
    let rho_v: Float = medium.water_vapor_density_g_m3;
    let mut coeff: Float = 0.00001 * (medium.pressure_hpa / 1013.25);

    // O2 resonance at 118.75 GHz
    let o2_118: Float = thz_h2o_resonance_peak_coeff(freq_ghz, 1.0, 118.75, 1.6, 0.0008);
    coeff = coeff + o2_118;

    // H2O resonance at 183.31 GHz
    let h2o_183: Float = thz_h2o_resonance_peak_coeff(freq_ghz, rho_v, 183.31, 3.2, 0.0025);
    coeff = coeff + h2o_183;

    // H2O resonance at 325.15 GHz
    let h2o_325: Float = thz_h2o_resonance_peak_coeff(freq_ghz, rho_v, 325.15, 3.8, 0.0018);
    coeff = coeff + h2o_325;

    // H2O resonance at 380.20 GHz
    let h2o_380: Float = thz_h2o_resonance_peak_coeff(freq_ghz, rho_v, 380.20, 4.5, 0.0085);
    coeff = coeff + h2o_380;

    // H2O resonance at 448.00 GHz
    let h2o_448: Float = thz_h2o_resonance_peak_coeff(freq_ghz, rho_v, 448.00, 4.2, 0.0052);
    coeff = coeff + h2o_448;

    // H2O resonance at 557.00 GHz (strong absorption peak)
    let h2o_557: Float = thz_h2o_resonance_peak_coeff(freq_ghz, rho_v, 557.00, 5.0, 0.0240);
    coeff = coeff + h2o_557;

    // H2O resonance at 752.00 GHz
    let h2o_752: Float = thz_h2o_resonance_peak_coeff(freq_ghz, rho_v, 752.00, 5.5, 0.0310);
    coeff = coeff + h2o_752;

    // Continuum absorption background (scales quadratically with frequency)
    let f_thz: Float = freq_ghz / 1000.0;
    let continuum: Float = 0.00015 * (f_thz * f_thz) * rho_v;
    coeff = coeff + continuum;

    return coeff;
}

pub fn thz_molecular_absorption_eval(freq_ghz: Float, distance_m: Float, medium: &ThzGasMedium) -> ThzAbsorptionResult {
    let k_m: Float = thz_molecular_absorption_coeff(freq_ghz, medium);
    let log10_e: Float = 0.4342944819032518;
    let db_per_m: Float = 10.0 * log10_e * k_m;
    let db_per_km: Float = db_per_m * 1000.0;
    let total_loss_db: Float = db_per_m * distance_m;
    let transmittance: Float = exp(0.0 - (k_m * distance_m));

    return ThzAbsorptionResult {
        frequency_ghz: freq_ghz,
        distance_m: distance_m,
        absorption_coeff_m_inv: k_m,
        attenuation_db_per_km: db_per_km,
        total_loss_db: total_loss_db,
        transmittance_factor: transmittance,
    };
}
