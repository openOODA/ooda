// # Radio Stripe Cell-Free Massive MIMO Architecture
//
// Logline: Models daisy-chain radio stripe networks, sequential uplink fronthaul processing, and AP clustering.
//
// Setup: Pure standard library implementation of distributed cell-free massive MIMO radio stripes for ubiquitous 6G coverage.
//
// Beats:
//   1. Configure linear radio stripe bus line (N_AP access points, D_spacing, front-haul bus capacity).
//   2. Model sequential uplink linear MMSE processing along the daisy-chain bus.
//   3. Compute user-centric AP cluster size, front-haul quantization SNR degradation, and coverage uniformity.

pub type RadioStripeConfig = struct {
    num_access_points: Int,
    ap_spacing_m: Float,
    fronthaul_capacity_gbps: Float,
    fronthaul_quantization_bits: Int,
    antennas_per_ap: Int,
};

pub type RadioStripePerformance = struct {
    total_stripe_length_m: Float,
    active_cluster_aps: Int,
    quantization_snr_db: Float,
    sequential_processing_latency_us: Float,
    macro_diversity_gain_db: Float,
};

pub fn radio_stripe_config_indoor_factory() -> RadioStripeConfig {
    return RadioStripeConfig {
        num_access_points: 32,
        ap_spacing_m: 2.5, // 2.5m AP spacing across 80m factory line
        fronthaul_capacity_gbps: 25.0,
        fronthaul_quantization_bits: 8,
        antennas_per_ap: 4,
    };
}

pub fn radio_stripe_eval(cfg: RadioStripeConfig, ue_position_m: Float) -> RadioStripePerformance {
    let n_aps: Int = cfg.num_access_points;
    let d_spacing: Float = cfg.ap_spacing_m;
    let q_bits: Int = cfg.fronthaul_quantization_bits;

    let n_aps_f: Float = stripe_int_to_float(n_aps);
    let tot_len: Float = n_aps_f * d_spacing;

    // 6 dB per bit quantization rule: SNR_q approx 6.02 * Q_bits + 1.76 dB
    let q_bits_f: Float = stripe_int_to_float(q_bits);
    let q_snr_db: Float = (6.02 * q_bits_f) + 1.76;

    // User-centric clustering: 4 closest APs are active
    let mut cluster_size: Int = 4;
    if cluster_size > n_aps {
        cluster_size = n_aps;
    }

    // Sequential processing latency along bus: ~0.1 us per AP hop
    let cl_size_f: Float = stripe_int_to_float(cluster_size);
    let latency_us: Float = cl_size_f * 0.1;

    // Macro-diversity gain: ~3 dB per doubling of active serving APs
    let macro_gain_db: Float = 3.0 * (cl_size_f * 0.5);

    return RadioStripePerformance {
        total_stripe_length_m: tot_len,
        active_cluster_aps: cluster_size,
        quantization_snr_db: q_snr_db,
        sequential_processing_latency_us: latency_us,
        macro_diversity_gain_db: macro_gain_db,
    };
}

pub fn stripe_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
