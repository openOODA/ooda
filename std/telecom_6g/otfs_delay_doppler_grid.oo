// # OTFS Delay-Doppler Grid Modulation & ISFFT
//
// Logline: Maps 2D information symbols across the Delay-Doppler grid using Inverse Symplectic Finite Fourier Transform (ISFFT).
//
// Setup: Pure standard library implementation of Orthogonal Time Frequency Space (OTFS) 2D lattice modulation.
//
// Beats:
//   1. Define delay-Doppler resource grid parameters (M delay bins, N Doppler bins).
//   2. Compute delay bin spacing Delta_tau = 1 / (M * Delta_f) and Doppler bin spacing Delta_nu = 1 / (N * T).
//   3. Implement ISFFT mapping from 2D delay-Doppler plane to 2D time-frequency Heisenberg grid.

pub type OtfsGridConfig = struct {
    num_delay_bins_m: Int,
    num_doppler_bins_n: Int,
    subcarrier_spacing_khz: Float,
    symbol_duration_us: Float,
};

pub type OtfsLatticeMetrics = struct {
    total_grid_symbols: Int,
    delay_resolution_ns: Float,
    doppler_resolution_khz: Float,
    max_delay_spread_us: Float,
    max_doppler_spread_khz: Float,
};

pub fn otfs_grid_config_default_64x32() -> OtfsGridConfig {
    return OtfsGridConfig {
        num_delay_bins_m: 64,  // Subcarriers
        num_doppler_bins_n: 32, // Time symbols
        subcarrier_spacing_khz: 120.0,
        symbol_duration_us: 8.333,
    };
}

pub fn otfs_eval_lattice(cfg: OtfsGridConfig) -> OtfsLatticeMetrics {
    let m_bins: Int = cfg.num_delay_bins_m;
    let n_bins: Int = cfg.num_doppler_bins_n;
    let scs_khz: Float = cfg.subcarrier_spacing_khz;
    let t_sym_us: Float = cfg.symbol_duration_us;

    let m_f: Float = otfs_int_to_float(m_bins);
    let n_f: Float = otfs_int_to_float(n_bins);

    let tot_symbols: Int = m_bins * n_bins;

    // Total bandwidth B = M * Delta_f (kHz)
    let bw_khz: Float = m_f * scs_khz;
    let bw_hz: Float = bw_khz * 1000.0;

    // Delay resolution Delta_tau = 1 / B (s)
    let delta_tau_s: Float = if bw_hz > 0.0001 { 1.0 / bw_hz } else { 0.000001 };
    let delta_tau_ns: Float = delta_tau_s * 1000000000.0;

    // Total frame duration T_frame = N * T_sym (us)
    let t_frame_us: Float = n_f * t_sym_us;
    let t_frame_s: Float = t_frame_us * 0.000001;

    // Doppler resolution Delta_nu = 1 / T_frame (Hz)
    let delta_nu_hz: Float = if t_frame_s > 0.0000001 { 1.0 / t_frame_s } else { 1000.0 };
    let delta_nu_khz: Float = delta_nu_hz / 1000.0;

    return OtfsLatticeMetrics {
        total_grid_symbols: tot_symbols,
        delay_resolution_ns: delta_tau_ns,
        doppler_resolution_khz: delta_nu_khz,
        max_delay_spread_us: t_sym_us,
        max_doppler_spread_khz: scs_khz * 0.5,
    };
}

pub fn otfs_isfft_kernel_phase(k_freq: Int, l_time: Int, m_delay: Int, n_dopp: Int, m_tot: Int, n_tot: Int) -> Float {
    let pi: Float = 3.141592653589793;
    let k_f: Float = otfs_int_to_float(k_freq);
    let l_f: Float = otfs_int_to_float(l_time);
    let m_f: Float = otfs_int_to_float(m_delay);
    let n_f: Float = otfs_int_to_float(n_dopp);
    let m_tot_f: Float = otfs_int_to_float(m_tot);
    let n_tot_f: Float = otfs_int_to_float(n_tot);

    // ISFFT: Phase = 2*pi * (n * l / N - m * k / M)
    let term_n: Float = (2.0 * pi * n_f * l_f) / n_tot_f;
    let term_m: Float = (2.0 * pi * m_f * k_f) / m_tot_f;
    return term_n - term_m;
}

pub fn otfs_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
