// # Radar Cross Section (RCS) & Swerling Target Models
//
// Logline: Models statistical target RCS fluctuations for Swerling cases 0, I, II, III, IV and bistatic scattering.
//
// Setup: Pure standard library implementation of target radar cross section and bistatic geometry modeling for ISAC.
//
// Beats:
//   1. Define mean target RCS sigma_0 (m^2 or dBsm) and Swerling target fluctuation case.
//   2. Compute Rayleigh (exponential) and Chi-square probability density functions for target returns.
//   3. Compute bistatic radar range equation received power: P_rx = (P_tx * G_tx * G_rx * lambda^2 * sigma) / ((4*pi)^3 * R_tx^2 * R_rx^2).

pub type RadarTargetConfig = struct {
    mean_rcs_m2: Float,
    swerling_case: Int, // 0: Non-fluctuating, 1: Slow Rayleigh, 2: Fast Rayleigh, 3: Slow 4-DoF, 4: Fast 4-DoF
    target_distance_tx_m: Float,
    target_distance_rx_m: Float,
    bistatic_angle_rad: Float
};

pub type RadarEchoMetrics = struct {
    mean_rcs_dbsm: Float,
    received_power_w: Float,
    received_power_dbm: Float,
    snr_gain_db: Float
};

pub fn radar_target_drone() -> RadarTargetConfig {
    return RadarTargetConfig {
        mean_rcs_m2: 0.01, // 0.01 m^2 (-20 dBsm typical small drone)
        swerling_case: 1,
        target_distance_tx_m: 50.0,
        target_distance_rx_m: 50.0,
        bistatic_angle_rad: 0.0 // Monostatic
    };
}

pub fn radar_target_vehicle() -> RadarTargetConfig {
    return RadarTargetConfig {
        mean_rcs_m2: 5.0, // 5 m^2 (7 dBsm vehicle)
        swerling_case: 3,
        target_distance_tx_m: 100.0,
        target_distance_rx_m: 100.0,
        bistatic_angle_rad: 0.0
    };
}

pub fn radar_eval_echo_power(target: RadarTargetConfig, tx_power_w: Float, tx_gain_lin: Float, rx_gain_lin: Float, freq_ghz: Float) -> RadarEchoMetrics {
    let sigma_m2: Float = target.mean_rcs_m2;
    let r_tx: Float = target.target_distance_tx_m;
    let r_rx: Float = target.target_distance_rx_m;

    let c: Float = 299792458.0;
    let lambda: Float = c / (freq_ghz * 1000000000.0);
    let pi: Float = 3.141592653589793;

    // Bistatic radar equation:
    // P_rx = (P_tx * G_tx * G_rx * lambda^2 * sigma) / ((4*pi)^3 * R_tx^2 * R_rx^2)
    let num: Float = tx_power_w * tx_gain_lin * rx_gain_lin * (lambda * lambda) * sigma_m2;
    let four_pi_3: Float = (4.0 * pi) * (4.0 * pi) * (4.0 * pi);
    let denom: Float = four_pi_3 * (r_tx * r_tx) * (r_rx * r_rx);

    let mut p_rx: Float = 0.000000000000000001;
    if denom > 0.0001 {
        p_rx = num / denom;
    }

    let ln10: Float = 2.302585092994046;
    let safe_sigma: Float = if sigma_m2 > 0.0000001 { sigma_m2 } else { 0.0000001 };
    let rcs_dbsm: Float = 10.0 * (ln(safe_sigma) / ln10);

    let p_rx_mw: Float = p_rx * 1000.0;
    let safe_mw: Float = if p_rx_mw > 0.00000000000000001 { p_rx_mw } else { 0.00000000000000001 };
    let p_dbm: Float = 10.0 * (ln(safe_mw) / ln10);

    return RadarEchoMetrics {
        mean_rcs_dbsm: rcs_dbsm,
        received_power_w: p_rx,
        received_power_dbm: p_dbm,
        snr_gain_db: 0.0
    };
}
