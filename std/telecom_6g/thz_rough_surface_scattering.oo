// # Terahertz Rough Surface Scattering & Diffuse Reflection
//
// Logline: Models Rayleigh roughness, Beckmann-Kirchhoff scattering, and diffuse reflection degradation at THz sub-millimeter wavelengths.
//
// Setup: Pure standard library implementation of electromagnetic surface scattering models for architectural materials at 100-1000 GHz.
//
// Beats:
//   1. Compute Rayleigh roughness criterion and phase standard deviation.
//   2. Calculate Beckmann-Kirchhoff specular reduction factor (rho_s).
//   3. Compute Lambertian diffuse scattering power distribution and specular reflection loss.

pub type RoughSurfaceProperties = struct {
    rms_roughness_mm: Float,
    correlation_length_mm: Float,
    relative_permittivity_real: Float,
    relative_permittivity_imag: Float,
};

pub type ScatteringResult = struct {
    frequency_ghz: Float,
    incident_angle_rad: Float,
    rayleigh_roughness_param: Float,
    specular_reduction_factor: Float,
    diffuse_power_fraction: Float,
    specular_reflection_loss_db: Float,
};

pub fn rough_surface_plasterboard() -> RoughSurfaceProperties {
    return RoughSurfaceProperties {
        rms_roughness_mm: 0.05, // 50 micrometers
        correlation_length_mm: 0.2,
        relative_permittivity_real: 2.8,
        relative_permittivity_imag: 0.05,
    };
}

pub fn rough_surface_rough_concrete() -> RoughSurfaceProperties {
    return RoughSurfaceProperties {
        rms_roughness_mm: 0.45, // 450 micrometers (comparable to 300 GHz wavelength)
        correlation_length_mm: 1.5,
        relative_permittivity_real: 6.2,
        relative_permittivity_imag: 0.35,
    };
}

pub fn rough_surface_smooth_glass() -> RoughSurfaceProperties {
    return RoughSurfaceProperties {
        rms_roughness_mm: 0.002, // 2 micrometers
        correlation_length_mm: 0.05,
        relative_permittivity_real: 6.5,
        relative_permittivity_imag: 0.1,
    };
}

pub fn thz_rayleigh_roughness_parameter(freq_ghz: Float, rms_rough_mm: Float, theta_i_rad: Float) -> Float {
    let speed_of_light_mm_s: Float = 299792458000.0;
    let lambda_mm: Float = speed_of_light_mm_s / (freq_ghz * 1000000000.0);
    let pi: Float = 3.141592653589793;
    let k: Float = (2.0 * pi) / lambda_mm;
    let cos_theta: Float = cos(theta_i_rad);
    return 2.0 * k * rms_rough_mm * cos_theta;
}

pub fn thz_beckmann_specular_reduction(rayleigh_param: Float) -> Float {
    let g: Float = rayleigh_param * rayleigh_param;
    return exp(0.0 - g);
}

pub fn thz_calc_scattering(freq_ghz: Float, theta_i_rad: Float, surface: &RoughSurfaceProperties) -> ScatteringResult {
    let rayleigh_param: Float = thz_rayleigh_roughness_parameter(freq_ghz, surface.rms_roughness_mm, theta_i_rad);
    let rho_s: Float = thz_beckmann_specular_reduction(rayleigh_param);
    let diffuse_fraction: Float = 1.0 - rho_s;

    let ln10: Float = 2.302585092994046;
    let safe_rho: Float = if rho_s < 0.0000001 { 0.0000001 } else { rho_s };
    let spec_loss_db: Float = 0.0 - (10.0 * (ln(safe_rho) / ln10));

    return ScatteringResult {
        frequency_ghz: freq_ghz,
        incident_angle_rad: theta_i_rad,
        rayleigh_roughness_param: rayleigh_param,
        specular_reduction_factor: rho_s,
        diffuse_power_fraction: diffuse_fraction,
        specular_reflection_loss_db: spec_loss_db,
    };
}
