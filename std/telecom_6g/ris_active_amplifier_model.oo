// # Active RIS Reflection Amplification & Thermal Noise
//
// Logline: Models active RIS reflection amplification, thermal noise generation, and power dissipation trade-offs.
//
// Setup: Pure standard library implementation of active metasurfaces overcoming double-fading path loss.
//
// Beats:
//   1. Configure active RIS reflection gain G_amp > 1 and RF amplifier noise figure.
//   2. Calculate reflected signal power and amplified thermal noise power at receiver.
//   3. Compute net SNR gain comparing active RIS against passive RIS baselines.

pub type ActiveRisConfig = struct {
    num_elements: Int,
    amplifier_gain_db: Float,
    amplifier_noise_figure_db: Float,
    bandwidth_hz: Float,
    ambient_temp_k: Float,
    dc_power_consumption_w: Float,
};

pub type ActiveRisPerformance = struct {
    linear_gain_factor: Float,
    output_signal_power_dbm: Float,
    ris_added_noise_power_dbm: Float,
    net_snr_gain_db: Float,
};

pub fn active_ris_config_default() -> ActiveRisConfig {
    return ActiveRisConfig {
        num_elements: 128,
        amplifier_gain_db: 15.0, // 15 dB active reflection gain
        amplifier_noise_figure_db: 4.5,
        bandwidth_hz: 100000000.0, // 100 MHz
        ambient_temp_k: 290.0,
        dc_power_consumption_w: 2.5,
    };
}

pub fn active_ris_eval(cfg: ActiveRisConfig, input_rf_power_dbm: Float) -> ActiveRisPerformance {
    let ln10: Float = 2.302585092994046;
    let gain_db: Float = cfg.amplifier_gain_db;
    let g_lin: Float = exp(gain_db * (ln10 / 10.0));

    let out_sig_dbm: Float = input_rf_power_dbm + gain_db;

    // Thermal noise at RIS: N_thermal = k_B * T * B * NF * G
    let k_b: Float = 0.00000000000000000000001380649;
    let temp_k: Float = cfg.ambient_temp_k;
    let bw: Float = cfg.bandwidth_hz;
    let nf_db: Float = cfg.amplifier_noise_figure_db;
    let nf_lin: Float = exp(nf_db * (ln10 / 10.0));

    let n_thermal_w: Float = k_b * temp_k * bw * nf_lin * g_lin;
    let n_thermal_mw: Float = n_thermal_w * 1000.0;
    let mut safe_n_mw: Float = n_thermal_mw;
    if safe_n_mw < 0.00000000000000001 {
        safe_n_mw = 0.00000000000000001;
    }
    let n_dbm: Float = 10.0 * (ln(safe_n_mw) / ln10);

    // Passive RIS has 0 dB gain and no active noise generation
    // Net SNR improvement roughly = Gain_dB - Noise penalty
    let mut net_gain: Float = gain_db - nf_db;
    if net_gain < 0.0 { net_gain = 0.0; }

    return ActiveRisPerformance {
        linear_gain_factor: g_lin,
        output_signal_power_dbm: out_sig_dbm,
        ris_added_noise_power_dbm: n_dbm,
        net_snr_gain_db: net_gain,
    };
}
