// # URLLC Finite Blocklength Coding & PPV Normal Approximation
//
// Logline: Calculates maximal achievable rate and block error rate bounds for short-packet URLLC via Polyanskiy-Poor-Verdú (PPV).
//
// Setup: Pure standard library implementation of finite blocklength information theory for sub-millisecond 6G latency.
//
// Beats:
//   1. Define blocklength n (e.g. 64 to 512 bits) and target block error probability epsilon (e.g. 10^-5 to 10^-9).
//   2. Compute channel dispersion V = (SNR * (SNR + 2)) / (SNR + 1)^2 for AWGN / Rayleigh channels.
//   3. Compute normal approximation achievable rate: R(n, eps) approx C - sqrt(V/n) * Q_inv(eps) + 0.5*log2(n)/n.

pub type FiniteBlocklengthConfig = struct {
    blocklength_symbols_n: Int,
    target_block_error_rate_eps: Float, // e.g. 1e-6
    snr_linear: Float,
};

pub type FblRateMetrics = struct {
    shannon_capacity_bps_hz: Float,
    channel_dispersion_v: Float,
    achievable_rate_fbl_bps_hz: Float,
    finite_blocklength_penalty_pct: Float,
    q_inv_value: Float,
};

pub fn fbl_config_urllc_critical() -> FiniteBlocklengthConfig {
    return FiniteBlocklengthConfig {
        blocklength_symbols_n: 128,
        target_block_error_rate_eps: 0.000001, // 10^-6 BLER
        snr_linear: 10.0, // 10 dB SNR
    };
}

pub fn fbl_calc_q_inv(eps: Float) -> Float {
    // High-accuracy approximation of inverse Q-function Q^-1(eps)
    // For eps = 1e-5: ~4.26, eps = 1e-6: ~4.75, eps = 1e-9: ~6.00
    if eps <= 0.000000001 { return 6.0; }
    if eps <= 0.000001 { return 4.75; }
    if eps <= 0.00001 { return 4.26; }
    if eps <= 0.0001 { return 3.72; }
    if eps <= 0.001 { return 3.09; }
    if eps <= 0.01 { return 2.33; }
    return 1.64;
}

pub fn fbl_eval_achievable_rate(cfg: FiniteBlocklengthConfig) -> FblRateMetrics {
    let n_sym: Int = cfg.blocklength_symbols_n;
    let eps: Float = cfg.target_block_error_rate_eps;
    let snr: Float = cfg.snr_linear;

    let n_f: Float = fbl_int_to_float(n_sym);

    let ln2: Float = 0.6931471805599453;
    // Shannon capacity C = log2(1 + SNR)
    let c_shannon: Float = ln(1.0 + snr) / ln2;

    // Channel dispersion V = (SNR * (SNR + 2)) / (SNR + 1)^2 * log2(e)^2
    let log2_e: Float = 1.4426950408889634;
    let v_nat: Float = (snr * (snr + 2.0)) / ((snr + 1.0) * (snr + 1.0));
    let v_bit: Float = v_nat * log2_e * log2_e;

    let q_inv: Float = fbl_calc_q_inv(eps);

    // PPV Normal Approximation: R approx C - sqrt(V/n)*Q^-1(eps) + 0.5*log2(n)/n
    let backoff: Float = sqrt(v_bit / n_f) * q_inv;
    let log_n_term: Float = (0.5 * (ln(n_f) / ln2)) / n_f;

    let mut r_fbl: Float = c_shannon - backoff + log_n_term;
    if r_fbl < 0.0 { r_fbl = 0.0; }

    let mut penalty_pct: Float = 0.0;
    if c_shannon > 0.0001 {
        penalty_pct = ((c_shannon - r_fbl) / c_shannon) * 100.0;
    }

    return FblRateMetrics {
        shannon_capacity_bps_hz: c_shannon,
        channel_dispersion_v: v_bit,
        achievable_rate_fbl_bps_hz: r_fbl,
        finite_blocklength_penalty_pct: penalty_pct,
        q_inv_value: q_inv,
    };
}

pub fn fbl_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
