// # ESPRIT Search-Free High-Resolution Direction Finding
//
// Logline: Estimates spatial angles of arrival via rotational invariance between translational array subarrays.
//
// Setup: Pure standard library implementation of ESPRIT eigenvalue decomposition avoiding computational grid search.
//
// Beats:
//   1. Partition array into two identical translated subarrays displaced by distance Delta.
//   2. Compute invariance equation Psi = (S_1^H * S_1)^(-1) * S_1^H * S_2 from signal subspace S.
//   3. Extract eigenvalues lambda_i = exp(j * 2*pi * Delta/lambda * sin(theta_i)) to solve target angles.

pub type EspritArrayConfig = struct {
    num_total_elements: Int,
    subarray_size: Int,
    subarray_displacement_m: Float,
    carrier_frequency_ghz: Float
};

pub type EspritEstimatedSource = struct {
    source_index: Int,
    eigenvalue_phase_rad: Float,
    estimated_angle_rad: Float,
    estimated_angle_deg: Float
};

pub fn esprit_config_default_16ant() -> EspritArrayConfig {
    return EspritArrayConfig {
        num_total_elements: 16,
        subarray_size: 15,
        subarray_displacement_m: 0.00107, // Half wavelength at 140 GHz
        carrier_frequency_ghz: 140.0
    };
}

pub fn esprit_solve_angle(eigen_phase_rad: Float, cfg: EspritArrayConfig) -> EspritEstimatedSource {
    let freq: Float = cfg.carrier_frequency_ghz;
    let delta_m: Float = cfg.subarray_displacement_m;

    let c: Float = 299792458.0;
    let lambda: Float = c / (freq * 1000000000.0);
    let pi: Float = 3.141592653589793;

    // Phase: phi = (2 * pi * delta / lambda) * sin(theta)
    // sin(theta) = phi / (2 * pi * delta / lambda)
    let spatial_factor: Float = (2.0 * pi * delta_m) / lambda;
    let mut sin_theta: Float = 0.0;
    if spatial_factor > 0.0001 {
        sin_theta = eigen_phase_rad / spatial_factor;
    }
    if sin_theta > 1.0 { sin_theta = 1.0; }
    if sin_theta < (0.0 - 1.0) { sin_theta = 0.0 - 1.0; }

    // Taylor series asin
    let v: Float = sin_theta;
    let v3: Float = v * v * v;
    let v5: Float = v3 * v * v;
    let theta_rad: Float = v + (v3 / 6.0) + (3.0 * v5 / 40.0);
    let theta_deg: Float = (theta_rad * 180.0) / pi;

    return EspritEstimatedSource {
        source_index: 0,
        eigenvalue_phase_rad: eigen_phase_rad,
        estimated_angle_rad: theta_rad,
        estimated_angle_deg: theta_deg
    };
}
