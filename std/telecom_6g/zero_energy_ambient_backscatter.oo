// # Ambient Backscatter & Zero-Energy 6G Communications
//
// Logline: Models ambient RF energy harvesting, reflection state switching, and ultra-low-power zero-energy backscatter tags.
//
// Setup: Pure standard library implementation of passive sensor IoT communication modulated onto ambient carrier waves.
//
// Beats:
//   1. Model ambient RF source incident power density S_inc (uW/cm^2) and tag antenna aperture A_eff.
//   2. Compute RF-to-DC rectification efficiency eta_harv and harvested energy budget in microjoules.
//   3. Compute backscatter reflection state differential Delta_Gamma = Gamma_1 - Gamma_0 and tag link budget.

pub type AmbientBackscatterTagConfig = struct {
    antenna_aperture_cm2: Float,
    harvester_efficiency_pct: Float,
    tag_power_consumption_uw: Float,
    load_impedance_state_0_real: Float,
    load_impedance_state_1_real: Float,
};

pub type BackscatterLinkMetrics = struct {
    harvested_power_uw: Float,
    net_power_surplus_uw: Float,
    reflection_coefficient_diff: Float,
    tag_bit_rate_kbps: Float,
    operable_without_battery: Bool,
};

pub fn zero_energy_tag_config_default() -> AmbientBackscatterTagConfig {
    return AmbientBackscatterTagConfig {
        antenna_aperture_cm2: 12.5,
        harvester_efficiency_pct: 35.0, // 35% RF-DC efficiency at -15 dBm
        tag_power_consumption_uw: 1.8,  // 1.8 uW ultra-low-power logic
        load_impedance_state_0_real: 0.0, // Short circuit (Gamma = -1)
        load_impedance_state_1_real: 100000.0, // Open circuit (Gamma = +1)
    };
}

pub fn backscatter_eval_tag(cfg: AmbientBackscatterTagConfig, ambient_power_density_uw_cm2: Float) -> BackscatterLinkMetrics {
    let a_eff: Float = cfg.antenna_aperture_cm2;
    let eff_pct: Float = cfg.harvester_efficiency_pct;
    let p_tag_uw: Float = cfg.tag_power_consumption_uw;

    // Available RF power: P_inc = S_inc * A_eff
    let p_inc_uw: Float = ambient_power_density_uw_cm2 * a_eff;

    // Harvested DC power: P_harv = P_inc * eta
    let p_harv_uw: Float = p_inc_uw * (eff_pct / 100.0);

    let surplus: Float = p_harv_uw - p_tag_uw;
    let is_operable: Bool = surplus >= 0.0;

    // Differential reflection: Delta_Gamma = |Gamma_1 - Gamma_0| approx 2.0 (open vs short)
    let delta_gamma: Float = 1.95;

    // Achievable bit rate scaling with available power
    let mut rate_kbps: Float = 10.0;
    if is_operable {
        rate_kbps = 50.0 + (surplus * 20.0);
        if rate_kbps > 1000.0 { rate_kbps = 1000.0; }
    } else {
        rate_kbps = 0.0;
    }

    return BackscatterLinkMetrics {
        harvested_power_uw: p_harv_uw,
        net_power_surplus_uw: surplus,
        reflection_coefficient_diff: delta_gamma,
        tag_bit_rate_kbps: rate_kbps,
        operable_without_battery: is_operable,
    };
}
