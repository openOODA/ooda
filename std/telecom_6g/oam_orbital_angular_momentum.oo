// # Orbital Angular Momentum (OAM) Vortex Wave Multiplexing
//
// Logline: Models helical phase fronts, topological charge modes, phase singularity nulls, and coaxial OAM channel capacity.
//
// Setup: Pure standard library implementation of electromagnetic vortex beams providing orthogonal spatial state multiplexing.
//
// Beats:
//   1. Define topological charge mode index l (-4 .. +4) and azimuth angle phi.
//   2. Compute helical phase distribution phi_l(phi) = exp(j * l * phi) and center intensity null radius.
//   3. Evaluate orthogonality between distinct OAM modes for coaxial sub-THz wireless links.

pub type OamModeConfig = struct {
    topological_charge_l: Int,
    carrier_frequency_ghz: Float,
    beam_waist_radius_m: Float,
    propagation_distance_m: Float
};

pub type OamFieldPoint = struct {
    azimuth_angle_rad: Float,
    radial_distance_m: Float,
    phase_rad: Float,
    field_intensity: Float
};

pub fn oam_mode_config_default(l: Int) -> OamModeConfig {
    return OamModeConfig {
        topological_charge_l: l,
        carrier_frequency_ghz: 140.0,
        beam_waist_radius_m: 0.05, // 5 cm
        propagation_distance_m: 10.0
    };
}

pub fn oam_eval_field_point(cfg: OamModeConfig, azimuth_rad: Float, radius_m: Float) -> OamFieldPoint {
    let l_idx: Int = cfg.topological_charge_l;
    let l_f: Float = oam_int_to_float(l_idx);
    let w_0: Float = cfg.beam_waist_radius_m;

    let pi: Float = 3.141592653589793;
    let two_pi: Float = 2.0 * pi;

    // Helical phase: phase = l * phi
    let raw_phase: Float = l_f * azimuth_rad;
    let mut norm_phase: Float = raw_phase;
    while norm_phase < 0.0 { norm_phase = norm_phase + two_pi; }
    while norm_phase >= two_pi { norm_phase = norm_phase - two_pi; }

    // Laguerre-Gaussian amplitude profile: |E(r)| proportional to (r/w_0)^|l| * exp(-r^2/w_0^2)
    let mut abs_l: Int = l_idx;
    if abs_l < 0 { abs_l = 0 - abs_l; }
    let abs_l_f: Float = oam_int_to_float(abs_l);

    let r_norm: Float = radius_m / w_0;
    let exp_term: Float = exp(0.0 - (r_norm * r_norm));

    let mut r_pow: Float = 1.0;
    let mut count: Int = 0;
    while count < abs_l {
        r_pow = r_pow * r_norm;
        count = count + 1;
    }

    let intensity: Float = r_pow * exp_term;

    return OamFieldPoint {
        azimuth_angle_rad: azimuth_rad,
        radial_distance_m: radius_m,
        phase_rad: norm_phase,
        field_intensity: intensity
    };
}

pub fn oam_mode_orthogonality_check(l1: Int, l2: Int) -> Float {
    if l1 == l2 {
        return 1.0; // Perfect co-channel match
    }
    return 0.0; // Orthogonal over [0, 2*pi]
}

pub fn oam_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
