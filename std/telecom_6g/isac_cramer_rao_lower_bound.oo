// # ISAC Cramér-Rao Lower Bound (CRLB) Error Limits
//
// Logline: Evaluates theoretical CRLB variance lower bounds for radar range, velocity, and angle estimation.
//
// Setup: Pure standard library implementation of information-theoretic estimation error lower bounds in ISAC.
//
// Beats:
//   1. Define Fisher Information Matrix (FIM) parameters for range, Doppler, and azimuth estimation.
//   2. Compute Range CRLB: sigma_R^2 = c^2 / (8 * pi^2 * SNR * B_rms^2).
//   3. Compute Velocity CRLB: sigma_v^2 = lambda^2 / (8 * pi^2 * SNR * T_rms^2) and angular CRLB.

pub type CrlbParameters = struct {
    carrier_frequency_ghz: Float,
    snr_linear: Float,
    effective_bandwidth_mhz: Float,
    effective_duration_ms: Float,
    num_array_elements: Int,
};

pub type CrlbEstimationBounds = struct {
    range_error_std_cm: Float,
    velocity_error_std_cm_s: Float,
    angle_error_std_mrad: Float,
    snr_db: Float,
};

pub fn crlb_parameters_default_isac() -> CrlbParameters {
    return CrlbParameters {
        carrier_frequency_ghz: 140.0,
        snr_linear: 20.0, // approx 13 dB
        effective_bandwidth_mhz: 500.0, // 500 MHz
        effective_duration_ms: 1.0,     // 1 ms
        num_array_elements: 32,
    };
}

pub fn crlb_eval_bounds(params: CrlbParameters) -> CrlbEstimationBounds {
    let freq: Float = params.carrier_frequency_ghz;
    let snr: Float = params.snr_linear;
    let bw_mhz: Float = params.effective_bandwidth_mhz;
    let t_ms: Float = params.effective_duration_ms;
    let n_ant: Int = params.num_array_elements;

    let c: Float = 299792458.0;
    let lambda_m: Float = c / (freq * 1000000000.0);
    let pi: Float = 3.141592653589793;

    let bw_hz: Float = bw_mhz * 1000000.0;
    let t_s: Float = t_ms * 0.001;

    // Range CRLB variance: var_r = c^2 / (8 * pi^2 * SNR * B^2)
    let denom_r: Float = 8.0 * pi * pi * snr * bw_hz * bw_hz;
    let mut var_r: Float = 0.0001;
    if denom_r > 0.0001 {
        var_r = (c * c) / denom_r;
    }
    let std_r_m: Float = sqrt(var_r);
    let std_r_cm: Float = std_r_m * 100.0;

    // Velocity CRLB variance: var_v = lambda^2 / (8 * pi^2 * SNR * T^2)
    let denom_v: Float = 8.0 * pi * pi * snr * t_s * t_s;
    let mut var_v: Float = 0.0001;
    if denom_v > 0.0001 {
        var_v = (lambda_m * lambda_m) / denom_v;
    }
    let std_v_m_s: Float = sqrt(var_v);
    let std_v_cm_s: Float = std_v_m_s * 100.0;

    // Angle CRLB variance: var_theta = 6 / (pi^2 * SNR * M * (M^2 - 1))
    let m_f: Float = crlb_int_to_float(n_ant);
    let denom_theta: Float = pi * pi * snr * m_f * ((m_f * m_f) - 1.0);
    let mut var_theta: Float = 0.0001;
    if denom_theta > 0.0001 {
        var_theta = 6.0 / denom_theta;
    }
    let std_theta_rad: Float = sqrt(var_theta);
    let std_theta_mrad: Float = std_theta_rad * 1000.0;

    let ln10: Float = 2.302585092994046;
    let snr_db: Float = 10.0 * (ln(snr) / ln10);

    return CrlbEstimationBounds {
        range_error_std_cm: std_r_cm,
        velocity_error_std_cm_s: std_v_cm_s,
        angle_error_std_mrad: std_theta_mrad,
        snr_db: snr_db,
    };
}

pub fn crlb_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
