// # Holographic MIMO Continuous Aperture Beamforming
//
// Logline: Synthesizes continuous electromagnetic boundary fields, Green's function integrals, and spatial degrees of freedom.
//
// Setup: Pure standard library implementation of continuous-aperture Holographic MIMO (HMIMO) electromagnetic theory.
//
// Beats:
//   1. Define continuous planar aperture geometry (L_x x L_y) and sub-wavelength discretization pitch.
//   2. Model dyadic Green's function electromagnetic field propagation between holographic surfaces.
//   3. Compute continuous spatial Degrees of Freedom (DoF): N_DoF = (2*pi*A / lambda^2).

pub type HolographicSurface = struct {
    aperture_length_x_m: Float,
    aperture_length_y_m: Float,
    carrier_frequency_ghz: Float,
    sampling_grid_spacing_m: Float
};

pub type HolographicBeamResult = struct {
    aperture_area_m2: Float,
    wavelength_m: Float,
    spatial_degrees_of_freedom: Float,
    max_multiplexing_gain: Int,
    synthesized_field_magnitude: Float
};

pub fn holographic_surface_default_sub_thz() -> HolographicSurface {
    return HolographicSurface {
        aperture_length_x_m: 0.2, // 20 cm x 20 cm
        aperture_length_y_m: 0.2,
        carrier_frequency_ghz: 140.0,
        sampling_grid_spacing_m: 0.0005 // 0.5 mm (sub-wavelength at 140 GHz)
    };
}

pub fn hmimo_calc_wavelength_m(freq_ghz: Float) -> Float {
    let c: Float = 299792458.0;
    return c / (freq_ghz * 1000000000.0);
}

pub fn hmimo_spatial_degrees_of_freedom(area_m2: Float, lambda_m: Float) -> Float {
    let pi: Float = 3.141592653589793;
    let lambda_sq: Float = lambda_m * lambda_m;
    if lambda_sq <= 0.00000001 { return 1.0; }
    // Theoretical continuous spatial DoF: (2 * pi * Area) / lambda^2
    return (2.0 * pi * area_m2) / lambda_sq;
}

pub fn hmimo_greens_function_scalar(dist_m: Float, lambda_m: Float) -> Float {
    if dist_m <= 0.0001 { return 1.0; }
    let pi: Float = 3.141592653589793;
    // Scalar Green's function amplitude: exp(-j*k*r) / (4*pi*r)
    return 1.0 / (4.0 * pi * dist_m);
}

pub fn hmimo_eval_surface(surface: HolographicSurface, target_distance_m: Float) -> HolographicBeamResult {
    let lx: Float = surface.aperture_length_x_m;
    let ly: Float = surface.aperture_length_y_m;
    let freq: Float = surface.carrier_frequency_ghz;

    let area: Float = lx * ly;
    let lambda: Float = hmimo_calc_wavelength_m(freq);
    let dof: Float = hmimo_spatial_degrees_of_freedom(area, lambda);

    let g_mag: Float = hmimo_greens_function_scalar(target_distance_m, lambda);

    let max_mux: Int = hmimo_float_to_int_floor(dof * 0.5); // Practical orthogonal communications channels

    return HolographicBeamResult {
        aperture_area_m2: area,
        wavelength_m: lambda,
        spatial_degrees_of_freedom: dof,
        max_multiplexing_gain: max_mux,
        synthesized_field_magnitude: g_mag
    };
}

pub fn hmimo_float_to_int_floor(f: Float) -> Int {
    let mut count: Int = 0;
    let mut rem: Float = f;
    if rem < 0.0 { return 0; }
    while rem >= 1000.0 { count = count + 1000; rem = rem - 1000.0; }
    while rem >= 100.0 { count = count + 100; rem = rem - 100.0; }
    while rem >= 10.0 { count = count + 10; rem = rem - 10.0; }
    while rem >= 1.0 { count = count + 1; rem = rem - 1.0; }
    return count;
}
