// # Metasurface Polarization Conversion & PCR
//
// Logline: Calculates linear-to-circular conversion, cross-polarization conversion ratio (PCR), and co-to-cross reflections.
//
// Setup: Pure standard library implementation of anisotropic metasurface scattering matrices for 6G polarization agile links.
//
// Beats:
//   1. Define 2x2 complex reflection Jones matrix: R_xx, R_yx, R_xy, R_yy.
//   2. Compute Cross-Polarization Conversion Ratio: PCR = |R_yx|^2 / (|R_xx|^2 + |R_yx|^2).
//   3. Evaluate Axial Ratio (AR) for Linear-to-Circular Polarization (LP-to-CP) conversion.

pub type PolarizationMatrix = struct {
    r_xx_mag: Float,
    r_xx_phase_rad: Float,
    r_yx_mag: Float,
    r_yx_phase_rad: Float,
    r_yy_mag: Float,
    r_yy_phase_rad: Float,
};

pub type PolarizationConversionResult = struct {
    frequency_ghz: Float,
    pcr_linear: Float,
    pcr_percent: Float,
    axial_ratio_db: Float,
    is_circularly_polarized: Bool,
};

pub fn metasurface_polarizer_cross_converter() -> PolarizationMatrix {
    return PolarizationMatrix {
        r_xx_mag: 0.08,
        r_xx_phase_rad: 0.0,
        r_yx_mag: 0.96, // 96% cross-polarization magnitude
        r_yx_phase_rad: 1.5707963267948966,
        r_yy_mag: 0.08,
        r_yy_phase_rad: 0.0,
    };
}

pub fn metasurface_polarizer_linear_to_circular() -> PolarizationMatrix {
    return PolarizationMatrix {
        r_xx_mag: 0.7071, // 1/sqrt(2)
        r_xx_phase_rad: 0.0,
        r_yx_mag: 0.7071,
        r_yx_phase_rad: 1.5707963267948966, // 90 degree phase shift
        r_yy_mag: 0.7071,
        r_yy_phase_rad: 0.0,
    };
}

pub fn ris_calc_polarization_conversion(freq_ghz: Float, mat: PolarizationMatrix) -> PolarizationConversionResult {
    let r_xx: Float = mat.r_xx_mag;
    let r_yx: Float = mat.r_yx_mag;
    let p_yx_phase: Float = mat.r_yx_phase_rad;
    let p_xx_phase: Float = mat.r_xx_phase_rad;

    let p_co: Float = r_xx * r_xx;
    let p_cross: Float = r_yx * r_yx;
    let p_tot: Float = p_co + p_cross;

    let mut pcr: Float = 0.0;
    if p_tot > 0.0001 {
        pcr = p_cross / p_tot;
    }
    let pcr_pct: Float = pcr * 100.0;

    // Axial Ratio AR calculation
    let mut phase_diff: Float = p_yx_phase - p_xx_phase;
    if phase_diff < 0.0 { phase_diff = 0.0 - phase_diff; }

    let pi: Float = 3.141592653589793;
    let is_cp: Bool = (pcr_pct >= 45.0) && (pcr_pct <= 55.0);

    let ln10: Float = 2.302585092994046;
    let mut ratio: Float = 10.0;
    if r_xx > 0.0001 {
        ratio = r_yx / r_xx;
    }
    let ar_db: Float = 20.0 * (ln(ratio) / ln10);

    return PolarizationConversionResult {
        frequency_ghz: freq_ghz,
        pcr_linear: pcr,
        pcr_percent: pcr_pct,
        axial_ratio_db: ar_db,
        is_circularly_polarized: is_cp,
    };
}
