// # Generalized Frequency Division Multiplexing (GFDM)
//
// Logline: Models block-structured non-orthogonal GFDM multicarrier waveforms with circular pulse shaping and single-CP overhead.
//
// Setup: Pure standard library implementation of flexible 2D block-based time-frequency waveforms for 6G machine-type links.
//
// Beats:
//   1. Configure GFDM block structure (K subcarriers x M time subsymbols per block).
//   2. Apply Root Raised Cosine (RRC) circular filter shaping in time-frequency matrix.
//   3. Compute single cyclic prefix overhead reduction and self-interference cancellation.

pub type GfdmBlockConfig = struct {
    num_subcarriers_k: Int,
    num_subsymbols_m: Int,
    rrc_rolloff_alpha: Float,
    cyclic_prefix_length: Int
};

pub type GfdmBlockMetrics = struct {
    total_block_symbols: Int,
    total_samples_with_cp: Int,
    cp_overhead_reduction_pct: Float,
    rrc_alpha: Float
};

pub fn gfdm_config_default() -> GfdmBlockConfig {
    return GfdmBlockConfig {
        num_subcarriers_k: 16,
        num_subsymbols_m: 9, // 16 * 9 = 144 symbols per block
        rrc_rolloff_alpha: 0.35,
        cyclic_prefix_length: 16
    };
}

pub fn gfdm_eval_block(cfg: GfdmBlockConfig) -> GfdmBlockMetrics {
    let k_sub: Int = cfg.num_subcarriers_k;
    let m_sub: Int = cfg.num_subsymbols_m;
    let cp_len: Int = cfg.cyclic_prefix_length;
    let alpha: Float = cfg.rrc_rolloff_alpha;

    let n_tot_symbols: Int = k_sub * m_sub;
    let n_samples_block: Int = n_tot_symbols;
    let n_tot_with_cp: Int = n_samples_block + cp_len;

    // Standard OFDM uses 1 CP per symbol: total CP = M * L_cp
    let ofdm_cp_total: Int = m_sub * cp_len;
    let gfdm_cp_total: Int = cp_len; // Only 1 CP per block of M symbols

    let ofdm_cp_f: Float = gfdm_int_to_float(ofdm_cp_total);
    let gfdm_cp_f: Float = gfdm_int_to_float(gfdm_cp_total);
    let mut cp_saving: Float = 0.0;
    if ofdm_cp_f > 0.0001 {
        cp_saving = ((ofdm_cp_f - gfdm_cp_f) / ofdm_cp_f) * 100.0;
    }

    return GfdmBlockMetrics {
        total_block_symbols: n_tot_symbols,
        total_samples_with_cp: n_tot_with_cp,
        cp_overhead_reduction_pct: cp_saving,
        rrc_alpha: alpha
    };
}

pub fn gfdm_rrc_frequency_response(freq_norm: Float, alpha: Float) -> Float {
    let pi: Float = 3.141592653589793;
    let mut f_abs: Float = freq_norm;
    if f_abs < 0.0 { f_abs = 0.0 - f_abs; }

    let f1: Float = (1.0 - alpha) / 2.0;
    let f2: Float = (1.0 + alpha) / 2.0;

    if f_abs <= f1 {
        return 1.0;
    }
    if f_abs > f2 {
        return 0.0;
    }
    let phi: Float = (pi / (2.0 * alpha)) * (f_abs - f1);
    return cos(phi);
}

pub fn gfdm_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
