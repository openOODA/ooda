// # Terahertz Drude Plasma & Conductivity Model
//
// Logline: Implements Drude-Smith carrier transport, plasma frequency, and complex permittivity for semiconductors and graphene at THz.
//
// Setup: Pure standard library implementation of solid-state electrodynamics for 6G Terahertz active materials and metasurfaces.
//
// Beats:
//   1. Compute plasma frequency omega_p from carrier density and effective mass.
//   2. Calculate Drude AC complex conductivity sigma(omega) = sigma_0 / (1 - j*omega*tau).
//   3. Compute complex relative permittivity epsilon_r and THz skin depth.

pub type SemiconductorCarrierModel = struct {
    carrier_density_m3: Float,
    effective_mass_ratio: Float,
    mobility_cm2_v_s: Float,
    high_freq_permittivity_eps_inf: Float
};

pub type DrudePermittivityResult = struct {
    frequency_thz: Float,
    plasma_frequency_thz: Float,
    permittivity_real: Float,
    permittivity_imag: Float,
    conductivity_real_s_m: Float,
    skin_depth_um: Float
};

pub fn semiconductor_inas_sub_thz() -> SemiconductorCarrierModel {
    return SemiconductorCarrierModel {
        carrier_density_m3: 100000000000000000000000.0, // 10^23 m^-3
        effective_mass_ratio: 0.026,
        mobility_cm2_v_s: 20000.0,
        high_freq_permittivity_eps_inf: 12.3
    };
}

pub fn semiconductor_graphene_thz() -> SemiconductorCarrierModel {
    return SemiconductorCarrierModel {
        carrier_density_m3: 50000000000000000000000.0, // 5*10^22 m^-3
        effective_mass_ratio: 0.012,
        mobility_cm2_v_s: 50000.0,
        high_freq_permittivity_eps_inf: 4.0
    };
}

pub fn thz_calc_plasma_frequency_rad_s(carrier_density: Float, eff_mass_ratio: Float) -> Float {
    let q_elem: Float = 0.0000000000000000001602176634; // 1.602e-19 C
    let m_0: Float = 0.00000000000000000000000000000091093837; // 9.109e-31 kg
    let m_eff: Float = eff_mass_ratio * m_0;
    let eps_0: Float = 0.0000000000088541878128; // 8.854e-12 F/m

    let numerator: Float = carrier_density * q_elem * q_elem;
    let denominator: Float = eps_0 * m_eff;
    if denominator <= 0.0 {
        return 0.0;
    }
    return sqrt(numerator / denominator);
}

pub fn thz_calc_drude_permittivity(freq_thz: Float, model: SemiconductorCarrierModel) -> DrudePermittivityResult {
    let pi: Float = 3.141592653589793;
    let omega: Float = 2.0 * pi * freq_thz * 1000000000000.0;

    let n_dens: Float = model.carrier_density_m3;
    let eff_ratio: Float = model.effective_mass_ratio;
    let mob: Float = model.mobility_cm2_v_s;
    let eps_inf: Float = model.high_freq_permittivity_eps_inf;

    let omega_p_rad_s: Float = thz_calc_plasma_frequency_rad_s(n_dens, eff_ratio);
    let omega_p_thz: Float = omega_p_rad_s / (2.0 * pi * 1000000000000.0);

    // Collision time tau = mu * m_eff / q
    let q_elem: Float = 0.0000000000000000001602176634;
    let m_0: Float = 0.00000000000000000000000000000091093837;
    let m_eff: Float = eff_ratio * m_0;
    let mu_m2: Float = mob * 0.0001;
    let tau_s: Float = (mu_m2 * m_eff) / q_elem;

    // Drude formula: eps_r = eps_inf - omega_p^2 / (omega^2 + j*omega/tau)
    let denom: Float = (omega * omega) + (1.0 / (tau_s * tau_s));
    let eps_real: Float = eps_inf - ((omega_p_rad_s * omega_p_rad_s) / denom);
    let eps_imag: Float = (omega_p_rad_s * omega_p_rad_s / (omega * tau_s)) / denom;

    // DC / AC conductivity
    let eps_0: Float = 0.0000000000088541878128;
    let sigma_real: Float = eps_0 * omega * eps_imag;

    // Skin depth delta = sqrt(2 / (omega * mu_0 * sigma))
    let mu_0: Float = 0.0000012566370614359173;
    let mut skin_m: Float = 1.0;
    if sigma_real > 0.001 {
        skin_m = sqrt(2.0 / (omega * mu_0 * sigma_real));
    }

    return DrudePermittivityResult {
        frequency_thz: freq_thz,
        plasma_frequency_thz: omega_p_thz,
        permittivity_real: eps_real,
        permittivity_imag: eps_imag,
        conductivity_real_s_m: sigma_real,
        skin_depth_um: skin_m * 1000000.0
    };
}
