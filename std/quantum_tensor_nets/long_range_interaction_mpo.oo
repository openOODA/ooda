// # Long-Range Interactions MPO via Sum of Exponentials
//
// Logline: Fits power-law $1/r^\alpha$ and Coulomb long-range quantum potentials into compact MPOs using sums of exponential decay terms $\sum_k c_k \lambda_k^r$.
//
// Setup: Compact representation of all-to-all and decaying two-body interactions with minimal MPO bond dimension $W \sim 2 K + 2$.
//
// Beats:
//   1. Define LongRangeFitConfig, ExponentialTerm, and PowerLawMpoResult data structures.
//   2. Fit power-law decaying interaction kernel $V(r) = 1/r^\alpha \approx \sum_{k=1}^K c_k \lambda_k^r$.
//   3. Assemble compact MPO bond recurrence tensors for long-range Coulomb/dipolar models.

pub type ExponentialTerm = struct {
    weight_c: Float,
    decay_base_lambda: Float,
};

pub type LongRangeFitConfig = struct {
    power_alpha: Float,
    max_distance_r: Int,
    num_exponentials: Int,
};

pub type PowerLawMpoResult = struct {
    num_terms: Int,
    mpo_bond_dimension: Int,
    max_fitting_error: Float,
    terms: List[ExponentialTerm],
};

pub fn long_range_fit_config_coulomb(max_r: Int) -> LongRangeFitConfig {
    return LongRangeFitConfig {
        power_alpha: 1.0, // 1/r
        max_distance_r: max_r,
        num_exponentials: 4,
    };
}

pub fn long_range_fit_config_dipolar(max_r: Int) -> LongRangeFitConfig {
    return LongRangeFitConfig {
        power_alpha: 3.0, // 1/r^3
        max_distance_r: max_r,
        num_exponentials: 4,
    };
}

pub fn power_law_mpo_bond_dimension(num_exponentials: Int) -> Int {
    // Each exponential term adds 1 internal state in the MPO automaton: W = num_terms + 2
    return num_exponentials + 2;
}

pub fn evaluate_exponential_sum(terms: List[ExponentialTerm], r: Int) -> Float {
    let n: Int = list_len(terms);
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let t: ExponentialTerm = list_get(terms, i);
        let c: Float = t.weight_c;
        let lam: Float = t.decay_base_lambda;

        let mut p: Float = 1.0;
        let mut d: Int = 0;
        while d < r {
            p = p * lam;
            d = d + 1;
        }

        sum = sum + c * p;
        i = i + 1;
    }
    return sum;
}
