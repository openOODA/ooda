// # Fermi-Hubbard Model MPO & Jordan-Wigner Transformation
//
// Logline: Constructs exact MPO representations for the 1D and 2D Fermi-Hubbard model mapped to spin-1/2 qubits via Jordan-Wigner transformation.
//
// Setup: Strongly correlated electron Hamiltonian $H = -t \sum_{\langle ij \rangle, \sigma} (c_{i\sigma}^\dagger c_{j\sigma} + \text{h.c.}) + U \sum_i n_{i\uparrow} n_{i\downarrow} - \mu \sum_i (n_{i\uparrow} + n_{i\downarrow})$.
//
// Beats:
//   1. Define FermiHubbardConfig and FermionSiteBasis (local dimension $d=4$: empty, up, down, double).
//   2. Implement Jordan-Wigner string sign tracking for spinful fermionic hopping.
//   3. Construct block upper-triangular MPO tensors for on-site repulsion $U$ and chemical potential $\mu$.

pub type FermiHubbardConfig = struct {
    num_sites: Int,
    hopping_t: Float,
    repulsion_u: Float,
    chemical_potential_mu: Float,
    magnetic_field_b: Float,
};

pub fn fermi_hubbard_config_default(num_sites: Int, u_over_t: Float) -> FermiHubbardConfig {
    return FermiHubbardConfig {
        num_sites: num_sites,
        hopping_t: 1.0,
        repulsion_u: u_over_t,
        chemical_potential_mu: u_over_t / 2.0, // Half-filling at mu = U/2
        magnetic_field_b: 0.0,
    };
}

pub fn fermi_hubbard_local_phys_dim() -> Int {
    // 4 local states: |0>, |up>, |down>, |up,down>
    return 4;
}

pub fn fermi_hubbard_mpo_bond_dim_1d() -> Int {
    // 1D Fermi-Hubbard with spin up and spin down hopping requires MPO bond dimension W = 6
    return 6;
}

pub fn fermi_hubbard_on_site_energy(cfg: &FermiHubbardConfig, n_up: Int, n_dn: Int) -> Float {
    let u: Float = cfg.repulsion_u;
    let mu: Float = cfg.chemical_potential_mu;
    let n_up_f: Float = (n_up as Float);
    let n_dn_f: Float = (n_dn as Float);
    let n_tot: Float = n_up_f + n_dn_f;
    return (u * n_up_f * n_dn_f) - (mu * n_tot);
}
