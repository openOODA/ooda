// # Mixed Canonical Forms & Orthogonality Centers
//
// Logline: Implements mixed-canonical MPS representations with left-isometric $A$ tensors, right-isometric $B$ tensors, and singular value center $\Lambda$.
//
// Setup: Mixed canonical form factorizing an MPS into $A^{[1]} \dots A^{[k-1]} M^{[k]} B^{[k+1]} \dots B^{[N]}$ around orthogonality center $k$.
//
// Beats:
//   1. Define CanonicalGaugeType and MixedCanonicalMPS data structures.
//   2. Implement left/right gauge shifting across adjacent sites via QR sweeps.
//   3. Validate isometric invariants and local transfer matrix spectra.

pub type CanonicalGauge = struct {
    site_index: Int,
    is_left_canonical: Int,
    is_right_canonical: Int,
    is_orthogonality_center: Int
};

pub type MixedCanonicalConfig = struct {
    num_sites: Int,
    center_site: Int,
    left_chi_max: Int,
    right_chi_max: Int
};

pub fn canonical_gauge_new(site: Int) -> CanonicalGauge {
    return CanonicalGauge {
        site_index: site,
        is_left_canonical: 0,
        is_right_canonical: 0,
        is_orthogonality_center: 0
    };
}

pub fn mixed_canonical_config_new(sites: Int, center: Int) -> MixedCanonicalConfig {
    return MixedCanonicalConfig {
        num_sites: sites,
        center_site: center,
        left_chi_max: 64,
        right_chi_max: 64
    };
}

pub fn mixed_canonical_site_type(cfg: &MixedCanonicalConfig, site: Int) -> Int {
    // Returns: 0 = Left-isometric (A), 1 = Center (M / Lambda), 2 = Right-isometric (B)
    let c: Int = cfg.center_site;
    if site < c {
        return 0;
    } else if site == c {
        return 1;
    } else {
        return 2;
    }
}

pub fn mixed_canonical_shift_center(cfg: &mut MixedCanonicalConfig, new_center: Int) -> Int {
    let n: Int = cfg.num_sites;
    if new_center >= 0 && new_center < n {
        cfg.center_site = new_center;
        return 1;
    }
    return 0;
}
