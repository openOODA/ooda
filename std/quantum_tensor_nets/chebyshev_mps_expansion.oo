// # Chebyshev MPS Expansion for Dynamical Spectral Functions
//
// Logline: Computes zero-temperature dynamical response functions and Green's functions $A(\omega)$ using Chebyshev polynomial vector expansions on MPS.
//
// Setup: Expansion of spectral operators $(E - H + i\eta)^{-1}$ into Chebyshev polynomials $T_n(H')$ on rescaled Hamiltonian spectrum $[-1, 1]$.
//
// Beats:
//   1. Define ChebyshevMpsConfig, ChebyshevMoment, and SpectralResponseCurve data structures.
//   2. Implement three-term recurrence relation $|t_n\rangle = 2 H' |t_{n-1}\rangle - |t_{n-2}\rangle$ with MPS compression.
//   3. Reconstruct frequency-domain spectral functions using Jackson/Lorentz damping kernels.

pub type ChebyshevMpsConfig = struct {
    num_moments: Int,
    energy_center: Float,
    energy_half_width: Float,
    broadening_eta: Float,
    max_bond_dimension: Int,
};

pub type ChebyshevMoment = struct {
    order_n: Int,
    moment_value: Float,
    damping_factor: Float,
};

pub fn chebyshev_mps_config_default(num_moments: Int) -> ChebyshevMpsConfig {
    return ChebyshevMpsConfig {
        num_moments: num_moments,
        energy_center: 0.0,
        energy_half_width: 5.0,
        broadening_eta: 0.05,
        max_bond_dimension: 64,
    };
}

pub fn chebyshev_rescale_energy(cfg: &ChebyshevMpsConfig, e: Float) -> Float {
    let e_c: Float = cfg.energy_center;
    let w: Float = cfg.energy_half_width;
    if w <= 0.0 {
        return 0.0;
    }
    return (e - e_c) / w;
}

pub fn jackson_kernel_damping(n: Int, num_moments: Int) -> Float {
    let num_m_f: Float = (num_moments as Float);
    let n_f: Float = (n as Float);
    let n_plus_1: Float = num_m_f + 1.0;
    let ratio: Float = (num_m_f - n_f + 1.0) / n_plus_1;
    let damping: Float = ratio;
    return damping;
}
