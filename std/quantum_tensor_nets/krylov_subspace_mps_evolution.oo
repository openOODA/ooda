// # Krylov Subspace Lanczos-Based MPS Time Evolution
//
// Logline: Implements global Krylov subspace Lanczos exponentiation $e^{-i H \Delta t} |\psi\rangle$ on the MPS manifold with variational recompression.
//
// Setup: High-order time stepper constructing tridiagonal Krylov matrices $T_m$ for short-time matrix exponential actions.
//
// Beats:
//   1. Define KrylovMpsConfig, TridiagonalKrylovMatrix, and LanczosStepReport data structures.
//   2. Implement Arnoldi/Lanczos orthogonalization loop across MPS states.
//   3. Exponentiate small tridiagonal matrix $e^{-i T_m \Delta t} e_1$ and reconstruct the updated MPS.

pub type KrylovMpsConfig = struct {
    krylov_dimension: Int,
    time_step_dt: Float,
    max_bond_dim: Int,
    tolerance: Float
};

pub type TridiagonalKrylovMatrix = struct {
    dim: Int,
    alpha_diag: List[Float],
    beta_subdiag: List[Float]
};

pub type LanczosStepReport = struct {
    iterations_used: Int,
    estimated_error: Float,
    is_converged: Int
};

pub fn krylov_mps_config_default(dim: Int, dt: Float) -> KrylovMpsConfig {
    return KrylovMpsConfig {
        krylov_dimension: dim,
        time_step_dt: dt,
        max_bond_dim: 64,
        tolerance: 0.00000001
    };
}

pub fn tridiagonal_krylov_matrix_new(dim: Int) -> TridiagonalKrylovMatrix {
    let empty_a: List[Float] = list_new();
    let empty_b: List[Float] = list_new();
    return TridiagonalKrylovMatrix {
        dim: dim,
        alpha_diag: empty_a,
        beta_subdiag: empty_b
    };
}

pub fn lanczos_step_report_new(iters: Int, err: Float) -> LanczosStepReport {
    let abs_err: Float = if err < 0.0 { 0.0 - err } else { err };
    let conv: Int = if abs_err < 0.00000001 { 1 } else { 0 };
    return LanczosStepReport {
        iterations_used: iters,
        estimated_error: abs_err,
        is_converged: conv
    };
}
