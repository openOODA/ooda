// # DMRG Excited States & Spectral Gaps
//
// Logline: Calculates low-lying excited states using orthogonality-constrained DMRG energy penalties $H' = H + \sum_k w_k |\psi_k \rangle \langle \psi_k|$.
//
// Setup: Spectral gap calculation $\Delta = E_1 - E_0$ and targeting orthogonal excitation sectors in strongly correlated systems.
//
// Beats:
//   1. Define ExcitedStatePenalty and SpectralGapInfo data structures.
//   2. Implement penalty-shifted effective Hamiltonian projector construction.
//   3. Compute energy gaps, orthogonality checks $\langle \psi_0 | \psi_1 \rangle = 0$, and quasiparticle excitations.

pub type ExcitedStatePenalty = struct {
    state_id: Int,
    penalty_weight: Float,
    overlap_sq: Float
};

pub type SpectralGapInfo = struct {
    ground_energy: Float,
    excited_energy: Float,
    spectral_gap: Float,
    is_gapped: Int
};

pub fn excited_state_penalty_new(id: Int, weight: Float) -> ExcitedStatePenalty {
    return ExcitedStatePenalty {
        state_id: id,
        penalty_weight: weight,
        overlap_sq: 0.0
    };
}

pub fn spectral_gap_compute(e0: Float, e1: Float, gap_tol: Float) -> SpectralGapInfo {
    let gap: Float = e1 - e0;
    let is_gapped: Int = if gap > gap_tol { 1 } else { 0 };
    return SpectralGapInfo {
        ground_energy: e0,
        excited_energy: e1,
        spectral_gap: gap,
        is_gapped: is_gapped
    };
}

pub fn penalty_effective_shift(base_energy: Float, penalties: List[ExcitedStatePenalty]) -> Float {
    let n: Int = list_len(penalties);
    let mut total: Float = base_energy;
    let mut i: Int = 0;
    while i < n {
        let p: ExcitedStatePenalty = list_get(penalties, i);
        let shift: Float = p.penalty_weight * p.overlap_sq;
        total = total + shift;
        i = i + 1;
    }
    return total;
}
