// # Heisenberg Spin-1/2 and Spin-1 Chain MPO Generator
//
// Logline: Generates exact compact MPOs for isotropic XXX, anisotropic XXZ, and generalized XYZ Heisenberg spin models with boundary magnetic fields.
//
// Setup: Nearest-neighbor spin interaction Hamiltonian $H = \sum_i (J_x S_i^x S_{i+1}^x + J_y S_i^y S_{i+1}^y + J_z S_i^z S_{i+1}^z) - h \sum_i S_i^z$.
//
// Beats:
//   1. Define HeisenbergConfig and SpinMpoBondMatrices data structures.
//   2. Construct 5x5 block upper-triangular MPO matrices for spin-1/2 chains.
//   3. Support Spin-1 Haldane chains with single-ion anisotropy $D (S_i^z)^2$.

pub type HeisenbergConfig = struct {
    num_sites: Int,
    spin_magnitude: Float, // 0.5 for Spin-1/2, 1.0 for Spin-1
    jx: Float,
    jy: Float,
    jz: Float,
    field_hz: Float,
    anisotropy_d: Float // For spin-1: D * (S^z)^2
};

pub fn heisenberg_config_xxx(num_sites: Int, j: Float) -> HeisenbergConfig {
    return HeisenbergConfig {
        num_sites: num_sites,
        spin_magnitude: 0.5,
        jx: j,
        jy: j,
        jz: j,
        field_hz: 0.0,
        anisotropy_d: 0.0
    };
}

pub fn heisenberg_config_xxz(num_sites: Int, j: Float, delta_z: Float, h: Float) -> HeisenbergConfig {
    return HeisenbergConfig {
        num_sites: num_sites,
        spin_magnitude: 0.5,
        jx: j,
        jy: j,
        jz: j * delta_z,
        field_hz: h,
        anisotropy_d: 0.0
    };
}

pub fn heisenberg_config_spin1_haldane(num_sites: Int, j: Float, d: Float) -> HeisenbergConfig {
    return HeisenbergConfig {
        num_sites: num_sites,
        spin_magnitude: 1.0,
        jx: j,
        jy: j,
        jz: j,
        field_hz: 0.0,
        anisotropy_d: d
    };
}

pub fn heisenberg_mpo_bond_dim(cfg: &HeisenbergConfig) -> Int {
    // For spin-1/2 nearest neighbor with Jx, Jy, Jz and hz: bond dimension W = 5
    return 5;
}
