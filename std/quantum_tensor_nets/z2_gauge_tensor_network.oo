// # Z2 Lattice Gauge Theory & Gauss's Law Tensor Networks
//
// Logline: Implements $\mathbb{Z}_2$ lattice gauge theory tensor networks enforcing local Gauss's law projectors $A_v = \prod_{l \in v} \sigma_l^x = 1$.
//
// Setup: Exact tensor formulation of Wegner's $\mathbb{Z}_2$ gauge theory and Toric Code ground states via local gauge invariance projectors.
//
// Beats:
//   1. Define Z2GaugeConfig, GaussLawProjector, and PlaquetteFluxObservable data structures.
//   2. Construct local gauge-invariant vertex and plaquette tensors on square and hexagonal lattices.
//   3. Measure Wilson loop expectation values $W(C) = \langle \prod_{l \in C} \sigma_l^z \rangle$ and topological confinement.

pub type Z2GaugeConfig = struct {
    num_vertices: Int,
    gauge_coupling_k: Float,
    matter_coupling_h: Float,
    enforce_gauss_law: Int,
};

pub type GaussLawProjector = struct {
    vertex_id: Int,
    coordination_number: Int,
    charge_background: Int, // 0: Vacuum, 1: Static charge
    is_satisfied: Int,
};

pub fn z2_gauge_config_default(vertices: Int) -> Z2GaugeConfig {
    return Z2GaugeConfig {
        num_vertices: vertices,
        gauge_coupling_k: 1.0,
        matter_coupling_h: 0.2,
        enforce_gauss_law: 1,
    };
}

pub fn gauss_law_projector_new(v: Int, coord: Int, charge: Int) -> GaussLawProjector {
    return GaussLawProjector {
        vertex_id: v,
        coordination_number: coord,
        charge_background: charge,
        is_satisfied: 1,
    };
}

pub fn z2_wilson_loop_area_law(area: Int, perimeter: Int, string_tension: Float) -> Float {
    // <W(C)> ~ exp(- sigma * Area - mu * Perimeter)
    let area_f: Float = (area as Float);
    let perim_f: Float = (perimeter as Float);
    let exponent: Float = (string_tension * area_f) + (0.1 * perim_f);
    // Approximation for exp(-exponent)
    let val: Float = if exponent > 0.0001 { 1.0 / (1.0 + exponent + 0.5 * exponent * exponent) } else { 1.0 };
    return val;
}
