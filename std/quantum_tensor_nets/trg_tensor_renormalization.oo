// # Tensor Renormalization Group (TRG) & Levin-Nave Coarse-Graining
//
// Logline: Implements Levin-Nave TRG real-space coarse-graining for 2D classical and quantum tensor network partition functions.
//
// Setup: Factorization of 4-index vertex tensors into $M_1 M_2 M_3 M_4$ matrices via SVD followed by diagonal reconnection and scale doubling.
//
// Beats:
//   1. Define TrgConfig, TrgStepReport, and VertexTensor4D data structures.
//   2. Implement 4-way SVD decomposition of lattice site vertices into corner pairs.
//   3. Contract coarse-grained square plaquettes and measure free energy per site $f = -T \ln Z / N$.

pub type TrgConfig = struct {
    chi_max: Int,
    max_iterations: Int,
    singular_value_tol: Float,
    temperature: Float,
};

pub type TrgStepReport = struct {
    iteration: Int,
    lattice_size: Float, // 2^iteration
    free_energy_per_site: Float,
    internal_energy_per_site: Float,
    bond_dimension: Int,
    discarded_svd_weight: Float,
};

pub fn trg_config_default(chi: Int, temp: Float) -> TrgConfig {
    return TrgConfig {
        chi_max: chi,
        max_iterations: 30,
        singular_value_tol: 0.00000001,
        temperature: temp,
    };
}

pub fn trg_step_report_new(iter: Int, f_e: Float, u_e: Float, chi: Int, disc: Float) -> TrgStepReport {
    let mut size: Float = 1.0;
    let mut i: Int = 0;
    while i < iter {
        size = size * 2.0;
        i = i + 1;
    }
    return TrgStepReport {
        iteration: iter,
        lattice_size: size,
        free_energy_per_site: f_e,
        internal_energy_per_site: u_e,
        bond_dimension: chi,
        discarded_svd_weight: disc,
    };
}

pub fn trg_free_energy_update(prev_f: Float, local_norm: Float, iter: Int, temp: Float) -> Float {
    let mut scale: Float = 1.0;
    let mut i: Int = 0;
    while i < iter {
        scale = scale * 2.0;
        i = i + 1;
    }
    let log_z: Float = if local_norm > 0.00001 { (local_norm - 1.0) / (0.5 * (local_norm + 1.0)) } else { 0.0 };
    let term: Float = (0.0 - temp) * log_z / scale;
    return prev_f + term;
}
