// # DMRG Effective Hamiltonian & Environment Tensor Networks
//
// Logline: Constructs left (L) and right (R) environment tensors contracting bra, MPO, and ket layers for single- and two-site effective Hamiltonians.
//
// Setup: Effective local Hamiltonian matrix representation $H_{\text{eff}} = L \otimes W \otimes R$ projected onto the active site Hilbert space.
//
// Beats:
//   1. Define EnvironmentBlock and EffectiveHamiltonian3Site data structures.
//   2. Implement environment tensor accumulation (left and right recursive contraction).
//   3. Compute local matrix-vector product for Krylov/Lanczos iterations.

pub type EnvironmentElement3D = struct {
    bra_bond: Int,
    mpo_bond: Int,
    ket_bond: Int,
    val: Float
};

pub fn env_element_3d_new(b: Int, m: Int, k: Int, v: Float) -> EnvironmentElement3D {
    return EnvironmentElement3D {
        bra_bond: b,
        mpo_bond: m,
        ket_bond: k,
        val: v
    };
}

pub type EnvironmentBlock = struct {
    site_index: Int,
    bra_dim: Int,
    mpo_dim: Int,
    ket_dim: Int,
    entries: List[EnvironmentElement3D]
};

pub fn environment_block_new(site: Int, b_dim: Int, m_dim: Int, k_dim: Int) -> EnvironmentBlock {
    let empty_entries: List[EnvironmentElement3D] = list_new();
    return EnvironmentBlock {
        site_index: site,
        bra_dim: b_dim,
        mpo_dim: m_dim,
        ket_dim: k_dim,
        entries: empty_entries
    };
}

pub fn environment_block_add(block: &mut EnvironmentBlock, b: Int, m: Int, k: Int, val: Float) {
    let elem: EnvironmentElement3D = env_element_3d_new(b, m, k, val);
    list_push(block.entries, elem);
}

pub fn environment_block_get(block: &EnvironmentBlock, b: Int, m: Int, k: Int) -> Float {
    let n: Int = list_len(block.entries);
    let mut i: Int = 0;
    while i < n {
        let e: EnvironmentElement3D = list_get(block.entries, i);
        if e.bra_bond == b && e.mpo_bond == m && e.ket_bond == k {
            return e.val;
        }
        i = i + 1;
    }
    return 0.0;
}

pub fn environment_trivial_boundary(site: Int) -> EnvironmentBlock {
    let mut blk: EnvironmentBlock = environment_block_new(site, 1, 1, 1);
    environment_block_add(&mut blk, 0, 0, 0, 1.0);
    return blk;
}
