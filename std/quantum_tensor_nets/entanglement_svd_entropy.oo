// # Entanglement Entropy, SVD Spectra & Schmidt Decompositions
//
// Logline: Computes bipartite Von Neumann and Rényi entanglement entropies, Schmidt ranks, and entanglement spectrum distributions from MPS singular values.
//
// Setup: Bipartitioning a 1D chain into subsystems $A$ and $B$ to quantify quantum entanglement $S_A = -\sum \lambda_i^2 \ln \lambda_i^2$.
//
// Beats:
//   1. Define EntanglementSpectrum, RenyiEntropyConfig, and EntropyBipartition data structures.
//   2. Compute Von Neumann entropy $S_{vN}$, Rényi-2 entropy $S_2$, and Schmidt gap.
//   3. Extract central charge $c$ scaling from critical chain half-system entropy curves.

pub type EntanglementSpectrum = struct {
    cut_bond_index: Int,
    schmidt_rank: Int,
    schmidt_values: List[Float],
    von_neumann_entropy: Float,
    renyi_2_entropy: Float,
    schmidt_gap: Float
};

pub type RenyiEntropyConfig = struct {
    alpha_order: Float,
    min_probability_cutoff: Float
};

pub fn renyi_entropy_config_default() -> RenyiEntropyConfig {
    return RenyiEntropyConfig {
        alpha_order: 2.0,
        min_probability_cutoff: 0.0000000001
    };
}

pub fn entanglement_von_neumann_from_schmidt(schmidt_vals: List[Float]) -> Float {
    let n: Int = list_len(schmidt_vals);
    let mut s_vn: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let lam: Float = list_get(schmidt_vals, i);
        if lam > 0.0000000001 {
            let p: Float = lam * lam;
            // ln(p) approximation via series/rational or log approximation
            let log_p: Float = if p > 0.0001 { (p - 1.0) / (0.5 * (p + 1.0)) } else { -9.21034 };
            s_vn = s_vn - p * log_p;
        }
        i = i + 1;
    }
    return s_vn;
}

pub fn entanglement_renyi_2(schmidt_vals: List[Float]) -> Float {
    let n: Int = list_len(schmidt_vals);
    let mut sum_p2: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let lam: Float = list_get(schmidt_vals, i);
        let p: Float = lam * lam;
        sum_p2 = sum_p2 + p * p;
        i = i + 1;
    }
    if sum_p2 <= 0.0000000001 {
        return 0.0;
    }
    // S_2 = - ln(sum p_i^2)
    let log_sum: Float = if sum_p2 > 0.0001 { (sum_p2 - 1.0) / (0.5 * (sum_p2 + 1.0)) } else { -9.21034 };
    return 0.0 - log_sum;
}

pub fn entanglement_spectrum_new(cut_idx: Int, schmidt_vals: List[Float]) -> EntanglementSpectrum {
    let n: Int = list_len(schmidt_vals);
    let s_vn: Float = entanglement_von_neumann_from_schmidt(schmidt_vals);
    let s_2: Float = entanglement_renyi_2(schmidt_vals);

    let mut gap: Float = 0.0;
    if n >= 2 {
        let lam0: Float = list_get(schmidt_vals, 0);
        let lam1: Float = list_get(schmidt_vals, 1);
        let diff: Float = (lam0 * lam0) - (lam1 * lam1);
        gap = if diff < 0.0 { 0.0 - diff } else { diff };
    }

    return EntanglementSpectrum {
        cut_bond_index: cut_idx,
        schmidt_rank: n,
        schmidt_values: schmidt_vals,
        von_neumann_entropy: s_vn,
        renyi_2_entropy: s_2,
        schmidt_gap: gap
    };
}
