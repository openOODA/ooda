// # U(1) Symmetric Block-Sparse Tensors & Charge Conservation
//
// Logline: Implements Abelian U(1) particle number and spin magnetization $S^z$ charge-conserving block-sparse tensor structures.
//
// Setup: Block-diagonal tensor decomposition enforcing Selection Rule $\sum q_{\text{in}} = \sum q_{\text{out}}$ reducing computational complexity.
//
// Beats:
//   1. Define U1ChargeSector and U1TensorBlock data structures.
//   2. Implement block selection rule validation and sparse contraction matching.
//   3. Compute total symmetry sector charge and quantum number distributions.

pub type U1ChargeSector = struct {
    charge_q: Int,
    dimension: Int,
};

pub type U1TensorBlock = struct {
    q_in: Int,
    q_out: Int,
    dim_in: Int,
    dim_out: Int,
    is_allowed: Int,
};

pub fn u1_charge_sector_new(q: Int, dim: Int) -> U1ChargeSector {
    return U1ChargeSector {
        charge_q: q,
        dimension: dim,
    };
}

pub fn u1_tensor_block_new(qin: Int, qout: Int, din: Int, dout: Int) -> U1TensorBlock {
    let allowed: Int = if qin == qout { 1 } else { 0 };
    return U1TensorBlock {
        q_in: qin,
        q_out: qout,
        dim_in: din,
        dim_out: dout,
        is_allowed: allowed,
    };
}

pub fn u1_validate_conservation(blocks: List[U1TensorBlock]) -> Int {
    let n: Int = list_len(blocks);
    let mut i: Int = 0;
    while i < n {
        let blk: U1TensorBlock = list_get(blocks, i);
        if blk.is_allowed == 0 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}
