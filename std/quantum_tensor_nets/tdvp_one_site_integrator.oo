// # Time-Dependent Variational Principle (TDVP) 1-Site Integrator
//
// Logline: Implements geometric Lie-Trotter and Strang splitting 1-site TDVP integration on fixed-bond-dimension MPS tangent bundles.
//
// Setup: Unitary quantum time evolution projected onto the tangent space of the MPS manifold preserving total energy and norm strictly.
//
// Beats:
//   1. Define TdvpOneSiteConfig, TangentProjector, and TdvpIntegrationStep data structures.
//   2. Implement left-to-right site forward evolution and center backward evolution $K \to S \to L$.
//   3. Validate exact norm conservation and energy drift metrics during real-time dynamics.

pub type TdvpOneSiteConfig = struct {
    num_sites: Int,
    dt: Float,
    total_time: Float,
    krylov_dim: Int,
    is_imaginary: Int
};

pub type TdvpIntegrationStep = struct {
    time: Float,
    norm_loss: Float,
    energy_drift: Float,
    krylov_converged: Int
};

pub fn tdvp_one_site_config_default(num_sites: Int, dt: Float, total_time: Float) -> TdvpOneSiteConfig {
    return TdvpOneSiteConfig {
        num_sites: num_sites,
        dt: dt,
        total_time: total_time,
        krylov_dim: 10,
        is_imaginary: 0
    };
}

pub fn tdvp_integration_step_new(t: Float, norm_loss: Float, e_drift: Float) -> TdvpIntegrationStep {
    let abs_norm: Float = if norm_loss < 0.0 { 0.0 - norm_loss } else { norm_loss };
    let conv: Int = if abs_norm < 0.00001 { 1 } else { 0 };
    return TdvpIntegrationStep {
        time: t,
        norm_loss: abs_norm,
        energy_drift: e_drift,
        krylov_converged: conv
    };
}
