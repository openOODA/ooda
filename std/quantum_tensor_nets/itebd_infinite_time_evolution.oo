// # Infinite TEBD (iTEBD) in Vidal's Gamma-Lambda Canonical Form
//
// Logline: Implements infinite-system TEBD on two-site unit cells using Vidal's $\Gamma^{[A]}, \Lambda^{[A]}, \Gamma^{[B]}, \Lambda^{[B]}$ canonical ansatz.
//
// Setup: Translationally invariant quantum time evolution updating singular value matrices $\Lambda$ and normalized site tensors $\Gamma$.
//
// Beats:
//   1. Define ITebdUnitCell, ITebdConfig, and ITebdStateSnapshot data structures.
//   2. Implement two-site gate absorption and SVD truncation in Gamma-Lambda gauge.
//   3. Compute infinite-chain ground state energy per bond and half-chain entanglement entropy.

pub type ITebdConfig = struct {
    phys_dim: Int,
    dt: Float,
    max_steps: Int,
    max_bond_dimension: Int,
    truncation_threshold: Float,
    is_imaginary_time: Int,
};

pub type ITebdUnitCell = struct {
    phys_dim: Int,
    bond_dim_a: Int,
    bond_dim_b: Int,
    lambda_a: List[Float],
    lambda_b: List[Float],
};

pub type ITebdStateSnapshot = struct {
    step: Int,
    energy_per_site: Float,
    entropy_a: Float,
    entropy_b: Float,
    truncation_error: Float,
};

pub fn itebd_config_default(phys_d: Int, dt: Float) -> ITebdConfig {
    return ITebdConfig {
        phys_dim: phys_d,
        dt: dt,
        max_steps: 1000,
        max_bond_dimension: 80,
        truncation_threshold: 0.0000000001,
        is_imaginary_time: 1,
    };
}

pub fn itebd_unit_cell_new(phys_d: Int) -> ITebdUnitCell {
    let mut la: List[Float] = list_new();
    let mut lb: List[Float] = list_new();
    list_push(la, 1.0);
    list_push(lb, 1.0);
    return ITebdUnitCell {
        phys_dim: phys_d,
        bond_dim_a: 1,
        bond_dim_b: 1,
        lambda_a: la,
        lambda_b: lb,
    };
}

pub fn itebd_von_neumann_entropy(singular_values: List[Float]) -> Float {
    let n: Int = list_len(singular_values);
    let mut s: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let val: Float = list_get(singular_values, i);
        if val > 0.0000000001 {
            let p: Float = val * val;
            let log_p: Float = if p > 0.000001 { 0.0 - (1.0 - p) } else { -10.0 }; // Fast log approximation
            s = s - p * log_p;
        }
        i = i + 1;
    }
    return s;
}
