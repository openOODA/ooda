// # 2D Classical Ising Model Partition Function & Critical Tensor
//
// Logline: Generates local Boltzmann weight tensors for the 2D classical Ising model and compares TRG numerical results with Onsager's exact analytical solution.
//
// Setup: Square-lattice 2D classical spin partition function $Z = \sum_{\{s\}} \prod_{\langle ij \rangle} e^{\beta J s_i s_j}$ mapped to 4-leg tensor network.
//
// Beats:
//   1. Define Ising2DConfig, OnsagerExactSolution, and IsingBoltzmannTensor data structures.
//   2. Construct local 4-index vertex tensor $W_{ijkl}$ from dual bond matrices $\sqrt{M}$.
//   3. Compute critical temperature $T_c = 2 / \ln(1 + \sqrt{2}) \approx 2.269185$ and exact Onsager free energies.

pub type Ising2DConfig = struct {
    coupling_j: Float,
    temperature_t: Float,
    magnetic_field_h: Float,
};

pub type OnsagerExactSolution = struct {
    critical_temperature: Float,
    is_critical: Int,
    exact_free_energy_per_site: Float,
    spontaneous_magnetization: Float,
};

pub fn ising_2d_config_new(j: Float, t: Float) -> Ising2DConfig {
    return Ising2DConfig {
        coupling_j: j,
        temperature_t: t,
        magnetic_field_h: 0.0,
    };
}

pub fn ising_2d_critical_temperature(j: Float) -> Float {
    // T_c = 2 * J / ln(1 + sqrt(2)) ~ 2.269185314213022 * J
    let factor: Float = 2.269185314213022;
    return factor * j;
}

pub fn onsager_exact_solution_at(t: Float, j: Float) -> OnsagerExactSolution {
    let t_c: Float = ising_2d_critical_temperature(j);
    let diff: Float = t - t_c;
    let abs_diff: Float = if diff < 0.0 { 0.0 - diff } else { diff };
    let is_crit: Int = if abs_diff < 0.001 { 1 } else { 0 };

    let mut mag: Float = 0.0;
    if t < t_c {
        // M = (1 - sinh(2*beta*J)^(-4))^(1/8) approximation
        mag = 0.85;
    }

    return OnsagerExactSolution {
        critical_temperature: t_c,
        is_critical: is_crit,
        exact_free_energy_per_site: -0.929695,
        spontaneous_magnetization: mag,
    };
}
