// # Bose-Hubbard Model MPO & Truncated Bosonic Fock Space
//
// Logline: Generates finite-cutoff MPO representations for the 1D Bose-Hubbard model simulating superfluid to Mott insulator quantum phase transitions.
//
// Setup: Interacting bosonic Hamiltonian $H = -t \sum_i (b_i^\dagger b_{i+1} + \text{h.c.}) + \frac{U}{2} \sum_i n_i (n_i - 1) - \mu \sum_i n_i$.
//
// Beats:
//   1. Define BoseHubbardConfig and BosonicOccupationCutoff data structures ($n_{\text{max}}$).
//   2. Construct local bosonic annihilation/creation matrices $b, b^\dagger$ truncated at $N_{\text{max}}$.
//   3. Compute critical $U/t$ Mott insulator lobe boundaries and particle number variance.

pub type BoseHubbardConfig = struct {
    num_sites: Int,
    max_boson_occupation: Int,
    hopping_t: Float,
    on_site_u: Float,
    chemical_potential_mu: Float
};

pub fn bose_hubbard_config_default(num_sites: Int, n_max: Int, u_val: Float) -> BoseHubbardConfig {
    return BoseHubbardConfig {
        num_sites: num_sites,
        max_boson_occupation: n_max,
        hopping_t: 1.0,
        on_site_u: u_val,
        chemical_potential_mu: u_val / 2.0
    };
}

pub fn bose_hubbard_local_phys_dim(cfg: &BoseHubbardConfig) -> Int {
    // Physical dimension d = n_max + 1 (states |0>, |1>, ..., |n_max>)
    return cfg.max_boson_occupation + 1;
}

pub fn bose_hubbard_mott_gap_estimate(u: Float, t: Float, filling: Int) -> Float {
    // Delta_Mott ~ U - 4*t*sqrt(filling*(filling+1))
    let n_f: Float = (filling as Float);
    let prod: Float = n_f * (n_f + 1.0);
    let sqrt_prod: Float = if prod > 0.0 { sqrt(prod) } else { 0.0 };
    let gap: Float = u - 4.0 * t * sqrt_prod;
    let safe_gap: Float = if gap < 0.0 { 0.0 } else { gap };
    return safe_gap;
}
