// # SU(2) Non-Abelian Symmetric Tensors & Wigner-Eckart Decomposition
//
// Logline: Implements non-Abelian SU(2) spin-rotation symmetric tensors factorizing into geometric Clebsch-Gordan coefficients and reduced structural tensors.
//
// Setup: Wigner-Eckart theorem reduction $T = \bigoplus_J C_J \otimes T_{\text{reduced}}$ dramatically compressing tensor network bond dimensions.
//
// Beats:
//   1. Define Su2Irrep, ClebschGordanCoeff, and ReducedTensorElement data structures.
//   2. Implement angular momentum triangle inequalities $|j_1 - j_2| \le j_3 \le j_1 + j_2$.
//   3. Compute reduced matrix elements and 6j-symbol network recoupling invariants.

pub type Su2Irrep = struct {
    two_j: Int, // 2*J integer representation (0, 1, 2, ...)
    dimension: Int, // 2*J + 1
};

pub type TriangleCheck = struct {
    two_j1: Int,
    two_j2: Int,
    two_j3: Int,
    is_allowed: Int,
};

pub fn su2_irrep_new(two_j: Int) -> Su2Irrep {
    return Su2Irrep {
        two_j: two_j,
        dimension: two_j + 1,
    };
}

pub fn su2_check_triangle_rule(two_j1: Int, two_j2: Int, two_j3: Int) -> TriangleCheck {
    let diff: Int = two_j1 - two_j2;
    let abs_diff: Int = if diff < 0 { 0 - diff } else { diff };
    let sum: Int = two_j1 + two_j2;

    let mut allowed: Int = 1;
    if two_j3 < abs_diff || two_j3 > sum {
        allowed = 0;
    }
    // Parity of (2*j1 + 2*j2 + 2*j3) must be even
    let total_2j: Int = two_j1 + two_j2 + two_j3;
    let rem: Int = total_2j - (total_2j / 2) * 2;
    if rem != 0 {
        allowed = 0;
    }

    return TriangleCheck {
        two_j1: two_j1,
        two_j2: two_j2,
        two_j3: two_j3,
        is_allowed: allowed,
    };
}
