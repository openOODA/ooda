// # Time-Evolving Block Decimation (TEBD) Algorithm
//
// Logline: Implements real and imaginary time evolution of 1D Matrix Product States using Suzuki-Trotter gate decompositions and local SVD bond updates.
//
// Setup: Simulation of quantum dynamics $e^{-i H t}$ and ground state cooling $e^{-\beta H}$ via odd-even bond local unitary/non-unitary gates.
//
// Beats:
//   1. Define TebdConfig, TrotterOrder, and TebdStepSummary data structures.
//   2. Implement 1st, 2nd, and 4th order Suzuki-Trotter time-stepping schedules.
//   3. Compute bond truncation, normalization factors, and energy/entanglement diagnostics per step.

pub type TebdConfig = struct {
    num_sites: Int,
    dt: Float,
    total_time: Float,
    trotter_order: Int, // 1: FirstOrder, 2: SecondOrder, 4: FourthOrder
    is_imaginary_time: Int, // 1: Imaginary (ground state cooling), 0: Real time
    max_bond_dimension: Int,
    cutoff_tolerance: Float,
};

pub type TebdStepSummary = struct {
    step_number: Int,
    simulation_time: Float,
    energy_expectation: Float,
    max_bond_used: Int,
    accumulated_discarded_weight: Float,
};

pub fn tebd_config_default(num_sites: Int, dt: Float, total_time: Float) -> TebdConfig {
    return TebdConfig {
        num_sites: num_sites,
        dt: dt,
        total_time: total_time,
        trotter_order: 2,
        is_imaginary_time: 0,
        max_bond_dimension: 64,
        cutoff_tolerance: 0.00000001,
    };
}

pub fn tebd_total_steps(cfg: &TebdConfig) -> Float {
    let dt: Float = cfg.dt;
    let t_tot: Float = cfg.total_time;
    if dt <= 0.0 {
        return 0.0;
    }
    return t_tot / dt;
}

pub fn tebd_step_summary_new(step: Int, t: Float, e: Float, chi: Int, disc: Float) -> TebdStepSummary {
    return TebdStepSummary {
        step_number: step,
        simulation_time: t,
        energy_expectation: e,
        max_bond_used: chi,
        accumulated_discarded_weight: disc,
    };
}

pub fn trotter_layer_coefficients_order2(dt: Float) -> List[Float] {
    let mut layers: List[Float] = list_new();
    let half_dt: Float = dt / 2.0;
    // Layer 1: Odd bonds (dt/2)
    list_push(layers, half_dt);
    // Layer 2: Even bonds (dt)
    list_push(layers, dt);
    // Layer 3: Odd bonds (dt/2)
    list_push(layers, half_dt);
    return layers;
}
