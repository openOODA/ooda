// # Minimally Entangled Typical Thermal States (METTS)
//
// Logline: Implements finite-temperature quantum Monte Carlo sampling using pure classical product state imaginary time evolution $|i\rangle \to e^{-\beta H / 2} |i\rangle$.
//
// Setup: Stochastic sampling of thermal ensembles without ancilla doubling, maintaining low bond dimensions across all sample trajectories.
//
// Beats:
//   1. Define MettsConfig, MettsSampleSnapshot, and ClassicalProductState data structures.
//   2. Implement imaginary time cooling of classical product state seeds.
//   3. Perform projective measurement in alternating local spin bases (Z and X) for Markov chain transitions.

pub type MettsConfig = struct {
    num_sites: Int,
    beta: Float,
    num_samples: Int,
    burn_in_samples: Int,
    max_bond_dimension: Int
};

pub type MettsSampleSnapshot = struct {
    sample_index: Int,
    energy_sample: Float,
    entanglement_entropy_sample: Float,
    basis_choice: Int // 0: Z-basis, 1: X-basis
};

pub fn metts_config_default(sites: Int, beta: Float) -> MettsConfig {
    return MettsConfig {
        num_sites: sites,
        beta: beta,
        num_samples: 500,
        burn_in_samples: 50,
        max_bond_dimension: 48
    };
}

pub fn metts_sample_snapshot_new(idx: Int, e: Float, s: Float, basis: Int) -> MettsSampleSnapshot {
    return MettsSampleSnapshot {
        sample_index: idx,
        energy_sample: e,
        entanglement_entropy_sample: s,
        basis_choice: basis
    };
}

pub fn metts_thermal_average_energy(samples: List[MettsSampleSnapshot]) -> Float {
    let n: Int = list_len(samples);
    if n == 0 {
        return 0.0;
    }
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let snap: MettsSampleSnapshot = list_get(samples, i);
        let e_val: Float = snap.energy_sample;
        sum = sum + e_val;
        i = i + 1;
    }
    let n_f: Float = (n * 1.0);
    return sum / n_f;
}
