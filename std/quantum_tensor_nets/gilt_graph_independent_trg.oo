// # Graph Independent Local Truncation (GILT) for Tensor Networks
//
// Logline: Implements GILT algorithm inserting local bond filters to remove CDL short-range loop entanglement from arbitrary tensor graphs.
//
// Setup: Modification of transfer matrix bonds via iterative environment spectrum filtering preserving exact physical partition functions.
//
// Beats:
//   1. Define GiltConfig, GiltFilterMatrix, and GiltLoopDiagnostic data structures.
//   2. Formulate singular value thresholding for non-local bond filtering matrices $t$.
//   3. Accelerate convergence of 2D TRG and higher-dimensional tensor network contractions.

pub type GiltConfig = struct {
    filter_epsilon: Float,
    max_filter_sweeps: Int,
    loop_size: Int, // Typically 4 for square lattice plaquettes
};

pub type GiltFilterMatrix = struct {
    bond_dim: Int,
    trace_reduction: Float,
    is_identity: Int,
};

pub type GiltLoopDiagnostic = struct {
    plaquette_id: Int,
    singular_values_filtered: Int,
    bond_dim_after_gilt: Int,
};

pub fn gilt_config_default() -> GiltConfig {
    return GiltConfig {
        filter_epsilon: 0.00000001,
        max_filter_sweeps: 10,
        loop_size: 4,
    };
}

pub fn gilt_filter_matrix_new(dim: Int, tr_red: Float) -> GiltFilterMatrix {
    let is_id: Int = if tr_red < 0.000001 { 1 } else { 0 };
    return GiltFilterMatrix {
        bond_dim: dim,
        trace_reduction: tr_red,
        is_identity: is_id,
    };
}

pub fn gilt_loop_diagnostic_new(plaq: Int, n_filt: Int, chi_new: Int) -> GiltLoopDiagnostic {
    return GiltLoopDiagnostic {
        plaquette_id: plaq,
        singular_values_filtered: n_filt,
        bond_dim_after_gilt: chi_new,
    };
}
