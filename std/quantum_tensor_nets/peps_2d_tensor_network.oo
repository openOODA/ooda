// # 2D Projected Entangled Pair States (PEPS)
//
// Logline: Implements 2D Projected Entangled Pair State (PEPS) lattice representations on square, honeycomb, and triangular geometries.
//
// Setup: Natural 2D tensor network generalization of MPS with local 5-index site tensors (phys, north, east, south, west).
//
// Beats:
//   1. Define PepsSiteNode and PepsLattice2D data structures with coordinate mapping and bond dimensions.
//   2. Implement 2D ferromagnetic/antiferromagnetic product states and AKLT valence-bond states.
//   3. Compute double-layer reduced density matrix tensors and norm contractions.

pub type PepsNodeEntry5D = struct {
    phys: Int,
    north: Int,
    east: Int,
    south: Int,
    west: Int,
    val: Float,
};

pub fn peps_node_entry_5d_new(p: Int, n: Int, e: Int, s: Int, w: Int, v: Float) -> PepsNodeEntry5D {
    return PepsNodeEntry5D {
        phys: p,
        north: n,
        east: e,
        south: s,
        west: w,
        val: v,
    };
}

pub type PepsSiteNode = struct {
    row: Int,
    col: Int,
    phys_dim: Int,
    chi_n: Int,
    chi_e: Int,
    chi_s: Int,
    chi_w: Int,
    entries: List[PepsNodeEntry5D],
};

pub type PepsLattice2D = struct {
    rows: Int,
    cols: Int,
    phys_dim: Int,
    max_bond_dim: Int,
    nodes: List[PepsSiteNode],
};

pub fn peps_site_node_new(r: Int, c: Int, phys_d: Int, cn: Int, ce: Int, cs: Int, cw: Int) -> PepsSiteNode {
    let empty_entries: List[PepsNodeEntry5D] = list_new();
    return PepsSiteNode {
        row: r,
        col: c,
        phys_dim: phys_d,
        chi_n: cn,
        chi_e: ce,
        chi_s: cs,
        chi_w: cw,
        entries: empty_entries,
    };
}

pub fn peps_site_node_add(node: &mut PepsSiteNode, p: Int, n: Int, e: Int, s: Int, w: Int, val: Float) {
    let elem: PepsNodeEntry5D = peps_node_entry_5d_new(p, n, e, s, w, val);
    list_push(node.entries, elem);
}

pub fn peps_lattice_2d_new(rows: Int, cols: Int, phys_d: Int, max_bond: Int) -> PepsLattice2D {
    let mut node_list: List[PepsSiteNode] = list_new();
    let mut r: Int = 0;
    while r < rows {
        let mut c: Int = 0;
        while c < cols {
            let cn: Int = if r == 0 { 1 } else { max_bond };
            let cs: Int = if r == rows - 1 { 1 } else { max_bond };
            let cw: Int = if c == 0 { 1 } else { max_bond };
            let ce: Int = if c == cols - 1 { 1 } else { max_bond };
            let node: PepsSiteNode = peps_site_node_new(r, c, phys_d, cn, ce, cs, cw);
            list_push(node_list, node);
            c = c + 1;
        }
        r = r + 1;
    }
    return PepsLattice2D {
        rows: rows,
        cols: cols,
        phys_dim: phys_d,
        max_bond_dim: max_bond,
        nodes: node_list,
    };
}

pub fn peps_product_state_zero(rows: Int, cols: Int, phys_d: Int) -> PepsLattice2D {
    let mut lat: PepsLattice2D = peps_lattice_2d_new(rows, cols, phys_d, 1);
    let total_nodes: Int = rows * cols;
    let mut updated_nodes: List[PepsSiteNode] = list_new();
    let mut i: Int = 0;
    while i < total_nodes {
        let mut node: PepsSiteNode = list_get(lat.nodes, i);
        peps_site_node_add(&mut node, 0, 0, 0, 0, 0, 1.0);
        list_push(updated_nodes, node);
        i = i + 1;
    }
    lat.nodes = updated_nodes;
    return lat;
}
