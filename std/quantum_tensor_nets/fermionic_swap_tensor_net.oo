// # Fermionic Tensor Networks & Parity Swap Gates
//
// Logline: Implements $\mathbb{Z}_2$-graded fermionic tensor networks with automatic parity sign tracking $(-1)^{P_A P_B}$ on crossing tensor bonds.
//
// Setup: Canonical fermionic tensor contraction eliminating nonlocal Jordan-Wigner strings via local fermionic swap gates (fSWAP).
//
// Beats:
//   1. Define FermionicBondParity, FSwapGate, and FermionicTensorNode data structures.
//   2. Compute crossing parity signs $(-1)^{p_1 p_2}$ for intersecting contraction lines in 2D graphs.
//   3. Implement local fermionic mode permutation without explicit global phase tracking.

pub type FermionicBondParity = struct {
    bond_index: Int,
    parity: Int, // 0: Even (Bose-like), 1: Odd (Fermi-like)
};

pub type FSwapGate = struct {
    parity_1: Int,
    parity_2: Int,
    phase_factor: Float, // +1.0 or -1.0
};

pub fn fermionic_bond_parity_new(idx: Int, p: Int) -> FermionicBondParity {
    let p_mod: Int = if p == 1 { 1 } else { 0 };
    return FermionicBondParity {
        bond_index: idx,
        parity: p_mod,
    };
}

pub fn fswap_gate_compute(p1: Int, p2: Int) -> FSwapGate {
    // Phase factor is -1.0 if and only if both bonds are odd parity (p1 == 1 && p2 == 1)
    let sign: Float = if p1 == 1 && p2 == 1 { -1.0 } else { 1.0 };
    return FSwapGate {
        parity_1: p1,
        parity_2: p2,
        phase_factor: sign,
    };
}

pub fn fermionic_crossing_sign(bonds_1: List[FermionicBondParity], bonds_2: List[FermionicBondParity]) -> Float {
    let n1: Int = list_len(bonds_1);
    let n2: Int = list_len(bonds_2);
    let mut total_sign: Float = 1.0;

    let mut i: Int = 0;
    while i < n1 {
        let b1: FermionicBondParity = list_get(bonds_1, i);
        let mut j: Int = 0;
        while j < n2 {
            let b2: FermionicBondParity = list_get(bonds_2, j);
            let gate: FSwapGate = fswap_gate_compute(b1.parity, b2.parity);
            let factor: Float = gate.phase_factor;
            total_sign = total_sign * factor;
            j = j + 1;
        }
        i = i + 1;
    }
    return total_sign;
}
