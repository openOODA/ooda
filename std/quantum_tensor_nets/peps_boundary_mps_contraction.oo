// # Boundary MPS Contraction Method for 2D PEPS
//
// Logline: Contracts 2D PEPS tensor networks row-by-row or column-by-column using 1D boundary Matrix Product States and MPO transfer matrices.
//
// Setup: Approximate contraction of 2D lattice networks mapping rows of double-layer PEPS tensors to 1D MPOs acting on boundary MPS.
//
// Beats:
//   1. Define BoundaryMpsConfig, BoundaryCompressionReport, and PepsContractionResult data structures.
//   2. Implement row-wise MPO-MPS application and boundary SVD/variational compression sweeps.
//   3. Compute 2D expectation values, local magnetization, and boundary entanglement entropies.

pub type BoundaryMpsConfig = struct {
    boundary_chi_max: Int,
    compression_sweeps: Int,
    singular_value_cutoff: Float,
    direction: Int // 0: Top-to-Bottom, 1: Left-to-Right
};

pub type BoundaryCompressionReport = struct {
    row_index: Int,
    bond_dimension_used: Int,
    truncation_error: Float,
    accumulated_norm_log: Float
};

pub type PepsContractionResult = struct {
    total_scalar_norm: Float,
    max_boundary_bond: Int,
    is_accurate: Int
};

pub fn boundary_mps_config_default(chi_boundary: Int) -> BoundaryMpsConfig {
    return BoundaryMpsConfig {
        boundary_chi_max: chi_boundary,
        compression_sweeps: 8,
        singular_value_cutoff: 0.00000001,
        direction: 0
    };
}

pub fn boundary_compression_report_new(row: Int, chi: Int, err: Float, log_norm: Float) -> BoundaryCompressionReport {
    return BoundaryCompressionReport {
        row_index: row,
        bond_dimension_used: chi,
        truncation_error: err,
        accumulated_norm_log: log_norm
    };
}

pub fn peps_contraction_result_new(norm: Float, max_chi: Int, max_err: Float) -> PepsContractionResult {
    let acc: Int = if max_err < 0.0001 { 1 } else { 0 };
    return PepsContractionResult {
        total_scalar_norm: norm,
        max_boundary_bond: max_chi,
        is_accurate: acc
    };
}
