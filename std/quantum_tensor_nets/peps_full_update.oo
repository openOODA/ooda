// # Full Update Optimization for 2D PEPS
//
// Logline: Implements Full Update (FU) optimization for 2D PEPS accounting for global lattice environments via CTMRG or boundary MPS during gate absorption.
//
// Setup: Exact variational gauge-invariant state minimization solving generalized eigenvalue / least-squares problems in full 2D environment.
//
// Beats:
//   1. Define FullUpdateConfig and FullUpdateConvergenceReport data structures.
//   2. Formulate 2-site gate insertion metric $d(\psi', U \psi)$ with full environment embedding.
//   3. Compare Full Update fidelity improvements over Simple Update ground state approximations.

pub type FullUpdateConfig = struct {
    tau_step: Float,
    ctmrg_chi: Int,
    cg_max_iterations: Int,
    cg_tolerance: Float
};

pub type FullUpdateConvergenceReport = struct {
    iteration: Int,
    conjugate_gradient_residual: Float,
    fidelity_gain: Float,
    is_converged: Int
};

pub fn full_update_config_default(tau: Float, ctm_chi: Int) -> FullUpdateConfig {
    return FullUpdateConfig {
        tau_step: tau,
        ctmrg_chi: ctm_chi,
        cg_max_iterations: 40,
        cg_tolerance: 0.000001
    };
}

pub fn full_update_convergence_report_new(iter: Int, res: Float, gain: Float) -> FullUpdateConvergenceReport {
    let abs_res: Float = if res < 0.0 { 0.0 - res } else { res };
    let conv: Int = if abs_res < 0.000001 { 1 } else { 0 };
    return FullUpdateConvergenceReport {
        iteration: iter,
        conjugate_gradient_residual: abs_res,
        fidelity_gain: gain,
        is_converged: conv
    };
}
