// # Variational MPS Compression & Overlap Maximization
//
// Logline: Compresses high-bond-dimension MPS or MPO-MPS state vectors into target low-bond MPS by maximizing state overlap $|\langle \phi | \psi \rangle|^2$.
//
// Setup: Sweeping alternating least squares (ALS) variational optimization for optimal lower-rank MPS tensor approximations.
//
// Beats:
//   1. Define MpsCompressionConfig and CompressionSweepReport data structures.
//   2. Implement single-site ALS overlap maximizing update equations.
//   3. Measure compression fidelity $F = |\langle \phi | \psi \rangle|^2$ and Frobenius distance.

pub type MpsCompressionConfig = struct {
    num_sites: Int,
    target_bond_dimension: Int,
    max_sweeps: Int,
    fidelity_tolerance: Float,
};

pub type CompressionSweepReport = struct {
    sweep_index: Int,
    current_overlap: Float,
    overlap_gain: Float,
    is_converged: Int,
};

pub fn mps_compression_config_new(sites: Int, chi_target: Int) -> MpsCompressionConfig {
    return MpsCompressionConfig {
        num_sites: sites,
        target_bond_dimension: chi_target,
        max_sweeps: 12,
        fidelity_tolerance: 0.000001,
    };
}

pub fn compression_sweep_report_new(sweep: Int, overlap: Float, prev_overlap: Float) -> CompressionSweepReport {
    let diff: Float = overlap - prev_overlap;
    let abs_diff: Float = if diff < 0.0 { 0.0 - diff } else { diff };
    let conv: Int = if abs_diff < 0.000001 { 1 } else { 0 };
    return CompressionSweepReport {
        sweep_index: sweep,
        current_overlap: overlap,
        overlap_gain: abs_diff,
        is_converged: conv,
    };
}

pub fn compression_frobenius_distance(overlap: Float) -> Float {
    // || |psi> - |phi> ||^2 = 2 * (1 - Re<phi|psi>) assuming normalized states
    let diff: Float = 1.0 - overlap;
    let safe_diff: Float = if diff < 0.0 { 0.0 } else { diff };
    return sqrt(2.0 * safe_diff);
}
