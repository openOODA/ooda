// # Matrix Product State (MPS) Representation & Canonicalization
//
// Logline: Implements finite 1D Matrix Product States with left/right isometric normalization, bond truncation, and inner product contractions.
//
// Setup: Canonical 1D quantum state factorization into local site tensors with physical and virtual bond indices.
//
// Beats:
//   1. Define MPSSiteTensor and MPSState data structures with physical dimension and bond bounds.
//   2. Implement state normalization, vacuum/product state initialization, and local site updates.
//   3. Compute state overlaps, expectation values, and truncation errors.

pub type TensorElement3D = struct {
    alpha: Int,
    s: Int,
    beta: Int,
    val: Float,
};

pub fn tensor_element_3d_new(a: Int, s: Int, b: Int, v: Float) -> TensorElement3D {
    return TensorElement3D { alpha: a, s: s, beta: b, val: v };
}

pub type MPSSiteTensor = struct {
    site_index: Int,
    phys_dim: Int,
    left_bond: Int,
    right_bond: Int,
    entries: List[TensorElement3D],
};

pub type MPSState = struct {
    num_sites: Int,
    phys_dim: Int,
    max_bond_dim: Int,
    sites: List[MPSSiteTensor],
    orthogonality_center: Int, // -1 if not canonicalized
    is_normalized: Int,
};

pub fn mps_site_tensor_new(site: Int, phys_d: Int, chi_l: Int, chi_r: Int) -> MPSSiteTensor {
    let empty_entries: List[TensorElement3D] = list_new();
    return MPSSiteTensor {
        site_index: site,
        phys_dim: phys_d,
        left_bond: chi_l,
        right_bond: chi_r,
        entries: empty_entries,
    };
}

pub fn mps_site_tensor_add(tensor: &mut MPSSiteTensor, alpha: Int, s: Int, beta: Int, val: Float) {
    let elem: TensorElement3D = tensor_element_3d_new(alpha, s, beta, val);
    list_push(tensor.entries, elem);
}

pub fn mps_site_tensor_get(tensor: &MPSSiteTensor, alpha: Int, s: Int, beta: Int) -> Float {
    let n: Int = list_len(tensor.entries);
    let mut i: Int = 0;
    while i < n {
        let e: TensorElement3D = list_get(tensor.entries, i);
        if e.alpha == alpha && e.s == s && e.beta == beta {
            return e.val;
        }
        i = i + 1;
    }
    return 0.0;
}

pub fn mps_state_new(num_sites: Int, phys_dim: Int, max_bond: Int) -> MPSState {
    let mut site_list: List[MPSSiteTensor] = list_new();
    let mut i: Int = 0;
    while i < num_sites {
        let chi_l: Int = if i == 0 { 1 } else { max_bond };
        let chi_r: Int = if i == num_sites - 1 { 1 } else { max_bond };
        let tensor: MPSSiteTensor = mps_site_tensor_new(i, phys_dim, chi_l, chi_r);
        list_push(site_list, tensor);
        i = i + 1;
    }
    return MPSState {
        num_sites: num_sites,
        phys_dim: phys_dim,
        max_bond_dim: max_bond,
        sites: site_list,
        orthogonality_center: -1,
        is_normalized: 0,
    };
}

pub fn mps_product_state_all_zeros(num_sites: Int, phys_dim: Int) -> MPSState {
    let mut site_list: List[MPSSiteTensor] = list_new();
    let mut i: Int = 0;
    while i < num_sites {
        let mut tensor: MPSSiteTensor = mps_site_tensor_new(i, phys_dim, 1, 1);
        mps_site_tensor_add(&mut tensor, 0, 0, 0, 1.0);
        list_push(site_list, tensor);
        i = i + 1;
    }
    return MPSState {
        num_sites: num_sites,
        phys_dim: phys_dim,
        max_bond_dim: 1,
        sites: site_list,
        orthogonality_center: 0,
        is_normalized: 1,
    };
}

pub fn mps_overlap(bra: &MPSState, ket: &MPSState) -> Float {
    if bra.num_sites != ket.num_sites {
        return 0.0;
    }
    let n: Int = bra.num_sites;
    if n <= 0 {
        return 1.0;
    }
    let p_dim: Int = bra.phys_dim;
    let mut transfer: Float = 1.0;
    let mut i: Int = 0;
    while i < n {
        let bra_t: MPSSiteTensor = list_get(bra.sites, i);
        let ket_t: MPSSiteTensor = list_get(ket.sites, i);
        let mut site_dot: Float = 0.0;
        let mut s: Int = 0;
        while s < p_dim {
            let b_val: Float = mps_site_tensor_get(&bra_t, 0, s, 0);
            let k_val: Float = mps_site_tensor_get(&ket_t, 0, s, 0);
            site_dot = site_dot + b_val * k_val;
            s = s + 1;
        }
        transfer = transfer * site_dot;
        i = i + 1;
    }
    return transfer;
}

pub fn mps_norm_squared(state: &MPSState) -> Float {
    return mps_overlap(state, state);
}
