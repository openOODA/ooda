// # Dense Multi-Index Tensor Representation & Contractions
//
// Logline: Implements multidimensional dense tensor structures with index reshaping, permutation mappings, and generalized index contractions.
//
// Setup: Core dense tensor foundation supporting multi-index contractions and network diagrams in many-body quantum algorithms.
//
// Beats:
//   1. Define DenseTensorND and TensorShape with multi-dimensional shape and strided indexing.
//   2. Implement tensor element access, flat-index conversion, and scalar/elementwise operations.
//   3. Compute general two-tensor contractions along specified pairs of contracted indices.

pub type DenseTensorND = struct {
    rank: Int,
    shape: List[Int],
    strides: List[Int],
    total_elements: Int,
    data: List[Float]
};

pub fn tensor_shape_strides(shape: List[Int]) -> List[Int] {
    let r: Int = list_len(shape);
    let mut strides: List[Int] = list_new();
    let mut current_stride: Int = 1;
    let mut i: Int = r - 1;
    while i >= 0 {
        list_push(strides, current_stride);
        let dim: Int = list_get(shape, i);
        current_stride = current_stride * dim;
        i = i - 1;
    }
    // Reverse strides to match shape ordering
    let mut rev_strides: List[Int] = list_new();
    let mut j: Int = r - 1;
    while j >= 0 {
        let s: Int = list_get(strides, j);
        list_push(rev_strides, s);
        j = j - 1;
    }
    return rev_strides;
}

pub fn dense_tensor_nd_new(shape: List[Int]) -> DenseTensorND {
    let r: Int = list_len(shape);
    let strides: List[Int] = tensor_shape_strides(shape);
    let mut total: Int = 1;
    let mut i: Int = 0;
    while i < r {
        let dim: Int = list_get(shape, i);
        total = total * dim;
        i = i + 1;
    }
    let mut initial_data: List[Float] = list_new();
    let mut k: Int = 0;
    while k < total {
        list_push(initial_data, 0.0);
        k = k + 1;
    }
    return DenseTensorND {
        rank: r,
        shape: shape,
        strides: strides,
        total_elements: total,
        data: initial_data
    };
}

pub fn dense_tensor_flat_index(tensor: &DenseTensorND, indices: List[Int]) -> Int {
    let r: Int = tensor.rank;
    let mut flat: Int = 0;
    let mut i: Int = 0;
    while i < r {
        let idx: Int = list_get(indices, i);
        let stride: Int = list_get(tensor.strides, i);
        flat = flat + idx * stride;
        i = i + 1;
    }
    return flat;
}

pub fn dense_tensor_get_flat(tensor: &DenseTensorND, flat_idx: Int) -> Float {
    let total: Int = tensor.total_elements;
    if flat_idx >= 0 && flat_idx < total {
        return list_get(tensor.data, flat_idx);
    }
    return 0.0;
}

pub fn dense_tensor_trace_matrix(tensor: &DenseTensorND) -> Float {
    if tensor.rank != 2 {
        return 0.0;
    }
    let d0: Int = list_get(tensor.shape, 0);
    let d1: Int = list_get(tensor.shape, 1);
    let n: Int = if d0 < d1 { d0 } else { d1 };
    let mut tr: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let mut idxs: List[Int] = list_new();
        list_push(idxs, i);
        list_push(idxs, i);
        let flat: Int = dense_tensor_flat_index(tensor, idxs);
        let val: Float = dense_tensor_get_flat(tensor, flat);
        tr = tr + val;
        i = i + 1;
    }
    return tr;
}
