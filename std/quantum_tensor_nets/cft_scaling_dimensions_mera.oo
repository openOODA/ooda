// # Conformal Field Theory (CFT) Scaling Dimensions from MERA
//
// Logline: Extracts conformal scaling dimensions $\Delta_\alpha = -\log_2(\lambda_\alpha)$, spin, and central charge from scale-invariant MERA superoperators.
//
// Setup: Spectral decomposition of scale-invariant ascending superoperator $\mathcal{S}$ yielding primary and descendant field scaling dimensions.
//
// Beats:
//   1. Define CftSpectrumReport, ScalingOperatorDimension, and VirasoroTower data structures.
//   2. Compute scaling dimensions $\Delta$ from ascending superoperator eigenvalues $\lambda$.
//   3. Classify primary fields (identity, spin, energy) for 2D critical Ising and Potts models.

pub type ScalingOperatorDimension = struct {
    operator_label: String,
    eigenvalue_magnitude: Float,
    scaling_dimension_delta: Float,
    conformal_spin: Float,
};

pub type CftSpectrumReport = struct {
    central_charge: Float,
    num_primaries_identified: Int,
    operators: List[ScalingOperatorDimension],
};

pub fn scaling_operator_from_eigenvalue(label: String, lambda_val: Float, spin: Float) -> ScalingOperatorDimension {
    // Delta = - log2(lambda) = - ln(lambda) / ln(2)
    let log_lam: Float = if lambda_val > 0.0001 { (lambda_val - 1.0) / (0.5 * (lambda_val + 1.0)) } else { -6.93147 };
    let ln2: Float = 0.6931471805599453;
    let delta: Float = (0.0 - log_lam) / ln2;
    let safe_delta: Float = if delta < 0.0 { 0.0 } else { delta };

    return ScalingOperatorDimension {
        operator_label: label,
        eigenvalue_magnitude: lambda_val,
        scaling_dimension_delta: safe_delta,
        conformal_spin: spin,
    };
}

pub fn ising_cft_theoretical_spectrum() -> CftSpectrumReport {
    let mut ops: List[ScalingOperatorDimension] = list_new();

    // Identity: Delta = 0.0
    let id_op: ScalingOperatorDimension = ScalingOperatorDimension {
        operator_label: "Identity (1)",
        eigenvalue_magnitude: 1.0,
        scaling_dimension_delta: 0.0,
        conformal_spin: 0.0,
    };
    list_push(ops, id_op);

    // Spin sigma: Delta = 1/8 = 0.125
    let sigma_op: ScalingOperatorDimension = ScalingOperatorDimension {
        operator_label: "Spin (sigma)",
        eigenvalue_magnitude: 0.917004,
        scaling_dimension_delta: 0.125,
        conformal_spin: 0.0,
    };
    list_push(ops, sigma_op);

    // Energy epsilon: Delta = 1.0
    let eps_op: ScalingOperatorDimension = ScalingOperatorDimension {
        operator_label: "Energy (epsilon)",
        eigenvalue_magnitude: 0.5,
        scaling_dimension_delta: 1.0,
        conformal_spin: 0.0,
    };
    list_push(ops, eps_op);

    return CftSpectrumReport {
        central_charge: 0.5, // Ising c = 1/2
        num_primaries_identified: 3,
        operators: ops,
    };
}
