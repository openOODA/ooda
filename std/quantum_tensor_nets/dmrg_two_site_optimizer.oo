// # Density Matrix Renormalization Group (DMRG) Two-Site Optimizer
//
// Logline: Implements two-site DMRG algorithm with dynamic bond dimension growth, truncated SVD updates, and entanglement tracking.
//
// Setup: Two-site tensor optimization contracting sites $i$ and $i+1$ into a supersite tensor followed by singular value decomposition.
//
// Beats:
//   1. Define DmrgTwoSiteConfig, TwoSiteBondUpdate, and TruncationMetric data structures.
//   2. Implement two-site Hamiltonian eigenproblem step with dynamic bond dimension selection.
//   3. Track discarded Schmidt weights and adaptive truncation thresholds per sweep.

pub type DmrgTwoSiteConfig = struct {
    num_sites: Int,
    max_sweeps: Int,
    max_bond_dimension: Int,
    min_bond_dimension: Int,
    truncation_threshold: Float,
    lanczos_tolerance: Float
};

pub type TwoSiteBondUpdate = struct {
    site_left: Int,
    site_right: Int,
    bond_dim_before: Int,
    bond_dim_after: Int,
    local_energy: Float,
    discarded_weight: Float
};

pub fn dmrg_two_site_config_default(num_sites: Int) -> DmrgTwoSiteConfig {
    return DmrgTwoSiteConfig {
        num_sites: num_sites,
        max_sweeps: 15,
        max_bond_dimension: 128,
        min_bond_dimension: 4,
        truncation_threshold: 0.0000000001,
        lanczos_tolerance: 0.000000001
    };
}

pub fn two_site_bond_update_new(sl: Int, sr: Int, chi_old: Int, chi_new: Int, e: Float, disc: Float) -> TwoSiteBondUpdate {
    return TwoSiteBondUpdate {
        site_left: sl,
        site_right: sr,
        bond_dim_before: chi_old,
        bond_dim_after: chi_new,
        local_energy: e,
        discarded_weight: disc
    };
}

pub fn dmrg_two_site_choose_bond(cfg: &DmrgTwoSiteConfig, singular_vals: List[Float]) -> Int {
    let n: Int = list_len(singular_vals);
    let max_chi: Int = cfg.max_bond_dimension;
    let min_chi: Int = cfg.min_bond_dimension;
    let tol: Float = cfg.truncation_threshold;

    let mut kept: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let s: Float = list_get(singular_vals, i);
        if s >= tol && kept < max_chi {
            kept = kept + 1;
        }
        i = i + 1;
    }

    if kept < min_chi {
        let max_possible: Int = if n < min_chi { n } else { min_chi };
        return max_possible;
    }
    return kept;
}
