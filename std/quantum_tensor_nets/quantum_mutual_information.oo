// # Quantum Mutual Information & Area Law Scaling
//
// Logline: Computes bipartite and multipartite quantum mutual information $I(A:B) = S_A + S_B - S_{AB}$ and fits 1D/2D area law entanglement scalings.
//
// Setup: Quantitative measure of total (classical and quantum) correlations between spatial subsystems in tensor network states.
//
// Beats:
//   1. Define MutualInformationResult and AreaLawFitResult data structures.
//   2. Compute mutual information $I(A:B)$ from subsystem Von Neumann entropy inputs.
//   3. Fit logarithmic conformal scaling $S(L) = \frac{c}{3} \ln(L) + s_0$ to extract central charge $c$.

pub type MutualInformationResult = struct {
    entropy_a: Float,
    entropy_b: Float,
    entropy_ab: Float,
    mutual_information: Float
};

pub type AreaLawFitResult = struct {
    boundary_coefficient: Float,
    logarithmic_coefficient: Float,
    topological_correction_gamma: Float,
    residual_variance: Float
};

pub fn mutual_information_compute(s_a: Float, s_b: Float, s_ab: Float) -> MutualInformationResult {
    let i_ab: Float = s_a + s_b - s_ab;
    let safe_i: Float = if i_ab < 0.0 { 0.0 } else { i_ab };
    return MutualInformationResult {
        entropy_a: s_a,
        entropy_b: s_b,
        entropy_ab: s_ab,
        mutual_information: safe_i
    };
}

pub fn central_charge_extract_1d(s_l1: Float, s_l2: Float, l1: Int, l2: Int) -> Float {
    // S(l) = (c/3) * ln(l) + const  => c = 3 * (S(l2) - S(l1)) / ln(l2 / l1)
    let ds: Float = s_l2 - s_l1;
    let l1_f: Float = (l1 as Float);
    let l2_f: Float = (l2 as Float);
    let ratio: Float = if l1_f > 0.0 { l2_f / l1_f } else { 1.0 };
    let log_ratio: Float = if ratio > 1.0001 { (ratio - 1.0) / (0.5 * (ratio + 1.0)) } else { 0.693147 };
    let c: Float = (3.0 * ds) / log_ratio;
    return c;
}
