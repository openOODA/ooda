// # Matrix Product Operator (MPO) Representation & Local Hamiltonians
//
// Logline: Implements finite 1D Matrix Product Operators representing local quantum Hamiltonians, transfer matrices, and quantum channels.
//
// Setup: Factorization of multi-site quantum operators into local 4-index site tensors (left_bond, physical_out, physical_in, right_bond).
//
// Beats:
//   1. Define MPOSiteTensor and MPOOperator data structures with physical and operator bond indices.
//   2. Implement identity, Pauli string, and nearest-neighbor Hamiltonian MPO construction.
//   3. Compute MPO-MPS application, energy expectation value contractions, and operator traces.

pub type MPOElement4D = struct {
    w_left: Int,
    s_out: Int,
    s_in: Int,
    w_right: Int,
    val: Float,
};

pub fn mpo_element_4d_new(wl: Int, so: Int, si: Int, wr: Int, v: Float) -> MPOElement4D {
    return MPOElement4D {
        w_left: wl,
        s_out: so,
        s_in: si,
        w_right: wr,
        val: v,
    };
}

pub type MPOSiteTensor = struct {
    site_index: Int,
    phys_dim: Int,
    left_mpo_bond: Int,
    right_mpo_bond: Int,
    entries: List[MPOElement4D],
};

pub type MPOOperator = struct {
    num_sites: Int,
    phys_dim: Int,
    max_mpo_bond: Int,
    sites: List[MPOSiteTensor],
};

pub fn mpo_site_tensor_new(site: Int, phys_d: Int, wl: Int, wr: Int) -> MPOSiteTensor {
    let empty_list: List[MPOElement4D] = list_new();
    return MPOSiteTensor {
        site_index: site,
        phys_dim: phys_d,
        left_mpo_bond: wl,
        right_mpo_bond: wr,
        entries: empty_list,
    };
}

pub fn mpo_site_tensor_add(tensor: &mut MPOSiteTensor, wl: Int, so: Int, si: Int, wr: Int, val: Float) {
    let elem: MPOElement4D = mpo_element_4d_new(wl, so, si, wr, val);
    list_push(tensor.entries, elem);
}

pub fn mpo_site_tensor_get(tensor: &MPOSiteTensor, wl: Int, so: Int, si: Int, wr: Int) -> Float {
    let n: Int = list_len(tensor.entries);
    let mut i: Int = 0;
    while i < n {
        let e: MPOElement4D = list_get(tensor.entries, i);
        if e.w_left == wl && e.s_out == so && e.s_in == si && e.w_right == wr {
            return e.val;
        }
        i = i + 1;
    }
    return 0.0;
}

pub fn mpo_identity_new(num_sites: Int, phys_dim: Int) -> MPOOperator {
    let mut site_list: List[MPOSiteTensor] = list_new();
    let mut i: Int = 0;
    while i < num_sites {
        let mut tensor: MPOSiteTensor = mpo_site_tensor_new(i, phys_dim, 1, 1);
        let mut s: Int = 0;
        while s < phys_dim {
            mpo_site_tensor_add(&mut tensor, 0, s, s, 0, 1.0);
            s = s + 1;
        }
        list_push(site_list, tensor);
        i = i + 1;
    }
    return MPOOperator {
        num_sites: num_sites,
        phys_dim: phys_dim,
        max_mpo_bond: 1,
        sites: site_list,
    };
}

pub fn mpo_trace(mpo: &MPOOperator) -> Float {
    let n: Int = mpo.num_sites;
    if n <= 0 {
        return 1.0;
    }
    let p_dim: Int = mpo.phys_dim;
    let mut tr: Float = 1.0;
    let mut i: Int = 0;
    while i < n {
        let site_t: MPOSiteTensor = list_get(mpo.sites, i);
        let mut local_tr: Float = 0.0;
        let mut s: Int = 0;
        while s < p_dim {
            let val: Float = mpo_site_tensor_get(&site_t, 0, s, s, 0);
            local_tr = local_tr + val;
            s = s + 1;
        }
        tr = tr * local_tr;
        i = i + 1;
    }
    return tr;
}
