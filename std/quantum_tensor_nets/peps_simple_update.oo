// # Simple Update Algorithm for 2D PEPS
//
// Logline: Implements the Simple Update (SU) algorithm for 2D PEPS using local mean-field bond environments $\lambda$ and local Trotterized gates.
//
// Setup: Computationally efficient $O(D^5)$ imaginary-time cooling of 2D PEPS without full lattice environment contractions.
//
// Beats:
//   1. Define SimpleUpdateConfig, PepsBondVector, and SimpleUpdateStepReport data structures.
//   2. Apply 2-site gate $e^{-\tau h_{ij}}$ to adjacent PEPS nodes with environment weight absorption.
//   3. Perform truncated SVD update and update local bond singular values $\lambda_x, \lambda_y$.

pub type SimpleUpdateConfig = struct {
    tau_step: Float,
    max_steps: Int,
    target_bond_dim: Int,
    convergence_tol: Float
};

pub type SimpleUpdateStepReport = struct {
    step: Int,
    max_bond_error: Float,
    is_converged: Int
};

pub fn simple_update_config_default(tau: Float, d_max: Int) -> SimpleUpdateConfig {
    return SimpleUpdateConfig {
        tau_step: tau,
        max_steps: 1000,
        target_bond_dim: d_max,
        convergence_tol: 0.0000001
    };
}

pub fn simple_update_step_report_new(step: Int, max_err: Float, tol: Float) -> SimpleUpdateStepReport {
    let abs_err: Float = if max_err < 0.0 { 0.0 - max_err } else { max_err };
    let conv: Int = if abs_err < tol { 1 } else { 0 };
    return SimpleUpdateStepReport {
        step: step,
        max_bond_error: abs_err,
        is_converged: conv
    };
}
