// # Higher-Order Tensor Renormalization Group (HOTRG)
//
// Logline: Implements HOTRG for 2D and 3D classical/quantum lattice systems using Higher-Order SVD (HOSVD) isometric projectors.
//
// Setup: Unbiased directional contraction contracting pairs of adjacent site tensors along specific axes $x, y, z$ with optimal isometries.
//
// Beats:
//   1. Define HotrgConfig, HotrgIsometryPair, and HotrgDimensionReport data structures.
//   2. Formulate HOSVD projection equations for anisotropic bond contractions.
//   3. Scale cleanly to 3D cubic lattice statistical models.

pub type HotrgConfig = struct {
    chi_max: Int,
    dimension: Int, // 2: 2D lattice, 3: 3D cubic lattice
    max_steps: Int,
    tolerance: Float,
};

pub type HotrgDimensionReport = struct {
    step: Int,
    active_axis: Int, // 0: X, 1: Y, 2: Z
    retained_bond_dim: Int,
    contraction_norm: Float,
};

pub fn hotrg_config_default(chi: Int, dim: Int) -> HotrgConfig {
    return HotrgConfig {
        chi_max: chi,
        dimension: dim,
        max_steps: 40,
        tolerance: 0.00000001,
    };
}

pub fn hotrg_dimension_report_new(step: Int, axis: Int, chi: Int, norm: Float) -> HotrgDimensionReport {
    return HotrgDimensionReport {
        step: step,
        active_axis: axis,
        retained_bond_dim: chi,
        contraction_norm: norm,
    };
}
