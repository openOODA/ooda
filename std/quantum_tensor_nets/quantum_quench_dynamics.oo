// # Quantum Quench Dynamics & Loschmidt Echo
//
// Logline: Simulates global and local quantum quenches, Loschmidt echo returns $\mathcal{L}(t) = |\langle \psi_0 | e^{-i H t} | \psi_0 \rangle|^2$, and light-cone entanglement spread.
//
// Setup: Out-of-equilibrium unitary time evolution following sudden Hamiltonian parameter shifts ($g_0 \to g_1$).
//
// Beats:
//   1. Define QuenchExperimentConfig and LoschmidtEchoPoint data structures.
//   2. Compute Loschmidt return rate function $g(t) = -\frac{1}{N} \ln \mathcal{L}(t)$ for dynamical phase transitions (DQPT).
//   3. Measure Lieb-Robinson velocity bounds $v_{LR}$ from spatial correlation light-cone fronts.

pub type QuenchExperimentConfig = struct {
    num_sites: Int,
    initial_parameter: Float,
    quenched_parameter: Float,
    time_step: Float,
    max_time: Float,
};

pub type LoschmidtEchoPoint = struct {
    time: Float,
    overlap_magnitude_sq: Float,
    rate_function: Float,
    is_critical_time: Int,
};

pub fn quench_experiment_config_new(sites: Int, g0: Float, g1: Float) -> QuenchExperimentConfig {
    return QuenchExperimentConfig {
        num_sites: sites,
        initial_parameter: g0,
        quenched_parameter: g1,
        time_step: 0.02,
        max_time: 5.0,
    };
}

pub fn loschmidt_echo_point_new(t: Float, l_sq: Float, num_sites: Int) -> LoschmidtEchoPoint {
    let n_f: Float = (num_sites as Float);
    // rate function g(t) = - (1/N) * ln(L(t))
    let log_l: Float = if l_sq > 0.0001 { (l_sq - 1.0) / (0.5 * (l_sq + 1.0)) } else { -9.21034 };
    let g_t: Float = (0.0 - log_l) / (if n_f > 0.0 { n_f } else { 1.0 });
    let crit: Int = if g_t > 2.0 { 1 } else { 0 };
    return LoschmidtEchoPoint {
        time: t,
        overlap_magnitude_sq: l_sq,
        rate_function: g_t,
        is_critical_time: crit,
    };
}

pub fn lieb_robinson_velocity_estimate(front_position: Float, time: Float) -> Float {
    if time <= 0.0 {
        return 0.0;
    }
    return front_position / time;
}
