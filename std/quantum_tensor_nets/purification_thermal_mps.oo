// # Purification & Ancilla Methods for Thermal MPS
//
// Logline: Simulates finite-temperature density matrices $\rho(\beta) = e^{-\beta H} / Z$ via MPS purification on physical and auxiliary ancilla Hilbert spaces.
//
// Setup: Vectorization of mixed states $|\rho^{1/2}\rangle \in \mathcal{H}_P \otimes \mathcal{H}_A$ starting from maximally entangled state at $\beta = 0$.
//
// Beats:
//   1. Define ThermalPurificationConfig and ThermalObservable data structures.
//   2. Initialize infinite-temperature maximally entangled physical-ancilla pair state.
//   3. Implement imaginary time evolution along $\beta/2$ ladder with thermodynamic expectation values.

pub type ThermalPurificationConfig = struct {
    num_sites: Int,
    phys_dim: Int,
    target_beta: Float, // Inverse temperature beta = 1 / (k_B T)
    d_beta: Float,
    max_bond_dimension: Int,
};

pub type ThermalObservable = struct {
    inverse_temp_beta: Float,
    temperature_k: Float,
    internal_energy: Float,
    free_energy: Float,
    thermal_entropy: Float,
};

pub fn thermal_purification_config_default(num_sites: Int, beta_target: Float) -> ThermalPurificationConfig {
    return ThermalPurificationConfig {
        num_sites: num_sites,
        phys_dim: 2,
        target_beta: beta_target,
        d_beta: 0.05,
        max_bond_dimension: 64,
    };
}

pub fn thermal_observable_new(beta: Float, u: Float, f: Float) -> ThermalObservable {
    let t_k: Float = if beta > 0.00001 { 1.0 / beta } else { 10000.0 };
    // S = beta * (U - F)
    let s_th: Float = beta * (u - f);
    return ThermalObservable {
        inverse_temp_beta: beta,
        temperature_k: t_k,
        internal_energy: u,
        free_energy: f,
        thermal_entropy: s_th,
    };
}
