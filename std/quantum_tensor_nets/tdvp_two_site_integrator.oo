// # Time-Dependent Variational Principle (TDVP) 2-Site Integrator
//
// Logline: Implements two-site TDVP integration with dynamical bond dimension adaptation and long-range entanglement growth.
//
// Setup: Two-site projector splitting integration advancing supersite tensors followed by SVD truncation with variable bond cutoff.
//
// Beats:
//   1. Define TdvpTwoSiteConfig and TdvpTwoSiteSweep data structures.
//   2. Implement two-site time evolution and backward single-site propagation steps.
//   3. Balance bond dimension growth with truncation error during non-equilibrium quenches.

pub type TdvpTwoSiteConfig = struct {
    num_sites: Int,
    dt: Float,
    total_time: Float,
    max_bond_dim: Int,
    truncation_tol: Float,
    krylov_subspace_size: Int
};

pub type TdvpTwoSiteSweep = struct {
    time_point: Float,
    peak_bond_dim: Int,
    discarded_weight_sum: Float,
    energy_expectation: Float
};

pub fn tdvp_two_site_config_default(sites: Int, dt: Float, total_t: Float) -> TdvpTwoSiteConfig {
    return TdvpTwoSiteConfig {
        num_sites: sites,
        dt: dt,
        total_time: total_t,
        max_bond_dim: 128,
        truncation_tol: 0.000000001,
        krylov_subspace_size: 12
    };
}

pub fn tdvp_two_site_sweep_new(t: Float, chi: Int, disc: Float, e: Float) -> TdvpTwoSiteSweep {
    return TdvpTwoSiteSweep {
        time_point: t,
        peak_bond_dim: chi,
        discarded_weight_sum: disc,
        energy_expectation: e
    };
}
