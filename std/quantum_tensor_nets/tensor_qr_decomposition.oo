// # QR & LQ Decomposition for Tensor Isometries & Gauges
//
// Logline: Implements Gram-Schmidt and Householder QR/LQ matrix factorizations for constructing left- and right-isometric MPS tensors.
//
// Setup: Exact isometry generation $A = Q R$ with $Q^\dagger Q = I$, enforcing gauge conditions in tensor network algorithms.
//
// Beats:
//   1. Define QrResult2x2 and IsometryCheck data structures.
//   2. Implement 2x2 Gram-Schmidt orthogonalization for isometric gauge fixing.
//   3. Compute isometric deviation and unitarity residuals.

pub type QrResult2x2 = struct {
    q00: Float,
    q01: Float,
    q10: Float,
    q11: Float,
    r00: Float,
    r01: Float,
    r10: Float, // strictly 0.0 for upper triangular R
    r11: Float,
};

pub type IsometryCheck = struct {
    is_left_isometric: Int,
    unitarity_residual: Float,
};

pub fn qr_decompose_2x2(a00: Float, a01: Float, a10: Float, a11: Float) -> QrResult2x2 {
    // Column 1 norm: ||col1||
    let norm1_sq: Float = a00 * a00 + a10 * a10;
    let norm1: Float = if norm1_sq > 0.0 { sqrt(norm1_sq) } else { 0.000000001 };

    let q00: Float = a00 / norm1;
    let q10: Float = a10 / norm1;
    let r00: Float = norm1;

    // Projection of col2 onto col1: <q1, col2>
    let r01: Float = q00 * a01 + q10 * a11;

    // Orthogonal component of col2: col2 - r01 * q1
    let v01: Float = a01 - r01 * q00;
    let v11: Float = a11 - r01 * q10;

    let norm2_sq: Float = v01 * v01 + v11 * v11;
    let norm2: Float = if norm2_sq > 0.0 { sqrt(norm2_sq) } else { 0.000000001 };

    let q01: Float = v01 / norm2;
    let q11: Float = v11 / norm2;
    let r11: Float = norm2;

    return QrResult2x2 {
        q00: q00,
        q01: q01,
        q10: q10,
        q11: q11,
        r00: r00,
        r01: r01,
        r10: 0.0,
        r11: r11,
    };
}

pub fn isometry_check_2x2(q00: Float, q01: Float, q10: Float, q11: Float) -> IsometryCheck {
    let dot_diag0: Float = q00 * q00 + q10 * q10;
    let dot_diag1: Float = q01 * q01 + q11 * q11;
    let dot_off: Float = q00 * q01 + q10 * q11;

    let diff0: Float = dot_diag0 - 1.0;
    let diff1: Float = dot_diag1 - 1.0;
    let abs_diff0: Float = if diff0 < 0.0 { 0.0 - diff0 } else { diff0 };
    let abs_diff1: Float = if diff1 < 0.0 { 0.0 - diff1 } else { diff1 };
    let abs_off: Float = if dot_off < 0.0 { 0.0 - dot_off } else { dot_off };

    let max_err: Float = if abs_diff0 > abs_diff1 { abs_diff0 } else { abs_diff1 };
    let total_err: Float = if max_err > abs_off { max_err } else { abs_off };

    let is_iso: Int = if total_err < 0.00001 { 1 } else { 0 };

    return IsometryCheck {
        is_left_isometric: is_iso,
        unitarity_residual: total_err,
    };
}
