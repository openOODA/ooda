// # Infinite DMRG (iDMRG) for Thermodynamic Limits
//
// Logline: Implements infinite-system DMRG algorithm growing two central sites iteratively until thermodynamic limit convergence.
//
// Setup: Translationally invariant quantum chain in thermodynamic limit $L \to \infty$ constructed via iterative unit cell insertion.
//
// Beats:
//   1. Define IDmrgConfig, IDmrgStepResult, and InfiniteUnitCell data structures.
//   2. Implement two-site center insertion and environment block growth.
//   3. Extract ground state energy per site and thermodynamic entanglement entropy.

pub type IDmrgConfig = struct {
    phys_dim: Int,
    max_bond_dimension: Int,
    max_steps: Int,
    energy_per_site_tol: Float,
    unit_cell_size: Int
};

pub type IDmrgStepResult = struct {
    step_number: Int,
    system_size: Int,
    energy_per_site: Float,
    bond_dimension: Int,
    center_entropy: Float,
    is_converged: Int
};

pub fn idmrg_config_default(phys_d: Int) -> IDmrgConfig {
    return IDmrgConfig {
        phys_dim: phys_d,
        max_bond_dimension: 100,
        max_steps: 200,
        energy_per_site_tol: 0.0000001,
        unit_cell_size: 2
    };
}

pub fn idmrg_step_result_new(step: Int, e_site: Float, prev_e_site: Float, chi: Int, s: Float) -> IDmrgStepResult {
    let diff: Float = e_site - prev_e_site;
    let abs_diff: Float = if diff < 0.0 { 0.0 - diff } else { diff };
    let conv: Int = if abs_diff < 0.0000001 { 1 } else { 0 };
    return IDmrgStepResult {
        step_number: step,
        system_size: 2 * (step + 1),
        energy_per_site: e_site,
        bond_dimension: chi,
        center_entropy: s,
        is_converged: conv
    };
}

pub fn idmrg_extrapolate_ground_energy(results: List[IDmrgStepResult]) -> Float {
    let n: Int = list_len(results);
    if n == 0 {
        return 0.0;
    }
    let last: IDmrgStepResult = list_get(results, n - 1);
    return last.energy_per_site;
}
