// # Wind Farm Aggregation & Grid Curtailment
//
// Logline: Aggregates multi-turbine wind farm production, enforces grid curtailment, and tests operations.
//
// Setup: Wind farm facility aggregator importing curve, pitch, and turbine submodules.
//
// Beats:
//   1. Construct WindFarm aggregate models with nameplate ratings.
//   2. Calculate wind farm capacity factor and fleet production.
//   3. Apply active power curtailment across all operating turbines.

import "./wind_curve.oo";
import "./wind_pitch.oo";
import "./wind_turbine.oo";
import "./wind_turbine_ops.oo";

type WindFarm = struct {
    farm_id: Int,
    total_capacity_kw: Float,
    turbine_count: Int,
    active_turbines: Int,
    total_power_kw: Float,
    avg_wind_speed_ms: Float,
    curtailment_limit_kw: Float,
    grid_frequency_hz: Float,
    is_curtailed: Bool
};

pub fn wind_farm_new(farm_id: Int, total_capacity_kw: Float, turbine_count: Int) -> WindFarm {
    return WindFarm {
        farm_id: farm_id,
        total_capacity_kw: total_capacity_kw,
        turbine_count: turbine_count,
        active_turbines: turbine_count,
        total_power_kw: 0.0,
        avg_wind_speed_ms: 0.0,
        curtailment_limit_kw: total_capacity_kw,
        grid_frequency_hz: 60.0,
        is_curtailed: false
    };
}

pub fn wind_farm_update(farm: WindFarm, active_count: Int, total_gen_kw: Float, avg_wind: Float) -> WindFarm {
    let mut pwr: Float = total_gen_kw;
    if farm.is_curtailed {
        if total_gen_kw > farm.curtailment_limit_kw {
            pwr = farm.curtailment_limit_kw;
        }
    }
    return WindFarm {
        farm_id: farm.farm_id,
        total_capacity_kw: farm.total_capacity_kw,
        turbine_count: farm.turbine_count,
        active_turbines: active_count,
        total_power_kw: pwr,
        avg_wind_speed_ms: avg_wind,
        curtailment_limit_kw: farm.curtailment_limit_kw,
        grid_frequency_hz: farm.grid_frequency_hz,
        is_curtailed: farm.is_curtailed
    };
}

pub fn wind_farm_apply_curtailment(farm: WindFarm, max_allowed_kw: Float) -> WindFarm {
    if max_allowed_kw < farm.total_capacity_kw {
        let mut pwr: Float = farm.total_power_kw;
        if pwr > max_allowed_kw {
            pwr = max_allowed_kw;
        }
        return WindFarm {
            farm_id: farm.farm_id,
            total_capacity_kw: farm.total_capacity_kw,
            turbine_count: farm.turbine_count,
            active_turbines: farm.active_turbines,
            total_power_kw: pwr,
            avg_wind_speed_ms: farm.avg_wind_speed_ms,
            curtailment_limit_kw: max_allowed_kw,
            grid_frequency_hz: farm.grid_frequency_hz,
            is_curtailed: true
        };
    }
    return WindFarm {
        farm_id: farm.farm_id,
        total_capacity_kw: farm.total_capacity_kw,
        turbine_count: farm.turbine_count,
        active_turbines: farm.active_turbines,
        total_power_kw: farm.total_power_kw,
        avg_wind_speed_ms: farm.avg_wind_speed_ms,
        curtailment_limit_kw: farm.total_capacity_kw,
        grid_frequency_hz: farm.grid_frequency_hz,
        is_curtailed: false
    };
}

pub fn wind_farm_capacity_factor(farm: WindFarm) -> Float {
    if farm.total_capacity_kw <= 0.0 {
        return 0.0;
    }
    return (farm.total_power_kw / farm.total_capacity_kw) * 100.0;
}
