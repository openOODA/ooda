// # Solar Irradiance & Thermal Environment
//
// Logline: Models solar irradiance, plane-of-array transposition, and PV cell operating temperature.
//
// Setup: Pure environmental physics algorithms importing solar_math.oo and solar_types.oo.
//
// Beats:
//   1. Calculate PV cell operating temperature from GHI and NOCT.
//   2. Construct SolarIrradiance states with computed GHI components.
//   3. Compute plane-of-array (POA) irradiance using geometric transposition.
//   4. Calculate solar zenith angles and clear sky baseline irradiance.


import "./solar_math.oo";
import "./solar_types.oo";

// -------------------------------------------------------------------
// Solar Irradiance & Thermal Environment State
// -------------------------------------------------------------------

/// Compute cell operating temperature based on GHI and Nominal Operating Cell Temperature (NOCT).
pub fn solar_cell_temperature(ambient_temp_c: Float, ghi: Float, noct_c: Float) -> Float {
    let mut irradiance = ghi;
    if irradiance < 0.0 {
        irradiance = 0.0;
    }
    let thermal_rise = (irradiance / 800.0) * (noct_c - 20.0);
    return ambient_temp_c + thermal_rise;
}

/// Construct a SolarIrradiance struct, automatically computing GHI and cell temperature.
pub fn solar_irradiance_new(
    dni: Float,
    dhi: Float,
    sun_elevation_deg: Float,
    sun_azimuth_deg: Float,
    ambient_temp_c: Float,
    wind_speed_ms: Float
) -> SolarIrradiance {
    let mut elev = sun_elevation_deg;
    if elev < 0.0 {
        elev = 0.0;
    }
    let sin_elev = sin(deg_to_rad(elev));
    let mut calculated_ghi = (dni * sin_elev) + dhi;
    if calculated_ghi < 0.0 {
        calculated_ghi = 0.0;
    }

    let cell_t = solar_cell_temperature(ambient_temp_c, calculated_ghi, 45.0);

    return SolarIrradiance {
        dni: dni,
        dhi: dhi,
        ghi: calculated_ghi,
        sun_elevation_deg: sun_elevation_deg,
        sun_azimuth_deg: sun_azimuth_deg,
        ambient_temp_c: ambient_temp_c,
        cell_temp_c: cell_t,
        wind_speed_ms: wind_speed_ms
    };
}

/// Default standard clear-sky solar irradiance condition (STC benchmark).
pub fn solar_irradiance_stc() -> SolarIrradiance {
    return SolarIrradiance {
        dni: 900.0,
        dhi: 100.0,
        ghi: 1000.0,
        sun_elevation_deg: 90.0,
        sun_azimuth_deg: 180.0,
        ambient_temp_c: 25.0,
        cell_temp_c: 25.0,
        wind_speed_ms: 1.0
    };
}

/// Calculate approximate Plane-Of-Array (POA) irradiance in W/m² considering surface tilt and azimuth.
pub fn solar_irradiance_plane_of_array(irrad: &SolarIrradiance, tilt_deg: Float, azimuth_deg: Float) -> Float {
    let elev = (irrad).sun_elevation_deg;
    if elev <= 0.0 {
        return 0.0;
    }

    let sun_az = (irrad).sun_azimuth_deg;
    let az_diff_rad = deg_to_rad(sun_az - azimuth_deg);
    let tilt_rad = deg_to_rad(tilt_deg);
    let elev_rad = deg_to_rad(elev);

    // Cosine of incidence angle theta: cos(theta) = sin(elev)*cos(tilt) + cos(elev)*sin(tilt)*cos(az_diff)
    let cos_incidence = (sin(elev_rad) * cos(tilt_rad)) + ((cos(elev_rad) * sin(tilt_rad)) * cos(az_diff_rad));

    let mut direct_poa = (irrad).dni * cos_incidence;
    if direct_poa < 0.0 {
        direct_poa = 0.0;
    }

    // Sky diffuse component approximation: DHI * (1 + cos(tilt)) / 2
    let diffuse_poa = ((irrad).dhi * (1.0 + cos(tilt_rad))) / 2.0;

    let total_poa = direct_poa + diffuse_poa;
    if total_poa < 0.0 {
        return 0.0;
    }
    return total_poa;
}
