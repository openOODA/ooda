// # Grid frequency types
//
// Logline: GridFrequency destubbed off Float telemetry.
// residual: destubbed to Int millihertz floor.

type GridFrequency = struct {
    nominal_mhz: Int,
    current_mhz: Int,
    status: Int
};

pub fn grid_freq_new(nominal_mhz: Int, current_mhz: Int, status: Int) -> GridFrequency {
    return GridFrequency {
        nominal_mhz: nominal_mhz,
        current_mhz: current_mhz,
        status: status
    };
}

pub fn grid_freq_current(g: GridFrequency) -> Int {
    return g.current_mhz;
}
