// # Solar Yield Estimation & Environmental Analytics
//
// Logline: Estimates daily/annual solar energy yield, capacity factor, revenue, and carbon offset.
//
// Setup: Pure analytical yield and financial formulas importing solar_types.oo.
//
// Beats:
//   1. Estimate daily solar energy yield from peak sun hours.
//   2. Estimate annual energy generation and lifetime degradation.
//   3. Compute solar farm capacity factors and performance ratios.
//   4. Calculate economic revenue and avoided carbon emissions.


import "./solar_types.oo";

// -------------------------------------------------------------------
// System Yield Estimation & Financial/Environmental Analytics
// -------------------------------------------------------------------

/// Estimate daily energy yield in kWh given peak sun hours and overall system derate.
pub fn solar_estimate_daily_yield_kwh(array: &PvArray, peak_sun_hours: Float, system_derate_factor: Float) -> Float {
    if peak_sun_hours <= 0.0 {
        return 0.0;
    }
    let p_dc = (array).peak_power_kw;
    let total_yield_kwh = p_dc * peak_sun_hours * system_derate_factor * (1.0 - ((array).degradation_pct / 100.0));
    if total_yield_kwh < 0.0 {
        return 0.0;
    }
    return total_yield_kwh;
}

/// Calculate Performance Ratio (PR %) according to IEC 61724 standard.
/// PR = (Actual AC Yield kWh) / (Peak DC Rating kW * Reference In-Plane Irradiance kWh/m² / 1 kW/m²) * 100
pub fn solar_calculate_performance_ratio(actual_ac_kwh: Float, peak_dc_kw: Float, reference_poa_kwh_m2: Float) -> Float {
    if peak_dc_kw <= 0.0 {
        return 0.0;
    }
    if reference_poa_kwh_m2 <= 0.0 {
        return 0.0;
    }
    let nominal_expected_kwh = peak_dc_kw * reference_poa_kwh_m2;
    let pr = (actual_ac_kwh / nominal_expected_kwh) * 100.0;
    return pr;
}

/// Calculate CO2 emissions offset in kilograms based on energy produced and grid carbon intensity.
pub fn solar_calculate_co2_savings(generated_kwh: Float, grid_co2_kg_per_kwh: Float) -> Float {
    if generated_kwh <= 0.0 {
        return 0.0;
    }
    return generated_kwh * grid_co2_kg_per_kwh;
}

/// Compute complete daily yield summary metrics.
pub fn solar_compute_yield_metrics(
    array: &PvArray,
    actual_ac_kwh: Float,
    reference_poa_kwh_m2: Float,
    grid_co2_factor: Float
) -> SolarYieldMetrics {
    let pr = solar_calculate_performance_ratio(actual_ac_kwh, (array).peak_power_kw, reference_poa_kwh_m2);
    let co2 = solar_calculate_co2_savings(actual_ac_kwh, grid_co2_factor);

    // Capacity factor = (Actual kWh) / (Peak kW * 24 hours) * 100
    let mut cap_factor = 0.0;
    if (array).peak_power_kw > 0.0 {
        cap_factor = (actual_ac_kwh / ((array).peak_power_kw * 24.0)) * 100.0;
    }

    return SolarYieldMetrics {
        daily_yield_kwh: actual_ac_kwh,
        peak_power_kw: (array).peak_power_kw,
        capacity_factor_pct: cap_factor,
        performance_ratio_pct: pr,
        co2_saved_kg: co2
    };
}
