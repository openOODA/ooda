// # Microgrid Islanding Detection and Reconnection Operations
//
// Logline: IEEE 1547-style mains failure detection, transition to island mode, and reconnection checks.
//
// Setup: Imports microgrid_ops.oo for the IslandingStatus type.
//
// Beats:
//   1. Detect mains utility voltage and frequency threshold violations.
//   2. Initiate transition to autonomous islanded microgrid operation.
//   3. Check voltage, frequency, and phase alignment for grid reconnection.

import "./microgrid_ops.oo";

pub fn microgrid_abs(val: Float) -> Float {
    if val < 0.0 {
        return 0.0 - val;
    }
    return val;
}

pub fn microgrid_clamp(val: Float, lo: Float, hi: Float) -> Float {
    if val < lo {
        return lo;
    }
    if val > hi {
        return hi;
    }
    return val;
}

pub fn islanding_status_default() -> IslandingStatus {
    return IslandingStatus {
        is_islanded: false,
        grid_connected: true,
        status_code: 0,
        seamless_transition_active: false,
        frequency_hz: 60.0,
        voltage_pu: 1.0,
        phase_angle_deg: 0.0,
        reconnection_delay_sec: 0.0
    };
}

/// IEEE 1547-style mains failure: V < 0.88 pu or V > 1.12 pu, or f < 58.5 / f > 61.5 Hz.
pub fn islanding_detect_mains_failure(status: IslandingStatus, v_pu: Float, f_hz: Float) -> IslandingStatus {
    if (status).grid_connected == false {
        return status;
    }
    let mut is_fault: Bool = false;
    if v_pu < 0.88 {
        is_fault = true;
    }
    if v_pu > 1.12 {
        is_fault = true;
    }
    if f_hz < 58.5 {
        is_fault = true;
    }
    if f_hz > 61.5 {
        is_fault = true;
    }
    if is_fault == false {
        return status;
    }
    return IslandingStatus {
        is_islanded: (status).is_islanded,
        grid_connected: (status).grid_connected,
        status_code: 1,
        seamless_transition_active: true,
        frequency_hz: (status).frequency_hz,
        voltage_pu: (status).voltage_pu,
        phase_angle_deg: (status).phase_angle_deg,
        reconnection_delay_sec: (status).reconnection_delay_sec
    };
}

pub fn islanding_initiate_island(status: IslandingStatus) -> IslandingStatus {
    return IslandingStatus {
        is_islanded: true,
        grid_connected: false,
        status_code: 2,
        seamless_transition_active: false,
        frequency_hz: (status).frequency_hz,
        voltage_pu: (status).voltage_pu,
        phase_angle_deg: (status).phase_angle_deg,
        reconnection_delay_sec: (status).reconnection_delay_sec
    };
}

pub fn islanding_check_synchronization(status: IslandingStatus, grid_v_pu: Float, grid_f_hz: Float, grid_phase_deg: Float) -> Bool {
    if (status).is_islanded == false {
        return false;
    }
    let v_diff: Float = microgrid_abs((status).voltage_pu - grid_v_pu);
    let f_diff: Float = microgrid_abs((status).frequency_hz - grid_f_hz);
    let p_diff: Float = microgrid_abs((status).phase_angle_deg - grid_phase_deg);
    if v_diff > 0.05 {
        return false;
    }
    if f_diff > 0.10 {
        return false;
    }
    if p_diff > 10.0 {
        return false;
    }
    return true;
}

pub fn islanding_attempt_reconnection(status: IslandingStatus, grid_v_pu: Float, grid_f_hz: Float, grid_phase_deg: Float) -> IslandingStatus {
    let synced: Bool = islanding_check_synchronization(status, grid_v_pu, grid_f_hz, grid_phase_deg);
    if synced == false {
        return IslandingStatus {
            is_islanded: (status).is_islanded,
            grid_connected: (status).grid_connected,
            status_code: 2,
            seamless_transition_active: (status).seamless_transition_active,
            frequency_hz: (status).frequency_hz,
            voltage_pu: (status).voltage_pu,
            phase_angle_deg: (status).phase_angle_deg,
            reconnection_delay_sec: (status).reconnection_delay_sec
        };
    }
    return IslandingStatus {
        is_islanded: false,
        grid_connected: true,
        status_code: 0,
        seamless_transition_active: false,
        frequency_hz: (status).frequency_hz,
        voltage_pu: (status).voltage_pu,
        phase_angle_deg: (status).phase_angle_deg,
        reconnection_delay_sec: 0.0
    };
}
