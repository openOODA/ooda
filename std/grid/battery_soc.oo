// # Battery State of Charge Governance
//
// Logline: Calculates battery state of charge metrics, limits, and available charge/discharge energy.
//
// Setup: Pure energy storage mathematical algorithms importing battery_types.oo.
//
// Beats:
//   1. Construct StateOfCharge structures with boundary validations.
//   2. Calculate percentage SoC and verify operational envelope limits.
//   3. Compute usable energy headroom for charging and discharging cycles.


import "./battery_types.oo";

// -------------------------------------------------------------------
// State of Charge (SoC) Metrics & Boundary Governance
// -------------------------------------------------------------------

pub fn soc_new(soc_pct: Float, total_capacity_kwh: Float, min_limit_pct: Float, max_limit_pct: Float) -> StateOfCharge {
    let mut pct = soc_pct;
    if pct < 0.0 {
        pct = 0.0;
    }
    if pct > 100.0 {
        pct = 100.0;
    }

    let usable = (total_capacity_kwh * pct) / 100.0;
    let is_low = pct <= min_limit_pct;
    let is_full = pct >= max_limit_pct;

    return StateOfCharge {
        soc_pct: pct,
        usable_kwh: usable,
        total_capacity_kwh: total_capacity_kwh,
        min_soc_limit_pct: min_limit_pct,
        max_soc_limit_pct: max_limit_pct,
        is_critical_low: is_low,
        is_fully_charged: is_full
    };
}

/// Calculate SoC percentage given current energy stored and total capacity.
pub fn soc_calculate_pct(current_kwh: Float, total_capacity_kwh: Float) -> Float {
    if total_capacity_kwh <= 0.0 {
        return 0.0;
    }
    let mut pct = (current_kwh / total_capacity_kwh) * 100.0;
    if pct < 0.0 {
        pct = 0.0;
    }
    if pct > 100.0 {
        pct = 100.0;
    }
    return pct;
}

/// Check if current SoC is within safe operational percentage limits.
pub fn soc_is_within_limits(soc: &StateOfCharge) -> Bool {
    let pct = (soc).soc_pct;
    let min_lim = (soc).min_soc_limit_pct;
    let max_lim = (soc).max_soc_limit_pct;
    if pct < min_lim {
        return false;
    }
    if pct > max_lim {
        return false;
    }
    return true;
}

/// Calculate remaining available energy in kWh that can be charged before hitting max SoC limit.
pub fn soc_available_charge_kwh(soc: &StateOfCharge) -> Float {
    let cap = (soc).total_capacity_kwh;
    let max_pct = (soc).max_soc_limit_pct;
    let cur_pct = (soc).soc_pct;
    if cur_pct >= max_pct {
        return 0.0;
    }
    return (cap * (max_pct - cur_pct)) / 100.0;
}

/// Calculate remaining available energy in kWh that can be discharged before hitting min SoC limit.
pub fn soc_available_discharge_kwh(soc: &StateOfCharge) -> Float {
    let cap = (soc).total_capacity_kwh;
    let min_pct = (soc).min_soc_limit_pct;
    let cur_pct = (soc).soc_pct;
    if cur_pct <= min_pct {
        return 0.0;
    }
    return (cap * (cur_pct - min_pct)) / 100.0;
}
