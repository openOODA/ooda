// # Microgrid Inverter Droop and Load Shedding Operations
//
// Logline: P-f and Q-V inverter droop setpoint calculation, response update, and load priority shedding.
//
// Setup: Imports microgrid_ops.oo for types and microgrid_ops_island.oo for the abs and clamp helpers.
//
// Beats:
//   1. Compute P and Q setpoints with deadbands and droop gains.
//   2. Update the droop controller's actual response.
//   3. Shed and restore load priority groups.

import "./microgrid_ops.oo";
import "./microgrid_ops_island.oo";

pub fn droop_control_default() -> DroopControl {
    return DroopControl {
        is_enabled: true,
        p_nominal_kw: 500.0,
        f_nominal_hz: 60.0,
        f_deadband_hz: 0.036,
        kp_droop: 100.0,
        p_max_kw: 1000.0,
        p_actual_kw: 500.0,
        q_nominal_kvar: 200.0,
        v_nominal_pu: 1.0,
        v_deadband_pu: 0.01,
        kq_droop: 50.0,
        q_max_kvar: 400.0,
        q_actual_kvar: 200.0
    };
}

pub fn load_priority_group_new(group_id: Int, priority: Int, load_kw: Float) -> LoadPriorityGroup {
    return LoadPriorityGroup {
        group_id: group_id,
        priority: priority,
        total_load_kw: load_kw,
        allocated_load_kw: load_kw,
        is_shed: false
    };
}

/// P_set = P_nom - Kp * (f - f_nom) with deadband.
pub fn droop_control_calculate_p(droop: DroopControl, current_f_hz: Float) -> Float {
    if (droop).is_enabled == false {
        return (droop).p_nominal_kw;
    }
    let dev: Float = current_f_hz - (droop).f_nominal_hz;
    let abs_dev: Float = microgrid_abs(dev);
    let db: Float = (droop).f_deadband_hz;
    if abs_dev <= db {
        return (droop).p_nominal_kw;
    }
    let mut eff_dev: Float = 0.0;
    if dev > db {
        eff_dev = dev - db;
    } else {
        eff_dev = dev + db;
    }
    let p_target: Float = (droop).p_nominal_kw - ((droop).kp_droop * eff_dev);
    return microgrid_clamp(p_target, 0.0, (droop).p_max_kw);
}

/// Q_set = Q_nom - Kq * (V - V_nom) with deadband.
pub fn droop_control_calculate_q(droop: DroopControl, current_v_pu: Float) -> Float {
    if (droop).is_enabled == false {
        return (droop).q_nominal_kvar;
    }
    let dev: Float = current_v_pu - (droop).v_nominal_pu;
    let abs_dev: Float = microgrid_abs(dev);
    let db: Float = (droop).v_deadband_pu;
    if abs_dev <= db {
        return (droop).q_nominal_kvar;
    }
    let mut eff_dev: Float = 0.0;
    if dev > db {
        eff_dev = dev - db;
    } else {
        eff_dev = dev + db;
    }
    let q_target: Float = (droop).q_nominal_kvar - ((droop).kq_droop * eff_dev);
    let neg_q_max: Float = 0.0 - (droop).q_max_kvar;
    return microgrid_clamp(q_target, neg_q_max, (droop).q_max_kvar);
}

pub fn droop_control_update_response(droop: DroopControl, current_f_hz: Float, current_v_pu: Float) -> DroopControl {
    let p_res: Float = droop_control_calculate_p(droop, current_f_hz);
    let q_res: Float = droop_control_calculate_q(droop, current_v_pu);
    return DroopControl {
        is_enabled: (droop).is_enabled,
        p_nominal_kw: (droop).p_nominal_kw,
        f_nominal_hz: (droop).f_nominal_hz,
        f_deadband_hz: (droop).f_deadband_hz,
        kp_droop: (droop).kp_droop,
        p_max_kw: (droop).p_max_kw,
        p_actual_kw: p_res,
        q_nominal_kvar: (droop).q_nominal_kvar,
        v_nominal_pu: (droop).v_nominal_pu,
        v_deadband_pu: (droop).v_deadband_pu,
        kq_droop: (droop).kq_droop,
        q_max_kvar: (droop).q_max_kvar,
        q_actual_kvar: q_res
    };
}

pub fn load_priority_group_shed(group: LoadPriorityGroup) -> LoadPriorityGroup {
    return LoadPriorityGroup {
        group_id: (group).group_id,
        priority: (group).priority,
        total_load_kw: (group).total_load_kw,
        allocated_load_kw: 0.0,
        is_shed: true
    };
}

pub fn load_priority_group_restore(group: LoadPriorityGroup) -> LoadPriorityGroup {
    return LoadPriorityGroup {
        group_id: (group).group_id,
        priority: (group).priority,
        total_load_kw: (group).total_load_kw,
        allocated_load_kw: (group).total_load_kw,
        is_shed: false
    };
}
