// # Wind Energy Generation Facade
//
// Logline: Re-exports wind power curves, active blade pitch controllers, turbine models, and wind farms.
//
// Setup: Pure module shim importing curve, pitch, turbine, farm, and stubs submodules.
//
// Beats:
//   1. Import aerodynamic power curves, blade pitch controllers, and turbine models.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain backward compatibility with downstream wind generation consumers.


import "./wind_curve.oo";
import "./wind_pitch.oo";
import "./wind_turbine.oo";
import "./wind_turbine_ops.oo";
import "./wind_farm.oo";
import "./wind_stubs.oo";

pub fn shim_marker_math_pi() -> Float {
    return math_pi();
}

pub fn shim_marker_power_curve_default() -> PowerCurve {
    return power_curve_default();
}

pub fn shim_marker_power_curve_power() -> Float {
    let c: PowerCurve = power_curve_default();
    return power_curve_calculate_power(&c, 12.0, 1.225);
}

pub fn shim_marker_pitch_default() -> PitchController {
    return pitch_controller_default();
}

pub fn shim_marker_turbine_default() -> WindTurbine {
    return wind_turbine_default(1);
}

pub fn shim_marker_turbine_safe() -> Bool {
    let t: WindTurbine = wind_turbine_default(1);
    return wind_turbine_is_safe(&t, 85.0);
}

pub fn shim_marker_farm_new() -> WindFarm {
    return wind_farm_new(1, 30000.0, 10);
}

pub fn shim_marker_farm_capacity() -> Float {
    let f: WindFarm = wind_farm_new(1, 30000.0, 10);
    return wind_farm_capacity_factor(&f);
}

pub fn shim_marker_telemetry() -> TurbineTelemetry {
    let t: WindTurbine = wind_turbine_default(2);
    return turbine_telemetry_extract(&t);
}
