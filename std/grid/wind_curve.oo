// # Wind Turbine Power Curve & Aerodynamic Math
//
// Logline: Computes wind power curves, Betz limit aerodynamics, air density corrections, and cubic math.
//
// Setup: Pure mathematical and aerodynamic modeling.
//
// Beats:
//   1. Implement mathematical constants and cubic power functions.
//   2. Define PowerCurve operational speeds and power coefficient Cp.
//   3. Compute aerodynamic kinetic power from rotor swept area.
//   4. Calculate piecewise turbine electrical power output with air density derating.


// -------------------------------------------------------------------
// 1. Primitive Math Helpers
// -------------------------------------------------------------------

pub fn math_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

pub fn math_pow3(x: Float) -> Float {
    return x * x * x;
}

pub fn math_clamp(val: Float, min_val: Float, max_val: Float) -> Float {
    if val < min_val {
        return min_val;
    }
    if val > max_val {
        return max_val;
    }
    return val;
}

pub fn deg_to_rad(deg: Float) -> Float {
    return (deg * math_pi()) / 180.0;
}

pub fn rad_to_deg(rad: Float) -> Float {
    return (rad * 180.0) / math_pi();
}

// -------------------------------------------------------------------
// 2. Wind Turbine Power Curve Specification
// -------------------------------------------------------------------

/// Represents aerodynamic & electrical power curve parameters of a wind turbine.
pub type PowerCurve = struct {
    cut_in_speed_ms: Float,
    rated_speed_ms: Float,
    cut_out_speed_ms: Float,
    rated_power_kw: Float,
    rotor_diameter_m: Float,
    cp_max: Float,
    air_density_ref: Float,
};

/// Construct a new PowerCurve specification with explicit parameters.
pub fn power_curve_new(
    cut_in: Float,
    rated_speed: Float,
    cut_out: Float,
    rated_power_kw: Float,
    rotor_diam_m: Float,
    cp_max: Float,
) -> PowerCurve {
    let mut cp = cp_max;
    if cp <= 0.0 {
        cp = 0.42;
    }
    if cp > 0.593 {
        cp = 0.593; // Theoretical Betz limit
    }

    return PowerCurve {
        cut_in_speed_ms: cut_in,
        rated_speed_ms: rated_speed,
        cut_out_speed_ms: cut_out,
        rated_power_kw: rated_power_kw,
        rotor_diameter_m: rotor_diam_m,
        cp_max: cp,
        air_density_ref: 1.225, // Standard atmospheric air density at sea level (kg/m^3)
    };
}

/// Default standard 3MW utility wind turbine power curve (112m rotor diameter).
pub fn power_curve_default() -> PowerCurve {
    return power_curve_new(3.0, 12.0, 25.0, 3000.0, 112.0, 0.45);
}

/// Calculate rotor swept area A = pi * r^2 in m^2.
pub fn power_curve_swept_area(curve: &PowerCurve) -> Float {
    let radius = (curve).rotor_diameter_m / 2.0;
    return math_pi() * radius * radius;
}

/// Calculate total kinetic power available in undisturbed wind stream (kW).
/// P_wind = 0.5 * rho * A * v^3 / 1000.0
pub fn power_curve_theoretical_wind_power(air_density: Float, swept_area: Float, wind_speed_ms: Float) -> Float {
    if wind_speed_ms <= 0.0 {
        return 0.0;
    }
    let p_watts = 0.5 * air_density * swept_area * math_pow3(wind_speed_ms);
    return p_watts / 1000.0;
}

/// Calculate electrical output power (kW) across 4 operational wind speed regions.
pub fn power_curve_calculate_power(curve: &PowerCurve, wind_speed_ms: Float, air_density: Float) -> Float {
    let v_cut_in = (curve).cut_in_speed_ms;
    let v_rated = (curve).rated_speed_ms;
    let v_cut_out = (curve).cut_out_speed_ms;
    let p_rated = (curve).rated_power_kw;

    // Region 1 & Region 4: Below cut-in or above cut-out (feathered/parked)
    if wind_speed_ms < v_cut_in {
        return 0.0;
    }
    if wind_speed_ms > v_cut_out {
        return 0.0;
    }

    // Region 3: Constant rated power output above rated wind speed
    if wind_speed_ms >= v_rated {
        return p_rated;
    }

    // Region 2: Cubic power ramp between cut-in and rated speed
    let area = power_curve_swept_area(curve);
    let rho = air_density;
    let cp = (curve).cp_max;

    let gross_kw = (0.5 * rho * area * math_pow3(wind_speed_ms) * cp) / 1000.0;
    return math_clamp(gross_kw, 0.0, p_rated);
}
