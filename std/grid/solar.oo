// # Solar Photovoltaic Generation Facade
//
// Logline: Re-exports solar irradiance, PV arrays, MPPT tracking, inverters, and energy yield calculators.
//
// Setup: Pure module shim importing solar math, types, irradiance, PV, MPPT, inverter, yield, and stubs.
//
// Beats:
//   1. Import solar physics models, MPPT algorithms, and inverter engines.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream solar generation consumers.


import "./solar_math.oo";
import "./solar_types.oo";
import "./solar_irrad.oo";
import "./solar_pv.oo";
import "./solar_mppt.oo";
import "./solar_inverter.oo";
import "./solar_yield.oo";
import "./solar_stubs.oo";

pub fn shim_marker_math_pi() -> Float {
    return math_pi();
}

pub fn shim_marker_irrad_stc() -> SolarIrradiance {
    return solar_irradiance_stc();
}

pub fn shim_marker_pv_default() -> PvArray {
    return pv_array_default();
}

pub fn shim_marker_pv_dc_power() -> Float {
    let array: PvArray = pv_array_default();
    let irrad: SolarIrradiance = solar_irradiance_stc();
    return pv_array_calc_dc_power(&array, &irrad);
}

pub fn shim_marker_mppt_default() -> MpptState {
    return mppt_state_default();
}

pub fn shim_marker_inverter_default() -> SolarInverter {
    return solar_inverter_default();
}

pub fn shim_marker_daily_yield() -> Float {
    let array: PvArray = pv_array_default();
    return solar_estimate_daily_yield_kwh(&array, 5.0, 0.85);
}

pub fn shim_marker_co2_savings() -> Float {
    return solar_calculate_co2_savings(1000.0, 0.5);
}

pub fn shim_marker_performance_ratio() -> Float {
    return solar_calculate_performance_ratio(400.0, 100.0, 5.0);
}
