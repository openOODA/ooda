// # Battery Energy Storage Facade
//
// Logline: Re-exports battery storage types, SoC estimation, bank operations, and dispatch schedules.
//
// Setup: Pure module shim importing types, SoC, bank, dispatch, and stubs companion modules.
//
// Beats:
//   1. Import battery types, SoC calculators, bank operations, and stubs.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain backward compatibility with downstream energy storage consumers.


import "./battery_types.oo";
import "./battery_soc.oo";
import "./battery_bank.oo";
import "./battery_dispatch.oo";
import "./battery_stubs.oo";

pub fn shim_marker_soc_new() -> StateOfCharge {
    return soc_new(50.0, 1000.0, 10.0, 95.0);
}

pub fn shim_marker_soc_pct() -> Float {
    return soc_calculate_pct(500.0, 1000.0);
}

pub fn shim_marker_soc_limits() -> Bool {
    let s: StateOfCharge = soc_new(50.0, 1000.0, 10.0, 95.0);
    return soc_is_within_limits(&s);
}

pub fn shim_marker_soc_charge_avail() -> Float {
    let s: StateOfCharge = soc_new(50.0, 1000.0, 10.0, 95.0);
    return soc_available_charge_kwh(&s);
}

pub fn shim_marker_bank_new() -> BatteryBank {
    return battery_bank_new(1000.0, 500.0, 500.0, 90.0);
}

pub fn shim_marker_bank_default() -> BatteryBank {
    return battery_bank_default();
}

pub fn shim_marker_bank_soc() -> StateOfCharge {
    let b: BatteryBank = battery_bank_default();
    return battery_bank_get_soc(&b);
}

pub fn shim_marker_bank_safe() -> Bool {
    let b: BatteryBank = battery_bank_default();
    return battery_bank_is_safe(&b, 60.0);
}

pub fn shim_marker_schedule_new() -> DispatchSchedule {
    return dispatch_schedule_new(100.0, 1.0, 0, 5);
}

pub fn shim_marker_peak_shaving() -> DispatchSchedule {
    return dispatch_schedule_peak_shaving(800.0, 500.0, 1.0);
}

pub fn shim_marker_schedule_energy() -> Float {
    let s: DispatchSchedule = dispatch_schedule_new(100.0, 2.0, 0, 5);
    return dispatch_schedule_estimate_energy_kwh(&s);
}

pub fn shim_marker_arbitrage_yield() -> Float {
    let s: DispatchSchedule = dispatch_schedule_arbitrage(100.0, 1.0, 2, 18);
    return dispatch_schedule_estimate_financial_yield(&s, 0.05, 0.15);
}
