// # Solar Geometry & Trigonometric Math Helpers
//
// Logline: Provides angular conversions, absolute value, and trigonometric helpers for solar positioning.
//
// Setup: Pure floating-point numerical functions.
//
// Beats:
//   1. Define mathematical constant Pi.
//   2. Implement absolute value arithmetic.
//   3. Convert degrees to radians and radians to degrees.


// -------------------------------------------------------------------
// Primitive Math & Trigonometric Helpers
// -------------------------------------------------------------------

pub fn math_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

pub fn deg_to_rad(deg: Float) -> Float {
    return (deg * math_pi()) / 180.0;
}

pub fn rad_to_deg(rad: Float) -> Float {
    return (rad * 180.0) / math_pi();
}
