// # Microgrid State & Control Facade
//
// Logline: Re-exports microgrid islanding governance, droop control, load shedding, and balancing engines.
//
// Setup: Pure module shim importing by-value operations and engine companions.
//
// Beats:
//   1. Import microgrid operational algorithms and simulation engine.
//   2. Re-export public symbols with typed shim markers.

import "./microgrid_ops.oo";
import "./microgrid_engine.oo";

pub fn shim_marker_islanding_default() -> IslandingStatus {
    return islanding_status_default();
}

pub fn shim_marker_droop_default() -> DroopControl {
    return droop_control_default();
}

pub fn shim_marker_load_group_new() -> LoadPriorityGroup {
    return load_priority_group_new(1, 3, 150.0);
}

pub fn shim_marker_microgrid_default() -> MicrogridState {
    return microgrid_state_default();
}

pub fn shim_marker_detect_mains(status: IslandingStatus, v_pu: Float, f_hz: Float) -> IslandingStatus {
    return islanding_detect_mains_failure(status, v_pu, f_hz);
}
