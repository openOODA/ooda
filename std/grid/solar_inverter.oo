// # Grid-Tied Solar Inverter & Conversion Efficiency Engine
//
// Logline: Converts photovoltaic DC power to AC output with Sandia efficiency curves, clipping, and reactive power.
//
// Setup: Power electronics conversion models with by-value inverter state.
//
// Beats:
//   1. Construct SolarInverter models with AC/DC nameplate ratings and defaults.
//   2. Calculate conversion efficiency across varying DC loading levels.
//   3. Compute AC active power output with inverter clipping.
//   4. Apply grid operator active power curtailment commands.

type SolarInverter = struct {
    inverter_id: Int,
    rated_ac_kw: Float,
    rated_dc_kw: Float,
    efficiency_peak_pct: Float,
    efficiency_weighted_pct: Float,
    power_factor: Float,
    curtailment_limit_pct: Float,
    ac_power_kw: Float,
    ac_frequency_hz: Float,
    status: Int
};

pub fn solar_inverter_new(id: Int, rated_ac_kw: Float, rated_dc_kw: Float, eff_peak_pct: Float) -> SolarInverter {
    return SolarInverter {
        inverter_id: id,
        rated_ac_kw: rated_ac_kw,
        rated_dc_kw: rated_dc_kw,
        efficiency_peak_pct: eff_peak_pct,
        efficiency_weighted_pct: eff_peak_pct - 1.5,
        power_factor: 1.0,
        curtailment_limit_pct: 100.0,
        ac_power_kw: 0.0,
        ac_frequency_hz: 60.0,
        status: 0
    };
}

pub fn solar_inverter_default() -> SolarInverter {
    return solar_inverter_new(1, 100.0, 110.0, 98.5);
}

pub fn solar_inverter_calc_part_load_efficiency(inverter: SolarInverter, dc_power_kw: Float) -> Float {
    if dc_power_kw <= 0.0 {
        return 0.0;
    }
    let loading_ratio: Float = dc_power_kw / inverter.rated_dc_kw;
    if loading_ratio <= 0.05 {
        return inverter.efficiency_peak_pct * 0.70;
    }
    if loading_ratio <= 0.20 {
        return inverter.efficiency_peak_pct * 0.90;
    }
    if loading_ratio <= 0.80 {
        return inverter.efficiency_peak_pct;
    }
    if loading_ratio <= 1.00 {
        return inverter.efficiency_weighted_pct;
    }
    return inverter.efficiency_weighted_pct * 0.95;
}

pub fn solar_inverter_convert(inverter: SolarInverter, dc_power_kw: Float) -> SolarInverter {
    if inverter.status == 3 {
        return SolarInverter {
            inverter_id: inverter.inverter_id,
            rated_ac_kw: inverter.rated_ac_kw,
            rated_dc_kw: inverter.rated_dc_kw,
            efficiency_peak_pct: inverter.efficiency_peak_pct,
            efficiency_weighted_pct: inverter.efficiency_weighted_pct,
            power_factor: inverter.power_factor,
            curtailment_limit_pct: inverter.curtailment_limit_pct,
            ac_power_kw: 0.0,
            ac_frequency_hz: inverter.ac_frequency_hz,
            status: inverter.status
        };
    }
    if dc_power_kw <= 0.0 {
        return SolarInverter {
            inverter_id: inverter.inverter_id,
            rated_ac_kw: inverter.rated_ac_kw,
            rated_dc_kw: inverter.rated_dc_kw,
            efficiency_peak_pct: inverter.efficiency_peak_pct,
            efficiency_weighted_pct: inverter.efficiency_weighted_pct,
            power_factor: inverter.power_factor,
            curtailment_limit_pct: inverter.curtailment_limit_pct,
            ac_power_kw: 0.0,
            ac_frequency_hz: inverter.ac_frequency_hz,
            status: 0
        };
    }
    let eff_pct: Float = solar_inverter_calc_part_load_efficiency(inverter, dc_power_kw);
    let gross_ac_kw: Float = (dc_power_kw * eff_pct) / 100.0;
    let mut allowable_ac_kw: Float = gross_ac_kw;
    if allowable_ac_kw > inverter.rated_ac_kw {
        allowable_ac_kw = inverter.rated_ac_kw;
    }
    let curtail_cap_kw: Float = (inverter.rated_ac_kw * inverter.curtailment_limit_pct) / 100.0;
    let mut status: Int = 1;
    if allowable_ac_kw > curtail_cap_kw {
        allowable_ac_kw = curtail_cap_kw;
        status = 2;
    }
    return SolarInverter {
        inverter_id: inverter.inverter_id,
        rated_ac_kw: inverter.rated_ac_kw,
        rated_dc_kw: inverter.rated_dc_kw,
        efficiency_peak_pct: inverter.efficiency_peak_pct,
        efficiency_weighted_pct: inverter.efficiency_weighted_pct,
        power_factor: inverter.power_factor,
        curtailment_limit_pct: inverter.curtailment_limit_pct,
        ac_power_kw: allowable_ac_kw,
        ac_frequency_hz: inverter.ac_frequency_hz,
        status: status
    };
}

pub fn solar_inverter_set_curtailment(inverter: SolarInverter, limit_pct: Float) -> SolarInverter {
    let mut lim: Float = limit_pct;
    if lim < 0.0 {
        lim = 0.0;
    }
    if lim > 100.0 {
        lim = 100.0;
    }
    return SolarInverter {
        inverter_id: inverter.inverter_id,
        rated_ac_kw: inverter.rated_ac_kw,
        rated_dc_kw: inverter.rated_dc_kw,
        efficiency_peak_pct: inverter.efficiency_peak_pct,
        efficiency_weighted_pct: inverter.efficiency_weighted_pct,
        power_factor: inverter.power_factor,
        curtailment_limit_pct: lim,
        ac_power_kw: inverter.ac_power_kw,
        ac_frequency_hz: inverter.ac_frequency_hz,
        status: inverter.status
    };
}
