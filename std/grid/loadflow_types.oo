type ComplexNum = struct {
    re: Int,
    im: Int
};

pub fn complex_new(r: Int, i: Int) -> ComplexNum {
    return ComplexNum { re: r, im: i };
}

pub fn complex_add(a: ComplexNum, b: ComplexNum) -> ComplexNum {
    let ar: Int = a.re;
    let ai: Int = a.im;
    let br: Int = b.re;
    let bi: Int = b.im;
    return ComplexNum { re: ar + br, im: ai + bi };
}
