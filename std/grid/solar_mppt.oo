// # Maximum Power Point Tracking Controller
//
// Logline: Executes Perturb and Observe algorithms to maximize photovoltaic DC power harvest.
//
// Setup: Pure MPPT tracking algorithms with by-value state.
//
// Beats:
//   1. Construct MpptState structures with voltage step sizes and efficiency ratings.
//   2. Step Perturb and Observe (P&O) hill-climbing voltage optimization.
//   3. Compute tracked DC power output and efficiency metrics.

import "./solar_math.oo";

type MpptState = struct {
    mode: Int,
    operating_v: Float,
    operating_i: Float,
    power_dc_kw: Float,
    target_v: Float,
    v_step: Float,
    prev_power_kw: Float,
    prev_v: Float,
    efficiency_pct: Float,
    is_locked: Bool
};

pub fn mppt_state_new(mode: Int, initial_v: Float, v_step: Float) -> MpptState {
    return MpptState {
        mode: mode,
        operating_v: initial_v,
        operating_i: 0.0,
        power_dc_kw: 0.0,
        target_v: initial_v,
        v_step: v_step,
        prev_power_kw: 0.0,
        prev_v: initial_v,
        efficiency_pct: 99.5,
        is_locked: false
    };
}

pub fn mppt_state_default() -> MpptState {
    return mppt_state_new(0, 400.0, 1.0);
}

/// Perturb & Observe: climb dP/dV. Returns updated MPPT state (target_v is next bias).
pub fn mppt_step_perturb_and_observe(mppt: MpptState, current_v: Float, current_i: Float) -> MpptState {
    let power_kw: Float = (current_v * current_i) / 1000.0;
    let delta_p: Float = power_kw - mppt.prev_power_kw;
    let delta_v: Float = current_v - mppt.prev_v;
    let step: Float = mppt.v_step;
    let mut new_target_v: Float = current_v;
    let mut locked: Bool = true;
    if math_abs(delta_p) > 0.0001 {
        locked = false;
        if delta_p > 0.0 {
            if delta_v >= 0.0 {
                new_target_v = current_v + step;
            } else {
                new_target_v = current_v - step;
            }
        } else {
            if delta_v >= 0.0 {
                new_target_v = current_v - step;
            } else {
                new_target_v = current_v + step;
            }
        }
    }
    return MpptState {
        mode: mppt.mode,
        operating_v: current_v,
        operating_i: current_i,
        power_dc_kw: power_kw * (mppt.efficiency_pct / 100.0),
        target_v: new_target_v,
        v_step: mppt.v_step,
        prev_power_kw: power_kw,
        prev_v: current_v,
        efficiency_pct: mppt.efficiency_pct,
        is_locked: locked
    };
}
