// # Power Grid Load Flow Analysis Facade
//
// Logline: Re-exports complex arithmetic, bus models, admittance operations, and Gauss-Seidel solver routines.
//
// Setup: Pure module shim importing types, operations, engine, solver, and stubs submodules.
//
// Beats:
//   1. Import load flow mathematical models and iterative solvers.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream power grid analysis callers.


import "./loadflow_ops.oo";
import "./loadflow_engine.oo";
import "./loadflow_solver.oo";
import "./loadflow_stubs.oo";

pub fn shim_marker_math_pi() -> Float {
    return math_pi();
}

pub fn shim_marker_complex_zero() -> ComplexNum {
    return complex_zero();
}

pub fn shim_marker_config_default() -> LoadFlowConfig {
    return loadflow_config_default();
}

pub fn shim_marker_loadflow_init() -> GridModule {
    return loadflow_init();
}

pub fn shim_marker_module_ready() -> Bool {
    return loadflow_module_ready();
}
