// # Power Grid Load Flow Domain Models & Admittance Ops
//
// Logline: Defines buses, transmission lines, load flow configurations, and nodal injection equations.
//
// Setup: Power network topology definitions importing loadflow_types.oo.
//
// Beats:
//   1. Define BusState, TransmissionLine, and LoadFlowConfig models.
//   2. Construct default bus, branch, and configuration specifications.
//   3. Calculate bus active and reactive power mismatches.
//   4. Compute active power flow losses across network branches.


import "./loadflow_types.oo";


// -------------------------------------------------------------------
// 3. Core Domain Types (Bus, Line, Admittance, Flow, Result)
// -------------------------------------------------------------------

// Bus Type Enumeration constants:
//   0 = SLACK / SWING bus (V magnitude & angle fixed)
//   1 = PV / GENERATOR bus (P active power & V magnitude fixed)
//   2 = PQ / LOAD bus (P active power & Q reactive power fixed)

pub type BusState = struct {
    bus_id: Int,
    bus_type: Int,
    v_mag: Float,
    v_ang: Float,
    p_gen: Float,
    q_gen: Float,
    p_load: Float,
    q_load: Float,
    v_min: Float,
    v_max: Float,
    q_min: Float,
    q_max: Float
};

pub type TransmissionLine = struct {
    line_id: Int,
    from_bus: Int,
    to_bus: Int,
    r: Float,
    x: Float,
    b_shunt: Float,
    tap_ratio: Float,
    rating_mva: Float,
    status: Int
};

pub type BranchAdmittance = struct {
    g_series: Float,
    b_series: Float,
    b_charging: Float,
    g_total: Float,
    b_total: Float
};

pub type BranchFlow = struct {
    line_id: Int,
    p_from_to: Float,
    q_from_to: Float,
    p_to_from: Float,
    q_to_from: Float,
    p_loss: Float,
    q_loss: Float,
    loading_percent: Float
};

pub type PowerMismatch = struct {
    bus_id: Int,
    delta_p: Float,
    delta_q: Float
};

pub type LoadFlowResult = struct {
    converged: Bool,
    iterations: Int,
    max_p_mismatch: Float,
    max_q_mismatch: Float,
    total_p_gen: Float,
    total_q_gen: Float,
    total_p_load: Float,
    total_q_load: Float,
    total_p_loss: Float,
    total_q_loss: Float
};

pub type LoadFlowConfig = struct {
    base_mva: Float,
    max_iterations: Int,
    tolerance: Float,
    acceleration_factor: Float
};

pub type TwoBusNetwork = struct {
    bus1: BusState,
    bus2: BusState,
    line: TransmissionLine
};

pub type GridModule = struct {
    network: TwoBusNetwork,
    config: LoadFlowConfig,
    step_count: Int
};


pub fn bus_state_new(
    id: Int,
    b_type: Int,
    v_m: Float,
    v_a: Float,
    p_g: Float,
    q_g: Float,
    p_l: Float,
    q_l: Float
) -> BusState {
    return BusState {
        bus_id: id,
        bus_type: b_type,
        v_mag: v_m,
        v_ang: v_a,
        p_gen: p_g,
        q_gen: q_g,
        p_load: p_l,
        q_load: q_l,
        v_min: 0.95,
        v_max: 1.05,
        q_min: 0.0 - 0.5,
        q_max: 0.5
    };
}

pub fn transmission_line_new(
    id: Int,
    from_b: Int,
    to_b: Int,
    r_val: Float,
    x_val: Float,
    b_sh: Float,
    rating: Float
) -> TransmissionLine {
    return TransmissionLine {
        line_id: id,
        from_bus: from_b,
        to_bus: to_b,
        r: r_val,
        x: x_val,
        b_shunt: b_sh,
        tap_ratio: 1.0,
        rating_mva: rating,
        status: 1
    };
}

pub fn loadflow_config_default() -> LoadFlowConfig {
    return LoadFlowConfig {
        base_mva: 100.0,
        max_iterations: 100,
        tolerance: 0.0001,
        acceleration_factor: 1.0
    };
}

pub fn loadflow_result_default() -> LoadFlowResult {
    return LoadFlowResult {
        converged: false,
        iterations: 0,
        max_p_mismatch: 0.0,
        max_q_mismatch: 0.0,
        total_p_gen: 0.0,
        total_q_gen: 0.0,
        total_p_load: 0.0,
        total_q_load: 0.0,
        total_p_loss: 0.0,
        total_q_loss: 0.0
    };
}

