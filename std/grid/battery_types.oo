// # Battery types
//
// Logline: BatteryBank destubbed off nested schedule lists.
// residual: List[struct] destubbed.

type BatteryBank = struct {
    cycle_count: Int,
    status: Int
};

pub fn battery_bank_new(cycle_count: Int, status: Int) -> BatteryBank {
    return BatteryBank {
        cycle_count: cycle_count,
        status: status
    };
}

pub fn battery_bank_cycles(b: BatteryBank) -> Int {
    return b.cycle_count;
}
