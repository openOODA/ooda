// # Microgrid Simulation & Balancing Engine
//
// Logline: Simulates microgrid load-generation balance, spinning reserves, and emergency load shedding.
//
// Setup: Pure microgrid simulation engine importing by-value operations.
//
// Beats:
//   1. Calculate net power mismatch between generation and total load.
//   2. Evaluate load balance, spinning reserves, and operational modes.
//   3. Apply emergency non-critical load shedding under generation deficit.
//   4. Execute forward simulation time steps across electrical transients.

import "./microgrid_ops.oo";

type MicrogridState = struct {
    islanding_status: IslandingStatus,
    droop_control: DroopControl,
    total_generation_kw: Float,
    total_load_kw: Float,
    non_critical_load_kw: Float,
    power_mismatch_kw: Float,
    spinning_reserve_kw: Float,
    operating_mode: Int
};

pub fn microgrid_state_default() -> MicrogridState {
    return MicrogridState {
        islanding_status: islanding_status_default(),
        droop_control: droop_control_default(),
        total_generation_kw: 1000.0,
        total_load_kw: 800.0,
        non_critical_load_kw: 300.0,
        power_mismatch_kw: 200.0,
        spinning_reserve_kw: 200.0,
        operating_mode: 0
    };
}

pub fn microgrid_calculate_power_mismatch(mg: MicrogridState) -> Float {
    return (mg).total_generation_kw - (mg).total_load_kw;
}

pub fn microgrid_evaluate_load_balance(mg: MicrogridState) -> MicrogridState {
    let mismatch: Float = microgrid_calculate_power_mismatch(mg);
    let mut reserve: Float = (mg).total_generation_kw - (mg).total_load_kw;
    if reserve < 0.0 {
        reserve = 0.0;
    }
    let mut mode: Int = 0;
    let isl: IslandingStatus = (mg).islanding_status;
    if (isl).is_islanded {
        if mismatch < 0.0 {
            mode = 2;
        } else {
            mode = 1;
        }
    } else {
        mode = 0;
    }
    return MicrogridState {
        islanding_status: (mg).islanding_status,
        droop_control: (mg).droop_control,
        total_generation_kw: (mg).total_generation_kw,
        total_load_kw: (mg).total_load_kw,
        non_critical_load_kw: (mg).non_critical_load_kw,
        power_mismatch_kw: mismatch,
        spinning_reserve_kw: reserve,
        operating_mode: mode
    };
}

pub fn microgrid_apply_load_shedding(mg: MicrogridState) -> MicrogridState {
    let mismatch: Float = microgrid_calculate_power_mismatch(mg);
    if mismatch >= 0.0 {
        return mg;
    }
    let deficit_kw: Float = 0.0 - mismatch;
    let avail_shed: Float = (mg).non_critical_load_kw;
    let mut shed_amount: Float = deficit_kw;
    if shed_amount > avail_shed {
        shed_amount = avail_shed;
    }
    let next: MicrogridState = MicrogridState {
        islanding_status: (mg).islanding_status,
        droop_control: (mg).droop_control,
        total_generation_kw: (mg).total_generation_kw,
        total_load_kw: (mg).total_load_kw - shed_amount,
        non_critical_load_kw: (mg).non_critical_load_kw - shed_amount,
        power_mismatch_kw: (mg).power_mismatch_kw,
        spinning_reserve_kw: (mg).spinning_reserve_kw,
        operating_mode: 2
    };
    return microgrid_evaluate_load_balance(next);
}

pub fn microgrid_step_simulation(mg: MicrogridState, gen_kw: Float, load_kw: Float, f_hz: Float, v_pu: Float, dt_sec: Float) -> MicrogridState {
    let _dt: Float = dt_sec;
    let isl_cur: IslandingStatus = (mg).islanding_status;
    let isl0: IslandingStatus = IslandingStatus {
        is_islanded: (isl_cur).is_islanded,
        grid_connected: (isl_cur).grid_connected,
        status_code: (isl_cur).status_code,
        seamless_transition_active: (isl_cur).seamless_transition_active,
        frequency_hz: f_hz,
        voltage_pu: v_pu,
        phase_angle_deg: (isl_cur).phase_angle_deg,
        reconnection_delay_sec: (isl_cur).reconnection_delay_sec
    };
    let isl1: IslandingStatus = islanding_detect_mains_failure(isl0, v_pu, f_hz);
    let mut isl2: IslandingStatus = isl1;
    if (isl1).status_code == 1 {
        isl2 = islanding_initiate_island(isl1);
    }
    let droop: DroopControl = droop_control_update_response((mg).droop_control, f_hz, v_pu);
    let next: MicrogridState = MicrogridState {
        islanding_status: isl2,
        droop_control: droop,
        total_generation_kw: gen_kw,
        total_load_kw: load_kw,
        non_critical_load_kw: (mg).non_critical_load_kw,
        power_mismatch_kw: (mg).power_mismatch_kw,
        spinning_reserve_kw: (mg).spinning_reserve_kw,
        operating_mode: (mg).operating_mode
    };
    return microgrid_evaluate_load_balance(next);
}
