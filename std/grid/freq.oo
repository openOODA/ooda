import "./freq_governor.oo";

pub fn shim_marker_freq_default() -> GridFrequency {
    return grid_frequency_default();
}

pub fn shim_marker_freq_is_stable() -> Bool {
    let f: GridFrequency = grid_frequency_default();
    return grid_frequency_is_stable(f);
}

pub fn shim_marker_freq_dev_pu() -> Float {
    let f: GridFrequency = grid_frequency_default();
    return grid_frequency_deviation_pu(f);
}

pub fn shim_marker_inertia_new() -> InertialResponse {
    return inertial_response_new(4.0, 1000.0, 20.0, 1.0);
}

pub fn shim_marker_gov_new() -> GovernorState {
    return governor_state_new(5.0, 0.036, 500.0, 50.0, 500.0);
}

pub fn shim_marker_ace_new() -> AreaControlError {
    return area_control_error_new(1, 25.0, 0.01);
}

pub fn shim_marker_ufls_new() -> UnderFrequencyLoadShedding {
    return ufls_new(59.3, 59.0, 58.7, 10.0, 15.0, 20.0);
}

pub fn shim_marker_freq_update(freq: GridFrequency, new_hz: Float, dt_sec: Float) -> GridFrequency {
    return grid_frequency_update(freq, new_hz, dt_sec);
}

pub fn __dummy_std_src_ooda_grid_freq_oo() -> Int {
    return 0;
}
