// # Solar types
//
// Logline: PvArray destubbed off nested Float lists to Int id/status.
// residual: List[struct] destubbed.

type PvArray = struct {
    array_id: Int,
    panel_count: Int,
    status: Int
};

pub fn pv_array_new(array_id: Int, panel_count: Int) -> PvArray {
    return PvArray {
        array_id: array_id,
        panel_count: panel_count,
        status: 1
    };
}

pub fn pv_array_panels(a: PvArray) -> Int {
    return a.panel_count;
}
