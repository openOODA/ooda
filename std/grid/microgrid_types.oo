// # Microgrid types
//
// Logline: MicrogridState destubbed off nested islanding lists.
// residual: List[struct] destubbed.

type MicrogridState = struct {
    islanded: Int,
    load_kw: Int
};

pub fn microgrid_state_new(islanded: Int, load_kw: Int) -> MicrogridState {
    return MicrogridState {
        islanded: islanded,
        load_kw: load_kw
    };
}

pub fn microgrid_state_load(s: MicrogridState) -> Int {
    return s.load_kw;
}
