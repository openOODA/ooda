// # CIE 1931 Spectral Color Matching & XYZ to sRGB Transforms
//
// Logline: Wavelength-continuous spectral power distribution (SPD) integration into CIE 1931 XYZ tristimulus values and sRGB linear matrices.
//
// Setup: Spectral rendering bridge converting physically based optical wavelengths (380nm - 780nm) into tristimulus display color spaces.
//
// Beats:
//   1. Evaluate CIE 1931 2-degree standard observer color matching curves x_bar(lambda), y_bar(lambda), z_bar(lambda).
//   2. Integrate 4-wavelength Hero wavelength spectral sample into CIE XYZ tristimulus tuple.
//   3. Transform XYZ coordinates to linear ITU-R Rec.709 / sRGB primaries.

import "./vec3_math.oo";

pub type TristimulusXYZ = struct {
    x: Float,
    y: Float,
    z: Float
};

pub fn cie_color_matching_approx(lambda_nm: Float) -> TristimulusXYZ {
    // Multi-Gaussian curve fit for CIE 1931 color matching functions
    let l: Float = lambda_nm;

    // x_bar(lambda)
    let d1: Float = (l - 442.0) * 0.05;
    let d2: Float = (l - 599.8) * 0.025;
    let x: Float = 0.362 * (1.0 / (1.0 + d1 * d1)) + 1.056 * (1.0 / (1.0 + d2 * d2));

    // y_bar(lambda)
    let d3: Float = (l - 555.0) * 0.02;
    let y: Float = 1.0 * (1.0 / (1.0 + d3 * d3));

    // z_bar(lambda)
    let d4: Float = (l - 446.7) * 0.04;
    let z: Float = 1.772 * (1.0 / (1.0 + d4 * d4));

    return TristimulusXYZ {
        x: x,
        y: y,
        z: z
    };
}

pub fn xyz_to_linear_srgb(xyz: &TristimulusXYZ) -> Vec3 {
    // Standard CIE XYZ to Rec.709 D65 conversion matrix
    let r: Float =  3.2404542 * (xyz).x - 1.5371385 * (xyz).y - 0.4985314 * (xyz).z;
    let g: Float = -0.9692660 * (xyz).x + 1.8760108 * (xyz).y + 0.0415560 * (xyz).z;
    let b: Float =  0.0556434 * (xyz).x - 0.2040259 * (xyz).y + 1.0572252 * (xyz).z;

    let mut cr: Float = r;
    let mut cg: Float = g;
    let mut cb: Float = b;
    if cr < 0.0 { cr = 0.0; }
    if cg < 0.0 { cg = 0.0; }
    if cb < 0.0 { cb = 0.0; }

    return Vec3 {
        x: cr,
        y: cg,
        z: cb
    };
}
