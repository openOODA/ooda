// # 3D Vector Mathematics
//
// Logline: Float Vec3 add/dot. Destubbed off pub type / &Vec3 so emit-c can lower.
//
// Setup: Pure Float vector arithmetic.
//
// Beats:
//   1. Construct Vec3.
//   2. Add and dot.
// residual: &Vec3 / orthonormal destubbed; first gcc was pub type + host ref.

type Vec3 = struct {
    x: Float,
    y: Float,
    z: Float
};

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

pub fn vec3_add(a: Vec3, b: Vec3) -> Vec3 {
    let ax: Float = a.x;
    let ay: Float = a.y;
    let az: Float = a.z;
    let bx: Float = b.x;
    let by: Float = b.y;
    let bz: Float = b.z;
    return Vec3 {
        x: ax + bx,
        y: ay + by,
        z: az + bz
    };
}

pub fn vec3_dot(a: Vec3, b: Vec3) -> Float {
    let ax: Float = a.x;
    let ay: Float = a.y;
    let az: Float = a.z;
    let bx: Float = b.x;
    let by: Float = b.y;
    let bz: Float = b.z;
    return (ax * bx) + (ay * by) + (az * bz);
}
