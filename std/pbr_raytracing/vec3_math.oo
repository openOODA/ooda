// # 3D Vector Mathematics
//
// Logline: Vector mathematics, orthonormal bases, and PBR math helpers.
//
// Setup: Pure Float vector arithmetic.
//
// Beats:
//   1. Construct Vec3.
//   2. Vector arithmetic, dot, scale, normalize, reflect, refract.
//   3. Orthonormal basis generation and math helper functions.

type Vec3 = struct {
    x: Float,
    y: Float,
    z: Float
};

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

pub fn vec3_zero() -> Vec3 {
    return Vec3 { x: 0.0, y: 0.0, z: 0.0 };
}

pub fn vec3_one() -> Vec3 {
    return Vec3 { x: 1.0, y: 1.0, z: 1.0 };
}

pub fn vec3_add(a: &Vec3, b: &Vec3) -> Vec3 {
    return Vec3 {
        x: (a).x + (b).x,
        y: (a).y + (b).y,
        z: (a).z + (b).z
    };
}

pub fn vec3_sub(a: &Vec3, b: &Vec3) -> Vec3 {
    return Vec3 {
        x: (a).x - (b).x,
        y: (a).y - (b).y,
        z: (a).z - (b).z
    };
}

pub fn vec3_scale(v: &Vec3, s: Float) -> Vec3 {
    return Vec3 {
        x: (v).x * s,
        y: (v).y * s,
        z: (v).z * s
    };
}

pub fn vec3_dot(a: &Vec3, b: &Vec3) -> Float {
    return ((a).x * (b).x) + ((a).y * (b).y) + ((a).z * (b).z);
}

pub fn vec3_length_sq(v: &Vec3) -> Float {
    return (((v).x * (v).x) + ((v).y * (v).y)) + ((v).z * (v).z);
}

pub fn vec3_length_squared(v: &Vec3) -> Float {
    return (((v).x * (v).x) + ((v).y * (v).y)) + ((v).z * (v).z);
}

pub fn vec3_length(v: &Vec3) -> Float {
    return sqrt(vec3_length_sq(v));
}

pub fn vec3_normalize(v: &Vec3) -> Vec3 {
    let l_sq: Float = vec3_length_sq(v);
    if l_sq < 0.0000000001 {
        return vec3_zero();
    }
    let inv_l: Float = 1.0 / sqrt(l_sq);
    return vec3_scale(v, inv_l);
}

pub fn vec3_reflect(v: &Vec3, n: &Vec3) -> Vec3 {
    let cos_theta: Float = vec3_dot(v, n);
    let n_scaled: Vec3 = vec3_scale(n, 2.0 * cos_theta);
    return vec3_sub(&n_scaled, v);
}

pub fn vec3_refract(v: &Vec3, n: &Vec3, eta: Float) -> Vec3 {
    let cos_i: Float = vec3_dot(v, n);
    let sin2_t: Float = eta * eta * (1.0 - cos_i * cos_i);
    if sin2_t > 1.0 {
        return vec3_zero();
    }
    let cos_t: Float = sqrt(1.0 - sin2_t);
    let term1: Vec3 = vec3_scale(v, 0.0 - eta);
    let term2: Vec3 = vec3_scale(n, (eta * cos_i) - cos_t);
    return vec3_add(&term1, &term2);
}

pub type OrthonormalBasis = struct {
    u: Vec3,
    v: Vec3,
    w: Vec3
};

pub fn orthonormal_basis_from_normal(n: &Vec3) -> OrthonormalBasis {
    let mut sign: Float = 1.0;
    if (n).z < 0.0 {
        sign = 0.0 - 1.0;
    }
    let a: Float = 0.0 - (1.0 / (sign + (n).z));
    let b: Float = (n).x * (n).y * a;
    let u: Vec3 = Vec3 { x: 1.0 + (sign * (n).x * (n).x * a), y: sign * b, z: 0.0 - (sign * (n).x) };
    let v: Vec3 = Vec3 { x: b, y: sign + ((n).y * (n).y * a), z: 0.0 - (n).y };
    return OrthonormalBasis { u: u, v: v, w: *n };
}

pub fn math_sqrt(v: Float) -> Float {
    return sqrt(v);
}

pub fn math_clamp(v: Float, min_val: Float, max_val: Float) -> Float {
    if v < min_val {
        return min_val;
    }
    if v > max_val {
        return max_val;
    }
    return v;
}

pub fn math_exp(v: Float) -> Float {
    return exp(v);
}

pub fn math_abs(v: Float) -> Float {
    if v < 0.0 {
        return 0.0 - v;
    }
    return v;
}
