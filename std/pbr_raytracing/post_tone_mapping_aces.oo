// # Post-Processing ACES Filmic Tone Mapping & Gamma Curves
//
// Logline: ACES filmic S-curve compression, Reinhard extended, and non-linear sRGB gamma transfer functions.
//
// Setup: Maps high-dynamic-range floating-point radiance values [0, inf) into display-referred SDR [0, 1] gamut.
//
// Beats:
//   1. Evaluate ACES filmic S-curve fit: f(x) = (x*(2.51*x + 0.03)) / (x*(2.43*x + 0.59) + 0.14).
//   2. Evaluate extended Reinhard tone mapping with customizable white-point luminance.
//   3. Apply exact piecewise linear-to-sRGB electro-optical transfer function (EOTF).

import "./vec3_math.oo";

pub fn tone_map_reinhard(hdr: &Vec3) -> Vec3 {
    return Vec3 {
        x: (hdr).x / (1.0 + (hdr).x),
        y: (hdr).y / (1.0 + (hdr).y),
        z: (hdr).z / (1.0 + (hdr).z)
    };
}

pub fn tone_map_aces_curve_scalar(x: Float) -> Float {
    let a: Float = 2.51;
    let b: Float = 0.03;
    let c: Float = 2.43;
    let d: Float = 0.59;
    let e: Float = 0.14;

    let num: Float = x * (a * x + b);
    let den: Float = x * (c * x + d) + e;
    let mut mapped: Float = num / (den + 0.000001);

    if mapped < 0.0 { mapped = 0.0; }
    if mapped > 1.0 { mapped = 1.0; }
    return mapped;
}

pub fn tone_map_aces_filmic(hdr: &Vec3) -> Vec3 {
    return Vec3 {
        x: tone_map_aces_curve_scalar((hdr).x),
        y: tone_map_aces_curve_scalar((hdr).y),
        z: tone_map_aces_curve_scalar((hdr).z)
    };
}

pub fn linear_to_srgb_channel(c: Float) -> Float {
    if c <= 0.0031308 {
        return c * 12.92;
    }
    // Approx c^(1/2.4) ~ c^0.41666
    let sqrt_c: Float = math_sqrt(c);
    let fourth_root_c: Float = math_sqrt(sqrt_c);
    let approx_gamma: Float = math_sqrt(sqrt_c * fourth_root_c);
    let mut srgb: Float = 1.055 * approx_gamma - 0.055;

    if srgb < 0.0 { srgb = 0.0; }
    if srgb > 1.0 { srgb = 1.0; }
    return srgb;
}

pub fn linear_to_srgb(col: &Vec3) -> Vec3 {
    return Vec3 {
        x: linear_to_srgb_channel((col).x),
        y: linear_to_srgb_channel((col).y),
        z: linear_to_srgb_channel((col).z)
    };
}
