// # Fresnel Equations & Schlick Approximation
//
// Logline: Evaluates dielectric and conductor Fresnel reflectance using exact equations and fast Schlick approximations.
//
// Setup: PBR reflectance models dictating how much light reflects versus transmits/absorbs as a function of incident angle.
//
// Beats:
//   1. Compute Schlick's scalar and RGB Fresnel approximations: F(theta) = F0 + (1 - F0) * (1 - cos_theta)^5.
//   2. Evaluate exact unpolarized dielectric Fresnel reflection for optical glass and water.
//   3. Compute complex Fresnel reflectance for conductive metals (gold, copper, aluminum) using refractive index n and extinction coefficient k.

import "./vec3_math.oo";

pub type ComplexIor = struct {
    eta: Vec3, // Real refractive index n (RGB)
    k: Vec3   // Extinction coefficient k (RGB)
};

pub fn fresnel_schlick_scalar(cos_theta: Float, f0: Float) -> Float {
    let mut ct: Float = cos_theta;
    if ct < 0.0 { ct = 0.0; }
    if ct > 1.0 { ct = 1.0; }
    let x: Float = 1.0 - ct;
    let x2: Float = x * x;
    let x5: Float = x2 * x2 * x;
    return f0 + (1.0 - f0) * x5;
}

pub fn fresnel_schlick_rgb(cos_theta: Float, f0: &Vec3) -> Vec3 {
    let mut ct: Float = cos_theta;
    if ct < 0.0 { ct = 0.0; }
    if ct > 1.0 { ct = 1.0; }
    let x: Float = 1.0 - ct;
    let x2: Float = x * x;
    let x5: Float = x2 * x2 * x;

    return Vec3 {
        x: (f0).x + (1.0 - (f0).x) * x5,
        y: (f0).y + (1.0 - (f0).y) * x5,
        z: (f0).z + (1.0 - (f0).z) * x5
    };
}

pub fn fresnel_schlick_roughness(cos_theta: Float, f0: &Vec3, roughness: Float) -> Vec3 {
    let mut ct: Float = cos_theta;
    if ct < 0.0 { ct = 0.0; }
    if ct > 1.0 { ct = 1.0; }
    let x: Float = 1.0 - ct;
    let x2: Float = x * x;
    let x5: Float = x2 * x2 * x;

    let f90: Float = 1.0 - roughness;
    let mut f90_clamped: Float = f90;
    if f90_clamped < (f0).x { f90_clamped = (f0).x; }

    return Vec3 {
        x: (f0).x + (f90_clamped - (f0).x) * x5,
        y: (f0).y + (f90_clamped - (f0).y) * x5,
        z: (f0).z + (f90_clamped - (f0).z) * x5
    };
}

pub fn fresnel_dielectric_exact(cos_theta_i: Float, eta_i: Float, eta_t: Float) -> Float {
    let mut c_i: Float = cos_theta_i;
    if c_i < 0.0 { c_i = 0.0; }
    if c_i > 1.0 { c_i = 1.0; }

    let eta: Float = eta_i / eta_t;
    let sin2_theta_t: Float = eta * eta * (1.0 - c_i * c_i);
    if sin2_theta_t >= 1.0 {
        return 1.0; // Total internal reflection
    }

    let c_t: Float = math_sqrt(1.0 - sin2_theta_t);
    let r_par: Float = ((eta_t * c_i) - (eta_i * c_t)) / ((eta_t * c_i) + (eta_i * c_t));
    let r_perp: Float = ((eta_i * c_i) - (eta_t * c_t)) / ((eta_i * c_i) + (eta_t * c_t));

    return (r_par * r_par + r_perp * r_perp) * 0.5;
}

pub fn fresnel_f0_from_ior(ior: Float) -> Float {
    let num: Float = ior - 1.0;
    let den: Float = ior + 1.0;
    let ratio: Float = num / den;
    return ratio * ratio;
}
