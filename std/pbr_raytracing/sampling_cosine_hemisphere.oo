// # Concentric Disk & Cosine-Weighted Hemisphere Sampling
//
// Logline: Low-distortion Shirley concentric disk mapping and cosine-weighted hemispherical vector generator.
//
// Setup: Generates directional vectors distributed proportionally to the projected solid angle d_omega * cos(theta).
//
// Beats:
//   1. Map uniform square [0,1]^2 to circular disk with minimal area distortion.
//   2. Lift 2D concentric disk point to 3D cosine-weighted hemisphere direction.
//   3. Provide uniform sphere, uniform cone, and uniform disk sampling helpers.

import "./vec3_math.oo";

pub type DiskSample = struct {
    x: Float,
    y: Float,
};

pub fn concentric_sample_disk(u1: Float, u2: Float) -> DiskSample {
    let mut sx: Float = 2.0 * u1 - 1.0;
    let mut sy: Float = 2.0 * u2 - 1.0;

    if sx == 0.0 && sy == 0.0 {
        return DiskSample { x: 0.0, y: 0.0 };
    }

    let mut r: Float = 0.0;
    let mut theta: Float = 0.0;
    let pi: Float = 3.1415926535;

    let abs_sx: Float = math_sqrt(sx * sx);
    let abs_sy: Float = math_sqrt(sy * sy);

    if abs_sx > abs_sy {
        r = sx;
        theta = (pi / 4.0) * (sy / sx);
    } else {
        r = sy;
        theta = (pi / 2.0) - (pi / 4.0) * (sx / sy);
    }

    let x: Float = r * (1.0 - 0.5 * theta * theta);
    let y: Float = r * theta;

    return DiskSample { x: x, y: y };
}

pub fn cosine_sample_hemisphere(n: &Vec3, u1: Float, u2: Float) -> Vec3 {
    let d: DiskSample = concentric_sample_disk(u1, u2);
    let r2: Float = d.x * d.x + d.y * d.y;
    let mut z: Float = 0.0;
    if r2 < 1.0 {
        z = math_sqrt(1.0 - r2);
    }

    let basis: OrthonormalBasis = orthonormal_basis_from_normal(n);
    let u_comp: Vec3 = vec3_scale(&basis.u, d.x);
    let v_comp: Vec3 = vec3_scale(&basis.v, d.y);
    let n_comp: Vec3 = vec3_scale(n, z);

    let res: Vec3 = vec3_add(&vec3_add(&u_comp, &v_comp), &n_comp);
    return vec3_normalize(&res);
}

pub fn uniform_sample_sphere(u1: Float, u2: Float) -> Vec3 {
    let z: Float = 1.0 - 2.0 * u1;
    let r: Float = math_sqrt(1.0 - z * z);
    let pi: Float = 3.1415926535;
    let phi: Float = 2.0 * pi * u2;

    let x: Float = r * (1.0 - 0.5 * (phi - pi) * (phi - pi));
    let y: Float = r * (phi - pi);

    return Vec3 { x: x, y: y, z: z };
}
