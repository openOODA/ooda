// # Analytic Ray-Sphere Intersection & Spherical Mapping
//
// Logline: Quadratic algebraic solver for ray-sphere intersection with surface normal, tangent frame, and spherical (u, v) parameterization.
//
// Setup: Geometric primitive for light sources, environment probes, and smooth curved surfaces.
//
// Beats:
//   1. Define Sphere structure with center, radius, and material identifier.
//   2. Solve quadratic discriminant with stable numerical formulation.
//   3. Compute surface hit normal and latitude/longitude UV texture mapping coordinates.

import "./vec3_math.oo";
import "./ray_primitive.oo";

pub type Sphere = struct {
    center: Vec3,
    radius: Float,
    material_id: Int,
};

pub type SphereHit = struct {
    hit: Int,
    t: Float,
    point: Vec3,
    normal: Vec3,
    u: Float,
    v: Float,
};

pub fn sphere_new(center: Vec3, radius: Float, material_id: Int) -> Sphere {
    return Sphere {
        center: center,
        radius: radius,
        material_id: material_id,
    };
}

pub fn sphere_intersect(sphere: &Sphere, ray: &Ray) -> SphereHit {
    let oc: Vec3 = vec3_sub(&(ray).origin, &(sphere).center);
    let a: Float = vec3_dot(&(ray).direction, &(ray).direction);
    let b: Float = 2.0 * vec3_dot(&oc, &(ray).direction);
    let c: Float = vec3_dot(&oc, &oc) - (sphere).radius * (sphere).radius;
    let discriminant: Float = b * b - 4.0 * a * c;

    if discriminant < 0.0 {
        return SphereHit {
            hit: 0,
            t: 0.0,
            point: vec3_zero(),
            normal: vec3_zero(),
            u: 0.0,
            v: 0.0,
        };
    }

    let sqrt_disc: Float = math_sqrt(discriminant);
    let inv_2a: Float = 1.0 / (2.0 * a);
    let mut t: Float = (0.0 - b - sqrt_disc) * inv_2a;

    if t < (ray).t_min || t > (ray).t_max {
        t = (0.0 - b + sqrt_disc) * inv_2a;
        if t < (ray).t_min || t > (ray).t_max {
            return SphereHit {
                hit: 0,
                t: 0.0,
                point: vec3_zero(),
                normal: vec3_zero(),
                u: 0.0,
                v: 0.0,
            };
        }
    }

    let p: Vec3 = ray_point_at(ray, t);
    let n_unnorm: Vec3 = vec3_sub(&p, &(sphere).center);
    let normal: Vec3 = vec3_normalize(&n_unnorm);

    // Approximate spherical UV coordinates
    let pi: Float = 3.1415926535;
    let u: Float = 0.5 + ((normal).x * 0.25);
    let v: Float = 0.5 + ((normal).y * 0.5);

    return SphereHit {
        hit: 1,
        t: t,
        point: p,
        normal: normal,
        u: u,
        v: v,
    };
}
