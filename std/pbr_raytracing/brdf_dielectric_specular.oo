// # Smooth Dielectric Specular BSDF (Reflection & Transmission)
//
// Logline: Dirac delta specular reflection and refraction for smooth dielectric boundaries (water, glass, diamonds).
//
// Setup: Exact Snell-Descartes refractive ray redirection with Fresnel power splitting.
//
// Beats:
//   1. Evaluate dielectric Fresnel reflectance and determine reflection vs refraction probability.
//   2. Compute ideal specular reflection vector: r = reflect(wo, n).
//   3. Compute refracted transmission ray vector: t = refract(wo, n, eta) with total internal reflection fallback.

import "./vec3_math.oo";
import "./brdf_fresnel_schlick.oo";

pub type DielectricParams = struct {
    ior_inside: Float,
    ior_outside: Float,
    attenuation_color: Vec3,
};

pub type SpecularSample = struct {
    wi: Vec3,
    pdf: Float,
    attenuation: Vec3,
    is_transmission: Int,
};

pub fn dielectric_new(ior_inside: Float, ior_outside: Float, color: Vec3) -> DielectricParams {
    return DielectricParams {
        ior_inside: ior_inside,
        ior_outside: ior_outside,
        attenuation_color: color,
    };
}

pub fn dielectric_sample(
    wo: &Vec3,
    n: &Vec3,
    params: &DielectricParams,
    u_choice: Float
) -> SpecularSample {
    let mut cos_theta_i: Float = vec3_dot(wo, n);
    let mut entering: Int = 1;
    let mut eta_i: Float = (params).ior_outside;
    let mut eta_t: Float = (params).ior_inside;
    let mut normal: Vec3 = *n;

    if cos_theta_i < 0.0 {
        entering = 0;
        eta_i = (params).ior_inside;
        eta_t = (params).ior_outside;
        normal = vec3_scale(n, -1.0);
        cos_theta_i = 0.0 - cos_theta_i;
    }

    let f: Float = fresnel_dielectric_exact(cos_theta_i, eta_i, eta_t);

    if u_choice < f {
        // Specular reflection
        let r: Vec3 = vec3_reflect(wo, &normal);
        return SpecularSample {
            wi: r,
            pdf: f,
            attenuation: (params).attenuation_color,
            is_transmission: 0,
        };
    } else {
        // Refractive transmission
        let eta: Float = eta_i / eta_t;
        let trans: Vec3 = vec3_refract(wo, &normal, eta);
        let trans_len_sq: Float = vec3_length_squared(&trans);

        if trans_len_sq <= 0.0001 {
            // Total internal reflection fallback
            let r: Vec3 = vec3_reflect(wo, &normal);
            return SpecularSample {
                wi: r,
                pdf: 1.0,
                attenuation: (params).attenuation_color,
                is_transmission: 0,
            };
        }

        return SpecularSample {
            wi: vec3_normalize(&trans),
            pdf: 1.0 - f,
            attenuation: (params).attenuation_color,
            is_transmission: 1,
        };
    }
}

pub fn brdf_dielectric_specular_probe() -> Int {
    return 0;
}
