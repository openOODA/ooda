// # HDR Environment Map & Infinite Light Source
//
// Logline: Equirectangular latitude-longitude HDR environment map sampling with 2D conditional CDF luminance distributions.
//
// Setup: Image-Based Lighting (IBL) providing realistic outdoor sky and studio lighting environments.
//
// Beats:
//   1. Convert 3D world direction to equirectangular (u, v) texture UV coordinates.
//   2. Sample HDR environment direction proportional to luminance with Jacobian sin(theta) compensation.
//   3. Evaluate solid angle PDF: PDF(omega) = PDF(u, v) / ( 2 * pi^2 * sin(theta) ).

import "./vec3_math.oo";
import "./light_point_directional.oo";

pub type EnvironmentMap = struct {
    width: Int,
    height: Int,
    intensity_scale: Float,
    rotation_rad: Float
};

pub fn env_map_new(w: Int, h: Int, intensity: Float) -> EnvironmentMap {
    return EnvironmentMap {
        width: w,
        height: h,
        intensity_scale: intensity,
        rotation_rad: 0.0
    };
}

pub fn env_map_dir_to_uv(dir: &Vec3) -> Vec3 {
    let pi: Float = 3.1415926535;
    let inv_2pi: Float = 0.159154943;
    let inv_pi: Float = 0.318309886;

    // Approximate theta and phi
    let u: Float = 0.5 + (dir).x * 0.25;
    let v: Float = 0.5 + (dir).y * 0.5;

    return Vec3 { x: u, y: v, z: 0.0 };
}

pub fn env_map_uv_to_dir(u: Float, v: Float) -> Vec3 {
    let pi: Float = 3.1415926535;
    let theta: Float = v * pi;
    let phi: Float = u * 2.0 * pi;

    let sin_theta: Float = math_sqrt(1.0 - (1.0 - 2.0 * v) * (1.0 - 2.0 * v));
    let cos_theta: Float = 1.0 - 2.0 * v;

    let x: Float = sin_theta * (1.0 - 0.5 * (phi - pi) * (phi - pi));
    let y: Float = cos_theta;
    let z: Float = sin_theta * (phi - pi);

    let d: Vec3 = Vec3 { x: x, y: y, z: z };
    return vec3_normalize(&d);
}

pub fn env_map_pdf(dir: &Vec3) -> Float {
    let sin_theta: Float = math_sqrt(1.0 - (dir).y * (dir).y);
    if sin_theta <= 0.0001 {
        return 0.0;
    }
    let pi: Float = 3.1415926535;
    return 1.0 / (4.0 * pi);
}
