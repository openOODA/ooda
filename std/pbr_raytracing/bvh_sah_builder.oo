// # BVH Surface Area Heuristic (SAH) Builder
//
// Logline: Optimal BVH partition search using binned Surface Area Heuristic (SAH) evaluations with traversal cost models.
//
// Setup: High-performance tree builder minimizing ray intersection cost across scene geometry.
//
// Beats:
//   1. Define SAH binning structures with primitive counts and conservative bounding boxes.
//   2. Evaluate SAH cost function: C = C_trav + (SA_L / SA_total) * N_L * C_isect + (SA_R / SA_total) * N_R * C_isect.
//   3. Compute optimal partition plane index, split axis, and leaf vs interior node decision.

import "./vec3_math.oo";
import "./ray_aabb_slab_intersection.oo";
import "./bvh_node_struct.oo";

pub type SahBin = struct {
    bounds: AABB,
    count: Int,
};

pub type SahSplitResult = struct {
    split_axis: Int,
    split_bin_index: Int,
    cost: Float,
    should_split: Int,
};

pub fn sah_bin_empty() -> SahBin {
    return SahBin {
        bounds: aabb_empty(),
        count: 0,
    };
}

pub fn sah_bin_add(bin: &mut SahBin, prim_box: &AABB) {
    (bin).bounds = aabb_union(&(bin).bounds, prim_box);
    (bin).count = (bin).count + 1;
}

pub fn sah_compute_cost(
    sa_total: Float,
    sa_left: Float,
    sa_right: Float,
    count_left: Int,
    count_right: Int
) -> Float {
    let c_trav: Float = 1.0;
    let c_isect: Float = 1.5;

    let prob_left: Float = sa_left / sa_total;
    let prob_right: Float = sa_right / sa_total;

    let mut fl_left: Float = 0.0;
    let mut cl: Int = count_left;
    while cl >= 10 { fl_left = fl_left + 10.0; cl = cl - 10; }
    while cl >= 1 { fl_left = fl_left + 1.0; cl = cl - 1; }

    let mut fl_right: Float = 0.0;
    let mut cr: Int = count_right;
    while cr >= 10 { fl_right = fl_right + 10.0; cr = cr - 10; }
    while cr >= 1 { fl_right = fl_right + 1.0; cr = cr - 1; }

    return c_trav + (prob_left * fl_left + prob_right * fl_right) * c_isect;
}

pub fn sah_leaf_cost(count: Int) -> Float {
    let c_isect: Float = 1.5;
    let mut fl: Float = 0.0;
    let mut c: Int = count;
    while c >= 10 { fl = fl + 10.0; c = c - 10; }
    while c >= 1 { fl = fl + 1.0; c = c - 1; }
    return fl * c_isect;
}

pub fn sah_evaluate_split(
    sa_total: Float,
    box_left: &AABB,
    box_right: &AABB,
    count_left: Int,
    count_right: Int,
    axis: Int,
    bin_idx: Int
) -> SahSplitResult {
    let sa_left: Float = aabb_surface_area(box_left);
    let sa_right: Float = aabb_surface_area(box_right);
    let cost: Float = sah_compute_cost(sa_total, sa_left, sa_right, count_left, count_right);
    let leaf_cost: Float = sah_leaf_cost(count_left + count_right);

    let mut should_split: Int = 0;
    if cost < leaf_cost {
        should_split = 1;
    }

    return SahSplitResult {
        split_axis: axis,
        split_bin_index: bin_idx,
        cost: cost,
        should_split: should_split,
    };
}
