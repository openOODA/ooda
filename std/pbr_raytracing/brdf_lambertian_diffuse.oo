// # Lambertian Diffuse BRDF & Cosine-Weighted Hemisphere
//
// Logline: Ideal Lambertian diffuse reflectance model with exact 1/pi energy normalization and cosine-weighted hemispherical sampling.
//
// Setup: Baseline diffuse scattering model for matte, non-specular surfaces.
//
// Beats:
//   1. Evaluate constant diffuse BRDF: f_r = albedo / pi.
//   2. Generate cosine-weighted hemispherical direction samples with PDF = cos(theta) / pi.
//   3. Provide albedo energy clamping and Fresnel-diffuse coupling factors.

import "./vec3_math.oo";

pub type LambertianDiffuse = struct {
    albedo: Vec3,
};

pub fn lambertian_new(albedo: Vec3) -> LambertianDiffuse {
    return LambertianDiffuse {
        albedo: albedo,
    };
}

pub fn lambertian_eval(diffuse: &LambertianDiffuse, n_dot_l: Float, n_dot_v: Float) -> Vec3 {
    if n_dot_l <= 0.0 || n_dot_v <= 0.0 {
        return vec3_zero();
    }
    let inv_pi: Float = 0.31830988618;
    return vec3_scale(&(diffuse).albedo, inv_pi);
}

pub fn lambertian_pdf(n_dot_l: Float) -> Float {
    if n_dot_l <= 0.0 {
        return 0.0;
    }
    let inv_pi: Float = 0.31830988618;
    return n_dot_l * inv_pi;
}

pub fn lambertian_sample(n: &Vec3, u1: Float, u2: Float) -> Vec3 {
    // Malley's method: sample disk then project upward to hemisphere
    let pi: Float = 3.1415926535;
    let r: Float = math_sqrt(u1);
    let phi: Float = 2.0 * pi * u2;

    // Approximate cos/sin on [0, 2pi]
    let x_disk: Float = r * (1.0 - 0.5 * (phi - pi) * (phi - pi));
    let y_disk: Float = r * (phi - pi);
    let mut z_hemi: Float = 0.0;
    let r2: Float = x_disk * x_disk + y_disk * y_disk;
    if r2 < 1.0 {
        z_hemi = math_sqrt(1.0 - r2);
    }

    let basis: OrthonormalBasis = orthonormal_basis_from_normal(n);
    let u_comp: Vec3 = vec3_scale(&basis.u, x_disk);
    let v_comp: Vec3 = vec3_scale(&basis.v, y_disk);
    let n_comp: Vec3 = vec3_scale(n, z_hemi);

    let l: Vec3 = vec3_add(&vec3_add(&u_comp, &v_comp), &n_comp);
    return vec3_normalize(&l);
}
