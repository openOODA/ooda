// # GGX / Trowbridge-Reitz Normal Distribution Function & VNDF
//
// Logline: Evaluates GGX microfacet distribution D(h) and samples Visible Normal Distribution Functions (VNDF) for specular reflections.
//
// Setup: Statistical microfacet orientation distribution with heavy-tailed specular highlights and realistic grazing roughness.
//
// Beats:
//   1. Evaluate isotropic GGX NDF: D(h) = alpha^2 / ( pi * ( (n.h)^2 * (alpha^2 - 1) + 1 )^2 ).
//   2. Evaluate anisotropic GGX NDF with independent alpha_x, alpha_y along tangent/bitangent axes.
//   3. Implement visible normal distribution function (VNDF) sampling for importance-sampled half vectors.

import "./vec3_math.oo";

pub fn ggx_ndf_isotropic(n_dot_h: Float, alpha: Float) -> Float {
    if n_dot_h <= 0.0 {
        return 0.0;
    }
    let a2: Float = alpha * alpha;
    let nh2: Float = n_dot_h * n_dot_h;
    let d: Float = nh2 * (a2 - 1.0) + 1.0;
    let pi: Float = 3.1415926535;
    let denom: Float = pi * d * d;
    if denom <= 0.000001 {
        return 0.0;
    }
    return a2 / denom;
}

pub fn ggx_ndf_anisotropic(h_local: &Vec3, alpha_x: Float, alpha_y: Float) -> Float {
    let hz: Float = (h_local).z;
    if hz <= 0.0 {
        return 0.0;
    }
    let hx: Float = (h_local).x;
    let hy: Float = (h_local).y;

    let term_x: Float = (hx / alpha_x) * (hx / alpha_x);
    let term_y: Float = (hy / alpha_y) * (hy / alpha_y);
    let term_z: Float = hz * hz;

    let sum: Float = term_x + term_y + term_z;
    let pi: Float = 3.1415926535;
    let denom: Float = pi * alpha_x * alpha_y * sum * sum;
    if denom <= 0.000001 {
        return 0.0;
    }
    return 1.0 / denom;
}

pub fn ggx_sample_vndf_hemisphere(v_local: &Vec3, alpha: Float, u1: Float, u2: Float) -> Vec3 {
    // Transform view vector to un-stretched hemisphere space
    let v_h: Vec3 = vec3_normalize(&Vec3 {
        x: alpha * (v_local).x,
        y: alpha * (v_local).y,
        z: (v_local).z,
    });

    // Generate orthonormal basis around v_h
    let basis: OrthonormalBasis = orthonormal_basis_from_normal(&v_h);

    // Sample unit disk
    let pi: Float = 3.1415926535;
    let r: Float = math_sqrt(u1);
    let phi: Float = 2.0 * pi * u2;
    // Approximating cos and sin of phi for sample
    let p1: Float = r * (1.0 - 0.5 * (phi - pi) * (phi - pi));
    let p2: Float = r * (phi - pi);

    let mut h_proj: Vec3 = vec3_add(&vec3_scale(&basis.u, p1), &vec3_scale(&basis.v, p2));
    let len_sq: Float = vec3_length_squared(&h_proj);
    let mut hz: Float = 0.0;
    if len_sq < 1.0 {
        hz = math_sqrt(1.0 - len_sq);
    }
    let h_hemi: Vec3 = vec3_add(&h_proj, &vec3_scale(&v_h, hz));

    // Un-stretch half vector and normalize
    let h_local: Vec3 = vec3_normalize(&Vec3 {
        x: alpha * (h_hemi).x,
        y: alpha * (h_hemi).y,
        z: (h_hemi).z,
    });

    return h_local;
}

pub fn ggx_pdf(n_dot_h: Float, n_dot_v: Float, alpha: Float) -> Float {
    if n_dot_v <= 0.0 || n_dot_h <= 0.0 {
        return 0.0;
    }
    let d: Float = ggx_ndf_isotropic(n_dot_h, alpha);
    return (d * n_dot_h) / (4.0 * n_dot_v);
}
