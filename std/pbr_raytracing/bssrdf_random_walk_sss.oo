// # Subsurface Random Walk Scattering Estimator
//
// Logline: Unbiased Monte Carlo random walk subsurface transport estimator replacing diffusion approximations for complex geometries.
//
// Setup: Traces photons through scattering collisions inside heterogeneous or arbitrary boundary meshes.
//
// Beats:
//   1. Sample free flight step distance: d = -ln(1 - u) / sigma_t.
//   2. Sample scattering direction from Henyey-Greenstein phase function.
//   3. Accumulate absorption weight throughput: weight *= sigma_s / sigma_t until surface exit or termination.

import "./vec3_math.oo";

pub type RandomWalkState = struct {
    pos: Vec3,
    dir: Vec3,
    throughput: Vec3,
    walk_steps: Int,
    is_terminated: Int
};

pub fn random_walk_init(p: Vec3, dir: Vec3) -> RandomWalkState {
    return RandomWalkState {
        pos: p,
        dir: dir,
        throughput: vec3_one(),
        walk_steps: 0,
        is_terminated: 0
    };
}

pub fn random_walk_sample_step_dist(sigma_t: Float, u: Float) -> Float {
    if sigma_t <= 0.0001 {
        return 1000.0;
    }
    let mut u_clamped: Float = u;
    if u_clamped >= 0.9999 {
        u_clamped = 0.9999;
    }
    // Approximating -ln(1 - u) ~ u + u^2/2 + u^3/3
    let log_inv: Float = u_clamped + 0.5 * u_clamped * u_clamped + 0.3333 * u_clamped * u_clamped * u_clamped;
    return log_inv / sigma_t;
}

pub fn random_walk_step(
    state: &mut RandomWalkState,
    step_dist: Float,
    new_dir: Vec3,
    albedo: &Vec3
) {
    let forward: Vec3 = vec3_scale(&(state).dir, step_dist);
    (state).pos = vec3_add(&(state).pos, &forward);
    (state).dir = new_dir;
    (state).throughput = vec3_mul(&(state).throughput, albedo);
    (state).walk_steps = (state).walk_steps + 1;

    // Check maximum steps
    if (state).walk_steps > 64 {
        (state).is_terminated = 1;
    }
}
