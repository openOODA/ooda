// # Smith Geometric Shadowing & Masking Functions
//
// Logline: Height-correlated and separable Smith shadowing-masking functions (G1, G2) for microfacet distributions.
//
// Setup: Accounts for self-shadowing and self-masking of microfacets from incident light and outgoing view angles.
//
// Beats:
//   1. Evaluate monodirectional Smith G1 masking factor for GGX distributions: G1(v) = 2(n.v) / ( (n.v) + sqrt(alpha^2 + (1-alpha^2)(n.v)^2) ).
//   2. Compute height-correlated Smith G2 joint visibility term: G2(l, v) = 0.5 / ( (n.l)*sqrt(alpha^2+(1-alpha^2)(n.v)^2) + (n.v)*sqrt(alpha^2+(1-alpha^2)(n.l)^2) ).
//   3. Provide anisotropic Smith shadowing factors with separate roughness parameters alpha_x and alpha_y.

import "./vec3_math.oo";

pub fn smith_g1_ggx(n_dot_v: Float, alpha: Float) -> Float {
    if n_dot_v <= 0.0 {
        return 0.0;
    }
    let a2: Float = alpha * alpha;
    let nv2: Float = n_dot_v * n_dot_v;
    let denom: Float = n_dot_v + math_sqrt(a2 + (1.0 - a2) * nv2);
    if denom <= 0.000001 {
        return 0.0;
    }
    return (2.0 * n_dot_v) / denom;
}

pub fn smith_g2_separable(n_dot_l: Float, n_dot_v: Float, alpha: Float) -> Float {
    let g1_l: Float = smith_g1_ggx(n_dot_l, alpha);
    let g1_v: Float = smith_g1_ggx(n_dot_v, alpha);
    return g1_l * g1_v;
}

pub fn smith_g2_height_correlated(n_dot_l: Float, n_dot_v: Float, alpha: Float) -> Float {
    if n_dot_l <= 0.0 || n_dot_v <= 0.0 {
        return 0.0;
    }
    let a2: Float = alpha * alpha;
    let lambda_v: Float = n_dot_l * math_sqrt(a2 + (1.0 - a2) * (n_dot_v * n_dot_v));
    let lambda_l: Float = n_dot_v * math_sqrt(a2 + (1.0 - a2) * (n_dot_l * n_dot_l));
    let denom: Float = lambda_v + lambda_l;
    if denom <= 0.000001 {
        return 0.0;
    }
    return (2.0 * n_dot_l * n_dot_v) / denom;
}

pub fn smith_g1_anisotropic(
    v_local: &Vec3,
    alpha_x: Float,
    alpha_y: Float
) -> Float {
    let vz: Float = (v_local).z;
    if vz <= 0.0 {
        return 0.0;
    }
    let vx: Float = (v_local).x;
    let vy: Float = (v_local).y;

    let len: Float = math_sqrt((alpha_x * vx) * (alpha_x * vx) + (alpha_y * vy) * (alpha_y * vy) + vz * vz);
    return (2.0 * vz) / (vz + len);
}
