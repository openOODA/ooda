// # Edge-Preserving Joint Bilateral Denoiser
//
// Logline: Multi-feature cross-bilateral filter weighting spatial distance, color luminance, depth differences, and normal alignment.
//
// Setup: Image-space post-processing denoiser filtering Monte Carlo noise while preserving sharp geometric edges.
//
// Beats:
//   1. Define BilateralWeights with spatial sigma, range sigma, normal threshold, and depth tolerance.
//   2. Compute joint weight: w = w_spatial * w_color * w_normal * w_depth.
//   3. Accumulate weighted radiance neighbor samples and normalize by total weight sum.

import "./vec3_math.oo";

pub type BilateralFilterParams = struct {
    sigma_spatial: Float,
    sigma_color: Float,
    sigma_depth: Float,
    normal_power: Float,
};

pub fn bilateral_params_default() -> BilateralFilterParams {
    return BilateralFilterParams {
        sigma_spatial: 3.0,
        sigma_color: 0.1,
        sigma_depth: 0.05,
        normal_power: 32.0,
    };
}

pub fn bilateral_compute_weight(
    p_center: &Vec3,
    n_center: &Vec3,
    d_center: Float,
    c_center: &Vec3,
    p_sample: &Vec3,
    n_sample: &Vec3,
    d_sample: Float,
    c_sample: &Vec3,
    params: &BilateralFilterParams
) -> Float {
    // Spatial distance
    let dist_spatial_sq: Float = vec3_length_squared(&vec3_sub(p_center, p_sample));
    let w_spatial: Float = 1.0 / (1.0 + dist_spatial_sq / ((params).sigma_spatial * (params).sigma_spatial));

    // Color difference
    let dist_color_sq: Float = vec3_length_squared(&vec3_sub(c_center, c_sample));
    let w_color: Float = 1.0 / (1.0 + dist_color_sq / ((params).sigma_color * (params).sigma_color));

    // Depth difference
    let diff_depth: Float = d_center - d_sample;
    let dist_depth_sq: Float = diff_depth * diff_depth;
    let w_depth: Float = 1.0 / (1.0 + dist_depth_sq / ((params).sigma_depth * (params).sigma_depth));

    // Normal alignment
    let mut n_dot: Float = vec3_dot(n_center, n_sample);
    if n_dot < 0.0 { n_dot = 0.0; }
    let mut w_normal: Float = n_dot * n_dot;
    w_normal = w_normal * w_normal; // ~ ^4

    return w_spatial * w_color * w_depth * w_normal;
}
