// # Next Event Estimation (NEE) Direct Light Sampling
//
// Logline: Direct lighting integrator estimating one-bounce light arrival using shadow rays and BSDF evaluation.
//
// Setup: Bridges light emitter sampling and BSDF evaluation with occluded shadow ray queries.
//
// Beats:
//   1. Generate shadow ray toward sampled light source with bias offset.
//   2. Evaluate surface BSDF f_r(wi, wo) and geometric foreshortening factor cos(theta).
//   3. Compute direct lighting radiance contribution: L_dir = (f_r * L_e * cos_theta) / pdf_light.

import "./vec3_math.oo";
import "./ray_primitive.oo";
import "./surface_interaction.oo";
import "./light_point_directional.oo";

pub type DirectLightResult = struct {
    radiance: Vec3,
    shadow_ray: Ray,
    is_valid: Int,
};

pub fn nee_compute_direct_contribution(
    isect: &SurfaceInteraction,
    sample: &LightSample,
    bsdf_val: &Vec3
) -> DirectLightResult {
    if (sample).pdf <= 0.000001 {
        return DirectLightResult {
            radiance: vec3_zero(),
            shadow_ray: ray_new(vec3_zero(), vec3_zero()),
            is_valid: 0,
        };
    }

    let cos_theta: Float = vec3_dot(&(isect).n_shade, &(sample).wi);
    if cos_theta <= 0.0 {
        return DirectLightResult {
            radiance: vec3_zero(),
            shadow_ray: ray_new(vec3_zero(), vec3_zero()),
            is_valid: 0,
        };
    }

    // Shadow ray from offset hit point
    let shadow_orig: Vec3 = ray_offset_origin(&(isect).p, &(isect).n_shade, &(sample).wi);
    let shadow_ray: Ray = ray_with_range(shadow_orig, (sample).wi, 0.0001, (sample).dist - 0.0002);

    let brdf_cos: Vec3 = vec3_scale(bsdf_val, cos_theta);
    let unweighted_rad: Vec3 = vec3_mul(&(sample).radiance, &brdf_cos);
    let rad: Vec3 = vec3_scale(&unweighted_rad, 1.0 / (sample).pdf);

    return DirectLightResult {
        radiance: rad,
        shadow_ray: shadow_ray,
        is_valid: 1,
    };
}

pub fn pathtrace_next_event_estimation_probe() -> Int {
    return 0;
}
