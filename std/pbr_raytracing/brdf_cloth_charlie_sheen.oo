// # Charlie Sheen & Micro-Fiber Cloth BRDF
//
// Logline: Charlie sheen distribution and Ashikhmin-Velvet micro-fiber scattering for velvet, silk, cotton, and woven fabrics.
//
// Setup: Specialized cloth shading model reproducing soft forward and retro-reflective edge sheen from cloth micro-fibers.
//
// Beats:
//   1. Evaluate Charlie normal distribution: D_Charlie(h) = (2 + 1/roughness) * sin(theta_h)^(1/roughness) / (2 * pi).
//   2. Compute Ashikhmin cloth shadowing-masking visibility factor.
//   3. Blend micro-fiber sheen with underlying diffuse textile substrate.

import "./vec3_math.oo";

pub type ClothParams = struct {
    sheen_color: Vec3,
    sheen_roughness: Float,
    diffuse_color: Vec3
};

pub fn cloth_params_default() -> ClothParams {
    return ClothParams {
        sheen_color: vec3_new(1.0, 1.0, 1.0),
        sheen_roughness: 0.3,
        diffuse_color: vec3_new(0.4, 0.1, 0.1)
    };
}

pub fn charlie_distribution(n_dot_h: Float, roughness: Float) -> Float {
    if n_dot_h <= 0.0 {
        return 0.0;
    }
    let sin2_h: Float = 1.0 - n_dot_h * n_dot_h;
    if sin2_h <= 0.0 {
        return 0.0;
    }
    let sin_h: Float = math_sqrt(sin2_h);

    let inv_r: Float = 1.0 / (roughness + 0.0001);
    // Approximate sin_h^inv_r
    let mut factor: Float = sin_h;
    if inv_r > 2.0 {
        factor = factor * factor;
    }
    if inv_r > 4.0 {
        factor = factor * factor;
    }

    let pi: Float = 3.1415926535;
    return (2.0 + inv_r) * factor / (2.0 * pi);
}

pub fn cloth_eval(
    l: &Vec3,
    v: &Vec3,
    n: &Vec3,
    params: &ClothParams
) -> Vec3 {
    let n_dot_l: Float = vec3_dot(n, l);
    let n_dot_v: Float = vec3_dot(n, v);

    if n_dot_l <= 0.0 || n_dot_v <= 0.0 {
        return vec3_zero();
    }

    let h_unnorm: Vec3 = vec3_add(l, v);
    let h: Vec3 = vec3_normalize(&h_unnorm);
    let n_dot_h: Float = vec3_dot(n, &h);

    let d_charlie: Float = charlie_distribution(n_dot_h, (params).sheen_roughness);
    let vis: Float = 1.0 / (4.0 * (n_dot_l + n_dot_v - n_dot_l * n_dot_v) + 0.0001);

    let sheen_term: Float = d_charlie * vis;
    let sheen: Vec3 = vec3_scale(&(params).sheen_color, sheen_term);

    let inv_pi: Float = 0.31830988618;
    let diff: Vec3 = vec3_scale(&(params).diffuse_color, inv_pi);

    return vec3_add(&diff, &sheen);
}
