// # Cook-Torrance Microfacet Specular BRDF
//
// Logline: Evaluates the physically based Cook-Torrance microfacet BRDF model combining D (GGX), F (Schlick), and G (Smith).
//
// Setup: Core specular reflectance equation: f_r(l, v) = ( D(h) * F(v, h) * G(l, v) ) / ( 4 * (n.l) * (n.v) ).
//
// Beats:
//   1. Evaluate unpolarized microfacet specular BRDF for given incident (l) and outgoing (v) directions.
//   2. Integrate half-vector h = normalize(l + v) with grazing-angle stabilization and energy conservation.
//   3. Compute joint PDF and importance sampled reflected ray directions.

import "./vec3_math.oo";
import "./brdf_fresnel_schlick.oo";
import "./brdf_smith_shadowing_masking.oo";
import "./brdf_ggx_distribution.oo";

pub type CookTorranceParams = struct {
    roughness: Float,
    f0: Vec3,
};

pub fn cook_torrance_eval(
    l: &Vec3,
    v: &Vec3,
    n: &Vec3,
    params: &CookTorranceParams
) -> Vec3 {
    let n_dot_l: Float = vec3_dot(n, l);
    let n_dot_v: Float = vec3_dot(n, v);

    if n_dot_l <= 0.0 || n_dot_v <= 0.0 {
        return vec3_zero();
    }

    let h_unnorm: Vec3 = vec3_add(l, v);
    let h: Vec3 = vec3_normalize(&h_unnorm);

    let n_dot_h: Float = vec3_dot(n, &h);
    let v_dot_h: Float = vec3_dot(v, &h);

    if n_dot_h <= 0.0 || v_dot_h <= 0.0 {
        return vec3_zero();
    }

    let mut alpha: Float = (params).roughness * (params).roughness;
    if alpha < 0.001 {
        alpha = 0.001; // Clamp minimum roughness to prevent singularities
    }

    let d: Float = ggx_ndf_isotropic(n_dot_h, alpha);
    let g: Float = smith_g2_height_correlated(n_dot_l, n_dot_v, alpha);
    let f: Vec3 = fresnel_schlick_rgb(v_dot_h, &(params).f0);

    let denom: Float = 4.0 * n_dot_l * n_dot_v;
    if denom <= 0.000001 {
        return vec3_zero();
    }

    let factor: Float = (d * g) / denom;
    return vec3_scale(&f, factor);
}

pub fn cook_torrance_sample(
    v_local: &Vec3,
    params: &CookTorranceParams,
    u1: Float,
    u2: Float
) -> Vec3 {
    let alpha: Float = (params).roughness * (params).roughness;
    let h_local: Vec3 = ggx_sample_vndf_hemisphere(v_local, alpha, u1, u2);
    // Reflect v_local around h_local
    return vec3_reflect(v_local, &h_local);
}

pub fn brdf_cook_torrance_ggx_probe() -> Int {
    return 0;
}
