// # Dipole Subsurface Scattering BSSRDF Model
//
// Logline: Multi-dipole diffusion profile approximation for Bidirectional Scattering Surface Reflectance Distribution Functions (BSSRDF).
//
// Setup: Simulates light penetrating into translucent materials (skin, marble, milk, jade) and exiting at distant surface points.
//
// Beats:
//   1. Define BssrdfParameters with reduced scattering sigma_s_prime, absorption sigma_a, and mean free path.
//   2. Compute real and virtual dipole source depths (z_r, z_v) matching boundary extrapolation.
//   3. Evaluate radial diffusion profile R(r) = (alpha_prime / (4*pi)) * ( z_r*(1+sigma_tr*d_r)*e^(-sigma_tr*d_r)/d_r^3 + ... ).

import "./vec3_math.oo";

pub type BssrdfParams = struct {
    sigma_s: Vec3,      // Scattering coefficient
    sigma_a: Vec3,      // Absorption coefficient
    g: Float,           // Anisotropy factor
    eta: Float         // Index of refraction
};

pub fn bssrdf_reduced_scattering(sigma_s: Float, g: Float) -> Float {
    return sigma_s * (1.0 - g);
}

pub fn bssrdf_effective_transport(sigma_a: Float, sigma_s_prime: Float) -> Float {
    let sigma_t_prime: Float = sigma_a + sigma_s_prime;
    return math_sqrt(3.0 * sigma_a * sigma_t_prime);
}

pub fn bssrdf_eval_dipole_single_channel(
    r: Float,
    sigma_a: Float,
    sigma_s: Float,
    g: Float,
    eta: Float
) -> Float {
    let sigma_s_prime: Float = bssrdf_reduced_scattering(sigma_s, g);
    let sigma_t_prime: Float = sigma_a + sigma_s_prime;
    if sigma_t_prime <= 0.0001 {
        return 0.0;
    }

    let alpha_prime: Float = sigma_s_prime / sigma_t_prime;
    let sigma_tr: Float = bssrdf_effective_transport(sigma_a, sigma_s_prime);

    // Mean free path
    let l_mfp: Float = 1.0 / sigma_t_prime;

    // Diffuse Fresnel boundary parameter A
    let fdr: Float = 0.0 - 1.440 / (eta * eta) + 0.710 / eta + 0.668 + 0.0636 * eta;
    let a_param: Float = (1.0 + fdr) / (1.0 - fdr + 0.0001);

    // Real and virtual source distances
    let z_r: Float = l_mfp;
    let z_v: Float = l_mfp * (1.0 + 4.0 * a_param * 0.333333);

    let d_r: Float = math_sqrt(r * r + z_r * z_r);
    let d_v: Float = math_sqrt(r * r + z_v * z_v);

    // Exponential approximations for e^(-x)
    let tr_dr: Float = sigma_tr * d_r;
    let tr_dv: Float = sigma_tr * d_v;

    let exp_r: Float = 1.0 / (1.0 + tr_dr + 0.5 * tr_dr * tr_dr);
    let exp_v: Float = 1.0 / (1.0 + tr_dv + 0.5 * tr_dv * tr_dv);

    let term_r: Float = z_r * (1.0 + tr_dr) * exp_r / (d_r * d_r * d_r + 0.000001);
    let term_v: Float = z_v * (1.0 + tr_dv) * exp_v / (d_v * d_v * d_v + 0.000001);

    let pi: Float = 3.1415926535;
    return (alpha_prime / (4.0 * pi)) * (term_r + term_v);
}

pub fn bssrdf_eval_rgb(params: &BssrdfParams, radius: Float) -> Vec3 {
    let r_red: Float = bssrdf_eval_dipole_single_channel(radius, (params).sigma_a.x, (params).sigma_s.x, (params).g, (params).eta);
    let r_green: Float = bssrdf_eval_dipole_single_channel(radius, (params).sigma_a.y, (params).sigma_s.y, (params).g, (params).eta);
    let r_blue: Float = bssrdf_eval_dipole_single_channel(radius, (params).sigma_a.z, (params).sigma_s.z, (params).g, (params).eta);

    return Vec3 {
        x: r_red,
        y: r_green,
        z: r_blue
    };
}
