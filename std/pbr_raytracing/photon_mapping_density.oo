// # Photon Mapping & Radiance Density Estimation
//
// Logline: Photon map query and kernel density estimation for sharp caustic rendering and global diffuse illumination.
//
// Setup: Two-pass global illumination algorithm storing emitted light photons in a spatial search structure.
//
// Beats:
//   1. Define Photon struct with 3D hit position, power flux Delta Phi, and incident direction wi.
//   2. Evaluate Epanechnikov and cone kernel weighting functions: K(r, R) = (1 - r/R).
//   3. Compute reflected radiance from N nearest photons: L_r = sum( f_r * Delta Phi_p * K(r_p) ) / ( pi * R^2 ).

import "./vec3_math.oo";

pub type Photon = struct {
    position: Vec3,
    power: Vec3, // RGB flux in Watts
    wi: Vec3
};

pub fn photon_new(pos: Vec3, power: Vec3, wi: Vec3) -> Photon {
    return Photon {
        position: pos,
        power: power,
        wi: wi
    };
}

pub fn photon_cone_kernel(dist: Float, max_radius: Float, k_filter: Float) -> Float {
    if dist >= max_radius || max_radius <= 0.0001 {
        return 0.0;
    }
    let factor: Float = 1.0 - (dist / (k_filter * max_radius));
    if factor < 0.0 {
        return 0.0;
    }
    let norm: Float = 1.0 - 2.0 / (3.0 * k_filter);
    return factor / norm;
}

pub fn photon_density_estimate_single(
    photon: &Photon,
    surf_point: &Vec3,
    max_radius: Float,
    bsdf_val: &Vec3
) -> Vec3 {
    let dist_sq: Float = vec3_length_squared(&vec3_sub(&(photon).position, surf_point));
    let r2: Float = max_radius * max_radius;
    if dist_sq >= r2 || r2 <= 0.0001 {
        return vec3_zero();
    }

    let dist: Float = math_sqrt(dist_sq);
    let weight: Float = photon_cone_kernel(dist, max_radius, 1.1);

    let flux_bsdf: Vec3 = vec3_mul(&(photon).power, bsdf_val);
    let pi: Float = 3.1415926535;
    let inv_area: Float = 1.0 / (pi * r2);

    return vec3_scale(&flux_bsdf, weight * inv_area);
}
