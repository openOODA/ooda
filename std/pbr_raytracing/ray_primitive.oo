// # Ray Primitives & Ray Differentials
//
// Logline: Defines 3D geometric rays with clipping intervals, time stamps, and auxiliary footprint differentials for texture filtering.
//
// Setup: Core transport rays traversing acceleration hierarchies and sampling light paths.
//
// Beats:
//   1. Define parametric Ray structure with origin, direction, t_min, t_max bounds, and medium ID.
//   2. Provide point-at-distance evaluation and shadow acne prevention offset routines.
//   3. Implement RayDifferential structures for camera ray texture mipmap footprint calculation.

import "./vec3_math.oo";

pub type Ray = struct {
    origin: Vec3,
    direction: Vec3,
    t_min: Float,
    t_max: Float,
    time: Float,
    medium_id: Int,
};

pub type RayDifferential = struct {
    ray: Ray,
    has_differentials: Int,
    rx_origin: Vec3,
    ry_origin: Vec3,
    rx_direction: Vec3,
    ry_direction: Vec3,
};

pub fn ray_new(origin: Vec3, direction: Vec3) -> Ray {
    return Ray {
        origin: origin,
        direction: direction,
        t_min: 0.0001,
        t_max: 1000000.0,
        time: 0.0,
        medium_id: 0,
    };
}

pub fn ray_with_range(origin: Vec3, direction: Vec3, t_min: Float, t_max: Float) -> Ray {
    return Ray {
        origin: origin,
        direction: direction,
        t_min: t_min,
        t_max: t_max,
        time: 0.0,
        medium_id: 0,
    };
}

pub fn ray_point_at(ray: &Ray, t: Float) -> Vec3 {
    let scaled_dir: Vec3 = vec3_scale(&(ray).direction, t);
    return vec3_add(&(ray).origin, &scaled_dir);
}

pub fn ray_offset_origin(p: &Vec3, normal: &Vec3, outgoing: &Vec3) -> Vec3 {
    let sign: Float = vec3_dot(outgoing, normal);
    let mut offset_dir: Vec3 = *normal;
    if sign < 0.0 {
        offset_dir = vec3_scale(normal, -1.0);
    }
    let offset: Vec3 = vec3_scale(&offset_dir, 0.0002);
    return vec3_add(p, &offset);
}

pub fn ray_differential_new(ray: Ray) -> RayDifferential {
    return RayDifferential {
        ray: ray,
        has_differentials: 0,
        rx_origin: vec3_zero(),
        ry_origin: vec3_zero(),
        rx_direction: vec3_zero(),
        ry_direction: vec3_zero(),
    };
}

pub fn ray_differential_scale(diff: &mut RayDifferential, s: Float) {
    let r_orig: Vec3 = (diff).ray.origin;
    let r_dir: Vec3 = (diff).ray.direction;
    let rx_o_diff: Vec3 = vec3_scale(&vec3_sub(&(diff).rx_origin, &r_orig), s);
    let ry_o_diff: Vec3 = vec3_scale(&vec3_sub(&(diff).ry_origin, &r_orig), s);
    let rx_d_diff: Vec3 = vec3_scale(&vec3_sub(&(diff).rx_direction, &r_dir), s);
    let ry_d_diff: Vec3 = vec3_scale(&vec3_sub(&(diff).ry_direction, &r_dir), s);

    (diff).rx_origin = vec3_add(&r_orig, &rx_o_diff);
    (diff).ry_origin = vec3_add(&r_orig, &ry_o_diff);
    (diff).rx_direction = vec3_add(&r_dir, &rx_d_diff);
    (diff).ry_direction = vec3_add(&r_dir, &ry_d_diff);
}

pub fn ray_primitive_probe() -> Int {
    return 0;
}
