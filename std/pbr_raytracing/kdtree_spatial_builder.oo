// # Spatial KD-Tree Split Cost & Traversal
//
// Logline: Spatial kd-tree plane split evaluation and ray-clipping interval traversal for non-overlapping spatial partitioning.
//
// Setup: Alternative spatial subdivision acceleration structure with zero duplicate primitive references per leaf.
//
// Beats:
//   1. Define KdTreeNode and KdTreeSplitPlane structures.
//   2. Compute spatial split plane surface area heuristic cost with empty cell bonus.
//   3. Implement ray segment clipping against kd-tree splitting planes.

import "./vec3_math.oo";
import "./ray_primitive.oo";
import "./ray_aabb_slab_intersection.oo";

pub type KdTreeSplitPlane = struct {
    axis: Int,
    split_pos: Float,
    cost: Float,
};

pub type KdTreeNode = struct {
    split_pos: Float,
    flags_and_axis: Int, // 0=X, 1=Y, 2=Z, 3=Leaf
    child_or_prim_offset: Int,
    primitive_count: Int,
};

pub fn kdtree_node_leaf(offset: Int, count: Int) -> KdTreeNode {
    return KdTreeNode {
        split_pos: 0.0,
        flags_and_axis: 3,
        child_or_prim_offset: offset,
        primitive_count: count,
    };
}

pub fn kdtree_node_interior(axis: Int, split_pos: Float, right_child_idx: Int) -> KdTreeNode {
    return KdTreeNode {
        split_pos: split_pos,
        flags_and_axis: axis,
        child_or_prim_offset: right_child_idx,
        primitive_count: 0,
    };
}

pub fn kdtree_evaluate_split_cost(
    bounds: &AABB,
    axis: Int,
    split_pos: Float,
    n_below: Int,
    n_above: Int
) -> Float {
    let total_sa: Float = aabb_surface_area(bounds);
    if total_sa <= 0.0 {
        return 1000000.0;
    }

    let mut b_below: AABB = *bounds;
    let mut b_above: AABB = *bounds;

    if axis == 0 {
        b_below.max_pt.x = split_pos;
        b_above.min_pt.x = split_pos;
    } else {
        if axis == 1 {
            b_below.max_pt.y = split_pos;
            b_above.min_pt.y = split_pos;
        } else {
            b_below.max_pt.z = split_pos;
            b_above.min_pt.z = split_pos;
        }
    }

    let sa_below: Float = aabb_surface_area(&b_below);
    let sa_above: Float = aabb_surface_area(&b_above);

    let p_below: Float = sa_below / total_sa;
    let p_above: Float = sa_above / total_sa;

    let mut f_below: Float = 0.0;
    let mut cb: Int = n_below;
    while cb >= 10 { f_below = f_below + 10.0; cb = cb - 10; }
    while cb >= 1 { f_below = f_below + 1.0; cb = cb - 1; }

    let mut f_above: Float = 0.0;
    let mut ca: Int = n_above;
    while ca >= 10 { f_above = f_above + 10.0; ca = ca - 10; }
    while ca >= 1 { f_above = f_above + 1.0; ca = ca - 1; }

    let mut bonus: Float = 1.0;
    if n_below == 0 || n_above == 0 {
        bonus = 0.8; // Bonus for empty cells
    }

    return (1.0 + (p_below * f_below + p_above * f_above) * 1.5) * bonus;
}
