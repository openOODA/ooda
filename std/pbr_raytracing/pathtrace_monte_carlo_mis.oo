// # Multiple Importance Sampling (MIS) Estimators
//
// Logline: Balance and power heuristic weighting estimators combining light sampling and BSDF sampling into variance-minimized estimators.
//
// Setup: Veach-Guibas Multiple Importance Sampling combining complementary probability density functions.
//
// Beats:
//   1. Evaluate Balance Heuristic weight: w_i = (n_i * p_i) / sum(n_j * p_j).
//   2. Evaluate Power Heuristic weight (beta = 2): w_f = p_f^2 / (p_f^2 + p_g^2).
//   3. Blend Next Event Estimation (NEE) direct light samples with BSDF continuation samples.

import "./vec3_math.oo";

pub fn mis_balance_heuristic_two(pdf_f: Float, pdf_g: Float) -> Float {
    let denom: Float = pdf_f + pdf_g;
    if denom <= 0.000001 {
        return 0.0;
    }
    return pdf_f / denom;
}

pub fn mis_power_heuristic_two(pdf_f: Float, pdf_g: Float) -> Float {
    let f2: Float = pdf_f * pdf_f;
    let g2: Float = pdf_g * pdf_g;
    let denom: Float = f2 + g2;
    if denom <= 0.000001 {
        return 0.0;
    }
    return f2 / denom;
}

pub fn mis_combine_two_samples(
    radiance_f: &Vec3,
    pdf_f: Float,
    radiance_g: &Vec3,
    pdf_g: Float
) -> Vec3 {
    let w_f: Float = mis_power_heuristic_two(pdf_f, pdf_g);
    let w_g: Float = mis_power_heuristic_two(pdf_g, pdf_f);

    let contrib_f: Vec3 = vec3_scale(radiance_f, w_f);
    let contrib_g: Vec3 = vec3_scale(radiance_g, w_g);

    return vec3_add(&contrib_f, &contrib_g);
}
