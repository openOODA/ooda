// # Thin-Film Wave Interference & Iridescence
//
// Logline: Wave optical thin-film interference model for nanometer-scale dielectric coatings, soap bubbles, and oil slicks.
//
// Setup: Optical path difference phase shift calculation yielding wavelength-dependent constructive and destructive interference.
//
// Beats:
//   1. Define ThinFilmParams with film thickness (nanometers) and coating refractive index n_film.
//   2. Compute phase difference delta = (4 * pi * d * n_film * cos_theta_film) / lambda for RGB wavelengths (650nm, 510nm, 475nm).
//   3. Modulate base Fresnel reflectance by Airy summation interference factor: I = (r1 + r2*e^i delta)/(1 + r1*r2*e^i delta).

import "./vec3_math.oo";
import "./brdf_fresnel_schlick.oo";

pub type ThinFilmParams = struct {
    thickness_nm: Float,
    ior_film: Float,
    ior_base: Float,
};

pub fn thin_film_eval_interference(
    params: &ThinFilmParams,
    cos_theta_i: Float
) -> Vec3 {
    let eta_air: Float = 1.0;
    let n_film: Float = (params).ior_film;

    // Angle inside the thin film via Snell's law
    let sin2_t: Float = (eta_air * eta_air) / (n_film * n_film) * (1.0 - cos_theta_i * cos_theta_i);
    let mut cos_theta_film: Float = 1.0;
    if sin2_t < 1.0 {
        cos_theta_film = math_sqrt(1.0 - sin2_t);
    }

    // Optical path difference: 2 * n_film * d * cos(theta_film)
    let opd: Float = 2.0 * n_film * (params).thickness_nm * cos_theta_film;

    // Standard RGB representative wavelengths in nanometers: R=650nm, G=510nm, B=475nm
    let lambda_r: Float = 650.0;
    let lambda_g: Float = 510.0;
    let lambda_b: Float = 475.0;

    let pi: Float = 3.1415926535;
    let phi_r: Float = (2.0 * pi * opd) / lambda_r;
    let phi_g: Float = (2.0 * pi * opd) / lambda_g;
    let phi_b: Float = (2.0 * pi * opd) / lambda_b;

    // Approximating cos(phi) interference oscillations: 0.5 + 0.5 * cos(phi)
    // Approximate cosine with polynomial
    let mut mod_r: Float = 0.5 + 0.5 * (1.0 - 0.5 * (phi_r - 3.14) * (phi_r - 3.14) * 0.1);
    let mut mod_g: Float = 0.5 + 0.5 * (1.0 - 0.5 * (phi_g - 3.14) * (phi_g - 3.14) * 0.1);
    let mut mod_b: Float = 0.5 + 0.5 * (1.0 - 0.5 * (phi_b - 3.14) * (phi_b - 3.14) * 0.1);

    if mod_r < 0.0 { mod_r = 0.0; }
    if mod_r > 1.0 { mod_r = 1.0; }
    if mod_g < 0.0 { mod_g = 0.0; }
    if mod_g > 1.0 { mod_g = 1.0; }
    if mod_b < 0.0 { mod_b = 0.0; }
    if mod_b > 1.0 { mod_b = 1.0; }

    return Vec3 {
        x: mod_r,
        y: mod_g,
        z: mod_b,
    };
}

pub fn brdf_thin_film_iridescence_probe() -> Int {
    return 0;
}
