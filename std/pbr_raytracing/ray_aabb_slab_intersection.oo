// # Ray-AABB Slab Intersection & Bounding Volumes
//
// Logline: Robust Kay-Kajiya slab intersection test for Axis-Aligned Bounding Boxes with SIMD-friendly min/max intervals.
//
// Setup: Core geometric bounding volume tested millions of times per frame in BVH tree traversal.
//
// Beats:
//   1. Define AABB structures, empty bounding boxes, and box unions.
//   2. Implement robust Kay-Kajiya slab intersection test with IEEE-754 division handling.
//   3. Compute AABB surface area, centroid, and maximum extent axis for SAH partitioning.

import "./vec3_math.oo";
import "./ray_primitive.oo";

pub type AABB = struct {
    min_pt: Vec3,
    max_pt: Vec3
};

pub type AABBHit = struct {
    hit: Int,
    t_near: Float,
    t_far: Float
};

pub fn aabb_empty() -> AABB {
    return AABB {
        min_pt: vec3_new(1000000000.0, 1000000000.0, 1000000000.0),
        max_pt: vec3_new(-1000000000.0, -1000000000.0, -1000000000.0)
    };
}

pub fn aabb_new(min_pt: Vec3, max_pt: Vec3) -> AABB {
    return AABB {
        min_pt: min_pt,
        max_pt: max_pt
    };
}

pub fn aabb_union(a: &AABB, b: &AABB) -> AABB {
    let mut min_x: Float = (a).min_pt.x;
    if (b).min_pt.x < min_x { min_x = (b).min_pt.x; }
    let mut min_y: Float = (a).min_pt.y;
    if (b).min_pt.y < min_y { min_y = (b).min_pt.y; }
    let mut min_z: Float = (a).min_pt.z;
    if (b).min_pt.z < min_z { min_z = (b).min_pt.z; }

    let mut max_x: Float = (a).max_pt.x;
    if (b).max_pt.x > max_x { max_x = (b).max_pt.x; }
    let mut max_y: Float = (a).max_pt.y;
    if (b).max_pt.y > max_y { max_y = (b).max_pt.y; }
    let mut max_z: Float = (a).max_pt.z;
    if (b).max_pt.z > max_z { max_z = (b).max_pt.z; }

    return AABB {
        min_pt: vec3_new(min_x, min_y, min_z),
        max_pt: vec3_new(max_x, max_y, max_z)
    };
}

pub fn aabb_surface_area(box: &AABB) -> Float {
    let d: Vec3 = vec3_sub(&(box).max_pt, &(box).min_pt);
    let dx: Float = (d).x;
    let dy: Float = (d).y;
    let dz: Float = (d).z;
    if dx < 0.0 { return 0.0; }
    if dy < 0.0 { return 0.0; }
    if dz < 0.0 { return 0.0; }
    return 2.0 * (dx * dy + dy * dz + dz * dx);
}

pub fn aabb_centroid(box: &AABB) -> Vec3 {
    let sum: Vec3 = vec3_add(&(box).min_pt, &(box).max_pt);
    return vec3_scale(&sum, 0.5);
}

pub fn aabb_maximum_extent_axis(box: &AABB) -> Int {
    let d: Vec3 = vec3_sub(&(box).max_pt, &(box).min_pt);
    if (d).x > (d).y && (d).x > (d).z {
        return 0; // X axis
    }
    if (d).y > (d).z {
        return 1; // Y axis
    }
    return 2; // Z axis
}

pub fn aabb_intersect(box: &AABB, ray: &Ray) -> AABBHit {
    let mut t0: Float = (ray).t_min;
    let mut t1: Float = (ray).t_max;

    // X slab
    let inv_dx: Float = 1.0 / (ray).direction.x;
    let mut t_near_x: Float = ((box).min_pt.x - (ray).origin.x) * inv_dx;
    let mut t_far_x: Float = ((box).max_pt.x - (ray).origin.x) * inv_dx;
    if inv_dx < 0.0 {
        let tmp: Float = t_near_x;
        t_near_x = t_far_x;
        t_far_x = tmp;
    }
    if t_near_x > t0 { t0 = t_near_x; }
    if t_far_x < t1 { t1 = t_far_x; }
    if t0 > t1 {
        return AABBHit { hit: 0, t_near: 0.0, t_far: 0.0 };
    }

    // Y slab
    let inv_dy: Float = 1.0 / (ray).direction.y;
    let mut t_near_y: Float = ((box).min_pt.y - (ray).origin.y) * inv_dy;
    let mut t_far_y: Float = ((box).max_pt.y - (ray).origin.y) * inv_dy;
    if inv_dy < 0.0 {
        let tmp: Float = t_near_y;
        t_near_y = t_far_y;
        t_far_y = tmp;
    }
    if t_near_y > t0 { t0 = t_near_y; }
    if t_far_y < t1 { t1 = t_far_y; }
    if t0 > t1 {
        return AABBHit { hit: 0, t_near: 0.0, t_far: 0.0 };
    }

    // Z slab
    let inv_dz: Float = 1.0 / (ray).direction.z;
    let mut t_near_z: Float = ((box).min_pt.z - (ray).origin.z) * inv_dz;
    let mut t_far_z: Float = ((box).max_pt.z - (ray).origin.z) * inv_dz;
    if inv_dz < 0.0 {
        let tmp: Float = t_near_z;
        t_near_z = t_far_z;
        t_far_z = tmp;
    }
    if t_near_z > t0 { t0 = t_near_z; }
    if t_far_z < t1 { t1 = t_far_z; }
    if t0 > t1 {
        return AABBHit { hit: 0, t_near: 0.0, t_far: 0.0 };
    }

    return AABBHit { hit: 1, t_near: t0, t_far: t1 };
}
