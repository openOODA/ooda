// # Woodcock Delta Tracking & Heterogeneous Volume Sampling
//
// Logline: Unbiased null-collision delta tracking and ratio tracking algorithms for heterogeneous density fields and cloud volumes.
//
// Setup: Fictitious matter introduction enabling exact distance sampling through spatially varying extinction coefficients.
//
// Beats:
//   1. Define HeterogeneousMedium with majorant extinction coefficient sigma_maj and 3D density lookup.
//   2. Sample interaction distance via Woodcock null-collision tracking.
//   3. Implement Ratio Tracking for unbiased transmittance estimation along shadow rays.

import "./vec3_math.oo";
import "./ray_primitive.oo";

pub type DeltaTrackingState = struct {
    t: Float,
    hit_real_particle: Int,
    density_sampled: Float,
};

pub fn delta_tracking_sample_step(
    ray: &Ray,
    sigma_maj: Float,
    u_dist: Float,
    u_accept: Float,
    local_density: Float
) -> DeltaTrackingState {
    if sigma_maj <= 0.0001 {
        return DeltaTrackingState {
            t: (ray).t_max,
            hit_real_particle: 0,
            density_sampled: 0.0,
        };
    }

    let mut u_d: Float = u_dist;
    if u_d >= 0.9999 {
        u_d = 0.9999;
    }
    let step: Float = (u_d + 0.5 * u_d * u_d) / sigma_maj;
    let t_cand: Float = (ray).t_min + step;

    if t_cand >= (ray).t_max {
        return DeltaTrackingState {
            t: (ray).t_max,
            hit_real_particle: 0,
            density_sampled: 0.0,
        };
    }

    let p_accept: Float = local_density / sigma_maj;
    if u_accept < p_accept {
        return DeltaTrackingState {
            t: t_cand,
            hit_real_particle: 1,
            density_sampled: local_density,
        };
    }

    return DeltaTrackingState {
        t: t_cand,
        hit_real_particle: 0,
        density_sampled: local_density,
    };
}

pub fn ratio_tracking_transmittance_step(
    transmittance_accum: &mut Float,
    sigma_maj: Float,
    local_density: Float
) {
    if sigma_maj > 0.0001 {
        let null_ratio: Float = 1.0 - (local_density / sigma_maj);
        *transmittance_accum = (*transmittance_accum) * null_ratio;
    }
}
