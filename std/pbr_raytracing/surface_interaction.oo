// # Surface Interaction & Differential Shading Geometry
//
// Logline: Rich surface hit records encapsulating geometric/shading normals, UV parameterization, and orthonormal tangent frames.
//
// Setup: Core interaction data structure passed to BSDF evaluators, light integrators, and BSSRDF scattering pipelines.
//
// Beats:
//   1. Define SurfaceInteraction structure with hit position, outgoing direction wo, geometric normal, and shading normal.
//   2. Support tangent/bitangent frame vectors (dpdu, dpdv) for anisotropic materials and normal mapping.
//   3. Provide local-to-world and world-to-local vector coordinate transformation routines.

import "./vec3_math.oo";
import "./ray_primitive.oo";

pub type SurfaceInteraction = struct {
    p: Vec3,
    wo: Vec3,
    n_geom: Vec3,
    n_shade: Vec3,
    dpdu: Vec3,
    dpdv: Vec3,
    u: Float,
    v: Float,
    t: Float,
    material_id: Int
};

pub fn surface_interaction_new(
    p: Vec3,
    wo: Vec3,
    n: Vec3,
    u: Float,
    v: Float,
    t: Float,
    material_id: Int
) -> SurfaceInteraction {
    let basis: OrthonormalBasis = orthonormal_basis_from_normal(&n);
    return SurfaceInteraction {
        p: p,
        wo: wo,
        n_geom: n,
        n_shade: n,
        dpdu: basis.u,
        dpdv: basis.v,
        u: u,
        v: v,
        t: t,
        material_id: material_id
    };
}

pub fn surface_world_to_local(isect: &SurfaceInteraction, w: &Vec3) -> Vec3 {
    return Vec3 {
        x: vec3_dot(w, &(isect).dpdu),
        y: vec3_dot(w, &(isect).dpdv),
        z: vec3_dot(w, &(isect).n_shade)
    };
}

pub fn surface_local_to_world(isect: &SurfaceInteraction, w: &Vec3) -> Vec3 {
    let u_part: Vec3 = vec3_scale(&(isect).dpdu, (w).x);
    let v_part: Vec3 = vec3_scale(&(isect).dpdv, (w).y);
    let n_part: Vec3 = vec3_scale(&(isect).n_shade, (w).z);
    return vec3_add(&vec3_add(&u_part, &v_part), &n_part);
}

pub fn surface_apply_normal_map(isect: &mut SurfaceInteraction, mapped_normal: &Vec3) {
    let world_mapped: Vec3 = surface_local_to_world(isect, mapped_normal);
    (isect).n_shade = vec3_normalize(&world_mapped);
    let basis: OrthonormalBasis = orthonormal_basis_from_normal(&(isect).n_shade);
    (isect).dpdu = basis.u;
    (isect).dpdv = basis.v;
}

pub fn surface_interaction_probe() -> Int {
    return 0;
}
