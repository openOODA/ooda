// # Core Unidirectional Path Tracer State Machine
//
// Logline: Robust path tracing state loop managing ray recursion, throughput attenuation, and radiance accumulation.
//
// Setup: Unbiased Monte Carlo light transport engine solving the rendering equation across arbitrary scenes.
//
// Beats:
//   1. Maintain PathState with accumulated radiance, current throughput, ray depth, and medium tracking.
//   2. Advance path state upon surface interaction: radiance += throughput * L_direct.
//   3. Update path throughput: throughput *= (bsdf * cos_theta) / pdf and emit next bounce ray.

import "./vec3_math.oo";
import "./ray_primitive.oo";
import "./surface_interaction.oo";
import "./pathtrace_russian_roulette.oo";

pub type PathState = struct {
    ray: Ray,
    radiance_accum: Vec3,
    throughput: Vec3,
    depth: Int,
    max_depth: Int,
    is_terminated: Int
};

pub fn path_state_new(camera_ray: Ray, max_depth: Int) -> PathState {
    return PathState {
        ray: camera_ray,
        radiance_accum: vec3_zero(),
        throughput: vec3_one(),
        depth: 0,
        max_depth: max_depth,
        is_terminated: 0
    };
}

pub fn path_state_add_radiance(state: &mut PathState, direct_rad: &Vec3) {
    let contrib: Vec3 = vec3_mul(&(state).throughput, direct_rad);
    (state).radiance_accum = vec3_add(&(state).radiance_accum, &contrib);
}

pub fn path_state_advance_bounce(
    state: &mut PathState,
    next_ray: Ray,
    bsdf_val: &Vec3,
    cos_theta: Float,
    pdf: Float,
    u_rr: Float
) {
    if pdf <= 0.00001 {
        (state).is_terminated = 1;
        return;
    }

    let factor: Vec3 = vec3_scale(bsdf_val, cos_theta / pdf);
    (state).throughput = vec3_mul(&(state).throughput, &factor);
    (state).depth = (state).depth + 1;
    (state).ray = next_ray;

    if (state).depth >= (state).max_depth {
        (state).is_terminated = 1;
        return;
    }

    let rr: RussianRouletteResult = russian_roulette_eval(&(state).throughput, (state).depth, 3, u_rr);
    if rr.should_terminate == 1 {
        (state).is_terminated = 1;
    } else {
        (state).throughput = rr.rescaled_throughput;
    }
}

pub fn pathtrace_integrator_core_probe() -> Int {
    return 0;
}
