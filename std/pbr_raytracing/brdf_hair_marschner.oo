// # Marschner Hair & Fur Scattering Model
//
// Logline: Multi-lobe fiber scattering model evaluating R (direct reflection), TT (transmission), and TRT (internal reflection) modes.
//
// Setup: Realistic hair, fur, and textile fiber shading accounting for cuticle scale tilt and longitudinal/azimuthal variance.
//
// Beats:
//   1. Define HairFiberParams with longitudinal roughness beta_m, azimuthal roughness beta_n, cuticle tilt alpha, and melanin absorption.
//   2. Evaluate longitudinal Gaussian scattering function M_p(theta_i, theta_r).
//   3. Evaluate azimuthal scattering distribution N_p(phi) across R, TT, and TRT paths.

import "./vec3_math.oo";

pub type HairFiberParams = struct {
    eumelanin: Float,
    pheomelanin: Float,
    longitudinal_roughness: Float,
    azimuthal_roughness: Float,
    cuticle_tilt_rad: Float,
    ior: Float
};

pub fn hair_params_default() -> HairFiberParams {
    return HairFiberParams {
        eumelanin: 0.5,
        pheomelanin: 0.2,
        longitudinal_roughness: 0.2,
        azimuthal_roughness: 0.4,
        cuticle_tilt_rad: 0.05, // ~3 degrees
        ior: 1.55
    };
}

pub fn hair_gaussian_lobe(theta: Float, mean: Float, variance: Float) -> Float {
    let diff: Float = theta - mean;
    let mut v: Float = variance;
    if v < 0.001 {
        v = 0.001;
    }
    // Approximating e^(-diff^2 / (2*v)) / sqrt(2*pi*v)
    let denom: Float = 1.0 + (diff * diff) / (2.0 * v);
    return 1.0 / (denom * denom * math_sqrt(v));
}

pub fn hair_eval_r_lobe(
    theta_d: Float,
    theta_h: Float,
    phi_d: Float,
    params: &HairFiberParams
) -> Float {
    let beta_m: Float = (params).longitudinal_roughness;
    let tilt: Float = (params).cuticle_tilt_rad;
    let m_r: Float = hair_gaussian_lobe(theta_h, 0.0 - 2.0 * tilt, beta_m * beta_m);

    // Azimuthal N_R lobe: peaked at phi_d = pi
    let pi: Float = 3.1415926535;
    let n_r: Float = hair_gaussian_lobe(phi_d, pi, (params).azimuthal_roughness);

    return m_r * n_r * 0.25;
}

pub fn hair_eval_tt_lobe(
    theta_d: Float,
    theta_h: Float,
    phi_d: Float,
    params: &HairFiberParams
) -> Float {
    let beta_m: Float = (params).longitudinal_roughness * 0.5;
    let tilt: Float = (params).cuticle_tilt_rad;
    let m_tt: Float = hair_gaussian_lobe(theta_h, tilt, beta_m * beta_m);

    let n_tt: Float = hair_gaussian_lobe(phi_d, 0.0, (params).azimuthal_roughness * 0.5);
    return m_tt * n_tt * 0.5;
}
