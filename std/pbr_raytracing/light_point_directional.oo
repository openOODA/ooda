// # Singular Light Sources (Point, Spot, & Directional Lights)
//
// Logline: Dirac delta singular light emitters evaluating radiant intensity, inverse-square attenuation, and directional sun rays.
//
// Setup: Canonical point, spotlight, and distant directional light models for direct lighting pipelines.
//
// Beats:
//   1. Define PointLight with position, radiant intensity (Watts/sr), and radius.
//   2. Define SpotLight with cone angles and smooth cosine falloff penumbra.
//   3. Define DirectionalLight with sun direction, irradiance (Lux), and shadow ray generation.

import "./vec3_math.oo";
import "./ray_primitive.oo";

pub type PointLight = struct {
    position: Vec3,
    intensity: Vec3, // RGB radiant intensity
    radius: Float
};

pub type SpotLight = struct {
    position: Vec3,
    direction: Vec3,
    intensity: Vec3,
    cos_inner: Float,
    cos_outer: Float
};

pub type DirectionalLight = struct {
    direction: Vec3,
    irradiance: Vec3
};

pub type LightSample = struct {
    radiance: Vec3,
    wi: Vec3,
    pdf: Float,
    dist: Float
};

pub fn point_light_sample(light: &PointLight, hit_p: &Vec3) -> LightSample {
    let to_light: Vec3 = vec3_sub(&(light).position, hit_p);
    let dist_sq: Float = vec3_length_squared(&to_light);
    let dist: Float = math_sqrt(dist_sq);

    if dist <= 0.0001 {
        return LightSample {
            radiance: vec3_zero(),
            wi: vec3_zero(),
            pdf: 0.0,
            dist: 0.0
        };
    }

    let wi: Vec3 = vec3_scale(&to_light, 1.0 / dist);
    let rad: Vec3 = vec3_scale(&(light).intensity, 1.0 / (dist_sq + 0.0001));

    return LightSample {
        radiance: rad,
        wi: wi,
        pdf: 1.0,
        dist: dist
    };
}

pub fn spotlight_sample(spot: &SpotLight, hit_p: &Vec3) -> LightSample {
    let to_light: Vec3 = vec3_sub(&(spot).position, hit_p);
    let dist_sq: Float = vec3_length_squared(&to_light);
    let dist: Float = math_sqrt(dist_sq);

    if dist <= 0.0001 {
        return LightSample { radiance: vec3_zero(), wi: vec3_zero(), pdf: 0.0, dist: 0.0 };
    }

    let wi: Vec3 = vec3_scale(&to_light, 1.0 / dist);
    let cos_angle: Float = vec3_dot(&vec3_scale(&wi, -1.0), &(spot).direction);

    if cos_angle < (spot).cos_outer {
        return LightSample { radiance: vec3_zero(), wi: wi, pdf: 0.0, dist: dist };
    }

    let mut falloff: Float = 1.0;
    if cos_angle < (spot).cos_inner {
        let delta: Float = (spot).cos_inner - (spot).cos_outer;
        let t: Float = (cos_angle - (spot).cos_outer) / (delta + 0.00001);
        falloff = t * t * (3.0 - 2.0 * t); // Smoothstep
    }

    let atten: Float = falloff / (dist_sq + 0.0001);
    let rad: Vec3 = vec3_scale(&(spot).intensity, atten);

    return LightSample {
        radiance: rad,
        wi: wi,
        pdf: 1.0,
        dist: dist
    };
}

pub fn directional_light_sample(sun: &DirectionalLight, hit_p: &Vec3) -> LightSample {
    let wi: Vec3 = vec3_scale(&(sun).direction, -1.0);
    return LightSample {
        radiance: (sun).irradiance,
        wi: vec3_normalize(&wi),
        pdf: 1.0,
        dist: 1000000.0
    };
}

pub fn light_point_directional_probe() -> Int {
    return 0;
}
