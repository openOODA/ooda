// # Linear BVH Node Representation & Layout
//
// Logline: Memory-aligned Linear BVH node structures packed for SIMD cache lines and GPU buffer upload.
//
// Setup: Core tree data structure storing bounding volume hierarchy nodes, child indices, and leaf primitive offsets.
//
// Beats:
//   1. Define LinearBvhNode structure with 32-byte AABB bounds and 32-bit child index / primitive count.
//   2. Provide leaf vs interior node predicates and primitive range queries.
//   3. Implement node initialization, bounding box expansion, and serialization utilities.

import "./vec3_math.oo";
import "./ray_aabb_slab_intersection.oo";

pub type LinearBvhNode = struct {
    bounds: AABB,
    child_or_prim_offset: Int,
    primitive_count: Int,
    axis: Int,
};

pub fn bvh_node_new_interior(bounds: AABB, second_child_offset: Int, axis: Int) -> LinearBvhNode {
    return LinearBvhNode {
        bounds: bounds,
        child_or_prim_offset: second_child_offset,
        primitive_count: 0, // 0 signifies interior node
        axis: axis,
    };
}

pub fn bvh_node_new_leaf(bounds: AABB, first_prim_offset: Int, primitive_count: Int) -> LinearBvhNode {
    return LinearBvhNode {
        bounds: bounds,
        child_or_prim_offset: first_prim_offset,
        primitive_count: primitive_count,
        axis: 0,
    };
}

pub fn bvh_node_is_leaf(node: &LinearBvhNode) -> Int {
    if (node).primitive_count > 0 {
        return 1;
    }
    return 0;
}

pub fn bvh_node_get_left_child_idx(node_idx: Int) -> Int {
    return node_idx + 1;
}

pub fn bvh_node_get_right_child_idx(node: &LinearBvhNode) -> Int {
    return (node).child_or_prim_offset;
}

pub fn bvh_node_expand_bounds(node: &mut LinearBvhNode, extra_box: &AABB) {
    (node).bounds = aabb_union(&(node).bounds, extra_box);
}
