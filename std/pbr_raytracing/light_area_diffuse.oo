// # Diffuse Area Light Emission & Sampling
//
// Logline: Evaluates radiance emission, uniform area surface sampling, and solid angle PDF conversion for mesh area lights.
//
// Setup: Area light sources supporting soft shadows and physically based inverse-square illumination.
//
// Beats:
//   1. Define DiffuseAreaLight with emission radiance L_e, surface area, and normal direction.
//   2. Sample random surface point on quad / disk area emitter.
//   3. Convert area probability density to solid angle measure: PDF_omega = (PDF_area * dist^2) / |cos(theta_light)|.

import "./vec3_math.oo";
import "./ray_primitive.oo";
import "./light_point_directional.oo";

pub type DiffuseAreaLight = struct {
    emission: Vec3,
    center: Vec3,
    normal: Vec3,
    area: Float,
    is_double_sided: Int,
};

pub fn area_light_new(
    emission: Vec3,
    center: Vec3,
    normal: Vec3,
    area: Float
) -> DiffuseAreaLight {
    return DiffuseAreaLight {
        emission: emission,
        center: center,
        normal: vec3_normalize(&normal),
        area: area,
        is_double_sided: 0,
    };
}

pub fn area_light_eval_emission(
    light: &DiffuseAreaLight,
    out_dir: &Vec3
) -> Vec3 {
    let cos_theta: Float = vec3_dot(&(light).normal, out_dir);
    if cos_theta > 0.0 {
        return (light).emission;
    }
    if (light).is_double_sided == 1 {
        return (light).emission;
    }
    return vec3_zero();
}

pub fn area_light_sample(
    light: &DiffuseAreaLight,
    hit_p: &Vec3,
    sample_pt: &Vec3
) -> LightSample {
    let to_light: Vec3 = vec3_sub(sample_pt, hit_p);
    let dist_sq: Float = vec3_length_squared(&to_light);
    let dist: Float = math_sqrt(dist_sq);

    if dist <= 0.0001 {
        return LightSample { radiance: vec3_zero(), wi: vec3_zero(), pdf: 0.0, dist: 0.0 };
    }

    let wi: Vec3 = vec3_scale(&to_light, 1.0 / dist);
    let cos_light: Float = 0.0 - vec3_dot(&(light).normal, &wi);

    if cos_light <= 0.0 && (light).is_double_sided == 0 {
        return LightSample { radiance: vec3_zero(), wi: wi, pdf: 0.0, dist: dist };
    }

    let abs_cos_light: Float = math_sqrt(cos_light * cos_light);
    let pdf_area: Float = 1.0 / (light).area;
    let pdf_solid_angle: Float = (pdf_area * dist_sq) / (abs_cos_light + 0.0001);

    return LightSample {
        radiance: (light).emission,
        wi: wi,
        pdf: pdf_solid_angle,
        dist: dist,
    };
}
