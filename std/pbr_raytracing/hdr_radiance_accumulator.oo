// # HDR Radiance Accumulator & Welford Variance Estimation
//
// Logline: Floating-point HDR radiance accumulation buffer with online Welford variance tracking and firefly clamping.
//
// Setup: Accumulates Monte Carlo samples per pixel across iterations, maintaining running mean and variance for adaptive sampling.
//
// Beats:
//   1. Define HdrPixelCell with accumulated radiance RGB, sample count N, running variance M2, and sample weights.
//   2. Update running mean and variance using Welford's single-pass online recurrence.
//   3. Apply statistical firefly threshold clamping: L_clamped = min(L, mean + 3 * std_dev).

import "./vec3_math.oo";

pub type HdrPixelCell = struct {
    mean_radiance: Vec3,
    variance_m2: Vec3,
    sample_count: Int,
    total_weight: Float,
};

pub fn hdr_pixel_new() -> HdrPixelCell {
    return HdrPixelCell {
        mean_radiance: vec3_zero(),
        variance_m2: vec3_zero(),
        sample_count: 0,
        total_weight: 0.0,
    };
}

pub fn hdr_pixel_accumulate_sample(
    cell: &mut HdrPixelCell,
    sample_rad: &Vec3,
    weight: Float
) {
    (cell).sample_count = (cell).sample_count + 1;
    (cell).total_weight = (cell).total_weight + weight;

    let mut n_f: Float = 0.0;
    let mut c: Int = (cell).sample_count;
    while c >= 10 { n_f = n_f + 10.0; c = c - 10; }
    while c >= 1 { n_f = n_f + 1.0; c = c - 1; }

    let delta: Vec3 = vec3_sub(sample_rad, &(cell).mean_radiance);
    let delta_scaled: Vec3 = vec3_scale(&delta, 1.0 / n_f);
    (cell).mean_radiance = vec3_add(&(cell).mean_radiance, &delta_scaled);

    let delta2: Vec3 = vec3_sub(sample_rad, &(cell).mean_radiance);
    let delta_prod: Vec3 = vec3_mul(&delta, &delta2);
    (cell).variance_m2 = vec3_add(&(cell).variance_m2, &delta_prod);
}

pub fn hdr_pixel_get_standard_deviation(cell: &HdrPixelCell) -> Vec3 {
    if (cell).sample_count < 2 {
        return vec3_zero();
    }
    let mut n_f: Float = 0.0;
    let mut c: Int = (cell).sample_count - 1;
    while c >= 10 { n_f = n_f + 10.0; c = c - 10; }
    while c >= 1 { n_f = n_f + 1.0; c = c - 1; }

    let var_x: Float = (cell).variance_m2.x / n_f;
    let var_y: Float = (cell).variance_m2.y / n_f;
    let var_z: Float = (cell).variance_m2.z / n_f;

    return Vec3 {
        x: math_sqrt(var_x),
        y: math_sqrt(var_y),
        z: math_sqrt(var_z),
    };
}
