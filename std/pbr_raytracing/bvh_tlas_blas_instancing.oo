// # TLAS / BLAS Two-Level Hierarchy & Instance Transforms
//
// Logline: Two-level acceleration structure (TLAS/BLAS) with rigid/affine instance transformation matrices and ray inverse mapping.
//
// Setup: Enables massive geometric instancing (foliage, city blocks, particle meshes) with zero memory duplication.
//
// Beats:
//   1. Define InstanceTransform struct with 3x4 affine world-to-instance and instance-to-world matrices.
//   2. Transform world-space rays into object-space coordinates for BLAS traversal.
//   3. Transform object-space surface intersection points and normals back to world-space.

import "./vec3_math.oo";
import "./ray_primitive.oo";
import "./ray_aabb_slab_intersection.oo";

pub type AffineTransform = struct {
    m00: Float, m01: Float, m02: Float, m03: Float,
    m10: Float, m11: Float, m12: Float, m13: Float,
    m20: Float, m21: Float, m22: Float, m23: Float,
};

pub type BlasInstance = struct {
    blas_id: Int,
    to_world: AffineTransform,
    to_local: AffineTransform,
    world_bounds: AABB,
    instance_custom_id: Int,
};

pub fn affine_identity() -> AffineTransform {
    return AffineTransform {
        m00: 1.0, m01: 0.0, m02: 0.0, m03: 0.0,
        m10: 0.0, m11: 1.0, m12: 0.0, m13: 0.0,
        m20: 0.0, m21: 0.0, m22: 1.0, m23: 0.0,
    };
}

pub fn affine_transform_point(xform: &AffineTransform, p: &Vec3) -> Vec3 {
    return Vec3 {
        x: (xform).m00 * (p).x + (xform).m01 * (p).y + (xform).m02 * (p).z + (xform).m03,
        y: (xform).m10 * (p).x + (xform).m11 * (p).y + (xform).m12 * (p).z + (xform).m13,
        z: (xform).m20 * (p).x + (xform).m21 * (p).y + (xform).m22 * (p).z + (xform).m23,
    };
}

pub fn affine_transform_vector(xform: &AffineTransform, v: &Vec3) -> Vec3 {
    return Vec3 {
        x: (xform).m00 * (v).x + (xform).m01 * (v).y + (xform).m02 * (v).z,
        y: (xform).m10 * (v).x + (xform).m11 * (v).y + (xform).m12 * (v).z,
        z: (xform).m20 * (v).x + (xform).m21 * (v).y + (xform).m22 * (v).z,
    };
}

pub fn affine_transform_normal(inv_xform: &AffineTransform, n: &Vec3) -> Vec3 {
    // Normal transforms by transpose of inverse
    let unnorm: Vec3 = Vec3 {
        x: (inv_xform).m00 * (n).x + (inv_xform).m10 * (n).y + (inv_xform).m20 * (n).z,
        y: (inv_xform).m01 * (n).x + (inv_xform).m11 * (n).y + (inv_xform).m21 * (n).z,
        z: (inv_xform).m02 * (n).x + (inv_xform).m12 * (n).y + (inv_xform).m22 * (n).z,
    };
    return vec3_normalize(&unnorm);
}

pub fn ray_transform_to_local(inst: &BlasInstance, world_ray: &Ray) -> Ray {
    let local_orig: Vec3 = affine_transform_point(&(inst).to_local, &(world_ray).origin);
    let local_dir: Vec3 = affine_transform_vector(&(inst).to_local, &(world_ray).direction);
    return Ray {
        origin: local_orig,
        direction: local_dir,
        t_min: (world_ray).t_min,
        t_max: (world_ray).t_max,
        time: (world_ray).time,
        medium_id: (world_ray).medium_id,
    };
}
