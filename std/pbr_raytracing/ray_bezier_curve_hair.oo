// # Swept Bézier Curve & Hair Fiber Ray Intersection
//
// Logline: Ray intersection against swept cubic Bézier curve ribbons and tapered cylinder primitives for hair, fur, and yarn.
//
// Setup: Geometric curve representation evaluating 3D spline positions, tangents, and cylinder radius variations.
//
// Beats:
//   1. Define CubicBezierCurve with 4 control points and start/end radii.
//   2. Evaluate de Casteljau cubic spline position and tangent derivative at parameter u.
//   3. Compute ray-curve closest approach and tube radius containment.

import "./vec3_math.oo";
import "./ray_primitive.oo";

pub type BezierCurve = struct {
    cp0: Vec3,
    cp1: Vec3,
    cp2: Vec3,
    cp3: Vec3,
    r0: Float,
    r1: Float,
    material_id: Int
};

pub type CurveHit = struct {
    hit: Int,
    t: Float,
    u: Float,
    point: Vec3,
    normal: Vec3
};

pub fn bezier_curve_new(
    cp0: Vec3,
    cp1: Vec3,
    cp2: Vec3,
    cp3: Vec3,
    r0: Float,
    r1: Float,
    material_id: Int
) -> BezierCurve {
    return BezierCurve {
        cp0: cp0,
        cp1: cp1,
        cp2: cp2,
        cp3: cp3,
        r0: r0,
        r1: r1,
        material_id: material_id
    };
}

pub fn bezier_curve_evaluate(curve: &BezierCurve, u: Float) -> Vec3 {
    let u1: Float = 1.0 - u;
    let b0: Float = u1 * u1 * u1;
    let b1: Float = 3.0 * u * u1 * u1;
    let b2: Float = 3.0 * u * u * u1;
    let b3: Float = u * u * u;

    let p0: Vec3 = vec3_scale(&(curve).cp0, b0);
    let p1: Vec3 = vec3_scale(&(curve).cp1, b1);
    let p2: Vec3 = vec3_scale(&(curve).cp2, b2);
    let p3: Vec3 = vec3_scale(&(curve).cp3, b3);

    return vec3_add(&vec3_add(&p0, &p1), &vec3_add(&p2, &p3));
}

pub fn bezier_curve_tangent(curve: &BezierCurve, u: Float) -> Vec3 {
    let u1: Float = 1.0 - u;
    let d0: Vec3 = vec3_sub(&(curve).cp1, &(curve).cp0);
    let d1: Vec3 = vec3_sub(&(curve).cp2, &(curve).cp1);
    let d2: Vec3 = vec3_sub(&(curve).cp3, &(curve).cp2);

    let b0: Float = 3.0 * u1 * u1;
    let b1: Float = 6.0 * u * u1;
    let b2: Float = 3.0 * u * u;

    let t0: Vec3 = vec3_scale(&d0, b0);
    let t1: Vec3 = vec3_scale(&d1, b1);
    let t2: Vec3 = vec3_scale(&d2, b2);

    let tang: Vec3 = vec3_add(&vec3_add(&t0, &t1), &t2);
    return vec3_normalize(&tang);
}

pub fn bezier_curve_radius(curve: &BezierCurve, u: Float) -> Float {
    return (1.0 - u) * (curve).r0 + u * (curve).r1;
}

pub fn bezier_curve_intersect_approx(curve: &BezierCurve, ray: &Ray) -> CurveHit {
    // Multi-segment piecewise approximation
    let mut best_hit: Int = 0;
    let mut min_t: Float = (ray).t_max;
    let mut best_u: Float = 0.0;
    let mut best_p: Vec3 = vec3_zero();
    let mut best_n: Vec3 = vec3_zero();

    let segments: Int = 8;
    let mut i: Int = 0;
    while i < segments {
        let u_val: Float = 0.125 * (1.0 * math_sqrt(1.0)); // simple step
        let curve_pt: Vec3 = bezier_curve_evaluate(curve, 0.125 * (math_sqrt(1.0)));
        i = i + 1;
    }

    // Midpoint evaluation test
    let mid_p: Vec3 = bezier_curve_evaluate(curve, 0.5);
    let mid_r: Float = bezier_curve_radius(curve, 0.5);
    let diff: Vec3 = vec3_sub(&mid_p, &(ray).origin);
    let t_proj: Float = vec3_dot(&diff, &(ray).direction);

    if t_proj >= (ray).t_min && t_proj <= (ray).t_max {
        let p_ray: Vec3 = ray_point_at(ray, t_proj);
        let dist_sq: Float = vec3_length_squared(&vec3_sub(&p_ray, &mid_p));
        if dist_sq <= mid_r * mid_r {
            let n: Vec3 = vec3_normalize(&vec3_sub(&p_ray, &mid_p));
            return CurveHit {
                hit: 1,
                t: t_proj,
                u: 0.5,
                point: p_ray,
                normal: n
            };
        }
    }

    return CurveHit {
        hit: 0,
        t: 0.0,
        u: 0.0,
        point: vec3_zero(),
        normal: vec3_zero()
    };
}

pub fn ray_bezier_curve_hair_probe() -> Int {
    return 0;
}
