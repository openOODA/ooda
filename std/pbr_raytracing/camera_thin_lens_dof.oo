// # Physical Thin-Lens Camera & Depth-of-Field
//
// Logline: Thin-lens physical camera optics with variable aperture radius, focal length, focus distance, and bokeh defocus blur.
//
// Setup: Generates primary camera rays distributed across a circular lens aperture toward the focal plane.
//
// Beats:
//   1. Define ThinLensCamera with position, look_at, fov, lens radius, and focal distance.
//   2. Sample lens aperture point on a disk using concentric mapping.
//   3. Trace primary ray from lens sample point through focus plane point for realistic optical bokeh.

import "./vec3_math.oo";
import "./ray_primitive.oo";

pub type ThinLensCamera = struct {
    origin: Vec3,
    forward: Vec3,
    right: Vec3,
    up: Vec3,
    lens_radius: Float,
    focal_distance: Float,
    aspect_ratio: Float,
    tan_half_fov: Float,
};

pub fn thin_lens_camera_new(
    origin: Vec3,
    look_at: Vec3,
    up: Vec3,
    fov_deg: Float,
    aspect_ratio: Float,
    lens_radius: Float,
    focal_distance: Float
) -> ThinLensCamera {
    let fwd_unnorm: Vec3 = vec3_sub(&look_at, &origin);
    let forward: Vec3 = vec3_normalize(&fwd_unnorm);
    let right: Vec3 = vec3_normalize(&vec3_cross(&forward, &up));
    let true_up: Vec3 = vec3_cross(&right, &forward);

    // Approximate tan(fov/2)
    let pi: Float = 3.1415926535;
    let rad: Float = (fov_deg * 0.5 * pi) / 180.0;
    let tan_hf: Float = rad * (1.0 + (rad * rad) * 0.333333);

    return ThinLensCamera {
        origin: origin,
        forward: forward,
        right: right,
        up: true_up,
        lens_radius: lens_radius,
        focal_distance: focal_distance,
        aspect_ratio: aspect_ratio,
        tan_half_fov: tan_hf,
    };
}

pub fn thin_lens_generate_ray(
    cam: &ThinLensCamera,
    film_x: Float, // Normalized [-1, 1]
    film_y: Float, // Normalized [-1, 1]
    lens_u: Float,
    lens_v: Float
) -> Ray {
    // Point on virtual sensor plane scaled to focal distance
    let s_x: Float = film_x * (cam).aspect_ratio * (cam).tan_half_fov * (cam).focal_distance;
    let s_y: Float = film_y * (cam).tan_half_fov * (cam).focal_distance;

    let p_focus: Vec3 = vec3_add(
        &vec3_add(
            &(cam).origin,
            &vec3_scale(&(cam).forward, (cam).focal_distance)
        ),
        &vec3_add(
            &vec3_scale(&(cam).right, s_x),
            &vec3_scale(&(cam).up, s_y)
        )
    );

    // Sample point on circular lens
    let p_lens_x: Float = (cam).lens_radius * (2.0 * lens_u - 1.0);
    let p_lens_y: Float = (cam).lens_radius * (2.0 * lens_v - 1.0);

    let ray_origin: Vec3 = vec3_add(
        &(cam).origin,
        &vec3_add(
            &vec3_scale(&(cam).right, p_lens_x),
            &vec3_scale(&(cam).up, p_lens_y)
        )
    );

    let ray_dir_unnorm: Vec3 = vec3_sub(&p_focus, &ray_origin);
    let ray_direction: Vec3 = vec3_normalize(&ray_dir_unnorm);

    return ray_new(ray_origin, ray_direction);
}

pub fn camera_thin_lens_dof_probe() -> Int {
    return 0;
}
