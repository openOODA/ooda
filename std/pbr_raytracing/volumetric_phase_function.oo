// # Volumetric Scattering Phase Functions
//
// Logline: Phase function evaluations and importance sampling for Henyey-Greenstein, Rayleigh, and isotropic participating media.
//
// Setup: Angular distribution of scattered light in fog, smoke, clouds, and murky water.
//
// Beats:
//   1. Evaluate Henyey-Greenstein phase function: p(cos_theta) = (1 - g^2) / ( 4*pi * (1 + g^2 - 2*g*cos_theta)^(3/2) ).
//   2. Importance sample Henyey-Greenstein scattering deflection angle theta from uniform random variables.
//   3. Provide Rayleigh molecular atmospheric scattering and isotropic baseline phase functions.

import "./vec3_math.oo";

pub fn phase_isotropic() -> Float {
    let inv_4pi: Float = 0.07957747154;
    return inv_4pi;
}

pub fn phase_henyey_greenstein_eval(cos_theta: Float, g: Float) -> Float {
    let g2: Float = g * g;
    let denom_base: Float = 1.0 + g2 - 2.0 * g * cos_theta;
    if denom_base <= 0.0001 {
        return 0.0;
    }
    let sqrt_denom: Float = math_sqrt(denom_base);
    let denom: Float = denom_base * sqrt_denom;

    let pi: Float = 3.1415926535;
    return (1.0 - g2) / (4.0 * pi * denom);
}

pub fn phase_rayleigh_eval(cos_theta: Float) -> Float {
    let pi: Float = 3.1415926535;
    return (3.0 / (16.0 * pi)) * (1.0 + cos_theta * cos_theta);
}

pub fn phase_henyey_greenstein_sample(
    wo: &Vec3,
    g: Float,
    u1: Float,
    u2: Float
) -> Vec3 {
    let mut cos_theta: Float = 1.0 - 2.0 * u1;
    if g > 0.0001 || g < -0.0001 {
        let g2: Float = g * g;
        let sqr_term: Float = (1.0 - g2) / (1.0 - g + 2.0 * g * u1);
        cos_theta = (1.0 + g2 - sqr_term * sqr_term) / (2.0 * g);
    }

    let sin_theta: Float = math_sqrt(1.0 - cos_theta * cos_theta);
    let pi: Float = 3.1415926535;
    let phi: Float = 2.0 * pi * u2;

    let dir_local: Vec3 = Vec3 {
        x: sin_theta * (1.0 - 0.5 * (phi - pi) * (phi - pi)),
        y: sin_theta * (phi - pi),
        z: cos_theta,
    };

    let basis: OrthonormalBasis = orthonormal_basis_from_normal(wo);
    let u_comp: Vec3 = vec3_scale(&basis.u, (dir_local).x);
    let v_comp: Vec3 = vec3_scale(&basis.v, (dir_local).y);
    let w_comp: Vec3 = vec3_scale(&basis.w, (dir_local).z);

    let res: Vec3 = vec3_add(&vec3_add(&u_comp, &v_comp), &w_comp);
    return vec3_normalize(&res);
}
