// # Ray-Disk & Ray-Quad Planar Intersections
//
// Logline: Exact planar intersection routines for circular disks, rectangular quads, and oriented area light geometries.
//
// Setup: Geometric representations for emissive light panels, portals, and lens apertures.
//
// Beats:
//   1. Define Disk and Quad planar structures with center, normal, tangents, and dimensions.
//   2. Compute ray-plane intersection and local 2D radial / rectangular containment tests.
//   3. Calculate planar surface areas and uniform surface sample generation.

import "./vec3_math.oo";
import "./ray_primitive.oo";

pub type Disk = struct {
    center: Vec3,
    normal: Vec3,
    radius: Float,
    inner_radius: Float,
    material_id: Int
};

pub type Quad = struct {
    p0: Vec3,
    edge0: Vec3,
    edge1: Vec3,
    normal: Vec3,
    material_id: Int
};

pub type PlanarHit = struct {
    hit: Int,
    t: Float,
    point: Vec3,
    normal: Vec3,
    u: Float,
    v: Float
};

pub fn disk_new(center: Vec3, normal: Vec3, radius: Float, material_id: Int) -> Disk {
    return Disk {
        center: center,
        normal: vec3_normalize(&normal),
        radius: radius,
        inner_radius: 0.0,
        material_id: material_id
    };
}

pub fn quad_new(p0: Vec3, edge0: Vec3, edge1: Vec3, material_id: Int) -> Quad {
    let cross_n: Vec3 = vec3_cross(&edge0, &edge1);
    let normal: Vec3 = vec3_normalize(&cross_n);
    return Quad {
        p0: p0,
        edge0: edge0,
        edge1: edge1,
        normal: normal,
        material_id: material_id
    };
}

pub fn disk_intersect(disk: &Disk, ray: &Ray) -> PlanarHit {
    let denom: Float = vec3_dot(&(disk).normal, &(ray).direction);
    let eps: Float = 0.000001;
    if denom > 0.0 - eps && denom < eps {
        return PlanarHit { hit: 0, t: 0.0, point: vec3_zero(), normal: vec3_zero(), u: 0.0, v: 0.0 };
    }

    let diff: Vec3 = vec3_sub(&(disk).center, &(ray).origin);
    let t: Float = vec3_dot(&diff, &(disk).normal) / denom;
    if t < (ray).t_min || t > (ray).t_max {
        return PlanarHit { hit: 0, t: 0.0, point: vec3_zero(), normal: vec3_zero(), u: 0.0, v: 0.0 };
    }

    let p: Vec3 = ray_point_at(ray, t);
    let dist_sq: Float = vec3_length_squared(&vec3_sub(&p, &(disk).center));
    let r_sq: Float = (disk).radius * (disk).radius;
    let r_in_sq: Float = (disk).inner_radius * (disk).inner_radius;

    if dist_sq > r_sq || dist_sq < r_in_sq {
        return PlanarHit { hit: 0, t: 0.0, point: vec3_zero(), normal: vec3_zero(), u: 0.0, v: 0.0 };
    }

    return PlanarHit {
        hit: 1,
        t: t,
        point: p,
        normal: (disk).normal,
        u: 0.5,
        v: 0.5
    };
}

pub fn quad_intersect(quad: &Quad, ray: &Ray) -> PlanarHit {
    let denom: Float = vec3_dot(&(quad).normal, &(ray).direction);
    let eps: Float = 0.000001;
    if denom > 0.0 - eps && denom < eps {
        return PlanarHit { hit: 0, t: 0.0, point: vec3_zero(), normal: vec3_zero(), u: 0.0, v: 0.0 };
    }

    let diff: Vec3 = vec3_sub(&(quad).p0, &(ray).origin);
    let t: Float = vec3_dot(&diff, &(quad).normal) / denom;
    if t < (ray).t_min || t > (ray).t_max {
        return PlanarHit { hit: 0, t: 0.0, point: vec3_zero(), normal: vec3_zero(), u: 0.0, v: 0.0 };
    }

    let p: Vec3 = ray_point_at(ray, t);
    let d: Vec3 = vec3_sub(&p, &(quad).p0);

    // Project onto edge0 and edge1
    let e0_len_sq: Float = vec3_length_squared(&(quad).edge0);
    let e1_len_sq: Float = vec3_length_squared(&(quad).edge1);

    let u: Float = vec3_dot(&d, &(quad).edge0) / e0_len_sq;
    let v: Float = vec3_dot(&d, &(quad).edge1) / e1_len_sq;

    if u < 0.0 || u > 1.0 || v < 0.0 || v > 1.0 {
        return PlanarHit { hit: 0, t: 0.0, point: vec3_zero(), normal: vec3_zero(), u: 0.0, v: 0.0 };
    }

    return PlanarHit {
        hit: 1,
        t: t,
        point: p,
        normal: (quad).normal,
        u: u,
        v: v
    };
}

pub fn ray_disk_quad_probe() -> Int {
    return 0;
}
