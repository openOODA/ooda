// # Möller-Trumbore Ray-Triangle Intersection
//
// Logline: Fast, memory-efficient ray-triangle intersection without precomputed plane equations using barycentric coordinates.
//
// Setup: Canonical triangle intersection primitive evaluating hit distance t, barycentric weights (u, v), and geometric normal.
//
// Beats:
//   1. Define Triangle structure with three 3D vertices and optional vertex normals/UVs.
//   2. Compute ray-triangle intersection using scalar triple products and determinant culling.
//   3. Interpolate surface normals and texture coordinates across barycentric coordinates.

import "./vec3_math.oo";
import "./ray_primitive.oo";

pub type Triangle = struct {
    v0: Vec3,
    v1: Vec3,
    v2: Vec3,
    n0: Vec3,
    n1: Vec3,
    n2: Vec3,
    material_id: Int,
};

pub type TriangleHit = struct {
    hit: Int,
    t: Float,
    u: Float,
    v: Float,
    normal: Vec3,
};

pub fn triangle_new(v0: Vec3, v1: Vec3, v2: Vec3, material_id: Int) -> Triangle {
    let edge1: Vec3 = vec3_sub(&v1, &v0);
    let edge2: Vec3 = vec3_sub(&v2, &v0);
    let n: Vec3 = vec3_normalize(&vec3_cross(&edge1, &edge2));
    return Triangle {
        v0: v0,
        v1: v1,
        v2: v2,
        n0: n,
        n1: n,
        n2: n,
        material_id: material_id,
    };
}

pub fn triangle_intersect_moller_trumbore(tri: &Triangle, ray: &Ray) -> TriangleHit {
    let edge1: Vec3 = vec3_sub(&(tri).v1, &(tri).v0);
    let edge2: Vec3 = vec3_sub(&(tri).v2, &(tri).v0);

    let pvec: Vec3 = vec3_cross(&(ray).direction, &edge2);
    let det: Float = vec3_dot(&edge1, &pvec);

    let eps: Float = 0.0000001;
    if det > 0.0 - eps && det < eps {
        return TriangleHit {
            hit: 0,
            t: 0.0,
            u: 0.0,
            v: 0.0,
            normal: vec3_zero(),
        };
    }

    let inv_det: Float = 1.0 / det;
    let tvec: Vec3 = vec3_sub(&(ray).origin, &(tri).v0);
    let u: Float = vec3_dot(&tvec, &pvec) * inv_det;
    if u < 0.0 || u > 1.0 {
        return TriangleHit {
            hit: 0,
            t: 0.0,
            u: 0.0,
            v: 0.0,
            normal: vec3_zero(),
        };
    }

    let qvec: Vec3 = vec3_cross(&tvec, &edge1);
    let v: Float = vec3_dot(&(ray).direction, &qvec) * inv_det;
    if v < 0.0 || u + v > 1.0 {
        return TriangleHit {
            hit: 0,
            t: 0.0,
            u: 0.0,
            v: 0.0,
            normal: vec3_zero(),
        };
    }

    let t: Float = vec3_dot(&edge2, &qvec) * inv_det;
    if t < (ray).t_min || t > (ray).t_max {
        return TriangleHit {
            hit: 0,
            t: 0.0,
            u: 0.0,
            v: 0.0,
            normal: vec3_zero(),
        };
    }

    // Interpolate normal: n = (1 - u - v) * n0 + u * n1 + v * n2
    let w: Float = 1.0 - u - v;
    let n0_scaled: Vec3 = vec3_scale(&(tri).n0, w);
    let n1_scaled: Vec3 = vec3_scale(&(tri).n1, u);
    let n2_scaled: Vec3 = vec3_scale(&(tri).n2, v);
    let interp_n: Vec3 = vec3_add(&vec3_add(&n0_scaled, &n1_scaled), &n2_scaled);
    let normal: Vec3 = vec3_normalize(&interp_n);

    return TriangleHit {
        hit: 1,
        t: t,
        u: u,
        v: v,
        normal: normal,
    };
}

pub fn ray_triangle_moller_trumbore_probe() -> Int {
    return 0;
}
