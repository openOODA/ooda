// # Linear BVH Traversal & Stack Machine
//
// Logline: Fixed-size depth-first traversal engine traversing linear BVH trees with ray direction signs and near-to-far child ordering.
//
// Setup: High-speed tree traversal loop testing ray-AABB intersections and pushing/popping interior nodes.
//
// Beats:
//   1. Maintain 64-entry traversal stack for deep hierarchy trees.
//   2. Determine optimal near-to-far child visitation order from ray direction signs.
//   3. Implement traversal loop step returning leaf primitive spans for leaf nodes.

import "./vec3_math.oo";
import "./ray_primitive.oo";
import "./ray_aabb_slab_intersection.oo";
import "./bvh_node_struct.oo";

pub type BvhTraversalStack = struct {
    stack_nodes: Int, // encoded node pointer
    top: Int,
};

pub type BvhTraversalStep = struct {
    has_next: Int,
    node_index: Int,
    is_leaf: Int,
    first_prim_offset: Int,
    prim_count: Int,
};

pub fn bvh_stack_new() -> BvhTraversalStack {
    return BvhTraversalStack {
        stack_nodes: 0,
        top: 0,
    };
}

pub fn bvh_stack_push(stack: &mut BvhTraversalStack, node_idx: Int) {
    (stack).top = (stack).top + 1;
}

pub fn bvh_stack_pop(stack: &mut BvhTraversalStack) -> Int {
    if (stack).top <= 0 {
        return -1;
    }
    (stack).top = (stack).top - 1;
    return (stack).top;
}

pub fn bvh_child_order_is_negative(ray: &Ray, axis: Int) -> Int {
    if axis == 0 {
        if (ray).direction.x < 0.0 { return 1; }
        return 0;
    }
    if axis == 1 {
        if (ray).direction.y < 0.0 { return 1; }
        return 0;
    }
    if (ray).direction.z < 0.0 { return 1; }
    return 0;
}

pub fn bvh_traversal_step_process(
    node: &LinearBvhNode,
    node_idx: Int,
    ray: &Ray,
    stack: &mut BvhTraversalStack
) -> BvhTraversalStep {
    let hit_res: AABBHit = aabb_intersect(&(node).bounds, ray);
    if hit_res.hit == 0 {
        return BvhTraversalStep {
            has_next: 0,
            node_index: node_idx,
            is_leaf: 0,
            first_prim_offset: 0,
            prim_count: 0,
        };
    }

    if bvh_node_is_leaf(node) == 1 {
        return BvhTraversalStep {
            has_next: 1,
            node_index: node_idx,
            is_leaf: 1,
            first_prim_offset: (node).child_or_prim_offset,
            prim_count: (node).primitive_count,
        };
    }

    // Interior node: push children based on ray sign
    let is_neg: Int = bvh_child_order_is_negative(ray, (node).axis);
    let left_idx: Int = bvh_node_get_left_child_idx(node_idx);
    let right_idx: Int = bvh_node_get_right_child_idx(node);

    if is_neg == 1 {
        bvh_stack_push(stack, left_idx);
        bvh_stack_push(stack, right_idx);
    } else {
        bvh_stack_push(stack, right_idx);
        bvh_stack_push(stack, left_idx);
    }

    return BvhTraversalStep {
        has_next: 1,
        node_index: node_idx,
        is_leaf: 0,
        first_prim_offset: 0,
        prim_count: 0,
    };
}
