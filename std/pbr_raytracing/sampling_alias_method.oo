// # Vose's Alias Method for O(1) Discrete Distribution Sampling
//
// Logline: Constant-time O(1) discrete random distribution sampler for large light lists and mesh triangle arrays.
//
// Setup: Preprocesses N-element arbitrary weight distributions into dual-entry probability and alias lookup tables.
//
// Beats:
//   1. Define AliasTableEntry with probability threshold q and alias bin index.
//   2. Sample discrete index in O(1) time using uniform random floats.
//   3. Compute discrete Probability Mass Function (PMF) value for selected outcome.

import "./vec3_math.oo";

pub type AliasTableEntry = struct {
    prob: Float, // Scaled probability threshold [0, 1]
    alias_index: Int,
};

pub fn alias_entry_new(prob: Float, alias_idx: Int) -> AliasTableEntry {
    return AliasTableEntry {
        prob: prob,
        alias_index: alias_idx,
    };
}

pub fn alias_sample_index(
    entry: &AliasTableEntry,
    bin_index: Int,
    u_choice: Float
) -> Int {
    if u_choice < (entry).prob {
        return bin_index;
    }
    return (entry).alias_index;
}

pub fn alias_compute_pmf(
    table_prob: Float,
    is_primary: Int,
    total_bins: Int
) -> Float {
    if total_bins <= 0 {
        return 0.0;
    }
    let mut total_f: Float = 0.0;
    let mut tb: Int = total_bins;
    while tb >= 10 { total_f = total_f + 10.0; tb = tb - 10; }
    while tb >= 1 { total_f = total_f + 1.0; tb = tb - 1; }

    let base_prob: Float = 1.0 / total_f;
    if is_primary == 1 {
        return base_prob * table_prob;
    }
    return base_prob * (1.0 - table_prob);
}
