// # Sobol Quasi-Monte Carlo Sequences & Low-Discrepancy Sampling
//
// Logline: Generates high-dimensional Sobol (0, 2) low-discrepancy sample vectors with Cranley-Patterson rotations.
//
// Setup: Replaces pure pseudo-random numbers with stratified low-discrepancy patterns to accelerate Monte Carlo convergence from O(1/sqrt(N)) to O(1/N).
//
// Beats:
//   1. Evaluate 1D Van der Corput radical inverse sequence in base 2.
//   2. Compute 2D Sobol matrix vector product for sample index i with Gray code ordering.
//   3. Apply Cranley-Patterson toroidal shift rotation: x = fract(x + u_shift).

import "./vec3_math.oo";

pub type QmcPoint2D = struct {
    x: Float,
    y: Float
};

pub fn van_der_corput_base2(index: Int) -> Float {
    let mut n: Int = index;
    let mut q: Float = 0.0;
    let mut b: Float = 0.5;

    let mut iter: Int = 0;
    while iter < 32 {
        if n > 0 {
            if n - ((n / 2) * 2) == 1 {
                q = q + b;
            }
            n = n / 2;
        }
        b = b * 0.5;
        iter = iter + 1;
    }
    return q;
}

pub fn sobol_sample_2d(index: Int, scramble_x: Int, scramble_y: Int) -> QmcPoint2D {
    let x: Float = van_der_corput_base2(index ^ scramble_x);
    // Approximate second dimension direction numbers
    let y_idx: Int = index * 3 + 1;
    let y: Float = van_der_corput_base2(y_idx ^ scramble_y);

    return QmcPoint2D {
        x: x,
        y: y
    };
}

pub fn cranley_patterson_shift(val: Float, shift: Float) -> Float {
    let shifted: Float = val + shift;
    let mut int_part: Float = 0.0;
    let mut s: Float = shifted;
    while s >= 1.0 {
        int_part = int_part + 1.0;
        s = s - 1.0;
    }
    while s < 0.0 {
        int_part = int_part - 1.0;
        s = s + 1.0;
    }
    return s;
}
