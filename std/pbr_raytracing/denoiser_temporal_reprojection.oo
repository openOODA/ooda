// # Temporal Radiance Reprojection & Variance Clipping
//
// Logline: Temporal accumulation filter with 2D motion vector reprojection, history clamping, and variance box clipping.
//
// Setup: Re-uses radiance samples across sequential animation frames to drastically reduce real-time ray tracing noise.
//
// Beats:
//   1. Define MotionVector2D and TemporalAccumulationState with history length and alpha blend factor.
//   2. Reproject pixel coordinate (x, y) into previous frame using motion vectors.
//   3. Clip historical color to 3x3 local neighborhood AABB bounding box and blend: C_curr = alpha * C_new + (1 - alpha) * C_hist.

import "./vec3_math.oo";

pub type MotionVector2D = struct {
    dx: Float,
    dy: Float,
};

pub type TemporalBlendParams = struct {
    alpha: Float, // Exponential moving average weight (e.g. 0.1 for current, 0.9 for history)
    max_history_length: Int,
    color_box_sigma: Float,
};

pub fn temporal_params_default() -> TemporalBlendParams {
    return TemporalBlendParams {
        alpha: 0.1,
        max_history_length: 32,
        color_box_sigma: 1.5,
    };
}

pub fn temporal_clip_color_box(
    history_col: &Vec3,
    color_min: &Vec3,
    color_max: &Vec3
) -> Vec3 {
    let mut cx: Float = (history_col).x;
    let mut cy: Float = (history_col).y;
    let mut cz: Float = (history_col).z;

    if cx < (color_min).x { cx = (color_min).x; }
    if cx > (color_max).x { cx = (color_max).x; }

    if cy < (color_min).y { cy = (color_min).y; }
    if cy > (color_max).y { cy = (color_max).y; }

    if cz < (color_min).z { cz = (color_min).z; }
    if cz > (color_max).z { cz = (color_max).z; }

    return Vec3 { x: cx, y: cy, z: cz };
}

pub fn temporal_accumulate(
    current_col: &Vec3,
    history_col: &Vec3,
    color_min: &Vec3,
    color_max: &Vec3,
    params: &TemporalBlendParams
) -> Vec3 {
    let clipped_hist: Vec3 = temporal_clip_color_box(history_col, color_min, color_max);
    let a: Float = (params).alpha;

    let part_curr: Vec3 = vec3_scale(current_col, a);
    let part_hist: Vec3 = vec3_scale(&clipped_hist, 1.0 - a);

    return vec3_add(&part_curr, &part_hist);
}
