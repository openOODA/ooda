// # Bidirectional Path Tracing (BDPT) Vertex Connection
//
// Logline: Bidirectional subpath vertex connection evaluating generalized geometric coupling factors G(x, y) and MIS weights.
//
// Setup: Traces simultaneous subpaths from camera lenses and light emitters for robust caustics and indoor illumination.
//
// Beats:
//   1. Define PathVertex structure with spatial position, normal, incoming/outgoing directions, and throughput.
//   2. Compute geometric coupling factor: G(x, y) = (|n_x.d| * |n_y.d|) / ||x - y||^2.
//   3. Connect eye vertex (s) and light vertex (t) with visibility test and multi-technique MIS weighting.

import "./vec3_math.oo";
import "./ray_primitive.oo";

pub type PathVertex = struct {
    point: Vec3,
    normal: Vec3,
    throughput: Vec3,
    pdf_fwd: Float,
    pdf_rev: Float,
    is_on_surface: Int,
};

pub fn bdpt_vertex_new(p: Vec3, n: Vec3, throughput: Vec3) -> PathVertex {
    return PathVertex {
        point: p,
        normal: n,
        throughput: throughput,
        pdf_fwd: 1.0,
        pdf_rev: 1.0,
        is_on_surface: 1,
    };
}

pub fn bdpt_geometry_factor(v_eye: &PathVertex, v_light: &PathVertex) -> Float {
    let d: Vec3 = vec3_sub(&(v_light).point, &(v_eye).point);
    let dist_sq: Float = vec3_length_squared(&d);
    if dist_sq <= 0.00001 {
        return 0.0;
    }
    let dist: Float = math_sqrt(dist_sq);
    let dir: Vec3 = vec3_scale(&d, 1.0 / dist);

    let mut cos_eye: Float = vec3_dot(&(v_eye).normal, &dir);
    if cos_eye < 0.0 { cos_eye = 0.0 - cos_eye; }

    let mut cos_light: Float = 0.0 - vec3_dot(&(v_light).normal, &dir);
    if cos_light < 0.0 { cos_light = 0.0 - cos_light; }

    return (cos_eye * cos_light) / dist_sq;
}

pub fn bdpt_connect_vertices(
    v_eye: &PathVertex,
    v_light: &PathVertex,
    bsdf_eye: &Vec3,
    bsdf_light: &Vec3
) -> Vec3 {
    let g: Float = bdpt_geometry_factor(v_eye, v_light);
    if g <= 0.0 {
        return vec3_zero();
    }

    let tp: Vec3 = vec3_mul(&(v_eye).throughput, &(v_light).throughput);
    let bsdf_prod: Vec3 = vec3_mul(bsdf_eye, bsdf_light);
    let combined: Vec3 = vec3_mul(&tp, &bsdf_prod);

    return vec3_scale(&combined, g);
}
