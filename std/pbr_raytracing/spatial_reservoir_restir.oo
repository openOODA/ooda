// # Spatio-Temporal Reservoir Sampling (ReSTIR)
//
// Logline: Spatio-temporal reservoir sampling (ReSTIR DI/GI) streaming candidate lights with O(1) memory and spatial reuse.
//
// Setup: Bitterli et al. Reservoir-based Spatio-Temporal Importance Resampling for millions of dynamic area lights.
//
// Beats:
//   1. Define Reservoir structure with candidate sample ID, weight sum w_sum, candidate count M, and final weight W.
//   2. Update reservoir with new candidate sample: if u < w_cand / w_sum then y = y_cand.
//   3. Merge neighbor reservoirs during spatial/temporal reuse passes and compute unbiased estimator weights.

import "./vec3_math.oo";

pub type LightReservoir = struct {
    selected_sample_id: Int,
    weight_sum: Float,
    candidate_count: Int,
    w_estimator: Float
};

pub fn reservoir_new() -> LightReservoir {
    return LightReservoir {
        selected_sample_id: -1,
        weight_sum: 0.0,
        candidate_count: 0,
        w_estimator: 0.0
    };
}

pub fn reservoir_update(
    res: &mut LightReservoir,
    candidate_id: Int,
    weight: Float,
    u_random: Float
) -> Int {
    (res).weight_sum = (res).weight_sum + weight;
    (res).candidate_count = (res).candidate_count + 1;

    let prob: Float = weight / (res).weight_sum;
    if u_random < prob {
        (res).selected_sample_id = candidate_id;
        return 1;
    }
    return 0;
}

pub fn reservoir_merge(
    target_res: &mut LightReservoir,
    source_res: &LightReservoir,
    source_target_p_hat: Float,
    u_random: Float
) {
    let weight: Float = source_target_p_hat * (source_res).w_estimator * ((source_res).candidate_count * 1.0);
    reservoir_update(target_res, (source_res).selected_sample_id, weight, u_random);
    (target_res).candidate_count = (target_res).candidate_count + (source_res).candidate_count - 1;
}

pub fn reservoir_finalize_weight(
    res: &mut LightReservoir,
    p_hat_selected: Float
) {
    if p_hat_selected <= 0.000001 || (res).candidate_count <= 0 {
        (res).w_estimator = 0.0;
        return;
    }
    let mut m_f: Float = 0.0;
    let mut c: Int = (res).candidate_count;
    while c >= 10 { m_f = m_f + 10.0; c = c - 10; }
    while c >= 1 { m_f = m_f + 1.0; c = c - 1; }

    (res).w_estimator = (res).weight_sum / (m_f * p_hat_selected);
}
