// # Oren-Nayar Rough Diffuse BRDF Model
//
// Logline: Comprehensive Oren-Nayar microfacet diffuse reflectance accounting for surface roughness, retro-reflection, and inter-facet shadows.
//
// Setup: Realistic diffuse scattering for clay, chalk, stone, concrete, and lunar regolith.
//
// Beats:
//   1. Define OrenNayarParams with albedo RGB and surface standard deviation sigma (roughness).
//   2. Compute Oren-Nayar A and B coefficients: A = 1 - 0.5 * sigma^2 / (sigma^2 + 0.33), B = 0.45 * sigma^2 / (sigma^2 + 0.09).
//   3. Evaluate azimuthal difference cos(phi_i - phi_r) and max(0, cos(phi_diff)) * sin(alpha) * tan(beta).

import "./vec3_math.oo";

pub type OrenNayarParams = struct {
    albedo: Vec3,
    sigma: Float, // Roughness angle in radians (e.g. 0.0 to 0.5)
};

pub fn oren_nayar_eval(
    l: &Vec3,
    v: &Vec3,
    n: &Vec3,
    params: &OrenNayarParams
) -> Vec3 {
    let n_dot_l: Float = vec3_dot(n, l);
    let n_dot_v: Float = vec3_dot(n, v);

    if n_dot_l <= 0.0 || n_dot_v <= 0.0 {
        return vec3_zero();
    }

    let s2: Float = (params).sigma * (params).sigma;
    let a: Float = 1.0 - 0.5 * (s2 / (s2 + 0.33));
    let b: Float = 0.45 * (s2 / (s2 + 0.09));

    // Azimuthal difference term
    let l_proj: Vec3 = vec3_sub(l, &vec3_scale(n, n_dot_l));
    let v_proj: Vec3 = vec3_sub(v, &vec3_scale(n, n_dot_v));
    let l_proj_len: Float = vec3_length(&l_proj);
    let v_proj_len: Float = vec3_length(&v_proj);

    let mut cos_phi_diff: Float = 0.0;
    if l_proj_len > 0.0001 && v_proj_len > 0.0001 {
        cos_phi_diff = vec3_dot(&l_proj, &v_proj) / (l_proj_len * v_proj_len);
    }
    if cos_phi_diff < 0.0 {
        cos_phi_diff = 0.0;
    }

    // Determine alpha and beta (max and min of theta_i, theta_r)
    let sin_alpha: Float = 0.0;
    let tan_beta: Float = 0.0;

    let sin_l: Float = math_sqrt(1.0 - n_dot_l * n_dot_l);
    let sin_v: Float = math_sqrt(1.0 - n_dot_v * n_dot_v);

    let mut term: Float = 0.0;
    if n_dot_l >= n_dot_v {
        // theta_v > theta_l, so alpha = theta_v, beta = theta_l
        let s_a: Float = sin_v;
        let t_b: Float = sin_l / n_dot_l;
        term = s_a * t_b;
    } else {
        let s_a: Float = sin_l;
        let t_b: Float = sin_v / n_dot_v;
        term = s_a * t_b;
    }

    let inv_pi: Float = 0.31830988618;
    let brdf_scalar: Float = inv_pi * (a + b * cos_phi_diff * term);
    return vec3_scale(&(params).albedo, brdf_scalar);
}
