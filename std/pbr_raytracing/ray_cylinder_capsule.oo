// # Ray-Cylinder & Ray-Capsule Geometric Intersections
//
// Logline: Finite capped cylinders and rounded capsule primitives for geometric primitives and curve geometry.
//
// Setup: Closed-form algebraic intersection solutions for cylinder bodies, endcap planar disks, and hemispherical capsule caps.
//
// Beats:
//   1. Define Cylinder and Capsule geometric structures.
//   2. Solve 2D projection quadratic intersection for finite open cylinders and cap planar disks.
//   3. Compute capsule intersection with combined cylinder body and endpoint spheres.

import "./vec3_math.oo";
import "./ray_primitive.oo";

pub type Cylinder = struct {
    p0: Vec3,
    p1: Vec3,
    radius: Float,
    material_id: Int,
};

pub type Capsule = struct {
    p0: Vec3,
    p1: Vec3,
    radius: Float,
    material_id: Int,
};

pub type GeomHit = struct {
    hit: Int,
    t: Float,
    point: Vec3,
    normal: Vec3,
};

pub fn cylinder_new(p0: Vec3, p1: Vec3, radius: Float, material_id: Int) -> Cylinder {
    return Cylinder {
        p0: p0,
        p1: p1,
        radius: radius,
        material_id: material_id,
    };
}

pub fn capsule_new(p0: Vec3, p1: Vec3, radius: Float, material_id: Int) -> Capsule {
    return Capsule {
        p0: p0,
        p1: p1,
        radius: radius,
        material_id: material_id,
    };
}

pub fn cylinder_intersect(cyl: &Cylinder, ray: &Ray) -> GeomHit {
    let axis: Vec3 = vec3_sub(&(cyl).p1, &(cyl).p0);
    let len: Float = vec3_length(&axis);
    if len < 0.0001 {
        return GeomHit { hit: 0, t: 0.0, point: vec3_zero(), normal: vec3_zero() };
    }
    let u_axis: Vec3 = vec3_normalize(&axis);
    let rc: Vec3 = vec3_sub(&(ray).origin, &(cyl).p0);

    let d_proj: Vec3 = vec3_sub(&(ray).direction, &vec3_scale(&u_axis, vec3_dot(&(ray).direction, &u_axis)));
    let rc_proj: Vec3 = vec3_sub(&rc, &vec3_scale(&u_axis, vec3_dot(&rc, &u_axis)));

    let a: Float = vec3_dot(&d_proj, &d_proj);
    let b: Float = 2.0 * vec3_dot(&d_proj, &rc_proj);
    let c: Float = vec3_dot(&rc_proj, &rc_proj) - (cyl).radius * (cyl).radius;

    let disc: Float = b * b - 4.0 * a * c;
    if disc < 0.0 || a < 0.000001 {
        return GeomHit { hit: 0, t: 0.0, point: vec3_zero(), normal: vec3_zero() };
    }

    let sqrt_d: Float = math_sqrt(disc);
    let t0: Float = (0.0 - b - sqrt_d) / (2.0 * a);
    let t1: Float = (0.0 - b + sqrt_d) / (2.0 * a);

    let mut t: Float = t0;
    if t < (ray).t_min || t > (ray).t_max {
        t = t1;
        if t < (ray).t_min || t > (ray).t_max {
            return GeomHit { hit: 0, t: 0.0, point: vec3_zero(), normal: vec3_zero() };
        }
    }

    let p: Vec3 = ray_point_at(ray, t);
    let h: Float = vec3_dot(&vec3_sub(&p, &(cyl).p0), &u_axis);
    if h < 0.0 || h > len {
        return GeomHit { hit: 0, t: 0.0, point: vec3_zero(), normal: vec3_zero() };
    }

    let pt_on_axis: Vec3 = vec3_add(&(cyl).p0, &vec3_scale(&u_axis, h));
    let normal: Vec3 = vec3_normalize(&vec3_sub(&p, &pt_on_axis));

    return GeomHit {
        hit: 1,
        t: t,
        point: p,
        normal: normal,
    };
}
