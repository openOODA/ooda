// # Robotic Manipulator Kinematics
//
// Logline: Planar 2-DoF and 3-DoF serial manipulator forward/inverse kinematics and Jacobian analysis.
//
// Setup: Pure geometric arm kinematics algorithms.
//
// Beats:
//   1. Construct Denavit-Hartenberg link representations.
//   2. Compute 2-link planar forward kinematics and elbow-up/down inverse kinematics.
//   3. Compute 2-link manipulator Jacobian and differential velocity mapping.
//   4. Compute 3-link planar manipulator forward and inverse kinematics.

import "./kinematics_types.oo";
import "./kinematics_ops.oo";

// -------------------------------------------------------------------
// Denavit-Hartenberg link constructor
// -------------------------------------------------------------------

pub fn dh_link_new(a_val: Float, alpha_val: Float, d_val: Float, theta_val: Float, kind_val: Int) -> DHLink {
    return DHLink {
        a_len:       a_val,
        alpha_angle: alpha_val,
        d_offset:    d_val,
        theta_angle: theta_val,
        joint_kind:  kind_val,
    };
}

// -------------------------------------------------------------------
// 2-DOF Arm
// -------------------------------------------------------------------

pub fn arm2d_config_new(l1_val: Float, l2_val: Float) -> Arm2DConfig {
    return Arm2DConfig { l1: l1_val, l2: l2_val };
}

pub fn arm2d_joints_new(t1_val: Float, t2_val: Float) -> Arm2DJoints {
    return Arm2DJoints { theta1: t1_val, theta2: t2_val };
}

/// Forward kinematics for 2-DOF planar robot arm: joint angles -> end-effector Vec2 position.
pub fn arm2d_fk(cfg: Arm2DConfig, joints: Arm2DJoints) -> Vec2 {
    let l1_val: Float = (cfg).l1;
    let l2_val: Float = (cfg).l2;
    let t1_val: Float = (joints).theta1;
    let t2_val: Float = (joints).theta2;

    let x_pos: Float = (l1_val * cos(t1_val)) + (l2_val * cos(t1_val + t2_val));
    let y_pos: Float = (l1_val * sin(t1_val)) + (l2_val * sin(t1_val + t2_val));

    return Vec2 { x: x_pos, y: y_pos };
}

/// Inverse kinematics for 2-DOF planar robot arm (elbow-down configuration).
pub fn arm2d_ik_elbow_down(cfg: Arm2DConfig, target_pos: Vec2) -> Arm2DIKResult {
    let l1_val: Float = (cfg).l1;
    let l2_val: Float = (cfg).l2;
    let x_pos: Float = (target_pos).x;
    let y_pos: Float = (target_pos).y;

    let r_sq: Float = (x_pos * x_pos) + (y_pos * y_pos);
    let cos_t2: Float = (r_sq - (l1_val * l1_val) - (l2_val * l2_val)) / (2.0 * l1_val * l2_val);

    if cos_t2 > 1.0 {
        return Arm2DIKResult { valid: 0, theta1: 0.0, theta2: 0.0 };
    }
    let neg_one: Float = 0.0 - 1.0;
    if cos_t2 < neg_one {
        return Arm2DIKResult { valid: 0, theta1: 0.0, theta2: 0.0 };
    }

    let sin_t2: Float = sqrt(1.0 - (cos_t2 * cos_t2));
    let t2_val: Float = math_atan2(sin_t2, cos_t2);

    let k1_val: Float = l1_val + (l2_val * cos_t2);
    let k2_val: Float = l2_val * sin_t2;
    let t1_val: Float = math_atan2(y_pos, x_pos) - math_atan2(k2_val, k1_val);

    return Arm2DIKResult {
        valid:  1,
        theta1: normalize_angle(t1_val),
        theta2: normalize_angle(t2_val),
    };
}

/// Inverse kinematics for 2-DOF planar robot arm (elbow-up configuration).
pub fn arm2d_ik_elbow_up(cfg: Arm2DConfig, target_pos: Vec2) -> Arm2DIKResult {
    let l1_val: Float = (cfg).l1;
    let l2_val: Float = (cfg).l2;
    let x_pos: Float = (target_pos).x;
    let y_pos: Float = (target_pos).y;

    let r_sq: Float = (x_pos * x_pos) + (y_pos * y_pos);
    let cos_t2: Float = (r_sq - (l1_val * l1_val) - (l2_val * l2_val)) / (2.0 * l1_val * l2_val);

    if cos_t2 > 1.0 {
        return Arm2DIKResult { valid: 0, theta1: 0.0, theta2: 0.0 };
    }
    let neg_one: Float = 0.0 - 1.0;
    if cos_t2 < neg_one {
        return Arm2DIKResult { valid: 0, theta1: 0.0, theta2: 0.0 };
    }

    let sin_t2: Float = 0.0 - sqrt(1.0 - (cos_t2 * cos_t2));
    let t2_val: Float = math_atan2(sin_t2, cos_t2);

    let k1_val: Float = l1_val + (l2_val * cos_t2);
    let k2_val: Float = l2_val * sin_t2;
    let t1_val: Float = math_atan2(y_pos, x_pos) - math_atan2(k2_val, k1_val);

    return Arm2DIKResult {
        valid:  1,
        theta1: normalize_angle(t1_val),
        theta2: normalize_angle(t2_val),
    };
}

// -------------------------------------------------------------------
// 2-DOF Arm Jacobian & Differential Kinematics
// -------------------------------------------------------------------

/// Compute 2x2 Jacobian matrix for 2-DOF planar arm.
pub fn arm2d_jacobian(cfg: Arm2DConfig, joints: Arm2DJoints) -> Arm2DJacobian {
    let l1_val: Float = (cfg).l1;
    let l2_val: Float = (cfg).l2;
    let t1_val: Float = (joints).theta1;
    let t2_val: Float = (joints).theta2;
    let t12_val: Float = t1_val + t2_val;

    let elem11: Float = (0.0 - (l1_val * sin(t1_val))) - (l2_val * sin(t12_val));
    let elem12: Float = 0.0 - (l2_val * sin(t12_val));
    let elem21: Float = (l1_val * cos(t1_val)) + (l2_val * cos(t12_val));
    let elem22: Float = l2_val * cos(t12_val);

    return Arm2DJacobian {
        j11: elem11,
        j12: elem12,
        j21: elem21,
        j22: elem22,
    };
}

/// Determinant of 2-DOF Jacobian matrix.
pub fn arm2d_jacobian_det(jac: Arm2DJacobian) -> Float {
    return ((jac).j11 * (jac).j22) - ((jac).j12 * (jac).j21);
}

/// Forward velocity kinematics: (omega1, omega2) -> end-effector velocity Vec2.
pub fn arm2d_velocity_fk(jac: Arm2DJacobian, omega1_val: Float, omega2_val: Float) -> Vec2 {
    let vx_val: Float = ((jac).j11 * omega1_val) + ((jac).j12 * omega2_val);
    let vy_val: Float = ((jac).j21 * omega1_val) + ((jac).j22 * omega2_val);
    return Vec2 { x: vx_val, y: vy_val };
}

/// Inverse velocity kinematics: end-effector velocity Vec2 -> (omega1, omega2).
pub fn arm2d_velocity_ik(jac: Arm2DJacobian, vx_val: Float, vy_val: Float) -> Arm2DJoints {
    let det_val: Float = arm2d_jacobian_det(jac);
    if math_abs(det_val) < 0.000001 {
        return Arm2DJoints { theta1: 0.0, theta2: 0.0 };
    }
    let inv_det: Float = 1.0 / det_val;
    let omega1_val: Float = (((jac).j22 * vx_val) - ((jac).j12 * vy_val)) * inv_det;
    let omega2_val: Float = (((0.0 - (jac).j21) * vx_val) + ((jac).j11 * vy_val)) * inv_det;

    return Arm2DJoints { theta1: omega1_val, theta2: omega2_val };
}

// -------------------------------------------------------------------
// 3-DOF Planar Serial Arm
// -------------------------------------------------------------------

pub fn arm3d_config_new(l1_val: Float, l2_val: Float, l3_val: Float) -> Arm3DConfig {
    return Arm3DConfig { l1: l1_val, l2: l2_val, l3: l3_val };
}

pub fn arm3d_joints_new(t1_val: Float, t2_val: Float, t3_val: Float) -> Arm3DJoints {
    return Arm3DJoints { theta1: t1_val, theta2: t2_val, theta3: t3_val };
}

/// Forward kinematics for 3-DOF planar arm -> end-effector Pose2D (x, y, orientation phi).
pub fn arm3d_fk(cfg: Arm3DConfig, joints: Arm3DJoints) -> Pose2D {
    let l1_val: Float = (cfg).l1;
    let l2_val: Float = (cfg).l2;
    let l3_val: Float = (cfg).l3;
    let t1_val: Float = (joints).theta1;
    let t2_val: Float = (joints).theta2;
    let t3_val: Float = (joints).theta3;

    let t12_val: Float = t1_val + t2_val;
    let t123_val: Float = t1_val + t2_val + t3_val;

    let x_pos: Float = (l1_val * cos(t1_val)) + (l2_val * cos(t12_val)) + (l3_val * cos(t123_val));
    let y_pos: Float = (l1_val * sin(t1_val)) + (l2_val * sin(t12_val)) + (l3_val * sin(t123_val));
    let phi_val: Float = normalize_angle(t123_val);

    return Pose2D { x: x_pos, y: y_pos, theta: phi_val };
}

/// Inverse kinematics for 3-DOF planar arm given target Pose2D (x, y, orientation phi).
pub fn arm3d_ik(cfg: Arm3DConfig, target_pose: Pose2D) -> Arm3DIKResult {
    let l1_val: Float = (cfg).l1;
    let l2_val: Float = (cfg).l2;
    let l3_val: Float = (cfg).l3;
    let target_x: Float = (target_pose).x;
    let target_y: Float = (target_pose).y;
    let target_phi: Float = (target_pose).theta;

    let wx_val: Float = target_x - (l3_val * cos(target_phi));
    let wy_val: Float = target_y - (l3_val * sin(target_phi));

    let arm2d_cfg: Arm2DConfig = arm2d_config_new(l1_val, l2_val);
    let arm2d_res: Arm2DIKResult = arm2d_ik_elbow_down(arm2d_cfg, vec2_new(wx_val, wy_val));

    if (arm2d_res).valid == 0 {
        return Arm3DIKResult { valid: 0, theta1: 0.0, theta2: 0.0, theta3: 0.0 };
    }

    let t1_val: Float = (arm2d_res).theta1;
    let t2_val: Float = (arm2d_res).theta2;
    let t3_val: Float = normalize_angle(target_phi - t1_val - t2_val);

    return Arm3DIKResult {
        valid:  1,
        theta1: t1_val,
        theta2: t2_val,
        theta3: t3_val,
    };
}
