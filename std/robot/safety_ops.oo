// # Safety Guard Operations
//
// Logline: Boundary validation, velocity limiting, proximity hazard evaluation, and watchdog timer logic.
//
// Setup: Pure algorithmic checks and stateful watchdog/proximity transitions.
//
// Beats:
//   1. Check 2D coordinates against rectangular geofence boundaries.
//   2. Clamp linear and angular speeds within safety thresholds.
//   3. Evaluate obstacle proximity distance against warning and e-stop thresholds.
//   4. Process heartbeat refresh and timeout checking for safety watchdogs.

import "./safety_types.oo";

// -------------------------------------------------------------------
// Geofence & Boundary Operations
// -------------------------------------------------------------------

pub fn geofence2d_contains(fence: Geofence2D, x: Int, y: Int) -> Bool {
    if (fence).is_active == false {
        return true;
    }
    if x < (fence).min_x {
        return false;
    }
    if x > (fence).max_x {
        return false;
    }
    if y < (fence).min_y {
        return false;
    }
    if y > (fence).max_y {
        return false;
    }
    return true;
}

// -------------------------------------------------------------------
// Speed Limit & Velocity Clamping
// -------------------------------------------------------------------

pub fn safety_clamp_speed(val: Int, max_val: Int) -> Int {
    let abs_v: Int = if val < 0 { 0 - val } else { val };
    if abs_v > max_val {
        if val < 0 {
            return 0 - max_val;
        }
        return max_val;
    }
    return val;
}

// -------------------------------------------------------------------
// Obstacle Proximity Operations
// -------------------------------------------------------------------

/// Evaluates distance measurement. Updates last_measured when active.
pub fn obstacle_proximity_evaluate(prox: ObstacleProximity, measured_mm: Int) -> ObstacleProximity {
    if (prox).is_active == false {
        return ObstacleProximity {
            stop_distance_mm: (prox).stop_distance_mm,
            warning_distance_mm: (prox).warning_distance_mm,
            last_measured_mm: (prox).last_measured_mm,
            is_active: (prox).is_active,
        };
    }
    return ObstacleProximity {
        stop_distance_mm: (prox).stop_distance_mm,
        warning_distance_mm: (prox).warning_distance_mm,
        last_measured_mm: measured_mm,
        is_active: (prox).is_active,
    };
}

/// Returns: 0 = OK, 1 = Warning, 2 = E-Stop required.
pub fn obstacle_proximity_status(prox: ObstacleProximity) -> Int {
    if (prox).is_active == false {
        return 0;
    }
    if (prox).last_measured_mm <= (prox).stop_distance_mm {
        return 2;
    }
    if (prox).last_measured_mm <= (prox).warning_distance_mm {
        return 1;
    }
    return 0;
}

// -------------------------------------------------------------------
// Safety Watchdog Operations
// -------------------------------------------------------------------

pub fn watchdog_heartbeat(wd: SafetyWatchdog, current_time_ms: Int) -> SafetyWatchdog {
    return SafetyWatchdog {
        timeout_ms: (wd).timeout_ms,
        last_heartbeat_ms: current_time_ms,
        is_tripped: false,
        is_enabled: (wd).is_enabled,
    };
}

pub fn watchdog_check(wd: SafetyWatchdog, current_time_ms: Int) -> SafetyWatchdog {
    if (wd).is_enabled == false {
        return SafetyWatchdog {
            timeout_ms: (wd).timeout_ms,
            last_heartbeat_ms: (wd).last_heartbeat_ms,
            is_tripped: (wd).is_tripped,
            is_enabled: (wd).is_enabled,
        };
    }
    if (wd).is_tripped {
        return SafetyWatchdog {
            timeout_ms: (wd).timeout_ms,
            last_heartbeat_ms: (wd).last_heartbeat_ms,
            is_tripped: true,
            is_enabled: (wd).is_enabled,
        };
    }
    let elapsed: Int = current_time_ms - (wd).last_heartbeat_ms;
    if elapsed > (wd).timeout_ms {
        return SafetyWatchdog {
            timeout_ms: (wd).timeout_ms,
            last_heartbeat_ms: (wd).last_heartbeat_ms,
            is_tripped: true,
            is_enabled: (wd).is_enabled,
        };
    }
    return SafetyWatchdog {
        timeout_ms: (wd).timeout_ms,
        last_heartbeat_ms: (wd).last_heartbeat_ms,
        is_tripped: false,
        is_enabled: (wd).is_enabled,
    };
}

pub fn watchdog_is_ok(wd: SafetyWatchdog) -> Bool {
    if (wd).is_enabled == false {
        return true;
    }
    if (wd).is_tripped {
        return false;
    }
    return true;
}
