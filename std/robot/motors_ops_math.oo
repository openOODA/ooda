// # Motor Scalar Math Utilities
//
// Logline: pi constant, abs, clamp, and angle/RPM unit conversions for motor control loops.
//
// Setup: Pure float math primitives used by all motor subsystems.
//
// Beats:
//   1. math_pi, math_abs, clamp_float.
//   2. rad_to_deg, deg_to_rad.
//   3. rpm_to_rad_s, rad_s_to_rpm.

pub fn math_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

pub fn clamp_float(val: Float, min_v: Float, max_v: Float) -> Float {
    if val < min_v {
        return min_v;
    }
    if val > max_v {
        return max_v;
    }
    return val;
}

pub fn rad_to_deg(rad: Float) -> Float {
    return (rad * 180.0) / math_pi();
}

pub fn deg_to_rad(deg: Float) -> Float {
    return (deg * math_pi()) / 180.0;
}

pub fn rpm_to_rad_s(rpm: Float) -> Float {
    return (rpm * math_pi()) / 30.0;
}

pub fn rad_s_to_rpm(rad_s: Float) -> Float {
    return (rad_s * 30.0) / math_pi();
}
