// # SLAM Data Types
//
// Logline: Data structures and constructors for 2D/3D poses, landmarks, observations, grid maps, and keyframes.
//
// Setup: Pure type definitions and value constructors with default initialization.
//
// Beats:
//   1. Define 2D and 3D pose records and velocity descriptors.
//   2. Define visual/range landmark and sensor observation containers.
//   3. Define occupancy grid map cells and keyframe pose graph records.
//   4. Define SLAM state container and hardware capability handle.

// -------------------------------------------------------------------
// Fundamental Types & Structs
// -------------------------------------------------------------------

pub type Pose2D = struct {
    x: Int,
    y: Int,
    theta_mdeg: Int
};

pub type Pose3D = struct {
    x: Int,
    y: Int,
    z: Int,
    roll_mdeg: Int,
    pitch_mdeg: Int,
    yaw_mdeg: Int
};

pub type Velocity2D = struct {
    vx: Int,
    vy: Int,
    omega_mdeg_s: Int
};

pub type Landmark = struct {
    id: Int,
    x: Int,
    y: Int,
    z: Int,
    observation_count: Int,
    confidence: Int
};

pub type Observation = struct {
    landmark_id: Int,
    range_mm: Int,
    bearing_mdeg: Int
};

pub type OccupancyCell = struct {
    x: Int,
    y: Int,
    probability: Int
};

pub type OccupancyGridMap = struct {
    width: Int,
    height: Int,
    resolution_mm: Int,
    origin_x: Int,
    origin_y: Int,
    cells: List[OccupancyCell]
};

pub type Keyframe = struct {
    id: Int,
    pose: Pose2D,
    timestamp_ms: Int,
    landmark_count: Int
};

pub type SlamState = struct {
    current_pose: Pose2D,
    landmarks: List[Landmark],
    keyframes: List[Keyframe],
    total_steps: Int,
    is_active: Bool,
    mode: Int
};

pub type Slam = struct {
    ptr: Int,
    len: Int,
    cap: &SysCap
};

// -------------------------------------------------------------------
// Constructors & Primitive Initializers
// -------------------------------------------------------------------

pub fn pose2d_new(x: Int, y: Int, theta_mdeg: Int) -> Pose2D {
    return Pose2D {
        x: x,
        y: y,
        theta_mdeg: theta_mdeg
    };
}

pub fn pose2d_zero() -> Pose2D {
    return Pose2D {
        x: 0,
        y: 0,
        theta_mdeg: 0
    };
}

pub fn pose3d_new(x: Int, y: Int, z: Int, roll: Int, pitch: Int, yaw: Int) -> Pose3D {
    return Pose3D {
        x: x,
        y: y,
        z: z,
        roll_mdeg: roll,
        pitch_mdeg: pitch,
        yaw_mdeg: yaw
    };
}

pub fn velocity2d_new(vx: Int, vy: Int, omega: Int) -> Velocity2D {
    return Velocity2D {
        vx: vx,
        vy: vy,
        omega_mdeg_s: omega
    };
}

pub fn landmark_new(id: Int, x: Int, y: Int, z: Int) -> Landmark {
    return Landmark {
        id: id,
        x: x,
        y: y,
        z: z,
        observation_count: 1,
        confidence: 500
    };
}

pub fn observation_new(landmark_id: Int, range_mm: Int, bearing_mdeg: Int) -> Observation {
    return Observation {
        landmark_id: landmark_id,
        range_mm: range_mm,
        bearing_mdeg: bearing_mdeg
    };
}

pub fn occupancy_cell_new(x: Int, y: Int, probability: Int) -> OccupancyCell {
    return OccupancyCell {
        x: x,
        y: y,
        probability: probability
    };
}

pub fn grid_map_new(width: Int, height: Int, res_mm: Int, origin_x: Int, origin_y: Int) -> OccupancyGridMap {
    let cells: List[OccupancyCell] = list_new();
    return OccupancyGridMap {
        width: width,
        height: height,
        resolution_mm: res_mm,
        origin_x: origin_x,
        origin_y: origin_y,
        cells: cells
    };
}

pub fn slam_init() -> Slam {
    return Slam { ptr: 0, len: 0, cap: 0 };
}
