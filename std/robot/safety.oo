// # Robotic Safety Facade
//
// Logline: Re-exports safety interlocks, emergency stop, geofencing, speed clamping, and watchdog monitoring.
//
// Setup: Pure module shim importing companion safety submodules.
//
// Beats:
//   1. Import safety companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

import "./safety_types.oo";
import "./safety_ops.oo";
import "./safety_engine.oo";
import "./safety_stubs.oo";

pub fn shim_marker_safety_fault() -> SafetyFault {
    return safety_fault_new(101, 2, 1000);
}

pub fn shim_marker_geofence() -> Geofence2D {
    return geofence2d_new(0, 5000, 0, 5000);
}

pub fn shim_marker_geofence_check(fence: &Geofence2D) -> Bool {
    return geofence2d_contains(fence, 100, 100);
}

pub fn shim_marker_speed_limit() -> SpeedLimitConfig {
    return speed_limit_config_default();
}

pub fn shim_marker_clamp_speed(val: Int, max_val: Int) -> Int {
    return safety_clamp_speed(val, max_val);
}

pub fn shim_marker_proximity() -> ObstacleProximity {
    return obstacle_proximity_new(300, 800);
}

pub fn shim_marker_watchdog() -> SafetyWatchdog {
    return watchdog_new(1000);
}

pub fn shim_marker_safety_monitor_init(cap: &SysCap) -> SafetyMonitor {
    return safety_monitor_init(cap);
}

pub fn shim_marker_safety_is_safe(mon: &SafetyMonitor) -> Bool {
    return safety_monitor_is_safe(mon);
}

pub fn shim_marker_safety_status(mon: &SafetyMonitor) -> Int {
    return safety_monitor_get_status(mon);
}

pub fn shim_marker_safety_hardware_estop(cap: &SysCap) -> Int {
    return safety_trigger_hardware_estop_relay(cap, 0);
}
