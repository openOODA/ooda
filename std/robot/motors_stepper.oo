// # Stepper & Servo Motor Models
//
// Logline: Stepper motor microstepping, acceleration ramps, and RC hobby servo pulse control.
//
// Setup: Stepper trajectory planning and servo angle-to-pulse transformations.
//
// Beats:
//   1. Define stepper motor configuration and runtime step tracking structures.
//   2. Implement trapezoidal stepper acceleration and target step positioning.
//   3. Define RC servo pulse width configuration and angle positioning.
//   4. Process step increments and target position tracking.

import "./motors_dc.oo";

type StepperConfig = struct {
    steps_per_rev: Float,
    microsteps: Float,
    max_speed_steps_s: Float,
    accel_steps_s2: Float,
};

type StepperState = struct {
    id: Int,
    config: StepperConfig,
    current_step: Float,
    target_step: Float,
    current_speed: Float,
    enabled: Bool,
};

pub fn stepper_init(id: Int, steps_per_rev: Float, microsteps: Float, max_speed: Float, accel: Float) -> StepperState {
    let cfg_st: StepperConfig = StepperConfig {
        steps_per_rev: steps_per_rev,
        microsteps: microsteps,
        max_speed_steps_s: max_speed,
        accel_steps_s2: accel,
    };
    return StepperState {
        id: id,
        config: cfg_st,
        current_step: 0.0,
        target_step: 0.0,
        current_speed: 0.0,
        enabled: false,
    };
}

pub fn stepper_enable(st: StepperState) -> StepperState {
    return StepperState {
        id: (st).id,
        config: (st).config,
        current_step: (st).current_step,
        target_step: (st).target_step,
        current_speed: (st).current_speed,
        enabled: true,
    };
}

pub fn stepper_disable(st: StepperState) -> StepperState {
    return StepperState {
        id: (st).id,
        config: (st).config,
        current_step: (st).current_step,
        target_step: (st).target_step,
        current_speed: 0.0,
        enabled: false,
    };
}

pub fn stepper_step_to(st: StepperState, target_step: Float) -> StepperState {
    return StepperState {
        id: (st).id,
        config: (st).config,
        current_step: (st).current_step,
        target_step: target_step,
        current_speed: (st).current_speed,
        enabled: (st).enabled,
    };
}

pub fn stepper_update(st: StepperState, dt: Float) -> StepperState {
    if (st).enabled == false {
        return st;
    }
    if dt < 0.000001 {
        return st;
    }

    let tgt_val: Float = (st).target_step;
    let cur_val: Float = (st).current_step;
    let step_diff: Float = tgt_val - cur_val;
    if math_abs(step_diff) < 0.000001 {
        return StepperState {
            id: (st).id,
            config: (st).config,
            current_step: (st).current_step,
            target_step: (st).target_step,
            current_speed: 0.0,
            enabled: (st).enabled,
        };
    }

    let dir_val: Float = if step_diff < 0.0 { 0.0 - 1.0 } else { 1.0 };

    let max_s: Float = (st).config.max_speed_steps_s;
    let target_speed: Float = dir_val * max_s;

    let accel_val: Float = (st).config.accel_steps_s2;
    let speed_change: Float = accel_val * dt;

    let cur_spd: Float = (st).current_speed;
    let accel_up: Float = clamp_float(cur_spd + speed_change, 0.0 - max_s, target_speed);
    let accel_dn: Float = clamp_float(cur_spd - speed_change, target_speed, max_s);
    let new_spd: Float = if cur_spd < target_speed { accel_up } else { accel_dn };

    let delta_s: Float = new_spd * dt;
    return StepperState {
        id: (st).id,
        config: (st).config,
        current_step: (st).current_step + delta_s,
        target_step: (st).target_step,
        current_speed: new_spd,
        enabled: (st).enabled,
    };
}

pub fn stepper_get_position_deg(st_ref: StepperState) -> Float {
    let rev_steps: Float = (st_ref).config.steps_per_rev;
    let micro_steps: Float = (st_ref).config.microsteps;
    let total_steps: Float = rev_steps * micro_steps;
    if total_steps <= 0.0 {
        return 0.0;
    }
    let cur_st: Float = (st_ref).current_step;
    return (cur_st * 360.0) / total_steps;
}

// -------------------------------------------------------------------
// RC Servo Motor Controller
// -------------------------------------------------------------------

type ServoConfig = struct {
    min_pulse_us: Float,
    max_pulse_us: Float,
    max_angle_deg: Float,
};

type ServoState = struct {
    id: Int,
    config: ServoConfig,
    current_angle_deg: Float,
    target_angle_deg: Float,
    pulse_width_us: Float,
    enabled: Bool,
};

pub fn servo_init(id: Int, min_pulse_us: Float, max_pulse_us: Float, max_angle_deg: Float) -> ServoState {
    let cfg_sv: ServoConfig = ServoConfig {
        min_pulse_us: min_pulse_us,
        max_pulse_us: max_pulse_us,
        max_angle_deg: max_angle_deg,
    };
    let mid_pulse: Float = min_pulse_us + ((max_pulse_us - min_pulse_us) * 0.5);
    return ServoState {
        id: id,
        config: cfg_sv,
        current_angle_deg: max_angle_deg * 0.5,
        target_angle_deg: max_angle_deg * 0.5,
        pulse_width_us: mid_pulse,
        enabled: false,
    };
}

pub fn servo_enable(sv: ServoState) -> ServoState {
    return ServoState {
        id: (sv).id,
        config: (sv).config,
        current_angle_deg: (sv).current_angle_deg,
        target_angle_deg: (sv).target_angle_deg,
        pulse_width_us: (sv).pulse_width_us,
        enabled: true,
    };
}

pub fn servo_disable(sv: ServoState) -> ServoState {
    return ServoState {
        id: (sv).id,
        config: (sv).config,
        current_angle_deg: (sv).current_angle_deg,
        target_angle_deg: (sv).target_angle_deg,
        pulse_width_us: (sv).pulse_width_us,
        enabled: false,
    };
}

pub fn servo_set_angle(sv: ServoState, angle_deg: Float) -> ServoState {
    let max_a: Float = (sv).config.max_angle_deg;
    let clamped_angle: Float = clamp_float(angle_deg, 0.0, max_a);
    return ServoState {
        id: (sv).id,
        config: (sv).config,
        current_angle_deg: (sv).current_angle_deg,
        target_angle_deg: clamped_angle,
        pulse_width_us: (sv).pulse_width_us,
        enabled: (sv).enabled,
    };
}

pub fn servo_update(sv: ServoState, dt: Float) -> ServoState {
    if (sv).enabled == false {
        return sv;
    }

    let max_change: Float = 180.0 * dt;
    let tgt_val: Float = (sv).target_angle_deg;
    let cur_val: Float = (sv).current_angle_deg;
    let angle_diff: Float = tgt_val - cur_val;

    let stepped: Float = if angle_diff > 0.0 { cur_val + max_change } else { cur_val - max_change };
    let new_ang: Float = if math_abs(angle_diff) <= max_change { tgt_val } else { stepped };

    let max_ang: Float = (sv).config.max_angle_deg;
    let fraction_val: Float = new_ang / max_ang;
    let min_p: Float = (sv).config.min_pulse_us;
    let max_p: Float = (sv).config.max_pulse_us;
    let pulse_range: Float = max_p - min_p;
    return ServoState {
        id: (sv).id,
        config: (sv).config,
        current_angle_deg: new_ang,
        target_angle_deg: (sv).target_angle_deg,
        pulse_width_us: min_p + (fraction_val * pulse_range),
        enabled: (sv).enabled,
    };
}

pub fn servo_get_pulse_width(sv_ref: ServoState) -> Float {
    return (sv_ref).pulse_width_us;
}
