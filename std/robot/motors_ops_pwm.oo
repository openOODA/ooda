// # Motor PWM Signal Generation
//
// Logline: PwmConfig frequency/duty synthesis and duty-cycle-to-voltage conversion.
//
// Setup: Pure float PWM configuration and voltage conversion; uses clamp_float from motors_ops_math.
//
// Beats:
//   1. PwmConfig: frequency_hz, duty_cycle, inverted flag.
//   2. pwm_config_new: clamp duty to [0,1].
//   3. pwm_to_voltage: invert if needed and scale to max_voltage.

import "./motors_ops_math.oo";

type PwmConfig = struct {
    frequency_hz: Float,
    duty_cycle: Float,
    inverted: Bool
};

pub fn pwm_config_new(frequency_hz: Float, duty_cycle: Float, inverted: Bool) -> PwmConfig {
    let clamped_duty: Float = clamp_float(duty_cycle, 0.0, 1.0);
    return PwmConfig {
        frequency_hz: frequency_hz,
        duty_cycle: clamped_duty,
        inverted: inverted
    };
}

pub fn pwm_to_voltage(cfg_pwm: PwmConfig, max_voltage: Float) -> Float {
    let duty_raw: Float = cfg_pwm.duty_cycle;
    let d_val: Float = if cfg_pwm.inverted { 1.0 - duty_raw } else { duty_raw };
    return d_val * max_voltage;
}
