// # SLAM Facade
//
// Logline: Re-exports simultaneous localization and mapping types, fixed-point math, occupancy grids, and engine.
//
// Setup: Pure module shim importing companion SLAM submodules.
//
// Beats:
//   1. Import SLAM companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

import "./slam_types.oo";
import "./slam_ops.oo";
import "./slam_map.oo";
import "./slam_engine.oo";
import "./slam_stubs.oo";

pub fn shim_marker_pose2d_new() -> Pose2D {
    return pose2d_new(0, 0, 0);
}

pub fn shim_marker_pose3d_new() -> Pose3D {
    return pose3d_new(0, 0, 0, 0, 0, 0);
}

pub fn shim_marker_velocity2d_new() -> Velocity2D {
    return velocity2d_new(100, 0, 0);
}

pub fn shim_marker_landmark_new() -> Landmark {
    return landmark_new(1, 1000, 2000, 0);
}

pub fn shim_marker_observation_new() -> Observation {
    return observation_new(1, 1500, 30000);
}

pub fn shim_marker_occupancy_cell_new() -> OccupancyCell {
    return occupancy_cell_new(0, 0, 50);
}

pub fn shim_marker_grid_map_new() -> OccupancyGridMap {
    return grid_map_new(100, 100, 50, 0, 0);
}

pub fn shim_marker_slam_sin(mdeg: Int) -> Int {
    return slam_sin_mdeg(mdeg);
}

pub fn shim_marker_slam_cos(mdeg: Int) -> Int {
    return slam_cos_mdeg(mdeg);
}

pub fn shim_marker_slam_atan2(y: Int, x: Int) -> Int {
    return slam_atan2_mdeg(y, x);
}

pub fn shim_marker_predict_pose(p: Pose2D) -> Pose2D {
    return slam_predict_pose(p, 10, 0, 0);
}

pub fn shim_marker_grid_world_to_grid(map: &OccupancyGridMap, x: Int) -> Int {
    return grid_map_world_to_grid_x(map, x);
}

pub fn shim_marker_slam_engine_new() -> SlamState {
    return slam_engine_new();
}

pub fn shim_marker_slam_init() -> Slam {
    return slam_init();
}

pub fn shim_marker_slam_do_work(s: &Slam) -> Int {
    return slam_do_work(s);
}

pub fn shim_marker_slam_hardware(s: &Slam, cap: &SysCap) -> Int {
    return slam_stream_raw_hardware(s, cap);
}
