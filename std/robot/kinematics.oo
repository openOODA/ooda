// # Kinematics Facade
//
// Logline: Re-exports robot kinematics types, geometric math, mobile drive models, and serial manipulator algorithms.
//
// Setup: Pure module shim importing companion kinematics submodules.
//
// Beats:
//   1. Import kinematics companion submodules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

import "./kinematics_types.oo";
import "./kinematics_ops.oo";
import "./kinematics_mobile.oo";
import "./kinematics_arm.oo";
import "./kinematics_engine.oo";

pub fn shim_marker_vec2_new() -> Vec2 {
    return vec2_new(1.0, 2.0);
}

pub fn shim_marker_vec2_add(a_v: Vec2, b_v: Vec2) -> Vec2 {
    return vec2_add(a_v, b_v);
}

pub fn shim_marker_pose2d_new() -> Pose2D {
    return pose2d_new(0.0, 0.0, 0.0);
}

pub fn shim_marker_twist2d_new() -> Twist2D {
    return twist2d_new(1.0, 0.0, 0.0);
}

pub fn shim_marker_math_pi() -> Float {
    return math_pi();
}

pub fn shim_marker_normalize_angle() -> Float {
    return normalize_angle(3.5);
}

pub fn shim_marker_math_atan2() -> Float {
    return math_atan2(1.0, 1.0);
}

pub fn shim_marker_diff_fk() -> Twist2D {
    let cfg: DiffDriveConfig = diff_drive_config_new(0.1, 0.5);
    let wh: DiffDriveWheelSpeeds = diff_drive_wheel_speeds_new(1.0, 1.0);
    return diff_drive_fk(cfg, wh);
}

pub fn shim_marker_diff_ik(cfg: DiffDriveConfig, tw: Twist2D) -> DiffDriveWheelSpeeds {
    return diff_drive_ik(cfg, tw);
}

pub fn shim_marker_diff_odom(pose_v: Pose2D, wh: DiffDriveWheelSpeeds, cfg: DiffDriveConfig) -> Pose2D {
    return diff_drive_odometry_update(pose_v, wh, cfg, 0.1);
}

pub fn shim_marker_ackermann_fk(cfg: AckermannConfig, st: AckermannState) -> Twist2D {
    return ackermann_fk(cfg, st);
}

pub fn shim_marker_ackermann_ik(cfg: AckermannConfig, tw: Twist2D) -> AckermannState {
    return ackermann_ik(cfg, tw);
}

pub fn shim_marker_mecanum_fk(cfg: MecanumConfig, wh: MecanumWheelSpeeds) -> Twist2D {
    return mecanum_fk(cfg, wh);
}

pub fn shim_marker_mecanum_ik(cfg: MecanumConfig, tw: Twist2D) -> MecanumWheelSpeeds {
    return mecanum_ik(cfg, tw);
}

pub fn shim_marker_arm2d_fk(cfg: Arm2DConfig, jv: Arm2DJoints) -> Vec2 {
    return arm2d_fk(cfg, jv);
}

pub fn shim_marker_arm2d_ik_down(cfg: Arm2DConfig, target_v: Vec2) -> Arm2DIKResult {
    return arm2d_ik_elbow_down(cfg, target_v);
}

pub fn shim_marker_arm2d_ik_up(cfg: Arm2DConfig, target_v: Vec2) -> Arm2DIKResult {
    return arm2d_ik_elbow_up(cfg, target_v);
}

pub fn shim_marker_arm2d_jacobian(cfg: Arm2DConfig, jv: Arm2DJoints) -> Arm2DJacobian {
    return arm2d_jacobian(cfg, jv);
}

pub fn shim_marker_arm2d_velocity_fk(jac: Arm2DJacobian) -> Vec2 {
    return arm2d_velocity_fk(jac, 0.1, 0.1);
}

pub fn shim_marker_arm2d_velocity_ik(jac: Arm2DJacobian) -> Arm2DJoints {
    return arm2d_velocity_ik(jac, 0.1, 0.0);
}

pub fn shim_marker_arm3d_fk(cfg: Arm3DConfig, jv: Arm3DJoints) -> Pose2D {
    return arm3d_fk(cfg, jv);
}

pub fn shim_marker_arm3d_ik(cfg: Arm3DConfig, target_p: Pose2D) -> Arm3DIKResult {
    return arm3d_ik(cfg, target_p);
}

pub fn shim_marker_dh_link_new() -> DHLink {
    return dh_link_new(1.0, 0.0, 0.0, 0.0, 0);
}

pub fn shim_marker_engine_is_valid(engine_ref: &KinematicsEngine) -> Int {
    return kinematics_engine_is_valid(engine_ref);
}
