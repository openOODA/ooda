// # Locomotion Data Types
//
// Logline: Data structures and constructors for robot locomotion, drive geometry, legged gaits, and PID control.
//
// Setup: Pure type definitions and value constructors with default parameters.
//
// Beats:
//   1. Define 3D vector, twist, and 6-DoF pose representations.
//   2. Define kinematic configuration records for differential, Ackermann, and Mecanum bases.
//   3. Define quadruped gait state and planar leg joint records.
//   4. Define PID controller state and locomotion subsystem container.

// -------------------------------------------------------------------
// Core Geometric & Motion Types
// -------------------------------------------------------------------

pub type Vec3 = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

pub fn vec3_zero() -> Vec3 {
    return Vec3 { x: 0.0, y: 0.0, z: 0.0 };
}

pub fn vec3_add(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3 {
        x: (a).x + (b).x,
        y: (a).y + (b).y,
        z: (a).z + (b).z,
    };
}

pub fn vec3_sub(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3 {
        x: (a).x - (b).x,
        y: (a).y - (b).y,
        z: (a).z - (b).z,
    };
}

pub fn vec3_scale(v: Vec3, s: Float) -> Vec3 {
    return Vec3 {
        x: (v).x * s,
        y: (v).y * s,
        z: (v).z * s,
    };
}

pub fn vec3_length_sq(v: Vec3) -> Float {
    return (((v).x * (v).x) + ((v).y * (v).y)) + ((v).z * (v).z);
}

pub fn vec3_length(v: Vec3) -> Float {
    return sqrt(vec3_length_sq(v));
}

pub type Twist = struct {
    linear: Vec3,
    angular: Vec3,
};

pub fn twist_new(vx: Float, vy: Float, vz: Float, wx: Float, wy: Float, wz: Float) -> Twist {
    return Twist {
        linear: vec3_new(vx, vy, vz),
        angular: vec3_new(wx, wy, wz),
    };
}

pub fn twist_zero() -> Twist {
    return Twist {
        linear: vec3_zero(),
        angular: vec3_zero(),
    };
}

pub type Pose3D = struct {
    pos: Vec3,
    orient: Vec3,
};

pub fn pose3d_new(pos: Vec3, orient: Vec3) -> Pose3D {
    return Pose3D { pos: pos, orient: orient };
}

pub fn pose3d_zero() -> Pose3D {
    return Pose3D { pos: vec3_zero(), orient: vec3_zero() };
}

pub type WheelSpeeds = struct {
    w1: Float,
    w2: Float,
    w3: Float,
    w4: Float,
};

// -------------------------------------------------------------------
// Kinematic Drive Models
// -------------------------------------------------------------------

pub type DiffDriveKinematics = struct {
    wheel_radius: Float,
    track_width: Float,
    max_wheel_speed: Float,
};

pub fn diff_drive_new(wheel_radius: Float, track_width: Float, max_wheel_speed: Float) -> DiffDriveKinematics {
    return DiffDriveKinematics {
        wheel_radius: wheel_radius,
        track_width: track_width,
        max_wheel_speed: max_wheel_speed,
    };
}

pub type AckermannKinematics = struct {
    wheelbase: Float,
    track_width: Float,
    max_steer_angle: Float,
    wheel_radius: Float,
};

pub fn ackermann_new(wheelbase: Float, track_width: Float, max_steer_angle: Float, wheel_radius: Float) -> AckermannKinematics {
    return AckermannKinematics {
        wheelbase: wheelbase,
        track_width: track_width,
        max_steer_angle: max_steer_angle,
        wheel_radius: wheel_radius,
    };
}

pub type MecanumKinematics = struct {
    wheelbase: Float,
    track_width: Float,
    wheel_radius: Float,
};

pub fn mecanum_new(wheelbase: Float, track_width: Float, wheel_radius: Float) -> MecanumKinematics {
    return MecanumKinematics {
        wheelbase: wheelbase,
        track_width: track_width,
        wheel_radius: wheel_radius,
    };
}

// -------------------------------------------------------------------
// Legged Gait Types
// -------------------------------------------------------------------

pub type LegJoints = struct {
    hip_pitch: Float,
    hip_roll: Float,
    knee_pitch: Float,
};

pub fn leg_joints_new(hip_pitch: Float, hip_roll: Float, knee_pitch: Float) -> LegJoints {
    return LegJoints {
        hip_pitch: hip_pitch,
        hip_roll: hip_roll,
        knee_pitch: knee_pitch,
    };
}

pub type QuadrupedGaitState = struct {
    gait_type: Int,
    step_height: Float,
    duty_cycle: Float,
    frequency_hz: Float,
    phase: Float,
};

pub fn quadruped_gait_init(gait_type: Int, step_height: Float, frequency_hz: Float) -> QuadrupedGaitState {
    return QuadrupedGaitState {
        gait_type: gait_type,
        step_height: step_height,
        duty_cycle: 0.5,
        frequency_hz: frequency_hz,
        phase: 0.0,
    };
}

// -------------------------------------------------------------------
// PID Controller & Locomotion Containers
// -------------------------------------------------------------------

pub type PidController = struct {
    kp: Float,
    ki: Float,
    kd: Float,
    integral_accum: Float,
    prev_error: Float,
    output_limit: Float,
};

pub fn pid_init(kp: Float, ki: Float, kd: Float, limit: Float) -> PidController {
    return PidController {
        kp: kp,
        ki: ki,
        kd: kd,
        integral_accum: 0.0,
        prev_error: 0.0,
        output_limit: limit,
    };
}

pub type LocomotionConfig = struct {
    drive_type: Int,
    max_linear_speed: Float,
    max_angular_speed: Float,
    max_accel: Float,
    wheel_radius: Float,
    track_width: Float,
    wheelbase: Float,
};

pub fn locomotion_config_default() -> LocomotionConfig {
    return LocomotionConfig {
        drive_type: 0,
        max_linear_speed: 2.0,
        max_angular_speed: 1.5,
        max_accel: 1.0,
        wheel_radius: 0.1,
        track_width: 0.4,
        wheelbase: 0.5,
    };
}

pub type Locomotion = struct {
    ptr: Int,
    len: Int,
    cap: &SysCap,
    config: LocomotionConfig,
    pos: Vec3,
    orient: Vec3,
    target_twist: Twist,
    current_twist: Twist,
    is_active: Bool,
    distance_traveled: Float,
    steps_taken: Int,
    pid_linear: PidController,
    pid_angular: PidController,
    gait: QuadrupedGaitState,
};
