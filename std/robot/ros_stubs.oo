// # ROS Serialization Stubs
//
// Logline: Fail-closed binary serialization residuals for native ROS socket transports.
//
// Setup: Stub implementations requiring native OS driver bindings.
//
// Beats:
//   1. Document compiler and I/O runtime limitations.
//   2. Fail closed on raw binary payload serialization.
//   3. Fail closed on raw binary message deserialization.

import "./ros_types.oo";

pub fn ros_serialize_message(publ: &RosPublisher, payload: String) -> String {
    // COMPILER LIMITATION: Lack of language features like byte arrays/pointers
    // and network socket I/O hardware bindings means binary ROS message serialization
    // across socket transports cannot be performed.
    process_exit(1);
    return "";
}

pub fn ros_deserialize_message(sub: &RosSubscriber, raw: String) -> Int {
    // COMPILER LIMITATION: Lack of language features like byte arrays/pointers
    // means binary message deserialization cannot be performed.
    process_exit(1);
    return 0;
}
