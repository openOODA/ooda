// # Motor Quadrature Encoder State and Kinematics
//
// Logline: EncoderState ticks/cpr/gear, position/velocity integration, and unit-aware getters.
//
// Setup: Pure float encoder arithmetic; ticks -> radians via 2*pi*revs.
//
// Beats:
//   1. encoder_init, encoder_reset.
//   2. encoder_update: integrate ticks, compute position_rad and velocity_rad_s.
//   3. encoder_get_position_deg, encoder_get_rpm.

import "./motors_ops_math.oo";

type EncoderState = struct {
    ticks: Float,
    cpr: Float,
    gear_ratio: Float,
    position_rad: Float,
    velocity_rad_s: Float,
    prev_ticks: Float,
};

pub fn encoder_init(cpr: Float, gear_ratio: Float) -> EncoderState {
    return EncoderState {
        ticks: 0.0,
        cpr: cpr,
        gear_ratio: gear_ratio,
        position_rad: 0.0,
        velocity_rad_s: 0.0,
        prev_ticks: 0.0,
    };
}

pub fn encoder_reset(enc: EncoderState) -> EncoderState {
    return EncoderState {
        ticks: 0.0,
        cpr: (enc).cpr,
        gear_ratio: (enc).gear_ratio,
        position_rad: 0.0,
        velocity_rad_s: 0.0,
        prev_ticks: 0.0,
    };
}

pub fn encoder_update(enc: EncoderState, new_ticks: Float, dt: Float) -> EncoderState {
    let prev_val: Float = (enc).prev_ticks;
    let d_ticks: Float = new_ticks - prev_val;

    let cpr_val: Float = (enc).cpr;
    if cpr_val <= 0.0 {
        return EncoderState {
            ticks: new_ticks,
            cpr: (enc).cpr,
            gear_ratio: (enc).gear_ratio,
            position_rad: (enc).position_rad,
            velocity_rad_s: (enc).velocity_rad_s,
            prev_ticks: new_ticks,
        };
    }

    let gear_val: Float = (enc).gear_ratio;
    let ticks_per_rev: Float = cpr_val * gear_val;
    if ticks_per_rev <= 0.0 {
        return EncoderState {
            ticks: new_ticks,
            cpr: (enc).cpr,
            gear_ratio: (enc).gear_ratio,
            position_rad: (enc).position_rad,
            velocity_rad_s: (enc).velocity_rad_s,
            prev_ticks: new_ticks,
        };
    }

    let pi_val: Float = math_pi();
    let revs_val: Float = d_ticks / ticks_per_rev;
    let d_rad_val: Float = (revs_val * 2.0) * pi_val;
    let new_pos: Float = (enc).position_rad + d_rad_val;

    let new_vel: Float = if dt > 0.000001 { d_rad_val / dt } else { 0.0 };

    return EncoderState {
        ticks: new_ticks,
        cpr: (enc).cpr,
        gear_ratio: (enc).gear_ratio,
        position_rad: new_pos,
        velocity_rad_s: new_vel,
        prev_ticks: new_ticks,
    };
}

pub fn encoder_get_position_deg(enc_ref: EncoderState) -> Float {
    return rad_to_deg((enc_ref).position_rad);
}

pub fn encoder_get_rpm(enc_ref: EncoderState) -> Float {
    return rad_s_to_rpm((enc_ref).velocity_rad_s);
}
