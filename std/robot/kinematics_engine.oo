// # Kinematics Engine
//
// Logline: Lifecycle management, validation, and self-verification suite for robot kinematics.
//
// Setup: Stateful kinematics engine container and capability-gated validation.
//
// Beats:
//   1. Initialize and validate kinematics engine handles.
//   2. Run self-verification suite covering mobile drives and manipulator kinematics.
//   3. Validate Jacobian singularity checks and reachability assertions.

import "./kinematics_types.oo";
import "./kinematics_ops.oo";
import "./kinematics_mobile.oo";
import "./kinematics_arm.oo";

// -------------------------------------------------------------------
// Fail-Closed Engine Boilerplate
// -------------------------------------------------------------------

pub fn kinematics_engine_init(cap_handle: &SysCap) -> KinematicsEngine {
    return KinematicsEngine {
        initialized: 1,
        version:     100,
        cap:         cap_handle
    };
}

pub fn kinematics_engine_is_valid(engine_ref: &KinematicsEngine) -> Int {
    return (engine_ref).initialized;
}

// -------------------------------------------------------------------
// Verification Block
// -------------------------------------------------------------------

verify kinematics {
    // 1. Differential Drive Verification
    let diff_cfg: DiffDriveConfig = diff_drive_config_new(0.1, 0.5);
    let diff_wheels: DiffDriveWheelSpeeds = diff_drive_wheel_speeds_new(10.0, 10.0);
    let diff_twist: Twist2D = diff_drive_fk(diff_cfg, diff_wheels);
    assert_eq!((diff_twist).vy, 0.0);
    assert_eq!((diff_twist).omega, 0.0);

    let diff_rec: DiffDriveWheelSpeeds = diff_drive_ik(diff_cfg, diff_twist);
    assert_eq!((diff_rec).left, 10.0);
    assert_eq!((diff_rec).right, 10.0);

    // 2. 2-DOF Arm FK/IK Verification
    let arm2d_cfg: Arm2DConfig = arm2d_config_new(1.0, 1.0);
    let arm2d_j: Arm2DJoints = arm2d_joints_new(0.0, 0.0);
    let ee_pos: Vec2 = arm2d_fk(arm2d_cfg, arm2d_j);
    assert_eq!((ee_pos).x, 2.0);
    assert_eq!((ee_pos).y, 0.0);

    let ik_res: Arm2DIKResult = arm2d_ik_elbow_down(arm2d_cfg, ee_pos);
    assert_eq!((ik_res).valid, 1);

    // 3. Mecanum Drive Verification
    let mec_cfg: MecanumConfig = mecanum_config_new(0.05, 0.3, 0.3);
    let mec_twist: Twist2D = twist2d_new(1.0, 0.0, 0.0);
    let mec_wheels: MecanumWheelSpeeds = mecanum_ik(mec_cfg, mec_twist);
    let mec_twist_rec: Twist2D = mecanum_fk(mec_cfg, mec_wheels);
    assert_eq!((mec_twist_rec).vy, 0.0);
}
