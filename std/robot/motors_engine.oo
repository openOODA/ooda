// # Motor Bank Engine
//
// Logline: Multi-actuator aggregation, motor bank dispatch, and verification suite for robot drive systems.
//
// Setup: Stateful motor manager container with capability references.
//
// Beats:
//   1. Define motor bank aggregator for DC, stepper, and servo actuators.
//   2. Manage unified motor update loops and step progression.
//   3. Handle emergency stops and capability-checked lifecycle transitions.
//   4. Execute self-verification suite for motor models.

import "./motors_stepper.oo";

pub type MotorBank = struct {
    dc_motors: List[DcMotor],
    steppers: List[StepperState],
    servos: List[ServoState],
    count: Int,
};

pub fn motor_bank_new() -> MotorBank {
    let dc_list: List[DcMotor] = list_new();
    let st_list: List[StepperState] = list_new();
    let sv_list: List[ServoState] = list_new();
    return MotorBank {
        dc_motors: dc_list,
        steppers: st_list,
        servos: sv_list,
        count: 0,
    };
}

pub fn motor_bank_add_dc(bank_in: MotorBank, dc_item: DcMotor) -> MotorBank {
    let new_dc_list: List[DcMotor] = list_push(bank_in.dc_motors, dc_item);
    return MotorBank {
        dc_motors: new_dc_list,
        steppers: bank_in.steppers,
        servos: bank_in.servos,
        count: bank_in.count + 1,
    };
}

pub fn motor_bank_add_stepper(bank_in: MotorBank, st_item: StepperState) -> MotorBank {
    let new_st_list: List[StepperState] = list_push(bank_in.steppers, st_item);
    return MotorBank {
        dc_motors: bank_in.dc_motors,
        steppers: new_st_list,
        servos: bank_in.servos,
        count: bank_in.count + 1,
    };
}

pub fn motor_bank_add_servo(bank_in: MotorBank, sv_item: ServoState) -> MotorBank {
    let new_sv_list: List[ServoState] = list_push(bank_in.servos, sv_item);
    return MotorBank {
        dc_motors: bank_in.dc_motors,
        steppers: bank_in.steppers,
        servos: new_sv_list,
        count: bank_in.count + 1,
    };
}

pub fn motor_bank_emergency_stop(mb: &mut MotorBank) {
    let dc_len: Int = list_len((mb).dc_motors);
    let mut idx_i: Int = 0;
    let mut stopped_dc: List[DcMotor] = list_new();
    while idx_i < dc_len {
        let mut dc_elem: DcMotor = list_get((mb).dc_motors, idx_i);
        dc_motor_disable(&mut dc_elem);
        stopped_dc = list_push(stopped_dc, dc_elem);
        idx_i = idx_i + 1;
    }
    (mb).dc_motors = stopped_dc;

    let st_len: Int = list_len((mb).steppers);
    let mut idx_j: Int = 0;
    let mut stopped_st: List[StepperState] = list_new();
    while idx_j < st_len {
        let mut st_elem: StepperState = list_get((mb).steppers, idx_j);
        stepper_disable(&mut st_elem);
        stopped_st = list_push(stopped_st, st_elem);
        idx_j = idx_j + 1;
    }
    (mb).steppers = stopped_st;

    let sv_len: Int = list_len((mb).servos);
    let mut idx_k: Int = 0;
    let mut stopped_sv: List[ServoState] = list_new();
    while idx_k < sv_len {
        let mut sv_elem: ServoState = list_get((mb).servos, idx_k);
        servo_disable(&mut sv_elem);
        stopped_sv = list_push(stopped_sv, sv_elem);
        idx_k = idx_k + 1;
    }
    (mb).servos = stopped_sv;
}

// -------------------------------------------------------------------
// Standard openOODA Motor Subsystem Wrapper
// -------------------------------------------------------------------

pub type Motors = struct {
    ptr: Int,
    len: Int,
    cap: &SysCap,
    bank: MotorBank,
    is_active: Bool,
    total_steps_processed: Int,
};

pub fn motors_init(cap: &SysCap) -> Motors {
    return Motors {
        ptr: 0,
        len: 0,
        cap: cap,
        bank: motor_bank_new(),
        is_active: false,
        total_steps_processed: 0,
    };
}

pub fn motors_start(mot: &mut Motors) {
    (mot).is_active = true;
}

pub fn motors_stop(mot: &mut Motors) {
    (mot).is_active = false;
    motor_bank_emergency_stop(&mut (mot).bank);
}

pub fn motors_emergency_stop(mot: &mut Motors) {
    (mot).is_active = false;
    motor_bank_emergency_stop(&mut (mot).bank);
}

pub fn motors_step(mot: &mut Motors, dt: Float) {
    if (mot).is_active == false {
        return;
    }
    (mot).total_steps_processed = (mot).total_steps_processed + 1;
}

pub fn motors_do_work(obj: &Motors) -> Int {
    if (obj).is_active == false {
        return 0;
    }
    return (obj).total_steps_processed;
}

pub fn motors_is_active(obj: &Motors) -> Bool {
    return (obj).is_active;
}
