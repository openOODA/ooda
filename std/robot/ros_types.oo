// # ROS types
//
// Logline: QosProfile destubbed off nested node lists.
// residual: List[struct] destubbed.

type QosProfile = struct {
    depth: Int,
    reliability: Int
};

pub fn qos_profile_new(depth: Int, reliability: Int) -> QosProfile {
    return QosProfile {
        depth: depth,
        reliability: reliability
    };
}

pub fn qos_profile_depth(q: QosProfile) -> Int {
    return q.depth;
}
