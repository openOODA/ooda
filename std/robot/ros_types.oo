// # Robot Operating System Interface Types
//
// Logline: Define RosNode, RosTopic, and RosMessage models.
//
// Setup: Core data types and structured models.
//
// Beats:
//   1. Declare ROS node lifecycle definitions.
//   2. Declare publisher and subscriber topic configurations.
//   3. Declare ROS transport message buffers.

type RosNode = struct {
    name: String, ns: String, is_active: Bool, n_spin: Int, n_pub: Int,
    n_sub: Int, n_srv: Int, n_act: Int
};
type RosPublisher = struct {
    topic_name: String, msg_type: String, qos: QosProfile, n_sent: Int,
    is_valid: Bool
};
type RosSubscriber = struct {
    topic_name: String, msg_type: String, qos: QosProfile, n_recv: Int,
    is_active: Bool
};
type RosServiceServer = struct {
    service_name: String, srv_type: String, requests_handled: Int,
    is_active: Bool
};
type RosServiceClient = struct {
    service_name: String, srv_type: String, calls_made: Int, is_connected: Bool
};
type RosActionClient = struct {
    action_name: String, action_type: String, active_goals: Int,
    is_connected: Bool
};
type RosActionGoal = struct { goal_id: Int, status: Int };
type Transform = struct {
    parent_frame: String, child_frame: String, tx: Int, ty: Int, tz: Int,
    rx: Int, ry: Int, rz: Int, timestamp: Int
};
type TransformPoint = struct { x: Int, y: Int, z: Int };
type RosNodeConfig = struct { name: String, ns: String, domain_id: Int };
type RosHeader = struct { seq: Int, stamp_sec: Int, stamp_nsec: Int, frame_id: String };
type RosTwist = struct { lx: Int, ly: Int, lz: Int, ax: Int, ay: Int, az: Int };
type RosPose = struct { x: Int, y: Int, z: Int, qx: Int, qy: Int, qz: Int, qw: Int };
type RosOdometry = struct {
    header: RosHeader, child_frame: String, pose: RosPose, twist: RosTwist
};
type RosCreatedPublisher = struct { node: RosNode, publ: RosPublisher };
type RosCreatedSubscriber = struct { node: RosNode, sub: RosSubscriber };
type RosCreatedServer = struct { node: RosNode, server: RosServiceServer };
type RosCreatedClient = struct { node: RosNode, client: RosServiceClient };
type RosCreatedAction = struct { node: RosNode, client: RosActionClient };
type RosSentGoal = struct { client: RosActionClient, goal: RosActionGoal };

pub fn ros_publisher_create(node: RosNode, topic: String, msg_type: String, qos: QosProfile) -> RosCreatedPublisher {
    return RosCreatedPublisher {
        node: RosNode {
            name: (node).name,
            ns: (node).ns,
            is_active: (node).is_active,
            n_spin: (node).n_spin,
            n_pub: (node).n_pub + 1,
            n_sub: (node).n_sub,
            n_srv: (node).n_srv,
            n_act: (node).n_act,
        },
        publ: RosPublisher {
            topic_name: topic,
            msg_type: msg_type,
            qos: qos,
            n_sent: 0,
            is_valid: true,
        },
    };
}
pub fn ros_subscriber_create(node: RosNode, topic: String, msg_type: String, qos: QosProfile) -> RosCreatedSubscriber {
    return RosCreatedSubscriber {
        node: RosNode {
            name: (node).name,
            ns: (node).ns,
            is_active: (node).is_active,
            n_spin: (node).n_spin,
            n_pub: (node).n_pub,
            n_sub: (node).n_sub + 1,
            n_srv: (node).n_srv,
            n_act: (node).n_act,
        },
        sub: RosSubscriber {
            topic_name: topic,
            msg_type: msg_type,
            qos: qos,
            n_recv: 0,
            is_active: true,
        },
    };
}
pub fn ros_service_server_create(node: RosNode, srv_name: String, srv_type: String) -> RosCreatedServer {
    return RosCreatedServer {
        node: RosNode {
            name: (node).name,
            ns: (node).ns,
            is_active: (node).is_active,
            n_spin: (node).n_spin,
            n_pub: (node).n_pub,
            n_sub: (node).n_sub,
            n_srv: (node).n_srv + 1,
            n_act: (node).n_act,
        },
        server: RosServiceServer {
            service_name: srv_name,
            srv_type: srv_type,
            requests_handled: 0,
            is_active: true,
        },
    };
}
pub fn ros_service_client_create(node: RosNode, srv_name: String, srv_type: String) -> RosCreatedClient {
    return RosCreatedClient {
        node: RosNode {
            name: (node).name,
            ns: (node).ns,
            is_active: (node).is_active,
            n_spin: (node).n_spin,
            n_pub: (node).n_pub,
            n_sub: (node).n_sub,
            n_srv: (node).n_srv + 1,
            n_act: (node).n_act,
        },
        client: RosServiceClient {
            service_name: srv_name,
            srv_type: srv_type,
            calls_made: 0,
            is_connected: false,
        },
    };
}
pub fn ros_service_client_connect(client: RosServiceClient) -> RosServiceClient {
    return RosServiceClient {
        service_name: (client).service_name, srv_type: (client).srv_type,
        calls_made: (client).calls_made, is_connected: true
    };
}
pub fn ros_service_client_call(client: RosServiceClient) -> RosServiceClient {
    if (client).is_connected {
        return RosServiceClient {
            service_name: (client).service_name, srv_type: (client).srv_type,
            calls_made: (client).calls_made + 1, is_connected: true
        };
    }
    return client;
}
pub fn ros_service_server_process(server: RosServiceServer) -> RosServiceServer {
    if (server).is_active {
        return RosServiceServer {
            service_name: (server).service_name, srv_type: (server).srv_type,
            requests_handled: (server).requests_handled + 1, is_active: true
        };
    }
    return server;
}
pub fn ros_action_client_create(node: RosNode, name: String, act_type: String) -> RosCreatedAction {
    return RosCreatedAction {
        node: RosNode {
            name: (node).name,
            ns: (node).ns,
            is_active: (node).is_active,
            n_spin: (node).n_spin,
            n_pub: (node).n_pub,
            n_sub: (node).n_sub,
            n_srv: (node).n_srv,
            n_act: (node).n_act + 1,
        },
        client: RosActionClient {
            action_name: name,
            action_type: act_type,
            active_goals: 0,
            is_connected: true,
        },
    };
}
