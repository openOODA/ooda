// # Safety System Data Types
//
// Logline: Fault records, geofences, speed limits, proximity sensors, watchdogs, and safety monitor types.
//
// Setup: Pure type definitions and configuration constructors.
//
// Beats:
//   1. Define safety fault descriptors and severity codes.
//   2. Define 2D bounding geofence records and default states.
//   3. Define velocity clamping profiles and obstacle proximity guard types.
//   4. Define safety watchdog timer and comprehensive safety monitor structure.

// -------------------------------------------------------------------
// Safety Status Constants & Primitive Types
// -------------------------------------------------------------------

pub type SafetyFault = struct {
    code: Int,
    severity: Int,
    timestamp_ms: Int,
    is_active: Bool
};

pub fn safety_fault_new(code: Int, severity: Int, timestamp_ms: Int) -> SafetyFault {
    return SafetyFault {
        code: code,
        severity: severity,
        timestamp_ms: timestamp_ms,
        is_active: true
    };
}

pub fn safety_fault_none() -> SafetyFault {
    return SafetyFault {
        code: 0,
        severity: 0,
        timestamp_ms: 0,
        is_active: false
    };
}

// -------------------------------------------------------------------
// Geofence & Boundary Checking
// -------------------------------------------------------------------

pub type Geofence2D = struct {
    min_x: Int,
    max_x: Int,
    min_y: Int,
    max_y: Int,
    is_active: Bool
};

pub fn geofence2d_new(min_x: Int, max_x: Int, min_y: Int, max_y: Int) -> Geofence2D {
    return Geofence2D {
        min_x: min_x,
        max_x: max_x,
        min_y: min_y,
        max_y: max_y,
        is_active: true
    };
}

pub fn geofence2d_disabled() -> Geofence2D {
    return Geofence2D {
        min_x: 0,
        max_x: 0,
        min_y: 0,
        max_y: 0,
        is_active: false
    };
}

// -------------------------------------------------------------------
// Speed Limit & Velocity Clamping
// -------------------------------------------------------------------

pub type SpeedLimitConfig = struct {
    max_linear_mm_s: Int,
    max_angular_mdeg_s: Int,
    safe_speed_mode: Bool
};

pub fn speed_limit_config_default() -> SpeedLimitConfig {
    return SpeedLimitConfig {
        max_linear_mm_s: 2000,
        max_angular_mdeg_s: 90000,
        safe_speed_mode: false
    };
}

pub fn speed_limit_config_restricted() -> SpeedLimitConfig {
    return SpeedLimitConfig {
        max_linear_mm_s: 500,
        max_angular_mdeg_s: 30000,
        safe_speed_mode: true
    };
}

// -------------------------------------------------------------------
// Obstacle Proximity Guarding
// -------------------------------------------------------------------

pub type ObstacleProximity = struct {
    stop_distance_mm: Int,
    warning_distance_mm: Int,
    last_measured_mm: Int,
    is_active: Bool
};

pub fn obstacle_proximity_new(stop_dist_mm: Int, warn_dist_mm: Int) -> ObstacleProximity {
    return ObstacleProximity {
        stop_distance_mm: stop_dist_mm,
        warning_distance_mm: warn_dist_mm,
        last_measured_mm: 999999,
        is_active: true
    };
}

pub fn obstacle_proximity_disabled() -> ObstacleProximity {
    return ObstacleProximity {
        stop_distance_mm: 0,
        warning_distance_mm: 0,
        last_measured_mm: 999999,
        is_active: false
    };
}

// -------------------------------------------------------------------
// Safety Watchdog Monitor
// -------------------------------------------------------------------

pub type SafetyWatchdog = struct {
    timeout_ms: Int,
    last_heartbeat_ms: Int,
    is_tripped: Bool,
    is_enabled: Bool
};

pub fn watchdog_new(timeout_ms: Int) -> SafetyWatchdog {
    return SafetyWatchdog {
        timeout_ms: timeout_ms,
        last_heartbeat_ms: 0,
        is_tripped: false,
        is_enabled: true
    };
}

// -------------------------------------------------------------------
// Safety Monitor System Interlock Structure
// -------------------------------------------------------------------

pub type SafetyMonitor = struct {
    status: Int,
    estop_latched: Bool,
    estop_reason_code: Int,
    manual_override: Bool,
    fault_count: Int,
    last_fault: SafetyFault,
    geofence: Geofence2D,
    speed_limit: SpeedLimitConfig,
    proximity: ObstacleProximity,
    watchdog: SafetyWatchdog,
    cap: &SysCap
};
