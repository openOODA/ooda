// # Motor PID Control Loop
//
// Logline: MotorPid kp/ki/kd with integral windup clamp, deadband skip, and bounded output.
//
// Setup: Pure float PID with dt short-circuit and deadband; uses math_abs and clamp_float.
//
// Beats:
//   1. motor_pid_init, motor_pid_reset.
//   2. motor_pid_compute: integrate error, derive, kp*err + ki*int + kd*deriv, clamp to max_output.
//   3. motor_pid_last_output.

import "./motors_ops_math.oo";

type MotorPid = struct {
    kp: Float,
    ki: Float,
    kd: Float,
    integral: Float,
    prev_error: Float,
    max_output: Float,
    deadband: Float,
    last_output: Float
};

pub fn motor_pid_init(kp_val: Float, ki_val: Float, kd_val: Float, max_out: Float) -> MotorPid {
    return MotorPid {
        kp: kp_val,
        ki: ki_val,
        kd: kd_val,
        integral: 0.0,
        prev_error: 0.0,
        max_output: max_out,
        deadband: 0.0,
        last_output: 0.0
    };
}

pub fn motor_pid_reset(pid_ctrl: MotorPid) -> MotorPid {
    return MotorPid {
        kp: (pid_ctrl).kp,
        ki: (pid_ctrl).ki,
        kd: (pid_ctrl).kd,
        integral: 0.0,
        prev_error: 0.0,
        max_output: (pid_ctrl).max_output,
        deadband: (pid_ctrl).deadband,
        last_output: 0.0
    };
}

pub fn motor_pid_compute(pid_ctrl: MotorPid, setpoint: Float, measurement: Float, dt: Float) -> MotorPid {
    if dt < 0.000001 {
        return MotorPid {
            kp: (pid_ctrl).kp,
            ki: (pid_ctrl).ki,
            kd: (pid_ctrl).kd,
            integral: (pid_ctrl).integral,
            prev_error: (pid_ctrl).prev_error,
            max_output: (pid_ctrl).max_output,
            deadband: (pid_ctrl).deadband,
            last_output: 0.0
        };
    }
    let error_val: Float = setpoint - measurement;
    let db_val: Float = (pid_ctrl).deadband;
    if math_abs(error_val) < db_val {
        return MotorPid {
            kp: (pid_ctrl).kp,
            ki: (pid_ctrl).ki,
            kd: (pid_ctrl).kd,
            integral: (pid_ctrl).integral,
            prev_error: (pid_ctrl).prev_error,
            max_output: (pid_ctrl).max_output,
            deadband: (pid_ctrl).deadband,
            last_output: 0.0
        };
    }

    let limit_val: Float = (pid_ctrl).max_output;
    let new_integral: Float = clamp_float((pid_ctrl).integral + (error_val * dt), 0.0 - limit_val, limit_val);

    let prev_err: Float = (pid_ctrl).prev_error;
    let deriv_val: Float = (error_val - prev_err) / dt;
    let kp_elem: Float = (pid_ctrl).kp;
    let ki_elem: Float = (pid_ctrl).ki;
    let kd_elem: Float = (pid_ctrl).kd;
    let out_val: Float = ((kp_elem * error_val) + (ki_elem * new_integral)) + (kd_elem * deriv_val);
    let clamped: Float = clamp_float(out_val, 0.0 - limit_val, limit_val);

    return MotorPid {
        kp: (pid_ctrl).kp,
        ki: (pid_ctrl).ki,
        kd: (pid_ctrl).kd,
        integral: new_integral,
        prev_error: error_val,
        max_output: (pid_ctrl).max_output,
        deadband: (pid_ctrl).deadband,
        last_output: clamped
    };
}

pub fn motor_pid_last_output(pid_ctrl: MotorPid) -> Float {
    return (pid_ctrl).last_output;
}
