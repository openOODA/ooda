// # Kinematics Domain Types
//
// Logline: Data structures for 2D/3D vectors, poses, mobile base configurations, and robotic arm joints.
//
// Setup: Pure geometric and kinematic type definitions.
//
// Beats:
//   1. Define 2D and 3D vector, pose, and twist structures.
//   2. Define mobile robot drive configurations (DiffDrive, Ackermann, Mecanum).
//   3. Define manipulator arm parameters, DH links, and joint configurations.
//   4. Define kinematics engine container.

// -------------------------------------------------------------------
// Primitive Geometric Types
// -------------------------------------------------------------------

type Vec2 = struct {
    x: Float,
    y: Float,
};

type Vec3 = struct {
    x: Float,
    y: Float,
    z: Float,
};

type Pose2D = struct {
    x: Float,
    y: Float,
    theta: Float,
};

type Pose3D = struct {
    position: Vec3,
    orientation: Vec3,
};

type Twist2D = struct {
    vx: Float,
    vy: Float,
    omega: Float,
};

type Twist3D = struct {
    linear: Vec3,
    angular: Vec3,
};

// -------------------------------------------------------------------
// Mobile robot configs
// -------------------------------------------------------------------

type DiffDriveConfig = struct {
    wheel_radius: Float,
    track_width:  Float,
};

type DiffDriveWheelSpeeds = struct {
    left:  Float,
    right: Float,
};

type AckermannConfig = struct {
    wheelbase:   Float,
    track_width: Float,
};

type AckermannState = struct {
    speed:          Float,
    steering_angle: Float,
};

type MecanumConfig = struct {
    wheel_radius: Float,
    wheelbase:    Float,
    track_width:  Float,
};

type MecanumWheelSpeeds = struct {
    front_left:  Float,
    front_right: Float,
    rear_left:   Float,
    rear_right:  Float,
};

// -------------------------------------------------------------------
// Manipulator types
// -------------------------------------------------------------------

type DHLink = struct {
    a_len:       Float, // link length (m)
    alpha_angle: Float, // link twist (rad)
    d_offset:    Float, // link offset (m)
    theta_angle: Float, // joint angle (rad)
    joint_kind:  Int,   // 0 = Revolute, 1 = Prismatic
};

type Arm2DConfig = struct {
    l1: Float,
    l2: Float,
};

type Arm2DJoints = struct {
    theta1: Float,
    theta2: Float,
};

type Arm2DIKResult = struct {
    valid:  Int,
    theta1: Float,
    theta2: Float,
};

type Arm2DJacobian = struct {
    j11: Float,
    j12: Float,
    j21: Float,
    j22: Float,
};

type Arm3DConfig = struct {
    l1: Float,
    l2: Float,
    l3: Float,
};

type Arm3DJoints = struct {
    theta1: Float,
    theta2: Float,
    theta3: Float,
};

type Arm3DIKResult = struct {
    valid:  Int,
    theta1: Float,
    theta2: Float,
    theta3: Float,
};

// -------------------------------------------------------------------
// Engine
// -------------------------------------------------------------------

type KinematicsEngine = struct {
    initialized: Int,
    version:     Int,
    cap:         &SysCap,
};

pub fn kinematics_types_marker() -> Int {
    return 1;
}
