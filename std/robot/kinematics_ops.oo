// # Kinematics Math & Operations
//
// Logline: Vector algebra, 2D pose transformations, angle normalization, and trigonometric utilities.
//
// Setup: Pure mathematical operations for planar robot kinematics.
//
// Beats:
//   1. Implement Vec2 addition, subtraction, scaling, and norm operations.
//   2. Implement 2D pose transformations, compounding, and inversion.
//   3. Implement angle normalization within [-pi, pi].
//   4. Implement transcendental math helpers (atan2, pi).

import "./kinematics_types.oo";

// -------------------------------------------------------------------
// Vec2 / Pose2D / Twist2D constructors & ops
// -------------------------------------------------------------------

pub fn vec2_new(x_val: Float, y_val: Float) -> Vec2 {
    return Vec2 { x: x_val, y: y_val };
}

pub fn vec2_zero() -> Vec2 {
    return Vec2 { x: 0.0, y: 0.0 };
}

pub fn vec2_add(v1: Vec2, v2: Vec2) -> Vec2 {
    return Vec2 { x: (v1).x + (v2).x, y: (v1).y + (v2).y };
}

pub fn vec2_sub(v1: Vec2, v2: Vec2) -> Vec2 {
    return Vec2 { x: (v1).x - (v2).x, y: (v1).y - (v2).y };
}

pub fn vec2_scale(v_val: Vec2, s_val: Float) -> Vec2 {
    return Vec2 { x: (v_val).x * s_val, y: (v_val).y * s_val };
}

pub fn vec2_dot(v1: Vec2, v2: Vec2) -> Float {
    return ((v1).x * (v2).x) + ((v1).y * (v2).y);
}

pub fn vec2_length_sq(v_val: Vec2) -> Float {
    return vec2_dot(v_val, v_val);
}

pub fn vec2_length(v_val: Vec2) -> Float {
    return sqrt(vec2_length_sq(v_val));
}

pub fn pose2d_new(x_val: Float, y_val: Float, theta_val: Float) -> Pose2D {
    return Pose2D { x: x_val, y: y_val, theta: theta_val };
}

pub fn pose2d_zero() -> Pose2D {
    return Pose2D { x: 0.0, y: 0.0, theta: 0.0 };
}

pub fn twist2d_new(vx_val: Float, vy_val: Float, omega_val: Float) -> Twist2D {
    return Twist2D { vx: vx_val, vy: vy_val, omega: omega_val };
}

pub fn twist2d_zero() -> Twist2D {
    return Twist2D { vx: 0.0, vy: 0.0, omega: 0.0 };
}

// -------------------------------------------------------------------
// Mathematical Utilities & Trigonometry
// -------------------------------------------------------------------

pub fn math_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn math_abs(x_val: Float) -> Float {
    if x_val < 0.0 {
        return 0.0 - x_val;
    }
    return x_val;
}

pub fn deg2rad(deg_val: Float) -> Float {
    return (deg_val * math_pi()) / 180.0;
}

pub fn rad2deg(rad_val: Float) -> Float {
    return (rad_val * 180.0) / math_pi();
}

pub fn clamp_float(val: Float, min_val: Float, max_val: Float) -> Float {
    if val < min_val {
        return min_val;
    }
    if val > max_val {
        return max_val;
    }
    return val;
}

/// Normalize angle in radians to [-pi, pi].
pub fn normalize_angle(angle: Float) -> Float {
    let pi_val: Float = math_pi();
    let two_pi: Float = 2.0 * pi_val;
    let mut angle_val: Float = angle;
    while angle_val > pi_val {
        angle_val = angle_val - two_pi;
    }
    let neg_pi: Float = 0.0 - pi_val;
    while angle_val < neg_pi {
        angle_val = angle_val + two_pi;
    }
    return angle_val;
}

/// Polynomial approximation of arctan(z) for |z| <= 1.
pub fn math_atan_unit(z_val: Float) -> Float {
    let z2: Float = z_val * z_val;
    let c1: Float = 0.3333333333333333;
    let c2: Float = 0.2;
    let c3: Float = 0.14285714285714285;
    let c4: Float = 0.1111111111111111;
    let c5: Float = 0.09090909090909091;
    let poly: Float = z2 * (c1 - (z2 * (c2 - (z2 * (c3 - (z2 * (c4 - (z2 * c5))))))));
    return z_val * (1.0 - poly);
}

/// Arctangent of z for any real z.
pub fn math_atan(z_val: Float) -> Float {
    let abs_z: Float = math_abs(z_val);
    if abs_z <= 1.0 {
        let res_atan: Float = math_atan_unit(abs_z);
        if z_val < 0.0 {
            return 0.0 - res_atan;
        }
        return res_atan;
    }
    let half_pi: Float = math_pi() / 2.0;
    let res_atan: Float = half_pi - math_atan_unit(1.0 / abs_z);
    if z_val < 0.0 {
        return 0.0 - res_atan;
    }
    return res_atan;
}

/// Arctangent of y / x considering quadrant signs.
pub fn math_atan2(y_val: Float, x_val: Float) -> Float {
    let pi_val: Float = math_pi();
    if x_val > 0.0 {
        return math_atan(y_val / x_val);
    }
    if x_val < 0.0 {
        if y_val >= 0.0 {
            return math_atan(y_val / x_val) + pi_val;
        }
        return math_atan(y_val / x_val) - pi_val;
    }
    if y_val > 0.0 {
        return pi_val / 2.0;
    }
    if y_val < 0.0 {
        return 0.0 - (pi_val / 2.0);
    }
    return 0.0;
}

/// Arccosine of x in [-1.0, 1.0]. Returns radians in [0, pi].
pub fn math_acos(x_val: Float) -> Float {
    let mut clamped: Float = x_val;
    if clamped > 1.0 {
        clamped = 1.0;
    }
    let neg_one: Float = 0.0 - 1.0;
    if clamped < neg_one {
        clamped = neg_one;
    }
    let sin_val: Float = sqrt(1.0 - (clamped * clamped));
    return math_atan2(sin_val, clamped);
}

/// Arcsine of x in [-1.0, 1.0]. Returns radians in [-pi/2, pi/2].
pub fn math_asin(x_val: Float) -> Float {
    let mut clamped: Float = x_val;
    if clamped > 1.0 {
        clamped = 1.0;
    }
    let neg_one: Float = 0.0 - 1.0;
    if clamped < neg_one {
        clamped = neg_one;
    }
    let cos_val: Float = sqrt(1.0 - (clamped * clamped));
    return math_atan2(clamped, cos_val);
}
