// # Motors Facade
//
// Logline: Re-exports DC motors, steppers, RC servos, PWM signals, encoders, and motor banks.
//
// Setup: Pure module shim importing companion motor submodules.
//
// Beats:
//   1. Import motor companion submodules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

import "./motors_ops.oo";
import "./motors_dc.oo";
import "./motors_stepper.oo";
import "./motors_engine.oo";
import "./motors_stubs.oo";

pub fn shim_marker_math_pi() -> Float {
    return math_pi();
}

pub fn shim_marker_pwm_config_new() -> PwmConfig {
    return pwm_config_new(1000.0, 0.5, false);
}

pub fn shim_marker_pwm_to_voltage() -> Float {
    let cfg: PwmConfig = pwm_config_new(1000.0, 0.5, false);
    return pwm_to_voltage(cfg, 12.0);
}

pub fn shim_marker_motor_pid_init() -> MotorPid {
    return motor_pid_init(1.0, 0.0, 0.0, 10.0);
}

pub fn shim_marker_dc_motor_init() -> DcMotor {
    return dc_motor_init(1, 12.0, 3000.0, 1000.0, 1.0);
}

pub fn shim_marker_stepper_init() -> StepperState {
    return stepper_init(1, 200.0, 16.0, 1000.0, 500.0);
}

pub fn shim_marker_servo_init() -> ServoState {
    return servo_init(1, 1000.0, 2000.0, 180.0);
}

pub fn shim_marker_motor_bank_new() -> MotorBank {
    return motor_bank_new();
}

pub fn shim_marker_motors_do_work(obj: &Motors) -> Int {
    return motors_do_work(obj);
}
