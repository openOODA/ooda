// # ROS Interface Facade
//
// Logline: Re-exports ROS/ROS2 node definitions, pub/sub channels, services, actions, and messages.
//
// Setup: Pure module shim importing companion ROS submodules.
//
// Beats:
//   1. Import ROS companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream consumers.

import "./ros_types.oo";
import "./ros_ops.oo";

pub fn shim_marker_qos_default() -> QosProfile {
    return qos_profile_default();
}

pub fn shim_marker_qos_sensor() -> QosProfile {
    return qos_profile_sensor_data();
}

pub fn shim_marker_qos_services() -> QosProfile {
    return qos_profile_services();
}

pub fn shim_marker_ros_node_config() -> RosNodeConfig {
    return ros_node_config_new("test_node", "/robot", 0);
}

pub fn shim_marker_ros_node_new() -> RosNode {
    let cfg: RosNodeConfig = ros_node_config_new("node1", "/ns", 0);
    return ros_node_new(cfg);
}

pub fn shim_marker_ros_node_spin(node: RosNode) -> RosNode {
    return ros_node_spin_once(node);
}

pub fn shim_marker_ros_publisher_create(node: RosNode) -> RosCreatedPublisher {
    let qos: QosProfile = qos_profile_default();
    return ros_publisher_create(node, "/cmd_vel", "geometry_msgs/Twist", qos);
}

pub fn shim_marker_ros_subscriber_create(node: RosNode) -> RosCreatedSubscriber {
    let qos: QosProfile = qos_profile_sensor_data();
    return ros_subscriber_create(node, "/scan", "sensor_msgs/LaserScan", qos);
}

pub fn shim_marker_ros_service_server(node: RosNode) -> RosCreatedServer {
    return ros_service_server_create(node, "/set_mode", "std_srvs/SetBool");
}

pub fn shim_marker_ros_service_client(node: RosNode) -> RosCreatedClient {
    return ros_service_client_create(node, "/set_mode", "std_srvs/SetBool");
}

pub fn shim_marker_ros_action_client(node: RosNode) -> RosCreatedAction {
    return ros_action_client_create(node, "/navigate", "nav2_msgs/NavigateToPose");
}

pub fn shim_marker_transform_new() -> Transform {
    return transform_new("base_link", "laser", 0, 0, 0, 0, 0, 0, 0);
}

pub fn shim_marker_transform_apply(t: Transform) -> TransformPoint {
    return transform_apply(t, 1, 2, 3);
}

pub fn shim_marker_ros_header() -> RosHeader {
    return ros_header_new(1, 100, 0, "map");
}

pub fn shim_marker_ros_twist() -> RosTwist {
    return ros_twist_new(1, 0, 0, 0, 0, 1);
}

pub fn shim_marker_ros_pose() -> RosPose {
    return ros_pose_new(0, 0, 0, 0, 0, 0, 1);
}

pub fn shim_marker_ros_odometry() -> RosOdometry {
    let h: RosHeader = ros_header_new(1, 100, 0, "odom");
    let p: RosPose = ros_pose_new(0, 0, 0, 0, 0, 0, 1);
    let tw: RosTwist = ros_twist_new(0, 0, 0, 0, 0, 0);
    return ros_odometry_new(h, "base_link", p, tw);
}
