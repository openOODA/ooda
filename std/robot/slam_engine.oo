// # SLAM Engine
//
// Logline: Simultaneous localization and mapping workflow coordinator and keyframe cadence driver.
//
// Setup: Stateful SLAM execution environment tracking poses, landmarks, and keyframe history.
//
// Beats:
//   1. Instantiate and manage SLAM state and lifecycle states.
//   2. Process time steps with odometry projection and landmark fusion.
//   3. Periodically trigger keyframe recording at configured cadence.
//   4. Query runtime metrics, landmark tallies, and active poses.

import "./slam_types.oo";
import "./slam_ops.oo";
import "./slam_map.oo";

// -------------------------------------------------------------------
// SLAM State Engine Workflow
// -------------------------------------------------------------------

pub fn slam_engine_new() -> SlamState {
    let lms: List[Landmark] = list_new();
    let kfs: List[Keyframe] = list_new();
    return SlamState {
        current_pose: pose2d_zero(),
        landmarks: lms,
        keyframes: kfs,
        total_steps: 0,
        is_active: false,
        mode: 0
    };
}

pub fn slam_engine_start(state: SlamState) -> SlamState {
    return SlamState {
        current_pose: state.current_pose,
        landmarks: state.landmarks,
        keyframes: state.keyframes,
        total_steps: state.total_steps,
        is_active: true,
        mode: state.mode
    };
}

pub fn slam_engine_stop(state: SlamState) -> SlamState {
    return SlamState {
        current_pose: state.current_pose,
        landmarks: state.landmarks,
        keyframes: state.keyframes,
        total_steps: state.total_steps,
        is_active: false,
        mode: state.mode
    };
}

pub fn slam_engine_process_step(state: SlamState, vel: Velocity2D, obs_list: List[Observation], dt_ms: Int) -> SlamState {
    if (state).is_active == false {
        return state;
    }

    let cur_pose = (state).current_pose;
    let next_pose = slam_predict_pose_velocity(cur_pose, vel, dt_ms);

    let mut updated_lms = (state).landmarks;
    let obs_len = list_len(obs_list);
    let mut i = 0;
    while i < obs_len {
        let obs = list_get(obs_list, i);
        updated_lms = slam_update_landmarks(updated_lms, obs, next_pose);
        i = i + 1;
    }

    let prev_steps = (state).total_steps;
    let next_steps = prev_steps + 1;
    let mut updated_kfs = (state).keyframes;
    let rem = next_steps % 10;
    if rem == 0 {
        let step_time = next_steps * dt_ms;
        let lm_cnt = list_len(updated_lms);
        updated_kfs = slam_add_keyframe(updated_kfs, next_pose, step_time, lm_cnt);
    }

    let cur_mode = (state).mode;
    return SlamState {
        current_pose: next_pose,
        landmarks: updated_lms,
        keyframes: updated_kfs,
        total_steps: next_steps,
        is_active: true,
        mode: cur_mode
    };
}

pub fn slam_engine_get_pose(state: &SlamState) -> Pose2D {
    return (state).current_pose;
}

pub fn slam_engine_get_landmark_count(state: &SlamState) -> Int {
    return list_len((state).landmarks);
}

pub fn slam_engine_get_keyframe_count(state: &SlamState) -> Int {
    return list_len((state).keyframes);
}

pub fn slam_engine_is_active(state: &SlamState) -> Bool {
    return (state).is_active;
}

pub fn slam_do_work(obj: &Slam) -> Int {
    return (obj).len;
}
