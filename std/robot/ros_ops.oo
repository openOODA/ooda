// # ROS Operations & Communication
//
// Logline: Node lifecycle, publisher/subscriber dispatch, service invocation, actions, and transform algebra.
//
// Setup: Stateful communication handlers operating on ROS nodes and endpoints.
//
// Beats:
//   1. Implement ROS node execution and spin processing.
//   2. Implement publish/subscribe creation, dispatch, and polling.
//   3. Implement service client/server connection and call processing.
//   4. Implement action client goal lifecycle and transform coordinate calculations.

import "./ros_types.oo";

import "./ros_types.oo";

import ./ros_msg.oo;

pub fn qos_profile_default() -> QosProfile { return qos_profile_new(10, 1); }

pub fn qos_profile_sensor_data() -> QosProfile { return qos_profile_new(5, 2); }

pub fn qos_profile_services() -> QosProfile { return qos_profile_new(1, 1); }

pub fn ros_node_config_new(name: String, ns: String, domain_id: Int) -> RosNodeConfig {
    return RosNodeConfig { name: name, ns: ns, domain_id: domain_id };
}

pub fn ros_node_new(cfg: RosNodeConfig) -> RosNode {
    return RosNode {
        name: (cfg).name, ns: (cfg).ns, is_active: false, n_spin: 0, n_pub: 0,
        n_sub: 0, n_srv: 0, n_act: 0
    };
}

pub fn transform_new(parent: String, child: String, tx: Int, ty: Int, tz: Int, rx: Int, ry: Int, rz: Int, timestamp: Int) -> Transform {
    return Transform {
        parent_frame: parent, child_frame: child, tx: tx, ty: ty, tz: tz, rx: rx,
        ry: ry, rz: rz, timestamp: timestamp
    };
}

pub fn ros_header_new(seq: Int, stamp_sec: Int, stamp_nsec: Int, frame_id: String) -> RosHeader {
    return RosHeader { seq: seq, stamp_sec: stamp_sec, stamp_nsec: stamp_nsec, frame_id: frame_id };
}

pub fn ros_twist_new(lx: Int, ly: Int, lz: Int, ax: Int, ay: Int, az: Int) -> RosTwist {
    return RosTwist { lx: lx, ly: ly, lz: lz, ax: ax, ay: ay, az: az };
}

pub fn ros_pose_new(x: Int, y: Int, z: Int, qx: Int, qy: Int, qz: Int, qw: Int) -> RosPose {
    return RosPose { x: x, y: y, z: z, qx: qx, qy: qy, qz: qz, qw: qw };
}

pub fn ros_odometry_new(h: RosHeader, child: String, p: RosPose, tw: RosTwist) -> RosOdometry {
    return RosOdometry { header: h, child_frame: child, pose: p, twist: tw };
}

// Node Lifecycle Operations

pub fn ros_node_start(node: RosNode) -> RosNode {
    return RosNode {
        name: (node).name, ns: (node).ns, is_active: true, n_spin: (node).n_spin,
        n_pub: (node).n_pub, n_sub: (node).n_sub, n_srv: (node).n_srv,
        n_act: (node).n_act
    };
}

pub fn ros_node_stop(node: RosNode) -> RosNode {
    return RosNode {
        name: (node).name, ns: (node).ns, is_active: false, n_spin: (node).n_spin,
        n_pub: (node).n_pub, n_sub: (node).n_sub, n_srv: (node).n_srv,
        n_act: (node).n_act
    };
}

pub fn ros_node_is_active(node: RosNode) -> Bool { return (node).is_active; }

pub fn ros_node_spin_once(node: RosNode) -> RosNode {
    if (node).is_active {
        return RosNode {
            name: (node).name, ns: (node).ns, is_active: true,
            n_spin: (node).n_spin + 1, n_pub: (node).n_pub, n_sub: (node).n_sub,
            n_srv: (node).n_srv, n_act: (node).n_act
        };
    }
    return node;
}

// Publisher Operations

pub fn ros_publisher_publish(publ: RosPublisher) -> RosPublisher {
    if (publ).is_valid {
        return RosPublisher {
            topic_name: (publ).topic_name, msg_type: (publ).msg_type, qos: (publ).qos,
            n_sent: (publ).n_sent + 1, is_valid: true
        };
    }
    return publ;
}

pub fn ros_publisher_is_valid(publ: RosPublisher) -> Bool { return (publ).is_valid; }

// Subscriber Operations

pub fn ros_subscriber_poll(sub: RosSubscriber) -> RosSubscriber {
    if (sub).is_active {
        return RosSubscriber {
            topic_name: (sub).topic_name, msg_type: (sub).msg_type, qos: (sub).qos,
            n_recv: (sub).n_recv + 1, is_active: true
        };
    }
    return sub;
}

pub fn ros_subscriber_is_active(sub: RosSubscriber) -> Bool { return (sub).is_active; }

// Service Client & Server Operations

// Action Client Operations

pub fn ros_action_send_goal(client: RosActionClient, goal_id: Int) -> RosSentGoal {
    if (client).is_connected {
        return RosSentGoal {
            client: RosActionClient {
                action_name: (client).action_name,
                action_type: (client).action_type,
                active_goals: (client).active_goals + 1,
                is_connected: true,
            },
            goal: RosActionGoal {
                goal_id: goal_id,
                status: 1,
            },
        };
    }
    return RosSentGoal {
        client: client,
        goal: RosActionGoal {
            goal_id: goal_id,
            status: 4,
        },
    };
}

pub fn ros_action_cancel_goal(goal: RosActionGoal) -> RosActionGoal {
    return RosActionGoal { goal_id: (goal).goal_id, status: 3 };
}

pub fn ros_action_goal_is_finished(goal: RosActionGoal) -> Bool {
    let st: Int = (goal).status;
    if st == 2  { return true; }
    if st == 3  { return true; }
    if st == 4  { return true; }
    return false;
}

// Transform Operations

pub fn transform_identity(parent: String, child: String) -> Transform {
    return Transform {
        parent_frame: parent, child_frame: child, tx: 0, ty: 0, tz: 0, rx: 0, ry: 0,
        rz: 0, timestamp: 0
    };
}

pub fn transform_invert(t: Transform) -> Transform {
    return Transform {
        parent_frame: (t).child_frame, child_frame: (t).parent_frame,
        tx: 0 - (t).tx, ty: 0 - (t).ty, tz: 0 - (t).tz, rx: 0 - (t).rx,
        ry: 0 - (t).ry, rz: 0 - (t).rz, timestamp: (t).timestamp
    };
}

pub fn transform_apply(t: Transform, px: Int, py: Int, pz: Int) -> TransformPoint {
    return TransformPoint { x: px + (t).tx, y: py + (t).ty, z: pz + (t).tz };
}
