// # Safe Bencode encoder
//
// Logline: Encodes Bencode integers, byte strings, lists, and dictionaries with lexicographic key order.
//
// Setup: Pure. Bytes are List[Int] 0..255. Dictionary values are already-encoded items.
//
// Beats:
//   1. Emit i<n>e without a leading zero or negative zero.
//   2. Emit <len>:<bytes> for byte strings.
//   3. Wrap child encodings as l…e lists.
//   4. Sort two dictionary keys and emit d…e.

import "std/byte_out.oo";
import "std/encoding/bencode_safe_parse.oo";

fn be_digits(n: Int) -> List[Int] {
    if n == 0 {
        let mut z: List[Int] = list_new();
        z = list_push(z, 48);
        return z;
    }
    let mut x: Int = n;
    let mut neg: Int = 0;
    if x < 0 {
        neg = 1;
        x = 0 - x;
    }
    let mut tmp: List[Int] = list_new();
    while x > 0 {
        tmp = list_push(tmp, 48 + (x % 10));
        x = x / 10;
    }
    let mut o: List[Int] = list_new();
    if neg == 1 {
        o = list_push(o, 45);
    }
    let mut i: Int = list_len(tmp) - 1;
    while i >= 0 {
        o = list_push(o, list_get(tmp, i));
        i = i - 1;
    }
    return o;
}

fn be_cat(a: List[Int], b: List[Int]) -> List[Int] {
    let mut o: List[Int] = a;
    let mut i: Int = 0;
    while i < list_len(b) {
        o = list_push(o, list_get(b, i) & 255);
        i = i + 1;
    }
    return o;
}

pub fn bencode_safe_encode_int(v: Int) -> ByteOut {
    let mut o: List[Int] = list_new();
    o = list_push(o, 105);
    o = be_cat(o, be_digits(v));
    o = list_push(o, 101);
    return byte_out_ok(o);
}

pub fn bencode_safe_encode_str(b: List[Int]) -> ByteOut {
    let mut i: Int = 0;
    while i < list_len(b) {
        let x: Int = list_get(b, i);
        if x < 0 {
            return byte_out_err("bencode byte");
        }
        if x > 255 {
            return byte_out_err("bencode byte");
        }
        i = i + 1;
    }
    let mut o: List[Int] = be_digits(list_len(b));
    o = list_push(o, 58);
    o = be_cat(o, b);
    return byte_out_ok(o);
}

pub fn bencode_safe_encode_list_n(n: Int, kids: List[Int]) -> ByteOut {
    if n < 0 {
        return byte_out_err("bencode list");
    }
    let mut o: List[Int] = list_new();
    o = list_push(o, 108);
    o = be_cat(o, kids);
    o = list_push(o, 101);
    return byte_out_ok(o);
}

fn be_cmp(a: List[Int], b: List[Int]) -> Int {
    let mut i: Int = 0;
    let na: Int = list_len(a);
    let nb: Int = list_len(b);
    let mut n: Int = na;
    if nb < n {
        n = nb;
    }
    while i < n {
        let da: Int = list_get(a, i);
        let db: Int = list_get(b, i);
        if da < db {
            return 0 - 1;
        }
        if da > db {
            return 1;
        }
        i = i + 1;
    }
    if na < nb {
        return 0 - 1;
    }
    if na > nb {
        return 1;
    }
    return 0;
}

pub fn bencode_safe_encode_dict2(k0: List[Int], v0: List[Int], k1: List[Int], v1: List[Int]) -> ByteOut {
    let e0: ByteOut = bencode_safe_encode_str(k0);
    let e1: ByteOut = bencode_safe_encode_str(k1);
    if e0.flag < 1 {
        return e0;
    }
    if e1.flag < 1 {
        return e1;
    }
    let mut o: List[Int] = list_new();
    o = list_push(o, 100);
    if be_cmp(k0, k1) <= 0 {
        o = be_cat(o, e0.bytes);
        o = be_cat(o, v0);
        o = be_cat(o, e1.bytes);
        o = be_cat(o, v1);
    } else {
        o = be_cat(o, e1.bytes);
        o = be_cat(o, v1);
        o = be_cat(o, e0.bytes);
        o = be_cat(o, v0);
    }
    o = list_push(o, 101);
    return byte_out_ok(o);
}

pub fn bencode_safe_cat(a: List[Int], b: List[Int]) -> List[Int] { return be_cat(a, b); }

pub fn bencode_safe_parse(buf: List[Int]) -> ByteOut { return bencode_safe_parse_all(buf); }

pub fn bencode_safe_parse_stat(buf: List[Int]) -> Result[Int, String] { return byte_out_stat(bencode_safe_parse_all(buf)); }

pub fn bencode_safe_stat(o: ByteOut) -> Result[Int, String] { return byte_out_stat(o); }
