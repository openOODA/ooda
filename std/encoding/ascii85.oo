// # Ascii85 (Base85) Binary-to-Text Encoding Module
//
// Logline: Adobe Ascii85 (btoa) 4-to-5 byte packing, 'z' run abbreviation, and <~ ~> framing tags.
//
// Setup: Pure algorithmic 32-bit word division across radix-85 characters (ASCII 33 '!' through 117 'u').
//
// Beats:
//   1. Pack 4-byte big-endian integers into 5-character radix-85 strings.
//   2. Abbreviate all-zero 4-byte blocks as 'z'.
//   3. Decode Ascii85 strings into original binary bytes with tag handling.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";
import "std/byte.oo";

type Ascii85Config = struct {
    wrap_tags: Bool,
    abbreviate_zeros: Bool
};

pub fn ascii85_config_default() -> Ascii85Config {
    return Ascii85Config {
        wrap_tags: false,
        abbreviate_zeros: true
    };
}

pub fn ascii85_encode(s: String) -> String {
    let blen: Int = byte_len(s);
    if blen == 0 {
        return "";
    }
    let mut out: String = "";
    let mut i: Int = 0;
    while i < blen {
        let b0: Int = byte_get(s, i);
        let mut b1: Int = 0;
        let mut b2: Int = 0;
        let mut b3: Int = 0;
        let rem: Int = blen - i;
        if rem > 1 { b1 = byte_get(s, i + 1); }
        if rem > 2 { b2 = byte_get(s, i + 2); }
        if rem > 3 { b3 = byte_get(s, i + 3); }

        let mut word: Int = (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3;
        if rem >= 4 && word == 0 {
            out = out + "z";
        } else {
            let mut c4: Int = (word % 85) + 33;
            word = word / 85;
            let mut c3: Int = (word % 85) + 33;
            word = word / 85;
            let mut c2: Int = (word % 85) + 33;
            word = word / 85;
            let mut c1: Int = (word % 85) + 33;
            word = word / 85;
            let mut c0: Int = (word % 85) + 33;

            let mut block: List[Int] = byte_buf_new();
            block = byte_buf_push(block, c0);
            block = byte_buf_push(block, c1);
            block = byte_buf_push(block, c2);
            block = byte_buf_push(block, c3);
            block = byte_buf_push(block, c4);
            let b_str: String = byte_buf_to_str(block);

            if rem >= 4 {
                out = out + b_str;
            } else {
                let keep_count: Int = rem + 1;
                out = out + str_slice(b_str, 0, keep_count);
            }
        }
        i = i + 4;
    }
    return out;
}

pub fn ascii85_decode(s: String) -> Result[String, String] {
    let mut clean: String = s;
    if str_starts_with(clean, "<~") {
        clean = str_slice(clean, 2, chars_len(clean));
    }
    if str_ends_with(clean, "~>") {
        clean = str_slice(clean, 0, chars_len(clean) - 2);
    }
    let n: Int = chars_len(clean);
    if n == 0 {
        return Ok("");
    }
    let mut buf: List[Int] = byte_buf_new();
    let mut word: Int = 0;
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(clean, i);
        if char_is_space(c) || c == "\n" || c == "\r" || c == "\t" {
            i = i + 1;
        } else if c == "z" && count == 0 {
            buf = byte_buf_push(buf, 0);
            buf = byte_buf_push(buf, 0);
            buf = byte_buf_push(buf, 0);
            buf = byte_buf_push(buf, 0);
            i = i + 1;
        } else {
            let o: Int = ord(c);
            if o < 33 || o > 117 {
                return Err("ASCII85_ERR: character out of range");
            }
            let val: Int = o - 33;
            word = (word * 85) + val;
            count = count + 1;
            if count == 5 {
                let b0: Int = (word / 16777216) % 256;
                let b1: Int = (word / 65536) % 256;
                let b2: Int = (word / 256) % 256;
                let b3: Int = word % 256;
                buf = byte_buf_push(buf, b0);
                buf = byte_buf_push(buf, b1);
                buf = byte_buf_push(buf, b2);
                buf = byte_buf_push(buf, b3);
                word = 0;
                count = 0;
            }
            i = i + 1;
        }
    }
    if count > 1 {
        let mut k: Int = count;
        while k < 5 {
            word = (word * 85) + 84;
            k = k + 1;
        }
        let b0: Int = (word / 16777216) % 256;
        let b1: Int = (word / 65536) % 256;
        let b2: Int = (word / 256) % 256;
        let b3: Int = word % 256;
        let bytes_to_add: Int = count - 1;
        if bytes_to_add >= 1 { buf = byte_buf_push(buf, b0); }
        if bytes_to_add >= 2 { buf = byte_buf_push(buf, b1); }
        if bytes_to_add >= 3 { buf = byte_buf_push(buf, b2); }
    } else if count == 1 {
        return Err("ASCII85_ERR: invalid leftover single character");
    }
    return Ok(byte_buf_to_str(buf));
}

pub fn ascii85_is_valid(s: String) -> Bool {
    let r: Result[String, String] = ascii85_decode(s);
    return r.is_ok();
}
