// # Canonical CBOR encoder
//
// Logline: Encodes RFC 8949 definite CBOR integers, byte strings, text, arrays, and maps in shortest form.
//
// Setup: Pure. Bytes are List[Int] 0..255. Returns ByteOut. Nested encode concatenates children.
//
// Beats:
//   1. Write a major-type header with the shortest additional-info argument.
//   2. Encode unsigned and negative integers.
//   3. Encode byte strings and UTF-8 text as definite-length payloads.
//   4. Wrap concatenated child items as arrays and maps.

import "std/byte_out.oo";
import "std/encoding/cbor_strict_dec.oo";

fn cbor_head(major: Int, n: Int) -> List[Int] {
    let mt: Int = major * 32;
    let mut o: List[Int] = list_new();
    if n < 24 {
        o = list_push(o, mt + n);
        return o;
    }
    if n < 256 {
        o = list_push(o, mt + 24);
        o = list_push(o, n & 255);
        return o;
    }
    if n < 65536 {
        o = list_push(o, mt + 25);
        o = list_push(o, (n >> 8) & 255);
        o = list_push(o, n & 255);
        return o;
    }
    o = list_push(o, mt + 26);
    o = list_push(o, (n >> 24) & 255);
    o = list_push(o, (n >> 16) & 255);
    o = list_push(o, (n >> 8) & 255);
    o = list_push(o, n & 255);
    return o;
}

fn cbor_cat(a: List[Int], b: List[Int]) -> List[Int] {
    let mut o: List[Int] = a;
    let mut i: Int = 0;
    while i < list_len(b) {
        o = list_push(o, list_get(b, i) & 255);
        i = i + 1;
    }
    return o;
}

pub fn cbor_strict_encode_int(v: Int) -> ByteOut {
    if v >= 0 {
        return byte_out_ok(cbor_head(0, v));
    }
    let arg: Int = 0 - 1 - v;
    if arg < 0 {
        return byte_out_err("cbor int");
    }
    let h: List[Int] = cbor_head(0, arg);
    let mut o: List[Int] = list_new();
    o = list_push(o, (list_get(h, 0) & 31) + 32);
    let mut i: Int = 1;
    while i < list_len(h) {
        o = list_push(o, list_get(h, i));
        i = i + 1;
    }
    return byte_out_ok(o);
}

pub fn cbor_strict_encode_bstr(b: List[Int]) -> ByteOut {
    let mut i: Int = 0;
    while i < list_len(b) {
        let x: Int = list_get(b, i);
        if x < 0 {
            return byte_out_err("cbor byte");
        }
        if x > 255 {
            return byte_out_err("cbor byte");
        }
        i = i + 1;
    }
    let mut o: List[Int] = cbor_head(2, list_len(b));
    i = 0;
    while i < list_len(b) {
        o = list_push(o, list_get(b, i));
        i = i + 1;
    }
    return byte_out_ok(o);
}

pub fn cbor_strict_encode_tstr(b: List[Int]) -> ByteOut {
    let r: ByteOut = cbor_strict_encode_bstr(b);
    if r.flag < 1 {
        return r;
    }
    let mut o: List[Int] = list_new();
    let h: Int = list_get(r.bytes, 0);
    o = list_push(o, (h & 31) + 96);
    let mut i: Int = 1;
    while i < list_len(r.bytes) {
        o = list_push(o, list_get(r.bytes, i));
        i = i + 1;
    }
    return byte_out_ok(o);
}

pub fn cbor_strict_encode_array_n(n: Int, kids: List[Int]) -> ByteOut {
    if n < 0 {
        return byte_out_err("cbor array");
    }
    let mut o: List[Int] = cbor_head(4, n);
    o = cbor_cat(o, kids);
    return byte_out_ok(o);
}

pub fn cbor_strict_encode_map_n(n: Int, kids: List[Int]) -> ByteOut {
    if n < 0 {
        return byte_out_err("cbor map");
    }
    let mut o: List[Int] = cbor_head(5, n);
    o = cbor_cat(o, kids);
    return byte_out_ok(o);
}

pub fn cbor_strict_cat(a: List[Int], b: List[Int]) -> List[Int] { return cbor_cat(a, b); }

pub fn cbor_strict_decode(buf: List[Int]) -> ByteOut { return cbor_strict_dec_parse(buf); }

pub fn cbor_strict_decode_stat(buf: List[Int]) -> Result[Int, String] { return byte_out_stat(cbor_strict_dec_parse(buf)); }

pub fn cbor_strict_stat(o: ByteOut) -> Result[Int, String] { return byte_out_stat(o); }

pub fn cbor_major_uint() -> Int { return 0; }
pub fn cbor_major_negint() -> Int { return 32; }
pub fn cbor_major_bytestr() -> Int { return 64; }
pub fn cbor_major_textstr() -> Int { return 96; }
pub fn cbor_major_array() -> Int { return 128; }
pub fn cbor_major_map() -> Int { return 160; }
pub fn cbor_major_simple() -> Int { return 224; }

pub fn cbor_encode_uint_bytes(v: Int) -> List[Int] {
    if v < 0 {
        return list_new();
    }
    return cbor_head(0, v);
}

