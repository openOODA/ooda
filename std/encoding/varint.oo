// # Variable-Length Integer (Varint / LEB128) Module
//
// Logline: LEB128 unsigned integer packing, signed ZigZag transformations, byte stream decoding, and size computation.
//
// Setup: Pure algorithmic 7-bit payload packing with MSB continuation markers for compact serialization.
//
// Beats:
//   1. Encode 32-bit/64-bit unsigned integers into compact LEB128 byte sequences.
//   2. Decode variable-length integer bytes and return decoded value plus byte count.
//   3. Implement signed ZigZag mapping to preserve small positive/negative integer density.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";
import "std/byte.oo";

type VarintResult = struct {
    value: Int,
    bytes_consumed: Int,
    is_ok: Bool
};

pub fn zigzag_encode(n: Int) -> Int {
    if n >= 0 {
        return n * 2;
    }
    return ((0 - n) * 2) - 1;
}

pub fn zigzag_decode(n: Int) -> Int {
    if (n % 2) == 0 {
        return n / 2;
    }
    return 0 - ((n + 1) / 2);
}

pub fn varint_encoded_len(val: Int) -> Int {
    if val < 0 {
        return 5;
    }
    let mut v: Int = val;
    let mut count: Int = 1;
    while v >= 128 {
        v = v / 128;
        count = count + 1;
    }
    return count;
}

pub fn varint_encode(val: Int) -> String {
    let mut v: Int = val;
    if v < 0 {
        v = zigzag_encode(val);
    }
    let mut buf: List[Int] = byte_buf_new();
    while true {
        if v < 128 {
            buf = byte_buf_push(buf, v);
            break;
        } else {
            let b: Int = (v % 128) + 128;
            buf = byte_buf_push(buf, b);
            v = v / 128;
        }
    }
    return byte_buf_to_str(buf);
}

pub fn varint_decode(s: String, start_offset: Int) -> VarintResult {
    let blen: Int = byte_len(s);
    if start_offset < 0 || start_offset >= blen {
        return VarintResult { value: 0, bytes_consumed: 0, is_ok: false };
    }
    let mut result: Int = 0;
    let mut shift: Int = 1;
    let mut count: Int = 0;
    let mut i: Int = start_offset;
    while i < blen && count < 10 {
        let b: Int = byte_get(s, i);
        count = count + 1;
        let payload: Int = b % 128;
        result = result + (payload * shift);
        shift = shift * 128;
        if b < 128 {
            return VarintResult {
                value: result,
                bytes_consumed: count,
                is_ok: true
            };
        }
        i = i + 1;
    }
    return VarintResult { value: 0, bytes_consumed: count, is_ok: false };
}

pub fn varint_encode_signed(val: Int) -> String {
    let zz: Int = zigzag_encode(val);
    return varint_encode(zz);
}

pub fn varint_decode_signed(s: String, start_offset: Int) -> VarintResult {
    let res: VarintResult = varint_decode(s, start_offset);
    if !res.is_ok {
        return res;
    }
    let decoded: Int = zigzag_decode(res.value);
    return VarintResult {
        value: decoded,
        bytes_consumed: res.bytes_consumed,
        is_ok: true
    };
}
