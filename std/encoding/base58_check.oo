// # Base58Check with double-SHA256
//
// Logline: Encodes a byte payload with a 4-byte double-SHA256 checksum in the Bitcoin/IPFS Base58 alphabet and preserves leading zeros.
//
// Setup: Pure. Payload is List[Int] 0..255. Uses crypto_sha256_internal. Checksum mismatch is Err.
//
// Beats:
//   1. Hash the payload twice with SHA-256 and take four checksum bytes.
//   2. Encode payload plus checksum in Base58, mapping leading zero bytes to '1'.
//   3. Decode and verify the checksum.
//   4. Reject invalid characters and a truncated payload.

import "std/encoding/base58_check_codec.oo";

pub fn base58_check_encode(payload: List[Int]) -> B58Out { return base58_check_codec_enc(payload); }

pub fn base58_check_decode(text: String) -> ByteOut { return base58_check_codec_dec(text); }

pub fn base58_check_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}
