// # Base64 Binary-to-Text Encoding Module
//
// Logline: RFC 4648 Base64 and URL-safe Base64 encoding, decoding, padding management, and validation.
//
// Setup: Pure algorithmic 6-bit/8-bit byte grouping and table translation for standard and URL-safe alphabets.
//
// Beats:
//   1. Encode byte sequences into 4-character Base64 blocks with '=' padding.
//   2. Decode Base64 character streams into reconstructed original strings.
//   3. Provide URL-safe alphabet substitution ('-' and '_') without padding.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";
import "std/byte.oo";

type Base64Config = struct {
    url_safe: Bool,
    include_padding: Bool
};

pub fn base64_config_default() -> Base64Config {
    return Base64Config {
        url_safe: false,
        include_padding: true
    };
}

pub fn base64_config_url() -> Base64Config {
    return Base64Config {
        url_safe: true,
        include_padding: false
    };
}

fn b64_char(val: Int, url_safe: Bool) -> String {
    let alphabet_std: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    let alphabet_url: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    if val < 0 || val > 63 {
        return "";
    }
    if url_safe {
        return char_at(alphabet_url, val);
    }
    return char_at(alphabet_std, val);
}

fn b64_val(c: String) -> Int {
    let alphabet_std: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    let alphabet_url: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    let idx_std: Int = str_index_of(alphabet_std, c);
    if idx_std >= 0 {
        return idx_std;
    }
    let idx_url: Int = str_index_of(alphabet_url, c);
    if idx_url >= 0 {
        return idx_url;
    }
    return -1;
}

pub fn base64_encode_custom(s: String, cfg: Base64Config) -> String {
    let blen: Int = byte_len(s);
    if blen == 0 {
        return "";
    }
    let mut out: String = "";
    let mut i: Int = 0;
    while i < blen {
        let b0: Int = byte_get(s, i);
        let mut b1: Int = 0;
        let mut b2: Int = 0;
        let has_b1: Bool = (i + 1) < blen;
        let has_b2: Bool = (i + 2) < blen;
        if has_b1 { b1 = byte_get(s, i + 1); }
        if has_b2 { b2 = byte_get(s, i + 2); }

        let idx0: Int = b0 / 4;
        let idx1: Int = ((b0 % 4) * 16) + (b1 / 16);
        let idx2: Int = ((b1 % 16) * 4) + (b2 / 64);
        let idx3: Int = b2 % 64;

        let use_url: Bool = cfg.url_safe;
        let pad: Bool = cfg.include_padding;
        out = out + b64_char(idx0, use_url);
        out = out + b64_char(idx1, use_url);
        if has_b1 {
            out = out + b64_char(idx2, use_url);
        } else if pad {
            out = out + "=";
        }
        if has_b2 {
            out = out + b64_char(idx3, use_url);
        } else if pad {
            out = out + "=";
        }

        i = i + 3;
    }
    return out;
}

pub fn base64_encode(s: String) -> String {
    return base64_encode_custom(s, base64_config_default());
}

pub fn base64url_encode(s: String) -> String {
    return base64_encode_custom(s, base64_config_url());
}

pub fn base64_decode(s: String) -> Result[String, String] {
    let n: Int = chars_len(s);
    if n == 0 {
        return Ok("");
    }
    let mut buf: List[Int] = byte_buf_new();
    let mut i: Int = 0;
    while i < n {
        let c0: String = char_at(s, i);
        if c0 == "=" { break; }
        if i + 1 >= n { return Err("BASE64_ERR: unexpected end of input"); }
        let c1: String = char_at(s, i + 1);
        if c1 == "=" { return Err("BASE64_ERR: invalid padding at index 1"); }

        let mut c2: String = "=";
        let mut c3: String = "=";
        if i + 2 < n { c2 = char_at(s, i + 2); }
        if i + 3 < n { c3 = char_at(s, i + 3); }

        let v0: Int = b64_val(c0);
        let v1: Int = b64_val(c1);
        if v0 < 0 || v1 < 0 { return Err("BASE64_ERR: invalid character"); }

        let b0: Int = (v0 * 4) + (v1 / 16);
        buf = bytes_push(buf, b0);

        if c2 != "=" && c2 != "" {
            let v2: Int = b64_val(c2);
            if v2 < 0 { return Err("BASE64_ERR: invalid character"); }
            let b1: Int = ((v1 % 16) * 16) + (v2 / 4);
            buf = bytes_push(buf, b1);

            if c3 != "=" && c3 != "" {
                let v3: Int = b64_val(c3);
                if v3 < 0 { return Err("BASE64_ERR: invalid character"); }
                let b2: Int = ((v2 % 4) * 64) + v3;
                buf = bytes_push(buf, b2);
            }
        }

        i = i + 4;
    }
    let res_s: String = byte_buf_to_str(buf);
    return Ok(res_s);
}

pub fn base64url_decode(s: String) -> Result[String, String] {
    return base64_decode(s);
}

pub fn base64_is_valid(s: String) -> Bool {
    let r: Result[String, String] = base64_decode(s);
    return r.is_ok();
}
