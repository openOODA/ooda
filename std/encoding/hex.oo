// # Hexadecimal (Base16) Binary-to-Text Encoding Module
//
// Logline: RFC 4648 Base16 hexadecimal serialization, deserialization, nibble mapping, and formatted string emission.
//
// Setup: Pure algorithmic 4-bit nibble decomposition and hex string decoding without ambient dependencies.
//
// Beats:
//   1. Encode byte sequences into lowercase and uppercase hexadecimal strings.
//   2. Decode valid 2-character hex pairs into raw byte streams.
//   3. Validate hexadecimal string well-formedness and character ranges.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";
import "std/byte.oo";

type HexConfig = struct {
    uppercase: Bool,
    delimiter: String
};

pub fn hex_config_default() -> HexConfig {
    return HexConfig {
        uppercase: false,
        delimiter: ""
    };
}

pub fn hex_nibble_val(c: String) -> Int {
    let hex_chars: String = "0123456789abcdef";
    let hex_upper: String = "0123456789ABCDEF";
    let idx_l: Int = str_index_of(hex_chars, c);
    if idx_l >= 0 {
        return idx_l;
    }
    let idx_u: Int = str_index_of(hex_upper, c);
    if idx_u >= 0 {
        return idx_u;
    }
    return -1;
}

pub fn hex_byte_to_str(b: Int, upper: Bool) -> String {
    let hex_chars: String = "0123456789abcdef";
    let hex_upper: String = "0123456789ABCDEF";
    let clamped: Int = byte_clamp(b);
    let high: Int = clamped / 16;
    let low: Int = clamped % 16;
    if upper {
        return char_at(hex_upper, high) + char_at(hex_upper, low);
    }
    return char_at(hex_chars, high) + char_at(hex_chars, low);
}

pub fn hex_encode_custom(s: String, cfg: HexConfig) -> String {
    let blen: Int = byte_len(s);
    if blen == 0 {
        return "";
    }
    let mut out: String = "";
    let mut i: Int = 0;
    while i < blen {
        let b: Int = byte_get(s, i);
        let pair: String = hex_byte_to_str(b, cfg.uppercase);
        if i > 0 && chars_len(cfg.delimiter) > 0 {
            out = out + cfg.delimiter + pair;
        } else {
            out = out + pair;
        }
        i = i + 1;
    }
    return out;
}

pub fn hex_encode(s: String) -> String {
    return hex_encode_custom(s, hex_config_default());
}

pub fn hex_encode_upper(s: String) -> String {
    let cfg: HexConfig = HexConfig { uppercase: true, delimiter: "" };
    return hex_encode_custom(s, cfg);
}

pub fn hex_decode(s: String) -> Result[String, String] {
    let n: Int = chars_len(s);
    if n == 0 {
        return Ok("");
    }
    if (n % 2) != 0 {
        return Err("HEX_ERR: odd number of hex characters");
    }
    let mut buf: List[Int] = byte_buf_new();
    let mut i: Int = 0;
    while i < n {
        let c0: String = char_at(s, i);
        let c1: String = char_at(s, i + 1);
        let v0: Int = hex_nibble_val(c0);
        let v1: Int = hex_nibble_val(c1);
        if v0 < 0 || v1 < 0 {
            return Err("HEX_ERR: invalid non-hex character encountered");
        }
        let b: Int = (v0 * 16) + v1;
        buf = byte_buf_push(buf, b);
        i = i + 2;
    }
    return Ok(byte_buf_to_str(buf));
}

pub fn hex_is_valid(s: String) -> Bool {
    let n: Int = chars_len(s);
    if (n % 2) != 0 {
        return false;
    }
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if hex_nibble_val(c) < 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}
