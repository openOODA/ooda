// # Base58 Binary-to-Text Encoding Module
//
// Logline: Bitcoin/IPFS Base58 encoding, decoding, large integer radix arithmetic, and leading zero preservation.
//
// Setup: Pure algorithmic radix-58 encoding avoiding ambiguous characters (0, O, I, l).
//
// Beats:
//   1. Encode byte sequences into Base58 representation with leading zero preservation.
//   2. Decode Base58 strings back to raw byte arrays and strings.
//   3. Provide integer-to-Base58 and Base58-to-integer conversion helpers.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";
import "std/byte.oo";

type Base58Alphabet = struct {
    chars: String
};

pub fn base58_alphabet_default() -> Base58Alphabet {
    return Base58Alphabet {
        chars: "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    };
}

fn b58_alphabet() -> String {
    return "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
}

pub fn base58_encode_int(val: Int) -> String {
    if val == 0 {
        return "1";
    }
    let mut v: Int = val;
    if v < 0 {
        v = 0 - v;
    }
    let alpha: String = b58_alphabet();
    let mut rev: String = "";
    while v > 0 {
        let rem: Int = v % 58;
        rev = rev + char_at(alpha, rem);
        v = v / 58;
    }
    let n: Int = chars_len(rev);
    let mut out: String = "";
    let mut k: Int = n - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}

pub fn base58_decode_int(s: String) -> Result[Int, String] {
    let n: Int = chars_len(s);
    if n == 0 {
        return Err("BASE58_ERR: empty input");
    }
    let alpha: String = b58_alphabet();
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        let idx: Int = str_index_of(alpha, c);
        if idx < 0 {
            return Err("BASE58_ERR: invalid character in Base58 stream");
        }
        acc = (acc * 58) + idx;
        i = i + 1;
    }
    return Ok(acc);
}

fn b58_digits_set(digits: List[Int], idx: Int, val: Int) -> List[Int] {
    let n: Int = list_len(digits);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            out = list_push(out, val);
        } else {
            out = list_push(out, list_get(digits, i));
        }
        i = i + 1;
    }
    return out;
}

pub fn base58_encode(s: String) -> String {
    let blen: Int = byte_len(s);
    if blen == 0 {
        return "";
    }
    let mut zeros: Int = 0;
    while zeros < blen && byte_get(s, zeros) == 0 {
        zeros = zeros + 1;
    }
    let mut digits: List[Int] = list_new();
    let mut i: Int = zeros;
    while i < blen {
        let mut carry: Int = byte_get(s, i);
        let mut j: Int = 0;
        let n: Int = list_len(digits);
        while j < n {
            carry = carry + (256 * list_get(digits, j));
            digits = b58_digits_set(digits, j, carry % 58);
            carry = carry / 58;
            j = j + 1;
        }
        while carry > 0 {
            digits = list_push(digits, carry % 58);
            carry = carry / 58;
        }
        i = i + 1;
    }
    let alpha: String = b58_alphabet();
    let mut out: String = "";
    let mut z: Int = 0;
    while z < zeros {
        out = out + "1";
        z = z + 1;
    }
    let dlen: Int = list_len(digits);
    let mut k: Int = dlen - 1;
    while k >= 0 {
        out = out + char_at(alpha, list_get(digits, k));
        k = k - 1;
    }
    return out;
}

pub fn base58_decode(s: String) -> Result[String, String] {
    let n: Int = chars_len(s);
    if n == 0 {
        return Ok("");
    }
    let alpha: String = b58_alphabet();
    let mut zeros: Int = 0;
    while zeros < n && char_at(s, zeros) == "1" {
        zeros = zeros + 1;
    }
    let mut digits: List[Int] = list_new();
    let mut i: Int = zeros;
    while i < n {
        let c: String = char_at(s, i);
        let idx: Int = str_index_of(alpha, c);
        if idx < 0 {
            return Err("BASE58_ERR: invalid character in Base58 stream");
        }
        let mut carry: Int = idx;
        let mut j: Int = 0;
        let dn: Int = list_len(digits);
        while j < dn {
            carry = carry + (58 * list_get(digits, j));
            digits = b58_digits_set(digits, j, carry % 256);
            carry = carry / 256;
            j = j + 1;
        }
        while carry > 0 {
            digits = list_push(digits, carry % 256);
            carry = carry / 256;
        }
        i = i + 1;
    }
    let mut buf: List[Int] = byte_buf_new();
    let mut z: Int = 0;
    while z < zeros {
        buf = byte_buf_push(buf, 0);
        z = z + 1;
    }
    let dlen: Int = list_len(digits);
    let mut k: Int = dlen - 1;
    while k >= 0 {
        buf = byte_buf_push(buf, list_get(digits, k));
        k = k - 1;
    }
    return Ok(byte_buf_to_str(buf));
}
