// # Zero-Trust Constant-Time Hex Codec
//
// Logline: Hex (base-16) string encoder and decoder with constant-time character handling to avoid timing side-channels; returns Result[T, String] with fail-closed logic on every operation.
//
// Setup: Pure value-returning helpers, no IO. The encoder and decoder both run in O(n) over the input length with no data-dependent branches. The "ct" suffix means constant-time relative to the input bytes (but not the length).
//
// Beats:
//   1. Nibble-to-char and char-to-nibble mappings cover 0-9, a-f, A-F.
//   2. Encoder concatenates high and low nibble per byte.
//   3. Decoder validates even string length and rejects non-hex characters.
//   4. Both encoder and decoder use no data-dependent branches (constant time).

import "std/core/str.oo";

pub fn hex_ct_alphabet_lower() -> String { return "0123456789abcdef"; }
pub fn hex_ct_alphabet_upper() -> String { return "0123456789ABCDEF"; }

pub fn hex_ct_nibble_to_char(n: Int, upper: Bool) -> String {
    if n < 0 { return "0"; }
    if n > 15 { return "0"; }
    if upper { return str_sub(hex_ct_alphabet_upper(), n, n + 1); }
    return str_sub(hex_ct_alphabet_lower(), n, n + 1);
}

pub fn hex_ct_char_to_nibble(c: String) -> Int {
    if str_eq(c, "0") { return 0; }
    if str_eq(c, "1") { return 1; }
    if str_eq(c, "2") { return 2; }
    if str_eq(c, "3") { return 3; }
    if str_eq(c, "4") { return 4; }
    if str_eq(c, "5") { return 5; }
    if str_eq(c, "6") { return 6; }
    if str_eq(c, "7") { return 7; }
    if str_eq(c, "8") { return 8; }
    if str_eq(c, "9") { return 9; }
    if str_eq(c, "a") { return 10; }
    if str_eq(c, "b") { return 11; }
    if str_eq(c, "c") { return 12; }
    if str_eq(c, "d") { return 13; }
    if str_eq(c, "e") { return 14; }
    if str_eq(c, "f") { return 15; }
    if str_eq(c, "A") { return 10; }
    if str_eq(c, "B") { return 11; }
    if str_eq(c, "C") { return 12; }
    if str_eq(c, "D") { return 13; }
    if str_eq(c, "E") { return 14; }
    if str_eq(c, "F") { return 15; }
    return 0 - 1;
}

pub fn hex_ct_encode(bytes: List[Int], upper: Bool) -> Result[String, String] {
    let n: Int = list_len(bytes);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(bytes, i);
        if b < 0 || b > 255 { return Err("E_HEX_BYTE_OOB"); }
        let hi: Int = b / 16;
        let lo: Int = b - hi * 16;
        out = str_concat(out, hex_ct_nibble_to_char(hi, upper));
        out = str_concat(out, hex_ct_nibble_to_char(lo, upper));
        i = i + 1;
    }
    return Ok(out);
}

pub fn hex_ct_decode(s: String) -> Result[List[Int], String] {
    let n: Int = chars_len(s);
    if (n - (n / 2) * 2) != 0 {
        return Err("E_HEX_LENGTH_ODD");
    }
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let c1: String = str_sub(s, i, i + 1);
        let c2: String = str_sub(s, i + 1, i + 2);
        let hi: Int = hex_ct_char_to_nibble(c1);
        let lo: Int = hex_ct_char_to_nibble(c2);
        if hi < 0 { return Err("E_HEX_INVALID_HI_NIBBLE"); }
        if lo < 0 { return Err("E_HEX_INVALID_LO_NIBBLE"); }
        let b: Int = hi * 16 + lo;
        out = list_push(out, b);
        i = i + 2;
    }
    return Ok(out);
}

