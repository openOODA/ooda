// # Comma-Separated Values (CSV) Module
//
// Logline: RFC 4180 CSV record parsing, field quoting, escaped quotes handling, and row serialization.
//
// Setup: Pure structured delimiter parser handling commas, quotes, CRLF breaks, and escaped double-quotes.
//
// Beats:
//   1. Parse CSV lines into field lists with full quote-escape support.
//   2. Escape and quote fields containing commas, quotes, or newlines.
//   3. Join lists of fields into compliant RFC 4180 CSV rows.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type CsvConfig = struct {
    delimiter: String,
    quote_char: String,
    escape_quotes: Bool
};

type CsvRow = struct {
    fields_joined: String,
    field_count: Int
};

pub fn csv_config_default() -> CsvConfig {
    return CsvConfig {
        delimiter: ",",
        quote_char: "\"",
        escape_quotes: true
    };
}

pub fn csv_escape_field(field: String) -> String {
    let needs_quotes: Bool = field.contains(",") || field.contains("\"") || field.contains("\n") || field.contains("\r");
    if !needs_quotes {
        return field;
    }
    let escaped: String = str_replace(field, "\"", "\"\"");
    return "\"" + escaped + "\"";
}

pub fn csv_parse_line(line: String) -> List[String] {
    let mut fields: List[String] = list_new();
    let n: Int = chars_len(line);
    let mut cur: String = "";
    let mut in_quotes: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(line, i);
        if c == "\"" {
            if in_quotes && i + 1 < n && char_at(line, i + 1) == "\"" {
                cur = cur + "\"";
                i = i + 1;
            } else {
                in_quotes = !in_quotes;
            }
        } else if c == "," && !in_quotes {
            fields = list_push(fields, cur);
            cur = "";
        } else if (c == "\r" || c == "\n") && !in_quotes {
            // End of line outside quotes
        } else {
            cur = cur + c;
        }
        i = i + 1;
    }
    fields = list_push(fields, cur);
    return fields;
}

pub fn csv_join_row(fields: List[String]) -> String {
    let mut out: String = "";
    let n: Int = list_len(fields);
    let mut i: Int = 0;
    while i < n {
        let f: String = list_get(fields, i);
        let escaped: String = csv_escape_field(f);
        if i > 0 {
            out = out + "," + escaped;
        } else {
            out = out + escaped;
        }
        i = i + 1;
    }
    return out;
}

pub fn csv_parse_document(doc: String) -> List[String] {
    let mut rows: List[String] = list_new();
    let n: Int = chars_len(doc);
    let mut cur_line: String = "";
    let mut in_quotes: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(doc, i);
        if c == "\"" {
            if in_quotes && i + 1 < n && char_at(doc, i + 1) == "\"" {
                cur_line = cur_line + "\"\"";
                i = i + 1;
            } else {
                in_quotes = !in_quotes;
            }
            cur_line = cur_line + c;
        } else if c == "\n" && !in_quotes {
            if chars_len(cur_line) > 0 {
                rows = list_push(rows, cur_line);
                cur_line = "";
            }
        } else {
            cur_line = cur_line + c;
        }
        i = i + 1;
    }
    if chars_len(cur_line) > 0 {
        rows = list_push(rows, cur_line);
    }
    return rows;
}
