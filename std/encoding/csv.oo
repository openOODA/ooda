// # Comma-Separated Values (CSV) Module
//
// Logline: RFC 4180 CSV record parsing, field quoting, escaped quotes handling, and row serialization.
//
// Setup: Pure structured delimiter parser handling commas, quotes, CRLF breaks, and escaped double-quotes.
//
// Beats:
//   1. Count and index comma fields with quote-escape support.
//   2. Escape and quote fields containing commas, quotes, or newlines.
//   3. Count document rows; two-field join. No List[String].
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: CsvConfig unused; document parse is a row count.

type CsvConfig = struct {
    delimiter: String,
    quote_char: String,
    escape_quotes: Bool
};

type CsvRow = struct {
    fields_joined: String,
    field_count: Int
};

pub fn csv_config_default() -> CsvConfig {
    return CsvConfig {
        delimiter: ",",
        quote_char: "\"",
        escape_quotes: true
    };
}

pub fn csv_escape_field(field: String) -> String {
    let has_comma: Bool = field.contains(",");
    let has_quote: Bool = field.contains("\"");
    let has_nl: Bool = field.contains("\n");
    if has_comma == false {
        if has_quote == false {
            if has_nl == false {
                return field;
            }
        }
    }
    let n: Int = chars_len(field);
    let mut escaped: String = "";
    let mut j: Int = 0;
    while j < n {
        let ch: String = char_at(field, j);
        if ch == "\"" {
            escaped = escaped + "\"\"";
        } else {
            escaped = escaped + ch;
        }
        j = j + 1;
    }
    return "\"" + escaped + "\"";
}

fn csv_is_quote(c: String) -> Bool {
    return c == "\"";
}

fn csv_is_comma(c: String) -> Bool {
    return c == ",";
}

pub fn csv_field_count(line: String) -> Int {
    let n: Int = chars_len(line);
    let mut count: Int = 1;
    let mut inq: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(line, i);
        if csv_is_quote(c) {
            if inq == true {
                if i + 1 < n {
                    if csv_is_quote(char_at(line, i + 1)) {
                        i = i + 1;
                    } else {
                        inq = false;
                    }
                } else {
                    inq = false;
                }
            } else {
                inq = true;
            }
        } else {
            if csv_is_comma(c) {
                if inq == false {
                    count = count + 1;
                }
            }
        }
        i = i + 1;
    }
    return count;
}

pub fn csv_nth_field(line: String, idx: Int) -> String {
    let n: Int = chars_len(line);
    let mut cur: String = "";
    let mut fi: Int = 0;
    let mut inq: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(line, i);
        if csv_is_quote(c) {
            if inq == true {
                if i + 1 < n {
                    if csv_is_quote(char_at(line, i + 1)) {
                        cur = cur + "\"";
                        i = i + 1;
                    } else {
                        inq = false;
                    }
                } else {
                    inq = false;
                }
            } else {
                inq = true;
            }
        } else {
            if csv_is_comma(c) {
                if inq == false {
                    if fi == idx {
                        return cur;
                    }
                    fi = fi + 1;
                    cur = "";
                } else {
                    cur = cur + c;
                }
            } else {
                cur = cur + c;
            }
        }
        i = i + 1;
    }
    if fi == idx {
        return cur;
    }
    return "";
}

pub fn csv_parse_line(line: String) -> CsvRow {
    return CsvRow {
        fields_joined: line,
        field_count: csv_field_count(line)
    };
}

pub fn csv_join_row(a: String, b: String) -> String {
    return csv_escape_field(a) + "," + csv_escape_field(b);
}

pub fn csv_parse_document(doc: String) -> Int {
    let n: Int = chars_len(doc);
    if n == 0 {
        return 0;
    }
    let mut rows: Int = 0;
    let mut inq: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(doc, i);
        if csv_is_quote(c) {
            if inq == true {
                if i + 1 < n {
                    if csv_is_quote(char_at(doc, i + 1)) {
                        i = i + 1;
                    } else {
                        inq = false;
                    }
                } else {
                    inq = false;
                }
            } else {
                inq = true;
            }
        } else {
            if inq == false {
                if c == "\n" {
                    rows = rows + 1;
                } else {
                    if c == "\r" {
                        if i + 1 < n {
                            if char_at(doc, i + 1) == "\n" {
                            } else {
                                rows = rows + 1;
                            }
                        } else {
                            rows = rows + 1;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    let last: String = char_at(doc, n - 1);
    if last == "\n" {
        return rows;
    }
    if last == "\r" {
        return rows;
    }
    return rows + 1;
}
