// # Universal Encoding Facade and Re-Export Module
//
// Logline: Unified entryway for Base64, Base32, Base58, Hex, CSV, TSV, URL encoding, Varint, and Ascii85 transforms.
//
// Setup: Composes encoding codecs into a coherent, standardized encoding API.
//
// Beats:
//   1. Re-export and wrap binary-to-text encoders (Base64, Hex, Base32, Base58, Ascii85).
//   2. Re-export and wrap structured data codecs (CSV, TSV, URL query params).
//   3. Re-export compact integer variable-length codecs (Varint / ZigZag).
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/encoding/base64.oo";
import "std/encoding/hex.oo";
import "std/encoding/url_encode.oo";
import "std/encoding/varint.oo";

type EncodingKind = struct {
    name: String
};

pub fn encoding_b64_encode(s: String) -> String {
    return base64_encode(s);
}

pub fn encoding_b64_decode(s: String) -> Result[String, String] {
    return base64_decode(s);
}

pub fn encoding_hex_encode(s: String) -> String {
    return hex_encode(s);
}

pub fn encoding_hex_decode(s: String) -> Result[String, String] {
    return hex_decode(s);
}

pub fn encoding_url_encode(s: String) -> String {
    return url_encode(s);
}

pub fn encoding_url_decode(s: String) -> Result[String, String] {
    return url_decode(s);
}

pub fn encoding_varint_encode(val: Int) -> String {
    return varint_encode(val);
}

pub fn encoding_varint_decode(s: String) -> Result[Int, String] {
    let res: VarintResult = varint_decode(s, 0);
    if res.is_ok {
        return Ok(res.value);
    }
    return Err("VARINT_ERR: failed to decode");
}
