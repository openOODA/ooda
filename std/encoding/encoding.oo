// # Universal Encoding Facade
//
// Logline: Hex, Base64, Base32, URL, and CSV transforms on the product emit path.
//
// Setup: Self-contained. Importing hex+base64+base32+csv together hangs emit-c.
//
// Beats:
//   1. RFC 4648 hex / Base64 / Base32 encode.
//   2. RFC 3986 component URL encode; RFC 4180 CSV field escape.
//   3. Pure data, zero ambient effects.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

fn enc_hex_digit(v: Int, upper: Bool) -> String {
    let hex_lo: String = "0123456789abcdef";
    let hex_up: String = "0123456789ABCDEF";
    if v < 0 || v > 15 {
        return "0";
    }
    if upper {
        return char_at(hex_up, v);
    }
    return char_at(hex_lo, v);
}

fn enc_hex_byte(b: Int, upper: Bool) -> String {
    let mut v: Int = b;
    if v < 0 {
        v = 0;
    }
    if v > 255 {
        v = 255;
    }
    return enc_hex_digit(v / 16, upper) + enc_hex_digit(v % 16, upper);
}

fn enc_b64_char(val: Int) -> String {
    let alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    if val < 0 || val > 63 {
        return "";
    }
    return char_at(alphabet, val);
}

fn enc_b32_char(val: Int) -> String {
    let alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
    if val < 0 || val > 31 {
        return "";
    }
    return char_at(alphabet, val);
}

fn enc_url_unreserved(c: String) -> Bool {
    return char_is_alpha(c) || char_is_digit(c) || c == "-" || c == "_" || c == "." || c == "~";
}

pub fn encoding_hex_encode(s: String) -> String {
    let blen: Int = bytes_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < blen {
        out = out + enc_hex_byte(byte_at(s, i), false);
        i = i + 1;
    }
    return out;
}

pub fn encoding_b64_encode(s: String) -> String {
    let blen: Int = bytes_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < blen {
        let b0: Int = byte_at(s, i);
        let mut b1: Int = 0;
        let mut b2: Int = 0;
        let has_b1: Bool = (i + 1) < blen;
        let has_b2: Bool = (i + 2) < blen;
        if has_b1 {
            b1 = byte_at(s, i + 1);
        }
        if has_b2 {
            b2 = byte_at(s, i + 2);
        }
        out = out + enc_b64_char(b0 / 4);
        out = out + enc_b64_char(((b0 % 4) * 16) + (b1 / 16));
        if has_b1 {
            out = out + enc_b64_char(((b1 % 16) * 4) + (b2 / 64));
        } else {
            out = out + "=";
        }
        if has_b2 {
            out = out + enc_b64_char(b2 % 64);
        } else {
            out = out + "=";
        }
        i = i + 3;
    }
    return out;
}

pub fn encoding_b32_encode(s: String) -> String {
    let blen: Int = bytes_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < blen {
        let b0: Int = byte_at(s, i);
        let mut b1: Int = 0;
        let mut b2: Int = 0;
        let mut b3: Int = 0;
        let mut b4: Int = 0;
        let rem: Int = blen - i;
        if rem > 1 {
            b1 = byte_at(s, i + 1);
        }
        if rem > 2 {
            b2 = byte_at(s, i + 2);
        }
        if rem > 3 {
            b3 = byte_at(s, i + 3);
        }
        if rem > 4 {
            b4 = byte_at(s, i + 4);
        }
        let c2: Int = (b1 % 64) / 2;
        let c3: Int = ((b1 % 2) * 16) + (b2 / 16);
        let c4: Int = ((b2 % 16) * 2) + (b3 / 128);
        let c5: Int = (b3 % 128) / 4;
        let c6: Int = ((b3 % 4) * 8) + (b4 / 32);
        out = out + enc_b32_char(b0 / 8);
        out = out + enc_b32_char(((b0 % 8) * 4) + (b1 / 64));
        if rem == 1 {
            out = out + "======";
        } else {
            if rem == 2 {
                out = out + enc_b32_char(c2) + enc_b32_char(c3) + "====";
            } else {
                if rem == 3 {
                    out = out + enc_b32_char(c2) + enc_b32_char(c3) + enc_b32_char(c4) + "===";
                } else {
                    if rem == 4 {
                        out = out + enc_b32_char(c2) + enc_b32_char(c3) + enc_b32_char(c4);
                        out = out + enc_b32_char(c5) + enc_b32_char(c6) + "=";
                    } else {
                        out = out + enc_b32_char(c2) + enc_b32_char(c3) + enc_b32_char(c4);
                        out = out + enc_b32_char(c5) + enc_b32_char(c6) + enc_b32_char(b4 % 32);
                    }
                }
            }
        }
        i = i + 5;
    }
    return out;
}

pub fn encoding_url_encode(s: String) -> String {
    let blen: Int = bytes_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < blen {
        let c: String = char_at(s, i);
        if enc_url_unreserved(c) {
            out = out + c;
        } else {
            out = out + "%" + enc_hex_byte(byte_at(s, i), true);
        }
        i = i + 1;
    }
    return out;
}

pub fn encoding_csv_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut need: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "," || c == "\"" || c == "\n" {
            need = true;
        }
        i = i + 1;
    }
    if need == false {
        return s;
    }
    let mut out: String = "\"";
    i = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\"" {
            out = out + "\"\"";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out + "\"";
}
