// # Base32 Binary-to-Text Encoding Module
//
// Logline: RFC 4648 Base32 and Base32hex encoding, decoding, 5-bit block packing, and padding handling.
//
// Setup: Pure algorithmic 5-bit byte stream grouping and lookup table translation for standard (A-Z, 2-7) and Base32hex alphabets.
//
// Beats:
//   1. Encode byte sequences into 8-character Base32 blocks with '=' padding.
//   2. Decode Base32 character sequences back to original byte strings.
//   3. Support Base32hex extended alphabet (0-9, A-V).
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";
import "std/byte.oo";

type Base32Config = struct {
    use_hex: Bool,
    include_padding: Bool
};

pub fn base32_config_default() -> Base32Config {
    return Base32Config {
        use_hex: false,
        include_padding: true
    };
}

pub fn base32_config_hex() -> Base32Config {
    return Base32Config {
        use_hex: true,
        include_padding: true
    };
}

fn b32_char(val: Int, use_hex: Bool) -> String {
    let alphabet_std: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
    let alphabet_hex: String = "0123456789ABCDEFGHIJKLMNOPQRSTUV";
    if val < 0 || val > 31 {
        return "";
    }
    if use_hex {
        return char_at(alphabet_hex, val);
    }
    return char_at(alphabet_std, val);
}

fn b32_val(c: String, use_hex: Bool) -> Int {
    let alphabet_std: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
    let alphabet_hex: String = "0123456789ABCDEFGHIJKLMNOPQRSTUV";
    if use_hex {
        return str_index_of(alphabet_hex, c);
    }
    return str_index_of(alphabet_std, c);
}

pub fn base32_encode_custom(s: String, cfg: Base32Config) -> String {
    let blen: Int = byte_len(s);
    if blen == 0 {
        return "";
    }
    let mut out: String = "";
    let mut i: Int = 0;
    while i < blen {
        let b0: Int = byte_get(s, i);
        let mut b1: Int = 0;
        let mut b2: Int = 0;
        let mut b3: Int = 0;
        let mut b4: Int = 0;

        let rem: Int = blen - i;
        if rem > 1 { b1 = byte_get(s, i + 1); }
        if rem > 2 { b2 = byte_get(s, i + 2); }
        if rem > 3 { b3 = byte_get(s, i + 3); }
        if rem > 4 { b4 = byte_get(s, i + 4); }

        let c0: Int = b0 / 8;
        let c1: Int = ((b0 % 8) * 4) + (b1 / 64);
        let c2: Int = (b1 % 64) / 2;
        let c3: Int = ((b1 % 2) * 16) + (b2 / 16);
        let c4: Int = ((b2 % 16) * 2) + (b3 / 128);
        let c5: Int = (b3 % 128) / 4;
        let c6: Int = ((b3 % 4) * 8) + (b4 / 32);
        let c7: Int = b4 % 32;

        let use_hex: Bool = cfg.use_hex;
        let pad: Bool = cfg.include_padding;
        out = out + b32_char(c0, use_hex);
        out = out + b32_char(c1, use_hex);
        if rem == 1 {
            if pad {
                out = out + "======";
            }
        } else if rem == 2 {
            out = out + b32_char(c2, use_hex);
            out = out + b32_char(c3, use_hex);
            if pad {
                out = out + "====";
            }
        } else if rem == 3 {
            out = out + b32_char(c2, use_hex);
            out = out + b32_char(c3, use_hex);
            out = out + b32_char(c4, use_hex);
            if pad {
                out = out + "===";
            }
        } else if rem == 4 {
            out = out + b32_char(c2, use_hex);
            out = out + b32_char(c3, use_hex);
            out = out + b32_char(c4, use_hex);
            out = out + b32_char(c5, use_hex);
            out = out + b32_char(c6, use_hex);
            if pad {
                out = out + "=";
            }
        } else {
            out = out + b32_char(c2, use_hex);
            out = out + b32_char(c3, use_hex);
            out = out + b32_char(c4, use_hex);
            out = out + b32_char(c5, use_hex);
            out = out + b32_char(c6, use_hex);
            out = out + b32_char(c7, use_hex);
        }

        i = i + 5;
    }
    return out;
}

pub fn base32_encode(s: String) -> String {
    return base32_encode_custom(s, base32_config_default());
}

pub fn base32_hex_encode(s: String) -> String {
    return base32_encode_custom(s, base32_config_hex());
}

pub fn base32_decode_custom(s: String, use_hex: Bool) -> Result[String, String] {
    let n: Int = chars_len(s);
    if n == 0 {
        return Ok("");
    }
    let mut vals: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "=" {
            i = i + 1;
        } else {
            let v: Int = b32_val(c, use_hex);
            if v < 0 {
                return Err("BASE32_ERR: invalid character");
            }
            vals = list_push(vals, v);
            i = i + 1;
        }
    }
    let nv: Int = list_len(vals);
    let mut buf: List[Int] = byte_buf_new();
    let mut g: Int = 0;
    while g < nv {
        let left: Int = nv - g;
        if left < 2 {
            return Err("BASE32_ERR: truncated sequence");
        }
        let v0: Int = list_get(vals, g);
        let v1: Int = list_get(vals, g + 1);
        let b0: Int = (v0 * 8) + (v1 / 4);
        buf = byte_buf_push(buf, b0);
        if left >= 4 {
            let v2: Int = list_get(vals, g + 2);
            let v3: Int = list_get(vals, g + 3);
            let b1: Int = ((v1 % 4) * 64) + (v2 * 2) + (v3 / 16);
            buf = byte_buf_push(buf, b1);
        }
        if left >= 5 {
            let v3b: Int = list_get(vals, g + 3);
            let v4: Int = list_get(vals, g + 4);
            let b2: Int = ((v3b % 16) * 16) + (v4 / 2);
            buf = byte_buf_push(buf, b2);
        }
        if left >= 7 {
            let v4b: Int = list_get(vals, g + 4);
            let v5: Int = list_get(vals, g + 5);
            let v6: Int = list_get(vals, g + 6);
            let b3: Int = ((v4b % 2) * 128) + (v5 * 4) + (v6 / 8);
            buf = byte_buf_push(buf, b3);
        }
        if left >= 8 {
            let v6b: Int = list_get(vals, g + 6);
            let v7: Int = list_get(vals, g + 7);
            let b4: Int = ((v6b % 8) * 32) + v7;
            buf = byte_buf_push(buf, b4);
        }
        g = g + 8;
    }
    return Ok(byte_buf_to_str(buf));
}

pub fn base32_decode(s: String) -> Result[String, String] {
    return base32_decode_custom(s, false);
}

pub fn base32_hex_decode(s: String) -> Result[String, String] {
    return base32_decode_custom(s, true);
}
