// # Tab-Separated Values (TSV) Module
//
// Logline: TSV record parsing, tab-delimiter extraction, escape handling, and line serialization.
//
// Setup: Pure tabular parser handling tab delimiters, escaped tabs (\t), escaped newlines (\n), and backslashes.
//
// Beats:
//   1. Split tab-delimited strings into discrete field tokens.
//   2. Escape tabs and newlines within fields.
//   3. Join lists of fields into standard TSV rows.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type TsvConfig = struct {
    handle_escapes: Bool
};

pub fn tsv_config_default() -> TsvConfig {
    return TsvConfig {
        handle_escapes: true
    };
}

pub fn tsv_escape_field(field: String) -> String {
    let mut out: String = str_replace(field, "\\", "\\\\");
    out = str_replace(out, "\t", "\\t");
    out = str_replace(out, "\n", "\\n");
    out = str_replace(out, "\r", "\\r");
    return out;
}

pub fn tsv_unescape_field(field: String) -> String {
    let mut out: String = str_replace(field, "\\t", "\t");
    out = str_replace(out, "\\n", "\n");
    out = str_replace(out, "\\r", "\r");
    out = str_replace(out, "\\\\", "\\");
    return out;
}

pub fn tsv_parse_line(line: String) -> List[String] {
    let mut fields: List[String] = list_new();
    let n: Int = chars_len(line);
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(line, i);
        if c == "\t" {
            fields = list_push(fields, tsv_unescape_field(cur));
            cur = "";
        } else if c == "\r" || c == "\n" {
            // ignore line-ends
        } else {
            cur = cur + c;
        }
        i = i + 1;
    }
    fields = list_push(fields, tsv_unescape_field(cur));
    return fields;
}

pub fn tsv_field_count(line: String) -> Int {
    let n: Int = chars_len(line);
    let mut count: Int = 1;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(line, i);
        if c == "\t" {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn tsv_nth_field(line: String, idx: Int) -> String {
    let n: Int = chars_len(line);
    let mut fi: Int = 0;
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(line, i);
        if c == "\t" {
            if fi == idx {
                return tsv_unescape_field(cur);
            }
            fi = fi + 1;
            cur = "";
        } else {
            if c == "\r" {
            } else {
                if c == "\n" {
                } else {
                    cur = cur + c;
                }
            }
        }
        i = i + 1;
    }
    if fi == idx {
        return tsv_unescape_field(cur);
    }
    return "";
}

pub fn tsv_join_row(fields: List[String]) -> String {
    let mut out: String = "";
    let n: Int = list_len(fields);
    let mut i: Int = 0;
    while i < n {
        let f: String = list_get(fields, i);
        let esc: String = tsv_escape_field(f);
        if i > 0 {
            out = out + "\t" + esc;
        } else {
            out = out + esc;
        }
        i = i + 1;
    }
    return out;
}
