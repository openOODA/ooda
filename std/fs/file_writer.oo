// # Cap-Gated File Writer
//
// Logline: Structured atomic and buffered file writes, appending, and line emission under &FsWriteCap.
//
// Setup: Requires &FsWriteCap to mutate target file contents, &FsReadCap for reading prior state in append mode.
//
// Beats:
//   1. Open FileWriter handle with append or truncate mode.
//   2. Write full string buffer to target path under &FsWriteCap.
//   3. Append string content or individual lines to target file.
//   4. Truncate target file to zero length.
//
// residual: in-memory string aggregation over sealed write_file and read_file builtins

type FileWriter = struct {
    path: String,
    append_mode: Bool,
    bytes_written: Int
};

// Open a file writer descriptor for given path.
pub fn file_writer_open(path: String, append_mode: Bool) -> FileWriter {
    return FileWriter {
        path: path,
        append_mode: append_mode,
        bytes_written: 0
    };
}

// Write full string content to target path under &FsWriteCap.
pub fn file_writer_write(fw: &FsWriteCap, writer: FileWriter, content: String) -> Result[FileWriter, String] {
    let r: Result[Void, String] = write_file(fw, writer.path, content);
    if r.is_err() {
        return Err("WRITE_FAILED");
    }
    let clen: Int = chars_len(content);
    let cur_w: Int = writer.bytes_written;
    let updated: FileWriter = FileWriter {
        path: writer.path,
        append_mode: writer.append_mode,
        bytes_written: cur_w + clen
    };
    return Ok(updated);
}

// Append string content to existing file under &FsWriteCap and &FsReadCap.
pub fn file_writer_append(
    fw: &FsWriteCap,
    fr: &FsReadCap,
    writer: FileWriter,
    content: String
) -> Result[FileWriter, String] {
    let mut existing: String = "";
    if path_exists(fr, writer.path) {
        let r: Result[String, String] = read_file(fr, writer.path);
        existing = match r {
            Ok(v) => v,
            Err(_) => ""
        };
    }
    let combined: String = existing + content;
    let wr: Result[Void, String] = write_file(fw, writer.path, combined);
    if wr.is_err() {
        return Err("APPEND_FAILED");
    }
    let clen: Int = chars_len(content);
    let cur_w: Int = writer.bytes_written;
    let updated: FileWriter = FileWriter {
        path: writer.path,
        append_mode: writer.append_mode,
        bytes_written: cur_w + clen
    };
    return Ok(updated);
}

// Write list of line strings separated by newlines.
pub fn file_writer_write_lines(
    fw: &FsWriteCap,
    writer: FileWriter,
    lines: List[String]
) -> Result[FileWriter, String] {
    let n: Int = list_len(lines);
    let mut acc: String = "";
    let mut i: Int = 0;
    while i < n {
        let line: String = list_get(lines, i);
        acc = acc + line + "\n";
        i = i + 1;
    }
    return file_writer_write(fw, writer, acc);
}

// Truncate target file to empty content under &FsWriteCap.
pub fn file_writer_truncate(fw: &FsWriteCap, writer: FileWriter) -> Result[FileWriter, String] {
    let r: Result[Void, String] = write_file(fw, writer.path, "");
    if r.is_err() {
        return Err("TRUNCATE_FAILED");
    }
    let updated: FileWriter = FileWriter {
        path: writer.path,
        append_mode: writer.append_mode,
        bytes_written: 0
    };
    return Ok(updated);
}

// Return total bytes written by this writer session.
pub fn file_writer_bytes_written(writer: FileWriter) -> Int {
    return writer.bytes_written;
}
