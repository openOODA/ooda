// # Filesystem Glob Pattern Matcher
//
// Logline: Wildcard glob matching and directory filtering under pure pattern rules or &FsReadCap scanning.
//
// Setup: Pure pattern matching with optional &FsReadCap directory traversal.
//
// Beats:
//   1. Construct GlobPattern with wildcard pattern string.
//   2. Test string against glob pattern matching '*' and '?'.
//   3. Filter list of file paths against glob pattern.
//   4. Scan directory tree under &FsReadCap returning all matching entries.
//
// residual: recursive single-star wildcard matching without complex regex engines

type GlobPattern = struct {
    pattern: String
};

// Construct a new GlobPattern record.
pub fn glob_new(pattern: String) -> GlobPattern {
    return GlobPattern { pattern: pattern };
}

// True if pattern contains wildcard symbols '*' or '?'.
pub fn glob_has_wildcards(pattern: String) -> Bool {
    let n: Int = chars_len(pattern);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(pattern, i);
        if c == "*" || c == "?" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Internal recursive glob matcher for slices.
pub fn glob_match_slice(pat: String, pi: Int, plen: Int, txt: String, ti: Int, tlen: Int) -> Bool {
    if pi == plen {
        return ti == tlen;
    }
    let p_char: String = char_at(pat, pi);
    if p_char == "*" {
        // Try skipping '*' matching 0 chars, or match 1 char and recurse
        if glob_match_slice(pat, pi + 1, plen, txt, ti, tlen) {
            return true;
        }
        if ti < tlen {
            return glob_match_slice(pat, pi, plen, txt, ti + 1, tlen);
        }
        return false;
    }
    if ti < tlen {
        let t_char: String = char_at(txt, ti);
        if p_char == "?" || p_char == t_char {
            return glob_match_slice(pat, pi + 1, plen, txt, ti + 1, tlen);
        }
    }
    return false;
}

// Check if candidate string matches glob pattern.
pub fn glob_matches(pattern: String, text: String) -> Bool {
    let plen: Int = chars_len(pattern);
    let tlen: Int = chars_len(text);
    return glob_match_slice(pattern, 0, plen, text, 0, tlen);
}

// Filter a list of string paths against a glob pattern.
pub fn glob_filter(pattern: String, paths: List[String]) -> List[String] {
    let n: Int = list_len(paths);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        let p: String = list_get(paths, i);
        if glob_matches(pattern, p) {
            out = list_push(out, p);
        }
        i = i + 1;
    }
    return out;
}

// Scan a directory under &FsReadCap and collect all paths matching pattern.
pub fn glob_scan_dir(fs: &FsReadCap, dir_path: String, pattern: String) -> List[String] {
    let mut out: List[String] = list_new();
    if !path_exists(fs, dir_path) {
        return out;
    }
    let entries: List[String] = oo_fs_read_dir(fs, dir_path);
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        let entry: String = list_get(entries, i);
        let mut full_path: String = dir_path + "/" + entry;
        if str_ends_with(dir_path, "/") {
            full_path = dir_path + entry;
        }
        if glob_matches(pattern, entry) || glob_matches(pattern, full_path) {
            out = list_push(out, full_path);
        }
        i = i + 1;
    }
    return out;
}
