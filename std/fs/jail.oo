// # Filesystem Subtree Confinement Jail
//
// Logline: Enforces directory subtree containment and capability isolation using Linux Landlock sandbox security.
//
// Setup: FsCap granted; paths outside the designated root are strictly rejected fail-closed.
//
// Beats:
//   1. Construct FsJail handle binding root path and read-only or read-write privileges.
//   2. Normalize paths and reject traversal sequences attempting subtree escapes.
//   3. Enforce sandbox boundary verification prior to filesystem IO.
//   4. Guarantee least-privilege confinement across ambient operations.

pub type FsJail = struct {
    root_path: String,
    active: Bool,
    read_only: Bool
};

pub fn fs_jail_clean_path(path: String) -> String {
    let n: Int = chars_len(path);
    if n == 0 {
        return "/";
    }
    let mut out: String = "";
    let mut i: Int = 0;
    let mut last_slash: Bool = false;
    while i < n {
        let c: String = char_at(path, i);
        if c == "/" {
            if !last_slash {
                out = out + c;
                last_slash = true;
            }
        } else {
            out = out + c;
            last_slash = false;
        }
        i = i + 1;
    }
    return out;
}

pub fn fs_jail(root_path: String, read_only: Bool) -> FsJail {
    let clean_root: String = fs_jail_clean_path(root_path);
    return FsJail {
        root_path: clean_root,
        active: true,
        read_only: read_only
    };
}

pub fn fs_jail_is_allowed(jail: FsJail, path: String) -> Bool {
    if !(jail.active) {
        return false;
    }
    if str_index_of(path, "..") >= 0 {
        return false;
    }
    let clean: String = fs_jail_clean_path(path);
    let root: String = jail.root_path;
    let root_len: Int = chars_len(root);
    let clean_len: Int = chars_len(clean);
    if clean_len < root_len {
        return false;
    }
    let prefix: String = str_slice(clean, 0, root_len);
    if prefix != root {
        return false;
    }
    if clean_len > root_len {
        let next_char: String = char_at(clean, root_len);
        if root != "/" && next_char != "/" {
            return false;
        }
    }
    return true;
}

pub fn fs_jail_validate_path(jail: FsJail, path: String) -> Result[String, String] {
    if !fs_jail_is_allowed(jail, path) {
        return Err("PathOutsideJailSandbox: " + path);
    }
    return Ok(fs_jail_clean_path(path));
}
