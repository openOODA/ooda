// # Pure Path Manipulation Module
//
// Logline: Pure filesystem path normalization, join, split, extension, and parent resolution without ambient effects.
//
// Setup: Pure path calculus: zero capabilities required.
//
// Beats:
//   1. Construct and wrap path strings.
//   2. Join path components with normalized directory separators.
//   3. Extract basename, dirname (parent), and file extension.
//   4. Normalize redundant separators, dots, and parent references.
//
// residual: purely in-memory POSIX-style path string transformations

type Path = struct {
    raw: String
};

// Wrap a raw path string into a Path record.
pub fn path_new(raw: String) -> Path {
    return Path { raw: raw };
}

// Return raw string from Path record.
pub fn path_to_string(p: Path) -> String {
    return p.raw;
}

// True if path begins with root separator '/'.
pub fn path_is_absolute(p: String) -> Bool {
    let n: Int = chars_len(p);
    if n == 0 {
        return false;
    }
    return char_at(p, 0) == "/";
}

// True if path does not begin with '/'.
pub fn path_is_relative(p: String) -> Bool {
    let is_abs: Bool = path_is_absolute(p);
    return !is_abs;
}

// Join base path with a child segment inserting '/' when needed.
pub fn path_join(base: String, segment: String) -> String {
    let blen: Int = chars_len(base);
    let slen: Int = chars_len(segment);
    if blen == 0 {
        return segment;
    }
    if slen == 0 {
        return base;
    }
    if path_is_absolute(segment) {
        return segment;
    }
    if str_ends_with(base, "/") {
        return base + segment;
    }
    return base + "/" + segment;
}

// Extract parent directory of path.
pub fn path_parent(p: String) -> String {
    let n: Int = chars_len(p);
    if n <= 1 {
        return "";
    }
    let mut last_slash: Int = 0 - 1;
    let mut i: Int = n - 1;
    // Skip trailing slash if present
    if char_at(p, i) == "/" {
        i = i - 1;
    }
    while i >= 0 {
        if char_at(p, i) == "/" {
            last_slash = i;
            i = 0 - 1;
        } else {
            i = i - 1;
        }
    }
    if last_slash < 0 {
        return "";
    }
    if last_slash == 0 {
        return "/";
    }
    return str_slice(p, 0, last_slash);
}

// Extract the final component of a path.
pub fn path_basename(p: String) -> String {
    let n: Int = chars_len(p);
    if n == 0 {
        return "";
    }
    let mut end: Int = n;
    if char_at(p, n - 1) == "/" {
        end = n - 1;
    }
    let mut last_slash: Int = 0 - 1;
    let mut i: Int = end - 1;
    while i >= 0 {
        if char_at(p, i) == "/" {
            last_slash = i;
            i = 0 - 1;
        } else {
            i = i - 1;
        }
    }
    if last_slash < 0 {
        return str_slice(p, 0, end);
    }
    return str_slice(p, last_slash + 1, end);
}

// Extract file extension including dot, or empty string.
pub fn path_extension(p: String) -> String {
    let base: String = path_basename(p);
    let n: Int = chars_len(base);
    let mut last_dot: Int = 0 - 1;
    let mut i: Int = n - 1;
    while i >= 0 {
        if char_at(base, i) == "." {
            last_dot = i;
            i = 0 - 1;
        } else {
            i = i - 1;
        }
    }
    if last_dot <= 0 {
        return "";
    }
    return str_slice(base, last_dot, n);
}

// Return path without file extension.
pub fn path_without_extension(p: String) -> String {
    let ext: String = path_extension(p);
    let elen: Int = chars_len(ext);
    let plen: Int = chars_len(p);
    if elen == 0 {
        return p;
    }
    return str_slice(p, 0, plen - elen);
}

// Normalize redundant slashes and relative dot segments.
pub fn path_normalize(p: String) -> String {
    let parts: List[String] = str_split(p, "/");
    let n: Int = list_len(parts);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        let seg: String = list_get(parts, i);
        let slen: Int = chars_len(seg);
        if slen > 0 {
            if seg != "." {
                if seg == ".." {
                    let out_len: Int = list_len(out);
                    if out_len > 0 {
                        // Drop last element if not already ..
                        let mut temp: List[String] = list_new();
                        let mut j: Int = 0;
                        while j < out_len - 1 {
                            temp = list_push(temp, list_get(out, j));
                            j = j + 1;
                        }
                        out = temp;
                    }
                } else {
                    out = list_push(out, seg);
                }
            }
        }
        i = i + 1;
    }
    let m: Int = list_len(out);
    let mut res: String = "";
    if path_is_absolute(p) {
        res = "/";
    }
    let mut k: Int = 0;
    while k < m {
        if k > 0 {
            if !str_ends_with(res, "/") {
                res = res + "/";
            }
        }
        res = res + list_get(out, k);
        k = k + 1;
    }
    if chars_len(res) == 0 {
        return ".";
    }
    return res;
}
