// # File Information and Metadata Module
//
// Logline: Comprehensive file metadata descriptor holding size, permissions, directory flag, and existence state.
//
// Setup: Requires &FsReadCap to probe filesystem node metadata.
//
// Beats:
//   1. Query file information for given path under &FsReadCap.
//   2. Inspect file existence, byte size, directory flag, and readability.
//   3. Format file size into human-readable unit string.
//   4. Construct synthetic FileInfo descriptor for test fixtures.
//
// residual: in-memory metadata record over sealed path_exists, oo_fs_is_dir, and file_size

type FileInfo = struct {
    path: String,
    exists: Bool,
    is_directory: Bool,
    size_bytes: Int,
    is_readable: Bool
};

// Query file info from filesystem under &FsReadCap.
pub fn file_info_get(fs: &FsReadCap, path: String) -> FileInfo {
    let ex: Bool = path_exists(fs, path);
    if !ex {
        return FileInfo {
            path: path,
            exists: false,
            is_directory: false,
            size_bytes: 0,
            is_readable: false
        };
    }
    let is_dir: Bool = oo_fs_is_dir(fs, path);
    let mut sz: Int = 0;
    if !is_dir {
        sz = file_size(fs, path);
    }
    return FileInfo {
        path: path,
        exists: true,
        is_directory: is_dir,
        size_bytes: sz,
        is_readable: true
    };
}

// Construct synthetic FileInfo descriptor.
pub fn file_info_synthetic(
    path: String,
    exists: Bool,
    is_dir: Bool,
    size: Int
) -> FileInfo {
    return FileInfo {
        path: path,
        exists: exists,
        is_directory: is_dir,
        size_bytes: size,
        is_readable: exists
    };
}

// True if file exists and has 0 byte size.
pub fn file_info_is_empty(info: FileInfo) -> Bool {
    let ex: Bool = info.exists;
    let is_d: Bool = info.is_directory;
    let sz: Int = info.size_bytes;
    if !ex {
        return true;
    }
    if is_d {
        return false;
    }
    return sz == 0;
}

// Format byte count to human-readable string.
pub fn file_info_format_size(size_bytes: Int) -> String {
    if size_bytes < 1024 {
        let s: String = size_bytes.to_string();
        return s + " B";
    }
    if size_bytes < 1048576 {
        let kb: Int = size_bytes / 1024;
        let s2: String = kb.to_string();
        return s2 + " KB";
    }
    let mb: Int = size_bytes / 1048576;
    let s3: String = mb.to_string();
    return s3 + " MB";
}

// Return path from FileInfo.
pub fn file_info_path(info: FileInfo) -> String {
    return info.path;
}

// Return size from FileInfo.
pub fn file_info_size(info: FileInfo) -> Int {
    return info.size_bytes;
}
