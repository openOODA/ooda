// # Cap-Gated File Reader
//
// Logline: Structured buffered reading of file contents with bounds checks and position offsets.
//
// Setup: Requires &FsReadCap to read file contents from disk.
//
// Beats:
//   1. Open FileReader handle for a target path.
//   2. Read entire file contents into string under &FsReadCap.
//   3. Read range slice between byte offsets.
//   4. Read file split into discrete line entries.
//
// residual: in-memory string splitting over sealed read_file and file_size builtins

type FileReader = struct {
    path: String,
    is_open: Bool
};

// Open a file reader handle for given path.
pub fn file_reader_open(fs: &FsReadCap, path: String) -> Result[FileReader, String] {
    if !path_exists(fs, path) {
        return Err("FILE_NOT_FOUND");
    }
    let reader: FileReader = FileReader {
        path: path,
        is_open: true
    };
    return Ok(reader);
}

// Read entire file content into string.
pub fn file_reader_read_all(fs: &FsReadCap, reader: FileReader) -> Result[String, String] {
    let is_op: Bool = reader.is_open;
    if !is_op {
        return Err("READER_CLOSED");
    }
    let res: Result[String, String] = read_file(fs, reader.path);
    if res.is_err() {
        return Err("READ_FAILED");
    }
    let s: String = match res {
        Ok(v) => v,
        Err(_) => ""
    };
    return Ok(s);
}

// Read sub-slice range between start_pos and end_pos.
pub fn file_reader_read_range(
    fs: &FsReadCap,
    reader: FileReader,
    start_pos: Int,
    end_pos: Int
) -> Result[String, String] {
    let is_op: Bool = reader.is_open;
    if !is_op {
        return Err("READER_CLOSED");
    }
    let res: Result[String, String] = read_file(fs, reader.path);
    if res.is_err() {
        return Err("READ_FAILED");
    }
    let s: String = match res {
        Ok(v) => v,
        Err(_) => ""
    };
    let total_len: Int = chars_len(s);
    let mut sp: Int = start_pos;
    let mut ep: Int = end_pos;
    if sp < 0 {
        sp = 0;
    }
    if sp > total_len {
        sp = total_len;
    }
    if ep < sp {
        ep = sp;
    }
    if ep > total_len {
        ep = total_len;
    }
    let slice: String = str_slice(s, sp, ep);
    return Ok(slice);
}

// Read file split into list of discrete line entries.
pub fn file_reader_lines(fs: &FsReadCap, reader: FileReader) -> Result[List[String], String] {
    let is_op: Bool = reader.is_open;
    if !is_op {
        return Err("READER_CLOSED");
    }
    let res: Result[String, String] = read_file(fs, reader.path);
    if res.is_err() {
        return Err("READ_FAILED");
    }
    let s: String = match res {
        Ok(v) => v,
        Err(_) => ""
    };
    let lines: List[String] = str_split(s, "\n");
    return Ok(lines);
}

// Query file size in bytes under &FsReadCap.
pub fn file_reader_size(fs: &FsReadCap, reader: FileReader) -> Int {
    let is_op: Bool = reader.is_open;
    if !is_op {
        return 0;
    }
    return file_size(fs, reader.path);
}

// Check whether file exists under &FsReadCap.
pub fn file_reader_exists(fs: &FsReadCap, reader: FileReader) -> Bool {
    return path_exists(fs, reader.path);
}
