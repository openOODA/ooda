// # Cap-Gated High-Level Filesystem Operations
//
// Logline: High-level atomic file copying, recursive deletion, directory creation, and move operations.
//
// Setup: Requires &FsReadCap for reading/probing and &FsWriteCap for mutation.
//
// Beats:
//   1. Copy file contents safely between source and destination paths.
//   2. Ensure directory path hierarchy exists (mkdir -p).
//   3. Recursively remove directory trees under &FsWriteCap and &FsReadCap.
//   4. Move or rename file via copy and delete under capabilities.
//
// residual: high-level composition over sealed fs builtins

type FsOpResult = struct {
    success: Bool,
    error_message: String
};

// Copy file content from src to dst under &FsReadCap and &FsWriteCap.
pub fn fs_ops_copy_file(
    fr: &FsReadCap,
    fw: &FsWriteCap,
    src: String,
    dst: String
) -> Result[Void, String] {
    if !path_exists(fr, src) {
        return Err("SRC_NOT_FOUND");
    }
    let res: Result[String, String] = read_file(fr, src);
    if res.is_err() {
        return Err("READ_SRC_FAILED");
    }
    let body: String = match res {
        Ok(v) => v,
        Err(_) => ""
    };
    return write_file(fw, dst, body);
}

// Move/rename file from src to dst.
pub fn fs_ops_move_file(
    fr: &FsReadCap,
    fw: &FsWriteCap,
    src: String,
    dst: String
) -> Result[Void, String] {
    let cp: Result[Void, String] = fs_ops_copy_file(fr, fw, src, dst);
    if cp.is_err() {
        return cp;
    }
    return oo_fs_remove_file(fw, src);
}

// Ensure full directory path hierarchy exists.
pub fn fs_ops_mkdir_p(fw: &FsWriteCap, path: String) -> Result[Void, String] {
    let n: Int = chars_len(path);
    if n == 0 {
        return Ok(());
    }
    let mut acc: String = "";
    let mut i: Int = 0;
    if char_at(path, 0) == "/" {
        acc = "/";
        i = 1;
    }
    while i < n {
        let c: String = char_at(path, i);
        if c == "/" {
            let alen: Int = chars_len(acc);
            if alen > 0 {
                if acc != "/" {
                    let mk: Result[Void, String] = oo_fs_mkdir(fw, acc);
                    if mk.is_err() {
                        let hold = 0;
                        if hold != 0 { println(""); }
                    }
                }
            }
            if !str_ends_with(acc, "/") {
                acc = acc + "/";
            }
        } else {
            acc = acc + c;
        }
        i = i + 1;
    }
    let final_len: Int = chars_len(acc);
    if final_len > 0 {
        if acc != "/" {
            return oo_fs_mkdir(fw, acc);
        }
    }
    return oo_fs_mkdir(fw, path);
}

// Recursively remove directory tree under capabilities.
pub fn fs_ops_remove_tree(
    fw: &FsWriteCap,
    fr: &FsReadCap,
    path: String
) -> Result[Void, String] {
    if !path_exists(fr, path) {
        return Ok(());
    }
    let is_d: Bool = oo_fs_is_dir(fr, path);
    if !is_d {
        return oo_fs_remove_file(fw, path);
    }
    let ents: List[String] = oo_fs_read_dir(fr, path);
    let n: Int = list_len(ents);
    let mut i: Int = 0;
    while i < n {
        let name: String = list_get(ents, i);
        let mut sub: String = path + "/" + name;
        if str_ends_with(path, "/") {
            sub = path + name;
        }
        let r: Result[Void, String] = fs_ops_remove_tree(fw, fr, sub);
        if r.is_err() {
            return r;
        }
        i = i + 1;
    }
    return oo_fs_rmdir(fw, path);
}

// Touch a file, creating it if absent or keeping content.
pub fn fs_ops_touch(
    fw: &FsWriteCap,
    fr: &FsReadCap,
    path: String
) -> Result[Void, String] {
    if path_exists(fr, path) {
        return Ok(());
    }
    return write_file(fw, path, "");
}
