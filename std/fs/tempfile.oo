// # Temporary File and Directory Manager
//
// Logline: Manage temporary file generation, isolated scratch paths, and cleanup under &FsWriteCap and &SysCap.
//
// Setup: Requires &FsWriteCap for file creation/removal and &SysCap for process isolation / PID / entropy.
//
// Beats:
//   1. Generate unique temporary filename with prefix, id, and suffix.
//   2. Create temporary file and write payload under &FsWriteCap.
//   3. Create isolated temporary directory under &FsWriteCap.
//   4. Remove temporary file or directory under &FsWriteCap.
//
// residual: deterministic counter/prefix naming without ambient /tmp auto-discovery

type TempFile = struct {
    path: String,
    is_active: Bool
};

type TempDir = struct {
    path: String,
    is_active: Bool
};

// Generate deterministic temporary path under /tmp/.
pub fn tempfile_generate_name(prefix: String, counter: Int, suffix: String) -> String {
    let mut pfx: String = prefix;
    if chars_len(pfx) == 0 {
        pfx = "tmp_ooda";
    }
    let cnt_str: String = counter.to_string();
    return "/tmp/" + pfx + "_" + cnt_str + suffix;
}

// Create a temporary file and populate with initial content.
pub fn tempfile_create(
    fw: &FsWriteCap,
    prefix: String,
    initial_content: String,
    counter: Int
) -> Result[TempFile, String] {
    let path: String = tempfile_generate_name(prefix, counter, ".tmp");
    let wr: Result[Void, String] = write_file(fw, path, initial_content);
    if wr.is_err() {
        return Err("TEMPFILE_CREATE_FAILED");
    }
    let tf: TempFile = TempFile {
        path: path,
        is_active: true
    };
    return Ok(tf);
}

// Remove temporary file from filesystem under &FsWriteCap.
pub fn tempfile_remove(fw: &FsWriteCap, tf: TempFile) -> Result[Void, String] {
    let is_act: Bool = tf.is_active;
    if !is_act {
        return Ok(());
    }
    return oo_fs_remove_file(fw, tf.path);
}

// Create an isolated temporary directory under &FsWriteCap.
pub fn tempdir_create(fw: &FsWriteCap, prefix: String, counter: Int) -> Result[TempDir, String] {
    let path: String = tempfile_generate_name(prefix, counter, "_dir");
    let mk: Result[Void, String] = oo_fs_mkdir(fw, path);
    if mk.is_err() {
        return Err("TEMPDIR_CREATE_FAILED");
    }
    let td: TempDir = TempDir {
        path: path,
        is_active: true
    };
    return Ok(td);
}

// Remove temporary directory under &FsWriteCap.
pub fn tempdir_remove(fw: &FsWriteCap, td: TempDir) -> Result[Void, String] {
    let is_act: Bool = td.is_active;
    if !is_act {
        return Ok(());
    }
    return oo_fs_rmdir(fw, td.path);
}

// Get path string from TempFile.
pub fn tempfile_path(tf: TempFile) -> String {
    return tf.path;
}

// Get path string from TempDir.
pub fn tempdir_path(td: TempDir) -> String {
    return td.path;
}
