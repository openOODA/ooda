// # Directory Entry Metadata Record
//
// Logline: Structured directory entry representation encapsulating file name, path, kind, and size attributes.
//
// Setup: Constructed during directory traversal or created from raw path under &FsReadCap.
//
// Beats:
//   1. Construct DirEntry with path, name, is_dir flag, and size.
//   2. Probe entry from filesystem under &FsReadCap.
//   3. Query entry classification (file vs directory).
//   4. Format directory entry to summary string.
//
// residual: in-memory directory entry metadata wrapping sealed oo_fs_is_dir and oo_file_size

type DirEntry = struct {
    full_path: String,
    file_name: String,
    is_dir: Bool,
    size_bytes: Int
};

// Construct a new DirEntry record.
pub fn dir_entry_new(
    full_path: String,
    file_name: String,
    is_dir: Bool,
    size_bytes: Int
) -> DirEntry {
    return DirEntry {
        full_path: full_path,
        file_name: file_name,
        is_dir: is_dir,
        size_bytes: size_bytes
    };
}

// Probe filesystem under &FsReadCap and construct DirEntry.
pub fn dir_entry_from_fs(fs: &FsReadCap, base_dir: String, name: String) -> DirEntry {
    let mut full: String = base_dir + "/" + name;
    if str_ends_with(base_dir, "/") {
        full = base_dir + name;
    }
    let is_d: Bool = oo_fs_is_dir(fs, full);
    let mut sz: Int = 0;
    if !is_d {
        if path_exists(fs, full) {
            sz = file_size(fs, full);
        }
    }
    return DirEntry {
        full_path: full,
        file_name: name,
        is_dir: is_d,
        size_bytes: sz
    };
}

// Return full path of directory entry.
pub fn dir_entry_path(entry: DirEntry) -> String {
    return entry.full_path;
}

// Return file name of directory entry.
pub fn dir_entry_name(entry: DirEntry) -> String {
    return entry.file_name;
}

// True if entry is a directory.
pub fn dir_entry_is_directory(entry: DirEntry) -> Bool {
    return entry.is_dir;
}

// True if entry is a regular file.
pub fn dir_entry_is_file(entry: DirEntry) -> Bool {
    let is_d: Bool = entry.is_dir;
    return !is_d;
}

// Return size of entry in bytes.
pub fn dir_entry_size(entry: DirEntry) -> Int {
    return entry.size_bytes;
}

// Format directory entry to descriptive summary string.
pub fn dir_entry_summary(entry: DirEntry) -> String {
    let is_d: Bool = entry.is_dir;
    let mut kind_str: String = "FILE";
    if is_d {
        kind_str = "DIR";
    }
    let fname: String = entry.file_name;
    let sz: Int = entry.size_bytes;
    let sz_str: String = sz.to_string();
    return "[" + kind_str + "] " + fname + " (" + sz_str + " bytes)";
}
