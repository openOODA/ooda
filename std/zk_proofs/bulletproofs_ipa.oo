// # Bulletproofs inner-product argument
//
// Logline: Folds two vectors under a challenge and verifies a 64-bit bit-decomposition range.
//
// Setup: Pure. IPA identity is <a',b'> = <a,b> + x L + x^{-1} R modulo 2147483647. Bits must be 0 or 1.
//
// Beats:
//   1. Compute the inner product of equal-length vectors.
//   2. Fold halves with a public challenge x.
//   3. Check the IPA identity on the folded vectors.
//   4. Reconstruct a 64-bit value from bits and reject a non-bit.

pub type IpaOut = struct {
    flag: Int,
    err: String,
    ip: Int,
    folded: Int,
    value: Int
};

fn ipa_err(m: String) -> IpaOut {
    return IpaOut { flag: 0, err: "ERR\tipa: " + m, ip: 0, folded: 0, value: 0 };
}

fn ipa_mod(a: Int) -> Int {
    let mut x: Int = a % 2147483647;
    if x < 0 {
        x = x + 2147483647;
    }
    return x;
}

fn ipa_dot(a: List[Int], b: List[Int]) -> Int {
    let n: Int = list_len(a);
    let mut s: Int = 0;
    let mut i: Int = 0;
    while i < n {
        s = ipa_mod(s + list_get(a, i) * list_get(b, i));
        i = i + 1;
    }
    return s;
}

fn ipa_pow(b: Int, e: Int) -> Int {
    let mut r: Int = 1;
    let mut p: Int = ipa_mod(b);
    let mut n: Int = e;
    while n > 0 {
        if (n & 1) == 1 {
            r = ipa_mod(r * p);
        }
        p = ipa_mod(p * p);
        n = n / 2;
    }
    return r;
}

pub fn bulletproofs_ipa_fold(a: List[Int], b: List[Int], x: Int) -> IpaOut {
    let n: Int = list_len(a);
    if n != list_len(b) {
        return ipa_err("len");
    }
    if n < 2 {
        return ipa_err("n");
    }
    if (n & 1) != 0 {
        return ipa_err("odd");
    }
    if x == 0 {
        return ipa_err("x");
    }
    let h: Int = n / 2;
    let mut al: List[Int] = list_new();
    let mut ar: List[Int] = list_new();
    let mut bl: List[Int] = list_new();
    let mut br: List[Int] = list_new();
    let mut i: Int = 0;
    while i < h {
        al = list_push(al, list_get(a, i));
        ar = list_push(ar, list_get(a, i + h));
        bl = list_push(bl, list_get(b, i));
        br = list_push(br, list_get(b, i + h));
        i = i + 1;
    }
    let lft: Int = ipa_dot(al, br);
    let rgt: Int = ipa_dot(ar, bl);
    let xi: Int = ipa_pow(x, 2147483645);
    let x2: Int = ipa_mod(x * x);
    let xi2: Int = ipa_mod(xi * xi);
    let mut ap: List[Int] = list_new();
    let mut bp: List[Int] = list_new();
    i = 0;
    while i < h {
        ap = list_push(ap, ipa_mod(x * list_get(al, i) + xi * list_get(ar, i)));
        bp = list_push(bp, ipa_mod(xi * list_get(bl, i) + x * list_get(br, i)));
        i = i + 1;
    }
    let lhs: Int = ipa_dot(ap, bp);
    let rhs: Int = ipa_mod(ipa_dot(a, b) + x2 * lft + xi2 * rgt);
    if lhs != rhs {
        return ipa_err("fold");
    }
    return IpaOut { flag: 1, err: "", ip: ipa_dot(a, b), folded: lhs, value: 0 };
}

pub fn bulletproofs_ipa_range64(v: Int, bits: List[Int]) -> IpaOut {
    if list_len(bits) != 64 {
        return ipa_err("bits");
    }
    if v < 0 {
        return ipa_err("neg");
    }
    let mut acc: Int = 0;
    let mut p2: Int = 1;
    let mut alg: Int = 0;
    let mut ones: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 64 {
        let b: Int = list_get(bits, i);
        if b != 0 {
            if b != 1 {
                return ipa_err("bit");
            }
        }
        alg = alg + b * (1 - b);
        ones = list_push(ones, 1 - b);
        acc = acc + b * p2;
        p2 = p2 * 2;
        i = i + 1;
    }
    if alg != 0 {
        return ipa_err("01");
    }
    if acc != v {
        return ipa_err("range");
    }
    let fd: IpaOut = bulletproofs_ipa_fold(bits, ones, 3);
    if fd.flag < 1 {
        return fd;
    }
    return IpaOut { flag: 1, err: "", ip: fd.ip, folded: fd.folded, value: v };
}

pub fn bulletproofs_ipa_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn bulletproofs_ipa_flag(o: IpaOut) -> Int {
    return o.flag;
}
pub fn bulletproofs_ipa_err(o: IpaOut) -> String {
    return o.err;
}
