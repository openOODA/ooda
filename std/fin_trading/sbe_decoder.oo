// # Simple Binary Encoding fixed-offset decoder
//
// Logline: Recovers little-endian fields from a fixed-offset SBE buffer.
//
// Setup: Pure. Bytes are List[Int] 0..255. Header is 8 bytes: block length, template id, schema, version.
//
// Beats:
//   1. Require an 8-byte header plus payload.
//   2. Read u16 and u32 at a caller offset.
//   3. Reject an offset that overruns the buffer.

pub type SbeOut = struct {
    flag: Int,
    err: String,
    tmpl: Int,
    block: Int,
    field: Int
};

fn sbe_err(m: String) -> SbeOut {
    return SbeOut { flag: 0, err: "ERR\tsbe: " + m, tmpl: 0, block: 0, field: 0 };
}

fn sbe_u16(buf: List[Int], o: Int) -> Int {
    return list_get(buf, o) + list_get(buf, o + 1) * 256;
}

fn sbe_u32(buf: List[Int], o: Int) -> Int {
    let lo: Int = sbe_u16(buf, o);
    let hi: Int = sbe_u16(buf, o + 2);
    return lo + hi * 65536;
}

pub fn sbe_decoder_parse(buf: List[Int], off: Int, width: Int) -> SbeOut {
    if list_len(buf) < 8 {
        return sbe_err("short");
    }
    if off < 8 {
        return sbe_err("off");
    }
    if width != 2 {
        if width != 4 {
            return sbe_err("width");
        }
    }
    if off + width > list_len(buf) {
        return sbe_err("over");
    }
    let block: Int = sbe_u16(buf, 0);
    let tmpl: Int = sbe_u16(buf, 2);
    let mut field: Int = 0;
    if width == 2 {
        field = sbe_u16(buf, off);
    } else {
        field = sbe_u32(buf, off);
    }
    return SbeOut { flag: 1, err: "", tmpl: tmpl, block: block, field: field };
}

pub fn sbe_decoder_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn sbe_decoder_flag(o: SbeOut) -> Int {
    return o.flag;
}
pub fn sbe_decoder_err(o: SbeOut) -> String {
    return o.err;
}
pub fn sbe_decoder_field(o: SbeOut) -> Int {
    return o.field;
}
