// # FIX 5.0 SP2 tag-value stream
//
// Logline: Lexes Tag=Value SOH fields and checks the body checksum modulo 256.
//
// Setup: Pure. SOH is byte 1. Checksum tag is 10. Truncated streams and bad checksums are Err.
//
// Beats:
//   1. Split fields on SOH.
//   2. Parse tag equals value.
//   3. Sum every byte before tag 10 modulo 256.
//   4. Compare with the checksum field.

pub type FixOut = struct {
    flag: Int,
    err: String,
    ntag: Int,
    chk: Int,
    body: Int
};

fn fx_err(m: String) -> FixOut {
    return FixOut { flag: 0, err: "ERR\tfix: " + m, ntag: 0, chk: 0, body: 0 };
}

pub fn fix_tag_streamer_parse(buf: List[Int]) -> FixOut {
    let n: Int = list_len(buf);
    if n < 3 {
        return fx_err("short");
    }
    let mut ntag: Int = 0;
    let mut i: Int = 0;
    let mut sum: Int = 0;
    let mut chk: Int = 0 - 1;
    let mut body: Int = 0;
    while i < n {
        let mut tag: Int = 0;
        let mut seen: Int = 0;
        while i < n {
            let b: Int = list_get(buf, i);
            if b == 61 {
                i = i + 1;
                seen = 1;
                break;
            }
            if b < 48 {
                return fx_err("tag");
            }
            if b > 57 {
                return fx_err("tag");
            }
            tag = tag * 10 + (b - 48);
            i = i + 1;
        }
        if seen < 1 {
            return fx_err("eq");
        }
        let mut val: Int = 0;
        let mut vn: Int = 0;
        while i < n {
            let b2: Int = list_get(buf, i);
            if b2 == 1 {
                i = i + 1;
                break;
            }
            if tag == 10 {
                if b2 >= 48 {
                    if b2 <= 57 {
                        val = val * 10 + (b2 - 48);
                        vn = 1;
                    }
                }
            }
            i = i + 1;
        }
        ntag = ntag + 1;
        if tag == 10 {
            chk = val;
        } else {
            body = body + 1;
        }
    }
    let mut j: Int = 0;
    while j < n {
        let b: Int = list_get(buf, j);
        if j + 3 < n {
            if list_get(buf, j) == 49 {
                if list_get(buf, j + 1) == 48 {
                    if list_get(buf, j + 2) == 61 {
                        break;
                    }
                }
            }
        }
        sum = (sum + (b & 255)) % 256;
        j = j + 1;
    }
    if chk < 0 {
        return fx_err("chk");
    }
    if chk != sum {
        return fx_err("checksum");
    }
    return FixOut { flag: 1, err: "", ntag: ntag, chk: chk, body: body };
}

pub fn fix_tag_streamer_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn fix_tag_streamer_flag(o: FixOut) -> Int {
    return o.flag;
}
pub fn fix_tag_streamer_err(o: FixOut) -> String {
    return o.err;
}
