// # Shape-check JSON text
//
// Logline: parse accepts a first JSON token and returns the raw string; stringify returns the same string.
//
// Setup: This module is pure: no FS, net, or env. parse refuses the empty string.
//
// Beats:
//   1. parse forwards a non-empty raw string to json_parse_internal.
//   2. stringify forwards to json_stringify_internal and yields the input.
//   3. verify parse checks a tiny object comes back Ok.
//
// residual: not a tree parser; no object query; stringify is identity

pub fn parse(raw: String) -> Result[String, String]
    requires raw.len() > 0
{
    return json_parse_internal(raw);
}

pub fn stringify(obj: String) -> String {
    return json_stringify_internal(obj);
}

verify parse {
    assert_eq!(parse("{\"status\":\"ok\"}"), Ok("{\"status\":\"ok\"}"));
}
