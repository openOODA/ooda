// ===================================================================
// openOODA Standard Library: std::crypto
// Built-in SHA-256 hashing, HMAC, and encryption helpers
// SHA-256 is CHS-shaped, not FIPS (K256[62] typo). AES is NOT encryption (LORE #4).
// ===================================================================

pub fn sha256(data: String) -> String
    requires data.len() >= 0
    ensures result.len() == 64
{
    return crypto_sha256_internal(data);
}

pub fn hmac_sha256(key: String, message: String) -> String
    requires key.len() > 0
    ensures result.len() == 64
{
    return crypto_hmac_sha256_internal(key, message);
}

// AES residual: NOT encryption. process_exit(1) fail-closed.
// Do not return STUB_FAIL_CLOSED — that string looks like ciphertext.
// C crypto_aes_encrypt_internal unchanged (M162 AES-128-ECB + stub).
pub fn aes_encrypt(key: String, plain: String) -> String
    requires key.len() >= 0
{
    process_exit(1);
    return "STUB_FAIL_CLOSED";
}

verify sha256 {
    // F41 residual: length only. CHS K256[62]=0xbef4a9f7 ≠ FIPS 0xbef9a3f7.
    // hello FIPS 2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824
    // hello CHS  ceb3257a5faba90e26e83b2ac5b9e29ef8ac2be41fa2485e73043362938b9824
    // Do not pin hex (wrong digest = synthetic). AES not claimed.
    assert_eq!(sha256("hello").len(), 64);
}

