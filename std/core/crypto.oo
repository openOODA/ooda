// # CHS SHA-256, HMAC, and AES-128
//
// Logline: sha256 and hmac_sha256 return 64 hex chars; aes_encrypt returns AES-128-ECB hex.
//
// Setup: crypto_*_internal are CHS builtins. This file is the sole product sha256 (F38b).
//
// Beats:
//   1. sha256 hashes any string to 64 hex chars via crypto_sha256_internal.
//   2. hmac_sha256 does the same keyed via crypto_hmac_sha256_internal.
//   3. aes_encrypt encrypts 16-byte blocks and returns lowercase hex ciphertext.
//
// residual: AES-128-ECB only. Other modes, padding, and IV stay residual. hash/sha256.oo is not a second hash.

pub fn sha256(data: String) -> String {
    return crypto_sha256_internal(data);
}

pub fn hmac_sha256(key: String, message: String) -> String {
    return crypto_hmac_sha256_internal(key, message);
}

pub fn aes_encrypt(key: String, plain: String) -> String {
    return crypto_aes_encrypt_internal(key, plain);
}

verify sha256 {
    assert_eq!(sha256("hello").len(), 64);
}
