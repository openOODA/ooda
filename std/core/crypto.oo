// ===================================================================
// openOODA Standard Library: std::crypto
// Built-in SHA-256 hashing, HMAC, and encryption helpers
// Path A: real SHA-256/HMAC; AES residual fail-closed (STUB_FAIL_CLOSED)
// ===================================================================

pub fn sha256(data: String) -> String
    requires data.len() >= 0
    ensures result.len() == 64
{
    return crypto_sha256_internal(data);
}

pub fn hmac_sha256(key: String, message: String) -> String
    requires key.len() > 0
    ensures result.len() == 64
{
    return crypto_hmac_sha256_internal(key, message);
}

// AES residual: does not encrypt; returns STUB_FAIL_CLOSED string.
pub fn aes_encrypt(key: String, plain: String) -> String
    requires key.len() >= 0
{
    return crypto_aes_encrypt_internal(key, plain);
}

verify sha256 {
    assert_eq!(sha256("hello").len(), 64);
}

