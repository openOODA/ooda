// # String Result
//
// Logline: Pure helpers construct, test, unwrap, and remap a Result of two Strings without panicking.
//
// Setup: Backend-C lowers Result[String, String] as OoResS. This module is pure: no FS, net, or env.
//
// Beats:
//   1. res_ok and res_err construct the two arms.
//   2. res_is_ok and res_is_err name the live arm.
//   3. res_unwrap_or yields the Ok payload or a default; res_map_err replaces the Err message.
//
// residual: this file is String Result; Bool/Float/List/Void/Name Result[T, String] emit is product on oodac/oodac

// Construct Ok payload.
pub fn res_ok(v: String) -> Result[String, String] {
    return Ok(v);
}

// Construct Err payload.
pub fn res_err(msg: String) -> Result[String, String] {
    return Err(msg);
}

// True when Ok.
pub fn res_is_ok(r: Result[String, String]) -> Bool {
    return r.is_ok();
}

// True when Err.
pub fn res_is_err(r: Result[String, String]) -> Bool {
    return r.is_err();
}

// Ok payload or default (never panics).
pub fn res_unwrap_or(r: Result[String, String], d: String) -> String {
    if r.is_ok() {
        let v = match r {
            Ok(x) => x,
            Err(y) => y,
        };
        return v;
    }
    return d;
}

// Replace Err message; Ok payload unchanged.
pub fn res_map_err(r: Result[String, String], msg: String) -> Result[String, String] {
    if r.is_ok() {
        let v = match r {
            Ok(x) => x,
            Err(y) => y,
        };
        return Ok(v);
    }
    return Err(msg);
}
