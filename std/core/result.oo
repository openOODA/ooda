// package: std — pure path Result[String, String] helpers
// job: thin wrappers over Ok/Err/is_ok/is_err (Backend-C OoResS)
// caps: none (no FS/net/env)
// residual: only String payload; generic Result[T,E] not lowered

// Construct Ok payload.
pub fn res_ok(v: String) -> Result[String, String] {
    return Ok(v);
}

// Construct Err payload.
pub fn res_err(msg: String) -> Result[String, String] {
    return Err(msg);
}

// True when Ok.
pub fn res_is_ok(r: Result[String, String]) -> Bool {
    return r.is_ok();
}

// True when Err.
pub fn res_is_err(r: Result[String, String]) -> Bool {
    return r.is_err();
}

// Ok payload or default (never panics).
pub fn res_unwrap_or(r: Result[String, String], d: String) -> String {
    if r.is_ok() {
        let v = match r {
            Ok(x) => x,
            Err(y) => y,
        };
        return v;
    }
    return d;
}

// Replace Err message; Ok payload unchanged.
pub fn res_map_err(r: Result[String, String], msg: String) -> Result[String, String] {
    if r.is_ok() {
        let v = match r {
            Ok(x) => x,
            Err(y) => y,
        };
        return Ok(v);
    }
    return Err(msg);
}
