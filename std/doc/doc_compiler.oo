// # Static Documentation Compiler
//
// Logline: Extract module documentation headers, declarations, and generate structured HTML, Markdown, and JSON reference manuals.
//
// Setup: Parses pure .oo source files to produce static API documentation without runtime reflection overhead.
//
// Beats:
//   1. Parse 4-element Academy headers (Title, Logline, Setup, Beats) from source modules.
//   2. Extract public function signatures, parameter types, and return types.
//   3. Render structured HTML and Markdown documentation pages.
//   4. Generate API catalog indexes for developer documentation portals.

pub type DocCompilerItem = struct {
    name: String,
    signature: String,
    doc_comment: String,
    is_public: Bool
};

pub type DocCompilerModule = struct {
    title: String,
    logline: String,
    setup_text: String,
    beats_count: Int,
    functions_count: Int
};

pub fn doc_compiler_item_new(name: String, sig: String, doc: String, is_pub: Bool) -> DocCompilerItem { return DocCompilerItem {
        name: name,
        signature: sig,
        doc_comment: doc,
        is_public: is_pub
    }; }

pub fn doc_compiler_module_new(title: String, logline: String, setup: String, beats: Int, fns: Int) -> DocCompilerModule { return DocCompilerModule {
        title: title,
        logline: logline,
        setup_text: setup,
        beats_count: beats,
        functions_count: fns
    }; }

pub fn doc_compiler_render_markdown(doc: DocCompilerModule) -> String {
    let title: String = doc.title;
    let logline: String = doc.logline;
    let setup: String = doc.setup_text;
    let fns: Int = doc.functions_count;
    let fns_str: String = fns.to_string();

    let mut out: String = "# ";
    out = out + title;
    out = out + "\n\n**Logline**: ";
    out = out + logline;
    out = out + "\n\n## Setup\n";
    out = out + setup;
    out = out + "\n\n## Functions\nTotal public functions: ";
    out = out + fns_str;
    out = out + "\n";
    return out;
}

pub fn doc_compiler_render_html(doc: DocCompilerModule) -> String {
    let title: String = doc.title;
    let logline: String = doc.logline;
    let setup: String = doc.setup_text;

    let mut out: String = "<article class=\"module-doc\">\n";
    out = out + "  <h1>";
    out = out + title;
    out = out + "</h1>\n  <p class=\"logline\">";
    out = out + logline;
    out = out + "</p>\n  <section class=\"setup\">";
    out = out + setup;
    out = out + "</section>\n</article>\n";
    return out;
}
