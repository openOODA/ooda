// # OODAX Capability-Gated System Call Subsystem
//
// Logline: Dispatches system calls, verifies capability tokens, and enforces isolation boundaries.
//
// Setup: Trap and dispatch interface for microkernel domains and user-space service threads.
//
// Beats:
//   1. Define system call numbers and SyscallArgs structure.
//   2. Define SyscallReturn structure for register-based return values.
//   3. Implement system call routing for IPC, capabilities, and scheduler control.
//   4. Validate caller domain permissions and capability validity.
// RULES.oot 1.4: Strict capability authorization for syscall traps.
// RULES.oot 1.7: Strictly under 256 lines.

import "oodax/cap_table.oo";
import "oodax/ipc.oo";

pub fn sys_ipc_call() -> Int { return 1; }
pub fn sys_ipc_reply_recv() -> Int { return 2; }
pub fn sys_sched_yield() -> Int { return 3; }
pub fn sys_cap_mint() -> Int { return 4; }
pub fn sys_cap_revoke() -> Int { return 5; }

pub type SyscallArgs = struct {
    caller_tid: Int,
    caller_domain: Int,
    sys_num: Int,
    arg0: Int,
    arg1: Int,
    arg2: Int,
    payload: String
};

pub type SyscallReturn = struct {
    status: Int,
    ret_val: Int,
    ret_payload: String,
    success: Bool
};

pub fn syscall_args_new(tid: Int, domain: Int, num: Int, a0: Int, a1: Int, a2: Int, payload: String) -> SyscallArgs {
    return SyscallArgs {
        caller_tid: tid,
        caller_domain: domain,
        sys_num: num,
        arg0: a0,
        arg1: a1,
        arg2: a2,
        payload: payload
    };
}

pub fn sys_ret_ok(val: Int, payload: String) -> SyscallReturn {
    return SyscallReturn {
        status: 0,
        ret_val: val,
        ret_payload: payload,
        success: true
    };
}

pub fn sys_ret_err(status_code: Int, err_msg: String) -> SyscallReturn {
    return SyscallReturn {
        status: status_code,
        ret_val: -1,
        ret_payload: err_msg,
        success: false
    };
}

pub fn syscall_dispatch(args: SyscallArgs, table: CapTable) -> SyscallReturn {
    let num: Int = args.sys_num;
    if num == sys_sched_yield() {
        return sys_ret_ok(0, "YIELD_OK");
    }
    if num == sys_cap_mint() {
        let src_cptr: Int = args.arg0;
        let dest_cptr: Int = args.arg1;
        let new_rights: Int = args.arg2;
        let mint_res: Result[CapTable, String] = cap_mint(table, src_cptr, dest_cptr, new_rights, 100);
        match mint_res {
            Ok(t) => { return sys_ret_ok(dest_cptr, "MINT_OK"); },
            Err(e) => { return sys_ret_err(13, e); }
        }
    }
    if num == sys_cap_revoke() {
        let target_cptr: Int = args.arg0;
        let entry: CapEntry = cap_table_get(table, target_cptr);
        let val_ok: Bool = cap_entry_is_valid(entry);
        if !val_ok {
            return sys_ret_err(2, "Invalid capability pointer");
        }
        return sys_ret_ok(0, "REVOKE_OK");
    }
    if num == sys_ipc_call() {
        let ep_cptr: Int = args.arg0;
        let ep_entry: CapEntry = cap_table_get(table, ep_cptr);
        let val_ok: Bool = cap_entry_is_valid(ep_entry);
        if !val_ok {
            return sys_ret_err(2, "Invalid endpoint capability pointer");
        }
        let can_call: Bool = cap_has_rights(ep_entry, cap_right_call());
        if !can_call {
            return sys_ret_err(13, "Capability lacks CALL rights");
        }
        return sys_ret_ok(0, "IPC_CALL_DISPATCHED");
    }
    return sys_ret_err(38, "Unknown syscall number");
}
