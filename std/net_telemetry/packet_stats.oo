// # Network Bandwidth and Packet Telemetry Metrics
//
// Logline: Tracks packets-per-second, bandwidth throughput, protocol distributions, and drop counters.
//
// Setup: Pure network metrics engine with capability-gated TimeCap sampling.
//
// Beats:
//   1. Define PacketStatsCounter and ProtocolBreakdown structures.
//   2. Record packet byte sizes, protocols, and dropped packets.
//   3. Compute packet rates and bandwidth throughput under &TimeCap.

pub type ProtocolBreakdown = struct {
    tcp_packets: Int,
    udp_packets: Int,
    icmp_packets: Int,
    other_packets: Int
};

pub type PacketStatsCounter = struct {
    interface_name: String,
    total_packets: Int,
    total_bytes: Int,
    dropped_packets: Int,
    breakdown: ProtocolBreakdown,
    last_sample_time: Int
};

pub fn packet_stats_new(iface: String, start_time: Int) -> PacketStatsCounter {
    let bd: ProtocolBreakdown = ProtocolBreakdown {
        tcp_packets: 0,
        udp_packets: 0,
        icmp_packets: 0,
        other_packets: 0
    };
    return PacketStatsCounter {
        interface_name: iface,
        total_packets: 0,
        total_bytes: 0,
        dropped_packets: 0,
        breakdown: bd,
        last_sample_time: start_time
    };
}

pub fn packet_stats_record(
    stats: &mut PacketStatsCounter,
    proto: Int,
    byte_count: Int,
    is_dropped: Bool
) {
    stats.total_packets = stats.total_packets + 1;
    stats.total_bytes = stats.total_bytes + byte_count;

    if is_dropped {
        stats.dropped_packets = stats.dropped_packets + 1;
    }

    if proto == 6 {
        stats.breakdown.tcp_packets = stats.breakdown.tcp_packets + 1;
    } else if proto == 17 {
        stats.breakdown.udp_packets = stats.breakdown.udp_packets + 1;
    } else if proto == 1 {
        stats.breakdown.icmp_packets = stats.breakdown.icmp_packets + 1;
    } else {
        stats.breakdown.other_packets = stats.breakdown.other_packets + 1;
    }
}

pub fn packet_stats_calc_pps(
    time_cap: &TimeCap,
    stats: &PacketStatsCounter,
    current_time: Int
) -> Int {
    let elapsed: Int = current_time - (stats).last_sample_time;
    if elapsed <= 0 {
        return 0;
    }
    return ((stats).total_packets * 1000) / elapsed;
}

pub fn packet_stats_calc_bps(
    time_cap: &TimeCap,
    stats: &PacketStatsCounter,
    current_time: Int
) -> Int {
    let elapsed: Int = current_time - (stats).last_sample_time;
    if elapsed <= 0 {
        return 0;
    }
    return ((stats).total_bytes * 8000) / elapsed;
}
