// # Defensive Firewall Rules and Access Control Lists
//
// Logline: Evaluates priority-ordered Access Control Lists (ACLs) for inbound and outbound traffic filtering.
//
// Setup: Pure network policy engine enforcing defensive packet drop and accept rules.
//
// Beats:
//   1. Define FirewallRule and FirewallTable structures.
//   2. Add prioritized rules with protocol, source/destination IP, port, and direction criteria.
//   3. Evaluate packets against active rules to return ACCEPT, DROP, or REJECT decisions.

pub type FirewallRule = struct {
    rule_id: Int,
    priority: Int,
    is_inbound: Bool,
    protocol: Int,        // 0=Any, 6=TCP, 17=UDP, 1=ICMP
    src_ip_prefix: String,
    dst_ip_prefix: String,
    dst_port: Int,
    action: Int,          // 0=Accept, 1=Drop, 2=Reject
    is_enabled: Bool,
};

pub type FirewallTable = struct {
    table_name: String,
    default_policy: Int,  // 0=Accept, 1=Drop
    rules: List[FirewallRule],
    total_evaluated: Int,
    total_dropped: Int,
};

pub fn firewall_rule_new(
    id: Int,
    priority: Int,
    is_inbound: Bool,
    proto: Int,
    src_prefix: String,
    dst_prefix: String,
    dst_port: Int,
    action: Int
) -> FirewallRule {
    return FirewallRule {
        rule_id: id,
        priority: priority,
        is_inbound: is_inbound,
        protocol: proto,
        src_ip_prefix: src_prefix,
        dst_ip_prefix: dst_prefix,
        dst_port: dst_port,
        action: action,
        is_enabled: true,
    };
}

pub fn firewall_table_new(name: String, default_drop: Bool) -> FirewallTable {
    let empty_rules: List[FirewallRule] = list_new();
    let def_pol: Int = if default_drop { 1 } else { 0 };
    return FirewallTable {
        table_name: name,
        default_policy: def_pol,
        rules: empty_rules,
        total_evaluated: 0,
        total_dropped: 0,
    };
}

pub fn firewall_table_add_rule(table: &mut FirewallTable, rule: FirewallRule) {
    table.rules = list_push(table.rules, rule);
}

pub fn firewall_evaluate_packet(
    table: &mut FirewallTable,
    is_inbound: Bool,
    proto: Int,
    src_ip: String,
    dst_ip: String,
    dst_port: Int
) -> Int {
    table.total_evaluated = table.total_evaluated + 1;
    let n: Int = list_len(table.rules);
    let mut i: Int = 0;

    while i < n {
        let r: FirewallRule = list_get(table.rules, i);
        if r.is_enabled {
            if r.is_inbound == is_inbound {
                if (r.protocol == 0) || (r.protocol == proto) {
                    if (r.dst_port == 0) || (r.dst_port == dst_port) {
                        let act: Int = r.action;
                        if (act == 1) || (act == 2) {
                            table.total_dropped = table.total_dropped + 1;
                        }
                        return act;
                    }
                }
            }
        }
        i = i + 1;
    }

    if table.default_policy == 1 {
        table.total_dropped = table.total_dropped + 1;
    }
    return table.default_policy;
}
