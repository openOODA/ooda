// # TCP Segment Header and Flag Decoder
//
// Logline: Decodes RFC 793 TCP segment headers, unpacks control flags, sequence numbers, and calculates payload offsets.
//
// Setup: Pure network layer 4 TCP protocol parser and state flag extractor.
//
// Beats:
//   1. Define TcpFlags and TcpSegment structures.
//   2. Parse 20-byte TCP header with port numbers, sequence/acknowledgment numbers, and window sizes.
//   3. Extract control flags (SYN, ACK, FIN, RST, PSH, URG) and compute header length.

pub type TcpFlags = struct {
    fin: Bool,
    syn: Bool,
    rst: Bool,
    psh: Bool,
    ack: Bool,
    urg: Bool,
    ece: Bool,
    cwr: Bool
};

pub type TcpSegment = struct {
    src_port: Int,
    dst_port: Int,
    seq_number: Int,
    ack_number: Int,
    data_offset: Int,
    flags: TcpFlags,
    window_size: Int,
    checksum: Int,
    urgent_pointer: Int,
    header_bytes: Int,
    is_valid: Bool
};

pub fn tcp_flags_new(
    fin: Bool, syn: Bool, rst: Bool, psh: Bool,
    ack: Bool, urg: Bool, ece: Bool, cwr: Bool
) -> TcpFlags {
    return TcpFlags {
        fin: fin,
        syn: syn,
        rst: rst,
        psh: psh,
        ack: ack,
        urg: urg,
        ece: ece,
        cwr: cwr
    };
}

pub fn tcp_flags_is_syn_only(f: &TcpFlags) -> Bool {
    return (f).syn && !((f).ack) && !((f).rst) && !((f).fin);
}

pub fn tcp_flags_is_syn_ack(f: &TcpFlags) -> Bool {
    return (f).syn && (f).ack && !((f).rst);
}

pub fn tcp_segment_parse(bytes: List[Int], offset: Int) -> TcpSegment {
    let len: Int = list_len(bytes);
    let empty_flags: TcpFlags = tcp_flags_new(false, false, false, false, false, false, false, false);

    if (offset + 20) > len {
        return TcpSegment {
            src_port: 0,
            dst_port: 0,
            seq_number: 0,
            ack_number: 0,
            data_offset: 0,
            flags: empty_flags,
            window_size: 0,
            checksum: 0,
            urgent_pointer: 0,
            header_bytes: 0,
            is_valid: false
        };
    }

    let src_p: Int = (list_get(bytes, offset) * 256) + list_get(bytes, offset + 1);
    let dst_p: Int = (list_get(bytes, offset + 2) * 256) + list_get(bytes, offset + 3);

    let seq: Int = (list_get(bytes, offset + 4) * 16777216) +
                   (list_get(bytes, offset + 5) * 65536) +
                   (list_get(bytes, offset + 6) * 256) +
                   list_get(bytes, offset + 7);

    let ack: Int = (list_get(bytes, offset + 8) * 16777216) +
                   (list_get(bytes, offset + 9) * 65536) +
                   (list_get(bytes, offset + 10) * 256) +
                   list_get(bytes, offset + 11);

    let b12: Int = list_get(bytes, offset + 12);
    let doff: Int = b12 / 16;
    let b13: Int = list_get(bytes, offset + 13);

    let cwr: Bool = (b13 / 128) % 2 == 1;
    let ece: Bool = (b13 / 64) % 2 == 1;
    let urg: Bool = (b13 / 32) % 2 == 1;
    let ack_f: Bool = (b13 / 16) % 2 == 1;
    let psh: Bool = (b13 / 8) % 2 == 1;
    let rst: Bool = (b13 / 4) % 2 == 1;
    let syn: Bool = (b13 / 2) % 2 == 1;
    let fin: Bool = (b13 % 2) == 1;

    let flags: TcpFlags = tcp_flags_new(fin, syn, rst, psh, ack_f, urg, ece, cwr);
    let win: Int = (list_get(bytes, offset + 14) * 256) + list_get(bytes, offset + 15);
    let csum: Int = (list_get(bytes, offset + 16) * 256) + list_get(bytes, offset + 17);
    let urg_ptr: Int = (list_get(bytes, offset + 18) * 256) + list_get(bytes, offset + 19);

    let hdr_len: Int = doff * 4;
    let valid: Bool = doff >= 5;

    return TcpSegment {
        src_port: src_p,
        dst_port: dst_p,
        seq_number: seq,
        ack_number: ack,
        data_offset: doff,
        flags: flags,
        window_size: win,
        checksum: csum,
        urgent_pointer: urg_ptr,
        header_bytes: hdr_len,
        is_valid: valid
    };
}
