// # UDP Datagram Parser
//
// Logline: Decodes RFC 768 UDP datagram headers, extracts source/destination ports, lengths, and payload spans.
//
// Setup: Pure network layer 4 UDP protocol parser and datagram validator.
//
// Beats:
//   1. Define UdpDatagram structure and port constants.
//   2. Parse 8-byte UDP headers from byte streams.
//   3. Compute payload byte offsets and validate minimum datagram length.

pub type UdpDatagram = struct {
    src_port: Int,
    dst_port: Int,
    length: Int,
    checksum: Int,
    payload_len: Int,
    is_valid: Bool
};

pub fn udp_datagram_new(
    src_port: Int,
    dst_port: Int,
    length: Int,
    checksum: Int
) -> UdpDatagram {
    let p_len: Int = if length >= 8 { length - 8 } else { 0 };
    let valid: Bool = length >= 8;
    return UdpDatagram {
        src_port: src_port,
        dst_port: dst_port,
        length: length,
        checksum: checksum,
        payload_len: p_len,
        is_valid: valid
    };
}

pub fn udp_parse_header(bytes: List[Int], offset: Int) -> UdpDatagram {
    let len: Int = list_len(bytes);
    if (offset + 8) > len {
        return UdpDatagram {
            src_port: 0,
            dst_port: 0,
            length: 0,
            checksum: 0,
            payload_len: 0,
            is_valid: false
        };
    }

    let src_p: Int = (list_get(bytes, offset) * 256) + list_get(bytes, offset + 1);
    let dst_p: Int = (list_get(bytes, offset + 2) * 256) + list_get(bytes, offset + 3);
    let d_len: Int = (list_get(bytes, offset + 4) * 256) + list_get(bytes, offset + 5);
    let csum: Int = (list_get(bytes, offset + 6) * 256) + list_get(bytes, offset + 7);

    return udp_datagram_new(src_p, dst_p, d_len, csum);
}

pub fn udp_is_dns(d: &UdpDatagram) -> Bool {
    return ((d).src_port == 53) || ((d).dst_port == 53);
}

pub fn udp_is_dhcp(d: &UdpDatagram) -> Bool {
    return ((d).src_port == 67) || ((d).dst_port == 67) ||
           ((d).src_port == 68) || ((d).dst_port == 68);
}

pub fn udp_is_ntp(d: &UdpDatagram) -> Bool {
    return ((d).src_port == 123) || ((d).dst_port == 123);
}
