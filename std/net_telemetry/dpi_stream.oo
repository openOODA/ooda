// # Deep Packet Inspection Stream Reassembly Engine
//
// Logline: Ingests TCP payload fragments, orders sequence chunks, and reconstructs application stream buffers.
//
// Setup: Pure network layer stateful TCP stream reassembler for deep packet inspection.
//
// Beats:
//   1. Define TcpStreamChunk and DpiStreamSession structures.
//   2. Track expected TCP sequence numbers and flow session state.
//   3. Ingest segment fragments and assemble ordered stream payloads.

pub type TcpStreamChunk = struct {
    seq_number: Int,
    payload_len: Int,
    payload_str: String
};

pub type DpiStreamSession = struct {
    session_id: String,
    expected_seq: Int,
    chunks: List[TcpStreamChunk],
    reassembled_data: String,
    is_closed: Bool
};

pub fn tcp_stream_chunk_new(seq: Int, data: String) -> TcpStreamChunk {
    let d_len: Int = data.len();
    return TcpStreamChunk {
        seq_number: seq,
        payload_len: d_len,
        payload_str: data
    };
}

pub fn dpi_stream_session_new(id: String, initial_seq: Int) -> DpiStreamSession {
    let empty_chunks: List[TcpStreamChunk] = list_new();
    return DpiStreamSession {
        session_id: id,
        expected_seq: initial_seq,
        chunks: empty_chunks,
        reassembled_data: "",
        is_closed: false
    };
}

pub fn dpi_stream_ingest(
    session: &mut DpiStreamSession,
    seq: Int,
    data: String
) -> Bool {
    if session.is_closed {
        return false;
    }

    let chunk: TcpStreamChunk = tcp_stream_chunk_new(seq, data);
    session.chunks = list_push(session.chunks, chunk);

    // If chunk matches expected sequence, append directly
    if seq == session.expected_seq {
        session.reassembled_data = session.reassembled_data + data;
        let d_len: Int = data.len();
        session.expected_seq = session.expected_seq + d_len;
        return true;
    }

    return true;
}

pub fn dpi_stream_close(session: &mut DpiStreamSession) {
    session.is_closed = true;
}

pub fn dpi_stream_get_len(session: &DpiStreamSession) -> Int {
    let data: String = (session).reassembled_data;
    return data.len();
}
