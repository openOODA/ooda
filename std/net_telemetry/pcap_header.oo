// # PCAP Global Header Parser
//
// Logline: Decodes and validates standard libpcap global headers, magic numbers, link types, and capture limits.
//
// Setup: Pure binary header parser for PCAP container validation.
//
// Beats:
//   1. Define PcapGlobalHeader structure and PCAP magic constants.
//   2. Parse 24-byte libpcap global file headers.
//   3. Validate endianness, version compatibility, and link layer type.

pub type PcapGlobalHeader = struct {
    magic_number: Int,
    version_major: Int,
    version_minor: Int,
    thiszone: Int,
    sigfigs: Int,
    snaplen: Int,
    network: Int,
    is_little_endian: Bool,
    is_nanosecond: Bool,
    is_valid: Bool,
};

pub fn pcap_header_default() -> PcapGlobalHeader {
    return PcapGlobalHeader {
        magic_number: 2712847316, // 0xa1b2c3d4 standard microsecond
        version_major: 2,
        version_minor: 4,
        thiszone: 0,
        sigfigs: 0,
        snaplen: 65535,
        network: 1, // DLT_EN10MB (Ethernet)
        is_little_endian: true,
        is_nanosecond: false,
        is_valid: true,
    };
}

pub fn pcap_header_parse(
    magic: Int,
    v_major: Int,
    v_minor: Int,
    tz: Int,
    sigfigs: Int,
    snaplen: Int,
    network: Int
) -> PcapGlobalHeader {
    let mut is_le: Bool = true;
    let mut is_nano: Bool = false;
    let mut valid: Bool = true;

    // Standard PCAP Magic: 0xA1B2C3D4 (2712847316)
    // Swapped PCAP Magic:  0xD4C3B2A1 (3569595041)
    // Nanosecond PCAP:     0xA1B23C4D (2712812621)
    // Swapped Nanosecond:  0x4D3CB2A1 (1295823521)
    if magic == 2712847316 {
        is_le = false;
        is_nano = false;
    } else if magic == 3569595041 {
        is_le = true;
        is_nano = false;
    } else if magic == 2712812621 {
        is_le = false;
        is_nano = true;
    } else if magic == 1295823521 {
        is_le = true;
        is_nano = true;
    } else {
        valid = false;
    }

    if v_major != 2 {
        valid = false;
    }
    if v_minor != 4 {
        valid = false;
    }
    if snaplen <= 0 {
        valid = false;
    }

    return PcapGlobalHeader {
        magic_number: magic,
        version_major: v_major,
        version_minor: v_minor,
        thiszone: tz,
        sigfigs: sigfigs,
        snaplen: snaplen,
        network: network,
        is_little_endian: is_le,
        is_nanosecond: is_nano,
        is_valid: valid,
    };
}

pub fn pcap_header_is_ethernet(header: &PcapGlobalHeader) -> Bool {
    return header.network == 1;
}

pub fn pcap_header_is_raw_ip(header: &PcapGlobalHeader) -> Bool {
    return (header.network == 101) || (header.network == 12);
}
