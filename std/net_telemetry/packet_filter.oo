// # Defensive BPF-Style Packet Classification
//
// Logline: Evaluates defensive packet filtering rules against protocol numbers, port ranges, and IP addresses.
//
// Setup: Pure network packet classification engine executing deterministic rule matching.
//
// Beats:
//   1. Define FilterRule and PacketFilterEngine structures.
//   2. Match packets against L3 protocol, source/destination ports, and IP addresses.
//   3. Dispatch Pass, Drop, or Inspect actions across active filter chains.

pub type FilterRule = struct {
    rule_id: Int,
    protocol: Int,    // 0=Any, 6=TCP, 17=UDP, 1=ICMP
    src_port_min: Int,
    src_port_max: Int,
    dst_port_min: Int,
    dst_port_max: Int,
    action: Int,      // 0=Pass, 1=Drop, 2=Inspect
    is_active: Bool
};

pub type PacketFilterEngine = struct {
    engine_id: String,
    rules: List[FilterRule],
    total_evaluated: Int,
    total_passed: Int,
    total_dropped: Int
};

pub fn filter_rule_new(
    rule_id: Int,
    proto: Int,
    src_min: Int,
    src_max: Int,
    dst_min: Int,
    dst_max: Int,
    action: Int
) -> FilterRule {
    return FilterRule {
        rule_id: rule_id,
        protocol: proto,
        src_port_min: src_min,
        src_port_max: src_max,
        dst_port_min: dst_min,
        dst_port_max: dst_max,
        action: action,
        is_active: true
    };
}

pub fn packet_filter_engine_new(id: String) -> PacketFilterEngine {
    let empty_rules: List[FilterRule] = list_new();
    return PacketFilterEngine {
        engine_id: id,
        rules: empty_rules,
        total_evaluated: 0,
        total_passed: 0,
        total_dropped: 0
    };
}

pub fn filter_rule_matches(
    rule: &FilterRule,
    proto: Int,
    src_port: Int,
    dst_port: Int
) -> Bool {
    if !((rule).is_active) {
        return false;
    }
    if ((rule).protocol != 0) && ((rule).protocol != proto) {
        return false;
    }
    if ((rule).src_port_min > 0) && (src_port < (rule).src_port_min) {
        return false;
    }
    if ((rule).src_port_max > 0) && (src_port > (rule).src_port_max) {
        return false;
    }
    if ((rule).dst_port_min > 0) && (dst_port < (rule).dst_port_min) {
        return false;
    }
    if ((rule).dst_port_max > 0) && (dst_port > (rule).dst_port_max) {
        return false;
    }
    return true;
}

pub fn packet_filter_evaluate(
    engine: &mut PacketFilterEngine,
    proto: Int,
    src_port: Int,
    dst_port: Int
) -> Int {
    engine.total_evaluated = engine.total_evaluated + 1;
    let n: Int = list_len(engine.rules);
    let mut i: Int = 0;
    while i < n {
        let r: FilterRule = list_get(engine.rules, i);
        if filter_rule_matches(&r, proto, src_port, dst_port) {
            let act: Int = r.action;
            if act == 1 {
                engine.total_dropped = engine.total_dropped + 1;
            } else {
                engine.total_passed = engine.total_passed + 1;
            }
            return act;
        }
        i = i + 1;
    }
    // Default pass
    engine.total_passed = engine.total_passed + 1;
    return 0; // 0=Pass
}
