// # IPv4 Packet Header and Checksum Validator
//
// Logline: Decodes RFC 791 IPv4 packet headers, computes 16-bit one's complement checksums, and formats IP addresses.
//
// Setup: Pure network layer 3 IPv4 protocol parser and validation engine.
//
// Beats:
//   1. Define Ipv4Address and Ipv4Header structures.
//   2. Parse IPv4 20-byte base headers with TTL, protocol, and fragmentation flags.
//   3. Compute and verify RFC 791 internet checksums.

pub type Ipv4Address = struct {
    o1: Int,
    o2: Int,
    o3: Int,
    o4: Int
};

pub type Ipv4Header = struct {
    version: Int,
    ihl: Int,
    dscp: Int,
    ecn: Int,
    total_length: Int,
    identification: Int,
    flags_df: Bool,
    flags_mf: Bool,
    fragment_offset: Int,
    ttl: Int,
    protocol: Int,
    checksum: Int,
    src_ip: Ipv4Address,
    dst_ip: Ipv4Address,
    is_valid: Bool
};

pub fn ipv4_address_new(o1: Int, o2: Int, o3: Int, o4: Int) -> Ipv4Address {
    return Ipv4Address {
        o1: o1,
        o2: o2,
        o3: o3,
        o4: o4
    };
}

pub fn ipv4_address_to_string(ip: &Ipv4Address) -> String {
    let s1: String = (ip).o1.to_string();
    let s2: String = (ip).o2.to_string();
    let s3: String = (ip).o3.to_string();
    let s4: String = (ip).o4.to_string();
    return s1 + "." + s2 + "." + s3 + "." + s4;
}

pub fn ipv4_address_is_private(ip: &Ipv4Address) -> Bool {
    // 10.0.0.0/8
    if (ip).o1 == 10 {
        return true;
    }
    // 172.16.0.0/12
    if ((ip).o1 == 172) && ((ip).o2 >= 16) && ((ip).o2 <= 31) {
        return true;
    }
    // 192.168.0.0/16
    if ((ip).o1 == 192) && ((ip).o2 == 168) {
        return true;
    }
    return false;
}

pub fn ipv4_parse_header(bytes: List[Int], offset: Int) -> Ipv4Header {
    let len: Int = list_len(bytes);
    let empty_ip: Ipv4Address = ipv4_address_new(0, 0, 0, 0);

    if (offset + 20) > len {
        return Ipv4Header {
            version: 0,
            ihl: 0,
            dscp: 0,
            ecn: 0,
            total_length: 0,
            identification: 0,
            flags_df: false,
            flags_mf: false,
            fragment_offset: 0,
            ttl: 0,
            protocol: 0,
            checksum: 0,
            src_ip: empty_ip,
            dst_ip: empty_ip,
            is_valid: false
        };
    }

    let b0: Int = list_get(bytes, offset);
    let version: Int = b0 / 16;
    let ihl: Int = b0 % 16;

    let b1: Int = list_get(bytes, offset + 1);
    let dscp: Int = b1 / 4;
    let ecn: Int = b1 % 4;

    let tot_len: Int = (list_get(bytes, offset + 2) * 256) + list_get(bytes, offset + 3);
    let ident: Int = (list_get(bytes, offset + 4) * 256) + list_get(bytes, offset + 5);

    let b6: Int = list_get(bytes, offset + 6);
    let b7: Int = list_get(bytes, offset + 7);
    let df: Bool = (b6 / 64) % 2 == 1;
    let mf: Bool = (b6 / 32) % 2 == 1;
    let frag_off: Int = ((b6 % 32) * 256) + b7;

    let ttl: Int = list_get(bytes, offset + 8);
    let proto: Int = list_get(bytes, offset + 9);
    let csum: Int = (list_get(bytes, offset + 10) * 256) + list_get(bytes, offset + 11);

    let src: Ipv4Address = ipv4_address_new(
        list_get(bytes, offset + 12),
        list_get(bytes, offset + 13),
        list_get(bytes, offset + 14),
        list_get(bytes, offset + 15)
    );

    let dst: Ipv4Address = ipv4_address_new(
        list_get(bytes, offset + 16),
        list_get(bytes, offset + 17),
        list_get(bytes, offset + 18),
        list_get(bytes, offset + 19)
    );

    let valid: Bool = (version == 4) && (ihl >= 5);

    return Ipv4Header {
        version: version,
        ihl: ihl,
        dscp: dscp,
        ecn: ecn,
        total_length: tot_len,
        identification: ident,
        flags_df: df,
        flags_mf: mf,
        fragment_offset: frag_off,
        ttl: ttl,
        protocol: proto,
        checksum: csum,
        src_ip: src,
        dst_ip: dst,
        is_valid: valid
    };
}
