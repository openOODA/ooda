// # Network Traffic Anomaly Detection Engine
//
// Logline: Monitors network traffic baselines to detect SYN flood patterns, port scans, and bandwidth volumetric spikes.
//
// Setup: Pure network behavioral analytics engine emitting defensive telemetry alerts.
//
// Beats:
//   1. Define TrafficProfile and TrafficAnomalyAlert structures.
//   2. Track SYN-to-ACK ratios, unique destination port distributions, and byte rates.
//   3. Trigger high-severity anomaly alerts upon baseline threshold violation.

pub type TrafficAnomalyAlert = struct {
    alert_id: String,
    alert_type: String,   // "SYN_FLOOD", "PORT_SWEEP", "VOLUME_SPIKE"
    source_ip: String,
    anomaly_score: Int,   // 0-100
    timestamp: Int,
};

pub type TrafficProfile = struct {
    profile_id: String,
    max_syn_per_sec: Int,
    max_ports_per_src: Int,
    max_bytes_per_sec: Int,
    alerts: List[TrafficAnomalyAlert],
};

pub fn traffic_profile_new(
    id: String,
    max_syn: Int,
    max_ports: Int,
    max_bytes: Int
) -> TrafficProfile {
    let empty_alerts: List[TrafficAnomalyAlert] = list_new();
    return TrafficProfile {
        profile_id: id,
        max_syn_per_sec: max_syn,
        max_ports_per_src: max_ports,
        max_bytes_per_sec: max_bytes,
        alerts: empty_alerts,
    };
}

pub fn traffic_analyze_flow(
    profile: &mut TrafficProfile,
    src_ip: String,
    syn_count: Int,
    distinct_ports: Int,
    byte_rate: Int,
    now: Int
) -> Bool {
    let mut anomaly_detected: Bool = false;

    if syn_count > profile.max_syn_per_sec {
        let alert: TrafficAnomalyAlert = TrafficAnomalyAlert {
            alert_id: "ALT-SYN-" + src_ip,
            alert_type: "SYN_FLOOD",
            source_ip: src_ip,
            anomaly_score: 90,
            timestamp: now,
        };
        profile.alerts = list_push(profile.alerts, alert);
        anomaly_detected = true;
    }

    if distinct_ports > profile.max_ports_per_src {
        let alert: TrafficAnomalyAlert = TrafficAnomalyAlert {
            alert_id: "ALT-SWEEP-" + src_ip,
            alert_type: "PORT_SWEEP",
            source_ip: src_ip,
            anomaly_score: 75,
            timestamp: now,
        };
        profile.alerts = list_push(profile.alerts, alert);
        anomaly_detected = true;
    }

    if byte_rate > profile.max_bytes_per_sec {
        let alert: TrafficAnomalyAlert = TrafficAnomalyAlert {
            alert_id: "ALT-VOL-" + src_ip,
            alert_type: "VOLUME_SPIKE",
            source_ip: src_ip,
            anomaly_score: 80,
            timestamp: now,
        };
        profile.alerts = list_push(profile.alerts, alert);
        anomaly_detected = true;
    }

    return anomaly_detected;
}

pub fn traffic_profile_alert_count(profile: &TrafficProfile) -> Int {
    let a: List[TrafficAnomalyAlert] = (profile).alerts;
    return list_len(a);
}
