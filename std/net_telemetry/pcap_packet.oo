// # PCAP Packet Record Structure
//
// Logline: Encapsulates captured packet metadata, wire timestamps, truncation metrics, and raw payloads.
//
// Setup: Pure packet metadata record representation for defensive network telemetry.
//
// Beats:
//   1. Define PcapPacketRecord and timestamp structures.
//   2. Compute microsecond/nanosecond normalized timestamps.
//   3. Validate packet length constraints and truncation status.

pub type PcapTimestamp = struct {
    sec: Int,
    usec: Int,
    is_nanosecond: Bool,
};

pub type PcapPacketRecord = struct {
    packet_id: Int,
    ts: PcapTimestamp,
    incl_len: Int,
    orig_len: Int,
    data: List[Int],
    is_truncated: Bool,
};

pub fn pcap_timestamp_new(sec: Int, usec: Int, is_nano: Bool) -> PcapTimestamp {
    return PcapTimestamp {
        sec: sec,
        usec: usec,
        is_nanosecond: is_nano,
    };
}

pub fn pcap_timestamp_to_micros(ts: &PcapTimestamp) -> Int {
    let s: Int = (ts).sec;
    let u: Int = (ts).usec;
    let base_micros: Int = s * 1000000;
    if (ts).is_nanosecond {
        return base_micros + (u / 1000);
    }
    return base_micros + u;
}

pub fn pcap_timestamp_delta_micros(t1: &PcapTimestamp, t2: &PcapTimestamp) -> Int {
    let m1: Int = pcap_timestamp_to_micros(t1);
    let m2: Int = pcap_timestamp_to_micros(t2);
    if m2 >= m1 {
        return m2 - m1;
    }
    return m1 - m2;
}

pub fn pcap_packet_record_new(
    id: Int,
    ts: PcapTimestamp,
    incl_len: Int,
    orig_len: Int,
    data: List[Int]
) -> PcapPacketRecord {
    let truncated: Bool = incl_len < orig_len;
    return PcapPacketRecord {
        packet_id: id,
        ts: ts,
        incl_len: incl_len,
        orig_len: orig_len,
        data: data,
        is_truncated: truncated,
    };
}

pub fn pcap_packet_get_byte(pkt: &PcapPacketRecord, index: Int) -> Int {
    let len: Int = list_len((pkt).data);
    if index < 0 {
        return 0;
    }
    if index >= len {
        return 0;
    }
    return list_get((pkt).data, index);
}
