// # ICMP Header and Message Decoder
//
// Logline: Decodes RFC 792 Internet Control Message Protocol headers, parses echo requests/replies, and classifies error codes.
//
// Setup: Pure network layer 3 ICMP protocol decoder and diagnostic message parser.
//
// Beats:
//   1. Define IcmpHeader structure and ICMP control types.
//   2. Parse 8-byte ICMP headers with identifier, sequence, and checksum.
//   3. Classify Echo Request/Reply, Destination Unreachable, and Time Exceeded messages.

pub type IcmpHeader = struct {
    msg_type: Int,
    code: Int,
    checksum: Int,
    identifier: Int,
    sequence: Int,
    is_valid: Bool
};

pub fn icmp_header_new(
    msg_type: Int,
    code: Int,
    checksum: Int,
    ident: Int,
    seq: Int
) -> IcmpHeader {
    let valid: Bool = (msg_type >= 0) && (msg_type <= 255);
    return IcmpHeader {
        msg_type: msg_type,
        code: code,
        checksum: checksum,
        identifier: ident,
        sequence: seq,
        is_valid: valid
    };
}

pub fn icmp_parse_header(bytes: List[Int], offset: Int) -> IcmpHeader {
    let len: Int = list_len(bytes);
    if (offset + 8) > len {
        return IcmpHeader {
            msg_type: 0,
            code: 0,
            checksum: 0,
            identifier: 0,
            sequence: 0,
            is_valid: false
        };
    }

    let m_type: Int = list_get(bytes, offset);
    let code: Int = list_get(bytes, offset + 1);
    let csum: Int = (list_get(bytes, offset + 2) * 256) + list_get(bytes, offset + 3);
    let ident: Int = (list_get(bytes, offset + 4) * 256) + list_get(bytes, offset + 5);
    let seq: Int = (list_get(bytes, offset + 6) * 256) + list_get(bytes, offset + 7);

    return icmp_header_new(m_type, code, csum, ident, seq);
}

pub fn icmp_is_echo_request(hdr: &IcmpHeader) -> Bool {
    return ((hdr).msg_type == 8) && ((hdr).code == 0);
}

pub fn icmp_is_echo_reply(hdr: &IcmpHeader) -> Bool {
    return ((hdr).msg_type == 0) && ((hdr).code == 0);
}

pub fn icmp_is_unreachable(hdr: &IcmpHeader) -> Bool {
    return (hdr).msg_type == 3;
}

pub fn icmp_is_time_exceeded(hdr: &IcmpHeader) -> Bool {
    return (hdr).msg_type == 11;
}
