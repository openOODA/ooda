// # IPv6 Base Header and Extension Parser
//
// Logline: Decodes RFC 8200 40-byte fixed IPv6 headers, extracts flow labels, next-header chains, and formats addresses.
//
// Setup: Pure network layer 3 IPv6 protocol parser and extension classifier.
//
// Beats:
//   1. Define Ipv6Address and Ipv6Header structures.
//   2. Parse 40-byte fixed IPv6 headers with flow labels and hop limits.
//   3. Classify next-header extension types and format 128-bit addresses.

pub type Ipv6Address = struct {
    w0: Int,
    w1: Int,
    w2: Int,
    w3: Int,
    w4: Int,
    w5: Int,
    w6: Int,
    w7: Int,
};

pub type Ipv6Header = struct {
    version: Int,
    traffic_class: Int,
    flow_label: Int,
    payload_length: Int,
    next_header: Int,
    hop_limit: Int,
    src_ip: Ipv6Address,
    dst_ip: Ipv6Address,
    is_valid: Bool,
};

pub fn ipv6_address_new(
    w0: Int, w1: Int, w2: Int, w3: Int,
    w4: Int, w5: Int, w6: Int, w7: Int
) -> Ipv6Address {
    return Ipv6Address {
        w0: w0, w1: w1, w2: w2, w3: w3,
        w4: w4, w5: w5, w6: w6, w7: w7,
    };
}

pub fn ipv6_address_to_string(ip: &Ipv6Address) -> String {
    let s0: String = (ip).w0.to_string();
    let s1: String = (ip).w1.to_string();
    let s2: String = (ip).w2.to_string();
    let s3: String = (ip).w3.to_string();
    let s4: String = (ip).w4.to_string();
    let s5: String = (ip).w5.to_string();
    let s6: String = (ip).w6.to_string();
    let s7: String = (ip).w7.to_string();
    return s0 + ":" + s1 + ":" + s2 + ":" + s3 + ":" + s4 + ":" + s5 + ":" + s6 + ":" + s7;
}

pub fn ipv6_address_is_loopback(ip: &Ipv6Address) -> Bool {
    return ((ip).w0 == 0) && ((ip).w1 == 0) && ((ip).w2 == 0) && ((ip).w3 == 0) &&
           ((ip).w4 == 0) && ((ip).w5 == 0) && ((ip).w6 == 0) && ((ip).w7 == 1);
}

pub fn ipv6_address_is_link_local(ip: &Ipv6Address) -> Bool {
    // fe80::/10 -> w0 >= 0xfe80 and w0 <= 0xfebf (65152..65215)
    return ((ip).w0 >= 65152) && ((ip).w0 <= 65215);
}

pub fn ipv6_parse_header(bytes: List[Int], offset: Int) -> Ipv6Header {
    let len: Int = list_len(bytes);
    let empty_ip: Ipv6Address = ipv6_address_new(0, 0, 0, 0, 0, 0, 0, 0);

    if (offset + 40) > len {
        return Ipv6Header {
            version: 0,
            traffic_class: 0,
            flow_label: 0,
            payload_length: 0,
            next_header: 0,
            hop_limit: 0,
            src_ip: empty_ip,
            dst_ip: empty_ip,
            is_valid: false,
        };
    }

    let b0: Int = list_get(bytes, offset);
    let b1: Int = list_get(bytes, offset + 1);
    let b2: Int = list_get(bytes, offset + 2);
    let b3: Int = list_get(bytes, offset + 3);

    let version: Int = b0 / 16;
    let tc: Int = ((b0 % 16) * 16) + (b1 / 16);
    let fl: Int = ((b1 % 16) * 65536) + (b2 * 256) + b3;

    let payload_len: Int = (list_get(bytes, offset + 4) * 256) + list_get(bytes, offset + 5);
    let next_hdr: Int = list_get(bytes, offset + 6);
    let hop_lim: Int = list_get(bytes, offset + 7);

    let src: Ipv6Address = ipv6_address_new(
        (list_get(bytes, offset + 8) * 256) + list_get(bytes, offset + 9),
        (list_get(bytes, offset + 10) * 256) + list_get(bytes, offset + 11),
        (list_get(bytes, offset + 12) * 256) + list_get(bytes, offset + 13),
        (list_get(bytes, offset + 14) * 256) + list_get(bytes, offset + 15),
        (list_get(bytes, offset + 16) * 256) + list_get(bytes, offset + 17),
        (list_get(bytes, offset + 18) * 256) + list_get(bytes, offset + 19),
        (list_get(bytes, offset + 20) * 256) + list_get(bytes, offset + 21),
        (list_get(bytes, offset + 22) * 256) + list_get(bytes, offset + 23)
    );

    let dst: Ipv6Address = ipv6_address_new(
        (list_get(bytes, offset + 24) * 256) + list_get(bytes, offset + 25),
        (list_get(bytes, offset + 26) * 256) + list_get(bytes, offset + 27),
        (list_get(bytes, offset + 28) * 256) + list_get(bytes, offset + 29),
        (list_get(bytes, offset + 30) * 256) + list_get(bytes, offset + 31),
        (list_get(bytes, offset + 32) * 256) + list_get(bytes, offset + 33),
        (list_get(bytes, offset + 34) * 256) + list_get(bytes, offset + 35),
        (list_get(bytes, offset + 36) * 256) + list_get(bytes, offset + 37),
        (list_get(bytes, offset + 38) * 256) + list_get(bytes, offset + 39)
    );

    let valid: Bool = version == 6;

    return Ipv6Header {
        version: version,
        traffic_class: tc,
        flow_label: fl,
        payload_length: payload_len,
        next_header: next_hdr,
        hop_limit: hop_lim,
        src_ip: src,
        dst_ip: dst,
        is_valid: valid,
    };
}
