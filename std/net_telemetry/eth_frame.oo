// # Ethernet II Frame Parser and MAC Formatter
//
// Logline: Decodes IEEE 802.3 and Ethernet II headers, extracts EtherType codes, and formats MAC addresses.
//
// Setup: Pure network layer 2 frame decoder and MAC address utility.
//
// Beats:
//   1. Define EthernetFrame and MacAddress structures.
//   2. Parse 14-byte Ethernet headers and determine encapsulated EtherType.
//   3. Provide canonical MAC formatting and broadcast/multicast classification.

pub type MacAddress = struct {
    b0: Int,
    b1: Int,
    b2: Int,
    b3: Int,
    b4: Int,
    b5: Int,
};

pub type EthernetFrame = struct {
    dst_mac: MacAddress,
    src_mac: MacAddress,
    ethertype: Int,
    vlan_id: Int,
    payload_len: Int,
    is_valid: Bool,
};

pub fn mac_address_new(b0: Int, b1: Int, b2: Int, b3: Int, b4: Int, b5: Int) -> MacAddress {
    return MacAddress {
        b0: b0,
        b1: b1,
        b2: b2,
        b3: b3,
        b4: b4,
        b5: b5,
    };
}

pub fn mac_address_is_broadcast(mac: &MacAddress) -> Bool {
    return ((mac).b0 == 255) && ((mac).b1 == 255) && ((mac).b2 == 255) &&
           ((mac).b3 == 255) && ((mac).b4 == 255) && ((mac).b5 == 255);
}

pub fn mac_address_is_multicast(mac: &MacAddress) -> Bool {
    // Multicast least significant bit of first octet is 1
    return ((mac).b0 % 2) == 1;
}

pub fn mac_address_to_string(mac: &MacAddress) -> String {
    let s0: String = (mac).b0.to_string();
    let s1: String = (mac).b1.to_string();
    let s2: String = (mac).b2.to_string();
    let s3: String = (mac).b3.to_string();
    let s4: String = (mac).b4.to_string();
    let s5: String = (mac).b5.to_string();
    return s0 + ":" + s1 + ":" + s2 + ":" + s3 + ":" + s4 + ":" + s5;
}

pub fn eth_frame_parse(
    raw_bytes: List[Int]
) -> EthernetFrame {
    let total_len: Int = list_len(raw_bytes);
    if total_len < 14 {
        let empty_mac: MacAddress = mac_address_new(0, 0, 0, 0, 0, 0);
        return EthernetFrame {
            dst_mac: empty_mac,
            src_mac: empty_mac,
            ethertype: 0,
            vlan_id: 0,
            payload_len: 0,
            is_valid: false,
        };
    }

    let dst: MacAddress = mac_address_new(
        list_get(raw_bytes, 0),
        list_get(raw_bytes, 1),
        list_get(raw_bytes, 2),
        list_get(raw_bytes, 3),
        list_get(raw_bytes, 4),
        list_get(raw_bytes, 5)
    );

    let src: MacAddress = mac_address_new(
        list_get(raw_bytes, 6),
        list_get(raw_bytes, 7),
        list_get(raw_bytes, 8),
        list_get(raw_bytes, 9),
        list_get(raw_bytes, 10),
        list_get(raw_bytes, 11)
    );

    let et_hi: Int = list_get(raw_bytes, 12);
    let et_lo: Int = list_get(raw_bytes, 13);
    let ethertype: Int = (et_hi * 256) + et_lo;

    return EthernetFrame {
        dst_mac: dst,
        src_mac: src,
        ethertype: ethertype,
        vlan_id: 0,
        payload_len: total_len - 14,
        is_valid: true,
    };
}

pub fn eth_frame_is_ipv4(frame: &EthernetFrame) -> Bool {
    return (frame).ethertype == 2048; // 0x0800
}

pub fn eth_frame_is_ipv6(frame: &EthernetFrame) -> Bool {
    return (frame).ethertype == 34525; // 0x86DD
}

pub fn eth_frame_is_arp(frame: &EthernetFrame) -> Bool {
    return (frame).ethertype == 2054; // 0x0806
}
