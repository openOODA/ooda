// # Defensive Network Telemetry & Packet Inspection Facade
//
// Logline: Re-exports PCAP parsing, protocol decoders, BPF packet filters, telemetry metrics, DPI stream reassembler, and firewall rules.
//
// Setup: Pure module shim and facade importing all 17 companion Network Telemetry submodules.
//
// Beats:
//   1. Import 17 modular network telemetry and packet analysis components.
//   2. Re-export public constructors, parsers, filters, and capability-gated interfaces.
//   3. Maintain complete compatibility with downstream openOODA telemetry callers.

import "./pcap_header.oo";
import "./pcap_packet.oo";
import "./pcap_reader.oo";
import "./eth_frame.oo";
import "./ipv4_packet.oo";
import "./ipv6_packet.oo";
import "./tcp_segment.oo";
import "./udp_packet.oo";
import "./icmp_packet.oo";
import "./packet_filter.oo";
import "./packet_stats.oo";
import "./dpi_stream.oo";
import "./firewall_rules.oo";
import "./traffic_analyzer.oo";
import "./ids_signatures.oo";
import "./honeynet_telemetry.oo";
import "./telemetry_stubs.oo";

pub fn net_telemetry_shim_pcap_header() -> PcapGlobalHeader {
    return pcap_header_default();
}

pub fn net_telemetry_shim_eth_parse(raw_bytes: List[Int]) -> EthernetFrame {
    return eth_frame_parse(raw_bytes);
}

pub fn net_telemetry_shim_ipv4_parse(bytes: List[Int], offset: Int) -> Ipv4Header {
    return ipv4_parse_header(bytes, offset);
}

pub fn net_telemetry_shim_ipv6_parse(bytes: List[Int], offset: Int) -> Ipv6Header {
    return ipv6_parse_header(bytes, offset);
}

pub fn net_telemetry_shim_tcp_parse(bytes: List[Int], offset: Int) -> TcpSegment {
    return tcp_segment_parse(bytes, offset);
}

pub fn net_telemetry_shim_udp_parse(bytes: List[Int], offset: Int) -> UdpDatagram {
    return udp_parse_header(bytes, offset);
}

pub fn net_telemetry_shim_icmp_parse(bytes: List[Int], offset: Int) -> IcmpHeader {
    return icmp_parse_header(bytes, offset);
}

pub fn net_telemetry_shim_filter_engine(id: String) -> PacketFilterEngine {
    return packet_filter_engine_new(id);
}

pub fn net_telemetry_shim_stats_new(iface: String, now: Int) -> PacketStatsCounter {
    return packet_stats_new(iface, now);
}

pub fn net_telemetry_shim_dpi_session(id: String, seq: Int) -> DpiStreamSession {
    return dpi_stream_session_new(id, seq);
}

pub fn net_telemetry_shim_firewall(name: String, drop: Bool) -> FirewallTable {
    return firewall_table_new(name, drop);
}

pub fn net_telemetry_shim_traffic_profile(id: String, syn: Int, ports: Int, bytes: Int) -> TrafficProfile {
    return traffic_profile_new(id, syn, ports, bytes);
}

pub fn net_telemetry_shim_ids(name: String) -> IdsEngine {
    return ids_engine_new(name);
}

pub fn net_telemetry_shim_honeynet(id: String, svc: String, port: Int) -> HoneynetSensor {
    return honeynet_sensor_new(id, svc, port);
}

pub fn net_telemetry_shim_pcap_read(fs: &FsReadCap, path: String) -> Result[PcapReaderState, String] {
    return pcap_read_file(fs, path);
}

pub fn net_telemetry_shim_dma_poll(sys: &SysCap) -> Int {
    return telemetry_raw_nic_dma_poll(sys, 0, 100);
}
