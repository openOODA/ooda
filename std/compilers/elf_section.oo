// # ELF 64-bit Section & Program Headers
//
// Logline: ELF64 SHT/SHF/PT constants, 64-byte shdr, 56-byte phdr.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; String/List flattened; by-value.

type ElfSection64 = struct {
    sh_name: Int,
    sh_type: Int,
    sh_flags: Int,
    sh_addr: Int,
    sh_offset: Int,
    sh_size: Int,
    sh_link: Int,
    sh_info: Int,
    sh_addralign: Int,
    sh_entsize: Int,
    name_id: Int
};

type ElfProgramHeader64 = struct {
    p_type: Int,
    p_flags: Int,
    p_offset: Int,
    p_vaddr: Int,
    p_paddr: Int,
    p_filesz: Int,
    p_memsz: Int,
    p_align: Int
};

pub fn elf_sht_null() -> Int {
    return 0;
}

pub fn elf_sht_progbits() -> Int {
    return 1;
}

pub fn elf_sht_symtab() -> Int {
    return 2;
}

pub fn elf_sht_strtab() -> Int {
    return 3;
}

pub fn elf_sht_rela() -> Int {
    return 4;
}

pub fn elf_sht_nobits() -> Int {
    return 8;
}

pub fn elf_shf_write() -> Int {
    return 1;
}

pub fn elf_shf_alloc() -> Int {
    return 2;
}

pub fn elf_shf_execinstr() -> Int {
    return 4;
}

pub fn elf_pt_null() -> Int {
    return 0;
}

pub fn elf_pt_load() -> Int {
    return 1;
}

pub fn elf_pt_dynamic() -> Int {
    return 2;
}

pub fn elf_pt_phdr() -> Int {
    return 6;
}

pub fn elf_pf_x() -> Int {
    return 1;
}

pub fn elf_pf_w() -> Int {
    return 2;
}

pub fn elf_pf_r() -> Int {
    return 4;
}

pub fn elf_shdr64_bytes() -> Int {
    return 64;
}

pub fn elf_phdr64_bytes() -> Int {
    return 56;
}

pub fn elf_section64_new(name_id: Int, sec_type: Int, flags: Int) -> ElfSection64 {
    return ElfSection64 {
        sh_name: 0,
        sh_type: sec_type,
        sh_flags: flags,
        sh_addr: 0,
        sh_offset: 0,
        sh_size: 0,
        sh_link: 0,
        sh_info: 0,
        sh_addralign: 16,
        sh_entsize: 0,
        name_id: name_id
    };
}

pub fn elf_section64_text(data_size: Int, addr: Int) -> ElfSection64 {
    let flags: Int = 6;
    return ElfSection64 {
        sh_name: 0,
        sh_type: 1,
        sh_flags: flags,
        sh_addr: addr,
        sh_offset: 0,
        sh_size: data_size,
        sh_link: 0,
        sh_info: 0,
        sh_addralign: 16,
        sh_entsize: 0,
        name_id: 1
    };
}

pub fn elf_section64_data(data_size: Int, addr: Int) -> ElfSection64 {
    let flags: Int = 3;
    return ElfSection64 {
        sh_name: 0,
        sh_type: 1,
        sh_flags: flags,
        sh_addr: addr,
        sh_offset: 0,
        sh_size: data_size,
        sh_link: 0,
        sh_info: 0,
        sh_addralign: 16,
        sh_entsize: 0,
        name_id: 2
    };
}

pub fn elf_section64_bss(mem_size: Int, addr: Int) -> ElfSection64 {
    return ElfSection64 {
        sh_name: 0,
        sh_type: 8,
        sh_flags: 3,
        sh_addr: addr,
        sh_offset: 0,
        sh_size: mem_size,
        sh_link: 0,
        sh_info: 0,
        sh_addralign: 16,
        sh_entsize: 0,
        name_id: 4
    };
}

pub fn elf_program_header64_new(p_type: Int, flags: Int, offset: Int, vaddr: Int, filesz: Int, memsz: Int) -> ElfProgramHeader64 {
    return ElfProgramHeader64 {
        p_type: p_type,
        p_flags: flags,
        p_offset: offset,
        p_vaddr: vaddr,
        p_paddr: vaddr,
        p_filesz: filesz,
        p_memsz: memsz,
        p_align: 4096
    };
}

pub fn elf_program_header64_load_rx(offset: Int, vaddr: Int, filesz: Int, memsz: Int) -> ElfProgramHeader64 {
    let flags: Int = 5;
    return elf_program_header64_new(1, flags, offset, vaddr, filesz, memsz);
}

pub fn elf_section64_type(s: ElfSection64) -> Int {
    return s.sh_type;
}

pub fn elf_section64_flags(s: ElfSection64) -> Int {
    return s.sh_flags;
}

pub fn elf_phdr64_align(p: ElfProgramHeader64) -> Int {
    return p.p_align;
}
