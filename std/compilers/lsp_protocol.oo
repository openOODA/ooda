// # Language Server Protocol Data Types
//
// Logline: Language Server Protocol (LSP 3.17) position markers, range spans, document items, and JSON-RPC envelopes.
//
// Setup: Pure data models representing editor buffer coordinates, document descriptors, and RPC communication payloads.
//
// Beats:
//   1. Define 0-based document position coordinates, text ranges, and URI locations.
//   2. Define document identifiers, version tracking, and synchronization items.
//   3. Define JSON-RPC 2.0 request and response messaging envelopes.

pub type LspPosition = struct {
    line: Int,
    character: Int
};

pub type LspRange = struct {
    start_line: Int,
    start_col: Int,
    end_line: Int,
    end_col: Int
};

pub type LspLocation = struct {
    uri: String,
    range: LspRange
};

pub type LspTextDocumentIdentifier = struct {
    uri: String
};

pub type LspVersionedTextDocumentIdentifier = struct {
    uri: String,
    version: Int
};

pub type LspTextDocumentItem = struct {
    uri: String,
    language_id: String,
    version: Int,
    text: String
};

pub type LspRequestMessage = struct {
    jsonrpc: String,
    id: Int,
    method_name: String,
    params_json: String
};

pub type LspResponseMessage = struct {
    jsonrpc: String,
    id: Int,
    result_json: String,
    error_code: Int,
    error_msg: String,
    is_error: Bool
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn lsp_position_new(line: Int, char_idx: Int) -> LspPosition {
    return LspPosition {
        line: line,
        character: char_idx
    };
}

pub fn lsp_range_new(sl: Int, sc: Int, el: Int, ec: Int) -> LspRange {
    return LspRange {
        start_line: sl,
        start_col: sc,
        end_line: el,
        end_col: ec
    };
}

pub fn lsp_location_new(uri: String, range: LspRange) -> LspLocation {
    return LspLocation {
        uri: uri,
        range: range
    };
}

pub fn lsp_doc_id_new(uri: String) -> LspTextDocumentIdentifier {
    return LspTextDocumentIdentifier {
        uri: uri
    };
}

pub fn lsp_versioned_doc_id_new(uri: String, version: Int) -> LspVersionedTextDocumentIdentifier {
    return LspVersionedTextDocumentIdentifier {
        uri: uri,
        version: version
    };
}

pub fn lsp_doc_item_new(uri: String, lang: String, version: Int, text: String) -> LspTextDocumentItem {
    return LspTextDocumentItem {
        uri: uri,
        language_id: lang,
        version: version,
        text: text
    };
}

pub fn lsp_request_new(id: Int, method: String, params: String) -> LspRequestMessage {
    return LspRequestMessage {
        jsonrpc: "2.0",
        id: id,
        method_name: method,
        params_json: params
    };
}

pub fn lsp_response_ok(id: Int, result_json: String) -> LspResponseMessage {
    return LspResponseMessage {
        jsonrpc: "2.0",
        id: id,
        result_json: result_json,
        error_code: 0,
        error_msg: "",
        is_error: false
    };
}

pub fn lsp_response_err(id: Int, code: Int, msg: String) -> LspResponseMessage {
    return LspResponseMessage {
        jsonrpc: "2.0",
        id: id,
        result_json: "{}",
        error_code: code,
        error_msg: msg,
        is_error: true
    };
}
