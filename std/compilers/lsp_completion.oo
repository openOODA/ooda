// # LSP Code Completion and Intelligence
//
// Logline: Autocompletion items, trigger kinds, hover documentation tooltips, and document symbol indexing.
//
// Setup: Imports lsp_protocol.oo to model code completion lists, hover tooltips, and workspace symbols.
//
// Beats:
//   1. Define completion item kinds (Keyword, Function, Struct, Method, Variable).
//   2. Construct typed completion items and completion lists.
//   3. Define hover tooltips and hierarchical document symbol descriptors.

import "./lsp_protocol.oo";

pub type LspCompletionItem = struct {
    label: String,
    kind: Int,
    detail: String,
    documentation: String,
    insert_text: String,
    insert_text_format: Int
};

pub type LspCompletionList = struct {
    is_incomplete: Bool,
    items: List[LspCompletionItem],
    item_count: Int
};

pub type LspHover = struct {
    contents: String,
    range: LspRange,
    has_range: Bool
};

pub type LspSymbolInformation = struct {
    name: String,
    kind: Int,
    location: LspLocation,
    container_name: String
};

// -------------------------------------------------------------------
// Item Kind Constants
// -------------------------------------------------------------------

pub fn lsp_item_kind_text() -> Int { return 1; }
pub fn lsp_item_kind_method() -> Int { return 2; }
pub fn lsp_item_kind_function() -> Int { return 3; }
pub fn lsp_item_kind_field() -> Int { return 5; }
pub fn lsp_item_kind_variable() -> Int { return 6; }
pub fn lsp_item_kind_keyword() -> Int { return 14; }
pub fn lsp_item_kind_snippet() -> Int { return 15; }
pub fn lsp_item_kind_struct() -> Int { return 22; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn lsp_completion_item_new(label: String, kind: Int, detail: String) -> LspCompletionItem {
    return LspCompletionItem {
        label: label,
        kind: kind,
        detail: detail,
        documentation: "",
        insert_text: label,
        insert_text_format: 1 // PlainText
    };
}

pub fn lsp_completion_keyword(kw: String) -> LspCompletionItem {
    return lsp_completion_item_new(kw, lsp_item_kind_keyword(), "keyword");
}

pub fn lsp_completion_function(name: String, sig: String, doc: String) -> LspCompletionItem {
    return LspCompletionItem {
        label: name,
        kind: lsp_item_kind_function(),
        detail: sig,
        documentation: doc,
        insert_text: name + "()",
        insert_text_format: 1
    };
}

pub fn lsp_completion_list_new() -> LspCompletionList {
    let mut items: List[LspCompletionItem] = list_new();
    return LspCompletionList {
        is_incomplete: false,
        items: items,
        item_count: 0
    };
}

pub fn lsp_completion_list_add(list: LspCompletionList, item: LspCompletionItem) -> LspCompletionList {
    let new_items: List[LspCompletionItem] = list_push((list).items, item);
    return LspCompletionList {
        is_incomplete: (list).is_incomplete,
        items: new_items,
        item_count: (list).item_count + 1
    };
}

pub fn lsp_hover_new(content: String) -> LspHover {
    let dummy_range: LspRange = lsp_range_new(0, 0, 0, 0);
    return LspHover {
        contents: content,
        range: dummy_range,
        has_range: false
    };
}

pub fn lsp_symbol_info_new(name: String, kind: Int, uri: String, range: LspRange) -> LspSymbolInformation {
    let loc: LspLocation = lsp_location_new(uri, range);
    return LspSymbolInformation {
        name: name,
        kind: kind,
        location: loc,
        container_name: ""
    };
}
