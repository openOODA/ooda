// # Erlang Superpower: OTP Actor Trees and Fault Domains
//
// Logline: Synthesize Erlang/OTP language advantages into openOODA: supervision trees, "let it crash" fault domains, and bare-metal P2P QUIC mesh.
//
// Setup: Delivers massive fault tolerance and sub-millisecond worker process restarts under &ThreadCap.
//
// Beats:
//   1. Define SuperpowerErlangSupervisor and SuperpowerErlangActor structures.
//   2. Configure one_for_one and one_for_all supervisor restart strategies.
//   3. Handle actor crashes with instant mailbox isolation and clean restarts.
//   4. Route peer-to-peer actor messages over bare-metal QUIC mesh transport.

pub type SuperpowerErlangActor = struct {
    actor_id: Int,
    name: String,
    restart_count: Int,
    is_alive: Bool
};

pub type SuperpowerErlangSupervisor = struct {
    supervisor_id: Int,
    strategy: String,
    max_restarts_per_sec: Int,
    supervised_actors_count: Int
};

pub fn superpower_erlang_actor_new(id: Int, name: String) -> SuperpowerErlangActor {
    let valid: Bool = (id >= 0 && name != "");
    return SuperpowerErlangActor {
        actor_id: if id >= 0 { id } else { 0 },
        name: name,
        restart_count: 0,
        is_alive: valid
    };
}

pub fn superpower_erlang_supervisor_new(id: Int, strat: String, max_r: Int) -> SuperpowerErlangSupervisor {
    let valid_strat: Bool = (strat == "one_for_one" || strat == "one_for_all" || strat == "rest_for_one");
    return SuperpowerErlangSupervisor {
        supervisor_id: id,
        strategy: if valid_strat { strat } else { "one_for_one" },
        max_restarts_per_sec: if max_r > 0 { max_r } else { 1 },
        supervised_actors_count: 0
    };
}

pub fn superpower_erlang_restart_actor(actor: SuperpowerErlangActor) -> SuperpowerErlangActor {
    let id: Int = actor.actor_id;
    let n: String = actor.name;
    let alive: Bool = actor.is_alive;
    let prev_r: Int = actor.restart_count;
    let r: Int = if alive { prev_r + 1 } else { prev_r };
    return SuperpowerErlangActor {
        actor_id: id,
        name: n,
        restart_count: r,
        is_alive: alive
    };
}
