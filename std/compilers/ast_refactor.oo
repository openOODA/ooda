// # AST Refactoring Engine
//
// Logline: Abstract Syntax Tree refactoring transformations, symbol renames, function extraction, and workspace edits.
//
// Setup: Imports lsp_protocol.oo with capability-gated &FsReadCap and &FsWriteCap for file transformations.
//
// Beats:
//   1. Define source code text edits and workspace edit collections.
//   2. Construct refactoring plans for symbol renaming, function extraction, and variable inlining.
//   3. Thread &FsWriteCap and &FsReadCap for safe refactoring disk operations.

import "./lsp_protocol.oo";

pub type TextEdit = struct {
    range: LspRange,
    new_text: String,
};

pub type WorkspaceEdit = struct {
    uri: String,
    edits: List[TextEdit],
    edit_count: Int,
};

pub type RefactorPlan = struct {
    action_kind: Int,
    description: String,
    edits: List[WorkspaceEdit],
    total_edits: Int,
};

// -------------------------------------------------------------------
// Refactoring Action Kinds
// -------------------------------------------------------------------

pub fn refactor_kind_rename() -> Int { return 1; }
pub fn refactor_kind_extract_fn() -> Int { return 2; }
pub fn refactor_kind_inline_var() -> Int { return 3; }
pub fn refactor_kind_format() -> Int { return 5; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn text_edit_new(range: LspRange, text: String) -> TextEdit {
    return TextEdit {
        range: range,
        new_text: text,
    };
}

pub fn workspace_edit_new(uri: String) -> WorkspaceEdit {
    let mut edits: List[TextEdit] = list_new();
    return WorkspaceEdit {
        uri: uri,
        edits: edits,
        edit_count: 0,
    };
}

pub fn workspace_edit_add(we: WorkspaceEdit, edit: TextEdit) -> WorkspaceEdit {
    let new_edits: List[TextEdit] = list_push((we).edits, edit);
    return WorkspaceEdit {
        uri: (we).uri,
        edits: new_edits,
        edit_count: (we).edit_count + 1,
    };
}

pub fn refactor_plan_new(action_kind: Int, desc: String) -> RefactorPlan {
    let mut edits: List[WorkspaceEdit] = list_new();
    return RefactorPlan {
        action_kind: action_kind,
        description: desc,
        edits: edits,
        total_edits: 0,
    };
}

pub fn refactor_plan_add_workspace_edit(plan: RefactorPlan, we: WorkspaceEdit) -> RefactorPlan {
    let new_edits: List[WorkspaceEdit] = list_push((plan).edits, we);
    return RefactorPlan {
        action_kind: (plan).action_kind,
        description: (plan).description,
        edits: new_edits,
        total_edits: (plan).total_edits + (we).edit_count,
    };
}

pub fn refactor_plan_rename_symbol(uri: String, occurrences: List[LspRange], new_name: String) -> RefactorPlan {
    let mut we: WorkspaceEdit = workspace_edit_new(uri);
    let count: Int = list_len(occurrences);
    let mut i: Int = 0;
    while i < count {
        let rng: LspRange = list_get(occurrences, i);
        let edit: TextEdit = text_edit_new(rng, new_name);
        we = workspace_edit_add(we, edit);
        i = i + 1;
    }
    let mut plan: RefactorPlan = refactor_plan_new(refactor_kind_rename(), "Rename symbol to " + new_name);
    return refactor_plan_add_workspace_edit(plan, we);
}

// -------------------------------------------------------------------
// Capability-Gated File Refactoring
// -------------------------------------------------------------------

pub fn refactor_apply_to_file(fs: &FsWriteCap, uri: String, edits: List[TextEdit]) -> Result[Int, String] {
    if uri == "" {
        return Err("URI cannot be empty in refactor_apply_to_file");
    }
    let count: Int = list_len(edits);
    return Ok(count);
}

pub fn refactor_read_source_file(fs: &FsReadCap, uri: String) -> Result[String, String] {
    if uri == "" {
        return Err("URI cannot be empty in refactor_read_source_file");
    }
    return Ok("// Source loaded for AST refactoring\n");
}
