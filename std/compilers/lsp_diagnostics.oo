// # LSP Diagnostics & Code Actions
//
// Logline: Language Server Protocol compiler diagnostic reporting, severity levels, code actions, and publish parameters.
//
// Setup: Imports lsp_protocol.oo to construct compiler errors, warnings, and automated quick-fix actions.
//
// Beats:
//   1. Define diagnostic severity levels (Error, Warning, Information, Hint).
//   2. Construct compiler diagnostic reports with source ranges and error codes.
//   3. Define publish diagnostics parameters and automated code action quick fixes.

import "./lsp_protocol.oo";

pub type LspDiagnostic = struct {
    range: LspRange,
    severity: Int,
    code: String,
    source: String,
    message: String,
};

pub type LspPublishDiagnosticsParams = struct {
    uri: String,
    version: Int,
    diagnostics: List[LspDiagnostic],
    diagnostic_count: Int,
};

pub type LspCodeAction = struct {
    title: String,
    kind: String,
    is_preferred: Bool,
    edit_uri: String,
    edit_range: LspRange,
    new_text: String,
};

// -------------------------------------------------------------------
// Severity Constants
// -------------------------------------------------------------------

pub fn lsp_diag_severity_error() -> Int { return 1; }
pub fn lsp_diag_severity_warning() -> Int { return 2; }
pub fn lsp_diag_severity_info() -> Int { return 3; }
pub fn lsp_diag_severity_hint() -> Int { return 4; }

// -------------------------------------------------------------------
// Diagnostic Constructors
// -------------------------------------------------------------------

pub fn lsp_diagnostic_new(range: LspRange, severity: Int, code: String, msg: String) -> LspDiagnostic {
    return LspDiagnostic {
        range: range,
        severity: severity,
        code: code,
        source: "oodac",
        message: msg,
    };
}

pub fn lsp_diagnostic_error(line: Int, col: Int, msg: String) -> LspDiagnostic {
    let rng: LspRange = lsp_range_new(line, col, line, col + 1);
    return lsp_diagnostic_new(rng, lsp_diag_severity_error(), "E0001", msg);
}

pub fn lsp_diagnostic_warning(line: Int, col: Int, msg: String) -> LspDiagnostic {
    let rng: LspRange = lsp_range_new(line, col, line, col + 1);
    return lsp_diagnostic_new(rng, lsp_diag_severity_warning(), "W0001", msg);
}

// -------------------------------------------------------------------
// Diagnostic Collection & Publishing
// -------------------------------------------------------------------

pub fn lsp_publish_params_new(uri: String, version: Int) -> LspPublishDiagnosticsParams {
    let mut diags: List[LspDiagnostic] = list_new();
    return LspPublishDiagnosticsParams {
        uri: uri,
        version: version,
        diagnostics: diags,
        diagnostic_count: 0,
    };
}

pub fn lsp_publish_params_add(p: LspPublishDiagnosticsParams, diag: LspDiagnostic) -> LspPublishDiagnosticsParams {
    let new_diags: List[LspDiagnostic] = list_push((p).diagnostics, diag);
    return LspPublishDiagnosticsParams {
        uri: (p).uri,
        version: (p).version,
        diagnostics: new_diags,
        diagnostic_count: (p).diagnostic_count + 1,
    };
}

pub fn lsp_code_action_new(title: String, kind: String, uri: String, range: LspRange, text: String) -> LspCodeAction {
    return LspCodeAction {
        title: title,
        kind: kind,
        is_preferred: true,
        edit_uri: uri,
        edit_range: range,
        new_text: text,
    };
}
