// # ELF 64-bit Header Definitions
//
// Logline: ELF64 ident, machine, type, and 64-byte layout.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type / &ref destubbed to type + by-value.

type ElfHeader64 = struct {
    ei_class: Int,
    ei_data: Int,
    ei_version: Int,
    ei_osabi: Int,
    ei_abiversion: Int,
    e_type: Int,
    e_machine: Int,
    e_version: Int,
    e_entry: Int,
    e_phoff: Int,
    e_shoff: Int,
    e_flags: Int,
    e_ehsize: Int,
    e_phentsize: Int,
    e_phnum: Int,
    e_shentsize: Int,
    e_shnum: Int,
    e_shstrndx: Int
};

pub fn elf_machine_x86_64() -> Int {
    return 62;
}

pub fn elf_machine_aarch64() -> Int {
    return 183;
}

pub fn elf_machine_riscv() -> Int {
    return 243;
}

pub fn elf_type_rel() -> Int {
    return 1;
}

pub fn elf_type_exec() -> Int {
    return 2;
}

pub fn elf_type_dyn() -> Int {
    return 3;
}

pub fn elf_header64_default(machine: Int, e_type: Int) -> ElfHeader64 {
    return ElfHeader64 {
        ei_class: 2,
        ei_data: 1,
        ei_version: 1,
        ei_osabi: 0,
        ei_abiversion: 0,
        e_type: e_type,
        e_machine: machine,
        e_version: 1,
        e_entry: 0,
        e_phoff: 64,
        e_shoff: 0,
        e_flags: 0,
        e_ehsize: 64,
        e_phentsize: 56,
        e_phnum: 1,
        e_shentsize: 64,
        e_shnum: 0,
        e_shstrndx: 0
    };
}

pub fn elf_header64_x86_64_exec(entry: Int) -> ElfHeader64 {
    let base: ElfHeader64 = elf_header64_default(elf_machine_x86_64(), elf_type_exec());
    return ElfHeader64 {
        ei_class: base.ei_class,
        ei_data: base.ei_data,
        ei_version: base.ei_version,
        ei_osabi: base.ei_osabi,
        ei_abiversion: base.ei_abiversion,
        e_type: base.e_type,
        e_machine: base.e_machine,
        e_version: base.e_version,
        e_entry: entry,
        e_phoff: base.e_phoff,
        e_shoff: base.e_shoff,
        e_flags: base.e_flags,
        e_ehsize: base.e_ehsize,
        e_phentsize: base.e_phentsize,
        e_phnum: base.e_phnum,
        e_shentsize: base.e_shentsize,
        e_shnum: base.e_shnum,
        e_shstrndx: base.e_shstrndx
    };
}

pub fn elf_header64_aarch64_exec(entry: Int) -> ElfHeader64 {
    let base: ElfHeader64 = elf_header64_default(elf_machine_aarch64(), elf_type_exec());
    return ElfHeader64 {
        ei_class: base.ei_class,
        ei_data: base.ei_data,
        ei_version: base.ei_version,
        ei_osabi: base.ei_osabi,
        ei_abiversion: base.ei_abiversion,
        e_type: base.e_type,
        e_machine: base.e_machine,
        e_version: base.e_version,
        e_entry: entry,
        e_phoff: base.e_phoff,
        e_shoff: base.e_shoff,
        e_flags: base.e_flags,
        e_ehsize: base.e_ehsize,
        e_phentsize: base.e_phentsize,
        e_phnum: base.e_phnum,
        e_shentsize: base.e_shentsize,
        e_shnum: base.e_shnum,
        e_shstrndx: base.e_shstrndx
    };
}

pub fn elf_header64_ident0(h: ElfHeader64) -> Int {
    return 127;
}

pub fn elf_header64_machine(h: ElfHeader64) -> Int {
    return h.e_machine;
}

pub fn elf_header64_validate(h: ElfHeader64) -> Int {
    if h.ei_class != 2 {
        return 0;
    }
    if h.ei_data != 1 {
        return 0;
    }
    if h.ei_version != 1 {
        return 0;
    }
    if h.e_ehsize != 64 {
        return 0;
    }
    return 1;
}

pub fn elf_header64_to_bytes(h: ElfHeader64) -> List[Int] {
    let mut b: List[Int] = list_new();
    b = list_push(b, 127);
    b = list_push(b, 69);
    b = list_push(b, 76);
    b = list_push(b, 70);
    b = list_push(b, h.ei_class);
    b = list_push(b, h.ei_data);
    b = list_push(b, h.ei_version);
    b = list_push(b, h.ei_osabi);
    b = list_push(b, h.ei_abiversion);
    let mut p: Int = 0;
    while p < 7 {
        b = list_push(b, 0);
        p = p + 1;
    }
    b = list_push(b, h.e_type & 255);
    b = list_push(b, (h.e_type / 256) & 255);
    b = list_push(b, h.e_machine & 255);
    b = list_push(b, (h.e_machine / 256) & 255);
    b = list_push(b, h.e_version & 255);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, 0);
    return b;
}
