// # WebAssembly Binary Sections
//
// Logline: WASM section ids, LEB128 size prefix, type-section form 0x60.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; List flattened to payload slots; by-value.

type WasmSection = struct {
    section_id: Int,
    payload_size: Int,
    p0: Int,
    p1: Int,
    p2: Int,
    p3: Int,
    p4: Int,
    p5: Int
};

pub fn wasm_section_id_custom() -> Int {
    return 0;
}

pub fn wasm_section_id_type() -> Int {
    return 1;
}

pub fn wasm_section_id_import() -> Int {
    return 2;
}

pub fn wasm_section_id_function() -> Int {
    return 3;
}

pub fn wasm_section_id_table() -> Int {
    return 4;
}

pub fn wasm_section_id_memory() -> Int {
    return 5;
}

pub fn wasm_section_id_global() -> Int {
    return 6;
}

pub fn wasm_section_id_export() -> Int {
    return 7;
}

pub fn wasm_section_id_start() -> Int {
    return 8;
}

pub fn wasm_section_id_element() -> Int {
    return 9;
}

pub fn wasm_section_id_code() -> Int {
    return 10;
}

pub fn wasm_section_id_data() -> Int {
    return 11;
}

pub fn wasm_valtype_i32() -> Int {
    return 127;
}

pub fn wasm_functype_form() -> Int {
    return 96;
}

pub fn wasm_leb128_b0(val: Int) -> Int {
    if val < 128 {
        return val & 127;
    }
    return (val & 127) + 128;
}

pub fn wasm_leb128_b1(val: Int) -> Int {
    if val < 128 {
        return 0;
    }
    return (val / 128) & 127;
}

pub fn wasm_section_new(section_id: Int, payload_size: Int, p0: Int, p1: Int, p2: Int, p3: Int, p4: Int, p5: Int) -> WasmSection {
    return WasmSection {
        section_id: section_id,
        payload_size: payload_size,
        p0: p0,
        p1: p1,
        p2: p2,
        p3: p3,
        p4: p4,
        p5: p5
    };
}

pub fn wasm_section_type_func_i32_i32() -> WasmSection {
    return WasmSection {
        section_id: 1,
        payload_size: 6,
        p0: 1,
        p1: 96,
        p2: 1,
        p3: 127,
        p4: 1,
        p5: 127
    };
}

pub fn wasm_section_function_type0() -> WasmSection {
    return WasmSection {
        section_id: 3,
        payload_size: 2,
        p0: 1,
        p1: 0,
        p2: 0,
        p3: 0,
        p4: 0,
        p5: 0
    };
}

pub fn wasm_section_memory_min1() -> WasmSection {
    return WasmSection {
        section_id: 5,
        payload_size: 3,
        p0: 1,
        p1: 0,
        p2: 1,
        p3: 0,
        p4: 0,
        p5: 0
    };
}

pub fn wasm_section_encode_b0(sec: WasmSection) -> Int {
    return sec.section_id;
}

pub fn wasm_section_encode_b1(sec: WasmSection) -> Int {
    return wasm_leb128_b0(sec.payload_size);
}

pub fn wasm_section_id_of(sec: WasmSection) -> Int {
    return sec.section_id;
}
