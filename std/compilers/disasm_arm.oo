// # ARM64 / AArch64 Machine Code Disassembler
//
// Logline: Decode 32-bit LE words: NOP, RET, SVC.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type Arm64DisasmState = struct {
    bytes: List[Int],
    pos: Int,
    total_len: Int,
    base_addr: Int,
    last_opcode: Int,
    last_length: Int,
    last_imm: Int
};

pub fn arm64_reg_num(reg_num: Int) -> Int {
    return reg_num & 31;
}

pub fn arm64_disasm_init(code_bytes: List[Int], base_addr: Int) -> Arm64DisasmState {
    return Arm64DisasmState {
        bytes: code_bytes,
        pos: 0,
        total_len: list_len(code_bytes),
        base_addr: base_addr,
        last_opcode: 0,
        last_length: 0,
        last_imm: 0
    };
}

pub fn arm64_disasm_has_more(state: Arm64DisasmState) -> Bool {
    if (state.pos + 4) <= state.total_len {
        return true;
    }
    return false;
}

pub fn arm64_decode_word(word: Int) -> Int {
    if word == 3573751839 {
        return 1;
    }
    if word == 3596551104 {
        return 2;
    }
    if word == 3556769793 {
        return 3;
    }
    return 0;
}

pub fn arm64_disasm_decode_next(state: Arm64DisasmState) -> Arm64DisasmState {
    if arm64_disasm_has_more(state) == false {
        return Arm64DisasmState {
            bytes: state.bytes,
            pos: state.pos,
            total_len: state.total_len,
            base_addr: state.base_addr,
            last_opcode: 0,
            last_length: 0,
            last_imm: 0
        };
    }
    let b0: Int = list_get(state.bytes, state.pos);
    let b1: Int = list_get(state.bytes, state.pos + 1);
    let b2: Int = list_get(state.bytes, state.pos + 2);
    let b3: Int = list_get(state.bytes, state.pos + 3);
    let word: Int = b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216);
    return Arm64DisasmState {
        bytes: state.bytes,
        pos: state.pos + 4,
        total_len: state.total_len,
        base_addr: state.base_addr,
        last_opcode: word,
        last_length: 4,
        last_imm: arm64_decode_word(word)
    };
}

pub fn arm64_disasm_count(code_bytes: List[Int], base_addr: Int) -> Int {
    let mut state: Arm64DisasmState = arm64_disasm_init(code_bytes, base_addr);
    let mut n: Int = 0;
    while arm64_disasm_has_more(state) {
        state = arm64_disasm_decode_next(state);
        n = n + 1;
    }
    return n;
}
