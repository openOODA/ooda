// residual: List[struct] destubbed to Int floor.

type WasmLimits = struct {
    min: Int,
    max: Int,
    has_max: Int
};

pub fn wasm_limits_new(min: Int, max: Int, has_max: Int) -> WasmLimits {
    return WasmLimits {
        min: min,
        max: max,
        has_max: has_max
    };
}

pub fn wasm_limits_min(l: WasmLimits) -> Int {
    return l.min;
}
