// # C Header Lexical Analyzer
//
// Logline: Token kinds, ASCII punct map, packed-ident keyword table.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; String flattened to packed Int; by-value.

type CToken = struct {
    kind: Int,
    line: Int,
    col: Int,
    ch: Int
};

type CLexerState = struct {
    pos: Int,
    line: Int,
    col: Int,
    last_kind: Int,
    last_ch: Int
};

pub fn c_tok_eof() -> Int {
    return 0;
}

pub fn c_tok_ident() -> Int {
    return 1;
}

pub fn c_tok_int_lit() -> Int {
    return 2;
}

pub fn c_tok_str_lit() -> Int {
    return 3;
}

pub fn c_tok_kw_typedef() -> Int {
    return 6;
}

pub fn c_tok_kw_struct() -> Int {
    return 7;
}

pub fn c_tok_kw_union() -> Int {
    return 8;
}

pub fn c_tok_kw_enum() -> Int {
    return 9;
}

pub fn c_tok_kw_const() -> Int {
    return 10;
}

pub fn c_tok_kw_extern() -> Int {
    return 11;
}

pub fn c_tok_kw_void() -> Int {
    return 12;
}

pub fn c_tok_kw_int() -> Int {
    return 13;
}

pub fn c_tok_kw_char() -> Int {
    return 14;
}

pub fn c_tok_kw_float() -> Int {
    return 15;
}

pub fn c_tok_lbrace() -> Int {
    return 17;
}

pub fn c_tok_rbrace() -> Int {
    return 18;
}

pub fn c_tok_lparen() -> Int {
    return 19;
}

pub fn c_tok_rparen() -> Int {
    return 20;
}

pub fn c_tok_lbracket() -> Int {
    return 21;
}

pub fn c_tok_rbracket() -> Int {
    return 22;
}

pub fn c_tok_semicolon() -> Int {
    return 23;
}

pub fn c_tok_comma() -> Int {
    return 24;
}

pub fn c_tok_star() -> Int {
    return 25;
}

pub fn c_tok_hash() -> Int {
    return 26;
}

pub fn c_tok_equal() -> Int {
    return 27;
}

pub fn c_lexer_pack4(a: Int, b: Int, c: Int, d: Int) -> Int {
    let b0: Int = a & 255;
    let b1: Int = (b & 255) * 256;
    let b2: Int = (c & 255) * 65536;
    let b3: Int = (d & 255) * 16777216;
    return ((b0 + b1) + b2) + b3;
}

pub fn c_lexer_punct_kind(ch: Int) -> Int {
    if ch == 123 {
        return 17;
    }
    if ch == 125 {
        return 18;
    }
    if ch == 40 {
        return 19;
    }
    if ch == 41 {
        return 20;
    }
    if ch == 91 {
        return 21;
    }
    if ch == 93 {
        return 22;
    }
    if ch == 59 {
        return 23;
    }
    if ch == 44 {
        return 24;
    }
    if ch == 42 {
        return 25;
    }
    if ch == 35 {
        return 26;
    }
    if ch == 61 {
        return 27;
    }
    return 0;
}

pub fn c_lexer_keyword_kind(packed: Int, nchars: Int) -> Int {
    if nchars == 7 {
        if packed == 1701869940 {
            return 6;
        }
    }
    if nchars == 6 {
        if packed == 1970435187 {
            return 7;
        }
        if packed == 1702131813 {
            return 11;
        }
    }
    if nchars == 5 {
        if packed == 1869180533 {
            return 8;
        }
        if packed == 1936617315 {
            return 10;
        }
        if packed == 1634693222 {
            return 15;
        }
    }
    if nchars == 4 {
        if packed == 1836412517 {
            return 9;
        }
        if packed == 1684631414 {
            return 12;
        }
        if packed == 1918986339 {
            return 14;
        }
    }
    if nchars == 3 {
        if packed == 7630441 {
            return 13;
        }
    }
    return 1;
}

pub fn c_token_new(kind: Int, line: Int, col: Int, ch: Int) -> CToken {
    return CToken {
        kind: kind,
        line: line,
        col: col,
        ch: ch
    };
}

pub fn c_lexer_init() -> CLexerState {
    return CLexerState {
        pos: 0,
        line: 1,
        col: 1,
        last_kind: 0,
        last_ch: 0
    };
}

pub fn c_lexer_take_punct(st: CLexerState, ch: Int) -> CLexerState {
    let k: Int = c_lexer_punct_kind(ch);
    return CLexerState {
        pos: st.pos + 1,
        line: st.line,
        col: st.col + 1,
        last_kind: k,
        last_ch: ch
    };
}

pub fn c_lexer_last_kind(st: CLexerState) -> Int {
    return st.last_kind;
}
