// # x86_64 Machine Code Disassembler
//
// Logline: Decode NOP, RET, SYSCALL, PUSH, POP from a byte stream.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type X86DisasmState = struct {
    bytes: List[Int],
    pos: Int,
    total_len: Int,
    base_addr: Int,
    last_opcode: Int,
    last_length: Int,
    last_reg: Int
};

pub fn x86_reg_id(reg_id: Int) -> Int {
    return reg_id & 15;
}

pub fn x86_disasm_init(code_bytes: List[Int], base_addr: Int) -> X86DisasmState {
    return X86DisasmState {
        bytes: code_bytes,
        pos: 0,
        total_len: list_len(code_bytes),
        base_addr: base_addr,
        last_opcode: 0,
        last_length: 0,
        last_reg: 0
    };
}

pub fn x86_disasm_has_more(state: X86DisasmState) -> Bool {
    if state.pos < state.total_len {
        return true;
    }
    return false;
}

pub fn x86_disasm_decode_next(state: X86DisasmState) -> X86DisasmState {
    if x86_disasm_has_more(state) == false {
        return X86DisasmState {
            bytes: state.bytes,
            pos: state.pos,
            total_len: state.total_len,
            base_addr: state.base_addr,
            last_opcode: 0,
            last_length: 0,
            last_reg: 0
        };
    }
    let b0: Int = list_get(state.bytes, state.pos);
    let pos1: Int = state.pos + 1;
    if b0 == 144 {
        return X86DisasmState {
            bytes: state.bytes,
            pos: pos1,
            total_len: state.total_len,
            base_addr: state.base_addr,
            last_opcode: 144,
            last_length: 1,
            last_reg: 0
        };
    }
    if b0 == 195 {
        return X86DisasmState {
            bytes: state.bytes,
            pos: pos1,
            total_len: state.total_len,
            base_addr: state.base_addr,
            last_opcode: 195,
            last_length: 1,
            last_reg: 0
        };
    }
    if b0 == 15 {
        if pos1 < state.total_len {
            let b1: Int = list_get(state.bytes, pos1);
            if b1 == 5 {
                return X86DisasmState {
                    bytes: state.bytes,
                    pos: pos1 + 1,
                    total_len: state.total_len,
                    base_addr: state.base_addr,
                    last_opcode: 3845,
                    last_length: 2,
                    last_reg: 0
                };
            }
        }
    }
    if b0 >= 80 {
        if b0 <= 87 {
            return X86DisasmState {
                bytes: state.bytes,
                pos: pos1,
                total_len: state.total_len,
                base_addr: state.base_addr,
                last_opcode: b0,
                last_length: 1,
                last_reg: b0 - 80
            };
        }
    }
    if b0 >= 88 {
        if b0 <= 95 {
            return X86DisasmState {
                bytes: state.bytes,
                pos: pos1,
                total_len: state.total_len,
                base_addr: state.base_addr,
                last_opcode: b0,
                last_length: 1,
                last_reg: b0 - 88
            };
        }
    }
    return X86DisasmState {
        bytes: state.bytes,
        pos: pos1,
        total_len: state.total_len,
        base_addr: state.base_addr,
        last_opcode: b0,
        last_length: 1,
        last_reg: 0
    };
}

pub fn x86_disasm_count(code_bytes: List[Int], base_addr: Int) -> Int {
    let mut state: X86DisasmState = x86_disasm_init(code_bytes, base_addr);
    let mut n: Int = 0;
    while x86_disasm_has_more(state) {
        state = x86_disasm_decode_next(state);
        n = n + 1;
    }
    return n;
}
