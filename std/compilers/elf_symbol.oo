// # ELF Symbol Table and Relocations
//
// Logline: Elf64_Sym st_info pack and Elf64_Rela r_info pack.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; String flattened; by-value.

type ElfSymbol64 = struct {
    st_name: Int,
    st_info: Int,
    st_other: Int,
    st_shndx: Int,
    st_value: Int,
    st_size: Int,
    name_id: Int
};

type ElfRela64 = struct {
    r_offset: Int,
    r_info: Int,
    r_addend: Int
};

pub fn elf_stb_local() -> Int {
    return 0;
}

pub fn elf_stb_global() -> Int {
    return 1;
}

pub fn elf_stb_weak() -> Int {
    return 2;
}

pub fn elf_stt_notype() -> Int {
    return 0;
}

pub fn elf_stt_object() -> Int {
    return 1;
}

pub fn elf_stt_func() -> Int {
    return 2;
}

pub fn elf_stt_section() -> Int {
    return 3;
}

pub fn elf_r_x86_64_none() -> Int {
    return 0;
}

pub fn elf_r_x86_64_64() -> Int {
    return 1;
}

pub fn elf_r_x86_64_pc32() -> Int {
    return 2;
}

pub fn elf_r_x86_64_plt32() -> Int {
    return 4;
}

pub fn elf_st_info(bind: Int, sym_type: Int) -> Int {
    return (bind * 16) + (sym_type & 15);
}

pub fn elf_st_bind(info: Int) -> Int {
    return info / 16;
}

pub fn elf_st_type(info: Int) -> Int {
    return info & 15;
}

pub fn elf_r_info(sym_index: Int, reloc_type: Int) -> Int {
    return (sym_index * 256) + (reloc_type & 255);
}

pub fn elf_r_sym(info: Int) -> Int {
    return info / 256;
}

pub fn elf_r_type(info: Int) -> Int {
    return info & 255;
}

pub fn elf_symbol64_new(name_id: Int, bind: Int, sym_type: Int, shndx: Int, value: Int, size: Int) -> ElfSymbol64 {
    let info: Int = elf_st_info(bind, sym_type);
    return ElfSymbol64 {
        st_name: 0,
        st_info: info,
        st_other: 0,
        st_shndx: shndx,
        st_value: value,
        st_size: size,
        name_id: name_id
    };
}

pub fn elf_symbol64_function(name_id: Int, shndx: Int, value: Int, size: Int) -> ElfSymbol64 {
    return elf_symbol64_new(name_id, 1, 2, shndx, value, size);
}

pub fn elf_symbol64_object(name_id: Int, shndx: Int, value: Int, size: Int) -> ElfSymbol64 {
    return elf_symbol64_new(name_id, 1, 1, shndx, value, size);
}

pub fn elf_rela64_new(offset: Int, sym_index: Int, reloc_type: Int, addend: Int) -> ElfRela64 {
    let info: Int = elf_r_info(sym_index, reloc_type);
    return ElfRela64 {
        r_offset: offset,
        r_info: info,
        r_addend: addend
    };
}

pub fn elf_symbol64_info(sym: ElfSymbol64) -> Int {
    return sym.st_info;
}

pub fn elf_rela64_info(rel: ElfRela64) -> Int {
    return rel.r_info;
}
