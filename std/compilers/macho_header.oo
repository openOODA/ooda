// # Mach-O 64-bit Header
//
// Logline: MH_MAGIC_64, CPU types, MH_EXECUTE flags.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type / &ref destubbed to type + by-value.

type MachOHeader64 = struct {
    magic: Int,
    cputype: Int,
    cpusubtype: Int,
    filetype: Int,
    ncmds: Int,
    sizeofcmds: Int,
    flags: Int,
    reserved: Int
};

pub fn macho_magic_64() -> Int {
    return 4277009103;
}

pub fn macho_cputype_arm64() -> Int {
    return 16777228;
}

pub fn macho_cputype_x86_64() -> Int {
    return 16777223;
}

pub fn macho_filetype_object() -> Int {
    return 1;
}

pub fn macho_filetype_execute() -> Int {
    return 2;
}

pub fn macho_filetype_dylib() -> Int {
    return 6;
}

pub fn macho_header64_new(cputype: Int, filetype: Int, flags: Int) -> MachOHeader64 {
    return MachOHeader64 {
        magic: macho_magic_64(),
        cputype: cputype,
        cpusubtype: 0,
        filetype: filetype,
        ncmds: 0,
        sizeofcmds: 0,
        flags: flags,
        reserved: 0
    };
}

pub fn macho_header64_arm64_exec() -> MachOHeader64 {
    let flags: Int = 2097285;
    return macho_header64_new(macho_cputype_arm64(), macho_filetype_execute(), flags);
}

pub fn macho_header64_x86_64_exec() -> MachOHeader64 {
    let flags: Int = 2097285;
    return macho_header64_new(macho_cputype_x86_64(), macho_filetype_execute(), flags);
}

pub fn macho_header64_magic_b0() -> Int {
    return 207;
}

pub fn macho_header64_cputype(h: MachOHeader64) -> Int {
    return h.cputype;
}

pub fn macho_header64_validate(h: MachOHeader64) -> Int {
    if h.magic != macho_magic_64() {
        return 0;
    }
    if h.filetype < 1 {
        return 0;
    }
    return 1;
}

pub fn macho_header64_to_bytes(h: MachOHeader64) -> List[Int] {
    let mut b: List[Int] = list_new();
    b = list_push(b, 207);
    b = list_push(b, 250);
    b = list_push(b, 237);
    b = list_push(b, 254);
    b = list_push(b, h.cputype & 255);
    b = list_push(b, (h.cputype / 256) & 255);
    b = list_push(b, (h.cputype / 65536) & 255);
    b = list_push(b, (h.cputype / 16777216) & 255);
    b = list_push(b, h.cpusubtype & 255);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, h.filetype & 255);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, h.ncmds & 255);
    b = list_push(b, (h.ncmds / 256) & 255);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, h.sizeofcmds & 255);
    b = list_push(b, (h.sizeofcmds / 256) & 255);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, h.flags & 255);
    b = list_push(b, (h.flags / 256) & 255);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, 0);
    b = list_push(b, 0);
    return b;
}
