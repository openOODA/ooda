// # LLVM IR Instruction Builder
//
// Logline: LLVM opcode table, type kinds, SSA temp counter.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; List[struct]/String flattened; by-value.

type LLVMBuilder = struct {
    next_temp_id: Int,
    last_opcode: Int,
    last_type_kind: Int,
    last_predicate: Int,
    emitted_n: Int
};

pub fn llvm_opcode_ret() -> Int {
    return 0;
}

pub fn llvm_opcode_br() -> Int {
    return 1;
}

pub fn llvm_opcode_cond_br() -> Int {
    return 2;
}

pub fn llvm_opcode_add() -> Int {
    return 3;
}

pub fn llvm_opcode_sub() -> Int {
    return 4;
}

pub fn llvm_opcode_mul() -> Int {
    return 5;
}

pub fn llvm_opcode_sdiv() -> Int {
    return 6;
}

pub fn llvm_opcode_udiv() -> Int {
    return 7;
}

pub fn llvm_opcode_alloca() -> Int {
    return 8;
}

pub fn llvm_opcode_load() -> Int {
    return 9;
}

pub fn llvm_opcode_store() -> Int {
    return 10;
}

pub fn llvm_opcode_icmp() -> Int {
    return 11;
}

pub fn llvm_opcode_call() -> Int {
    return 12;
}

pub fn llvm_type_void_kind() -> Int {
    return 0;
}

pub fn llvm_type_i1_kind() -> Int {
    return 1;
}

pub fn llvm_type_i8_kind() -> Int {
    return 2;
}

pub fn llvm_type_i16_kind() -> Int {
    return 3;
}

pub fn llvm_type_i32_kind() -> Int {
    return 4;
}

pub fn llvm_type_i64_kind() -> Int {
    return 5;
}

pub fn llvm_pred_eq() -> Int {
    return 0;
}

pub fn llvm_pred_ne() -> Int {
    return 1;
}

pub fn llvm_pred_sgt() -> Int {
    return 6;
}

pub fn llvm_pred_slt() -> Int {
    return 8;
}

pub fn llvm_builder_new() -> LLVMBuilder {
    return LLVMBuilder {
        next_temp_id: 1,
        last_opcode: 0,
        last_type_kind: 0,
        last_predicate: 0,
        emitted_n: 0
    };
}

pub fn llvm_builder_emit(b: LLVMBuilder, opcode: Int, type_kind: Int, pred: Int) -> LLVMBuilder {
    return LLVMBuilder {
        next_temp_id: b.next_temp_id,
        last_opcode: opcode,
        last_type_kind: type_kind,
        last_predicate: pred,
        emitted_n: b.emitted_n + 1
    };
}

pub fn llvm_builder_emit_ssa(b: LLVMBuilder, opcode: Int, type_kind: Int) -> LLVMBuilder {
    let e: LLVMBuilder = llvm_builder_emit(b, opcode, type_kind, 0);
    return LLVMBuilder {
        next_temp_id: e.next_temp_id + 1,
        last_opcode: e.last_opcode,
        last_type_kind: e.last_type_kind,
        last_predicate: e.last_predicate,
        emitted_n: e.emitted_n
    };
}

pub fn llvm_build_alloca(b: LLVMBuilder, type_kind: Int) -> LLVMBuilder {
    return llvm_builder_emit_ssa(b, 8, type_kind);
}

pub fn llvm_build_load(b: LLVMBuilder, type_kind: Int) -> LLVMBuilder {
    return llvm_builder_emit_ssa(b, 9, type_kind);
}

pub fn llvm_build_store(b: LLVMBuilder) -> LLVMBuilder {
    return llvm_builder_emit(b, 10, 0, 0);
}

pub fn llvm_build_add(b: LLVMBuilder) -> LLVMBuilder {
    return llvm_builder_emit_ssa(b, 3, 4);
}

pub fn llvm_build_sub(b: LLVMBuilder) -> LLVMBuilder {
    return llvm_builder_emit_ssa(b, 4, 4);
}

pub fn llvm_build_mul(b: LLVMBuilder) -> LLVMBuilder {
    return llvm_builder_emit_ssa(b, 5, 4);
}

pub fn llvm_build_icmp(b: LLVMBuilder, pred: Int) -> LLVMBuilder {
    let e: LLVMBuilder = llvm_builder_emit(b, 11, 1, pred);
    return LLVMBuilder {
        next_temp_id: e.next_temp_id + 1,
        last_opcode: e.last_opcode,
        last_type_kind: e.last_type_kind,
        last_predicate: e.last_predicate,
        emitted_n: e.emitted_n
    };
}

pub fn llvm_build_br(b: LLVMBuilder) -> LLVMBuilder {
    return llvm_builder_emit(b, 1, 0, 0);
}

pub fn llvm_build_cond_br(b: LLVMBuilder) -> LLVMBuilder {
    return llvm_builder_emit(b, 2, 0, 0);
}

pub fn llvm_build_ret(b: LLVMBuilder, type_kind: Int) -> LLVMBuilder {
    return llvm_builder_emit(b, 0, type_kind, 0);
}

pub fn llvm_build_ret_void(b: LLVMBuilder) -> LLVMBuilder {
    return llvm_build_ret(b, 0);
}

pub fn llvm_build_call(b: LLVMBuilder, ret_type: Int) -> LLVMBuilder {
    return llvm_builder_emit_ssa(b, 12, ret_type);
}

pub fn llvm_builder_last_opcode(b: LLVMBuilder) -> Int {
    return b.last_opcode;
}

pub fn llvm_builder_temp(b: LLVMBuilder) -> Int {
    return b.next_temp_id;
}
