// # Mach-O 64-bit Segments & Load Commands
//
// Logline: LC_SEGMENT_64, VM_PROT bits, 72-byte segment_command_64.
// residual: pub type destubbed; String/List flattened; by-value.

type MachOSection64 = struct {
    name_id: Int,
    seg_id: Int,
    addr: Int,
    size: Int,
    offset: Int,
    align_pow: Int,
    flags: Int
};

type MachOSegment64 = struct {
    cmd: Int,
    cmdsize: Int,
    name_id: Int,
    vmaddr: Int,
    vmsize: Int,
    fileoff: Int,
    filesize: Int,
    maxprot: Int,
    initprot: Int,
    nsects: Int,
    flags: Int
};

type MachOLoadCommand = struct {
    cmd: Int,
    cmdsize: Int
};

pub fn macho_lc_segment_64() -> Int {
    return 25;
}

pub fn macho_lc_symtab() -> Int {
    return 2;
}

pub fn macho_lc_dysymtab() -> Int {
    return 11;
}

pub fn macho_lc_load_dylinker() -> Int {
    return 14;
}

pub fn macho_prot_read() -> Int {
    return 1;
}

pub fn macho_prot_write() -> Int {
    return 2;
}

pub fn macho_prot_execute() -> Int {
    return 4;
}

pub fn macho_segment_command64_bytes() -> Int {
    return 72;
}

pub fn macho_segment64_new(name_id: Int, vmaddr: Int, vmsize: Int, fileoff: Int, filesize: Int, initprot: Int) -> MachOSegment64 {
    return MachOSegment64 {
        cmd: 25,
        cmdsize: 72,
        name_id: name_id,
        vmaddr: vmaddr,
        vmsize: vmsize,
        fileoff: fileoff,
        filesize: filesize,
        maxprot: 7,
        initprot: initprot,
        nsects: 0,
        flags: 0
    };
}

pub fn macho_segment64_pagezero() -> MachOSegment64 {
    return macho_segment64_new(1, 0, 4294967296, 0, 0, 0);
}

pub fn macho_segment64_text(vmaddr: Int, size: Int, fileoff: Int) -> MachOSegment64 {
    let prot: Int = 5;
    return macho_segment64_new(2, vmaddr, size, fileoff, size, prot);
}

pub fn macho_segment64_data(vmaddr: Int, size: Int, fileoff: Int) -> MachOSegment64 {
    let prot: Int = 3;
    return macho_segment64_new(3, vmaddr, size, fileoff, size, prot);
}

pub fn macho_section64_new(name_id: Int, seg_id: Int, flags: Int) -> MachOSection64 {
    return MachOSection64 {
        name_id: name_id,
        seg_id: seg_id,
        addr: 0,
        size: 0,
        offset: 0,
        align_pow: 3,
        flags: flags
    };
}

pub fn macho_load_command_new(cmd: Int, cmdsize: Int) -> MachOLoadCommand {
    return MachOLoadCommand {
        cmd: cmd,
        cmdsize: cmdsize
    };
}

pub fn macho_segment64_cmd(s: MachOSegment64) -> Int {
    return s.cmd;
}

pub fn macho_segment64_initprot(s: MachOSegment64) -> Int {
    return s.initprot;
}
