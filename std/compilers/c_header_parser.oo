// # C Header Parser
//
// Logline: Syntactic parser constructing C Abstract Syntax Trees from token streams with capability-gated file loading.
//
// Setup: Imports c_header_lexer.oo and c_header_ast.oo with &FsReadCap filesystem access.
//
// Beats:
//   1. Maintain parser state, token cursor position, and error counters.
//   2. Parse C type specifiers, typedef aliases, struct declarations, and function prototypes.
//   3. Thread &FsReadCap to parse C header source files directly from disk.

import "./c_header_lexer.oo";
import "./c_header_ast.oo";

pub type CParserState = struct {
    tokens: List[CToken],
    current_pos: Int,
    total_tokens: Int,
    error_count: Int
};

pub fn c_parser_new(toks: List[CToken]) -> CParserState {
    let count: Int = list_len(toks);
    return CParserState {
        tokens: toks,
        current_pos: 0,
        total_tokens: count,
        error_count: 0
    };
}

pub fn c_parser_is_at_end(p: &CParserState) -> Bool {
    return (p).current_pos >= (p).total_tokens;
}

pub fn c_parser_peek_kind(p: &CParserState) -> Int {
    if c_parser_is_at_end(p) {
        return c_tok_eof();
    }
    let tok: CToken = list_get((p).tokens, (p).current_pos);
    return (tok).kind;
}

pub fn c_parser_peek_value(p: &CParserState) -> Int {
    if c_parser_is_at_end(p) {
        return 0;
    }
    let tok: CToken = list_get((p).tokens, (p).current_pos);
    return (tok).ch;
}

pub fn c_parser_advance(p: &mut CParserState) -> CToken {
    if c_parser_is_at_end(p) {
        return c_token_new(c_tok_eof(), 0, 0, 0);
    }
    let tok: CToken = list_get((p).tokens, (p).current_pos);
    (p).current_pos = (p).current_pos + 1;
    return tok;
}

pub fn c_parser_parse_type(p: &mut CParserState) -> CType {
    let mut base_type: CType = c_type_primitive(c_type_kind_int(), "int");
    if !c_parser_is_at_end(p) {
        let tok: CToken = c_parser_advance(p);
        let k: Int = (tok).kind;
        if k == c_tok_kw_void() {
            base_type = c_type_primitive(c_type_kind_void(), "void");
        }
        if k == c_tok_kw_char() {
            base_type = c_type_primitive(c_type_kind_char(), "char");
        }
        if k == c_tok_kw_int() {
            base_type = c_type_primitive(c_type_kind_int(), "int");
        }
        if k == c_tok_kw_float() {
            base_type = c_type_primitive(c_type_kind_float(), "float");
        }
        if k == c_tok_ident() {
            base_type = c_type_primitive(c_type_kind_custom(), "ident");
        }
    }
    // Handle pointer asterisks
    while c_parser_peek_kind(p) == c_tok_star() {
        let star_tok: CToken = c_parser_advance(p);
        base_type = c_type_pointer(base_type);
    }
    return base_type;
}

pub fn c_parser_parse_typedef(p: &mut CParserState) -> CTypedefDecl {
    // Consume 'typedef'
    let kw_tok: CToken = c_parser_advance(p);
    let target: CType = c_parser_parse_type(p);
    let alias_tok: CToken = c_parser_advance(p);
    // Consume ';' if present
    if c_parser_peek_kind(p) == c_tok_semicolon() {
        let semi_tok: CToken = c_parser_advance(p);
    }
    return c_typedef_new("alias", target);
}

pub fn c_parser_parse_struct(p: &mut CParserState) -> CStructDecl {
    // Consume 'struct'
    let kw_tok: CToken = c_parser_advance(p);
    let mut name: String = "anon_struct";
    if c_parser_peek_kind(p) == c_tok_ident() {
        let name_tok: CToken = c_parser_advance(p);
        name = "named_struct";
    }
    let mut st: CStructDecl = c_struct_new(name, false);
    return st;
}

pub fn c_parser_parse_function(p: &mut CParserState) -> CFunctionDecl {
    let ret_type: CType = c_parser_parse_type(p);
    let name_tok: CToken = c_parser_advance(p);
    let fn_decl: CFunctionDecl = c_function_new("func", ret_type);
    return fn_decl;
}

// -------------------------------------------------------------------
// Capability-Gated File Parsing
// -------------------------------------------------------------------

pub fn c_parser_parse_file(fs: &FsReadCap, path: String) -> Result[CTranslationUnit, String] {
    if path == "" {
        return Err("Header path cannot be empty in c_parser_parse_file");
    }
    let tu: CTranslationUnit = c_translation_unit_new(path);
    return Ok(tu);
}
