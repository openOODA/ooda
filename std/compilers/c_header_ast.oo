// # C Header Abstract Syntax Tree
//
// Logline: Abstract Syntax Tree (AST) definitions for C types, struct layouts, enum declarations, and function signatures.
//
// Setup: Pure data structures representing parsed C header definitions and translation units.
//
// Beats:
//   1. Define C types, pointer indirection levels, and struct field definitions.
//   2. Define struct, union, enum, and function prototype declarations.
//   3. Define translation unit container aggregating parsed header symbols.

pub type CType = struct {
    kind: Int,
    type_name: String,
    pointer_depth: Int,
    array_size: Int,
    is_const: Bool,
    is_unsigned: Bool
};

pub type CField = struct {
    field_name: String,
    field_type: CType,
    offset_bytes: Int,
    bit_width: Int
};

pub type CStructDecl = struct {
    tag_name: String,
    is_union: Bool,
    fields: List[CField],
    field_count: Int,
    size_bytes: Int,
    alignment: Int
};

pub type CEnumVariant = struct {
    name: String,
    value: Int,
    has_explicit_val: Bool
};

pub type CEnumDecl = struct {
    enum_name: String,
    variants: List[CEnumVariant],
    variant_count: Int
};

pub type CParam = struct {
    param_name: String,
    param_type: CType
};

pub type CFunctionDecl = struct {
    name: String,
    return_type: CType,
    params: List[CParam],
    param_count: Int,
    is_variadic: Bool,
    is_extern: Bool
};

pub type CTypedefDecl = struct {
    alias_name: String,
    target_type: CType
};

pub type CTranslationUnit = struct {
    file_name: String,
    structs: List[CStructDecl],
    struct_count: Int,
    functions: List[CFunctionDecl],
    function_count: Int,
    enums: List[CEnumDecl],
    enum_count: Int,
    typedefs: List[CTypedefDecl],
    typedef_count: Int
};

// -------------------------------------------------------------------
// Type Kind Constants
// -------------------------------------------------------------------

pub fn c_type_kind_void() -> Int { return 0; }
pub fn c_type_kind_int() -> Int { return 1; }
pub fn c_type_kind_char() -> Int { return 2; }
pub fn c_type_kind_short() -> Int { return 3; }
pub fn c_type_kind_long() -> Int { return 4; }
pub fn c_type_kind_float() -> Int { return 5; }
pub fn c_type_kind_double() -> Int { return 6; }
pub fn c_type_kind_struct() -> Int { return 7; }
pub fn c_type_kind_enum() -> Int { return 8; }
pub fn c_type_kind_custom() -> Int { return 11; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn c_type_primitive(kind: Int, name: String) -> CType {
    return CType {
        kind: kind,
        type_name: name,
        pointer_depth: 0,
        array_size: 0,
        is_const: false,
        is_unsigned: false
    };
}

pub fn c_type_pointer(base: CType) -> CType {
    return CType {
        kind: (base).kind,
        type_name: (base).type_name,
        pointer_depth: (base).pointer_depth + 1,
        array_size: (base).array_size,
        is_const: (base).is_const,
        is_unsigned: (base).is_unsigned
    };
}

pub fn c_field_new(name: String, ftype: CType) -> CField {
    return CField {
        field_name: name,
        field_type: ftype,
        offset_bytes: 0,
        bit_width: 0
    };
}

pub fn c_struct_new(name: String, is_union: Bool) -> CStructDecl {
    let mut flds: List[CField] = list_new();
    return CStructDecl {
        tag_name: name,
        is_union: is_union,
        fields: flds,
        field_count: 0,
        size_bytes: 0,
        alignment: 8
    };
}

pub fn c_enum_new(name: String) -> CEnumDecl {
    let mut vars: List[CEnumVariant] = list_new();
    return CEnumDecl {
        enum_name: name,
        variants: vars,
        variant_count: 0
    };
}

pub fn c_param_new(name: String, ptype: CType) -> CParam {
    return CParam {
        param_name: name,
        param_type: ptype
    };
}

pub fn c_function_new(name: String, ret: CType) -> CFunctionDecl {
    let mut ps: List[CParam] = list_new();
    return CFunctionDecl {
        name: name,
        return_type: ret,
        params: ps,
        param_count: 0,
        is_variadic: false,
        is_extern: true
    };
}

pub fn c_typedef_new(alias: String, target: CType) -> CTypedefDecl {
    return CTypedefDecl {
        alias_name: alias,
        target_type: target
    };
}

pub fn c_translation_unit_new(filename: String) -> CTranslationUnit {
    let mut st: List[CStructDecl] = list_new();
    let mut fn_list: List[CFunctionDecl] = list_new();
    let mut en_list: List[CEnumDecl] = list_new();
    let mut td_list: List[CTypedefDecl] = list_new();
    return CTranslationUnit {
        file_name: filename,
        structs: st,
        struct_count: 0,
        functions: fn_list,
        function_count: 0,
        enums: en_list,
        enum_count: 0,
        typedefs: td_list,
        typedef_count: 0
    };
}
