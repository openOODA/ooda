// # WebAssembly Execution Engine
//
// Logline: WASM page 65536, grow-memory old-size, stack frame, ip step.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: pub type destubbed; &mut/Result/String flattened; by-value.

type WasmEngineState = struct {
    engine_tag: Int,
    module_n: Int,
    total_memory_pages: Int,
    is_initialized: Int
};

type WasmInstance = struct {
    module_tag: Int,
    memory_pages: Int,
    ip: Int,
    is_running: Int,
    last_grow_old: Int
};

type WasmStackFrame = struct {
    func_index: Int,
    local_n: Int,
    return_address: Int
};

pub fn wasm_page_bytes() -> Int {
    return 65536;
}

pub fn wasm_engine_init() -> WasmEngineState {
    return WasmEngineState {
        engine_tag: 1,
        module_n: 0,
        total_memory_pages: 0,
        is_initialized: 1
    };
}

pub fn wasm_instance_new(module_tag: Int, pages: Int) -> WasmInstance {
    return WasmInstance {
        module_tag: module_tag,
        memory_pages: pages,
        ip: 0,
        is_running: 0,
        last_grow_old: 0
    };
}

pub fn wasm_engine_instantiate(state: WasmEngineState, module_tag: Int) -> WasmInstance {
    return WasmInstance {
        module_tag: module_tag,
        memory_pages: 1,
        ip: 0,
        is_running: 0,
        last_grow_old: 0
    };
}

pub fn wasm_engine_invoke(inst: WasmInstance, func_index: Int) -> WasmInstance {
    return WasmInstance {
        module_tag: inst.module_tag,
        memory_pages: inst.memory_pages,
        ip: 0,
        is_running: 1,
        last_grow_old: inst.last_grow_old
    };
}

pub fn wasm_engine_step(inst: WasmInstance) -> WasmInstance {
    if inst.is_running == 0 {
        return inst;
    }
    return WasmInstance {
        module_tag: inst.module_tag,
        memory_pages: inst.memory_pages,
        ip: inst.ip + 1,
        is_running: 1,
        last_grow_old: inst.last_grow_old
    };
}

pub fn wasm_engine_grow_memory(inst: WasmInstance, delta_pages: Int) -> WasmInstance {
    if delta_pages < 0 {
        return WasmInstance {
            module_tag: inst.module_tag,
            memory_pages: inst.memory_pages,
            ip: inst.ip,
            is_running: inst.is_running,
            last_grow_old: 0 - 1
        };
    }
    return WasmInstance {
        module_tag: inst.module_tag,
        memory_pages: inst.memory_pages + delta_pages,
        ip: inst.ip,
        is_running: inst.is_running,
        last_grow_old: inst.memory_pages
    };
}

pub fn wasm_stack_frame_new(func_idx: Int, locals: Int, ret_addr: Int) -> WasmStackFrame {
    return WasmStackFrame {
        func_index: func_idx,
        local_n: locals,
        return_address: ret_addr
    };
}

pub fn wasm_instance_pages(inst: WasmInstance) -> Int {
    return inst.memory_pages;
}

pub fn wasm_instance_ip(inst: WasmInstance) -> Int {
    return inst.ip;
}

pub fn wasm_memory_bytes(inst: WasmInstance) -> Int {
    return inst.memory_pages * 65536;
}
