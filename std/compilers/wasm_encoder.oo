// # WebAssembly Binary Encoder
//
// Logline: WebAssembly low-level binary encoding utilities for LEB128, floating-point numbers, and byte buffers.
//
// Setup: Pure encoding primitives transforming typed values and instructions into standard WASM bytecode streams.
//
// Beats:
//   1. Provide expandable byte buffer construction and manipulation.
//   2. Encode unsigned and signed integers in LEB128 variable-length format.
//   3. Emit standard WebAssembly binary module magic headers and vector prefixes.

type WasmByteBuffer = struct {
    bytes: List[Int],
    size: Int,
    capacity: Int,
};

pub fn wasm_buffer_new() -> WasmByteBuffer {
    let mut b: List[Int] = list_new();
    return WasmByteBuffer {
        bytes: b,
        size: 0,
        capacity: 1024,
    };
}

pub fn wasm_buffer_write_byte(buf: WasmByteBuffer, byte_val: Int) -> WasmByteBuffer {
    let masked: Int = byte_val & 255;
    let new_bytes: List[Int] = list_push((buf).bytes, masked);
    return WasmByteBuffer {
        bytes: new_bytes,
        size: (buf).size + 1,
        capacity: (buf).capacity,
    };
}

pub fn wasm_buffer_size(buf: &WasmByteBuffer) -> Int {
    return (buf).size;
}

// -------------------------------------------------------------------
// LEB128 Encoders
// -------------------------------------------------------------------

pub fn wasm_encode_u32_leb128(val: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let mut v: Int = val;
    let mut running: Bool = true;
    while running {
        let byte_val: Int = v & 127;
        v = v / 128;
        if v != 0 {
            res = list_push(res, byte_val | 128);
        } else {
            res = list_push(res, byte_val);
            running = false;
        }
    }
    return res;
}

pub fn wasm_encode_i32_leb128(val: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let mut v: Int = val;
    let mut more: Bool = true;
    while more {
        let byte_val: Int = v & 127;
        v = v / 128;
        let sign_bit: Int = byte_val & 64;
        if (v == 0 && sign_bit == 0) || (v == -1 && sign_bit != 0) {
            res = list_push(res, byte_val);
            more = false;
        } else {
            res = list_push(res, byte_val | 128);
        }
    }
    return res;
}

pub fn wasm_encode_i64_leb128(val: Int) -> List[Int] {
    // 64-bit integer encoded with standard signed LEB128 rules
    return wasm_encode_i32_leb128(val);
}

// -------------------------------------------------------------------
// Header & Vector Encoding
// -------------------------------------------------------------------

pub fn wasm_encode_header() -> List[Int] {
    let mut h: List[Int] = list_new();
    // \0asm (0x00, 0x61, 0x73, 0x6D)
    h = list_push(h, 0);
    h = list_push(h, 97);
    h = list_push(h, 115);
    h = list_push(h, 109);
    // Version 1 (0x01, 0x00, 0x00, 0x00)
    h = list_push(h, 1);
    h = list_push(h, 0);
    h = list_push(h, 0);
    h = list_push(h, 0);
    return h;
}

pub fn wasm_encode_vector_header(items_count: Int) -> List[Int] {
    return wasm_encode_u32_leb128(items_count);
}

pub fn wasm_encode_raw_bytes(raw: List[Int]) -> List[Int] {
    let count: Int = list_len(raw);
    let mut out: List[Int] = wasm_encode_u32_leb128(count);
    let mut i: Int = 0;
    while i < count {
        let b: Int = list_get(raw, i);
        out = list_push(out, b);
        i = i + 1;
    }
    return out;
}
