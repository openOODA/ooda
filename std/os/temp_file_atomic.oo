// # Atomic Temporary File Path Generator Module
//
// Logline: Deterministic unique temporary file and directory path generator using counter tokens and prefixes.
//
// Setup: Pure path generator for atomic filesystem staging.
//
// Beats:
//   1. Generate unique temporary filename from prefix and sequence counter.
//   2. Construct staging swap paths (.tmp suffix).
//   3. Validate temporary path structure.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";
import "std/text/format.oo";

pub fn temp_file_make_name(prefix: String, sequence: Int) -> String {
    let seq_str: String = format_pad_left(format_int_to_hex(sequence), 6, "0");
    return prefix + "_" + seq_str + ".tmp";
}

pub fn temp_file_staging_path(target_path: String, sequence: Int) -> String {
    let seq_str: String = format_pad_left(format_int_to_hex(sequence), 4, "0");
    return target_path + ".tmp." + seq_str;
}
