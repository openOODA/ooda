// # ANSI VT100 Escape Sequence Generator Module
//
// Logline: Pure ANSI VT100 escape code generators for terminal styling, clear screen, colors, and graphics modes.
//
// Setup: Pure string escape formatting module without ambient I/O.
//
// Beats:
//   1. Generate escape prefixes (\x1b[).
//   2. Clear screen and clear line escape commands.
//   3. Terminal color codes (foreground/background).
//   4. Text styles (bold, dim, italic, underline, reset).
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

pub fn ansi_escape_prefix() -> String {
    return "\x1b[";
}

pub fn ansi_reset() -> String {
    return "\x1b[0m";
}

pub fn ansi_bold() -> String {
    return "\x1b[1m";
}

pub fn ansi_dim() -> String {
    return "\x1b[2m";
}

pub fn ansi_italic() -> String {
    return "\x1b[3m";
}

pub fn ansi_underline() -> String {
    return "\x1b[4m";
}

pub fn ansi_clear_screen() -> String {
    return "\x1b[2J\x1b[H";
}

pub fn ansi_clear_line() -> String {
    return "\x1b[2K\r";
}

pub fn ansi_fg_red() -> String {
    return "\x1b[31m";
}

pub fn ansi_fg_green() -> String {
    return "\x1b[32m";
}

pub fn ansi_fg_yellow() -> String {
    return "\x1b[33m";
}

pub fn ansi_fg_blue() -> String {
    return "\x1b[34m";
}

pub fn ansi_fg_cyan() -> String {
    return "\x1b[36m";
}
