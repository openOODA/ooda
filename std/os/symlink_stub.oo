// # Symbolic Link Descriptor Stub Module
//
// Logline: Symbolic link target descriptor model and resolution status under FsCap.
//
// Setup: Structured symbolic link inspection model.
//
// Beats:
//   1. Construct SymlinkDesc with source and target paths.
//   2. Check if symlink is broken or dangling.
//   3. Inspect link target path.
// RULES.oot 1.4: Default-deny for filesystem symlink traversal.
// RULES.oot 1.7: Under 256 lines.
// residual: readlink syscall lowers via host libc.

type SymlinkDesc = struct {
    link_path: String,
    target_path: String,
    is_dangling: Bool
};

pub fn symlink_desc_new(link: String, target: String) -> SymlinkDesc {
    return SymlinkDesc {
        link_path: link,
        target_path: target,
        is_dangling: false
    };
}

pub fn symlink_target(desc: SymlinkDesc) -> String {
    return desc.target_path;
}

pub fn symlink_is_broken(desc: SymlinkDesc) -> Bool {
    return desc.is_dangling;
}
