// # OS Signal Handler Registry Stub Module
//
// Logline: POSIX signal handler registration and disposition dispatcher stub model under ProcessCap.
//
// Setup: Coordinates POSIX signal dispositions (SIGINT, SIGTERM, SIGHUP, SIGUSR1).
//
// Beats:
//   1. Construct SignalRegistry with registered signal dispositions.
//   2. Register signal handler disposition flag.
//   3. Dispatch pending signals.
//   4. Query signal handler status.
// RULES.oot 1.4: Default-deny for OS operations. Explicit &ProcessCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: sigaction syscall lowers via host libc.

import "std/core/list.oo";
import "std/result.oo";

type SignalRegistry = struct {
    handled_signals: List[Int],
    count: Int
};

pub fn signal_registry_new() -> SignalRegistry {
    let sigs: List[Int] = list_new();
    return SignalRegistry {
        handled_signals: sigs,
        count: 0
    };
}

pub fn signal_register(proc: &ProcessCap, reg: SignalRegistry, sig_num: Int) -> SignalRegistry {
    let new_sigs: List[Int] = list_push(reg.handled_signals, sig_num);
    let c: Int = reg.count;
    return SignalRegistry {
        handled_signals: new_sigs,
        count: c + 1
    };
}

pub fn signal_is_registered(reg: SignalRegistry, sig_num: Int) -> Bool {
    let n: Int = reg.count;
    let mut i: Int = 0;
    while i < n {
        let s: Int = list_get(reg.handled_signals, i);
        if s == sig_num { return true; }
        i = i + 1;
    }
    return false;
}
