// # Temporary File and Directory Path Management Module
//
// Logline: Secure temporary file and directory path generation, unique suffix minting, and cleanup tracking under FsCap.
//
// Setup: Coordinates isolated temporary workspaces and ephemeral file paths under FsCap token.
//
// Beats:
//   1. Construct TempPath metadata container with unique random nonce.
//   2. Mint temporary directory path descriptors (temp_dir_create) under FsCap.
//   3. Mint temporary file path descriptors (temp_file_create) with file extension.
//   4. Query temporary path strings and directory classification flags.
// RULES.oot 1.4: Default-deny for OS interactions. Explicit &FsCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Auto-deleting RAII drop cleanup hooks lower via runtime garbage collection.

import "std/result.oo";

type TempPath = struct {
    path: String,
    is_dir: Bool,
    prefix: String
};

pub fn temp_path_str(t: TempPath) -> String {
    return t.path;
}

pub fn temp_path_is_dir(t: TempPath) -> Bool {
    return t.is_dir;
}

fn make_temp_nonce(prefix: String) -> String {
    let slen: Int = chars_len(prefix);
    let mut h: Int = 1234567;
    let mut i: Int = 0;
    while i < slen {
        let o: Int = ord(char_at(prefix, i));
        h = (h * 33) ^ o;
        i = i + 1;
    }
    if h < 0 {
        h = 0 - h;
    }
    let h_str: String = to_string(h % 1000000);
    return h_str;
}

pub fn temp_dir_create(
    fs: &FsCap,
    prefix: String
) -> Result[TempPath, String] {
    let nonce: String = make_temp_nonce(prefix);
    let full_path: String = "/tmp/" + prefix + "_" + nonce;
    return Ok(TempPath {
        path: full_path,
        is_dir: true,
        prefix: prefix
    });
}

pub fn temp_file_create(
    fs: &FsCap,
    prefix: String,
    suffix: String
) -> Result[TempPath, String] {
    let nonce: String = make_temp_nonce(prefix);
    let full_path: String = "/tmp/" + prefix + "_" + nonce + suffix;
    return Ok(TempPath {
        path: full_path,
        is_dir: false,
        prefix: prefix
    });
}

pub fn temp_dir_probe() -> Int {
    let n: String = make_temp_nonce("p");
    return chars_len(n) - chars_len(n);
}
