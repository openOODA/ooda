// ===================================================================
// openOODA Standard Library — std::os::gpu
// ===================================================================
// Path A GpuCap thin wrapper over sealed gpu_launch.
// residual honesty: runtime returns Err ("gpu residual: path A seal only");
// no shaders, no PTX/SPIR-V dispatch, no NPU product path.

pub fn gpu_launch_shader(gpu: &GpuCap, shader: String) -> Result[String, String]
    requires shader.len() > 0
{
    return gpu_launch(gpu, shader);
}
