// # Launch a GPU shader
//
// Logline: gpu_launch_shader forwards one shader name under GpuCap and never talks to a device.
//
// Setup: CAPS.oot names GpuCap. Runtime injects the token. This file does not mint one.
//
// Beats:
//   1. Caller passes &GpuCap and a non-empty shader string.
//   2. gpu_launch_shader forwards to gpu_launch.
//   3. noop and cpu: shaders can Ok; other shaders Err with no device.
//
// residual: no CUDA or device shaders; emit_ptx / emit_spirv stay refuse

pub fn gpu_launch_shader(gpu: &GpuCap, shader: String) -> Result[String, String]
    requires shader.len() > 0
{
    return gpu_launch(gpu, shader);
}
