// ===================================================================
// openOODA Standard Library — std::os::gpu
// ===================================================================
// Path A GpuCap thin wrapper over sealed gpu_launch (M165).
// Honesty:
//   - empty/"noop" → Ok("gpu-noop"); "cpu:add:a:b" → Ok cpu fallthrough
//   - other shaders → Err("gpu residual: no device shaders") — no CUDA/device
//   - emit_ptx / emit_spirv free names stay residual refuse at check

pub fn gpu_launch_shader(gpu: &GpuCap, shader: String) -> Result[String, String]
    requires shader.len() > 0
{
    return gpu_launch(gpu, shader);
}
