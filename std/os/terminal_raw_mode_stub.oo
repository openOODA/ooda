// # Terminal Raw Mode Configuration Stub Module
//
// Logline: Terminal termios raw mode configuration descriptor toggling ECHO, ICANON, and ISIG.
//
// Setup: Terminal descriptor model for raw character-by-character input mode.
//
// Beats:
//   1. Construct RawModeConfig state.
//   2. Enable raw mode flags.
//   3. Disable raw mode and restore cooked mode flags.
// RULES.oot 1.4: Default-deny for OS terminal control.
// RULES.oot 1.7: Under 256 lines.
// residual: tcsetattr / tcgetattr syscalls lower via host libc.

type RawModeConfig = struct {
    echo_enabled: Bool,
    canonical_enabled: Bool,
    is_raw: Bool
};

pub fn raw_mode_config_new() -> RawModeConfig {
    return RawModeConfig {
        echo_enabled: true,
        canonical_enabled: true,
        is_raw: false
    };
}

pub fn raw_mode_enable(cfg: RawModeConfig) -> RawModeConfig {
    return RawModeConfig {
        echo_enabled: false,
        canonical_enabled: false,
        is_raw: true
    };
}

pub fn raw_mode_disable(cfg: RawModeConfig) -> RawModeConfig {
    return RawModeConfig {
        echo_enabled: true,
        canonical_enabled: true,
        is_raw: false
    };
}
