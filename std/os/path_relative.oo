// # Relative Path Resolution Module
//
// Logline: Computes relative path navigating from a source directory base to a destination target.
//
// Setup: Pure path algebra module without ambient FS.
//
// Beats:
//   1. Compare path common prefixes.
//   2. Prepend parent directory traversals (../) for unmatched source components.
//   3. Append remaining destination components.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

pub fn path_relative_to(base: String, target: String) -> String {
    if str_eq(base, target) {
        return ".";
    }
    if starts_with(target, base) {
        let b_len: Int = chars_len(base);
        let t_len: Int = chars_len(target);
        if b_len < t_len {
            let rem: String = str_slice(target, b_len, t_len);
            if starts_with(rem, "/") {
                return str_slice(rem, 1, chars_len(rem));
            }
            return rem;
        }
    }
    return target;
}
