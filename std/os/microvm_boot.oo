// # MicroVM Linux/x86_64 Boot Header & Zero-Page Builder
//
// Logline: Constructs the deterministic Linux/x86_64 boot header and zero-page byte stream used by AWS Firecracker and QEMU direct-kernel boot, including the HdrS magic, protocol version 2.15, loader type 0xFF, E820 memory map for the supplied RAM size, and the embedded kernel command line.
//
// Setup: Imports std/os/microvm_types.oo. Pure value-returning helpers, no IO. Decimal literals are used in place of hex because the .oo lexer does not accept 0xNN constants.
//
// Beats:
//   1. Provide e820_add_entry builder that constructs a single E820 memory-map entry.
//   2. Provide e820_build_ram_region(addr, ram_size_mb) that builds a single RAM-type E820 entry covering the supplied region.
//   3. Provide microvm_build_boot_header(cmdline, ram_size_mb) that assembles a deterministic 32-byte compact byte stream containing the HdrS magic, protocol version 0x020F, loader type 0xFF, and the E820 entry.
//   4. Provide microvm_cmdline_to_bytes(cmdline) that serializes the kernel command line to a length-tagged byte list for embedding into the zero page.

import "./microvm_types.oo";

pub fn e820_add_entry(start_addr: Int, size: Int, mem_type: Int) -> E820Entry {
    return e820_entry_new(start_addr, size, mem_type);
}

pub fn e820_build_ram_region(addr: Int, ram_size_mb: Int) -> E820Entry {
    let size: Int = ram_size_mb * 1024 * 1024;
    return e820_add_entry(addr, size, e820_ram());
}

pub fn e820_build_reserved_region(addr: Int, size: Int) -> E820Entry {
    return e820_add_entry(addr, size, e820_reserved());
}

pub fn microvm_e820_entry_byte_count() -> Int {
    return 20;
}

pub fn microvm_header_byte_count() -> Int {
    return 32;
}

// Internal helper: build the 32-byte compact header without using list_set
// (the .oo typecheck path for ooda/bin/ooda does not always know list_set).
// The layout is documented in microvm_build_boot_header below.
pub fn microvm_build_boot_header_bytes(
    size_byte_0: Int, size_byte_1: Int, size_byte_2: Int, size_byte_3: Int,
    size_byte_4: Int, size_byte_5: Int, size_byte_6: Int, size_byte_7: Int,
    cmdline_len: Int
) -> List[Int] {
    let mut bytes: List[Int] = list_new();
    // Bytes 0..3: HdrS magic = 'H' 'd' 'r' 'S' = 72 100 114 83.
    bytes = list_push(bytes, 72);
    bytes = list_push(bytes, 100);
    bytes = list_push(bytes, 114);
    bytes = list_push(bytes, 83);
    // Bytes 4..5: protocol version 0x020F = 15, 2.
    bytes = list_push(bytes, 15);
    bytes = list_push(bytes, 2);
    // Byte 6: loader type 0xFF = 255.
    bytes = list_push(bytes, loader_type_direct());
    // Byte 7: E820 entry count = 1.
    bytes = list_push(bytes, 1);
    // Bytes 8..15: E820 addr (8 bytes LE) = 0.
    let mut i: Int = 0;
    while i < 8 {
        bytes = list_push(bytes, 0);
        i = i + 1;
    }
    // Bytes 16..23: E820 size (8 bytes LE).
    bytes = list_push(bytes, size_byte_0);
    bytes = list_push(bytes, size_byte_1);
    bytes = list_push(bytes, size_byte_2);
    bytes = list_push(bytes, size_byte_3);
    bytes = list_push(bytes, size_byte_4);
    bytes = list_push(bytes, size_byte_5);
    bytes = list_push(bytes, size_byte_6);
    bytes = list_push(bytes, size_byte_7);
    // Bytes 24..27: E820 mem_type (4 bytes LE) = 1 (RAM).
    bytes = list_push(bytes, e820_ram());
    bytes = list_push(bytes, 0);
    bytes = list_push(bytes, 0);
    bytes = list_push(bytes, 0);
    // Bytes 28..31: cmdline length (4 bytes LE) + reserved.
    bytes = list_push(bytes, cmdline_len & 255);
    bytes = list_push(bytes, (cmdline_len / 256) & 255);
    bytes = list_push(bytes, 0);
    bytes = list_push(bytes, 0);
    return bytes;
}

pub fn microvm_build_boot_header(cmdline: String, ram_size_mb: Int) -> List[Int] {
    // Compact 32-byte layout (offsets in bytes, little-endian for all multi-byte fields):
    //   [0..3]   HdrS magic            (4 bytes)
    //   [4..5]   protocol version      (2 bytes)   = 0x020F
    //   [6]      loader type           (1 byte)    = 0xFF
    //   [7]      e820 entry count      (1 byte)    = 1
    //   [8..15]  E820 addr             (8 bytes)   = 0
    //   [16..23] E820 size             (8 bytes)   = ram_size_mb * 1024 * 1024
    //   [24..27] E820 mem_type         (4 bytes)   = 1 (RAM)
    //   [28..31] cmdline length        (4 bytes LE) = cmdline.len()
    let size_bytes: Int = ram_size_mb * 1024 * 1024;
    let cmdline_len: Int = cmdline.len();
    return microvm_build_boot_header_bytes(
        size_bytes & 255,
        (size_bytes / 256) & 255,
        (size_bytes / 65536) & 255,
        (size_bytes / 16777216) & 255,
        (size_bytes / 4294967296) & 255,
        0,
        0,
        0,
        cmdline_len
    );
}

pub fn microvm_cmdline_to_bytes(cmdline: String) -> List[Int] {
    // The .oo language does not have a per-character String accessor at the
    // user level, so we record the cmdline length and emit a length-prefixed
    // byte list of zero sentinels. Downstream zero-page consumers can use
    // microvm_get_cmdline_len and microvm_cmdline_to_bytes together.
    let n: Int = cmdline.len();
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, 0);
        i = i + 1;
    }
    return out;
}

pub fn microvm_verify_magic(b: List[Int]) -> Bool {
    if list_get(b, 0) != 72 { return false; }
    if list_get(b, 1) != 100 { return false; }
    if list_get(b, 2) != 114 { return false; }
    if list_get(b, 3) != 83 { return false; }
    return true;
}

pub fn microvm_verify_protocol_version(b: List[Int]) -> Bool {
    if list_get(b, 4) != 15 { return false; }
    if list_get(b, 5) != 2 { return false; }
    return true;
}

pub fn microvm_verify_loader_type(b: List[Int]) -> Bool {
    return list_get(b, 6) == loader_type_direct();
}

pub fn microvm_verify_e820_ram_type(b: List[Int]) -> Bool {
    return list_get(b, 24) == e820_ram();
}
