// # Standard I/O Redirection Pipeline Descriptor Module
//
// Logline: Process standard input, standard output, and standard error redirection descriptors.
//
// Setup: Encapsulates standard I/O redirection flags (Inherit, Null, Piped, File).
//
// Beats:
//   1. Construct RedirectionConfig for stdin, stdout, stderr.
//   2. Set redirection target mode (0: Inherit, 1: Pipe, 2: Null, 3: File).
//   3. Inspect configured redirection routes.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type RedirectConfig = struct {
    stdin_mode: Int,
    stdout_mode: Int,
    stderr_mode: Int,
    stdout_file: String
};

pub fn redirect_config_default() -> RedirectConfig {
    return RedirectConfig {
        stdin_mode: 0,
        stdout_mode: 0,
        stderr_mode: 0,
        stdout_file: ""
    };
}

pub fn redirect_pipe_all() -> RedirectConfig {
    return RedirectConfig {
        stdin_mode: 1,
        stdout_mode: 1,
        stderr_mode: 1,
        stdout_file: ""
    };
}

pub fn redirect_stdout_to_file(cfg: RedirectConfig, path: String) -> RedirectConfig {
    return RedirectConfig {
        stdin_mode: cfg.stdin_mode,
        stdout_mode: 3,
        stderr_mode: cfg.stderr_mode,
        stdout_file: path
    };
}
