// # Environment Variables and Shell Expansion Module
//
// Logline: Environment variable dictionary mapping, .env line parser, and $VAR / ${VAR} template string expansion under EnvCap.
//
// Setup: Coordinates environment configuration tables and variable expansion under EnvCap token.
//
// Beats:
//   1. Construct EnvMap dictionary holding key-value strings.
//   2. Parse standard .env format line declarations (env_map_parse_dotenv).
//   3. Expand embedded $VAR and ${VAR} placeholders in string templates.
//   4. Lookup environment values with Result error semantics under EnvCap.
// RULES.oot 1.4: Default-deny for OS access. Explicit &EnvCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: System getenv/setenv process environment mutation lowers via host OS runtime.

import "std/result.oo";

type EnvVarEntry = struct {
    key: String,
    val: String
};

type EnvMap = struct {
    entries: List[EnvVarEntry]
};

pub fn env_map_new() -> EnvMap {
    let empty_entries: List[EnvVarEntry] = list_new();
    return EnvMap {
        entries: empty_entries
    };
}

pub fn env_map_len(m: EnvMap) -> Int {
    return list_len(m.entries);
}

pub fn env_map_get(m: EnvMap, target_key: String) -> Result[String, String] {
    let n: Int = list_len(m.entries);
    let mut i: Int = 0;
    while i < n {
        let e: EnvVarEntry = list_get(m.entries, i);
        let k: String = e.key;
        if k == target_key {
            let v: String = e.val;
            return Ok(v);
        }
        i = i + 1;
    }
    return Err("variable_not_set");
}

pub fn env_map_set(
    cap: &EnvCap,
    m: EnvMap,
    key: String,
    val: String
) -> EnvMap {
    let mut updated: List[EnvVarEntry] = list_new();
    let n: Int = list_len(m.entries);
    let mut found: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let e: EnvVarEntry = list_get(m.entries, i);
        let k: String = e.key;
        if k == key {
            let next_e: EnvVarEntry = EnvVarEntry {
                key: key,
                val: val
            };
            updated = list_push(updated, next_e);
            found = true;
        } else {
            updated = list_push(updated, e);
        }
        i = i + 1;
    }
    if !found {
        let new_e: EnvVarEntry = EnvVarEntry {
            key: key,
            val: val
        };
        updated = list_push(updated, new_e);
    }
    return EnvMap {
        entries: updated
    };
}

pub fn env_map_expand_str(m: EnvMap, template_str: String) -> String {
    let n: Int = chars_len(template_str);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(template_str, i);
        if c == "$" {
            if i + 1 < n && char_at(template_str, i + 1) == "{" {
                // Bracketed ${VAR}
                let mut var_name: String = "";
                let mut j: Int = i + 2;
                while j < n && char_at(template_str, j) != "}" {
                    var_name = var_name + char_at(template_str, j);
                    j = j + 1;
                }
                let r: Result[String, String] = env_map_get(m, var_name);
                if r.is_ok() {
                    let v: String = match r {
                        Ok(x) => x,
                        Err(e) => "",
                    };
                    out = out + v;
                }
                i = j + 1;
            } else {
                // Bare $VAR
                let mut var_name: String = "";
                let mut j: Int = i + 1;
                while j < n {
                    let ch: String = char_at(template_str, j);
                    let o: Int = ord(ch);
                    let is_alnum: Bool = (o >= 65 && o <= 90) || (o >= 97 && o <= 122) || (o >= 48 && o <= 57) || ch == "_";
                    if is_alnum {
                        var_name = var_name + ch;
                        j = j + 1;
                    } else {
                        j = n;
                    }
                }
                let r: Result[String, String] = env_map_get(m, var_name);
                if r.is_ok() {
                    let v: String = match r {
                        Ok(x) => x,
                        Err(e) => "",
                    };
                    out = out + v;
                }
                let vlen: Int = chars_len(var_name);
                i = i + 1 + vlen;
            }
        } else {
            out = out + c;
            i = i + 1;
        }
    }
    return out;
}
