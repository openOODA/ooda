// # Hierarchical Directory Tree Walker State Module
//
// Logline: Directory traversal state tracking visited directory depth, entry queues, and recursive exploration.
//
// Setup: Pure directory walker state representation.
//
// Beats:
//   1. Construct DirWalker with root path and maximum recursion depth.
//   2. Push and pop pending subdirectories.
//   3. Query current traversal depth.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type DirWalker = struct {
    pending_dirs: List[String],
    max_depth: Int,
    current_depth: Int
};

pub fn dir_walker_new(root_path: String, max_depth: Int) -> DirWalker {
    let mut dirs: List[String] = list_new();
    dirs = list_push(dirs, root_path);
    return DirWalker {
        pending_dirs: dirs,
        max_depth: max_depth,
        current_depth: 0
    };
}

pub fn dir_walker_has_pending(w: DirWalker) -> Bool {
    return list_len(w.pending_dirs) > 0;
}

pub fn dir_walker_pending_count(w: DirWalker) -> Int {
    return list_len(w.pending_dirs);
}
