// # Structured Process Spawning Module
//
// Logline: Structured process spawn builder, argument vectors, environment configuration, and execution under ProcessCap.
//
// Setup: Coordinates subprocess launching with argument vectors, working directory, and standard stream capturing under ProcessCap.
//
// Beats:
//   1. Construct ProcessSpawnConfig builder with executable name and argument vector.
//   2. Configure process working directory (process_spawn_cwd) and stream redirection.
//   3. Execute child process under ProcessCap (process_spawn_run).
//   4. Run shell command directly via sh execution wrapper under ProcessCap.
// RULES.oot 1.4: Default-deny for OS interactions. Explicit &ProcessCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: POSIX posix_spawnp and fork/exec lower to host runtime via ProcessCap.

import "std/result.oo";
import "std/os/process.oo";

type ProcessSpawnConfig = struct {
    program: String,
    args: List[String],
    cwd: String,
    capture_stdout: Bool,
    capture_stderr: Bool
};

type ProcessSpawnResult = struct {
    pid: Int,
    status: Int,
    stdout_output: String,
    stderr_output: String,
    success: Bool
};

// Create a new ProcessSpawnConfig builder for program.
pub fn process_spawn_config_new(prog: String) -> ProcessSpawnConfig {
    let empty_args: List[String] = list_new();
    return ProcessSpawnConfig {
        program: prog,
        args: empty_args,
        cwd: ".",
        capture_stdout: true,
        capture_stderr: true
    };
}

// Append command-line argument to configuration.
pub fn process_spawn_arg(cfg: ProcessSpawnConfig, arg: String) -> ProcessSpawnConfig {
    let mut new_args: List[String] = list_new();
    let n: Int = list_len(cfg.args);
    let mut i: Int = 0;
    while i < n {
        new_args = list_push(new_args, list_get(cfg.args, i));
        i = i + 1;
    }
    new_args = list_push(new_args, arg);
    return ProcessSpawnConfig {
        program: cfg.program,
        args: new_args,
        cwd: cfg.cwd,
        capture_stdout: cfg.capture_stdout,
        capture_stderr: cfg.capture_stderr
    };
}

// Set working directory for child process.
pub fn process_spawn_cwd(cfg: ProcessSpawnConfig, dir: String) -> ProcessSpawnConfig {
    return ProcessSpawnConfig {
        program: cfg.program,
        args: cfg.args,
        cwd: dir,
        capture_stdout: cfg.capture_stdout,
        capture_stderr: cfg.capture_stderr
    };
}

// Configure output stream capture flags.
pub fn process_spawn_capture(
    cfg: ProcessSpawnConfig,
    capture_stdout: Bool,
    capture_stderr: Bool
) -> ProcessSpawnConfig {
    return ProcessSpawnConfig {
        program: cfg.program,
        args: cfg.args,
        cwd: cfg.cwd,
        capture_stdout: capture_stdout,
        capture_stderr: capture_stderr
    };
}

// Assemble full command line from program and arguments.
pub fn process_spawn_to_cmd(cfg: ProcessSpawnConfig) -> String {
    let mut out: String = cfg.program;
    let n: Int = list_len(cfg.args);
    let mut i: Int = 0;
    while i < n {
        let arg: String = list_get(cfg.args, i);
        out = out + " " + arg;
        i = i + 1;
    }
    return out;
}

// Spawn and execute configured subprocess under ProcessCap.
pub fn process_spawn_run(
    p: &ProcessCap,
    cfg: ProcessSpawnConfig
) -> Result[ProcessSpawnResult, String] {
    let cmd: String = process_spawn_to_cmd(cfg);
    let r: Result[String, String] = process_exec(p, cmd);
    if r.is_err() {
        let err_msg: String = match r {
            Ok(x) => x,
            Err(y) => y
        };
        return Err(err_msg);
    }
    let out_str: String = match r {
        Ok(x) => x,
        Err(y) => y
    };
    return Ok(ProcessSpawnResult {
        pid: 0,
        status: 0,
        stdout_output: out_str,
        stderr_output: "",
        success: true
    });
}

// Execute arbitrary shell command line under ProcessCap.
pub fn process_spawn_shell(
    p: &ProcessCap,
    command: String
) -> Result[ProcessSpawnResult, String] {
    let cfg: ProcessSpawnConfig = process_spawn_config_new("sh");
    let cfg2: ProcessSpawnConfig = process_spawn_arg(cfg, "-c");
    let cfg3: ProcessSpawnConfig = process_spawn_arg(cfg2, command);
    return process_spawn_run(p, cfg3);
}
