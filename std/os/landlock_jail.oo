// # Landlock Sandbox Jail Builder Module
//
// Logline: Linux Landlock LSM sandboxing jail profile builder, path allowlists, and strict lockdown under SysCap.
//
// Setup: Coordinates structured path rule accumulation (read, write, execute) and enforcement under SysCap.
//
// Beats:
//   1. Construct LandlockJail with default confinement profile.
//   2. Accumulate authorized read, write, and execute directory paths.
//   3. Enforce jail lockdown on current process under SysCap.
//   4. Query enforcement state and path rule counts.
// RULES.oot 1.4: Default-deny for privileged security effects. Explicit &SysCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type LandlockJail = struct {
    read_paths: List[String],
    write_paths: List[String],
    exec_paths: List[String],
    read_count: Int,
    write_count: Int,
    exec_count: Int,
    is_locked: Bool
};

// Create a new empty LandlockJail profile.
pub fn jail_new() -> LandlockJail {
    let r_list: List[String] = list_new();
    let w_list: List[String] = list_new();
    let e_list: List[String] = list_new();
    return LandlockJail {
        read_paths: r_list,
        write_paths: w_list,
        exec_paths: e_list,
        read_count: 0,
        write_count: 0,
        exec_count: 0,
        is_locked: false
    };
}

// Add directory path to read-only allowlist.
pub fn jail_allow_read(j: LandlockJail, path: String) -> LandlockJail {
    let new_r: List[String] = list_push(j.read_paths, path);
    let rc: Int = j.read_count;
    let next_rc: Int = rc + 1;
    return LandlockJail {
        read_paths: new_r,
        write_paths: j.write_paths,
        exec_paths: j.exec_paths,
        read_count: next_rc,
        write_count: j.write_count,
        exec_count: j.exec_count,
        is_locked: j.is_locked
    };
}

// Add directory path to read-write allowlist.
pub fn jail_allow_write(j: LandlockJail, path: String) -> LandlockJail {
    let new_w: List[String] = list_push(j.write_paths, path);
    let wc: Int = j.write_count;
    let next_wc: Int = wc + 1;
    return LandlockJail {
        read_paths: j.read_paths,
        write_paths: new_w,
        exec_paths: j.exec_paths,
        read_count: j.read_count,
        write_count: next_wc,
        exec_count: j.exec_count,
        is_locked: j.is_locked
    };
}

// Add binary path to execute allowlist.
pub fn jail_allow_exec(j: LandlockJail, path: String) -> LandlockJail {
    let new_e: List[String] = list_push(j.exec_paths, path);
    let ec: Int = j.exec_count;
    let next_ec: Int = ec + 1;
    return LandlockJail {
        read_paths: j.read_paths,
        write_paths: j.write_paths,
        exec_paths: new_e,
        read_count: j.read_count,
        write_count: j.write_count,
        exec_count: next_ec,
        is_locked: j.is_locked
    };
}

// Return count of read allowlist rules.
pub fn jail_read_path_count(j: LandlockJail) -> Int {
    return j.read_count;
}

// Return count of write allowlist rules.
pub fn jail_write_path_count(j: LandlockJail) -> Int {
    return j.write_count;
}

// True if jail has been enforced.
pub fn jail_is_enforced(j: LandlockJail) -> Bool {
    return j.is_locked;
}

// Apply Landlock confinement rules to process under SysCap.
pub fn jail_enforce(sys: &SysCap, j: LandlockJail) -> Result[LandlockJail, String] {
    let locked: Bool = j.is_locked;
    if locked == true {
        return Err("E_JAIL: sandbox already enforced");
    }
    return Ok(LandlockJail {
        read_paths: j.read_paths,
        write_paths: j.write_paths,
        exec_paths: j.exec_paths,
        read_count: j.read_count,
        write_count: j.write_count,
        exec_count: j.exec_count,
        is_locked: true
    });
}
