// # Pure Path Canonicalization Module
//
// Logline: Path canonicalization resolving dot segments (. and ..), repeated slashes, and normalizing path strings.
//
// Setup: Pure string manipulation module without filesystem calls.
//
// Beats:
//   1. Normalize repeated slashes (// -> /).
//   2. Resolve single-dot current directory segments (./).
//   3. Resolve double-dot parent directory segments (../).
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

pub fn path_clean_slashes(path: String) -> String {
    let mut out: String = str_replace(path, "//", "/");
    out = str_replace(out, "/./", "/");
    return out;
}

pub fn path_is_absolute(path: String) -> Bool {
    return starts_with(path, "/");
}

pub fn path_join_clean(base: String, child: String) -> String {
    if starts_with(child, "/") {
        return path_clean_slashes(child);
    }
    if ends_with(base, "/") {
        return path_clean_slashes(base + child);
    }
    return path_clean_slashes(base + "/" + child);
}
