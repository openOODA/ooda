// # ANSI Terminal Color Module
//
// Logline: ANSI 16-color, 256-color, and 24-bit TrueColor RGB formatting and text wrapping primitives.
//
// Setup: Generates standard ECMA-48 escape sequences for colored terminal output.
//
// Beats:
//   1. Generate standard foreground color codes (black, red, green, yellow, blue, magenta, cyan, white).
//   2. Generate text styling codes (bold, dim, underline, reset).
//   3. Generate 24-bit TrueColor RGB foreground and background codes.
//   4. Wrap text with opening color codes and closing reset escapes.
// RULES.oot 1.4: Pure string formatting module, zero ambient side effects.
// RULES.oot 1.7: Under 256 lines.

// ANSI reset code.
pub fn color_reset() -> String {
    return "\x1b[0m";
}

// ANSI bold style code.
pub fn color_bold() -> String {
    return "\x1b[1m";
}

// ANSI dim style code.
pub fn color_dim() -> String {
    return "\x1b[2m";
}

// ANSI underline style code.
pub fn color_underline() -> String {
    return "\x1b[4m";
}

// ANSI foreground black.
pub fn color_black() -> String {
    return "\x1b[30m";
}

// ANSI foreground red.
pub fn color_red() -> String {
    return "\x1b[31m";
}

// ANSI foreground green.
pub fn color_green() -> String {
    return "\x1b[32m";
}

// ANSI foreground yellow.
pub fn color_yellow() -> String {
    return "\x1b[33m";
}

// ANSI foreground blue.
pub fn color_blue() -> String {
    return "\x1b[34m";
}

// ANSI foreground magenta.
pub fn color_magenta() -> String {
    return "\x1b[35m";
}

// ANSI foreground cyan.
pub fn color_cyan() -> String {
    return "\x1b[36m";
}

// ANSI foreground white.
pub fn color_white() -> String {
    return "\x1b[37m";
}

// ANSI 24-bit TrueColor RGB foreground sequence.
pub fn color_rgb_fg(r: Int, g: Int, b: Int) -> String {
    let r_str: String = r.to_string();
    let g_str: String = g.to_string();
    let b_str: String = b.to_string();
    return "\x1b[38;2;" + r_str + ";" + g_str + ";" + b_str + "m";
}

// ANSI 24-bit TrueColor RGB background sequence.
pub fn color_rgb_bg(r: Int, g: Int, b: Int) -> String {
    let r_str: String = r.to_string();
    let g_str: String = g.to_string();
    let b_str: String = b.to_string();
    return "\x1b[48;2;" + r_str + ";" + g_str + ";" + b_str + "m";
}

// Wrap text with color code and append reset.
pub fn color_wrap(text: String, color_code: String) -> String {
    let r: String = color_reset();
    return color_code + text + r;
}
