// ===================================================================
// openOODA Standard Library — std::os::process
// ===================================================================
// Thin SysCap wrappers over sealed process free names.
// residual honesty (path A seal):
//   sys_spawn / sys_wait / sys_kill → Err after SysCap re-check
//   (no real fork/wait/kill; seal only).
// Real blocking spawn+wait: process_exec → sys_exec (fork+execvp+waitpid).

pub fn process_spawn(sys: &SysCap, cmd: String) -> Result[String, String]
    requires cmd.len() > 0
{
    return sys_spawn(sys, cmd);
}

pub fn process_wait(sys: &SysCap, pid: Int) -> Result[String, String] {
    return sys_wait(sys, pid);
}

pub fn process_kill(sys: &SysCap, pid: Int, sig: Int) -> Result[String, String] {
    return sys_kill(sys, pid, sig);
}

// Product real process: blocking spawn+wait via sys_exec argv (not residual spawn).
pub fn process_exec(sys: &SysCap, shell_cmd: String) -> Result[String, String]
    requires shell_cmd.len() > 0
{
    return sys_exec(sys, "sh", "-c", shell_cmd);
}

// Honesty probe: residual spawn Err; real exec Ok for true.
pub fn main(sys: &SysCap) {
    let s: Result[String, String] = process_spawn(sys, "true");
    assert_eq!(s.is_err(), true);
    let e: Result[String, String] = process_exec(sys, "true");
    assert_eq!(e.is_ok(), true);
}
