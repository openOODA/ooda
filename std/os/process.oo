// # Process and syscall facade
//
// Logline: ProcessCap wraps spawn, wait, kill, exec, and args; SysCap seals epoll, inotify, and prctl as residual Err.
//
// Setup: Preferred &ProcessCap for process work. Hard Sys residual stays &SysCap. ProcessCap does not become Sys.
//
// Beats:
//   1. process_args, spawn, wait, and kill forward to oo_sys_* under ProcessCap.
//   2. process_exec is the real blocking spawn+wait via sys_exec (sh -c).
//   3. epoll, inotify, and prctl take &SysCap and return residual Err.
//
// residual: sys_spawn / sys_wait / sys_kill → Err after ProcessCap re-check (no real fork/wait/kill; seal only).
// residual: sys_epoll_create / sys_inotify_init / sys_prctl → Err (not full async I/O product).

pub fn process_args(p: &ProcessCap) -> List[String] {
    return oo_sys_args(p);
}

pub fn process_spawn(p: &ProcessCap, cmd: String) -> Result[String, String]
    requires chars_len(cmd) > 0
{
    return oo_sys_spawn(p, cmd);
}

pub fn process_wait(p: &ProcessCap, pid: Int) -> Result[String, String] {
    return oo_sys_wait(p, pid);
}

pub fn process_kill(p: &ProcessCap, pid: Int, sig: Int) -> Result[String, String] {
    return oo_sys_kill(p, pid, sig);
}

// Product real process: blocking spawn+wait via sys_exec argv (not residual spawn).
pub fn process_exec(p: &ProcessCap, shell_cmd: String) -> Result[String, String]
    requires chars_len(shell_cmd) > 0
{
    let r: Result[String, String] = sys_exec(p, "sh", "-c", shell_cmd);
    return r;
}

// M166 path A: OS syscall residual seals under &SysCap (not product async I/O).
pub fn process_epoll_create(sys: &SysCap, flags: Int) -> Result[String, String] {
    return oo_sys_epoll_create(sys, flags);
}

pub fn process_inotify_init(sys: &SysCap) -> Result[String, String] {
    return oo_sys_inotify_init(sys);
}

pub fn process_prctl(sys: &SysCap, option: Int) -> Result[String, String] {
    return oo_sys_prctl(sys, option);
}

// Honesty probe: residual spawn Err; real exec Ok for true; syscall residual Err.
pub fn process_test_main(p: &ProcessCap, sys: &SysCap) {
    let s: Result[String, String] = process_spawn(p, "true");
    assert_eq!(s.is_err(), true);
    let e: Result[String, String] = process_exec(p, "true");
    assert_eq!(e.is_ok(), true);
    let ep: Result[String, String] = process_epoll_create(sys, 0);
    assert_eq!(ep.is_err(), true);
}

pub fn process_probe() -> Int {
    return 0;
}
