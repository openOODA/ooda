// # ANSI Terminal Cursor and Screen Control Module
//
// Logline: ANSI escape sequences for cursor motion, screen clearing, alternate buffers, and viewport geometry.
//
// Setup: Generates standard ECMA-48 escape sequences for terminal screen and cursor control.
//
// Beats:
//   1. Generate cursor positioning sequences (absolute row/col, relative up/down/forward/back).
//   2. Generate screen and line clearing sequences.
//   3. Generate alternate screen buffer enter and exit sequences.
//   4. Generate cursor show and hide sequences.
// RULES.oot 1.4: Pure string formatting module, zero ambient side effects.
// RULES.oot 1.7: Under 256 lines.

type CursorPos = struct {
    row: Int,
    col: Int
};

// Construct a CursorPos value.
pub fn ansi_cursor_pos(row: Int, col: Int) -> CursorPos {
    return CursorPos {
        row: row,
        col: col
    };
}

// Move cursor to absolute 1-indexed row and column.
pub fn ansi_cursor_to(row: Int, col: Int) -> String {
    let r_str: String = row.to_string();
    let c_str: String = col.to_string();
    return "\x1b[" + r_str + ";" + c_str + "H";
}

// Move cursor up n lines.
pub fn ansi_cursor_up(n: Int) -> String {
    let n_str: String = n.to_string();
    return "\x1b[" + n_str + "A";
}

// Move cursor down n lines.
pub fn ansi_cursor_down(n: Int) -> String {
    let n_str: String = n.to_string();
    return "\x1b[" + n_str + "B";
}

// Move cursor forward (right) n columns.
pub fn ansi_cursor_forward(n: Int) -> String {
    let n_str: String = n.to_string();
    return "\x1b[" + n_str + "C";
}

// Move cursor back (left) n columns.
pub fn ansi_cursor_back(n: Int) -> String {
    let n_str: String = n.to_string();
    return "\x1b[" + n_str + "D";
}

// Clear entire screen and home cursor.
pub fn ansi_clear_screen() -> String {
    return "\x1b[2J\x1b[H";
}

// Clear current line.
pub fn ansi_clear_line() -> String {
    return "\x1b[2K\r";
}

// Hide terminal cursor.
pub fn ansi_hide_cursor() -> String {
    return "\x1b[?25l";
}

// Show terminal cursor.
pub fn ansi_show_cursor() -> String {
    return "\x1b[?25h";
}

// Switch to alternate screen buffer.
pub fn ansi_enter_alt_screen() -> String {
    return "\x1b[?1049h";
}

// Exit alternate screen buffer.
pub fn ansi_exit_alt_screen() -> String {
    return "\x1b[?1049l";
}
