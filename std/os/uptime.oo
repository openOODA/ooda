// # High-Resolution System Uptime and Monotonic Timer Module
//
// Logline: High-resolution monotonic timestamp representations, nanosecond delta arithmetic, and human-readable uptime formatting.
//
// Setup: Coordinates elapsed duration tracking and wall-clock interval calculations.
//
// Beats:
//   1. Construct TimeSpec nanosecond-resolution timestamp container.
//   2. Calculate floating-point second deltas between timestamps (timespec_diff_seconds).
//   3. Convert TimeSpec timestamps to integer nanoseconds.
//   4. Format elapsed uptime into human-readable strings (days, hours, minutes, seconds).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Linux clock_gettime(CLOCK_MONOTONIC_RAW) lowers via runtime timer backend.

import "std/math.oo";

type TimeSpec = struct {
    seconds: Int,
    nanoseconds: Int
};

pub fn timespec_new(secs: Int, nanos: Int) -> TimeSpec {
    let mut s: Int = secs;
    let mut n: Int = nanos;
    if n >= 1000000000 {
        let extra_s: Int = n / 1000000000;
        s = s + extra_s;
        n = n % 1000000000;
    }
    return TimeSpec {
        seconds: s,
        nanoseconds: n
    };
}

pub fn timespec_to_nanos(t: TimeSpec) -> Int {
    let s: Int = t.seconds;
    let n: Int = t.nanoseconds;
    return s * 1000000000 + n;
}

pub fn timespec_diff_seconds(t1: TimeSpec, t2: TimeSpec) -> Float {
    let s1: Int = t1.seconds;
    let s2: Int = t2.seconds;
    let ds: Int = s2 - s1;
    let n1: Int = t1.nanoseconds;
    let n2: Int = t2.nanoseconds;
    let dn: Int = n2 - n1;

    let mut ds_f: Float = 0.0;
    let mut count_s: Int = 0;
    let mut abs_ds: Int = ds;
    if abs_ds < 0 { abs_ds = 0 - abs_ds; }
    while count_s < abs_ds {
        ds_f = ds_f + 1.0;
        count_s = count_s + 1;
    }
    if ds < 0 {
        ds_f = 0.0 - ds_f;
    }

    let mut dn_f: Float = 0.0;
    let mut count_n: Int = 0;
    let mut abs_dn: Int = dn / 1000000;
    if abs_dn < 0 { abs_dn = 0 - abs_dn; }
    while count_n < abs_dn {
        dn_f = dn_f + 0.001;
        count_n = count_n + 1;
    }
    if dn < 0 {
        dn_f = 0.0 - dn_f;
    }

    return ds_f + dn_f;
}

pub fn uptime_format_human(uptime_secs: Int) -> String {
    if uptime_secs <= 0 {
        return "0s";
    }
    let days: Int = uptime_secs / 86400;
    let rem_days: Int = uptime_secs % 86400;
    let hours: Int = rem_days / 3600;
    let rem_hours: Int = rem_days % 3600;
    let mins: Int = rem_hours / 60;
    let secs: Int = rem_hours % 60;

    let mut out: String = "";
    if days > 0 {
        out = out + to_string(days) + "d ";
    }
    if hours > 0 || days > 0 {
        out = out + to_string(hours) + "h ";
    }
    if mins > 0 || hours > 0 || days > 0 {
        out = out + to_string(mins) + "m ";
    }
    out = out + to_string(secs) + "s";
    return out;
}
