// # Lock, spawn, and join a thread
//
// Logline: ThreadCap wrappers lock and unlock a mutex slot and spawn or join a named pthread.
//
// Setup: CAPS.oot names ThreadCap. Runtime injects the token. This file does not mint one.
//
// Beats:
//   1. thr_mutex_lock and thr_mutex_unlock forward mid under &ThreadCap.
//   2. thr_spawn forwards a non-empty name to thread_spawn.
//   3. thr_join waits on a non-negative slot via thread_join.
//
// residual: no actor scheduler here; see actor_* free names and sync.oo

pub fn thr_mutex_lock(thread: &ThreadCap, mid: Int) -> Result[String, String] {
    return mutex_lock(thread, mid);
}

pub fn thr_mutex_unlock(thread: &ThreadCap, mid: Int) -> Result[String, String] {
    return mutex_unlock(thread, mid);
}

pub fn thr_spawn(thread: &ThreadCap, name: String) -> Result[String, String]
    requires name.len() > 0
{
    return thread_spawn(thread, name);
}

pub fn thr_join(thread: &ThreadCap, slot: Int) -> Result[String, String]
    requires slot >= 0
{
    return thread_join(thread, slot);
}
