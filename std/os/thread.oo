// ===================================================================
// openOODA Standard Library — std::os::thread
// ===================================================================
// Path A ThreadCap thin wrappers over sealed builtins.
// residual honesty: runtime returns Err ("… residual: path A seal only");
// no OS threads, no real mutexes, no scheduler.

pub fn thr_mutex_lock(thread: &ThreadCap, mid: Int) -> Result[String, String] {
    return mutex_lock(thread, mid);
}

pub fn thr_mutex_unlock(thread: &ThreadCap, mid: Int) -> Result[String, String] {
    return mutex_unlock(thread, mid);
}

pub fn thr_spawn(thread: &ThreadCap, name: String) -> Result[String, String]
    requires name.len() > 0
{
    return thread_spawn(thread, name);
}
