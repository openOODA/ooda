// ===================================================================
// openOODA Standard Library — std::os::cmd
// ===================================================================
// CAP-G4 / process facade: preferred &ProcessCap for spawn/wait/kill/exec.
// Native command builder to avoid `sh -c` string concatenation.

import "std/os/process.oo";

// A command is simply a List[String] where the first element is the program,
// and the subsequent elements are arguments.
pub fn cmd_new(prog: String) -> List[String] {
    let mut cmd: List[String] = list_new();
    cmd = list_push(cmd, prog);
    return cmd;
}

// Add an argument to the command.
pub fn cmd_arg(cmd: List[String], arg: String) -> List[String] {
    return list_push(cmd, arg);
}

// Execute the command directly via sys_exec (without relying on sh -c).
// We map the List[String] into sys_exec variadic arguments.
pub fn cmd_execute(cmd: List[String], p: &ProcessCap) -> Result[String, String] {
    let n = list_len(cmd);
    if n == 0 {
        return Err("empty command");
    }
    
    let prog = list_get(cmd, 0);
    
    // openOODA sys_exec requires explicit arity due to lack of variadic lists.
    // For now, we support up to 5 arguments. For a real robust API, we should 
    // update the compiler to allow passing a List[String] directly to sys_exec.
    if n == 1 {
        return sys_exec(p, prog);
    } else if n == 2 {
        return sys_exec(p, prog, list_get(cmd, 1));
    } else if n == 3 {
        return sys_exec(p, prog, list_get(cmd, 1), list_get(cmd, 2));
    } else if n == 4 {
        return sys_exec(p, prog, list_get(cmd, 1), list_get(cmd, 2), list_get(cmd, 3));
    } else if n == 5 {
        return sys_exec(p, prog, list_get(cmd, 1), list_get(cmd, 2), list_get(cmd, 3), list_get(cmd, 4));
    }
    
    // Fallback: use process_exec (sh -c) with joined arguments if > 5.
    let mut i = 1;
    let mut joined = prog;
    while i < n {
        joined = joined + " " + list_get(cmd, i);
        i = i + 1;
    }
    return process_exec(p, joined);
}
