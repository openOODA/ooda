// # Advisory File Locking (flock / fcntl) Module
//
// Logline: Advisory file locking primitives, shared reader locks, exclusive writer locks, and unlock lifecycles under FsCap.
//
// Setup: Coordinates cooperative file system synchronization across processes under FsCap token.
//
// Beats:
//   1. Construct FileLock state descriptor for target filesystem path.
//   2. Acquire shared non-exclusive reader lock (file_lock_acquire_shared) under FsCap.
//   3. Acquire exclusive writer lock (file_lock_acquire_exclusive) under FsCap.
//   4. Release file locks and inspect active lock status.
// RULES.oot 1.4: Default-deny for OS interactions. Explicit &FsCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Linux flock / fcntl F_SETLK system calls lower via host filesystem driver.

import "std/result.oo";

type FileLock = struct {
    path: String,
    is_exclusive: Bool,
    is_locked: Bool
};

pub fn file_lock_new(target_path: String) -> FileLock {
    return FileLock {
        path: target_path,
        is_exclusive: false,
        is_locked: false
    };
}

pub fn file_lock_is_active(lock: FileLock) -> Bool {
    return lock.is_locked;
}

pub fn file_lock_is_exclusive(lock: FileLock) -> Bool {
    return lock.is_exclusive;
}

pub fn file_lock_acquire_shared(
    fs: &FsCap,
    lock: FileLock
) -> Result[FileLock, String] {
    let locked: Bool = lock.is_locked;
    let excl: Bool = lock.is_exclusive;
    if locked && excl {
        return Err("exclusive_lock_held");
    }
    return Ok(FileLock {
        path: lock.path,
        is_exclusive: false,
        is_locked: true
    });
}

pub fn file_lock_acquire_exclusive(
    fs: &FsCap,
    lock: FileLock
) -> Result[FileLock, String] {
    let locked: Bool = lock.is_locked;
    if locked {
        return Err("lock_busy");
    }
    return Ok(FileLock {
        path: lock.path,
        is_exclusive: true,
        is_locked: true
    });
}

pub fn file_lock_release(
    fs: &FsCap,
    lock: FileLock
) -> FileLock {
    return FileLock {
        path: lock.path,
        is_exclusive: false,
        is_locked: false
    };
}
