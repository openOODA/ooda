// # Spawn a named async handle
//
// Logline: spawn_task needs ProcessCap and join_task needs SysCap; ProcessCap alone must not unlock join.
//
// Setup: CAPS.oot names ProcessCap for spawn and SysCap for join. SysCap still supersedes spawn.
//
// Beats:
//   1. spawn_task forwards a non-empty name to async_spawn_internal under &ProcessCap.
//   2. join_task forwards the handle to async_join_internal under &SysCap.
//   3. main spawns demo, joins Ok, and rejects a bad handle.
//
// residual: join is SysCap-only; handles are "thread#N" strings, not a green-thread runtime

pub fn spawn_task(proc: &ProcessCap, task_name: String) -> String
    requires task_name.len() > 0
    ensures result.len() > 0
{
    return async_spawn_internal(proc, task_name);
}

pub fn join_task(sys: &SysCap, handle: String) -> Result[String, String] {
    return async_join_internal(sys, handle);
}

// Honesty probe: multi-cap main — ProcessCap for spawn, SysCap for join residual.
pub fn main(proc: &ProcessCap, sys: &SysCap) {
    let h = spawn_task(proc, "demo");
    let r = join_task(sys, h);
    assert_eq!(r.is_ok(), true);
    assert_eq!(join_task(sys, "not_a_handle").is_err(), true);
}
