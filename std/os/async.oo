// ===================================================================
// openOODA Standard Library: std::async
// Structured concurrency task runtime and join handles
// ===================================================================
// Real OS threads via async_spawn_internal / async_join_internal.
// Handles look like "thread#N"; join yields Ok("task_done:{name}").
// Both spawn and join are sealed Sys effects — callers need &SysCap.

pub fn spawn_task(sys: &SysCap, task_name: String) -> String
    requires task_name.len() > 0
    ensures result.len() > 0
{
    return async_spawn_internal(sys, task_name);
}

pub fn join_task(sys: &SysCap, handle: String) -> Result[String, String] {
    return async_join_internal(sys, handle);
}

// Honesty probe: real spawn/join roundtrip + malformed handle fails.
pub fn main(sys: &SysCap) {
    let h = spawn_task(sys, "demo");
    let r = join_task(sys, h);
    assert_eq!(r.is_ok(), true);
    assert_eq!(join_task(sys, "not_a_handle").is_err(), true);
}
