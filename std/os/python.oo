// ===================================================================
// openOODA Standard Library: std::python
// Direct, type-safe PyTorch, HuggingFace, and NumPy AI Bridge
// ===================================================================
// CAP-G4 hard Sys residual — keep &SysCap. Do NOT migrate to ProcessCap.
// Honesty:
//   - python_embed / python_embed_internal require &SysCap only
//     (oo_cap_require_sys). ProcessCap alone must not unlock this path.
//   - ProcessCap facades (spawn/exec/wait/kill) do not cover python_embed.
//   - Alpha: python_embed_internal returns Err (no embedded CPython).
//     Callers must match on Err — do not treat Ok as a loaded model.
// Not claimed: real CPython embed, least-privilege ProcessCap for AI bridge.

pub fn load_model(sys: &SysCap, model_name: String) -> Result[String, String]
    requires model_name.len() > 0
{
    return python_embed_internal(sys, model_name);
}

// Runtime honesty probe: model load must fail closed until CPython is wired.
pub fn main(sys: &SysCap) {
    let res = load_model(sys, "llama3");
    assert_eq!(res.is_err(), true);
}
