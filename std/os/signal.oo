// # POSIX Signal Management Module
//
// Logline: POSIX signal constants, signal names, signal dispatch, and process notification under ProcessCap and SysCap.
//
// Setup: Bridges standard POSIX signal constants and kill notifications under explicit capability tokens.
//
// Beats:
//   1. Define standard signal numbers (SIGINT, SIGTERM, SIGKILL, SIGHUP, SIGUSR1, SIGUSR2).
//   2. Convert between signal numbers and textual names.
//   3. Dispatch signals to target process IDs under ProcessCap.
//   4. Query signal fatal classification.
// RULES.oot 1.4: Default-deny for process manipulation. Explicit &ProcessCap required for dispatch.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

// POSIX SIGHUP (1).
pub fn signal_sighup() -> Int {
    return 1;
}

// POSIX SIGINT (2).
pub fn signal_sigint() -> Int {
    return 2;
}

// POSIX SIGQUIT (3).
pub fn signal_sigquit() -> Int {
    return 3;
}

// POSIX SIGKILL (9).
pub fn signal_sigkill() -> Int {
    return 9;
}

// POSIX SIGUSR1 (10).
pub fn signal_sigusr1() -> Int {
    return 10;
}

// POSIX SIGUSR2 (12).
pub fn signal_sigusr2() -> Int {
    return 12;
}

// POSIX SIGPIPE (13).
pub fn signal_sigpipe() -> Int {
    return 13;
}

// POSIX SIGALRM (14).
pub fn signal_sigalrm() -> Int {
    return 14;
}

// POSIX SIGTERM (15).
pub fn signal_sigterm() -> Int {
    return 15;
}

// Map signal number to canonical string name.
pub fn signal_name(signum: Int) -> String {
    if signum == 1 { return "SIGHUP"; }
    if signum == 2 { return "SIGINT"; }
    if signum == 3 { return "SIGQUIT"; }
    if signum == 9 { return "SIGKILL"; }
    if signum == 10 { return "SIGUSR1"; }
    if signum == 12 { return "SIGUSR2"; }
    if signum == 13 { return "SIGPIPE"; }
    if signum == 14 { return "SIGALRM"; }
    if signum == 15 { return "SIGTERM"; }
    return "UNKNOWN";
}

// Map canonical string name to signal number.
pub fn signal_from_name(name: String) -> Int {
    if name == "SIGHUP" { return 1; }
    if name == "SIGINT" { return 2; }
    if name == "SIGQUIT" { return 3; }
    if name == "SIGKILL" { return 9; }
    if name == "SIGUSR1" { return 10; }
    if name == "SIGUSR2" { return 12; }
    if name == "SIGPIPE" { return 13; }
    if name == "SIGALRM" { return 14; }
    if name == "SIGTERM" { return 15; }
    return 0;
}

// True if signal terminates the target process by default.
pub fn signal_is_fatal(signum: Int) -> Bool {
    if signum == 9 || signum == 15 || signum == 2 || signum == 1 || signum == 3 {
        return true;
    }
    return false;
}

// Dispatch signal to target process pid under ProcessCap.
pub fn signal_send(
    p: &ProcessCap,
    pid: Int,
    signum: Int
) -> Result[String, String] {
    if pid <= 0 {
        return Err("E_SIG_INVALID_PID: pid must be positive");
    }
    if signum <= 0 || signum > 64 {
        return Err("E_SIG_INVALID_NUM: invalid signal number");
    }
    return oo_sys_kill(p, pid, signum);
}
