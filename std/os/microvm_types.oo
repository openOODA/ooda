// # MicroVM Boot Types & E820 Constants
//
// Logline: Defines Linux/x86_64 boot_params and E820 memory-map entry types and the loader/protocol/magic constants for AWS Firecracker and QEMU direct-kernel boot.
//
// Setup: Pure data definitions for Stage 15 (Unikernels & Confidential Enclaves). No IO. Decimal literals are used in place of hex because the .oo lexer does not accept 0xNN constants.
//
// Beats:
//   1. Define E820Entry and BootParams records for the Linux zero-page boot layout.
//   2. Define E820 memory-type constants (RAM=1, RESERVED=2, ACPI=3, NVS=4, UNUSABLE=5) per the Linux x86 boot protocol.
//   3. Define boot-header constants (HdrS magic, protocol version 2.15, loader type 0xFF for Firecracker).
//   4. Provide constructors for E820Entry and BootParams and helper accessors.

pub fn e820_ram() -> Int { return 1; }
pub fn e820_reserved() -> Int { return 2; }
pub fn e820_acpi() -> Int { return 3; }
pub fn e820_nvs() -> Int { return 4; }
pub fn e820_unusable() -> Int { return 5; }

// Linux/x86 boot header magic. The on-disk bytes are the ASCII string "HdrS"
// (0x48 0x64 0x72 0x53) stored little-endian as a 32-bit word at offset 0x202.
// Decimal encoding: 72 + 100*256 + 114*65536 + 83*16777216 = 1400005704.
pub fn boot_hdr_magic_hdrs() -> Int { return 1400005704; }

// Linux boot protocol version 2.15 (the protocol version Linux x86_64 honors).
// 0x020F = 2*256 + 15 = 527.
pub fn boot_protocol_version() -> Int { return 527; }

// Loader type: 0xFF marks a "Linux direct-boot" loader, which is what
// Firecracker and QEMU -kernel use. Decimal: 255.
pub fn loader_type_direct() -> Int { return 255; }

// Boot sector size in bytes (the canonical Linux boot header is at offset 0x1F1
// of the first 512-byte sector; the zero page itself is 4096 bytes).
pub fn boot_sector_size() -> Int { return 512; }
pub fn zero_page_size() -> Int { return 4096; }

pub type E820Entry = struct {
    addr: Int,
    size: Int,
    mem_type: Int,
};

pub type BootParams = struct {
    loader_type: Int,
    protocol_version: Int,
    magic: Int,
    command_line: String,
    e820_entries: List[E820Entry],
    ram_size_mb: Int,
    is_valid: Bool,
};

pub fn e820_entry_new(addr: Int, size: Int, mem_type: Int) -> E820Entry {
    return E820Entry {
        addr: addr,
        size: size,
        mem_type: mem_type,
    };
}

pub fn e820_entry_is_ram(e: &E820Entry) -> Bool {
    return (e).mem_type == e820_ram();
}

pub fn e820_entry_end_addr(e: &E820Entry) -> Int {
    return (e).addr + (e).size;
}

pub fn boot_params_new() -> BootParams {
    let empty_e820: List[E820Entry] = list_new();
    return BootParams {
        loader_type: loader_type_direct(),
        protocol_version: boot_protocol_version(),
        magic: boot_hdr_magic_hdrs(),
        command_line: "",
        e820_entries: empty_e820,
        ram_size_mb: 0,
        is_valid: false,
    };
}

pub fn boot_params_set_cmdline(mut_bp: &mut BootParams, cmdline: String) {
    (mut_bp).command_line = cmdline;
}

pub fn boot_params_set_ram_size_mb(mut_bp: &mut BootParams, ram_size_mb: Int) {
    (mut_bp).ram_size_mb = ram_size_mb;
    (mut_bp).is_valid = true;
}

pub fn boot_params_append_e820(mut_bp: &mut BootParams, e: E820Entry) {
    let old_e: List[E820Entry] = (mut_bp).e820_entries;
    let new_e: List[E820Entry] = list_push(old_e, e);
    (mut_bp).e820_entries = new_e;
}

pub fn boot_params_e820_count(bp: &BootParams) -> Int {
    return list_len((bp).e820_entries);
}
