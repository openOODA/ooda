// # POSIX File Permission Bits Module
//
// Logline: POSIX file mode bit calculations, octal mode formatting (e.g. 0644, 0755), and rwx permission string generation.
//
// Setup: Pure bitwise file mode calculation module.
//
// Beats:
//   1. Check read, write, execute permissions for Owner, Group, Others.
//   2. Format mode integer into 9-character rwxrwxrwx string.
//   3. Compute octal mode representation.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

pub fn file_mode_has_owner_read(mode: Int) -> Bool {
    return (mode & 256) != 0;
}

pub fn file_mode_has_owner_write(mode: Int) -> Bool {
    return (mode & 128) != 0;
}

pub fn file_mode_has_owner_exec(mode: Int) -> Bool {
    return (mode & 64) != 0;
}

pub fn file_mode_to_rwx_triplet(read_bit: Bool, write_bit: Bool, exec_bit: Bool) -> String {
    let mut out: String = "";
    if read_bit { out = out + "r"; } else { out = out + "-"; }
    if write_bit { out = out + "w"; } else { out = out + "-"; }
    if exec_bit { out = out + "x"; } else { out = out + "-"; }
    return out;
}

pub fn file_mode_to_string(mode: Int) -> String {
    let ur: Bool = (mode & 256) != 0;
    let uw: Bool = (mode & 128) != 0;
    let ux: Bool = (mode & 64) != 0;

    let gr: Bool = (mode & 32) != 0;
    let gw: Bool = (mode & 16) != 0;
    let gx: Bool = (mode & 8) != 0;

    let or_b: Bool = (mode & 4) != 0;
    let ow: Bool = (mode & 2) != 0;
    let ox: Bool = (mode & 1) != 0;

    let u_str: String = file_mode_to_rwx_triplet(ur, uw, ux);
    let g_str: String = file_mode_to_rwx_triplet(gr, gw, gx);
    let o_str: String = file_mode_to_rwx_triplet(or_b, ow, ox);

    return u_str + g_str + o_str;
}
