// ===================================================================
// openOODA Standard Library — std::os::fs
// ===================================================================
// Effectful FS free names require leading &FsCap (check + runtime seal).
// Thin wrappers thread the capability token into sealed builtins.
// residual: no ambient FS; no unrestricted dir walk / chmod product.

// write_file(fs, path, content) → sealed write under FsCap
pub fn fs_write_file(fs: &FsCap, path: String, content: String) -> Result[Void, String]
    requires path.len() > 0
{
    return write_file(fs, path, content);
}

// read_file(fs, path) → sealed read under FsCap
pub fn fs_read_file(fs: &FsCap, path: String) -> Result[String, String]
    requires path.len() > 0
{
    return read_file(fs, path);
}

// path_exists(fs, path) → sealed probe under FsCap
pub fn fs_path_exists(fs: &FsCap, path: String) -> Bool
    requires path.len() > 0
{
    return path_exists(fs, path);
}

// file_size(fs, path) → sealed size under FsCap
pub fn fs_file_size(fs: &FsCap, path: String) -> Int
    requires path.len() > 0
{
    return file_size(fs, path);
}
