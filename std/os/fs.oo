// ===================================================================
// openOODA Standard Library — std::fs
// ===================================================================
// Stage-0 sealed builtins accept optional leading FsCap then path/content.
// Pass the handle so capability is threaded into the sealed call.

pub fn fs_write_file(fs: &FsCap, path: String, content: String) -> Result[Void, String]
    requires path.len() > 0
{
    return write_file(fs, path, content);
}

pub fn fs_read_file(fs: &FsCap, path: String) -> Result[String, String]
    requires path.len() > 0
{
    return read_file(fs, path);
}
