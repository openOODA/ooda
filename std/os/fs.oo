// # Cap-gated filesystem
//
// Logline: Thin wrappers thread &FsReadCap, &FsWriteCap, and legacy &FsCap into sealed filesystem builtins.
//
// Setup: CAPS.oot names the tokens. Runtime injects them. This file does not mint one.
//
// Beats:
//   1. Read, probe, size, walk, and is_dir take &FsReadCap.
//   2. Write, remove, mkdir, hardlink, and symlink take &FsWriteCap.
//   3. Legacy &FsCap still supersedes soft-granular for one-wave check and runtime.
//
// residual: no ambient FS; no unrestricted chmod product. remove_tree uses rmdir + unlink under writedir.
// Not claimed: OS FS isolation / landlock / seccomp on open/write (CAP-G5).

// write_file(fs, path, content) → sealed write under FsWriteCap
pub fn fs_write_file(fs: &FsWriteCap, path: String, content: String) -> Result[Void, String]
{
    return oo_write_file(fs, path, content);
}

// read_file(fs, path) → sealed read under FsReadCap
pub fn fs_read_file(fs: &FsReadCap, path: String) -> Result[String, String]
{
    return oo_read_file(fs, path);
}

// path_exists(fs, path) → sealed probe under FsReadCap
pub fn fs_path_exists(fs: &FsReadCap, path: String) -> Bool
{
    return oo_path_exists(fs, path);
}

// file_size(fs, path) → sealed size under FsReadCap
pub fn fs_file_size(fs: &FsReadCap, path: String) -> Int
{
    return oo_file_size(fs, path);
}

// fs_read_dir(fs, path) → sealed read_dir under FsReadCap
pub fn fs_read_dir(fs: &FsReadCap, path: String) -> List[String]
{
    return oo_fs_read_dir(fs, path);
}

pub fn fs_is_dir(fs: &FsReadCap, path: String) -> Bool
{
    return oo_fs_is_dir(fs, path);
}

pub fn fs_walk(fs: &FsReadCap, path: String) -> List[String]
{
    let mut out: List[String] = list_new();
    out = list_push(out, path);
    if fs_is_dir(fs, path) {
        let entries: List[String] = fs_read_dir(fs, path);
        let n = list_len(entries);
        let mut i = 0;
        while i < n {
            let entry: String = list_get(entries, i);
            let mut sep = "/";
            if str_ends_with(path, "/") {
                sep = "";
            }
            let sub_path = path + sep + entry;
            let sub_entries: List[String] = fs_walk(fs, sub_path);
            let m = list_len(sub_entries);
            let mut j = 0;
            while j < m {
                out = list_push(out, list_get(sub_entries, j));
                j = j + 1;
            }
            i = i + 1;
        }
    }
    return out;
}

// fs_remove_file(fs, path) -> sealed remove under FsWriteCap
pub fn fs_remove_file(fs: &FsWriteCap, path: String) -> Result[Void, String]
{
    return oo_fs_remove_file(fs, path);
}

// fs_mkdir(fs, path) -> sealed mkdir under FsWriteCap
pub fn fs_mkdir(fs: &FsWriteCap, path: String) -> Result[Void, String]
{
    return oo_fs_mkdir(fs, path);
}

// fs_hardlink(fs, oldpath, newpath) -> sealed link under FsWriteCap
pub fn fs_hardlink(fs: &FsWriteCap, oldpath: String, newpath: String) -> Result[Void, String]
{
    return oo_fs_hardlink(fs, oldpath, newpath);
}

// fs_symlink(fs, target, linkpath) -> sealed symlink under FsWriteCap
pub fn fs_symlink(fs: &FsWriteCap, target: String, linkpath: String) -> Result[Void, String]
{
    return oo_fs_symlink(fs, target, linkpath);
}

// mkdir every prefix. Existing dirs: fs_mkdir may Err; we continue.
pub fn fs_mkdir_p(fw: &FsWriteCap, path: String) -> Result[Void, String]
    requires chars_len(path) > 0
{
    let n: Int = chars_len(path);
    let mut acc: String = "";
    let mut i: Int = 0;
    if char_at(path, 0) == "/" {
        acc = "/";
        i = 1;
    }
    while i < n {
        let c: String = char_at(path, i);
        if c == "/" {
            if chars_len(acc) > 0 {
                if acc != "/" {
                    let mk: Result[Void, String] = oo_fs_mkdir(fw, acc);
                    if mk.is_err() {
                        let hold = 0;
                        if hold != 0 { println(""); }
                    }
                }
            }
            if !str_ends_with(acc, "/") {
                acc = acc + "/";
            }
        } else {
            acc = acc + c;
        }
        i = i + 1;
    }
    if chars_len(acc) > 0 {
        if acc != "/" {
            return oo_fs_mkdir(fw, acc);
        }
    }
    return oo_fs_mkdir(fw, path);
}

// Copy one file. Directories stay a residual (use walk + mkdir_p + copy).
pub fn fs_copy_file(fr: &FsReadCap, fw: &FsWriteCap, src: String, dst: String) -> Result[Void, String]
    requires chars_len(src) > 0
    requires chars_len(dst) > 0
{
    let body: Result[String, String] = fs_read_file(fr, src);
    if body.is_err() {
        return oo_fs_mkdir(fw, "/_invalid_copy_src_");
    }
    let s: String = match body { Ok(v) => v, Err(_) => "" };
    return fs_write_file(fw, dst, s);
}

pub fn fs_copy_tree(fr: &FsReadCap, fw: &FsWriteCap, src: String, dst: String) -> Result[Void, String]
    requires chars_len(src) > 0
    requires chars_len(dst) > 0
{
    if fs_is_dir(fr, src) {
        let mk: Result[Void, String] = fs_mkdir_p(fw, dst);
        if mk.is_err() { return mk; }
        let ents: List[String] = fs_read_dir(fr, src);
        let n: Int = list_len(ents);
        let mut i: Int = 0;
        while i < n {
            let name: String = list_get(ents, i);
            let r: Result[Void, String] = fs_copy_tree(fr, fw, src + "/" + name, dst + "/" + name);
            if r.is_err() { return r; }
            i = i + 1;
        }
        return oo_fs_mkdir(fw, dst);
    }
    return fs_copy_file(fr, fw, src, dst);
}

pub fn fs_rmdir(fw: &FsWriteCap, path: String) -> Result[Void, String] {
    return oo_fs_rmdir(fw, path);
}

pub fn fs_remove_tree(fw: &FsWriteCap, fr: &FsReadCap, path: String) -> Result[Void, String]
    requires chars_len(path) > 0
{
    if !fs_path_exists(fr, path) {
        return oo_fs_mkdir(fw, "/_already_empty_");
    }
    if !fs_is_dir(fr, path) {
        return fs_remove_file(fw, path);
    }
    let ents: List[String] = fs_read_dir(fr, path);
    let n: Int = list_len(ents);
    let mut i: Int = 0;
    while i < n {
        let name: String = list_get(ents, i);
        let sub: String = path + "/" + name;
        let r: Result[Void, String] = fs_remove_tree(fw, fr, sub);
        if r.is_err() {
            return r;
        }
        i = i + 1;
    }
    return fs_rmdir(fw, path);
}

pub fn fs_probe() -> Int {
    return 0;
}
