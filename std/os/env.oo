// # Read an env key
//
// Logline: env_get reads one OODA_ or OO_ key and needs an EnvCap token to do it.
//
// Setup: CAPS.oot names EnvCap. Runtime injects the token. This file does not mint one.
//
// Beats:
//   1. Caller passes &EnvCap and a key string.
//   2. env_get forwards to oo_env_get.
//   3. Missing or forged cap fails closed; wrong key shape is denied.
//
// residual: only OODA_ and OO_ keys; no raw getenv

pub fn env_get(cap: &EnvCap, key: String) -> Result[String, String] {
    return oo_env_get(cap, key);
}

pub fn env_probe() -> Int {
    return 0;
}
