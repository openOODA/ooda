// # CPU Affinity and Processor Mask Module
//
// Logline: Thread CPU core affinity masks, processor pinning, core set algebra, and topology tracking under ThreadCap.
//
// Setup: Coordinates CPU core pinning and processor scheduling affinity masks under ThreadCap token.
//
// Beats:
//   1. Construct CpuSet processor bitmask holding core binding flags.
//   2. Enable and clear specific CPU core bindings under ThreadCap.
//   3. Query core membership (cpu_set_is_set) and active core count (cpu_set_count).
//   4. Initialize full affinity mask binding all available processors.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Linux sched_setaffinity / POSIX pthread_setaffinity_np lower via platform scheduler.

type CpuSet = struct {
    mask: Int,
    num_cpus: Int
};

pub fn cpu_set_new(num_cpus: Int) -> CpuSet {
    let mut n: Int = num_cpus;
    if n <= 0 {
        n = 4;
    }
    return CpuSet {
        mask: 0,
        num_cpus: n
    };
}

pub fn cpu_set_all(num_cpus: Int) -> CpuSet {
    let mut n: Int = num_cpus;
    if n <= 0 {
        n = 4;
    }
    let mut m: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let bit: Int = 1 << i;
        m = m | bit;
        i = i + 1;
    }
    return CpuSet {
        mask: m,
        num_cpus: n
    };
}

pub fn cpu_set_is_set(cs: CpuSet, cpu_id: Int) -> Bool {
    let n: Int = cs.num_cpus;
    if cpu_id < 0 || cpu_id >= n {
        return false;
    }
    let mask: Int = cs.mask;
    let bit: Int = 1 << cpu_id;
    let shifted: Int = mask >> cpu_id;
    return (shifted & 1) == 1;
}

pub fn cpu_set_set(
    thread: &ThreadCap,
    cs: CpuSet,
    cpu_id: Int
) -> CpuSet {
    let n: Int = cs.num_cpus;
    if cpu_id < 0 || cpu_id >= n {
        return cs;
    }
    let cur_mask: Int = cs.mask;
    let bit: Int = 1 << cpu_id;
    let next_mask: Int = cur_mask | bit;
    return CpuSet {
        mask: next_mask,
        num_cpus: cs.num_cpus
    };
}

pub fn cpu_set_clear(
    thread: &ThreadCap,
    cs: CpuSet,
    cpu_id: Int
) -> CpuSet {
    let n: Int = cs.num_cpus;
    if cpu_id < 0 || cpu_id >= n {
        return cs;
    }
    let cur_mask: Int = cs.mask;
    let bit: Int = 1 << cpu_id;
    let next_mask: Int = (cur_mask | bit) - bit;
    return CpuSet {
        mask: next_mask,
        num_cpus: cs.num_cpus
    };
}

pub fn cpu_set_count(cs: CpuSet) -> Int {
    let mut cur: Int = cs.mask;
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < 64 {
        if (cur & 1) == 1 {
            count = count + 1;
        }
        cur = cur >> 1;
        i = i + 1;
    }
    return count;
}
