// # Terminal Cursor Positioning and Visibility Control Module
//
// Logline: Terminal cursor movement escape sequences, row/column positioning, and cursor visibility toggles.
//
// Setup: Pure string escape generator for interactive TUI applications.
//
// Beats:
//   1. Generate cursor movement escapes (up, down, forward, back).
//   2. Set absolute cursor position (row, col).
//   3. Hide and show cursor escapes.
//   4. Save and restore cursor position.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";
import "std/text/format.oo";

pub fn cursor_up(n: Int) -> String {
    return "\x1b[" + format_pad_left(format_int_to_hex(n), 1, "0") + "A";
}

pub fn cursor_down(n: Int) -> String {
    return "\x1b[" + format_pad_left(format_int_to_hex(n), 1, "0") + "B";
}

pub fn cursor_forward(n: Int) -> String {
    return "\x1b[" + format_pad_left(format_int_to_hex(n), 1, "0") + "C";
}

pub fn cursor_back(n: Int) -> String {
    return "\x1b[" + format_pad_left(format_int_to_hex(n), 1, "0") + "D";
}

pub fn cursor_hide() -> String {
    return "\x1b[?25l";
}

pub fn cursor_show() -> String {
    return "\x1b[?25h";
}

pub fn cursor_save() -> String {
    return "\x1b7";
}

pub fn cursor_restore() -> String {
    return "\x1b8";
}
