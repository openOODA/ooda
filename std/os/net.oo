// ===================================================================
// openOODA Standard Library — std::os::net
// ===================================================================
// CAP-G6 / CAP-G1: preferred granular net tokens on product facades.
//   HttpCap  — http_get / net_get → fetch
//   TcpCap   — connect / write / read / close / tls_connect
//   BindCap  — tcp_bind
//   UdpCap   — bind_udp / udp_recv
//   NetCap   — sock_raw only (hard NetCap-only residual)
// Legacy &NetCap still supersedes soft-granular at check + runtime (one-wave).
//
// Path A (M162/M163): tcp_bind / tcp_connect / bind_udp real under preferred caps.
// Path A (M166): tcp_write / tcp_read / udp_recv / tcp_close real slot IO.
// tls_connect: TcpCap require → real TCP connect, then:
//   - OO_HAVE_OPENSSL: TLS 1.2+ client handshake (product when linked)
//   - else: Err("tls residual: OpenSSL not linked") fail-closed
//   - OODA_TLS_INSECURE_TCP=1: Ok after TCP-only (insecure residual; honesty)

pub fn http_get(http: &HttpCap, url: String) -> Result[String, String]
    requires url.len() > 0
{
    return fetch(http, url);
}

pub fn net_get(http: &HttpCap, url: String) -> Result[String, String]
    requires url.len() > 0
{
    return fetch(http, url);
}

// Thin product wrappers → sealed free names (cap + residual only).
pub fn net_tcp_bind(bind: &BindCap, port: Int) -> Result[String, String]
    requires port >= 0
{
    return tcp_bind(bind, port);
}

pub fn net_tcp_connect(tcp: &TcpCap, host: String, port: Int) -> Result[String, String]
    requires host.len() > 0
{
    return tcp_connect(tcp, host, port);
}

pub fn net_bind_udp(udp: &UdpCap, port: Int) -> Result[String, String]
    requires port >= 0
{
    return bind_udp(udp, port);
}

pub fn net_tls_connect(tcp: &TcpCap, host: String, port: Int) -> Result[String, String]
    requires host.len() > 0
{
    return tls_connect(tcp, host, port);
}

// M166 path A: process-local socket slot IO under preferred granular caps.
pub fn net_tcp_write(tcp: &TcpCap, slot: Int, data: String) -> Result[String, String] {
    return tcp_write(tcp, slot, data);
}

pub fn net_tcp_read(tcp: &TcpCap, slot: Int, max_n: Int) -> Result[String, String] {
    return tcp_read(tcp, slot, max_n);
}

pub fn net_udp_recv(udp: &UdpCap, slot: Int, max_n: Int) -> Result[String, String] {
    return udp_recv(udp, slot, max_n);
}

pub fn net_tcp_close(tcp: &TcpCap, slot: Int) -> Result[String, String] {
    return tcp_close(tcp, slot);
}

// residual: SOCK_RAW not product — sealed require NetCap then Err.
pub fn net_sock_raw(net: &NetCap, proto: Int) -> Result[String, String] {
    return sock_raw(net, proto);
}
