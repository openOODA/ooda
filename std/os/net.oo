// ===================================================================
// openOODA Standard Library — std::net
// ===================================================================
// Stage-0 sealed builtin `fetch` accepts optional leading NetCap token
// then url (see eval.rs net_url_arg). Pass the handle so call sites
// thread capability tokens explicitly (not just ambient grant).

pub fn http_get(net: &NetCap, url: String) -> Result[String, String]
    requires url.len() > 0
{
    return fetch(net, url);
}

pub fn net_get(net: &NetCap, url: String) -> Result[String, String]
    requires url.len() > 0
{
    return fetch(net, url);
}
