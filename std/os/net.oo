// ===================================================================
// openOODA Standard Library — std::os::net
// ===================================================================
// Stage-0 sealed builtin `fetch` accepts leading NetCap then url.
// Pass the handle so call sites thread capability tokens explicitly.
//
// Path A residual (no real sockets / TLS handshake): free sealed names
// tcp_bind / tcp_connect / bind_udp / tls_connect lower to oo_* and
// return Err("net residual: path A seal only …") after NetCap re-check.

pub fn http_get(net: &NetCap, url: String) -> Result[String, String]
    requires url.len() > 0
{
    return fetch(net, url);
}

pub fn net_get(net: &NetCap, url: String) -> Result[String, String]
    requires url.len() > 0
{
    return fetch(net, url);
}

// Thin product wrappers → sealed free names (cap + residual only).
pub fn net_tcp_bind(net: &NetCap, port: Int) -> Result[String, String]
    requires port >= 0
{
    return tcp_bind(net, port);
}

pub fn net_tcp_connect(net: &NetCap, host: String, port: Int) -> Result[String, String]
    requires host.len() > 0
{
    return tcp_connect(net, host, port);
}

pub fn net_bind_udp(net: &NetCap, port: Int) -> Result[String, String]
    requires port >= 0
{
    return bind_udp(net, port);
}

pub fn net_tls_connect(net: &NetCap, host: String, port: Int) -> Result[String, String]
    requires host.len() > 0
{
    return tls_connect(net, host, port);
}
