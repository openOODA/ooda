// # Protocol Buffers (Protobuf) Wire Types & Token Descriptors
//
// Logline: Defines Protobuf wire types (0=Varint, 1=64-bit, 2=Length-Delimited, 5=32-bit) and decoded message trees.
//
// Setup: Pure serialization data structures for binary Protobuf wire decoding.
//
// Beats:
//   1. Define ProtoField holding field number, wire type tag, varint value, and payload byte buffer.
//   2. Define ProtoMessage holding collections of decoded ProtoField tokens.
//   3. Provide helper constructors for field tokens and messages.

pub type ProtoField = struct {
    field_number: Int,
    wire_type: Int,
    varint_val: Int,
    bytes_val: List[Int]
};

pub type ProtoMessage = struct {
    fields: List[ProtoField]
};

/// Create a new varint ProtoField.
pub fn proto_field_varint(field_num: Int, val: Int) -> ProtoField {
    let empty_bytes: List[Int] = list_new();
    return ProtoField {
        field_number: field_num,
        wire_type: 0,
        varint_val: val,
        bytes_val: empty_bytes
    };
}

/// Create a new length-delimited bytes/string ProtoField.
pub fn proto_field_bytes(field_num: Int, bytes: List[Int]) -> ProtoField { return ProtoField {
        field_number: field_num,
        wire_type: 2,
        varint_val: 0,
        bytes_val: bytes
    }; }
