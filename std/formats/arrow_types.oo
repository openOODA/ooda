// # Apache Arrow IPC Streaming Format Structures
//
// Logline: Defines Arrow IPC schema descriptors, dictionary encodings, and record batch containers.
//
// Setup: Pure memory columnar interchange data structures with zero struct trailing commas.
//
// Beats:
//   1. Define ArrowField representing column name, type ID, and nullability flag.
//   2. Define ArrowSchema managing ordered field descriptor arrays.
//   3. Define ArrowRecordBatch holding batch row lengths and column buffer references.

pub type ArrowField = struct {
    name: String,
    type_id: Int,
    nullable: Bool
};

pub type ArrowSchema = struct {
    fields: List[ArrowField],
    num_fields: Int
};

pub type ArrowRecordBatch = struct {
    schema: ArrowSchema,
    length: Int
};
