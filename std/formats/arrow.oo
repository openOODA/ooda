// # Apache Arrow IPC Stream Metadata Parser & Serializer
//
// Logline: Parses and encodes Arrow IPC Schema descriptors, continuation tokens, and field vectors.
//
// Setup: Pure columnar stream parser decoding message headers and field layouts with fail-closed bounds checking.
//
// Beats:
//   1. Validate Arrow IPC continuation byte markers (0xFFFFFFFF) and message length frames.
//   2. Parse and serialize Schema message headers and field type arrays.
//   3. Parse RecordBatch message descriptors with row lengths and buffer offsets.
//   4. Return fail-closed Result on truncated or corrupted Arrow byte streams.

import "./arrow_types.oo";

/// Encode ArrowSchema into framed Arrow IPC binary format.
pub fn arrow_encode_schema(schema: &ArrowSchema) -> List[Int] {
    let mut body: List[Int] = list_new();
    body = list_push(body, 0); // endianness (2 bytes LE)
    body = list_push(body, 0);

    let n_fields: Int = (schema).num_fields;
    body = list_push(body, n_fields & 255);
    body = list_push(body, (n_fields >> 8) & 255);

    let fields_list: List[ArrowField] = (schema).fields;
    let mut i: Int = 0;
    while i < n_fields {
        let f: ArrowField = list_get(fields_list, i);
        body = list_push(body, (f).type_id & 255);
        body = list_push(body, ((f).type_id >> 8) & 255);
        if (f).nullable {
            body = list_push(body, 1);
        } else {
            body = list_push(body, 0);
        }
        body = list_push(body, 0); // padding
        i = i + 1;
    }

    let mut out: List[Int] = list_new();
    out = list_push(out, 255); // 0xFFFFFFFF continuation marker
    out = list_push(out, 255);
    out = list_push(out, 255);
    out = list_push(out, 255);

    let blen: Int = list_len(body);
    out = list_push(out, blen & 255);
    out = list_push(out, (blen >> 8) & 255);
    out = list_push(out, (blen >> 16) & 255);
    out = list_push(out, (blen >> 24) & 255);

    let mut bi: Int = 0;
    while bi < blen {
        out = list_push(out, list_get(body, bi));
        bi = bi + 1;
    }
    return out;
}

/// Parse Arrow schema descriptor from raw byte stream.
pub fn arrow_parse_schema(bytes: List[Int]) -> Result[ArrowSchema, String] {
    let n: Int = list_len(bytes);
    if n < 8 {
        return Err("ERR\tarrow_parse: stream too short (< 8 bytes)");
    }

    let mut start: Int = 0;
    let b0: Int = list_get(bytes, 0);
    let b1: Int = list_get(bytes, 1);
    let b2: Int = list_get(bytes, 2);
    let b3: Int = list_get(bytes, 3);

    if b0 == 255 && b1 == 255 && b2 == 255 && b3 == 255 {
        let l0: Int = list_get(bytes, 4);
        let l1: Int = list_get(bytes, 5);
        let l2: Int = list_get(bytes, 6);
        let l3: Int = list_get(bytes, 7);
        let meta_len: Int = l0 | (l1 << 8) | (l2 << 16) | (l3 << 24);
        if (8 + meta_len) > n {
            return Err("ERR\tarrow_parse: truncated message metadata");
        }
        start = 8;
    }

    if (start + 4) > n {
        return Err("ERR\tarrow_parse: header truncated");
    }

    let nf0: Int = list_get(bytes, start + 2);
    let nf1: Int = list_get(bytes, start + 3);
    let num_fields: Int = nf0 | (nf1 << 8);

    if num_fields < 0 || num_fields > 1024 {
        return Err("ERR\tarrow_parse: invalid field count in schema header");
    }

    let mut fields: List[ArrowField] = list_new();
    let mut pos: Int = start + 4;
    let mut fi: Int = 0;

    while fi < num_fields {
        if (pos + 4) > n {
            return Err("ERR\tarrow_parse: field descriptor truncated");
        }
        let tid0: Int = list_get(bytes, pos);
        let tid1: Int = list_get(bytes, pos + 1);
        let type_id: Int = tid0 | (tid1 << 8);
        let is_null: Bool = list_get(bytes, pos + 2) == 1;

        let fname: String = "field_" + fi.to_string();
        let af: ArrowField = ArrowField {
            name: fname,
            type_id: type_id,
            nullable: is_null
        };
        fields = list_push(fields, af);
        pos = pos + 4;
        fi = fi + 1;
    }

    return Ok(ArrowSchema {
        fields: fields,
        num_fields: num_fields
    });
}
