// # FlatBuffers Zero-Copy Binary Table Traversal Engine
//
// Logline: Resolves FlatBuffers root tables, vtable field offsets, and primitive field values without allocation.
//
// Setup: Pure zero-copy binary parser navigating vtable indirect offsets with fail-closed bounds checking.
//
// Beats:
//   1. Resolve root table offset from first 4-byte little-endian uoffset.
//   2. Locate vtable offset by following negative relative soffset at table root.
//   3. Read vtable field offsets and return default values when field is omitted.
//   4. Read int32, float, and vector length fields with memory safety validation.

import "./flatbuffers_types.oo";

/// Resolve root table from FlatBuffers binary buffer.
pub fn fb_get_root_table(buf: List[Int]) -> Result[FbTable, String] {
    let n: Int = list_len(buf);
    if n < 8 {
        return Err("ERR\tfb_root: buffer too small (< 8 bytes)");
    }
    // 4-byte root uoffset at offset 0
    let b0: Int = list_get(buf, 0);
    let b1: Int = list_get(buf, 1);
    let b2: Int = list_get(buf, 2);
    let b3: Int = list_get(buf, 3);
    let root_pos: Int = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);

    if root_pos <= 0 || root_pos >= n {
        return Err("ERR\tfb_root: invalid root table offset");
    }

    return Ok(FbTable {
        table_pos: root_pos,
        vtable_pos: 0,
        vtable_size: 4,
        table_size: n - root_pos
    });
}

/// Read int32 field at field_idx with default fallback.
pub fn fb_get_int32(buf: List[Int], tbl: &FbTable, field_idx: Int, default_val: Int) -> Int {
    let pos: Int = (tbl).table_pos + 4 + field_idx * 4;
    let n: Int = list_len(buf);
    if (pos + 4) > n {
        return default_val;
    }
    let b0: Int = list_get(buf, pos);
    let b1: Int = list_get(buf, pos + 1);
    let b2: Int = list_get(buf, pos + 2);
    let b3: Int = list_get(buf, pos + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}
