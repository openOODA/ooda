// # Apache Parquet File Format Metadata Structures
//
// Logline: Defines Parquet schema elements, column chunk metadata, and row group descriptors.
//
// Setup: Pure file format data structures representing Thrift metadata headers and column statistics.
//
// Beats:
//   1. Define ParquetSchemaElement holding column names, data type codes, and repetition rules.
//   2. Define ParquetColumnMetaData containing compression codec, value counts, and uncompressed byte size.
//   3. Define ParquetColumnChunk and ParquetRowGroup holding column arrays and row totals.
//   4. Define ParquetFileMetaData representing the complete file footer descriptor.

pub type ParquetSchemaElement = struct {
    name: String,
    type_code: Int,
    num_children: Int
};

pub type ParquetColumnMetaData = struct {
    codec: Int,
    num_values: Int,
    total_uncompressed_size: Int,
    data_page_offset: Int
};

pub type ParquetColumnChunk = struct {
    file_offset: Int,
    meta_data: ParquetColumnMetaData
};

pub type ParquetRowGroup = struct {
    columns: List[ParquetColumnChunk],
    total_byte_size: Int,
    num_rows: Int
};

pub type ParquetFileMetaData = struct {
    version: Int,
    num_rows: Int,
    schema: List[ParquetSchemaElement],
    row_groups: List[ParquetRowGroup],
    created_by: String
};
