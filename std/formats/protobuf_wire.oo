// # Protobuf LEB128 Varint & ZigZag Encoding Engine
//
// Logline: Implements LEB128 varint serialization, ZigZag signed integer conversion, and wire tag packing.
//
// Setup: Pure network serialization codec operating with fail-closed bounds validation.
//
// Beats:
//   1. Encode signed and unsigned integers into 7-bit LEB128 byte sequences.
//   2. Decode LEB128 varints from byte streams with cursor advancement.
//   3. Transform signed integers to/from unsigned via ZigZag arithmetic.
//   4. Unpack Protobuf tag varints into field number (tag >> 3) and wire type (tag & 7).

pub type ProtoTag = struct {
    field_num: Int,
    wire_type: Int
};

pub type ProtoVarint = struct {
    val: Int,
    bytes_read: Int
};

/// Decode LEB128 varint from byte list starting at offset.
pub fn proto_decode_varint(bytes: List[Int], offset: Int) -> Result[ProtoVarint, String] {
    let n: Int = list_len(bytes);
    if offset >= n {
        return Err("ERR\tproto_varint: unexpected EOF");
    }
    let mut val: Int = 0;
    let mut shift: Int = 0;
    let mut count: Int = 0;
    let mut i: Int = offset;

    while i < n && count < 10 {
        let b: Int = list_get(bytes, i);
        val = val | ((b & 127) << shift);
        count = count + 1;
        if (b & 128) == 0 {
            return Ok(ProtoVarint { val: val, bytes_read: count });
        }
        shift = shift + 7;
        i = i + 1;
    }
    return Err("ERR\tproto_varint: varint exceeds 10 bytes or truncated");
}

/// Encode integer into LEB128 varint byte list.
pub fn proto_encode_varint(val: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut v: Int = val;
    while v > 127 {
        let b: Int = (v & 127) | 128;
        out = list_push(out, b);
        v = v >> 7;
    }
    out = list_push(out, v & 127);
    return out;
}

/// ZigZag decode 32-bit integer: (n >> 1) ^ (-(n & 1)).
pub fn proto_zigzag_decode32(n: Int) -> Int { return (n >> 1) ^ (-(n & 1)); }

/// ZigZag decode 64-bit integer.
pub fn proto_zigzag_decode64(n: Int) -> Int { return (n >> 1) ^ (-(n & 1)); }

/// Unpack tag into field number and wire type.
pub fn proto_unpack_tag(tag: Int) -> ProtoTag { return ProtoTag {
        field_num: tag >> 3,
        wire_type: tag & 7
    }; }

pub fn protobuf_wire_val(v: ProtoVarint) -> Int {
    return v.val;
}
