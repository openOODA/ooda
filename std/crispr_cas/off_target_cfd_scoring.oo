// # CRISPR Cutting Frequency Determination (CFD) Off-Target Scoring
//
// Logline: Computes Doench CFD off-target cutting probability scores based on position-specific RNA:DNA mismatch matrices and PAM variation.
//
// Setup: Gold-standard SpCas9 off-target specificity model multiplying position-dependent mismatch cleavage frequencies.
//
// Beats:
//   1. Define CfdMismatchEntry and CfdOffTargetScore structures.
//   2. Look up position-specific mismatch penalty values across 20-nt guide positions.
//   3. Compute composite CFD cleavage probability product for genomic off-target sites.

pub type CfdMismatchEntry = struct {
    position_from_pam: Int,
    rna_base: String,
    dna_base: String,
    penalty_factor: Float
};

pub type CfdOffTargetScore = struct {
    guide_seq: String,
    offtarget_seq: String,
    mismatch_count: Int,
    cfd_score: Float,
    is_high_risk: Bool
};

pub fn cfd_get_penalty(pos_from_pam: Int, rna_b: String, dna_b: String) -> Float {
    if rna_b == dna_b { return 1.0; }
    // Seed region (1-8): heavy penalty
    if pos_from_pam <= 8 {
        if rna_b == "G" && dna_b == "T" { return 0.25; }
        if rna_b == "T" && dna_b == "G" { return 0.15; }
        return 0.05;
    }
    // Middle region (9-14)
    if pos_from_pam <= 14 {
        return 0.40;
    }
    // Distal region (15-20): tolerant
    return 0.75;
}

pub fn cfd_score_alignment(guide: String, target: String) -> CfdOffTargetScore {
    let glen = chars_len(guide);
    let tlen = chars_len(target);
    let n = if glen < tlen { glen } else { tlen };

    let mut mismatches = 0;
    let mut cfd_product: Float = 1.0;

    let mut i = 0;
    while i < n {
        let gb = char_at(guide, i);
        let tb = char_at(target, i);
        let pos_pam = n - i;
        if gb != tb {
            mismatches = mismatches + 1;
            let factor = cfd_get_penalty(pos_pam, gb, tb);
            cfd_product = cfd_product * factor;
        }
        i = i + 1;
    }

    let final_score = if mismatches == 0 { 1.0 } else { cfd_product };
    let high_risk = final_score > 0.10;

    return CfdOffTargetScore {
        guide_seq: guide,
        offtarget_seq: target,
        mismatch_count: mismatches,
        cfd_score: final_score,
        is_high_risk: high_risk
    };
}
