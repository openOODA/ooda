// # inDelphi MMEJ & 1-bp Insertion Repair Predictor
//
// Logline: Predicts microhomology-mediated end joining (MMEJ) vs non-homologous end joining (NHEJ) repair outcomes and 1-bp insertions.
//
// Setup: Machine learning repair outcome engine calculating frequency of single dominant genotypes and microhomology deletion patterns.
//
// Beats:
//   1. Define IndelphiOutcome and IndelphiSummary structures.
//   2. Predict 1-bp insertion frequency and preference (+1A/T vs +1G/C) based on position -4 nucleotide.
//   3. Compute precision editing score (fraction of reads with dominant genotype).

pub type IndelphiOutcome = struct {
    genotype_type: String,
    indel_size: Int,
    frequency_pct: Float,
    is_microhomology: Bool,
};

pub type IndelphiSummary = struct {
    dominant_genotype: String,
    highest_frequency_pct: Float,
    precision_score: Float,
    frameshift_ratio: Float,
};

pub fn indelphi_predict_cut(cut_minus_4_base: String) -> IndelphiSummary {
    let mut one_bp_freq: Float = 35.0;
    let mut dominant = "+1_INSERTION";

    if cut_minus_4_base == "T" || cut_minus_4_base == "t" {
        one_bp_freq = 55.0;
        dominant = "+1_T_INSERTION";
    } else if cut_minus_4_base == "A" || cut_minus_4_base == "a" {
        one_bp_freq = 50.0;
        dominant = "+1_A_INSERTION";
    } else {
        one_bp_freq = 25.0;
        dominant = "MMEJ_DELETION";
    }

    let precision = one_bp_freq * 0.9;
    let fs = 0.68;

    return IndelphiSummary {
        dominant_genotype: dominant,
        highest_frequency_pct: one_bp_freq,
        precision_score: precision,
        frameshift_ratio: fs,
    };
}
