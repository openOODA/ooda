// # Azimuth Gradient-Boosted On-Target Efficacy Model
//
// Logline: Computes Azimuth gradient-boosted decision tree features and thermodynamic stability contributions for Cas9 activity.
//
// Setup: Advanced on-target efficacy regression engine combining positional sequence k-mers, regional Tm, and cut-site folding energies.
//
// Beats:
//   1. Define AzimuthFeatureVector and AzimuthPrediction structures.
//   2. Extract thermodynamic features (local Tm, hairpin delta G, unpairing propensity).
//   3. Compute calibrated on-target cleavage efficiency probability.

pub type AzimuthFeatureVector = struct {
    gc_count: Int,
    has_tt_motif: Bool,
    melting_temp_seed: Float,
    melting_temp_nonseed: Float,
};

pub type AzimuthPrediction = struct {
    azimuth_score: Float,
    calibrated_cleavage_prob: Float,
    confidence_tier: String,
};

pub fn azimuth_compute_prediction(feat: &AzimuthFeatureVector) -> AzimuthPrediction {
    let mut score: Float = 60.0;
    if (feat).has_tt_motif {
        score = score - 20.0;
    }
    if (feat).gc_count >= 8 && (feat).gc_count <= 12 {
        score = score + 15.0;
    }
    let tm_diff = (feat).melting_temp_seed - (feat).melting_temp_nonseed;
    if tm_diff > 5.0 {
        score = score + 10.0;
    }

    if score > 99.0 { score = 99.0; }
    if score < 1.0 { score = 1.0; }

    let prob = score / 100.0;
    let tier = if score >= 70.0 { "OPTIMAL" } else { "SUBOPTIMAL" };

    return AzimuthPrediction {
        azimuth_score: score,
        calibrated_cleavage_prob: prob,
        confidence_tier: tier,
    };
}
