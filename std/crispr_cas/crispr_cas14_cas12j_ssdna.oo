// # CRISPR Cas14 (Cas12j) ssDNA Diagnostic Cleaver
//
// Logline: Models high-fidelity single-stranded DNA targeting and non-specific collateral trans-cleavage for molecular diagnostics.
//
// Setup: Unconstrained Type V-F/Cas14 effector module discriminating single-nucleotide variants (SNVs) without strict PAM requirements on ssDNA.
//
// Beats:
//   1. Define Cas14DiagnosticProbe and Cas14TransCleavageKinetic structures.
//   2. Model cis-target recognition and activation of trans-ssDNA collateral nuclease.
//   3. Compute single-nucleotide polymorphism (SNP) discrimination ratios.

pub type Cas14DiagnosticProbe = struct {
    target_snv_seq: String,
    guide_spacer: String,
    mismatch_position: Int,
    is_perfect_match: Bool,
    probe_fluorescence_signal: Float
};

pub type Cas14TransCleavageKinetic = struct {
    k_cat_over_km: Float,
    turnover_rate_per_min: Float,
    snv_selectivity_ratio: Float
};

pub fn cas14_compute_mismatch_pos(guide: String, target: String) -> Int {
    let g_len = chars_len(guide);
    let t_len = chars_len(target);
    let min_len = if g_len < t_len { g_len } else { t_len };
    let mut i = 0;
    while i < min_len {
        let cg = char_at(guide, i);
        let ct = char_at(target, i);
        if cg != ct {
            return i + 1;
        }
        i = i + 1;
    }
    return -1;
}

pub fn cas14_evaluate_kinetics(is_match: Bool, mismatch_pos: Int) -> Cas14TransCleavageKinetic {
    if is_match {
        return Cas14TransCleavageKinetic {
            k_cat_over_km: 1250000.0,
            turnover_rate_per_min: 1500.0,
            snv_selectivity_ratio: 100.0
        };
    }
    let mut rate = 50.0;
    if mismatch_pos >= 6 && mismatch_pos <= 14 {
        rate = 1.2;
    }
    let ratio = 1500.0 / rate;
    return Cas14TransCleavageKinetic {
        k_cat_over_km: 25000.0,
        turnover_rate_per_min: rate,
        snv_selectivity_ratio: ratio
    };
}
