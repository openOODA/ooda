// # CRISPR Cas12a (Cpf1) PAM & Protospacer Scanner
//
// Logline: Scans for Cas12a 5'-TTTV-3' PAM sites, extracts 23-24 nt protospacers, and models 5-nt staggered 5'-overhang cleavage geometry.
//
// Setup: Type V-A CRISPR endonuclease search module for Acidaminococcus / Lachnospiraceae Cas12a gene editing pipelines.
//
// Beats:
//   1. Define Cas12aTargetSite and Cas12aScanConfig structures.
//   2. Match 5' TTTV (V = A/C/G) PAM motifs and extract downstream protospacers.
//   3. Compute staggered cleavage indices (positions 18 and 23 on non-target and target strands).

pub type Cas12aTargetSite = struct {
    pam_sequence: String,
    protospacer_seq: String,
    strand: String,
    pam_index: Int,
    staggered_cut_pos1: Int,
    staggered_cut_pos2: Int,
    gc_percent: Float
};

pub type Cas12aScanConfig = struct {
    spacer_length: Int,
    min_gc: Float,
    max_gc: Float
};

pub fn cas12a_is_v_base(c: String) -> Bool {
    return c == "A" || c == "a" || c == "C" || c == "c" || c == "G" || c == "g";
}

pub fn cas12a_is_tttv_pam(p: String) -> Bool {
    if chars_len(p) != 4 { return false; }
    let c0 = char_at(p, 0);
    let c1 = char_at(p, 1);
    let c2 = char_at(p, 2);
    let c3 = char_at(p, 3);
    let is_t0 = (c0 == "T" || c0 == "t");
    let is_t1 = (c1 == "T" || c1 == "t");
    let is_t2 = (c2 == "T" || c2 == "t");
    return is_t0 && is_t1 && is_t2 && cas12a_is_v_base(c3);
}

pub fn cas12a_calc_gc(seq: String) -> Float {
    let n = chars_len(seq);
    if n == 0 { return 0.0; }
    let mut gc = 0;
    let mut i = 0;
    while i < n {
        let c = char_at(seq, i);
        if c == "G" || c == "g" || c == "C" || c == "c" {
            gc = gc + 1;
        }
        i = i + 1;
    }
    return ((gc as Float) / (n as Float)) * 100.0;
}

pub fn cas12a_slice(seq: String, start: Int, length: Int) -> String {
    let n = chars_len(seq);
    let mut out = "";
    let mut i = 0;
    while i < length && (start + i) < n {
        out = out + char_at(seq, start + i);
        i = i + 1;
    }
    return out;
}

pub fn cas12a_scan_targets(dna_seq: String, cfg: &Cas12aScanConfig) -> List[Cas12aTargetSite] {
    let mut list: List[Cas12aTargetSite] = list_new();
    let n = chars_len(dna_seq);
    let s_len = (cfg).spacer_length;
    let min_needed = 4 + s_len;
    if n < min_needed { return list; }

    let mut i = 0;
    while i <= n - min_needed {
        let pam_cand = cas12a_slice(dna_seq, i, 4);
        if cas12a_is_tttv_pam(pam_cand) {
            let spacer = cas12a_slice(dna_seq, i + 4, s_len);
            let gc = cas12a_calc_gc(spacer);
            if gc >= (cfg).min_gc && gc <= (cfg).max_gc {
                let site = Cas12aTargetSite {
                    pam_sequence: pam_cand,
                    protospacer_seq: spacer,
                    strand: "+",
                    pam_index: i,
                    staggered_cut_pos1: i + 4 + 18,
                    staggered_cut_pos2: i + 4 + 23,
                    gc_percent: gc
                };
                list_push(list, site);
            }
        }
        i = i + 1;
    }
    return list;
}
