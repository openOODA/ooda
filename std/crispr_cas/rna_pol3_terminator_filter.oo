// # RNA Polymerase III Premature Terminator Filter
//
// Logline: Scans guide RNA and pegRNA sequences for poly-T/poly-U tracts (TTTT, TTTTT) that abort U6/H1 promoter transcription.
//
// Setup: Expression fidelity validator preventing premature transcript truncation during Pol III-driven sgRNA synthesis in mammalian cells.
//
// Beats:
//   1. Define Pol3TerminatorHit and Pol3ExpressionProfile structures.
//   2. Detect 4+ consecutive T/U bases across spacer, scaffold, and extensions.
//   3. Compute predicted full-length sgRNA transcript percentage.

pub type Pol3TerminatorHit = struct {
    tract_sequence: String,
    start_index: Int,
    tract_length: Int,
    terminator_strength: String
};

pub type Pol3ExpressionProfile = struct {
    has_terminator: Bool,
    full_length_expression_pct: Float,
    recommended_action: String
};

pub fn pol3_scan_terminators(seq: String) -> Pol3ExpressionProfile {
    let n = chars_len(seq);
    let mut consecutive_t = 0;
    let mut max_t = 0;

    let mut i = 0;
    while i < n {
        let c = char_at(seq, i);
        if c == "T" || c == "t" || c == "U" || c == "u" {
            consecutive_t = consecutive_t + 1;
            if consecutive_t > max_t {
                max_t = consecutive_t;
            }
        } else {
            consecutive_t = 0;
        }
        i = i + 1;
    }

    if max_t >= 5 {
        return Pol3ExpressionProfile {
            has_terminator: true,
            full_length_expression_pct: 5.0,
            recommended_action: "ABSOLUTE_REJECT_OR_MUTATE"
        };
    }
    if max_t == 4 {
        return Pol3ExpressionProfile {
            has_terminator: true,
            full_length_expression_pct: 35.0,
            recommended_action: "WARN_MODERATE_TRUNCATION"
        };
    }

    return Pol3ExpressionProfile {
        has_terminator: false,
        full_length_expression_pct: 95.0,
        recommended_action: "APPROVED_FOR_U6_PROMOTER"
    };
}
