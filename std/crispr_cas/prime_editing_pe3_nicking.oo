// # Prime Editing PE3 & PE3b Non-Edited Strand Nicking Designer
//
// Logline: Designs secondary nicking sgRNAs (+40 to +90 nt from pegRNA nick) to bias DNA repair toward prime-edited strands.
//
// Setup: PE3/PE3b optimization module calculating nicking distance, indel risks, and mismatch-dependent PE3b selectivity.
//
// Beats:
//   1. Define Pe3NickingGuide and Pe3SystemScore data structures.
//   2. Filter candidate nicking guides in the +40 to +90 nt optimal window on the non-edited strand.
//   3. Model PE3b edit-specific sgRNA binding to reduce double-strand breaks.

pub type Pe3NickingGuide = struct {
    guide_seq: String,
    pam_seq: String,
    nick_distance_bp: Int,
    is_pe3b_mode: Bool,
    is_in_optimal_window: Bool,
};

pub type Pe3SystemScore = struct {
    prime_editing_efficiency: Float,
    indel_frequency_pct: Float,
    pe3b_specificity_gain: Float,
};

pub fn pe3_is_optimal_distance(dist: Int) -> Bool {
    return dist >= 40 && dist <= 90;
}

pub fn pe3_evaluate_system(nick_dist: Int, is_pe3b: Bool) -> Pe3SystemScore {
    let opt = pe3_is_optimal_distance(nick_dist);
    let mut base_eff = 35.0;
    let mut indel_rate = 2.0;

    if opt {
        base_eff = base_eff * 2.2;
        indel_rate = 4.5;
    }
    if is_pe3b {
        indel_rate = 0.8;
    }

    let spec_gain = if is_pe3b { 3.5 } else { 1.0 };

    return Pe3SystemScore {
        prime_editing_efficiency: base_eff,
        indel_frequency_pct: indel_rate,
        pe3b_specificity_gain: spec_gain,
    };
}
