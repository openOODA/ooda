// # MIT CRISPR Specificity Score Calculator
//
// Logline: Implements the MIT genome-wide off-target specificity score aggregating weighted single-guide mismatch penalties.
//
// Setup: Empirical specificity scoring engine ranking guide RNAs on a 0-100 specificity scale for human and mammalian genome editing.
//
// Beats:
//   1. Define MitOffTargetSite and MitCompositeScore data structures.
//   2. Compute pairwise mismatch penalty factors based on inter-mismatch distance and position.
//   3. Aggregate cumulative 100 / (100 + sum(scores)) guide specificity rating.

pub type MitOffTargetSite = struct {
    site_seq: String,
    mismatch_count: Int,
    hit_score: Float,
};

pub type MitCompositeScore = struct {
    guide_seq: String,
    composite_mit_score: Float,
    tier: String,
};

pub fn mit_calc_hit_score(mismatches: Int, avg_dist: Float) -> Float {
    if mismatches == 0 { return 100.0; }
    let base_factor = 1.0 / ((mismatches as Float) * 1.5);
    let dist_factor = 1.0 / (1.0 + (19.0 - avg_dist) / 19.0);
    return base_factor * dist_factor * 100.0;
}

pub fn mit_calculate_composite(guide: String, sum_hit_scores: Float) -> MitCompositeScore {
    let score = 100.0 / (1.0 + (sum_hit_scores / 100.0));
    let mut tier = "LOW_SPECIFICITY";
    if score >= 75.0 {
        tier = "HIGH_SPECIFICITY";
    } else if score >= 50.0 {
        tier = "MODERATE_SPECIFICITY";
    }

    return MitCompositeScore {
        guide_seq: guide,
        composite_mit_score: score,
        tier: tier,
    };
}
