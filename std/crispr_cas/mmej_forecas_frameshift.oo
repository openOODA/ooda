// # FORECas Knockout Frameshift & InDel Profiler
//
// Logline: Predicts gene knockout frameshift frequencies and indel length distributions from cut-site flanking sequences.
//
// Setup: High-throughput genetic screening module determining whether repair products cause functional loss-of-function frameshifts.
//
// Beats:
//   1. Define ForecasProfile and FrameshiftScore structures.
//   2. Compute the proportion of out-of-frame (not divisible by 3) indel outcomes.
//   3. Rank guide RNAs for maximum gene knockout efficacy.

pub type ForecasProfile = struct {
    in_frame_pct: Float,
    out_of_frame_pct: Float,
    dominant_deletion_len: Int,
};

pub type FrameshiftScore = struct {
    knockout_efficiency_pct: Float,
    frameshift_tier: String,
    recommended_for_ko_screen: Bool,
};

pub fn forecas_evaluate_context(seq_8nt: String) -> FrameshiftScore {
    let n = chars_len(seq_8nt);
    let mut oof: Float = 72.0;

    if n >= 8 {
        let p3 = char_at(seq_8nt, 3);
        let p4 = char_at(seq_8nt, 4);
        if (p3 == "G" || p3 == "g") && (p4 == "G" || p4 == "g") {
            oof = 88.0;
        }
    }

    let rec = oof >= 70.0;
    let tier = if oof >= 80.0 { "HIGH_KO_EFFICIENCY" } else { "MODERATE_KO" };

    return FrameshiftScore {
        knockout_efficiency_pct: oof,
        frameshift_tier: tier,
        recommended_for_ko_screen: rec,
    };
}
