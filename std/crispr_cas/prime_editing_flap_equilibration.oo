// # Prime Editing 3' Flap Hybridization & FEN1 Equilibration
//
// Logline: Simulates 3' edited flap hybridization thermodynamics versus 5' unedited genomic flap displacement and FEN1 cleavage.
//
// Setup: Biophysical kinetic module calculating thermodynamic competition between newly synthesized 3' edited flap and unedited genomic strand.
//
// Beats:
//   1. Define FlapEquilibriumState and Fen1CleavageKinetics structures.
//   2. Calculate Gibbs free energy difference (delta G) between 3' edited and 5' unedited flap duplexes.
//   3. Compute FEN1 endonuclease excision probability and permanent edit incorporation yield.

pub type FlapEquilibriumState = struct {
    edited_flap_dg: Float,
    unedited_flap_dg: Float,
    flap_length: Int,
    equilibrium_ratio_3prime: Float,
};

pub type Fen1CleavageKinetics = struct {
    cleavage_rate_per_sec: Float,
    resolution_probability: Float,
    ligation_efficiency_pct: Float,
};

pub fn flap_calc_equilibrium(edited_dg: Float, unedited_dg: Float, len_bp: Int) -> FlapEquilibriumState {
    let diff = unedited_dg - edited_dg;
    let ratio = if diff > 0.0 { 0.75 } else { 0.45 };

    return FlapEquilibriumState {
        edited_flap_dg: edited_dg,
        unedited_flap_dg: unedited_dg,
        flap_length: len_bp,
        equilibrium_ratio_3prime: ratio,
    };
}

pub fn flap_model_fen1(state: &FlapEquilibriumState) -> Fen1CleavageKinetics {
    let r3 = (state).equilibrium_ratio_3prime;
    let rate = 12.5 * r3;
    let resol = r3 * 0.90;
    let lig = resol * 95.0;

    return Fen1CleavageKinetics {
        cleavage_rate_per_sec: rate,
        resolution_probability: resol,
        ligation_efficiency_pct: lig,
    };
}
