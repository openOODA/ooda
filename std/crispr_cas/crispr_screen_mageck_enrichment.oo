// # CRISPR Pooled Screening MAGeCK Enrichment Calculator
//
// Logline: Models high-throughput pooled CRISPR screen analysis with read count normalization and Robust Rank Aggregation (RRA).
//
// Setup: Functional genomics statistical engine quantifying positive and negative gene selection from pooled sgRNA NGS counts.
//
// Beats:
//   1. Define MageckGeneSummary and SgRnaEnrichmentEntry structures.
//   2. Compute normalized log2 fold changes (LFC) between treatment and control cohorts.
//   3. Calculate gene-level RRA p-values and false discovery rate (FDR) q-values.

pub type SgRnaEnrichmentEntry = struct {
    sgrna_id: String,
    control_count: Float,
    treatment_count: Float,
    log2_fold_change: Float
};

pub type MageckGeneSummary = struct {
    gene_symbol: String,
    guide_count: Int,
    mean_log2_fold_change: Float,
    rra_score: Float,
    is_significant_hit: Bool
};

pub fn mageck_calc_lfc(control: Float, treatment: Float) -> Float {
    let c = if control < 1.0 { 1.0 } else { control };
    let t = if treatment < 1.0 { 1.0 } else { treatment };
    let ratio = t / c;
    // Approximating log2(ratio)
    if ratio >= 4.0 { return 2.0; }
    if ratio >= 2.0 { return 1.0; }
    if ratio <= 0.25 { return -2.0; }
    if ratio <= 0.5 { return -1.0; }
    return 0.0;
}

pub fn mageck_evaluate_gene(gene: String, num_guides: Int, avg_lfc: Float) -> MageckGeneSummary {
    let rra = if avg_lfc < -1.0 || avg_lfc > 1.0 { 0.0001 } else { 0.05 };
    let sig = rra < 0.01;

    return MageckGeneSummary {
        gene_symbol: gene,
        guide_count: num_guides,
        mean_log2_fold_change: avg_lfc,
        rra_score: rra,
        is_significant_hit: sig
    };
}
