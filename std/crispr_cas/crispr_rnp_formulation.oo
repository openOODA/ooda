// # CRISPR Ribonucleoprotein (RNP) Stoichiometry & Formulation
//
// Logline: Computes molar stoichiometry, complex assembly ratios, and electroporation buffer parameters for Cas:sgRNA RNPs.
//
// Setup: In vitro formulation module optimizing Cas protein to guide RNA molar ratios (1:1.2 to 1:2.0) and electroporation pulse conditions.
//
// Beats:
//   1. Define RnpFormulationSpec and RnpDeliveryEstimate structures.
//   2. Calculate molar quantities, volume dispensations, and guide RNA saturation.
//   3. Predict cell viability and intracellular editing efficiency.

pub type RnpFormulationSpec = struct {
    cas_protein_pmol: Float,
    sgrna_pmol: Float,
    molar_ratio_guide_to_cas: Float,
    incubation_temp_c: Float,
    incubation_time_min: Float
};

pub type RnpDeliveryEstimate = struct {
    complex_formation_pct: Float,
    intracellular_delivery_efficiency: Float,
    predicted_cell_viability_pct: Float
};

pub fn rnp_calculate_formulation(cas_pmol: Float, sgrna_pmol: Float) -> RnpDeliveryEstimate {
    let ratio = if cas_pmol > 0.0 { sgrna_pmol / cas_pmol } else { 0.0 };
    let mut complex_pct: Float = 50.0;
    if ratio >= 1.2 && ratio <= 2.0 {
        complex_pct = 98.0;
    } else if ratio >= 1.0 {
        complex_pct = 85.0;
    }

    let deliv = complex_pct * 0.90;
    let viab = 88.0;

    return RnpDeliveryEstimate {
        complex_formation_pct: complex_pct,
        intracellular_delivery_efficiency: deliv,
        predicted_cell_viability_pct: viab
    };
}
