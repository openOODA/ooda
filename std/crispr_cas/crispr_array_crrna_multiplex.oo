// # Cas12a/Cas13 Multiplex CRISPR Array Direct Repeat Designer
//
// Logline: Designs multi-guide CRISPR arrays with Direct Repeat (DR) junctions for single-transcript multiplexed gene editing.
//
// Setup: Polycistronic CRISPR array compiler leveraging intrinsic Cas12a/Cas13 endoribonuclease processing of direct repeats.
//
// Beats:
//   1. Define MultiplexArraySpec and ArrayProcessingYield structures.
//   2. Interleave canonical Direct Repeat (DR) hairpins between spacers.
//   3. Compute individual guide processing rates and multi-locus knockout probability.

pub type MultiplexArraySpec = struct {
    direct_repeat_seq: String,
    number_of_spacers: Int,
    total_array_length_bp: Int,
    cas_system: String
};

pub type ArrayProcessingYield = struct {
    mature_crrna_fraction_pct: Float,
    multi_target_co_knockout_pct: Float,
    array_stability_tier: String
};

pub fn array_evaluate_multiplex(spacers_count: Int, cas_sys: String) -> ArrayProcessingYield {
    let mut mature_pct: Float = 92.0;
    if spacers_count > 4 {
        mature_pct = 80.0;
    }
    let co_ko = (mature_pct / 100.0) * (mature_pct / 100.0) * 100.0;
    let tier = if spacers_count <= 4 { "HIGH_PROCESSING_FIDELITY" } else { "MODERATE_POSITION_BIAS" };

    return ArrayProcessingYield {
        mature_crrna_fraction_pct: mature_pct,
        multi_target_co_knockout_pct: co_ko,
        array_stability_tier: tier
    };
}
