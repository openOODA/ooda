// # MMEJ Flanking Microhomology Repeat Scanner
//
// Logline: Scans sequences flanking CRISPR double-strand breaks for microhomologies (2-8 bp) to compute Sfeir-Symington MMEJ scores.
//
// Setup: Deletion outcome modeling engine identifying identical short repeat patterns across the DSB junction.
//
// Beats:
//   1. Define MicrohomologyRepeat and MmejDeletionPrediction structures.
//   2. Scan left and right flanking windows for identical k-mer repeats.
//   3. Compute repeat length, intervening distance, and deletion probability.

pub type MicrohomologyRepeat = struct {
    repeat_seq: String,
    repeat_length: Int,
    deletion_size_bp: Int,
    repeat_gc_count: Int,
};

pub type MmejDeletionPrediction = struct {
    microhomology_strength: Float,
    predicted_frequency_pct: Float,
    is_dominant_outcome: Bool,
};

pub fn mmej_score_repeat(len_bp: Int, del_size: Int, gc_count: Int) -> MmejDeletionPrediction {
    if len_bp < 2 {
        return MmejDeletionPrediction {
            microhomology_strength: 0.0,
            predicted_frequency_pct: 0.0,
            is_dominant_outcome: false,
        };
    }

    // Sfeir-Symington model: Score ~ (length + 0.5 * GC) * exp(-0.05 * del_size)
    let len_term = (len_bp as Float) + ((gc_count as Float) * 0.5);
    let dist_factor = 1.0 / (1.0 + ((del_size as Float) * 0.04));
    let strength = len_term * dist_factor * 10.0;
    let mut freq = strength * 2.5;
    if freq > 80.0 { freq = 80.0; }
    let dominant = freq > 40.0;

    return MmejDeletionPrediction {
        microhomology_strength: strength,
        predicted_frequency_pct: freq,
        is_dominant_outcome: dominant,
    };
}
