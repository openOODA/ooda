// # Cytosine Base Editing (CBE) Window & Efficiency Model
//
// Logline: Predicts C-to-T deamination within the canonical protospacer editing window (positions 4-8) with motif-specific kinetics.
//
// Setup: Precision CBE transition module modeling BE3, BE4max, and evoAPOBEC1 deaminase preferences (TC > CC > AC > GC).
//
// Beats:
//   1. Define CbeCandidateSite and CbeDeaminationWindow structures.
//   2. Calculate position-dependent and sequence-context deamination rates across positions 1 to 20.
//   3. Compute desired C->T edit purity versus bystander conversions and Indel side products.

pub type CbeCandidateSite = struct {
    protospacer_seq: String,
    target_pos: Int,
    target_context_motif: String,
    predicted_ct_efficiency: Float,
    bystander_c_count: Int,
    indel_rate_pct: Float,
};

pub type CbeDeaminationWindow = struct {
    window_start: Int,
    window_end: Int,
    max_efficiency_pos: Int,
};

pub fn cbe_get_canonical_window(editor: String) -> CbeDeaminationWindow {
    if editor == "BE4max" || editor == "be4max" {
        return CbeDeaminationWindow {
            window_start: 4,
            window_end: 8,
            max_efficiency_pos: 6,
        };
    }
    if editor == "evoAPOBEC1" {
        return CbeDeaminationWindow {
            window_start: 3,
            window_end: 9,
            max_efficiency_pos: 5,
        };
    }
    return CbeDeaminationWindow {
        window_start: 4,
        window_end: 8,
        max_efficiency_pos: 5,
    };
}

pub fn cbe_motif_multiplier(motif: String) -> Float {
    if motif == "TC" || motif == "tc" { return 1.0; }
    if motif == "CC" || motif == "cc" { return 0.85; }
    if motif == "AC" || motif == "ac" { return 0.60; }
    if motif == "GC" || motif == "gc" { return 0.35; }
    return 0.50;
}

pub fn cbe_evaluate_target(spacer: String, target_c_pos: Int, editor: String) -> CbeCandidateSite {
    let win = cbe_get_canonical_window(editor);
    let mut base_rate: Float = 0.0;
    if target_c_pos >= win.window_start && target_c_pos <= win.window_end {
        let dist = if target_c_pos > win.max_efficiency_pos { target_c_pos - win.max_efficiency_pos } else { win.max_efficiency_pos - target_c_pos };
        base_rate = 85.0 - ((dist as Float) * 15.0);
    } else {
        base_rate = 5.0;
    }

    let n = chars_len(spacer);
    let mut motif = "NC";
    if target_c_pos >= 2 && target_c_pos <= n {
        let prev_b = char_at(spacer, target_c_pos - 2);
        let curr_b = char_at(spacer, target_c_pos - 1);
        motif = prev_b + curr_b;
    }
    let mult = cbe_motif_multiplier(motif);
    let final_eff = base_rate * mult;

    let mut bystanders = 0;
    let mut i = win.window_start - 1;
    while i < win.window_end && i < n {
        if i != (target_c_pos - 1) {
            let b = char_at(spacer, i);
            if b == "C" || b == "c" {
                bystanders = bystanders + 1;
            }
        }
        i = i + 1;
    }

    return CbeCandidateSite {
        protospacer_seq: spacer,
        target_pos: target_c_pos,
        target_context_motif: motif,
        predicted_ct_efficiency: final_eff,
        bystander_c_count: bystanders,
        indel_rate_pct: 1.5,
    };
}
