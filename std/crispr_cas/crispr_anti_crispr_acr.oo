// # CRISPR Anti-CRISPR (Acr) Off-Switch Kinetics
//
// Logline: Simulates stoichiometric binding and temporal shut-off kinetics of anti-CRISPR proteins (AcrIIA4, AcrVA1) against Cas effectors.
//
// Setup: Precision control module calculating Acr-mediated competitive inhibition for temporal limiting of off-target edits.
//
// Beats:
//   1. Define AcrInteractionSpec and AcrInhibitionKinetics structures.
//   2. Model competitive binding equilibrium between Acr proteins and Cas9/Cas12a target DNA complexes.
//   3. Compute time-dependent nuclease attenuation curve and off-target reduction factor.

pub type AcrInteractionSpec = struct {
    acr_name: String,
    target_cas: String,
    affinity_kd_nm: Float,
    inhibition_mechanism: String,
};

pub type AcrInhibitionKinetics = struct {
    remaining_cas_activity_pct: Float,
    off_target_suppression_fold: Float,
    half_inhibition_time_min: Float,
};

pub fn acr_get_standard_spec(acr_name: String) -> AcrInteractionSpec {
    if acr_name == "AcrIIA4" {
        return AcrInteractionSpec {
            acr_name: "AcrIIA4",
            target_cas: "SpCas9",
            affinity_kd_nm: 0.6,
            inhibition_mechanism: "PAM_occlusion",
        };
    }
    if acr_name == "AcrVA1" {
        return AcrInteractionSpec {
            acr_name: "AcrVA1",
            target_cas: "Cas12a",
            affinity_kd_nm: 1.2,
            inhibition_mechanism: "crRNA_cleavage",
        };
    }
    return AcrInteractionSpec {
        acr_name: "AcrIIA2",
        target_cas: "SpCas9",
        affinity_kd_nm: 2.5,
        inhibition_mechanism: "DNA_binding_block",
    };
}

pub fn acr_compute_kinetics(spec: &AcrInteractionSpec, acr_conc_nm: Float, delay_hours: Float) -> AcrInhibitionKinetics {
    let kd = (spec).affinity_kd_nm;
    let fraction_bound = acr_conc_nm / (acr_conc_nm + kd);
    let mut remaining = (1.0 - fraction_bound) * 100.0;
    if delay_hours > 6.0 {
        remaining = remaining * 0.5;
    }
    let suppression = 1.0 / ((remaining / 100.0) + 0.01);
    let t_half = kd * 2.5;

    return AcrInhibitionKinetics {
        remaining_cas_activity_pct: remaining,
        off_target_suppression_fold: suppression,
        half_inhibition_time_min: t_half,
    };
}
