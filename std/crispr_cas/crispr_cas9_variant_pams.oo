// # CRISPR Engineered Cas9 Near-PAMless Variant Engine
//
// Logline: Models expanded genomic targeting by engineered Cas9 variants including SpCas9-NG, SpG, SpRY, and xCas9.
//
// Setup: Multi-variant PAM relaxation framework evaluating target accessibility across non-canonical PAM trinucleotides.
//
// Beats:
//   1. Define CasVariantPAM and VariantTargetScore data structures.
//   2. Characterize PAM flexibility for SpCas9-NG (NG), SpG (NGN), and SpRY (NRN/NYN).
//   3. Compute variant-specific cleavage activity penalty versus wild-type SpCas9.

pub type CasVariantPAM = struct {
    variant_name: String,
    pam_motif: String,
    relative_activity: Float,
    mismatch_tolerance: Float
};

pub type VariantTargetScore = struct {
    is_accessible: Bool,
    adjusted_activity_score: Float,
    off_target_propensity: Float
};

pub fn variant_is_ng(pam: String) -> Bool {
    if chars_len(pam) < 2 { return false; }
    let c1 = char_at(pam, 1);
    return c1 == "G" || c1 == "g";
}

pub fn variant_is_spg(pam: String) -> Bool {
    return variant_is_ng(pam);
}

pub fn variant_is_spry(pam: String) -> Bool {
    return chars_len(pam) >= 3;
}

pub fn variant_evaluate_target(variant: String, pam: String, base_score: Float) -> VariantTargetScore {
    if variant == "SpCas9-NG" {
        let ok = variant_is_ng(pam);
        let act = if ok { base_score * 0.88 } else { 0.0 };
        return VariantTargetScore {
            is_accessible: ok,
            adjusted_activity_score: act,
            off_target_propensity: 1.2
        };
    }
    if variant == "SpG" {
        let ok = variant_is_spg(pam);
        let act = if ok { base_score * 0.85 } else { 0.0 };
        return VariantTargetScore {
            is_accessible: ok,
            adjusted_activity_score: act,
            off_target_propensity: 1.35
        };
    }
    if variant == "SpRY" {
        let ok = variant_is_spry(pam);
        let act = if ok { base_score * 0.75 } else { 0.0 };
        return VariantTargetScore {
            is_accessible: ok,
            adjusted_activity_score: act,
            off_target_propensity: 1.8
        };
    }
    let is_wt = chars_len(pam) >= 3 && char_at(pam, 1) == "G" && char_at(pam, 2) == "G";
    let act = if is_wt { base_score } else { 0.0 };
    return VariantTargetScore {
        is_accessible: is_wt,
        adjusted_activity_score: act,
        off_target_propensity: 1.0
    };
}
