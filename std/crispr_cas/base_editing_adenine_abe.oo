// # Adenine Base Editing (ABE) Window & TadA Catalysis
//
// Logline: Models A-to-G transition deamination mediated by engineered TadA deaminases (ABE7.10, ABE8e, ABE8.20m).
//
// Setup: Precision ABE transition module computing deamination efficiency, editing windows, and bystander adenine rates.
//
// Beats:
//   1. Define AbeTargetProfile and AbeEnzymeParameters data structures.
//   2. Compute position-dependent deamination curves across protospacer positions 3 to 9.
//   3. Compare high-speed TadA-8e kinetics versus narrow-window ABE7.10 precision.

pub type AbeTargetProfile = struct {
    protospacer_seq: String,
    target_a_pos: Int,
    predicted_ag_efficiency: Float,
    bystander_a_count: Int,
    purity_pct: Float
};

pub type AbeEnzymeParameters = struct {
    enzyme_name: String,
    window_start: Int,
    window_end: Int,
    peak_pos: Int,
    catalytic_rate_multiplier: Float
};

pub fn abe_get_params(enzyme: String) -> AbeEnzymeParameters {
    if enzyme == "ABE8e" || enzyme == "abe8e" {
        return AbeEnzymeParameters {
            enzyme_name: "ABE8e",
            window_start: 3,
            window_end: 9,
            peak_pos: 6,
            catalytic_rate_multiplier: 1.6
        };
    }
    return AbeEnzymeParameters {
        enzyme_name: "ABE7.10",
        window_start: 4,
        window_end: 7,
        peak_pos: 5,
        catalytic_rate_multiplier: 1.0
    };
}

pub fn abe_evaluate_adenine(spacer: String, a_pos: Int, enzyme: String) -> AbeTargetProfile {
    let p = abe_get_params(enzyme);
    let mut eff: Float = 0.0;
    if a_pos >= p.window_start && a_pos <= p.window_end {
        let delta = if a_pos > p.peak_pos { a_pos - p.peak_pos } else { p.peak_pos - a_pos };
        let base_act = 90.0 - ((delta as Float) * 12.0);
        eff = base_act * p.catalytic_rate_multiplier;
        if eff > 95.0 { eff = 95.0; }
    } else {
        eff = 2.0;
    }

    let n = chars_len(spacer);
    let mut bystanders = 0;
    let mut i = p.window_start - 1;
    while i < p.window_end && i < n {
        if i != (a_pos - 1) {
            let b = char_at(spacer, i);
            if b == "A" || b == "a" {
                bystanders = bystanders + 1;
            }
        }
        i = i + 1;
    }

    let purity = if bystanders == 0 { 99.0 } else { 100.0 / ((bystanders as Float) + 1.0) };

    return AbeTargetProfile {
        protospacer_seq: spacer,
        target_a_pos: a_pos,
        predicted_ag_efficiency: eff,
        bystander_a_count: bystanders,
        purity_pct: purity
    };
}
