// # ATAC-seq Chromatin Openness & Accessibility Integrator
//
// Logline: Intersects genomic CRISPR target loci with ATAC-seq open chromatin peak datasets to adjust in vivo Cas accessibility.
//
// Setup: Epigenomic integration engine calculating Tn5 transposase insertion signal density and nucleosome depletion multipliers.
//
// Beats:
//   1. Define AtacSeqPeak and ChromatinAccessibilityScore structures.
//   2. Determine peak intersection, peak signal enrichment, and distance to peak summit.
//   3. Compute Cas9 / Cas12a in vivo target search acceleration factor.

pub type AtacSeqPeak = struct {
    chromosome: String,
    start_pos: Int,
    end_pos: Int,
    signal_value: Float,
    p_value_neg_log10: Float
};

pub type ChromatinAccessibilityScore = struct {
    is_in_open_peak: Bool,
    accessibility_multiplier: Float,
    estimated_search_time_sec: Float
};

pub fn atac_intersects(locus_pos: Int, peak_start: Int, peak_end: Int) -> Bool {
    return locus_pos >= peak_start && locus_pos <= peak_end;
}

pub fn atac_compute_score(locus_pos: Int, peak: &AtacSeqPeak) -> ChromatinAccessibilityScore {
    let in_peak = atac_intersects(locus_pos, (peak).start_pos, (peak).end_pos);
    if !in_peak {
        return ChromatinAccessibilityScore {
            is_in_open_peak: false,
            accessibility_multiplier: 0.35,
            estimated_search_time_sec: 120.0
        };
    }

    let sig = (peak).signal_value;
    let mut mult: Float = 1.0 + (sig * 0.1);
    if mult > 2.5 { mult = 2.5; }
    let time = 30.0 / mult;

    return ChromatinAccessibilityScore {
        is_in_open_peak: true,
        accessibility_multiplier: mult,
        estimated_search_time_sec: time
    };
}
