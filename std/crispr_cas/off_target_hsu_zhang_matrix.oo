// # CRISPR Hsu-Zhang Position-Weighted Off-Target Matrix
//
// Logline: Evaluates Cas9 guide specificity using the classic Hsu-Zhang exponential distance decay matrix and mismatch penalties.
//
// Setup: Specificity engine calculating position-weighted cleavage inhibition and aggregate genome-wide off-target hazard metrics.
//
// Beats:
//   1. Define HsuZhangMatch and HsuZhangLocusScore structures.
//   2. Apply position-dependent mismatch weights (e.g. strict seed vs distal tolerance).
//   3. Compute aggregate locus specificity index and guide safety classification.

pub type HsuZhangMatch = struct {
    guide_seq: String,
    offtarget_seq: String,
    mismatches: Int,
    seed_mismatches: Int,
    cutting_percentage: Float,
};

pub type HsuZhangLocusScore = struct {
    composite_specificity_score: Float,
    total_predicted_offtargets: Int,
    safety_tier: String,
};

pub fn hsu_weight(pos_from_pam: Int) -> Float {
    if pos_from_pam == 1 { return 0.0; }
    if pos_from_pam == 2 { return 0.0; }
    if pos_from_pam == 3 { return 0.014; }
    if pos_from_pam == 4 { return 0.0; }
    if pos_from_pam == 5 { return 0.0; }
    if pos_from_pam == 6 { return 0.395; }
    if pos_from_pam == 7 { return 0.317; }
    if pos_from_pam == 8 { return 0.0; }
    if pos_from_pam == 9 { return 0.389; }
    if pos_from_pam == 10 { return 0.079; }
    if pos_from_pam == 11 { return 0.445; }
    if pos_from_pam == 12 { return 0.508; }
    if pos_from_pam == 13 { return 0.613; }
    if pos_from_pam == 14 { return 0.851; }
    if pos_from_pam == 15 { return 0.732; }
    if pos_from_pam == 16 { return 0.828; }
    if pos_from_pam == 17 { return 0.615; }
    if pos_from_pam == 18 { return 0.804; }
    if pos_from_pam == 19 { return 0.685; }
    if pos_from_pam == 20 { return 0.669; }
    return 1.0;
}

pub fn hsu_score_pair(guide: String, target: String) -> HsuZhangMatch {
    let glen = chars_len(guide);
    let tlen = chars_len(target);
    let n = if glen < tlen { glen } else { tlen };

    let mut mismatches = 0;
    let mut seed_mismatches = 0;
    let mut product: Float = 1.0;

    let mut i = 0;
    while i < n {
        let gb = char_at(guide, i);
        let tb = char_at(target, i);
        let pos_pam = n - i;
        if gb != tb {
            mismatches = mismatches + 1;
            if pos_pam <= 8 {
                seed_mismatches = seed_mismatches + 1;
            }
            let w = hsu_weight(pos_pam);
            product = product * (1.0 - w);
        }
        i = i + 1;
    }

    let cut_pct = if mismatches == 0 { 100.0 } else { product * 100.0 };

    return HsuZhangMatch {
        guide_seq: guide,
        offtarget_seq: target,
        mismatches: mismatches,
        seed_mismatches: seed_mismatches,
        cutting_percentage: cut_pct,
    };
}
