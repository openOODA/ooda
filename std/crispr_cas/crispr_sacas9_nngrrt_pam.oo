// # CRISPR SaCas9 5'-NNGRRT-3' PAM Selector
//
// Logline: Scans genomes for Staphylococcus aureus Cas9 NNGRRT PAM sites and evaluates 21-23 nt spacer efficacy for single-AAV in vivo therapy.
//
// Setup: Compact Type II-A Cas9 targeting engine with extended 6-nt PAM recognition and high in vivo cleavage fidelity.
//
// Beats:
//   1. Define SaCas9TargetSite and SaCas9ScanConfig structures.
//   2. Scan DNA sequences for 5'-NNGRRT-3' (R = A/G) hexanucleotide PAM motifs.
//   3. Calculate spacer GC-content and AAV vector payload clearance.

pub type SaCas9TargetSite = struct {
    pam_motif: String,
    spacer_seq: String,
    strand: String,
    cut_offset: Int,
    gc_percent: Float,
    is_canonical: Bool,
};

pub type SaCas9ScanConfig = struct {
    spacer_length: Int,
    allow_non_canonical: Bool,
};

pub fn sacas9_is_r(c: String) -> Bool {
    return c == "A" || c == "a" || c == "G" || c == "g";
}

pub fn sacas9_match_pam(pam: String) -> Bool {
    if chars_len(pam) != 6 { return false; }
    let c2 = char_at(pam, 2);
    let c3 = char_at(pam, 3);
    let c4 = char_at(pam, 4);
    let c5 = char_at(pam, 5);
    let is_g2 = (c2 == "G" || c2 == "g");
    let is_r3 = sacas9_is_r(c3);
    let is_r4 = sacas9_is_r(c4);
    let is_t5 = (c5 == "T" || c5 == "t");
    return is_g2 && is_r3 && is_r4 && is_t5;
}

pub fn sacas9_calc_gc(seq: String) -> Float {
    let n = chars_len(seq);
    if n == 0 { return 0.0; }
    let mut gc = 0;
    let mut i = 0;
    while i < n {
        let c = char_at(seq, i);
        if c == "G" || c == "g" || c == "C" || c == "c" {
            gc = gc + 1;
        }
        i = i + 1;
    }
    return ((gc as Float) / (n as Float)) * 100.0;
}

pub fn sacas9_slice(seq: String, start: Int, length: Int) -> String {
    let n = chars_len(seq);
    let mut out = "";
    let mut i = 0;
    while i < length && (start + i) < n {
        out = out + char_at(seq, start + i);
        i = i + 1;
    }
    return out;
}

pub fn sacas9_find_targets(seq: String, cfg: &SaCas9ScanConfig) -> List[SaCas9TargetSite] {
    let mut list: List[SaCas9TargetSite] = list_new();
    let n = chars_len(seq);
    let s_len = (cfg).spacer_length;
    let total_len = s_len + 6;
    if n < total_len { return list; }

    let mut i = s_len;
    while i <= n - 6 {
        let pam_sub = sacas9_slice(seq, i, 6);
        if sacas9_match_pam(pam_sub) {
            let spacer = sacas9_slice(seq, i - s_len, s_len);
            let gc = sacas9_calc_gc(spacer);
            let site = SaCas9TargetSite {
                pam_motif: pam_sub,
                spacer_seq: spacer,
                strand: "+",
                cut_offset: i - 3,
                gc_percent: gc,
                is_canonical: true,
            };
            list_push(list, site);
        }
        i = i + 1;
    }
    return list;
}
