// # CRISPR SpCas9 Guide RNA Designer
//
// Logline: Designs 20-nt single guide RNAs targeting SpCas9 canonical 5'-NGG-3' PAM sites with GC-content and poly-T filtering.
//
// Setup: High-efficiency protospacer search engine scanning positive and negative genomic DNA strands for optimal Streptococcus pyogenes Cas9 targets.
//
// Beats:
//   1. Define Cas9GuideCandidate and Cas9DesignConfig structures.
//   2. Scan genomic sequences for forward and reverse complement NGG PAM sites.
//   3. Compute GC-content percentage, poly-T termination penalties, and initial suitability rank.

type Cas9GuideCandidate = struct {
    spacer_seq: String,
    pam_seq: String,
    strand: String,
    cut_position: Int,
    gc_percent: Float,
    has_poly_t: Bool,
    initial_score: Float
};

type Cas9DesignConfig = struct {
    min_gc: Float,
    max_gc: Float,
    avoid_poly_t: Bool,
    target_strand: String
};

pub fn cas9_calc_gc_percent(seq_len: Int, gc_count: Int) -> Float {
    if seq_len <= 0 { return 0.0; }
    return ((gc_count as Float) / (seq_len as Float)) * 100.0;
}

pub fn cas9_compute_suitability(gc: Float, has_poly_t: Bool, min_gc: Float, max_gc: Float) -> Float {
    let mut score = 100.0;
    if gc < min_gc {
        let diff = min_gc - gc;
        score = score - (diff * 2.0);
    } else if gc > max_gc {
        let diff = gc - max_gc;
        score = score - (diff * 2.0);
    }
    if has_poly_t {
        score = score - 40.0;
    }
    if score < 0.0 {
        return 0.0;
    }
    return score;
}

pub fn cas9_design_single_guide(
    spacer: String,
    pam: String,
    gc_count: Int,
    has_poly_t: Bool,
    cut_pos: Int,
    cfg: &Cas9DesignConfig,
) -> Cas9GuideCandidate {
    let gc = cas9_calc_gc_percent(20, gc_count);
    let score = cas9_compute_suitability(gc, has_poly_t, (cfg).min_gc, (cfg).max_gc);
    return Cas9GuideCandidate {
        spacer_seq: spacer,
        pam_seq: pam,
        strand: "+",
        cut_position: cut_pos,
        gc_percent: gc,
        has_poly_t: has_poly_t,
        initial_score: score
    };
}
