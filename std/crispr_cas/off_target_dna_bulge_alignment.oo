// # CRISPR InDel & Bulge-Aware Off-Target Aligner
//
// Logline: Models DNA bulges and RNA bulges (1-2 bp insertions/deletions) in Cas9 guide-target duplexes for comprehensive off-target detection.
//
// Setup: Dynamic programming alignment module identifying non-canonical bulged off-target binding sites tolerated by Cas9 nucleases.
//
// Beats:
//   1. Define BulgeAlignmentResult and BulgeAlignmentConfig structures.
//   2. Perform gap-tolerant alignment differentiating DNA bulges (target extra base) and RNA bulges (guide extra base).
//   3. Apply position-dependent energetic penalties for bulges in seed versus non-seed regions.

pub type BulgeAlignmentResult = struct {
    bulge_type: String,
    bulge_position: Int,
    bulge_size: Int,
    mismatch_count: Int,
    cleavage_penalty: Float,
    retained_cleavage_pct: Float
};

pub type BulgeAlignmentConfig = struct {
    max_bulge_size: Int,
    allow_dna_bulge: Bool,
    allow_rna_bulge: Bool
};

pub fn bulge_score_penalty(bulge_type: String, bulge_pos_from_pam: Int, bulge_len: Int) -> Float {
    if bulge_len > 2 { return 0.02; }
    // Bulges in the seed region (1-6) drastically abolish cutting
    if bulge_pos_from_pam <= 6 {
        return 0.05;
    }
    // Bulges in position 7-15 retain moderate cutting (up to 30-50%)
    if bulge_pos_from_pam <= 15 {
        return 0.35;
    }
    // Distal bulges (16-20) are well tolerated
    return 0.65;
}

pub fn bulge_evaluate(bulge_type: String, pos_from_pam: Int, size: Int, mismatches: Int) -> BulgeAlignmentResult {
    let pen = bulge_score_penalty(bulge_type, pos_from_pam, size);
    let mut retain = pen * 100.0;
    if mismatches > 0 {
        retain = retain * 0.4;
    }

    return BulgeAlignmentResult {
        bulge_type: bulge_type,
        bulge_position: pos_from_pam,
        bulge_size: size,
        mismatch_count: mismatches,
        cleavage_penalty: pen,
        retained_cleavage_pct: retain
    };
}
