// # Twin Prime Editing (TwinPE) Dual pegRNA Pair Designer
//
// Logline: Designs paired dual-pegRNAs for installation of large DNA insertions, sequence inversions, and recombinase target sites (attB/attP).
//
// Setup: Dual-flap prime editing framework coordinating paired prime editors to generate complementary single-stranded DNA flaps.
//
// Beats:
//   1. Define TwinPePair and TwinPeRecombinationConfig data structures.
//   2. Design forward and reverse pegRNA extensions producing complementary 3' overhang flaps.
//   3. Compute flap hybridization free energy and large-fragment insertion rates.

pub type TwinPePair = struct {
    forward_peg_spacer: String,
    reverse_peg_spacer: String,
    forward_rtt_seq: String,
    reverse_rtt_seq: String,
    inter_nick_distance_bp: Int,
    flap_complementarity_len: Int,
};

pub type TwinPeRecombinationConfig = struct {
    insert_payload_len: Int,
    recombinase_site_name: String,
    predicted_insertion_efficiency: Float,
};

pub fn twin_pe_validate_pair(inter_nick_dist: Int, flap_comp_len: Int) -> Bool {
    let dist_ok = (inter_nick_dist >= 20 && inter_nick_dist <= 60);
    let comp_ok = (flap_comp_len >= 15 && flap_comp_len <= 45);
    return dist_ok && comp_ok;
}

pub fn twin_pe_estimate_efficiency(pair: &TwinPePair, payload_len: Int) -> Float {
    let valid = twin_pe_validate_pair((pair).inter_nick_distance_bp, (pair).flap_complementarity_len);
    if !valid { return 5.0; }
    let mut eff = 45.0;
    if payload_len > 100 {
        eff = eff - 10.0;
    }
    if payload_len > 500 {
        eff = eff - 15.0;
    }
    return eff;
}
