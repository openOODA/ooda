// # Prime Editing Reverse Transcriptase Template (RTT) Designer
//
// Logline: Optimizes RTT length, homology arm extension, and silent PAM-disrupting mutations to prevent re-nicking of prime-edited alleles.
//
// Setup: Reverse transcription template design module ensuring high-fidelity cDNA flap synthesis and genomic flap displacement.
//
// Beats:
//   1. Define RttDesignSpec and RttDisruptionSite structures.
//   2. Design silent PAM/protospacer blocking mutations into the RTT template.
//   3. Compute RTT length penalties and flap hybridization stability.

pub type RttDesignSpec = struct {
    rtt_seq: String,
    rtt_length: Int,
    homology_arm_length: Int,
    has_pam_disruption: Bool,
    predicted_incorporation_pct: Float,
};

pub type RttDisruptionSite = struct {
    original_pam: String,
    silent_mutated_pam: String,
    codon_conserved: Bool,
};

pub fn rtt_evaluate_spec(rtt_seq: String, homology_len: Int, has_pam_mut: Bool) -> RttDesignSpec {
    let rlen = chars_len(rtt_seq);
    let mut eff = 60.0;
    if rlen >= 10 && rlen <= 20 {
        eff = eff + 15.0;
    } else if rlen > 30 {
        eff = eff - 10.0;
    }
    if has_pam_mut {
        eff = eff + 20.0;
    }

    return RttDesignSpec {
        rtt_seq: rtt_seq,
        rtt_length: rlen,
        homology_arm_length: homology_len,
        has_pam_disruption: has_pam_mut,
        predicted_incorporation_pct: eff,
    };
}
