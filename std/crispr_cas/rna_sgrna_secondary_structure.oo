// # sgRNA Spacer-Scaffold Secondary Structure Analyzer
//
// Logline: Detects unwanted base-pairing interactions between spacer and scaffold stem loops to prevent Cas9 binding impairment.
//
// Setup: RNA secondary structure checker ensuring the repeat:anti-repeat stem loop and hairpin 1 remain unperturbed by spacer nucleotides.
//
// Beats:
//   1. Define SpacerScaffoldInteraction and ScaffoldDisruptionScore structures.
//   2. Scan for self-complementarity between 20-nt spacer and invariant Cas9 scaffold sequence.
//   3. Compute scaffold unfolding penalty and guide functionality prediction.

pub type SpacerScaffoldInteraction = struct {
    paired_bases_count: Int,
    disrupted_stem_loop: String,
    has_scaffold_interference: Bool,
};

pub type ScaffoldDisruptionScore = struct {
    structural_integrity_pct: Float,
    cas9_loading_capacity: Float,
    is_acceptable: Bool,
};

pub fn rna_check_pairing(spacer: String) -> SpacerScaffoldInteraction {
    let n = chars_len(spacer);
    let mut pairs = 0;
    // Check if spacer ends with GTTTT or similar scaffold-complementary motifs
    let mut i = 0;
    while i < n - 4 {
        let sub = char_at(spacer, i) + char_at(spacer, i + 1) + char_at(spacer, i + 2);
        if sub == "GTT" || sub == "GUU" || sub == "AAC" || sub == "AAU" {
            pairs = pairs + 1;
        }
        i = i + 1;
    }

    let interf = pairs >= 3;
    let stem = if interf { "STEM_LOOP_1" } else { "NONE" };

    return SpacerScaffoldInteraction {
        paired_bases_count: pairs,
        disrupted_stem_loop: stem,
        has_scaffold_interference: interf,
    };
}

pub fn rna_evaluate_scaffold(inter: &SpacerScaffoldInteraction) -> ScaffoldDisruptionScore {
    if (inter).has_scaffold_interference {
        return ScaffoldDisruptionScore {
            structural_integrity_pct: 60.0,
            cas9_loading_capacity: 0.45,
            is_acceptable: false,
        };
    }
    return ScaffoldDisruptionScore {
        structural_integrity_pct: 95.0,
        cas9_loading_capacity: 0.98,
        is_acceptable: true,
    };
}
