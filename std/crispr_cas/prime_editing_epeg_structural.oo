// # Engineered pegRNA (epegRNA) 3' Structural Motif Stabilizer
//
// Logline: Incorporates structured RNA pseudoknots (mpknot, evopreQ1) at the pegRNA 3' terminus to prevent exonucleolytic degradation.
//
// Setup: epegRNA structural protection engine designing linker motifs and pseudoknot folds to enhance PE efficiency.
//
// Beats:
//   1. Define EpegRnaMotif and EpegProtectionScore data structures.
//   2. Append validated 3' structural pseudoknots (tev-preQ1, mpknot) with optimal poly-C or U-rich linkers.
//   3. Calculate RNA stability increase and fold-enhancement in prime editing yield.

pub type EpegRnaMotif = struct {
    motif_name: String,
    motif_sequence: String,
    linker_seq: String,
    full_extension_seq: String,
};

pub type EpegProtectionScore = struct {
    stability_halflife_fold: Float,
    efficiency_fold_increase: Float,
    protection_tier: String,
};

pub fn epeg_get_motif_seq(motif_name: String) -> String {
    if motif_name == "evopreQ1" || motif_name == "tev-preQ1" {
        return "CGCGGTTCTATCTAGTTACGCGTCAAACCA";
    }
    if motif_name == "mpknot" {
        return "GCGCCTCGTGAGGAACGAGG";
    }
    return "AGACAGUUCUAGUCUU";
}

pub fn epeg_design(base_rtt_pbs: String, motif_name: String, linker: String) -> EpegRnaMotif {
    let motif = epeg_get_motif_seq(motif_name);
    let full = base_rtt_pbs + linker + motif;

    return EpegRnaMotif {
        motif_name: motif_name,
        motif_sequence: motif,
        linker_seq: linker,
        full_extension_seq: full,
    };
}

pub fn epeg_score_protection(motif_name: String) -> EpegProtectionScore {
    if motif_name == "evopreQ1" || motif_name == "tev-preQ1" {
        return EpegProtectionScore {
            stability_halflife_fold: 3.2,
            efficiency_fold_increase: 2.8,
            protection_tier: "HIGH_RESISTANCE",
        };
    }
    return EpegProtectionScore {
        stability_halflife_fold: 2.1,
        efficiency_fold_increase: 1.9,
        protection_tier: "MEDIUM_RESISTANCE",
    };
}
