// # Prime Editing pegRNA Architecture Designer
//
// Logline: Designs prime editing guide RNAs (pegRNAs) integrating spacer, scaffold, Reverse Transcriptase Template (RTT), and Primer Binding Site (PBS).
//
// Setup: Comprehensive pegRNA engineering module for PE2, PE3, and PEmax search-and-replace genome modifications.
//
// Beats:
//   1. Define PegRnaSpec and PegDesignConfig data structures.
//   2. Construct pegRNA 3' extension components (PBS and RTT) tailored to target edit type.
//   3. Compute full-length pegRNA sequence, melting temperatures, and synthesis viability.

pub type PegRnaSpec = struct {
    spacer_seq: String,
    scaffold_seq: String,
    rtt_seq: String,
    pbs_seq: String,
    full_pegrna_length: Int,
    pbs_length: Int,
    rtt_length: Int,
    edit_type: String,
};

pub type PegDesignConfig = struct {
    pbs_length_target: Int,
    rtt_length_target: Int,
    target_edit: String,
};

pub fn peg_combine_extension(rtt: String, pbs: String) -> String {
    return rtt + pbs;
}

pub fn peg_create_spec(spacer: String, scaffold: String, rtt: String, pbs: String, edit_type: String) -> PegRnaSpec {
    let p_len = chars_len(pbs);
    let r_len = chars_len(rtt);
    let s_len = chars_len(spacer);
    let sc_len = chars_len(scaffold);
    let total = s_len + sc_len + r_len + p_len;

    return PegRnaSpec {
        spacer_seq: spacer,
        scaffold_seq: scaffold,
        rtt_seq: rtt,
        pbs_seq: pbs,
        full_pegrna_length: total,
        pbs_length: p_len,
        rtt_length: r_len,
        edit_type: edit_type,
    };
}
