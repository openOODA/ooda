// # CRISPR Cas12f (CasMINI) Compact Nuclease Designer
//
// Logline: Models miniature Type V-F Cas12f / CasMINI nucleases requiring 5'-TTTR-3' PAMs for ultra-compact viral vector delivery.
//
// Setup: Compact nuclease design engine optimizing 400-500 amino acid Cas12f effectors and engineered guide scaffolds.
//
// Beats:
//   1. Define Cas12fGuideSpec and Cas12fScoreProfile data structures.
//   2. Validate 5'-TTTR-3' (R = A/G) PAM motifs and engineered sgRNA scaffold compatibility.
//   3. Compute guide truncation tolerance and AAV payload volume conservation.

pub type Cas12fGuideSpec = struct {
    pam_motif: String,
    spacer_seq: String,
    spacer_length: Int,
    gc_content: Float,
    is_aav_compatible: Bool
};

pub type Cas12fScoreProfile = struct {
    pam_affinity: Float,
    scaffold_stability: Float,
    overall_mini_score: Float
};

pub fn cas12f_is_tttr(pam: String) -> Bool {
    if chars_len(pam) != 4 { return false; }
    let c0 = char_at(pam, 0);
    let c1 = char_at(pam, 1);
    let c2 = char_at(pam, 2);
    let c3 = char_at(pam, 3);
    let t0 = (c0 == "T" || c0 == "t");
    let t1 = (c1 == "T" || c1 == "t");
    let t2 = (c2 == "T" || c2 == "t");
    let r3 = (c3 == "A" || c3 == "a" || c3 == "G" || c3 == "g");
    return t0 && t1 && t2 && r3;
}

pub fn cas12f_calc_gc(seq: String) -> Float {
    let n = chars_len(seq);
    if n == 0 { return 0.0; }
    let mut gc = 0;
    let mut i = 0;
    while i < n {
        let c = char_at(seq, i);
        if c == "G" || c == "g" || c == "C" || c == "c" {
            gc = gc + 1;
        }
        i = i + 1;
    }
    return ((gc * 1.0) / (n * 1.0)) * 100.0;
}

pub fn cas12f_evaluate_score(gc: Float, pam: String) -> Cas12fScoreProfile {
    let mut pam_aff = 0.5;
    if pam == "TTTA" || pam == "ttta" { pam_aff = 0.95; }
    if pam == "TTTG" || pam == "tttg" { pam_aff = 0.85; }

    let mut gc_score = 1.0;
    if gc < 35.0 || gc > 65.0 {
        gc_score = 0.7;
    }

    let mini_score = pam_aff * 60.0 + gc_score * 40.0;
    return Cas12fScoreProfile {
        pam_affinity: pam_aff,
        scaffold_stability: gc_score,
        overall_mini_score: mini_score
    };
}

pub fn cas12f_create_spec(pam: String, spacer: String) -> Cas12fGuideSpec {
    let gc = cas12f_calc_gc(spacer);
    let slen = chars_len(spacer);
    let aav_ok = slen >= 20 && slen <= 24;
    return Cas12fGuideSpec {
        pam_motif: pam,
        spacer_seq: spacer,
        spacer_length: slen,
        gc_content: gc,
        is_aav_compatible: aav_ok
    };
}
