// # Single-Stranded Oligodeoxynucleotide (ssODN) HDR Template Designer
//
// Logline: Designs asymmetric single-stranded donor templates (ssODNs) for high-efficiency homology-directed repair (HDR).
//
// Setup: Precision HDR template designer configuring asymmetric homology arms (e.g. 36 nt PAM-distal, 91 nt PAM-proximal) and strand polarity.
//
// Beats:
//   1. Define SsodnTemplateSpec and SsodnDesignResult structures.
//   2. Configure asymmetric 5' and 3' homology arms centered on the cut site.
//   3. Compute strand polarity preference (targeting vs non-targeting strand) and HDR rate.

pub type SsodnTemplateSpec = struct {
    strand_polarity: String,
    left_arm_length: Int,
    right_arm_length: Int,
    payload_edit_seq: String,
    total_oligo_length: Int,
};

pub type SsodnDesignResult = struct {
    ssodn_sequence: String,
    predicted_hdr_efficiency_pct: Float,
    incorporation_tier: String,
};

pub fn ssodn_evaluate_arms(left_len: Int, right_len: Int, strand: String) -> SsodnDesignResult {
    let total = left_len + right_len;
    let mut eff: Float = 25.0;

    // Asymmetric arms on non-target strand give superior HDR (~30-60%)
    if strand == "NON_TARGETING" || strand == "non_targeting" {
        eff = eff + 15.0;
    }
    if (left_len >= 30 && right_len >= 70) || (left_len >= 70 && right_len >= 30) {
        eff = eff + 12.0;
    }

    let tier = if eff >= 45.0 { "OPTIMAL_ASYMMETRIC" } else { "STANDARD_SYMMETRIC" };

    return SsodnDesignResult {
        ssodn_sequence: "N",
        predicted_hdr_efficiency_pct: eff,
        incorporation_tier: tier,
    };
}
