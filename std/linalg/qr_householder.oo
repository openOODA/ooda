// # Householder QR
//
// Logline: Factors A = Q R with Householder reflectors for a small dense Float matrix.
//
// Setup: Pure. A is row-major List[Float], m rows, n cols, m >= n, n at most 6.
//
// Beats:
//   1. For each column, form a Householder vector that zeros entries below the diagonal.
//   2. Apply the reflector to A from the left to build R.
//   3. Accumulate Q as a product of the same reflectors.
//   4. Return packed Q then R so a caller can reconstruct A.

fn qr_get(a: List[Float], cols: Int, i: Int, j: Int) -> Float {
    return list_get(a, i * cols + j);
}

fn qr_set(a: List[Float], cols: Int, i: Int, j: Int, v: Float) -> List[Float] {
    return list_set(a, i * cols + j, v);
}

fn qr_sign(x: Float) -> Float {
    if x < 0.0 { return 0.0 - 1.0; }
    return 1.0;
}

pub fn qr_householder_factor(a: List[Float], m: Int, n: Int) -> Result[List[Float], String] {
    if m < n { return Err("qr m < n"); }
    if list_len(a) != m * n { return Err("qr A size"); }
    let mut r: List[Float] = a;
    let mut q: List[Float] = list_new();
    let mut i0: Int = 0;
    while i0 < m {
        let mut j0: Int = 0;
        while j0 < m {
            let mut v: Float = 0.0;
            if i0 == j0 { v = 1.0; }
            q = list_push(q, v);
            j0 = j0 + 1;
        }
        i0 = i0 + 1;
    }
    let mut k: Int = 0;
    while k < n {
        let mut nrm: Float = 0.0;
        let mut i: Int = k;
        while i < m {
            let x: Float = qr_get(r, n, i, k);
            nrm = nrm + x * x;
            i = i + 1;
        }
        nrm = sqrt(nrm);
        if nrm == 0.0 { return Err("qr zero column"); }
        let akk: Float = qr_get(r, n, k, k);
        let alpha: Float = 0.0 - qr_sign(akk) * nrm;
        let mut u: List[Float] = list_new();
        i = 0;
        while i < m {
            u = list_push(u, 0.0);
            i = i + 1;
        }
        u = list_set(u, k, akk - alpha);
        i = k + 1;
        while i < m {
            u = list_set(u, i, qr_get(r, n, i, k));
            i = i + 1;
        }
        let mut un2: Float = 0.0;
        i = 0;
        while i < m {
            un2 = un2 + list_get(u, i) * list_get(u, i);
            i = i + 1;
        }
        if un2 == 0.0 { return Err("qr reflector"); }
        let mut j: Int = k;
        while j < n {
            let mut dot: Float = 0.0;
            i = 0;
            while i < m {
                dot = dot + list_get(u, i) * qr_get(r, n, i, j);
                i = i + 1;
            }
            let s: Float = 2.0 * dot / un2;
            i = 0;
            while i < m {
                let nv: Float = qr_get(r, n, i, j) - s * list_get(u, i);
                r = qr_set(r, n, i, j, nv);
                i = i + 1;
            }
            j = j + 1;
        }
        i = 0;
        while i < m {
            let mut dotq: Float = 0.0;
            j = 0;
            while j < m {
                dotq = dotq + qr_get(q, m, i, j) * list_get(u, j);
                j = j + 1;
            }
            let sq: Float = 2.0 * dotq / un2;
            j = 0;
            while j < m {
                let nq: Float = qr_get(q, m, i, j) - sq * list_get(u, j);
                q = qr_set(q, m, i, j, nq);
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
    let mut pack: List[Float] = q;
    let mut t: Int = 0;
    while t < list_len(r) {
        pack = list_push(pack, list_get(r, t));
        t = t + 1;
    }
    return Ok(pack);
}

pub fn qr_householder_reconstruct(pack: List[Float], m: Int, n: Int) -> Result[List[Float], String] {
    if list_len(pack) != m * m + m * n { return Err("qr pack size"); }
    let mut a: List[Float] = list_new();
    let mut i: Int = 0;
    while i < m {
        let mut j: Int = 0;
        while j < n {
            let mut s: Float = 0.0;
            let mut p: Int = 0;
            while p < m {
                let qv: Float = list_get(pack, i * m + p);
                let rv: Float = list_get(pack, m * m + p * n + j);
                s = s + qv * rv;
                p = p + 1;
            }
            a = list_push(a, s);
            j = j + 1;
        }
        i = i + 1;
    }
    return Ok(a);
}
