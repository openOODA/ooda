// # BLAS level-2 matrix-vector ops
//
// Logline: Computes GEMV y = alpha * A * x + beta * y and rank-1 GER A = A + alpha * x * y^T on row-major Float matrices.
//
// Setup: Pure. Matrix A is row-major List[Float] of length rows * cols.
//
// Beats:
//   1. Check row and column counts against vector lengths.
//   2. GEMV multiplies each row of A by x and scales with alpha and beta.
//   3. GER adds the outer product into A.
//   4. Refuse a size mismatch with Err.

pub fn blas_level2_gemv(alpha: Float, a: List[Float], rows: Int, cols: Int, x: List[Float], beta: Float, y: List[Float]) -> Result[List[Float], String] {
    if rows < 1 { return Err("gemv rows"); }
    if cols < 1 { return Err("gemv cols"); }
    if list_len(a) != rows * cols { return Err("gemv A size"); }
    if list_len(x) != cols { return Err("gemv x size"); }
    if list_len(y) != rows { return Err("gemv y size"); }
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < rows {
        let mut acc: Float = 0.0;
        let mut j: Int = 0;
        while j < cols {
            acc = acc + list_get(a, i * cols + j) * list_get(x, j);
            j = j + 1;
        }
        out = list_push(out, alpha * acc + beta * list_get(y, i));
        i = i + 1;
    }
    return Ok(out);
}

pub fn blas_level2_ger(alpha: Float, x: List[Float], y: List[Float], a: List[Float], rows: Int, cols: Int) -> Result[List[Float], String] {
    if list_len(x) != rows { return Err("ger x size"); }
    if list_len(y) != cols { return Err("ger y size"); }
    if list_len(a) != rows * cols { return Err("ger A size"); }
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < rows {
        let mut j: Int = 0;
        while j < cols {
            let v: Float = list_get(a, i * cols + j) + alpha * list_get(x, i) * list_get(y, j);
            out = list_push(out, v);
            j = j + 1;
        }
        i = i + 1;
    }
    return Ok(out);
}
