// # BLAS level-1 vector ops
//
// Logline: Computes dot product, Euclidean L2 norm, axpy update, and the index of the max absolute entry on Float vectors.
//
// Setup: Pure. Vectors are List[Float]. Import math.oo for sqrt.
//
// Beats:
//   1. dot_product sums u[i] * v[i] and refuses a length mismatch.
//   2. norm_l2 returns sqrt of the self-dot.
//   3. axpy writes y = a * x + y.
//   4. iamax returns the first index of a maximum absolute value.

pub fn blas_level1_dot_product(u: List[Float], v: List[Float]) -> Result[Float, String] {
    if list_len(u) != list_len(v) { return Err("blas1 length mismatch"); }
    let n: Int = list_len(u);
    let mut s: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        s = s + list_get(u, i) * list_get(v, i);
        i = i + 1;
    }
    return Ok(s);
}

pub fn blas_level1_norm_l2(v: List[Float]) -> Result[Float, String] {
    let dr: Result[Float, String] = blas_level1_dot_product(v, v);
    match dr {
        Ok(s) => { return Ok(sqrt(s)); },
        Err(e) => { return Err(e); }
    }
}

pub fn blas_level1_axpy(a: Float, x: List[Float], y: List[Float]) -> Result[List[Float], String] {
    if list_len(x) != list_len(y) { return Err("blas1 axpy length mismatch"); }
    let n: Int = list_len(x);
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, a * list_get(x, i) + list_get(y, i));
        i = i + 1;
    }
    return Ok(out);
}

pub fn blas_level1_iamax(v: List[Float]) -> Result[Int, String] {
    if list_len(v) < 1 { return Err("blas1 empty"); }
    let mut idx: Int = 0;
    let mut best: Float = list_get(v, 0);
    if best < 0.0 { best = 0.0 - best; }
    let mut i: Int = 1;
    while i < list_len(v) {
        let mut a: Float = list_get(v, i);
        if a < 0.0 { a = 0.0 - a; }
        if a > best {
            best = a;
            idx = i;
        }
        i = i + 1;
    }
    return Ok(idx);
}
