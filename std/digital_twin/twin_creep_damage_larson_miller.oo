// # Larson-Miller Parameter High-Temperature Creep Rupture Model
//
// Logline: Larson-Miller Parameter (LMP) and Robinson cumulative damage rule for high-temperature turbine creep life consumption.
//
// Setup: Evaluates time-to-rupture t_r as a function of temperature T(K) and equivalent stress sigma(MPa), integrating creep fraction D.
//
// Beats:
//   1. Define LarsonMillerParams, CreepOperatingPoint, and CreepAccumulatedDamage structures.
//   2. Compute Larson-Miller parameter LMP = T*(log10(t_r) + C) and evaluate time-to-rupture hours.
//   3. Accumulate Robinson linear creep damage fraction D = sum(Delta_t / t_r) and check rupture limits.

pub type LarsonMillerParams = struct {
    c_constant: Float, // typically 20.0 for nickel-base superalloys
    a0_coeff: Float,   // LMP polynomial fit: LMP(sigma) = a0 - a1 * sigma
    a1_coeff: Float,
    max_allowable_damage: Float,
};

pub type CreepDamageState = struct {
    cumulative_damage_fraction: Float, // D in [0, 1.0]
    total_operating_hours: Float,
    current_time_to_rupture_hrs: Float,
    is_rupture_risk: Bool,
};

pub fn creep_calc_rupture_time(
    params: &LarsonMillerParams,
    temp_kelvin: Float,
    stress_mpa: Float
) -> Float {
    if temp_kelvin <= 300.0 || stress_mpa <= 0.0 {
        return 1000000.0; // negligible creep below 300K
    }

    // LMP = a0 - a1 * stress
    let lmp: Float = (params).a0_coeff - ((params).a1_coeff * stress_mpa);
    
    // LMP = (T/1000) * (log10(t_r) + C) => log10(t_r) = (1000 * LMP / T) - C
    let c: Float = (params).c_constant;
    let log_tr: Float = ((1000.0 * lmp) / temp_kelvin) - c;

    // Approximate 10^(log_tr)
    let tr_hrs: Float = if log_tr > 4.0 { 100000.0 } else { if log_tr < 1.0 { 10.0 } else { 1000.0 } };
    return tr_hrs;
}

pub fn creep_accumulate_step(
    params: &LarsonMillerParams,
    state: &CreepDamageState,
    temp_kelvin: Float,
    stress_mpa: Float,
    delta_hours: Float
) -> CreepDamageState {
    let t_r: Float = creep_calc_rupture_time(params, temp_kelvin, stress_mpa);
    
    // Robinson linear damage fraction: delta_D = delta_t / t_r
    let delta_d: Float = if t_r > 0.0 { delta_hours / t_r } else { 1.0 };
    let new_d: Float = (state).cumulative_damage_fraction + delta_d;
    let new_hours: Float = (state).total_operating_hours + delta_hours;

    let is_rupture: Bool = (new_d >= (params).max_allowable_damage);

    return CreepDamageState {
        cumulative_damage_fraction: new_d,
        total_operating_hours: new_hours,
        current_time_to_rupture_hrs: t_r,
        is_rupture_risk: is_rupture,
    };
}
