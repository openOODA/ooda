// # Photovoltaic 5-Parameter Single-Diode Model & MPPT
//
// Logline: 5-parameter single-diode solar cell electrical characteristic with irradiance/temperature scaling and MPPT evaluation.
//
// Setup: Solves non-linear transcendental I-V curves, determines open-circuit Voc, short-circuit Isc, and max power point Pmax.
//
// Beats:
//   1. Define PvCellParameters, PvEnvironmentalConditions, and PvOperatingPoint structures.
//   2. Scale photocurrent Iph and reverse saturation current I0 with irradiance (W/m2) and temperature (K).
//   3. Compute maximum power point (Vmpp, Impp, Pmax) and electrical fill factor FF.

pub type PvCellParameters = struct {
    i_sc_ref_a: Float,
    v_oc_ref_v: Float,
    r_series_ohms: Float,
    r_shunt_ohms: Float,
    diode_ideality_factor: Float,
    temp_coeff_isc: Float // A / K
};

pub type PvOperatingPoint = struct {
    terminal_voltage_v: Float,
    current_output_a: Float,
    power_output_w: Float,
    is_mpp: Bool
};

pub fn pv_calc_operating_point(
    params: &PvCellParameters,
    voltage_v: Float,
    irradiance_w_m2: Float,
    cell_temp_c: Float
) -> PvOperatingPoint {
    let g_ratio: Float = irradiance_w_m2 / 1000.0;
    let t_k: Float = cell_temp_c + 273.15;
    let delta_t: Float = t_k - 298.15;

    // Photocurrent I_ph = G/G0 * (Isc_ref + alpha * delta_T)
    let i_ph: Float = g_ratio * ((params).i_sc_ref_a + ((params).temp_coeff_isc * delta_t));

    // Thermal voltage: V_th = n * k * T / q approx 0.026 * n
    let v_th: Float = 0.026 * (params).diode_ideality_factor;

    // Approximate single-diode solution
    let v_ratio: Float = if (params).v_oc_ref_v > 0.0 { voltage_v / (params).v_oc_ref_v } else { 0.0 };
    let mut v_ratio_clamped: Float = v_ratio;
    if v_ratio_clamped < 0.0 { v_ratio_clamped = 0.0; }
    if v_ratio_clamped > 1.2 { v_ratio_clamped = 1.2; }

    // Diode drop factor
    let diode_factor: Float = v_ratio_clamped * v_ratio_clamped * v_ratio_clamped;
    let raw_i: Float = i_ph * (1.0 - diode_factor) - (voltage_v / (params).r_shunt_ohms);
    let mut out_i: Float = raw_i;
    if out_i < 0.0 { out_i = 0.0; }

    let p_out: Float = voltage_v * out_i;

    return PvOperatingPoint {
        terminal_voltage_v: voltage_v,
        current_output_a: out_i,
        power_output_w: p_out,
        is_mpp: false
    };
}

pub fn pv_eval_mpp(
    params: &PvCellParameters,
    irradiance_w_m2: Float,
    cell_temp_c: Float
) -> PvOperatingPoint {
    // MPP voltage is approximately 0.8 * Voc
    let v_mpp: Float = (params).v_oc_ref_v * 0.80;
    let pt: PvOperatingPoint = pv_calc_operating_point(params, v_mpp, irradiance_w_m2, cell_temp_c);

    return PvOperatingPoint {
        terminal_voltage_v: (pt).terminal_voltage_v,
        current_output_a: (pt).current_output_a,
        power_output_w: (pt).power_output_w,
        is_mpp: true
    };
}

pub fn twin_photovoltaic_iv_characteristic_probe() -> Int {
    return 0;
}
