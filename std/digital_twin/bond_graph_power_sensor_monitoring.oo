// # Bond Graph Power Sensing & Energy Conservation Accounting
//
// Logline: Power port monitors and conservation accounting verifying first-law thermodynamics across multi-physics domains.
//
// Setup: Tracks instantaneous power flows P(t) = e(t)*f(t), accumulated work, dissipated heat, and energy balance residuals.
//
// Beats:
//   1. Define PowerSensorPort and EnergyConservationTracker structures.
//   2. Sample multi-bond power flows and integrate cumulative energy transactions.
//   3. Compute system energy balance residual and verify energetic consistency.

pub type PowerSensorPort = struct {
    port_id: Int,
    effort_measurement: Float,
    flow_measurement: Float,
    instantaneous_power_w: Float,
    cumulative_energy_joules: Float,
};

pub type EnergyConservationTracker = struct {
    total_energy_in_j: Float,
    total_energy_out_j: Float,
    total_stored_energy_j: Float,
    total_dissipated_heat_j: Float,
    energy_balance_error_j: Float,
    is_conservative: Bool,
};

pub fn power_sensor_new(port_id: Int) -> PowerSensorPort {
    return PowerSensorPort {
        port_id: port_id,
        effort_measurement: 0.0,
        flow_measurement: 0.0,
        instantaneous_power_w: 0.0,
        cumulative_energy_joules: 0.0,
    };
}

pub fn power_sensor_update(sensor: &PowerSensorPort, effort: Float, flow: Float, dt: Float) -> PowerSensorPort {
    let power: Float = effort * flow;
    let delta_energy: Float = power * dt;
    return PowerSensorPort {
        port_id: (sensor).port_id,
        effort_measurement: effort,
        flow_measurement: flow,
        instantaneous_power_w: power,
        cumulative_energy_joules: (sensor).cumulative_energy_joules + delta_energy,
    };
}

pub fn energy_tracker_new() -> EnergyConservationTracker {
    return EnergyConservationTracker {
        total_energy_in_j: 0.0,
        total_energy_out_j: 0.0,
        total_stored_energy_j: 0.0,
        total_dissipated_heat_j: 0.0,
        energy_balance_error_j: 0.0,
        is_conservative: true,
    };
}

pub fn energy_tracker_update(
    tracker: &EnergyConservationTracker,
    p_in: Float,
    p_out: Float,
    current_stored_energy: Float,
    p_dissipated: Float,
    dt: Float,
    tol_joules: Float
) -> EnergyConservationTracker {
    let new_e_in: Float = (tracker).total_energy_in_j + (p_in * dt);
    let new_e_out: Float = (tracker).total_energy_out_j + (p_out * dt);
    let new_diss: Float = (tracker).total_dissipated_heat_j + (p_dissipated * dt);

    // Energy balance: E_in - E_out - E_dissipated = E_stored
    let theoretical_stored: Float = new_e_in - new_e_out - new_diss;
    let mut err: Float = theoretical_stored - current_stored_energy;
    if err < 0.0 { err = 0.0 - err; }

    let conservative: Bool = (err <= tol_joules);

    return EnergyConservationTracker {
        total_energy_in_j: new_e_in,
        total_energy_out_j: new_e_out,
        total_stored_energy_j: current_stored_energy,
        total_dissipated_heat_j: new_diss,
        energy_balance_error_j: err,
        is_conservative: conservative,
    };
}
