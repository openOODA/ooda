// # Thermal Equivalent Cauer / Foster RC Networks
//
// Logline: Multi-node Cauer and Foster thermal equivalent circuit resistance-capacitance transient solver for electronics cooling.
//
// Setup: Predicts power semiconductor junction temperatures (IGBT/MOSFET/CPU) under variable thermal dissipation pulses.
//
// Beats:
//   1. Define FosterRcStage, CauerLadderNetwork, and TransientThermalState structures.
//   2. Step forward transient node temperatures dT_i / dt = (Q_in - Q_out) / C_i across multi-stage RC ladders.
//   3. Compute analytical transient thermal impedance Zth(t) and maximum junction temperature margins.

pub type FosterStage = struct {
    resistance_k_per_w: Float, // R_i
    time_constant_sec: Float,  // tau_i = R_i * C_i
    accumulated_delta_t: Float,
};

pub type MultiStageThermalNetwork = struct {
    num_stages: Int,
    ambient_temperature_c: Float,
    stages: List[FosterStage],
    junction_temp_c: Float,
};

pub fn thermal_network_new(n_stages: Int, t_ambient: Float) -> MultiStageThermalNetwork {
    let mut st: List[FosterStage] = list_new();
    let mut i: Int = 0;
    while i < n_stages {
        let stage = FosterStage {
            resistance_k_per_w: 0.1,
            time_constant_sec: 0.5,
            accumulated_delta_t: 0.0,
        };
        st = list_push(st, stage);
        i = i + 1;
    }

    return MultiStageThermalNetwork {
        num_stages: n_stages,
        ambient_temperature_c: t_ambient,
        stages: st,
        junction_temp_c: t_ambient,
    };
}

pub fn thermal_network_step(
    net: &MultiStageThermalNetwork,
    power_dissipated_w: Float,
    dt: Float
) -> MultiStageThermalNetwork {
    let n: Int = (net).num_stages;
    let mut updated_stages: List[FosterStage] = list_new();
    let mut total_delta_t: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let st: FosterStage = list_get((net).stages, i);
        let r_i: Float = (st).resistance_k_per_w;
        let tau_i: Float = (st).time_constant_sec;
        let prev_dt: Float = (st).accumulated_delta_t;

        // d(Delta_T)/dt = (R_i * P - Delta_T) / tau_i
        let d_dt: Float = if tau_i > 0.0 { ((r_i * power_dissipated_w) - prev_dt) / tau_i } else { 0.0 };
        let next_dt: Float = prev_dt + (d_dt * dt);
        total_delta_t = total_delta_t + next_dt;

        let st_new = FosterStage {
            resistance_k_per_w: r_i,
            time_constant_sec: tau_i,
            accumulated_delta_t: next_dt,
        };
        updated_stages = list_push(updated_stages, st_new);
        i = i + 1;
    }

    let t_junc: Float = (net).ambient_temperature_c + total_delta_t;

    return MultiStageThermalNetwork {
        num_stages: n,
        ambient_temperature_c: (net).ambient_temperature_c,
        stages: updated_stages,
        junction_temp_c: t_junc,
    };
}
