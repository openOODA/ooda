pub fn digital_twin_shim_bg_element(id: Int, e_type: Int, param: Float, init_val: Float, effort_in: Bool) -> BgElement {
    return bg_element_new(id, e_type, param, init_val, effort_in);
}

pub fn digital_twin_shim_ss_create(nx: Int, nu: Int, ny: Int, a: &List[Float], b: &List[Float], c: &List[Float], d: &List[Float]) -> LinearStateSpace {
    return ss_create(nx, nu, ny, a, b, c, d);
}

pub fn digital_twin_shim_sync_asset(asset_id: Int, init_states: &List[Float]) -> AssetSyncState {
    return asset_sync_new(asset_id, init_states);
}

pub fn digital_twin_shim_hil_scheduler(period_us: Int, budget_us: Int, abort: Bool) -> HilSchedulerConfig {
    return hil_scheduler_new(period_us, budget_us, abort);
}

pub fn digital_twin_shim_battery_ocv(soc: Float) -> Float {
    return battery_eval_ocv(soc);
}
