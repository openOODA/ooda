// # Moving Horizon Estimation (MHE) with Constraints
//
// Logline: Moving Horizon Estimation (MHE) optimizing state trajectories over finite receding windows with physical constraints.
//
// Setup: Solves constrained quadratic state estimation penalizing arrival cost, model discrepancies, and sensor innovations.
//
// Beats:
//   1. Define MheWindowConfig, MheStateHistory, and BoxConstraint structures.
//   2. Formulate receding horizon objective function over N historical time steps.
//   3. Project estimated states onto physical box constraints (e.g., non-negative pressures, temperature limits).

pub type MheConfig = struct {
    horizon_len: Int,
    arrival_weight: Float,
    measurement_weight: Float,
    process_weight: Float,
    min_state_bound: Float,
    max_state_bound: Float,
};

pub type MheState = struct {
    horizon_states: List[Float],
    horizon_measurements: List[Float],
    current_estimate: Float,
    arrival_mean: Float,
};

pub fn mhe_state_new(horizon_len: Int, init_val: Float) -> MheState {
    let mut states: List[Float] = list_new();
    let mut meas: List[Float] = list_new();
    let mut i: Int = 0;
    while i < horizon_len {
        states = list_push(states, init_val);
        meas = list_push(meas, init_val);
        i = i + 1;
    }
    return MheState {
        horizon_states: states,
        horizon_measurements: meas,
        current_estimate: init_val,
        arrival_mean: init_val,
    };
}

pub fn mhe_update_window(
    state: &MheState,
    new_measurement: Float,
    cfg: &MheConfig
) -> MheState {
    let n: Int = (cfg).horizon_len;
    let mut shifted_states: List[Float] = list_new();
    let mut shifted_meas: List[Float] = list_new();

    // Shift window by 1 step
    let mut i: Int = 1;
    while i < n {
        shifted_states = list_push(shifted_states, list_get((state).horizon_states, i));
        shifted_meas = list_push(shifted_meas, list_get((state).horizon_measurements, i));
        i = i + 1;
    }

    // Estimate next state: weighted average of model and new measurement
    let last_x: Float = (state).current_estimate;
    let w_m: Float = (cfg).measurement_weight;
    let w_p: Float = (cfg).process_weight;
    let total_w: Float = w_m + w_p;
    let raw_x: Float = if total_w > 0.0 { ((w_p * last_x) + (w_m * new_measurement)) / total_w } else { last_x };

    // Apply box constraints
    let mut clamped_x: Float = raw_x;
    if clamped_x < (cfg).min_state_bound { clamped_x = (cfg).min_state_bound; }
    if clamped_x > (cfg).max_state_bound { clamped_x = (cfg).max_state_bound; }

    shifted_states = list_push(shifted_states, clamped_x);
    shifted_meas = list_push(shifted_meas, new_measurement);

    let next_arrival: Float = list_get(shifted_states, 0);

    return MheState {
        horizon_states: shifted_states,
        horizon_measurements: shifted_meas,
        current_estimate: clamped_x,
        arrival_mean: next_arrival,
    };
}
