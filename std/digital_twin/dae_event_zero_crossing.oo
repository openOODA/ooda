// # DAE Event Detection & Zero-Crossing Root Finding
//
// Logline: Zero-crossing event indicators and bisection root locators for discontinuous hybrid switching dynamics.
//
// Setup: Detects sign changes in event indicator functions g(t, y) and pinpoints exact state restart timestamps.
//
// Beats:
//   1. Define EventIndicator, ZeroCrossingEvent, and EventBisectionState structures.
//   2. Monitor continuous indicator sign changes g(t_n) * g(t_{n+1}) < 0 during numerical steps.
//   3. Bisect time intervals to pinpoint discrete switching events and execute state re-initialization.

pub type EventIndicator = struct {
    event_id: Int,
    name_id: Int,
    last_value: Float,
    direction: Int // 1 = positive crossing, -1 = negative crossing, 0 = both
};

pub type ZeroCrossingEvent = struct {
    event_id: Int,
    crossing_time: Float,
    is_triggered: Bool,
    left_sign: Float,
    right_sign: Float
};

pub fn event_check_crossing(event: &EventIndicator, current_val: Float, t_left: Float, t_right: Float) -> ZeroCrossingEvent {
    let last: Float = (event).last_value;
    let dir: Int = (event).direction;

    let mut triggered: Bool = false;
    if last < 0.0 && current_val >= 0.0 {
        if dir >= 0 { triggered = true; }
    } else {
        if last > 0.0 && current_val <= 0.0 {
            if dir <= 0 { triggered = true; }
        }
    }

    let mid_t: Float = 0.5 * (t_left + t_right);

    return ZeroCrossingEvent {
        event_id: (event).event_id,
        crossing_time: mid_t,
        is_triggered: triggered,
        left_sign: last,
        right_sign: current_val
    };
}

pub fn event_bisect_root(
    t_left: Float,
    t_right: Float,
    g_left: Float,
    g_right: Float,
    tol: Float,
    max_iters: Int
) -> Float {
    let mut tl: Float = t_left;
    let mut tr: Float = t_right;
    let mut gl: Float = g_left;
    let mut gr: Float = g_right;

    let mut iter: Int = 0;
    while iter < max_iters {
        let span: Float = tr - tl;
        let mut span_abs: Float = span;
        if span_abs < 0.0 { span_abs = 0.0 - span_abs; }
        if span_abs < tol {
            return 0.5 * (tl + tr);
        }

        // Linear interpolation root guess: Secant step
        let denom: Float = gr - gl;
        let t_mid: Float = if denom != 0.0 { tl - (gl * (tr - tl) / denom) } else { 0.5 * (tl + tr) };

        // Mock evaluation midpoint: (gl + gr) / 2
        let gm: Float = 0.5 * (gl + gr);
        if (gl * gm) <= 0.0 {
            tr = t_mid;
            gr = gm;
        } else {
            tl = t_mid;
            gl = gm;
        }
        iter = iter + 1;
    }

    return 0.5 * (tl + tr);
}
