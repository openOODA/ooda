// # DAE Sensitivity Analysis & Parameter Identifiability
//
// Logline: Forward and adjoint sensitivity equations d y / d theta for digital twin parameter estimation and Fisher information.
//
// Setup: Solves augmented sensitivity DAE systems to compute parameter gradients and rank physical identifiability.
//
// Beats:
//   1. Define ParameterSensitivityState and FisherInformationMatrix structures.
//   2. Integrate forward sensitivity equations S = dy/dp alongside nominal state trajectories.
//   3. Compute Fisher Information Matrix (FIM = sum S^T * W * S) and estimate parameter uncertainty.

pub type ParameterSensitivityState = struct {
    num_states: Int,
    num_params: Int,
    nominal_states: List[Float],
    sensitivities: List[Float] // Flattened N_states x N_params (S_ij = dy_i / dp_j)
};

pub type FisherInformationMatrix = struct {
    num_params: Int,
    matrix_fim: List[Float], // Flattened N_p x N_p
    trace_fim: Float,
    is_identifiable: Bool
};

pub fn sensitivity_state_new(n_states: Int, n_params: Int) -> ParameterSensitivityState {
    let mut nom: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n_states {
        nom = list_push(nom, 0.0);
        i = i + 1;
    }

    let mut sens: List[Float] = list_new();
    let total: Int = n_states * n_params;
    i = 0;
    while i < total {
        sens = list_push(sens, 0.0);
        i = i + 1;
    }

    return ParameterSensitivityState {
        num_states: n_states,
        num_params: n_params,
        nominal_states: nom,
        sensitivities: sens
    };
}

pub fn sensitivity_step_forward(
    state: &ParameterSensitivityState,
    df_dy: &List[Float],
    df_dp: &List[Float],
    dt: Float
) -> ParameterSensitivityState {
    // S_next = S + dt * (df/dy * S + df/dp)
    let n_s: Int = (state).num_states;
    let n_p: Int = (state).num_params;
    let mut next_sens: List[Float] = list_new();

    let mut i: Int = 0;
    while i < n_s {
        let mut j: Int = 0;
        while j < n_p {
            let s_ij: Float = list_get((state).sensitivities, (i * n_p) + j);
            
            // df_dy * S column j
            let mut sum_term: Float = 0.0;
            let mut k: Int = 0;
            while k < n_s {
                let j_ik: Float = list_get(*df_dy, (i * n_s) + k);
                let s_kj: Float = list_get((state).sensitivities, (k * n_p) + j);
                sum_term = sum_term + (j_ik * s_kj);
                k = k + 1;
            }

            let df_dp_ij: Float = list_get(*df_dp, (i * n_p) + j);
            let ds_dt: Float = sum_term + df_dp_ij;
            let s_next: Float = s_ij + (dt * ds_dt);
            next_sens = list_push(next_sens, s_next);
            j = j + 1;
        }
        i = i + 1;
    }

    return ParameterSensitivityState {
        num_states: n_s,
        num_params: n_p,
        nominal_states: (state).nominal_states,
        sensitivities: next_sens
    };
}

pub fn sensitivity_calc_fim(state: &ParameterSensitivityState, weights: &List[Float]) -> FisherInformationMatrix {
    let n_s: Int = (state).num_states;
    let n_p: Int = (state).num_params;
    let mut fim: List[Float] = list_new();
    let mut tr: Float = 0.0;

    let mut i: Int = 0;
    while i < n_p {
        let mut j: Int = 0;
        while j < n_p {
            let mut sum: Float = 0.0;
            let mut k: Int = 0;
            while k < n_s {
                let s_ki: Float = list_get((state).sensitivities, (k * n_p) + i);
                let s_kj: Float = list_get((state).sensitivities, (k * n_p) + j);
                let w_k: Float = if k < list_len(*weights) { list_get(*weights, k) } else { 1.0 };
                sum = sum + (s_ki * w_k * s_kj);
                k = k + 1;
            }
            fim = list_push(fim, sum);
            if i == j {
                tr = tr + sum;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    let identifiable: Bool = (tr > 0.001);

    return FisherInformationMatrix {
        num_params: n_p,
        matrix_fim: fim,
        trace_fim: tr,
        is_identifiable: identifiable
    };
}
