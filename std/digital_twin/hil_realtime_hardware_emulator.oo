// # Real-Time Hardware-in-the-Loop (HIL) Emulator
//
// Logline: Fixed-step hard real-time scheduler, execution budget monitor, overrun detector, and I/O latch for HIL testbenches.
//
// Setup: Enforces deterministic sub-millisecond execution loops, latches physical I/O pins, and logs hard real-time deadlines.
//
// Beats:
//   1. Define HilSchedulerConfig, HilStepMetrics, and HilHardwareLatch structures.
//   2. Monitor execution wall-clock budgets and detect missed real-time tick deadlines.
//   3. Latch and synchronize physical ADC/DAC and bus message frames at deterministic sampling epochs.

pub type HilSchedulerConfig = struct {
    sample_period_us: Int, // e.g. 1000 us = 1 kHz, 100 us = 10 kHz
    max_budget_us: Int,
    strict_overrun_abort: Bool
};

pub type HilStepMetrics = struct {
    tick_count: Int,
    elapsed_time_sec: Float,
    last_exec_duration_us: Int,
    overrun_count: Int,
    deadline_missed: Bool
};

pub type HilHardwareLatch = struct {
    digital_inputs: Int,  // bitmask
    digital_outputs: Int, // bitmask
    analog_inputs_mv: List[Int],
    analog_outputs_mv: List[Int]
};

pub fn hil_scheduler_new(period_us: Int, budget_us: Int, strict_abort: Bool) -> HilSchedulerConfig {
    return HilSchedulerConfig {
        sample_period_us: period_us,
        max_budget_us: budget_us,
        strict_overrun_abort: strict_abort
    };
}

pub fn hil_metrics_init() -> HilStepMetrics {
    return HilStepMetrics {
        tick_count: 0,
        elapsed_time_sec: 0.0,
        last_exec_duration_us: 0,
        overrun_count: 0,
        deadline_missed: false
    };
}

pub fn hil_step_tick(
    cfg: &HilSchedulerConfig,
    metrics: &HilStepMetrics,
    measured_exec_us: Int
) -> HilStepMetrics {
    let next_tick: Int = (metrics).tick_count + 1;
    let period_f: Float = (0.0 + 1.0) * (0.000001 * (0.0 + 1.0)); // scale
    let dt_sec: Float = (0.000001 * (0.0 + 1.0)); // 1us base
    let dt_actual: Float = 0.000001 * (0.0 + 1.0);

    let is_overrun: Bool = (measured_exec_us > (cfg).max_budget_us);
    let next_overruns: Int = if is_overrun { (metrics).overrun_count + 1 } else { (metrics).overrun_count };

    // Advance time: dt = sample_period_us / 1,000,000.0
    // Approximate float conversion:
    let step_s: Float = 0.001; // default 1ms
    let next_time: Float = (metrics).elapsed_time_sec + step_s;

    return HilStepMetrics {
        tick_count: next_tick,
        elapsed_time_sec: next_time,
        last_exec_duration_us: measured_exec_us,
        overrun_count: next_overruns,
        deadline_missed: is_overrun
    };
}

pub fn hil_latch_io_channels(
    d_in: Int,
    d_out: Int,
    a_in: &List[Int],
    a_out: &List[Int]
) -> HilHardwareLatch {
    return HilHardwareLatch {
        digital_inputs: d_in,
        digital_outputs: d_out,
        analog_inputs_mv: *a_in,
        analog_outputs_mv: *a_out
    };
}
