// # Hydraulic Pipeline Waterhammer & Acoustic Wave Transients
//
// Logline: Method of Characteristics (MOC) acoustic pressure surge and Joukowsky waterhammer transient solver.
//
// Setup: Solves dynamic wave propagation C+ and C- characteristic equations along discretized pressurized pipelines.
//
// Beats:
//   1. Define PipelineAcousticParams, PipelineGridNode, and WaterhammerState structures.
//   2. Compute Joukowsky pressure surge Delta_P = rho * a * Delta_v for fast valve closures.
//   3. Advance Method of Characteristics (MOC) grid nodes with boundary valve/reservoir reflections.

pub type PipelineAcousticParams = struct {
    pipe_length_m: Float,
    diameter_m: Float,
    wall_thickness_m: Float,
    wave_speed_m_s: Float, // acoustic speed a
    fluid_density_kg_m3: Float,
    friction_factor_f: Float,
};

pub type PipelineNode = struct {
    node_index: Int,
    pressure_head_m: Float,
    flow_rate_m3_s: Float,
};

pub fn waterhammer_joukowsky_surge(
    density_kg_m3: Float,
    wave_speed_m_s: Float,
    velocity_change_m_s: Float
) -> Float {
    // Delta_P = rho * a * Delta_v
    let dp_pa: Float = density_kg_m3 * wave_speed_m_s * velocity_change_m_s;
    return dp_pa;
}

pub fn moc_step_internal_node(
    p_left: &PipelineNode,
    p_right: &PipelineNode,
    params: &PipelineAcousticParams,
    area_m2: Float,
    dt: Float
) -> PipelineNode {
    let a: Float = (params).wave_speed_m_s;
    let g: Float = 9.80665;
    let b_const: Float = if (g * area_m2) > 0.0 { a / (g * area_m2) } else { 1.0 };
    let r_resist: Float = ((params).friction_factor_f * dt * a) / (2.0 * g * (params).diameter_m * area_m2 * area_m2);

    // C+ characteristic from left node: H_P = C_P - B * Q_P
    let h_a: Float = (p_left).pressure_head_m;
    let q_a: Float = (p_left).flow_rate_m3_s;
    let c_plus: Float = h_a + (b_const * q_a) - (r_resist * q_a * q_a);

    // C- characteristic from right node: H_P = C_M + B * Q_P
    let h_b: Float = (p_right).pressure_head_m;
    let q_b: Float = (p_right).flow_rate_m3_s;
    let c_minus: Float = h_b - (b_const * q_b) + (r_resist * q_b * q_b);

    // Intersection solution:
    let q_p: Float = (c_plus - c_minus) / (2.0 * b_const);
    let h_p: Float = 0.5 * (c_plus + c_minus);

    return PipelineNode {
        node_index: (p_left).node_index + 1,
        pressure_head_m: h_p,
        flow_rate_m3_s: q_p,
    };
}
