// # HIL Fault Injection Engine & Sensor/Actuator Emulation
//
// Logline: Hardware-in-the-loop fault injection module for sensor drift, stuck actuators, wire-break disconnects, and packet loss.
//
// Setup: Corrupts clean physical simulation signals with deterministic fault profiles for ECU safety validation.
//
// Beats:
//   1. Define FaultInjectionConfig, FaultModeEnum, and CorruptedSignal structures.
//   2. Apply stuck-at, bias drift, scale factor, and intermittent noise fault injections.
//   3. Provide timed trigger activation and recovery windows for ISO 26262 functional safety tests.

pub type FaultConfig = struct {
    fault_type: Int, // 0=None, 1=StuckValue, 2=BiasOffset, 3=ScaleFactor, 4=Noise, 5=TotalDisconnect
    is_active: Bool,
    target_value: Float, // stuck value or offset
    scale_factor: Float,
    start_time_sec: Float,
    end_time_sec: Float
};

pub type CorruptedSignal = struct {
    original_value: Float,
    injected_value: Float,
    is_fault_active: Bool,
    applied_fault_type: Int
};

pub fn fault_config_new(f_type: Int, t_start: Float, t_end: Float, target_val: Float, scale: Float) -> FaultConfig {
    return FaultConfig {
        fault_type: f_type,
        is_active: false,
        target_value: target_val,
        scale_factor: scale,
        start_time_sec: t_start,
        end_time_sec: t_end
    };
}

pub fn inject_fault_sample(cfg: &FaultConfig, raw_signal: Float, current_time_sec: Float) -> CorruptedSignal {
    let mut active: Bool = false;
    if current_time_sec >= (cfg).start_time_sec && current_time_sec <= (cfg).end_time_sec {
        active = true;
    }

    if !active || (cfg).fault_type == 0 {
        return CorruptedSignal {
            original_value: raw_signal,
            injected_value: raw_signal,
            is_fault_active: false,
            applied_fault_type: 0
        };
    }

    let mut out_val: Float = raw_signal;
    let f_type: Int = (cfg).fault_type;

    if f_type == 1 {
        // Stuck at value
        out_val = (cfg).target_value;
    } else {
        if f_type == 2 {
            // Bias offset
            out_val = raw_signal + (cfg).target_value;
        } else {
            if f_type == 3 {
                // Scale factor
                out_val = raw_signal * (cfg).scale_factor;
            } else {
                if f_type == 5 {
                    // Total disconnect / open circuit (0.0 V)
                    out_val = 0.0;
                }
            }
        }
    }

    return CorruptedSignal {
        original_value: raw_signal,
        injected_value: out_val,
        is_fault_active: true,
        applied_fault_type: f_type
    };
}
