// # Bond Graph Energy Elements & Constitutive Relations
//
// Logline: 1-port and 2-port energetic elements for multi-domain physical systems with causal effort-flow mappings.
//
// Setup: Implements Se, Sf, R (dissipation), C (potential storage), I (kinetic storage), TF, and GY elements.
//
// Beats:
//   1. Define element types, causality modes, and bond energy state representations.
//   2. Compute constitutive algebraic and differential relations for R, C, I, TF, and GY components.
//   3. Provide causality validation and power flow computation across physical domains.

pub type Causality = struct {
    effort_in: Bool // true if effort is input to the element, false if flow is input
};

pub type BgElement = struct {
    elem_id: Int,
    elem_type: Int, // 1=Se, 2=Sf, 3=R, 4=C, 5=I, 6=TF, 7=GY
    parameter: Float, // Resistance R, Capacitance C, Inductance I, Modulus m, Gyrator r
    state: Float, // q (displacement/charge) for C, p (momentum/flux) for I
    causality_effort_in: Bool
};

pub type BondPort = struct {
    effort: Float,
    flow: Float,
    power: Float
};

pub fn bg_element_new(elem_id: Int, elem_type: Int, param: Float, init_state: Float, effort_in: Bool) -> BgElement {
    return BgElement {
        elem_id: elem_id,
        elem_type: elem_type,
        parameter: param,
        state: init_state,
        causality_effort_in: effort_in
    };
}

pub fn bg_eval_r_element(elem: &BgElement, input_val: Float) -> Float {
    let r: Float = (elem).parameter;
    if (elem).causality_effort_in {
        // Conductance causality: input is effort (e), output is flow (f = e / R)
        if r == 0.0 { return 0.0; }
        return input_val / r;
    } else {
        // Resistance causality: input is flow (f), output is effort (e = R * f)
        return r * input_val;
    }
}

pub fn bg_eval_c_element_flow(elem: &BgElement, effort_in: Float, dt: Float) -> BgElement {
    // Integral causality: input is flow (f), output is effort (e = q / C), dq/dt = f
    // Derivative causality: input is effort (e), q = C * e
    let c: Float = (elem).parameter;
    let mut new_q: Float = (elem).state;
    if (elem).causality_effort_in {
        // Input is effort e -> q = C * e
        new_q = c * effort_in;
    } else {
        // Input is flow f -> dq = f * dt
        new_q = new_q + (effort_in * dt);
    }
    return BgElement {
        elem_id: (elem).elem_id,
        elem_type: (elem).elem_type,
        parameter: c,
        state: new_q,
        causality_effort_in: (elem).causality_effort_in
    };
}

pub fn bg_eval_c_effort(elem: &BgElement) -> Float {
    let c: Float = (elem).parameter;
    if c == 0.0 { return 0.0; }
    return (elem).state / c;
}

pub fn bg_eval_i_element_flow(elem: &BgElement, input_val: Float, dt: Float) -> BgElement {
    // Integral causality: input is effort (e), p = integral(e dt), f = p / I
    let i_param: Float = (elem).parameter;
    let mut new_p: Float = (elem).state;
    if (elem).causality_effort_in {
        // Input is effort e -> dp = e * dt
        new_p = new_p + (input_val * dt);
    } else {
        // Input is flow f -> p = I * f
        new_p = i_param * input_val;
    }
    return BgElement {
        elem_id: (elem).elem_id,
        elem_type: (elem).elem_type,
        parameter: i_param,
        state: new_p,
        causality_effort_in: (elem).causality_effort_in
    };
}

pub fn bg_eval_i_flow(elem: &BgElement) -> Float {
    let i_param: Float = (elem).parameter;
    if i_param == 0.0 { return 0.0; }
    return (elem).state / i_param;
}

pub fn bg_eval_transformer(modulus: Float, e1: Float, f2: Float) -> BondPort {
    // Transformer TF: e2 = m * e1, f1 = m * f2
    let e2: Float = modulus * e1;
    let f1: Float = modulus * f2;
    let power: Float = e1 * f1;
    return BondPort {
        effort: e2,
        flow: f1,
        power: power
    };
}

pub fn bg_eval_gyrator(ratio: Float, f1: Float, f2: Float) -> BondPort {
    // Gyrator GY: e1 = r * f2, e2 = r * f1
    let e1: Float = ratio * f2;
    let e2: Float = ratio * f1;
    let power: Float = e1 * f1;
    return BondPort {
        effort: e1,
        flow: e2,
        power: power
    };
}

pub fn bg_calculate_power(effort: Float, flow: Float) -> Float {
    return effort * flow;
}
