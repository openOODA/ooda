// # HIL Latency & Jitter Delay Compensation
//
// Logline: Smith predictor delay compensation and polynomial extrapolation for distributed HIL network jitter.
//
// Setup: Predicts delayed physical responses over Ethernet/CAN networks and mitigates phase lag in closed-loop testbenches.
//
// Beats:
//   1. Define DelayBuffer, SmithPredictorState, and ExtrapolationModel structures.
//   2. Buffer historical plant inputs/outputs across variable transport delay windows.
//   3. Compute delay-free state predictions to eliminate feedback instability from network lag.

pub type DelayRingBuffer = struct {
    capacity: Int,
    buffer: List<Float>,
    write_ptr: Int
};

pub type SmithPredictorState = struct {
    fast_model_output: Float,
    delayed_model_output: Float,
    measured_delayed_plant: Float,
    compensated_feedback: Float
};

pub fn delay_buffer_new(capacity: Int, init_val: Float) -> DelayRingBuffer {
    let mut buf: List<Float> = list_new();
    let mut i: Int = 0;
    while i < capacity {
        buf = list_push(buf, init_val);
        i = i + 1;
    }
    return DelayRingBuffer {
        capacity: capacity,
        buffer: buf,
        write_ptr: 0
    };
}

pub fn delay_buffer_push(rb: &DelayRingBuffer, val: Float) -> DelayRingBuffer {
    let cap: Int = (rb).capacity;
    let ptr: Int = (rb).write_ptr;
    
    let mut updated_buf: List<Float> = list_new();
    let mut i: Int = 0;
    while i < cap {
        if i == ptr {
            updated_buf = list_push(updated_buf, val);
        } else {
            updated_buf = list_push(updated_buf, list_get((rb).buffer, i));
        }
        i = i + 1;
    }

    let next_ptr: Int = (ptr + 1) % cap;
    return DelayRingBuffer {
        capacity: cap,
        buffer: updated_buf,
        write_ptr: next_ptr
    };
}

pub fn delay_buffer_get_delayed(rb: &DelayRingBuffer, delay_steps: Int) -> Float {
    let cap: Int = (rb).capacity;
    let ptr: Int = (rb).write_ptr;
    let read_idx: Int = (ptr - delay_steps + cap) % cap;
    return list_get((rb).buffer, read_idx);
}

pub fn smith_predictor_step(
    y_fast: Float,
    y_delayed_model: Float,
    y_measured_plant: Float
) -> SmithPredictorState {
    // Model mismatch error: e_d = y_measured_plant - y_delayed_model
    let err_d: Float = y_measured_plant - y_delayed_model;
    // Compensated prediction = y_fast + e_d
    let y_comp: Float = y_fast + err_d;

    return SmithPredictorState {
        fast_model_output: y_fast,
        delayed_model_output: y_delayed_model,
        measured_delayed_plant: y_measured_plant,
        compensated_feedback: y_comp
    };
}
