// # Dynamic Load Emulation & Dynamometer Profiles
//
// Logline: Programmable dynamometer mechanical torque load profiles and electrical grid impedance emulation.
//
// Setup: Emulates road load equations (rolling resistance, aerodynamic drag, gradient) and AC electronic load profiles.
//
// Beats:
//   1. Define RoadLoadParameters, DynamometerLoadState, and GridLoadEmulation structures.
//   2. Compute quadratic aerodynamic drag F_aero = 0.5*rho*Cd*A*v^2 and rolling resistance F_roll = Crr*m*g.
//   3. Step forward dynamometer torque control loops with closed-loop inertia compensation.

pub type RoadLoadParameters = struct {
    vehicle_mass_kg: Float,
    rolling_coeff_f0: Float,
    drivetrain_drag_f1: Float,
    aero_drag_coeff_f2: Float, // F2 = 0.5 * rho * Cd * A
    wheel_radius_m: Float
};

pub type DynamometerLoadState = struct {
    shaft_speed_rad_s: Float,
    linear_velocity_m_s: Float,
    target_load_torque_nm: Float,
    absorbed_power_kw: Float
};

pub fn dyno_road_load_new(mass: Float, f0: Float, f1: Float, f2: Float, r_wheel: Float) -> RoadLoadParameters {
    return RoadLoadParameters {
        vehicle_mass_kg: mass,
        rolling_coeff_f0: f0,
        drivetrain_drag_f1: f1,
        aero_drag_coeff_f2: f2,
        wheel_radius_m: r_wheel
    };
}

pub fn dyno_eval_load(params: &RoadLoadParameters, shaft_speed_rad_s: Float, road_grade_pct: Float) -> DynamometerLoadState {
    let r_w: Float = (params).wheel_radius_m;
    let v_ms: Float = shaft_speed_rad_s * r_w;
    let mut v_abs: Float = v_ms;
    if v_abs < 0.0 { v_abs = 0.0 - v_abs; }

    // F_total = F0 + F1 * v + F2 * v^2 + F_grade
    let f0: Float = (params).rolling_coeff_f0;
    let f1: Float = (params).drivetrain_drag_f1 * v_abs;
    let f2: Float = (params).aero_drag_coeff_f2 * v_abs * v_abs;
    
    // Grade force: F_g = m * g * (grade / 100)
    let g: Float = 9.80665;
    let f_grade: Float = (params).vehicle_mass_kg * g * (road_grade_pct / 100.0);

    let f_total: Float = f0 + f1 + f2 + f_grade;
    let sign: Float = if v_ms >= 0.0 { 1.0 } else { 0.0 - 1.0 };
    let total_force: Float = f_total * sign;

    let torque_nm: Float = total_force * r_w;
    let power_w: Float = torque_nm * shaft_speed_rad_s;
    let power_kw: Float = power_w / 1000.0;

    return DynamometerLoadState {
        shaft_speed_rad_s: shaft_speed_rad_s,
        linear_velocity_m_s: v_ms,
        target_load_torque_nm: torque_nm,
        absorbed_power_kw: power_kw
    };
}
