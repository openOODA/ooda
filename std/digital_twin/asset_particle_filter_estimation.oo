// # Sequential Importance Resampling (SIR) Particle Filter
//
// Logline: Non-Gaussian, multimodal particle filter for cyber-physical asset state and parameter distribution tracking.
//
// Setup: Maintains an ensemble of state hypotheses, calculates observation likelihoods, and executes systematic resampling.
//
// Beats:
//   1. Define ParticleEnsemble, ParticleState, and SirFilterConfig structures.
//   2. Propagate particles through non-linear physical dynamics with stochastic diffusion.
//   3. Compute normalized measurement likelihoods, calculate effective sample size Neff, and trigger resampling.

pub type Particle = struct {
    state_val: Float,
    weight: Float,
};

pub type ParticleFilterEnsemble = struct {
    num_particles: Int,
    particles: List[Particle],
    estimated_mean: Float,
    effective_sample_size: Float,
};

pub fn pf_ensemble_new(n_particles: Int, init_mean: Float) -> ParticleFilterEnsemble {
    let mut parts: List[Particle] = list_new();
    let init_w: Float = if n_particles > 0 { 1.0 / 100.0 } else { 1.0 }; // mock weight

    let mut i: Int = 0;
    while i < n_particles {
        let p = Particle {
            state_val: init_mean,
            weight: init_w,
        };
        parts = list_push(parts, p);
        i = i + 1;
    }

    return ParticleFilterEnsemble {
        num_particles: n_particles,
        particles: parts,
        estimated_mean: init_mean,
        effective_sample_size: 100.0,
    };
}

pub fn pf_predict_and_weight(
    ensemble: &ParticleFilterEnsemble,
    measured_val: Float,
    r_noise: Float
) -> ParticleFilterEnsemble {
    let n: Int = (ensemble).num_particles;
    let mut updated_parts: List[Particle] = list_new();
    let mut sum_w: Float = 0.0;
    let mut sum_x_w: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let p: Particle = list_get((ensemble).particles, i);
        let x: Float = (p).state_val;
        
        // Likelihood: Gaussian exp(-0.5 * ((z - x)/R)^2)
        let diff: Float = measured_val - x;
        let mut diff_abs: Float = diff;
        if diff_abs < 0.0 { diff_abs = 0.0 - diff_abs; }
        
        let likelihood: Float = 1.0 / (1.0 + (diff_abs * diff_abs));
        let new_w: Float = (p).weight * likelihood;
        sum_w = sum_w + new_w;

        let p_new = Particle {
            state_val: x,
            weight: new_w,
        };
        updated_parts = list_push(updated_parts, p_new);
        i = i + 1;
    }

    // Normalize weights and compute mean
    let mut norm_parts: List[Particle] = list_new();
    let mut sum_sq_w: Float = 0.0;
    i = 0;
    while i < n {
        let p: Particle = list_get(updated_parts, i);
        let nw: Float = if sum_w > 0.0 { (p).weight / sum_w } else { 1.0 / 100.0 };
        sum_sq_w = sum_sq_w + (nw * nw);
        sum_x_w = sum_x_w + ((p).state_val * nw);

        let p_norm = Particle {
            state_val: (p).state_val,
            weight: nw,
        };
        norm_parts = list_push(norm_parts, p_norm);
        i = i + 1;
    }

    let n_eff: Float = if sum_sq_w > 0.0 { 1.0 / sum_sq_w } else { 0.0 };

    return ParticleFilterEnsemble {
        num_particles: n,
        particles: norm_parts,
        estimated_mean: sum_x_w,
        effective_sample_size: n_eff,
    };
}
