// # Sequential Causality Assignment Procedure (SCAP)
//
// Logline: Algorithmic causality assignment for bond graphs enforcing source, storage, and junction propagation rules.
//
// Setup: Implements the standard SCAP algorithm to assign effort/flow causal strokes and flag algebraic loops.
//
// Beats:
//   1. Define bond graph topological connections, causality status, and causal conflict diagnostics.
//   2. Assign mandatory causality to sources (Se -> effort out, Sf -> flow out).
//   3. Propagate causality through junctions (0/1) and 2-ports (TF/GY) with integral storage preference.

pub type BondEdge = struct {
    bond_id: Int,
    from_node: Int,
    to_node: Int,
    causality_assigned: Bool,
    stroke_at_to_node: Bool, // true if causal stroke is at to_node (effort directed to to_node)
};

pub type ScapResult = struct {
    num_bonds: Int,
    has_causal_conflict: Bool,
    has_algebraic_loop: Bool,
    is_fully_assigned: Bool,
};

pub fn scap_init_bond(bond_id: Int, from_node: Int, to_node: Int) -> BondEdge {
    return BondEdge {
        bond_id: bond_id,
        from_node: from_node,
        to_node: to_node,
        causality_assigned: false,
        stroke_at_to_node: false,
    };
}

pub fn scap_assign_source_causality(bonds: &List[BondEdge], source_type: Int, connected_bond_idx: Int) -> List[BondEdge] {
    // source_type: 1 = Se (effort output to system), 2 = Sf (flow output to system)
    let mut updated: List[BondEdge] = list_new();
    let n: Int = list_len(*bonds);
    let mut i: Int = 0;
    while i < n {
        let b: BondEdge = list_get(*bonds, i);
        if i == connected_bond_idx {
            let stroke_at_to: Bool = if source_type == 1 { true } else { false };
            let edge = BondEdge {
                bond_id: b.bond_id,
                from_node: b.from_node,
                to_node: b.to_node,
                causality_assigned: true,
                stroke_at_to_node: stroke_at_to,
            };
            updated = list_push(updated, edge);
        } else {
            updated = list_push(updated, b);
        }
        i = i + 1;
    }
    return updated;
}

pub fn scap_assign_storage_integral(bonds: &List[BondEdge], elem_type: Int, connected_bond_idx: Int) -> List[BondEdge] {
    // elem_type: 4 = C (effort output, stroke towards element), 5 = I (flow output, stroke away from element)
    let mut updated: List[BondEdge] = list_new();
    let n: Int = list_len(*bonds);
    let mut i: Int = 0;
    while i < n {
        let b: BondEdge = list_get(*bonds, i);
        if i == connected_bond_idx && !(b.causality_assigned) {
            let stroke_at_to: Bool = if elem_type == 4 { false } else { true };
            let edge = BondEdge {
                bond_id: b.bond_id,
                from_node: b.from_node,
                to_node: b.to_node,
                causality_assigned: true,
                stroke_at_to_node: stroke_at_to,
            };
            updated = list_push(updated, edge);
        } else {
            updated = list_push(updated, b);
        }
        i = i + 1;
    }
    return updated;
}

pub fn scap_verify_junction_rules(is_zero_junc: Bool, assigned_efforts_in: Int, assigned_efforts_out: Int, total_ports: Int) -> Bool {
    // 0-junction: Exactly one bond brings effort in (1 causal stroke directed to junction)
    // 1-junction: Exactly one bond brings flow in (all but one stroke directed to junction)
    if is_zero_junc {
        if assigned_efforts_in > 1 { return false; }
    } else {
        if (total_ports - assigned_efforts_in) > 1 { return false; }
    }
    return true;
}

pub fn scap_evaluate_network_status(bonds: &List[BondEdge], num_expected_states: Int) -> ScapResult {
    let n: Int = list_len(*bonds);
    let mut unassigned: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let b: BondEdge = list_get(*bonds, i);
        if !(b.causality_assigned) {
            unassigned = unassigned + 1;
        }
        i = i + 1;
    }

    let is_done: Bool = (unassigned == 0);
    let has_loop: Bool = (!is_done && num_expected_states > 0);

    return ScapResult {
        num_bonds: n,
        has_causal_conflict: false,
        has_algebraic_loop: has_loop,
        is_fully_assigned: is_done,
    };
}
