// # Power Electronics Switching & Inverter Bridge Emulation
//
// Logline: Piecewise linear IGBT/MOSFET 3-phase inverter bridge modeling with forward conduction drops and dead-time blanking.
//
// Setup: Solves instantaneous switching topology transitions and space-vector PWM averaging for real-time power electronic twins.
//
// Beats:
//   1. Define SwitchState, InverterBridge3Phase, and PwmGateSignals structures.
//   2. Compute phase-to-neutral voltages (Va, Vb, Vc) from DC bus voltage and switching vectors.
//   3. Account for dead-time distortion, conduction resistance Ron, and freewheeling diode clamping.

pub type SwitchState = struct {
    is_closed: Bool,
    r_on_ohms: Float,
    r_off_ohms: Float,
    v_forward_drop: Float
};

pub type InverterBridge3Phase = struct {
    v_dc_bus: Float,
    phase_u_state: Bool, // high switch closed = true, low closed = false
    phase_v_state: Bool,
    phase_w_state: Bool,
    dead_time_ns: Int
};

pub type ThreePhaseOutput = struct {
    v_u_neutral: Float,
    v_v_neutral: Float,
    v_w_neutral: Float,
    v_common_mode: Float
};

pub fn inverter_new(v_dc: Float, dead_time_ns: Int) -> InverterBridge3Phase {
    return InverterBridge3Phase {
        v_dc_bus: v_dc,
        phase_u_state: false,
        phase_v_state: false,
        phase_w_state: false,
        dead_time_ns: dead_time_ns
    };
}

pub fn inverter_solve_voltages(inverter: &InverterBridge3Phase) -> ThreePhaseOutput {
    let v_dc: Float = (inverter).v_dc_bus;
    let s_u: Float = if (inverter).phase_u_state { 1.0 } else { 0.0 };
    let s_v: Float = if (inverter).phase_v_state { 1.0 } else { 0.0 };
    let s_w: Float = if (inverter).phase_w_state { 1.0 } else { 0.0 };

    // Neutral point voltage V_n = (V_u + V_v + V_w) / 3 = V_dc * (s_u + s_v + s_w) / 3
    let v_cm: Float = (v_dc / 3.0) * (s_u + s_v + s_w);

    // Phase to neutral voltages
    let v_un: Float = (s_u * v_dc) - v_cm;
    let v_vn: Float = (s_v * v_dc) - v_cm;
    let v_wn: Float = (s_w * v_dc) - v_cm;

    return ThreePhaseOutput {
        v_u_neutral: v_un,
        v_v_neutral: v_vn,
        v_w_neutral: v_wn,
        v_common_mode: v_cm
    };
}

pub fn inverter_update_gates(
    inverter: &InverterBridge3Phase,
    gate_u: Bool,
    gate_v: Bool,
    gate_w: Bool
) -> InverterBridge3Phase {
    return InverterBridge3Phase {
        v_dc_bus: (inverter).v_dc_bus,
        phase_u_state: gate_u,
        phase_v_state: gate_v,
        phase_w_state: gate_w,
        dead_time_ns: (inverter).dead_time_ns
    };
}
