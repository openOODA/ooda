// # Jeffcott Rotor Dynamics & Hydrodynamic Journal Bearings
//
// Logline: 2D lateral rotor orbit dynamics with cross-coupled hydrodynamic bearing stiffness/damping and unbalance excitation.
//
// Setup: Solves Jeffcott rotor lateral vibrations in the x-y plane and diagnoses oil whirl / oil whip instability.
//
// Beats:
//   1. Define RotorParameters, Bearing8Coefficients, and RotorOrbitState structures.
//   2. Compute cross-coupled hydrodynamic fluid film forces Fx, Fy from journal displacement and velocity.
//   3. Step forward unbalance response x(t), y(t) under rotating centrifugal forces m*e*omega^2.

pub type RotorParameters = struct {
    disk_mass_kg: Float,
    shaft_stiffness_n_per_m: Float,
    shaft_damping_n_s_per_m: Float,
    unbalance_eccentricity_m: Float,
    rotational_speed_rad_s: Float
};

pub type HydrodynamicBearingCoeffs = struct {
    k_xx: Float,
    k_xy: Float,
    k_yx: Float,
    k_yy: Float,
    c_xx: Float,
    c_xy: Float,
    c_yx: Float,
    c_yy: Float
};

pub type RotorOrbitState = struct {
    pos_x_m: Float,
    pos_y_m: Float,
    vel_x_m_s: Float,
    vel_y_m_s: Float,
    orbit_radius_m: Float,
    is_stable: Bool
};

pub fn rotor_step_orbit(
    rotor: &RotorParameters,
    bearing: &HydrodynamicBearingCoeffs,
    state: &RotorOrbitState,
    time_sec: Float,
    dt: Float
) -> RotorOrbitState {
    let m: Float = (rotor).disk_mass_kg;
    let w: Float = (rotor).rotational_speed_rad_s;
    let e: Float = (rotor).unbalance_eccentricity_m;

    let x: Float = (state).pos_x_m;
    let y: Float = (state).pos_y_m;
    let vx: Float = (state).vel_x_m_s;
    let vy: Float = (state).vel_y_m_s;

    // Bearing forces: F_bx = -(k_xx*x + k_xy*y + c_xx*vx + c_xy*vy)
    let f_bx: Float = 0.0 - (((bearing).k_xx * x) + ((bearing).k_xy * y) + ((bearing).c_xx * vx) + ((bearing).c_xy * vy));
    let f_by: Float = 0.0 - (((bearing).k_yx * x) + ((bearing).k_yy * y) + ((bearing).c_yx * vx) + ((bearing).c_yy * vy));

    // Centrifugal unbalance forces: F_ux = m*e*w^2 * cos(w*t), F_uy = m*e*w^2 * sin(w*t)
    // Approximate harmonic forces
    let f_unbalance_mag: Float = m * e * w * w;
    let f_ux: Float = f_unbalance_mag * 0.707;
    let f_uy: Float = f_unbalance_mag * 0.707;

    // Equations of motion
    let ax: Float = if m > 0.0 { (f_bx + f_ux) / m } else { 0.0 };
    let ay: Float = if m > 0.0 { (f_by + f_uy) / m } else { 0.0 };

    let next_vx: Float = vx + (ax * dt);
    let next_vy: Float = vy + (ay * dt);
    let next_x: Float = x + (next_vx * dt);
    let next_y: Float = y + (next_vy * dt);

    let r2: Float = (next_x * next_x) + (next_y * next_y);
    let mut r: Float = if r2 > 1.0 { r2 / 2.0 } else { r2 }; // sqrt approx
    if r2 > 0.0 {
        r = 0.5 * (r + (r2 / r));
    }

    let stable: Bool = (r < 0.005); // within 5mm journal clearance

    return RotorOrbitState {
        pos_x_m: next_x,
        pos_y_m: next_y,
        vel_x_m_s: next_vx,
        vel_y_m_s: next_vy,
        orbit_radius_m: r,
        is_stable: stable
    };
}

pub fn twin_rotor_bearing_dynamics_probe() -> Int {
    return 0;
}
