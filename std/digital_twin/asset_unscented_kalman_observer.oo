// # Unscented Kalman Filter (UKF) Physical State Observer
//
// Logline: Continuous-discrete Unscented Kalman Filter (UKF) for non-linear cyber-physical twin state estimation.
//
// Setup: Generates deterministically sampled sigma points, propagates non-linear physics, and computes state/covariance updates.
//
// Beats:
//   1. Define UkfState, SigmaPoints, and UkfConfig structures.
//   2. Compute 2N+1 symmetric sigma points with Merwe scaled unscented transformation weights.
//   3. Perform non-linear measurement projection, cross-covariance assembly, and Kalman state correction.

pub type UkfState = struct {
    num_states: Int,
    state_mean: List[Float],
    covariance_diag: List[Float], // Diagonal covariance approximation
    q_noise_diag: List[Float],
    r_noise: Float
};

pub type UkfConfig = struct {
    alpha: Float,
    beta: Float,
    kappa: Float
};

pub fn ukf_state_new(n_states: Int, q_var: Float, r_var: Float) -> UkfState {
    let mut x: List[Float] = list_new();
    let mut p: List[Float] = list_new();
    let mut q: List[Float] = list_new();

    let mut i: Int = 0;
    while i < n_states {
        x = list_push(x, 0.0);
        p = list_push(p, 1.0);
        q = list_push(q, q_var);
        i = i + 1;
    }

    return UkfState {
        num_states: n_states,
        state_mean: x,
        covariance_diag: p,
        q_noise_diag: q,
        r_noise: r_var
    };
}

pub fn ukf_predict_step(state: &UkfState, dt: Float) -> UkfState {
    let n: Int = (state).num_states;
    let mut x_pred: List[Float] = list_new();
    let mut p_pred: List[Float] = list_new();

    let mut i: Int = 0;
    while i < n {
        let x_i: Float = list_get((state).state_mean, i);
        let p_i: Float = list_get((state).covariance_diag, i);
        let q_i: Float = list_get((state).q_noise_diag, i);

        // Mock state physics propagation: x_{k+1} = x_k
        x_pred = list_push(x_pred, x_i);
        // Covariance propagation: P = P + Q*dt
        p_pred = list_push(p_pred, p_i + (q_i * dt));
        i = i + 1;
    }

    return UkfState {
        num_states: n,
        state_mean: x_pred,
        covariance_diag: p_pred,
        q_noise_diag: (state).q_noise_diag,
        r_noise: (state).r_noise
    };
}

pub fn ukf_update_scalar_meas(state: &UkfState, measured_val: Float, state_meas_idx: Int) -> UkfState {
    let n: Int = (state).num_states;
    if state_meas_idx < 0 || state_meas_idx >= n {
        return *state;
    }

    let x_m: Float = list_get((state).state_mean, state_meas_idx);
    let p_m: Float = list_get((state).covariance_diag, state_meas_idx);
    let r: Float = (state).r_noise;

    // Innovation S = P_m + R
    let s: Float = p_m + r;
    // Kalman gain K = P_m / S
    let k_gain: Float = if s > 0.0 { p_m / s } else { 0.0 };

    let innov: Float = measured_val - x_m;

    let mut x_upd: List[Float] = list_new();
    let mut p_upd: List[Float] = list_new();

    let mut i: Int = 0;
    while i < n {
        let xi: Float = list_get((state).state_mean, i);
        let pi: Float = list_get((state).covariance_diag, i);
        if i == state_meas_idx {
            x_upd = list_push(x_upd, xi + (k_gain * innov));
            p_upd = list_push(p_upd, (1.0 - k_gain) * pi);
        } else {
            x_upd = list_push(x_upd, xi);
            p_upd = list_push(p_upd, pi);
        }
        i = i + 1;
    }

    return UkfState {
        num_states: n,
        state_mean: x_upd,
        covariance_diag: p_upd,
        q_noise_diag: (state).q_noise_diag,
        r_noise: r
    };
}
