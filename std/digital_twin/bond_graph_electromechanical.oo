// # Electromechanical Domain Transducers & Motors
//
// Logline: Electromechanical gyrator/transformer couplings for DC motors, PMSM dq-frame machines, and piezoelectric transducers.
//
// Setup: Bridges electrical domain (voltage/current) with mechanical domain (torque/speed or force/velocity).
//
// Beats:
//   1. Define DCMotorParams, MotorElectromechanicalState, and PiezoTransducer structures.
//   2. Compute back-EMF and electromagnetic torque via gyrator constitutive relations (e_b = K_e*omega, tau = K_t*i).
//   3. Step forward coupled electrical-mechanical state equations (di/dt, domega/dt).

pub type DCMotorParams = struct {
    armature_resistance_ohms: Float, // R_a
    armature_inductance_h: Float,    // L_a
    torque_constant_nm_per_a: Float, // K_t
    back_emf_constant_v_s_rad: Float,// K_e
    rotor_inertia_kg_m2: Float,      // J_m
    viscous_damping_nm_s_rad: Float // B_m
};

pub type MotorElectromechanicalState = struct {
    armature_current_a: Float,
    rotor_speed_rad_s: Float,
    rotor_position_rad: Float,
    electrical_torque_nm: Float,
    back_emf_v: Float
};

pub type PiezoTransducer = struct {
    piezo_constant_n_per_v: Float, // d33 or coupling factor
    capacitance_farads: Float,
    mechanical_stiffness_n_per_m: Float
};

pub fn dc_motor_params_new(r: Float, l: Float, kt: Float, ke: Float, j: Float, b: Float) -> DCMotorParams {
    return DCMotorParams {
        armature_resistance_ohms: r,
        armature_inductance_h: l,
        torque_constant_nm_per_a: kt,
        back_emf_constant_v_s_rad: ke,
        rotor_inertia_kg_m2: j,
        viscous_damping_nm_s_rad: b
    };
}

pub fn dc_motor_step(params: &DCMotorParams, state: &MotorElectromechanicalState, v_applied: Float, load_torque: Float, dt: Float) -> MotorElectromechanicalState {
    let r: Float = (params).armature_resistance_ohms;
    let l: Float = (params).armature_inductance_h;
    let kt: Float = (params).torque_constant_nm_per_a;
    let ke: Float = (params).back_emf_constant_v_s_rad;
    let j: Float = (params).rotor_inertia_kg_m2;
    let b: Float = (params).viscous_damping_nm_s_rad;

    let curr_i: Float = (state).armature_current_a;
    let curr_w: Float = (state).rotor_speed_rad_s;
    let curr_th: Float = (state).rotor_position_rad;

    // Gyrator coupling relations
    let e_b: Float = ke * curr_w;
    let tau_e: Float = kt * curr_i;

    // Electrical derivative: di/dt = (V - R*i - e_b) / L
    let di_dt: Float = if l > 0.0 { (v_applied - (r * curr_i) - e_b) / l } else { 0.0 };
    // Mechanical derivative: dw/dt = (tau_e - B*w - tau_load) / J
    let dw_dt: Float = if j > 0.0 { (tau_e - (b * curr_w) - load_torque) / j } else { 0.0 };

    let next_i: Float = curr_i + (di_dt * dt);
    let next_w: Float = curr_w + (dw_dt * dt);
    let next_th: Float = curr_th + (curr_w * dt);

    return MotorElectromechanicalState {
        armature_current_a: next_i,
        rotor_speed_rad_s: next_w,
        rotor_position_rad: next_th,
        electrical_torque_nm: kt * next_i,
        back_emf_v: ke * next_w
    };
}

pub fn piezo_eval_force_charge(piezo: &PiezoTransducer, voltage_v: Float, displacement_m: Float) -> List[Float] {
    // Piezo 2-port transformer: Force = K_mech * x - d * V, Charge = C_p * V + d * x
    let d: Float = (piezo).piezo_constant_n_per_v;
    let k: Float = (piezo).mechanical_stiffness_n_per_m;
    let c: Float = (piezo).capacitance_farads;

    let force_n: Float = (k * displacement_m) - (d * voltage_v);
    let charge_c: Float = (c * voltage_v) + (d * displacement_m);

    let mut res: List[Float] = list_new();
    res = list_push(res, force_n);
    res = list_push(res, charge_c);
    return res;
}
