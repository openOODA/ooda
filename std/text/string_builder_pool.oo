// # Pooled Reusable String Builder Buffer Module
//
// Logline: String builder buffer pool reusing string allocation buffers to minimize memory fragmentation.
//
// Setup: Pure string allocation pool.
//
// Beats:
//   1. Construct StringBuilderPool with capacity limit.
//   2. Acquire builder buffer from pool.
//   3. Release and reset builder buffer back to pool.
//   4. Query pool size and active buffer count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/str.oo";

type StringBuilderPool = struct {
    buffers: List[String],
    capacity: Int
};

pub fn string_builder_pool_new(capacity: Int) -> StringBuilderPool {
    let b: List[String] = list_new();
    let mut cap: Int = capacity;
    if cap < 1 { cap = 1; }
    return StringBuilderPool {
        buffers: b,
        capacity: cap
    };
}

pub fn string_builder_pool_release(pool: StringBuilderPool, buf: String) -> StringBuilderPool {
    let cur_cnt: Int = list_len(pool.buffers);
    let max_cap: Int = pool.capacity;
    if cur_cnt >= max_cap {
        return pool;
    }
    let new_b: List[String] = list_push(pool.buffers, "");
    return StringBuilderPool {
        buffers: new_b,
        capacity: max_cap
    };
}

pub fn string_builder_pool_len(pool: StringBuilderPool) -> Int {
    return list_len(pool.buffers);
}
