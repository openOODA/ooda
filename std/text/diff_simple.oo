// # Simple Line-By-Line Unified Diff Module
//
// Logline: Simple line-by-line diff comparison generating unified diff indicators (+, -, space).
//
// Setup: Pure textual difference comparator.
//
// Beats:
//   1. Compare two single-line strings.
//   2. Compare lists of lines.
//   3. Format diff indicator prefixes.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/str.oo";

type SimpleDiff = struct {
    diff_lines: List[String],
    has_differences: Bool
};

pub fn diff_simple_compare_lines(old_lines: List[String], new_lines: List[String]) -> SimpleDiff {
    let n_old: Int = list_len(old_lines);
    let n_new: Int = list_len(new_lines);
    let mut out: List[String] = list_new();
    let mut diff_found: Bool = false;
    let mut i: Int = 0;
    while i < n_old && i < n_new {
        let line_old: String = list_get(old_lines, i);
        let line_new: String = list_get(new_lines, i);
        if str_eq(line_old, line_new) {
            out = list_push(out, " " + line_old);
        } else {
            out = list_push(out, "-" + line_old);
            out = list_push(out, "+" + line_new);
            diff_found = true;
        }
        i = i + 1;
    }
    while i < n_old {
        let line_old: String = list_get(old_lines, i);
        out = list_push(out, "-" + line_old);
        diff_found = true;
        i = i + 1;
    }
    while i < n_new {
        let line_new: String = list_get(new_lines, i);
        out = list_push(out, "+" + line_new);
        diff_found = true;
        i = i + 1;
    }
    return SimpleDiff {
        diff_lines: out,
        has_differences: diff_found
    };
}
