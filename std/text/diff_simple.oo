// # Simple Line-By-Line Unified Diff Module
//
// Logline: Simple line-by-line diff comparison generating unified diff indicators (+, -, space).
//
// Setup: Pure textual difference comparator.
//
// Beats:
//   1. Compare two single-line strings.
//   2. Compare lists of lines.
//   3. Format diff indicator prefixes.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

// residual: two-line compare; List[String] field emit gcc-fails oo_ilist_*

type SimpleDiff = struct {
    has_differences: Bool,
    equal_count: Int,
    diff_count: Int
};

pub fn diff_simple_compare_two(old_line: String, new_line: String) -> SimpleDiff {
    if str_eq(old_line, new_line) {
        return SimpleDiff {
            has_differences: false,
            equal_count: 1,
            diff_count: 0
        };
    }
    return SimpleDiff {
        has_differences: true,
        equal_count: 0,
        diff_count: 1
    };
}

pub fn diff_simple_has_diff(old_line: String, new_line: String) -> Bool {
    if str_eq(old_line, new_line) {
        return false;
    }
    return true;
}
