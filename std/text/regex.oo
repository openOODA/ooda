// # Regular Expression Engine Facade
//
// Logline: Unified high-level interface for regular expression compilation, matching, search, replace, and splitting.
//
// Setup: Composes regex parser, NFA simulation, match spans, and string transformation primitives into a cohesive API.
//
// Beats:
//   1. Compile regex patterns into Regex engine handles with configuration.
//   2. Test whole-string matching and find substring occurrences.
//   3. Perform single and global pattern replacement and token splitting.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";
import "std/text/regex_types.oo";
import "std/text/regex_parser.oo";
import "std/text/regex_nfa.oo";
import "std/text/regex_match.oo";

type Regex = struct {
    pattern: String,
    case_sensitive: Bool,
    is_valid: Bool
};

pub fn regex_compile(pattern: String) -> Result[Regex, String] {
    let valid_r: Result[Bool, String] = regex_validate_syntax(pattern);
    if valid_r.is_err() {
        let msg: String = match valid_r {
            Ok(v) => "invalid",
            Err(e) => e,
        };
        return Err(msg);
    }
    return Ok(Regex {
        pattern: pattern,
        case_sensitive: true,
        is_valid: true
    });
}

pub fn regex_compile_with_config(pattern: String, config: RegexConfig) -> Result[Regex, String] {
    let valid_r: Result[Bool, String] = regex_validate_syntax(pattern);
    if valid_r.is_err() {
        let msg: String = match valid_r {
            Ok(v) => "invalid",
            Err(e) => e,
        };
        return Err(msg);
    }
    return Ok(Regex {
        pattern: pattern,
        case_sensitive: config.case_sensitive,
        is_valid: true
    });
}

pub fn regex_is_match(re: Regex, text: String) -> Bool {
    let is_v: Bool = re.is_valid;
    if !is_v {
        return false;
    }
    return nfa_simulate(re.pattern, text);
}

pub fn regex_find(re: Regex, text: String) -> Result[String, String] {
    let is_v: Bool = re.is_valid;
    if !is_v {
        return Err("REGEX_ERR: invalid regex");
    }
    let m: MatchResult = match_pattern_first(text, re.pattern);
    let is_m: Bool = m.matched;
    if is_m {
        return Ok(m.matched_text);
    }
    return Err("NO_MATCH");
}

pub fn regex_find_span(re: Regex, text: String) -> RegexSpan {
    let is_v: Bool = re.is_valid;
    if !is_v {
        return regex_span_empty();
    }
    let m: MatchResult = match_pattern_first(text, re.pattern);
    let is_m: Bool = m.matched;
    if is_m {
        return regex_span_new(m.start, m.end, m.matched_text);
    }
    return regex_span_empty();
}

pub fn regex_replace(re: Regex, text: String, replacement: String) -> String {
    let is_v: Bool = re.is_valid;
    if !is_v {
        return text;
    }
    let m: MatchResult = match_pattern_first(text, re.pattern);
    let is_m: Bool = m.matched;
    if !is_m {
        return text;
    }
    let prefix: String = str_slice(text, 0, m.start);
    let suffix: String = str_slice(text, m.end, chars_len(text));
    return prefix + replacement + suffix;
}

pub fn regex_replace_all(re: Regex, text: String, replacement: String) -> String {
    let is_v: Bool = re.is_valid;
    if !is_v {
        return text;
    }
    let mut out: String = "";
    let mut cur: String = text;
    while chars_len(cur) > 0 {
        let m: MatchResult = match_pattern_first(cur, re.pattern);
        let is_m: Bool = m.matched;
    if !is_m {
            out = out + cur;
            break;
        }
        let prefix: String = str_slice(cur, 0, m.start);
        out = out + prefix + replacement;
        let mut next_start: Int = m.end;
        if next_start == m.start {
            next_start = next_start + 1;
            if next_start <= chars_len(cur) {
                out = out + str_slice(cur, m.start, next_start);
            }
        }
        if next_start < chars_len(cur) {
            cur = str_slice(cur, next_start, chars_len(cur));
        } else {
            cur = "";
        }
    }
    return out;
}

pub fn regex_split(re: Regex, text: String) -> List[String] {
    let mut out: List[String] = list_new();
    let is_v: Bool = re.is_valid;
    if !is_v {
        out = list_push(out, text);
        return out;
    }
    let mut cur: String = text;
    while chars_len(cur) > 0 {
        let m: MatchResult = match_pattern_first(cur, re.pattern);
        let is_m: Bool = m.matched;
    if !is_m {
            out = list_push(out, cur);
            break;
        }
        let chunk: String = str_slice(cur, 0, m.start);
        out = list_push(out, chunk);
        let mut next_start: Int = m.end;
        if next_start == m.start {
            next_start = next_start + 1;
        }
        if next_start < chars_len(cur) {
            cur = str_slice(cur, next_start, chars_len(cur));
        } else {
            cur = "";
        }
    }
    return out;
}
