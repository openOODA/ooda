// # String Formatting and Alignment Module
//
// Logline: Left/right/center text padding, truncation with ellipsis, numeric radix conversions, and thousands separation.
//
// Setup: Pure string formatter providing alignment, width clamping, and structured formatting primitives.
//
// Beats:
//   1. Pad strings to target widths with left, right, and center alignments.
//   2. Truncate long strings with customizable ellipsis suffixes.
//   3. Format integers into hex, binary, and delimited decimal representations.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type FormatOptions = struct {
    width: Int,
    pad_char: String,
    align_left: Bool
};

pub fn format_options_new(width: Int, pad_char: String, align_left: Bool) -> FormatOptions {
    return FormatOptions {
        width: width,
        pad_char: pad_char,
        align_left: align_left
    };
}

pub fn format_pad_left(s: String, width: Int, pad_char: String) -> String {
    let n: Int = chars_len(s);
    if n >= width {
        return s;
    }
    let pad_len: Int = width - n;
    let mut padding: String = "";
    let mut i: Int = 0;
    while i < pad_len {
        padding = padding + pad_char;
        i = i + 1;
    }
    return padding + s;
}

pub fn format_pad_right(s: String, width: Int, pad_char: String) -> String {
    let n: Int = chars_len(s);
    if n >= width {
        return s;
    }
    let pad_len: Int = width - n;
    let mut padding: String = "";
    let mut i: Int = 0;
    while i < pad_len {
        padding = padding + pad_char;
        i = i + 1;
    }
    return s + padding;
}

pub fn format_pad_center(s: String, width: Int, pad_char: String) -> String {
    let n: Int = chars_len(s);
    if n >= width {
        return s;
    }
    let total_pad: Int = width - n;
    let left_pad: Int = total_pad / 2;
    let right_pad: Int = total_pad - left_pad;
    let mut l_str: String = "";
    let mut r_str: String = "";
    let mut i: Int = 0;
    while i < left_pad {
        l_str = l_str + pad_char;
        i = i + 1;
    }
    let mut j: Int = 0;
    while j < right_pad {
        r_str = r_str + pad_char;
        j = j + 1;
    }
    return l_str + s + r_str;
}

pub fn format_truncate(s: String, max_width: Int, ellipsis: String) -> String {
    let n: Int = chars_len(s);
    if n <= max_width {
        return s;
    }
    let el_len: Int = chars_len(ellipsis);
    if max_width <= el_len {
        return str_slice(ellipsis, 0, max_width);
    }
    let keep_len: Int = max_width - el_len;
    return str_slice(s, 0, keep_len) + ellipsis;
}

pub fn format_int_to_hex(val: Int) -> String {
    if val == 0 {
        return "0";
    }
    let mut v: Int = val;
    let mut is_neg: Bool = false;
    if v < 0 {
        is_neg = true;
        v = 0 - v;
    }
    let hex_digits: String = "0123456789abcdef";
    let mut rev: String = "";
    while v > 0 {
        let rem: Int = v % 16;
        rev = rev + char_at(hex_digits, rem);
        v = v / 16;
    }
    let n: Int = chars_len(rev);
    let mut out: String = "";
    if is_neg {
        out = "-";
    }
    let mut k: Int = n - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}

pub fn format_int_to_bin(val: Int) -> String {
    if val == 0 {
        return "0";
    }
    let mut v: Int = val;
    let mut is_neg: Bool = false;
    if v < 0 {
        is_neg = true;
        v = 0 - v;
    }
    let mut rev: String = "";
    while v > 0 {
        let rem: Int = v % 2;
        if rem == 1 {
            rev = rev + "1";
        } else {
            rev = rev + "0";
        }
        v = v / 2;
    }
    let n: Int = chars_len(rev);
    let mut out: String = "";
    if is_neg {
        out = "-";
    }
    let mut k: Int = n - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}

pub fn format_thousands_separator(val: Int, sep: String) -> String {
    let s: String = val.to_string();
    let n: Int = chars_len(s);
    let mut start_idx: Int = 0;
    let mut is_neg: Bool = false;
    if n > 0 && char_at(s, 0) == "-" {
        is_neg = true;
        start_idx = 1;
    }
    let digits_len: Int = n - start_idx;
    if digits_len <= 3 {
        return s;
    }
    let mut out: String = "";
    if is_neg {
        out = "-";
    }
    let mut i: Int = start_idx;
    while i < n {
        let remaining: Int = n - i;
        if i > start_idx && (remaining % 3) == 0 {
            out = out + sep;
        }
        out = out + char_at(s, i);
        i = i + 1;
    }
    return out;
}

pub fn format_wrap_lines(s: String, max_line_len: Int) -> String {
    let n: Int = chars_len(s);
    if n <= max_line_len || max_line_len <= 0 {
        return s;
    }
    let mut out: String = "";
    let mut col: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\n" {
            out = out + c;
            col = 0;
        } else {
            if col >= max_line_len && c == " " {
                out = out + "\n";
                col = 0;
            } else {
                out = out + c;
                col = col + 1;
            }
        }
        i = i + 1;
    }
    return out;
}
