// # Phonetic Metaphone Encoding Module
//
// Logline: Metaphone phonetic encoding algorithm transforming English words into approximate pronunciation codes.
//
// Setup: Pure string metric module for phonetic spell checking and fuzzy name search without language models.
//
// Beats:
//   1. Normalize and strip non-alphabetic characters.
//   2. Apply English phonetic transformation rules (e.g. PH->F, CK->K, TH->0).
//   3. Retain initial vowels and drop interior unvoiced vowels.
//   4. Evaluate phonetic pronunciation equality predicate (metaphone_matches).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Double Metaphone alternate pronunciation branches lower via full phonetic engine.

fn to_upper_c(c: String) -> String {
    let o: Int = ord(c);
    if o >= 97 && o <= 122 {
        let up: Int = o - 32;
        if up == 65 { return "A"; }
        if up == 66 { return "B"; }
        if up == 67 { return "C"; }
        if up == 68 { return "D"; }
        if up == 69 { return "E"; }
        if up == 70 { return "F"; }
        if up == 71 { return "G"; }
        if up == 72 { return "H"; }
        if up == 73 { return "I"; }
        if up == 74 { return "J"; }
        if up == 75 { return "K"; }
        if up == 76 { return "L"; }
        if up == 77 { return "M"; }
        if up == 78 { return "N"; }
        if up == 79 { return "O"; }
        if up == 80 { return "P"; }
        if up == 81 { return "Q"; }
        if up == 82 { return "R"; }
        if up == 83 { return "S"; }
        if up == 84 { return "T"; }
        if up == 85 { return "U"; }
        if up == 86 { return "V"; }
        if up == 87 { return "W"; }
        if up == 88 { return "X"; }
        if up == 89 { return "Y"; }
        return "Z";
    }
    return c;
}

fn is_vowel(c: String) -> Bool {
    return c == "A" || c == "E" || c == "I" || c == "O" || c == "U";
}

pub fn metaphone_encode(word: String) -> String {
    let n: Int = chars_len(word);
    if n == 0 {
        return "";
    }

    // Clean to uppercase
    let mut upper: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = to_upper_c(char_at(word, i));
        let o: Int = ord(c);
        if o >= 65 && o <= 90 {
            upper = upper + c;
        }
        i = i + 1;
    }

    let un: Int = chars_len(upper);
    if un == 0 {
        return "";
    }

    let mut code: String = "";
    let first: String = char_at(upper, 0);
    if is_vowel(first) {
        code = first;
    }

    let mut pos: Int = 0;
    while pos < un && chars_len(code) < 6 {
        let c: String = char_at(upper, pos);
        let mut next_c: String = "";
        if pos + 1 < un {
            next_c = char_at(upper, pos + 1);
        }

        if c == "B" {
            if pos != un - 1 || char_at(upper, pos - 1) != "M" {
                code = code + "B";
            }
        } else if c == "C" {
            if next_c == "H" {
                code = code + "X";
                pos = pos + 1;
            } else if next_c == "I" || next_c == "E" || next_c == "Y" {
                code = code + "S";
            } else {
                code = code + "K";
            }
        } else if c == "D" {
            if next_c == "G" {
                code = code + "J";
                pos = pos + 1;
            } else {
                code = code + "T";
            }
        } else if c == "F" || c == "J" || c == "L" || c == "M" || c == "N" || c == "R" {
            code = code + c;
        } else if c == "G" {
            if next_c != "H" {
                code = code + "K";
            }
        } else if c == "P" {
            if next_c == "H" {
                code = code + "F";
                pos = pos + 1;
            } else {
                code = code + "P";
            }
        } else if c == "Q" {
            code = code + "K";
        } else if c == "S" {
            if next_c == "H" {
                code = code + "X";
                pos = pos + 1;
            } else {
                code = code + "S";
            }
        } else if c == "T" {
            if next_c == "H" {
                code = code + "0";
                pos = pos + 1;
            } else {
                code = code + "T";
            }
        } else if c == "V" {
            code = code + "F";
        } else if c == "X" {
            code = code + "KS";
        } else if c == "Z" {
            code = code + "S";
        }

        pos = pos + 1;
    }

    return code;
}

pub fn metaphone_matches(a: String, b: String) -> Bool {
    let ma: String = metaphone_encode(a);
    let mb: String = metaphone_encode(b);
    return ma == mb;
}
