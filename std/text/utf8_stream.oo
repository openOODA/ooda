// # UTF-8 Stream Decoder and Validator
//
// Logline: Stream-oriented UTF-8 byte sequence decoding, code point reconstruction, boundary navigation, and well-formedness validation.
//
// Setup: Pure byte-level decoder inspecting leading/trailing UTF-8 bytes and producing valid scalar values.
//
// Beats:
//   1. Determine UTF-8 byte length from leading byte markers.
//   2. Validate well-formedness of multi-byte sequences without overlong or surrogate forms.
//   3. Provide streaming reader interface to iterate through codepoints.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/byte.oo";

type Utf8DecodeResult = struct {
    codepoint: Int,
    byte_length: Int,
    is_valid: Bool
};

type Utf8Reader = struct {
    raw_data: String,
    byte_offset: Int,
    total_bytes: Int
};

pub fn utf8_reader_new(s: String) -> Utf8Reader {
    return Utf8Reader {
        raw_data: s,
        byte_offset: 0,
        total_bytes: byte_len(s)
    };
}

pub fn utf8_reader_has_next(r: Utf8Reader) -> Bool {
    return r.byte_offset < r.total_bytes;
}

pub fn utf8_lead_byte_len(b: Int) -> Int {
    if b >= 0 && b <= 127 {
        return 1;
    }
    if b >= 192 && b <= 223 {
        return 2;
    }
    if b >= 224 && b <= 239 {
        return 3;
    }
    if b >= 240 && b <= 247 {
        return 4;
    }
    return 0;
}

pub fn utf8_decode_rune_at(s: String, offset: Int) -> Utf8DecodeResult {
    let blen: Int = byte_len(s);
    if offset < 0 || offset >= blen {
        return Utf8DecodeResult { codepoint: 0, byte_length: 0, is_valid: false };
    }
    let b0: Int = byte_get(s, offset);
    let seq_len: Int = utf8_lead_byte_len(b0);
    if seq_len == 0 || offset + seq_len > blen {
        return Utf8DecodeResult { codepoint: 0, byte_length: 1, is_valid: false };
    }
    if seq_len == 1 {
        return Utf8DecodeResult { codepoint: b0, byte_length: 1, is_valid: true };
    }
    if seq_len == 2 {
        let b1: Int = byte_get(s, offset + 1);
        if b1 < 128 || b1 > 191 {
            return Utf8DecodeResult { codepoint: 0, byte_length: 1, is_valid: false };
        }
        let cp: Int = (b0 - 192) * 64 + (b1 - 128);
        return Utf8DecodeResult { codepoint: cp, byte_length: 2, is_valid: true };
    }
    if seq_len == 3 {
        let b1: Int = byte_get(s, offset + 1);
        let b2: Int = byte_get(s, offset + 2);
        if b1 < 128 || b1 > 191 || b2 < 128 || b2 > 191 {
            return Utf8DecodeResult { codepoint: 0, byte_length: 1, is_valid: false };
        }
        let cp: Int = (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128);
        return Utf8DecodeResult { codepoint: cp, byte_length: 3, is_valid: true };
    }
    if seq_len == 4 {
        let b1: Int = byte_get(s, offset + 1);
        let b2: Int = byte_get(s, offset + 2);
        let b3: Int = byte_get(s, offset + 3);
        if b1 < 128 || b1 > 191 || b2 < 128 || b2 > 191 || b3 < 128 || b3 > 191 {
            return Utf8DecodeResult { codepoint: 0, byte_length: 1, is_valid: false };
        }
        let cp: Int = (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128);
        return Utf8DecodeResult { codepoint: cp, byte_length: 4, is_valid: true };
    }
    return Utf8DecodeResult { codepoint: 0, byte_length: 1, is_valid: false };
}

pub fn utf8_read_next(mut r: Utf8Reader) -> Utf8DecodeResult {
    let res: Utf8DecodeResult = utf8_decode_rune_at(r.raw_data, r.byte_offset);
    if res.byte_length > 0 {
        r.byte_offset = r.byte_offset + res.byte_length;
    } else {
        r.byte_offset = r.byte_offset + 1;
    }
    return res;
}

pub fn utf8_is_valid_sequence(s: String) -> Bool {
    let total: Int = byte_len(s);
    let mut offset: Int = 0;
    while offset < total {
        let res: Utf8DecodeResult = utf8_decode_rune_at(s, offset);
        let is_v: Bool = res.is_valid;
        if !is_v {
            return false;
        }
        let bl: Int = res.byte_length;
        offset = offset + bl;
    }
    return true;
}

pub fn utf8_count_runes(s: String) -> Int {
    let total: Int = byte_len(s);
    let mut offset: Int = 0;
    let mut count: Int = 0;
    while offset < total {
        let res: Utf8DecodeResult = utf8_decode_rune_at(s, offset);
        count = count + 1;
        if res.byte_length > 0 {
            let bl: Int = res.byte_length;
        offset = offset + bl;
        } else {
            offset = offset + 1;
        }
    }
    return count;
}
