// # Regular Expression Bytecode Virtual Machine Module
//
// Logline: Virtual Machine execution engine for regular expression bytecode matching and submatch search.
//
// Setup: Pure text module. Implements Pike VM execution over linear bytecode instruction streams for linear-time regex matching.
//
// Beats:
//   1. Construct thread queue and trace execution paths across non-deterministic branching.
//   2. Step active VM threads on incoming characters (CHAR, ANY, MATCH).
//   3. Full string regex matching (regex_vm_match).
//   4. Substring regex search / find index (regex_vm_find).
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Submatch capture group extraction is layered over bytecode thread indices.

import "std/text/regex_bytecode.oo";

// Add thread PC to thread list, following JUMP and SPLIT instructions recursively.
pub fn regex_vm_add_thread(bc: RegexBytecode, threads: List[Int], pc: Int) -> List[Int] {
    let mut out: List[Int] = threads;
    let bclen: Int = regex_bc_len(bc);
    if pc < 0 || pc >= bclen {
        return out;
    }
    let n: Int = list_len(out);
    let mut exists: Bool = false;
    let mut i: Int = 0;
    while i < n {
        if list_get(out, i) == pc {
            exists = true;
        }
        i = i + 1;
    }
    if exists {
        return out;
    }

    let op: Int = regex_bc_get_op(bc, pc);
    if op == 3 {
        let target: Int = regex_bc_get_arg1(bc, pc);
        return regex_vm_add_thread(bc, out, target);
    } else if op == 4 {
        let t1: Int = regex_bc_get_arg1(bc, pc);
        let t2: Int = regex_bc_get_arg2(bc, pc);
        let out1: List[Int] = regex_vm_add_thread(bc, out, t1);
        return regex_vm_add_thread(bc, out1, t2);
    } else {
        out = list_push(out, pc);
        return out;
    }
}

// Test if bytecode matches text starting at pos0.
pub fn regex_vm_match_at(bc: RegexBytecode, text: String, pos0: Int) -> Bool {
    let tlen: Int = chars_len(text);
    let mut cur_threads: List[Int] = list_new();
    cur_threads = regex_vm_add_thread(bc, cur_threads, 0);

    let mut pos: Int = pos0;
    while pos <= tlen {
        let num_threads: Int = list_len(cur_threads);
        let mut t: Int = 0;
        while t < num_threads {
            let pc: Int = list_get(cur_threads, t);
            let op: Int = regex_bc_get_op(bc, pc);
            if op == 1 {
                return true;
            }
            t = t + 1;
        }

        if pos == tlen {
            return false;
        }

        let ch_code: Int = byte_at(text, pos);
        let mut next_threads: List[Int] = list_new();
        let mut j: Int = 0;
        while j < num_threads {
            let pc: Int = list_get(cur_threads, j);
            let op: Int = regex_bc_get_op(bc, pc);
            if op == 2 {
                let want_ch: Int = regex_bc_get_arg1(bc, pc);
                if want_ch == ch_code {
                    next_threads = regex_vm_add_thread(bc, next_threads, pc + 1);
                }
            } else if op == 5 {
                if ch_code != 10 {
                    next_threads = regex_vm_add_thread(bc, next_threads, pc + 1);
                }
            }
            j = j + 1;
        }

        cur_threads = next_threads;
        if list_len(cur_threads) == 0 {
            return false;
        }

        pos = pos + 1;
    }

    return false;
}

// Match entire string from start.
pub fn regex_vm_match(bc: RegexBytecode, text: String) -> Bool {
    return regex_vm_match_at(bc, text, 0);
}

// Search for first match anywhere in text, returning 0-based start index or -1 if not found.
pub fn regex_vm_find(bc: RegexBytecode, text: String) -> Int {
    let tlen: Int = chars_len(text);
    let mut i: Int = 0;
    while i <= tlen {
        let m: Bool = regex_vm_match_at(bc, text, i);
        if m {
            return i;
        }
        i = i + 1;
    }
    return -1;
}
