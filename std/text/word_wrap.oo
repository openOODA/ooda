// # Text Word Wrapping and Column Breaking Module
//
// Logline: Word wrapping paragraphs to bounded column widths, preserving word boundaries, and line-feed formatting.
//
// Setup: Pure string manipulation module formatting continuous text for terminal widths and layout blocks.
//
// Beats:
//   1. Construct WrapConfig with max column width boundary.
//   2. Split text into words and assemble wrapped line vectors (word_wrap_lines).
//   3. Re-join wrapped lines with standard newline separators (word_wrap_to_string).
//   4. Handle hyphenation and long token boundaries without buffer overflow.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Dynamic Knuth-Plass minimum raggedness optimal breaking lowers via layout engine.

type WrapConfig = struct {
    max_width: Int,
    break_words: Bool
};

pub fn wrap_config_new(width: Int) -> WrapConfig {
    let mut w: Int = width;
    if w <= 0 {
        w = 80;
    }
    return WrapConfig {
        max_width: w,
        break_words: true
    };
}

fn split_words(text: String) -> List[String] {
    let n: Int = chars_len(text);
    let mut words: List[String] = list_new();
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(text, i);
        if c == " " || c == "\t" || c == "\n" {
            if chars_len(cur) > 0 {
                words = list_push(words, cur);
                cur = "";
            }
        } else {
            cur = cur + c;
        }
        i = i + 1;
    }
    if chars_len(cur) > 0 {
        words = list_push(words, cur);
    }
    return words;
}

pub fn word_wrap_lines(text: String, cfg: WrapConfig) -> List[String] {
    let words: List[String] = split_words(text);
    let num_words: Int = list_len(words);
    let mut lines: List[String] = list_new();
    let max_w: Int = cfg.max_width;

    if num_words == 0 {
        return lines;
    }

    let mut cur_line: String = "";
    let mut cur_len: Int = 0;
    let mut i: Int = 0;

    while i < num_words {
        let w: String = list_get(words, i);
        let wlen: Int = chars_len(w);

        if cur_len == 0 {
            cur_line = w;
            cur_len = wlen;
        } else {
            if cur_len + 1 + wlen <= max_w {
                cur_line = cur_line + " " + w;
                cur_len = cur_len + 1 + wlen;
            } else {
                lines = list_push(lines, cur_line);
                cur_line = w;
                cur_len = wlen;
            }
        }
        i = i + 1;
    }

    if cur_len > 0 {
        lines = list_push(lines, cur_line);
    }

    return lines;
}

pub fn word_wrap_to_string(text: String, cfg: WrapConfig) -> String {
    let max_w: Int = cfg.max_width;
    let n: Int = chars_len(text);
    let mut out: String = "";
    let mut line: String = "";
    let mut line_len: Int = 0;
    let mut word: String = "";
    let mut word_len: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        let mut is_space: Bool = false;
        if i == n {
            is_space = true;
        } else {
            let c: String = char_at(text, i);
            if c == " " || c == "\t" || c == "\n" {
                is_space = true;
            }
        }
        if is_space == true {
            if word_len > 0 {
                if line_len == 0 {
                    line = word;
                    line_len = word_len;
                } else {
                    if line_len + 1 + word_len <= max_w {
                        line = line + " " + word;
                        line_len = line_len + 1 + word_len;
                    } else {
                        if chars_len(out) == 0 {
                            out = line;
                        } else {
                            out = out + "\n" + line;
                        }
                        line = word;
                        line_len = word_len;
                    }
                }
                word = "";
                word_len = 0;
            }
        } else {
            word = word + char_at(text, i);
            word_len = word_len + 1;
        }
        i = i + 1;
    }
    if line_len > 0 {
        if chars_len(out) == 0 {
            return line;
        }
        return out + "\n" + line;
    }
    return out;
}
