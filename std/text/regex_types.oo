// # Regular Expression Type Definitions
//
// Logline: Abstract syntax tree nodes, token models, match spans, and configuration records for regex parsing and execution.
//
// Setup: Pure data structures for NFA/DFA engines, tokenizers, and match runners.
//
// Beats:
//   1. Define regex token types and AST node representations.
//   2. Define matcher configuration flags and capture records.
//   3. Provide constructor and helper functions for regex data models.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type RegexToken = struct {
    kind: String,
    value: String,
    min_rep: Int,
    max_rep: Int
};

type RegexAst = struct {
    node_type: String,
    pattern: String,
    flags: String
};

type RegexConfig = struct {
    case_sensitive: Bool,
    multi_line: Bool,
    dot_all: Bool
};

type RegexCapture = struct {
    name: String,
    start_pos: Int,
    end_pos: Int,
    value: String
};

type RegexSpan = struct {
    start_idx: Int,
    end_idx: Int,
    matched_text: String
};

pub fn regex_token_new(kind: String, value: String, min_rep: Int, max_rep: Int) -> RegexToken {
    return RegexToken {
        kind: kind,
        value: value,
        min_rep: min_rep,
        max_rep: max_rep
    };
}

pub fn regex_ast_new(node_type: String, pattern: String, flags: String) -> RegexAst {
    return RegexAst {
        node_type: node_type,
        pattern: pattern,
        flags: flags
    };
}

pub fn regex_config_default() -> RegexConfig {
    return RegexConfig {
        case_sensitive: true,
        multi_line: false,
        dot_all: false
    };
}

pub fn regex_config_case_insensitive() -> RegexConfig {
    return RegexConfig {
        case_sensitive: false,
        multi_line: false,
        dot_all: false
    };
}

pub fn regex_capture_new(name: String, start_pos: Int, end_pos: Int, value: String) -> RegexCapture {
    return RegexCapture {
        name: name,
        start_pos: start_pos,
        end_pos: end_pos,
        value: value
    };
}

pub fn regex_span_new(start_idx: Int, end_idx: Int, matched_text: String) -> RegexSpan {
    return RegexSpan {
        start_idx: start_idx,
        end_idx: end_idx,
        matched_text: matched_text
    };
}

pub fn regex_span_empty() -> RegexSpan {
    return RegexSpan {
        start_idx: -1,
        end_idx: -1,
        matched_text: ""
    };
}
