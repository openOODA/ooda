// # URL Slug Generator and Text Normalizer Module
//
// Logline: URL-safe slug generator converting arbitrary text into kebab-case ASCII strings.
//
// Setup: Pure text sanitization and normalization module.
//
// Beats:
//   1. Convert uppercase letters to lowercase.
//   2. Replace spaces and punctuation with hyphens.
//   3. Deduplicate consecutive hyphens and trim leading/trailing hyphens.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

fn slug_clean_char(ch: String) -> String {
    let upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let lower: String = "abcdefghijklmnopqrstuvwxyz";
    let idx: Int = str_index_of(upper, ch);
    if idx >= 0 {
        return char_at(lower, idx);
    }
    let digits: String = "0123456789";
    if str_contains(digits, ch) || str_contains(lower, ch) {
        return ch;
    }
    return "-";
}

pub fn slug_generate(input_text: String) -> String {
    let n: Int = chars_len(input_text);
    if n == 0 { return ""; }
    let mut out: String = "";
    let mut prev_hyphen: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(input_text, i);
        let c: String = slug_clean_char(ch);
        if str_eq(c, "-") {
            if prev_hyphen == false && chars_len(out) > 0 {
                out = out + "-";
                prev_hyphen = true;
            }
        } else {
            out = out + c;
            prev_hyphen = false;
        }
        i = i + 1;
    }
    return out;
}
