// # Regular Expression Match Engine
//
// Logline: Substring span scanning, pattern searching, capture extraction, and occurrence counters.
//
// Setup: Evaluates text slices against regex matching logic and returns structured match span records.
//
// Beats:
//   1. Construct MatchResult records for hit detection and index spans.
//   2. Scan text for first and subsequent pattern matches.
//   3. Count matches and extract substrings by span.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";
import "std/text/regex_types.oo";
import "std/text/regex_nfa.oo";

type MatchResult = struct {
    matched: Bool,
    start: Int,
    end: Int,
    matched_text: String
};

pub fn match_result_none() -> MatchResult {
    return MatchResult {
        matched: false,
        start: -1,
        end: -1,
        matched_text: ""
    };
}

pub fn match_result_new(start: Int, end: Int, text: String) -> MatchResult {
    return MatchResult {
        matched: true,
        start: start,
        end: end,
        matched_text: text
    };
}

pub fn match_find_first_literal(text: String, pattern: String) -> MatchResult {
    let p_len: Int = chars_len(pattern);
    if p_len == 0 {
        return match_result_new(0, 0, "");
    }
    let idx: Int = str_index_of(text, pattern);
    if idx < 0 {
        return match_result_none();
    }
    let matched_str: String = str_slice(text, idx, idx + p_len);
    return match_result_new(idx, idx + p_len, matched_str);
}

pub fn match_count_occurrences(text: String, pattern: String) -> Int {
    let p_len: Int = chars_len(pattern);
    if p_len == 0 {
        return 0;
    }
    let mut count: Int = 0;
    let mut cur: String = text;
    while true {
        let idx: Int = str_index_of(cur, pattern);
        if idx < 0 {
            break;
        }
        count = count + 1;
        let cur_len: Int = chars_len(cur);
        cur = str_slice(cur, idx + p_len, cur_len);
    }
    return count;
}

pub fn match_extract_span(text: String, m: MatchResult) -> String {
    let is_m: Bool = m.matched;
    let ms: Int = m.start;
    let me: Int = m.end;
    if !is_m || ms < 0 || me < ms {
        return "";
    }
    let n: Int = chars_len(text);
    let mut safe_end: Int = m.end;
    if safe_end > n {
        safe_end = n;
    }
    let ms: Int = m.start;
    return str_slice(text, ms, safe_end);
}

pub fn match_pattern_first(text: String, pattern: String) -> MatchResult {
    let t_len: Int = chars_len(text);
    let mut i: Int = 0;
    while i <= t_len {
        let mut j: Int = i;
        while j <= t_len {
            let sub: String = str_slice(text, i, j);
            if nfa_simulate(pattern, sub) {
                return match_result_new(i, j, sub);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return match_result_none();
}
