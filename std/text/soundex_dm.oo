// # Daitch-Mokotoff Soundex Phonetic Encoder Module
//
// Logline: Daitch-Mokotoff phonetic soundex encoding 6-digit phonetic representation for surnames.
//
// Setup: Pure phonetic string encoding module.
//
// Beats:
//   1. Convert character to phonetic digit code (0..9).
//   2. Filter duplicate consecutive phonetic digits.
//   3. Pad or truncate resulting phonetic string to 6 digits.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

fn dm_char_code(ch: String) -> String {
    if str_eq(ch, "b") || str_eq(ch, "p") || str_eq(ch, "v") || str_eq(ch, "f") { return "7"; }
    if str_eq(ch, "d") || str_eq(ch, "t") { return "3"; }
    if str_eq(ch, "l") { return "8"; }
    if str_eq(ch, "m") || str_eq(ch, "n") { return "6"; }
    if str_eq(ch, "r") { return "9"; }
    if str_eq(ch, "s") || str_eq(ch, "z") { return "4"; }
    return "0";
}

pub fn soundex_dm_encode(s: String) -> String {
    let lower: String = str_to_uppercase(s);
    let n: Int = chars_len(lower);
    if n == 0 { return "000000"; }
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n && chars_len(out) < 6 {
        let ch: String = char_at(lower, i);
        let code: String = dm_char_code(ch);
        if !str_eq(code, "0") {
            out = out + code;
        }
        i = i + 1;
    }
    while chars_len(out) < 6 {
        out = out + "0";
    }
    return out;
}
