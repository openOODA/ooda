// # Hamming Distance String Metric Module
//
// Logline: Hamming distance metric counting differing positions between equal-length strings or bit vectors.
//
// Setup: Pure string metric algorithm.
//
// Beats:
//   1. Validate strings have equal length.
//   2. Count differing character positions.
//   3. Compute normalized Hamming similarity ratio.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";
import "std/result.oo";

pub fn hamming_distance_str(s1: String, s2: String) -> Result[Int, String] {
    let n1: Int = chars_len(s1);
    let n2: Int = chars_len(s2);
    if n1 != n2 {
        return Err("LENGTH_MISMATCH");
    }
    let mut diff: Int = 0;
    let mut i: Int = 0;
    while i < n1 {
        let c1: String = char_at(s1, i);
        let c2: String = char_at(s2, i);
        if str_eq(c1, c2) == false {
            diff = diff + 1;
        }
        i = i + 1;
    }
    return Ok(diff);
}
