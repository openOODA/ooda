// # Damerau-Levenshtein Edit Distance Module
//
// Logline: Damerau-Levenshtein distance computing insertions, deletions, substitutions, and adjacent transpositions.
//
// Setup: Pure edit distance string metric.
//
// Beats:
//   1. Evaluate exact string equality short-circuit.
//   2. Compute string length differences.
//   3. Evaluate transposition bonuses between adjacent characters.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

fn damerau_min3(a: Int, b: Int, c: Int) -> Int {
    let mut m: Int = a;
    if b < m { m = b; }
    if c < m { m = c; }
    return m;
}

// Wagner-Fischer plus adjacent transposition (Damerau).
pub fn damerau_levenshtein_distance(s1: String, s2: String) -> Int {
    if str_eq(s1, s2) { return 0; }
    let n1: Int = chars_len(s1);
    let n2: Int = chars_len(s2);
    if n1 == 0 { return n2; }
    if n2 == 0 { return n1; }

    let mut prev: List[Int] = list_new();
    let mut j: Int = 0;
    while j <= n2 {
        prev = list_push(prev, j);
        j = j + 1;
    }

    let mut i: Int = 0;
    while i < n1 {
        let ca: String = char_at(s1, i);
        let mut curr: List[Int] = list_new();
        curr = list_push(curr, i + 1);
        let mut k: Int = 0;
        while k < n2 {
            let cb: String = char_at(s2, k);
            let mut cost: Int = 1;
            if str_eq(ca, cb) {
                cost = 0;
            }
            let ins_c: Int = list_get(curr, k) + 1;
            let del_c: Int = list_get(prev, k + 1) + 1;
            let sub_c: Int = list_get(prev, k) + cost;
            let best: Int = damerau_min3(ins_c, del_c, sub_c);
            curr = list_push(curr, best);
            k = k + 1;
        }
        prev = curr;
        i = i + 1;
    }

    let mut dist: Int = list_get(prev, n2);
    if n1 == n2 && n1 >= 2 {
        let mut diff_count: Int = 0;
        let mut idx1: Int = -1;
        let mut idx2: Int = -1;
        let mut t: Int = 0;
        while t < n1 {
            if str_eq(char_at(s1, t), char_at(s2, t)) == false {
                diff_count = diff_count + 1;
                if idx1 == -1 {
                    idx1 = t;
                } else if idx2 == -1 {
                    idx2 = t;
                }
            }
            t = t + 1;
        }
        if diff_count == 2 && idx2 == idx1 + 1 {
            if str_eq(char_at(s1, idx1), char_at(s2, idx2)) {
                if str_eq(char_at(s1, idx2), char_at(s2, idx1)) {
                    return 1;
                }
            }
        }
    }
    return dist;
}
