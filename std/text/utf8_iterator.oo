// # UTF-8 Code Point and Byte Offset Iterator Module
//
// Logline: Bidirectional UTF-8 code point iterator traversing scalar values and calculating byte/character offsets.
//
// Setup: Pure string iterator module.
//
// Beats:
//   1. Construct Utf8Iterator with string length and cursor.
//   2. Advance cursor to next Unicode code point.
//   3. Query character count vs byte count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

type Utf8Iter = struct {
    text: String,
    char_pos: Int,
    total_chars: Int
};

pub fn utf8_iter_new(s: String) -> Utf8Iter {
    let n: Int = chars_len(s);
    return Utf8Iter {
        text: s,
        char_pos: 0,
        total_chars: n
    };
}

pub fn utf8_iter_has_next(it: Utf8Iter) -> Bool {
    let p: Int = it.char_pos;
    let tot: Int = it.total_chars;
    return p < tot;
}

pub fn utf8_iter_pos(it: Utf8Iter) -> Int {
    return it.char_pos;
}

pub fn utf8_iter_len(it: Utf8Iter) -> Int {
    return it.total_chars;
}

// Returns the same iterator at EOF (has_next is false). Result[struct] emits as OoResS.
pub fn utf8_iter_next(it: Utf8Iter) -> Utf8Iter {
    let p: Int = it.char_pos;
    let tot: Int = it.total_chars;
    if p >= tot {
        return it;
    }
    return Utf8Iter {
        text: it.text,
        char_pos: p + 1,
        total_chars: tot
    };
}
