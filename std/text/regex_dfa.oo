// # Deterministic Finite Automaton (DFA) Engine
//
// Logline: DFA transition state tables, subset transitions, alphabet indexing, and deterministic pattern matching.
//
// Setup: Fast single-pass deterministic automaton matcher with state transitions.
//
// Beats:
//   1. Define DFA state and transition table models.
//   2. Add and look up state transitions by input symbols.
//   3. Execute deterministic string traversal over compiled DFA tables.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type DfaState = struct {
    id: Int,
    is_terminal: Bool,
    transitions: String
};

type DfaTable = struct {
    num_states: Int,
    transitions_blob: String,
    terminal_states: String
};

fn int_to_str(val: Int) -> String {
    if val == 0 {
        return "0";
    }
    let mut v: Int = val;
    let mut is_neg: Bool = false;
    if v < 0 {
        is_neg = true;
        v = 0 - v;
    }
    let digits: String = "0123456789";
    let mut rev: String = "";
    while v > 0 {
        let rem: Int = v % 10;
        rev = rev + char_at(digits, rem);
        v = v / 10;
    }
    let n: Int = chars_len(rev);
    let mut out: String = "";
    if is_neg {
        out = "-";
    }
    let mut k: Int = n - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}

pub fn dfa_table_new() -> DfaTable {
    return DfaTable {
        num_states: 1,
        transitions_blob: "",
        terminal_states: ""
    };
}

pub fn dfa_add_transition(table: DfaTable, from_state: Int, symbol: String, to_state: Int) -> DfaTable {
    let key: String = int_to_str(from_state) + ":" + symbol + "=" + int_to_str(to_state) + ";";
    let tb: String = table.transitions_blob;
    let new_blob: String = tb + key;
    let cur_num: Int = table.num_states;
    let mut new_num: Int = cur_num;
    if to_state >= cur_num {
        new_num = to_state + 1;
    }
    return DfaTable {
        num_states: new_num,
        transitions_blob: new_blob,
        terminal_states: table.terminal_states
    };
}

pub fn dfa_set_terminal(table: DfaTable, state: Int) -> DfaTable {
    let tag: String = ":" + int_to_str(state) + ":";
    let mut new_term: String = table.terminal_states;
    if !str_contains(table.terminal_states, tag) {
        let ts: String = table.terminal_states;
        new_term = ts + tag;
    }
    return DfaTable {
        num_states: table.num_states,
        transitions_blob: table.transitions_blob,
        terminal_states: new_term
    };
}

pub fn dfa_is_terminal(table: DfaTable, state: Int) -> Bool {
    let tag: String = ":" + int_to_str(state) + ":";
    return str_contains(table.terminal_states, tag);
}

pub fn dfa_step(table: DfaTable, current_state: Int, symbol: String) -> Int {
    let target_prefix: String = int_to_str(current_state) + ":" + symbol + "=";
    let idx: Int = str_index_of(table.transitions_blob, target_prefix);
    if idx < 0 {
        return -1;
    }
    let after_idx: Int = idx + chars_len(target_prefix);
    let blob_len: Int = chars_len(table.transitions_blob);
    let mut end_idx: Int = after_idx;
    while end_idx < blob_len {
        if char_at(table.transitions_blob, end_idx) == ";" {
            break;
        }
        end_idx = end_idx + 1;
    }
    let dest_str: String = str_slice(table.transitions_blob, after_idx, end_idx);
    return parse_int(dest_str);
}

pub fn dfa_simulate(table: DfaTable, text: String, start_state: Int) -> Bool {
    let n: Int = chars_len(text);
    let mut current_state: Int = start_state;
    let mut i: Int = 0;
    while i < n {
        let sym: String = char_at(text, i);
        let next_state: Int = dfa_step(table, current_state, sym);
        if next_state < 0 {
            return false;
        }
        current_state = next_state;
        i = i + 1;
    }
    return dfa_is_terminal(table, current_state);
}

pub fn dfa_from_simple_literal(pattern: String) -> DfaTable {
    let mut table: DfaTable = dfa_table_new();
    let n: Int = chars_len(pattern);
    let mut i: Int = 0;
    while i < n {
        let sym: String = char_at(pattern, i);
        table = dfa_add_transition(table, i, sym, i + 1);
        i = i + 1;
    }
    table = dfa_set_terminal(table, n);
    return table;
}
