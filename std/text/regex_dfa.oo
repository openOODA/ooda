// # Deterministic Finite Automaton (DFA) Engine
//
// Logline: Compile literals and [ab] classes into one transition string, then simulate it.
//
// Setup: Table is an owned string (not a struct of strings) so emit ARC cannot drop the blob.
//
// Beats:
//   1. Encode transitions as from:sym=to; and terminals as T:state;.
//   2. Compile literals and [class] into that string.
//   3. Simulate the table for a full match.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type DfaTable = String;

fn dfa_find(hay: String, needle: String) -> Int {
    let hn: Int = chars_len(hay);
    let nn: Int = chars_len(needle);
    if nn <= 0 {
        return 0;
    }
    if nn > hn {
        return -1;
    }
    let mut i: Int = 0;
    while i + nn <= hn {
        if str_slice(hay, i, i + nn) == needle {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn dfa_parse_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut v: Int = 0;
    let mut i: Int = 0;
    let digits: String = "0123456789";
    while i < n {
        let c: String = char_at(s, i);
        let d: Int = dfa_find(digits, c);
        if d < 0 {
            return v;
        }
        v = v * 10 + d;
        i = i + 1;
    }
    return v;
}

fn int_to_str(val: Int) -> String {
    if val == 0 {
        return "0";
    }
    let mut v: Int = val;
    let mut is_neg: Bool = false;
    if v < 0 {
        is_neg = true;
        v = 0 - v;
    }
    let digits: String = "0123456789";
    let mut rev: String = "";
    while v > 0 {
        let rem: Int = v % 10;
        rev = rev + char_at(digits, rem);
        v = v / 10;
    }
    let n: Int = chars_len(rev);
    let mut out: String = "";
    if is_neg {
        out = "-";
    }
    let mut k: Int = n - 1;
    while k >= 0 {
        out = out + char_at(rev, k);
        k = k - 1;
    }
    return out;
}

fn dfa_class_end(pattern: String, open_idx: Int) -> Int {
    let n: Int = chars_len(pattern);
    let mut i: Int = open_idx + 1;
    while i < n {
        if char_at(pattern, i) == "]" {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn dfa_table_new() -> DfaTable {
    return "";
}

pub fn dfa_add_transition(table: DfaTable, from_state: Int, symbol: String, to_state: Int) -> DfaTable {
    return table + int_to_str(from_state) + ":" + symbol + "=" + int_to_str(to_state) + ";";
}

pub fn dfa_set_terminal(table: DfaTable, state: Int) -> DfaTable {
    let tag: String = "T:" + int_to_str(state) + ";";
    if dfa_find(table, tag) >= 0 {
        return table;
    }
    return table + tag;
}

pub fn dfa_is_terminal(table: DfaTable, state: Int) -> Bool {
    return dfa_find(table, "T:" + int_to_str(state) + ";") >= 0;
}

pub fn dfa_step(table: DfaTable, current_state: Int, symbol: String) -> Int {
    let target_prefix: String = int_to_str(current_state) + ":" + symbol + "=";
    let idx: Int = dfa_find(table, target_prefix);
    if idx < 0 {
        return -1;
    }
    let after_idx: Int = idx + chars_len(target_prefix);
    let blob_len: Int = chars_len(table);
    let mut end_idx: Int = after_idx;
    while end_idx < blob_len {
        if char_at(table, end_idx) == ";" {
            break;
        }
        end_idx = end_idx + 1;
    }
    return dfa_parse_int(str_slice(table, after_idx, end_idx));
}

pub fn dfa_simulate(table: DfaTable, text: String, start_state: Int) -> Bool {
    let n: Int = chars_len(text);
    let mut current_state: Int = start_state;
    let mut i: Int = 0;
    while i < n {
        let next_state: Int = dfa_step(table, current_state, char_at(text, i));
        if next_state < 0 {
            return false;
        }
        current_state = next_state;
        i = i + 1;
    }
    return dfa_is_terminal(table, current_state);
}

pub fn dfa_from_simple_literal(pattern: String) -> DfaTable {
    return dfa_compile(pattern);
}

pub fn dfa_compile(pattern: String) -> DfaTable {
    let mut table: DfaTable = "";
    let n: Int = chars_len(pattern);
    if n == 0 {
        return dfa_set_terminal(table, 0);
    }
    let mut i: Int = 0;
    let mut state: Int = 0;
    while i < n {
        let c: String = char_at(pattern, i);
        let next_state: Int = state + 1;
        if c == "[" {
            let close: Int = dfa_class_end(pattern, i);
            if close > i {
                let mut k: Int = i + 1;
                while k < close {
                    table = dfa_add_transition(table, state, char_at(pattern, k), next_state);
                    k = k + 1;
                }
                i = close + 1;
                state = next_state;
            } else {
                table = dfa_add_transition(table, state, c, next_state);
                i = i + 1;
                state = next_state;
            }
        } else {
            table = dfa_add_transition(table, state, c, next_state);
            i = i + 1;
            state = next_state;
        }
    }
    return dfa_set_terminal(table, state);
}
