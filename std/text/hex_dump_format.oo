// # Hex Dump Visual Formatter Module
//
// Logline: Canonical hex dump visualizer formatting byte offset, 16-byte hex columns, and ASCII printable column.
//
// Setup: Pure visual formatting module for binary debugging.
//
// Beats:
//   1. Format 16-byte chunk into two 8-byte hex columns with divider.
//   2. Format ASCII representation column replacing non-printables with dot.
//   3. Assemble complete formatted hex dump row.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/text/format.oo";

pub fn hex_dump_byte(b: Int) -> String {
    let hex_digits: String = "0123456789abcdef";
    let hi: Int = (b / 16) & 15;
    let lo: Int = b & 15;
    let c1: String = char_at(hex_digits, hi);
    let c2: String = char_at(hex_digits, lo);
    return c1 + c2;
}

pub fn hex_dump_row(offset: Int, bytes: List[Int]) -> String {
    let hex_off: String = format_pad_left(format_int_to_hex(offset), 8, "0");
    let n: Int = list_len(bytes);
    let mut hex_part: String = "";
    let mut i: Int = 0;
    while i < 16 {
        if i < n {
            let b: Int = list_get(bytes, i);
            hex_part = hex_part + hex_dump_byte(b) + " ";
        } else {
            hex_part = hex_part + "   ";
        }
        i = i + 1;
    }
    return hex_off + ": " + hex_part;
}
