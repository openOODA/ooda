// # Regular Expression Bytecode Instruction Set Module
//
// Logline: Regular expression virtual machine bytecode instruction emitter, opcode encodings, and disassembly.
//
// Setup: Pure text module. Encodes regex compilation targets into compact linear instruction streams (CHAR, MATCH, JUMP, SPLIT, ANY).
//
// Beats:
//   1. Define opcode constants (OP_MATCH, OP_CHAR, OP_JUMP, OP_SPLIT, OP_ANY).
//   2. Construct RegexBytecode container holding linear bytecode list.
//   3. Emit instruction variants with opcode operands.
//   4. Query instruction fields and disassemble stream.
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: JIT machine code compilation lowers regex bytecode to native x86_64/ARM64 via backend.

type RegexBytecode = struct {
    code: List[Int],
    length: Int
};

// Create an empty RegexBytecode container.
pub fn regex_bc_new() -> RegexBytecode {
    let empty_code: List[Int] = list_new();
    return RegexBytecode {
        code: empty_code,
        length: 0
    };
}

// Return number of instructions in bytecode stream.
pub fn regex_bc_len(bc: RegexBytecode) -> Int {
    return bc.length;
}

// Emit MATCH instruction (end of match).
pub fn regex_bc_emit_match(bc: RegexBytecode) -> RegexBytecode {
    let mut new_c: List[Int] = list_new();
    let n: Int = list_len(bc.code);
    let mut i: Int = 0;
    while i < n {
        new_c = list_push(new_c, list_get(bc.code, i));
        i = i + 1;
    }
    new_c = list_push(new_c, 1);
    new_c = list_push(new_c, 0);
    new_c = list_push(new_c, 0);
    let cur_len: Int = bc.length;
    let next_len: Int = cur_len + 1;
    return RegexBytecode {
        code: new_c,
        length: next_len
    };
}

// Emit CHAR instruction matching specific character code.
pub fn regex_bc_emit_char(bc: RegexBytecode, ch: Int) -> RegexBytecode {
    let mut new_c: List[Int] = list_new();
    let n: Int = list_len(bc.code);
    let mut i: Int = 0;
    while i < n {
        new_c = list_push(new_c, list_get(bc.code, i));
        i = i + 1;
    }
    new_c = list_push(new_c, 2);
    new_c = list_push(new_c, ch);
    new_c = list_push(new_c, 0);
    let cur_len: Int = bc.length;
    let next_len: Int = cur_len + 1;
    return RegexBytecode {
        code: new_c,
        length: next_len
    };
}

// Emit JUMP instruction targeting specific instruction index.
pub fn regex_bc_emit_jump(bc: RegexBytecode, target: Int) -> RegexBytecode {
    let mut new_c: List[Int] = list_new();
    let n: Int = list_len(bc.code);
    let mut i: Int = 0;
    while i < n {
        new_c = list_push(new_c, list_get(bc.code, i));
        i = i + 1;
    }
    new_c = list_push(new_c, 3);
    new_c = list_push(new_c, target);
    new_c = list_push(new_c, 0);
    let cur_len: Int = bc.length;
    let next_len: Int = cur_len + 1;
    return RegexBytecode {
        code: new_c,
        length: next_len
    };
}

// Emit SPLIT instruction branching execution to two target instruction indices.
pub fn regex_bc_emit_split(bc: RegexBytecode, target1: Int, target2: Int) -> RegexBytecode {
    let mut new_c: List[Int] = list_new();
    let n: Int = list_len(bc.code);
    let mut i: Int = 0;
    while i < n {
        new_c = list_push(new_c, list_get(bc.code, i));
        i = i + 1;
    }
    new_c = list_push(new_c, 4);
    new_c = list_push(new_c, target1);
    new_c = list_push(new_c, target2);
    let cur_len: Int = bc.length;
    let next_len: Int = cur_len + 1;
    return RegexBytecode {
        code: new_c,
        length: next_len
    };
}

// Emit ANY instruction matching any non-newline character.
pub fn regex_bc_emit_any(bc: RegexBytecode) -> RegexBytecode {
    let mut new_c: List[Int] = list_new();
    let n: Int = list_len(bc.code);
    let mut i: Int = 0;
    while i < n {
        new_c = list_push(new_c, list_get(bc.code, i));
        i = i + 1;
    }
    new_c = list_push(new_c, 5);
    new_c = list_push(new_c, 0);
    new_c = list_push(new_c, 0);
    let cur_len: Int = bc.length;
    let next_len: Int = cur_len + 1;
    return RegexBytecode {
        code: new_c,
        length: next_len
    };
}

// Get instruction opcode at instruction index inst_idx.
pub fn regex_bc_get_op(bc: RegexBytecode, inst_idx: Int) -> Int {
    let slot: Int = inst_idx * 3;
    return list_get(bc.code, slot);
}

// Get instruction arg1 at instruction index inst_idx.
pub fn regex_bc_get_arg1(bc: RegexBytecode, inst_idx: Int) -> Int {
    let slot: Int = inst_idx * 3 + 1;
    return list_get(bc.code, slot);
}

// Get instruction arg2 at instruction index inst_idx.
pub fn regex_bc_get_arg2(bc: RegexBytecode, inst_idx: Int) -> Int {
    let slot: Int = inst_idx * 3 + 2;
    return list_get(bc.code, slot);
}
