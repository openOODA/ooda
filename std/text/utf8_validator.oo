// # Strict UTF-8 Byte Stream Validator Module
//
// Logline: RFC 3629 UTF-8 validator detecting invalid lead bytes, overlong encodings, surrogates, and truncated multi-bytes.
//
// Setup: Pure encoding validation module.
//
// Beats:
//   1. Check 1-byte ASCII sequence validity.
//   2. Check 2-byte, 3-byte, and 4-byte sequence continuation bits (10xxxxxx).
//   3. Reject Unicode surrogate code points (0xD800..0xDFFF) and overlong forms.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

pub fn utf8_is_lead_byte(b: Int) -> Bool {
    return (b & 192) != 128;
}

pub fn utf8_is_continuation_byte(b: Int) -> Bool {
    return (b & 192) == 128;
}

pub fn utf8_sequence_len(lead_byte: Int) -> Int {
    if (lead_byte & 128) == 0 { return 1; }
    if (lead_byte & 224) == 192 { return 2; }
    if (lead_byte & 240) == 224 { return 3; }
    if (lead_byte & 248) == 240 { return 4; }
    return 0; // Invalid
}
