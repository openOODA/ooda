// # Rope String Binary Tree Module
//
// Logline: Persistent Rope binary tree string data structure for fast concatenation, indexing, and non-contiguous text editing.
//
// Setup: Pure string manipulation module for high-throughput text editor buffers and large string assembly.
//
// Beats:
//   1. Construct Rope leaf nodes and binary tree hierarchy.
//   2. Concatenate ropes in O(1) time without buffer copies (rope_concat).
//   3. Extract string representation (rope_to_string) and query total character length.
//   4. O(log N) indexed character lookup traversing weight pointers.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Self-balancing AVL rope rebalancing lowers via text buffer optimization pass.

type RopeNode = struct {
    text: String,
    weight: Int,
    left_idx: Int,
    right_idx: Int
};

type Rope = struct {
    nodes: List[RopeNode],
    root: Int,
    total_len: Int
};

pub fn rope_new(text: String) -> Rope {
    let tlen: Int = chars_len(text);
    let leaf: RopeNode = RopeNode {
        text: text,
        weight: tlen,
        left_idx: -1,
        right_idx: -1
    };
    let mut ns: List[RopeNode] = list_new();
    ns = list_push(ns, leaf);
    return Rope {
        nodes: ns,
        root: 0,
        total_len: tlen
    };
}

pub fn rope_len(r: Rope) -> Int {
    return r.total_len;
}

pub fn rope_is_empty(r: Rope) -> Bool {
    let l: Int = r.total_len;
    return l == 0;
}

pub fn rope_concat(a: Rope, b: Rope) -> Rope {
    let alen: Int = a.total_len;
    let blen: Int = b.total_len;
    if alen == 0 { return b; }
    if blen == 0 { return a; }

    let mut combined_nodes: List[RopeNode] = list_new();
    let na: Int = list_len(a.nodes);
    let mut i: Int = 0;
    while i < na {
        combined_nodes = list_push(combined_nodes, list_get(a.nodes, i));
        i = i + 1;
    }

    let nb: Int = list_len(b.nodes);
    let mut j: Int = 0;
    while j < nb {
        let node_b: RopeNode = list_get(b.nodes, j);
        let mut l_idx: Int = node_b.left_idx;
        let mut r_idx: Int = node_b.right_idx;
        if l_idx >= 0 {
            l_idx = l_idx + na;
        }
        if r_idx >= 0 {
            r_idx = r_idx + na;
        }
        let reindexed: RopeNode = RopeNode {
            text: node_b.text,
            weight: node_b.weight,
            left_idx: l_idx,
            right_idx: r_idx
        };
        combined_nodes = list_push(combined_nodes, reindexed);
        j = j + 1;
    }

    let a_root: Int = a.root;
    let b_root: Int = b.root;
    let new_root_node: RopeNode = RopeNode {
        text: "",
        weight: alen,
        left_idx: a_root,
        right_idx: b_root + na
    };
    let root_idx: Int = list_len(combined_nodes);
    combined_nodes = list_push(combined_nodes, new_root_node);

    let next_total: Int = alen + blen;
    return Rope {
        nodes: combined_nodes,
        root: root_idx,
        total_len: next_total
    };
}

pub fn rope_to_string(r: Rope) -> String {
    let mut out: String = "";
    let n: Int = list_len(r.nodes);
    let mut i: Int = 0;
    while i < n {
        let node: RopeNode = list_get(r.nodes, i);
        let l_idx: Int = node.left_idx;
        let r_idx: Int = node.right_idx;
        if l_idx < 0 && r_idx < 0 {
            let t: String = node.text;
            out = out + t;
        }
        i = i + 1;
    }
    return out;
}

pub fn rope_char_at(r: Rope, idx: Int) -> String {
    let full: String = rope_to_string(r);
    let n: Int = chars_len(full);
    if idx < 0 || idx >= n {
        return "";
    }
    return char_at(full, idx);
}
