// # Rope String Module
//
// Logline: Rope destubbed to a single String payload (emit cannot lower List[RopeNode]).
//
// Setup: Pure string assembly. Concat is string concat; length is chars_len.
//
// Beats:
//   1. Construct a rope from text.
//   2. Concatenate two ropes.
//   3. Extract string and query length.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: AVL rope node tree destubbed; emit List[struct] is oo_slist_push.

type Rope = struct {
    text: String,
    total_len: Int
};

pub fn rope_new(text: String) -> Rope {
    let tlen: Int = chars_len(text);
    return Rope {
        text: text,
        total_len: tlen
    };
}

pub fn rope_len(r: Rope) -> Int {
    return r.total_len;
}

pub fn rope_is_empty(r: Rope) -> Bool {
    let l: Int = r.total_len;
    return l == 0;
}

pub fn rope_concat(a: Rope, b: Rope) -> Rope {
    let alen: Int = a.total_len;
    let blen: Int = b.total_len;
    if alen == 0 { return b; }
    if blen == 0 { return a; }
    let at: String = a.text;
    let bt: String = b.text;
    let t: String = at + bt;
    return Rope {
        text: t,
        total_len: alen + blen
    };
}

pub fn rope_to_string(r: Rope) -> String {
    return r.text;
}

pub fn rope_char_at(r: Rope, idx: Int) -> String {
    let n: Int = r.total_len;
    if idx < 0 || idx >= n {
        return "";
    }
    let full: String = r.text;
    return char_at(full, idx);
}
