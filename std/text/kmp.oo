// # Knuth-Morris-Pratt (KMP) Substring Search Module
//
// Logline: Linear-time exact substring search, longest prefix-suffix (LPS) table construction, and multi-match index locator.
//
// Setup: Pre-processes pattern prefixes into jump tables to avoid backtracking during text scans.
//
// Beats:
//   1. Build longest prefix-suffix (LPS) lookup tables for needle patterns.
//   2. Locate the first occurrence index of needle in haystack in O(N+M) time.
//   3. Locate all occurrence indices and count total matches without backtracking.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type KmpPattern = struct {
    pattern: String,
    pattern_len: Int,
    lps: List[Int]
};

pub fn kmp_build_lps(pattern: String) -> List[Int] {
    let m: Int = chars_len(pattern);
    let mut lps: List[Int] = list_new();
    if m == 0 {
        return lps;
    }
    let mut k: Int = 0;
    while k < m {
        lps = list_push(lps, 0);
        k = k + 1;
    }

    let mut len: Int = 0;
    let mut i: Int = 1;
    while i < m {
        if char_at(pattern, i) == char_at(pattern, len) {
            len = len + 1;
            let mut new_lps: List[Int] = list_new();
            let mut idx: Int = 0;
            while idx < m {
                if idx == i {
                    new_lps = list_push(new_lps, len);
                } else {
                    new_lps = list_push(new_lps, list_get(lps, idx));
                }
                idx = idx + 1;
            }
            lps = new_lps;
            i = i + 1;
        } else {
            if len != 0 {
                len = list_get(lps, len - 1);
            } else {
                i = i + 1;
            }
        }
    }
    return lps;
}

pub fn kmp_compile(pattern: String) -> KmpPattern {
    let m: Int = chars_len(pattern);
    let lps: List[Int] = kmp_build_lps(pattern);
    return KmpPattern {
        pattern: pattern,
        pattern_len: m,
        lps: lps
    };
}

pub fn kmp_search_first(kmp: KmpPattern, text: String) -> Int {
    let n: Int = chars_len(text);
    let m: Int = kmp.pattern_len;
    if m == 0 {
        return 0;
    }
    if n < m {
        return -1;
    }

    let mut i: Int = 0;
    let mut j: Int = 0;
    while i < n {
        if char_at(text, i) == char_at(kmp.pattern, j) {
            i = i + 1;
            j = j + 1;
        }
        if j == m {
            return i - j;
        } else if i < n && char_at(text, i) != char_at(kmp.pattern, j) {
            if j != 0 {
                j = list_get(kmp.lps, j - 1);
            } else {
                i = i + 1;
            }
        }
    }
    return -1;
}

pub fn kmp_search_all(kmp: KmpPattern, text: String) -> List[Int] {
    let mut matches: List[Int] = list_new();
    let n: Int = chars_len(text);
    let m: Int = kmp.pattern_len;
    if m == 0 || n < m {
        return matches;
    }

    let mut i: Int = 0;
    let mut j: Int = 0;
    while i < n {
        if char_at(text, i) == char_at(kmp.pattern, j) {
            i = i + 1;
            j = j + 1;
        }
        if j == m {
            matches = list_push(matches, i - j);
            j = list_get(kmp.lps, j - 1);
        } else if i < n && char_at(text, i) != char_at(kmp.pattern, j) {
            if j != 0 {
                j = list_get(kmp.lps, j - 1);
            } else {
                i = i + 1;
            }
        }
    }
    return matches;
}

pub fn kmp_count(kmp: KmpPattern, text: String) -> Int {
    let matches: List[Int] = kmp_search_all(kmp, text);
    return list_len(matches);
}
