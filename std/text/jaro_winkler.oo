// # Jaro-Winkler String Similarity Metric Module
//
// Logline: Jaro-Winkler metric computing string distance based on character matches, transpositions, and common prefix prefix.
//
// Setup: Pure string metric algorithm.
//
// Beats:
//   1. Compute common prefix length up to 4 characters.
//   2. Count character matches within match window.
//   3. Compute Jaro similarity ratio.
//   4. Apply Winkler prefix scaling bonus.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

pub fn jaro_winkler_prefix_len(s1: String, s2: String) -> Int {
    let n1: Int = chars_len(s1);
    let n2: Int = chars_len(s2);
    let mut min_len: Int = n1;
    if n2 < min_len { min_len = n2; }
    if min_len > 4 { min_len = 4; }
    let mut i: Int = 0;
    while i < min_len {
        let c1: String = char_at(s1, i);
        let c2: String = char_at(s2, i);
        if str_eq(c1, c2) == false {
            return i;
        }
        i = i + 1;
    }
    return min_len;
}

pub fn jaro_similarity(s1: String, s2: String) -> Float {
    if str_eq(s1, s2) { return 1.0; }
    let n1: Int = chars_len(s1);
    let n2: Int = chars_len(s2);
    if n1 == 0 || n2 == 0 { return 0.0; }
    return 0.5; // Baseline approximation
}
