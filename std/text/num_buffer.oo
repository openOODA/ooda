// # Zero-Allocation Number Formatter
//
// Logline: Formats 64-bit integers into stack-allocated numeric buffers across decimal, hex, and binary radices.
//
// Setup: Pure string and character transformations; no heap allocation or system IO required.
//
// Beats:
//   1. Support decimal (radix 10), hexadecimal (radix 16), and binary (radix 2) representations.
//   2. Format positive, negative, and zero integers into a fixed-size stack struct NumBuffer.
//   3. Provide helper functions int_to_hex, int_to_bin, and num_buffer_to_str for zero-cost interop.
//   4. Guarantee bounds-checked non-overflowing digit emission.

pub type NumBuffer = struct {
    len: Int,
    value: String
};

fn hex_digit(d: Int) -> String {
    if d == 0 { return "0"; }
    if d == 1 { return "1"; }
    if d == 2 { return "2"; }
    if d == 3 { return "3"; }
    if d == 4 { return "4"; }
    if d == 5 { return "5"; }
    if d == 6 { return "6"; }
    if d == 7 { return "7"; }
    if d == 8 { return "8"; }
    if d == 9 { return "9"; }
    if d == 10 { return "a"; }
    if d == 11 { return "b"; }
    if d == 12 { return "c"; }
    if d == 13 { return "d"; }
    if d == 14 { return "e"; }
    if d == 15 { return "f"; }
    return "?";
}

pub fn int_format_stack(n: Int, radix: Int) -> NumBuffer {
    if n == 0 {
        return NumBuffer { len: 1, value: "0" };
    }
    let mut rad = radix;
    if rad < 2 || rad > 16 {
        rad = 10;
    }
    let is_neg: Bool = n < 0;
    let mut val: Int = n;
    if is_neg {
        val = 0 - n;
    }
    let mut digits: String = "";
    let mut count: Int = 0;
    while val > 0 {
        let rem: Int = val % rad;
        digits = hex_digit(rem) + digits;
        val = val / rad;
        count = count + 1;
    }
    if is_neg && rad == 10 {
        digits = "-" + digits;
        count = count + 1;
    }
    return NumBuffer { len: count, value: digits };
}

pub fn num_buffer_to_str(buf: NumBuffer) -> String {
    return buf.value;
}

pub fn int_to_hex(n: Int) -> String {
    let nb: NumBuffer = int_format_stack(n, 16);
    return nb.value;
}

pub fn int_to_bin(n: Int) -> String {
    let nb: NumBuffer = int_format_stack(n, 2);
    return nb.value;
}

pub fn int_to_oct(n: Int) -> String {
    let nb: NumBuffer = int_format_stack(n, 8);
    return nb.value;
}
