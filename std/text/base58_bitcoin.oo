// # Base58 Bitcoin Alphabet Encoder Module
//
// Logline: Base58 encoding using the Bitcoin alphabet without ambiguous characters (0, O, I, l).
//
// Setup: Pure binary-to-text encoding using alphabet "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz".
//
// Beats:
//   1. Define 58-character non-ambiguous Bitcoin alphabet.
//   2. Encode integer / byte list into Base58 representation.
//   3. Validate Base58 character validity.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

pub fn base58_bitcoin_alphabet() -> String {
    return "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
}

pub fn base58_bitcoin_is_valid_char(ch: String) -> Bool {
    let alpha: String = base58_bitcoin_alphabet();
    return str_contains(alpha, ch);
}

pub fn base58_bitcoin_encode_int(val: Int) -> String {
    if val == 0 {
        return "1";
    }
    let alpha: String = base58_bitcoin_alphabet();
    let mut v: Int = val;
    let mut rev: String = "";
    while v > 0 {
        let rem: Int = v % 58;
        rev = rev + char_at(alpha, rem);
        v = v / 58;
    }
    let n: Int = chars_len(rev);
    let mut out: String = "";
    let mut i: Int = n - 1;
    while i >= 0 {
        out = out + char_at(rev, i);
        i = i - 1;
    }
    return out;
}
