// # String Builder Buffer Module
//
// Logline: Mutable string accumulation, chunk aggregation, capacity growth, and formatted line emission.
//
// Setup: Pure string aggregation buffer for zero-alloc or reduced-alloc string concatenation patterns.
//
// Beats:
//   1. Initialize string builder buffers with default or specified capacity hints.
//   2. Append string segments, characters, numbers, and newline-terminated lines.
//   3. Extract accumulated string, query length, and reset buffer state.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type StringBuilder = struct {
    buffer: String,
    length: Int,
    chunk_count: Int
};

pub fn sb_new() -> StringBuilder {
    return StringBuilder {
        buffer: "",
        length: 0,
        chunk_count: 0
    };
}

pub fn sb_with_capacity(initial_cap: Int) -> StringBuilder {
    return StringBuilder {
        buffer: "",
        length: 0,
        chunk_count: 0
    };
}

pub fn sb_append(mut sb: StringBuilder, s: String) -> StringBuilder {
    let slen: Int = chars_len(s);
    if slen > 0 {
        sb.buffer = sb.buffer + s;
        sb.length = sb.length + slen;
        sb.chunk_count = sb.chunk_count + 1;
    }
    return sb;
}

pub fn sb_append_char(mut sb: StringBuilder, ch: String) -> StringBuilder {
    sb.buffer = sb.buffer + ch;
    sb.length = sb.length + 1;
    sb.chunk_count = sb.chunk_count + 1;
    return sb;
}

pub fn sb_append_int(mut sb: StringBuilder, val: Int) -> StringBuilder {
    let s: String = val.to_string();
    return sb_append(sb, s);
}

pub fn sb_append_line(mut sb: StringBuilder, line: String) -> StringBuilder {
    sb = sb_append(sb, line);
    sb = sb_append_char(sb, "\n");
    return sb;
}

pub fn sb_append_repeat(mut sb: StringBuilder, s: String, count: Int) -> StringBuilder {
    let mut i: Int = 0;
    while i < count {
        sb = sb_append(sb, s);
        i = i + 1;
    }
    return sb;
}

pub fn sb_to_string(sb: StringBuilder) -> String {
    return sb.buffer;
}

pub fn sb_len(sb: StringBuilder) -> Int {
    return sb.length;
}

pub fn sb_is_empty(sb: StringBuilder) -> Bool {
    return sb.length == 0;
}

pub fn sb_clear(mut sb: StringBuilder) -> StringBuilder {
    sb.buffer = "";
    sb.length = 0;
    sb.chunk_count = 0;
    return sb;
}
