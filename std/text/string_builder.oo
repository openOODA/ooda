// # String Builder Buffer Module
//
// Logline: Mutable string accumulation, chunk aggregation, capacity growth, and formatted line emission.
//
// Setup: Pure string aggregation buffer for zero-alloc or reduced-alloc string concatenation patterns.
//
// Beats:
//   1. Initialize string builder buffers with default or specified capacity hints.
//   2. Append string segments, characters, numbers, and newline-terminated lines.
//   3. Extract accumulated string, query length, and reset buffer state.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type StringBuilder = struct {
    buffer: String,
    length: Int,
    chunk_count: Int
};

pub fn sb_new() -> StringBuilder {
    return StringBuilder {
        buffer: "",
        length: 0,
        chunk_count: 0
    };
}

pub fn sb_with_capacity(initial_cap: Int) -> StringBuilder {
    return StringBuilder {
        buffer: "",
        length: 0,
        chunk_count: 0
    };
}

pub fn sb_append(sb: StringBuilder, s: String) -> StringBuilder {
    let slen: Int = chars_len(s);
    if slen == 0 {
        return sb;
    }
    let buf: String = sb.buffer;
    let n: Int = sb.length;
    let c: Int = sb.chunk_count;
    return StringBuilder {
        buffer: buf + s,
        length: n + slen,
        chunk_count: c + 1
    };
}

pub fn sb_append_char(sb: StringBuilder, ch: String) -> StringBuilder {
    return sb_append(sb, ch);
}

pub fn sb_append_int(mut sb: StringBuilder, val: Int) -> StringBuilder {
    let s: String = val.to_string();
    return sb_append(sb, s);
}

pub fn sb_append_line(sb: StringBuilder, line: String) -> StringBuilder {
    let s1: StringBuilder = sb_append(sb, line);
    return sb_append_char(s1, "\n");
}

pub fn sb_append_repeat(sb: StringBuilder, s: String, count: Int) -> StringBuilder {
    let mut cur: StringBuilder = sb;
    let mut i: Int = 0;
    while i < count {
        cur = sb_append(cur, s);
        i = i + 1;
    }
    return cur;
}

pub fn sb_to_string(sb: StringBuilder) -> String {
    return sb.buffer;
}

pub fn sb_len(sb: StringBuilder) -> Int {
    return sb.length;
}

pub fn sb_is_empty(sb: StringBuilder) -> Bool {
    return sb.length == 0;
}

pub fn sb_clear(sb: StringBuilder) -> StringBuilder {
    return sb_new();
}
