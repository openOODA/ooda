// # Regular Expression Parser Module
//
// Logline: Lexical scanning, token validation, character class detection, and AST serialization for regular expressions.
//
// Setup: Pure parser transforming raw regex strings into structured token sequences and syntax trees.
//
// Beats:
//   1. Scan and escape regex meta-characters and literals.
//   2. Parse character classes, quantifiers, and alternation operators.
//   3. Validate syntax correctness and emit structured token lists.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/text/regex_types.oo";

pub fn regex_is_meta_char(c: String) -> Bool {
    if c == "^" || c == "$" || c == "*" || c == "+" || c == "?" { return true; }
    if c == "|" || c == "(" || c == ")" || c == "[" || c == "]" { return true; }
    if c == "{" || c == "}" || c == "\\" || c == "." { return true; }
    return false;
}

pub fn regex_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if regex_is_meta_char(c) {
            out = out + "\\" + c;
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn regex_char_class_match(c: String, class_name: String) -> Bool {
    if class_name == "." {
        return c != "\n";
    }
    if class_name == "\\d" {
        return char_is_digit(c);
    }
    if class_name == "\\D" {
        return !char_is_digit(c);
    }
    if class_name == "\\s" {
        return char_is_space(c);
    }
    if class_name == "\\S" {
        return !char_is_space(c);
    }
    if class_name == "\\w" {
        return char_is_alpha(c) || char_is_digit(c) || c == "_";
    }
    if class_name == "\\W" {
        return !(char_is_alpha(c) || char_is_digit(c) || c == "_");
    }
    return c == class_name;
}

pub fn regex_validate_syntax(pattern: String) -> Result[Bool, String] {
    let n: Int = chars_len(pattern);
    let mut paren_depth: Int = 0;
    let mut bracket_open: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(pattern, i);
        if c == "\\" {
            i = i + 1;
            if i >= n {
                return Err("REGEX_ERR: trailing backslash escape");
            }
        } else if c == "(" && !bracket_open {
            paren_depth = paren_depth + 1;
        } else if c == ")" && !bracket_open {
            paren_depth = paren_depth - 1;
            if paren_depth < 0 {
                return Err("REGEX_ERR: unmatched closing parenthesis");
            }
        } else if c == "[" && !bracket_open {
            bracket_open = true;
        } else if c == "]" && bracket_open {
            bracket_open = false;
        }
        i = i + 1;
    }
    if paren_depth != 0 {
        return Err("REGEX_ERR: unclosed parenthesis");
    }
    if bracket_open {
        return Err("REGEX_ERR: unclosed character class bracket");
    }
    return Ok(true);
}

pub fn regex_parse_tokens(pattern: String) -> List[String] {
    let mut tokens: List[String] = list_new();
    let n: Int = chars_len(pattern);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(pattern, i);
        if c == "\\" {
            if i + 1 < n {
                let next_c: String = char_at(pattern, i + 1);
                tokens = list_push(tokens, "ESC:\\" + next_c);
                i = i + 2;
            } else {
                tokens = list_push(tokens, "LIT:\\");
                i = i + 1;
            }
        } else if c == "." {
            tokens = list_push(tokens, "DOT:.");
            i = i + 1;
        } else if c == "*" {
            tokens = list_push(tokens, "STAR:*");
            i = i + 1;
        } else if c == "+" {
            tokens = list_push(tokens, "PLUS:+");
            i = i + 1;
        } else if c == "?" {
            tokens = list_push(tokens, "QUEST:?");
            i = i + 1;
        } else if c == "|" {
            tokens = list_push(tokens, "ALT:|");
            i = i + 1;
        } else if c == "^" {
            tokens = list_push(tokens, "START:^");
            i = i + 1;
        } else if c == "$" {
            tokens = list_push(tokens, "END:$");
            i = i + 1;
        } else {
            tokens = list_push(tokens, "LIT:" + c);
            i = i + 1;
        }
    }
    return tokens;
}
