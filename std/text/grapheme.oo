// # Grapheme Cluster Segmentation Module
//
// Logline: User-perceived character cluster boundaries, combining mark grouping, and grapheme slicing.
//
// Setup: Segments text into extended grapheme clusters according to Unicode boundary rules.
//
// Beats:
//   1. Identify grapheme cluster break opportunities between characters.
//   2. Group base characters with trailing combining marks, joiners, and modifier sequences.
//   3. Count, index, and slice strings by grapheme clusters.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type GraphemeCluster = struct {
    text: String,
    start_idx: Int,
    byte_len: Int
};

pub fn grapheme_cluster_new(text: String, start_idx: Int, byte_len: Int) -> GraphemeCluster {
    return GraphemeCluster {
        text: text,
        start_idx: start_idx,
        byte_len: byte_len
    };
}

pub fn grapheme_is_joiner(c: String) -> Bool {
    return c == "\u200D" || c == "\u200C";
}

pub fn grapheme_is_combining_mark(c: String) -> Bool {
    let o: Int = ord(c);
    if o >= 768 && o <= 879 {
        return true;
    }
    if o >= 6832 && o <= 6911 {
        return true;
    }
    if o >= 7616 && o <= 7679 {
        return true;
    }
    if o >= 8400 && o <= 8447 {
        return true;
    }
    if o >= 65056 && o <= 65071 {
        return true;
    }
    return false;
}

pub fn grapheme_count(s: String) -> Int {
    let n: Int = chars_len(s);
    if n == 0 {
        return 0;
    }
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\r" && i + 1 < n && char_at(s, i + 1) == "\n" {
            count = count + 1;
            i = i + 2;
        } else {
            count = count + 1;
            i = i + 1;
            while i < n {
                let next_c: String = char_at(s, i);
                if grapheme_is_combining_mark(next_c) || grapheme_is_joiner(next_c) {
                    i = i + 1;
                } else {
                    break;
                }
            }
        }
    }
    return count;
}

pub fn grapheme_at(s: String, cluster_index: Int) -> String {
    let n: Int = chars_len(s);
    if cluster_index < 0 || n == 0 {
        return "";
    }
    let mut curr_cluster: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let start_pos: Int = i;
        let c: String = char_at(s, i);
        if c == "\r" && i + 1 < n && char_at(s, i + 1) == "\n" {
            i = i + 2;
        } else {
            i = i + 1;
            while i < n {
                let next_c: String = char_at(s, i);
                if grapheme_is_combining_mark(next_c) || grapheme_is_joiner(next_c) {
                    i = i + 1;
                } else {
                    break;
                }
            }
        }
        if curr_cluster == cluster_index {
            return str_slice(s, start_pos, i);
        }
        curr_cluster = curr_cluster + 1;
    }
    return "";
}

pub fn grapheme_slice(s: String, start_cluster: Int, end_cluster: Int) -> String {
    let n: Int = chars_len(s);
    if start_cluster >= end_cluster || n == 0 {
        return "";
    }
    let mut out: String = "";
    let mut curr_cluster: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let start_pos: Int = i;
        let c: String = char_at(s, i);
        if c == "\r" && i + 1 < n && char_at(s, i + 1) == "\n" {
            i = i + 2;
        } else {
            i = i + 1;
            while i < n {
                let next_c: String = char_at(s, i);
                if grapheme_is_combining_mark(next_c) || grapheme_is_joiner(next_c) {
                    i = i + 1;
                } else {
                    break;
                }
            }
        }
        if curr_cluster >= start_cluster && curr_cluster < end_cluster {
            out = out + str_slice(s, start_pos, i);
        }
        if curr_cluster >= end_cluster {
            break;
        }
        curr_cluster = curr_cluster + 1;
    }
    return out;
}
