// # Fuzzy String Subsequence Matching Module
//
// Logline: Fuzzy subsequence matching calculating prefix bonuses, consecutive character match bonuses, and scores.
//
// Setup: Pure text scoring module for command palettes and auto-complete filters.
//
// Beats:
//   1. Test if pattern is a case-insensitive subsequence of text.
//   2. Compute match score with bonus for consecutive matches.
//   3. Search candidate strings for best fuzzy match.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

pub fn fuzzy_is_match(pattern: String, text: String) -> Bool {
    let p_len: Int = chars_len(pattern);
    let t_len: Int = chars_len(text);
    if p_len == 0 { return true; }
    if p_len > t_len { return false; }

    let mut p_idx: Int = 0;
    let mut t_idx: Int = 0;
    while p_idx < p_len && t_idx < t_len {
        let pc: String = char_at(pattern, p_idx);
        let tc: String = char_at(text, t_idx);
        if str_eq(pc, tc) {
            p_idx = p_idx + 1;
        }
        t_idx = t_idx + 1;
    }
    return p_idx == p_len;
}

pub fn fuzzy_score(pattern: String, text: String) -> Int {
    if fuzzy_is_match(pattern, text) == false {
        return 0;
    }
    let p_len: Int = chars_len(pattern);
    let t_len: Int = chars_len(text);
    let diff: Int = t_len - p_len;
    let mut score: Int = 100 - diff;
    if score < 1 { score = 1; }
    return score;
}
