// # Levenshtein and Edit Distance Module
//
// Logline: Levenshtein distance, Damerau transposition distance, fuzzy match ratios, and threshold tests.
//
// Setup: Pure string metric module computing minimal edit distances between character sequences.
//
// Beats:
//   1. Compute classic Levenshtein insertion/deletion/substitution edit distance.
//   2. Compute Damerau-Levenshtein distance with adjacent transposition penalties.
//   3. Compute normalized similarity percentages and bounded distance threshold checks.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type LevenshteinResult = struct {
    distance: Int,
    similarity_score: Int,
    is_exact: Bool
};

fn int_min(a: Int, b: Int) -> Int {
    if a < b { return a; }
    return b;
}

fn int_min3(a: Int, b: Int, c: Int) -> Int {
    return int_min(int_min(a, b), c);
}

pub fn levenshtein_distance(s1: String, s2: String) -> Int {
    let len1: Int = chars_len(s1);
    let len2: Int = chars_len(s2);

    if len1 == 0 { return len2; }
    if len2 == 0 { return len1; }
    if s1 == s2 { return 0; }

    let mut prev: List[Int] = list_new();
    let mut i: Int = 0;
    while i <= len2 {
        prev = list_push(prev, i);
        i = i + 1;
    }

    let mut r: Int = 1;
    while r <= len1 {
        let mut curr: List[Int] = list_new();
        curr = list_push(curr, r);
        let c1: String = char_at(s1, r - 1);
        let mut c: Int = 1;
        while c <= len2 {
            let c2: String = char_at(s2, c - 1);
            let mut cost: Int = 1;
            if c1 == c2 {
                cost = 0;
            }
            let del_cost: Int = list_get(prev, c) + 1;
            let ins_cost: Int = list_get(curr, c - 1) + 1;
            let sub_cost: Int = list_get(prev, c - 1) + cost;
            let min_val: Int = int_min3(del_cost, ins_cost, sub_cost);
            curr = list_push(curr, min_val);
            c = c + 1;
        }
        prev = curr;
        r = r + 1;
    }

    return list_get(prev, len2);
}

pub fn damerau_levenshtein_distance(s1: String, s2: String) -> Int {
    let len1: Int = chars_len(s1);
    let len2: Int = chars_len(s2);

    if len1 == 0 { return len2; }
    if len2 == 0 { return len1; }
    if s1 == s2 { return 0; }

    let dist: Int = levenshtein_distance(s1, s2);
    if len1 == len2 && len1 >= 2 {
        let mut diff_count: Int = 0;
        let mut idx1: Int = -1;
        let mut idx2: Int = -1;
        let mut k: Int = 0;
        while k < len1 {
            if char_at(s1, k) != char_at(s2, k) {
                diff_count = diff_count + 1;
                if idx1 == -1 {
                    idx1 = k;
                } else if idx2 == -1 {
                    idx2 = k;
                }
            }
            k = k + 1;
        }
        if diff_count == 2 && idx2 == idx1 + 1 {
            if char_at(s1, idx1) == char_at(s2, idx2) && char_at(s1, idx2) == char_at(s2, idx1) {
                return 1;
            }
        }
    }
    return dist;
}

pub fn levenshtein_similarity(s1: String, s2: String) -> Int {
    let len1: Int = chars_len(s1);
    let len2: Int = chars_len(s2);
    let mut max_len: Int = len1;
    if len2 > max_len {
        max_len = len2;
    }
    if max_len == 0 {
        return 100;
    }
    let dist: Int = levenshtein_distance(s1, s2);
    let score: Int = ((max_len - dist) * 100) / max_len;
    if score < 0 {
        return 0;
    }
    return score;
}

pub fn levenshtein_is_within(s1: String, s2: String, max_dist: Int) -> Bool {
    let dist: Int = levenshtein_distance(s1, s2);
    return dist <= max_dist;
}

pub fn levenshtein_compute(s1: String, s2: String) -> LevenshteinResult {
    let dist: Int = levenshtein_distance(s1, s2);
    let sim: Int = levenshtein_similarity(s1, s2);
    return LevenshteinResult {
        distance: dist,
        similarity_score: sim,
        is_exact: dist == 0
    };
}
