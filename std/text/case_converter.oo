// # String Case Converter Module
//
// Logline: Identifier casing conversions: snake_case, camelCase, PascalCase, kebab-case, screaming_snake_case, and Title Case.
//
// Setup: Pure string manipulation module converting identifiers across naming conventions.
//
// Beats:
//   1. Character-level ASCII case conversion helpers (char_to_lower / char_to_upper).
//   2. Conversion to snake_case and kebab-case.
//   3. Conversion to camelCase and PascalCase.
//   4. Conversion to screaming SNAKE_CASE and Title Case.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Non-ASCII UTF-8 case folding lowers via unicode normalization module.

pub fn char_to_lower(c: String) -> String {
    let o: Int = ord(c);
    if o >= 65 && o <= 90 {
        let lo: Int = o + 32;
        if lo == 97 { return "a"; }
        if lo == 98 { return "b"; }
        if lo == 99 { return "c"; }
        if lo == 100 { return "d"; }
        if lo == 101 { return "e"; }
        if lo == 102 { return "f"; }
        if lo == 103 { return "g"; }
        if lo == 104 { return "h"; }
        if lo == 105 { return "i"; }
        if lo == 106 { return "j"; }
        if lo == 107 { return "k"; }
        if lo == 108 { return "l"; }
        if lo == 109 { return "m"; }
        if lo == 110 { return "n"; }
        if lo == 111 { return "o"; }
        if lo == 112 { return "p"; }
        if lo == 113 { return "q"; }
        if lo == 114 { return "r"; }
        if lo == 115 { return "s"; }
        if lo == 116 { return "t"; }
        if lo == 117 { return "u"; }
        if lo == 118 { return "v"; }
        if lo == 119 { return "w"; }
        if lo == 120 { return "x"; }
        if lo == 121 { return "y"; }
        return "z";
    }
    return c;
}

pub fn char_to_upper(c: String) -> String {
    let o: Int = ord(c);
    if o >= 97 && o <= 122 {
        let up: Int = o - 32;
        if up == 65 { return "A"; }
        if up == 66 { return "B"; }
        if up == 67 { return "C"; }
        if up == 68 { return "D"; }
        if up == 69 { return "E"; }
        if up == 70 { return "F"; }
        if up == 71 { return "G"; }
        if up == 72 { return "H"; }
        if up == 73 { return "I"; }
        if up == 74 { return "J"; }
        if up == 75 { return "K"; }
        if up == 76 { return "L"; }
        if up == 77 { return "M"; }
        if up == 78 { return "N"; }
        if up == 79 { return "O"; }
        if up == 80 { return "P"; }
        if up == 81 { return "Q"; }
        if up == 82 { return "R"; }
        if up == 83 { return "S"; }
        if up == 84 { return "T"; }
        if up == 85 { return "U"; }
        if up == 86 { return "V"; }
        if up == 87 { return "W"; }
        if up == 88 { return "X"; }
        if up == 89 { return "Y"; }
        return "Z";
    }
    return c;
}

fn is_upper(c: String) -> Bool {
    let o: Int = ord(c);
    return o >= 65 && o <= 90;
}

fn is_lower(c: String) -> Bool {
    let o: Int = ord(c);
    return o >= 97 && o <= 122;
}

fn is_delim(c: String) -> Bool {
    return c == "_" || c == "-" || c == " " || c == ".";
}

pub fn to_snake_case(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if is_delim(c) {
            if chars_len(out) > 0 && ends_with_char(out, "_") == false {
                out = out + "_";
            }
        } else if is_upper(c) {
            if i > 0 && ends_with_char(out, "_") == false {
                out = out + "_";
            }
            out = out + char_to_lower(c);
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

fn ends_with_char(s: String, ch: String) -> Bool {
    let n: Int = chars_len(s);
    if n == 0 { return false; }
    return char_at(s, n - 1) == ch;
}

pub fn to_kebab_case(s: String) -> String {
    let snake: String = to_snake_case(s);
    let n: Int = chars_len(snake);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(snake, i);
        if c == "_" {
            out = out + "-";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn to_screaming_snake_case(s: String) -> String {
    let snake: String = to_snake_case(s);
    let n: Int = chars_len(snake);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(snake, i);
        out = out + char_to_upper(c);
        i = i + 1;
    }
    return out;
}

pub fn to_pascal_case(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut cap_next: Bool = true;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if is_delim(c) {
            cap_next = true;
        } else {
            if cap_next {
                out = out + char_to_upper(c);
                cap_next = false;
            } else {
                out = out + char_to_lower(c);
            }
        }
        i = i + 1;
    }
    return out;
}

pub fn to_camel_case(s: String) -> String {
    let pascal: String = to_pascal_case(s);
    let n: Int = chars_len(pascal);
    if n == 0 { return ""; }
    let first: String = char_to_lower(char_at(pascal, 0));
    let rest: String = str_slice(pascal, 1, n);
    return first + rest;
}

pub fn to_title_case(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut cap_next: Bool = true;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "_" || c == "-" {
            out = out + " ";
            cap_next = true;
        } else {
            if cap_next {
                out = out + char_to_upper(c);
                cap_next = false;
            } else {
                out = out + char_to_lower(c);
            }
        }
        i = i + 1;
    }
    return out;
}
