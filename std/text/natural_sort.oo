// # Natural Order String Sorting and Comparison Module
//
// Logline: Human-friendly natural sorting comparator evaluating numeric runs numerically ("item2" < "item10").
//
// Setup: Pure string manipulation module comparing alphanumeric strings with embedded integer sequences.
//
// Beats:
//   1. Parse alternating text and numeric token spans from strings.
//   2. Compare strings in natural order (natural_cmp) returning -1, 0, or 1.
//   3. Insertion sort a list of strings in natural order (natural_sort_list).
//   4. Fallback lexicographical comparison for tie breaking.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Multi-locale collation rules lower via Unicode collation engine.

fn is_digit_char(c: String) -> Bool {
    let o: Int = ord(c);
    return o >= 48 && o <= 57;
}

pub fn natural_cmp(a: String, b: String) -> Int {
    let na: Int = chars_len(a);
    let nb: Int = chars_len(b);
    let mut ia: Int = 0;
    let mut ib: Int = 0;

    while ia < na && ib < nb {
        let ca: String = char_at(a, ia);
        let cb: String = char_at(b, ib);

        if is_digit_char(ca) && is_digit_char(cb) {
            // Parse full integer spans
            let mut num_a: Int = 0;
            while ia < na && is_digit_char(char_at(a, ia)) {
                let d: Int = ord(char_at(a, ia)) - 48;
                num_a = num_a * 10 + d;
                ia = ia + 1;
            }

            let mut num_b: Int = 0;
            while ib < nb && is_digit_char(char_at(b, ib)) {
                let d: Int = ord(char_at(b, ib)) - 48;
                num_b = num_b * 10 + d;
                ib = ib + 1;
            }

            if num_a < num_b {
                return -1;
            }
            if num_a > num_b {
                return 1;
            }
        } else {
            let oa: Int = ord(ca);
            let ob: Int = ord(cb);
            if oa < ob {
                return -1;
            }
            if oa > ob {
                return 1;
            }
            ia = ia + 1;
            ib = ib + 1;
        }
    }

    if ia < na {
        return 1;
    }
    if ib < nb {
        return -1;
    }
    return 0;
}

pub fn natural_sort_list(xs: List[String]) -> List[String] {
    let n: Int = list_len(xs);
    let mut sorted: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        let item: String = list_get(xs, i);
        let mut next_sorted: List[String] = list_new();
        let cur_len: Int = list_len(sorted);
        let mut inserted: Bool = false;
        let mut j: Int = 0;
        while j < cur_len {
            let cur_item: String = list_get(sorted, j);
            let cmp: Int = natural_cmp(item, cur_item);
            if !inserted && cmp < 0 {
                next_sorted = list_push(next_sorted, item);
                next_sorted = list_push(next_sorted, cur_item);
                inserted = true;
            } else {
                next_sorted = list_push(next_sorted, cur_item);
            }
            j = j + 1;
        }
        if !inserted {
            next_sorted = list_push(next_sorted, item);
        }
        sorted = next_sorted;
        i = i + 1;
    }
    return sorted;
}
