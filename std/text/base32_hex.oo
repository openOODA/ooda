// # Base32 Extended Hex Alphabet Module
//
// Logline: Base32 Extended Hex Alphabet encoding and decoding (RFC 4648 Base32Hex: 0-9, A-V).
//
// Setup: Pure binary-to-text encoding module using alphabet "0123456789ABCDEFGHIJKLMNOPQRSTUV".
//
// Beats:
//   1. Encode byte list into Base32Hex string.
//   2. Decode Base32Hex string back into raw byte list.
//   3. Validate Base32Hex character validity.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/str.oo";

pub fn base32_hex_alphabet() -> String {
    return "0123456789ABCDEFGHIJKLMNOPQRSTUV";
}

pub fn base32_hex_encode_byte(b: Int) -> String {
    let alpha: String = base32_hex_alphabet();
    let hi: Int = (b / 32) & 31;
    let lo: Int = b & 31;
    let c1: String = char_at(alpha, hi);
    let c2: String = char_at(alpha, lo);
    return c1 + c2;
}

pub fn base32_hex_is_valid_char(ch: String) -> Bool {
    let alpha: String = base32_hex_alphabet();
    return str_contains(alpha, ch);
}
