// # Text and Code Indentation Formatter Module
//
// Logline: Structured source code indentation formatting, tab expansion, multi-level block nesting, and unindenting.
//
// Setup: Pure string manipulation module for code emission and text alignment.
//
// Beats:
//   1. Construct IndentConfig with configurable tab width or space indentation.
//   2. Indent individual lines and multiline text blocks (indent_text).
//   3. Unindent text blocks stripping leading whitespace prefixes (unindent_text).
//   4. Expand literal tab characters to equivalent space columns.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: AST-aware syntax tree pretty-printers lower via language formatting parser.

type IndentConfig = struct {
    indent_size: Int,
    use_tabs: Bool
};

pub fn indent_config_default() -> IndentConfig {
    return IndentConfig {
        indent_size: 4,
        use_tabs: false
    };
}

pub fn indent_config_tabs() -> IndentConfig {
    return IndentConfig {
        indent_size: 1,
        use_tabs: true
    };
}

fn make_indent_prefix(level: Int, cfg: IndentConfig) -> String {
    if level <= 0 {
        return "";
    }
    let use_tabs: Bool = cfg.use_tabs;
    if use_tabs {
        let mut out: String = "";
        let mut i: Int = 0;
        while i < level {
            out = out + "\t";
            i = i + 1;
        }
        return out;
    }
    let sz: Int = cfg.indent_size;
    let total_spaces: Int = level * sz;
    let mut out: String = "";
    let mut i: Int = 0;
    while i < total_spaces {
        out = out + " ";
        i = i + 1;
    }
    return out;
}

pub fn indent_line(line: String, level: Int, cfg: IndentConfig) -> String {
    if chars_len(line) == 0 {
        return "";
    }
    let p: String = make_indent_prefix(level, cfg);
    return p + line;
}

pub fn expand_tabs(text: String, tab_width: Int) -> String {
    let mut tw: Int = tab_width;
    if tw <= 0 {
        tw = 4;
    }
    let mut space_tab: String = "";
    let mut k: Int = 0;
    while k < tw {
        space_tab = space_tab + " ";
        k = k + 1;
    }

    let n: Int = chars_len(text);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(text, i);
        if c == "\t" {
            out = out + space_tab;
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn indent_text(text: String, level: Int, cfg: IndentConfig) -> String {
    let p: String = make_indent_prefix(level, cfg);
    let n: Int = chars_len(text);
    let mut out: String = "";
    let mut at_line_start: Bool = true;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(text, i);
        if at_line_start && c != "\n" {
            out = out + p;
            at_line_start = false;
        }
        out = out + c;
        if c == "\n" {
            at_line_start = true;
        }
        i = i + 1;
    }
    return out;
}

pub fn unindent_text(text: String, level: Int, cfg: IndentConfig) -> String {
    let sz: Int = cfg.indent_size;
    let strip_count: Int = level * sz;
    let n: Int = chars_len(text);
    let mut out: String = "";
    let mut skipped: Int = 0;
    let mut at_line_start: Bool = true;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(text, i);
        if at_line_start {
            if (c == " " || c == "\t") && skipped < strip_count {
                skipped = skipped + 1;
            } else {
                at_line_start = false;
                out = out + c;
            }
        } else {
            out = out + c;
        }
        if c == "\n" {
            at_line_start = true;
            skipped = 0;
        }
        i = i + 1;
    }
    return out;
}
