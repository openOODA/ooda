// # Phonetic Soundex Encoding Module
//
// Logline: Classic Russell Soundex phonetic algorithm encoding English words into 4-character phonetic indices.
//
// Setup: Pure string metric module indexing phonetically similar names and fuzzy sound matches.
//
// Beats:
//   1. Map consonants to Soundex phonetic digit classes (1-6).
//   2. Retain first letter and collapse adjacent identical phonetic codes.
//   3. Strip vowels and zero-pad to exactly 4 characters (e.g. "Robert" -> "R163").
//   4. Evaluate phonetic equality predicate (soundex_matches).
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Census and Daitch-Mokotoff Soundex extensions lower via phonetic library.

fn char_to_upper_soundex(c: String) -> String {
    let o: Int = ord(c);
    if o >= 97 && o <= 122 {
        let up: Int = o - 32;
        if up == 65 { return "A"; }
        if up == 66 { return "B"; }
        if up == 67 { return "C"; }
        if up == 68 { return "D"; }
        if up == 69 { return "E"; }
        if up == 70 { return "F"; }
        if up == 71 { return "G"; }
        if up == 72 { return "H"; }
        if up == 73 { return "I"; }
        if up == 74 { return "J"; }
        if up == 75 { return "K"; }
        if up == 76 { return "L"; }
        if up == 77 { return "M"; }
        if up == 78 { return "N"; }
        if up == 79 { return "O"; }
        if up == 80 { return "P"; }
        if up == 81 { return "Q"; }
        if up == 82 { return "R"; }
        if up == 83 { return "S"; }
        if up == 84 { return "T"; }
        if up == 85 { return "U"; }
        if up == 86 { return "V"; }
        if up == 87 { return "W"; }
        if up == 88 { return "X"; }
        if up == 89 { return "Y"; }
        return "Z";
    }
    return c;
}

fn soundex_digit(c: String) -> String {
    let up: String = char_to_upper_soundex(c);
    if up == "B" || up == "F" || up == "P" || up == "V" { return "1"; }
    if up == "C" || up == "G" || up == "J" || up == "K" || up == "Q" || up == "S" || up == "X" || up == "Z" { return "2"; }
    if up == "D" || up == "T" { return "3"; }
    if up == "L" { return "4"; }
    if up == "M" || up == "N" { return "5"; }
    if up == "R" { return "6"; }
    return "0";
}

pub fn soundex_encode(name: String) -> String {
    let n: Int = chars_len(name);
    if n == 0 {
        return "0000";
    }

    let first_char: String = char_to_upper_soundex(char_at(name, 0));
    let mut out: String = first_char;
    let mut last_code: String = soundex_digit(first_char);

    let mut i: Int = 1;
    while i < n && chars_len(out) < 4 {
        let c: String = char_at(name, i);
        let code: String = soundex_digit(c);
        if code != "0" {
            if code != last_code {
                out = out + code;
                last_code = code;
            }
        } else {
            last_code = "0";
        }
        i = i + 1;
    }

    while chars_len(out) < 4 {
        out = out + "0";
    }

    return out;
}

pub fn soundex_matches(a: String, b: String) -> Bool {
    let sa: String = soundex_encode(a);
    let sb: String = soundex_encode(b);
    return sa == sb;
}
