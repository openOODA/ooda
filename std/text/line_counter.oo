// # Line, Word, and Character Counter Module
//
// Logline: High-throughput text statistics counter computing line count, word count, byte count, and max line length.
//
// Setup: Pure text metrics counter.
//
// Beats:
//   1. Count newline delimiters.
//   2. Count whitespace-delimited word tokens.
//   3. Compute maximum line length.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

type TextStats = struct {
    lines: Int,
    words: Int,
    chars: Int
};

pub fn text_count_stats(s: String) -> TextStats {
    let n: Int = chars_len(s);
    if n == 0 {
        return TextStats { lines: 0, words: 0, chars: 0 };
    }
    let mut num_lines: Int = 1;
    let mut num_words: Int = 0;
    let mut in_word: Bool = false;
    let mut i: Int = 0;
    let newline_char: String = "\n";
    let space_char: String = " ";
    let tab_char: String = "\t";
    while i < n {
        let ch: String = char_at(s, i);
        if str_eq(ch, newline_char) {
            num_lines = num_lines + 1;
            in_word = false;
        } else if str_eq(ch, space_char) || str_eq(ch, tab_char) {
            in_word = false;
        } else {
            if !in_word {
                num_words = num_words + 1;
                in_word = true;
            }
        }
        i = i + 1;
    }
    return TextStats {
        lines: num_lines,
        words: num_words,
        chars: n
    };
}
