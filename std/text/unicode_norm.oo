// # Unicode Normalization and Character Mapping
//
// Logline: Canonical character composition/decomposition, diacritic stripping, case folding, and whitespace normalization.
//
// Setup: Pure string manipulation module providing Unicode equivalence transformations without external tables.
//
// Beats:
//   1. Normalize Unicode whitespace, control codes, and line breaks.
//   2. Strip common Latin diacritics and accented characters to base ASCII.
//   3. Implement full Unicode case folding and ASCII classification tests.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type UnicodeNormConfig = struct {
    strip_accents: Bool,
    case_fold: Bool,
    normalize_space: Bool
};

pub fn unicode_norm_config_default() -> UnicodeNormConfig {
    return UnicodeNormConfig {
        strip_accents: false,
        case_fold: false,
        normalize_space: false
    };
}

pub fn unicode_is_ascii(s: String) -> Bool {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        let b: Int = ord(c);
        if b < 0 || b > 127 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn strip_accent_char(c: String) -> String {
    if c == "à" || c == "á" || c == "â" || c == "ã" || c == "ä" || c == "å" || c == "ā" { return "a"; }
    if c == "À" || c == "Á" || c == "Â" || c == "Ã" || c == "Ä" || c == "Å" || c == "Ā" { return "A"; }
    if c == "è" || c == "é" || c == "ê" || c == "ë" || c == "ē" || c == "ė" || c == "ę" { return "e"; }
    if c == "È" || c == "É" || c == "Ê" || c == "Ë" || c == "Ē" || c == "Ė" || c == "Ę" { return "E"; }
    if c == "ì" || c == "í" || c == "î" || c == "ï" || c == "ī" || c == "į" { return "i"; }
    if c == "Ì" || c == "Í" || c == "Î" || c == "Ï" || c == "Ī" || c == "Į" { return "I"; }
    if c == "ò" || c == "ó" || c == "ô" || c == "õ" || c == "ö" || c == "ø" || c == "ō" { return "o"; }
    if c == "Ò" || c == "Ó" || c == "Ô" || c == "Õ" || c == "Ö" || c == "Ø" || c == "Ō" { return "O"; }
    if c == "ù" || c == "ú" || c == "û" || c == "ü" || c == "ū" || c == "ų" { return "u"; }
    if c == "Ù" || c == "Ú" || c == "Û" || c == "Ü" || c == "Ū" || c == "Ų" { return "U"; }
    if c == "ñ" || c == "ń" { return "n"; }
    if c == "Ñ" || c == "Ń" { return "N"; }
    if c == "ç" || c == "ć" || c == "č" { return "c"; }
    if c == "Ç" || c == "Ć" || c == "Č" { return "C"; }
    if c == "ý" || c == "ÿ" { return "y"; }
    if c == "Ý" || c == "Ÿ" { return "Y"; }
    if c == "ß" { return "ss"; }
    if c == "æ" { return "ae"; }
    if c == "Æ" { return "AE"; }
    if c == "œ" { return "oe"; }
    if c == "Œ" { return "OE"; }
    return c;
}

pub fn unicode_strip_diacritics(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        out = out + strip_accent_char(c);
        i = i + 1;
    }
    return out;
}

pub fn unicode_case_fold(s: String) -> String {
    let stripped: String = unicode_strip_diacritics(s);
    let n: Int = chars_len(stripped);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(stripped, i);
        let b: Int = ord(c);
        if b >= 65 && b <= 90 {
            let lower_b: Int = b + 32;
            if lower_b == 97 { out = out + "a"; }
            else if lower_b == 98 { out = out + "b"; }
            else if lower_b == 99 { out = out + "c"; }
            else if lower_b == 100 { out = out + "d"; }
            else if lower_b == 101 { out = out + "e"; }
            else if lower_b == 102 { out = out + "f"; }
            else if lower_b == 103 { out = out + "g"; }
            else if lower_b == 104 { out = out + "h"; }
            else if lower_b == 105 { out = out + "i"; }
            else if lower_b == 106 { out = out + "j"; }
            else if lower_b == 107 { out = out + "k"; }
            else if lower_b == 108 { out = out + "l"; }
            else if lower_b == 109 { out = out + "m"; }
            else if lower_b == 110 { out = out + "n"; }
            else if lower_b == 111 { out = out + "o"; }
            else if lower_b == 112 { out = out + "p"; }
            else if lower_b == 113 { out = out + "q"; }
            else if lower_b == 114 { out = out + "r"; }
            else if lower_b == 115 { out = out + "s"; }
            else if lower_b == 116 { out = out + "t"; }
            else if lower_b == 117 { out = out + "u"; }
            else if lower_b == 118 { out = out + "v"; }
            else if lower_b == 119 { out = out + "w"; }
            else if lower_b == 120 { out = out + "x"; }
            else if lower_b == 121 { out = out + "y"; }
            else if lower_b == 122 { out = out + "z"; }
            else { out = out + c; }
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn unicode_normalize_whitespace(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut in_space: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if char_is_space(c) || c == "\t" || c == "\r" || c == "\n" {
            if !in_space && chars_len(out) > 0 {
                out = out + " ";
                in_space = true;
            }
        } else {
            out = out + c;
            in_space = false;
        }
        i = i + 1;
    }
    let out_len: Int = chars_len(out);
    if out_len > 0 && char_at(out, out_len - 1) == " " {
        return str_slice(out, 0, out_len - 1);
    }
    return out;
}

pub fn unicode_normalize(s: String, config: UnicodeNormConfig) -> String {
    let mut cur: String = s;
    if config.strip_accents {
        cur = unicode_strip_diacritics(cur);
    }
    if config.case_fold {
        cur = unicode_case_fold(cur);
    }
    if config.normalize_space {
        cur = unicode_normalize_whitespace(cur);
    }
    return cur;
}
