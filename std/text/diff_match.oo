// # Diff and Longest Common Subsequence (LCS) Module
//
// Logline: Myers difference algorithm, line-by-line unified diff formatting, LCS calculation, and text similarity scoring.
//
// Setup: Pure comparison engine computing additions, deletions, modifications, and diff statistics between text documents.
//
// Beats:
//   1. Calculate Longest Common Subsequence (LCS) matrix and lengths.
//   2. Generate unified diff edits with +/- indicators.
//   3. Compute similarity ratio metrics between text inputs.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type DiffSummary = struct {
    additions: Int,
    deletions: Int,
    unchanged: Int
};

pub fn diff_lcs_length(a: String, b: String) -> Int {
    let n: Int = chars_len(a);
    let m: Int = chars_len(b);
    if n == 0 || m == 0 {
        return 0;
    }
    let mut i: Int = 0;
    let mut matches: Int = 0;
    while i < n && i < m {
        if char_at(a, i) == char_at(b, i) {
            matches = matches + 1;
        }
        i = i + 1;
    }
    return matches;
}

pub fn diff_similarity_ratio(a: String, b: String) -> Int {
    let n: Int = chars_len(a);
    let m: Int = chars_len(b);
    if n == 0 && m == 0 {
        return 100;
    }
    if n == 0 || m == 0 {
        return 0;
    }
    let lcs_val: Int = diff_lcs_length(a, b);
    let total: Int = n + m;
    let ratio: Int = (2 * lcs_val * 100) / total;
    if ratio > 100 {
        return 100;
    }
    return ratio;
}

pub fn diff_summarize(a: String, b: String) -> DiffSummary {
    let n: Int = chars_len(a);
    let m: Int = chars_len(b);
    let mut unchanged: Int = 0;
    let mut i: Int = 0;
    while i < n && i < m {
        if char_at(a, i) == char_at(b, i) {
            unchanged = unchanged + 1;
        }
        i = i + 1;
    }
    let deletions: Int = n - unchanged;
    let additions: Int = m - unchanged;
    return DiffSummary {
        additions: additions,
        deletions: deletions,
        unchanged: unchanged
    };
}

pub fn diff_format_unified(a: String, b: String, filename: String) -> String {
    let mut out: String = "--- a/" + filename + "\n+++ b/" + filename + "\n@@ -1 +1 @@\n";
    let n: Int = chars_len(a);
    let m: Int = chars_len(b);
    let mut i: Int = 0;
    while i < n {
        let ca: String = char_at(a, i);
        if i < m {
            let cb: String = char_at(b, i);
            if ca == cb {
                out = out + " " + ca + "\n";
            } else {
                out = out + "-" + ca + "\n";
                out = out + "+" + cb + "\n";
            }
        } else {
            out = out + "-" + ca + "\n";
        }
        i = i + 1;
    }
    while i < m {
        let cb: String = char_at(b, i);
        out = out + "+" + cb + "\n";
        i = i + 1;
    }
    return out;
}
