// # Pattern-string regex matcher
//
// Logline: Recursive scan for literals, concatenation, *, +, ?, and | alternation.
//
// Setup: Walks the pattern string against text. Not a compiled Thompson state graph.
//
// Beats:
//   1. Keep NfaState/NfaGraph records for later graph work.
//   2. Match literals and *, +, ? on the pattern string.
//   3. Split on | and try each alternative.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type NfaState = struct {
    id: Int,
    match_type: String,
    match_val: String,
    out1: Int,
    out2: Int,
    is_terminal: Bool
};

type NfaGraph = struct {
    state_count: Int,
    start_id: Int,
    end_id: Int
};

pub fn nfa_state_new(id: Int, match_type: String, match_val: String, out1: Int, out2: Int, is_terminal: Bool) -> NfaState {
    return NfaState {
        id: id,
        match_type: match_type,
        match_val: match_val,
        out1: out1,
        out2: out2,
        is_terminal: is_terminal
    };
}

pub fn nfa_graph_new(start_id: Int, end_id: Int) -> NfaGraph {
    return NfaGraph {
        state_count: end_id + 1,
        start_id: start_id,
        end_id: end_id
    };
}

fn nfa_char_matches(pattern_char: String, text_char: String) -> Bool {
    if pattern_char == "." {
        return text_char != "\n";
    }
    if pattern_char == "\\d" {
        return char_is_digit(text_char);
    }
    if pattern_char == "\\w" {
        return char_is_alpha(text_char) || char_is_digit(text_char) || text_char == "_";
    }
    if pattern_char == "\\s" {
        return char_is_space(text_char);
    }
    return pattern_char == text_char;
}

fn nfa_match_here(pattern: String, p_idx: Int, text: String, t_idx: Int) -> Bool {
    let p_len: Int = chars_len(pattern);
    let t_len: Int = chars_len(text);

    if p_idx >= p_len {
        return true;
    }

    let p_curr: String = char_at(pattern, p_idx);
    let mut p_next: String = "";
    if p_idx + 1 < p_len {
        p_next = char_at(pattern, p_idx + 1);
    }

    if p_curr == "$" && p_idx + 1 == p_len {
        return t_idx >= t_len;
    }

    if p_next == "*" {
        let mut cur_t: Int = t_idx;
        while cur_t <= t_len {
            if nfa_match_here(pattern, p_idx + 2, text, cur_t) {
                return true;
            }
            if cur_t < t_len && nfa_char_matches(p_curr, char_at(text, cur_t)) {
                cur_t = cur_t + 1;
            } else {
                break;
            }
        }
        return false;
    }

    if p_next == "+" {
        if t_idx < t_len && nfa_char_matches(p_curr, char_at(text, t_idx)) {
            let mut cur_t: Int = t_idx + 1;
            while cur_t <= t_len {
                if nfa_match_here(pattern, p_idx + 2, text, cur_t) {
                    return true;
                }
                if cur_t < t_len && nfa_char_matches(p_curr, char_at(text, cur_t)) {
                    cur_t = cur_t + 1;
                } else {
                    break;
                }
            }
        }
        return false;
    }

    if p_next == "?" {
        if nfa_match_here(pattern, p_idx + 2, text, t_idx) {
            return true;
        }
        if t_idx < t_len && nfa_char_matches(p_curr, char_at(text, t_idx)) {
            return nfa_match_here(pattern, p_idx + 2, text, t_idx + 1);
        }
        return false;
    }

    if t_idx < t_len && nfa_char_matches(p_curr, char_at(text, t_idx)) {
        return nfa_match_here(pattern, p_idx + 1, text, t_idx + 1);
    }

    return false;
}

fn nfa_find_alt(pattern: String, from: Int) -> Int {
    let n: Int = chars_len(pattern);
    let mut i: Int = from;
    while i < n {
        if char_at(pattern, i) == "|" {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn nfa_simulate(pattern: String, text: String) -> Bool {
    let p_len: Int = chars_len(pattern);
    let t_len: Int = chars_len(text);

    if p_len == 0 {
        return true;
    }

    let bar: Int = nfa_find_alt(pattern, 0);
    if bar >= 0 {
        if nfa_simulate(str_slice(pattern, 0, bar), text) {
            return true;
        }
        return nfa_simulate(str_slice(pattern, bar + 1, p_len), text);
    }

    if char_at(pattern, 0) == "^" {
        return nfa_match_here(pattern, 1, text, 0);
    }

    let mut i: Int = 0;
    while i <= t_len {
        if nfa_match_here(pattern, 0, text, i) {
            return true;
        }
        i = i + 1;
    }

    return false;
}
