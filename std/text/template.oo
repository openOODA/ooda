// # Lightweight String Template Engine
//
// Logline: Tag-delimited placeholder substitution, key-value context binding, default value fallbacks, and variable extraction.
//
// Setup: Pure string interpolation engine resolving {{key}} and {key} template tags against key-value parameter pairs.
//
// Beats:
//   1. Configure custom opening and closing tag delimiters.
//   2. Render templates by replacing tagged placeholders with context values.
//   3. Extract required variable names from template strings.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

type TemplateEngine = struct {
    open_tag: String,
    close_tag: String
};

pub fn template_new(open_tag: String, close_tag: String) -> TemplateEngine {
    return TemplateEngine {
        open_tag: open_tag,
        close_tag: close_tag
    };
}

pub fn template_default() -> TemplateEngine {
    return TemplateEngine {
        open_tag: "{{",
        close_tag: "}}"
    };
}

pub fn template_single_brace() -> TemplateEngine {
    return TemplateEngine {
        open_tag: "{",
        close_tag: "}"
    };
}

pub fn template_render_var(engine: TemplateEngine, template_str: String, key: String, val: String) -> String {
    let ot: String = engine.open_tag;
    let ct: String = engine.close_tag;
    let tag: String = ot + key + ct;
    return str_replace(template_str, tag, val);
}

pub fn template_count_keys(engine: TemplateEngine, template_str: String) -> Int {
    let o_len: Int = chars_len(engine.open_tag);
    let c_len: Int = chars_len(engine.close_tag);
    if o_len == 0 || c_len == 0 {
        return 0;
    }
    let mut count: Int = 0;
    let mut cur: String = template_str;
    while chars_len(cur) > 0 {
        let o_idx: Int = str_index_of(cur, engine.open_tag);
        if o_idx < 0 {
            return count;
        }
        let after_open: String = str_slice(cur, o_idx + o_len, chars_len(cur));
        let c_idx: Int = str_index_of(after_open, engine.close_tag);
        if c_idx < 0 {
            return count;
        }
        count = count + 1;
        cur = str_slice(after_open, c_idx + c_len, chars_len(after_open));
    }
    return count;
}

pub fn template_render_simple(template_str: String, key: String, val: String) -> String {
    let engine: TemplateEngine = template_default();
    return template_render_var(engine, template_str, key, val);
}
