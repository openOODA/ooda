// # ROT-13 and Caesar Cipher Text Transformation Module
//
// Logline: ROT-13 and parameterized Caesar cipher rotating alphabetic characters modulo 26.
//
// Setup: Pure symmetric substitution cipher without external state.
//
// Beats:
//   1. Rotate lowercase ASCII character by shift N modulo 26.
//   2. Rotate uppercase ASCII character by shift N modulo 26.
//   3. Apply ROT-13 transformation (involution).
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

fn rot_char_with_alpha(ch: String, alpha: String, shift: Int) -> String {
    let idx: Int = str_index_of(alpha, ch);
    if idx < 0 { return ch; }
    let new_idx: Int = (idx + shift) % 26;
    return char_at(alpha, new_idx);
}

pub fn rot13_transform(s: String) -> String {
    let upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let lower: String = "abcdefghijklmnopqrstuvwxyz";
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        let u_idx: Int = str_index_of(upper, ch);
        let l_idx: Int = str_index_of(lower, ch);
        if u_idx >= 0 {
            out = out + char_at(upper, (u_idx + 13) % 26);
        } else if l_idx >= 0 {
            out = out + char_at(lower, (l_idx + 13) % 26);
        } else {
            out = out + ch;
        }
        i = i + 1;
    }
    return out;
}
