// # Variable Template Interpolation Engine Module
//
// Logline: Variable placeholder template substitution replacing ${key} or {{key}} with mapped string values.
//
// Setup: Pure text templating module.
//
// Beats:
//   1. Replace single variable placeholder in template.
//   2. Interpolate key-value pairs across template string.
//   3. Extract placeholder variable names from template.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

pub fn template_substitute(tpl: String, key: String, val: String) -> String {
    let placeholder: String = "${" + key + "}";
    return str_replace(tpl, placeholder, val);
}

pub fn template_substitute_mustache(tpl: String, key: String, val: String) -> String {
    let placeholder: String = "{{" + key + "}}";
    return str_replace(tpl, placeholder, val);
}

pub fn template_has_variable(tpl: String, key: String) -> Bool {
    let placeholder: String = "${" + key + "}";
    return str_contains(tpl, placeholder);
}
