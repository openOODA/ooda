// # RNA Nucleotide Sequence Operations
//
// Logline: Packed RNA A=0 C=1 G=2 U=3, DNA T/U share code 3, RC and tallies. Destubbed off pub type / String.
//
// Setup: 2-bit pack, low base first. Transcription is identity in this encoding.
//
// Beats:
//   1. Valid if seq_n>0 (bases 0..3).
//   2. Complement A<->U C<->G; reverse complement 3'-5'.
//   3. Tally A/C/G/U.

type RnaSequence = struct {
    id: Int,
    packed: Int,
    seq_n: Int,
    is_valid: Int
};

type RnaNucleotideCounts = struct {
    n_a: Int,
    n_c: Int,
    n_g: Int,
    n_u: Int,
    n_n: Int,
    total_n: Int
};

pub fn int_pow4(n: Int) -> Int {
    if n <= 0 {
        return 1;
    }
    return 4 * int_pow4(n - 1);
}

pub fn rna_base_at(packed: Int, idx: Int) -> Int {
    let div: Int = packed / int_pow4(idx);
    return div % 4;
}

pub fn rna_pack4(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16) + (b3 * 64);
}

pub fn rna_is_valid_nucleotide(b: Int) -> Int {
    if b < 0 {
        return 0;
    }
    if b > 3 {
        return 0;
    }
    return 1;
}

pub fn transcribe_dna_to_rna(packed: Int) -> Int {
    return packed;
}

pub fn reverse_transcribe_rna_to_dna(packed: Int) -> Int {
    return packed;
}

pub fn rna_complement_base(b: Int) -> Int {
    if b == 0 {
        return 3;
    }
    if b == 3 {
        return 0;
    }
    if b == 1 {
        return 2;
    }
    if b == 2 {
        return 1;
    }
    return 0;
}

pub fn rna_rc_scan(packed: Int, n: Int, i: Int, acc: Int) -> Int {
    if i >= n {
        return acc;
    }
    let src: Int = (n - 1) - i;
    let b: Int = rna_base_at(packed, src);
    let c: Int = rna_complement_base(b);
    return rna_rc_scan(packed, n, i + 1, acc + (c * int_pow4(i)));
}

pub fn rna_reverse_complement(packed: Int, n: Int) -> Int {
    if n == 0 {
        return 0;
    }
    return rna_rc_scan(packed, n, 0, 0);
}

pub fn rna_sequence_new(id: Int, packed: Int, seq_n: Int) -> RnaSequence {
    let valid: Int = if seq_n > 0 { 1 } else { 0 };
    return RnaSequence {
        id: id,
        packed: packed,
        seq_n: seq_n,
        is_valid: valid
    };
}

pub fn rna_sequence_n(s: RnaSequence) -> Int {
    return s.seq_n;
}

pub fn rna_sequence_valid(s: RnaSequence) -> Int {
    return s.is_valid;
}

pub fn rna_tally_empty() -> RnaNucleotideCounts {
    return RnaNucleotideCounts {
        n_a: 0,
        n_c: 0,
        n_g: 0,
        n_u: 0,
        n_n: 0,
        total_n: 0
    };
}

pub fn rna_tally_scan(packed: Int, n: Int, i: Int, acc: RnaNucleotideCounts) -> RnaNucleotideCounts {
    if i >= n {
        return acc;
    }
    let b: Int = rna_base_at(packed, i);
    let nxt: RnaNucleotideCounts = RnaNucleotideCounts {
        n_a: if b == 0 { acc.n_a + 1 } else { acc.n_a },
        n_c: if b == 1 { acc.n_c + 1 } else { acc.n_c },
        n_g: if b == 2 { acc.n_g + 1 } else { acc.n_g },
        n_u: if b == 3 { acc.n_u + 1 } else { acc.n_u },
        n_n: if b > 3 { acc.n_n + 1 } else { acc.n_n },
        total_n: acc.total_n + 1
    };
    return rna_tally_scan(packed, n, i + 1, nxt);
}

pub fn rna_count_nucleotides(packed: Int, n: Int) -> RnaNucleotideCounts {
    return rna_tally_scan(packed, n, 0, rna_tally_empty());
}

pub fn rna_counts_a(c: RnaNucleotideCounts) -> Int {
    return c.n_a;
}

pub fn rna_counts_u(c: RnaNucleotideCounts) -> Int {
    return c.n_u;
}
