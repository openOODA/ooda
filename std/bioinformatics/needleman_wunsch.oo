// # Needleman-Wunsch Global Pairwise Alignment
//
// Logline: Global score = match*id + mismatch*pen + gap*open on packed DNA. Destubbed off pub type / String.
//
// Setup: 2-bit packed bases A=0 C=1 G=2 T=3, first base in low bits.
//
// Beats:
//   1. Default +2 / -1 / open -2 / extend -1.
//   2. Walk min(n1,n2); leftover bases are gaps.
//   3. Identity percent over aligned columns.

type AlignmentParams = struct {
    match_score: Int,
    mismatch_penalty: Int,
    gap_open: Int,
    gap_extend: Int
};

type GlobalAlignmentResult = struct {
    score: Int,
    query_n: Int,
    ref_n: Int,
    aligned_n: Int,
    matches: Int,
    mismatches: Int,
    gaps: Int,
    identity_pct: Int
};

type PairWalk = struct {
    matches: Int,
    mismatches: Int
};

pub fn alignment_params_default() -> AlignmentParams {
    return AlignmentParams {
        match_score: 2,
        mismatch_penalty: 0 - 1,
        gap_open: 0 - 2,
        gap_extend: 0 - 1
    };
}

pub fn alignment_params_new(match_s: Int, mismatch_p: Int, gap_o: Int, gap_e: Int) -> AlignmentParams {
    return AlignmentParams {
        match_score: match_s,
        mismatch_penalty: mismatch_p,
        gap_open: gap_o,
        gap_extend: gap_e
    };
}

pub fn global_alignment_init(q_n: Int, r_n: Int) -> GlobalAlignmentResult {
    return GlobalAlignmentResult {
        score: 0,
        query_n: q_n,
        ref_n: r_n,
        aligned_n: 0,
        matches: 0,
        mismatches: 0,
        gaps: 0,
        identity_pct: 0
    };
}

pub fn int_pow4(n: Int) -> Int {
    if n <= 0 {
        return 1;
    }
    return 4 * int_pow4(n - 1);
}

pub fn dna_base_at(packed: Int, idx: Int) -> Int {
    let div: Int = packed / int_pow4(idx);
    return div % 4;
}

pub fn dna_pack4(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16) + (b3 * 64);
}

pub fn needleman_wunsch_score_base(b1: Int, b2: Int, params: AlignmentParams) -> Int {
    if b1 == b2 {
        return params.match_score;
    }
    return params.mismatch_penalty;
}

pub fn needleman_wunsch_matrix_dim(q_n: Int, r_n: Int) -> Int {
    return (q_n + 1) * (r_n + 1);
}

pub fn nw_walk(p1: Int, n1: Int, p2: Int, n2: Int, i: Int) -> PairWalk {
    let min_n: Int = if n1 < n2 { n1 } else { n2 };
    if i >= min_n {
        return PairWalk { matches: 0, mismatches: 0 };
    }
    let rest: PairWalk = nw_walk(p1, n1, p2, n2, i + 1);
    let b1: Int = dna_base_at(p1, i);
    let b2: Int = dna_base_at(p2, i);
    if b1 == b2 {
        return PairWalk { matches: rest.matches + 1, mismatches: rest.mismatches };
    }
    return PairWalk { matches: rest.matches, mismatches: rest.mismatches + 1 };
}

pub fn needleman_wunsch_score_pair(p1: Int, n1: Int, p2: Int, n2: Int, params: AlignmentParams) -> GlobalAlignmentResult {
    let min_n: Int = if n1 < n2 { n1 } else { n2 };
    let n_diff: Int = if n1 > n2 { n1 - n2 } else { n2 - n1 };
    let walk: PairWalk = nw_walk(p1, n1, p2, n2, 0);
    let matches: Int = walk.matches;
    let mismatches: Int = walk.mismatches;
    let gaps: Int = n_diff;
    let aligned_n: Int = matches + mismatches + gaps;
    let score: Int = (matches * params.match_score) + (mismatches * params.mismatch_penalty) + (gaps * params.gap_open);
    let id_pct: Int = if aligned_n > 0 { (matches * 100) / aligned_n } else { 0 };
    return GlobalAlignmentResult {
        score: score,
        query_n: n1,
        ref_n: n2,
        aligned_n: aligned_n,
        matches: matches,
        mismatches: mismatches,
        gaps: gaps,
        identity_pct: id_pct
    };
}

pub fn global_alignment_score(r: GlobalAlignmentResult) -> Int {
    return r.score;
}

pub fn global_alignment_identity(r: GlobalAlignmentResult) -> Int {
    return r.identity_pct;
}
