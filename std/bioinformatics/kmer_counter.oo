// # K-Mer Spectrum Analysis & Frequency Counting
//
// Logline: Oligonucleotide k-mer totals, 2-bit encodings, canonical RC, Jaccard/Mash. Destubbed off pub type / String / import.
//
// Setup: Packed 2-bit DNA A=0 C=1 G=2 T=3. No import.
//
// Beats:
//   1. Default k=21 when k<=0; table 1048576.
//   2. Window total = L-k+1; canonical = lex-min(fwd, RC).
//   3. Jaccard d% = 100 - shared*100/union; Mash ≈ (100-j%)*10.

type KmerConfig = struct {
    k_size: Int,
    is_canonical: Int,
    max_table_size: Int
};

type KmerSpectrumSummary = struct {
    k_size: Int,
    kmer_total: Int,
    distinct_estimate: Int,
    singleton_n: Int,
    max_depth: Int
};

pub fn int_pow4(n: Int) -> Int {
    if n <= 0 {
        return 1;
    }
    return 4 * int_pow4(n - 1);
}

pub fn dna_base_at(packed: Int, idx: Int) -> Int {
    let div: Int = packed / int_pow4(idx);
    return div % 4;
}

pub fn dna_pack4(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16) + (b3 * 64);
}

pub fn kmer_config_new(k: Int, canonical: Int) -> KmerConfig {
    let valid_k: Int = if k > 0 { k } else { 21 };
    return KmerConfig {
        k_size: valid_k,
        is_canonical: canonical,
        max_table_size: 1048576
    };
}

pub fn kmer_config_k(cfg: KmerConfig) -> Int {
    return cfg.k_size;
}

pub fn kmer_encode_2bit(base: Int) -> Int {
    if base < 0 {
        return 0;
    }
    if base > 3 {
        return 0;
    }
    return base;
}

pub fn kmer_count_total_possible(seq_n: Int, k_size: Int) -> Int {
    if seq_n < k_size {
        return 0;
    }
    return (seq_n - k_size) + 1;
}

pub fn kmer_rc_scan(packed: Int, k: Int, i: Int, acc: Int) -> Int {
    if i >= k {
        return acc;
    }
    let src: Int = (k - 1) - i;
    let b: Int = dna_base_at(packed, src);
    let c: Int = 3 - b;
    return kmer_rc_scan(packed, k, i + 1, acc + (c * int_pow4(i)));
}

pub fn kmer_reverse_complement(packed: Int, k: Int) -> Int {
    return kmer_rc_scan(packed, k, 0, 0);
}

pub fn kmer_canonical_scan(fwd: Int, rev: Int, i: Int, k: Int) -> Int {
    if i >= k {
        return fwd;
    }
    let c1: Int = dna_base_at(fwd, i);
    let c2: Int = dna_base_at(rev, i);
    if c1 < c2 {
        return fwd;
    }
    if c2 < c1 {
        return rev;
    }
    return kmer_canonical_scan(fwd, rev, i + 1, k);
}

pub fn kmer_get_canonical(packed: Int, k: Int) -> Int {
    let rev: Int = kmer_reverse_complement(packed, k);
    return kmer_canonical_scan(packed, rev, 0, k);
}

pub fn kmer_spectrum_summary_new(k: Int, total: Int, distinct: Int, singleton_n: Int) -> KmerSpectrumSummary {
    let depth: Int = if distinct > 0 { total / distinct } else { 0 };
    return KmerSpectrumSummary {
        k_size: k,
        kmer_total: total,
        distinct_estimate: distinct,
        singleton_n: singleton_n,
        max_depth: depth
    };
}

pub fn kmer_spectrum_depth(s: KmerSpectrumSummary) -> Int {
    return s.max_depth;
}

pub fn kmer_jaccard_distance_estimate_pct(shared_kmers: Int, total_union_kmers: Int) -> Int {
    if total_union_kmers <= 0 {
        return 100;
    }
    let similarity_pct: Int = (shared_kmers * 100) / total_union_kmers;
    return 100 - similarity_pct;
}

pub fn kmer_mash_distance_x1000(shared_kmers: Int, sketch_size: Int, k_size: Int) -> Int {
    if sketch_size <= 0 {
        return 1000;
    }
    if shared_kmers <= 0 {
        return 1000;
    }
    let j_pct: Int = (shared_kmers * 100) / sketch_size;
    if j_pct >= 100 {
        return 0;
    }
    return (100 - j_pct) * 10;
}
