// # FASTA Format Serializer and Sequence Formatter
//
// Logline: Formats and serializes nucleotide and peptide sequences into standardized FASTA records with line wrapping.
//
// Setup: Sequence output formatting engine importing fasta_reader.oo.
//
// Beats:
//   1. Configure FASTA serializer options including line wrap width and uppercase normalization.
//   2. Wrap nucleotide and protein sequence strings across multi-line blocks.
//   3. Emit standard single and multi-entry FASTA formatted text payloads.

import "./fasta_reader.oo";

// -------------------------------------------------------------------
// FASTA Writer Data Structures
// -------------------------------------------------------------------

pub type FastaWriterConfig = struct {
    line_wrap_width: Int,
    uppercase_only: Bool,
    include_description: Bool,
};

pub type FastaWriter = struct {
    config: FastaWriterConfig,
    records_written: Int,
    bytes_written: Int,
};

// -------------------------------------------------------------------
// Writer Configuration & Construction
// -------------------------------------------------------------------

pub fn fasta_writer_config_default() -> FastaWriterConfig {
    return FastaWriterConfig {
        line_wrap_width: 60,
        uppercase_only: false,
        include_description: true,
    };
}

pub fn fasta_writer_config_new(wrap: Int, upper: Bool, inc_desc: Bool) -> FastaWriterConfig {
    let wrap_w = if wrap > 0 { wrap } else { 60 };
    return FastaWriterConfig {
        line_wrap_width: wrap_w,
        uppercase_only: upper,
        include_description: inc_desc,
    };
}

pub fn fasta_writer_new(config: FastaWriterConfig) -> FastaWriter {
    return FastaWriter {
        config: config,
        records_written: 0,
        bytes_written: 0,
    };
}

// -------------------------------------------------------------------
// Sequence Wrapping and Formatting
// -------------------------------------------------------------------

pub fn fasta_format_header(id: String, description: String, include_desc: Bool) -> String {
    if include_desc {
        let desc_len = chars_len(description);
        if desc_len > 0 {
            return ">" + id + " " + description + "\n";
        }
    }
    return ">" + id + "\n";
}

pub fn fasta_wrap_sequence(seq: String, wrap_width: Int) -> String {
    let n = chars_len(seq);
    if n == 0 {
        return "\n";
    }
    if wrap_width <= 0 || n <= wrap_width {
        return seq + "\n";
    }

    let mut result = "";
    let mut offset = 0;
    while offset < n {
        let end_idx = offset + wrap_width;
        let chunk_end = if end_idx > n { n } else { end_idx };
        let chunk = str_slice(seq, offset, chunk_end);
        result = result + chunk + "\n";
        offset = offset + wrap_width;
    }
    return result;
}

pub fn fasta_format_record(rec: &FastaRecord, config: &FastaWriterConfig) -> String {
    let header = fasta_format_header((rec).id, (rec).description, (config).include_description);
    let wrapped = fasta_wrap_sequence((rec).sequence, (config).line_wrap_width);
    return header + wrapped;
}

pub fn fasta_writer_emit(writer: &mut FastaWriter, rec: &FastaRecord) -> String {
    let out = fasta_format_record(rec, &((writer).config));
    (writer).records_written = (writer).records_written + 1;
    (writer).bytes_written = (writer).bytes_written + chars_len(out);
    return out;
}

pub fn fasta_writer_records_count(writer: &FastaWriter) -> Int {
    return (writer).records_written;
}

pub fn fasta_writer_total_bytes(writer: &FastaWriter) -> Int {
    return (writer).bytes_written;
}
