// # Plan7 Profile HMM States & Viterbi Step
//
// Logline: Match/Insert/Delete emissions and Viterbi recurrence. Destubbed off pub type / String.
//
// Setup: state_type 1=M 2=I 3=D. Silent delete emission 0. Insert→Delete = -9999.
//
// Beats:
//   1. Plan7 state constructors.
//   2. Viterbi cell = prev + trans + emit; -9999 if prev/trans <= -9000.
//   3. Significant if V>=25; E exp -10 / -4 / 1 by score band.

type HmmState = struct {
    state_type: Int,
    position: Int,
    emission_score: Int,
    transition_to_m: Int,
    transition_to_i: Int,
    transition_to_d: Int
};

type ProfileHmm = struct {
    model_id: Int,
    consensus_n: Int,
    alphabet_n: Int,
    is_calibrated: Int
};

type HmmAlignmentScore = struct {
    viterbi_score: Int,
    forward_score: Int,
    evalue_exponent: Int,
    is_significant: Int
};

pub fn hmm_match_state_init(pos: Int, emission: Int, to_m: Int, to_i: Int, to_d: Int) -> HmmState {
    return HmmState {
        state_type: 1,
        position: pos,
        emission_score: emission,
        transition_to_m: to_m,
        transition_to_i: to_i,
        transition_to_d: to_d
    };
}

pub fn hmm_insert_state_init(pos: Int, emission: Int, to_m: Int, to_i: Int) -> HmmState {
    return HmmState {
        state_type: 2,
        position: pos,
        emission_score: emission,
        transition_to_m: to_m,
        transition_to_i: to_i,
        transition_to_d: 0 - 9999
    };
}

pub fn hmm_delete_state_init(pos: Int, to_m: Int, to_d: Int) -> HmmState {
    return HmmState {
        state_type: 3,
        position: pos,
        emission_score: 0,
        transition_to_m: to_m,
        transition_to_i: 0 - 9999,
        transition_to_d: to_d
    };
}

pub fn profile_hmm_new(model_id: Int, consensus_n: Int) -> ProfileHmm {
    return ProfileHmm {
        model_id: model_id,
        consensus_n: consensus_n,
        alphabet_n: 20,
        is_calibrated: 1
    };
}

pub fn hmm_viterbi_step_score(prev_score: Int, trans_score: Int, emit_score: Int) -> Int {
    if prev_score <= (0 - 9000) {
        return 0 - 9999;
    }
    if trans_score <= (0 - 9000) {
        return 0 - 9999;
    }
    return prev_score + trans_score + emit_score;
}

pub fn hmm_alignment_score_new(v_score: Int, f_score: Int) -> HmmAlignmentScore {
    let is_sig: Int = if v_score >= 25 { 1 } else { 0 };
    let eval_exp: Int = if v_score >= 50 { 0 - 10 } else { if v_score >= 25 { 0 - 4 } else { 1 } };
    return HmmAlignmentScore {
        viterbi_score: v_score,
        forward_score: f_score,
        evalue_exponent: eval_exp,
        is_significant: is_sig
    };
}

pub fn hmm_state_type(s: HmmState) -> Int {
    return s.state_type;
}

pub fn hmm_alignment_viterbi(a: HmmAlignmentScore) -> Int {
    return a.viterbi_score;
}

pub fn profile_hmm_consensus_n(p: ProfileHmm) -> Int {
    return p.consensus_n;
}
