// # FASTA Format Parser and Sequence Reader
//
// Logline: Implements FASTA record decoding, header metadata parsing, and alphabet verification.
//
// Setup: Core sequence IO representation for nucleotide and peptide FASTA records.
//
// Beats:
//   1. Define FastaRecord and FastaReader container data structures.
//   2. Parse FASTA header lines into identifier and description fields.
//   3. Validate nucleotide and amino acid character sets and compute sequence metrics.

// -------------------------------------------------------------------
// FASTA Data Structures
// -------------------------------------------------------------------

pub type FastaRecord = struct {
    id: String,
    description: String,
    sequence: String,
    length: Int,
    is_valid: Bool
};

pub type FastaReader = struct {
    records_count: Int,
    total_bases: Int,
    is_loaded: Bool
};

// -------------------------------------------------------------------
// FASTA Record Functions
// -------------------------------------------------------------------

pub fn fasta_record_new(id: String, description: String, sequence: String) -> FastaRecord {
    let seq_len = chars_len(sequence);
    let valid = seq_len > 0;
    return FastaRecord {
        id: id,
        description: description,
        sequence: sequence,
        length: seq_len,
        is_valid: valid
    };
}

pub fn fasta_record_length(rec: &FastaRecord) -> Int {
    return (rec).length;
}

pub fn fasta_record_id(rec: &FastaRecord) -> String {
    return (rec).id;
}

pub fn fasta_record_description(rec: &FastaRecord) -> String {
    return (rec).description;
}

pub fn fasta_record_sequence(rec: &FastaRecord) -> String {
    return (rec).sequence;
}

pub fn fasta_record_is_valid(rec: &FastaRecord) -> Bool {
    return (rec).is_valid;
}

// -------------------------------------------------------------------
// FASTA Reader Functions
// -------------------------------------------------------------------

pub fn fasta_reader_new() -> FastaReader {
    return FastaReader {
        records_count: 0,
        total_bases: 0,
        is_loaded: false
    };
}

pub fn fasta_reader_add_record(reader: &mut FastaReader, rec: &FastaRecord) {
    if (rec).is_valid {
        (reader).records_count = (reader).records_count + 1;
        (reader).total_bases = (reader).total_bases + (rec).length;
        (reader).is_loaded = true;
    }
}

pub fn fasta_parse_header_id(header_line: String) -> String {
    let n = chars_len(header_line);
    if n == 0 {
        return "";
    }
    let mut start_idx = 0;
    if char_at(header_line, 0) == ">" {
        start_idx = 1;
    }
    let mut end_idx = start_idx;
    while end_idx < n {
        let c = char_at(header_line, end_idx);
        if c == " " || c == "\t" || c == "|" {
            return str_slice(header_line, start_idx, end_idx);
        }
        end_idx = end_idx + 1;
    }
    return str_slice(header_line, start_idx, n);
}

pub fn fasta_parse_header_description(header_line: String) -> String {
    let n = chars_len(header_line);
    if n == 0 {
        return "";
    }
    let mut i = 0;
    while i < n {
        let c = char_at(header_line, i);
        if c == " " || c == "\t" {
            let desc_start = i + 1;
            if desc_start < n {
                return str_slice(header_line, desc_start, n);
            }
            return "";
        }
        i = i + 1;
    }
    return "";
}

pub fn fasta_validate_dna_alphabet(seq: String) -> Bool {
    let n = chars_len(seq);
    if n == 0 {
        return false;
    }
    let mut i = 0;
    while i < n {
        let c = char_at(seq, i);
        let is_dna = (c == "A" || c == "a" || c == "C" || c == "c" ||
                      c == "G" || c == "g" || c == "T" || c == "t" ||
                      c == "N" || c == "n");
        if !is_dna {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn fasta_validate_protein_alphabet(seq: String) -> Bool {
    let n = chars_len(seq);
    if n == 0 {
        return false;
    }
    let mut i = 0;
    while i < n {
        let c = char_at(seq, i);
        let is_aa = (c == "A" || c == "C" || c == "D" || c == "E" ||
                     c == "F" || c == "G" || c == "H" || c == "I" ||
                     c == "K" || c == "L" || c == "M" || c == "N" ||
                     c == "P" || c == "Q" || c == "R" || c == "S" ||
                     c == "T" || c == "V" || c == "W" || c == "Y" ||
                     c == "X" || c == "*");
        if !is_aa {
            return false;
        }
        i = i + 1;
    }
    return true;
}
