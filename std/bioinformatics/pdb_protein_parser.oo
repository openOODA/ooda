// # PDB Macromolecular Structure & Chain Parser
//
// Logline: Organizes atomic coordinates into residues, polypeptide chains, and tertiary 3D protein structures.
//
// Setup: Macromolecular structural biology module importing pdb_atom_record.oo.
//
// Beats:
//   1. Define PdbResidue, PdbChain, and PdbStructure data structures.
//   2. Group atomic records into amino acid residues and polypeptide chains.
//   3. Compute structural center of mass and evaluate crystallographic resolution.

import "./pdb_atom_record.oo";

// -------------------------------------------------------------------
// PDB Structural Data Structures
// -------------------------------------------------------------------

pub type PdbResidue = struct {
    res_seq: Int,
    res_name: String,
    chain_id: String,
    atom_count: Int,
    ca_x: Int,
    ca_y: Int,
    ca_z: Int,
    has_alpha_carbon: Bool,
};

pub type PdbChain = struct {
    chain_id: String,
    residue_count: Int,
    atom_count: Int,
    is_protein: Bool,
};

pub type PdbStructure = struct {
    id: String,
    chain_count: Int,
    residue_count: Int,
    atom_count: Int,
    resolution_x100: Int, // e.g. 1.80 A -> 180
    experimental_method: String,
};

// -------------------------------------------------------------------
// Structural Constructors & Operations
// -------------------------------------------------------------------

pub fn pdb_residue_new(res_seq: Int, res_name: String, chain_id: String) -> PdbResidue {
    return PdbResidue {
        res_seq: res_seq,
        res_name: res_name,
        chain_id: chain_id,
        atom_count: 0,
        ca_x: 0,
        ca_y: 0,
        ca_z: 0,
        has_alpha_carbon: false,
    };
}

pub fn pdb_residue_set_ca(res: &mut PdbResidue, x: Int, y: Int, z: Int) {
    (res).ca_x = x;
    (res).ca_y = y;
    (res).ca_z = z;
    (res).has_alpha_carbon = true;
}

pub fn pdb_chain_new(chain_id: String, is_protein: Bool) -> PdbChain {
    return PdbChain {
        chain_id: chain_id,
        residue_count: 0,
        atom_count: 0,
        is_protein: is_protein,
    };
}

pub fn pdb_structure_new(
    id: String,
    chains: Int,
    residues: Int,
    atoms: Int,
    resolution_x100: Int,
    method: String
) -> PdbStructure {
    return PdbStructure {
        id: id,
        chain_count: chains,
        residue_count: residues,
        atom_count: atoms,
        resolution_x100: resolution_x100,
        experimental_method: method,
    };
}

pub fn pdb_structure_is_high_resolution(s: &PdbStructure) -> Bool {
    // High resolution X-ray: resolution <= 2.0 A (200)
    let res = (s).resolution_x100;
    return (res > 0) && (res <= 200);
}

pub fn pdb_structure_is_xray(s: &PdbStructure) -> Bool {
    return (s).experimental_method == "X-RAY DIFFRACTION";
}
