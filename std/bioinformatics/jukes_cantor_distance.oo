// # Jukes-Cantor 1969 & Kimura 2-Parameter Distances
//
// Logline: JC69 / K80 evolutionary distances via series, saturation at p>=0.75. Destubbed off pub type / String.
//
// Setup: p, P, Q in milli-substitutions. model_id 69 or 80.
//
// Beats:
//   1. p = differences / sites.
//   2. JC69 d = p + (2/3)p^2 + (16/27)p^3; saturate at 750.
//   3. K80 d ≈ P + Q + P^2 + (1/2)Q^2.

type EvolutionaryDistance = struct {
    model_id: Int,
    p_distance_x1000: Int,
    corrected_distance_x1000: Int,
    variance_x1000: Int,
    is_saturated: Int
};

type K80Params = struct {
    transitions_p_x1000: Int,
    transversions_q_x1000: Int
};

pub fn p_distance_x1000_compute(differences: Int, total_sites: Int) -> Int {
    if total_sites <= 0 {
        return 0;
    }
    return (differences * 1000) / total_sites;
}

pub fn jukes_cantor_distance_x1000(p_x1000: Int) -> Int {
    if p_x1000 >= 750 {
        return 999999;
    }
    if p_x1000 <= 0 {
        return 0;
    }
    let p: Int = p_x1000;
    let term1: Int = p;
    let term2: Int = (2 * p * p) / (3 * 1000);
    let term3: Int = (16 * p * p * p) / (27 * 1000000);
    return term1 + term2 + term3;
}

pub fn jukes_cantor_variance_x1000(p_x1000: Int, sites: Int) -> Int {
    if sites <= 0 {
        return 0;
    }
    if p_x1000 >= 750 {
        return 0;
    }
    let p: Int = p_x1000;
    let q: Int = 1000 - p;
    let denom_factor: Int = 1000 - ((4 * p) / 3);
    if denom_factor <= 0 {
        return 999999;
    }
    let num: Int = (p * q) / 1000;
    let denom: Int = (denom_factor * denom_factor * sites) / 1000000;
    if denom <= 0 {
        return 0;
    }
    return (num * 1000) / denom;
}

pub fn jukes_cantor_model_compute(differences: Int, total_sites: Int) -> EvolutionaryDistance {
    let p_dist: Int = p_distance_x1000_compute(differences, total_sites);
    let is_sat: Int = if p_dist >= 750 { 1 } else { 0 };
    let jc_dist: Int = jukes_cantor_distance_x1000(p_dist);
    let var_val: Int = jukes_cantor_variance_x1000(p_dist, total_sites);
    return EvolutionaryDistance {
        model_id: 69,
        p_distance_x1000: p_dist,
        corrected_distance_x1000: jc_dist,
        variance_x1000: var_val,
        is_saturated: is_sat
    };
}

pub fn k80_params_new(p_x1000: Int, q_x1000: Int) -> K80Params {
    return K80Params {
        transitions_p_x1000: p_x1000,
        transversions_q_x1000: q_x1000
    };
}

pub fn kimura_2p_distance_x1000(k80: K80Params) -> Int {
    let p: Int = k80.transitions_p_x1000;
    let q: Int = k80.transversions_q_x1000;
    if (2 * p + q) >= 1000 {
        return 999999;
    }
    if (2 * q) >= 1000 {
        return 999999;
    }
    let d: Int = p + q + ((p * p) / 1000) + ((q * q) / 2000);
    return d;
}

pub fn evolutionary_distance_corrected(d: EvolutionaryDistance) -> Int {
    return d.corrected_distance_x1000;
}

pub fn evolutionary_distance_saturated(d: EvolutionaryDistance) -> Int {
    return d.is_saturated;
}
