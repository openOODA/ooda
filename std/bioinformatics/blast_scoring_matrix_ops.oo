// # BLOSUM62 / PAM250 Substitution Score Lookups
//
// Logline: Amino-acid log-odds lookup plus bit score S'=(lambda S)/ln2.
//
// Setup: AA codes A=1 C=2 D=3 E=4 F=5 G=6 H=7 I=8 K=9 L=10 M=11 N=12 P=13 Q=14 R=15 S=16 T=17 V=18 W=19 Y=20.
//
// Beats:
//   1. BLOSUM62 identity and conservative pairs (I/V, K/R, Y/F).
//   2. PAM250 identity (W=17 C=12).
//   3. Bit score (lambda_x1000 * S) / 693; E-value exponent from bits.

import "./blast_scoring_matrix_types.oo";

pub fn blosum62_lookup_score(aa1: Int, aa2: Int) -> Int {
    if aa1 == aa2 {
        if aa1 == 19 {
            return 11;
        }
        if aa1 == 2 {
            return 9;
        }
        if aa1 == 20 {
            return 7;
        }
        if aa1 == 5 {
            return 7;
        }
        if aa1 == 7 {
            return 6;
        }
        if aa1 == 11 {
            return 6;
        }
        if aa1 == 8 {
            return 4;
        }
        if aa1 == 18 {
            return 4;
        }
        if aa1 == 10 {
            return 4;
        }
        if aa1 == 9 {
            return 4;
        }
        if aa1 == 15 {
            return 4;
        }
        return 4;
    }
    if aa1 == 8 {
        if aa2 == 18 {
            return 3;
        }
    }
    if aa1 == 18 {
        if aa2 == 8 {
            return 3;
        }
    }
    if aa1 == 10 {
        if aa2 == 11 {
            return 2;
        }
    }
    if aa1 == 11 {
        if aa2 == 10 {
            return 2;
        }
    }
    if aa1 == 8 {
        if aa2 == 10 {
            return 2;
        }
    }
    if aa1 == 10 {
        if aa2 == 8 {
            return 2;
        }
    }
    if aa1 == 9 {
        if aa2 == 15 {
            return 2;
        }
    }
    if aa1 == 15 {
        if aa2 == 9 {
            return 2;
        }
    }
    if aa1 == 4 {
        if aa2 == 3 {
            return 2;
        }
    }
    if aa1 == 3 {
        if aa2 == 4 {
            return 2;
        }
    }
    if aa1 == 20 {
        if aa2 == 5 {
            return 3;
        }
    }
    if aa1 == 5 {
        if aa2 == 20 {
            return 3;
        }
    }
    if aa1 == 16 {
        if aa2 == 17 {
            return 1;
        }
    }
    if aa1 == 17 {
        if aa2 == 16 {
            return 1;
        }
    }
    if aa1 == 14 {
        if aa2 == 4 {
            return 2;
        }
    }
    if aa1 == 4 {
        if aa2 == 14 {
            return 2;
        }
    }
    if aa1 == 12 {
        if aa2 == 3 {
            return 1;
        }
    }
    if aa1 == 3 {
        if aa2 == 12 {
            return 1;
        }
    }
    if aa1 == 1 {
        if aa2 == 16 {
            return 1;
        }
    }
    if aa1 == 16 {
        if aa2 == 1 {
            return 1;
        }
    }
    if aa1 == 1 {
        if aa2 == 18 {
            return 0;
        }
    }
    if aa1 == 18 {
        if aa2 == 1 {
            return 0;
        }
    }
    if aa1 == 13 {
        return 0 - 3;
    }
    if aa2 == 13 {
        return 0 - 3;
    }
    if aa1 == 19 {
        return 0 - 3;
    }
    if aa2 == 19 {
        return 0 - 3;
    }
    if aa1 == 2 {
        return 0 - 3;
    }
    if aa2 == 2 {
        return 0 - 3;
    }
    return 0 - 1;
}

pub fn pam250_lookup_score(aa1: Int, aa2: Int) -> Int {
    if aa1 == aa2 {
        if aa1 == 19 {
            return 17;
        }
        if aa1 == 2 {
            return 12;
        }
        if aa1 == 20 {
            return 10;
        }
        if aa1 == 5 {
            return 10;
        }
        return 5;
    }
    if aa1 == 8 {
        if aa2 == 18 {
            return 4;
        }
    }
    if aa1 == 18 {
        if aa2 == 8 {
            return 4;
        }
    }
    if aa1 == 9 {
        if aa2 == 15 {
            return 3;
        }
    }
    if aa1 == 15 {
        if aa2 == 9 {
            return 3;
        }
    }
    if aa1 == 4 {
        if aa2 == 3 {
            return 3;
        }
    }
    if aa1 == 3 {
        if aa2 == 4 {
            return 3;
        }
    }
    return 0 - 2;
}

pub fn blast_compute_bit_score_x100(raw_score: Int, lambda_x1000: Int, k_x1000: Int) -> Int {
    if raw_score <= 0 {
        return 0;
    }
    return (raw_score * lambda_x1000) / 693;
}

pub fn blast_compute_evalue_exponent(bit_score_x100: Int, search_space_eff: Int) -> Int {
    let bit_score: Int = bit_score_x100 / 100;
    let bit_reduction: Int = (bit_score * 100) / 332;
    if bit_score > 50 {
        return 0 - (bit_score - 30);
    }
    return 9 - bit_reduction;
}
