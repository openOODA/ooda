// # GFF3/GTF Genome Annotation & Interval Operations
//
// Logline: Parses genomic features (genes, transcripts, exons, CDS), calculates genomic interval overlaps, and checks coding potential.
//
// Setup: Genomic coordinate and annotation indexing module.
//
// Beats:
//   1. Define GffFeature and GenomicInterval data structures.
//   2. Parse feature types, 1-based coordinates, strand orientation, and coding phase.
//   3. Compute interval intersections, containment, and genomic distance.

// -------------------------------------------------------------------
// GFF Data Structures
// -------------------------------------------------------------------

pub type GffFeature = struct {
    seqid: String,
    source: String,
    feature_type: String,
    start_pos: Int,
    end_pos: Int,
    score: Int,
    strand: String, // "+" or "-" or "."
    phase: Int,    // 0, 1, 2, or -1 (unphased)
    attributes: String,
    length: Int
};

pub type GenomicInterval = struct {
    chrom: String,
    start_pos: Int,
    end_pos: Int,
    strand: String
};

// -------------------------------------------------------------------
// Feature Construction & Properties
// -------------------------------------------------------------------

pub fn gff_feature_new(
    seqid: String,
    source: String,
    f_type: String,
    start_p: Int,
    end_p: Int,
    score: Int,
    strand: String,
    phase: Int,
    attrs: String
) -> GffFeature {
    let len = if end_p >= start_p { (end_p - start_p) + 1 } else { 0 };
    return GffFeature {
        seqid: seqid,
        source: source,
        feature_type: f_type,
        start_pos: start_p,
        end_pos: end_p,
        score: score,
        strand: strand,
        phase: phase,
        attributes: attrs,
        length: len
    };
}

pub fn gff_feature_is_coding(f: &GffFeature) -> Bool {
    return (f).feature_type == "CDS" || (f).feature_type == "exon";
}

pub fn gff_feature_is_gene(f: &GffFeature) -> Bool {
    return (f).feature_type == "gene";
}

pub fn gff_feature_is_transcript(f: &GffFeature) -> Bool {
    return (f).feature_type == "mRNA" || (f).feature_type == "transcript";
}

// -------------------------------------------------------------------
// Genomic Interval Arithmetic
// -------------------------------------------------------------------

pub fn genomic_interval_new(chrom: String, start_p: Int, end_p: Int, strand: String) -> GenomicInterval {
    return GenomicInterval {
        chrom: chrom,
        start_pos: start_p,
        end_pos: end_p,
        strand: strand
    };
}

pub fn genomic_interval_overlaps(i1: &GenomicInterval, i2: &GenomicInterval) -> Bool {
    if (i1).chrom != (i2).chrom {
        return false;
    }
    let max_start = if (i1).start_pos > (i2).start_pos { (i1).start_pos } else { (i2).start_pos };
    let min_end = if (i1).end_pos < (i2).end_pos { (i1).end_pos } else { (i2).end_pos };
    return max_start <= min_end;
}

pub fn genomic_interval_contains(parent: &GenomicInterval, child: &GenomicInterval) -> Bool {
    if (parent).chrom != (child).chrom {
        return false;
    }
    return ((child).start_pos >= (parent).start_pos) && ((child).end_pos <= (parent).end_pos);
}

pub fn genomic_interval_distance(i1: &GenomicInterval, i2: &GenomicInterval) -> Int {
    if (i1).chrom != (i2).chrom {
        return -1; // Different chromosomes
    }
    if genomic_interval_overlaps(i1, i2) {
        return 0;
    }
    if (i1).end_pos < (i2).start_pos {
        return (i2).start_pos - (i1).end_pos;
    }
    return (i1).start_pos - (i2).end_pos;
}
