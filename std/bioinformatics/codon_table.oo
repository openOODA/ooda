// # Standard & Vertebrate Mitochondrial Genetic Code
//
// Logline: Trinucleotide codon → amino acid, start AUG, stops UAA/UAG/UGA. Destubbed off pub type / String.
//
// Setup: Codon = b0 + 4*b1 + 16*b2; A=0 C=1 G=2 T/U=3.
//         AA: *=0 A=1 C=2 D=3 E=4 F=5 G=6 H=7 I=8 K=9 L=10 M=11 N=12 P=13 Q=14 R=15 S=16 T=17 V=18 W=19 Y=20 X=21.
//
// Beats:
//   1. NCBI table 1 standard 64-codon map.
//   2. Table 2 mito: AGA/AGG stop, ATA Met, TGA Trp.
//   3. Start ATG=44; stops TAA=3 TAG=35 TGA=11.

type CodonEntry = struct {
    codon: Int,
    amino_acid: Int,
    is_start: Int,
    is_stop: Int
};

type CodonTable = struct {
    table_id: Int,
    codon_n: Int
};

pub fn codon_pack(b0: Int, b1: Int, b2: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16);
}

pub fn codon_standard_aa(codon: Int) -> Int {
    if codon < 0 {
        return 21;
    }
    if codon > 63 {
        return 21;
    }
    let b0: Int = codon % 4;
    let b1: Int = (codon / 4) % 4;
    let b2: Int = (codon / 16) % 4;
    if b0 == 3 {
        if b1 == 3 {
            if b2 == 1 {
                return 5;
            }
            if b2 == 3 {
                return 5;
            }
            return 10;
        }
        if b1 == 1 {
            return 16;
        }
        if b1 == 0 {
            if b2 == 0 {
                return 0;
            }
            if b2 == 2 {
                return 0;
            }
            return 20;
        }
        if b2 == 0 {
            return 0;
        }
        if b2 == 2 {
            return 19;
        }
        return 2;
    }
    if b0 == 1 {
        if b1 == 3 {
            return 10;
        }
        if b1 == 1 {
            return 13;
        }
        if b1 == 0 {
            if b2 == 1 {
                return 7;
            }
            if b2 == 3 {
                return 7;
            }
            return 14;
        }
        return 15;
    }
    if b0 == 0 {
        if b1 == 3 {
            if b2 == 2 {
                return 11;
            }
            return 8;
        }
        if b1 == 1 {
            return 17;
        }
        if b1 == 0 {
            if b2 == 1 {
                return 12;
            }
            if b2 == 3 {
                return 12;
            }
            return 9;
        }
        if b2 == 1 {
            return 16;
        }
        if b2 == 3 {
            return 16;
        }
        return 15;
    }
    if b1 == 3 {
        return 18;
    }
    if b1 == 1 {
        return 1;
    }
    if b1 == 0 {
        if b2 == 1 {
            return 3;
        }
        if b2 == 3 {
            return 3;
        }
        return 4;
    }
    return 6;
}

pub fn codon_is_start_standard(codon: Int) -> Int {
    if codon == 44 {
        return 1;
    }
    return 0;
}

pub fn codon_is_stop_standard(codon: Int) -> Int {
    if codon == 3 {
        return 1;
    }
    if codon == 35 {
        return 1;
    }
    if codon == 11 {
        return 1;
    }
    return 0;
}

pub fn codon_vertebrate_mito_aa(codon: Int) -> Int {
    if codon == 8 {
        return 0;
    }
    if codon == 40 {
        return 0;
    }
    if codon == 12 {
        return 11;
    }
    if codon == 11 {
        return 19;
    }
    return codon_standard_aa(codon);
}

pub fn codon_table_known(table_id: Int) -> Int {
    if table_id == 1 {
        return 1;
    }
    if table_id == 2 {
        return 1;
    }
    if table_id == 11 {
        return 1;
    }
    return 0;
}

pub fn codon_entry_new(codon: Int) -> CodonEntry {
    let aa: Int = codon_standard_aa(codon);
    return CodonEntry {
        codon: codon,
        amino_acid: aa,
        is_start: codon_is_start_standard(codon),
        is_stop: codon_is_stop_standard(codon)
    };
}

pub fn codon_table_new(table_id: Int) -> CodonTable {
    return CodonTable {
        table_id: table_id,
        codon_n: 64
    };
}

pub fn codon_entry_aa(e: CodonEntry) -> Int {
    return e.amino_acid;
}

pub fn codon_table_id(t: CodonTable) -> Int {
    return t.table_id;
}
