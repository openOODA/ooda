// # Protein Translation & Open Reading Frame Analysis
//
// Logline: Frame-0/1/2 codon walk, residue Daltons, KR+/DE- charge. Destubbed off pub type / String / import.
//
// Setup: Packed 2-bit DNA A=0 C=1 G=2 T=3. Codon = b0+4*b1+16*b2.
//         AA: *=0 A=1 C=2 D=3 E=4 F=5 G=6 H=7 I=8 K=9 L=10 M=11 N=12 P=13 Q=14 R=15 S=16 T=17 V=18 W=19 Y=20 X=21.
//         MW = 18 + residue masses; stop * excluded from mass.
//
// Beats:
//   1. NCBI table 1 codon map (same as codon_table).
//   2. Average residue 110 Da; terminal water 18 Da.
//   3. Complete ORF if first=start ATG and last=stop.

type ProteinSequence = struct {
    id: Int,
    peptide_pack: Int,
    aa_n: Int,
    mw_daltons: Int,
    net_charge: Int
};

pub fn int_pow4(n: Int) -> Int {
    if n <= 0 { return 1; }
    return 4 * int_pow4(n - 1);
}

pub fn int_pow32(n: Int) -> Int {
    if n <= 0 { return 1; }
    return 32 * int_pow32(n - 1);
}

pub fn dna_base_at(packed: Int, idx: Int) -> Int {
    let div: Int = packed / int_pow4(idx);
    return div % 4;
}

pub fn dna_pack4(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16) + (b3 * 64);
}

pub fn codon_pack(b0: Int, b1: Int, b2: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16);
}

pub fn codon_at(packed: Int, i: Int) -> Int {
    let b0: Int = dna_base_at(packed, i);
    let b1: Int = dna_base_at(packed, i + 1);
    let b2: Int = dna_base_at(packed, i + 2);
    return codon_pack(b0, b1, b2);
}

fn codon_aa_dispatch(b0: Int, b1: Int, b2: Int) -> Int {
    if b0 == 0 {
        if b1 == 3 { if b2 == 2 { return 11; } return 8; }
        if b1 == 1 { return 17; }
        if b1 == 0 { if b2 == 1 { return 12; } if b2 == 3 { return 12; } return 9; }
        if b2 == 1 { return 16; }
        if b2 == 3 { return 16; }
        return 15;
    }
    if b0 == 1 {
        if b1 == 3 { return 10; }
        if b1 == 1 { return 13; }
        if b1 == 0 { if b2 == 1 { return 7; } if b2 == 3 { return 7; } return 14; }
        return 15;
    }
    if b0 == 2 {
        if b1 == 3 { return 18; }
        if b1 == 1 { return 1; }
        if b1 == 0 { if b2 == 1 { return 3; } if b2 == 3 { return 3; } return 4; }
        return 6;
    }
    if b1 == 3 { if b2 == 1 { return 5; } if b2 == 3 { return 5; } return 10; }
    if b1 == 1 { return 16; }
    if b1 == 0 { if b2 == 0 { return 0; } if b2 == 2 { return 0; } return 20; }
    if b2 == 0 { return 0; }
    if b2 == 2 { return 19; }
    return 2;
}

pub fn codon_standard_aa(codon: Int) -> Int {
    if codon < 0 { return 21; }
    if codon > 63 { return 21; }
    let b0: Int = codon % 4;
    let b1: Int = (codon / 4) % 4;
    let b2: Int = (codon / 16) % 4;
    return codon_aa_dispatch(b0, b1, b2);
}

pub fn codon_is_start_standard(codon: Int) -> Int {
    if codon == 44 { return 1; }
    return 0;
}

pub fn codon_is_stop_standard(codon: Int) -> Int {
    if codon == 3 { return 1; }
    if codon == 35 { return 1; }
    if codon == 11 { return 1; }
    return 0;
}

pub fn protein_aa_weight_da(aa: Int) -> Int {
    if aa == 1 { return 71; }
    if aa == 15 { return 156; }
    if aa == 12 { return 114; }
    if aa == 3 { return 115; }
    if aa == 2 { return 103; }
    if aa == 4 { return 129; }
    if aa == 14 { return 128; }
    if aa == 6 { return 57; }
    if aa == 7 { return 137; }
    if aa == 8 { return 113; }
    if aa == 10 { return 113; }
    if aa == 9 { return 128; }
    if aa == 11 { return 131; }
    if aa == 5 { return 147; }
    if aa == 13 { return 97; }
    if aa == 16 { return 87; }
    if aa == 17 { return 101; }
    if aa == 19 { return 186; }
    if aa == 20 { return 163; }
    if aa == 18 { return 99; }
    if aa == 0 { return 0; }
    return 110;
}

pub fn protein_aa_charge(aa: Int) -> Int {
    if aa == 9 { return 1; }
    if aa == 15 { return 1; }
    if aa == 3 { return 0 - 1; }
    if aa == 4 { return 0 - 1; }
    return 0;
}

pub fn protein_sequence_mw(p: ProteinSequence) -> Int {
    return p.mw_daltons;
}

pub fn protein_sequence_charge(p: ProteinSequence) -> Int {
    return p.net_charge;
}
