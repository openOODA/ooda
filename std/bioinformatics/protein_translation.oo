// # Protein Translation & Open Reading Frame Analysis
//
// Logline: Frame-0/1/2 codon walk, residue Daltons, KR+/DE- charge. Destubbed off pub type / String / import.
//
// Setup: Packed 2-bit DNA A=0 C=1 G=2 T=3. Codon = b0+4*b1+16*b2.
//         AA: *=0 A=1 C=2 D=3 E=4 F=5 G=6 H=7 I=8 K=9 L=10 M=11 N=12 P=13 Q=14 R=15 S=16 T=17 V=18 W=19 Y=20 X=21.
//         MW = 18 + residue masses; stop * excluded from mass.
//
// Beats:
//   1. NCBI table 1 codon map (same as codon_table).
//   2. Average residue 110 Da; terminal water 18 Da.
//   3. Complete ORF if first=start ATG and last=stop.

type ProteinSequence = struct {
    id: Int,
    peptide_pack: Int,
    aa_n: Int,
    mw_daltons: Int,
    net_charge: Int
};

type OrfRecord = struct {
    frame: Int,
    start_pos: Int,
    end_pos: Int,
    nt_n: Int,
    aa_n: Int,
    is_complete: Int
};

type TranslateAcc = struct {
    peptide_pack: Int,
    aa_n: Int,
    mw: Int,
    charge: Int,
    first_aa: Int,
    last_aa: Int
};

pub fn int_pow4(n: Int) -> Int {
    if n <= 0 {
        return 1;
    }
    return 4 * int_pow4(n - 1);
}

pub fn int_pow32(n: Int) -> Int {
    if n <= 0 {
        return 1;
    }
    return 32 * int_pow32(n - 1);
}

pub fn dna_base_at(packed: Int, idx: Int) -> Int {
    let div: Int = packed / int_pow4(idx);
    return div % 4;
}

pub fn dna_pack4(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16) + (b3 * 64);
}

pub fn codon_pack(b0: Int, b1: Int, b2: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16);
}

pub fn codon_at(packed: Int, i: Int) -> Int {
    let b0: Int = dna_base_at(packed, i);
    let b1: Int = dna_base_at(packed, i + 1);
    let b2: Int = dna_base_at(packed, i + 2);
    return codon_pack(b0, b1, b2);
}

pub fn codon_standard_aa(codon: Int) -> Int {
    if codon < 0 {
        return 21;
    }
    if codon > 63 {
        return 21;
    }
    let b0: Int = codon % 4;
    let b1: Int = (codon / 4) % 4;
    let b2: Int = (codon / 16) % 4;
    if b0 == 3 {
        if b1 == 3 {
            if b2 == 1 {
                return 5;
            }
            if b2 == 3 {
                return 5;
            }
            return 10;
        }
        if b1 == 1 {
            return 16;
        }
        if b1 == 0 {
            if b2 == 0 {
                return 0;
            }
            if b2 == 2 {
                return 0;
            }
            return 20;
        }
        if b2 == 0 {
            return 0;
        }
        if b2 == 2 {
            return 19;
        }
        return 2;
    }
    if b0 == 1 {
        if b1 == 3 {
            return 10;
        }
        if b1 == 1 {
            return 13;
        }
        if b1 == 0 {
            if b2 == 1 {
                return 7;
            }
            if b2 == 3 {
                return 7;
            }
            return 14;
        }
        return 15;
    }
    if b0 == 0 {
        if b1 == 3 {
            if b2 == 2 {
                return 11;
            }
            return 8;
        }
        if b1 == 1 {
            return 17;
        }
        if b1 == 0 {
            if b2 == 1 {
                return 12;
            }
            if b2 == 3 {
                return 12;
            }
            return 9;
        }
        if b2 == 1 {
            return 16;
        }
        if b2 == 3 {
            return 16;
        }
        return 15;
    }
    if b1 == 3 {
        return 18;
    }
    if b1 == 1 {
        return 1;
    }
    if b1 == 0 {
        if b2 == 1 {
            return 3;
        }
        if b2 == 3 {
            return 3;
        }
        return 4;
    }
    return 6;
}

pub fn codon_is_start_standard(codon: Int) -> Int {
    if codon == 44 {
        return 1;
    }
    return 0;
}

pub fn codon_is_stop_standard(codon: Int) -> Int {
    if codon == 3 {
        return 1;
    }
    if codon == 35 {
        return 1;
    }
    if codon == 11 {
        return 1;
    }
    return 0;
}

pub fn protein_aa_weight_da(aa: Int) -> Int {
    if aa == 1 {
        return 71;
    }
    if aa == 15 {
        return 156;
    }
    if aa == 12 {
        return 114;
    }
    if aa == 3 {
        return 115;
    }
    if aa == 2 {
        return 103;
    }
    if aa == 4 {
        return 129;
    }
    if aa == 14 {
        return 128;
    }
    if aa == 6 {
        return 57;
    }
    if aa == 7 {
        return 137;
    }
    if aa == 8 {
        return 113;
    }
    if aa == 10 {
        return 113;
    }
    if aa == 9 {
        return 128;
    }
    if aa == 11 {
        return 131;
    }
    if aa == 5 {
        return 147;
    }
    if aa == 13 {
        return 97;
    }
    if aa == 16 {
        return 87;
    }
    if aa == 17 {
        return 101;
    }
    if aa == 19 {
        return 186;
    }
    if aa == 20 {
        return 163;
    }
    if aa == 18 {
        return 99;
    }
    if aa == 0 {
        return 0;
    }
    return 110;
}

pub fn protein_aa_charge(aa: Int) -> Int {
    if aa == 9 {
        return 1;
    }
    if aa == 15 {
        return 1;
    }
    if aa == 3 {
        return 0 - 1;
    }
    if aa == 4 {
        return 0 - 1;
    }
    return 0;
}

pub fn translate_empty() -> TranslateAcc {
    return TranslateAcc {
        peptide_pack: 0,
        aa_n: 0,
        mw: 18,
        charge: 0,
        first_aa: 21,
        last_aa: 21
    };
}

pub fn translate_scan(packed: Int, n: Int, i: Int, acc: TranslateAcc) -> TranslateAcc {
    if (i + 2) >= n {
        return acc;
    }
    let codon: Int = codon_at(packed, i);
    let aa: Int = codon_standard_aa(codon);
    let add_mw: Int = protein_aa_weight_da(aa);
    let add_ch: Int = protein_aa_charge(aa);
    let first: Int = if acc.aa_n == 0 { aa } else { acc.first_aa };
    let nxt: TranslateAcc = TranslateAcc {
        peptide_pack: acc.peptide_pack + (aa * int_pow32(acc.aa_n)),
        aa_n: acc.aa_n + 1,
        mw: acc.mw + add_mw,
        charge: acc.charge + add_ch,
        first_aa: first,
        last_aa: aa
    };
    return translate_scan(packed, n, i + 3, nxt);
}

pub fn protein_translate_frame(packed: Int, n: Int, frame_offset: Int) -> TranslateAcc {
    if n < (frame_offset + 3) {
        return TranslateAcc {
            peptide_pack: 0,
            aa_n: 0,
            mw: 0,
            charge: 0,
            first_aa: 21,
            last_aa: 21
        };
    }
    return translate_scan(packed, n, frame_offset, translate_empty());
}

pub fn protein_translate_nucleotides(packed: Int, n: Int) -> TranslateAcc {
    return protein_translate_frame(packed, n, 0);
}

pub fn protein_estimate_molecular_weight(acc: TranslateAcc) -> Int {
    if acc.aa_n == 0 {
        return 0;
    }
    return acc.mw;
}

pub fn protein_estimate_net_charge(acc: TranslateAcc) -> Int {
    return acc.charge;
}

pub fn protein_sequence_new(id: Int, packed: Int, n: Int) -> ProteinSequence {
    let acc: TranslateAcc = protein_translate_nucleotides(packed, n);
    let mw: Int = protein_estimate_molecular_weight(acc);
    return ProteinSequence {
        id: id,
        peptide_pack: acc.peptide_pack,
        aa_n: acc.aa_n,
        mw_daltons: mw,
        net_charge: acc.charge
    };
}

pub fn protein_sequence_mw(p: ProteinSequence) -> Int {
    return p.mw_daltons;
}

pub fn protein_sequence_charge(p: ProteinSequence) -> Int {
    return p.net_charge;
}

pub fn protein_orf_new(frame: Int, packed: Int, n: Int) -> OrfRecord {
    let acc: TranslateAcc = protein_translate_frame(packed, n, frame);
    let used_nt: Int = acc.aa_n * 3;
    let start_pos: Int = frame;
    let end_pos: Int = frame + used_nt;
    let first_codon: Int = if n >= (frame + 3) { codon_at(packed, frame) } else { 0 - 1 };
    let last_is_stop: Int = if acc.last_aa == 0 { 1 } else { 0 };
    let complete: Int = if codon_is_start_standard(first_codon) == 1 { last_is_stop } else { 0 };
    return OrfRecord {
        frame: frame,
        start_pos: start_pos,
        end_pos: end_pos,
        nt_n: used_nt,
        aa_n: acc.aa_n,
        is_complete: complete
    };
}

pub fn orf_is_complete(o: OrfRecord) -> Int {
    return o.is_complete;
}
