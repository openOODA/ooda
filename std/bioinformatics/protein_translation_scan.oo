// # Protein Translation Scan & ORF Sibling
//
// Logline: Recursive codon walk, frame-0/1/2 translate, ORF complete-on-start-stop, sequence new.
//
// Setup: Imports protein_translation.oo for type, codon fns, AA properties.
//
// Beats:
//   1. translate_scan recurses on (packed, n, i+3, acc) until i+2 >= n.
//   2. protein_translate_frame starts at frame_offset.
//   3. protein_orf_new requires first codon is start (44) and last aa is stop (0).

import "./protein_translation.oo";

type TranslateAcc = struct {
    peptide_pack: Int,
    aa_n: Int,
    mw: Int,
    charge: Int,
    first_aa: Int,
    last_aa: Int
};

type OrfRecord = struct {
    frame: Int,
    start_pos: Int,
    end_pos: Int,
    nt_n: Int,
    aa_n: Int,
    is_complete: Int
};

pub fn translate_empty() -> TranslateAcc {
    return TranslateAcc {
        peptide_pack: 0,
        aa_n: 0,
        mw: 18,
        charge: 0,
        first_aa: 21,
        last_aa: 21
    };
}

pub fn translate_scan(packed: Int, n: Int, i: Int, acc: TranslateAcc) -> TranslateAcc {
    if (i + 2) >= n {
        return acc;
    }
    let codon: Int = codon_at(packed, i);
    let aa: Int = codon_standard_aa(codon);
    let add_mw: Int = protein_aa_weight_da(aa);
    let add_ch: Int = protein_aa_charge(aa);
    let first: Int = if acc.aa_n == 0 { aa } else { acc.first_aa };
    let nxt: TranslateAcc = TranslateAcc {
        peptide_pack: acc.peptide_pack + (aa * int_pow32(acc.aa_n)),
        aa_n: acc.aa_n + 1,
        mw: acc.mw + add_mw,
        charge: acc.charge + add_ch,
        first_aa: first,
        last_aa: aa
    };
    return translate_scan(packed, n, i + 3, nxt);
}

pub fn protein_translate_frame(packed: Int, n: Int, frame_offset: Int) -> TranslateAcc {
    if n < (frame_offset + 3) {
        return TranslateAcc {
            peptide_pack: 0,
            aa_n: 0,
            mw: 0,
            charge: 0,
            first_aa: 21,
            last_aa: 21
        };
    }
    return translate_scan(packed, n, frame_offset, translate_empty());
}

pub fn protein_translate_nucleotides(packed: Int, n: Int) -> TranslateAcc {
    return protein_translate_frame(packed, n, 0);
}

pub fn protein_estimate_molecular_weight(acc: TranslateAcc) -> Int {
    if acc.aa_n == 0 {
        return 0;
    }
    return acc.mw;
}

pub fn protein_estimate_net_charge(acc: TranslateAcc) -> Int {
    return acc.charge;
}

pub fn protein_sequence_new(id: Int, packed: Int, n: Int) -> ProteinSequence {
    let acc: TranslateAcc = protein_translate_nucleotides(packed, n);
    let mw: Int = protein_estimate_molecular_weight(acc);
    return ProteinSequence {
        id: id,
        peptide_pack: acc.peptide_pack,
        aa_n: acc.aa_n,
        mw_daltons: mw,
        net_charge: acc.charge
    };
}

pub fn protein_orf_new(frame: Int, packed: Int, n: Int) -> OrfRecord {
    let acc: TranslateAcc = protein_translate_frame(packed, n, frame);
    let used_nt: Int = acc.aa_n * 3;
    let start_pos: Int = frame;
    let end_pos: Int = frame + used_nt;
    let first_codon: Int = if n >= (frame + 3) { codon_at(packed, frame) } else { 0 - 1 };
    let last_is_stop: Int = if acc.last_aa == 0 { 1 } else { 0 };
    let complete: Int = if codon_is_start_standard(first_codon) == 1 { last_is_stop } else { 0 };
    return OrfRecord {
        frame: frame,
        start_pos: start_pos,
        end_pos: end_pos,
        nt_n: used_nt,
        aa_n: acc.aa_n,
        is_complete: complete
    };
}

pub fn orf_is_complete(o: OrfRecord) -> Int {
    return o.is_complete;
}
