// # Smith-Waterman Local Pairwise Alignment
//
// Logline: Local running score with zero floor max(0, S). Destubbed off pub type / String / import.
//
// Setup: Packed 2-bit DNA A=0 C=1 G=2 T=3. AlignmentParams inlined (no import).
//
// Beats:
//   1. max4 for DP cell (diag, up, left, 0).
//   2. Reset running score at <=0; track best HSP start/end.
//   3. Identity over best-end - best-start.

type AlignmentParams = struct {
    match_score: Int,
    mismatch_penalty: Int,
    gap_open: Int,
    gap_extend: Int
};

type LocalAlignmentResult = struct {
    max_score: Int,
    query_start: Int,
    query_end: Int,
    ref_start: Int,
    ref_end: Int,
    matches: Int,
    mismatches: Int,
    gaps: Int,
    identity_pct: Int
};

type SwWalk = struct {
    running_score: Int,
    max_score: Int,
    best_start: Int,
    best_end: Int,
    cur_start: Int,
    matches: Int,
    mismatches: Int
};

pub fn alignment_params_default() -> AlignmentParams {
    return AlignmentParams {
        match_score: 2,
        mismatch_penalty: 0 - 1,
        gap_open: 0 - 2,
        gap_extend: 0 - 1
    };
}

pub fn local_alignment_init() -> LocalAlignmentResult {
    return LocalAlignmentResult {
        max_score: 0,
        query_start: 0,
        query_end: 0,
        ref_start: 0,
        ref_end: 0,
        matches: 0,
        mismatches: 0,
        gaps: 0,
        identity_pct: 0
    };
}

pub fn smith_waterman_max4(v1: Int, v2: Int, v3: Int, v4: Int) -> Int {
    let m12: Int = if v2 > v1 { v2 } else { v1 };
    let m34: Int = if v4 > v3 { v4 } else { v3 };
    if m34 > m12 {
        return m34;
    }
    return m12;
}

pub fn int_pow4(n: Int) -> Int {
    if n <= 0 {
        return 1;
    }
    return 4 * int_pow4(n - 1);
}

pub fn dna_base_at(packed: Int, idx: Int) -> Int {
    let div: Int = packed / int_pow4(idx);
    return div % 4;
}

pub fn dna_pack4(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16) + (b3 * 64);
}

pub fn sw_step(p1: Int, p2: Int, n: Int, i: Int, params: AlignmentParams, st: SwWalk) -> SwWalk {
    if i >= n {
        return st;
    }
    let b1: Int = dna_base_at(p1, i);
    let b2: Int = dna_base_at(p2, i);
    let delta: Int = if b1 == b2 { params.match_score } else { params.mismatch_penalty };
    let next_run: Int = st.running_score + delta;
    if next_run <= 0 {
        let nxt: SwWalk = SwWalk {
            running_score: 0,
            max_score: st.max_score,
            best_start: st.best_start,
            best_end: st.best_end,
            cur_start: i + 1,
            matches: st.matches,
            mismatches: st.mismatches
        };
        return sw_step(p1, p2, n, i + 1, params, nxt);
    }
    let new_m: Int = if b1 == b2 { st.matches + 1 } else { st.matches };
    let new_mm: Int = if b1 == b2 { st.mismatches } else { st.mismatches + 1 };
    let beat: Int = if next_run > st.max_score { 1 } else { 0 };
    let nxt: SwWalk = SwWalk {
        running_score: next_run,
        max_score: if beat == 1 { next_run } else { st.max_score },
        best_start: if beat == 1 { st.cur_start } else { st.best_start },
        best_end: if beat == 1 { i + 1 } else { st.best_end },
        cur_start: st.cur_start,
        matches: new_m,
        mismatches: new_mm
    };
    return sw_step(p1, p2, n, i + 1, params, nxt);
}

pub fn smith_waterman_score_pair(p1: Int, n1: Int, p2: Int, n2: Int, params: AlignmentParams) -> LocalAlignmentResult {
    let min_n: Int = if n1 < n2 { n1 } else { n2 };
    let start: SwWalk = SwWalk {
        running_score: 0,
        max_score: 0,
        best_start: 0,
        best_end: 0,
        cur_start: 0,
        matches: 0,
        mismatches: 0
    };
    let st: SwWalk = sw_step(p1, p2, min_n, 0, params, start);
    let aligned_n: Int = if st.best_end > st.best_start { st.best_end - st.best_start } else { 0 };
    let id_pct: Int = if aligned_n > 0 { (st.matches * 100) / aligned_n } else { 0 };
    return LocalAlignmentResult {
        max_score: st.max_score,
        query_start: st.best_start,
        query_end: st.best_end,
        ref_start: st.best_start,
        ref_end: st.best_end,
        matches: st.matches,
        mismatches: st.mismatches,
        gaps: 0,
        identity_pct: id_pct
    };
}

pub fn local_alignment_max_score(r: LocalAlignmentResult) -> Int {
    return r.max_score;
}

pub fn local_alignment_identity(r: LocalAlignmentResult) -> Int {
    return r.identity_pct;
}
