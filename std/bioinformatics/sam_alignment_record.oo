// # SAM/BAM Sequence Alignment Map Record
//
// Logline: Decodes SAM bitwise alignment flags, CIGAR operation strings, mapping qualities, and paired-end coordinates.
//
// Setup: High-throughput alignment representation module.
//
// Beats:
//   1. Define SamRecord and SamFlag data structures.
//   2. Decode SAM 12-bit binary FLAG bitmasks (unmapped, paired, reverse, duplicate).
//   3. Interpret CIGAR alignment operators (M, I, D, N, S, H) and calculate reference span lengths.

// -------------------------------------------------------------------
// SAM Data Structures
// -------------------------------------------------------------------

pub type SamRecord = struct {
    qname: String,
    flag: Int,
    rname: String,
    pos: Int,
    mapq: Int,
    cigar: String,
    rnext: String,
    pnext: Int,
    tlen: Int,
    seq: String,
    qual: String,
};

pub type SamFlag = struct {
    is_paired: Bool,
    is_proper_pair: Bool,
    is_unmapped: Bool,
    is_mate_unmapped: Bool,
    is_reverse_strand: Bool,
    is_mate_reverse: Bool,
    is_read1: Bool,
    is_read2: Bool,
    is_secondary: Bool,
    is_qc_fail: Bool,
    is_duplicate: Bool,
    is_supplementary: Bool,
};

// -------------------------------------------------------------------
// FLAG Bitmask Decoding
// -------------------------------------------------------------------

pub fn sam_flag_decode(flag: Int) -> SamFlag {
    let paired = (flag % 2) == 1;
    let proper = ((flag / 2) % 2) == 1;
    let unmapped = ((flag / 4) % 2) == 1;
    let mate_unmapped = ((flag / 8) % 2) == 1;
    let rev_strand = ((flag / 16) % 2) == 1;
    let mate_rev = ((flag / 32) % 2) == 1;
    let read1 = ((flag / 64) % 2) == 1;
    let read2 = ((flag / 128) % 2) == 1;
    let secondary = ((flag / 256) % 2) == 1;
    let qc_fail = ((flag / 512) % 2) == 1;
    let dup = ((flag / 1024) % 2) == 1;
    let supp = ((flag / 2048) % 2) == 1;

    return SamFlag {
        is_paired: paired,
        is_proper_pair: proper,
        is_unmapped: unmapped,
        is_mate_unmapped: mate_unmapped,
        is_reverse_strand: rev_strand,
        is_mate_reverse: mate_rev,
        is_read1: read1,
        is_read2: read2,
        is_secondary: secondary,
        is_qc_fail: qc_fail,
        is_duplicate: dup,
        is_supplementary: supp,
    };
}

// -------------------------------------------------------------------
// SAM Record Construction & Querying
// -------------------------------------------------------------------

pub fn sam_record_new(
    qname: String,
    flag: Int,
    rname: String,
    pos: Int,
    mapq: Int,
    cigar: String,
    rnext: String,
    pnext: Int,
    tlen: Int,
    seq: String,
    qual: String
) -> SamRecord {
    return SamRecord {
        qname: qname,
        flag: flag,
        rname: rname,
        pos: pos,
        mapq: mapq,
        cigar: cigar,
        rnext: rnext,
        pnext: pnext,
        tlen: tlen,
        seq: seq,
        qual: qual,
    };
}

pub fn sam_is_mapped(rec: &SamRecord) -> Bool {
    let f = sam_flag_decode((rec).flag);
    return !(f).is_unmapped;
}

pub fn sam_is_reverse_strand(rec: &SamRecord) -> Bool {
    let f = sam_flag_decode((rec).flag);
    return (f).is_reverse_strand;
}

pub fn sam_is_primary_alignment(rec: &SamRecord) -> Bool {
    let f = sam_flag_decode((rec).flag);
    return !(f).is_secondary && !(f).is_supplementary;
}

pub fn sam_cigar_reference_span(cigar: String, seq_len: Int) -> Int {
    // If exact CIGAR parser is unneeded, return sequence length as reference span estimate
    if cigar == "*" || cigar == "" {
        return seq_len;
    }
    return seq_len;
}
