// # RNA Secondary Structure & Thermodynamic Folding
//
// Logline: Dot-bracket balance, pair class, Turner-style pair energies. Destubbed off pub type / String / import.
//
// Setup: RNA 2-bit A=0 C=1 G=2 U=3. Dot-bracket base-4: 0=. 1=( 2=).
//         Pair type 1=GC 2=AU 3=GU 4=other. Energy x10 kcal/mol.
//
// Beats:
//   1. GC -3.0, AU -2.0, GU wobble -1.0, mismatch +0.5.
//   2. Balance walk: depth never <0 and ends 0.
//   3. MFE ≈ -2.0 kcal per pair.

type RnaBasePair = struct {
    pos_5p: Int,
    pos_3p: Int,
    pair_type: Int
};

type RnaStructure = struct {
    seq_pack: Int,
    db_pack: Int,
    seq_n: Int,
    paired_n: Int,
    free_energy_kcal_x10: Int,
    is_valid: Int
};

type DbWalk = struct {
    depth: Int,
    ok: Int,
    open_n: Int
};

pub fn int_pow4(n: Int) -> Int {
    if n <= 0 {
        return 1;
    }
    return 4 * int_pow4(n - 1);
}

pub fn rna_base_at(packed: Int, idx: Int) -> Int {
    let div: Int = packed / int_pow4(idx);
    return div % 4;
}

pub fn rna_pack4(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16) + (b3 * 64);
}

pub fn db_at(packed: Int, idx: Int) -> Int {
    let div: Int = packed / int_pow4(idx);
    return div % 4;
}

pub fn db_pack4(c0: Int, c1: Int, c2: Int, c3: Int) -> Int {
    return c0 + (c1 * 4) + (c2 * 16) + (c3 * 64);
}

pub fn rna_classify_pair_type(b1: Int, b2: Int) -> Int {
    if b1 == 2 {
        if b2 == 1 {
            return 1;
        }
    }
    if b1 == 1 {
        if b2 == 2 {
            return 1;
        }
    }
    if b1 == 0 {
        if b2 == 3 {
            return 2;
        }
    }
    if b1 == 3 {
        if b2 == 0 {
            return 2;
        }
    }
    if b1 == 2 {
        if b2 == 3 {
            return 3;
        }
    }
    if b1 == 3 {
        if b2 == 2 {
            return 3;
        }
    }
    return 4;
}

pub fn rna_is_canonical_pair(b1: Int, b2: Int) -> Int {
    let t: Int = rna_classify_pair_type(b1, b2);
    if t == 1 {
        return 1;
    }
    if t == 2 {
        return 1;
    }
    return 0;
}

pub fn rna_is_wobble_pair(b1: Int, b2: Int) -> Int {
    let t: Int = rna_classify_pair_type(b1, b2);
    if t == 3 {
        return 1;
    }
    return 0;
}

pub fn rna_pair_energy_contribution_x10(pair_type: Int) -> Int {
    if pair_type == 1 {
        return 0 - 30;
    }
    if pair_type == 2 {
        return 0 - 20;
    }
    if pair_type == 3 {
        return 0 - 10;
    }
    return 5;
}

pub fn db_walk_empty() -> DbWalk {
    return DbWalk {
        depth: 0,
        ok: 1,
        open_n: 0
    };
}

pub fn db_scan(packed: Int, n: Int, i: Int, st: DbWalk) -> DbWalk {
    if st.ok == 0 {
        return st;
    }
    if i >= n {
        return st;
    }
    let c: Int = db_at(packed, i);
    if c == 1 {
        let nxt: DbWalk = DbWalk {
            depth: st.depth + 1,
            ok: 1,
            open_n: st.open_n + 1
        };
        return db_scan(packed, n, i + 1, nxt);
    }
    if c == 2 {
        let nd: Int = st.depth - 1;
        let ok2: Int = if nd < 0 { 0 } else { 1 };
        let nxt: DbWalk = DbWalk {
            depth: nd,
            ok: ok2,
            open_n: st.open_n
        };
        return db_scan(packed, n, i + 1, nxt);
    }
    return db_scan(packed, n, i + 1, st);
}

pub fn rna_validate_dot_bracket_balance(db_pack: Int, n: Int) -> Int {
    let st: DbWalk = db_scan(db_pack, n, 0, db_walk_empty());
    if st.ok == 0 {
        return 0;
    }
    if st.depth == 0 {
        return 1;
    }
    return 0;
}

pub fn rna_count_paired_bases(db_pack: Int, n: Int) -> Int {
    let st: DbWalk = db_scan(db_pack, n, 0, db_walk_empty());
    return st.open_n * 2;
}

pub fn rna_structure_new(seq_pack: Int, db_pack: Int, seq_n: Int) -> RnaStructure {
    let is_bal: Int = rna_validate_dot_bracket_balance(db_pack, seq_n);
    let is_valid: Int = if seq_n > 0 { is_bal } else { 0 };
    let paired: Int = if is_valid == 1 { rna_count_paired_bases(db_pack, seq_n) } else { 0 };
    let mfe_x10: Int = (paired / 2) * (0 - 20);
    return RnaStructure {
        seq_pack: seq_pack,
        db_pack: db_pack,
        seq_n: seq_n,
        paired_n: paired,
        free_energy_kcal_x10: mfe_x10,
        is_valid: is_valid
    };
}

pub fn rna_structure_paired(s: RnaStructure) -> Int {
    return s.paired_n;
}

pub fn rna_structure_mfe(s: RnaStructure) -> Int {
    return s.free_energy_kcal_x10;
}

pub fn rna_base_pair_new(pos_5p: Int, pos_3p: Int, pair_type: Int) -> RnaBasePair {
    return RnaBasePair {
        pos_5p: pos_5p,
        pos_3p: pos_3p,
        pair_type: pair_type
    };
}

pub fn rna_base_pair_type(p: RnaBasePair) -> Int {
    return p.pair_type;
}
