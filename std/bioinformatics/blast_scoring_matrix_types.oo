// # BLAST HSP and Scoring Matrix Configuration Types
//
// Logline: BlastHsp high-scoring segment pair and ScoringMatrixConfig lambda/k parameter struct.
//
// Setup: Pure Int fields, no nested complex types.
//
// Beats:
//   1. BlastHsp: query/subject id, raw/bit score, e-value exponent, identity.
//   2. ScoringMatrixConfig: matrix_id, lambda_x1000, k_param_x1000.
//
// AA codes A=1 C=2 D=3 E=4 F=5 G=6 H=7 I=8 K=9 L=10 M=11 N=12 P=13 Q=14 R=15 S=16 T=17 V=18 W=19 Y=20.

type BlastHsp = struct {
    query_id: Int,
    subject_id: Int,
    raw_score: Int,
    bit_score_x100: Int,
    evalue_exponent: Int,
    identity_pct: Int,
    aligned_n: Int
};

type ScoringMatrixConfig = struct {
    matrix_id: Int,
    lambda_x1000: Int,
    k_param_x1000: Int
};

pub fn scoring_matrix_blosum62() -> ScoringMatrixConfig {
    return ScoringMatrixConfig {
        matrix_id: 62,
        lambda_x1000: 267,
        k_param_x1000: 41
    };
}

pub fn blast_hsp_new(q_id: Int, s_id: Int, raw_s: Int, bit_s_x100: Int, e_exp: Int, id_pct: Int, aln_n: Int) -> BlastHsp {
    return BlastHsp {
        query_id: q_id,
        subject_id: s_id,
        raw_score: raw_s,
        bit_score_x100: bit_s_x100,
        evalue_exponent: e_exp,
        identity_pct: id_pct,
        aligned_n: aln_n
    };
}

pub fn blast_hsp_raw(h: BlastHsp) -> Int {
    return h.raw_score;
}

pub fn blast_hsp_bits(h: BlastHsp) -> Int {
    return h.bit_score_x100;
}
