// # Motif Search & IUPAC Degenerate Pattern Matching
//
// Logline: IUPAC bitmask match and PWM threshold scan. Destubbed off pub type / String.
//
// Setup: Target 2-bit DNA A=0 C=1 G=2 T=3. Pattern 4-bit IUPAC masks A=1 C=2 G=4 T=8.
//         Symbol codes: A=0 C=1 G=2 T=3 R=4 Y=5 S=6 W=7 K=8 M=9 B=10 D=11 H=12 V=13 N=14.
//
// Beats:
//   1. Two-base R/Y/S/W/K/M and three-base B/D/H/V / N=15.
//   2. Bit overlap without bitwise AND (nibble tests).
//   3. Sliding-window occurrence count.

type MotifMatch = struct {
    position: Int,
    matched_pack: Int,
    score: Int,
    strand: Int
};

type IupacDegeneracy = struct {
    symbol_code: Int,
    bitmask: Int
};

type PwmModel = struct {
    motif_id: Int,
    motif_n: Int,
    threshold_score: Int
};

pub fn int_pow4(n: Int) -> Int {
    if n <= 0 {
        return 1;
    }
    return 4 * int_pow4(n - 1);
}

pub fn int_pow16(n: Int) -> Int {
    if n <= 0 {
        return 1;
    }
    return 16 * int_pow16(n - 1);
}

pub fn dna_base_at(packed: Int, idx: Int) -> Int {
    let div: Int = packed / int_pow4(idx);
    return div % 4;
}

pub fn dna_pack4(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16) + (b3 * 64);
}

pub fn dna_pack8(lo4: Int, hi4: Int) -> Int {
    return lo4 + (hi4 * 256);
}

pub fn iupac_mask_at(packed_masks: Int, idx: Int) -> Int {
    let div: Int = packed_masks / int_pow16(idx);
    return div % 16;
}

pub fn iupac_pack4(m0: Int, m1: Int, m2: Int, m3: Int) -> Int {
    return m0 + (m1 * 16) + (m2 * 256) + (m3 * 4096);
}

pub fn iupac_base_bitmask(base: Int) -> Int {
    if base == 0 {
        return 1;
    }
    if base == 1 {
        return 2;
    }
    if base == 2 {
        return 4;
    }
    if base == 3 {
        return 8;
    }
    return 0;
}

pub fn iupac_symbol_bitmask(sym: Int) -> Int {
    if sym == 0 {
        return 1;
    }
    if sym == 1 {
        return 2;
    }
    if sym == 2 {
        return 4;
    }
    if sym == 3 {
        return 8;
    }
    if sym == 4 {
        return 5;
    }
    if sym == 5 {
        return 10;
    }
    if sym == 6 {
        return 6;
    }
    if sym == 7 {
        return 9;
    }
    if sym == 8 {
        return 12;
    }
    if sym == 9 {
        return 3;
    }
    if sym == 10 {
        return 14;
    }
    if sym == 11 {
        return 13;
    }
    if sym == 12 {
        return 11;
    }
    if sym == 13 {
        return 7;
    }
    return 15;
}

pub fn iupac_symbol_matches(pattern_sym: Int, base: Int) -> Int {
    let pat_mask: Int = iupac_symbol_bitmask(pattern_sym);
    let base_mask: Int = iupac_base_bitmask(base);
    if base_mask == 0 {
        return 0;
    }
    let t_bit: Int = if pat_mask >= 8 { if base_mask == 8 { 1 } else { 0 } } else { 0 };
    let g_bit: Int = if ((pat_mask / 4) % 2) == 1 { if base_mask == 4 { 1 } else { 0 } } else { 0 };
    let c_bit: Int = if ((pat_mask / 2) % 2) == 1 { if base_mask == 2 { 1 } else { 0 } } else { 0 };
    let a_bit: Int = if (pat_mask % 2) == 1 { if base_mask == 1 { 1 } else { 0 } } else { 0 };
    if t_bit == 1 {
        return 1;
    }
    if g_bit == 1 {
        return 1;
    }
    if c_bit == 1 {
        return 1;
    }
    if a_bit == 1 {
        return 1;
    }
    return 0;
}

pub fn iupac_mask_matches(pat_mask: Int, base: Int) -> Int {
    let base_mask: Int = iupac_base_bitmask(base);
    if base_mask == 0 {
        return 0;
    }
    let t_bit: Int = if pat_mask >= 8 { if base_mask == 8 { 1 } else { 0 } } else { 0 };
    let g_bit: Int = if ((pat_mask / 4) % 2) == 1 { if base_mask == 4 { 1 } else { 0 } } else { 0 };
    let c_bit: Int = if ((pat_mask / 2) % 2) == 1 { if base_mask == 2 { 1 } else { 0 } } else { 0 };
    let a_bit: Int = if (pat_mask % 2) == 1 { if base_mask == 1 { 1 } else { 0 } } else { 0 };
    if t_bit == 1 {
        return 1;
    }
    if g_bit == 1 {
        return 1;
    }
    if c_bit == 1 {
        return 1;
    }
    if a_bit == 1 {
        return 1;
    }
    return 0;
}

pub fn motif_pattern_matches_at_scan(target: Int, pattern: Int, offset: Int, j: Int, p_n: Int) -> Int {
    if j >= p_n {
        return 1;
    }
    let p_mask: Int = iupac_mask_at(pattern, j);
    let t_base: Int = dna_base_at(target, offset + j);
    if iupac_mask_matches(p_mask, t_base) == 0 {
        return 0;
    }
    return motif_pattern_matches_at_scan(target, pattern, offset, j + 1, p_n);
}

pub fn motif_pattern_matches_at(target: Int, target_n: Int, pattern: Int, p_n: Int, offset: Int) -> Int {
    if (offset + p_n) > target_n {
        return 0;
    }
    return motif_pattern_matches_at_scan(target, pattern, offset, 0, p_n);
}

pub fn motif_count_scan(target: Int, target_n: Int, pattern: Int, p_n: Int, i: Int, acc: Int) -> Int {
    if (i + p_n) > target_n {
        return acc;
    }
    let hit: Int = motif_pattern_matches_at(target, target_n, pattern, p_n, i);
    return motif_count_scan(target, target_n, pattern, p_n, i + 1, acc + hit);
}

pub fn motif_count_occurrences(target: Int, target_n: Int, pattern: Int, p_n: Int) -> Int {
    if target_n < p_n {
        return 0;
    }
    if p_n == 0 {
        return 0;
    }
    return motif_count_scan(target, target_n, pattern, p_n, 0, 0);
}

pub fn motif_match_new(pos: Int, matched_pack: Int, score: Int, strand: Int) -> MotifMatch {
    return MotifMatch {
        position: pos,
        matched_pack: matched_pack,
        score: score,
        strand: strand
    };
}

pub fn motif_match_score(m: MotifMatch) -> Int {
    return m.score;
}

pub fn pwm_model_new(motif_id: Int, motif_n: Int, threshold: Int) -> PwmModel {
    return PwmModel {
        motif_id: motif_id,
        motif_n: motif_n,
        threshold_score: threshold
    };
}

pub fn pwm_model_threshold(p: PwmModel) -> Int {
    return p.threshold_score;
}

pub fn iupac_degeneracy_new(symbol_code: Int) -> IupacDegeneracy {
    return IupacDegeneracy {
        symbol_code: symbol_code,
        bitmask: iupac_symbol_bitmask(symbol_code)
    };
}

pub fn iupac_degeneracy_mask(d: IupacDegeneracy) -> Int {
    return d.bitmask;
}
