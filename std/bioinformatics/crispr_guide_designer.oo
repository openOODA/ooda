// # CRISPR sgRNA Guide RNA Designer & PAM Detection
//
// Logline: SpCas9 NGG / Cas12a spacer, GC band, poly-T Pol III, seed G. Destubbed off pub type / String / import.
//
// Setup: Packed 2-bit DNA A=0 C=1 G=2 T=3. Nuclease 1=SpCas9 2=Cas12a.
//
// Beats:
//   1. NGG: bases 1 and 2 are G. Spacer 20 (Cas9) / 23 (Cas12a).
//   2. Score 50; GC 40-60 +30, 30-70 +10, else -20; poly-T -40; 3' G +10.
//   3. Recommend if score>=60 and no TTTT terminator.

type CrisprPam = struct {
    nuclease_id: Int,
    pam_code: Int,
    spacer_n: Int,
    is_3prime: Int
};

type SgRnaGuide = struct {
    spacer_pack: Int,
    pam_pack: Int,
    target_pos: Int,
    gc_pct: Int,
    on_target_score: Int,
    has_poly_t: Int,
    is_recommended: Int
};

pub fn int_pow4(n: Int) -> Int {
    if n <= 0 {
        return 1;
    }
    return 4 * int_pow4(n - 1);
}

pub fn dna_base_at(packed: Int, idx: Int) -> Int {
    let div: Int = packed / int_pow4(idx);
    return div % 4;
}

pub fn dna_pack4(b0: Int, b1: Int, b2: Int, b3: Int) -> Int {
    return b0 + (b1 * 4) + (b2 * 16) + (b3 * 64);
}

pub fn dna_pack_ag_scan(i: Int, n: Int, acc: Int) -> Int {
    if i >= n {
        return acc;
    }
    let b: Int = if (i % 2) == 0 { 0 } else { 2 };
    return dna_pack_ag_scan(i + 1, n, acc + (b * int_pow4(i)));
}

pub fn dna_pack_ag(n: Int) -> Int {
    return dna_pack_ag_scan(0, n, 0);
}

pub fn dna_all_scan(i: Int, n: Int, base: Int, acc: Int) -> Int {
    if i >= n {
        return acc;
    }
    return dna_all_scan(i + 1, n, base, acc + (base * int_pow4(i)));
}

pub fn dna_all(n: Int, base: Int) -> Int {
    return dna_all_scan(0, n, base, 0);
}

pub fn gc_tally_scan(packed: Int, n: Int, i: Int, gc: Int) -> Int {
    if i >= n {
        return gc;
    }
    let b: Int = dna_base_at(packed, i);
    let add: Int = if b == 1 { 1 } else { if b == 2 { 1 } else { 0 } };
    return gc_tally_scan(packed, n, i + 1, gc + add);
}

pub fn gc_content_pct(packed: Int, n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    return (gc_tally_scan(packed, n, 0, 0) * 100) / n;
}

pub fn crispr_pam_spcas9() -> CrisprPam {
    return CrisprPam {
        nuclease_id: 1,
        pam_code: 6,
        spacer_n: 20,
        is_3prime: 1
    };
}

pub fn crispr_pam_cas12a() -> CrisprPam {
    return CrisprPam {
        nuclease_id: 2,
        pam_code: 333,
        spacer_n: 23,
        is_3prime: 0
    };
}

pub fn crispr_pam_spacer_n(p: CrisprPam) -> Int {
    return p.spacer_n;
}

pub fn crispr_is_spcas9_pam(packed: Int, n: Int) -> Int {
    if n != 3 {
        return 0;
    }
    let g1: Int = dna_base_at(packed, 1);
    let g2: Int = dna_base_at(packed, 2);
    if g1 == 2 {
        if g2 == 2 {
            return 1;
        }
    }
    return 0;
}

pub fn poly_t_scan(packed: Int, n: Int, i: Int) -> Int {
    if (i + 3) >= n {
        return 0;
    }
    let b0: Int = dna_base_at(packed, i);
    let b1: Int = dna_base_at(packed, i + 1);
    let b2: Int = dna_base_at(packed, i + 2);
    let b3: Int = dna_base_at(packed, i + 3);
    if b0 == 3 {
        if b1 == 3 {
            if b2 == 3 {
                if b3 == 3 {
                    return 1;
                }
            }
        }
    }
    return poly_t_scan(packed, n, i + 1);
}

pub fn crispr_has_poly_t(packed: Int, n: Int) -> Int {
    if n < 4 {
        return 0;
    }
    return poly_t_scan(packed, n, 0);
}

pub fn gc_adj_score(gc: Int) -> Int {
    if gc >= 40 {
        if gc <= 60 {
            return 30;
        }
        if gc <= 70 {
            return 10;
        }
        return 0 - 20;
    }
    if gc >= 30 {
        return 10;
    }
    return 0 - 20;
}

pub fn crispr_score_on_target(packed: Int, n: Int) -> Int {
    let gc: Int = gc_content_pct(packed, n);
    let poly: Int = crispr_has_poly_t(packed, n);
    let poly_pen: Int = if poly == 1 { 0 - 40 } else { 0 };
    let last: Int = if n >= 1 { dna_base_at(packed, n - 1) } else { 0 };
    let seed: Int = if n >= 20 { if last == 2 { 10 } else { 0 } } else { 0 };
    let raw: Int = 50 + gc_adj_score(gc) + poly_pen + seed;
    let lo: Int = if raw < 0 { 0 } else { raw };
    if lo > 100 {
        return 100;
    }
    return lo;
}

pub fn sgrna_guide_new(spacer_pack: Int, spacer_n: Int, pam_pack: Int, pos: Int) -> SgRnaGuide {
    let gc: Int = gc_content_pct(spacer_pack, spacer_n);
    let poly_t: Int = crispr_has_poly_t(spacer_pack, spacer_n);
    let score: Int = crispr_score_on_target(spacer_pack, spacer_n);
    let rec: Int = if score >= 60 { if poly_t == 0 { 1 } else { 0 } } else { 0 };
    return SgRnaGuide {
        spacer_pack: spacer_pack,
        pam_pack: pam_pack,
        target_pos: pos,
        gc_pct: gc,
        on_target_score: score,
        has_poly_t: poly_t,
        is_recommended: rec
    };
}

pub fn sgrna_guide_score(g: SgRnaGuide) -> Int {
    return g.on_target_score;
}

pub fn sgrna_guide_recommended(g: SgRnaGuide) -> Int {
    return g.is_recommended;
}
