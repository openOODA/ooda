// # Phylogenetic Tree & Evolutionary Cladogram Representation
//
// Logline: Models bifurcating phylogenetic trees, node branching topologies, patristic distances, and Newick tree structures.
//
// Setup: Evolutionary phylogenetics and tree topology module.
//
// Beats:
//   1. Define PhyloNode and PhyloTree data structures.
//   2. Construct leaf taxa and internal ancestral bifurcating nodes.
//   3. Compute branch length sums, leaf counts, and patristic evolutionary distances.

// -------------------------------------------------------------------
// Phylogenetic Data Structures
// -------------------------------------------------------------------

pub type PhyloNode = struct {
    node_id: Int,
    taxon_name: String,
    parent_id: Int,
    left_child_id: Int,
    right_child_id: Int,
    branch_length_x1000: Int, // e.g. 0.050 -> 50
    is_leaf: Bool
};

pub type PhyloTree = struct {
    root_id: Int,
    total_nodes: Int,
    leaf_count: Int,
    total_tree_length_x1000: Int
};

// -------------------------------------------------------------------
// Tree Node Constructors
// -------------------------------------------------------------------

pub fn phylo_node_leaf(id: Int, taxon: String, parent_id: Int, branch_len_x1000: Int) -> PhyloNode {
    return PhyloNode {
        node_id: id,
        taxon_name: taxon,
        parent_id: parent_id,
        left_child_id: -1,
        right_child_id: -1,
        branch_length_x1000: branch_len_x1000,
        is_leaf: true
    };
}

pub fn phylo_node_internal(
    id: Int,
    parent_id: Int,
    left_id: Int,
    right_id: Int,
    branch_len_x1000: Int
) -> PhyloNode {
    return PhyloNode {
        node_id: id,
        taxon_name: "",
        parent_id: parent_id,
        left_child_id: left_id,
        right_child_id: right_id,
        branch_length_x1000: branch_len_x1000,
        is_leaf: false
    };
}

pub fn phylo_tree_new(root_id: Int) -> PhyloTree {
    return PhyloTree {
        root_id: root_id,
        total_nodes: 0,
        leaf_count: 0,
        total_tree_length_x1000: 0
    };
}

pub fn phylo_tree_add_node(tree: &mut PhyloTree, node: &PhyloNode) {
    (tree).total_nodes = (tree).total_nodes + 1;
    if (node).is_leaf {
        (tree).leaf_count = (tree).leaf_count + 1;
    }
    (tree).total_tree_length_x1000 = (tree).total_tree_length_x1000 + (node).branch_length_x1000;
}

pub fn phylo_node_is_leaf(node: &PhyloNode) -> Bool {
    return (node).is_leaf;
}

pub fn phylo_patristic_distance_estimate(branch1_x1000: Int, branch2_x1000: Int) -> Int {
    return branch1_x1000 + branch2_x1000;
}
