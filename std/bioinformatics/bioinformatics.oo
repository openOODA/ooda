// # Bioinformatics & Computational Biology Unified Facade
//
// Logline: Re-exports genomic sequencing, molecular translation, alignment, structural biology, and phylogenetics submodules.
//
// Setup: Pure module shim and facade importing all 24 bioinformatics companion submodules.
//
// Beats:
//   1. Import 24 specialized genomics, transcriptomics, structural, and evolutionary submodules.
//   2. Re-export public constructors, capability-gated interfaces, and analytical entry points.
//   3. Maintain full backwards compatibility for downstream openOODA computational biology applications.

import "./fasta_reader.oo";
import "./fasta_writer.oo";
import "./fastq_quality.oo";
import "./dna_sequence.oo";
import "./rna_sequence.oo";
import "./codon_table.oo";
import "./protein_translation.oo";
import "./protein_translation_scan.oo";
import "./needleman_wunsch.oo";
import "./smith_waterman.oo";
import "./blast_scoring_matrix.oo";
import "./kmer_counter.oo";
import "./gc_content.oo";
import "./motif_search.oo";
import "./vcf_variant_parser.oo";
import "./sam_alignment_record.oo";
import "./gff_annotation_parser.oo";
import "./pdb_atom_record.oo";
import "./pdb_protein_parser.oo";
import "./rna_secondary_structure.oo";
import "./phylogenetic_tree.oo";
import "./jukes_cantor_distance.oo";
import "./hmm_profile.oo";
import "./crispr_guide_designer.oo";
import "./bio_stubs.oo";

pub fn bio_shim_fasta_record(id: String, desc: String, seq: String) -> FastaRecord {
    return fasta_record_new(id, desc, seq);
}

pub fn bio_shim_fasta_writer() -> FastaWriter {
    return fasta_writer_new(fasta_writer_config_default());
}

pub fn bio_shim_fastq_record(id: String, seq: String, qual: String) -> FastqRecord {
    return fastq_record_new(id, seq, qual);
}

pub fn bio_shim_dna_sequence(id: String, seq: String) -> DnaSequence {
    return dna_sequence_new(id, seq);
}

pub fn bio_shim_rna_sequence(id: String, seq: String) -> RnaSequence {
    return rna_sequence_new(id, seq);
}

pub fn bio_shim_translate_standard(triplet: String) -> String {
    return codon_standard_translate(triplet);
}

pub fn bio_shim_protein_sequence(id: String, seq: String) -> ProteinSequence {
    return protein_sequence_new(id, seq);
}

pub fn bio_shim_global_align(s1: String, s2: String) -> GlobalAlignmentResult {
    let p = alignment_params_default();
    return needleman_wunsch_score_pair(s1, s2, &p);
}

pub fn bio_shim_local_align(s1: String, s2: String) -> LocalAlignmentResult {
    let p = alignment_params_default();
    return smith_waterman_score_pair(s1, s2, &p);
}

pub fn bio_shim_blosum62_lookup(aa1: String, aa2: String) -> Int {
    return blosum62_lookup_score(aa1, aa2);
}

pub fn bio_shim_kmer_summary(k: Int, total: Int, distinct: Int, singletons: Int) -> KmerSpectrumSummary {
    return kmer_spectrum_summary_new(k, total, distinct, singletons);
}

pub fn bio_shim_gc_metrics(seq: String) -> GcMetrics {
    return gc_metrics_compute(seq);
}

pub fn bio_shim_motif_occurrences(target: String, pattern: String) -> Int {
    return motif_count_occurrences(target, pattern);
}

pub fn bio_shim_vcf_variant(
    chrom: String,
    pos: Int,
    id: String,
    ref_a: String,
    alt_a: String,
    qual: Int,
    filt: String,
    dp: Int,
    af: Int
) -> VcfVariant {
    return vcf_variant_new(chrom, pos, id, ref_a, alt_a, qual, filt, dp, af);
}

pub fn bio_shim_sam_flag(flag: Int) -> SamFlag {
    return sam_flag_decode(flag);
}

pub fn bio_shim_gff_feature(
    seqid: String,
    src: String,
    ftype: String,
    s: Int,
    e: Int,
    score: Int,
    strand: String,
    phase: Int,
    attrs: String
) -> GffFeature {
    return gff_feature_new(seqid, src, ftype, s, e, score, strand, phase, attrs);
}

pub fn bio_shim_pdb_atom(
    serial: Int,
    name: String,
    res: String,
    chain: String,
    seq: Int,
    x: Int,
    y: Int,
    z: Int,
    occ: Int,
    bfac: Int,
    elem: String,
    het: Bool
) -> PdbAtom {
    return pdb_atom_new(serial, name, res, chain, seq, x, y, z, occ, bfac, elem, het);
}

pub fn bio_shim_pdb_structure(id: String, chains: Int, res: Int, atoms: Int, r_x100: Int, m: String) -> PdbStructure {
    return pdb_structure_new(id, chains, res, atoms, r_x100, m);
}

pub fn bio_shim_rna_structure(seq: String, db: String) -> RnaStructure {
    return rna_structure_new(seq, db);
}

pub fn bio_shim_phylo_tree(root_id: Int) -> PhyloTree {
    return phylo_tree_new(root_id);
}

pub fn bio_shim_jc69_distance(diffs: Int, sites: Int) -> EvolutionaryDistance {
    return jukes_cantor_model_compute(diffs, sites);
}

pub fn bio_shim_profile_hmm(name: String, len: Int) -> ProfileHmm {
    return profile_hmm_new(name, len);
}

pub fn bio_shim_sgrna_guide(spacer: String, pam: String, pos: Int) -> SgRnaGuide {
    return sgrna_guide_new(spacer, pam, pos);
}

pub fn bio_shim_fail_closed_bcl(sys: &SysCap, flowcell: String) -> Int {
    return bio_bcl_hardware_basecall_stream(sys, flowcell);
}
