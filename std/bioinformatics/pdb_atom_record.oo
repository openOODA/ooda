// # PDB Atomic Coordinate Record & 3D Geometry
//
// Logline: ATOM/HETATM milli-Angstrom coords, dist², backbone codes. Destubbed off pub type / String.
//
// Setup: 1 A = 1000 units. Atom codes 1=N 2=CA 3=C 4=O 5=other.
//
// Beats:
//   1. Point3D and PdbAtom by-value Int fields.
//   2. Pairwise Euclidean squared distance.
//   3. Backbone = N/CA/C/O; CA is alpha carbon.

type Point3D = struct {
    x: Int,
    y: Int,
    z: Int
};

type PdbAtom = struct {
    serial: Int,
    atom_code: Int,
    res_code: Int,
    chain_id: Int,
    res_seq: Int,
    coord_x: Int,
    coord_y: Int,
    coord_z: Int,
    occupancy_x100: Int,
    b_factor_x100: Int,
    element_z: Int,
    is_hetatm: Int
};

pub fn point3d_new(x: Int, y: Int, z: Int) -> Point3D {
    return Point3D {
        x: x,
        y: y,
        z: z
    };
}

pub fn point3d_x(p: Point3D) -> Int {
    return p.x;
}

pub fn point3d_dist_sq(p1: Point3D, p2: Point3D) -> Int {
    let dx: Int = p1.x - p2.x;
    let dy: Int = p1.y - p2.y;
    let dz: Int = p1.z - p2.z;
    return (dx * dx) + (dy * dy) + (dz * dz);
}

pub fn pdb_atom_new(
    serial: Int,
    atom_code: Int,
    res_code: Int,
    chain_id: Int,
    res_seq: Int,
    x: Int,
    y: Int,
    z: Int,
    occ_x100: Int,
    b_fac_x100: Int,
    elem_z: Int,
    is_het: Int
) -> PdbAtom {
    return PdbAtom {
        serial: serial,
        atom_code: atom_code,
        res_code: res_code,
        chain_id: chain_id,
        res_seq: res_seq,
        coord_x: x,
        coord_y: y,
        coord_z: z,
        occupancy_x100: occ_x100,
        b_factor_x100: b_fac_x100,
        element_z: elem_z,
        is_hetatm: is_het
    };
}

pub fn pdb_atom_distance_sq(a1: PdbAtom, a2: PdbAtom) -> Int {
    let dx: Int = a1.coord_x - a2.coord_x;
    let dy: Int = a1.coord_y - a2.coord_y;
    let dz: Int = a1.coord_z - a2.coord_z;
    return (dx * dx) + (dy * dy) + (dz * dz);
}

pub fn pdb_atom_is_backbone(atom: PdbAtom) -> Int {
    if atom.atom_code == 1 {
        return 1;
    }
    if atom.atom_code == 2 {
        return 1;
    }
    if atom.atom_code == 3 {
        return 1;
    }
    if atom.atom_code == 4 {
        return 1;
    }
    return 0;
}

pub fn pdb_atom_is_alpha_carbon(atom: PdbAtom) -> Int {
    if atom.atom_code == 2 {
        return 1;
    }
    return 0;
}

pub fn pdb_atom_is_hetatm(atom: PdbAtom) -> Int {
    return atom.is_hetatm;
}

pub fn pdb_atom_serial(atom: PdbAtom) -> Int {
    return atom.serial;
}

pub fn pdb_atom_b_factor(atom: PdbAtom) -> Int {
    return atom.b_factor_x100;
}
