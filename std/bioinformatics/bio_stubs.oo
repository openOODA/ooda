pub type BioHardwareDevice = struct {
    device_id: Int,
    is_active: Bool,
    flowcell_id: String
};

pub fn bio_hardware_device_new(id: Int, flowcell: String) -> BioHardwareDevice {
    return BioHardwareDevice {
        device_id: id,
        is_active: false,
        flowcell_id: flowcell
    };
}

