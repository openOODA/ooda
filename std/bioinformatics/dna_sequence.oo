// # DNA Nucleotide Sequence Operations
//
// Logline: Implements DNA sequence data structures, Watson-Crick complementation, reverse complementation, and nucleotide frequencies.
//
// Setup: Core molecular biology sequence computation module.
//
// Beats:
//   1. Define DnaSequence and NucleotideCounts structures.
//   2. Compute Watson-Crick base complements and reverse-complement strings.
//   3. Calculate base compositions, Hamming distances, and transition/transversion metrics.

// -------------------------------------------------------------------
// DNA Data Structures
// -------------------------------------------------------------------

type DnaSequence = struct {
    id: String,
    sequence: String,
    length: Int,
    is_valid: Bool,
};

type NucleotideCounts = struct {
    count_a: Int,
    count_c: Int,
    count_g: Int,
    count_t: Int,
    count_n: Int,
    total: Int,
};

// -------------------------------------------------------------------
// Nucleotide Complementation & Base Checking
// -------------------------------------------------------------------

pub fn dna_is_valid_nucleotide(c: String) -> Bool {
    return (c == "A" || c == "a" || c == "C" || c == "c" ||
            c == "G" || c == "g" || c == "T" || c == "t" ||
            c == "N" || c == "n");
}

pub fn dna_complement_char(c: String) -> String {
    if c == "A" { return "T"; }
    if c == "a" { return "t"; }
    if c == "T" { return "A"; }
    if c == "t" { return "a"; }
    if c == "C" { return "G"; }
    if c == "c" { return "g"; }
    if c == "G" { return "C"; }
    if c == "g" { return "c"; }
    if c == "N" { return "N"; }
    if c == "n" { return "n"; }
    return "N";
}

pub fn dna_reverse_complement(seq: String) -> String {
    let n = chars_len(seq);
    if n == 0 {
        return "";
    }
    let mut rev_comp = "";
    let mut i = n - 1;
    while i >= 0 {
        let c = char_at(seq, i);
        rev_comp = rev_comp + dna_complement_char(c);
        i = i - 1;
    }
    return rev_comp;
}

// -------------------------------------------------------------------
// DNA Sequence Construction & Counting
// -------------------------------------------------------------------

pub fn dna_sequence_new(id: String, sequence: String) -> DnaSequence {
    let n = chars_len(sequence);
    let mut valid = n > 0;
    let mut i = 0;
    while i < n {
        let c = char_at(sequence, i);
        if !dna_is_valid_nucleotide(c) {
            valid = false;
        }
        i = i + 1;
    }
    return DnaSequence {
        id: id,
        sequence: sequence,
        length: n,
        is_valid: valid,
    };
}

pub fn dna_count_nucleotides(seq: String) -> NucleotideCounts {
    let n = chars_len(seq);
    let mut a = 0;
    let mut c_cnt = 0;
    let mut g = 0;
    let mut t = 0;
    let mut other = 0;

    let mut i = 0;
    while i < n {
        let ch = char_at(seq, i);
        if ch == "A" || ch == "a" { a = a + 1; }
        else if ch == "C" || ch == "c" { c_cnt = c_cnt + 1; }
        else if ch == "G" || ch == "g" { g = g + 1; }
        else if ch == "T" || ch == "t" { t = t + 1; }
        else { other = other + 1; }
        i = i + 1;
    }

    return NucleotideCounts {
        count_a: a,
        count_c: c_cnt,
        count_g: g,
        count_t: t,
        count_n: other,
        total: n,
    };
}

pub fn dna_hamming_distance(s1: String, s2: String) -> Int {
    let n1 = chars_len(s1);
    let n2 = chars_len(s2);
    let min_len = if n1 < n2 { n1 } else { n2 };
    let mut dist = if n1 > n2 { n1 - n2 } else { n2 - n1 };

    let mut i = 0;
    while i < min_len {
        let c1 = char_at(s1, i);
        let c2 = char_at(s2, i);
        if c1 != c2 {
            dist = dist + 1;
        }
        i = i + 1;
    }
    return dist;
}

pub fn dna_is_transition(c1: String, c2: String) -> Bool {
    // Purine <-> Purine (A <-> G) or Pyrimidine <-> Pyrimidine (C <-> T)
    let is_ag = (c1 == "A" && c2 == "G") || (c1 == "G" && c2 == "A") ||
                (c1 == "a" && c2 == "g") || (c1 == "g" && c2 == "a");
    let is_ct = (c1 == "C" && c2 == "T") || (c1 == "T" && c2 == "C") ||
                (c1 == "c" && c2 == "t") || (c1 == "t" && c2 == "c");
    return is_ag || is_ct;
}
