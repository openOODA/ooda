            return 2;
        }
    }
    if aa1 == 15 {
        if aa2 == 9 {
            return 2;
        }
    }
    if aa1 == 4 {
        if aa2 == 3 {
            return 2;
        }
    }
    if aa1 == 3 {
        if aa2 == 4 {
            return 2;
        }
    }
    if aa1 == 20 {
        if aa2 == 5 {
            return 3;
        }
    }
    if aa1 == 5 {
        if aa2 == 20 {
            return 3;
        }
    }
    if aa1 == 16 {
        if aa2 == 17 {
            return 1;
        }
    }
    if aa1 == 17 {
        if aa2 == 16 {
            return 1;
        }
    }
    if aa1 == 14 {
        if aa2 == 4 {
            return 2;
        }
    }
    if aa1 == 4 {
        if aa2 == 14 {
            return 2;
        }
    }
    if aa1 == 12 {
        if aa2 == 3 {
