// # BLOSUM62 / PAM250 Substitution Scores & Karlin-Altschul Bits
//
// Logline: Amino-acid log-odds lookup plus bit score S'=(lambda S)/ln2. Destubbed off pub type / String.
//
// Setup: AA codes A=1 C=2 D=3 E=4 F=5 G=6 H=7 I=8 K=9 L=10 M=11 N=12 P=13 Q=14 R=15 S=16 T=17 V=18 W=19 Y=20.
//
// Beats:
//   1. BLOSUM62 identity and conservative pairs (I/V, K/R, Y/F).
//   2. PAM250 identity (W=17 C=12).
//   3. Bit score (lambda_x1000 * S) / 693; E-value exponent from bits.

type BlastHsp = struct {
    query_id: Int,
    subject_id: Int,
    raw_score: Int,
    bit_score_x100: Int,
    evalue_exponent: Int,
    identity_pct: Int,
    aligned_n: Int
};

type ScoringMatrixConfig = struct {
    matrix_id: Int,
    lambda_x1000: Int,
    k_param_x1000: Int
};

pub fn blosum62_lookup_score(aa1: Int, aa2: Int) -> Int {
    if aa1 == aa2 {
        if aa1 == 19 {
            return 11;
        }
        if aa1 == 2 {
            return 9;
        }
        if aa1 == 20 {
            return 7;
        }
        if aa1 == 5 {
            return 7;
        }
        if aa1 == 7 {
            return 6;
        }
        if aa1 == 11 {
            return 6;
        }
        if aa1 == 8 {
            return 4;
        }
        if aa1 == 18 {
            return 4;
        }
        if aa1 == 10 {
            return 4;
        }
        if aa1 == 9 {
            return 4;
        }
        if aa1 == 15 {
            return 4;
        }
        return 4;
    }
    if aa1 == 8 {
        if aa2 == 18 {
            return 3;
        }
    }
    if aa1 == 18 {
        if aa2 == 8 {
            return 3;
        }
    }
    if aa1 == 10 {
        if aa2 == 11 {
            return 2;
        }
    }
    if aa1 == 11 {
