pub fn pam250_lookup_score(aa1: Int, aa2: Int) -> Int {
    if aa1 == aa2 {
        if aa1 == 19 {
            return 17;
        }
        if aa1 == 2 {
            return 12;
        }
        if aa1 == 20 {
            return 10;
        }
        if aa1 == 5 {
            return 10;
        }
        return 5;
    }
    if aa1 == 8 {
        if aa2 == 18 {
            return 4;
        }
    }
    if aa1 == 18 {
        if aa2 == 8 {
            return 4;
        }
    }
    if aa1 == 9 {
        if aa2 == 15 {
            return 3;
        }
    }
    if aa1 == 15 {
        if aa2 == 9 {
            return 3;
        }
    }
    if aa1 == 4 {
        if aa2 == 3 {
            return 3;
        }
    }
    if aa1 == 3 {
        if aa2 == 4 {
            return 3;
        }
    }
    return 0 - 2;
}

pub fn blast_compute_bit_score_x100(raw_score: Int, lambda_x1000: Int, k_x1000: Int) -> Int {
    if raw_score <= 0 {
        return 0;
    }
    return (raw_score * lambda_x1000) / 693;
}

pub fn blast_compute_evalue_exponent(bit_score_x100: Int, search_space_eff: Int) -> Int {
    let bit_score: Int = bit_score_x100 / 100;
    let bit_reduction: Int = (bit_score * 100) / 332;
    if bit_score > 50 {
        return 0 - (bit_score - 30);
    }
    return 9 - bit_reduction;
}

pub fn scoring_matrix_blosum62() -> ScoringMatrixConfig {
    return ScoringMatrixConfig {
        matrix_id: 62,
        lambda_x1000: 267,
        k_param_x1000: 41
    };
}

pub fn blast_hsp_new(q_id: Int, s_id: Int, raw_s: Int, bit_s_x100: Int, e_exp: Int, id_pct: Int, aln_n: Int) -> BlastHsp {
    return BlastHsp {
        query_id: q_id,
        subject_id: s_id,
        raw_score: raw_s,
        bit_score_x100: bit_s_x100,
        evalue_exponent: e_exp,
        identity_pct: id_pct,
        aligned_n: aln_n
    };
}

pub fn blast_hsp_raw(h: BlastHsp) -> Int {
    return h.raw_score;
}

pub fn blast_hsp_bits(h: BlastHsp) -> Int {
    return h.bit_score_x100;
}
