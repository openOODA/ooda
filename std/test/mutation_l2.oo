// # Level 2 AST Mutation Testing Engine
//
// Logline: Generates Level 2 relational, arithmetic, logical, boundary offset, and dual-site 2x AST mutants to evaluate test suite resilience.
//
// Setup: Advanced mutation testing framework introducing multi-operator synthetic defects to enforce >= 95% kill rates.
//
// Beats:
//   1. Define L2Mutant, L2MutationScore, and L2CampaignConfig structures.
//   2. Generate Level 2 relational boundary inversions (< to <=, > to >=, == to !=).
//   3. Generate Level 2 arithmetic and logical inversions (+ to -, * to /, && to ||).
//   4. Apply boundary constant offsets (k -> k+1, k -> k-1, 0 -> -1).
//   5. Generate dual-site 2x compound mutations across multiple AST nodes.
//   6. Calculate Level 2 mutation score and enforce >= 95% gate threshold.
// RULES.oot 1.4: Pure data AST mutation testing.
// RULES.oot 1.7: Strictly under 256 lines.

pub type L2Mutant = struct {
    mutant_id: Int,
    kind: String,
    target_line: Int,
    original_expr: String,
    mutated_expr: String,
    is_killed: Bool,
    is_compound_2x: Bool
};

pub type L2MutationScore = struct {
    total_mutants: Int,
    killed_mutants: Int,
    surviving_mutants: Int,
    score_percentage: Int,
    is_l2_certified: Bool
};

pub type L2CampaignConfig = struct {
    target_score_percent: Int,
    enable_compound_2x: Bool,
    total_rounds: Int
};

pub fn l2_config_default() -> L2CampaignConfig { return L2CampaignConfig {
        target_score_percent: 95,
        enable_compound_2x: true,
        total_rounds: 500
    }; }

pub fn l2_mutant_new(id: Int, kind: String, line: Int, orig: String, mut_expr: String, is_2x: Bool) -> L2Mutant { return L2Mutant {
        mutant_id: id,
        kind: kind,
        target_line: line,
        original_expr: orig,
        mutated_expr: mut_expr,
        is_killed: false,
        is_compound_2x: is_2x
    }; }

pub fn l2_mutate_relational(op: String) -> String {
    if op == "<" { return "<="; }
    if op == "<=" { return "<"; }
    if op == ">" { return ">="; }
    if op == ">=" { return ">"; }
    if op == "==" { return "!="; }
    if op == "!=" { return "=="; }
    return op;
}

pub fn l2_mutate_arithmetic(op: String) -> String {
    if op == "+" { return "-"; }
    if op == "-" { return "+"; }
    if op == "*" { return "/"; }
    if op == "/" { return "*"; }
    if op == "%" { return "*"; }
    return op;
}

pub fn l2_mutate_logical(op: String) -> String {
    if op == "&&" { return "||"; }
    if op == "||" { return "&&"; }
    if op == "!" { return "id"; }
    return op;
}

pub fn l2_mutate_boundary_int(val: Int, offset_direction: Int) -> Int {
    if offset_direction > 0 {
        return val + 1;
    }
    if offset_direction < 0 {
        return val - 1;
    }
    let is_zero: Bool = val == 0;
    if is_zero {
        return -1;
    }
    return 0;
}

pub fn l2_mutate_compound_2x(id: Int, line: Int, orig_a: String, mut_a: String, orig_b: String, mut_b: String) -> L2Mutant {
    let combined_orig: String = orig_a + " ; " + orig_b;
    let combined_mut: String = mut_a + " ; " + mut_b;
    return L2Mutant {
        mutant_id: id,
        kind: "compound_2x",
        target_line: line,
        original_expr: combined_orig,
        mutated_expr: combined_mut,
        is_killed: false,
        is_compound_2x: true
    };
}

pub fn l2_calculate_score(total: Int, killed: Int) -> L2MutationScore {
    let mut score: Int = 0;
    if total > 0 {
        score = (killed * 100) / total;
    }
    let survived: Int = total - killed;
    let certified: Bool = score >= 95;
    return L2MutationScore {
        total_mutants: total,
        killed_mutants: killed,
        surviving_mutants: survived,
        score_percentage: score,
        is_l2_certified: certified
    };
}

pub fn l2_assert_gate_passed(score: L2MutationScore) -> Result[Bool, String] {
    let cert: Bool = score.is_l2_certified;
    if cert {
        return Ok(true);
    }
    return Err("L2 Mutation Gate Failed: Score below 95% threshold");
}

pub fn l2_run_campaign(cfg: L2CampaignConfig, killed_count: Int, total_count: Int) -> L2MutationScore {
    let score: L2MutationScore = l2_calculate_score(total_count, killed_count);
    return score;
}
