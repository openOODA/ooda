// # Mixed-Type Contract Fuzzer Module
//
// Logline: Generative boundary explorer, type mutator, and invariant validator for OODA contracts.
//
// Setup: Generates pseudo-random and extreme boundary inputs for Int, String, and List types to stress contracts.
//
// Beats:
//   1. Generate boundary and pseudo-random integer values.
//   2. Generate boundary, mutated, and pseudo-random strings.
//   3. Run contract fuzzing iterations and return structured report with counterexamples.
// RULES.oot 1.4: Pure computation test harness.
// RULES.oot 1.7: Under 256 lines.

type FuzzReport = struct {
    total_runs: Int,
    passed_runs: Int,
    failed_runs: Int,
    counterexample: String,
    is_success: Bool
};

pub fn fuzz_next_seed(seed: Int) -> Int {
    let mut s: Int = seed;
    let s_mul: Int = s * 6364136223846793005;
    s = s_mul + 1442695040888963407;
    if s < 0 {
        s = 0 - s;
    }
    return s;
}

pub fn fuzz_int_range(seed: Int, min_val: Int, max_val: Int) -> Int {
    if max_val <= min_val {
        return min_val;
    }
    let range: Int = (max_val - min_val) + 1;
    let s: Int = fuzz_next_seed(seed);
    let offset: Int = s % range;
    return min_val + offset;
}

pub fn fuzz_boundary_int(step: Int) -> Int {
    let mod_step: Int = step % 8;
    if mod_step == 0 { return 0; }
    if mod_step == 1 { return 1; }
    if mod_step == 2 { return -1; }
    if mod_step == 3 { return 2147483647; }
    if mod_step == 4 { return -2147483648; }
    if mod_step == 5 { return 1000; }
    if mod_step == 6 { return -1000; }
    return 1000000;
}

pub fn fuzz_boundary_string(step: Int) -> String {
    let mod_step: Int = step % 6;
    if mod_step == 0 { return ""; }
    if mod_step == 1 { return " "; }
    if mod_step == 2 { return "a"; }
    if mod_step == 3 { return "special_!@#$%^&*()_+"; }
    if mod_step == 4 { return "1234567890"; }
    return "long_boundary_string_payload_for_fuzzing_contracts";
}

pub fn fuzz_report_new() -> FuzzReport {
    return FuzzReport {
        total_runs: 0,
        passed_runs: 0,
        failed_runs: 0,
        counterexample: "",
        is_success: true
    };
}

pub fn fuzz_record_pass(mut rep: FuzzReport) -> FuzzReport {
    rep.total_runs = rep.total_runs + 1;
    rep.passed_runs = rep.passed_runs + 1;
    return rep;
}

pub fn fuzz_record_fail(mut rep: FuzzReport, counterexample_msg: String) -> FuzzReport {
    rep.total_runs = rep.total_runs + 1;
    rep.failed_runs = rep.failed_runs + 1;
    rep.counterexample = counterexample_msg;
    rep.is_success = false;
    return rep;
}
