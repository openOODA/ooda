// # 2D image convolution filters
//
// Logline: Applies Gaussian blur, Sobel edge, and Laplacian sharpen kernels to a packed pixel buffer.
//
// Setup: Pure. Pixels are List[Int] 0..255, row-major, width by height.
//
// Beats:
//   1. Clamp a neighbor coordinate to the image.
//   2. Convolve a 3x3 kernel at each pixel.
//   3. Run Gaussian, Sobel, and Laplacian kernels.
//   4. Clamp the result into 0..255.

fn im_at(px: List[Int], w: Int, h: Int, x: Int, y: Int) -> Int {
    let mut xx: Int = x;
    let mut yy: Int = y;
    if xx < 0 { xx = 0; }
    if yy < 0 { yy = 0; }
    if xx >= w { xx = w - 1; }
    if yy >= h { yy = h - 1; }
    return list_get(px, yy * w + xx);
}

fn im_clamp(v: Int) -> Int {
    if v < 0 { return 0; }
    if v > 255 { return 255; }
    return v;
}

fn im_conv(px: List[Int], w: Int, h: Int, k: List[Int], div: Int, add: Int) -> Result[List[Int], String] {
    if w < 1 { return Err("image w"); }
    if h < 1 { return Err("image h"); }
    if list_len(px) != w * h { return Err("image size"); }
    if list_len(k) != 9 { return Err("image kernel"); }
    if div == 0 { return Err("image div"); }
    let mut out: List[Int] = list_new();
    let mut y: Int = 0;
    while y < h {
        let mut x: Int = 0;
        while x < w {
            let mut acc: Int = 0;
            let mut j: Int = 0;
            while j < 3 {
                let mut i: Int = 0;
                while i < 3 {
                    let p: Int = im_at(px, w, h, x + i - 1, y + j - 1);
                    acc = acc + p * list_get(k, j * 3 + i);
                    i = i + 1;
                }
                j = j + 1;
            }
            out = list_push(out, im_clamp(acc / div + add));
            x = x + 1;
        }
        y = y + 1;
    }
    return Ok(out);
}

fn im_k(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Int) -> List[Int] {
    let mut k: List[Int] = list_new();
    k = list_push(k, a);
    k = list_push(k, b);
    k = list_push(k, c);
    k = list_push(k, d);
    k = list_push(k, e);
    k = list_push(k, f);
    k = list_push(k, g);
    k = list_push(k, h);
    k = list_push(k, i);
    return k;
}

pub fn image_filters_gaussian(px: List[Int], w: Int, h: Int) -> Result[List[Int], String] {
    return im_conv(px, w, h, im_k(1, 2, 1, 2, 4, 2, 1, 2, 1), 16, 0);
}

pub fn image_filters_sobel(px: List[Int], w: Int, h: Int) -> Result[List[Int], String] {
    let gx: Result[List[Int], String] = im_conv(px, w, h, im_k(0 - 1, 0, 1, 0 - 2, 0, 2, 0 - 1, 0, 1), 1, 0);
    match gx {
        Ok(sx) => {
            let gy: Result[List[Int], String] = im_conv(px, w, h, im_k(0 - 1, 0 - 2, 0 - 1, 0, 0, 0, 1, 2, 1), 1, 0);
            match gy {
                Ok(sy) => {
                    let mut out: List[Int] = list_new();
                    let mut i: Int = 0;
                    while i < list_len(sx) {
                        let ax: Int = list_get(sx, i);
                        let ay: Int = list_get(sy, i);
                        let mut a: Int = ax;
                        if a < 0 { a = 0 - a; }
                        let mut b: Int = ay;
                        if b < 0 { b = 0 - b; }
                        out = list_push(out, im_clamp(a + b));
                        i = i + 1;
                    }
                    return Ok(out);
                },
                Err(e) => { return Err(e); }
            }
        },
        Err(e) => { return Err(e); }
    }
}

pub fn image_filters_laplacian(px: List[Int], w: Int, h: Int) -> Result[List[Int], String] {
    return im_conv(px, w, h, im_k(0, 0 - 1, 0, 0 - 1, 5, 0 - 1, 0, 0 - 1, 0), 1, 0);
}
