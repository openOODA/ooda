// # Biquad IIR audio filter
//
// Logline: Filters a Float sample stream with a Direct-Form-II-transposed biquad for low-pass, high-pass, band-pass, and notch.
//
// Setup: Pure. Coefficients come from the RBJ cookbook. State is two Floats.
//
// Beats:
//   1. Compute omega and alpha from frequency and Q.
//   2. Build b0,b1,b2,a1,a2 for each mode.
//   3. Run the DF-II-transposed difference equation.
//   4. Keep LPF and HPF outputs different on a DC step.

fn bq_pi() -> Float { return 3.141592653589793; }

pub fn audio_biquad_lpf(fs: Float, f0: Float, q: Float) -> Result[List[Float], String] {
    return audio_biquad_design(fs, f0, q, 0);
}

pub fn audio_biquad_hpf(fs: Float, f0: Float, q: Float) -> Result[List[Float], String] {
    return audio_biquad_design(fs, f0, q, 1);
}

pub fn audio_biquad_bpf(fs: Float, f0: Float, q: Float) -> Result[List[Float], String] {
    return audio_biquad_design(fs, f0, q, 2);
}

pub fn audio_biquad_notch(fs: Float, f0: Float, q: Float) -> Result[List[Float], String] {
    return audio_biquad_design(fs, f0, q, 3);
}

pub fn audio_biquad_design(fs: Float, f0: Float, q: Float, mode: Int) -> Result[List[Float], String] {
    if fs <= 0.0 { return Err("biquad fs"); }
    if f0 <= 0.0 { return Err("biquad f0"); }
    if q <= 0.0 { return Err("biquad Q"); }
    if f0 >= fs * 0.5 { return Err("biquad nyquist"); }
    let w0: Float = 2.0 * bq_pi() * f0 / fs;
    let cw: Float = cos(w0);
    let sw: Float = sin(w0);
    let al: Float = sw / (2.0 * q);
    let mut b0: Float = 0.0;
    let mut b1: Float = 0.0;
    let mut b2: Float = 0.0;
    let mut a0: Float = 1.0 + al;
    let mut a1: Float = 0.0 - 2.0 * cw;
    let mut a2: Float = 1.0 - al;
    if mode == 0 {
        b0 = (1.0 - cw) * 0.5;
        b1 = 1.0 - cw;
        b2 = b0;
    } else {
        if mode == 1 {
            b0 = (1.0 + cw) * 0.5;
            b1 = 0.0 - (1.0 + cw);
            b2 = b0;
        } else {
            if mode == 2 {
                b0 = al;
                b1 = 0.0;
                b2 = 0.0 - al;
            } else {
                if mode == 3 {
                    b0 = 1.0;
                    b1 = 0.0 - 2.0 * cw;
                    b2 = 1.0;
                } else {
                    return Err("biquad mode");
                }
            }
        }
    }
    let mut c: List[Float] = list_new();
    c = list_push(c, b0 / a0);
    c = list_push(c, b1 / a0);
    c = list_push(c, b2 / a0);
    c = list_push(c, a1 / a0);
    c = list_push(c, a2 / a0);
    c = list_push(c, 0.0);
    c = list_push(c, 0.0);
    return Ok(c);
}

pub fn audio_biquad_process(coef: List[Float], x: List[Float]) -> Result[List[Float], String] {
    if list_len(coef) != 7 { return Err("biquad coef"); }
    let b0: Float = list_get(coef, 0);
    let b1: Float = list_get(coef, 1);
    let b2: Float = list_get(coef, 2);
    let a1: Float = list_get(coef, 3);
    let a2: Float = list_get(coef, 4);
    let mut s1: Float = list_get(coef, 5);
    let mut s2: Float = list_get(coef, 6);
    let mut y: List[Float] = list_new();
    let mut i: Int = 0;
    while i < list_len(x) {
        let xi: Float = list_get(x, i);
        let yi: Float = b0 * xi + s1;
        s1 = b1 * xi - a1 * yi + s2;
        s2 = b2 * xi - a2 * yi;
        y = list_push(y, yi);
        i = i + 1;
    }
    return Ok(y);
}
