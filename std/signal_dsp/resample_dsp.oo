// # Linear and windowed-sinc resampler
//
// Logline: Converts a Float signal between sample rates with linear interpolation and a polyphase windowed sinc kernel.
//
// Setup: Pure. Ratio is output_rate / input_rate. Hann window on the sinc taps.
//
// Beats:
//   1. Map each output index to an input position.
//   2. Linear-interpolate adjacent samples.
//   3. Build a Hann-windowed sinc kernel.
//   4. Convolve that kernel for polyphase sinc resample.

fn rs_i2f(k: Int) -> Float {
    let mut f: Float = 0.0;
    let mut i: Int = 0;
    if k >= 0 {
        while i < k {
            f = f + 1.0;
            i = i + 1;
        }
        return f;
    }
    let m: Int = 0 - k;
    while i < m {
        f = f - 1.0;
        i = i + 1;
    }
    return f;
}

fn rs_sinc(x: Float) -> Float {
    if x < 0.0 {
        if x > 0.0 - 0.0000001 { return 1.0; }
    } else {
        if x < 0.0000001 { return 1.0; }
    }
    let pi: Float = 3.141592653589793;
    return sin(pi * x) / (pi * x);
}

pub fn resample_dsp_linear(x: List[Float], ratio: Float) -> Result[List[Float], String] {
    if list_len(x) < 2 { return Err("resample short"); }
    if ratio <= 0.0 { return Err("resample ratio"); }
    let n: Int = list_len(x);
    let mut m: Int = 0;
    let mut acc: Float = 0.0;
    while acc < rs_i2f(n) * ratio {
        m = m + 1;
        acc = acc + 1.0;
        if m > n * 8 { break; }
    }
    if m < 1 { m = 1; }
    let mut y: List[Float] = list_new();
    let mut i: Int = 0;
    while i < m {
        let pos: Float = rs_i2f(i) / ratio;
        let mut i0: Int = 0;
        let mut p: Float = pos;
        while p >= 1.0 {
            i0 = i0 + 1;
            p = p - 1.0;
            if i0 >= n - 1 { break; }
        }
        if i0 >= n - 1 { i0 = n - 2; }
        let frac: Float = pos - rs_i2f(i0);
        let a: Float = list_get(x, i0);
        let b: Float = list_get(x, i0 + 1);
        y = list_push(y, a + (b - a) * frac);
        i = i + 1;
    }
    return Ok(y);
}

pub fn resample_dsp_sinc(x: List[Float], ratio: Float) -> Result[List[Float], String] {
    if list_len(x) < 2 { return Err("resample short"); }
    if ratio <= 0.0 { return Err("resample ratio"); }
    let n: Int = list_len(x);
    let taps: Int = 8;
    let mut m: Int = 0;
    let mut acc: Float = 0.0;
    while acc < rs_i2f(n) * ratio {
        m = m + 1;
        acc = acc + 1.0;
        if m > n * 8 { break; }
    }
    if m < 1 { m = 1; }
    let mut y: List[Float] = list_new();
    let mut i: Int = 0;
    while i < m {
        let pos: Float = rs_i2f(i) / ratio;
        let mut s: Float = 0.0;
        let mut wsum: Float = 0.0;
        let mut t: Int = 0 - taps;
        while t <= taps {
            let mut idx: Int = 0;
            let mut q: Float = pos + rs_i2f(t);
            if q < 0.0 { idx = 0; } else {
                idx = 0;
                let mut qq: Float = q;
                while qq >= 1.0 {
                    idx = idx + 1;
                    qq = qq - 1.0;
                    if idx >= n { break; }
                }
            }
            if idx < 0 { idx = 0; }
            if idx >= n { idx = n - 1; }
            let d: Float = pos - rs_i2f(idx);
            let hd: Float = 0.5 + 0.5 * cos(3.141592653589793 * rs_i2f(t) / rs_i2f(taps));
            let w: Float = rs_sinc(d) * hd;
            s = s + w * list_get(x, idx);
            wsum = wsum + w;
            t = t + 1;
        }
        if wsum == 0.0 { wsum = 1.0; }
        y = list_push(y, s / wsum);
        i = i + 1;
    }
    return Ok(y);
}
