// # BLS12-381 base-field 12-limb arithmetic
//
// Logline: Adds, subtracts, and multiplies 384-bit elements modulo the BLS12-381 prime, then reduces using 2^384.
//
// Setup: Pure. Twelve little-endian 32-bit limbs. Called from bls12_381.oo.
//
// Beats:
//   1. Schoolbook multiply to 24 limbs.
//   2. Fold the high half through 2^384 mod p.
//   3. Subtract p until the value is in 0..p-1.

import "std/zk_curves/bls12_381_fp_red.oo";

fn fp_p(i: Int) -> Int {
    if i == 0 { return 4294945451; }
    if i == 1 { return 3120496639; }
    if i == 2 { return 2975072255; }
    if i == 3 { return 514588670; }
    if i == 4 { return 4138792484; }
    if i == 5 { return 1731252896; }
    if i == 6 { return 4085584575; }
    if i == 7 { return 1685539716; }
    if i == 8 { return 1129032919; }
    if i == 9 { return 1260103606; }
    if i == 10 { return 964683418; }
    return 436277738;
}

fn fp_plist() -> List[Int] {
    let mut p: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 12 {
        p = list_push(p, fp_p(i));
        i = i + 1;
    }
    return p;
}

fn fp_mask(x: Int) -> Int {
    return x & 4294967295;
}

pub fn bls12_381_fp_one() -> List[Int] {
    let mut a: List[Int] = list_new();
    a = list_push(a, 1);
    let mut i: Int = 1;
    while i < 12 {
        a = list_push(a, 0);
        i = i + 1;
    }
    return a;
}

fn fp_ge(a: List[Int], b: List[Int]) -> Int {
    let mut i: Int = 11;
    while i >= 0 {
        if list_get(a, i) > list_get(b, i) {
            return 1;
        }
        if list_get(a, i) < list_get(b, i) {
            return 0;
        }
        i = i - 1;
    }
    return 1;
}

fn fp_sub12(a: List[Int], b: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut br: Int = 0;
    let mut i: Int = 0;
    while i < 12 {
        let mut t: Int = list_get(a, i) - list_get(b, i) - br;
        if t < 0 {
            t = t + 4294967296;
            br = 1;
        } else {
            br = 0;
        }
        out = list_push(out, fp_mask(t));
        i = i + 1;
    }
    return out;
}

fn fp_add12(a: List[Int], b: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut c: Int = 0;
    let mut i: Int = 0;
    while i < 12 {
        let t: Int = list_get(a, i) + list_get(b, i) + c;
        out = list_push(out, fp_mask(t));
        c = t >> 32;
        i = i + 1;
    }
    return out;
}

pub fn bls12_381_fp_add(a: List[Int], b: List[Int]) -> List[Int] {
    let s: List[Int] = fp_add12(a, b);
    let p: List[Int] = fp_plist();
    if fp_ge(s, p) > 0 {
        return fp_sub12(s, p);
    }
    return s;
}

pub fn bls12_381_fp_sub(a: List[Int], b: List[Int]) -> List[Int] {
    if fp_ge(a, b) > 0 {
        return fp_sub12(a, b);
    }
    let p: List[Int] = fp_plist();
    return fp_sub12(fp_add12(a, p), b);
}

pub fn bls12_381_fp_mul(a: List[Int], b: List[Int]) -> List[Int] {
    return bls12_381_fp_red_mul(a, b);
}

pub fn bls12_381_fp_eq(a: List[Int], b: List[Int]) -> Int {
    let mut i: Int = 0;
    while i < 12 {
        if list_get(a, i) != list_get(b, i) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

pub fn bls12_381_fp_is0(a: List[Int]) -> Int {
    let mut i: Int = 0;
    while i < 12 {
        if list_get(a, i) != 0 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}
