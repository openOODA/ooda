// # BLS12-381 Jacobian G1
//
// Logline: Adds, doubles, and scalar-multiplies G1 points on y^2 = x^3 + 4 over the 381-bit BLS prime.
//
// Setup: Pure. Coordinates are 12-limb field elements packed as 36 Ints. Infinity is Z = 0. Equality uses X and Y.
//
// Beats:
//   1. Load the standard G1 generator.
//   2. Double and add in Jacobian coordinates.
//   3. Scalar-multiply by double-and-add.
//   4. Compare affine X and Y so P is not treated as -P.

import "std/zk_curves/bls12_381_fp.oo";

pub type G1 = struct {
    flag: Int,
    err: String,
    x0: Int,
    y0: Int,
    z0: Int,
    limbs: List[Int]
};

fn g1_err(m: String) -> G1 {
    return G1 { flag: 0, err: "ERR\tbls: " + m, x0: 0, y0: 0, z0: 0, limbs: list_new() };
}

fn g1_box(L: List[Int]) -> G1 {
    return G1 { flag: 1, err: "", x0: list_get(L, 0), y0: list_get(L, 12), z0: list_get(L, 24), limbs: L };
}

fn g1_slice(L: List[Int], off: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 12 {
        o = list_push(o, list_get(L, off + i));
        i = i + 1;
    }
    return o;
}

fn g1_pack(x: List[Int], y: List[Int], z: List[Int]) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 12 {
        o = list_push(o, list_get(x, i));
        i = i + 1;
    }
    i = 0;
    while i < 12 {
        o = list_push(o, list_get(y, i));
        i = i + 1;
    }
    i = 0;
    while i < 12 {
        o = list_push(o, list_get(z, i));
        i = i + 1;
    }
    return o;
}

fn g1_xlimb(i: Int) -> Int {
    if i == 0 { return 3676489403; }
    if i == 1 { return 4214943754; }
    if i == 2 { return 4185529071; }
    if i == 3 { return 1817569343; }
    if i == 4 { return 387689560; }
    if i == 5 { return 2706258495; }
    if i == 6 { return 2541009157; }
    if i == 7 { return 3278408783; }
    if i == 8 { return 1336519695; }
    if i == 9 { return 647324556; }
    if i == 10 { return 832034708; }
    return 401724327;
}

fn g1_ylimb(i: Int) -> Int {
    if i == 0 { return 1187375073; }
    if i == 1 { return 212476713; }
    if i == 2 { return 2726857444; }
    if i == 3 { return 3493644100; }
    if i == 4 { return 738505709; }
    if i == 5 { return 14358731; }
    if i == 6 { return 3587181302; }
    if i == 7 { return 4243972245; }
    if i == 8 { return 1948093156; }
    if i == 9 { return 2694721773; }
    if i == 10 { return 3819610353; }
    return 146011265;
}

pub fn bls12_381_g1_gen() -> G1 {
    let mut x: List[Int] = list_new();
    let mut y: List[Int] = list_new();
    let z: List[Int] = bls12_381_fp_one();
    let mut i: Int = 0;
    while i < 12 {
        x = list_push(x, g1_xlimb(i));
        y = list_push(y, g1_ylimb(i));
        i = i + 1;
    }
    return g1_box(g1_pack(x, y, z));
}

pub fn bls12_381_g1_dbl(p: G1) -> G1 {
    let L: List[Int] = p.limbs;
    let x: List[Int] = g1_slice(L, 0);
    let y: List[Int] = g1_slice(L, 12);
    let z: List[Int] = g1_slice(L, 24);
    if bls12_381_fp_is0(z) > 0 {
        return g1_box(g1_pack(x, y, z));
    }
    let xx: List[Int] = bls12_381_fp_mul(x, x);
    let m: List[Int] = bls12_381_fp_add(bls12_381_fp_add(xx, xx), xx);
    let yy: List[Int] = bls12_381_fp_mul(y, y);
    let s: List[Int] = bls12_381_fp_mul(bls12_381_fp_add(bls12_381_fp_add(x, x), bls12_381_fp_add(x, x)), yy);
    let xr: List[Int] = bls12_381_fp_sub(bls12_381_fp_mul(m, m), bls12_381_fp_add(s, s));
    let y4: List[Int] = bls12_381_fp_mul(yy, yy);
    let y4x2: List[Int] = bls12_381_fp_add(y4, y4);
    let y4x4: List[Int] = bls12_381_fp_add(y4x2, y4x2);
    let eight: List[Int] = bls12_381_fp_add(y4x4, y4x4);
    let yr: List[Int] = bls12_381_fp_sub(bls12_381_fp_mul(m, bls12_381_fp_sub(s, xr)), eight);
    let zr: List[Int] = bls12_381_fp_mul(bls12_381_fp_add(y, y), z);
    return g1_box(g1_pack(xr, yr, zr));
}

pub fn bls12_381_g1_add(pa: G1, pb: G1) -> G1 {
    let A: List[Int] = pa.limbs;
    let B: List[Int] = pb.limbs;
    let z1: List[Int] = g1_slice(A, 24);
    let z2: List[Int] = g1_slice(B, 24);
    if bls12_381_fp_is0(z1) > 0 {
        return g1_box(B);
    }
    if bls12_381_fp_is0(z2) > 0 {
        return g1_box(A);
    }
    let x1: List[Int] = g1_slice(A, 0);
    let y1: List[Int] = g1_slice(A, 12);
    let x2: List[Int] = g1_slice(B, 0);
    let y2: List[Int] = g1_slice(B, 12);
    let z1z1: List[Int] = bls12_381_fp_mul(z1, z1);
    let z2z2: List[Int] = bls12_381_fp_mul(z2, z2);
    let u1: List[Int] = bls12_381_fp_mul(x1, z2z2);
    let u2: List[Int] = bls12_381_fp_mul(x2, z1z1);
    let s1: List[Int] = bls12_381_fp_mul(y1, bls12_381_fp_mul(z2, z2z2));
    let s2: List[Int] = bls12_381_fp_mul(y2, bls12_381_fp_mul(z1, z1z1));
    if bls12_381_fp_eq(u1, u2) > 0 {
        if bls12_381_fp_eq(s1, s2) > 0 {
            return bls12_381_g1_dbl(g1_box(A));
        }
        let mut z0: List[Int] = list_new();
        let mut i: Int = 0;
        while i < 12 {
            z0 = list_push(z0, 0);
            i = i + 1;
        }
        return g1_box(g1_pack(u1, s1, z0));
    }
    let h: List[Int] = bls12_381_fp_sub(u2, u1);
    let r: List[Int] = bls12_381_fp_sub(s2, s1);
    let hh: List[Int] = bls12_381_fp_mul(h, h);
    let hhh: List[Int] = bls12_381_fp_mul(hh, h);
    let xr: List[Int] = bls12_381_fp_sub(bls12_381_fp_sub(bls12_381_fp_mul(r, r), hhh), bls12_381_fp_add(bls12_381_fp_mul(u1, hh), bls12_381_fp_mul(u1, hh)));
    let yr: List[Int] = bls12_381_fp_sub(bls12_381_fp_mul(r, bls12_381_fp_sub(bls12_381_fp_mul(u1, hh), xr)), bls12_381_fp_mul(s1, hhh));
    let zr: List[Int] = bls12_381_fp_mul(h, bls12_381_fp_mul(z1, z2));
    return g1_box(g1_pack(xr, yr, zr));
}

pub fn bls12_381_g1_mul(pt: G1, k: Int) -> G1 {
    if k < 0 {
        return g1_err("scalar");
    }
    let g: G1 = bls12_381_g1_gen();
    let mut acc: List[Int] = g.limbs;
    let mut z0: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 12 {
        z0 = list_push(z0, 0);
        i = i + 1;
    }
    acc = g1_pack(g1_slice(acc, 0), g1_slice(acc, 12), z0);
    let mut cur: G1 = pt;
    let mut n: Int = k;
    while n > 0 {
        if (n & 1) == 1 {
            let a: G1 = bls12_381_g1_add(g1_box(acc), cur);
            acc = a.limbs;
        }
        cur = bls12_381_g1_dbl(cur);
        n = n / 2;
    }
    return g1_box(acc);
}

pub fn bls12_381_g1_eq(pa: G1, pb: G1) -> Result[Int, String] {
    let A: List[Int] = pa.limbs;
    let B: List[Int] = pb.limbs;
    let z1: List[Int] = g1_slice(A, 24);
    let z2: List[Int] = g1_slice(B, 24);
    if bls12_381_fp_is0(z1) > 0 {
        if bls12_381_fp_is0(z2) > 0 {
            return Ok(1);
        }
        return Err("ERR\tbls: inf");
    }
    if bls12_381_fp_is0(z2) > 0 {
        return Err("ERR\tbls: inf");
    }
    let x1: List[Int] = g1_slice(A, 0);
    let y1: List[Int] = g1_slice(A, 12);
    let x2: List[Int] = g1_slice(B, 0);
    let y2: List[Int] = g1_slice(B, 12);
    let z1z1: List[Int] = bls12_381_fp_mul(z1, z1);
    let z2z2: List[Int] = bls12_381_fp_mul(z2, z2);
    if bls12_381_fp_eq(bls12_381_fp_mul(x1, z2z2), bls12_381_fp_mul(x2, z1z1)) < 1 {
        return Err("ERR\tbls: x");
    }
    if bls12_381_fp_eq(bls12_381_fp_mul(y1, bls12_381_fp_mul(z2, z2z2)), bls12_381_fp_mul(y2, bls12_381_fp_mul(z1, z1z1))) < 1 {
        return Err("ERR\tbls: y");
    }
    return Ok(1);
}

pub fn bls12_381_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn bls12_381_flag(o: G1) -> Int {
    return o.flag;
}
pub fn bls12_381_err(o: G1) -> String {
    return o.err;
}
