// # LRU cache with hash index
//
// Logline: Puts and gets integer keys in O(1) with a hash table and a doubly linked list, and evicts the least-recent entry at capacity.
//
// Setup: Pure. Pack is List[Int]. Head is most recent. Tail is least recent.
//
// Beats:
//   1. Probe a power-of-two hash table for the node index.
//   2. Move a hit to the head of the list.
//   3. Insert a new node at the head.
//   4. Evict the tail when the cache is full.

fn lru_hsize(cap: Int) -> Int {
    let mut s: Int = 8;
    while s < cap * 4 { s = s * 2; }
    return s;
}

pub fn lru_cache_new(cap: Int) -> Result[List[Int], String] {
    if cap < 1 { return Err("lru cap"); }
    let hs: Int = lru_hsize(cap);
    let mut o: List[Int] = list_new();
    o = list_push(o, cap);
    o = list_push(o, 0);
    o = list_push(o, 0 - 1);
    o = list_push(o, 0 - 1);
    o = list_push(o, hs);
    let mut i: Int = 0;
    while i < hs {
        o = list_push(o, 0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < cap {
        o = list_push(o, 0);
        o = list_push(o, 0);
        o = list_push(o, 0 - 1);
        o = list_push(o, 0 - 1);
        i = i + 1;
    }
    return Ok(o);
}

fn lru_base(c: List[Int]) -> Int { return 5 + list_get(c, 4); }

fn lru_hash(c: List[Int], key: Int) -> Int {
    let hs: Int = list_get(c, 4);
    let mut h: Int = key * 2654435761;
    if h < 0 { h = 0 - h; }
    return h % hs;
}

fn lru_find(c: List[Int], key: Int) -> Int {
    let hs: Int = list_get(c, 4);
    let mut i: Int = lru_hash(c, key);
    let mut n: Int = 0;
    while n < hs {
        let sl: Int = list_get(c, 5 + i);
        if sl == 0 - 1 { return 0 - 1; }
        if sl >= 0 {
            let b: Int = lru_base(c) + sl * 4;
            if list_get(c, b) == key { return sl; }
        }
        i = (i + 1) % hs;
        n = n + 1;
    }
    return 0 - 1;
}

fn lru_detach(c: List[Int], sl: Int) -> List[Int] {
    let mut o: List[Int] = c;
    let b: Int = lru_base(o) + sl * 4;
    let p: Int = list_get(o, b + 2);
    let nx: Int = list_get(o, b + 3);
    if p >= 0 {
        let pb: Int = lru_base(o) + p * 4;
        o = list_set(o, pb + 3, nx);
    } else {
        o = list_set(o, 2, nx);
    }
    if nx >= 0 {
        let nb: Int = lru_base(o) + nx * 4;
        o = list_set(o, nb + 2, p);
    } else {
        o = list_set(o, 3, p);
    }
    return o;
}

fn lru_attach_head(c: List[Int], sl: Int) -> List[Int] {
    let mut o: List[Int] = c;
    let b: Int = lru_base(o) + sl * 4;
    let h: Int = list_get(o, 2);
    o = list_set(o, b + 2, 0 - 1);
    o = list_set(o, b + 3, h);
    if h >= 0 {
        let hb: Int = lru_base(o) + h * 4;
        o = list_set(o, hb + 2, sl);
    } else {
        o = list_set(o, 3, sl);
    }
    o = list_set(o, 2, sl);
    return o;
}

fn lru_to_head(c: List[Int], sl: Int) -> List[Int] {
    return lru_attach_head(lru_detach(c, sl), sl);
}

fn lru_place(c: List[Int], key: Int, sl: Int) -> List[Int] {
    let hs: Int = list_get(c, 4);
    let mut i: Int = lru_hash(c, key);
    let mut n: Int = 0;
    while n < hs {
        let cur: Int = list_get(c, 5 + i);
        if cur < 0 { return list_set(c, 5 + i, sl); }
        i = (i + 1) % hs;
        n = n + 1;
    }
    return c;
}

fn lru_unplace(c: List[Int], key: Int) -> List[Int] {
    let hs: Int = list_get(c, 4);
    let mut i: Int = lru_hash(c, key);
    let mut n: Int = 0;
    while n < hs {
        let sl: Int = list_get(c, 5 + i);
        if sl == 0 - 1 { return c; }
        if sl >= 0 {
            let b: Int = lru_base(c) + sl * 4;
            if list_get(c, b) == key { return list_set(c, 5 + i, 0 - 2); }
        }
        i = (i + 1) % hs;
        n = n + 1;
    }
    return c;
}

pub fn lru_cache_get(c: List[Int], key: Int) -> Result[List[Int], String] {
    let sl: Int = lru_find(c, key);
    if sl < 0 { return Err("lru missing"); }
    let b: Int = lru_base(c) + sl * 4;
    let val: Int = list_get(c, b + 1);
    let mut o: List[Int] = lru_to_head(c, sl);
    let mut rec: List[Int] = list_new();
    rec = list_push(rec, val);
    let mut i: Int = 0;
    while i < list_len(o) {
        rec = list_push(rec, list_get(o, i));
        i = i + 1;
    }
    return Ok(rec);
}

pub fn lru_cache_put(c: List[Int], key: Int, val: Int) -> Result[List[Int], String] {
    let hit: Int = lru_find(c, key);
    if hit >= 0 {
        let b: Int = lru_base(c) + hit * 4;
        let mut o: List[Int] = list_set(c, b + 1, val);
        o = lru_to_head(o, hit);
        return Ok(o);
    }
    let cap: Int = list_get(c, 0);
    let mut o: List[Int] = c;
    let mut sl: Int = list_get(o, 1);
    if sl >= cap {
        let tail: Int = list_get(o, 3);
        if tail < 0 { return Err("lru tail"); }
        let tb: Int = lru_base(o) + tail * 4;
        let oldk: Int = list_get(o, tb);
        o = lru_unplace(o, oldk);
        o = lru_detach(o, tail);
        sl = tail;
        o = list_set(o, 1, list_get(o, 1) - 1);
    }
    let b: Int = lru_base(o) + sl * 4;
    o = list_set(o, b, key);
    o = list_set(o, b + 1, val);
    o = list_set(o, b + 2, 0 - 1);
    o = list_set(o, b + 3, 0 - 1);
    o = lru_place(o, key, sl);
    o = list_set(o, 1, list_get(o, 1) + 1);
    o = lru_attach_head(o, sl);
    return Ok(o);
}

pub fn lru_cache_has(c: List[Int], key: Int) -> Bool {
    if lru_find(c, key) < 0 { return false; }
    return true;
}
