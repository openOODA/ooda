// # Bloom filter with Murmur3
//
// Logline: Tests set membership with a MurmurHash3 bit array and never reports an inserted key as absent.
//
// Setup: Pure. Keys are Int. Bits pack in 32-bit words as List[Int].
//
// Beats:
//   1. Mix a 4-byte key with MurmurHash3_32.
//   2. Set k bits from independent seeds.
//   3. Probe those bits on lookup.
//   4. Refuse a bad size or hash count.

fn bf_mask(x: Int) -> Int { return x & 4294967295; }

fn bf_rotl(x: Int, r: Int) -> Int {
    let v: Int = bf_mask(x);
    return bf_mask((v << r) | (v >> (32 - r)));
}

pub fn bloom_filter_murmur3(key: Int, seed: Int) -> Int {
    let mut k: Int = bf_mask(key);
    k = bf_mask(k * 3432918353);
    k = bf_rotl(k, 15);
    k = bf_mask(k * 461845907);
    let mut h: Int = bf_mask(seed) ^ k;
    h = bf_rotl(h, 13);
    h = bf_mask(h * 5 + 3864294244);
    h = h ^ 4;
    h = h ^ (h >> 16);
    h = bf_mask(h * 2246822507);
    h = h ^ (h >> 13);
    h = bf_mask(h * 3266489909);
    h = h ^ (h >> 16);
    return bf_mask(h);
}

pub fn bloom_filter_new(mbits: Int, k: Int) -> Result[List[Int], String] {
    if mbits < 8 { return Err("bloom m"); }
    if k < 1 { return Err("bloom k"); }
    if k > 16 { return Err("bloom k"); }
    let words: Int = (mbits + 31) / 32;
    let mut bf: List[Int] = list_new();
    bf = list_push(bf, mbits);
    bf = list_push(bf, k);
    let mut i: Int = 0;
    while i < words {
        bf = list_push(bf, 0);
        i = i + 1;
    }
    return Ok(bf);
}

fn bf_bit(bf: List[Int], key: Int, hi: Int) -> Int {
    let m: Int = list_get(bf, 0);
    let h: Int = bloom_filter_murmur3(key, 2654435761 + hi * 9749);
    let mut idx: Int = h % m;
    if idx < 0 { idx = 0 - idx; }
    return idx % m;
}

pub fn bloom_filter_add(bf: List[Int], key: Int) -> Result[List[Int], String] {
    if list_len(bf) < 3 { return Err("bloom short"); }
    let k: Int = list_get(bf, 1);
    let mut o: List[Int] = bf;
    let mut hi: Int = 0;
    while hi < k {
        let idx: Int = bf_bit(o, key, hi);
        let w: Int = 2 + idx / 32;
        let b: Int = idx % 32;
        let cur: Int = list_get(o, w);
        o = list_set(o, w, cur | (1 << b));
        hi = hi + 1;
    }
    return Ok(o);
}

pub fn bloom_filter_has(bf: List[Int], key: Int) -> Result[Bool, String] {
    if list_len(bf) < 3 { return Err("bloom short"); }
    let k: Int = list_get(bf, 1);
    let mut hi: Int = 0;
    while hi < k {
        let idx: Int = bf_bit(bf, key, hi);
        let w: Int = 2 + idx / 32;
        let b: Int = idx % 32;
        if (list_get(bf, w) & (1 << b)) == 0 { return Ok(false); }
        hi = hi + 1;
    }
    return Ok(true);
}
