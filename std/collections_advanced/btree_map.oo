// # B-tree key-value map
//
// Logline: Inserts, looks up, and range-walks integer keys in a B-tree that splits full nodes.
//
// Setup: Pure. Order t=2 so a node holds at most 3 keys. Tree packs as List[Int].
//
// Beats:
//   1. Allocate a leaf root.
//   2. Split a full child and push the median up.
//   3. Insert into a non-full node, descending by key.
//   4. Search and inorder-range visit keys in order.

fn bt_str() -> Int { return 12; }

fn bt_get(t: List[Int], ni: Int, off: Int) -> Int {
    return list_get(t, 2 + ni * 12 + off);
}

fn bt_set(t: List[Int], ni: Int, off: Int, v: Int) -> List[Int] {
    return list_set(t, 2 + ni * 12 + off, v);
}

fn bt_alloc(t: List[Int]) -> List[Int] {
    let mut o: List[Int] = t;
    let n: Int = list_get(o, 1);
    let mut k: Int = 0;
    while k < 12 {
        o = list_push(o, 0);
        k = k + 1;
    }
    o = list_set(o, 1, n + 1);
    o = bt_set(o, n, 0, 1);
    o = bt_set(o, n, 8, 0 - 1);
    o = bt_set(o, n, 9, 0 - 1);
    o = bt_set(o, n, 10, 0 - 1);
    o = bt_set(o, n, 11, 0 - 1);
    return o;
}

pub fn btree_map_new() -> List[Int] {
    let mut t: List[Int] = list_new();
    t = list_push(t, 0);
    t = list_push(t, 0);
    t = bt_alloc(t);
    t = list_set(t, 0, 0);
    return t;
}

fn bt_split(t: List[Int], x: Int, i: Int) -> List[Int] {
    let mut o: List[Int] = bt_alloc(t);
    let z: Int = list_get(o, 1) - 1;
    let y: Int = bt_get(o, x, 8 + i);
    o = bt_set(o, z, 0, bt_get(o, y, 0));
    o = bt_set(o, z, 1, 1);
    o = bt_set(o, z, 2, bt_get(o, y, 4));
    o = bt_set(o, z, 5, bt_get(o, y, 7));
    o = bt_set(o, z, 8, bt_get(o, y, 10));
    o = bt_set(o, z, 9, bt_get(o, y, 11));
    o = bt_set(o, y, 1, 1);
    let xn: Int = bt_get(o, x, 1);
    let mut j: Int = xn;
    while j >= i + 1 {
        o = bt_set(o, x, 8 + j + 1, bt_get(o, x, 8 + j));
        j = j - 1;
    }
    o = bt_set(o, x, 8 + i + 1, z);
    j = xn - 1;
    while j >= i {
        o = bt_set(o, x, 2 + j + 1, bt_get(o, x, 2 + j));
        o = bt_set(o, x, 5 + j + 1, bt_get(o, x, 5 + j));
        j = j - 1;
    }
    o = bt_set(o, x, 2 + i, bt_get(o, y, 3));
    o = bt_set(o, x, 5 + i, bt_get(o, y, 6));
    o = bt_set(o, x, 1, xn + 1);
    return o;
}

fn bt_ins_nf(t: List[Int], x: Int, key: Int, val: Int) -> List[Int] {
    let mut o: List[Int] = t;
    let mut i: Int = bt_get(o, x, 1) - 1;
    if bt_get(o, x, 0) == 1 {
        while i >= 0 {
            if key >= bt_get(o, x, 2 + i) { break; }
            o = bt_set(o, x, 2 + i + 1, bt_get(o, x, 2 + i));
            o = bt_set(o, x, 5 + i + 1, bt_get(o, x, 5 + i));
            i = i - 1;
        }
        o = bt_set(o, x, 2 + i + 1, key);
        o = bt_set(o, x, 5 + i + 1, val);
        o = bt_set(o, x, 1, bt_get(o, x, 1) + 1);
        return o;
    }
    while i >= 0 {
        if key >= bt_get(o, x, 2 + i) { break; }
        i = i - 1;
    }
    i = i + 1;
    let ch: Int = bt_get(o, x, 8 + i);
    if bt_get(o, ch, 1) == 3 {
        o = bt_split(o, x, i);
        if key > bt_get(o, x, 2 + i) { i = i + 1; }
    }
    return bt_ins_nf(o, bt_get(o, x, 8 + i), key, val);
}

pub fn btree_map_put(tree: List[Int], key: Int, val: Int) -> Result[List[Int], String] {
    let r: Int = list_get(tree, 0);
    if bt_get(tree, r, 1) == 3 {
        let mut o: List[Int] = bt_alloc(tree);
        let s: Int = list_get(o, 1) - 1;
        o = bt_set(o, s, 0, 0);
        o = bt_set(o, s, 1, 0);
        o = bt_set(o, s, 8, r);
        o = list_set(o, 0, s);
        o = bt_split(o, s, 0);
        o = bt_ins_nf(o, s, key, val);
        return Ok(o);
    }
    return Ok(bt_ins_nf(tree, r, key, val));
}

pub fn btree_map_get(tree: List[Int], key: Int) -> Result[Int, String] {
    let mut x: Int = list_get(tree, 0);
    while true {
        let n: Int = bt_get(tree, x, 1);
        let mut i: Int = 0;
        while i < n {
            let k: Int = bt_get(tree, x, 2 + i);
            if key == k { return Ok(bt_get(tree, x, 5 + i)); }
            if key < k { break; }
            i = i + 1;
        }
        if bt_get(tree, x, 0) == 1 { return Err("btree missing"); }
        x = bt_get(tree, x, 8 + i);
        if x < 0 { return Err("btree missing"); }
    }
    return Err("btree missing");
}

pub fn btree_map_range(tree: List[Int], lo: Int, hi: Int) -> Result[List[Int], String] {
    let mut out: List[Int] = list_new();
    out = bt_walk(tree, list_get(tree, 0), lo, hi, out);
    return Ok(out);
}

fn bt_walk(tree: List[Int], x: Int, lo: Int, hi: Int, acc: List[Int]) -> List[Int] {
    if x < 0 { return acc; }
    let n: Int = bt_get(tree, x, 1);
    let mut i: Int = 0;
    let mut o: List[Int] = acc;
    while i < n {
        if bt_get(tree, x, 0) == 0 {
            o = bt_walk(tree, bt_get(tree, x, 8 + i), lo, hi, o);
        }
        let k: Int = bt_get(tree, x, 2 + i);
        if k >= lo {
            if k <= hi { o = list_push(o, k); }
        }
        i = i + 1;
    }
    if bt_get(tree, x, 0) == 0 {
        o = bt_walk(tree, bt_get(tree, x, 8 + n), lo, hi, o);
    }
    return o;
}
