// # Skip list ordered map
//
// Logline: Inserts, searches, and range-scans integer keys on a multi-level skip list with deterministic height.
//
// Setup: Pure. Max 8 levels. Height comes from an LCG seed, not a live coin.
//
// Beats:
//   1. Draw a height from the packed seed.
//   2. Walk forward pointers from the top level.
//   3. Splice a new node at each chosen level.
//   4. Range-walk the bottom list in key order.

fn sl_max() -> Int { return 8; }

pub fn skip_list_new() -> List[Int] {
    let mut o: List[Int] = list_new();
    o = list_push(o, 12345);
    o = list_push(o, 1);
    o = list_push(o, 0);
    let mut i: Int = 0;
    while i < 8 {
        o = list_push(o, 0 - 1);
        i = i + 1;
    }
    return o;
}

fn sl_lcg(s: Int) -> Int {
    return (s * 1103515245 + 12345) & 2147483647;
}

fn sl_draw(t: List[Int]) -> List[Int] {
    let mut s: Int = list_get(t, 0);
    let mut h: Int = 1;
    while h < 8 {
        s = sl_lcg(s);
        if (s & 3) != 0 { break; }
        h = h + 1;
    }
    let mut o: List[Int] = list_set(t, 0, s);
    if h > list_get(o, 1) { o = list_set(o, 1, h); }
    let mut rec: List[Int] = list_new();
    rec = list_push(rec, h);
    let mut i: Int = 0;
    while i < list_len(o) {
        rec = list_push(rec, list_get(o, i));
        i = i + 1;
    }
    return rec;
}

fn sl_hdr() -> Int { return 3; }

fn sl_node_at(t: List[Int], idx: Int) -> Int {
    return 11 + idx * 11;
}

fn sl_fwd(t: List[Int], node: Int, lvl: Int) -> Int {
    if node < 0 { return list_get(t, sl_hdr() + lvl); }
    return list_get(t, sl_node_at(t, node) + 3 + lvl);
}

fn sl_set_fwd(t: List[Int], node: Int, lvl: Int, v: Int) -> List[Int] {
    if node < 0 { return list_set(t, sl_hdr() + lvl, v); }
    return list_set(t, sl_node_at(t, node) + 3 + lvl, v);
}

fn sl_key(t: List[Int], node: Int) -> Int {
    return list_get(t, sl_node_at(t, node));
}

pub fn skip_list_get(t: List[Int], key: Int) -> Result[Int, String] {
    let mut x: Int = 0 - 1;
    let mut lvl: Int = 7;
    while lvl >= 0 {
        let mut nx: Int = sl_fwd(t, x, lvl);
        while nx >= 0 {
            if sl_key(t, nx) >= key { break; }
            x = nx;
            nx = sl_fwd(t, x, lvl);
        }
        if nx >= 0 {
            if sl_key(t, nx) == key { return Ok(list_get(t, sl_node_at(t, nx) + 1)); }
        }
        lvl = lvl - 1;
    }
    return Err("skip missing");
}

pub fn skip_list_put(t: List[Int], key: Int, val: Int) -> Result[List[Int], String] {
    let hit: Result[Int, String] = skip_list_get(t, key);
    match hit {
        Ok(v) => { return Err("skip dup " + v.to_string()); },
        Err(e) => {
            if e != "skip missing" { return Err(e); }
        }
    }
    let packed: List[Int] = sl_draw(t);
    let h: Int = list_get(packed, 0);
    let mut o: List[Int] = list_new();
    let mut pi: Int = 1;
    while pi < list_len(packed) {
        o = list_push(o, list_get(packed, pi));
        pi = pi + 1;
    }
    let n: Int = list_get(o, 2);
    let mut k: Int = 0;
    while k < 11 {
        o = list_push(o, 0 - 1);
        k = k + 1;
    }
    let base: Int = sl_node_at(o, n);
    o = list_set(o, base, key);
    o = list_set(o, base + 1, val);
    o = list_set(o, base + 2, h);
    let mut upd: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 8 {
        upd = list_push(upd, 0 - 1);
        i = i + 1;
    }
    let mut x: Int = 0 - 1;
    let mut lvl: Int = 7;
    while lvl >= 0 {
        let mut nx: Int = sl_fwd(o, x, lvl);
        while nx >= 0 {
            if sl_key(o, nx) >= key { break; }
            x = nx;
            nx = sl_fwd(o, x, lvl);
        }
        upd = list_set(upd, lvl, x);
        lvl = lvl - 1;
    }
    i = 0;
    while i < h {
        let pred: Int = list_get(upd, i);
        let old: Int = sl_fwd(o, pred, i);
        o = sl_set_fwd(o, n, i, old);
        o = sl_set_fwd(o, pred, i, n);
        i = i + 1;
    }
    o = list_set(o, 2, n + 1);
    return Ok(o);
}

pub fn skip_list_range(t: List[Int], lo: Int, hi: Int) -> Result[List[Int], String] {
    let mut x: Int = 0 - 1;
    let mut lvl: Int = 7;
    while lvl >= 0 {
        let mut nx: Int = sl_fwd(t, x, lvl);
        while nx >= 0 {
            if sl_key(t, nx) >= lo { break; }
            x = nx;
            nx = sl_fwd(t, x, lvl);
        }
        lvl = lvl - 1;
    }
    let mut out: List[Int] = list_new();
    let mut n: Int = sl_fwd(t, x, 0);
    while n >= 0 {
        let k: Int = sl_key(t, n);
        if k > hi { break; }
        if k >= lo { out = list_push(out, k); }
        n = sl_fwd(t, n, 0);
    }
    return Ok(out);
}
