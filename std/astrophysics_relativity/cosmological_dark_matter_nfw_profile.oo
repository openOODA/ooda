// # Navarro-Frenk-White (NFW) Dark Matter Halo Profile
//
// Logline: rho = rho0 / (x (1+x)^2); f(x) = ln(1+x) - x/(1+x). Int destub.
//
// Setup: x = r / r_s in milli. Flattened halo point.
//
// Beats:
//   1. Density over rho0 at x: 1 / (x (1+x)^2).
//   2. Mass function f via integer ln(1+x).
//   3. r_s = R_200 / c; virial flag r <= R_200.

type NfwHaloPoint = struct {
    radius: Int,
    r_scale: Int,
    x_milli: Int,
    density_milli: Int,
    f_milli: Int,
    flag_bits: Int
};

fn nfw_iln_milli(n: Int) -> Int {
    if n <= 1 {
        return 0;
    }
    let mut v: Int = n * 1000;
    let mut exp2: Int = 0;
    while v >= 2000 {
        v = v / 2;
        exp2 = exp2 + 1;
    }
    let um: Int = ((v - 1000) * 1000) / (v + 1000);
    let u2: Int = (um * um) / 1000;
    let u3: Int = (u2 * um) / 1000;
    let u5: Int = (u3 * u2) / 1000;
    let u7: Int = (u5 * u2) / 1000;
    let ln_mant: Int = 2 * (um + (u3 / 3) + (u5 / 5) + (u7 / 7));
    return (exp2 * 693) + ln_mant;
}

pub fn nfw_density_over_rho0_milli(x_milli: Int) -> Int {
    if x_milli <= 0 {
        return 0;
    }
    let one_plus: Int = 1000 + x_milli;
    let denom: Int = x_milli * one_plus * one_plus;
    if denom <= 0 {
        return 0;
    }
    return 1000000000000 / denom;
}

pub fn nfw_mass_function_f(x_milli: Int) -> Int {
    if x_milli <= 0 {
        return 0;
    }
    let one_plus: Int = 1000 + x_milli;
    let ln_term: Int = nfw_iln_milli(one_plus) - nfw_iln_milli(1000);
    let frac: Int = (x_milli * 1000) / one_plus;
    if ln_term > frac {
        return ln_term - frac;
    }
    return 0;
}

pub fn nfw_halo_point_evaluate(
    radius: Int,
    virial_radius: Int,
    concentration: Int
) -> NfwHaloPoint {
    let mut c: Int = concentration;
    if c < 1 {
        c = 1;
    }
    if virial_radius <= 0 {
        return NfwHaloPoint {
            radius: radius,
            r_scale: 0,
            x_milli: 0,
            density_milli: 0,
            f_milli: 0,
            flag_bits: 0
        };
    }
    let r_s: Int = virial_radius / c;
    if r_s <= 0 {
        return NfwHaloPoint {
            radius: radius,
            r_scale: 0,
            x_milli: 0,
            density_milli: 0,
            f_milli: 0,
            flag_bits: 0
        };
    }
    if radius <= 0 {
        return NfwHaloPoint {
            radius: radius,
            r_scale: r_s,
            x_milli: 0,
            density_milli: 0,
            f_milli: 0,
            flag_bits: 0
        };
    }
    let x_milli: Int = (radius * 1000) / r_s;
    let dens: Int = nfw_density_over_rho0_milli(x_milli);
    let f_m: Int = nfw_mass_function_f(x_milli);
    let mut vir: Int = 0;
    if radius <= virial_radius {
        vir = 1;
    }
    return NfwHaloPoint {
        radius: radius,
        r_scale: r_s,
        x_milli: x_milli,
        density_milli: dens,
        f_milli: f_m,
        flag_bits: 1 + (vir * 2)
    };
}

pub fn nfw_density(p: NfwHaloPoint) -> Int {
    return p.density_milli;
}

pub fn nfw_flags(p: NfwHaloPoint) -> Int {
    return p.flag_bits;
}
