// # Chandrasekhar Mass Limit & Electron Degeneracy
//
// Logline: M_Ch = 5.83 / mu_e^2 M_sun. Int destub (milli-solar).
//
// Setup: Zero-temperature Fermi-gas white-dwarf limit.
//
// Beats:
//   1. M_Ch_milli = 5830 / mu_e^2.
//   2. Carbon-oxygen WD uses mu_e = 2.
//   3. Relativistic flag when density >= 1000 (1e9 kg/m^3 units).

type DegeneracyState = struct {
    density: Int,
    mu_e: Int,
    chandra_milli: Int,
    flag_bits: Int
};

pub fn chandrasekhar_mass_limit_milli(mu_e: Int) -> Int {
    if mu_e <= 0 {
        return 0;
    }
    return 5830 / (mu_e * mu_e);
}

pub fn chandrasekhar_mass_carbon_oxygen() -> Int {
    return chandrasekhar_mass_limit_milli(2);
}

pub fn degenerate_electron_pressure(density: Int, mu_e: Int) -> DegeneracyState {
    let ch: Int = chandrasekhar_mass_limit_milli(mu_e);
    let mut rel: Int = 0;
    if density >= 1000 {
        rel = 1;
    }
    let mut valid: Int = 0;
    if mu_e > 0 {
        if density > 0 {
            valid = 1;
        }
    }
    return DegeneracyState {
        density: density,
        mu_e: mu_e,
        chandra_milli: ch,
        flag_bits: valid + (rel * 2)
    };
}

pub fn chandrasekhar_milli(s: DegeneracyState) -> Int {
    return s.chandra_milli;
}

pub fn chandrasekhar_flags(s: DegeneracyState) -> Int {
    return s.flag_bits;
}
