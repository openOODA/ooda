// # Cosmic Inflation Slow-Roll Dynamics & Primordial Perturbations
//
// Logline: Calculates potential slow-roll parameters (epsilon, eta), e-folding number N, scalar spectral index n_s, and tensor-to-scalar ratio r.
//
// Setup: Solves single-field slow-roll inflation dynamics in the reduced Planck mass M_Pl = sqrt(hbar*c / (8*pi*G)) framework.
//
// Beats:
//   1. Compute potential slow-roll parameters epsilon_V = 0.5 * (M_Pl * V' / V)^2 and eta_V = M_Pl^2 * V'' / V.
//   2. Calculate primordial scalar tilt n_s = 1 - 6*epsilon_V + 2*eta_V and tensor-to-scalar ratio r = 16*epsilon_V.
//   3. Implement quadratic chaotic (m^2 phi^2) and Starobinsky R^2 plateau (V_0 * (1 - exp(-sqrt(2/3)*phi/M_Pl))^2) inflation models.

import "./astro_rel_constants.oo";

pub type InflationObservables = struct {
    num_efolds_n: Float,
    slow_roll_epsilon: Float,
    slow_roll_eta: Float,
    spectral_index_ns: Float,
    tensor_to_scalar_r: Float,
    is_slow_roll_valid: Bool,
};

pub fn inflation_starobinsky_model(num_efolds_n: Float) -> InflationObservables {
    let n: Float = math_max(num_efolds_n, 10.0);

    // Starobinsky R^2 / Higgs plateau inflation:
    // epsilon ~ 3 / (4 * N^2)
    // eta ~ -1 / N
    // n_s ~ 1 - 2/N
    // r ~ 12 / N^2
    let n2: Float = n * n;
    let eps: Float = 3.0 / (4.0 * n2);
    let eta: Float = (0.0 - 1.0) / n;
    let n_s: Float = 1.0 - (2.0 / n);
    let r_tensor: Float = 12.0 / n2;

    let is_valid: Bool = eps < 1.0 && math_abs(eta) < 1.0;

    return InflationObservables {
        num_efolds_n: n,
        slow_roll_epsilon: eps,
        slow_roll_eta: eta,
        spectral_index_ns: n_s,
        tensor_to_scalar_r: r_tensor,
        is_slow_roll_valid: is_valid,
    };
}

pub fn inflation_quadratic_model(num_efolds_n: Float) -> InflationObservables {
    let n: Float = math_max(num_efolds_n, 10.0);

    // Quadratic potential V(phi) = 1/2 * m^2 * phi^2:
    // epsilon ~ 1 / (2*N + 1) ~ 1 / (2*N)
    // eta ~ 1 / (2*N)
    // n_s ~ 1 - 2/N
    // r ~ 8 / N (ruled out by Planck+BICEP/Keck, r < 0.036)
    let eps: Float = 1.0 / (2.0 * n);
    let eta: Float = 1.0 / (2.0 * n);
    let n_s: Float = 1.0 - (2.0 / n);
    let r_tensor: Float = 8.0 / n;

    let is_valid: Bool = eps < 1.0 && eta < 1.0;

    return InflationObservables {
        num_efolds_n: n,
        slow_roll_epsilon: eps,
        slow_roll_eta: eta,
        spectral_index_ns: n_s,
        tensor_to_scalar_r: r_tensor,
        is_slow_roll_valid: is_valid,
    };
}

pub fn inflation_slow_roll_parameters(
    v_val: Float,
    v_prime: Float,
    v_double_prime: Float
) -> InflationObservables {
    if v_val <= 0.0 {
        return InflationObservables {
            num_efolds_n: 0.0,
            slow_roll_epsilon: 0.0,
            slow_roll_eta: 0.0,
            spectral_index_ns: 1.0,
            tensor_to_scalar_r: 0.0,
            is_slow_roll_valid: false,
        };
    }

    // In units where reduced Planck mass M_Pl = 1:
    // eps = 0.5 * (V' / V)^2
    // eta = V'' / V
    let vp_over_v: Float = v_prime / v_val;
    let eps: Float = 0.5 * (vp_over_v * vp_over_v);
    let eta: Float = v_double_prime / v_val;

    // n_s = 1 - 6*eps + 2*eta
    let n_s: Float = 1.0 - (6.0 * eps) + (2.0 * eta);

    // r = 16 * eps
    let r_tensor: Float = 16.0 * eps;

    let is_valid: Bool = eps < 1.0 && math_abs(eta) < 1.0;

    return InflationObservables {
        num_efolds_n: 55.0, // Standard pivot scale
        slow_roll_epsilon: eps,
        slow_roll_eta: eta,
        spectral_index_ns: n_s,
        tensor_to_scalar_r: r_tensor,
        is_slow_roll_valid: is_valid,
    };
}
