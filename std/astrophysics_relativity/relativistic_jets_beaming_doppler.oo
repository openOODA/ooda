// # Relativistic Jet Doppler Boosting & Superluminal Motion
//
// Logline: Gamma = 1/sqrt(1-beta^2); delta = 1/(Gamma (1-beta cos)). Int destub.
//
// Setup: Milli-beta, milli-cos. Flattened beaming payload.
//
// Beats:
//   1. Lorentz Gamma from 1-beta^2.
//   2. Doppler delta and beta_app = beta sin / (1 - beta cos).
//   3. Flux boost delta^(2-alpha) continuous, delta^(3-alpha) knot.

type RelativisticBeamingResult = struct {
    beta_milli: Int,
    gamma_milli: Int,
    delta_milli: Int,
    beta_app_milli: Int,
    boost_cont_milli: Int,
    boost_knot_milli: Int,
    flag_bits: Int
};

fn beam_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

fn beam_pow_milli(base_milli: Int, n: Int) -> Int {
    if n <= 0 {
        return 1000;
    }
    let mut acc: Int = 1000;
    let mut i: Int = 0;
    while i < n {
        acc = (acc * base_milli) / 1000;
        i = i + 1;
    }
    return acc;
}

pub fn relativistic_lorentz_gamma(beta_milli: Int) -> Int {
    let mut b: Int = beta_milli;
    if b < 0 {
        b = 0;
    }
    if b >= 1000 {
        b = 999;
    }
    let disc: Int = 1000000 - (b * b);
    let s: Int = beam_isqrt(disc);
    if s <= 0 {
        return 0;
    }
    return 1000000 / s;
}

pub fn relativistic_doppler_factor(beta_milli: Int, cos_milli: Int) -> Int {
    let gamma: Int = relativistic_lorentz_gamma(beta_milli);
    let mut b: Int = beta_milli;
    if b < 0 {
        b = 0;
    }
    if b >= 1000 {
        b = 999;
    }
    let mut c: Int = cos_milli;
    if c > 1000 {
        c = 1000;
    }
    if c < (0 - 1000) {
        c = 0 - 1000;
    }
    let one_minus: Int = 1000 - ((b * c) / 1000);
    if one_minus <= 0 {
        return 0;
    }
    if gamma <= 0 {
        return 0;
    }
    return 1000000000 / (gamma * one_minus);
}

pub fn apparent_superluminal_velocity(beta_milli: Int, cos_milli: Int) -> Int {
    let mut b: Int = beta_milli;
    if b < 0 {
        b = 0;
    }
    if b >= 1000 {
        b = 999;
    }
    let mut c: Int = cos_milli;
    if c > 1000 {
        c = 1000;
    }
    if c < (0 - 1000) {
        c = 0 - 1000;
    }
    let disc: Int = 1000000 - (c * c);
    let s: Int = beam_isqrt(disc);
    let one_minus: Int = 1000 - ((b * c) / 1000);
    if one_minus <= 0 {
        return 0;
    }
    return (b * s) / one_minus;
}

pub fn relativistic_beaming_compute(
    beta_milli: Int,
    cos_milli: Int,
    alpha: Int
) -> RelativisticBeamingResult {
    if beta_milli < 0 {
        return RelativisticBeamingResult {
            beta_milli: beta_milli,
            gamma_milli: 0,
            delta_milli: 0,
            beta_app_milli: 0,
            boost_cont_milli: 0,
            boost_knot_milli: 0,
            flag_bits: 0
        };
    }
    if beta_milli >= 1000 {
        return RelativisticBeamingResult {
            beta_milli: beta_milli,
            gamma_milli: 0,
            delta_milli: 0,
            beta_app_milli: 0,
            boost_cont_milli: 0,
            boost_knot_milli: 0,
            flag_bits: 0
        };
    }
    let gamma: Int = relativistic_lorentz_gamma(beta_milli);
    let delta: Int = relativistic_doppler_factor(beta_milli, cos_milli);
    let bapp: Int = apparent_superluminal_velocity(beta_milli, cos_milli);
    let mut p_cont: Int = 2 - alpha;
    let mut p_knot: Int = 3 - alpha;
    if p_cont < 0 {
        p_cont = 0;
    }
    if p_knot < 0 {
        p_knot = 0;
    }
    let boost_c: Int = beam_pow_milli(delta, p_cont);
    let boost_k: Int = beam_pow_milli(delta, p_knot);
    let mut super_f: Int = 0;
    if bapp > 1000 {
        super_f = 1;
    }
    return RelativisticBeamingResult {
        beta_milli: beta_milli,
        gamma_milli: gamma,
        delta_milli: delta,
        beta_app_milli: bapp,
        boost_cont_milli: boost_c,
        boost_knot_milli: boost_k,
        flag_bits: 1 + (super_f * 2)
    };
}

pub fn beaming_delta(r: RelativisticBeamingResult) -> Int {
    return r.delta_milli;
}

pub fn beaming_flags(r: RelativisticBeamingResult) -> Int {
    return r.flag_bits;
}
