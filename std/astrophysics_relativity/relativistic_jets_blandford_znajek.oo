// # Blandford-Znajek Relativistic Jet Power Extraction
//
// Logline: Calculates electromagnetic rotational energy extraction (Poynting flux jet power) from spinning Kerr black holes.
//
// Setup: Solves Blandford & Znajek (1977) split-monopole and parabolic magnetic field topologies threading the event horizon.
//
// Beats:
//   1. Define dimensionless Kerr spin a_star and compute horizon angular frequency Omega_H = a_star * c / (2 * r_H).
//   2. Compute magnetic flux threading horizon Phi_BH = 2 * pi * r_H^2 * B_horizon.
//   3. Compute Blandford-Znajek jet power P_BZ = (k / 4*pi*c) * Phi_BH^2 * Omega_H^2.

import "./astro_rel_constants.oo";

pub type BlandfordZnajekResult = struct {
    mass_kg: Float,
    spin_a_star: Float,
    b_field_tesla: Float,
    horizon_radius_m: Float,
    horizon_frequency_rad_s: Float,
    jet_power_w: Float,
    jet_power_solar: Float
};

pub fn bz_horizon_radius_m(mass_kg: Float, a_star: Float) -> Float {
    if mass_kg <= 0.0 {
        return 0.0;
    }
    let a: Float = math_max(math_min(a_star, 0.9999), 0.0 - 0.9999);
    let g_val: Float = const_g();
    let c_val: Float = const_c();
    let r_g: Float = (g_val * mass_kg) / (c_val * c_val);

    // r_H = r_g * (1 + sqrt(1 - a^2))
    let factor: Float = 1.0 + sqrt(1.0 - (a * a));
    return r_g * factor;
}

pub fn bz_horizon_frequency_rad_s(mass_kg: Float, a_star: Float) -> Float {
    let r_h: Float = bz_horizon_radius_m(mass_kg, a_star);
    if r_h <= 0.0 {
        return 0.0;
    }
    let a: Float = a_star;
    let c_val: Float = const_c();
    let g_val: Float = const_g();
    let r_g: Float = (g_val * mass_kg) / (c_val * c_val);

    // Omega_H = (a * c) / (2 * r_g * (1 + sqrt(1 - a^2))) = a*c / (2*r_H)
    return (a * c_val) / (2.0 * r_h);
}

pub fn blandford_znajek_compute(
    mass_kg: Float,
    spin_a_star: Float,
    b_field_tesla: Float
) -> BlandfordZnajekResult {
    let r_h: Float = bz_horizon_radius_m(mass_kg, spin_a_star);
    let omega_h: Float = bz_horizon_frequency_rad_s(mass_kg, spin_a_star);

    if mass_kg <= 0.0 || r_h <= 0.0 || b_field_tesla <= 0.0 {
        return BlandfordZnajekResult {
            mass_kg: mass_kg,
            spin_a_star: spin_a_star,
            b_field_tesla: b_field_tesla,
            horizon_radius_m: r_h,
            horizon_frequency_rad_s: omega_h,
            jet_power_w: 0.0,
            jet_power_solar: 0.0
        };
    }

    let c_val: Float = const_c();
    let pi_val: Float = const_pi();

    // Magnetic flux: Phi_BH = 2 * pi * r_H^2 * B_H
    let phi_bh: Float = (2.0 * pi_val) * (r_h * r_h) * b_field_tesla;

    // Numerical geometric efficiency factor k_geom ~ 0.05 for split-monopole field
    // P_BZ = (k / (4*pi*c * mu_0)) * Phi^2 * Omega_H^2
    // Using standard vacuum permeability mu_0 = 4*pi*1e-7 H/m
    let mu_0: Float = 0.0000012566370614359173; // 4*pi*1e-7
    let k_geom: Float = 0.05;

    let p_bz: Float = (k_geom / ((4.0 * pi_val * c_val) * mu_0)) * (phi_bh * phi_bh) * (omega_h * omega_h);

    let l_sun: Float = const_l_sun();
    let p_solar: Float = p_bz / l_sun;

    return BlandfordZnajekResult {
        mass_kg: mass_kg,
        spin_a_star: spin_a_star,
        b_field_tesla: b_field_tesla,
        horizon_radius_m: r_h,
        horizon_frequency_rad_s: omega_h,
        jet_power_w: p_bz,
        jet_power_solar: p_solar
    };
}
