// # Kerr Metric & Ergosphere Geometry in Boyer-Lindquist Coordinates
//
// Logline: r+/- = M +/- sqrt(M^2 - a^2); Delta = r^2 - 2Mr + a^2. Int destub.
//
// Setup: Geometric units. a = a_star * M. Flattened metric payload.
//
// Beats:
//   1. Horizons r+/- = M +/- isqrt(M^2 - a^2).
//   2. Ergo r_E = M + isqrt(M^2 - a^2 cos^2); Delta, Sigma.
//   3. g_tt = -(1 - 2Mr/Sigma); omega = 2 M a r / A.

type KerrSpacetimeGeometry = struct {
    mass: Int,
    spin_a: Int,
    radius: Int,
    r_plus: Int,
    r_minus: Int,
    r_ergo: Int,
    delta_val: Int,
    sigma_val: Int,
    g_tt_milli: Int,
    omega_milli: Int,
    flag_bits: Int
};

fn kerr_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn kerr_spacetime_evaluate(
    mass: Int,
    a_star_milli: Int,
    radius: Int,
    cos_milli: Int
) -> KerrSpacetimeGeometry {
    if mass <= 0 {
        return KerrSpacetimeGeometry {
            mass: mass,
            spin_a: 0,
            radius: radius,
            r_plus: 0,
            r_minus: 0,
            r_ergo: 0,
            delta_val: 0,
            sigma_val: 0,
            g_tt_milli: 0,
            omega_milli: 0,
            flag_bits: 0
        };
    }
    let mut ast: Int = a_star_milli;
    if ast < 0 {
        ast = 0 - ast;
    }
    if ast > 1000 {
        ast = 1000;
    }
    let a: Int = (ast * mass) / 1000;
    let m2: Int = mass * mass;
    let a2: Int = a * a;
    let mut disc: Int = 0;
    if m2 >= a2 {
        disc = m2 - a2;
    }
    let root: Int = kerr_isqrt(disc);
    let r_plus: Int = mass + root;
    let r_minus: Int = mass - root;
    let mut cabs: Int = cos_milli;
    if cabs < 0 {
        cabs = 0 - cabs;
    }
    if cabs > 1000 {
        cabs = 1000;
    }
    let cos2: Int = (cabs * cabs) / 1000;
    let mut disc_e: Int = m2;
    let a2c: Int = (a2 * cos2) / 1000;
    if m2 >= a2c {
        disc_e = m2 - a2c;
    } else {
        disc_e = 0;
    }
    let r_ergo: Int = mass + kerr_isqrt(disc_e);
    let r2: Int = radius * radius;
    let sigma: Int = r2 + ((a2 * cos2) / 1000);
    let delta: Int = (r2 - (2 * mass * radius)) + a2;
    if radius <= r_plus {
        return KerrSpacetimeGeometry {
            mass: mass,
            spin_a: a,
            radius: radius,
            r_plus: r_plus,
            r_minus: r_minus,
            r_ergo: r_ergo,
            delta_val: delta,
            sigma_val: sigma,
            g_tt_milli: 0,
            omega_milli: 0,
            flag_bits: 0
        };
    }
    let mut g_tt: Int = 0 - 1000;
    if sigma > 0 {
        g_tt = (0 - 1000) + ((2000 * mass * radius) / sigma);
    }
    let sin2: Int = 1000 - cos2;
    let r2a2: Int = r2 + a2;
    let big_a: Int = (r2a2 * r2a2) - ((a2 * delta * sin2) / 1000);
    let mut omega: Int = 0;
    if big_a > 0 {
        omega = (2 * mass * a * radius * 1000) / big_a;
    }
    let mut ergo: Int = 0;
    if radius < r_ergo {
        ergo = 1;
    }
    return KerrSpacetimeGeometry {
        mass: mass,
        spin_a: a,
        radius: radius,
        r_plus: r_plus,
        r_minus: r_minus,
        r_ergo: r_ergo,
        delta_val: delta,
        sigma_val: sigma,
        g_tt_milli: g_tt,
        omega_milli: omega,
        flag_bits: 1 + (ergo * 2)
    };
}

pub fn kerr_r_plus(g: KerrSpacetimeGeometry) -> Int {
    return g.r_plus;
}

pub fn kerr_flags(g: KerrSpacetimeGeometry) -> Int {
    return g.flag_bits;
}
