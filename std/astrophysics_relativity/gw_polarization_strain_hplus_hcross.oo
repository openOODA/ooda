// # Gravitational Wave Polarizations & Interferometer Antenna Patterns
//
// Logline: Calculates transverse-traceless GW strain tensor polarizations (h_+, h_x) and detector antenna response functions (F_+, F_x).
//
// Setup: Projects quadrupole metric perturbations onto L-shaped interferometer arms for arbitrary sky coordinates and binary inclinations.
//
// Beats:
//   1. Compute polarization amplitudes h_+(t) = h_0 * (1 + cos^2(i))/2 * cos(2*phi) and h_x(t) = h_0 * cos(i) * sin(2*phi).
//   2. Compute interferometer antenna pattern functions F_+(theta, phi, psi) and F_x(theta, phi, psi).
//   3. Compute total detector strain response h_det(t) = F_+ * h_+ + F_x * h_x.

import "./astro_rel_constants.oo";

pub type GWStrainPolarization = struct {
    h_plus: Float,
    h_cross: Float,
    inclination_rad: Float,
    detector_response_strain: Float
};

pub type AntennaPatternFunctions = struct {
    f_plus: Float,
    f_cross: Float,
    antenna_power: Float // F_+^2 + F_x^2
};

pub fn gw_antenna_patterns(
    theta_rad: Float, // Sky polar angle
    phi_rad: Float,   // Sky azimuthal angle
    psi_rad: Float    // Polarization angle
) -> AntennaPatternFunctions {
    let cos_th: Float = cos(theta_rad);
    let sin_2phi: Float = sin(2.0 * phi_rad);
    let cos_2phi: Float = cos(2.0 * phi_rad);
    let cos_2psi: Float = cos(2.0 * psi_rad);
    let sin_2psi: Float = sin(2.0 * psi_rad);

    let one_plus_cos2_th: Float = 1.0 + (cos_th * cos_th);

    // Standard L-shaped interferometer pattern:
    // F_+ = 0.5 * (1 + cos^2(theta)) * cos(2*phi) * cos(2*psi) - cos(theta) * sin(2*phi) * sin(2*psi)
    // F_x = 0.5 * (1 + cos^2(theta)) * cos(2*phi) * sin(2*psi) + cos(theta) * sin(2*phi) * cos(2*psi)
    let term1_plus: Float = 0.5 * one_plus_cos2_th * cos_2phi * cos_2psi;
    let term2_plus: Float = cos_th * sin_2phi * sin_2psi;
    let f_p: Float = term1_plus - term2_plus;

    let term1_cross: Float = 0.5 * one_plus_cos2_th * cos_2phi * sin_2psi;
    let term2_cross: Float = cos_th * sin_2phi * cos_2psi;
    let f_c: Float = term1_cross + term2_cross;

    let power: Float = (f_p * f_p) + (f_c * f_c);

    return AntennaPatternFunctions {
        f_plus: f_p,
        f_cross: f_c,
        antenna_power: power
    };
}

pub fn gw_polarization_strains(
    h0_amplitude: Float,
    inclination_rad: Float,
    orbital_phase_rad: Float,
    antenna: AntennaPatternFunctions
) -> GWStrainPolarization {
    let cos_i: Float = cos(inclination_rad);
    let cos2_i: Float = cos_i * cos_i;

    let gw_phase: Float = 2.0 * orbital_phase_rad;
    let cos_phase: Float = cos(gw_phase);
    let sin_phase: Float = sin(gw_phase);

    // h_+ = h0 * (1 + cos^2(i)) / 2 * cos(2*phi)
    // h_x = h0 * cos(i) * sin(2*phi)
    let h_p: Float = h0_amplitude * (0.5 * (1.0 + cos2_i)) * cos_phase;
    let h_c: Float = h0_amplitude * cos_i * sin_phase;

    // h_det = F_+ * h_+ + F_x * h_x
    let h_det: Float = ((antenna).f_plus * h_p) + ((antenna).f_cross * h_c);

    return GWStrainPolarization {
        h_plus: h_p,
        h_cross: h_c,
        inclination_rad: inclination_rad,
        detector_response_strain: h_det
    };
}
