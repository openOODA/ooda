// # Astrophysics, General Relativity & Gravitational Waves Test Fixtures & Benchmarks
//
// Logline: Standardized test fixtures and observational validation benchmarks for astrophysics, general relativity, gravitational waves, and cosmology.
//
// Setup: Generates calibrated reference states for testing stellar polytropes, Kerr geodesics, GW waveforms, and cosmological solvers.
//
// Beats:
//   1. Provide reference Lane-Emden polytrope (n=1.5 and n=3.0) structural benchmarks.
//   2. Provide Kerr black hole ISCO, photon sphere, and Blandford-Znajek jet test fixtures.
//   3. Provide LIGO GW150914 binary black hole chirp and Planck 2018 cosmological distance fixtures.

import "./astro_rel_constants.oo";
import "./stellar_lane_emden_polytrope.oo";
import "./stellar_chandrasekhar_mass.oo";
import "./stellar_eddington_luminosity.oo";
import "./accretion_disk_novikov_thorne.oo";
import "./relativistic_jets_blandford_znajek.oo";
import "./gr_schwarzschild_metric.oo";
import "./gr_kerr_black_hole_geodesics.oo";
import "./gw_chirp_waveform_imr.oo";
import "./gw_binary_orbital_decay.oo";
import "./cosmological_friedmann_solver.oo";
import "./cosmological_distances_luminosity.oo";

pub type AstroRelBenchmark = struct {
    benchmark_id: Int,
    name_code: Int,
    target_value: Float,
    tolerance: Float,
    converged: Bool,
};

pub fn stub_polytrope_n15_fixture() -> LaneEmdenSolution {
    return polytrope_standard_n15();
}

pub fn stub_polytrope_n30_fixture() -> LaneEmdenSolution {
    return polytrope_standard_n30();
}

pub fn stub_chandrasekhar_limit_fixture() -> Float {
    return chandrasekhar_mass_carbon_oxygen();
}

pub fn stub_eddington_sun_fixture() -> EddingtonResult {
    let m_sun: Float = const_m_sun();
    return eddington_luminosity_compute(m_sun, 0.70, 0.1);
}

pub fn stub_novikov_thorne_sgr_a_fixture() -> NovikovThorneDiskPoint {
    // Sgr A*: M ~ 4.154e6 M_sun, spin a* = 0.9, Mdot ~ 1e-8 M_sun/yr
    let m_bh: Float = 4154000.0 * const_m_sun();
    let mdot: Float = (0.00000001 * const_m_sun()) / const_julian_year_s();
    return novikov_thorne_evaluate(m_bh, mdot, 0.9, 10.0);
}

pub fn stub_blandford_znajek_m87_fixture() -> BlandfordZnajekResult {
    // M87*: M ~ 6.5e9 M_sun, spin a* = 0.9, B ~ 50 Gauss (0.005 Tesla)
    let m_m87: Float = 6500000000.0 * const_m_sun();
    return blandford_znajek_compute(m_m87, 0.9, 0.005);
}

pub fn stub_schwarzschild_sun_metric_fixture() -> SchwarzschildMetric {
    let m_sun: Float = const_m_sun();
    let r_sun: Float = const_r_sun();
    return schwarzschild_metric_evaluate(m_sun, r_sun, 1.5707963267948966);
}

pub fn stub_kerr_geodesic_photon_orbit() -> KerrGeodesicState {
    let consts: KerrGeodesicConstants = KerrGeodesicConstants {
        energy_e: 1.0,
        angular_momentum_lz: 3.0,
        carter_constant_q: 12.0,
        mass_param_mu: 0.0, // photon
    };
    let init_state: KerrGeodesicState = KerrGeodesicState {
        r: 6.0,
        theta: 1.5707963267948966, // equatorial
        phi: 0.0,
        t: 0.0,
        p_r: 0.0,
        p_theta: 0.0,
    };
    return kerr_geodesic_step(init_state, 0.9, 1.0, consts, 0.01);
}

pub fn stub_gw150914_chirp_fixture() -> GravitationalWaveChirpPoint {
    // GW150914: m1 = 36 M_sun, m2 = 29 M_sun, d = 410 Mpc
    let m1: Float = 36.0 * const_m_sun();
    let m2: Float = 29.0 * const_m_sun();
    let d: Float = 410.0 * const_mpc();
    return gw_imr_waveform_sample(m1, m2, d, 0.0 - 0.05); // 50 ms before merger
}

pub fn stub_hulse_taylor_decay_fixture() -> BinaryDecayResult {
    return hulse_taylor_benchmark();
}

pub fn stub_planck_cosmo_distance_z1() -> CosmoDistanceResult {
    let params: CosmoParams = cosmo_params_planck2018();
    return cosmo_distances_evaluate(params, 1.0);
}
