// # Traversable Morris-Thorne Wormhole Spacetime
//
// Logline: Solves static spherically symmetric traversable Morris-Thorne wormhole geometry and exotic matter stress-energy constraints.
//
// Setup: Implements Morris & Thorne (1988) metric ds^2 = -exp(2*Phi(r))*c^2*dt^2 + dr^2 / (1 - b(r)/r) + r^2*(dtheta^2 + sin^2(theta)*dphi^2).
//
// Beats:
//   1. Define wormhole throat radius r_0 and flare-out condition b'(r_0) <= 1.
//   2. Compute proper radial distance l(r) = integral(dr / sqrt(1 - b(r)/r)).
//   3. Evaluate stress-energy tensor components (energy density rho, radial tension tau) and verify Null Energy Condition (NEC) violation (rho + p_r < 0).

import "./astro_rel_constants.oo";

pub type MorrisThorneWormholePoint = struct {
    radius_r_m: Float,
    throat_radius_r0_m: Float,
    shape_function_b_m: Float,
    proper_radial_dist_l_m: Float,
    energy_density_j_m3: Float,
    radial_tension_pa: Float,
    nec_violation_amount: Float,
    is_at_or_above_throat: Bool
};

pub fn wormhole_shape_exponential(r: Float, r0: Float) -> Float {
    if r < r0 {
        return r0;
    }
    // Example canonical shape function: b(r) = r_0 * exp(-(r - r_0) / r_0)
    let arg: Float = (0.0 - (r - r0)) / r0;
    return r0 * exp(arg);
}

pub fn wormhole_proper_distance_approx(r: Float, r0: Float) -> Float {
    if r < r0 {
        return 0.0;
    }
    // Near throat: 1 - b(r)/r ~ (r - r0) / r0  =>  l(r) ~ 2 * sqrt(r0 * (r - r0))
    let delta_r: Float = r - r0;
    return 2.0 * sqrt(r0 * delta_r);
}

pub fn morris_thorne_evaluate(
    throat_radius_r0_m: Float,
    radius_r_m: Float
) -> MorrisThorneWormholePoint {
    let r0: Float = throat_radius_r0_m;
    let r: Float = radius_r_m;

    if r < r0 || r0 <= 0.0 {
        return MorrisThorneWormholePoint {
            radius_r_m: r,
            throat_radius_r0_m: r0,
            shape_function_b_m: r0,
            proper_radial_dist_l_m: 0.0,
            energy_density_j_m3: 0.0,
            radial_tension_pa: 0.0,
            nec_violation_amount: 0.0,
            is_at_or_above_throat: false
        };
    }

    let b: Float = wormhole_shape_exponential(r, r0);
    let l_prop: Float = wormhole_proper_distance_approx(r, r0);

    let g_val: Float = const_g();
    let c_val: Float = const_c();
    let c2: Float = c_val * c_val;
    let c4: Float = c2 * c2;
    let pi_val: Float = const_pi();

    // Einstein field equations for zero-tidal force wormhole (Phi(r) = 0):
    // rho(r) * c^2 = (c^4 / (8 * pi * G * r^2)) * b'(r)
    // For b(r) = r0 * exp(-(r-r0)/r0), b'(r) = -exp(-(r-r0)/r0) = -b/r0
    let b_prime: Float = (0.0 - b) / r0;

    let rho_c2: Float = (c4 / ((8.0 * pi_val * g_val) * (r * r))) * b_prime;

    // Radial tension tau(r) = -p_r(r) = (c^4 / (8 * pi * G * r^2)) * (b(r) / r)
    let tau_r: Float = (c4 / ((8.0 * pi_val * g_val) * (r * r))) * (b / r);
    let p_r: Float = 0.0 - tau_r;

    // Null Energy Condition: NEC = rho * c^2 + p_r = (c^4 / 8*pi*G*r^2) * (b' - b/r)
    // Since b' < 0 and b/r > 0, NEC is strictly negative (exotic matter required!)
    let nec: Float = rho_c2 + p_r;

    return MorrisThorneWormholePoint {
        radius_r_m: r,
        throat_radius_r0_m: r0,
        shape_function_b_m: b,
        proper_radial_dist_l_m: l_prop,
        energy_density_j_m3: rho_c2,
        radial_tension_pa: tau_r,
        nec_violation_amount: math_abs(nec),
        is_at_or_above_throat: true
    };
}
