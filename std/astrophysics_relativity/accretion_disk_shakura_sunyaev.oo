// # Shakura-Sunyaev Standard Thin Accretion Disk Model
//
// Logline: T^4 ~ M Mdot Q / r^3; H = c_s / Omega_K. Int destub.
//
// Setup: Flattened SS point. sigma=1, 8-pi folded to 8. mu=3/5.
//
// Beats:
//   1. Q = 1 - sqrt(R_in / r); T_eff = (T^4)^{1/4}.
//   2. Omega_K = sqrt(M / r^3); c_s^2 = T / mu; H = c_s / Omega.
//   3. nu = alpha c_s H; Sigma = Mdot / (3 pi nu).

type ShakuraSunyaevDiskPoint = struct {
    radius: Int,
    t_eff: Int,
    scale_h: Int,
    aspect_milli: Int,
    sigma_surf: Int,
    dissipation: Int,
    flag_bits: Int
};

fn ss_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn ss_keplerian_frequency(mass: Int, radius: Int) -> Int {
    if mass <= 0 {
        return 0;
    }
    if radius <= 0 {
        return 0;
    }
    let r3: Int = radius * radius * radius;
    return ss_isqrt((mass * 1000000) / r3);
}

pub fn ss_effective_temperature(
    mass: Int,
    mdot: Int,
    radius: Int,
    r_inner: Int
) -> Int {
    if radius <= r_inner {
        return 0;
    }
    if mass <= 0 {
        return 0;
    }
    if mdot <= 0 {
        return 0;
    }
    let q_milli: Int = 1000 - ss_isqrt((r_inner * 1000000) / radius);
    if q_milli <= 0 {
        return 0;
    }
    let r3: Int = radius * radius * radius;
    let t4: Int = (3 * mass * mdot * q_milli * 1000) / (8 * r3);
    return ss_isqrt(ss_isqrt(t4));
}

pub fn ss_disk_point_evaluate(
    mass: Int,
    mdot: Int,
    alpha_milli: Int,
    radius: Int,
    r_inner: Int
) -> ShakuraSunyaevDiskPoint {
    let t_eff: Int = ss_effective_temperature(mass, mdot, radius, r_inner);
    let omega: Int = ss_keplerian_frequency(mass, radius);
    if t_eff <= 0 {
        return ShakuraSunyaevDiskPoint {
            radius: radius,
            t_eff: 0,
            scale_h: 0,
            aspect_milli: 0,
            sigma_surf: 0,
            dissipation: 0,
            flag_bits: 0
        };
    }
    if omega <= 0 {
        return ShakuraSunyaevDiskPoint {
            radius: radius,
            t_eff: t_eff,
            scale_h: 0,
            aspect_milli: 0,
            sigma_surf: 0,
            dissipation: 0,
            flag_bits: 0
        };
    }
    let q_milli: Int = 1000 - ss_isqrt((r_inner * 1000000) / radius);
    let r3: Int = radius * radius * radius;
    let t4: Int = (3 * mass * mdot * q_milli * 1000) / (8 * r3);
    let c_s: Int = ss_isqrt((t_eff * 5000) / 3);
    let h_scale: Int = (c_s * 1000) / omega;
    let aspect: Int = h_scale / radius;
    let mut a: Int = alpha_milli;
    if a < 1 {
        a = 1;
    }
    let nu: Int = (a * c_s * h_scale) / 1000000;
    let mut sigma_surf: Int = 0;
    if nu > 0 {
        sigma_surf = (mdot * 1000) / ((3 * 314) * nu);
    }
    return ShakuraSunyaevDiskPoint {
        radius: radius,
        t_eff: t_eff,
        scale_h: h_scale,
        aspect_milli: aspect,
        sigma_surf: sigma_surf,
        dissipation: t4,
        flag_bits: 1
    };
}

pub fn ss_temp(p: ShakuraSunyaevDiskPoint) -> Int {
    return p.t_eff;
}

pub fn ss_flags(p: ShakuraSunyaevDiskPoint) -> Int {
    return p.flag_bits;
}
