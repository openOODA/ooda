// # Cosmological Distance Measures & Lookback Time
//
// Logline: Calculates line-of-sight comoving distance, luminosity distance, angular diameter distance, and cosmic lookback time.
//
// Setup: Numerically integrates FLRW geodesic distance integrals for flat and curved cosmological models.
//
// Beats:
//   1. Numerically integrate comoving distance D_c(z) = (c / H_0) * integral_0^z [dz' / E(z')].
//   2. Compute luminosity distance D_L(z) = (1 + z) * D_c(z) and angular diameter distance D_A(z) = D_c(z) / (1 + z).
//   3. Compute distance modulus mu(z) = 5 * log10(D_L / 10 pc) and lookback time t_L(z) = 1/H_0 * integral [dz' / ((1+z')*E(z'))].

import "./astro_rel_constants.oo";
import "./cosmological_friedmann_solver.oo";

pub type CosmoDistanceResult = struct {
    redshift_z: Float,
    comoving_distance_mpc: Float,
    luminosity_distance_mpc: Float,
    angular_diameter_distance_mpc: Float,
    distance_modulus_mag: Float,
    lookback_time_gyr: Float,
};

pub type CosmoParams = struct {
    h0_km_s_mpc: Float,
    omega_m: Float,
    omega_l: Float,
    omega_k: Float,
    omega_r: Float,
};

pub fn cosmo_params_default() -> CosmoParams {
    return CosmoParams {
        h0_km_s_mpc: 70.0,
        omega_m: 0.3,
        omega_l: 0.7,
        omega_k: 0.0,
        omega_r: 0.0,
    };
}

fn cosmo_friedmann_e_z(params: CosmoParams, z: Float) -> Float {
    let one_plus_z: Float = 1.0 + z;
    let z2: Float = one_plus_z * one_plus_z;
    let z3: Float = z2 * one_plus_z;
    let z4: Float = z2 * z2;
    let e2: Float = ((params).omega_r * z4) + ((params).omega_m * z3) + ((params).omega_k * z2) + (params).omega_l;
    if e2 <= 0.0 {
        return 1.0;
    }
    return sqrt(e2);
}

pub fn cosmo_comoving_distance_mpc(params: CosmoParams, redshift_z: Float) -> Float {
    if redshift_z <= 0.0 {
        return 0.0;
    }
    let steps: Int = 100;
    let dz: Float = redshift_z / 100.0;
    let mut integral: Float = 0.0;

    let mut step: Int = 0;
    let mut z_curr: Float = 0.5 * dz;

    while step < steps {
        let e_z: Float = cosmo_friedmann_e_z(params, z_curr);
        if e_z > 0.0 {
            integral = integral + (dz / e_z);
        }
        z_curr = z_curr + dz;
        step = step + 1;
    }

    // Hubble distance D_H = c / H_0 in Mpc
    // c in km/s = 299,792.458
    let d_h_mpc: Float = 299792.458 / (params).h0_km_s_mpc;
    return d_h_mpc * integral;
}

pub fn cosmo_lookback_time_gyr(params: CosmoParams, redshift_z: Float) -> Float {
    if redshift_z <= 0.0 {
        return 0.0;
    }
    let steps: Int = 100;
    let dz: Float = redshift_z / 100.0;
    let mut integral: Float = 0.0;

    let mut step: Int = 0;
    let mut z_curr: Float = 0.5 * dz;

    while step < steps {
        let e_z: Float = cosmo_friedmann_e_z(params, z_curr);
        let denom: Float = (1.0 + z_curr) * e_z;
        if denom > 0.0 {
            integral = integral + (dz / denom);
        }
        z_curr = z_curr + dz;
        step = step + 1;
    }

    // Hubble time t_H = 1 / H_0 in Gyr
    // 1 / H0 = (3.08567758e19 km) / (H0 km/s) seconds -> Gyr (3.15576e16 s/Gyr)
    // t_H (Gyr) ~ 977.8 / H0
    let t_h_gyr: Float = 977.8 / (params).h0_km_s_mpc;
    return t_h_gyr * integral;
}

pub fn cosmo_distances_evaluate(params: CosmoParams, redshift_z: Float) -> CosmoDistanceResult {
    let d_c: Float = cosmo_comoving_distance_mpc(params, redshift_z);
    let one_plus_z: Float = 1.0 + redshift_z;

    // For flat universe (Omega_k = 0):
    let d_l: Float = one_plus_z * d_c;
    let d_a: Float = if one_plus_z > 0.0 { d_c / one_plus_z } else { 0.0 };

    // Distance modulus mu = 5 * log10(D_L / 10 pc) = 5 * log10(D_L_Mpc * 10^5) = 5 * log10(D_L_Mpc) + 25
    let mut mu: Float = 0.0;
    if d_l > 0.0 {
        let log_dl: Float = ln(d_l) / 2.302585092994046;
        mu = (5.0 * log_dl) + 25.0;
    }

    let t_lookback: Float = cosmo_lookback_time_gyr(params, redshift_z);

    return CosmoDistanceResult {
        redshift_z: redshift_z,
        comoving_distance_mpc: d_c,
        luminosity_distance_mpc: d_l,
        angular_diameter_distance_mpc: d_a,
        distance_modulus_mag: mu,
        lookback_time_gyr: t_lookback,
    };
}
