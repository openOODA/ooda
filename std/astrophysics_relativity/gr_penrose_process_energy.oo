// # Penrose Process & Rotational Energy Extraction
//
// Logline: M_irr = M sqrt((1+sqrt(1-a^2))/2). Int destub (milli-spin).
//
// Setup: Flattened irreducible-mass payload; decay is E2 = E0 - E1.
//
// Beats:
//   1. Nested isqrt for M_irr(a*).
//   2. Extractable fraction (M - M_irr) / M.
//   3. Ergosphere decay: escaped energy E2 = E0 - E1.

type PenroseEnergyResult = struct {
    total_mass: Int,
    irr_mass: Int,
    rot_frac_milli: Int,
    flag_bits: Int
};

fn penrose_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn kerr_irreducible_mass(mass: Int, a_milli: Int) -> Int {
    if mass <= 0 {
        return 0;
    }
    let mut a: Int = a_milli;
    if a < 0 {
        a = 0 - a;
    }
    if a > 999 {
        a = 999;
    }
    let one_minus_a2: Int = 1000000 - (a * a);
    let s1: Int = penrose_isqrt(one_minus_a2);
    let term_milli: Int = (1000 + s1) / 2;
    let s2: Int = penrose_isqrt(term_milli * 1000);
    return (mass * s2) / 1000;
}

pub fn penrose_process_evaluate(mass: Int, a_milli: Int) -> PenroseEnergyResult {
    let m_irr: Int = kerr_irreducible_mass(mass, a_milli);
    let mut delta: Int = 0;
    if mass > m_irr {
        delta = mass - m_irr;
    }
    let mut frac: Int = 0;
    if mass > 0 {
        frac = (delta * 1000) / mass;
    }
    let mut aa: Int = a_milli;
    if aa < 0 {
        aa = 0 - aa;
    }
    let mut ext: Int = 0;
    if aa >= 999 {
        ext = 1;
    }
    let mut valid: Int = 0;
    if mass > 0 {
        valid = 1;
    }
    return PenroseEnergyResult {
        total_mass: mass,
        irr_mass: m_irr,
        rot_frac_milli: frac,
        flag_bits: valid + (ext * 2)
    };
}

pub fn penrose_escaped_energy(parent_e: Int, infall_e: Int) -> Int {
    return parent_e - infall_e;
}

pub fn penrose_irr(r: PenroseEnergyResult) -> Int {
    return r.irr_mass;
}

pub fn penrose_flags(r: PenroseEnergyResult) -> Int {
    return r.flag_bits;
}
