// # Stellar Thermonuclear Nuclear Reaction Rates: pp-chain, CNO & 3-alpha
//
// Logline: eps_pp ~ T^4; eps_cno ~ T^16; eps_3a ~ T^40. Int destub.
//
// Setup: T6 = T/10^6 K. X,Y,Z in milli. Flattened rate payload.
//
// Beats:
//   1. pp: rho X^2 (T6/15)^4.
//   2. CNO: rho X Z (T6/20)^16.
//   3. Triple-alpha: rho^2 Y^3 (T8)^40; dominant 1/2/3.

type NuclearEnergyRates = struct {
    eps_pp: Int,
    eps_cno: Int,
    eps_3a: Int,
    total_eps: Int,
    dominant: Int,
    flag_bits: Int
};

fn nuclear_pow_milli(base_milli: Int, n: Int) -> Int {
    if n <= 0 {
        return 1000;
    }
    if base_milli <= 0 {
        return 0;
    }
    let mut acc: Int = 1000;
    let mut i: Int = 0;
    while i < n {
        acc = (acc * base_milli) / 1000;
        i = i + 1;
    }
    return acc;
}

pub fn nuclear_pp_rate(density: Int, x_milli: Int, t6: Int) -> Int {
    if t6 < 1 {
        return 0;
    }
    if density <= 0 {
        return 0;
    }
    if x_milli <= 0 {
        return 0;
    }
    let t_pp: Int = (t6 * 1000) / 15;
    let t2: Int = (t_pp * t_pp) / 1000;
    let t3: Int = (t2 * t_pp) / 1000;
    let t4: Int = (t3 * t_pp) / 1000;
    return (density * x_milli * x_milli / 1000 * t4) / 1000000;
}

pub fn nuclear_cno_rate(density: Int, x_milli: Int, z_milli: Int, t6: Int) -> Int {
    if t6 < 5 {
        return 0;
    }
    if density <= 0 {
        return 0;
    }
    if x_milli <= 0 {
        return 0;
    }
    if z_milli <= 0 {
        return 0;
    }
    let t_cno: Int = (t6 * 1000) / 20;
    let t16: Int = nuclear_pow_milli(t_cno, 16);
    return (density * x_milli * z_milli / 1000 * t16) / 1000;
}

pub fn nuclear_triple_alpha_rate(density: Int, y_milli: Int, t6: Int) -> Int {
    if t6 < 50 {
        return 0;
    }
    if density <= 0 {
        return 0;
    }
    if y_milli <= 0 {
        return 0;
    }
    let t8: Int = (t6 * 10);
    let t40: Int = nuclear_pow_milli(t8, 40);
    let y3: Int = ((y_milli * y_milli) / 1000 * y_milli) / 1000;
    return (density * density * y3 * t40) / 1000000;
}

pub fn nuclear_rates_total(
    density: Int,
    x_milli: Int,
    y_milli: Int,
    z_milli: Int,
    t6: Int
) -> NuclearEnergyRates {
    let pp: Int = nuclear_pp_rate(density, x_milli, t6);
    let cno: Int = nuclear_cno_rate(density, x_milli, z_milli, t6);
    let ta: Int = nuclear_triple_alpha_rate(density, y_milli, t6);
    let tot: Int = pp + cno + ta;
    let mut dom: Int = 1;
    if cno > pp {
        if cno > ta {
            dom = 2;
        }
    }
    if ta > pp {
        if ta > cno {
            dom = 3;
        }
    }
    let mut valid: Int = 0;
    if tot > 0 {
        valid = 1;
    }
    return NuclearEnergyRates {
        eps_pp: pp,
        eps_cno: cno,
        eps_3a: ta,
        total_eps: tot,
        dominant: dom,
        flag_bits: valid
    };
}

pub fn nuclear_eps_pp(r: NuclearEnergyRates) -> Int {
    return r.eps_pp;
}

pub fn nuclear_dominant(r: NuclearEnergyRates) -> Int {
    return r.dominant;
}

pub fn nuclear_flags(r: NuclearEnergyRates) -> Int {
    return r.flag_bits;
}
