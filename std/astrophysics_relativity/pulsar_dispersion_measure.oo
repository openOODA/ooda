// # Pulsar Dispersion Measure & ISM Plasma Delay
//
// Logline: Cold-plasma group delay t = D * DM / f^2. Int destub (D = 4149).
//
// Setup: Dispersion constant D ~ 4.148808e3 MHz^2 s / (pc cm^-3).
//
// Beats:
//   1. t_delay = D * DM / f^2.
//   2. Differential delay between two radio bands.
//   3. Invert a measured delay to DM.

type DispersionDelayResult = struct {
    freq_high_mhz: Int,
    freq_low_mhz: Int,
    dm: Int,
    delay_s: Int,
    flag_bits: Int
};

fn pulsar_dispersion_d() -> Int {
    return 4149;
}

pub fn pulsar_dispersion_delay_s(freq_mhz: Int, dm: Int) -> Int {
    if freq_mhz <= 0 {
        return 0;
    }
    if dm <= 0 {
        return 0;
    }
    let f2: Int = freq_mhz * freq_mhz;
    return (pulsar_dispersion_d() * dm) / f2;
}

pub fn pulsar_dispersion_differential(
    freq_low_mhz: Int,
    freq_high_mhz: Int,
    dm: Int
) -> DispersionDelayResult {
    let t_low: Int = pulsar_dispersion_delay_s(freq_low_mhz, dm);
    let t_high: Int = pulsar_dispersion_delay_s(freq_high_mhz, dm);
    let mut delta: Int = 0;
    if t_low > t_high {
        delta = t_low - t_high;
    }
    let mut valid: Int = 0;
    if freq_low_mhz > 0 {
        if freq_high_mhz > 0 {
            if dm > 0 {
                valid = 1;
            }
        }
    }
    return DispersionDelayResult {
        freq_high_mhz: freq_high_mhz,
        freq_low_mhz: freq_low_mhz,
        dm: dm,
        delay_s: delta,
        flag_bits: valid
    };
}

pub fn pulsar_dispersion_measure_invert(freq_mhz: Int, measured_delay_s: Int) -> Int {
    if measured_delay_s <= 0 {
        return 0;
    }
    if freq_mhz <= 0 {
        return 0;
    }
    let f2: Int = freq_mhz * freq_mhz;
    return (measured_delay_s * f2) / pulsar_dispersion_d();
}

pub fn pulsar_dispersion_delay_of(r: DispersionDelayResult) -> Int {
    return r.delay_s;
}

pub fn pulsar_dispersion_flags(r: DispersionDelayResult) -> Int {
    return r.flag_bits;
}
