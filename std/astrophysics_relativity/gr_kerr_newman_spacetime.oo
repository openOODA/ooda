// # Kerr-Newman Charged Rotating Spacetime Geometry
//
// Logline: r+/- = M +/- sqrt(M^2 - a^2 - Q^2). Int destub.
//
// Setup: Geometric units. a = a_star M; Q = q_star M. Flattened.
//
// Beats:
//   1. Horizons from disc = M^2 - a^2 - Q^2.
//   2. Extremality xi = (a^2 + Q^2) / M^2.
//   3. A_t = -Q r / Sigma; A_phi = Q r a sin^2 / Sigma.

type KerrNewmanGeometry = struct {
    mass: Int,
    spin_a: Int,
    charge_q: Int,
    r_plus: Int,
    r_minus: Int,
    r_ergo: Int,
    xi_milli: Int,
    a_t_milli: Int,
    a_phi_milli: Int,
    flag_bits: Int
};

fn kn_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn kerr_newman_evaluate(
    mass: Int,
    a_star_milli: Int,
    q_star_milli: Int,
    radius: Int,
    cos_milli: Int
) -> KerrNewmanGeometry {
    if mass <= 0 {
        return KerrNewmanGeometry {
            mass: mass,
            spin_a: 0,
            charge_q: 0,
            r_plus: 0,
            r_minus: 0,
            r_ergo: 0,
            xi_milli: 0,
            a_t_milli: 0,
            a_phi_milli: 0,
            flag_bits: 0
        };
    }
    let mut ast: Int = a_star_milli;
    if ast < 0 {
        ast = 0 - ast;
    }
    let mut qst: Int = q_star_milli;
    if qst < 0 {
        qst = 0 - qst;
    }
    let a: Int = (ast * mass) / 1000;
    let q: Int = (qst * mass) / 1000;
    let m2: Int = mass * mass;
    let a2: Int = a * a;
    let q2: Int = q * q;
    let xi_milli: Int = ((a2 + q2) * 1000) / m2;
    let mut disc: Int = 0;
    let mut is_bh: Int = 0;
    if m2 >= (a2 + q2) {
        disc = m2 - a2 - q2;
        is_bh = 1;
    }
    let root: Int = kn_isqrt(disc);
    let r_plus: Int = mass + root;
    let r_minus: Int = mass - root;
    let mut cabs: Int = cos_milli;
    if cabs < 0 {
        cabs = 0 - cabs;
    }
    if cabs > 1000 {
        cabs = 1000;
    }
    let cos2: Int = (cabs * cabs) / 1000;
    let mut disc_e: Int = 0;
    let a2c: Int = (a2 * cos2) / 1000;
    if m2 >= (a2c + q2) {
        disc_e = m2 - a2c - q2;
    }
    let r_ergo: Int = mass + kn_isqrt(disc_e);
    let r2: Int = radius * radius;
    let sigma: Int = r2 + ((a2 * cos2) / 1000);
    let sin2: Int = 1000 - cos2;
    let mut a_t: Int = 0;
    let mut a_phi: Int = 0;
    if sigma > 0 {
        a_t = 0 - ((q * radius * 1000) / sigma);
        a_phi = (q * radius * a * sin2) / sigma;
    }
    let mut ext: Int = 0;
    if xi_milli == 1000 {
        ext = 1;
    }
    return KerrNewmanGeometry {
        mass: mass,
        spin_a: a,
        charge_q: q,
        r_plus: r_plus,
        r_minus: r_minus,
        r_ergo: r_ergo,
        xi_milli: xi_milli,
        a_t_milli: a_t,
        a_phi_milli: a_phi,
        flag_bits: is_bh + (ext * 2)
    };
}

pub fn kn_r_plus(g: KerrNewmanGeometry) -> Int {
    return g.r_plus;
}

pub fn kn_flags(g: KerrNewmanGeometry) -> Int {
    return g.flag_bits;
}
