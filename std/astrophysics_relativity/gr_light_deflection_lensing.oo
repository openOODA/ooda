// # Gravitational Light Deflection & Einstein Lensing
//
// Logline: alpha = 2 rs / b; mu = (u^2+2)/(u sqrt(u^2+4)). Int destub.
//
// Setup: Geometric units. Flattened lens payload.
//
// Beats:
//   1. Deflection alpha = 4M / b (milli-rad).
//   2. Einstein radius theta_E = sqrt(2 rs D_ds / (D_d D_s)).
//   3. Point-lens magnification at dimensionless u = beta / theta_E.

type GravitationalLensResult = struct {
    deflection_milli: Int,
    einstein_milli: Int,
    mag_milli: Int,
    flag_bits: Int
};

fn gr_lens_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn gr_light_deflection_angle(mass: Int, impact_param_b: Int) -> Int {
    if impact_param_b <= 0 {
        return 0;
    }
    if mass <= 0 {
        return 0;
    }
    let rs: Int = 2 * mass;
    return (2000 * rs) / impact_param_b;
}

pub fn gr_einstein_radius(mass: Int, dist_lens: Int, dist_source: Int) -> Int {
    if dist_lens <= 0 {
        return 0;
    }
    if dist_source <= dist_lens {
        return 0;
    }
    if mass <= 0 {
        return 0;
    }
    let rs: Int = 2 * mass;
    let dds: Int = dist_source - dist_lens;
    let num: Int = 2 * rs * dds * 1000000;
    let den: Int = dist_lens * dist_source;
    if den <= 0 {
        return 0;
    }
    return gr_lens_isqrt(num / den);
}

pub fn gr_point_lens_solve(
    mass: Int,
    impact_param_b: Int,
    dist_lens: Int,
    dist_source: Int,
    beta_milli: Int
) -> GravitationalLensResult {
    let alpha: Int = gr_light_deflection_angle(mass, impact_param_b);
    let theta_e: Int = gr_einstein_radius(mass, dist_lens, dist_source);
    if theta_e <= 0 {
        return GravitationalLensResult {
            deflection_milli: alpha,
            einstein_milli: 0,
            mag_milli: 1000,
            flag_bits: 0
        };
    }
    let mut beta_abs: Int = beta_milli;
    if beta_abs < 0 {
        beta_abs = 0 - beta_abs;
    }
    let u_milli: Int = (beta_abs * 1000) / theta_e;
    if u_milli <= 0 {
        return GravitationalLensResult {
            deflection_milli: alpha,
            einstein_milli: theta_e,
            mag_milli: 1000,
            flag_bits: 1
        };
    }
    let u2: Int = u_milli * u_milli;
    let root: Int = gr_lens_isqrt(u2 + 4000000);
    let den: Int = u_milli * root;
    let mut mu: Int = 1000;
    if den > 0 {
        mu = (1000 * (u2 + 2000000)) / den;
    }
    return GravitationalLensResult {
        deflection_milli: alpha,
        einstein_milli: theta_e,
        mag_milli: mu,
        flag_bits: 1
    };
}

pub fn gr_lens_deflection(r: GravitationalLensResult) -> Int {
    return r.deflection_milli;
}

pub fn gr_lens_flags(r: GravitationalLensResult) -> Int {
    return r.flag_bits;
}
