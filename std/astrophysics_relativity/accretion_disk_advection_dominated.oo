// # Advection-Dominated Accretion Flow (ADAF / RIAF) Model
//
// Logline: Narayan-Yi self-similar v_r, c_s, eta. Int destub (milli).
//
// Setup: Flattened ADAF point. gamma=5/3. alpha and f in milli.
//
// Beats:
//   1. v_K = 1/sqrt(r); c1 = 3 a / (5 + 2 a^2); v_r = c1 a v_K.
//   2. c_s = sqrt(2/(5 gamma)) v_K; Omega/Omega_K = 1/2.
//   3. eta = 0.1 * min(mdot/0.01, 1) * (1 - f).

type AdafFlowPoint = struct {
    radius_rg: Int,
    v_r_micro: Int,
    c_s_milli: Int,
    rot_milli: Int,
    eta_milli: Int,
    flag_bits: Int
};

fn adaf_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn adaf_self_similar_evaluate(
    mass: Int,
    mdot_milli: Int,
    alpha_milli: Int,
    radius_rg: Int,
    f_milli: Int
) -> AdafFlowPoint {
    if radius_rg <= 2 {
        return AdafFlowPoint {
            radius_rg: radius_rg,
            v_r_micro: 0,
            c_s_milli: 0,
            rot_milli: 0,
            eta_milli: 0,
            flag_bits: 0
        };
    }
    if mass <= 0 {
        return AdafFlowPoint {
            radius_rg: radius_rg,
            v_r_micro: 0,
            c_s_milli: 0,
            rot_milli: 0,
            eta_milli: 0,
            flag_bits: 0
        };
    }
    let mut a: Int = alpha_milli;
    if a < 1 {
        a = 1;
    }
    if a > 1000 {
        a = 1000;
    }
    let mut f: Int = f_milli;
    if f < 0 {
        f = 0;
    }
    if f > 1000 {
        f = 1000;
    }
    let c1_num: Int = 3 * a * 1000;
    let c1_den: Int = 5000 + ((2 * a * a) / 1000);
    let c1_milli: Int = c1_num / c1_den;
    let v_k_milli: Int = 1000 / adaf_isqrt(radius_rg);
    let v_r_micro: Int = (c1_milli * a * v_k_milli) / 1000;
    let c2_milli: Int = adaf_isqrt(240000);
    let c_s_milli: Int = (c2_milli * v_k_milli) / 1000;
    let mut mdot_clip: Int = mdot_milli;
    if mdot_clip < 0 {
        mdot_clip = 0;
    }
    let mut mdot_fac: Int = (mdot_clip * 100);
    if mdot_clip >= 10 {
        mdot_fac = 1000;
    }
    let eta_milli: Int = (mdot_fac * (1000 - f)) / 10000;
    let mut adv: Int = 0;
    if f >= 1000 {
        adv = 1;
    }
    return AdafFlowPoint {
        radius_rg: radius_rg,
        v_r_micro: v_r_micro,
        c_s_milli: c_s_milli,
        rot_milli: 500,
        eta_milli: eta_milli,
        flag_bits: 1 + (adv * 2)
    };
}

pub fn adaf_eta(p: AdafFlowPoint) -> Int {
    return p.eta_milli;
}

pub fn adaf_flags(p: AdafFlowPoint) -> Int {
    return p.flag_bits;
}
