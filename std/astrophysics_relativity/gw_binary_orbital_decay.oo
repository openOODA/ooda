// # Binary Pulsar Gravitational Wave Orbital Period Decay
//
// Logline: Calculates secular orbital period decay (P_dot_GW) and merger coalescence timescales for relativistic compact binaries.
//
// Setup: Implements Taylor-Weisberg formula validated on the Hulse-Taylor binary pulsar PSR B1913+16.
//
// Beats:
//   1. Compute orbital period decay rate P_dot = -(192*pi / 5*c^5) * (2*pi*G/P_b)^(5/3) * (m1*m2 / M_tot^(1/3)) * F(e).
//   2. Compute Peters (1964) binary merger coalescence lifetime tau_merge(a_0, e_0).
//   3. Provide reference validation benchmark against Hulse-Taylor observed decay rate (-2.42e-12 s/s).

import "./astro_rel_constants.oo";

pub type BinaryDecayResult = struct {
    period_decay_pdot_s_s: Float,
    coalescence_time_yr: Float,
    cumulative_shift_seconds_10yr: Float,
    eccentricity_function_f: Float,
};

pub fn binary_decay_eccentricity_factor(e: Float) -> Float {
    let e2: Float = e * e;
    let e4: Float = e2 * e2;
    // F(e) = (1 + 73/24 * e^2 + 37/96 * e^4) / (1 - e^2)^(7/2)
    let num: Float = 1.0 + ((73.0 / 24.0) * e2) + ((37.0 / 96.0) * e4);
    let den: Float = pow(math_max(1.0 - e2, 0.0001), 3.5);
    return num / den;
}

pub fn binary_orbital_decay_rate(
    m1_kg: Float,
    m2_kg: Float,
    orbital_period_s: Float,
    eccentricity: Float
) -> BinaryDecayResult {
    if m1_kg <= 0.0 || m2_kg <= 0.0 || orbital_period_s <= 0.0 {
        return BinaryDecayResult {
            period_decay_pdot_s_s: 0.0,
            coalescence_time_yr: 0.0,
            cumulative_shift_seconds_10yr: 0.0,
            eccentricity_function_f: 1.0,
        };
    }

    let g_val: Float = const_g();
    let c_val: Float = const_c();
    let c5: Float = pow(c_val, 5.0);
    let pi_val: Float = const_pi();

    let m_tot: Float = m1_kg + m2_kg;
    let f_e: Float = binary_decay_eccentricity_factor(eccentricity);

    // Term 1: (2 * pi * G / P_b)^(5/3)
    let n_orb: Float = (2.0 * pi_val * g_val) / orbital_period_s;
    let n_53: Float = pow(n_orb, 1.6666666666666667);

    // Term 2: (m1 * m2) / M_tot^(1/3)
    let m_factor: Float = (m1_kg * m2_kg) / pow(m_tot, 0.3333333333333333);

    // P_dot = - (192 * pi / (5 * c^5)) * n_53 * m_factor * F(e)
    let p_dot: Float = (0.0 - ((192.0 * pi_val) / (5.0 * c5))) * n_53 * m_factor * f_e;

    // Coalescence time for circular binary: tau_0 = (5 / 256) * (c^5 / G^3) * (a^4 / (m1 * m2 * M_tot))
    // In terms of P_b: tau ~ (P_b / (8 * |P_dot|)) * (1 - e^2)^(7/2)
    let tau_s: Float = if math_abs(p_dot) > 0.0 {
        (orbital_period_s / (8.0 * math_abs(p_dot))) * pow(math_max(1.0 - (eccentricity * eccentricity), 0.01), 3.5)
    } else {
        0.0
    };
    let tau_yr: Float = tau_s / const_julian_year_s();

    // Cumulative timing shift over 10 years: Delta_T = 0.5 * (P_dot / P_b) * T_obs^2
    let t_obs_s: Float = 10.0 * const_julian_year_s();
    let delta_t_10yr: Float = 0.5 * (p_dot / orbital_period_s) * (t_obs_s * t_obs_s);

    return BinaryDecayResult {
        period_decay_pdot_s_s: p_dot,
        coalescence_time_yr: tau_yr,
        cumulative_shift_seconds_10yr: delta_t_10yr,
        eccentricity_function_f: f_e,
    };
}

pub fn hulse_taylor_benchmark() -> BinaryDecayResult {
    // PSR B1913+16: m1 = 1.4414 M_sun, m2 = 1.3867 M_sun, P_b = 27906.98 s (7.75 hr), e = 0.6171334
    let m1: Float = 1.4414 * const_m_sun();
    let m2: Float = 1.3867 * const_m_sun();
    let p_b: Float = 27906.98;
    let e: Float = 0.6171334;

    return binary_orbital_decay_rate(m1, m2, p_b, e);
}
