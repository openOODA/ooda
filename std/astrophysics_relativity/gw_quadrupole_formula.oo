// # Einstein Quadrupole Radiation Formula & Power Emission
//
// Logline: P = (32/5) m1^2 m2^2 M / a^5 * F(e). Int destub.
//
// Setup: F(e) = (1 + 73/24 e^2 + 37/96 e^4) / (1-e^2)^{7/2}.
//
// Beats:
//   1. Peters-Mathews F(e) in milli.
//   2. Circular P0 scaled (32/5) m1^2 m2^2 M / a^5.
//   3. P_GW = P0 * F(e).

type QuadrupoleRadiationResult = struct {
    f_e_milli: Int,
    p0_rel: Int,
    p_gw_rel: Int,
    flag_bits: Int
};

fn quad_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn peters_mathews_f_e(e_milli: Int) -> Int {
    let mut e: Int = e_milli;
    if e < 0 {
        e = 0;
    }
    if e > 999 {
        e = 999;
    }
    let e2: Int = (e * e) / 1000;
    let e4: Int = (e2 * e2) / 1000;
    let num: Int = 1000 + ((73 * e2) / 24) + ((37 * e4) / 96);
    let ome: Int = 1000 - e2;
    if ome <= 0 {
        return 0;
    }
    let rt: Int = quad_isqrt(ome * 1000);
    let ome3: Int = ome * ome * ome;
    let den: Int = ome3 * rt;
    if den <= 0 {
        return 0;
    }
    return (num * 1000000000000) / den;
}

pub fn gw_quadrupole_binary_power(
    m1: Int,
    m2: Int,
    semi_major: Int,
    e_milli: Int
) -> QuadrupoleRadiationResult {
    if m1 <= 0 {
        return QuadrupoleRadiationResult {
            f_e_milli: 1000,
            p0_rel: 0,
            p_gw_rel: 0,
            flag_bits: 0
        };
    }
    if m2 <= 0 {
        return QuadrupoleRadiationResult {
            f_e_milli: 1000,
            p0_rel: 0,
            p_gw_rel: 0,
            flag_bits: 0
        };
    }
    if semi_major <= 0 {
        return QuadrupoleRadiationResult {
            f_e_milli: 1000,
            p0_rel: 0,
            p_gw_rel: 0,
            flag_bits: 0
        };
    }
    let f_e: Int = peters_mathews_f_e(e_milli);
    let m_tot: Int = m1 + m2;
    let a2: Int = semi_major * semi_major;
    let a5: Int = a2 * a2 * semi_major;
    let mut p0: Int = 0;
    if a5 > 0 {
        p0 = (32 * m1 * m1 * m2 * m2 * m_tot * 100000) / (5 * a5);
    }
    let p_gw: Int = (p0 * f_e) / 1000;
    return QuadrupoleRadiationResult {
        f_e_milli: f_e,
        p0_rel: p0,
        p_gw_rel: p_gw,
        flag_bits: 1
    };
}

pub fn quadrupole_f_e(r: QuadrupoleRadiationResult) -> Int {
    return r.f_e_milli;
}

pub fn quadrupole_flags(r: QuadrupoleRadiationResult) -> Int {
    return r.flag_bits;
}
