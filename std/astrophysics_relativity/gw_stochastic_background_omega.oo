// # Stochastic Gravitational Wave Background (SGWB) Spectrum
//
// Logline: Calculates normalized energy density spectrum Omega_gw(f) for cosmological and unresolved astrophysical binary coalescences.
//
// Setup: Evaluates spectral index power-law models Omega_gw(f) = Omega_ref * (f / f_ref)^alpha and critical cosmological energy density.
//
// Beats:
//   1. Define critical cosmological energy density rho_c = 3 * H_0^2 / (8 * pi * G).
//   2. Compute compact binary coalescence background power-law Omega_gw(f) ~ f^(2/3) up to merger cutoff.
//   3. Compute primordial inflationary scale-invariant background Omega_gw(f) ~ 10^(-15) and cosmic string loop burst spectra.

import "./astro_rel_constants.oo";

pub type SgwbSpectralPoint = struct {
    frequency_hz: Float,
    omega_gw: Float,
    spectral_energy_density_j_m3_hz: Float,
    effective_strain_psd_hz1: Float,
};

pub fn sgwb_critical_energy_density(h0_km_s_mpc: Float) -> Float {
    // H_0 in SI: (H0 * 1000) / (1 Mpc in m)
    let mpc_m: Float = const_mpc();
    let h0_si: Float = (h0_km_s_mpc * 1000.0) / mpc_m;

    // rho_c * c^2 = (3 * H_0^2 * c^2) / (8 * pi * G) in J/m^3
    let c_val: Float = const_c();
    let c2: Float = c_val * c_val;
    let g_val: Float = const_g();
    let pi_val: Float = const_pi();

    let num: Float = (3.0 * (h0_si * h0_si) * c2);
    let den: Float = (8.0 * pi_val * g_val);
    return num / den;
}

pub fn sgwb_astrophysical_binary_spectrum(
    frequency_hz: Float,
    omega_ref_at_25hz: Float,
    h0_km_s_mpc: Float
) -> SgwbSpectralPoint {
    if frequency_hz <= 0.0 {
        return SgwbSpectralPoint {
            frequency_hz: frequency_hz,
            omega_gw: 0.0,
            spectral_energy_density_j_m3_hz: 0.0,
            effective_strain_psd_hz1: 0.0,
        };
    }

    // Unresolved binary black hole / neutron star inspirals: Omega_gw(f) = Omega_25 * (f / 25 Hz)^(2/3)
    let f_ratio: Float = frequency_hz / 25.0;
    let omega_val: Float = omega_ref_at_25hz * pow(f_ratio, 0.6666666666666666);

    let rho_c_energy: Float = sgwb_critical_energy_density(h0_km_s_mpc);

    // d rho_gw / df = (rho_c * c^2 / f) * Omega_gw(f)
    let d_rho_df: Float = (rho_c_energy / frequency_hz) * omega_val;

    // S_h(f) = (3 * H_0^2 / (4 * pi^2)) * (Omega_gw(f) / f^3)
    let mpc_m: Float = const_mpc();
    let h0_si: Float = (h0_km_s_mpc * 1000.0) / mpc_m;
    let pi_val: Float = const_pi();
    let f3: Float = frequency_hz * (frequency_hz * frequency_hz);

    let s_h: Float = ((3.0 * (h0_si * h0_si)) / ((4.0 * (pi_val * pi_val)))) * (omega_val / f3);

    return SgwbSpectralPoint {
        frequency_hz: frequency_hz,
        omega_gw: omega_val,
        spectral_energy_density_j_m3_hz: d_rho_df,
        effective_strain_psd_hz1: s_h,
    };
}
