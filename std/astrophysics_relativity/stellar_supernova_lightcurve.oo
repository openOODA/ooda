// # Supernova Light Curve & Radioactive Decay Heating Models
//
// Logline: Models Type Ia and core-collapse supernova bolometric light curves powered by 56Ni -> 56Co -> 56Fe radioactive decay.
//
// Setup: Implements the Arnett (1982) analytic photon diffusion model and exponential isotopic decay heating.
//
// Beats:
//   1. Define half-lives and specific decay energy for Nickel-56 (tau_Ni = 8.77 days) and Cobalt-56 (tau_Co = 111.3 days).
//   2. Compute instantaneous radioactive energy generation rate epsilon_rad(t).
//   3. Implement Arnett light curve bolometric luminosity peak and post-peak exponential tail.

import "./astro_rel_constants.oo";

pub type SupernovaLightCurvePoint = struct {
    time_days: Float,
    luminosity_bolometric_w: Float,
    luminosity_solar: Float,
    radioactive_heating_rate_w: Float,
    effective_temperature_k: Float,
};

pub fn supernova_nickel_heating_rate(mass_ni56_solar: Float, time_days: Float) -> Float {
    if mass_ni56_solar <= 0.0 || time_days < 0.0 {
        return 0.0;
    }
    // tau_Ni = 8.77 d (decay rate eps_Ni = 3.90e10 erg/(g*s) = 3.90e6 W/kg)
    // tau_Co = 111.3 d (decay rate eps_Co = 6.78e9 erg/(g*s) = 6.78e5 W/kg)
    let tau_ni: Float = 8.77;
    let tau_co: Float = 111.3;

    let m_ni_kg: Float = mass_ni56_solar * const_m_sun();

    // Specific heating rates in W/kg
    let eps_ni_0: Float = 3900000.0;
    let eps_co_0: Float = 678000.0;

    let arg_ni: Float = (0.0 - time_days) / tau_ni;
    let arg_co: Float = (0.0 - time_days) / tau_co;
    let decay_ni: Float = exp(arg_ni);
    let decay_co: Float = exp(arg_co) - decay_ni;

    // S_rad(t) = M_Ni * [ eps_Ni * exp(-t/tau_Ni) + eps_Co * (exp(-t/tau_Co) - exp(-t/tau_Ni)) ]
    let heating: Float = m_ni_kg * ((eps_ni_0 * decay_ni) + (eps_co_0 * math_max(decay_co, 0.0)));
    return heating;
}

pub fn supernova_arnett_luminosity(
    mass_ni56_solar: Float,
    ejecta_mass_solar: Float,
    kinetic_energy_1e51_erg: Float,
    time_days: Float
) -> SupernovaLightCurvePoint {
    let q_heat: Float = supernova_nickel_heating_rate(mass_ni56_solar, time_days);
    if time_days <= 0.0 {
        return SupernovaLightCurvePoint {
            time_days: 0.0,
            luminosity_bolometric_w: 0.0,
            luminosity_solar: 0.0,
            radioactive_heating_rate_w: q_heat,
            effective_temperature_k: 0.0,
        };
    }

    // Diffusion time tau_d ~ 15 days * (M_ej / 1 M_sun)^(3/4) * (E_k / 10^51 erg)^(-1/4)
    let m_ej_term: Float = pow(math_max(ejecta_mass_solar, 0.1), 0.75);
    let e_k_term: Float = pow(math_max(kinetic_energy_1e51_erg, 0.1), 0.25);
    let tau_diff: Float = (15.0 * m_ej_term) / e_k_term;

    // Arnett peak scaling: L(t) ~ Q_heat(t) * (1 - exp(-(tau_diff / t)^2))
    let x: Float = time_days / tau_diff;
    let neg_x2: Float = 0.0 - (x * x);
    let exp_term: Float = exp(neg_x2);
    let rise_factor: Float = 1.0 - exp_term;
    let l_bol: Float = q_heat * math_max(rise_factor, 0.01);

    let l_sun: Float = const_l_sun();
    let l_solar: Float = l_bol / l_sun;

    // Effective temperature estimation with photosphere expansion R_ph ~ v_ej * t
    // v_ej ~ sqrt(2 * E_k / M_ej) ~ 1e7 m/s (10,000 km/s)
    let v_ej: Float = 10000000.0;
    let t_sec: Float = time_days * 86400.0;
    let r_ph: Float = v_ej * t_sec;

    let sigma_sb: Float = const_sigma_sb();
    let pi_val: Float = const_pi();
    let area: Float = (4.0 * pi_val) * (r_ph * r_ph);
    let mut t_eff: Float = 0.0;
    if area > 0.0 {
        t_eff = pow(l_bol / (sigma_sb * area), 0.25);
    }

    return SupernovaLightCurvePoint {
        time_days: time_days,
        luminosity_bolometric_w: l_bol,
        luminosity_solar: l_solar,
        radioactive_heating_rate_w: q_heat,
        effective_temperature_k: t_eff,
    };
}
