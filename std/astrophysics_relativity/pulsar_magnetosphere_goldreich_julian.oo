// # Pulsar Magnetosphere, Spin-Down & Goldreich-Julian Density
//
// Logline: Omega=2pi/P; R_LC=c/Omega; tau=P/(2 Pdot). Int destub.
//
// Setup: Flattened pulsar payload. P in s; Pdot in 1e-15; I in 1e38.
//
// Beats:
//   1. Omega = 2 pi / P; R_LC = c / Omega.
//   2. Edot = 4 pi^2 I Pdot / P^3; B ~ 3.2e4 sqrt(P Pdot) scaled.
//   3. tau_yr = P/(2 Pdot) / year; rho_GJ ~ 2 Omega B.

type PulsarParameters = struct {
    period_s: Int,
    p_dot: Int,
    omega_milli: Int,
    r_lc: Int,
    edot: Int,
    b_surf: Int,
    tau_yr: Int,
    rho_gj: Int,
    flag_bits: Int
};

fn pulsar_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn pulsar_parameters_compute(
    period_s: Int,
    p_dot: Int,
    inertia: Int,
    stellar_radius: Int
) -> PulsarParameters {
    if period_s <= 0 {
        return PulsarParameters {
            period_s: period_s,
            p_dot: p_dot,
            omega_milli: 0,
            r_lc: 0,
            edot: 0,
            b_surf: 0,
            tau_yr: 0,
            rho_gj: 0,
            flag_bits: 0
        };
    }
    if p_dot <= 0 {
        return PulsarParameters {
            period_s: period_s,
            p_dot: p_dot,
            omega_milli: 0,
            r_lc: 0,
            edot: 0,
            b_surf: 0,
            tau_yr: 0,
            rho_gj: 0,
            flag_bits: 0
        };
    }
    let two_pi: Int = 2 * 3141;
    let omega_milli: Int = two_pi / period_s;
    let r_lc: Int = (299792458 * period_s * 1000) / two_pi;
    let p3: Int = period_s * period_s * period_s;
    let pi2: Int = 3141 * 3141;
    let edot: Int = (4 * pi2 * inertia * p_dot) / p3;
    let mut r_ns: Int = stellar_radius;
    if r_ns <= 0 {
        r_ns = 10;
    }
    let b_raw: Int = pulsar_isqrt(period_s * p_dot) * 32000;
    let b_surf: Int = (b_raw * 10) / r_ns;
    let tau_yr: Int = (period_s * 7922185) / p_dot;
    let rho_gj: Int = (2 * omega_milli * b_surf) / 1000;
    return PulsarParameters {
        period_s: period_s,
        p_dot: p_dot,
        omega_milli: omega_milli,
        r_lc: r_lc,
        edot: edot,
        b_surf: b_surf,
        tau_yr: tau_yr,
        rho_gj: rho_gj,
        flag_bits: 1
    };
}

pub fn pulsar_omega(p: PulsarParameters) -> Int {
    return p.omega_milli;
}

pub fn pulsar_flags(p: PulsarParameters) -> Int {
    return p.flag_bits;
}
