// # Fundamental Astrophysics, General Relativity & Gravitational Wave Constants
//
// Logline: Provides standard SI & astrophysical constants including gravitational, cosmological, speed of light, and solar units.
//
// Setup: Pure constants and conversion helpers for astrophysics, black hole physics, and cosmological calculations.
//
// Beats:
//   1. Define universal physical constants (G, c, hbar, sigma_SB, k_B, m_p, m_e, e_charge).
//   2. Define astronomical reference units (M_sun, R_sun, L_sun, AU, pc, kpc, Mpc, lyr, yr).
//   3. Provide angular, energy, and unit conversion helpers.

pub fn const_c() -> Float {
    return 299792458.0;
}

pub fn const_g() -> Float {
    return 0.0000000000667430;
}

pub fn const_hbar() -> Float {
    return 0.0000000000000000000000000000000001054571817; // 1.054571817e-34 J*s
}

pub fn const_kb() -> Float {
    return 0.00000000000000000000001380649; // 1.380649e-23 J/K
}

pub fn const_sigma_sb() -> Float {
    return 0.00000005670374419; // 5.670374419e-8 W/(m^2 K^4)
}

pub fn const_a_rad() -> Float {
    // Radiation constant a = 4 * sigma / c
    return 0.00000000000000075657; // 7.5657e-16 J/(m^3 K^4)
}

pub fn const_m_proton() -> Float {
    return 0.00000000000000000000000000167262192; // 1.67262192e-27 kg
}

pub fn const_m_electron() -> Float {
    return 0.00000000000000000000000000000091093837; // 9.1093837e-31 kg
}

pub fn const_sigma_thomson() -> Float {
    return 0.000000000000000000000000000066524587; // 6.6524587e-29 m^2
}

pub fn const_m_sun() -> Float {
    return 1988470000000000000000000000000.0; // 1.98847e30 kg
}

pub fn const_r_sun() -> Float {
    return 695700000.0; // 6.957e8 m
}

pub fn const_l_sun() -> Float {
    return 382800000000000000000000000.0; // 3.828e26 W
}

pub fn const_m_earth() -> Float {
    return 5972200000000000000000000.0; // 5.9722e24 kg
}

pub fn const_r_earth() -> Float {
    return 6371000.0; // 6.371e6 m
}

pub fn const_au() -> Float {
    return 149597870700.0; // 1.495978707e11 m
}

pub fn const_parsec() -> Float {
    return 30856775814913670.0; // 3.085677581491367e16 m (~3.26156 ly)
}

pub fn const_kpc() -> Float {
    return 30856775814913670000.0; // 1000 pc
}

pub fn const_mpc() -> Float {
    return 30856775814913670000000.0; // 1e6 pc
}

pub fn const_light_year() -> Float {
    return 9460730472580800.0; // 9.4607304725808e15 m
}

pub fn const_julian_year_s() -> Float {
    return 31557600.0; // 365.25 * 86400 s
}

pub fn const_pi() -> Float {
    return 3.141592653589793;
}

pub fn const_two_pi() -> Float {
    return 6.283185307179586;
}

pub fn const_deg_to_rad() -> Float {
    return 0.017453292519943295;
}

pub fn const_rad_to_deg() -> Float {
    return 57.29577951308232;
}

pub fn const_schwarzschild_radius(mass_kg: Float) -> Float {
    return (2.0 * const_g() * mass_kg) / (const_c() * const_c());
}

pub fn const_planck_mass() -> Float {
    return 0.00000002176434; // 2.176434e-8 kg
}

pub fn const_planck_length() -> Float {
    return 0.00000000000000000000000000000000001616255; // 1.616255e-35 m
}

pub fn const_planck_time() -> Float {
    return 0.0000000000000000000000000000000000000000005391247; // 5.391247e-44 s
}

pub fn math_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

pub fn math_max(a: Float, b: Float) -> Float {
    if a > b {
        return a;
    }
    return b;
}

pub fn math_min(a: Float, b: Float) -> Float {
    if a < b {
        return a;
    }
    return b;
}
