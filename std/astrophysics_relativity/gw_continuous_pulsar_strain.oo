// # Continuous Gravitational Waves from Triaxial Rotating Neutron Stars
//
// Logline: Calculates monochromatic continuous gravitational wave strain amplitudes (h_0) and spin-down upper limits from deformed rotating neutron stars.
//
// Setup: Solves quadrupole strain emission for millisecond pulsars and Crab/Vela with crustal ellipticity epsilon = (I_xx - I_yy) / I_zz.
//
// Beats:
//   1. Compute continuous GW emission frequency f_gw = 2 * f_rot and characteristic strain amplitude h_0 = (4*pi^2 * G / c^4) * (I_zz * f_gw^2 * epsilon / d).
//   2. Compute theoretical spin-down strain limit h_0_sd = (1 / d) * sqrt( (5/2) * (G * I_zz / c^3) * |fdot| / f_rot ).
//   3. Invert observational strain upper limits to constrain maximum sustainable neutron star crustal mountain heights.

import "./astro_rel_constants.oo";

pub type ContinuousPulsarGWResult = struct {
    rotation_frequency_hz: Float,
    gw_frequency_hz: Float,
    ellipticity_epsilon: Float,
    distance_m: Float,
    strain_amplitude_h0: Float,
    spin_down_limit_h0_sd: Float,
    gw_luminosity_w: Float,
};

pub fn gw_continuous_pulsar_strain(
    f_rot_hz: Float,
    f_dot_hz_s: Float,
    ellipticity: Float,
    moment_of_inertia_kg_m2: Float,
    distance_m: Float
) -> ContinuousPulsarGWResult {
    if f_rot_hz <= 0.0 || distance_m <= 0.0 {
        return ContinuousPulsarGWResult {
            rotation_frequency_hz: f_rot_hz,
            gw_frequency_hz: 0.0,
            ellipticity_epsilon: ellipticity,
            distance_m: distance_m,
            strain_amplitude_h0: 0.0,
            spin_down_limit_h0_sd: 0.0,
            gw_luminosity_w: 0.0,
        };
    }

    let f_gw: Float = 2.0 * f_rot_hz;
    let g_val: Float = const_g();
    let c_val: Float = const_c();
    let c4: Float = c_val * (c_val * (c_val * c_val));
    let pi_val: Float = const_pi();

    // h_0 = (4 * pi^2 * G * I_zz * f_gw^2 * epsilon) / (c^4 * d)
    let num_h0: Float = (4.0 * (pi_val * pi_val) * g_val * moment_of_inertia_kg_m2 * (f_gw * f_gw) * ellipticity);
    let den_h0: Float = c4 * distance_m;
    let h0: Float = if den_h0 > 0.0 { num_h0 / den_h0 } else { 0.0 };

    // Spin-down limit: h_0_sd = (1 / d) * sqrt( (5/2) * (G * I_zz / c^3) * |fdot| / f_rot )
    let c3: Float = c_val * (c_val * c_val);
    let abs_fdot: Float = math_abs(f_dot_hz_s);
    let inside_sd: Float = 2.5 * ((g_val * moment_of_inertia_kg_m2) / c3) * (abs_fdot / f_rot_hz);
    let h0_sd: Float = (1.0 / distance_m) * sqrt(math_max(inside_sd, 0.0));

    // GW Luminosity: dE/dt = (32 / 5) * (G / c^5) * I_zz^2 * epsilon^2 * omega^6
    let omega: Float = const_two_pi() * f_rot_hz;
    let omega6: Float = pow(omega, 6.0);
    let c5: Float = pow(c_val, 5.0);
    let num_lum: Float = (32.0 / 5.0) * (g_val / c5) * (moment_of_inertia_kg_m2 * moment_of_inertia_kg_m2) * (ellipticity * ellipticity) * omega6;

    return ContinuousPulsarGWResult {
        rotation_frequency_hz: f_rot_hz,
        gw_frequency_hz: f_gw,
        ellipticity_epsilon: ellipticity,
        distance_m: distance_m,
        strain_amplitude_h0: h0,
        spin_down_limit_h0_sd: h0_sd,
        gw_luminosity_w: num_lum,
    };
}
