// # Magnetar Crustal Physics, Hall Drift & Giant Flare Energetics
//
// Logline: Models ultra-strong magnetic field evolution (B ~ 10^10 - 10^11 T), Hall drift, Ohmic dissipation, and crustal flare energetics.
//
// Setup: Implements Thompson & Duncan (1995, 1996) magnetar crustal magnetic energy release and giant flare luminosity models.
//
// Beats:
//   1. Calculate total magnetic energy stored in magnetar interior E_mag = (B^2 / 2*mu_0) * Volume.
//   2. Compute Hall drift timescale tau_Hall ~ 10^4 yr * (B / 10^10 T)^(-1) and Ohmic decay timescale tau_Ohm.
//   3. Model crustal shear stress threshold, catastrophic crust failure, and giant flare peak luminosity.

import "./astro_rel_constants.oo";

pub type MagnetarState = struct {
    magnetic_field_tesla: Float,
    magnetic_energy_joules: Float,
    hall_timescale_yr: Float,
    ohmic_timescale_yr: Float,
    crustal_shear_stress_pa: Float,
    giant_flare_max_energy_j: Float,
    is_super_critical: Bool // B > B_QED ~ 4.414e9 Tesla
};

pub fn magnetar_quantum_critical_b() -> Float {
    // B_QED = m_e^2 * c^3 / (e * hbar) ~ 4.414e9 Tesla (4.414e13 Gauss)
    return 4414000000.0;
}

pub fn magnetar_evaluate_state(
    magnetic_field_tesla: Float,
    neutron_star_radius_m: Float,
    crust_thickness_m: Float
) -> MagnetarState {
    let b: Float = magnetic_field_tesla;
    let r: Float = neutron_star_radius_m;

    let b_qed: Float = magnetar_quantum_critical_b();
    let is_qed: Bool = b > b_qed;

    if b <= 0.0 || r <= 0.0 {
        return MagnetarState {
            magnetic_field_tesla: b,
            magnetic_energy_joules: 0.0,
            hall_timescale_yr: 0.0,
            ohmic_timescale_yr: 0.0,
            crustal_shear_stress_pa: 0.0,
            giant_flare_max_energy_j: 0.0,
            is_super_critical: false
        };
    }

    let pi_val: Float = const_pi();
    let mu_0: Float = 0.0000012566370614359173; // 4*pi*1e-7

    // Magnetic energy density u_mag = B^2 / (2 * mu_0)
    let u_mag: Float = (b * b) / (2.0 * mu_0);

    // Total stellar volume V = (4/3) * pi * R^3
    let r3: Float = r * (r * r);
    let vol: Float = (1.3333333333333333 * pi_val) * r3;
    let e_mag: Float = u_mag * vol;

    // Crust volume
    let r_core: Float = math_max(r - crust_thickness_m, 0.0);
    let vol_crust: Float = ((1.3333333333333333 * pi_val) * (r3 - (r_core * (r_core * r_core))));
    let e_crust_mag: Float = u_mag * vol_crust;

    // Hall timescale tau_Hall ~ 10^4 yr * (10^10 T / B)
    let tau_hall: Float = if b > 0.0 {
        10000.0 * (10000000000.0 / b)
    } else {
        0.0
    };

    // Ohmic decay timescale tau_Ohm ~ 10^6 yr
    let tau_ohm: Float = 1000000.0;

    // Crustal magnetic stress: sigma_mag = B^2 / (8 * pi * mu_0)
    let sigma_mag: Float = (b * b) / ((8.0 * pi_val) * mu_0);

    // Giant flare release fraction ~ 1-10% of crustal magnetic energy
    let e_flare_max: Float = 0.1 * e_crust_mag;

    return MagnetarState {
        magnetic_field_tesla: b,
        magnetic_energy_joules: e_mag,
        hall_timescale_yr: tau_hall,
        ohmic_timescale_yr: tau_ohm,
        crustal_shear_stress_pa: sigma_mag,
        giant_flare_max_energy_j: e_flare_max,
        is_super_critical: is_qed
    };
}
