// # Black Hole Thermodynamics & Hawking Evaporation
//
// Logline: T_H=1/(8 pi M); S=4 pi M^2; tau ~ 5120 pi M^3. Int destub.
//
// Setup: Flattened thermo payload. pi=314. Geometric / Planck units.
//
// Beats:
//   1. T_H milli = 1e6 / (8 pi M).
//   2. A = 16 pi M^2; S = A/4; bits = S / ln2.
//   3. P ~ 1/(15360 pi M^2); tau = 5120 pi M^3.

type HawkingThermodynamicsResult = struct {
    mass: Int,
    area: Int,
    t_hawking: Int,
    s_bh: Int,
    entropy_bits: Int,
    evap_power: Int,
    lifetime: Int,
    flag_bits: Int
};

pub fn gr_hawking_temperature(mass: Int) -> Int {
    if mass <= 0 {
        return 0;
    }
    return 1000000 / (8 * 314 * mass);
}

pub fn gr_bekenstein_hawking_entropy(mass: Int) -> Int {
    if mass <= 0 {
        return 0;
    }
    return (4 * 314 * mass * mass) / 100;
}

pub fn gr_hawking_thermodynamics_compute(mass: Int) -> HawkingThermodynamicsResult {
    if mass <= 0 {
        return HawkingThermodynamicsResult {
            mass: mass,
            area: 0,
            t_hawking: 0,
            s_bh: 0,
            entropy_bits: 0,
            evap_power: 0,
            lifetime: 0,
            flag_bits: 0
        };
    }
    let t_h: Int = 1000000 / (8 * 314 * mass);
    let area: Int = (16 * 314 * mass * mass) / 100;
    let s_bh: Int = area / 4;
    let bits: Int = (s_bh * 1000) / 693;
    let den_p: Int = 15360 * 314 * mass * mass;
    let mut p_evap: Int = 0;
    if den_p > 0 {
        p_evap = 100000000000 / den_p;
    }
    let tau: Int = (5120 * 314 * mass * mass * mass) / 1000;
    return HawkingThermodynamicsResult {
        mass: mass,
        area: area,
        t_hawking: t_h,
        s_bh: s_bh,
        entropy_bits: bits,
        evap_power: p_evap,
        lifetime: tau,
        flag_bits: 1
    };
}

pub fn hawking_temp(r: HawkingThermodynamicsResult) -> Int {
    return r.t_hawking;
}

pub fn hawking_flags(r: HawkingThermodynamicsResult) -> Int {
    return r.flag_bits;
}
