// # Bondi-Hoyle-Lyttleton Spherical & Wind Accretion Solver
//
// Logline: r_B = 2M / v_eff^2; Mdot = pi M^2 rho / v_eff^3. Int destub.
//
// Setup: Geometric G=1. gamma=5/3 sound speed. Flattened BHL payload.
//
// Beats:
//   1. c_s^2 = 5 T / (3 mu); v_eff^2 = c_s^2 + v_rel^2.
//   2. r_B = 2 M / v_eff^2; r_s = M / (2 c_s^2) in milli.
//   3. lambda=1/4 so 4 pi lambda = pi; Mdot = pi M^2 rho / v_eff^3.

type BondiHoyleResult = struct {
    mass: Int,
    sound_c2: Int,
    v_eff: Int,
    bondi_radius: Int,
    sonic_radius: Int,
    mdot: Int,
    flag_bits: Int
};

fn bhl_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn bhl_ambient_sound_speed(temp: Int, mu: Int) -> Int {
    if temp <= 0 {
        return 0;
    }
    if mu <= 0 {
        return 0;
    }
    let c2: Int = (5 * temp) / (3 * mu);
    return bhl_isqrt(c2);
}

pub fn bhl_accretion_compute(
    mass: Int,
    rho: Int,
    temp: Int,
    v_rel: Int,
    mu: Int
) -> BondiHoyleResult {
    if mass <= 0 {
        return BondiHoyleResult {
            mass: mass,
            sound_c2: 0,
            v_eff: 0,
            bondi_radius: 0,
            sonic_radius: 0,
            mdot: 0,
            flag_bits: 0
        };
    }
    if rho <= 0 {
        return BondiHoyleResult {
            mass: mass,
            sound_c2: 0,
            v_eff: 0,
            bondi_radius: 0,
            sonic_radius: 0,
            mdot: 0,
            flag_bits: 0
        };
    }
    if mu <= 0 {
        return BondiHoyleResult {
            mass: mass,
            sound_c2: 0,
            v_eff: 0,
            bondi_radius: 0,
            sonic_radius: 0,
            mdot: 0,
            flag_bits: 0
        };
    }
    let c2: Int = (5 * temp) / (3 * mu);
    let v2: Int = c2 + (v_rel * v_rel);
    let v_eff: Int = bhl_isqrt(v2);
    if v_eff <= 0 {
        return BondiHoyleResult {
            mass: mass,
            sound_c2: c2,
            v_eff: 0,
            bondi_radius: 0,
            sonic_radius: 0,
            mdot: 0,
            flag_bits: 0
        };
    }
    let r_bondi: Int = (2 * mass * 1000) / v2;
    let mut r_sonic: Int = 0;
    if c2 > 0 {
        r_sonic = (mass * 1000) / (2 * c2);
    }
    let v3: Int = v_eff * v2;
    let mdot: Int = (314 * mass * mass * rho) / v3;
    return BondiHoyleResult {
        mass: mass,
        sound_c2: c2,
        v_eff: v_eff,
        bondi_radius: r_bondi,
        sonic_radius: r_sonic,
        mdot: mdot,
        flag_bits: 1
    };
}

pub fn bhl_radius(r: BondiHoyleResult) -> Int {
    return r.bondi_radius;
}

pub fn bhl_flags(r: BondiHoyleResult) -> Int {
    return r.flag_bits;
}
