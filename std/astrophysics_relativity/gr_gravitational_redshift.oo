// # Gravitational Time Dilation & Redshift
//
// Logline: z = 1/sqrt(1 - rs/r) - 1. Int destub (milli, geometric units).
//
// Setup: rs = 2M. Integer Newton isqrt for the lapse.
//
// Beats:
//   1. f = 1 - rs/r.
//   2. dtau/dt = sqrt(f); 1+z = 1/sqrt(f).
//   3. Horizon gate: r <= rs yields flags = 0.

type GravitationalRedshiftResult = struct {
    radius: Int,
    mass: Int,
    z_milli: Int,
    dilation_milli: Int,
    flag_bits: Int
};

fn gr_redshift_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn gr_schwarzschild_redshift(mass: Int, radius: Int) -> GravitationalRedshiftResult {
    let rs: Int = 2 * mass;
    if mass <= 0 {
        return GravitationalRedshiftResult {
            radius: radius,
            mass: mass,
            z_milli: 0,
            dilation_milli: 0,
            flag_bits: 0
        };
    }
    if radius <= rs {
        return GravitationalRedshiftResult {
            radius: radius,
            mass: mass,
            z_milli: 0,
            dilation_milli: 0,
            flag_bits: 0
        };
    }
    let f_milli: Int = 1000 - ((1000 * rs) / radius);
    let dil: Int = gr_redshift_isqrt(f_milli * 1000);
    let mut one_plus_z: Int = 0;
    if dil > 0 {
        one_plus_z = 1000000 / dil;
    }
    let mut z_milli: Int = 0;
    if one_plus_z > 1000 {
        z_milli = one_plus_z - 1000;
    }
    return GravitationalRedshiftResult {
        radius: radius,
        mass: mass,
        z_milli: z_milli,
        dilation_milli: dil,
        flag_bits: 1
    };
}

pub fn gr_redshift_z(r: GravitationalRedshiftResult) -> Int {
    return r.z_milli;
}

pub fn gr_redshift_flags(r: GravitationalRedshiftResult) -> Int {
    return r.flag_bits;
}
