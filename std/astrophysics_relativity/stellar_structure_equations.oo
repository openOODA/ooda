// # Standard 1D Stellar Structure Differential Equations
//
// Logline: Formulates fundamental differential equations governing mass continuity, hydrostatic equilibrium, energy generation, and radiative transport.
//
// Setup: Evaluates stellar interior gradients as functions of radial coordinate r and enclosed mass M(r).
//
// Beats:
//   1. Define stellar state variables: radius r, enclosed mass M(r), pressure P(r), luminosity L(r), temperature T(r).
//   2. Compute hydrostatic equilibrium gradient dP/dr and mass continuity dM/dr.
//   3. Compute radiative temperature gradient dT/dr and energy generation dL/dr with Kramer's opacity.

import "./astro_rel_constants.oo";

pub type StellarInteriorPoint = struct {
    radius_m: Float,
    enclosed_mass_kg: Float,
    pressure_pa: Float,
    temperature_k: Float,
    luminosity_w: Float,
    density_kg_m3: Float
};

pub type StellarGradients = struct {
    dm_dr: Float,
    dp_dr: Float,
    dt_dr: Float,
    dl_dr: Float
};

pub fn stellar_ideal_gas_density(pressure: Float, temperature: Float, mean_molecular_weight: Float) -> Float {
    if temperature <= 0.0 {
        return 0.0;
    }
    // P = rho * k_B * T / (mu * m_p)  =>  rho = P * mu * m_p / (k_B * T)
    let m_u: Float = (mean_molecular_weight * const_m_proton());
    return (pressure * m_u) / (const_kb() * temperature);
}

pub fn stellar_kramers_opacity(density: Float, temperature: Float) -> Float {
    if temperature <= 0.0 {
        return 0.0;
    }
    // kappa = kappa_0 * rho * T^(-3.5), standard kappa_0 ~ 4.34 * 10^20 in SI
    let t_35: Float = pow(temperature, 3.5);
    let kappa_0: Float = 434000000000000000000.0;
    return (kappa_0 * density) / t_35;
}

pub fn stellar_gradients_compute(
    point: StellarInteriorPoint,
    eps_nuclear: Float,
    kappa_opacity: Float
) -> StellarGradients {
    let r: Float = (point).radius_m;
    let m: Float = (point).enclosed_mass_kg;
    let p: Float = (point).pressure_pa;
    let t: Float = (point).temperature_k;
    let l: Float = (point).luminosity_w;
    let rho: Float = (point).density_kg_m3;

    if r <= 1.0 {
        return StellarGradients {
            dm_dr: 0.0,
            dp_dr: 0.0,
            dt_dr: 0.0,
            dl_dr: 0.0
        };
    }

    let pi_val: Float = const_pi();

    // 1. Mass continuity: dM/dr = 4 * pi * r^2 * rho
    let dm_dr: Float = (4.0 * pi_val) * (r * r) * rho;

    // 2. Hydrostatic equilibrium: dP/dr = -G * M(r) * rho / r^2
    let dp_dr: Float = (0.0 - const_g()) * (m * rho) / (r * r);

    // 3. Energy conservation: dL/dr = 4 * pi * r^2 * rho * eps
    let dl_dr: Float = (4.0 * pi_val) * (r * r) * (rho * eps_nuclear);

    // 4. Radiative transport: dT/dr = -3 * kappa * rho * L / (16 * pi * a * c * r^2 * T^3)
    let a_rad: Float = const_a_rad();
    let c_val: Float = const_c();
    let t3: Float = t * (t * t);
    let denominator: Float = (16.0 * pi_val) * a_rad * c_val * (r * r) * t3;

    let mut dt_dr: Float = 0.0;
    if denominator > 0.0 {
        dt_dr = (0.0 - (3.0 * kappa_opacity * rho * l)) / denominator;
    }

    return StellarGradients {
        dm_dr: dm_dr,
        dp_dr: dp_dr,
        dt_dr: dt_dr,
        dl_dr: dl_dr
    };
}
