// # Cosmic Microwave Background (CMB) Recombination & Decoupling
//
// Logline: Models primordial hydrogen recombination, optical depth tau(z), and visibility function g(z) for CMB decoupling.
//
// Setup: Implements Saha ionization equilibrium and Peebles (1968) effective three-level atom recombination dynamics.
//
// Beats:
//   1. Compute primordial photon-to-baryon ratio and temperature evolution T_cmb(z) = T_0 * (1 + z).
//   2. Solve Saha ionization equation for free electron fraction x_e(z) in thermal equilibrium.
//   3. Compute Thomson scattering optical depth tau(z) and peak of the CMB visibility function g(z) near z = 1100.

import "./astro_rel_constants.oo";

pub type RecombinationState = struct {
    redshift_z: Float,
    temperature_cmb_k: Float,
    ionization_fraction_xe: Float,
    optical_depth_tau: Float,
    visibility_function_g: Float,
    is_decoupled: Bool,
};

pub fn cmb_temperature_k(redshift_z: Float) -> Float {
    // T_0 = 2.7255 K (Fixsen 2009)
    let t_0: Float = 2.7255;
    return t_0 * (1.0 + redshift_z);
}

pub fn cmb_saha_ionization_fraction(
    redshift_z: Float,
    omega_baryon_h2: Float
) -> Float {
    let t_k: Float = cmb_temperature_k(redshift_z);
    if t_k <= 0.0 {
        return 0.0;
    }

    // Hydrogen ionization energy B = 13.6 eV = 2.179e-18 J
    // (B / k_B) ~ 157,800 K
    let b_over_k: Float = 157800.0;

    // Saha equation: (1 - x_e) / x_e^2 = n_b * (2*pi*m_e*k_B*T / h^2)^(-3/2) * exp(B / k_B*T)
    // Dimensionless RHS factor f_saha
    let arg_exp: Float = math_min(b_over_k / t_k, 50.0);
    let exp_term: Float = exp(arg_exp);

    // Baryon density n_b(z) ~ 1.12e-5 * omega_baryon_h2 * (1+z)^3 cm^-3
    let one_plus_z: Float = 1.0 + redshift_z;
    let z3: Float = one_plus_z * (one_plus_z * one_plus_z);
    let n_b_cm3: Float = 0.0000112 * omega_baryon_h2 * z3;

    // Thermal de Broglie wavelength factor: (2*pi*m_e*k_B*T / h^2)^(3/2) ~ 2.41e15 * T^(3/2) cm^-3
    let de_broglie: Float = 2410000000000000.0 * pow(t_k, 1.5);
    let rhs_saha: Float = (n_b_cm3 / math_max(de_broglie, 1.0)) * exp_term;

    // Solve quadratic: x_e^2 * rhs + x_e - 1 = 0  =>  x_e = (-1 + sqrt(1 + 4*rhs)) / (2*rhs)
    if rhs_saha <= 0.00001 {
        return 1.0; // Fully ionized
    }
    let sqrt_term: Float = sqrt(1.0 + (4.0 * rhs_saha));
    let x_e: Float = (sqrt_term - 1.0) / (2.0 * rhs_saha);

    return math_max(math_min(x_e, 1.0), 0.0001); // Residual freeze-out floor ~ 1e-4
}

pub fn cmb_recombination_evaluate(
    redshift_z: Float,
    omega_baryon_h2: Float
) -> RecombinationState {
    let t_cmb: Float = cmb_temperature_k(redshift_z);
    let x_e: Float = cmb_saha_ionization_fraction(redshift_z, omega_baryon_h2);

    // Approximate optical depth tau(z) ~ (z / 1100)^3.5 * x_e
    let z_ratio: Float = redshift_z / 1100.0;
    let tau: Float = pow(math_max(z_ratio, 0.001), 3.5) * x_e;

    // Visibility function g(z) = |dtau/dz| * exp(-tau), peaked near z ~ 1090
    let arg_neg_tau: Float = 0.0 - tau;
    let exp_neg_tau: Float = exp(arg_neg_tau);

    let dtau_dz: Float = if redshift_z > 0.0 { (3.5 * tau) / redshift_z } else { 0.0 };
    let g_vis: Float = dtau_dz * exp_neg_tau;

    let is_dec: Bool = redshift_z < 1100.0 && tau < 1.0;

    return RecombinationState {
        redshift_z: redshift_z,
        temperature_cmb_k: t_cmb,
        ionization_fraction_xe: x_e,
        optical_depth_tau: tau,
        visibility_function_g: g_vis,
        is_decoupled: is_dec,
    };
}
