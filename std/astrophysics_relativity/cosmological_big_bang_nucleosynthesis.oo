// # Big Bang Nucleosynthesis (BBN) Primordial Abundances
//
// Logline: Calculates primordial Helium-4 (Y_p), Deuterium (D/H), and Helium-3 isotopic yields as functions of baryon-to-photon ratio eta.
//
// Setup: Solves weak interaction freeze-out (n/p ratio) and nuclear bottleneck nuclear synthesis at T ~ 0.1 MeV.
//
// Beats:
//   1. Compute weak-interaction neutron-proton freeze-out temperature T_freeze ~ 0.8 MeV and ratio (n/p)_freeze = exp(-Delta m / T).
//   2. Calculate free neutron beta decay prior to the deuterium bottleneck at t_BBN ~ 200 s.
//   3. Compute primordial Helium-4 mass fraction Y_p = 2*(n/p) / (1 + n/p) ~ 0.245 and Deuterium abundance ratio D/H ~ 2.5e-5.

import "./astro_rel_constants.oo";

pub type BbnAbundanceResult = struct {
    baryon_photon_ratio_eta10: Float, // eta_10 = 10^10 * (n_b / n_gamma) ~ 6.1
    freeze_out_np_ratio: Float,
    decayed_np_ratio: Float,
    helium4_mass_fraction_yp: Float,
    deuterium_abundance_dh: Float,
    helium3_abundance_he3h: Float,
};

pub fn bbn_freeze_out_np(t_freeze_mev: Float) -> Float {
    // Delta_m = m_n - m_p = 1.293 MeV
    let delta_m: Float = 1.293;
    let t: Float = math_max(t_freeze_mev, 0.1);
    let arg: Float = (0.0 - delta_m) / t;
    return exp(arg);
}

pub fn bbn_abundances_compute(
    baryon_photon_ratio_eta10: Float,
    neutron_lifetime_s: Float
) -> BbnAbundanceResult {
    let eta10: Float = math_max(baryon_photon_ratio_eta10, 1.0);
    let tau_n: Float = if neutron_lifetime_s > 0.0 { neutron_lifetime_s } else { 879.4 };

    // 1. Freeze-out at T ~ 0.8 MeV: (n/p)_0 ~ 1/6 ~ 0.1667
    let np_freeze: Float = bbn_freeze_out_np(0.8);

    // 2. Neutron decay between freeze-out (t ~ 1s) and deuterium bottleneck (t ~ 200s):
    let t_bottleneck: Float = 200.0;
    let decay_factor: Float = exp((0.0 - t_bottleneck) / tau_n);
    let np_decayed: Float = np_freeze * decay_factor; // drops from ~0.167 to ~0.133

    // 3. Helium-4 mass fraction: Y_p = 2 * (n/p) / (1 + (n/p)) + standard nuclear corrections
    // Analytic scaling with eta_10: Y_p ~ 0.2462 + 0.009 * ln(eta_10 / 6.0)
    let ln_eta: Float = ln(eta10 / 6.0);
    let y_p: Float = 0.2462 + (0.009 * ln_eta);

    // 4. Deuterium abundance (D/H): highly sensitive to baryon density (D/H ~ eta^-1.6)
    // (D/H) ~ 2.54e-5 * (6.1 / eta_10)^1.6
    let eta_ratio: Float = 6.1 / eta10;
    let dh: Float = 0.0000254 * pow(eta_ratio, 1.6);

    // 5. Helium-3 abundance: (3He/H) ~ 1.0e-5 * (6.1 / eta_10)^0.6
    let he3h: Float = 0.000010 * pow(eta_ratio, 0.6);

    return BbnAbundanceResult {
        baryon_photon_ratio_eta10: eta10,
        freeze_out_np_ratio: np_freeze,
        decayed_np_ratio: np_decayed,
        helium4_mass_fraction_yp: y_p,
        deuterium_abundance_dh: dh,
        helium3_abundance_he3h: he3h,
    };
}
