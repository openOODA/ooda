// # Dynamical Dark Energy CPL Equation of State
//
// Logline: w(z) = w0 + wa * z / (1+z). Int destub (milli-w).
//
// Setup: Flattened CPL + Omega_m(a) for Lambda (w0=-1, wa=0).
//
// Beats:
//   1. w_milli = w0 + wa * z / (1+z).
//   2. a = 1/(1+z); rho_m ~ a^-3; Omega_m(a) for constant DE.
//   3. Phantom flag when w < -1.

type DarkEnergyEvolutionPoint = struct {
    redshift_z: Int,
    w_milli: Int,
    omega_m_milli: Int,
    flag_bits: Int
};

pub fn dark_energy_w_milli(w0: Int, wa: Int, redshift_z: Int) -> Int {
    let one_plus_z: Int = 1 + redshift_z;
    if one_plus_z <= 0 {
        return w0;
    }
    return w0 + ((wa * redshift_z) / one_plus_z);
}

pub fn dark_energy_evaluate_point(
    w0: Int,
    wa: Int,
    om_m_milli: Int,
    om_de_milli: Int,
    redshift_z: Int
) -> DarkEnergyEvolutionPoint {
    let w_milli: Int = dark_energy_w_milli(w0, wa, redshift_z);
    let a_milli: Int = 1000 / (1 + redshift_z);
    let a3: Int = a_milli * a_milli * a_milli;
    let mut m_ratio: Int = 0;
    if a3 > 0 {
        m_ratio = 1000000000 / a3;
    }
    let de_ratio: Int = 1000;
    let num_m: Int = om_m_milli * m_ratio;
    let den: Int = num_m + ((om_de_milli * de_ratio) / 1000);
    let mut om_a: Int = 1000;
    if den > 0 {
        om_a = (num_m * 1000) / den;
    }
    let mut phantom: Int = 0;
    if w_milli < (0 - 1000) {
        phantom = 1;
    }
    let mut valid: Int = 0;
    if redshift_z >= 0 {
        valid = 1;
    }
    let p_bit: Int = phantom * 2;
    let fbits: Int = valid + p_bit;
    return DarkEnergyEvolutionPoint {
        redshift_z: redshift_z,
        w_milli: w_milli,
        omega_m_milli: om_a,
        flag_bits: fbits
    };
}

pub fn dark_energy_w(p: DarkEnergyEvolutionPoint) -> Int {
    return p.w_milli;
}

pub fn dark_energy_flags(p: DarkEnergyEvolutionPoint) -> Int {
    return p.flag_bits;
}
