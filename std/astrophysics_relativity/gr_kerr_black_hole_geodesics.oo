// # Kerr Black Hole Geodesic Integrator & Carter Constant
//
// Logline: Integrates null (photon) and timelike (massive particle) first-order geodesic equations in Kerr spacetime using Carter's constant of motion.
//
// Setup: Solves decoupled Hamilton-Jacobi equations for radial R(r) and polar Theta(theta) motions in Boyer-Lindquist coordinates.
//
// Beats:
//   1. Define constants of motion: specific energy E, axial angular momentum L_z, Carter constant Q, and rest mass parameter mu (0 or 1).
//   2. Formulate radial effective potential R(r) = [E*(r^2 + a^2) - a*L_z]^2 - Delta * [mu^2 * r^2 + (L_z - a*E)^2 + Q].
//   3. Implement RK4 numerical geodesic propagation step for orbital ray tracing and particle trajectories.

import "./astro_rel_constants.oo";

pub type KerrGeodesicConstants = struct {
    energy_e: Float,
    angular_momentum_lz: Float,
    carter_constant_q: Float,
    mass_param_mu: Float, // 0.0 for photon (null), 1.0 for massive particle (timelike)
};

pub type KerrGeodesicState = struct {
    r: Float,
    theta: Float,
    phi: Float,
    t: Float,
    p_r: Float, // Sigma * dr/dlambda
    p_theta: Float, // Sigma * dtheta/dlambda
};

pub fn kerr_radial_potential(
    r: Float,
    a: Float,
    m: Float,
    consts: KerrGeodesicConstants
) -> Float {
    let e: Float = (consts).energy_e;
    let lz: Float = (consts).angular_momentum_lz;
    let q: Float = (consts).carter_constant_q;
    let mu: Float = (consts).mass_param_mu;

    let r2: Float = r * r;
    let a2: Float = a * a;
    let delta: Float = (r2 - (2.0 * m * r)) + a2;

    // P = E*(r^2 + a^2) - a*L_z
    let big_p: Float = (e * (r2 + a2)) - (a * lz);
    let term1: Float = big_p * big_p;

    // term2 = Delta * [ mu^2 * r^2 + (L_z - a*E)^2 + Q ]
    let lz_minus_ae: Float = lz - (a * e);
    let term2: Float = delta * (((mu * mu) * r2) + (lz_minus_ae * lz_minus_ae) + q);

    return term1 - term2;
}

pub fn kerr_polar_potential(
    theta: Float,
    a: Float,
    consts: KerrGeodesicConstants
) -> Float {
    let e: Float = (consts).energy_e;
    let lz: Float = (consts).angular_momentum_lz;
    let q: Float = (consts).carter_constant_q;
    let mu: Float = (consts).mass_param_mu;

    let cos_th: Float = cos(theta);
    let sin_th: Float = sin(theta);
    let cos2: Float = cos_th * cos_th;
    let sin2: Float = sin_th * sin_th;

    // Theta(th) = Q - cos^2(th) * [ a^2 * (mu^2 - E^2) + L_z^2 / sin^2(th) ]
    let term_in_bracket: Float = ((a * a) * ((mu * mu) - (e * e))) + (if sin2 > 0.00001 { (lz * lz) / sin2 } else { 0.0 });
    return q - (cos2 * term_in_bracket);
}

pub fn kerr_geodesic_step(
    state: KerrGeodesicState,
    a: Float,
    m: Float,
    consts: KerrGeodesicConstants,
    d_lambda: Float
) -> KerrGeodesicState {
    let r: Float = (state).r;
    let th: Float = (state).theta;
    let phi: Float = (state).phi;
    let t: Float = (state).t;

    let r_pot: Float = kerr_radial_potential(r, a, m, consts);
    let th_pot: Float = kerr_polar_potential(th, a, consts);

    let sigma: Float = (r * r) + ((a * a) * (cos(th) * cos(th)));
    if sigma <= 0.0001 {
        return state;
    }

    let dr_dlam: Float = (if r_pot >= 0.0 { sqrt(r_pot) } else { 0.0 }) / sigma;
    let dth_dlam: Float = (if th_pot >= 0.0 { sqrt(th_pot) } else { 0.0 }) / sigma;

    // Coordinate derivatives dphi/dlambda and dt/dlambda
    let sin2: Float = sin(th) * sin(th);
    let delta: Float = ((r * r) - (2.0 * m * r)) + (a * a);
    let e: Float = (consts).energy_e;
    let lz: Float = (consts).angular_momentum_lz;

    let big_p: Float = (e * ((r * r) + (a * a))) - (a * lz);
    let dphi_dlam: Float = ((if sin2 > 0.00001 { lz / sin2 } else { 0.0 }) - (a * e) + (if delta > 0.0001 { (a * big_p) / delta } else { 0.0 })) / sigma;
    let dt_dlam: Float = ((if delta > 0.0001 { (((r * r) + (a * a)) * big_p) / delta } else { 0.0 }) - ((a * a * e * sin2) - (a * lz))) / sigma;

    return KerrGeodesicState {
        r: r + (dr_dlam * d_lambda),
        theta: th + (dth_dlam * d_lambda),
        phi: phi + (dphi_dlam * d_lambda),
        t: t + (dt_dlam * d_lambda),
        p_r: dr_dlam * sigma,
        p_theta: dth_dlam * sigma,
    };
}
