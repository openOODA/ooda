// # Lambda-CDM Cosmological Friedmann Equation Solver
//
// Logline: E^2 = Om_r (1+z)^4 + Om_m (1+z)^3 + Om_k (1+z)^2 + Om_L. Int destub.
//
// Setup: Flattened expansion point. Densities in milli. H0 in 0.1 km/s/Mpc.
//
// Beats:
//   1. E(z) = sqrt(sum Omega_i (1+z)^{n_i}).
//   2. H(z) = H0 E; a = 1/(1+z).
//   3. q = (Om_r (1+z)^4 + 0.5 Om_m (1+z)^3 - Om_L) / E^2.

type FriedmannExpansionPoint = struct {
    redshift_z: Int,
    scale_a_milli: Int,
    hubble: Int,
    e_milli: Int,
    q_milli: Int,
    rho_c: Int,
    flag_bits: Int
};

fn friedmann_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn friedmann_e_z(
    om_m_milli: Int,
    om_r_milli: Int,
    om_k_milli: Int,
    om_l_milli: Int,
    redshift_z: Int
) -> Int {
    let one_plus_z: Int = 1 + redshift_z;
    if one_plus_z <= 0 {
        return 0;
    }
    let z2: Int = one_plus_z * one_plus_z;
    let z3: Int = z2 * one_plus_z;
    let z4: Int = z2 * z2;
    let e2: Int = (om_r_milli * z4) + (om_m_milli * z3) + (om_k_milli * z2) + om_l_milli;
    if e2 <= 0 {
        return 0;
    }
    return friedmann_isqrt(e2 * 1000);
}

pub fn friedmann_hubble_parameter(
    h0: Int,
    om_m_milli: Int,
    om_r_milli: Int,
    om_k_milli: Int,
    om_l_milli: Int,
    redshift_z: Int
) -> Int {
    let e_milli: Int = friedmann_e_z(om_m_milli, om_r_milli, om_k_milli, om_l_milli, redshift_z);
    return (h0 * e_milli) / 1000;
}

pub fn friedmann_evaluate_point(
    h0: Int,
    om_m_milli: Int,
    om_r_milli: Int,
    om_k_milli: Int,
    om_l_milli: Int,
    redshift_z: Int
) -> FriedmannExpansionPoint {
    let one_plus_z: Int = 1 + redshift_z;
    if one_plus_z <= 0 {
        return FriedmannExpansionPoint {
            redshift_z: redshift_z,
            scale_a_milli: 0,
            hubble: 0,
            e_milli: 0,
            q_milli: 0,
            rho_c: 0,
            flag_bits: 0
        };
    }
    let z2: Int = one_plus_z * one_plus_z;
    let z3: Int = z2 * one_plus_z;
    let z4: Int = z2 * z2;
    let e2: Int = (om_r_milli * z4) + (om_m_milli * z3) + (om_k_milli * z2) + om_l_milli;
    let e_milli: Int = friedmann_e_z(om_m_milli, om_r_milli, om_k_milli, om_l_milli, redshift_z);
    let a_milli: Int = 1000 / one_plus_z;
    let h_z: Int = (h0 * e_milli) / 1000;
    let half_m: Int = (om_m_milli * z3) / 2;
    let num_pos: Int = (om_r_milli * z4) + half_m;
    let mut q_milli: Int = 0;
    if e2 > 0 {
        if num_pos >= om_l_milli {
            q_milli = ((num_pos - om_l_milli) * 1000) / e2;
        } else {
            q_milli = 0 - (((om_l_milli - num_pos) * 1000) / e2);
        }
    }
    let rho_c: Int = (3 * h_z * h_z) / (8 * 314);
    let mut valid: Int = 0;
    if e_milli > 0 {
        valid = 1;
    }
    return FriedmannExpansionPoint {
        redshift_z: redshift_z,
        scale_a_milli: a_milli,
        hubble: h_z,
        e_milli: e_milli,
        q_milli: q_milli,
        rho_c: rho_c,
        flag_bits: valid
    };
}

pub fn friedmann_e(p: FriedmannExpansionPoint) -> Int {
    return p.e_milli;
}

pub fn friedmann_flags(p: FriedmannExpansionPoint) -> Int {
    return p.flag_bits;
}
