// # Lane-Emden Polytropic Stellar Structure Solver
//
// Logline: Integrates the Lane-Emden differential equation for polytropic stellar models using 4th-order Runge-Kutta.
//
// Setup: Solves dimensionless hydrostatic equilibrium for polytropic indices n = 0, 1, 1.5, 3.0, and 5.0.
//
// Beats:
//   1. Define polytropic parameters, boundary conditions at center xi=0 (theta=1, dtheta/dxi=0).
//   2. Implement RK4 numerical integration with small-xi series expansion near origin.
//   3. Extract stellar surface radius xi_1, mass derivative -xi_1^2 * theta'(xi_1), and structural constants.

import "./astro_rel_constants.oo";

pub type LaneEmdenSolution = struct {
    polytropic_index_n: Float,
    xi_surface: Float,
    derivative_at_surface: Float,
    central_to_mean_density_ratio: Float,
    converged: Bool
};

pub type PolytropeState = struct {
    xi: Float,
    theta: Float,
    dtheta_dxi: Float
};

pub fn polytrope_derivatives(n: Float, xi: Float, theta: Float, dtheta: Float) -> Float {
    if xi <= 0.0001 {
        // Asymptotic behavior near origin: d^2 theta / dxi^2 = -1/3 * theta^n
        let th_n: Float = pow(math_max(theta, 0.0), n);
        return (0.0 - th_n) / 3.0;
    }
    let th_n: Float = pow(math_max(theta, 0.0), n);
    // d^2 theta / dxi^2 = -theta^n - (2 / xi) * dtheta/dxi
    return (0.0 - th_n) - ((2.0 / xi) * dtheta);
}

pub fn lane_emden_rk4_step(n: Float, state: PolytropeState, dxi: Float) -> PolytropeState {
    let xi: Float = (state).xi;
    let th: Float = (state).theta;
    let v: Float = (state).dtheta_dxi;

    let k1_th: Float = v;
    let k1_v: Float = polytrope_derivatives(n, xi, th, v);

    let k2_th: Float = v + (0.5 * dxi * k1_v);
    let k2_v: Float = polytrope_derivatives(n, xi + (0.5 * dxi), th + (0.5 * dxi * k1_th), v + (0.5 * dxi * k1_v));

    let k3_th: Float = v + (0.5 * dxi * k2_v);
    let k3_v: Float = polytrope_derivatives(n, xi + (0.5 * dxi), th + (0.5 * dxi * k2_th), v + (0.5 * dxi * k2_v));

    let k4_th: Float = v + (dxi * k3_v);
    let k4_v: Float = polytrope_derivatives(n, xi + dxi, th + (dxi * k3_th), v + (dxi * k3_v));

    let next_th: Float = th + ((dxi / 6.0) * (k1_th + (2.0 * k2_th) + (2.0 * k3_th) + k4_th));
    let next_v: Float = v + ((dxi / 6.0) * (k1_v + (2.0 * k2_v) + (2.0 * k3_v) + k4_v));

    return PolytropeState {
        xi: xi + dxi,
        theta: next_th,
        dtheta_dxi: next_v
    };
}

pub fn lane_emden_solve(n: Float, dxi: Float, max_steps: Int) -> LaneEmdenSolution {
    // Initial expansion at xi_0 = 0.0001
    let xi_0: Float = 0.0001;
    let theta_0: Float = 1.0 - ((xi_0 * xi_0) / 6.0);
    let dtheta_0: Float = (0.0 - xi_0) / 3.0;

    let mut state: PolytropeState = PolytropeState {
        xi: xi_0,
        theta: theta_0,
        dtheta_dxi: dtheta_0
    };

    let mut step: Int = 0;
    let mut prev_state: PolytropeState = state;

    while step < max_steps && (state).theta > 0.0 {
        prev_state = state;
        state = lane_emden_rk4_step(n, state, dxi);
        step = step + 1;
    }

    if (state).theta <= 0.0 {
        // Linear interpolation to precise zero crossing
        let fraction: Float = (0.0 - (prev_state).theta) / ((state).theta - (prev_state).theta);
        let xi_surf: Float = (prev_state).xi + (fraction * ((state).xi - (prev_state).xi));
        let dth_surf: Float = (prev_state).dtheta_dxi + (fraction * ((state).dtheta_dxi - (prev_state).dtheta_dxi));

        // Mean density ratio: rho_c / rho_mean = -xi_1 / (3 * theta'(xi_1))
        let rho_ratio: Float = (0.0 - xi_surf) / (3.0 * dth_surf);

        return LaneEmdenSolution {
            polytropic_index_n: n,
            xi_surface: xi_surf,
            derivative_at_surface: dth_surf,
            central_to_mean_density_ratio: rho_ratio,
            converged: true
        };
    }

    return LaneEmdenSolution {
        polytropic_index_n: n,
        xi_surface: (state).xi,
        derivative_at_surface: (state).dtheta_dxi,
        central_to_mean_density_ratio: 0.0,
        converged: false
    };
}

pub fn polytrope_standard_n15() -> LaneEmdenSolution {
    return lane_emden_solve(1.5, 0.005, 5000);
}

pub fn polytrope_standard_n30() -> LaneEmdenSolution {
    return lane_emden_solve(3.0, 0.005, 5000);
}
