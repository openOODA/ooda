// # Eddington Critical Luminosity & Accretion Limit
//
// Logline: L_Edd = 4 pi G M c / kappa. Int destub (solar / milli-opacity).
//
// Setup: Thomson kappa_es = 0.2 (1 + X) cm^2/g; L_sun units.
//
// Beats:
//   1. kappa_milli = 200 + X_permille / 5.
//   2. L_Edd / L_sun = 12800000 * M / kappa_milli.
//   3. lambda_Edd_milli = 1000 * L_obs / L_Edd.

type EddingtonResult = struct {
    mass_msun: Int,
    kappa_milli: Int,
    l_edd_solar: Int,
    flag_bits: Int
};

pub fn eddington_thomson_opacity(x_permille: Int) -> Int {
    if x_permille < 0 {
        return 0;
    }
    return 200 + (x_permille / 5);
}

pub fn eddington_luminosity_compute(
    mass_msun: Int,
    x_permille: Int,
    eta_milli: Int
) -> EddingtonResult {
    let kappa: Int = eddington_thomson_opacity(x_permille);
    let mut eta: Int = eta_milli;
    if eta <= 0 {
        eta = 100;
    }
    if mass_msun <= 0 {
        return EddingtonResult {
            mass_msun: mass_msun,
            kappa_milli: kappa,
            l_edd_solar: 0,
            flag_bits: 0
        };
    }
    if kappa <= 0 {
        return EddingtonResult {
            mass_msun: mass_msun,
            kappa_milli: kappa,
            l_edd_solar: 0,
            flag_bits: 0
        };
    }
    let l_edd: Int = (12800000 * mass_msun) / kappa;
    return EddingtonResult {
        mass_msun: mass_msun,
        kappa_milli: kappa,
        l_edd_solar: l_edd,
        flag_bits: 1 + (eta * 2)
    };
}

pub fn eddington_ratio(luminosity_obs_solar: Int, mass_msun: Int) -> Int {
    let res: EddingtonResult = eddington_luminosity_compute(mass_msun, 700, 100);
    if res.l_edd_solar <= 0 {
        return 0;
    }
    return (luminosity_obs_solar * 1000) / res.l_edd_solar;
}

pub fn eddington_luminosity(r: EddingtonResult) -> Int {
    return r.l_edd_solar;
}

pub fn eddington_flags(r: EddingtonResult) -> Int {
    return r.flag_bits;
}
