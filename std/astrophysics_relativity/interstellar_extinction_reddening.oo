// # Interstellar Dust Extinction & CCM Reddening Laws
//
// Logline: R_V = A_V / E(B-V); A_lambda = (A_lambda/A_V) A_V. Int destub.
//
// Setup: Milli-mag. Diffuse ISM R_V = 3100. Flattened CCM payload.
//
// Beats:
//   1. A_V = R_V * E(B-V); A_B = A_V + E(B-V).
//   2. x = 1/lambda; optical a(x)+b(x)/R_V; IR 0.574 x^{3/2}.
//   3. Deredden m_0 = m_obs - A_lambda.

type InterstellarExtinctionResult = struct {
    wavelength: Int,
    x_milli: Int,
    ratio_milli: Int,
    a_v_milli: Int,
    a_lambda_milli: Int,
    flag_bits: Int
};

fn ext_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn ccm_extinction_ratio(wavelength_angstroms: Int, r_v_milli: Int) -> Int {
    if wavelength_angstroms <= 0 {
        return 0;
    }
    let mut rv: Int = r_v_milli;
    if rv <= 0 {
        rv = 3100;
    }
    let x_milli: Int = 10000000 / wavelength_angstroms;
    if x_milli < 1100 {
        let rt: Int = ext_isqrt(x_milli * 1000);
        return (574 * x_milli * rt) / 1000000;
    }
    if x_milli <= 3300 {
        let y: Int = x_milli - 1820;
        let y2: Int = (y * y) / 1000;
        let y3: Int = (y2 * y) / 1000;
        let y4: Int = (y2 * y2) / 1000;
        let a_x: Int = 1000 + ((177 * y) / 1000) - ((504 * y2) / 1000) - ((24 * y3) / 1000) + ((721 * y4) / 1000);
        let b_x: Int = ((1413 * y) / 1000) + ((2283 * y2) / 1000) + ((1072 * y3) / 1000);
        return a_x + (b_x * 1000 / rv);
    }
    return 1000 + ((800 * (x_milli - 3300)) / 1000);
}

pub fn interstellar_extinction_evaluate(
    wavelength_angstroms: Int,
    ebv_milli: Int,
    r_v_milli: Int
) -> InterstellarExtinctionResult {
    let mut rv: Int = r_v_milli;
    if rv <= 0 {
        rv = 3100;
    }
    let a_v: Int = (rv * ebv_milli) / 1000;
    if wavelength_angstroms <= 0 {
        return InterstellarExtinctionResult {
            wavelength: wavelength_angstroms,
            x_milli: 0,
            ratio_milli: 0,
            a_v_milli: a_v,
            a_lambda_milli: 0,
            flag_bits: 0
        };
    }
    let x_milli: Int = 10000000 / wavelength_angstroms;
    let ratio: Int = ccm_extinction_ratio(wavelength_angstroms, rv);
    let a_lam: Int = (ratio * a_v) / 1000;
    return InterstellarExtinctionResult {
        wavelength: wavelength_angstroms,
        x_milli: x_milli,
        ratio_milli: ratio,
        a_v_milli: a_v,
        a_lambda_milli: a_lam,
        flag_bits: 1
    };
}

pub fn interstellar_a_b_milli(ebv_milli: Int, r_v_milli: Int) -> Int {
    let mut rv: Int = r_v_milli;
    if rv <= 0 {
        rv = 3100;
    }
    let a_v: Int = (rv * ebv_milli) / 1000;
    return a_v + ebv_milli;
}

pub fn interstellar_deredden_milli(m_obs_milli: Int, a_lambda_milli: Int) -> Int {
    return m_obs_milli - a_lambda_milli;
}

pub fn extinction_a_v(r: InterstellarExtinctionResult) -> Int {
    return r.a_v_milli;
}

pub fn extinction_flags(r: InterstellarExtinctionResult) -> Int {
    return r.flag_bits;
}
