// # Stellar Pulsations & Cepheid Period-Luminosity Relation
//
// Logline: Models radial stellar oscillations, dynamical pulsation timescale (P ~ 1/sqrt(G*rho)), and the classical Leavitt law.
//
// Setup: Calculates pulsation periods, absolute V/I/W Wesenheit magnitudes, and distance modulus for standard candles.
//
// Beats:
//   1. Compute dynamical pulsation timescale from mean stellar density: Pi = Q / sqrt(rho / rho_sun).
//   2. Evaluate classical Cepheid Period-Luminosity (P-L) relations in visual (V) and near-infrared (K) bands.
//   3. Compute extinction-free Wesenheit index W_VI and determine cosmic distance modulus mu = 5*log10(d) - 5.

import "./astro_rel_constants.oo";

pub type CepheidParameters = struct {
    period_days: Float,
    abs_mag_v: Float,
    abs_mag_k: Float,
    wesenheit_w_vi: Float,
    luminosity_solar: Float,
};

pub fn stellar_dynamical_pulsation_period_s(mass_kg: Float, radius_m: Float) -> Float {
    if mass_kg <= 0.0 || radius_m <= 0.0 {
        return 0.0;
    }
    // Pi_dyn ~ sqrt(R^3 / (G * M))
    let g_val: Float = const_g();
    let r3: Float = radius_m * (radius_m * radius_m);
    return sqrt(r3 / (g_val * mass_kg));
}

pub fn cepheid_pl_evaluate(period_days: Float) -> CepheidParameters {
    if period_days <= 0.1 {
        return CepheidParameters {
            period_days: period_days,
            abs_mag_v: 0.0,
            abs_mag_k: 0.0,
            wesenheit_w_vi: 0.0,
            luminosity_solar: 0.0,
        };
    }

    // log10(P) = ln(P) / ln(10)
    let log_p: Float = ln(period_days) / 2.302585092994046;

    // Classical Galactic Cepheid relations:
    // M_V = -2.67 * log10(P) - 1.40
    // M_K = -3.28 * log10(P) - 2.57
    // W_VI = -3.31 * log10(P) - 2.58
    let mv: Float = ((0.0 - 2.67) * log_p) - 1.40;
    let mk: Float = ((0.0 - 3.28) * log_p) - 2.57;
    let w_vi: Float = ((0.0 - 3.31) * log_p) - 2.58;

    // Solar absolute visual magnitude M_V,sun ~ 4.83
    // L / L_sun = 10^(0.4 * (4.83 - M_V)) = exp(0.4 * ln(10) * (4.83 - M_V))
    let exp_term: Float = 0.4 * 2.302585092994046 * (4.83 - mv);
    let l_solar: Float = exp(exp_term);

    return CepheidParameters {
        period_days: period_days,
        abs_mag_v: mv,
        abs_mag_k: mk,
        wesenheit_w_vi: w_vi,
        luminosity_solar: l_solar,
    };
}

pub fn cepheid_distance_parsecs(apparent_mag: Float, absolute_mag: Float) -> Float {
    // mu = m - M = 5 * log10(d / 10 pc) => d = 10 * 10^((m - M) / 5)
    let mu: Float = apparent_mag - absolute_mag;
    let exp_arg: Float = (mu / 5.0) * 2.302585092994046;
    return 10.0 * exp(exp_arg);
}
