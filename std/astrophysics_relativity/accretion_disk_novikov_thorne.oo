// # Novikov-Thorne General Relativistic Thin Accretion Disk Model
//
// Logline: ISCO Bardeen; Q=1-sqrt(r_isco/r); eta=1-E_isco. Int destub.
//
// Setup: Flattened NT point. a* in milli. Radii in Rg.
//
// Beats:
//   1. r_isco from Z1, Z2 cube-root formula (milli-Rg).
//   2. Q = 1 - sqrt(r_isco / r); flux ~ 3 M Mdot Q / r^3.
//   3. E_isco binding; eta_milli = 1000 - E_milli.

type NovikovThorneDiskPoint = struct {
    radius_rg: Int,
    spin_milli: Int,
    isco_rg: Int,
    q_milli: Int,
    flux: Int,
    eta_milli: Int,
    flag_bits: Int
};

fn nt_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

fn nt_icbrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 8 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = 1000;
    if y > n {
        y = (n + 1) / 2;
    }
    while y < x {
        x = y;
        let x2: Int = x * x;
        if x2 <= 0 {
            return x;
        }
        y = ((2 * x) + (n / x2)) / 3;
        if y <= 0 {
            y = 1;
        }
    }
    return x;
}

pub fn kerr_isco_radius_rg(a_milli: Int) -> Int {
    let mut a: Int = a_milli;
    if a < 0 {
        a = 0 - a;
    }
    if a > 999 {
        a = 999;
    }
    let one_minus_a2: Int = 1000000 - (a * a);
    let term1_milli: Int = 10 * nt_icbrt(one_minus_a2);
    let plus_arg: Int = (1000 + a) * 1000;
    let minus_arg: Int = (1000 - a) * 1000;
    if minus_arg < 0 {
        return 6;
    }
    let term2_milli: Int = (10 * nt_icbrt(plus_arg)) + (10 * nt_icbrt(minus_arg));
    let z1_milli: Int = 1000 + ((term1_milli * term2_milli) / 1000);
    let z2_milli: Int = nt_isqrt((3 * a * a) + (z1_milli * z1_milli));
    let mut left: Int = 3000 - z1_milli;
    if left < 0 {
        left = 0;
    }
    let right: Int = 3000 + z1_milli + (2 * z2_milli);
    let rad: Int = nt_isqrt(left * right);
    let r_milli: Int = 3000 + z2_milli - rad;
    return r_milli / 1000;
}

pub fn novikov_thorne_efficiency(a_milli: Int) -> Int {
    let r_isco: Int = kerr_isco_radius_rg(a_milli);
    if r_isco <= 0 {
        return 0;
    }
    let mut a: Int = a_milli;
    if a < 0 {
        a = 0 - a;
    }
    if a > 999 {
        a = 999;
    }
    let r12: Int = nt_isqrt(r_isco * 1000000);
    let r32: Int = r_isco * r12;
    let r14: Int = nt_isqrt(r12 * 1000);
    let r34: Int = (r12 * r14) / 1000;
    let num: Int = (r32 - (2 * r12)) + a;
    let inside: Int = (r32 - (3 * r12)) + (2 * a);
    if inside <= 0 {
        return 0;
    }
    if r34 <= 0 {
        return 0;
    }
    let s_in: Int = nt_isqrt(inside * 1000);
    let denom: Int = (r34 * s_in) / 1000;
    if denom <= 0 {
        return 0;
    }
    let e_milli: Int = (num * 1000) / denom;
    if e_milli >= 1000 {
        return 0;
    }
    return 1000 - e_milli;
}

pub fn novikov_thorne_evaluate(
    mass: Int,
    mdot: Int,
    a_milli: Int,
    radius_rg: Int
) -> NovikovThorneDiskPoint {
    let r_isco: Int = kerr_isco_radius_rg(a_milli);
    let eta: Int = novikov_thorne_efficiency(a_milli);
    if radius_rg < r_isco {
        return NovikovThorneDiskPoint {
            radius_rg: radius_rg,
            spin_milli: a_milli,
            isco_rg: r_isco,
            q_milli: 0,
            flux: 0,
            eta_milli: eta,
            flag_bits: 0
        };
    }
    if mass <= 0 {
        return NovikovThorneDiskPoint {
            radius_rg: radius_rg,
            spin_milli: a_milli,
            isco_rg: r_isco,
            q_milli: 0,
            flux: 0,
            eta_milli: eta,
            flag_bits: 0
        };
    }
    if mdot <= 0 {
        return NovikovThorneDiskPoint {
            radius_rg: radius_rg,
            spin_milli: a_milli,
            isco_rg: r_isco,
            q_milli: 0,
            flux: 0,
            eta_milli: eta,
            flag_bits: 0
        };
    }
    let q_milli: Int = 1000 - nt_isqrt((r_isco * 1000000) / radius_rg);
    let r3: Int = radius_rg * radius_rg * radius_rg;
    let flux: Int = (3 * mass * mdot * q_milli) / r3;
    return NovikovThorneDiskPoint {
        radius_rg: radius_rg,
        spin_milli: a_milli,
        isco_rg: r_isco,
        q_milli: q_milli,
        flux: flux,
        eta_milli: eta,
        flag_bits: 1
    };
}

pub fn novikov_q(p: NovikovThorneDiskPoint) -> Int {
    return p.q_milli;
}

pub fn novikov_flags(p: NovikovThorneDiskPoint) -> Int {
    return p.flag_bits;
}
