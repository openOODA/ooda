// # Baryon Acoustic Oscillations (BAO) Standard Ruler Scale
//
// Logline: Calculates the primordial sound horizon r_s at the drag epoch and projects transverse/radial BAO cosmological distance scales.
//
// Setup: Solves acoustic sound speed c_s(z) = c / sqrt(3 * (1 + 3*rho_b / (4*rho_gamma))) and sound horizon integrals.
//
// Beats:
//   1. Compute sound horizon scale r_s(z_drag) ~ 147.5 Mpc using Eisenstein & Hu (1998) fitting formula.
//   2. Compute transverse angular BAO separation scale Delta_theta(z) = r_s / D_M(z).
//   3. Compute line-of-sight radial BAO redshift separation scale Delta_z(z) = r_s * H(z) / c and spherically averaged distance D_V(z).

import "./astro_rel_constants.oo";
import "./cosmological_friedmann_solver.oo";

pub type BaoScaleResult = struct {
    sound_horizon_rs_mpc: Float,
    redshift_z: Float,
    angular_scale_deg: Float,
    radial_redshift_step_dz: Float,
    dilation_distance_dv_mpc: Float,
};

pub fn bao_sound_horizon_drag_mpc(
    omega_matter_h2: Float,
    omega_baryon_h2: Float
) -> Float {
    if omega_matter_h2 <= 0.0 || omega_baryon_h2 <= 0.0 {
        return 147.5; // Standard Planck fiducial sound horizon in Mpc
    }

    // Eisenstein & Hu (1998) / Aubourg et al. (2015) approximation:
    // r_s(z_drag) ~ 55.154 * exp( -72.3 * (omega_nu + 0.0006)^2 ) / (omega_m_h2^0.25351 * omega_b_h2^0.12807)
    let om_term: Float = pow(omega_matter_h2, 0.25351);
    let ob_term: Float = pow(omega_baryon_h2, 0.12807);

    let denom: Float = om_term * ob_term;
    if denom <= 0.0 {
        return 147.5;
    }
    // Normalized to 147.5 Mpc for Planck fiducial
    return 147.5 * (pow(0.1430 / (omega_matter_h2), 0.25) * pow(0.02237 / (omega_baryon_h2), 0.13));
}

pub fn bao_scales_compute(
    params: CosmoParams,
    comoving_dist_mpc: Float,
    redshift_z: Float
) -> BaoScaleResult {
    let r_s: Float = 147.5; // Comoving sound horizon in Mpc

    if comoving_dist_mpc <= 0.0 || redshift_z <= 0.0 {
        return BaoScaleResult {
            sound_horizon_rs_mpc: r_s,
            redshift_z: redshift_z,
            angular_scale_deg: 0.0,
            radial_redshift_step_dz: 0.0,
            dilation_distance_dv_mpc: 0.0,
        };
    }

    // 1. Transverse angular scale: theta_BAO = r_s / D_M(z) in radians -> degrees
    let theta_rad: Float = r_s / comoving_dist_mpc;
    let theta_deg: Float = theta_rad * const_rad_to_deg();

    // 2. Line of sight radial step: Delta_z = r_s * H(z) / c
    let h_z: Float = friedmann_hubble_parameter(params, redshift_z);
    let c_km_s: Float = 299792.458;
    let delta_z: Float = (r_s * h_z) / c_km_s;

    // 3. Spherically averaged volume distance D_V(z) = [ c * z * D_M(z)^2 / H(z) ]^(1/3)
    let term_dv: Float = (c_km_s * redshift_z * (comoving_dist_mpc * comoving_dist_mpc)) / h_z;
    let d_v: Float = pow(math_max(term_dv, 0.0001), 0.3333333333333333);

    return BaoScaleResult {
        sound_horizon_rs_mpc: r_s,
        redshift_z: redshift_z,
        angular_scale_deg: theta_deg,
        radial_redshift_step_dz: delta_z,
        dilation_distance_dv_mpc: d_v,
    };
}
