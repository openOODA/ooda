// # Geodetic (de Sitter) & Lense-Thirring Gyroscope Precession
//
// Logline: Calculates General Relativistic spin-orbit geodetic precession and spin-spin frame-dragging precession for orbiting gyroscopes.
//
// Setup: Implements Schiff (1960) equations tested by NASA Gravity Probe B in low Earth polar orbit.
//
// Beats:
//   1. Compute geodetic (de Sitter) drift rate Omega_geodetic = (3*G*M / 2*c^2*r^3) * (r x v).
//   2. Compute Lense-Thirring frame-dragging drift rate Omega_LT = (G / c^2*r^3) * [ (3*(J . r)*r / r^2) - J ].
//   3. Project annual secular drift rates in milliarcseconds per year (mas/yr) along north-south and east-west axes.

import "./astro_rel_constants.oo";

pub type GyroscopePrecessionResult = struct {
    orbit_radius_m: Float,
    geodetic_rate_rad_s: Float,
    geodetic_rate_mas_yr: Float,
    lense_thirring_rate_rad_s: Float,
    lense_thirring_rate_mas_yr: Float,
    total_precession_mas_yr: Float
};

pub fn gr_geodetic_precession_rate(
    central_mass_kg: Float,
    orbit_radius_m: Float
) -> Float {
    if orbit_radius_m <= 0.0 || central_mass_kg <= 0.0 {
        return 0.0;
    }
    // For circular orbit: Omega_G = (3/2) * (G*M / c^2)^(3/2) / r^(5/2) = (3/2) * (G*M)^(3/2) / (c^2 * r^(5/2))
    let g_val: Float = const_g();
    let c_val: Float = const_c();
    let c2: Float = c_val * c_val;

    let gm: Float = g_val * central_mass_kg;
    let gm_32: Float = pow(gm, 1.5);
    let r_52: Float = pow(orbit_radius_m, 2.5);

    return (1.5 * gm_32) / (c2 * r_52);
}

pub fn gr_lense_thirring_precession_rate(
    central_angular_momentum_j: Float,
    orbit_radius_m: Float
) -> Float {
    if orbit_radius_m <= 0.0 || central_angular_momentum_j <= 0.0 {
        return 0.0;
    }
    // For polar circular orbit: Omega_LT = (G * J) / (2 * c^2 * r^3)
    let g_val: Float = const_g();
    let c_val: Float = const_c();
    let c2: Float = c_val * c_val;
    let r3: Float = orbit_radius_m * (orbit_radius_m * orbit_radius_m);

    return (g_val * central_angular_momentum_j) / (2.0 * c2 * r3);
}

pub fn gr_gravity_probe_b_compute(
    orbit_altitude_m: Float
) -> GyroscopePrecessionResult {
    let r_earth: Float = const_r_earth();
    let r_orbit: Float = r_earth + orbit_altitude_m;
    let m_earth: Float = const_m_earth();

    // Earth angular momentum J_earth ~ 7.05e33 kg m^2 / s
    let j_earth: Float = 7050000000000000000000000000000000.0;

    let rate_g: Float = gr_geodetic_precession_rate(m_earth, r_orbit);
    let rate_lt: Float = gr_lense_thirring_precession_rate(j_earth, r_orbit);

    // Convert rad/s to milliarcseconds per year (mas/yr)
    // 1 rad = 206,264.806 arcsec = 206,264,806 mas
    // 1 yr = 31,557,600 s
    let rad_to_mas: Float = const_rad_to_deg() * 3600.0 * 1000.0;
    let s_per_yr: Float = const_julian_year_s();
    let conv: Float = rad_to_mas * s_per_yr;

    let mas_g: Float = rate_g * conv;
    let mas_lt: Float = rate_lt * conv;
    let total_mas: Float = sqrt((mas_g * mas_g) + (mas_lt * mas_lt));

    return GyroscopePrecessionResult {
        orbit_radius_m: r_orbit,
        geodetic_rate_rad_s: rate_g,
        geodetic_rate_mas_yr: mas_g,
        lense_thirring_rate_rad_s: rate_lt,
        lense_thirring_rate_mas_yr: mas_lt,
        total_precession_mas_yr: total_mas
    };
}
