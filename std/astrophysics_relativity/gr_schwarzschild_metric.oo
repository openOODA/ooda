// # Schwarzschild Metric & Characteristic Radii
//
// Logline: Geometric units G=c=1. rs=2M, photon=3M, ISCO=6M. Int destub.
//
// Setup: Flattened metric payload (Christoffel as Int accessor).
//
// Beats:
//   1. rs = 2M; photon sphere 1.5 rs; ISCO 3 rs.
//   2. f = 1 - rs/r; g_rr = r / (r - rs) in milli.
//   3. Gamma^t_tr = rs / (2 r (r - rs)).

type SchwarzschildMetric = struct {
    mass: Int,
    radius: Int,
    rs: Int,
    photon: Int,
    isco: Int,
    f_milli: Int,
    g_rr_milli: Int,
    flag_bits: Int
};

pub fn schwarzschild_metric_evaluate(mass: Int, radius: Int) -> SchwarzschildMetric {
    let rs: Int = 2 * mass;
    let photon: Int = 3 * mass;
    let isco: Int = 6 * mass;
    if mass <= 0 {
        return SchwarzschildMetric {
            mass: mass,
            radius: radius,
            rs: rs,
            photon: photon,
            isco: isco,
            f_milli: 0,
            g_rr_milli: 0,
            flag_bits: 0
        };
    }
    if radius <= rs {
        return SchwarzschildMetric {
            mass: mass,
            radius: radius,
            rs: rs,
            photon: photon,
            isco: isco,
            f_milli: 0,
            g_rr_milli: 0,
            flag_bits: 0
        };
    }
    let f_milli: Int = 1000 - ((1000 * rs) / radius);
    let g_rr_milli: Int = (1000 * radius) / (radius - rs);
    return SchwarzschildMetric {
        mass: mass,
        radius: radius,
        rs: rs,
        photon: photon,
        isco: isco,
        f_milli: f_milli,
        g_rr_milli: g_rr_milli,
        flag_bits: 1
    };
}

pub fn schwarzschild_gamma_t_tr_milli(mass: Int, radius: Int) -> Int {
    let rs: Int = 2 * mass;
    if radius <= rs {
        return 0;
    }
    if mass <= 0 {
        return 0;
    }
    return (1000 * rs) / (2 * radius * (radius - rs));
}

pub fn schwarzschild_rs(m: SchwarzschildMetric) -> Int {
    return m.rs;
}

pub fn schwarzschild_flags(m: SchwarzschildMetric) -> Int {
    return m.flag_bits;
}
