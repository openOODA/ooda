// # Grey Atmosphere Model, Eddington-Barbier & Limb Darkening
//
// Logline: Calculates radiative equilibrium temperature profiles, source functions, and surface intensity limb darkening.
//
// Setup: Implements plane-parallel grey atmosphere equations: T^4(tau) = 3/4 * T_eff^4 * [tau + 2/3].
//
// Beats:
//   1. Compute local atmospheric temperature T(tau) as a function of optical depth tau and effective temperature T_eff.
//   2. Compute emergent specific intensity I(0, mu) via Eddington-Barbier relation where mu = cos(theta).
//   3. Implement linear and quadratic stellar limb darkening laws: I(mu)/I(1) = 1 - u*(1 - mu).

import "./astro_rel_constants.oo";

pub type GreyAtmospherePoint = struct {
    optical_depth_tau: Float,
    temperature_k: Float,
    source_function_b: Float,
};

pub type LimbDarkeningCoeffs = struct {
    linear_u: Float,
    quadratic_a: Float,
    quadratic_b: Float,
};

pub fn grey_atmosphere_temperature(t_eff_k: Float, optical_depth_tau: Float) -> Float {
    if t_eff_k <= 0.0 || optical_depth_tau < 0.0 {
        return 0.0;
    }
    // T(tau)^4 = 3/4 * T_eff^4 * (tau + 2/3)
    let t_eff_4: Float = (t_eff_k * t_eff_k) * (t_eff_k * t_eff_k);
    let t4: Float = 0.75 * t_eff_4 * (optical_depth_tau + 0.6666666666666666);
    return pow(t4, 0.25);
}

pub fn grey_atmosphere_point(t_eff_k: Float, optical_depth_tau: Float) -> GreyAtmospherePoint {
    let t: Float = grey_atmosphere_temperature(t_eff_k, optical_depth_tau);
    let sigma_sb: Float = const_sigma_sb();
    let pi_val: Float = const_pi();
    // B(T) = (sigma / pi) * T^4
    let t4: Float = (t * t) * (t * t);
    let b: Float = (sigma_sb / pi_val) * t4;

    return GreyAtmospherePoint {
        optical_depth_tau: optical_depth_tau,
        temperature_k: t,
        source_function_b: b,
    };
}

pub fn grey_emergent_intensity_linear(i_center: Float, mu_cos_theta: Float, u_coeff: Float) -> Float {
    let mu_clamped: Float = math_max(math_min(mu_cos_theta, 1.0), 0.0);
    // I(mu) / I(1) = 1 - u * (1 - mu)
    return i_center * (1.0 - (u_coeff * (1.0 - mu_clamped)));
}

pub fn grey_emergent_intensity_quadratic(
    i_center: Float,
    mu_cos_theta: Float,
    a_coeff: Float,
    b_coeff: Float
) -> Float {
    let mu_clamped: Float = math_max(math_min(mu_cos_theta, 1.0), 0.0);
    let one_minus_mu: Float = 1.0 - mu_clamped;
    // I(mu) / I(1) = 1 - a*(1 - mu) - b*(1 - mu)^2
    let factor: Float = (1.0 - (a_coeff * one_minus_mu)) - (b_coeff * (one_minus_mu * one_minus_mu));
    return i_center * math_max(factor, 0.0);
}

pub fn sun_limb_darkening_coeffs_visual() -> LimbDarkeningCoeffs {
    // Standard solar limb darkening at 500 nm
    return LimbDarkeningCoeffs {
        linear_u: 0.6,
        quadratic_a: 0.45,
        quadratic_b: 0.25,
    };
}
