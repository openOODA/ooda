// # Shapiro Gravitational Time Delay Solver
//
// Logline: Delta_t = (2 G M / c^3) ln((r_e+x_e)(r_r+x_r)/d^2). Int destub.
//
// Setup: 2GM_sun/c^3 = 9850 ns. Flattened solar + binary payloads.
//
// Beats:
//   1. x = isqrt(r^2 - d^2); arg = (r+x)^2 / d^2.
//   2. One-way delay 9850 M ln(arg) ns; round trip 2x.
//   3. Binary range r = 4925 M_c ns; max = -2 r ln(1-s).

type ShapiroDelayResult = struct {
    mass_msun: Int,
    impact_d: Int,
    delay_ns: Int,
    round_trip_ns: Int,
    flag_bits: Int
};

type BinaryPulsarShapiro = struct {
    companion_milli_msun: Int,
    s_milli: Int,
    range_ns: Int,
    max_delay_ns: Int,
    flag_bits: Int
};

fn shapiro_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n < 4 {
        return 1;
    }
    let mut x: Int = n;
    let mut y: Int = (n + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

fn shapiro_iln_milli(n: Int) -> Int {
    if n <= 1 {
        return 0;
    }
    let mut v: Int = n * 1000;
    let mut exp2: Int = 0;
    while v >= 2000 {
        v = v / 2;
        exp2 = exp2 + 1;
    }
    let um: Int = ((v - 1000) * 1000) / (v + 1000);
    let u2: Int = (um * um) / 1000;
    let u3: Int = (u2 * um) / 1000;
    let u5: Int = (u3 * u2) / 1000;
    let u7: Int = (u5 * u2) / 1000;
    let ln_mant: Int = 2 * (um + (u3 / 3) + (u5 / 5) + (u7 / 7));
    return (exp2 * 693) + ln_mant;
}

pub fn shapiro_delay_solar_system(
    mass_msun: Int,
    impact_d: Int,
    r_emitter: Int,
    r_receiver: Int
) -> ShapiroDelayResult {
    if mass_msun <= 0 {
        return ShapiroDelayResult {
            mass_msun: mass_msun,
            impact_d: impact_d,
            delay_ns: 0,
            round_trip_ns: 0,
            flag_bits: 0
        };
    }
    if impact_d <= 0 {
        return ShapiroDelayResult {
            mass_msun: mass_msun,
            impact_d: impact_d,
            delay_ns: 0,
            round_trip_ns: 0,
            flag_bits: 0
        };
    }
    if r_emitter <= impact_d {
        return ShapiroDelayResult {
            mass_msun: mass_msun,
            impact_d: impact_d,
            delay_ns: 0,
            round_trip_ns: 0,
            flag_bits: 0
        };
    }
    if r_receiver <= impact_d {
        return ShapiroDelayResult {
            mass_msun: mass_msun,
            impact_d: impact_d,
            delay_ns: 0,
            round_trip_ns: 0,
            flag_bits: 0
        };
    }
    let xe: Int = shapiro_isqrt((r_emitter * r_emitter) - (impact_d * impact_d));
    let xr: Int = shapiro_isqrt((r_receiver * r_receiver) - (impact_d * impact_d));
    let num: Int = (r_emitter + xe) * (r_receiver + xr);
    let den: Int = impact_d * impact_d;
    let arg: Int = num / den;
    let ln_m: Int = shapiro_iln_milli(arg);
    let delay_ns: Int = (9850 * mass_msun * ln_m) / 1000;
    return ShapiroDelayResult {
        mass_msun: mass_msun,
        impact_d: impact_d,
        delay_ns: delay_ns,
        round_trip_ns: 2 * delay_ns,
        flag_bits: 1
    };
}

pub fn binary_pulsar_shapiro_params(
    companion_milli_msun: Int,
    s_milli: Int
) -> BinaryPulsarShapiro {
    if companion_milli_msun <= 0 {
        return BinaryPulsarShapiro {
            companion_milli_msun: companion_milli_msun,
            s_milli: s_milli,
            range_ns: 0,
            max_delay_ns: 0,
            flag_bits: 0
        };
    }
    if s_milli <= 0 {
        return BinaryPulsarShapiro {
            companion_milli_msun: companion_milli_msun,
            s_milli: s_milli,
            range_ns: (4925 * companion_milli_msun) / 1000,
            max_delay_ns: 0,
            flag_bits: 0
        };
    }
    if s_milli >= 1000 {
        return BinaryPulsarShapiro {
            companion_milli_msun: companion_milli_msun,
            s_milli: s_milli,
            range_ns: (4925 * companion_milli_msun) / 1000,
            max_delay_ns: 0,
            flag_bits: 0
        };
    }
    let range_ns: Int = (4925 * companion_milli_msun) / 1000;
    let one_minus: Int = 1000 - s_milli;
    let ln_om: Int = shapiro_iln_milli(one_minus);
    let ln_thou: Int = shapiro_iln_milli(1000);
    let mut nln: Int = 0;
    if ln_thou > ln_om {
        nln = ln_thou - ln_om;
    }
    let max_delay_ns: Int = (2 * range_ns * nln) / 1000;
    return BinaryPulsarShapiro {
        companion_milli_msun: companion_milli_msun,
        s_milli: s_milli,
        range_ns: range_ns,
        max_delay_ns: max_delay_ns,
        flag_bits: 1
    };
}

pub fn shapiro_delay_ns(r: ShapiroDelayResult) -> Int {
    return r.delay_ns;
}

pub fn shapiro_flags(r: ShapiroDelayResult) -> Int {
    return r.flag_bits;
}
