// # Kerr Black Hole Ringdown Quasi-Normal Modes (QNM)
//
// Logline: Calculates fundamental (l=2, m=2, n=0) gravitational wave quasi-normal mode frequencies and damping times for perturbed Kerr black holes.
//
// Setup: Implements Berti, Cardoso & Will (2006) and Echeverria (1989) spectroscopic fitting formulas.
//
// Beats:
//   1. Compute dimensionless QNM frequency factor f_220 * M and quality factor Q_220 as functions of Kerr spin a_*.
//   2. Calculate physical ringdown oscillation frequency f_ring (Hz) and exponential decay damping time tau_ring (seconds).
//   3. Invert observed ringdown frequency and damping time to test the no-hair theorem and measure black hole mass and spin.

import "./astro_rel_constants.oo";

pub type QuasiNormalModeResult = struct {
    mass_kg: Float,
    spin_a_star: Float,
    qnm_frequency_hz: Float,
    damping_time_s: Float,
    quality_factor_q: Float,
    num_cycles_in_decay: Float
};

pub fn qnm_fundamental_l2m2_evaluate(
    mass_kg: Float,
    dimensionless_spin_a_star: Float
) -> QuasiNormalModeResult {
    let a: Float = math_max(math_min(dimensionless_spin_a_star, 0.999), 0.0);
    if mass_kg <= 0.0 {
        return QuasiNormalModeResult {
            mass_kg: mass_kg,
            spin_a_star: a,
            qnm_frequency_hz: 0.0,
            damping_time_s: 0.0,
            quality_factor_q: 0.0,
            num_cycles_in_decay: 0.0
        };
    }

    let g_val: Float = const_g();
    let c_val: Float = const_c();
    let c3: Float = c_val * (c_val * c_val);

    // Berti et al. (2006) fitting coefficients for (l=2, m=2, n=0):
    // f * (2*pi*G*M / c^3) = f1 + f2 * (1 - a)^f3
    // For (2,2,0): f1 = 1.5251, f2 = -1.1568, f3 = 0.1292
    let one_minus_a: Float = math_max(1.0 - a, 0.0001);
    let omega_dim: Float = 1.5251 - (1.1568 * pow(one_minus_a, 0.1292));

    // Quality factor: Q = q1 + q2 * (1 - a)^q3
    // For (2,2,0): q1 = 0.7000, q2 = 1.4187, q3 = -0.4990
    let q_factor: Float = 0.7000 + (1.4187 * pow(one_minus_a, 0.0 - 0.4990));

    // Physical angular frequency: omega_R = omega_dim * c^3 / (G * M)
    let gm_c3: Float = (g_val * mass_kg) / c3;
    let omega_r: Float = omega_dim / gm_c3;
    let f_hz: Float = omega_r / const_two_pi();

    // Damping time: tau = 2 * Q / omega_R
    let tau_s: Float = if omega_r > 0.0 { (2.0 * q_factor) / omega_r } else { 0.0 };

    // Number of cycles in damping envelope ~ f_hz * tau_s
    let cycles: Float = f_hz * tau_s;

    return QuasiNormalModeResult {
        mass_kg: mass_kg,
        spin_a_star: a,
        qnm_frequency_hz: f_hz,
        damping_time_s: tau_s,
        quality_factor_q: q_factor,
        num_cycles_in_decay: cycles
    };
}
