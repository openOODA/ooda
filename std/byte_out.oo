// # Fail-closed byte payload box
//
// Logline: Carries an ok flag, an error string, and a List[Int] payload so codecs can fail closed without Result[List[Int]] extraction.
//
// Setup: Pure. Used by wire and compression codecs. oodac_bin cannot match Result[List[Int], String] Ok lists.
//
// Beats:
//   1. Box a successful byte list.
//   2. Box an error with an empty payload.
//   3. Project the box to Result[Int, String] for status checks.

pub type ByteOut = struct {
    flag: Int,
    err: String,
    bytes: List[Int]
};

pub fn byte_out_ok(b: List[Int]) -> ByteOut { return ByteOut { flag: 1, err: "", bytes: b }; }

pub fn byte_out_err(m: String) -> ByteOut { return ByteOut { flag: 0, err: m, bytes: list_new() }; }

pub fn byte_out_stat(o: ByteOut) -> Result[Int, String] {
    if o.flag < 1 {
        return Err(o.err);
    }
    return Ok(1);
}
