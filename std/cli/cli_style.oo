// # Terminal ANSI Styling and Layout
//
// Logline: Composable declarative styling engine providing ANSI colors, bold text, margins, padding, and box borders.
//
// Setup: Formats text output for terminal displays with full 16-color, 256-color, and 24-bit TrueColor support.
//
// Beats:
//   1. Define CliColor and CliTextStyle supporting 16-color, 256-color, and 24-bit RGB palettes.
//   2. Apply ANSI color escape sequences, text attributes (bold, dim, underline, reverse), and reset codes.
//   3. Render structured box frames, dividers, and padded alignment around text blocks.
//   4. Maintain legacy compatibility definitions for older smoke suites.

pub type CliColor = struct {
    mode: Int,
    code: Int,
    r: Int,
    g: Int,
    b: Int
};

pub type CliTextStyle = struct {
    fg: CliColor,
    bg: CliColor,
    bold: Bool,
    dim: Bool,
    italic: Bool,
    underline: Bool,
    reverse: Bool
};

pub type CliStyleDefinition = struct {
    fg_color: String,
    is_bold: Bool,
    has_border: Bool
};

pub fn cli_style_definition_new(fg: String, bold: Bool, border: Bool) -> CliStyleDefinition { return CliStyleDefinition { fg_color: fg, is_bold: bold, has_border: border }; }

pub fn cli_style_render(style: CliStyleDefinition, text: String) -> String {
    let mut out: String = "";
    if style.is_bold { out = out + "\x1b[1m"; }
    let fg: String = style.fg_color;
    if fg == "green" { out = out + "\x1b[32m"; }
    else if fg == "cyan" { out = out + "\x1b[36m"; }
    else if fg == "red" { out = out + "\x1b[31m"; }
    else if fg == "yellow" { out = out + "\x1b[33m"; }
    else if fg == "blue" { out = out + "\x1b[34m"; }
    out = out + text + "\x1b[0m";
    return out;
}

pub fn cli_color_none() -> CliColor { return CliColor { mode: 0, code: 0, r: 0, g: 0, b: 0 }; }

pub fn cli_color_ansi(code: Int) -> CliColor { return CliColor { mode: 1, code: code, r: 0, g: 0, b: 0 }; }

pub fn cli_color_ansi256(code: Int) -> CliColor { return CliColor { mode: 2, code: code, r: 0, g: 0, b: 0 }; }

pub fn cli_color_rgb(r: Int, g: Int, b: Int) -> CliColor { return CliColor { mode: 3, code: 0, r: r, g: g, b: b }; }

pub fn cli_style_new() -> CliTextStyle { return CliTextStyle {
        fg: cli_color_none(),
        bg: cli_color_none(),
        bold: false,
        dim: false,
        italic: false,
        underline: false,
        reverse: false
    }; }

pub fn cli_style_fg(style: CliTextStyle, c: CliColor) -> CliTextStyle {
    let mut s: CliTextStyle = style;
    s.fg = c;
    return s;
}

pub fn cli_style_bg(style: CliTextStyle, c: CliColor) -> CliTextStyle {
    let mut s: CliTextStyle = style;
    s.bg = c;
    return s;
}

pub fn cli_style_bold(style: CliTextStyle, b: Bool) -> CliTextStyle {
    let mut s: CliTextStyle = style;
    s.bold = b;
    return s;
}

pub fn cli_style_underline(style: CliTextStyle, u: Bool) -> CliTextStyle {
    let mut s: CliTextStyle = style;
    s.underline = u;
    return s;
}

pub fn cli_style_apply(style: CliTextStyle, text: String) -> String {
    let mut out: String = "";
    if style.bold { out = out + "\x1b[1m"; }
    if style.dim { out = out + "\x1b[2m"; }
    if style.italic { out = out + "\x1b[3m"; }
    if style.underline { out = out + "\x1b[4m"; }
    if style.reverse { out = out + "\x1b[7m"; }

    let fg: CliColor = style.fg;
    if fg.mode == 1 {
        out = out + "\x1b[" + fg.code.to_string() + "m";
    } else if fg.mode == 2 {
        out = out + "\x1b[38;5;" + fg.code.to_string() + "m";
    } else if fg.mode == 3 {
        out = out + "\x1b[38;2;" + fg.r.to_string() + ";" + fg.g.to_string() + ";" + fg.b.to_string() + "m";
    }

    let bg: CliColor = style.bg;
    if bg.mode == 1 {
        out = out + "\x1b[" + bg.code.to_string() + "m";
    } else if bg.mode == 2 {
        out = out + "\x1b[48;5;" + bg.code.to_string() + "m";
    } else if bg.mode == 3 {
        out = out + "\x1b[48;2;" + bg.r.to_string() + ";" + bg.g.to_string() + ";" + bg.b.to_string() + "m";
    }

    out = out + text + "\x1b[0m";
    return out;
}

pub fn cli_style_box_frame(title: String, content: String) -> String {
    let mut out: String = "+--- " + title + " ---+\n| " + content + " |\n+-------------------+\n";
    return out;
}

pub fn cli_style_pad_left(text: String, width: Int) -> String {
    let t_len: Int = text.len();
    if t_len >= width { return text; }
    let mut pad: String = "";
    let mut i: Int = 0;
    while i < (width - t_len) {
        pad = pad + " ";
        i = i + 1;
    }
    return pad + text;
}

pub fn cli_style_pad_right(text: String, width: Int) -> String {
    let t_len: Int = text.len();
    if t_len >= width { return text; }
    let mut pad: String = "";
    let mut i: Int = 0;
    while i < (width - t_len) {
        pad = pad + " ";
        i = i + 1;
    }
    return text + pad;
}

pub fn cli_style_divider(width: Int, glyph: String) -> String {
    let mut out: String = "";
    let mut i: Int = 0;
    while i < width {
        out = out + glyph;
        i = i + 1;
    }
    return out;
}
