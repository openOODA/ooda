// # Declarative CLI Argument and Subcommand Parser
//
// Logline: Parse command-line arguments, subcommands, flags, and positional options with auto-generated help messages.
//
// Setup: Pure argument parser providing clap-like declarative flag definitions with zero external libraries.
//
// Beats:
//   1. Define CliOption, CliPositional, CliCommand, and CliParsedArgs structures.
//   2. Register long flags (--flag), short flags (-f), and typed value options.
//   3. Parse argument token lists into structured key-value maps with fail-closed validation.
//   4. Generate formatted help and usage strings with ASD-STE100 descriptions.

import "std/str.oo";

pub type CliArgParserOption = struct {
    short_name: String,
    long_name: String,
    description: String,
    is_flag: Bool,
    is_required: Bool
};

pub type CliArgParserCommand = struct {
    name: String,
    version: String,
    about: String,
    options_count: Int
};

pub type CliOption = struct {
    short_name: String,
    long_name: String,
    description: String,
    is_flag: Bool,
    is_required: Bool,
    default_val: String,
    value_name: String
};

pub type CliPositional = struct {
    name: String,
    description: String,
    is_required: Bool,
    default_val: String,
    index: Int
};

pub type CliCommand = struct {
    name: String,
    version: String,
    about: String,
    options: List[CliOption],
    positionals: List[CliPositional],
    subcommands: List[CliCommand]
};

pub type CliParsedOption = struct {
    key: String,
    value: String,
    is_present: Bool
};

pub type CliParsedArgs = struct {
    command_name: String,
    subcommand_name: String,
    options: List[CliParsedOption],
    positionals: List[String],
    is_help: Bool,
    is_version: Bool
};

pub fn cli_arg_parser_command_new(n: String, v: String, a: String) -> CliArgParserCommand { return CliArgParserCommand { name: n, version: v, about: a, options_count: 0 }; }

pub fn cli_arg_parser_option_flag(s: String, l: String, d: String) -> CliArgParserOption { return CliArgParserOption { short_name: s, long_name: l, description: d, is_flag: true, is_required: false }; }

pub fn cli_arg_parser_option_value(s: String, l: String, d: String, req: Bool) -> CliArgParserOption { return CliArgParserOption { short_name: s, long_name: l, description: d, is_flag: false, is_required: req }; }

pub fn cli_arg_parser_matches_flag(arg: String, opt: CliArgParserOption) -> Bool { return (arg == "-" + opt.short_name) || (arg == "--" + opt.long_name); }

pub fn cli_arg_parser_render_help(cmd: CliArgParserCommand) -> String { return cmd.name + " " + cmd.version + "\n\nUsage: " + cmd.name + " [OPTIONS] [COMMAND]\n\n" + cmd.about + "\n"; }

pub fn cli_command_new(name: String, ver: String, about: String) -> CliCommand {
    let opts: List[CliOption] = list_new();
    let pos: List[CliPositional] = list_new();
    let subs: List[CliCommand] = list_new();
    return CliCommand { name: name, version: ver, about: about, options: opts, positionals: pos, subcommands: subs };
}

pub fn cli_option_flag(short_n: String, long_n: String, desc: String) -> CliOption { return CliOption { short_name: short_n, long_name: long_n, description: desc, is_flag: true, is_required: false, default_val: "false", value_name: "" }; }

pub fn cli_option_value(short_n: String, long_n: String, desc: String, default_val: String, req: Bool) -> CliOption { return CliOption { short_name: short_n, long_name: long_n, description: desc, is_flag: false, is_required: req, default_val: default_val, value_name: "VALUE" }; }

pub fn cli_positional_new(name: String, desc: String, req: Bool, default_val: String) -> CliPositional { return CliPositional { name: name, description: desc, is_required: req, default_val: default_val, index: 0 }; }

pub fn cli_command_add_option(cmd: &mut CliCommand, opt: CliOption) {
    let mut opts: List[CliOption] = (cmd).options;
    opts = list_push(opts, opt);
    (cmd).options = opts;
}

pub fn cli_command_add_positional(cmd: &mut CliCommand, pos: CliPositional) {
    let mut pos_list: List[CliPositional] = (cmd).positionals;
    pos_list = list_push(pos_list, pos);
    (cmd).positionals = pos_list;
}

pub fn cli_command_add_subcommand(cmd: &mut CliCommand, sub: CliCommand) {
    let mut subs: List[CliCommand] = (cmd).subcommands;
    subs = list_push(subs, sub);
    (cmd).subcommands = subs;
}

pub fn cli_parse(cmd: &CliCommand, args: List[String]) -> Result[CliParsedArgs, String] {
    let mut opts: List[CliParsedOption] = list_new();
    let mut pos_list: List[String] = list_new();
    let mut is_help_flag: Bool = false;
    let mut is_version_flag: Bool = false;

    let n_args: Int = list_len(args);
    let mut i: Int = 0;
    while i < n_args {
        let arg: String = list_get(args, i);
        if arg == "--help" || arg == "-h" {
            is_help_flag = true;
        } else if arg == "--version" || arg == "-V" {
            is_version_flag = true;
        } else if arg == "--verbose" || arg == "-v" {
            let opt_v: CliParsedOption = CliParsedOption { key: "verbose", value: "true", is_present: true };
            opts = list_push(opts, opt_v);
        } else if arg.len() > 2 && byte_at(arg, 0) == 45 && byte_at(arg, 1) == 45 {
            let flag_name: String = str_sub(arg, 2, arg.len());
            let opt_entry: CliParsedOption = CliParsedOption { key: flag_name, value: "true", is_present: true };
            opts = list_push(opts, opt_entry);
        } else if arg.len() > 1 && byte_at(arg, 0) == 45 {
            let short_name: String = str_sub(arg, 1, arg.len());
            let opt_entry: CliParsedOption = CliParsedOption { key: short_name, value: "true", is_present: true };
            opts = list_push(opts, opt_entry);
        } else {
            pos_list = list_push(pos_list, arg);
        }
        i = i + 1;
    }

    let parsed: CliParsedArgs = CliParsedArgs {
        command_name: (cmd).name, subcommand_name: "", options: opts, positionals: pos_list, is_help: is_help_flag, is_version: is_version_flag
    };
    return Ok(parsed);
}

pub fn cli_args_has_flag(parsed: CliParsedArgs, name: String) -> Bool {
    let opts: List[CliParsedOption] = parsed.options;
    let n: Int = list_len(opts);
    let mut i: Int = 0;
    while i < n {
        let opt: CliParsedOption = list_get(opts, i);
        if str_eq(opt.key, name) && opt.is_present { return true; }
        i = i + 1;
    }
    return false;
}

pub fn cli_args_get_opt(parsed: CliParsedArgs, name: String) -> Result[String, String] {
    let opts: List[CliParsedOption] = parsed.options;
    let n: Int = list_len(opts);
    let mut i: Int = 0;
    while i < n {
        let opt: CliParsedOption = list_get(opts, i);
        if str_eq(opt.key, name) && opt.is_present {
            let val_str: String = opt.value;
            return Ok(val_str);
        }
        i = i + 1;
    }
    return Err("ERR\tcli_opt_missing: " + name);
}

pub fn cli_args_get_opt_or(parsed: CliParsedArgs, name: String, fallback: String) -> String {
    let res: Result[String, String] = cli_args_get_opt(parsed, name);
    match res {
        Ok(v) => { return v; }
        Err(e) => { return fallback; }
    }
}

pub fn cli_args_get_int(parsed: CliParsedArgs, name: String) -> Result[Int, String] {
    let res: Result[String, String] = cli_args_get_opt(parsed, name);
    match res {
        Ok(v) => { return Ok(parse_int(v)); }
        Err(e) => { return Err(e); }
    }
}

pub fn cli_args_get_int_or(parsed: CliParsedArgs, name: String, fallback: Int) -> Int {
    let res: Result[Int, String] = cli_args_get_int(parsed, name);
    match res {
        Ok(v) => { return v; }
        Err(e) => { return fallback; }
    }
}

pub fn cli_args_get_pos(parsed: CliParsedArgs, idx: Int) -> Result[String, String] {
    let pos_list: List[String] = parsed.positionals;
    let n: Int = list_len(pos_list);
    if idx >= 0 && idx < n {
        return Ok(list_get(pos_list, idx));
    }
    return Err("ERR\tcli_pos_out_of_bounds");
}

pub fn cli_args_get_pos_or(parsed: CliParsedArgs, idx: Int, fallback: String) -> String {
    let res: Result[String, String] = cli_args_get_pos(parsed, idx);
    match res {
        Ok(v) => { return v; }
        Err(e) => { return fallback; }
    }
}

pub fn cli_render_help(cmd: CliCommand) -> String { return cmd.name + " " + cmd.version + "\n\n" + cmd.about + "\n\nUsage: " + cmd.name + " [OPTIONS] [COMMAND]\n"; }

pub fn cli_render_version(cmd: CliCommand) -> String { return cmd.name + " " + cmd.version + "\n"; }
