// # Shell Completion Generator
//
// Logline: Generate automated shell tab-completion scripts for Bash, Zsh, and Fish shells from CLI command schemas.
//
// Setup: Inspects command trees, subcommands, and flags to output shell-native auto-completion functions.
//
// Beats:
//   1. Generate Bash programmable completion scripts with COMPREPLY words.
//   2. Generate Zsh completion functions using _arguments specification.
//   3. Generate Fish completion declarations using complete -c directives.
//   4. Validate syntax and non-empty completion outputs across all three shells.
pub type CliCompletionGenerator = struct {
    binary_name: String,
    subcommands_list: String,
    flags_list: String
};

pub fn cli_completion_generator_new(bin_name: String, subcmds: String, flags: String) -> CliCompletionGenerator { return CliCompletionGenerator {
        binary_name: bin_name,
        subcommands_list: subcmds,
        flags_list: flags
    }; }

pub fn cli_completion_render_bash(gen: CliCompletionGenerator) -> String {
    let b: String = gen.binary_name;
    let sub: String = gen.subcommands_list;
    let flg: String = gen.flags_list;

    let mut out: String = "_" + b + "_completions() {\n  local cur=\"${COMP_WORDS[COMP_CWORD]}\"\n  COMPREPLY=($(compgen -W \"";
    out = out + sub + " " + flg + "\" -- \"$cur\"))\n}\ncomplete -F _" + b + "_completions " + b + "\n";
    return out;
}

pub fn cli_completion_render_zsh(gen: CliCompletionGenerator) -> String {
    let b: String = gen.binary_name;
    let sub: String = gen.subcommands_list;
    let flg: String = gen.flags_list;
    let mut out: String = "#compdef " + b + "\n_" + b + "() {\n  _arguments -s \\\n";
    out = out + "    '--help[Show help]' \\\n    '--version[Show version]'\n";
    if sub.len() > 0 || flg.len() > 0 {
        out = out + "  # " + sub + " " + flg + "\n";
    }
    out = out + "}\n_" + b + " \"$@\"\n";
    return out;
}

pub fn cli_completion_render_fish(gen: CliCompletionGenerator) -> String {
    let b: String = gen.binary_name;
    let sub: String = gen.subcommands_list;
    let mut out: String = "complete -c " + b + " -f\ncomplete -c " + b + " -a \"" + sub + "\"\n";
    return out;
}


