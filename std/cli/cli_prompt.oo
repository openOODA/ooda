// # Interactive CLI Prompt Engine
//
// Logline: Formatter and parser for interactive CLI text prompts, confirmations, passwords, and option menus.
//
// Setup: Pure prompt engine rendering clear ASD-STE100 prompts and parsing terminal user responses.
//
// Beats:
//   1. Format text, password, confirmation, and selection prompt messages.
//   2. Parse and validate boolean confirmation responses ([y/N] and [Y/n]).
//   3. Parse integer and menu index selection inputs with boundary checking.
//   4. Render multi-select checkbox menus and radio buttons.

import "std/str.oo";

pub fn cli_prompt_text_format(prompt: String, default_val: String) -> String {
    let mut out: String = "? " + prompt;
    if default_val.len() > 0 {
        out = out + " [" + default_val + "]";
    }
    return out + ": ";
}

pub fn cli_prompt_password_format(prompt: String, mask_char: String) -> String { return "? " + prompt + " (" + mask_char + "): "; }

pub fn cli_prompt_confirm_format(prompt: String, default_yes: Bool) -> String {
    if default_yes {
        return "? " + prompt + " [Y/n]: ";
    }
    return "? " + prompt + " [y/N]: ";
}

pub fn cli_prompt_select_format(prompt: String, options: List[String], selected_idx: Int) -> String {
    let mut out: String = "? " + prompt + "\n";
    let n: Int = list_len(options);
    let mut i: Int = 0;
    while i < n {
        let opt: String = list_get(options, i);
        if i == selected_idx {
            out = out + "  > [x] " + (i + 1).to_string() + ") " + opt + "\n";
        } else {
            out = out + "    [ ] " + (i + 1).to_string() + ") " + opt + "\n";
        }
        i = i + 1;
    }
    out = out + "Select [1-" + n.to_string() + "]: ";
    return out;
}

pub fn cli_prompt_multiselect_format(prompt: String, options: List[String], selected_indices: List[Int]) -> String {
    let mut out: String = "? " + prompt + " (space to toggle, enter to submit)\n";
    let n: Int = list_len(options);
    let n_sel: Int = list_len(selected_indices);
    let mut i: Int = 0;
    while i < n {
        let opt: String = list_get(options, i);
        let mut is_checked: Bool = false;
        let mut j: Int = 0;
        while j < n_sel {
            if list_get(selected_indices, j) == i {
                is_checked = true;
            }
            j = j + 1;
        }
        if is_checked {
            out = out + "  [x] " + opt + "\n";
        } else {
            out = out + "  [ ] " + opt + "\n";
        }
        i = i + 1;
    }
    return out;
}

fn prompt_clean_input(response: String) -> String {
    let mut out: String = "";
    let n: Int = chars_len(response);
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(response, i);
        if b != 10 && b != 13 {
            out = out + char_at(response, i);
        }
        i = i + 1;
    }
    return str_trim(out);
}

pub fn cli_prompt_parse_confirm(response: String, default_yes: Bool) -> Bool {
    let clean: String = prompt_clean_input(response);
    if clean.len() == 0 {
        return default_yes;
    }
    if clean == "y" || clean == "Y" || clean == "yes" || clean == "YES" || clean == "1" || clean == "true" {
        return true;
    }
    if clean == "n" || clean == "N" || clean == "no" || clean == "NO" || clean == "0" || clean == "false" {
        return false;
    }
    return default_yes;
}

pub fn cli_prompt_parse_int(response: String, default_val: Int) -> Result[Int, String] {
    let clean: String = prompt_clean_input(response);
    if clean.len() == 0 {
        return Ok(default_val);
    }
    let val: Int = parse_int(clean);
    return Ok(val);
}

pub fn cli_prompt_parse_select(response: String, max_options: Int) -> Result[Int, String] {
    let clean: String = prompt_clean_input(response);
    if clean.len() == 0 {
        return Err("ERR\tcli_prompt_empty_selection");
    }
    let val: Int = parse_int(clean);
    if val >= 1 && val <= max_options {
        return Ok(val - 1);
    }
    return Err("ERR\tcli_prompt_invalid_option");
}
