// # Element-Wise Tensor Arithmetic & Non-Linear Functions
//
// Logline: Implements vectorized element-wise arithmetic, scalar operations, and activation functions (ReLU, Tanh, Sigmoid).
//
// Setup: Pure numerical algebra engine executing element-wise transformations on Tensor containers.
//
// Beats:
//   1. Compute element-wise addition, subtraction, multiplication, and division.
//   2. Apply ReLU non-linear activation max(0, x).
//   3. Apply Tanh and Sigmoid activation functions.
//   4. Clamp tensor elements to specified numerical boundaries.

import "std/tensor/tensor.oo";

/// Add two tensors element-wise.
pub fn tensor_ops_add(a: &Tensor, b: &Tensor) -> Result[Tensor, String] { return tensor_add(a, b); }

/// Multiply two tensors element-wise (Hadamard product).
pub fn tensor_ops_mul(a: &Tensor, b: &Tensor) -> Result[Tensor, String] {
    let n: Int = (a).numel;
    if n != (b).numel {
        return Err("ERR\ttensor_mul: shape numel mismatch");
    }
    let a_data: List[Float] = (a).data;
    let b_data: List[Float] = (b).data;
    let mut out: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        let va: Float = list_get(a_data, i);
        let vb: Float = list_get(b_data, i);
        out = list_push(out, va * vb);
        i = i + 1;
    }
    return Ok(Tensor {
        data: out,
        dims: (a).dims,
        rank: (a).rank,
        numel: n,
        requires_grad: (a).requires_grad || (b).requires_grad,
        tensor_id: (a).tensor_id + 1
    });
}
