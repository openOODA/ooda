// # Transaction Undo Log Module
//
// Logline: Write-ahead undo logging tracking memory mutations, before-images, and transaction sequences.
//
// Setup: Pure memory transaction journal supporting forward commit and reverse undo unwinding.
//
// Beats:
//   1. Construct TxnEntry with address, before-image, after-image, and timestamp.
//   2. Append mutation records to ordered TxnLog buffer.
//   3. Filter and extract active mutation log entries for specified transaction ID.
//   4. Truncate log upon successful transaction commit or full rollback.
// RULES.oot 1.7: Under 256 lines.

pub type TxnEntry = struct {
    entry_id: Int,
    txn_id: Int,
    address: Int,
    old_value: Int,
    new_value: Int,
    timestamp: Int
};

pub type TxnLog = struct {
    entries: List[TxnEntry],
    next_entry_id: Int,
    active_txn_id: Int,
    count: Int
};

pub fn txn_log_new() -> TxnLog {
    let empty_entries: List[TxnEntry] = list_new();
    return TxnLog {
        entries: empty_entries,
        next_entry_id: 1,
        active_txn_id: 0,
        count: 0
    };
}

pub fn txn_log_append(
    log: TxnLog,
    txn_id: Int,
    addr: Int,
    old_val: Int,
    new_val: Int,
    ts: Int
) -> TxnLog {
    let eid: Int = log.next_entry_id;
    let entry = TxnEntry {
        entry_id: eid,
        txn_id: txn_id,
        address: addr,
        old_value: old_val,
        new_value: new_val,
        timestamp: ts
    };
    let new_entries: List[TxnEntry] = list_push(log.entries, entry);
    let next_id: Int = eid + 1;
    let next_count: Int = log.count + 1;
    return TxnLog {
        entries: new_entries,
        next_entry_id: next_id,
        active_txn_id: txn_id,
        count: next_count
    };
}

pub fn txn_log_get_entries_for_txn(log: TxnLog, txn_id: Int) -> List[TxnEntry] {
    let mut out: List[TxnEntry] = list_new();
    let n: Int = log.count;
    let mut i: Int = 0;
    while i < n {
        let entry: TxnEntry = list_get(log.entries, i);
        if entry.txn_id == txn_id {
            out = list_push(out, entry);
        }
        i = i + 1;
    }
    return out;
}

pub fn txn_log_truncate_from(log: TxnLog, entry_id: Int) -> TxnLog {
    let mut kept: List[TxnEntry] = list_new();
    let n: Int = log.count;
    let mut i: Int = 0;
    let mut kept_count: Int = 0;
    while i < n {
        let entry: TxnEntry = list_get(log.entries, i);
        if entry.entry_id < entry_id {
            kept = list_push(kept, entry);
            kept_count = kept_count + 1;
        }
        i = i + 1;
    }
    return TxnLog {
        entries: kept,
        next_entry_id: log.next_entry_id,
        active_txn_id: log.active_txn_id,
        count: kept_count
    };
}

pub fn txn_log_count(log: TxnLog) -> Int {
    return log.count;
}

pub fn txn_log_clear(log: TxnLog) -> TxnLog {
    let empty: List[TxnEntry] = list_new();
    return TxnLog {
        entries: empty,
        next_entry_id: 1,
        active_txn_id: 0,
        count: 0
    };
}
