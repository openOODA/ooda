// # Memory Checkpoint & Savepoint Module
//
// Logline: Point-in-time memory checkpoint stack supporting nested savepoints and selective restoration.
//
// Setup: Pure savepoint stack tracker for Undo-RAM transaction contexts.
//
// Beats:
//   1. Define Checkpoint record with savepoint ID, transaction ID, and log sequence offset.
//   2. Push and pop checkpoints onto bounded CheckpointStack.
//   3. Query savepoint depth and lookup savepoints by monotonic ID.
// RULES.oot 1.7: Under 256 lines.

pub type Checkpoint = struct {
    cp_id: Int,
    txn_id: Int,
    log_offset: Int,
    timestamp: Int,
    name: String
};

pub type CheckpointStack = struct {
    checkpoints: List[Checkpoint],
    count: Int,
    next_cp_id: Int,
    max_depth: Int
};

pub fn checkpoint_stack_new(max_depth: Int) -> CheckpointStack {
    let mut md: Int = max_depth;
    if md < 1 { md = 32; }
    let empty: List[Checkpoint] = list_new();
    return CheckpointStack {
        checkpoints: empty,
        count: 0,
        next_cp_id: 1,
        max_depth: md
    };
}

pub fn checkpoint_push(
    stack: CheckpointStack,
    txn_id: Int,
    log_offset: Int,
    ts: Int,
    name: String
) -> Result[CheckpointStack, String] {
    let c: Int = stack.count;
    let md: Int = stack.max_depth;
    if c >= md {
        return Err("E_CHECKPOINT_OVERFLOW: maximum savepoint depth exceeded");
    }
    let cid: Int = stack.next_cp_id;
    let cp = Checkpoint {
        cp_id: cid,
        txn_id: txn_id,
        log_offset: log_offset,
        timestamp: ts,
        name: name
    };
    let new_cps: List[Checkpoint] = list_push(stack.checkpoints, cp);
    let next_id: Int = cid + 1;
    let next_count: Int = c + 1;
    return Ok(CheckpointStack {
        checkpoints: new_cps,
        count: next_count,
        next_cp_id: next_id,
        max_depth: md
    });
}

pub fn checkpoint_pop(stack: CheckpointStack) -> Result[CheckpointStack, String] {
    let c: Int = stack.count;
    if c <= 0 {
        return Err("E_CHECKPOINT_UNDERFLOW: cannot pop from empty checkpoint stack");
    }
    let mut new_cps: List[Checkpoint] = list_new();
    let mut i: Int = 0;
    let target_count: Int = c - 1;
    while i < target_count {
        new_cps = list_push(new_cps, list_get(stack.checkpoints, i));
        i = i + 1;
    }
    return Ok(CheckpointStack {
        checkpoints: new_cps,
        count: target_count,
        next_cp_id: stack.next_cp_id,
        max_depth: stack.max_depth
    });
}

pub fn checkpoint_peek(stack: CheckpointStack) -> Result[Checkpoint, String] {
    let c: Int = stack.count;
    if c <= 0 {
        return Err("E_CHECKPOINT_EMPTY: no active checkpoint on stack");
    }
    let last_idx: Int = c - 1;
    let cp: Checkpoint = list_get(stack.checkpoints, last_idx);
    return Ok(cp);
}

pub fn checkpoint_find_by_id(stack: CheckpointStack, cp_id: Int) -> Result[Checkpoint, String] {
    let n: Int = stack.count;
    let mut i: Int = 0;
    while i < n {
        let cp: Checkpoint = list_get(stack.checkpoints, i);
        let cid: Int = cp.cp_id;
        if cid == cp_id {
            return Ok(cp);
        }
        i = i + 1;
    }
    return Err("E_CHECKPOINT_NOT_FOUND: no checkpoint matching id");
}

pub fn checkpoint_count(stack: CheckpointStack) -> Int {
    return stack.count;
}
