// package: std — pure path semantic version core (major.minor.patch)
// job: hand-rolled parse for pure multi; String/char_at/str_slice/chars_len/while/if
// caps: none (no FS/net/env)
// residual: prerelease (-...) and build (+...) NOT accepted (invalid); no SemVer struct
//   (Backend-C pure path does not lower custom struct types — use Result + extractors)
// Path A honesty: pure string logic; no regex engine.
// Note: public names use semver_* prefix (Linux sys/sysmacros.h owns major/minor).

// Scan a numeric id [0]|[1-9][0-9]* at start. Returns end index exclusive, or -1.
fn semver_scan_num(s: String, start: Int, len: Int) -> Int {
    let mut i = start;
    if i >= len {
        return -1;
    }
    if char_is_digit(char_at(s, i)) {
        i = i + 1;
    } else {
        return -1;
    }
    while i < len {
        if char_is_digit(char_at(s, i)) {
            i = i + 1;
        } else {
            if i - start > 1 {
                if char_at(s, start) == "0" {
                    return -1;
                }
            }
            return i;
        }
    }
    if i - start > 1 {
        if char_at(s, start) == "0" {
            return -1;
        }
    }
    return i;
}

// Component which: 0=major, 1=minor, 2=patch. Empty string if invalid.
// Requires full "X.Y.Z" with nothing after (prerelease/build -> residual invalid).
fn semver_part(s: String, which: Int) -> String {
    let len = chars_len(s);
    let mut i = 0;
    let e0 = semver_scan_num(s, i, len);
    if e0 < 0 {
        return "";
    }
    let maj = str_slice(s, i, e0);
    i = e0;
    if i >= len {
        return "";
    }
    if char_at(s, i) != "." {
        return "";
    }
    i = i + 1;
    let e1 = semver_scan_num(s, i, len);
    if e1 < 0 {
        return "";
    }
    let minv = str_slice(s, i, e1);
    i = e1;
    if i >= len {
        return "";
    }
    if char_at(s, i) != "." {
        return "";
    }
    i = i + 1;
    let e2 = semver_scan_num(s, i, len);
    if e2 < 0 {
        return "";
    }
    let pat = str_slice(s, i, e2);
    i = e2;
    // residual: reject trailing prerelease/build/garbage
    if i != len {
        return "";
    }
    if which == 0 {
        return maj;
    }
    if which == 1 {
        return minv;
    }
    return pat;
}

// Major component of "X.Y.Z", or "" if invalid.
pub fn semver_major(s: String) -> String {
    return semver_part(s, 0);
}

// Minor component of "X.Y.Z", or "" if invalid.
pub fn semver_minor(s: String) -> String {
    return semver_part(s, 1);
}

// Patch component of "X.Y.Z", or "" if invalid.
pub fn semver_patch(s: String) -> String {
    return semver_part(s, 2);
}

// True when s is a valid core "X.Y.Z" (no prerelease/build).
pub fn semver_is_valid(s: String) -> Bool {
    let m = semver_major(s);
    if m == "" {
        return false;
    }
    return true;
}

// Parse core version. Ok(s) when valid X.Y.Z; Err("invalid") otherwise.
// Residual: prerelease/build forms fail closed (not partial-accepted).
// Named semver_parse (not parse) to avoid c_call_result_ty / name collisions.
pub fn semver_parse(s: String) -> Result[String, String] {
    if semver_is_valid(s) {
        return Ok(s);
    }
    return Err("invalid");
}
