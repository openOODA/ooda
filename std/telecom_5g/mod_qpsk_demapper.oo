// # QPSK Soft Demapper and EVM Metrics
//
// Logline: Implements exact and approximate log-likelihood ratio (LLR) soft demapping and EVM for QPSK symbols.
//
// Setup: Pure standard library implementation of QPSK Gray demapping, noise-scaled soft metrics, and constellation error vector magnitude.
//
// Beats:
//   1. Define QPSK constellation parameters and normalization scaling 1/sqrt(2).
//   2. Compute In-Phase and Quadrature bit soft LLR metrics scaled by channel noise variance.
//   3. Evaluate hard decision slicing quadrant indices and RMS Error Vector Magnitude (EVM).

pub type QpskDemapperConfig = struct {
    norm_factor: Float,
    noise_variance: Float,
    evm_rms_percent: Float
};

pub fn qpsk_demapper_config_new(noise_var: Float) -> QpskDemapperConfig {
    let mut safe_var: Float = noise_var;
    if safe_var <= 0.000001 { safe_var = 0.000001; }

    return QpskDemapperConfig {
        norm_factor: 0.7071067811865475, // 1 / sqrt(2)
        noise_variance: safe_var,
        evm_rms_percent: 0.0
    };
}

pub fn mod_qpsk_soft_llr_b0(rx_i: Float, noise_var: Float) -> Float {
    // For QPSK mapped as (b0, b1): b0 maps to I (0 -> +1/sqrt(2), 1 -> -1/sqrt(2))
    // LLR = 2 * y_I * (1/sqrt(2)) / (sigma^2 / 2) = 2*sqrt(2) * y_I / sigma^2
    // In our convention: LLR > 0 means bit 0 is more likely
    if noise_var <= 0.000001 {
        return rx_i * 1000.0;
    }
    let sqrt2: Float = 1.4142135623730951;
    return (2.0 * sqrt2 * rx_i) / noise_var;
}

pub fn mod_qpsk_soft_llr_b1(rx_q: Float, noise_var: Float) -> Float {
    if noise_var <= 0.000001 {
        return rx_q * 1000.0;
    }
    let sqrt2: Float = 1.4142135623730951;
    return (2.0 * sqrt2 * rx_q) / noise_var;
}

pub fn mod_qpsk_hard_decision(rx_i: Float, rx_q: Float) -> Int {
    let mut b0: Int = 0;
    let mut b1: Int = 0;
    if rx_i < 0.0 { b0 = 1; }
    if rx_q < 0.0 { b1 = 1; }
    return b0 + (b1 * 2);
}

pub fn mod_qpsk_calc_evm_percent(err_mag_sq: Float, ref_mag_sq: Float) -> Float {
    if ref_mag_sq <= 0.000001 {
        return 0.0;
    }
    let evm_ratio: Float = sqrt(err_mag_sq / ref_mag_sq);
    return evm_ratio * 100.0;
}
