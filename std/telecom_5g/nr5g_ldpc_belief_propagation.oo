// # 5G NR LDPC Belief Propagation Decoder
//
// Logline: Implements normalized min-sum and log-likelihood ratio message passing decoding over 5G NR Tanner graphs.
//
// Setup: Pure standard library implementation of check-node and variable-node iterative LDPC decoding.
//
// Beats:
//   1. Define LDPC decoder iteration state, syndrome metrics, and LLR structures.
//   2. Compute check-to-variable normalized min-sum update equations.
//   3. Perform variable-to-check extrinsic LLR aggregation and early termination syndrome checks.

pub type Nr5gLdpcDecoderState = struct {
    max_iterations: Int,
    current_iteration: Int,
    min_sum_alpha: Float,
    syndrome_satisfied: Bool,
    bit_errors_detected: Int,
};

pub fn nr5g_ldpc_decoder_state_new(max_iter: Int, alpha: Float) -> Nr5gLdpcDecoderState {
    let mut safe_alpha: Float = alpha;
    if safe_alpha <= 0.0 || safe_alpha > 1.0 {
        safe_alpha = 0.8125; // Standard 3GPP normalized min-sum scale factor
    }
    return Nr5gLdpcDecoderState {
        max_iterations: max_iter,
        current_iteration: 0,
        min_sum_alpha: safe_alpha,
        syndrome_satisfied: false,
        bit_errors_detected: 0,
    };
}

pub fn nr5g_ldpc_min_sum_boxplus(llr_a: Float, llr_b: Float, alpha: Float) -> Float {
    let mut sign: Float = 1.0;
    if llr_a < 0.0 { sign = 0.0 - sign; }
    if llr_b < 0.0 { sign = 0.0 - sign; }

    let mut abs_a: Float = llr_a;
    if abs_a < 0.0 { abs_a = 0.0 - abs_a; }
    let mut abs_b: Float = llr_b;
    if abs_b < 0.0 { abs_b = 0.0 - abs_b; }

    let mut min_val: Float = abs_a;
    if abs_b < min_val {
        min_val = abs_b;
    }

    return sign * min_val * alpha;
}

pub fn nr5g_ldpc_var_node_update(channel_llr: Float, extrinsic_sum: Float) -> Float {
    return channel_llr + extrinsic_sum;
}

pub fn nr5g_ldpc_hard_decision(total_llr: Float) -> Int {
    if total_llr <= 0.0 {
        return 1; // Bit 1 corresponds to negative LLR in standard log-MAP conventions
    }
    return 0;
}

pub fn nr5g_ldpc_syndrome_check(syndrome_sum: Int) -> Bool {
    return syndrome_sum == 0;
}

pub fn nr5g_ldpc_step_iteration(state: &mut Nr5gLdpcDecoderState, syndrome_ok: Bool, err_count: Int) -> Bool {
    (state).current_iteration = (state).current_iteration + 1;
    (state).syndrome_satisfied = syndrome_ok;
    (state).bit_errors_detected = err_count;

    if syndrome_ok {
        return true; // Early exit on valid codeword
    }
    if (state).current_iteration >= (state).max_iterations {
        return true; // Reached iteration budget
    }
    return false;
}
