// # 3GPP 5G NR Path Loss and Shadow Fading Models
//
// Logline: Implements 3GPP TR 38.901 Urban Micro (UMi) and Urban Macro (UMa) path loss equations and breakpoint distance.
//
// Setup: Pure standard library implementation of frequency-dependent propagation attenuation and shadow fading.
//
// Beats:
//   1. Define propagation environment parameters, base station/UE antenna heights, and carrier frequency.
//   2. Compute Line-of-Sight breakpoint distance d'_BP = 4 * h'_BS * h'_UT * f_c / c.
//   3. Evaluate UMi/UMa LoS and NLoS path loss in dB across 0.5 GHz to 100 GHz.

pub type Pathloss3gppConfig = struct {
    carrier_freq_ghz: Float,
    bs_height_m: Float,
    ue_height_m: Float,
    environment_type: Int, // 1: UMi-Street Canyon, 2: UMa, 3: Indoor Office
};

pub fn pathloss_3gpp_config_new(freq_ghz: Float, bs_h: Float, ue_h: Float, env: Int) -> Pathloss3gppConfig {
    return Pathloss3gppConfig {
        carrier_freq_ghz: freq_ghz,
        bs_height_m: bs_h,
        ue_height_m: ue_h,
        environment_type: env,
    };
}

pub fn channel_3gpp_breakpoint_distance_m(bs_h: Float, ue_h: Float, freq_ghz: Float) -> Float {
    // d'_BP = 4 * (h_BS - 1) * (h_UT - 1) * f_c / c
    let h_bs_eff: Float = bs_h - 1.0;
    let h_ue_eff: Float = ue_h - 1.0;
    let c_speed: Float = 300000000.0;
    let fc_hz: Float = freq_ghz * 1000000000.0;

    let d_bp: Float = (4.0 * h_bs_eff * h_ue_eff * fc_hz) / c_speed;
    if d_bp < 10.0 {
        return 10.0;
    }
    return d_bp;
}

pub fn channel_pathloss_umi_los_db(dist_3d_m: Float, freq_ghz: Float, d_bp_m: Float) -> Float {
    let ln10: Float = 2.302585092994046;
    let log10_d: Float = ln(dist_3d_m) / ln10;
    let log10_fc: Float = ln(freq_ghz) / ln10;

    if dist_3d_m <= d_bp_m {
        // PL1 = 32.4 + 21 * log10(d3D) + 20 * log10(fc)
        return 32.4 + (21.0 * log10_d) + (20.0 * log10_fc);
    } else {
        // PL2 = 32.4 + 40 * log10(d3D) + 20 * log10(fc) - 9.5 * log10((d'_BP)^2 + (h_BS - h_UT)^2)
        let log10_dbp: Float = ln(d_bp_m) / ln10;
        return 32.4 + (40.0 * log10_d) + (20.0 * log10_fc) - (19.0 * log10_dbp);
    }
}
