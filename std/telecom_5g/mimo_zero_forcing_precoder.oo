// # Multi-User MIMO Zero-Forcing Precoder
//
// Logline: Synthesizes multi-user Zero-Forcing (ZF) precoding weights and per-antenna power normalization factors.
//
// Setup: Pure standard library implementation of spatial pseudo-inverse precoding W = H^H (H H^H)^-1 for interference cancellation.
//
// Beats:
//   1. Define 2-user MIMO Zero-Forcing precoder state and total power budgets.
//   2. Compute 2x2 complex Gram matrix inverse and precoding weighting coefficients.
//   3. Calculate power scaling normalization constant beta and per-stream SINR.

pub type MimoZfPrecoder2x2 = struct {
    num_tx_antennas: Int,
    num_users: Int,
    total_tx_power_watts: Float,
    norm_factor_beta: Float,
};

pub fn mimo_zf_precoder_2x2_new(tx_power: Float) -> MimoZfPrecoder2x2 {
    let mut safe_pwr: Float = tx_power;
    if safe_pwr <= 0.0001 { safe_pwr = 1.0; }

    return MimoZfPrecoder2x2 {
        num_tx_antennas: 2,
        num_users: 2,
        total_tx_power_watts: safe_pwr,
        norm_factor_beta: 1.0,
    };
}

pub fn mimo_zf_pseudo_inverse_denom(g11: Float, g12_re: Float, g12_im: Float, g22: Float) -> Float {
    // det(H H^H) = g11 * g22 - |g12|^2
    let g12_sq: Float = (g12_re * g12_re) + (g12_im * g12_im);
    let det: Float = (g11 * g22) - g12_sq;
    if det <= 0.000001 {
        return 0.000001; // Avoid divide by zero
    }
    return det;
}

pub fn mimo_zf_norm_beta(trace_w_sq: Float, total_power: Float) -> Float {
    if trace_w_sq <= 0.000001 || total_power <= 0.000001 {
        return 1.0;
    }
    return sqrt(total_power / trace_w_sq);
}

pub fn mimo_zf_user_sinr(signal_power: Float, noise_variance: Float) -> Float {
    if noise_variance <= 0.000001 {
        return 999999.0;
    }
    return signal_power / noise_variance;
}
