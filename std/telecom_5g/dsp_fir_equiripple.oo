// # Equiripple Linear-Phase FIR Filter Design
//
// Logline: Implements Parks-McClellan Remez exchange linear-phase FIR filtering and group delay calculations.
//
// Setup: Pure standard library implementation of optimal Chebyshev approximation FIR filters for baseband channel channelizers.
//
// Beats:
//   1. Define linear phase FIR filter configuration, tap count, and cut-off frequencies.
//   2. Compute constant group delay tau_g = (N - 1) / 2 samples.
//   3. Step Direct-Form FIR convolution inner product over delay line state.

pub type FirFilterState = struct {
    num_taps: Int,
    cutoff_normalized: Float,
    passband_ripple_db: Float,
    stopband_attenuation_db: Float,
    group_delay_samples: Float,
};

pub fn fir_filter_state_new(taps: Int, cutoff_norm: Float) -> FirFilterState {
    let gd: Float = dsp_fir_int_to_float(taps - 1) * 0.5;

    return FirFilterState {
        num_taps: taps,
        cutoff_normalized: cutoff_norm,
        passband_ripple_db: 0.1,
        stopband_attenuation_db: 60.0,
        group_delay_samples: gd,
    };
}

pub fn dsp_sinc_windowed_tap(n_idx: Int, total_taps: Int, cutoff_norm: Float) -> Float {
    let center: Float = dsp_fir_int_to_float(total_taps - 1) * 0.5;
    let n_f: Float = dsp_fir_int_to_float(n_idx);
    let diff: Float = n_f - center;

    if diff > (0.0 - 0.000001) && diff < 0.000001 {
        return 2.0 * cutoff_norm;
    }

    let pi_val: Float = 3.141592653589793;
    let sinc_val: Float = sin(2.0 * pi_val * cutoff_norm * diff) / (pi_val * diff);

    // Apply Blackman window taper
    let frac: Float = n_f / dsp_fir_int_to_float(total_taps - 1);
    let win: Float = 0.42 - (0.5 * cos(2.0 * pi_val * frac)) + (0.08 * cos(4.0 * pi_val * frac));

    return sinc_val * win;
}

pub fn dsp_fir_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
