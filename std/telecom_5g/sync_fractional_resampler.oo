// # Polyphase Farrow Fractional Resampler
//
// Logline: Implements 3rd-order polynomial Farrow structure for continuous sample rate conversion without buffer slips.
//
// Setup: Pure standard library implementation of polynomial interpolation and fractional timing delay synthesis.
//
// Beats:
//   1. Define Farrow fractional resampler state, rate conversion ratio, and phase accumulator.
//   2. Compute cubic Lagrange polynomial interpolation coefficients across 4 sample points.
//   3. Step fractional sample phase and generate resampled output samples.

pub type FarrowResamplerState = struct {
    resampling_ratio: Float, // fs_out / fs_in
    phase_accumulator: Float,
    prev_sample_0: Float,
    prev_sample_1: Float,
    prev_sample_2: Float,
    prev_sample_3: Float
};

pub fn farrow_resampler_state_new(rate_ratio: Float) -> FarrowResamplerState {
    let mut safe_ratio: Float = rate_ratio;
    if safe_ratio <= 0.0001 { safe_ratio = 1.0; }

    return FarrowResamplerState {
        resampling_ratio: safe_ratio,
        phase_accumulator: 0.0,
        prev_sample_0: 0.0,
        prev_sample_1: 0.0,
        prev_sample_2: 0.0,
        prev_sample_3: 0.0
    };
}

pub fn sync_farrow_cubic_interp(y0: Float, y1: Float, y2: Float, y3: Float, mu: Float) -> Float {
    // 4-point cubic polynomial:
    // v0 = y1
    // v1 = -1/3 y0 - 1/2 y1 + y2 - 1/6 y3
    // v2 = 1/2 y0 - y1 + 1/2 y2
    // v3 = -1/6 y0 + 1/2 y1 - 1/2 y2 + 1/6 y3
    // y(mu) = ((v3 * mu + v2) * mu + v1) * mu + v0
    let v0: Float = y1;
    let v1: Float = ((0.0 - 0.33333333) * y0) - (0.5 * y1) + y2 - (0.16666667 * y3);
    let v2: Float = (0.5 * y0) - y1 + (0.5 * y2);
    let v3: Float = ((0.0 - 0.16666667) * y0) + (0.5 * y1) - (0.5 * y2) + (0.16666667 * y3);

    return (((v3 * mu + v2) * mu + v1) * mu) + v0;
}

pub fn sync_farrow_advance_step(state: &mut FarrowResamplerState) -> Bool {
    let step_val: Float = 1.0 / (state).resampling_ratio;
    (state).phase_accumulator = (state).phase_accumulator + step_val;

    if (state).phase_accumulator >= 1.0 {
        (state).phase_accumulator = (state).phase_accumulator - 1.0;
        return true; // Shift input buffer
    }
    return false;
}
