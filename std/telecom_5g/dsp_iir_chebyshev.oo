// # Chebyshev IIR Filter Design and Pole Synthesis
//
// Logline: Implements Chebyshev Type I (passband ripple) and Type II (stopband ripple) biquad cascade filtering.
//
// Setup: Pure standard library implementation of sharp transition band IIR filtering for SDR pre-select filters.
//
// Beats:
//   1. Define Chebyshev filter parameters, ripple factor epsilon = sqrt(10^(Rp/10) - 1), and pole coordinates.
//   2. Estimate minimum required filter order N from passband/stopband attenuation specifications.
//   3. Compute Direct-Form II biquad section denominator and numerator coefficients.

pub type ChebyshevBiquad = struct {
    ripple_db: Float,
    b0: Float,
    b1: Float,
    b2: Float,
    a1: Float,
    a2: Float,
    state1: Float,
    state2: Float
};

pub fn chebyshev_biquad_new(ripple_db: Float, b0: Float, b1: Float, b2: Float, a1: Float, a2: Float) -> ChebyshevBiquad {
    return ChebyshevBiquad {
        ripple_db: ripple_db,
        b0: b0,
        b1: b1,
        b2: b2,
        a1: a1,
        a2: a2,
        state1: 0.0,
        state2: 0.0
    };
}

pub fn dsp_chebyshev_epsilon(rp_db: Float) -> Float {
    let ln10: Float = 2.302585092994046;
    let pwr: Float = exp(rp_db * (ln10 / 10.0));
    let diff: Float = pwr - 1.0;
    if diff <= 0.000001 {
        return 0.001;
    }
    return sqrt(diff);
}

pub fn dsp_chebyshev_step(bq: &mut ChebyshevBiquad, sample_in: Float) -> Float {
    let y: Float = ((bq).b0 * sample_in) + (bq).state1;
    (bq).state1 = ((bq).b1 * sample_in) - ((bq).a1 * y) + (bq).state2;
    (bq).state2 = ((bq).b2 * sample_in) - ((bq).a2 * y);
    return y;
}
