// # 3GPP TR 38.901 Tapped Delay Line Channel Profiles
//
// Logline: Implements standardized 5G NR TDL-A, TDL-B, and TDL-C tapped delay line profiles and delay scaling.
//
// Setup: Pure standard library implementation of 3GPP TS 38.901 multi-tap channel models for link-level simulations.
//
// Beats:
//   1. Define 3GPP TDL profile parameters, normalized delays, and tap relative powers.
//   2. Scale normalized delay profiles to target RMS delay spread (Very Short, Short, Normal, Long).
//   3. Convert logarithmic tap powers (dB) to normalized linear channel gains.

pub type TdlChannelProfile = struct {
    profile_type: Int, // 1: TDL-A (NLoS), 2: TDL-B (NLoS), 3: TDL-C (NLoS), 4: TDL-D (LoS), 5: TDL-E (LoS)
    desired_rms_delay_spread_ns: Float,
    num_taps: Int
};

pub fn tdl_channel_profile_new(ptype: Int, ds_ns: Float) -> TdlChannelProfile {
    let mut taps: Int = 23; // TDL-A has 23 taps
    if ptype == 2 { taps = 23; }
    if ptype == 3 { taps = 24; }
    if ptype == 4 { taps = 14; }
    if ptype == 5 { taps = 14; }

    return TdlChannelProfile {
        profile_type: ptype,
        desired_rms_delay_spread_ns: ds_ns,
        num_taps: taps
    };
}

pub fn channel_tdl_scaled_delay_ns(norm_delay: Float, target_ds_ns: Float) -> Float {
    return norm_delay * target_ds_ns;
}

pub fn channel_tdl_db_to_linear_power(power_db: Float) -> Float {
    let ln10: Float = 2.302585092994046;
    return exp(power_db * (ln10 / 10.0));
}

pub fn channel_tdl_tap0_power_db(ptype: Int) -> Float {
    if ptype == 1 { return 0.0 - 13.4; } // TDL-A tap 0
    if ptype == 2 { return 0.0 - 0.0; }  // TDL-B tap 0
    if ptype == 3 { return 0.0 - 4.4; }  // TDL-C tap 0
    return 0.0;
}
