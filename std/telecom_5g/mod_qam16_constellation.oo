// # 16-QAM Constellation Mapping and Max-Log LLR Demapping
//
// Logline: Implements 16-QAM Gray mapping, normalization 1/sqrt(10), and piecewise-linear Max-Log soft demapping.
//
// Setup: Pure standard library implementation of 16-QAM 4-bit symbol constellation points and soft decision boundaries.
//
// Beats:
//   1. Define 16-QAM constellation geometry and normalization scale 1/sqrt(10).
//   2. Map 4-bit nibbles (b0..b3) to Gray-coded PAM-4 I and Q coordinates.
//   3. Compute Max-Log approximate LLRs for outer and inner bit decision boundaries.

pub type Qam16Constellation = struct {
    norm_factor: Float,
    bits_per_symbol: Int,
    symbol_energy: Float
};

pub fn qam16_constellation_new() -> Qam16Constellation {
    return Qam16Constellation {
        norm_factor: 0.31622776601683794, // 1 / sqrt(10)
        bits_per_symbol: 4,
        symbol_energy: 1.0
    };
}

pub fn mod_qam16_pam4_map(bits2: Int) -> Float {
    // 3GPP Gray coding: 00 -> -3, 01 -> -1, 11 -> +1, 10 -> +3
    let b: Int = bits2 % 4;
    if b == 0 { return 0.0 - 3.0; }
    if b == 1 { return 0.0 - 1.0; }
    if b == 2 { return 3.0; }
    return 1.0; // b == 3
}

pub fn mod_qam16_maxlog_llr_msb(rx_coord: Float, norm: Float, noise_var: Float) -> Float {
    // MSB LLR (sign bit): piecewise linear max-log approx proportional to received coordinate
    if noise_var <= 0.000001 {
        return rx_coord * 1000.0;
    }
    let scaled: Float = rx_coord / norm;
    return (2.0 * scaled) / noise_var;
}

pub fn mod_qam16_maxlog_llr_lsb(rx_coord: Float, norm: Float, noise_var: Float) -> Float {
    // LSB LLR (magnitude bit): decision boundary around |x| = 2
    if noise_var <= 0.000001 {
        return 0.0;
    }
    let scaled: Float = rx_coord / norm;
    let mut abs_val: Float = scaled;
    if abs_val < 0.0 { abs_val = 0.0 - abs_val; }
    let diff: Float = 2.0 - abs_val;
    return (2.0 * diff) / noise_var;
}
