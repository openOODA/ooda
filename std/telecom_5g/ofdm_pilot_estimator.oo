// # OFDM Reference Pilot Channel Estimator
//
// Logline: Implements Least Squares (LS) pilot extraction, 2D time-frequency interpolation, and SNR estimation.
//
// Setup: Pure standard library implementation of DMRS, CSI-RS, and PTRS pilot processing for 5G NR OFDM.
//
// Beats:
//   1. Define pilot symbol configuration, spacing, and reference tone patterns.
//   2. Compute Least Squares channel frequency response at pilot locations.
//   3. Perform linear interpolation across subcarriers and estimate noise variance.

pub type OfdmPilotConfig = struct {
    subcarrier_spacing_tones: Int,
    symbol_index: Int,
    num_pilots_in_symbol: Int,
    noise_smoothing_alpha: Float
};

pub fn ofdm_pilot_config_dmrs_type1(sym: Int, num_pilots: Int) -> OfdmPilotConfig {
    return OfdmPilotConfig {
        subcarrier_spacing_tones: 2, // Type 1 DMRS has pilot every 2 subcarriers
        symbol_index: sym,
        num_pilots_in_symbol: num_pilots,
        noise_smoothing_alpha: 0.1
    };
}

pub fn ofdm_pilot_ls_re(rx_re: Float, rx_im: Float, tx_re: Float, tx_im: Float) -> Float {
    // H_LS = Y / X = (rx * conj(tx)) / |tx|^2
    let tx_mag_sq: Float = (tx_re * tx_re) + (tx_im * tx_im);
    if tx_mag_sq <= 0.000001 {
        return 0.0;
    }
    let num_re: Float = (rx_re * tx_re) + (rx_im * tx_im);
    return num_re / tx_mag_sq;
}

pub fn ofdm_pilot_ls_im(rx_re: Float, rx_im: Float, tx_re: Float, tx_im: Float) -> Float {
    let tx_mag_sq: Float = (tx_re * tx_re) + (tx_im * tx_im);
    if tx_mag_sq <= 0.000001 {
        return 0.0;
    }
    let num_im: Float = (rx_im * tx_re) - (rx_re * tx_im);
    return num_im / tx_mag_sq;
}

pub fn ofdm_pilot_linear_interp(h_left: Float, h_right: Float, step: Int, total_steps: Int) -> Float {
    if total_steps <= 0 {
        return h_left;
    }
    let frac: Float = ofdm_pilot_int_to_float(step) / ofdm_pilot_int_to_float(total_steps);
    return h_left + ((h_right - h_left) * frac);
}

pub fn ofdm_pilot_noise_variance_est(err_sq_sum: Float, pilot_count: Int) -> Float {
    if pilot_count <= 0 {
        return 0.001;
    }
    return err_sq_sum / ofdm_pilot_int_to_float(pilot_count);
}

pub fn ofdm_pilot_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
