// # Jakes Classical Doppler Fading Spectrum
//
// Logline: Simulates Jakes Doppler power spectrum via sum of sinusoids (SOS) and computes coherence time.
//
// Setup: Pure standard library implementation of mobile Doppler shift f_d = v*f_c/c and time-selective channel fading.
//
// Beats:
//   1. Define mobile Doppler configuration, vehicle velocity, and carrier frequency.
//   2. Compute maximum Doppler frequency shift f_d and channel coherence time T_c = 0.423 / f_d.
//   3. Synthesize correlated complex fading coefficients via multi-oscillator sum-of-sinusoids.

pub type JakesDopplerModel = struct {
    carrier_freq_hz: Float,
    vehicle_speed_mps: Float,
    max_doppler_hz: Float,
    coherence_time_ms: Float,
    num_oscillators: Int
};

pub fn jakes_doppler_model_new(carrier_hz: Float, speed_kmh: Float) -> JakesDopplerModel {
    let speed_mps: Float = speed_kmh / 3.6;
    let speed_of_light: Float = 299792458.0;

    // f_d = v * f_c / c
    let fd: Float = (speed_mps * carrier_hz) / speed_of_light;
    let mut safe_fd: Float = fd;
    if safe_fd <= 0.001 { safe_fd = 0.001; }

    // T_c = 0.423 / f_d (seconds) -> * 1000 for ms
    let tc_ms: Float = (0.423 / safe_fd) * 1000.0;

    return JakesDopplerModel {
        carrier_freq_hz: carrier_hz,
        vehicle_speed_mps: speed_mps,
        max_doppler_hz: safe_fd,
        coherence_time_ms: tc_ms,
        num_oscillators: 8
    };
}

pub fn channel_jakes_oscillator_phase(osc_idx: Int, total_osc: Int, fd_hz: Float, time_sec: Float) -> Float {
    let pi_val: Float = 3.141592653589793;
    let two_pi: Float = 2.0 * pi_val;

    // Spatial arrival angle alpha_n = 2*pi*n / N
    let alpha_n: Float = (two_pi * channel_doppler_int_to_float(osc_idx)) / channel_doppler_int_to_float(total_osc);
    let freq_n: Float = fd_hz * cos(alpha_n);

    return two_pi * freq_n * time_sec;
}

pub fn channel_doppler_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
