// # 64-QAM Constellation Mapping and PAM-8 Demapping
//
// Logline: Implements 64-QAM Gray mapping, normalization 1/sqrt(42), and PAM-8 multi-threshold soft demapping.
//
// Setup: Pure standard library implementation of 64-QAM 6-bit symbol mapping and decision regions (+-1, +-3, +-5, +-7).
//
// Beats:
//   1. Define 64-QAM constellation geometry and normalization scale 1/sqrt(42).
//   2. Map 3-bit triplets to Gray-coded PAM-8 constellation levels.
//   3. Compute multi-level piecewise Max-Log approximate LLRs for all 3 bits per axis.

pub type Qam64Constellation = struct {
    norm_factor: Float,
    bits_per_symbol: Int,
    symbol_energy: Float
};

pub fn qam64_constellation_new() -> Qam64Constellation {
    return Qam64Constellation {
        norm_factor: 0.1543033499620919, // 1 / sqrt(42)
        bits_per_symbol: 6,
        symbol_energy: 1.0
    };
}

pub fn mod_qam64_pam8_map(bits3: Int) -> Float {
    // Gray mapping for 8-PAM:
    // 000 -> -7, 001 -> -5, 011 -> -3, 010 -> -1
    // 110 -> +1, 111 -> +3, 101 -> +5, 100 -> +7
    let b: Int = bits3 % 8;
    if b == 0 { return 0.0 - 7.0; }
    if b == 1 { return 0.0 - 5.0; }
    if b == 3 { return 0.0 - 3.0; }
    if b == 2 { return 0.0 - 1.0; }
    if b == 6 { return 1.0; }
    if b == 7 { return 3.0; }
    if b == 5 { return 5.0; }
    return 7.0; // b == 4
}

pub fn mod_qam64_pam8_demap_slice(val: Float) -> Int {
    if val < (0.0 - 6.0) { return 0; }
    if val < (0.0 - 4.0) { return 1; }
    if val < (0.0 - 2.0) { return 3; }
    if val < 0.0 { return 2; }
    if val < 2.0 { return 6; }
    if val < 4.0 { return 7; }
    if val < 6.0 { return 5; }
    return 4;
}

pub fn mod_qam64_approx_llr_b0(scaled_val: Float, noise_var: Float) -> Float {
    // MSB (sign): LLR ~ scaled_val
    if noise_var <= 0.000001 { return scaled_val * 1000.0; }
    return (2.0 * scaled_val) / noise_var;
}

pub fn mod_qam64_approx_llr_b1(scaled_val: Float, noise_var: Float) -> Float {
    // Middle bit: threshold at |val| = 4
    if noise_var <= 0.000001 { return 0.0; }
    let mut abs_v: Float = scaled_val;
    if abs_v < 0.0 { abs_v = 0.0 - abs_v; }
    return (2.0 * (4.0 - abs_v)) / noise_var;
}
