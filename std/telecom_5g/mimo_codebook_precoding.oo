// # 3GPP 5G NR Type-I Codebook Precoding
//
// Logline: Implements 3GPP TS 38.214 Type-I Single-Panel spatial codebook beam indices and co-phasing selection.
//
// Setup: Pure standard library implementation of DFT beam grid indices, Rank Indicator (RI), and PMI calculation.
//
// Beats:
//   1. Define 3GPP Type-I single-panel codebook configuration and oversampling factors.
//   2. Compute 2D DFT spatial beam steering angles and co-phasing values.
//   3. Map Precoding Matrix Indicator (PMI) indices i1_1, i1_2, and i2 to precoding weights.

pub type Nr5gCodebookType1 = struct {
    num_tx_antennas: Int,
    rank_indicator_ri: Int,
    oversampling_o1: Int,
    oversampling_o2: Int,
    pmi_i1_1: Int,
    pmi_i1_2: Int,
    pmi_i2: Int
};

pub fn nr5g_codebook_type1_new(n_tx: Int, ri: Int) -> Nr5gCodebookType1 {
    let mut safe_ri: Int = ri;
    if safe_ri < 1 { safe_ri = 1; }
    if safe_ri > 4 { safe_ri = 4; }

    return Nr5gCodebookType1 {
        num_tx_antennas: n_tx,
        rank_indicator_ri: safe_ri,
        oversampling_o1: 4,
        oversampling_o2: 1,
        pmi_i1_1: 0,
        pmi_i1_2: 0,
        pmi_i2: 0
    };
}

pub fn nr5g_codebook_cophasing_phase_rad(i2_idx: Int) -> Float {
    let pi_val: Float = 3.141592653589793;
    let idx: Int = i2_idx % 4;
    // phi_n = exp(j * pi * n / 2) -> 0, pi/2, pi, 3*pi/2
    let frac: Float = nr5g_codebook_int_to_float(idx) * 0.5;
    return frac * pi_val;
}

pub fn nr5g_codebook_dft_beam_angle_rad(i1_idx: Int, n_ant: Int, oversampling_o: Int) -> Float {
    let total_beams: Int = n_ant * oversampling_o;
    if total_beams <= 0 {
        return 0.0;
    }
    let pi_val: Float = 3.141592653589793;
    let two_pi: Float = 2.0 * pi_val;
    let frac: Float = nr5g_codebook_int_to_float(i1_idx % total_beams) / nr5g_codebook_int_to_float(total_beams);
    return two_pi * frac;
}

pub fn nr5g_codebook_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
