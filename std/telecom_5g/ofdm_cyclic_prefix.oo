// # 5G NR OFDM Cyclic Prefix and Windowing
//
// Logline: Computes normal and extended cyclic prefix sample durations, overhead ratios, and raised cosine windowing.
//
// Setup: Pure standard library implementation of 5G NR OFDM time-domain guard intervals and spectral emission shaping.
//
// Beats:
//   1. Define OFDM cyclic prefix configuration and numerology parameters.
//   2. Compute symbol-dependent CP length (Symbol 0 vs remaining symbols).
//   3. Evaluate raised cosine boundary windowing taper weights.

pub type OfdmCpConfig = struct {
    numerology_mu: Int,
    fft_size: Int,
    is_extended_cp: Bool,
    window_length_samples: Int
};

pub fn ofdm_cp_config_new(mu: Int, fft_size: Int, extended: Bool) -> OfdmCpConfig {
    let mut win_len: Int = fft_size / 64;
    if win_len < 4 { win_len = 4; }

    return OfdmCpConfig {
        numerology_mu: mu,
        fft_size: fft_size,
        is_extended_cp: extended,
        window_length_samples: win_len
    };
}

pub fn ofdm_cp_length_samples(cfg: &OfdmCpConfig, symbol_idx: Int) -> Int {
    let n_fft: Int = (cfg).fft_size;

    if (cfg).is_extended_cp {
        // Extended CP is 512 samples per 2048 FFT (mu = 2 only in 5G NR)
        return (n_fft * 512) / 2048;
    }

    // Normal CP: Symbol 0 and Symbol (7 * 2^mu) are longer (160 samples per 2048 FFT).
    // Other symbols have 144 samples per 2048 FFT.
    let symbols_per_half_subframe: Int = 7;
    let is_first_symbol: Bool = (symbol_idx % symbols_per_half_subframe) == 0;

    if is_first_symbol {
        return (n_fft * 160) / 2048;
    }
    return (n_fft * 144) / 2048;
}

pub fn ofdm_total_symbol_samples(cfg: &OfdmCpConfig, symbol_idx: Int) -> Int {
    let cp_len: Int = ofdm_cp_length_samples(cfg, symbol_idx);
    return (cfg).fft_size + cp_len;
}

pub fn ofdm_cp_overhead_ratio(cfg: &OfdmCpConfig, symbol_idx: Int) -> Float {
    let cp_len: Float = ofdm_cp_int_to_float(ofdm_cp_length_samples(cfg, symbol_idx));
    let total_len: Float = ofdm_cp_int_to_float(ofdm_total_symbol_samples(cfg, symbol_idx));
    if total_len <= 0.0001 {
        return 0.0;
    }
    return cp_len / total_len;
}

pub fn ofdm_raised_cosine_window(n: Int, win_len: Int) -> Float {
    if n < 0 || win_len <= 0 {
        return 0.0;
    }
    if n >= win_len {
        return 1.0;
    }
    let pi_val: Float = 3.141592653589793;
    let frac: Float = ofdm_cp_int_to_float(n) / ofdm_cp_int_to_float(win_len);
    // 0.5 * (1 - cos(pi * n / N_w))
    return 0.5 * (1.0 - cos(pi_val * frac));
}

pub fn ofdm_cp_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
