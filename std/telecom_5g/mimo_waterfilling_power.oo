// # MIMO Water-Filling Power Allocation
//
// Logline: Calculates optimal capacity-maximizing power distribution across MIMO spatial eigenmodes.
//
// Setup: Pure standard library implementation of water-filling power algorithm subject to total transmit power constraints.
//
// Beats:
//   1. Define 2-channel water-filling state and subchannel noise-to-gain ratios.
//   2. Compute water level mu and individual subchannel allocated powers P1 and P2.
//   3. Evaluate achievable Shannon sum-rate under water-filling vs uniform power allocation.

pub type MimoWaterfilling2x2 = struct {
    total_power_p: Float,
    water_level_mu: Float,
    power_subchannel_1: Float,
    power_subchannel_2: Float,
    active_subchannels: Int
};

pub fn mimo_waterfilling_2x2_solve(p_total: Float, noise_gain_1: Float, noise_gain_2: Float) -> MimoWaterfilling2x2 {
    // noise_gain_i = N0 / |sigma_i|^2. Assume channel 1 is better (noise_gain_1 <= noise_gain_2).
    let mut ng1: Float = noise_gain_1;
    let mut ng2: Float = noise_gain_2;
    if ng2 < ng1 {
        let tmp: Float = ng1;
        ng1 = ng2;
        ng2 = tmp;
    }

    // Try allocating power to both channels:
    // P1 + P2 = (mu - ng1) + (mu - ng2) = 2*mu - (ng1 + ng2) = P_total
    // -> mu = (P_total + ng1 + ng2) / 2
    let mu_two_channel: Float = (p_total + ng1 + ng2) * 0.5;

    if mu_two_channel > ng2 {
        // Both channels active
        let p1: Float = mu_two_channel - ng1;
        let p2: Float = mu_two_channel - ng2;
        return MimoWaterfilling2x2 {
            total_power_p: p_total,
            water_level_mu: mu_two_channel,
            power_subchannel_1: p1,
            power_subchannel_2: p2,
            active_subchannels: 2
        };
    } else {
        // Channel 2 is too weak: allocate all power to channel 1
        let mu_single: Float = p_total + ng1;
        return MimoWaterfilling2x2 {
            total_power_p: p_total,
            water_level_mu: mu_single,
            power_subchannel_1: p_total,
            power_subchannel_2: 0.0,
            active_subchannels: 1
        };
    }
}

pub fn mimo_waterfilling_capacity_bps_hz(wf: &MimoWaterfilling2x2, ng1: Float, ng2: Float) -> Float {
    let ln2: Float = 0.6931471805599453;
    let mut cap: Float = 0.0;

    if (wf).power_subchannel_1 > 0.0 && ng1 > 0.000001 {
        let snr1: Float = (wf).power_subchannel_1 / ng1;
        cap = cap + (ln(1.0 + snr1) / ln2);
    }
    if (wf).power_subchannel_2 > 0.0 && ng2 > 0.000001 {
        let snr2: Float = (wf).power_subchannel_2 / ng2;
        cap = cap + (ln(1.0 + snr2) / ln2);
    }

    return cap;
}
