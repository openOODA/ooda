// # Discrete Hilbert Transform and Analytic Signal Generation
//
// Logline: Generates discrete Hilbert transform FIR taps and creates analytic complex baseband signals z(t) = x(t) + j*H{x(t)}.
//
// Setup: Pure standard library implementation of 90-degree phase shifting for Single Sideband (SSB) modulation and envelope extraction.
//
// Beats:
//   1. Define Hilbert FIR filter parameters, odd-symmetric tap structure, and filter delay.
//   2. Compute ideal Hilbert impulse response h[n] = 2 / (pi * n) for odd n with windowing.
//   3. Extract instantaneous amplitude envelope and instantaneous phase from analytic signal.

pub type HilbertTransformFilter = struct {
    num_taps: Int,
    delay_samples: Int,
};

pub fn hilbert_transform_filter_new(taps: Int) -> HilbertTransformFilter {
    let mut safe_taps: Int = taps;
    if (safe_taps % 2) == 0 {
        safe_taps = safe_taps + 1; // Must be odd length for linear phase Type III
    }
    let del: Int = (safe_taps - 1) / 2;

    return HilbertTransformFilter {
        num_taps: safe_taps,
        delay_samples: del,
    };
}

pub fn dsp_hilbert_tap_coeff(n_idx: Int, total_taps: Int) -> Float {
    let mid: Int = (total_taps - 1) / 2;
    let k: Int = n_idx - mid;

    // For even k (including k=0), h[k] = 0
    if (k % 2) == 0 {
        return 0.0;
    }

    let pi_val: Float = 3.141592653589793;
    let k_f: Float = dsp_hilbert_int_to_float(k);
    let raw_h: Float = 2.0 / (pi_val * k_f);

    // Apply Hamming window
    let frac: Float = dsp_hilbert_int_to_float(n_idx) / dsp_hilbert_int_to_float(total_taps - 1);
    let win: Float = 0.54 - (0.46 * cos(2.0 * pi_val * frac));

    return raw_h * win;
}

pub fn dsp_analytic_envelope(real_val: Float, imag_hilbert: Float) -> Float {
    return sqrt((real_val * real_val) + (imag_hilbert * imag_hilbert));
}

pub fn dsp_hilbert_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
