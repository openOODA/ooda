// # Root-Raised-Cosine (RRC) Pulse Shaping Filter
//
// Logline: Generates Nyquist matched filter impulse responses minimizing inter-symbol interference (ISI).
//
// Setup: Pure standard library implementation of Root-Raised-Cosine (RRC) analytical filter tap calculations.
//
// Beats:
//   1. Define RRC filter parameters, roll-off factor alpha (0..1), and span in symbols.
//   2. Compute closed-form tap coefficients for t=0, singular points t = +- Ts/(4*alpha), and general t.
//   3. Normalize total filter impulse energy to unity for transmitter and receiver matched filtering.

pub type RrcFilterConfig = struct {
    roll_off_alpha: Float,
    samples_per_symbol: Int,
    filter_span_symbols: Int,
    total_taps: Int,
};

pub fn rrc_filter_config_new(alpha: Float, sps: Int, span: Int) -> RrcFilterConfig {
    let mut safe_alpha: Float = alpha;
    if safe_alpha < 0.001 { safe_alpha = 0.001; }
    if safe_alpha > 1.0 { safe_alpha = 1.0; }

    let taps: Int = (span * sps) + 1;

    return RrcFilterConfig {
        roll_off_alpha: safe_alpha,
        samples_per_symbol: sps,
        filter_span_symbols: span,
        total_taps: taps,
    };
}

pub fn sync_rrc_tap_coeff(t_norm: Float, alpha: Float) -> Float {
    // t_norm = t / T_s
    let pi_val: Float = 3.141592653589793;

    // Special case 1: t = 0
    if t_norm > (0.0 - 0.000001) && t_norm < 0.000001 {
        // h(0) = 1 - alpha + 4*alpha/pi
        return 1.0 - alpha + ((4.0 * alpha) / pi_val);
    }

    // Special case 2: t = +- 1 / (4 * alpha)
    let sing_point: Float = 1.0 / (4.0 * alpha);
    let mut diff_pos: Float = t_norm - sing_point;
    if diff_pos < 0.0 { diff_pos = 0.0 - diff_pos; }
    let mut diff_neg: Float = t_norm + sing_point;
    if diff_neg < 0.0 { diff_neg = 0.0 - diff_neg; }

    if diff_pos < 0.00001 || diff_neg < 0.00001 {
        let term1: Float = alpha / sqrt(2.0);
        let term2: Float = (1.0 + (2.0 / pi_val)) * sin(pi_val / (4.0 * alpha));
        let term3: Float = (1.0 - (2.0 / pi_val)) * cos(pi_val / (4.0 * alpha));
        return term1 * (term2 + term3);
    }

    // General case
    let num_term1: Float = sin(pi_val * t_norm * (1.0 - alpha));
    let num_term2: Float = 4.0 * alpha * t_norm * cos(pi_val * t_norm * (1.0 + alpha));
    let den: Float = pi_val * t_norm * (1.0 - (16.0 * alpha * alpha * t_norm * t_norm));

    if den > (0.0 - 0.000001) && den < 0.000001 {
        return 1.0;
    }

    return (num_term1 + num_term2) / den;
}
