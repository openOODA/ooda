// # MIMO Shannon Channel Capacity Analysis
//
// Logline: Evaluates theoretical SISO, SIMO, MISO, and MIMO ergodic and outage capacity boundaries.
//
// Setup: Pure standard library implementation of multi-antenna information theoretic bounds and diversity gains.
//
// Beats:
//   1. Define Shannon capacity evaluation parameters and bandwidth constraints.
//   2. Compute Maximal Ratio Combining (MRC) and Maximum Ratio Transmission (MRT) SNR gains.
//   3. Calculate ergodic capacity in bits/s/Hz for multi-layer spatial multiplexing channels.

pub type MimoCapacityMetrics = struct {
    bandwidth_hz: Float,
    snr_linear: Float,
    num_tx_antennas: Int,
    num_rx_antennas: Int,
    achievable_capacity_mbps: Float,
};

pub fn mimo_capacity_metrics_new(bw_hz: Float, snr_lin: Float, n_tx: Int, n_rx: Int) -> MimoCapacityMetrics {
    return MimoCapacityMetrics {
        bandwidth_hz: bw_hz,
        snr_linear: snr_lin,
        num_tx_antennas: n_tx,
        num_rx_antennas: n_rx,
        achievable_capacity_mbps: 0.0,
    };
}

pub fn mimo_shannon_siso_bps_hz(snr_linear: Float) -> Float {
    if snr_linear <= 0.0 {
        return 0.0;
    }
    let ln2: Float = 0.6931471805599453;
    return ln(1.0 + snr_linear) / ln2;
}

pub fn mimo_mrc_simo_gain_linear(num_rx_branches: Int) -> Float {
    return mimo_cap_int_to_float(num_rx_branches);
}

pub fn mimo_ergodic_capacity_mbps(bw_hz: Float, layers: Int, avg_sinr: Float) -> Float {
    let siso_eff: Float = mimo_shannon_siso_bps_hz(avg_sinr);
    let total_bps: Float = bw_hz * mimo_cap_int_to_float(layers) * siso_eff;
    return total_bps / 1000000.0; // Megabits per second
}

pub fn mimo_cap_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
