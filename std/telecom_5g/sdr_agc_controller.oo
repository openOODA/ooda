// # Dual-Loop Automatic Gain Controller (AGC)
//
// Logline: Implements dual-rate fast attack and slow decay Automatic Gain Control for SDR receiver dynamic range.
//
// Setup: Pure standard library implementation of closed-loop baseband power normalization and saturation prevention.
//
// Beats:
//   1. Define AGC state, target power setpoint (-12 dBFS), and gain limits (0 dB to 60 dB).
//   2. Compute instantaneous RMS sample power and logarithmic power error.
//   3. Step dual-speed exponential gain update filter (fast attack on bursts, slow decay on quiet gaps).

pub type SdrAgcController = struct {
    target_power_db: Float,
    current_gain_db: Float,
    min_gain_db: Float,
    max_gain_db: Float,
    attack_alpha: Float, // Fast response to prevent ADC clipping
    decay_alpha: Float  // Slow release to avoid noise pumping
};

pub fn sdr_agc_controller_new(target_db: Float) -> SdrAgcController {
    return SdrAgcController {
        target_power_db: target_db,
        current_gain_db: 20.0,
        min_gain_db: 0.0,
        max_gain_db: 60.0,
        attack_alpha: 0.1,
        decay_alpha: 0.001
    };
}

pub fn sdr_agc_sample_power_db(i_sample: Float, q_sample: Float) -> Float {
    let pwr_lin: Float = (i_sample * i_sample) + (q_sample * q_sample);
    if pwr_lin <= 0.0000001 {
        return 0.0 - 70.0;
    }
    let ln10: Float = 2.302585092994046;
    return 10.0 * (ln(pwr_lin) / ln10);
}

pub fn sdr_agc_update_step(agc: &mut SdrAgcController, measured_pwr_db: Float) -> Float {
    let err_db: Float = (agc).target_power_db - measured_pwr_db;

    let mut alpha: Float = (agc).decay_alpha;
    if err_db < 0.0 {
        alpha = (agc).attack_alpha; // Input signal is too strong -> reduce gain quickly
    }

    (agc).current_gain_db = (agc).current_gain_db + (alpha * err_db);

    if (agc).current_gain_db < (agc).min_gain_db {
        (agc).current_gain_db = (agc).min_gain_db;
    }
    if (agc).current_gain_db > (agc).max_gain_db {
        (agc).current_gain_db = (agc).max_gain_db;
    }

    return (agc).current_gain_db;
}
