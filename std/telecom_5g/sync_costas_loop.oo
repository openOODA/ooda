// # Costas Carrier Phase and Frequency Tracking Loop
//
// Logline: Implements 2nd-order Costas loop phase error detection, proportional-integral filter, and NCO phase correction.
//
// Setup: Pure standard library implementation of suppressed carrier recovery for BPSK, QPSK, and QAM baseband SDR streams.
//
// Beats:
//   1. Define Costas loop parameters, PI loop gains (Kp, Ki), and NCO state.
//   2. Compute Phase Error Detector (PED) metrics e = sign(I)*Q - sign(Q)*I for QPSK.
//   3. Step loop filter integrator and update carrier phase rotator angle.

pub type CostasLoopState = struct {
    kp_gain: Float,
    ki_gain: Float,
    integrator: Float,
    nco_phase_rad: Float,
    frequency_offset_hz: Float,
    is_locked: Bool,
};

pub fn costas_loop_state_new(loop_bw_hz: Float, damping: Float, sample_rate_hz: Float) -> CostasLoopState {
    let pi_val: Float = 3.141592653589793;
    let theta: Float = (loop_bw_hz / sample_rate_hz) * (2.0 * pi_val);
    let d: Float = 1.0 + (2.0 * damping * theta) + (theta * theta);
    let kp: Float = (4.0 * damping * theta) / d;
    let ki: Float = (4.0 * theta * theta) / d;

    return CostasLoopState {
        kp_gain: kp,
        ki_gain: ki,
        integrator: 0.0,
        nco_phase_rad: 0.0,
        frequency_offset_hz: 0.0,
        is_locked: false,
    };
}

pub fn sync_costas_ped_qpsk(i_val: Float, q_val: Float) -> Float {
    // e = sign(I) * Q - sign(Q) * I
    let mut sign_i: Float = 1.0;
    let mut sign_q: Float = 1.0;
    if i_val < 0.0 { sign_i = 0.0 - 1.0; }
    if q_val < 0.0 { sign_q = 0.0 - 1.0; }
    return (sign_i * q_val) - (sign_q * i_val);
}

pub fn sync_costas_step(state: &mut CostasLoopState, error: Float) -> Float {
    (state).integrator = (state).integrator + ((state).ki_gain * error);
    let control_signal: Float = ((state).kp_gain * error) + (state).integrator;

    let pi_val: Float = 3.141592653589793;
    let two_pi: Float = 2.0 * pi_val;

    (state).nco_phase_rad = (state).nco_phase_rad + control_signal;
    while (state).nco_phase_rad > pi_val {
        (state).nco_phase_rad = (state).nco_phase_rad - two_pi;
    }
    while (state).nco_phase_rad < (0.0 - pi_val) {
        (state).nco_phase_rad = (state).nco_phase_rad + two_pi;
    }

    return (state).nco_phase_rad;
}
