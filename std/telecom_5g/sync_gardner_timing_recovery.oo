// # Gardner Symbol Timing Recovery Detector
//
// Logline: Implements non-data-aided Gardner timing error detection (TED) and fractional symbol clock tracking.
//
// Setup: Pure standard library implementation of baud timing synchronizer requiring only 2 samples per symbol without carrier lock.
//
// Beats:
//   1. Define Gardner TED loop filter parameters and sample interpolation state.
//   2. Compute timing error metric e(k) = I(mid) * [I(curr) - I(prev)] + Q(mid) * [Q(curr) - Q(prev)].
//   3. Evaluate fractional sampling offset mu and strobe decision triggers.

pub type GardnerTedState = struct {
    kp_gain: Float,
    ki_gain: Float,
    integrator: Float,
    timing_error: Float,
    fractional_offset_mu: Float,
    strobe_ready: Bool
};

pub fn gardner_ted_state_new(loop_bw: Float, damping: Float) -> GardnerTedState {
    let kp: Float = 2.0 * damping * loop_bw;
    let ki: Float = loop_bw * loop_bw;

    return GardnerTedState {
        kp_gain: kp,
        ki_gain: ki,
        integrator: 0.0,
        timing_error: 0.0,
        fractional_offset_mu: 0.0,
        strobe_ready: false
    };
}

pub fn sync_gardner_ted_error(
    i_curr: Float, i_mid: Float, i_prev: Float,
    q_curr: Float, q_mid: Float, q_prev: Float,
) -> Float {
    // e(k) = I(k - 1/2) * (I(k) - I(k-1)) + Q(k - 1/2) * (Q(k) - Q(k-1))
    let i_term: Float = i_mid * (i_curr - i_prev);
    let q_term: Float = q_mid * (q_curr - q_prev);
    return i_term + q_term;
}

pub fn sync_gardner_step_loop(state: &mut GardnerTedState, error: Float) -> Float {
    (state).timing_error = error;
    (state).integrator = (state).integrator + ((state).ki_gain * error);
    let delta_mu: Float = ((state).kp_gain * error) + (state).integrator;

    (state).fractional_offset_mu = (state).fractional_offset_mu + delta_mu;
    if (state).fractional_offset_mu >= 1.0 {
        (state).fractional_offset_mu = (state).fractional_offset_mu - 1.0;
        (state).strobe_ready = true;
    } else {
        (state).strobe_ready = false;
    }

    return (state).fractional_offset_mu;
}
