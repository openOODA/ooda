// # Butterworth IIR Filter and Bilinear Transform
//
// Logline: Implements maximally flat Butterworth analog pole synthesis and Bilinear Transform biquad discretisation.
//
// Setup: Pure standard library implementation of Butterworth 2nd-order section (SOS) digital IIR filtering.
//
// Beats:
//   1. Define Butterworth biquad filter coefficients (b0, b1, b2, a1, a2) and delay registers.
//   2. Pre-warp cutoff frequency Omega = 2 * fs * tan(pi * fc / fs) for Bilinear mapping.
//   3. Step Direct-Form II transposed biquad difference equation for low-pass and high-pass filters.

pub type ButterworthBiquad = struct {
    b0: Float,
    b1: Float,
    b2: Float,
    a1: Float,
    a2: Float,
    w1: Float,
    w2: Float,
};

pub fn butterworth_lowpass_biquad_new(fc_hz: Float, fs_hz: Float, q_factor: Float) -> ButterworthBiquad {
    let pi_val: Float = 3.141592653589793;
    let omega: Float = (2.0 * pi_val * fc_hz) / fs_hz;
    let sn: Float = sin(omega);
    let cs: Float = cos(omega);
    let alpha: Float = sn / (2.0 * q_factor);

    let a0: Float = 1.0 + alpha;
    let b0: Float = ((1.0 - cs) * 0.5) / a0;
    let b1: Float = (1.0 - cs) / a0;
    let b2: Float = ((1.0 - cs) * 0.5) / a0;
    let a1: Float = ((0.0 - 2.0) * cs) / a0;
    let a2: Float = (1.0 - alpha) / a0;

    return ButterworthBiquad {
        b0: b0,
        b1: b1,
        b2: b2,
        a1: a1,
        a2: a2,
        w1: 0.0,
        w2: 0.0,
    };
}

pub fn dsp_butterworth_step(bq: &mut ButterworthBiquad, x_in: Float) -> Float {
    // Direct Form II Transposed:
    // y[n] = b0 * x[n] + w1
    // w1 = b1 * x[n] - a1 * y[n] + w2
    // w2 = b2 * x[n] - a2 * y[n]
    let y: Float = ((bq).b0 * x_in) + (bq).w1;
    (bq).w1 = ((bq).b1 * x_in) - ((bq).a1 * y) + (bq).w2;
    (bq).w2 = ((bq).b2 * x_in) - ((bq).a2 * y);
    return y;
}
