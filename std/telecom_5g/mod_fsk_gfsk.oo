// # Continuous Phase FSK and GFSK Baseband Modulator
//
// Logline: Implements Gaussian FSK (GFSK) pulse shaping, modulation index h, and continuous phase accumulation.
//
// Setup: Pure standard library implementation of constant envelope GFSK modulation for SDR telemetry and Bluetooth LE.
//
// Beats:
//   1. Define GFSK modulation parameters, BT product, and modulation index h=0.5.
//   2. Compute frequency deviation and instantaneous phase trajectory steps.
//   3. Demodulate received I/Q samples via delay-and-multiply frequency discriminator.

pub type GfskModulator = struct {
    bit_rate_bps: Float,
    modulation_index_h: Float,
    samples_per_symbol: Int,
    current_phase_rad: Float
};

pub fn gfsk_modulator_new(bit_rate: Float, h_mod: Float, sps: Int) -> GfskModulator {
    return GfskModulator {
        bit_rate_bps: bit_rate,
        modulation_index_h: h_mod,
        samples_per_symbol: sps,
        current_phase_rad: 0.0
    };
}

pub fn mod_gfsk_freq_deviation_hz(bit_rate: Float, h_mod: Float) -> Float {
    // Delta_f = (h * R_b) / 2
    return (h_mod * bit_rate) * 0.5;
}

pub fn mod_gfsk_phase_increment_rad(bit_val: Int, h_mod: Float, sps: Int) -> Float {
    let pi_val: Float = 3.141592653589793;
    let mut sign: Float = 1.0;
    if bit_val == 0 {
        sign = 0.0 - 1.0; // NRZ bit 0 maps to -1
    }
    let sps_f: Float = mod_fsk_int_to_float(sps);
    if sps_f <= 0.0001 { return 0.0; }
    // Delta_theta = (pi * h * bit) / SPS
    return (pi_val * h_mod * sign) / sps_f;
}

pub fn mod_gfsk_step_phase(mod_state: &mut GfskModulator, bit_val: Int) -> Float {
    let delta_th: Float = mod_gfsk_phase_increment_rad(bit_val, (mod_state).modulation_index_h, (mod_state).samples_per_symbol);
    let pi_val: Float = 3.141592653589793;
    let two_pi: Float = 2.0 * pi_val;

    (mod_state).current_phase_rad = ((mod_state).current_phase_rad + delta_th);
    while (mod_state).current_phase_rad > pi_val {
        (mod_state).current_phase_rad = (mod_state).current_phase_rad - two_pi;
    }
    while (mod_state).current_phase_rad < (0.0 - pi_val) {
        (mod_state).current_phase_rad = (mod_state).current_phase_rad + two_pi;
    }
    return (mod_state).current_phase_rad;
}

pub fn mod_fsk_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
