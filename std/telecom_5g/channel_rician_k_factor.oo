// # Rician K-Factor Channel Fading Model
//
// Logline: Implements Rician fading power partitioning between Line-of-Sight specular and diffuse scattered components.
//
// Setup: Pure standard library implementation of K-factor parameterized wireless fading channels for microcellular and NTN.
//
// Beats:
//   1. Define Rician channel configuration, K-factor (dB and linear), and total average power.
//   2. Compute specular direct-path fraction P_los = K / (K + 1) and diffuse fraction P_diff = 1 / (K + 1).
//   3. Evaluate envelope Rice distribution moments and probability of fade outage.

pub type RicianChannelConfig = struct {
    k_factor_db: Float,
    k_factor_linear: Float,
    specular_power_fraction: Float,
    diffuse_power_fraction: Float,
};

pub fn rician_channel_config_new(k_db: Float) -> RicianChannelConfig {
    let ln10: Float = 2.302585092994046;
    let k_lin: Float = exp(k_db * (ln10 / 10.0));
    let p_los: Float = k_lin / (k_lin + 1.0);
    let p_diff: Float = 1.0 / (k_lin + 1.0);

    return RicianChannelConfig {
        k_factor_db: k_db,
        k_factor_linear: k_lin,
        specular_power_fraction: p_los,
        diffuse_power_fraction: p_diff,
    };
}

pub fn channel_rician_sample_re(cfg: &RicianChannelConfig, rand_gauss_re: Float, los_phase: Float) -> Float {
    let s_amp: Float = sqrt((cfg).specular_power_fraction);
    let d_amp: Float = sqrt((cfg).diffuse_power_fraction * 0.5);

    let los_component: Float = s_amp * cos(los_phase);
    let diffuse_component: Float = d_amp * rand_gauss_re;

    return los_component + diffuse_component;
}

pub fn channel_rician_sample_im(cfg: &RicianChannelConfig, rand_gauss_im: Float, los_phase: Float) -> Float {
    let s_amp: Float = sqrt((cfg).specular_power_fraction);
    let d_amp: Float = sqrt((cfg).diffuse_power_fraction * 0.5);

    let los_component: Float = s_amp * sin(los_phase);
    let diffuse_component: Float = d_amp * rand_gauss_im;

    return los_component + diffuse_component;
}
