// # MIMO MMSE Spatial Receiver Equalizer
//
// Logline: Implements Minimum Mean Square Error spatial filter W = (H^H H + sigma^2 I)^-1 H^H for MIMO stream recovery.
//
// Setup: Pure standard library implementation of regularized spatial matrix inversion and post-equalization SINR estimation.
//
// Beats:
//   1. Define 2x2 MMSE equalizer parameters and noise regularization scaling.
//   2. Compute regularized Gram matrix inversion and spatial filtering weights.
//   3. Evaluate unbiased stream estimates and post-detection SINR per layer.

pub type MimoMmseEqualizer2x2 = struct {
    noise_variance_sigma2: Float,
    regularization_lambda: Float,
    stream1_post_sinr_db: Float,
    stream2_post_sinr_db: Float
};

pub fn mimo_mmse_equalizer_new(noise_var: Float) -> MimoMmseEqualizer2x2 {
    let mut safe_var: Float = noise_var;
    if safe_var <= 0.000001 { safe_var = 0.000001; }

    return MimoMmseEqualizer2x2 {
        noise_variance_sigma2: safe_var,
        regularization_lambda: safe_var,
        stream1_post_sinr_db: 0.0,
        stream2_post_sinr_db: 0.0
    };
}

pub fn mimo_mmse_reg_det(g11: Float, g22: Float, g12_sq: Float, sigma2: Float) -> Float {
    // det(H^H H + sigma^2 I) = (g11 + sigma^2) * (g22 + sigma^2) - |g12|^2
    let term1: Float = g11 + sigma2;
    let term2: Float = g22 + sigma2;
    let det: Float = (term1 * term2) - g12_sq;
    if det <= 0.000001 {
        return 0.000001;
    }
    return det;
}

pub fn mimo_mmse_post_sinr_linear(diag_elem: Float, sigma2: Float) -> Float {
    // Post-equalization SINR = 1 / ((H^H H + sigma^2 I)^-1)_ii * (1/sigma^2) - 1
    // Simplified standard form: SINR_i = (w_i^H h_i)^2 / (sum_{j != i} |w_i^H h_j|^2 + sigma^2 |w_i|^2)
    if diag_elem <= 0.000001 || sigma2 <= 0.000001 {
        return 0.0;
    }
    let sinr: Float = diag_elem / sigma2;
    return sinr;
}

pub fn mimo_mmse_sinr_db(sinr_linear: Float) -> Float {
    if sinr_linear <= 0.000001 {
        return 0.0 - 30.0; // Floor at -30 dB
    }
    let ln10: Float = 2.302585092994046;
    return 10.0 * (ln(sinr_linear) / ln10);
}
