// # OFDM Subcarrier Allocation and IFFT Bin Packing
//
// Logline: Maps active baseband data and pilot tones into IFFT subcarrier frequency bins with DC nulling and guard bands.
//
// Setup: Pure standard library implementation of frequency-domain subcarrier allocation and FFT zero padding.
//
// Beats:
//   1. Define subcarrier mapping configuration, FFT size, and occupied spectrum indices.
//   2. Compute symmetric negative and positive subcarrier frequency bin shifts.
//   3. Handle DC subcarrier insertion, guard tone masking, and oversampling packing.

pub type OfdmSubcarrierMapper = struct {
    fft_size: Int,
    num_active_subcarriers: Int,
    null_dc_carrier: Bool,
    guard_band_lower: Int,
    guard_band_upper: Int,
};

pub fn ofdm_subcarrier_mapper_new(fft_size: Int, active_sc: Int, null_dc: Bool) -> OfdmSubcarrierMapper {
    let half_active: Int = active_sc / 2;
    let guard_lower: Int = (fft_size / 2) - half_active;
    let guard_upper: Int = fft_size - (guard_lower + active_sc);

    return OfdmSubcarrierMapper {
        fft_size: fft_size,
        num_active_subcarriers: active_sc,
        null_dc_carrier: null_dc,
        guard_band_lower: guard_lower,
        guard_band_upper: guard_upper,
    };
}

pub fn ofdm_map_active_index_to_fft_bin(mapper: &OfdmSubcarrierMapper, active_idx: Int) -> Int {
    let n_fft: Int = (mapper).fft_size;
    let n_act: Int = (mapper).num_active_subcarriers;
    let half_act: Int = n_act / 2;

    if active_idx < half_act {
        // Negative frequencies: mapped to upper half of FFT [N - half_act .. N - 1]
        return n_fft - half_act + active_idx;
    } else {
        // Positive frequencies: mapped to lower half of FFT [1 .. half_act] if DC is nulled
        let mut pos_offset: Int = active_idx - half_act;
        if (mapper).null_dc_carrier {
            pos_offset = pos_offset + 1; // Skip DC bin 0
        }
        return pos_offset % n_fft;
    }
}

pub fn ofdm_is_guard_bin(mapper: &OfdmSubcarrierMapper, fft_bin: Int) -> Bool {
    let n_fft: Int = (mapper).fft_size;
    let half_act: Int = ((mapper).num_active_subcarriers) / 2;
    let lower_cutoff: Int = half_act + 1;
    let upper_cutoff: Int = n_fft - half_act;

    return fft_bin >= lower_cutoff && fft_bin < upper_cutoff;
}

pub fn ofdm_spectrum_efficiency_factor(mapper: &OfdmSubcarrierMapper) -> Float {
    let act: Float = ofdm_mapper_int_to_float((mapper).num_active_subcarriers);
    let total: Float = ofdm_mapper_int_to_float((mapper).fft_size);
    if total <= 0.0001 {
        return 0.0;
    }
    return act / total;
}

pub fn ofdm_mapper_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
