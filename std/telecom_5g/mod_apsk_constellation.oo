// # 16-APSK and 32-APSK Constellation Geometry
//
// Logline: Implements Amplitude Phase Shift Keying (APSK) concentric ring constellations for nonlinear satellite and NTN channels.
//
// Setup: Pure standard library implementation of DVB-S2X and 5G NTN 16-APSK (4+12) and 32-APSK (4+12+16) constellations.
//
// Beats:
//   1. Define 16-APSK ring radius ratio gamma = r2 / r1 and average power normalization.
//   2. Map ring indices and phase positions to complex I/Q symbols.
//   3. Perform dual-threshold radial ring slicing and phase angle demapping.

pub type Apsk16Config = struct {
    radius_ratio_gamma: Float, // Typical gamma = 2.6 to 3.15
    inner_radius_r1: Float,
    outer_radius_r2: Float,
};

pub fn apsk16_config_new(gamma: Float) -> Apsk16Config {
    let mut g: Float = gamma;
    if g < 1.5 { g = 2.85; } // Standard DVB-S2X rate 3/4 optimal gamma

    // Power normalization: 4 * r1^2 + 12 * r2^2 = 16 -> r1^2 * (4 + 12*gamma^2) = 16
    let r1_sq: Float = 16.0 / (4.0 + (12.0 * g * g));
    let r1: Float = sqrt(r1_sq);
    let r2: Float = r1 * g;

    return Apsk16Config {
        radius_ratio_gamma: g,
        inner_radius_r1: r1,
        outer_radius_r2: r2,
    };
}

pub fn mod_apsk16_inner_symbol_re(cfg: &Apsk16Config, sym_idx: Int) -> Float {
    let pi_val: Float = 3.141592653589793;
    let idx: Int = sym_idx % 4;
    // Inner ring: 4 points at pi/4, 3*pi/4, 5*pi/4, 7*pi/4
    let phase: Float = (pi_val * 0.25) + (mod_apsk_int_to_float(idx) * (pi_val * 0.5));
    return (cfg).inner_radius_r1 * cos(phase);
}

pub fn mod_apsk16_inner_symbol_im(cfg: &Apsk16Config, sym_idx: Int) -> Float {
    let pi_val: Float = 3.141592653589793;
    let idx: Int = sym_idx % 4;
    let phase: Float = (pi_val * 0.25) + (mod_apsk_int_to_float(idx) * (pi_val * 0.5));
    return (cfg).inner_radius_r1 * sin(phase);
}

pub fn mod_apsk16_demap_ring(cfg: &Apsk16Config, rx_mag: Float) -> Int {
    let threshold: Float = ((cfg).inner_radius_r1 + (cfg).outer_radius_r2) * 0.5;
    if rx_mag < threshold {
        return 0; // Inner ring (4 points)
    }
    return 1; // Outer ring (12 points)
}

pub fn mod_apsk_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
