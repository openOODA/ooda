// # Goertzel Single-Tone Frequency Detector
//
// Logline: Implements Goertzel algorithm for single-frequency tone magnitude and phase extraction with O(N) efficiency.
//
// Setup: Pure standard library implementation of single-bin discrete Fourier transform for DTMF, pilot tone, and carrier sensing.
//
// Beats:
//   1. Define Goertzel detector state, target frequency, sampling rate, and feedback coefficient c = 2*cos(2*pi*k/N).
//   2. Step recursive 2nd-order IIR difference equation s[n] = x[n] + c*s[n-1] - s[n-2].
//   3. Compute final power metric |X(k)|^2 = s[N-1]^2 + s[N-2]^2 - c*s[N-1]*s[N-2].

pub type GoertzelToneDetector = struct {
    target_frequency_hz: Float,
    sample_rate_hz: Float,
    block_size_n: Int,
    feedback_coeff_c: Float,
    state_s1: Float,
    state_s2: Float,
    samples_processed: Int
};

pub fn goertzel_tone_detector_new(target_hz: Float, fs_hz: Float, block_n: Int) -> GoertzelToneDetector {
    let pi_val: Float = 3.141592653589793;
    let omega: Float = (2.0 * pi_val * target_hz) / fs_hz;
    let coeff: Float = 2.0 * cos(omega);

    return GoertzelToneDetector {
        target_frequency_hz: target_hz,
        sample_rate_hz: fs_hz,
        block_size_n: block_n,
        feedback_coeff_c: coeff,
        state_s1: 0.0,
        state_s2: 0.0,
        samples_processed: 0
    };
}

pub fn dsp_goertzel_step(detector: &mut GoertzelToneDetector, x_sample: Float) -> Bool {
    let s0: Float = x_sample + ((detector).feedback_coeff_c * (detector).state_s1) - (detector).state_s2;
    (detector).state_s2 = (detector).state_s1;
    (detector).state_s1 = s0;
    (detector).samples_processed = (detector).samples_processed + 1;

    return (detector).samples_processed >= (detector).block_size_n;
}

pub fn dsp_goertzel_calc_power(detector: &GoertzelToneDetector) -> Float {
    let s1: Float = (detector).state_s1;
    let s2: Float = (detector).state_s2;
    let c: Float = (detector).feedback_coeff_c;

    // Power = s1^2 + s2^2 - c * s1 * s2
    return (s1 * s1) + (s2 * s2) - (c * s1 * s2);
}

pub fn dsp_goertzel_reset(detector: &mut GoertzelToneDetector) -> Void {
    (detector).state_s1 = 0.0;
    (detector).state_s2 = 0.0;
    (detector).samples_processed = 0;
}
