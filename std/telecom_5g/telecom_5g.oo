pub type Telecom5gSystemConfig = struct {
    carrier_frequency_hz: Float,
    channel_bandwidth_mhz: Float,
    numerology_mu: Int,
    fft_size: Int,
    num_tx_antennas: Int,
    num_rx_antennas: Int,
    modulation_order_qm: Int,
};

pub fn telecom_5g_system_config_default_fr1() -> Telecom5gSystemConfig {
    return Telecom5gSystemConfig {
        carrier_frequency_hz: 3500000000.0, // 3.5 GHz n78 band
        channel_bandwidth_mhz: 100.0,        // 100 MHz maximum FR1 channel
        numerology_mu: 1,                    // 30 kHz SCS
        fft_size: 4096,
        num_tx_antennas: 4,
        num_rx_antennas: 4,
        modulation_order_qm: 6,              // 64-QAM
    };
}

pub fn telecom_5g_create_ldpc_encoder(bg: Int, k_info: Int) -> Nr5gLdpcEncoderConfig {
    return nr5g_ldpc_encoder_config_new(bg, k_info);
}

pub fn telecom_5g_create_resource_grid(rbs: Int, mu: Int, ports: Int) -> Nr5gResourceGrid {
    return nr5g_resource_grid_new(rbs, mu, ports);
}

pub fn telecom_5g_create_costas_loop(bw: Float, damping: Float, fs: Float) -> CostasLoopState {
    return costas_loop_state_new(bw, damping, fs);
}

pub fn telecom_5g_create_awgn(snr_db: Float, pwr: Float) -> AwgnChannelConfig {
    return awgn_channel_config_new(snr_db, pwr);
}

pub fn telecom_5g_create_dma_buffer(cap: Int) -> SdrDmaRingBuffer {
    return sdr_dma_ring_buffer_new(cap);
}
