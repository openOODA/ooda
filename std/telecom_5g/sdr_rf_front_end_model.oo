// # RF Front-End Impairment and Non-Linearity Model
//
// Logline: Models receiver Low-Noise Amplifier non-linearities (IIP3, P1dB) and cascaded Friis Noise Figure.
//
// Setup: Pure standard library implementation of RF analogue front-end metrics, 3rd-order intermodulation, and noise factor.
//
// Beats:
//   1. Define RF front-end configuration, LNA gain (dB), IIP3 (dBm), and 1-dB compression point.
//   2. Compute 2-stage cascaded Friis Noise Figure F_total = F1 + (F2 - 1) / G1.
//   3. Evaluate Third-Order Intermodulation Distortion (IMD3) power levels.

pub type RfFrontEndModel = struct {
    lna_gain_db: Float,
    lna_noise_figure_db: Float,
    iip3_dbm: Float,
    p1db_dbm: Float
};

pub fn rf_front_end_model_new(gain_db: Float, nf_db: Float, iip3_dbm: Float) -> RfFrontEndModel {
    // Typical relationship: P1dB ~ IIP3 - 9.6 dB for 3rd order polynomial non-linearity
    let p1db: Float = iip3_dbm - 9.6;

    return RfFrontEndModel {
        lna_gain_db: gain_db,
        lna_noise_figure_db: nf_db,
        iip3_dbm: iip3_dbm,
        p1db_dbm: p1db
    };
}

pub fn sdr_rf_friis_cascaded_noise_factor(f1_linear: Float, f2_linear: Float, g1_linear: Float) -> Float {
    if g1_linear <= 0.000001 {
        return f1_linear;
    }
    // F_sys = F1 + (F2 - 1) / G1
    return f1_linear + ((f2_linear - 1.0) / g1_linear);
}

pub fn sdr_rf_imd3_power_dbm(pin_dbm: Float, iip3_dbm: Float, gain_db: Float) -> Float {
    // P_IMD3_out = 3 * P_in - 2 * IIP3 + Gain
    return (3.0 * pin_dbm) - (2.0 * iip3_dbm) + gain_db;
}
