// # Schmidl-Cox OFDM Timing and Frequency Synchronization
//
// Logline: Computes Schmidl-Cox preamble timing metric M(d) and fractional carrier frequency offset (CFO).
//
// Setup: Pure standard library implementation of robust preamble correlation M(d) = |P(d)|^2 / (R(d))^2.
//
// Beats:
//   1. Define Schmidl-Cox synchronizer state, plateau threshold, and FFT block size.
//   2. Compute half-symbol differential autocorrelation P(d) and energy window R(d).
//   3. Extract fractional CFO in subcarrier spacing units from correlation phase angle.

pub type SchmidlCoxSync = struct {
    half_symbol_len_l: Int,
    timing_threshold: Float,
    is_frame_detected: Bool,
    detected_fractional_cfo: Float,
    peak_metric_value: Float
};

pub fn schmidl_cox_sync_new(half_len_l: Int, threshold: Float) -> SchmidlCoxSync {
    let mut safe_thresh: Float = threshold;
    if safe_thresh <= 0.0 || safe_thresh > 1.0 {
        safe_thresh = 0.75; // Standard Schmidl-Cox plateau detection threshold
    }

    return SchmidlCoxSync {
        half_symbol_len_l: half_len_l,
        timing_threshold: safe_thresh,
        is_frame_detected: false,
        detected_fractional_cfo: 0.0,
        peak_metric_value: 0.0
    };
}

pub fn sync_schmidl_cox_metric(p_re: Float, p_im: Float, r_energy: Float) -> Float {
    // M(d) = |P(d)|^2 / (R(d))^2
    let p_sq: Float = (p_re * p_re) + (p_im * p_im);
    let r_sq: Float = r_energy * r_energy;
    if r_sq <= 0.000001 {
        return 0.0;
    }
    return p_sq / r_sq;
}

pub fn sync_schmidl_cox_fractional_cfo(p_angle_rad: Float) -> Float {
    // Delta_f / Delta_f_scs = angle(P(d)) / pi
    let pi_val: Float = 3.141592653589793;
    return p_angle_rad / pi_val;
}

pub fn sync_schmidl_cox_check_peak(sync: &mut SchmidlCoxSync, metric: Float, p_angle: Float) -> Bool {
    if metric > (sync).timing_threshold {
        (sync).is_frame_detected = true;
        (sync).peak_metric_value = metric;
        (sync).detected_fractional_cfo = sync_schmidl_cox_fractional_cfo(p_angle);
        return true;
    }
    return false;
}
