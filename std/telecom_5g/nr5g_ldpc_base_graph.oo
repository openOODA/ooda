// # 5G NR LDPC Base Graph Definitions
//
// Logline: Defines 3GPP TS 38.212 LDPC Base Graph 1 and Base Graph 2 structure parameters and lifting set tables.
//
// Setup: Pure standard library implementation of 5G NR LDPC matrix dimensions, shift coefficients, and graph selectors.
//
// Beats:
//   1. Define LDPC Base Graph configuration structures and lifting factor sets.
//   2. Determine optimal Base Graph (BG1 vs BG2) based on transport block size and code rate.
//   3. Compute expansion factor Zc and nominal parity check matrix dimensions.

type Nr5gLdpcBaseGraph = struct {
    graph_index: Int,
    nrows_mb: Int,
    ncols_nb: Int,
    lifting_zc: Int,
    num_info_cols_kb: Int
};

pub fn nr5g_ldpc_base_graph_new(graph_idx: Int, zc: Int) -> Nr5gLdpcBaseGraph {
    let mut kb: Int = 22;
    let mut mb: Int = 46;
    let mut nb: Int = 68;

    if graph_idx == 2 {
        kb = 10;
        mb = 42;
        nb = 52;
    }

    return Nr5gLdpcBaseGraph {
        graph_index: graph_idx,
        nrows_mb: mb,
        ncols_nb: nb,
        lifting_zc: zc,
        num_info_cols_kb: kb
    };
}

pub fn nr5g_ldpc_select_graph(transport_block_size: Int, code_rate_x1000: Int) -> Int {
    // 3GPP TS 38.212 Section 5.2.2 graph selection rules:
    // BG1 is used for large transport blocks or high code rates (R >= 2/3).
    // BG2 is used for small transport blocks (A <= 292 or A <= 3824 with R <= 0.67).
    if transport_block_size <= 292 {
        return 2;
    }
    if transport_block_size <= 3824 {
        if code_rate_x1000 <= 670 {
            return 2;
        }
    }
    if code_rate_x1000 <= 250 {
        return 2;
    }
    return 1;
}

pub fn nr5g_ldpc_find_lifting_zc(k_prime: Int, bg: Int) -> Int {
    let mut kb: Int = 22;
    if bg == 2 {
        if k_prime > 640 {
            kb = 10;
        } else {
            if k_prime > 560 {
                kb = 9;
            } else {
                if k_prime > 192 {
                    kb = 8;
                } else {
                    kb = 6;
                }
            }
        }
    }

    // Minimum Zc such that Kb * Zc >= k_prime
    let mut min_zc: Int = (k_prime + kb - 1) / kb;
    if min_zc < 2 {
        min_zc = 2;
    }

    // Search standard 3GPP lifting set {2..384}
    if min_zc <= 2 { return 2; }
    if min_zc <= 3 { return 3; }
    if min_zc <= 4 { return 4; }
    if min_zc <= 5 { return 5; }
    if min_zc <= 6 { return 6; }
    if min_zc <= 7 { return 7; }
    if min_zc <= 8 { return 8; }
    if min_zc <= 9 { return 9; }
    if min_zc <= 10 { return 10; }
    if min_zc <= 12 { return 12; }
    if min_zc <= 14 { return 14; }
    if min_zc <= 16 { return 16; }
    if min_zc <= 20 { return 20; }
    if min_zc <= 24 { return 24; }
    if min_zc <= 28 { return 28; }
    if min_zc <= 32 { return 32; }
    if min_zc <= 40 { return 40; }
    if min_zc <= 48 { return 48; }
    if min_zc <= 56 { return 56; }
    if min_zc <= 64 { return 64; }
    if min_zc <= 80 { return 80; }
    if min_zc <= 96 { return 96; }
    if min_zc <= 112 { return 112; }
    if min_zc <= 128 { return 128; }
    if min_zc <= 160 { return 160; }
    if min_zc <= 192 { return 192; }
    if min_zc <= 224 { return 224; }
    if min_zc <= 256 { return 256; }
    if min_zc <= 320 { return 320; }
    return 384;
}

pub fn nr5g_ldpc_codeword_length(bg: Int, zc: Int) -> Int {
    if bg == 1 {
        return 66 * zc; // Nominal coded output columns (excluding 2 punctured info columns)
    }
    return 50 * zc;
}

pub fn nr5g_ldpc_info_bit_capacity(bg: Int, zc: Int) -> Int {
    if bg == 1 {
        return 22 * zc;
    }
    return 10 * zc;
}
