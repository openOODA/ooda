// # 5G NR Gold Sequence Scrambler
//
// Logline: Implements 3GPP TS 38.211 length-31 Gold pseudo-random sequence generation and bit scrambling.
//
// Setup: Pure standard library implementation of PDSCH, PUSCH, and PDCCH scrambling sequences.
//
// Beats:
//   1. Define Gold sequence generator state and initial polynomial seeds.
//   2. Calculate c_init seed values from RNTI, cell ID, and codeword index.
//   3. Generate pseudo-random scrambling bits and execute XOR scrambling/descrambling.

pub type Nr5gScramblerState = struct {
    x1_reg: Int,
    x2_reg: Int,
    init_seed: Int,
};

pub fn nr5g_scrambler_cinit_pdsch(rnti: Int, q_codeword: Int, n_id: Int) -> Int {
    // 3GPP TS 38.211 Section 7.3.1.1: c_init = (n_RNTI * 2^15 + q * 2^14 + n_ID) mod 2^31
    let term1: Int = (rnti % 65536) * 32768;
    let term2: Int = (q_codeword % 2) * 16384;
    let term3: Int = n_id % 1024;
    return (term1 + term2 + term3) % 2147483647;
}

pub fn nr5g_scrambler_state_new(c_init: Int) -> Nr5gScramblerState {
    let mut s: Nr5gScramblerState = Nr5gScramblerState {
        x1_reg: 1, // x1 is initialized to 1 at bit 0
        x2_reg: c_init,
        init_seed: c_init,
    };

    // Advance Nc = 1600 steps per 3GPP specification
    let mut step: Int = 0;
    while step < 1600 {
        let x1_fb: Int = (((s).x1_reg) + (((s).x1_reg) / 8)) % 2;
        let x2_fb: Int = (((s).x2_reg) + (((s).x2_reg) / 2) + (((s).x2_reg) / 4) + (((s).x2_reg) / 8)) % 2;
        (s).x1_reg = ((((s).x1_reg) / 2) + (x1_fb * 1073741824)) % 2147483647;
        (s).x2_reg = ((((s).x2_reg) / 2) + (x2_fb * 1073741824)) % 2147483647;
        step = step + 1;
    }

    return s;
}

pub fn nr5g_scrambler_step_bit(state: &mut Nr5gScramblerState) -> Int {
    let b1: Int = ((state).x1_reg) % 2;
    let b2: Int = ((state).x2_reg) % 2;
    let c_bit: Int = (b1 + b2) % 2;

    let x1_fb: Int = (((state).x1_reg) + (((state).x1_reg) / 8)) % 2;
    let x2_fb: Int = (((state).x2_reg) + (((state).x2_reg) / 2) + (((state).x2_reg) / 4) + (((state).x2_reg) / 8)) % 2;

    (state).x1_reg = ((((state).x1_reg) / 2) + (x1_fb * 1073741824)) % 2147483647;
    (state).x2_reg = ((((state).x2_reg) / 2) + (x2_fb * 1073741824)) % 2147483647;

    return c_bit;
}

pub fn nr5g_scramble_bit(data_bit: Int, c_bit: Int) -> Int {
    return (data_bit + c_bit) % 2;
}
