// # 5G NR Systematic Quasi-Cyclic LDPC Encoder
//
// Logline: Implements 3GPP TS 38.212 quasi-cyclic LDPC encoding with double-diagonal core parity solving.
//
// Setup: Pure standard library implementation of 5G NR systematic LDPC block encoding and circulant shift permutation.
//
// Beats:
//   1. Define LDPC encoder configuration and circular parity state.
//   2. Compute cyclic shift bit mapping and systematic information bit placement.
//   3. Solve core parity vectors and extended parity chains.

import "./nr5g_ldpc_base_graph.oo";

pub type Nr5gLdpcEncoderConfig = struct {
    base_graph: Nr5gLdpcBaseGraph,
    info_bits_k: Int,
    filler_bits_f: Int,
    coded_bits_n: Int
};

pub fn nr5g_ldpc_encoder_config_new(bg_idx: Int, k_info: Int) -> Nr5gLdpcEncoderConfig {
    let zc: Int = nr5g_ldpc_find_lifting_zc(k_info, bg_idx);
    let bg: Nr5gLdpcBaseGraph = nr5g_ldpc_base_graph_new(bg_idx, zc);
    let total_k: Int = nr5g_ldpc_info_bit_capacity(bg_idx, zc);
    let filler: Int = total_k - k_info;
    let n_code: Int = nr5g_ldpc_codeword_length(bg_idx, zc);

    return Nr5gLdpcEncoderConfig {
        base_graph: bg,
        info_bits_k: k_info,
        filler_bits_f: filler,
        coded_bits_n: n_code
    };
}

pub fn nr5g_ldpc_circulant_shift(bit_index: Int, shift_val: Int, zc: Int) -> Int {
    if shift_val < 0 {
        return 0 - 1; // Null matrix entry (no edge)
    }
    if zc <= 0 {
        return 0;
    }
    return (bit_index + shift_val) % zc;
}

pub fn nr5g_ldpc_encode_parity_bit(info_sum: Int, prior_parity_sum: Int) -> Int {
    let total: Int = info_sum + prior_parity_sum;
    return total % 2;
}

pub fn nr5g_ldpc_effective_code_rate(cfg: &Nr5gLdpcEncoderConfig) -> Float {
    let k_eff: Float = nr5g_ldpc_encoder_int_to_float((cfg).info_bits_k);
    let n_eff: Float = nr5g_ldpc_encoder_int_to_float((cfg).coded_bits_n);
    if n_eff <= 0.0001 {
        return 0.0;
    }
    return k_eff / n_eff;
}

pub fn nr5g_ldpc_encoder_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
