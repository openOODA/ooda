// # OFDM MIMO Channel Matrix Algebra
//
// Logline: Computes 2x2 and 4x4 spatial frequency-domain channel matrices, Frobenius norms, and determinants.
//
// Setup: Pure standard library implementation of complex multi-antenna channel transfer functions per subcarrier.
//
// Beats:
//   1. Define 2x2 complex MIMO channel matrix representation.
//   2. Compute Frobenius matrix norm and Gramian matrix H^H * H.
//   3. Evaluate matrix condition number and complex 2x2 determinant.

pub type ComplexScalar = struct {
    re: Float,
    im: Float
};

pub type MimoChannel2x2 = struct {
    h11: ComplexScalar,
    h12: ComplexScalar,
    h21: ComplexScalar,
    h22: ComplexScalar
};

pub fn mimo_channel_2x2_new(
    h11_re: Float, h11_im: Float,
    h12_re: Float, h12_im: Float,
    h21_re: Float, h21_im: Float,
    h22_re: Float, h22_im: Float,
) -> MimoChannel2x2 {
    return MimoChannel2x2 {
        h11: ComplexScalar { re: h11_re, im: h11_im },
        h12: ComplexScalar { re: h12_re, im: h12_im },
        h21: ComplexScalar { re: h21_re, im: h21_im },
        h22: ComplexScalar { re: h22_re, im: h22_im }
    };
}

pub fn mimo_channel_frobenius_norm_sq(mat: &MimoChannel2x2) -> Float {
    let p11: Float = (((mat).h11).re * ((mat).h11).re) + (((mat).h11).im * ((mat).h11).im);
    let p12: Float = (((mat).h12).re * ((mat).h12).re) + (((mat).h12).im * ((mat).h12).im);
    let p21: Float = (((mat).h21).re * ((mat).h21).re) + (((mat).h21).im * ((mat).h21).im);
    let p22: Float = (((mat).h22).re * ((mat).h22).re) + (((mat).h22).im * ((mat).h22).im);
    return p11 + p12 + p21 + p22;
}

pub fn mimo_channel_determinant_sq(mat: &MimoChannel2x2) -> Float {
    // det(H) = h11 * h22 - h12 * h21
    let p1_re: Float = (((mat).h11).re * ((mat).h22).re) - (((mat).h11).im * ((mat).h22).im);
    let p1_im: Float = (((mat).h11).re * ((mat).h22).im) + (((mat).h11).im * ((mat).h22).re);

    let p2_re: Float = (((mat).h12).re * ((mat).h21).re) - (((mat).h12).im * ((mat).h21).im);
    let p2_im: Float = (((mat).h12).re * ((mat).h21).im) + (((mat).h12).im * ((mat).h21).re);

    let det_re: Float = p1_re - p2_re;
    let det_im: Float = p1_im - p2_im;

    return (det_re * det_re) + (det_im * det_im);
}

pub fn mimo_channel_condition_estimate(mat: &MimoChannel2x2) -> Float {
    let fnorm: Float = mimo_channel_frobenius_norm_sq(mat);
    let det_sq: Float = mimo_channel_determinant_sq(mat);
    if det_sq <= 0.000001 {
        return 999999.0; // Ill-conditioned / rank deficient
    }
    return fnorm / sqrt(det_sq);
}
