// # OFDM PAPR Reduction and Soft Clipping
//
// Logline: Implements Peak-to-Average Power Ratio metrics, Selected Mapping phase weighting, and soft clipping.
//
// Setup: Pure standard library implementation of OFDM crest factor reduction and power amplifier backoff optimization.
//
// Beats:
//   1. Define PAPR metrics, peak power detection, and average power accumulation.
//   2. Compute Selected Mapping (SLM) candidate phase shifts.
//   3. Apply soft limiter amplitude clipping and calculate clipping distortion EVM.

pub type OfdmPaprStats = struct {
    peak_power_linear: Float,
    average_power_linear: Float,
    papr_db: Float,
    samples_clipped: Int
};

pub fn ofdm_papr_stats_new() -> OfdmPaprStats {
    return OfdmPaprStats {
        peak_power_linear: 0.0,
        average_power_linear: 1.0,
        papr_db: 0.0,
        samples_clipped: 0
    };
}

pub fn ofdm_papr_calc_db(peak_pwr: Float, avg_pwr: Float) -> Float {
    if avg_pwr <= 0.000001 || peak_pwr <= 0.000001 {
        return 0.0;
    }
    let ratio: Float = peak_pwr / avg_pwr;
    // 10 * log10(ratio) = 10 * (ln(ratio) / ln(10))
    let ln10: Float = 2.302585092994046;
    return 10.0 * (ln(ratio) / ln10);
}

pub fn ofdm_slm_phase_rotation_rad(phase_index: Int) -> Float {
    let pi_val: Float = 3.141592653589793;
    let idx: Int = phase_index % 4;
    // 0 -> 0, 1 -> pi/2, 2 -> pi, 3 -> 3*pi/2
    let frac: Float = ofdm_papr_int_to_float(idx) * 0.5;
    return frac * pi_val;
}

pub fn ofdm_soft_clip_amplitude(sample_re: Float, sample_im: Float, clip_threshold: Float) -> Float {
    let mag: Float = sqrt((sample_re * sample_re) + (sample_im * sample_im));
    if mag > clip_threshold && mag > 0.000001 {
        return clip_threshold / mag; // Scaling factor
    }
    return 1.0;
}

pub fn ofdm_papr_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
