// # 5G NR OFDM Resource Grid Architecture
//
// Logline: Manages 2D time-frequency resource elements, resource blocks, and bandwidth parts for 5G NR slots.
//
// Setup: Pure standard library implementation of 5G NR resource grid dimensions, indexing, and capacity calculations.
//
// Beats:
//   1. Define Resource Element (RE), Resource Block (RB), and Bandwidth Part (BWP) structures.
//   2. Compute linear memory offsets from (subcarrier, symbol, antenna port) coordinates.
//   3. Calculate channel bandwidth, occupied transmission bandwidth, and total RE throughput.

pub type Nr5gResourceGrid = struct {
    num_rbs: Int,
    subcarriers_per_rb: Int,
    symbols_per_slot: Int,
    numerology_mu: Int,
    num_antenna_ports: Int,
};

pub fn nr5g_resource_grid_new(rbs: Int, mu: Int, ports: Int) -> Nr5gResourceGrid {
    let mut safe_ports: Int = ports;
    if safe_ports < 1 { safe_ports = 1; }

    return Nr5gResourceGrid {
        num_rbs: rbs,
        subcarriers_per_rb: 12, // 3GPP fixed standard
        symbols_per_slot: 14,   // Normal CP slot length
        numerology_mu: mu,
        num_antenna_ports: safe_ports,
    };
}

pub fn nr5g_grid_total_subcarriers(grid: &Nr5gResourceGrid) -> Int {
    return (grid).num_rbs * (grid).subcarriers_per_rb;
}

pub fn nr5g_grid_total_res_per_port(grid: &Nr5gResourceGrid) -> Int {
    let sc_count: Int = nr5g_grid_total_subcarriers(grid);
    return sc_count * (grid).symbols_per_slot;
}

pub fn nr5g_grid_re_linear_index(grid: &Nr5gResourceGrid, port: Int, symbol: Int, subcarrier: Int) -> Int {
    let total_sc: Int = nr5g_grid_total_subcarriers(grid);
    let sym_offset: Int = symbol * total_sc;
    let port_offset: Int = port * (total_sc * (grid).symbols_per_slot);
    return port_offset + sym_offset + subcarrier;
}

pub fn nr5g_grid_scs_khz(mu: Int) -> Int {
    let mut scs: Int = 15;
    let mut m: Int = mu;
    while m > 0 {
        scs = scs * 2;
        m = m - 1;
    }
    return scs;
}

pub fn nr5g_grid_channel_bandwidth_khz(grid: &Nr5gResourceGrid) -> Float {
    let scs: Float = ofdm_grid_int_to_float(nr5g_grid_scs_khz((grid).numerology_mu));
    let total_sc: Float = ofdm_grid_int_to_float(nr5g_grid_total_subcarriers(grid));
    return total_sc * scs;
}

pub fn ofdm_grid_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
