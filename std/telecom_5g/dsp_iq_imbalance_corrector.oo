// # Direct-Conversion Receiver I/Q Imbalance Corrector
//
// Logline: Estimates and compensates receiver quadrature amplitude and phase imbalances via Gram-Schmidt orthogonalization.
//
// Setup: Pure standard library implementation of zero-IF SDR I/Q impairment correction and Image Rejection Ratio (IRR) estimation.
//
// Beats:
//   1. Define I/Q impairment parameters, amplitude mismatch alpha, and phase skew phi.
//   2. Compute Image Rejection Ratio (IRR) in dB from imbalance parameters.
//   3. Apply Gram-Schmidt orthogonalization matrix transformation to raw ADC I/Q samples.

pub type IqImbalanceModel = struct {
    gain_imbalance_alpha: Float, // e.g. 1.05 (+5% amplitude mismatch)
    phase_imbalance_phi_rad: Float, // e.g. 0.035 rad (~2 degrees)
    image_rejection_ratio_db: Float,
};

pub fn iq_imbalance_model_new(alpha: Float, phi_rad: Float) -> IqImbalanceModel {
    let irr: Float = dsp_iq_calc_irr_db(alpha, phi_rad);

    return IqImbalanceModel {
        gain_imbalance_alpha: alpha,
        phase_imbalance_phi_rad: phi_rad,
        image_rejection_ratio_db: irr,
    };
}

pub fn dsp_iq_calc_irr_db(alpha: Float, phi: Float) -> Float {
    // IRR = 10 * log10((1 + 2*alpha*cos(phi) + alpha^2) / (1 - 2*alpha*cos(phi) + alpha^2))
    let a2: Float = alpha * alpha;
    let cross: Float = 2.0 * alpha * cos(phi);
    let num: Float = 1.0 + cross + a2;
    let mut den: Float = 1.0 - cross + a2;
    if den <= 0.000001 { den = 0.000001; }

    let ln10: Float = 2.302585092994046;
    let ratio: Float = num / den;
    return 10.0 * (ln(ratio) / ln10);
}

pub fn dsp_iq_correct_sample_i(raw_i: Float) -> Float {
    return raw_i; // Base reference channel
}

pub fn dsp_iq_correct_sample_q(raw_i: Float, raw_q: Float, alpha: Float, phi: Float) -> Float {
    // Corrected Q = (raw_q - raw_i * sin(phi)) / (alpha * cos(phi))
    let cs: Float = cos(phi);
    let sn: Float = sin(phi);
    let denom: Float = alpha * cs;
    if denom > (0.0 - 0.000001) && denom < 0.000001 {
        return raw_q;
    }
    return (raw_q - (raw_i * sn)) / denom;
}
