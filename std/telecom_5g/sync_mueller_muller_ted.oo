// # Mueller & Müller Decision-Directed Timing Error Detector
//
// Logline: Implements baud-rate decision-directed Mueller & Müller timing recovery operating at 1 sample per symbol.
//
// Setup: Pure standard library implementation of low-complexity symbol clock synchronization for SDR modems.
//
// Beats:
//   1. Define Mueller & Müller TED state, loop bandwidth, and decision slicer.
//   2. Compute timing error e(k) = a(k-1)*x(k) - a(k)*x(k-1).
//   3. Step proportional-integral loop filter to adjust baud-rate interpolator sampling instants.

pub type MuellerMullerTedState = struct {
    gain_kp: Float,
    gain_ki: Float,
    integrator: Float,
    prev_sample: Float,
    prev_decision: Float,
    timing_offset: Float,
};

pub fn mueller_muller_ted_state_new(loop_bw: Float, damping: Float) -> MuellerMullerTedState {
    let kp: Float = 2.0 * damping * loop_bw;
    let ki: Float = loop_bw * loop_bw;

    return MuellerMullerTedState {
        gain_kp: kp,
        gain_ki: ki,
        integrator: 0.0,
        prev_sample: 0.0,
        prev_decision: 1.0,
        timing_offset: 0.0,
    };
}

pub fn sync_mm_slice_bpsk(sample: Float) -> Float {
    if sample >= 0.0 {
        return 1.0;
    }
    return 0.0 - 1.0;
}

pub fn sync_mm_ted_error(curr_sample: Float, prev_sample: Float, curr_dec: Float, prev_dec: Float) -> Float {
    // e(k) = a(k-1)*x(k) - a(k)*x(k-1)
    return (prev_dec * curr_sample) - (curr_dec * prev_sample);
}

pub fn sync_mm_step(state: &mut MuellerMullerTedState, curr_sample: Float) -> Float {
    let curr_dec: Float = sync_mm_slice_bpsk(curr_sample);
    let err: Float = sync_mm_ted_error(curr_sample, (state).prev_sample, curr_dec, (state).prev_decision);

    (state).prev_sample = curr_sample;
    (state).prev_decision = curr_dec;

    (state).integrator = (state).integrator + ((state).gain_ki * err);
    (state).timing_offset = (state).timing_offset + ((state).gain_kp * err) + (state).integrator;

    return (state).timing_offset;
}
