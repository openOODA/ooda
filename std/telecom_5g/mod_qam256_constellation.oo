// # 256-QAM High-Order Constellation Mapping
//
// Logline: Implements 256-QAM Gray mapping, normalization 1/sqrt(170), and PAM-16 quantization decision regions.
//
// Setup: Pure standard library implementation of 8-bit per symbol 256-QAM high spectral efficiency modulation.
//
// Beats:
//   1. Define 256-QAM constellation geometry and normalization scale 1/sqrt(170).
//   2. Map 4-bit nibbles to Gray-coded PAM-16 constellation levels (+-1 .. +-15).
//   3. Compute PAM-16 quantization thresholds and peak-to-average power metrics.

pub type Qam256Constellation = struct {
    norm_factor: Float,
    bits_per_symbol: Int,
    max_peak_power: Float
};

pub fn qam256_constellation_new() -> Qam256Constellation {
    return Qam256Constellation {
        norm_factor: 0.07669649888473704, // 1 / sqrt(170)
        bits_per_symbol: 8,
        max_peak_power: 2.64705882 // (15^2 + 15^2) / 170
    };
}

pub fn mod_qam256_pam16_map(bits4: Int) -> Float {
    let b: Int = bits4 % 16;
    if b == 0 { return 0.0 - 15.0; }
    if b == 1 { return 0.0 - 13.0; }
    if b == 3 { return 0.0 - 11.0; }
    if b == 2 { return 0.0 - 9.0; }
    if b == 6 { return 0.0 - 7.0; }
    if b == 7 { return 0.0 - 5.0; }
    if b == 5 { return 0.0 - 3.0; }
    if b == 4 { return 0.0 - 1.0; }
    if b == 12 { return 1.0; }
    if b == 13 { return 3.0; }
    if b == 15 { return 5.0; }
    if b == 14 { return 7.0; }
    if b == 10 { return 9.0; }
    if b == 11 { return 11.0; }
    if b == 9 { return 13.0; }
    return 15.0; // b == 8
}

pub fn mod_qam256_spectral_efficiency(code_rate: Float) -> Float {
    return 8.0 * code_rate; // bits / s / Hz
}
