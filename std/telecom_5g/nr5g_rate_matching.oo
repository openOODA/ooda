// # 5G NR Rate Matching and Bit Selection
//
// Logline: Implements 3GPP TS 38.212 circular buffer rate matching, redundancy version offsets, and bit interleaving.
//
// Setup: Pure standard library implementation of HARQ circular buffer addressing, bit puncturing, and repetition.
//
// Beats:
//   1. Define circular buffer parameters, Redundancy Version (RV0..RV3) starting points, and output length E.
//   2. Compute starting bit index k0 for Base Graph 1 and Base Graph 2.
//   3. Map circular buffer read pointers and rectangular channel interleaver coordinates.

pub type Nr5gRateMatchingConfig = struct {
    base_graph_idx: Int,
    lifting_zc: Int,
    circular_buffer_ncb: Int,
    output_length_e: Int,
    redundancy_version: Int,
    modulation_order_qm: Int
};

pub fn nr5g_rate_matching_config_new(bg: Int, zc: Int, n_cb: Int, e_len: Int, rv: Int, qm: Int) -> Nr5gRateMatchingConfig {
    return Nr5gRateMatchingConfig {
        base_graph_idx: bg,
        lifting_zc: zc,
        circular_buffer_ncb: n_cb,
        output_length_e: e_len,
        redundancy_version: rv % 4,
        modulation_order_qm: qm
    };
}

pub fn nr5g_rate_matching_k0(bg: Int, zc: Int, n_cb: Int, rv: Int) -> Int {
    // 3GPP TS 38.212 Section 5.4.2.1 formula for k0 starting position
    let rv_idx: Int = rv % 4;

    if bg == 1 {
        if rv_idx == 0 { return 0; }
        if rv_idx == 1 { return (17 * n_cb) / (66 * zc) * zc; }
        if rv_idx == 2 { return (33 * n_cb) / (66 * zc) * zc; }
        return (56 * n_cb) / (66 * zc) * zc; // rv_idx == 3
    } else {
        if rv_idx == 0 { return 0; }
        if rv_idx == 1 { return (13 * n_cb) / (50 * zc) * zc; }
        if rv_idx == 2 { return (25 * n_cb) / (50 * zc) * zc; }
        return (43 * n_cb) / (50 * zc) * zc; // rv_idx == 3
    }
}

pub fn nr5g_rate_matching_read_index(k0: Int, bit_pos: Int, n_cb: Int) -> Int {
    if n_cb <= 0 {
        return 0;
    }
    return (k0 + bit_pos) % n_cb;
}

pub fn nr5g_rate_matching_is_repeated(output_length_e: Int, circular_buffer_ncb: Int) -> Bool {
    return output_length_e > circular_buffer_ncb;
}

pub fn nr5g_rate_matching_interleaver_row_col(e_idx: Int, qm: Int) -> Int {
    if qm <= 0 {
        return e_idx;
    }
    let c: Int = e_idx / qm;
    let r: Int = e_idx % qm;
    return (r * 1000) + c;
}
