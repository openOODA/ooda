// # Rayleigh Multipath Fading Channel Model
//
// Logline: Generates Rayleigh fading envelope statistics, exponential power delay profiles (PDP), and coherence bandwidth.
//
// Setup: Pure standard library implementation of non-line-of-sight (NLoS) statistical multipath wireless fading channels.
//
// Beats:
//   1. Define Rayleigh channel parameters, RMS delay spread, and envelope probability density function.
//   2. Compute exponential Power Delay Profile tap powers P(tau) = exp(-tau / tau_rms).
//   3. Calculate channel 50% and 90% coherence bandwidths B_c = 1 / (5 * tau_rms).

pub type RayleighChannelConfig = struct {
    rms_delay_spread_ns: Float,
    max_excess_delay_ns: Float,
    num_multipath_taps: Int,
    coherence_bandwidth_khz: Float,
};

pub fn rayleigh_channel_config_new(rms_ds_ns: Float, num_taps: Int) -> RayleighChannelConfig {
    let mut safe_ds: Float = rms_ds_ns;
    if safe_ds <= 0.1 { safe_ds = 100.0; } // Default 100 ns delay spread

    // Coherence bandwidth (50% correlation): B_c = 1 / (5 * tau_rms)
    // tau_rms in ns -> B_c in GHz -> * 1e6 to get kHz
    let ds_sec: Float = safe_ds * 0.000000001;
    let bc_hz: Float = 1.0 / (5.0 * ds_sec);
    let bc_khz: Float = bc_hz / 1000.0;

    return RayleighChannelConfig {
        rms_delay_spread_ns: safe_ds,
        max_excess_delay_ns: safe_ds * 5.0,
        num_multipath_taps: num_taps,
        coherence_bandwidth_khz: bc_khz,
    };
}

pub fn channel_rayleigh_pdf(r: Float, sigma_sq: Float) -> Float {
    if r < 0.0 || sigma_sq <= 0.000001 {
        return 0.0;
    }
    // p(r) = (r / sigma^2) * exp(-r^2 / (2 * sigma^2))
    let exp_arg: Float = (0.0 - (r * r)) / (2.0 * sigma_sq);
    return (r / sigma_sq) * exp(exp_arg);
}

pub fn channel_rayleigh_tap_pwr_linear(delay_ns: Float, rms_ds_ns: Float) -> Float {
    if rms_ds_ns <= 0.000001 {
        return 1.0;
    }
    let arg: Float = (0.0 - delay_ns) / rms_ds_ns;
    return exp(arg);
}
