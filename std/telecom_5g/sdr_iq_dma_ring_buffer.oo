// # High-Throughput SDR I/Q DMA Ring Buffer
//
// Logline: Implements lock-free circular DMA buffer indexing, overrun/underrun telemetry, and latency tracking.
//
// Setup: Pure standard library implementation of continuous streaming sample buffers for SDR PCIe and USB endpoints.
//
// Beats:
//   1. Define circular buffer capacity, head/tail indices, and power-of-2 bitmasking.
//   2. Compute available read occupancy and contiguous linear write spans.
//   3. Track hardware FIFO overrun (buffer full) and underrun (buffer empty) drop counts.

pub type SdrDmaRingBuffer = struct {
    capacity_samples: Int,
    index_mask: Int,
    head_write_index: Int,
    tail_read_index: Int,
    overrun_count: Int,
    underrun_count: Int
};

pub fn sdr_dma_ring_buffer_new(capacity_power_of_two: Int) -> SdrDmaRingBuffer {
    let mut cap: Int = capacity_power_of_two;
    if cap < 1024 { cap = 1024; }

    return SdrDmaRingBuffer {
        capacity_samples: cap,
        index_mask: cap - 1,
        head_write_index: 0,
        tail_read_index: 0,
        overrun_count: 0,
        underrun_count: 0
    };
}

pub fn sdr_dma_occupancy(buf: &SdrDmaRingBuffer) -> Int {
    let diff: Int = (buf).head_write_index - (buf).tail_read_index;
    if diff < 0 {
        return diff + (buf).capacity_samples;
    }
    return diff;
}

pub fn sdr_dma_free_space(buf: &SdrDmaRingBuffer) -> Int {
    return ((buf).capacity_samples - 1) - sdr_dma_occupancy(buf);
}

pub fn sdr_dma_push_samples(buf: &mut SdrDmaRingBuffer, num_samples: Int) -> Bool {
    let free_slots: Int = sdr_dma_free_space(buf);
    if num_samples > free_slots {
        (buf).overrun_count = (buf).overrun_count + 1;
        return false;
    }
    (buf).head_write_index = ((buf).head_write_index + num_samples) & (buf).index_mask;
    return true;
}

pub fn sdr_dma_pop_samples(buf: &mut SdrDmaRingBuffer, num_samples: Int) -> Bool {
    let avail: Int = sdr_dma_occupancy(buf);
    if num_samples > avail {
        (buf).underrun_count = (buf).underrun_count + 1;
        return false;
    }
    (buf).tail_read_index = ((buf).tail_read_index + num_samples) & (buf).index_mask;
    return true;
}
