// # AWGN Generator and SNR Scaling
//
// Logline: Implements Box-Muller normal Gaussian noise generation and SNR/EbN0 noise variance calibration.
//
// Setup: Pure standard library implementation of Additive White Gaussian Noise generation and thermal noise power scaling.
//
// Beats:
//   1. Define AWGN channel state, target SNR (dB), and noise spectral density N0.
//   2. Compute Box-Muller complex Gaussian random variates from uniform entropy.
//   3. Convert Eb/N0, Es/N0, and SNR (dB) to per-sample noise variance sigma^2.

pub type AwgnChannelConfig = struct {
    target_snr_db: Float,
    noise_variance_sigma2: Float,
    noise_amplitude_sigma: Float
};

pub fn awgn_channel_config_new(snr_db: Float, signal_pwr: Float) -> AwgnChannelConfig {
    let ln10: Float = 2.302585092994046;
    let snr_linear: Float = exp(snr_db * (ln10 / 10.0));
    let mut safe_snr: Float = snr_linear;
    if safe_snr <= 0.000001 { safe_snr = 0.000001; }

    let n0: Float = signal_pwr / safe_snr;
    let sigma: Float = sqrt(n0 * 0.5); // per real/imag dimension

    return AwgnChannelConfig {
        target_snr_db: snr_db,
        noise_variance_sigma2: n0,
        noise_amplitude_sigma: sigma
    };
}

pub fn channel_box_muller_re(u1: Float, u2: Float) -> Float {
    // u1, u2 in (0, 1]
    let mut safe_u1: Float = u1;
    if safe_u1 <= 0.0000001 { safe_u1 = 0.0000001; }
    if safe_u1 >= 1.0 { safe_u1 = 0.9999999; }

    let r: Float = sqrt((0.0 - 2.0) * ln(safe_u1));
    let pi_val: Float = 3.141592653589793;
    let theta: Float = 2.0 * pi_val * u2;

    return r * cos(theta);
}

pub fn channel_box_muller_im(u1: Float, u2: Float) -> Float {
    let mut safe_u1: Float = u1;
    if safe_u1 <= 0.0000001 { safe_u1 = 0.0000001; }
    if safe_u1 >= 1.0 { safe_u1 = 0.9999999; }

    let r: Float = sqrt((0.0 - 2.0) * ln(safe_u1));
    let pi_val: Float = 3.141592653589793;
    let theta: Float = 2.0 * pi_val * u2;

    return r * sin(theta);
}

pub fn channel_add_awgn_sample(sig_val: Float, noise_gauss: Float, sigma: Float) -> Float {
    return sig_val + (noise_gauss * sigma);
}
