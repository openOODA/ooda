// # 5G NR Polar Successive Cancellation Decoder
//
// Logline: Implements Successive Cancellation (SC) and List (SCL) decoding node operations for 5G NR Polar codes.
//
// Setup: Pure standard library implementation of polar f-node (check/min-sum) and g-node (variable) recursive tree updates.
//
// Beats:
//   1. Define polar decoding node types, path metric state, and candidate list structures.
//   2. Compute min-sum f-node operations and decision-directed g-node operations.
//   3. Evaluate SCL path metric penalization and survivor branch pruning.

pub type Nr5gPolarScListState = struct {
    list_size_l: Int,
    active_paths: Int,
    current_bit_index: Int,
    best_path_metric: Float,
};

pub fn nr5g_polar_sc_list_state_new(list_size: Int) -> Nr5gPolarScListState {
    let mut safe_l: Int = list_size;
    if safe_l < 1 { safe_l = 1; }
    if safe_l > 32 { safe_l = 32; }

    return Nr5gPolarScListState {
        list_size_l: safe_l,
        active_paths: 1,
        current_bit_index: 0,
        best_path_metric: 0.0,
    };
}

pub fn nr5g_polar_f_node_llr(llr_left: Float, llr_right: Float) -> Float {
    // Min-sum approximation of 2*atanh(tanh(L1/2)*tanh(L2/2))
    let mut sign: Float = 1.0;
    if llr_left < 0.0 { sign = 0.0 - sign; }
    if llr_right < 0.0 { sign = 0.0 - sign; }

    let mut abs_left: Float = llr_left;
    if abs_left < 0.0 { abs_left = 0.0 - abs_left; }
    let mut abs_right: Float = llr_right;
    if abs_right < 0.0 { abs_right = 0.0 - abs_right; }

    let mut min_abs: Float = abs_left;
    if abs_right < min_abs {
        min_abs = abs_right;
    }

    return sign * min_abs;
}

pub fn nr5g_polar_g_node_llr(llr_left: Float, llr_right: Float, u_hat: Int) -> Float {
    // g(L1, L2, u) = L2 + (1 - 2*u) * L1
    if u_hat == 0 {
        return llr_right + llr_left;
    }
    return llr_right - llr_left;
}

pub fn nr5g_polar_scl_path_penalty(llr: Float, bit_decision: Int) -> Float {
    // Exact or approximate path metric penalty:
    // If bit matches sign of LLR -> 0 penalty; else add |LLR|
    let mut abs_llr: Float = llr;
    if abs_llr < 0.0 { abs_llr = 0.0 - abs_llr; }

    if llr >= 0.0 && bit_decision == 0 {
        return 0.0;
    }
    if llr < 0.0 && bit_decision == 1 {
        return 0.0;
    }
    return abs_llr;
}

pub fn nr5g_polar_update_path_metric(prev_pm: Float, penalty: Float) -> Float {
    return prev_pm + penalty;
}
