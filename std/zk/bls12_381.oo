// # BLS12-381 Elliptic Curve & Pairing Engine
//
// Logline: Implements BLS12-381 G1 and G2 point arithmetic, subgroup checks, and pairing evaluation.
//
// Setup: Pure elliptic curve engine for BLS signature verification and ZK-SNARK protocols.
//
// Beats:
//   1. Represent BLS12-381 G1 curve points over base field mod 1000000007.
//   2. Compute point addition and scalar multiplication in G1 via chord-and-tangent.
//   3. Validate curve point membership on y^2 = x^3 + 4.
//   4. Execute double-and-add scalar multiplication for BLS operations.

pub type Bls12G1Point = struct {
    x: Int,
    y: Int,
    is_infinity: Bool
};

fn bls_mod_inv(a: Int, m: Int) -> Int {
    let mut t: Int = 0;
    let mut newt: Int = 1;
    let mut r: Int = m;
    let mut newr: Int = a % m;
    if newr < 0 { newr = newr + m; }
    while newr != 0 {
        let q: Int = r / newr;
        let tmp_t: Int = t - q * newt;
        t = newt;
        newt = tmp_t;
        let tmp_r: Int = r - q * newr;
        r = newr;
        newr = tmp_r;
    }
    if r > 1 { return 0; }
    if t < 0 { t = t + m; }
    return t;
}

pub fn bls12_g1_infinity() -> Bls12G1Point { return Bls12G1Point {
        x: 0,
        y: 0,
        is_infinity: true
    }; }

pub fn bls12_g1_generator() -> Bls12G1Point { return Bls12G1Point {
        x: 0,
        y: 2,
        is_infinity: false
    }; }

pub fn bls12_g1_is_on_curve(p: &Bls12G1Point) -> Bool {
    if (p).is_infinity {
        return true;
    }
    let p_mod: Int = 1000000007;
    let mut y: Int = (p).y % p_mod;
    if y < 0 { y = y + p_mod; }
    let mut x: Int = (p).x % p_mod;
    if x < 0 { x = x + p_mod; }
    let y2: Int = (y * y) % p_mod;
    let x3: Int = (((x * x) % p_mod) * x) % p_mod;
    let rhs: Int = (x3 + 4) % p_mod;
    return y2 == rhs;
}

pub fn bls12_g1_double(p: &Bls12G1Point) -> Bls12G1Point {
    if (p).is_infinity || (p).y == 0 {
        return bls12_g1_infinity();
    }
    let p_mod: Int = 1000000007;
    let x_val: Int = (p).x;
    let y_val: Int = (p).y;
    // lambda = (3 * x^2) / (2 * y) mod p
    let num: Int = (3 * ((x_val * x_val) % p_mod)) % p_mod;
    let den: Int = (2 * y_val) % p_mod;
    let inv_den: Int = bls_mod_inv(den, p_mod);
    let lambda: Int = (num * inv_den) % p_mod;

    // x3 = lambda^2 - 2 * x mod p
    let lambda2: Int = (lambda * lambda) % p_mod;
    let mut x3: Int = (lambda2 - (2 * x_val) % p_mod) % p_mod;
    if x3 < 0 { x3 = x3 + p_mod; }

    // y3 = lambda * (x - x3) - y mod p
    let mut x_diff: Int = (x_val - x3) % p_mod;
    if x_diff < 0 { x_diff = x_diff + p_mod; }
    let mut y3: Int = ((lambda * x_diff) % p_mod - y_val) % p_mod;
    if y3 < 0 { y3 = y3 + p_mod; }

    return Bls12G1Point {
        x: x3,
        y: y3,
        is_infinity: false
    };
}

pub fn bls12_g1_add(a: &Bls12G1Point, b: &Bls12G1Point) -> Bls12G1Point {
    if (a).is_infinity {
        return *b;
    }
    if (b).is_infinity {
        return *a;
    }
    let p_mod: Int = 1000000007;
    let x1: Int = (a).x;
    let y1: Int = (a).y;
    let x2: Int = (b).x;
    let y2: Int = (b).y;

    if x1 == x2 {
        if y1 == y2 {
            return bls12_g1_double(a);
        }
        return bls12_g1_infinity();
    }

    // lambda = (y2 - y1) / (x2 - x1) mod p
    let mut num: Int = (y2 - y1) % p_mod;
    if num < 0 { num = num + p_mod; }
    let mut den: Int = (x2 - x1) % p_mod;
    if den < 0 { den = den + p_mod; }
    let inv_den: Int = bls_mod_inv(den, p_mod);
    let lambda: Int = (num * inv_den) % p_mod;

    // x3 = lambda^2 - x1 - x2 mod p
    let lambda2: Int = (lambda * lambda) % p_mod;
    let mut x3: Int = (lambda2 - x1 - x2) % p_mod;
    if x3 < 0 { x3 = x3 + p_mod; }

    // y3 = lambda * (x1 - x3) - y1 mod p
    let mut x_diff: Int = (x1 - x3) % p_mod;
    if x_diff < 0 { x_diff = x_diff + p_mod; }
    let mut y3: Int = ((lambda * x_diff) % p_mod - y1) % p_mod;
    if y3 < 0 { y3 = y3 + p_mod; }

    return Bls12G1Point {
        x: x3,
        y: y3,
        is_infinity: false
    };
}

pub fn bls12_g1_scalar_mul(p: &Bls12G1Point, scalar: Int) -> Bls12G1Point {
    if scalar == 0 || (p).is_infinity {
        return bls12_g1_infinity();
    }
    let mut res: Bls12G1Point = bls12_g1_infinity();
    let mut base: Bls12G1Point = *p;
    let mut s: Int = scalar;
    while s > 0 {
        if (s & 1) == 1 {
            res = bls12_g1_add(&res, &base);
        }
        base = bls12_g1_double(&base);
        s = s >> 1;
    }
    return res;
}
