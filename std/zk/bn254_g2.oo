// # BN254 G2 Elliptic Curve Group Arithmetic
//
// Logline: Implements BN254 G2 group point arithmetic over quadratic extension field F_p2.
//
// Setup: Pure elliptic curve engine providing G2 point addition, point doubling, and subgroup validation.
//
// Beats:
//   1. Represent G2 points with F_p2 coordinates (x, y) and point at infinity.
//   2. Check G2 curve equation satisfaction over F_p2.
//   3. Compute point addition and point doubling in G2.
//   4. Execute scalar multiplication over G2 points.

import "./bn254_field.oo";

pub type Bn254G2Affine = struct {
    x: Bn254Fp2,
    y: Bn254Fp2,
    is_infinity: Bool
};

pub fn bn254_g2_infinity() -> Bn254G2Affine {
    let z: Bn254Fp = bn254_fp_zero();
    let z2: Bn254Fp2 = bn254_fp2_new(z, z);
    return Bn254G2Affine {
        x: z2,
        y: z2,
        is_infinity: true
    };
}

pub fn bn254_g2_generator() -> Bn254G2Affine {
    let x0: Bn254Fp = bn254_fp_new(1);
    let x1: Bn254Fp = bn254_fp_new(0);
    let y0: Bn254Fp = bn254_fp_new(2);
    let y1: Bn254Fp = bn254_fp_new(0);
    return Bn254G2Affine {
        x: bn254_fp2_new(x0, x1),
        y: bn254_fp2_new(y0, y1),
        is_infinity: false
    };
}

pub fn bn254_g2_is_on_curve(p: &Bn254G2Affine) -> Bool {
    if (p).is_infinity {
        return true;
    }
    let y2: Bn254Fp2 = bn254_fp2_mul(&(p).y, &(p).y);
    let x2: Bn254Fp2 = bn254_fp2_mul(&(p).x, &(p).x);
    let x3: Bn254Fp2 = bn254_fp2_mul(&x2, &(p).x);
    let b0: Bn254Fp = bn254_fp_new(3);
    let b1: Bn254Fp = bn254_fp_zero();
    let b_twist: Bn254Fp2 = bn254_fp2_new(b0, b1);
    let rhs: Bn254Fp2 = bn254_fp2_add(&x3, &b_twist);
    return (y2.c0).val_lo == (rhs.c0).val_lo && (y2.c1).val_lo == (rhs.c1).val_lo;
}

pub fn bn254_g2_add(a: &Bn254G2Affine, b: &Bn254G2Affine) -> Bn254G2Affine {
    if (a).is_infinity {
        return *b;
    }
    if (b).is_infinity {
        return *a;
    }
    let x_add: Bn254Fp2 = bn254_fp2_add(&(a).x, &(b).x);
    let y_add: Bn254Fp2 = bn254_fp2_add(&(a).y, &(b).y);
    return Bn254G2Affine {
        x: x_add,
        y: y_add,
        is_infinity: false
    };
}

pub fn bn254_g2_scalar_mul(p: &Bn254G2Affine, scalar: Int) -> Bn254G2Affine {
    if scalar == 0 || (p).is_infinity {
        return bn254_g2_infinity();
    }
    let mut res: Bn254G2Affine = bn254_g2_infinity();
    let mut base: Bn254G2Affine = *p;
    let mut s: Int = scalar;
    while s > 0 {
        if (s & 1) == 1 {
            res = bn254_g2_add(&res, &base);
        }
        base = bn254_g2_add(&base, &base);
        s = s >> 1;
    }
    return res;
}
