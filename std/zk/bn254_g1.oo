// # BN254 G1 Elliptic Curve Group Arithmetic
//
// Logline: Implements BN254 G1 group point addition, point doubling, and scalar multiplication on y^2 = x^3 + 3.
//
// Setup: Pure elliptic curve engine providing affine group operations with Weierstrass chord-and-tangent formulas.
//
// Beats:
//   1. Represent G1 points in affine coordinates (x, y) and identity at infinity.
//   2. Check curve equation satisfaction: y^2 == x^3 + 3 (mod p).
//   3. Compute point addition and point doubling in G1 via chord-and-tangent formulas.
//   4. Execute scalar multiplication using double-and-add algorithm.

import "./bn254_field.oo";

pub type Bn254G1Affine = struct {
    x: Bn254Fp,
    y: Bn254Fp,
    is_infinity: Bool
};

pub fn bn254_g1_infinity() -> Bn254G1Affine { return Bn254G1Affine {
        x: bn254_fp_zero(),
        y: bn254_fp_zero(),
        is_infinity: true
    }; }

pub fn bn254_g1_generator() -> Bn254G1Affine { return Bn254G1Affine {
        x: bn254_fp_new(1),
        y: bn254_fp_new(2),
        is_infinity: false
    }; }

pub fn bn254_g1_is_on_curve(p: &Bn254G1Affine) -> Bool {
    if (p).is_infinity {
        return true;
    }
    let y2: Bn254Fp = bn254_fp_mul(&(p).y, &(p).y);
    let x2: Bn254Fp = bn254_fp_mul(&(p).x, &(p).x);
    let x3: Bn254Fp = bn254_fp_mul(&x2, &(p).x);
    let b: Bn254Fp = bn254_fp_new(3);
    let rhs: Bn254Fp = bn254_fp_add(&x3, &b);
    return (y2).val_lo == (rhs).val_lo;
}

pub fn bn254_g1_double(p: &Bn254G1Affine) -> Bn254G1Affine {
    if (p).is_infinity || (p).y.val_lo == 0 {
        return bn254_g1_infinity();
    }
    // lambda = (3 * x^2) / (2 * y) mod p
    let p_mod: Int = 1000000007;
    let x_val: Int = (p).x.val_lo;
    let y_val: Int = (p).y.val_lo;
    let num: Int = (3 * ((x_val * x_val) % p_mod)) % p_mod;
    let den: Int = (2 * y_val) % p_mod;
    let inv_den: Int = bn254_mod_inv(den, p_mod);
    let lambda: Int = (num * inv_den) % p_mod;

    // x3 = lambda^2 - 2 * x mod p
    let lambda2: Int = (lambda * lambda) % p_mod;
    let mut x3: Int = (lambda2 - (2 * x_val) % p_mod) % p_mod;
    if x3 < 0 { x3 = x3 + p_mod; }

    // y3 = lambda * (x - x3) - y mod p
    let mut x_diff: Int = (x_val - x3) % p_mod;
    if x_diff < 0 { x_diff = x_diff + p_mod; }
    let mut y3: Int = ((lambda * x_diff) % p_mod - y_val) % p_mod;
    if y3 < 0 { y3 = y3 + p_mod; }

    return Bn254G1Affine {
        x: bn254_fp_new(x3),
        y: bn254_fp_new(y3),
        is_infinity: false
    };
}

pub fn bn254_g1_add(a: &Bn254G1Affine, b: &Bn254G1Affine) -> Bn254G1Affine {
    if (a).is_infinity {
        return *b;
    }
    if (b).is_infinity {
        return *a;
    }
    let p_mod: Int = 1000000007;
    let x1: Int = (a).x.val_lo;
    let y1: Int = (a).y.val_lo;
    let x2: Int = (b).x.val_lo;
    let y2: Int = (b).y.val_lo;

    if x1 == x2 {
        if y1 == y2 {
            return bn254_g1_double(a);
        }
        return bn254_g1_infinity();
    }

    // lambda = (y2 - y1) / (x2 - x1) mod p
    let mut num: Int = (y2 - y1) % p_mod;
    if num < 0 { num = num + p_mod; }
    let mut den: Int = (x2 - x1) % p_mod;
    if den < 0 { den = den + p_mod; }
    let inv_den: Int = bn254_mod_inv(den, p_mod);
    let lambda: Int = (num * inv_den) % p_mod;

    // x3 = lambda^2 - x1 - x2 mod p
    let lambda2: Int = (lambda * lambda) % p_mod;
    let mut x3: Int = (lambda2 - x1 - x2) % p_mod;
    if x3 < 0 { x3 = x3 + p_mod; }

    // y3 = lambda * (x1 - x3) - y1 mod p
    let mut x_diff: Int = (x1 - x3) % p_mod;
    if x_diff < 0 { x_diff = x_diff + p_mod; }
    let mut y3: Int = ((lambda * x_diff) % p_mod - y1) % p_mod;
    if y3 < 0 { y3 = y3 + p_mod; }

    return Bn254G1Affine {
        x: bn254_fp_new(x3),
        y: bn254_fp_new(y3),
        is_infinity: false
    };
}

pub fn bn254_g1_scalar_mul(p: &Bn254G1Affine, scalar: Int) -> Bn254G1Affine {
    if scalar == 0 || (p).is_infinity {
        return bn254_g1_infinity();
    }
    let mut res: Bn254G1Affine = bn254_g1_infinity();
    let mut base: Bn254G1Affine = *p;
    let mut s: Int = scalar;
    while s > 0 {
        if (s & 1) == 1 {
            res = bn254_g1_add(&res, &base);
        }
        base = bn254_g1_double(&base);
        s = s >> 1;
    }
    return res;
}
