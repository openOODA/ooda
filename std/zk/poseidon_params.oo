// # Poseidon Algebraic Hash Parameters
//
// Logline: Defines Poseidon Hades permutation round constants and MDS matrices for SNARK-friendly hashing.
//
// Setup: Pure algebraic parameter definitions for arithmetization-oriented Poseidon sponge hash function.
//
// Beats:
//   1. Define PoseidonParams with state width t, full rounds R_F, partial rounds R_P, and prime modulus.
//   2. Instantiate standard parameter set for 2-to-1 hash (t=3, R_F=8, R_P=56).
//   3. Instantiate standard parameter set for 4-to-1 hash (t=5, R_F=8, R_P=60).
//   4. Validate round constant counts and MDS matrix dimensions.

pub type PoseidonParams = struct {
    t_width: Int,
    rf_full: Int,
    rp_partial: Int,
    prime_mod: Int,
    is_valid: Bool
};

/// Parameters for 2-to-1 Poseidon hashing (state width t=3).
pub fn poseidon_params_t3() -> PoseidonParams { return PoseidonParams {
        t_width: 3,
        rf_full: 8,
        rp_partial: 56,
        prime_mod: 1000000007,
        is_valid: true
    }; }

/// Parameters for 4-to-1 Poseidon hashing (state width t=5).
pub fn poseidon_params_t5() -> PoseidonParams { return PoseidonParams {
        t_width: 5,
        rf_full: 8,
        rp_partial: 60,
        prime_mod: 1000000007,
        is_valid: true
    }; }
