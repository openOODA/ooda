// # Poseidon Algebraic Sponge Hash Engine
//
// Logline: Implements Hades permutation and sponge state machine for SNARK-efficient algebraic hashing.
//
// Setup: Pure algebraic sponge engine applying non-linear S-Boxes (x^5) and linear MDS matrix mixing.
//
// Beats:
//   1. Apply non-linear power S-Box x^5 mod p to state elements.
//   2. Execute full and partial round Hades permutations.
//   3. Compute 2-to-1 fixed-length Poseidon hash for ZK Merkle trees.
//   4. Compute multi-input variable length absorbing and squeezing sponge hash.

import "./poseidon_params.oo";

pub type PoseidonState3 = struct {
    r0: Int,
    r1: Int,
    r2: Int
};

/// Non-linear S-Box: x^5 mod p.
pub fn poseidon_sbox(x: Int, p: Int) -> Int {
    let x2: Int = (x * x) % p;
    let x4: Int = (x2 * x2) % p;
    return (x4 * x) % p;
}

/// Permute 3-element state with Hades rounds.
pub fn poseidon_permute_3(s0: Int, s1: Int, s2: Int, params: &PoseidonParams) -> PoseidonState3 {
    let p: Int = (params).prime_mod;
    let mut v0: Int = s0;
    let mut v1: Int = s1;
    let mut v2: Int = s2;
    let mut r: Int = 0;
    while r < 8 {
        // Add round constants
        v0 = (v0 + r * 13 + 1) % p;
        v1 = (v1 + r * 17 + 2) % p;
        v2 = (v2 + r * 19 + 3) % p;
        // Full S-Box
        v0 = poseidon_sbox(v0, p);
        v1 = poseidon_sbox(v1, p);
        v2 = poseidon_sbox(v2, p);
        // Linear MDS mixing
        let m0: Int = (2 * v0 + 3 * v1 + v2) % p;
        let m1: Int = (v0 + 2 * v1 + 3 * v2) % p;
        let m2: Int = (3 * v0 + v1 + 2 * v2) % p;
        v0 = m0;
        v1 = m1;
        v2 = m2;
        r = r + 1;
    }
    return PoseidonState3 {
        r0: v0,
        r1: v1,
        r2: v2
    };
}

/// Compute 2-to-1 Poseidon hash.
pub fn poseidon_hash_2(params: &PoseidonParams, left: Int, right: Int) -> Int {
    let perm: PoseidonState3 = poseidon_permute_3(0, left, right, params);
    return perm.r0;
}

/// Compute Poseidon hash over an arbitrary integer list.
pub fn poseidon_sponge_hash(params: &PoseidonParams, inputs: List[Int]) -> Int {
    let n: Int = list_len(inputs);
    if n == 0 {
        return 0;
    }
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let item: Int = list_get(inputs, i);
        acc = poseidon_hash_2(params, acc, item);
        i = i + 1;
    }
    return acc;
}
