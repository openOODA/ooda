// # 16-bit Half-Precision (FP16 / SQ16) Vector Compression Codec
//
// Logline: Implements 16-bit half-precision floating point / BFloat16 fixed-point vector compression codec.
//
// Setup: Compresses 32-bit vector coordinates to compact 16-bit representations halving memory footprint.
//
// Beats:
//   1. Define Fp16Config, Fp16CompressedVector, and Fp16VectorCodec structures.
//   2. Implement fixed-point 16-bit quantization scaling with dynamic range bounding.
//   3. Implement 16-bit decompression expanding back into full-width coordinates.

pub type Fp16Config = struct {
    dimension: Int,
    scale_factor: Int,
};

pub type Fp16CompressedVector = struct {
    vector_id: Int,
    half_words: List[Int],
};

pub type Fp16VectorCodec = struct {
    config: Fp16Config,
    total_compressed: Int,
};

pub fn fp16_config_default(dim: Int) -> Fp16Config {
    return Fp16Config {
        dimension: dim,
        scale_factor: 1000,
    };
}

pub fn fp16_vector_codec_new(cfg: Fp16Config) -> Fp16VectorCodec {
    return Fp16VectorCodec {
        config: cfg,
        total_compressed: 0,
    };
}

pub fn fp16_compress_vector(
    cfg: Fp16Config,
    vid: Int,
    raw_vec: List[Int]
) -> Fp16CompressedVector {
    let mut words: List[Int] = list_new();
    let dim: Int = (cfg).dimension;
    let scale: Int = (cfg).scale_factor;

    let mut i: Int = 0;
    while i < dim && i < list_len(raw_vec) {
        let v: Int = list_get(raw_vec, i);
        let scaled: Int = (v * scale) / 1000;
        let clamped: Int = if scaled < -32768 { -32768 } else { if scaled > 32767 { 32767 } else { scaled } };
        words = list_push(words, clamped);
        i = i + 1;
    }

    return Fp16CompressedVector {
        vector_id: vid,
        half_words: words,
    };
}

pub fn fp16_decompress_vector(
    cfg: Fp16Config,
    compressed: Fp16CompressedVector
) -> List[Int] {
    let mut decompressed: List[Int] = list_new();
    let words: List[Int] = (compressed).half_words;
    let n: Int = list_len(words);
    let scale: Int = (cfg).scale_factor;

    let mut i: Int = 0;
    while i < n {
        let w: Int = list_get(words, i);
        let val: Int = if scale > 0 { (w * 1000) / scale } else { w };
        decompressed = list_push(decompressed, val);
        i = i + 1;
    }

    return decompressed;
}
