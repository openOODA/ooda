// # DiskANN In-Memory Compressed Vector Cache
//
// Logline: Implements in-memory compressed vector cache and fast candidate distance lookup for DiskANN.
//
// Setup: Manages compressed vector codes in RAM to quickly filter candidate nodes before issuing SSD random reads.
//
// Beats:
//   1. Define CompressedCacheConfig, CompressedVectorEntry, and DiskannCacheManager structures.
//   2. Implement vector cache lookup and asymmetric distance estimation.
//   3. Implement cache hit/miss accounting and cache eviction policies.

pub type CompressedCacheConfig = struct {
    max_cached_entries: Int,
    code_byte_width: Int,
    eviction_threshold_percent: Int
};

pub type CompressedVectorEntry = struct {
    vector_id: Int,
    compressed_codes: List[Int],
    access_timestamp: Int,
    is_valid: Bool
};

pub type DiskannCacheManager = struct {
    config: CompressedCacheConfig,
    entries: List[CompressedVectorEntry],
    cache_hits: Int,
    cache_misses: Int,
    current_time: Int
};

pub fn compressed_cache_config_default() -> CompressedCacheConfig {
    return CompressedCacheConfig {
        max_cached_entries: 65536,
        code_byte_width: 32,
        eviction_threshold_percent: 90
    };
}

pub fn diskann_cache_manager_new(cfg: CompressedCacheConfig) -> DiskannCacheManager {
    return DiskannCacheManager {
        config: cfg,
        entries: list_new(),
        cache_hits: 0,
        cache_misses: 0,
        current_time: 0
    };
}

pub fn diskann_cache_put(
    mgr: DiskannCacheManager,
    vid: Int,
    codes: List[Int]
) -> DiskannCacheManager {
    let now: Int = (mgr).current_time + 1;
    let entry: CompressedVectorEntry = CompressedVectorEntry {
        vector_id: vid,
        compressed_codes: codes,
        access_timestamp: now,
        is_valid: true
    };
    let mut updated_entries: List[CompressedVectorEntry] = (mgr).entries;
    updated_entries = list_push(updated_entries, entry);

    return DiskannCacheManager {
        config: (mgr).config,
        entries: updated_entries,
        cache_hits: (mgr).cache_hits,
        cache_misses: (mgr).cache_misses,
        current_time: now
    };
}

pub fn diskann_cache_get_codes(
    mgr: DiskannCacheManager,
    vid: Int
) -> List[Int] {
    let entries: List[CompressedVectorEntry] = (mgr).entries;
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        let entry: CompressedVectorEntry = list_get(entries, i);
        if (entry).vector_id == vid && (entry).is_valid {
            return (entry).compressed_codes;
        }
        i = i + 1;
    }
    return list_new();
}

pub fn diskann_cache_estimate_distance(
    query_codes: List[Int],
    target_codes: List[Int]
) -> Int {
    let n_q: Int = list_len(query_codes);
    let n_t: Int = list_len(target_codes);
    let min_len: Int = if n_q < n_t { n_q } else { n_t };

    let mut dist_accum: Int = 0;
    let mut i: Int = 0;
    while i < min_len {
        let diff: Int = list_get(query_codes, i) - list_get(target_codes, i);
        dist_accum = dist_accum + (diff * diff);
        i = i + 1;
    }
    return dist_accum;
}
