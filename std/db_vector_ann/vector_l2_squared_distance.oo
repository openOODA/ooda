// # Vector L2 Squared Euclidean Distance Kernel
//
// Logline: Implements Euclidean L2 squared distance metric computation with early truncation threshold.
//
// Setup: Computes exact Euclidean distance between dense vectors with early exit when running sum exceeds cutoff.
//
// Beats:
//   1. Define L2MetricConfig, L2DistanceResult, and VectorL2Evaluator structures.
//   2. Implement vector L2 squared difference summation kernel.
//   3. Implement early truncation optimization for bounded candidate queue pruning.

pub type L2MetricConfig = struct {
    dimension: Int,
    enable_early_exit: Bool,
};

pub type L2DistanceResult = struct {
    distance_squared: Int,
    is_truncated: Bool,
    dimensions_evaluated: Int,
};

pub type VectorL2Evaluator = struct {
    config: L2MetricConfig,
    total_evaluations: Int,
};

pub fn l2_metric_config_default(dim: Int) -> L2MetricConfig {
    return L2MetricConfig {
        dimension: dim,
        enable_early_exit: true,
    };
}

pub fn vector_l2_evaluator_new(cfg: L2MetricConfig) -> VectorL2Evaluator {
    return VectorL2Evaluator {
        config: cfg,
        total_evaluations: 0,
    };
}

pub fn compute_l2_squared_distance(
    vec_a: List[Int],
    vec_b: List[Int]
) -> Int {
    let dim: Int = list_len(vec_a);
    let mut sum_sq: Int = 0;
    let mut i: Int = 0;

    while i < dim && i < list_len(vec_b) {
        let diff: Int = list_get(vec_a, i) - list_get(vec_b, i);
        sum_sq = sum_sq + (diff * diff);
        i = i + 1;
    }

    return sum_sq;
}

pub fn compute_l2_with_threshold(
    vec_a: List[Int],
    vec_b: List[Int],
    threshold_sq: Int
) -> L2DistanceResult {
    let dim: Int = list_len(vec_a);
    let mut sum_sq: Int = 0;
    let mut i: Int = 0;
    let mut early_exit: Bool = false;

    while i < dim && i < list_len(vec_b) && !early_exit {
        let diff: Int = list_get(vec_a, i) - list_get(vec_b, i);
        sum_sq = sum_sq + (diff * diff);
        if sum_sq > threshold_sq {
            early_exit = true;
        }
        i = i + 1;
    }

    return L2DistanceResult {
        distance_squared: sum_sq,
        is_truncated: early_exit,
        dimensions_evaluated: i,
    };
}
