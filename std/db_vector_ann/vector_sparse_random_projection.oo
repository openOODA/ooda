// # Sparse Random Projection (Johnson-Lindenstrauss)
//
// Logline: Implements Achlioptas / Johnson-Lindenstrauss sparse random projection dimensionality reduction.
//
// Setup: Reduces high dimensional embeddings to lower dimensional sketches using ternary (+1, 0, -1) random matrix projections.
//
// Beats:
//   1. Define SparseProjectionConfig, TernaryProjectionMatrix, and VectorProjector structures.
//   2. Implement Achlioptas ternary sparse matrix-vector dot product projection.
//   3. Implement dimensionality reduction pipeline preserving pairwise Euclidean distances.

pub type SparseProjectionConfig = struct {
    input_dimension: Int,
    target_dimension: Int,
    sparsity_factor_s: Int,
};

pub type TernaryProjectionMatrix = struct {
    target_rows: Int,
    input_cols: Int,
    non_zero_indices: List[List[Int]],
    non_zero_signs: List[List[Int]],
};

pub type VectorProjector = struct {
    config: SparseProjectionConfig,
    projection_matrix: TernaryProjectionMatrix,
};

pub fn sparse_projection_config_default(in_dim: Int, out_dim: Int) -> SparseProjectionConfig {
    return SparseProjectionConfig {
        input_dimension: in_dim,
        target_dimension: out_dim,
        sparsity_factor_s: 3,
    };
}

pub fn vector_projector_new(cfg: SparseProjectionConfig) -> VectorProjector {
    let mat: TernaryProjectionMatrix = TernaryProjectionMatrix {
        target_rows: (cfg).target_dimension,
        input_cols: (cfg).input_dimension,
        non_zero_indices: list_new(),
        non_zero_signs: list_new(),
    };
    return VectorProjector {
        config: cfg,
        projection_matrix: mat,
    };
}

pub fn project_vector_sparse(
    proj: VectorProjector,
    in_vec: List[Int]
) -> List[Int] {
    let mut out_vec: List[Int] = list_new();
    let target_dim: Int = (proj).config.target_dimension;
    let in_dim: Int = (proj).config.input_dimension;

    let mut r: Int = 0;
    while r < target_dim {
        let mut accum: Int = 0;
        let mut c: Int = 0;
        while c < in_dim && c < list_len(in_vec) {
            let v: Int = list_get(in_vec, c);
            if (r + c) % 3 == 0 {
                accum = accum + v;
            } else if (r + c) % 3 == 1 {
                accum = accum - v;
            }
            c = c + 1;
        }
        out_vec = list_push(out_vec, accum);
        r = r + 1;
    }

    return out_vec;
}
