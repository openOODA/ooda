// # ACORN Attribute-Constrained Graph Traversal Engine
//
// Logline: Implements ACORN (Attribute-Constrained Graph-based ANN) graph traversal with predicate pruning.
//
// Setup: Enhances graph neighbor connections with 2-hop attribute bridging to navigate sparse filtered sub-graphs.
//
// Beats:
//   1. Define AcornConfig, AcornPredicateTag, and AcornGraphNode structures.
//   2. Implement 2-hop neighbor expansion bridging nodes sharing common attribute tags.
//   3. Implement attribute-constrained greedy walk avoiding disconnected dead-ends.

pub type AcornConfig = struct {
    max_hybrid_degree: Int,
    search_ef: Int,
    gamma_bridge_depth: Int
};

pub type AcornPredicateTag = struct {
    tag_id: Int,
    tag_value: Int
};

pub type AcornGraphNode = struct {
    node_id: Int,
    primary_neighbors: List[Int],
    attribute_tags: List[AcornPredicateTag]
};

pub type AcornGraph = struct {
    config: AcornConfig,
    nodes: List[AcornGraphNode],
    total_nodes: Int
};

pub fn acorn_config_default() -> AcornConfig {
    return AcornConfig {
        max_hybrid_degree: 48,
        search_ef: 64,
        gamma_bridge_depth: 2
    };
}

pub fn acorn_graph_new(cfg: AcornConfig) -> AcornGraph {
    return AcornGraph {
        config: cfg,
        nodes: list_new(),
        total_nodes: 0
    };
}

pub fn acorn_node_has_tag(node: AcornGraphNode, target_tag: AcornPredicateTag) -> Bool {
    let tags: List[AcornPredicateTag] = (node).attribute_tags;
    let n: Int = list_len(tags);
    let mut i: Int = 0;
    while i < n {
        let t: AcornPredicateTag = list_get(tags, i);
        if (t).tag_id == (target_tag).tag_id && (t).tag_value == (target_tag).tag_value {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn acorn_collect_matching_neighbors(
    graph: AcornGraph,
    node_id: Int,
    tag: AcornPredicateTag
) -> List[Int] {
    let mut matching: List[Int] = list_new();
    let all_nodes: List[AcornGraphNode] = (graph).nodes;

    if node_id >= 0 && node_id < list_len(all_nodes) {
        let curr: AcornGraphNode = list_get(all_nodes, node_id);
        let nbrs: List[Int] = (curr).primary_neighbors;
        let n: Int = list_len(nbrs);
        let mut i: Int = 0;
        while i < n {
            let n_id: Int = list_get(nbrs, i);
            if n_id >= 0 && n_id < list_len(all_nodes) {
                let n_node: AcornGraphNode = list_get(all_nodes, n_id);
                if acorn_node_has_tag(n_node, tag) {
                    matching = list_push(matching, n_id);
                }
            }
            i = i + 1;
        }
    }

    return matching;
}
