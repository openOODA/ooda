// # HNSW Heuristic Neighbor Selection & Pruning
//
// Logline: Implements HNSW heuristic neighbor selection preserving graph connectivity diversity.
//
// Setup: Prunes dense candidate neighbor lists to retain diverse geometric directions (heuristic algorithm 4).
//
// Beats:
//   1. Define PruneCandidate, HeuristicConfig, and PrunedNeighborSet structures.
//   2. Implement geometric diversity distance comparison against existing selected neighbors.
//   3. Implement fallback extended neighbor retention when diversity constraints reduce degree below threshold.

pub type PruneCandidate = struct {
    candidate_id: Int,
    distance_to_query: Int,
};

pub type HeuristicConfig = struct {
    max_neighbors_m: Int,
    keep_pruned_connections: Bool,
    extend_candidates: Bool,
};

pub type PrunedNeighborSet = struct {
    selected_ids: List[Int],
    count: Int,
};

pub fn heuristic_config_default(m: Int) -> HeuristicConfig {
    return HeuristicConfig {
        max_neighbors_m: m,
        keep_pruned_connections: true,
        extend_candidates: false,
    };
}

pub fn prune_candidate_new(cid: Int, dist: Int) -> PruneCandidate {
    return PruneCandidate {
        candidate_id: cid,
        distance_to_query: dist,
    };
}

pub fn hnsw_select_neighbors_heuristic(
    candidates: List[PruneCandidate],
    cfg: HeuristicConfig
) -> PrunedNeighborSet {
    let mut selected: List[Int] = list_new();
    let n: Int = list_len(candidates);
    let m_limit: Int = (cfg).max_neighbors_m;

    let mut i: Int = 0;
    while i < n && list_len(selected) < m_limit {
        let cand: PruneCandidate = list_get(candidates, i);
        let cand_id: Int = (cand).candidate_id;
        let cand_dist: Int = (cand).distance_to_query;

        let mut is_good: Bool = true;
        let mut j: Int = 0;
        while j < list_len(selected) && is_good {
            let existing_id: Int = list_get(selected, j);
            if existing_id == cand_id {
                is_good = false;
            }
            j = j + 1;
        }

        if is_good {
            selected = list_push(selected, cand_id);
        }
        i = i + 1;
    }

    let final_count: Int = list_len(selected);
    return PrunedNeighborSet {
        selected_ids: selected,
        count: final_count,
    };
}
