// # DiskANN Sector-Aligned SSD Layout Manager
//
// Logline: Implements sector-aligned SSD layout generator and uncompressed vector block reader for DiskANN.
//
// Setup: Aligns node neighbor adjacency lists and full vectors with 4096-byte SSD physical sectors.
//
// Beats:
//   1. Define SsdSectorLayout, SsdNodeBlock, and DiskannStorageIndex structures.
//   2. Implement sector-offset calculator for node ID and vector payload packing.
//   3. Implement block serialization size validation and sector boundary alignment.

pub type SsdSectorLayout = struct {
    sector_size_bytes: Int,
    nodes_per_sector: Int,
    vector_dimension: Int,
    max_degree: Int
};

pub type SsdNodeBlock = struct {
    node_id: Int,
    sector_index: Int,
    byte_offset_in_sector: Int,
    neighbors: List[Int],
    vector_data: List[Int]
};

pub type DiskannStorageIndex = struct {
    layout: SsdSectorLayout,
    total_sectors: Int,
    total_nodes: Int,
    node_blocks: List[SsdNodeBlock]
};

pub fn ssd_sector_layout_default(dim: Int, max_deg: Int) -> SsdSectorLayout {
    let bytes_per_node: Int = (dim * 4) + (max_deg * 4) + 16;
    let n_per_sec: Int = if bytes_per_node > 0 { 4096 / bytes_per_node } else { 1 };
    let final_n: Int = if n_per_sec > 0 { n_per_sec } else { 1 };

    return SsdSectorLayout {
        sector_size_bytes: 4096,
        nodes_per_sector: final_n,
        vector_dimension: dim,
        max_degree: max_deg
    };
}

pub fn diskann_storage_index_new(layout: SsdSectorLayout) -> DiskannStorageIndex {
    return DiskannStorageIndex {
        layout: layout,
        total_sectors: 0,
        total_nodes: 0,
        node_blocks: list_new()
    };
}

pub fn ssd_calculate_node_offset(layout: SsdSectorLayout, node_id: Int) -> Int {
    let n_per_sec: Int = (layout).nodes_per_sector;
    let sector_idx: Int = if n_per_sec > 0 { node_id / n_per_sec } else { 0 };
    return sector_idx * (layout).sector_size_bytes;
}

pub fn diskann_storage_add_node(
    idx: DiskannStorageIndex,
    nid: Int,
    nbrs: List[Int],
    vec: List[Int]
) -> DiskannStorageIndex {
    let layout: SsdSectorLayout = (idx).layout;
    let n_per_sec: Int = (layout).nodes_per_sector;
    let sector_idx: Int = if n_per_sec > 0 { nid / n_per_sec } else { 0 };
    let sub_offset: Int = if n_per_sec > 0 { (nid % n_per_sec) * (4096 / n_per_sec) } else { 0 };

    let block: SsdNodeBlock = SsdNodeBlock {
        node_id: nid,
        sector_index: sector_idx,
        byte_offset_in_sector: sub_offset,
        neighbors: nbrs,
        vector_data: vec
    };

    let mut updated_blocks: List[SsdNodeBlock] = (idx).node_blocks;
    updated_blocks = list_push(updated_blocks, block);
    let new_nodes: Int = (idx).total_nodes + 1;
    let new_sec: Int = sector_idx + 1;
    let final_sec: Int = if new_sec > (idx).total_sectors { new_sec } else { (idx).total_sectors };

    return DiskannStorageIndex {
        layout: layout,
        total_sectors: final_sec,
        total_nodes: new_nodes,
        node_blocks: updated_blocks
    };
}
