// # Uniform Scalar Quantization (SQ8/SQ4) Codec
//
// Logline: Implements uniform Scalar Quantization (SQ8/SQ4) mapping continuous vector components into discrete integer bins.
//
// Setup: Compresses vectors 4x-8x by maintaining per-vector or per-dataset minimum and maximum dimension scale bounds.
//
// Beats:
//   1. Define SqConfig, QuantizedVector, and ScalarQuantizer structures.
//   2. Implement linear min-max quantization encoding for 8-bit discrete bins.
//   3. Implement fast asymmetric scalar product estimation and reconstruction decoding.

pub type SqConfig = struct {
    num_bits: Int,
    dimension: Int,
    scale_factor: Int,
};

pub type QuantizedVector = struct {
    vector_id: Int,
    min_val: Int,
    max_val: Int,
    quantized_bytes: List[Int],
};

pub type ScalarQuantizer = struct {
    config: SqConfig,
    total_encoded: Int,
};

pub fn sq_config_default(dim: Int, bits: Int) -> SqConfig {
    return SqConfig {
        num_bits: bits,
        dimension: dim,
        scale_factor: 255,
    };
}

pub fn scalar_quantizer_new(cfg: SqConfig) -> ScalarQuantizer {
    return ScalarQuantizer {
        config: cfg,
        total_encoded: 0,
    };
}

pub fn sq_encode_vector(
    cfg: SqConfig,
    vid: Int,
    raw_vec: List[Int]
) -> QuantizedVector {
    let dim: Int = list_len(raw_vec);
    let mut min_v: Int = 2147483647;
    let mut max_v: Int = -2147483648;

    let mut i: Int = 0;
    while i < dim {
        let v: Int = list_get(raw_vec, i);
        if v < min_v {
            min_v = v;
        }
        if v > max_v {
            max_v = v;
        }
        i = i + 1;
    }

    let range_v: Int = if (max_v - min_v) > 0 { max_v - min_v } else { 1 };
    let mut bytes_list: List[Int] = list_new();

    let mut j: Int = 0;
    while j < dim {
        let v: Int = list_get(raw_vec, j);
        let normalized: Int = ((v - min_v) * (cfg).scale_factor) / range_v;
        let clamped: Int = if normalized < 0 { 0 } else { if normalized > (cfg).scale_factor { (cfg).scale_factor } else { normalized } };
        bytes_list = list_push(bytes_list, clamped);
        j = j + 1;
    }

    return QuantizedVector {
        vector_id: vid,
        min_val: min_v,
        max_val: max_v,
        quantized_bytes: bytes_list,
    };
}

pub fn sq_decode_vector(
    cfg: SqConfig,
    qvec: QuantizedVector
) -> List[Int] {
    let mut reconstructed: List[Int] = list_new();
    let bytes_list: List[Int] = (qvec).quantized_bytes;
    let min_v: Int = (qvec).min_val;
    let max_v: Int = (qvec).max_val;
    let range_v: Int = if (max_v - min_v) > 0 { max_v - min_v } else { 1 };
    let n: Int = list_len(bytes_list);

    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(bytes_list, i);
        let val: Int = min_v + ((b * range_v) / (cfg).scale_factor);
        reconstructed = list_push(reconstructed, val);
        i = i + 1;
    }

    return reconstructed;
}
