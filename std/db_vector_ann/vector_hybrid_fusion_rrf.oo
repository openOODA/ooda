// # Vector Hybrid Fusion & Reciprocal Rank Fusion (RRF)
//
// Logline: Implements Reciprocal Rank Fusion (RRF) and Convex Score Combination for BM25 + Vector ANN.
//
// Setup: Combines ranked lists from dense vector indexes and sparse keyword retrievers into a unified top-k list.
//
// Beats:
//   1. Define RrfConfig, RankedCandidate, and HybridFusionResult structures.
//   2. Implement reciprocal rank formula score accumulation.
//   3. Implement weighted linear combination fusing normalized dense and sparse scores.

pub type RrfConfig = struct {
    k_constant: Int,
    scale_multiplier: Int,
    dense_weight_percent: Int,
};

pub type RankedCandidate = struct {
    doc_id: Int,
    rank_index: Int,
    raw_score: Int,
};

pub type HybridFusionResult = struct {
    doc_id: Int,
    fused_score: Int,
};

pub fn rrf_config_default() -> RrfConfig {
    return RrfConfig {
        k_constant: 60,
        scale_multiplier: 100000,
        dense_weight_percent: 50,
    };
}

pub fn compute_rrf_single_rank(rank_idx: Int, k_const: Int, scale: Int) -> Int {
    let denom: Int = k_const + rank_idx + 1;
    return if denom > 0 { scale / denom } else { 0 };
}

pub fn rrf_fuse_rankings(
    dense_candidates: List[RankedCandidate],
    sparse_candidates: List[RankedCandidate],
    cfg: RrfConfig
) -> List[HybridFusionResult] {
    let mut fused: List[HybridFusionResult] = list_new();
    let n_dense: Int = list_len(dense_candidates);
    let n_sparse: Int = list_len(sparse_candidates);
    let k_const: Int = (cfg).k_constant;
    let scale: Int = (cfg).scale_multiplier;

    let mut i: Int = 0;
    while i < n_dense {
        let dc: RankedCandidate = list_get(dense_candidates, i);
        let doc: Int = (dc).doc_id;
        let mut rrf_score: Int = compute_rrf_single_rank((dc).rank_index, k_const, scale);

        let mut j: Int = 0;
        while j < n_sparse {
            let sc: RankedCandidate = list_get(sparse_candidates, j);
            if (sc).doc_id == doc {
                rrf_score = rrf_score + compute_rrf_single_rank((sc).rank_index, k_const, scale);
            }
            j = j + 1;
        }

        let res: HybridFusionResult = HybridFusionResult {
            doc_id: doc,
            fused_score: rrf_score,
        };
        fused = list_push(fused, res);
        i = i + 1;
    }

    return fused;
}
