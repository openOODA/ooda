// # Vector Write-Ahead Log (WAL) & Crash Recovery
//
// Logline: Implements Vector WAL journal and crash-recovery checkpoint manager for dynamic indexes.
//
// Setup: Records append and delete operations with sequential LSNs for durable vector transaction recovery.
//
// Beats:
//   1. Define WalRecord, CheckpointMetadata, and VectorWalEngine structures.
//   2. Implement WAL record encoding and sequential LSN assignment.
//   3. Implement crash replay iterating uncheckpointed log records.

pub type WalRecord = struct {
    lsn: Int,
    op_type: Int,
    vector_id: Int,
    payload_data: List[Int]
};

pub type CheckpointMetadata = struct {
    last_checkpoint_lsn: Int,
    timestamp: Int
};

pub type VectorWalEngine = struct {
    current_lsn: Int,
    records: List[WalRecord],
    checkpoint: CheckpointMetadata
};

pub fn vector_wal_engine_new() -> VectorWalEngine {
    let cp: CheckpointMetadata = CheckpointMetadata {
        last_checkpoint_lsn: 0,
        timestamp: 0
    };
    return VectorWalEngine {
        current_lsn: 0,
        records: list_new(),
        checkpoint: cp
    };
}

pub fn wal_append_insert(
    engine: VectorWalEngine,
    vid: Int,
    vec: List[Int]
) -> VectorWalEngine {
    let next_lsn: Int = (engine).current_lsn + 1;
    let rec: WalRecord = WalRecord {
        lsn: next_lsn,
        op_type: 1,
        vector_id: vid,
        payload_data: vec
    };

    let mut recs: List[WalRecord] = (engine).records;
    recs = list_push(recs, rec);

    return VectorWalEngine {
        current_lsn: next_lsn,
        records: recs,
        checkpoint: (engine).checkpoint
    };
}

pub fn wal_get_uncheckpointed_records(
    engine: VectorWalEngine
) -> List[WalRecord] {
    let mut uncheckpointed: List[WalRecord] = list_new();
    let cp_lsn: Int = (engine).checkpoint.last_checkpoint_lsn;
    let recs: List[WalRecord] = (engine).records;
    let n: Int = list_len(recs);

    let mut i: Int = 0;
    while i < n {
        let rec: WalRecord = list_get(recs, i);
        if (rec).lsn > cp_lsn {
            uncheckpointed = list_push(uncheckpointed, rec);
        }
        i = i + 1;
    }

    return uncheckpointed;
}
