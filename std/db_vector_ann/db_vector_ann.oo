pub fn db_vector_ann_vamana_default() -> VamanaGraph {
    return vamana_graph_new(vamana_config_default());
}

pub fn db_vector_ann_hnsw_default() -> HnswIndex {
    return hnsw_index_new(hnsw_config_default());
}

pub fn db_vector_ann_ivf_default(k: Int, dim: Int) -> IvfCoarseQuantizer {
    return ivf_coarse_quantizer_new(ivf_cluster_config_default(k, dim));
}

pub fn db_vector_ann_flat_default(dim: Int) -> FlatVectorStore {
    return flat_vector_store_new(exact_scan_config_default(dim));
}

pub fn db_vector_ann_security_policy_default() -> VectorSecurityPolicy {
    return vector_security_policy_default();
}

pub fn db_vector_ann_metrics_default() -> VectorAnnEngineMetrics {
    return vector_ann_engine_metrics_new();
}
