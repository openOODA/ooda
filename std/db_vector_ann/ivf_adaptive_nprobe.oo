// # IVF Adaptive Nprobe Query Router
//
// Logline: Implements dynamic nprobe query router adjusting Voronoi cell exploration based on target recall.
//
// Setup: Adapts candidate cluster probes dynamically based on query density and latency budget.
//
// Beats:
//   1. Define AdaptiveProbeConfig, ProbeRoutingDecision, and AdaptiveProbeRouter structures.
//   2. Implement density-aware probe expansion scaling nprobe for sparse query regions.
//   3. Implement recall SLA target budget enforcement.

pub type AdaptiveProbeConfig = struct {
    min_nprobe: Int,
    max_nprobe: Int,
    target_recall_percent: Int,
    distance_spread_threshold: Int
};

pub type ProbeRoutingDecision = struct {
    query_id: Int,
    selected_nprobe: Int,
    confidence_score: Int
};

pub type AdaptiveProbeRouter = struct {
    config: AdaptiveProbeConfig,
    total_routed_queries: Int
};

pub fn adaptive_probe_config_default() -> AdaptiveProbeConfig {
    return AdaptiveProbeConfig {
        min_nprobe: 4,
        max_nprobe: 64,
        target_recall_percent: 95,
        distance_spread_threshold: 150
    };
}

pub fn adaptive_probe_router_new(cfg: AdaptiveProbeConfig) -> AdaptiveProbeRouter {
    return AdaptiveProbeRouter {
        config: cfg,
        total_routed_queries: 0
    };
}

pub fn ivf_route_adaptive_nprobe(
    router: AdaptiveProbeRouter,
    qid: Int,
    centroid_distances: List[Int]
) -> ProbeRoutingDecision {
    let cfg: AdaptiveProbeConfig = (router).config;
    let n_dists: Int = list_len(centroid_distances);

    if n_dists < 2 {
        return ProbeRoutingDecision {
            query_id: qid,
            selected_nprobe: (cfg).min_nprobe,
            confidence_score: 100
        };
    }

    let d0: Int = list_get(centroid_distances, 0);
    let d1: Int = list_get(centroid_distances, 1);
    let spread: Int = if (d1 - d0) >= 0 { d1 - d0 } else { d0 - d1 };

    let calculated_nprobe: Int = if spread < (cfg).distance_spread_threshold {
        (cfg).max_nprobe
    } else {
        (cfg).min_nprobe
    };

    let clamped_nprobe: Int = if calculated_nprobe > n_dists { n_dists } else { calculated_nprobe };

    return ProbeRoutingDecision {
        query_id: qid,
        selected_nprobe: clamped_nprobe,
        confidence_score: 90
    };
}
