// # HNSW Dynamic Updates & Tombstone Manager
//
// Logline: Implements HNSW dynamic vector insertion, live edge repair, and soft-delete/tombstoning.
//
// Setup: Supports real-time streaming updates, tombstone tracking, and dynamic neighbor reconnection.
//
// Beats:
//   1. Define TombstoneTable, DynamicUpdateRecord, and DynamicHnswTracker structures.
//   2. Implement soft-delete tombstoning and edge bridging around deleted nodes.
//   3. Implement live index health evaluation and tombstone cleanup triggers.

pub type TombstoneTable = struct {
    tombstoned_ids: List[Int],
    count: Int
};

pub type DynamicUpdateRecord = struct {
    op_type: Int,
    node_id: Int,
    timestamp: Int
};

pub type DynamicHnswTracker = struct {
    tombstones: TombstoneTable,
    update_log: List[DynamicUpdateRecord],
    total_live_nodes: Int,
    total_deleted_nodes: Int
};

pub fn tombstone_table_new() -> TombstoneTable {
    return TombstoneTable {
        tombstoned_ids: list_new(),
        count: 0
    };
}

pub fn dynamic_hnsw_tracker_new() -> DynamicHnswTracker {
    return DynamicHnswTracker {
        tombstones: tombstone_table_new(),
        update_log: list_new(),
        total_live_nodes: 0,
        total_deleted_nodes: 0
    };
}

pub fn hnsw_mark_deleted(tracker: DynamicHnswTracker, node_id: Int, now: Int) -> DynamicHnswTracker {
    let mut current_tombstones: List[Int] = (tracker).tombstones.tombstoned_ids;
    let mut already_deleted: Bool = false;
    let n: Int = list_len(current_tombstones);

    let mut i: Int = 0;
    while i < n {
        if list_get(current_tombstones, i) == node_id {
            already_deleted = true;
        }
        i = i + 1;
    }

    if !already_deleted {
        current_tombstones = list_push(current_tombstones, node_id);
    }

    let rec: DynamicUpdateRecord = DynamicUpdateRecord {
        op_type: 2,
        node_id: node_id,
        timestamp: now
    };

    let mut log_list: List[DynamicUpdateRecord] = (tracker).update_log;
    log_list = list_push(log_list, rec);

    let new_tomb_table: TombstoneTable = TombstoneTable {
        tombstoned_ids: current_tombstones,
        count: list_len(current_tombstones)
    };

    let new_live: Int = if (tracker).total_live_nodes > 0 { (tracker).total_live_nodes - 1 } else { 0 };
    let new_deleted: Int = (tracker).total_deleted_nodes + 1;

    return DynamicHnswTracker {
        tombstones: new_tomb_table,
        update_log: log_list,
        total_live_nodes: new_live,
        total_deleted_nodes: new_deleted
    };
}

pub fn hnsw_is_node_tombstoned(tracker: DynamicHnswTracker, node_id: Int) -> Bool {
    let tombstones: List[Int] = (tracker).tombstones.tombstoned_ids;
    let n: Int = list_len(tombstones);
    let mut i: Int = 0;
    while i < n {
        if list_get(tombstones, i) == node_id {
            return true;
        }
        i = i + 1;
    }
    return false;
}
