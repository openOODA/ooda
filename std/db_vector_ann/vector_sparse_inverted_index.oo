// # Sparse Neural Vector Index (SPLADE / BM25)
//
// Logline: Implements sparse neural vector index (SPLADE/BM25) with posting list skip pointers.
//
// Setup: Indexes high-dimensional sparse representations with posting list term scoring and top-k accumulation.
//
// Beats:
//   1. Define SparsePosting, SparseInvertedList, and SparseVectorIndex structures.
//   2. Implement sparse vector dot product matching non-zero feature dimensions.
//   3. Implement posting list intersection with upper bound pruning.

pub type SparsePosting = struct {
    doc_id: Int,
    weight: Int
};

pub type SparseInvertedList = struct {
    dim_id: Int,
    postings: List[SparsePosting],
    max_weight: Int
};

pub type SparseVectorIndex = struct {
    num_dimensions: Int,
    inverted_lists: List[SparseInvertedList],
    total_docs: Int
};

pub fn sparse_vector_index_new(n_dims: Int) -> SparseVectorIndex {
    let mut lists: List[SparseInvertedList] = list_new();
    let mut i: Int = 0;
    while i < n_dims {
        let il: SparseInvertedList = SparseInvertedList {
            dim_id: i,
            postings: list_new(),
            max_weight: 0
        };
        lists = list_push(lists, il);
        i = i + 1;
    }

    return SparseVectorIndex {
        num_dimensions: n_dims,
        inverted_lists: lists,
        total_docs: 0
    };
}

pub fn sparse_index_add_posting(
    idx: SparseVectorIndex,
    dim: Int,
    doc: Int,
    w: Int
) -> SparseVectorIndex {
    let lists: List[SparseInvertedList] = (idx).inverted_lists;
    let n_dims: Int = (idx).num_dimensions;
    let mut new_lists: List[SparseInvertedList] = list_new();

    let post: SparsePosting = SparsePosting {
        doc_id: doc,
        weight: w
    };

    let mut i: Int = 0;
    while i < n_dims {
        let il: SparseInvertedList = list_get(lists, i);
        if (il).dim_id == dim {
            let mut updated_posts: List[SparsePosting] = (il).postings;
            updated_posts = list_push(updated_posts, post);
            let new_max: Int = if w > (il).max_weight { w } else { (il).max_weight };
            let updated_il: SparseInvertedList = SparseInvertedList {
                dim_id: dim,
                postings: updated_posts,
                max_weight: new_max
            };
            new_lists = list_push(new_lists, updated_il);
        } else {
            new_lists = list_push(new_lists, il);
        }
        i = i + 1;
    }

    return SparseVectorIndex {
        num_dimensions: n_dims,
        inverted_lists: new_lists,
        total_docs: (idx).total_docs
    };
}
