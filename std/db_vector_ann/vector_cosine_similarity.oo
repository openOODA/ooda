// # Vector Cosine Similarity & Angular Metric
//
// Logline: Implements Cosine similarity and normalized inner product vector distance kernels.
//
// Setup: Computes angular cosine distance between dense embeddings with fixed-point integer normalization scaling.
//
// Beats:
//   1. Define CosineMetricConfig, VectorNormCache, and CosineSimilarityResult structures.
//   2. Implement fixed-point integer square-root approximation for vector norms.
//   3. Implement normalized cosine similarity and angular distance calculation.

pub type CosineMetricConfig = struct {
    dimension: Int,
    fixed_point_scale: Int
};

pub type VectorNormCache = struct {
    vector_id: Int,
    norm_value: Int
};

pub type CosineSimilarityResult = struct {
    dot_product: Int,
    scaled_similarity: Int,
    angular_distance: Int
};

pub fn cosine_metric_config_default(dim: Int) -> CosineMetricConfig {
    return CosineMetricConfig {
        dimension: dim,
        fixed_point_scale: 10000
    };
}

pub fn isqrt_approx(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    let mut x: Int = n;
    let mut y: Int = (x + 1) / 2;
    let mut iter: Int = 0;
    while y < x && iter < 32 {
        x = y;
        y = (x + (n / x)) / 2;
        iter = iter + 1;
    }
    return x;
}

pub fn compute_vector_norm(vec: List[Int]) -> Int {
    let dim: Int = list_len(vec);
    let mut sum_sq: Int = 0;
    let mut i: Int = 0;
    while i < dim {
        let v: Int = list_get(vec, i);
        sum_sq = sum_sq + (v * v);
        i = i + 1;
    }
    return isqrt_approx(sum_sq);
}

pub fn compute_cosine_similarity(
    vec_a: List[Int],
    vec_b: List[Int],
    scale: Int
) -> CosineSimilarityResult {
    let dim: Int = list_len(vec_a);
    let mut dot: Int = 0;
    let mut i: Int = 0;

    while i < dim && i < list_len(vec_b) {
        dot = dot + (list_get(vec_a, i) * list_get(vec_b, i));
        i = i + 1;
    }

    let norm_a: Int = compute_vector_norm(vec_a);
    let norm_b: Int = compute_vector_norm(vec_b);
    let denom: Int = norm_a * norm_b;

    let sim: Int = if denom > 0 { (dot * scale) / denom } else { 0 };
    let ang_dist: Int = scale - sim;

    return CosineSimilarityResult {
        dot_product: dot,
        scaled_similarity: sim,
        angular_distance: ang_dist
    };
}
