// # Vector Dense Inner Product (Dot Product) Kernel
//
// Logline: Implements dense inner product (IP) dot product calculation with fixed-point scaling.
//
// Setup: Computes maximum inner product search (MIPS) scores across dense feature vectors.
//
// Beats:
//   1. Define DotProductConfig, DotProductBatch, and VectorDotEvaluator structures.
//   2. Implement 4-way unrolled inner product dot accumulation.
//   3. Implement batch matrix-vector dot product scoring.

pub type DotProductConfig = struct {
    dimension: Int,
    scale_factor: Int
};

pub type DotProductBatch = struct {
    num_vectors: Int,
    scores: List[Int]
};

pub type VectorDotEvaluator = struct {
    config: DotProductConfig,
    total_evaluations: Int
};

pub fn dot_product_config_default(dim: Int) -> DotProductConfig {
    return DotProductConfig {
        dimension: dim,
        scale_factor: 1
    };
}

pub fn vector_dot_evaluator_new(cfg: DotProductConfig) -> VectorDotEvaluator {
    return VectorDotEvaluator {
        config: cfg,
        total_evaluations: 0
    };
}

pub fn compute_dot_product(
    vec_a: List[Int],
    vec_b: List[Int]
) -> Int {
    let dim: Int = list_len(vec_a);
    let mut sum_dot: Int = 0;
    let mut i: Int = 0;

    while (i + 3) < dim && (i + 3) < list_len(vec_b) {
        let a0: Int = list_get(vec_a, i);
        let b0: Int = list_get(vec_b, i);
        let a1: Int = list_get(vec_a, i + 1);
        let b1: Int = list_get(vec_b, i + 1);
        let a2: Int = list_get(vec_a, i + 2);
        let b2: Int = list_get(vec_b, i + 2);
        let a3: Int = list_get(vec_a, i + 3);
        let b3: Int = list_get(vec_b, i + 3);

        sum_dot = sum_dot + (a0 * b0) + (a1 * b1) + (a2 * b2) + (a3 * b3);
        i = i + 4;
    }

    while i < dim && i < list_len(vec_b) {
        sum_dot = sum_dot + (list_get(vec_a, i) * list_get(vec_b, i));
        i = i + 1;
    }

    return sum_dot;
}

pub fn compute_batch_dot_product(
    query_vec: List[Int],
    database_matrix: List[List[Int]]
) -> DotProductBatch {
    let num_rows: Int = list_len(database_matrix);
    let mut results: List[Int] = list_new();

    let mut r: Int = 0;
    while r < num_rows {
        let row_vec: List[Int] = list_get(database_matrix, r);
        let dot: Int = compute_dot_product(query_vec, row_vec);
        results = list_push(results, dot);
        r = r + 1;
    }

    return DotProductBatch {
        num_vectors: num_rows,
        scores: results
    };
}
