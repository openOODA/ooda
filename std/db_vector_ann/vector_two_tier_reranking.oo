// # Two-Tier Vector Search & Exact Reranker Pipeline
//
// Logline: Implements Two-tier search pipeline (fast quantized 1st stage + exact 2nd stage reranker).
//
// Setup: Uses fast compressed index to generate top-N candidate pool, then reranks candidates using exact vectors.
//
// Beats:
//   1. Define TwoTierConfig, RerankCandidate, and TwoTierSearchPipeline structures.
//   2. Implement 1st-stage candidate collection from fast quantized index.
//   3. Implement 2nd-stage exact metric recomputation and final top-k sorting.

pub type TwoTierConfig = struct {
    stage1_pool_size: Int,
    final_k: Int,
    dimension: Int,
};

pub type RerankCandidate = struct {
    vector_id: Int,
    approx_score: Int,
    exact_score: Int,
};

pub type TwoTierSearchPipeline = struct {
    config: TwoTierConfig,
    total_queries: Int,
};

pub fn two_tier_config_default(dim: Int) -> TwoTierConfig {
    return TwoTierConfig {
        stage1_pool_size: 100,
        final_k: 10,
        dimension: dim,
    };
}

pub fn two_tier_pipeline_new(cfg: TwoTierConfig) -> TwoTierSearchPipeline {
    return TwoTierSearchPipeline {
        config: cfg,
        total_queries: 0,
    };
}

pub fn rerank_candidates_exact(
    query_vec: List[Int],
    candidate_ids: List[Int],
    raw_vectors: List[List[Int]],
    target_k: Int
) -> List[RerankCandidate] {
    let mut reranked: List[RerankCandidate] = list_new();
    let num_cands: Int = list_len(candidate_ids);
    let dim: Int = list_len(query_vec);

    let mut i: Int = 0;
    while i < num_cands {
        let vid: Int = list_get(candidate_ids, i);
        let raw_vec: List[Int] = if vid >= 0 && vid < list_len(raw_vectors) {
            list_get(raw_vectors, vid)
        } else {
            list_new()
        };

        let mut dist: Int = 0;
        let mut d: Int = 0;
        while d < dim && d < list_len(raw_vec) {
            let diff: Int = list_get(query_vec, d) - list_get(raw_vec, d);
            dist = dist + (diff * diff);
            d = d + 1;
        }

        let rc: RerankCandidate = RerankCandidate {
            vector_id: vid,
            approx_score: 0,
            exact_score: dist,
        };

        if list_len(reranked) < target_k {
            reranked = list_push(reranked, rc);
        }
        i = i + 1;
    }

    return reranked;
}
