// # ScaNN Anisotropic Vector Quantizer
//
// Logline: Implements ScaNN anisotropic vector quantization penalizing parallel quantization error over orthogonal error.
//
// Setup: Optimizes quantization codebooks for maximum inner product search (MIPS) by weighting parallel projection losses.
//
// Beats:
//   1. Define AnisotropicConfig, QuantizedSubspace, and ScannQuantizer structures.
//   2. Implement anisotropic loss computation weighting parallel and orthogonal residual components.
//   3. Implement centroid assignment minimizing anisotropic projection distortion.

pub type AnisotropicConfig = struct {
    num_subspaces: Int,
    centroids_per_subspace: Int,
    anisotropic_quantization_threshold: Int,
    dimension: Int
};

pub type QuantizedSubspace = struct {
    subspace_index: Int,
    dimension_offset: Int,
    subspace_dim: Int,
    centroids: List[List[Int]]
};

pub type ScannQuantizer = struct {
    config: AnisotropicConfig,
    subspaces: List[QuantizedSubspace],
    is_trained: Bool
};

pub fn anisotropic_config_default(dim: Int, n_sub: Int) -> AnisotropicConfig {
    return AnisotropicConfig {
        num_subspaces: n_sub,
        centroids_per_subspace: 256,
        anisotropic_quantization_threshold: 20,
        dimension: dim
    };
}

pub fn scann_quantizer_new(cfg: AnisotropicConfig) -> ScannQuantizer {
    return ScannQuantizer {
        config: cfg,
        subspaces: list_new(),
        is_trained: false
    };
}

pub fn scann_anisotropic_loss(
    orig_subvec: List[Int],
    centroid: List[Int],
    weight_parallel: Int
) -> Int {
    let dim: Int = list_len(orig_subvec);
    let mut norm_sq: Int = 0;
    let mut dot_prod: Int = 0;
    let mut diff_norm_sq: Int = 0;

    let mut i: Int = 0;
    while i < dim {
        let x: Int = list_get(orig_subvec, i);
        let c: Int = if i < list_len(centroid) { list_get(centroid, i) } else { 0 };
        let diff: Int = x - c;
        norm_sq = norm_sq + (x * x);
        dot_prod = dot_prod + (x * c);
        diff_norm_sq = diff_norm_sq + (diff * diff);
        i = i + 1;
    }

    let parallel_err: Int = if norm_sq > 0 { (norm_sq - dot_prod) * (norm_sq - dot_prod) / norm_sq } else { 0 };
    let perp_err: Int = diff_norm_sq - parallel_err;
    let final_loss: Int = (weight_parallel * parallel_err) + (if perp_err > 0 { perp_err } else { 0 });
    return final_loss;
}

pub fn scann_find_best_centroid(
    subvec: List[Int],
    subspace: QuantizedSubspace,
    w_parallel: Int
) -> Int {
    let cents: List[List[Int]] = (subspace).centroids;
    let num_c: Int = list_len(cents);
    if num_c == 0 {
        return 0;
    }

    let mut best_idx: Int = 0;
    let mut min_loss: Int = 2147483647;
    let mut c_i: Int = 0;

    while c_i < num_c {
        let cent: List[Int] = list_get(cents, c_i);
        let loss: Int = scann_anisotropic_loss(subvec, cent, w_parallel);
        if loss < min_loss {
            min_loss = loss;
            best_idx = c_i;
        }
        c_i = c_i + 1;
    }

    return best_idx;
}
