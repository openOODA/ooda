// # Inverted File (IVF) Posting List Manager
//
// Logline: Implements IVF posting lists management with inverted index posting arrays and vector IDs.
//
// Setup: Stores vector identifiers and quantized payload codes organized per Voronoi inverted list.
//
// Beats:
//   1. Define InvertedPostingEntry, InvertedListBucket, and IvfPostingManager structures.
//   2. Implement posting list appending, scanning, and length tracking.
//   3. Implement candidate gather across multi-probed inverted buckets.

pub type InvertedPostingEntry = struct {
    vector_id: Int,
    codes: List[Int]
};

pub type InvertedListBucket = struct {
    cluster_id: Int,
    entries: List[InvertedPostingEntry],
    total_entries: Int
};

pub type IvfPostingManager = struct {
    num_buckets: Int,
    buckets: List[InvertedListBucket],
    total_indexed_entries: Int
};

pub fn ivf_posting_manager_new(n_buckets: Int) -> IvfPostingManager {
    let mut initial_buckets: List[InvertedListBucket] = list_new();
    let mut i: Int = 0;
    while i < n_buckets {
        let b: InvertedListBucket = InvertedListBucket {
            cluster_id: i,
            entries: list_new(),
            total_entries: 0
        };
        initial_buckets = list_push(initial_buckets, b);
        i = i + 1;
    }

    return IvfPostingManager {
        num_buckets: n_buckets,
        buckets: initial_buckets,
        total_indexed_entries: 0
    };
}

pub fn ivf_append_entry(
    mgr: IvfPostingManager,
    cid: Int,
    vid: Int,
    codes: List[Int]
) -> IvfPostingManager {
    let n_buckets: Int = (mgr).num_buckets;
    let old_buckets: List[InvertedListBucket] = (mgr).buckets;
    let mut new_buckets: List[InvertedListBucket] = list_new();

    let entry: InvertedPostingEntry = InvertedPostingEntry {
        vector_id: vid,
        codes: codes
    };

    let mut i: Int = 0;
    while i < n_buckets {
        let b: InvertedListBucket = list_get(old_buckets, i);
        if (b).cluster_id == cid {
            let mut updated_entries: List[InvertedPostingEntry] = (b).entries;
            updated_entries = list_push(updated_entries, entry);
            let updated_b: InvertedListBucket = InvertedListBucket {
                cluster_id: cid,
                entries: updated_entries,
                total_entries: (b).total_entries + 1
            };
            new_buckets = list_push(new_buckets, updated_b);
        } else {
            new_buckets = list_push(new_buckets, b);
        }
        i = i + 1;
    }

    let new_total: Int = (mgr).total_indexed_entries + 1;
    return IvfPostingManager {
        num_buckets: n_buckets,
        buckets: new_buckets,
        total_indexed_entries: new_total
    };
}

pub fn ivf_gather_candidates(
    mgr: IvfPostingManager,
    cluster_ids: List[Int]
) -> List[Int] {
    let mut vids: List[Int] = list_new();
    let num_c: Int = list_len(cluster_ids);
    let all_buckets: List[InvertedListBucket] = (mgr).buckets;

    let mut c_idx: Int = 0;
    while c_idx < num_c {
        let target_cid: Int = list_get(cluster_ids, c_idx);
        if target_cid >= 0 && target_cid < list_len(all_buckets) {
            let bucket: InvertedListBucket = list_get(all_buckets, target_cid);
            let entries: List[InvertedPostingEntry] = (bucket).entries;
            let n_e: Int = list_len(entries);
            let mut e_i: Int = 0;
            while e_i < n_e {
                let ent: InvertedPostingEntry = list_get(entries, e_i);
                vids = list_push(vids, (ent).vector_id);
                e_i = e_i + 1;
            }
        }
        c_idx = c_idx + 1;
    }

    return vids;
}
