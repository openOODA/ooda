// # Vector PCA Projection & Eigenvalue Whitening
//
// Logline: Implements Principal Component Analysis (PCA) projection and eigenvalue whitening transform.
//
// Setup: De-correlates vector dimensions and normalizes variance to improve metric search uniformity.
//
// Beats:
//   1. Define PcaWhiteningConfig, MeanVarianceParams, and PcaTransformEngine structures.
//   2. Implement vector centering and diagonal variance scaling.
//   3. Implement PCA projection mapping to principal component sub-space.

pub type PcaWhiteningConfig = struct {
    input_dimension: Int,
    output_dimension: Int,
    epsilon_scale: Int,
};

pub type MeanVarianceParams = struct {
    mean_vector: List[Int],
    variance_vector: List[Int],
};

pub type PcaTransformEngine = struct {
    config: PcaWhiteningConfig,
    parameters: MeanVarianceParams,
    eigenvectors: List[List[Int]],
};

pub fn pca_whitening_config_default(in_d: Int, out_d: Int) -> PcaWhiteningConfig {
    return PcaWhiteningConfig {
        input_dimension: in_d,
        output_dimension: out_d,
        epsilon_scale: 1,
    };
}

pub fn pca_transform_engine_new(cfg: PcaWhiteningConfig) -> PcaTransformEngine {
    let params: MeanVarianceParams = MeanVarianceParams {
        mean_vector: list_new(),
        variance_vector: list_new(),
    };
    return PcaTransformEngine {
        config: cfg,
        parameters: params,
        eigenvectors: list_new(),
    };
}

pub fn pca_whiten_vector(
    engine: PcaTransformEngine,
    in_vec: List[Int]
) -> List[Int] {
    let mut whitened: List[Int] = list_new();
    let means: List[Int] = (engine).parameters.mean_vector;
    let vars: List[Int] = (engine).parameters.variance_vector;
    let dim: Int = (engine).config.input_dimension;

    let mut i: Int = 0;
    while i < dim && i < list_len(in_vec) {
        let v: Int = list_get(in_vec, i);
        let m: Int = if i < list_len(means) { list_get(means, i) } else { 0 };
        let centered: Int = v - m;
        whitened = list_push(whitened, centered);
        i = i + 1;
    }

    return whitened;
}
