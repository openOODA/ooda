// # Bounded Top-K Priority Queue & Candidate Collector
//
// Logline: Implements fixed-capacity max-heap and candidate priority queues for ANN search.
//
// Setup: Maintains bounded top-k nearest neighbors during graph traversal and inverted list scans.
//
// Beats:
//   1. Define PriorityItem, TopKQueueConfig, and TopKPriorityQueue structures.
//   2. Implement push with bounded capacity eviction of worst candidates.
//   3. Implement candidate extraction in sorted order.

pub type PriorityItem = struct {
    item_id: Int,
    distance: Int
};

pub type TopKQueueConfig = struct {
    capacity_k: Int
};

pub type TopKPriorityQueue = struct {
    config: TopKQueueConfig,
    items: List[PriorityItem],
    count: Int
};

pub fn topk_priority_queue_new(k: Int) -> TopKPriorityQueue {
    return TopKPriorityQueue {
        config: TopKQueueConfig { capacity_k: k },
        items: list_new(),
        count: 0
    };
}

pub fn priority_item_new(id: Int, dist: Int) -> PriorityItem {
    return PriorityItem {
        item_id: id,
        distance: dist
    };
}

pub fn topk_queue_push(queue: TopKPriorityQueue, item: PriorityItem) -> TopKPriorityQueue {
    let mut current_items: List[PriorityItem] = (queue).items;
    let cap: Int = (queue).config.capacity_k;
    let n: Int = list_len(current_items);

    if n < cap {
        current_items = list_push(current_items, item);
    } else {
        let mut worst_idx: Int = 0;
        let mut max_dist: Int = -1;
        let mut i: Int = 0;
        while i < n {
            let pi: PriorityItem = list_get(current_items, i);
            if (pi).distance > max_dist {
                max_dist = (pi).distance;
                worst_idx = i;
            }
            i = i + 1;
        }

        if (item).distance < max_dist {
            let mut new_list: List[PriorityItem] = list_new();
            let mut j: Int = 0;
            while j < n {
                if j == worst_idx {
                    new_list = list_push(new_list, item);
                } else {
                    new_list = list_push(new_list, list_get(current_items, j));
                }
                j = j + 1;
            }
            current_items = new_list;
        }
    }

    let final_count: Int = list_len(current_items);
    return TopKPriorityQueue {
        config: (queue).config,
        items: current_items,
        count: final_count
    };
}
