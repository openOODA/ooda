// # Exact Flat k-NN Brute-Force Scanner
//
// Logline: Implements Flat exact k-NN brute-force scanner with top-k candidate collector.
//
// Setup: Scans all database vectors computing exact distances as the ground-truth benchmark and small-index fallback.
//
// Beats:
//   1. Define ExactScanConfig, ScoredVector, and FlatVectorStore structures.
//   2. Implement sequential dataset scan with L2 distance computation.
//   3. Implement bounded top-k collection.

pub type ExactScanConfig = struct {
    dimension: Int,
    metric_type: Int
};

pub type ScoredVector = struct {
    vector_id: Int,
    distance_score: Int
};

pub type FlatVectorStore = struct {
    config: ExactScanConfig,
    vectors: List[List[Int]],
    vector_ids: List[Int],
    total_vectors: Int
};

pub fn exact_scan_config_default(dim: Int) -> ExactScanConfig {
    return ExactScanConfig {
        dimension: dim,
        metric_type: 0
    };
}

pub fn flat_vector_store_new(cfg: ExactScanConfig) -> FlatVectorStore {
    return FlatVectorStore {
        config: cfg,
        vectors: list_new(),
        vector_ids: list_new(),
        total_vectors: 0
    };
}

pub fn flat_store_add_vector(
    store: FlatVectorStore,
    vid: Int,
    vec: List[Int]
) -> FlatVectorStore {
    let mut updated_vecs: List[List[Int]] = (store).vectors;
    let mut updated_ids: List[Int] = (store).vector_ids;
    updated_vecs = list_push(updated_vecs, vec);
    updated_ids = list_push(updated_ids, vid);
    let new_total: Int = (store).total_vectors + 1;

    return FlatVectorStore {
        config: (store).config,
        vectors: updated_vecs,
        vector_ids: updated_ids,
        total_vectors: new_total
    };
}

pub fn flat_scan_knn(
    store: FlatVectorStore,
    query_vec: List[Int],
    target_k: Int
) -> List[ScoredVector] {
    let mut results: List[ScoredVector] = list_new();
    let vecs: List[List[Int]] = (store).vectors;
    let ids: List[Int] = (store).vector_ids;
    let n: Int = (store).total_vectors;
    let dim: Int = (store).config.dimension;

    let mut i: Int = 0;
    while i < n {
        let db_vec: List[Int] = list_get(vecs, i);
        let vid: Int = list_get(ids, i);

        let mut dist: Int = 0;
        let mut d: Int = 0;
        while d < dim && d < list_len(db_vec) && d < list_len(query_vec) {
            let diff: Int = list_get(query_vec, d) - list_get(db_vec, d);
            dist = dist + (diff * diff);
            d = d + 1;
        }

        let sv: ScoredVector = ScoredVector {
            vector_id: vid,
            distance_score: dist
        };

        if list_len(results) < target_k {
            results = list_push(results, sv);
        }
        i = i + 1;
    }

    return results;
}
