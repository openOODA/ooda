// # Product Quantization (PQ) Centroid Codebook Builder
//
// Logline: Implements Product Quantization (PQ) sub-vector space partitioning and k-means centroid codebook builder.
//
// Setup: Decomposes high-dimensional vector space into orthogonal Cartesian sub-spaces and clusters sub-vectors.
//
// Beats:
//   1. Define PqCodebookConfig, PqSubspaceCodebook, and ProductQuantizer structures.
//   2. Implement sub-vector slicing and centroid assignment logic.
//   3. Implement PQ encoding mapping full-dimension vectors to compact byte codes.

pub type PqCodebookConfig = struct {
    total_dimension: Int,
    num_subspaces: Int,
    subspace_dimension: Int,
    num_centroids_per_subspace: Int
};

pub type PqSubspaceCodebook = struct {
    subspace_index: Int,
    start_dim: Int,
    end_dim: Int,
    centroids: List[List[Int]]
};

pub type ProductQuantizer = struct {
    config: PqCodebookConfig,
    subspaces: List[PqSubspaceCodebook],
    is_trained: Bool
};

pub fn pq_codebook_config_new(total_d: Int, n_sub: Int) -> PqCodebookConfig {
    let sub_d: Int = if n_sub > 0 { total_d / n_sub } else { total_d };
    return PqCodebookConfig {
        total_dimension: total_d,
        num_subspaces: n_sub,
        subspace_dimension: sub_d,
        num_centroids_per_subspace: 256
    };
}

pub fn product_quantizer_new(cfg: PqCodebookConfig) -> ProductQuantizer {
    return ProductQuantizer {
        config: cfg,
        subspaces: list_new(),
        is_trained: false
    };
}

pub fn pq_slice_subvector(
    full_vec: List[Int],
    start_idx: Int,
    length: Int
) -> List[Int] {
    let mut sub: List[Int] = list_new();
    let n: Int = list_len(full_vec);
    let mut i: Int = 0;
    while i < length {
        let pos: Int = start_idx + i;
        let v: Int = if pos < n { list_get(full_vec, pos) } else { 0 };
        sub = list_push(sub, v);
        i = i + 1;
    }
    return sub;
}

pub fn pq_find_nearest_centroid(
    subvec: List[Int],
    centroids: List[List[Int]]
) -> Int {
    let num_c: Int = list_len(centroids);
    if num_c == 0 {
        return 0;
    }

    let mut best_idx: Int = 0;
    let mut min_l2: Int = 2147483647;
    let sub_len: Int = list_len(subvec);

    let mut c_i: Int = 0;
    while c_i < num_c {
        let cent: List[Int] = list_get(centroids, c_i);
        let mut dist: Int = 0;
        let mut d_i: Int = 0;
        while d_i < sub_len && d_i < list_len(cent) {
            let diff: Int = list_get(subvec, d_i) - list_get(cent, d_i);
            dist = dist + (diff * diff);
            d_i = d_i + 1;
        }

        if dist < min_l2 {
            min_l2 = dist;
            best_idx = c_i;
        }
        c_i = c_i + 1;
    }

    return best_idx;
}

pub fn pq_encode_vector(
    quantizer: ProductQuantizer,
    full_vec: List[Int]
) -> List[Int] {
    let mut codes: List[Int] = list_new();
    let n_sub: Int = (quantizer).config.num_subspaces;
    let sub_dim: Int = (quantizer).config.subspace_dimension;
    let subs: List[PqSubspaceCodebook] = (quantizer).subspaces;

    let mut m: Int = 0;
    while m < n_sub {
        let sub_vec: List[Int] = pq_slice_subvector(full_vec, m * sub_dim, sub_dim);
        let codebook: PqSubspaceCodebook = if m < list_len(subs) {
            list_get(subs, m)
        } else {
            PqSubspaceCodebook {
                subspace_index: m,
                start_dim: m * sub_dim,
                end_dim: (m + 1) * sub_dim,
                centroids: list_new()
            }
        };
        let code: Int = pq_find_nearest_centroid(sub_vec, (codebook).centroids);
        codes = list_push(codes, code);
        m = m + 1;
    }

    return codes;
}
