// # Vector Jaccard Set Similarity & Distance Metric
//
// Logline: Implements Jaccard distance and intersection over union for sparse binary token vectors.
//
// Setup: Computes set similarity over sorted token ID arrays and binary indicator bit vectors.
//
// Beats:
//   1. Define JaccardConfig, SortedTokenSet, and JaccardSimilarityResult structures.
//   2. Implement two-pointer intersection and union count on sorted token arrays.
//   3. Implement scaled Jaccard distance metric for sparse lexical and categorical features.

pub type JaccardConfig = struct {
    scale_factor: Int
};

pub type SortedTokenSet = struct {
    set_id: Int,
    tokens: List[Int],
    count: Int
};

pub type JaccardSimilarityResult = struct {
    intersection_count: Int,
    union_count: Int,
    scaled_similarity: Int,
    scaled_distance: Int
};

pub fn jaccard_config_default() -> JaccardConfig {
    return JaccardConfig {
        scale_factor: 10000
    };
}

pub fn sorted_token_set_new(sid: Int, tok_list: List[Int]) -> SortedTokenSet {
    return SortedTokenSet {
        set_id: sid,
        tokens: tok_list,
        count: list_len(tok_list)
    };
}

pub fn compute_jaccard_similarity(
    set_a: SortedTokenSet,
    set_b: SortedTokenSet,
    scale: Int
) -> JaccardSimilarityResult {
    let toks_a: List[Int] = (set_a).tokens;
    let toks_b: List[Int] = (set_b).tokens;
    let n_a: Int = list_len(toks_a);
    let n_b: Int = list_len(toks_b);

    let mut i: Int = 0;
    let mut j: Int = 0;
    let mut intersection_cnt: Int = 0;

    while i < n_a && j < n_b {
        let ta: Int = list_get(toks_a, i);
        let tb: Int = list_get(toks_b, j);

        if ta == tb {
            intersection_cnt = intersection_cnt + 1;
            i = i + 1;
            j = j + 1;
        } else if ta < tb {
            i = i + 1;
        } else {
            j = j + 1;
        }
    }

    let union_cnt: Int = (n_a + n_b) - intersection_cnt;
    let sim: Int = if union_cnt > 0 { (intersection_cnt * scale) / union_cnt } else { 0 };
    let dist: Int = scale - sim;

    return JaccardSimilarityResult {
        intersection_count: intersection_cnt,
        union_count: union_cnt,
        scaled_similarity: sim,
        scaled_distance: dist
    };
}
