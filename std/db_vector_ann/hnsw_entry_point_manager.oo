// # HNSW Entry Point & Top-Layer Navigation Manager
//
// Logline: Implements multi-level entry point selection and top-layer navigation for HNSW graph search.
//
// Setup: Manages entry points across upper layers, providing stable landing spots for ANN query traversal.
//
// Beats:
//   1. Define EntryPointMetadata, LayerNavigationContext, and HnswEntryManager structures.
//   2. Implement top-layer greedy navigation finding closest node to enter lower graph layers.
//   3. Implement dynamic entry point migration when new vectors reach higher layer levels.

pub type EntryPointMetadata = struct {
    node_id: Int,
    level: Int,
    is_active: Bool
};

pub type LayerNavigationContext = struct {
    current_node_id: Int,
    current_level: Int,
    distance_to_query: Int
};

pub type HnswEntryManager = struct {
    top_level_entry_id: Int,
    max_level: Int,
    layer_entry_points: List[EntryPointMetadata]
};

pub fn hnsw_entry_manager_new() -> HnswEntryManager {
    return HnswEntryManager {
        top_level_entry_id: -1,
        max_level: 0,
        layer_entry_points: list_new()
    };
}

pub fn hnsw_register_entry_point(
    mgr: HnswEntryManager,
    node_id: Int,
    lvl: Int
) -> HnswEntryManager {
    let meta: EntryPointMetadata = EntryPointMetadata {
        node_id: node_id,
        level: lvl,
        is_active: true
    };

    let mut entries: List[EntryPointMetadata] = (mgr).layer_entry_points;
    entries = list_push(entries, meta);

    let new_top: Int = if (mgr).top_level_entry_id < 0 || lvl > (mgr).max_level {
        node_id
    } else {
        (mgr).top_level_entry_id
    };

    let new_max_lvl: Int = if lvl > (mgr).max_level { lvl } else { (mgr).max_level };

    return HnswEntryManager {
        top_level_entry_id: new_top,
        max_level: new_max_lvl,
        layer_entry_points: entries
    };
}

pub fn hnsw_navigate_layer_step(
    ctx: LayerNavigationContext,
    neighbors: List[Int],
    distances: List[Int]
) -> LayerNavigationContext {
    let mut best_id: Int = (ctx).current_node_id;
    let mut best_dist: Int = (ctx).distance_to_query;
    let n: Int = list_len(neighbors);

    let mut i: Int = 0;
    while i < n {
        let n_id: Int = list_get(neighbors, i);
        let n_dist: Int = if i < list_len(distances) { list_get(distances, i) } else { 2147483647 };
        if n_dist < best_dist {
            best_dist = n_dist;
            best_id = n_id;
        }
        i = i + 1;
    }

    return LayerNavigationContext {
        current_node_id: best_id,
        current_level: (ctx).current_level,
        distance_to_query: best_dist
    };
}
