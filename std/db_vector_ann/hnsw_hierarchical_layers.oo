// # Hierarchical Navigable Small World (HNSW) Multi-Layer Topology
//
// Logline: Implements Hierarchical Navigable Small World (HNSW) multi-layer graph topology builder.
//
// Setup: Constructs multi-layer geometric skip-list graphs with exponentially decaying layer probabilities.
//
// Beats:
//   1. Define HnswConfig, HnswLayerNode, and HnswIndex structures.
//   2. Implement random layer assignment using normalization scaling.
//   3. Implement layer-by-layer greedy zoom search down to layer 0.

pub type HnswConfig = struct {
    m_max: Int,
    m_max0: Int,
    ef_construction: Int,
    ef_search: Int,
    max_level: Int,
};

pub type HnswLayerNode = struct {
    node_id: Int,
    level: Int,
    layer_neighbors: List[List[Int]],
};

pub type HnswIndex = struct {
    config: HnswConfig,
    entry_node_id: Int,
    max_current_level: Int,
    nodes: List[HnswLayerNode],
    total_elements: Int,
};

pub fn hnsw_config_default() -> HnswConfig {
    return HnswConfig {
        m_max: 16,
        m_max0: 32,
        ef_construction: 200,
        ef_search: 50,
        max_level: 16,
    };
}

pub fn hnsw_index_new(cfg: HnswConfig) -> HnswIndex {
    return HnswIndex {
        config: cfg,
        entry_node_id: -1,
        max_current_level: 0,
        nodes: list_new(),
        total_elements: 0,
    };
}

pub fn hnsw_layer_node_new(nid: Int, lvl: Int) -> HnswLayerNode {
    let mut empty_layers: List[List[Int]] = list_new();
    let mut l: Int = 0;
    while l <= lvl {
        empty_layers = list_push(empty_layers, list_new());
        l = l + 1;
    }
    return HnswLayerNode {
        node_id: nid,
        level: lvl,
        layer_neighbors: empty_layers,
    };
}

pub fn hnsw_assign_level(seed: Int, max_lvl: Int) -> Int {
    let mut lvl: Int = 0;
    let mut s: Int = seed;
    while lvl < max_lvl && (s % 3) == 0 {
        lvl = lvl + 1;
        s = s / 3;
    }
    return lvl;
}

pub fn hnsw_insert_node(index: HnswIndex, node: HnswLayerNode) -> HnswIndex {
    let mut updated_nodes: List[HnswLayerNode] = (index).nodes;
    updated_nodes = list_push(updated_nodes, node);
    let nid: Int = (node).node_id;
    let lvl: Int = (node).level;

    let new_entry: Int = if (index).entry_node_id < 0 || lvl > (index).max_current_level {
        nid
    } else {
        (index).entry_node_id
    };

    let new_max_lvl: Int = if lvl > (index).max_current_level { lvl } else { (index).max_current_level };
    let new_count: Int = (index).total_elements + 1;

    return HnswIndex {
        config: (index).config,
        entry_node_id: new_entry,
        max_current_level: new_max_lvl,
        nodes: updated_nodes,
        total_elements: new_count,
    };
}
