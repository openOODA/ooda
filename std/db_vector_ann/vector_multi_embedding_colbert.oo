// # ColBERT / MaxSim Multi-Vector Late-Interaction Scorer
//
// Logline: Implements ColBERT / MaxSim multi-vector late-interaction token score aggregator.
//
// Setup: Computes maximum similarity per query token over all document token embeddings and sums the max scores.
//
// Beats:
//   1. Define MultiVectorDocument, ColBertQuery, and MaxSimScorer structures.
//   2. Implement pairwise dot product and maximum token score operator.
//   3. Implement late-interaction aggregation across variable-length token sequences.

pub type MultiVectorDocument = struct {
    doc_id: Int,
    token_embeddings: List[List[Int]],
    num_tokens: Int,
};

pub type ColBertQuery = struct {
    query_id: Int,
    token_embeddings: List[List[Int]],
    num_tokens: Int,
};

pub type MaxSimScorer = struct {
    dimension: Int,
    total_docs_scored: Int,
};

pub fn max_sim_scorer_new(dim: Int) -> MaxSimScorer {
    return MaxSimScorer {
        dimension: dim,
        total_docs_scored: 0,
    };
}

pub fn colbert_token_dot(
    tok_a: List[Int],
    tok_b: List[Int]
) -> Int {
    let dim: Int = list_len(tok_a);
    let mut dot: Int = 0;
    let mut i: Int = 0;
    while i < dim && i < list_len(tok_b) {
        dot = dot + (list_get(tok_a, i) * list_get(tok_b, i));
        i = i + 1;
    }
    return dot;
}

pub fn compute_colbert_maxsim(
    query: ColBertQuery,
    doc: MultiVectorDocument
) -> Int {
    let q_toks: List[List[Int]] = (query).token_embeddings;
    let d_toks: List[List[Int]] = (doc).token_embeddings;
    let n_q: Int = list_len(q_toks);
    let n_d: Int = list_len(d_toks);

    let mut total_score: Int = 0;
    let mut q_i: Int = 0;

    while q_i < n_q {
        let q_vec: List[Int] = list_get(q_toks, q_i);
        let mut max_sim_for_q: Int = -2147483648;
        let mut d_i: Int = 0;

        while d_i < n_d {
            let d_vec: List[Int] = list_get(d_toks, d_i);
            let sim: Int = colbert_token_dot(q_vec, d_vec);
            if sim > max_sim_for_q {
                max_sim_for_q = sim;
            }
            d_i = d_i + 1;
        }

        if n_d > 0 {
            total_score = total_score + max_sim_for_q;
        }
        q_i = q_i + 1;
    }

    return total_score;
}
