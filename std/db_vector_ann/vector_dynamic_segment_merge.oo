// # LSM Vector Segment Merge & Background Compactor
//
// Logline: Implements Log-structured vector segments and LSM background merge compactor.
//
// Setup: Buffers live vector mutations into immutable segments and triggers tiered background compactions.
//
// Beats:
//   1. Define VectorSegment, CompactionPolicy, and SegmentManager structures.
//   2. Implement segment size threshold evaluation and compaction selection.
//   3. Implement multi-segment vector merging and tombstone deduplication.

pub type VectorSegment = struct {
    segment_id: Int,
    level: Int,
    vector_ids: List[Int],
    is_compacted: Bool,
};

pub type CompactionPolicy = struct {
    max_segments_per_level: Int,
    compaction_batch_size: Int,
};

pub type SegmentManager = struct {
    policy: CompactionPolicy,
    segments: List[VectorSegment],
    total_segments: Int,
};

pub fn compaction_policy_default() -> CompactionPolicy {
    return CompactionPolicy {
        max_segments_per_level: 4,
        compaction_batch_size: 2,
    };
}

pub fn segment_manager_new(pol: CompactionPolicy) -> SegmentManager {
    return SegmentManager {
        policy: pol,
        segments: list_new(),
        total_segments: 0,
    };
}

pub fn segment_manager_add_segment(
    mgr: SegmentManager,
    seg: VectorSegment
) -> SegmentManager {
    let mut updated_segs: List[VectorSegment] = (mgr).segments;
    updated_segs = list_push(updated_segs, seg);
    let new_total: Int = (mgr).total_segments + 1;

    return SegmentManager {
        policy: (mgr).policy,
        segments: updated_segs,
        total_segments: new_total,
    };
}

pub fn merge_two_segments(
    seg_a: VectorSegment,
    seg_b: VectorSegment,
    new_seg_id: Int
) -> VectorSegment {
    let mut merged_vids: List[Int] = list_new();
    let vids_a: List[Int] = (seg_a).vector_ids;
    let vids_b: List[Int] = (seg_b).vector_ids;

    let mut i: Int = 0;
    while i < list_len(vids_a) {
        merged_vids = list_push(merged_vids, list_get(vids_a, i));
        i = i + 1;
    }

    let mut j: Int = 0;
    while j < list_len(vids_b) {
        let vid: Int = list_get(vids_b, j);
        let mut exists: Bool = false;
        let mut k: Int = 0;
        while k < list_len(merged_vids) {
            if list_get(merged_vids, k) == vid {
                exists = true;
            }
            k = k + 1;
        }
        if !exists {
            merged_vids = list_push(merged_vids, vid);
        }
        j = j + 1;
    }

    let next_lvl: Int = if (seg_a).level > (seg_b).level { (seg_a).level + 1 } else { (seg_b).level + 1 };

    return VectorSegment {
        segment_id: new_seg_id,
        level: next_lvl,
        vector_ids: merged_vids,
        is_compacted: true,
    };
}
