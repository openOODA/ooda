// # Inverted File (IVF) Coarse Voronoi Partitioner
//
// Logline: Implements Inverted File (IVF) coarse quantizer using k-means Voronoi cell partitioning.
//
// Setup: Groups high-dimensional vectors into Voronoi clusters to narrow search space during query routing.
//
// Beats:
//   1. Define IvfClusterConfig, IvfCentroid, and IvfCoarseQuantizer structures.
//   2. Implement coarse cluster assignment finding nearest centroid via L2/IP metric.
//   3. Implement multi-probe cluster selection returning top-nprobe cluster IDs.

pub type IvfClusterConfig = struct {
    num_centroids_k: Int,
    dimension: Int,
    default_nprobe: Int,
};

pub type IvfCentroid = struct {
    centroid_id: Int,
    coordinates: List[Int],
    assigned_count: Int,
};

pub type IvfCoarseQuantizer = struct {
    config: IvfClusterConfig,
    centroids: List[IvfCentroid],
    is_trained: Bool,
};

pub fn ivf_cluster_config_default(k: Int, dim: Int) -> IvfClusterConfig {
    return IvfClusterConfig {
        num_centroids_k: k,
        dimension: dim,
        default_nprobe: 16,
    };
}

pub fn ivf_coarse_quantizer_new(cfg: IvfClusterConfig) -> IvfCoarseQuantizer {
    return IvfCoarseQuantizer {
        config: cfg,
        centroids: list_new(),
        is_trained: false,
    };
}

pub fn ivf_add_centroid(quantizer: IvfCoarseQuantizer, cent: IvfCentroid) -> IvfCoarseQuantizer {
    let mut updated_cents: List[IvfCentroid] = (quantizer).centroids;
    updated_cents = list_push(updated_cents, cent);

    return IvfCoarseQuantizer {
        config: (quantizer).config,
        centroids: updated_cents,
        is_trained: true,
    };
}

pub fn ivf_find_closest_centroid(
    quantizer: IvfCoarseQuantizer,
    vec: List[Int]
) -> Int {
    let cents: List[IvfCentroid] = (quantizer).centroids;
    let num_c: Int = list_len(cents);
    let dim: Int = (quantizer).config.dimension;

    if num_c == 0 {
        return 0;
    }

    let mut best_id: Int = 0;
    let mut min_l2: Int = 2147483647;

    let mut i: Int = 0;
    while i < num_c {
        let cent: IvfCentroid = list_get(cents, i);
        let coords: List[Int] = (cent).coordinates;
        let mut dist_sq: Int = 0;
        let mut d: Int = 0;
        while d < dim && d < list_len(coords) && d < list_len(vec) {
            let diff: Int = list_get(vec, d) - list_get(coords, d);
            dist_sq = dist_sq + (diff * diff);
            d = d + 1;
        }

        if dist_sq < min_l2 {
            min_l2 = dist_sq;
            best_id = (cent).centroid_id;
        }
        i = i + 1;
    }

    return best_id;
}
