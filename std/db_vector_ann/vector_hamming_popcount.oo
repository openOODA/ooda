// # Binary Vector Hamming Distance & Popcount Kernel
//
// Logline: Implements binary Hamming distance calculation with bitwise XOR and population count acceleration.
//
// Setup: Compares binary embeddings and 1-bit quantized hashes for sub-microsecond binary similarity search.
//
// Beats:
//   1. Define BinaryVectorSignature, HammingSearchQuery, and BinaryDistanceIndex structures.
//   2. Implement 32-bit integer population count (popcount) bitwise algorithm.
//   3. Implement multi-word Hamming distance computation and early threshold termination.

pub type BinaryVectorSignature = struct {
    vector_id: Int,
    bit_words: List[Int],
    total_bits: Int,
};

pub type HammingSearchQuery = struct {
    query_id: Int,
    query_words: List[Int],
    max_hamming_distance: Int,
};

pub type BinaryDistanceIndex = struct {
    num_words: Int,
    total_signatures: Int,
    signatures: List[BinaryVectorSignature],
};

pub fn binary_vector_signature_new(vid: Int, words: List[Int], bits: Int) -> BinaryVectorSignature {
    return BinaryVectorSignature {
        vector_id: vid,
        bit_words: words,
        total_bits: bits,
    };
}

pub fn binary_distance_index_new(n_words: Int) -> BinaryDistanceIndex {
    return BinaryDistanceIndex {
        num_words: n_words,
        total_signatures: 0,
        signatures: list_new(),
    };
}

pub fn popcount_u32(val: Int) -> Int {
    let mut v: Int = val;
    let mut count: Int = 0;
    while v > 0 {
        if (v % 2) != 0 {
            count = count + 1;
        }
        v = v / 2;
    }
    return count;
}

pub fn bitwise_xor_popcount(a: Int, b: Int) -> Int {
    let mut va: Int = a;
    let mut vb: Int = b;
    let mut count: Int = 0;

    while va > 0 || vb > 0 {
        let bit_a: Int = va % 2;
        let bit_b: Int = vb % 2;
        if bit_a != bit_b {
            count = count + 1;
        }
        va = va / 2;
        vb = vb / 2;
    }

    return count;
}

pub fn compute_hamming_distance(
    words_a: List[Int],
    words_b: List[Int]
) -> Int {
    let n_a: Int = list_len(words_a);
    let n_b: Int = list_len(words_b);
    let min_words: Int = if n_a < n_b { n_a } else { n_b };

    let mut total_distance: Int = 0;
    let mut i: Int = 0;
    while i < min_words {
        let w_a: Int = list_get(words_a, i);
        let w_b: Int = list_get(words_b, i);
        let dist: Int = bitwise_xor_popcount(w_a, w_b);
        total_distance = total_distance + dist;
        i = i + 1;
    }

    return total_distance;
}
