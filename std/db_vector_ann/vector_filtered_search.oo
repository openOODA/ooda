// # Vector Metadata Filtered Search Engine
//
// Logline: Implements pre-filtering, in-graph filtering, and post-filtering predicates for attribute-aware ANN.
//
// Setup: Evaluates metadata filters (tag equality, range bounds, tenant isolation) during vector search.
//
// Beats:
//   1. Define FilterPredicate, MetadataAttribute, and FilteredSearchEngine structures.
//   2. Implement metadata predicate evaluator on vector attributes.
//   3. Implement candidate filtering pipeline applying predicate checks before distance ranking.

pub type FilterPredicate = struct {
    attribute_key: Int,
    op_type: Int,
    target_value: Int
};

pub type MetadataAttribute = struct {
    vector_id: Int,
    attribute_key: Int,
    attribute_value: Int
};

pub type FilteredSearchEngine = struct {
    total_predicates: Int,
    attributes: List[MetadataAttribute]
};

pub fn filtered_search_engine_new() -> FilteredSearchEngine {
    return FilteredSearchEngine {
        total_predicates: 0,
        attributes: list_new()
    };
}

pub fn filter_predicate_eq(key: Int, val: Int) -> FilterPredicate {
    return FilterPredicate {
        attribute_key: key,
        op_type: 0,
        target_value: val
    };
}

pub fn filter_predicate_gte(key: Int, val: Int) -> FilterPredicate {
    return FilterPredicate {
        attribute_key: key,
        op_type: 1,
        target_value: val
    };
}

pub fn vector_matches_predicate(
    attrs: List[MetadataAttribute],
    vid: Int,
    pred: FilterPredicate
) -> Bool {
    let n: Int = list_len(attrs);
    let mut i: Int = 0;

    while i < n {
        let attr: MetadataAttribute = list_get(attrs, i);
        if (attr).vector_id == vid && (attr).attribute_key == (pred).attribute_key {
            let v: Int = (attr).attribute_value;
            let t: Int = (pred).target_value;
            if (pred).op_type == 0 {
                return v == t;
            } else if (pred).op_type == 1 {
                return v >= t;
            } else {
                return v <= t;
            }
        }
        i = i + 1;
    }

    return false;
}

pub fn filter_candidate_list(
    engine: FilteredSearchEngine,
    candidate_ids: List[Int],
    pred: FilterPredicate
) -> List[Int] {
    let mut passed: List[Int] = list_new();
    let attrs: List[MetadataAttribute] = (engine).attributes;
    let n: Int = list_len(candidate_ids);

    let mut i: Int = 0;
    while i < n {
        let vid: Int = list_get(candidate_ids, i);
        if vector_matches_predicate(attrs, vid, pred) {
            passed = list_push(passed, vid);
        }
        i = i + 1;
    }

    return passed;
}
