// # IVF Residual Vector Quantizer (IVF-PQ Residuals)
//
// Logline: Implements IVF residual vector calculation (v - c_i) and residual codebook quantization.
//
// Setup: Computes difference vectors between raw points and coarse centroids to reduce quantization variance.
//
// Beats:
//   1. Define ResidualConfig, ResidualVector, and IvfResidualCodec structures.
//   2. Implement vector subtraction yielding centered residual displacement vectors.
//   3. Implement residual vector reconstruction by adding coarse cluster centroid.

pub type ResidualConfig = struct {
    dimension: Int,
    scale_factor: Int,
};

pub type ResidualVector = struct {
    vector_id: Int,
    coarse_centroid_id: Int,
    residuals: List[Int],
};

pub type IvfResidualCodec = struct {
    config: ResidualConfig,
    total_processed: Int,
};

pub fn residual_config_default(dim: Int) -> ResidualConfig {
    return ResidualConfig {
        dimension: dim,
        scale_factor: 1,
    };
}

pub fn ivf_residual_codec_new(cfg: ResidualConfig) -> IvfResidualCodec {
    return IvfResidualCodec {
        config: cfg,
        total_processed: 0,
    };
}

pub fn ivf_compute_residual(
    vid: Int,
    cid: Int,
    raw_vec: List[Int],
    centroid_vec: List[Int]
) -> ResidualVector {
    let mut res_list: List[Int] = list_new();
    let dim: Int = list_len(raw_vec);

    let mut i: Int = 0;
    while i < dim {
        let rv: Int = list_get(raw_vec, i);
        let cv: Int = if i < list_len(centroid_vec) { list_get(centroid_vec, i) } else { 0 };
        res_list = list_push(res_list, rv - cv);
        i = i + 1;
    }

    return ResidualVector {
        vector_id: vid,
        coarse_centroid_id: cid,
        residuals: res_list,
    };
}

pub fn ivf_reconstruct_from_residual(
    res_vec: ResidualVector,
    centroid_vec: List[Int]
) -> List[Int] {
    let mut reconstructed: List[Int] = list_new();
    let res: List[Int] = (res_vec).residuals;
    let dim: Int = list_len(res);

    let mut i: Int = 0;
    while i < dim {
        let r: Int = list_get(res, i);
        let c: Int = if i < list_len(centroid_vec) { list_get(centroid_vec, i) } else { 0 };
        reconstructed = list_push(reconstructed, r + c);
        i = i + 1;
    }

    return reconstructed;
}
