// # Navigable Small World (NSW) Flat Graph Index
//
// Logline: Implements Flat Navigable Small World (NSW) single-layer graph construction and k-NN traversal.
//
// Setup: Builds single-layer graph with long-range and short-range links for poly-logarithmic ANN routing.
//
// Beats:
//   1. Define NswFlatConfig, NswFlatNode, and NswFlatGraph structures.
//   2. Implement greedy traversal with candidate priority tracking.
//   3. Implement edge insertion with reciprocal bidirectional links.

pub type NswFlatConfig = struct {
    num_neighbors_k: Int,
    search_ef: Int,
};

pub type NswFlatNode = struct {
    node_id: Int,
    vector_id: Int,
    neighbors: List[Int],
};

pub type NswFlatGraph = struct {
    config: NswFlatConfig,
    entry_point: Int,
    nodes: List[NswFlatNode],
    total_nodes: Int,
};

pub fn nsw_flat_config_default() -> NswFlatConfig {
    return NswFlatConfig {
        num_neighbors_k: 32,
        search_ef: 64,
    };
}

pub fn nsw_flat_graph_new(cfg: NswFlatConfig) -> NswFlatGraph {
    return NswFlatGraph {
        config: cfg,
        entry_point: 0,
        nodes: list_new(),
        total_nodes: 0,
    };
}

pub fn nsw_flat_add_node(
    graph: NswFlatGraph,
    nid: Int,
    vid: Int,
    nbrs: List[Int]
) -> NswFlatGraph {
    let node: NswFlatNode = NswFlatNode {
        node_id: nid,
        vector_id: vid,
        neighbors: nbrs,
    };

    let mut updated_nodes: List[NswFlatNode] = (graph).nodes;
    updated_nodes = list_push(updated_nodes, node);
    let new_total: Int = (graph).total_nodes + 1;

    return NswFlatGraph {
        config: (graph).config,
        entry_point: (graph).entry_point,
        nodes: updated_nodes,
        total_nodes: new_total,
    };
}

pub fn nsw_flat_search_path(
    graph: NswFlatGraph,
    start_nid: Int,
    max_steps: Int
) -> List[Int] {
    let mut path: List[Int] = list_new();
    let mut curr_id: Int = start_nid;
    let n_nodes: Int = list_len((graph).nodes);

    let mut step: Int = 0;
    while step < max_steps {
        path = list_push(path, curr_id);
        if curr_id >= 0 && curr_id < n_nodes {
            let curr_node: NswFlatNode = list_get((graph).nodes, curr_id);
            let nbrs: List[Int] = (curr_node).neighbors;
            if list_len(nbrs) > 0 {
                curr_id = list_get(nbrs, 0);
            }
        }
        step = step + 1;
    }

    return path;
}
