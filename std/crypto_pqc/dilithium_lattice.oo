// # Dilithium-5 lattice primitives
//
// Logline: Multiplies polynomials with NTT, samples a centered binomial, and splits coefficients with Power2Round.
//
// Setup: Pure. q is 8380417. d is 13. CBD uses eta 2. Length other than 256 is Err.
//
// Beats:
//   1. NTT-multiply two length-256 polynomials modulo X^256+1.
//   2. Matrix-vector t = a0 s0 + a1 s1 in the NTT domain.
//   3. Sample CBD coefficients from packed bits.
//   4. Power2Round into high and low halves.

import "std/crypto_pqc/dilithium_ntt.oo";

pub type DilOut = struct {
    flag: Int,
    err: String,
    n: Int,
    v0: Int,
    v1: Int,
    hi: Int,
    lo: Int
};

fn dl_err(m: String) -> DilOut {
    return DilOut { flag: 0, err: "ERR\tdilithium: " + m, n: 0, v0: 0, v1: 0, hi: 0, lo: 0 };
}

fn dl_mod(a: Int) -> Int {
    let mut x: Int = a % 8380417;
    if x < 0 {
        x = x + 8380417;
    }
    return x;
}

fn dl_ham2(b: Int) -> Int {
    let x: Int = b & 3;
    return (x & 1) + ((x >> 1) & 1);
}

pub fn dilithium_lattice_mul(a: List[Int], b: List[Int]) -> DilOut {
    let t: DilNtt = dilithium_ntt_mul(a, b);
    if dilithium_ntt_flag(t) < 1 {
        return dl_err("n");
    }
    return DilOut { flag: 1, err: "", n: dilithium_ntt_n(t), v0: dilithium_ntt_c0(t), v1: dilithium_ntt_c1(t), hi: dilithium_ntt_sum(t), lo: 0 };
}

pub fn dilithium_lattice_matvec(a0: List[Int], a1: List[Int], s0: List[Int], s1: List[Int]) -> DilOut {
    let t: DilNtt = dilithium_ntt_matvec(a0, a1, s0, s1);
    if dilithium_ntt_flag(t) < 1 {
        return dl_err("n");
    }
    return DilOut { flag: 1, err: "", n: dilithium_ntt_n(t), v0: dilithium_ntt_c0(t), v1: dilithium_ntt_c1(t), hi: dilithium_ntt_sum(t), lo: 0 };
}

pub fn dilithium_lattice_cbd(buf: List[Int]) -> DilOut {
    if list_len(buf) < 4 {
        return dl_err("short");
    }
    let mut v0: Int = 0;
    let mut v1: Int = 0;
    let mut i: Int = 0;
    while i < list_len(buf) {
        let b: Int = list_get(buf, i) & 255;
        let c0: Int = dl_ham2(b) - dl_ham2(b >> 2);
        let c1: Int = dl_ham2(b >> 4) - dl_ham2(b >> 6);
        if i == 0 {
            v0 = c0;
            v1 = c1;
        }
        i = i + 1;
    }
    return DilOut { flag: 1, err: "", n: list_len(buf) * 2, v0: v0, v1: v1, hi: 0, lo: 0 };
}

pub fn dilithium_lattice_power2round(r: Int) -> DilOut {
    let d: Int = 8192;
    let half: Int = 4096;
    let rr: Int = dl_mod(r);
    let lo: Int = rr % d;
    let mut hi: Int = rr / d;
    if lo >= half {
        hi = hi + 1;
        return DilOut { flag: 1, err: "", n: 1, v0: rr, v1: 0, hi: hi, lo: lo - d };
    }
    return DilOut { flag: 1, err: "", n: 1, v0: rr, v1: 0, hi: hi, lo: lo };
}

pub fn dilithium_lattice_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn dilithium_lattice_flag(o: DilOut) -> Int {
    return o.flag;
}
pub fn dilithium_lattice_err(o: DilOut) -> String {
    return o.err;
}
