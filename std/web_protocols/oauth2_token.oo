// # OAuth2 token (RFC 6749/6750 Int destub)
//
// Logline: Expiry is issued_at + expires_in*1000. Bearer prefix B/b e a r e r space.
//
// Setup: Token ids are Int. Off pub type / String / &T.
//
// Beats:
//   1. expired iff now_ms >= issued_at_ms + expires_in*1000.
//   2. has_scope is exact scope id match.
//   3. Bearer header n>=8 and 7-byte prefix then remainder token.

type OAuth2Token = struct {
    access_token: Int,
    token_type: Int,
    expires_in: Int,
    refresh_token: Int,
    scope: Int,
    issued_at_ms: Int
};

type OAuth2BearerAuth = struct {
    token: Int,
    is_valid: Int
};

pub fn oauth2_token_new(
    access_token: Int,
    token_type: Int,
    expires_in: Int,
    refresh_token: Int,
    scope: Int,
    now_ms: Int
) -> OAuth2Token {
    return OAuth2Token {
        access_token: access_token,
        token_type: token_type,
        expires_in: expires_in,
        refresh_token: refresh_token,
        scope: scope,
        issued_at_ms: now_ms
    };
}

pub fn oauth2_token_expires_at(token: OAuth2Token) -> Int {
    return token.issued_at_ms + (token.expires_in * 1000);
}

pub fn oauth2_token_is_expired(token: OAuth2Token, now_ms: Int) -> Int {
    let exp_ms: Int = oauth2_token_expires_at(token);
    if now_ms >= exp_ms {
        return 1;
    }
    return 0;
}

pub fn oauth2_token_has_scope(token: OAuth2Token, target_scope: Int) -> Int {
    if token.scope == target_scope {
        return 1;
    }
    return 0;
}

pub fn oauth2_is_bearer_prefix(b0: Int, b1: Int, b2: Int, b3: Int, b4: Int, b5: Int, b6: Int) -> Int {
    let c0: Int = if b0 == 66 { 1 } else { if b0 == 98 { 1 } else { 0 } };
    if c0 == 0 {
        return 0;
    }
    if b1 != 101 {
        return 0;
    }
    if b2 != 97 {
        return 0;
    }
    if b3 != 114 {
        return 0;
    }
    if b4 != 101 {
        return 0;
    }
    if b5 != 114 {
        return 0;
    }
    if b6 != 32 {
        return 0;
    }
    return 1;
}

pub fn oauth2_parse_bearer(
    n_header: Int,
    b0: Int,
    b1: Int,
    b2: Int,
    b3: Int,
    b4: Int,
    b5: Int,
    b6: Int,
    rest: Int
) -> OAuth2BearerAuth {
    if n_header < 8 {
        return OAuth2BearerAuth { token: 0, is_valid: 0 };
    }
    if oauth2_is_bearer_prefix(b0, b1, b2, b3, b4, b5, b6) == 0 {
        return OAuth2BearerAuth { token: 0, is_valid: 0 };
    }
    return OAuth2BearerAuth { token: rest, is_valid: 1 };
}
