// # JSON-RPC 2.0 dispatcher (Int destub)
//
// Logline: 4-slot method table, auth gate, standard errors. By-value Int destub.
//
// Setup: n_routes / n_calls / n_errors not count. Imports destubbed request/response.
//
// Beats:
//   1. register fills next empty method/auth slot (max 4).
//   2. invalid request -32600; missing method -32601; auth fail -32000.
//   3. dispatch increments n_calls; errors increment n_errors.

import "./jsonrpc_request.oo";
import "./jsonrpc_response.oo";

type JsonRpcDispatcher = struct {
    m0: Int,
    auth0: Int,
    m1: Int,
    auth1: Int,
    m2: Int,
    auth2: Int,
    m3: Int,
    auth3: Int,
    n_routes: Int,
    n_calls: Int,
    n_errors: Int
};

type JsonRpcDispatchResult = struct {
    n_calls: Int,
    n_errors: Int,
    n_routes: Int,
    result: Int,
    err_code: Int,
    id: Int,
    is_error: Int
};

pub fn jsonrpc_dispatcher_new() -> JsonRpcDispatcher {
    return JsonRpcDispatcher {
        m0: 0,
        auth0: 0,
        m1: 0,
        auth1: 0,
        m2: 0,
        auth2: 0,
        m3: 0,
        auth3: 0,
        n_routes: 0,
        n_calls: 0,
        n_errors: 0
    };
}

pub fn jsonrpc_dispatcher_register(disp: JsonRpcDispatcher, method: Int, requires_auth: Int) -> JsonRpcDispatcher {
    if disp.n_routes == 0 {
        return JsonRpcDispatcher {
            m0: method,
            auth0: requires_auth,
            m1: disp.m1,
            auth1: disp.auth1,
            m2: disp.m2,
            auth2: disp.auth2,
            m3: disp.m3,
            auth3: disp.auth3,
            n_routes: 1,
            n_calls: disp.n_calls,
            n_errors: disp.n_errors
        };
    }
    if disp.n_routes == 1 {
        return JsonRpcDispatcher {
            m0: disp.m0,
            auth0: disp.auth0,
            m1: method,
            auth1: requires_auth,
            m2: disp.m2,
            auth2: disp.auth2,
            m3: disp.m3,
            auth3: disp.auth3,
            n_routes: 2,
            n_calls: disp.n_calls,
            n_errors: disp.n_errors
        };
    }
    if disp.n_routes == 2 {
        return JsonRpcDispatcher {
            m0: disp.m0,
            auth0: disp.auth0,
            m1: disp.m1,
            auth1: disp.auth1,
            m2: method,
            auth2: requires_auth,
            m3: disp.m3,
            auth3: disp.auth3,
            n_routes: 3,
            n_calls: disp.n_calls,
            n_errors: disp.n_errors
        };
    }
    if disp.n_routes == 3 {
        return JsonRpcDispatcher {
            m0: disp.m0,
            auth0: disp.auth0,
            m1: disp.m1,
            auth1: disp.auth1,
            m2: disp.m2,
            auth2: disp.auth2,
            m3: method,
            auth3: requires_auth,
            n_routes: 4,
            n_calls: disp.n_calls,
            n_errors: disp.n_errors
        };
    }
    return disp;
}

pub fn jsonrpc_dispatcher_has_method(disp: JsonRpcDispatcher, method: Int) -> Int {
    if disp.n_routes > 0 {
        if disp.m0 == method {
            return 1;
        }
    }
    if disp.n_routes > 1 {
        if disp.m1 == method {
            return 1;
        }
    }
    if disp.n_routes > 2 {
        if disp.m2 == method {
            return 1;
        }
    }
    if disp.n_routes > 3 {
        if disp.m3 == method {
            return 1;
        }
    }
    return 0;
}

pub fn jsonrpc_dispatcher_method_auth(disp: JsonRpcDispatcher, method: Int) -> Int {
    if disp.n_routes > 0 {
        if disp.m0 == method {
            return disp.auth0;
        }
    }
    if disp.n_routes > 1 {
        if disp.m1 == method {
            return disp.auth1;
        }
    }
    if disp.n_routes > 2 {
        if disp.m2 == method {
            return disp.auth2;
        }
    }
    if disp.n_routes > 3 {
        if disp.m3 == method {
            return disp.auth3;
        }
    }
    return 0;
}

pub fn jsonrpc_dispatcher_n_routes(disp: JsonRpcDispatcher) -> Int {
    return disp.n_routes;
}

pub fn jsonrpc_dispatcher_dispatch(
    disp: JsonRpcDispatcher,
    req: JsonRpcRequest,
    is_authenticated: Int
) -> JsonRpcDispatchResult {
    let calls: Int = disp.n_calls + 1;
    if jsonrpc_request_validate(req) == 0 {
        return JsonRpcDispatchResult {
            n_calls: calls,
            n_errors: disp.n_errors + 1,
            n_routes: disp.n_routes,
            result: 0,
            err_code: 0 - 32600,
            id: req.id,
            is_error: 1
        };
    }
    if jsonrpc_dispatcher_has_method(disp, req.method) == 0 {
        return JsonRpcDispatchResult {
            n_calls: calls,
            n_errors: disp.n_errors + 1,
            n_routes: disp.n_routes,
            result: 0,
            err_code: 0 - 32601,
            id: req.id,
            is_error: 1
        };
    }
    if jsonrpc_dispatcher_method_auth(disp, req.method) == 1 {
        if is_authenticated == 0 {
            return JsonRpcDispatchResult {
                n_calls: calls,
                n_errors: disp.n_errors + 1,
                n_routes: disp.n_routes,
                result: 0,
                err_code: 0 - 32000,
                id: req.id,
                is_error: 1
            };
        }
    }
    return JsonRpcDispatchResult {
        n_calls: calls,
        n_errors: disp.n_errors,
        n_routes: disp.n_routes,
        result: req.method,
        err_code: 0,
        id: req.id,
        is_error: 0
    };
}
