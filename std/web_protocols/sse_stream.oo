// # SSE stream (RFC 8895 Int destub)
//
// Logline: Comment/data/id/event/retry frame flags. By-value Int destub.
//
// Setup: id/event/data are Int. Comment if first byte is 58 (':').
//
// Beats:
//   1. comment events set is_comment=1; data-only leaves id/event/retry 0.
//   2. heartbeat if comment or data is ping 1885954663 or keep 1801807216.
//   3. frame_kind: comment=1 else 2 + id4 + event8 + retry16.

type SseEvent = struct {
    id: Int,
    event_type: Int,
    data: Int,
    retry_ms: Int,
    is_comment: Int
};

pub fn sse_event_new(id: Int, event_type: Int, data: Int, retry_ms: Int) -> SseEvent {
    return SseEvent {
        id: id,
        event_type: event_type,
        data: data,
        retry_ms: retry_ms,
        is_comment: 0
    };
}

pub fn sse_event_data(data: Int) -> SseEvent {
    return SseEvent {
        id: 0,
        event_type: 0,
        data: data,
        retry_ms: 0,
        is_comment: 0
    };
}

pub fn sse_event_comment(comment: Int) -> SseEvent {
    return SseEvent {
        id: 0,
        event_type: 0,
        data: comment,
        retry_ms: 0,
        is_comment: 1
    };
}

pub fn sse_ping_data() -> Int {
    return (112 * 16777216) + (105 * 65536) + (110 * 256) + 103;
}

pub fn sse_keepalive_data() -> Int {
    return (107 * 16777216) + (101 * 65536) + (101 * 256) + 112;
}

pub fn sse_is_heartbeat(event: SseEvent) -> Int {
    if event.is_comment == 1 {
        return 1;
    }
    if event.data == sse_ping_data() {
        return 1;
    }
    if event.data == sse_keepalive_data() {
        return 1;
    }
    return 0;
}

pub fn sse_frame_kind(event: SseEvent) -> Int {
    if event.is_comment == 1 {
        return 1;
    }
    let id_bit: Int = if event.id != 0 { 4 } else { 0 };
    let ev_bit: Int = if event.event_type != 0 { 8 } else { 0 };
    let retry_bit: Int = if event.retry_ms > 0 { 16 } else { 0 };
    return 2 + id_bit + ev_bit + retry_bit;
}

pub fn sse_parse_first(b0: Int, data: Int) -> SseEvent {
    if b0 == 58 {
        return sse_event_comment(data);
    }
    return sse_event_data(data);
}
