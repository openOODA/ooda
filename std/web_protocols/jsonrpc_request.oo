// # JSON-RPC 2.0 request (Int destub)
//
// Logline: Version 20, method id, notification iff id==0. By-value Int destub.
//
// Setup: jsonrpc_version 20 is "2.0". Method 0 is empty. No field named len.
//
// Beats:
//   1. request_new sets notification=0; valid iff method != 0.
//   2. notification_new sets id=0 notification=1; valid iff method != 0.
//   3. validate requires version==20 and method != 0.

type JsonRpcRequest = struct {
    jsonrpc_version: Int,
    method: Int,
    params: Int,
    id: Int,
    is_notification: Int,
    is_valid: Int
};

pub fn jsonrpc_request_new(method: Int, params: Int, id: Int) -> JsonRpcRequest {
    let valid_m: Int = if method != 0 { 1 } else { 0 };
    return JsonRpcRequest {
        jsonrpc_version: 20,
        method: method,
        params: params,
        id: id,
        is_notification: 0,
        is_valid: valid_m
    };
}

pub fn jsonrpc_notification_new(method: Int, params: Int) -> JsonRpcRequest {
    let valid_m: Int = if method != 0 { 1 } else { 0 };
    return JsonRpcRequest {
        jsonrpc_version: 20,
        method: method,
        params: params,
        id: 0,
        is_notification: 1,
        is_valid: valid_m
    };
}

pub fn jsonrpc_is_notification(req: JsonRpcRequest) -> Int {
    if req.is_notification == 1 {
        return 1;
    }
    if req.id == 0 {
        return 1;
    }
    return 0;
}

pub fn jsonrpc_request_with_version(version: Int, method: Int, params: Int, id: Int) -> JsonRpcRequest {
    let valid_m: Int = if method != 0 { 1 } else { 0 };
    return JsonRpcRequest {
        jsonrpc_version: version,
        method: method,
        params: params,
        id: id,
        is_notification: 0,
        is_valid: valid_m
    };
}

pub fn jsonrpc_request_validate(req: JsonRpcRequest) -> Int {
    if req.jsonrpc_version != 20 {
        return 0;
    }
    if req.method == 0 {
        return 0;
    }
    return 1;
}
