// # HTTP/3 and QUIC Protocol Transport
//
// Logline: Handle HTTP/3 frame types, stream multiplexing, and QPACK field compression over QUIC transport connections.
//
// Setup: Pure network protocol codec for modern high-speed HTTP/3 and QUIC transport streams.
//
// Beats:
//   1. Define Http3QuicFrame and Http3QuicStream structures.
//   2. Encode HTTP/3 DATA (0x00) and HEADERS (0x01) frame headers with variable-length integers.
//   3. Manage unidirectional control streams and bidirectional request streams.
//   4. Validate zero head-of-line blocking across independent streams.

pub type Http3QuicFrame = struct {
    frame_type: Int,
    payload_length: Int,
    stream_id: Int,
    is_fin: Bool
};

pub type Http3QuicStream = struct {
    stream_id: Int,
    is_unidirectional: Bool,
    bytes_sent: Int,
    bytes_received: Int
};

pub fn http3_quic_frame_new(f_type: Int, len: Int, sid: Int, fin: Bool) -> Http3QuicFrame { return Http3QuicFrame {
        frame_type: f_type,
        payload_length: len,
        stream_id: sid,
        is_fin: fin
    }; }

pub fn http3_quic_stream_new(sid: Int, unidir: Bool) -> Http3QuicStream { return Http3QuicStream {
        stream_id: sid,
        is_unidirectional: unidir,
        bytes_sent: 0,
        bytes_received: 0
    }; }

pub fn http3_quic_is_control_stream(stream: Http3QuicStream) -> Bool {
    let u: Bool = stream.is_unidirectional;
    let s: Int = stream.stream_id;
    return u && (s == 2 || s == 3);
}
