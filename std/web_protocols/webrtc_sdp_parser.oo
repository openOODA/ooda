// # SDP session (RFC 4566 Int destub)
//
// Logline: v=/o=/s=/m=/a= line dispatch; ICE/DTLS attrs. Off pub type / String / &mut / List.
//
// Setup: media 1=audio 2=video. Default m= port 9 fmt 111 clock 48000. n_media not count.
//
// Beats:
//   1. starts_with compares prefix bytes; v= sets version 0 valid.
//   2. m= audio if 97,117,100,105,111 else video; port 9 fmt 111 clock 48000.
//   3. a= ice-ufrag/ice-pwd/fingerprint; ice ok iff both ids != 0.

type SdpMediaDesc = struct {
    media_type: Int,
    port: Int,
    proto: Int,
    fmt: Int,
    codec_name: Int,
    clock_rate: Int
};

type SdpSession = struct {
    version: Int,
    origin: Int,
    session_name: Int,
    ice_ufrag: Int,
    ice_pwd: Int,
    dtls_fingerprint: Int,
    m0_type: Int,
    m0_port: Int,
    m0_fmt: Int,
    m0_clock: Int,
    n_media: Int,
    is_valid: Int
};

pub fn sdp_media_desc_new(media_type: Int, port: Int, proto: Int, fmt: Int, codec: Int, clock: Int) -> SdpMediaDesc {
    return SdpMediaDesc {
        media_type: media_type,
        port: port,
        proto: proto,
        fmt: fmt,
        codec_name: codec,
        clock_rate: clock
    };
}

pub fn sdp_session_new() -> SdpSession {
    return SdpSession {
        version: 0,
        origin: 0,
        session_name: 45,
        ice_ufrag: 0,
        ice_pwd: 0,
        dtls_fingerprint: 0,
        m0_type: 0,
        m0_port: 0,
        m0_fmt: 0,
        m0_clock: 0,
        n_media: 0,
        is_valid: 0
    };
}

pub fn sdp_value_n(line_n: Int, start_idx: Int) -> Int {
    if start_idx >= line_n {
        return 0;
    }
    return line_n - start_idx;
}

pub fn sdp_starts_with(s0: Int, s1: Int, s2: Int, p0: Int, p1: Int, p2: Int, p_n: Int) -> Int {
    if p_n <= 0 {
        return 1;
    }
    if s0 != p0 {
        return 0;
    }
    if p_n == 1 {
        return 1;
    }
    if s1 != p1 {
        return 0;
    }
    if p_n == 2 {
        return 1;
    }
    if s2 != p2 {
        return 0;
    }
    return 1;
}

pub fn sdp_media_kind(a0: Int, a1: Int, a2: Int, a3: Int, a4: Int) -> Int {
    if a0 == 97 {
        if a1 == 117 {
            if a2 == 100 {
                if a3 == 105 {
                    if a4 == 111 {
                        return 1;
                    }
                }
            }
        }
    }
    return 2;
}

pub fn sdp_attr_kind(b0: Int, b1: Int, b2: Int, b3: Int, b4: Int) -> Int {
    if b0 == 105 {
        if b1 == 99 {
            if b2 == 101 {
                if b3 == 45 {
                    if b4 == 117 {
                        return 1;
                    }
                    if b4 == 112 {
                        return 2;
                    }
                }
            }
        }
    }
    if b0 == 102 {
        return 3;
    }
    return 0;
}

pub fn sdp_parse_line(session: SdpSession, b0: Int, b1: Int, payload: Int, extra: Int) -> SdpSession {
    if b1 != 61 {
        return session;
    }
    if b0 == 118 {
        return SdpSession {
            version: 0,
            origin: session.origin,
            session_name: session.session_name,
            ice_ufrag: session.ice_ufrag,
            ice_pwd: session.ice_pwd,
            dtls_fingerprint: session.dtls_fingerprint,
            m0_type: session.m0_type,
            m0_port: session.m0_port,
            m0_fmt: session.m0_fmt,
            m0_clock: session.m0_clock,
            n_media: session.n_media,
            is_valid: 1
        };
    }
    if b0 == 111 {
        return SdpSession {
            version: session.version,
            origin: payload,
            session_name: session.session_name,
            ice_ufrag: session.ice_ufrag,
            ice_pwd: session.ice_pwd,
            dtls_fingerprint: session.dtls_fingerprint,
            m0_type: session.m0_type,
            m0_port: session.m0_port,
            m0_fmt: session.m0_fmt,
            m0_clock: session.m0_clock,
            n_media: session.n_media,
            is_valid: session.is_valid
        };
    }
    if b0 == 115 {
        return SdpSession {
            version: session.version,
            origin: session.origin,
            session_name: payload,
            ice_ufrag: session.ice_ufrag,
            ice_pwd: session.ice_pwd,
            dtls_fingerprint: session.dtls_fingerprint,
            m0_type: session.m0_type,
            m0_port: session.m0_port,
            m0_fmt: session.m0_fmt,
            m0_clock: session.m0_clock,
            n_media: session.n_media,
            is_valid: session.is_valid
        };
    }
    if b0 == 109 {
        let n_m: Int = session.n_media + 1;
        return SdpSession {
            version: session.version,
            origin: session.origin,
            session_name: session.session_name,
            ice_ufrag: session.ice_ufrag,
            ice_pwd: session.ice_pwd,
            dtls_fingerprint: session.dtls_fingerprint,
            m0_type: extra,
            m0_port: 9,
            m0_fmt: 111,
            m0_clock: 48000,
            n_media: n_m,
            is_valid: session.is_valid
        };
    }
    if b0 == 97 {
        if extra == 1 {
            return SdpSession {
                version: session.version,
                origin: session.origin,
                session_name: session.session_name,
                ice_ufrag: payload,
                ice_pwd: session.ice_pwd,
                dtls_fingerprint: session.dtls_fingerprint,
                m0_type: session.m0_type,
                m0_port: session.m0_port,
                m0_fmt: session.m0_fmt,
                m0_clock: session.m0_clock,
                n_media: session.n_media,
                is_valid: session.is_valid
            };
        }
        if extra == 2 {
            return SdpSession {
                version: session.version,
                origin: session.origin,
                session_name: session.session_name,
                ice_ufrag: session.ice_ufrag,
                ice_pwd: payload,
                dtls_fingerprint: session.dtls_fingerprint,
                m0_type: session.m0_type,
                m0_port: session.m0_port,
                m0_fmt: session.m0_fmt,
                m0_clock: session.m0_clock,
                n_media: session.n_media,
                is_valid: session.is_valid
            };
        }
        if extra == 3 {
            return SdpSession {
                version: session.version,
                origin: session.origin,
                session_name: session.session_name,
                ice_ufrag: session.ice_ufrag,
                ice_pwd: session.ice_pwd,
                dtls_fingerprint: payload,
                m0_type: session.m0_type,
                m0_port: session.m0_port,
                m0_fmt: session.m0_fmt,
                m0_clock: session.m0_clock,
                n_media: session.n_media,
                is_valid: session.is_valid
            };
        }
    }
    return session;
}

pub fn sdp_media_n(session: SdpSession) -> Int {
    return session.n_media;
}

pub fn sdp_has_ice_credentials(session: SdpSession) -> Int {
    if session.ice_ufrag != 0 {
        if session.ice_pwd != 0 {
            return 1;
        }
    }
    return 0;
}

pub fn sdp_has_dtls_fingerprint(session: SdpSession) -> Int {
    if session.dtls_fingerprint != 0 {
        return 1;
    }
    return 0;
}
