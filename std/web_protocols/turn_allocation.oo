// # TURN allocation (RFC 5766/8656 Int destub)
//
// Logline: Relay lifetime, channel bind 0x4000..0x7FFE. By-value Int destub.
//
// Setup: IPs are Int. Two bind slots. Binding lifetime 600s. n_binds not count.
//
// Beats:
//   1. expires_at_ms = now_ms + lifetime_sec*1000.
//   2. expired if inactive or now_ms >= expires_at_ms.
//   3. channel bind rejects outside 16384..32766.

type TurnChannelBind = struct {
    channel_number: Int,
    peer_ip: Int,
    peer_port: Int,
    expires_at_ms: Int
};

type TurnAllocation = struct {
    client_ip: Int,
    client_port: Int,
    relay_ip: Int,
    relay_port: Int,
    lifetime_sec: Int,
    expires_at_ms: Int,
    is_active: Int,
    ch0: Int,
    peer0: Int,
    port0: Int,
    exp0: Int,
    ch1: Int,
    peer1: Int,
    port1: Int,
    exp1: Int,
    n_binds: Int
};

pub fn turn_channel_bind_new(channel_num: Int, peer_ip: Int, peer_port: Int, exp_ms: Int) -> TurnChannelBind {
    return TurnChannelBind {
        channel_number: channel_num,
        peer_ip: peer_ip,
        peer_port: peer_port,
        expires_at_ms: exp_ms
    };
}

pub fn turn_allocation_new(
    client_ip: Int,
    client_port: Int,
    relay_ip: Int,
    relay_port: Int,
    lifetime_sec: Int,
    now_ms: Int
) -> TurnAllocation {
    let exp_ms: Int = now_ms + (lifetime_sec * 1000);
    return TurnAllocation {
        client_ip: client_ip,
        client_port: client_port,
        relay_ip: relay_ip,
        relay_port: relay_port,
        lifetime_sec: lifetime_sec,
        expires_at_ms: exp_ms,
        is_active: 1,
        ch0: 0,
        peer0: 0,
        port0: 0,
        exp0: 0,
        ch1: 0,
        peer1: 0,
        port1: 0,
        exp1: 0,
        n_binds: 0
    };
}

pub fn turn_allocation_is_expired(alloc: TurnAllocation, now_ms: Int) -> Int {
    if alloc.is_active == 0 {
        return 1;
    }
    if now_ms >= alloc.expires_at_ms {
        return 1;
    }
    return 0;
}

pub fn turn_allocation_refresh(alloc: TurnAllocation, lifetime_sec: Int, now_ms: Int) -> TurnAllocation {
    if alloc.is_active == 0 {
        return alloc;
    }
    return TurnAllocation {
        client_ip: alloc.client_ip,
        client_port: alloc.client_port,
        relay_ip: alloc.relay_ip,
        relay_port: alloc.relay_port,
        lifetime_sec: lifetime_sec,
        expires_at_ms: now_ms + (lifetime_sec * 1000),
        is_active: alloc.is_active,
        ch0: alloc.ch0,
        peer0: alloc.peer0,
        port0: alloc.port0,
        exp0: alloc.exp0,
        ch1: alloc.ch1,
        peer1: alloc.peer1,
        port1: alloc.port1,
        exp1: alloc.exp1,
        n_binds: alloc.n_binds
    };
}

pub fn turn_channel_in_range(ch_num: Int) -> Int {
    if ch_num < 16384 {
        return 0;
    }
    if ch_num > 32766 {
        return 0;
    }
    return 1;
}

pub fn turn_allocation_bind_channel(
    alloc: TurnAllocation,
    ch_num: Int,
    peer_ip: Int,
    peer_port: Int,
    now_ms: Int
) -> TurnAllocation {
    if turn_channel_in_range(ch_num) == 0 {
        return alloc;
    }
    let bind_exp: Int = now_ms + (600 * 1000);
    if alloc.n_binds == 0 {
        return TurnAllocation {
            client_ip: alloc.client_ip,
            client_port: alloc.client_port,
            relay_ip: alloc.relay_ip,
            relay_port: alloc.relay_port,
            lifetime_sec: alloc.lifetime_sec,
            expires_at_ms: alloc.expires_at_ms,
            is_active: alloc.is_active,
            ch0: ch_num,
            peer0: peer_ip,
            port0: peer_port,
            exp0: bind_exp,
            ch1: alloc.ch1,
            peer1: alloc.peer1,
            port1: alloc.port1,
            exp1: alloc.exp1,
            n_binds: 1
        };
    }
    if alloc.n_binds == 1 {
        return TurnAllocation {
            client_ip: alloc.client_ip,
            client_port: alloc.client_port,
            relay_ip: alloc.relay_ip,
            relay_port: alloc.relay_port,
            lifetime_sec: alloc.lifetime_sec,
            expires_at_ms: alloc.expires_at_ms,
            is_active: alloc.is_active,
            ch0: alloc.ch0,
            peer0: alloc.peer0,
            port0: alloc.port0,
            exp0: alloc.exp0,
            ch1: ch_num,
            peer1: peer_ip,
            port1: peer_port,
            exp1: bind_exp,
            n_binds: 2
        };
    }
    return alloc;
}

pub fn turn_allocation_has_channel(alloc: TurnAllocation, ch_num: Int) -> Int {
    if alloc.n_binds > 0 {
        if alloc.ch0 == ch_num {
            return 1;
        }
    }
    if alloc.n_binds > 1 {
        if alloc.ch1 == ch_num {
            return 1;
        }
    }
    return 0;
}

pub fn turn_allocation_deallocate(alloc: TurnAllocation) -> TurnAllocation {
    return TurnAllocation {
        client_ip: alloc.client_ip,
        client_port: alloc.client_port,
        relay_ip: alloc.relay_ip,
        relay_port: alloc.relay_port,
        lifetime_sec: 0,
        expires_at_ms: 0,
        is_active: 0,
        ch0: alloc.ch0,
        peer0: alloc.peer0,
        port0: alloc.port0,
        exp0: alloc.exp0,
        ch1: alloc.ch1,
        peer1: alloc.peer1,
        port1: alloc.port1,
        exp1: alloc.exp1,
        n_binds: alloc.n_binds
    };
}
