// # CSP Level 3 policy bits (Int destub floor)
//
// Logline: Source bitfield; strict defaults self/none. Off pub type / String / List / &mut.
//
// Setup: self=1 none=2 unsafe-inline=4 unsafe-eval=8 https=16 nonce=32. report_only 0/1.
//
// Beats:
//   1. strict: default/script/style self; object/frame-ancestors none.
//   2. add_directive ORs bits into the named slot.
//   3. header_kind is report_only (0 enforce / 1 report-only).

type CspDirective = struct {
    name: Int,
    sources: Int
};

type CspPolicy = struct {
    default_src: Int,
    script_src: Int,
    style_src: Int,
    object_src: Int,
    frame_ancestors: Int,
    report_only: Int,
    report_uri: Int
};

pub fn csp_src_self() -> Int {
    return 1;
}

pub fn csp_src_none() -> Int {
    return 2;
}

pub fn csp_src_unsafe_inline() -> Int {
    return 4;
}

pub fn csp_src_unsafe_eval() -> Int {
    return 8;
}

pub fn csp_src_https() -> Int {
    return 16;
}

pub fn csp_src_nonce() -> Int {
    return 32;
}

pub fn csp_directive_new(name: Int, sources: Int) -> CspDirective {
    return CspDirective {
        name: name,
        sources: sources
    };
}

pub fn csp_policy_new_strict() -> CspPolicy {
    return CspPolicy {
        default_src: 1,
        script_src: 1,
        style_src: 1,
        object_src: 2,
        frame_ancestors: 2,
        report_only: 0,
        report_uri: 0
    };
}

pub fn csp_has_source(sources: Int, bit: Int) -> Int {
    if bit <= 0 {
        return 0;
    }
    if ((sources / bit) % 2) == 1 {
        return 1;
    }
    return 0;
}

pub fn csp_policy_add_directive(policy: CspPolicy, directive: CspDirective) -> CspPolicy {
    if directive.name == 0 {
        return CspPolicy {
            default_src: policy.default_src + directive.sources,
            script_src: policy.script_src,
            style_src: policy.style_src,
            object_src: policy.object_src,
            frame_ancestors: policy.frame_ancestors,
            report_only: policy.report_only,
            report_uri: policy.report_uri
        };
    }
    if directive.name == 1 {
        return CspPolicy {
            default_src: policy.default_src,
            script_src: policy.script_src + directive.sources,
            style_src: policy.style_src,
            object_src: policy.object_src,
            frame_ancestors: policy.frame_ancestors,
            report_only: policy.report_only,
            report_uri: policy.report_uri
        };
    }
    if directive.name == 2 {
        return CspPolicy {
            default_src: policy.default_src,
            script_src: policy.script_src,
            style_src: policy.style_src + directive.sources,
            object_src: policy.object_src,
            frame_ancestors: policy.frame_ancestors,
            report_only: policy.report_only,
            report_uri: policy.report_uri
        };
    }
    if directive.name == 3 {
        return CspPolicy {
            default_src: policy.default_src,
            script_src: policy.script_src,
            style_src: policy.style_src,
            object_src: policy.object_src + directive.sources,
            frame_ancestors: policy.frame_ancestors,
            report_only: policy.report_only,
            report_uri: policy.report_uri
        };
    }
    if directive.name == 4 {
        return CspPolicy {
            default_src: policy.default_src,
            script_src: policy.script_src,
            style_src: policy.style_src,
            object_src: policy.object_src,
            frame_ancestors: policy.frame_ancestors + directive.sources,
            report_only: policy.report_only,
            report_uri: policy.report_uri
        };
    }
    return policy;
}

pub fn csp_header_kind(policy: CspPolicy) -> Int {
    return policy.report_only;
}

pub fn csp_policy_report_only(policy: CspPolicy, report_uri: Int) -> CspPolicy {
    return CspPolicy {
        default_src: policy.default_src,
        script_src: policy.script_src,
        style_src: policy.style_src,
        object_src: policy.object_src,
        frame_ancestors: policy.frame_ancestors,
        report_only: 1,
        report_uri: report_uri
    };
}
