// # RTCP SR/RR (RFC 3550 Int destub)
//
// Logline: Sender PT=200, receiver PT=201, report-block slots. By-value Int destub.
//
// Setup: Two report slots. n_packets / n_octets / n_reports not count.
//
// Beats:
//   1. SR carries NTP/RTP timestamps plus packet and octet totals.
//   2. add_report fills next empty slot (max 2).
//   3. payload type 200 is SR, 201 is RR.

type RtcpReportBlock = struct {
    ssrc: Int,
    fraction_lost: Int,
    cumulative_lost: Int,
    highest_seq: Int,
    jitter: Int,
    lsr: Int,
    dlsr: Int
};

type RtcpSenderReport = struct {
    ssrc: Int,
    ntp_sec: Int,
    ntp_frac: Int,
    rtp_ts: Int,
    n_packets: Int,
    n_octets: Int,
    r0_ssrc: Int,
    r0_frac: Int,
    r0_lost: Int,
    r0_jitter: Int,
    r1_ssrc: Int,
    r1_frac: Int,
    r1_lost: Int,
    r1_jitter: Int,
    n_reports: Int
};

type RtcpReceiverReport = struct {
    ssrc: Int,
    r0_ssrc: Int,
    r0_frac: Int,
    r0_lost: Int,
    r0_jitter: Int,
    r1_ssrc: Int,
    r1_frac: Int,
    r1_lost: Int,
    r1_jitter: Int,
    n_reports: Int
};

pub fn rtcp_report_block_new(
    ssrc: Int,
    frac_lost: Int,
    cum_lost: Int,
    highest_seq: Int,
    jitter: Int,
    lsr: Int,
    dlsr: Int
) -> RtcpReportBlock {
    return RtcpReportBlock {
        ssrc: ssrc,
        fraction_lost: frac_lost,
        cumulative_lost: cum_lost,
        highest_seq: highest_seq,
        jitter: jitter,
        lsr: lsr,
        dlsr: dlsr
    };
}

pub fn rtcp_sr_new(
    ssrc: Int,
    ntp_sec: Int,
    ntp_frac: Int,
    rtp_ts: Int,
    pkts: Int,
    octets: Int
) -> RtcpSenderReport {
    return RtcpSenderReport {
        ssrc: ssrc,
        ntp_sec: ntp_sec,
        ntp_frac: ntp_frac,
        rtp_ts: rtp_ts,
        n_packets: pkts,
        n_octets: octets,
        r0_ssrc: 0,
        r0_frac: 0,
        r0_lost: 0,
        r0_jitter: 0,
        r1_ssrc: 0,
        r1_frac: 0,
        r1_lost: 0,
        r1_jitter: 0,
        n_reports: 0
    };
}

pub fn rtcp_rr_new(ssrc: Int) -> RtcpReceiverReport {
    return RtcpReceiverReport {
        ssrc: ssrc,
        r0_ssrc: 0,
        r0_frac: 0,
        r0_lost: 0,
        r0_jitter: 0,
        r1_ssrc: 0,
        r1_frac: 0,
        r1_lost: 0,
        r1_jitter: 0,
        n_reports: 0
    };
}

pub fn rtcp_sr_add_report(sr: RtcpSenderReport, block: RtcpReportBlock) -> RtcpSenderReport {
    if sr.n_reports == 0 {
        return RtcpSenderReport {
            ssrc: sr.ssrc,
            ntp_sec: sr.ntp_sec,
            ntp_frac: sr.ntp_frac,
            rtp_ts: sr.rtp_ts,
            n_packets: sr.n_packets,
            n_octets: sr.n_octets,
            r0_ssrc: block.ssrc,
            r0_frac: block.fraction_lost,
            r0_lost: block.cumulative_lost,
            r0_jitter: block.jitter,
            r1_ssrc: sr.r1_ssrc,
            r1_frac: sr.r1_frac,
            r1_lost: sr.r1_lost,
            r1_jitter: sr.r1_jitter,
            n_reports: 1
        };
    }
    if sr.n_reports == 1 {
        return RtcpSenderReport {
            ssrc: sr.ssrc,
            ntp_sec: sr.ntp_sec,
            ntp_frac: sr.ntp_frac,
            rtp_ts: sr.rtp_ts,
            n_packets: sr.n_packets,
            n_octets: sr.n_octets,
            r0_ssrc: sr.r0_ssrc,
            r0_frac: sr.r0_frac,
            r0_lost: sr.r0_lost,
            r0_jitter: sr.r0_jitter,
            r1_ssrc: block.ssrc,
            r1_frac: block.fraction_lost,
            r1_lost: block.cumulative_lost,
            r1_jitter: block.jitter,
            n_reports: 2
        };
    }
    return sr;
}

pub fn rtcp_rr_add_report(rr: RtcpReceiverReport, block: RtcpReportBlock) -> RtcpReceiverReport {
    if rr.n_reports == 0 {
        return RtcpReceiverReport {
            ssrc: rr.ssrc,
            r0_ssrc: block.ssrc,
            r0_frac: block.fraction_lost,
            r0_lost: block.cumulative_lost,
            r0_jitter: block.jitter,
            r1_ssrc: rr.r1_ssrc,
            r1_frac: rr.r1_frac,
            r1_lost: rr.r1_lost,
            r1_jitter: rr.r1_jitter,
            n_reports: 1
        };
    }
    if rr.n_reports == 1 {
        return RtcpReceiverReport {
            ssrc: rr.ssrc,
            r0_ssrc: rr.r0_ssrc,
            r0_frac: rr.r0_frac,
            r0_lost: rr.r0_lost,
            r0_jitter: rr.r0_jitter,
            r1_ssrc: block.ssrc,
            r1_frac: block.fraction_lost,
            r1_lost: block.cumulative_lost,
            r1_jitter: block.jitter,
            n_reports: 2
        };
    }
    return rr;
}

pub fn rtcp_is_sender_report(payload_type: Int) -> Int {
    if payload_type == 200 {
        return 1;
    }
    return 0;
}

pub fn rtcp_is_receiver_report(payload_type: Int) -> Int {
    if payload_type == 201 {
        return 1;
    }
    return 0;
}

pub fn rtcp_sr_report_n(sr: RtcpSenderReport) -> Int {
    return sr.n_reports;
}

pub fn rtcp_rr_report_n(rr: RtcpReceiverReport) -> Int {
    return rr.n_reports;
}
