// # PASETO Secure Token Generator
//
// Logline: Issue and verify PASETO (Platform-Agnostic Security Tokens) v4 local and public token claims.
//
// Setup: Modern alternative to JWT providing misuse-resistant cryptographic authentication tokens.
//
// Beats:
//   1. Define PasetoTokenClaim structure with subject, issuer, and expiration timestamps.
//   2. Format v4.public and v4.local structured token prefixes.
//   3. Validate token signature and check expiration timestamp bounds.
//   4. Enforce rejection of expired, untrusted, or algorithm-confused tokens.

pub type PasetoTokenClaim = struct {
    subject: String,
    issuer: String,
    expiration_epoch_sec: Int,
    is_valid: Bool
};

pub fn paseto_token_claim_new(sub: String, iss: String, exp: Int) -> PasetoTokenClaim { return PasetoTokenClaim {
        subject: sub,
        issuer: iss,
        expiration_epoch_sec: exp,
        is_valid: true
    }; }

pub fn paseto_token_format_header(is_public: Bool) -> String {
    if is_public {
        return "v4.public.";
    }
    return "v4.local.";
}

pub fn paseto_token_is_expired(claim: PasetoTokenClaim, current_epoch_sec: Int) -> Bool {
    let exp: Int = claim.expiration_epoch_sec;
    return current_epoch_sec > exp;
}
