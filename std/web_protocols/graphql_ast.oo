// # GraphQL Abstract Syntax Tree Nodes
//
// Logline: Represents GraphQL documents, operation definitions (Query, Mutation, Subscription), selections, and arguments.
//
// Setup: Pure AST node definitions and tree constructors for GraphQL syntax parsing.
//
// Beats:
//   1. Define AST node structs for field selections, arguments, and operation definitions.
//   2. Define GraphQL document structures holding operations and fragment definitions.
//   3. Provide utility constructors and node inspection helpers.

pub type GqlArgument = struct {
    name: String,
    value: String,
    is_variable: Bool,
};

pub type GqlDirective = struct {
    name: String,
    value: String,
};

pub type GqlField = struct {
    name: String,
    alias: String,
    args: List[GqlArgument],
    sub_fields: List[String],
    has_subselection: Bool,
};

pub type GqlOperation = struct {
    op_type: Int, // 0 = Query, 1 = Mutation, 2 = Subscription
    name: String,
    selection_set: List[GqlField],
};

pub type GqlFragment = struct {
    name: String,
    type_condition: String,
    selection_set: List[GqlField],
};

pub type GqlDocument = struct {
    operations: List[GqlOperation],
    fragments: List[GqlFragment],
    is_valid: Bool,
};

pub fn gql_argument_new(name: String, val: String, is_var: Bool) -> GqlArgument {
    return GqlArgument {
        name: name,
        value: val,
        is_variable: is_var,
    };
}

pub fn gql_directive_new(name: String, val: String) -> GqlDirective {
    return GqlDirective {
        name: name,
        value: val,
    };
}

pub fn gql_field_new(name: String, alias: String) -> GqlField {
    let empty_args: List[GqlArgument] = list_new();
    let empty_subs: List[String] = list_new();
    return GqlField {
        name: name,
        alias: alias,
        args: empty_args,
        sub_fields: empty_subs,
        has_subselection: false,
    };
}

pub fn gql_field_with_subfields(name: String, alias: String, sub: List[String]) -> GqlField {
    let empty_args: List[GqlArgument] = list_new();
    let has_sub: Bool = list_len(sub) > 0;
    return GqlField {
        name: name,
        alias: alias,
        args: empty_args,
        sub_fields: sub,
        has_subselection: has_sub,
    };
}

pub fn gql_operation_new(op_type: Int, name: String, selections: List[GqlField]) -> GqlOperation {
    return GqlOperation {
        op_type: op_type,
        name: name,
        selection_set: selections,
    };
}

pub fn gql_fragment_new(name: String, type_cond: String, selections: List[GqlField]) -> GqlFragment {
    return GqlFragment {
        name: name,
        type_condition: type_cond,
        selection_set: selections,
    };
}

pub fn gql_document_new(ops: List[GqlOperation], frags: List[GqlFragment]) -> GqlDocument {
    let has_ops: Bool = list_len(ops) > 0;
    return GqlDocument {
        operations: ops,
        fragments: frags,
        is_valid: has_ops,
    };
}

pub fn gql_operation_type_name(op_type: Int) -> String {
    if op_type == 0 {
        return "query";
    }
    if op_type == 1 {
        return "mutation";
    }
    if op_type == 2 {
        return "subscription";
    }
    return "unknown";
}

pub fn gql_field_count(doc: &GqlDocument) -> Int {
    let ops: List[GqlOperation] = (doc).operations;
    let n_ops: Int = list_len(ops);
    let mut total: Int = 0;
    let mut i: Int = 0;

    while i < n_ops {
        let op: GqlOperation = list_get(ops, i);
        let sels: List[GqlField] = op.selection_set;
        total = total + list_len(sels);
        i = i + 1;
    }

    return total;
}
