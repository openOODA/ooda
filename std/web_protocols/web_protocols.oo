// # Web APIs, Microservices & Deep Web Protocols Unified Facade
//
// Logline: Re-exports GraphQL, OpenAPI, SSE, OAuth2, PKCE, OIDC, JSON-RPC 2.0, WebRTC SDP/ICE/RTP/RTCP, STUN, TURN, WebPush, CORS, CSP, and Web Stubs.
//
// Setup: Pure module shim and facade importing all 24 web protocol companion submodules.
//
// Beats:
//   1. Import 24 modular Web APIs, Microservices & Deep Web Protocols subcomponents.
//   2. Re-export public constructors, capability-gated interfaces, and protocol entry points.
//   3. Maintain full compliance with openOODA Standard Library specification.

import "./graphql_lexer.oo";
import "./graphql_ast.oo";
import "./graphql_parser.oo";
import "./graphql_schema.oo";
import "./graphql_executor.oo";
import "./openapi_schema.oo";
import "./openapi_generator.oo";
import "./sse_stream.oo";
import "./oauth2_token.oo";
import "./oauth2_pkce.oo";
import "./oidc_jwt_claims.oo";
import "./jsonrpc_request.oo";
import "./jsonrpc_response.oo";
import "./jsonrpc_dispatcher.oo";
import "./webrtc_sdp_parser.oo";
import "./webrtc_sdp_parser_lines.oo";
import "./webrtc_ice_candidate.oo";
import "./rtp_packet.oo";
import "./rtcp_sr_rr.oo";
import "./stun_message.oo";
import "./turn_allocation.oo";
import "./webpush_encryption.oo";
import "./cors_middleware.oo";
import "./csp_header_builder.oo";
import "./web_proto_stubs.oo";

pub fn web_proto_graphql_parse(query: String) -> GqlDocument {
    return graphql_parse(query);
}

pub fn web_proto_graphql_schema_new(query_type: String, mutation_type: String) -> GqlSchema {
    return gql_schema_new(query_type, mutation_type);
}

pub fn web_proto_openapi_doc_new(title: String, version: String, desc: String) -> OpenApiDoc {
    return openapi_doc_new(title, version, desc);
}

pub fn web_proto_sse_event_new(id: String, event_type: String, data: String, retry_ms: Int) -> SseEvent {
    return sse_event_new(id, event_type, data, retry_ms);
}

pub fn web_proto_oauth2_token_new(
    access_token: String,
    token_type: String,
    expires_in: Int,
    refresh_token: String,
    scope: String,
    now_ms: Int
) -> OAuth2Token {
    return oauth2_token_new(access_token, token_type, expires_in, refresh_token, scope, now_ms);
}

pub fn web_proto_pkce_pair_new(verifier: String, challenge: String, method: String) -> PkcePair {
    return pkce_pair_new(verifier, challenge, method);
}

pub fn web_proto_oidc_claims_new(
    iss: String,
    sub: String,
    aud: String,
    exp: Int,
    iat: Int,
    nonce: String
) -> OidcClaims {
    return oidc_claims_new(iss, sub, aud, exp, iat, nonce);
}

pub fn web_proto_jsonrpc_request_new(method: String, params_json: String, id: String) -> JsonRpcRequest {
    return jsonrpc_request_new(method, params_json, id);
}

pub fn web_proto_jsonrpc_dispatcher_new() -> JsonRpcDispatcher {
    return jsonrpc_dispatcher_new();
}

pub fn web_proto_sdp_session_new() -> SdpSession {
    return sdp_session_new();
}

pub fn web_proto_ice_candidate_host(foundation: String, address: String, port: Int) -> IceCandidate {
    return ice_candidate_host(foundation, address, port);
}

pub fn web_proto_rtp_packet_new(pt: Int, seq: Int, ts: Int, ssrc: Int, p_len: Int) -> RtpPacket {
    return rtp_packet_new(pt, seq, ts, ssrc, p_len);
}

pub fn web_proto_rtcp_sr_new(ssrc: Int, ntp_sec: Int, ntp_frac: Int, rtp_ts: Int, pkts: Int, octets: Int) -> RtcpSenderReport {
    return rtcp_sr_new(ssrc, ntp_sec, ntp_frac, rtp_ts, pkts, octets);
}

pub fn web_proto_stun_binding_request(tx_id: String) -> StunMessage {
    return stun_message_binding_request(tx_id);
}

pub fn web_proto_turn_allocation_new(
    client_ip: String,
    client_port: Int,
    relay_ip: String,
    relay_port: Int,
    lifetime_sec: Int,
    now_ms: Int
) -> TurnAllocation {
    return turn_allocation_new(client_ip, client_port, relay_ip, relay_port, lifetime_sec, now_ms);
}

pub fn web_proto_webpush_subscription(endpoint: String, p256dh: String, auth: String) -> WebPushSubscription {
    return webpush_subscription_new(endpoint, p256dh, auth);
}

pub fn web_proto_cors_permissive() -> CorsPolicy {
    return cors_policy_permissive();
}

pub fn web_proto_csp_strict() -> CspPolicy {
    return csp_policy_new_strict();
}

pub fn web_proto_fail_closed_srtp(sys: &SysCap) -> Int {
    return webrtc_hw_srtp_encrypt_packet(sys, 0, 0, 0);
}
