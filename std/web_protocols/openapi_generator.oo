// # OpenAPI Schema Generator & JSON Exporter
//
// Logline: Generates OpenAPI v3.1 JSON document strings from structured routes and schema metadata.
//
// Setup: API contract generation engine formatting REST endpoints into valid OpenAPI 3.1 JSON.
//
// Beats:
//   1. Serialize OpenAPI info and metadata objects to JSON formatting.
//   2. Serialize path items, parameters, and operation responses to JSON.
//   3. Compile complete OpenAPI 3.1 JSON specification strings.

import "./openapi_schema.oo";

pub fn openapi_int_to_str(val: Int) -> String {
    if val == 200 { return "200"; }
    if val == 201 { return "201"; }
    if val == 204 { return "204"; }
    if val == 400 { return "400"; }
    if val == 401 { return "401"; }
    if val == 403 { return "403"; }
    if val == 404 { return "404"; }
    if val == 500 { return "500"; }
    if val == 0 { return "0"; }

    let mut v: Int = val;
    let mut digits: List[Int] = bytes_new();
    while v > 0 {
        let d: Int = v % 10;
        digits = bytes_push(digits, 48 + d);
        v = v / 10;
    }

    let n_d: Int = list_len(digits);
    let mut rev: List[Int] = bytes_new();
    let mut i: Int = n_d - 1;
    while i >= 0 {
        rev = bytes_push(rev, list_get(digits, i));
        i = i - 1;
    }
    return bytes_to_str(rev);
}

pub fn openapi_serialize_parameter(param: &OpenApiParameter) -> String {
    let req_str: String = if (param).required { "true" } else { "false" };
    let mut s: String = "{\"name\": \"";
    s = s + (param).name;
    s = s + "\", \"in\": \"";
    s = s + (param).in_location;
    s = s + "\", \"required\": ";
    s = s + req_str;
    s = s + ", \"schema\": {\"type\": \"";
    s = s + (param).schema_type;
    s = s + "\"}}";
    return s;
}

pub fn openapi_serialize_response(resp: &OpenApiResponse) -> String {
    let status_str: String = openapi_int_to_str((resp).status_code);
    let mut s: String = "\"";
    s = s + status_str;
    s = s + "\": {\"description\": \"";
    s = s + (resp).description;
    s = s + "\", \"content\": {\"";
    s = s + (resp).content_type;
    s = s + "\": {\"schema\": {\"$ref\": \"";
    s = s + (resp).schema_ref;
    s = s + "\"}}}}";
    return s;
}

pub fn openapi_serialize_operation(op: &OpenApiOperation, http_method: String) -> String {
    if (op).is_defined == false {
        return "";
    }

    let mut out: String = "\"";
    out = out + http_method;
    out = out + "\": {\"operationId\": \"";
    out = out + (op).operation_id;
    out = out + "\", \"summary\": \"";
    out = out + (op).summary;
    out = out + "\"";

    let params: List[OpenApiParameter] = (op).parameters;
    let n_p: Int = list_len(params);
    if n_p > 0 {
        out = out + ", \"parameters\": [";
        let mut i: Int = 0;
        while i < n_p {
            if i > 0 { out = out + ", "; }
            let p: OpenApiParameter = list_get(params, i);
            out = out + openapi_serialize_parameter(&p);
            i = i + 1;
        }
        out = out + "]";
    }

    let resps: List[OpenApiResponse] = (op).responses;
    let n_r: Int = list_len(resps);
    out = out + ", \"responses\": {";
    let mut j: Int = 0;
    while j < n_r {
        if j > 0 { out = out + ", "; }
        let r: OpenApiResponse = list_get(resps, j);
        out = out + openapi_serialize_response(&r);
        j = j + 1;
    }
    out = out + "}}";

    return out;
}

pub fn openapi_serialize_path_item(item: &OpenApiPathItem) -> String {
    let mut out: String = "\"";
    out = out + (item).path;
    out = out + "\": {";
    let mut ops_count: Int = 0;

    let get_str: String = openapi_serialize_operation(&(item).get_op, "get");
    if get_str.len() > 0 {
        out = out + get_str;
        ops_count = ops_count + 1;
    }

    let post_str: String = openapi_serialize_operation(&(item).post_op, "post");
    if post_str.len() > 0 {
        if ops_count > 0 { out = out + ", "; }
        out = out + post_str;
        ops_count = ops_count + 1;
    }

    let put_str: String = openapi_serialize_operation(&(item).put_op, "put");
    if put_str.len() > 0 {
        if ops_count > 0 { out = out + ", "; }
        out = out + put_str;
        ops_count = ops_count + 1;
    }

    let del_str: String = openapi_serialize_operation(&(item).delete_op, "delete");
    if del_str.len() > 0 {
        if ops_count > 0 { out = out + ", "; }
        out = out + del_str;
        ops_count = ops_count + 1;
    }

    out = out + "}";
    return out;
}

pub fn openapi_generate_json(doc: &OpenApiDoc) -> String {
    let info: OpenApiInfo = (doc).info;
    let mut out: String = "{\"openapi\": \"";
    out = out + (doc).openapi_version;
    out = out + "\", \"info\": {\"title\": \"";
    out = out + info.title;
    out = out + "\", \"version\": \"";
    out = out + info.version;
    out = out + "\", \"description\": \"";
    out = out + info.description;
    out = out + "\"}, \"paths\": {";

    let paths: List[OpenApiPathItem] = (doc).paths;
    let n_paths: Int = list_len(paths);
    let mut i: Int = 0;
    while i < n_paths {
        if i > 0 { out = out + ", "; }
        let p: OpenApiPathItem = list_get(paths, i);
        out = out + openapi_serialize_path_item(&p);
        i = i + 1;
    }
    out = out + "}}";

    return out;
}
