// # RTP packet (RFC 3550 header destub)
//
// Logline: Version/PT/seq/ts/ssrc from 12-byte header. Off pub type / Bool / &T.
//
// Setup: Fixed 12 Int slots + have_n. n_csrc not count. n_payload not len.
//
// Beats:
//   1. b0: V=b0/64, P=(b0/32)%2, X=(b0/16)%2, CC=b0%16.
//   2. b1: M=b1/128, PT=b1%128; seq and 32-bit ts/ssrc big-endian.
//   3. valid iff version==2; Opus 111, VP8 96, H264 102 or 127.

type RtpPacket = struct {
    version: Int,
    padding: Int,
    extension: Int,
    n_csrc: Int,
    marker: Int,
    payload_type: Int,
    sequence_number: Int,
    timestamp: Int,
    ssrc: Int,
    n_payload: Int,
    is_valid: Int
};

pub fn rtp_packet_new(pt: Int, seq: Int, ts: Int, ssrc: Int, p_n: Int) -> RtpPacket {
    return RtpPacket {
        version: 2,
        padding: 0,
        extension: 0,
        n_csrc: 0,
        marker: 0,
        payload_type: pt,
        sequence_number: seq,
        timestamp: ts,
        ssrc: ssrc,
        n_payload: p_n,
        is_valid: 1
    };
}

fn rtp_invalid() -> RtpPacket {
    return RtpPacket {
        version: 0,
        padding: 0,
        extension: 0,
        n_csrc: 0,
        marker: 0,
        payload_type: 0,
        sequence_number: 0,
        timestamp: 0,
        ssrc: 0,
        n_payload: 0,
        is_valid: 0
    };
}

fn rtp_payload_n(have_n: Int, offset: Int, header_n: Int) -> Int {
    if have_n >= (offset + header_n) {
        return have_n - (offset + header_n);
    }
    return 0;
}

pub fn rtp_packet_parse_header(
    have_n: Int,
    offset: Int,
    b0: Int,
    b1: Int,
    b2: Int,
    b3: Int,
    b4: Int,
    b5: Int,
    b6: Int,
    b7: Int,
    b8: Int,
    b9: Int,
    b10: Int,
    b11: Int
) -> RtpPacket {
    if (offset + 12) > have_n {
        return rtp_invalid();
    }
    let ver: Int = b0 / 64;
    let pad: Int = (b0 / 32) % 2;
    let ext: Int = (b0 / 16) % 2;
    let cc: Int = b0 % 16;
    let m: Int = b1 / 128;
    let pt: Int = b1 % 128;
    let seq: Int = (b2 * 256) + b3;
    let ts: Int = (b4 * 16777216) + (b5 * 65536) + (b6 * 256) + b7;
    let ssrc_val: Int = (b8 * 16777216) + (b9 * 65536) + (b10 * 256) + b11;
    let header_n: Int = 12 + (cc * 4);
    let p_n: Int = rtp_payload_n(have_n, offset, header_n);
    let ok: Int = if ver == 2 { 1 } else { 0 };
    return RtpPacket {
        version: ver,
        padding: pad,
        extension: ext,
        n_csrc: cc,
        marker: m,
        payload_type: pt,
        sequence_number: seq,
        timestamp: ts,
        ssrc: ssrc_val,
        n_payload: p_n,
        is_valid: ok
    };
}

pub fn rtp_packet_payload_offset(pkt: RtpPacket) -> Int {
    return 12 + (pkt.n_csrc * 4);
}

pub fn rtp_packet_is_opus(pkt: RtpPacket) -> Int {
    if pkt.payload_type == 111 {
        return 1;
    }
    return 0;
}

pub fn rtp_packet_is_vp8(pkt: RtpPacket) -> Int {
    if pkt.payload_type == 96 {
        return 1;
    }
    return 0;
}

pub fn rtp_packet_is_h264(pkt: RtpPacket) -> Int {
    if pkt.payload_type == 102 {
        return 1;
    }
    if pkt.payload_type == 127 {
        return 1;
    }
    return 0;
}
