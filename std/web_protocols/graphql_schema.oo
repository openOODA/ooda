// # GraphQL schema slots (Int destub floor)
//
// Logline: Two type slots, two fields each. Off pub type / String / &mut / List[struct].
//
// Setup: kind 0 scalar 1 object 2 enum 3 interface. n_types not count.
//
// Beats:
//   1. add_type fills next empty slot (max 2).
//   2. has_type / has_field scan names; field 0 is empty.
//   3. type_n is filled slots.

type GqlFieldDef = struct {
    name: Int,
    return_type: Int,
    is_list: Int,
    is_non_null: Int
};

type GqlSchema = struct {
    query_type: Int,
    mutation_type: Int,
    subscription_type: Int,
    t0_kind: Int,
    t0_name: Int,
    t0_f0: Int,
    t0_f1: Int,
    t1_kind: Int,
    t1_name: Int,
    t1_f0: Int,
    t1_f1: Int,
    n_types: Int
};

pub fn gql_field_def_new(name: Int, return_type: Int, is_list: Int, is_non_null: Int) -> GqlFieldDef {
    return GqlFieldDef {
        name: name,
        return_type: return_type,
        is_list: is_list,
        is_non_null: is_non_null
    };
}

pub fn gql_schema_new(query_type: Int, mutation_type: Int) -> GqlSchema {
    return GqlSchema {
        query_type: query_type,
        mutation_type: mutation_type,
        subscription_type: 0,
        t0_kind: 0,
        t0_name: 0,
        t0_f0: 0,
        t0_f1: 0,
        t1_kind: 0,
        t1_name: 0,
        t1_f0: 0,
        t1_f1: 0,
        n_types: 0
    };
}

pub fn gql_schema_add_type(schema: GqlSchema, kind: Int, name: Int, f0: Int, f1: Int) -> GqlSchema {
    if schema.n_types == 0 {
        return GqlSchema {
            query_type: schema.query_type,
            mutation_type: schema.mutation_type,
            subscription_type: schema.subscription_type,
            t0_kind: kind,
            t0_name: name,
            t0_f0: f0,
            t0_f1: f1,
            t1_kind: schema.t1_kind,
            t1_name: schema.t1_name,
            t1_f0: schema.t1_f0,
            t1_f1: schema.t1_f1,
            n_types: 1
        };
    }
    if schema.n_types == 1 {
        return GqlSchema {
            query_type: schema.query_type,
            mutation_type: schema.mutation_type,
            subscription_type: schema.subscription_type,
            t0_kind: schema.t0_kind,
            t0_name: schema.t0_name,
            t0_f0: schema.t0_f0,
            t0_f1: schema.t0_f1,
            t1_kind: kind,
            t1_name: name,
            t1_f0: f0,
            t1_f1: f1,
            n_types: 2
        };
    }
    return schema;
}

pub fn gql_schema_has_type(schema: GqlSchema, type_name: Int) -> Int {
    if schema.n_types > 0 {
        if schema.t0_name == type_name {
            return 1;
        }
    }
    if schema.n_types > 1 {
        if schema.t1_name == type_name {
            return 1;
        }
    }
    return 0;
}

pub fn gql_schema_has_field(schema: GqlSchema, type_name: Int, field_name: Int) -> Int {
    if field_name == 0 {
        return 0;
    }
    if schema.n_types > 0 {
        if schema.t0_name == type_name {
            if schema.t0_f0 == field_name {
                return 1;
            }
            if schema.t0_f1 == field_name {
                return 1;
            }
            return 0;
        }
    }
    if schema.n_types > 1 {
        if schema.t1_name == type_name {
            if schema.t1_f0 == field_name {
                return 1;
            }
            if schema.t1_f1 == field_name {
                return 1;
            }
            return 0;
        }
    }
    return 0;
}

pub fn gql_schema_type_n(schema: GqlSchema) -> Int {
    return schema.n_types;
}
