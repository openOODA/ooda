// # RFC 8291 WebPush sizes (Int destub floor)
//
// Logline: Endpoint + P-256 + auth lengths; aes128gcm. Off pub type / String / &T.
//
// Setup: P-256 uncompressed 65; auth/salt 16. encoding 1 = aes128gcm. urgency 2 = normal.
//
// Beats:
//   1. subscription valid iff endpoint_n>0 and p256dh_n>0.
//   2. validate requires is_valid and endpoint_n>=8.
//   3. key_ok iff p256dh_n==65 and auth_n==16.

type WebPushSubscription = struct {
    endpoint_n: Int,
    p256dh_n: Int,
    auth_n: Int,
    is_valid: Int
};

type WebPushHeaders = struct {
    salt: Int,
    server_pk: Int,
    vapid: Int,
    encoding: Int,
    ttl_seconds: Int,
    urgency: Int
};

pub fn webpush_subscription_new(endpoint_n: Int, p256dh_n: Int, auth_n: Int) -> WebPushSubscription {
    let valid_e: Int = if endpoint_n > 0 {
        if p256dh_n > 0 { 1 } else { 0 }
    } else {
        0
    };
    return WebPushSubscription {
        endpoint_n: endpoint_n,
        p256dh_n: p256dh_n,
        auth_n: auth_n,
        is_valid: valid_e
    };
}

pub fn webpush_headers_new(salt: Int, server_pk: Int, vapid: Int, ttl: Int) -> WebPushHeaders {
    return WebPushHeaders {
        salt: salt,
        server_pk: server_pk,
        vapid: vapid,
        encoding: 1,
        ttl_seconds: ttl,
        urgency: 2
    };
}

pub fn webpush_validate_subscription(sub: WebPushSubscription) -> Int {
    if sub.is_valid == 0 {
        return 0;
    }
    if sub.endpoint_n < 8 {
        return 0;
    }
    return 1;
}

pub fn webpush_p256_key_n() -> Int {
    return 65;
}

pub fn webpush_auth_secret_n() -> Int {
    return 16;
}

pub fn webpush_salt_n() -> Int {
    return 16;
}

pub fn webpush_aes128gcm() -> Int {
    return 1;
}

pub fn webpush_key_ok(p256dh_n: Int, auth_n: Int) -> Int {
    if p256dh_n != 65 {
        return 0;
    }
    if auth_n != 16 {
        return 0;
    }
    return 1;
}
