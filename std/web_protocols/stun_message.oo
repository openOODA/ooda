// # STUN message (RFC 5389/8489 Int destub)
//
// Logline: 20-byte header, magic cookie 0x2112A442. By-value Int destub.
//
// Setup: Binding Request 0x0001, Success 0x0101. Two attr slots. n_body / n_attrs not len/count.
//
// Beats:
//   1. type = b0*256+b1, n_body = b2*256+b3, cookie = BE32(b4..b7).
//   2. valid iff have_n >= offset+20 and cookie == 554869826.
//   3. add_attribute fills next empty slot (max 2).

type StunAttribute = struct {
    attr_type: Int,
    attr_val: Int
};

type StunMessage = struct {
    msg_type: Int,
    n_body: Int,
    magic_cookie: Int,
    tx_id: Int,
    a0_type: Int,
    a0_val: Int,
    a1_type: Int,
    a1_val: Int,
    n_attrs: Int,
    is_valid: Int
};

pub fn stun_attribute_new(attr_type: Int, attr_val: Int) -> StunAttribute {
    return StunAttribute {
        attr_type: attr_type,
        attr_val: attr_val
    };
}

fn stun_empty_attrs(msg_type: Int, n_body: Int, cookie: Int, tx_id: Int, ok: Int) -> StunMessage {
    return StunMessage {
        msg_type: msg_type,
        n_body: n_body,
        magic_cookie: cookie,
        tx_id: tx_id,
        a0_type: 0,
        a0_val: 0,
        a1_type: 0,
        a1_val: 0,
        n_attrs: 0,
        is_valid: ok
    };
}

pub fn stun_message_binding_request(tx_id: Int) -> StunMessage {
    return stun_empty_attrs(1, 0, 554869826, tx_id, 1);
}

pub fn stun_message_binding_response(tx_id: Int) -> StunMessage {
    return stun_empty_attrs(257, 0, 554869826, tx_id, 1);
}

pub fn stun_parse_header(
    have_n: Int,
    offset: Int,
    b0: Int,
    b1: Int,
    b2: Int,
    b3: Int,
    b4: Int,
    b5: Int,
    b6: Int,
    b7: Int
) -> StunMessage {
    if (offset + 20) > have_n {
        return stun_empty_attrs(0, 0, 0, 0, 0);
    }
    let m_type: Int = (b0 * 256) + b1;
    let m_body: Int = (b2 * 256) + b3;
    let cookie: Int = (b4 * 16777216) + (b5 * 65536) + (b6 * 256) + b7;
    let ok: Int = if cookie == 554869826 { 1 } else { 0 };
    return stun_empty_attrs(m_type, m_body, cookie, 0, ok);
}

pub fn stun_is_binding_request(msg: StunMessage) -> Int {
    if msg.msg_type == 1 {
        return 1;
    }
    return 0;
}

pub fn stun_is_binding_response(msg: StunMessage) -> Int {
    if msg.msg_type == 257 {
        return 1;
    }
    return 0;
}

pub fn stun_add_attribute(msg: StunMessage, attr: StunAttribute) -> StunMessage {
    if msg.n_attrs == 0 {
        return StunMessage {
            msg_type: msg.msg_type,
            n_body: msg.n_body,
            magic_cookie: msg.magic_cookie,
            tx_id: msg.tx_id,
            a0_type: attr.attr_type,
            a0_val: attr.attr_val,
            a1_type: msg.a1_type,
            a1_val: msg.a1_val,
            n_attrs: 1,
            is_valid: msg.is_valid
        };
    }
    if msg.n_attrs == 1 {
        return StunMessage {
            msg_type: msg.msg_type,
            n_body: msg.n_body,
            magic_cookie: msg.magic_cookie,
            tx_id: msg.tx_id,
            a0_type: msg.a0_type,
            a0_val: msg.a0_val,
            a1_type: attr.attr_type,
            a1_val: attr.attr_val,
            n_attrs: 2,
            is_valid: msg.is_valid
        };
    }
    return msg;
}

pub fn stun_attribute_n(msg: StunMessage) -> Int {
    return msg.n_attrs;
}
