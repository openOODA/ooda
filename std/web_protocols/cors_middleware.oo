// # CORS policy (W3C Int destub)
//
// Logline: Origin allow-list or *, method/header bitmasks, preflight flag.
//
// Setup: methods GET=1 POST=2 PUT=4 DELETE=8 OPTIONS=16. headers CT=1 Auth=2.
//
// Beats:
//   1. permissive allow_all + methods 31 + headers 3 + creds + max_age 86400.
//   2. strict 4-slot origins, GET|POST, CT only, max_age 3600.
//   3. eval deny if origin not allowed; star origin is -1.

type CorsPolicy = struct {
    o0: Int,
    o1: Int,
    o2: Int,
    o3: Int,
    allow_all_origins: Int,
    methods: Int,
    headers: Int,
    allow_credentials: Int,
    max_age: Int
};

type CorsResult = struct {
    is_allowed: Int,
    is_preflight: Int,
    allow_origin: Int,
    methods: Int,
    headers: Int,
    allow_credentials: Int
};

pub fn cors_policy_permissive() -> CorsPolicy {
    return CorsPolicy {
        o0: 0,
        o1: 0,
        o2: 0,
        o3: 0,
        allow_all_origins: 1,
        methods: 31,
        headers: 3,
        allow_credentials: 1,
        max_age: 86400
    };
}

pub fn cors_policy_strict(o0: Int, o1: Int, o2: Int, o3: Int) -> CorsPolicy {
    return CorsPolicy {
        o0: o0,
        o1: o1,
        o2: o2,
        o3: o3,
        allow_all_origins: 0,
        methods: 3,
        headers: 1,
        allow_credentials: 0,
        max_age: 3600
    };
}

pub fn cors_is_origin_allowed(policy: CorsPolicy, origin: Int) -> Int {
    if policy.allow_all_origins == 1 {
        return 1;
    }
    if origin == 0 {
        return 0;
    }
    if policy.o0 == origin {
        return 1;
    }
    if policy.o1 == origin {
        return 1;
    }
    if policy.o2 == origin {
        return 1;
    }
    if policy.o3 == origin {
        return 1;
    }
    return 0;
}

pub fn cors_eval_request(policy: CorsPolicy, origin: Int, is_options: Int) -> CorsResult {
    if cors_is_origin_allowed(policy, origin) == 0 {
        return CorsResult {
            is_allowed: 0,
            is_preflight: is_options,
            allow_origin: 0,
            methods: 0,
            headers: 0,
            allow_credentials: 0
        };
    }
    let star_or_origin: Int = if policy.allow_all_origins == 1 { 0 - 1 } else { origin };
    return CorsResult {
        is_allowed: 1,
        is_preflight: is_options,
        allow_origin: star_or_origin,
        methods: policy.methods,
        headers: policy.headers,
        allow_credentials: policy.allow_credentials
    };
}
