// # JSON-RPC 2.0 response (Int destub)
//
// Logline: Standard error codes -32700..-32603. Flattened error slots. By-value Int destub.
//
// Setup: version 20. Success is_error=0. Error envelope carries err_code.
//
// Beats:
//   1. parse -32700, invalid -32600, not found -32601, params -32602, internal -32603.
//   2. success copies result/id; error copies err_code and clears result.
//   3. id 0 is a null id.

type JsonRpcError = struct {
    code: Int,
    message: Int,
    data: Int
};

type JsonRpcResponse = struct {
    jsonrpc_version: Int,
    result: Int,
    err_code: Int,
    err_data: Int,
    id: Int,
    is_error: Int
};

pub fn jsonrpc_error_new(code: Int, msg: Int, data: Int) -> JsonRpcError {
    return JsonRpcError {
        code: code,
        message: msg,
        data: data
    };
}

pub fn jsonrpc_error_parse_error() -> JsonRpcError {
    return jsonrpc_error_new(0 - 32700, 1, 0);
}

pub fn jsonrpc_error_invalid_req() -> JsonRpcError {
    return jsonrpc_error_new(0 - 32600, 2, 0);
}

pub fn jsonrpc_error_method_not_found() -> JsonRpcError {
    return jsonrpc_error_new(0 - 32601, 3, 0);
}

pub fn jsonrpc_error_invalid_params() -> JsonRpcError {
    return jsonrpc_error_new(0 - 32602, 4, 0);
}

pub fn jsonrpc_error_internal() -> JsonRpcError {
    return jsonrpc_error_new(0 - 32603, 5, 0);
}

pub fn jsonrpc_response_success(id: Int, result: Int) -> JsonRpcResponse {
    return JsonRpcResponse {
        jsonrpc_version: 20,
        result: result,
        err_code: 0,
        err_data: 0,
        id: id,
        is_error: 0
    };
}

pub fn jsonrpc_response_error(id: Int, err: JsonRpcError) -> JsonRpcResponse {
    return JsonRpcResponse {
        jsonrpc_version: 20,
        result: 0,
        err_code: err.code,
        err_data: err.data,
        id: id,
        is_error: 1
    };
}

pub fn jsonrpc_response_id_is_null(resp: JsonRpcResponse) -> Int {
    if resp.id == 0 {
        return 1;
    }
    return 0;
}
