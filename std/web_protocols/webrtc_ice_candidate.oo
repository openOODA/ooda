// # ICE candidate (RFC 5245 priority destub)
//
// Logline: priority = 2^24*type_pref + 2^8*local_pref + (256-component).
//
// Setup: transport 0=udp 1=tcp. cand_type 0=host 1=srflx 2=prflx 3=relay.
//
// Beats:
//   1. host type_pref 126, srflx 100, relay 0; local_pref 65535; RTP component 1.
//   2. valid iff address != 0.
//   3. by-value; off pub type / String / &T.

type IceCandidate = struct {
    foundation: Int,
    component_id: Int,
    transport: Int,
    priority: Int,
    address: Int,
    port: Int,
    cand_type: Int,
    is_valid: Int
};

pub fn ice_candidate_compute_priority(type_pref: Int, local_pref: Int, component_id: Int) -> Int {
    let p1: Int = type_pref * 16777216;
    let p2: Int = local_pref * 256;
    let p3: Int = 256 - component_id;
    return p1 + p2 + p3;
}

pub fn ice_candidate_new(
    foundation: Int,
    component_id: Int,
    transport: Int,
    priority: Int,
    address: Int,
    port: Int,
    cand_type: Int
) -> IceCandidate {
    let valid_addr: Int = if address == 0 { 0 } else { 1 };
    return IceCandidate {
        foundation: foundation,
        component_id: component_id,
        transport: transport,
        priority: priority,
        address: address,
        port: port,
        cand_type: cand_type,
        is_valid: valid_addr
    };
}

pub fn ice_candidate_host(foundation: Int, address: Int, port: Int) -> IceCandidate {
    let prio: Int = ice_candidate_compute_priority(126, 65535, 1);
    return ice_candidate_new(foundation, 1, 0, prio, address, port, 0);
}

pub fn ice_candidate_srflx(foundation: Int, address: Int, port: Int) -> IceCandidate {
    let prio: Int = ice_candidate_compute_priority(100, 65535, 1);
    return ice_candidate_new(foundation, 1, 0, prio, address, port, 1);
}

pub fn ice_candidate_relay(foundation: Int, address: Int, port: Int) -> IceCandidate {
    let prio: Int = ice_candidate_compute_priority(0, 65535, 1);
    return ice_candidate_new(foundation, 1, 0, prio, address, port, 3);
}
