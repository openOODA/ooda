// # OIDC ID token claims (Core 1.0 Int destub)
//
// Logline: iss/aud match, exp, nbf. Off pub type / String / &T / nested JSON.
//
// Setup: error_code 0 ok, 1 iss, 2 aud, 3 exp, 4 nbf.
//
// Beats:
//   1. expired iff now_sec >= exp.
//   2. nonce match is exact id equality.
//   3. nbf>0 and now_sec < nbf is not-yet-valid.

type OidcClaims = struct {
    iss: Int,
    sub: Int,
    aud: Int,
    exp: Int,
    nbf: Int,
    iat: Int,
    nonce: Int,
    auth_time: Int,
    email: Int,
    email_verified: Int
};

type OidcValidationResult = struct {
    is_valid: Int,
    error_code: Int
};

pub fn oidc_claims_new(iss: Int, sub: Int, aud: Int, exp: Int, iat: Int, nonce: Int) -> OidcClaims {
    return OidcClaims {
        iss: iss,
        sub: sub,
        aud: aud,
        exp: exp,
        nbf: iat,
        iat: iat,
        nonce: nonce,
        auth_time: iat,
        email: 0,
        email_verified: 0
    };
}

pub fn oidc_claims_is_expired(claims: OidcClaims, now_sec: Int) -> Int {
    if now_sec >= claims.exp {
        return 1;
    }
    return 0;
}

pub fn oidc_claims_matches_nonce(claims: OidcClaims, expected_nonce: Int) -> Int {
    if claims.nonce == expected_nonce {
        return 1;
    }
    return 0;
}

pub fn oidc_validate_claims(
    claims: OidcClaims,
    expected_iss: Int,
    expected_aud: Int,
    now_sec: Int
) -> OidcValidationResult {
    if claims.iss != expected_iss {
        return OidcValidationResult { is_valid: 0, error_code: 1 };
    }
    if claims.aud != expected_aud {
        return OidcValidationResult { is_valid: 0, error_code: 2 };
    }
    if now_sec >= claims.exp {
        return OidcValidationResult { is_valid: 0, error_code: 3 };
    }
    if claims.nbf > 0 && now_sec < claims.nbf {
        return OidcValidationResult { is_valid: 0, error_code: 4 };
    }
    return OidcValidationResult { is_valid: 1, error_code: 0 };
}
