// # OpenAPI 3.1 slots (Int destub floor)
//
// Logline: Two path slots; GET/POST flags. Off pub type / String / &mut / List[struct].
//
// Setup: openapi 3.1. GET=1 POST=2 PUT=3 DELETE=4. n_paths not count.
//
// Beats:
//   1. new doc major 3 minor 1, n_paths 0.
//   2. add_path fills next empty slot (max 2).
//   3. empty op is_defined 0; new op is_defined 1.

type OpenApiInfo = struct {
    title: Int,
    version: Int,
    description: Int
};

type OpenApiParameter = struct {
    name: Int,
    in_location: Int,
    required: Int,
    schema_type: Int
};

type OpenApiResponse = struct {
    status_code: Int,
    description: Int,
    content_type: Int,
    schema_ref: Int
};

type OpenApiOperation = struct {
    operation_id: Int,
    summary: Int,
    n_params: Int,
    is_defined: Int
};

type OpenApiPathItem = struct {
    path: Int,
    summary: Int,
    get_on: Int,
    post_on: Int
};

type OpenApiDoc = struct {
    openapi_major: Int,
    openapi_minor: Int,
    title: Int,
    version: Int,
    p0: Int,
    p0_get: Int,
    p0_post: Int,
    p1: Int,
    p1_get: Int,
    p1_post: Int,
    n_paths: Int
};

pub fn openapi_info_new(title: Int, version: Int, description: Int) -> OpenApiInfo {
    return OpenApiInfo {
        title: title,
        version: version,
        description: description
    };
}

pub fn openapi_parameter_new(name: Int, in_loc: Int, required: Int, s_type: Int) -> OpenApiParameter {
    return OpenApiParameter {
        name: name,
        in_location: in_loc,
        required: required,
        schema_type: s_type
    };
}

pub fn openapi_response_new(status_code: Int, description: Int, content_type: Int, schema_ref: Int) -> OpenApiResponse {
    return OpenApiResponse {
        status_code: status_code,
        description: description,
        content_type: content_type,
        schema_ref: schema_ref
    };
}

pub fn openapi_operation_new(op_id: Int, summary: Int, n_params: Int) -> OpenApiOperation {
    return OpenApiOperation {
        operation_id: op_id,
        summary: summary,
        n_params: n_params,
        is_defined: 1
    };
}

pub fn openapi_operation_empty() -> OpenApiOperation {
    return OpenApiOperation {
        operation_id: 0,
        summary: 0,
        n_params: 0,
        is_defined: 0
    };
}

pub fn openapi_path_item_new(path: Int, summary: Int) -> OpenApiPathItem {
    return OpenApiPathItem {
        path: path,
        summary: summary,
        get_on: 0,
        post_on: 0
    };
}

pub fn openapi_path_item_get(item: OpenApiPathItem) -> OpenApiPathItem {
    return OpenApiPathItem {
        path: item.path,
        summary: item.summary,
        get_on: 1,
        post_on: item.post_on
    };
}

pub fn openapi_path_item_post(item: OpenApiPathItem) -> OpenApiPathItem {
    return OpenApiPathItem {
        path: item.path,
        summary: item.summary,
        get_on: item.get_on,
        post_on: 1
    };
}

pub fn openapi_doc_new(title: Int, version: Int) -> OpenApiDoc {
    return OpenApiDoc {
        openapi_major: 3,
        openapi_minor: 1,
        title: title,
        version: version,
        p0: 0,
        p0_get: 0,
        p0_post: 0,
        p1: 0,
        p1_get: 0,
        p1_post: 0,
        n_paths: 0
    };
}

pub fn openapi_doc_add_path(doc: OpenApiDoc, item: OpenApiPathItem) -> OpenApiDoc {
    if doc.n_paths == 0 {
        return OpenApiDoc {
            openapi_major: doc.openapi_major,
            openapi_minor: doc.openapi_minor,
            title: doc.title,
            version: doc.version,
            p0: item.path,
            p0_get: item.get_on,
            p0_post: item.post_on,
            p1: doc.p1,
            p1_get: doc.p1_get,
            p1_post: doc.p1_post,
            n_paths: 1
        };
    }
    if doc.n_paths == 1 {
        return OpenApiDoc {
            openapi_major: doc.openapi_major,
            openapi_minor: doc.openapi_minor,
            title: doc.title,
            version: doc.version,
            p0: doc.p0,
            p0_get: doc.p0_get,
            p0_post: doc.p0_post,
            p1: item.path,
            p1_get: item.get_on,
            p1_post: item.post_on,
            n_paths: 2
        };
    }
    return doc;
}

pub fn openapi_doc_path_n(doc: OpenApiDoc) -> Int {
    return doc.n_paths;
}
