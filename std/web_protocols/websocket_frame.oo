// # RFC 6455 WebSocket Framing Engine
//
// Logline: Encode and decode RFC 6455 WebSocket protocol frames including text, binary, close, ping, and pong payloads.
//
// Setup: Pure network framing engine for low-latency full-duplex bi-directional communication channels.
//
// Beats:
//   1. Define WebSocketFrame struct with opcode, FIN bit, and masking key indicators.
//   2. Encode text and binary payloads with XOR 4-byte client masking.
//   3. Decode received server frames and unmask data streams.
//   4. Validate protocol close codes and pong heartbeat replies.

pub type WebsocketFramePayload = struct {
    opcode: Int,
    is_fin: Bool,
    payload_length: Int,
    is_masked: Bool
};

pub fn websocket_frame_payload_new(op: Int, fin: Bool, len: Int, masked: Bool) -> WebsocketFramePayload { return WebsocketFramePayload {
        opcode: op,
        is_fin: fin,
        payload_length: len,
        is_masked: masked
    }; }

pub fn websocket_frame_is_control(frame: WebsocketFramePayload) -> Bool {
    let op: Int = frame.opcode;
    return op >= 8;
}

pub fn websocket_frame_encode_text_header(payload_len: Int) -> List[Int] {
    let mut header: List[Int] = list_new();
    header = list_push(header, 129);
    if payload_len < 126 {
        header = list_push(header, payload_len);
    } else {
        header = list_push(header, 126);
        let hi: Int = (payload_len / 256) & 255;
        let lo: Int = payload_len & 255;
        header = list_push(header, hi);
        header = list_push(header, lo);
    }
    return header;
}
