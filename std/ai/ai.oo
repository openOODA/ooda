// # Standard AI & Neural Computation Catalog
//
// Logline: Unified standard library catalog for GGUF parsing, 4-bit quantization, tensor math, and transformer neural inference.
//
// Setup: Pure high-level interface requiring AiCap or GpuCap for hardware-accelerated and sovereign neural computation.
//
// Beats:
//   1. Re-export GGUF parser structures and metadata extraction helpers.
//   2. Re-export Q4_0 and Q4_K block quantization codecs and GEMV matrix kernels.
//   3. Re-export multi-dimensional tensor data structures, RMSNorm, and SwiGLU.
//   4. Re-export full transformer inference execution step and sampling routines.

import "gguf.oo";
import "quant.oo";
import "tensor.oo";
import "transformer.oo";

pub fn ai_init_runtime(ai: &AiCap) -> Bool {
    return true;
}

pub fn ai_version() -> String {
    return "0.208.0-s16";
}

pub fn ai_create_default_config(vocab_size: Int, dim: Int) -> TransformerModelConfig {
    return transformer_config_new(
        vocab_size,
        dim,
        dim * 4,
        4,
        8,
        2,
        0.00001,
        10000.0,
        2048
    );
}
