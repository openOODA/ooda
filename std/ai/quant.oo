// # 4-Bit Block Quantization & Vector Dot Products
//
// Logline: Implements Q4_0 and Q4_K block quantization, FP16 conversion, dequantization, and high-throughput vector dot products.
//
// Setup: Pure arithmetic and bitwise codecs for quantized tensor matrix-vector multiplication.
//
// Beats:
//   1. Convert between IEEE-754 FP16 half-precision floats and 32-bit floats.
//   2. Dequantize Q4_0 (32-weight blocks) and Q4_K (256-weight super-blocks).
//   3. Compute direct vector dot products without intermediate heap allocation.
//   4. Execute quantized matrix-vector multiplication (GEMV).

pub type BlockQ4_0 = struct {
    d: Float,
    qs: List[Int]
};

pub type BlockQ4_K = struct {
    d: Float,
    dmin: Float,
    scales: List[Int],
    mins: List[Int],
    qs: List[Int]
};

pub type QuantizedTensor = struct {
    rows: Int,
    cols: Int,
    qtype: Int,
    raw_data: String,
    block_count: Int
};

pub fn quant_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 1000000 { f = f + 1000000.0; count = count - 1000000; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn quant_float_to_int(val: Float) -> Int {
    let mut res: Int = 0;
    let mut temp: Float = val;
    if temp < 0.0 { temp = 0.0 - temp; }
    while temp >= 1000000.0 { res = res + 1000000; temp = temp - 1000000.0; }
    while temp >= 10000.0 { res = res + 10000; temp = temp - 10000.0; }
    while temp >= 100.0 { res = res + 100; temp = temp - 100.0; }
    while temp >= 1.0 { res = res + 1; temp = temp - 1.0; }
    if val < 0.0 { return 0 - res; }
    return res;
}

pub fn fp16_to_f32(h: Int) -> Float {
    let sign: Int = (h / 32768) % 2;
    let exp: Int = (h / 1024) % 32;
    let mant: Int = h % 1024;
    if exp == 0 {
        if mant == 0 { return 0.0; }
        let mut f: Float = (quant_int_to_float(mant) / 1024.0) / 16384.0;
        if sign == 1 { f = 0.0 - f; }
        return f;
    }
    if exp == 31 { return 65504.0; }
    let mut f: Float = 1.0 + (quant_int_to_float(mant) / 1024.0);
    let shift: Int = exp - 15;
    let mut i: Int = 0;
    if shift > 0 {
        while i < shift { f = f * 2.0; i = i + 1; }
    } else if shift < 0 {
        let neg_s: Int = 0 - shift;
        while i < neg_s { f = f / 2.0; i = i + 1; }
    }
    if sign == 1 { f = 0.0 - f; }
    return f;
}

pub fn f32_to_fp16(f: Float) -> Int {
    if f == 0.0 { return 0; }
    let mut sign: Int = 0;
    let mut val: Float = f;
    if val < 0.0 { sign = 1; val = 0.0 - val; }
    let mut exp: Int = 15;
    while val >= 2.0 && exp < 30 { val = val / 2.0; exp = exp + 1; }
    while val < 1.0 && exp > 0 { val = val * 2.0; exp = exp - 1; }
    let mant: Int = quant_float_to_int((val - 1.0) * 1024.0);
    return (sign * 32768) + (exp * 1024) + (mant % 1024);
}

fn get_raw_u8(raw: String, idx: Int) -> Int {
    let b: Int = byte_at(raw, idx);
    if b < 0 { return 0; }
    return b;
}

pub fn q4_0_dequantize_block(raw: String, offset: Int) -> List[Float] {
    let b0: Int = get_raw_u8(raw, offset);
    let b1: Int = get_raw_u8(raw, offset + 1);
    let d_h: Int = b0 + (b1 * 256);
    let d: Float = fp16_to_f32(d_h);

    let mut out: List[Float] = list_new();
    let mut j: Int = 0;
    while j < 16 {
        let b: Int = get_raw_u8(raw, offset + 2 + j);
        let q0: Int = b % 16;
        let w0: Float = quant_int_to_float(q0 - 8) * d;
        out = list_push(out, w0);
        j = j + 1;
    }
    j = 0;
    while j < 16 {
        let b: Int = get_raw_u8(raw, offset + 2 + j);
        let q1: Int = (b / 16) % 16;
        let w1: Float = quant_int_to_float(q1 - 8) * d;
        out = list_push(out, w1);
        j = j + 1;
    }
    return out;
}

pub fn q4_0_dot_f32(raw: String, block_offset: Int, x: List[Float], x_offset: Int) -> Float {
    let b0: Int = get_raw_u8(raw, block_offset);
    let b1: Int = get_raw_u8(raw, block_offset + 1);
    let d_h: Int = b0 + (b1 * 256);
    let d: Float = fp16_to_f32(d_h);

    let mut sum: Float = 0.0;
    let mut j: Int = 0;
    while j < 16 {
        let b: Int = get_raw_u8(raw, block_offset + 2 + j);
        let q0: Int = b % 16;
        let q1: Int = (b / 16) % 16;
        let x0: Float = list_get(x, x_offset + j);
        let x1: Float = list_get(x, x_offset + j + 16);
        sum = sum + (quant_int_to_float(q0 - 8) * x0) + (quant_int_to_float(q1 - 8) * x1);
        j = j + 1;
    }
    return sum * d;
}

pub fn q4_k_dequantize_block(raw: String, offset: Int) -> List[Float] {
    let b0: Int = get_raw_u8(raw, offset);
    let b1: Int = get_raw_u8(raw, offset + 1);
    let d: Float = fp16_to_f32(b0 + (b1 * 256));
    let b2: Int = get_raw_u8(raw, offset + 2);
    let b3: Int = get_raw_u8(raw, offset + 3);
    let dmin: Float = fp16_to_f32(b2 + (b3 * 256));

    let mut out: List[Float] = list_new();
    let mut sb: Int = 0;
    while sb < 8 {
        let scale_byte: Int = get_raw_u8(raw, offset + 4 + sb);
        let d_sb: Float = d * quant_int_to_float(scale_byte % 64);
        let m_sb: Float = dmin * quant_int_to_float((scale_byte / 64) % 64);
        let mut k: Int = 0;
        while k < 32 {
            let q_byte_idx: Int = offset + 16 + (sb * 16) + (k / 2);
            let qb: Int = get_raw_u8(raw, q_byte_idx);
            let mut q: Int = qb % 16;
            if k % 2 == 1 { q = (qb / 16) % 16; }
            let w: Float = (d_sb * quant_int_to_float(q)) - m_sb;
            out = list_push(out, w);
            k = k + 1;
        }
        sb = sb + 1;
    }
    return out;
}

pub fn q4_k_dot_f32(raw: String, block_offset: Int, x: List[Float], x_offset: Int) -> Float {
    let b0: Int = get_raw_u8(raw, block_offset);
    let b1: Int = get_raw_u8(raw, block_offset + 1);
    let d: Float = fp16_to_f32(b0 + (b1 * 256));
    let b2: Int = get_raw_u8(raw, block_offset + 2);
    let b3: Int = get_raw_u8(raw, block_offset + 3);
    let dmin: Float = fp16_to_f32(b2 + (b3 * 256));

    let mut total_dot: Float = 0.0;
    let mut sb: Int = 0;
    while sb < 8 {
        let scale_byte: Int = get_raw_u8(raw, block_offset + 4 + sb);
        let d_sb: Float = d * quant_int_to_float(scale_byte % 64);
        let m_sb: Float = dmin * quant_int_to_float((scale_byte / 64) % 64);
        let mut sum_q_x: Float = 0.0;
        let mut sum_x: Float = 0.0;
        let mut k: Int = 0;
        while k < 32 {
            let elem_idx: Int = x_offset + (sb * 32) + k;
            let xv: Float = list_get(x, elem_idx);
            let q_byte_idx: Int = block_offset + 16 + (sb * 16) + (k / 2);
            let qb: Int = get_raw_u8(raw, q_byte_idx);
            let mut q: Int = qb % 16;
            if k % 2 == 1 { q = (qb / 16) % 16; }
            sum_q_x = sum_q_x + (quant_int_to_float(q) * xv);
            sum_x = sum_x + xv;
            k = k + 1;
        }
        total_dot = total_dot + (d_sb * sum_q_x) - (m_sb * sum_x);
        sb = sb + 1;
    }
    return total_dot;
}

pub fn quant_matvec_mul(qmat: &QuantizedTensor, x: List[Float]) -> List[Float] {
    let mut y: List[Float] = list_new();
    let mut r: Int = 0;
    if qmat.qtype == 12 {
        let blocks_per_row: Int = qmat.cols / 256;
        while r < qmat.rows {
            let mut row_sum: Float = 0.0;
            let mut b: Int = 0;
            while b < blocks_per_row {
                let blk_idx: Int = (r * blocks_per_row) + b;
                let blk_offset: Int = blk_idx * 144;
                let x_off: Int = b * 256;
                row_sum = row_sum + q4_k_dot_f32(qmat.raw_data, blk_offset, x, x_off);
                b = b + 1;
            }
            y = list_push(y, row_sum);
            r = r + 1;
        }
    } else {
        let blocks_per_row: Int = qmat.cols / 32;
        while r < qmat.rows {
            let mut row_sum: Float = 0.0;
            let mut b: Int = 0;
            while b < blocks_per_row {
                let blk_idx: Int = (r * blocks_per_row) + b;
                let blk_offset: Int = blk_idx * 18;
                let x_off: Int = b * 32;
                row_sum = row_sum + q4_0_dot_f32(qmat.raw_data, blk_offset, x, x_off);
                b = b + 1;
            }
            y = list_push(y, row_sum);
            r = r + 1;
        }
    }
    return y;
}
