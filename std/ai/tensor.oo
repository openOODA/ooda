// # Multi-Dimensional Tensors & Neural Math Kernels
//
// Logline: Provides multi-dimensional tensor shapes, broadcasting arithmetic, RMSNorm, SwiGLU, and stable softmax.
//
// Setup: Pure numerical algorithms for tensor math, memory layouts, and activation functions.
//
// Beats:
//   1. Construct 1D, 2D, 3D, 4D tensor shapes and strides.
//   2. Implement multi-dimensional broadcasting arithmetic (Add, Mul, Scale).
//   3. Implement Root-Mean-Square Normalization (RMSNorm) and SwiGLU activation.
//   4. Implement numerically stable softmax and argmax token sampling.

pub type TensorShape = struct {
    rank: Int,
    dim0: Int,
    dim1: Int,
    dim2: Int,
    dim3: Int,
    stride0: Int,
    stride1: Int,
    stride2: Int,
    stride3: Int,
    numel: Int
};

pub type Tensor = struct {
    shape: TensorShape,
    data: List[Float]
};

pub fn tensor_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 1000000 { f = f + 1000000.0; count = count - 1000000; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn tensor_shape_1d(d0: Int) -> TensorShape {
    return TensorShape { rank: 1, dim0: d0, dim1: 1, dim2: 1, dim3: 1, stride0: 1, stride1: 0, stride2: 0, stride3: 0, numel: d0 };
}

pub fn tensor_shape_2d(d0: Int, d1: Int) -> TensorShape {
    return TensorShape { rank: 2, dim0: d0, dim1: d1, dim2: 1, dim3: 1, stride0: d1, stride1: 1, stride2: 0, stride3: 0, numel: d0 * d1 };
}

pub fn tensor_shape_3d(d0: Int, d1: Int, d2: Int) -> TensorShape {
    return TensorShape { rank: 3, dim0: d0, dim1: d1, dim2: d2, dim3: 1, stride0: d1 * d2, stride1: d2, stride2: 1, stride3: 0, numel: d0 * d1 * d2 };
}

pub fn tensor_shape_4d(d0: Int, d1: Int, d2: Int, d3: Int) -> TensorShape {
    return TensorShape { rank: 4, dim0: d0, dim1: d1, dim2: d2, dim3: d3, stride0: d1 * d2 * d3, stride1: d2 * d3, stride2: d3, stride3: 1, numel: d0 * d1 * d2 * d3 };
}

pub fn tensor_create(shape: TensorShape, data: List[Float]) -> Tensor {
    return Tensor { shape: shape, data: data };
}

pub fn tensor_zeros(numel: Int) -> List[Float] {
    let mut d: List[Float] = list_new();
    let mut i: Int = 0;
    while i < numel { d = list_push(d, 0.0); i = i + 1; }
    return d;
}

pub fn tensor_broadcast_add(a: List[Float], b: List[Float]) -> List[Float] {
    let mut out: List[Float] = list_new();
    let n: Int = list_len(a);
    let b_n: Int = list_len(b);
    let mut i: Int = 0;
    while i < n {
        let va: Float = list_get(a, i);
        let mut vb: Float = 0.0;
        if b_n == 1 { vb = list_get(b, 0); }
        else if i < b_n { vb = list_get(b, i); }
        out = list_push(out, va + vb);
        i = i + 1;
    }
    return out;
}

pub fn tensor_broadcast_mul(a: List[Float], b: List[Float]) -> List[Float] {
    let mut out: List[Float] = list_new();
    let n: Int = list_len(a);
    let b_n: Int = list_len(b);
    let mut i: Int = 0;
    while i < n {
        let va: Float = list_get(a, i);
        let mut vb: Float = 1.0;
        if b_n == 1 { vb = list_get(b, 0); }
        else if i < b_n { vb = list_get(b, i); }
        out = list_push(out, va * vb);
        i = i + 1;
    }
    return out;
}

pub fn tensor_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut g: Float = x;
    if g > 100.0 { g = 10.0; }
    let mut i: Int = 0;
    while i < 10 {
        g = 0.5 * (g + (x / g));
        i = i + 1;
    }
    return g;
}

pub fn tensor_rms_norm(x_data: List[Float], gamma_data: List[Float], eps: Float) -> List[Float] {
    let mut out: List[Float] = list_new();
    let n: Int = list_len(x_data);
    let mut sum_sq: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let v: Float = list_get(x_data, i);
        sum_sq = sum_sq + (v * v);
        i = i + 1;
    }
    let mean_sq: Float = sum_sq / tensor_int_to_float(n);
    let mut inv_rms: Float = 1.0;
    let denom: Float = mean_sq + eps;
    if denom > 0.0 {
        inv_rms = 1.0 / tensor_sqrt(denom);
    }
    i = 0;
    let g_n: Int = list_len(gamma_data);
    while i < n {
        let v: Float = list_get(x_data, i);
        let mut g: Float = 1.0;
        if i < g_n { g = list_get(gamma_data, i); }
        out = list_push(out, v * inv_rms * g);
        i = i + 1;
    }
    return out;
}

pub fn tensor_silu(x_data: List[Float]) -> List[Float] {
    let mut out: List[Float] = list_new();
    let n: Int = list_len(x_data);
    let mut i: Int = 0;
    while i < n {
        let v: Float = list_get(x_data, i);
        let mut exp_neg: Float = 1.0;
        let neg_v: Float = 0.0 - v;
        if neg_v < 10.0 && neg_v > -10.0 {
            let mut term: Float = 1.0;
            let mut sum_e: Float = 1.0;
            let mut k: Int = 1;
            while k <= 8 {
                term = term * (neg_v / tensor_int_to_float(k));
                sum_e = sum_e + term;
                k = k + 1;
            }
            exp_neg = sum_e;
            if exp_neg < 0.0 { exp_neg = 0.0001; }
        } else if neg_v >= 10.0 {
            exp_neg = 22026.0;
        } else {
            exp_neg = 0.000045;
        }
        let sig: Float = 1.0 / (1.0 + exp_neg);
        out = list_push(out, v * sig);
        i = i + 1;
    }
    return out;
}

pub fn tensor_swiglu(gate: List[Float], up: List[Float]) -> List[Float] {
    let silu_gate: List[Float] = tensor_silu(gate);
    return tensor_broadcast_mul(silu_gate, up);
}

pub fn tensor_softmax_last_dim(x_data: List[Float]) -> List[Float] {
    let n: Int = list_len(x_data);
    let mut max_val: Float = -1000000.0;
    let mut i: Int = 0;
    while i < n {
        let v: Float = list_get(x_data, i);
        if v > max_val { max_val = v; }
        i = i + 1;
    }
    let mut sum_exp: Float = 0.0;
    let mut exp_list: List[Float] = list_new();
    i = 0;
    while i < n {
        let v: Float = list_get(x_data, i);
        let shift_v: Float = v - max_val;
        let mut exp_v: Float = 1.0;
        if shift_v > -10.0 {
            let mut term: Float = 1.0;
            let mut sum_e: Float = 1.0;
            let mut k: Int = 1;
            while k <= 8 {
                term = term * (shift_v / tensor_int_to_float(k));
                sum_e = sum_e + term;
                k = k + 1;
            }
            exp_v = sum_e;
            if exp_v < 0.0 { exp_v = 0.0; }
        } else {
            exp_v = 0.0;
        }
        exp_list = list_push(exp_list, exp_v);
        sum_exp = sum_exp + exp_v;
        i = i + 1;
    }
    if sum_exp <= 0.0 { sum_exp = 1.0; }
    let mut out: List[Float] = list_new();
    i = 0;
    while i < n {
        let ev: Float = list_get(exp_list, i);
        out = list_push(out, ev / sum_exp);
        i = i + 1;
    }
    return out;
}

pub fn tensor_argmax(x_data: List[Float]) -> Int {
    let n: Int = list_len(x_data);
    if n <= 0 { return 0; }
    let mut best_idx: Int = 0;
    let mut max_val: Float = list_get(x_data, 0);
    let mut i: Int = 1;
    while i < n {
        let v: Float = list_get(x_data, i);
        if v > max_val {
            max_val = v;
            best_idx = i;
        }
        i = i + 1;
    }
    return best_idx;
}
