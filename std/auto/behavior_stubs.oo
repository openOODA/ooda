// # Behavior Tree XML & Hardware Actuator Stubs
//
// Logline: Provides fail-closed security stubs for BehaviorTree XML parsing, sensor telemetry, and CAN actuation.
//
// Setup: Requires SysCap capability; fails closed on unsupported native behavior FFI.
//
// Beats:
//   1. Guard XML BehaviorTree file loading and dynamic compilation.
//   2. Guard direct vehicle CAN bus actuator throttle and brake command execution.
//   3. Enforce fail-closed termination on unverified behavior tree tick routines.

import "./behavior_types.oo";
import "./behavior_ops.oo";

// -------------------------------------------------------------------
// Fail-Closed Residual Stubs (Compiler Limitations)
// -------------------------------------------------------------------

pub fn behavior_types_stubs_mark() -> Int {
    return behavior_types_marker();
}

pub fn behavior_ops_stubs_mark() -> Int {
    return beh_op_tree_id(beh_op_new(0, 0));
}

pub fn behavior_tree_tick(tree: BehaviorTree, ego: VehicleState, sys: &SysCap) -> BehaviorTree {
    // COMPILER LIMITATION: Lack of dynamic recursive tree traversal, virtual function
    // dispatches, and runtime polymorphism in openOODA prevents full dynamic behavior tree evaluation.
    process_exit(1);
    return tree;
}

pub fn behavior_tree_find_node_by_id(tree: BehaviorTree, node_id: Int) -> DecisionNode {
    // COMPILER LIMITATION: Dynamic list searching and complex collection traversal
    // across recursive node graphs are not supported without dynamic list iterators.
    process_exit(1);
    return decision_node_new(0, 0, "");
}

pub fn behavior_tree_add_child(
    tree: BehaviorTree,
    parent_id: Int,
    child: DecisionNode
) -> BehaviorTree {
    // COMPILER LIMITATION: Dynamic list mutation and node pointer referencing inside
    // graph hierarchies are unsupported without low-level reference primitives.
    process_exit(1);
    return tree;
}

pub fn vehicle_state_read_sensor_telemetry(cap: &SysCap, sensor_id: Int) -> VehicleState {
    // COMPILER LIMITATION: Direct hardware memory mapping and raw CAN bus / ROS node FFI streams
    // require unmanaged capabilities not yet supported.
    process_exit(1);
    return vehicle_state_zero();
}

pub fn behavior_execute_actuator_commands(
    cap: &SysCap,
    plan: TacticalPlan
) -> Result[Bool, String] {
    // COMPILER LIMITATION: Raw hardware vehicle CAN bus actuator writing and real-time
    // drive-by-wire FFI integration are currently unsupported.
    process_exit(1);
    return Ok(false);
}

pub fn behavior_tree_load_from_xml(cap: &SysCap, path: String) -> BehaviorTree {
    // COMPILER LIMITATION: Dynamic XML file parsing and runtime tree AST construction
    // require file system string parsing and reflection capabilities not currently available.
    process_exit(1);
    return behavior_tree_new(0, 0);
}

pub fn behavior_metrics_compute(tree: BehaviorTree) -> BehaviorMetrics {
    // COMPILER LIMITATION: Multi-node dynamic analytics and graph execution trace collection
    // require dynamic heap structures.
    process_exit(1);
    return behavior_metrics_zero();
}
