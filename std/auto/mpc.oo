// # Model Predictive Control (MPC) Facade
//
// Logline: Re-exports vehicle state constraints, trajectory references, kinematic models, and QP engine.
//
// Setup: Pure module shim importing MPC types, operations, engine, and stubs submodules.
//
// Beats:
//   1. Import MPC types, operational cost algorithms, optimization engine, and stubs.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream vehicle trajectory controllers.

import "./mpc_types.oo";
import "./mpc_ops.oo";
import "./mpc_engine.oo";
import "./mpc_stubs.oo";

pub fn shim_marker_mpc_horizon_default() -> MpcHorizon {
    return mpc_horizon_default();
}

pub fn shim_marker_mpc_constraints_default() -> MpcConstraints {
    return mpc_constraints_default();
}

pub fn shim_marker_mpc_weights_default() -> MpcWeights {
    return mpc_weights_default();
}

verify mpc {
    // 1. Math helpers test
    let p: Float = mpc_pi();
    assert_eq!(p > 3.14, true);
    assert_eq!(mpc_abs(0.0 - 10.5), 10.5);
    assert_eq!(mpc_clamp(15.0, 0.0, 10.0), 10.0);

    // 2. Horizon & Struct creation tests
    let horizon: MpcHorizon = mpc_horizon_new(10, 0.1);
    assert_eq!((horizon).steps, 10);
    assert_eq!((horizon).dt_s > 0.09, true);

    let state: ControlState = control_state_new(0.0, 0.0, 0.0, 10.0, 0.0, 0.0, 0.0);
    assert_eq!((state).valid, true);

    let target: TrajectoryTarget = trajectory_target_new(10.0, 0.0, 0.0, 15.0, 0.0, 0.0);
    let dist: Float = mpc_distance_to_target(state, target);
    assert_eq!(dist > 9.9, true);

    // 3. Vehicle Kinematics Step Test
    let constraints: MpcConstraints = mpc_constraints_default();
    let next_state: ControlState = mpc_kinematic_bicycle_step(state, 0.05, 1.0, constraints, 0.1);
    assert_eq!((next_state).x > 0.0, true);
    assert_eq!((next_state).velocity > 10.0, true);

    // 4. Single-step MPC solve test
    let weights: MpcWeights = mpc_weights_default();
    let controller: MpcController = mpc_controller_init(horizon, weights, constraints);
    let result: MpcResult = mpc_solve_single_step(&controller, state, target);

    assert_eq!((result).solved, true);
    assert_eq!((result).iterations > 0, true);
    assert_eq!(((result).command).is_valid, true);
}
