// # MPC Vehicle State & Controller Constructors
//
// Logline: Constructor and default helpers for MpcHorizon, ControlState, TrajectoryTarget, weights, constraints, commands, and the MpcController.
//
// Setup: Imports mpc_types.oo for the type definitions.
//
// Beats:
//   1. Build and zero the horizon, control state, and trajectory target.
//   2. Build the weights and constraints with defaults or caller-supplied values.
//   3. Build the control command and wire up the MpcController bundle.

import "./mpc_types.oo";

pub fn mpc_horizon_new(steps: Int, dt_s: Float) -> MpcHorizon {
    let mut steps_clamped: Int = steps;
    if steps_clamped < 1 {
        steps_clamped = 1;
    }
    let mut dt_clamped: Float = dt_s;
    if dt_clamped <= 0.0 {
        dt_clamped = 0.1;
    }

    let mut i: Int = 0;
    let mut total_time: Float = 0.0;
    while i < steps_clamped {
        total_time = total_time + dt_clamped;
        i = i + 1;
    }

    return MpcHorizon {
        steps: steps_clamped,
        dt_s: dt_clamped,
        horizon_time_s: total_time
    };
}

pub fn mpc_horizon_default() -> MpcHorizon {
    return mpc_horizon_new(10, 0.1);
}

pub fn control_state_new(x: Float, y: Float, yaw: Float, v: Float, steer: Float, accel: Float, t: Float) -> ControlState {
    return ControlState {
        x: x,
        y: y,
        yaw: yaw,
        velocity: v,
        steering_angle: steer,
        acceleration: accel,
        timestamp_s: t,
        valid: true
    };
}

pub fn control_state_zero() -> ControlState {
    return ControlState {
        x: 0.0,
        y: 0.0,
        yaw: 0.0,
        velocity: 0.0,
        steering_angle: 0.0,
        acceleration: 0.0,
        timestamp_s: 0.0,
        valid: true
    };
}

pub fn trajectory_target_new(x: Float, y: Float, target_yaw: Float, target_speed: Float, curvature: Float, t: Float) -> TrajectoryTarget {
    return TrajectoryTarget {
        x: x,
        y: y,
        target_yaw: target_yaw,
        target_speed: target_speed,
        curvature: curvature,
        timestamp_s: t
    };
}

pub fn trajectory_target_zero() -> TrajectoryTarget {
    return TrajectoryTarget {
        x: 0.0,
        y: 0.0,
        target_yaw: 0.0,
        target_speed: 0.0,
        curvature: 0.0,
        timestamp_s: 0.0
    };
}

pub fn mpc_weights_new(pos_x: Float, pos_y: Float, yaw: Float, speed: Float, steer: Float, accel: Float, steer_rate: Float, accel_rate: Float, term_pos: Float, term_yaw: Float) -> MpcWeights {
    return MpcWeights {
        pos_x: pos_x,
        pos_y: pos_y,
        yaw: yaw,
        speed: speed,
        steer_angle: steer,
        acceleration: accel,
        steer_rate: steer_rate,
        accel_rate: accel_rate,
        terminal_pos: term_pos,
        terminal_yaw: term_yaw
    };
}

pub fn mpc_weights_default() -> MpcWeights {
    return MpcWeights {
        pos_x: 1.0,
        pos_y: 1.0,
        yaw: 0.5,
        speed: 0.5,
        steer_angle: 0.1,
        acceleration: 0.1,
        steer_rate: 0.2,
        accel_rate: 0.2,
        terminal_pos: 2.0,
        terminal_yaw: 1.0
    };
}

pub fn mpc_constraints_new(min_v: Float, max_v: Float, min_a: Float, max_a: Float, max_steer: Float, max_steer_rate: Float, wheelbase: Float) -> MpcConstraints {
    return MpcConstraints {
        min_speed: min_v,
        max_speed: max_v,
        min_accel: min_a,
        max_accel: max_a,
        max_steering_angle: max_steer,
        max_steering_rate: max_steer_rate,
        wheelbase_m: wheelbase
    };
}

pub fn mpc_constraints_default() -> MpcConstraints {
    return MpcConstraints {
        min_speed: 0.0,
        max_speed: 30.0,
        min_accel: 0.0 - 5.0,
        max_accel: 3.0,
        max_steering_angle: 0.610865,
        max_steering_rate: 1.047198,
        wheelbase_m: 2.7
    };
}

pub fn control_command_new(steer: Float, accel: Float, speed: Float, valid: Bool) -> ControlCommand {
    return ControlCommand {
        steering_angle: steer,
        acceleration: accel,
        target_speed: speed,
        is_valid: valid
    };
}

pub fn control_command_zero() -> ControlCommand {
    return ControlCommand {
        steering_angle: 0.0,
        acceleration: 0.0,
        target_speed: 0.0,
        is_valid: false
    };
}

pub fn mpc_controller_init(horizon: MpcHorizon, weights: MpcWeights, constraints: MpcConstraints) -> MpcController {
    return MpcController {
        horizon: horizon,
        weights: weights,
        constraints: constraints,
        current_state: control_state_zero(),
        target: trajectory_target_zero(),
        is_initialized: true
    };
}
