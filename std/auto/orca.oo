// # Optimal Reciprocal Collision Avoidance (ORCA) Facade
//
// Logline: Re-exports ORCA 2D/3D vector math, velocity obstacles, linear programming solver, and engine.
//
// Setup: Pure module shim importing ORCA types, operations, velocity obstacles, engine, and stubs.
//
// Beats:
//   1. Import ORCA types, vector operations, VO models, solver engine, and stubs.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream multi-agent navigation callers.

import "./orca_ops.oo";
import "./orca_vo.oo";
import "./orca_engine.oo";
import "./orca_stubs.oo";

pub fn shim_marker_vec2_zero() -> Vec2 {
    return vec2_zero();
}

pub fn shim_marker_vec3_zero() -> Vec3 {
    return vec3_zero();
}

pub fn shim_marker_agent_default() -> OrcaAgent {
    return orca_agent_default(1);
}

pub fn shim_marker_system_new() -> OrcaState {
    return orca_system_new(0.1);
}

pub fn shim_marker_init() -> Orca {
    return orca_init();
}

pub fn shim_marker_do_work(obj: &Orca) -> Int {
    return orca_do_work(obj);
}
