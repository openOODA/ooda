// # Fusion track
//
// Logline: FusTrk destubbed off List[TrackedObject] / Float track.
// residual: List[struct] destubbed to Int floor.

type FusTrk = struct {
    hits: Int,
    misses: Int
};

pub fn fus_trk_new(hits: Int, misses: Int) -> FusTrk {
    return FusTrk { hits: hits, misses: misses };
}

pub fn fus_trk_hits(t: FusTrk) -> Int {
    return t.hits;
}
