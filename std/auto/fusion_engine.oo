type FusEng = struct {
    active: Int,
    confirmed: Int
};

pub fn fus_eng_new(active: Int, confirmed: Int) -> FusEng {
    return FusEng { active: active, confirmed: confirmed };
}

pub fn fus_eng_active(e: FusEng) -> Int {
    return e.active;
}
