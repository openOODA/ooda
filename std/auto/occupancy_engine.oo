type OccEng = struct {
    dim_x: Int,
    dim_z: Int
};

pub fn occ_eng_new(dim_x: Int, dim_z: Int) -> OccEng {
    return OccEng { dim_x: dim_x, dim_z: dim_z };
}

pub fn occ_eng_dim_x(e: OccEng) -> Int {
    return e.dim_x;
}
