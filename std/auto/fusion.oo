// # Multi-Sensor Fusion Facade
//
// Logline: Re-exports sensor measurement types, Kalman tracking, multi-object association, and fusion engine.
//
// Setup: Pure module shim importing fusion types, math, sensor, track, kalman, engine, and stubs submodules.
//
// Beats:
//   1. Import multi-sensor fusion types, math, tracking algorithms, and stubs.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream perception consumers.

import "./fusion_sensor.oo";
import "./fusion_track.oo";
import "./fusion_kalman.oo";
import "./fusion_engine.oo";
import "./fusion_stubs.oo";

pub fn shim_marker_vec3_new() -> Vec3 {
    return vec3_new(1.0, 2.0, 3.0);
}

pub fn shim_marker_config_default() -> FusionConfig {
    return fusion_config_default();
}

pub fn shim_marker_state_default() -> FusionState {
    return fusion_state_default();
}

pub fn shim_marker_fusion_init() -> Fusion {
    return fusion_init();
}

pub fn shim_marker_fusion_do_work(obj: &Fusion) -> Int {
    return fusion_do_work(obj);
}
