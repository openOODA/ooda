// # Multi-Sensor Fusion Facade
//
// Logline: Destubbed Int fus_vec3/fus_eng facade. Off Float shims and fail-closed stubs.
//
// Setup: Pure module shim importing companion fusion submodules.
//
// Beats:
//   1. Re-export sensor, track, math, engine, and stubs helpers.
//   2. Provide unified entrypoints for downstream auto callers.
// residual: kalman/types destubbed to Int floor.

import "./fusion_math.oo";
import "./fusion_sensor.oo";
import "./fusion_track.oo";
import "./fusion_stubs.oo";

pub fn fusion_vec3_new(x: Int, y: Int, z: Int) -> FusVec3 {
    return fus_vec3_new(x, y, z);
}

pub fn fusion_sensor_new(stype: Int, label: Int) -> FusSens {
    return fus_sens_new(stype, label);
}

pub fn fusion_track_new(hits: Int, misses: Int) -> FusTrk {
    return fus_trk_new(hits, misses);
}

pub fn fusion_engine_new(active: Int, confirmed: Int) -> FusEng {
    return fus_eng_new(active, confirmed);
}
