// # Autonomous Vehicle Behavior Facade
//
// Logline: Re-exports behavior state machines, tactical plan generators, gap acceptance, and stubs.
//
// Setup: Pure module shim importing behavior types, operations, engine, and stubs submodules.
//
// Beats:
//   1. Import behavior types, operations, planning engine, and stubs.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream autonomous driving callers.

import "./behavior_types.oo";
import "./behavior_ops.oo";
import "./behavior_engine.oo";
import "./behavior_stubs.oo";

pub fn behavior_types_shim() -> Int {
    return behavior_types_marker();
}

pub fn behavior_ops_shim() -> Int {
    return beh_op_tree_id(beh_op_new(0, 0));
}

pub fn behavior_engine_shim() -> Int {
    return 1;
}

pub fn behavior_stubs_shim() -> Int {
    return 1;
}

pub fn shim_marker_status_success() -> Int {
    return status_success();
}

pub fn shim_marker_behavior_lane_keep() -> Int {
    return behavior_lane_keep();
}

pub fn shim_marker_vehicle_state_zero() -> VehicleState {
    return vehicle_state_zero();
}

pub fn shim_marker_vehicle_state_new() -> VehicleState {
    return vehicle_state_new(1, 0.0, 0.0, 10.0, 0.0, 0);
}

pub fn shim_marker_obstacle_state_new() -> ObstacleState {
    return obstacle_state_new(1, 10.0, 0.0, 0.0, 0.0, 1.5, 1);
}

pub fn shim_marker_decision_node_new() -> DecisionNode {
    return decision_node_new(1, 0, "root");
}

pub fn shim_marker_behavior_tree_new() -> BehaviorTree {
    return behavior_tree_new(1, 16);
}

pub fn shim_marker_tactical_plan_default() -> TacticalPlan {
    return tactical_plan_default();
}

pub fn shim_marker_vehicle_distance(a: VehicleState, b: VehicleState) -> Float {
    return vehicle_state_distance(a, b);
}

pub fn shim_marker_vehicle_ttc(lead: VehicleState, follower: VehicleState) -> Float {
    return vehicle_state_time_to_collision(lead, follower);
}

pub fn shim_marker_update_kinematics(state: VehicleState) -> VehicleState {
    return vehicle_state_update_kinematics(state, 0.1);
}

pub fn shim_marker_plan_lane_keep(ego: VehicleState) -> TacticalPlan {
    return tactical_plan_generate_lane_keep(ego, 15.0);
}

pub fn shim_marker_plan_stop(ego: VehicleState) -> TacticalPlan {
    return tactical_plan_generate_stop(ego, false);
}

pub fn shim_marker_metrics_zero() -> BehaviorMetrics {
    return behavior_metrics_zero();
}
