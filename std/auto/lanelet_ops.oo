type LltOp = struct {
    speed_kph: Int,
    lane_type: Int
};

pub fn llt_op_new(speed_kph: Int, lane_type: Int) -> LltOp {
    return LltOp { speed_kph: speed_kph, lane_type: lane_type };
}

pub fn llt_op_speed(o: LltOp) -> Int {
    return o.speed_kph;
}
