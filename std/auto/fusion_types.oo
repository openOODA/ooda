// # Sensor Fusion Data Types & Configurations
//
// Logline: Defines sensor measurements, tracked object state, association pairs, and fusion configurations.
//
// Setup: Pure data representations for multi-sensor perception and target tracking.
//
// Beats:
//   1. Define SensorMeasurement models for LiDAR, RADAR, and Camera modalities.
//   2. Define TrackedObject state with position, velocity, and covariance matrices.
//   3. Define FusionConfig parameters and FusionState global registry.

import "./fusion_math.oo";

// -------------------------------------------------------------------
// 2. Fundamental Struct Definitions
// -------------------------------------------------------------------

/// Sensor Measurement structure representing observation from physical sensor.
/// sensor_type: 1 = LiDAR, 2 = Radar, 3 = Camera, 4 = Ultrasonic
pub type SensorMeasurement = struct {
    id: Int,
    sensor_id: Int,
    sensor_type: Int,
    position: Vec3,
    velocity: Vec3,
    covariance_pos: Float,
    covariance_vel: Float,
    confidence: Float,
    class_label: Int,
    timestamp_s: Float,
    is_valid: Bool
};

/// Tracked Object structure representing state estimate of a target.
/// track_state: 0 = Tentative, 1 = Confirmed, 2 = Coasting, 3 = Deleted
pub type TrackedObject = struct {
    id: Int,
    track_state: Int,
    class_label: Int,
    position: Vec3,
    velocity: Vec3,
    acceleration: Vec3,
    size: Vec3,
    heading: Float,
    yaw_rate: Float,
    pos_covariance: Vec3,
    vel_covariance: Vec3,
    confidence: Float,
    age_ticks: Int,
    hits: Int,
    misses: Int,
    last_update_time_s: Float,
    is_active: Bool
};

/// Configuration parameters for multi-sensor data fusion engine.
pub type FusionConfig = struct {
    max_tracks: Int,
    gating_threshold_m: Float,
    confirmation_threshold_hits: Int,
    deletion_threshold_misses: Int,
    process_noise_pos: Float,
    process_noise_vel: Float,
    default_lidar_noise: Float,
    default_radar_noise: Float,
    default_camera_noise: Float
};

/// Global state container for multi-sensor object tracking and fusion pipeline.
pub type FusionState = struct {
    config: FusionConfig,
    tracks: List[TrackedObject],
    last_timestamp_s: Float,
    next_track_id: Int,
    active_track_count: Int,
    confirmed_track_count: Int,
    total_measurements_processed: Int,
    is_initialized: Bool
};

/// Data association pairing between a TrackedObject and a SensorMeasurement.
pub type AssociationPair = struct {
    track_id: Int,
    measurement_id: Int,
    distance_m: Float,
    is_matched: Bool
};

/// Statistical metrics for fusion system diagnostics.
pub type FusionMetrics = struct {
    total_tracks: Int,
    confirmed_tracks: Int,
    tentative_tracks: Int,
    coasting_tracks: Int,
    average_confidence: Float,
    processed_measurements: Int
};

/// Privileged capability handle struct for fusion engine operations.
pub type Fusion = struct {
    ptr: Int,
    len: Int,
    cap: &SysCap
};

pub fn fusion_types_marker_vec3() -> Vec3 {
    return vec3_zero();
}
