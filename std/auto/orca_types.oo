// # ORCA Vector Math & Agent Data Types
//
// Logline: Defines 2D/3D vectors, OrcaAgent state, VelocityObstacle cones, and half-plane OrcaLine2D structures.
//
// Setup: Pure data representations and foundational vector math for reciprocal collision avoidance.
//
// Beats:
//   1. Define Vec2 and Vec3 data structures with arithmetic and geometric operations.
//   2. Define OrcaAgent parameters including position, velocity, radius, and max speed.
//   3. Define VelocityObstacle, AvoidancePlane, and OrcaLine2D linear constraint models.

// -------------------------------------------------------------------
// Types
// -------------------------------------------------------------------

pub type Vec2 = struct {
    x: Float,
    y: Float
};

pub type Vec3 = struct {
    x: Float,
    y: Float,
    z: Float
};

pub type OrcaAgent = struct {
    id: Int,
    position: Vec3,
    velocity: Vec3,
    pref_velocity: Vec3,
    new_velocity: Vec3,
    radius: Float,
    max_speed: Float,
    time_horizon: Float,
    time_horizon_obst: Float,
    max_neighbors: Int,
    neighbor_dist: Float,
    responsibility_factor: Float,
    is_active: Bool
};

pub type VelocityObstacle = struct {
    apex: Vec3,
    relative_position: Vec3,
    relative_velocity: Vec3,
    combined_radius: Float,
    time_horizon: Float,
    cutoff_center: Vec3,
    cutoff_radius: Float,
    is_agent: Bool,
    other_id: Int
};

pub type AvoidancePlane = struct {
    point: Vec3,
    normal: Vec3,
    distance: Float,
    agent_id: Int,
    is_obstacle: Bool
};

pub type OrcaLine2D = struct {
    point: Vec2,
    direction: Vec2,
    normal: Vec2,
    obstacle_id: Int,
    is_obstacle: Bool
};

pub type ObstacleSegment = struct {
    id: Int,
    point1: Vec3,
    point2: Vec3,
    normal: Vec3,
    unit_dir: Vec3,
    is_convex: Bool,
    next_obstacle_id: Int,
    prev_obstacle_id: Int
};

pub type OrcaState = struct {
    time_step: Float,
    agents: List[OrcaAgent],
    obstacles: List[ObstacleSegment],
    global_time: Float,
    max_agent_count: Int,
    iteration_count: Int,
    is_initialized: Bool
};

pub type Orca = struct {
    ptr: Int,
    len: Int,
    cap: &SysCap
};

// -------------------------------------------------------------------
// Vector constructors and operations
// -------------------------------------------------------------------

/// Constructs a new Vec2.
pub fn vec2_new(v2_x: Float, v2_y: Float) -> Vec2 {
    return Vec2 { x: v2_x, y: v2_y };
}

/// Constructs a zero Vec2.
pub fn vec2_zero() -> Vec2 {
    return Vec2 { x: 0.0, y: 0.0 };
}

/// Vec2 addition: v2_a + v2_b
pub fn vec2_add(v2_a: Vec2, v2_b: Vec2) -> Vec2 {
    return Vec2 {
        x: (v2_a).x + (v2_b).x,
        y: (v2_a).y + (v2_b).y
    };
}

/// Vec2 subtraction: v2_a - v2_b
pub fn vec2_sub(v2_a: Vec2, v2_b: Vec2) -> Vec2 {
    return Vec2 {
        x: (v2_a).x - (v2_b).x,
        y: (v2_a).y - (v2_b).y
    };
}

/// Vec2 scalar multiplication: v2_val * v2_s
pub fn vec2_scale(v2_val: Vec2, v2_s: Float) -> Vec2 {
    return Vec2 {
        x: (v2_val).x * v2_s,
        y: (v2_val).y * v2_s
    };
}

/// Vec2 dot product: v2_d1 . v2_d2
pub fn vec2_dot(v2_d1: Vec2, v2_d2: Vec2) -> Float {
    return ((v2_d1).x * (v2_d2).x) + ((v2_d1).y * (v2_d2).y);
}

/// Vec2 determinant / perpendicular dot product
pub fn vec2_det(v2_dt1: Vec2, v2_dt2: Vec2) -> Float {
    return ((v2_dt1).x * (v2_dt2).y) - ((v2_dt1).y * (v2_dt2).x);
}

/// Vec2 squared magnitude: |v2_lsq|^2
pub fn vec2_length_sq(v2_lsq: Vec2) -> Float {
    return vec2_dot(v2_lsq, v2_lsq);
}

/// Vec2 magnitude: |v2_len|
pub fn vec2_length(v2_len: Vec2) -> Float {
    return sqrt(vec2_length_sq(v2_len));
}

/// Vec2 normalization: unit vector or zero if tiny.
pub fn vec2_normalize(v2_nrm: Vec2) -> Vec2 {
    let v2_nlen = vec2_length(v2_nrm);
    if v2_nlen < 0.000000001 {
        return vec2_zero();
    }
    return vec2_scale(v2_nrm, 1.0 / v2_nlen);
}

/// Distance between two 2D points.
pub fn vec2_dist(v2_p1: Vec2, v2_p2: Vec2) -> Float {
    return vec2_length(vec2_sub(v2_p1, v2_p2));
}

/// Squared distance between two 2D points.
pub fn vec2_dist_sq(v2_ps1: Vec2, v2_ps2: Vec2) -> Float {
    return vec2_length_sq(vec2_sub(v2_ps1, v2_ps2));
}

/// Constructs a new Vec3.
pub fn vec3_new(v3_x: Float, v3_y: Float, v3_z: Float) -> Vec3 {
    return Vec3 { x: v3_x, y: v3_y, z: v3_z };
}

/// Constructs a zero Vec3.
pub fn vec3_zero() -> Vec3 {
    return Vec3 { x: 0.0, y: 0.0, z: 0.0 };
}

/// Vec3 addition: v3_a + v3_b
pub fn vec3_add(v3_a: Vec3, v3_b: Vec3) -> Vec3 {
    return Vec3 {
        x: (v3_a).x + (v3_b).x,
        y: (v3_a).y + (v3_b).y,
        z: (v3_a).z + (v3_b).z
    };
}

/// Vec3 subtraction: v3_a - v3_b
pub fn vec3_sub(v3_a: Vec3, v3_b: Vec3) -> Vec3 {
    return Vec3 {
        x: (v3_a).x - (v3_b).x,
        y: (v3_a).y - (v3_b).y,
        z: (v3_a).z - (v3_b).z
    };
}

/// Vec3 scalar multiplication: v3_val * v3_s
pub fn vec3_scale(v3_val: Vec3, v3_s: Float) -> Vec3 {
    return Vec3 {
        x: (v3_val).x * v3_s,
        y: (v3_val).y * v3_s,
        z: (v3_val).z * v3_s
    };
}

/// Vec3 dot product: v3_d1 . v3_d2
pub fn vec3_dot(v3_d1: Vec3, v3_d2: Vec3) -> Float {
    return (((v3_d1).x * (v3_d2).x) + ((v3_d1).y * (v3_d2).y)) + ((v3_d1).z * (v3_d2).z);
}

/// Vec3 cross product: v3_c1 x v3_c2
pub fn vec3_cross(v3_c1: Vec3, v3_c2: Vec3) -> Vec3 {
    let nx = ((v3_c1).y * (v3_c2).z) - ((v3_c1).z * (v3_c2).y);
    let ny = ((v3_c1).z * (v3_c2).x) - ((v3_c1).x * (v3_c2).z);
    let nz = ((v3_c1).x * (v3_c2).y) - ((v3_c1).y * (v3_c2).x);
    return Vec3 { x: nx, y: ny, z: nz };
}

/// Vec3 squared magnitude: |v3_lsq|^2
pub fn vec3_length_sq(v3_lsq: Vec3) -> Float {
    return vec3_dot(v3_lsq, v3_lsq);
}

/// Vec3 magnitude: |v3_len|
pub fn vec3_length(v3_len: Vec3) -> Float {
    return sqrt(vec3_length_sq(v3_len));
}

/// Vec3 normalization: unit vector or zero if tiny.
pub fn vec3_normalize(v3_nrm: Vec3) -> Vec3 {
    let v3_nlen = vec3_length(v3_nrm);
    if v3_nlen < 0.000000001 {
        return vec3_zero();
    }
    return vec3_scale(v3_nrm, 1.0 / v3_nlen);
}

/// Distance between two 3D points.
pub fn vec3_dist(v3_p1: Vec3, v3_p2: Vec3) -> Float {
    return vec3_length(vec3_sub(v3_p1, v3_p2));
}

/// Squared distance between two 3D points.
pub fn vec3_dist_sq(v3_ps1: Vec3, v3_ps2: Vec3) -> Float {
    return vec3_length_sq(vec3_sub(v3_ps1, v3_ps2));
}
