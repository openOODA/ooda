// # Behavior ops
//
// Logline: BehOp destubbed off Float VehicleState / String DecisionNode.
// residual: destubbed to Int floor.

import "./behavior_types.oo";

type BehOp = struct {
    tree_id: Int,
    max_nodes: Int
};

pub fn beh_op_new(tree_id: Int, max_nodes: Int) -> BehOp {
    return BehOp { tree_id: tree_id, max_nodes: max_nodes };
}

pub fn beh_op_tree_id(b: BehOp) -> Int {
    return b.tree_id;
}

pub fn vehicle_state_zero() -> VehicleState {
    return VehicleState {
        id: 0,
        x: 0.0,
        y: 0.0,
        z: 0.0,
        vx: 0.0,
        vy: 0.0,
        vz: 0.0,
        speed: 0.0,
        yaw: 0.0,
        yaw_rate: 0.0,
        steering_angle: 0.0,
        acceleration: 0.0,
        target_speed: 0.0,
        current_lane_id: 0,
        target_lane_id: 0,
        fuel_or_battery_pct: 100.0,
        is_autonomous: false,
        emergency_stop: false,
    };
}

pub fn vehicle_state_new(id: Int, x: Float, y: Float, speed: Float, yaw: Float, lane: Int) -> VehicleState {
    return VehicleState {
        id: id,
        x: x,
        y: y,
        z: 0.0,
        vx: speed * cos(yaw),
        vy: speed * sin(yaw),
        vz: 0.0,
        speed: speed,
        yaw: yaw,
        yaw_rate: 0.0,
        steering_angle: 0.0,
        acceleration: 0.0,
        target_speed: speed,
        current_lane_id: lane,
        target_lane_id: lane,
        fuel_or_battery_pct: 100.0,
        is_autonomous: true,
        emergency_stop: false,
    };
}

pub fn obstacle_state_new(id: Int, x: Float, y: Float, vx: Float, vy: Float, radius: Float, obs_class: Int) -> ObstacleState {
    let sp: Float = sqrt((vx * vx) + (vy * vy));
    return ObstacleState {
        id: id,
        x: x,
        y: y,
        z: 0.0,
        vx: vx,
        vy: vy,
        vz: 0.0,
        speed: sp,
        bounding_radius: radius,
        obstacle_class: obs_class,
        is_predicted_hazard: false,
    };
}

pub fn decision_node_new(id: Int, node_type: Int, name: String) -> DecisionNode {
    return DecisionNode {
        id: id,
        node_type: node_type,
        status: status_invalid(),
        name: name,
        parent_id: 0,
        child_count: 0,
        action_id: 0,
        threshold: 0.0,
        is_enabled: true,
    };
}

pub fn behavior_tree_new(tree_id: Int, max_nodes: Int) -> BehaviorTree {
    let n_list: List[DecisionNode] = list_new();
    return BehaviorTree {
        tree_id: tree_id,
        root_node_id: 0,
        node_count: 0,
        max_nodes: max_nodes,
        tick_count: 0,
        current_behavior: behavior_idle(),
        nodes: n_list,
        last_status: status_invalid(),
        is_active: false,
    };
}

pub fn tactical_plan_default() -> TacticalPlan {
    return TacticalPlan {
        plan_id: 0,
        target_behavior: behavior_idle(),
        target_speed: 0.0,
        target_lane_id: 0,
        time_to_collision: 999.0,
        safe_distance: 10.0,
        recommended_acceleration: 0.0,
        recommended_steering: 0.0,
        lane_change_allowed: false,
        is_emergency: false,
    };
}

pub fn behavior_metrics_zero() -> BehaviorMetrics {
    return BehaviorMetrics {
        total_ticks: 0,
        successful_executions: 0,
        failed_executions: 0,
        running_executions: 0,
        avg_evaluation_time_ms: 0.0,
        emergency_interventions: 0,
    };
}
