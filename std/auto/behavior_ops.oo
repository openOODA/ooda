// # Behavior ops
//
// Logline: BehOp destubbed off Float VehicleState / String DecisionNode.
// residual: destubbed to Int floor.

type BehOp = struct {
    tree_id: Int,
    max_nodes: Int
};

pub fn beh_op_new(tree_id: Int, max_nodes: Int) -> BehOp {
    return BehOp { tree_id: tree_id, max_nodes: max_nodes };
}

pub fn beh_op_tree_id(b: BehOp) -> Int {
    return b.tree_id;
}
