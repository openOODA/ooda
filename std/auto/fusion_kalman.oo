// # Kalman Filter & Data Association Algorithms
//
// Logline: Executes Kalman predict and update steps with Euclidean and Mahalanobis distance gating.
//
// Setup: Tracking filter algorithms importing fusion_types.oo.
//
// Beats:
//   1. Propagate track state and covariance forward using constant-velocity models.
//   2. Compute Mahalanobis statistical distance for measurement association gating.
//   3. Update state estimates with measurement innovations and Kalman gain.

import "./fusion_types.oo";

pub fn kalman_predict_pos(p: Float, v: Float, a: Float, dt: Float) -> Float {
    let half_dt_sq: Float = 0.5 * (dt * dt);
    let v_dt: Float = v * dt;
    let a_dt2: Float = a * half_dt_sq;
    let delta: Float = v_dt + a_dt2;
    return p + delta;
}

pub fn kalman_predict_vel(v: Float, a: Float, dt: Float) -> Float {
    let a_dt: Float = a * dt;
    return v + a_dt;
}

pub fn kalman_predict_cov(cov: Float, q_noise: Float, dt: Float) -> Float {
    let q_term: Float = q_noise * dt;
    return cov + q_term;
}

pub fn kalman_gain(p_cov: Float, r_meas: Float) -> Float {
    let den: Float = p_cov + r_meas;
    if den <= 0.000001 {
        return 0.0;
    }
    return p_cov / den;
}

pub fn kalman_update_state(pos: Float, k_gain: Float, meas_pos: Float) -> Float {
    let innov: Float = meas_pos - pos;
    let corr: Float = k_gain * innov;
    return pos + corr;
}

pub fn kalman_update_covariance(k_gain: Float, p_cov: Float) -> Float {
    let factor: Float = 1.0 - k_gain;
    return factor * p_cov;
}

pub fn compute_euclidean_distance(p1: Vec3, p2: Vec3) -> Float {
    return vec3_dist(p1, p2);
}

pub fn compute_mahalanobis_distance(p1: Vec3, p2: Vec3, cov1: Vec3, r_meas: Float) -> Float {
    let dx: Float = (p2).x - (p1).x;
    let dy: Float = (p2).y - (p1).y;
    let dz: Float = (p2).z - (p1).z;

    let var_x: Float = (cov1).x + r_meas;
    let var_y: Float = (cov1).y + r_meas;
    let var_z: Float = (cov1).z + r_meas;

    let term_x: Float = (dx * dx) / var_x;
    let term_y: Float = (dy * dy) / var_y;
    let term_z: Float = (dz * dz) / var_z;
    let sum_xy: Float = term_x + term_y;
    let dist_sq: Float = sum_xy + term_z;
    if dist_sq < 0.000000001 {
        return 0.0;
    }
    return sqrt(dist_sq);
}

pub fn kalman_predict_step(track: TrackedObject, dt: Float, config: FusionConfig) -> TrackedObject {
    if !(track).is_active {
        return track;
    }
    let safe_dt: Float = math_max(0.0, dt);

    let next_x: Float = kalman_predict_pos(((track).position).x, ((track).velocity).x, ((track).acceleration).x, safe_dt);
    let next_y: Float = kalman_predict_pos(((track).position).y, ((track).velocity).y, ((track).acceleration).y, safe_dt);
    let next_z: Float = kalman_predict_pos(((track).position).z, ((track).velocity).z, ((track).acceleration).z, safe_dt);

    let next_vx: Float = kalman_predict_vel(((track).velocity).x, ((track).acceleration).x, safe_dt);
    let next_vy: Float = kalman_predict_vel(((track).velocity).y, ((track).acceleration).y, safe_dt);
    let next_vz: Float = kalman_predict_vel(((track).velocity).z, ((track).acceleration).z, safe_dt);

    let q_p: Float = (config).process_noise_pos;
    let q_v: Float = (config).process_noise_vel;

    let next_pcov_x: Float = kalman_predict_cov(((track).pos_covariance).x, q_p, safe_dt);
    let next_pcov_y: Float = kalman_predict_cov(((track).pos_covariance).y, q_p, safe_dt);
    let next_pcov_z: Float = kalman_predict_cov(((track).pos_covariance).z, q_p, safe_dt);

    let next_vcov_x: Float = kalman_predict_cov(((track).vel_covariance).x, q_v, safe_dt);
    let next_vcov_y: Float = kalman_predict_cov(((track).vel_covariance).y, q_v, safe_dt);
    let next_vcov_z: Float = kalman_predict_cov(((track).vel_covariance).z, q_v, safe_dt);

    return TrackedObject {
        id: (track).id,
        track_state: (track).track_state,
        class_label: (track).class_label,
        position: vec3_new(next_x, next_y, next_z),
        velocity: vec3_new(next_vx, next_vy, next_vz),
        acceleration: (track).acceleration,
        size: (track).size,
        heading: (track).heading,
        yaw_rate: (track).yaw_rate,
        pos_covariance: vec3_new(next_pcov_x, next_pcov_y, next_pcov_z),
        vel_covariance: vec3_new(next_vcov_x, next_vcov_y, next_vcov_z),
        confidence: (track).confidence,
        age_ticks: (track).age_ticks + 1,
        hits: (track).hits,
        misses: (track).misses,
        last_update_time_s: (track).last_update_time_s + safe_dt,
        is_active: (track).is_active,
    };
}

pub fn kalman_update_step(track: TrackedObject, meas: SensorMeasurement, config: FusionConfig) -> TrackedObject {
    if !(meas).is_valid {
        return track;
    }

    let r_p: Float = (meas).covariance_pos;
    let k_x: Float = kalman_gain(((track).pos_covariance).x, r_p);
    let k_y: Float = kalman_gain(((track).pos_covariance).y, r_p);
    let k_z: Float = kalman_gain(((track).pos_covariance).z, r_p);

    let up_x: Float = kalman_update_state(((track).position).x, k_x, ((meas).position).x);
    let up_y: Float = kalman_update_state(((track).position).y, k_y, ((meas).position).y);
    let up_z: Float = kalman_update_state(((track).position).z, k_z, ((meas).position).z);

    let up_cov_x: Float = kalman_update_covariance(k_x, ((track).pos_covariance).x);
    let up_cov_y: Float = kalman_update_covariance(k_y, ((track).pos_covariance).y);
    let up_cov_z: Float = kalman_update_covariance(k_z, ((track).pos_covariance).z);

    let mut up_vel: Vec3 = (track).velocity;
    let mut up_vel_cov: Vec3 = (track).vel_covariance;

    if (meas).sensor_type == 2 {
        let r_v: Float = (meas).covariance_vel;
        let kv_x: Float = kalman_gain(((track).vel_covariance).x, r_v);
        let kv_y: Float = kalman_gain(((track).vel_covariance).y, r_v);
        let kv_z: Float = kalman_gain(((track).vel_covariance).z, r_v);

        let uv_x: Float = kalman_update_state(((track).velocity).x, kv_x, ((meas).velocity).x);
        let uv_y: Float = kalman_update_state(((track).velocity).y, kv_y, ((meas).velocity).y);
        let uv_z: Float = kalman_update_state(((track).velocity).z, kv_z, ((meas).velocity).z);

        let uvcov_x: Float = kalman_update_covariance(kv_x, ((track).vel_covariance).x);
        let uvcov_y: Float = kalman_update_covariance(kv_y, ((track).vel_covariance).y);
        let uvcov_z: Float = kalman_update_covariance(kv_z, ((track).vel_covariance).z);

        up_vel = vec3_new(uv_x, uv_y, uv_z);
        up_vel_cov = vec3_new(uvcov_x, uvcov_y, uvcov_z);
    }

    let new_hits: Int = (track).hits + 1;
    let mut new_state: Int = (track).track_state;
    if new_state == 0 {
        if new_hits >= (config).confirmation_threshold_hits {
            new_state = 1;
        }
    } else {
        if new_state == 2 {
            new_state = 1;
        }
    }

    let conf_sum: Float = ((track).confidence * 0.7) + ((meas).confidence * 0.3);
    let new_conf: Float = clamp_float(conf_sum, 0.0, 1.0);

    let mut new_label: Int = (track).class_label;
    if (meas).class_label != 0 {
        new_label = (meas).class_label;
    }

    return TrackedObject {
        id: (track).id,
        track_state: new_state,
        class_label: new_label,
        position: vec3_new(up_x, up_y, up_z),
        velocity: up_vel,
        acceleration: (track).acceleration,
        size: (track).size,
        heading: (track).heading,
        yaw_rate: (track).yaw_rate,
        pos_covariance: vec3_new(up_cov_x, up_cov_y, up_cov_z),
        vel_covariance: up_vel_cov,
        confidence: new_conf,
        age_ticks: (track).age_ticks,
        hits: new_hits,
        misses: 0,
        last_update_time_s: (meas).timestamp_s,
        is_active: true,
    };
}
