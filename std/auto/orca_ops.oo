// # ORCA ops
//
// Logline: OrcaOp destubbed off Float Vec3 agent geometry.
// residual: destubbed to Int floor.

type OrcaOp = struct {
    radius_mm: Int,
    max_speed: Int
};

pub fn orca_op_new(radius_mm: Int, max_speed: Int) -> OrcaOp {
    return OrcaOp { radius_mm: radius_mm, max_speed: max_speed };
}

pub fn orca_op_radius(a: OrcaOp) -> Int {
    return a.radius_mm;
}
