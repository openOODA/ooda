// residual: List[struct] destubbed to Int floor.

type OccOp = struct {
    voxel_mm: Int,
    log_odds: Int
};

pub fn occ_op_new(voxel_mm: Int, log_odds: Int) -> OccOp {
    return OccOp { voxel_mm: voxel_mm, log_odds: log_odds };
}

pub fn occ_op_voxel(o: OccOp) -> Int {
    return o.voxel_mm;
}
