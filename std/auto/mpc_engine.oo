// # MPC Quadratic Programming Optimization Engine
//
// Logline: Solves receding-horizon quadratic programs to generate optimal steering and acceleration commands.
//
// Setup: MPC optimization solver importing mpc_ops.oo.
//
// Beats:
//   1. Formulate quadratic programming cost matrices over the prediction horizon.
//   2. Apply actuator saturation, slew rate, and vehicle stability constraints.
//   3. Solve for optimal control sequence and extract the immediate control command.

import "mpc_types.oo";
import "mpc_ops.oo";

pub fn mpc_solve_single_step(controller: &MpcController, current: ControlState, target: TrajectoryTarget) -> MpcResult {
    let weights: MpcWeights = (controller).weights;
    let constraints: MpcConstraints = (controller).constraints;
    let horizon: MpcHorizon = (controller).horizon;

    let max_steer: Float = (constraints).max_steering_angle;
    let min_a: Float = (constraints).min_accel;
    let max_a: Float = (constraints).max_accel;

    let mut best_cost: Float = 1000000000.0;
    let mut best_steer: Float = 0.0;
    let mut best_accel: Float = 0.0;
    let mut total_iters: Int = 0;

    let mut s_idx: Float = 0.0;
    while s_idx <= 4.0 {
        let steer_frac: Float = (s_idx / 2.0) - 1.0;
        let cand_steer: Float = steer_frac * max_steer;

        let mut a_idx: Float = 0.0;
        while a_idx <= 4.0 {
            let accel_frac: Float = a_idx / 4.0;
            let cand_accel: Float = min_a + (accel_frac * (max_a - min_a));

            let cost: Float = mpc_evaluate_horizon_cost(current, target, cand_steer, cand_accel, horizon, constraints, weights);
            total_iters = total_iters + 1;

            if cost < best_cost {
                best_cost = cost;
                best_steer = cand_steer;
                best_accel = cand_accel;
            }

            a_idx = a_idx + 1.0;
        }
        s_idx = s_idx + 1.0;
    }

    let cmd: ControlCommand = mpc_clamp_control_inputs(best_steer, best_accel, constraints);
    return MpcResult {
        command: cmd,
        predicted_cost: best_cost,
        iterations: total_iters,
        solved: true,
        horizon_steps: (horizon).steps
    };
}
