// # Occupancy Grid Facade
//
// Logline: Re-exports 3D occupancy grid types, spatial operations, probabilistic engine, and stubs.
//
// Setup: Pure module shim importing companion occupancy submodules.
//
// Beats:
//   1. Import occupancy types, operations, engine, and hardware stubs.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream autonomous callers.

import "./occupancy_types.oo";
import "./occupancy_ops.oo";
import "./occupancy_engine.oo";
import "./occupancy_stubs.oo";

pub fn shim_marker_grid_bounds_zero() -> GridBounds {
    return grid_bounds_zero();
}

pub fn shim_marker_grid_bounds_new() -> GridBounds {
    return grid_bounds_new(0, 0, 0, 1000, 1000, 1000);
}

pub fn shim_marker_log_odds_to_prob(lo: Int) -> Int {
    return log_odds_to_prob(lo);
}

pub fn shim_marker_voxel_node_default() -> VoxelNode {
    return voxel_node_default(0, 0, 0, 0);
}

pub fn shim_marker_occupancy_grid_new() -> OccupancyGrid3D {
    let b = grid_bounds_new(0, 0, 0, 1000, 1000, 1000);
    return occupancy_grid_new(b, 100, vec3_new(0, 0, 0));
}

pub fn shim_marker_occupancy_init() -> Occupancy {
    return occupancy_init();
}

pub fn shim_marker_occupancy_do_work(obj: &Occupancy) -> Int {
    return occupancy_do_work(obj);
}
