// # Fusion sensor
//
// Logline: FusSens destubbed off Float SensorMeasurement.
// residual: destubbed to Int floor.

type FusSens = struct {
    stype: Int,
    label: Int
};

pub fn fus_sens_new(stype: Int, label: Int) -> FusSens {
    return FusSens { stype: stype, label: label };
}

pub fn fus_sens_stype(s: FusSens) -> Int {
    return s.stype;
}
