type LltEng = struct {
    map_id: Int,
    n_lanelets: Int
};

pub fn llt_eng_new(map_id: Int, n_lanelets: Int) -> LltEng {
    return LltEng { map_id: map_id, n_lanelets: n_lanelets };
}

pub fn llt_eng_map_id(e: LltEng) -> Int {
    return e.map_id;
}
