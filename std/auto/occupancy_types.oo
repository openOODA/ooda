// # Occupancy Grid Types & Math
//
// Logline: Defines spatial bounding boxes, voxel nodes, and 3D occupancy grid types.
//
// Setup: Pure type definitions and geometric math helpers without capability requirements.
//
// Beats:
//   1. Define 3D integer vector math helpers and spatial bounding boxes.
//   2. Define VoxelNode representation and log-odds probability transforms.
//   3. Define OccupancyGrid3D, Ray3D, and summary statistics structures.

// -------------------------------------------------------------------
// Vector3 Math Helpers
// -------------------------------------------------------------------

pub type Vector3 = struct {
    x: Int,
    y: Int,
    z: Int,
};

pub fn vec3_new(x: Int, y: Int, z: Int) -> Vector3 {
    return Vector3 { x: x, y: y, z: z };
}

pub fn vec3_sub(a: Vector3, b: Vector3) -> Vector3 {
    return Vector3 { x: (a).x - (b).x, y: (a).y - (b).y, z: (a).z - (b).z };
}

pub fn vec3_length_squared(a: Vector3) -> Int {
    return ((a).x * (a).x) + ((a).y * (a).y) + ((a).z * (a).z);
}

// -------------------------------------------------------------------
// Fundamental Struct Definitions
// -------------------------------------------------------------------

/// Represents spatial 3D bounding box extents (in mm or world units).
pub type GridBounds = struct {
    min_x: Int,
    min_y: Int,
    min_z: Int,
    max_x: Int,
    max_y: Int,
    max_z: Int,
};

/// Represents a single voxel node within the 3D grid.
pub type VoxelNode = struct {
    x: Int,
    y: Int,
    z: Int,
    log_odds: Int,        // Scaled log-odds occupancy score (-1000..1000)
    occupancy_prob: Int,  // Scaled probability (0..1000: 0=free, 500=unknown, 1000=occupied)
    semantic_label: Int,  // 0=unclassified, 1=free_space, 2=obstacle, 3=vehicle, 4=pedestrian, 5=road
    is_observed: Bool,
};

/// 3D Occupancy Grid Map data structure.
pub type OccupancyGrid3D = struct {
    bounds: GridBounds,
    voxel_size_mm: Int,
    dim_x: Int,
    dim_y: Int,
    dim_z: Int,
    origin: Vector3,
    default_log_odds: Int,
    voxels: List[VoxelNode],
    updated_count: Int,
};

/// 3D Sensor Ray representation for ray-casting / LIDAR probability updates.
pub type Ray3D = struct {
    origin: Vector3,
    target: Vector3,
    max_range_mm: Int,
};

/// Summary statistics for 3D occupancy grid analysis.
pub type OccupancyStats = struct {
    total_voxels: Int,
    occupied_count: Int,
    free_count: Int,
    unknown_count: Int,
    min_prob: Int,
    max_prob: Int,
};

/// Capability handle struct for privileged low-level operations.
pub type Occupancy = struct {
    ptr: Int,
    len: Int,
    cap: &SysCap,
};

// -------------------------------------------------------------------
// Basic Helper Functions & Math Utilities
// -------------------------------------------------------------------

pub fn abs_val(val: Int) -> Int {
    if val < 0 {
        return 0 - val;
    }
    return val;
}

pub fn min_val(val_a: Int, val_b: Int) -> Int {
    if val_a < val_b {
        return val_a;
    }
    return val_b;
}

pub fn max_val(val_a: Int, val_b: Int) -> Int {
    if val_a > val_b {
        return val_a;
    }
    return val_b;
}

pub fn clamp_val(val: Int, min_v: Int, max_v: Int) -> Int {
    if val < min_v {
        return min_v;
    }
    if val > max_v {
        return max_v;
    }
    return val;
}

/// Converts scaled log-odds score (-1000..1000) to probability (0..1000).
pub fn log_odds_to_prob(log_odds: Int) -> Int {
    let clamped = clamp_val(log_odds, 0 - 1000, 1000);
    let prob = 500 + ((clamped * 500) / 1000);
    return clamp_val(prob, 0, 1000);
}

/// Converts probability (0..1000) to scaled log-odds (-1000..1000).
pub fn prob_to_log_odds(prob: Int) -> Int {
    let clamped = clamp_val(prob, 0, 1000);
    let log_odds = (clamped - 500) * 2;
    return clamp_val(log_odds, 0 - 1000, 1000);
}

// -------------------------------------------------------------------
// GridBounds Functions
// -------------------------------------------------------------------

pub fn grid_bounds_new(min_x: Int, min_y: Int, min_z: Int, max_x: Int, max_y: Int, max_z: Int) -> GridBounds {
    return GridBounds { min_x: min_x, min_y: min_y, min_z: min_z, max_x: max_x, max_y: max_y, max_z: max_z };
}

pub fn grid_bounds_zero() -> GridBounds {
    return GridBounds { min_x: 0, min_y: 0, min_z: 0, max_x: 0, max_y: 0, max_z: 0 };
}

pub fn grid_bounds_width(bounds: &GridBounds) -> Int {
    return (bounds).max_x - (bounds).min_x;
}

pub fn grid_bounds_height(bounds: &GridBounds) -> Int {
    return (bounds).max_y - (bounds).min_y;
}

pub fn grid_bounds_depth(bounds: &GridBounds) -> Int {
    return (bounds).max_z - (bounds).min_z;
}

pub fn grid_bounds_volume(bounds: &GridBounds) -> Int {
    let w = grid_bounds_width(bounds);
    let h = grid_bounds_height(bounds);
    let d = grid_bounds_depth(bounds);
    return (w * h) * d;
}

pub fn grid_bounds_contains(bounds: &GridBounds, x: Int, y: Int, z: Int) -> Bool {
    if x < (bounds).min_x || x > (bounds).max_x {
        return false;
    }
    if y < (bounds).min_y || y > (bounds).max_y {
        return false;
    }
    if z < (bounds).min_z || z > (bounds).max_z {
        return false;
    }
    return true;
}

pub fn grid_bounds_contains_vec(bounds: &GridBounds, point: Vector3) -> Bool {
    return grid_bounds_contains(bounds, (point).x, (point).y, (point).z);
}

pub fn grid_bounds_center(bounds: &GridBounds) -> Vector3 {
    let cx = ((bounds).min_x + (bounds).max_x) / 2;
    let cy = ((bounds).min_y + (bounds).max_y) / 2;
    let cz = ((bounds).min_z + (bounds).max_z) / 2;
    return vec3_new(cx, cy, cz);
}

pub fn grid_bounds_intersects(bound_a: &GridBounds, bound_b: &GridBounds) -> Bool {
    if (bound_a).max_x < (bound_b).min_x || (bound_a).min_x > (bound_b).max_x {
        return false;
    }
    if (bound_a).max_y < (bound_b).min_y || (bound_a).min_y > (bound_b).max_y {
        return false;
    }
    if (bound_a).max_z < (bound_b).min_z || (bound_a).min_z > (bound_b).max_z {
        return false;
    }
    return true;
}

// -------------------------------------------------------------------
// Ray3D Functions
// -------------------------------------------------------------------

pub fn ray3d_new(origin: Vector3, target: Vector3, max_range_mm: Int) -> Ray3D {
    return Ray3D { origin: origin, target: target, max_range_mm: max_range_mm };
}

pub fn occupancy_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    let mut x = n;
    let mut y = (x + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}

pub fn ray3d_length(ray: &Ray3D) -> Int {
    let diff = vec3_sub((ray).target, (ray).origin);
    let len_sq = vec3_length_squared(diff);
    return occupancy_isqrt(len_sq);
}


