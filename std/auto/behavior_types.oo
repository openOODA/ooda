// # Autonomous Behavior & Decision Tree Types
//
// Logline: Defines vehicle state, obstacle observations, decision nodes, and behavior tree models.
//
// Setup: Pure data representations for autonomous driving decision making and tactical planning.
//
// Beats:
//   1. Define VehicleState and ObstacleState dynamic state containers.
//   2. Define DecisionNode and BehaviorTree hierarchical decision structures.
//   3. Provide status code constants and node type enumerations.

// -------------------------------------------------------------------
// Behavior Constants & Status Codes
// -------------------------------------------------------------------

/// Decision Node Execution Status
pub fn status_invalid() -> Int { return 0; }
pub fn status_success() -> Int { return 1; }
pub fn status_failure() -> Int { return 2; }
pub fn status_running() -> Int { return 3; }

/// Behavior Tree Node Classification Types
pub fn node_type_root() -> Int { return 0; }
pub fn node_type_selector() -> Int { return 1; }
pub fn node_type_sequence() -> Int { return 2; }
pub fn node_type_condition() -> Int { return 3; }
pub fn node_type_action() -> Int { return 4; }
pub fn node_type_decorator() -> Int { return 5; }
pub fn node_type_parallel() -> Int { return 6; }

/// Tactical Driving Mode Behavior States
pub fn behavior_idle() -> Int { return 0; }
pub fn behavior_lane_keep() -> Int { return 1; }
pub fn behavior_lane_change_left() -> Int { return 2; }
pub fn behavior_lane_change_right() -> Int { return 3; }
pub fn behavior_follow_lead() -> Int { return 4; }
pub fn behavior_yield() -> Int { return 5; }
pub fn behavior_stop() -> Int { return 6; }
pub fn behavior_emergency_brake() -> Int { return 7; }
pub fn behavior_park() -> Int { return 8; }
pub fn behavior_overtake() -> Int { return 9; }

/// Obstacle Classification Types
pub fn obstacle_class_unknown() -> Int { return 0; }
pub fn obstacle_class_vehicle() -> Int { return 1; }
pub fn obstacle_class_pedestrian() -> Int { return 2; }
pub fn obstacle_class_cyclist() -> Int { return 3; }
pub fn obstacle_class_debris() -> Int { return 4; }

// -------------------------------------------------------------------
// Fundamental Struct Definitions
// -------------------------------------------------------------------

/// Kinematic and operational state of an autonomous vehicle.
pub type VehicleState = struct {
    id: Int,
    x: Float,
    y: Float,
    z: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    speed: Float,
    yaw: Float,
    yaw_rate: Float,
    steering_angle: Float,
    acceleration: Float,
    target_speed: Float,
    current_lane_id: Int,
    target_lane_id: Int,
    fuel_or_battery_pct: Float,
    is_autonomous: Bool,
    emergency_stop: Bool,
};

/// Tracked dynamic obstacle or perception hazard in the scene.
pub type ObstacleState = struct {
    id: Int,
    x: Float,
    y: Float,
    z: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    speed: Float,
    bounding_radius: Float,
    obstacle_class: Int,
    is_predicted_hazard: Bool,
};

/// Individual decision node representation in a Behavior Tree.
pub type DecisionNode = struct {
    id: Int,
    node_type: Int,
    status: Int,
    name: String,
    parent_id: Int,
    child_count: Int,
    action_id: Int,
    threshold: Float,
    is_enabled: Bool,
};

/// Container struct representing a Behavior Tree decision hierarchy.
pub type BehaviorTree = struct {
    tree_id: Int,
    root_node_id: Int,
    node_count: Int,
    max_nodes: Int,
    tick_count: Int,
    current_behavior: Int,
    nodes: List[DecisionNode],
    last_status: Int,
    is_active: Bool,
};

/// Tactical driving plan produced by decision logic.
pub type TacticalPlan = struct {
    plan_id: Int,
    target_behavior: Int,
    target_speed: Float,
    target_lane_id: Int,
    time_to_collision: Float,
    safe_distance: Float,
    recommended_acceleration: Float,
    recommended_steering: Float,
    lane_change_allowed: Bool,
    is_emergency: Bool,
};

/// Diagnostic performance metrics for behavior evaluation.
pub type BehaviorMetrics = struct {
    total_ticks: Int,
    successful_executions: Int,
    failed_executions: Int,
    running_executions: Int,
    avg_evaluation_time_ms: Float,
    emergency_interventions: Int,
};

/// Privileged engine capability handle for hardware I/O.
pub type BehaviorEngine = struct {
    ptr: Int,
    len: Int,
    cap: &SysCap,
};

pub fn behavior_types_marker() -> Int {
    return 1;
}
