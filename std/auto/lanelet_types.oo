// # Lanelet HD Map Geometry & Data Types
//
// Logline: Defines 2D/3D Waypoints, LaneBoundary polylines, RegulatoryElements, and LaneletMap structures.
//
// Setup: Pure data representations for HD digital road networks.
//
// Beats:
//   1. Define Waypoint spatial coordinate representations and integer math helpers.
//   2. Define LaneBoundary polyline models and boundary line types.
//   3. Define RegulatoryElement speed limits and Lanelet topological structures.

// -------------------------------------------------------------------
// Fundamental Struct Definitions
// -------------------------------------------------------------------

/// Represents a 3D georeferenced spatial point (Waypoint / Node) in the map.
pub type Waypoint = struct {
    id: Int,
    x: Int,                  // Local millimeter x-coordinate
    y: Int,                  // Local millimeter y-coordinate
    z: Int,                  // Local millimeter z-coordinate
    ele: Int,                // Elevation attribute in mm
    attribute_flags: Int    // Bitmask for flags (1=GPS_LOCKED, 2=CURB_NODE, 4=STOP_NODE, etc.)
};

/// Represents a ordered polyline boundary (LineString) for lane edges or markers.
pub type LaneBoundary = struct {
    id: Int,
    boundary_type: Int,      // 0=unknown, 1=solid, 2=dashed, 3=double_solid, 4=curb, 5=virtual
    color: Int,              // 0=white, 1=yellow, 2=red, 3=blue
    points: List[Waypoint]
};

/// Represents a traffic regulatory element (traffic lights, stop signs, speed limits).
pub type RegulatoryElement = struct {
    id: Int,
    elem_type: Int,          // 1=yield, 2=stop_sign, 3=traffic_light, 4=speed_limit, 5=crosswalk
    ref_lanelet_id: Int,
    val_param: Int,          // Scaled value (e.g. speed limit in kph or light phase duration)
    location: Waypoint
};

/// Fundamental Lanelet unit representing a section of roadway with boundaries.
pub type Lanelet = struct {
    id: Int,
    left_boundary: LaneBoundary,
    right_boundary: LaneBoundary,
    center_line: LaneBoundary,
    lane_type: Int,          // 0=roadway, 1=bus_lane, 2=bicycle_lane, 3=walkway, 4=emergency, 5=highway
    speed_limit_kph: Int,
    is_one_way: Bool,
    predecessor_id: Int,     // ID of preceding lanelet (0 if none)
    successor_id: Int,       // ID of succeeding lanelet (0 if none)
    adjacent_left_id: Int,   // ID of adjacent left lanelet (0 if none)
    adjacent_right_id: Int  // ID of adjacent right lanelet (0 if none)
};

/// Top-level container for an HD Lanelet Map network.
pub type LaneletMap = struct {
    map_id: Int,
    lanelets: List[Lanelet],
    boundaries: List[LaneBoundary],
    waypoints: List[Waypoint],
    regulatory_elements: List[RegulatoryElement],
    updated_count: Int
};

/// Metric summary statistics for a Lanelet map topology.
pub type LaneletMapStats = struct {
    total_lanelets: Int,
    total_boundaries: Int,
    total_waypoints: Int,
    total_regulatory_elements: Int,
    total_length_mm: Int
};

/// Capability handle struct for privileged map engine access.
pub type LaneletEngine = struct {
    ptr: Int,
    len: Int,
    cap: &SysCap
};

// -------------------------------------------------------------------
// General Helper Math Utilities
// -------------------------------------------------------------------

pub fn lanelet_abs_val(val: Int) -> Int {
    if val < 0 {
        return 0 - val;
    }
    return val;
}

pub fn lanelet_min_val(a: Int, b: Int) -> Int {
    if a < b {
        return a;
    }
    return b;
}

pub fn lanelet_max_val(a: Int, b: Int) -> Int {
    if a > b {
        return a;
    }
    return b;
}

pub fn waypoint_zero() -> Waypoint {
    return Waypoint {
        id: 0,
        x: 0,
        y: 0,
        z: 0,
        ele: 0,
        attribute_flags: 0
    };
}

pub fn waypoint_new(id: Int, x: Int, y: Int, z: Int, ele: Int) -> Waypoint {
    return Waypoint {
        id: id,
        x: x,
        y: y,
        z: z,
        ele: ele,
        attribute_flags: 0
    };
}

pub fn lane_boundary_new(id: Int, boundary_type: Int, color: Int) -> LaneBoundary {
    let pts: List[Waypoint] = list_new();
    return LaneBoundary {
        id: id,
        boundary_type: boundary_type,
        color: color,
        points: pts
    };
}

pub fn lanelet_empty() -> Lanelet {
    let lb: LaneBoundary = lane_boundary_new(0, 0, 0);
    let rb: LaneBoundary = lane_boundary_new(0, 0, 0);
    let cl: LaneBoundary = lane_boundary_new(0, 0, 0);
    return Lanelet {
        id: 0,
        left_boundary: lb,
        right_boundary: rb,
        center_line: cl,
        lane_type: 0,
        speed_limit_kph: 0,
        is_one_way: false,
        predecessor_id: 0,
        successor_id: 0,
        adjacent_left_id: 0,
        adjacent_right_id: 0
    };
}

pub fn lanelet_map_new(map_id: Int) -> LaneletMap {
    let empty_lanelets: List[Lanelet] = list_new();
    let empty_boundaries: List[LaneBoundary] = list_new();
    let empty_waypoints: List[Waypoint] = list_new();
    let empty_regs: List[RegulatoryElement] = list_new();
    return LaneletMap {
        map_id: map_id,
        lanelets: empty_lanelets,
        boundaries: empty_boundaries,
        waypoints: empty_waypoints,
        regulatory_elements: empty_regs,
        updated_count: 0
    };
}

pub fn lanelet_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    let mut x = n;
    let mut y = (x + 1) / 2;
    while y < x {
        x = y;
        y = (x + (n / x)) / 2;
    }
    return x;
}
