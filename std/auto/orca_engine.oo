type OrcaEng = struct {
    dt_ms: Int,
    max_agents: Int
};

pub fn orca_eng_new(dt_ms: Int, max_agents: Int) -> OrcaEng {
    return OrcaEng { dt_ms: dt_ms, max_agents: max_agents };
}

pub fn orca_eng_dt(e: OrcaEng) -> Int {
    return e.dt_ms;
}
