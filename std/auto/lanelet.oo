// # HD Lanelet2 Map Routing Facade
//
// Logline: Re-exports HD map geometry, lane boundaries, regulatory elements, and topological routing.
//
// Setup: Pure module shim importing lanelet types, operations, engine, and stubs submodules.
//
// Beats:
//   1. Import lanelet map types, boundary operations, topological engine, and stubs.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream autonomous navigation callers.

import "./lanelet_types.oo";
import "./lanelet_ops.oo";
import "./lanelet_engine.oo";
import "./lanelet_stubs.oo";

pub fn shim_marker_waypoint_zero() -> Waypoint {
    return waypoint_zero();
}

pub fn shim_marker_waypoint_new() -> Waypoint {
    return waypoint_new(1, 0, 0, 0, 0);
}

pub fn shim_marker_lane_boundary_new() -> LaneBoundary {
    return lane_boundary_new(1, 1, 0);
}

pub fn shim_marker_lanelet_empty() -> Lanelet {
    return lanelet_empty();
}

pub fn shim_marker_lanelet_map_new() -> LaneletMap {
    return lanelet_map_new(1);
}

pub fn shim_marker_engine_init() -> LaneletEngine {
    return lanelet_engine_init();
}

pub fn shim_marker_engine_do_work(obj: &LaneletEngine) -> Int {
    return lanelet_engine_do_work(obj);
}
