// # Fusion math
//
// Logline: FusVec3 destubbed off pub type Float Vec3.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type FusVec3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn fus_vec3_new(x: Int, y: Int, z: Int) -> FusVec3 {
    return FusVec3 { x: x, y: y, z: z };
}

pub fn fus_vec3_x(v: FusVec3) -> Int {
    return v.x;
}

pub type Vec3 = struct {
    x: Float,
    y: Float,
    z: Float
};

pub fn vec3_zero() -> Vec3 {
    return Vec3 { x: 0.0, y: 0.0, z: 0.0 };
}

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

pub fn vec3_add(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3 { x: (a).x + (b).x, y: (a).y + (b).y, z: (a).z + (b).z };
}

pub fn vec3_scale(v: Vec3, s: Float) -> Vec3 {
    return Vec3 { x: (v).x * s, y: (v).y * s, z: (v).z * s };
}

pub fn vec3_dist(a: Vec3, b: Vec3) -> Float {
    let dx: Float = (a).x - (b).x;
    let dy: Float = (a).y - (b).y;
    let dz: Float = (a).z - (b).z;
    let sq: Float = ((dx * dx) + (dy * dy)) + (dz * dz);
    if sq < 0.000000001 {
        return 0.0;
    }
    return sqrt(sq);
}

pub fn clamp_float(val: Float, min_val: Float, max_val: Float) -> Float {
    if val < min_val {
        return min_val;
    }
    if val > max_val {
        return max_val;
    }
    return val;
}

pub fn math_max(a: Float, b: Float) -> Float {
    if a > b {
        return a;
    }
    return b;
}
