// # Fusion math
//
// Logline: FusVec3 destubbed off pub type Float Vec3.
// residual: destubbed to Int floor.

type FusVec3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn fus_vec3_new(x: Int, y: Int, z: Int) -> FusVec3 {
    return FusVec3 { x: x, y: y, z: z };
}

pub fn fus_vec3_x(v: FusVec3) -> Int {
    return v.x;
}
