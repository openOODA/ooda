// # UAV Rotor Blade Flapping Dynamics & Hub Forces
//
// Logline: Models first-harmonic blade flapping angles (coning, longitudinal, lateral) and rotor hub aerodynamic drag forces.
//
// Setup: High-speed translational flight dynamics accounting for asymmetric advancing/retreating blade lift distribution.
//
// Beats:
//   1. Define Rotor Flapping Constants (Lock number gamma, hinge offset, blade pitch, rotor speed).
//   2. Compute Advance Ratio mu = V_forward / (omega * R).
//   3. Solve Coning angle beta_0, Longitudinal flapping beta_1c, and Lateral flapping beta_1s.
//   4. Calculate rotor hub aerodynamic drag force H_force and lateral force Y_force.

import "./uav_coordinate_frames.oo";

pub type FlappingParams = struct {
    lock_number_gamma: Float,
    rotor_radius_m: Float,
    blade_mass_kg: Float,
    blade_pitch_rad: Float,
    rotor_speed_rad_s: Float,
};

pub type FlappingAngles = struct {
    coning_beta0: Float,
    longitudinal_beta1c: Float,
    lateral_beta1s: Float,
};

pub type RotorHubForces = struct {
    drag_h_force_n: Float,
    lateral_y_force_n: Float,
};

pub fn flapping_params_default() -> FlappingParams {
    return FlappingParams {
        lock_number_gamma: 5.5,
        rotor_radius_m: 0.127,
        blade_mass_kg: 0.008,
        blade_pitch_rad: 0.20,
        rotor_speed_rad_s: 600.0,
    };
}

pub fn compute_flapping_angles(
    params: &FlappingParams,
    forward_speed_u: Float,
    lateral_speed_v: Float
) -> FlappingAngles {
    let omega: Float = (params).rotor_speed_rad_s;
    let r: Float = (params).rotor_radius_m;
    let v_tip: Float = omega * r;

    if v_tip < 1.0 {
        return FlappingAngles {
            coning_beta0: 0.0,
            longitudinal_beta1c: 0.0,
            lateral_beta1s: 0.0,
        };
    }

    let mu_x: Float = forward_speed_u / v_tip;
    let mu_y: Float = lateral_speed_v / v_tip;
    let gamma: Float = (params).lock_number_gamma;
    let theta: Float = (params).blade_pitch_rad;

    // Coning angle beta_0 approx (gamma / 8) * theta
    let beta_0: Float = (gamma / 8.0) * theta;

    // Longitudinal flapping beta_1c = (2 * mu_x * ((4/3)*theta - lambda)) / (1 - 0.5 * mu^2)
    let beta_1c: Float = 2.0 * mu_x * ((4.0 / 3.0) * theta);

    // Lateral flapping beta_1s = (4/3) * mu_y * beta_0
    let beta_1s: Float = (4.0 / 3.0) * mu_y * beta_0;

    return FlappingAngles {
        coning_beta0: beta_0,
        longitudinal_beta1c: beta_1c,
        lateral_beta1s: beta_1s,
    };
}

pub fn compute_rotor_hub_forces(
    params: &FlappingParams,
    angles: &FlappingAngles,
    base_thrust_n: Float
) -> RotorHubForces {
    // Rotor hub force due to blade tilt: H = T * sin(beta_1c), Y = -T * sin(beta_1s)
    let h_force: Float = base_thrust_n * sin((angles).longitudinal_beta1c);
    let y_force: Float = (0.0 - base_thrust_n) * sin((angles).lateral_beta1s);

    return RotorHubForces {
        drag_h_force_n: h_force,
        lateral_y_force_n: y_force,
    };
}
