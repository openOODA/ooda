pub type UavFlightSystem = struct {
    capabilities: UavFlightCapabilities,
    quad_params: QuadrotorParams,
    geo_gains: GeometricAttitudeGains,
    is_armed: Bool,
};

pub fn uav_flight_system_new() -> UavFlightSystem {
    return UavFlightSystem {
        capabilities: uav_flight_capabilities_default(),
        quad_params: quadrotor_params_default(),
        geo_gains: geometric_gains_default(),
        is_armed: false,
    };
}

pub fn uav_flight_arm(sys: &UavFlightSystem) -> UavFlightSystem {
    return UavFlightSystem {
        capabilities: (sys).capabilities,
        quad_params: (sys).quad_params,
        geo_gains: (sys).geo_gains,
        is_armed: true,
    };
}

pub fn uav_flight_disarm(sys: &UavFlightSystem) -> UavFlightSystem {
    return UavFlightSystem {
        capabilities: (sys).capabilities,
        quad_params: (sys).quad_params,
        geo_gains: (sys).geo_gains,
        is_armed: false,
    };
}
