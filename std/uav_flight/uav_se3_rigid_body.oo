// # UAV SE(3) Rigid Body Kinematics & Spatial Twists
//
// Logline: 3D rigid body pose transformations on SE(3) and Lie algebra se(3) spatial twists for UAV flight dynamics.
//
// Setup: Encapsulates homogeneous 4x4 matrix representations, spatial velocity twists, and pose composition.
//
// Beats:
//   1. Define 4x4 Homogeneous Transformation Matrix structure.
//   2. Build SE(3) pose constructor from Rotation Matrix R and Translation Vector p.
//   3. Implement rigid body spatial twist se(3) representation and adjoint action.
//   4. Transform 3D position points and velocity directional vectors between body and world frames.

import "./uav_coordinate_frames.oo";
import "./uav_so3_rotation_matrix.oo";

pub type Transform4x4 = struct {
    r00: Float, r01: Float, r02: Float, tx: Float,
    r10: Float, r11: Float, r12: Float, ty: Float,
    r20: Float, r21: Float, r22: Float, tz: Float,
    m30: Float, m31: Float, m32: Float, m33: Float
};

pub type SpatialTwist = struct {
    linear: Vector3D,
    angular: Vector3D
};

pub fn tf_identity() -> Transform4x4 {
    return Transform4x4 {
        r00: 1.0, r01: 0.0, r02: 0.0, tx: 0.0,
        r10: 0.0, r11: 1.0, r12: 0.0, ty: 0.0,
        r20: 0.0, r21: 0.0, r22: 1.0, tz: 0.0,
        m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    };
}

pub fn tf_from_rot_trans(r: &Matrix3x3, p: &Vector3D) -> Transform4x4 {
    return Transform4x4 {
        r00: (r).m00, r01: (r).m01, r02: (r).m02, tx: (p).x,
        r10: (r).m10, r11: (r).m11, r12: (r).m12, ty: (p).y,
        r20: (r).m20, r21: (r).m21, r22: (r).m22, tz: (p).z,
        m30: 0.0,     m31: 0.0,     m32: 0.0,     m33: 1.0
    };
}

pub fn tf_inverse(tf: &Transform4x4) -> Transform4x4 {
    // R^T
    let r00: Float = (tf).r00;
    let r01: Float = (tf).r10;
    let r02: Float = (tf).r20;

    let r10: Float = (tf).r01;
    let r11: Float = (tf).r11;
    let r12: Float = (tf).r21;

    let r20: Float = (tf).r02;
    let r21: Float = (tf).r12;
    let r22: Float = (tf).r22;

    // -R^T * p
    let inv_tx: Float = 0.0 - ((r00 * (tf).tx) + (r01 * (tf).ty) + (r02 * (tf).tz));
    let inv_ty: Float = 0.0 - ((r10 * (tf).tx) + (r11 * (tf).ty) + (r12 * (tf).tz));
    let inv_tz: Float = 0.0 - ((r20 * (tf).tx) + (r21 * (tf).ty) + (r22 * (tf).tz));

    return Transform4x4 {
        r00: r00, r01: r01, r02: r02, tx: inv_tx,
        r10: r10, r11: r11, r12: r12, ty: inv_ty,
        r20: r20, r21: r21, r22: r22, tz: inv_tz,
        m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    };
}

pub fn tf_multiply(a: &Transform4x4, b: &Transform4x4) -> Transform4x4 {
    return Transform4x4 {
        r00: ((a).r00 * (b).r00) + ((a).r01 * (b).r10) + ((a).r02 * (b).r20),
        r01: ((a).r00 * (b).r01) + ((a).r01 * (b).r11) + ((a).r02 * (b).r21),
        r02: ((a).r00 * (b).r02) + ((a).r01 * (b).r12) + ((a).r02 * (b).r22),
        tx:  ((a).r00 * (b).tx)  + ((a).r01 * (b).ty)  + ((a).r02 * (b).tz) + (a).tx,

        r10: ((a).r10 * (b).r00) + ((a).r11 * (b).r10) + ((a).r12 * (b).r20),
        r11: ((a).r10 * (b).r01) + ((a).r11 * (b).r11) + ((a).r12 * (b).r21),
        r12: ((a).r10 * (b).r02) + ((a).r11 * (b).r12) + ((a).r12 * (b).r22),
        ty:  ((a).r10 * (b).tx)  + ((a).r11 * (b).ty)  + ((a).r12 * (b).tz) + (a).ty,

        r20: ((a).r20 * (b).r00) + ((a).r21 * (b).r10) + ((a).r22 * (b).r20),
        r21: ((a).r20 * (b).r01) + ((a).r21 * (b).r11) + ((a).r22 * (b).r21),
        r22: ((a).r20 * (b).r02) + ((a).r21 * (b).r12) + ((a).r22 * (b).r22),
        tz:  ((a).r20 * (b).tx)  + ((a).r21 * (b).ty)  + ((a).r22 * (b).tz) + (a).tz,

        m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    };
}

pub fn tf_transform_point(tf: &Transform4x4, pt: &Vector3D) -> Vector3D {
    return Vector3D {
        x: ((tf).r00 * (pt).x) + ((tf).r01 * (pt).y) + ((tf).r02 * (pt).z) + (tf).tx,
        y: ((tf).r10 * (pt).x) + ((tf).r11 * (pt).y) + ((tf).r12 * (pt).z) + (tf).ty,
        z: ((tf).r20 * (pt).x) + ((tf).r21 * (pt).y) + ((tf).r22 * (pt).z) + (tf).tz
    };
}

pub fn tf_transform_vector(tf: &Transform4x4, v: &Vector3D) -> Vector3D {
    return Vector3D {
        x: ((tf).r00 * (v).x) + ((tf).r01 * (v).y) + ((tf).r02 * (v).z),
        y: ((tf).r10 * (v).x) + ((tf).r11 * (v).y) + ((tf).r12 * (v).z),
        z: ((tf).r20 * (v).x) + ((tf).r21 * (v).y) + ((tf).r22 * (v).z)
    };
}
