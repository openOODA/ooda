// # UAV Swarm Formation Flight & V-Shape Aerodynamic Offsets
//
// Logline: Generates V-formation (chevron), grid, and ring geometric station-keeping offsets relative to a virtual formation leader.
//
// Setup: Formation flight coordinator exploiting aerodynamic upwash vortex drag reduction and coordinated aerial survey.
//
// Beats:
//   1. Define Formation Geometry (V-angle apex_rad, wingtip lateral spacing, longitudinal setback).
//   2. Compute 3D Station Offset for agent index i relative to formation apex/leader.
//   3. Rotate offset vector into global frame using leader heading yaw_rad.
//   4. Calculate target slot position and tracking error for station-keeping.

import "./uav_coordinate_frames.oo";

pub type VFormationParams = struct {
    apex_angle_rad: Float, // Typically ~60-70 degrees
    lateral_spacing_m: Float,
    vertical_offset_m: Float
};

pub type FormationSlot = struct {
    slot_index: Int,
    is_right_wing: Bool,
    body_offset: Vector3D,
    world_target_pos: Vector3D
};

pub fn v_formation_params_default() -> VFormationParams {
    return VFormationParams {
        apex_angle_rad: 1.04719755, // 60 degrees
        lateral_spacing_m: 6.0,
        vertical_offset_m: 0.5 // Slight stepped altitude to avoid direct downwash
    };
}

pub fn compute_v_formation_slot(
    params: &VFormationParams,
    leader_pos: &Vector3D,
    leader_yaw_rad: Float,
    agent_index: Int // 0: Leader, 1: Wingman 1 (Right), 2: Wingman 2 (Left), 3: Right 2, etc.
) -> FormationSlot {
    if agent_index <= 0 {
        return FormationSlot {
            slot_index: 0,
            is_right_wing: false,
            body_offset: vector3d_zero(),
            world_target_pos: *leader_pos
        };
    }

    // Rank along wing: 1, 2, 3...
    let rank_int: Int = (agent_index + 1) / 2;
    let rank: Float = if rank_int == 1 { 1.0 } else if rank_int == 2 { 2.0 } else if rank_int == 3 { 3.0 } else { 4.0 };

    let is_right: Bool = (agent_index % 2) != 0;
    let y_side: Float = if is_right { 1.0 } else { 0.0 - 1.0 };

    // Longitudinal setback: x_offset = -rank * lateral_spacing / tan(apex/2)
    let half_apex: Float = (params).apex_angle_rad * 0.5;
    let tan_half: Float = sin(half_apex) / cos(half_apex);
    let x_setback: Float = (0.0 - (rank * (params).lateral_spacing_m)) / tan_half;

    // Lateral offset: y_offset = y_side * rank * lateral_spacing
    let y_offset: Float = y_side * rank * (params).lateral_spacing_m;

    // Vertical stepped offset
    let z_offset: Float = rank * (params).vertical_offset_m;

    let body_off: Vector3D = Vector3D {
        x: x_setback,
        y: y_offset,
        z: z_offset
    };

    // Rotate body offset into NED frame by leader heading
    let world_off: Vector3D = body_frd_to_ned(&body_off, leader_yaw_rad);
    let target_pos: Vector3D = vector3d_add(leader_pos, &world_off);

    return FormationSlot {
        slot_index: agent_index,
        is_right_wing: is_right,
        body_offset: body_off,
        world_target_pos: target_pos
    };
}
