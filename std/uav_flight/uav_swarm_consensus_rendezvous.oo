// # UAV Distributed Graph Laplacian Consensus Rendezvous
//
// Logline: Multi-agent consensus protocol over communication network topologies for rendezvous and state synchronization.
//
// Setup: Distributed algebraic graph theory ensuring asymptotic convergence of swarm states to common agreement value.
//
// Beats:
//   1. Define Network Adjacency Weights A_ij between swarm nodes.
//   2. Compute Graph Laplacian interaction dynamics: dx_i/dt = -sum(a_ij * (x_i - x_j)).
//   3. Include optional virtual leader pin control for guided group synchronization.
//   4. Evaluate swarm state disagreement Lyapunov energy function V(x) = 0.5 * x^T * L * x.

import "./uav_coordinate_frames.oo";

pub type ConsensusConfig = struct {
    k_consensus_gain: Float,
    k_leader_pin_gain: Float,
    max_consensus_vel: Float
};

pub type SwarmConsensusState = struct {
    agent_pos: Vector3D,
    agent_vel: Vector3D
};

pub fn consensus_config_default() -> ConsensusConfig {
    return ConsensusConfig {
        k_consensus_gain: 0.75,
        k_leader_pin_gain: 1.2,
        max_consensus_vel: 6.0
    };
}

pub fn compute_consensus_step_2_neighbors(
    self_state: &SwarmConsensusState,
    neighbor_1_pos: &Vector3D,
    neighbor_2_pos: &Vector3D,
    leader_pos: &Vector3D,
    has_leader_link: Bool,
    cfg: &ConsensusConfig
) -> Vector3D {
    // Distributed Laplacian consensus step: u_i = -k * sum_j(p_i - p_j)
    let d1: Vector3D = vector3d_sub(neighbor_1_pos, &(self_state).agent_pos);
    let d2: Vector3D = vector3d_sub(neighbor_2_pos, &(self_state).agent_pos);

    let mut u_sum: Vector3D = vector3d_scale(&vector3d_add(&d1, &d2), (cfg).k_consensus_gain);

    // Leader pinning term
    if has_leader_link {
        let d_lead: Vector3D = vector3d_sub(leader_pos, &(self_state).agent_pos);
        let u_lead: Vector3D = vector3d_scale(&d_lead, (cfg).k_leader_pin_gain);
        u_sum = vector3d_add(&u_sum, &u_lead);
    }

    let u_mag: Float = vector3d_norm(&u_sum);
    let max_v: Float = (cfg).max_consensus_vel;

    let vel_cmd: Vector3D = if u_mag > max_v {
        vector3d_scale(&u_sum, max_v / u_mag)
    } else {
        u_sum
    };

    return vel_cmd;
}
