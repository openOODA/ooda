// # UAV Hexacopter Dynamics & Multi-Rotor Mixer Allocation
//
// Logline: 6-rotor hexacopter dynamics, geometry-based control allocation matrix, and differential motor mixing.
//
// Setup: Extended multi-rotor model with redundant actuation enabling fault tolerance and enhanced payload capabilities.
//
// Beats:
//   1. Define Hexacopter Configuration (arm length, thrust factor kf, torque factor km).
//   2. Compute 6-rotor geometrical angles and control allocation matrix.
//   3. Map desired Collective Thrust and 3-axis Torques [T, tau_x, tau_y, tau_z] into 6 motor speeds.
//   4. Evaluate motor saturation, thrust limits, and symmetric power distribution.

import "./uav_coordinate_frames.oo";
import "./uav_quaternion_kinematics.oo";

pub type HexacopterParams = struct {
    mass: Float,
    arm_length: Float,
    kf: Float,
    km: Float,
    min_rpm: Float,
    max_rpm: Float,
};

pub type HexacopterMotorOutputs = struct {
    m1: Float,
    m2: Float,
    m3: Float,
    m4: Float,
    m5: Float,
    m6: Float,
};

pub type HexacopterThrustTorque = struct {
    thrust: Float,
    torque_roll: Float,
    torque_pitch: Float,
    torque_yaw: Float,
};

pub fn hexacopter_params_default() -> HexacopterParams {
    return HexacopterParams {
        mass: 3.2,
        arm_length: 0.35,
        kf: 0.000035,
        km: 0.00000095,
        min_rpm: 100.0,
        max_rpm: 1200.0,
    };
}

pub fn hexacopter_allocate_motors(
    params: &HexacopterParams,
    cmd: &HexacopterThrustTorque
) -> HexacopterMotorOutputs {
    let l: Float = (params).arm_length;
    let kf: Float = (params).kf;
    let km: Float = (params).km;

    // Hexacopter X configuration with 60 deg spacing:
    // Angles: 30, 90, 150, 210, 270, 330 deg
    // sin(30) = 0.5, cos(30) = 0.866025
    let c30: Float = 0.8660254037844386;
    let s30: Float = 0.5;

    let f_base: Float = (cmd).thrust / 6.0;
    let roll_eff: Float = (cmd).torque_roll / (3.0 * l);
    let pitch_eff: Float = (cmd).torque_pitch / (2.0 * c30 * l);
    let yaw_eff: Float = (cmd).torque_yaw / (6.0 * (km / kf));

    // Motor 1: 30 deg (CW -)
    let f1: Float = f_base - (s30 * roll_eff) + (c30 * pitch_eff) - yaw_eff;
    // Motor 2: 90 deg (CCW +)
    let f2: Float = f_base - (1.0 * roll_eff) + 0.0 + yaw_eff;
    // Motor 3: 150 deg (CW -)
    let f3: Float = f_base - (s30 * roll_eff) - (c30 * pitch_eff) - yaw_eff;
    // Motor 4: 210 deg (CCW +)
    let f4: Float = f_base + (s30 * roll_eff) - (c30 * pitch_eff) + yaw_eff;
    // Motor 5: 270 deg (CW -)
    let f5: Float = f_base + (1.0 * roll_eff) + 0.0 - yaw_eff;
    // Motor 6: 330 deg (CCW +)
    let f6: Float = f_base + (s30 * roll_eff) + (c30 * pitch_eff) + yaw_eff;

    // Convert force f = kf * w^2 => w = sqrt(max(0, f / kf))
    let w1: Float = if f1 > 0.0 { sqrt(f1 / kf) } else { 0.0 };
    let w2: Float = if f2 > 0.0 { sqrt(f2 / kf) } else { 0.0 };
    let w3: Float = if f3 > 0.0 { sqrt(f3 / kf) } else { 0.0 };
    let w4: Float = if f4 > 0.0 { sqrt(f4 / kf) } else { 0.0 };
    let w5: Float = if f5 > 0.0 { sqrt(f5 / kf) } else { 0.0 };
    let w6: Float = if f6 > 0.0 { sqrt(f6 / kf) } else { 0.0 };

    return HexacopterMotorOutputs {
        m1: w1, m2: w2, m3: w3, m4: w4, m5: w5, m6: w6,
    };
}
