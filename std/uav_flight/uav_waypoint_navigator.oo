// # UAV Autonomous Mission Waypoint Navigator
//
// Logline: Acceptance-sphere sequencer with loiter and RTL. Int milli destub.
//
// Setup: Flattened waypoint + navigator; ||p||^2 vs R^2 (no sqrt).
//
// Beats:
//   1. Waypoint: pos, speed, accept radius, action, loiter.
//   2. Accept when dx^2+dy^2+dz^2 <= R^2.
//   3. Action 1 loiters then advances; else fly-through.
//   4. Last waypoint completes; speed 0.

type NavWaypoint = struct {
    x_mm: Int,
    y_mm: Int,
    z_mm: Int,
    speed_mm_s: Int,
    accept_radius_mm: Int,
    action_type: Int,
    loiter_duration_ms: Int,
    target_yaw_mrad: Int
};

type NavigatorState = struct {
    current_wp_index: Int,
    is_loitering: Bool,
    loiter_time_elapsed_ms: Int,
    is_mission_completed: Bool,
    target_x_mm: Int,
    target_y_mm: Int,
    target_z_mm: Int,
    target_speed_mm_s: Int
};

pub fn nav_waypoint_new(
    x_mm: Int,
    y_mm: Int,
    z_mm: Int,
    speed_mm_s: Int,
    radius_mm: Int,
    action_type: Int,
    loiter_ms: Int,
    yaw_mrad: Int
) -> NavWaypoint {
    return NavWaypoint {
        x_mm: x_mm,
        y_mm: y_mm,
        z_mm: z_mm,
        speed_mm_s: speed_mm_s,
        accept_radius_mm: radius_mm,
        action_type: action_type,
        loiter_duration_ms: loiter_ms,
        target_yaw_mrad: yaw_mrad
    };
}

pub fn navigator_state_init(first_wp: NavWaypoint) -> NavigatorState {
    return NavigatorState {
        current_wp_index: 0,
        is_loitering: false,
        loiter_time_elapsed_ms: 0,
        is_mission_completed: false,
        target_x_mm: first_wp.x_mm,
        target_y_mm: first_wp.y_mm,
        target_z_mm: first_wp.z_mm,
        target_speed_mm_s: first_wp.speed_mm_s
    };
}

pub fn navigator_update_step(
    state: NavigatorState,
    active_wp: NavWaypoint,
    has_next_wp: Bool,
    next_wp: NavWaypoint,
    curr_x_mm: Int,
    curr_y_mm: Int,
    curr_z_mm: Int,
    dt_ms: Int
) -> NavigatorState {
    if state.is_mission_completed {
        return NavigatorState {
            current_wp_index: state.current_wp_index,
            is_loitering: true,
            loiter_time_elapsed_ms: state.loiter_time_elapsed_ms + dt_ms,
            is_mission_completed: true,
            target_x_mm: state.target_x_mm,
            target_y_mm: state.target_y_mm,
            target_z_mm: state.target_z_mm,
            target_speed_mm_s: 0
        };
    }
    let dx: Int = active_wp.x_mm - curr_x_mm;
    let dy: Int = active_wp.y_mm - curr_y_mm;
    let dz: Int = active_wp.z_mm - curr_z_mm;
    let dist2: Int = ((dx * dx) + (dy * dy)) + (dz * dz);
    let r: Int = active_wp.accept_radius_mm;
    let r2: Int = r * r;
    if dist2 > r2 {
        return NavigatorState {
            current_wp_index: state.current_wp_index,
            is_loitering: false,
            loiter_time_elapsed_ms: 0,
            is_mission_completed: false,
            target_x_mm: active_wp.x_mm,
            target_y_mm: active_wp.y_mm,
            target_z_mm: active_wp.z_mm,
            target_speed_mm_s: active_wp.speed_mm_s
        };
    }
    if active_wp.action_type == 1 {
        let new_elapsed: Int = state.loiter_time_elapsed_ms + dt_ms;
        if new_elapsed >= active_wp.loiter_duration_ms {
            if has_next_wp {
                return NavigatorState {
                    current_wp_index: state.current_wp_index + 1,
                    is_loitering: false,
                    loiter_time_elapsed_ms: 0,
                    is_mission_completed: false,
                    target_x_mm: next_wp.x_mm,
                    target_y_mm: next_wp.y_mm,
                    target_z_mm: next_wp.z_mm,
                    target_speed_mm_s: next_wp.speed_mm_s
                };
            }
            return NavigatorState {
                current_wp_index: state.current_wp_index,
                is_loitering: true,
                loiter_time_elapsed_ms: new_elapsed,
                is_mission_completed: true,
                target_x_mm: active_wp.x_mm,
                target_y_mm: active_wp.y_mm,
                target_z_mm: active_wp.z_mm,
                target_speed_mm_s: 0
            };
        }
        return NavigatorState {
            current_wp_index: state.current_wp_index,
            is_loitering: true,
            loiter_time_elapsed_ms: new_elapsed,
            is_mission_completed: false,
            target_x_mm: active_wp.x_mm,
            target_y_mm: active_wp.y_mm,
            target_z_mm: active_wp.z_mm,
            target_speed_mm_s: 0
        };
    }
    if has_next_wp {
        return NavigatorState {
            current_wp_index: state.current_wp_index + 1,
            is_loitering: false,
            loiter_time_elapsed_ms: 0,
            is_mission_completed: false,
            target_x_mm: next_wp.x_mm,
            target_y_mm: next_wp.y_mm,
            target_z_mm: next_wp.z_mm,
            target_speed_mm_s: next_wp.speed_mm_s
        };
    }
    return NavigatorState {
        current_wp_index: state.current_wp_index,
        is_loitering: true,
        loiter_time_elapsed_ms: 0,
        is_mission_completed: true,
        target_x_mm: active_wp.x_mm,
        target_y_mm: active_wp.y_mm,
        target_z_mm: active_wp.z_mm,
        target_speed_mm_s: 0
    };
}
