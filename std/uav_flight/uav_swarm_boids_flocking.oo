// # UAV 3D Swarm Boids Flocking & Collective Motion
//
// Logline: Implements Craig Reynolds 3D flocking rules (Separation, Alignment, Cohesion) for distributed drone swarm navigation.
//
// Setup: Emergent decentralized flocking coordinating large multi-UAV swarms without centralized communication bottlenecks.
//
// Beats:
//   1. Define Flocking Weights (w_separation, w_alignment, w_cohesion, neighbor_radius_m).
//   2. Compute Separation Force F_sep repelling nearby agents within safety radius.
//   3. Compute Velocity Alignment Force F_align matching average neighbor heading.
//   4. Compute Swarm Cohesion Force F_coh steering toward local center of mass.

import "./uav_coordinate_frames.oo";

pub type FlockingWeights = struct {
    w_separation: Float,
    w_alignment: Float,
    w_cohesion: Float,
    neighbor_radius_m: Float,
    separation_radius_m: Float,
    max_swarm_accel: Float
};

pub type SwarmBoidAgent = struct {
    pos: Vector3D,
    vel: Vector3D
};

pub type FlockingForces = struct {
    f_total: Vector3D,
    f_separation: Vector3D,
    f_alignment: Vector3D,
    f_cohesion: Vector3D
};

pub fn flocking_weights_default() -> FlockingWeights {
    return FlockingWeights {
        w_separation: 2.2,
        w_alignment: 1.0,
        w_cohesion: 0.8,
        neighbor_radius_m: 25.0,
        separation_radius_m: 4.0,
        max_swarm_accel: 4.5
    };
}

// Compute pairwise interaction contribution from neighbor to self
pub fn compute_pairwise_flocking(
    self_agent: &SwarmBoidAgent,
    neighbor: &SwarmBoidAgent,
    weights: &FlockingWeights
) -> FlockingForces {
    let d_pos: Vector3D = vector3d_sub(&(neighbor).pos, &(self_agent).pos);
    let dist: Float = vector3d_norm(&d_pos);

    if (dist < 0.001) || (dist > (weights).neighbor_radius_m) {
        return FlockingForces {
            f_total: vector3d_zero(),
            f_separation: vector3d_zero(),
            f_alignment: vector3d_zero(),
            f_cohesion: vector3d_zero()
        };
    }

    // 1. Separation: steer away from neighbor if within separation radius
    let mut f_sep: Vector3D = vector3d_zero();
    if dist < (weights).separation_radius_m {
        let inv_d: Float = 1.0 / dist;
        let u_away: Vector3D = vector3d_scale(&d_pos, 0.0 - inv_d);
        f_sep = vector3d_scale(&u_away, (weights).w_separation * (1.0 / (dist * dist)));
    }

    // 2. Alignment: match neighbor velocity
    let d_vel: Vector3D = vector3d_sub(&(neighbor).vel, &(self_agent).vel);
    let f_align: Vector3D = vector3d_scale(&d_vel, (weights).w_alignment);

    // 3. Cohesion: steer towards neighbor position
    let f_coh: Vector3D = vector3d_scale(&d_pos, (weights).w_cohesion);

    // Superimpose
    let f_sum: Vector3D = vector3d_add(&f_sep, &vector3d_add(&f_align, &f_coh));
    let f_mag: Float = vector3d_norm(&f_sum);
    let max_a: Float = (weights).max_swarm_accel;

    let f_tot: Vector3D = if f_mag > max_a {
        vector3d_scale(&f_sum, max_a / f_mag)
    } else {
        f_sum
    };

    return FlockingForces {
        f_total: f_tot,
        f_separation: f_sep,
        f_alignment: f_align,
        f_cohesion: f_coh
    };
}
