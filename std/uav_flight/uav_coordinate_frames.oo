// # UAV Coordinate Frames & Spatial Transformations
//
// Logline: Converts spatial vectors and kinematics between North-East-Down (NED), East-North-Up (ENU), and Forward-Right-Down (FRD) body frames.
//
// Setup: Core geometric frame mapping module standardizing global geodetic navigation and body-fixed inertial reference representations.
//
// Beats:
//   1. Represent 3D spatial vectors in standard Cartesian axes.
//   2. Convert between NED aerospace navigation and ENU robotics conventions.
//   3. Transform inertial velocity into Body-Fixed FRD / FLU frames using heading azimuth.
//   4. Compute earth-relative planar track angles and speed magnitudes.

pub type Vector3D = struct {
    x: Float,
    y: Float,
    z: Float
};

pub type FrameTransformResult = struct {
    vec: Vector3D,
    magnitude: Float
};

pub fn vector3d_new(x: Float, y: Float, z: Float) -> Vector3D {
    return Vector3D { x: x, y: y, z: z };
}

pub fn vector3d_zero() -> Vector3D {
    return Vector3D { x: 0.0, y: 0.0, z: 0.0 };
}

pub fn vector3d_norm(v: &Vector3D) -> Float {
    return sqrt(((v).x * (v).x) + ((v).y * (v).y) + ((v).z * (v).z));
}

pub fn vector3d_dot(a: &Vector3D, b: &Vector3D) -> Float {
    return ((a).x * (b).x) + ((a).y * (b).y) + ((a).z * (b).z);
}

pub fn vector3d_cross(a: &Vector3D, b: &Vector3D) -> Vector3D {
    return Vector3D {
        x: ((a).y * (b).z) - ((a).z * (b).y),
        y: ((a).z * (b).x) - ((a).x * (b).z),
        z: ((a).x * (b).y) - ((a).y * (b).x)
    };
}

pub fn vector3d_scale(v: &Vector3D, scale: Float) -> Vector3D {
    return Vector3D {
        x: (v).x * scale,
        y: (v).y * scale,
        z: (v).z * scale
    };
}

pub fn vector3d_add(a: &Vector3D, b: &Vector3D) -> Vector3D {
    return Vector3D {
        x: (a).x + (b).x,
        y: (a).y + (b).y,
        z: (a).z + (b).z
    };
}

pub fn vector3d_sub(a: &Vector3D, b: &Vector3D) -> Vector3D {
    return Vector3D {
        x: (a).x - (b).x,
        y: (a).y - (b).y,
        z: (a).z - (b).z
    };
}

pub fn ned_to_enu(ned: &Vector3D) -> Vector3D {
    // ENU X (East) = NED Y (East)
    // ENU Y (North) = NED X (North)
    // ENU Z (Up) = -NED Z (Down)
    return Vector3D {
        x: (ned).y,
        y: (ned).x,
        z: 0.0 - (ned).z
    };
}

pub fn enu_to_ned(enu: &Vector3D) -> Vector3D {
    // NED X (North) = ENU Y (North)
    // NED Y (East) = ENU X (East)
    // NED Z (Down) = -ENU Z (Up)
    return Vector3D {
        x: (enu).y,
        y: (enu).x,
        z: 0.0 - (enu).z
    };
}

pub fn ned_to_body_frd(ned_vel: &Vector3D, yaw_rad: Float) -> Vector3D {
    let cos_psi: Float = cos(yaw_rad);
    let sin_psi: Float = sin(yaw_rad);
    let forward: Float = ((ned_vel).x * cos_psi) + ((ned_vel).y * sin_psi);
    let right: Float = ((0.0 - (ned_vel).x) * sin_psi) + ((ned_vel).y * cos_psi);
    let down: Float = (ned_vel).z;

    return Vector3D {
        x: forward,
        y: right,
        z: down
    };
}

pub fn body_frd_to_ned(body_vel: &Vector3D, yaw_rad: Float) -> Vector3D {
    let cos_psi: Float = cos(yaw_rad);
    let sin_psi: Float = sin(yaw_rad);
    let north: Float = ((body_vel).x * cos_psi) - ((body_vel).y * sin_psi);
    let east: Float = ((body_vel).x * sin_psi) + ((body_vel).y * cos_psi);
    let down: Float = (body_vel).z;

    return Vector3D {
        x: north,
        y: east,
        z: down
    };
}

pub fn uav_atan2_approx(y_val: Float, x_val: Float) -> Float {
    let pi_val: Float = 3.141592653589793;
    let pi_over_2: Float = 1.5707963267948966;
    if x_val == 0.0 {
        if y_val > 0.0 {
            return pi_over_2;
        }
        if y_val < 0.0 {
            return 0.0 - pi_over_2;
        }
        return 0.0;
    }
    let z_rat: Float = y_val / x_val;
    // Pade / rational approximation for atan(z)
    let atan_val: Float = z_rat / (1.0 + (0.28 * z_rat * z_rat));
    if x_val > 0.0 {
        return atan_val;
    }
    if y_val >= 0.0 {
        return atan_val + pi_val;
    }
    return atan_val - pi_val;
}

pub fn compute_ground_track(vn_north: Float, ve_east: Float) -> Float {
    let ground_speed: Float = sqrt((vn_north * vn_north) + (ve_east * ve_east));
    if ground_speed < 0.0001 {
        return 0.0;
    }
    return uav_atan2_approx(ve_east, vn_north);
}
