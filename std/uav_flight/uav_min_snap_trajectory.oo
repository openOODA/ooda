// # UAV Minimum Snap 7th-Order Polynomial Trajectory Generator
//
// Logline: Evaluates 7th-order minimum snap polynomial trajectory segments and boundary conditions for quadrotors.
//
// Setup: Generates ultra-smooth trajectories minimizing motor rotor torque fluctuations and mechanical stress.
//
// Beats:
//   1. Define 7th-Order Polynomial Coefficients structure (c0..c7) for a single spatial axis.
//   2. Define 3D Trajectory Segment (coefficients for X, Y, Z axes, duration T).
//   3. Compute Position p(t), Velocity v(t), Acceleration a(t), Jerk j(t), and Snap s(t).
//   4. Construct standard rest-to-rest minimum snap trajectory segment between two 3D positions.

import "./uav_coordinate_frames.oo";

pub type Poly7Coeffs = struct {
    c0: Float, c1: Float, c2: Float, c3: Float,
    c4: Float, c5: Float, c6: Float, c7: Float,
};

pub type MinSnapSegment3D = struct {
    poly_x: Poly7Coeffs,
    poly_y: Poly7Coeffs,
    poly_z: Poly7Coeffs,
    duration_sec: Float,
};

pub type TrajectorySample = struct {
    pos: Vector3D,
    vel: Vector3D,
    acc: Vector3D,
    jerk: Vector3D,
    snap: Vector3D,
};

pub fn eval_poly7_pos(c: &Poly7Coeffs, t: Float) -> Float {
    let t2: Float = t * t;
    let t3: Float = t2 * t;
    let t4: Float = t3 * t;
    let t5: Float = t4 * t;
    let t6: Float = t5 * t;
    let t7: Float = t6 * t;
    return (c).c0 + ((c).c1 * t) + ((c).c2 * t2) + ((c).c3 * t3) + ((c).c4 * t4) + ((c).c5 * t5) + ((c).c6 * t6) + ((c).c7 * t7);
}

pub fn eval_poly7_vel(c: &Poly7Coeffs, t: Float) -> Float {
    let t2: Float = t * t;
    let t3: Float = t2 * t;
    let t4: Float = t3 * t;
    let t5: Float = t4 * t;
    let t6: Float = t5 * t;
    return (c).c1 + (2.0 * (c).c2 * t) + (3.0 * (c).c3 * t2) + (4.0 * (c).c4 * t3) + (5.0 * (c).c5 * t4) + (6.0 * (c).c6 * t5) + (7.0 * (c).c7 * t6);
}

pub fn eval_poly7_acc(c: &Poly7Coeffs, t: Float) -> Float {
    let t2: Float = t * t;
    let t3: Float = t2 * t;
    let t4: Float = t3 * t;
    let t5: Float = t4 * t;
    return (2.0 * (c).c2) + (6.0 * (c).c3 * t) + (12.0 * (c).c4 * t2) + (20.0 * (c).c5 * t3) + (30.0 * (c).c6 * t4) + (42.0 * (c).c7 * t5);
}

pub fn eval_poly7_jerk(c: &Poly7Coeffs, t: Float) -> Float {
    let t2: Float = t * t;
    let t3: Float = t2 * t;
    let t4: Float = t3 * t;
    return (6.0 * (c).c3) + (24.0 * (c).c4 * t) + (60.0 * (c).c5 * t2) + (120.0 * (c).c6 * t3) + (210.0 * (c).c7 * t4);
}

pub fn eval_poly7_snap(c: &Poly7Coeffs, t: Float) -> Float {
    let t2: Float = t * t;
    let t3: Float = t2 * t;
    return (24.0 * (c).c4) + (120.0 * (c).c5 * t) + (360.0 * (c).c6 * t2) + (840.0 * (c).c7 * t3);
}

// Closed-form rest-to-rest minimum snap 7th degree polynomial between p0 and p1 over time T
pub fn min_snap_rest_to_rest_1d(p0: Float, p1: Float, duration_t: Float) -> Poly7Coeffs {
    let d: Float = p1 - p0;
    let t: Float = if duration_t < 0.001 { 0.001 } else { duration_t };
    let t4: Float = t * t * t * t;
    let t5: Float = t4 * t;
    let t6: Float = t5 * t;
    let t7: Float = t6 * t;

    // Minimum snap rest-to-rest polynomial: s(tau) = 35*tau^4 - 84*tau^5 + 70*tau^6 - 20*tau^7
    let c4: Float = (35.0 * d) / t4;
    let c5: Float = (0.0 - (84.0 * d)) / t5;
    let c6: Float = (70.0 * d) / t6;
    let c7: Float = (0.0 - (20.0 * d)) / t7;

    return Poly7Coeffs {
        c0: p0, c1: 0.0, c2: 0.0, c3: 0.0,
        c4: c4, c5: c5, c6: c6, c7: c7,
    };
}

pub fn min_snap_sample(seg: &MinSnapSegment3D, t: Float) -> TrajectorySample {
    let clamped_t: Float = if t < 0.0 {
        0.0
    } else if t > (seg).duration_sec {
        (seg).duration_sec
    } else {
        t
    };

    let px: Float = eval_poly7_pos(&(seg).poly_x, clamped_t);
    let py: Float = eval_poly7_pos(&(seg).poly_y, clamped_t);
    let pz: Float = eval_poly7_pos(&(seg).poly_z, clamped_t);

    let vx: Float = eval_poly7_vel(&(seg).poly_x, clamped_t);
    let vy: Float = eval_poly7_vel(&(seg).poly_y, clamped_t);
    let vz: Float = eval_poly7_vel(&(seg).poly_z, clamped_t);

    let ax: Float = eval_poly7_acc(&(seg).poly_x, clamped_t);
    let ay: Float = eval_poly7_acc(&(seg).poly_y, clamped_t);
    let az: Float = eval_poly7_acc(&(seg).poly_z, clamped_t);

    let jx: Float = eval_poly7_jerk(&(seg).poly_x, clamped_t);
    let jy: Float = eval_poly7_jerk(&(seg).poly_y, clamped_t);
    let jz: Float = eval_poly7_jerk(&(seg).poly_z, clamped_t);

    let sx: Float = eval_poly7_snap(&(seg).poly_x, clamped_t);
    let sy: Float = eval_poly7_snap(&(seg).poly_y, clamped_t);
    let sz: Float = eval_poly7_snap(&(seg).poly_z, clamped_t);

    return TrajectorySample {
        pos: Vector3D { x: px, y: py, z: pz },
        vel: Vector3D { x: vx, y: vy, z: vz },
        acc: Vector3D { x: ax, y: ay, z: az },
        jerk: Vector3D { x: jx, y: jy, z: jz },
        snap: Vector3D { x: sx, y: sy, z: sz },
    };
}
