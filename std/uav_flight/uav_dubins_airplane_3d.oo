// # UAV 3D Dubins Airplane Path Planner
//
// Logline: Plans 3D Dubins paths for fixed-wing and VTOL UAVs combining bounded horizontal turn radius with glide slope constraints.
//
// Setup: Kinematically feasible trajectory planning enforcing minimum turning radius R_min and maximum climb/dive flight path angles.
//
// Beats:
//   1. Define 3D Dubins Constraints (min turn radius, max pitch angle gamma_max, cruise airspeed).
//   2. Calculate horizontal planar distance and required altitude climb/descent delta_z.
//   3. Classify trajectory into Low, Medium, or High altitude gain regimes.
//   4. Generate 3D Dubins Waypoints integrating horizontal arc-line-arc (CSC) with continuous vertical pitch profiling.

import "./uav_coordinate_frames.oo";

pub type Dubins3DConstraints = struct {
    min_turn_radius_m: Float,
    max_pitch_angle_rad: Float,
    cruise_airspeed_m_s: Float
};

pub type DubinsAirplaneState = struct {
    pos: Vector3D,
    heading_rad: Float,
    pitch_rad: Float
};

pub type Dubins3DPathSegment = struct {
    horizontal_length: Float,
    altitude_change: Float,
    flight_path_angle: Float,
    total_3d_length: Float,
    is_feasible: Bool
};

pub fn dubins_constraints_default() -> Dubins3DConstraints {
    return Dubins3DConstraints {
        min_turn_radius_m: 15.0,
        max_pitch_angle_rad: 0.261799, // 15 degrees max pitch
        cruise_airspeed_m_s: 18.0
    };
}

pub fn plan_dubins_airplane_segment(
    start: &DubinsAirplaneState,
    target: &DubinsAirplaneState,
    limits: &Dubins3DConstraints
) -> Dubins3DPathSegment {
    let dx: Float = (target).pos.x - (start).pos.x;
    let dy: Float = (target).pos.y - (start).pos.y;
    let dz: Float = (target).pos.z - (start).pos.z;

    let d_horizontal: Float = sqrt((dx * dx) + (dy * dy));

    // Approximate horizontal Dubins path length (straight line + 2*pi*R turn buffer if heading difference exists)
    let d_heading: Float = (target).heading_rad - (start).heading_rad;
    let abs_dh: Float = if d_heading < 0.0 { 0.0 - d_heading } else { d_heading };
    let r_min: Float = (limits).min_turn_radius_m;
    let h_length: Float = d_horizontal + (abs_dh * r_min);

    let max_pitch: Float = (limits).max_pitch_angle_rad;
    // Max allowable altitude gain for this horizontal distance: dz_max = h_length * tan(gamma_max) approx h_length * gamma_max
    let max_dz: Float = h_length * max_pitch;

    let abs_dz: Float = if dz < 0.0 { 0.0 - dz } else { dz };
    let is_feasible: Bool = abs_dz <= max_dz;

    let actual_pitch: Float = if h_length > 0.001 {
        dz / h_length
    } else {
        0.0
    };

    let total_3d: Float = sqrt((h_length * h_length) + (dz * dz));

    return Dubins3DPathSegment {
        horizontal_length: h_length,
        altitude_change: dz,
        flight_path_angle: actual_pitch,
        total_3d_length: total_3d,
        is_feasible: is_feasible
    };
}
