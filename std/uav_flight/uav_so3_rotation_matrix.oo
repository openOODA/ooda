// # UAV SO(3) Lie Group & Rotation Matrix Dynamics
//
// Logline: Matrix representations and Lie algebra so(3) operators for rigid body attitude kinematics and rotation error metrics.
//
// Setup: Geometric control building block on the Special Orthogonal group SO(3) eliminating attitude singularities.
//
// Beats:
//   1. Define 3x3 Rotation Matrix structure and identity constructor.
//   2. Implement hat (skew-symmetric) and vee operators mapping between R^3 and so(3).
//   3. Compute matrix exponential via Rodrigues formula and matrix logarithm.
//   4. Calculate geometric rotation tracking error e_R = 0.5 * (R_d^T * R - R^T * R_d)^vee.

import "./uav_coordinate_frames.oo";

pub type Matrix3x3 = struct {
    m00: Float, m01: Float, m02: Float,
    m10: Float, m11: Float, m12: Float,
    m20: Float, m21: Float, m22: Float
};

pub fn mat3_identity() -> Matrix3x3 {
    return Matrix3x3 {
        m00: 1.0, m01: 0.0, m02: 0.0,
        m10: 0.0, m11: 1.0, m12: 0.0,
        m20: 0.0, m21: 0.0, m22: 1.0
    };
}

pub fn mat3_zero() -> Matrix3x3 {
    return Matrix3x3 {
        m00: 0.0, m01: 0.0, m02: 0.0,
        m10: 0.0, m11: 0.0, m12: 0.0,
        m20: 0.0, m21: 0.0, m22: 0.0
    };
}

pub fn mat3_transpose(m: &Matrix3x3) -> Matrix3x3 {
    return Matrix3x3 {
        m00: (m).m00, m01: (m).m10, m02: (m).m20,
        m10: (m).m01, m11: (m).m11, m12: (m).m21,
        m20: (m).m02, m21: (m).m12, m22: (m).m22
    };
}

pub fn mat3_multiply(a: &Matrix3x3, b: &Matrix3x3) -> Matrix3x3 {
    return Matrix3x3 {
        m00: ((a).m00 * (b).m00) + ((a).m01 * (b).m10) + ((a).m02 * (b).m20),
        m01: ((a).m00 * (b).m01) + ((a).m01 * (b).m11) + ((a).m02 * (b).m21),
        m02: ((a).m00 * (b).m02) + ((a).m01 * (b).m12) + ((a).m02 * (b).m22),

        m10: ((a).m10 * (b).m00) + ((a).m11 * (b).m10) + ((a).m12 * (b).m20),
        m11: ((a).m10 * (b).m01) + ((a).m11 * (b).m11) + ((a).m12 * (b).m21),
        m12: ((a).m10 * (b).m02) + ((a).m11 * (b).m12) + ((a).m12 * (b).m22),

        m20: ((a).m20 * (b).m00) + ((a).m21 * (b).m10) + ((a).m22 * (b).m20),
        m21: ((a).m20 * (b).m01) + ((a).m21 * (b).m11) + ((a).m22 * (b).m21),
        m22: ((a).m20 * (b).m02) + ((a).m21 * (b).m12) + ((a).m22 * (b).m22)
    };
}

pub fn mat3_multiply_vec(m: &Matrix3x3, v: &Vector3D) -> Vector3D {
    return Vector3D {
        x: ((m).m00 * (v).x) + ((m).m01 * (v).y) + ((m).m02 * (v).z),
        y: ((m).m10 * (v).x) + ((m).m11 * (v).y) + ((m).m12 * (v).z),
        z: ((m).m20 * (v).x) + ((m).m21 * (v).y) + ((m).m22 * (v).z)
    };
}

// Hat operator: maps omega in R^3 to skew-symmetric matrix in so(3)
pub fn so3_hat(w: &Vector3D) -> Matrix3x3 {
    return Matrix3x3 {
        m00: 0.0,      m01: 0.0 - (w).z, m02: (w).y,
        m10: (w).z,    m11: 0.0,         m12: 0.0 - (w).x,
        m20: 0.0 - (w).y, m21: (w).x,    m22: 0.0
    };
}

// Vee operator: maps skew-symmetric matrix in so(3) to vector in R^3
pub fn so3_vee(m: &Matrix3x3) -> Vector3D {
    return Vector3D {
        x: 0.5 * ((m).m21 - (m).m12),
        y: 0.5 * ((m).m02 - (m).m20),
        z: 0.5 * ((m).m10 - (m).m01)
    };
}

// Matrix exponential using Rodrigues formula: exp([w]*theta)
pub fn so3_exp(w_unit: &Vector3D, theta: Float) -> Matrix3x3 {
    let eye: Matrix3x3 = mat3_identity();
    let hat_w: Matrix3x3 = so3_hat(w_unit);
    let hat_w2: Matrix3x3 = mat3_multiply(&hat_w, &hat_w);

    let st: Float = sin(theta);
    let ct: Float = 1.0 - cos(theta);

    return Matrix3x3 {
        m00: (eye).m00 + (st * (hat_w).m00) + (ct * (hat_w2).m00),
        m01: (eye).m01 + (st * (hat_w).m01) + (ct * (hat_w2).m01),
        m02: (eye).m02 + (st * (hat_w).m02) + (ct * (hat_w2).m02),

        m10: (eye).m10 + (st * (hat_w).m10) + (ct * (hat_w2).m10),
        m11: (eye).m11 + (st * (hat_w).m11) + (ct * (hat_w2).m11),
        m12: (eye).m12 + (st * (hat_w).m12) + (ct * (hat_w2).m12),

        m20: (eye).m20 + (st * (hat_w).m20) + (ct * (hat_w2).m20),
        m21: (eye).m21 + (st * (hat_w).m21) + (ct * (hat_w2).m21),
        m22: (eye).m22 + (st * (hat_w).m22) + (ct * (hat_w2).m22)
    };
}

// Geometric attitude error on SO(3): e_R = 0.5 * (R_d^T * R - R^T * R_d)^vee
pub fn so3_attitude_error(r_curr: &Matrix3x3, r_des: &Matrix3x3) -> Vector3D {
    let rd_t: Matrix3x3 = mat3_transpose(r_des);
    let r_t: Matrix3x3 = mat3_transpose(r_curr);

    let term1: Matrix3x3 = mat3_multiply(&rd_t, r_curr);
    let term2: Matrix3x3 = mat3_multiply(&r_t, r_des);

    let skew_err: Matrix3x3 = Matrix3x3 {
        m00: (term1).m00 - (term2).m00, m01: (term1).m01 - (term2).m01, m02: (term1).m02 - (term2).m02,
        m10: (term1).m10 - (term2).m10, m11: (term1).m11 - (term2).m11, m12: (term1).m12 - (term2).m12,
        m20: (term1).m20 - (term2).m20, m21: (term1).m21 - (term2).m21, m22: (term1).m22 - (term2).m22
    };

    return so3_vee(&skew_err);
}
