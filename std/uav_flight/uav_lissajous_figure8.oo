// # UAV Lissajous & 3D Figure-8 Inspection Trajectory Generator
//
// Logline: Generates analytical 3D search curves, Lemniscate of Gerono figure-8s, and helical climb trajectories.
//
// Setup: Periodic inspection trajectories with closed-form position, velocity, acceleration, and jerk derivatives.
//
// Beats:
//   1. Define Figure-8 Curve Parameters (amplitudes Ax, Ay, Az, frequency omega, center offset).
//   2. Compute Lemniscate position x(t) = Ax*sin(wt), y(t) = Ay*sin(wt)*cos(wt), z(t) = z0 + vz*t.
//   3. Derive analytical Velocity, Acceleration, and Jerk vectors for feedforward control.
//   4. Calculate tangential heading angle and yaw rate aligned with the velocity vector.

import "./uav_coordinate_frames.oo";
import "./uav_min_snap_trajectory.oo";

pub type Figure8Params = struct {
    amp_x: Float,
    amp_y: Float,
    center_pos: Vector3D,
    frequency_rad_s: Float,
    climb_rate_z: Float
};

pub fn figure8_params_default() -> Figure8Params {
    return Figure8Params {
        amp_x: 5.0,
        amp_y: 3.0,
        center_pos: Vector3D { x: 0.0, y: 0.0, z: 10.0 },
        frequency_rad_s: 0.35,
        climb_rate_z: 0.0
    };
}

pub fn sample_figure8_trajectory(params: &Figure8Params, t: Float) -> TrajectorySample {
    let w: Float = (params).frequency_rad_s;
    let ax: Float = (params).amp_x;
    let ay: Float = (params).amp_y;

    let wt: Float = w * t;
    let s_wt: Float = sin(wt);
    let c_wt: Float = cos(wt);
    let s_2wt: Float = sin(2.0 * wt);
    let c_2wt: Float = cos(2.0 * wt);

    // Position: x = Ax * sin(wt), y = Ay * 0.5 * sin(2wt), z = z0 + vz * t
    let px: Float = (params).center_pos.x + (ax * s_wt);
    let py: Float = (params).center_pos.y + (0.5 * ay * s_2wt);
    let pz: Float = (params).center_pos.z + ((params).climb_rate_z * t);

    // Velocity: dx/dt = Ax*w*cos(wt), dy/dt = Ay*w*cos(2wt), dz/dt = vz
    let vx: Float = ax * w * c_wt;
    let vy: Float = ay * w * c_2wt;
    let vz: Float = (params).climb_rate_z;

    // Acceleration: d2x/dt2 = -Ax*w^2*sin(wt), d2y/dt2 = -2*Ay*w^2*sin(2wt), d2z/dt2 = 0
    let w2: Float = w * w;
    let ax_val: Float = (0.0 - ax) * w2 * s_wt;
    let ay_val: Float = (0.0 - (2.0 * ay)) * w2 * s_2wt;
    let az_val: Float = 0.0;

    // Jerk: d3x/dt3 = -Ax*w^3*cos(wt), d3y/dt3 = -4*Ay*w^3*cos(2wt), d3z/dt3 = 0
    let w3: Float = w2 * w;
    let jx: Float = (0.0 - ax) * w3 * c_wt;
    let jy: Float = (0.0 - (4.0 * ay)) * w3 * c_2wt;
    let jz: Float = 0.0;

    // Snap: d4x/dt4 = Ax*w^4*sin(wt), d4y/dt4 = 8*Ay*w^4*sin(2wt), d4z/dt4 = 0
    let w4: Float = w3 * w;
    let sx: Float = ax * w4 * s_wt;
    let sy: Float = 8.0 * ay * w4 * s_2wt;
    let sz: Float = 0.0;

    return TrajectorySample {
        pos: Vector3D { x: px, y: py, z: pz },
        vel: Vector3D { x: vx, y: vy, z: vz },
        acc: Vector3D { x: ax_val, y: ay_val, z: az_val },
        jerk: Vector3D { x: jx, y: jy, z: jz },
        snap: Vector3D { x: sx, y: sy, z: sz }
    };
}
