// # UAV Minimum Jerk 5th-Order Polynomial Trajectory Generator
//
// Logline: Computes 5th-order minimum jerk polynomial trajectories for smooth waypoint transitions and aggressive maneuvers.
//
// Setup: Generates point-to-point trajectory profiles minimizing rate of change of linear acceleration.
//
// Beats:
//   1. Define 5th-Order Polynomial Coefficients structure (c0..c5).
//   2. Define 3D Minimum Jerk Segment.
//   3. Compute Position p(t), Velocity v(t), and Acceleration a(t).
//   4. Generate quintic polynomial satisfying initial and final boundary constraints (p0, v0, a0, pf, vf, af).

import "./uav_coordinate_frames.oo";

pub type Poly5Coeffs = struct {
    c0: Float, c1: Float, c2: Float,
    c3: Float, c4: Float, c5: Float,
};

pub type MinJerkSegment3D = struct {
    poly_x: Poly5Coeffs,
    poly_y: Poly5Coeffs,
    poly_z: Poly5Coeffs,
    duration_sec: Float,
};

pub type JerkSample = struct {
    pos: Vector3D,
    vel: Vector3D,
    acc: Vector3D,
};

pub fn eval_poly5_pos(c: &Poly5Coeffs, t: Float) -> Float {
    let t2: Float = t * t;
    let t3: Float = t2 * t;
    let t4: Float = t3 * t;
    let t5: Float = t4 * t;
    return (c).c0 + ((c).c1 * t) + ((c).c2 * t2) + ((c).c3 * t3) + ((c).c4 * t4) + ((c).c5 * t5);
}

pub fn eval_poly5_vel(c: &Poly5Coeffs, t: Float) -> Float {
    let t2: Float = t * t;
    let t3: Float = t2 * t;
    let t4: Float = t3 * t;
    return (c).c1 + (2.0 * (c).c2 * t) + (3.0 * (c).c3 * t2) + (4.0 * (c).c4 * t3) + (5.0 * (c).c5 * t4);
}

pub fn eval_poly5_acc(c: &Poly5Coeffs, t: Float) -> Float {
    let t2: Float = t * t;
    let t3: Float = t2 * t;
    return (2.0 * (c).c2) + (6.0 * (c).c3 * t) + (12.0 * (c).c4 * t2) + (20.0 * (c).c5 * t3);
}

// Solves 5th-order polynomial matching (p0, v0, a0) at t=0 and (pf, vf, af) at t=T
pub fn min_jerk_boundary_1d(
    p0: Float, v0: Float, a0: Float,
    pf: Float, vf: Float, af: Float,
    duration_t: Float
) -> Poly5Coeffs {
    let t: Float = if duration_t < 0.001 { 0.001 } else { duration_t };
    let t2: Float = t * t;
    let t3: Float = t2 * t;
    let t4: Float = t3 * t;
    let t5: Float = t4 * t;

    let c0: Float = p0;
    let c1: Float = v0;
    let c2: Float = 0.5 * a0;

    let h: Float = pf - p0 - (v0 * t) - (0.5 * a0 * t2);
    let h_v: Float = vf - v0 - (a0 * t);
    let h_a: Float = af - a0;

    let c3: Float = ((10.0 * h) / t3) - ((4.0 * h_v) / t2) + ((0.5 * h_a) / t);
    let c4: Float = ((0.0 - (15.0 * h)) / t4) + ((7.0 * h_v) / t3) - ((1.0 * h_a) / t2);
    let c5: Float = ((6.0 * h) / t5) - ((3.0 * h_v) / t4) + ((0.5 * h_a) / t3);

    return Poly5Coeffs {
        c0: c0, c1: c1, c2: c2,
        c3: c3, c4: c4, c5: c5,
    };
}

pub fn min_jerk_sample(seg: &MinJerkSegment3D, t: Float) -> JerkSample {
    let clamped_t: Float = if t < 0.0 {
        0.0
    } else if t > (seg).duration_sec {
        (seg).duration_sec
    } else {
        t
    };

    let px: Float = eval_poly5_pos(&(seg).poly_x, clamped_t);
    let py: Float = eval_poly5_pos(&(seg).poly_y, clamped_t);
    let pz: Float = eval_poly5_pos(&(seg).poly_z, clamped_t);

    let vx: Float = eval_poly5_vel(&(seg).poly_x, clamped_t);
    let vy: Float = eval_poly5_vel(&(seg).poly_y, clamped_t);
    let vz: Float = eval_poly5_vel(&(seg).poly_z, clamped_t);

    let ax: Float = eval_poly5_acc(&(seg).poly_x, clamped_t);
    let ay: Float = eval_poly5_acc(&(seg).poly_y, clamped_t);
    let az: Float = eval_poly5_acc(&(seg).poly_z, clamped_t);

    return JerkSample {
        pos: Vector3D { x: px, y: py, z: pz },
        vel: Vector3D { x: vx, y: vy, z: vz },
        acc: Vector3D { x: ax, y: ay, z: az },
    };
}
