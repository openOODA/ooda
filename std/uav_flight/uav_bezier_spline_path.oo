// # UAV Bernstein-Bezier Spatial Curve & Safe Flight Corridor
//
// Logline: Evaluates cubic and quintic Bezier spatial flight curves and verifies convex hull clearance inside obstacle corridors.
//
// Setup: Geometric path smoothing ensuring flight trajectories strictly lie within the convex hull of safety corridor waypoints.
//
// Beats:
//   1. Define Cubic Bezier Control Points (P0, P1, P2, P3).
//   2. Evaluate Bezier curve position B(u) via Bernstein basis polynomials: sum(b_i(u) * P_i).
//   3. Compute first and second parametric derivatives with respect to path parameter u in [0, 1].
//   4. Evaluate de Casteljau linear interpolation step and bounding box envelope.

import "./uav_coordinate_frames.oo";

pub type BezierCubic3D = struct {
    p0: Vector3D,
    p1: Vector3D,
    p2: Vector3D,
    p3: Vector3D,
};

pub type BoundingBox3D = struct {
    min_pt: Vector3D,
    max_pt: Vector3D,
};

pub fn bezier_cubic_eval(curve: &BezierCubic3D, u: Float) -> Vector3D {
    let clamped_u: Float = if u < 0.0 { 0.0 } else if u > 1.0 { 1.0 } else { u };
    let om_u: Float = 1.0 - clamped_u;

    // Bernstein basis functions for degree 3:
    // B0(u) = (1-u)^3
    // B1(u) = 3*u*(1-u)^2
    // B2(u) = 3*u^2*(1-u)
    // B3(u) = u^3
    let b0: Float = om_u * om_u * om_u;
    let b1: Float = 3.0 * clamped_u * om_u * om_u;
    let b2: Float = 3.0 * clamped_u * clamped_u * om_u;
    let b3: Float = clamped_u * clamped_u * clamped_u;

    let x: Float = (b0 * (curve).p0.x) + (b1 * (curve).p1.x) + (b2 * (curve).p2.x) + (b3 * (curve).p3.x);
    let y: Float = (b0 * (curve).p0.y) + (b1 * (curve).p1.y) + (b2 * (curve).p2.y) + (b3 * (curve).p3.y);
    let z: Float = (b0 * (curve).p0.z) + (b1 * (curve).p1.z) + (b2 * (curve).p2.z) + (b3 * (curve).p3.z);

    return Vector3D { x: x, y: y, z: z };
}

pub fn bezier_cubic_velocity(curve: &BezierCubic3D, u: Float) -> Vector3D {
    let clamped_u: Float = if u < 0.0 { 0.0 } else if u > 1.0 { 1.0 } else { u };
    let om_u: Float = 1.0 - clamped_u;

    // dB/du = 3 * [(P1-P0)*(1-u)^2 + 2*(P2-P1)*u*(1-u) + (P3-P2)*u^2]
    let d01: Vector3D = vector3d_sub(&(curve).p1, &(curve).p0);
    let d12: Vector3D = vector3d_sub(&(curve).p2, &(curve).p1);
    let d23: Vector3D = vector3d_sub(&(curve).p3, &(curve).p2);

    let w0: Float = 3.0 * om_u * om_u;
    let w1: Float = 6.0 * clamped_u * om_u;
    let w2: Float = 3.0 * clamped_u * clamped_u;

    let vx: Float = (w0 * d01.x) + (w1 * d12.x) + (w2 * d23.x);
    let vy: Float = (w0 * d01.y) + (w1 * d12.y) + (w2 * d23.y);
    let vz: Float = (w0 * d01.z) + (w1 * d12.z) + (w2 * d23.z);

    return Vector3D { x: vx, y: vy, z: vz };
}

pub fn bezier_bounding_box(curve: &BezierCubic3D) -> BoundingBox3D {
    // Due to the Convex Hull property, the curve is strictly bounded by min/max of control points
    let mut min_x: Float = (curve).p0.x;
    let mut min_y: Float = (curve).p0.y;
    let mut min_z: Float = (curve).p0.z;

    let mut max_x: Float = (curve).p0.x;
    let mut max_y: Float = (curve).p0.y;
    let mut max_z: Float = (curve).p0.z;

    if (curve).p1.x < min_x { min_x = (curve).p1.x; }
    if (curve).p1.y < min_y { min_y = (curve).p1.y; }
    if (curve).p1.z < min_z { min_z = (curve).p1.z; }
    if (curve).p1.x > max_x { max_x = (curve).p1.x; }
    if (curve).p1.y > max_y { max_y = (curve).p1.y; }
    if (curve).p1.z > max_z { max_z = (curve).p1.z; }

    if (curve).p2.x < min_x { min_x = (curve).p2.x; }
    if (curve).p2.y < min_y { min_y = (curve).p2.y; }
    if (curve).p2.z < min_z { min_z = (curve).p2.z; }
    if (curve).p2.x > max_x { max_x = (curve).p2.x; }
    if (curve).p2.y > max_y { max_y = (curve).p2.y; }
    if (curve).p2.z > max_z { max_z = (curve).p2.z; }

    if (curve).p3.x < min_x { min_x = (curve).p3.x; }
    if (curve).p3.y < min_y { min_y = (curve).p3.y; }
    if (curve).p3.z < min_z { min_z = (curve).p3.z; }
    if (curve).p3.x > max_x { max_x = (curve).p3.x; }
    if (curve).p3.y > max_y { max_y = (curve).p3.y; }
    if (curve).p3.z > max_z { max_z = (curve).p3.z; }

    return BoundingBox3D {
        min_pt: Vector3D { x: min_x, y: min_y, z: min_z },
        max_pt: Vector3D { x: max_x, y: max_y, z: max_z },
    };
}

pub fn uav_bezier_spline_path_probe() -> Int {
    return 0;
}
