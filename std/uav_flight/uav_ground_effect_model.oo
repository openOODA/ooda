// # UAV Ground Effect & Vortex Ring State Aerodynamic Model
//
// Logline: Cheeseman-Bennett T/Tinf = 1/(1-(R/(4z))^2). Int milli destub.
//
// Setup: IGE multiplier and VRS descent band; heights in mm.
//
// Beats:
//   1. Rotor radius, min AGL, max IGE (~2.5 R).
//   2. ratio = R/(4z); mult = 1/(1-ratio^2); denom floor 350 milli.
//   3. VRS when 0.5 Vi < Vd < 1.5 Vi and z > max IGE.
//   4. T_eff = T_base * mult.

type GroundEffectConfig = struct {
    rotor_radius_mm: Int,
    min_agl_height_mm: Int,
    max_ige_height_mm: Int
};

type GroundEffectResult = struct {
    thrust_multiplier_milli: Int,
    effective_thrust_mn: Int,
    is_in_ground_effect: Bool,
    vrs_hazard_warning: Bool
};

pub fn ground_effect_config_default(radius_mm: Int) -> GroundEffectConfig {
    let r: Int = if radius_mm < 1 { 1 } else { radius_mm };
    return GroundEffectConfig {
        rotor_radius_mm: r,
        min_agl_height_mm: 50,
        max_ige_height_mm: (r * 5) / 2
    };
}

pub fn compute_ground_effect(
    cfg: GroundEffectConfig,
    base_thrust_mn: Int,
    height_agl_mm: Int,
    descent_speed_mm_s: Int,
    induced_hover_mm_s: Int
) -> GroundEffectResult {
    let r: Int = cfg.rotor_radius_mm;
    let safe_z: Int = if height_agl_mm < cfg.min_agl_height_mm {
        cfg.min_agl_height_mm
    } else {
        height_agl_mm
    };
    let is_ige: Bool = safe_z < cfg.max_ige_height_mm;
    let four_z: Int = 4 * safe_z;
    let safe_four_z: Int = if four_z < 1 { 1 } else { four_z };
    let ratio_milli: Int = (r * 1000) / safe_four_z;
    let ratio2_milli: Int = (ratio_milli * ratio_milli) / 1000;
    let denom_raw: Int = 1000 - ratio2_milli;
    let sat_denom: Int = if denom_raw > 350 { denom_raw } else { 350 };
    let ige_mult: Int = 1000000 / sat_denom;
    let mult: Int = if is_ige { ige_mult } else { 1000 };
    let v_lo: Int = induced_hover_mm_s / 2;
    let v_hi: Int = (induced_hover_mm_s * 3) / 2;
    let in_band: Bool = if descent_speed_mm_s > v_lo {
        descent_speed_mm_s < v_hi
    } else {
        false
    };
    let above_ige: Bool = height_agl_mm > cfg.max_ige_height_mm;
    let vrs: Bool = if in_band { above_ige } else { false };
    return GroundEffectResult {
        thrust_multiplier_milli: mult,
        effective_thrust_mn: (base_thrust_mn * mult) / 1000,
        is_in_ground_effect: is_ige,
        vrs_hazard_warning: vrs
    };
}

pub fn ground_effect_mult(r: GroundEffectResult) -> Int {
    return r.thrust_multiplier_milli;
}

pub fn ground_effect_flags(r: GroundEffectResult) -> Int {
    let ige: Int = if r.is_in_ground_effect { 1 } else { 0 };
    let vrs: Int = if r.vrs_hazard_warning { 2 } else { 0 };
    return ige + vrs;
}
