// # Monotonic Chrono and Time Module
//
// Logline: Monotonic timestamps, sleep primitives, duration formatting, and time units under explicit TimeCap.
//
// Setup: Bridges native POSIX clock primitives with safe duration calculations and formatting.
//
// Beats:
//   1. Acquire current epoch milliseconds and monotonic delta measurements.
//   2. High-precision sleep execution gated by TimeCap.
//   3. Convert and format standard duration representations.
// RULES.oot 1.4: Default-deny for time effects. Explicit &TimeCap required.
// RULES.oot 1.7: Under 256 lines.

pub fn chrono_now_ms(time_cap: &TimeCap) -> Int {
    return now_ms(time_cap);
}

pub fn chrono_sleep_ms(time_cap: &TimeCap, ms: Int) {
    sleep_ms(time_cap, ms);
}

pub fn chrono_elapsed_ms(time_cap: &TimeCap, start_ms: Int) -> Int {
    let now: Int = now_ms(time_cap);
    if now < start_ms {
        return 0;
    }
    return now - start_ms;
}

pub fn chrono_secs_to_ms(secs: Int) -> Int {
    return secs * 1000;
}

pub fn chrono_mins_to_ms(mins: Int) -> Int {
    return mins * 60000;
}

pub fn chrono_hours_to_ms(hours: Int) -> Int {
    return hours * 3600000;
}

pub fn chrono_days_to_ms(days: Int) -> Int {
    return days * 86400000;
}

pub fn chrono_format_ms(ms: Int) -> String {
    if ms < 1000 {
        return ms.to_string() + "ms";
    }
    if ms < 60000 {
        let sec: Int = ms / 1000;
        let rem_ms: Int = ms % 1000;
        return sec.to_string() + "s " + rem_ms.to_string() + "ms";
    }
    let mins: Int = ms / 60000;
    let rem_sec: Int = (ms % 60000) / 1000;
    return mins.to_string() + "m " + rem_sec.to_string() + "s";
}
