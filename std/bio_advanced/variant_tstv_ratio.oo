// # Transition/Transversion (Ti/Tv) Ratio & Mutation Spectrum
//
// Logline: Calculates Transition/Transversion (Ti/Tv) ratios across whole-genome (~2.0-2.1) and whole-exome (~2.8-3.2) variant callsets.
//
// Setup: NGS variant quality control module evaluating single nucleotide mutation spectra and 6-class substitution profiles.
//
// Beats:
//   1. Define MutationSpectrum and TsTvRatioResult data structures.
//   2. Classify transitions (A<->G, C<->T) versus transversions (A<->C, A<->T, C<->G, G<->T).
//   3. Compute Ti/Tv ratio and flag potential sequencing artifact contamination if Ti/Tv deviates significantly.

pub type MutationSpectrum = struct {
    count_a_to_g: Int,
    count_c_to_t: Int,
    count_a_to_c: Int,
    count_a_to_t: Int,
    count_c_to_g: Int,
    count_g_to_t: Int,
    total_transitions: Int,
    total_transversions: Int,
};

pub type TsTvRatioResult = struct {
    ti_tv_ratio: Float,
    total_snvs: Int,
    is_expected_wgs_range: Bool,
    is_expected_wes_range: Bool,
};

pub fn tstv_is_transition(ref_b: String, alt_b: String) -> Bool {
    let is_ag = (ref_b == "A" && alt_b == "G") || (ref_b == "G" && alt_b == "A");
    let is_ct = (ref_b == "C" && alt_b == "T") || (ref_b == "T" && alt_b == "C");
    return is_ag || is_ct;
}

pub fn tstv_calc_ratio(ti_count: Int, tv_count: Int) -> TsTvRatioResult {
    let tot = ti_count + tv_count;
    let ratio = if tv_count > 0 {
        (ti_count as Float) / (tv_count as Float)
    } else {
        0.0
    };

    // Expected WGS: 2.0 - 2.2; Expected WES: 2.6 - 3.3
    let wgs_ok = ratio >= 1.90 && ratio <= 2.30;
    let wes_ok = ratio >= 2.50 && ratio <= 3.50;

    return TsTvRatioResult {
        ti_tv_ratio: ratio,
        total_snvs: tot,
        is_expected_wgs_range: wgs_ok,
        is_expected_wes_range: wes_ok,
    };
}
