// # PDB Protein Backbone Dihedral Angles (Phi, Psi, Omega)
//
// Logline: Calculates main-chain torsion angles (phi: C-N-CA-C, psi: N-CA-C-N, omega: CA-C-N-CA) from 3D atomic coordinates.
//
// Setup: Structural biology geometry engine converting Cartesian coordinates to peptide backbone torsions.
//
// Beats:
//   1. Define AtomCoord3D and ResidueTorsions data structures.
//   2. Compute vector cross products, dot products, and normal vectors for adjacent atomic planes.
//   3. Compute signed torsion angles in degrees in the range [-180.0, +180.0].

pub type AtomCoord3D = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub type ResidueTorsions = struct {
    residue_num: Int,
    phi_deg: Float,
    psi_deg: Float,
    omega_deg: Float,
    has_phi: Bool,
    has_psi: Bool,
};

pub fn dihedral_vec_sub(a: &AtomCoord3D, b: &AtomCoord3D) -> AtomCoord3D {
    return AtomCoord3D {
        x: (a).x - (b).x,
        y: (a).y - (b).y,
        z: (a).z - (b).z,
    };
}

pub fn dihedral_vec_cross(a: &AtomCoord3D, b: &AtomCoord3D) -> AtomCoord3D {
    return AtomCoord3D {
        x: ((a).y * (b).z) - ((a).z * (b).y),
        y: ((a).z * (b).x) - ((a).x * (b).z),
        z: ((a).x * (b).y) - ((a).y * (b).x),
    };
}

pub fn dihedral_vec_dot(a: &AtomCoord3D, b: &AtomCoord3D) -> Float {
    return ((a).x * (b).x) + ((a).y * (b).y) + ((a).z * (b).z);
}

pub fn dihedral_vec_len(v: &AtomCoord3D) -> Float {
    let d_sq = dihedral_vec_dot(v, v);
    if d_sq <= 0.0 { return 0.0; }
    let mut guess = d_sq / 2.0;
    if guess < 1.0 { guess = 1.0; }
    let mut iter: Int = 0;
    while iter < 8 {
        guess = 0.5 * (guess + (d_sq / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn dihedral_compute_angle_deg(p1: &AtomCoord3D, p2: &AtomCoord3D, p3: &AtomCoord3D, p4: &AtomCoord3D) -> Float {
    let b1 = dihedral_vec_sub(p2, p1);
    let b2 = dihedral_vec_sub(p3, p2);
    let b3 = dihedral_vec_sub(p4, p3);

    let n1 = dihedral_vec_cross(&b1, &b2);
    let n2 = dihedral_vec_cross(&b2, &b3);

    let n1_len = dihedral_vec_len(&n1);
    let n2_len = dihedral_vec_len(&n2);
    let b2_len = dihedral_vec_len(&b2);

    if n1_len < 0.0001 || n2_len < 0.0001 || b2_len < 0.0001 {
        return 0.0;
    }

    let m1 = dihedral_vec_cross(&n1, &b2);
    let x = dihedral_vec_dot(&n1, &n2);
    let y = dihedral_vec_dot(&m1, &n2) / b2_len;

    // Approximate angle via atan2 polynomial / ratio
    let rad = if x == 0.0 { 1.570796 } else { y / x };
    let deg = rad * 57.2957795;
    return deg;
}
