// # Burrows-Wheeler Transform & FM-Index Exact Alignment
//
// Logline: Implements the reversible Burrows-Wheeler Transform (BWT) and FM-index LF-mapping for compressed nucleotide read alignment.
//
// Setup: NGS read mapping module converting genomic sequences to BWT permutations for fast backward searches.
//
// Beats:
//   1. Define BwtTransformResult and FmIndexRank data structures.
//   2. Generate cyclic sequence rotations and sorted BWT character permutations.
//   3. Perform backward search over BWT ranges to locate short sequencing read alignments.

pub type BwtTransformResult = struct {
    original_length: Int,
    bwt_string: String,
    primary_index: Int
};

pub type FmIndexRank = struct {
    character: String,
    cumulative_count: Int,
    range_start: Int,
    range_end: Int
};

pub fn bwt_char_count(s: String, target_c: String) -> Int {
    let n = chars_len(s);
    let mut cnt: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c = char_at(s, i);
        if c == target_c {
            cnt = cnt + 1;
        }
        i = i + 1;
    }
    return cnt;
}

pub fn bwt_backward_search_step(
    c: String,
    curr_low: Int,
    curr_high: Int,
    bwt_str: String,
    c_table_offset: Int
) -> FmIndexRank {
    // FM-index backward search update: new_low = C[c] + Occ(c, curr_low - 1), new_high = C[c] + Occ(c, curr_high) - 1
    let mut occ_low: Int = 0;
    let mut occ_high: Int = 0;

    let mut i: Int = 0;
    while i <= curr_high {
        let char_i = char_at(bwt_str, i);
        if char_i == c {
            if i < curr_low {
                occ_low = occ_low + 1;
            }
            occ_high = occ_high + 1;
        }
        i = i + 1;
    }

    let next_low = c_table_offset + occ_low;
    let next_high = c_table_offset + occ_high - 1;

    return FmIndexRank {
        character: c,
        cumulative_count: occ_high,
        range_start: next_low,
        range_end: next_high
    };
}
