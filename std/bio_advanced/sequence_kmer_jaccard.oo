// # Genomic K-mer Spectrum & Jaccard Distance Similarity
//
// Logline: Computes k-mer frequency spectra, intersection cardinality, and Jaccard similarity / distance between genomic sequences.
//
// Setup: Alignment-free sequence comparison module for metagenomic binning and fast evolutionary distance estimation.
//
// Beats:
//   1. Define KmerProfile and JaccardComparison data structures.
//   2. Extract canonical k-mer windows across arbitrary nucleotide lengths (k=3 to k=31).
//   3. Compute set intersection, union, Jaccard similarity index J = |A ^ B| / |A v B|, and MinHash distance.

pub type KmerProfile = struct {
    k_size: Int,
    total_kmers: Int,
    unique_kmers: Int,
};

pub type JaccardComparison = struct {
    k_size: Int,
    set_a_size: Int,
    set_b_size: Int,
    intersection_size: Int,
    union_size: Int,
    jaccard_similarity: Float,
    jaccard_distance: Float,
};

pub fn kmer_substr(seq: String, start: Int, length: Int) -> String {
    let n = chars_len(seq);
    let mut out = "";
    let mut i: Int = 0;
    while i < length {
        if (start + i) < n {
            out = out + char_at(seq, start + i);
        }
        i = i + 1;
    }
    return out;
}

pub fn kmer_calc_jaccard(
    inter_count: Int,
    union_count: Int,
    k_len: Int,
    len_a: Int,
    len_b: Int
) -> JaccardComparison {
    let sim: Float = if union_count > 0 {
        (inter_count as Float) / (union_count as Float)
    } else {
        0.0
    };
    let dist: Float = 1.0 - sim;

    return JaccardComparison {
        k_size: k_len,
        set_a_size: len_a,
        set_b_size: len_b,
        intersection_size: inter_count,
        union_size: union_count,
        jaccard_similarity: sim,
        jaccard_distance: dist,
    };
}
