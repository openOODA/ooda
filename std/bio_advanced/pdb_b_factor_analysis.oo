// # PDB Crystallographic Temperature B-Factor Flexibility Analysis
//
// Logline: Analyzes atomic temperature factors (Debye-Waller B-factors) to identify flexible loops, rigid core domains, and normalized Z-scores.
//
// Setup: Structural flexibility module computing mean isotropic displacement parameters <u^2> and per-residue stability metrics.
//
// Beats:
//   1. Define BFactorResidue and BFactorProfile data structures.
//   2. Calculate isotropic atomic mean-square displacement from B-factor: B = 8 * pi^2 * <u^2>.
//   3. Compute normalized B-factor Z-scores to pinpoint hyper-flexible catalytic loop regions.

pub type BFactorResidue = struct {
    res_num: Int,
    chain_id: String,
    ca_b_factor: Float,
    all_atom_mean_b: Float,
    z_score: Float,
    is_flexible_loop: Bool
};

pub type BFactorProfile = struct {
    num_residues: Int,
    mean_b_factor: Float,
    std_dev_b_factor: Float,
    min_b_factor: Float,
    max_b_factor: Float
};

pub fn bfactor_sqrt(val: Float) -> Float {
    if val <= 0.0 { return 0.0; }
    let mut guess = val / 2.0;
    if guess < 1.0 { guess = 1.0; }
    let mut iter: Int = 0;
    while iter < 8 {
        guess = 0.5 * (guess + (val / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn bfactor_to_mean_square_displacement(b: Float) -> Float {
    // B = 8 * pi^2 * <u^2> -> <u^2> = B / (8 * pi^2)
    // 8 * pi^2 ~ 78.956835
    let eight_pi_sq: Float = 78.956835;
    return b / eight_pi_sq;
}

pub fn bfactor_calculate_z_score(b_val: Float, mean: Float, std_dev: Float) -> Float {
    if std_dev <= 0.001 { return 0.0; }
    return (b_val - mean) / std_dev;
}

pub fn bfactor_evaluate_residue(
    res_num: Int,
    chain: String,
    ca_b: Float,
    mean: Float,
    std_dev: Float
) -> BFactorResidue {
    let z = bfactor_calculate_z_score(ca_b, mean, std_dev);
    // Residues with Z-score > 1.5 are characterized as flexible loop regions
    let is_flex = z > 1.5;

    return BFactorResidue {
        res_num: res_num,
        chain_id: chain,
        ca_b_factor: ca_b,
        all_atom_mean_b: ca_b,
        z_score: z,
        is_flexible_loop: is_flex
    };
}
