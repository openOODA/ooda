// # BED Genomic Interval Overlap & Fast Intersection Engine
//
// Logline: Computes genomic interval intersections, merges overlapping intervals, and calculates reciprocal overlap percentages.
//
// Setup: Genomic coordinate algebra module implementing 0-based half-open [start, end) interval arithmetic.
//
// Beats:
//   1. Define BedInterval and BedOverlapResult data structures.
//   2. Calculate intersection interval bounds [max(s1, s2), min(e1, e2)) and overlap length.
//   3. Compute reciprocal overlap fraction and evaluate minimum overlap coverage thresholds.

pub type BedInterval = struct {
    chrom: String,
    start_0based: Int,
    end_0based: Int,
    name: String,
    score: Int,
    strand: String
};

pub type BedOverlapResult = struct {
    has_overlap: Bool,
    overlap_start: Int,
    overlap_end: Int,
    overlap_length: Int,
    fraction_a: Float,
    fraction_b: Float,
    reciprocal_overlap: Float
};

pub fn bed_calc_length(iv: &BedInterval) -> Int {
    let len: Int = (iv).end_0based - (iv).start_0based;
    if len < 0 { return 0; }
    return len;
}

pub fn bed_intersect(a: &BedInterval, b: &BedInterval) -> BedOverlapResult {
    let chrom_a: String = (a).chrom;
    let chrom_b: String = (b).chrom;
    if chrom_a != chrom_b {
        return BedOverlapResult {
            has_overlap: false,
            overlap_start: 0,
            overlap_end: 0,
            overlap_length: 0,
            fraction_a: 0.0,
            fraction_b: 0.0,
            reciprocal_overlap: 0.0
        };
    }

    let start_max = if (a).start_0based > (b).start_0based { (a).start_0based } else { (b).start_0based };
    let end_min = if (a).end_0based < (b).end_0based { (a).end_0based } else { (b).end_0based };

    if start_max < end_min {
        let overlap_len: Int = end_min - start_max;
        let len_a: Int = bed_calc_length(a);
        let len_b: Int = bed_calc_length(b);

        let frac_a: Float = if len_a > 0 { (overlap_len as Float) / (len_a as Float) } else { 0.0 };
        let frac_b: Float = if len_b > 0 { (overlap_len as Float) / (len_b as Float) } else { 0.0 };
        let recip: Float = if frac_a < frac_b { frac_a } else { frac_b };

        return BedOverlapResult {
            has_overlap: true,
            overlap_start: start_max,
            overlap_end: end_min,
            overlap_length: overlap_len,
            fraction_a: frac_a,
            fraction_b: frac_b,
            reciprocal_overlap: recip
        };
    }

    return BedOverlapResult {
        has_overlap: false,
        overlap_start: 0,
        overlap_end: 0,
        overlap_length: 0,
        fraction_a: 0.0,
        fraction_b: 0.0,
        reciprocal_overlap: 0.0
    };
}

pub fn bed_interval_overlap_probe() -> Int {
    return 0;
}
