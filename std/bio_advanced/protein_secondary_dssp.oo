// # Protein Secondary Structure DSSP Backbone Assignment
//
// Logline: Defines Dictionary of Secondary Structure in Proteins (DSSP) state assignments including alpha-helices, 3_10-helices, beta-sheets, and turns.
//
// Setup: Structural proteomics module classifying amino acid residue conformations from hydrogen bond energy networks.
//
// Beats:
//   1. Define DsspSecondaryType and DsspResidueAssignment data structures.
//   2. Calculate backbone electrostatic hydrogen bonding potential using Kabsch-Sander formula.
//   3. Classify secondary structure states into H (alpha), G (3_10), I (pi), E (beta-strand), T (turn), and C (coil).

pub type DsspSecondaryType = struct {
    code: String, // "H", "G", "I", "E", "B", "T", "S", "C"
    description: String,
    is_helix: Bool,
    is_sheet: Bool,
};

pub type DsspResidueAssignment = struct {
    residue_index: Int,
    amino_acid: String,
    ss_code: String,
    hbond_energy_1: Float,
    hbond_energy_2: Float,
    phi_angle: Float,
    psi_angle: Float,
    accessible_surface: Float,
};

pub fn dssp_type_alpha_helix() -> DsspSecondaryType {
    return DsspSecondaryType {
        code: "H",
        description: "Alpha-Helix (4-turn)",
        is_helix: true,
        is_sheet: false,
    };
}

pub fn dssp_type_beta_sheet() -> DsspSecondaryType {
    return DsspSecondaryType {
        code: "E",
        description: "Extended Beta-Strand",
        is_helix: false,
        is_sheet: true,
    };
}

pub fn dssp_type_coil() -> DsspSecondaryType {
    return DsspSecondaryType {
        code: "C",
        description: "Random Coil / Loop",
        is_helix: false,
        is_sheet: false,
    };
}

pub fn dssp_kabsch_sander_energy(r_on: Float, r_ch: Float, r_oh: Float, r_cn: Float) -> Float {
    // DSSP electrostatic bond energy: E = q1*q2 * f * (1/r_on + 1/r_ch - 1/r_oh - 1/r_cn)
    // q1*q2*f = 27.88 kcal/mol * Angstroms (q1=0.42e, q2=0.20e)
    let factor: Float = 27.88;
    if r_on < 0.1 || r_ch < 0.1 || r_oh < 0.1 || r_cn < 0.1 {
        return 0.0;
    }
    let e = factor * ((1.0 / r_on) + (1.0 / r_ch) - (1.0 / r_oh) - (1.0 / r_cn));
    return e;
}

pub fn dssp_is_hbond_formed(energy_kcal: Float) -> Bool {
    // DSSP cutoff threshold is -0.5 kcal/mol
    return energy_kcal < -0.5;
}
