pub fn bio_shim_crispr_offtarget(guide: String, target: String) -> OffTargetMatch {
    return crispr_score_offtarget(guide, target);
}

pub fn bio_shim_crispr_efficiency(spacer: String) -> EfficiencyMetrics {
    return crispr_calc_efficiency(spacer);
}

pub fn bio_shim_cas12a_cleavage(pam_start: Int, target: String) -> Cas12aCleavageProduct {
    return cas12a_compute_cleavage(pam_start, target);
}

pub fn bio_shim_prime_design(spacer: String, pbs: String, rtt: String, pos: Int) -> PegRnaDesign {
    return prime_score_design(spacer, pbs, rtt, pos);
}

pub fn bio_shim_base_edit_cbe(spacer: String) -> BaseEditWindowResult {
    let ed = base_editor_cbe_default();
    return base_edit_evaluate_window(spacer, &ed);
}

pub fn bio_shim_dssp_hbond(r_on: Float, r_ch: Float, r_oh: Float, r_cn: Float) -> Float {
    return dssp_kabsch_sander_energy(r_on, r_ch, r_oh, r_cn);
}

pub fn bio_shim_ramachandran(phi: Float, psi: Float) -> RamachandranRegion {
    return rama_classify_general(phi, psi);
}

pub fn bio_shim_protein_contact(i: Int, j: Int, dist: Float, cutoff: Float) -> ResiduePairContact {
    return contact_evaluate_pair(i, j, dist, cutoff);
}

pub fn bio_shim_hydropathy_scan(seq: String, window: Int) -> HydropathyProfile {
    return kd_scan_profile(seq, window);
}

pub fn bio_shim_isoelectric_point(seq: String) -> Float {
    return pi_find_isoelectric_point(seq);
}

pub fn bio_shim_mass_spec_peptide(pep: String, start_p: Int, end_p: Int, missed: Int) -> DigestPeptide {
    return mass_spec_compute_peptide(pep, start_p, end_p, missed);
}

pub fn bio_shim_gotoh_align(seq1: String, seq2: String) -> GotohAlignmentResult {
    let p = gotoh_params_default();
    return gotoh_align_simple(seq1, seq2, &p);
}

pub fn bio_shim_entropy_column(count_a: Int, count_c: Int, count_g: Int, count_t: Int, col_idx: Int) -> ColumnEntropy {
    return entropy_calc_column_dna(count_a, count_c, count_g, count_t, col_idx);
}

pub fn bio_shim_viterbi_init(seq_len: Int) -> ViterbiResult {
    return viterbi_init(seq_len);
}

pub fn bio_shim_upgma_leaf(id: Int, name: String) -> UpgmaNode {
    return upgma_leaf_node(id, name);
}

pub fn bio_shim_nj_q_score(d_ij: Float, sum_i: Float, sum_j: Float, n_taxa: Int) -> Float {
    return nj_calc_q_score(d_ij, sum_i, sum_j, n_taxa);
}

pub fn bio_shim_snv_call(chr: String, pos: Int, ref_b: String, alt_b: String, ref_cnt: Int, alt_cnt: Int) -> SnvCallResult {
    return snv_call_from_counts(chr, pos, ref_b, alt_b, ref_cnt, alt_cnt);
}

pub fn bio_shim_vep_classify(ref_aa: String, alt_aa: String, ref_cod: String, alt_cod: String) -> VariantConsequence {
    return vep_classify_amino_acid_change(ref_aa, alt_aa, ref_cod, alt_cod);
}

pub fn bio_shim_tstv_ratio(ti: Int, tv: Int) -> TsTvRatioResult {
    return tstv_calc_ratio(ti, tv);
}

pub fn bio_shim_rna_hairpin_gc(arm: String) -> Float {
    return rna_hairpin_calc_gc(arm);
}

pub fn bio_shim_bed_overlap(a: &BedInterval, b: &BedInterval) -> BedOverlapResult {
    return bed_intersect(a, b);
}

pub fn bio_shim_cigar_span(start_1based: Int, ops: List[CigarOp]) -> CigarAlignmentSpan {
    return cigar_evaluate_span(start_1based, ops);
}
