// # RNA Riboswitch Aptamer Free Energy & Conformational Switch
//
// Logline: Models ligand-induced free energy shifts between unliganded ON-state and ligand-bound OFF-state riboswitch conformers.
//
// Setup: Riboswitch biophysics module calculating ligand binding equilibria and free energy deltas delta_delta_G.
//
// Beats:
//   1. Define RiboswitchConformation and SwitchEquilibrium data structures.
//   2. Calculate binding free energy delta_G_bind = -RT * ln(1 / K_d) from dissociation constant K_d.
//   3. Compute population fractions for ON vs OFF states as a function of ligand concentration.

pub type RiboswitchConformation = struct {
    state_name: String, // "ON-state", "OFF-state"
    mfe_free_energy: Float,
    is_ligand_bound: Bool,
    expression_active: Bool
};

pub type SwitchEquilibrium = struct {
    dissociation_constant_um: Float,
    ligand_concentration_um: Float,
    fraction_bound: Float,
    fraction_unbound: Float,
    switching_ratio: Float
};

pub fn riboswitch_calc_binding_energy(kd_micromolar: Float) -> Float {
    if kd_micromolar <= 0.0001 { return -15.0; }
    // Delta_G = RT * ln(Kd_Molar) = 0.61633 * ln(Kd_uM * 1e-6)
    // Basic approximation for typical 1 uM Kd -> ~ -8.5 kcal/mol
    let mut dg: Float = -8.50;
    if kd_micromolar < 1.0 {
        dg = dg - 1.40;
    } else if kd_micromolar > 10.0 {
        dg = dg + 1.40;
    }
    return dg;
}

pub fn riboswitch_calc_fraction_bound(ligand_conc_um: Float, kd_um: Float) -> SwitchEquilibrium {
    let denom = ligand_conc_um + kd_um;
    let frac_bound = if denom > 0.0 { ligand_conc_um / denom } else { 0.0 };
    let frac_unbound = 1.0 - frac_bound;
    let ratio = if frac_unbound > 0.0 { frac_bound / frac_unbound } else { 100.0 };

    return SwitchEquilibrium {
        dissociation_constant_um: kd_um,
        ligand_concentration_um: ligand_conc_um,
        fraction_bound: frac_bound,
        fraction_unbound: frac_unbound,
        switching_ratio: ratio
    };
}
