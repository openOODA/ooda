// # CRISPR Cas9 Off-Target Mismatch Calculator
//
// Logline: Evaluates Cas9 guide RNA sequence mismatches against potential genomic off-target sites using Hsu-Zhang position-weighted scoring.
//
// Setup: CRISPR genome engineering module computing off-target cleavage probabilities across target loci.
//
// Beats:
//   1. Define OffTargetMatch and OffTargetScore data structures.
//   2. Calculate position-weighted mismatch penalties according to the Hsu-Zhang matrix.
//   3. Aggregate cumulative off-target cutting frequencies and cleavage risk tiers.

pub type OffTargetMatch = struct {
    guide_seq: String,
    target_seq: String,
    mismatch_count: Int,
    seed_mismatches: Int,
    score: Float,
    is_cutting_risk: Bool
};

pub type OffTargetScore = struct {
    total_sites: Int,
    high_risk_sites: Int,
    composite_specificity: Float
};

pub fn crispr_hsu_weight(pos_from_pam: Int) -> Float {
    if pos_from_pam == 1 { return 0.0; }
    if pos_from_pam == 2 { return 0.0; }
    if pos_from_pam == 3 { return 0.014; }
    if pos_from_pam == 4 { return 0.0; }
    if pos_from_pam == 5 { return 0.0; }
    if pos_from_pam == 6 { return 0.395; }
    if pos_from_pam == 7 { return 0.317; }
    if pos_from_pam == 8 { return 0.0; }
    if pos_from_pam == 9 { return 0.389; }
    if pos_from_pam == 10 { return 0.079; }
    if pos_from_pam == 11 { return 0.445; }
    if pos_from_pam == 12 { return 0.508; }
    if pos_from_pam == 13 { return 0.613; }
    if pos_from_pam == 14 { return 0.851; }
    if pos_from_pam == 15 { return 0.732; }
    if pos_from_pam == 16 { return 0.828; }
    if pos_from_pam == 17 { return 0.615; }
    if pos_from_pam == 18 { return 0.804; }
    if pos_from_pam == 19 { return 0.685; }
    if pos_from_pam == 20 { return 0.669; }
    return 1.0;
}

pub fn crispr_score_offtarget(guide: String, target: String) -> OffTargetMatch {
    let g_len = chars_len(guide);
    let t_len = chars_len(target);
    let min_len = if g_len < t_len { g_len } else { t_len };

    let mut mismatches = 0;
    let mut seed_mismatches = 0;
    let mut weight_product: Float = 1.0;

    let mut i = 0;
    while i < min_len {
        let cg = char_at(guide, i);
        let ct = char_at(target, i);
        if cg != ct {
            mismatches = mismatches + 1;
            let pos_from_pam = min_len - i;
            if pos_from_pam <= 8 {
                seed_mismatches = seed_mismatches + 1;
            }
            let w = crispr_hsu_weight(pos_from_pam);
            weight_product = weight_product * (1.0 - w);
        }
        i = i + 1;
    }

    let final_score = if mismatches == 0 { 100.0 } else { weight_product * 100.0 };
    let high_risk = final_score > 20.0 && seed_mismatches <= 1;

    return OffTargetMatch {
        guide_seq: guide,
        target_seq: target,
        mismatch_count: mismatches,
        seed_mismatches: seed_mismatches,
        score: final_score,
        is_cutting_risk: high_risk
    };
}
