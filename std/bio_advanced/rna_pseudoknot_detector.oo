// # RNA Pseudoknot & Crossing Base-Pair Topology Finder
//
// Logline: Identifies non-nested crossing base pairs (i < j < k < l with i-k and j-l pairings) forming H-type and classical pseudoknots.
//
// Setup: Advanced RNA structural biology module analyzing topological crossing numbers and knot complexity.
//
// Beats:
//   1. Define BasePair and PseudoknotCluster data structures.
//   2. Test pairs (i, k) and (j, l) for crossing topology: i < j < k < l.
//   3. Group mutually crossing stem arcs into coherent H-type pseudoknot structural domains.

pub type BasePair = struct {
    pos_5p: Int,
    pos_3p: Int,
    is_canonical: Bool
};

pub type PseudoknotCluster = struct {
    stem1_start: Int,
    stem1_end: Int,
    stem2_start: Int,
    stem2_end: Int,
    crossing_pairs_count: Int,
    has_h_type_knot: Bool
};

pub fn rna_pairs_cross(p1_5p: Int, p1_3p: Int, p2_5p: Int, p2_3p: Int) -> Bool {
    // Condition for crossing: p1_5p < p2_5p < p1_3p < p2_3p  OR  p2_5p < p1_5p < p2_3p < p1_3p
    let case1 = (p1_5p < p2_5p) && (p2_5p < p1_3p) && (p1_3p < p2_3p);
    let case2 = (p2_5p < p1_5p) && (p1_5p < p2_3p) && (p2_3p < p1_3p);
    return case1 || case2;
}

pub fn rna_count_crossing_arcs(pairs: List[BasePair]) -> Int {
    let n = list_len(pairs);
    let mut crossings: Int = 0;

    let mut i: Int = 0;
    while i < n {
        let p_i = list_get(pairs, i);
        let mut j: Int = i + 1;
        while j < n {
            let p_j = list_get(pairs, j);
            if rna_pairs_cross((p_i).pos_5p, (p_i).pos_3p, (p_j).pos_5p, (p_j).pos_3p) {
                crossings = crossings + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return crossings;
}
