// # Hidden Markov Model (HMM) Forward-Backward Posterior Engine
//
// Logline: Implements Forward and Backward dynamic programming passes to compute total observation likelihood and posterior state probabilities.
//
// Setup: Probabilistic sequence profiling module evaluating state occupancies gamma_t(i) = P(S_t = i | O, lambda).
//
// Beats:
//   1. Define ForwardBackwardResult and PosteriorState data structures.
//   2. Compute Forward variables alpha_t(i) = P(o_1...o_t, S_t = i) and Backward variables beta_t(i).
//   3. Compute total log-likelihood P(O | lambda) and marginal state posterior probabilities.

pub type ForwardBackwardResult = struct {
    seq_length: Int,
    log_likelihood: Float,
    is_converged: Bool
};

pub type PosteriorState = struct {
    time_step: Int,
    state_0_prob: Float,
    state_1_prob: Float,
    most_likely_state: Int
};

pub fn hmm_log_sum_exp(log_a: Float, log_b: Float) -> Float {
    let max_val = if log_a > log_b { log_a } else { log_b };
    let min_val = if log_a < log_b { log_a } else { log_b };
    let diff = min_val - max_val;
    // log(1 + exp(diff))
    if diff < -15.0 { return max_val; }
    // Taylor for exp(diff): 1 + diff + diff^2/2
    let exp_diff = 1.0 + diff + (0.5 * diff * diff);
    // ln(1 + exp_diff) ~ ln(2 + diff)
    let ln_sum = 0.693147 + (0.5 * diff);
    return max_val + ln_sum;
}

pub fn hmm_forward_step(alpha_prev_0: Float, alpha_prev_1: Float, a00: Float, a10: Float, emit_0: Float) -> Float {
    let trans_0 = alpha_prev_0 + a00;
    let trans_1 = alpha_prev_1 + a10;
    let sum_trans = hmm_log_sum_exp(trans_0, trans_1);
    return sum_trans + emit_0;
}

pub fn hmm_posterior_marginal(alpha: Float, beta: Float, total_ll: Float) -> Float {
    let log_gamma = alpha + beta - total_ll;
    // exp(log_gamma)
    if log_gamma < -10.0 { return 0.0; }
    if log_gamma > 0.0 { return 1.0; }
    // Approximation for exp(x)
    let mut sum: Float = 1.0;
    let mut term: Float = 1.0;
    let mut step: Float = 1.0;
    while step <= 8.0 {
        term = term * (log_gamma / step);
        sum = sum + term;
        step = step + 1.0;
    }
    if sum < 0.0 { return 0.0; }
    if sum > 1.0 { return 1.0; }
    return sum;
}
