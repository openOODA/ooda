// # GFF3 Hierarchical Feature Tree & Parent-Child Relationships
//
// Logline: Organizes GFF3 genomic annotations into hierarchical parent-child trees (gene -> mRNA/transcript -> exon / CDS).
//
// Setup: Genomic annotation module parsing GFF3 attribute tags (ID=..., Parent=...) and structural hierarchies.
//
// Beats:
//   1. Define Gff3FeatureNode and Gff3FeatureTree data structures.
//   2. Link child transcript, exon, and CDS records to parent gene identifiers.
//   3. Compute spliced transcript lengths and total coding sequence (CDS) coordinates.

pub type Gff3FeatureNode = struct {
    id: String,
    parent_id: String,
    seqid: String,
    feature_type: String, // "gene", "mRNA", "exon", "CDS", "five_prime_UTR"
    start_pos: Int,
    end_pos: Int,
    strand: String, // "+", "-", "."
    phase: Int // 0, 1, 2, or -1
};

pub type Gff3TranscriptModel = struct {
    transcript_id: String,
    gene_id: String,
    num_exons: Int,
    spliced_length: Int,
    cds_length: Int
};

pub fn gff3_calc_feature_length(start: Int, end: Int) -> Int {
    if end < start { return 0; }
    return (end - start) + 1;
}

pub fn gff3_is_coding(type_name: String) -> Bool {
    return type_name == "CDS";
}

pub fn gff3_create_transcript_model(
    t_id: String,
    g_id: String,
    exons_count: Int,
    tot_spliced: Int,
    tot_cds: Int
) -> Gff3TranscriptModel {
    return Gff3TranscriptModel {
        transcript_id: t_id,
        gene_id: g_id,
        num_exons: exons_count,
        spliced_length: tot_spliced,
        cds_length: tot_cds
    };
}
