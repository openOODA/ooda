// # STRIDE Protein Secondary Structure & Hydrogen Bond Energy Engine
//
// Logline: Combines backbone dihedral angle statistical potentials with hydrogen bond dipole-dipole energy to assign secondary structure.
//
// Setup: Structural biology secondary structure classifier implementing the STRIDE algorithm framework.
//
// Beats:
//   1. Define StrideAssignment and StrideEnergyThresholds data structures.
//   2. Calculate combined dihedral angle conformational probability and hydrogen bond dipole energy.
//   3. Assign alpha-helix (H), 3_10-helix (G), pi-helix (I), beta-sheet (E), and turn (T) states.

pub type StrideAssignment = struct {
    res_num: Int,
    amino_acid: String,
    stride_state: String, // "H", "G", "I", "E", "T", "C"
    hbond_energy_kcal: Float,
    phi_psi_propensity: Float,
    is_helix: Bool,
    is_strand: Bool
};

pub type StrideEnergyThresholds = struct {
    helix_energy_cutoff: Float, // Typically -0.5 kcal/mol
    sheet_energy_cutoff: Float, // Typically -0.7 kcal/mol
    turn_energy_cutoff: Float  // Typically -0.4 kcal/mol
};

pub fn stride_thresholds_default() -> StrideEnergyThresholds {
    return StrideEnergyThresholds {
        helix_energy_cutoff: -0.50,
        sheet_energy_cutoff: -0.70,
        turn_energy_cutoff: -0.40
    };
}

pub fn stride_hbond_energy(dist_oh: Float, angle_nho_deg: Float) -> Float {
    if dist_oh < 0.1 || dist_oh > 4.0 { return 0.0; }
    // STRIDE empirical formula based on distance and alignment angle
    let e_dist: Float = -2.0 / (dist_oh * dist_oh);
    let angle_factor: Float = if angle_nho_deg >= 120.0 { 1.0 } else { 0.5 };
    return e_dist * angle_factor;
}

pub fn stride_classify_residue(
    res_num: Int,
    aa: String,
    phi: Float,
    psi: Float,
    hb_energy: Float
) -> StrideAssignment {
    let mut state = "C";
    let mut is_h = false;
    let mut is_e = false;

    // Check helical propensity & H-bonding
    if phi >= -100.0 && phi <= -30.0 && psi >= -70.0 && psi <= -10.0 && hb_energy < -0.50 {
        state = "H";
        is_h = true;
    } else if phi >= -160.0 && phi <= -70.0 && (psi >= 90.0 || psi <= -160.0) && hb_energy < -0.70 {
        state = "E";
        is_e = true;
    } else if hb_energy < -0.40 {
        state = "T";
    }

    return StrideAssignment {
        res_num: res_num,
        amino_acid: aa,
        stride_state: state,
        hbond_energy_kcal: hb_energy,
        phi_psi_propensity: 1.0,
        is_helix: is_h,
        is_strand: is_e
    };
}
