// # Fitch-Hartigan Parsimony State Reconstruction
//
// Logline: Reconstructs ancestral character states at internal nodes via bottom-up set intersection and top-down disambiguation.
//
// Setup: Ancestral sequence reconstruction module computing minimum mutation assignments on trees.
//
// Beats:
//   1. Define FitchNodeState and AncestralReconstruction data structures.
//   2. Compute bottom-up pass: set intersection S_p = S_l ^ S_r (if non-empty) else set union S_p = S_l v S_r with cost + 1.
//   3. Execute top-down pass to resolve polymorphic ancestral state ties.

pub type FitchNodeState = struct {
    node_id: Int,
    possible_states_mask: Int, // Bitmask: 1=A, 2=C, 4=G, 8=T
    assigned_state: String,
    cost_accumulated: Int
};

pub type AncestralReconstruction = struct {
    root_node_id: Int,
    total_mutations: Int,
    root_state: String
};

pub fn fitch_char_to_mask(c: String) -> Int {
    if c == "A" || c == "a" { return 1; }
    if c == "C" || c == "c" { return 2; }
    if c == "G" || c == "g" { return 4; }
    if c == "T" || c == "t" { return 8; }
    return 15; // Any
}

pub fn fitch_mask_to_char(mask: Int) -> String {
    if mask == 1 { return "A"; }
    if mask == 2 { return "C"; }
    if mask == 4 { return "G"; }
    if mask == 8 { return "T"; }
    return "N";
}

pub fn fitch_bottom_up_step(mask_left: Int, mask_right: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    // Bitwise intersection
    let inter = mask_left & mask_right;
    if inter != 0 {
        list_push(res, inter);
        list_push(res, 0); // No extra mutation cost
    } else {
        let union_mask = mask_left | mask_right;
        list_push(res, union_mask);
        list_push(res, 1); // +1 mutation cost
    }
    return res;
}
