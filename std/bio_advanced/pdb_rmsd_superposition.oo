// # PDB Protein Structure RMSD & Kabsch Superposition
//
// Logline: Calculates Root-Mean-Square Deviation (RMSD) between protein 3D structures and computes center-of-mass translation vectors.
//
// Setup: Structural alignment engine comparing atomic coordinate ensembles and evaluating structural homology.
//
// Beats:
//   1. Define CoordinateEnsemble and RmsdResult data structures.
//   2. Compute geometric centroids and translate structures to common origins.
//   3. Calculate C-alpha and all-atom RMSD values in Angstrom units.

pub type Coord3D = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub type RmsdResult = struct {
    num_atoms: Int,
    centroid_a: Coord3D,
    centroid_b: Coord3D,
    rmsd_angstrom: Float,
    is_identical: Bool,
};

pub fn rmsd_sqrt(val: Float) -> Float {
    if val <= 0.0 { return 0.0; }
    let mut guess = val / 2.0;
    if guess < 1.0 { guess = 1.0; }
    let mut iter: Int = 0;
    while iter < 10 {
        guess = 0.5 * (guess + (val / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn rmsd_compute_centroid(coords: List[Coord3D]) -> Coord3D {
    let n = list_len(coords);
    if n == 0 {
        return Coord3D { x: 0.0, y: 0.0, z: 0.0 };
    }
    let mut sum_x: Float = 0.0;
    let mut sum_y: Float = 0.0;
    let mut sum_z: Float = 0.0;

    let mut idx: Int = 0;
    while idx < n {
        let pt = list_get(coords, idx);
        sum_x = sum_x + (pt).x;
        sum_y = sum_y + (pt).y;
        sum_z = sum_z + (pt).z;
        idx = idx + 1;
    }

    let n_f = n as Float;
    return Coord3D {
        x: sum_x / n_f,
        y: sum_y / n_f,
        z: sum_z / n_f,
    };
}

pub fn rmsd_calc_aligned(set_a: List[Coord3D], set_b: List[Coord3D]) -> RmsdResult {
    let na = list_len(set_a);
    let nb = list_len(set_b);
    let n = if na < nb { na } else { nb };

    let c_a = rmsd_compute_centroid(set_a);
    let c_b = rmsd_compute_centroid(set_b);

    if n == 0 {
        return RmsdResult {
            num_atoms: 0,
            centroid_a: c_a,
            centroid_b: c_b,
            rmsd_angstrom: 0.0,
            is_identical: false,
        };
    }

    let mut sum_sq: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let pa = list_get(set_a, i);
        let pb = list_get(set_b, i);
        // Centered coordinates
        let dax = (pa).x - (c_a).x;
        let day = (pa).y - (c_a).y;
        let daz = (pa).z - (c_a).z;

        let dbx = (pb).x - (c_b).x;
        let dby = (pb).y - (c_b).y;
        let dbz = (pb).z - (c_b).z;

        let dx = dax - dbx;
        let dy = day - dby;
        let dz = daz - dbz;

        sum_sq = sum_sq + ((dx * dx) + (dy * dy) + (dz * dz));
        i = i + 1;
    }

    let mean_sq = sum_sq / (n as Float);
    let rmsd_val = rmsd_sqrt(mean_sq);

    return RmsdResult {
        num_atoms: n,
        centroid_a: c_a,
        centroid_b: c_b,
        rmsd_angstrom: rmsd_val,
        is_identical: rmsd_val < 0.001,
    };
}
