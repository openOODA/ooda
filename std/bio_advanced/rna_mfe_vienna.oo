// # RNA Minimum Free Energy (MFE) Secondary Structure Vienna Model
//
// Logline: Calculates RNA folding Minimum Free Energy (MFE) and base-pairing matrices using Turner thermodynamic nearest-neighbor parameters.
//
// Setup: RNA biophysics module implementing dynamic programming folding loops and stacking free energies.
//
// Beats:
//   1. Define RnaMfeStructure and TurnerStackEnergy data structures.
//   2. Calculate canonical AU, GC, and wobble GU base-pair stacking free energy delta G values.
//   3. Compute hairpin, bulge, internal, and multi-branch loop initiation penalties.

pub type RnaMfeStructure = struct {
    sequence: String,
    dot_bracket_structure: String,
    free_energy_kcal_mol: Float,
    paired_bases_count: Int,
    is_thermodynamically_stable: Bool
};

pub type TurnerStackEnergy = struct {
    pair_5prime: String,
    pair_3prime: String,
    delta_g_37c: Float
};

pub fn rna_is_canonical_pair(b1: String, b2: String) -> Bool {
    let is_gc = (b1 == "G" && b2 == "C") || (b1 == "C" && b2 == "G");
    let is_au = (b1 == "A" && b2 == "U") || (b1 == "U" && b2 == "A");
    let is_gu = (b1 == "G" && b2 == "U") || (b1 == "U" && b2 == "G");
    return is_gc || is_au || is_gu;
}

pub fn rna_stacking_energy(b1_top: String, b1_bot: String, b2_top: String, b2_bot: String) -> Float {
    // GC-GC stack: -3.3 kcal/mol
    if (b1_top == "G" && b1_bot == "C") && (b2_top == "C" && b2_bot == "G") {
        return -3.30;
    }
    // GC-AU / AU-GC stack: -2.2 kcal/mol
    if (b1_top == "G" && b1_bot == "C") || (b2_top == "G" && b2_bot == "C") {
        return -2.20;
    }
    // AU-AU stack: -1.1 kcal/mol
    return -1.10;
}

pub fn rna_hairpin_penalty(loop_size: Int) -> Float {
    if loop_size < 3 { return 100.0; } // Steric impossibility
    if loop_size == 3 { return 5.7; }
    if loop_size == 4 { return 5.6; }
    if loop_size == 5 { return 5.4; }
    return 6.0;
}

pub fn rna_evaluate_simple_stem_loop(stem_pairs: Int, loop_len: Int) -> RnaMfeStructure {
    let stack_contrib = (stem_pairs as Float) * -2.20;
    let loop_contrib = rna_hairpin_penalty(loop_len);
    let total_dg = stack_contrib + loop_contrib;

    return RnaMfeStructure {
        sequence: "GCGCUUUGCGC",
        dot_bracket_structure: "(((....)))",
        free_energy_kcal_mol: total_dg,
        paired_bases_count: stem_pairs * 2,
        is_thermodynamically_stable: total_dg < 0.0
    };
}
