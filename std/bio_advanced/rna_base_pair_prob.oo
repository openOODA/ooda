// # RNA McCaskill Base-Pairing Equilibrium Ensemble Matrix
//
// Logline: Calculates thermodynamic partition functions Q and equilibrium base-pairing probabilities p_ij using the McCaskill algorithm.
//
// Setup: RNA structural ensemble module evaluating Boltzmann-weighted conformational distributions.
//
// Beats:
//   1. Define BasePairProbability and EnsemblePartition data structures.
//   2. Compute Boltzmann factors w = exp(-delta_G / RT) at 37°C (RT = 0.6163 kcal/mol).
//   3. Generate dot-plot probability matrices representing structural ensemble fluidity.

pub type BasePairProbability = struct {
    base_i: Int,
    base_j: Int,
    probability: Float,
    is_high_probability_stem: Bool
};

pub type EnsemblePartition = struct {
    total_partition_q: Float,
    ensemble_free_energy_kcal: Float,
    sequence_length: Int
};

pub fn rna_rt_factor_37c() -> Float {
    // R * T at 310.15 K in kcal/mol: 1.9872e-3 * 310.15 = 0.61633
    return 0.61633;
}

pub fn rna_boltzmann_weight(delta_g_kcal: Float) -> Float {
    let exponent = (0.0 - delta_g_kcal) / rna_rt_factor_37c();
    if exponent > 20.0 { return 485165195.0; }
    if exponent < -20.0 { return 0.0; }

    // Taylor approximation for exp(x)
    let mut sum: Float = 1.0;
    let mut term: Float = 1.0;
    let mut step: Float = 1.0;
    while step <= 12.0 {
        term = term * (exponent / step);
        sum = sum + term;
        step = step + 1.0;
    }
    if sum < 0.0 { return 0.0; }
    return sum;
}

pub fn rna_calc_pair_prob(q_ij_inside: Float, q_ij_outside: Float, q_total: Float) -> BasePairProbability {
    let prob = if q_total > 0.0 {
        (q_ij_inside * q_ij_outside) / q_total
    } else {
        0.0
    };

    let p_clamped = if prob > 1.0 { 1.0 } else { prob };

    return BasePairProbability {
        base_i: 0,
        base_j: 0,
        probability: p_clamped,
        is_high_probability_stem: p_clamped >= 0.80
    };
}
