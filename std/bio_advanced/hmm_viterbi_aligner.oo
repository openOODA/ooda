// # Hidden Markov Model (HMM) Viterbi Path Decoder
//
// Logline: Decodes the most probable hidden state path (e.g. CpG islands, exon/intron, secondary structure) using dynamic programming.
//
// Setup: Probabilistic sequence modeling module determining maximum likelihood state sequences.
//
// Beats:
//   1. Define HmmModel and ViterbiResult data structures.
//   2. Compute log-space transition and emission probability recursions: V_t(j) = max_i(V_{t-1}(i) + log(A_ij)) + log(E_j(x_t)).
//   3. Trace back optimal state path and return total log-likelihood score.

pub type HmmModel = struct {
    num_states: Int,
    num_emissions: Int,
    model_name: String
};

pub type ViterbiResult = struct {
    sequence_len: Int,
    best_path: List[Int],
    log_likelihood: Float,
    is_valid: Bool
};

pub fn viterbi_init(seq_len: Int) -> ViterbiResult {
    let mut path: List[Int] = list_new();
    let mut i: Int = 0;
    while i < seq_len {
        list_push(path, 0);
        i = i + 1;
    }

    return ViterbiResult {
        sequence_len: seq_len,
        best_path: path,
        log_likelihood: 0.0,
        is_valid: true
    };
}

pub fn viterbi_step_update(
    prev_viterbi: Float,
    log_trans: Float,
    log_emission: Float
) -> Float {
    return prev_viterbi + log_trans + log_emission;
}

pub fn viterbi_decode_two_state(
    seq: String,
    log_init_0: Float,
    log_init_1: Float,
    log_trans_00: Float,
    log_trans_01: Float,
    log_trans_10: Float,
    log_trans_11: Float
) -> ViterbiResult {
    let n = chars_len(seq);
    let mut path: List[Int] = list_new();

    let mut v0: Float = log_init_0;
    let mut v1: Float = log_init_1;

    let mut t: Int = 0;
    while t < n {
        // Evaluate transitions
        let from_0_to_0 = v0 + log_trans_00;
        let from_1_to_0 = v1 + log_trans_10;
        let next_v0 = if from_0_to_0 > from_1_to_0 { from_0_to_0 } else { from_1_to_0 };

        let from_0_to_1 = v0 + log_trans_01;
        let from_1_to_1 = v1 + log_trans_11;
        let next_v1 = if from_0_to_1 > from_1_to_1 { from_0_to_1 } else { from_1_to_1 };

        let best_state = if next_v0 > next_v1 { 0 } else { 1 };
        list_push(path, best_state);

        v0 = next_v0;
        v1 = next_v1;
        t = t + 1;
    }

    let final_ll = if v0 > v1 { v0 } else { v1 };

    return ViterbiResult {
        sequence_len: n,
        best_path: path,
        log_likelihood: final_ll,
        is_valid: n > 0
    };
}
