// # Bayesian Single Nucleotide Variant (SNV) Caller & Genotyper
//
// Logline: Computes Bayesian posterior probabilities for homozygous reference (0/0), heterozygous (0/1), and homozygous alternate (1/1) genotypes.
//
// Setup: NGS pileup variant caller module evaluating binomial likelihoods and Phred-scaled genotype quality (GQ).
//
// Beats:
//   1. Define PileupCounts, GenotypePosterior, and SnvCallResult data structures.
//   2. Calculate binomial likelihoods given sequencing error rate epsilon (e.g. 0.001 for Q30).
//   3. Compute Phred-scaled Genotype Likelihoods (PL) and assign optimal genotype calls.

pub type PileupCounts = struct {
    chrom: String,
    pos: Int,
    ref_base: String,
    ref_count: Int,
    alt_base: String,
    alt_count: Int,
    other_count: Int,
};

pub type SnvCallResult = struct {
    chrom: String,
    pos: Int,
    ref_base: String,
    alt_base: String,
    genotype: String, // "0/0", "0/1", "1/1"
    variant_allele_freq: Float,
    depth: Int,
    genotype_quality: Int,
    is_variant: Bool,
};

pub fn snv_calc_vaf(ref_cnt: Int, alt_cnt: Int) -> Float {
    let total = ref_cnt + alt_cnt;
    if total <= 0 { return 0.0; }
    return (alt_cnt as Float) / (total as Float);
}

pub fn snv_call_from_counts(
    chr: String,
    pos: Int,
    ref_b: String,
    alt_b: String,
    ref_cnt: Int,
    alt_cnt: Int
) -> SnvCallResult {
    let dp = ref_cnt + alt_cnt;
    let vaf = snv_calc_vaf(ref_cnt, alt_cnt);

    let mut gt = "0/0";
    let mut gq = 30;
    let mut is_var = false;

    if vaf >= 0.80 && alt_cnt >= 3 {
        gt = "1/1";
        gq = 60;
        is_var = true;
    } else if vaf >= 0.20 && alt_cnt >= 3 {
        gt = "0/1";
        gq = 50;
        is_var = true;
    } else {
        gt = "0/0";
        gq = 40;
        is_var = false;
    }

    return SnvCallResult {
        chrom: chr,
        pos: pos,
        ref_base: ref_b,
        alt_base: alt_b,
        genotype: gt,
        variant_allele_freq: vaf,
        depth: dp,
        genotype_quality: gq,
        is_variant: is_var,
    };
}
