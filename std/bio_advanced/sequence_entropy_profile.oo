// # Sequence Information Entropy & Positional Conservation Profile
//
// Logline: Calculates Shannon information entropy H(X) = -sum(p * log2(p)) and Schneider sequence conservation across multiple alignments.
//
// Setup: Sequence conservation module quantifying column diversity and consensus binding motif information content.
//
// Beats:
//   1. Define ColumnEntropy and SequenceEntropySummary data structures.
//   2. Compute base / amino acid frequencies and logarithmic Shannon entropy values.
//   3. Compute information content in bits R_seq = 2 - (H + e_n) for DNA logos.

pub type ColumnEntropy = struct {
    column_index: Int,
    entropy_bits: Float,
    information_content_bits: Float,
    consensus_char: String,
    is_highly_conserved: Bool,
};

pub type SequenceEntropySummary = struct {
    total_columns: Int,
    mean_entropy: Float,
    mean_information_content: Float,
    conserved_columns_count: Int,
};

pub fn entropy_log2(p: Float) -> Float {
    if p <= 0.0001 { return -13.2877; } // log2(0.0001)
    if p >= 0.9999 { return 0.0; }
    // Natural log approximation ln(p) / 0.693147
    // ln(p) for p in (0, 1] using (p-1) - (p-1)^2/2 + (p-1)^3/3
    let z = p - 1.0;
    let ln_p = z - (0.5 * z * z) + (0.333333 * z * z * z) - (0.25 * z * z * z * z);
    return ln_p / 0.69314718;
}

pub fn entropy_calc_column_dna(count_a: Int, count_c: Int, count_g: Int, count_t: Int, col_idx: Int) -> ColumnEntropy {
    let total = count_a + count_c + count_g + count_t;
    if total <= 0 {
        return ColumnEntropy {
            column_index: col_idx,
            entropy_bits: 0.0,
            information_content_bits: 0.0,
            consensus_char: "-",
            is_highly_conserved: false,
        };
    }

    let tot_f = total as Float;
    let pa = (count_a as Float) / tot_f;
    let pc = (count_c as Float) / tot_f;
    let pg = (count_g as Float) / tot_f;
    let pt = (count_t as Float) / tot_f;

    let mut h: Float = 0.0;
    if pa > 0.0 { h = h - (pa * entropy_log2(pa)); }
    if pc > 0.0 { h = h - (pc * entropy_log2(pc)); }
    if pg > 0.0 { h = h - (pg * entropy_log2(pg)); }
    if pt > 0.0 { h = h - (pt * entropy_log2(pt)); }

    if h < 0.0 { h = 0.0; }
    let ic = 2.0 - h;
    let is_cons = ic >= 1.5;

    let mut best_c = "A";
    let mut best_cnt = count_a;
    if count_c > best_cnt { best_c = "C"; best_cnt = count_c; }
    if count_g > best_cnt { best_c = "G"; best_cnt = count_g; }
    if count_t > best_cnt { best_c = "T"; best_cnt = count_t; }

    return ColumnEntropy {
        column_index: col_idx,
        entropy_bits: h,
        information_content_bits: if ic > 0.0 { ic } else { 0.0 },
        consensus_char: best_c,
        is_highly_conserved: is_cons,
    };
}
