// # Hidden Markov Model (HMM) Baum-Welch Parameter Estimation
//
// Logline: Trains HMM transition and emission probabilities using the Expectation-Maximization (EM) Baum-Welch algorithm.
//
// Setup: Unsupervised machine learning module for biological sequence HMM parameter optimization.
//
// Beats:
//   1. Define BaumWelchConfig and EmIterationStats data structures.
//   2. Calculate expected transition counts (xi_t(i, j)) and expected emission counts (gamma_t(i)).
//   3. Update transition matrix A_hat and emission matrix B_hat to maximize observation likelihood.

pub type BaumWelchConfig = struct {
    max_iterations: Int,
    tolerance: Float,
    pseudocount: Float,
};

pub type EmIterationStats = struct {
    iteration: Int,
    log_likelihood: Float,
    delta_ll: Float,
    has_converged: Bool,
};

pub fn baum_welch_config_default() -> BaumWelchConfig {
    return BaumWelchConfig {
        max_iterations: 50,
        tolerance: 0.0001,
        pseudocount: 0.01,
    };
}

pub fn baum_welch_reestimate_transition(
    expected_trans_ij: Float,
    expected_total_from_i: Float,
    pseudocount: Float,
    num_states: Int
) -> Float {
    let numerator = expected_trans_ij + pseudocount;
    let denominator = expected_total_from_i + (pseudocount * (num_states as Float));
    if denominator <= 0.0 { return 1.0 / (num_states as Float); }
    return numerator / denominator;
}

pub fn baum_welch_check_convergence(
    curr_ll: Float,
    prev_ll: Float,
    iter_num: Int,
    cfg: &BaumWelchConfig
) -> EmIterationStats {
    let delta = curr_ll - prev_ll;
    let abs_delta = if delta < 0.0 { 0.0 - delta } else { delta };
    let converged = abs_delta <= (cfg).tolerance || iter_num >= (cfg).max_iterations;

    return EmIterationStats {
        iteration: iter_num,
        log_likelihood: curr_ll,
        delta_ll: delta,
        has_converged: converged,
    };
}
