// # Protein Isoelectric Point (pI) & Net Charge Calculator
//
// Logline: Calculates protein net electrical charge across pH curves and determines the isoelectric point (pI) via bisection.
//
// Setup: Biophysical proteomics module modeling Henderson-Hasselbalch ionization equilibria of ionizable amino acids.
//
// Beats:
//   1. Define ProteinChargeState and AminoAcidPka data structures.
//   2. Model ionization states of N-terminus, C-terminus, Lys, Arg, His, Asp, Glu, Cys, and Tyr.
//   3. Bisect pH interval [0.0, 14.0] to find the isoelectric point where net charge equals zero.

pub type ProteinChargeState = struct {
    ph_value: Float,
    net_charge: Float,
    positive_charge: Float,
    negative_charge: Float,
};

pub fn pi_pka_n_term() -> Float { return 9.69; }
pub fn pi_pka_c_term() -> Float { return 2.34; }
pub fn pi_pka_asp() -> Float { return 3.86; }
pub fn pi_pka_glu() -> Float { return 4.25; }
pub fn pi_pka_his() -> Float { return 6.00; }
pub fn pi_pka_cys() -> Float { return 8.33; }
pub fn pi_pka_tyr() -> Float { return 10.07; }
pub fn pi_pka_lys() -> Float { return 10.53; }
pub fn pi_pka_arg() -> Float { return 12.48; }

pub fn pi_exp_series(x_val: Float) -> Float {
    let mut sum: Float = 1.0;
    let mut term: Float = 1.0;
    let mut step_f: Float = 1.0;
    while step_f <= 14.0 {
        term = term * (x_val / step_f);
        sum = sum + term;
        step_f = step_f + 1.0;
    }
    if sum < 0.0 { return 0.0; }
    return sum;
}

pub fn pi_ten_power(exp_val: Float) -> Float {
    let ln10: Float = 2.302585092994046;
    let x: Float = ln10 * exp_val;
    if x > 20.0 { return 485165195.0; }
    if x < -20.0 { return 0.0; }
    return pi_exp_series(x);
}

pub fn pi_calc_charge(seq: String, ph: Float) -> Float {
    let n = chars_len(seq);
    let n_term_charge = 1.0 / (1.0 + pi_ten_power(ph - pi_pka_n_term()));
    let c_term_charge = 0.0 - (1.0 / (1.0 + pi_ten_power(pi_pka_c_term() - ph)));

    let mut net = n_term_charge + c_term_charge;

    let mut aa_idx: Int = 0;
    while aa_idx < n {
        let aa = char_at(seq, aa_idx);
        if aa == "K" || aa == "k" {
            net = net + (1.0 / (1.0 + pi_ten_power(ph - pi_pka_lys())));
        } else if aa == "R" || aa == "r" {
            net = net + (1.0 / (1.0 + pi_ten_power(ph - pi_pka_arg())));
        } else if aa == "H" || aa == "h" {
            net = net + (1.0 / (1.0 + pi_ten_power(ph - pi_pka_his())));
        } else if aa == "D" || aa == "d" {
            net = net - (1.0 / (1.0 + pi_ten_power(pi_pka_asp() - ph)));
        } else if aa == "E" || aa == "e" {
            net = net - (1.0 / (1.0 + pi_ten_power(pi_pka_glu() - ph)));
        } else if aa == "C" || aa == "c" {
            net = net - (1.0 / (1.0 + pi_ten_power(pi_pka_cys() - ph)));
        } else if aa == "Y" || aa == "y" {
            net = net - (1.0 / (1.0 + pi_ten_power(pi_pka_tyr() - ph)));
        }
        aa_idx = aa_idx + 1;
    }
    return net;
}

pub fn pi_find_isoelectric_point(seq: String) -> Float {
    let mut ph_low: Float = 0.0;
    let mut ph_high: Float = 14.0;
    let mut iter: Int = 0;

    while iter < 20 {
        let ph_mid = (ph_low + ph_high) / 2.0;
        let charge = pi_calc_charge(seq, ph_mid);
        if charge > 0.0 {
            ph_low = ph_mid;
        } else {
            ph_high = ph_mid;
        }
        iter = iter + 1;
    }
    return (ph_low + ph_high) / 2.0;
}
