// # CRISPR Cas12a (Cpf1) Nuclease & Staggered Cleavage
//
// Logline: Models Cas12a 5'-TTTV PAM recognition, 23-nt guide pairing, and 5-nt staggered double-strand DNA overhang cleavage.
//
// Setup: Cas12a endonuclease modeling module evaluating T-rich target sequences and overhang generation.
//
// Beats:
//   1. Define Cas12aTarget and Cas12aCleavageProduct data structures.
//   2. Validate 5'-TTTV PAM sequence motifs (TTTA, TTTC, TTTG).
//   3. Compute staggered top-strand and bottom-strand cut sites and 5-nt overhang boundaries.

pub type Cas12aTarget = struct {
    sequence: String,
    pam_offset: Int,
    is_valid_pam: Bool,
    spacer_length: Int,
};

pub type Cas12aCleavageProduct = struct {
    cut_top_pos: Int,
    cut_bottom_pos: Int,
    overhang_len: Int,
    overhang_seq: String,
};

pub fn cas12a_is_pam(motif: String) -> Bool {
    if chars_len(motif) != 4 { return false; }
    let c0 = char_at(motif, 0);
    let c1 = char_at(motif, 1);
    let c2 = char_at(motif, 2);
    let c3 = char_at(motif, 3);
    let is_ttt = (c0 == "T" || c0 == "t") && (c1 == "T" || c1 == "t") && (c2 == "T" || c2 == "t");
    let is_v = (c3 == "A" || c3 == "a" || c3 == "C" || c3 == "c" || c3 == "G" || c3 == "g");
    return is_ttt && is_v;
}

pub fn cas12a_substr(seq: String, start: Int, length: Int) -> String {
    let n = chars_len(seq);
    let mut out = "";
    let mut i = 0;
    while i < length && (start + i) < n {
        out = out + char_at(seq, start + i);
        i = i + 1;
    }
    return out;
}

pub fn cas12a_compute_cleavage(pam_start: Int, target_seq: String) -> Cas12aCleavageProduct {
    // Cas12a cuts ~18-19 nt after PAM on non-target strand and ~23 nt on target strand leaving 5-nt 5' overhang
    let cut_non_target = pam_start + 4 + 18;
    let cut_target = pam_start + 4 + 23;
    let overhang = cas12a_substr(target_seq, cut_non_target, 5);

    return Cas12aCleavageProduct {
        cut_top_pos: cut_non_target,
        cut_bottom_pos: cut_target,
        overhang_len: 5,
        overhang_seq: overhang,
    };
}
