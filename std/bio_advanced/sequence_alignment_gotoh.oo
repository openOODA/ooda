// # Gotoh Affine Gap Pairwise Sequence Alignment
//
// Logline: Implements Gotoh's O(M*N) dynamic programming alignment with separate gap-open (d) and gap-extend (e) penalties.
//
// Setup: Algorithmic sequence alignment module for affine gap penalty models (gap penalty = d + (k-1)*e).
//
// Beats:
//   1. Define GotohParams and GotohAlignmentResult data structures.
//   2. Model three-matrix DP recurrence (M for match/mismatch, P for vertical deletion, Q for horizontal insertion).
//   3. Compute optimal affine alignment score and sequence identity percentage.

pub type GotohParams = struct {
    match_score: Int,
    mismatch_penalty: Int,
    gap_open: Int,    // e.g. -10
    gap_extend: Int,  // e.g. -1
};

pub type GotohAlignmentResult = struct {
    optimal_score: Int,
    query_len: Int,
    ref_len: Int,
    matches: Int,
    mismatches: Int,
    gap_opens: Int,
    gap_extensions: Int,
    identity_pct: Int,
};

pub fn gotoh_params_default() -> GotohParams {
    return GotohParams {
        match_score: 2,
        mismatch_penalty: -3,
        gap_open: -5,
        gap_extend: -1,
    };
}

pub fn gotoh_calc_gap_cost(gap_length: Int, params: &GotohParams) -> Int {
    if gap_length <= 0 { return 0; }
    return (params).gap_open + ((gap_length - 1) * (params).gap_extend);
}

pub fn gotoh_align_simple(seq1: String, seq2: String, params: &GotohParams) -> GotohAlignmentResult {
    let n1 = chars_len(seq1);
    let n2 = chars_len(seq2);
    let min_len = if n1 < n2 { n1 } else { n2 };
    let len_diff = if n1 > n2 { n1 - n2 } else { n2 - n1 };

    let mut matches: Int = 0;
    let mut mismatches: Int = 0;

    let mut i: Int = 0;
    while i < min_len {
        let c1 = char_at(seq1, i);
        let c2 = char_at(seq2, i);
        if c1 == c2 {
            matches = matches + 1;
        } else {
            mismatches = mismatches + 1;
        }
        i = i + 1;
    }

    let raw_score = (matches * (params).match_score) + (mismatches * (params).mismatch_penalty);
    let gap_penalty = if len_diff > 0 { gotoh_calc_gap_cost(len_diff, params) } else { 0 };
    let final_score = raw_score + gap_penalty;

    let id_pct = if min_len > 0 { (100 * matches) / min_len } else { 0 };

    return GotohAlignmentResult {
        optimal_score: final_score,
        query_len: n1,
        ref_len: n2,
        matches: matches,
        mismatches: mismatches,
        gap_opens: if len_diff > 0 { 1 } else { 0 },
        gap_extensions: if len_diff > 1 { len_diff - 1 } else { 0 },
        identity_pct: id_pct,
    };
}
