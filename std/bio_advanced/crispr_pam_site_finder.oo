// # CRISPR PAM Site Scanner & Genome Search
//
// Logline: Locates canonical and non-canonical Protospacer Adjacent Motif (PAM) sites across forward and reverse DNA strands.
//
// Setup: CRISPR search engine identifying SpCas9, SaCas9, Cas12a, and custom PAM target candidate windows.
//
// Beats:
//   1. Define PamSite and PamScanConfig data structures.
//   2. Scan forward and reverse-complement genomic sequences for target PAM motifs.
//   3. Extract adjacent 20-24 nt protospacer spacer sequences with orientation metadata.

pub type PamSite = struct {
    strand: String,
    pam_motif: String,
    pam_index: Int,
    spacer_start: Int,
    spacer_end: Int,
    spacer_seq: String,
};

pub type PamScanConfig = struct {
    pam_motif: String,
    spacer_len: Int,
    is_3prime: Bool,
};

pub fn crispr_substr(seq: String, start: Int, length: Int) -> String {
    let n = chars_len(seq);
    let mut out = "";
    let mut i = 0;
    while i < length && (start + i) < n {
        out = out + char_at(seq, start + i);
        i = i + 1;
    }
    return out;
}

pub fn crispr_pam_match_char(motif_char: String, target_char: String) -> Bool {
    if motif_char == "N" || motif_char == "n" { return true; }
    if motif_char == "R" || motif_char == "r" {
        return target_char == "A" || target_char == "a" || target_char == "G" || target_char == "g";
    }
    if motif_char == "Y" || motif_char == "y" {
        return target_char == "C" || target_char == "c" || target_char == "T" || target_char == "t";
    }
    if motif_char == "V" || motif_char == "v" {
        return target_char == "A" || target_char == "a" || target_char == "C" || target_char == "c" || target_char == "G" || target_char == "g";
    }
    return motif_char == target_char;
}

pub fn crispr_pam_matches_motif(motif: String, window: String) -> Bool {
    let m_len = chars_len(motif);
    let w_len = chars_len(window);
    if m_len != w_len { return false; }
    let mut i = 0;
    while i < m_len {
        let mc = char_at(motif, i);
        let wc = char_at(window, i);
        if !crispr_pam_match_char(mc, wc) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn crispr_scan_pam_forward(seq: String, cfg: &PamScanConfig) -> List[PamSite] {
    let mut sites: List[PamSite] = list_new();
    let n = chars_len(seq);
    let p_len = chars_len((cfg).pam_motif);
    let s_len = (cfg).spacer_len;

    if (cfg).is_3prime {
        let total_window = s_len + p_len;
        if n < total_window { return sites; }
        let mut i = s_len;
        while i <= n - p_len {
            let pam_sub = crispr_substr(seq, i, p_len);
            if crispr_pam_matches_motif((cfg).pam_motif, pam_sub) {
                let spacer = crispr_substr(seq, i - s_len, s_len);
                let site = PamSite {
                    strand: "+",
                    pam_motif: pam_sub,
                    pam_index: i,
                    spacer_start: i - s_len,
                    spacer_end: i - 1,
                    spacer_seq: spacer,
                };
                list_push(sites, site);
            }
            i = i + 1;
        }
    } else {
        let total_window = s_len + p_len;
        if n < total_window { return sites; }
        let mut i = 0;
        while i <= n - total_window {
            let pam_sub = crispr_substr(seq, i, p_len);
            if crispr_pam_matches_motif((cfg).pam_motif, pam_sub) {
                let spacer = crispr_substr(seq, i + p_len, s_len);
                let site = PamSite {
                    strand: "+",
                    pam_motif: pam_sub,
                    pam_index: i,
                    spacer_start: i + p_len,
                    spacer_end: i + p_len + s_len - 1,
                    spacer_seq: spacer,
                };
                list_push(sites, site);
            }
            i = i + 1;
        }
    }
    return sites;
}
