// # Protein Solvent Accessible Surface Area (SASA) Shrake-Rupley Algorithm
//
// Logline: Calculates per-residue and total solvent accessible surface area using the Shrake-Rupley numerical sphere-tessellation method.
//
// Setup: Structural biology solvent exposure module evaluating accessible surface area using probe spheres of 1.4 Angstrom radius.
//
// Beats:
//   1. Define AtomSasaRecord and ResidueSasaResult data structures.
//   2. Tessellate van der Waals atomic spheres with uniformly distributed probe test points (N=92).
//   3. Compute test point occlusions by neighboring atoms and determine exposed surface area in Angstroms squared.

pub type AtomSasaRecord = struct {
    atom_id: Int,
    res_num: Int,
    element: String,
    x: Float,
    y: Float,
    z: Float,
    vdw_radius: Float,
    accessible_area: Float,
};

pub type ResidueSasaResult = struct {
    res_num: Int,
    res_name: String,
    total_sasa_a2: Float,
    relative_exposure_pct: Float,
    is_buried: Bool,
};

pub fn sasa_probe_radius() -> Float {
    return 1.40; // Standard water molecule probe radius in Angstroms
}

pub fn sasa_vdw_radius(element: String) -> Float {
    if element == "C" || element == "c" { return 1.70; }
    if element == "N" || element == "n" { return 1.55; }
    if element == "O" || element == "o" { return 1.52; }
    if element == "S" || element == "s" { return 1.80; }
    if element == "H" || element == "h" { return 1.20; }
    if element == "P" || element == "p" { return 1.80; }
    return 1.60;
}

pub fn sasa_is_point_occluded(
    px: Float,
    py: Float,
    pz: Float,
    neighbor_x: Float,
    neighbor_y: Float,
    neighbor_z: Float,
    neighbor_radius: Float
) -> Bool {
    let r_eff = neighbor_radius + sasa_probe_radius();
    let dx = px - neighbor_x;
    let dy = py - neighbor_y;
    let dz = pz - neighbor_z;
    let dist_sq = (dx * dx) + (dy * dy) + (dz * dz);
    return dist_sq < (r_eff * r_eff);
}

pub fn sasa_calc_sphere_area(vdw_r: Float, unoccluded_points: Int, total_points: Int) -> Float {
    if total_points <= 0 { return 0.0; }
    let r_tot = vdw_r + sasa_probe_radius();
    let pi_val: Float = 3.141592653589793;
    let total_sphere_area = 4.0 * pi_val * (r_tot * r_tot);
    let fraction = (unoccluded_points as Float) / (total_points as Float);
    return total_sphere_area * fraction;
}

pub fn sasa_evaluate_residue(res_num: Int, res_name: String, total_sasa: Float, max_ref_sasa: Float) -> ResidueSasaResult {
    let rel_pct = if max_ref_sasa > 0.0 { (100.0 * total_sasa) / max_ref_sasa } else { 0.0 };
    // Residues with < 20% relative solvent accessibility are considered buried in the hydrophobic core
    let buried = rel_pct < 20.0;

    return ResidueSasaResult {
        res_num: res_num,
        res_name: res_name,
        total_sasa_a2: total_sasa,
        relative_exposure_pct: rel_pct,
        is_buried: buried,
    };
}
