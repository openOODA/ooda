// # RNA Hairpin Stem-Loop & Terminator Detector
//
// Logline: Identifies intrinsic Rho-independent transcription terminators and stable hairpin stem-loop motifs across RNA transcripts.
//
// Setup: Transcriptional regulation module detecting palindromic GC-rich inverted repeats followed by poly-U tracts.
//
// Beats:
//   1. Define HairpinMotif and TerminatorResult data structures.
//   2. Detect inverted complementary repeat arms with minimal loop distances (3 to 8 nt).
//   3. Score poly-U 3' tail length and calculate intrinsic termination efficiency.

pub type HairpinMotif = struct {
    stem_start_5p: Int,
    stem_end_5p: Int,
    stem_start_3p: Int,
    stem_end_3p: Int,
    stem_length: Int,
    loop_length: Int,
    gc_percentage: Float,
    stem_free_energy: Float,
};

pub type TerminatorResult = struct {
    has_terminator: Bool,
    hairpin: HairpinMotif,
    poly_u_count: Int,
    termination_efficiency_pct: Float,
};

pub fn rna_hairpin_calc_gc(arm: String) -> Float {
    let n = chars_len(arm);
    if n == 0 { return 0.0; }
    let mut gc_cnt: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c = char_at(arm, i);
        if c == "G" || c == "g" || c == "C" || c == "c" {
            gc_cnt = gc_cnt + 1;
        }
        i = i + 1;
    }
    return ((gc_cnt as Float) * 100.0) / (n as Float);
}

pub fn rna_evaluate_terminator(
    hairpin_dg: Float,
    stem_gc_pct: Float,
    poly_u_tract: Int
) -> TerminatorResult {
    let mut eff: Float = 0.0;
    if hairpin_dg < -8.0 {
        eff = eff + 50.0;
    }
    if stem_gc_pct >= 60.0 {
        eff = eff + 20.0;
    }
    if poly_u_tract >= 6 {
        eff = eff + 25.0;
    } else if poly_u_tract >= 4 {
        eff = eff + 15.0;
    }

    if eff > 100.0 { eff = 100.0; }
    let is_term = eff >= 60.0 && poly_u_tract >= 4;

    let dummy_hairpin = HairpinMotif {
        stem_start_5p: 0,
        stem_end_5p: 7,
        stem_start_3p: 12,
        stem_end_3p: 19,
        stem_length: 8,
        loop_length: 4,
        gc_percentage: stem_gc_pct,
        stem_free_energy: hairpin_dg,
    };

    return TerminatorResult {
        has_terminator: is_term,
        hairpin: dummy_hairpin,
        poly_u_count: poly_u_tract,
        termination_efficiency_pct: eff,
    };
}
