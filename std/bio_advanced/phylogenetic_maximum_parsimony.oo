// # Maximum Parsimony Phylogenetic Tree Cost Evaluator
//
// Logline: Calculates the minimum total evolutionary character state changes (tree length / parsimony score) across aligned sites.
//
// Setup: Cladistic phylogenetics module evaluating character state transition costs across topologies.
//
// Beats:
//   1. Define ParsimonyScoreResult and SiteStateCost data structures.
//   2. Count minimum state substitutions required to explain observed character distributions.
//   3. Compute parsimony-informative site counts and consistency index (CI = m / s).

pub type ParsimonyScoreResult = struct {
    total_tree_length: Int,
    informative_sites_count: Int,
    constant_sites_count: Int,
    consistency_index: Float,
    is_optimal_topology: Bool,
};

pub type SiteStateCost = struct {
    site_index: Int,
    state_changes: Int,
    is_informative: Bool,
};

pub fn parsimony_evaluate_site_4taxa(s1: String, s2: String, s3: String, s4: String) -> SiteStateCost {
    // For 4 taxa, count unique states
    let mut num_changes = 0;
    let is_same_12 = (s1 == s2);
    let is_same_34 = (s3 == s4);
    let is_same_all = (s1 == s2) && (s2 == s3) && (s3 == s4);

    if is_same_all {
        return SiteStateCost {
            site_index: 0,
            state_changes: 0,
            is_informative: false,
        };
    }

    // Informative site: at least 2 distinct states each occurring at least twice (e.g. (A,A,G,G))
    let mut informative = false;
    if is_same_12 && is_same_34 && (s1 != s3) {
        informative = true;
        num_changes = 1;
    } else {
        num_changes = 2;
    }

    return SiteStateCost {
        site_index: 0,
        state_changes: num_changes,
        is_informative: informative,
    };
}

pub fn parsimony_calc_consistency_index(min_possible_changes: Int, actual_tree_length: Int) -> Float {
    if actual_tree_length <= 0 { return 1.0; }
    let m_f = min_possible_changes * 1.0;
    let s_f = actual_tree_length * 1.0;
    return m_f / s_f;
}
