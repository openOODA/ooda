// # Protein Surface Electrostatic Potential & Debye-Huckel Screening
//
// Logline: Calculates continuum electrostatic surface potentials with ionic strength screening using the linearized Poisson-Boltzmann / Debye-Huckel model.
//
// Setup: Biophysical proteomics module estimating electrostatic potentials at solvent-accessible surface points.
//
// Beats:
//   1. Define ElectrostaticSurfacePoint and IonicEnvironment data structures.
//   2. Compute inverse Debye screening length kappa from ionic buffer ionic strength.
//   3. Calculate screened Coulombic potential sums over formal partial atomic charges.

pub type IonicEnvironment = struct {
    ionic_strength_molar: Float,
    dielectric_constant: Float, // Typically 78.5 for water
    temperature_kelvin: Float, // Typically 298.15 K
    debye_length_angstrom: Float,
};

pub type ElectrostaticSurfacePoint = struct {
    x: Float,
    y: Float,
    z: Float,
    potential_kt_e: Float,
    potential_millivolts: Float,
};

pub fn electrostatics_env_default() -> IonicEnvironment {
    return IonicEnvironment {
        ionic_strength_molar: 0.150, // 150 mM physiological saline
        dielectric_constant: 78.54,
        temperature_kelvin: 298.15,
        debye_length_angstrom: 7.85, // ~0.304 / sqrt(I) nm -> ~7.85 A at 150 mM
    };
}

pub fn electrostatics_screened_potential(q: Float, r: Float, debye_len: Float, eps: Float) -> Float {
    if r < 0.5 { return 0.0; }
    // V(r) = (q / (4 * pi * eps_0 * eps_r * r)) * exp(-r / lambda_D)
    // Conversion factor for e / (4 * pi * eps_0 * Angstrom) to Volts is ~14.3996 V*A/e
    let prefactor: Float = 14.3996 / (eps * r);
    let decay_arg: Float = 0.0 - (r / debye_len);

    // exp approximation
    let mut sum: Float = 1.0;
    let mut term: Float = 1.0;
    let mut step: Float = 1.0;
    while step <= 10.0 {
        term = term * (decay_arg / step);
        sum = sum + term;
        step = step + 1.0;
    }
    if sum < 0.0 { sum = 0.0; }
    return q * prefactor * sum * 1000.0; // In millivolts
}
