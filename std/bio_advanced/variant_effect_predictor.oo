// # Variant Effect Predictor (VEP) & Functional Impact Classifier
//
// Logline: Annotates coding and non-coding SNVs/InDels into missense, synonymous, nonsense (stop gained), frameshift, and splice site impacts.
//
// Setup: Clinical genomics and transcript annotation module predicting protein alteration consequences.
//
// Beats:
//   1. Define VariantConsequence and ImpactLevel data structures.
//   2. Classify coding consequences: Synonymous, Missense, Stop-Gained, Stop-Lost, Frameshift, Inframe-InDel.
//   3. Assign Sequence Ontology (SO) terms and Ensembl high/moderate/low impact tiers.

pub type VariantConsequence = struct {
    consequence_term: String, // e.g. "missense_variant", "synonymous_variant", "stop_gained", "frameshift_variant"
    impact_level: String, // "HIGH", "MODERATE", "LOW", "MODIFIER"
    ref_codon: String,
    alt_codon: String,
    ref_aa: String,
    alt_aa: String,
    is_deleterious_predicted: Bool,
};

pub fn vep_impact_high() -> String { return "HIGH"; }
pub fn vep_impact_moderate() -> String { return "MODERATE"; }
pub fn vep_impact_low() -> String { return "LOW"; }
pub fn vep_impact_modifier() -> String { return "MODIFIER"; }

pub fn vep_classify_amino_acid_change(
    ref_aa: String,
    alt_aa: String,
    ref_cod: String,
    alt_cod: String
) -> VariantConsequence {
    if ref_aa == alt_aa {
        return VariantConsequence {
            consequence_term: "synonymous_variant",
            impact_level: vep_impact_low(),
            ref_codon: ref_cod,
            alt_codon: alt_cod,
            ref_aa: ref_aa,
            alt_aa: alt_aa,
            is_deleterious_predicted: false,
        };
    }

    if alt_aa == "*" {
        return VariantConsequence {
            consequence_term: "stop_gained",
            impact_level: vep_impact_high(),
            ref_codon: ref_cod,
            alt_codon: alt_cod,
            ref_aa: ref_aa,
            alt_aa: alt_aa,
            is_deleterious_predicted: true,
        };
    }

    if ref_aa == "*" && alt_aa != "*" {
        return VariantConsequence {
            consequence_term: "stop_lost",
            impact_level: vep_impact_high(),
            ref_codon: ref_cod,
            alt_codon: alt_cod,
            ref_aa: ref_aa,
            alt_aa: alt_aa,
            is_deleterious_predicted: true,
        };
    }

    // Standard non-synonymous missense change
    return VariantConsequence {
        consequence_term: "missense_variant",
        impact_level: vep_impact_moderate(),
        ref_codon: ref_cod,
        alt_codon: alt_cod,
        ref_aa: ref_aa,
        alt_aa: alt_aa,
        is_deleterious_predicted: false,
    };
}
