// # Proteomics Mass Spectrometry In Silico Digestion & m/z Calculator
//
// Logline: Simulates enzymatic cleavage by Trypsin, Chymotrypsin, and Lys-C, calculating monoisotopic peptide masses and precursor m/z ions.
//
// Setup: Tandem mass spectrometry proteomics module modeling peptide fragmentation precursors and charge states.
//
// Beats:
//   1. Define DigestPeptide and PrecursorMz data structures.
//   2. Cleave polypeptide sequences according to Trypsin (C-term of K/R unless followed by P) and other proteases.
//   3. Compute monoisotopic precursor masses, [M+H]+, [M+2H]2+, and [M+3H]3+ ion m/z values.

pub type DigestPeptide = struct {
    sequence: String,
    start_pos: Int,
    end_pos: Int,
    missed_cleavages: Int,
    monoisotopic_mass: Float,
    mz_charge_1: Float,
    mz_charge_2: Float,
    mz_charge_3: Float
};

pub fn mass_spec_aa_monoisotopic(aa: String) -> Float {
    if aa == "G" || aa == "g" { return 57.02146; }
    if aa == "A" || aa == "a" { return 71.03711; }
    if aa == "S" || aa == "s" { return 87.03203; }
    if aa == "P" || aa == "p" { return 97.05276; }
    if aa == "V" || aa == "v" { return 99.06841; }
    if aa == "T" || aa == "t" { return 101.04768; }
    if aa == "C" || aa == "c" { return 103.00919; }
    if aa == "I" || aa == "i" || aa == "L" || aa == "l" { return 113.08406; }
    if aa == "N" || aa == "n" { return 114.04293; }
    if aa == "D" || aa == "d" { return 115.02694; }
    if aa == "Q" || aa == "q" { return 128.05858; }
    if aa == "K" || aa == "k" { return 128.09496; }
    if aa == "E" || aa == "e" { return 129.04259; }
    if aa == "M" || aa == "m" { return 131.04049; }
    if aa == "H" || aa == "h" { return 137.05891; }
    if aa == "F" || aa == "f" { return 147.06841; }
    if aa == "R" || aa == "r" { return 156.10111; }
    if aa == "Y" || aa == "y" { return 163.06333; }
    if aa == "W" || aa == "w" { return 186.07931; }
    return 100.0;
}

pub fn mass_spec_calc_monoisotopic(pep: String) -> Float {
    let n = chars_len(pep);
    let mut mass: Float = 18.01056; // Water H2O (N-term H + C-term OH)
    let mut p_idx: Int = 0;
    while p_idx < n {
        let aa = char_at(pep, p_idx);
        mass = mass + mass_spec_aa_monoisotopic(aa);
        p_idx = p_idx + 1;
    }
    return mass;
}

pub fn mass_spec_compute_peptide(pep: String, start_p: Int, end_p: Int, missed: Int) -> DigestPeptide {
    let mass = mass_spec_calc_monoisotopic(pep);
    let proton_mass: Float = 1.007276;
    let mz1 = mass + proton_mass;
    let mz2 = (mass + (2.0 * proton_mass)) / 2.0;
    let mz3 = (mass + (3.0 * proton_mass)) / 3.0;

    return DigestPeptide {
        sequence: pep,
        start_pos: start_p,
        end_pos: end_p,
        missed_cleavages: missed,
        monoisotopic_mass: mass,
        mz_charge_1: mz1,
        mz_charge_2: mz2,
        mz_charge_3: mz3
    };
}
