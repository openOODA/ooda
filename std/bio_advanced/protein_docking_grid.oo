// # Protein-Ligand Molecular Docking Affinity Grid
//
// Logline: Discretizes receptor binding pockets into 3D affinity potential grids for molecular docking scoring functions.
//
// Setup: Molecular docking module computing van der Waals, electrostatic, and desolvation potential energetic voxels.
//
// Beats:
//   1. Define DockingGrid3D and GridVoxelPoint data structures.
//   2. Discretize spatial bounding boxes with regular spacing (e.g. 0.375 Angstroms).
//   3. Compute Lennard-Jones 12-6 potential and Coulombic electrostatic potential at voxel centers.

pub type DockingGrid3D = struct {
    origin_x: Float,
    origin_y: Float,
    origin_z: Float,
    dim_x: Int,
    dim_y: Int,
    dim_z: Int,
    spacing_angstrom: Float,
    total_voxels: Int
};

pub type GridVoxelPoint = struct {
    grid_x: Int,
    grid_y: Int,
    grid_z: Int,
    world_x: Float,
    world_y: Float,
    world_z: Float,
    vdw_energy: Float,
    elec_energy: Float
};

pub fn docking_grid_new(ox: Float, oy: Float, oz: Float, nx: Int, ny: Int, nz: Int, spacing: Float) -> DockingGrid3D {
    return DockingGrid3D {
        origin_x: ox,
        origin_y: oy,
        origin_z: oz,
        dim_x: nx,
        dim_y: ny,
        dim_z: nz,
        spacing_angstrom: spacing,
        total_voxels: nx * ny * nz
    };
}

pub fn docking_grid_coord_to_world(grid: &DockingGrid3D, gx: Int, gy: Int, gz: Int) -> List[Float] {
    let mut coords: List[Float] = list_new();
    let wx: Float = (grid).origin_x + ((gx * 1.0) * (grid).spacing_angstrom);
    let wy: Float = (grid).origin_y + ((gy * 1.0) * (grid).spacing_angstrom);
    let wz: Float = (grid).origin_z + ((gz * 1.0) * (grid).spacing_angstrom);
    list_push(coords, wx);
    list_push(coords, wy);
    list_push(coords, wz);
    return coords;
}

pub fn docking_lennard_jones_energy(r: Float, sigma: Float, epsilon: Float) -> Float {
    if r < 0.1 { return 1000.0; } // Steric clash repulsive cap
    let ratio = sigma / r;
    let r3 = ratio * ratio * ratio;
    let r6 = r3 * r3;
    let r12 = r6 * r6;
    return 4.0 * epsilon * (r12 - r6);
}
