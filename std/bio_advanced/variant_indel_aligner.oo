// # Insertion & Deletion (InDel) Realignment & Micro-Homology
//
// Logline: Realigns insertion/deletion reads around genomic homopolymers and micro-homology breakpoint regions to eliminate false SNVs.
//
// Setup: NGS variant calling refinement module handling gap shift ambiguities and left-aligning InDel representations.
//
// Beats:
//   1. Define IndelRecord and LeftAlignResult data structures.
//   2. Left-align ambiguous insertion/deletion variants according to VCF standard conventions.
//   3. Detect micro-homology flank repeats and identify micro-homology mediated end joining (MMEJ) signatures.

pub type IndelRecord = struct {
    chrom: String,
    position: Int,
    ref_allele: String,
    alt_allele: String,
    is_insertion: Bool,
    is_deletion: Bool,
    indel_length: Int
};

pub type LeftAlignResult = struct {
    normalized_pos: Int,
    normalized_ref: String,
    normalized_alt: String,
    shift_distance: Int
};

pub fn indel_char_at(s: String, idx: Int) -> String {
    let n = chars_len(s);
    if idx < 0 || idx >= n { return ""; }
    return char_at(s, idx);
}

pub fn indel_create_record(
    chr: String,
    pos: Int,
    ref_str: String,
    alt_str: String
) -> IndelRecord {
    let r_len = chars_len(ref_str);
    let a_len = chars_len(alt_str);
    let is_ins = a_len > r_len;
    let is_del = r_len > a_len;
    let diff = if is_ins { a_len - r_len } else { r_len - a_len };

    return IndelRecord {
        chrom: chr,
        position: pos,
        ref_allele: ref_str,
        alt_allele: alt_str,
        is_insertion: is_ins,
        is_deletion: is_del,
        indel_length: diff
    };
}

pub fn indel_left_align_step(
    pos: Int,
    ref_allele: String,
    alt_allele: String,
    upstream_base: String
) -> LeftAlignResult {
    let r_len = chars_len(ref_allele);
    let a_len = chars_len(alt_allele);

    // If rightmost characters match upstream base, shift left
    let mut shift: Int = 0;
    if r_len > 0 && a_len > 0 {
        let r_last = indel_char_at(ref_allele, r_len - 1);
        let a_last = indel_char_at(alt_allele, a_len - 1);
        if r_last == a_last && r_last == upstream_base {
            shift = 1;
        }
    }

    return LeftAlignResult {
        normalized_pos: pos - shift,
        normalized_ref: ref_allele,
        normalized_alt: alt_allele,
        shift_distance: shift
    };
}
