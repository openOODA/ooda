// # Protein Ramachandran Dihedral Angle Region Classifier
//
// Logline: Classifies backbone (phi, psi) dihedral angles into favored, allowed, and outlier conformational regions.
//
// Setup: Protein structural validation module evaluating steric clashes and secondary structure domain boundaries.
//
// Beats:
//   1. Define RamachandranRegion and RamaPoint data structures.
//   2. Identify core alpha-helical (phi ~ -60, psi ~ -45) and beta-sheet (phi ~ -135, psi ~ +135) regions.
//   3. Handle specialized Glycine and Proline conformational boundary distributions.

pub type RamachandranRegion = struct {
    region_name: String, // "Favored-Alpha", "Favored-Beta", "Favored-L-Alpha", "Allowed", "Outlier"
    is_favored: Bool,
    is_allowed: Bool,
    is_outlier: Bool
};

pub type RamaPoint = struct {
    residue_num: Int,
    residue_name: String,
    phi_deg: Float,
    psi_deg: Float,
    region: RamachandranRegion
};

pub fn rama_region_favored_alpha() -> RamachandranRegion {
    return RamachandranRegion {
        region_name: "Favored-Alpha",
        is_favored: true,
        is_allowed: true,
        is_outlier: false
    };
}

pub fn rama_region_favored_beta() -> RamachandranRegion {
    return RamachandranRegion {
        region_name: "Favored-Beta",
        is_favored: true,
        is_allowed: true,
        is_outlier: false
    };
}

pub fn rama_region_allowed() -> RamachandranRegion {
    return RamachandranRegion {
        region_name: "Allowed",
        is_favored: false,
        is_allowed: true,
        is_outlier: false
    };
}

pub fn rama_region_outlier() -> RamachandranRegion {
    return RamachandranRegion {
        region_name: "Outlier",
        is_favored: false,
        is_allowed: false,
        is_outlier: true
    };
}

pub fn rama_classify_general(phi: Float, psi: Float) -> RamachandranRegion {
    // Right-handed Alpha-helix core: phi [-100, -35], psi [-70, -10]
    if phi >= -100.0 && phi <= -35.0 && psi >= -70.0 && psi <= -10.0 {
        return rama_region_favored_alpha();
    }
    // Beta-sheet core: phi [-160, -80], psi [90, 180] or psi [-180, -165]
    if phi >= -160.0 && phi <= -80.0 && ((psi >= 90.0 && psi <= 180.0) || (psi >= -180.0 && psi <= -165.0)) {
        return rama_region_favored_beta();
    }
    // Left-handed Alpha-helix core: phi [40, 80], psi [20, 80]
    if phi >= 40.0 && phi <= 80.0 && psi >= 20.0 && psi <= 80.0 {
        return rama_region_allowed();
    }
    // General allowed envelope
    if phi <= 0.0 && psi >= -100.0 && psi <= 180.0 {
        return rama_region_allowed();
    }
    return rama_region_outlier();
}
