// # Wiggle (WIG) & BigWig Genomic Coverage Calculator
//
// Logline: Calculates base-pair read coverage depth, rolling mean windows, and summary statistics across continuous genomic tracks.
//
// Setup: NGS depth and ChIP-seq signal processing module evaluating variableStep and fixedStep WIG tracks.
//
// Beats:
//   1. Define WigTrackSpan and CoverageSummary data structures.
//   2. Parse fixedStep and variableStep span and step parameters.
//   3. Compute mean coverage, peak signal amplitude, and fraction of bases covered >= 10x.

pub type WigTrackSpan = struct {
    chrom: String,
    start_pos: Int,
    span_bases: Int,
    step_bases: Int,
    value: Float,
};

pub type CoverageSummary = struct {
    chrom: String,
    total_bases: Int,
    mean_depth: Float,
    max_depth: Float,
    pct_bases_above_10x: Float,
    pct_bases_above_30x: Float,
};

pub fn wig_calc_window_stats(depths: List[Float]) -> CoverageSummary {
    let n = list_len(depths);
    if n == 0 {
        return CoverageSummary {
            chrom: "chr1",
            total_bases: 0,
            mean_depth: 0.0,
            max_depth: 0.0,
            pct_bases_above_10x: 0.0,
            pct_bases_above_30x: 0.0,
        };
    }

    let mut sum: Float = 0.0;
    let mut peak: Float = 0.0;
    let mut count_10x: Int = 0;
    let mut count_30x: Int = 0;

    let mut i: Int = 0;
    while i < n {
        let val = list_get(depths, i);
        sum = sum + val;
        if val > peak {
            peak = val;
        }
        if val >= 10.0 {
            count_10x = count_10x + 1;
        }
        if val >= 30.0 {
            count_30x = count_30x + 1;
        }
        i = i + 1;
    }

    let n_f = n as Float;
    let mean_val = sum / n_f;
    let pct_10 = ((count_10x as Float) * 100.0) / n_f;
    let pct_30 = ((count_30x as Float) * 100.0) / n_f;

    return CoverageSummary {
        chrom: "chr1",
        total_bases: n,
        mean_depth: mean_val,
        max_depth: peak,
        pct_bases_above_10x: pct_10,
        pct_bases_above_30x: pct_30,
    };
}
