// # GUI Interaction State Controller
//
// Logline: Multi-widget interaction tracker managing drag offsets, hover targets, and keyboard focus.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type GuiState = struct {
    mouse_x: Int,
    mouse_y: Int,
    mouse_down: Bool,
    focused_widget_id: Int,
    hovered_widget_id: Int,
    drag_active: Bool,
    drag_start_x: Int,
    drag_start_y: Int
};

pub fn gui_state_init() -> GuiState {
    return GuiState {
        mouse_x: 0,
        mouse_y: 0,
        mouse_down: false,
        focused_widget_id: 0,
        hovered_widget_id: 0,
        drag_active: false,
        drag_start_x: 0,
        drag_start_y: 0
    };
}

pub fn gui_state_update_mouse(state: GuiState, x: Int, y: Int, is_down: Bool) -> GuiState {
    let mut drag_active: Bool = state.drag_active;
    let mut drag_start_x: Int = state.drag_start_x;
    let mut drag_start_y: Int = state.drag_start_y;
    if is_down {
        if state.mouse_down == false {
            drag_start_x = x;
            drag_start_y = y;
            drag_active = true;
        }
    } else {
        drag_active = false;
    }
    return GuiState {
        mouse_x: x,
        mouse_y: y,
        mouse_down: is_down,
        focused_widget_id: state.focused_widget_id,
        hovered_widget_id: state.hovered_widget_id,
        drag_active: drag_active,
        drag_start_x: drag_start_x,
        drag_start_y: drag_start_y
    };
}

pub fn gui_state_set_focus(state: GuiState, widget_id: Int) -> GuiState {
    return GuiState {
        mouse_x: state.mouse_x,
        mouse_y: state.mouse_y,
        mouse_down: state.mouse_down,
        focused_widget_id: widget_id,
        hovered_widget_id: state.hovered_widget_id,
        drag_active: state.drag_active,
        drag_start_x: state.drag_start_x,
        drag_start_y: state.drag_start_y
    };
}

pub fn gui_state_get_focus(state: GuiState) -> Int {
    return state.focused_widget_id;
}

pub fn gui_state_set_hover(state: GuiState, widget_id: Int) -> GuiState {
    return GuiState {
        mouse_x: state.mouse_x,
        mouse_y: state.mouse_y,
        mouse_down: state.mouse_down,
        focused_widget_id: state.focused_widget_id,
        hovered_widget_id: widget_id,
        drag_active: state.drag_active,
        drag_start_x: state.drag_start_x,
        drag_start_y: state.drag_start_y
    };
}

pub fn gui_state_get_hover(state: GuiState) -> Int {
    return state.hovered_widget_id;
}

pub fn gui_state_get_drag_dx(state: GuiState) -> Int {
    if state.drag_active {
        return state.mouse_x - state.drag_start_x;
    }
    return 0;
}

pub fn gui_state_get_drag_dy(state: GuiState) -> Int {
    if state.drag_active {
        return state.mouse_y - state.drag_start_y;
    }
    return 0;
}
