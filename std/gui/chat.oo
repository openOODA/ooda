// # GUI Chat Session Component
//
// Logline: Interactive chat conversation stream widgets, message buffering, and layout rendering.
//
// Setup: Pure data model and rendering routines for multi-turn chat interaction.
//
// Beats:
//   1. Model individual chat messages and ordered message queues.
//   2. Create, reposition, and resize chat container views.
//   3. Render message stream with styled headers and row separators into a pixel buffer.

import "render.oo";

pub type ChatMessage = struct {
    sender: String,
    content: String,
};

pub fn chat_message_new(sender: String, content: String) -> ChatMessage {
    return ChatMessage {
        sender: sender,
        content: content,
    };
}

pub type ChatSession = struct {
    id: Int,
    rect: Rect,
    messages: List[ChatMessage],
    is_visible: Bool,
};

pub fn chat_session_new(id: Int, r: Rect) -> ChatSession {
    let mut msgs: List[ChatMessage] = list_new();
    return ChatSession {
        id: id,
        rect: r,
        messages: msgs,
        is_visible: true,
    };
}

pub fn chat_session_add_message(session: &mut ChatSession, msg: ChatMessage) {
    let mut msgs: List[ChatMessage] = (session).messages;
    msgs = list_push(msgs, msg);
    (session).messages = msgs;
}

pub fn chat_session_set_visible(session: &mut ChatSession, visible: Bool) {
    (session).is_visible = visible;
}

pub fn chat_session_move(session: &mut ChatSession, dx: Int, dy: Int) {
    (session).rect.origin.x = (session).rect.origin.x + dx;
    (session).rect.origin.y = (session).rect.origin.y + dy;
}

pub fn chat_session_resize(session: &mut ChatSession, new_width: Int, new_height: Int) {
    let old_origin: Point = (session).rect.origin;
    let new_size: Size = Size { width: new_width, height: new_height, };
    (session).rect = Rect { origin: old_origin, size: new_size, };
}

pub fn chat_session_message_count(session: &ChatSession) -> Int {
    let msgs: List[ChatMessage] = (session).messages;
    return msgs.len();
}

pub fn chat_session_get_message(session: &ChatSession, idx: Int) -> ChatMessage {
    let msgs: List[ChatMessage] = (session).messages;
    return list_get(msgs, idx);
}

// Render the chat session into a software RenderContext.
pub fn chat_session_render(session: &ChatSession, ctx: RenderContext) -> RenderContext {
    if (session).is_visible == false {
        return ctx;
    }

    let r: Rect = (session).rect;
    let ox: Int = r.origin.x;
    let oy: Int = r.origin.y;
    let w: Int  = r.size.width;
    let h: Int  = r.size.height;

    // Background fill: light grey
    let bg_color = color_new(230, 230, 230, 255);
    let mut out_ctx: RenderContext = render_fill_rect(ctx, r, bg_color);

    // Header bar: top 20 pixels, steel-blue
    let header_h: Int = 20;
    let header_rect: Rect = rect_new(ox, oy, w, header_h);
    let header_color = color_new(70, 130, 180, 255);
    out_ctx = render_fill_rect(out_ctx, header_rect, header_color);

    // Border: dark grey outline around the full session rect
    let border_color = color_new(80, 80, 80, 255);
    out_ctx = render_draw_rect(out_ctx, r, border_color);

    // Separator line between header and message area
    let sep_y: Int = oy + header_h;
    let p_sep_left: Point  = Point { x: ox,     y: sep_y };
    let p_sep_right: Point = Point { x: ox + w, y: sep_y };
    let sep_color = color_new(50, 50, 50, 255);
    out_ctx = render_draw_line(out_ctx, p_sep_left, p_sep_right, sep_color);

    // Draw a divider line at the bottom of each message row.
    let row_h: Int = 18;
    let msgs: List[ChatMessage] = (session).messages;
    let msg_count: Int = msgs.len();
    let max_y: Int = oy + h;
    let mut i: Int = 0;
    while i < msg_count {
        let row_bottom: Int = oy + header_h + ((i + 1) * row_h);
        if row_bottom <= max_y {
            let p_left: Point  = Point { x: ox,     y: row_bottom };
            let p_right: Point = Point { x: ox + w, y: row_bottom };
            let row_div_color = color_new(180, 180, 180, 255);
            out_ctx = render_draw_line(out_ctx, p_left, p_right, row_div_color);
        }
        i = i + 1;
    }

    return out_ctx;
}

pub fn chat_session_draw(session: &ChatSession) {
    if (session).is_visible == false {
        return;
    }
    // Hard compiler limitation: chat_session_draw has no RenderContext parameter
    // and openOODA lacks native FFI surface bindings to render to a display.
    // Use chat_session_render(session, ctx) for software-renderer output instead.
    process_exit(1);
}

pub fn chat_session_contains_point(session: &ChatSession, p: Point) -> Bool {
    return rect_contains_point((session).rect, p);
}
