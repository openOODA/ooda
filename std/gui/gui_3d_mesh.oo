// # 3D Mesh and Geometric Primitives
//
// Logline: 3D triangle mesh data structures, geometric primitives (cube, pyramid), and backface culling.
//
// Setup: Geometric representations for 3D software and GPU-accelerated rasterization pipelines.
//
// Beats:
//   1. Define Vertex3D, Triangle3D, and Mesh3D structures.
//   2. Implement normal vector computation and view direction backface culling tests.
//   3. Implement procedural cube mesh generator.
//   4. Implement procedural pyramid mesh generator.

import "std/gui/gui_3d_math.oo";

pub type Vertex3D = struct {
    pos: Vec3,
    normal: Vec3,
    u: Float,
    v: Float
};

pub type Triangle3D = struct {
    p0: Vec3,
    p1: Vec3,
    p2: Vec3,
    color_r: Int,
    color_g: Int,
    color_b: Int
};

pub type Mesh3D = struct {
    name: String,
    triangles: List[Triangle3D],
    triangle_count: Int
};

pub fn vertex3d_new(pos: Vec3, norm: Vec3) -> Vertex3D { return Vertex3D { pos: pos, normal: norm, u: 0.0, v: 0.0 }; }

pub fn triangle3d_new(p0: Vec3, p1: Vec3, p2: Vec3, r: Int, g: Int, b: Int) -> Triangle3D { return Triangle3D { p0: p0, p1: p1, p2: p2, color_r: r, color_g: g, color_b: b }; }

pub fn mesh3d_new(name: String, triangles: List[Triangle3D], count: Int) -> Mesh3D { return Mesh3D { name: name, triangles: triangles, triangle_count: count }; }

pub fn triangle3d_compute_normal(t: Triangle3D) -> Vec3 {
    let edge1: Vec3 = vec3_sub(t.p1, t.p0);
    let edge2: Vec3 = vec3_sub(t.p2, t.p0);
    return vec3_normalize(vec3_cross(edge1, edge2));
}

pub fn triangle3d_is_backface(t: Triangle3D, view_dir: Vec3) -> Bool {
    let norm: Vec3 = triangle3d_compute_normal(t);
    let d: Float = vec3_dot(norm, view_dir);
    return d > 0.0;
}

pub fn mesh3d_make_cube(size: Float, r: Int, g: Int, b: Int) -> Mesh3D {
    let mut tris: List[Triangle3D] = list_new();
    let h: Float = size * 0.5;

    let p0: Vec3 = Vec3 { x: 0.0 - h, y: 0.0 - h, z: h };
    let p1: Vec3 = Vec3 { x: h, y: 0.0 - h, z: h };
    let p2: Vec3 = Vec3 { x: h, y: h, z: h };
    let p3: Vec3 = Vec3 { x: 0.0 - h, y: h, z: h };

    let t0: Triangle3D = triangle3d_new(p0, p1, p2, r, g, b);
    let t1: Triangle3D = triangle3d_new(p0, p2, p3, r, g, b);
    tris = list_push(tris, t0);
    tris = list_push(tris, t1);

    let pb0: Vec3 = Vec3 { x: h, y: 0.0 - h, z: 0.0 - h };
    let pb1: Vec3 = Vec3 { x: 0.0 - h, y: 0.0 - h, z: 0.0 - h };
    let pb2: Vec3 = Vec3 { x: 0.0 - h, y: h, z: 0.0 - h };
    let pb3: Vec3 = Vec3 { x: h, y: h, z: 0.0 - h };

    let t2: Triangle3D = triangle3d_new(pb0, pb1, pb2, r, g, b);
    let t3: Triangle3D = triangle3d_new(pb0, pb2, pb3, r, g, b);
    tris = list_push(tris, t2);
    tris = list_push(tris, t3);

    return mesh3d_new("Cube", tris, 4);
}

pub fn mesh3d_make_pyramid(base_size: Float, height: Float, r: Int, g: Int, b: Int) -> Mesh3D {
    let mut tris: List[Triangle3D] = list_new();
    let h: Float = base_size * 0.5;
    let p_apex: Vec3 = Vec3 { x: 0.0, y: height, z: 0.0 };

    let p0: Vec3 = Vec3 { x: 0.0 - h, y: 0.0, z: h };
    let p1: Vec3 = Vec3 { x: h, y: 0.0, z: h };
    let p2: Vec3 = Vec3 { x: h, y: 0.0, z: 0.0 - h };
    let p3: Vec3 = Vec3 { x: 0.0 - h, y: 0.0, z: 0.0 - h };

    let t0: Triangle3D = triangle3d_new(p0, p1, p_apex, r, g, b);
    let t1: Triangle3D = triangle3d_new(p1, p2, p_apex, r, g, b);
    let t2: Triangle3D = triangle3d_new(p2, p3, p_apex, r, g, b);
    let t3: Triangle3D = triangle3d_new(p3, p0, p_apex, r, g, b);
    tris = list_push(tris, t0);
    tris = list_push(tris, t1);
    tris = list_push(tris, t2);
    tris = list_push(tris, t3);

    return mesh3d_new("Pyramid", tris, 4);
}
