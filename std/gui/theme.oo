// # GUI Theme & Visual Styling
//
// Logline: Color palettes, border configurations, and light/dark theme profiles for GUI widgets.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type Theme = struct {
    bg_color: Int,
    fg_color: Int,
    border_color: Int,
    accent_color: Int,
    font_size: Int,
    border_width: Int,
    is_dark: Bool
};

pub fn theme_new(bg: Int, fg: Int, border: Int, accent: Int, font_size: Int, border_width: Int, is_dark: Bool) -> Theme {
    return Theme {
        bg_color: bg,
        fg_color: fg,
        border_color: border,
        accent_color: accent,
        font_size: font_size,
        border_width: border_width,
        is_dark: is_dark
    };
}

pub fn theme_default() -> Theme {
    return Theme {
        bg_color: 16777215,
        fg_color: 0,
        border_color: 13421772,
        accent_color: 31231,
        font_size: 14,
        border_width: 1,
        is_dark: false
    };
}

pub fn theme_dark() -> Theme {
    return Theme {
        bg_color: 1973790,
        fg_color: 16777215,
        border_color: 3355443,
        accent_color: 690175,
        font_size: 14,
        border_width: 1,
        is_dark: true
    };
}

pub fn theme_set_bg_color(theme: Theme, color: Int) -> Theme {
    return Theme {
        bg_color: color,
        fg_color: theme.fg_color,
        border_color: theme.border_color,
        accent_color: theme.accent_color,
        font_size: theme.font_size,
        border_width: theme.border_width,
        is_dark: theme.is_dark
    };
}

pub fn theme_set_fg_color(theme: Theme, color: Int) -> Theme {
    return Theme {
        bg_color: theme.bg_color,
        fg_color: color,
        border_color: theme.border_color,
        accent_color: theme.accent_color,
        font_size: theme.font_size,
        border_width: theme.border_width,
        is_dark: theme.is_dark
    };
}

pub fn theme_set_border_color(theme: Theme, color: Int) -> Theme {
    return Theme {
        bg_color: theme.bg_color,
        fg_color: theme.fg_color,
        border_color: color,
        accent_color: theme.accent_color,
        font_size: theme.font_size,
        border_width: theme.border_width,
        is_dark: theme.is_dark
    };
}

pub fn theme_set_accent_color(theme: Theme, color: Int) -> Theme {
    return Theme {
        bg_color: theme.bg_color,
        fg_color: theme.fg_color,
        border_color: theme.border_color,
        accent_color: color,
        font_size: theme.font_size,
        border_width: theme.border_width,
        is_dark: theme.is_dark
    };
}

pub fn theme_set_font_size(theme: Theme, size: Int) -> Theme {
    return Theme {
        bg_color: theme.bg_color,
        fg_color: theme.fg_color,
        border_color: theme.border_color,
        accent_color: theme.accent_color,
        font_size: size,
        border_width: theme.border_width,
        is_dark: theme.is_dark
    };
}

pub fn theme_set_border_width(theme: Theme, width: Int) -> Theme {
    return Theme {
        bg_color: theme.bg_color,
        fg_color: theme.fg_color,
        border_color: theme.border_color,
        accent_color: theme.accent_color,
        font_size: theme.font_size,
        border_width: width,
        is_dark: theme.is_dark
    };
}

pub fn theme_is_dark(theme: Theme) -> Bool {
    return theme.is_dark;
}
