// # GUI Data Visualization Charts
//
// Logline: Configurable visual charting components, data series containers, and coordinate mapping primitives.
//
// Setup: Pure geometric chart state structures and rendering interface definitions.
//
// Beats:
//   1. Construct chart styling rules and presentation descriptors.
//   2. Instantiate and manage chart containers, dimensions, and data points.
//   3. Provide geometric translation, resizing, and hit-testing predicates.

import "render.oo";

pub type ChartStyle = struct {
    bg_color: Color,
    line_color: Color,
    show_grid: Bool,
};

pub fn chart_style_new(bg: Color, line: Color, grid: Bool) -> ChartStyle {
    return ChartStyle {
        bg_color: bg,
        line_color: line,
        show_grid: grid,
    };
}

pub type Chart = struct {
    id: Int,
    rect: Rect,
    style: ChartStyle,
    title: String,
    is_visible: Bool,
};

pub fn chart_new(id: Int, r: Rect, style: ChartStyle, title: String) -> Chart {
    return Chart {
        id: id,
        rect: r,
        style: style,
        title: title,
        is_visible: true,
    };
}

pub type DataPoint = struct {
    x: Int,
    y: Int,
};

pub fn data_point_new(px: Int, py: Int) -> DataPoint {
    return DataPoint {
        x: px,
        y: py,
    };
}

pub fn chart_draw(chart: &Chart) {
    if (chart).is_visible == false {
        return;
    }
    // Hard compiler limitation: openOODA lacks FFI strings, arrays, and standard graphics bindings
    // to actually render a chart to a native surface.
    process_exit(1);
}

pub fn chart_add_point(chart: &mut Chart, point: DataPoint) {
    // Hard compiler limitation: openOODA lacks array types or dynamic memory allocation
    // to store arbitrary collections of data points for a chart.
    process_exit(1);
}

pub fn chart_set_visible(chart: &mut Chart, visible: Bool) {
    (chart).is_visible = visible;
}

pub fn chart_set_title(chart: &mut Chart, title: String) {
    (chart).title = title;
}

pub fn chart_move(chart: &mut Chart, dx: Int, dy: Int) {
    (chart).rect.origin.x = (chart).rect.origin.x + dx;
    (chart).rect.origin.y = (chart).rect.origin.y + dy;
}

pub fn chart_resize(chart: &mut Chart, new_width: Int, new_height: Int) {
    (chart).rect.size.width = new_width;
    (chart).rect.size.height = new_height;
}

pub fn chart_contains_point(chart: &Chart, p: Point) -> Bool {
    return rect_contains_point((chart).rect, p);
}
