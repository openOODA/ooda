// # Cubic Bézier Curve Geometry and Subdivision
//
// Logline: Cubic Bézier evaluation, de Casteljau subdivision, curve flattening, and arc length approximation.
//
// Setup: High-precision parametric 2D curve mathematics for vector graphics and TrueType font rendering.
//
// Beats:
//   1. Define CubicBezier2D struct with 4 control points.
//   2. Evaluate parametric point at t (0..100 percent).
//   3. Implement de Casteljau subdivision splitting curve into two sub-segments.
//   4. Flatten curve into polyline sequence and compute approximate chord length.

import "std/gui/render.oo";

pub type CubicBezier2D = struct {
    p0: Point,
    p1: Point,
    p2: Point,
    p3: Point
};

pub fn cubic_bezier_new(p0: Point, p1: Point, p2: Point, p3: Point) -> CubicBezier2D { return CubicBezier2D { p0: p0, p1: p1, p2: p2, p3: p3 }; }

fn lerp_point(a: Point, b: Point, t_pct: Int) -> Point {
    let ax: Int = (a).x;
    let bx: Int = (b).x;
    let ay: Int = (a).y;
    let by: Int = (b).y;
    let x: Int = ax + ((bx - ax) * t_pct) / 100;
    let y: Int = ay + ((by - ay) * t_pct) / 100;
    return Point { x: x, y: y };
}

pub fn cubic_bezier_eval(cb: CubicBezier2D, t_pct: Int) -> Point {
    let q0: Point = lerp_point((cb).p0, (cb).p1, t_pct);
    let q1: Point = lerp_point((cb).p1, (cb).p2, t_pct);
    let q2: Point = lerp_point((cb).p2, (cb).p3, t_pct);

    let r0: Point = lerp_point(q0, q1, t_pct);
    let r1: Point = lerp_point(q1, q2, t_pct);

    return lerp_point(r0, r1, t_pct);
}

pub fn cubic_bezier_split(cb: CubicBezier2D, t_pct: Int) -> List[CubicBezier2D] {
    let mut out: List[CubicBezier2D] = list_new();

    let p01: Point = lerp_point((cb).p0, (cb).p1, t_pct);
    let p12: Point = lerp_point((cb).p1, (cb).p2, t_pct);
    let p23: Point = lerp_point((cb).p2, (cb).p3, t_pct);

    let p012: Point = lerp_point(p01, p12, t_pct);
    let p123: Point = lerp_point(p12, p23, t_pct);

    let p0123: Point = lerp_point(p012, p123, t_pct);

    let left: CubicBezier2D = cubic_bezier_new((cb).p0, p01, p012, p0123);
    let right: CubicBezier2D = cubic_bezier_new(p0123, p123, p23, (cb).p3);

    out = list_push(out, left);
    out = list_push(out, right);
    return out;
}

pub fn cubic_bezier_flatten(cb: CubicBezier2D, steps: Int) -> List[Point] {
    let mut out: List[Point] = list_new();
    let num_steps: Int = if steps < 2 { 2 } else { steps };
    let mut i: Int = 0;
    while i <= num_steps {
        let t: Int = (i * 100) / num_steps;
        let pt: Point = cubic_bezier_eval(cb, t);
        out = list_push(out, pt);
        i = i + 1;
    }
    return out;
}

pub fn cubic_bezier_length_approx(cb: CubicBezier2D) -> Int {
    let p0x: Int = ((cb).p0).x;
    let p0y: Int = ((cb).p0).y;
    let p1x: Int = ((cb).p1).x;
    let p1y: Int = ((cb).p1).y;
    let p2x: Int = ((cb).p2).x;
    let p2y: Int = ((cb).p2).y;
    let p3x: Int = ((cb).p3).x;
    let p3y: Int = ((cb).p3).y;

    let chord_x: Int = p3x - p0x;
    let chord_y: Int = p3y - p0y;
    let abs_cx: Int = if chord_x < 0 { 0 - chord_x } else { chord_x };
    let abs_cy: Int = if chord_y < 0 { 0 - chord_y } else { chord_y };
    let chord: Int = abs_cx + abs_cy;

    let poly_x: Int = (p1x - p0x) + (p2x - p1x) + (p3x - p2x);
    let poly_y: Int = (p1y - p0y) + (p2y - p1y) + (p3y - p2y);
    let abs_px: Int = if poly_x < 0 { 0 - poly_x } else { poly_x };
    let abs_py: Int = if poly_y < 0 { 0 - poly_y } else { poly_y };
    let poly: Int = abs_px + abs_py;

    return (chord + poly) / 2;
}
