// # 3D Camera System
//
// Logline: Perspective 3D camera with orbit controls, zoom, and view-projection matrix calculation.
//
// Setup: Generates coordinate space transformations for 3D world-to-screen rendering.
//
// Beats:
//   1. Define Camera3D configuration (position, target, up, fov, aspect ratio, clipping planes).
//   2. Calculate view and projection matrices via mat4_look_at and mat4_perspective.
//   3. Implement orbit camera rotation around focal target.
//   4. Implement distance zoom factor scaling.

import "std/gui/gui_3d_math.oo";

pub type Camera3D = struct {
    position: Vec3,
    target: Vec3,
    up: Vec3,
    fov_deg: Float,
    aspect: Float,
    near_z: Float,
    far_z: Float
};

pub fn camera3d_new(pos: Vec3, target: Vec3, fov_deg: Float, aspect: Float) -> Camera3D { return Camera3D {
        position: pos,
        target: target,
        up: Vec3 { x: 0.0, y: 1.0, z: 0.0 },
        fov_deg: fov_deg,
        aspect: aspect,
        near_z: 0.1,
        far_z: 100.0
    }; }

pub fn camera3d_view_matrix(cam: Camera3D) -> Mat4 { return mat4_look_at(cam.position, cam.target, cam.up); }

pub fn camera3d_proj_matrix(cam: Camera3D) -> Mat4 {
    let fov_rad: Float = cam.fov_deg * 0.017453292519943295;
    return mat4_perspective(fov_rad, cam.aspect, cam.near_z, cam.far_z);
}

pub fn camera3d_view_proj_matrix(cam: Camera3D) -> Mat4 {
    let v: Mat4 = camera3d_view_matrix(cam);
    let p: Mat4 = camera3d_proj_matrix(cam);
    return mat4_mul(p, v);
}

pub fn camera3d_orbit(cam: Camera3D, yaw_delta: Float, pitch_delta: Float) -> Camera3D {
    let offset: Vec3 = vec3_sub(cam.position, cam.target);
    let r_mat: Mat4 = mat4_rotate_y(yaw_delta);
    let v4: Vec4 = Vec4 { x: offset.x, y: offset.y, z: offset.z, w: 1.0 };
    let transformed: Vec4 = mat4_transform_vec4(r_mat, v4);
    let new_pos: Vec3 = Vec3 {
        x: cam.target.x + transformed.x,
        y: cam.target.y + transformed.y + pitch_delta,
        z: cam.target.z + transformed.z
    };
    return Camera3D {
        position: new_pos,
        target: cam.target,
        up: cam.up,
        fov_deg: cam.fov_deg,
        aspect: cam.aspect,
        near_z: cam.near_z,
        far_z: cam.far_z
    };
}

pub fn camera3d_zoom(cam: Camera3D, factor: Float) -> Camera3D {
    let offset: Vec3 = vec3_sub(cam.position, cam.target);
    let scaled: Vec3 = vec3_scale(offset, factor);
    let new_pos: Vec3 = vec3_add(cam.target, scaled);
    return Camera3D {
        position: new_pos,
        target: cam.target,
        up: cam.up,
        fov_deg: cam.fov_deg,
        aspect: cam.aspect,
        near_z: cam.near_z,
        far_z: cam.far_z
    };
}
