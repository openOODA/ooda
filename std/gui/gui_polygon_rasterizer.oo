// # Polygon Scanline Rasterizer and Stroker
//
// Logline: 2D polygon point-in-polygon hit-testing, scanline bounding rasterization, and outline stroking.
//
// Setup: Rasterizes closed vector polygons into 2D software render context buffers.
//
// Beats:
//   1. Define Polygon2D data structure.
//   2. Implement ray-casting point-in-polygon inclusion test.
//   3. Implement bounding-box scanline polygon fill algorithm.
//   4. Implement perimeter polygon edge stroking.

import "std/gui/render.oo";

pub type Polygon2D = struct {
    points: List[Point]
};

pub fn polygon_new() -> Polygon2D {
    let pts: List[Point] = list_new();
    return Polygon2D { points: pts };
}

pub fn polygon_add_point(poly: &mut Polygon2D, p: Point) {
    let mut pts: List[Point] = (poly).points;
    pts = list_push(pts, p);
    (poly).points = pts;
}

pub fn polygon_contains_point(poly: Polygon2D, p: Point) -> Bool {
    let pts: List[Point] = poly.points;
    let n: Int = list_len(pts);
    if n < 3 { return false; }

    let test_x: Int = (p).x;
    let test_y: Int = (p).y;
    let mut inside: Bool = false;

    let mut i: Int = 0;
    let mut j: Int = n - 1;
    while i < n {
        let pi: Point = list_get(pts, i);
        let pj: Point = list_get(pts, j);

        let yi: Int = (pi).y;
        let yj: Int = (pj).y;
        let xi: Int = (pi).x;
        let xj: Int = (pj).x;

        if ((yi > test_y) != (yj > test_y)) {
            let dy: Int = yj - yi;
            if dy != 0 {
                let intersect_x: Int = xi + ((test_y - yi) * (xj - xi)) / dy;
                if test_x < intersect_x {
                    inside = !inside;
                }
            }
        }
        j = i;
        i = i + 1;
    }
    return inside;
}

pub fn polygon_rasterize_fill(rctx: RenderContext, poly: Polygon2D, fill_rule: Int, c: Color) -> RenderContext {
    let pts: List[Point] = poly.points;
    let n: Int = list_len(pts);
    if n < 3 { return rctx; }

    let p0: Point = list_get(pts, 0);
    let mut min_x: Int = (p0).x;
    let mut max_x: Int = (p0).x;
    let mut min_y: Int = (p0).y;
    let mut max_y: Int = (p0).y;

    let mut i: Int = 1;
    while i < n {
        let pt: Point = list_get(pts, i);
        let ptx: Int = (pt).x;
        let pty: Int = (pt).y;
        if ptx < min_x { min_x = ptx; }
        if ptx > max_x { max_x = ptx; }
        if pty < min_y { min_y = pty; }
        if pty > max_y { max_y = pty; }
        i = i + 1;
    }

    if min_x < 0 { min_x = 0; }
    if min_y < 0 { min_y = 0; }
    if max_x >= (rctx).width { max_x = (rctx).width - 1; }
    if max_y >= (rctx).height { max_y = (rctx).height - 1; }

    let mut out: RenderContext = rctx;
    let mut y: Int = min_y;
    while y <= max_y {
        let mut x: Int = min_x;
        while x <= max_x {
            let cur_p: Point = Point { x: x, y: y };
            if polygon_contains_point(poly, cur_p) {
                out = render_draw_pixel(out, cur_p, c);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}

pub fn polygon_rasterize_stroke(rctx: RenderContext, poly: Polygon2D, line_width: Int, c: Color) -> RenderContext {
    let pts: List[Point] = poly.points;
    let n: Int = list_len(pts);
    if n < 2 { return rctx; }

    let mut out: RenderContext = rctx;
    let mut i: Int = 0;
    while i < n {
        let next_idx: Int = if (i + 1) == n { 0 } else { i + 1 };
        let p1: Point = list_get(pts, i);
        let p2: Point = list_get(pts, next_idx);
        out = render_draw_line(out, p1, p2, c);
        i = i + 1;
    }
    return out;
}
