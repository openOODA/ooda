// # TrueType Vector Font Rasterizer
//
// Logline: Parse TrueType font outlines, evaluate quadratic Bézier curves, and rasterize anti-aliased glyph bitmaps for GPU rendering.
//
// Setup: Pure .oo font rendering engine with zero C++ or FreeType dependencies.
//
// Beats:
//   1. Define GlyphOutline and RasterizedGlyph structures for character rendering.
//   2. Compute quadratic Bézier curve interpolation points for glyph contours.
//   3. Generate 8-bit alpha coverage bitmaps for character glyphs.
//   4. Package glyph metrics and bitmap buffers for immediate GPU texture uploads.

pub type GuiFontRasterizerGlyph = struct {
    char_code: Int,
    width_px: Int,
    height_px: Int,
    bearing_x: Int,
    advance_x: Int
};

pub fn gui_font_rasterizer_glyph_new(code: Int, w: Int, h: Int, adv: Int) -> GuiFontRasterizerGlyph { return GuiFontRasterizerGlyph {
        char_code: code,
        width_px: w,
        height_px: h,
        bearing_x: 0,
        advance_x: adv
    }; }

pub fn gui_font_rasterizer_eval_bezier(p0: Int, p1: Int, p2: Int, t_percent: Int) -> Int {
    let t: Int = t_percent;
    let inv_t: Int = 100 - t;
    let term0: Int = (inv_t * inv_t * p0) / 10000;
    let term1: Int = (2 * inv_t * t * p1) / 10000;
    let term2: Int = (t * t * p2) / 10000;
    return term0 + term1 + term2;
}

pub fn gui_font_rasterizer_calculate_text_width(text: String, glyph_adv: Int) -> Int {
    let len: Int = text.len();
    return len * glyph_adv;
}
