// # GUI Input State Manager
//
// Logline: Pointer tracking, keyboard state capturing, and rectangular hit detection for user input.
//
// Setup: Input state management and event polling interfaces.
//
// Beats:
//   1. Capture pointer positions, click states, and keyboard events.
//   2. Evaluate mouse containment within rectangular bounding boxes.
//   3. Provide fail-closed polling shims for native hardware input.

import "render.oo";
import "core.oo";

pub type InputState = struct {
    mouse_x: Int,
    mouse_y: Int,
    mouse_down: Bool,
    last_key: Int,
    is_active: Bool
};

pub fn input_state_new() -> InputState {
    return InputState {
        mouse_x: 0,
        mouse_y: 0,
        mouse_down: false,
        last_key: 0,
        is_active: true
    };
}

pub fn input_state_update_mouse(state: &mut InputState, x: Int, y: Int, down: Bool) {
    (state).mouse_x = x;
    (state).mouse_y = y;
    (state).mouse_down = down;
}

pub fn input_state_update_key(state: &mut InputState, key: Int) {
    (state).last_key = key;
}

pub fn input_state_clear_key(state: &mut InputState) {
    (state).last_key = 0;
}

pub fn input_state_is_mouse_in_rect(state: &InputState, r: Rect) -> Bool {
    let p = point_new((state).mouse_x, (state).mouse_y);
    return rect_contains_point(r, p);
}

pub fn poll_native_mouse() -> Point {
    // Hard compiler limitation: openOODA lacks standard graphics bindings
    // to actually poll native mouse input.
    process_exit(1);
    return point_new(0, 0);
}

pub fn poll_native_keyboard() -> Int {
    // Hard compiler limitation: openOODA lacks standard graphics bindings
    // to actually poll native keyboard input.
    process_exit(1);
    return 0;
}
