// # GUI Window and Input Event Dispatcher
//
// Logline: Desktop event loop queue, window targeting, keyboard/mouse routing, and event envelope dispatch.
//
// Setup: Decoupled event loop arbitration for window management and user interaction callbacks.
//
// Beats:
//   1. Define GuiEventEnvelope and GuiEventQueue structures.
//   2. Define GuiDispatcher tracking focused window and running state.
//   3. Implement FIFO event enqueueing and polling.
//   4. Dispatch batched events to target window listeners.

pub type GuiEventEnvelope = struct {
    event_type: Int, // 1: MouseMove, 2: MouseDown, 3: MouseUp, 4: KeyDown, 5: KeyUp, 6: Resize, 7: Close
    target_window_id: Int,
    x: Int,
    y: Int,
    key_code: Int,
    payload: String,
    timestamp_ms: Int
};

pub type GuiEventQueue = struct {
    events: List[GuiEventEnvelope]
};

pub type GuiDispatcher = struct {
    queue: GuiEventQueue,
    active_focus_id: Int,
    is_running: Bool
};

pub fn gui_event_queue_new() -> GuiEventQueue {
    let q: List[GuiEventEnvelope] = list_new();
    return GuiEventQueue { events: q };
}

pub fn gui_dispatcher_new() -> GuiDispatcher {
    let q: GuiEventQueue = gui_event_queue_new();
    return GuiDispatcher {
        queue: q,
        active_focus_id: 1,
        is_running: true
    };
}

pub fn gui_dispatcher_push_event(disp: &mut GuiDispatcher, ev: GuiEventEnvelope) {
    let q: GuiEventQueue = (disp).queue;
    let mut evs: List[GuiEventEnvelope] = (q).events;
    evs = list_push(evs, ev);
    (disp).queue = GuiEventQueue { events: evs };
}

pub fn gui_dispatcher_poll(disp: &mut GuiDispatcher) -> Result[GuiEventEnvelope, String] {
    let q: GuiEventQueue = (disp).queue;
    let evs: List[GuiEventEnvelope] = (q).events;
    let n: Int = list_len(evs);
    if n == 0 {
        return Err("ERR\tqueue_empty");
    }

    let first: GuiEventEnvelope = list_get(evs, 0);
    let mut remaining: List[GuiEventEnvelope] = list_new();
    let mut i: Int = 1;
    while i < n {
        remaining = list_push(remaining, list_get(evs, i));
        i = i + 1;
    }
    (disp).queue = GuiEventQueue { events: remaining };
    return Ok(first);
}

pub fn gui_dispatcher_dispatch_all(disp: &mut GuiDispatcher) -> Int {
    let q: GuiEventQueue = (disp).queue;
    let evs: List[GuiEventEnvelope] = (q).events;
    let count: Int = list_len(evs);
    (disp).queue = gui_event_queue_new();
    return count;
}
