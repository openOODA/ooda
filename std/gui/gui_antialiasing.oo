// # Xiaolin Wu Anti-Aliasing and Subpixel Coverage
//
// Logline: Anti-aliased line and circle rasterization using Xiaolin Wu subpixel blending.
//
// Setup: High-fidelity smooth curve and line drawing in 2D software render contexts.
//
// Beats:
//   1. Implement fractional alpha color blending between source and background pixels.
//   2. Implement Xiaolin Wu anti-aliased line rasterizer.
//   3. Implement subpixel anti-aliased circle outline rasterizer.
//   4. Implement anti-aliased polygon boundary drawing.

import "std/gui/render.oo";
import "std/gui/gui_polygon_rasterizer.oo";

pub fn color_blend_alpha(dst: Color, src: Color, alpha_256: Int) -> Color {
    let a: Int = if alpha_256 < 0 { 0 } else if alpha_256 > 255 { 255 } else { alpha_256 };
    let inv_a: Int = 255 - a;

    let nr: Int = (((src).r * a) + ((dst).r * inv_a)) / 255;
    let ng: Int = (((src).g * a) + ((dst).g * inv_a)) / 255;
    let nb: Int = (((src).b * a) + ((dst).b * inv_a)) / 255;

    return Color { r: nr, g: ng, b: nb, a: 255 };
}

pub fn aa_draw_line_xiaolin_wu(rctx: RenderContext, p0: Point, p1: Point, c: Color) -> RenderContext {
    let mut out: RenderContext = rctx;
    let mut x0: Int = (p0).x;
    let mut y0: Int = (p0).y;
    let mut x1: Int = (p1).x;
    let mut y1: Int = (p1).y;

    let dx: Int = if x1 > x0 { x1 - x0 } else { x0 - x1 };
    let dy: Int = if y1 > y0 { y1 - y0 } else { y0 - y1 };
    let steep: Bool = dy > dx;

    if steep {
        let t0 = x0; x0 = y0; y0 = t0;
        let t1 = x1; x1 = y1; y1 = t1;
    }
    if x0 > x1 {
        let tx = x0; x0 = x1; x1 = tx;
        let ty = y0; y0 = y1; y1 = ty;
    }

    let deltax: Int = x1 - x0;
    let deltay: Int = y1 - y0;
    let gradient: Int = if deltax == 0 { 1000 } else { (deltay * 1000) / deltax };

    let mut intery: Int = y0 * 1000;
    let mut x: Int = x0;
    while x <= x1 {
        let py: Int = intery / 1000;
        let frac: Int = ((intery % 1000) * 255) / 1000;
        let inv_frac: Int = 255 - (if frac < 0 { 0 - frac } else { frac });

        if steep {
            let col1 = color_blend_alpha(render_get_pixel(out, py, x), c, inv_frac);
            let col2 = color_blend_alpha(render_get_pixel(out, py + 1, x), c, 255 - inv_frac);
            out = render_draw_pixel(out, Point { x: py, y: x }, col1);
            out = render_draw_pixel(out, Point { x: py + 1, y: x }, col2);
        } else {
            let col1 = color_blend_alpha(render_get_pixel(out, x, py), c, inv_frac);
            let col2 = color_blend_alpha(render_get_pixel(out, x, py + 1), c, 255 - inv_frac);
            out = render_draw_pixel(out, Point { x: x, y: py }, col1);
            out = render_draw_pixel(out, Point { x: x, y: py + 1 }, col2);
        }
        intery = intery + gradient;
        x = x + 1;
    }
    return out;
}

pub fn aa_draw_circle(rctx: RenderContext, center: Point, radius: Int, c: Color) -> RenderContext {
    let mut out: RenderContext = rctx;
    let cx: Int = (center).x;
    let cy: Int = (center).y;
    let r2: Int = radius * radius;

    let mut y: Int = 0 - radius;
    while y <= radius {
        let mut x: Int = 0 - radius;
        while x <= radius {
            let dist2: Int = x * x + y * y;
            let diff: Int = if dist2 > r2 { dist2 - r2 } else { r2 - dist2 };
            if diff <= (radius * 2) {
                let alpha: Int = 255 - (diff * 255) / (radius * 2 + 1);
                let px: Int = cx + x;
                let py: Int = cy + y;
                let bg_col: Color = render_get_pixel(out, px, py);
                let blend: Color = color_blend_alpha(bg_col, c, alpha);
                out = render_draw_pixel(out, Point { x: px, y: py }, blend);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}

pub fn aa_draw_polygon(rctx: RenderContext, poly: Polygon2D, c: Color) -> RenderContext {
    let pts: List[Point] = poly.points;
    let n: Int = list_len(pts);
    if n < 2 { return rctx; }

    let mut out: RenderContext = rctx;
    let mut i: Int = 0;
    while i < n {
        let next_idx: Int = if (i + 1) == n { 0 } else { i + 1 };
        let p1: Point = list_get(pts, i);
        let p2: Point = list_get(pts, next_idx);
        out = aa_draw_line_xiaolin_wu(out, p1, p2, c);
        i = i + 1;
    }
    return out;
}
