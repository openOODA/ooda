// # GUI Window Container
//
// Logline: Top-level window containers with title bars, focus management, and hit testing.
// residual: &mut destubbed to by-value.

type WinPoint = struct {
    x: Int,
    y: Int
};

type WinSize = struct {
    width: Int,
    height: Int
};

type WinRect = struct {
    origin: WinPoint,
    size: WinSize
};

type Window = struct {
    id: Int,
    rect: WinRect,
    title_height: Int,
    is_visible: Bool,
    is_focused: Bool
};

pub fn window_rect_new(x: Int, y: Int, w: Int, h: Int) -> WinRect {
    return WinRect {
        origin: WinPoint { x: x, y: y },
        size: WinSize { width: w, height: h }
    };
}

pub fn window_new(id: Int, r: WinRect) -> Window {
    return Window {
        id: id,
        rect: r,
        title_height: 20,
        is_visible: true,
        is_focused: false
    };
}

pub fn window_move(w: Window, dx: Int, dy: Int) -> Window {
    let r: WinRect = w.rect;
    let o: WinPoint = r.origin;
    let new_o: WinPoint = WinPoint { x: o.x + dx, y: o.y + dy };
    let new_r: WinRect = WinRect { origin: new_o, size: r.size };
    return Window {
        id: w.id,
        rect: new_r,
        title_height: w.title_height,
        is_visible: w.is_visible,
        is_focused: w.is_focused
    };
}

pub fn window_set_visible(w: Window, visible: Bool) -> Window {
    return Window {
        id: w.id,
        rect: w.rect,
        title_height: w.title_height,
        is_visible: visible,
        is_focused: w.is_focused
    };
}

pub fn window_set_focus(w: Window, focused: Bool) -> Window {
    return Window {
        id: w.id,
        rect: w.rect,
        title_height: w.title_height,
        is_visible: w.is_visible,
        is_focused: focused
    };
}

pub fn window_title_fill(w: Window) -> Int {
    if w.is_visible == false {
        return 0;
    }
    if w.is_focused {
        return 50;
    }
    return 100;
}

pub fn window_hit_test(w: Window, px: Int, py: Int) -> Bool {
    if w.is_visible == false {
        return false;
    }
    let r: WinRect = w.rect;
    let ox: Int = r.origin.x;
    let oy: Int = r.origin.y;
    let rw: Int = r.size.width;
    let rh: Int = r.size.height;
    if px < ox {
        return false;
    }
    if px > ox + rw {
        return false;
    }
    if py < oy {
        return false;
    }
    if py > oy + rh {
        return false;
    }
    return true;
}
