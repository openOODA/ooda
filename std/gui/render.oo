// # Software GUI Rendering Engine
//
// Logline: Software 2D pixel buffer operations, shape drawing routines, and color primitives for GUI elements.
//
// Setup: Pure computational rasterizer operating on in-memory color pixel buffers.
//
// Beats:
//   1. Define primitive geometry and color data structures.
//   2. Allocate and clear 2D pixel render buffers.
//   3. Draw pixels, filled rectangles, lines, circles, and rectangle outlines.

pub type Color = struct {
    r: Int,
    g: Int,
    b: Int,
    a: Int,
};

pub fn color_new(r: Int, g: Int, b: Int, a: Int) -> Color {
    return Color { r: r, g: g, b: b, a: a };
}

pub type Point = struct {
    x: Int,
    y: Int,
};

pub fn point_new(x: Int, y: Int) -> Point {
    return Point { x: x, y: y };
}

pub type Size = struct {
    width: Int,
    height: Int,
};

pub fn size_new(width: Int, height: Int) -> Size {
    return Size { width: width, height: height };
}

pub type Rect = struct {
    origin: Point,
    size: Size,
};

pub fn rect_new(x: Int, y: Int, w: Int, h: Int) -> Rect {
    return Rect {
        origin: Point { x: x, y: y },
        size: Size { width: w, height: h },
    };
}

pub fn rect_contains_point(r: Rect, p: Point) -> Bool {
    let px = (p).x;
    let py = (p).y;
    let rx = ((r).origin).x;
    let ry = ((r).origin).y;
    let rw = ((r).size).width;
    let rh = ((r).size).height;
    if px < rx { return false; }
    if px > rx + rw { return false; }
    if py < ry { return false; }
    if py > ry + rh { return false; }
    return true;
}

pub type Circle = struct {
    center: Point,
    radius: Int,
};

pub fn circle_new(center: Point, radius: Int) -> Circle {
    return Circle { center: center, radius: radius };
}

pub type RenderContext = struct {
    width: Int,
    height: Int,
    pixels: [Color],
};

pub fn render_context_new(width: Int, height: Int) -> RenderContext {
    let mut pixels: [Color] = [];
    let mut i = 0;
    let total = width * height;
    let bg_color = color_new(0, 0, 0, 255);
    while i < total {
        pixels.push(bg_color);
        i = i + 1;
    }
    return RenderContext { width: width, height: height, pixels: pixels };
}

pub fn render_clear(rctx: RenderContext, c: Color) -> RenderContext {
    let mut pixels = (rctx).pixels;
    let w = (rctx).width;
    let h = (rctx).height;
    let mut i = 0;
    let total = w * h;
    while i < total {
        pixels[i] = c;
        i = i + 1;
    }
    return RenderContext { width: w, height: h, pixels: pixels };
}

pub fn render_draw_pixel(rctx: RenderContext, p: Point, c: Color) -> RenderContext {
    let mut pixels = (rctx).pixels;
    let w = (rctx).width;
    let h = (rctx).height;
    let x = (p).x;
    let y = (p).y;
    if x >= 0 {
        if x < w {
            if y >= 0 {
                if y < h {
                    pixels[(y * w) + x] = c;
                }
            }
        }
    }
    return RenderContext { width: w, height: h, pixels: pixels };
}

pub fn render_fill_rect(rctx: RenderContext, r: Rect, c: Color) -> RenderContext {
    let mut pixels = (rctx).pixels;
    let w = (rctx).width;
    let h = (rctx).height;
    let r_x = ((r).origin).x;
    let r_y = ((r).origin).y;
    let r_w = ((r).size).width;
    let r_h = ((r).size).height;
    let mut y_i = 0;
    while y_i < r_h {
        let mut x_i = 0;
        let cy = r_y + y_i;
        while x_i < r_w {
            let cx = r_x + x_i;
            if cx >= 0 {
                if cx < w {
                    if cy >= 0 {
                        if cy < h {
                            pixels[(cy * w) + cx] = c;
                        }
                    }
                }
            }
            x_i = x_i + 1;
        }
        y_i = y_i + 1;
    }
    return RenderContext { width: w, height: h, pixels: pixels };
}

pub fn render_draw_line(rctx: RenderContext, p1: Point, p2: Point, c: Color) -> RenderContext {
    let mut pixels = (rctx).pixels;
    let w = (rctx).width;
    let h = (rctx).height;
    let mut x0 = (p1).x;
    let mut y0 = (p1).y;
    let x1 = (p2).x;
    let y1 = (p2).y;
    let mut dx = x1 - x0;
    if dx < 0 { dx = 0 - dx; }
    let mut dy = y1 - y0;
    if dy < 0 { dy = 0 - dy; }
    let mut sx = -1;
    if x0 < x1 { sx = 1; }
    let mut sy = -1;
    if y0 < y1 { sy = 1; }
    let mut err = dx - dy;
    let mut done = false;
    while !done {
        if x0 >= 0 {
            if x0 < w {
                if y0 >= 0 {
                    if y0 < h {
                        pixels[(y0 * w) + x0] = c;
                    }
                }
            }
        }
        if x0 == x1 {
            if y0 == y1 {
                done = true;
            }
        }
        if !done {
            let e2 = 2 * err;
            if e2 > (0 - dy) {
                err = err - dy;
                x0 = x0 + sx;
            }
            if e2 < dx {
                err = err + dx;
                y0 = y0 + sy;
            }
        }
    }
    return RenderContext { width: w, height: h, pixels: pixels };
}

pub fn render_draw_circle(rctx: RenderContext, circle: Circle, c: Color) -> RenderContext {
    let mut pixels = (rctx).pixels;
    let w = (rctx).width;
    let h = (rctx).height;
    let cx = ((circle).center).x;
    let cy = ((circle).center).y;
    let r = (circle).radius;
    let mut x = r;
    let mut y = 0;
    let mut err = 0;
    while x >= y {
        let px1 = cx + x; let py1 = cy + y;
        let px2 = cx + y; let py2 = cy + x;
        let px3 = cx - y; let py3 = cy + x;
        let px4 = cx - x; let py4 = cy + y;
        let px5 = cx - x; let py5 = cy - y;
        let px6 = cx - y; let py6 = cy - x;
        let px7 = cx + y; let py7 = cy - x;
        let px8 = cx + x; let py8 = cy - y;
        if px1 >= 0 { if px1 < w { if py1 >= 0 { if py1 < h { pixels[(py1 * w) + px1] = c; } } } }
        if px2 >= 0 { if px2 < w { if py2 >= 0 { if py2 < h { pixels[(py2 * w) + px2] = c; } } } }
        if px3 >= 0 { if px3 < w { if py3 >= 0 { if py3 < h { pixels[(py3 * w) + px3] = c; } } } }
        if px4 >= 0 { if px4 < w { if py4 >= 0 { if py4 < h { pixels[(py4 * w) + px4] = c; } } } }
        if px5 >= 0 { if px5 < w { if py5 >= 0 { if py5 < h { pixels[(py5 * w) + px5] = c; } } } }
        if px6 >= 0 { if px6 < w { if py6 >= 0 { if py6 < h { pixels[(py6 * w) + px6] = c; } } } }
        if px7 >= 0 { if px7 < w { if py7 >= 0 { if py7 < h { pixels[(py7 * w) + px7] = c; } } } }
        if px8 >= 0 { if px8 < w { if py8 >= 0 { if py8 < h { pixels[(py8 * w) + px8] = c; } } } }
        if err <= 0 { y = y + 1; err = err + (2 * y) + 1; }
        if err > 0 { x = x - 1; err = err - (2 * x) + 1; }
    }
    return RenderContext { width: w, height: h, pixels: pixels };
}

pub fn render_draw_rect(rctx: RenderContext, r: Rect, c: Color) -> RenderContext {
    let p1 = Point { x: ((r).origin).x, y: ((r).origin).y };
    let p2 = Point { x: ((r).origin).x + ((r).size).width, y: ((r).origin).y };
    let p3 = Point { x: ((r).origin).x + ((r).size).width, y: ((r).origin).y + ((r).size).height };
    let p4 = Point { x: ((r).origin).x, y: ((r).origin).y + ((r).size).height };
    let ctx1 = render_draw_line(rctx, p1, p2, c);
    let ctx2 = render_draw_line(ctx1, p2, p3, c);
    let ctx3 = render_draw_line(ctx2, p3, p4, c);
    return render_draw_line(ctx3, p4, p1, c);
}
