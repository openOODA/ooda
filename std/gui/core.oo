// # GUI Core Context & Event Dispatcher
//
// Logline: Central GUI viewport state tracking, window focus arbitration, and event modeling.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type GuiContext = struct {
    width: Int,
    height: Int,
    is_active: Bool,
    focused_window_id: Int
};

pub fn gui_context_new(width: Int, height: Int) -> GuiContext {
    return GuiContext {
        width: width,
        height: height,
        is_active: true,
        focused_window_id: 0
    };
}

pub fn gui_context_resize(ctx: GuiContext, new_width: Int, new_height: Int) -> GuiContext {
    return GuiContext {
        width: new_width,
        height: new_height,
        is_active: ctx.is_active,
        focused_window_id: ctx.focused_window_id
    };
}

pub fn gui_context_set_focus(ctx: GuiContext, window_id: Int) -> GuiContext {
    return GuiContext {
        width: ctx.width,
        height: ctx.height,
        is_active: ctx.is_active,
        focused_window_id: window_id
    };
}

pub fn gui_context_get_focus(ctx: GuiContext) -> Int {
    return ctx.focused_window_id;
}

type GuiEvent = struct {
    event_type: Int,
    target_id: Int,
    x: Int,
    y: Int
};

pub fn gui_event_new_click(target: Int, x: Int, y: Int) -> GuiEvent {
    return GuiEvent {
        event_type: 1,
        target_id: target,
        x: x,
        y: y
    };
}
