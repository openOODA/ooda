// # GUI Layout Geometry Engine
//
// Logline: Spatial bounding boxes, intersection calculus, and container alignment algorithms.
//
// Setup: Pure geometric computation for 2D interface positioning.
//
// Beats:
//   1. Construct bounding boxes, 2D points, and dimension descriptors.
//   2. Compute geometric intersections and unions across bounding boxes.
//   3. Calculate centered and flex layout arrangements.

pub type Rect = struct {
    x: Int,
    y: Int,
    width: Int,
    height: Int,
};

pub type Point = struct {
    x: Int,
    y: Int,
};

pub type Size = struct {
    width: Int,
    height: Int,
};

pub fn rect_new(x: Int, y: Int, w: Int, h: Int) -> Rect {
    return Rect {
        x: x,
        y: y,
        width: w,
        height: h,
    };
}

pub fn point_new(x: Int, y: Int) -> Point {
    return Point {
        x: x,
        y: y,
    };
}

pub fn size_new(w: Int, h: Int) -> Size {
    return Size {
        width: w,
        height: h,
    };
}

pub fn rect_intersect(a: Rect, b: Rect) -> Rect {
    let mut x1 = (a).x;
    if (b).x > x1 {
        x1 = (b).x;
    }
    
    let mut y1 = (a).y;
    if (b).y > y1 {
        y1 = (b).y;
    }
    
    let mut x2 = (a).x + (a).width;
    if ((b).x + (b).width) < x2 {
        x2 = (b).x + (b).width;
    }
    
    let mut y2 = (a).y + (a).height;
    if ((b).y + (b).height) < y2 {
        y2 = (b).y + (b).height;
    }
    
    let mut w = x2 - x1;
    if w < 0 {
        w = 0;
    }
    
    let mut h = y2 - y1;
    if h < 0 {
        h = 0;
    }
    
    return Rect {
        x: x1,
        y: y1,
        width: w,
        height: h,
    };
}

pub fn rect_union(a: Rect, b: Rect) -> Rect {
    let mut x1 = (a).x;
    if (b).x < x1 {
        x1 = (b).x;
    }
    
    let mut y1 = (a).y;
    if (b).y < y1 {
        y1 = (b).y;
    }
    
    let mut x2 = (a).x + (a).width;
    if ((b).x + (b).width) > x2 {
        x2 = (b).x + (b).width;
    }
    
    let mut y2 = (a).y + (a).height;
    if ((b).y + (b).height) > y2 {
        y2 = (b).y + (b).height;
    }
    
    return Rect {
        x: x1,
        y: y1,
        width: x2 - x1,
        height: y2 - y1,
    };
}

pub type Layout = struct {
    bounds: Rect,
};

pub fn layout_init(bounds: Rect) -> Layout {
    return Layout {
        bounds: bounds,
    };
}

pub fn layout_center(l: &Layout, child_size: Size) -> Rect {
    let bounds = (l).bounds;
    let cx = (bounds).x + (bounds).width / 2;
    let cy = (bounds).y + (bounds).height / 2;
    
    let cw = (child_size).width;
    let ch = (child_size).height;
    
    return Rect {
        x: cx - cw / 2,
        y: cy - ch / 2,
        width: cw,
        height: ch,
    };
}

pub fn layout_flex(l: &Layout) -> Rect {
    // Hard compiler limitation: openOODA lacks arrays, pointers, and dynamic memory to represent a dynamic list of child nodes for a complex flexbox/grid layout.
    process_exit(1);
    return Rect { x: 0, y: 0, width: 0, height: 0 };
}
