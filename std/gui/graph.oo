// # GUI 2D Graph Viewport
//
// Logline: Configurable 2D plotting surface with viewport projection, zoom/pan transforms.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type GraphView = struct {
    ox: Int,
    oy: Int,
    width: Int,
    height: Int,
    is_visible: Bool,
    zoom_level: Int,
    pan_x: Int,
    pan_y: Int,
    min_x: Int,
    max_x: Int,
    min_y: Int,
    max_y: Int,
    show_grid: Bool,
    show_labels: Bool
};

pub fn graph_view_new(ox: Int, oy: Int, width: Int, height: Int) -> GraphView {
    return GraphView {
        ox: ox,
        oy: oy,
        width: width,
        height: height,
        is_visible: true,
        zoom_level: 100,
        pan_x: 0,
        pan_y: 0,
        min_x: 0,
        max_x: 100,
        min_y: 0,
        max_y: 100,
        show_grid: true,
        show_labels: true
    };
}

pub fn graph_view_set_visible(g: GraphView, visible: Bool) -> GraphView {
    return GraphView {
        ox: g.ox,
        oy: g.oy,
        width: g.width,
        height: g.height,
        is_visible: visible,
        zoom_level: g.zoom_level,
        pan_x: g.pan_x,
        pan_y: g.pan_y,
        min_x: g.min_x,
        max_x: g.max_x,
        min_y: g.min_y,
        max_y: g.max_y,
        show_grid: g.show_grid,
        show_labels: g.show_labels
    };
}

pub fn graph_view_pan(g: GraphView, dx: Int, dy: Int) -> GraphView {
    return GraphView {
        ox: g.ox,
        oy: g.oy,
        width: g.width,
        height: g.height,
        is_visible: g.is_visible,
        zoom_level: g.zoom_level,
        pan_x: g.pan_x + dx,
        pan_y: g.pan_y + dy,
        min_x: g.min_x,
        max_x: g.max_x,
        min_y: g.min_y,
        max_y: g.max_y,
        show_grid: g.show_grid,
        show_labels: g.show_labels
    };
}

pub fn graph_view_zoom(g: GraphView, delta: Int) -> GraphView {
    let mut z: Int = g.zoom_level + delta;
    if z < 10 {
        z = 10;
    }
    return GraphView {
        ox: g.ox,
        oy: g.oy,
        width: g.width,
        height: g.height,
        is_visible: g.is_visible,
        zoom_level: z,
        pan_x: g.pan_x,
        pan_y: g.pan_y,
        min_x: g.min_x,
        max_x: g.max_x,
        min_y: g.min_y,
        max_y: g.max_y,
        show_grid: g.show_grid,
        show_labels: g.show_labels
    };
}

pub fn graph_view_set_range(g: GraphView, min_x: Int, max_x: Int, min_y: Int, max_y: Int) -> GraphView {
    return GraphView {
        ox: g.ox,
        oy: g.oy,
        width: g.width,
        height: g.height,
        is_visible: g.is_visible,
        zoom_level: g.zoom_level,
        pan_x: g.pan_x,
        pan_y: g.pan_y,
        min_x: min_x,
        max_x: max_x,
        min_y: min_y,
        max_y: max_y,
        show_grid: g.show_grid,
        show_labels: g.show_labels
    };
}

pub fn graph_view_project_x(g: GraphView, data_x: Int) -> Int {
    let range_x: Int = g.max_x - g.min_x;
    let w: Int = g.width;
    let mut screen_x: Int = 0;
    if range_x > 0 {
        screen_x = ((data_x - g.min_x) * w) / range_x;
    }
    screen_x = ((screen_x * g.zoom_level) / 100) + g.pan_x;
    return screen_x + g.ox;
}

pub fn graph_view_project_y(g: GraphView, data_y: Int) -> Int {
    let range_y: Int = g.max_y - g.min_y;
    let h: Int = g.height;
    let mut screen_y: Int = 0;
    if range_y > 0 {
        screen_y = h - (((data_y - g.min_y) * h) / range_y);
    }
    screen_y = ((screen_y * g.zoom_level) / 100) + g.pan_y;
    return screen_y + g.oy;
}

pub fn graph_view_grid_col_width(g: GraphView) -> Int {
    return g.width / 5;
}
