// # 3D Vector and 4x4 Matrix Mathematics
//
// Logline: Pure vector and matrix math library supporting 3D transformations, projections, and coordinate spaces.
//
// Setup: Double-precision floating point math for 3D graphic geometry and camera pipelines.
//
// Beats:
//   1. Define Vec3, Vec4, and 4x4 row-major transformation Matrix structures.
//   2. Implement vector addition, dot product, cross product, length, and normalization.
//   3. Implement 4x4 matrix multiplication, translation, scaling, and rotation.
//   4. Implement perspective projection and look-at view matrix generators.

import "std/math.oo";

pub type Vec3 = struct {
    x: Float,
    y: Float,
    z: Float
};

pub type Vec4 = struct {
    x: Float,
    y: Float,
    z: Float,
    w: Float
};

pub type Mat4 = struct {
    m00: Float, m01: Float, m02: Float, m03: Float,
    m10: Float, m11: Float, m12: Float, m13: Float,
    m20: Float, m21: Float, m22: Float, m23: Float,
    m30: Float, m31: Float, m32: Float, m33: Float
};

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vec3 { return Vec3 { x: x, y: y, z: z }; }

pub fn vec3_add(a: Vec3, b: Vec3) -> Vec3 { return Vec3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }; }

pub fn vec3_sub(a: Vec3, b: Vec3) -> Vec3 { return Vec3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }; }

pub fn vec3_scale(v: Vec3, s: Float) -> Vec3 { return Vec3 { x: v.x * s, y: v.y * s, z: v.z * s }; }

pub fn vec3_dot(a: Vec3, b: Vec3) -> Float { return a.x * b.x + a.y * b.y + a.z * b.z; }

pub fn vec3_cross(a: Vec3, b: Vec3) -> Vec3 { return Vec3 {
        x: a.y * b.z - a.z * b.y,
        y: a.z * b.x - a.x * b.z,
        z: a.x * b.y - a.y * b.x
    }; }

pub fn vec3_length(v: Vec3) -> Float {
    let d: Float = vec3_dot(v, v);
    return math_sqrt(d);
}

pub fn vec3_normalize(v: Vec3) -> Vec3 {
    let len: Float = vec3_length(v);
    if len <= 0.000001 { return Vec3 { x: 0.0, y: 0.0, z: 0.0 }; }
    return Vec3 { x: v.x / len, y: v.y / len, z: v.z / len };
}

pub fn mat4_identity() -> Mat4 { return Mat4 {
        m00: 1.0, m01: 0.0, m02: 0.0, m03: 0.0,
        m10: 0.0, m11: 1.0, m12: 0.0, m13: 0.0,
        m20: 0.0, m21: 0.0, m22: 1.0, m23: 0.0,
        m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    }; }

pub fn mat4_mul(a: Mat4, b: Mat4) -> Mat4 { return Mat4 {
        m00: a.m00 * b.m00 + a.m01 * b.m10 + a.m02 * b.m20 + a.m03 * b.m30,
        m01: a.m00 * b.m01 + a.m01 * b.m11 + a.m02 * b.m21 + a.m03 * b.m31,
        m02: a.m00 * b.m02 + a.m01 * b.m12 + a.m02 * b.m22 + a.m03 * b.m32,
        m03: a.m00 * b.m03 + a.m01 * b.m13 + a.m02 * b.m23 + a.m03 * b.m33,

        m10: a.m10 * b.m00 + a.m11 * b.m10 + a.m12 * b.m20 + a.m13 * b.m30,
        m11: a.m10 * b.m01 + a.m11 * b.m11 + a.m12 * b.m21 + a.m13 * b.m31,
        m12: a.m10 * b.m02 + a.m11 * b.m12 + a.m12 * b.m22 + a.m13 * b.m32,
        m13: a.m10 * b.m03 + a.m11 * b.m13 + a.m12 * b.m23 + a.m13 * b.m33,

        m20: a.m20 * b.m00 + a.m21 * b.m10 + a.m22 * b.m20 + a.m23 * b.m30,
        m21: a.m20 * b.m01 + a.m21 * b.m11 + a.m22 * b.m21 + a.m23 * b.m31,
        m22: a.m20 * b.m02 + a.m21 * b.m12 + a.m22 * b.m22 + a.m23 * b.m32,
        m23: a.m20 * b.m03 + a.m21 * b.m13 + a.m22 * b.m23 + a.m23 * b.m33,

        m30: a.m30 * b.m00 + a.m31 * b.m10 + a.m32 * b.m20 + a.m33 * b.m30,
        m31: a.m30 * b.m01 + a.m31 * b.m11 + a.m32 * b.m21 + a.m33 * b.m31,
        m32: a.m30 * b.m02 + a.m31 * b.m12 + a.m32 * b.m22 + a.m33 * b.m32,
        m33: a.m30 * b.m03 + a.m31 * b.m13 + a.m32 * b.m23 + a.m33 * b.m33
    }; }

pub fn mat4_translate(tx: Float, ty: Float, tz: Float) -> Mat4 {
    let mut m: Mat4 = mat4_identity();
    m.m03 = tx;
    m.m13 = ty;
    m.m23 = tz;
    return m;
}

pub fn mat4_scale(sx: Float, sy: Float, sz: Float) -> Mat4 {
    let mut m: Mat4 = mat4_identity();
    m.m00 = sx;
    m.m11 = sy;
    m.m22 = sz;
    return m;
}

pub fn mat4_rotate_y(rad: Float) -> Mat4 {
    let c: Float = math_cos(rad);
    let s: Float = math_sin(rad);
    let mut m: Mat4 = mat4_identity();
    m.m00 = c;
    m.m02 = s;
    m.m20 = 0.0 - s;
    m.m22 = c;
    return m;
}

pub fn mat4_perspective(fov_rad: Float, aspect: Float, near_z: Float, far_z: Float) -> Mat4 {
    let half_fov: Float = fov_rad * 0.5;
    let tan_half: Float = math_sin(half_fov) / math_cos(half_fov);
    let f: Float = 1.0 / tan_half;
    let range: Float = near_z - far_z;

    return Mat4 {
        m00: f / aspect, m01: 0.0, m02: 0.0, m03: 0.0,
        m10: 0.0, m11: f, m12: 0.0, m13: 0.0,
        m20: 0.0, m21: 0.0, m22: (far_z + near_z) / range, m23: (2.0 * far_z * near_z) / range,
        m30: 0.0, m31: 0.0, m32: 0.0 - 1.0, m33: 0.0
    };
}

pub fn mat4_look_at(eye: Vec3, target: Vec3, up: Vec3) -> Mat4 {
    let f: Vec3 = vec3_normalize(vec3_sub(target, eye));
    let s: Vec3 = vec3_normalize(vec3_cross(f, up));
    let u: Vec3 = vec3_cross(s, f);

    return Mat4 {
        m00: s.x, m01: s.y, m02: s.z, m03: 0.0 - vec3_dot(s, eye),
        m10: u.x, m11: u.y, m12: u.z, m13: 0.0 - vec3_dot(u, eye),
        m20: 0.0 - f.x, m21: 0.0 - f.y, m22: 0.0 - f.z, m23: vec3_dot(f, eye),
        m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    };
}

pub fn mat4_transform_vec4(m: Mat4, v: Vec4) -> Vec4 { return Vec4 {
        x: m.m00 * v.x + m.m01 * v.y + m.m02 * v.z + m.m03 * v.w,
        y: m.m10 * v.x + m.m11 * v.y + m.m12 * v.z + m.m13 * v.w,
        z: m.m20 * v.x + m.m21 * v.y + m.m22 * v.z + m.m23 * v.w,
        w: m.m30 * v.x + m.m31 * v.y + m.m32 * v.z + m.m33 * v.w
    }; }
