// # Sovereign GUI Engine Facade
//
// Logline: Unified export facade for openOODA 2D/3D graphics, vector path rasterization, TrueType fonts, and GPU canvas.
//
// Setup: Re-exports graphical math, camera, mesh, pipeline, vector curves, antialiasing, and windowing dispatcher.
//
// Beats:
//   1. Import 2D software renderer, shapes, layouts, inputs, and widgets.
//   2. Import 3D math, camera, mesh primitives, and projection pipelines.
//   3. Import vector paths, cubic Bézier curves, polygon scanline rasterizer, and Xiaolin Wu anti-aliasing.
//   4. Import TrueType font parser, glyph cache, GPU canvas bridge, and event dispatcher.

import "./render.oo";
import "./layout.oo";
import "./window.oo";
import "./charts.oo";
import "./chat.oo";
import "./text.oo";
import "./input.oo";

import "./gui_3d_math.oo";
import "./gui_3d_camera.oo";
import "./gui_3d_mesh.oo";
import "./gui_3d_pipeline.oo";

import "./gui_bezier_cubic.oo";
import "./gui_vector_path.oo";
import "./gui_polygon_rasterizer.oo";
import "./gui_antialiasing.oo";

import "./gui_ttf_parser.oo";
import "./gui_glyph_cache.oo";
import "./gui_gpu_canvas.oo";
import "./gui_event_dispatcher.oo";

pub fn gui_engine_probe() -> Int {
    let c: Color = color_new(0, 0, 0, 255);
    let r: Rect = rect_new(0, 0, 100, 100);
    let win: Window = window_new(1, r, 20);
    let style: ChartStyle = chart_style_new(c, c, true);
    let mut chart: Chart = chart_new(1, r, style, "Chart");
    let chat_sess: ChatSession = chat_session_new(1, r);
    let gtxt: GuiText = gui_text_init(0, 0, "GUI", 1, 12);
    let inp: InputState = input_state_new();

    let v: Vec3 = vec3_new(0.0, 0.0, 0.0);
    let cam: Camera3D = camera3d_new(v, v, 60.0, 1.33);
    let mesh: Mesh3D = mesh3d_make_cube(1.0, 255, 0, 0);
    let mut rctx3d: RenderContext3D = render_context3d_new(100, 100);

    let p0: Point = Point { x: 0, y: 0 };
    let cb: CubicBezier2D = cubic_bezier_new(p0, p0, p0, p0);
    let mut vpath: VectorPath = vector_path_new();
    let mut poly: Polygon2D = polygon_new();
    let aa_col: Color = color_blend_alpha(c, c, 128);

    let ttf: TtfFont = ttf_font_parse_header(list_new());
    let mut gcache: GlyphCache = glyph_cache_new(16);
    let mut gcanvas: GpuCanvasContext = gpu_canvas_new(100, 100, 0);
    let mut gdisp: GuiDispatcher = gui_dispatcher_new();

    chart_set_visible(&mut chart, (win).is_visible);
    render_3d_draw_wireframe(&mut rctx3d, &mesh, mat4_identity(), aa_col);
    vector_path_move_to(&mut vpath, (p0).x, (p0).y);
    polygon_add_point(&mut poly, p0);
    let cam2: Camera3D = camera3d_zoom(cam, 1.0);
    let cb_len: Int = cubic_bezier_length_approx(cb);
    let total_sum: Int = (chat_sess).id + (gtxt).x + (inp).mouse_x + (ttf).num_tables + cb_len + (cam2).fov_deg.to_string().len();
    let n_gpu: Int = gpu_canvas_submit(&mut gcanvas);
    let n_disp: Int = gui_dispatcher_dispatch_all(&mut gdisp);
    return total_sum + n_gpu + n_disp;
}
