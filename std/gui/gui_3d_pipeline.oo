// # 3D Software Graphics Rasterization Pipeline
//
// Logline: 3D model-view-projection vertex transformations, wireframe rasterization, and flat-shaded triangle rendering.
//
// Setup: Bridges 3D math and mesh geometry with 2D software render buffer canvases.
//
// Beats:
//   1. Define RenderContext3D structure maintaining depth buffers and 2D color contexts.
//   2. Project 3D vertex coordinates into 2D screen viewport coordinates via MVP matrix.
//   3. Implement wireframe mesh rasterization connecting projected vertices.
//   4. Implement flat-shaded triangle rendering with directional lighting computation.

import "std/gui/gui_3d_math.oo";
import "std/gui/gui_3d_mesh.oo";
import "std/gui/render.oo";

pub type RenderContext3D = struct {
    width: Int,
    height: Int,
    color_buffer: RenderContext
};

fn int_to_f(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = if n < 0 { 0 - n } else { n };
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

fn f_to_int(val: Float) -> Int {
    let mut res: Int = 0;
    let mut temp: Float = val;
    if temp < 0.0 { temp = 0.0 - temp; }
    while temp >= 1000000.0 { res = res + 1000000; temp = temp - 1000000.0; }
    while temp >= 10000.0 { res = res + 10000; temp = temp - 10000.0; }
    while temp >= 100.0 { res = res + 100; temp = temp - 100.0; }
    while temp >= 1.0 { res = res + 1; temp = temp - 1.0; }
    if val < 0.0 { return 0 - res; }
    return res;
}

pub fn render_context3d_new(width: Int, height: Int) -> RenderContext3D {
    let ctx2d: RenderContext = render_context_new(width, height);
    return RenderContext3D {
        width: width,
        height: height,
        color_buffer: ctx2d
    };
}

pub fn render_context3d_clear(rctx: &mut RenderContext3D, bg_color: Color) {
    (rctx).color_buffer = render_clear((rctx).color_buffer, bg_color);
}

pub fn render_3d_project_vertex(v: Vec3, mvp: Mat4, screen_w: Int, screen_h: Int) -> Point {
    let v4: Vec4 = Vec4 { x: v.x, y: v.y, z: v.z, w: 1.0 };
    let clip: Vec4 = mat4_transform_vec4(mvp, v4);

    let mut w: Float = clip.w;
    if w <= 0.0001 && w >= (0.0 - 0.0001) { w = 1.0; }

    let ndc_x: Float = clip.x / w;
    let ndc_y: Float = clip.y / w;

    let sw_f: Float = int_to_f(screen_w);
    let sh_f: Float = int_to_f(screen_h);
    let sx: Float = (ndc_x + 1.0) * 0.5 * sw_f;
    let sy: Float = (1.0 - (ndc_y + 1.0) * 0.5) * sh_f;

    let px: Int = f_to_int(sx);
    let py: Int = f_to_int(sy);
    return Point { x: px, y: py };
}

pub fn render_3d_draw_wireframe(rctx: &mut RenderContext3D, mesh: &Mesh3D, mvp: Mat4, c: Color) {
    let tris: List[Triangle3D] = (mesh).triangles;
    let n: Int = list_len(tris);
    let sw: Int = (rctx).width;
    let sh: Int = (rctx).height;

    let mut i: Int = 0;
    while i < n {
        let tri: Triangle3D = list_get(tris, i);
        let p0: Point = render_3d_project_vertex(tri.p0, mvp, sw, sh);
        let p1: Point = render_3d_project_vertex(tri.p1, mvp, sw, sh);
        let p2: Point = render_3d_project_vertex(tri.p2, mvp, sw, sh);

        (rctx).color_buffer = render_draw_line((rctx).color_buffer, p0, p1, c);
        (rctx).color_buffer = render_draw_line((rctx).color_buffer, p1, p2, c);
        (rctx).color_buffer = render_draw_line((rctx).color_buffer, p2, p0, c);
        i = i + 1;
    }
}

pub fn render_3d_draw_flat_shaded(rctx: &mut RenderContext3D, mesh: &Mesh3D, mvp: Mat4, light_dir: Vec3) {
    let tris: List[Triangle3D] = (mesh).triangles;
    let n: Int = list_len(tris);
    let sw: Int = (rctx).width;
    let sh: Int = (rctx).height;
    let l_norm: Vec3 = vec3_normalize(light_dir);

    let mut i: Int = 0;
    while i < n {
        let tri: Triangle3D = list_get(tris, i);
        let norm: Vec3 = triangle3d_compute_normal(tri);
        let mut diff: Float = 0.0 - vec3_dot(norm, l_norm);
        if diff < 0.2 { diff = 0.2; }
        if diff > 1.0 { diff = 1.0; }

        let r_f: Float = int_to_f(tri.color_r) * diff;
        let g_f: Float = int_to_f(tri.color_g) * diff;
        let b_f: Float = int_to_f(tri.color_b) * diff;
        let c: Color = Color { r: f_to_int(r_f), g: f_to_int(g_f), b: f_to_int(b_f), a: 255 };

        let p0: Point = render_3d_project_vertex(tri.p0, mvp, sw, sh);
        let p1: Point = render_3d_project_vertex(tri.p1, mvp, sw, sh);
        let p2: Point = render_3d_project_vertex(tri.p2, mvp, sw, sh);

        (rctx).color_buffer = render_draw_line((rctx).color_buffer, p0, p1, c);
        (rctx).color_buffer = render_draw_line((rctx).color_buffer, p1, p2, c);
        (rctx).color_buffer = render_draw_line((rctx).color_buffer, p2, p0, c);
        i = i + 1;
    }
}
