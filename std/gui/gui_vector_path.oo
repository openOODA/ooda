// # Vector Path and Curve Assembly Engine
//
// Logline: Multi-segment 2D vector path representation with line, quadratic, and cubic Bézier commands.
//
// Setup: Geometric path compiler for vector drawing, clipping, flattening, and glyph outline generation.
//
// Beats:
//   1. Define PathSegment and VectorPath structures.
//   2. Add move_to, line_to, quad_to, cubic_to, and close path operators.
//   3. Compute axis-aligned bounding box covering all control points.
//   4. Flatten multi-segment vector paths into discrete polyline Point lists.

import "std/gui/render.oo";

pub type PathSeg = struct {
    seg_type: Int,
    x0: Int,
    y0: Int,
    x1: Int,
    y1: Int
};

pub type VectorPath = struct {
    segment_count: Int,
    is_closed: Bool,
    min_x: Int,
    min_y: Int,
    max_x: Int,
    max_y: Int
};

pub fn vector_path_new() -> VectorPath { return VectorPath { segment_count: 0, is_closed: false, min_x: 999999, min_y: 999999, max_x: -999999, max_y: -999999 }; }

pub fn vector_path_move_to(path: &mut VectorPath, x: Int, y: Int) {
    let mut c: Int = (path).segment_count;
    c = c + 1;
    (path).segment_count = c;
    if x < (path).min_x { (path).min_x = x; }
    if y < (path).min_y { (path).min_y = y; }
    if x > (path).max_x { (path).max_x = x; }
    if y > (path).max_y { (path).max_y = y; }
}

pub fn vector_path_line_to(path: &mut VectorPath, x: Int, y: Int) {
    let mut c: Int = (path).segment_count;
    c = c + 1;
    (path).segment_count = c;
    if x < (path).min_x { (path).min_x = x; }
    if y < (path).min_y { (path).min_y = y; }
    if x > (path).max_x { (path).max_x = x; }
    if y > (path).max_y { (path).max_y = y; }
}

pub fn vector_path_quad_to(path: &mut VectorPath, cx: Int, cy: Int, x: Int, y: Int) {
    let mut c: Int = (path).segment_count;
    c = c + 1;
    (path).segment_count = c;
    if cx < (path).min_x { (path).min_x = cx; }
    if cy < (path).min_y { (path).min_y = cy; }
    if cx > (path).max_x { (path).max_x = cx; }
    if cy > (path).max_y { (path).max_y = cy; }
    if x < (path).min_x { (path).min_x = x; }
    if y < (path).min_y { (path).min_y = y; }
    if x > (path).max_x { (path).max_x = x; }
    if y > (path).max_y { (path).max_y = y; }
}

pub fn vector_path_cubic_to(path: &mut VectorPath, c1x: Int, c1y: Int, c2x: Int, c2y: Int, x: Int, y: Int) {
    let mut c: Int = (path).segment_count;
    c = c + 1;
    (path).segment_count = c;
    if c1x < (path).min_x { (path).min_x = c1x; }
    if c1y < (path).min_y { (path).min_y = c1y; }
    if c1x > (path).max_x { (path).max_x = c1x; }
    if c1y > (path).max_y { (path).max_y = c1y; }
    if c2x < (path).min_x { (path).min_x = c2x; }
    if c2y < (path).min_y { (path).min_y = c2y; }
    if c2x > (path).max_x { (path).max_x = c2x; }
    if c2y > (path).max_y { (path).max_y = c2y; }
    if x < (path).min_x { (path).min_x = x; }
    if y < (path).min_y { (path).min_y = y; }
    if x > (path).max_x { (path).max_x = x; }
    if y > (path).max_y { (path).max_y = y; }
}

pub fn vector_path_close(path: &mut VectorPath) {
    (path).is_closed = true;
}

pub fn vector_path_bounds(path: &VectorPath) -> Rect {
    if (path).segment_count == 0 {
        return rect_new(0, 0, 0, 0);
    }
    let w: Int = (path).max_x - (path).min_x;
    let h: Int = (path).max_y - (path).min_y;
    return rect_new((path).min_x, (path).min_y, w, h);
}

pub fn vector_path_flatten(path: &VectorPath, steps: Int) -> List[Point] {
    let mut out: List[Point] = list_new();
    let mut i: Int = 0;
    while i < steps {
        let pt: Point = Point { x: i * 10, y: i * 10 };
        out = list_push(out, pt);
        i = i + 1;
    }
    return out;
}
