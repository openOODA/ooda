// # Kahan Compensated Summation
//
// Logline: Implements the Kahan summation algorithm for floating-point lists, which dramatically reduces numerical error compared to naive summation by tracking a running compensation term for lost low-order bits.
//
// Setup: Pure value-returning helpers, no IO. The accumulator holds a running sum and a compensation term c; new values are added via y = value - c; t = sum + y; c = (t - sum) - y; sum = t.
//
// Beats:
//   1. Construct a KahanAccumulator with initial sum=0.0 and compensation=0.0.
//   2. add(value) updates the running sum and compensation in one pass.
//   3. sum() returns the current compensated sum.
//   4. reset() zeroes the sum and compensation; finalize_sum() returns the sum and resets.

// Internal struct: KahanAccumulator (sum and compensation).
type KahanAccumulator = struct {
    sum: Float,
    comp: Float
};

pub fn kahan_new() -> KahanAccumulator { return KahanAccumulator { sum: 0.0, comp: 0.0 }; }

pub fn kahan_add(mut_a: &mut KahanAccumulator, value: Float) {
    let s: Float = (mut_a).sum;
    let c: Float = (mut_a).comp;
    let y: Float = value - c;
    let t: Float = s + y;
    let new_c: Float = (t - s) - y;
    (mut_a).sum = t;
    (mut_a).comp = new_c;
}

pub fn kahan_sum(a: &KahanAccumulator) -> Float { return (a).sum; }

pub fn kahan_compensation(a: &KahanAccumulator) -> Float { return (a).comp; }

pub fn kahan_reset(mut_a: &mut KahanAccumulator) {
    (mut_a).sum = 0.0;
    (mut_a).comp = 0.0;
}

pub fn kahan_finalize(mut_a: &mut KahanAccumulator) -> Float {
    let s: Float = (mut_a).sum;
    (mut_a).sum = 0.0;
    (mut_a).comp = 0.0;
    return s;
}

pub fn kahan_sum_list(values: List[Float]) -> Float {
    let mut acc: KahanAccumulator = kahan_new();
    let n: Int = list_len(values);
    let mut i: Int = 0;
    while i < n {
        kahan_add(&mut acc, list_get(values, i));
        i = i + 1;
    }
    return kahan_sum(&acc);
}
