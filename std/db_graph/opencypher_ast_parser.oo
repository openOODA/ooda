// # OpenCypher AST Parser
//
// Logline: Parses token streams into structured OpenCypher abstract syntax tree query representations.
//
// Setup: Recursive-descent parser handling MATCH, WHERE filter expressions, RETURN projections, and mutations.
//
// Beats:
//   1. Define CypherParser state tracker and error diagnostic structures.
//   2. Implement clause parsers for MATCH patterns, WHERE expressions, and RETURN items.
//   3. Assemble root CypherQueryAst objects with validated token streams.

import "./opencypher_ast_nodes.oo";
import "./opencypher_lexer.oo";

pub type CypherParseError = struct {
    has_error: Bool,
    message: String,
    line: Int,
    column: Int,
};

pub type CypherParser = struct {
    tokens: List[CypherToken],
    cursor: Int,
    token_count: Int,
    error: CypherParseError,
};

pub fn cypher_parser_new(toks: List[CypherToken]) -> CypherParser {
    let err = CypherParseError {
        has_error: false,
        message: "",
        line: 0,
        column: 0,
    };
    return CypherParser {
        tokens: toks,
        cursor: 0,
        token_count: list_len(toks),
        error: err,
    };
}

pub fn cypher_parser_peek(p: CypherParser) -> CypherToken {
    if (p).cursor < (p).token_count {
        return list_get((p).tokens, (p).cursor);
    }
    return cypher_token_new(0, "", 0, 0);
}

pub fn cypher_parser_advance(p: CypherParser) -> CypherParser {
    let next_cursor: Int = (p).cursor + 1;
    return CypherParser {
        tokens: (p).tokens,
        cursor: next_cursor,
        token_count: (p).token_count,
        error: (p).error,
    };
}

pub fn cypher_parse_match_pattern(
    var_name: String,
    label_name: String,
    rel_type: String,
    dst_var: String,
    dst_label: String
) -> CypherMatchClause {
    let src_node: CypherPatternNode = cypher_pattern_node_new(var_name, label_name);
    let dst_node: CypherPatternNode = cypher_pattern_node_new(dst_var, dst_label);
    let rel: CypherPatternRel = cypher_pattern_rel_new("r", rel_type, 1);

    return CypherMatchClause {
        is_optional: false,
        src_node: src_node,
        rel: rel,
        dst_node: dst_node,
        has_edge: rel_type != "",
    };
}

pub fn cypher_parse_where_pred(
    var_name: String,
    prop_key: String,
    op: Int,
    val_str: String,
    val_int: Int
) -> CypherWhereClause {
    return CypherWhereClause {
        has_filter: true,
        target_var: var_name,
        target_prop: prop_key,
        comparison_op: op,
        cmp_str_val: val_str,
        cmp_int_val: val_int,
    };
}

pub fn cypher_build_simple_query(
    qid: Int,
    src_v: String,
    src_lbl: String,
    ret_v: String,
    ret_p: String
) -> CypherQueryAst {
    let mut ast: CypherQueryAst = cypher_query_ast_new(qid);
    let match_cl: CypherMatchClause = cypher_parse_match_pattern(src_v, src_lbl, "", "", "");

    let mut ret_items: List[CypherReturnItem] = list_new();
    let r_item: CypherReturnItem = CypherReturnItem {
        var_name: ret_v,
        prop_name: ret_p,
        alias_name: "",
        is_aggregate: false,
        agg_func: "",
    };
    ret_items = list_push(ret_items, r_item);

    let ret_cl: CypherReturnClause = CypherReturnClause {
        distinct_rows: false,
        items: ret_items,
        limit_count: -1,
        skip_count: 0,
    };

    return CypherQueryAst {
        query_id: qid,
        match_clause: match_cl,
        where_clause: (ast).where_clause,
        return_clause: ret_cl,
        has_create: false,
        create_clause: (ast).create_clause,
    };
}
