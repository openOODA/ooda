// # Property Graph Bi-Temporal Storage Versioning
//
// Logline: Tracks valid-time and transaction-time intervals for time-travel graph queries and point-in-time state reconstruction.
//
// Setup: Associates time intervals [valid_from, valid_to] and [tx_from, tx_to] with graph entities.
//
// Beats:
//   1. Define TimeInterval, TemporalNodeVersion, and BiTemporalStore structures.
//   2. Query entity state at specified snapshot timestamps.
//   3. Insert new temporal versions while closing prior intervals.

pub type TimeInterval = struct {
    start_ts: Int,
    end_ts: Int, // MaxInt represents infinity / open interval
};

pub type TemporalNodeVersion = struct {
    node_id: Int,
    valid_time: TimeInterval,
    tx_time: TimeInterval,
    label_id: Int,
    prop_data: String,
    is_deleted: Bool,
};

pub type BiTemporalStore = struct {
    versions: List[TemporalNodeVersion],
    version_count: Int,
};

pub fn time_interval_new(start_t: Int, end_t: Int) -> TimeInterval {
    return TimeInterval {
        start_ts: start_t,
        end_ts: end_t,
    };
}

pub fn bi_temporal_store_new() -> BiTemporalStore {
    let empty_versions: List[TemporalNodeVersion] = list_new();
    return BiTemporalStore {
        versions: empty_versions,
        version_count: 0,
    };
}

pub fn temporal_node_version_new(
    nid: Int,
    v_start: Int,
    tx_start: Int,
    lbl: Int,
    props: String
) -> TemporalNodeVersion {
    let vt: TimeInterval = time_interval_new(v_start, 2147483647);
    let tt: TimeInterval = time_interval_new(tx_start, 2147483647);
    return TemporalNodeVersion {
        node_id: nid,
        valid_time: vt,
        tx_time: tt,
        label_id: lbl,
        prop_data: props,
        is_deleted: false,
    };
}

pub fn bi_temporal_store_add(
    store: BiTemporalStore,
    ver: TemporalNodeVersion
) -> BiTemporalStore {
    let updated: List[TemporalNodeVersion] = list_push((store).versions, ver);
    return BiTemporalStore {
        versions: updated,
        version_count: (store).version_count + 1,
    };
}

pub fn bi_temporal_store_as_of(
    store: BiTemporalStore,
    nid: Int,
    as_of_ts: Int
) -> TemporalNodeVersion {
    let n: Int = list_len((store).versions);
    let mut i: Int = 0;
    while i < n {
        let v: TemporalNodeVersion = list_get((store).versions, i);
        if (v).node_id == nid {
            let v_start: Int = ((v).valid_time).start_ts;
            let v_end: Int = ((v).valid_time).end_ts;
            if as_of_ts >= v_start && as_of_ts < v_end {
                return v;
            }
        }
        i = i + 1;
    }

    return temporal_node_version_new(-1, 0, 0, -1, "");
}
