// # OpenCypher AST Nodes
//
// Logline: Defines abstract syntax tree nodes for OpenCypher query clauses, expressions, and statements.
//
// Setup: Strongly-typed representation of graph query structures including MATCH, WHERE, RETURN, CREATE, and SET.
//
// Beats:
//   1. Define CypherClauseType and CypherLiteral AST structures.
//   2. Define CypherPatternElement and CypherExpression node types.
//   3. Implement constructors and query AST container definitions.

pub type CypherLiteralType = struct {
    kind: Int,
    int_value: Int,
    float_value: Float,
    str_value: String,
    bool_value: Bool
};

pub type CypherExpr = struct {
    op_kind: Int,
    var_name: String,
    prop_key: String,
    literal: CypherLiteralType,
    left_child: Int,
    right_child: Int
};

pub type CypherPatternNode = struct {
    var_name: String,
    label: String,
    has_props: Bool,
    prop_key: String,
    prop_val: String
};

pub type CypherPatternRel = struct {
    var_name: String,
    rel_type: String,
    direction: Int,
    min_hops: Int,
    max_hops: Int
};

pub type CypherMatchClause = struct {
    is_optional: Bool,
    src_node: CypherPatternNode,
    rel: CypherPatternRel,
    dst_node: CypherPatternNode,
    has_edge: Bool
};

pub type CypherWhereClause = struct {
    has_filter: Bool,
    target_var: String,
    target_prop: String,
    comparison_op: Int,
    cmp_str_val: String,
    cmp_int_val: Int
};

pub type CypherReturnItem = struct {
    var_name: String,
    prop_name: String,
    alias_name: String,
    is_aggregate: Bool,
    agg_func: String
};

pub type CypherReturnClause = struct {
    distinct_rows: Bool,
    items: List[CypherReturnItem],
    limit_count: Int,
    skip_count: Int
};

pub type CypherCreateClause = struct {
    node_var: String,
    node_label: String,
    prop_keys: List[String],
    prop_vals: List[String]
};

pub type CypherQueryAst = struct {
    query_id: Int,
    match_clause: CypherMatchClause,
    where_clause: CypherWhereClause,
    return_clause: CypherReturnClause,
    has_create: Bool,
    create_clause: CypherCreateClause
};

pub fn cypher_literal_int(v: Int) -> CypherLiteralType {
    return CypherLiteralType {
        kind: 1,
        int_value: v,
        float_value: 0.0,
        str_value: "",
        bool_value: false
    };
}

pub fn cypher_literal_str(s: String) -> CypherLiteralType {
    return CypherLiteralType {
        kind: 2,
        int_value: 0,
        float_value: 0.0,
        str_value: s,
        bool_value: false
    };
}

pub fn cypher_literal_bool(b: Bool) -> CypherLiteralType {
    return CypherLiteralType {
        kind: 3,
        int_value: 0,
        float_value: 0.0,
        str_value: "",
        bool_value: b
    };
}

pub fn cypher_pattern_node_new(var_n: String, lbl: String) -> CypherPatternNode {
    return CypherPatternNode {
        var_name: var_n,
        label: lbl,
        has_props: false,
        prop_key: "",
        prop_val: ""
    };
}

pub fn cypher_pattern_rel_new(var_n: String, rtype: String, dir: Int) -> CypherPatternRel {
    return CypherPatternRel {
        var_name: var_n,
        rel_type: rtype,
        direction: dir,
        min_hops: 1,
        max_hops: 1
    };
}

pub fn cypher_query_ast_new(qid: Int) -> CypherQueryAst {
    let empty_items: List[CypherReturnItem] = list_new();
    let empty_keys: List[String] = list_new();
    let empty_vals: List[String] = list_new();

    let def_node: CypherPatternNode = cypher_pattern_node_new("", "");
    let def_rel: CypherPatternRel = cypher_pattern_rel_new("", "", 0);

    let def_match: CypherMatchClause = CypherMatchClause {
        is_optional: false,
        src_node: def_node,
        rel: def_rel,
        dst_node: def_node,
        has_edge: false
    };

    let def_where: CypherWhereClause = CypherWhereClause {
        has_filter: false,
        target_var: "",
        target_prop: "",
        comparison_op: 0,
        cmp_str_val: "",
        cmp_int_val: 0
    };

    let def_ret: CypherReturnClause = CypherReturnClause {
        distinct_rows: false,
        items: empty_items,
        limit_count: -1,
        skip_count: 0
    };

    let def_create: CypherCreateClause = CypherCreateClause {
        node_var: "",
        node_label: "",
        prop_keys: empty_keys,
        prop_vals: empty_vals
    };

    return CypherQueryAst {
        query_id: qid,
        match_clause: def_match,
        where_clause: def_where,
        return_clause: def_ret,
        has_create: false,
        create_clause: def_create
    };
}
