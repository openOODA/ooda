// # Variable-Length Path Traversal Engine
//
// Logline: Traverses variable-length relationship paths with cycle detection, min/max hop bounds, and trail semantics.
//
// Setup: BFS/DFS path frontier expansion enforcing OpenCypher trail semantics (no repeated edges per path).
//
// Beats:
//   1. Define PathFrontierNode, TraversalPath, and VarLengthConfig structures.
//   2. Expand path frontier layer-by-layer up to max_hops boundary.
//   3. Prune paths violating edge uniqueness (trail) or vertex uniqueness (simple path).

pub type TraversalPath = struct {
    nodes: List[Int],
    edges: List[Int],
    length: Int,
};

pub type VarLengthConfig = struct {
    min_hops: Int,
    max_hops: Int,
    semantic_mode: Int, // 1: Trail (no repeated edges), 2: Simple (no repeated nodes), 3: Walk
};

pub fn var_length_config_default() -> VarLengthConfig {
    return VarLengthConfig {
        min_hops: 1,
        max_hops: 5,
        semantic_mode: 1,
    };
}

pub fn traversal_path_new(start_node: Int) -> TraversalPath {
    let mut initial_nodes: List[Int] = list_new();
    initial_nodes = list_push(initial_nodes, start_node);
    let empty_edges: List[Int] = list_new();

    return TraversalPath {
        nodes: initial_nodes,
        edges: empty_edges,
        length: 0,
    };
}

pub fn traversal_path_extend(
    path: TraversalPath,
    next_node: Int,
    via_edge: Int
) -> TraversalPath {
    let updated_nodes: List[Int] = list_push((path).nodes, next_node);
    let updated_edges: List[Int] = list_push((path).edges, via_edge);

    return TraversalPath {
        nodes: updated_nodes,
        edges: updated_edges,
        length: (path).length + 1,
    };
}

pub fn traversal_path_has_edge(path: TraversalPath, edge_id: Int) -> Bool {
    let n: Int = list_len((path).edges);
    let mut i: Int = 0;
    while i < n {
        if list_get((path).edges, i) == edge_id {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn traversal_path_has_node(path: TraversalPath, node_id: Int) -> Bool {
    let n: Int = list_len((path).nodes);
    let mut i: Int = 0;
    while i < n {
        if list_get((path).nodes, i) == node_id {
            return true;
        }
        i = i + 1;
    }
    return false;
}
