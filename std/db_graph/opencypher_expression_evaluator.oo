// # OpenCypher Expression Evaluator
//
// Logline: Evaluates Cypher algebraic, boolean, comparison, and property access expressions.
//
// Setup: Runtime interpreter executing expressions against graph record bindings and property contexts.
//
// Beats:
//   1. Define CypherValue runtime dynamic union representation.
//   2. Implement binary operators (add, sub, mul, div, eq, neq, lt, gt).
//   3. Implement boolean logic evaluation (AND, OR, NOT) with ternary truth values.

pub type CypherValue = struct {
    val_type: Int, // 0: Null, 1: Int, 2: Float, 3: String, 4: Bool
    int_val: Int,
    float_val: Float,
    str_val: String,
    bool_val: Bool,
    is_null: Bool
};

pub fn cypher_val_null() -> CypherValue {
    return CypherValue {
        val_type: 0,
        int_val: 0,
        float_val: 0.0,
        str_val: "",
        bool_val: false,
        is_null: true
    };
}

pub fn cypher_val_int(v: Int) -> CypherValue {
    return CypherValue {
        val_type: 1,
        int_val: v,
        float_val: 0.0,
        str_val: "",
        bool_val: false,
        is_null: false
    };
}

pub fn cypher_val_float(v: Float) -> CypherValue {
    return CypherValue {
        val_type: 2,
        int_val: 0,
        float_val: v,
        str_val: "",
        bool_val: false,
        is_null: false
    };
}

pub fn cypher_val_str(v: String) -> CypherValue {
    return CypherValue {
        val_type: 3,
        int_val: 0,
        float_val: 0.0,
        str_val: v,
        bool_val: false,
        is_null: false
    };
}

pub fn cypher_val_bool(v: Bool) -> CypherValue {
    return CypherValue {
        val_type: 4,
        int_val: 0,
        float_val: 0.0,
        str_val: "",
        bool_val: v,
        is_null: false
    };
}

pub fn cypher_eval_eq(left: CypherValue, right: CypherValue) -> CypherValue {
    if (left).is_null || (right).is_null {
        return cypher_val_null();
    }
    if (left).val_type != (right).val_type {
        return cypher_val_bool(false);
    }
    if (left).val_type == 1 {
        return cypher_val_bool((left).int_val == (right).int_val);
    }
    if (left).val_type == 2 {
        return cypher_val_bool((left).float_val == (right).float_val);
    }
    if (left).val_type == 3 {
        return cypher_val_bool((left).str_val.contains((right).str_val) && (right).str_val.contains((left).str_val));
    }
    if (left).val_type == 4 {
        return cypher_val_bool((left).bool_val == (right).bool_val);
    }
    return cypher_val_bool(false);
}

pub fn cypher_eval_lt(left: CypherValue, right: CypherValue) -> CypherValue {
    if (left).is_null || (right).is_null {
        return cypher_val_null();
    }
    if (left).val_type == 1 && (right).val_type == 1 {
        return cypher_val_bool((left).int_val < (right).int_val);
    }
    if (left).val_type == 2 && (right).val_type == 2 {
        return cypher_val_bool((left).float_val < (right).float_val);
    }
    return cypher_val_bool(false);
}

pub fn cypher_eval_and(left: CypherValue, right: CypherValue) -> CypherValue {
    if (left).is_null || (right).is_null {
        return cypher_val_null();
    }
    let res: Bool = (left).bool_val && (right).bool_val;
    return cypher_val_bool(res);
}

pub fn cypher_eval_or(left: CypherValue, right: CypherValue) -> CypherValue {
    if (left).is_null || (right).is_null {
        return cypher_val_null();
    }
    let res: Bool = (left).bool_val || (right).bool_val;
    return cypher_val_bool(res);
}

pub fn cypher_eval_not(v: CypherValue) -> CypherValue {
    if (v).is_null {
        return cypher_val_null();
    }
    return cypher_val_bool(!(v).bool_val);
}
