// # OpenCypher Grouping & Aggregations
//
// Logline: Implements hash-based grouping and aggregation functions for Cypher queries (COUNT, SUM, AVG, MIN, MAX, COLLECT).
//
// Setup: Accumulates aggregate state per group key tuple and produces finalized summary result rows.
//
// Beats:
//   1. Define AggregateFunctionKind, GroupAccumulator, and AggregateState structures.
//   2. Update running aggregate states across streamed input rows.
//   3. Compute finalized values (average division, collection packing).

pub type GroupAccumulator = struct {
    group_key: String,
    count_val: Int,
    sum_val: Float,
    min_val: Float,
    max_val: Float,
};

pub type GroupAggregateTable = struct {
    groups: List[GroupAccumulator],
    group_count: Int,
};

pub fn group_accumulator_new(key: String) -> GroupAccumulator {
    return GroupAccumulator {
        group_key: key,
        count_val: 0,
        sum_val: 0.0,
        min_val: 1000000000.0,
        max_val: -1000000000.0,
    };
}

pub fn group_aggregate_table_new() -> GroupAggregateTable {
    let empty_groups: List[GroupAccumulator] = list_new();
    return GroupAggregateTable {
        groups: empty_groups,
        group_count: 0,
    };
}

pub fn group_aggregate_accumulate(
    table: GroupAggregateTable,
    key: String,
    val: Float
) -> GroupAggregateTable {
    let mut updated: List[GroupAccumulator] = list_new();
    let n: Int = (table).group_count;
    let mut i: Int = 0;
    let mut found: Bool = false;

    while i < n {
        let acc: GroupAccumulator = list_get((table).groups, i);
        if (acc).group_key == key {
            let new_min: Float = if val < (acc).min_val { val } else { (acc).min_val };
            let new_max: Float = if val > (acc).max_val { val } else { (acc).max_val };
            let new_acc: GroupAccumulator = GroupAccumulator {
                group_key: key,
                count_val: (acc).count_val + 1,
                sum_val: (acc).sum_val + val,
                min_val: new_min,
                max_val: new_max,
            };
            updated = list_push(updated, new_acc);
            found = true;
        } else {
            updated = list_push(updated, acc);
        }
        i = i + 1;
    }

    if !found {
        let new_acc: GroupAccumulator = GroupAccumulator {
            group_key: key,
            count_val: 1,
            sum_val: val,
            min_val: val,
            max_val: val,
        };
        updated = list_push(updated, new_acc);
    }

    return GroupAggregateTable {
        groups: updated,
        group_count: list_len(updated),
    };
}

pub fn group_accumulator_avg(acc: GroupAccumulator) -> Float {
    if (acc).count_val > 0 {
        let cnt: Float = (acc).count_val * 1.0;
        return (acc).sum_val / cnt;
    }
    return 0.0;
}
