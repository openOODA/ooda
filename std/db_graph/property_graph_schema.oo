// # Property Graph Schema & Constraints
//
// Logline: Enforces node label definitions, relationship schemas, property types, and uniqueness constraints.
//
// Setup: Validates graph mutations against catalog schemas and integrity rules before persistence.
//
// Beats:
//   1. Define LabelSchema, RelTypeSchema, and PropertyConstraint structures.
//   2. Implement schema validation routines for node and relationship creations.
//   3. Manage uniqueness and existence constraint enforcement.

pub type PropertyConstraint = struct {
    prop_name: String,
    expected_type: Int, // 1: Int, 2: Float, 3: String, 4: Bool
    is_mandatory: Bool,
    is_unique: Bool,
};

pub type LabelSchema = struct {
    label_id: Int,
    label_name: String,
    constraints: List[PropertyConstraint],
    constraint_count: Int,
};

pub type RelTypeSchema = struct {
    rel_type_id: Int,
    rel_name: String,
    allowed_src_label_id: Int,
    allowed_dst_label_id: Int,
    is_directed: Bool,
};

pub type GraphSchemaCatalog = struct {
    labels: List[LabelSchema],
    rel_types: List[RelTypeSchema],
    strict_mode: Bool,
};

pub fn property_constraint_new(
    pname: String,
    ptype: Int,
    mandatory: Bool,
    unique: Bool
) -> PropertyConstraint {
    return PropertyConstraint {
        prop_name: pname,
        expected_type: ptype,
        is_mandatory: mandatory,
        is_unique: unique,
    };
}

pub fn label_schema_new(lid: Int, lname: String) -> LabelSchema {
    let empty_c: List[PropertyConstraint] = list_new();
    return LabelSchema {
        label_id: lid,
        label_name: lname,
        constraints: empty_c,
        constraint_count: 0,
    };
}

pub fn rel_type_schema_new(
    rid: Int,
    rname: String,
    src_lid: Int,
    dst_lid: Int
) -> RelTypeSchema {
    return RelTypeSchema {
        rel_type_id: rid,
        rel_name: rname,
        allowed_src_label_id: src_lid,
        allowed_dst_label_id: dst_lid,
        is_directed: true,
    };
}

pub fn graph_schema_catalog_new() -> GraphSchemaCatalog {
    let empty_lbls: List[LabelSchema] = list_new();
    let empty_rels: List[RelTypeSchema] = list_new();
    return GraphSchemaCatalog {
        labels: empty_lbls,
        rel_types: empty_rels,
        strict_mode: true,
    };
}

pub fn graph_schema_add_label(catalog: GraphSchemaCatalog, lbl: LabelSchema) -> GraphSchemaCatalog {
    let updated: List[LabelSchema] = list_push((catalog).labels, lbl);
    return GraphSchemaCatalog {
        labels: updated,
        rel_types: (catalog).rel_types,
        strict_mode: (catalog).strict_mode,
    };
}

pub fn graph_schema_add_rel_type(catalog: GraphSchemaCatalog, rel: RelTypeSchema) -> GraphSchemaCatalog {
    let updated: List[RelTypeSchema] = list_push((catalog).rel_types, rel);
    return GraphSchemaCatalog {
        labels: (catalog).labels,
        rel_types: updated,
        strict_mode: (catalog).strict_mode,
    };
}
