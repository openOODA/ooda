// # Property Graph Transactional Delta Store
//
// Logline: Buffers uncommitted graph mutations in memory before committing to persistent storage snapshots.
//
// Setup: Tracks inserted nodes, appended edges, modified properties, and soft-deleted entities for MVCC transactions.
//
// Beats:
//   1. Define MutationOp, DeltaRecord, and GraphDeltaStore structures.
//   2. Record transactional node/edge insertions, updates, and deletions.
//   3. Merge delta layers over base graph snapshots for query execution.

pub type DeltaRecord = struct {
    op_kind: Int, // 1: InsertNode, 2: InsertEdge, 3: UpdateProp, 4: DeleteNode, 5: DeleteEdge
    tx_id: Int,
    target_id: Int,
    secondary_id: Int,
    prop_key: String,
    prop_val: String,
};

pub type GraphDeltaStore = struct {
    tx_id: Int,
    records: List[DeltaRecord],
    record_count: Int,
    is_committed: Bool,
};

pub fn graph_delta_store_new(tx: Int) -> GraphDeltaStore {
    let empty_records: List[DeltaRecord] = list_new();
    return GraphDeltaStore {
        tx_id: tx,
        records: empty_records,
        record_count: 0,
        is_committed: false,
    };
}

pub fn delta_record_insert_node(tx: Int, nid: Int, lbl: String) -> DeltaRecord {
    return DeltaRecord {
        op_kind: 1,
        tx_id: tx,
        target_id: nid,
        secondary_id: 0,
        prop_key: "label",
        prop_val: lbl,
    };
}

pub fn delta_record_insert_edge(tx: Int, eid: Int, src: Int, dst: Int) -> DeltaRecord {
    return DeltaRecord {
        op_kind: 2,
        tx_id: tx,
        target_id: eid,
        secondary_id: src,
        prop_key: "dst",
        prop_val: "edge",
    };
}

pub fn delta_store_append(
    store: GraphDeltaStore,
    rec: DeltaRecord
) -> GraphDeltaStore {
    let updated: List[DeltaRecord] = list_push((store).records, rec);
    return GraphDeltaStore {
        tx_id: (store).tx_id,
        records: updated,
        record_count: (store).record_count + 1,
        is_committed: (store).is_committed,
    };
}
