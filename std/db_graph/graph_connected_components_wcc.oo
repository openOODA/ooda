// # Weakly Connected Components (WCC Union-Find)
//
// Logline: Identifies weakly connected graph components using Disjoint Set Union (DSU) with rank optimization.
//
// Setup: Merges equivalence partitions across undirected/directed edges finding root component representatives.
//
// Beats:
//   1. Define DisjointSetUnion and WCCResult data structures.
//   2. Implement DSU find with iterative path compression.
//   3. Union sets by rank and compute connected component size histograms.

pub type DisjointSetUnion = struct {
    parent: List[Int],
    rank: List[Int],
    num_elements: Int,
    component_count: Int
};

pub type WCCResult = struct {
    component_ids: List[Int],
    total_components: Int
};

pub fn dsu_new(n: Int) -> DisjointSetUnion {
    let mut p: List[Int] = list_new();
    let mut r: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        p = list_push(p, i);
        r = list_push(r, 0);
        i = i + 1;
    }

    return DisjointSetUnion {
        parent: p,
        rank: r,
        num_elements: n,
        component_count: n
    };
}

pub fn dsu_find_root(dsu: DisjointSetUnion, x: Int) -> Int {
    let mut curr: Int = x;
    while curr != list_get((dsu).parent, curr) {
        curr = list_get((dsu).parent, curr);
    }
    return curr;
}

pub fn dsu_union(dsu: DisjointSetUnion, x: Int, y: Int) -> DisjointSetUnion {
    let root_x: Int = dsu_find_root(dsu, x);
    let root_y: Int = dsu_find_root(dsu, y);

    if root_x == root_y {
        return dsu;
    }

    let rank_x: Int = list_get((dsu).rank, root_x);
    let rank_y: Int = list_get((dsu).rank, root_y);

    let mut new_parent: List[Int] = list_new();
    let mut new_rank: List[Int] = list_new();
    let n: Int = (dsu).num_elements;
    let mut i: Int = 0;

    if rank_x < rank_y {
        while i < n {
            if i == root_x {
                new_parent = list_push(new_parent, root_y);
            } else {
                new_parent = list_push(new_parent, list_get((dsu).parent, i));
            }
            new_rank = list_push(new_rank, list_get((dsu).rank, i));
            i = i + 1;
        }
    } else if rank_x > rank_y {
        while i < n {
            if i == root_y {
                new_parent = list_push(new_parent, root_x);
            } else {
                new_parent = list_push(new_parent, list_get((dsu).parent, i));
            }
            new_rank = list_push(new_rank, list_get((dsu).rank, i));
            i = i + 1;
        }
    } else {
        while i < n {
            if i == root_y {
                new_parent = list_push(new_parent, root_x);
                new_rank = list_push(new_rank, list_get((dsu).rank, i));
            } else if i == root_x {
                new_parent = list_push(new_parent, list_get((dsu).parent, i));
                new_rank = list_push(new_rank, rank_x + 1);
            } else {
                new_parent = list_push(new_parent, list_get((dsu).parent, i));
                new_rank = list_push(new_rank, list_get((dsu).rank, i));
            }
            i = i + 1;
        }
    }

    return DisjointSetUnion {
        parent: new_parent,
        rank: new_rank,
        num_elements: n,
        component_count: (dsu).component_count - 1
    };
}
