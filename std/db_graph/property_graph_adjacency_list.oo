// # Compressed Sparse Adjacency List (CSR & CSC)
//
// Logline: Implements static and dynamic Compressed Sparse Row/Column layouts for high-speed graph traversals.
//
// Setup: Compact flat arrays indexing neighbor offsets and target node IDs with cache-friendly locality.
//
// Beats:
//   1. Define CSRGraphLayout and CSCOffsetSlice structures.
//   2. Implement neighbor range slicing for out-edges and in-edges.
//   3. Compute vertex degrees and degree histogram distributions.

pub type CSRGraphLayout = struct {
    num_nodes: Int,
    num_edges: Int,
    row_offsets: List[Int],
    col_targets: List[Int],
    edge_weights: List[Float],
};

pub type NodeNeighborSlice = struct {
    start_offset: Int,
    end_offset: Int,
    degree: Int,
};

pub fn csr_graph_new(n_nodes: Int) -> CSRGraphLayout {
    let mut initial_offsets: List[Int] = list_new();
    let mut i: Int = 0;
    while i <= n_nodes {
        initial_offsets = list_push(initial_offsets, 0);
        i = i + 1;
    }

    let empty_targets: List[Int] = list_new();
    let empty_weights: List[Float] = list_new();

    return CSRGraphLayout {
        num_nodes: n_nodes,
        num_edges: 0,
        row_offsets: initial_offsets,
        col_targets: empty_targets,
        edge_weights: empty_weights,
    };
}

pub fn csr_get_neighbor_slice(csr: CSRGraphLayout, node_id: Int) -> NodeNeighborSlice {
    if node_id < 0 || node_id >= (csr).num_nodes {
        return NodeNeighborSlice {
            start_offset: 0,
            end_offset: 0,
            degree: 0,
        };
    }

    let start_idx: Int = list_get((csr).row_offsets, node_id);
    let end_idx: Int = list_get((csr).row_offsets, node_id + 1);

    return NodeNeighborSlice {
        start_offset: start_idx,
        end_offset: end_idx,
        degree: end_idx - start_idx,
    };
}

pub fn csr_get_target(csr: CSRGraphLayout, edge_offset: Int) -> Int {
    if edge_offset >= 0 && edge_offset < (csr).num_edges {
        return list_get((csr).col_targets, edge_offset);
    }
    return -1;
}

pub fn csr_get_weight(csr: CSRGraphLayout, edge_offset: Int) -> Float {
    if edge_offset >= 0 && edge_offset < (csr).num_edges {
        return list_get((csr).edge_weights, edge_offset);
    }
    return 0.0;
}
