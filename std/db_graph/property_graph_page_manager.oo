// # Property Graph Slotted Page Layout & Manager
//
// Logline: Manages fixed-size 8KB on-disk pages housing dense node records, edge records, and property blocks.
//
// Setup: Organizes pages with page headers, slot directories, and free space watermarks for graph persistence.
//
// Beats:
//   1. Define GraphPageType, PageHeader, and GraphSlottedPage data structures.
//   2. Implement page allocation, record slot allocation, and space defragmentation.
//   3. Compute checksums and manage dirty page flags for buffer pool coordination.

pub type GraphPageHeader = struct {
    page_id: Int,
    page_type: Int, // 1: NodePage, 2: EdgePage, 3: PropPage
    slot_count: Int,
    free_space_offset: Int,
    lsn: Int,
    is_dirty: Bool,
};

pub type GraphSlottedPage = struct {
    header: GraphPageHeader,
    page_size_bytes: Int,
    item_count: Int,
};

pub type GraphPageManager = struct {
    total_pages: Int,
    allocated_pages: List[GraphSlottedPage],
    page_capacity_bytes: Int,
};

pub fn graph_page_header_new(pid: Int, ptype: Int) -> GraphPageHeader {
    return GraphPageHeader {
        page_id: pid,
        page_type: ptype,
        slot_count: 0,
        free_space_offset: 8192,
        lsn: 0,
        is_dirty: false,
    };
}

pub fn graph_slotted_page_new(pid: Int, ptype: Int) -> GraphSlottedPage {
    let hdr: GraphPageHeader = graph_page_header_new(pid, ptype);
    return GraphSlottedPage {
        header: hdr,
        page_size_bytes: 8192,
        item_count: 0,
    };
}

pub fn graph_page_manager_new() -> GraphPageManager {
    let empty_pages: List[GraphSlottedPage] = list_new();
    return GraphPageManager {
        total_pages: 0,
        allocated_pages: empty_pages,
        page_capacity_bytes: 8192,
    };
}

pub fn graph_page_manager_allocate_page(
    mgr: GraphPageManager,
    ptype: Int
) -> GraphPageManager {
    let new_pid: Int = (mgr).total_pages;
    let new_page: GraphSlottedPage = graph_slotted_page_new(new_pid, ptype);
    let updated_pages: List[GraphSlottedPage] = list_push((mgr).allocated_pages, new_page);

    return GraphPageManager {
        total_pages: new_pid + 1,
        allocated_pages: updated_pages,
        page_capacity_bytes: (mgr).page_capacity_bytes,
    };
}
