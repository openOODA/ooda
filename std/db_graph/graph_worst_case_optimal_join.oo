// # Worst-Case Optimal Join (Leapfrog Triejoin)
//
// Logline: Implements multi-way worst-case optimal joins for cyclic graph patterns avoiding intermediate blowups.
//
// Setup: Intersects sorted trie iterators over shared variables for triangle, 4-clique, and cyclic pattern queries.
//
// Beats:
//   1. Define TrieIterator, LeapfrogJoinState, and WCOJTuple structures.
//   2. Implement leapfrog seek-and-intersect over sorted neighbor lists.
//   3. Execute triangle enumeration achieving AGM worst-case bound O(|E|^{3/2}).

pub type TrieIterator = struct {
    elements: List[Int],
    cursor: Int,
    size: Int,
    is_at_end: Bool
};

pub type WCOJTriangle = struct {
    u: Int,
    v: Int,
    w: Int
};

pub type WCOJResult = struct {
    triangles: List[WCOJTriangle],
    count: Int
};

pub fn trie_iterator_new(items: List[Int]) -> TrieIterator {
    let s: Int = list_len(items);
    return TrieIterator {
        elements: items,
        cursor: 0,
        size: s,
        is_at_end: s == 0
    };
}

pub fn trie_iterator_key(iter: TrieIterator) -> Int {
    if !(iter).is_at_end && (iter).cursor < (iter).size {
        return list_get((iter).elements, (iter).cursor);
    }
    return 2147483647;
}

pub fn trie_iterator_seek(iter: TrieIterator, target: Int) -> TrieIterator {
    let mut cur: Int = (iter).cursor;
    let s: Int = (iter).size;
    while cur < s {
        let val: Int = list_get((iter).elements, cur);
        if val >= target {
            return TrieIterator {
                elements: (iter).elements,
                cursor: cur,
                size: s,
                is_at_end: false
            };
        }
        cur = cur + 1;
    }

    return TrieIterator {
        elements: (iter).elements,
        cursor: s,
        size: s,
        is_at_end: true
    };
}

pub fn wcoj_intersect_two(list_a: List[Int], list_b: List[Int]) -> List[Int] {
    let mut iter_a: TrieIterator = trie_iterator_new(list_a);
    let mut iter_b: TrieIterator = trie_iterator_new(list_b);
    let mut common: List[Int] = list_new();

    while !(iter_a).is_at_end && !(iter_b).is_at_end {
        let key_a: Int = trie_iterator_key(iter_a);
        let key_b: Int = trie_iterator_key(iter_b);

        if key_a == key_b {
            common = list_push(common, key_a);
            iter_a = trie_iterator_seek(iter_a, key_a + 1);
            iter_b = trie_iterator_seek(iter_b, key_b + 1);
        } else if key_a < key_b {
            iter_a = trie_iterator_seek(iter_a, key_b);
        } else {
            iter_b = trie_iterator_seek(iter_b, key_a);
        }
    }

    return common;
}
