// # Biased & Uniform Graph Random Walk Generator
//
// Logline: Generates stochastic node walk sequences using second-order Markov chains for graph sampling and embeddings.
//
// Setup: Implements Node2Vec return parameter (p) and in-out parameter (q) edge transition probabilities.
//
// Beats:
//   1. Define RandomWalkConfig, WalkSequence, and TransitionProb structures.
//   2. Compute 2nd-order bias factors alpha(t, x) based on neighbor distances (0, 1, 2).
//   3. Generate step-by-step stochastic walk paths starting from seed vertices.

pub type RandomWalkConfig = struct {
    walk_length: Int,
    p_return_param: Float,
    q_inout_param: Float,
    seed_node: Int
};

pub type WalkSequence = struct {
    nodes: List[Int],
    length: Int
};

pub fn random_walk_config_default(seed: Int) -> RandomWalkConfig {
    return RandomWalkConfig {
        walk_length: 10,
        p_return_param: 1.0,
        q_inout_param: 1.0,
        seed_node: seed
    };
}

pub fn walk_sequence_new(start: Int) -> WalkSequence {
    let mut initial_nodes: List[Int] = list_new();
    initial_nodes = list_push(initial_nodes, start);
    return WalkSequence {
        nodes: initial_nodes,
        length: 1
    };
}

pub fn walk_sequence_step(walk: WalkSequence, next_n: Int) -> WalkSequence {
    let updated: List[Int] = list_push((walk).nodes, next_n);
    return WalkSequence {
        nodes: updated,
        length: (walk).length + 1
    };
}

pub fn compute_node2vec_alpha(d_tx: Int, p: Float, q: Float) -> Float {
    if d_tx == 0 {
        return 1.0 / p;
    }
    if d_tx == 1 {
        return 1.0;
    }
    return 1.0 / q;
}
