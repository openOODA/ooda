// # Property Graph Monotonic ID Allocator & Free List
//
// Logline: Generates unique 64-bit identifiers with free-list recycling for graph nodes, edges, and properties.
//
// Setup: High-concurrency ID allocator maintaining high-water mark counters and reusable recycled ID pools.
//
// Beats:
//   1. Define IdAllocator and EntityTypeKind structures.
//   2. Allocate fresh monotonic IDs or reuse popped free-list entries.
//   3. Recycle deleted node/edge IDs into LIFO free lists.

pub type GraphIdAllocator = struct {
    entity_kind: Int, // 1: Node, 2: Edge, 3: PropBlock
    high_watermark: Int,
    free_list: List[Int],
    free_count: Int,
    total_allocated: Int,
};

pub fn graph_id_allocator_new(kind: Int) -> GraphIdAllocator {
    let empty_free: List[Int] = list_new();
    return GraphIdAllocator {
        entity_kind: kind,
        high_watermark: 1,
        free_list: empty_free,
        free_count: 0,
        total_allocated: 0,
    };
}

pub type AllocResult = struct {
    allocator: GraphIdAllocator,
    allocated_id: Int,
};

pub fn graph_id_allocate(alloc: GraphIdAllocator) -> AllocResult {
    if (alloc).free_count > 0 {
        let last_idx: Int = (alloc).free_count - 1;
        let recycled_id: Int = list_get((alloc).free_list, last_idx);

        let mut new_free: List[Int] = list_new();
        let mut i: Int = 0;
        while i < last_idx {
            new_free = list_push(new_free, list_get((alloc).free_list, i));
            i = i + 1;
        }

        let updated_alloc: GraphIdAllocator = GraphIdAllocator {
            entity_kind: (alloc).entity_kind,
            high_watermark: (alloc).high_watermark,
            free_list: new_free,
            free_count: last_idx,
            total_allocated: (alloc).total_allocated + 1,
        };

        return AllocResult {
            allocator: updated_alloc,
            allocated_id: recycled_id,
        };
    }

    let next_id: Int = (alloc).high_watermark;
    let updated_alloc: GraphIdAllocator = GraphIdAllocator {
        entity_kind: (alloc).entity_kind,
        high_watermark: next_id + 1,
        free_list: (alloc).free_list,
        free_count: 0,
        total_allocated: (alloc).total_allocated + 1,
    };

    return AllocResult {
        allocator: updated_alloc,
        allocated_id: next_id,
    };
}

pub fn graph_id_free(alloc: GraphIdAllocator, id: Int) -> GraphIdAllocator {
    let updated_free: List[Int] = list_push((alloc).free_list, id);
    return GraphIdAllocator {
        entity_kind: (alloc).entity_kind,
        high_watermark: (alloc).high_watermark,
        free_list: updated_free,
        free_count: (alloc).free_count + 1,
        total_allocated: (alloc).total_allocated - 1,
    };
}
