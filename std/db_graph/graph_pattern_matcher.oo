// # Graph Pattern Matching Engine
//
// Logline: Matches graph query patterns against property graphs using backtracking and constraint satisfaction.
//
// Setup: Matches node and relationship patterns binding target vertex and edge handles into solution rows.
//
// Beats:
//   1. Define PatternMatchBinding, MatchResultSet, and PatternMatcher structures.
//   2. Implement candidate node filtering by label and property predicates.
//   3. Expand adjacent relationship bindings and build joined match tuples.

pub type PatternMatchBinding = struct {
    src_node_id: Int,
    edge_id: Int,
    dst_node_id: Int,
    is_valid: Bool
};

pub type MatchResultSet = struct {
    bindings: List[PatternMatchBinding],
    result_count: Int
};

pub fn pattern_match_binding_new(src: Int, e: Int, dst: Int) -> PatternMatchBinding {
    return PatternMatchBinding {
        src_node_id: src,
        edge_id: e,
        dst_node_id: dst,
        is_valid: true
    };
}

pub fn match_result_set_new() -> MatchResultSet {
    let empty_bindings: List[PatternMatchBinding] = list_new();
    return MatchResultSet {
        bindings: empty_bindings,
        result_count: 0
    };
}

pub fn match_result_set_add(
    res: MatchResultSet,
    b: PatternMatchBinding
) -> MatchResultSet {
    let updated: List[PatternMatchBinding] = list_push((res).bindings, b);
    return MatchResultSet {
        bindings: updated,
        result_count: (res).result_count + 1
    };
}

pub fn execute_single_hop_match(
    src_candidates: List[Int],
    edge_srcs: List[Int],
    edge_dsts: List[Int],
    edge_types: List[Int],
    target_rel_type: Int
) -> MatchResultSet {
    let mut results: MatchResultSet = match_result_set_new();
    let num_edges: Int = list_len(edge_srcs);
    let num_srcs: Int = list_len(src_candidates);

    let mut s_idx: Int = 0;
    while s_idx < num_srcs {
        let src: Int = list_get(src_candidates, s_idx);
        let mut e_idx: Int = 0;
        while e_idx < num_edges {
            let e_src: Int = list_get(edge_srcs, e_idx);
            let e_dst: Int = list_get(edge_dsts, e_idx);
            let e_type: Int = list_get(edge_types, e_idx);

            if e_src == src {
                if target_rel_type < 0 || target_rel_type == e_type {
                    let b: PatternMatchBinding = pattern_match_binding_new(src, e_idx, e_dst);
                    results = match_result_set_add(results, b);
                }
            }
            e_idx = e_idx + 1;
        }
        s_idx = s_idx + 1;
    }

    return results;
}
