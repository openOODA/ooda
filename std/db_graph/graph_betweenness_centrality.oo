// # Brandes Betweenness Centrality Engine
//
// Logline: Computes node and edge betweenness centrality scores by counting shortest paths passing through each vertex.
//
// Setup: Single-source shortest path DAGs with recursive path accumulation delta[v] = sum((sigma[v]/sigma[w])*(1 + delta[w])).
//
// Beats:
//   1. Define BetweennessCentralityResult and PathAccumulator structures.
//   2. Forward BFS/Dijkstra counting number of shortest paths (sigma).
//   3. Reverse topological accumulation of pair-dependency fractions (delta).

pub type CentralityScore = struct {
    node_id: Int,
    betweenness: Float
};

pub type BetweennessResult = struct {
    scores: List[CentralityScore],
    num_nodes: Int
};

pub fn centrality_score_new(nid: Int, b: Float) -> CentralityScore {
    return CentralityScore {
        node_id: nid,
        betweenness: b
    };
}

pub fn betweenness_result_new(n: Int) -> BetweennessResult {
    let mut initial_scores: List[CentralityScore] = list_new();
    let mut i: Int = 0;
    while i < n {
        let s: CentralityScore = centrality_score_new(i, 0.0);
        initial_scores = list_push(initial_scores, s);
        i = i + 1;
    }

    return BetweennessResult {
        scores: initial_scores,
        num_nodes: n
    };
}

pub fn betweenness_accumulate_simple(
    res: BetweennessResult,
    target_node: Int,
    delta: Float
) -> BetweennessResult {
    let mut updated: List[CentralityScore] = list_new();
    let n: Int = (res).num_nodes;
    let mut i: Int = 0;

    while i < n {
        let cur: CentralityScore = list_get((res).scores, i);
        if (cur).node_id == target_node {
            let new_c: CentralityScore = centrality_score_new(target_node, (cur).betweenness + delta);
            updated = list_push(updated, new_c);
        } else {
            updated = list_push(updated, cur);
        }
        i = i + 1;
    }

    return BetweennessResult {
        scores: updated,
        num_nodes: n
    };
}
