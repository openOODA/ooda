// # OpenCypher Volcano Iterator Executor
//
// Logline: Executes physical graph operator plans using the Volcano iterator model (Open, Next, Close).
//
// Setup: Pipelined pull-based tuple consumption streaming records across NodeScan, EdgeExpand, and Filter iterators.
//
// Beats:
//   1. Define VolcanoIterator, ExecutionTuple, and OperatorState structures.
//   2. Implement Open(), Next(), and Close() interfaces for graph pipeline stages.
//   3. Stream result tuples into query client output buffers.

import "./opencypher_expression_evaluator.oo";

pub type VolcanoTuple = struct {
    tuple_id: Int,
    node_id: Int,
    edge_id: Int,
    is_exhausted: Bool,
};

pub type VolcanoIterator = struct {
    iter_id: Int,
    op_type: Int,
    is_open: Bool,
    cursor: Int,
    total_records: Int,
};

pub fn volcano_tuple_new(tid: Int, nid: Int, eid: Int) -> VolcanoTuple {
    return VolcanoTuple {
        tuple_id: tid,
        node_id: nid,
        edge_id: eid,
        is_exhausted: false,
    };
}

pub fn volcano_tuple_exhausted() -> VolcanoTuple {
    return VolcanoTuple {
        tuple_id: -1,
        node_id: -1,
        edge_id: -1,
        is_exhausted: true,
    };
}

pub fn volcano_iterator_open(id: Int, op: Int, total: Int) -> VolcanoIterator {
    return VolcanoIterator {
        iter_id: id,
        op_type: op,
        is_open: true,
        cursor: 0,
        total_records: total,
    };
}

pub type NextResult = struct {
    iterator: VolcanoIterator,
    tuple: VolcanoTuple,
};

pub fn volcano_iterator_next(iter: VolcanoIterator) -> NextResult {
    if !(iter).is_open || (iter).cursor >= (iter).total_records {
        return NextResult {
            iterator: iter,
            tuple: volcano_tuple_exhausted(),
        };
    }

    let cur: Int = (iter).cursor;
    let tup: VolcanoTuple = volcano_tuple_new(cur, cur, -1);

    let updated_iter: VolcanoIterator = VolcanoIterator {
        iter_id: (iter).iter_id,
        op_type: (iter).op_type,
        is_open: true,
        cursor: cur + 1,
        total_records: (iter).total_records,
    };

    return NextResult {
        iterator: updated_iter,
        tuple: tup,
    };
}

pub fn volcano_iterator_close(iter: VolcanoIterator) -> VolcanoIterator {
    return VolcanoIterator {
        iter_id: (iter).iter_id,
        op_type: (iter).op_type,
        is_open: false,
        cursor: (iter).cursor,
        total_records: (iter).total_records,
    };
}
