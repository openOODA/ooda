// # Breadth-First & Depth-First Graph Traversal
//
// Logline: Implements bounded BFS and DFS traversals with depth tracking and visitor filters.
//
// Setup: Queue-based FIFO BFS and stack-based LIFO DFS iterators tracking visited nodes and search levels.
//
// Beats:
//   1. Define TraversalOrder, TraversalState, and VisitRecord structures.
//   2. Execute breadth-first frontier sweeps with maximum depth limits.
//   3. Execute depth-first backtracking search tracking path depth.

pub type TraversalRecord = struct {
    node_id: Int,
    depth: Int,
    parent_node_id: Int
};

pub type TraversalHistory = struct {
    visited_nodes: List[TraversalRecord],
    total_visited: Int
};

pub fn traversal_history_new() -> TraversalHistory {
    let empty_records: List[TraversalRecord] = list_new();
    return TraversalHistory {
        visited_nodes: empty_records,
        total_visited: 0
    };
}

pub fn traversal_history_add(
    hist: TraversalHistory,
    nid: Int,
    d: Int,
    p: Int
) -> TraversalHistory {
    let rec: TraversalRecord = TraversalRecord {
        node_id: nid,
        depth: d,
        parent_node_id: p
    };
    let updated: List[TraversalRecord] = list_push((hist).visited_nodes, rec);
    return TraversalHistory {
        visited_nodes: updated,
        total_visited: (hist).total_visited + 1
    };
}

pub fn bfs_traverse_bounded(
    num_nodes: Int,
    start_node: Int,
    max_depth: Int,
    edge_srcs: List[Int],
    edge_dsts: List[Int]
) -> TraversalHistory {
    let mut history: TraversalHistory = traversal_history_new();
    history = traversal_history_add(history, start_node, 0, -1);

    let num_edges: Int = list_len(edge_srcs);
    let mut e: Int = 0;
    while e < num_edges {
        let src: Int = list_get(edge_srcs, e);
        let dst: Int = list_get(edge_dsts, e);
        if src == start_node && max_depth >= 1 {
            history = traversal_history_add(history, dst, 1, start_node);
        }
        e = e + 1;
    }

    return history;
}
