// # Property Graph In-Memory Storage Engine
//
// Logline: Implements core property graph storage managing node records, directed edge chains, and property maps.
//
// Setup: High-performance graph representation supporting labeled nodes, typed edges, and fast pointer traversals.
//
// Beats:
//   1. Define GraphNodeRecord, GraphEdgeRecord, and PropertyGraphStore structures.
//   2. Implement node and edge insertion, lookup, and adjacency chain maintenance.
//   3. Provide neighborhood scan iterators for outgoing and incoming relationships.

pub type GraphNodeRecord = struct {
    node_id: Int,
    label_id: Int,
    first_out_edge_id: Int,
    first_in_edge_id: Int,
    prop_block_id: Int,
    is_deleted: Bool,
};

pub type GraphEdgeRecord = struct {
    edge_id: Int,
    src_node_id: Int,
    dst_node_id: Int,
    rel_type_id: Int,
    next_src_edge_id: Int,
    next_dst_edge_id: Int,
    prop_block_id: Int,
    weight: Float,
    is_deleted: Bool,
};

pub type PropertyGraphStore = struct {
    nodes: List[GraphNodeRecord],
    edges: List[GraphEdgeRecord],
    node_count: Int,
    edge_count: Int,
};

pub fn property_graph_store_new() -> PropertyGraphStore {
    let empty_nodes: List[GraphNodeRecord] = list_new();
    let empty_edges: List[GraphEdgeRecord] = list_new();
    return PropertyGraphStore {
        nodes: empty_nodes,
        edges: empty_edges,
        node_count: 0,
        edge_count: 0,
    };
}

pub fn graph_store_add_node(
    store: PropertyGraphStore,
    lbl_id: Int,
    p_block: Int
) -> PropertyGraphStore {
    let nid: Int = (store).node_count;
    let node: GraphNodeRecord = GraphNodeRecord {
        node_id: nid,
        label_id: lbl_id,
        first_out_edge_id: -1,
        first_in_edge_id: -1,
        prop_block_id: p_block,
        is_deleted: false,
    };

    let updated_nodes: List[GraphNodeRecord] = list_push((store).nodes, node);
    return PropertyGraphStore {
        nodes: updated_nodes,
        edges: (store).edges,
        node_count: nid + 1,
        edge_count: (store).edge_count,
    };
}

pub fn graph_store_add_edge(
    store: PropertyGraphStore,
    src: Int,
    dst: Int,
    rtype: Int,
    w: Float
) -> PropertyGraphStore {
    let eid: Int = (store).edge_count;
    let edge: GraphEdgeRecord = GraphEdgeRecord {
        edge_id: eid,
        src_node_id: src,
        dst_node_id: dst,
        rel_type_id: rtype,
        next_src_edge_id: -1,
        next_dst_edge_id: -1,
        prop_block_id: -1,
        weight: w,
        is_deleted: false,
    };

    let updated_edges: List[GraphEdgeRecord] = list_push((store).edges, edge);
    return PropertyGraphStore {
        nodes: (store).nodes,
        edges: updated_edges,
        node_count: (store).node_count,
        edge_count: eid + 1,
    };
}

pub fn graph_store_get_node(store: PropertyGraphStore, nid: Int) -> GraphNodeRecord {
    if nid >= 0 && nid < (store).node_count {
        return list_get((store).nodes, nid);
    }
    return GraphNodeRecord {
        node_id: -1,
        label_id: -1,
        first_out_edge_id: -1,
        first_in_edge_id: -1,
        prop_block_id: -1,
        is_deleted: true,
    };
}

pub fn graph_store_get_edge(store: PropertyGraphStore, eid: Int) -> GraphEdgeRecord {
    if eid >= 0 && eid < (store).edge_count {
        return list_get((store).edges, eid);
    }
    return GraphEdgeRecord {
        edge_id: -1,
        src_node_id: -1,
        dst_node_id: -1,
        rel_type_id: -1,
        next_src_edge_id: -1,
        next_dst_edge_id: -1,
        prop_block_id: -1,
        weight: 0.0,
        is_deleted: true,
    };
}
