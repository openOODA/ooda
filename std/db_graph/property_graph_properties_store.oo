// # Property Graph Dynamic Properties Store
//
// Logline: Stores variable-length key-value properties with typed encoding for nodes and relationships.
//
// Setup: Linked property blocks chaining key-value pairs without wasting page storage on sparse attributes.
//
// Beats:
//   1. Define PropertyEntry, PropertyBlock, and PropertyContainer data structures.
//   2. Implement property insertion, update, retrieval, and deletion routines.
//   3. Manage property block overflow chains and serialization helpers.

pub type PropertyEntry = struct {
    key_name: String,
    type_tag: Int, // 1: Int, 2: Float, 3: String, 4: Bool
    val_int: Int,
    val_float: Float,
    val_str: String,
    val_bool: Bool,
};

pub type PropertyBlock = struct {
    block_id: Int,
    owner_id: Int,
    is_node: Bool,
    entries: List[PropertyEntry],
    entry_count: Int,
    next_block_id: Int,
};

pub type PropertyStore = struct {
    blocks: List[PropertyBlock],
    block_count: Int,
};

pub fn property_entry_int(k: String, v: Int) -> PropertyEntry {
    return PropertyEntry {
        key_name: k,
        type_tag: 1,
        val_int: v,
        val_float: 0.0,
        val_str: "",
        val_bool: false,
    };
}

pub fn property_entry_str(k: String, v: String) -> PropertyEntry {
    return PropertyEntry {
        key_name: k,
        type_tag: 3,
        val_int: 0,
        val_float: 0.0,
        val_str: v,
        val_bool: false,
    };
}

pub fn property_block_new(bid: Int, oid: Int, is_n: Bool) -> PropertyBlock {
    let empty_entries: List[PropertyEntry] = list_new();
    return PropertyBlock {
        block_id: bid,
        owner_id: oid,
        is_node: is_n,
        entries: empty_entries,
        entry_count: 0,
        next_block_id: -1,
    };
}

pub fn property_store_new() -> PropertyStore {
    let empty_blocks: List[PropertyBlock] = list_new();
    return PropertyStore {
        blocks: empty_blocks,
        block_count: 0,
    };
}

pub fn property_block_add_entry(
    blk: PropertyBlock,
    entry: PropertyEntry
) -> PropertyBlock {
    let updated: List[PropertyEntry] = list_push((blk).entries, entry);
    return PropertyBlock {
        block_id: (blk).block_id,
        owner_id: (blk).owner_id,
        is_node: (blk).is_node,
        entries: updated,
        entry_count: (blk).entry_count + 1,
        next_block_id: (blk).next_block_id,
    };
}

pub fn property_block_find_str(blk: PropertyBlock, key: String) -> String {
    let n: Int = list_len((blk).entries);
    let mut i: Int = 0;
    while i < n {
        let entry: PropertyEntry = list_get((blk).entries, i);
        if (entry).key_name == key && (entry).type_tag == 3 {
            return (entry).val_str;
        }
        i = i + 1;
    }
    return "";
}
