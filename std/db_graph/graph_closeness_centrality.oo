// # Closeness & Harmonic Centrality Engine
//
// Logline: Calculates closeness and harmonic centrality metrics measuring average proximity across connected components.
//
// Setup: Closeness C(u) = (N-1)/sum(d(u,v)) and Harmonic H(u) = sum(1/d(u,v)) handling disconnected graph partitions.
//
// Beats:
//   1. Define ClosenessMetric, HarmonicMetric, and CentralityDistribution structures.
//   2. Compute shortest path distance sums from candidate nodes.
//   3. Handle unreachable infinite distance pairs via harmonic inversion 1/infinity = 0.

pub type ClosenessScore = struct {
    node_id: Int,
    closeness: Float,
    harmonic: Float,
    reachable_nodes: Int,
};

pub type ClosenessResult = struct {
    scores: List[ClosenessScore],
    total_nodes: Int,
};

pub fn closeness_score_new(nid: Int) -> ClosenessScore {
    return ClosenessScore {
        node_id: nid,
        closeness: 0.0,
        harmonic: 0.0,
        reachable_nodes: 0,
    };
}

pub fn closeness_result_new(n: Int) -> ClosenessResult {
    let mut initial_scores: List[ClosenessScore] = list_new();
    let mut i: Int = 0;
    while i < n {
        let sc: ClosenessScore = closeness_score_new(i);
        initial_scores = list_push(initial_scores, sc);
        i = i + 1;
    }
    return ClosenessResult {
        scores: initial_scores,
        total_nodes: n,
    };
}

pub fn compute_closeness_from_distances(
    node_id: Int,
    distances: List[Float],
    num_nodes: Int
) -> ClosenessScore {
    let mut sum_dist: Float = 0.0;
    let mut harmonic_sum: Float = 0.0;
    let mut reachable: Int = 0;

    let mut i: Int = 0;
    while i < num_nodes {
        if i != node_id {
            let d: Float = list_get(distances, i);
            if d > 0.0 && d < 9999999.0 {
                sum_dist = sum_dist + d;
                harmonic_sum = harmonic_sum + (1.0 / d);
                reachable = reachable + 1;
            }
        }
        i = i + 1;
    }

    let c_val: Float = if sum_dist > 0.0 {
        1.0 / sum_dist
    } else {
        0.0
    };

    return ClosenessScore {
        node_id: node_id,
        closeness: c_val,
        harmonic: harmonic_sum,
        reachable_nodes: reachable,
    };
}
