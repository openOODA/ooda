// # OpenCypher Complex Pattern AST
//
// Logline: Models multi-hop path patterns, variable length relationships, and pattern chains.
//
// Setup: Abstract representations for paths, relationship quantifiers, and directional graph topology patterns.
//
// Beats:
//   1. Define CypherPathPattern, CypherHopRange, and DirectionKind enums.
//   2. Implement multi-hop pattern constructors and cycle safety flags.
//   3. Implement pattern validation and path length boundary checks.

pub type CypherHopRange = struct {
    min_hops: Int,
    max_hops: Int,
    is_unbounded: Bool,
};

pub type CypherPatternSegment = struct {
    src_var: String,
    src_label: String,
    rel_var: String,
    rel_type: String,
    direction: Int, // 1: Outgoing ->, 2: Incoming <-, 3: Undirected --
    hop_range: CypherHopRange,
    dst_var: String,
    dst_label: String,
};

pub type CypherPathPattern = struct {
    path_var: String,
    has_path_var: Bool,
    segments: List[CypherPatternSegment],
    segment_count: Int,
};

pub fn cypher_hop_range_exact(hops: Int) -> CypherHopRange {
    return CypherHopRange {
        min_hops: hops,
        max_hops: hops,
        is_unbounded: false,
    };
}

pub fn cypher_hop_range_variable(min_h: Int, max_h: Int) -> CypherHopRange {
    return CypherHopRange {
        min_hops: min_h,
        max_hops: max_h,
        is_unbounded: max_h < 0,
    };
}

pub fn cypher_pattern_segment_new(
    s_var: String,
    s_lbl: String,
    r_var: String,
    r_type: String,
    dir: Int,
    hops: CypherHopRange,
    d_var: String,
    d_lbl: String
) -> CypherPatternSegment {
    return CypherPatternSegment {
        src_var: s_var,
        src_label: s_lbl,
        rel_var: r_var,
        rel_type: r_type,
        direction: dir,
        hop_range: hops,
        dst_var: d_var,
        dst_label: d_lbl,
    };
}

pub fn cypher_path_pattern_new(p_var: String) -> CypherPathPattern {
    let empty_segs: List[CypherPatternSegment] = list_new();
    return CypherPathPattern {
        path_var: p_var,
        has_path_var: p_var != "",
        segments: empty_segs,
        segment_count: 0,
    };
}

pub fn cypher_path_pattern_add_segment(
    path: CypherPathPattern,
    seg: CypherPatternSegment
) -> CypherPathPattern {
    let updated_segs: List[CypherPatternSegment] = list_push((path).segments, seg);
    return CypherPathPattern {
        path_var: (path).path_var,
        has_path_var: (path).has_path_var,
        segments: updated_segs,
        segment_count: (path).segment_count + 1,
    };
}
