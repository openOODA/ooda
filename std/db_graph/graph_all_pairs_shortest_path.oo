// # All-Pairs Shortest Path (Floyd-Warshall)
//
// Logline: Computes dense shortest path distance matrices for all node pairs in weighted directed graphs.
//
// Setup: Dynamic programming recurrence dist[i][j] = min(dist[i][j], dist[i][k] + dist[k][j]) with negative cycle detection.
//
// Beats:
//   1. Define DistanceMatrix and APSPResult structures.
//   2. Initialize N x N distance table with direct edge weights.
//   3. Iterate intermediate pivot vertices k in 0..N-1 relaxing path lengths.

pub type APSPDistanceMatrix = struct {
    num_nodes: Int,
    distances: List[Float],
    has_negative_cycle: Bool,
};

pub fn apsp_matrix_new(n: Int) -> APSPDistanceMatrix {
    let mut dists: List[Float] = list_new();
    let total: Int = n * n;
    let mut i: Int = 0;
    while i < total {
        let r: Int = i / n;
        let c: Int = i - (r * n);
        if r == c {
            dists = list_push(dists, 0.0);
        } else {
            dists = list_push(dists, 1000000000.0);
        }
        i = i + 1;
    }

    return APSPDistanceMatrix {
        num_nodes: n,
        distances: dists,
        has_negative_cycle: false,
    };
}

pub fn apsp_matrix_get(mat: APSPDistanceMatrix, r: Int, c: Int) -> Float {
    let idx: Int = (r * (mat).num_nodes) + c;
    if idx >= 0 && idx < list_len((mat).distances) {
        return list_get((mat).distances, idx);
    }
    return 1000000000.0;
}

pub fn apsp_matrix_set(mat: APSPDistanceMatrix, r: Int, c: Int, val: Float) -> APSPDistanceMatrix {
    let target_idx: Int = (r * (mat).num_nodes) + c;
    let mut new_dists: List[Float] = list_new();
    let total: Int = list_len((mat).distances);
    let mut i: Int = 0;

    while i < total {
        if i == target_idx {
            new_dists = list_push(new_dists, val);
        } else {
            new_dists = list_push(new_dists, list_get((mat).distances, i));
        }
        i = i + 1;
    }

    return APSPDistanceMatrix {
        num_nodes: (mat).num_nodes,
        distances: new_dists,
        has_negative_cycle: (mat).has_negative_cycle,
    };
}

pub fn floyd_warshall_apsp(
    num_nodes: Int,
    edge_srcs: List[Int],
    edge_dsts: List[Int],
    edge_weights: List[Float]
) -> APSPDistanceMatrix {
    let mut mat: APSPDistanceMatrix = apsp_matrix_new(num_nodes);
    let num_edges: Int = list_len(edge_srcs);

    // 1. Fill direct edge weights
    let mut e: Int = 0;
    while e < num_edges {
        let u: Int = list_get(edge_srcs, e);
        let v: Int = list_get(edge_dsts, e);
        let w: Float = list_get(edge_weights, e);
        mat = apsp_matrix_set(mat, u, v, w);
        e = e + 1;
    }

    // 2. Triple nested loop
    let mut k: Int = 0;
    while k < num_nodes {
        let mut i: Int = 0;
        while i < num_nodes {
            let mut j: Int = 0;
            while j < num_nodes {
                let d_ik: Float = apsp_matrix_get(mat, i, k);
                let d_kj: Float = apsp_matrix_get(mat, k, j);
                let d_ij: Float = apsp_matrix_get(mat, i, j);

                if d_ik + d_kj < d_ij {
                    mat = apsp_matrix_set(mat, i, j, d_ik + d_kj);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }

    return mat;
}
