// # OpenCypher Cost-Based Cardinality Estimator
//
// Logline: Estimates execution cost and output cardinality for graph query logical plan operators.
//
// Setup: Uses vertex label frequencies, edge degree distributions, and predicate selectivity heuristics.
//
// Beats:
//   1. Define GraphCatalogStats and OperatorCostEstimate structures.
//   2. Compute expansion costs based on out-degree distributions and label filters.
//   3. Estimate join size and intermediate memory footprints.

pub type GraphCatalogStats = struct {
    total_node_count: Int,
    total_edge_count: Int,
    avg_out_degree: Float,
    label_selectivity_ratio: Float,
};

pub type OperatorCostEstimate = struct {
    operator_id: Int,
    estimated_rows: Float,
    cpu_cost: Float,
    io_cost: Float,
    total_cost: Float,
};

pub fn graph_catalog_stats_default() -> GraphCatalogStats {
    return GraphCatalogStats {
        total_node_count: 1000000,
        total_edge_count: 10000000,
        avg_out_degree: 10.0,
        label_selectivity_ratio: 0.05,
    };
}

pub fn estimate_node_scan_cost(stats: GraphCatalogStats, has_label: Bool) -> OperatorCostEstimate {
    let rows: Float = if has_label {
        (stats).total_node_count * (stats).label_selectivity_ratio
    } else {
        (stats).total_node_count * 1.0
    };
    let io: Float = rows * 0.1;
    let cpu: Float = rows * 0.01;

    return OperatorCostEstimate {
        operator_id: 1,
        estimated_rows: rows,
        cpu_cost: cpu,
        io_cost: io,
        total_cost: cpu + io,
    };
}

pub fn estimate_edge_expand_cost(
    input_rows: Float,
    avg_degree: Float,
    rel_filter_ratio: Float
) -> OperatorCostEstimate {
    let expanded_rows: Float = input_rows * avg_degree * rel_filter_ratio;
    let cpu: Float = expanded_rows * 0.05;
    let io: Float = expanded_rows * 0.02;

    return OperatorCostEstimate {
        operator_id: 2,
        estimated_rows: expanded_rows,
        cpu_cost: cpu,
        io_cost: io,
        total_cost: cpu + io,
    };
}

pub fn estimate_filter_cost(input_rows: Float, selectivity: Float) -> OperatorCostEstimate {
    let out_rows: Float = input_rows * selectivity;
    let cpu: Float = input_rows * 0.02;

    return OperatorCostEstimate {
        operator_id: 3,
        estimated_rows: out_rows,
        cpu_cost: cpu,
        io_cost: 0.0,
        total_cost: cpu,
    };
}
