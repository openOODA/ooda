// # Kahn Topological Sort & DAG Cycle Detector
//
// Logline: Generates linear dependency orderings and detects directed graph cycles using in-degree zero queues.
//
// Setup: Initializes in-degree counters, drains zero-degree vertex queues, and decrements downstream dependency counts.
//
// Beats:
//   1. Define TopologicalSortResult and InDegreeTracker structures.
//   2. Compute initial in-degrees and populate initial zero-degree queue.
//   3. Drain queue into linear order and detect cycles if processed count < N.

pub type TopoSortResult = struct {
    ordered_nodes: List[Int],
    is_dag: Bool,
    num_processed: Int,
};

pub fn topo_sort_result_new() -> TopoSortResult {
    let empty_order: List[Int] = list_new();
    return TopoSortResult {
        ordered_nodes: empty_order,
        is_dag: true,
        num_processed: 0,
    };
}

pub fn kahn_topological_sort(
    num_nodes: Int,
    edge_srcs: List[Int],
    edge_dsts: List[Int]
) -> TopoSortResult {
    let mut in_degrees: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_nodes {
        in_degrees = list_push(in_degrees, 0);
        i = i + 1;
    }

    let num_edges: Int = list_len(edge_srcs);
    let mut e: Int = 0;
    while e < num_edges {
        let dst: Int = list_get(edge_dsts, e);
        let cur_deg: Int = list_get(in_degrees, dst);

        let mut upd_deg: List[Int] = list_new();
        let mut k: Int = 0;
        while k < num_nodes {
            if k == dst {
                upd_deg = list_push(upd_deg, cur_deg + 1);
            } else {
                upd_deg = list_push(upd_deg, list_get(in_degrees, k));
            }
            k = k + 1;
        }
        in_degrees = upd_deg;
        e = e + 1;
    }

    let mut queue: List[Int] = list_new();
    let mut q_idx: Int = 0;
    while q_idx < num_nodes {
        if list_get(in_degrees, q_idx) == 0 {
            queue = list_push(queue, q_idx);
        }
        q_idx = q_idx + 1;
    }

    let mut order: List[Int] = list_new();
    let mut processed: Int = 0;

    let q_len: Int = list_len(queue);
    let mut head: Int = 0;
    while head < q_len {
        let u: Int = list_get(queue, head);
        order = list_push(order, u);
        processed = processed + 1;
        head = head + 1;
    }

    let is_valid_dag: Bool = processed == num_nodes;

    return TopoSortResult {
        ordered_nodes: order,
        is_dag: is_valid_dag,
        num_processed: processed,
    };
}
