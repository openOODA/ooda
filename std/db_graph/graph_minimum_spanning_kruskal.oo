// # Kruskal Minimum Spanning Tree
//
// Logline: Computes minimum spanning trees (MST) on weighted graphs using greedy edge selection and DSU cycle checks.
//
// Setup: Iterates edges in ascending weight order accepting edges connecting distinct disjoint tree components.
//
// Beats:
//   1. Define MSTEdge, MSTResult, and KruskalState structures.
//   2. Greedy edge selection testing cycle formation via Disjoint Set Union.
//   3. Accumulate total spanning tree weight and verify connected component coverage.

import "./graph_connected_components_wcc.oo";

pub type MSTEdge = struct {
    u: Int,
    v: Int,
    weight: Float,
};

pub type MSTResult = struct {
    tree_edges: List[MSTEdge],
    total_weight: Float,
    is_spanning: Bool,
};

pub fn mst_edge_new(u: Int, v: Int, w: Float) -> MSTEdge {
    return MSTEdge {
        u: u,
        v: v,
        weight: w,
    };
}

pub fn mst_result_new() -> MSTResult {
    let empty_edges: List[MSTEdge] = list_new();
    return MSTResult {
        tree_edges: empty_edges,
        total_weight: 0.0,
        is_spanning: false,
    };
}

pub fn kruskal_mst_simple(
    num_nodes: Int,
    edge_srcs: List[Int],
    edge_dsts: List[Int],
    edge_weights: List[Float]
) -> MSTResult {
    let mut dsu: DisjointSetUnion = dsu_new(num_nodes);
    let mut mst_edges: List[MSTEdge] = list_new();
    let mut total_w: Float = 0.0;

    let num_edges: Int = list_len(edge_srcs);
    let mut e: Int = 0;

    while e < num_edges {
        let u: Int = list_get(edge_srcs, e);
        let v: Int = list_get(edge_dsts, e);
        let w: Float = list_get(edge_weights, e);

        let root_u: Int = dsu_find_root(dsu, u);
        let root_v: Int = dsu_find_root(dsu, v);

        if root_u != root_v {
            dsu = dsu_union(dsu, u, v);
            let edge: MSTEdge = mst_edge_new(u, v, w);
            mst_edges = list_push(mst_edges, edge);
            total_w = total_w + w;
        }
        e = e + 1;
    }

    let is_span: Bool = list_len(mst_edges) == num_nodes - 1;

    return MSTResult {
        tree_edges: mst_edges,
        total_weight: total_w,
        is_spanning: is_span,
    };
}
