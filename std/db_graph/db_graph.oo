pub fn db_graph_store_default() -> PropertyGraphStore {
    return property_graph_store_new();
}

pub fn db_graph_csr_default(n_nodes: Int) -> CSRGraphLayout {
    return csr_graph_new(n_nodes);
}

pub fn db_graph_schema_catalog_default() -> GraphSchemaCatalog {
    return graph_schema_catalog_new();
}

pub fn db_graph_policy_default() -> GraphSecurityPolicy {
    return graph_security_policy_default();
}

pub fn db_graph_pagerank_config_default() -> PageRankConfig {
    return pagerank_config_default();
}

pub fn db_graph_tx_manager_default() -> GraphTxManager {
    return graph_tx_manager_new();
}
