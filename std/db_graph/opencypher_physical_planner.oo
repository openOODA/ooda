// # OpenCypher Physical Execution Planner
//
// Logline: Lowers optimized logical operator plans into concrete physical execution operator graphs.
//
// Setup: Maps logical node scans and edge expansions to index lookups, CSR pointer traversals, and pipelined filters.
//
// Beats:
//   1. Define PhysicalOperatorNode and PhysicalExecutionPlan data types.
//   2. Lower LogicalNodeScan and LogicalEdgeExpand to physical CSR/index operators.
//   3. Configure execution batch sizes and worker thread parallelism.

import "./opencypher_logical_planner.oo";

pub type PhysicalOperatorNode = struct {
    op_id: Int,
    exec_kind: Int, // 1: PhysNodeScan, 2: PhysIndexSeek, 3: PhysCSRTraverse, 4: PhysFilter, 5: PhysProject
    input_op_id: Int,
    batch_size: Int,
    is_pipelined: Bool,
};

pub type PhysicalExecutionPlan = struct {
    plan_id: Int,
    operators: List[PhysicalOperatorNode],
    operator_count: Int,
    root_op_id: Int,
};

pub fn physical_operator_new(
    id: Int,
    kind: Int,
    input_id: Int,
    batch: Int
) -> PhysicalOperatorNode {
    return PhysicalOperatorNode {
        op_id: id,
        exec_kind: kind,
        input_op_id: input_id,
        batch_size: batch,
        is_pipelined: true,
    };
}

pub fn physical_plan_new(pid: Int) -> PhysicalExecutionPlan {
    let empty_ops: List[PhysicalOperatorNode] = list_new();
    return PhysicalExecutionPlan {
        plan_id: pid,
        operators: empty_ops,
        operator_count: 0,
        root_op_id: -1,
    };
}

pub fn physical_plan_add_op(
    plan: PhysicalExecutionPlan,
    op: PhysicalOperatorNode
) -> PhysicalExecutionPlan {
    let updated: List[PhysicalOperatorNode] = list_push((plan).operators, op);
    return PhysicalExecutionPlan {
        plan_id: (plan).plan_id,
        operators: updated,
        operator_count: (plan).operator_count + 1,
        root_op_id: (op).op_id,
    };
}

pub fn cypher_lower_logical_to_physical(lplan: LogicalPlan) -> PhysicalExecutionPlan {
    let mut pplan: PhysicalExecutionPlan = physical_plan_new(1);
    let n: Int = list_len((lplan).nodes);
    let mut i: Int = 0;

    while i < n {
        let lnode: LogicalPlanNode = list_get((lplan).nodes, i);
        let pkind: Int = if (lnode).op_type == 1 {
            1 // PhysNodeScan
        } else if (lnode).op_type == 2 {
            3 // PhysCSRTraverse
        } else if (lnode).op_type == 3 {
            4 // PhysFilter
        } else if (lnode).op_type == 6 {
            2 // PhysIndexSeek
        } else {
            5 // PhysProject
        };

        let pop: PhysicalOperatorNode = physical_operator_new(
            (lnode).node_id,
            pkind,
            (lnode).child_id,
            1024
        );
        pplan = physical_plan_add_op(pplan, pop);
        i = i + 1;
    }

    return pplan;
}
