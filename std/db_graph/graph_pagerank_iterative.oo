// # Iterative PageRank Centrality Engine
//
// Logline: Computes prestige rankings across directed property graphs using power iteration and random surfer damping.
//
// Setup: Distributes probability mass PR(u) = (1-d)/N + d * sum(PR(v)/out_deg(v)) until delta falls below epsilon.
//
// Beats:
//   1. Define PageRankConfig and PageRankResult structures.
//   2. Initialize uniform rank distribution across all active vertices.
//   3. Power-iterate edge mass transfers and handle dangling sink nodes.

pub type PageRankConfig = struct {
    damping_factor: Float,
    max_iterations: Int,
    tolerance: Float
};

pub type PageRankResult = struct {
    ranks: List[Float],
    iterations_run: Int,
    converged: Bool
};

pub fn pagerank_config_default() -> PageRankConfig {
    return PageRankConfig {
        damping_factor: 0.85,
        max_iterations: 50,
        tolerance: 0.00001
    };
}

pub fn pagerank_init_ranks(num_nodes: Int) -> List[Float] {
    let mut ranks: List[Float] = list_new();
    let initial_val: Float = 1.0;
    let mut i: Int = 0;
    while i < num_nodes {
        ranks = list_push(ranks, initial_val);
        i = i + 1;
    }
    return ranks;
}

pub fn pagerank_compute_iteration(
    num_nodes: Int,
    current_ranks: List[Float],
    edge_srcs: List[Int],
    edge_dsts: List[Int],
    out_degrees: List[Int],
    damping: Float
) -> List[Float] {
    let mut next_ranks: List[Float] = list_new();
    let base_val: Float = 1.0 - damping;

    let mut i: Int = 0;
    while i < num_nodes {
        next_ranks = list_push(next_ranks, base_val);
        i = i + 1;
    }

    let num_edges: Int = list_len(edge_srcs);
    let mut e: Int = 0;
    while e < num_edges {
        let src: Int = list_get(edge_srcs, e);
        let dst: Int = list_get(edge_dsts, e);
        let deg: Int = list_get(out_degrees, src);

        if deg > 0 {
            let src_rank: Float = list_get(current_ranks, src);
            let transfer: Float = src_rank * damping;

            let mut upd_ranks: List[Float] = list_new();
            let mut k: Int = 0;
            while k < num_nodes {
                if k == dst {
                    upd_ranks = list_push(upd_ranks, list_get(next_ranks, k) + transfer);
                } else {
                    upd_ranks = list_push(upd_ranks, list_get(next_ranks, k));
                }
                k = k + 1;
            }
            next_ranks = upd_ranks;
        }
        e = e + 1;
    }

    return next_ranks;
}
