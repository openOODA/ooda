// # Property Graph Node Label & Property Index
//
// Logline: Provides inverted index structures for O(1) vertex lookups by label and property equality.
//
// Setup: Hash buckets and inverted postings lists mapping string/integer property values to node IDs.
//
// Beats:
//   1. Define NodeIndexBucket, InvertedIndexEntry, and NodeIndexCatalog structures.
//   2. Implement inverted postings list registration and index search.
//   3. Prune candidate seed nodes for Cypher MATCH entry points.

pub type InvertedIndexEntry = struct {
    key_str: String,
    key_int: Int,
    node_ids: List[Int],
    count: Int,
};

pub type NodeLabelIndex = struct {
    label_id: Int,
    entries: List[InvertedIndexEntry],
    entry_count: Int,
};

pub type NodeIndexCatalog = struct {
    label_indexes: List[NodeLabelIndex],
    index_count: Int,
};

pub fn node_label_index_new(lid: Int) -> NodeLabelIndex {
    let empty_entries: List[InvertedIndexEntry] = list_new();
    return NodeLabelIndex {
        label_id: lid,
        entries: empty_entries,
        entry_count: 0,
    };
}

pub fn node_index_catalog_new() -> NodeIndexCatalog {
    let empty_idx: List[NodeLabelIndex] = list_new();
    return NodeIndexCatalog {
        label_indexes: empty_idx,
        index_count: 0,
    };
}

pub fn node_index_insert_str(
    lindex: NodeLabelIndex,
    k_str: String,
    nid: Int
) -> NodeLabelIndex {
    let mut updated_entries: List[InvertedIndexEntry] = list_new();
    let n: Int = list_len((lindex).entries);
    let mut i: Int = 0;
    let mut found: Bool = false;

    while i < n {
        let entry: InvertedIndexEntry = list_get((lindex).entries, i);
        if (entry).key_str == k_str {
            let new_nids: List[Int] = list_push((entry).node_ids, nid);
            let new_e: InvertedIndexEntry = InvertedIndexEntry {
                key_str: (entry).key_str,
                key_int: (entry).key_int,
                node_ids: new_nids,
                count: (entry).count + 1,
            };
            updated_entries = list_push(updated_entries, new_e);
            found = true;
        } else {
            updated_entries = list_push(updated_entries, entry);
        }
        i = i + 1;
    }

    if !found {
        let mut new_nids: List[Int] = list_new();
        new_nids = list_push(new_nids, nid);
        let new_e: InvertedIndexEntry = InvertedIndexEntry {
            key_str: k_str,
            key_int: 0,
            node_ids: new_nids,
            count: 1,
        };
        updated_entries = list_push(updated_entries, new_e);
    }

    return NodeLabelIndex {
        label_id: (lindex).label_id,
        entries: updated_entries,
        entry_count: list_len(updated_entries),
    };
}
