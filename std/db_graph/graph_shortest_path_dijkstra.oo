// # Dijkstra Shortest Path Engine
//
// Logline: Computes single-source shortest paths on weighted property graphs using Dijkstra's algorithm.
//
// Setup: Maintains tentative distance arrays, visited bitsets, and predecessor pointers for path reconstruction.
//
// Beats:
//   1. Define DijkstraResult, PathRecord, and PriorityQueueEntry structures.
//   2. Initialize distance vector and priority queue with source vertex.
//   3. Relax outgoing edge weights until reaching destination or draining queue.

pub type DijkstraPathResult = struct {
    found: Bool,
    total_cost: Float,
    path_nodes: List[Int],
    hop_count: Int,
};

pub fn dijkstra_path_result_empty() -> DijkstraPathResult {
    let empty_nodes: List[Int] = list_new();
    return DijkstraPathResult {
        found: false,
        total_cost: 0.0,
        path_nodes: empty_nodes,
        hop_count: 0,
    };
}

pub fn dijkstra_find_min_dist_node(
    distances: List[Float],
    visited: List[Bool],
    num_nodes: Int
) -> Int {
    let mut min_node: Int = -1;
    let mut min_d: Float = 1000000000.0;
    let mut i: Int = 0;

    while i < num_nodes {
        let is_v: Bool = list_get(visited, i);
        if !is_v {
            let d: Float = list_get(distances, i);
            if d < min_d {
                min_d = d;
                min_node = i;
            }
        }
        i = i + 1;
    }

    return min_node;
}

pub fn dijkstra_shortest_path(
    num_nodes: Int,
    src: Int,
    dst: Int,
    edge_srcs: List[Int],
    edge_dsts: List[Int],
    edge_weights: List[Float]
) -> DijkstraPathResult {
    let mut dists: List[Float] = list_new();
    let mut prev: List[Int] = list_new();
    let mut visited: List[Bool] = list_new();

    let mut i: Int = 0;
    while i < num_nodes {
        dists = list_push(dists, 1000000000.0);
        prev = list_push(prev, -1);
        visited = list_push(visited, false);
        i = i + 1;
    }

    // Set source distance to 0
    let mut new_dists: List[Float] = list_new();
    let mut j: Int = 0;
    while j < num_nodes {
        if j == src {
            new_dists = list_push(new_dists, 0.0);
        } else {
            new_dists = list_push(new_dists, list_get(dists, j));
        }
        j = j + 1;
    }
    dists = new_dists;

    let num_edges: Int = list_len(edge_srcs);
    let mut step: Int = 0;

    while step < num_nodes {
        let u: Int = dijkstra_find_min_dist_node(dists, visited, num_nodes);
        if u == -1 || u == dst {
            step = num_nodes; // Break
        } else {
            // Mark visited
            let mut new_visited: List[Bool] = list_new();
            let mut v_idx: Int = 0;
            while v_idx < num_nodes {
                if v_idx == u {
                    new_visited = list_push(new_visited, true);
                } else {
                    new_visited = list_push(new_visited, list_get(visited, v_idx));
                }
                v_idx = v_idx + 1;
            }
            visited = new_visited;

            let u_dist: Float = list_get(dists, u);

            // Relax edges
            let mut e: Int = 0;
            while e < num_edges {
                let e_src: Int = list_get(edge_srcs, e);
                let e_dst: Int = list_get(edge_dsts, e);
                let e_w: Float = list_get(edge_weights, e);

                if e_src == u {
                    let old_d: Float = list_get(dists, e_dst);
                    let new_d: Float = u_dist + e_w;
                    if new_d < old_d {
                        // Update dists and prev
                        let mut upd_d: List[Float] = list_new();
                        let mut upd_p: List[Int] = list_new();
                        let mut k: Int = 0;
                        while k < num_nodes {
                            if k == e_dst {
                                upd_d = list_push(upd_d, new_d);
                                upd_p = list_push(upd_p, u);
                            } else {
                                upd_d = list_push(upd_d, list_get(dists, k));
                                upd_p = list_push(upd_p, list_get(prev, k));
                            }
                            k = k + 1;
                        }
                        dists = upd_d;
                        prev = upd_p;
                    }
                }
                e = e + 1;
            }
            step = step + 1;
        }
    }

    let final_dist: Float = list_get(dists, dst);
    if final_dist >= 99999999.0 {
        return dijkstra_path_result_empty();
    }

    let mut path: List[Int] = list_new();
    let mut curr: Int = dst;
    while curr != -1 {
        path = list_push(path, curr);
        if curr == src {
            curr = -1;
        } else {
            curr = list_get(prev, curr);
        }
    }

    return DijkstraPathResult {
        found: true,
        total_cost: final_dist,
        path_nodes: path,
        hop_count: list_len(path),
    };
}
