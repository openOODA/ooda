// # Property Graph Typed Edge Index
//
// Logline: Indexes graph edges partitioned by relationship type and direction for accelerated filtered traversals.
//
// Setup: Multi-level index grouping adjacency lists by relationship type identifiers.
//
// Beats:
//   1. Define TypePartitionedIndex and EdgeIndexEntry structures.
//   2. Implement typed edge registration and neighbor lookups.
//   3. Prune candidate edges during relationship type matching.

pub type EdgeIndexEntry = struct {
    edge_id: Int,
    src_node: Int,
    dst_node: Int,
    rel_type: Int,
    is_outgoing: Bool
};

pub type TypePartitionedIndex = struct {
    rel_type_id: Int,
    edge_ids: List[Int],
    count: Int
};

pub type EdgeIndexCatalog = struct {
    partitions: List[TypePartitionedIndex],
    partition_count: Int
};

pub fn edge_index_catalog_new() -> EdgeIndexCatalog {
    let empty_parts: List[TypePartitionedIndex] = list_new();
    return EdgeIndexCatalog {
        partitions: empty_parts,
        partition_count: 0
    };
}

pub fn edge_index_add_partition(
    catalog: EdgeIndexCatalog,
    rtype: Int
) -> EdgeIndexCatalog {
    let empty_eids: List[Int] = list_new();
    let p: TypePartitionedIndex = TypePartitionedIndex {
        rel_type_id: rtype,
        edge_ids: empty_eids,
        count: 0
    };
    let updated: List[TypePartitionedIndex] = list_push((catalog).partitions, p);
    return EdgeIndexCatalog {
        partitions: updated,
        partition_count: (catalog).partition_count + 1
    };
}

pub fn edge_index_register_edge(
    catalog: EdgeIndexCatalog,
    rtype: Int,
    eid: Int
) -> EdgeIndexCatalog {
    let mut updated_parts: List[TypePartitionedIndex] = list_new();
    let n: Int = list_len((catalog).partitions);
    let mut i: Int = 0;
    let mut found: Bool = false;

    while i < n {
        let p: TypePartitionedIndex = list_get((catalog).partitions, i);
        if (p).rel_type_id == rtype {
            let new_eids: List[Int] = list_push((p).edge_ids, eid);
            let new_p: TypePartitionedIndex = TypePartitionedIndex {
                rel_type_id: (p).rel_type_id,
                edge_ids: new_eids,
                count: (p).count + 1
            };
            updated_parts = list_push(updated_parts, new_p);
            found = true;
        } else {
            updated_parts = list_push(updated_parts, p);
        }
        i = i + 1;
    }

    if !found {
        let mut new_eids: List[Int] = list_new();
        new_eids = list_push(new_eids, eid);
        let new_p: TypePartitionedIndex = TypePartitionedIndex {
            rel_type_id: rtype,
            edge_ids: new_eids,
            count: 1
        };
        updated_parts = list_push(updated_parts, new_p);
    }

    return EdgeIndexCatalog {
        partitions: updated_parts,
        partition_count: list_len(updated_parts)
    };
}
