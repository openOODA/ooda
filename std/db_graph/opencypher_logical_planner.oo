// # OpenCypher Logical Query Planner
//
// Logline: Generates relational and graph logical query plans from parsed OpenCypher AST representations.
//
// Setup: Builds directed acyclic operator graphs consisting of NodeScans, EdgeExpands, Filters, and Projections.
//
// Beats:
//   1. Define LogicalOperator, PlanNodeType, and LogicalPlan container structures.
//   2. Implement plan tree builders for single-node scans and multi-hop relationship expansions.
//   3. Bind filter predicates and projection lists into logical operator trees.

import "./opencypher_ast_nodes.oo";

pub type LogicalPlanNode = struct {
    node_id: Int,
    op_type: Int, // 1: NodeScan, 2: EdgeExpand, 3: Filter, 4: Project, 5: Limit
    variable_name: String,
    label_or_type: String,
    predicate_str: String,
    child_id: Int,
    est_cardinality: Float,
    cost: Float
};

pub type LogicalPlan = struct {
    root_node_id: Int,
    nodes: List[LogicalPlanNode],
    node_count: Int
};

pub fn logical_plan_node_new(
    id: Int,
    op: Int,
    var_n: String,
    lbl: String,
    pred: String,
    child: Int
) -> LogicalPlanNode {
    return LogicalPlanNode {
        node_id: id,
        op_type: op,
        variable_name: var_n,
        label_or_type: lbl,
        predicate_str: pred,
        child_id: child,
        est_cardinality: 100.0,
        cost: 1.0
    };
}

pub fn logical_plan_new() -> LogicalPlan {
    let empty_nodes: List[LogicalPlanNode] = list_new();
    return LogicalPlan {
        root_node_id: -1,
        nodes: empty_nodes,
        node_count: 0
    };
}

pub fn logical_plan_add_node(plan: LogicalPlan, node: LogicalPlanNode) -> LogicalPlan {
    let updated_nodes: List[LogicalPlanNode] = list_push((plan).nodes, node);
    return LogicalPlan {
        root_node_id: (node).node_id,
        nodes: updated_nodes,
        node_count: (plan).node_count + 1
    };
}

pub fn cypher_build_logical_plan_from_ast(ast: CypherQueryAst) -> LogicalPlan {
    let mut plan: LogicalPlan = logical_plan_new();

    // 1. Scan source node
    let src_var: String = ((ast).match_clause.src_node).var_name;
    let src_lbl: String = ((ast).match_clause.src_node).label;
    let scan_node: LogicalPlanNode = logical_plan_node_new(1, 1, src_var, src_lbl, "", -1);
    plan = logical_plan_add_node(plan, scan_node);

    // 2. Expand edge if present
    let mut last_id: Int = 1;
    if (ast).match_clause.has_edge {
        let rel_type: String = ((ast).match_clause.rel).rel_type;
        let dst_var: String = ((ast).match_clause.dst_node).var_name;
        let expand_node: LogicalPlanNode = logical_plan_node_new(2, 2, dst_var, rel_type, "", 1);
        plan = logical_plan_add_node(plan, expand_node);
        last_id = 2;
    }

    // 3. Filter predicate if present
    if (ast).where_clause.has_filter {
        let filter_var: String = (ast).where_clause.target_var;
        let filter_node: LogicalPlanNode = logical_plan_node_new(3, 3, filter_var, "", "pred", last_id);
        plan = logical_plan_add_node(plan, filter_node);
        last_id = 3;
    }

    // 4. Project return
    let proj_node: LogicalPlanNode = logical_plan_node_new(4, 4, "", "", "project", last_id);
    plan = logical_plan_add_node(plan, proj_node);

    return plan;
}
