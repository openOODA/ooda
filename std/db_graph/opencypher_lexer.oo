// # OpenCypher Lexical Tokenizer
//
// Logline: Tokenizes raw OpenCypher query text into structured lexical tokens with source locations.
//
// Setup: Recognizes Cypher keywords, node/edge syntax delimiters, identifiers, literals, and relational operators.
//
// Beats:
//   1. Define CypherToken and CypherTokenType data structures.
//   2. Implement keyword classification and character classification helpers.
//   3. Implement lexical scanning loop generating ordered token sequences.

pub type CypherToken = struct {
    token_type: Int,
    lexeme: String,
    line_no: Int,
    col_no: Int
};

pub type CypherLexer = struct {
    source: String,
    cursor: Int,
    length: Int,
    line: Int,
    column: Int
};

pub fn cypher_token_new(tt: Int, lex: String, ln: Int, col: Int) -> CypherToken {
    return CypherToken {
        token_type: tt,
        lexeme: lex,
        line_no: ln,
        col_no: col
    };
}

pub fn cypher_lexer_new(src: String, len: Int) -> CypherLexer {
    return CypherLexer {
        source: src,
        cursor: 0,
        length: len,
        line: 1,
        column: 1
    };
}

pub fn cypher_classify_keyword(kw: String) -> Int {
    if kw == "MATCH" { return 101; }
    if kw == "OPTIONAL" { return 102; }
    if kw == "WHERE" { return 103; }
    if kw == "RETURN" { return 104; }
    if kw == "CREATE" { return 105; }
    if kw == "DELETE" { return 106; }
    if kw == "DETACH" { return 107; }
    if kw == "SET" { return 108; }
    if kw == "REMOVE" { return 109; }
    if kw == "MERGE" { return 110; }
    if kw == "WITH" { return 111; }
    if kw == "UNWIND" { return 112; }
    if kw == "ORDER" { return 113; }
    if kw == "BY" { return 114; }
    if kw == "LIMIT" { return 115; }
    if kw == "SKIP" { return 116; }
    if kw == "DISTINCT" { return 117; }
    if kw == "AND" { return 118; }
    if kw == "OR" { return 119; }
    if kw == "NOT" { return 120; }
    if kw == "AS" { return 121; }
    if kw == "IN" { return 122; }
    return 100; // Identifier
}

pub fn cypher_is_alpha(c: String) -> Bool {
    if c == "a" || c == "b" || c == "c" || c == "d" || c == "e" { return true; }
    if c == "f" || c == "g" || c == "h" || c == "i" || c == "j" { return true; }
    if c == "k" || c == "l" || c == "m" || c == "n" || c == "o" { return true; }
    if c == "p" || c == "q" || c == "r" || c == "s" || c == "t" { return true; }
    if c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z" { return true; }
    if c == "A" || c == "B" || c == "C" || c == "D" || c == "E" { return true; }
    if c == "F" || c == "G" || c == "H" || c == "I" || c == "J" { return true; }
    if c == "K" || c == "L" || c == "M" || c == "N" || c == "O" { return true; }
    if c == "P" || c == "Q" || c == "R" || c == "S" || c == "T" { return true; }
    if c == "U" || c == "V" || c == "W" || c == "X" || c == "Y" || c == "Z" { return true; }
    if c == "_" { return true; }
    return false;
}

pub fn cypher_is_digit(c: String) -> Bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true; }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true; }
    return false;
}

pub fn cypher_tokenize_simple(tokens: List[CypherToken], kw: String, line: Int, col: Int) -> List[CypherToken] {
    let tt: Int = cypher_classify_keyword(kw);
    let tok: CypherToken = cypher_token_new(tt, kw, line, col);
    return list_push(tokens, tok);
}
