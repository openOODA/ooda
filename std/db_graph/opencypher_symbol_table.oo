// # OpenCypher Symbol Table & Scope Resolution
//
// Logline: Manages variable bindings, scopes, and symbol resolution across clauses in OpenCypher queries.
//
// Setup: Resolves node identifiers, relationship handles, projection aliases, and nested WITH clause scopes.
//
// Beats:
//   1. Define CypherSymbol, SymbolKind, and CypherScope data structures.
//   2. Implement symbol insertion, lookup, and scope shadowing mechanisms.
//   3. Validate reference safety and detect undeclared graph variable access.

pub type CypherSymbol = struct {
    name: String,
    symbol_kind: Int, // 1: Node, 2: Relationship, 3: Alias/Expr, 4: Path
    inferred_label: String,
    scope_depth: Int,
    is_defined: Bool,
};

pub type CypherScope = struct {
    scope_id: Int,
    parent_scope_id: Int,
    symbols: List[CypherSymbol],
    symbol_count: Int,
};

pub type CypherSymbolTable = struct {
    current_scope_id: Int,
    next_scope_id: Int,
    scopes: List[CypherScope],
};

pub fn cypher_symbol_new(name: String, kind: Int, label: String, depth: Int) -> CypherSymbol {
    return CypherSymbol {
        name: name,
        symbol_kind: kind,
        inferred_label: label,
        scope_depth: depth,
        is_defined: true,
    };
}

pub fn cypher_scope_new(id: Int, parent_id: Int) -> CypherScope {
    let empty_syms: List[CypherSymbol] = list_new();
    return CypherScope {
        scope_id: id,
        parent_scope_id: parent_id,
        symbols: empty_syms,
        symbol_count: 0,
    };
}

pub fn cypher_symbol_table_new() -> CypherSymbolTable {
    let mut initial_scopes: List[CypherScope] = list_new();
    let root_scope: CypherScope = cypher_scope_new(0, -1);
    initial_scopes = list_push(initial_scopes, root_scope);

    return CypherSymbolTable {
        current_scope_id: 0,
        next_scope_id: 1,
        scopes: initial_scopes,
    };
}

pub fn cypher_symbol_table_push_scope(table: CypherSymbolTable) -> CypherSymbolTable {
    let new_id: Int = (table).next_scope_id;
    let new_scope: CypherScope = cypher_scope_new(new_id, (table).current_scope_id);
    let updated_scopes: List[CypherScope] = list_push((table).scopes, new_scope);

    return CypherSymbolTable {
        current_scope_id: new_id,
        next_scope_id: new_id + 1,
        scopes: updated_scopes,
    };
}

pub fn cypher_symbol_table_add_symbol(
    table: CypherSymbolTable,
    name: String,
    kind: Int,
    label: String
) -> CypherSymbolTable {
    let cur_id: Int = (table).current_scope_id;
    let mut updated_scopes: List[CypherScope] = list_new();
    let n: Int = list_len((table).scopes);
    let mut i: Int = 0;

    while i < n {
        let sc: CypherScope = list_get((table).scopes, i);
        if (sc).scope_id == cur_id {
            let sym: CypherSymbol = cypher_symbol_new(name, kind, label, cur_id);
            let new_syms: List[CypherSymbol] = list_push((sc).symbols, sym);
            let new_sc: CypherScope = CypherScope {
                scope_id: (sc).scope_id,
                parent_scope_id: (sc).parent_scope_id,
                symbols: new_syms,
                symbol_count: (sc).symbol_count + 1,
            };
            updated_scopes = list_push(updated_scopes, new_sc);
        } else {
            updated_scopes = list_push(updated_scopes, sc);
        }
        i = i + 1;
    }

    return CypherSymbolTable {
        current_scope_id: (table).current_scope_id,
        next_scope_id: (table).next_scope_id,
        scopes: updated_scopes,
    };
}

pub fn cypher_symbol_table_lookup(table: CypherSymbolTable, name: String) -> CypherSymbol {
    let n_scopes: Int = list_len((table).scopes);
    let mut s_idx: Int = n_scopes - 1;

    while s_idx >= 0 {
        let sc: CypherScope = list_get((table).scopes, s_idx);
        let n_syms: Int = list_len((sc).symbols);
        let mut sym_idx: Int = 0;
        while sym_idx < n_syms {
            let sym: CypherSymbol = list_get((sc).symbols, sym_idx);
            if (sym).name == name {
                return sym;
            }
            sym_idx = sym_idx + 1;
        }
        s_idx = s_idx - 1;
    }

    return CypherSymbol {
        name: name,
        symbol_kind: 0,
        inferred_label: "",
        scope_depth: -1,
        is_defined: false,
    };
}
