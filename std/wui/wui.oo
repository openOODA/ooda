// # Sovereign WebAssembly UI Suite Facade
//
// Logline: Unified export facade for openOODA Virtual DOM, diffing engine, patch serializer, Canvas 2D, and event bridge.
//
// Setup: Re-exports VDOM nodes, builders, patch serializers, canvas context, event router, and components.
//
// Beats:
//   1. Import VDOM node representations and declarative builder DSL.
//   2. Import tree reconciliation diffing and JSON/binary patch serializer.
//   3. Import Canvas 2D context bridge and VDOM-to-canvas direct rasterizer.
//   4. Import browser event bridge, event router, application architecture, scheduler, and components.

import "./wui_vnode.oo";
import "./wui_vdom_builder.oo";
import "./wui_patch.oo";
import "./wui_diff.oo";
import "./wui_patch_serializer.oo";
import "./wui_canvas_context.oo";
import "./wui_canvas_renderer.oo";
import "./wui_event_bridge.oo";
import "./wui_event_router.oo";
import "./wui_app.oo";
import "./wui_scheduler.oo";
import "./wui_components.oo";

pub fn wui_suite_probe() -> Int {
    let p1: Int = wui_vnode_probe();
    let p2: Int = wui_vdom_builder_probe();
    let p3: Int = wui_patch_probe();
    let p4: Int = wui_diff_probe();
    let p5: Int = wui_patch_serializer_probe();
    let p6: Int = wui_canvas_context_probe();
    let p7: Int = wui_canvas_renderer_probe();
    let p8: Int = wui_event_bridge_probe();
    let p9: Int = wui_event_router_probe();
    let p10: Int = wui_app_probe();
    let p11: Int = wui_scheduler_probe();
    let p12: Int = wui_components_probe();
    return p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11 + p12;
}
