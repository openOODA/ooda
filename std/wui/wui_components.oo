// # WebAssembly Reusable UI Components
//
// Logline: Standard component library offering buttons, cards, text inputs, modal dialogs, and badges.
//
// Setup: Pre-styled composable virtual DOM component generators for sovereign web applications.
//
// Beats:
//   1. Implement wui_button with click action binding and styling classes.
//   2. Implement wui_text_input with placeholder and value attributes.
//   3. Implement wui_card with header title and nested children container.
//   4. Implement wui_modal conditional pop-up dialog container.

import "./wui_vnode.oo";
import "./wui_vdom_builder.oo";

pub fn wui_button(text: String, on_click_action: String) -> VNode {
    let mut props: List[VProp] = list_new();
    props = list_push(props, prop_class("wui-btn"));
    props = list_push(props, prop_on_click(on_click_action));

    let mut ch: List[VNode] = list_new();
    ch = list_push(ch, h_text(text));
    return h_button(props, ch);
}

pub fn wui_text_input(placeholder: String, value: String) -> VNode {
    let mut props: List[VProp] = list_new();
    props = list_push(props, prop_class("wui-input"));
    props = list_push(props, prop_attr("placeholder", placeholder));
    props = list_push(props, prop_attr("value", value));
    return h_input(props);
}

pub fn wui_card(title: String, children: List[VNode]) -> VNode {
    let mut card_props: List[VProp] = list_new();
    card_props = list_push(card_props, prop_class("wui-card"));

    let mut card_children: List[VNode] = list_new();
    let mut title_props: List[VProp] = list_new();
    title_props = list_push(title_props, prop_class("wui-card-title"));
    let mut title_children: List[VNode] = list_new();
    title_children = list_push(title_children, h_text(title));
    let title_node: VNode = h_h2(title_props, title_children);
    card_children = list_push(card_children, title_node);

    let n: Int = list_len(children);
    let mut i: Int = 0;
    while i < n {
        card_children = list_push(card_children, list_get(children, i));
        i = i + 1;
    }
    return h_div(card_props, card_children);
}

pub fn wui_modal(title: String, is_open: Bool, content: VNode) -> VNode {
    if !is_open {
        let empty_p: List[VProp] = list_new();
        let empty_c: List[VNode] = list_new();
        return h_div(empty_p, empty_c);
    }

    let mut overlay_props: List[VProp] = list_new();
    overlay_props = list_push(overlay_props, prop_class("wui-modal-overlay"));

    let mut modal_children: List[VNode] = list_new();
    modal_children = list_push(modal_children, content);
    let card_node: VNode = wui_card(title, modal_children);

    let mut overlay_children: List[VNode] = list_new();
    overlay_children = list_push(overlay_children, card_node);
    return h_div(overlay_props, overlay_children);
}

pub fn wui_badge(label: String, color_cls: String) -> VNode {
    let mut props: List[VProp] = list_new();
    props = list_push(props, prop_class("wui-badge " + color_cls));
    let mut ch: List[VNode] = list_new();
    ch = list_push(ch, h_text(label));
    return h_span(props, ch);
}

pub fn wui_components_probe() -> Int {
    let btn: VNode = wui_button("Click", "do_it");
    let inp: VNode = wui_text_input("Name", "");
    let badge: VNode = wui_badge("New", "badge-green");
    return (btn).node_kind + (inp).node_kind + (badge).node_kind + wui_vdom_builder_probe();
}
