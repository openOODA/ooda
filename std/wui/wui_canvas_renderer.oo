// # Virtual DOM to Canvas 2D Direct Rasterizer
//
// Logline: Direct software and GPU-accelerated HTML5 Canvas 2D rasterization of Virtual DOM component trees.
//
// Setup: Enables full sovereign GUI rendering into canvas elements without relying on browser DOM layout.
//
// Beats:
//   1. Traverse VNode tree hierarchy recursively.
//   2. Translate container elements (div, card) into background and border canvas drawing commands.
//   3. Render text nodes via Canvas 2D fill_text operations.
//   4. Calculate child layout offsets and clip boundaries.

import "./wui_vnode.oo";
import "./wui_canvas_context.oo";

pub fn wui_canvas_render_vdom(canvas: &mut WuiCanvas2D, node: &VNode, x: Int, y: Int, w: Int, h: Int) {
    if (node).node_kind == 2 { // Text
        wui_canvas_set_fill_style(canvas, "#ffffff");
        wui_canvas_fill_text(canvas, (node).text, x, y + 14);
        return;
    }

    if (node).node_kind == 1 { // Element
        let tag: String = (node).tag;
        if tag == "div" || tag == "card" || tag == "button" {
            wui_canvas_set_fill_style(canvas, "#202020");
            wui_canvas_fill_rect(canvas, x, y, w, h);
            wui_canvas_set_stroke_style(canvas, "#404040");
            wui_canvas_stroke_rect(canvas, x, y, w, h);
        }

        let ch: List[VNode] = (node).children;
        let n: Int = list_len(ch);
        let mut cur_y: Int = y + 4;
        let mut i: Int = 0;
        while i < n {
            let child: VNode = list_get(ch, i);
            wui_canvas_render_vdom(canvas, &child, x + 4, cur_y, w - 8, 24);
            cur_y = cur_y + 28;
            i = i + 1;
        }
    }
}

pub fn wui_canvas_renderer_probe() -> Int {
    let mut c: WuiCanvas2D = wui_canvas_new(200, 200);
    let mut empty_p: List[VProp] = list_new();
    let mut empty_c: List[VNode] = list_new();
    let mut n: VNode = vnode_element("div", "", empty_p, empty_c);
    vnode_add_child(&mut n, vnode_text("hi"));
    wui_canvas_render_vdom(&mut c, &n, 0, 0, 200, 200);
    return list_len((c).commands) + wui_canvas_context_probe() + wui_vnode_probe();
}
