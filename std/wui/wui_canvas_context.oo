// # HTML5 Canvas 2D WebAssembly Bridge
//
// Logline: Canvas 2D context recording, immediate drawing command buffering, and serialization for browser canvas rendering.
//
// Setup: Bridges sovereign WASM graphics calculations to native HTML5 <canvas> 2D rendering contexts.
//
// Beats:
//   1. Define CanvasCommand and WuiCanvas2D structures.
//   2. Record fill_rect, stroke_rect, clear_rect, and fill_text operations.
//   3. Mutate fill style, stroke style, and line width state.
//   4. Serialize command stream into compact instruction string format.

pub type CanvasCommand = struct {
    cmd_type: Int, // 1: FillRect, 2: StrokeRect, 3: ClearRect, 4: FillText, 5: DrawLine
    x: Int,
    y: Int,
    w: Int,
    h: Int,
    color_str: String,
    text: String
};

pub type WuiCanvas2D = struct {
    width: Int,
    height: Int,
    fill_style: String,
    stroke_style: String,
    line_width: Int,
    commands: List[CanvasCommand]
};

pub fn wui_canvas_new(w: Int, h: Int) -> WuiCanvas2D {
    let cmds: List[CanvasCommand] = list_new();
    return WuiCanvas2D {
        width: w,
        height: h,
        fill_style: "#000000",
        stroke_style: "#ffffff",
        line_width: 1,
        commands: cmds
    };
}

pub fn wui_canvas_set_fill_style(canvas: &mut WuiCanvas2D, color: String) {
    (canvas).fill_style = color;
}

pub fn wui_canvas_set_stroke_style(canvas: &mut WuiCanvas2D, color: String) {
    (canvas).stroke_style = color;
}

pub fn wui_canvas_fill_rect(canvas: &mut WuiCanvas2D, x: Int, y: Int, w: Int, h: Int) {
    let cmd: CanvasCommand = CanvasCommand {
        cmd_type: 1, x: x, y: y, w: w, h: h, color_str: (canvas).fill_style, text: ""
    };
    let mut cmds: List[CanvasCommand] = (canvas).commands;
    cmds = list_push(cmds, cmd);
    (canvas).commands = cmds;
}

pub fn wui_canvas_stroke_rect(canvas: &mut WuiCanvas2D, x: Int, y: Int, w: Int, h: Int) {
    let cmd: CanvasCommand = CanvasCommand {
        cmd_type: 2, x: x, y: y, w: w, h: h, color_str: (canvas).stroke_style, text: ""
    };
    let mut cmds: List[CanvasCommand] = (canvas).commands;
    cmds = list_push(cmds, cmd);
    (canvas).commands = cmds;
}

pub fn wui_canvas_fill_text(canvas: &mut WuiCanvas2D, text: String, x: Int, y: Int) {
    let cmd: CanvasCommand = CanvasCommand {
        cmd_type: 4, x: x, y: y, w: 0, h: 0, color_str: (canvas).fill_style, text: text
    };
    let mut cmds: List[CanvasCommand] = (canvas).commands;
    cmds = list_push(cmds, cmd);
    (canvas).commands = cmds;
}

pub fn wui_canvas_serialize(canvas: &WuiCanvas2D) -> String {
    let cmds: List[CanvasCommand] = (canvas).commands;
    let n: Int = list_len(cmds);
    let mut out: String = "CANVAS_CMDS[" + n.to_string() + "]:";
    let mut i: Int = 0;
    while i < n {
        let c: CanvasCommand = list_get(cmds, i);
        out = out + "(" + (c).cmd_type.to_string() + ":" + (c).x.to_string() + "," + (c).y.to_string() + ")";
        i = i + 1;
    }
    return out;
}

pub fn wui_canvas_context_probe() -> Int {
    let mut c: WuiCanvas2D = wui_canvas_new(100, 100);
    wui_canvas_fill_rect(&mut c, 0, 0, 10, 10);
    return list_len((c).commands);
}
