// # Virtual DOM Tree Mutation Patch Operations
//
// Logline: Atomic mutation instructions describing structural and attribute differences between VDOM trees.
//
// Setup: Generates minimal surgical patch instructions for applying updates to browser DOM elements.
//
// Beats:
//   1. Define Patch structure with patch type, DOM path, indices, and payload nodes.
//   2. Implement replace_node, update_props, and set_text patch constructors.
//   3. Implement append_child and remove_child structural mutation patch constructors.
//   4. Provide patch probe verification function.

import "./wui_vnode.oo";

pub type Patch = struct {
    patch_type: Int, // 1: Replace, 2: UpdateProps, 3: AppendChild, 4: RemoveChild, 5: SetText
    path: String,
    target_index: Int,
    new_vnode: VNode,
    props: List[VProp],
    text_content: String
};

pub fn empty_node() -> VNode { return vnode_text(""); }

pub fn patch_replace_node(path: String, node: VNode) -> Patch {
    let empty_p: List[VProp] = list_new();
    return Patch {
        patch_type: 1,
        path: path,
        target_index: 0,
        new_vnode: node,
        props: empty_p,
        text_content: ""
    };
}

pub fn patch_update_props(path: String, props: List[VProp]) -> Patch { return Patch {
        patch_type: 2,
        path: path,
        target_index: 0,
        new_vnode: empty_node(),
        props: props,
        text_content: ""
    }; }

pub fn patch_append_child(path: String, child: VNode) -> Patch {
    let empty_p: List[VProp] = list_new();
    return Patch {
        patch_type: 3,
        path: path,
        target_index: 0,
        new_vnode: child,
        props: empty_p,
        text_content: ""
    };
}

pub fn patch_remove_child(path: String, index: Int) -> Patch {
    let empty_p: List[VProp] = list_new();
    return Patch {
        patch_type: 4,
        path: path,
        target_index: index,
        new_vnode: empty_node(),
        props: empty_p,
        text_content: ""
    };
}

pub fn patch_set_text(path: String, text: String) -> Patch {
    let empty_p: List[VProp] = list_new();
    return Patch {
        patch_type: 5,
        path: path,
        target_index: 0,
        new_vnode: empty_node(),
        props: empty_p,
        text_content: text
    };
}

pub fn wui_patch_probe() -> Int {
    let p: Patch = patch_set_text("root", "hello");
    let n: VNode = (p).new_vnode;
    return (n).node_kind + wui_vnode_probe();
}
