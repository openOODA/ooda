// # Declarative Virtual DOM Tree Builder DSL
//
// Logline: Composable element helpers, HTML tag builders, and property decorators for declarative UI composition.
//
// Setup: High-ergonomic DSL for authoring WebAssembly reactive user interfaces.
//
// Beats:
//   1. Implement property helper constructors (class, id, style, on_click, attr).
//   2. Implement container element builders (div, span, p, h1, h2).
//   3. Implement interactive element builders (button, input).
//   4. Implement text node factory wrapper.

import "./wui_vnode.oo";

pub fn prop_class(cls: String) -> VProp { return vprop_new("class", cls); }

pub fn prop_id(id: String) -> VProp { return vprop_new("id", id); }

pub fn prop_style(style: String) -> VProp { return vprop_new("style", style); }

pub fn prop_on_click(handler_id: String) -> VProp { return vprop_new("onclick", handler_id); }

pub fn prop_attr(k: String, v: String) -> VProp { return vprop_new(k, v); }

pub fn h_div(props: List[VProp], children: List[VNode]) -> VNode { return vnode_element("div", "", props, children); }

pub fn h_span(props: List[VProp], children: List[VNode]) -> VNode { return vnode_element("span", "", props, children); }

pub fn h_button(props: List[VProp], children: List[VNode]) -> VNode { return vnode_element("button", "", props, children); }

pub fn h_input(props: List[VProp]) -> VNode {
    let empty_ch: List[VNode] = list_new();
    return vnode_element("input", "", props, empty_ch);
}

pub fn h_p(props: List[VProp], children: List[VNode]) -> VNode { return vnode_element("p", "", props, children); }

pub fn h_h1(props: List[VProp], children: List[VNode]) -> VNode { return vnode_element("h1", "", props, children); }

pub fn h_h2(props: List[VProp], children: List[VNode]) -> VNode { return vnode_element("h2", "", props, children); }

pub fn h_text(content: String) -> VNode { return vnode_text(content); }

pub fn wui_vdom_builder_probe() -> Int {
    let p: VProp = vprop_new("k", "v");
    let n: VNode = vnode_text((p).key);
    return (n).node_kind + wui_vnode_probe();
}
