// # WebAssembly User Interaction Event Router
//
// Logline: Event subscription registry and dispatch table mapping DOM events to component action handlers.
//
// Setup: Decoupled event binding arbitration for WebAssembly application controllers.
//
// Beats:
//   1. Define EventHandlerBinding and WuiEventRouter registry structures.
//   2. Register element event listeners indexed by target DOM id and event name.
//   3. Route incoming browser events to registered action tags.
//   4. Implement event router verification probe.

import "./wui_event_bridge.oo";

pub type EventHandlerBinding = struct {
    target_id: String,
    event_name: String,
    action_tag: String
};

pub type WuiEventRouter = struct {
    bindings: List[EventHandlerBinding]
};

pub fn wui_event_router_new() -> WuiEventRouter {
    let b: List[EventHandlerBinding] = list_new();
    return WuiEventRouter { bindings: b };
}

pub fn wui_event_router_bind(router: &mut WuiEventRouter, target_id: String, event_name: String, action: String) {
    let binding: EventHandlerBinding = EventHandlerBinding {
        target_id: target_id,
        event_name: event_name,
        action_tag: action
    };
    let mut b: List[EventHandlerBinding] = (router).bindings;
    b = list_push(b, binding);
    (router).bindings = b;
}

pub fn wui_event_router_route(router: &WuiEventRouter, ev: &WuiBrowserEvent) -> Result[String, String] {
    let bindings: List[EventHandlerBinding] = (router).bindings;
    let n: Int = list_len(bindings);
    let mut i: Int = 0;
    while i < n {
        let b: EventHandlerBinding = list_get(bindings, i);
        let tid_b: String = (b).target_id;
        let tid_ev: String = (ev).target_id;
        let ename_b: String = (b).event_name;
        let ename_ev: String = (ev).event_name;

        if tid_b == tid_ev && ename_b == ename_ev {
            let act: String = (b).action_tag;
            return Ok(act);
        }
        i = i + 1;
    }
    return Err("ERR\tunhandled_event: " + (ev).event_name + " on " + (ev).target_id);
}

pub fn wui_event_router_probe() -> Int {
    let mut r: WuiEventRouter = wui_event_router_new();
    wui_event_router_bind(&mut r, "btn1", "click", "increment");
    let ev: WuiBrowserEvent = wui_event_new("click", "btn1", 0, "", 0, 0);
    let res: Result[String, String] = wui_event_router_route(&r, &ev);
    match res {
        Ok(act) => { return act.len() + wui_event_bridge_probe(); }
        Err(e) => { return 0; }
    }
}
