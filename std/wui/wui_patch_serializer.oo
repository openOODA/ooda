// # Virtual DOM Patch Serializer
//
// Logline: JSON and compact binary encoding of DOM patches for fast WebAssembly host bridge execution.
//
// Setup: Low-overhead serialization formatting for transmitting patch batches across JS WASM boundaries.
//
// Beats:
//   1. Serialize patch collections to structured JSON arrays.
//   2. Encode binary bytecode patch instruction sequences.
//   3. Compute patch metrics and total operation counts.
//   4. Provide patch serialization probe function.

import "./wui_patch.oo";

pub fn patch_serialize_json(patches: List[Patch]) -> String {
    let n: Int = list_len(patches);
    let mut json: String = "[";
    let mut i: Int = 0;
    while i < n {
        let p: Patch = list_get(patches, i);
        if i > 0 { json = json + ","; }
        json = json + "{\"t\":" + (p).patch_type.to_string() + ",\"p\":\"" + (p).path + "\"";
        if (p).patch_type == 4 {
            json = json + ",\"i\":" + (p).target_index.to_string();
        } else if (p).patch_type == 5 {
            json = json + ",\"v\":\"" + (p).text_content + "\"";
        }
        json = json + "}";
        i = i + 1;
    }
    json = json + "]";
    return json;
}

pub fn patch_serialize_binary(patches: List[Patch]) -> List[Int] {
    let mut bytes: List[Int] = list_new();
    let n: Int = list_len(patches);
    bytes = list_push(bytes, n);

    let mut i: Int = 0;
    while i < n {
        let p: Patch = list_get(patches, i);
        bytes = list_push(bytes, (p).patch_type);
        bytes = list_push(bytes, (p).target_index);
        bytes = list_push(bytes, (p).path.len());
        bytes = list_push(bytes, (p).text_content.len());
        i = i + 1;
    }
    return bytes;
}

pub fn wui_patch_serializer_probe() -> Int {
    let chk: Int = wui_patch_probe();
    let mut p_list: List[Patch] = list_new();
    let p: Patch = patch_set_text("0", "ok");
    p_list = list_push(p_list, p);
    let json: String = patch_serialize_json(p_list);
    return json.len() + chk;
}
