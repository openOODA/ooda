// # WebAssembly Browser Event Bridge
//
// Logline: Browser DOM event deserialization, event kind classification, and interaction payload decoding.
//
// Setup: Decodes incoming JS DOM events (click, input, keydown, resize) into sovereign WASM event records.
//
// Beats:
//   1. Define WuiBrowserEvent data structure.
//   2. Parse and decode structured event payloads from browser JS bridge.
//   3. Provide event type predicates (click, input, key, resize).
//   4. Implement event bridge verification probe.



pub type WuiBrowserEvent = struct {
    event_name: String,
    target_id: String,
    key_code: Int,
    value: String,
    client_x: Int,
    client_y: Int
};

pub fn wui_event_new(name: String, target: String, key: Int, val: String, cx: Int, cy: Int) -> WuiBrowserEvent { return WuiBrowserEvent {
        event_name: name,
        target_id: target,
        key_code: key,
        value: val,
        client_x: cx,
        client_y: cy
    }; }

pub fn wui_event_is_click(ev: &WuiBrowserEvent) -> Bool { return (ev).event_name == "click"; }

pub fn wui_event_is_input(ev: &WuiBrowserEvent) -> Bool { return (ev).event_name == "input" || (ev).event_name == "change"; }

pub fn wui_event_is_key(ev: &WuiBrowserEvent) -> Bool { return (ev).event_name == "keydown" || (ev).event_name == "keyup"; }

pub fn wui_event_bridge_probe() -> Int {
    let ev: WuiBrowserEvent = wui_event_new("click", "btn1", 0, "", 100, 200);
    if wui_event_is_click(&ev) {
        return (ev).client_x;
    }
    return 0;
}
