// # WebAssembly Virtual DOM Node Representation
//
// Logline: Immutable virtual DOM tree nodes, element properties, and hierarchy descriptors.
//
// Setup: Sovereign WASM UI node representations for high-performance diffing and DOM patching.
//
// Beats:
//   1. Define VProp key-value attribute structure.
//   2. Define VNode tree structure supporting elements, text, and components.
//   3. Implement element, text, and component node constructors.
//   4. Implement child element append and property lookup routines.

pub type VProp = struct {
    key: String,
    value: String
};

pub fn vprop_new(key: String, value: String) -> VProp { return VProp { key: key, value: value }; }

pub type VNode = struct {
    node_kind: Int, // 1: Element, 2: Text, 3: Component
    tag: String,
    key: String,
    text: String,
    props: List[VProp],
    children: List[VNode]
};

pub fn vnode_element(tag: String, key: String, props: List[VProp], children: List[VNode]) -> VNode { return VNode {
        node_kind: 1,
        tag: tag,
        key: key,
        text: "",
        props: props,
        children: children
    }; }

pub fn vnode_text(content: String) -> VNode {
    let empty_props: List[VProp] = list_new();
    let empty_children: List[VNode] = list_new();
    return VNode {
        node_kind: 2,
        tag: "",
        key: "",
        text: content,
        props: empty_props,
        children: empty_children
    };
}

pub fn vnode_component(name: String, key: String, props: List[VProp], children: List[VNode]) -> VNode { return VNode {
        node_kind: 3,
        tag: name,
        key: key,
        text: "",
        props: props,
        children: children
    }; }

pub fn vnode_add_child(node: &mut VNode, child: VNode) {
    let mut ch: List[VNode] = (node).children;
    ch = list_push(ch, child);
    (node).children = ch;
}

pub fn vnode_get_prop(node: &VNode, key: String) -> Result[String, String] {
    let props: List[VProp] = (node).props;
    let n: Int = list_len(props);
    let mut i: Int = 0;
    while i < n {
        let p: VProp = list_get(props, i);
        if (p).key == key {
            let v_val: String = (p).value;
            return Ok(v_val);
        }
        i = i + 1;
    }
    return Err("ERR\tprop_not_found: " + key);
}

pub fn wui_vnode_probe() -> Int { return 0; }
