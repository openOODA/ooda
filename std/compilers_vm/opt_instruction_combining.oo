// # Compiler Instruction Combining and Peephole Pass
//
// Logline: Algebraic simplification, bitwise identity reductions, and instruction combination peephole patterns.
//
// Setup: Matches local instruction patterns against algebraic identities (e.g. x+0, x*1, x*0, x^x, x&~0) and replaces them.
//
// Beats:
//   1. Define PeepholePattern, CombineAction, and CombineResult structures.
//   2. Match algebraic identities (additive/multiplicative zero and identity, idempotence).
//   3. Apply strength reduction peepholes (e.g. multiply-by-power-of-two to bitwise left shift).

pub type CombineAction = struct {
    action_type: Int, // 0: NO_CHANGE, 1: REPLACE_WITH_CONSTANT, 2: REPLACE_WITH_OPERAND, 3: REPLACE_WITH_SHIFT
    replacement_operand: String,
    replacement_constant: Int,
    shift_amount: Int
};

pub type CombineStats = struct {
    num_identity_eliminated: Int,
    num_constant_simplified: Int,
    num_shifts_converted: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn combine_action_no_change() -> CombineAction {
    return CombineAction {
        action_type: 0,
        replacement_operand: "",
        replacement_constant: 0,
        shift_amount: 0
    };
}

pub fn combine_action_constant(val: Int) -> CombineAction {
    return CombineAction {
        action_type: 1,
        replacement_operand: "",
        replacement_constant: val,
        shift_amount: 0
    };
}

pub fn combine_action_operand(op_name: String) -> CombineAction {
    return CombineAction {
        action_type: 2,
        replacement_operand: op_name,
        replacement_constant: 0,
        shift_amount: 0
    };
}

pub fn combine_action_shift(op_name: String, shift: Int) -> CombineAction {
    return CombineAction {
        action_type: 3,
        replacement_operand: op_name,
        replacement_constant: 0,
        shift_amount: shift
    };
}

pub fn combine_stats_new() -> CombineStats {
    return CombineStats {
        num_identity_eliminated: 0,
        num_constant_simplified: 0,
        num_shifts_converted: 0
    };
}

// -------------------------------------------------------------------
// Helper: Is Power of Two
// -------------------------------------------------------------------

pub fn log2_exact(val: Int) -> Int {
    if val == 1 { return 0; }
    if val == 2 { return 1; }
    if val == 4 { return 2; }
    if val == 8 { return 3; }
    if val == 16 { return 4; }
    if val == 32 { return 5; }
    if val == 64 { return 6; }
    if val == 128 { return 7; }
    if val == 256 { return 8; }
    if val == 512 { return 9; }
    if val == 1024 { return 10; }
    if val == 2048 { return 11; }
    if val == 4096 { return 12; }
    return -1;
}

// -------------------------------------------------------------------
// Peephole Simplifications
// -------------------------------------------------------------------

pub fn combine_binary_inst(
    opcode: Int,
    lhs_var: String,
    rhs_var: String,
    lhs_is_const: Int,
    lhs_const: Int,
    rhs_is_const: Int,
    rhs_const: Int
) -> CombineAction {
    // 1: ADD
    if opcode == 1 {
        // x + 0 -> x
        if rhs_is_const == 1 && rhs_const == 0 {
            return combine_action_operand(lhs_var);
        }
        // 0 + x -> x
        if lhs_is_const == 1 && lhs_const == 0 {
            return combine_action_operand(rhs_var);
        }
    }
    
    // 2: SUB
    if opcode == 2 {
        // x - 0 -> x
        if rhs_is_const == 1 && rhs_const == 0 {
            return combine_action_operand(lhs_var);
        }
        // x - x -> 0
        if lhs_var == rhs_var && lhs_is_const == 0 && rhs_is_const == 0 {
            return combine_action_constant(0);
        }
    }
    
    // 3: MUL
    if opcode == 3 {
        // x * 1 -> x
        if rhs_is_const == 1 && rhs_const == 1 {
            return combine_action_operand(lhs_var);
        }
        // 1 * x -> x
        if lhs_is_const == 1 && lhs_const == 1 {
            return combine_action_operand(rhs_var);
        }
        // x * 0 -> 0
        if (rhs_is_const == 1 && rhs_const == 0) || (lhs_is_const == 1 && lhs_const == 0) {
            return combine_action_constant(0);
        }
        // x * (2^k) -> x << k
        if rhs_is_const == 1 {
            let shift: Int = log2_exact(rhs_const);
            if shift > 0 {
                return combine_action_shift(lhs_var, shift);
            }
        }
    }
    
    // 8: XOR
    if opcode == 8 {
        // x ^ x -> 0
        if lhs_var == rhs_var {
            return combine_action_constant(0);
        }
        // x ^ 0 -> x
        if rhs_is_const == 1 && rhs_const == 0 {
            return combine_action_operand(lhs_var);
        }
    }
    
    return combine_action_no_change();
}
