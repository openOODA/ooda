// # SSA Alias Analysis Engine
//
// Logline: Memory location points-to analysis and alias classification (NoAlias, MayAlias, MustAlias) for compiler optimization passes.
//
// Setup: Computes memory location bounds, pointer origin tracking, and alias relations.
//
// Beats:
//   1. Define memory location tags and alias classification results.
//   2. Track pointer base provenance and offset calculations.
//   3. Provide alias queries: no_alias, may_alias, and must_alias.

pub type MemoryLocation = struct {
    loc_id: Int,
    base_var: String,
    offset_bytes: Int,
    size_bytes: Int,
    is_stack: Int,
    is_heap: Int,
    is_global: Int,
};

pub type AliasResult = struct {
    alias_kind: Int, // 0: NoAlias, 1: MayAlias, 2: PartialAlias, 3: MustAlias
    description: String,
};

pub type AliasAnalysisContext = struct {
    locations: List[MemoryLocation],
    loc_count: Int,
};

// -------------------------------------------------------------------
// Constants
// -------------------------------------------------------------------

pub fn alias_no_alias() -> Int { return 0; }
pub fn alias_may_alias() -> Int { return 1; }
pub fn alias_partial_alias() -> Int { return 2; }
pub fn alias_must_alias() -> Int { return 3; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn memory_location_new(loc_id: Int, base_var: String, offset: Int, size: Int) -> MemoryLocation {
    return MemoryLocation {
        loc_id: loc_id,
        base_var: base_var,
        offset_bytes: offset,
        size_bytes: size,
        is_stack: 0,
        is_heap: 0,
        is_global: 0,
    };
}

pub fn memory_location_stack(loc_id: Int, base_var: String, offset: Int, size: Int) -> MemoryLocation {
    let mut loc: MemoryLocation = memory_location_new(loc_id, base_var, offset, size);
    loc.is_stack = 1;
    return loc;
}

pub fn memory_location_heap(loc_id: Int, base_var: String, offset: Int, size: Int) -> MemoryLocation {
    let mut loc: MemoryLocation = memory_location_new(loc_id, base_var, offset, size);
    loc.is_heap = 1;
    return loc;
}

pub fn alias_result_new(kind: Int, desc: String) -> AliasResult {
    return AliasResult {
        alias_kind: kind,
        description: desc,
    };
}

pub fn alias_context_new() -> AliasAnalysisContext {
    let empty_locs: List[MemoryLocation] = list_new();
    return AliasAnalysisContext {
        locations: empty_locs,
        loc_count: 0,
    };
}

pub fn alias_context_add_loc(mut ctx: AliasAnalysisContext, loc: MemoryLocation) -> AliasAnalysisContext {
    let mut locs: List[MemoryLocation] = (ctx).locations;
    locs = list_push(locs, loc);
    ctx.locations = locs;
    ctx.loc_count = (ctx).loc_count + 1;
    return ctx;
}

// -------------------------------------------------------------------
// Alias Query Logic
// -------------------------------------------------------------------

pub fn query_alias(loc_a: MemoryLocation, loc_b: MemoryLocation) -> AliasResult {
    // Distinct memory spaces cannot alias
    if (loc_a).is_stack == 1 && (loc_b).is_heap == 1 {
        return alias_result_new(0, "Distinct storage: stack vs heap");
    }
    if (loc_a).is_heap == 1 && (loc_b).is_stack == 1 {
        return alias_result_new(0, "Distinct storage: heap vs stack");
    }
    if (loc_a).is_global == 1 && (loc_b).is_stack == 1 {
        return alias_result_new(0, "Distinct storage: global vs stack");
    }

    // Same base variable
    if (loc_a).base_var.contains((loc_b).base_var) && (loc_b).base_var.contains((loc_a).base_var) {
        if (loc_a).offset_bytes == (loc_b).offset_bytes && (loc_a).size_bytes == (loc_b).size_bytes {
            return alias_result_new(3, "Exact same base and offset");
        }
        
        let start_a: Int = (loc_a).offset_bytes;
        let end_a: Int = start_a + (loc_a).size_bytes;
        let start_b: Int = (loc_b).offset_bytes;
        let end_b: Int = start_b + (loc_b).size_bytes;
        
        if end_a <= start_b || end_b <= start_a {
            return alias_result_new(0, "Disjoint offsets on same base");
        }
        return alias_result_new(2, "Overlapping offsets on same base");
    }

    // Different distinct base allocations
    if (loc_a).is_stack == 1 && (loc_b).is_stack == 1 {
        return alias_result_new(0, "Distinct stack allocations");
    }

    return alias_result_new(1, "Conservative may alias");
}
