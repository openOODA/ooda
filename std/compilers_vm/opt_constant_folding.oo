// # Compiler Constant Folding and Propagation Pass
//
// Logline: Sparse Conditional Constant Propagation (SCCP), 3-state lattice evaluations, and algebraic simplification rules.
//
// Setup: Solves fixed-point constant lattices (Top = uninitialized, Constant = known value, Bottom = overdefined).
//
// Beats:
//   1. Represent lattice values (Top, Constant, Bottom) and binary/unary expression evaluators.
//   2. Compute constant folding rules for arithmetic, logical, and relational operators.
//   3. Fold conditional branches with statically known predicates.

pub type LatticeVal = struct {
    tag: Int, // 0: TOP (unvisited), 1: CONSTANT (known), 2: BOTTOM (overdefined)
    int_val: Int,
};

pub type ConstantFolderContext = struct {
    num_folded_ops: Int,
    num_folded_branches: Int,
};

// -------------------------------------------------------------------
// Constants
// -------------------------------------------------------------------

pub fn lattice_top() -> LatticeVal {
    return LatticeVal { tag: 0, int_val: 0 };
}

pub fn lattice_const(val: Int) -> LatticeVal {
    return LatticeVal { tag: 1, int_val: val };
}

pub fn lattice_bottom() -> LatticeVal {
    return LatticeVal { tag: 2, int_val: 0 };
}

// -------------------------------------------------------------------
// Lattice Meet Operator
// -------------------------------------------------------------------

pub fn lattice_meet(a: LatticeVal, b: LatticeVal) -> LatticeVal {
    if (a).tag == 0 {
        return b;
    }
    if (b).tag == 0 {
        return a;
    }
    if (a).tag == 2 || (b).tag == 2 {
        return lattice_bottom();
    }
    if (a).tag == 1 && (b).tag == 1 {
        if (a).int_val == (b).int_val {
            return a;
        }
        return lattice_bottom();
    }
    return lattice_bottom();
}

// -------------------------------------------------------------------
// Constant Evaluation Rules
// -------------------------------------------------------------------

pub fn fold_binary_op(opcode: Int, lhs: LatticeVal, rhs: LatticeVal) -> LatticeVal {
    if (lhs).tag == 2 || (rhs).tag == 2 {
        return lattice_bottom();
    }
    if (lhs).tag == 0 || (rhs).tag == 0 {
        return lattice_top();
    }
    // Both are constant
    let l: Int = (lhs).int_val;
    let r: Int = (rhs).int_val;
    
    // Opcode 1: ADD
    if opcode == 1 {
        return lattice_const(l + r);
    }
    // Opcode 2: SUB
    if opcode == 2 {
        return lattice_const(l - r);
    }
    // Opcode 3: MUL
    if opcode == 3 {
        return lattice_const(l * r);
    }
    // Opcode 4: DIV
    if opcode == 4 {
        if r != 0 {
            return lattice_const(l / r);
        }
        return lattice_bottom();
    }
    // Opcode 5: REM / MOD
    if opcode == 5 {
        if r != 0 {
            let q: Int = l / r;
            return lattice_const(l - (q * r));
        }
        return lattice_bottom();
    }
    // Opcode 6: BITWISE AND
    if opcode == 6 {
        return lattice_const(l & r);
    }
    // Opcode 7: BITWISE OR
    if opcode == 7 {
        return lattice_const(l | r);
    }
    // Opcode 8: BITWISE XOR
    if opcode == 8 {
        return lattice_const(l ^ r);
    }
    // Opcode 9: EQ
    if opcode == 9 {
        if l == r { return lattice_const(1); }
        return lattice_const(0);
    }
    // Opcode 10: LT
    if opcode == 10 {
        if l < r { return lattice_const(1); }
        return lattice_const(0);
    }
    // Opcode 11: GT
    if opcode == 11 {
        if l > r { return lattice_const(1); }
        return lattice_const(0);
    }
    return lattice_bottom();
}

pub fn fold_branch_condition(cond: LatticeVal) -> Int {
    // Returns -1 if unknown, 1 if always true, 0 if always false
    if (cond).tag == 1 {
        if (cond).int_val != 0 {
            return 1;
        }
        return 0;
    }
    return -1;
}

pub fn constant_folder_context_new() -> ConstantFolderContext {
    return ConstantFolderContext {
        num_folded_ops: 0,
        num_folded_branches: 0,
    };
}
