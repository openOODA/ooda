// # Virtual Machine Bytecode Instruction Set
//
// Logline: Bytecode instruction definitions, fixed/variable width encoding, opcode dispatch tables, and operand layout models.
//
// Setup: Defines standardized 8-bit bytecode instruction opcodes for register/stack virtual machine architectures.
//
// Beats:
//   1. Define Opcode constants for arithmetic, stack manipulation, memory, control flow, and method invocation.
//   2. Define BytecodeInstruction and BytecodeProgram structures.
//   3. Provide instruction decoder and disassembly string generator.

pub type BytecodeInstruction = struct {
    opcode: Int,
    arg0: Int,
    arg1: Int,
    arg2: Int,
    mnemonic: String,
};

pub type BytecodeProgram = struct {
    instructions: List[BytecodeInstruction],
    instruction_count: Int,
};

// -------------------------------------------------------------------
// VM Bytecode Opcodes
// -------------------------------------------------------------------

pub fn op_nop() -> Int { return 0; }
pub fn op_load_const() -> Int { return 1; }
pub fn op_load_local() -> Int { return 2; }
pub fn op_store_local() -> Int { return 3; }
pub fn op_pop() -> Int { return 4; }
pub fn op_dup() -> Int { return 5; }
pub fn op_swap() -> Int { return 6; }
pub fn op_iadd() -> Int { return 10; }
pub fn op_isub() -> Int { return 11; }
pub fn op_imul() -> Int { return 12; }
pub fn op_idiv() -> Int { return 13; }
pub fn op_imod() -> Int { return 14; }
pub fn op_iand() -> Int { return 15; }
pub fn op_ior() -> Int { return 16; }
pub fn op_ixor() -> Int { return 17; }
pub fn op_ishl() -> Int { return 18; }
pub fn op_ishr() -> Int { return 19; }
pub fn op_jmp() -> Int { return 30; }
pub fn op_jmp_if_true() -> Int { return 31; }
pub fn op_jmp_if_false() -> Int { return 32; }
pub fn op_call() -> Int { return 40; }
pub fn op_ret() -> Int { return 41; }
pub fn op_get_field() -> Int { return 50; }
pub fn op_put_field() -> Int { return 51; }
pub fn op_new_object() -> Int { return 52; }
pub fn op_throw() -> Int { return 60; }
pub fn op_halt() -> Int { return 255; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn bc_inst_new(opcode: Int, a0: Int, a1: Int, a2: Int, mnem: String) -> BytecodeInstruction {
    return BytecodeInstruction {
        opcode: opcode,
        arg0: a0,
        arg1: a1,
        arg2: a2,
        mnemonic: mnem,
    };
}

pub fn bc_program_new() -> BytecodeProgram {
    let empty_insts: List[BytecodeInstruction] = list_new();
    return BytecodeProgram {
        instructions: empty_insts,
        instruction_count: 0,
    };
}

pub fn bc_program_add(mut prog: BytecodeProgram, inst: BytecodeInstruction) -> BytecodeProgram {
    let mut insts: List[BytecodeInstruction] = (prog).instructions;
    insts = list_push(insts, inst);
    prog.instructions = insts;
    prog.instruction_count = (prog).instruction_count + 1;
    return prog;
}
