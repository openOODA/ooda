// # WebAssembly Threads and Atomic Memory Engine
//
// Logline: WebAssembly Threads proposal (0xFE prefix) atomic loads, stores, read-modify-write (RMW), and futex wait/notify.
//
// Setup: Emits two-byte prefixed 0xFE WebAssembly atomic memory operations with memory alignment flags and byte offsets.
//
// Beats:
//   1. Define WasmAtomicOpcode constants and WasmAtomicMemOp structure.
//   2. Encode atomic loads, stores, and RMW operations (add, sub, and, or, xor, xchg, cmpxchg).
//   3. Encode memory.atomic.wait32/wait64 and memory.atomic.notify futex operations.

import "./wasm_leb128_codec.oo";

pub type WasmAtomicMemOp = struct {
    atomic_opcode: Int,
    mnemonic: String,
    alignment_power: Int,
    offset_bytes: Int,
};

// -------------------------------------------------------------------
// Atomic Sub-Opcodes (0xFE prefix)
// -------------------------------------------------------------------

pub fn atomic_memory_atomic_notify() -> Int { return 0; }
pub fn atomic_memory_atomic_wait32() -> Int { return 1; }
pub fn atomic_memory_atomic_wait64() -> Int { return 2; }
pub fn atomic_i32_atomic_load() -> Int { return 16; }
pub fn atomic_i64_atomic_load() -> Int { return 17; }
pub fn atomic_i32_atomic_store() -> Int { return 23; }
pub fn atomic_i64_atomic_store() -> Int { return 24; }
pub fn atomic_i32_atomic_rmw_add() -> Int { return 30; }
pub fn atomic_i64_atomic_rmw_add() -> Int { return 31; }
pub fn atomic_i32_atomic_rmw_sub() -> Int { return 37; }
pub fn atomic_i64_atomic_rmw_sub() -> Int { return 38; }
pub fn atomic_i32_atomic_rmw_and() -> Int { return 44; }
pub fn atomic_i64_atomic_rmw_and() -> Int { return 45; }
pub fn atomic_i32_atomic_rmw_or() -> Int { return 51; }
pub fn atomic_i64_atomic_rmw_or() -> Int { return 52; }
pub fn atomic_i32_atomic_rmw_xor() -> Int { return 58; }
pub fn atomic_i64_atomic_rmw_xor() -> Int { return 59; }
pub fn atomic_i32_atomic_rmw_xchg() -> Int { return 65; }
pub fn atomic_i64_atomic_rmw_xchg() -> Int { return 66; }
pub fn atomic_i32_atomic_rmw_cmpxchg() -> Int { return 72; }
pub fn atomic_i64_atomic_rmw_cmpxchg() -> Int { return 73; }

// -------------------------------------------------------------------
// Constructors & Encoders
// -------------------------------------------------------------------

pub fn wasm_atomic_op_new(
    opcode: Int,
    mnem: String,
    align_pow: Int,
    offset: Int
) -> WasmAtomicMemOp {
    return WasmAtomicMemOp {
        atomic_opcode: opcode,
        mnemonic: mnem,
        alignment_power: align_pow,
        offset_bytes: offset,
    };
}

pub fn encode_atomic_instruction(op: WasmAtomicMemOp) -> List[Int] {
    let mut bytes: List[Int] = list_new();
    
    // Atomic Prefix: 0xFE
    bytes = list_push(bytes, 254);
    
    // Sub-opcode
    let op_leb: List[Int] = encode_u32_leb128((op).atomic_opcode);
    let n_op: Int = list_len(op_leb);
    let mut i: Int = 0;
    while i < n_op {
        bytes = list_push(bytes, list_get(op_leb, i));
        i = i + 1;
    }
    
    // Memory immediate: align (LEB128) then offset (LEB128)
    let align_leb: List[Int] = encode_u32_leb128((op).alignment_power);
    let n_align: Int = list_len(align_leb);
    let mut a: Int = 0;
    while a < n_align {
        bytes = list_push(bytes, list_get(align_leb, a));
        a = a + 1;
    }
    
    let offset_leb: List[Int] = encode_u32_leb128((op).offset_bytes);
    let n_off: Int = list_len(offset_leb);
    let mut o: Int = 0;
    while o < n_off {
        bytes = list_push(bytes, list_get(offset_leb, o));
        o = o + 1;
    }
    
    return bytes;
}
