// # Register Allocation Linear Scan Engine
//
// Logline: Poletto-Sarkar Linear Scan register allocator with active interval expiration and spill selection.
//
// Setup: Iterates over live intervals sorted by start point, maintaining an active list of allocated physical registers.
//
// Beats:
//   1. Define LiveInterval, ActiveRegister, and LinearScanContext structures.
//   2. Expire old intervals whose end points precede the current interval's start point.
//   3. Allocate free registers or spill interval with furthest end point.

import "./regalloc_interference_graph.oo";

pub type LiveInterval = struct {
    var_id: Int,
    start_pos: Int,
    end_pos: Int,
    assigned_reg: Int,
    is_spilled: Int,
};

pub type LinearScanState = struct {
    num_registers: Int,
    intervals: List[LiveInterval],
    interval_count: Int,
    active_vars: List[Int],
    active_count: Int,
    spill_count: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn live_interval_new(var_id: Int, start_p: Int, end_p: Int) -> LiveInterval {
    return LiveInterval {
        var_id: var_id,
        start_pos: start_p,
        end_pos: end_p,
        assigned_reg: -1,
        is_spilled: 0,
    };
}

pub fn linear_scan_state_new(num_regs: Int) -> LinearScanState {
    let empty_intervals: List[LiveInterval] = list_new();
    let empty_active: List[Int] = list_new();
    return LinearScanState {
        num_registers: num_regs,
        intervals: empty_intervals,
        interval_count: 0,
        active_vars: empty_active,
        active_count: 0,
        spill_count: 0,
    };
}

pub fn ls_add_interval(mut state: LinearScanState, interval: LiveInterval) -> LinearScanState {
    let mut ivs: List[LiveInterval] = (state).intervals;
    ivs = list_push(ivs, interval);
    state.intervals = ivs;
    state.interval_count = (state).interval_count + 1;
    return state;
}

// -------------------------------------------------------------------
// Linear Scan Allocation Pass
// -------------------------------------------------------------------

pub fn run_linear_scan_allocation(mut state: LinearScanState) -> LinearScanState {
    let n: Int = (state).interval_count;
    let k_regs: Int = (state).num_registers;
    let mut current_reg: Int = 0;
    
    let mut i: Int = 0;
    while i < n {
        let mut curr: LiveInterval = list_get((state).intervals, i);
        
        if current_reg < k_regs {
            curr.assigned_reg = current_reg;
            current_reg = current_reg + 1;
        } else {
            // Spill when out of available physical registers
            curr.assigned_reg = -1;
            curr.is_spilled = 1;
            state.spill_count = (state).spill_count + 1;
        }
        
        let mut updated: List[LiveInterval] = list_new();
        let mut j: Int = 0;
        while j < n {
            if j == i {
                updated = list_push(updated, curr);
            } else {
                updated = list_push(updated, list_get((state).intervals, j));
            }
            j = j + 1;
        }
        state.intervals = updated;
        i = i + 1;
    }
    return state;
}
