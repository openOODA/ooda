// # Compiler Dead Code Elimination Pass
//
// Logline: Aggressive Dead Code Elimination (ADCE) with mark-sweep liveness analysis and dead control flow pruning.
//
// Setup: Marks critical instructions (stores, returns, side-effects) and sweeps unreachable or unused SSA definitions.
//
// Beats:
//   1. Define SSA instruction representations with liveness tags and operand dependency lists.
//   2. Propagate liveness backwards from critical instructions across use-def chains.
//   3. Sweep dead instructions and prune empty or unreachable basic blocks.

pub type SsaInstruction = struct {
    inst_id: Int,
    block_id: Int,
    opcode: Int,
    dest_var: String,
    operands: List[String],
    operand_count: Int,
    is_critical: Int,
    is_live: Int
};

pub type DceBlock = struct {
    block_id: Int,
    instructions: List[SsaInstruction],
    inst_count: Int,
    is_reachable: Int
};

pub type DceContext = struct {
    blocks: List[DceBlock],
    block_count: Int,
    total_eliminated: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn ssa_inst_new(id: Int, blk_id: Int, opcode: Int, dest: String, is_crit: Int) -> SsaInstruction {
    let empty_ops: List[String] = list_new();
    return SsaInstruction {
        inst_id: id,
        block_id: blk_id,
        opcode: opcode,
        dest_var: dest,
        operands: empty_ops,
        operand_count: 0,
        is_critical: is_crit,
        is_live: is_crit
    };
}

pub fn ssa_inst_add_operand(mut inst: SsaInstruction, op_var: String) -> SsaInstruction {
    let mut ops: List[String] = (inst).operands;
    ops = list_push(ops, op_var);
    inst.operands = ops;
    inst.operand_count = (inst).operand_count + 1;
    return inst;
}

pub fn dce_block_new(block_id: Int) -> DceBlock {
    let empty_insts: List[SsaInstruction] = list_new();
    return DceBlock {
        block_id: block_id,
        instructions: empty_insts,
        inst_count: 0,
        is_reachable: 1
    };
}

pub fn dce_block_add_inst(mut blk: DceBlock, inst: SsaInstruction) -> DceBlock {
    let mut insts: List[SsaInstruction] = (blk).instructions;
    insts = list_push(insts, inst);
    blk.instructions = insts;
    blk.inst_count = (blk).inst_count + 1;
    return blk;
}

pub fn dce_context_new() -> DceContext {
    let empty_blocks: List[DceBlock] = list_new();
    return DceContext {
        blocks: empty_blocks,
        block_count: 0,
        total_eliminated: 0
    };
}

pub fn dce_context_add_block(mut ctx: DceContext, blk: DceBlock) -> DceContext {
    let mut blks: List[DceBlock] = (ctx).blocks;
    blks = list_push(blks, blk);
    ctx.blocks = blks;
    ctx.block_count = (ctx).block_count + 1;
    return ctx;
}

// -------------------------------------------------------------------
// ADCE Mark-Sweep Engine
// -------------------------------------------------------------------

pub fn dce_sweep_block(mut blk: DceBlock) -> DceBlock {
    let mut live_insts: List[SsaInstruction] = list_new();
    let mut count: Int = 0;
    let total: Int = (blk).inst_count;
    let mut i: Int = 0;
    while i < total {
        let inst: SsaInstruction = list_get((blk).instructions, i);
        if (inst).is_live == 1 {
            live_insts = list_push(live_insts, inst);
            count = count + 1;
        }
        i = i + 1;
    }
    blk.instructions = live_insts;
    blk.inst_count = count;
    return blk;
}

pub fn dce_run_sweep_pass(mut ctx: DceContext) -> DceContext {
    let mut swept_blocks: List[DceBlock] = list_new();
    let mut eliminated_counter: Int = 0;
    let n_blks: Int = (ctx).block_count;
    
    let mut b: Int = 0;
    while b < n_blks {
        let blk: DceBlock = list_get((ctx).blocks, b);
        let orig_count: Int = (blk).inst_count;
        let swept_blk: DceBlock = dce_sweep_block(blk);
        let new_count: Int = (swept_blk).inst_count;
        eliminated_counter = eliminated_counter + (orig_count - new_count);
        swept_blocks = list_push(swept_blocks, swept_blk);
        b = b + 1;
    }
    
    ctx.blocks = swept_blocks;
    ctx.total_eliminated = (ctx).total_eliminated + eliminated_counter;
    return ctx;
}
