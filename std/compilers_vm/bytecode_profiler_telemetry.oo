// # Virtual Machine Profiler Telemetry Engine
//
// Logline: Execution frequency profiling, branch bias telemetry, type feedback vectors, and hotness classification.
//
// Setup: Records runtime execution metrics to inform profile-guided optimization (PGO) and dynamic deoptimization guards.
//
// Beats:
//   1. Define BranchFeedback, TypeFeedbackEntry, and MethodTelemetry structures.
//   2. Record taken vs fallthrough branch frequencies to determine branch probability.
//   3. Aggregate observed operand types for monomorphic type specialization.

pub type BranchFeedback = struct {
    branch_bc_offset: Int,
    taken_count: Int,
    not_taken_count: Int
};

pub type TypeFeedbackEntry = struct {
    inst_bc_offset: Int,
    observed_class_id: Int,
    observation_count: Int
};

pub type MethodTelemetry = struct {
    method_id: Int,
    execution_ticks: Int,
    branch_feedbacks: List[BranchFeedback],
    branch_count: Int,
    type_feedbacks: List[TypeFeedbackEntry],
    type_count: Int,
    hotness_score: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn branch_feedback_new(bc_off: Int) -> BranchFeedback {
    return BranchFeedback {
        branch_bc_offset: bc_off,
        taken_count: 0,
        not_taken_count: 0
    };
}

pub fn type_feedback_entry_new(bc_off: Int, class_id: Int) -> TypeFeedbackEntry {
    return TypeFeedbackEntry {
        inst_bc_offset: bc_off,
        observed_class_id: class_id,
        observation_count: 1
    };
}

pub fn method_telemetry_new(method_id: Int) -> MethodTelemetry {
    let empty_branches: List[BranchFeedback] = list_new();
    let empty_types: List[TypeFeedbackEntry] = list_new();
    return MethodTelemetry {
        method_id: method_id,
        execution_ticks: 0,
        branch_feedbacks: empty_branches,
        branch_count: 0,
        type_feedbacks: empty_types,
        type_count: 0,
        hotness_score: 0
    };
}

// -------------------------------------------------------------------
// Feedback Recording
// -------------------------------------------------------------------

pub fn record_branch_outcome(mut telem: MethodTelemetry, bc_off: Int, is_taken: Int) -> MethodTelemetry {
    let limit: Int = (telem).branch_count;
    let mut found: Int = 0;
    let mut new_branches: List[BranchFeedback] = list_new();
    
    let mut i: Int = 0;
    while i < limit {
        let mut bf: BranchFeedback = list_get((telem).branch_feedbacks, i);
        if (bf).branch_bc_offset == bc_off {
            if is_taken == 1 {
                bf.taken_count = (bf).taken_count + 1;
            } else {
                bf.not_taken_count = (bf).not_taken_count + 1;
            }
            found = 1;
        }
        new_branches = list_push(new_branches, bf);
        i = i + 1;
    }
    
    if found == 0 {
        let mut bf_new: BranchFeedback = branch_feedback_new(bc_off);
        if is_taken == 1 {
            bf_new.taken_count = 1;
        } else {
            bf_new.not_taken_count = 1;
        }
        new_branches = list_push(new_branches, bf_new);
        telem.branch_count = (telem).branch_count + 1;
    }
    
    telem.branch_feedbacks = new_branches;
    telem.hotness_score = (telem).hotness_score + 1;
    return telem;
}
