pub fn compilers_vm_version() -> String {
    return "openOODA-Compilers-VM-v2.0";
}

pub fn compilers_vm_create_cfg_diamond() -> CfgGraph {
    return generate_diamond_cfg();
}

pub fn compilers_vm_create_dom_tree(graph: CfgGraph) -> DomTree {
    return dom_tree_build_simple(graph);
}

pub fn compilers_vm_create_df_table(graph: CfgGraph, tree: DomTree) -> DominanceFrontierTable {
    return compute_dominance_frontiers(graph, tree);
}

pub fn compilers_vm_create_vm_state(locals: Int) -> VmState {
    return vm_state_new(locals);
}

pub fn compilers_vm_create_test_program() -> BytecodeProgram {
    return generate_arithmetic_program();
}

pub fn compilers_vm_create_wasm_builder() -> WasmModuleBuilder {
    return wasm_module_builder_new();
}

pub fn compilers_vm_create_elf64_header(machine: Int, entry: Int) -> Elf64Header {
    return elf64_header_new(elf_et_exec(), machine, entry);
}

pub fn compilers_vm_create_macho64_header(cpu: Int) -> MachHeader64 {
    return mach_header_64_new(cpu, 2);
}

pub fn compilers_vm_create_pe_coff_file(entry: Int, image_base: Int) -> PeCoffFile {
    let f_hdr: CoffFileHeader = coff_file_header_new(pe_machine_amd64(), 0);
    let opt_hdr: OptionalHeader64 = optional_header_64_new(entry, image_base);
    return pe_coff_file_new(f_hdr, opt_hdr);
}

pub fn compilers_vm_create_gc_state(nursery_sz: Int, tenured_sz: Int) -> GenerationalGcState {
    return generational_gc_new(nursery_sz, tenured_sz);
}

pub fn compilers_vm_create_interference_graph(k_colors: Int) -> InterferenceGraph {
    return interference_graph_new(k_colors);
}
