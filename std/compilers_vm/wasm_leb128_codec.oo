// # WebAssembly LEB128 Binary Codec
//
// Logline: Unsigned LEB128 (u32/u64) and signed LEB128 (i32/i64) variable-length binary encoders and decoders.
//
// Setup: Encodes integer values into 7-bit chunk variable length sequences with MSB continuation flags.
//
// Beats:
//   1. Represent Leb128Decoded result structures.
//   2. Encode unsigned integers (u32/u64) to byte streams.
//   3. Encode and decode signed two's-complement integers (i32/i64).

pub type Leb128Decoded = struct {
    value: Int,
    bytes_consumed: Int,
};

pub type WasmByteBuffer = struct {
    bytes: List[Int],
    size: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn leb128_decoded_new(val: Int, consumed: Int) -> Leb128Decoded {
    return Leb128Decoded {
        value: val,
        bytes_consumed: consumed,
    };
}

pub fn wasm_byte_buffer_new() -> WasmByteBuffer {
    let empty_bytes: List[Int] = list_new();
    return WasmByteBuffer {
        bytes: empty_bytes,
        size: 0,
    };
}

pub fn wasm_byte_buffer_push(mut buf: WasmByteBuffer, byte_val: Int) -> WasmByteBuffer {
    let mut b: List[Int] = (buf).bytes;
    b = list_push(b, byte_val & 255);
    buf.bytes = b;
    buf.size = (buf).size + 1;
    return buf;
}

// -------------------------------------------------------------------
// LEB128 Encoders
// -------------------------------------------------------------------

pub fn encode_u32_leb128(val: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let mut v: Int = val;
    let mut running: Int = 1;
    while running == 1 {
        let byte_val: Int = v & 127;
        v = v / 128;
        if v != 0 {
            res = list_push(res, byte_val | 128);
        } else {
            res = list_push(res, byte_val);
            running = 0;
        }
    }
    return res;
}

pub fn encode_i32_leb128(val: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let mut v: Int = val;
    let mut more: Int = 1;
    while more == 1 {
        let byte_val: Int = v & 127;
        v = v / 128;
        let sign_bit: Int = byte_val & 64;
        let c1: Int = 0;
        let c2: Int = 0;
        if v == 0 && sign_bit == 0 {
            res = list_push(res, byte_val);
            more = 0;
        } else if v == -1 && sign_bit != 0 {
            res = list_push(res, byte_val);
            more = 0;
        } else {
            res = list_push(res, byte_val | 128);
        }
    }
    return res;
}

pub fn decode_u32_leb128(bytes: List[Int], offset: Int) -> Leb128Decoded {
    let mut result: Int = 0;
    let mut shift: Int = 0;
    let mut count: Int = 0;
    let total_bytes: Int = list_len(bytes);
    
    let mut running: Int = 1;
    while running == 1 && (offset + count) < total_bytes {
        let byte_val: Int = list_get(bytes, offset + count);
        count = count + 1;
        
        let chunk: Int = byte_val & 127;
        let mut shifted_chunk: Int = chunk;
        let mut s: Int = 0;
        while s < shift {
            shifted_chunk = shifted_chunk * 2;
            s = s + 1;
        }
        result = result + shifted_chunk;
        
        if (byte_val & 128) == 0 {
            running = 0;
        } else {
            shift = shift + 7;
        }
    }
    return leb128_decoded_new(result, count);
}
