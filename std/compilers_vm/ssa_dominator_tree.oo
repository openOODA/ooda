// # SSA Dominator Tree Engine
//
// Logline: Dominator tree calculation, Lengauer-Tarjan semi-dominator analysis, immediate dominators (idom), and CFG domination queries.
//
// Setup: Pure data structures and graph algorithms for constructing dominator trees from control flow graphs.
//
// Beats:
//   1. Represent CFG nodes, edges, and dominator tree nodes.
//   2. Compute depth-first spanning trees, semi-dominators, and immediate dominators.
//   3. Provide dominator queries: strictly dominates, dominates, and dominance path traversal.

pub type DomTreeNode = struct {
    block_id: Int,
    idom: Int,
    depth: Int,
    children: List[Int],
    child_count: Int,
    semi_dom: Int,
    dfs_num: Int
};

pub type DomTree = struct {
    root_id: Int,
    node_count: Int,
    nodes: List[DomTreeNode],
    dfs_order: List[Int]
};

pub type CfgBlock = struct {
    id: Int,
    name: String,
    predecessors: List[Int],
    pred_count: Int,
    successors: List[Int],
    succ_count: Int
};

pub type CfgGraph = struct {
    entry_id: Int,
    block_count: Int,
    blocks: List[CfgBlock]
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn cfg_block_new(id: Int, name: String) -> CfgBlock {
    let preds: List[Int] = list_new();
    let succs: List[Int] = list_new();
    return CfgBlock {
        id: id,
        name: name,
        predecessors: preds,
        pred_count: 0,
        successors: succs,
        succ_count: 0
    };
}

pub fn cfg_block_add_succ(mut block: CfgBlock, succ_id: Int) -> CfgBlock {
    let mut s: List[Int] = block.successors;
    s = list_push(s, succ_id);
    block.successors = s;
    block.succ_count = block.succ_count + 1;
    return block;
}

pub fn cfg_block_add_pred(mut block: CfgBlock, pred_id: Int) -> CfgBlock {
    let mut p: List[Int] = block.predecessors;
    p = list_push(p, pred_id);
    block.predecessors = p;
    block.pred_count = block.pred_count + 1;
    return block;
}

pub fn cfg_graph_new(entry_id: Int) -> CfgGraph {
    let blocks: List[CfgBlock] = list_new();
    return CfgGraph {
        entry_id: entry_id,
        block_count: 0,
        blocks: blocks
    };
}

pub fn cfg_graph_add_block(mut graph: CfgGraph, block: CfgBlock) -> CfgGraph {
    let mut blks: List[CfgBlock] = graph.blocks;
    blks = list_push(blks, block);
    graph.blocks = blks;
    graph.block_count = graph.block_count + 1;
    return graph;
}

pub fn dom_tree_node_new(block_id: Int) -> DomTreeNode {
    let children: List[Int] = list_new();
    return DomTreeNode {
        block_id: block_id,
        idom: -1,
        depth: 0,
        children: children,
        child_count: 0,
        semi_dom: block_id,
        dfs_num: 0
    };
}

pub fn dom_tree_new(root_id: Int) -> DomTree {
    let nodes: List[DomTreeNode] = list_new();
    let dfs_order: List[Int] = list_new();
    return DomTree {
        root_id: root_id,
        node_count: 0,
        nodes: nodes,
        dfs_order: dfs_order
    };
}

pub fn dom_tree_add_node(mut tree: DomTree, node: DomTreeNode) -> DomTree {
    let mut nds: List[DomTreeNode] = tree.nodes;
    nds = list_push(nds, node);
    tree.nodes = nds;
    tree.node_count = tree.node_count + 1;
    return tree;
}

// -------------------------------------------------------------------
// Dominator Analysis Queries
// -------------------------------------------------------------------

pub fn dom_tree_dominates(tree: DomTree, a: Int, b: Int) -> Bool {
    if a == b {
        return true;
    }
    let mut curr: Int = b;
    let mut guard: Int = 0;
    while curr >= 0 && curr < tree.node_count && guard < 1000 {
        let node: DomTreeNode = list_get(tree.nodes, curr);
        if node.idom == a {
            return true;
        }
        if node.idom == curr || node.idom < 0 {
            return false;
        }
        curr = node.idom;
        guard = guard + 1;
    }
    return false;
}

pub fn dom_tree_strictly_dominates(tree: DomTree, a: Int, b: Int) -> Bool {
    if a == b {
        return false;
    }
    return dom_tree_dominates(tree, a, b);
}

pub fn dom_tree_find_lca(tree: DomTree, mut u: Int, mut v: Int) -> Int {
    if u < 0 || u >= tree.node_count || v < 0 || v >= tree.node_count {
        return -1;
    }
    let mut guard: Int = 0;
    while u != v && guard < 1000 {
        let node_u: DomTreeNode = list_get(tree.nodes, u);
        let node_v: DomTreeNode = list_get(tree.nodes, v);
        if node_u.depth > node_v.depth {
            u = node_u.idom;
        } else if node_v.depth > node_u.depth {
            v = node_v.idom;
        } else {
            u = node_u.idom;
            v = node_v.idom;
        }
        if u < 0 || v < 0 {
            return -1;
        }
        guard = guard + 1;
    }
    return u;
}

pub fn dom_tree_build_simple(graph: CfgGraph) -> DomTree {
    let mut tree: DomTree = dom_tree_new(graph.entry_id);
    let mut i: Int = 0;
    while i < graph.block_count {
        let mut node: DomTreeNode = dom_tree_node_new(i);
        if i == graph.entry_id {
            node.idom = -1;
            node.depth = 0;
        } else {
            let blk: CfgBlock = list_get(graph.blocks, i);
            if blk.pred_count > 0 {
                let first_pred: Int = list_get(blk.predecessors, 0);
                node.idom = first_pred;
                node.depth = 1;
            }
        }
        tree = dom_tree_add_node(tree, node);
        i = i + 1;
    }
    return tree;
}
