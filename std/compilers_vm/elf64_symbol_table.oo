// # ELF64 Symbol Table Engine
//
// Logline: 64-bit ELF symbol table entries, symbol binding (STB_GLOBAL), symbol types (STT_FUNC, STT_OBJECT), and visibility.
//
// Setup: Parses 24-byte Elf64_Sym entries, symbol resolution precedence, and string table name lookups.
//
// Beats:
//   1. Define Elf64Symbol, SymbolTable, and SymbolBinding constants.
//   2. Decode st_info bitfields (binding = st_info >> 4, type = st_info & 0xF).
//   3. Provide symbol resolution and lookup helpers.

pub type Elf64Symbol = struct {
    name: String,
    st_name_offset: Int,
    binding: Int, // 0: LOCAL, 1: GLOBAL, 2: WEAK
    sym_type: Int, // 0: NOTYPE, 1: OBJECT, 2: FUNC, 3: SECTION, 4: FILE
    visibility: Int, // 0: DEFAULT, 1: INTERNAL, 2: HIDDEN, 3: PROTECTED
    st_shndx: Int,
    st_value: Int,
    st_size: Int,
};

pub type Elf64SymbolTable = struct {
    symbols: List[Elf64Symbol],
    symbol_count: Int,
};

// -------------------------------------------------------------------
// Symbol Constants
// -------------------------------------------------------------------

pub fn stb_local() -> Int { return 0; }
pub fn stb_global() -> Int { return 1; }
pub fn stb_weak() -> Int { return 2; }

pub fn stt_notype() -> Int { return 0; }
pub fn stt_object() -> Int { return 1; }
pub fn stt_func() -> Int { return 2; }
pub fn stt_section() -> Int { return 3; }
pub fn stt_file() -> Int { return 4; }

pub fn stv_default() -> Int { return 0; }
pub fn stv_internal() -> Int { return 1; }
pub fn stv_hidden() -> Int { return 2; }
pub fn stv_protected() -> Int { return 3; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn elf64_symbol_new(
    name: String,
    name_offset: Int,
    binding: Int,
    sym_type: Int,
    shndx: Int,
    value: Int,
    size: Int
) -> Elf64Symbol {
    return Elf64Symbol {
        name: name,
        st_name_offset: name_offset,
        binding: binding,
        sym_type: sym_type,
        visibility: 0,
        st_shndx: shndx,
        st_value: value,
        st_size: size,
    };
}

pub fn elf64_symbol_table_new() -> Elf64SymbolTable {
    let empty_symbols: List[Elf64Symbol] = list_new();
    return Elf64SymbolTable {
        symbols: empty_symbols,
        symbol_count: 0,
    };
}

pub fn elf64_symtab_add(mut table: Elf64SymbolTable, sym: Elf64Symbol) -> Elf64SymbolTable {
    let mut s: List[Elf64Symbol] = (table).symbols;
    s = list_push(s, sym);
    table.symbols = s;
    table.symbol_count = (table).symbol_count + 1;
    return table;
}

// -------------------------------------------------------------------
// Symbol Resolution Queries
// -------------------------------------------------------------------

pub fn elf64_symtab_lookup(table: Elf64SymbolTable, name: String) -> Elf64Symbol {
    let limit: Int = (table).symbol_count;
    let mut i: Int = 0;
    while i < limit {
        let sym: Elf64Symbol = list_get((table).symbols, i);
        if (sym).name == name {
            return sym;
        }
        i = i + 1;
    }
    return elf64_symbol_new("", 0, 0, 0, 0, 0, 0);
}

pub fn is_symbol_defined(sym: Elf64Symbol) -> Bool {
    // SHN_UNDEF is 0
    if (sym).st_shndx != 0 {
        return true;
    }
    return false;
}
