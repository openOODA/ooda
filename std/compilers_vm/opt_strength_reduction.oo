// # Compiler Induction Variable Strength Reduction Pass
//
// Logline: Loop induction variable strength reduction replacing costly multiplications with iterative additions.
//
// Setup: Detects derived induction variables of the form `derived = base * stride + offset` and initializes preheader accumulators.
//
// Beats:
//   1. Represent PrimaryInductionVar and DerivedInductionVar candidate records.
//   2. Identify candidate multiplication instructions inside loops depending on primary induction variables.
//   3. Generate replacement addition instructions in loop latch and initial value in loop preheader.

pub type PrimaryIndVar = struct {
    var_name: String,
    init_val: Int,
    step_val: Int,
    loop_id: Int,
};

pub type DerivedIndVar = struct {
    derived_name: String,
    primary_name: String,
    stride_val: Int,
    offset_val: Int,
    new_init_val: Int,
    new_step_val: Int,
    replacement_var: String,
};

pub type StrengthReductionPass = struct {
    primary_vars: List[PrimaryIndVar],
    primary_count: Int,
    derived_vars: List[DerivedIndVar],
    derived_count: Int,
    total_reduced: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn primary_ind_var_new(name: String, init_v: Int, step_v: Int, loop_id: Int) -> PrimaryIndVar {
    return PrimaryIndVar {
        var_name: name,
        init_val: init_v,
        step_val: step_v,
        loop_id: loop_id,
    };
}

pub fn derived_ind_var_new(
    derived: String,
    primary: String,
    stride: Int,
    offset: Int,
    p_init: Int,
    p_step: Int
) -> DerivedIndVar {
    let new_init: Int = (p_init * stride) + offset;
    let new_step: Int = p_step * stride;
    return DerivedIndVar {
        derived_name: derived,
        primary_name: primary,
        stride_val: stride,
        offset_val: offset,
        new_init_val: new_init,
        new_step_val: new_step,
        replacement_var: derived,
    };
}

pub fn strength_reduction_pass_new() -> StrengthReductionPass {
    let p_empty: List[PrimaryIndVar] = list_new();
    let d_empty: List[DerivedIndVar] = list_new();
    return StrengthReductionPass {
        primary_vars: p_empty,
        primary_count: 0,
        derived_vars: d_empty,
        derived_count: 0,
        total_reduced: 0,
    };
}

pub fn sr_add_primary(mut pass: StrengthReductionPass, p: PrimaryIndVar) -> StrengthReductionPass {
    let mut p_list: List[PrimaryIndVar] = (pass).primary_vars;
    p_list = list_push(p_list, p);
    pass.primary_vars = p_list;
    pass.primary_count = (pass).primary_count + 1;
    return pass;
}

pub fn sr_add_derived(mut pass: StrengthReductionPass, d: DerivedIndVar) -> StrengthReductionPass {
    let mut d_list: List[DerivedIndVar] = (pass).derived_vars;
    d_list = list_push(d_list, d);
    pass.derived_vars = d_list;
    pass.derived_count = (pass).derived_count + 1;
    pass.total_reduced = (pass).total_reduced + 1;
    return pass;
}

// -------------------------------------------------------------------
// Strength Reduction Analysis
// -------------------------------------------------------------------

pub fn sr_find_primary(pass: StrengthReductionPass, var_name: String) -> PrimaryIndVar {
    let limit: Int = (pass).primary_count;
    let mut i: Int = 0;
    while i < limit {
        let p: PrimaryIndVar = list_get((pass).primary_vars, i);
        if (p).var_name == var_name {
            return p;
        }
        i = i + 1;
    }
    return primary_ind_var_new("", 0, 0, -1);
}

pub fn sr_try_reduce_multiply(
    mut pass: StrengthReductionPass,
    dest_var: String,
    base_var: String,
    constant_multiplier: Int
) -> StrengthReductionPass {
    let p: PrimaryIndVar = sr_find_primary(pass, base_var);
    if (p).loop_id >= 0 {
        let d: DerivedIndVar = derived_ind_var_new(
            dest_var,
            base_var,
            constant_multiplier,
            0,
            (p).init_val,
            (p).step_val
        );
        pass = sr_add_derived(pass, d);
    }
    return pass;
}
