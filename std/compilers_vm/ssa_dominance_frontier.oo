// # SSA Dominance Frontier Engine
//
// Logline: Dominance frontier calculation and iterated dominance frontier (IDF) computation for phi node placement.
//
// Setup: Computes dominance frontiers DF(X) and iterated frontiers IDF(S) across CFG blocks.
//
// Beats:
//   1. Define dominance frontier structures and block frontier mappings.
//   2. Compute local and up dominance frontiers for each basic block.
//   3. Compute iterated dominance frontiers using a worklist algorithm.

import "./ssa_dominator_tree.oo";

pub type BlockFrontier = struct {
    block_id: Int,
    frontier_ids: List[Int],
    frontier_count: Int
};

pub type DominanceFrontierTable = struct {
    block_count: Int,
    frontiers: List[BlockFrontier]
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn block_frontier_new(block_id: Int) -> BlockFrontier {
    let empty_ids: List[Int] = list_new();
    return BlockFrontier {
        block_id: block_id,
        frontier_ids: empty_ids,
        frontier_count: 0
    };
}

pub fn block_frontier_add(mut bf: BlockFrontier, target_id: Int) -> BlockFrontier {
    let mut exists: Int = 0;
    let mut i: Int = 0;
    let limit: Int = (bf).frontier_count;
    while i < limit {
        if list_get((bf).frontier_ids, i) == target_id {
            exists = 1;
        }
        i = i + 1;
    }
    if exists == 0 {
        let mut ids: List[Int] = (bf).frontier_ids;
        ids = list_push(ids, target_id);
        bf.frontier_ids = ids;
        bf.frontier_count = (bf).frontier_count + 1;
    }
    return bf;
}

pub fn df_table_new() -> DominanceFrontierTable {
    let empty_list: List[BlockFrontier] = list_new();
    return DominanceFrontierTable {
        block_count: 0,
        frontiers: empty_list
    };
}

pub fn df_table_add_entry(mut table: DominanceFrontierTable, entry: BlockFrontier) -> DominanceFrontierTable {
    let mut list_entries: List[BlockFrontier] = (table).frontiers;
    list_entries = list_push(list_entries, entry);
    table.frontiers = list_entries;
    table.block_count = (table).block_count + 1;
    return table;
}

// -------------------------------------------------------------------
// Dominance Frontier Calculation
// -------------------------------------------------------------------

pub fn compute_dominance_frontiers(graph: CfgGraph, tree: DomTree) -> DominanceFrontierTable {
    let mut table: DominanceFrontierTable = df_table_new();
    let num_blocks: Int = (graph).block_count;
    let mut b: Int = 0;
    while b < num_blocks {
        let mut bf: BlockFrontier = block_frontier_new(b);
        let block: CfgBlock = list_get((graph).blocks, b);
        let num_preds: Int = (block).pred_count;
        
        if num_preds >= 2 {
            let mut p_idx: Int = 0;
            while p_idx < num_preds {
                let mut runner: Int = list_get((block).predecessors, p_idx);
                let dom_node: DomTreeNode = list_get((tree).nodes, b);
                let b_idom: Int = (dom_node).idom;
                
                let mut guard: Int = 0;
                while runner != b_idom && runner >= 0 && guard < 1000 {
                    bf = block_frontier_add(bf, runner);
                    let runner_node: DomTreeNode = list_get((tree).nodes, runner);
                    runner = (runner_node).idom;
                    guard = guard + 1;
                }
                p_idx = p_idx + 1;
            }
        }
        table = df_table_add_entry(table, bf);
        b = b + 1;
    }
    return table;
}

pub fn compute_iterated_dominance_frontier(df_table: DominanceFrontierTable, def_blocks: List[Int]) -> List[Int] {
    let mut idf: List[Int] = list_new();
    let mut idf_len: Int = 0;
    let n_defs: Int = list_len(def_blocks);
    let total_table_blocks: Int = (df_table).block_count;
    
    let mut i: Int = 0;
    while i < n_defs {
        let blk_id: Int = list_get(def_blocks, i);
        if blk_id >= 0 && blk_id < total_table_blocks {
            let bf: BlockFrontier = list_get((df_table).frontiers, blk_id);
            let n_targets: Int = (bf).frontier_count;
            let mut j: Int = 0;
            while j < n_targets {
                let target: Int = list_get((bf).frontier_ids, j);
                let mut present: Int = 0;
                let mut k: Int = 0;
                while k < idf_len {
                    if list_get(idf, k) == target {
                        present = 1;
                    }
                    k = k + 1;
                }
                if present == 0 {
                    idf = list_push(idf, target);
                    idf_len = idf_len + 1;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return idf;
}
