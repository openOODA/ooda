// # PE/COFF Import Directory Table Engine
//
// Logline: Portable Executable Import Directory Table (IDT), Import Lookup Table (ILT), and Import Address Table (IAT) parsing.
//
// Setup: Maps imported DLL names and function symbols (import by name / import by ordinal) for dynamic linking resolution.
//
// Beats:
//   1. Define ImportDirectoryEntry, ImportedSymbol, and ImportDescriptor structures.
//   2. Parse Import Lookup Table (ILT) entries and ordinal flags.
//   3. Compute Import Address Table (IAT) runtime relocation bindings.

pub type ImportedSymbol = struct {
    name: String,
    hint: Int,
    ordinal: Int,
    is_by_ordinal: Int,
    iat_rva: Int,
};

pub type ImportDescriptor = struct {
    dll_name: String,
    import_lookup_table_rva: Int,
    time_date_stamp: Int,
    forwarder_chain: Int,
    name_rva: Int,
    import_address_table_rva: Int,
    imported_symbols: List[ImportedSymbol],
    symbol_count: Int,
};

pub type PeImportTable = struct {
    descriptors: List[ImportDescriptor],
    descriptor_count: Int,
    total_imported_symbols: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn imported_symbol_name(name: String, hint: Int, iat_rva: Int) -> ImportedSymbol {
    return ImportedSymbol {
        name: name,
        hint: hint,
        ordinal: 0,
        is_by_ordinal: 0,
        iat_rva: iat_rva,
    };
}

pub fn imported_symbol_ordinal(ordinal: Int, iat_rva: Int) -> ImportedSymbol {
    return ImportedSymbol {
        name: "",
        hint: 0,
        ordinal: ordinal,
        is_by_ordinal: 1,
        iat_rva: iat_rva,
    };
}

pub fn import_descriptor_new(
    dll: String,
    ilt_rva: Int,
    name_rva: Int,
    iat_rva: Int
) -> ImportDescriptor {
    let empty_symbols: List[ImportedSymbol] = list_new();
    return ImportDescriptor {
        dll_name: dll,
        import_lookup_table_rva: ilt_rva,
        time_date_stamp: 0,
        forwarder_chain: 0,
        name_rva: name_rva,
        import_address_table_rva: iat_rva,
        imported_symbols: empty_symbols,
        symbol_count: 0,
    };
}

pub fn import_descriptor_add_symbol(mut desc: ImportDescriptor, sym: ImportedSymbol) -> ImportDescriptor {
    let mut s: List[ImportedSymbol] = (desc).imported_symbols;
    s = list_push(s, sym);
    desc.imported_symbols = s;
    desc.symbol_count = (desc).symbol_count + 1;
    return desc;
}

pub fn pe_import_table_new() -> PeImportTable {
    let empty_descs: List[ImportDescriptor] = list_new();
    return PeImportTable {
        descriptors: empty_descs,
        descriptor_count: 0,
        total_imported_symbols: 0,
    };
}

pub fn pe_import_table_add_desc(mut table: PeImportTable, desc: ImportDescriptor) -> PeImportTable {
    let mut d: List[ImportDescriptor] = (table).descriptors;
    d = list_push(d, desc);
    table.descriptors = d;
    table.descriptor_count = (table).descriptor_count + 1;
    table.total_imported_symbols = (table).total_imported_symbols + (desc).symbol_count;
    return table;
}
