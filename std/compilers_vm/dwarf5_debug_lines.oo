// # DWARF5 Debug Line Number Program Engine
//
// Logline: DWARF5 .debug_line program state machine, directory/file tables, standard/special opcodes, and matrix rows.
//
// Setup: Generates line table state matrix mapping machine code virtual addresses to source files, lines, and columns.
//
// Beats:
//   1. Define DwarfLineStateMachine, LineMatrixRow, and DwarfLineHeader structures.
//   2. Step line machine: advance PC, advance line, emit matrix row, copy row.
//   3. Handle special opcodes using opcode_base, line_base, and line_range parameters.

pub type LineMatrixRow = struct {
    address: Int,
    op_index: Int,
    file_index: Int,
    line_number: Int,
    column_number: Int,
    is_statement: Int,
    is_basic_block_start: Int,
    is_prologue_end: Int,
    is_epilogue_begin: Int
};

pub type DwarfLineHeader = struct {
    version: Int, // 5: DWARF5
    min_inst_length: Int,
    default_is_stmt: Int,
    line_base: Int,
    line_range: Int,
    opcode_base: Int,
    directory_names: List[String],
    directory_count: Int,
    file_names: List[String],
    file_count: Int
};

pub type DwarfLineStateMachine = struct {
    header: DwarfLineHeader,
    current_row: LineMatrixRow,
    emitted_rows: List[LineMatrixRow],
    row_count: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn line_matrix_row_new(addr: Int, file_idx: Int, line: Int, col: Int) -> LineMatrixRow {
    return LineMatrixRow {
        address: addr,
        op_index: 0,
        file_index: file_idx,
        line_number: line,
        column_number: col,
        is_statement: 1,
        is_basic_block_start: 0,
        is_prologue_end: 0,
        is_epilogue_begin: 0
    };
}

pub fn dwarf_line_header_default() -> DwarfLineHeader {
    let empty_dirs: List[String] = list_new();
    let empty_files: List[String] = list_new();
    return DwarfLineHeader {
        version: 5,
        min_inst_length: 1,
        default_is_stmt: 1,
        line_base: -5,
        line_range: 14,
        opcode_base: 13,
        directory_names: empty_dirs,
        directory_count: 0,
        file_names: empty_files,
        file_count: 0
    };
}

pub fn dwarf_line_state_machine_new(header: DwarfLineHeader) -> DwarfLineStateMachine {
    let init_row: LineMatrixRow = line_matrix_row_new(0, 1, 1, 0);
    let empty_rows: List[LineMatrixRow] = list_new();
    return DwarfLineStateMachine {
        header: header,
        current_row: init_row,
        emitted_rows: empty_rows,
        row_count: 0
    };
}

// -------------------------------------------------------------------
// State Machine Operations
// -------------------------------------------------------------------

pub fn dwarf_step_advance_pc(mut sm: DwarfLineStateMachine, delta_addr: Int) -> DwarfLineStateMachine {
    let mut row: LineMatrixRow = (sm).current_row;
    row.address = (row).address + delta_addr;
    sm.current_row = row;
    return sm;
}

pub fn dwarf_step_advance_line(mut sm: DwarfLineStateMachine, delta_line: Int) -> DwarfLineStateMachine {
    let mut row: LineMatrixRow = (sm).current_row;
    row.line_number = (row).line_number + delta_line;
    sm.current_row = row;
    return sm;
}

pub fn dwarf_step_emit_row(mut sm: DwarfLineStateMachine) -> DwarfLineStateMachine {
    let mut rows: List[LineMatrixRow] = (sm).emitted_rows;
    rows = list_push(rows, (sm).current_row);
    sm.emitted_rows = rows;
    sm.row_count = (sm).row_count + 1;
    return sm;
}

pub fn dwarf_step_special_opcode(
    mut sm: DwarfLineStateMachine,
    opcode: Int
) -> DwarfLineStateMachine {
    let adj_op: Int = opcode - (sm.header).opcode_base;
    let addr_adv: Int = (adj_op / (sm.header).line_range) * (sm.header).min_inst_length;
    let line_adv: Int = (sm.header).line_base + (adj_op - ((adj_op / (sm.header).line_range) * (sm.header).line_range));
    
    sm = dwarf_step_advance_pc(sm, addr_adv);
    sm = dwarf_step_advance_line(sm, line_adv);
    sm = dwarf_step_emit_row(sm);
    return sm;
}
