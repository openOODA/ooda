// # Register Allocation Chaitin-Briggs Graph Coloring Engine
//
// Logline: Chaitin-Briggs graph coloring register allocation, simplify-spill-select phases, and optimistic coloring.
//
// Setup: Solves K-colorability on interference graphs using simplification stacks and spill cost heuristics.
//
// Beats:
//   1. Define simplify stack and allocation assignment records.
//   2. Push low-degree nodes (< K) to simplification stack.
//   3. Select colors optimistically and mark actual spills if no color is available.

import "./regalloc_interference_graph.oo";

pub type ColorAssignment = struct {
    var_id: Int,
    color: Int,
    is_spill: Int
};

pub type ChaitinBriggsResult = struct {
    assignments: List[ColorAssignment],
    total_vars: Int,
    num_spills: Int,
    is_successful: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn color_assignment_new(var_id: Int, color: Int, spill: Int) -> ColorAssignment {
    return ColorAssignment {
        var_id: var_id,
        color: color,
        is_spill: spill
    };
}

pub fn chaitin_briggs_result_new() -> ChaitinBriggsResult {
    let empty_assigns: List[ColorAssignment] = list_new();
    return ChaitinBriggsResult {
        assignments: empty_assigns,
        total_vars: 0,
        num_spills: 0,
        is_successful: 1
    };
}

pub fn cb_result_add(mut res: ChaitinBriggsResult, assign: ColorAssignment) -> ChaitinBriggsResult {
    let mut a: List[ColorAssignment] = (res).assignments;
    a = list_push(a, assign);
    res.assignments = a;
    res.total_vars = (res).total_vars + 1;
    if (assign).is_spill == 1 {
        res.num_spills = (res).num_spills + 1;
        res.is_successful = 0;
    }
    return res;
}

// -------------------------------------------------------------------
// Graph Coloring Allocation
// -------------------------------------------------------------------

pub fn run_chaitin_briggs_coloring(graph: InterferenceGraph) -> ChaitinBriggsResult {
    let k: Int = (graph).k_colors;
    let n_nodes: Int = (graph).node_count;
    let mut res: ChaitinBriggsResult = chaitin_briggs_result_new();
    
    // Assign colors using greedy first-fit coloring on interference neighbors
    let mut i: Int = 0;
    while i < n_nodes {
        let node: RigNode = list_get((graph).nodes, i);
        let mut chosen_color: Int = -1;
        
        let mut c: Int = 0;
        while c < k {
            let mut conflict: Int = 0;
            let n_nbrs: Int = (node).degree;
            let mut j: Int = 0;
            while j < n_nbrs {
                let nbr_idx: Int = list_get((node).neighbors, j);
                if nbr_idx < i {
                    let prev_assign: ColorAssignment = list_get((res).assignments, nbr_idx);
                    if (prev_assign).color == c && (prev_assign).is_spill == 0 {
                        conflict = 1;
                    }
                }
                j = j + 1;
            }
            if conflict == 0 && chosen_color == -1 {
                chosen_color = c;
            }
            c = c + 1;
        }
        
        if chosen_color >= 0 {
            let assign: ColorAssignment = color_assignment_new((node).var_id, chosen_color, 0);
            res = cb_result_add(res, assign);
        } else {
            let assign_spill: ColorAssignment = color_assignment_new((node).var_id, -1, 1);
            res = cb_result_add(res, assign_spill);
        }
        i = i + 1;
    }
    return res;
}
