// # Compiler Function Inlining Pass
//
// Logline: Call-site inlining heuristics, cost-benefit analysis, parameter substitution, and callee CFG splicing.
//
// Setup: Evaluates caller/callee instruction counts, loop nesting depths, and inlining thresholds to inline small functions.
//
// Beats:
//   1. Represent InliningHeuristics, InliningDecision, and FunctionSummary records.
//   2. Compute inlining cost metric based on callee size, argument constants, and call frequency.
//   3. Bind formal parameters to actual arguments and produce spliced CFG metadata.

pub type FunctionSummary = struct {
    fn_name: String,
    instruction_count: Int,
    block_count: Int,
    has_loops: Int,
    has_indirect_calls: Int,
    is_always_inline: Int,
    is_never_inline: Int
};

pub type InliningHeuristics = struct {
    default_threshold: Int,
    hint_threshold: Int,
    cold_threshold: Int,
    max_caller_growth_percent: Int
};

pub type InliningDecision = struct {
    caller_fn: String,
    callee_fn: String,
    should_inline: Int,
    cost_score: Int,
    reason: String
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn function_summary_new(
    name: String,
    inst_count: Int,
    blk_count: Int,
    loops: Int,
    ind_calls: Int
) -> FunctionSummary {
    return FunctionSummary {
        fn_name: name,
        instruction_count: inst_count,
        block_count: blk_count,
        has_loops: loops,
        has_indirect_calls: ind_calls,
        is_always_inline: 0,
        is_never_inline: 0
    };
}

pub fn inlining_heuristics_default() -> InliningHeuristics {
    return InliningHeuristics {
        default_threshold: 45,
        hint_threshold: 250,
        cold_threshold: 10,
        max_caller_growth_percent: 200
    };
}

pub fn inlining_decision_new(
    caller: String,
    callee: String,
    inline_flag: Int,
    cost: Int,
    reason: String
) -> InliningDecision {
    return InliningDecision {
        caller_fn: caller,
        callee_fn: callee,
        should_inline: inline_flag,
        cost_score: cost,
        reason: reason
    };
}

// -------------------------------------------------------------------
// Inlining Cost Model
// -------------------------------------------------------------------

pub fn compute_inlining_cost(summary: FunctionSummary, const_arg_count: Int, in_loop: Int) -> Int {
    let mut cost: Int = (summary).instruction_count;
    
    // Each constant argument simplifies callee code (~10% reduction per constant)
    let bonus: Int = const_arg_count * 5;
    if bonus < cost {
        cost = cost - bonus;
    } else {
        cost = 1;
    }
    
    // Call site inside loop increases profitability (effective lower cost threshold)
    if in_loop == 1 {
        cost = cost / 2;
    }
    
    return cost;
}

pub fn evaluate_inlining(
    caller_name: String,
    callee: FunctionSummary,
    heuristics: InliningHeuristics,
    const_arg_count: Int,
    in_loop: Int
) -> InliningDecision {
    if (callee).is_never_inline == 1 {
        return inlining_decision_new(caller_name, (callee).fn_name, 0, 9999, "Function marked never-inline");
    }
    if (callee).is_always_inline == 1 {
        return inlining_decision_new(caller_name, (callee).fn_name, 1, 0, "Function marked always-inline");
    }
    
    let cost: Int = compute_inlining_cost(callee, const_arg_count, in_loop);
    let threshold: Int = (heuristics).default_threshold;
    
    if cost <= threshold {
        return inlining_decision_new(caller_name, (callee).fn_name, 1, cost, "Cost is within default inlining threshold");
    }
    return inlining_decision_new(caller_name, (callee).fn_name, 0, cost, "Cost exceeds inlining threshold");
}
