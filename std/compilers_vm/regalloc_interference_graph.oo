// # Register Allocation Interference Graph Engine
//
// Logline: Register Interference Graph (RIG) construction, live range intervals, adjacency lists, and node degree calculation.
//
// Setup: Builds undirected interference graphs where edges connect virtual registers that are concurrently live.
//
// Beats:
//   1. Define LiveRange, RigNode, and InterferenceGraph structures.
//   2. Compute live range overlap and add symmetric interference edges.
//   3. Compute node degrees, spill weights, and low/high degree classification.

pub type LiveRange = struct {
    var_id: Int,
    var_name: String,
    start_point: Int,
    end_point: Int,
    spill_weight: Int,
};

pub type RigNode = struct {
    var_id: Int,
    var_name: String,
    neighbors: List[Int],
    degree: Int,
    assigned_color: Int,
    is_spilled: Int,
    is_removed_from_graph: Int,
};

pub type InterferenceGraph = struct {
    nodes: List[RigNode],
    node_count: Int,
    edge_count: Int,
    k_colors: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn live_range_new(var_id: Int, name: String, start_pt: Int, end_pt: Int, weight: Int) -> LiveRange {
    return LiveRange {
        var_id: var_id,
        var_name: name,
        start_point: start_pt,
        end_point: end_pt,
        spill_weight: weight,
    };
}

pub fn rig_node_new(var_id: Int, name: String) -> RigNode {
    let empty_nbrs: List[Int] = list_new();
    return RigNode {
        var_id: var_id,
        var_name: name,
        neighbors: empty_nbrs,
        degree: 0,
        assigned_color: -1,
        is_spilled: 0,
        is_removed_from_graph: 0,
    };
}

pub fn interference_graph_new(k_colors: Int) -> InterferenceGraph {
    let empty_nodes: List[RigNode] = list_new();
    return InterferenceGraph {
        nodes: empty_nodes,
        node_count: 0,
        edge_count: 0,
        k_colors: k_colors,
    };
}

pub fn rig_add_node(mut graph: InterferenceGraph, node: RigNode) -> InterferenceGraph {
    let mut nds: List[RigNode] = (graph).nodes;
    nds = list_push(nds, node);
    graph.nodes = nds;
    graph.node_count = (graph).node_count + 1;
    return graph;
}

// -------------------------------------------------------------------
// Interference Graph Edges & Degree
// -------------------------------------------------------------------

pub fn ranges_interfere(a: LiveRange, b: LiveRange) -> Bool {
    if (a).var_id == (b).var_id {
        return false;
    }
    let s_a: Int = (a).start_point;
    let e_a: Int = (a).end_point;
    let s_b: Int = (b).start_point;
    let e_b: Int = (b).end_point;
    
    if e_a <= s_b || e_b <= s_a {
        return false;
    }
    return true;
}

pub fn rig_add_edge_directed(mut node: RigNode, neighbor_id: Int) -> RigNode {
    let mut exists: Int = 0;
    let mut i: Int = 0;
    let deg: Int = (node).degree;
    while i < deg {
        if list_get((node).neighbors, i) == neighbor_id {
            exists = 1;
        }
        i = i + 1;
    }
    if exists == 0 {
        let mut nbrs: List[Int] = (node).neighbors;
        nbrs = list_push(nbrs, neighbor_id);
        node.neighbors = nbrs;
        node.degree = (node).degree + 1;
    }
    return node;
}

pub fn build_interference_graph_from_ranges(ranges: List[LiveRange], k_colors: Int) -> InterferenceGraph {
    let n_ranges: Int = list_len(ranges);
    let mut graph: InterferenceGraph = interference_graph_new(k_colors);
    
    // Create initial nodes
    let mut i: Int = 0;
    while i < n_ranges {
        let r: LiveRange = list_get(ranges, i);
        let node: RigNode = rig_node_new((r).var_id, (r).var_name);
        graph = rig_add_node(graph, node);
        i = i + 1;
    }
    
    // Add edges for overlapping ranges
    let mut a: Int = 0;
    while a < n_ranges {
        let range_a: LiveRange = list_get(ranges, a);
        let mut b: Int = a + 1;
        while b < n_ranges {
            let range_b: LiveRange = list_get(ranges, b);
            let interferes: Bool = ranges_interfere(range_a, range_b);
            if interferes {
                // Add symmetric edge between a and b
                let mut node_a: RigNode = list_get((graph).nodes, a);
                let mut node_b: RigNode = list_get((graph).nodes, b);
                node_a = rig_add_edge_directed(node_a, b);
                node_b = rig_add_edge_directed(node_b, a);
                
                let mut updated_nodes: List[RigNode] = list_new();
                let mut k: Int = 0;
                while k < (graph).node_count {
                    if k == a {
                        updated_nodes = list_push(updated_nodes, node_a);
                    } else if k == b {
                        updated_nodes = list_push(updated_nodes, node_b);
                    } else {
                        updated_nodes = list_push(updated_nodes, list_get((graph).nodes, k));
                    }
                    k = k + 1;
                }
                graph.nodes = updated_nodes;
                graph.edge_count = (graph).edge_count + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return graph;
}
