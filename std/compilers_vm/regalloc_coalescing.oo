// # Register Allocation Iterated Coalescing Engine
//
// Logline: Iterated Register Coalescing (IRC), Briggs and George conservatism criteria, and register copy elimination.
//
// Setup: Eliminates register-to-register copies by safely merging non-interfering virtual register nodes.
//
// Beats:
//   1. Define CopyInstruction, CoalesceCandidate, and CoalesceContext structures.
//   2. Check Briggs criterion: merged node has fewer than K high-degree neighbors.
//   3. Check George criterion: every neighbor of one node already interferes or is low-degree in the other.

import "./regalloc_interference_graph.oo";

pub type CopyInstruction = struct {
    copy_id: Int,
    dest_var_id: Int,
    src_var_id: Int,
    is_coalesced: Int,
    is_constrained: Int
};

pub type CoalesceContext = struct {
    k_registers: Int,
    copies: List[CopyInstruction],
    copy_count: Int,
    coalesced_count: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn copy_instruction_new(copy_id: Int, dest: Int, src: Int) -> CopyInstruction {
    return CopyInstruction {
        copy_id: copy_id,
        dest_var_id: dest,
        src_var_id: src,
        is_coalesced: 0,
        is_constrained: 0
    };
}

pub fn coalesce_context_new(k_regs: Int) -> CoalesceContext {
    let empty_copies: List[CopyInstruction] = list_new();
    return CoalesceContext {
        k_registers: k_regs,
        copies: empty_copies,
        copy_count: 0,
        coalesced_count: 0
    };
}

pub fn coalesce_add_copy(mut ctx: CoalesceContext, copy: CopyInstruction) -> CoalesceContext {
    let mut c: List[CopyInstruction] = (ctx).copies;
    c = list_push(c, copy);
    ctx.copies = c;
    ctx.copy_count = (ctx).copy_count + 1;
    return ctx;
}

// -------------------------------------------------------------------
// Conservatism Criteria
// -------------------------------------------------------------------

pub fn briggs_criterion(high_degree_nbr_count: Int, k_regs: Int) -> Bool {
    // Briggs rule: Merged node will be colorable if combined high-degree neighbors < K
    if high_degree_nbr_count < k_regs {
        return true;
    }
    return false;
}

pub fn george_criterion(unshared_high_deg_count: Int) -> Bool {
    // George rule: All significant neighbors of u already interfere with v
    if unshared_high_deg_count == 0 {
        return true;
    }
    return false;
}

pub fn try_coalesce_copy(
    mut ctx: CoalesceContext,
    copy_idx: Int,
    high_deg_combined: Int
) -> CoalesceContext {
    if copy_idx >= 0 && copy_idx < (ctx).copy_count {
        let is_safe: Bool = briggs_criterion(high_deg_combined, (ctx).k_registers);
        if is_safe {
            let mut cp: CopyInstruction = list_get((ctx).copies, copy_idx);
            cp.is_coalesced = 1;
            
            let mut updated: List[CopyInstruction] = list_new();
            let mut i: Int = 0;
            while i < (ctx).copy_count {
                if i == copy_idx {
                    updated = list_push(updated, cp);
                } else {
                    updated = list_push(updated, list_get((ctx).copies, i));
                }
                i = i + 1;
            }
            ctx.copies = updated;
            ctx.coalesced_count = (ctx).coalesced_count + 1;
        }
    }
    return ctx;
}
