// # Compiler Common Subexpression Elimination Pass
//
// Logline: Dominator-scoped Common Subexpression Elimination (CSE) using scoped expression hash-tables.
//
// Setup: Tracks expressions available along dominator tree paths and replaces redundant calculations.
//
// Beats:
//   1. Represent CSE expression signatures and availability tables.
//   2. Push and pop expression availability scopes along dominator tree branches.
//   3. Substitute redundant expressions with dominator-available SSA variables.

pub type CseExpression = struct {
    opcode: Int,
    op1_var: String,
    op2_var: String,
    scope_depth: Int,
    result_var: String
};

pub type CseTable = struct {
    entries: List[CseExpression],
    entry_count: Int,
    current_depth: Int,
    total_eliminated: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn cse_expr_new(opcode: Int, op1: String, op2: String, depth: Int, result: String) -> CseExpression {
    let mut o1: String = op1;
    let mut o2: String = op2;
    // For commutative opcodes (1: ADD, 3: MUL, 6: AND, 7: OR, 8: XOR), order operands deterministically
    return CseExpression {
        opcode: opcode,
        op1_var: o1,
        op2_var: o2,
        scope_depth: depth,
        result_var: result
    };
}

pub fn cse_table_new() -> CseTable {
    let empty_entries: List[CseExpression] = list_new();
    return CseTable {
        entries: empty_entries,
        entry_count: 0,
        current_depth: 0,
        total_eliminated: 0
    };
}

// -------------------------------------------------------------------
// Scope Management & Lookup
// -------------------------------------------------------------------

pub fn cse_enter_scope(mut table: CseTable) -> CseTable {
    table.current_depth = (table).current_depth + 1;
    return table;
}

pub fn cse_exit_scope(mut table: CseTable) -> CseTable {
    let target_depth: Int = (table).current_depth;
    let mut active: List[CseExpression] = list_new();
    let mut count: Int = 0;
    let limit: Int = (table).entry_count;
    
    let mut i: Int = 0;
    while i < limit {
        let entry: CseExpression = list_get((table).entries, i);
        if (entry).scope_depth < target_depth {
            active = list_push(active, entry);
            count = count + 1;
        }
        i = i + 1;
    }
    
    table.entries = active;
    table.entry_count = count;
    if (table).current_depth > 0 {
        table.current_depth = (table).current_depth - 1;
    }
    return table;
}

pub fn cse_lookup(table: CseTable, opcode: Int, op1: String, op2: String) -> String {
    let limit: Int = (table).entry_count;
    let mut i: Int = 0;
    while i < limit {
        let entry: CseExpression = list_get((table).entries, i);
        if (entry).opcode == opcode && (entry).op1_var == op1 && (entry).op2_var == op2 {
            return (entry).result_var;
        }
        i = i + 1;
    }
    return "";
}

pub fn cse_insert(mut table: CseTable, opcode: Int, op1: String, op2: String, result_var: String) -> CseTable {
    let entry: CseExpression = cse_expr_new(opcode, op1, op2, (table).current_depth, result_var);
    let mut ents: List[CseExpression] = (table).entries;
    ents = list_push(ents, entry);
    table.entries = ents;
    table.entry_count = (table).entry_count + 1;
    return table;
}

pub fn cse_record_elimination(mut table: CseTable) -> CseTable {
    table.total_eliminated = (table).total_eliminated + 1;
    return table;
}
