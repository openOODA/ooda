// # Mach-O 64-bit Load Commands Parser
//
// Logline: Mach-O 64-bit binary format header, LC_SEGMENT_64, LC_SYMTAB, and section_64 descriptor parsing.
//
// Setup: Parses Mach-O 64-bit MH_MAGIC_64 (0xFEEDFACF), CPU types (CPU_TYPE_ARM64, CPU_TYPE_X86_64), and load command arrays.
//
// Beats:
//   1. Define MachHeader64, LoadCommand, SegmentCommand64, and Section64 structures.
//   2. Parse LC_SEGMENT_64 (__TEXT, __DATA, __LINKEDIT) segments and protection flags.
//   3. Extract section_64 descriptors (__text, __cstring, __data, __bss) and virtual memory offsets.

pub type MachHeader64 = struct {
    magic: Int,         // 0xFEEDFACF (4277009103)
    cputype: Int,       // 0x01000007: x86_64, 0x0100000C: ARM64
    cpusubtype: Int,
    filetype: Int,      // 1: OBJECT, 2: EXECUTE, 6: DYLIB
    ncmds: Int,
    sizeofcmds: Int,
    flags: Int
};

pub type Section64 = struct {
    sectname: String,
    segname: String,
    addr: Int,
    size: Int,
    offset: Int,
    align: Int,
    reloff: Int,
    nreloc: Int,
    flags: Int
};

pub type SegmentCommand64 = struct {
    segname: String,
    vmaddr: Int,
    vmsize: Int,
    fileoff: Int,
    filesize: Int,
    maxprot: Int,
    initprot: Int,
    nsects: Int,
    sections: List[Section64]
};

pub type Macho64File = struct {
    header: MachHeader64,
    segments: List[SegmentCommand64],
    segment_count: Int
};

// -------------------------------------------------------------------
// Constants
// -------------------------------------------------------------------

pub fn macho_magic_64() -> Int { return 4277009103; } // 0xFEEDFACF
pub fn macho_cpu_x86_64() -> Int { return 16777223; }  // 0x01000007
pub fn macho_cpu_arm64() -> Int { return 16777228; }   // 0x0100000C

pub fn lc_segment_64() -> Int { return 25; } // 0x19
pub fn lc_symtab() -> Int { return 2; }
pub fn lc_dysymtab() -> Int { return 11; }
pub fn lc_load_dylib() -> Int { return 12; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn mach_header_64_new(cpu: Int, filetype: Int) -> MachHeader64 {
    return MachHeader64 {
        magic: macho_magic_64(),
        cputype: cpu,
        cpusubtype: 0,
        filetype: filetype,
        ncmds: 0,
        sizeofcmds: 0,
        flags: 0
    };
}

pub fn section_64_new(sect: String, seg: String, addr: Int, size: Int, off: Int) -> Section64 {
    return Section64 {
        sectname: sect,
        segname: seg,
        addr: addr,
        size: size,
        offset: off,
        align: 3, // 2^3 = 8-byte alignment
        reloff: 0,
        nreloc: 0,
        flags: 0
    };
}

pub fn segment_command_64_new(name: String, vmaddr: Int, vmsize: Int) -> SegmentCommand64 {
    let empty_sects: List[Section64] = list_new();
    return SegmentCommand64 {
        segname: name,
        vmaddr: vmaddr,
        vmsize: vmsize,
        fileoff: 0,
        filesize: vmsize,
        maxprot: 7, // rwx
        initprot: 5, // r-x
        nsects: 0,
        sections: empty_sects
    };
}

pub fn segment_add_section(mut seg: SegmentCommand64, sect: Section64) -> SegmentCommand64 {
    let mut s: List[Section64] = (seg).sections;
    s = list_push(s, sect);
    seg.sections = s;
    seg.nsects = (seg).nsects + 1;
    return seg;
}

pub fn macho64_file_new(header: MachHeader64) -> Macho64File {
    let empty_segs: List[SegmentCommand64] = list_new();
    return Macho64File {
        header: header,
        segments: empty_segs,
        segment_count: 0
    };
}

pub fn macho64_add_segment(mut file: Macho64File, seg: SegmentCommand64) -> Macho64File {
    let mut s: List[SegmentCommand64] = (file).segments;
    s = list_push(s, seg);
    file.segments = s;
    file.segment_count = (file).segment_count + 1;
    return file;
}
