// # Virtual Machine Exception Unwinder Engine
//
// Logline: Exception table lookup, stack frame unwinding, exception payload propagation, and handler dispatch.
//
// Setup: Traverses VM call stack frames searching exception ranges [start_pc, end_pc) for matching catch blocks.
//
// Beats:
//   1. Define ExceptionHandlerEntry, ExceptionTable, and UnwindResult structures.
//   2. Match active PC against exception ranges and exception class hierarchy tags.
//   3. Unwind non-matching frames and transfer control to target handler PC.

pub type ExceptionHandlerEntry = struct {
    start_pc: Int,
    end_pc: Int,
    handler_pc: Int,
    catch_type_id: Int, // 0 for catch-all / finally
};

pub type ExceptionTable = struct {
    entries: List[ExceptionHandlerEntry],
    entry_count: Int,
};

pub type UnwindResult = struct {
    is_caught: Int,
    target_handler_pc: Int,
    unwound_frames_count: Int,
    exception_val: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn exception_handler_entry_new(
    start: Int,
    end_p: Int,
    handler: Int,
    catch_id: Int
) -> ExceptionHandlerEntry {
    return ExceptionHandlerEntry {
        start_pc: start,
        end_pc: end_p,
        handler_pc: handler,
        catch_type_id: catch_id,
    };
}

pub fn exception_table_new() -> ExceptionTable {
    let empty_entries: List[ExceptionHandlerEntry] = list_new();
    return ExceptionTable {
        entries: empty_entries,
        entry_count: 0,
    };
}

pub fn exception_table_add_entry(mut table: ExceptionTable, entry: ExceptionHandlerEntry) -> ExceptionTable {
    let mut e: List[ExceptionHandlerEntry] = (table).entries;
    e = list_push(e, entry);
    table.entries = e;
    table.entry_count = (table).entry_count + 1;
    return table;
}

pub fn unwind_result_caught(handler_pc: Int, frames: Int, val: Int) -> UnwindResult {
    return UnwindResult {
        is_caught: 1,
        target_handler_pc: handler_pc,
        unwound_frames_count: frames,
        exception_val: val,
    };
}

pub fn unwind_result_uncaught(val: Int) -> UnwindResult {
    return UnwindResult {
        is_caught: 0,
        target_handler_pc: -1,
        unwound_frames_count: 0,
        exception_val: val,
    };
}

// -------------------------------------------------------------------
// Exception Lookup Logic
// -------------------------------------------------------------------

pub fn find_exception_handler(table: ExceptionTable, current_pc: Int, thrown_type_id: Int) -> Int {
    let limit: Int = (table).entry_count;
    let mut i: Int = 0;
    while i < limit {
        let entry: ExceptionHandlerEntry = list_get((table).entries, i);
        if current_pc >= (entry).start_pc && current_pc < (entry).end_pc {
            if (entry).catch_type_id == 0 || (entry).catch_type_id == thrown_type_id {
                return (entry).handler_pc;
            }
        }
        i = i + 1;
    }
    return -1; // Not found in this table
}
