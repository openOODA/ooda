// # Compiler Loop Invariant Code Motion Pass
//
// Logline: Loop Invariant Code Motion (LICM), loop-invariance detection, safety hoisting verification, and preheader hoist insertion.
//
// Setup: Identifies expressions whose operands are invariant with respect to loop iterations and safely hoists them to loop pre-headers.
//
// Beats:
//   1. Define loop invariant candidate records and preheader hoist containers.
//   2. Check invariance: constant operands or defined strictly outside the loop.
//   3. Hoist invariant computations out of loop bodies into pre-headers.

import "./ssa_loop_nest_tree.oo";

pub type InvariantCandidate = struct {
    inst_id: Int,
    result_var: String,
    opcode: Int,
    source_block_id: Int,
    target_preheader_id: Int,
    is_safe_to_hoist: Int
};

pub type LicmReport = struct {
    loop_id: Int,
    candidates: List[InvariantCandidate],
    candidate_count: Int,
    hoisted_count: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn invariant_candidate_new(
    inst_id: Int,
    result_var: String,
    opcode: Int,
    source_block: Int,
    preheader: Int,
    is_safe: Int
) -> InvariantCandidate {
    return InvariantCandidate {
        inst_id: inst_id,
        result_var: result_var,
        opcode: opcode,
        source_block_id: source_block,
        target_preheader_id: preheader,
        is_safe_to_hoist: is_safe
    };
}

pub fn licm_report_new(loop_id: Int) -> LicmReport {
    let empty_cands: List[InvariantCandidate] = list_new();
    return LicmReport {
        loop_id: loop_id,
        candidates: empty_cands,
        candidate_count: 0,
        hoisted_count: 0
    };
}

pub fn licm_report_add_candidate(mut report: LicmReport, cand: InvariantCandidate) -> LicmReport {
    let mut c: List[InvariantCandidate] = (report).candidates;
    c = list_push(c, cand);
    report.candidates = c;
    report.candidate_count = (report).candidate_count + 1;
    if (cand).is_safe_to_hoist == 1 {
        report.hoisted_count = (report).hoisted_count + 1;
    }
    return report;
}

// -------------------------------------------------------------------
// Invariance & Hoisting Checks
// -------------------------------------------------------------------

pub fn is_operand_loop_invariant(op_def_block: Int, loop_inst: LoopInfo) -> Int {
    // If operand was defined in a block outside this loop, it is loop-invariant
    let is_inside: Bool = loop_contains_block(loop_inst, op_def_block);
    if is_inside {
        return 0; // Defined inside loop
    }
    return 1; // Defined outside loop
}

pub fn is_instruction_speculative_safe(opcode: Int) -> Int {
    // Pure arithmetic/bitwise ops without division-by-zero or memory exceptions are safe
    if opcode == 1 || opcode == 2 || opcode == 3 || opcode == 6 || opcode == 7 || opcode == 8 {
        return 1;
    }
    // Division (opcode 4), Modulo (5), or Loads (12) may fault/trap unless guaranteed to execute
    return 0;
}
