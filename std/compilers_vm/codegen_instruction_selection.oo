// # Code Generation Instruction Selection Engine
//
// Logline: Maximal Munch tree pattern matching and cost-based tiling for target instruction selection.
//
// Setup: Maps IR abstract syntax expression trees to target machine instructions (e.g. x86_64 LEA, ADD, MOV).
//
// Beats:
//   1. Define IrTreePattern, MachineTile, and SelectedInstruction structures.
//   2. Match compound patterns such as base + index * scale + displacement into single machine instructions.
//   3. Compute minimum cost tiling over IR expression trees.

pub type IrTreePattern = struct {
    pattern_id: Int,
    root_opcode: Int,
    lhs_opcode: Int,
    rhs_opcode: Int,
    is_immediate_rhs: Int,
    target_machine_opcode: Int,
    cost: Int,
    mnemonic: String
};

pub type SelectedMachineInst = struct {
    inst_id: Int,
    machine_opcode: Int,
    mnemonic: String,
    dest_reg: String,
    src_reg1: String,
    src_reg2: String,
    immediate_val: Int,
    scale_factor: Int
};

pub type InstructionSelectionTable = struct {
    patterns: List[IrTreePattern],
    pattern_count: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn ir_pattern_new(
    id: Int,
    root: Int,
    lhs: Int,
    rhs: Int,
    is_imm: Int,
    target_op: Int,
    cost: Int,
    mnem: String
) -> IrTreePattern {
    return IrTreePattern {
        pattern_id: id,
        root_opcode: root,
        lhs_opcode: lhs,
        rhs_opcode: rhs,
        is_immediate_rhs: is_imm,
        target_machine_opcode: target_op,
        cost: cost,
        mnemonic: mnem
    };
}

pub fn isel_table_new() -> InstructionSelectionTable {
    let empty_patterns: List[IrTreePattern] = list_new();
    return InstructionSelectionTable {
        patterns: empty_patterns,
        pattern_count: 0
    };
}

pub fn isel_add_pattern(mut table: InstructionSelectionTable, pat: IrTreePattern) -> InstructionSelectionTable {
    let mut p: List[IrTreePattern] = (table).patterns;
    p = list_push(p, pat);
    table.patterns = p;
    table.pattern_count = (table).pattern_count + 1;
    return table;
}

pub fn selected_machine_inst_new(
    id: Int,
    op: Int,
    mnem: String,
    dest: String,
    s1: String,
    s2: String,
    imm: Int,
    scale: Int
) -> SelectedMachineInst {
    return SelectedMachineInst {
        inst_id: id,
        machine_opcode: op,
        mnemonic: mnem,
        dest_reg: dest,
        src_reg1: s1,
        src_reg2: s2,
        immediate_val: imm,
        scale_factor: scale
    };
}

// -------------------------------------------------------------------
// Maximal Munch Selector
// -------------------------------------------------------------------

pub fn match_lea_pattern(root_op: Int, lhs_op: Int, imm_rhs: Int) -> Bool {
    // Check for base + (index * scale) or base + displacement
    // 1 is ADD, 3 is MUL
    if root_op == 1 && lhs_op == 3 && imm_rhs == 0 {
        return true;
    }
    return false;
}

pub fn select_instruction_for_node(
    table: InstructionSelectionTable,
    root_op: Int,
    lhs_op: Int,
    rhs_op: Int,
    is_imm: Int
) -> IrTreePattern {
    let limit: Int = (table).pattern_count;
    let mut best_cost: Int = 999999;
    let mut best_pat: IrTreePattern = ir_pattern_new(0, 0, 0, 0, 0, 0, 999999, "UNKNOWN");
    
    let mut i: Int = 0;
    while i < limit {
        let pat: IrTreePattern = list_get((table).patterns, i);
        if (pat).root_opcode == root_op && (pat).is_immediate_rhs == is_imm {
            if (pat).lhs_opcode == 0 || (pat).lhs_opcode == lhs_op {
                if (pat).rhs_opcode == 0 || (pat).rhs_opcode == rhs_op {
                    if (pat).cost < best_cost {
                        best_cost = (pat).cost;
                        best_pat = pat;
                    }
                }
            }
        }
        i = i + 1;
    }
    return best_pat;
}
