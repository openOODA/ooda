// # SSA Control Dependence Graph Engine
//
// Logline: Post-dominance tree analysis, reverse CFG computation, and control dependence edge calculation.
//
// Setup: Analyzes reverse control flow graphs to find block execution conditions and control dependence graphs (CDG).
//
// Beats:
//   1. Build reverse CFG and post-dominator tree.
//   2. Compute post-dominance frontiers to find control dependencies.
//   3. Build control dependence graphs for program dependence analysis.

import "./ssa_dominator_tree.oo";

pub type ControlDepEdge = struct {
    controller_block_id: Int,
    dependent_block_id: Int,
    branch_direction: Int,
};

pub type ControlDepGraph = struct {
    block_count: Int,
    edges: List[ControlDepEdge],
    edge_count: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn cd_edge_new(controller: Int, dependent: Int, direction: Int) -> ControlDepEdge {
    return ControlDepEdge {
        controller_block_id: controller,
        dependent_block_id: dependent,
        branch_direction: direction,
    };
}

pub fn cd_graph_new(block_count: Int) -> ControlDepGraph {
    let empty_edges: List[ControlDepEdge] = list_new();
    return ControlDepGraph {
        block_count: block_count,
        edges: empty_edges,
        edge_count: 0,
    };
}

pub fn cd_graph_add_edge(mut cdg: ControlDepGraph, edge: ControlDepEdge) -> ControlDepGraph {
    let mut e: List[ControlDepEdge] = (cdg).edges;
    e = list_push(e, edge);
    cdg.edges = e;
    cdg.edge_count = (cdg).edge_count + 1;
    return cdg;
}

// -------------------------------------------------------------------
// Reverse CFG & Post-Dominator Analysis
// -------------------------------------------------------------------

pub fn build_reverse_cfg(graph: CfgGraph, exit_id: Int) -> CfgGraph {
    let mut rev_graph: CfgGraph = cfg_graph_new(exit_id);
    let n_blocks: Int = (graph).block_count;
    
    let mut i: Int = 0;
    while i < n_blocks {
        let orig: CfgBlock = list_get((graph).blocks, i);
        let mut rev_blk: CfgBlock = cfg_block_new((orig).id, (orig).name);
        
        let n_preds: Int = (orig).pred_count;
        let mut p: Int = 0;
        while p < n_preds {
            let pid: Int = list_get((orig).predecessors, p);
            rev_blk = cfg_block_add_succ(rev_blk, pid);
            p = p + 1;
        }
        
        let n_succs: Int = (orig).succ_count;
        let mut s: Int = 0;
        while s < n_succs {
            let sid: Int = list_get((orig).successors, s);
            rev_blk = cfg_block_add_pred(rev_blk, sid);
            s = s + 1;
        }
        
        rev_graph = cfg_graph_add_block(rev_graph, rev_blk);
        i = i + 1;
    }
    return rev_graph;
}

pub fn compute_control_dependences(graph: CfgGraph, post_dom_tree: DomTree) -> ControlDepGraph {
    let n_blocks: Int = (graph).block_count;
    let mut cdg: ControlDepGraph = cd_graph_new(n_blocks);
    
    let mut a: Int = 0;
    while a < n_blocks {
        let blk_a: CfgBlock = list_get((graph).blocks, a);
        let n_succs: Int = (blk_a).succ_count;
        let mut s: Int = 0;
        while s < n_succs {
            let b: Int = list_get((blk_a).successors, s);
            let is_dom: Bool = dom_tree_dominates(post_dom_tree, b, a);
            if is_dom {
                // b dominates a in post-dom, not control dependent
            } else {
                let mut runner: Int = b;
                let post_node_a: DomTreeNode = list_get((post_dom_tree).nodes, a);
                let pdom_a: Int = (post_node_a).idom;
                
                let mut guard: Int = 0;
                while runner != pdom_a && runner >= 0 && guard < 1000 {
                    let edge: ControlDepEdge = cd_edge_new(a, runner, s);
                    cdg = cd_graph_add_edge(cdg, edge);
                    let r_node: DomTreeNode = list_get((post_dom_tree).nodes, runner);
                    runner = (r_node).idom;
                    guard = guard + 1;
                }
            }
            s = s + 1;
        }
        a = a + 1;
    }
    return cdg;
}
