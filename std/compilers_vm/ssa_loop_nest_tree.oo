// # SSA Natural Loop and Loop Nest Tree Engine
//
// Logline: Natural loop detection, CFG back-edge analysis, loop headers, pre-headers, and nesting level computation.
//
// Setup: Analyzes CFG edges and dominator relationships to construct loop nest hierarchies.
//
// Beats:
//   1. Identify CFG back-edges (tail -> head where head dominates tail).
//   2. Extract natural loop body blocks and loop exit blocks.
//   3. Compute loop nesting depths and parent-child loop trees.

import "./ssa_dominator_tree.oo";

pub type LoopInfo = struct {
    loop_id: Int,
    header_id: Int,
    preheader_id: Int,
    latch_id: Int,
    body_blocks: List[Int],
    body_count: Int,
    exit_blocks: List[Int],
    exit_count: Int,
    nest_depth: Int,
    parent_loop_id: Int
};

pub type LoopNestForest = struct {
    loops: List[LoopInfo],
    loop_count: Int,
    max_depth: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn loop_info_new(loop_id: Int, header_id: Int, latch_id: Int) -> LoopInfo {
    let body: List[Int] = list_new();
    let exits: List[Int] = list_new();
    return LoopInfo {
        loop_id: loop_id,
        header_id: header_id,
        preheader_id: -1,
        latch_id: latch_id,
        body_blocks: body,
        body_count: 0,
        exit_blocks: exits,
        exit_count: 0,
        nest_depth: 1,
        parent_loop_id: -1
    };
}

pub fn loop_info_add_body_block(mut loop_inst: LoopInfo, blk_id: Int) -> LoopInfo {
    let mut exists: Int = 0;
    let mut i: Int = 0;
    while i < (loop_inst).body_count {
        if list_get((loop_inst).body_blocks, i) == blk_id {
            exists = 1;
        }
        i = i + 1;
    }
    if exists == 0 {
        let mut blk_list: List[Int] = (loop_inst).body_blocks;
        blk_list = list_push(blk_list, blk_id);
        loop_inst.body_blocks = blk_list;
        loop_inst.body_count = (loop_inst).body_count + 1;
    }
    return loop_inst;
}

pub fn loop_info_add_exit_block(mut loop_inst: LoopInfo, blk_id: Int) -> LoopInfo {
    let mut exists: Int = 0;
    let mut i: Int = 0;
    while i < (loop_inst).exit_count {
        if list_get((loop_inst).exit_blocks, i) == blk_id {
            exists = 1;
        }
        i = i + 1;
    }
    if exists == 0 {
        let mut exit_list: List[Int] = (loop_inst).exit_blocks;
        exit_list = list_push(exit_list, blk_id);
        loop_inst.exit_blocks = exit_list;
        loop_inst.exit_count = (loop_inst).exit_count + 1;
    }
    return loop_inst;
}

pub fn loop_nest_forest_new() -> LoopNestForest {
    let empty_loops: List[LoopInfo] = list_new();
    return LoopNestForest {
        loops: empty_loops,
        loop_count: 0,
        max_depth: 0
    };
}

pub fn loop_nest_forest_add(mut forest: LoopNestForest, l: LoopInfo) -> LoopNestForest {
    let mut lp: List[LoopInfo] = (forest).loops;
    lp = list_push(lp, l);
    forest.loops = lp;
    forest.loop_count = (forest).loop_count + 1;
    if (l).nest_depth > (forest).max_depth {
        forest.max_depth = (l).nest_depth;
    }
    return forest;
}

// -------------------------------------------------------------------
// Natural Loop Detection
// -------------------------------------------------------------------

pub fn detect_natural_loops(graph: CfgGraph, tree: DomTree) -> LoopNestForest {
    let mut forest: LoopNestForest = loop_nest_forest_new();
    let num_blocks: Int = (graph).block_count;
    let mut next_loop_id: Int = 0;

    let mut blk_idx: Int = 0;
    while blk_idx < num_blocks {
        let blk: CfgBlock = list_get((graph).blocks, blk_idx);
        let n_succs: Int = (blk).succ_count;
        let mut s: Int = 0;
        while s < n_succs {
            let succ_id: Int = list_get((blk).successors, s);
            if dom_tree_dominates(tree, succ_id, blk_idx) {
                let mut l: LoopInfo = loop_info_new(next_loop_id, succ_id, blk_idx);
                l = loop_info_add_body_block(l, succ_id);
                l = loop_info_add_body_block(l, blk_idx);
                forest = loop_nest_forest_add(forest, l);
                next_loop_id = next_loop_id + 1;
            }
            s = s + 1;
        }
        blk_idx = blk_idx + 1;
    }
    return forest;
}

pub fn loop_contains_block(l: LoopInfo, blk_id: Int) -> Bool {
    let mut i: Int = 0;
    while i < (l).body_count {
        if list_get((l).body_blocks, i) == blk_id {
            return true;
        }
        i = i + 1;
    }
    return false;
}
