// # SSA Phi Node Placement Engine
//
// Logline: Minimal SSA phi-node placement algorithm using dominance frontiers and variable definition sets.
//
// Setup: Implements Cytron's phi-placement algorithm for SSA construction.
//
// Beats:
//   1. Represent Phi incoming operands, Phi instruction nodes, and block phi lists.
//   2. Compute phi placement targets from variable definition blocks and iterated dominance frontiers.
//   3. Build complete phi nodes for each join block with unpopulated version operands.

import "./ssa_dominance_frontier.oo";

pub type PhiOperand = struct {
    incoming_block_id: Int,
    value_name: String,
    version: Int,
};

pub type PhiNode = struct {
    result_var: String,
    result_version: Int,
    block_id: Int,
    operands: List[PhiOperand],
    operand_count: Int,
};

pub type BlockPhiSet = struct {
    block_id: Int,
    phi_nodes: List[PhiNode],
    phi_count: Int,
};

pub type SsaPhiPlacementResult = struct {
    total_phi_count: Int,
    block_phi_sets: List[BlockPhiSet],
    block_count: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn phi_operand_new(incoming_block_id: Int, value_name: String, version: Int) -> PhiOperand {
    return PhiOperand {
        incoming_block_id: incoming_block_id,
        value_name: value_name,
        version: version,
    };
}

pub fn phi_node_new(var_name: String, block_id: Int) -> PhiNode {
    let empty_operands: List[PhiOperand] = list_new();
    return PhiNode {
        result_var: var_name,
        result_version: 0,
        block_id: block_id,
        operands: empty_operands,
        operand_count: 0,
    };
}

pub fn phi_node_add_operand(mut node: PhiNode, operand: PhiOperand) -> PhiNode {
    let mut ops: List[PhiOperand] = (node).operands;
    ops = list_push(ops, operand);
    node.operands = ops;
    node.operand_count = (node).operand_count + 1;
    return node;
}

pub fn block_phi_set_new(block_id: Int) -> BlockPhiSet {
    let empty_nodes: List[PhiNode] = list_new();
    return BlockPhiSet {
        block_id: block_id,
        phi_nodes: empty_nodes,
        phi_count: 0,
    };
}

pub fn block_phi_set_add_phi(mut set: BlockPhiSet, phi: PhiNode) -> BlockPhiSet {
    let mut nodes: List[PhiNode] = (set).phi_nodes;
    nodes = list_push(nodes, phi);
    set.phi_nodes = nodes;
    set.phi_count = (set).phi_count + 1;
    return set;
}

pub fn ssa_phi_placement_result_new(block_count: Int) -> SsaPhiPlacementResult {
    let mut sets: List[BlockPhiSet] = list_new();
    let mut i: Int = 0;
    while i < block_count {
        sets = list_push(sets, block_phi_set_new(i));
        i = i + 1;
    }
    return SsaPhiPlacementResult {
        total_phi_count: 0,
        block_phi_sets: sets,
        block_count: block_count,
    };
}

// -------------------------------------------------------------------
// Phi Placement Algorithm
// -------------------------------------------------------------------

pub fn place_phi_nodes_for_variable(
    mut result: SsaPhiPlacementResult,
    var_name: String,
    def_blocks: List[Int],
    df_table: DominanceFrontierTable,
    graph: CfgGraph
) -> SsaPhiPlacementResult {
    let target_blocks: List[Int] = compute_iterated_dominance_frontier(df_table, def_blocks);
    let n_targets: Int = list_len(target_blocks);
    
    let mut i: Int = 0;
    while i < n_targets {
        let blk_id: Int = list_get(target_blocks, i);
        if blk_id >= 0 && blk_id < (result).block_count {
            let mut phi: PhiNode = phi_node_new(var_name, blk_id);
            let blk: CfgBlock = list_get((graph).blocks, blk_id);
            let n_preds: Int = (blk).pred_count;
            let mut p: Int = 0;
            while p < n_preds {
                let pred_id: Int = list_get((blk).predecessors, p);
                let op: PhiOperand = phi_operand_new(pred_id, var_name, 0);
                phi = phi_node_add_operand(phi, op);
                p = p + 1;
            }
            
            let mut blk_set: BlockPhiSet = list_get((result).block_phi_sets, blk_id);
            blk_set = block_phi_set_add_phi(blk_set, phi);
            
            let mut all_sets: List[BlockPhiSet] = list_new();
            let mut k: Int = 0;
            while k < (result).block_count {
                if k == blk_id {
                    all_sets = list_push(all_sets, blk_set);
                } else {
                    all_sets = list_push(all_sets, list_get((result).block_phi_sets, k));
                }
                k = k + 1;
            }
            result.block_phi_sets = all_sets;
            result.total_phi_count = (result).total_phi_count + 1;
        }
        i = i + 1;
    }
    return result;
}
