// # ELF64 Binary Header Parser
//
// Logline: 64-bit Executable and Linkable Format (ELF64) file header, section header table, and program header parser.
//
// Setup: Parses ELF64 ident bytes (0x7F 'E' 'L' 'F'), machine targets (EM_X86_64=62, EM_AARCH64=183), and header offsets.
//
// Beats:
//   1. Define Elf64Header, Elf64SectionHeader, and Elf64ProgramHeader structures.
//   2. Validate ELF magic identification bytes and 64-bit little-endian binary format.
//   3. Parse section types (SHT_PROGBITS, SHT_SYMTAB, SHT_RELA) and program segment flags (PT_LOAD, PF_R, PF_W, PF_X).

pub type Elf64Header = struct {
    e_type: Int,      // 1: REL, 2: EXEC, 3: DYN (shared object)
    e_machine: Int,   // 62: x86_64, 183: AArch64, 243: RISC-V 64
    e_version: Int,
    e_entry: Int,
    e_phoff: Int,
    e_shoff: Int,
    e_flags: Int,
    e_ehsize: Int,
    e_phentsize: Int,
    e_phnum: Int,
    e_shentsize: Int,
    e_shnum: Int,
    e_shstrndx: Int,
};

pub type Elf64SectionHeader = struct {
    sh_name: Int,
    sh_type: Int,      // 1: PROGBITS, 2: SYMTAB, 3: STRTAB, 4: RELA, 8: NOBITS
    sh_flags: Int,     // 1: WRITE, 2: ALLOC, 4: EXECINSTR
    sh_addr: Int,
    sh_offset: Int,
    sh_size: Int,
    sh_link: Int,
    sh_info: Int,
    sh_addralign: Int,
    sh_entsize: Int,
};

pub type Elf64ProgramHeader = struct {
    p_type: Int,       // 1: LOAD, 2: DYNAMIC, 3: INTERP, 6: PHDR, 7: TLS
    p_flags: Int,      // 1: EXEC, 2: WRITE, 4: READ
    p_offset: Int,
    p_vaddr: Int,
    p_paddr: Int,
    p_filesz: Int,
    p_memsz: Int,
    p_align: Int,
};

// -------------------------------------------------------------------
// Constants
// -------------------------------------------------------------------

pub fn elf_et_rel() -> Int { return 1; }
pub fn elf_et_exec() -> Int { return 2; }
pub fn elf_et_dyn() -> Int { return 3; }

pub fn elf_em_x86_64() -> Int { return 62; }
pub fn elf_em_aarch64() -> Int { return 183; }
pub fn elf_em_riscv() -> Int { return 243; }

pub fn elf_sht_progbits() -> Int { return 1; }
pub fn elf_sht_symtab() -> Int { return 2; }
pub fn elf_sht_strtab() -> Int { return 3; }
pub fn elf_sht_rela() -> Int { return 4; }
pub fn elf_sht_nobits() -> Int { return 8; }

pub fn elf_pt_load() -> Int { return 1; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn elf64_header_new(e_type: Int, machine: Int, entry: Int) -> Elf64Header {
    return Elf64Header {
        e_type: e_type,
        e_machine: machine,
        e_version: 1,
        e_entry: entry,
        e_phoff: 64, // Standard 64-byte ELF header size
        e_shoff: 0,
        e_flags: 0,
        e_ehsize: 64,
        e_phentsize: 56,
        e_phnum: 0,
        e_shentsize: 64,
        e_shnum: 0,
        e_shstrndx: 0,
    };
}

pub fn elf64_section_header_new(
    sh_type: Int,
    flags: Int,
    addr: Int,
    offset: Int,
    size: Int
) -> Elf64SectionHeader {
    return Elf64SectionHeader {
        sh_name: 0,
        sh_type: sh_type,
        sh_flags: flags,
        sh_addr: addr,
        sh_offset: offset,
        sh_size: size,
        sh_link: 0,
        sh_info: 0,
        sh_addralign: 8,
        sh_entsize: 0,
    };
}

pub fn elf64_program_header_new(
    p_type: Int,
    flags: Int,
    offset: Int,
    vaddr: Int,
    filesz: Int,
    memsz: Int
) -> Elf64ProgramHeader {
    return Elf64ProgramHeader {
        p_type: p_type,
        p_flags: flags,
        p_offset: offset,
        p_vaddr: vaddr,
        p_paddr: vaddr,
        p_filesz: filesz,
        p_memsz: memsz,
        p_align: 4096, // Standard 4KB page alignment
    };
}

pub fn elf64_verify_magic(b0: Int, b1: Int, b2: Int, b3: Int) -> Bool {
    // 0x7F 'E' 'L' 'F' -> 127, 69, 76, 70
    if b0 == 127 && b1 == 69 && b2 == 76 && b3 == 70 {
        return true;
    }
    return false;
}
