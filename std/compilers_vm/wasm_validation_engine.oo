// # WebAssembly Bytecode Validation Engine
//
// Logline: WebAssembly type stack validation, control frame tracking, and unreachable code polymorphism checks.
//
// Setup: Validates that WebAssembly bytecode sequences obey structural type constraints and operand stack balance rules.
//
// Beats:
//   1. Define WasmValType, ControlFrame, and ValidationState structures.
//   2. Push and pop operand types with polymorphic bottom type handling.
//   3. Validate branch targets against enclosing control frame label signatures.

pub type WasmValType = struct {
    type_code: Int, // 127: i32 (0x7F), 126: i64 (0x7E), 125: f32 (0x7D), 124: f64 (0x7C), 123: v128 (0x7B), 0: UNKNOWN/POLY
    type_name: String
};

pub type ControlFrame = struct {
    opcode: Int, // 0x02: block, 0x03: loop, 0x04: if
    start_stack_height: Int,
    label_types: List[Int],
    label_count: Int,
    end_types: List[Int],
    end_count: Int,
    is_unreachable: Int
};

pub type ValidationContext = struct {
    op_stack: List[Int],
    stack_height: Int,
    control_stack: List[ControlFrame],
    control_depth: Int,
    is_valid: Int,
    error_message: String
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn wasm_val_type_i32() -> WasmValType { return WasmValType { type_code: 127, type_name: "i32" }; }
pub fn wasm_val_type_i64() -> WasmValType { return WasmValType { type_code: 126, type_name: "i64" }; }
pub fn wasm_val_type_f32() -> WasmValType { return WasmValType { type_code: 125, type_name: "f32" }; }
pub fn wasm_val_type_f64() -> WasmValType { return WasmValType { type_code: 124, type_name: "f64" }; }
pub fn wasm_val_type_v128() -> WasmValType { return WasmValType { type_code: 123, type_name: "v128" }; }

pub fn control_frame_new(opcode: Int, start_height: Int) -> ControlFrame {
    let empty_label: List[Int] = list_new();
    let empty_end: List[Int] = list_new();
    return ControlFrame {
        opcode: opcode,
        start_stack_height: start_height,
        label_types: empty_label,
        label_count: 0,
        end_types: empty_end,
        end_count: 0,
        is_unreachable: 0
    };
}

pub fn validation_context_new() -> ValidationContext {
    let empty_op: List[Int] = list_new();
    let empty_ctrl: List[ControlFrame] = list_new();
    return ValidationContext {
        op_stack: empty_op,
        stack_height: 0,
        control_stack: empty_ctrl,
        control_depth: 0,
        is_valid: 1,
        error_message: ""
    };
}

// -------------------------------------------------------------------
// Stack Operations
// -------------------------------------------------------------------

pub fn val_push_op(mut ctx: ValidationContext, type_code: Int) -> ValidationContext {
    let mut s: List[Int] = (ctx).op_stack;
    s = list_push(s, type_code);
    ctx.op_stack = s;
    ctx.stack_height = (ctx).stack_height + 1;
    return ctx;
}

pub fn val_pop_op(mut ctx: ValidationContext, expected_type: Int) -> ValidationContext {
    let h: Int = (ctx).stack_height;
    if h <= 0 {
        ctx.is_valid = 0;
        ctx.error_message = "Stack underflow";
        return ctx;
    }
    
    let actual_type: Int = list_get((ctx).op_stack, h - 1);
    if expected_type != 0 && actual_type != 0 && actual_type != expected_type {
        ctx.is_valid = 0;
        ctx.error_message = "Type mismatch on stack";
        return ctx;
    }
    
    let mut new_stack: List[Int] = list_new();
    let mut i: Int = 0;
    while i < h - 1 {
        new_stack = list_push(new_stack, list_get((ctx).op_stack, i));
        i = i + 1;
    }
    ctx.op_stack = new_stack;
    ctx.stack_height = h - 1;
    return ctx;
}

pub fn val_push_control(mut ctx: ValidationContext, opcode: Int) -> ValidationContext {
    let frame: ControlFrame = control_frame_new(opcode, (ctx).stack_height);
    let mut cs: List[ControlFrame] = (ctx).control_stack;
    cs = list_push(cs, frame);
    ctx.control_stack = cs;
    ctx.control_depth = (ctx).control_depth + 1;
    return ctx;
}

pub fn val_pop_control(mut ctx: ValidationContext) -> ValidationContext {
    let d: Int = (ctx).control_depth;
    if d <= 0 {
        ctx.is_valid = 0;
        ctx.error_message = "Control stack underflow";
        return ctx;
    }
    
    let mut new_ctrl: List[ControlFrame] = list_new();
    let mut i: Int = 0;
    while i < d - 1 {
        new_ctrl = list_push(new_ctrl, list_get((ctx).control_stack, i));
        i = i + 1;
    }
    ctx.control_stack = new_ctrl;
    ctx.control_depth = d - 1;
    return ctx;
}
