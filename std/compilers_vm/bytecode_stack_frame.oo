// # Virtual Machine Execution Stack Frame Engine
//
// Logline: Execution activation frame allocation, local variable slots, dynamic operand stack bounds, and caller return links.
//
// Setup: Manages nested function activation records, saved return addresses, and stack overflow guards.
//
// Beats:
//   1. Define VmStackFrame, CallStack, and FrameAllocation structures.
//   2. Push new activation frame on method invocation with caller return PC.
//   3. Pop frame on method return and propagate return value to caller operand stack.

pub type VmStackFrame = struct {
    frame_id: Int,
    function_name: String,
    return_pc: Int,
    locals: List[Int],
    local_count: Int,
    stack_base: Int,
    max_stack_depth: Int
};

pub type VmCallStack = struct {
    frames: List[VmStackFrame],
    frame_count: Int,
    max_frames: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn vm_stack_frame_new(
    frame_id: Int,
    fn_name: String,
    ret_pc: Int,
    n_locals: Int,
    max_depth: Int
) -> VmStackFrame {
    let mut locs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n_locals {
        locs = list_push(locs, 0);
        i = i + 1;
    }
    return VmStackFrame {
        frame_id: frame_id,
        function_name: fn_name,
        return_pc: ret_pc,
        locals: locs,
        local_count: n_locals,
        stack_base: 0,
        max_stack_depth: max_depth
    };
}

pub fn vm_call_stack_new(max_frames: Int) -> VmCallStack {
    let empty_frames: List[VmStackFrame] = list_new();
    return VmCallStack {
        frames: empty_frames,
        frame_count: 0,
        max_frames: max_frames
    };
}

// -------------------------------------------------------------------
// Frame Push and Pop Operations
// -------------------------------------------------------------------

pub fn call_stack_push(mut cs: VmCallStack, frame: VmStackFrame) -> VmCallStack {
    if (cs).frame_count < (cs).max_frames {
        let mut f: List[VmStackFrame] = (cs).frames;
        f = list_push(f, frame);
        cs.frames = f;
        cs.frame_count = (cs).frame_count + 1;
    }
    return cs;
}

pub fn call_stack_top(cs: VmCallStack) -> VmStackFrame {
    let count: Int = (cs).frame_count;
    if count > 0 {
        return list_get((cs).frames, count - 1);
    }
    return vm_stack_frame_new(-1, "", 0, 0, 0);
}

pub fn call_stack_pop(mut cs: VmCallStack) -> VmCallStack {
    let count: Int = (cs).frame_count;
    if count > 0 {
        let mut new_frames: List[VmStackFrame] = list_new();
        let mut i: Int = 0;
        while i < count - 1 {
            new_frames = list_push(new_frames, list_get((cs).frames, i));
            i = i + 1;
        }
        cs.frames = new_frames;
        cs.frame_count = count - 1;
    }
    return cs;
}
