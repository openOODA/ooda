// # Compiler Tail Call Optimization Pass
//
// Logline: Tail call elimination (TCO), self-recursion loop transformation, and return value forwarding.
//
// Setup: Identifies call sites in tail position and transforms recursive calls into CFG back-edges with phi nodes.
//
// Beats:
//   1. Represent CallSiteInfo and TailCallCandidate records.
//   2. Validate tail position criteria (no subsequent instructions except return).
//   3. Transform direct self-recursive calls into loop branches and argument updates.

pub type CallSiteInfo = struct {
    call_id: Int,
    caller_fn: String,
    callee_fn: String,
    block_id: Int,
    inst_index_in_block: Int,
    total_insts_in_block: Int,
    arg_vars: List[String],
    arg_count: Int,
    ret_var: String
};

pub type TcoTransformResult = struct {
    call_id: Int,
    is_transformed: Int,
    is_self_recursive: Int,
    loop_header_block: Int,
    remarks: String
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn call_site_info_new(
    call_id: Int,
    caller: String,
    callee: String,
    blk_id: Int,
    idx: Int,
    total: Int,
    ret: String
) -> CallSiteInfo {
    let empty_args: List[String] = list_new();
    return CallSiteInfo {
        call_id: call_id,
        caller_fn: caller,
        callee_fn: callee,
        block_id: blk_id,
        inst_index_in_block: idx,
        total_insts_in_block: total,
        arg_vars: empty_args,
        arg_count: 0,
        ret_var: ret
    };
}

pub fn call_site_add_arg(mut cs: CallSiteInfo, arg_var: String) -> CallSiteInfo {
    let mut args: List[String] = (cs).arg_vars;
    args = list_push(args, arg_var);
    cs.arg_vars = args;
    cs.arg_count = (cs).arg_count + 1;
    return cs;
}

pub fn tco_result_new(
    call_id: Int,
    transformed: Int,
    self_rec: Int,
    header_blk: Int,
    msg: String
) -> TcoTransformResult {
    return TcoTransformResult {
        call_id: call_id,
        is_transformed: transformed,
        is_self_recursive: self_rec,
        loop_header_block: header_blk,
        remarks: msg
    };
}

// -------------------------------------------------------------------
// TCO Analysis & Transformation
// -------------------------------------------------------------------

pub fn is_in_tail_position(cs: CallSiteInfo) -> Bool {
    let idx: Int = (cs).inst_index_in_block;
    let total: Int = (cs).total_insts_in_block;
    if idx == total - 1 || idx == total - 2 {
        return true;
    }
    return false;
}

pub fn evaluate_tail_call(cs: CallSiteInfo, entry_block_id: Int) -> TcoTransformResult {
    let in_tail: Bool = is_in_tail_position(cs);
    if in_tail {
        if (cs).caller_fn == (cs).callee_fn {
            return tco_result_new((cs).call_id, 1, 1, entry_block_id, "Converted self-recursive tail call to loop jump");
        }
        return tco_result_new((cs).call_id, 1, 0, -1, "Converted foreign tail call to sibling jump");
    }
    return tco_result_new((cs).call_id, 0, 0, -1, "Not in tail position");
}
