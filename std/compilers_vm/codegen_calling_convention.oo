// # Code Generation Calling Convention Engine
//
// Logline: System V AMD64 and ARM64 AAPCS calling convention models, register parameter passing, and frame layouts.
//
// Setup: Maps logical function parameters to physical architecture registers (RDI, RSI, RDX, RCX, R8, R9 vs X0-X7) or stack locations.
//
// Beats:
//   1. Define CallingConventionKind, ParamLocation, and FunctionAbiLayout structures.
//   2. Allocate argument registers according to target ABI specifications.
//   3. Compute callee-saved register spill requirements and shadow space (Win64).

pub type ParamLocation = struct {
    param_index: Int,
    is_in_register: Int,
    register_name: String,
    register_id: Int,
    stack_offset: Int,
    size_bytes: Int,
};

pub type FunctionAbiLayout = struct {
    abi_kind: Int, // 0: SYSV_AMD64, 1: WIN64, 2: AAPCS64
    param_locations: List[ParamLocation],
    param_count: Int,
    stack_args_size_bytes: Int,
    shadow_space_bytes: Int,
    callee_saved_regs: List[String],
    callee_saved_count: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn param_location_reg(idx: Int, reg_name: String, reg_id: Int, size: Int) -> ParamLocation {
    return ParamLocation {
        param_index: idx,
        is_in_register: 1,
        register_name: reg_name,
        register_id: reg_id,
        stack_offset: 0,
        size_bytes: size,
    };
}

pub fn param_location_stack(idx: Int, offset: Int, size: Int) -> ParamLocation {
    return ParamLocation {
        param_index: idx,
        is_in_register: 0,
        register_name: "",
        register_id: -1,
        stack_offset: offset,
        size_bytes: size,
    };
}

pub fn abi_layout_new(abi_kind: Int) -> FunctionAbiLayout {
    let empty_locs: List[ParamLocation] = list_new();
    let empty_regs: List[String] = list_new();
    let shadow: Int = 0;
    return FunctionAbiLayout {
        abi_kind: abi_kind,
        param_locations: empty_locs,
        param_count: 0,
        stack_args_size_bytes: 0,
        shadow_space_bytes: shadow,
        callee_saved_regs: empty_regs,
        callee_saved_count: 0,
    };
}

// -------------------------------------------------------------------
// System V AMD64 ABI Parameter Mapping
// -------------------------------------------------------------------

pub fn sysv_amd64_reg_name(idx: Int) -> String {
    if idx == 0 { return "rdi"; }
    if idx == 1 { return "rsi"; }
    if idx == 2 { return "rdx"; }
    if idx == 3 { return "rcx"; }
    if idx == 4 { return "r8"; }
    if idx == 5 { return "r9"; }
    return "";
}

pub fn arm64_reg_name_abi(idx: Int) -> String {
    if idx == 0 { return "x0"; }
    if idx == 1 { return "x1"; }
    if idx == 2 { return "x2"; }
    if idx == 3 { return "x3"; }
    if idx == 4 { return "x4"; }
    if idx == 5 { return "x5"; }
    if idx == 6 { return "x6"; }
    if idx == 7 { return "x7"; }
    return "";
}

pub fn compute_sysv_abi_layout(num_params: Int, param_size: Int) -> FunctionAbiLayout {
    let mut layout: FunctionAbiLayout = abi_layout_new(0);
    let mut stack_offset: Int = 0;
    let mut locs: List[ParamLocation] = list_new();
    
    let mut i: Int = 0;
    while i < num_params {
        if i < 6 {
            let reg_name: String = sysv_amd64_reg_name(i);
            let loc: ParamLocation = param_location_reg(i, reg_name, i, param_size);
            locs = list_push(locs, loc);
        } else {
            let loc_s: ParamLocation = param_location_stack(i, stack_offset, param_size);
            locs = list_push(locs, loc_s);
            stack_offset = stack_offset + param_size;
        }
        i = i + 1;
    }
    
    layout.param_locations = locs;
    layout.param_count = num_params;
    layout.stack_args_size_bytes = stack_offset;
    return layout;
}
