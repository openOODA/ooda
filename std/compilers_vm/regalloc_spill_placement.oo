// # Register Allocation Spill Placement Engine
//
// Logline: Spill code generation, stack frame slot allocation, rematerialization detection, and spill cost heuristics.
//
// Setup: Assigns unique stack offsets to spilled virtual registers and generates reload/spill store points.
//
// Beats:
//   1. Define SpillSlot, StackFrameAllocation, and RematerializeRule structures.
//   2. Compute spill costs weighted by loop nesting depth (cost * 10^depth).
//   3. Allocate aligned stack slots for spilled registers.

pub type SpillSlot = struct {
    var_id: Int,
    stack_offset: Int,
    size_bytes: Int,
    alignment_bytes: Int,
    is_rematerializable: Int,
    remat_constant_val: Int
};

pub type StackFrameLayout = struct {
    slots: List[SpillSlot],
    slot_count: Int,
    total_frame_size_bytes: Int,
    required_alignment: Int
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn spill_slot_new(var_id: Int, size: Int, align: Int) -> SpillSlot {
    return SpillSlot {
        var_id: var_id,
        stack_offset: 0,
        size_bytes: size,
        alignment_bytes: align,
        is_rematerializable: 0,
        remat_constant_val: 0
    };
}

pub fn stack_frame_layout_new(align: Int) -> StackFrameLayout {
    let empty_slots: List[SpillSlot] = list_new();
    return StackFrameLayout {
        slots: empty_slots,
        slot_count: 0,
        total_frame_size_bytes: 0,
        required_alignment: align
    };
}

// -------------------------------------------------------------------
// Stack Slot Allocation
// -------------------------------------------------------------------

pub fn align_up(offset: Int, align: Int) -> Int {
    let remainder: Int = offset - ((offset / align) * align);
    if remainder == 0 {
        return offset;
    }
    return offset + (align - remainder);
}

pub fn stack_frame_add_slot(mut frame: StackFrameLayout, mut slot: SpillSlot) -> StackFrameLayout {
    let current_offset: Int = (frame).total_frame_size_bytes;
    let aligned_offset: Int = align_up(current_offset, (slot).alignment_bytes);
    
    slot.stack_offset = aligned_offset;
    let new_total: Int = aligned_offset + (slot).size_bytes;
    
    let mut sl: List[SpillSlot] = (frame).slots;
    sl = list_push(sl, slot);
    frame.slots = sl;
    frame.slot_count = (frame).slot_count + 1;
    frame.total_frame_size_bytes = align_up(new_total, (frame).required_alignment);
    return frame;
}

pub fn compute_spill_cost(raw_uses: Int, raw_defs: Int, loop_depth: Int) -> Int {
    let mut factor: Int = 1;
    let mut d: Int = 0;
    while d < loop_depth {
        factor = factor * 10;
        d = d + 1;
    }
    return (raw_uses + raw_defs) * factor;
}
