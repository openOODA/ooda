// # WebAssembly Binary Module Emitter
//
// Logline: Wasm binary section framing, header generation, section ID encoding, and byte-stream aggregation.
//
// Setup: Generates valid WebAssembly binary modules with magic header (0x00 0x61 0x73 0x6D) and version 1.
//
// Beats:
//   1. Define WasmSection, WasmSectionId constants, and WasmModuleBuilder.
//   2. Encode binary sections with prepended length prefixes.
//   3. Assemble complete WebAssembly binary byte vector.

import "./wasm_leb128_codec.oo";

pub type WasmSection = struct {
    section_id: Int,
    payload_bytes: List[Int],
    payload_length: Int
};

pub type WasmModuleBuilder = struct {
    sections: List[WasmSection],
    section_count: Int,
    total_bytes: Int
};

// -------------------------------------------------------------------
// Section IDs
// -------------------------------------------------------------------

pub fn wasm_sec_custom() -> Int { return 0; }
pub fn wasm_sec_type() -> Int { return 1; }
pub fn wasm_sec_import() -> Int { return 2; }
pub fn wasm_sec_function() -> Int { return 3; }
pub fn wasm_sec_table() -> Int { return 4; }
pub fn wasm_sec_memory() -> Int { return 5; }
pub fn wasm_sec_global() -> Int { return 6; }
pub fn wasm_sec_export() -> Int { return 7; }
pub fn wasm_sec_start() -> Int { return 8; }
pub fn wasm_sec_element() -> Int { return 9; }
pub fn wasm_sec_code() -> Int { return 10; }
pub fn wasm_sec_data() -> Int { return 11; }
pub fn wasm_sec_datacount() -> Int { return 12; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn wasm_section_new(sec_id: Int, payload: List[Int]) -> WasmSection {
    let len: Int = list_len(payload);
    return WasmSection {
        section_id: sec_id,
        payload_bytes: payload,
        payload_length: len
    };
}

pub fn wasm_module_builder_new() -> WasmModuleBuilder {
    let empty_secs: List[WasmSection] = list_new();
    return WasmModuleBuilder {
        sections: empty_secs,
        section_count: 0,
        total_bytes: 8 // 4 bytes magic + 4 bytes version
    };
}

pub fn wasm_builder_add_section(mut builder: WasmModuleBuilder, sec: WasmSection) -> WasmModuleBuilder {
    let mut s: List[WasmSection] = (builder).sections;
    s = list_push(s, sec);
    builder.sections = s;
    builder.section_count = (builder).section_count + 1;
    builder.total_bytes = (builder).total_bytes + 1 + (sec).payload_length + 4;
    return builder;
}

// -------------------------------------------------------------------
// Module Binary Assembly
// -------------------------------------------------------------------

pub fn emit_wasm_binary(builder: WasmModuleBuilder) -> List[Int] {
    let mut binary: List[Int] = list_new();
    
    // Magic: \0asm
    binary = list_push(binary, 0);
    binary = list_push(binary, 97);  // 'a'
    binary = list_push(binary, 115); // 's'
    binary = list_push(binary, 109); // 'm'
    
    // Version: 1
    binary = list_push(binary, 1);
    binary = list_push(binary, 0);
    binary = list_push(binary, 0);
    binary = list_push(binary, 0);
    
    let n_secs: Int = (builder).section_count;
    let mut i: Int = 0;
    while i < n_secs {
        let sec: WasmSection = list_get((builder).sections, i);
        // Section ID
        binary = list_push(binary, (sec).section_id);
        
        // Section Length (LEB128)
        let len_leb: List[Int] = encode_u32_leb128((sec).payload_length);
        let n_leb: Int = list_len(len_leb);
        let mut l_idx: Int = 0;
        while l_idx < n_leb {
            binary = list_push(binary, list_get(len_leb, l_idx));
            l_idx = l_idx + 1;
        }
        
        // Payload bytes
        let p_len: Int = (sec).payload_length;
        let mut p_idx: Int = 0;
        while p_idx < p_len {
            binary = list_push(binary, list_get((sec).payload_bytes, p_idx));
            p_idx = p_idx + 1;
        }
        i = i + 1;
    }
    return binary;
}
