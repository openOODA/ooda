// # WebAssembly Component Model Engine
//
// Logline: WebAssembly Component Model Canonical ABI lift/lower memory transformations, resource handles, and WIT interface types.
//
// Setup: Encodes component-level types (records, variants, lists, options, results) and maps canonical ABI flattened representations.
//
// Beats:
//   1. Define ComponentValType, CanonicalOptions, and ComponentInterface structures.
//   2. Compute Canonical ABI flattening rules (types to core i32/i64/f32/f64 values).
//   3. Compute memory alignment and size calculations for compound component types.

pub type ComponentValType = struct {
    type_kind: Int, // 0: BOOL, 1: S32, 2: U32, 3: S64, 4: U64, 5: F32, 6: F64, 7: STRING, 8: LIST, 9: RECORD, 10: VARIANT
    type_name: String,
    size_bytes: Int,
    alignment_bytes: Int,
    num_flattened_core_types: Int,
};

pub type CanonicalOptions = struct {
    string_encoding: Int, // 0: UTF8, 1: UTF16, 2: COMPACT_UTF16
    memory_index: Int,
    realloc_func_index: Int,
    post_return_func_index: Int,
};

pub type ComponentInterface = struct {
    interface_name: String,
    exported_types: List[ComponentValType],
    type_count: Int,
};

// -------------------------------------------------------------------
// Type Kinds
// -------------------------------------------------------------------

pub fn comp_type_bool() -> Int { return 0; }
pub fn comp_type_s32() -> Int { return 1; }
pub fn comp_type_u32() -> Int { return 2; }
pub fn comp_type_s64() -> Int { return 3; }
pub fn comp_type_u64() -> Int { return 4; }
pub fn comp_type_f32() -> Int { return 5; }
pub fn comp_type_f64() -> Int { return 6; }
pub fn comp_type_string() -> Int { return 7; }
pub fn comp_type_list() -> Int { return 8; }
pub fn comp_type_record() -> Int { return 9; }
pub fn comp_type_variant() -> Int { return 10; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn component_val_type_primitive(kind: Int, name: String) -> ComponentValType {
    let mut sz: Int = 4;
    let mut al: Int = 4;
    let mut flat: Int = 1;
    
    if kind == 0 { sz = 1; al = 1; flat = 1; }
    if kind == 3 || kind == 4 || kind == 6 { sz = 8; al = 8; flat = 1; }
    if kind == 7 { sz = 8; al = 4; flat = 2; } // (ptr, len)
    if kind == 8 { sz = 8; al = 4; flat = 2; } // (ptr, len)
    
    return ComponentValType {
        type_kind: kind,
        type_name: name,
        size_bytes: sz,
        alignment_bytes: al,
        num_flattened_core_types: flat,
    };
}

pub fn canonical_options_default() -> CanonicalOptions {
    return CanonicalOptions {
        string_encoding: 0,
        memory_index: 0,
        realloc_func_index: -1,
        post_return_func_index: -1,
    };
}

pub fn component_interface_new(name: String) -> ComponentInterface {
    let empty_types: List[ComponentValType] = list_new();
    return ComponentInterface {
        interface_name: name,
        exported_types: empty_types,
        type_count: 0,
    };
}

pub fn component_interface_add_type(mut iface: ComponentInterface, t: ComponentValType) -> ComponentInterface {
    let mut ts: List[ComponentValType] = (iface).exported_types;
    ts = list_push(ts, t);
    iface.exported_types = ts;
    iface.type_count = (iface).type_count + 1;
    return iface;
}

// -------------------------------------------------------------------
// Canonical ABI Flattening Calculation
// -------------------------------------------------------------------

pub fn is_pass_by_memory(total_flattened_params: Int) -> Bool {
    // Canonical ABI: If flattened parameters exceed 16, they are passed indirectly via memory pointer
    if total_flattened_params > 16 {
        return true;
    }
    return false;
}
