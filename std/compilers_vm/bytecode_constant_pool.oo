// # Virtual Machine Constant Pool Engine
//
// Logline: Constant pool item resolution, string intern table, integer/float constants, and symbolic method references.
//
// Setup: Indexes literals and symbolic descriptors into a 1-indexed constant pool array with runtime resolution caches.
//
// Beats:
//   1. Define ConstantPoolTag constants and CpEntry structure.
//   2. Resolve integer, string, field reference, and method reference items.
//   3. Intern strings to ensure identity comparison and minimize duplicate allocations.

pub type CpEntry = struct {
    tag: Int, // 1: INT, 2: FLOAT, 3: STRING, 4: CLASS_REF, 5: FIELD_REF, 6: METHOD_REF
    int_value: Int,
    string_value: String,
    ref_class_index: Int,
    ref_name_and_type_index: Int,
};

pub type ConstantPool = struct {
    entries: List[CpEntry],
    entry_count: Int,
};

// -------------------------------------------------------------------
// Tag Constants
// -------------------------------------------------------------------

pub fn cp_tag_int() -> Int { return 1; }
pub fn cp_tag_float() -> Int { return 2; }
pub fn cp_tag_string() -> Int { return 3; }
pub fn cp_tag_class_ref() -> Int { return 4; }
pub fn cp_tag_field_ref() -> Int { return 5; }
pub fn cp_tag_method_ref() -> Int { return 6; }

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn cp_entry_int(val: Int) -> CpEntry {
    return CpEntry {
        tag: 1,
        int_value: val,
        string_value: "",
        ref_class_index: 0,
        ref_name_and_type_index: 0,
    };
}

pub fn cp_entry_string(val: String) -> CpEntry {
    return CpEntry {
        tag: 3,
        int_value: 0,
        string_value: val,
        ref_class_index: 0,
        ref_name_and_type_index: 0,
    };
}

pub fn cp_entry_method_ref(class_idx: Int, name_type_idx: Int) -> CpEntry {
    return CpEntry {
        tag: 6,
        int_value: 0,
        string_value: "",
        ref_class_index: class_idx,
        ref_name_and_type_index: name_type_idx,
    };
}

pub fn constant_pool_new() -> ConstantPool {
    let empty_entries: List[CpEntry] = list_new();
    return ConstantPool {
        entries: empty_entries,
        entry_count: 0,
    };
}

pub fn cp_add_entry(mut cp: ConstantPool, entry: CpEntry) -> ConstantPool {
    let mut e: List[CpEntry] = (cp).entries;
    e = list_push(e, entry);
    cp.entries = e;
    cp.entry_count = (cp).entry_count + 1;
    return cp;
}

// -------------------------------------------------------------------
// Resolution Helpers
// -------------------------------------------------------------------

pub fn cp_get_int(cp: ConstantPool, index: Int) -> Int {
    if index >= 0 && index < (cp).entry_count {
        let entry: CpEntry = list_get((cp).entries, index);
        if (entry).tag == 1 {
            return (entry).int_value;
        }
    }
    return 0;
}

pub fn cp_get_string(cp: ConstantPool, index: Int) -> String {
    if index >= 0 && index < (cp).entry_count {
        let entry: CpEntry = list_get((cp).entries, index);
        if (entry).tag == 3 {
            return (entry).string_value;
        }
    }
    return "";
}
