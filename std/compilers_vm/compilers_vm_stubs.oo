// # Compiler and VM Mock Stubs and Benchmarks
//
// Logline: Synthetic CFG graph generators, benchmark bytecode pipelines, and test harness stubs for compiler optimization.
//
// Setup: Generates sample control flow graphs, SSA variables, and test bytecode programs for compiler testing suites.
//
// Beats:
//   1. Generate synthetic diamond and loop CFGs.
//   2. Generate sample bytecode programs for interpreter loop validation.
//   3. Provide compiler and VM diagnostic test harnesses.

import "./ssa_dominator_tree.oo";
import "./bytecode_instruction_set.oo";

pub type CompilerVmStubSuite = struct {
    suite_name: String,
    num_test_graphs: Int,
    num_test_programs: Int,
    is_available: Int,
};

// -------------------------------------------------------------------
// Constructors & Generators
// -------------------------------------------------------------------

pub fn compiler_vm_stubs_default() -> CompilerVmStubSuite {
    return CompilerVmStubSuite {
        suite_name: "openOODA-Compiler-VM-Suite",
        num_test_graphs: 5,
        num_test_programs: 10,
        is_available: 1,
    };
}

pub fn generate_diamond_cfg() -> CfgGraph {
    // Block 0 (Entry) -> 1, 2
    // Block 1 -> 3
    // Block 2 -> 3
    // Block 3 (Exit)
    let mut g: CfgGraph = cfg_graph_new(0);
    
    let mut b0: CfgBlock = cfg_block_new(0, "entry");
    b0 = cfg_block_add_succ(b0, 1);
    b0 = cfg_block_add_succ(b0, 2);
    
    let mut b1: CfgBlock = cfg_block_new(1, "then_branch");
    b1 = cfg_block_add_pred(b1, 0);
    b1 = cfg_block_add_succ(b1, 3);
    
    let mut b2: CfgBlock = cfg_block_new(2, "else_branch");
    b2 = cfg_block_add_pred(b2, 0);
    b2 = cfg_block_add_succ(b2, 3);
    
    let mut b3: CfgBlock = cfg_block_new(3, "join_exit");
    b3 = cfg_block_add_pred(b3, 1);
    b3 = cfg_block_add_pred(b3, 2);
    
    g = cfg_graph_add_block(g, b0);
    g = cfg_graph_add_block(g, b1);
    g = cfg_graph_add_block(g, b2);
    g = cfg_graph_add_block(g, b3);
    return g;
}

pub fn generate_arithmetic_program() -> BytecodeProgram {
    let mut prog: BytecodeProgram = bc_program_new();
    // load_const 10
    prog = bc_program_add(prog, bc_inst_new(1, 10, 0, 0, "load_const"));
    // load_const 25
    prog = bc_program_add(prog, bc_inst_new(1, 25, 0, 0, "load_const"));
    // iadd
    prog = bc_program_add(prog, bc_inst_new(10, 0, 0, 0, "iadd"));
    // halt 0
    prog = bc_program_add(prog, bc_inst_new(255, 0, 0, 0, "halt"));
    return prog;
}
