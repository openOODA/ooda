// # WebAssembly 128-bit SIMD Vector Instruction Encoder
//
// Logline: WebAssembly SIMD128 prefix (0xFD) multi-byte instruction encodings for f32x4, i32x4, i16x8, i8x16 lanes and shuffles.
//
// Setup: Emits two-byte prefixed 0xFD WebAssembly SIMD vector instructions and shuffle masks.
//
// Beats:
//   1. Define WasmSimdOpcode constants and WasmSimdInstruction structure.
//   2. Encode float and integer vector arithmetic operations (add, sub, mul, min, max).
//   3. Encode v128.shuffle 16-lane permutation masks.

import "./wasm_leb128_codec.oo";

pub type WasmSimdInstruction = struct {
    simd_opcode: Int,
    mnemonic: String,
    has_shuffle_mask: Int,
    shuffle_mask: List[Int],
};

// -------------------------------------------------------------------
// SIMD Opcode Constants (0xFD sub-opcodes)
// -------------------------------------------------------------------

pub fn simd_v128_const() -> Int { return 12; }
pub fn simd_v128_shuffle() -> Int { return 13; }
pub fn simd_i8x16_add() -> Int { return 110; }
pub fn simd_i8x16_sub() -> Int { return 113; }
pub fn simd_i16x8_add() -> Int { return 126; }
pub fn simd_i16x8_sub() -> Int { return 129; }
pub fn simd_i16x8_mul() -> Int { return 133; }
pub fn simd_i32x4_add() -> Int { return 142; }
pub fn simd_i32x4_sub() -> Int { return 145; }
pub fn simd_i32x4_mul() -> Int { return 149; }
pub fn simd_i64x2_add() -> Int { return 158; }
pub fn simd_i64x2_sub() -> Int { return 161; }
pub fn simd_f32x4_add() -> Int { return 228; }
pub fn simd_f32x4_sub() -> Int { return 229; }
pub fn simd_f32x4_mul() -> Int { return 230; }
pub fn simd_f32x4_div() -> Int { return 231; }
pub fn simd_f64x2_add() -> Int { return 240; }
pub fn simd_f64x2_sub() -> Int { return 241; }
pub fn simd_f64x2_mul() -> Int { return 242; }
pub fn simd_f64x2_div() -> Int { return 243; }

// -------------------------------------------------------------------
// Constructors & Encoders
// -------------------------------------------------------------------

pub fn wasm_simd_inst_new(opcode: Int, mnem: String) -> WasmSimdInstruction {
    let empty_mask: List[Int] = list_new();
    return WasmSimdInstruction {
        simd_opcode: opcode,
        mnemonic: mnem,
        has_shuffle_mask: 0,
        shuffle_mask: empty_mask,
    };
}

pub fn wasm_simd_shuffle_new(mask: List[Int]) -> WasmSimdInstruction {
    return WasmSimdInstruction {
        simd_opcode: 13,
        mnemonic: "v128.shuffle",
        has_shuffle_mask: 1,
        shuffle_mask: mask,
    };
}

pub fn encode_simd_instruction(inst: WasmSimdInstruction) -> List[Int] {
    let mut bytes: List[Int] = list_new();
    
    // SIMD Prefix: 0xFD
    bytes = list_push(bytes, 253);
    
    // Sub-opcode encoded as unsigned LEB128
    let op_leb: List[Int] = encode_u32_leb128((inst).simd_opcode);
    let n_op: Int = list_len(op_leb);
    let mut i: Int = 0;
    while i < n_op {
        bytes = list_push(bytes, list_get(op_leb, i));
        i = i + 1;
    }
    
    // If shuffle, append 16 immediate lane bytes
    if (inst).has_shuffle_mask == 1 {
        let mut lane: Int = 0;
        while lane < 16 {
            let mask_val: Int = list_get((inst).shuffle_mask, lane);
            bytes = list_push(bytes, mask_val & 31);
            lane = lane + 1;
        }
    }
    
    return bytes;
}
