// # SSA Global Value Numbering Engine
//
// Logline: Global Value Numbering (GVN), congruence class partitioning, and expression hash-consing for SSA IR.
//
// Setup: Maps congruent arithmetic and memory operations to canonical value numbers to eliminate redundant calculations.
//
// Beats:
//   1. Represent canonical expression keys and value number bindings.
//   2. Compute value hashes and look up existing congruence classes.
//   3. Replace redundant expressions with canonical value numbers.

pub type GvnExpression = struct {
    opcode: Int,
    lhs_val: Int,
    rhs_val: Int,
    extra_imm: Int,
};

pub type GvnEntry = struct {
    expr: GvnExpression,
    val_number: Int,
    canonical_var: String,
};

pub type GvnTable = struct {
    entries: List[GvnEntry],
    entry_count: Int,
    next_value_number: Int,
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn gvn_expr_new(opcode: Int, lhs: Int, rhs: Int, imm: Int) -> GvnExpression {
    // Commutative canonicalization (smaller operand first for commutative ops like ADD=1, MUL=3, AND=7, OR=8, XOR=9)
    let mut l: Int = lhs;
    let mut r: Int = rhs;
    if opcode == 1 || opcode == 3 || opcode == 7 || opcode == 8 || opcode == 9 {
        if l > r {
            let tmp: Int = l;
            l = r;
            r = tmp;
        }
    }
    return GvnExpression {
        opcode: opcode,
        lhs_val: l,
        rhs_val: r,
        extra_imm: imm,
    };
}

pub fn gvn_entry_new(expr: GvnExpression, val_num: Int, var_name: String) -> GvnEntry {
    return GvnEntry {
        expr: expr,
        val_number: val_num,
        canonical_var: var_name,
    };
}

pub fn gvn_table_new() -> GvnTable {
    let empty_entries: List[GvnEntry] = list_new();
    return GvnTable {
        entries: empty_entries,
        entry_count: 0,
        next_value_number: 1,
    };
}

// -------------------------------------------------------------------
// GVN Lookup & Insertion
// -------------------------------------------------------------------

pub fn gvn_expr_equal(a: GvnExpression, b: GvnExpression) -> Bool {
    if (a).opcode == (b).opcode && (a).lhs_val == (b).lhs_val && (a).rhs_val == (b).rhs_val && (a).extra_imm == (b).extra_imm {
        return true;
    }
    return false;
}

pub fn gvn_lookup(table: GvnTable, expr: GvnExpression) -> Int {
    let mut i: Int = 0;
    let limit: Int = (table).entry_count;
    while i < limit {
        let entry: GvnEntry = list_get((table).entries, i);
        if gvn_expr_equal((entry).expr, expr) {
            return (entry).val_number;
        }
        i = i + 1;
    }
    return 0;
}

pub fn gvn_get_canonical_var(table: GvnTable, val_number: Int) -> String {
    let mut i: Int = 0;
    let limit: Int = (table).entry_count;
    while i < limit {
        let entry: GvnEntry = list_get((table).entries, i);
        if (entry).val_number == val_number {
            return (entry).canonical_var;
        }
        i = i + 1;
    }
    return "";
}

pub fn gvn_lookup_or_insert(mut table: GvnTable, expr: GvnExpression, var_name: String) -> GvnTable {
    let existing_vn: Int = gvn_lookup(table, expr);
    if existing_vn == 0 {
        let new_vn: Int = (table).next_value_number;
        let entry: GvnEntry = gvn_entry_new(expr, new_vn, var_name);
        let mut ents: List[GvnEntry] = (table).entries;
        ents = list_push(ents, entry);
        table.entries = ents;
        table.entry_count = (table).entry_count + 1;
        table.next_value_number = new_vn + 1;
    }
    return table;
}
