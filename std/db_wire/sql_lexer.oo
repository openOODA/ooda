// # ANSI SQL / SQLite lexer
//
// Logline: Tokenizes SQL into keywords SELECT INSERT UPDATE DELETE WHERE JOIN, identifiers, string literals, and operators.
//
// Setup: Pure. Source is List[Int] ASCII bytes. No allocation beyond the token list.
//
// Beats:
//   1. Skip spaces.
//   2. Match a keyword or an identifier run of letters.
//   3. Scan a single-quoted string or a one-byte operator.
//   4. Emit (kind, start, length) triples; refuse an unknown byte.

pub fn sql_lexer_kw_select() -> Int { return 1; }
pub fn sql_lexer_kw_insert() -> Int { return 2; }
pub fn sql_lexer_kw_update() -> Int { return 3; }
pub fn sql_lexer_kw_delete() -> Int { return 4; }
pub fn sql_lexer_kw_where() -> Int { return 5; }
pub fn sql_lexer_kw_join() -> Int { return 6; }
pub fn sql_lexer_ident() -> Int { return 10; }
pub fn sql_lexer_string() -> Int { return 11; }
pub fn sql_lexer_eq() -> Int { return 20; }
pub fn sql_lexer_lt() -> Int { return 21; }
pub fn sql_lexer_gt() -> Int { return 22; }
pub fn sql_lexer_star() -> Int { return 23; }
pub fn sql_lexer_comma() -> Int { return 24; }

fn sql_up(c: Int) -> Int {
    if c >= 97 {
        if c <= 122 { return c - 32; }
    }
    return c;
}

fn sql_letter(c: Int) -> Bool {
    if c >= 65 {
        if c <= 90 { return true; }
    }
    if c >= 97 {
        if c <= 122 { return true; }
    }
    if c == 95 { return true; }
    return false;
}

fn sql_digit(c: Int) -> Bool {
    if c >= 48 {
        if c <= 57 { return true; }
    }
    return false;
}

fn sql_is_kw(src: List[Int], i: Int, w: List[Int]) -> Bool {
    let n: Int = list_len(w);
    if i + n > list_len(src) { return false; }
    let mut k: Int = 0;
    while k < n {
        if sql_up(list_get(src, i + k)) != list_get(w, k) { return false; }
        k = k + 1;
    }
    if i + n < list_len(src) {
        let c: Int = list_get(src, i + n);
        if sql_letter(c) { return false; }
        if sql_digit(c) { return false; }
    }
    return true;
}

fn sql_kw(lit: String) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < bytes_len(lit) {
        o = list_push(o, byte_at(lit, i));
        i = i + 1;
    }
    return o;
}

pub fn sql_lexer_scan(src: List[Int]) -> Result[List[Int], String] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    let n: Int = list_len(src);
    let sel: List[Int] = sql_kw("SELECT");
    let ins: List[Int] = sql_kw("INSERT");
    let upd: List[Int] = sql_kw("UPDATE");
    let del: List[Int] = sql_kw("DELETE");
    let wh: List[Int] = sql_kw("WHERE");
    let jn: List[Int] = sql_kw("JOIN");
    while i < n {
        let c: Int = list_get(src, i);
        if c == 32 {
            i = i + 1;
        } else {
            if c == 9 {
                i = i + 1;
            } else {
                if c == 10 {
                    i = i + 1;
                } else {
                    if sql_is_kw(src, i, sel) {
                        out = list_push(out, sql_lexer_kw_select());
                        out = list_push(out, i);
                        out = list_push(out, 6);
                        i = i + 6;
                    } else {
                        if sql_is_kw(src, i, ins) {
                            out = list_push(out, sql_lexer_kw_insert());
                            out = list_push(out, i);
                            out = list_push(out, 6);
                            i = i + 6;
                        } else {
                            if sql_is_kw(src, i, upd) {
                                out = list_push(out, sql_lexer_kw_update());
                                out = list_push(out, i);
                                out = list_push(out, 6);
                                i = i + 6;
                            } else {
                                if sql_is_kw(src, i, del) {
                                    out = list_push(out, sql_lexer_kw_delete());
                                    out = list_push(out, i);
                                    out = list_push(out, 6);
                                    i = i + 6;
                                } else {
                                    if sql_is_kw(src, i, wh) {
                                        out = list_push(out, sql_lexer_kw_where());
                                        out = list_push(out, i);
                                        out = list_push(out, 5);
                                        i = i + 5;
                                    } else {
                                        if sql_is_kw(src, i, jn) {
                                            out = list_push(out, sql_lexer_kw_join());
                                            out = list_push(out, i);
                                            out = list_push(out, 4);
                                            i = i + 4;
                                        } else {
                                            if sql_letter(c) {
                                                let s0: Int = i;
                                                i = i + 1;
                                                while i < n {
                                                    let d: Int = list_get(src, i);
                                                    if sql_letter(d) {
                                                        i = i + 1;
                                                    } else {
                                                        if sql_digit(d) { i = i + 1; } else { break; }
                                                    }
                                                }
                                                out = list_push(out, sql_lexer_ident());
                                                out = list_push(out, s0);
                                                out = list_push(out, i - s0);
                                            } else {
                                                if c == 39 {
                                                    let s1: Int = i;
                                                    i = i + 1;
                                                    while i < n {
                                                        if list_get(src, i) == 39 { break; }
                                                        i = i + 1;
                                                    }
                                                    if i >= n { return Err("sql string"); }
                                                    i = i + 1;
                                                    out = list_push(out, sql_lexer_string());
                                                    out = list_push(out, s1);
                                                    out = list_push(out, i - s1);
                                                } else {
                                                    let mut knd: Int = 0;
                                                    if c == 61 { knd = sql_lexer_eq(); }
                                                    if c == 60 { knd = sql_lexer_lt(); }
                                                    if c == 62 { knd = sql_lexer_gt(); }
                                                    if c == 42 { knd = sql_lexer_star(); }
                                                    if c == 44 { knd = sql_lexer_comma(); }
                                                    if knd == 0 { return Err("sql token"); }
                                                    out = list_push(out, knd);
                                                    out = list_push(out, i);
                                                    out = list_push(out, 1);
                                                    i = i + 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return Ok(out);
}
