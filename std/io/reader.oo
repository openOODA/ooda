// # Standard I/O Reader Combinators
//
// Logline: Generic reader abstraction providing read_exact, read_to_end, and take combinators.
//
// Setup: Pure reader abstraction and composable stream transforms.
//
// Beats:
//   1. Define Reader descriptor for buffered string sources.
//   2. Read exact number of characters from reader source.
//   3. Read all remaining content until end-of-stream.
//   4. Limit reader output with take combinator.
//
// residual: in-memory string stream combinators without ambient I/O

type Reader = struct {
    source: String,
    position: Int,
    limit: Int
};

// Create a Reader from a string source.
pub fn reader_from_string(source: String) -> Reader {
    let slen: Int = chars_len(source);
    return Reader {
        source: source,
        position: 0,
        limit: slen
    };
}

// Create a Reader with an explicit upper bound limit.
pub fn reader_with_limit(source: String, limit: Int) -> Reader {
    let slen: Int = chars_len(source);
    let mut lim: Int = limit;
    if lim > slen || lim < 0 {
        lim = slen;
    }
    return Reader {
        source: source,
        position: 0,
        limit: lim
    };
}

// Read up to size characters from current position.
pub fn reader_read_chunk(reader: Reader, size: Int) -> Result[String, String] {
    let cur_src: String = reader.source;
    let cur_pos: Int = reader.position;
    let cur_lim: Int = reader.limit;
    if cur_pos >= cur_lim {
        return Err("EOF");
    }
    let mut take_sz: Int = size;
    if take_sz <= 0 {
        take_sz = cur_lim - cur_pos;
    }
    let mut end: Int = cur_pos + take_sz;
    if end > cur_lim {
        end = cur_lim;
    }
    let chunk: String = str_slice(cur_src, cur_pos, end);
    return Ok(chunk);
}

// Read exactly exact_len characters; fail if fewer remain.
pub fn reader_read_exact(reader: Reader, exact_len: Int) -> Result[String, String] {
    let cur_src: String = reader.source;
    let cur_pos: Int = reader.position;
    let cur_lim: Int = reader.limit;
    let available: Int = cur_lim - cur_pos;
    if exact_len > available {
        return Err("UNEXPECTED_EOF");
    }
    let end: Int = cur_pos + exact_len;
    let chunk: String = str_slice(cur_src, cur_pos, end);
    return Ok(chunk);
}

// Read all remaining characters to end of stream.
pub fn reader_read_to_end(reader: Reader) -> Result[String, String] {
    let cur_src: String = reader.source;
    let cur_pos: Int = reader.position;
    let cur_lim: Int = reader.limit;
    if cur_pos >= cur_lim {
        return Ok("");
    }
    let chunk: String = str_slice(cur_src, cur_pos, cur_lim);
    return Ok(chunk);
}

// Advance reader position.
pub fn reader_advance(reader: Reader, count: Int) -> Reader {
    let cur_pos: Int = reader.position;
    let cur_lim: Int = reader.limit;
    let mut new_pos: Int = cur_pos + count;
    if new_pos > cur_lim {
        new_pos = cur_lim;
    }
    return Reader {
        source: reader.source,
        position: new_pos,
        limit: cur_lim
    };
}

// True if reader position has reached its limit.
pub fn reader_is_eof(reader: Reader) -> Bool {
    let cur_pos: Int = reader.position;
    let cur_lim: Int = reader.limit;
    return cur_pos >= cur_lim;
}

// Return current reader character offset.
pub fn reader_position(reader: Reader) -> Int {
    return reader.position;
}
