// # Stream Accumulative Fold Module
//
// Logline: Stream fold / reduce operations: string joining with delimiter, integer sum, and integer count.
//
// Setup: Pure functional stream reduction accumulator.
//
// Beats:
//   1. Fold string list into single joined string with separator delimiter.
//   2. Fold integer list into arithmetic sum.
//   3. Fold integer list into min/max bounds.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

pub fn stream_fold_join(source: List[String], delimiter: String) -> String {
    let n: Int = list_len(source);
    if n == 0 {
        return "";
    }
    let mut out: String = list_get(source, 0);
    let mut i: Int = 1;
    while i < n {
        let item: String = list_get(source, i);
        out = out + delimiter + item;
        i = i + 1;
    }
    return out;
}

pub fn stream_fold_sum_int(source: List[Int]) -> Int {
    let n: Int = list_len(source);
    let mut total: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let val: Int = list_get(source, i);
        total = total + val;
        i = i + 1;
    }
    return total;
}
