// # Stream Splitter (Tee) Combinator Module
//
// Logline: Stream splitter replicating each item from a source stream into two identical independent output streams.
//
// Setup: Pure data stream branching combinator.
//
// Beats:
//   1. Construct StreamTee state from two target collection buffers.
//   2. Forward input items into both branched streams simultaneously.
//   3. Query branched stream lengths and integrity.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware zero-copy tee lowers via vmsplice / tee syscalls.

import "std/core/list.oo";

type StreamTee = struct {
    branch_a: List[String],
    branch_b: List[String]
};

pub fn stream_tee_new() -> StreamTee {
    let a: List[String] = list_new();
    let b: List[String] = list_new();
    return StreamTee { branch_a: a, branch_b: b };
}

pub fn stream_tee_push(tee: StreamTee, item: String) -> StreamTee {
    let new_a: List[String] = list_push(tee.branch_a, item);
    let new_b: List[String] = list_push(tee.branch_b, item);
    return StreamTee { branch_a: new_a, branch_b: new_b };
}

pub fn stream_tee_len_a(tee: StreamTee) -> Int {
    return list_len(tee.branch_a);
}

pub fn stream_tee_len_b(tee: StreamTee) -> Int {
    return list_len(tee.branch_b);
}
