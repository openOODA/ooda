// # Stream Prefix Take Limiter Module
//
// Logline: Stream prefix truncator taking at most N elements from a stream and terminating.
//
// Setup: Pure stream truncation combinator. Destubbed to List[Int] (no Result[struct]).
//
// Beats:
//   1. Construct StreamTake with maximum element limit N.
//   2. Yield next item while element count is below N.
//   3. Terminate with EOF once N elements have been consumed.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type StreamTake = struct {
    source: List[Int],
    limit: Int,
    current: Int
};

pub fn stream_take_new(source: List[Int], limit: Int) -> StreamTake {
    return StreamTake {
        source: source,
        limit: limit,
        current: 0
    };
}

pub fn stream_take_has_next(st: StreamTake) -> Bool {
    let cur: Int = st.current;
    let lim: Int = st.limit;
    let total: Int = list_len(st.source);
    return cur < lim && cur < total;
}

pub fn stream_take_peek(st: StreamTake) -> Int {
    if stream_take_has_next(st) == false {
        return 0;
    }
    let cur: Int = st.current;
    return list_get(st.source, cur);
}

pub fn stream_take_next(st: StreamTake) -> StreamTake {
    let cur: Int = st.current;
    let lim: Int = st.limit;
    let total: Int = list_len(st.source);
    if cur >= lim || cur >= total {
        return st;
    }
    return StreamTake {
        source: st.source,
        limit: lim,
        current: cur + 1
    };
}
