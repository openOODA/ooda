// # In-Memory Bidirectional Stream Buffer
//
// Logline: Bidirectional read-write memory stream supporting dynamic append, rewind, and truncation.
//
// Setup: Pure in-memory streaming buffer with dual read/write pointers.
//
// Beats:
//   1. Construct MemStream initialized with optional seed content.
//   2. Append string data to write head.
//   3. Read data from read head without affecting write pointer.
//   4. Rewind read head to start or seek to specific offset.
//
// residual: purely in-memory string accumulation and dual-offset indexing

type MemStream = struct {
    buffer: String,
    read_pos: Int,
    write_pos: Int
};

// Create an empty MemStream.
pub fn mem_stream_new() -> MemStream {
    return MemStream {
        buffer: "",
        read_pos: 0,
        write_pos: 0
    };
}

// Create a MemStream pre-populated with seed content.
pub fn mem_stream_from_string(seed: String) -> MemStream {
    let slen: Int = chars_len(seed);
    return MemStream {
        buffer: seed,
        read_pos: 0,
        write_pos: slen
    };
}

// Append data to write head of stream.
pub fn mem_stream_write(stream: MemStream, data: String) -> MemStream {
    let dlen: Int = chars_len(data);
    if dlen == 0 {
        return stream;
    }
    let cur_buf: String = stream.buffer;
    let cur_wp: Int = stream.write_pos;
    return MemStream {
        buffer: cur_buf + data,
        read_pos: stream.read_pos,
        write_pos: cur_wp + dlen
    };
}

// Read up to max_bytes from read head without advancing.
pub fn mem_stream_read(stream: MemStream, max_bytes: Int) -> Result[String, String] {
    let cur_buf: String = stream.buffer;
    let blen: Int = chars_len(cur_buf);
    let cur_rp: Int = stream.read_pos;
    if cur_rp >= blen {
        return Err("EOF");
    }
    let mut limit: Int = max_bytes;
    if limit <= 0 || cur_rp + limit > blen {
        limit = blen - cur_rp;
    }
    let chunk: String = str_slice(cur_buf, cur_rp, cur_rp + limit);
    return Ok(chunk);
}

// Advance read pointer by count characters.
pub fn mem_stream_advance_read(stream: MemStream, count: Int) -> MemStream {
    let cur_buf: String = stream.buffer;
    let blen: Int = chars_len(cur_buf);
    let cur_rp: Int = stream.read_pos;
    let mut new_rp: Int = cur_rp + count;
    if new_rp > blen {
        new_rp = blen;
    }
    if new_rp < 0 {
        new_rp = 0;
    }
    return MemStream {
        buffer: cur_buf,
        read_pos: new_rp,
        write_pos: stream.write_pos
    };
}

// Rewind read pointer back to 0.
pub fn mem_stream_rewind(stream: MemStream) -> MemStream {
    return MemStream {
        buffer: stream.buffer,
        read_pos: 0,
        write_pos: stream.write_pos
    };
}

// Seek read pointer to a specific target offset.
pub fn mem_stream_seek_read(stream: MemStream, target_pos: Int) -> MemStream {
    let cur_buf: String = stream.buffer;
    let blen: Int = chars_len(cur_buf);
    if target_pos < 0 || target_pos > blen {
        return stream;
    }
    return MemStream {
        buffer: cur_buf,
        read_pos: target_pos,
        write_pos: stream.write_pos
    };
}

// Extract full underlying buffer content.
pub fn mem_stream_to_string(stream: MemStream) -> String {
    return stream.buffer;
}

// Return current length of accumulated stream.
pub fn mem_stream_len(stream: MemStream) -> Int {
    let cur_buf: String = stream.buffer;
    return chars_len(cur_buf);
}
