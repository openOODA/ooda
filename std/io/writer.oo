// # Standard I/O Writer Interface and Combinators
//
// Logline: Accumulating writer abstraction with line buffering, byte accounting, and flush hooks.
//
// Setup: Pure writer accumulator for formatted stream output.
//
// Beats:
//   1. Initialize Writer descriptor with accumulator and write statistics.
//   2. Write string chunk and increment total bytes written.
//   3. Write formatted line with trailing newline character.
//   4. Reset or harvest accumulated writer output.
//
// residual: purely in-memory string output aggregation

type Writer = struct {
    buffer: String,
    bytes_written: Int,
    chunk_count: Int
};

// Create an empty Writer accumulator.
pub fn writer_new() -> Writer {
    return Writer {
        buffer: "",
        bytes_written: 0,
        chunk_count: 0
    };
}

// Write string data into accumulator.
pub fn writer_write(writer: Writer, chunk: String) -> Writer {
    let clen: Int = chars_len(chunk);
    if clen == 0 {
        return writer;
    }
    let cur_buf: String = writer.buffer;
    let cur_bw: Int = writer.bytes_written;
    let cur_cc: Int = writer.chunk_count;
    return Writer {
        buffer: cur_buf + chunk,
        bytes_written: cur_bw + clen,
        chunk_count: cur_cc + 1
    };
}

// Write line terminated with newline.
pub fn writer_write_line(writer: Writer, line: String) -> Writer {
    let w1: Writer = writer_write(writer, line);
    return writer_write(w1, "\n");
}

// Write string representation of integer.
pub fn writer_write_int(writer: Writer, val: Int) -> Writer {
    let s: String = val.to_string();
    return writer_write(writer, s);
}

// Harvest accumulated buffer string.
pub fn writer_flush(writer: Writer) -> String {
    return writer.buffer;
}

// Reset buffer string while preserving write counters.
pub fn writer_clear(writer: Writer) -> Writer {
    return Writer {
        buffer: "",
        bytes_written: writer.bytes_written,
        chunk_count: writer.chunk_count
    };
}

// Return total bytes written into writer.
pub fn writer_bytes_written(writer: Writer) -> Int {
    return writer.bytes_written;
}

// Return count of distinct write calls made.
pub fn writer_chunk_count(writer: Writer) -> Int {
    return writer.chunk_count;
}
