// # Stream Prefix Skip Offset Module
//
// Logline: Stream prefix skipper bypassing the first N elements before streaming remaining items.
//
// Setup: Pure stream offset combinator.
//
// Beats:
//   1. Construct StreamSkip with elements to skip N.
//   2. Fast-forward cursor past first N elements.
//   3. Stream remaining elements.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type StreamSkip = struct {
    source: List[String],
    skip_count: Int,
    cursor: Int
};

pub fn stream_skip_new(source: List[String], skip_count: Int) -> StreamSkip {
    let total: Int = list_len(source);
    let mut start_pos: Int = skip_count;
    if start_pos > total { start_pos = total; }
    if start_pos < 0 { start_pos = 0; }
    return StreamSkip {
        source: source,
        skip_count: skip_count,
        cursor: start_pos
    };
}

pub fn stream_skip_has_next(ss: StreamSkip) -> Bool {
    let cur: Int = ss.cursor;
    let total: Int = list_len(ss.source);
    return cur < total;
}

pub fn stream_skip_next(ss: StreamSkip) -> Result[StreamSkip, String] {
    let cur: Int = ss.cursor;
    let total: Int = list_len(ss.source);
    if cur >= total {
        return Err("END_OF_STREAM");
    }
    return Ok(StreamSkip {
        source: ss.source,
        skip_count: ss.skip_count,
        cursor: cur + 1
    });
}
