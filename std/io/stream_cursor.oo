// # Seekable Stream Cursor Module
//
// Logline: In-memory seekable cursor supporting relative seek, absolute seek, rewind, and slice reading.
//
// Setup: Pure in-memory seekable buffer stream.
//
// Beats:
//   1. Construct StreamCursor over byte/int buffer with initial position 0.
//   2. Seek to absolute offset or relative displacement.
//   3. Rewind to beginning of stream.
//   4. Query current position and remaining bytes.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type StreamCursor = struct {
    data: List[Int],
    position: Int
};

pub fn stream_cursor_new(data: List[Int]) -> StreamCursor {
    return StreamCursor {
        data: data,
        position: 0
    };
}

pub fn stream_cursor_seek(c: StreamCursor, offset: Int) -> Result[StreamCursor, String] {
    let n: Int = list_len(c.data);
    if offset < 0 || offset > n {
        return Err("SEEK_OUT_OF_BOUNDS");
    }
    return Ok(StreamCursor {
        data: c.data,
        position: offset
    });
}

pub fn stream_cursor_rewind(c: StreamCursor) -> StreamCursor {
    return StreamCursor {
        data: c.data,
        position: 0
    };
}

pub fn stream_cursor_remaining(c: StreamCursor) -> Int {
    let n: Int = list_len(c.data);
    let p: Int = c.position;
    if p >= n { return 0; }
    return n - p;
}
