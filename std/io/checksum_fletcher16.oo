// # Fletcher-16 Checksum Algorithm Module
//
// Logline: Fletcher-16 checksum generating 16-bit error-checking redundancy codes.
//
// Setup: Pure algorithm computing sum1 = (sum1 + D) % 255, sum2 = (sum2 + sum1) % 255.
//
// Beats:
//   1. Construct Fletcher16 state with sum1 = 0, sum2 = 0.
//   2. Update checksum with byte values modulo 255.
//   3. Compute combined 16-bit checksum word ((sum2 << 8) | sum1).
//   4. Verify checksum against incoming data stream.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type Fletcher16 = struct {
    sum1: Int,
    sum2: Int
};

pub fn fletcher16_new() -> Fletcher16 {
    return Fletcher16 { sum1: 0, sum2: 0 };
}

pub fn fletcher16_update_byte(f: Fletcher16, byte_val: Int) -> Fletcher16 {
    let b: Int = byte_val & 255;
    let cur_s1: Int = f.sum1;
    let new_s1: Int = (cur_s1 + b) % 255;
    let cur_s2: Int = f.sum2;
    let new_s2: Int = (cur_s2 + new_s1) % 255;
    return Fletcher16 { sum1: new_s1, sum2: new_s2 };
}

pub fn fletcher16_update(f: Fletcher16, bytes: List[Int]) -> Fletcher16 {
    let n: Int = list_len(bytes);
    let mut cur: Fletcher16 = f;
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(bytes, i);
        cur = fletcher16_update_byte(cur, b);
        i = i + 1;
    }
    return cur;
}

pub fn fletcher16_digest(f: Fletcher16) -> Int {
    let cur_s1: Int = f.sum1;
    let cur_s2: Int = f.sum2;
    return (cur_s2 * 256) | cur_s1;
}
