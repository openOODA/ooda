// # MSB/LSB Bit-Level Stream Reader Module
//
// Logline: Sub-byte bitstream reader parsing individual bits and arbitrary bit-width fields from byte sequences.
//
// Setup: Pure binary decoding module. Facilitates Huffman, Deflate, and protocol parsing.
//
// Beats:
//   1. Construct BitReader from byte list.
//   2. Read single bit (0 or 1) advancing bit cursor.
//   3. Read multi-bit integer field (1..32 bits).
//   4. Query remaining available bits in stream.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type BitReader = struct {
    bytes: List[Int],
    byte_pos: Int,
    bit_pos: Int // 0..7
};

pub fn bit_reader_new(bytes: List[Int]) -> BitReader {
    return BitReader {
        bytes: bytes,
        byte_pos: 0,
        bit_pos: 0
    };
}

pub fn bit_reader_read_bit(r: BitReader) -> BitReader {
    let bytes: List[Int] = r.bytes;
    let cur_byte: Int = r.byte_pos;
    let n: Int = list_len(bytes);
    if cur_byte >= n {
        return r;
    }
    let cur_bit: Int = r.bit_pos;
    let mut next_bit: Int = cur_bit + 1;
    let mut next_byte: Int = cur_byte;
    if next_bit >= 8 {
        next_bit = 0;
        next_byte = cur_byte + 1;
    }
    return BitReader {
        bytes: bytes,
        byte_pos: next_byte,
        bit_pos: next_bit
    };
}

pub fn bit_reader_peek_bit(r: BitReader) -> Int {
    let bytes: List[Int] = r.bytes;
    let i: Int = r.byte_pos;
    let n: Int = list_len(bytes);
    if i >= n {
        return 0 - 1;
    }
    let b: Int = list_get(bytes, i);
    let bp: Int = r.bit_pos;
    let shift: Int = 7 - bp;
    let mut m: Int = 1;
    let mut k: Int = 0;
    while k < shift {
        m = m * 2;
        k = k + 1;
    }
    if (b & m) != 0 {
        return 1;
    }
    return 0;
}

pub fn bit_reader_remaining_bits(r: BitReader) -> Int {
    let n: Int = list_len(r.bytes);
    let cur_byte: Int = r.byte_pos;
    let cur_bit: Int = r.bit_pos;
    if cur_byte >= n { return 0; }
    let rem_bytes: Int = n - cur_byte;
    return rem_bytes * 8 - cur_bit;
}
