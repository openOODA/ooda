// # Chunked Transfer Encoding Stream
//
// Logline: HTTP/1.1 style chunked framing encoder and decoder for unbounded data streams.
//
// Setup: Pure chunked framing module: hex chunk size headers and CRLF terminators.
//
// Beats:
//   1. Encode payload chunk into hex-length-prefixed frame.
//   2. Encode final zero-length terminal chunk.
//   3. Decode chunked stream into contiguous payload string.
//   4. Validate chunk headers and detect EOF frames.
//
// residual: purely in-memory HTTP/1.1 chunked framing without network sockets

type ChunkedDecoder = struct {
    raw_input: String,
    cursor: Int,
    is_done: Bool,
    total_decoded: Int
};

// Convert integer to hex string.
pub fn chunked_int_to_hex(val: Int) -> String {
    if val == 0 {
        return "0";
    }
    let digits: String = "0123456789abcdef";
    let mut num: Int = val;
    let mut out: String = "";
    while num > 0 {
        let rem: Int = num % 16;
        let c: String = char_at(digits, rem);
        out = c + out;
        num = num / 16;
    }
    return out;
}

// Convert hex string to integer.
pub fn chunked_hex_to_int(hex_str: String) -> Int {
    let n: Int = chars_len(hex_str);
    let mut res: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(hex_str, i);
        let mut d: Int = 0 - 1;
        if c == "0" { d = 0; }
        if c == "1" { d = 1; }
        if c == "2" { d = 2; }
        if c == "3" { d = 3; }
        if c == "4" { d = 4; }
        if c == "5" { d = 5; }
        if c == "6" { d = 6; }
        if c == "7" { d = 7; }
        if c == "8" { d = 8; }
        if c == "9" { d = 9; }
        if c == "a" || c == "A" { d = 10; }
        if c == "b" || c == "B" { d = 11; }
        if c == "c" || c == "C" { d = 12; }
        if c == "d" || c == "D" { d = 13; }
        if c == "e" || c == "E" { d = 14; }
        if c == "f" || c == "F" { d = 15; }
        if d >= 0 {
            res = res * 16 + d;
        }
        i = i + 1;
    }
    return res;
}

// Encode payload chunk into hex-length + CRLF + payload + CRLF.
pub fn chunked_encode_chunk(payload: String) -> String {
    let n: Int = chars_len(payload);
    let h: String = chunked_int_to_hex(n);
    return h + "\r\n" + payload + "\r\n";
}

// Encode terminal 0\r\n\r\n frame.
pub fn chunked_encode_final() -> String {
    return "0\r\n\r\n";
}

// Construct a new ChunkedDecoder wrapping raw chunked stream.
pub fn chunked_decoder_new(raw: String) -> ChunkedDecoder {
    return ChunkedDecoder {
        raw_input: raw,
        cursor: 0,
        is_done: false,
        total_decoded: 0
    };
}

// Decode next chunk payload from stream.
pub fn chunked_decode_next(decoder: ChunkedDecoder) -> Result[String, String] {
    let done: Bool = decoder.is_done;
    if done {
        return Ok("");
    }
    let raw: String = decoder.raw_input;
    let n: Int = chars_len(raw);
    let cur: Int = decoder.cursor;
    if cur >= n {
        return Ok("");
    }

    // Find CRLF or LF after chunk size
    let mut header_end: Int = 0 - 1;
    let mut p: Int = cur;
    while p < n {
        let ch: String = char_at(raw, p);
        if ch == "\n" {
            header_end = p;
            p = n;
        } else {
            p = p + 1;
        }
    }
    if header_end < 0 {
        return Err("INCOMPLETE_CHUNK_HEADER");
    }

    let mut hex_part: String = str_slice(raw, cur, header_end);
    if str_ends_with(hex_part, "\r") {
        let hlen: Int = chars_len(hex_part);
        hex_part = str_slice(hex_part, 0, hlen - 1);
    }

    let chunk_size: Int = chunked_hex_to_int(hex_part);
    if chunk_size == 0 {
        return Ok("");
    }

    let payload_start: Int = header_end + 1;
    let payload_end: Int = payload_start + chunk_size;
    if payload_end > n {
        return Err("INCOMPLETE_CHUNK_DATA");
    }

    let payload: String = str_slice(raw, payload_start, payload_end);
    return Ok(payload);
}

// Advance decoder position after successfully consuming chunk.
pub fn chunked_advance(
    decoder: ChunkedDecoder,
    chunk_len: Int,
    header_len: Int
) -> ChunkedDecoder {
    let cur: Int = decoder.cursor;
    let mut step: Int = header_len + chunk_len;
    // Skip trailing CRLF
    let raw: String = decoder.raw_input;
    let n: Int = chars_len(raw);
    let pos_after: Int = cur + step;
    let mut final_pos: Int = pos_after;
    if final_pos < n && char_at(raw, final_pos) == "\r" {
        final_pos = final_pos + 1;
    }
    if final_pos < n && char_at(raw, final_pos) == "\n" {
        final_pos = final_pos + 1;
    }
    let mut done: Bool = false;
    if chunk_len == 0 || final_pos >= n {
        done = true;
    }
    let td: Int = decoder.total_decoded;
    return ChunkedDecoder {
        raw_input: decoder.raw_input,
        cursor: final_pos,
        is_done: done,
        total_decoded: td + chunk_len
    };
}

// True if chunked decoding completed.
pub fn chunked_decoder_is_done(decoder: ChunkedDecoder) -> Bool {
    return decoder.is_done;
}
