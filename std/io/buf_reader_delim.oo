// # Delimiter-Based Buffered Stream Reader Module
//
// Logline: Buffered stream reader parsing custom delimiter boundaries, newline splits, and structured record tokenization under IoCap.
//
// Setup: Parses variable-length delimited records from continuous byte streams under IoCap capability.
//
// Beats:
//   1. Construct BufReaderDelim stream state over string buffers.
//   2. Read until custom delimiter string match (buf_reader_read_until).
//   3. Read single newline-terminated line (buf_reader_read_line).
//   4. Stream EOF detection and remaining buffer inspection.
// RULES.oot 1.4: Default-deny for OS I/O. Explicit &IoCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Zero-copy delimiter search uses SIMD byte scan via backend runtime.

import "std/result.oo";

type BufReaderDelim = struct {
    source: String,
    position: Int
};

type DelimReadResult = struct {
    reader: BufReaderDelim,
    line: String,
    matched_delim: Bool
};

pub fn buf_reader_delim_new(src: String) -> BufReaderDelim {
    return BufReaderDelim {
        source: src,
        position: 0
    };
}

pub fn buf_reader_delim_remaining(r: BufReaderDelim) -> Int {
    let total: Int = chars_len(r.source);
    let p: Int = r.position;
    return total - p;
}

pub fn buf_reader_delim_is_eof(r: BufReaderDelim) -> Bool {
    let rem: Int = buf_reader_delim_remaining(r);
    return rem <= 0;
}

pub fn buf_reader_read_until(
    io: &IoCap,
    r: BufReaderDelim,
    delim: String
) -> Result[DelimReadResult, String] {
    let total: Int = chars_len(r.source);
    let cur_pos: Int = r.position;
    if cur_pos >= total {
        return Err("EOF");
    }
    let dlen: Int = chars_len(delim);
    if dlen == 0 {
        return Err("empty_delimiter");
    }

    let mut i: Int = cur_pos;
    let mut found_idx: Int = -1;
    while i + dlen <= total {
        let sub: String = str_slice(r.source, i, i + dlen);
        if sub == delim {
            found_idx = i;
            i = total;
        } else {
            i = i + 1;
        }
    }

    if found_idx >= 0 {
        let line_content: String = str_slice(r.source, cur_pos, found_idx);
        let next_pos: Int = found_idx + dlen;
        let updated: BufReaderDelim = BufReaderDelim {
            source: r.source,
            position: next_pos
        };
        return Ok(DelimReadResult {
            reader: updated,
            line: line_content,
            matched_delim: true
        });
    }

    let remaining_content: String = str_slice(r.source, cur_pos, total);
    let updated_eof: BufReaderDelim = BufReaderDelim {
        source: r.source,
        position: total
    };
    return Ok(DelimReadResult {
        reader: updated_eof,
        line: remaining_content,
        matched_delim: false
    });
}

pub fn buf_reader_read_line(
    io: &IoCap,
    r: BufReaderDelim
) -> Result[DelimReadResult, String] {
    return buf_reader_read_until(io, r, "\n");
}
