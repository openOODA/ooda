// # Stream Predicate Filter Combinator Module
//
// Logline: Stream filter passing only Int elements matching a numeric predicate.
//
// Setup: Pure stream transformation filter. Destubbed List[String] -> List[Int].
//
// Beats:
//   1. Construct StreamFilter over input sequence.
//   2. Filter elements greater than a threshold.
//   3. Filter nonzero elements.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type StreamFilter = struct {
    filtered: List[Int]
};

pub fn stream_filter_gt(source: List[Int], thresh: Int) -> StreamFilter {
    let n: Int = list_len(source);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let item: Int = list_get(source, i);
        if item > thresh {
            out = list_push(out, item);
        }
        i = i + 1;
    }
    return StreamFilter { filtered: out };
}

pub fn stream_filter_nonzero(source: List[Int]) -> StreamFilter {
    let n: Int = list_len(source);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let item: Int = list_get(source, i);
        if item != 0 {
            out = list_push(out, item);
        }
        i = i + 1;
    }
    return StreamFilter { filtered: out };
}

pub fn stream_filter_len(sf: StreamFilter) -> Int {
    return list_len(sf.filtered);
}

pub fn stream_filter_get(sf: StreamFilter, i: Int) -> Int {
    let n: Int = list_len(sf.filtered);
    if i < 0 || i >= n {
        return 0;
    }
    return list_get(sf.filtered, i);
}
