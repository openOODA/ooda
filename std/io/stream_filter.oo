// # Stream Predicate Filter Combinator Module
//
// Logline: Stream filter passing only elements matching a substring or non-empty criteria.
//
// Setup: Pure stream transformation filter.
//
// Beats:
//   1. Construct StreamFilter over input sequence.
//   2. Filter elements containing target substring.
//   3. Filter non-empty elements.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/str.oo";

type StreamFilter = struct {
    filtered: List[String]
};

pub fn stream_filter_containing(source: List[String], needle: String) -> StreamFilter {
    let n: Int = list_len(source);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        let item: String = list_get(source, i);
        if str_contains(item, needle) {
            out = list_push(out, item);
        }
        i = i + 1;
    }
    return StreamFilter { filtered: out };
}

pub fn stream_filter_non_empty(source: List[String]) -> StreamFilter {
    let n: Int = list_len(source);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        let item: String = list_get(source, i);
        if !str_is_empty(item) {
            out = list_push(out, item);
        }
        i = i + 1;
    }
    return StreamFilter { filtered: out };
}

pub fn stream_filter_len(sf: StreamFilter) -> Int {
    return list_len(sf.filtered);
}
