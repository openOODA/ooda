// # Standard I/O Error Taxonomy and Descriptors
//
// Logline: Structured taxonomy of I/O error kinds, codes, messages, and recoverability descriptors.
//
// Setup: Pure error representation mapping errno/system codes to structured I/O errors.
//
// Beats:
//   1. Define IoErrorKind enum/descriptor (NotFound, PermissionDenied, EOF, BrokenPipe, etc.).
//   2. Construct IoError with error kind, context message, and fatal flag.
//   3. Format error to human-readable diagnostic string.
//   4. Check error predicates (is_eof, is_not_found, is_permission_denied).
//
// residual: purely in-memory structured error definitions

type IoError = struct {
    kind: String,
    message: String,
    code: Int,
    is_fatal: Bool
};

// Create a generic IoError descriptor.
pub fn io_error_new(kind: String, message: String, code: Int, is_fatal: Bool) -> IoError {
    return IoError {
        kind: kind,
        message: message,
        code: code,
        is_fatal: is_fatal
    };
}

// Construct NotFound error for missing resource.
pub fn io_error_not_found(path: String) -> IoError {
    return IoError {
        kind: "NotFound",
        message: "Entity not found: " + path,
        code: 2,
        is_fatal: false
    };
}

// Construct PermissionDenied error.
pub fn io_error_permission_denied(op: String) -> IoError {
    return IoError {
        kind: "PermissionDenied",
        message: "Permission denied for operation: " + op,
        code: 13,
        is_fatal: true
    };
}

// Construct EOF error.
pub fn io_error_eof() -> IoError {
    return IoError {
        kind: "UnexpectedEof",
        message: "End of stream reached unexpectedly",
        code: 0,
        is_fatal: false
    };
}

// Construct BrokenPipe error.
pub fn io_error_broken_pipe() -> IoError {
    return IoError {
        kind: "BrokenPipe",
        message: "Pipe channel was closed by peer",
        code: 32,
        is_fatal: true
    };
}

// Construct AlreadyExists error.
pub fn io_error_already_exists(path: String) -> IoError {
    return IoError {
        kind: "AlreadyExists",
        message: "Target path already exists: " + path,
        code: 17,
        is_fatal: false
    };
}

// True if error represents end-of-file condition.
pub fn io_error_is_eof(err: IoError) -> Bool {
    return err.kind == "UnexpectedEof";
}

// True if error represents not-found condition.
pub fn io_error_is_not_found(err: IoError) -> Bool {
    return err.kind == "NotFound";
}

// True if error represents permission denied.
pub fn io_error_is_permission_denied(err: IoError) -> Bool {
    return err.kind == "PermissionDenied";
}

// Format IoError to diagnostic string.
pub fn io_error_to_string(err: IoError) -> String {
    let k: String = err.kind;
    let m: String = err.message;
    let c: Int = err.code;
    let c_str: String = c.to_string();
    return "[" + k + " (code " + c_str + ")] " + m;
}
