// # Fixed-Buffer Stream Wrapper
//
// Logline: Fixed-buffer stream wrapper providing block accumulation, peek, and batch flushes.
//
// Setup: Pure buffer stream wrapper for amortizing small I/O reads and writes.
//
// Beats:
//   1. Initialize BufferStream with designated buffer capacity limit.
//   2. Accumulate incoming data chunks into internal buffer.
//   3. Peek buffered contents without consuming read position.
//   4. Flush accumulated buffer content as unified block.
//
// residual: purely in-memory string accumulation and boundary detection

type BufferStream = struct {
    buffer: String,
    capacity: Int,
    auto_flush_size: Int,
    flush_count: Int
};

// Create a new BufferStream with capacity and auto-flush thresholds.
pub fn buffer_stream_new(capacity: Int, auto_flush_size: Int) -> BufferStream {
    let mut cap: Int = capacity;
    if cap <= 0 {
        cap = 8192;
    }
    let mut af: Int = auto_flush_size;
    if af <= 0 {
        af = cap;
    }
    return BufferStream {
        buffer: "",
        capacity: cap,
        auto_flush_size: af,
        flush_count: 0
    };
}

// Feed a new chunk of data into the buffer stream.
pub fn buffer_stream_feed(stream: BufferStream, chunk: String) -> BufferStream {
    let clen: Int = chars_len(chunk);
    if clen == 0 {
        return stream;
    }
    let cur_b: String = stream.buffer;
    return BufferStream {
        buffer: cur_b + chunk,
        capacity: stream.capacity,
        auto_flush_size: stream.auto_flush_size,
        flush_count: stream.flush_count
    };
}

// True if accumulated buffer meets or exceeds auto_flush_size.
pub fn buffer_stream_needs_flush(stream: BufferStream) -> Bool {
    let cur_b: String = stream.buffer;
    let blen: Int = chars_len(cur_b);
    let af: Int = stream.auto_flush_size;
    return blen >= af;
}

// Extract current buffer content.
pub fn buffer_stream_flush(stream: BufferStream) -> String {
    return stream.buffer;
}

// Reset buffer after flush.
pub fn buffer_stream_clear(stream: BufferStream) -> BufferStream {
    let cur_fc: Int = stream.flush_count;
    return BufferStream {
        buffer: "",
        capacity: stream.capacity,
        auto_flush_size: stream.auto_flush_size,
        flush_count: cur_fc + 1
    };
}

// Inspect current buffered content without modifying state.
pub fn buffer_stream_peek(stream: BufferStream) -> String {
    return stream.buffer;
}

// Return current length of buffered data.
pub fn buffer_stream_len(stream: BufferStream) -> Int {
    let cur_b: String = stream.buffer;
    return chars_len(cur_b);
}

// True if buffer contains no data.
pub fn buffer_stream_is_empty(stream: BufferStream) -> Bool {
    let l: Int = buffer_stream_len(stream);
    return l == 0;
}
