// # Asynchronous Stream Reader Module
//
// Logline: Non-blocking asynchronous stream reading contract, readiness polling, and partial chunk extraction under IoCap.
//
// Setup: Coordinates non-blocking buffered reads and readiness futures under IoCap capability.
//
// Beats:
//   1. Construct AsyncReader stream wrapper around string source.
//   2. Poll read non-blocking byte chunks under IoCap.
//   3. Exact-byte asynchronous read barrier (async_reader_read_exact).
//   4. Stream EOF detection and remaining byte capacity inspection.
// RULES.oot 1.4: Default-deny for OS I/O. Explicit &IoCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware async readiness polling lowers to epoll/kqueue descriptor triggers.

import "std/result.oo";

type AsyncReader = struct {
    source: String,
    position: Int,
    is_pending: Bool
};

type AsyncReadResult = struct {
    reader: AsyncReader,
    data: String,
    bytes_read: Int
};

pub fn async_reader_new(src: String) -> AsyncReader {
    return AsyncReader {
        source: src,
        position: 0,
        is_pending: false
    };
}

pub fn async_reader_remaining(r: AsyncReader) -> Int {
    let total: Int = chars_len(r.source);
    let p: Int = r.position;
    return total - p;
}

pub fn async_reader_is_eof(r: AsyncReader) -> Bool {
    let rem: Int = async_reader_remaining(r);
    return rem <= 0;
}

pub fn async_reader_poll_read(
    r: AsyncReader,
    max_bytes: Int
) -> AsyncReadResult {
    let total: Int = chars_len(r.source);
    let cur_pos: Int = r.position;
    if cur_pos >= total {
        return AsyncReadResult {
            reader: r,
            data: "",
            bytes_read: 0
        };
    }
    let mut take: Int = max_bytes;
    if take <= 0 {
        take = total - cur_pos;
    }
    let mut end: Int = cur_pos + take;
    if end > total {
        end = total;
    }
    let chunk: String = str_slice(r.source, cur_pos, end);
    let read_count: Int = end - cur_pos;
    let updated: AsyncReader = AsyncReader {
        source: r.source,
        position: end,
        is_pending: false
    };
    return AsyncReadResult {
        reader: updated,
        data: chunk,
        bytes_read: read_count
    };
}

pub fn async_reader_read_exact(
    r: AsyncReader,
    count: Int
) -> AsyncReadResult {
    let rem: Int = async_reader_remaining(r);
    if count > rem {
        return AsyncReadResult {
            reader: r,
            data: "",
            bytes_read: 0
        };
    }
    return async_reader_poll_read(r, count);
}
