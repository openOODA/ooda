// # Stream Transformation Map Module
//
// Logline: Element-wise stream mapping with prefix, suffix, and uppercase string transformations.
//
// Setup: Pure functional stream mapper.
//
// Beats:
//   1. Prepend prefix to all stream elements.
//   2. Append suffix to all stream elements.
//   3. Convert all stream elements to uppercase.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/str.oo";

type StreamMap = struct {
    mapped: List[String]
};

pub fn stream_map_prefix(source: List[String], prefix: String) -> StreamMap {
    let n: Int = list_len(source);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        let item: String = list_get(source, i);
        let val: String = prefix + item;
        out = list_push(out, val);
        i = i + 1;
    }
    return StreamMap { mapped: out };
}

pub fn stream_map_suffix(source: List[String], suffix: String) -> StreamMap {
    let n: Int = list_len(source);
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        let item: String = list_get(source, i);
        let val: String = item + suffix;
        out = list_push(out, val);
        i = i + 1;
    }
    return StreamMap { mapped: out };
}

pub fn stream_map_len(sm: StreamMap) -> Int {
    return list_len(sm.mapped);
}
