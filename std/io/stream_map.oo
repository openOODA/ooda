// # Stream Transformation Map Module
//
// Logline: Element-wise stream mapping with add and scale on Int streams.
//
// Setup: Pure functional stream mapper. Destubbed List[String] -> List[Int].
//
// Beats:
//   1. Add a delta to all stream elements.
//   2. Scale all stream elements.
//   3. Query mapped length and values.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

type StreamMap = struct {
    mapped: List[Int]
};

pub fn stream_map_add(source: List[Int], delta: Int) -> StreamMap {
    let n: Int = list_len(source);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let item: Int = list_get(source, i);
        out = list_push(out, item + delta);
        i = i + 1;
    }
    return StreamMap { mapped: out };
}

pub fn stream_map_scale(source: List[Int], factor: Int) -> StreamMap {
    let n: Int = list_len(source);
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let item: Int = list_get(source, i);
        out = list_push(out, item * factor);
        i = i + 1;
    }
    return StreamMap { mapped: out };
}

pub fn stream_map_len(sm: StreamMap) -> Int {
    return list_len(sm.mapped);
}

pub fn stream_map_get(sm: StreamMap, i: Int) -> Int {
    let n: Int = list_len(sm.mapped);
    if i < 0 || i >= n {
        return 0;
    }
    return list_get(sm.mapped, i);
}
