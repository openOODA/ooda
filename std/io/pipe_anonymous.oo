// # Anonymous Memory Pipe Module
//
// Logline: Unidirectional anonymous memory pipe with read and write channels and end-of-file signaling.
//
// Setup: Coordinates in-memory unidirectional byte stream transfer without ambient FS.
//
// Beats:
//   1. Construct AnonymousPipe with internal byte queue.
//   2. Write bytes into pipe buffer.
//   3. Read available bytes from pipe buffer.
//   4. Close pipe write end and detect EOF.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: POSIX pipe2 syscalls lower via os/process under ProcessCap.

import "std/core/list.oo";
import "std/result.oo";

type AnonPipe = struct {
    buffer: List[Int],
    read_pos: Int,
    is_closed: Bool
};

pub fn anon_pipe_new() -> AnonPipe {
    let buf: List[Int] = list_new();
    return AnonPipe {
        buffer: buf,
        read_pos: 0,
        is_closed: false
    };
}

pub fn anon_pipe_write(pipe: AnonPipe, byte_val: Int) -> Result[AnonPipe, String] {
    let closed: Bool = pipe.is_closed;
    if closed {
        return Err("PIPE_CLOSED");
    }
    let new_buf: List[Int] = list_push(pipe.buffer, byte_val);
    return Ok(AnonPipe {
        buffer: new_buf,
        read_pos: pipe.read_pos,
        is_closed: false
    });
}

pub fn anon_pipe_read_byte(pipe: AnonPipe) -> Result[AnonPipe, String] {
    let cur_pos: Int = pipe.read_pos;
    let n: Int = list_len(pipe.buffer);
    if cur_pos >= n {
        let closed: Bool = pipe.is_closed;
        if closed {
            return Err("EOF");
        }
        return Err("WOULD_BLOCK");
    }
    return Ok(AnonPipe {
        buffer: pipe.buffer,
        read_pos: cur_pos + 1,
        is_closed: pipe.is_closed
    });
}

pub fn anon_pipe_close(pipe: AnonPipe) -> AnonPipe {
    return AnonPipe {
        buffer: pipe.buffer,
        read_pos: pipe.read_pos,
        is_closed: true
    };
}
