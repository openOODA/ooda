// # Bit-Level Stream Writer and Packer Module
//
// Logline: Arbitrary bit-width streaming writer packing bits into output byte sequences.
//
// Setup: Pure binary serialization module. Supports compressed stream bit emission.
//
// Beats:
//   1. Construct BitWriter with empty output accumulator.
//   2. Write single bit into pending accumulator word.
//   3. Write multi-bit integer field.
//   4. Flush pending partial byte to byte stream.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

// residual: one packed last_byte; List[Int] output field emit UAF

type BitWriter = struct {
    last_byte: Int,
    n_bytes: Int,
    accumulator: Int,
    bit_count: Int
};

pub fn bit_writer_new() -> BitWriter {
    return BitWriter {
        last_byte: 0,
        n_bytes: 0,
        accumulator: 0,
        bit_count: 0
    };
}

pub fn bit_writer_write_bit(w: BitWriter, bit: Int) -> BitWriter {
    let cur_acc: Int = w.accumulator;
    let cur_cnt: Int = w.bit_count;
    let mut shifted_bit: Int = bit & 1;
    let mut i: Int = 0;
    while i < cur_cnt {
        shifted_bit = shifted_bit * 2;
        i = i + 1;
    }
    let new_acc: Int = cur_acc + shifted_bit;
    let next_cnt: Int = cur_cnt + 1;
    if next_cnt >= 8 {
        let byte_val: Int = new_acc;
        let mut clipped: Int = byte_val;
        if clipped >= 256 {
            clipped = clipped - 256;
        }
        return BitWriter {
            last_byte: clipped,
            n_bytes: w.n_bytes + 1,
            accumulator: 0,
            bit_count: 0
        };
    }
    return BitWriter {
        last_byte: w.last_byte,
        n_bytes: w.n_bytes,
        accumulator: new_acc,
        bit_count: next_cnt
    };
}

pub fn bit_writer_flush(w: BitWriter) -> BitWriter {
    let cur_cnt: Int = w.bit_count;
    if cur_cnt > 0 {
        let acc: Int = w.accumulator;
        return BitWriter {
            last_byte: acc,
            n_bytes: w.n_bytes + 1,
            accumulator: 0,
            bit_count: 0
        };
    }
    return w;
}

pub fn bit_writer_len(w: BitWriter) -> Int {
    return w.n_bytes;
}

pub fn bit_writer_last_byte(w: BitWriter) -> Int {
    return w.last_byte;
}
