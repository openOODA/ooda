// # Seekable In-Memory Cursor
//
// Logline: Seekable byte/character cursor over in-memory string slices with absolute and relative positioning.
//
// Setup: Pure seekable stream cursor implementing read, write, and seek operations.
//
// Beats:
//   1. Construct Cursor wrapping in-memory string buffer.
//   2. Read n characters from current position and advance cursor.
//   3. Seek to absolute offset or relative delta.
//   4. Overwrite buffer at cursor position and report current offset.
//
// residual: purely in-memory character position indexing over immutable strings

type Cursor = struct {
    buffer: String,
    position: Int
};

// Construct a new Cursor wrapping the given buffer.
pub fn cursor_new(initial_buffer: String) -> Cursor {
    return Cursor {
        buffer: initial_buffer,
        position: 0
    };
}

// Read up to max_chars from current position.
pub fn cursor_read(cursor: Cursor, max_chars: Int) -> Result[String, String] {
    let cur_buf: String = cursor.buffer;
    let total_len: Int = chars_len(cur_buf);
    let cur_pos: Int = cursor.position;
    if cur_pos >= total_len {
        return Err("EOF");
    }
    let mut limit: Int = max_chars;
    if limit <= 0 {
        limit = total_len - cur_pos;
    }
    let mut end: Int = cur_pos + limit;
    if end > total_len {
        end = total_len;
    }
    let chunk: String = str_slice(cur_buf, cur_pos, end);
    return Ok(chunk);
}

// Advance cursor position after reading.
pub fn cursor_advance(cursor: Cursor, chars_read: Int) -> Cursor {
    let cur_buf: String = cursor.buffer;
    let total_len: Int = chars_len(cur_buf);
    let cur_pos: Int = cursor.position;
    let mut new_pos: Int = cur_pos + chars_read;
    if new_pos > total_len {
        new_pos = total_len;
    }
    if new_pos < 0 {
        new_pos = 0;
    }
    return Cursor {
        buffer: cur_buf,
        position: new_pos
    };
}

// Write data at current cursor position, replacing or extending.
pub fn cursor_write(cursor: Cursor, data: String) -> Cursor {
    let dlen: Int = chars_len(data);
    if dlen == 0 {
        return cursor;
    }
    let cur_buf: String = cursor.buffer;
    let total_len: Int = chars_len(cur_buf);
    let cur_pos: Int = cursor.position;
    let prefix: String = str_slice(cur_buf, 0, cur_pos);
    let mut suffix_start: Int = cur_pos + dlen;
    let mut suffix: String = "";
    if suffix_start < total_len {
        suffix = str_slice(cur_buf, suffix_start, total_len);
    }
    let new_buf: String = prefix + data + suffix;
    return Cursor {
        buffer: new_buf,
        position: cur_pos + dlen
    };
}

// Seek to an absolute position within buffer bounds.
pub fn cursor_seek(cursor: Cursor, new_pos: Int) -> Result[Cursor, String] {
    let cur_buf: String = cursor.buffer;
    let total_len: Int = chars_len(cur_buf);
    if new_pos < 0 || new_pos > total_len {
        return Err("SEEK_OUT_OF_BOUNDS");
    }
    return Ok(Cursor {
        buffer: cur_buf,
        position: new_pos
    });
}

// Seek relative to current position.
pub fn cursor_seek_relative(cursor: Cursor, delta: Int) -> Result[Cursor, String] {
    let cur_pos: Int = cursor.position;
    let target: Int = cur_pos + delta;
    return cursor_seek(cursor, target);
}

// Return current cursor position.
pub fn cursor_position(cursor: Cursor) -> Int {
    return cursor.position;
}

// Return remaining characters until end of buffer.
pub fn cursor_remaining(cursor: Cursor) -> Int {
    let cur_buf: String = cursor.buffer;
    let total_len: Int = chars_len(cur_buf);
    let cur_pos: Int = cursor.position;
    if cur_pos >= total_len {
        return 0;
    }
    return total_len - cur_pos;
}

// True if cursor is at or beyond buffer end.
pub fn cursor_is_eof(cursor: Cursor) -> Bool {
    let rem: Int = cursor_remaining(cursor);
    return rem == 0;
}

// Return full underlying buffer.
pub fn cursor_get_buffer(cursor: Cursor) -> String {
    return cursor.buffer;
}
