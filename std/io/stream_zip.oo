// # Stream Pairwise Zip Combinator Module
//
// Logline: Stream pairwise combiner zipping elements from two streams into composite delimited pairs.
//
// Setup: Pure stream pairwise zipper.
//
// Beats:
//   1. Construct StreamZip from two input stream lists.
//   2. Zip corresponding elements with separator.
//   3. Stop when the shorter stream ends.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type StreamZip = struct {
    zipped: List[String]
};

pub fn stream_zip_combine(a: List[String], b: List[String], separator: String) -> StreamZip {
    let len_a: Int = list_len(a);
    let len_b: Int = list_len(b);
    let mut min_len: Int = len_a;
    if len_b < min_len {
        min_len = len_b;
    }
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < min_len {
        let item_a: String = list_get(a, i);
        let item_b: String = list_get(b, i);
        let combined: String = item_a + separator + item_b;
        out = list_push(out, combined);
        i = i + 1;
    }
    return StreamZip { zipped: out };
}

pub fn stream_zip_len(sz: StreamZip) -> Int {
    return list_len(sz.zipped);
}
