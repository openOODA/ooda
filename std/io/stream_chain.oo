// # Stream Chain Concatenator Module
//
// Logline: Sequential stream chaining concatenating two ordered streams end-to-end into a single continuous stream.
//
// Setup: Pure sequential stream combiner.
//
// Beats:
//   1. Construct StreamChain from first and second stream lists.
//   2. Chain-iterate elements seamlessly across both sequences.
//   3. Compute total combined stream length.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type StreamChain = struct {
    first: List[String],
    second: List[String],
    cursor: Int
};

pub fn stream_chain_new(first: List[String], second: List[String]) -> StreamChain {
    return StreamChain {
        first: first,
        second: second,
        cursor: 0
    };
}

pub fn stream_chain_len(sc: StreamChain) -> Int {
    let n1: Int = list_len(sc.first);
    let n2: Int = list_len(sc.second);
    return n1 + n2;
}

pub fn stream_chain_next(sc: StreamChain) -> Result[StreamChain, String] {
    let cur: Int = sc.cursor;
    let total: Int = stream_chain_len(sc);
    if cur >= total {
        return Err("END_OF_STREAM");
    }
    return Ok(StreamChain {
        first: sc.first,
        second: sc.second,
        cursor: cur + 1
    });
}
