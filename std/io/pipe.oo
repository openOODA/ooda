// # Unidirectional In-Memory Pipe Buffer
//
// Logline: Synchronous in-memory pipeline buffer for decoupled producer-consumer streaming.
//
// Setup: Pure stream buffering: queue bytes in FIFO order.
//
// Beats:
//   1. Create Pipe with specified capacity and flow control state.
//   2. Write string chunk into pipe buffer.
//   3. Read string chunk up to max_bytes from pipe.
//   4. Close write end of pipe and signal EOF to reader.
//
// residual: in-memory string FIFO queue with capacity checks

type Pipe = struct {
    buffer: String,
    capacity: Int,
    is_closed: Bool,
    total_written: Int,
    total_read: Int
};

// Create a new Pipe with capacity limit.
pub fn pipe_new(capacity: Int) -> Pipe {
    let mut cap: Int = capacity;
    if cap <= 0 {
        cap = 65536;
    }
    return Pipe {
        buffer: "",
        capacity: cap,
        is_closed: false,
        total_written: 0,
        total_read: 0
    };
}

// Write string data into the pipe buffer.
pub fn pipe_write(pipe: Pipe, chunk: String) -> Result[Pipe, String] {
    let closed: Bool = pipe.is_closed;
    if closed {
        return Err("PIPE_CLOSED");
    }
    let clen: Int = chars_len(chunk);
    if clen == 0 {
        return Ok(pipe);
    }
    let cur_buf: String = pipe.buffer;
    let blen: Int = chars_len(cur_buf);
    let cap: Int = pipe.capacity;
    let projected: Int = blen + clen;
    if projected > cap {
        return Err("PIPE_FULL");
    }
    let tw: Int = pipe.total_written;
    let updated: Pipe = Pipe {
        buffer: cur_buf + chunk,
        capacity: cap,
        is_closed: false,
        total_written: tw + clen,
        total_read: pipe.total_read
    };
    return Ok(updated);
}

// Read up to max_bytes from the pipe.
pub fn pipe_read(pipe: Pipe, max_bytes: Int) -> Result[String, String] {
    let cur_buf: String = pipe.buffer;
    let blen: Int = chars_len(cur_buf);
    let closed: Bool = pipe.is_closed;
    if blen == 0 {
        if closed {
            return Err("EOF");
        }
        return Ok("");
    }
    let mut limit: Int = max_bytes;
    if limit <= 0 {
        limit = blen;
    }
    if limit > blen {
        limit = blen;
    }
    let chunk: String = str_slice(cur_buf, 0, limit);
    return Ok(chunk);
}

// Consume bytes_read from pipe buffer after read.
pub fn pipe_consume(pipe: Pipe, bytes_read: Int) -> Pipe {
    let cur_buf: String = pipe.buffer;
    let blen: Int = chars_len(cur_buf);
    let mut consumed: Int = bytes_read;
    if consumed > blen {
        consumed = blen;
    }
    if consumed <= 0 {
        return pipe;
    }
    let rem: String = str_slice(cur_buf, consumed, blen);
    let tr: Int = pipe.total_read;
    return Pipe {
        buffer: rem,
        capacity: pipe.capacity,
        is_closed: pipe.is_closed,
        total_written: pipe.total_written,
        total_read: tr + consumed
    };
}

// Close the write end of the pipe.
pub fn pipe_close(pipe: Pipe) -> Pipe {
    return Pipe {
        buffer: pipe.buffer,
        capacity: pipe.capacity,
        is_closed: true,
        total_written: pipe.total_written,
        total_read: pipe.total_read
    };
}

// True if write end of pipe is closed.
pub fn pipe_is_closed(pipe: Pipe) -> Bool {
    return pipe.is_closed;
}

// Return number of bytes currently buffered in pipe.
pub fn pipe_available(pipe: Pipe) -> Int {
    let cur_buf: String = pipe.buffer;
    return chars_len(cur_buf);
}

// True if pipe has zero bytes buffered.
pub fn pipe_is_empty(pipe: Pipe) -> Bool {
    let avail: Int = pipe_available(pipe);
    return avail == 0;
}
