// # CRC-16 CCITT Checksum Module
//
// Logline: CRC-16 CCITT polynomial (0x1021) bitwise cyclical redundancy check calculation.
//
// Setup: Pure binary checksum calculation.
//
// Beats:
//   1. Construct Crc16 with initial seed (0xFFFF).
//   2. Update CRC with incoming byte values.
//   3. Finalize CRC-16 checksum output.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type Crc16 = struct {
    crc: Int
};

pub fn crc16_new() -> Crc16 {
    return Crc16 { crc: 65535 };
}

pub fn crc16_update_byte(c: Crc16, byte_val: Int) -> Crc16 {
    let init_crc: Int = c.crc;
    let mut cur: Int = init_crc ^ ((byte_val & 255) * 256);
    let poly: Int = 4129; // 0x1021
    let mut i: Int = 0;
    while i < 8 {
        if (cur & 32768) != 0 {
            cur = ((cur * 2) ^ poly) & 65535;
        } else {
            cur = (cur * 2) & 65535;
        }
        i = i + 1;
    }
    return Crc16 { crc: cur };
}

pub fn crc16_update(c: Crc16, bytes: List[Int]) -> Crc16 {
    let n: Int = list_len(bytes);
    let mut cur: Crc16 = c;
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(bytes, i);
        cur = crc16_update_byte(cur, b);
        i = i + 1;
    }
    return cur;
}

pub fn crc16_digest(c: Crc16) -> Int {
    return c.crc;
}
