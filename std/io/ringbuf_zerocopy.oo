// # Zero-Copy Circular Ring Buffer Module
//
// Logline: Zero-copy circular byte buffer with continuous window slicing and wrapping offsets.
//
// Setup: Pure in-memory streaming module. Provides zero-copy contiguous buffer windows for high-throughput stream pipelines.
//
// Beats:
//   1. Construct ZeroCopyRing with fixed capacity, head/tail offsets, and raw string payload.
//   2. Contiguous write append with buffer wrapping and overflow saturation.
//   3. Zero-copy slice peek and contiguous window extraction.
//   4. Advance read offset, buffer drain, and reset.
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Linux vmsplice/splice kernel zero-copy transfer lowers to sys_splice via backend runtime.

type ZeroCopyRing = struct {
    capacity: Int,
    read_pos: Int,
    write_pos: Int,
    len: Int,
    buf: String
};

// Create a new ZeroCopyRing with given capacity.
pub fn zc_ring_new(capacity: Int) -> ZeroCopyRing {
    let mut cap: Int = capacity;
    if cap < 1 {
        cap = 1;
    }
    let mut empty_str: String = "";
    let mut i: Int = 0;
    while i < cap {
        empty_str = empty_str + " ";
        i = i + 1;
    }
    return ZeroCopyRing {
        capacity: cap,
        read_pos: 0,
        write_pos: 0,
        len: 0,
        buf: empty_str
    };
}

// Return maximum capacity of the ring.
pub fn zc_ring_capacity(r: ZeroCopyRing) -> Int {
    return r.capacity;
}

// Return number of available readable bytes.
pub fn zc_ring_len(r: ZeroCopyRing) -> Int {
    return r.len;
}

// Return remaining write space before full.
pub fn zc_ring_available(r: ZeroCopyRing) -> Int {
    let cap: Int = r.capacity;
    let l: Int = r.len;
    return cap - l;
}

// True if ring has no readable data.
pub fn zc_ring_is_empty(r: ZeroCopyRing) -> Bool {
    return r.len == 0;
}

// True if ring is full.
pub fn zc_ring_is_full(r: ZeroCopyRing) -> Bool {
    let cap: Int = r.capacity;
    let l: Int = r.len;
    return l >= cap;
}

// Write string data into ring buffer, wrapping around capacity.
pub fn zc_ring_write(r: ZeroCopyRing, data: String) -> ZeroCopyRing {
    let dlen: Int = chars_len(data);
    if dlen == 0 {
        return r;
    }
    let cap: Int = r.capacity;
    let cur_len: Int = r.len;
    let avail: Int = cap - cur_len;
    let mut to_write: Int = dlen;
    if to_write > avail {
        to_write = avail;
    }
    if to_write <= 0 {
        return r;
    }

    let mut new_buf: String = "";
    let cur_buf: String = r.buf;
    let wpos: Int = r.write_pos;
    let mut i: Int = 0;
    while i < cap {
        let mut in_write_range: Bool = false;
        let mut char_idx: Int = 0;
        let mut k: Int = 0;
        while k < to_write {
            let slot: Int = (wpos + k) % cap;
            if slot == i {
                in_write_range = true;
                char_idx = k;
            }
            k = k + 1;
        }
        if in_write_range {
            new_buf = new_buf + char_at(data, char_idx);
        } else {
            new_buf = new_buf + char_at(cur_buf, i);
        }
        i = i + 1;
    }

    let next_wpos: Int = (wpos + to_write) % cap;
    let next_len: Int = cur_len + to_write;
    return ZeroCopyRing {
        capacity: cap,
        read_pos: r.read_pos,
        write_pos: next_wpos,
        len: next_len,
        buf: new_buf
    };
}

// Peek up to count bytes from read position without consuming.
pub fn zc_ring_peek(r: ZeroCopyRing, count: Int) -> String {
    let cur_len: Int = r.len;
    let mut to_read: Int = count;
    if to_read > cur_len {
        to_read = cur_len;
    }
    if to_read <= 0 {
        return "";
    }
    let cap: Int = r.capacity;
    let rpos: Int = r.read_pos;
    let cur_buf: String = r.buf;
    let mut out: String = "";
    let mut k: Int = 0;
    while k < to_read {
        let slot: Int = (rpos + k) % cap;
        out = out + char_at(cur_buf, slot);
        k = k + 1;
    }
    return out;
}

// Consume count bytes from read position.
pub fn zc_ring_read(r: ZeroCopyRing, count: Int) -> ZeroCopyRing {
    let cur_len: Int = r.len;
    let mut to_read: Int = count;
    if to_read > cur_len {
        to_read = cur_len;
    }
    if to_read <= 0 {
        return r;
    }
    let cap: Int = r.capacity;
    let rpos: Int = r.read_pos;
    let next_rpos: Int = (rpos + to_read) % cap;
    let next_len: Int = cur_len - to_read;
    return ZeroCopyRing {
        capacity: cap,
        read_pos: next_rpos,
        write_pos: r.write_pos,
        len: next_len,
        buf: r.buf
    };
}

// Clear all bytes in the ring buffer.
pub fn zc_ring_clear(r: ZeroCopyRing) -> ZeroCopyRing {
    return ZeroCopyRing {
        capacity: r.capacity,
        read_pos: 0,
        write_pos: 0,
        len: 0,
        buf: r.buf
    };
}
