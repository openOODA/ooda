// # Circular Ring Buffer Module
//
// Logline: Circular Int buffer with wrap offsets. Destubbed String buf -> List[Int].
//
// Setup: Pure in-memory ring. Emit cannot lower String buf as chars_len on mixed types.
//
// Beats:
//   1. Construct ZeroCopyRing with fixed capacity.
//   2. Write Int values with wrap.
//   3. Peek and consume from read offset.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Linux vmsplice/splice zero-copy lowers via backend; this destub is List[Int].

type ZeroCopyRing = struct {
    capacity: Int,
    read_pos: Int,
    write_pos: Int,
    filled: Int,
    buf: List[Int]
};

pub fn zc_ring_new(capacity: Int) -> ZeroCopyRing {
    let mut cap: Int = capacity;
    if cap < 1 {
        cap = 1;
    }
    let mut empty: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cap {
        empty = list_push(empty, 0);
        i = i + 1;
    }
    return ZeroCopyRing {
        capacity: cap,
        read_pos: 0,
        write_pos: 0,
        filled: 0,
        buf: empty
    };
}

pub fn zc_ring_capacity(r: ZeroCopyRing) -> Int {
    return r.capacity;
}

pub fn zc_ring_len(r: ZeroCopyRing) -> Int {
    return r.filled;
}

pub fn zc_ring_available(r: ZeroCopyRing) -> Int {
    let cap: Int = r.capacity;
    let l: Int = r.filled;
    return cap - l;
}

pub fn zc_ring_is_empty(r: ZeroCopyRing) -> Bool {
    let l: Int = r.filled;
    return l == 0;
}

pub fn zc_ring_is_full(r: ZeroCopyRing) -> Bool {
    let cap: Int = r.capacity;
    let l: Int = r.filled;
    return l >= cap;
}

pub fn zc_ring_write(r: ZeroCopyRing, val: Int) -> ZeroCopyRing {
    let cap: Int = r.capacity;
    let cur_len: Int = r.filled;
    if cur_len >= cap {
        return r;
    }
    let wpos: Int = r.write_pos;
    let n: Int = list_len(r.buf);
    let mut new_buf: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == wpos {
            new_buf = list_push(new_buf, val);
        } else {
            new_buf = list_push(new_buf, list_get(r.buf, i));
        }
        i = i + 1;
    }
    let next_wpos: Int = (wpos + 1) % cap;
    return ZeroCopyRing {
        capacity: cap,
        read_pos: r.read_pos,
        write_pos: next_wpos,
        filled: cur_len + 1,
        buf: new_buf
    };
}

pub fn zc_ring_peek(r: ZeroCopyRing) -> Int {
    let cur_len: Int = r.filled;
    if cur_len == 0 {
        return 0;
    }
    let rpos: Int = r.read_pos;
    return list_get(r.buf, rpos);
}

pub fn zc_ring_read(r: ZeroCopyRing) -> ZeroCopyRing {
    let cur_len: Int = r.filled;
    if cur_len <= 0 {
        return r;
    }
    let cap: Int = r.capacity;
    let rpos: Int = r.read_pos;
    let next_rpos: Int = (rpos + 1) % cap;
    return ZeroCopyRing {
        capacity: cap,
        read_pos: next_rpos,
        write_pos: r.write_pos,
        filled: cur_len - 1,
        buf: r.buf
    };
}

pub fn zc_ring_clear(r: ZeroCopyRing) -> ZeroCopyRing {
    return ZeroCopyRing {
        capacity: r.capacity,
        read_pos: 0,
        write_pos: 0,
        filled: 0,
        buf: r.buf
    };
}
