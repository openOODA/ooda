// # Circular FIFO Ring Stream Buffer
//
// Logline: Byte-oriented circular stream buffer for fixed-window sliding streaming and backpressure.
//
// Setup: Pure circular stream buffer with read and write index pointers.
//
// Beats:
//   1. Create RingStream with maximum window size.
//   2. Write bytes into ring, rejecting or wrapping on overflow.
//   3. Read available bytes from ring up to requested length.
//   4. Query available readable and writable capacity.
//
// residual: purely in-memory sliding buffer over immutable string segments

type RingStream = struct {
    buffer: String,
    capacity: Int,
    size: Int
};

// Construct a new RingStream with designated capacity limit.
pub fn ring_stream_new(capacity: Int) -> RingStream {
    let mut cap: Int = capacity;
    if cap <= 0 {
        cap = 4096;
    }
    return RingStream {
        buffer: "",
        capacity: cap,
        size: 0
    };
}

// Write string data into ring stream, rejecting if insufficient capacity.
pub fn ring_stream_write(stream: RingStream, chunk: String) -> Result[RingStream, String] {
    let clen: Int = chars_len(chunk);
    if clen == 0 {
        return Ok(stream);
    }
    let cur_sz: Int = stream.size;
    let cap: Int = stream.capacity;
    let projected: Int = cur_sz + clen;
    if projected > cap {
        return Err("RING_OVERFLOW");
    }
    let cur_buf: String = stream.buffer;
    let updated: RingStream = RingStream {
        buffer: cur_buf + chunk,
        capacity: cap,
        size: projected
    };
    return Ok(updated);
}

// Read up to max_len bytes from front of ring stream.
pub fn ring_stream_read(stream: RingStream, max_len: Int) -> Result[String, String] {
    let cur_sz: Int = stream.size;
    if cur_sz == 0 {
        return Err("RING_EMPTY");
    }
    let mut limit: Int = max_len;
    if limit <= 0 || limit > cur_sz {
        limit = cur_sz;
    }
    let cur_buf: String = stream.buffer;
    let chunk: String = str_slice(cur_buf, 0, limit);
    return Ok(chunk);
}

// Consume bytes_read from ring stream front.
pub fn ring_stream_consume(stream: RingStream, bytes_read: Int) -> RingStream {
    let cur_sz: Int = stream.size;
    let mut consumed: Int = bytes_read;
    if consumed > cur_sz {
        consumed = cur_sz;
    }
    if consumed <= 0 {
        return stream;
    }
    let cur_buf: String = stream.buffer;
    let blen: Int = chars_len(cur_buf);
    let remaining: String = str_slice(cur_buf, consumed, blen);
    return RingStream {
        buffer: remaining,
        capacity: stream.capacity,
        size: cur_sz - consumed
    };
}

// Return available readable bytes count.
pub fn ring_stream_available_read(stream: RingStream) -> Int {
    return stream.size;
}

// Return remaining writable capacity count.
pub fn ring_stream_available_write(stream: RingStream) -> Int {
    let cap: Int = stream.capacity;
    let cur_sz: Int = stream.size;
    return cap - cur_sz;
}

// True if ring stream is at full capacity.
pub fn ring_stream_is_full(stream: RingStream) -> Bool {
    let cap: Int = stream.capacity;
    let cur_sz: Int = stream.size;
    return cur_sz >= cap;
}

// True if ring stream has zero readable bytes.
pub fn ring_stream_is_empty(stream: RingStream) -> Bool {
    let cur_sz: Int = stream.size;
    return cur_sz == 0;
}
