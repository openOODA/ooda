// # Line-Buffered Output Writer Module
//
// Logline: Line-buffered output writer with automatic newline flushing, buffer capacity triggers, and explicit flushes under IoCap.
//
// Setup: Buffers intermediate characters and flushes on newline boundaries or capacity exhaustion.
//
// Beats:
//   1. Construct LineWriter with configurable buffer capacity limit.
//   2. Write raw string content with automatic newline detection (line_writer_write_str).
//   3. Write newline-terminated line with forced buffer flush (line_writer_write_line).
//   4. Explicit buffer flush and pending buffer inspection.
// RULES.oot 1.4: Default-deny for OS I/O. Explicit &IoCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Host stdout/stderr line discipline lowers via runtime output streams.

import "std/result.oo";

type LineWriter = struct {
    buffer: String,
    capacity: Int,
    auto_flush: Bool
};

type LineWriteResult = struct {
    writer: LineWriter,
    did_flush: Bool
};

pub fn line_writer_new(cap: Int) -> LineWriter {
    let mut initial_cap: Int = cap;
    if initial_cap <= 0 {
        initial_cap = 1024;
    }
    return LineWriter {
        buffer: "",
        capacity: initial_cap,
        auto_flush: true
    };
}

pub fn line_writer_len(lw: LineWriter) -> Int {
    return chars_len(lw.buffer);
}

pub fn line_writer_to_string(lw: LineWriter) -> String {
    return lw.buffer;
}

fn contains_newline(s: String) -> Bool {
    let total: Int = chars_len(s);
    let mut i: Int = 0;
    while i < total {
        let ch: String = char_at(s, i);
        if ch == "\n" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn line_writer_flush(io: &IoCap, lw: LineWriter) -> LineWriter {
    return LineWriter {
        buffer: "",
        capacity: lw.capacity,
        auto_flush: lw.auto_flush
    };
}

pub fn line_writer_write_str(
    io: &IoCap,
    lw: LineWriter,
    text: String
) -> LineWriteResult {
    let cur_buf: String = lw.buffer;
    let combined: String = cur_buf + text;
    let has_nl: Bool = contains_newline(text);
    let blen: Int = chars_len(combined);
    let max_cap: Int = lw.capacity;

    if has_nl || blen >= max_cap {
        let flushed: LineWriter = LineWriter {
            buffer: "",
            capacity: lw.capacity,
            auto_flush: lw.auto_flush
        };
        return LineWriteResult {
            writer: flushed,
            did_flush: true
        };
    }

    let updated: LineWriter = LineWriter {
        buffer: combined,
        capacity: lw.capacity,
        auto_flush: lw.auto_flush
    };
    return LineWriteResult {
        writer: updated,
        did_flush: false
    };
}

pub fn line_writer_write_line(
    io: &IoCap,
    lw: LineWriter,
    line: String
) -> LineWriteResult {
    let full: String = line + "\n";
    return line_writer_write_str(io, lw, full);
}
