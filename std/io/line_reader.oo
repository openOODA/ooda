// # Line-by-Line Stream Scanner
//
// Logline: Buffered line reader supporting CRLF / LF splitting, line numbering, and empty line handling.
//
// Setup: Pure stream scanner splitting raw inputs into discrete line tokens.
//
// Beats:
//   1. Initialize LineReader with raw string source.
//   2. Read next line, advancing internal position and incrementing line number.
//   3. Check if more lines remain in input stream.
//   4. Collect all remaining lines into List[String].
//
// residual: purely in-memory character scanning for CRLF and LF delimiters

type LineItem = struct {
    line: String,
    line_number: Int
};

type LineReader = struct {
    source: String,
    cursor: Int,
    current_line: Int
};

// Create a new LineReader from string source.
pub fn line_reader_new(source: String) -> LineReader {
    return LineReader {
        source: source,
        cursor: 0,
        current_line: 1
    };
}

// True if reader has unread content remaining.
pub fn line_reader_has_next(reader: LineReader) -> Bool {
    let raw: String = reader.source;
    let n: Int = chars_len(raw);
    let cur: Int = reader.cursor;
    return cur < n;
}

// Read next line token without mutating reader state.
pub fn line_reader_next(reader: LineReader) -> LineItem {
    let has: Bool = line_reader_has_next(reader);
    if has == false {
        return LineItem {
            line: "",
            line_number: reader.current_line
        };
    }
    let raw: String = reader.source;
    let n: Int = chars_len(raw);
    let cur: Int = reader.cursor;
    let mut end: Int = n;
    let mut p: Int = cur;
    while p < n {
        let c: String = char_at(raw, p);
        if c == "\n" {
            end = p;
            p = n;
        } else {
            p = p + 1;
        }
    }
    let mut line_str: String = str_slice(raw, cur, end);
    if str_ends_with(line_str, "\r") {
        let llen: Int = chars_len(line_str);
        line_str = str_slice(line_str, 0, llen - 1);
    }
    let item: LineItem = LineItem {
        line: line_str,
        line_number: reader.current_line
    };
    return item;
}

// Advance reader cursor and increment line number.
pub fn line_reader_advance(reader: LineReader, raw_line_len: Int) -> LineReader {
    let raw: String = reader.source;
    let n: Int = chars_len(raw);
    let cur: Int = reader.cursor;
    let mut next_cur: Int = cur + raw_line_len;
    // Consume newline delimiter
    if next_cur < n && char_at(raw, next_cur) == "\r" {
        next_cur = next_cur + 1;
    }
    if next_cur < n && char_at(raw, next_cur) == "\n" {
        next_cur = next_cur + 1;
    }
    let cur_ln: Int = reader.current_line;
    return LineReader {
        source: reader.source,
        cursor: next_cur,
        current_line: cur_ln + 1
    };
}

// Collect all remaining lines into a list of strings.
pub fn line_reader_read_all(reader: LineReader) -> List[String] {
    let raw: String = reader.source;
    let n: Int = chars_len(raw);
    let cur: Int = reader.cursor;
    let mut out: List[String] = list_new();
    if cur >= n {
        return out;
    }
    let remaining: String = str_slice(raw, cur, n);
    let parts: List[String] = str_split(remaining, "\n");
    let plen: Int = list_len(parts);
    let mut i: Int = 0;
    while i < plen {
        let mut p: String = list_get(parts, i);
        if str_ends_with(p, "\r") {
            let pl: Int = chars_len(p);
            p = str_slice(p, 0, pl - 1);
        }
        out = list_push(out, p);
        i = i + 1;
    }
    return out;
}

// Return current line index (1-based).
pub fn line_reader_current_line_number(reader: LineReader) -> Int {
    return reader.current_line;
}
