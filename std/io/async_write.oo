// # Asynchronous Stream Writer Module
//
// Logline: Non-blocking asynchronous stream writer contract, buffer backpressure management, and queued flushing under IoCap.
//
// Setup: Coordinates non-blocking buffered output writes and explicit flush cycles under IoCap capability.
//
// Beats:
//   1. Construct AsyncWriter state with bounded memory buffering.
//   2. Poll write string chunks with backpressure bounds checking under IoCap.
//   3. Poll flush buffered contents to underlying destination.
//   4. Graceful asynchronous stream closing and buffer inspection.
// RULES.oot 1.4: Default-deny for OS I/O. Explicit &IoCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware async writes lower to io_uring/epoll write readiness triggers.

import "std/result.oo";

type AsyncWriter = struct {
    buffer: String,
    flushed_len: Int,
    pending: Int,
    capacity: Int,
    is_closed: Bool
};

type AsyncWriteResult = struct {
    writer: AsyncWriter,
    bytes_written: Int
};

pub fn async_writer_new(cap: Int) -> AsyncWriter {
    let mut initial_cap: Int = cap;
    if initial_cap <= 0 {
        initial_cap = 4096;
    }
    return AsyncWriter {
        buffer: "",
        flushed_len: 0,
        pending: 0,
        capacity: initial_cap,
        is_closed: false
    };
}

pub fn async_writer_buffered_len(w: AsyncWriter) -> Int {
    return w.pending;
}

pub fn async_writer_to_string(w: AsyncWriter) -> String {
    return w.buffer;
}

pub fn async_writer_poll_write(
    w: AsyncWriter,
    data: String
) -> AsyncWriteResult {
    let closed: Bool = w.is_closed;
    if closed {
        return AsyncWriteResult {
            writer: w,
            bytes_written: 0
        };
    }
    let cur_pending: Int = async_writer_buffered_len(w);
    let dlen: Int = chars_len(data);
    let max_cap: Int = w.capacity;
    if cur_pending + dlen > max_cap {
        return AsyncWriteResult {
            writer: w,
            bytes_written: 0
        };
    }
    let next_pending: Int = cur_pending + dlen;
    let updated: AsyncWriter = AsyncWriter {
        buffer: data,
        flushed_len: w.flushed_len,
        pending: next_pending,
        capacity: w.capacity,
        is_closed: w.is_closed
    };
    return AsyncWriteResult {
        writer: updated,
        bytes_written: dlen
    };
}

pub fn async_writer_poll_flush(
    w: AsyncWriter
) -> AsyncWriter {
    let done: Int = w.flushed_len + w.pending;
    return AsyncWriter {
        buffer: w.buffer,
        flushed_len: done,
        pending: 0,
        capacity: w.capacity,
        is_closed: w.is_closed
    };
}

pub fn async_writer_poll_close(
    w: AsyncWriter
) -> AsyncWriter {
    let done: Int = w.flushed_len + w.pending;
    return AsyncWriter {
        buffer: w.buffer,
        flushed_len: done,
        pending: 0,
        capacity: w.capacity,
        is_closed: true
    };
}
