// # FNV-1a Non-Cryptographic Hash / Checksum Module
//
// Logline: 32-bit and 64-bit Fowler-Noll-Vo FNV-1a fast dispersion hashing algorithm.
//
// Setup: Pure hash module multiplying prime 16777619 and XORing byte values.
//
// Beats:
//   1. Construct Fnv1a state initialized with 32-bit FNV offset basis 2166136261.
//   2. Update hash with byte value (hash = (hash ^ byte) * prime).
//   3. Compute string hash value using ASCII character folding.
//   4. Extract 32-bit unsigned integer hash value.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/str.oo";

type Fnv1a = struct {
    hash_val: Int
};

pub fn fnv1a_new() -> Fnv1a {
    return Fnv1a { hash_val: 2166136261 };
}

pub fn fnv1a_update_byte(fnv: Fnv1a, byte_val: Int) -> Fnv1a {
    let prime: Int = 16777619;
    let b: Int = byte_val & 255;
    let cur_h: Int = fnv.hash_val;
    let xored: Int = cur_h ^ b;
    let next_h: Int = (xored * prime) & 2147483647;
    return Fnv1a { hash_val: next_h };
}

pub fn fnv1a_hash_str(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut state: Fnv1a = fnv1a_new();
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        let code: Int = chars_len(ch);
        state = fnv1a_update_byte(state, code + i);
        i = i + 1;
    }
    let res: Int = state.hash_val;
    return res;
}

pub fn fnv1a_digest(fnv: Fnv1a) -> Int {
    return fnv.hash_val;
}
