// # Algebraic invariant property prover (fail-closed on unknown ops)
//
// Logline: Pure integer monoid-like ops (add, mul, min, max) with zero/one; algebraic laws checked by string-dispatched property tests. Unknown op names fail closed with holds = 0.
//
// Setup: oodac Backend-C lowers Result-free struct returns when fields are Int/String; the AlgebraicCert box is the report surface.
//
// Beats:
//   1. op_apply(op_name, a, b) selects add/mul/min/max by String; returns 0 for unknown (NOT a valid result).
//   2. op_identity(op_name) returns 0 for add/min and 1 for mul/max.
//   3. is_supported_op(op_name) returns true only for the four documented ops; false for everything else.
//   4. check_associative, check_identity, check_commutative, check_distributive, check_inverse return AlgebraicCert with holds=0 if op is not supported, holds=1/0 if supported.
//   5. AlgebraicCert is a struct of String, Int, Int, Int (no List fields — List[CustomStruct] lowered by oodac with release hazards).
//
// residual: only the four ops add/mul/min/max are supported; sub, div, xor, etc. all fail closed with holds = 0; inverse law is meaningful for add (mul inverse = 0, not 1).

pub type AlgebraicCert = struct {
    law_name: String,
    lhs: Int,
    rhs: Int,
    holds: Int
};

// is_supported_op returns true only for the four documented monoid-like ops.
pub fn is_supported_op(op_name: String) -> Bool {
    if op_name == "add" { return true; }
    if op_name == "mul" { return true; }
    if op_name == "min" { return true; }
    if op_name == "max" { return true; }
    return false;
}

// Apply the named op to two Ints. add|mul|min|max. Unknown op returns 0
// (this sentinel must not be confused with a real result by callers; the
// check functions validate via is_supported_op first).
pub fn op_apply(op_name: String, a: Int, b: Int) -> Int {
    if op_name == "add" {
        return a + b;
    }
    if op_name == "mul" {
        return a * b;
    }
    if op_name == "min" {
        if a < b {
            return a;
        }
        return b;
    }
    if op_name == "max" {
        if a > b {
            return a;
        }
        return b;
    }
    return 0;
}

// Identity element for the named op. add|min -> 0; mul|max -> 1.
pub fn op_identity(op_name: String) -> Int {
    if op_name == "mul" {
        return 1;
    }
    if op_name == "max" {
        return 1;
    }
    return 0;
}

// Cert helper that encodes (law_name, lhs, rhs, holds) without a List field.
pub fn cert_new(law: String, lhs: Int, rhs: Int, holds: Int) -> AlgebraicCert { return AlgebraicCert { law_name: law, lhs: lhs, rhs: rhs, holds: holds }; }

// True if (a op b) op c == a op (b op c). Fails closed with holds = 0 if op is unsupported.
pub fn check_associative(op_name: String, a: Int, b: Int, c: Int) -> AlgebraicCert {
    if is_supported_op(op_name) == false { return cert_new("associative", 0, 0, 0); }
    let left = op_apply(op_name, op_apply(op_name, a, b), c);
    let right = op_apply(op_name, a, op_apply(op_name, b, c));
    if left == right {
        return cert_new("associative", left, right, 1);
    }
    return cert_new("associative", left, right, 0);
}

// True if a op e == a and e op a == a, where e is op_identity(op_name). Fails closed on unsupported op.
pub fn check_identity(op_name: String, a: Int) -> AlgebraicCert {
    if is_supported_op(op_name) == false { return cert_new("identity", 0, 0, 0); }
    let e = op_identity(op_name);
    let left = op_apply(op_name, a, e);
    let right = op_apply(op_name, e, a);
    if left == a {
        if right == a {
            return cert_new("identity", left, right, 1);
        }
    }
    return cert_new("identity", left, right, 0);
}

// True if a op b == b op a. Fails closed on unsupported op.
pub fn check_commutative(op_name: String, a: Int, b: Int) -> AlgebraicCert {
    if is_supported_op(op_name) == false { return cert_new("commutative", 0, 0, 0); }
    let left = op_apply(op_name, a, b);
    let right = op_apply(op_name, b, a);
    if left == right {
        return cert_new("commutative", left, right, 1);
    }
    return cert_new("commutative", left, right, 0);
}

// True if a * (b + c) == (a * b) + (a * c). Hard-coded mul/add; not op-dispatched.
pub fn check_distributive(a: Int, b: Int, c: Int) -> AlgebraicCert {
    let left = a * (b + c);
    let right = (a * b) + (a * c);
    if left == right {
        return cert_new("distributive", left, right, 1);
    }
    return cert_new("distributive", left, right, 0);
}

// True if a op (-a) == 0. add: a + (0 - a) == 0; mul: a * (0 - a) == 0 (only when a != 0). Fails closed on unsupported op.
pub fn check_inverse(op_name: String, a: Int) -> AlgebraicCert {
    if is_supported_op(op_name) == false { return cert_new("inverse", 0, 0, 0); }
    let neg = 0 - a;
    let lhs = op_apply(op_name, a, neg);
    let rhs = 0;
    if lhs == rhs {
        return cert_new("inverse", lhs, rhs, 1);
    }
    return cert_new("inverse", lhs, rhs, 0);
}
