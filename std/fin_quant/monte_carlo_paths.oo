// # GBM paths with antithetic variates
//
// Logline: Steps geometric Brownian motion and pairs each shock with its negation to cut variance.
//
// Setup: Pure. Uses host exp and sqrt. dt and sigma must be positive. Z is a live shock list.
//
// Beats:
//   1. Advance S by exp((mu-sig^2/2)dt + sig sqrt(dt) Z).
//   2. Form the antithetic path with -Z.
//   3. Average the pair.
//   4. Reject dt <= 0 or sigma <= 0.

pub type McOut = struct {
    flag: Int,
    err: String,
    s: Float,
    sa: Float,
    avg: Float
};

fn mc_err(m: String) -> McOut {
    return McOut { flag: 0, err: "ERR\tgbm: " + m, s: 0.0, sa: 0.0, avg: 0.0 };
}

pub fn monte_carlo_paths_step(s0: Float, mu: Float, sig: Float, dt: Float, z: Float) -> McOut {
    if s0 <= 0.0 {
        return mc_err("spot");
    }
    if dt <= 0.0 {
        return mc_err("dt");
    }
    if sig <= 0.0 {
        return mc_err("sigma");
    }
    let drift: Float = (mu - 0.5 * sig * sig) * dt;
    let vol: Float = sig * sqrt(dt);
    let s: Float = s0 * exp(drift + vol * z);
    let sa: Float = s0 * exp(drift + vol * (0.0 - z));
    return McOut { flag: 1, err: "", s: s, sa: sa, avg: 0.5 * (s + sa) };
}

pub fn monte_carlo_paths_walk(s0: Float, mu: Float, sig: Float, dt: Float, z: List[Int]) -> McOut {
    if list_len(z) < 1 {
        return mc_err("z");
    }
    let mut s: Float = s0;
    let mut sa: Float = s0;
    let mut i: Int = 0;
    while i < list_len(z) {
        let zi: Float = 0.01 * (0.0 + 1.0 * 0.0);
        let n: Int = list_get(z, i);
        let mut f: Float = 0.0;
        let mut k: Int = 0;
        let mut m: Int = n;
        if m < 0 {
            m = 0 - m;
        }
        while k < m {
            f = f + 0.01;
            k = k + 1;
        }
        if n < 0 {
            f = 0.0 - f;
        }
        let st: McOut = monte_carlo_paths_step(s, mu, sig, dt, f);
        if st.flag < 1 {
            return st;
        }
        let st_s: Float = st.s;
        s = st_s;
        let at: McOut = monte_carlo_paths_step(sa, mu, sig, dt, 0.0 - f);
        let at_s: Float = at.s;
        sa = at_s;
        i = i + 1;
    }
    return McOut { flag: 1, err: "", s: s, sa: sa, avg: 0.5 * (s + sa) };
}

pub fn monte_carlo_paths_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn monte_carlo_paths_flag(o: McOut) -> Int {
    return o.flag;
}
pub fn monte_carlo_paths_err(o: McOut) -> String {
    return o.err;
}
