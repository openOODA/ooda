// # Nelson-Siegel four-parameter yield curve
//
// Logline: Interpolates a zero-coupon yield from beta0, beta1, beta2, and tau.
//
// Setup: Pure. Uses host exp. Maturity and tau must be positive.
//
// Beats:
//   1. Form x = t / tau.
//   2. Evaluate (1-e^{-x})/x and that quantity minus e^{-x}.
//   3. Return b0 + b1 G1 + b2 G2.
//   4. Reject t <= 0 or tau <= 0.

pub type NsOut = struct {
    flag: Int,
    err: String,
    y: Float,
    g1: Float,
    g2: Float
};

fn ns_err(m: String) -> NsOut {
    return NsOut { flag: 0, err: "ERR\tns: " + m, y: 0.0, g1: 0.0, g2: 0.0 };
}

pub fn nelson_siegel_curve_yield(b0: Float, b1: Float, b2: Float, tau: Float, t: Float) -> NsOut {
    if tau <= 0.0 {
        return ns_err("tau");
    }
    if t <= 0.0 {
        return ns_err("dt");
    }
    let x: Float = t / tau;
    let ex: Float = exp(0.0 - x);
    let g1: Float = (1.0 - ex) / x;
    let g2: Float = g1 - ex;
    let y: Float = b0 + b1 * g1 + b2 * g2;
    return NsOut { flag: 1, err: "", y: y, g1: g1, g2: g2 };
}

pub fn nelson_siegel_curve_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn nelson_siegel_curve_flag(o: NsOut) -> Int {
    return o.flag;
}
pub fn nelson_siegel_curve_err(o: NsOut) -> String {
    return o.err;
}
