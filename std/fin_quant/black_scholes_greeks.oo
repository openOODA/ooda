// # Black-Scholes-Merton Greeks
//
// Logline: Values European calls and puts and returns Delta, Gamma, Vega, Theta, and Rho with put-call parity.
//
// Setup: Pure. Uses host exp, ln, and sqrt. Spot, strike, rate, and time must be positive. Vol must be positive.
//
// Beats:
//   1. Form d1 and d2.
//   2. Approximate N(x) with a logistic map.
//   3. Emit call, put, and five Greeks.
//   4. Reject dt <= 0 or sigma <= 0.

pub type BsOut = struct {
    flag: Int,
    err: String,
    call: Float,
    put: Float,
    delta: Float,
    gamma: Float,
    vega: Float,
    theta: Float,
    rho: Float
};

fn bs_err(m: String) -> BsOut {
    return BsOut { flag: 0, err: "ERR\tbs: " + m, call: 0.0, put: 0.0, delta: 0.0, gamma: 0.0, vega: 0.0, theta: 0.0, rho: 0.0 };
}

fn bs_ncdf(x: Float) -> Float {
    return 1.0 / (1.0 + exp(0.0 - 1.702 * x));
}

fn bs_npdf(x: Float) -> Float {
    return exp(0.0 - 0.5 * x * x) / 2.506628252;
}

pub fn black_scholes_greeks_price(s: Float, k: Float, r: Float, t: Float, sig: Float) -> BsOut {
    if s <= 0.0 {
        return bs_err("spot");
    }
    if k <= 0.0 {
        return bs_err("strike");
    }
    if t <= 0.0 {
        return bs_err("dt");
    }
    if sig <= 0.0 {
        return bs_err("sigma");
    }
    let st: Float = sig * sqrt(t);
    let d1: Float = (ln(s / k) + (r + 0.5 * sig * sig) * t) / st;
    let d2: Float = d1 - st;
    let nd1: Float = bs_ncdf(d1);
    let nd2: Float = bs_ncdf(d2);
    let nmd1: Float = bs_ncdf(0.0 - d1);
    let nmd2: Float = bs_ncdf(0.0 - d2);
    let disc: Float = exp(0.0 - r * t);
    let call: Float = s * nd1 - k * disc * nd2;
    let put: Float = k * disc * nmd2 - s * nmd1;
    let pdf: Float = bs_npdf(d1);
    let delta: Float = nd1;
    let gamma: Float = pdf / (s * st);
    let vega: Float = s * pdf * sqrt(t);
    let theta: Float = 0.0 - (s * pdf * sig) / (2.0 * sqrt(t)) - r * k * disc * nd2;
    let rho: Float = k * t * disc * nd2;
    return BsOut { flag: 1, err: "", call: call, put: put, delta: delta, gamma: gamma, vega: vega, theta: theta, rho: rho };
}

pub fn black_scholes_greeks_parity(s: Float, k: Float, r: Float, t: Float, sig: Float) -> Result[Int, String] {
    let o: BsOut = black_scholes_greeks_price(s, k, r, t, sig);
    if o.flag < 1 {
        return Err(o.err);
    }
    let lhs: Float = o.call - o.put;
    let rhs: Float = s - k * exp(0.0 - r * t);
    let mut d: Float = lhs - rhs;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > 0.000001 {
        return Err("ERR\tbs: parity");
    }
    return Ok(1);
}

pub fn black_scholes_greeks_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn black_scholes_greeks_flag(o: BsOut) -> Int {
    return o.flag;
}
pub fn black_scholes_greeks_err(o: BsOut) -> String {
    return o.err;
}
