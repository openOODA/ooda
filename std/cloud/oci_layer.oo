// # OCI Layer Blob Processing & Unpack Engine
//
// Logline: Manages OCI container layer blobs, diff IDs, tar extraction simulation, and cap-gated disk operations.
//
// Setup: FsReadCap and FsWriteCap capability-gated layer decompression and extraction engine.
//
// Beats:
//   1. Model OciLayer blobs with diff ID, compressed size, uncompressed size, and media type.
//   2. Implement layer verification against descriptor digests under FsReadCap.
//   3. Support layer extraction tracking and rootfs layer stacking under FsWriteCap.

import "./oci_descriptor.oo";

pub type OciLayer = struct {
    descriptor: OciDescriptor,
    diff_id: String,
    is_compressed: Bool,
    uncompressed_size: Int,
    layer_index: Int,
    is_applied: Bool,
};

/// Initialize a new OciLayer struct.
pub fn oci_layer_new(
    desc: OciDescriptor,
    diff_id: String,
    uncompressed_size: Int,
    layer_idx: Int
) -> OciLayer {
    return OciLayer {
        descriptor: desc,
        diff_id: diff_id,
        is_compressed: true,
        uncompressed_size: uncompressed_size,
        layer_index: layer_idx,
        is_applied: false,
    };
}

/// Create an uncompressed layer representation.
pub fn oci_layer_uncompressed(
    desc: OciDescriptor,
    diff_id: String,
    size: Int,
    layer_idx: Int
) -> OciLayer {
    return OciLayer {
        descriptor: desc,
        diff_id: diff_id,
        is_compressed: false,
        uncompressed_size: size,
        layer_index: layer_idx,
        is_applied: false,
    };
}

/// Verify a layer blob against expected size and descriptor under FsReadCap.
pub fn oci_layer_verify(
    fs: &FsReadCap,
    layer: &OciLayer,
    actual_byte_size: Int
) -> Result[Bool, String] {
    let expected_size: Int = (layer).descriptor.size;
    if actual_byte_size != expected_size {
        return Err("Layer size mismatch against descriptor");
    }
    if oci_descriptor_validate_digest(&(layer).descriptor) == false {
        return Err("Layer digest verification failed");
    }
    return Ok(true);
}

/// Apply and extract layer blob into target rootfs directory under FsWriteCap.
pub fn oci_layer_apply_to_rootfs(
    fs: &FsWriteCap,
    layer: &mut OciLayer,
    target_rootfs: String
) -> Result[Int, String] {
    if (layer).uncompressed_size <= 0 {
        return Err("Invalid layer uncompressed size");
    }
    (layer).is_applied = true;
    return Ok((layer).uncompressed_size);
}

/// Estimate compression ratio as percentage (uncompressed / compressed * 100).
pub fn oci_layer_estimate_compression_ratio(layer: &OciLayer) -> Int {
    let comp_sz: Int = (layer).descriptor.size;
    if comp_sz <= 0 {
        return 100;
    }
    let uncomp_sz: Int = (layer).uncompressed_size;
    return (uncomp_sz * 100) / comp_sz;
}

/// Check if the layer is marked as successfully extracted.
pub fn oci_layer_is_applied(layer: &OciLayer) -> Bool {
    return (layer).is_applied;
}
