// # Leaky Bucket Rate Limiter & Traffic Shaper
//
// Logline: Leaky Bucket for smooth egress. By-value destub.
//
// Setup: Capacity, leak rate per second, water level. Int floor.
//
// Beats:
//   1. leak subtracts elapsed_ms * rate / 1000, floored at 0.
//   2. add enqueues if water + amount <= capacity, else drop.
//   3. estimated wait is water * 1000 / rate.

type LeakyBucket = struct {
    capacity: Int,
    leak_rate_per_sec: Int,
    water_level: Int,
    last_leak_timestamp_ms: Int,
    dropped_requests: Int,
    processed_requests: Int
};

pub fn leaky_bucket_new(
    capacity: Int,
    leak_rate_per_sec: Int,
    now_ms: Int
) -> LeakyBucket {
    return LeakyBucket {
        capacity: capacity,
        leak_rate_per_sec: leak_rate_per_sec,
        water_level: 0,
        last_leak_timestamp_ms: now_ms,
        dropped_requests: 0,
        processed_requests: 0
    };
}

fn leaky_clamp0(value: Int) -> Int {
    if value < 0 {
        return 0;
    }
    return value;
}

/// Leak accumulated water based on elapsed time. By-value destub.
pub fn leaky_bucket_leak(bucket: LeakyBucket, now_ms: Int) -> LeakyBucket {
    let elapsed_ms: Int = now_ms - bucket.last_leak_timestamp_ms;
    if elapsed_ms <= 0 {
        return bucket;
    }
    let leaked: Int = (elapsed_ms * bucket.leak_rate_per_sec) / 1000;
    if leaked <= 0 {
        return bucket;
    }
    let new_level: Int = leaky_clamp0(bucket.water_level - leaked);
    return LeakyBucket {
        capacity: bucket.capacity,
        leak_rate_per_sec: bucket.leak_rate_per_sec,
        water_level: new_level,
        last_leak_timestamp_ms: now_ms,
        dropped_requests: bucket.dropped_requests,
        processed_requests: bucket.processed_requests
    };
}

/// Attempt to add incoming request workload. By-value destub.
pub fn leaky_bucket_add(
    bucket: LeakyBucket,
    amount: Int,
    now_ms: Int
) -> LeakyBucket {
    let leaked: LeakyBucket = leaky_bucket_leak(bucket, now_ms);
    if leaked.water_level + amount <= leaked.capacity {
        return LeakyBucket {
            capacity: leaked.capacity,
            leak_rate_per_sec: leaked.leak_rate_per_sec,
            water_level: leaked.water_level + amount,
            last_leak_timestamp_ms: leaked.last_leak_timestamp_ms,
            dropped_requests: leaked.dropped_requests,
            processed_requests: leaked.processed_requests + 1
        };
    }
    return LeakyBucket {
        capacity: leaked.capacity,
        leak_rate_per_sec: leaked.leak_rate_per_sec,
        water_level: leaked.water_level,
        last_leak_timestamp_ms: leaked.last_leak_timestamp_ms,
        dropped_requests: leaked.dropped_requests + 1,
        processed_requests: leaked.processed_requests
    };
}

/// Estimate queuing delay in milliseconds.
pub fn leaky_bucket_estimated_wait_ms(bucket: LeakyBucket) -> Int {
    let rate: Int = bucket.leak_rate_per_sec;
    if rate <= 0 {
        return 0;
    }
    return (bucket.water_level * 1000) / rate;
}

/// Check if bucket queue has reached capacity. Returns 1 if full.
pub fn leaky_bucket_is_full(bucket: LeakyBucket) -> Int {
    if bucket.water_level >= bucket.capacity {
        return 1;
    }
    return 0;
}
