// # Circuit Breaker Fault-Tolerance State Machine
//
// Logline: Nygard Closed/Open/Half-Open. Flattened Int destub (no nested config).
//
// Setup: failure_threshold, success_threshold, timeout_duration_ms.
//
// Beats:
//   1. Closed allows; Open rejects until timeout then Half-Open.
//   2. Closed trips Open after failure_threshold consecutive failures.
//   3. Half-Open success_threshold successes recover Closed; any fail trips Open.

type CircuitBreaker = struct {
    state: Int,
    failure_threshold: Int,
    success_threshold: Int,
    timeout_duration_ms: Int,
    consecutive_failures: Int,
    consecutive_successes: Int,
    last_state_change_ms: Int,
    total_requests: Int,
    total_tripped: Int
};

pub fn circuit_breaker_new(
    failure_threshold: Int,
    success_threshold: Int,
    timeout_ms: Int,
    now_ms: Int
) -> CircuitBreaker {
    return CircuitBreaker {
        state: 0,
        failure_threshold: failure_threshold,
        success_threshold: success_threshold,
        timeout_duration_ms: timeout_ms,
        consecutive_failures: 0,
        consecutive_successes: 0,
        last_state_change_ms: now_ms,
        total_requests: 0,
        total_tripped: 0
    };
}

pub fn circuit_breaker_allow_request(cb: CircuitBreaker, now_ms: Int) -> CircuitBreaker {
    let next_req: Int = cb.total_requests + 1;
    let st: Int = cb.state;
    if st == 0 {
        return CircuitBreaker {
            state: 0,
            failure_threshold: cb.failure_threshold,
            success_threshold: cb.success_threshold,
            timeout_duration_ms: cb.timeout_duration_ms,
            consecutive_failures: cb.consecutive_failures,
            consecutive_successes: cb.consecutive_successes,
            last_state_change_ms: cb.last_state_change_ms,
            total_requests: next_req,
            total_tripped: cb.total_tripped
        };
    }
    if st == 1 {
        let elapsed: Int = now_ms - cb.last_state_change_ms;
        if elapsed >= cb.timeout_duration_ms {
            return CircuitBreaker {
                state: 2,
                failure_threshold: cb.failure_threshold,
                success_threshold: cb.success_threshold,
                timeout_duration_ms: cb.timeout_duration_ms,
                consecutive_failures: cb.consecutive_failures,
                consecutive_successes: 0,
                last_state_change_ms: now_ms,
                total_requests: next_req,
                total_tripped: cb.total_tripped
            };
        }
        return CircuitBreaker {
            state: 1,
            failure_threshold: cb.failure_threshold,
            success_threshold: cb.success_threshold,
            timeout_duration_ms: cb.timeout_duration_ms,
            consecutive_failures: cb.consecutive_failures,
            consecutive_successes: cb.consecutive_successes,
            last_state_change_ms: cb.last_state_change_ms,
            total_requests: next_req,
            total_tripped: cb.total_tripped
        };
    }
    return CircuitBreaker {
        state: st,
        failure_threshold: cb.failure_threshold,
        success_threshold: cb.success_threshold,
        timeout_duration_ms: cb.timeout_duration_ms,
        consecutive_failures: cb.consecutive_failures,
        consecutive_successes: cb.consecutive_successes,
        last_state_change_ms: cb.last_state_change_ms,
        total_requests: next_req,
        total_tripped: cb.total_tripped
    };
}

pub fn circuit_breaker_record_success(cb: CircuitBreaker, now_ms: Int) -> CircuitBreaker {
    if cb.state == 2 {
        let next_ok: Int = cb.consecutive_successes + 1;
        if next_ok >= cb.success_threshold {
            return CircuitBreaker {
                state: 0,
                failure_threshold: cb.failure_threshold,
                success_threshold: cb.success_threshold,
                timeout_duration_ms: cb.timeout_duration_ms,
                consecutive_failures: 0,
                consecutive_successes: 0,
                last_state_change_ms: now_ms,
                total_requests: cb.total_requests,
                total_tripped: cb.total_tripped
            };
        }
        return CircuitBreaker {
            state: 2,
            failure_threshold: cb.failure_threshold,
            success_threshold: cb.success_threshold,
            timeout_duration_ms: cb.timeout_duration_ms,
            consecutive_failures: cb.consecutive_failures,
            consecutive_successes: next_ok,
            last_state_change_ms: cb.last_state_change_ms,
            total_requests: cb.total_requests,
            total_tripped: cb.total_tripped
        };
    }
    if cb.state == 0 {
        return CircuitBreaker {
            state: 0,
            failure_threshold: cb.failure_threshold,
            success_threshold: cb.success_threshold,
            timeout_duration_ms: cb.timeout_duration_ms,
            consecutive_failures: 0,
            consecutive_successes: cb.consecutive_successes,
            last_state_change_ms: cb.last_state_change_ms,
            total_requests: cb.total_requests,
            total_tripped: cb.total_tripped
        };
    }
    return cb;
}

pub fn circuit_breaker_record_failure(cb: CircuitBreaker, now_ms: Int) -> CircuitBreaker {
    if cb.state == 2 {
        return CircuitBreaker {
            state: 1,
            failure_threshold: cb.failure_threshold,
            success_threshold: cb.success_threshold,
            timeout_duration_ms: cb.timeout_duration_ms,
            consecutive_failures: cb.consecutive_failures,
            consecutive_successes: cb.consecutive_successes,
            last_state_change_ms: now_ms,
            total_requests: cb.total_requests,
            total_tripped: cb.total_tripped + 1
        };
    }
    if cb.state == 0 {
        let next_fail: Int = cb.consecutive_failures + 1;
        if next_fail >= cb.failure_threshold {
            return CircuitBreaker {
                state: 1,
                failure_threshold: cb.failure_threshold,
                success_threshold: cb.success_threshold,
                timeout_duration_ms: cb.timeout_duration_ms,
                consecutive_failures: next_fail,
                consecutive_successes: cb.consecutive_successes,
                last_state_change_ms: now_ms,
                total_requests: cb.total_requests,
                total_tripped: cb.total_tripped + 1
            };
        }
        return CircuitBreaker {
            state: 0,
            failure_threshold: cb.failure_threshold,
            success_threshold: cb.success_threshold,
            timeout_duration_ms: cb.timeout_duration_ms,
            consecutive_failures: next_fail,
            consecutive_successes: cb.consecutive_successes,
            last_state_change_ms: cb.last_state_change_ms,
            total_requests: cb.total_requests,
            total_tripped: cb.total_tripped
        };
    }
    return cb;
}

pub fn circuit_breaker_get_state_name(state: Int) -> String {
    if state == 0 {
        return "CLOSED";
    }
    if state == 1 {
        return "OPEN";
    }
    if state == 2 {
        return "HALF_OPEN";
    }
    return "UNKNOWN";
}
