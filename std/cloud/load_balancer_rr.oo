// # Weighted Round-Robin Load Balancer (2-backend Int floor)
//
// Logline: Smooth Weighted Round-Robin for two backends. By-value destub.
//
// Setup: List[struct] destubbed to two Int backends (weight + current_weight).
//
// Beats:
//   1. new(w0, w1) stores weights; current weights start 0.
//   2. select adds weight to current, picks max, subtracts total from winner.
//   3. Nginx-style SWRR for two healthy backends.

type LoadBalancerRr = struct {
    w0: Int,
    w1: Int,
    cw0: Int,
    cw1: Int,
    last_pick: Int,
    request_n: Int
};

pub fn load_balancer_rr_new(w0: Int, w1: Int) -> LoadBalancerRr {
    return LoadBalancerRr {
        w0: w0,
        w1: w1,
        cw0: 0,
        cw1: 0,
        last_pick: 0 - 1,
        request_n: 0
    };
}

/// Select next backend index (0 or 1) via SWRR. By-value destub.
pub fn load_balancer_select_server(lb: LoadBalancerRr) -> LoadBalancerRr {
    let a: Int = lb.cw0 + lb.w0;
    let b: Int = lb.cw1 + lb.w1;
    let total: Int = lb.w0 + lb.w1;
    if a >= b {
        return LoadBalancerRr {
            w0: lb.w0,
            w1: lb.w1,
            cw0: a - total,
            cw1: b,
            last_pick: 0,
            request_n: lb.request_n + 1
        };
    }
    return LoadBalancerRr {
        w0: lb.w0,
        w1: lb.w1,
        cw0: a,
        cw1: b - total,
        last_pick: 1,
        request_n: lb.request_n + 1
    };
}

pub fn load_balancer_last_pick(lb: LoadBalancerRr) -> Int {
    return lb.last_pick;
}

pub fn load_balancer_request_n(lb: LoadBalancerRr) -> Int {
    return lb.request_n;
}
