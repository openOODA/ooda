// # OpenTelemetry Distributed Tracer
//
// Logline: Emit OpenTelemetry compatible distributed trace spans, timestamps, and metric telemetry events.
//
// Setup: Pure telemetry library for cloud-native microservice observability.
//
// Beats:
//   1. Define OpenTelemetryTracerSpan and OpenTelemetryTracerContext structures.
//   2. Create trace ID and span ID hex identifiers.
//   3. Record span start time, end time, and status codes (OK, Error).
//   4. Format W3C Trace Context headers (traceparent) for cross-service propagation.

pub type OpenTelemetryTracerSpan = struct {
    trace_id: String,
    span_id: String,
    name: String,
    duration_ms: Int,
    is_error: Bool
};

pub fn opentelemetry_tracer_span_new(trace: String, span: String, name: String, dur: Int) -> OpenTelemetryTracerSpan { return OpenTelemetryTracerSpan {
        trace_id: trace,
        span_id: span,
        name: name,
        duration_ms: dur,
        is_error: false
    }; }

pub fn opentelemetry_tracer_format_traceparent(span: OpenTelemetryTracerSpan) -> String {
    let t: String = span.trace_id;
    let s: String = span.span_id;
    let mut out: String = "00-";
    out = out + t;
    out = out + "-";
    out = out + s;
    out = out + "-01";
    return out;
}
