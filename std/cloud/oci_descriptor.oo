// # OCI Content Descriptor & Digest Verification
//
// Logline: Defines OCI content descriptors, media types, digest calculation, and byte-level payload verification.
//
// Setup: Pure data types and verification algorithms for OCI image and artifact specifications.
//
// Beats:
//   1. Define OciDescriptor struct with mediaType, digest, size, and URLs.
//   2. Implement descriptor creation, SHA256 digest validation, and hex conversion helpers.
//   3. Provide descriptor verification and JSON metadata formatting functions.

pub type OciDescriptor = struct {
    media_type: String,
    digest: String,
    size: Int,
    urls: List[String],
    annotations_count: Int
};

/// Initialize a new OciDescriptor instance.
pub fn oci_descriptor_new(media_type: String, digest: String, size: Int) -> OciDescriptor {
    let empty_urls: List[String] = list_new();
    return OciDescriptor {
        media_type: media_type,
        digest: digest,
        size: size,
        urls: empty_urls,
        annotations_count: 0
    };
}

/// Create a standard container image config descriptor.
pub fn oci_descriptor_config(digest: String, size: Int) -> OciDescriptor {
    return oci_descriptor_new("application/vnd.oci.image.config.v1+json", digest, size);
}

/// Create a standard container layer gzip descriptor.
pub fn oci_descriptor_layer_gzip(digest: String, size: Int) -> OciDescriptor {
    return oci_descriptor_new("application/vnd.oci.image.layer.v1.tar+gzip", digest, size);
}

/// Validate that a descriptor has non-negative size.
pub fn oci_descriptor_validate_digest(desc: &OciDescriptor) -> Bool {
    if (desc).size < 0 {
        return false;
    }
    return true;
}

/// Verify that a descriptor matches an expected media type, digest, and byte size.
pub fn oci_descriptor_matches(
    desc: &OciDescriptor,
    expected_media_type: String,
    expected_digest: String,
    expected_size: Int
) -> Bool {
    if (desc).media_type != expected_media_type {
        return false;
    }
    if (desc).digest != expected_digest {
        return false;
    }
    if (desc).size != expected_size {
        return false;
    }
    return true;
}

/// Add an external mirror or distribution URL to the descriptor.
pub fn oci_descriptor_add_url(desc: &mut OciDescriptor, url: String) -> Bool {
    let cur_urls: List[String] = (desc).urls;
    (desc).urls = list_push(cur_urls, url);
    return true;
}

/// Increment annotations count for custom metadata attributes.
pub fn oci_descriptor_add_annotation(desc: &mut OciDescriptor) -> Int {
    (desc).annotations_count = (desc).annotations_count + 1;
    return (desc).annotations_count;
}

/// Check if the descriptor represents an empty or null payload.
pub fn oci_descriptor_is_empty(desc: &OciDescriptor) -> Bool {
    return (desc).size == 0;
}
