// # Cloud & Distributed Systems Unified Facade
//
// Logline: Re-exports OCI, S3, Raft, Paxos, gRPC, etcd, OpenTelemetry, Rate Limiters, Circuit Breaker, Service Mesh, Load Balancer, and Cloud Stubs.
//
// Setup: Pure module shim and facade importing all 24 cloud companion submodules.
//
// Beats:
//   1. Import 24 modular Cloud & Distributed Systems subcomponents.
//   2. Re-export public constructors, capability-gated interfaces, and protocol entry points.
//   3. Maintain full backwards compatibility with downstream openOODA callers.

import "./oci_descriptor.oo";
import "./oci_layer.oo";
import "./oci_manifest.oo";
import "./s3_auth_v4.oo";
import "./s3_bucket.oo";
import "./s3_client.oo";
import "./raft_state.oo";
import "./raft_log.oo";
import "./raft_consensus.oo";
import "./paxos_proposer.oo";
import "./paxos_acceptor.oo";
import "./grpc_frame.oo";
import "./grpc_client.oo";
import "./etcd_client.oo";
import "./etcd_watch.oo";
import "./otel_span.oo";
import "./otel_trace.oo";
import "./otel_exporter.oo";
import "./rate_limiter_token_bucket.oo";
import "./rate_limiter_leaky_bucket.oo";
import "./circuit_breaker.oo";
import "./service_mesh_proxy.oo";
import "./load_balancer_rr.oo";
import "./cloud_stubs.oo";

pub fn cloud_shim_oci_descriptor(digest: String, size: Int) -> OciDescriptor {
    return oci_descriptor_config(digest, size);
}

pub fn cloud_shim_oci_manifest(config: OciDescriptor) -> OciManifest {
    return oci_manifest_new(config);
}

pub fn cloud_shim_s3_client(
    endpoint: String,
    region: String,
    key: String,
    secret: String
) -> S3Client {
    return s3_client_new(endpoint, region, key, secret);
}

pub fn cloud_shim_raft_consensus(node_id: String, peers: List[String]) -> RaftConsensusEngine {
    return raft_consensus_new(node_id, peers);
}

pub fn cloud_shim_paxos_proposer(id: Int, quorum: Int) -> PaxosProposer {
    return paxos_proposer_new(id, quorum);
}

pub fn cloud_shim_paxos_acceptor(id: Int) -> PaxosAcceptor {
    return paxos_acceptor_new(id);
}

pub fn cloud_shim_grpc_channel(target: String, timeout_ms: Int) -> GrpcChannel {
    return grpc_channel_new(target, timeout_ms);
}

pub fn cloud_shim_etcd_client(endpoint: String) -> EtcdClient {
    return etcd_client_new(endpoint);
}

pub fn cloud_shim_otel_tracer(svc: String, ver: String) -> OtelTracer {
    return otel_tracer_new(svc, ver);
}

pub fn cloud_shim_token_bucket(cap: Int, rate: Int, now_ms: Int) -> TokenBucket {
    return token_bucket_new(cap, rate, now_ms);
}

pub fn cloud_shim_leaky_bucket(cap: Int, rate: Int, now_ms: Int) -> LeakyBucket {
    return leaky_bucket_new(cap, rate, now_ms);
}

pub fn cloud_shim_circuit_breaker(fail_th: Int, succ_th: Int, timeout_ms: Int, now_ms: Int) -> CircuitBreaker {
    return circuit_breaker_new(fail_th, succ_th, timeout_ms, now_ms);
}

pub fn cloud_shim_load_balancer() -> LoadBalancerRr {
    return load_balancer_rr_new();
}

pub fn cloud_shim_fail_closed_ebpf(net: &NetCap, sys: &SysCap) -> Int {
    return cloud_ebpf_xdp_attach_filter(net, sys, "eth0", 0);
}
