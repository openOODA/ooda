// # Token Bucket Traffic Rate Limiter
//
// Logline: Classic Token Bucket for API rate limiting. By-value destub.
//
// Setup: Capacity, refill rate per second, available tokens. Int floor.
//
// Beats:
//   1. new(capacity, tokens_per_sec, now) starts full.
//   2. refill adds elapsed_ms * rate / 1000, capped at capacity.
//   3. try_consume deducts tokens or increments rejected.

type TokenBucket = struct {
    capacity: Int,
    refill_tokens_per_sec: Int,
    available_tokens: Int,
    last_refill_timestamp_ms: Int,
    total_accepted: Int,
    total_rejected: Int
};

pub fn token_bucket_new(
    capacity: Int,
    tokens_per_sec: Int,
    now_ms: Int
) -> TokenBucket {
    return TokenBucket {
        capacity: capacity,
        refill_tokens_per_sec: tokens_per_sec,
        available_tokens: capacity,
        last_refill_timestamp_ms: now_ms,
        total_accepted: 0,
        total_rejected: 0
    };
}

fn token_bucket_clamp_cap(value: Int, cap: Int) -> Int {
    if value > cap {
        return cap;
    }
    return value;
}

/// Refill tokens based on milliseconds elapsed since last refill. By-value.
pub fn token_bucket_refill(bucket: TokenBucket, now_ms: Int) -> TokenBucket {
    let elapsed_ms: Int = now_ms - bucket.last_refill_timestamp_ms;
    if elapsed_ms <= 0 {
        return bucket;
    }
    let tokens_to_add: Int = (elapsed_ms * bucket.refill_tokens_per_sec) / 1000;
    if tokens_to_add <= 0 {
        return bucket;
    }
    let new_tokens: Int = token_bucket_clamp_cap(bucket.available_tokens + tokens_to_add, bucket.capacity);
    return TokenBucket {
        capacity: bucket.capacity,
        refill_tokens_per_sec: bucket.refill_tokens_per_sec,
        available_tokens: new_tokens,
        last_refill_timestamp_ms: now_ms,
        total_accepted: bucket.total_accepted,
        total_rejected: bucket.total_rejected
    };
}

/// Attempt to consume requested tokens. By-value destub.
pub fn token_bucket_try_consume(
    bucket: TokenBucket,
    tokens: Int,
    now_ms: Int
) -> TokenBucket {
    let filled: TokenBucket = token_bucket_refill(bucket, now_ms);
    if filled.available_tokens >= tokens {
        return TokenBucket {
            capacity: filled.capacity,
            refill_tokens_per_sec: filled.refill_tokens_per_sec,
            available_tokens: filled.available_tokens - tokens,
            last_refill_timestamp_ms: filled.last_refill_timestamp_ms,
            total_accepted: filled.total_accepted + 1,
            total_rejected: filled.total_rejected
        };
    }
    return TokenBucket {
        capacity: filled.capacity,
        refill_tokens_per_sec: filled.refill_tokens_per_sec,
        available_tokens: filled.available_tokens,
        last_refill_timestamp_ms: filled.last_refill_timestamp_ms,
        total_accepted: filled.total_accepted,
        total_rejected: filled.total_rejected + 1
    };
}

/// Milliseconds until requested tokens become available.
pub fn token_bucket_time_until_available(
    bucket: TokenBucket,
    requested_tokens: Int
) -> Int {
    if bucket.available_tokens >= requested_tokens {
        return 0;
    }
    let needed: Int = requested_tokens - bucket.available_tokens;
    let rate: Int = bucket.refill_tokens_per_sec;
    if rate <= 0 {
        return 999999;
    }
    return (needed * 1000) / rate;
}

/// Reset bucket to maximum initial capacity. By-value destub.
pub fn token_bucket_reset(bucket: TokenBucket, now_ms: Int) -> TokenBucket {
    return TokenBucket {
        capacity: bucket.capacity,
        refill_tokens_per_sec: bucket.refill_tokens_per_sec,
        available_tokens: bucket.capacity,
        last_refill_timestamp_ms: now_ms,
        total_accepted: bucket.total_accepted,
        total_rejected: bucket.total_rejected
    };
}
