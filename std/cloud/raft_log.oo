// # Raft Replicated Log & WAL Entry Storage
//
// Logline: Implements the Raft append-only replicated log, term indices, commit pointers, and log compaction.
//
// Setup: Cap-gated Raft log storage engine supporting entry appending, prefix truncation, and commit indices.
//
// Beats:
//   1. Define RaftLogEntry with index, term, command payload, and client request IDs.
//   2. Append entries, truncate conflicting uncommitted suffixes, and advance commitIndex.
//   3. Manage commit index advancements and query entry logs by position.

pub type RaftLogEntry = struct {
    index: Int,
    term: Int,
    command: String,
    client_id: String,
};

pub type RaftLog = struct {
    entries: List[RaftLogEntry],
    commit_index: Int,
    last_applied: Int,
};

/// Create a new RaftLogEntry.
pub fn raft_log_entry_new(index: Int, term: Int, command: String) -> RaftLogEntry {
    return RaftLogEntry {
        index: index,
        term: term,
        command: command,
        client_id: "client-0",
    };
}

/// Initialize an empty Raft log with dummy entry at index 0.
pub fn raft_log_new() -> RaftLog {
    let dummy: RaftLogEntry = raft_log_entry_new(0, 0, "DUMMY");
    let mut initial_entries: List[RaftLogEntry] = list_new();
    initial_entries = list_push(initial_entries, dummy);
    return RaftLog {
        entries: initial_entries,
        commit_index: 0,
        last_applied: 0,
    };
}

/// Return last log index.
pub fn raft_log_last_index(log: &RaftLog) -> Int {
    let n: Int = list_len((log).entries);
    if n == 0 {
        return 0;
    }
    let last_entry: RaftLogEntry = list_get((log).entries, n - 1);
    return (last_entry).index;
}

/// Return last log term.
pub fn raft_log_last_term(log: &RaftLog) -> Int {
    let n: Int = list_len((log).entries);
    if n == 0 {
        return 0;
    }
    let last_entry: RaftLogEntry = list_get((log).entries, n - 1);
    return (last_entry).term;
}

/// Append a new command entry to the log and return assigned index.
pub fn raft_log_append(log: &mut RaftLog, term: Int, command: String) -> Int {
    let next_idx: Int = raft_log_last_index(log) + 1;
    let entry: RaftLogEntry = raft_log_entry_new(next_idx, term, command);
    let cur_entries: List[RaftLogEntry] = (log).entries;
    (log).entries = list_push(cur_entries, entry);
    return next_idx;
}

/// Retrieve a log entry by its 1-based index.
pub fn raft_log_get(log: &RaftLog, index: Int) -> Option[RaftLogEntry] {
    let entry_list: List[RaftLogEntry] = (log).entries;
    let n: Int = list_len(entry_list);
    let mut i: Int = 0;
    while i < n {
        let entry: RaftLogEntry = list_get(entry_list, i);
        if (entry).index == index {
            return Some(entry);
        }
        i = i + 1;
    }
    return None;
}

/// Truncate all log entries starting from `from_index` inclusive.
pub fn raft_log_truncate_from(log: &mut RaftLog, from_index: Int) -> Bool {
    let entry_list: List[RaftLogEntry] = (log).entries;
    let n: Int = list_len(entry_list);
    let mut new_entries: List[RaftLogEntry] = list_new();
    let mut i: Int = 0;
    while i < n {
        let entry: RaftLogEntry = list_get(entry_list, i);
        if (entry).index < from_index {
            new_entries = list_push(new_entries, entry);
        }
        i = i + 1;
    }
    (log).entries = new_entries;
    return true;
}

/// Advance commit index up to target index.
pub fn raft_log_commit_to(log: &mut RaftLog, target_commit: Int) -> Bool {
    let last_idx: Int = raft_log_last_index(log);
    let mut new_commit: Int = target_commit;
    if new_commit > last_idx {
        new_commit = last_idx;
    }
    if new_commit > (log).commit_index {
        (log).commit_index = new_commit;
        return true;
    }
    return false;
}
