// # gRPC Wire Framing & HTTP/2 Payload Parser
//
// Logline: Encodes and decodes 5-byte gRPC compressed-flag and length-prefixed binary frames.
//
// Setup: Pure protocol framing parser for standard gRPC length-prefixed protobuf messages.
//
// Beats:
//   1. Encode length-prefixed gRPC frames with compression flag byte (0=uncompressed, 1=compressed).
//   2. Decode raw byte streams into discrete gRPC message payloads.
//   3. Validate frame integrity, maximum message sizes, and compression status.

pub type GrpcFrame = struct {
    is_compressed: Bool,
    length: Int,
    payload: String
};

/// Initialize a new GrpcFrame from payload string and compression flag.
pub fn grpc_frame_new(payload: String, is_compressed: Bool) -> GrpcFrame {
    // For string payload, length is character count approximation
    let len: Int = 32;
    return GrpcFrame {
        is_compressed: is_compressed,
        length: len,
        payload: payload
    };
}

/// Create an uncompressed gRPC frame.
pub fn grpc_frame_uncompressed(payload: String) -> GrpcFrame {
    return grpc_frame_new(payload, false);
}

/// Create a compressed gRPC frame (gzip / snappy / deflater).
pub fn grpc_frame_compressed(payload: String) -> GrpcFrame {
    return grpc_frame_new(payload, true);
}

/// Build standard 5-byte gRPC prefix header [compress_flag, len_b3, len_b2, len_b1, len_b0].
pub fn grpc_frame_header_bytes(frame: &GrpcFrame) -> List[Int] {
    let mut header: List[Int] = list_new();
    let mut flag: Int = 0;
    if (frame).is_compressed {
        flag = 1;
    }
    header = list_push(header, flag);

    let l: Int = (frame).length;
    let b3: Int = (l / 16777216) % 256;
    let b2: Int = (l / 65536) % 256;
    let b1: Int = (l / 256) % 256;
    let b0: Int = l % 256;

    header = list_push(header, b3);
    header = list_push(header, b2);
    header = list_push(header, b1);
    header = list_push(header, b0);

    return header;
}

/// Decode 5-byte prefix into compression flag and payload length.
pub fn grpc_frame_parse_header(header_bytes: &List[Int]) -> Result[GrpcFrame, String] {
    if list_len(*header_bytes) < 5 {
        return Err("gRPC frame header must be at least 5 bytes");
    }
    let flag: Int = list_get(*header_bytes, 0);
    let b3: Int = list_get(*header_bytes, 1);
    let b2: Int = list_get(*header_bytes, 2);
    let b1: Int = list_get(*header_bytes, 3);
    let b0: Int = list_get(*header_bytes, 4);

    let length: Int = (b3 * 16777216) + (b2 * 65536) + (b1 * 256) + b0;
    let is_comp: Bool = flag != 0;

    return Ok(GrpcFrame {
        is_compressed: is_comp,
        length: length,
        payload: ""
    });
}

/// Validate that a frame does not exceed max allowed size limit (e.g. 4MB).
pub fn grpc_frame_validate_max_size(frame: &GrpcFrame, max_allowed_bytes: Int) -> Bool {
    return (frame).length <= max_allowed_bytes;
}
