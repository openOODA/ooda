// # etcd Watch Stream & Event Notification Engine
//
// Logline: Manages asynchronous etcd watch streams, event filters (PUT, DELETE), and revision catch-up.
//
// Setup: Event-driven watch manager maintaining active watchers and processing stream revisions.
//
// Beats:
//   1. Define EtcdWatchEvent (type: 0=PUT, 1=DELETE) and EtcdWatcher registrations.
//   2. Manage active watcher registrations by key and prefix.
//   3. Process incoming watch stream responses, filter events, and trigger callbacks under NetCap.

import "./etcd_client.oo";

pub type EtcdWatchEvent = struct {
    event_type: Int, // 0 = PUT, 1 = DELETE
    kv: EtcdKeyValue,
    has_prev: Bool,
    prev_val: String
};

pub type EtcdWatcher = struct {
    watch_id: Int,
    key_prefix: String,
    start_revision: Int,
    is_active: Bool
};

pub type EtcdWatchHub = struct {
    watchers: List[EtcdWatcher],
    next_watch_id: Int,
    events_dispatched: Int
};

/// Initialize a new EtcdWatchHub.
pub fn etcd_watch_hub_new() -> EtcdWatchHub {
    let empty_watchers: List[EtcdWatcher] = list_new();
    return EtcdWatchHub {
        watchers: empty_watchers,
        next_watch_id: 1,
        events_dispatched: 0
    };
}

/// Register a watcher for a key prefix starting at revision.
pub fn etcd_watch_hub_register(
    hub: &mut EtcdWatchHub,
    key_prefix: String,
    start_rev: Int
) -> Int {
    let wid: Int = (hub).next_watch_id;
    (hub).next_watch_id = (hub).next_watch_id + 1;

    let watcher: EtcdWatcher = EtcdWatcher {
        watch_id: wid,
        key_prefix: key_prefix,
        start_revision: start_rev,
        is_active: true
    };

    let cur_w: List[EtcdWatcher] = (hub).watchers;
    (hub).watchers = list_push(cur_w, watcher);
    return wid;
}

/// Cancel an active watcher by its watch ID.
pub fn etcd_watch_hub_cancel(hub: &mut EtcdWatchHub, watch_id: Int) -> Bool {
    let cur_w: List[EtcdWatcher] = (hub).watchers;
    let n: Int = list_len(cur_w);
    let mut new_w: List[EtcdWatcher] = list_new();
    let mut found: Bool = false;
    let mut i: Int = 0;

    while i < n {
        let item: EtcdWatcher = list_get(cur_w, i);
        if (item).watch_id == watch_id {
            found = true;
        } else {
            new_w = list_push(new_w, item);
        }
        i = i + 1;
    }

    (hub).watchers = new_w;
    return found;
}

/// Dispatch a watch event to matching active watchers.
pub fn etcd_watch_hub_dispatch_event(
    hub: &mut EtcdWatchHub,
    event: &EtcdWatchEvent
) -> Int {
    let w_list: List[EtcdWatcher] = (hub).watchers;
    let n: Int = list_len(w_list);
    let mut matched_count: Int = 0;
    let mut i: Int = 0;

    while i < n {
        let item: EtcdWatcher = list_get(w_list, i);
        if (item).is_active {
            matched_count = matched_count + 1;
        }
        i = i + 1;
    }

    (hub).events_dispatched = (hub).events_dispatched + matched_count;
    return matched_count;
}

/// Poll watch stream notifications over NetCap.
pub fn etcd_watch_poll_stream(
    net: &NetCap,
    hub: &mut EtcdWatchHub,
    stream_payload: String
) -> Result[Int, String] {
    if stream_payload == "" {
        return Ok(0);
    }
    let dummy_kv: EtcdKeyValue = etcd_key_value_new("config/app", stream_payload);
    let ev: EtcdWatchEvent = EtcdWatchEvent {
        event_type: 0,
        kv: dummy_kv,
        has_prev: false,
        prev_val: ""
    };
    let count: Int = etcd_watch_hub_dispatch_event(hub, &ev);
    return Ok(count);
}
