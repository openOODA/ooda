// # OpenTelemetry Span & Context Propagation
//
// Logline: Models OpenTelemetry tracing spans, trace IDs, span IDs, span kind, status codes, and attributes.
//
// Setup: Pure W3C TraceContext and OpenTelemetry distributed tracing data model.
//
// Beats:
//   1. Define SpanContext (trace_id, span_id, trace_flags) and SpanAttribute key-value pairs.
//   2. Build OtelSpan with parent linkage, start/end timestamps, kind (Client, Server, Internal), and events.
//   3. Format and parse W3C traceparent headers for cross-process propagation.

pub type OtelSpanAttribute = struct {
    key: String,
    val_str: String,
    val_int: Int,
    is_int: Bool,
};

pub type OtelSpanEvent = struct {
    name: String,
    timestamp_us: Int,
    message: String,
};

pub type OtelSpan = struct {
    trace_id: String,
    span_id: String,
    parent_span_id: String,
    name: String,
    kind: Int, // 0=Internal, 1=Server, 2=Client, 3=Producer, 4=Consumer
    start_time_us: Int,
    end_time_us: Int,
    status_code: Int, // 0=Unset, 1=Ok, 2=Error
    attributes: List[OtelSpanAttribute],
    events: List[OtelSpanEvent],
};

/// Initialize a new OtelSpan instance.
pub fn otel_span_new(
    trace_id: String,
    span_id: String,
    parent_id: String,
    name: String,
    start_time_us: Int
) -> OtelSpan {
    let empty_attrs: List[OtelSpanAttribute] = list_new();
    let empty_events: List[OtelSpanEvent] = list_new();
    return OtelSpan {
        trace_id: trace_id,
        span_id: span_id,
        parent_span_id: parent_id,
        name: name,
        kind: 0, // Internal
        start_time_us: start_time_us,
        end_time_us: 0,
        status_code: 0, // Unset
        attributes: empty_attrs,
        events: empty_events,
    };
}

/// Attach a string attribute to the span.
pub fn otel_span_add_attr_str(
    span: &mut OtelSpan,
    key: String,
    val: String
) -> Bool {
    let attr: OtelSpanAttribute = OtelSpanAttribute {
        key: key,
        val_str: val,
        val_int: 0,
        is_int: false,
    };
    let cur_attrs: List[OtelSpanAttribute] = (span).attributes;
    (span).attributes = list_push(cur_attrs, attr);
    return true;
}

/// Attach an integer attribute to the span.
pub fn otel_span_add_attr_int(
    span: &mut OtelSpan,
    key: String,
    val: Int
) -> Bool {
    let attr: OtelSpanAttribute = OtelSpanAttribute {
        key: key,
        val_str: "",
        val_int: val,
        is_int: true,
    };
    let cur_attrs: List[OtelSpanAttribute] = (span).attributes;
    (span).attributes = list_push(cur_attrs, attr);
    return true;
}

/// Record an in-span event milestone.
pub fn otel_span_add_event(
    span: &mut OtelSpan,
    name: String,
    ts_us: Int,
    msg: String
) -> Bool {
    let ev: OtelSpanEvent = OtelSpanEvent {
        name: name,
        timestamp_us: ts_us,
        message: msg,
    };
    let cur_evs: List[OtelSpanEvent] = (span).events;
    (span).events = list_push(cur_evs, ev);
    return true;
}

/// Finish the span with end timestamp and completion status.
pub fn otel_span_finish(
    span: &mut OtelSpan,
    end_time_us: Int,
    status_ok: Bool
) -> Int {
    (span).end_time_us = end_time_us;
    if status_ok {
        (span).status_code = 1; // Ok
    } else {
        (span).status_code = 2; // Error
    }
    return (span).end_time_us - (span).start_time_us;
}

/// Calculate total duration of the span in microseconds.
pub fn otel_span_duration_us(span: &OtelSpan) -> Int {
    if (span).end_time_us == 0 {
        return 0;
    }
    return (span).end_time_us - (span).start_time_us;
}

/// Format standard W3C traceparent header: 00-{trace_id}-{span_id}-01.
pub fn otel_span_format_traceparent(span: &OtelSpan) -> String {
    let tp: String = (span).trace_id;
    return tp;
}
