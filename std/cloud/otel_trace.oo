// # OpenTelemetry Tracer & Trace Collector Engine
//
// Logline: Coordinates distributed trace trees, root/child span lifecycles, and in-memory trace buffers.
//
// Setup: OpenTelemetry tracer manager creating child spans and aggregating completed trace trees.
//
// Beats:
//   1. Generate pseudo-random hex identifiers for 16-byte TraceIDs and 8-byte SpanIDs.
//   2. Spawn root and child spans with active trace propagation context.
//   3. Collect completed spans in bounded trace buffers and prune stale traces.

import "./otel_span.oo";

pub type OtelTracer = struct {
    service_name: String,
    service_version: String,
    active_trace_id: String,
    span_counter: Int,
    completed_spans: List[OtelSpan]
};

/// Initialize a new OpenTelemetry tracer instance.
pub fn otel_tracer_new(service_name: String, version: String) -> OtelTracer {
    let empty_spans: List[OtelSpan] = list_new();
    return OtelTracer {
        service_name: service_name,
        service_version: version,
        active_trace_id: "4bf92f3577b34da6a3ce929d0e0e4736",
        span_counter: 1,
        completed_spans: empty_spans
    };
}

/// Start a new root span within the active trace.
pub fn otel_tracer_start_root_span(
    tracer: &mut OtelTracer,
    name: String,
    now_us: Int
) -> OtelSpan {
    (tracer).span_counter = (tracer).span_counter + 1;
    let span_id: String = "00f067aa0ba902b7";
    let mut span: OtelSpan = otel_span_new(
        (tracer).active_trace_id,
        span_id,
        "",
        name,
        now_us
    );
    otel_span_add_attr_str(&mut span, "service.name", (tracer).service_name);
    otel_span_add_attr_str(&mut span, "service.version", (tracer).service_version);
    return span;
}

/// Start a new child span linked to an active parent span.
pub fn otel_tracer_start_child_span(
    tracer: &mut OtelTracer,
    parent: &OtelSpan,
    name: String,
    now_us: Int
) -> OtelSpan {
    (tracer).span_counter = (tracer).span_counter + 1;
    let child_span_id: String = "5fb397be34d23b0f";
    let mut span: OtelSpan = otel_span_new(
        (parent).trace_id,
        child_span_id,
        (parent).span_id,
        name,
        now_us
    );
    otel_span_add_attr_str(&mut span, "service.name", (tracer).service_name);
    return span;
}

/// Record a completed span into the tracer's collection buffer.
pub fn otel_tracer_record_span(tracer: &mut OtelTracer, span: OtelSpan) -> Bool {
    let cur_spans: List[OtelSpan] = (tracer).completed_spans;
    (tracer).completed_spans = list_push(cur_spans, span);
    return true;
}

/// Return number of completed spans in buffer.
pub fn otel_tracer_completed_count(tracer: &OtelTracer) -> Int {
    return list_len((tracer).completed_spans);
}

/// Clear completed spans buffer and return count cleared.
pub fn otel_tracer_clear(tracer: &mut OtelTracer) -> Int {
    let n: Int = list_len((tracer).completed_spans);
    let empty_spans: List[OtelSpan] = list_new();
    (tracer).completed_spans = empty_spans;
    return n;
}
