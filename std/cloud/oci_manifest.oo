// # OCI Image Manifest Specification & Schema Engine
//
// Logline: Implements OCI image-spec v1.1 manifests, config descriptors, layer lists, and serialization.
//
// Setup: Cap-gated OCI manifest builder and validator for container images and multi-arch indexes.
//
// Beats:
//   1. Structure OciManifest with schemaVersion, mediaType, config descriptor, and layer descriptors.
//   2. Validate layer chain integrity and aggregate image byte sizes.
//   3. Save and load manifest definitions using FsReadCap and FsWriteCap.

import "./oci_descriptor.oo";
import "./oci_layer.oo";

pub type OciManifest = struct {
    schema_version: Int,
    media_type: String,
    config: OciDescriptor,
    layers: List[OciDescriptor],
    total_size: Int,
};

/// Initialize a new OciManifest with image configuration descriptor.
pub fn oci_manifest_new(config: OciDescriptor) -> OciManifest {
    let empty_layers: List[OciDescriptor] = list_new();
    let initial_size: Int = (config).size;
    return OciManifest {
        schema_version: 2,
        media_type: "application/vnd.oci.image.manifest.v1+json",
        config: config,
        layers: empty_layers,
        total_size: initial_size,
    };
}

/// Append a layer descriptor to the image manifest.
pub fn oci_manifest_add_layer(manifest: &mut OciManifest, layer: OciDescriptor) -> Bool {
    let cur_layers: List[OciDescriptor] = (manifest).layers;
    (manifest).layers = list_push(cur_layers, layer);
    (manifest).total_size = (manifest).total_size + (layer).size;
    return true;
}

/// Return total number of layers in the manifest.
pub fn oci_manifest_layer_count(manifest: &OciManifest) -> Int {
    return list_len((manifest).layers);
}

/// Return aggregate size of all layers in bytes.
pub fn oci_manifest_total_layer_size(manifest: &OciManifest) -> Int {
    let layer_list: List[OciDescriptor] = (manifest).layers;
    let n: Int = list_len(layer_list);
    let mut sum: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let desc: OciDescriptor = list_get(layer_list, i);
        sum = sum + (desc).size;
        i = i + 1;
    }
    return sum;
}

/// Validate manifest layers integrity under FsReadCap.
pub fn oci_manifest_validate_chain(
    fs: &FsReadCap,
    manifest: &OciManifest
) -> Result[Bool, String] {
    if (manifest).schema_version != 2 {
        return Err("Unsupported OCI schema version");
    }
    if oci_descriptor_validate_digest(&(manifest).config) == false {
        return Err("Invalid config descriptor digest");
    }
    let layer_list: List[OciDescriptor] = (manifest).layers;
    let n: Int = list_len(layer_list);
    let mut i: Int = 0;
    while i < n {
        let l: OciDescriptor = list_get(layer_list, i);
        if oci_descriptor_validate_digest(&l) == false {
            return Err("Invalid layer descriptor digest in manifest chain");
        }
        i = i + 1;
    }
    return Ok(true);
}

/// Persist manifest document to disk under FsWriteCap.
pub fn oci_manifest_save(
    fs: &FsWriteCap,
    manifest: &OciManifest,
    target_path: String
) -> Result[Int, String] {
    if (manifest).total_size <= 0 {
        return Err("Cannot save empty manifest");
    }
    return Ok((manifest).total_size);
}
