// # Raft Node State & Election Role Machine
//
// Logline: Models Raft distributed consensus node roles (Follower, Candidate, Leader), terms, and voting records.
//
// Setup: Pure state machine for Raft peer identity, term transitions, and election heartbeats.
//
// Beats:
//   1. Define RaftRole enumerations (0=Follower, 1=Candidate, 2=Leader) and RaftNodeState.
//   2. Manage term increments, votedFor tracking, and election timeout resets.
//   3. Transition node roles upon quorum election win or higher-term discovery.

type RaftNodeState = struct {
    node_id: String,
    current_term: Int,
    voted_for: String,
    role: Int,
    leader_id: String,
    election_timeout_ms: Int,
    heartbeat_timeout_ms: Int,
    last_heard_ms: Int
};

/// Initialize a new RaftNodeState in Follower role at term 0.
pub fn raft_state_new(node_id: String, election_timeout_ms: Int) -> RaftNodeState {
    return RaftNodeState {
        node_id: node_id,
        current_term: 0,
        voted_for: "",
        role: 0,
        leader_id: "",
        election_timeout_ms: election_timeout_ms,
        heartbeat_timeout_ms: election_timeout_ms / 3,
        last_heard_ms: 0
    };
}

/// Transition state to Follower role upon hearing higher term or valid leader.
pub fn raft_state_become_follower(state: RaftNodeState, term: Int, leader_id: String) -> RaftNodeState {
    return RaftNodeState {
        node_id: state.node_id,
        current_term: term,
        voted_for: "",
        role: 0,
        leader_id: leader_id,
        election_timeout_ms: state.election_timeout_ms,
        heartbeat_timeout_ms: state.heartbeat_timeout_ms,
        last_heard_ms: state.last_heard_ms
    };
}

/// Start an election by incrementing term, voting for self, and transitioning to Candidate.
pub fn raft_state_start_election(state: RaftNodeState) -> RaftNodeState {
    let next_term: Int = state.current_term + 1;
    return RaftNodeState {
        node_id: state.node_id,
        current_term: next_term,
        voted_for: state.node_id,
        role: 1,
        leader_id: "",
        election_timeout_ms: state.election_timeout_ms,
        heartbeat_timeout_ms: state.heartbeat_timeout_ms,
        last_heard_ms: state.last_heard_ms
    };
}

/// Transition from Candidate to Leader upon securing a majority quorum.
pub fn raft_state_become_leader(state: RaftNodeState) -> RaftNodeState {
    if state.role != 1 {
        return state;
    }
    return RaftNodeState {
        node_id: state.node_id,
        current_term: state.current_term,
        voted_for: state.voted_for,
        role: 2,
        leader_id: state.node_id,
        election_timeout_ms: state.election_timeout_ms,
        heartbeat_timeout_ms: state.heartbeat_timeout_ms,
        last_heard_ms: state.last_heard_ms
    };
}

/// Record a vote for a candidate in the specified term if not yet voted.
pub fn raft_state_record_vote(state: RaftNodeState, candidate_id: String, term: Int) -> RaftNodeState {
    if term > state.current_term {
        return RaftNodeState {
            node_id: state.node_id,
            current_term: term,
            voted_for: candidate_id,
            role: 0,
            leader_id: state.leader_id,
            election_timeout_ms: state.election_timeout_ms,
            heartbeat_timeout_ms: state.heartbeat_timeout_ms,
            last_heard_ms: state.last_heard_ms
        };
    }
    if term == state.current_term {
        if state.voted_for == "" {
            return RaftNodeState {
                node_id: state.node_id,
                current_term: state.current_term,
                voted_for: candidate_id,
                role: state.role,
                leader_id: state.leader_id,
                election_timeout_ms: state.election_timeout_ms,
                heartbeat_timeout_ms: state.heartbeat_timeout_ms,
                last_heard_ms: state.last_heard_ms
            };
        }
        return state;
    }
    return state;
}

/// Check if the local node is currently acting as cluster Leader.
pub fn raft_state_is_leader(state: RaftNodeState) -> Bool {
    return state.role == 2;
}

/// Check if the local node is currently in Candidate state.
pub fn raft_state_is_candidate(state: RaftNodeState) -> Bool {
    return state.role == 1;
}
