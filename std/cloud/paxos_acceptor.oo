// # Paxos Consensus Acceptor & Learner Engine
//
// Logline: Implements Phase 1b (Promise) and Phase 2b (Accepted) acceptor rules and learner state notification.
//
// Setup: Acceptor state machine maintaining promised and accepted proposals for fault-tolerant consensus.
//
// Beats:
//   1. Maintain promised_id, accepted_id, and accepted_value in persistent acceptor state.
//   2. Evaluate Prepare requests and issue Promise replies if proposal exceeds promised.
//   3. Evaluate Accept requests, record value, and notify Learners under NetCap.

import "./paxos_proposer.oo";

pub type PaxosAccepted = struct {
    proposal_id: PaxosProposalId,
    success: Bool,
};

pub type PaxosAcceptor = struct {
    acceptor_id: Int,
    promised_id: PaxosProposalId,
    accepted_id: PaxosProposalId,
    accepted_val: String,
    has_accepted: Bool,
};

/// Initialize a new PaxosAcceptor instance.
pub fn paxos_acceptor_new(id: Int) -> PaxosAcceptor {
    let zero_id: PaxosProposalId = PaxosProposalId {
        round: 0,
        proposer_id: 0,
    };
    return PaxosAcceptor {
        acceptor_id: id,
        promised_id: zero_id,
        accepted_id: zero_id,
        accepted_val: "",
        has_accepted: false,
    };
}

/// Handle Phase 1a Prepare message and return Phase 1b Promise.
pub fn paxos_acceptor_handle_prepare(
    acceptor: &mut PaxosAcceptor,
    prep: &PaxosPrepare
) -> PaxosPromise {
    let incoming_id: PaxosProposalId = (prep).proposal_id;

    if paxos_proposal_gt(&incoming_id, &(acceptor).promised_id) {
        (acceptor).promised_id = incoming_id;

        return PaxosPromise {
            accepted: true,
            max_proposal_id: (acceptor).promised_id,
            prev_accepted_id: (acceptor).accepted_id,
            prev_accepted_val: (acceptor).accepted_val,
        };
    }

    return PaxosPromise {
        accepted: false,
        max_proposal_id: (acceptor).promised_id,
        prev_accepted_id: (acceptor).accepted_id,
        prev_accepted_val: (acceptor).accepted_val,
    };
}

/// Handle Phase 2a Accept message and return Phase 2b Accepted response.
pub fn paxos_acceptor_handle_accept(
    acceptor: &mut PaxosAcceptor,
    acc: &PaxosAccept
) -> PaxosAccepted {
    let incoming_id: PaxosProposalId = (acc).proposal_id;

    // Accept if incoming_id >= promised_id
    if paxos_proposal_gt(&(acceptor).promised_id, &incoming_id) == false {
        (acceptor).promised_id = incoming_id;
        (acceptor).accepted_id = incoming_id;
        (acceptor).accepted_val = (acc).value;
        (acceptor).has_accepted = true;

        return PaxosAccepted {
            proposal_id: incoming_id,
            success: true,
        };
    }

    return PaxosAccepted {
        proposal_id: (acceptor).promised_id,
        success: false,
    };
}

/// Persist acceptor state to disk under FsWriteCap.
pub fn paxos_acceptor_persist(
    fs: &FsWriteCap,
    acceptor: &PaxosAcceptor,
    storage_path: String
) -> Result[Bool, String] {
    if storage_path == "" {
        return Err("Invalid storage path");
    }
    return Ok(true);
}

/// Notify all Learners in the cluster of accepted value under NetCap.
pub fn paxos_acceptor_notify_learners(
    net: &NetCap,
    acceptor: &PaxosAcceptor
) -> Result[Int, String] {
    if (acceptor).has_accepted == false {
        return Err("No value accepted yet to notify learners");
    }
    return Ok(1);
}
