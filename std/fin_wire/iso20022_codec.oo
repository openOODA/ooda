// # ISO 20022 pacs.008 field codec
//
// Logline: Parses a compact pacs.008 payment with MsgId, amount, currency, debtor, and creditor.
//
// Setup: Pure. Fields are key=value pairs split by 124. Missing required fields or a negative amount is Err.
//
// Beats:
//   1. Split the wire on '|'.
//   2. Read MsgId, Amt, Ccy, Dbtr, and Cdtr.
//   3. Require a positive amount and a 3-letter currency.
//   4. Reject a truncated or unknown required field.

pub type IsoOut = struct {
    flag: Int,
    err: String,
    amt: Int,
    nfield: Int
};

fn iso_err(m: String) -> IsoOut {
    return IsoOut { flag: 0, err: "ERR\tiso: " + m, amt: 0, nfield: 0 };
}

fn iso_slice(s: String, a: Int, b: Int) -> String {
    let mut buf: List[Int] = bytes_new();
    let mut i: Int = a;
    while i < b {
        buf = bytes_push(buf, byte_at(s, i));
        i = i + 1;
    }
    return bytes_to_str(buf);
}

pub fn iso20022_codec_parse(src: String) -> IsoOut {
    let n: Int = bytes_len(src);
    if n < 8 {
        return iso_err("short");
    }
    let head: String = iso_slice(src, 0, 8);
    if head != "pacs.008" {
        return iso_err("msg");
    }
    let mut i: Int = 0;
    let mut amt: Int = 0 - 1;
    let mut nfield: Int = 0;
    let mut has_id: Int = 0;
    let mut has_ccy: Int = 0;
    let mut has_db: Int = 0;
    let mut has_cd: Int = 0;
    while i < n {
        if byte_at(src, i) == 124 {
            let mut j: Int = i + 1;
            while j < n {
                if byte_at(src, j) == 124 {
                    break;
                }
                j = j + 1;
            }
            let field: String = iso_slice(src, i + 1, j);
            let fnn: Int = bytes_len(field);
            let mut eq: Int = 0 - 1;
            let mut k: Int = 0;
            while k < fnn {
                if byte_at(field, k) == 61 {
                    eq = k;
                    break;
                }
                k = k + 1;
            }
            if eq > 0 {
                let key: String = iso_slice(field, 0, eq);
                let val: String = iso_slice(field, eq + 1, fnn);
                nfield = nfield + 1;
                if key == "MsgId" {
                    has_id = 1;
                }
                if key == "Ccy" {
                    if bytes_len(val) != 3 {
                        return iso_err("ccy");
                    }
                    has_ccy = 1;
                }
                if key == "Dbtr" {
                    has_db = 1;
                }
                if key == "Cdtr" {
                    has_cd = 1;
                }
                if key == "Amt" {
                    let mut v: Int = 0;
                    let mut p: Int = 0;
                    while p < bytes_len(val) {
                        let d: Int = byte_at(val, p);
                        if d < 48 {
                            return iso_err("amt");
                        }
                        if d > 57 {
                            return iso_err("amt");
                        }
                        v = v * 10 + (d - 48);
                        p = p + 1;
                    }
                    amt = v;
                }
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    if has_id < 1 {
        return iso_err("msgid");
    }
    if amt < 0 {
        return iso_err("amt");
    }
    if has_ccy < 1 {
        return iso_err("ccy");
    }
    if has_db < 1 {
        return iso_err("dbtr");
    }
    if has_cd < 1 {
        return iso_err("cdtr");
    }
    return IsoOut { flag: 1, err: "", amt: amt, nfield: nfield };
}

pub fn iso20022_codec_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn iso20022_codec_flag(o: IsoOut) -> Int {
    return o.flag;
}
pub fn iso20022_codec_err(o: IsoOut) -> String {
    return o.err;
}
pub fn iso20022_codec_amt(o: IsoOut) -> Int {
    return o.amt;
}
