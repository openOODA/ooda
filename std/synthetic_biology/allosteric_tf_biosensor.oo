// # Allosteric Transcription Factor (aTF) Biosensor Dose-Response
//
// Logline: Models ligand-induced allosteric transitions, operator dissociation, and sigmoidal biosensor transfer functions.
//
// Setup: Monod-Wyman-Changeux (MWC) biophysical dose-response model predicting effective transcription output across analyte concentrations.
//
// Beats:
//   1. Define AtfSensorParams, LigandTitrationPoint, and BiosensorResponseResult data structures.
//   2. Compute allosteric state equilibrium constant L = [T]/[R] and fractional operator occupancy.
//   3. Calculate EC50, Hill coefficient n_eff, dynamic range, and limit of detection (LOD).

pub type AtfSensorParams = struct {
    tf_name: String,
    target_analyte: String,
    kd_active_r_state_u_m: Float,
    kd_inactive_t_state_u_m: Float,
    allosteric_constant_l0: Float, // [T0]/[R0] ratio without ligand
    basal_fluorescence: Float,
    maximal_fluorescence: Float
};

pub type LigandTitrationPoint = struct {
    analyte_conc_u_m: Float,
    temperature_k: Float
};

pub type BiosensorResponseResult = struct {
    fraction_active_r: Float,
    promoter_output: Float,
    signal_to_noise: Float,
    is_detectable: Bool
};

pub fn atf_calc_r_fraction(
    ligand_um: Float,
    kr: Float,
    kt: Float,
    l0: Float,
) -> Float {
    if ligand_um <= 0.0 {
        return 1.0 / (1.0 + l0);
    }
    // MWC 2-site model fraction:
    let alpha = ligand_um / kr;
    let beta = ligand_um / kt;

    let num = (1.0 + alpha) * (1.0 + alpha);
    let den_t = l0 * (1.0 + beta) * (1.0 + beta);
    let denom = num + den_t;

    if denom <= 0.0001 { return 0.0; }
    return num / denom;
}

pub fn atf_evaluate_dose_response(
    p: &AtfSensorParams,
    point: &LigandTitrationPoint,
) -> BiosensorResponseResult {
    let r_frac = atf_calc_r_fraction(
        (point).analyte_conc_u_m,
        (p).kd_active_r_state_u_m,
        (p).kd_inactive_t_state_u_m,
        (p).allosteric_constant_l0,
    );

    // If repressor: high R-state binds DNA and represses; ligand induces expression
    let induced_frac = 1.0 - r_frac;
    let output = (p).basal_fluorescence + (((p).maximal_fluorescence - (p).basal_fluorescence) * induced_frac);

    let base = if (p).basal_fluorescence > 0.001 { (p).basal_fluorescence } else { 0.001 };
    let snr = (output - base) / base;
    let detectable = snr > 0.2; // 20% above basal noise floor

    return BiosensorResponseResult {
        fraction_active_r: r_frac,
        promoter_output: output,
        signal_to_noise: snr,
        is_detectable: detectable
    };
}
