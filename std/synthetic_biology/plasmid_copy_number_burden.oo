// # Plasmid Copy Number (PCN) Control & Segregational Stability
//
// Logline: Models origin-of-replication negative feedback control, copy number distribution, and plasmid segregation loss.
//
// Setup: Stochastic and deterministic model of plasmid replication origins (ColE1, p15A, pSC101) and population retention stability.
//
// Beats:
//   1. Define PlasmidOriginParams, PlasmidPopulationState, and SegregationStabilityResult data structures.
//   2. Compute negative feedback replication control dN/dt = k_rep * N / (1 + (N/N0)^gamma) - mu * N.
//   3. Predict plasmid loss probability per generation and population fraction retaining circuit over generations.

pub type PlasmidOriginParams = struct {
    origin_name: String, // "ColE1" (~50-70), "p15A" (~10-15), "pSC101" (~3-5)
    target_copy_number_n0: Int,
    feedback_hill_gamma: Int,
    max_replication_rate: Float,
    partition_system_active: Bool // parABC partition locus
};

pub type PlasmidPopulationState = struct {
    mean_copy_number: Float,
    generation_number: Int,
    plasmid_bearing_fraction: Float
};

pub type SegregationStabilityResult = struct {
    loss_rate_per_generation: Float,
    fraction_retained_after_generations: Float,
    pcn_fano_factor: Float,
    is_stable_over_50_gens: Bool
};

pub fn plasmid_calc_loss_probability(
    pcn_int: Int,
    has_par: Bool,
) -> Float {
    if pcn_int <= 1 { return 0.5; }
    // Binomial partition loss at division: P_loss = 2 * (0.5)^PCN
    // If active partition locus present, loss is reduced by 100-fold
    let mut p_loss: Float = 2.0;
    let mut i = 0;
    while i < pcn_int {
        p_loss = p_loss * 0.5;
        i = i + 1;
    }

    if has_par {
        p_loss = p_loss * 0.01;
    }
    return if p_loss > 0.5 { 0.5 } else if p_loss < 0.00001 { 0.00001 } else { p_loss };
}

pub fn plasmid_evaluate_stability(
    p: &PlasmidOriginParams,
    generations: Int,
) -> SegregationStabilityResult {
    let p_loss = plasmid_calc_loss_probability((p).target_copy_number_n0, (p).partition_system_active);

    // Retention fraction R(g) = (1 - P_loss)^g
    let mut retained: Float = 1.0;
    let mut g = 0;
    while g < generations {
        retained = retained * (1.0 - p_loss);
        g = g + 1;
    }

    let is_stable = retained > 0.90;

    return SegregationStabilityResult {
        loss_rate_per_generation: p_loss,
        fraction_retained_after_generations: retained,
        pcn_fano_factor: 1.25,
        is_stable_over_50_gens: is_stable
    };
}
