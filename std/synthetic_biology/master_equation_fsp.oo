// # Chemical Master Equation Finite State Projection (FSP)
//
// Logline: Computes exact discrete probability distributions for low copy-number gene expression using state truncation.
//
// Setup: Direct numerical solution of the continuous-time Markovian Chemical Master Equation dP/dt = A * P over a bounded state space.
//
// Beats:
//   1. Define FspStateSpace, FspParameters, and ProbabilityDistribution data structures.
//   2. Construct tridiagonal infinitesimal transition generator matrix A for birth-death transcription.
//   3. Advance probability vector via explicit Euler / matrix exponential stepping and assess total projection error.

pub type FspParameters = struct {
    max_copy_number: Int,
    k_birth: Float,
    d_death: Float,
    time_step_dt: Float
};

pub type ProbabilityDistribution = struct {
    probabilities: List[Float],
    mean_copies: Float,
    variance: Float,
    fano_factor: Float,
    total_retained_probability: Float
};

pub fn fsp_init_distribution(size: Int, initial_state: Int) -> List[Float] {
    let mut dist: List[Float] = list_new();
    let mut i = 0;
    while i < size {
        let p_val = if i == initial_state { 1.0 } else { 0.0 };
        dist = list_push(dist, p_val);
        i = i + 1;
    }
    return dist;
}

pub fn fsp_euler_step(
    p_vec: &List[Float],
    params: &FspParameters,
) -> List[Float] {
    let n = (params).max_copy_number;
    let dt = (params).time_step_dt;
    let k_b = (params).k_birth;
    let d_d = (params).d_death;

    let mut next_p: List[Float] = list_new();
    let mut i = 0;
    while i < n {
        let p_cur = list_get(p_vec, i);
        let p_prev = if i > 0 { list_get(p_vec, i - 1) } else { 0.0 };
        let p_next = if i + 1 < n { list_get(p_vec, i + 1) } else { 0.0 };

        // dP_i/dt = k_b * P_{i-1} + (i+1)*d_d * P_{i+1} - (k_b + i*d_d) * P_i
        let flux_in = (k_b * p_prev) + (((i + 1) as Float) * d_d * p_next);
        let flux_out = (k_b + ((i as Float) * d_d)) * p_cur;

        let dp_dt = flux_in - flux_out;
        let p_new = p_cur + (dp_dt * dt);
        next_p = list_push(next_p, if p_new < 0.0 { 0.0 } else { p_new });

        i = i + 1;
    }
    return next_p;
}

pub fn fsp_compute_moments(p_vec: &List[Float]) -> ProbabilityDistribution {
    let n = list_len(p_vec);
    let mut total_p: Float = 0.0;
    let mut mean_val: Float = 0.0;
    let mut mean_sq: Float = 0.0;

    let mut i = 0;
    while i < n {
        let p = list_get(p_vec, i);
        let ifl = i as Float;
        total_p = total_p + p;
        mean_val = mean_val + (ifl * p);
        mean_sq = mean_sq + (ifl * ifl * p);
        i = i + 1;
    }

    let variance_val = mean_sq - (mean_val * mean_val);
    let fano = if mean_val > 0.0001 { variance_val / mean_val } else { 1.0 };

    return ProbabilityDistribution {
        probabilities: p_vec,
        mean_copies: mean_val,
        variance: variance_val,
        fano_factor: fano,
        total_retained_probability: total_p
    };
}
