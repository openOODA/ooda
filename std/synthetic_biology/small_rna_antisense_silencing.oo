// # Synthetic Small RNA (sRNA) Post-Transcriptional Gene Silencing
//
// Logline: Models stoichiometric antisense sRNA-mRNA duplex formation, Hfq chaperone facilitation, and RNase degradation.
//
// Setup: Post-transcriptional gene regulatory ODE model capturing threshold titration and fast silencing kinetics.
//
// Beats:
//   1. Define SrnaSilencingParams, SrnaState, and SilencingResponseResult data structures.
//   2. Compute 3-variable ODE derivatives for free sRNA, free target mRNA, and sRNA-mRNA duplex complex.
//   3. Step silencing dynamics using Runge-Kutta numerical integration and calculate target knockdown percentage.

pub type SrnaSilencingParams = struct {
    k_tx_srna: Float,
    k_tx_mrna: Float,
    k_bind_duplex: Float,
    d_free_srna: Float,
    d_free_mrna: Float,
    d_duplex_cleavage: Float // Fast RNase E degradation of coupled complex
};

pub type SrnaState = struct {
    srna_conc: Float,
    target_mrna_conc: Float,
    duplex_conc: Float,
    time_min: Float
};

pub type SilencingResponseResult = struct {
    free_mrna: Float,
    knockdown_efficiency_percent: Float,
    is_threshold_surpassed: Bool
};

pub fn srna_derivatives(
    st: &SrnaState,
    p: &SrnaSilencingParams,
) -> SrnaState {
    let bind_rate = (p).k_bind_duplex * (st).srna_conc * (st).target_mrna_conc;

    // d[sRNA]/dt = k_tx_srna - d_free_srna*[sRNA] - bind_rate
    let d_srna = (p).k_tx_srna - ((p).d_free_srna * (st).srna_conc) - bind_rate;

    // d[mRNA]/dt = k_tx_mrna - d_free_mrna*[mRNA] - bind_rate
    let d_mrna = (p).k_tx_mrna - ((p).d_free_mrna * (st).target_mrna_conc) - bind_rate;

    // d[Duplex]/dt = bind_rate - d_duplex_cleavage*[Duplex]
    let d_dup = bind_rate - ((p).d_duplex_cleavage * (st).duplex_conc);

    return SrnaState {
        srna_conc: d_srna,
        target_mrna_conc: d_mrna,
        duplex_conc: d_dup,
        time_min: (st).time_min
    };
}

pub fn srna_rk4_step(
    st: &SrnaState,
    p: &SrnaSilencingParams,
    dt: Float,
) -> SrnaState {
    let k1 = srna_derivatives(st, p);

    let s2 = SrnaState {
        srna_conc: (st).srna_conc + (0.5 * dt * (k1).srna_conc),
        target_mrna_conc: (st).target_mrna_conc + (0.5 * dt * (k1).target_mrna_conc),
        duplex_conc: (st).duplex_conc + (0.5 * dt * (k1).duplex_conc),
        time_min: (st).time_min + (0.5 * dt)
    };
    let k2 = srna_derivatives(&s2, p);

    let s3 = SrnaState {
        srna_conc: (st).srna_conc + (0.5 * dt * (k2).srna_conc),
        target_mrna_conc: (st).target_mrna_conc + (0.5 * dt * (k2).target_mrna_conc),
        duplex_conc: (st).duplex_conc + (0.5 * dt * (k2).duplex_conc),
        time_min: (st).time_min + (0.5 * dt)
    };
    let k3 = srna_derivatives(&s3, p);

    let s4 = SrnaState {
        srna_conc: (st).srna_conc + (dt * (k3).srna_conc),
        target_mrna_conc: (st).target_mrna_conc + (dt * (k3).target_mrna_conc),
        duplex_conc: (st).duplex_conc + (dt * (k3).duplex_conc),
        time_min: (st).time_min + dt
    };
    let k4 = srna_derivatives(&s4, p);

    let next_s = (st).srna_conc + (dt / 6.0) * ((k1).srna_conc + (2.0 * (k2).srna_conc) + (2.0 * (k3).srna_conc) + (k4).srna_conc);
    let next_m = (st).target_mrna_conc + (dt / 6.0) * ((k1).target_mrna_conc + (2.0 * (k2).target_mrna_conc) + (2.0 * (k3).target_mrna_conc) + (k4).target_mrna_conc);
    let next_d = (st).duplex_conc + (dt / 6.0) * ((k1).duplex_conc + (2.0 * (k2).duplex_conc) + (2.0 * (k3).duplex_conc) + (k4).duplex_conc);

    return SrnaState {
        srna_conc: if next_s < 0.0 { 0.0 } else { next_s },
        target_mrna_conc: if next_m < 0.0 { 0.0 } else { next_m },
        duplex_conc: if next_d < 0.0 { 0.0 } else { next_d },
        time_min: (st).time_min + dt
    };
}
