// # Synthetic Scaffold-Mediated Substrate Channeling & Metabolons
//
// Logline: Models proximity-accelerated reaction flux and toxic intermediate sequestration on synthetic protein scaffolds.
//
// Setup: Reaction-diffusion proximity model (Dueber-Keasling scaffold architecture) optimizing spatial enzyme stoichiometric ratios.
//
// Beats:
//   1. Define ScaffoldArchitecture, ChannelingKineticsParams, and MetabolonPerformanceResult data structures.
//   2. Compute intermediate capture efficiency fraction as a function of inter-enzyme spatial distance and bulk diffusion.
//   3. Predict pathway flux enhancement fold and reduction in toxic intermediate leakage.

pub type ScaffoldArchitecture = struct {
    num_e1_domains: Int,
    num_e2_domains: Int,
    num_e3_domains: Int,
    inter_enzyme_distance_nm: Float,
    scaffold_loading_efficiency: Float
};

pub type ChannelingKineticsParams = struct {
    intermediate_diffusion_coeff_um2_per_s: Float,
    e2_capture_radius_nm: Float,
    bulk_e2_conc_u_m: Float,
    intermediate_toxicity_threshold_m_m: Float
};

pub type MetabolonPerformanceResult = struct {
    channeling_efficiency_fraction: Float,
    pathway_flux_enhancement_fold: Float,
    intermediate_leakage_fraction: Float,
    is_toxicity_prevented: Bool
};

pub fn metabolon_calc_capture_efficiency(
    dist_nm: Float,
    capture_radius_nm: Float,
    diff_coeff: Float,
) -> Float {
    if dist_nm <= capture_radius_nm { return 0.99; }
    // Proximity capture decreases with distance squared
    let ratio = capture_radius_nm / dist_nm;
    let eff = ratio * ratio * 0.95;
    return if eff > 0.99 { 0.99 } else if eff < 0.05 { 0.05 } else { eff };
}

pub fn metabolon_evaluate_scaffold(
    arch: &ScaffoldArchitecture,
    p: &ChannelingKineticsParams,
) -> MetabolonPerformanceResult {
    let eff = metabolon_calc_capture_efficiency(
        (arch).inter_enzyme_distance_nm,
        (p).e2_capture_radius_nm,
        (p).intermediate_diffusion_coeff_um2_per_s,
    );

    let load_eff = (arch).scaffold_loading_efficiency;
    let net_channeling = eff * load_eff;

    // Flux enhancement fold: up to 10-75x with optimal scaffolding
    let enhancement = 1.0 + (15.0 * net_channeling);
    let leak = 1.0 - net_channeling;
    let tox_safe = leak < 0.25;

    return MetabolonPerformanceResult {
        channeling_efficiency_fraction: net_channeling,
        pathway_flux_enhancement_fold: enhancement,
        intermediate_leakage_fraction: leak,
        is_toxicity_prevented: tox_safe
    };
}
