// # Ribozyme & Aptazyme Self-Cleavage Kinetics
//
// Logline: Models hammerhead and twister catalytic RNA self-cleavage rates, magnesium cofactor dependence, and aptamer gating.
//
// Setup: Kinetic model evaluating catalytic RNA processing for RNA circuit tuning, transcript half-life regulation, and metabolic biosensing.
//
// Beats:
//   1. Define RibozymeKineticsParams, LigandGatingState, and CleavageProgressResult data structures.
//   2. Compute magnesium-dependent observed cleavage rate constant k_obs and ligand-dependent allosteric switching fraction.
//   3. Predict intact full-length RNA fraction remaining over reaction incubation time.

pub type RibozymeKineticsParams = struct {
    k_cleave_max_per_min: Float, // e.g. 1.5 min^-1 for fast hammerhead
    k_basal_leak_per_min: Float,
    mg_half_saturation_m_m: Float, // Mg2+ requirement ~ 1.0 mM
    kd_ligand_u_m: Float,
    is_cleavage_activated_by_ligand: Bool,
};

pub type LigandGatingState = struct {
    ligand_conc_u_m: Float,
    mg_conc_m_m: Float,
    time_minutes: Float,
};

pub type CleavageProgressResult = struct {
    k_obs_per_min: Float,
    intact_fraction_remaining: Float,
    cleaved_fraction: Float,
    half_life_min: Float,
};

pub fn ribozyme_math_exp_neg(val: Float) -> Float {
    if val > 12.0 { return 0.000006; }
    let mut term: Float = 1.0;
    let mut sum: Float = 1.0;
    let x = -val;
    let mut i = 1;
    while i <= 8 {
        term = term * (x / (i as Float));
        sum = sum + term;
        i = i + 1;
    }
    return if sum < 0.0 { 0.0 } else { sum };
}

pub fn ribozyme_evaluate_cleavage(
    p: &RibozymeKineticsParams,
    st: &LigandGatingState,
) -> CleavageProgressResult {
    // Magnesium factor: [Mg2+] / (K_Mg + [Mg2+])
    let mg_frac = (st).mg_conc_m_m / ((p).mg_half_saturation_m_m + (st).mg_conc_m_m);

    // Ligand allosteric factor
    let lig_frac = if (st).ligand_conc_u_m > 0.0 {
        (st).ligand_conc_u_m / ((p).kd_ligand_u_m + (st).ligand_conc_u_m)
    } else {
        0.0
    };

    let active_frac = if (p).is_cleavage_activated_by_ligand {
        lig_frac
    } else {
        1.0 - lig_frac
    };

    let k_obs = (p).k_basal_leak_per_min + ((p).k_cleave_max_per_min * mg_frac * active_frac);

    // Fraction remaining: F(t) = exp(-k_obs * t)
    let f_intact = ribozyme_math_exp_neg(k_obs * (st).time_minutes);
    let f_cleaved = 1.0 - f_intact;
    let t_half = if k_obs > 0.0001 { 0.693147 / k_obs } else { 9999.0 };

    return CleavageProgressResult {
        k_obs_per_min: k_obs,
        intact_fraction_remaining: f_intact,
        cleaved_fraction: if f_cleaved < 0.0 { 0.0 } else { f_cleaved },
        half_life_min: t_half,
    };
}
