// # 5' UTR mRNA Secondary Structure & Free Energy (dG)
//
// Logline: Calculates mRNA stem-loop hairpin Gibbs free energy and predicts ribosomal accessibility inhibition.
//
// Setup: Nearest-neighbor thermodynamic model calculating base-pairing stability and translation initiation inhibition.
//
// Beats:
//   1. Define RnaBasePair, HairpinStructure, and StructureStabilityResult data structures.
//   2. Compute nearest-neighbor stacking free energies (GC, AU, GU wobble pairs) and loop initiation penalties.
//   3. Predict translation initiation blockage ratio based on Delta-G of structure covering the RBS.

pub type RnaBasePair = struct {
    pos_5p: Int,
    pos_3p: Int,
    pair_type: String, // "GC", "AU", "GU"
    stacking_dg_kcal: Float,
};

pub type HairpinStructure = struct {
    stem_length_bp: Int,
    loop_length_nt: Int,
    gc_count: Int,
    au_count: Int,
    gu_count: Int,
};

pub type StructureStabilityResult = struct {
    dg_folding_kcal_per_mol: Float,
    is_stable: Bool,
    translation_inhibition_fraction: Float,
    melting_temp_celsius: Float,
};

pub fn mrna_calc_stacking_energy(p1: String, p2: String) -> Float {
    // Nearest-neighbor stacking parameters at 37 C (kcal/mol)
    if p1 == "GC" && p2 == "GC" { return -3.3; }
    if p1 == "GC" && p2 == "CG" { return -2.4; }
    if p1 == "AU" && p2 == "AU" { return -0.9; }
    if p1 == "AU" && p2 == "UA" { return -1.1; }
    if p1 == "GC" && p2 == "AU" { return -2.2; }
    if p1 == "AU" && p2 == "GC" { return -2.1; }
    if p1 == "GU" || p2 == "GU" { return -0.5; }
    return -1.5;
}

pub fn mrna_calc_hairpin_loop_penalty(loop_len: Int) -> Float {
    if loop_len == 3 { return 5.4; }
    if loop_len == 4 { return 5.6; }
    if loop_len == 5 { return 5.7; }
    if loop_len == 6 { return 5.8; }
    if loop_len == 7 { return 6.0; }
    if loop_len == 8 { return 6.1; }
    return 6.5 + (((loop_len - 8) as Float) * 0.3);
}

pub fn mrna_evaluate_hairpin(hp: &HairpinStructure) -> StructureStabilityResult {
    let gc_f = (hp).gc_count as Float;
    let au_f = (hp).au_count as Float;
    let gu_f = (hp).gu_count as Float;

    // Stem stacking energy approximation
    let stem_dg = (gc_f * -2.8) + (au_f * -1.2) + (gu_f * -0.5);
    let loop_dg = mrna_calc_hairpin_loop_penalty((hp).loop_length_nt);

    let total_dg = stem_dg + loop_dg;
    let stable = total_dg < -3.0;

    // If structure is very stable (Delta-G < -10 kcal/mol), ribosome cannot easily melt it
    let inhib = if total_dg < -12.0 {
        0.95
    } else if total_dg < -6.0 {
        0.65
    } else if total_dg < -2.0 {
        0.25
    } else {
        0.05
    };

    // Approximate Tm: Tm ~ 37.0 + (-total_dg * 4.5)
    let tm = 37.0 + (if total_dg < 0.0 { -total_dg * 4.5 } else { 0.0 });

    return StructureStabilityResult {
        dg_folding_kcal_per_mol: total_dg,
        is_stable: stable,
        translation_inhibition_fraction: inhib,
        melting_temp_celsius: tm,
    };
}
