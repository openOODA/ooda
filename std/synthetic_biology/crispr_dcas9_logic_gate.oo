// # CRISPR dCas9 Transcriptional Logic Gates
//
// Logline: Simulates dCas9-mediated CRISPRi repression and CRISPRa activation multi-input Boolean logic gates.
//
// Setup: Synthetic transcriptional regulatory networks utilizing catalytically inactive Cas9 (dCas9) and single guide RNAs (sgRNAs).
//
// Beats:
//   1. Define Cas9ComplexParams, SgrnaInput, and CrisprGateResult data structures.
//   2. Compute competitive dCas9-sgRNA complexation and free dCas9 pool equilibrium.
//   3. Evaluate multi-input CRISPRi NOR, NAND, and CRISPRa AND logic gate transfer characteristics.

pub type Cas9ComplexParams = struct {
    total_dcas9_nm: Float,
    kd_binding_nm: Float,
    repression_fold_max: Float,
    activation_fold_max: Float,
    basal_promoter_rate: Float,
};

pub type SgrnaInput = struct {
    guide_id: Int,
    conc_nm: Float,
    target_affinity: Float,
    is_activator: Bool,
};

pub type CrisprGateResult = struct {
    free_dcas9_nm: Float,
    bound_complex_nm: Float,
    promoter_output_rate: Float,
    logic_state_high: Bool,
};

pub fn crispr_binding_fraction(sgrna_nm: Float, dcas9_tot_nm: Float, kd_nm: Float) -> Float {
    if sgrna_nm <= 0.0 || dcas9_tot_nm <= 0.0 { return 0.0; }
    // [Complex] = (dCas9 * sgRNA) / (Kd + sgRNA)
    let denom = kd_nm + sgrna_nm;
    if denom <= 0.0001 { return 0.0; }
    let frac = sgrna_nm / denom;
    return if frac > 1.0 { 1.0 } else { frac };
}

pub fn crispr_not_gate(
    guide_input: &SgrnaInput,
    p: &Cas9ComplexParams,
) -> CrisprGateResult {
    let bf = crispr_binding_fraction((guide_input).conc_nm, (p).total_dcas9_nm, (p).kd_binding_nm);
    let complex_nm = bf * (p).total_dcas9_nm;
    let free_cas9 = (p).total_dcas9_nm - complex_nm;

    let inhibition = 1.0 / (1.0 + (((p).repression_fold_max - 1.0) * bf * (guide_input).target_affinity));
    let out_rate = (p).basal_promoter_rate * inhibition;
    let is_high = out_rate > ((p).basal_promoter_rate * 0.5);

    return CrisprGateResult {
        free_dcas9_nm: free_cas9,
        bound_complex_nm: complex_nm,
        promoter_output_rate: out_rate,
        logic_state_high: is_high,
    };
}

pub fn crispr_nor_gate_2input(
    g1: &SgrnaInput,
    g2: &SgrnaInput,
    p: &Cas9ComplexParams,
) -> CrisprGateResult {
    let tot_sgrna = (g1).conc_nm + (g2).conc_nm;
    let bf = crispr_binding_fraction(tot_sgrna, (p).total_dcas9_nm, (p).kd_binding_nm);
    let complex_nm = bf * (p).total_dcas9_nm;
    let free_cas9 = (p).total_dcas9_nm - complex_nm;

    let eff_rep = (bf * (g1).conc_nm * (g1).target_affinity + bf * (g2).conc_nm * (g2).target_affinity) / (tot_sgrna + 0.00001);
    let inhibition = 1.0 / (1.0 + (((p).repression_fold_max - 1.0) * eff_rep));
    let out_rate = (p).basal_promoter_rate * inhibition;
    let is_high = out_rate > ((p).basal_promoter_rate * 0.5);

    return CrisprGateResult {
        free_dcas9_nm: free_cas9,
        bound_complex_nm: complex_nm,
        promoter_output_rate: out_rate,
        logic_state_high: is_high,
    };
}

pub fn crispr_and_gate_crispra(
    g1: &SgrnaInput,
    g2: &SgrnaInput,
    p: &Cas9ComplexParams,
) -> CrisprGateResult {
    let bf1 = crispr_binding_fraction((g1).conc_nm, (p).total_dcas9_nm * 0.5, (p).kd_binding_nm);
    let bf2 = crispr_binding_fraction((g2).conc_nm, (p).total_dcas9_nm * 0.5, (p).kd_binding_nm);

    let comp1 = bf1 * (p).total_dcas9_nm * 0.5;
    let comp2 = bf2 * (p).total_dcas9_nm * 0.5;
    let tot_comp = comp1 + comp2;

    // Both guides required for synergistic recruitment of RNA polymerase
    let synergy = bf1 * bf2 * (g1).target_affinity * (g2).target_affinity;
    let out_rate = (p).basal_promoter_rate * (1.0 + (((p).activation_fold_max - 1.0) * synergy));
    let is_high = out_rate > ((p).basal_promoter_rate * 2.0);

    return CrisprGateResult {
        free_dcas9_nm: (p).total_dcas9_nm - tot_comp,
        bound_complex_nm: tot_comp,
        promoter_output_rate: out_rate,
        logic_state_high: is_high,
    };
}
