pub fn synbio_shim_toggle_step(st: &ToggleSwitchState, p: &ToggleSwitchParams, dt: Float, ind1: Float, ind2: Float) -> ToggleSwitchState {
    return toggle_switch_rk4_step(st, p, dt, ind1, ind2);
}

pub fn synbio_shim_repressilator_step(st: &RepressilatorState, p: &RepressilatorParams, dt: Float) -> RepressilatorState {
    return repressilator_rk4_step(st, p, dt);
}

pub fn synbio_shim_hill_eval(conc: Float, p: &HillParameters, is_act: Bool) -> PromoterTransferCurve {
    return hill_evaluate_transfer(conc, p, is_act);
}

pub fn synbio_shim_crispr_not(guide: &SgrnaInput, p: &Cas9ComplexParams) -> CrisprGateResult {
    return crispr_not_gate(guide, p);
}

pub fn synbio_shim_fba_solve(model: &StoichiometricModel, max_iter: Int) -> FbaSolution {
    return fba_solve_bounded_primal(model, max_iter);
}

pub fn synbio_shim_ssa_step(cur: &SsaState, k_tx: Float, d_m: Float, k_tl: Float, d_p: Float, u1: Float, u2: Float) -> SsaStepResult {
    return ssa_direct_step(cur, k_tx, d_m, k_tl, d_p, u1, u2);
}

pub fn synbio_shim_rbs_eval(feat: &RbsSequenceFeatures, hp_dg: Float) -> TirPredictionResult {
    return rbs_evaluate_thermodynamics(feat, hp_dg);
}

pub fn synbio_shim_cai_eval(codons: List[String]) -> CaiEvaluationResult {
    return cai_evaluate_codon_list(codons);
}

pub fn synbio_shim_toehold_eval(p: &ToeholdParameters, st: &ToeholdBindingState) -> ToeholdSwitchResult {
    return toehold_evaluate_switch(p, st);
}

pub fn synbio_shim_atf_eval(p: &AtfSensorParams, pt: &LigandTitrationPoint) -> BiosensorResponseResult {
    return atf_evaluate_dose_response(p, pt);
}

pub fn synbio_shim_opto_step(st: &OptoPhotoreceptorState, p: &OptoParams, intensity: Float, dt: Float) -> OptoPhotoreceptorState {
    return opto_step(st, p, intensity, dt);
}

pub fn synbio_shim_burden_eval(p: &RibosomePartitionParams, st: &ProteomeAllocationState) -> BurdenImpactResult {
    return burden_estimate_impact(p, st);
}

pub fn synbio_shim_yield_eval(pair: &SubstrateProductPair) -> TheoreticalYieldResult {
    return yield_evaluate_maximum(pair);
}
