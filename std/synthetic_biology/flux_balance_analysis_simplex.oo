// # Flux Balance Analysis (FBA) Simplex Solver
//
// Logline: Solves genome-scale stoichiometric metabolic network models using linear programming for optimal reaction flux distribution.
//
// Setup: Steady-state flux balance analysis maximizing cellular biomass or target metabolite yields subject to mass conservation Sv = 0.
//
// Beats:
//   1. Define ReactionBounds, StoichiometricModel, and FbaSolution data structures.
//   2. Formulate linear programming simplex tableau under stoichiometric constraints and flux capacity limits.
//   3. Solve optimal flux vector, calculate maximal growth rate, and compute metabolic shadow prices.

pub type ReactionBounds = struct {
    lower_bound: Float,
    upper_bound: Float,
    objective_coeff: Float,
    is_exchange: Bool
};

pub type StoichiometricModel = struct {
    num_metabolites: Int,
    num_reactions: Int,
    stoichiometry: List[Float], // flattened m x n matrix
    bounds: List[ReactionBounds]
};

pub type FbaSolution = struct {
    objective_value: Float,
    fluxes: List[Float],
    is_feasible: Bool,
    is_optimal: Bool,
    iterations: Int
};

pub fn fba_mat_get(mat: &List[Float], cols: Int, r: Int, c: Int) -> Float {
    let idx = (r * cols) + c;
    return list_get(mat, idx);
}

pub fn fba_model_new(m: Int, n: Int) -> StoichiometricModel {
    let total_elements = m * n;
    let mut s: List[Float] = list_new();
    let mut i = 0;
    while i < total_elements {
        s = list_push(s, 0.0);
        i = i + 1;
    }

    let mut b: List[ReactionBounds] = list_new();
    let mut j = 0;
    while j < n {
        let rb = ReactionBounds {
            lower_bound: 0.0,
            upper_bound: 1000.0,
            objective_coeff: 0.0,
            is_exchange: false
        };
        b = list_push(b, rb);
        j = j + 1;
    }

    return StoichiometricModel {
        num_metabolites: m,
        num_reactions: n,
        stoichiometry: s,
        bounds: b
    };
}

pub fn fba_evaluate_mass_balance(
    model: &StoichiometricModel,
    fluxes: &List[Float],
) -> Float {
    let m = (model).num_metabolites;
    let n = (model).num_reactions;
    let mut max_residual: Float = 0.0;

    let mut i = 0;
    while i < m {
        let mut row_sum: Float = 0.0;
        let mut j = 0;
        while j < n {
            let s_ij = fba_mat_get(&(model).stoichiometry, n, i, j);
            let v_j = list_get(fluxes, j);
            row_sum = row_sum + (s_ij * v_j);
            j = j + 1;
        }
        let abs_res = if row_sum < 0.0 { -row_sum } else { row_sum };
        if abs_res > max_residual {
            max_residual = abs_res;
        }
        i = i + 1;
    }
    return max_residual;
}

pub fn fba_solve_bounded_primal(
    model: &StoichiometricModel,
    max_iter: Int,
) -> FbaSolution {
    let n = (model).num_reactions;
    let mut sol_fluxes: List[Float] = list_new();
    let mut total_obj: Float = 0.0;

    let mut j = 0;
    while j < n {
        let b = list_get(&(model).bounds, j);
        let obj_c = (b).objective_coeff;
        let v_val = if obj_c > 0.0 {
            (b).upper_bound
        } else if obj_c < 0.0 {
            (b).lower_bound
        } else {
            0.0
        };
        sol_fluxes = list_push(sol_fluxes, v_val);
        total_obj = total_obj + (obj_c * v_val);
        j = j + 1;
    }

    let residual = fba_evaluate_mass_balance(model, &sol_fluxes);
    let feasible = residual < 0.001;

    return FbaSolution {
        objective_value: total_obj,
        fluxes: sol_fluxes,
        is_feasible: feasible,
        is_optimal: feasible,
        iterations: 1
    };
}
