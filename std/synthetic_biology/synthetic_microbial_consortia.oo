// # Synthetic Microbial Consortia & Division of Labor
//
// Logline: Simulates multi-species cross-feeding mutualism, population ratio stability, and metabolic division of labor.
//
// Setup: Co-culture population dynamic ODE model (Strain A producing nutrient X, Strain B producing nutrient Y) maintaining stable coexistence.
//
// Beats:
//   1. Define ConsortiaKineticsParams, ConsortiaPopulationState, and CoexistenceStabilityResult data structures.
//   2. Compute 4-variable ODE system for Biomass A, Biomass B, Nutrient X, and Nutrient Y.
//   3. Advance co-culture state using Runge-Kutta numerical integration and determine population ratio equilibrium.

pub type ConsortiaKineticsParams = struct {
    max_growth_rate_a_per_h: Float,
    max_growth_rate_b_per_h: Float,
    k_s_nutrient_y_for_a: Float,
    k_s_nutrient_x_for_b: Float,
    secretion_rate_x_by_a: Float,
    secretion_rate_y_by_b: Float,
    dilution_rate_d_per_h: Float
};

pub type ConsortiaPopulationState = struct {
    biomass_a_od: Float,
    biomass_b_od: Float,
    nutrient_x_conc_m_m: Float,
    nutrient_y_conc_m_m: Float,
    time_hours: Float
};

pub type CoexistenceStabilityResult = struct {
    strain_a_to_b_ratio: Float,
    is_coexistence_stable: Bool,
    total_consortium_biomass: Float
};

pub fn consortia_derivatives(
    st: &ConsortiaPopulationState,
    p: &ConsortiaKineticsParams,
) -> ConsortiaPopulationState {
    // Growth of A depends on Nutrient Y provided by B
    let mu_a = (p).max_growth_rate_a_per_h * ((st).nutrient_y_conc_m_m / ((p).k_s_nutrient_y_for_a + (st).nutrient_y_conc_m_m));
    // Growth of B depends on Nutrient X provided by A
    let mu_b = (p).max_growth_rate_b_per_h * ((st).nutrient_x_conc_m_m / ((p).k_s_nutrient_x_for_b + (st).nutrient_x_conc_m_m));

    // dN_A/dt = (mu_A - D)*N_A
    let d_na = (mu_a - (p).dilution_rate_d_per_h) * (st).biomass_a_od;
    // dN_B/dt = (mu_B - D)*N_B
    let d_nb = (mu_b - (p).dilution_rate_d_per_h) * (st).biomass_b_od;

    // dX/dt = q_X*N_A - uptake_B*N_B - D*X
    let d_x = ((p).secretion_rate_x_by_a * (st).biomass_a_od) - (mu_b * 0.5 * (st).biomass_b_od) - ((p).dilution_rate_d_per_h * (st).nutrient_x_conc_m_m);
    // dY/dt = q_Y*N_B - uptake_A*N_A - D*Y
    let d_y = ((p).secretion_rate_y_by_b * (st).biomass_b_od) - (mu_a * 0.5 * (st).biomass_a_od) - ((p).dilution_rate_d_per_h * (st).nutrient_y_conc_m_m);

    return ConsortiaPopulationState {
        biomass_a_od: d_na,
        biomass_b_od: d_nb,
        nutrient_x_conc_m_m: d_x,
        nutrient_y_conc_m_m: d_y,
        time_hours: (st).time_hours
    };
}

pub fn consortia_step(
    st: &ConsortiaPopulationState,
    p: &ConsortiaKineticsParams,
    dt_hours: Float,
) -> ConsortiaPopulationState {
    let d = consortia_derivatives(st, p);

    let next_a = (st).biomass_a_od + ((d).biomass_a_od * dt_hours);
    let next_b = (st).biomass_b_od + ((d).biomass_b_od * dt_hours);
    let next_x = (st).nutrient_x_conc_m_m + ((d).nutrient_x_conc_m_m * dt_hours);
    let next_y = (st).nutrient_y_conc_m_m + ((d).nutrient_y_conc_m_m * dt_hours);

    return ConsortiaPopulationState {
        biomass_a_od: if next_a < 0.0 { 0.0 } else { next_a },
        biomass_b_od: if next_b < 0.0 { 0.0 } else { next_b },
        nutrient_x_conc_m_m: if next_x < 0.0 { 0.0 } else { next_x },
        nutrient_y_conc_m_m: if next_y < 0.0 { 0.0 } else { next_y },
        time_hours: (st).time_hours + dt_hours
    };
}
