// # Theoretical Maximum Product Yield & Stoichiometry Balances
//
// Logline: Calculates theoretical maximum bioproduction yields, carbon recovery, and degree of reduction balances.
//
// Setup: Macroscopic biochemical balance calculator based on elemental composition (C_c H_h O_o N_n) and electron conservation.
//
// Beats:
//   1. Define ChemicalFormula, SubstrateProductPair, and TheoreticalYieldResult data structures.
//   2. Compute degree of reduction gamma = (4c + h - 2o - 3n) / c for substrates, products, and biomass.
//   3. Calculate theoretical maximum yield (g/g and mol/mol) under aerobic and anaerobic redox constraints.

pub type ChemicalFormula = struct {
    name: String,
    carbon_atoms: Int,
    hydrogen_atoms: Int,
    oxygen_atoms: Int,
    nitrogen_atoms: Int,
    molecular_weight_g_mol: Float,
};

pub type SubstrateProductPair = struct {
    substrate: ChemicalFormula,
    product: ChemicalFormula,
    pathway_atp_cost: Float,
    is_aerobic: Bool,
};

pub type TheoreticalYieldResult = struct {
    substrate_degree_of_reduction: Float,
    product_degree_of_reduction: Float,
    max_yield_mol_per_mol: Float,
    max_yield_g_per_g: Float,
    carbon_conservation_fraction: Float,
};

pub fn yield_calc_degree_of_reduction(f: &ChemicalFormula) -> Float {
    let c = (f).carbon_atoms as Float;
    if c <= 0.0 { return 0.0; }
    let h = (f).hydrogen_atoms as Float;
    let o = (f).oxygen_atoms as Float;
    let n = (f).nitrogen_atoms as Float;

    // gamma = (4*C + H - 2*O - 3*N) / C
    return (4.0 * c + h - 2.0 * o - 3.0 * n) / c;
}

pub fn yield_evaluate_maximum(pair: &SubstrateProductPair) -> TheoreticalYieldResult {
    let gamma_s = yield_calc_degree_of_reduction(&(pair).substrate);
    let gamma_p = yield_calc_degree_of_reduction(&(pair).product);

    let c_s = (pair).substrate.carbon_atoms as Float;
    let c_p = (pair).product.carbon_atoms as Float;

    // Electron balance: n_p * c_p * gamma_p <= n_s * c_s * gamma_s (for 1 mol substrate)
    let yield_mol_mol = if (pair).is_aerobic {
        // Under aerobic conditions, carbon balance is the upper bound: c_s / c_p
        c_s / c_p
    } else {
        // Under anaerobic conditions, electron balance strictly limits yield
        if gamma_p > 0.001 { (c_s * gamma_s) / (c_p * gamma_p) } else { c_s / c_p }
    };

    let mw_s = (pair).substrate.molecular_weight_g_mol;
    let mw_p = (pair).product.molecular_weight_g_mol;
    let yield_gg = if mw_s > 0.001 { (yield_mol_mol * mw_p) / mw_s } else { 0.0 };
    let c_conserv = (yield_mol_mol * c_p) / c_s;

    return TheoreticalYieldResult {
        substrate_degree_of_reduction: gamma_s,
        product_degree_of_reduction: gamma_p,
        max_yield_mol_per_mol: yield_mol_mol,
        max_yield_g_per_g: yield_gg,
        carbon_conservation_fraction: if c_conserv > 1.0 { 1.0 } else { c_conserv },
    };
}
