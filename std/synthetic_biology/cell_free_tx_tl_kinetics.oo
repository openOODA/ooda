// # Cell-Free Transcription-Translation (TX-TL) Batch Kinetics
//
// Logline: Simulates in vitro cell-free gene expression, energy depletion (NTP/ATP consumption), and translation arrest.
//
// Setup: Multi-component kinetic ODE model of cell-free extracts (e.g. E. coli lysate or PURE system) for rapid prototyping.
//
// Beats:
//   1. Define CellFreeParams, CellFreeBatchState, and TxTlProgressResult data structures.
//   2. Compute coupled ODEs for DNA template, mRNA, expressed protein, and energy regeneration pool (ATP/GTP).
//   3. Advance batch reaction time and predict total protein yield and reaction cessation time.

pub type CellFreeParams = struct {
    k_tx_max_per_min: Float,
    k_tl_max_per_min: Float,
    d_mrna: Float,
    energy_consumption_per_mrna: Float,
    energy_consumption_per_protein: Float,
    energy_regeneration_rate: Float,
};

pub type CellFreeBatchState = struct {
    dna_template_nm: Float,
    mrna_conc_nm: Float,
    protein_conc_nm: Float,
    energy_pool_m_m: Float, // ATP + GTP pool in mM
    time_hours: Float,
};

pub type TxTlProgressResult = struct {
    protein_yield_u_m: Float,
    is_energy_depleted: Bool,
    synthesis_rate_nm_per_h: Float,
};

pub fn txtl_derivatives(
    st: &CellFreeBatchState,
    p: &CellFreeParams,
) -> CellFreeBatchState {
    let energy_frac = (st).energy_pool_m_m / (0.5 + (st).energy_pool_m_m);

    // Transcription: rate = k_tx * [DNA] * energy_frac
    let v_tx = (p).k_tx_max_per_min * (st).dna_template_nm * energy_frac;
    let d_mrna = v_tx - ((p).d_mrna * (st).mrna_conc_nm);

    // Translation: rate = k_tl * [mRNA] * energy_frac
    let v_tl = (p).k_tl_max_per_min * (st).mrna_conc_nm * energy_frac;
    let d_protein = v_tl;

    // Energy consumption in mM/min
    let v_energy_use = (v_tx * (p).energy_consumption_per_mrna * 0.001) + (v_tl * (p).energy_consumption_per_protein * 0.001);
    let d_energy = (p).energy_regeneration_rate - v_energy_use;

    return CellFreeBatchState {
        dna_template_nm: 0.0,
        mrna_conc_nm: d_mrna,
        protein_conc_nm: d_protein,
        energy_pool_m_m: d_energy,
        time_hours: (st).time_hours,
    };
}

pub fn txtl_step(
    st: &CellFreeBatchState,
    p: &CellFreeParams,
    dt_hours: Float,
) -> CellFreeBatchState {
    let dt_min = dt_hours * 60.0;
    let d = txtl_derivatives(st, p);

    let next_m = (st).mrna_conc_nm + ((d).mrna_conc_nm * dt_min);
    let next_p = (st).protein_conc_nm + ((d).protein_conc_nm * dt_min);
    let next_e = (st).energy_pool_m_m + ((d).energy_pool_m_m * dt_min);

    return CellFreeBatchState {
        dna_template_nm: (st).dna_template_nm,
        mrna_conc_nm: if next_m < 0.0 { 0.0 } else { next_m },
        protein_conc_nm: if next_p < 0.0 { 0.0 } else { next_p },
        energy_pool_m_m: if next_e < 0.0 { 0.0 } else { next_e },
        time_hours: (st).time_hours + dt_hours,
    };
}
