// # De Novo RNA Toehold Switch Biosensors
//
// Logline: Models RNA toehold switch strand displacement, hairpin de-repression, and sequence-specific RNA viral detection.
//
// Setup: Riboregulator biophysical model predicting translation initiation activation by cognate trigger RNA binding.
//
// Beats:
//   1. Define ToeholdParameters, ToeholdBindingState, and ToeholdSwitchResult data structures.
//   2. Compute toehold hybridization free energy Delta-G_toehold and branch migration strand displacement barrier.
//   3. Predict switch ON/OFF ratio, translation rate, and trigger sensitivity threshold.

pub type ToeholdParameters = struct {
    toehold_length_nt: Int,
    stem_length_bp: Int,
    dg_toehold_binding_kcal: Float,
    dg_stem_unfolding_kcal: Float,
    basal_leak_rfu: Float,
    max_activated_rfu: Float,
};

pub type ToeholdBindingState = struct {
    trigger_conc_nm: Float,
    switch_conc_nm: Float,
    temperature_celsius: Float,
};

pub type ToeholdSwitchResult = struct {
    bound_complex_fraction: Float,
    active_translation_rate: Float,
    on_off_fold_induction: Float,
    is_triggered: Bool,
};

pub fn toehold_calc_equilibrium_fraction(
    p: &ToeholdParameters,
    st: &ToeholdBindingState,
) -> Float {
    if (st).trigger_conc_nm <= 0.001 { return 0.0; }
    // Net Delta-G = Delta-G_toehold + Delta-G_stem (net favorable negative Delta-G)
    let net_dg = (p).dg_toehold_binding_kcal + (p).dg_stem_unfolding_kcal;

    // Apparent Kd in nM ~ exp(net_dg / (R*T))
    // For net_dg = -8 kcal/mol, Kd ~ 1.5 nM
    let kd_app_nm = if net_dg < -10.0 {
        0.5
    } else if net_dg < -5.0 {
        5.0
    } else if net_dg < 0.0 {
        50.0
    } else {
        500.0
    };

    let trig = (st).trigger_conc_nm;
    let denom = kd_app_nm + trig;
    if denom <= 0.0001 { return 0.0; }
    return trig / denom;
}

pub fn toehold_evaluate_switch(
    p: &ToeholdParameters,
    st: &ToeholdBindingState,
) -> ToeholdSwitchResult {
    let frac = toehold_calc_equilibrium_fraction(p, st);

    let rate = (p).basal_leak_rfu + (((p).max_activated_rfu - (p).basal_leak_rfu) * frac);
    let base = if (p).basal_leak_rfu > 0.001 { (p).basal_leak_rfu } else { 0.001 };
    let fold = rate / base;
    let trig = frac > 0.3;

    return ToeholdSwitchResult {
        bound_complex_fraction: frac,
        active_translation_rate: rate,
        on_off_fold_induction: fold,
        is_triggered: trig,
    };
}

pub fn rna_toehold_switch_sensor_probe() -> Int {
    return 0;
}
