// # Molecular Sequestration & Mutual Annihilation Kinetics
//
// Logline: Generates ultra-sharp threshold responses and ultra-sensitivity in gene circuits via stoichiometric protein sequestration.
//
// Setup: Buchler-Cross molecular titration model (e.g. sigma and anti-sigma factors) creating sharp step-function activation without high Hill coefficients.
//
// Beats:
//   1. Define SequestrationParams, SequestrationState, and TitrationResponseResult data structures.
//   2. Compute high-affinity stoichiometric complexation [A:B] and free unsequestered activator fraction.
//   3. Predict ultra-sensitive threshold switching point theta and effective steepness index.

pub type SequestrationParams = struct {
    k_association_rate: Float, // High affinity binding
    kd_dissociation_nm: Float,
    degradation_free: Float,
    degradation_complex: Float,
    promoter_affinity_k: Float,
};

pub type SequestrationState = struct {
    activator_conc_nm: Float,
    inhibitor_conc_nm: Float,
    complex_conc_nm: Float,
};

pub type TitrationResponseResult = struct {
    free_activator_conc: Float,
    promoter_activation_fraction: Float,
    is_threshold_exceeded: Bool,
    effective_hill_coefficient: Float,
};

pub fn seq_calc_free_species(
    tot_a: Float,
    tot_b: Float,
    kd: Float,
) -> Float {
    if tot_a <= 0.0 { return 0.0; }
    if tot_b <= 0.0 { return tot_a; }

    // Quadratic solution for [A_free]:
    // A_free^2 + (B_tot - A_tot + Kd)*A_free - Kd*A_tot = 0
    let b_term = tot_b - tot_a + kd;
    let disc = (b_term * b_term) + (4.0 * kd * tot_a);

    // Fast sqrt
    let mut sqrt_disc = disc / 2.0;
    if sqrt_disc < 0.1 { sqrt_disc = 0.1; }
    let mut it = 0;
    while it < 8 {
        sqrt_disc = 0.5 * (sqrt_disc + (disc / sqrt_disc));
        it = it + 1;
    }

    let a_free = (-b_term + sqrt_disc) * 0.5;
    return if a_free < 0.0 { 0.0 } else { a_free };
}

pub fn seq_evaluate_response(
    st: &SequestrationState,
    p: &SequestrationParams,
) -> TitrationResponseResult {
    let free_a = seq_calc_free_species((st).activator_conc_nm, (st).inhibitor_conc_nm, (p).kd_dissociation_nm);

    let k = (p).promoter_affinity_k;
    let frac = free_a / (k + free_a);
    let exceeded = (st).activator_conc_nm > (st).inhibitor_conc_nm;

    // Sequestration creates apparent Hill coefficients > 4-8
    let eff_n = if (st).inhibitor_conc_nm > 5.0 { 6.5 } else { 1.5 };

    return TitrationResponseResult {
        free_activator_conc: free_a,
        promoter_activation_fraction: frac,
        is_threshold_exceeded: exceeded,
        effective_hill_coefficient: eff_n,
    };
}
