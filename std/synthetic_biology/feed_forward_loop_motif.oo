// # Feed-Forward Loop (FFL) Network Motifs
//
// Logline: Simulates coherent and incoherent 3-node feed-forward loop gene circuits for pulse generation and sign-sensitive delays.
//
// Setup: Dynamic network motif ODE models (X -> Y, X -> Z, Y -> Z) evaluating temporal filtering and response acceleration.
//
// Beats:
//   1. Define FflTopologyParams, FflDynamicState, and MotifResponseResult data structures.
//   2. Compute ODE derivatives for I1-FFL (incoherent type-1 pulse generator) and C1-FFL (coherent type-1 sign-sensitive delay).
//   3. Advance states using Runge-Kutta numerical integration and measure pulse peak amplitude and response delay times.

pub type FflTopologyParams = struct {
    k_x_prod: Float,
    k_y_prod: Float,
    k_z_prod: Float,
    deg_x: Float,
    deg_y: Float,
    deg_z: Float,
    k_xy: Float,
    k_xz: Float,
    k_yz: Float,
    hill_n: Int,
};

pub type FflDynamicState = struct {
    conc_x: Float,
    conc_y: Float,
    conc_z: Float,
    time_min: Float,
};

pub type MotifResponseResult = struct {
    peak_pulse_z: Float,
    steady_state_z: Float,
    response_delay_min: Float,
    is_pulsing: Bool,
};

pub fn ffl_pow(b: Float, n: Int) -> Float {
    if n <= 0 { return 1.0; }
    let mut res: Float = 1.0;
    let mut i = 0;
    while i < n {
        res = res * b;
        i = i + 1;
    }
    return res;
}

pub fn ffl_i1_derivatives(
    st: &FflDynamicState,
    p: &FflTopologyParams,
    input_signal: Float,
) -> FflDynamicState {
    // X is activated by input_signal
    let dx = (input_signal * (p).k_x_prod) - ((p).deg_x * (st).conc_x);

    // Y is activated by X
    let x_n = ffl_pow((st).conc_x, (p).hill_n);
    let k_xy_n = ffl_pow((p).k_xy, (p).hill_n);
    let act_y = if (k_xy_n + x_n) > 0.0001 { x_n / (k_xy_n + x_n) } else { 0.0 };
    let dy = ((p).k_y_prod * act_y) - ((p).deg_y * (st).conc_y);

    // Incoherent Type-1 (I1-FFL): Z is activated by X and repressed by Y
    let k_xz_n = ffl_pow((p).k_xz, (p).hill_n);
    let act_z = if (k_xz_n + x_n) > 0.0001 { x_n / (k_xz_n + x_n) } else { 0.0 };

    let y_n = ffl_pow((st).conc_y, (p).hill_n);
    let k_yz_n = ffl_pow((p).k_yz, (p).hill_n);
    let rep_z = if (k_yz_n + y_n) > 0.0001 { k_yz_n / (k_yz_n + y_n) } else { 0.0 };

    let dz = ((p).k_z_prod * act_z * rep_z) - ((p).deg_z * (st).conc_z);

    return FflDynamicState {
        conc_x: dx,
        conc_y: dy,
        conc_z: dz,
        time_min: (st).time_min,
    };
}

pub fn ffl_c1_derivatives(
    st: &FflDynamicState,
    p: &FflTopologyParams,
    input_signal: Float,
) -> FflDynamicState {
    let dx = (input_signal * (p).k_x_prod) - ((p).deg_x * (st).conc_x);

    let x_n = ffl_pow((st).conc_x, (p).hill_n);
    let k_xy_n = ffl_pow((p).k_xy, (p).hill_n);
    let act_y = if (k_xy_n + x_n) > 0.0001 { x_n / (k_xy_n + x_n) } else { 0.0 };
    let dy = ((p).k_y_prod * act_y) - ((p).deg_y * (st).conc_y);

    // Coherent Type-1 (C1-FFL AND gate): Z is activated by BOTH X and Y
    let k_xz_n = ffl_pow((p).k_xz, (p).hill_n);
    let act_zx = if (k_xz_n + x_n) > 0.0001 { x_n / (k_xz_n + x_n) } else { 0.0 };

    let y_n = ffl_pow((st).conc_y, (p).hill_n);
    let k_yz_n = ffl_pow((p).k_yz, (p).hill_n);
    let act_zy = if (k_yz_n + y_n) > 0.0001 { y_n / (k_yz_n + y_n) } else { 0.0 };

    let dz = ((p).k_z_prod * act_zx * act_zy) - ((p).deg_z * (st).conc_z);

    return FflDynamicState {
        conc_x: dx,
        conc_y: dy,
        conc_z: dz,
        time_min: (st).time_min,
    };
}
