// # Cooperative Protein Dimerization & Heterodimer Logic
//
// Logline: Models leucine zipper and bHLH homo/hetero-dimerization equilibrium and DNA-binding regulatory complexes.
//
// Setup: Mass-action thermodynamics of protein-protein interaction interfaces governing transcription factor assembly.
//
// Beats:
//   1. Define DimerizationParams, MonomerConcentrations, and DimerEquilibriumResult data structures.
//   2. Compute coupled equilibrium equations for homodimers (A2, B2) and heterodimers (AB).
//   3. Predict functional DNA operator binding affinity and combinatorial logic output.

pub type DimerizationParams = struct {
    kd_homodimer_a2_nm: Float,
    kd_homodimer_b2_nm: Float,
    kd_heterodimer_ab_nm: Float,
    kd_dna_operator_nm: Float,
};

pub type MonomerConcentrations = struct {
    total_monomer_a_nm: Float,
    total_monomer_b_nm: Float,
};

pub type DimerEquilibriumResult = struct {
    homodimer_a2_conc: Float,
    homodimer_b2_conc: Float,
    heterodimer_ab_conc: Float,
    fraction_dna_bound: Float,
    dominant_dimer_species: Int, // 1: A2, 2: B2, 3: AB (heterodimer)
};

pub fn dimer_calc_equilibrium(
    p: &DimerizationParams,
    m: &MonomerConcentrations,
) -> DimerEquilibriumResult {
    let tot_a = (m).total_monomer_a_nm;
    let tot_b = (m).total_monomer_b_nm;

    // Heterodimer preference factor: if Kd_AB is much smaller than Kd_A2 and Kd_B2
    let is_hetero_favored = (p).kd_heterodimer_ab_nm < (p).kd_homodimer_a2_nm;

    let c_ab = if is_hetero_favored {
        let min_m = if tot_a < tot_b { tot_a } else { tot_b };
        (min_m * 0.85)
    } else {
        0.1 * tot_a
    };

    let rem_a = if (tot_a - c_ab) < 0.0 { 0.0 } else { tot_a - c_ab };
    let rem_b = if (tot_b - c_ab) < 0.0 { 0.0 } else { tot_b - c_ab };

    let c_a2 = (rem_a * rem_a) / ((p).kd_homodimer_a2_nm + (2.0 * rem_a));
    let c_b2 = (rem_b * rem_b) / ((p).kd_homodimer_b2_nm + (2.0 * rem_b));

    // DNA binding driven primarily by active heterodimer
    let dna_frac = c_ab / ((p).kd_dna_operator_nm + c_ab);

    let dom = if c_ab > c_a2 && c_ab > c_b2 {
        3
    } else if c_a2 > c_b2 {
        1
    } else {
        2
    };

    return DimerEquilibriumResult {
        homodimer_a2_conc: c_a2,
        homodimer_b2_conc: c_b2,
        heterodimer_ab_conc: c_ab,
        fraction_dna_bound: dna_frac,
        dominant_dimer_species: dom,
    };
}
