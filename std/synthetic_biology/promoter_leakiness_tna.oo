// # Synthetic Promoter Leakiness & Dynamic Range
//
// Logline: Quantifies basal leaky transcription, induction dynamic range, and ON/OFF signal-to-noise ratios in engineered promoters.
//
// Setup: Promoter characterization metric evaluating tightness of transcriptional repression and maximal induced expression.
//
// Beats:
//   1. Define PromoterCharacterization, InductionMetrics, and DynamicRangeResult data structures.
//   2. Compute basal expression leakiness fraction and ON/OFF fold induction dynamic range.
//   3. Calculate promoter signal-to-noise ratio (SNR) and regulatory tightness score.

pub type PromoterCharacterization = struct {
    promoter_name: String,
    basal_fluorescence_me_fl: Float, // Uninduced ON/OFF baseline
    maximal_fluorescence_me_fl: Float, // Fully induced output
    constitutive_reference_me_fl: Float,
};

pub type InductionMetrics = struct {
    on_off_ratio: Float,
    dynamic_range_db: Float,
    leakiness_fraction: Float,
};

pub type DynamicRangeResult = struct {
    metrics: InductionMetrics,
    is_tight_promoter: Bool,
    snr_linear: Float,
    recommended_application_tier: Int, // 1: Toxic payload (requires ultra-tight), 2: Metabolic switch, 3: Sensor
};

pub fn promoter_math_log10(val: Float) -> Float {
    if val <= 0.0001 { return -4.0; }
    if val <= 1.0 { return 0.0; }
    if val <= 10.0 { return 1.0; }
    if val <= 100.0 { return 2.0; }
    if val <= 1000.0 { return 3.0; }
    if val <= 10000.0 { return 4.0; }
    return 5.0;
}

pub fn promoter_analyze_performance(p: &PromoterCharacterization) -> DynamicRangeResult {
    let basal = if (p).basal_fluorescence_me_fl < 0.001 { 0.001 } else { (p).basal_fluorescence_me_fl };
    let max_val = (p).maximal_fluorescence_me_fl;

    let ratio = max_val / basal;
    let leak_frac = basal / (if (p).constitutive_reference_me_fl > 0.001 { (p).constitutive_reference_me_fl } else { max_val });
    let db = 20.0 * promoter_math_log10(ratio);

    let is_tight = leak_frac < 0.02 && ratio > 100.0;
    let snr = (max_val - basal) / basal;

    let tier = if is_tight {
        1 // Ultra-tight (ideal for toxic genes/CRISPR nucleases)
    } else if ratio > 20.0 {
        2 // Good for metabolic switches
    } else {
        3 // Basic sensor/reporter
    };

    let met = InductionMetrics {
        on_off_ratio: ratio,
        dynamic_range_db: db,
        leakiness_fraction: leak_frac,
    };

    return DynamicRangeResult {
        metrics: met,
        is_tight_promoter: is_tight,
        snr_linear: snr,
        recommended_application_tier: tier,
    };
}
