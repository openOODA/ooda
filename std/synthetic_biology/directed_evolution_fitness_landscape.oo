// # Directed Evolution & NK Fitness Landscapes
//
// Logline: Models epistatic fitness ruggedness, adaptive mutational walks, and evolutionary trajectories for protein engineering.
//
// Setup: Kauffman NK fitness landscape model predicting enzyme activity improvement and local vs global optima trapping.
//
// Beats:
//   1. Define NkLandscapeParams, ProteinVariantGenotype, and AdaptiveWalkResult data structures.
//   2. Compute site fitness contributions with K epistatic inter-residue interaction couplings.
//   3. Simulate greedy hill-climbing mutational walk and compute evolutionary accessibility probability.

pub type NkLandscapeParams = struct {
    num_loci_n: Int,
    epistatic_interactions_k: Int, // K = 0 (smooth additive) to K = N-1 (maximally rugged uncorrelated)
    mutation_rate_per_kb: Float,
    screening_library_size: Int,
};

pub type ProteinVariantGenotype = struct {
    variant_id: Int,
    mutation_indices: List[Int],
    fitness_score: Float,
};

pub type AdaptiveWalkResult = struct {
    trajectory_steps: Int,
    initial_fitness: Float,
    final_fitness: Float,
    is_local_optimum_trapped: Bool,
    fitness_improvement_fold: Float,
};

pub fn evo_calc_locus_fitness(
    locus_idx: Int,
    has_mutation: Bool,
    k_epistasis: Int,
) -> Float {
    if !has_mutation { return 0.5; }
    // Epistatic modulation based on K
    let k_f: Float = (k_epistasis as Float);
    let epistasis_factor: Float = 1.0 + (0.15 * k_f);
    let base_gain: Float = 0.35;
    return (0.5 + (base_gain * epistasis_factor));
}

pub fn evo_evaluate_variant(
    p: &NkLandscapeParams,
    mut_indices: &List[Int],
) -> ProteinVariantGenotype {
    let n = (p).num_loci_n;
    let num_muts = list_len(mut_indices);
    let mut total_fit: Float = 0.0;

    let mut i = 0;
    while i < n {
        // Check if locus i is mutated
        let mut is_mut = false;
        let mut m = 0;
        while m < num_muts {
            if list_get(mut_indices, m) == i {
                is_mut = true;
            }
            m = m + 1;
        }

        let fit_i = evo_calc_locus_fitness(i, is_mut, (p).epistatic_interactions_k);
        total_fit = total_fit + fit_i;
        i = i + 1;
    }

    let nf: Float = (n as Float);
    let avg_fit = total_fit / nf;

    return ProteinVariantGenotype {
        variant_id: 1,
        mutation_indices: mut_indices,
        fitness_score: avg_fit,
    };
}
