// # Cascaded Integrase Cellular Pulse Counters
//
// Logline: Simulates synthetic biological counter circuits registering sequential induction pulses into distinct DNA orientations.
//
// Setup: Multi-stage recombinase cascade where each consecutive pulse inverts the next stage promoter and primes the subsequent register.
//
// Beats:
//   1. Define CounterStage, CellularCounterState, and PulseResponseResult data structures.
//   2. Model sequential promoter hand-off and stage activation upon transient inducer exposure.
//   3. Compute current pulse count tally, digital verification flag, and final terminal state reporter.

pub type CounterStage = struct {
    stage_index: Int,
    is_primed: Bool,
    is_inverted: Bool,
    integrase_affinity: Float
};

pub type CellularCounterState = struct {
    current_count: Int,
    max_count_capacity: Int,
    stages: List[CounterStage],
    terminal_reporter_active: Bool
};

pub type PulseResponseResult = struct {
    new_count: Int,
    pulse_successfully_registered: Bool,
    terminal_reached: Bool,
    reporter_fluorescence: Float
};

pub fn counter_process_pulse(
    state: &CellularCounterState,
    pulse_duration_min: Float,
    inducer_conc_u_m: Float,
) -> PulseResponseResult {
    if pulse_duration_min < 5.0 || inducer_conc_u_m < 0.5 {
        return PulseResponseResult {
            new_count: (state).current_count,
            pulse_successfully_registered: false,
            terminal_reached: (state).terminal_reporter_active,
            reporter_fluorescence: if (state).terminal_reporter_active { 1000.0 } else { 10.0 }
        };
    }

    let next_c = (state).current_count + 1;
    let term = next_c >= (state).max_count_capacity;

    let fluor = if term { 1000.0 } else { (next_c as Float) * 50.0 };

    return PulseResponseResult {
        new_count: next_c,
        pulse_successfully_registered: true,
        terminal_reached: term,
        reporter_fluorescence: fluor
    };
}
