// # Edge Mesh Link Health
//
// Logline: Construct, update, and test connectivity / quality of a single MeshLink.
//
// Setup: Imports mesh_types.oo. MeshLink holds peer_id, link_quality, latency_ms, last_seen_ms, is_connected.
//
// Beats:
//   1. mesh_link_init: derive is_connected from quality > 0.
//   2. mesh_link_is_healthy: connected, quality >= 20, latency <= 500.
//   3. mesh_link_update: refresh quality, latency, timestamp and re-derive is_connected.
//
// residual: &mut destubbed to by-value.

import "./mesh_ops_types.oo";

pub fn mesh_link_init(peer_id: Int, quality: Int, latency: Int) -> MeshLink {
    let mut connected: Bool = false;
    if quality > 0 {
        connected = true;
    }
    return MeshLink {
        peer_id: peer_id,
        link_quality: quality,
        latency_ms: latency,
        last_seen_ms: 0,
        is_connected: connected
    };
}

pub fn mesh_link_is_healthy(link: MeshLink) -> Bool {
    if (link).is_connected == false {
        return false;
    }
    if (link).link_quality < 20 {
        return false;
    }
    if (link).latency_ms > 500 {
        return false;
    }
    return true;
}

pub fn mesh_link_update(link: MeshLink, quality: Int, latency: Int, timestamp_ms: Int) -> MeshLink {
    let mut connected: Bool = false;
    if quality > 0 {
        connected = true;
    }
    return MeshLink {
        peer_id: (link).peer_id,
        link_quality: quality,
        latency_ms: latency,
        last_seen_ms: timestamp_ms,
        is_connected: connected
    };
}
