// # Edge Battery Power Calculations
//
// Logline: Computes instantaneous power draw, remaining energy capacity, and estimated runtime.
//
// Setup: Imports power_types.oo for BatteryState structures.
//
// Beats:
//   1. Calculate power consumption in milliwatts from voltage and current telemetry.
//   2. Estimate remaining energy in milliwatt-hours factoring health and charge levels.
//   3. Project operating runtime in seconds given real-time power draw.

import "./power_types.oo";

/// Calculate current power consumption in milliwatts (mW)
/// P = V * I / 1000
pub fn battery_calculate_power_mw(state: &BatteryState) -> Int {
    let v = (state).voltage_mv;
    let mut i = (state).current_ma;
    if i < 0 {
        i = 0 - i;
    }
    return (v * i) / 1000;
}

/// Estimate remaining energy in milliwatt-hours (mWh) given nominal full capacity in mWh
pub fn battery_remaining_energy_mwh(state: &BatteryState, nominal_capacity_mwh: Int) -> Int {
    let actual_capacity_mwh = (nominal_capacity_mwh * (state).health_pct) / 100;
    return (actual_capacity_mwh * (state).capacity_pct) / 100;
}

/// Estimate remaining runtime in seconds given current power draw
pub fn battery_estimate_runtime_sec(state: &BatteryState, nominal_capacity_mwh: Int) -> Int {
    let remaining_mwh = battery_remaining_energy_mwh(state, nominal_capacity_mwh);
    let power_mw = battery_calculate_power_mw(state);
    
    if power_mw <= 0 {
        return 999999; // Indefinite or external power
    }
    
    // seconds = (mWh * 3600) / mW
    return (remaining_mwh * 3600) / power_mw;
}
