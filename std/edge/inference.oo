// ===================================================================
// openOODA Standard Library — ooda::edge::inference
// Edge Inference Re-export Shim (Issue #15 split)
// ===================================================================
// The original ~410-line inference.oo was split at functional seams
// into 5 files (each ≤256 lines, oodac check green). This shim
// re-exports the public names so existing callers continue to work.

import "./inference_types.oo";
import "./inference_ops.oo";
import "./inference_pipeline.oo";
import "./inference_analysis.oo";
import "./inference_stubs.oo";

pub fn shim_marker_config_new() -> ModelConfig {
    return model_config_new(1, 64, 10, 0, 0, 8, 100, 256);
}

pub fn shim_marker_metrics_new() -> InferenceMetrics {
    return metrics_new();
}

pub fn shim_marker_request_new() -> InferenceRequest {
    return inference_request_new(1, 5, 1, 50, 100);
}

pub fn shim_marker_engine_init() -> InferenceEngine {
    let cfg: ModelConfig = model_config_new(1, 64, 10, 0, 0, 8, 100, 256);
    return inference_engine_init(cfg);
}

pub fn shim_marker_can_process() -> Bool {
    let cfg: ModelConfig = model_config_new(1, 64, 10, 0, 0, 8, 100, 256);
    let eng: InferenceEngine = inference_engine_init(cfg);
    let req: InferenceRequest = inference_request_new(1, 5, 1, 50, 100);
    return inference_engine_can_process(&eng, req);
}

pub fn shim_marker_estimate_latency() -> Int {
    let cfg: ModelConfig = model_config_new(1, 64, 10, 0, 0, 8, 100, 256);
    let eng: InferenceEngine = inference_engine_init(cfg);
    let req: InferenceRequest = inference_request_new(1, 5, 1, 50, 100);
    return inference_engine_estimate_latency(&eng, req);
}

pub fn shim_marker_avg_latency() -> Int {
    let cfg: ModelConfig = model_config_new(1, 64, 10, 0, 0, 8, 100, 256);
    let eng: InferenceEngine = inference_engine_init(cfg);
    return inference_engine_calc_avg_latency(&eng);
}

pub fn shim_marker_energy() -> Int {
    let cfg: ModelConfig = model_config_new(1, 64, 10, 0, 0, 8, 100, 256);
    let eng: InferenceEngine = inference_engine_init(cfg);
    return inference_engine_estimate_energy_uJ(&eng, 10);
}

pub fn shim_marker_optimal_backend() -> Int {
    return inference_select_optimal_backend(70, 50);
}

pub fn shim_marker_memory() -> Int {
    return inference_estimate_memory_usage_mb(64, 10, 0);
}
