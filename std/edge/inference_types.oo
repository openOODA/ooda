// # Edge inference types
//
// Logline: ModelConfig, InferenceMetrics, InferenceRequest, InferenceEngine types.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//

pub type ModelConfig = struct {
    model_id: Int,
    input_dim: Int,
    output_dim: Int,
    quant_level: Int,
    device_backend: Int,
    max_batch_size: Int,
    latency_target_ms: Int,
    memory_budget_mb: Int
};

pub type InferenceMetrics = struct {
    total_inferences: Int,
    successful_inferences: Int,
    failed_inferences: Int,
    total_latency_ms: Int,
    min_latency_ms: Int,
    max_latency_ms: Int
};

pub type InferenceRequest = struct {
    request_id: Int,
    priority: Int,
    batch_size: Int,
    confidence_threshold: Int,
    timeout_ms: Int
};

pub type InferenceEngine = struct {
    config: ModelConfig,
    metrics: InferenceMetrics,
    is_initialized: Bool,
    is_warm: Bool,
    current_temperature_c: Int,
    power_consumption_mw: Int,
    last_status_code: Int,
    last_output_score: Int,
    last_latency_ms: Int
};

pub fn model_config_new(model_id: Int, input_dim: Int, max_batch_size: Int) -> ModelConfig {
    return ModelConfig {
        model_id: model_id,
        input_dim: input_dim,
        output_dim: 0,
        quant_level: 0,
        device_backend: 0,
        max_batch_size: max_batch_size,
        latency_target_ms: 0,
        memory_budget_mb: 0
    };
}

pub fn model_config_batch(c: ModelConfig) -> Int {
    return c.max_batch_size;
}
