// # Edge inference types
//
// Logline: ModelConfig destubbed off pub type nested engine.
// residual: List[struct] destubbed to Int floor.

type ModelConfig = struct {
    model_id: Int,
    input_dim: Int,
    max_batch_size: Int
};

pub fn model_config_new(model_id: Int, input_dim: Int, max_batch_size: Int) -> ModelConfig {
    return ModelConfig {
        model_id: model_id,
        input_dim: input_dim,
        max_batch_size: max_batch_size
    };
}

pub fn model_config_batch(c: ModelConfig) -> Int {
    return c.max_batch_size;
}
