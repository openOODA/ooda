// # Edge OTA Update Types
//
// Logline: Defines firmware manifest schemas, A/B partition slots, and update manager state representations.
//
// Setup: Pure data structures and constructors for edge device over-the-air firmware updates.
//
// Beats:
//   1. Declare OTA image manifest structure with signature and version metadata.
//   2. Define dual-bank A/B partition slot representations.
//   3. Define manager state structure and slot state management helpers.

pub type OtaManifest = struct {
    version_major: Int,
    version_minor: Int,
    version_patch: Int,
    build_number: Int,
    image_size_bytes: Int,
    checksum: Int,
    signature_valid: Bool,
    is_delta: Bool,
};

pub fn ota_manifest_new(major: Int, minor: Int, patch: Int, build: Int, size_bytes: Int, checksum: Int, signature_valid: Bool, is_delta: Bool) -> OtaManifest {
    return OtaManifest {
        version_major: major,
        version_minor: minor,
        version_patch: patch,
        build_number: build,
        image_size_bytes: size_bytes,
        checksum: checksum,
        signature_valid: signature_valid,
        is_delta: is_delta,
    };
}

pub fn ota_manifest_empty() -> OtaManifest {
    return OtaManifest {
        version_major: 0,
        version_minor: 0,
        version_patch: 0,
        build_number: 0,
        image_size_bytes: 0,
        checksum: 0,
        signature_valid: false,
        is_delta: false,
    };
}

pub fn ota_manifest_version_code(manifest: &OtaManifest) -> Int {
    let v_maj = (manifest).version_major * 10000;
    let v_min = (manifest).version_minor * 100;
    return v_maj + v_min + (manifest).version_patch;
}

pub fn ota_manifest_is_valid(manifest: &OtaManifest) -> Bool {
    if (manifest).image_size_bytes <= 0 {
        return false;
    }
    if (manifest).signature_valid == false {
        return false;
    }
    return true;
}

pub type OtaPartitionSlot = struct {
    slot_id: Int,
    is_active: Bool,
    is_bootable: Bool,
    is_confirmed: Bool,
    version_code: Int,
};

pub fn ota_slot_new(slot_id: Int, is_active: Bool, is_bootable: Bool, version_code: Int) -> OtaPartitionSlot {
    return OtaPartitionSlot {
        slot_id: slot_id,
        is_active: is_active,
        is_bootable: is_bootable,
        is_confirmed: true,
        version_code: version_code,
    };
}

pub fn ota_slot_inactive() -> OtaPartitionSlot {
    return OtaPartitionSlot {
        slot_id: 0,
        is_active: false,
        is_bootable: false,
        is_confirmed: false,
        version_code: 0,
    };
}

pub fn ota_slot_mark_confirmed(slot: &mut OtaPartitionSlot) {
    (slot).is_confirmed = true;
}

pub fn ota_slot_set_active(slot: &mut OtaPartitionSlot, active: Bool) {
    (slot).is_active = active;
}

pub type OtaManager = struct {
    state: Int, // 0=IDLE, 1=DOWNLOADING, 2=VERIFYING, 3=STAGED, 4=APPLYING, 5=SUCCESS, 6=FAILED, 7=ROLLED_BACK
    active_slot: Int,
    target_slot: Int,
    download_bytes_received: Int,
    total_bytes_expected: Int,
    current_version_code: Int,
    target_version_code: Int,
    expected_checksum: Int,
    download_progress_pct: Int,
    retry_count: Int,
    max_retries: Int,
    auto_rollback: Bool,
    error_code: Int,
    cap: &SysCap,
};
