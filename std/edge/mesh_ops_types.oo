// # Edge Mesh Operations Data Types
//
// Logline: MeshNodeConfig, MeshLink, MeshNode, and MeshPacket struct definitions.
//
// Setup: Flat Int field structs. MeshNodeConfig destubbed to carry max_peers and heartbeat_interval_ms inline.
//
// Beats:
//   1. Define the four edge-mesh data carriers.
//   2. Provide mesh_config_init / mesh_node_init / mesh_packet_create.

type MeshNodeConfig = struct {
    node_id: Int,
    max_peers: Int,
    role: Int,
    heartbeat_interval_ms: Int
};

type MeshLink = struct {
    peer_id: Int,
    link_quality: Int,
    latency_ms: Int,
    last_seen_ms: Int,
    is_connected: Bool
};

type MeshNode = struct {
    config: MeshNodeConfig,
    status: Int,
    battery_level_pct: Int,
    cpu_load_pct: Int,
    active_peer_count: Int,
    sequence_number: Int,
    total_sent: Int,
    total_recv: Int,
    total_forwarded: Int,
    total_dropped: Int,
    last_action: Int
};

type MeshPacket = struct {
    src_node: Int,
    dst_node: Int,
    seq: Int,
    ttl: Int,
    hop_count: Int,
    payload_type: Int,
    payload_val: Int
};

pub fn mesh_config_init(node_id: Int, max_peers: Int, role: Int) -> MeshNodeConfig {
    return MeshNodeConfig {
        node_id: node_id,
        max_peers: max_peers,
        role: role,
        heartbeat_interval_ms: 1000
    };
}

pub fn mesh_node_init(cfg: MeshNodeConfig) -> MeshNode {
    return MeshNode {
        config: cfg,
        status: 1,
        battery_level_pct: 100,
        cpu_load_pct: 0,
        active_peer_count: 0,
        sequence_number: 0,
        total_sent: 0,
        total_recv: 0,
        total_forwarded: 0,
        total_dropped: 0,
        last_action: 0
    };
}

pub fn mesh_packet_create(src: Int, dst: Int, seq: Int, ttl: Int, payload_type: Int, payload_val: Int) -> MeshPacket {
    return MeshPacket {
        src_node: src,
        dst_node: dst,
        seq: seq,
        ttl: ttl,
        hop_count: 0,
        payload_type: payload_type,
        payload_val: payload_val
    };
}
