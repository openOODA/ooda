// # Edge Power Management Types
//
// Logline: Defines battery telemetry states, power consumption profiles, and governor configurations.
//
// Setup: Pure data structures and constructors for battery monitoring and power profiles.
//
// Beats:
//   1. Declare battery state representations and constructors.
//   2. Define power profile tiers ranging from maximum performance to deep sleep.
//   3. Define power governor data structures and threshold configurations.

/// Battery state representation
/// Charge status: 0 = Discharging, 1 = Charging, 2 = Full, 3 = Fault
/// Power source: 0 = Battery, 1 = AC/Wall, 2 = Solar, 3 = USB-PD
pub type BatteryState = struct {
    capacity_pct: Int,
    voltage_mv: Int,
    current_ma: Int,
    health_pct: Int,
    temperature_c: Int,
    charge_status: Int,
    power_source: Int
};

pub fn battery_state_new(capacity_pct: Int, voltage_mv: Int, current_ma: Int, health_pct: Int, temp_c: Int, charge_status: Int, power_source: Int) -> BatteryState {
    let mut cap = capacity_pct;
    if cap < 0 {
        cap = 0;
    }
    if cap > 100 {
        cap = 100;
    }
    
    let mut health = health_pct;
    if health < 0 {
        health = 0;
    }
    if health > 100 {
        health = 100;
    }

    return BatteryState {
        capacity_pct: cap,
        voltage_mv: voltage_mv,
        current_ma: current_ma,
        health_pct: health,
        temperature_c: temp_c,
        charge_status: charge_status,
        power_source: power_source
    };
}

pub fn battery_state_default() -> BatteryState {
    return BatteryState {
        capacity_pct: 100,
        voltage_mv: 12000,
        current_ma: 0,
        health_pct: 100,
        temperature_c: 25,
        charge_status: 0,
        power_source: 0
    };
}

/// Power Profile mode: 0 = MaxPerformance, 1 = Balanced, 2 = PowerSaver, 3 = CriticalLowPower, 4 = DeepSleep
pub type PowerProfile = struct {
    mode: Int,
    cpu_freq_pct: Int,
    sensor_sample_rate_pct: Int,
    duty_cycle_pct: Int,
    max_power_budget_mw: Int,
    thermal_limit_c: Int
};

pub fn power_profile_performance() -> PowerProfile {
    return PowerProfile {
        mode: 0,
        cpu_freq_pct: 100,
        sensor_sample_rate_pct: 100,
        duty_cycle_pct: 100,
        max_power_budget_mw: 25000,
        thermal_limit_c: 85
    };
}

pub fn power_profile_balanced() -> PowerProfile {
    return PowerProfile {
        mode: 1,
        cpu_freq_pct: 75,
        sensor_sample_rate_pct: 75,
        duty_cycle_pct: 80,
        max_power_budget_mw: 15000,
        thermal_limit_c: 75
    };
}

pub fn power_profile_saver() -> PowerProfile {
    return PowerProfile {
        mode: 2,
        cpu_freq_pct: 50,
        sensor_sample_rate_pct: 50,
        duty_cycle_pct: 50,
        max_power_budget_mw: 7500,
        thermal_limit_c: 65
    };
}

pub fn power_profile_critical() -> PowerProfile {
    return PowerProfile {
        mode: 3,
        cpu_freq_pct: 25,
        sensor_sample_rate_pct: 25,
        duty_cycle_pct: 25,
        max_power_budget_mw: 3000,
        thermal_limit_c: 60
    };
}

pub fn power_profile_deep_sleep() -> PowerProfile {
    return PowerProfile {
        mode: 4,
        cpu_freq_pct: 5,
        sensor_sample_rate_pct: 5,
        duty_cycle_pct: 5,
        max_power_budget_mw: 500,
        thermal_limit_c: 55
    };
}

pub type PowerGovernor = struct {
    battery: BatteryState,
    profile: PowerProfile,
    nominal_capacity_mwh: Int,
    low_battery_threshold_pct: Int,
    critical_battery_threshold_pct: Int,
    auto_profile_switching: Bool,
    thermal_throttled: Bool,
    emergency_shutdown_triggered: Bool,
    total_energy_used_mwh: Int,
    cap: &SysCap
};
