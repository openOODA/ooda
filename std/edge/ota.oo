// # Edge OTA Update Facade
//
// Logline: Re-exports over-the-air firmware updates, partition management, verification, and hardware stubs.
//
// Setup: Pure module shim importing types, update engine, and low-level hardware stubs.
//
// Beats:
//   1. Import OTA types, engine, and stubs companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Execute self-verification suite to validate update workflows.

import "./ota_types.oo";
import "./ota_engine.oo";
import "./ota_stubs.oo";

pub fn shim_marker_manifest_new() -> OtaManifest {
    return ota_manifest_new(2, 0, 0, 1, 1024, 12345, true, false);
}

pub fn shim_marker_slot_new() -> OtaPartitionSlot {
    return ota_slot_new(0, true, true, 10000);
}

pub fn shim_marker_manager_init(cap: &SysCap) -> OtaManager {
    return ota_manager_init(cap);
}

pub fn shim_marker_start_update(mgr: &mut OtaManager, manifest: &OtaManifest) -> Bool {
    return ota_manager_start_update(mgr, manifest);
}

pub fn shim_marker_chunk_recv(mgr: &mut OtaManager) -> Int {
    return ota_manager_chunk_received(mgr, 1024);
}

pub fn shim_marker_verify_payload(mgr: &mut OtaManager) -> Bool {
    return ota_manager_verify_payload(mgr, 12345, true);
}

pub fn shim_marker_apply_update(mgr: &mut OtaManager, sys: &SysCap) -> Bool {
    return ota_manager_apply_update(mgr, sys);
}

pub fn shim_marker_mark_boot(mgr: &mut OtaManager) -> Bool {
    return ota_manager_mark_boot_successful(mgr);
}

pub fn shim_marker_rollback(mgr: &mut OtaManager, sys: &SysCap) -> Bool {
    return ota_manager_rollback(mgr, sys, 1);
}

pub fn shim_marker_is_busy(mgr: &OtaManager) -> Bool {
    return ota_manager_is_busy(mgr);
}

verify ota {
    let cap: &SysCap = 0;
    let mut mgr: OtaManager = ota_manager_init(cap);
    assert_eq!(ota_manager_get_state(&mgr), 0);
    assert_eq!(ota_manager_is_busy(&mgr), false);

    let manifest: OtaManifest = ota_manifest_new(2, 1, 0, 105, 1000, 123456, true, false);
    assert_eq!(ota_manifest_is_valid(&manifest), true);
    assert_eq!(ota_manifest_version_code(&manifest), 20100);

    let start_ok: Bool = ota_manager_start_update(&mut mgr, &manifest);
    assert_eq!(start_ok, true);
    assert_eq!(ota_manager_get_state(&mgr), 1);
    assert_eq!(ota_manager_is_busy(&mgr), true);

    let s1: Int = ota_manager_chunk_received(&mut mgr, 500);
    assert_eq!(s1, 1);
    assert_eq!(ota_manager_get_progress(&mgr), 50);

    let s2: Int = ota_manager_chunk_received(&mut mgr, 500);
    assert_eq!(s2, 2);
    assert_eq!(ota_manager_get_progress(&mgr), 100);

    let v_ok: Bool = ota_manager_verify_payload(&mut mgr, 123456, true);
    assert_eq!(v_ok, true);
    assert_eq!(ota_manager_get_state(&mgr), 3);

    let apply_ok: Bool = ota_manager_apply_update(&mut mgr, cap);
    assert_eq!(apply_ok, true);
    assert_eq!(ota_manager_get_state(&mgr), 5);

    let boot_ok: Bool = ota_manager_mark_boot_successful(&mut mgr);
    assert_eq!(boot_ok, true);
    assert_eq!(ota_manager_get_state(&mgr), 0);
}
