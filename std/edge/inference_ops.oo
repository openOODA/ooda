// # Edge inference ops & hardware backend management
//
// Logline: Engine warmup, backend and quantization selection, admission checks.
// residual: &mut destubbed to by-value.
import "std/edge/inference_types.oo";

pub fn model_config_full(model_id: Int, input_dim: Int, output_dim: Int, quant: Int, backend: Int, max_batch: Int, latency_target: Int, mem_mb: Int) -> ModelConfig {
    return ModelConfig {
        model_id: model_id,
        input_dim: input_dim,
        output_dim: output_dim,
        quant_level: quant,
        device_backend: backend,
        max_batch_size: max_batch,
        latency_target_ms: latency_target,
        memory_budget_mb: mem_mb
    };
}

pub fn metrics_new() -> InferenceMetrics {
    return InferenceMetrics {
        total_inferences: 0,
        successful_inferences: 0,
        failed_inferences: 0,
        total_latency_ms: 0,
        min_latency_ms: 1000000,
        max_latency_ms: 0
    };
}

pub fn inference_request_new(request_id: Int, priority: Int, batch_size: Int, confidence_threshold: Int, timeout_ms: Int) -> InferenceRequest {
    return InferenceRequest {
        request_id: request_id,
        priority: priority,
        batch_size: batch_size,
        confidence_threshold: confidence_threshold,
        timeout_ms: timeout_ms
    };
}

pub fn inference_engine_init(cfg: ModelConfig) -> InferenceEngine {
    let mut power: Int = 2500;
    let be: Int = (cfg).device_backend;
    if be == 1 {
        power = 5000;
    } else {
        if be == 2 {
            power = 1200;
        } else {
            if be == 3 {
                power = 1800;
            }
        }
    }
    return InferenceEngine {
        config: cfg,
        metrics: metrics_new(),
        is_initialized: true,
        is_warm: false,
        current_temperature_c: 25,
        power_consumption_mw: power,
        last_status_code: 0,
        last_output_score: 0,
        last_latency_ms: 0
    };
}

pub fn inference_engine_warmup(engine: InferenceEngine) -> InferenceEngine {
    let init: Bool = (engine).is_initialized;
    if init == false {
        return engine;
    }
    return InferenceEngine {
        config: (engine).config,
        metrics: (engine).metrics,
        is_initialized: (engine).is_initialized,
        is_warm: true,
        current_temperature_c: (engine).current_temperature_c,
        power_consumption_mw: (engine).power_consumption_mw,
        last_status_code: (engine).last_status_code,
        last_output_score: (engine).last_output_score,
        last_latency_ms: (engine).last_latency_ms
    };
}

pub fn inference_engine_set_backend(engine: InferenceEngine, new_backend: Int) -> InferenceEngine {
    if new_backend < 0 {
        return engine;
    }
    if new_backend > 3 {
        return engine;
    }
    let cfg: ModelConfig = (engine).config;
    let new_cfg: ModelConfig = ModelConfig {
        model_id: (cfg).model_id,
        input_dim: (cfg).input_dim,
        output_dim: (cfg).output_dim,
        quant_level: (cfg).quant_level,
        device_backend: new_backend,
        max_batch_size: (cfg).max_batch_size,
        latency_target_ms: (cfg).latency_target_ms,
        memory_budget_mb: (cfg).memory_budget_mb
    };
    let mut power: Int = 2500;
    if new_backend == 1 {
        power = 5000;
    } else {
        if new_backend == 2 {
            power = 1200;
        } else {
            if new_backend == 3 {
                power = 1800;
            }
        }
    }
    return InferenceEngine {
        config: new_cfg,
        metrics: (engine).metrics,
        is_initialized: (engine).is_initialized,
        is_warm: (engine).is_warm,
        current_temperature_c: (engine).current_temperature_c,
        power_consumption_mw: power,
        last_status_code: (engine).last_status_code,
        last_output_score: (engine).last_output_score,
        last_latency_ms: (engine).last_latency_ms
    };
}

pub fn inference_engine_set_quantization(engine: InferenceEngine, new_quant: Int) -> InferenceEngine {
    if new_quant < 0 {
        return engine;
    }
    if new_quant > 3 {
        return engine;
    }
    let cfg: ModelConfig = (engine).config;
    let new_cfg: ModelConfig = ModelConfig {
        model_id: (cfg).model_id,
        input_dim: (cfg).input_dim,
        output_dim: (cfg).output_dim,
        quant_level: new_quant,
        device_backend: (cfg).device_backend,
        max_batch_size: (cfg).max_batch_size,
        latency_target_ms: (cfg).latency_target_ms,
        memory_budget_mb: (cfg).memory_budget_mb
    };
    return InferenceEngine {
        config: new_cfg,
        metrics: (engine).metrics,
        is_initialized: (engine).is_initialized,
        is_warm: (engine).is_warm,
        current_temperature_c: (engine).current_temperature_c,
        power_consumption_mw: (engine).power_consumption_mw,
        last_status_code: (engine).last_status_code,
        last_output_score: (engine).last_output_score,
        last_latency_ms: (engine).last_latency_ms
    };
}

pub fn inference_engine_can_process(engine: InferenceEngine, req: InferenceRequest) -> Bool {
    let init: Bool = (engine).is_initialized;
    if init == false {
        return false;
    }
    let cfg: ModelConfig = (engine).config;
    let bsz: Int = (req).batch_size;
    let max_b: Int = (cfg).max_batch_size;
    if bsz > max_b {
        return false;
    }
    let tout: Int = (req).timeout_ms;
    if tout < 5 {
        return false;
    }
    return true;
}
