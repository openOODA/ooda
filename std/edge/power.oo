// # Edge Power Management Facade
//
// Logline: Re-exports battery telemetry, power profiles, dynamic governance engine, and hardware drivers.
//
// Setup: Pure module shim importing types, calculations, governor engine, and stubs submodules.
//
// Beats:
//   1. Import power types, ops, governor, and stubs companion modules.
//   2. Re-export public symbols with typed shim markers.
//   3. Execute self-verification suite to validate battery monitoring and profile switching.

import "./power_types.oo";
import "./power_ops.oo";
import "./power_governor.oo";
import "./power_stubs.oo";

pub fn shim_marker_battery_new() -> BatteryState {
    return battery_state_new(80, 12000, 2000, 95, 30, 0, 0);
}

pub fn shim_marker_power_calc(state: &BatteryState) -> Int {
    return battery_calculate_power_mw(state);
}

pub fn shim_marker_profile_perf() -> PowerProfile {
    return power_profile_performance();
}

pub fn shim_marker_governor_init(cap: &SysCap) -> PowerGovernor {
    return power_governor_init(cap, 50000);
}

pub fn shim_marker_governor_eval(gov: &mut PowerGovernor) -> Int {
    return power_governor_evaluate(gov);
}

pub fn shim_marker_is_throttled(gov: &PowerGovernor) -> Bool {
    return power_governor_is_throttled(gov);
}

pub fn shim_marker_remaining_sec(gov: &PowerGovernor) -> Int {
    return power_governor_get_remaining_sec(gov);
}

pub fn shim_marker_is_critical(gov: &PowerGovernor) -> Bool {
    return power_governor_is_critical(gov);
}

verify power {
    let bat: BatteryState = battery_state_new(80, 12000, 2000, 95, 30, 0, 0);
    assert_eq!((bat).capacity_pct, 80);
    assert_eq!((bat).voltage_mv, 12000);

    let power_mw: Int = battery_calculate_power_mw(&bat);
    assert_eq!(power_mw, 24000); // 12V * 2A = 24W = 24000mW

    let rem_mwh: Int = battery_remaining_energy_mwh(&bat, 50000); // 50Wh battery @ 95% health = 47.5Wh, @ 80% charge = 38Wh = 38000mWh
    assert_eq!(rem_mwh, 38000);

    let runtime: Int = battery_estimate_runtime_sec(&bat, 50000); // 38000mWh / 24000mW * 3600 = 5700 sec
    assert_eq!(runtime, 5700);

    let cap: &SysCap = 0;
    let mut gov: PowerGovernor = power_governor_init(cap, 50000);
    power_governor_update_telemetry(&mut gov, bat);

    let mode: Int = power_governor_evaluate(&mut gov);
    assert_eq!(mode, 1); // Balanced by default

    // Test low battery auto-switch
    let low_bat: BatteryState = battery_state_new(15, 11000, 1500, 95, 30, 0, 0);
    power_governor_update_telemetry(&mut gov, low_bat);
    let low_mode: Int = power_governor_evaluate(&mut gov);
    assert_eq!(low_mode, 2); // PowerSaver

    // Test critical battery auto-shutdown
    let crit_bat: BatteryState = battery_state_new(4, 10500, 1000, 95, 30, 0, 0);
    power_governor_update_telemetry(&mut gov, crit_bat);
    let crit_mode: Int = power_governor_evaluate(&mut gov);
    assert_eq!(crit_mode, 4); // DeepSleep / Shutdown
    assert_eq!(power_governor_is_critical(&gov), true);
}
