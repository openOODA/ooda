type MeshNodeConfig = struct {
    node_id: Int,
    mesh_id: Int,
    role: Int
};

pub fn mesh_config_new(node_id: Int, mesh_id: Int, role: Int) -> MeshNodeConfig {
    return MeshNodeConfig {
        node_id: node_id,
        mesh_id: mesh_id,
        role: role
    };
}

pub fn mesh_config_id(c: MeshNodeConfig) -> Int {
    return c.node_id;
}
