// # Edge inference thermal, energy, memory analysis
//
// Logline: Average latency, thermal throttle, energy and memory estimates.
// residual: &mut destubbed to by-value.

import "std/edge/inference_ops.oo";

pub fn inference_engine_calc_avg_latency(engine: InferenceEngine) -> Int {
    let m: InferenceMetrics = (engine).metrics;
    let total: Int = (m).successful_inferences;
    if total <= 0 {
        return 0;
    }
    let tot_lat: Int = (m).total_latency_ms;
    return tot_lat / total;
}

pub fn inference_engine_reset_metrics(engine: InferenceEngine) -> InferenceEngine {
    return InferenceEngine {
        config: (engine).config,
        metrics: metrics_new(),
        is_initialized: (engine).is_initialized,
        is_warm: (engine).is_warm,
        current_temperature_c: (engine).current_temperature_c,
        power_consumption_mw: (engine).power_consumption_mw,
        last_status_code: (engine).last_status_code,
        last_output_score: (engine).last_output_score,
        last_latency_ms: (engine).last_latency_ms
    };
}

pub fn inference_engine_check_thermal_throttle(engine: InferenceEngine, current_temp: Int) -> InferenceEngine {
    if current_temp > 85 {
        let cfg: ModelConfig = (engine).config;
        let new_cfg: ModelConfig = ModelConfig {
            model_id: (cfg).model_id,
            input_dim: (cfg).input_dim,
            output_dim: (cfg).output_dim,
            quant_level: 2,
            device_backend: 2,
            max_batch_size: (cfg).max_batch_size,
            latency_target_ms: (cfg).latency_target_ms,
            memory_budget_mb: (cfg).memory_budget_mb
        };
        return InferenceEngine {
            config: new_cfg,
            metrics: (engine).metrics,
            is_initialized: (engine).is_initialized,
            is_warm: (engine).is_warm,
            current_temperature_c: current_temp,
            power_consumption_mw: 1200,
            last_status_code: 1,
            last_output_score: (engine).last_output_score,
            last_latency_ms: (engine).last_latency_ms
        };
    }
    return InferenceEngine {
        config: (engine).config,
        metrics: (engine).metrics,
        is_initialized: (engine).is_initialized,
        is_warm: (engine).is_warm,
        current_temperature_c: current_temp,
        power_consumption_mw: (engine).power_consumption_mw,
        last_status_code: 0,
        last_output_score: (engine).last_output_score,
        last_latency_ms: (engine).last_latency_ms
    };
}

pub fn inference_engine_estimate_energy_uJ(engine: InferenceEngine, latency_ms: Int) -> Int {
    let pwr: Int = (engine).power_consumption_mw;
    return pwr * latency_ms;
}

pub fn inference_select_optimal_backend(battery_percent: Int, thermal_temp_c: Int) -> Int {
    if thermal_temp_c > 80 {
        return 2;
    }
    if battery_percent < 20 {
        return 2;
    }
    if battery_percent > 60 {
        return 1;
    }
    return 0;
}

pub fn inference_estimate_memory_usage_mb(input_dim: Int, output_dim: Int, quant: Int) -> Int {
    let mut bytes_per_elem: Int = 4;
    if quant == 1 {
        bytes_per_elem = 2;
    } else {
        if quant == 2 {
            bytes_per_elem = 1;
        } else {
            if quant == 3 {
                bytes_per_elem = 1;
            }
        }
    }
    let total_elements: Int = (input_dim * output_dim) + input_dim + output_dim;
    let bytes_total: Int = total_elements * bytes_per_elem;
    let mb: Int = bytes_total / (1024 * 1024);
    if mb < 1 {
        return 1;
    }
    return mb;
}
