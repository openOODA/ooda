// # Edge Mesh Operations & Telemetry
//
// Logline: Implements link health assessment, node state transitions, metrics tracking, and hop countdown logic.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type MeshNodeConfig = struct {
    node_id: Int, max_peers: Int, role: Int, heartbeat_interval_ms: Int
};

type MeshLink = struct {
    peer_id: Int, link_quality: Int, latency_ms: Int, last_seen_ms: Int,
    is_connected: Bool
};

type MeshNode = struct {
    config: MeshNodeConfig, status: Int, battery_level_pct: Int,
    cpu_load_pct: Int, active_peer_count: Int, sequence_number: Int,
    total_sent: Int, total_recv: Int, total_forwarded: Int, total_dropped: Int,
    last_action: Int
};

type MeshPacket = struct {
    src_node: Int, dst_node: Int, seq: Int, ttl: Int, hop_count: Int,
    payload_type: Int, payload_val: Int
};

pub fn mesh_config_init(node_id: Int, max_peers: Int, role: Int) -> MeshNodeConfig {
    return MeshNodeConfig {
        node_id: node_id, max_peers: max_peers, role: role,
        heartbeat_interval_ms: 1000
    };
}

pub fn mesh_node_init(cfg: MeshNodeConfig) -> MeshNode {
    return MeshNode {
        config: cfg, status: 1, battery_level_pct: 100, cpu_load_pct: 0,
        active_peer_count: 0, sequence_number: 0, total_sent: 0, total_recv: 0,
        total_forwarded: 0, total_dropped: 0, last_action: 0
    };
}

pub fn mesh_link_init(peer_id: Int, quality: Int, latency: Int) -> MeshLink {
    let mut connected: Bool = false;
    if quality > 0  { connected = true; }
    return MeshLink {
        peer_id: peer_id, link_quality: quality, latency_ms: latency,
        last_seen_ms: 0, is_connected: connected
    };
}

pub fn mesh_packet_create(src: Int, dst: Int, seq: Int, ttl: Int, payload_type: Int, payload_val: Int) -> MeshPacket {
    return MeshPacket {
        src_node: src, dst_node: dst, seq: seq, ttl: ttl, hop_count: 0,
        payload_type: payload_type, payload_val: payload_val
    };
}

pub fn mesh_link_is_healthy(link: MeshLink) -> Bool {
    if link.is_connected == false  { return false; }
    if link.link_quality < 20  { return false; }
    if link.latency_ms > 500  { return false; }
    return true;
}

pub fn mesh_link_update(link: MeshLink, quality: Int, latency: Int, timestamp_ms: Int) -> MeshLink {
    let mut connected: Bool = false;
    if quality > 0  { connected = true; }
    return MeshLink {
        peer_id: link.peer_id, link_quality: quality, latency_ms: latency,
        last_seen_ms: timestamp_ms, is_connected: connected
    };
}

pub fn mesh_node_set_status(node: MeshNode, status: Int) -> MeshNode {
    return MeshNode {
        config: node.config, status: status,
        battery_level_pct: node.battery_level_pct, cpu_load_pct: node.cpu_load_pct,
        active_peer_count: node.active_peer_count,
        sequence_number: node.sequence_number, total_sent: node.total_sent,
        total_recv: node.total_recv, total_forwarded: node.total_forwarded,
        total_dropped: node.total_dropped, last_action: node.last_action
    };
}

pub fn mesh_node_get_status(node: MeshNode) -> Int { return node.status; }

pub fn mesh_node_update_metrics(node: MeshNode, battery_pct: Int, cpu_pct: Int) -> MeshNode {
    let mut st: Int = node.status;
    if battery_pct < 10  { st = 3; }
    return MeshNode {
        config: node.config, status: st, battery_level_pct: battery_pct,
        cpu_load_pct: cpu_pct, active_peer_count: node.active_peer_count,
        sequence_number: node.sequence_number, total_sent: node.total_sent,
        total_recv: node.total_recv, total_forwarded: node.total_forwarded,
        total_dropped: node.total_dropped, last_action: node.last_action
    };
}

pub fn mesh_node_add_peer(node: MeshNode) -> MeshNode {
    let max_p: Int = node.config.max_peers;
    let curr_p: Int = node.active_peer_count;
    let mut next_p: Int = curr_p;
    let mut action: Int = 0;
    if curr_p < max_p {
        next_p = curr_p + 1;
        action = 1;
    }
    return MeshNode {
        config: node.config, status: node.status,
        battery_level_pct: node.battery_level_pct, cpu_load_pct: node.cpu_load_pct,
        active_peer_count: next_p, sequence_number: node.sequence_number,
        total_sent: node.total_sent, total_recv: node.total_recv,
        total_forwarded: node.total_forwarded, total_dropped: node.total_dropped,
        last_action: action
    };
}

pub fn mesh_node_remove_peer(node: MeshNode) -> MeshNode {
    let curr_p: Int = node.active_peer_count;
    let mut next_p: Int = curr_p;
    let mut action: Int = 0;
    if curr_p > 0 {
        next_p = curr_p - 1;
        action = 1;
    }
    return MeshNode {
        config: node.config, status: node.status,
        battery_level_pct: node.battery_level_pct, cpu_load_pct: node.cpu_load_pct,
        active_peer_count: next_p, sequence_number: node.sequence_number,
        total_sent: node.total_sent, total_recv: node.total_recv,
        total_forwarded: node.total_forwarded, total_dropped: node.total_dropped,
        last_action: action
    };
}

pub fn mesh_packet_decrement_ttl(pkt: MeshPacket) -> MeshPacket {
    let new_ttl: Int = pkt.ttl - 1;
    return MeshPacket {
        src_node: pkt.src_node, dst_node: pkt.dst_node, seq: pkt.seq, ttl: new_ttl,
        hop_count: pkt.hop_count + 1, payload_type: pkt.payload_type,
        payload_val: pkt.payload_val
    };
}

pub fn mesh_node_is_leader(node: MeshNode) -> Bool {
    if node.config.role == 1  { return true; }
    return false;
}

pub fn mesh_node_should_heartbeat(node: MeshNode, current_time_ms: Int, last_heartbeat_ms: Int) -> Bool {
    if node.status == 0  { return false; }
    let interval: Int = node.config.heartbeat_interval_ms;
    let elapsed: Int = current_time_ms - last_heartbeat_ms;
    if elapsed >= interval  { return true; }
    return false;
}

pub fn mesh_node_send_packet(node: MeshNode, dst_node: Int, payload_type: Int, payload_val: Int) -> MeshNode {
    let new_seq: Int = node.sequence_number + 1;
    return MeshNode {
        config: node.config, status: node.status,
        battery_level_pct: node.battery_level_pct, cpu_load_pct: node.cpu_load_pct,
        active_peer_count: node.active_peer_count, sequence_number: new_seq,
        total_sent: node.total_sent + 1, total_recv: node.total_recv,
        total_forwarded: node.total_forwarded, total_dropped: node.total_dropped,
        last_action: new_seq
    };
}

pub fn mesh_node_process_packet(node: MeshNode, pkt: MeshPacket) -> MeshNode {
    if node.status == 0 {
        return MeshNode {
            config: node.config, status: node.status,
            battery_level_pct: node.battery_level_pct, cpu_load_pct: node.cpu_load_pct,
            active_peer_count: node.active_peer_count,
            sequence_number: node.sequence_number, total_sent: node.total_sent,
            total_recv: node.total_recv, total_forwarded: node.total_forwarded,
            total_dropped: node.total_dropped + 1, last_action: 0 - 1
        };
    }
    let recv_n: Int = node.total_recv + 1;
    if pkt.dst_node == node.config.node_id {
        return MeshNode {
            config: node.config, status: node.status,
            battery_level_pct: node.battery_level_pct, cpu_load_pct: node.cpu_load_pct,
            active_peer_count: node.active_peer_count,
            sequence_number: node.sequence_number, total_sent: node.total_sent,
            total_recv: recv_n, total_forwarded: node.total_forwarded,
            total_dropped: node.total_dropped, last_action: 1
        };
    }
    let dec: MeshPacket = mesh_packet_decrement_ttl(pkt);
    if dec.ttl <= 0 {
        return MeshNode {
            config: node.config, status: node.status,
            battery_level_pct: node.battery_level_pct, cpu_load_pct: node.cpu_load_pct,
            active_peer_count: node.active_peer_count,
            sequence_number: node.sequence_number, total_sent: node.total_sent,
            total_recv: recv_n, total_forwarded: node.total_forwarded,
            total_dropped: node.total_dropped + 1, last_action: 0
        };
    }
    return MeshNode {
        config: node.config, status: node.status,
        battery_level_pct: node.battery_level_pct, cpu_load_pct: node.cpu_load_pct,
        active_peer_count: node.active_peer_count,
        sequence_number: node.sequence_number, total_sent: node.total_sent,
        total_recv: recv_n, total_forwarded: node.total_forwarded + 1,
        total_dropped: node.total_dropped, last_action: 2
    };
}
