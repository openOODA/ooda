// # Edge Mesh Packet TTL Decrement
//
// Logline: Decrement packet TTL and increment hop_count, return the new MeshPacket.
//
// Setup: Imports mesh_types.oo.
//
// Beats:
//   1. mesh_packet_decrement_ttl: ttl-1, hop_count+1.
//
// residual: &mut destubbed to by-value.

import "./mesh_ops_types.oo";

pub fn mesh_packet_decrement_ttl(pkt: MeshPacket) -> MeshPacket {
    let new_ttl: Int = (pkt).ttl - 1;
    return MeshPacket {
        src_node: (pkt).src_node,
        dst_node: (pkt).dst_node,
        seq: (pkt).seq,
        ttl: new_ttl,
        hop_count: (pkt).hop_count + 1,
        payload_type: (pkt).payload_type,
        payload_val: (pkt).payload_val
    };
}
