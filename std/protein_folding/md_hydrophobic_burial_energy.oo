// # Hydrophobic Burial & Desolvation Free Energy
//
// Logline: Calculates hydrophobic residue burial transfer free energies and solvent desolvation driving forces during protein folding.
//
// Setup: Thermodynamic folding engine evaluating hydrophobic core formation and aliphatic/aromatic sidechain desolvation free energies.
//
// Beats:
//   1. Define HydrophobicTransferScale and BurialState data structures.
//   2. Assign octanol-water / cyclohexane transfer free energies delta_G_transfer for 20 amino acids.
//   3. Compute hydrophobic collapse potential from fractional sidechain burial ratios.

pub type HydrophobicTransferScale = struct {
    residue_name: String,
    delta_g_transfer_kcal: Float, // Positive = hydrophobic (favors burial)
    max_accessible_area_a2: Float,
};

pub type BurialState = struct {
    residue_index: Int,
    residue_name: String,
    accessible_area_a2: Float,
    burial_fraction: Float,
    burial_energy_kcal: Float,
    is_buried_core: Bool,
};

pub fn hydrophobic_residue_scale(aa: String) -> HydrophobicTransferScale {
    if aa == "TRP" || aa == "W" { return HydrophobicTransferScale { residue_name: aa, delta_g_transfer_kcal: 3.4, max_accessible_area_a2: 259.0 }; }
    if aa == "PHE" || aa == "F" { return HydrophobicTransferScale { residue_name: aa, delta_g_transfer_kcal: 2.8, max_accessible_area_a2: 218.0 }; }
    if aa == "LEU" || aa == "L" { return HydrophobicTransferScale { residue_name: aa, delta_g_transfer_kcal: 2.4, max_accessible_area_a2: 193.0 }; }
    if aa == "ILE" || aa == "I" { return HydrophobicTransferScale { residue_name: aa, delta_g_transfer_kcal: 2.4, max_accessible_area_a2: 185.0 }; }
    if aa == "VAL" || aa == "V" { return HydrophobicTransferScale { residue_name: aa, delta_g_transfer_kcal: 1.7, max_accessible_area_a2: 160.0 }; }
    if aa == "MET" || aa == "M" { return HydrophobicTransferScale { residue_name: aa, delta_g_transfer_kcal: 1.3, max_accessible_area_a2: 203.0 }; }
    if aa == "TYR" || aa == "Y" { return HydrophobicTransferScale { residue_name: aa, delta_g_transfer_kcal: 1.3, max_accessible_area_a2: 229.0 }; }
    if aa == "ALA" || aa == "A" { return HydrophobicTransferScale { residue_name: aa, delta_g_transfer_kcal: 0.5, max_accessible_area_a2: 115.0 }; }
    if aa == "CYS" || aa == "C" { return HydrophobicTransferScale { residue_name: aa, delta_g_transfer_kcal: 0.4, max_accessible_area_a2: 140.0 }; }
    if aa == "PRO" || aa == "P" { return HydrophobicTransferScale { residue_name: aa, delta_g_transfer_kcal: 0.2, max_accessible_area_a2: 145.0 }; }
    return HydrophobicTransferScale { residue_name: aa, delta_g_transfer_kcal: 0.0, max_accessible_area_a2: 150.0 };
}

pub fn hydrophobic_calc_burial(res_idx: Int, aa: String, exposed_area_a2: Float) -> BurialState {
    let scale = hydrophobic_residue_scale(aa);
    let max_a = (scale).max_accessible_area_a2;

    let exposed_clamped = if exposed_area_a2 > max_a { max_a } else if exposed_area_a2 < 0.0 { 0.0 } else { exposed_area_a2 };
    let burial_frac = if max_a > 0.1 { (max_a - exposed_clamped) / max_a } else { 0.0 };

    // Favorable negative energy for burying hydrophobic surface: E = - burial_fraction * delta_G_transfer
    let e_burial = -1.0 * burial_frac * (scale).delta_g_transfer_kcal;
    let is_buried = burial_frac >= 0.80;

    return BurialState {
        residue_index: res_idx,
        residue_name: aa,
        accessible_area_a2: exposed_clamped,
        burial_fraction: burial_frac,
        burial_energy_kcal: e_burial,
        is_buried_core: is_buried,
    };
}
