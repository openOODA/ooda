// # Structural RMSD & Global Distance Test (GDT-TS)
//
// Logline: Calculates Root-Mean-Square Deviation and GDT-TS / GDT-HA multi-cutoff distance alignment metrics.
//
// Setup: Protein structural assessment module scoring global and local fold deviations between prediction and target.
//
// Beats:
//   1. Define AtomPairDistance, RmsdScore, and GdtScoreResult data structures.
//   2. Compute coordinate RMSD = sqrt(sum ||x_i - y_i||^2 / N).
//   3. Compute CASP standard Global Distance Test (GDT-TS) score at 1.0, 2.0, 4.0, and 8.0 Angstrom thresholds.

pub type AtomPairDistance = struct {
    res_index: Int,
    dist_angstrom: Float
};

pub type RmsdScore = struct {
    num_atoms: Int,
    sum_dist_sq: Float,
    rmsd_angstrom: Float
};

pub type GdtScoreResult = struct {
    num_residues: Int,
    p1_fraction: Float, // <= 1.0 A
    p2_fraction: Float, // <= 2.0 A
    p4_fraction: Float, // <= 4.0 A
    p8_fraction: Float, // <= 8.0 A
    gdt_ts_score_0_to_100: Float,
    gdt_ha_score_0_to_100: Float
};

pub fn struct_sqrt(val: Float) -> Float {
    if val <= 0.0 { return 0.0; }
    let mut guess = val / 2.0;
    if guess < 0.1 { guess = 0.1; }
    let mut iter = 0;
    while iter < 10 {
        guess = 0.5 * (guess + (val / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn struct_calc_rmsd(distances_sq: List[Float]) -> RmsdScore {
    let n = list_len(distances_sq);
    if n == 0 {
        return RmsdScore { num_atoms: 0, sum_dist_sq: 0.0, rmsd_angstrom: 0.0 };
    }

    let mut sum_sq: Float = 0.0;
    let mut i = 0;
    while i < n {
        sum_sq = sum_sq + list_get(distances_sq, i);
        i = i + 1;
    }

    let nf = n as Float;
    let mean_sq = sum_sq / nf;
    let val = struct_sqrt(mean_sq);

    return RmsdScore {
        num_atoms: n,
        sum_dist_sq: sum_sq,
        rmsd_angstrom: val
    };
}

pub fn struct_calc_gdt(distances: List[Float]) -> GdtScoreResult {
    let n = list_len(distances);
    if n == 0 {
        return GdtScoreResult {
            num_residues: 0,
            p1_fraction: 0.0, p2_fraction: 0.0, p4_fraction: 0.0, p8_fraction: 0.0,
            gdt_ts_score_0_to_100: 0.0, gdt_ha_score_0_to_100: 0.0
        };
    }

    let mut c1 = 0;
    let mut c2 = 0;
    let mut c4 = 0;
    let mut c8 = 0;
    let mut c05 = 0;

    let mut i = 0;
    while i < n {
        let d = list_get(distances, i);
        if d <= 0.5 { c05 = c05 + 1; }
        if d <= 1.0 { c1 = c1 + 1; }
        if d <= 2.0 { c2 = c2 + 1; }
        if d <= 4.0 { c4 = c4 + 1; }
        if d <= 8.0 { c8 = c8 + 1; }
        i = i + 1;
    }

    let nf = n as Float;
    let p1 = (c1 as Float) / nf;
    let p2 = (c2 as Float) / nf;
    let p4 = (c4 as Float) / nf;
    let p8 = (c8 as Float) / nf;
    let p05 = (c05 as Float) / nf;

    // GDT_TS = (P1 + P2 + P4 + P8) / 4 * 100
    let gdt_ts = (p1 + p2 + p4 + p8) * 25.0;
    // GDT_HA = (P0.5 + P1 + P2 + P4) / 4 * 100
    let gdt_ha = (p05 + p1 + p2 + p4) * 25.0;

    return GdtScoreResult {
        num_residues: n,
        p1_fraction: p1,
        p2_fraction: p2,
        p4_fraction: p4,
        p8_fraction: p8,
        gdt_ts_score_0_to_100: gdt_ts,
        gdt_ha_score_0_to_100: gdt_ha
    };
}
