// # Steered Molecular Dynamics (SMD) & Jarzynski Work
//
// Logline: Calculates non-equilibrium pulling potentials, steering forces, and Jarzynski equality work integration for protein unfolding.
//
// Setup: Non-equilibrium pulling simulation engine applying moving virtual spring restraints along designated reaction paths.
//
// Beats:
//   1. Define SmdProtocol, PullingState, and JarzynskiResult data structures.
//   2. Calculate moving spring position xi_target(t) = xi_0 + v_pull * t and steering force.
//   3. Integrate cumulative mechanical work W = int F * dx and evaluate exponential work averages.

pub type SmdProtocol = struct {
    pulling_velocity_a_per_ps: Float,
    spring_constant_k: Float, // kcal / (mol * A^2)
    initial_distance_a: Float,
    temperature_k: Float
};

pub type PullingState = struct {
    time_ps: Float,
    actual_distance_a: Float,
    target_distance_a: Float,
    pulling_force_kcal_per_a: Float,
    cumulative_work_kcal: Float
};

pub type JarzynskiResult = struct {
    num_trajectories: Int,
    mean_work_kcal: Float,
    free_energy_delta_g_kcal: Float,
    dissipated_work_kcal: Float
};

pub fn smd_calc_target_pos(protocol: &SmdProtocol, time_ps: Float) -> Float {
    return (protocol).initial_distance_a + ((protocol).pulling_velocity_a_per_ps * time_ps);
}

pub fn smd_calc_pulling_force(protocol: &SmdProtocol, actual_dist: Float, target_dist: Float) -> Float {
    // F_smd = k * (target - actual)
    let delta = target_dist - actual_dist;
    return (protocol).spring_constant_k * delta;
}

pub fn smd_step_work(force_old: Float, force_new: Float, dx_target: Float) -> Float {
    // Trapezoidal work increment: dW = 0.5 * (F_old + F_new) * dx
    return 0.5 * (force_old + force_new) * dx_target;
}

pub fn smd_evaluate_state(
    protocol: &SmdProtocol,
    time_ps: Float,
    actual_dist: Float,
    cum_work: Float,
) -> PullingState {
    let target = smd_calc_target_pos(protocol, time_ps);
    let force = smd_calc_pulling_force(protocol, actual_dist, target);

    return PullingState {
        time_ps: time_ps,
        actual_distance_a: actual_dist,
        target_distance_a: target,
        pulling_force_kcal_per_a: force,
        cumulative_work_kcal: cum_work
    };
}
