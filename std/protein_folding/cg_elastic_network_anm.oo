// # Anisotropic Network Model (ANM) Elastic Dynamics
//
// Logline: Implements the Anisotropic Network Model 3Nx3N Hessian supermatrix and harmonic normal mode vibrational frequencies.
//
// Setup: Coarse-grained C-alpha elastic network model predicting global domain flexibility and conformational transitions.
//
// Beats:
//   1. Define AnmParams, AnmHessianBlock3x3, and AnmModeResult data structures.
//   2. Formulate analytical 3x3 Hessian submatrices H_ij = -(gamma / r_ij^2) * [d_r * d_r^T] for pairs within cutoff R_c.
//   3. Compute mean-square atomic positional fluctuations <(Delta r_i)^2> from low-frequency normal mode eigenvalues.

pub type AnmParams = struct {
    cutoff_radius_a: Float, // Typically 13.0 - 15.0 Angstroms
    spring_constant_gamma: Float, // kcal / (mol * A^2)
    num_nodes: Int,
};

pub type AnmHessianBlock3x3 = struct {
    node_i: Int,
    node_j: Int,
    hxx: Float,
    hxy: Float,
    hxz: Float,
    hyy: Float,
    hyz: Float,
    hzz: Float,
};

pub type AnmModeResult = struct {
    mode_index: Int,
    eigenvalue_frequency_sq: Float,
    collectivity_index: Float,
};

pub fn anm_params_default(n_ca: Int) -> AnmParams {
    return AnmParams {
        cutoff_radius_a: 14.0,
        spring_constant_gamma: 1.0,
        num_nodes: n_ca,
    };
}

pub fn anm_calc_hessian_subblock(
    dx: Float,
    dy: Float,
    dz: Float,
    gamma: Float,
) -> AnmHessianBlock3x3 {
    let r2 = (dx * dx) + (dy * dy) + (dz * dz);
    if r2 < 0.001 {
        return AnmHessianBlock3x3 {
            node_i: 0, node_j: 0,
            hxx: 0.0, hxy: 0.0, hxz: 0.0,
            hyy: 0.0, hyz: 0.0, hzz: 0.0,
        };
    }

    let factor = -1.0 * gamma / r2;

    return AnmHessianBlock3x3 {
        node_i: 0,
        node_j: 1,
        hxx: factor * dx * dx,
        hxy: factor * dx * dy,
        hxz: factor * dx * dz,
        hyy: factor * dy * dy,
        hyz: factor * dy * dz,
        hzz: factor * dz * dz,
    };
}

pub fn anm_calc_fluctuation(temp_k: Float, sum_inv_eigenvalues: Float) -> Float {
    // <(Delta R_i)^2> = (3 * k_B * T / gamma) * sum(1 / lambda_k)
    let k_b: Float = 0.001987204;
    return 3.0 * k_b * temp_k * sum_inv_eigenvalues;
}
