// # Ewald Summation for Periodic Long-Range Electrostatics
//
// Logline: Calculates classical Ewald summation splitting electrostatic potential into direct, reciprocal, and self-interaction terms.
//
// Setup: Periodic electrostatics engine evaluating Fourier space k-vectors and screening Gaussian width parameters.
//
// Beats:
//   1. Define EwaldParams, FourierVectorK, and EwaldEnergyComponents data structures.
//   2. Calculate reciprocal space structure factor S(k) and exponential damping exp(-k^2 / (4*alpha^2)).
//   3. Compute dipole surface correction term for tinfoil / vacuum boundary conditions.

pub type EwaldParams = struct {
    alpha_damping: Float,
    real_cutoff_a: Float,
    k_max: Int,
    box_length_a: Float,
};

pub type FourierVectorK = struct {
    kx: Float,
    ky: Float,
    kz: Float,
    k_sq: Float,
};

pub type EwaldEnergyComponents = struct {
    e_real: Float,
    e_reciprocal: Float,
    e_self: Float,
    e_total: Float,
};

pub fn ewald_params_default(box_len: Float) -> EwaldParams {
    return EwaldParams {
        alpha_damping: 0.35,
        real_cutoff_a: 10.0,
        k_max: 5,
        box_length_a: box_len,
    };
}

pub fn ewald_make_k_vector(nx: Int, ny: Int, nz: Int, box_len: Float) -> FourierVectorK {
    let two_pi: Float = 6.2831853;
    let factor = two_pi / box_len;

    let kx = (nx as Float) * factor;
    let ky = (ny as Float) * factor;
    let kz = (nz as Float) * factor;
    let k2 = (kx * kx) + (ky * ky) + (kz * kz);

    return FourierVectorK {
        kx: kx,
        ky: ky,
        kz: kz,
        k_sq: k2,
    };
}

pub fn ewald_reciprocal_factor(k_vec: &FourierVectorK, alpha: Float, volume: Float) -> Float {
    let k2 = (k_vec).k_sq;
    if k2 < 0.0001 || volume < 0.0001 { return 0.0; }

    let four_alpha_sq = 4.0 * alpha * alpha;
    let exponent = -1.0 * k2 / four_alpha_sq;

    // exp(exponent) approximation: 1 / (1 - exponent + 0.5*exponent^2)
    let neg_exp = -1.0 * exponent;
    let exp_val = 1.0 / (1.0 + neg_exp + (0.5 * neg_exp * neg_exp));

    let four_pi: Float = 12.5663706;
    let f_coulomb: Float = 332.0637;

    return (four_pi * f_coulomb / volume) * (exp_val / k2);
}

pub fn ewald_sum_components(e_r: Float, e_recip: Float, e_self: Float) -> EwaldEnergyComponents {
    return EwaldEnergyComponents {
        e_real: e_r,
        e_reciprocal: e_recip,
        e_self: e_self,
        e_total: e_r + e_recip + e_self,
    };
}
