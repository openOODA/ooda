// # Ramachandran Backbone Dihedral Energy & Statistical Potential
//
// Logline: Calculates statistical backbone dihedral free energy landscapes and steric clash penalties for phi and psi angles.
//
// Setup: Conformational scoring module evaluating protein backbone steric feasibility from empirical phi/psi distributions.
//
// Beats:
//   1. Define RamaPoint, RamaConformationType, and RamaEnergyResult data structures.
//   2. Classify (phi, psi) coordinate pairs into core alpha-helix, beta-sheet, left-handed helix, or forbidden zones.
//   3. Compute Boltzmann negative log-likelihood statistical energy potential E(phi, psi) = -k_B*T * ln(P/P_max).

pub type RamaPoint = struct {
    phi_deg: Float,
    psi_deg: Float,
    residue_name: String
};

pub type RamaConformationType = struct {
    region_name: String,
    is_core_allowed: Bool,
    is_generously_allowed: Bool,
    is_disallowed: Bool
};

pub type RamaEnergyResult = struct {
    statistical_energy_kcal: Float,
    conformation: RamaConformationType
};

pub fn rama_classify_conformation(phi: Float, psi: Float) -> RamaConformationType {
    // Alpha-helix region: phi in [-160, -40], psi in [-70, 20]
    if phi >= -160.0 && phi <= -40.0 && psi >= -70.0 && psi <= 20.0 {
        return RamaConformationType {
            region_name: "Alpha-Helix Core",
            is_core_allowed: true,
            is_generously_allowed: false,
            is_disallowed: false
        };
    }

    // Beta-sheet region: phi in [-180, -60], psi in [60, 180]
    if phi >= -180.0 && phi <= -60.0 && psi >= 60.0 && psi <= 180.0 {
        return RamaConformationType {
            region_name: "Beta-Sheet Core",
            is_core_allowed: true,
            is_generously_allowed: false,
            is_disallowed: false
        };
    }

    // Left-handed helix: phi in [40, 100], psi in [20, 80]
    if phi >= 40.0 && phi <= 100.0 && psi >= 20.0 && psi <= 80.0 {
        return RamaConformationType {
            region_name: "Left-Handed Alpha",
            is_core_allowed: true,
            is_generously_allowed: false,
            is_disallowed: false
        };
    }

    // Generously allowed boundary zones
    if phi >= -180.0 && phi <= 0.0 {
        return RamaConformationType {
            region_name: "Allowed Outer Region",
            is_core_allowed: false,
            is_generously_allowed: true,
            is_disallowed: false
        };
    }

    // Disallowed / forbidden region
    return RamaConformationType {
        region_name: "Disallowed Steric Clash",
        is_core_allowed: false,
        is_generously_allowed: false,
        is_disallowed: true
    };
}

pub fn rama_calc_energy(phi: Float, psi: Float, temp_k: Float) -> RamaEnergyResult {
    let conf = rama_classify_conformation(phi, psi);
    let k_b: Float = 0.001987204;
    let kt = k_b * temp_k;

    let e_stat = if (conf).is_core_allowed {
        0.0
    } else if (conf).is_generously_allowed {
        1.5 * kt * 2.0
    } else {
        8.0 * kt * 2.0 // Strong steric clash penalty
    };

    return RamaEnergyResult {
        statistical_energy_kcal: e_stat,
        conformation: conf
    };
}
