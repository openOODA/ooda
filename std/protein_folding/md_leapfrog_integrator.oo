// # Molecular Dynamics Leapfrog Verlet Time Integrator
//
// Logline: Implements the leapfrog integration algorithm computing half-step velocities and synchronized full-step energies.
//
// Setup: Numerical ODE solver advancing atomic trajectories with staggered time meshes.
//
// Beats:
//   1. Define LeapfrogParticle and LeapfrogState data structures.
//   2. Advance velocities by half time-step dt/2 and positions by full time-step dt.
//   3. Synchronize on-step velocities for accurate kinetic temperature estimation.

pub type LeapfrogParticle = struct {
    id: Int,
    mass_amu: Float,
    pos_x: Float,
    pos_y: Float,
    pos_z: Float,
    vel_x: Float,
    vel_y: Float,
    vel_z: Float,
    force_x: Float,
    force_y: Float,
    force_z: Float
};

pub type LeapfrogState = struct {
    step_number: Int,
    time_ps: Float,
    dt_ps: Float,
    num_particles: Int
};

pub fn leapfrog_advance_vel_half(p: &LeapfrogParticle, dt_ps: Float) -> LeapfrogParticle {
    let inv_m = if (p).mass_amu > 0.001 { 1.0 / (p).mass_amu } else { 1.0 };
    let half_dt = 0.5 * dt_ps;

    let nvx = (p).vel_x + ((p).force_x * inv_m * half_dt);
    let nvy = (p).vel_y + ((p).force_y * inv_m * half_dt);
    let nvz = (p).vel_z + ((p).force_z * inv_m * half_dt);

    return LeapfrogParticle {
        id: (p).id,
        mass_amu: (p).mass_amu,
        pos_x: (p).pos_x,
        pos_y: (p).pos_y,
        pos_z: (p).pos_z,
        vel_x: nvx,
        vel_y: nvy,
        vel_z: nvz,
        force_x: (p).force_x,
        force_y: (p).force_y,
        force_z: (p).force_z
    };
}

pub fn leapfrog_advance_pos_full(p: &LeapfrogParticle, dt_ps: Float) -> LeapfrogParticle {
    // r(t + dt) = r(t) + v(t + dt/2) * dt
    let npx = (p).pos_x + ((p).vel_x * dt_ps);
    let npy = (p).pos_y + ((p).vel_y * dt_ps);
    let npz = (p).pos_z + ((p).vel_z * dt_ps);

    return LeapfrogParticle {
        id: (p).id,
        mass_amu: (p).mass_amu,
        pos_x: npx,
        pos_y: npy,
        pos_z: npz,
        vel_x: (p).vel_x,
        vel_y: (p).vel_y,
        vel_z: (p).vel_z,
        force_x: (p).force_x,
        force_y: (p).force_y,
        force_z: (p).force_z
    };
}

pub fn leapfrog_sync_velocity(v_minus_half: Float, v_plus_half: Float) -> Float {
    // v(t) = 0.5 * [v(t - dt/2) + v(t + dt/2)]
    return 0.5 * (v_minus_half + v_plus_half);
}

pub fn leapfrog_calc_kinetic_energy(particles: List[LeapfrogParticle]) -> Float {
    let n = list_len(particles);
    let mut total_ke: Float = 0.0;
    let mut i = 0;
    while i < n {
        let p = list_get(particles, i);
        let v2 = ((p).vel_x * (p).vel_x) + ((p).vel_y * (p).vel_y) + ((p).vel_z * (p).vel_z);
        total_ke = total_ke + (0.5 * (p).mass_amu * v2 * 0.00239006);
        i = i + 1;
    }
    return total_ke;
}
