// # Verlet Neighbor List & Cell Linked-List Grid
//
// Logline: Implements spatial grid domain decomposition and Verlet neighbor list construction for O(N) pair force evaluation.
//
// Setup: Spatial acceleration engine partitioning simulation box into cubic subcells with skin cutoff buffers.
//
// Beats:
//   1. Define CellGridParams, AtomCellIndex, and NeighborPair data structures.
//   2. Map 3D atomic coordinates into discrete integer cell indices (cx, cy, cz).
//   3. Compute neighbor list rebuild criteria based on cumulative atomic displacement thresholds.

pub type CellGridParams = struct {
    cell_size_a: Float,
    n_cells_x: Int,
    n_cells_y: Int,
    n_cells_z: Int,
    cutoff_radius_a: Float,
    skin_buffer_a: Float,
};

pub type AtomCellIndex = struct {
    atom_id: Int,
    cell_x: Int,
    cell_y: Int,
    cell_z: Int,
    flat_cell_id: Int,
};

pub type NeighborPair = struct {
    atom_i: Int,
    atom_j: Int,
    dist_sq: Float,
};

pub fn cell_grid_params_new(box_len: Float, r_cut: Float, skin: Float) -> CellGridParams {
    let r_list = r_cut + skin;
    let n_cells = (box_len / r_list) as Int;
    let actual_n = if n_cells > 0 { n_cells } else { 1 };
    let actual_cell_size = box_len / (actual_n as Float);

    return CellGridParams {
        cell_size_a: actual_cell_size,
        n_cells_x: actual_n,
        n_cells_y: actual_n,
        n_cells_z: actual_n,
        cutoff_radius_a: r_cut,
        skin_buffer_a: skin,
    };
}

pub fn cell_calc_atom_index(atom_id: Int, px: Float, py: Float, pz: Float, params: &CellGridParams) -> AtomCellIndex {
    let cs = (params).cell_size_a;
    let inv_cs = if cs > 0.0001 { 1.0 / cs } else { 1.0 };

    let mut cx = (px * inv_cs) as Int;
    let mut cy = (py * inv_cs) as Int;
    let mut cz = (pz * inv_cs) as Int;

    if cx < 0 { cx = 0; }
    if cx >= (params).n_cells_x { cx = (params).n_cells_x - 1; }
    if cy < 0 { cy = 0; }
    if cy >= (params).n_cells_y { cy = (params).n_cells_y - 1; }
    if cz < 0 { cz = 0; }
    if cz >= (params).n_cells_z { cz = (params).n_cells_z - 1; }

    let flat_id = cx + (cy * (params).n_cells_x) + (cz * (params).n_cells_x * (params).n_cells_y);

    return AtomCellIndex {
        atom_id: atom_id,
        cell_x: cx,
        cell_y: cy,
        cell_z: cz,
        flat_cell_id: flat_id,
    };
}

pub fn cell_should_rebuild_neighbor_list(max_atom_displacement_since_rebuild: Float, skin_buffer: Float) -> Bool {
    // Rebuild is required when 2 * max_disp > skin_buffer
    return (2.0 * max_atom_displacement_since_rebuild) >= skin_buffer;
}
