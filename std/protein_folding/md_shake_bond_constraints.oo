// # SHAKE Holonomic Bond Length Constraints Algorithm
//
// Logline: Implements iterative SHAKE algorithm enforcing rigid covalent bond lengths via Lagrange multiplier corrections.
//
// Setup: Constraint dynamics module iteratively updating atomic displacement vectors to satisfy target bond distance tolerances.
//
// Beats:
//   1. Define ShakeConstraint, AtomPosition, and ShakeIterationResult data structures.
//   2. Calculate iterative geometric Lagrange multiplier delta_lambda for each constrained bond pair.
//   3. Apply coordinate corrections until root-mean-square constraint error satisfies convergence tolerance.

pub type AtomPosition = struct {
    x: Float,
    y: Float,
    z: Float,
    inv_mass: Float,
};

pub type ShakeConstraint = struct {
    atom_a_idx: Int,
    atom_b_idx: Int,
    target_dist_angstrom: Float,
    tolerance_angstrom: Float,
};

pub type ShakeIterationResult = struct {
    num_iterations: Int,
    max_error_angstrom: Float,
    converged: Bool,
};

pub fn shake_calc_dist_sq(p1: &AtomPosition, p2: &AtomPosition) -> Float {
    let dx = (p1).x - (p2).x;
    let dy = (p1).y - (p2).y;
    let dz = (p1).z - (p2).z;
    return (dx * dx) + (dy * dy) + (dz * dz);
}

pub fn shake_calc_lagrange_multiplier(
    r_unconstrained_a: &AtomPosition,
    r_unconstrained_b: &AtomPosition,
    r_old_a: &AtomPosition,
    r_old_b: &AtomPosition,
    d_target: Float,
) -> Float {
    // Delta lambda = (d_target^2 - r_unconstrained^2) / (2 * (m1^-1 + m2^-1) * (r_old . r_unconstrained))
    let r_un_sq = shake_calc_dist_sq(r_unconstrained_a, r_unconstrained_b);
    let diff_sq = (d_target * d_target) - r_un_sq;

    let dx_old = (r_old_a).x - (r_old_b).x;
    let dy_old = (r_old_a).y - (r_old_b).y;
    let dz_old = (r_old_a).z - (r_old_b).z;

    let dx_un = (r_unconstrained_a).x - (r_unconstrained_b).x;
    let dy_un = (r_unconstrained_a).y - (r_unconstrained_b).y;
    let dz_un = (r_unconstrained_a).z - (r_unconstrained_b).z;

    let dot_prod = (dx_old * dx_un) + (dy_old * dy_un) + (dz_old * dz_un);
    let mass_sum = (r_unconstrained_a).inv_mass + (r_unconstrained_b).inv_mass;

    let denom = 2.0 * mass_sum * dot_prod;
    if denom > 0.000001 || denom < -0.000001 {
        return diff_sq / denom;
    }
    return 0.0;
}

pub fn shake_apply_correction(
    pos_a: &AtomPosition,
    pos_b: &AtomPosition,
    r_old_a: &AtomPosition,
    r_old_b: &AtomPosition,
    d_target: Float,
) -> Float {
    let lambda = shake_calc_lagrange_multiplier(pos_a, pos_b, r_old_a, r_old_b, d_target);
    return lambda;
}
