// # Transition Path Theory & Folding Committor Probability
//
// Logline: Calculates transition path theory (TPT) forward committor probabilities, reactive flux, and folding bottleneck states.
//
// Setup: Statistical physics module finding transition states (q = 0.5) and reactive pathway fluxes between unfolded and native basins.
//
// Beats:
//   1. Define CommittorState, ReactiveFluxEdge, and TransitionStateResult data structures.
//   2. Calculate forward committor probability q+(x) satisfying discrete Dirichlet boundary conditions.
//   3. Compute net reactive flux J_ij = max(0, pi_i * q-_i * T_ij * q+_j - pi_j * q-_j * T_ji * q+_i).

pub type CommittorState = struct {
    microstate_id: Int,
    forward_committor_q_plus: Float, // 0 in Unfolded basin, 1 in Folded basin
    backward_committor_q_minus: Float,
    is_transition_state: Bool
};

pub type ReactiveFluxEdge = struct {
    from_state: Int,
    to_state: Int,
    net_flux: Float,
    is_bottleneck: Bool
};

pub type TransitionStateResult = struct {
    identified_ts_microstates_count: Int,
    total_folding_flux: Float,
    rate_constant_k_fold: Float
};

pub fn tpt_calc_backward_committor(q_plus: Float) -> Float {
    // q-_i = 1 - q+_i under microscopic reversibility
    let qm = 1.0 - q_plus;
    if qm < 0.0 { return 0.0; }
    if qm > 1.0 { return 1.0; }
    return qm;
}

pub fn tpt_is_transition_state(q_plus: Float, tolerance: Float) -> Bool {
    // Transition state ensemble defined by q+_i ~ 0.5
    let diff = q_plus - 0.5;
    let abs_diff = if diff < 0.0 { -1.0 * diff } else { diff };
    return abs_diff <= tolerance;
}

pub fn tpt_calc_reactive_flux_pair(
    pi_i: Float,
    q_minus_i: Float,
    t_ij: Float,
    q_plus_j: Float,
    pi_j: Float,
    q_minus_j: Float,
    t_ji: Float,
    q_plus_i: Float,
) -> ReactiveFluxEdge {
    let f_forward = pi_i * q_minus_i * t_ij * q_plus_j;
    let f_backward = pi_j * q_minus_j * t_ji * q_plus_i;
    let net = f_forward - f_backward;
    let actual_flux = if net > 0.0 { net } else { 0.0 };

    return ReactiveFluxEdge {
        from_state: 1,
        to_state: 2,
        net_flux: actual_flux,
        is_bottleneck: actual_flux > 0.01
    };
}
