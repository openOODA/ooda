// # Energy Landscape Funnel Theory & Frustration Index
//
// Logline: Calculates folding funnel slope metrics, native contact fraction Q, and local frustration indices.
//
// Setup: Statistical physics of protein folding module characterizing minimally frustrated rugged funnel topologies.
//
// Beats:
//   1. Define NativeContactPair, FunnelMetrics, and FrustrationScore data structures.
//   2. Compute smooth fraction of native contacts Q(X) using sigmoid distance switching functions.
//   3. Evaluate local mutational and configurational frustration index F = (E_native - <E_decoy>) / sigma_decoy.

pub type NativeContactPair = struct {
    residue_i: Int,
    residue_j: Int,
    native_dist_a: Float,
    current_dist_a: Float
};

pub type FrustrationScore = struct {
    contact_i: Int,
    contact_j: Int,
    frustration_index: Float,
    is_minimally_frustrated: Bool,
    is_highly_frustrated: Bool
};

pub type FunnelMetrics = struct {
    native_contact_fraction_q: Float,
    total_native_contacts: Int,
    formed_contacts_count: Int,
    folding_roughness_kcal: Float
};

pub fn funnel_calc_q_pair(current_dist: Float, native_dist: Float, beta_switch: Float, lambda_factor: Float) -> Float {
    // Sigmoidal contact score: q_ij = 1 / (1 + exp(beta * (r_ij - lambda * r_ij^0)))
    let r_ref = lambda_factor * native_dist;
    let diff = current_dist - r_ref;
    let exponent = beta_switch * diff;

    if exponent > 20.0 { return 0.0; }
    if exponent < -20.0 { return 1.0; }

    // exp(exponent) approximation
    let exp_term = if exponent >= 0.0 {
        1.0 + exponent + (0.5 * exponent * exponent)
    } else {
        let neg = -1.0 * exponent;
        1.0 / (1.0 + neg + (0.5 * neg * neg))
    };

    return 1.0 / (1.0 + exp_term);
}

pub fn funnel_calc_frustration_index(e_native: Float, mean_e_decoy: Float, std_e_decoy: Float) -> FrustrationScore {
    // Frustration index: F = (mean_decoy - e_native) / sigma_decoy
    let num = mean_e_decoy - e_native;
    let denom = if std_e_decoy > 0.0001 { std_e_decoy } else { 1.0 };
    let f_val = num / denom;

    let is_min = f_val >= 1.0; // F >= 1 is minimally frustrated (native state favored)
    let is_high = f_val <= -1.0; // F <= -1 is highly frustrated

    return FrustrationScore {
        contact_i: 1,
        contact_j: 2,
        frustration_index: f_val,
        is_minimally_frustrated: is_min,
        is_highly_frustrated: is_high
    };
}
