// # TM-Score Sequence-Length Independent Structural Similarity
//
// Logline: Calculates the TM-score (Template Modeling score) for protein structural homology assessment independent of protein size.
//
// Setup: Structural bioinformatics scoring metric solving d_0(L_target) scaling to eliminate length-dependent bias of RMSD.
//
// Beats:
//   1. Define TmScoreParams and TmScoreResult data structures.
//   2. Calculate length-dependent scale factor d_0 = 1.24 * (L_target - 15)^(1/3) - 1.8.
//   3. Compute TM-score = (1 / L_target) * sum_i [1 / (1 + (d_i / d_0)^2)] and assess fold classification (>0.5 same fold).

pub type TmScoreParams = struct {
    target_length: Int,
    aligned_length: Int,
    d0_scale_a: Float,
};

pub type TmScoreResult = struct {
    tm_score_0_to_1: Float,
    target_length: Int,
    d0_scale_a: Float,
    has_same_global_fold: Bool, // TM-score > 0.5 indicates same fold
    is_random_structural_pair: Bool, // TM-score < 0.17
};

pub fn tm_calc_d0_scale(target_length: Int) -> Float {
    if target_length <= 15 {
        return 0.5;
    }
    let l_f = (target_length as Float);
    let l_minus_15 = l_f - 15.0;

    // Cube root approximation for l_minus_15^(1/3)
    let mut guess = 3.0;
    let mut iter = 0;
    while iter < 8 {
        guess = (2.0 * guess + (l_minus_15 / (guess * guess))) / 3.0;
        iter = iter + 1;
    }

    // d_0 = 1.24 * (L - 15)^(1/3) - 1.8
    let d0 = (1.24 * guess) - 1.8;
    return if d0 < 0.5 { 0.5 } else { d0 };
}

pub fn tm_evaluate_score(distances_a: List[Float], target_length: Int) -> TmScoreResult {
    let d0 = tm_calc_d0_scale(target_length);
    let d0_sq = d0 * d0;
    let n = list_len(distances_a);

    let mut sum_terms: Float = 0.0;
    let mut i = 0;
    while i < n {
        let di = list_get(distances_a, i);
        let di_sq = di * di;
        let term = 1.0 / (1.0 + (di_sq / d0_sq));
        sum_terms = sum_terms + term;
        i = i + 1;
    }

    let lt_f = if target_length > 0 { (target_length as Float) } else { 1.0 };
    let tm_val = sum_terms / lt_f;

    return TmScoreResult {
        tm_score_0_to_1: tm_val,
        target_length: target_length,
        d0_scale_a: d0,
        has_same_global_fold: tm_val >= 0.50,
        is_random_structural_pair: tm_val < 0.17,
    };
}
