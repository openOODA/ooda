// # Periodic Boundary Conditions & Minimum Image Convention
//
// Logline: Implements 3D periodic boundary conditions (PBC) and minimum image displacement wrapping for cubic and triclinic simulation cells.
//
// Setup: Spatial boundary module wrapping atomic coordinates into primary simulation unit cell.
//
// Beats:
//   1. Define SimulationBox3D, Point3D, and PbcDisplacementResult data structures.
//   2. Wrap coordinates into central unit cell [-L/2, L/2] or [0, L].
//   3. Calculate minimum image pairwise distance vectors and scalar distances.

pub type SimulationBox3D = struct {
    lx: Float,
    ly: Float,
    lz: Float,
    inv_lx: Float,
    inv_ly: Float,
    inv_lz: Float
};

pub type Point3D = struct {
    x: Float,
    y: Float,
    z: Float
};

pub type PbcDisplacementResult = struct {
    dx: Float,
    dy: Float,
    dz: Float,
    dist_sq: Float,
    dist: Float
};

pub fn pbc_sqrt(val: Float) -> Float {
    if val <= 0.0 { return 0.0; }
    let mut guess = val / 2.0;
    if guess < 0.1 { guess = 0.1; }
    let mut iter = 0;
    while iter < 10 {
        guess = 0.5 * (guess + (val / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn pbc_box_new(lx: Float, ly: Float, lz: Float) -> SimulationBox3D {
    return SimulationBox3D {
        lx: lx,
        ly: ly,
        lz: lz,
        inv_lx: if lx > 0.0001 { 1.0 / lx } else { 0.0 },
        inv_ly: if ly > 0.0001 { 1.0 / ly } else { 0.0 },
        inv_lz: if lz > 0.0001 { 1.0 / lz } else { 0.0 }
    };
}

pub fn pbc_wrap_coordinate(coord: Float, box_len: Float) -> Float {
    if box_len <= 0.0001 { return coord; }
    let mut c = coord;
    while c >= box_len { c = c - box_len; }
    while c < 0.0 { c = c + box_len; }
    return c;
}

pub fn pbc_wrap_point(pt: &Point3D, box: &SimulationBox3D) -> Point3D {
    return Point3D {
        x: pbc_wrap_coordinate((pt).x, (box).lx),
        y: pbc_wrap_coordinate((pt).y, (box).ly),
        z: pbc_wrap_coordinate((pt).z, (box).lz)
    };
}

pub fn pbc_minimum_image_disp(p1: &Point3D, p2: &Point3D, box: &SimulationBox3D) -> PbcDisplacementResult {
    let mut dx = (p1).x - (p2).x;
    let mut dy = (p1).y - (p2).y;
    let mut dz = (p1).z - (p2).z;

    // Minimum image convention
    if (box).lx > 0.0001 {
        let half_lx = 0.5 * (box).lx;
        while dx > half_lx { dx = dx - (box).lx; }
        while dx < -half_lx { dx = dx + (box).lx; }
    }

    if (box).ly > 0.0001 {
        let half_ly = 0.5 * (box).ly;
        while dy > half_ly { dy = dy - (box).ly; }
        while dy < -half_ly { dy = dy + (box).ly; }
    }

    if (box).lz > 0.0001 {
        let half_lz = 0.5 * (box).lz;
        while dz > half_lz { dz = dz - (box).lz; }
        while dz < -half_lz { dz = dz + (box).lz; }
    }

    let d2 = (dx * dx) + (dy * dy) + (dz * dz);
    let d = pbc_sqrt(d2);

    return PbcDisplacementResult {
        dx: dx,
        dy: dy,
        dz: dz,
        dist_sq: d2,
        dist: d
    };
}
