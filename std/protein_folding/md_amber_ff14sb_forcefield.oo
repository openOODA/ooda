// # Amber FF14SB All-Atom Protein Force Field
//
// Logline: Implements the Amber ff14SB parameterization for bonded and non-bonded molecular mechanical potentials.
//
// Setup: Molecular mechanics potential energy function computing bond, angle, dihedral, and 1-4 electrostatic scaling.
//
// Beats:
//   1. Define AmberBond, AmberAngle, AmberDihedral, and Amber14Pair data structures.
//   2. Calculate harmonic bond stretching and harmonic angle bending potentials.
//   3. Compute cosine series dihedral torsional energy and 1-4 electrostatic / LJ scaling factors.

pub type AmberBond = struct {
    atom_i: Int,
    atom_j: Int,
    k_bond: Float,  // kcal/(mol * A^2)
    r_eq: Float    // Angstroms
};

pub type AmberAngle = struct {
    atom_i: Int,
    atom_j: Int,
    atom_k: Int,
    k_theta: Float, // kcal/(mol * rad^2)
    theta_eq_rad: Float
};

pub type AmberDihedral = struct {
    atom_i: Int,
    atom_j: Int,
    atom_k: Int,
    atom_l: Int,
    periodicity: Int,
    barrier_height_vn: Float, // kcal/mol
    phase_rad: Float
};

pub type Amber14ScaleFactors = struct {
    scee_coulomb: Float, // Typically 1.2 (scale = 1/1.2 = 0.8333)
    scnb_lj: Float      // Typically 2.0 (scale = 1/2.0 = 0.5)
};

pub fn amber_bond_energy(bond: &AmberBond, dist_angstrom: Float) -> Float {
    // E_bond = k_b * (r - r_0)^2
    let dr = dist_angstrom - (bond).r_eq;
    return (bond).k_bond * dr * dr;
}

pub fn amber_angle_energy(angle: &AmberAngle, current_theta_rad: Float) -> Float {
    // E_angle = k_theta * (theta - theta_0)^2
    let dtheta = current_theta_rad - (angle).theta_eq_rad;
    return (angle).k_theta * dtheta * dtheta;
}

pub fn amber_dihedral_energy(dihed: &AmberDihedral, phi_rad: Float) -> Float {
    // E_torsion = (V_n / 2) * [1 + cos(n * phi - gamma)]
    let n_f = (dihed).periodicity as Float;
    let angle = (n_f * phi_rad) - (dihed).phase_rad;

    // Fast cosine approximation for angle
    // cos(x) ~ 1 - x^2/2 + x^4/24 within [-pi, pi]
    let mut a = angle;
    while a > 3.14159265 { a = a - 6.2831853; }
    while a < -3.14159265 { a = a + 6.2831853; }
    let a2 = a * a;
    let cos_val = 1.0 - (a2 * 0.5) + (a2 * a2 * 0.041666667);

    return 0.5 * (dihed).barrier_height_vn * (1.0 + cos_val);
}

pub fn amber_ff14sb_scale_factors() -> Amber14ScaleFactors {
    return Amber14ScaleFactors {
        scee_coulomb: 1.2,
        scnb_lj: 2.0
    };
}
