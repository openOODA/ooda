// # AlphaFold MSA Row & Column Axial Self-Attention
//
// Logline: Implements axial gated self-attention along MSA sequence rows and alignment columns with pairwise feature biases.
//
// Setup: Evoformer sequence co-evolution processing module updating Multiple Sequence Alignment (MSA) representations.
//
// Beats:
//   1. Define MsaAxialConfig, MsaAttentionHead, and MsaLayerResult data structures.
//   2. Compute row-wise self-attention across residue positions biased by 2D pair representations z_ij.
//   3. Compute column-wise self-attention across homologous sequence depths with gating factors.

pub type MsaAxialConfig = struct {
    num_sequences_s: Int,
    num_residues_n: Int,
    num_heads: Int,
    key_dim_c: Int
};

pub type MsaAttentionHead = struct {
    head_index: Int,
    query_scalar: Float,
    key_scalar: Float,
    pair_bias_z: Float,
    gate_val: Float
};

pub type MsaLayerResult = struct {
    attention_weight: Float,
    gated_output: Float,
    is_row_attention: Bool
};

pub fn af_msa_sigmoid(x: Float) -> Float {
    if x > 15.0 { return 1.0; }
    if x < -15.0 { return 0.0; }
    let exp_term = if x >= 0.0 {
        let neg = -1.0 * x;
        1.0 / (1.0 - neg + (0.5 * neg * neg))
    } else {
        1.0 + (-1.0 * x) + (0.5 * x * x)
    };
    return 1.0 / (1.0 + exp_term);
}

pub fn af_msa_row_attention_logit(head: &MsaAttentionHead, inv_sqrt_d: Float) -> Float {
    // a_ij = (q_i * k_j) / sqrt(d) + z_ij
    let dot = (head).query_scalar * (head).key_scalar * inv_sqrt_d;
    return dot + (head).pair_bias_z;
}

pub fn af_msa_column_attention_logit(head: &MsaAttentionHead, inv_sqrt_d: Float) -> Float {
    // Column attention across sequences (without pair bias)
    let dot = (head).query_scalar * (head).key_scalar * inv_sqrt_d;
    return dot;
}

pub fn af_msa_gated_output(head: &MsaAttentionHead, attn_weight: Float, value_v: Float) -> MsaLayerResult {
    let gate = af_msa_sigmoid((head).gate_val);
    let output = gate * attn_weight * value_v;

    return MsaLayerResult {
        attention_weight: attn_weight,
        gated_output: output,
        is_row_attention: true
    };
}
