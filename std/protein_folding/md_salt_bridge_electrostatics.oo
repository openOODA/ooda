// # Salt Bridge Electrostatic Ion-Pair Energy
//
// Logline: Calculates ionic salt bridge interactions between cationic (Arg/Lys/His) and anionic (Asp/Glu) sidechains with dielectric screening.
//
// Setup: Biophysical electrostatics module scoring geometry, distance cutoffs, and bifurcation of oppositely charged sidechain ion pairs.
//
// Beats:
//   1. Define SaltBridgePair and SaltBridgeScore data structures.
//   2. Evaluate distance-dependent screened Coulomb attraction between charged nitrogen and oxygen centers.
//   3. Classify salt bridges into direct contact (<= 4.0 A), water-mediated, or long-range ion pairs.

pub type SaltBridgePair = struct {
    cation_residue_idx: Int,
    cation_type: String, // "ARG", "LYS", "HIS"
    anion_residue_idx: Int,
    anion_type: String,  // "ASP", "GLU"
    min_ion_distance_a: Float
};

pub type SaltBridgeScore = struct {
    electrostatic_energy_kcal: Float,
    is_direct_salt_bridge: Bool,
    is_water_mediated: Bool,
    quality_category: String
};

pub fn salt_bridge_screened_coulomb(dist_a: Float, eps_eff: Float) -> Float {
    if dist_a < 0.1 { return 0.0; }
    // Salt bridge between +1e and -1e
    let f_coulomb: Float = 332.0637;
    let eps = if eps_eff > 1.0 { eps_eff } else { 4.0 }; // Effective local dielectric ~4-10
    // E = - (332.0637) / (eps * r)
    return -1.0 * f_coulomb / (eps * dist_a);
}

pub fn salt_bridge_classify_pair(pair: &SaltBridgePair, local_dielectric: Float) -> SaltBridgeScore {
    let d = (pair).min_ion_distance_a;
    let energy = salt_bridge_screened_coulomb(d, local_dielectric);

    if d <= 4.0 {
        return SaltBridgeScore {
            electrostatic_energy_kcal: energy,
            is_direct_salt_bridge: true,
            is_water_mediated: false,
            quality_category: "Direct Strong Ion Pair"
        };
    } else if d <= 6.0 {
        return SaltBridgeScore {
            electrostatic_energy_kcal: energy * 0.5,
            is_direct_salt_bridge: false,
            is_water_mediated: true,
            quality_category: "Water-Mediated Ion Pair"
        };
    } else {
        return SaltBridgeScore {
            electrostatic_energy_kcal: energy * 0.1,
            is_direct_salt_bridge: false,
            is_water_mediated: false,
            quality_category: "Long-Range Electrostatic"
        };
    }
}
