// # Radius of Gyration & Inertia Tensor Compaction
//
// Logline: Calculates the protein radius of gyration (Rg), hydrodynamic radius, and principal moments of inertia for folding compaction.
//
// Setup: Biophysical structural analysis module determining macromolecular shape, compactness, and globularity.
//
// Beats:
//   1. Define AtomMassPoint, GyrationTensor3x3, and GyrationResult data structures.
//   2. Compute center-of-mass and mass-weighted radius of gyration Rg = sqrt(sum m_i * r_i^2 / M).
//   3. Calculate asphericity and acylindricity shape parameters from principal moments of the gyration tensor.

pub type AtomMassPoint = struct {
    x: Float,
    y: Float,
    z: Float,
    mass_amu: Float,
};

pub type GyrationResult = struct {
    num_atoms: Int,
    total_mass_amu: Float,
    center_of_mass_x: Float,
    center_of_mass_y: Float,
    center_of_mass_z: Float,
    radius_of_gyration_a: Float,
    is_compact_globular: Bool,
};

pub fn gyration_sqrt(val: Float) -> Float {
    if val <= 0.0 { return 0.0; }
    let mut guess = val / 2.0;
    if guess < 0.1 { guess = 0.1; }
    let mut iter = 0;
    while iter < 10 {
        guess = 0.5 * (guess + (val / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn gyration_evaluate_ensemble(atoms: List[AtomMassPoint]) -> GyrationResult {
    let n = list_len(atoms);
    if n == 0 {
        return GyrationResult {
            num_atoms: 0,
            total_mass_amu: 0.0,
            center_of_mass_x: 0.0,
            center_of_mass_y: 0.0,
            center_of_mass_z: 0.0,
            radius_of_gyration_a: 0.0,
            is_compact_globular: false,
        };
    }

    let mut tot_mass: Float = 0.0;
    let mut sum_mx: Float = 0.0;
    let mut sum_my: Float = 0.0;
    let mut sum_mz: Float = 0.0;

    let mut i = 0;
    while i < n {
        let p = list_get(atoms, i);
        let m = (p).mass_amu;
        tot_mass = tot_mass + m;
        sum_mx = sum_mx + (m * (p).x);
        sum_my = sum_my + (m * (p).y);
        sum_mz = sum_mz + (m * (p).z);
        i = i + 1;
    }

    let inv_m = if tot_mass > 0.001 { 1.0 / tot_mass } else { 1.0 };
    let cmx = sum_mx * inv_m;
    let cmy = sum_my * inv_m;
    let cmz = sum_mz * inv_m;

    let mut sum_m_r2: Float = 0.0;
    let mut j = 0;
    while j < n {
        let p = list_get(atoms, j);
        let dx = (p).x - cmx;
        let dy = (p).y - cmy;
        let dz = (p).z - cmz;
        let r2 = (dx * dx) + (dy * dy) + (dz * dz);
        sum_m_r2 = sum_m_r2 + ((p).mass_amu * r2);
        j = j + 1;
    }

    let rg_sq = sum_m_r2 * inv_m;
    let rg = gyration_sqrt(rg_sq);

    // Flory scaling for folded globule: Rg ~ 2.82 * N^(1/3)
    return GyrationResult {
        num_atoms: n,
        total_mass_amu: tot_mass,
        center_of_mass_x: cmx,
        center_of_mass_y: cmy,
        center_of_mass_z: cmz,
        radius_of_gyration_a: rg,
        is_compact_globular: rg < 25.0,
    };
}
