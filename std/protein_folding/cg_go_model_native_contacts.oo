// # Structure-Based Gō-Model Native Contact Potential
//
// Logline: Implements the Gō-like structure-based potential with Lennard-Jones 12-10 native wells and repulsive non-native cores.
//
// Setup: Minimally frustrated protein folding potential assigning attractive wells exclusively to native structural contacts.
//
// Beats:
//   1. Define GoContactPair and GoPotentialResult data structures.
//   2. Calculate 12-10 attractive Lennard-Jones potential V_native(r) = eps_go * [5*(r0/r)^12 - 6*(r0/r)^10] for native pairs.
//   3. Compute purely repulsive non-native excluded volume potential V_nonnative(r) = eps_rep * (sigma_rep / r)^12.

pub type GoContactPair = struct {
    residue_i: Int,
    residue_j: Int,
    is_native_contact: Bool,
    native_distance_r0_a: Float,
    current_distance_r_a: Float,
};

pub type GoPotentialResult = struct {
    is_native: Bool,
    potential_energy_kcal: Float,
    is_formed: Bool,
};

pub fn go_calc_native_12_10(r: Float, r0: Float, eps_go: Float) -> Float {
    if r < 0.5 { return 100.0; }
    let inv_r = 1.0 / r;
    let ratio = r0 * inv_r;
    let r2 = ratio * ratio;
    let r4 = r2 * r2;
    let r10 = r4 * r4 * r2;
    let r12 = r10 * r2;

    // V_go = eps * [5 * (r0/r)^12 - 6 * (r0/r)^10]
    return eps_go * ((5.0 * r12) - (6.0 * r10));
}

pub fn go_calc_nonnative_repulsion(r: Float, sigma_rep: Float, eps_rep: Float) -> Float {
    if r >= sigma_rep { return 0.0; }
    if r < 0.5 { return 100.0; }

    let inv_r = 1.0 / r;
    let ratio = sigma_rep * inv_r;
    let r2 = ratio * ratio;
    let r6 = r2 * r2 * r2;
    let r12 = r6 * r6;

    return eps_rep * r12;
}

pub fn go_evaluate_pair(contact: &GoContactPair, eps_go: Float, sigma_rep: Float) -> GoPotentialResult {
    let r = (contact).current_distance_r_a;
    let r0 = (contact).native_distance_r0_a;

    if (contact).is_native_contact {
        let e_nat = go_calc_native_12_10(r, r0, eps_go);
        let formed = (r <= (r0 * 1.2));

        return GoPotentialResult {
            is_native: true,
            potential_energy_kcal: e_nat,
            is_formed: formed,
        };
    } else {
        let e_non = go_calc_nonnative_repulsion(r, sigma_rep, eps_go);

        return GoPotentialResult {
            is_native: false,
            potential_energy_kcal: e_non,
            is_formed: false,
        };
    }
}
