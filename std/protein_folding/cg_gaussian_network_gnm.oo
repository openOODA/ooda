// # Gaussian Network Model (GNM) Kirchhoff Matrix & B-Factors
//
// Logline: Calculates the NxN Kirchhoff topological connectivity matrix, residue cross-correlations, and isotropic B-factors.
//
// Setup: Isotropic elastic network model computing thermal fluctuations from graph Laplacian spectral decomposition.
//
// Beats:
//   1. Define GnmParams, KirchhoffElement, and GnmBfactorResult data structures.
//   2. Populate Kirchhoff adjacency matrix Gamma_ij = -1 (i != j) and Gamma_ii = degree(i) for distances <= R_cut.
//   3. Compute theoretical crystallographic B-factors B_i = (8 * pi^2 * k_B * T / gamma) * [Gamma^-1]_ii.

pub type GnmParams = struct {
    num_residues: Int,
    cutoff_radius_a: Float, // Typically 7.0 - 7.5 Angstroms for C-alpha
    spring_constant_gamma: Float,
    temperature_k: Float
};

pub type KirchhoffElement = struct {
    row_i: Int,
    col_j: Int,
    val: Float
};

pub type GnmBfactorResult = struct {
    residue_index: Int,
    diagonal_inverse_gamma: Float,
    predicted_bfactor: Float
};

pub fn gnm_params_default(n_res: Int) -> GnmParams {
    return GnmParams {
        num_residues: n_res,
        cutoff_radius_a: 7.3,
        spring_constant_gamma: 1.0,
        temperature_k: 300.0
    };
}

pub fn gnm_calc_kirchhoff_offdiag(dist_a: Float, cutoff_a: Float) -> Float {
    if dist_a <= cutoff_a && dist_a > 0.001 {
        return -1.0;
    }
    return 0.0;
}

pub fn gnm_calc_bfactor(diag_inv: Float, gamma: Float, temp_k: Float) -> Float {
    // B_i = (8 * pi^2 * k_B * T / (3 * gamma)) * [Gamma^-1]_ii
    let eight_pi_sq: Float = 78.956835;
    let k_b: Float = 0.001987204;
    let kt = k_b * temp_k;
    let g = if gamma > 0.0001 { gamma } else { 1.0 };

    let factor = (eight_pi_sq * kt) / (3.0 * g);
    return factor * diag_inv;
}

pub fn gnm_calc_cross_correlation(inv_gamma_ij: Float, inv_gamma_ii: Float, inv_gamma_jj: Float) -> Float {
    // C_ij = [Gamma^-1]_ij / sqrt([Gamma^-1]_ii * [Gamma^-1]_jj)
    let denom_sq = inv_gamma_ii * inv_gamma_jj;
    if denom_sq <= 0.0001 { return 0.0; }

    // Fast sqrt
    let mut guess = denom_sq / 2.0;
    if guess < 0.1 { guess = 0.1; }
    let mut iter = 0;
    while iter < 8 {
        guess = 0.5 * (guess + (denom_sq / guess));
        iter = iter + 1;
    }

    return inv_gamma_ij / guess;
}
