// # AlphaFold pLDDT Structural Confidence Metric
//
// Logline: Calculates per-residue predicted lDDT-Ca (pLDDT) confidence scores and classifies structural quality bands.
//
// Setup: AlphaFold model confidence evaluation module mapping 50-bin softmax distributions to expected 0-100 pLDDT values.
//
// Beats:
//   1. Define PlddtDistribution50, ResiduePlddtScore, and PlddtClassification data structures.
//   2. Calculate expected value E[lDDT] = sum_b (p_b * center_b) from 50 discrete error bins.
//   3. Classify residues into Very High (>90), Confident (70-90), Low (50-70), and Very Low (<50) confidence bands.

pub type ResiduePlddtScore = struct {
    residue_index: Int,
    plddt_score_0_to_100: Float,
    confidence_band: String,
    is_well_folded_core: Bool,
    is_intrinsically_disordered: Bool
};

pub type PlddtSummaryMetrics = struct {
    mean_plddt: Float,
    num_very_high_residues: Int,
    num_disordered_residues: Int,
    overall_quality_passed: Bool
};

pub fn af_classify_plddt(score: Float) -> String {
    if score >= 90.0 {
        return "Very High Confidence (>90)";
    } else if score >= 70.0 {
        return "Confident (70-90)";
    } else if score >= 50.0 {
        return "Low Confidence (50-70)";
    } else {
        return "Very Low / Disordered (<50)";
    }
}

pub fn af_evaluate_residue_plddt(res_idx: Int, plddt_val: Float) -> ResiduePlddtScore {
    let band = af_classify_plddt(plddt_val);
    let is_core = plddt_val >= 80.0;
    let is_idp = plddt_val < 50.0;

    return ResiduePlddtScore {
        residue_index: res_idx,
        plddt_score_0_to_100: plddt_val,
        confidence_band: band,
        is_well_folded_core: is_core,
        is_intrinsically_disordered: is_idp
    };
}

pub fn af_calc_expected_plddt_bin(bin_probs: List[Float], bin_centers: List[Float]) -> Float {
    let n = list_len(bin_probs);
    let mut sum_exp: Float = 0.0;
    let mut i = 0;
    while i < n {
        let p = list_get(bin_probs, i);
        let c = list_get(bin_centers, i);
        sum_exp = sum_exp + (p * c);
        i = i + 1;
    }
    return sum_exp;
}
