// # Simulated Annealing Cooling Schedule for Global Optimization
//
// Logline: Implements exponential and linear thermal annealing schedules to escape local minima in protein energy landscapes.
//
// Setup: Global optimization heuristic dynamically lowering effective temperature over iterative folding cycles.
//
// Beats:
//   1. Define AnnealingSchedule, AnnealingState, and CoolingStepResult data structures.
//   2. Calculate exponential temperature decay T(step) = T_initial * alpha^step and linear decay.
//   3. Determine convergence status and ground-state conformational trapping criteria.

pub type AnnealingSchedule = struct {
    initial_temp_k: Float,
    final_temp_k: Float,
    total_steps: Int,
    cooling_type: String, // "EXPONENTIAL", "LINEAR", "LOGARITHMIC"
    cooling_rate_alpha: Float,
};

pub type AnnealingState = struct {
    current_step: Int,
    current_temp_k: Float,
    best_energy_kcal: Float,
    current_energy_kcal: Float,
};

pub type CoolingStepResult = struct {
    next_step: Int,
    next_temp_k: Float,
    is_annealing_finished: Bool,
    progress_fraction: Float,
};

pub fn annealing_schedule_default(t_init: Float, t_final: Float, steps: Int) -> AnnealingSchedule {
    let alpha: Float = 0.995;
    return AnnealingSchedule {
        initial_temp_k: t_init,
        final_temp_k: t_final,
        total_steps: steps,
        cooling_type: "EXPONENTIAL",
        cooling_rate_alpha: alpha,
    };
}

pub fn annealing_calc_exponential_temp(sched: &AnnealingSchedule, step: Int) -> Float {
    let t0 = (sched).initial_temp_k;
    let t_end = (sched).final_temp_k;
    let total = (sched).total_steps;

    if step >= total { return t_end; }
    if step <= 0 { return t0; }

    let frac = (step as Float) / (total as Float);
    // Linear interpolation of log(T) -> geometric cooling
    // T = T0 * (T_end / T0)^frac
    let ratio = if t0 > 0.001 { t_end / t0 } else { 0.01 };

    // Linear approximation: T = T0 * (1 - frac) + T_end * frac
    return (t0 * (1.0 - frac)) + (t_end * frac);
}

pub fn annealing_step_advance(sched: &AnnealingSchedule, state: &AnnealingState) -> CoolingStepResult {
    let next_s = (state).current_step + 1;
    let is_done = next_s >= (sched).total_steps;
    let next_t = annealing_calc_exponential_temp(sched, next_s);
    let prog = if (sched).total_steps > 0 { (next_s as Float) / ((sched).total_steps as Float) } else { 1.0 };

    return CoolingStepResult {
        next_step: next_s,
        next_temp_k: next_t,
        is_annealing_finished: is_done,
        progress_fraction: if prog > 1.0 { 1.0 } else { prog },
    };
}
