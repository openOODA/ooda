// # Molecular Dynamics Berendsen Barostat Pressure Coupling
//
// Logline: Implements the Berendsen weak-coupling algorithm for constant pressure (NPT) isobaric ensemble simulations.
//
// Setup: Volume-scaling pressure controller adjusting simulation box vectors and coordinate scaling matrices.
//
// Beats:
//   1. Define BerendsenBarostatParams, PressureTensor, and BarostatStepResult data structures.
//   2. Compute isotropic scalar pressure from the microscopic virial tensor trace.
//   3. Calculate coordinate and periodic box scaling factors with isothermal compressibility.

pub type BerendsenBarostatParams = struct {
    target_pressure_bar: Float,
    coupling_time_ps: Float,
    isothermal_compressibility_bar_inv: Float,
    dt_ps: Float,
};

pub type PressureTensor = struct {
    pxx: Float,
    pyy: Float,
    pzz: Float,
    pxy: Float,
    pxz: Float,
    pyz: Float,
};

pub type BarostatStepResult = struct {
    scalar_pressure_bar: Float,
    scale_factor_xyz: Float,
    new_box_length_x: Float,
    new_box_length_y: Float,
    new_box_length_z: Float,
};

pub fn berendsen_barostat_default(target_p_bar: Float, tau_p_ps: Float, dt_ps: Float) -> BerendsenBarostatParams {
    return BerendsenBarostatParams {
        target_pressure_bar: target_p_bar,
        coupling_time_ps: tau_p_ps,
        isothermal_compressibility_bar_inv: 0.0000457, // Water compressibility ~4.57e-5 bar^-1
        dt_ps: dt_ps,
    };
}

pub fn berendsen_calc_scalar_pressure(tensor: &PressureTensor) -> Float {
    // P = (Pxx + Pyy + Pzz) / 3.0
    return ((tensor).pxx + (tensor).pyy + (tensor).pzz) / 3.0;
}

pub fn berendsen_compute_scale_factor(params: &BerendsenBarostatParams, current_pressure_bar: Float) -> Float {
    // mu = [1 - (beta * dt / tau_P) * (P_0 - P)]^(1/3)
    let delta_p = (params).target_pressure_bar - current_pressure_bar;
    let factor = ((params).isothermal_compressibility_bar_inv * (params).dt_ps) / (params).coupling_time_ps;
    let term = 1.0 - (factor * delta_p);

    if term <= 0.0 { return 1.0; }

    // Cube root approximation: term^(1/3)
    let mut guess = 1.0;
    let mut iter = 0;
    while iter < 8 {
        guess = (2.0 * guess + (term / (guess * guess))) / 3.0;
        iter = iter + 1;
    }
    return guess;
}

pub fn berendsen_apply_scaling(
    params: &BerendsenBarostatParams,
    tensor: &PressureTensor,
    box_x: Float,
    box_y: Float,
    box_z: Float,
) -> BarostatStepResult {
    let p_curr = berendsen_calc_scalar_pressure(tensor);
    let mu = berendsen_compute_scale_factor(params, p_curr);

    return BarostatStepResult {
        scalar_pressure_bar: p_curr,
        scale_factor_xyz: mu,
        new_box_length_x: box_x * mu,
        new_box_length_y: box_y * mu,
        new_box_length_z: box_z * mu,
    };
}
