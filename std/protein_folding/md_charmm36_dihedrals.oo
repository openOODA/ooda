// # CHARMM36 Protein Backbone Dihedrals & CMAP Correction
//
// Logline: Calculates CHARMM36 torsion potentials and 2D bicubic CMAP grid energy corrections for backbone phi/psi angles.
//
// Setup: High-accuracy protein force field module evaluating multi-term dihedral Fourier series and cross-term energy maps.
//
// Beats:
//   1. Define CharmmDihedralTerm and CmapGridPoint data structures.
//   2. Evaluate multi-periodic proper and improper dihedral Fourier expansions.
//   3. Compute 2D grid bilinear energy interpolation for CMAP backbone cross-terms.

pub type CharmmDihedralTerm = struct {
    k_chi: Float, // kcal/mol
    multiplicity_n: Int,
    phase_delta_deg: Float,
};

pub type CmapGrid24 = struct {
    grid_size: Int, // e.g., 24x24 grid (15 degree bins)
    resolution_deg: Float,
};

pub type CharmmTorsionResult = struct {
    fourier_energy_kcal: Float,
    cmap_energy_kcal: Float,
    total_dihedral_energy_kcal: Float,
};

pub fn charmm_dihedral_term_energy(term: &CharmmDihedralTerm, phi_deg: Float) -> Float {
    let deg_to_rad: Float = 0.0174532925;
    let n_f = (term).multiplicity_n * 1.0;
    let angle_deg = (n_f * phi_deg) - (term).phase_delta_deg;
    let angle_rad = angle_deg * deg_to_rad;

    // Normalizing angle to [-pi, pi]
    let mut a = angle_rad;
    while a > 3.14159265 { a = a - 6.2831853; }
    while a < -3.14159265 { a = a + 6.2831853; }
    let a2 = a * a;
    let cos_val = 1.0 - (a2 * 0.5) + (a2 * a2 * 0.041666667);

    return (term).k_chi * (1.0 + cos_val);
}

pub fn charmm_evaluate_cmap_bilinear(phi_deg: Float, psi_deg: Float, e00: Float, e10: Float, e01: Float, e11: Float) -> Float {
    // Normalizing phi and psi to [0, 1] within a 15-degree CMAP grid cell
    let mut p_norm = (phi_deg + 180.0) / 15.0;
    let mut s_norm = (psi_deg + 180.0) / 15.0;

    let p_idx = p_norm as Int;
    let s_idx = s_norm as Int;

    let u = p_norm - (p_idx * 1.0);
    let v = s_norm - (s_idx * 1.0);

    // Bilinear interpolation: (1-u)(1-v)e00 + u(1-v)e10 + (1-u)v e01 + uv e11
    let term00 = (1.0 - u) * (1.0 - v) * e00;
    let term10 = u * (1.0 - v) * e10;
    let term01 = (1.0 - u) * v * e01;
    let term11 = u * v * e11;

    return term00 + term10 + term01 + term11;
}

pub fn charmm_torsion_eval(fourier_terms_energy: Float, cmap_energy: Float) -> CharmmTorsionResult {
    return CharmmTorsionResult {
        fourier_energy_kcal: fourier_terms_energy,
        cmap_energy_kcal: cmap_energy,
        total_dihedral_energy_kcal: fourier_terms_energy + cmap_energy,
    };
}
