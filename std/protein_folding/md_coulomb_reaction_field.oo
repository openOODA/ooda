// # Coulomb Reaction Field Electrostatic Potential
//
// Logline: Calculates electrostatic interactions with dielectric reaction field continuum corrections for truncated spherical cutoffs.
//
// Setup: Implicit continuum electrostatics engine approximating long-range solvent polarization beyond a spherical cutoff boundary.
//
// Beats:
//   1. Define ReactionFieldParams and CoulombRfResult data structures.
//   2. Calculate Barker-Watts reaction field factor k_rf and self-energy correction term.
//   3. Compute modified Coulombic pairwise potential and forces within spherical cutoff.

pub type ReactionFieldParams = struct {
    cutoff_radius_angstrom: Float,
    solvent_dielectric_eps_rf: Float,
    solute_dielectric_eps_in: Float,
    coulomb_constant_kcal_a_per_e2: Float,
};

pub type CoulombRfResult = struct {
    potential_energy_kcal: Float,
    force_magnitude_kcal_per_a: Float,
    reaction_field_term: Float,
};

pub fn reaction_field_params_water(r_cut: Float) -> ReactionFieldParams {
    return ReactionFieldParams {
        cutoff_radius_angstrom: r_cut,
        solvent_dielectric_eps_rf: 78.4, // Standard water permittivity
        solute_dielectric_eps_in: 1.0,
        coulomb_constant_kcal_a_per_e2: 332.0637,
    };
}

pub fn reaction_field_k_factor(params: &ReactionFieldParams) -> Float {
    // k_rf = (eps_rf - eps_in) / ((2 * eps_rf + eps_in) * r_cut^3)
    let eps_rf = (params).solvent_dielectric_eps_rf;
    let eps_in = (params).solute_dielectric_eps_in;
    let r_cut = (params).cutoff_radius_angstrom;
    let r3 = r_cut * r_cut * r_cut;

    let numer = eps_rf - eps_in;
    let denom = ((2.0 * eps_rf) + eps_in) * r3;

    if denom > 0.00001 {
        return numer / denom;
    }
    return 0.0;
}

pub fn reaction_field_c_term(params: &ReactionFieldParams) -> Float {
    // c_rf = (3 * eps_rf) / ((2 * eps_rf + eps_in) * r_cut)
    let eps_rf = (params).solvent_dielectric_eps_rf;
    let eps_in = (params).solute_dielectric_eps_in;
    let r_cut = (params).cutoff_radius_angstrom;

    let numer = 3.0 * eps_rf;
    let denom = ((2.0 * eps_rf) + eps_in) * r_cut;

    if denom > 0.00001 {
        return numer / denom;
    }
    return 0.0;
}

pub fn coulomb_rf_evaluate_pair(
    params: &ReactionFieldParams,
    q1: Float,
    q2: Float,
    r_angstrom: Float,
) -> CoulombRfResult {
    let r_cut = (params).cutoff_radius_angstrom;
    if r_angstrom >= r_cut || r_angstrom < 0.1 {
        return CoulombRfResult {
            potential_energy_kcal: 0.0,
            force_magnitude_kcal_per_a: 0.0,
            reaction_field_term: 0.0,
        };
    }

    let k_rf = reaction_field_k_factor(params);
    let c_rf = reaction_field_c_term(params);
    let qq_f0 = (params).coulomb_constant_kcal_a_per_e2 * q1 * q2;

    // V_rf(r) = (q_i * q_j / eps_in) * [1/r + k_rf * r^2 - c_rf]
    let inv_r = 1.0 / r_angstrom;
    let r2 = r_angstrom * r_angstrom;
    let rf_bracket = inv_r + (k_rf * r2) - c_rf;
    let e_rf = qq_f0 * rf_bracket;

    // F_rf(r) = (q_i * q_j / eps_in) * [1/r^2 - 2 * k_rf * r]
    let f_rf = qq_f0 * ((inv_r * inv_r) - (2.0 * k_rf * r_angstrom));

    return CoulombRfResult {
        potential_energy_kcal: e_rf,
        force_magnitude_kcal_per_a: f_rf,
        reaction_field_term: k_rf * r2,
    };
}
