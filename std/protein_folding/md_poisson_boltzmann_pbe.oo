// # Linearized Poisson-Boltzmann Equation (PBE) Grid Solver
//
// Logline: Solves the linearized Poisson-Boltzmann equation on finite difference grids for electrostatic potential fields and ionic screening.
//
// Setup: Continuum electrostatics PDE solver calculating electrostatic potential phi(r) around macromolecular solute boundaries.
//
// Beats:
//   1. Define PbGridParams, IonicAtmosphere, and PbPotentialGrid data structures.
//   2. Calculate Debye-Hückel inverse screening length kappa from ionic strength I.
//   3. Compute 7-point finite difference stencil relaxation step for electrostatic potential.

pub type PbGridParams = struct {
    grid_spacing_a: Float,
    eps_internal: Float,
    eps_external: Float,
    temperature_k: Float,
    ionic_strength_molar: Float,
};

pub type IonicAtmosphere = struct {
    ionic_strength_molar: Float,
    debye_kappa_inv_a: Float,
    debye_length_angstrom: Float,
};

pub type PbPotentialGrid = struct {
    nx: Int,
    ny: Int,
    nz: Int,
    grid_spacing_a: Float,
    total_grid_points: Int,
};

pub fn pb_sqrt(val: Float) -> Float {
    if val <= 0.0 { return 0.0; }
    let mut guess = val / 2.0;
    if guess < 0.1 { guess = 0.1; }
    let mut iter = 0;
    while iter < 10 {
        guess = 0.5 * (guess + (val / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn pb_calc_ionic_parameters(ionic_strength_m: Float, temp_k: Float, eps_solvent: Float) -> IonicAtmosphere {
    // kappa^2 = 8 * pi * e^2 * N_A * I / (1000 * eps * k_B * T)
    // In Angstrom units: kappa ~ 0.329 * sqrt(I) at 298.15 K with eps=78.5
    let kappa = 0.329 * pb_sqrt(ionic_strength_m);
    let debye_len = if kappa > 0.0001 { 1.0 / kappa } else { 999.0 };

    return IonicAtmosphere {
        ionic_strength_molar: ionic_strength_m,
        debye_kappa_inv_a: kappa,
        debye_length_angstrom: debye_len,
    };
}

pub fn pb_finite_difference_stencil_relax(
    phi_center: Float,
    phi_xm: Float,
    phi_xp: Float,
    phi_ym: Float,
    phi_yp: Float,
    phi_zm: Float,
    phi_zp: Float,
    charge_density: Float,
    kappa_sq: Float,
    h_spacing: Float,
    eps: Float,
) -> Float {
    // (grad^2 - kappa^2) phi = - 4 * pi * rho / eps
    // 7-point stencil: (phi_xp + phi_xm + phi_yp + phi_ym + phi_zp + phi_zm - 6*phi)/h^2 - kappa^2 * phi = - 4*pi*rho/eps
    let sum_neighbors = phi_xm + phi_xp + phi_ym + phi_yp + phi_zm + phi_zp;
    let h2 = h_spacing * h_spacing;
    let source_term = (12.5663706 * charge_density * h2) / eps;

    let denom = 6.0 + (kappa_sq * h2);
    if denom > 0.0001 {
        return (sum_neighbors + source_term) / denom;
    }
    return phi_center;
}
