// # Replica Exchange Molecular Dynamics (REMD)
//
// Logline: Implements the parallel tempering replica exchange criterion for swapping configurations between temperature ladders.
//
// Setup: Enhanced sampling ensemble scheduler evaluating Metropolis exchange probabilities between adjacent temperature rungs.
//
// Beats:
//   1. Define RemdReplica, RemdExchangePair, and RemdSwapResult data structures.
//   2. Calculate delta beta * delta E criterion: Delta = (beta_i - beta_j) * (E_j - E_i).
//   3. Evaluate Metropolis acceptance probability P_swap = min(1, exp(-Delta)).

pub type RemdReplica = struct {
    replica_id: Int,
    temperature_k: Float,
    beta_inv_kcal: Float, // 1 / (k_B * T)
    current_potential_energy_kcal: Float
};

pub type RemdExchangePair = struct {
    replica_i_id: Int,
    replica_j_id: Int,
    temp_i_k: Float,
    temp_j_k: Float,
    energy_i_kcal: Float,
    energy_j_kcal: Float
};

pub type RemdSwapResult = struct {
    pair: RemdExchangePair,
    delta_metropolis: Float,
    swap_probability: Float,
    is_swap_accepted: Bool
};

pub fn remd_calc_beta(temp_k: Float) -> Float {
    let k_b: Float = 0.001987204;
    let kt = k_b * temp_k;
    if kt > 0.0001 {
        return 1.0 / kt;
    }
    return 0.0;
}

pub fn remd_calc_delta(beta_i: Float, beta_j: Float, energy_i: Float, energy_j: Float) -> Float {
    // Delta = (beta_i - beta_j) * (energy_j - energy_i)
    let d_beta = beta_i - beta_j;
    let d_energy = energy_j - energy_i;
    return d_beta * d_energy;
}

pub fn remd_evaluate_exchange(
    pair: &RemdExchangePair,
    random_uniform_0_to_1: Float,
) -> RemdSwapResult {
    let beta_i = remd_calc_beta((pair).temp_i_k);
    let beta_j = remd_calc_beta((pair).temp_j_k);

    let delta = remd_calc_delta(beta_i, beta_j, (pair).energy_i_kcal, (pair).energy_j_kcal);

    if delta <= 0.0 {
        return RemdSwapResult {
            pair: *pair,
            delta_metropolis: delta,
            swap_probability: 1.0,
            is_swap_accepted: true
        };
    }

    // exp(-delta) approximation
    let exp_term = if delta > 30.0 {
        0.0
    } else {
        1.0 / (1.0 + delta + (0.5 * delta * delta) + (0.1666667 * delta * delta * delta))
    };

    let accepted = random_uniform_0_to_1 < exp_term;

    return RemdSwapResult {
        pair: *pair,
        delta_metropolis: delta,
        swap_probability: exp_term,
        is_swap_accepted: accepted
    };
}
