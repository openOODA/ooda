// # Cysteine Disulfide Bridge Crosslink Potential
//
// Logline: Calculates covalent disulfide bridge stabilization energies including S-S bond stretching, C-S-S angle bending, and chi3 dihedral torsion.
//
// Setup: Structural proteomic module evaluating cysteine-cysteine covalent crosslinking restraints and redox stabilization.
//
// Beats:
//   1. Define DisulfideBridgeCoords and DisulfideEnergyResult data structures.
//   2. Calculate S-S harmonic bond stretching (r0 ~ 2.05 A) and C-S-S harmonic angle bending (theta0 ~ 103 deg).
//   3. Compute chi3 (C-S-S-C) bimodal torsional energy preference for right-handed (+90 deg) and left-handed (-90 deg) rotamers.

pub type DisulfideBridgeCoords = struct {
    cys1_ca_idx: Int,
    cys1_cb_idx: Int,
    cys1_sg_idx: Int,
    cys2_sg_idx: Int,
    cys2_cb_idx: Int,
    cys2_ca_idx: Int,
    r_ss_angstrom: Float,
    angle_css1_deg: Float,
    angle_css2_deg: Float,
    dihedral_chi3_deg: Float
};

pub type DisulfideEnergyResult = struct {
    e_bond_kcal: Float,
    e_angles_kcal: Float,
    e_torsion_kcal: Float,
    total_strain_energy_kcal: Float,
    is_ideal_geometry: Bool
};

pub fn disulfide_bond_energy(r_ss: Float) -> Float {
    let r0: Float = 2.05; // Ideal S-S bond length in Angstroms
    let k_ss: Float = 250.0; // kcal/(mol * A^2)
    let dr = r_ss - r0;
    return k_ss * dr * dr;
}

pub fn disulfide_angle_energy(angle_css_deg: Float) -> Float {
    let theta0: Float = 103.0; // Ideal C-S-S angle in degrees
    let k_theta: Float = 0.02; // kcal/(mol * deg^2)
    let dtheta = angle_css_deg - theta0;
    return k_theta * dtheta * dtheta;
}

pub fn disulfide_chi3_torsion_energy(chi3_deg: Float) -> Float {
    // Chi3 typically prefers +/- 90 degrees with a barrier at 0 and 180 degrees
    // V(chi3) = V2 * [1 + cos(2 * chi3)]
    let deg_to_rad: Float = 0.0174532925;
    let angle_rad = 2.0 * chi3_deg * deg_to_rad;

    let mut a = angle_rad;
    while a > 3.14159265 { a = a - 6.2831853; }
    while a < -3.14159265 { a = a + 6.2831853; }

    let a2 = a * a;
    let cos_val = 1.0 - (a2 * 0.5) + (a2 * a2 * 0.041666667);

    let v2: Float = 3.5; // kcal/mol barrier
    return 0.5 * v2 * (1.0 + cos_val);
}

pub fn disulfide_evaluate_bridge(coords: &DisulfideBridgeCoords) -> DisulfideEnergyResult {
    let eb = disulfide_bond_energy((coords).r_ss_angstrom);
    let ea1 = disulfide_angle_energy((coords).angle_css1_deg);
    let ea2 = disulfide_angle_energy((coords).angle_css2_deg);
    let et = disulfide_chi3_torsion_energy((coords).dihedral_chi3_deg);

    let tot = eb + ea1 + ea2 + et;
    let is_ideal = tot < 2.0;

    return DisulfideEnergyResult {
        e_bond_kcal: eb,
        e_angles_kcal: ea1 + ea2,
        e_torsion_kcal: et,
        total_strain_energy_kcal: tot,
        is_ideal_geometry: is_ideal
    };
}
