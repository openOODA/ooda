// # Directional Hydrogen Bond 12-10 Potential
//
// Logline: Calculates directional hydrogen bond energies using 12-10 Lennard-Jones distance terms and angular attenuation factors.
//
// Setup: Structural chemistry module evaluating donor-hydrogen-acceptor (D-H...A) geometry and hydrogen bond stability.
//
// Beats:
//   1. Define HbondGeometry and HbondEnergyResult data structures.
//   2. Calculate radial 12-10 potential V(r) = eps * [5*(r0/r)^12 - 6*(r0/r)^10].
//   3. Compute angular cosine attenuation factor cos^4(theta_DHA) for optimal linear bond geometries.

pub type HbondGeometry = struct {
    donor_idx: Int,
    hydrogen_idx: Int,
    acceptor_idx: Int,
    dist_ha_angstrom: Float,
    angle_dha_rad: Float,
};

pub type HbondEnergyResult = struct {
    radial_energy_kcal: Float,
    angular_factor: Float,
    total_hbond_energy_kcal: Float,
    is_valid_hbond: Bool,
};

pub fn hbond_calc_radial_12_10(r_ha: Float, r0: Float, eps: Float) -> Float {
    if r_ha < 0.5 { return 0.0; }
    let inv_r = 1.0 / r_ha;
    let ratio = r0 * inv_r;
    let ratio2 = ratio * ratio;
    let ratio4 = ratio2 * ratio2;
    let ratio10 = ratio4 * ratio4 * ratio2;
    let ratio12 = ratio10 * ratio2;

    // V_radial = eps * (5 * (r0/r)^12 - 6 * (r0/r)^10)
    return eps * ((5.0 * ratio12) - (6.0 * ratio10));
}

pub fn hbond_calc_angular_factor(angle_dha_rad: Float) -> Float {
    // Cosine approximation
    let mut a = angle_dha_rad;
    while a > 3.14159265 { a = a - 6.2831853; }
    while a < -3.14159265 { a = a + 6.2831853; }

    let a2 = a * a;
    let cos_val = 1.0 - (a2 * 0.5) + (a2 * a2 * 0.041666667);

    // Angle theta in radians, linear bond is ~180 deg (pi rad)
    // Attenuation is proportional to cos^4(theta - pi) or cos^2(theta - pi)
    // If angle is < 120 deg (2.09 rad), bond is broken
    if angle_dha_rad < 2.0944 { return 0.0; }

    let cos_dev = -1.0 * cos_val; // For 180 deg, cos is -1, so cos_dev = 1
    if cos_dev <= 0.0 { return 0.0; }

    let cos2 = cos_dev * cos_dev;
    let cos4 = cos2 * cos2;
    return cos4;
}

pub fn hbond_evaluate_energy(geom: &HbondGeometry, r0: Float, eps: Float) -> HbondEnergyResult {
    let r_e = hbond_calc_radial_12_10((geom).dist_ha_angstrom, r0, eps);
    let ang_fac = hbond_calc_angular_factor((geom).angle_dha_rad);
    let tot_e = r_e * ang_fac;

    let is_valid = (tot_e < -0.5) && ((geom).dist_ha_angstrom <= 2.5);

    return HbondEnergyResult {
        radial_energy_kcal: r_e,
        angular_factor: ang_fac,
        total_hbond_energy_kcal: tot_e,
        is_valid_hbond: is_valid,
    };
}
