// # AlphaFold Pair Representation & Triangular Multiplicative Updates
//
// Logline: Implements triangular multiplicative updates and outer product mean projections for AlphaFold residue-pair embeddings.
//
// Setup: Neural Evoformer pair stack layer enforcing triangle inequality constraints on pairwise distance matrices.
//
// Beats:
//   1. Define PairEmbedding2D, OuterProductMean, and TriangleUpdateResult data structures.
//   2. Calculate outgoing edge triangular update z_ij = sum_k (a_ik * b_jk) with sigmoid gating.
//   3. Symmetrize pair feature tensors to enforce spatial geometric reciprocity z_ij = z_ji.

pub type PairEmbedding2D = struct {
    res_i: Int,
    res_j: Int,
    channel_dim: Int,
    value: Float,
};

pub type OuterProductMean = struct {
    res_i: Int,
    res_j: Int,
    msa_depth_s: Int,
    projected_value: Float,
};

pub type TriangleUpdateResult = struct {
    res_i: Int,
    res_j: Int,
    outgoing_product_sum: Float,
    gate_factor: Float,
    updated_pair_feature: Float,
};

pub fn af_sigmoid_approx(x: Float) -> Float {
    if x > 15.0 { return 1.0; }
    if x < -15.0 { return 0.0; }
    // sigmoid(x) = 1 / (1 + exp(-x))
    let exp_term = if x >= 0.0 {
        let neg = -1.0 * x;
        1.0 / (1.0 - neg + (0.5 * neg * neg))
    } else {
        1.0 + (-1.0 * x) + (0.5 * x * x)
    };
    return 1.0 / (1.0 + exp_term);
}

pub fn af_triangular_multiplicative_update(
    current_z_ij: Float,
    sum_a_ik_times_b_jk: Float,
    gate_g_ij: Float,
    layer_norm_scale: Float,
) -> TriangleUpdateResult {
    // Triangular update: z_ij = z_ij + sigmoid(g_ij) * Linear(sum_k (a_ik * b_jk))
    let gate = af_sigmoid_approx(gate_g_ij);
    let update_delta = gate * sum_a_ik_times_b_jk * layer_norm_scale;
    let new_z = current_z_ij + update_delta;

    return TriangleUpdateResult {
        res_i: 1,
        res_j: 2,
        outgoing_product_sum: sum_a_ik_times_b_jk,
        gate_factor: gate,
        updated_pair_feature: new_z,
    };
}

pub fn af_symmetrize_pair_features(z_ij: Float, z_ji: Float) -> Float {
    return 0.5 * (z_ij + z_ji);
}
