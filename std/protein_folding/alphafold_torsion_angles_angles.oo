// # AlphaFold Backbone & Sidechain Torsion Angle Vectors
//
// Logline: Calculates unnormalized (sine, cosine) torsion representations and reconstructs all-atom dihedral angles (phi, psi, omega, chi1-4).
//
// Setup: AlphaFold torsion angle head evaluating 7 rotation angles per residue for full-atom reconstruction.
//
// Beats:
//   1. Define TorsionSinCos, ResidueTorsionAngles, and TorsionReconstructionResult data structures.
//   2. Normalize raw neural network vector outputs (s, c) to lie on unit circle S^1 via s/sqrt(s^2 + c^2).
//   3. Reconstruct Cartesian dihedral angles in radians via atan2 approximation.

pub type TorsionSinCos = struct {
    sin_val: Float,
    cos_val: Float,
    is_normalized: Bool,
};

pub type ResidueTorsionAngles = struct {
    residue_index: Int,
    omega: TorsionSinCos,
    phi: TorsionSinCos,
    psi: TorsionSinCos,
    chi1: TorsionSinCos,
    chi2: TorsionSinCos,
    chi3: TorsionSinCos,
    chi4: TorsionSinCos,
};

pub type TorsionReconstructionResult = struct {
    angle_rad: Float,
    angle_deg: Float,
    norm_error: Float,
};

pub fn af_torsion_sqrt(val: Float) -> Float {
    if val <= 0.0 { return 0.0; }
    let mut guess = val / 2.0;
    if guess < 0.1 { guess = 0.1; }
    let mut iter = 0;
    while iter < 8 {
        guess = 0.5 * (guess + (val / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn af_normalize_torsion(raw_sin: Float, raw_cos: Float) -> TorsionSinCos {
    let norm_sq = (raw_sin * raw_sin) + (raw_cos * raw_cos);
    let norm = af_torsion_sqrt(norm_sq);

    if norm < 0.0001 {
        return TorsionSinCos { sin_val: 0.0, cos_val: 1.0, is_normalized: true };
    }

    let inv_norm = 1.0 / norm;
    return TorsionSinCos {
        sin_val: raw_sin * inv_norm,
        cos_val: raw_cos * inv_norm,
        is_normalized: true,
    };
}

pub fn af_torsion_to_radians(norm_pair: &TorsionSinCos) -> Float {
    // Fast atan2 approximation from (sin, cos)
    let s = (norm_pair).sin_val;
    let c = (norm_pair).cos_val;

    if c > 0.0 {
        return s / (1.0 + c); // approx for half angle
    } else if c < 0.0 {
        let pi: Float = 3.14159265;
        if s >= 0.0 {
            return pi - (s / (1.0 - c));
        } else {
            return -pi - (s / (1.0 - c));
        }
    }
    return if s >= 0.0 { 1.5707963 } else { -1.5707963 };
}
