// # Umbrella Sampling & Potential of Mean Force (PMF)
//
// Logline: Implements harmonic restraint biasing potentials and WHAM (Weighted Histogram Analysis Method) inputs for free energy profiles.
//
// Setup: Enhanced sampling free energy module applying harmonic windows along reaction coordinates xi.
//
// Beats:
//   1. Define UmbrellaWindowParams, BiasedSample, and PmfBin data structures.
//   2. Calculate harmonic biasing potential energy U_bias(xi) = 0.5 * k_bias * (xi - xi_0)^2 and biasing force.
//   3. Unbias probability distributions to reconstruct the unbiased Potential of Mean Force profile.

pub type UmbrellaWindowParams = struct {
    window_id: Int,
    target_center_xi0: Float,
    spring_constant_k: Float, // kcal / (mol * unit^2)
    temperature_k: Float,
};

pub type BiasedSample = struct {
    reaction_coord_xi: Float,
    bias_energy_kcal: Float,
    bias_force: Float,
};

pub type PmfBin = struct {
    bin_center: Float,
    raw_count: Int,
    unbiased_free_energy_kcal: Float,
};

pub fn umbrella_calc_bias_energy(params: &UmbrellaWindowParams, xi: Float) -> Float {
    // U_bias(xi) = 0.5 * k * (xi - xi_0)^2
    let dxi = xi - (params).target_center_xi0;
    return 0.5 * (params).spring_constant_k * dxi * dxi;
}

pub fn umbrella_calc_bias_force(params: &UmbrellaWindowParams, xi: Float) -> Float {
    // F_bias(xi) = - dU/dxi = - k * (xi - xi_0)
    let dxi = xi - (params).target_center_xi0;
    return -1.0 * (params).spring_constant_k * dxi;
}

pub fn umbrella_evaluate_sample(params: &UmbrellaWindowParams, xi: Float) -> BiasedSample {
    let e_bias = umbrella_calc_bias_energy(params, xi);
    let f_bias = umbrella_calc_bias_force(params, xi);

    return BiasedSample {
        reaction_coord_xi: xi,
        bias_energy_kcal: e_bias,
        bias_force: f_bias,
    };
}

pub fn umbrella_unbias_log_weight(sample: &BiasedSample, temp_k: Float) -> Float {
    // Boltzmann factor exponent: beta * U_bias = U_bias / (k_B * T)
    let k_b: Float = 0.001987204;
    let kt = k_b * temp_k;
    if kt > 0.0001 {
        return (sample).bias_energy_kcal / kt;
    }
    return 0.0;
}

pub fn md_umbrella_sampling_pmf_probe() -> Int {
    return 0;
}
