pub fn fold_shim_velocity_verlet(p: &VerletParticle, dt_ps: Float) -> Vec3D {
    return verlet_advance_position(p, dt_ps);
}

pub fn fold_shim_langevin_params(temp_k: Float, gamma_ps: Float, dt_ps: Float) -> LangevinParams {
    return langevin_params_default(temp_k, gamma_ps, dt_ps);
}

pub fn fold_shim_amber_bond(bond: &AmberBond, dist_a: Float) -> Float {
    return amber_bond_energy(bond, dist_a);
}

pub fn fold_shim_charmm_cmap(phi: Float, psi: Float, e00: Float, e10: Float, e01: Float, e11: Float) -> Float {
    return charmm_evaluate_cmap_bilinear(phi, psi, e00, e10, e01, e11);
}

pub fn fold_shim_lj_pair(r: Float, sigma: Float, eps: Float) -> LjPairInteraction {
    return lj_evaluate_pair_raw(r, sigma, eps);
}

pub fn fold_shim_pme_real_space(q1: Float, q2: Float, r: Float, alpha: Float) -> Float {
    return pme_real_space_pair(q1, q2, r, alpha);
}

pub fn fold_shim_pbc_displacement(p1: &Point3D, p2: &Point3D, box: &SimulationBox3D) -> PbcDisplacementResult {
    return pbc_minimum_image_disp(p1, p2, box);
}

pub fn fold_shim_gbsa_pair(i: &GbAtom, j: &GbAtom, r: Float, p: &GbParams) -> Float {
    return gb_pair_polar_energy(i, j, r, p);
}

pub fn fold_shim_sasa_eval(atom: &SasaAtomSphere, probe_r: Float, tot: Int, acc: Int) -> SasaResult {
    return sasa_evaluate_atom(atom, probe_r, tot, acc);
}

pub fn fold_shim_umbrella_bias(p: &UmbrellaWindowParams, xi: Float) -> BiasedSample {
    return umbrella_evaluate_sample(p, xi);
}

pub fn fold_shim_hbond(geom: &HbondGeometry, r0: Float, eps: Float) -> HbondEnergyResult {
    return hbond_evaluate_energy(geom, r0, eps);
}

pub fn fold_shim_ramachandran(phi: Float, psi: Float, temp_k: Float) -> RamaEnergyResult {
    return rama_calc_energy(phi, psi, temp_k);
}

pub fn fold_shim_hydrophobic_burial(res_idx: Int, aa: String, exposed_a2: Float) -> BurialState {
    return hydrophobic_calc_burial(res_idx, aa, exposed_a2);
}

pub fn fold_shim_disulfide(coords: &DisulfideBridgeCoords) -> DisulfideEnergyResult {
    return disulfide_evaluate_bridge(coords);
}

pub fn fold_shim_salt_bridge(pair: &SaltBridgePair, local_eps: Float) -> SaltBridgeScore {
    return salt_bridge_classify_pair(pair, local_eps);
}

pub fn fold_shim_monte_carlo(cur_e: Float, trial_e: Float, rand_u: Float, p: &McParams) -> McAcceptanceResult {
    return mc_evaluate_move(cur_e, trial_e, rand_u, p);
}

pub fn fold_shim_remd_exchange(pair: &RemdExchangePair, rand_u: Float) -> RemdSwapResult {
    return remd_evaluate_exchange(pair, rand_u);
}

pub fn fold_shim_funnel_q(cur_d: Float, nat_d: Float, beta: Float, lambda_f: Float) -> Float {
    return funnel_calc_q_pair(cur_d, nat_d, beta, lambda_f);
}

pub fn fold_shim_martini_pair(dist_a: Float, level: Int) -> MartiniPairInteraction {
    return martini_evaluate_pair_lj(dist_a, level);
}

pub fn fold_shim_alphafold_ipa(s_dot: Float, d2: Float, gamma_w: Float, b_ij: Float, c_f: Float) -> IpaScoreResult {
    return ipa_evaluate_attention_logit(s_dot, d2, gamma_w, b_ij, c_f);
}

pub fn fold_shim_alphafold_plddt(res_idx: Int, plddt_val: Float) -> ResiduePlddtScore {
    return af_evaluate_residue_plddt(res_idx, plddt_val);
}

pub fn fold_shim_rmsd(dist_sq: List[Float]) -> RmsdScore {
    return struct_calc_rmsd(dist_sq);
}

pub fn fold_shim_tm_score(distances_a: List[Float], target_len: Int) -> TmScoreResult {
    return tm_evaluate_score(distances_a, target_len);
}

pub fn fold_shim_clashscore(severe_clashes: Int, total_atoms: Int) -> ClashscoreResult {
    return molprobity_evaluate_clashscore(severe_clashes, total_atoms);
}
