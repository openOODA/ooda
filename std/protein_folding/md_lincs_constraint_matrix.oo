// # LINCS (Linear Constraint Solver) Algorithm
//
// Logline: Implements the LINCS matrix inversion algorithm for non-iterative holonomic bond constraint projection.
//
// Setup: Linear constraint solver applying truncated Neumann series expansions to the coupling matrix A_matrix.
//
// Beats:
//   1. Define LincsBondPair, LincsMatrixParams, and LincsStepResult data structures.
//   2. Formulate the sparse symmetric constraint coupling matrix A_ij = cos(phi_ij) / (m1^-1 + m2^-1).
//   3. Compute 4th-order Neumann series matrix vector products for fast coordinate correction.

pub type LincsBondPair = struct {
    bond_id: Int,
    atom_i: Int,
    atom_j: Int,
    target_length_a: Float,
};

pub type LincsMatrixParams = struct {
    num_bonds: Int,
    expansion_order_n: Int, // Typically 4
    tolerance: Float,
};

pub type LincsStepResult = struct {
    max_relative_error: Float,
    converged: Bool,
    expansion_order_used: Int,
};

pub fn lincs_params_default(n_bonds: Int) -> LincsMatrixParams {
    return LincsMatrixParams {
        num_bonds: n_bonds,
        expansion_order_n: 4,
        tolerance: 0.0001,
    };
}

pub fn lincs_neumann_expansion_4(coupling_coeff: Float, rhs: Float) -> Float {
    // (I - A)^-1 * rhs = (I + A + A^2 + A^3 + A^4) * rhs
    let a1 = coupling_coeff;
    let a2 = a1 * a1;
    let a3 = a2 * a1;
    let a4 = a3 * a1;

    let sum_series = 1.0 + a1 + a2 + a3 + a4;
    return sum_series * rhs;
}

pub fn lincs_evaluate_bond_strain(current_len: Float, target_len: Float) -> Float {
    if target_len <= 0.0001 { return 0.0; }
    let diff = current_len - target_len;
    let rel_err = diff / target_len;
    if rel_err < 0.0 {
        return -1.0 * rel_err;
    }
    return rel_err;
}

pub fn lincs_check_convergence(params: &LincsMatrixParams, max_strain: Float) -> LincsStepResult {
    let conv = max_strain < (params).tolerance;
    return LincsStepResult {
        max_relative_error: max_strain,
        converged: conv,
        expansion_order_used: (params).expansion_order_n,
    };
}
