// # Molecular Dynamics Velocity Verlet Integrator
//
// Logline: Implements symplectic Velocity Verlet integration for atomic positions, velocities, and acceleration propagation.
//
// Setup: Core classical dynamics integrator updating phase space coordinates with second-order time-reversibility.
//
// Beats:
//   1. Define Vec3D, VerletParticle, and IntegrationStepResult data structures.
//   2. Calculate half-step velocity advancement and full-step position updates.
//   3. Compute instantaneous kinetic energy and total system Hamiltonian conservation.

pub type Vec3D = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub type VerletParticle = struct {
    id: Int,
    mass_amu: Float,
    pos: Vec3D,
    vel: Vec3D,
    force: Vec3D,
};

pub type IntegrationStepResult = struct {
    time_ps: Float,
    kinetic_energy_kcal: Float,
    potential_energy_kcal: Float,
    total_energy_kcal: Float,
    temperature_k: Float,
};

pub fn vec3d_new(x: Float, y: Float, z: Float) -> Vec3D {
    return Vec3D { x: x, y: y, z: z };
}

pub fn vec3d_add(a: Vec3D, b: Vec3D) -> Vec3D {
    return Vec3D {
        x: (a).x + (b).x,
        y: (a).y + (b).y,
        z: (a).z + (b).z,
    };
}

pub fn vec3d_scale(v: Vec3D, s: Float) -> Vec3D {
    return Vec3D {
        x: (v).x * s,
        y: (v).y * s,
        z: (v).z * s,
    };
}

pub fn verlet_advance_position(p: &VerletParticle, dt_ps: Float) -> Vec3D {
    // r(t + dt) = r(t) + v(t)*dt + 0.5 * (F(t)/m) * dt^2
    let inv_mass = if (p).mass_amu > 0.0001 { 1.0 / (p).mass_amu } else { 1.0 };
    let half_dt_sq = 0.5 * dt_ps * dt_ps;
    let accel_x = (p).force.x * inv_mass;
    let accel_y = (p).force.y * inv_mass;
    let accel_z = (p).force.z * inv_mass;

    let new_x = (p).pos.x + ((p).vel.x * dt_ps) + (accel_x * half_dt_sq);
    let new_y = (p).pos.y + ((p).vel.y * dt_ps) + (accel_y * half_dt_sq);
    let new_z = (p).pos.z + ((p).vel.z * dt_ps) + (accel_z * half_dt_sq);

    return Vec3D { x: new_x, y: new_y, z: new_z };
}

pub fn verlet_advance_velocity(p: &VerletParticle, new_force: Vec3D, dt_ps: Float) -> Vec3D {
    // v(t + dt) = v(t) + 0.5 * (F(t)/m + F(t+dt)/m) * dt
    let inv_mass = if (p).mass_amu > 0.0001 { 1.0 / (p).mass_amu } else { 1.0 };
    let half_dt = 0.5 * dt_ps;

    let avg_accel_x = ((p).force.x + (new_force).x) * inv_mass;
    let avg_accel_y = ((p).force.y + (new_force).y) * inv_mass;
    let avg_accel_z = ((p).force.z + (new_force).z) * inv_mass;

    let new_vx = (p).vel.x + (avg_accel_x * half_dt);
    let new_vy = (p).vel.y + (avg_accel_y * half_dt);
    let new_vz = (p).vel.z + (avg_accel_z * half_dt);

    return Vec3D { x: new_vx, y: new_vy, z: new_vz };
}

pub fn verlet_particle_kinetic_energy(p: &VerletParticle) -> Float {
    let v_sq = ((p).vel.x * (p).vel.x) + ((p).vel.y * (p).vel.y) + ((p).vel.z * (p).vel.z);
    return 0.5 * (p).mass_amu * v_sq * 0.00239006;
}

pub fn verlet_step_summary(time_ps: Float, e_kin: Float, e_pot: Float, degrees_of_freedom: Int) -> IntegrationStepResult {
    let e_tot = e_kin + e_pot;
    let boltzmann_k: Float = 0.001987204;
    let dof_f = if degrees_of_freedom > 0 { degrees_of_freedom as Float } else { 1.0 };
    let temp_k = (2.0 * e_kin) / (dof_f * boltzmann_k);

    return IntegrationStepResult {
        time_ps: time_ps,
        kinetic_energy_kcal: e_kin,
        potential_energy_kcal: e_pot,
        total_energy_kcal: e_tot,
        temperature_k: temp_k,
    };
}
