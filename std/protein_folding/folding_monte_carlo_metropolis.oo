// # Metropolis Monte Carlo Protein Conformational Sampling
//
// Logline: Implements Metropolis-Hastings Monte Carlo sampling for protein conformational moves including crankshaft and pivot rotations.
//
// Setup: Stochastic conformational search engine accepting or rejecting structural perturbations according to Boltzmann probabilities.
//
// Beats:
//   1. Define MonteCarloMove, McParams, and McAcceptanceResult data structures.
//   2. Calculate delta energy dE = E_trial - E_current and transition probability P = min(1, exp(-dE / (k_B*T))).
//   3. Track cumulative acceptance rates and dynamically adjust perturbation step amplitudes.

pub type McParams = struct {
    temperature_k: Float,
    boltzmann_k: Float,
    max_angle_step_deg: Float,
    target_acceptance_rate: Float
};

pub type MonteCarloMove = struct {
    move_type: String, // "PIVOT", "CRANKSHAFT", "SIDECHAIN_ROTAMER"
    residue_start_idx: Int,
    residue_end_idx: Int,
    angle_delta_deg: Float
};

pub type McAcceptanceResult = struct {
    accepted: Bool,
    energy_change_kcal: Float,
    acceptance_probability: Float
};

pub fn mc_params_default(temp_k: Float) -> McParams {
    return McParams {
        temperature_k: temp_k,
        boltzmann_k: 0.001987204, // kcal / (mol * K)
        max_angle_step_deg: 15.0,
        target_acceptance_rate: 0.40
    };
}

pub fn mc_calc_boltzmann_factor(delta_e_kcal: Float, temp_k: Float) -> Float {
    if delta_e_kcal <= 0.0 {
        return 1.0;
    }
    let k_b: Float = 0.001987204;
    let kt = k_b * temp_k;
    if kt <= 0.0001 { return 0.0; }

    let x = delta_e_kcal / kt;
    if x > 30.0 { return 0.0; }

    // exp(-x) approximation
    let exp_term = 1.0 / (1.0 + x + (0.5 * x * x) + (0.1666667 * x * x * x));
    return exp_term;
}

pub fn mc_evaluate_move(
    current_energy: Float,
    trial_energy: Float,
    random_uniform_0_to_1: Float,
    params: &McParams,
) -> McAcceptanceResult {
    let delta_e = trial_energy - current_energy;

    if delta_e <= 0.0 {
        return McAcceptanceResult {
            accepted: true,
            energy_change_kcal: delta_e,
            acceptance_probability: 1.0
        };
    }

    let prob = mc_calc_boltzmann_factor(delta_e, (params).temperature_k);
    let is_acc = random_uniform_0_to_1 < prob;

    return McAcceptanceResult {
        accepted: is_acc,
        energy_change_kcal: delta_e,
        acceptance_probability: prob
    };
}

pub fn mc_adapt_step_size(current_step: Float, current_acceptance_rate: Float, target_rate: Float) -> Float {
    // If acceptance is too high, increase step size; if too low, decrease
    let ratio = current_acceptance_rate / (if target_rate > 0.01 { target_rate } else { 0.4 });
    let mut factor = 1.0 + (0.1 * (ratio - 1.0));
    if factor < 0.5 { factor = 0.5; }
    if factor > 2.0 { factor = 2.0; }
    return current_step * factor;
}
