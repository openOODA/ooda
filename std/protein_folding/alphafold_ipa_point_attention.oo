// # AlphaFold Invariant Point Attention (IPA)
//
// Logline: Calculates SE(3)-invariant point attention weights combining scalar features, 3D point representations, and pairwise biases.
//
// Setup: Geometric deep learning attention module operating directly on rigid reference frames T_i = (R_i, t_i).
//
// Beats:
//   1. Define IpaPoint3D, IpaAttentionWeights, and IpaScoreResult data structures.
//   2. Transform query/key 3D points from local residue frames into global reference frame coordinates.
//   3. Compute invariant Euclidean distance penalties gamma/2 * ||T_i q_i - T_j k_j||^2 and scalar attention logits.

pub type IpaPoint3D = struct {
    x: Float,
    y: Float,
    z: Float
};

pub type IpaAttentionWeights = struct {
    head_id: Int,
    scalar_weight: Float,
    point_weight: Float,
    pair_bias_weight: Float
};

pub type IpaScoreResult = struct {
    scalar_logit: Float,
    point_dist_sq: Float,
    point_term: Float,
    pair_bias: Float,
    total_attention_logit: Float
};

pub fn ipa_point_dist_sq(p1: &IpaPoint3D, p2: &IpaPoint3D) -> Float {
    let dx = (p1).x - (p2).x;
    let dy = (p1).y - (p2).y;
    let dz = (p1).z - (p2).z;
    return (dx * dx) + (dy * dy) + (dz * dz);
}

pub fn ipa_calc_point_term(
    global_query_pt: &IpaPoint3D,
    global_key_pt: &IpaPoint3D,
    gamma_weight: Float,
) -> Float {
    // Point penalty: - 0.5 * gamma * sum_p ||T_i * q_i^p - T_j * k_j^p||^2
    let d2 = ipa_point_dist_sq(global_query_pt, global_key_pt);
    let term = -0.5 * gamma_weight * d2;
    return term;
}

pub fn ipa_evaluate_attention_logit(
    scalar_dot: Float,
    d_points_sq: Float,
    gamma_weight: Float,
    pair_bias_b_ij: Float,
    c_factor: Float,
) -> IpaScoreResult {
    // a_ij = (1 / sqrt(d_k)) * (q_i^T * k_j) + b_ij - 0.5 * sum_p gamma_p * ||p_qi - p_kj||^2
    let point_term = -0.5 * gamma_weight * d_points_sq;
    let scaled_scalar = scalar_dot * c_factor;
    let total_logit = scaled_scalar + pair_bias_b_ij + point_term;

    return IpaScoreResult {
        scalar_logit: scaled_scalar,
        point_dist_sq: d_points_sq,
        point_term: point_term,
        pair_bias: pair_bias_b_ij,
        total_attention_logit: total_logit
    };
}
