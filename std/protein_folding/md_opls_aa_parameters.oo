// # OPLS-AA Force Field Parameters & Combining Rules
//
// Logline: Implements OPLS-AA non-bonded parameterization with geometric combining rules for Lennard-Jones sigma and epsilon.
//
// Setup: All-atom organic and peptide molecular mechanics parameter definitions for liquid and solution simulations.
//
// Beats:
//   1. Define OplsAtomType and OplsPairParams data structures.
//   2. Apply geometric mixing rules for Lennard-Jones cross terms (sigma_ij = sqrt(si*sj), eps_ij = sqrt(ei*ej)).
//   3. Compute non-bonded interaction parameters for protein backbone and sidechain atom types.

pub type OplsAtomType = struct {
    type_code: Int,
    atom_name: String,
    mass_amu: Float,
    partial_charge_e: Float,
    sigma_angstrom: Float,
    epsilon_kcal: Float
};

pub type OplsPairParams = struct {
    sigma_ij: Float,
    epsilon_ij: Float,
    c6_dispersion: Float,
    c12_repulsion: Float,
    charge_prod: Float
};

pub fn opls_sqrt(val: Float) -> Float {
    if val <= 0.0 { return 0.0; }
    let mut guess = val / 2.0;
    if guess < 0.1 { guess = 0.1; }
    let mut iter = 0;
    while iter < 10 {
        guess = 0.5 * (guess + (val / guess));
        iter = iter + 1;
    }
    return guess;
}

pub fn opls_geometric_mixing(type_i: &OplsAtomType, type_j: &OplsAtomType) -> OplsPairParams {
    // OPLS geometric combining rules:
    // sigma_ij = sqrt(sigma_i * sigma_j)
    // eps_ij = sqrt(eps_i * eps_j)
    let sig_ij = opls_sqrt((type_i).sigma_angstrom * (type_j).sigma_angstrom);
    let eps_ij = opls_sqrt((type_i).epsilon_kcal * (type_j).epsilon_kcal);

    // C6 = 4 * eps * sig^6, C12 = 4 * eps * sig^12
    let s2 = sig_ij * sig_ij;
    let s6 = s2 * s2 * s2;
    let s12 = s6 * s6;

    let c6 = 4.0 * eps_ij * s6;
    let c12 = 4.0 * eps_ij * s12;
    let q_prod = (type_i).partial_charge_e * (type_j).partial_charge_e;

    return OplsPairParams {
        sigma_ij: sig_ij,
        epsilon_ij: eps_ij,
        c6_dispersion: c6,
        c12_repulsion: c12,
        charge_prod: q_prod
    };
}

pub fn opls_type_ca_carbon() -> OplsAtomType {
    return OplsAtomType {
        type_code: 1,
        atom_name: "CT_alpha",
        mass_amu: 12.011,
        partial_charge_e: 0.06,
        sigma_angstrom: 3.50,
        epsilon_kcal: 0.066
    };
}

pub fn opls_type_carbonyl_o() -> OplsAtomType {
    return OplsAtomType {
        type_code: 2,
        atom_name: "O_carbonyl",
        mass_amu: 15.999,
        partial_charge_e: -0.50,
        sigma_angstrom: 2.96,
        epsilon_kcal: 0.210
    };
}

pub fn opls_type_amide_n() -> OplsAtomType {
    return OplsAtomType {
        type_code: 3,
        atom_name: "N_amide",
        mass_amu: 14.007,
        partial_charge_e: -0.50,
        sigma_angstrom: 3.25,
        epsilon_kcal: 0.170
    };
}
