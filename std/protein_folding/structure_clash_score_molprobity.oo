// # MolProbity All-Atom Steric Clashscore & Contact Overlaps
//
// Logline: Calculates MolProbity steric clashscores, counting all-atom van der Waals overlaps >= 0.4 Angstroms per 1000 atoms.
//
// Setup: Structural validation module detecting unphysical atomic steric overlaps and quality metrics for experimental and predicted models.
//
// Beats:
//   1. Define AtomVdwContact, StericClashPair, and ClashscoreResult data structures.
//   2. Compute van der Waals overlap distance delta = (R_vdw,i + R_vdw,j) - d_ij.
//   3. Calculate standard MolProbity clashscore = (1000 * num_clashes) / total_atoms and evaluate percentile quality.

pub type AtomVdwContact = struct {
    atom_id: Int,
    vdw_radius_a: Float,
    is_hydrogen: Bool
};

pub type StericClashPair = struct {
    atom_i: Int,
    atom_j: Int,
    overlap_a: Float,
    is_severe_clash: Bool // Overlap >= 0.4 A
};

pub type ClashscoreResult = struct {
    total_atoms: Int,
    num_clashes: Int,
    clashscore_per_1000_atoms: Float,
    is_high_quality_structure: Bool // Clashscore < 5.0
};

pub fn molprobity_calc_overlap(r_vdw_i: Float, r_vdw_j: Float, actual_dist_a: Float) -> Float {
    let sum_radii = r_vdw_i + r_vdw_j;
    let overlap = sum_radii - actual_dist_a;
    return if overlap > 0.0 { overlap } else { 0.0 };
}

pub fn molprobity_is_clash(overlap_a: Float) -> Bool {
    // MolProbity standard definition of a clash: overlap >= 0.40 A
    return overlap_a >= 0.40;
}

pub fn molprobity_evaluate_clashscore(num_severe_clashes: Int, total_atom_count: Int) -> ClashscoreResult {
    let tot_f = if total_atom_count > 0 { total_atom_count as Float } else { 1.0 };
    let score = (1000.0 * (num_severe_clashes as Float)) / tot_f;

    return ClashscoreResult {
        total_atoms: total_atom_count,
        num_clashes: num_severe_clashes,
        clashscore_per_1000_atoms: score,
        is_high_quality_structure: score < 5.0
    };
}
