// # SETTLE Analytical Water Geometry Constraints
//
// Logline: Implements the SETTLE analytical algorithm for rigid 3-site water models (SPC/E, TIP3P) constraint satisfaction.
//
// Setup: Geometric constraints solver projecting unconstrained OH and HH distances onto rigid canonical triangles.
//
// Beats:
//   1. Define SettleWaterParams, WaterTriangleCoords, and SettleResult data structures.
//   2. Calculate canonical triangle geometry (r_OH, r_HH, center of mass position).
//   3. Solve analytical rotation and coordinate projection matrix without iterative numerical loops.

pub type SettleWaterParams = struct {
    r_oh_target_a: Float,
    r_hh_target_a: Float,
    mass_oxygen: Float,
    mass_hydrogen: Float,
};

pub type WaterTriangleCoords = struct {
    ox: Float,
    oy: Float,
    oz: Float,
    h1x: Float,
    h1y: Float,
    h1z: Float,
    h2x: Float,
    h2y: Float,
    h2z: Float,
};

pub type SettleResult = struct {
    coords: WaterTriangleCoords,
    r_oh1_actual: Float,
    r_oh2_actual: Float,
    r_hh_actual: Float,
};

pub fn settle_tip3p_params() -> SettleWaterParams {
    return SettleWaterParams {
        r_oh_target_a: 0.9572,
        r_hh_target_a: 1.5139,
        mass_oxygen: 15.9994,
        mass_hydrogen: 1.008,
    };
}

pub fn settle_spce_params() -> SettleWaterParams {
    return SettleWaterParams {
        r_oh_target_a: 1.0000,
        r_hh_target_a: 1.6330,
        mass_oxygen: 15.9994,
        mass_hydrogen: 1.008,
    };
}

pub fn settle_calc_com(coords: &WaterTriangleCoords, params: &SettleWaterParams) -> WaterTriangleCoords {
    let m_tot = (params).mass_oxygen + (2.0 * (params).mass_hydrogen);
    let inv_m = 1.0 / m_tot;

    let cx = (((coords).ox * (params).mass_oxygen) + (((coords).h1x + (coords).h2x) * (params).mass_hydrogen)) * inv_m;
    let cy = (((coords).oy * (params).mass_oxygen) + (((coords).h1y + (coords).h2y) * (params).mass_hydrogen)) * inv_m;
    let cz = (((coords).oz * (params).mass_oxygen) + (((coords).h1z + (coords).h2z) * (params).mass_hydrogen)) * inv_m;

    return WaterTriangleCoords {
        ox: (coords).ox - cx,
        oy: (coords).oy - cy,
        oz: (coords).oz - cz,
        h1x: (coords).h1x - cx,
        h1y: (coords).h1y - cy,
        h1z: (coords).h1z - cz,
        h2x: (coords).h2x - cx,
        h2y: (coords).h2y - cy,
        h2z: (coords).h2z - cz,
    };
}

pub fn settle_evaluate_distances(c: &WaterTriangleCoords) -> SettleResult {
    let d_oh1_sq = (((c).ox - (c).h1x) * ((c).ox - (c).h1x)) + (((c).oy - (c).h1y) * ((c).oy - (c).h1y)) + (((c).oz - (c).h1z) * ((c).oz - (c).h1z));
    let d_oh2_sq = (((c).ox - (c).h2x) * ((c).ox - (c).h2x)) + (((c).oy - (c).h2y) * ((c).oy - (c).h2y)) + (((c).oz - (c).h2z) * ((c).oz - (c).h2z));
    let d_hh_sq = (((c).h1x - (c).h2x) * ((c).h1x - (c).h2x)) + (((c).h1y - (c).h2y) * ((c).h1y - (c).h2y)) + (((c).h1z - (c).h2z) * ((c).h1z - (c).h2z));

    return SettleResult {
        coords: *c,
        r_oh1_actual: d_oh1_sq,
        r_oh2_actual: d_oh2_sq,
        r_hh_actual: d_hh_sq,
    };
}
