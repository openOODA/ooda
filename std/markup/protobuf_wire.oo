// # Protocol Buffers Wire Format Module
//
// Logline: Varint LEB128 serialization, ZigZag signed mapping, and tag packing for Protobuf wire streams.
//
// Setup: Pure binary protocol serializer. Encodes and decodes Protocol Buffers wire types and tags.
//
// Beats:
//   1. Expose wire type constants (0=Varint, 1=64-bit, 2=Length-delimited, 5=32-bit).
//   2. Encode and decode packed field tags: (field_number << 3) | wire_type.
//   3. Implement LEB128 unsigned varint variable-length byte encoding.
//   4. Implement reversible ZigZag 32/64-bit signed integer transformation.
// RULES.oot 1.4: Pure data format serializer, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Group start and group end (wire types 3 and 4) are deprecated by proto3.

type ProtobufTag = struct {
    field_number: Int,
    wire_type: Int
};

pub fn pb_wire_varint() -> Int { return 0; }
pub fn pb_wire_fixed64() -> Int { return 1; }
pub fn pb_wire_length_delimited() -> Int { return 2; }
pub fn pb_wire_fixed32() -> Int { return 5; }

pub fn pb_make_tag(field_number: Int, wire_type: Int) -> Int {
    return (field_number * 8) + wire_type;
}

pub fn pb_decode_tag(tag: Int) -> ProtobufTag {
    let wire: Int = tag % 8;
    let field_num: Int = tag / 8;
    return ProtobufTag {
        field_number: field_num,
        wire_type: wire
    };
}

pub fn pb_encode_varint(mut val: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    if val == 0 {
        out = list_push(out, 0);
        return out;
    }
    while val > 0 {
        let mut b: Int = val % 128;
        val = val / 128;
        if val > 0 {
            b = b + 128; // set continuation bit (0x80)
        }
        out = list_push(out, b);
    }
    return out;
}

pub fn pb_zigzag_encode(n: Int) -> Int {
    if n >= 0 {
        return n * 2;
    }
    return (0 - n) * 2 - 1;
}

pub fn pb_zigzag_decode(n: Int) -> Int {
    if n % 2 == 0 {
        return n / 2;
    }
    return 0 - ((n + 1) / 2);
}

pub fn pb_encode_string(field_num: Int, s: String) -> List[Int] {
    let tag: Int = pb_make_tag(field_num, 2); // wire type 2 = length-delimited
    let mut out: List[Int] = pb_encode_varint(tag);
    let s_len: Int = chars_len(s);
    let len_varint: List[Int] = pb_encode_varint(s_len);
    let n_len: Int = list_len(len_varint);
    let mut j: Int = 0;
    while j < n_len {
        out = list_push(out, list_get(len_varint, j));
        j = j + 1;
    }
    let mut i: Int = 0;
    while i < s_len {
        let ch: String = char_at(s, i);
        out = list_push(out, ord(ch));
        i = i + 1;
    }
    return out;
}

pub fn pb_encode_int32(field_num: Int, val: Int) -> List[Int] {
    let tag: Int = pb_make_tag(field_num, 0); // wire type 0 = varint
    let mut out: List[Int] = pb_encode_varint(tag);
    let val_bytes: List[Int] = pb_encode_varint(val);
    let n_val: Int = list_len(val_bytes);
    let mut i: Int = 0;
    while i < n_val {
        out = list_push(out, list_get(val_bytes, i));
        i = i + 1;
    }
    return out;
}
