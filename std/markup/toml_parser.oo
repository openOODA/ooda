// # TOML Configuration Document Parser Module
//
// Logline: Section-aware document parser and typed key-value query engine for TOML files.
//
// Setup: Pure configuration parser. Parses multi-section TOML files and extracts typed parameters.
//
// Beats:
//   1. Construct TomlDoc handle and normalize multi-line buffers.
//   2. Track section header scopes ([section] and nested [a.b.c]).
//   3. Extract string, integer, and boolean values under targeted section scopes.
//   4. Strip inline quotes, whitespace, and comments cleanly.
// RULES.oot 1.4: Pure data format parser, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Inline tables ({ key = "val" }) and datetime literals are mapped as strings.

import "std/result.oo";

type TomlDoc = struct {
    src: String,
    line_count: Int
};

pub fn toml_doc_new(src: String) -> TomlDoc {
    let n: Int = chars_len(src);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if char_at(src, i) == "\n" {
            count = count + 1;
        }
        i = i + 1;
    }
    return TomlDoc {
        src: src,
        line_count: count + 1
    };
}

fn toml_trim(s: String) -> String {
    let n: Int = chars_len(s);
    let mut start: Int = 0;
    while start < n {
        let ch: String = char_at(s, start);
        if ch != " " && ch != "\t" && ch != "\r" {
            break;
        }
        start = start + 1;
    }
    let mut end_p: Int = n;
    while end_p > start {
        let ch2: String = char_at(s, end_p - 1);
        if ch2 != " " && ch2 != "\t" && ch2 != "\r" {
            break;
        }
        end_p = end_p - 1;
    }
    return str_slice(s, start, end_p);
}

pub fn toml_get_string(doc: TomlDoc, target_section: String, target_key: String) -> Result[String, String] {
    let src: String = doc.src;
    let n: Int = chars_len(src);
    let mut cur_section: String = "";
    let mut p: Int = 0;

    while p < n {
        let nl_idx: Int = str_index_of(str_slice(src, p, n), "\n");
        let mut line: String = "";
        if nl_idx >= 0 {
            line = str_slice(src, p, p + nl_idx);
            p = p + nl_idx + 1;
        } else {
            line = str_slice(src, p, n);
            p = n;
        }

        let trimmed: String = toml_trim(line);
        let tlen: Int = chars_len(trimmed);
        if tlen == 0 || char_at(trimmed, 0) == "#" {
            // skip empty line or comment
        } else if char_at(trimmed, 0) == "[" && char_at(trimmed, tlen - 1) == "]" {
            cur_section = str_slice(trimmed, 1, tlen - 1);
        } else if cur_section == target_section {
            let eq_pos: Int = str_index_of(trimmed, "=");
            if eq_pos >= 0 {
                let k: String = toml_trim(str_slice(trimmed, 0, eq_pos));
                if k == target_key {
                    let mut val_raw: String = toml_trim(str_slice(trimmed, eq_pos + 1, tlen));
                    let vlen: Int = chars_len(val_raw);
                    if vlen >= 2 && char_at(val_raw, 0) == "\"" && char_at(val_raw, vlen - 1) == "\"" {
                        val_raw = str_slice(val_raw, 1, vlen - 1);
                    }
                    return Ok(val_raw);
                }
            }
        }
    }
    return Err("KEY_NOT_FOUND");
}

pub fn toml_get_int(doc: TomlDoc, target_section: String, target_key: String) -> Result[String, String] {
    let r: Result[String, String] = toml_get_string(doc, target_section, target_key);
    return r;
}

pub fn toml_get_bool(doc: TomlDoc, target_section: String, target_key: String) -> Result[String, String] {
    let r: Result[String, String] = toml_get_string(doc, target_section, target_key);
    return r;
}

pub fn toml_has_key(doc: TomlDoc, target_section: String, target_key: String) -> Bool {
    let r: Result[String, String] = toml_get_string(doc, target_section, target_key);
    return r.is_ok();
}
