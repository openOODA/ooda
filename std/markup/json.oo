// # JSON Parser and Serializer Module
//
// Logline: Robust, pure JSON string parsing, value extraction, and structured serialization.
//
// Setup: Provides key-based query extraction for strings, integers, and booleans, plus JSON builders.
//
// Beats:
//   1. Escape and unescape JSON string values.
//   2. Extract string fields from JSON objects.
//   3. Fluent JSON object builder.
// RULES.oot 1.4: Pure data format parser, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

pub fn json_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\"" {
            out = out + "\\\"";
        } else if c == "\\" {
            out = out + "\\\\";
        } else if c == "\n" {
            out = out + "\\n";
        } else if c == "\t" {
            out = out + "\\t";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn json_find_key(json_str: String, key: String) -> Int {
    let key_pat: String = "\"" + key + "\"";
    let kpos: Int = str_index_of(json_str, key_pat);
    if kpos < 0 {
        return -1;
    }
    let after_k: Int = kpos + chars_len(key_pat);
    let rem: String = str_slice(json_str, after_k, chars_len(json_str));
    let colon_pos: Int = str_index_of(rem, ":");
    if colon_pos < 0 {
        return -1;
    }
    let val_start: Int = after_k + colon_pos + 1;
    let n: Int = chars_len(json_str);
    let mut p: Int = val_start;
    while p < n {
        let ch: String = char_at(json_str, p);
        if ch != " " && ch != "\n" {
            return p;
        }
        p = p + 1;
    }
    return -1;
}

pub fn json_get_string(json_str: String, key: String) -> Result[String, String] {
    let p: Int = json_find_key(json_str, key);
    if p < 0 {
        return Err("KEY_NOT_FOUND");
    }
    if char_at(json_str, p) != "\"" {
        return Err("NOT_A_STRING");
    }

    let n: Int = chars_len(json_str);
    let mut end_p: Int = p + 1;
    let mut is_esc: Bool = false;
    let mut found_end: Bool = false;

    while end_p < n {
        let ch: String = char_at(json_str, end_p);
        if is_esc {
            is_esc = false;
        } else if ch == "\\" {
            is_esc = true;
        } else if ch == "\"" {
            found_end = true;
            break;
        }
        end_p = end_p + 1;
    }

    if !found_end {
        return Err("UNTERMINATED_STRING");
    }

    let val: String = str_slice(json_str, p + 1, end_p);
    return Ok(val);
}

pub fn json_get_value(json_str: String, key: String) -> Result[String, String] {
    let p: Int = json_find_key(json_str, key);
    if p < 0 {
        return Err("KEY_NOT_FOUND");
    }

    let n: Int = chars_len(json_str);
    let ch0: String = char_at(json_str, p);
    if ch0 == "\"" {
        return json_get_string(json_str, key);
    }

    let mut end_p: Int = p;
    while end_p < n {
        let ch: String = char_at(json_str, end_p);
        if ch == "," || ch == "}" || ch == "]" || ch == " " || ch == "\n" {
            break;
        }
        end_p = end_p + 1;
    }

    let raw_val: String = str_slice(json_str, p, end_p);
    return Ok(raw_val);
}

pub fn json_builder_new() -> String {
    return "{";
}

pub fn json_builder_add_string(b: String, key: String, val: String) -> String {
    let mut prefix: String = "";
    if b != "{" {
        prefix = ",";
    }
    let esc: String = json_escape(val);
    let entry: String = prefix + "\"" + key + "\":\"" + esc + "\"";
    return b + entry;
}


pub fn json_builder_add_int(b: String, key: String, val: Int) -> String {
    let mut prefix: String = "";
    if b != "{" {
        prefix = ",";
    }
    let entry: String = prefix + "\"" + key + "\":" + val.to_string();
    return b + entry;
}

pub fn json_builder_add_bool(b: String, key: String, val: Bool) -> String {
    let mut prefix: String = "";
    if b != "{" {
        prefix = ",";
    }
    let mut b_str: String = "false";
    if val {
        b_str = "true";
    }
    let entry: String = prefix + "\"" + key + "\":" + b_str;
    return b + entry;
}

pub fn json_builder_finish(b: String) -> String {
    return b + "}";
}
