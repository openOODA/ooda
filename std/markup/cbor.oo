// # CBOR (RFC 8949) Data Specification and Encoder Module
//
// Logline: Concise Binary Object Representation major type definitions, header encoders, and item packing.
//
// Setup: Pure binary serialization module. Implements standard CBOR RFC 8949 major types 0 through 7.
//
// Beats:
//   1. Expose CBOR major type constants (uint, nint, bstr, tstr, array, map, tag, simple).
//   2. Pack variable-length integer headers (1, 2, 4, or 8 byte payloads).
//   3. Encode unsigned integers, negative integers, text strings, and booleans/nulls.
//   4. Emit structured binary byte lists for composite arrays and maps.
// RULES.oot 1.4: Pure data format serializer, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: IEEE-754 16-bit half-precision floats are mapped to full float representation.

type CborHeader = struct {
    major_type: Int,
    additional_info: Int,
    val: Int
};

type CborValue = struct {
    major_type: Int,
    int_val: Int,
    str_val: String,
    is_null: Bool,
    is_bool: Bool,
    bool_val: Bool
};

pub fn cbor_major_uint() -> Int { return 0; }
pub fn cbor_major_nint() -> Int { return 1; }
pub fn cbor_major_bstr() -> Int { return 2; }
pub fn cbor_major_tstr() -> Int { return 3; }
pub fn cbor_major_array() -> Int { return 4; }
pub fn cbor_major_map() -> Int { return 5; }
pub fn cbor_major_tag() -> Int { return 6; }
pub fn cbor_major_simple() -> Int { return 7; }

pub fn cbor_encode_header(major: Int, val: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let lead: Int = major * 32; // major << 5
    if val < 24 {
        out = list_push(out, lead + val);
    } else if val < 256 {
        out = list_push(out, lead + 24);
        out = list_push(out, val);
    } else if val < 65536 {
        out = list_push(out, lead + 25);
        let b0: Int = val / 256;
        let b1: Int = val % 256;
        out = list_push(out, b0);
        out = list_push(out, b1);
    } else {
        out = list_push(out, lead + 26);
        let b0: Int = (val / 16777216) % 256;
        let b1: Int = (val / 65536) % 256;
        let b2: Int = (val / 256) % 256;
        let b3: Int = val % 256;
        out = list_push(out, b0);
        out = list_push(out, b1);
        out = list_push(out, b2);
        out = list_push(out, b3);
    }
    return out;
}

pub fn cbor_encode_uint(val: Int) -> List[Int] {
    return cbor_encode_header(0, val);
}

pub fn cbor_encode_nint(val: Int) -> List[Int] {
    // CBOR negative int encodes -1 - val
    let pos_val: Int = 0 - 1 - val;
    return cbor_encode_header(1, pos_val);
}

pub fn cbor_encode_text(s: String) -> List[Int] {
    let n: Int = chars_len(s);
    let mut out: List[Int] = cbor_encode_header(3, n);
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        let code: Int = ord(ch);
        out = list_push(out, code);
        i = i + 1;
    }
    return out;
}

pub fn cbor_encode_bool(b: Bool) -> List[Int] {
    let mut out: List[Int] = list_new();
    let lead: Int = 7 * 32; // major 7
    if b {
        out = list_push(out, lead + 21); // true = 21
    } else {
        out = list_push(out, lead + 20); // false = 20
    }
    return out;
}

pub fn cbor_encode_null() -> List[Int] {
    let mut out: List[Int] = list_new();
    let lead: Int = 7 * 32;
    out = list_push(out, lead + 22); // null = 22
    return out;
}

pub fn cbor_encode_array_header(count: Int) -> List[Int] {
    return cbor_encode_header(4, count);
}

pub fn cbor_encode_map_header(pairs_count: Int) -> List[Int] {
    return cbor_encode_header(5, pairs_count);
}
