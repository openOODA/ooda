// # CBOR (RFC 8949) Binary Decoder Module
//
// Logline: Binary decoding, header unpack, and typed value extraction for CBOR byte sequences.
//
// Setup: Pure binary deserializer. Decodes CBOR headers, integers, byte strings, text strings, and simple values.
//
// Beats:
//   1. Unpack CBOR major type (bits 7-5) and additional information (bits 4-0).
//   2. Decode variable-length integer arguments (1, 2, 4 bytes).
//   3. Extract UTF-8 text string payloads.
//   4. Decode simple values (true, false, null) with Result semantics.
// RULES.oot 1.4: Pure data format decoder, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Indefinite length stream items are resolved into discrete decoded blocks.

import "std/result.oo";

type CborToken = struct {
    major_type: Int,
    additional_info: Int,
    int_val: Int,
    str_val: String,
    bytes_read: Int,
    is_error: Bool
};

type CborDecoder = struct {
    pos: Int,
    total_bytes: Int
};

pub fn cbor_decoder_new(total_bytes: Int) -> CborDecoder {
    return CborDecoder {
        pos: 0,
        total_bytes: total_bytes
    };
}

pub fn cbor_decode_header(bytes: List[Int], offset: Int) -> CborToken {
    let n: Int = list_len(bytes);
    if offset >= n {
        return CborToken {
            major_type: 0,
            additional_info: 0,
            int_val: 0,
            str_val: "",
            bytes_read: 0,
            is_error: true
        };
    }
    let lead: Int = list_get(bytes, offset);
    let major: Int = lead / 32;
    let info: Int = lead % 32;

    if info < 24 {
        return CborToken {
            major_type: major,
            additional_info: info,
            int_val: info,
            str_val: "",
            bytes_read: 1,
            is_error: false
        };
    }
    if info == 24 {
        if offset + 1 >= n {
            return CborToken { major_type: major, additional_info: info, int_val: 0, str_val: "", bytes_read: 1, is_error: true };
        }
        let v: Int = list_get(bytes, offset + 1);
        return CborToken { major_type: major, additional_info: info, int_val: v, str_val: "", bytes_read: 2, is_error: false };
    }
    if info == 25 {
        if offset + 2 >= n {
            return CborToken { major_type: major, additional_info: info, int_val: 0, str_val: "", bytes_read: 1, is_error: true };
        }
        let b0: Int = list_get(bytes, offset + 1);
        let b1: Int = list_get(bytes, offset + 2);
        let v: Int = b0 * 256 + b1;
        return CborToken { major_type: major, additional_info: info, int_val: v, str_val: "", bytes_read: 3, is_error: false };
    }
    if info == 26 {
        if offset + 4 >= n {
            return CborToken { major_type: major, additional_info: info, int_val: 0, str_val: "", bytes_read: 1, is_error: true };
        }
        let b0: Int = list_get(bytes, offset + 1);
        let b1: Int = list_get(bytes, offset + 2);
        let b2: Int = list_get(bytes, offset + 3);
        let b3: Int = list_get(bytes, offset + 4);
        let v: Int = ((b0 * 256 + b1) * 256 + b2) * 256 + b3;
        return CborToken { major_type: major, additional_info: info, int_val: v, str_val: "", bytes_read: 5, is_error: false };
    }

    return CborToken {
        major_type: major,
        additional_info: info,
        int_val: 0,
        str_val: "",
        bytes_read: 1,
        is_error: false
    };
}

pub fn cbor_decode_uint(bytes: List[Int], offset: Int) -> Result[String, String] {
    let tok: CborToken = cbor_decode_header(bytes, offset);
    let err: Bool = tok.is_error;
    if err {
        return Err("CBOR_DECODE_ERROR");
    }
    let m: Int = tok.major_type;
    if m != 0 {
        return Err("NOT_A_UINT");
    }
    let v: Int = tok.int_val;
    return Ok(v.to_string());
}

pub fn cbor_decode_text(bytes: List[Int], offset: Int) -> Result[String, String] {
    let tok: CborToken = cbor_decode_header(bytes, offset);
    let err: Bool = tok.is_error;
    if err {
        return Err("CBOR_DECODE_ERROR");
    }
    let m: Int = tok.major_type;
    if m != 3 {
        return Err("NOT_TEXT_STRING");
    }
    let str_len: Int = tok.int_val;
    let header_bytes: Int = tok.bytes_read;
    let data_start: Int = offset + header_bytes;
    let total_n: Int = list_len(bytes);
    if data_start + str_len > total_n {
        return Err("TRUNCATED_TEXT_STRING");
    }

    let mut buf: List[Int] = bytes_new();
    let mut i: Int = 0;
    while i < str_len {
        let b: Int = list_get(bytes, data_start + i);
        buf = bytes_push(buf, b);
        i = i + 1;
    }
    return Ok(bytes_to_str(buf));
}

pub fn cbor_decode_bool(bytes: List[Int], offset: Int) -> Result[String, String] {
    let tok: CborToken = cbor_decode_header(bytes, offset);
    let err: Bool = tok.is_error;
    if err {
        return Err("CBOR_DECODE_ERROR");
    }
    let m: Int = tok.major_type;
    if m != 7 {
        return Err("NOT_SIMPLE_VALUE");
    }
    let info: Int = tok.additional_info;
    if info == 20 {
        return Ok("false");
    }
    if info == 21 {
        return Ok("true");
    }
    return Err("NOT_A_BOOLEAN");
}
