// # JSON Writer and Serializer Module
//
// Logline: Fluent JSON document builder with pretty-printing, indentation, and string escaping.
//
// Setup: Pure serialization engine. Produces formatted or compact JSON string payloads.
//
// Beats:
//   1. Build structured JSON objects and arrays incrementally.
//   2. Escape quotes, backslashes, tabs, and newlines in string values.
//   3. Support configurable multi-level indentation and compact mode.
//   4. Emit complete serialized JSON document.
// RULES.oot 1.4: Pure data format serializer, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Streaming to IO sockets is handled by caller via os/net or fs.

type JsonWriter = struct {
    buf: String,
    indent: Int,
    pretty: Bool,
    need_comma: Bool
};

pub fn json_escape_str(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\"" {
            out = out + "\\\"";
        } else if c == "\\" {
            out = out + "\\\\";
        } else if c == "\n" {
            out = out + "\\n";
        } else if c == "\t" {
            out = out + "\\t";
        } else if c == "\r" {
            out = out + "\\r";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

fn json_write_indent(mut w: JsonWriter) -> JsonWriter {
    let is_pretty: Bool = w.pretty;
    if !is_pretty {
        return w;
    }
    w.buf = w.buf + "\n";
    let target_indent: Int = w.indent;
    let mut i: Int = 0;
    while i < target_indent {
        w.buf = w.buf + "  ";
        i = i + 1;
    }
    return w;
}

pub fn json_writer_new(pretty: Bool) -> JsonWriter {
    return JsonWriter {
        buf: "",
        indent: 0,
        pretty: pretty,
        need_comma: false
    };
}

pub fn json_writer_start_object(mut w: JsonWriter) -> JsonWriter {
    let comma: Bool = w.need_comma;
    if comma {
        w.buf = w.buf + ",";
    }
    w = json_write_indent(w);
    w.buf = w.buf + "{";
    w.indent = w.indent + 1;
    w.need_comma = false;
    return w;
}

pub fn json_writer_end_object(mut w: JsonWriter) -> JsonWriter {
    let cur_indent: Int = w.indent;
    if cur_indent > 0 {
        w.indent = cur_indent - 1;
    }
    w = json_write_indent(w);
    w.buf = w.buf + "}";
    w.need_comma = true;
    return w;
}

pub fn json_writer_start_array(mut w: JsonWriter) -> JsonWriter {
    let comma: Bool = w.need_comma;
    if comma {
        w.buf = w.buf + ",";
    }
    w = json_write_indent(w);
    w.buf = w.buf + "[";
    w.indent = w.indent + 1;
    w.need_comma = false;
    return w;
}

pub fn json_writer_end_array(mut w: JsonWriter) -> JsonWriter {
    let cur_indent: Int = w.indent;
    if cur_indent > 0 {
        w.indent = cur_indent - 1;
    }
    w = json_write_indent(w);
    w.buf = w.buf + "]";
    w.need_comma = true;
    return w;
}

pub fn json_writer_key(mut w: JsonWriter, key: String) -> JsonWriter {
    let comma: Bool = w.need_comma;
    if comma {
        w.buf = w.buf + ",";
    }
    w = json_write_indent(w);
    let esc_key: String = json_escape_str(key);
    w.buf = w.buf + "\"" + esc_key + "\":";
    let is_pretty: Bool = w.pretty;
    if is_pretty {
        w.buf = w.buf + " ";
    }
    w.need_comma = false;
    return w;
}

pub fn json_writer_string(mut w: JsonWriter, val: String) -> JsonWriter {
    let comma: Bool = w.need_comma;
    if comma {
        w.buf = w.buf + ",";
    }
    let esc: String = json_escape_str(val);
    w.buf = w.buf + "\"" + esc + "\"";
    w.need_comma = true;
    return w;
}

pub fn json_writer_int(mut w: JsonWriter, val: Int) -> JsonWriter {
    let comma: Bool = w.need_comma;
    if comma {
        w.buf = w.buf + ",";
    }
    w.buf = w.buf + val.to_string();
    w.need_comma = true;
    return w;
}

pub fn json_writer_bool(mut w: JsonWriter, val: Bool) -> JsonWriter {
    let comma: Bool = w.need_comma;
    if comma {
        w.buf = w.buf + ",";
    }
    let mut b_str: String = "false";
    if val {
        b_str = "true";
    }
    w.buf = w.buf + b_str;
    w.need_comma = true;
    return w;
}

pub fn json_writer_null(mut w: JsonWriter) -> JsonWriter {
    let comma: Bool = w.need_comma;
    if comma {
        w.buf = w.buf + ",";
    }
    w.buf = w.buf + "null";
    w.need_comma = true;
    return w;
}

pub fn json_writer_finish(w: JsonWriter) -> String {
    return w.buf;
}
