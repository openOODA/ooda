// # MessagePack Format and Binary Serializer Module
//
// Logline: Compact binary object serialization for MessagePack fixints, fixstrs, arrays, and maps.
//
// Setup: Pure binary serialization module. Implements standard MessagePack binary representation.
//
// Beats:
//   1. Encode primitive nil, boolean true, and boolean false bytes.
//   2. Encode positive and negative fixint ranges (0..127 and -32..-1).
//   3. Encode variable-length 8/16/32-bit signed and unsigned integers.
//   4. Pack UTF-8 fixstr (0..31 bytes) and composite fixarray/fixmap headers.
// RULES.oot 1.4: Pure data format serializer, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Extension types (ext8..ext32) are reserved for application payloads.

type MsgPackItem = struct {
    tag: Int,
    int_val: Int,
    str_val: String,
    bool_val: Bool,
    is_nil: Bool
};

pub fn msgpack_encode_nil() -> List[Int] {
    let mut out: List[Int] = list_new();
    out = list_push(out, 192); // 0xc0
    return out;
}

pub fn msgpack_encode_bool(b: Bool) -> List[Int] {
    let mut out: List[Int] = list_new();
    if b {
        out = list_push(out, 195); // 0xc3 true
    } else {
        out = list_push(out, 194); // 0xc2 false
    }
    return out;
}

pub fn msgpack_encode_pos_fixint(n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    if n >= 0 && n <= 127 {
        out = list_push(out, n);
    } else {
        out = list_push(out, 0);
    }
    return out;
}

pub fn msgpack_encode_neg_fixint(n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    if n >= -32 && n < 0 {
        out = list_push(out, 256 + n); // 0xe0 | (n & 0x1f)
    } else {
        out = list_push(out, 255);
    }
    return out;
}

pub fn msgpack_encode_int(n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    if n >= 0 && n <= 127 {
        out = list_push(out, n);
        return out;
    }
    if n >= -32 && n < 0 {
        out = list_push(out, 256 + n);
        return out;
    }
    if n >= 0 && n <= 255 {
        out = list_push(out, 204); // 0xcc uint8
        out = list_push(out, n);
        return out;
    }
    if n >= 0 && n <= 65535 {
        out = list_push(out, 205); // 0xcd uint16
        out = list_push(out, n / 256);
        out = list_push(out, n % 256);
        return out;
    }
    if n >= 0 {
        out = list_push(out, 206); // 0xce uint32
        out = list_push(out, (n / 16777216) % 256);
        out = list_push(out, (n / 65536) % 256);
        out = list_push(out, (n / 256) % 256);
        out = list_push(out, n % 256);
        return out;
    }
    // Negative integer fallback to int32
    out = list_push(out, 210); // 0xd2 int32
    let pos_equiv: Int = 4294967296 + n;
    out = list_push(out, (pos_equiv / 16777216) % 256);
    out = list_push(out, (pos_equiv / 65536) % 256);
    out = list_push(out, (pos_equiv / 256) % 256);
    out = list_push(out, pos_equiv % 256);
    return out;
}

pub fn msgpack_encode_fixstr(s: String) -> List[Int] {
    let n: Int = chars_len(s);
    let mut out: List[Int] = list_new();
    if n <= 31 {
        out = list_push(out, 160 + n); // 0xa0 | n
    } else {
        out = list_push(out, 217); // 0xd9 str8
        out = list_push(out, n);
    }
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        out = list_push(out, ord(ch));
        i = i + 1;
    }
    return out;
}

pub fn msgpack_encode_fixarray_header(count: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    if count <= 15 {
        out = list_push(out, 144 + count); // 0x90 | count
    } else {
        out = list_push(out, 220); // 0xdc array16
        out = list_push(out, count / 256);
        out = list_push(out, count % 256);
    }
    return out;
}

pub fn msgpack_encode_fixmap_header(count: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    if count <= 15 {
        out = list_push(out, 128 + count); // 0x80 | count
    } else {
        out = list_push(out, 222); // 0xde map16
        out = list_push(out, count / 256);
        out = list_push(out, count % 256);
    }
    return out;
}
