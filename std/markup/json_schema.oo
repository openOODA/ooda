// package: std::schema::json_schema (product path under markup/)
// job: pure path A residual JSON Schema surface
// caps: none (no FS/net/env)
// residual: full JSON Schema NOT product — drafts, $ref, validation
// S: low — trivial "{}" id only; validate always false (not DESIGN complete)

fn js_bad() -> Result[String, String] {
    return Err("UNIMPLEMENTED_RESIDUAL");
}

// Residual parse of trivial empty-object schema only.
pub fn json_schema_parse(raw: String) -> Result[String, String] {
    if raw == "{}" {
        return Ok("{}");
    }
    return js_bad();
}

// Fail-closed: never claim instance validation (NOT product).
pub fn json_schema_validate(schema: String, data: String) -> Bool {
    if schema.len() >= 0 {
        if data.len() >= 0 {
            return false;
        }
    }
    return false;
}
