// # Accept the empty JSON schema
//
// Logline: json_schema_parse accepts only "{}" and json_schema_validate always returns false.
//
// Setup: This module is pure: no FS, net, or env. Drafts, $ref, and instance checks are not here.
//
// Beats:
//   1. "{}" parses as Ok("{}").
//   2. Any other raw string is UNIMPLEMENTED_RESIDUAL.
//   3. validate ignores schema and data and returns false.
//
// residual: full JSON Schema is not product; validate never claims a match

fn js_bad() -> Result[String, String] {
    return Err("UNIMPLEMENTED_RESIDUAL");
}

// Residual parse of trivial empty-object schema only.
pub fn json_schema_parse(raw: String) -> Result[String, String] {
    if raw == "{}" {
        return Ok("{}");
    }
    return js_bad();
}

// Fail-closed: never claim instance validation (NOT product).
pub fn json_schema_validate(schema: String, data: String) -> Bool {
    if schema.len() >= 0 {
        if data.len() >= 0 {
            return false;
        }
    }
    return false;
}
