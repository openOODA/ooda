// # JSON Abstract Syntax Tree Node Module
//
// Logline: Abstract Syntax Tree representation for JSON nodes with typed constructors and value inspection.
//
// Setup: Pure AST representation module. Models JSON null, boolean, integer, float, string, array, and object nodes.
//
// Beats:
//   1. Define JsonNode data structure supporting all primitive and composite JSON types.
//   2. Provide constructors for each JSON data variant.
//   3. Implement variant type discriminators and safe value accessors.
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Dynamic heterogeneous nested tree traversal relies on flat element counting and sequence indexing.

type JsonNode = struct {
    kind: String,
    str_val: String,
    int_val: Int,
    float_val: Float,
    bool_val: Bool,
    count: Int
};

pub fn json_node_null() -> JsonNode {
    return JsonNode {
        kind: "null",
        str_val: "null",
        int_val: 0,
        float_val: 0.0,
        bool_val: false,
        count: 0
    };
}

pub fn json_node_bool(v: Bool) -> JsonNode {
    let mut s: String = "false";
    if v {
        s = "true";
    }
    return JsonNode {
        kind: "bool",
        str_val: s,
        int_val: 0,
        float_val: 0.0,
        bool_val: v,
        count: 0
    };
}

pub fn json_node_int(v: Int) -> JsonNode {
    return JsonNode {
        kind: "int",
        str_val: v.to_string(),
        int_val: v,
        float_val: 0.0,
        bool_val: false,
        count: 0
    };
}

pub fn json_node_float(v: Float) -> JsonNode {
    return JsonNode {
        kind: "float",
        str_val: "",
        int_val: 0,
        float_val: v,
        bool_val: false,
        count: 0
    };
}

pub fn json_node_string(s: String) -> JsonNode {
    return JsonNode {
        kind: "string",
        str_val: s,
        int_val: 0,
        float_val: 0.0,
        bool_val: false,
        count: 0
    };
}

pub fn json_node_array(count: Int) -> JsonNode {
    return JsonNode {
        kind: "array",
        str_val: "[]",
        int_val: 0,
        float_val: 0.0,
        bool_val: false,
        count: count
    };
}

pub fn json_node_object(count: Int) -> JsonNode {
    return JsonNode {
        kind: "object",
        str_val: "{}",
        int_val: 0,
        float_val: 0.0,
        bool_val: false,
        count: count
    };
}

pub fn json_is_null(n: JsonNode) -> Bool {
    return n.kind == "null";
}

pub fn json_is_bool(n: JsonNode) -> Bool {
    return n.kind == "bool";
}

pub fn json_is_int(n: JsonNode) -> Bool {
    return n.kind == "int";
}

pub fn json_is_float(n: JsonNode) -> Bool {
    return n.kind == "float";
}

pub fn json_is_string(n: JsonNode) -> Bool {
    return n.kind == "string";
}

pub fn json_is_array(n: JsonNode) -> Bool {
    return n.kind == "array";
}

pub fn json_is_object(n: JsonNode) -> Bool {
    return n.kind == "object";
}

pub fn json_get_str(n: JsonNode) -> String {
    return n.str_val;
}

pub fn json_get_int(n: JsonNode) -> Int {
    return n.int_val;
}

pub fn json_get_float(n: JsonNode) -> Float {
    return n.float_val;
}

pub fn json_get_bool(n: JsonNode) -> Bool {
    return n.bool_val;
}

pub fn json_get_count(n: JsonNode) -> Int {
    return n.count;
}
