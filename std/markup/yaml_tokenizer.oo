// # YAML Streaming Tokenizer Module
//
// Logline: Indentation-aware lexical scanner for YAML documents, sequences, mappings, and scalars.
//
// Setup: Pure tokenizer module. Emits indentation levels, mapping keys, list items, and document markers.
//
// Beats:
//   1. Track indentation depth and line numbers across YAML documents.
//   2. Identify document boundaries (--- and ...).
//   3. Scan mapping keys, sequence indicators (- ), and scalar values.
//   4. Filter line comments (#...) and whitespace cleanly.
// RULES.oot 1.4: Pure data format parser, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Multi-line folded scalar blocks (> and |) return raw text chunks.

type YamlToken = struct {
    kind: String,
    text: String,
    indent: Int,
    line_num: Int
};

type YamlTokenizer = struct {
    src: String,
    pos: Int,
    total_len: Int,
    cur_line: Int,
    cur_indent: Int
};

pub fn yaml_is_scalar_char(ch: String) -> Bool {
    if ch == "\n" || ch == "\r" || ch == ":" || ch == "#" {
        return false;
    }
    return true;
}

pub fn yaml_tokenizer_new(src: String) -> YamlTokenizer {
    return YamlTokenizer {
        src: src,
        pos: 0,
        total_len: chars_len(src),
        cur_line: 1,
        cur_indent: 0
    };
}

pub fn yaml_tokenizer_has_more(yt: YamlTokenizer) -> Bool {
    let p: Int = yt.pos;
    let n: Int = yt.total_len;
    return p < n;
}

fn yaml_measure_indent(src: String, mut pos: Int, n: Int) -> Int {
    let mut ind: Int = 0;
    while pos < n {
        let ch: String = char_at(src, pos);
        if ch == " " {
            ind = ind + 1;
            pos = pos + 1;
        } else if ch == "\t" {
            ind = ind + 2;
            pos = pos + 1;
        } else {
            return ind;
        }
    }
    return ind;
}

pub fn yaml_tokenizer_next(mut yt: YamlTokenizer) -> YamlToken {
    let n: Int = yt.total_len;
    let mut p: Int = yt.pos;
    if p >= n {
        return YamlToken { kind: "EOF", text: "", indent: 0, line_num: yt.cur_line };
    }

    // Skip carriage returns
    if char_at(yt.src, p) == "\r" {
        p = p + 1;
        yt.pos = p;
        if p >= n {
            return YamlToken { kind: "EOF", text: "", indent: 0, line_num: yt.cur_line };
        }
    }

    // Newline handling
    if char_at(yt.src, p) == "\n" {
        let cur_l: Int = yt.cur_line;
        yt.cur_line = cur_l + 1;
        yt.pos = p + 1;
        let next_ind: Int = yaml_measure_indent(yt.src, p + 1, n);
        yt.cur_indent = next_ind;
        return YamlToken { kind: "NEWLINE", text: "\n", indent: next_ind, line_num: cur_l };
    }

    // Skip leading spaces on current line if any
    while p < n && char_at(yt.src, p) == " " {
        p = p + 1;
    }
    if p >= n {
        yt.pos = n;
        return YamlToken { kind: "EOF", text: "", indent: 0, line_num: yt.cur_line };
    }

    // Comment
    if char_at(yt.src, p) == "#" {
        let nl_pos: Int = str_index_of(str_slice(yt.src, p, n), "\n");
        if nl_pos < 0 {
            let comm: String = str_slice(yt.src, p + 1, n);
            yt.pos = n;
            return YamlToken { kind: "COMMENT", text: comm, indent: yt.cur_indent, line_num: yt.cur_line };
        }
        let comm2: String = str_slice(yt.src, p + 1, p + nl_pos);
        yt.pos = p + nl_pos;
        return YamlToken { kind: "COMMENT", text: comm2, indent: yt.cur_indent, line_num: yt.cur_line };
    }

    // Document start "---"
    if p + 3 <= n && str_slice(yt.src, p, p + 3) == "---" {
        yt.pos = p + 3;
        return YamlToken { kind: "DOC_START", text: "---", indent: 0, line_num: yt.cur_line };
    }

    // Document end "..."
    if p + 3 <= n && str_slice(yt.src, p, p + 3) == "..." {
        yt.pos = p + 3;
        return YamlToken { kind: "DOC_END", text: "...", indent: 0, line_num: yt.cur_line };
    }

    // Sequence item "- "
    if p + 2 <= n && str_slice(yt.src, p, p + 2) == "- " {
        yt.pos = p + 2;
        return YamlToken { kind: "SEQ_ITEM", text: "-", indent: yt.cur_indent, line_num: yt.cur_line };
    }

    // Scan scalar or key up to ':' or '\n'
    let mut end_p: Int = p;
    let mut has_colon: Bool = false;
    while end_p < n {
        let c: String = char_at(yt.src, end_p);
        if c == ":" {
            has_colon = true;
            break;
        }
        if c == "\n" || c == "\r" || c == "#" {
            break;
        }
        end_p = end_p + 1;
    }

    if has_colon {
        let key_str: String = str_slice(yt.src, p, end_p);
        yt.pos = end_p + 1; // skip ':'
        return YamlToken { kind: "KEY", text: key_str, indent: yt.cur_indent, line_num: yt.cur_line };
    }

    let raw_val: String = str_slice(yt.src, p, end_p);
    yt.pos = end_p;
    return YamlToken { kind: "SCALAR", text: raw_val, indent: yt.cur_indent, line_num: yt.cur_line };
}
