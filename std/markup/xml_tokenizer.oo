// # XML 1.0 Streaming Tokenizer Module
//
// Logline: Event-driven lexical scanner emitting structured tokens for XML tags, text, CDATA, and comments.
//
// Setup: Pure tokenizer module. Scans XML documents sequentially without constructing an in-memory DOM tree.
//
// Beats:
//   1. Define XmlToken and XmlTokenizer state structures.
//   2. Scan opening, closing, and self-closing XML element tags.
//   3. Handle CDATA blocks (<![CDATA[...]]>) and comments (<!--...-->).
//   4. Implement XML entity escaping and unescaping (&lt;, &gt;, &amp;, &quot;, &apos;).
// RULES.oot 1.4: Pure data format parser, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: XML DTD validation and XML namespaces (xmlns) are not expanded.

import "std/str.oo";

type XmlToken = struct {
    kind: String,
    name: String,
    content: String,
    pos: Int
};

type XmlTokenizer = struct {
    src: String,
    pos: Int,
    total_len: Int
};

pub fn xml_tokenizer_new(src: String) -> XmlTokenizer {
    return XmlTokenizer {
        src: src,
        pos: 0,
        total_len: chars_len(src)
    };
}

pub fn xml_tokenizer_has_more(t: XmlTokenizer) -> Bool {
    let p: Int = t.pos;
    let n: Int = t.total_len;
    return p < n;
}

pub fn xml_tokenizer_next(mut t: XmlTokenizer) -> XmlToken {
    let n: Int = t.total_len;
    let p: Int = t.pos;
    if p >= n {
        return XmlToken { kind: "EOF", name: "", content: "", pos: p };
    }

    let ch: String = char_at(t.src, p);
    if ch == "<" {
        // Comment: <!-- ... -->
        if p + 4 <= n {
            if str_slice(t.src, p, p + 4) == "<!--" {
                let close_idx: Int = str_index_of(str_slice(t.src, p + 4, n), "-->");
                if close_idx < 0 {
                    t.pos = n;
                    return XmlToken { kind: "ERROR", name: "UNCLOSED_COMMENT", content: "", pos: p };
                }
                let body: String = str_slice(t.src, p + 4, p + 4 + close_idx);
                t.pos = p + 4 + close_idx + 3;
                return XmlToken { kind: "COMMENT", name: "", content: body, pos: p };
            }
        }

        // CDATA: <![CDATA[ ... ]]>
        if p + 9 <= n {
            if str_slice(t.src, p, p + 9) == "<![CDATA[" {
                let end_cdata: Int = str_index_of(str_slice(t.src, p + 9, n), "]]>");
                if end_cdata < 0 {
                    t.pos = n;
                    return XmlToken { kind: "ERROR", name: "UNCLOSED_CDATA", content: "", pos: p };
                }
                let body2: String = str_slice(t.src, p + 9, p + 9 + end_cdata);
                t.pos = p + 9 + end_cdata + 3;
                return XmlToken { kind: "CDATA", name: "", content: body2, pos: p };
            }
        }

        // End tag: </tag>
        if p + 2 <= n {
            if str_slice(t.src, p, p + 2) == "</" {
                let gt: Int = str_index_of(str_slice(t.src, p + 2, n), ">");
                if gt < 0 {
                    t.pos = n;
                    return XmlToken { kind: "ERROR", name: "UNCLOSED_TAG", content: "", pos: p };
                }
                let tag_name: String = str_slice(t.src, p + 2, p + 2 + gt);
                t.pos = p + 2 + gt + 1;
                return XmlToken { kind: "END_TAG", name: tag_name, content: "", pos: p };
            }
        }

        // Open or self-closing tag
        let gt2: Int = str_index_of(str_slice(t.src, p + 1, n), ">");
        if gt2 < 0 {
            t.pos = n;
            return XmlToken { kind: "ERROR", name: "UNCLOSED_TAG", content: "", pos: p };
        }
        let tag_body: String = str_slice(t.src, p + 1, p + 1 + gt2);
        t.pos = p + 1 + gt2 + 1;
        let body_len: Int = chars_len(tag_body);
        if body_len > 0 {
            if char_at(tag_body, body_len - 1) == "/" {
                let actual_name: String = str_slice(tag_body, 0, body_len - 1);
                return XmlToken { kind: "SELF_CLOSING", name: actual_name, content: "", pos: p };
            }
        }
        return XmlToken { kind: "START_TAG", name: tag_body, content: "", pos: p };
    }

    // Text content up to next '<'
    let next_lt: Int = str_index_of(str_slice(t.src, p, n), "<");
    if next_lt < 0 {
        let txt: String = str_slice(t.src, p, n);
        t.pos = n;
        return XmlToken { kind: "TEXT", name: "", content: txt, pos: p };
    }
    let txt2: String = str_slice(t.src, p, p + next_lt);
    t.pos = p + next_lt;
    return XmlToken { kind: "TEXT", name: "", content: txt2, pos: p };
}

pub fn xml_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "<" {
            out = out + "&lt;";
        } else if c == ">" {
            out = out + "&gt;";
        } else if c == "&" {
            out = out + "&amp;";
        } else if c == "\"" {
            out = out + "&quot;";
        } else if c == "'" {
            out = out + "&apos;";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn xml_unescape(s: String) -> String {
    let mut res: String = s;
    if res.contains("&lt;") {
        res = str_replace(res, "&lt;", "<");
    }
    if res.contains("&gt;") {
        res = str_replace(res, "&gt;", ">");
    }
    if res.contains("&quot;") {
        res = str_replace(res, "&quot;", "\"");
    }
    if res.contains("&apos;") {
        res = str_replace(res, "&apos;", "'");
    }
    if res.contains("&amp;") {
        res = str_replace(res, "&amp;", "&");
    }
    return res;
}
