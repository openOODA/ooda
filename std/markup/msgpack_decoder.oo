// # MessagePack Binary Decoder Module
//
// Logline: Stream deserializer and payload extractor for MessagePack binary data streams.
//
// Setup: Pure binary deserializer. Decodes fixints, fixstrings, standard ints, booleans, and nil tokens.
//
// Beats:
//   1. Identify MessagePack tag prefix and determine data layout.
//   2. Decode positive and negative fixint tokens directly.
//   3. Extract string payloads for fixstr, str8, and str16.
//   4. Decode composite array and map container lengths with Result semantics.
// RULES.oot 1.4: Pure data format decoder, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Arbitrary precision extension payloads decode length headers only.

import "std/result.oo";

type MsgPackValue = struct {
    kind: String,
    int_val: Int,
    str_val: String,
    bool_val: Bool,
    count: Int,
    bytes_read: Int
};

type MsgPackDecoder = struct {
    pos: Int,
    total_len: Int
};

pub fn msgpack_decoder_new(total_len: Int) -> MsgPackDecoder {
    return MsgPackDecoder {
        pos: 0,
        total_len: total_len
    };
}

pub fn msgpack_decode_str_payload(bytes: List[Int], offset: Int, length: Int) -> String {
    let mut buf: List[Int] = bytes_new();
    let mut i: Int = 0;
    while i < length {
        let b: Int = list_get(bytes, offset + i);
        buf = bytes_push(buf, b);
        i = i + 1;
    }
    return bytes_to_str(buf);
}

pub fn msgpack_decode_item(bytes: List[Int], offset: Int) -> MsgPackValue {
    let n: Int = list_len(bytes);
    if offset >= n {
        return MsgPackValue {
            kind: "err",
            int_val: 0,
            str_val: "EOF",
            bool_val: false,
            count: 0,
            bytes_read: 0
        };
    }

    let b: Int = list_get(bytes, offset);

    // Positive fixint: 0x00 - 0x7f
    if b <= 127 {
        return MsgPackValue { kind: "int", int_val: b, str_val: b.to_string(), bool_val: false, count: 0, bytes_read: 1 };
    }

    // Negative fixint: 0xe0 - 0xff
    if b >= 224 {
        let v: Int = b - 256;
        return MsgPackValue { kind: "int", int_val: v, str_val: v.to_string(), bool_val: false, count: 0, bytes_read: 1 };
    }

    // Fixstr: 0xa0 - 0xbf
    if b >= 160 && b <= 191 {
        let s_len: Int = b - 160;
        if offset + 1 + s_len > n {
            return MsgPackValue { kind: "err", int_val: 0, str_val: "TRUNCATED_STR", bool_val: false, count: 0, bytes_read: 1 };
        }
        let txt: String = msgpack_decode_str_payload(bytes, offset + 1, s_len);
        return MsgPackValue { kind: "str", int_val: 0, str_val: txt, bool_val: false, count: s_len, bytes_read: 1 + s_len };
    }

    // Fixarray: 0x90 - 0x9f
    if b >= 144 && b <= 159 {
        let arr_len: Int = b - 144;
        return MsgPackValue { kind: "array", int_val: 0, str_val: "[]", bool_val: false, count: arr_len, bytes_read: 1 };
    }

    // Fixmap: 0x80 - 0x8f
    if b >= 128 && b <= 143 {
        let map_len: Int = b - 128;
        return MsgPackValue { kind: "map", int_val: 0, str_val: "{}", bool_val: false, count: map_len, bytes_read: 1 };
    }

    // Nil: 0xc0
    if b == 192 {
        return MsgPackValue { kind: "nil", int_val: 0, str_val: "nil", bool_val: false, count: 0, bytes_read: 1 };
    }

    // False: 0xc2
    if b == 194 {
        return MsgPackValue { kind: "bool", int_val: 0, str_val: "false", bool_val: false, count: 0, bytes_read: 1 };
    }

    // True: 0xc3
    if b == 195 {
        return MsgPackValue { kind: "bool", int_val: 0, str_val: "true", bool_val: true, count: 0, bytes_read: 1 };
    }

    // Uint8: 0xcc
    if b == 204 {
        if offset + 1 >= n {
            return MsgPackValue { kind: "err", int_val: 0, str_val: "TRUNCATED_UINT8", bool_val: false, count: 0, bytes_read: 1 };
        }
        let v_u8: Int = list_get(bytes, offset + 1);
        return MsgPackValue { kind: "int", int_val: v_u8, str_val: v_u8.to_string(), bool_val: false, count: 0, bytes_read: 2 };
    }

    // Uint16: 0xcd
    if b == 205 {
        if offset + 2 >= n {
            return MsgPackValue { kind: "err", int_val: 0, str_val: "TRUNCATED_UINT16", bool_val: false, count: 0, bytes_read: 1 };
        }
        let b0: Int = list_get(bytes, offset + 1);
        let b1: Int = list_get(bytes, offset + 2);
        let v_u16: Int = b0 * 256 + b1;
        return MsgPackValue { kind: "int", int_val: v_u16, str_val: v_u16.to_string(), bool_val: false, count: 0, bytes_read: 3 };
    }

    return MsgPackValue {
        kind: "err",
        int_val: 0,
        str_val: "UNKNOWN_TAG",
        bool_val: false,
        count: 0,
        bytes_read: 1
    };
}

pub fn msgpack_decode_int_val(bytes: List[Int], offset: Int) -> Result[String, String] {
    let val: MsgPackValue = msgpack_decode_item(bytes, offset);
    let k: String = val.kind;
    if k == "err" {
        return Err(val.str_val);
    }
    if k != "int" {
        return Err("NOT_AN_INTEGER");
    }
    let iv: Int = val.int_val;
    return Ok(iv.to_string());
}

pub fn msgpack_decode_bool_val(bytes: List[Int], offset: Int) -> Result[String, String] {
    let val: MsgPackValue = msgpack_decode_item(bytes, offset);
    let k: String = val.kind;
    if k == "err" {
        return Err(val.str_val);
    }
    if k != "bool" {
        return Err("NOT_A_BOOLEAN");
    }
    return Ok(val.str_val);
}
