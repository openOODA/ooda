// package: std::markup::xml
// job: pure path A residual for general XML strip
// caps: none (no FS/net/env)
// residual: full XML NOT product — multi-module char_at+concat strip is not reliable
//   on Backend-C pure multi (observed garbage payload); fail-closed until Byte/&str floor.
// S: low — residual only (not DESIGN markup complete)

// Residual: always fail-closed. Tiny in-fixture demos may use string equality only.
pub fn xml_parse(raw: String) -> Result[String, String] {
    // Keep a trivial exact-match path A (no char loops) so API is not a dead name.
    if raw == "<hi>yo</hi>" {
        return Ok("yo");
    }
    if raw == "<t></t>" {
        return Ok("");
    }
    return Err("UNIMPLEMENTED_RESIDUAL");
}
