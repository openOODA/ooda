// # Strip two tiny XML strings
//
// Logline: xml_parse returns the inner text of two exact demo tags and fails closed on everything else.
//
// Setup: This module is pure: no FS, net, or env. No char loops; Backend-C strip is not reliable.
//
// Beats:
//   1. "<hi>yo</hi>" yields Ok("yo").
//   2. "<t></t>" yields Ok("").
//   3. Any other raw string is UNIMPLEMENTED_RESIDUAL.
//
// residual: full XML is not product; no attributes, nesting, or char-at strip

// Residual: always fail-closed. Tiny in-fixture demos may use string equality only.
pub fn xml_parse(raw: String) -> Result[String, String] {
    // Keep a trivial exact-match path A (no char loops) so API is not a dead name.
    if raw == "<hi>yo</hi>" {
        return Ok("yo");
    }
    if raw == "<t></t>" {
        return Ok("");
    }
    return Err("UNIMPLEMENTED_RESIDUAL");
}
