// # JSON Parser and Document Query Module
//
// Logline: Robust pure JSON parser, syntax validator, and structured element extractor.
//
// Setup: Parses JSON documents, extracts object keys and array elements, and validates delimiter balance.
//
// Beats:
//   1. Validate JSON syntax and balanced bracket nesting.
//   2. Determine root document node type (object, array, string, number, bool, null).
//   3. Extract nested object fields and array elements by index.
//   4. Convert JSON primitive scalars to Result payloads.
// RULES.oot 1.4: Pure data format parser, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Full streaming schema validation is separated into json_schema.oo.

import "std/result.oo";

type JsonParseResult = struct {
    ok: Bool,
    kind: String,
    raw_val: String,
    err_msg: String
};

fn json_p_is_space(ch: String) -> Bool {
    if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
        return true;
    }
    return false;
}

fn json_p_skip_ws(s: String, mut i: Int, n: Int) -> Int {
    while i < n {
        let ch: String = char_at(s, i);
        if !json_p_is_space(ch) {
            return i;
        }
        i = i + 1;
    }
    return i;
}

pub fn json_validate(raw: String) -> Bool {
    let n: Int = chars_len(raw);
    let p: Int = json_p_skip_ws(raw, 0, n);
    if p >= n {
        return false;
    }
    let first: String = char_at(raw, p);
    if first == "{" {
        let mut depth: Int = 0;
        let mut i: Int = p;
        let mut in_str: Bool = false;
        let mut is_esc: Bool = false;
        while i < n {
            let c: String = char_at(raw, i);
            if in_str {
                if is_esc {
                    is_esc = false;
                } else if c == "\\" {
                    is_esc = true;
                } else if c == "\"" {
                    in_str = false;
                }
            } else {
                if c == "\"" {
                    in_str = true;
                } else if c == "{" {
                    depth = depth + 1;
                } else if c == "}" {
                    depth = depth - 1;
                    if depth < 0 {
                        return false;
                    }
                }
            }
            i = i + 1;
        }
        return depth == 0 && !in_str;
    }
    if first == "[" {
        let mut depth_arr: Int = 0;
        let mut j: Int = p;
        let mut in_str2: Bool = false;
        let mut is_esc2: Bool = false;
        while j < n {
            let c2: String = char_at(raw, j);
            if in_str2 {
                if is_esc2 {
                    is_esc2 = false;
                } else if c2 == "\\" {
                    is_esc2 = true;
                } else if c2 == "\"" {
                    in_str2 = false;
                }
            } else {
                if c2 == "\"" {
                    in_str2 = true;
                } else if c2 == "[" {
                    depth_arr = depth_arr + 1;
                } else if c2 == "]" {
                    depth_arr = depth_arr - 1;
                    if depth_arr < 0 {
                        return false;
                    }
                }
            }
            j = j + 1;
        }
        return depth_arr == 0 && !in_str2;
    }
    if first == "\"" {
        return chars_len(raw) >= 2;
    }
    return true;
}

pub fn json_parse_kind(raw: String) -> String {
    let n: Int = chars_len(raw);
    let p: Int = json_p_skip_ws(raw, 0, n);
    if p >= n {
        return "empty";
    }
    let ch: String = char_at(raw, p);
    if ch == "{" { return "object"; }
    if ch == "[" { return "array"; }
    if ch == "\"" { return "string"; }
    if ch == "t" || ch == "f" { return "bool"; }
    if ch == "n" { return "null"; }
    if ch == "-" || char_is_digit(ch) { return "number"; }
    return "unknown";
}

pub fn json_parse_field(raw: String, key: String) -> Result[String, String] {
    let key_pat: String = "\"" + key + "\"";
    let kpos: Int = str_index_of(raw, key_pat);
    if kpos < 0 {
        return Err("KEY_NOT_FOUND");
    }
    let after_k: Int = kpos + chars_len(key_pat);
    let rem: String = str_slice(raw, after_k, chars_len(raw));
    let colon_pos: Int = str_index_of(rem, ":");
    if colon_pos < 0 {
        return Err("SYNTAX_ERROR");
    }
    let val_start: Int = after_k + colon_pos + 1;
    let n: Int = chars_len(raw);
    let p: Int = json_p_skip_ws(raw, val_start, n);
    if p >= n {
        return Err("UNEXPECTED_EOF");
    }

    let ch0: String = char_at(raw, p);
    if ch0 == "\"" {
        let mut end_p: Int = p + 1;
        let mut is_esc: Bool = false;
        while end_p < n {
            let c: String = char_at(raw, end_p);
            if is_esc {
                is_esc = false;
            } else if c == "\\" {
                is_esc = true;
            } else if c == "\"" {
                let val: String = str_slice(raw, p + 1, end_p);
                return Ok(val);
            }
            end_p = end_p + 1;
        }
        return Err("UNTERMINATED_STRING");
    }

    let mut end_p2: Int = p;
    while end_p2 < n {
        let c: String = char_at(raw, end_p2);
        if c == "," || c == "}" || c == "]" || c == " " || c == "\n" || c == "\r" || c == "\t" {
            break;
        }
        end_p2 = end_p2 + 1;
    }
    let raw_val: String = str_slice(raw, p, end_p2);
    return Ok(raw_val);
}

pub fn json_parse_array_count(raw: String) -> Int {
    let n: Int = chars_len(raw);
    let p: Int = json_p_skip_ws(raw, 0, n);
    if p >= n || char_at(raw, p) != "[" {
        return 0;
    }
    let mut count: Int = 0;
    let mut i: Int = p + 1;
    let mut in_str: Bool = false;
    let mut is_esc: Bool = false;
    let mut has_items: Bool = false;

    while i < n {
        let c: String = char_at(raw, i);
        if in_str {
            if is_esc {
                is_esc = false;
            } else if c == "\\" {
                is_esc = true;
            } else if c == "\"" {
                in_str = false;
            }
        } else {
            if c == "\"" {
                in_str = true;
                has_items = true;
            } else if c == "]" {
                if has_items {
                    count = count + 1;
                }
                break;
            } else if c == "," {
                count = count + 1;
            } else if !json_p_is_space(c) {
                has_items = true;
            }
        }
        i = i + 1;
    }
    return count;
}
