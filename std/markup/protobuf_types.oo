// # Protocol Buffers Schema and Value Types Module
//
// Logline: Field descriptors, type mappings, and runtime value containers for Protocol Buffers messages.
//
// Setup: Pure type descriptor module. Defines protobuf schema fields and maps proto types to wire formats.
//
// Beats:
//   1. Define PbFieldDesc structure for message field metadata.
//   2. Define PbFieldValue container for typed field values.
//   3. Construct int, string, and boolean protobuf field value instances.
//   4. Map proto types ("int32", "string", "bytes", "bool") to wire type IDs.
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Dynamic proto reflection without compiled descriptor sets is handled via manual table definitions.

type PbFieldDesc = struct {
    field_number: Int,
    name: String,
    field_type: String,
    is_repeated: Bool
};

type PbFieldValue = struct {
    field_number: Int,
    wire_type: Int,
    int_val: Int,
    str_val: String,
    bool_val: Bool
};

pub fn pb_field_desc_new(number: Int, name: String, ftype: String, repeated: Bool) -> PbFieldDesc {
    return PbFieldDesc {
        field_number: number,
        name: name,
        field_type: ftype,
        is_repeated: repeated
    };
}

pub fn pb_wire_type_for_proto_type(proto_type: String) -> Int {
    if proto_type == "int32" || proto_type == "int64" || proto_type == "uint32" || proto_type == "bool" {
        return 0; // Varint
    }
    if proto_type == "fixed64" || proto_type == "double" {
        return 1; // 64-bit
    }
    if proto_type == "string" || proto_type == "bytes" || proto_type == "message" {
        return 2; // Length-delimited
    }
    if proto_type == "fixed32" || proto_type == "float" {
        return 5; // 32-bit
    }
    return 2; // Default to length-delimited
}

pub fn pb_field_value_int(number: Int, val: Int) -> PbFieldValue {
    return PbFieldValue {
        field_number: number,
        wire_type: 0,
        int_val: val,
        str_val: "",
        bool_val: false
    };
}

pub fn pb_field_value_str(number: Int, s: String) -> PbFieldValue {
    return PbFieldValue {
        field_number: number,
        wire_type: 2,
        int_val: 0,
        str_val: s,
        bool_val: false
    };
}

pub fn pb_field_value_bool(number: Int, b: Bool) -> PbFieldValue {
    let mut iv: Int = 0;
    if b {
        iv = 1;
    }
    return PbFieldValue {
        field_number: number,
        wire_type: 0,
        int_val: iv,
        str_val: "",
        bool_val: b
    };
}

pub fn pb_field_get_type(desc: PbFieldDesc) -> String {
    return desc.field_type;
}

pub fn pb_field_get_number(desc: PbFieldDesc) -> Int {
    return desc.field_number;
}
