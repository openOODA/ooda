// package: std::markup::yaml
// job: pure path A single-line `key: value` YAML subset
// caps: none (no FS/net/env)
// residual: full YAML NOT product — nesting, lists, multi-line, anchors, types
// S: low — single-line bare mapping only (not DESIGN markup complete)

fn yaml_bad() -> Result[String, String] {
    return Err("UNIMPLEMENTED_RESIDUAL");
}

fn yaml_skip_space(raw: String, i: Int) -> Int {
    let n = chars_len(raw);
    let mut j = i;
    while j < n {
        if char_is_space(char_at(raw, j)) {
            j = j + 1;
        } else {
            return j;
        }
    }
    return j;
}

fn yaml_is_key_char(ch: String) -> Bool {
    if char_is_alpha(ch) {
        return true;
    }
    if char_is_digit(ch) {
        return true;
    }
    if ch == "_" {
        return true;
    }
    if ch == "-" {
        return true;
    }
    return false;
}

// Real: one line `key: value` (bare scalar). Ok payload "key\tvalue".
// Residual: documents/lists/quotes/indent → UNIMPLEMENTED_RESIDUAL.
pub fn yaml_parse(raw: String) -> Result[String, String] {
    if raw.len() == 0 {
        return yaml_bad();
    }
    if raw.contains("\n") {
        return yaml_bad();
    }
    if raw.contains("\r") {
        return yaml_bad();
    }
    if raw.contains("---") {
        return yaml_bad();
    }
    if raw.contains("...") {
        return yaml_bad();
    }
    if raw.contains("- ") {
        return yaml_bad();
    }
    if raw.contains("[") {
        return yaml_bad();
    }
    if raw.contains("{") {
        return yaml_bad();
    }
    let n = chars_len(raw);
    let mut colon = -1;
    let mut i = 0;
    while i < n {
        if char_at(raw, i) == ":" {
            if colon < 0 {
                colon = i;
            }
        }
        i = i + 1;
    }
    if colon < 0 {
        return yaml_bad();
    }
    let ks = yaml_skip_space(raw, 0);
    let mut key = "";
    let mut ki = ks;
    let mut seen_space = 0;
    while ki < colon {
        let ch = char_at(raw, ki);
        if char_is_space(ch) {
            seen_space = 1;
        } else {
            if seen_space == 1 {
                return yaml_bad();
            }
            if yaml_is_key_char(ch) {
                key = key + ch;
            } else {
                return yaml_bad();
            }
        }
        ki = ki + 1;
    }
    if key.len() == 0 {
        return yaml_bad();
    }
    let vs = yaml_skip_space(raw, colon + 1);
    if vs >= n {
        return yaml_bad();
    }
    if char_at(raw, vs) == "\"" {
        return yaml_bad();
    }
    if char_at(raw, vs) == "'" {
        return yaml_bad();
    }
    let mut val = "";
    let mut bi = vs;
    while bi < n {
        let ch2 = char_at(raw, bi);
        if char_is_space(ch2) {
            if yaml_skip_space(raw, bi) != n {
                val = val + ch2;
                bi = bi + 1;
            } else {
                bi = n;
            }
        } else {
            val = val + ch2;
            bi = bi + 1;
        }
    }
    if val.len() == 0 {
        return yaml_bad();
    }
    return Ok(key + "\t" + val);
}
