// # Particle Primitive & Kinematic Simulation
//
// Logline: Simulates individual particle life cycles, kinematics, damping, and normalized age fade progressions.
//
// Setup: Single-particle kinematic integration and particle pool tracking.
//
// Beats:
//   1. Represent 3D particle state (positions, velocities, accelerations, sizes, RGBA colors, lifetimes).
//   2. Integrate kinematic motion with velocity and acceleration step updates.
//   3. Compute normalized lifetime progress ratios (0.0 to 1.0) and death conditions.

// -------------------------------------------------------------------
// Particle Data Structure
// -------------------------------------------------------------------

pub type Particle = struct {
    x: Float,
    y: Float,
    z: Float,
    vx: Float,
    vy: Float,
    vz: Float,
    ax: Float,
    ay: Float,
    az: Float,
    size: Float,
    alpha: Float,
    r: Float,
    g: Float,
    b: Float,
    age: Float,
    life: Float,
    active: Int
};

pub type ParticlePool = struct {
    capacity: Int,
    active_count: Int
};

// -------------------------------------------------------------------
// Constructors & Pool Management
// -------------------------------------------------------------------

pub fn particle_new(x: Float, y: Float, z: Float, vx: Float, vy: Float, vz: Float, life: Float) -> Particle {
    return Particle {
        x: x,
        y: y,
        z: z,
        vx: vx,
        vy: vy,
        vz: vz,
        ax: 0.0,
        ay: 0.0,
        az: 0.0,
        size: 1.0,
        alpha: 1.0,
        r: 1.0,
        g: 1.0,
        b: 1.0,
        age: 0.0,
        life: life,
        active: 1
    };
}

pub fn particle_inactive() -> Particle {
    return Particle {
        x: 0.0,
        y: 0.0,
        z: 0.0,
        vx: 0.0,
        vy: 0.0,
        vz: 0.0,
        ax: 0.0,
        ay: 0.0,
        az: 0.0,
        size: 0.0,
        alpha: 0.0,
        r: 0.0,
        g: 0.0,
        b: 0.0,
        age: 0.0,
        life: 0.0,
        active: 0
    };
}

pub fn particle_pool_new(capacity: Int) -> ParticlePool {
    return ParticlePool {
        capacity: capacity,
        active_count: 0
    };
}

// -------------------------------------------------------------------
// Lifetime & Kinematics Update
// -------------------------------------------------------------------

pub fn particle_is_alive(p: &Particle) -> Int {
    if (p).active == 0 {
        return 0;
    }
    if (p).age >= (p).life {
        return 0;
    }
    return 1;
}

pub fn particle_progress(p: &Particle) -> Float {
    if (p).life <= 0.00001 {
        return 1.0;
    }
    let ratio: Float = (p).age / (p).life;
    if ratio > 1.0 { return 1.0; }
    if ratio < 0.0 { return 0.0; }
    return ratio;
}

pub fn particle_step(p: Particle, dt: Float) -> Particle {
    if (p).active == 0 {
        return p;
    }
    let new_age: Float = (p).age + dt;
    if new_age >= (p).life {
        return particle_inactive();
    }

    let nvx: Float = (p).vx + ((p).ax * dt);
    let nvy: Float = (p).vy + ((p).ay * dt);
    let nvz: Float = (p).vz + ((p).az * dt);

    let nx: Float = (p).x + (nvx * dt);
    let ny: Float = (p).y + (nvy * dt);
    let nz: Float = (p).z + (nvz * dt);

    // Alpha fades out linearly with age
    let progress: Float = new_age / (p).life;
    let fade_alpha: Float = 1.0 - progress;

    return Particle {
        x: nx,
        y: ny,
        z: nz,
        vx: nvx,
        vy: nvy,
        vz: nvz,
        ax: (p).ax,
        ay: (p).ay,
        az: (p).az,
        size: (p).size,
        alpha: fade_alpha,
        r: (p).r,
        g: (p).g,
        b: (p).b,
        age: new_age,
        life: (p).life,
        active: 1
    };
}
