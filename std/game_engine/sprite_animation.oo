// # 2D Sprite Animation & Playback States
//
// Logline: Drives sprite frame progression, timeline accumulators, playback modes (Loop, Once, PingPong), and playback state.
//
// Setup: Frame timing and loop controllers for 2D animated sprites.
//
// Beats:
//   1. Define frame UV coordinates and sprite animation state descriptors.
//   2. Support 3 playback loop modes: Continuous Loop, Play Once, and Ping-Pong.
//   3. Advance animation timelines with delta time and evaluate frame transitions.

// -------------------------------------------------------------------
// Animation Loop Modes
// -------------------------------------------------------------------

pub fn anim_loop_mode_loop() -> Int { return 0; }
pub fn anim_loop_mode_once() -> Int { return 1; }
pub fn anim_loop_mode_pingpong() -> Int { return 2; }

// -------------------------------------------------------------------
// Animation Types
// -------------------------------------------------------------------

pub type AnimationFrame = struct {
    u0: Float,
    v0: Float,
    u1: Float,
    v1: Float,
    duration_sec: Float,
};

pub type SpriteAnimation = struct {
    anim_id: Int,
    frame_count: Int,
    fps: Float,
    loop_mode: Int,
    current_frame: Int,
    elapsed: Float,
    is_playing: Int,
    is_finished: Int,
    direction: Int, // 1 = forward, -1 = reverse
};

// -------------------------------------------------------------------
// Constructors & Controls
// -------------------------------------------------------------------

pub fn sprite_animation_new(anim_id: Int, frame_count: Int, fps: Float, loop_mode: Int) -> SpriteAnimation {
    return SpriteAnimation {
        anim_id: anim_id,
        frame_count: frame_count,
        fps: fps,
        loop_mode: loop_mode,
        current_frame: 0,
        elapsed: 0.0,
        is_playing: 1,
        is_finished: 0,
        direction: 1,
    };
}

pub fn sprite_animation_play(anim: SpriteAnimation) -> SpriteAnimation {
    return SpriteAnimation {
        anim_id: (anim).anim_id,
        frame_count: (anim).frame_count,
        fps: (anim).fps,
        loop_mode: (anim).loop_mode,
        current_frame: (anim).current_frame,
        elapsed: (anim).elapsed,
        is_playing: 1,
        is_finished: 0,
        direction: (anim).direction,
    };
}

pub fn sprite_animation_pause(anim: SpriteAnimation) -> SpriteAnimation {
    return SpriteAnimation {
        anim_id: (anim).anim_id,
        frame_count: (anim).frame_count,
        fps: (anim).fps,
        loop_mode: (anim).loop_mode,
        current_frame: (anim).current_frame,
        elapsed: (anim).elapsed,
        is_playing: 0,
        is_finished: (anim).is_finished,
        direction: (anim).direction,
    };
}

pub fn sprite_animation_reset(anim: SpriteAnimation) -> SpriteAnimation {
    return SpriteAnimation {
        anim_id: (anim).anim_id,
        frame_count: (anim).frame_count,
        fps: (anim).fps,
        loop_mode: (anim).loop_mode,
        current_frame: 0,
        elapsed: 0.0,
        is_playing: (anim).is_playing,
        is_finished: 0,
        direction: 1,
    };
}

// -------------------------------------------------------------------
// Animation Update Step
// -------------------------------------------------------------------

pub fn sprite_animation_update(anim: SpriteAnimation, dt: Float) -> SpriteAnimation {
    if (anim).is_playing == 0 {
        return anim;
    }
    if (anim).is_finished == 1 {
        return anim;
    }
    if (anim).frame_count <= 1 {
        return anim;
    }

    let frame_duration: Float = if (anim).fps > 0.0 { 1.0 / (anim).fps } else { 0.1 };
    let mut new_elapsed: Float = (anim).elapsed + dt;
    let mut frame: Int = (anim).current_frame;
    let mut dir: Int = (anim).direction;
    let mut finished: Int = 0;

    while new_elapsed >= frame_duration {
        new_elapsed = new_elapsed - frame_duration;
        frame = frame + dir;

        // Loop mode handling
        if (anim).loop_mode == 0 { // Loop
            if frame >= (anim).frame_count {
                frame = 0;
            }
        } else {
            if (anim).loop_mode == 1 { // Once
                if frame >= (anim).frame_count {
                    frame = (anim).frame_count - 1;
                    finished = 1;
                }
            } else { // PingPong
                if frame >= (anim).frame_count {
                    frame = (anim).frame_count - 2;
                    dir = 0 - 1;
                } else {
                    if frame < 0 {
                        frame = 1;
                        dir = 1;
                    }
                }
            }
        }
    }

    return SpriteAnimation {
        anim_id: (anim).anim_id,
        frame_count: (anim).frame_count,
        fps: (anim).fps,
        loop_mode: (anim).loop_mode,
        current_frame: frame,
        elapsed: new_elapsed,
        is_playing: if finished == 1 { 0 } else { 1 },
        is_finished: finished,
        direction: dir,
    };
}
