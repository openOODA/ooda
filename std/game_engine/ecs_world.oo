// # ECS World State & Container Lifecycle
//
// Logline: Coordinates entity managers, system execution schedulers, fixed delta time accumulators, and global state.
//
// Setup: Root ECS world container importing ecs_component.oo, ecs_entity.oo, ecs_query.oo, and ecs_system.oo.
//
// Beats:
//   1. Encapsulate entity managers, system schedulers, and clock state in an EcsWorld record.
//   2. Provide entity spawning, destruction, and capacity check operations.
//   3. Advance simulation cycles across distinct update and physics ticks.

import "./ecs_component.oo";
import "./ecs_entity.oo";
import "./ecs_query.oo";
import "./ecs_system.oo";

// -------------------------------------------------------------------
// ECS World Container Definition
// -------------------------------------------------------------------

pub type EcsWorld = struct {
    entity_mgr: EntityManager,
    scheduler: SystemScheduler,
    delta_time: Float,
    elapsed_time: Float,
    entity_capacity: Int,
    is_paused: Int,
};

pub fn ecs_world_new(capacity: Int) -> EcsWorld {
    return EcsWorld {
        entity_mgr: entity_manager_new(capacity),
        scheduler: system_scheduler_new(),
        delta_time: 0.0166667,
        elapsed_time: 0.0,
        entity_capacity: capacity,
        is_paused: 0,
    };
}

// -------------------------------------------------------------------
// Entity Allocation & Management
// -------------------------------------------------------------------

pub fn ecs_world_can_spawn(world: &EcsWorld) -> Int {
    return entity_manager_can_allocate(&(world).entity_mgr);
}

pub fn ecs_world_create_entity(world: EcsWorld) -> EcsWorld {
    let next_id: Int = entity_manager_allocate_id(&(world).entity_mgr);
    if next_id < 0 {
        return world;
    }
    let updated_mgr: EntityManager = entity_manager_on_created((world).entity_mgr);
    return EcsWorld {
        entity_mgr: updated_mgr,
        scheduler: (world).scheduler,
        delta_time: (world).delta_time,
        elapsed_time: (world).elapsed_time,
        entity_capacity: (world).entity_capacity,
        is_paused: (world).is_paused,
    };
}

pub fn ecs_world_destroy_entity(world: EcsWorld) -> EcsWorld {
    let updated_mgr: EntityManager = entity_manager_on_destroyed((world).entity_mgr);
    return EcsWorld {
        entity_mgr: updated_mgr,
        scheduler: (world).scheduler,
        delta_time: (world).delta_time,
        elapsed_time: (world).elapsed_time,
        entity_capacity: (world).entity_capacity,
        is_paused: (world).is_paused,
    };
}

pub fn ecs_world_entity_count(world: &EcsWorld) -> Int {
    return (world).entity_mgr.active_count;
}

pub fn ecs_world_capacity(world: &EcsWorld) -> Int {
    return (world).entity_capacity;
}

// -------------------------------------------------------------------
// Time Stepping & State Control
// -------------------------------------------------------------------

pub fn ecs_world_pause(world: EcsWorld) -> EcsWorld {
    return EcsWorld {
        entity_mgr: (world).entity_mgr,
        scheduler: (world).scheduler,
        delta_time: (world).delta_time,
        elapsed_time: (world).elapsed_time,
        entity_capacity: (world).entity_capacity,
        is_paused: 1,
    };
}

pub fn ecs_world_resume(world: EcsWorld) -> EcsWorld {
    return EcsWorld {
        entity_mgr: (world).entity_mgr,
        scheduler: (world).scheduler,
        delta_time: (world).delta_time,
        elapsed_time: (world).elapsed_time,
        entity_capacity: (world).entity_capacity,
        is_paused: 0,
    };
}

pub fn ecs_world_is_paused(world: &EcsWorld) -> Int {
    return (world).is_paused;
}

pub fn ecs_world_step(world: EcsWorld, dt: Float) -> EcsWorld {
    if (world).is_paused == 1 {
        return world;
    }
    let updated_sched: SystemScheduler = system_scheduler_next_tick((world).scheduler);
    return EcsWorld {
        entity_mgr: (world).entity_mgr,
        scheduler: updated_sched,
        delta_time: dt,
        elapsed_time: (world).elapsed_time + dt,
        entity_capacity: (world).entity_capacity,
        is_paused: (world).is_paused,
    };
}
