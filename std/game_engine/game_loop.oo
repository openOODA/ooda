// # Fixed Timestep & Semi-Fixed Game Loop
//
// Logline: Regulates fixed physics simulation ticks, time accumulators, and render state interpolation alpha.
//
// Setup: Frame timing and timestep regulation kernel for deterministic game updates.
//
// Beats:
//   1. Configure target frame rates and fixed physics update frequencies.
//   2. Accumulate delta time with spiral-of-death clamping guards.
//   3. Compute rendering interpolation alpha weights for smooth visual rendering.

// -------------------------------------------------------------------
// Game Loop State
// -------------------------------------------------------------------

pub type GameLoopState = struct {
    target_fps: Float,
    fixed_delta: Float,
    max_frame_time: Float,
    accumulated_time: Float,
    current_time: Float,
    frame_count: Int,
    is_running: Int,
    interpolation_alpha: Float
};

// -------------------------------------------------------------------
// Constructors & Controls
// -------------------------------------------------------------------

pub fn game_loop_new(target_fps: Float, fixed_physics_hz: Float) -> GameLoopState {
    let fix_dt: Float = if fixed_physics_hz > 0.0 { 1.0 / fixed_physics_hz } else { 0.0166667 };
    return GameLoopState {
        target_fps: target_fps,
        fixed_delta: fix_dt,
        max_frame_time: 0.25, // Spiral of death clamp (4 FPS min)
        accumulated_time: 0.0,
        current_time: 0.0,
        frame_count: 0,
        is_running: 1,
        interpolation_alpha: 0.0
    };
}

pub fn game_loop_start(loop_state: GameLoopState) -> GameLoopState {
    return GameLoopState {
        target_fps: (loop_state).target_fps,
        fixed_delta: (loop_state).fixed_delta,
        max_frame_time: (loop_state).max_frame_time,
        accumulated_time: (loop_state).accumulated_time,
        current_time: (loop_state).current_time,
        frame_count: (loop_state).frame_count,
        is_running: 1,
        interpolation_alpha: (loop_state).interpolation_alpha
    };
}

pub fn game_loop_stop(loop_state: GameLoopState) -> GameLoopState {
    return GameLoopState {
        target_fps: (loop_state).target_fps,
        fixed_delta: (loop_state).fixed_delta,
        max_frame_time: (loop_state).max_frame_time,
        accumulated_time: (loop_state).accumulated_time,
        current_time: (loop_state).current_time,
        frame_count: (loop_state).frame_count,
        is_running: 0,
        interpolation_alpha: (loop_state).interpolation_alpha
    };
}

// -------------------------------------------------------------------
// Frame Timestep Progression
// -------------------------------------------------------------------

pub fn game_loop_begin_frame(loop_state: GameLoopState, delta_real_sec: Float) -> GameLoopState {
    let mut dt: Float = delta_real_sec;
    if dt > (loop_state).max_frame_time {
        dt = (loop_state).max_frame_time;
    }

    let new_accum: Float = (loop_state).accumulated_time + dt;
    let alpha: Float = if (loop_state).fixed_delta > 0.0 { new_accum / (loop_state).fixed_delta } else { 0.0 };

    return GameLoopState {
        target_fps: (loop_state).target_fps,
        fixed_delta: (loop_state).fixed_delta,
        max_frame_time: (loop_state).max_frame_time,
        accumulated_time: new_accum,
        current_time: (loop_state).current_time + dt,
        frame_count: (loop_state).frame_count + 1,
        is_running: (loop_state).is_running,
        interpolation_alpha: if alpha > 1.0 { 1.0 } else { alpha }
    };
}

pub fn game_loop_should_fixed_step(loop_state: &GameLoopState) -> Int {
    if (loop_state).accumulated_time >= (loop_state).fixed_delta {
        return 1;
    }
    return 0;
}

pub fn game_loop_consume_fixed_step(loop_state: GameLoopState) -> GameLoopState {
    let remaining_accum: Float = (loop_state).accumulated_time - (loop_state).fixed_delta;
    let new_accum: Float = if remaining_accum < 0.0 { 0.0 } else { remaining_accum };
    let alpha: Float = if (loop_state).fixed_delta > 0.0 { new_accum / (loop_state).fixed_delta } else { 0.0 };

    return GameLoopState {
        target_fps: (loop_state).target_fps,
        fixed_delta: (loop_state).fixed_delta,
        max_frame_time: (loop_state).max_frame_time,
        accumulated_time: new_accum,
        current_time: (loop_state).current_time,
        frame_count: (loop_state).frame_count,
        is_running: (loop_state).is_running,
        interpolation_alpha: if alpha > 1.0 { 1.0 } else { alpha }
    };
}
