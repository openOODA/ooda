// # Scene Graph & Scene Lifecycle Management
//
// Logline: Orchestrates active scenes, modal push/pop hierarchy stacks, and cross-fade scene transitions.
//
// Setup: Hierarchical scene switcher and transition timeline controller.
//
// Beats:
//   1. Track active scene identifiers, modal overlays, and stack depths.
//   2. Manage state transitions (Instantaneous, FadeOut, and FadeIn).
//   3. Compute fade screen alpha progressions during scene switches.

// -------------------------------------------------------------------
// Transition State Constants
// -------------------------------------------------------------------

pub fn scene_trans_none() -> Int { return 0; }
pub fn scene_trans_fade_out() -> Int { return 1; }
pub fn scene_trans_fade_in() -> Int { return 2; }

// -------------------------------------------------------------------
// Scene Manager State
// -------------------------------------------------------------------

pub type SceneManager = struct {
    current_scene_id: Int,
    next_scene_id: Int,
    transition_state: Int,
    transition_duration: Float,
    transition_progress: Float,
    stack_depth: Int,
    is_paused: Int
};

// -------------------------------------------------------------------
// Constructors & Scene Switching
// -------------------------------------------------------------------

pub fn scene_manager_new(initial_scene_id: Int) -> SceneManager {
    return SceneManager {
        current_scene_id: initial_scene_id,
        next_scene_id: 0 - 1,
        transition_state: 0,
        transition_duration: 0.0,
        transition_progress: 0.0,
        stack_depth: 1,
        is_paused: 0
    };
}

pub fn scene_manager_change_scene(mgr: SceneManager, next_id: Int, fade_sec: Float) -> SceneManager {
    if fade_sec <= 0.00001 {
        // Instant change
        return SceneManager {
            current_scene_id: next_id,
            next_scene_id: 0 - 1,
            transition_state: 0,
            transition_duration: 0.0,
            transition_progress: 0.0,
            stack_depth: (mgr).stack_depth,
            is_paused: (mgr).is_paused
        };
    }

    return SceneManager {
        current_scene_id: (mgr).current_scene_id,
        next_scene_id: next_id,
        transition_state: 1, // Fade out
        transition_duration: fade_sec,
        transition_progress: 0.0,
        stack_depth: (mgr).stack_depth,
        is_paused: (mgr).is_paused
    };
}

pub fn scene_manager_push_modal(mgr: SceneManager, modal_scene_id: Int) -> SceneManager {
    return SceneManager {
        current_scene_id: modal_scene_id,
        next_scene_id: (mgr).next_scene_id,
        transition_state: 0,
        transition_duration: 0.0,
        transition_progress: 0.0,
        stack_depth: (mgr).stack_depth + 1,
        is_paused: 1
    };
}

pub fn scene_manager_pop_modal(mgr: SceneManager, fallback_scene_id: Int) -> SceneManager {
    let new_depth: Int = if (mgr).stack_depth > 1 { (mgr).stack_depth - 1 } else { 1 };
    let unpause: Int = if new_depth <= 1 { 0 } else { 1 };
    return SceneManager {
        current_scene_id: fallback_scene_id,
        next_scene_id: (mgr).next_scene_id,
        transition_state: 0,
        transition_duration: 0.0,
        transition_progress: 0.0,
        stack_depth: new_depth,
        is_paused: unpause
    };
}

// -------------------------------------------------------------------
// Transition Step & Alpha Query
// -------------------------------------------------------------------

pub fn scene_manager_update(mgr: SceneManager, dt: Float) -> SceneManager {
    if (mgr).transition_state == 0 {
        return mgr;
    }

    let dur: Float = if (mgr).transition_duration > 0.0 { (mgr).transition_duration } else { 0.001 };
    let new_prog: Float = (mgr).transition_progress + (dt / dur);

    if (mgr).transition_state == 1 { // Fade out
        if new_prog >= 1.0 {
            // Switched to next scene, start fade in
            return SceneManager {
                current_scene_id: (mgr).next_scene_id,
                next_scene_id: 0 - 1,
                transition_state: 2, // Fade in
                transition_duration: (mgr).transition_duration,
                transition_progress: 0.0,
                stack_depth: (mgr).stack_depth,
                is_paused: (mgr).is_paused
            };
        }
        return SceneManager {
            current_scene_id: (mgr).current_scene_id,
            next_scene_id: (mgr).next_scene_id,
            transition_state: 1,
            transition_duration: (mgr).transition_duration,
            transition_progress: new_prog,
            stack_depth: (mgr).stack_depth,
            is_paused: (mgr).is_paused
        };
    }

    if (mgr).transition_state == 2 { // Fade in
        if new_prog >= 1.0 {
            // Transition finished
            return SceneManager {
                current_scene_id: (mgr).current_scene_id,
                next_scene_id: 0 - 1,
                transition_state: 0,
                transition_duration: 0.0,
                transition_progress: 0.0,
                stack_depth: (mgr).stack_depth,
                is_paused: (mgr).is_paused
            };
        }
        return SceneManager {
            current_scene_id: (mgr).current_scene_id,
            next_scene_id: (mgr).next_scene_id,
            transition_state: 2,
            transition_duration: (mgr).transition_duration,
            transition_progress: new_prog,
            stack_depth: (mgr).stack_depth,
            is_paused: (mgr).is_paused
        };
    }

    return mgr;
}

pub fn scene_manager_get_fade_alpha(mgr: &SceneManager) -> Float {
    if (mgr).transition_state == 1 { // Fade out: 0 -> 1
        return (mgr).transition_progress;
    }
    if (mgr).transition_state == 2 { // Fade in: 1 -> 0
        return 1.0 - (mgr).transition_progress;
    }
    return 0.0;
}
