// # Axis-Aligned Bounding Box (AABB) 2D/3D Collision
//
// Logline: Implements 2D/3D AABB overlap queries, swept bounding volumes, point containment, and raycast intersections.
//
// Setup: High-performance broadphase and narrowphase spatial pruning for physical simulations.
//
// Beats:
//   1. Define 2D and 3D Axis-Aligned Bounding Box data models.
//   2. Compute fast interval overlap, point inclusion, and union expansion operations.
//   3. Implement slab-based ray vs AABB intersection and swept volume generation.

// -------------------------------------------------------------------
// 2D & 3D Bounding Box Structures
// -------------------------------------------------------------------

type AABB2D = struct {
    min_x: Float,
    min_y: Float,
    max_x: Float,
    max_y: Float,
};

type AABB3D = struct {
    min_x: Float,
    min_y: Float,
    min_z: Float,
    max_x: Float,
    max_y: Float,
    max_z: Float,
};

type Ray2D = struct {
    origin_x: Float,
    origin_y: Float,
    dir_x: Float,
    dir_y: Float,
};

type RayCastHit2D = struct {
    hit: Int,
    t_min: Float,
    point_x: Float,
    point_y: Float,
    normal_x: Float,
    normal_y: Float,
};

// -------------------------------------------------------------------
// 2D AABB Constructors & Properties
// -------------------------------------------------------------------

pub fn aabb2d_new(min_x: Float, min_y: Float, max_x: Float, max_y: Float) -> AABB2D {
    return AABB2D {
        min_x: min_x,
        min_y: min_y,
        max_x: max_x,
        max_y: max_y,
    };
}

pub fn aabb2d_from_center_size(cx: Float, cy: Float, width: Float, height: Float) -> AABB2D {
    let hw: Float = width * 0.5;
    let hh: Float = height * 0.5;
    return AABB2D {
        min_x: cx - hw,
        min_y: cy - hh,
        max_x: cx + hw,
        max_y: cy + hh,
    };
}

pub fn aabb2d_center_x(b: &AABB2D) -> Float {
    return ((b).min_x + (b).max_x) * 0.5;
}

pub fn aabb2d_center_y(b: &AABB2D) -> Float {
    return ((b).min_y + (b).max_y) * 0.5;
}

pub fn aabb2d_width(b: &AABB2D) -> Float {
    return (b).max_x - (b).min_x;
}

pub fn aabb2d_height(b: &AABB2D) -> Float {
    return (b).max_y - (b).min_y;
}

// -------------------------------------------------------------------
// 2D Overlap, Containment & Expansion
// -------------------------------------------------------------------

pub fn aabb2d_overlaps(a: &AABB2D, b: &AABB2D) -> Int {
    if (a).max_x < (b).min_x { return 0; }
    if (a).min_x > (b).max_x { return 0; }
    if (a).max_y < (b).min_y { return 0; }
    if (a).min_y > (b).max_y { return 0; }
    return 1;
}

pub fn aabb2d_contains_point(b: &AABB2D, px: Float, py: Float) -> Int {
    if px < (b).min_x { return 0; }
    if px > (b).max_x { return 0; }
    if py < (b).min_y { return 0; }
    if py > (b).max_y { return 0; }
    return 1;
}

pub fn aabb2d_union(a: &AABB2D, b: &AABB2D) -> AABB2D {
    let min_x: Float = if (a).min_x < (b).min_x { (a).min_x } else { (b).min_x };
    let min_y: Float = if (a).min_y < (b).min_y { (a).min_y } else { (b).min_y };
    let max_x: Float = if (a).max_x > (b).max_x { (a).max_x } else { (b).max_x };
    let max_y: Float = if (a).max_y > (b).max_y { (a).max_y } else { (b).max_y };
    return AABB2D {
        min_x: min_x,
        min_y: min_y,
        max_x: max_x,
        max_y: max_y,
    };
}

pub fn aabb2d_expand(b: &AABB2D, margin: Float) -> AABB2D {
    return AABB2D {
        min_x: (b).min_x - margin,
        min_y: (b).min_y - margin,
        max_x: (b).max_x + margin,
        max_y: (b).max_y + margin,
    };
}

pub fn aabb2d_swept(b: &AABB2D, dx: Float, dy: Float) -> AABB2D {
    let min_x: Float = if dx < 0.0 { (b).min_x + dx } else { (b).min_x };
    let max_x: Float = if dx > 0.0 { (b).max_x + dx } else { (b).max_x };
    let min_y: Float = if dy < 0.0 { (b).min_y + dy } else { (b).min_y };
    let max_y: Float = if dy > 0.0 { (b).max_y + dy } else { (b).max_y };
    return AABB2D {
        min_x: min_x,
        min_y: min_y,
        max_x: max_x,
        max_y: max_y,
    };
}

// -------------------------------------------------------------------
// 2D Raycast Intersection
// -------------------------------------------------------------------

pub fn aabb2d_raycast(b: &AABB2D, ray: &Ray2D, max_dist: Float) -> RayCastHit2D {
    let inv_dx: Float = if (ray).dir_x != 0.0 { 1.0 / (ray).dir_x } else { 1000000.0 };
    let inv_dy: Float = if (ray).dir_y != 0.0 { 1.0 / (ray).dir_y } else { 1000000.0 };

    let t1_x: Float = ((b).min_x - (ray).origin_x) * inv_dx;
    let t2_x: Float = ((b).max_x - (ray).origin_x) * inv_dx;
    let t_min_x: Float = if t1_x < t2_x { t1_x } else { t2_x };
    let t_max_x: Float = if t1_x > t2_x { t1_x } else { t2_x };

    let t1_y: Float = ((b).min_y - (ray).origin_y) * inv_dy;
    let t2_y: Float = ((b).max_y - (ray).origin_y) * inv_dy;
    let t_min_y: Float = if t1_y < t2_y { t1_y } else { t2_y };
    let t_max_y: Float = if t1_y > t2_y { t1_y } else { t2_y };

    let t_enter: Float = if t_min_x > t_min_y { t_min_x } else { t_min_y };
    let t_exit: Float = if t_max_x < t_max_y { t_max_x } else { t_max_y };

    if t_enter > t_exit {
        return RayCastHit2D { hit: 0, t_min: 0.0, point_x: 0.0, point_y: 0.0, normal_x: 0.0, normal_y: 0.0 };
    }
    if t_exit < 0.0 {
        return RayCastHit2D { hit: 0, t_min: 0.0, point_x: 0.0, point_y: 0.0, normal_x: 0.0, normal_y: 0.0 };
    }
    let hit_t: Float = if t_enter < 0.0 { 0.0 } else { t_enter };
    if hit_t > max_dist {
        return RayCastHit2D { hit: 0, t_min: 0.0, point_x: 0.0, point_y: 0.0, normal_x: 0.0, normal_y: 0.0 };
    }

    let norm_x: Float = if t_min_x > t_min_y { if (ray).dir_x > 0.0 { -1.0 } else { 1.0 } } else { 0.0 };
    let norm_y: Float = if t_min_y >= t_min_x { if (ray).dir_y > 0.0 { -1.0 } else { 1.0 } } else { 0.0 };

    return RayCastHit2D {
        hit: 1,
        t_min: hit_t,
        point_x: (ray).origin_x + ((ray).dir_x * hit_t),
        point_y: (ray).origin_y + ((ray).dir_y * hit_t),
        normal_x: norm_x,
        normal_y: norm_y,
    };
}

// -------------------------------------------------------------------
// 3D AABB Constructors & Overlap
// -------------------------------------------------------------------

pub fn aabb3d_new(min_x: Float, min_y: Float, min_z: Float, max_x: Float, max_y: Float, max_z: Float) -> AABB3D {
    return AABB3D {
        min_x: min_x,
        min_y: min_y,
        min_z: min_z,
        max_x: max_x,
        max_y: max_y,
        max_z: max_z,
    };
}

pub fn aabb3d_overlaps(a: &AABB3D, b: &AABB3D) -> Int {
    if (a).max_x < (b).min_x { return 0; }
    if (a).min_x > (b).max_x { return 0; }
    if (a).max_y < (b).min_y { return 0; }
    if (a).min_y > (b).max_y { return 0; }
    if (a).max_z < (b).min_z { return 0; }
    if (a).min_z > (b).max_z { return 0; }
    return 1;
}

pub fn aabb3d_contains_point(b: &AABB3D, px: Float, py: Float, pz: Float) -> Int {
    if px < (b).min_x { return 0; }
    if px > (b).max_x { return 0; }
    if py < (b).min_y { return 0; }
    if py > (b).max_y { return 0; }
    if pz < (b).min_z { return 0; }
    if pz > (b).max_z { return 0; }
    return 1;
}

pub fn aabb3d_union(a: &AABB3D, b: &AABB3D) -> AABB3D {
    let min_x: Float = if (a).min_x < (b).min_x { (a).min_x } else { (b).min_x };
    let min_y: Float = if (a).min_y < (b).min_y { (a).min_y } else { (b).min_y };
    let min_z: Float = if (a).min_z < (b).min_z { (a).min_z } else { (b).min_z };
    let max_x: Float = if (a).max_x > (b).max_x { (a).max_x } else { (b).max_x };
    let max_y: Float = if (a).max_y > (b).max_y { (a).max_y } else { (b).max_y };
    let max_z: Float = if (a).max_z > (b).max_z { (a).max_z } else { (b).max_z };
    return AABB3D {
        min_x: min_x,
        min_y: min_y,
        min_z: min_z,
        max_x: max_x,
        max_y: max_y,
        max_z: max_z,
    };
}
