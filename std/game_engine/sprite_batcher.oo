// # 2D Sprite & Quad Render Batching
//
// Logline: Buffers 2D quads, aggregates textured vertex streams, and tracks GPU draw calls for sprite renderers.
//
// Setup: High-throughput vertex assembly and texture-swapping batch manager.
//
// Beats:
//   1. Define 2D vertex layout with interleaved position, UV texture coordinates, and RGBA tints.
//   2. Manage batch quad capacity, current bound texture IDs, and draw call counters.
//   3. Handle batch submission, automatic texture-switch flushes, and frame resets.

// -------------------------------------------------------------------
// Sprite Vertex & Batch Types
// -------------------------------------------------------------------

pub type SpriteVertex = struct {
    x: Float,
    y: Float,
    u: Float,
    v: Float,
    r: Float,
    g: Float,
    b: Float,
    a: Float,
};

pub type SpriteBatch = struct {
    capacity: Int,
    quad_count: Int,
    current_texture_id: Int,
    draw_calls: Int,
    is_flushed: Int,
};

// -------------------------------------------------------------------
// Vertex Constructors
// -------------------------------------------------------------------

pub fn sprite_vertex_new(
    x: Float,
    y: Float,
    u: Float,
    v: Float,
    r: Float,
    g: Float,
    b: Float,
    a: Float
) -> SpriteVertex {
    return SpriteVertex {
        x: x,
        y: y,
        u: u,
        v: v,
        r: r,
        g: g,
        b: b,
        a: a,
    };
}

pub fn sprite_vertex_white(x: Float, y: Float, u: Float, v: Float) -> SpriteVertex {
    return SpriteVertex {
        x: x,
        y: y,
        u: u,
        v: v,
        r: 1.0,
        g: 1.0,
        b: 1.0,
        a: 1.0,
    };
}

// -------------------------------------------------------------------
// Batch Management Lifecycle
// -------------------------------------------------------------------

pub fn sprite_batch_new(capacity: Int) -> SpriteBatch {
    return SpriteBatch {
        capacity: capacity,
        quad_count: 0,
        current_texture_id: 0 - 1,
        draw_calls: 0,
        is_flushed: 1,
    };
}

pub fn sprite_batch_begin(batch: SpriteBatch, texture_id: Int) -> SpriteBatch {
    return SpriteBatch {
        capacity: (batch).capacity,
        quad_count: 0,
        current_texture_id: texture_id,
        draw_calls: 0,
        is_flushed: 0,
    };
}

pub fn sprite_batch_can_add(batch: &SpriteBatch) -> Int {
    if (batch).quad_count >= (batch).capacity {
        return 0;
    }
    return 1;
}

pub fn sprite_batch_push_quad(batch: SpriteBatch, texture_id: Int) -> SpriteBatch {
    let mut draws: Int = (batch).draw_calls;
    let mut quads: Int = (batch).quad_count;

    // Flush if texture changes or capacity reached
    if ((batch).current_texture_id != texture_id) || (quads >= (batch).capacity) {
        draws = draws + 1;
        quads = 0;
    }

    return SpriteBatch {
        capacity: (batch).capacity,
        quad_count: quads + 1,
        current_texture_id: texture_id,
        draw_calls: draws,
        is_flushed: 0,
    };
}

pub fn sprite_batch_flush(batch: SpriteBatch) -> SpriteBatch {
    let add_draw: Int = if (batch).quad_count > 0 { 1 } else { 0 };
    return SpriteBatch {
        capacity: (batch).capacity,
        quad_count: 0,
        current_texture_id: (batch).current_texture_id,
        draw_calls: (batch).draw_calls + add_draw,
        is_flushed: 1,
    };
}

pub fn sprite_batch_total_vertices(batch: &SpriteBatch) -> Int {
    return (batch).quad_count * 4;
}

pub fn sprite_batch_total_indices(batch: &SpriteBatch) -> Int {
    return (batch).quad_count * 6;
}
