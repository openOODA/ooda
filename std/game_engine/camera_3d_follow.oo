// # 3D Third-Person Follow & Orbit Camera
//
// Logline: Computes 3D spherical orbit eye coordinates, target lag damping, pitch/yaw clamps, and view forward vectors.
//
// Setup: Spherical coordinate trigonometry and smooth interpolation for 3D third-person perspectives.
//
// Beats:
//   1. Represent 3D camera orbital angles (yaw/pitch), target points, and distance limits.
//   2. Orbit and zoom camera orientation with pitch boundary clamping.
//   3. Compute smoothed eye position and forward gaze orientation vectors.

// -------------------------------------------------------------------
// Camera 3D Types
// -------------------------------------------------------------------

pub type CamVec3 = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub type Camera3DFollow = struct {
    target_x: Float,
    target_y: Float,
    target_z: Float,
    eye_x: Float,
    eye_y: Float,
    eye_z: Float,
    yaw_rad: Float,
    pitch_rad: Float,
    distance: Float,
    min_dist: Float,
    max_dist: Float,
    smooth_factor: Float,
};

// -------------------------------------------------------------------
// Constructors & Angle Controls
// -------------------------------------------------------------------

pub fn camera_3d_follow_new(distance: Float) -> Camera3DFollow {
    return Camera3DFollow {
        target_x: 0.0,
        target_y: 0.0,
        target_z: 0.0,
        eye_x: 0.0,
        eye_y: 2.0,
        eye_z: 0.0 - distance,
        yaw_rad: 0.0,
        pitch_rad: 0.35, // ~20 degrees elevation
        distance: distance,
        min_dist: 1.0,
        max_dist: 50.0,
        smooth_factor: 8.0,
    };
}

pub fn camera_3d_set_target(cam: Camera3DFollow, tx: Float, ty: Float, tz: Float) -> Camera3DFollow {
    return Camera3DFollow {
        target_x: tx,
        target_y: ty,
        target_z: tz,
        eye_x: (cam).eye_x,
        eye_y: (cam).eye_y,
        eye_z: (cam).eye_z,
        yaw_rad: (cam).yaw_rad,
        pitch_rad: (cam).pitch_rad,
        distance: (cam).distance,
        min_dist: (cam).min_dist,
        max_dist: (cam).max_dist,
        smooth_factor: (cam).smooth_factor,
    };
}

pub fn camera_3d_orbit(cam: Camera3DFollow, delta_yaw: Float, delta_pitch: Float) -> Camera3DFollow {
    let mut new_pitch: Float = (cam).pitch_rad + delta_pitch;
    // Clamp pitch to [-85 deg, +85 deg] ~ [-1.48, +1.48]
    if new_pitch > 1.48 { new_pitch = 1.48; }
    if new_pitch < -1.48 { new_pitch = -1.48; }

    return Camera3DFollow {
        target_x: (cam).target_x,
        target_y: (cam).target_y,
        target_z: (cam).target_z,
        eye_x: (cam).eye_x,
        eye_y: (cam).eye_y,
        eye_z: (cam).eye_z,
        yaw_rad: (cam).yaw_rad + delta_yaw,
        pitch_rad: new_pitch,
        distance: (cam).distance,
        min_dist: (cam).min_dist,
        max_dist: (cam).max_dist,
        smooth_factor: (cam).smooth_factor,
    };
}

pub fn camera_3d_zoom(cam: Camera3DFollow, delta_dist: Float) -> Camera3DFollow {
    let mut new_d: Float = (cam).distance + delta_dist;
    if new_d < (cam).min_dist { new_d = (cam).min_dist; }
    if new_d > (cam).max_dist { new_d = (cam).max_dist; }

    return Camera3DFollow {
        target_x: (cam).target_x,
        target_y: (cam).target_y,
        target_z: (cam).target_z,
        eye_x: (cam).eye_x,
        eye_y: (cam).eye_y,
        eye_z: (cam).eye_z,
        yaw_rad: (cam).yaw_rad,
        pitch_rad: (cam).pitch_rad,
        distance: new_d,
        min_dist: (cam).min_dist,
        max_dist: (cam).max_dist,
        smooth_factor: (cam).smooth_factor,
    };
}

// -------------------------------------------------------------------
// Orbital Position Evaluation
// -------------------------------------------------------------------

pub fn camera_3d_update(cam: Camera3DFollow, dt: Float) -> Camera3DFollow {
    let cos_p: Float = cos((cam).pitch_rad);
    let sin_p: Float = sin((cam).pitch_rad);
    let cos_y: Float = cos((cam).yaw_rad);
    let sin_y: Float = sin((cam).yaw_rad);

    let offset_x: Float = (cam).distance * cos_p * sin_y;
    let offset_y: Float = (cam).distance * sin_p;
    let offset_z: Float = (cam).distance * cos_p * cos_y;

    let desired_x: Float = (cam).target_x - offset_x;
    let desired_y: Float = (cam).target_y + offset_y;
    let desired_z: Float = (cam).target_z - offset_z;

    let t: Float = (cam).smooth_factor * dt;
    let blend: Float = if t > 1.0 { 1.0 } else { t };

    let cur_x: Float = (cam).eye_x + ((desired_x - (cam).eye_x) * blend);
    let cur_y: Float = (cam).eye_y + ((desired_y - (cam).eye_y) * blend);
    let cur_z: Float = (cam).eye_z + ((desired_z - (cam).eye_z) * blend);

    return Camera3DFollow {
        target_x: (cam).target_x,
        target_y: (cam).target_y,
        target_z: (cam).target_z,
        eye_x: cur_x,
        eye_y: cur_y,
        eye_z: cur_z,
        yaw_rad: (cam).yaw_rad,
        pitch_rad: (cam).pitch_rad,
        distance: (cam).distance,
        min_dist: (cam).min_dist,
        max_dist: (cam).max_dist,
        smooth_factor: (cam).smooth_factor,
    };
}

pub fn camera_3d_get_forward(cam: &Camera3DFollow) -> CamVec3 {
    let dx: Float = (cam).target_x - (cam).eye_x;
    let dy: Float = (cam).target_y - (cam).eye_y;
    let dz: Float = (cam).target_z - (cam).eye_z;
    let len_sq: Float = ((dx * dx) + (dy * dy)) + (dz * dz);
    if len_sq < 0.00001 {
        return CamVec3 { x: 0.0, y: 0.0, z: 1.0 };
    }
    let inv_len: Float = 1.0 / sqrt(len_sq);
    return CamVec3 {
        x: dx * inv_len,
        y: dy * inv_len,
        z: dz * inv_len,
    };
}
