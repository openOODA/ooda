// # Game Engine Driver Stubs & Capability Defaults
//
// Logline: Provides fallback hardware capabilities, headless test profiles, telemetry metrics, and mock device hooks.
//
// Setup: Mock runtime drivers and capability queries for headless execution and unit validation.
//
// Beats:
//   1. Define hardware capability records (texture limits, entity limits, VRAM, thread support).
//   2. Capture engine runtime performance statistics (FPS, frame time, draw calls, active entities).
//   3. Implement mock headless hooks for graphics, audio, and device subsystems.

// -------------------------------------------------------------------
// Engine Capabilities & Device Profiling
// -------------------------------------------------------------------

pub type EngineCapabilities = struct {
    max_texture_size: Int,
    max_draw_calls: Int,
    max_entities: Int,
    supports_compute: Int,
    supports_threads: Int,
    vram_mb: Int
};

pub type EngineStats = struct {
    fps: Float,
    frame_time_ms: Float,
    draw_calls: Int,
    entities_active: Int,
    memory_used_mb: Float
};

// -------------------------------------------------------------------
// Capability Configurations
// -------------------------------------------------------------------

pub fn game_capabilities_default() -> EngineCapabilities {
    return EngineCapabilities {
        max_texture_size: 4096,
        max_draw_calls: 10000,
        max_entities: 65536,
        supports_compute: 1,
        supports_threads: 1,
        vram_mb: 2048
    };
}

pub fn game_capabilities_headless() -> EngineCapabilities {
    return EngineCapabilities {
        max_texture_size: 1024,
        max_draw_calls: 1000,
        max_entities: 16384,
        supports_compute: 0,
        supports_threads: 0,
        vram_mb: 256
    };
}

// -------------------------------------------------------------------
// Engine Telemetry & Stats
// -------------------------------------------------------------------

pub fn game_stats_new() -> EngineStats {
    return EngineStats {
        fps: 60.0,
        frame_time_ms: 16.6667,
        draw_calls: 0,
        entities_active: 0,
        memory_used_mb: 0.0
    };
}

pub fn game_stats_record(fps: Float, frame_ms: Float, draws: Int, entities: Int) -> EngineStats {
    return EngineStats {
        fps: fps,
        frame_time_ms: frame_ms,
        draw_calls: draws,
        entities_active: entities,
        memory_used_mb: 32.0
    };
}

// -------------------------------------------------------------------
// Mock Device Stubs
// -------------------------------------------------------------------

pub fn game_stub_render_clear() -> Int {
    return 1;
}

pub fn game_stub_render_present() -> Int {
    return 1;
}

pub fn game_stub_audio_init() -> Int {
    return 1;
}

pub fn game_stub_audio_shutdown() -> Int {
    return 1;
}
