// # ECS Archetype & Component Queries
//
// Logline: Evaluates bitmask criteria (all-of, any-of, none-of) against active entity records for system matching.
//
// Setup: Query filters and match evaluators importing ecs_component.oo and ecs_entity.oo.
//
// Beats:
//   1. Construct inclusion (all/any) and exclusion (none) component queries.
//   2. Evaluate entity bitmask compatibility with early exit branches.
//   3. Track query scan counts and match metrics for ECS scheduling.

import "./ecs_component.oo";
import "./ecs_entity.oo";

// -------------------------------------------------------------------
// Query Specification
// -------------------------------------------------------------------

pub type ComponentQuery = struct {
    all_mask: Int,
    any_mask: Int,
    none_mask: Int
};

pub fn query_all(all_mask: Int) -> ComponentQuery {
    return ComponentQuery {
        all_mask: all_mask,
        any_mask: 0,
        none_mask: 0
    };
}

pub fn query_with_filter(all_mask: Int, any_mask: Int, none_mask: Int) -> ComponentQuery {
    return ComponentQuery {
        all_mask: all_mask,
        any_mask: any_mask,
        none_mask: none_mask
    };
}

pub fn query_renderable_2d() -> ComponentQuery {
    let mask: Int = component_mask_transform_2d() | component_mask_sprite();
    return query_all(mask);
}

pub fn query_physics_2d() -> ComponentQuery {
    let mask: Int = component_mask_transform_2d() | component_mask_velocity_2d();
    return query_all(mask);
}

pub fn query_collidable_2d() -> ComponentQuery {
    let mask: Int = component_mask_transform_2d() | component_mask_collider();
    return query_all(mask);
}

// -------------------------------------------------------------------
// Query Evaluation
// -------------------------------------------------------------------

pub fn query_matches_mask(query: &ComponentQuery, mask: Int) -> Int {
    // 1. None-of check: must not have any of the none_mask bits
    if (query).none_mask > 0 {
        let none_hits: Int = mask & (query).none_mask;
        if none_hits > 0 {
            return 0;
        }
    }

    // 2. All-of check: must contain all bits of all_mask
    if (query).all_mask > 0 {
        let all_hits: Int = mask & (query).all_mask;
        if all_hits != (query).all_mask {
            return 0;
        }
    }

    // 3. Any-of check: if specified, must contain at least one bit
    if (query).any_mask > 0 {
        let any_hits: Int = mask & (query).any_mask;
        if any_hits == 0 {
            return 0;
        }
    }

    return 1;
}

pub fn query_matches_entity(query: &ComponentQuery, entity: &EntityRecord) -> Int {
    if (entity).active == 0 {
        return 0;
    }
    return query_matches_mask(query, (entity).component_mask);
}

// -------------------------------------------------------------------
// Query Statistics & Execution Tracker
// -------------------------------------------------------------------

pub type QueryResult = struct {
    matched_count: Int,
    total_scanned: Int
};

pub fn query_result_new() -> QueryResult {
    return QueryResult {
        matched_count: 0,
        total_scanned: 0
    };
}

pub fn query_result_add_match(res: QueryResult) -> QueryResult {
    return QueryResult {
        matched_count: (res).matched_count + 1,
        total_scanned: (res).total_scanned + 1
    };
}

pub fn query_result_add_miss(res: QueryResult) -> QueryResult {
    return QueryResult {
        matched_count: (res).matched_count,
        total_scanned: (res).total_scanned + 1
    };
}
