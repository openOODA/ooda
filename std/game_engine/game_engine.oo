// # Game Engine & ECS Architecture Unified Facade
//
// Logline: Re-exports ECS World, Collision, Tilemaps, Pathfinding, Sprites, Game Loop, Cameras, Particles, Input, Scene, and Audio.
//
// Setup: Pure module shim and facade importing all companion 2D/3D game engine and ECS submodules.
//
// Beats:
//   1. Import 24 modular game engine and ECS subcomponents.
//   2. Re-export public constructors, lifecycle steppers, and spatial physics entry points.
//   3. Maintain full compatibility with downstream openOODA game engine consumers.

import "./ecs_world.oo";
import "./ecs_entity.oo";
import "./ecs_component.oo";
import "./ecs_system.oo";
import "./ecs_query.oo";
import "./collision_aabb.oo";
import "./collision_sat.oo";
import "./collision_gjk.oo";
import "./collision_circle.oo";
import "./tilemap_grid.oo";
import "./tilemap_layer.oo";
import "./pathfinding_astar.oo";
import "./pathfinding_navmesh.oo";
import "./sprite_batcher.oo";
import "./sprite_animation.oo";
import "./game_loop.oo";
import "./camera_2d.oo";
import "./camera_3d_follow.oo";
import "./particle_emitter.oo";
import "./particle_particle.oo";
import "./input_manager.oo";
import "./scene_manager.oo";
import "./game_audio_emitter.oo";
import "./game_stubs.oo";

// -------------------------------------------------------------------
// Unified Engine Facade Record
// -------------------------------------------------------------------

pub type GameEngine = struct {
    world: EcsWorld,
    loop_state: GameLoopState,
    scene_mgr: SceneManager,
    input_state: InputState,
    camera2d: Camera2D,
    camera3d: Camera3DFollow,
    is_initialized: Int,
};

// -------------------------------------------------------------------
// Engine Factory & Stepper
// -------------------------------------------------------------------

pub fn game_engine_init(capacity: Int, viewport_w: Float, viewport_h: Float) -> GameEngine {
    return GameEngine {
        world: ecs_world_new(capacity),
        loop_state: game_loop_new(60.0, 60.0),
        scene_mgr: scene_manager_new(0),
        input_state: input_state_new(),
        camera2d: camera_2d_new(viewport_w, viewport_h),
        camera3d: camera_3d_follow_new(10.0),
        is_initialized: 1,
    };
}

pub fn game_engine_step(engine: GameEngine, dt: Float) -> GameEngine {
    let updated_loop: GameLoopState = game_loop_begin_frame((engine).loop_state, dt);
    let updated_world: EcsWorld = ecs_world_step((engine).world, dt);
    let updated_scene: SceneManager = scene_manager_update((engine).scene_mgr, dt);
    let updated_cam2d: Camera2D = camera_2d_update((engine).camera2d, dt);
    let updated_cam3d: Camera3DFollow = camera_3d_update((engine).camera3d, dt);

    return GameEngine {
        world: updated_world,
        loop_state: updated_loop,
        scene_mgr: updated_scene,
        input_state: (engine).input_state,
        camera2d: updated_cam2d,
        camera3d: updated_cam3d,
        is_initialized: (engine).is_initialized,
    };
}

pub fn game_engine_is_running(engine: &GameEngine) -> Int {
    return (engine).loop_state.is_running;
}

pub fn game_engine_active_entity_count(engine: &GameEngine) -> Int {
    return ecs_world_entity_count(&(engine).world);
}
