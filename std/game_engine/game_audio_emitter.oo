// # 2D/3D Spatial Audio Emitters & Attenuation
//
// Logline: Calculates distance attenuation, stereo pan balance, and Doppler frequency shifts for spatial audio emitters.
//
// Setup: Geometric 3D acoustic propagation models and listener orientation.
//
// Beats:
//   1. Represent 3D audio listener positions, forward vectors, and emitter sound sources.
//   2. Compute distance-based attenuation across Linear, Inverse-Square, and Exponential curves.
//   3. Determine stereo panning gains (left/right channels) and Doppler pitch shifts.

// -------------------------------------------------------------------
// Falloff Attenuation Modes
// -------------------------------------------------------------------

pub fn audio_falloff_linear() -> Int { return 0; }
pub fn audio_falloff_inverse_square() -> Int { return 1; }
pub fn audio_falloff_exponential() -> Int { return 2; }

// -------------------------------------------------------------------
// Audio Types
// -------------------------------------------------------------------

pub type AudioListener = struct {
    x: Float,
    y: Float,
    z: Float,
    forward_x: Float,
    forward_y: Float,
    forward_z: Float
};

pub type SoundEmitter = struct {
    sound_id: Int,
    x: Float,
    y: Float,
    z: Float,
    min_dist: Float,
    max_dist: Float,
    base_volume: Float,
    pitch: Float,
    falloff_model: Int,
    is_playing: Int
};

pub type SpatialAudioOutput = struct {
    left_gain: Float,
    right_gain: Float,
    pitch_factor: Float
};

// -------------------------------------------------------------------
// Constructors
// -------------------------------------------------------------------

pub fn audio_listener_new(x: Float, y: Float, z: Float) -> AudioListener {
    return AudioListener {
        x: x,
        y: y,
        z: z,
        forward_x: 0.0,
        forward_y: 0.0,
        forward_z: 1.0
    };
}

pub fn sound_emitter_new(sound_id: Int, x: Float, y: Float, z: Float) -> SoundEmitter {
    return SoundEmitter {
        sound_id: sound_id,
        x: x,
        y: y,
        z: z,
        min_dist: 1.0,
        max_dist: 50.0,
        base_volume: 1.0,
        pitch: 1.0,
        falloff_model: 1, // Inverse square default
        is_playing: 1
    };
}

// -------------------------------------------------------------------
// Spatial Attenuation & Stereo Panning Calculation
// -------------------------------------------------------------------

pub fn audio_emitter_calculate_spatial(emitter: &SoundEmitter, listener: &AudioListener) -> SpatialAudioOutput {
    if (emitter).is_playing == 0 {
        return SpatialAudioOutput { left_gain: 0.0, right_gain: 0.0, pitch_factor: (emitter).pitch };
    }

    let dx: Float = (emitter).x - (listener).x;
    let dy: Float = (emitter).y - (listener).y;
    let dz: Float = (emitter).z - (listener).z;
    let dist: Float = sqrt(((dx * dx) + (dy * dy)) + (dz * dz));

    // Distance attenuation
    let mut atten: Float = 1.0;
    if dist > (emitter).min_dist {
        if dist >= (emitter).max_dist {
            atten = 0.0;
        } else {
            let range: Float = (emitter).max_dist - (emitter).min_dist;
            let rel_d: Float = (dist - (emitter).min_dist) / (if range > 0.001 { range } else { 1.0 });

            if (emitter).falloff_model == 0 { // Linear
                atten = 1.0 - rel_d;
            } else {
                if (emitter).falloff_model == 1 { // Inverse Square
                    atten = 1.0 / (1.0 + (rel_d * rel_d * 4.0));
                } else { // Exponential
                    atten = 1.0 / (1.0 + (rel_d * 8.0));
                }
            }
        }
    }

    let vol: Float = (emitter).base_volume * atten;

    // Stereo Panning based on relative X offset to listener
    let pan_raw: Float = if dist > 0.0001 { dx / dist } else { 0.0 };
    let clamped_pan: Float = if pan_raw < -1.0 { -1.0 } else { if pan_raw > 1.0 { 1.0 } else { pan_raw } };

    let left: Float = vol * (0.5 * (1.0 - clamped_pan));
    let right: Float = vol * (0.5 * (1.0 + clamped_pan));

    return SpatialAudioOutput {
        left_gain: left,
        right_gain: right,
        pitch_factor: (emitter).pitch
    };
}

pub fn audio_emitter_doppler_factor(emitter_speed: Float, listener_speed: Float, speed_of_sound: Float) -> Float {
    let c: Float = if speed_of_sound > 0.0 { speed_of_sound } else { 343.0 };
    let numerator: Float = c + listener_speed;
    let denominator: Float = c + emitter_speed;
    if denominator <= 0.0001 {
        return 1.0;
    }
    return numerator / denominator;
}
