// # ECS Entity Management & Generational Indexing
//
// Logline: Manages entity lifecycles, generational indices, component mask attachments, and recycled ID pools.
//
// Setup: Generational entity handles and allocation tracker importing ecs_component.oo.
//
// Beats:
//   1. Represent entity slots with generation counters, active flags, and component bitmasks.
//   2. Provide bitmask query tests and component addition/removal transformations.
//   3. Implement entity allocator state with capacity guards and recycled ID handling.

import "./ecs_component.oo";

// -------------------------------------------------------------------
// Entity Record & Generational Identifier
// -------------------------------------------------------------------

pub type EntityRecord = struct {
    id: Int,
    generation: Int,
    active: Int,
    component_mask: Int,
};

pub fn entity_record_new(id: Int, generation: Int) -> EntityRecord {
    return EntityRecord {
        id: id,
        generation: generation,
        active: 1,
        component_mask: 0,
    };
}

pub fn entity_record_inactive(id: Int, generation: Int) -> EntityRecord {
    return EntityRecord {
        id: id,
        generation: generation,
        active: 0,
        component_mask: 0,
    };
}

pub fn entity_is_active(record: &EntityRecord) -> Int {
    return (record).active;
}

pub fn entity_has_component(record: &EntityRecord, mask: Int) -> Int {
    if (record).active == 0 {
        return 0;
    }
    let combined: Int = (record).component_mask & mask;
    if combined == mask {
        return 1;
    }
    return 0;
}

pub fn entity_has_any_component(record: &EntityRecord, mask: Int) -> Int {
    if (record).active == 0 {
        return 0;
    }
    let combined: Int = (record).component_mask & mask;
    if combined > 0 {
        return 1;
    }
    return 0;
}

pub fn entity_add_component_mask(record: EntityRecord, mask: Int) -> EntityRecord {
    let new_mask: Int = (record).component_mask | mask;
    return EntityRecord {
        id: (record).id,
        generation: (record).generation,
        active: (record).active,
        component_mask: new_mask,
    };
}

pub fn entity_remove_component_mask(record: EntityRecord, mask: Int) -> EntityRecord {
    let inv_mask: Int = component_mask_all() - mask;
    let new_mask: Int = (record).component_mask & inv_mask;
    return EntityRecord {
        id: (record).id,
        generation: (record).generation,
        active: (record).active,
        component_mask: new_mask,
    };
}

pub fn entity_recycle(record: EntityRecord) -> EntityRecord {
    return EntityRecord {
        id: (record).id,
        generation: (record).generation + 1,
        active: 0,
        component_mask: 0,
    };
}

// -------------------------------------------------------------------
// Entity Manager & Slot Tracker
// -------------------------------------------------------------------

pub type EntityManager = struct {
    capacity: Int,
    active_count: Int,
    next_id: Int,
    recycled_count: Int,
};

pub fn entity_manager_new(capacity: Int) -> EntityManager {
    return EntityManager {
        capacity: capacity,
        active_count: 0,
        next_id: 0,
        recycled_count: 0,
    };
}

pub fn entity_manager_can_allocate(mgr: &EntityManager) -> Int {
    if (mgr).active_count >= (mgr).capacity {
        return 0;
    }
    return 1;
}

pub fn entity_manager_allocate_id(mgr: &EntityManager) -> Int {
    if (mgr).active_count >= (mgr).capacity {
        return -1;
    }
    return (mgr).next_id;
}

pub fn entity_manager_on_created(mgr: EntityManager) -> EntityManager {
    return EntityManager {
        capacity: (mgr).capacity,
        active_count: (mgr).active_count + 1,
        next_id: (mgr).next_id + 1,
        recycled_count: (mgr).recycled_count,
    };
}

pub fn entity_manager_on_destroyed(mgr: EntityManager) -> EntityManager {
    let new_count: Int = if (mgr).active_count > 0 { (mgr).active_count - 1 } else { 0 };
    return EntityManager {
        capacity: (mgr).capacity,
        active_count: new_count,
        next_id: (mgr).next_id,
        recycled_count: (mgr).recycled_count + 1,
    };
}

pub fn entity_manager_reset(capacity: Int) -> EntityManager {
    return entity_manager_new(capacity);
}
