// # Circle, Sphere & Capsule Narrowphase Collision
//
// Logline: Solves contact manifolds, penetration depths, and normals for circles, spheres, capsules, and AABBs.
//
// Setup: Radial proximity and geometric projection algorithms importing collision_aabb.oo.
//
// Beats:
//   1. Define 2D circle, 3D sphere, and 2D capsule bounding primitive structures.
//   2. Compute circle-circle and sphere-sphere overlap and contact manifolds.
//   3. Implement circle-to-AABB and capsule-to-circle closest point clamping algorithms.

import "./collision_aabb.oo";

// -------------------------------------------------------------------
// Radial Geometric Primitives
// -------------------------------------------------------------------

pub type Circle2D = struct {
    cx: Float,
    cy: Float,
    radius: Float
};

pub type Sphere3D = struct {
    cx: Float,
    cy: Float,
    cz: Float,
    radius: Float
};

pub type Capsule2D = struct {
    ax: Float,
    ay: Float,
    bx: Float,
    by: Float,
    radius: Float
};

pub type CircleContact = struct {
    has_collision: Int,
    penetration: Float,
    normal_x: Float,
    normal_y: Float,
    point_x: Float,
    point_y: Float
};

// -------------------------------------------------------------------
// Circle Constructors & Tests
// -------------------------------------------------------------------

pub fn circle2d_new(cx: Float, cy: Float, radius: Float) -> Circle2D {
    return Circle2D {
        cx: cx,
        cy: cy,
        radius: radius
    };
}

pub fn circle2d_contains_point(c: &Circle2D, px: Float, py: Float) -> Int {
    let dx: Float = px - (c).cx;
    let dy: Float = py - (c).cy;
    let dist_sq: Float = (dx * dx) + (dy * dy);
    if dist_sq <= ((c).radius * (c).radius) {
        return 1;
    }
    return 0;
}

pub fn circle2d_overlaps_circle2d(a: &Circle2D, b: &Circle2D) -> Int {
    let dx: Float = (b).cx - (a).cx;
    let dy: Float = (b).cy - (a).cy;
    let dist_sq: Float = (dx * dx) + (dy * dy);
    let total_r: Float = (a).radius + (b).radius;
    if dist_sq <= (total_r * total_r) {
        return 1;
    }
    return 0;
}

pub fn circle2d_test_circle2d(a: &Circle2D, b: &Circle2D) -> CircleContact {
    let dx: Float = (b).cx - (a).cx;
    let dy: Float = (b).cy - (a).cy;
    let dist_sq: Float = (dx * dx) + (dy * dy);
    let total_r: Float = (a).radius + (b).radius;

    if dist_sq > (total_r * total_r) {
        return CircleContact { has_collision: 0, penetration: 0.0, normal_x: 0.0, normal_y: 0.0, point_x: 0.0, point_y: 0.0 };
    }

    let dist: Float = sqrt(dist_sq);
    let mut nx: Float = 1.0;
    let mut ny: Float = 0.0;
    if dist > 0.00001 {
        nx = dx / dist;
        ny = dy / dist;
    }

    let penetration: Float = total_r - dist;
    let px: Float = (a).cx + (nx * (a).radius);
    let py: Float = (a).cy + (ny * (a).radius);

    return CircleContact {
        has_collision: 1,
        penetration: penetration,
        normal_x: nx,
        normal_y: ny,
        point_x: px,
        point_y: py
    };
}

// -------------------------------------------------------------------
// Circle vs AABB Collision
// -------------------------------------------------------------------

pub fn circle2d_test_aabb2d(c: &Circle2D, box: &AABB2D) -> CircleContact {
    // Clamp circle center to box bounds
    let clamped_x: Float = if (c).cx < (box).min_x { (box).min_x } else { if (c).cx > (box).max_x { (box).max_x } else { (c).cx } };
    let clamped_y: Float = if (c).cy < (box).min_y { (box).min_y } else { if (c).cy > (box).max_y { (box).max_y } else { (c).cy } };

    let dx: Float = (c).cx - clamped_x;
    let dy: Float = (c).cy - clamped_y;
    let dist_sq: Float = (dx * dx) + (dy * dy);

    if dist_sq > ((c).radius * (c).radius) {
        return CircleContact { has_collision: 0, penetration: 0.0, normal_x: 0.0, normal_y: 0.0, point_x: 0.0, point_y: 0.0 };
    }

    let dist: Float = sqrt(dist_sq);
    let mut nx: Float = 0.0;
    let mut ny: Float = 1.0;
    if dist > 0.00001 {
        nx = dx / dist;
        ny = dy / dist;
    }

    let penetration: Float = (c).radius - dist;
    return CircleContact {
        has_collision: 1,
        penetration: penetration,
        normal_x: nx,
        normal_y: ny,
        point_x: clamped_x,
        point_y: clamped_y
    };
}

// -------------------------------------------------------------------
// 3D Sphere & Capsule Operations
// -------------------------------------------------------------------

pub fn sphere3d_new(cx: Float, cy: Float, cz: Float, radius: Float) -> Sphere3D {
    return Sphere3D {
        cx: cx,
        cy: cy,
        cz: cz,
        radius: radius
    };
}

pub fn sphere3d_overlaps_sphere3d(a: &Sphere3D, b: &Sphere3D) -> Int {
    let dx: Float = (b).cx - (a).cx;
    let dy: Float = (b).cy - (a).cy;
    let dz: Float = (b).cz - (a).cz;
    let dist_sq: Float = (dx * dx) + (dy * dy) + (dz * dz);
    let total_r: Float = (a).radius + (b).radius;
    if dist_sq <= (total_r * total_r) {
        return 1;
    }
    return 0;
}

pub fn capsule2d_new(ax: Float, ay: Float, bx: Float, by: Float, radius: Float) -> Capsule2D {
    return Capsule2D {
        ax: ax,
        ay: ay,
        bx: bx,
        by: by,
        radius: radius
    };
}

pub fn capsule2d_test_circle2d(cap: &Capsule2D, c: &Circle2D) -> CircleContact {
    let ab_x: Float = (cap).bx - (cap).ax;
    let ab_y: Float = (cap).by - (cap).ay;
    let ac_x: Float = (c).cx - (cap).ax;
    let ac_y: Float = (c).cy - (cap).ay;

    let len_sq: Float = (ab_x * ab_x) + (ab_y * ab_y);
    let mut t: Float = 0.0;
    if len_sq > 0.00001 {
        t = ((ac_x * ab_x) + (ac_y * ab_y)) / len_sq;
        if t < 0.0 { t = 0.0; }
        if t > 1.0 { t = 1.0; }
    }

    let closest_x: Float = (cap).ax + (ab_x * t);
    let closest_y: Float = (cap).ay + (ab_y * t);

    let seg_circle: Circle2D = circle2d_new(closest_x, closest_y, (cap).radius);
    return circle2d_test_circle2d(&seg_circle, c);
}
