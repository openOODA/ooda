// # User Input Management & Digital/Analog Actions
//
// Logline: Tracks keyboard bitmasks, frame-edge press/release transitions, mouse motion coordinates, and analog axes.
//
// Setup: Bitmask-driven input event sampler and mapping pipeline.
//
// Beats:
//   1. Declare standard digital key/button bitmask constants.
//   2. Track concurrent key hold, press edge, and release edge transitions per frame.
//   3. Manage pointer coordinates, delta vectors, and directional analog axes.

// -------------------------------------------------------------------
// Key & Button Bitmask Constants
// -------------------------------------------------------------------

pub fn input_key_space() -> Int { return 1; }
pub fn input_key_left() -> Int { return 2; }
pub fn input_key_right() -> Int { return 4; }
pub fn input_key_up() -> Int { return 8; }
pub fn input_key_down() -> Int { return 16; }
pub fn input_key_action_a() -> Int { return 32; }
pub fn input_key_action_b() -> Int { return 64; }
pub fn input_key_escape() -> Int { return 128; }

// -------------------------------------------------------------------
// Input State Representation
// -------------------------------------------------------------------

pub type InputState = struct {
    keys_down_mask: Int,
    keys_pressed_mask: Int,
    keys_released_mask: Int,
    mouse_x: Float,
    mouse_y: Float,
    mouse_dx: Float,
    mouse_dy: Float,
    mouse_wheel: Float,
    axis_horizontal: Float,
    axis_vertical: Float
};

// -------------------------------------------------------------------
// Constructors & Frame Transition Lifecycle
// -------------------------------------------------------------------

pub fn input_state_new() -> InputState {
    return InputState {
        keys_down_mask: 0,
        keys_pressed_mask: 0,
        keys_released_mask: 0,
        mouse_x: 0.0,
        mouse_y: 0.0,
        mouse_dx: 0.0,
        mouse_dy: 0.0,
        mouse_wheel: 0.0,
        axis_horizontal: 0.0,
        axis_vertical: 0.0
    };
}

pub fn input_state_begin_frame(
    curr: InputState,
    new_down_mask: Int,
    new_mx: Float,
    new_my: Float,
    wheel: Float
) -> InputState {
    let prev_down: Int = (curr).keys_down_mask;
    // Pressed = currently down but was NOT down previously
    let pressed: Int = new_down_mask & ((prev_down ^ 1023) | (prev_down ^ new_down_mask));
    // Released = was down previously but is NOT down currently
    let released: Int = prev_down & (new_down_mask ^ prev_down);

    let mdx: Float = new_mx - (curr).mouse_x;
    let mdy: Float = new_my - (curr).mouse_y;

    // Derive cardinal horizontal/vertical axes from keymasks
    let mut h: Float = 0.0;
    if (new_down_mask & input_key_right()) > 0 { h = h + 1.0; }
    if (new_down_mask & input_key_left()) > 0 { h = h - 1.0; }

    let mut v: Float = 0.0;
    if (new_down_mask & input_key_up()) > 0 { v = v + 1.0; }
    if (new_down_mask & input_key_down()) > 0 { v = v - 1.0; }

    return InputState {
        keys_down_mask: new_down_mask,
        keys_pressed_mask: pressed,
        keys_released_mask: released,
        mouse_x: new_mx,
        mouse_y: new_my,
        mouse_dx: mdx,
        mouse_dy: mdy,
        mouse_wheel: wheel,
        axis_horizontal: h,
        axis_vertical: v
    };
}

// -------------------------------------------------------------------
// Query Functions
// -------------------------------------------------------------------

pub fn input_is_key_down(state: &InputState, key_mask: Int) -> Int {
    if ((state).keys_down_mask & key_mask) > 0 {
        return 1;
    }
    return 0;
}

pub fn input_is_key_pressed(state: &InputState, key_mask: Int) -> Int {
    if ((state).keys_pressed_mask & key_mask) > 0 {
        return 1;
    }
    return 0;
}

pub fn input_is_key_released(state: &InputState, key_mask: Int) -> Int {
    if ((state).keys_released_mask & key_mask) > 0 {
        return 1;
    }
    return 0;
}

pub fn input_set_axes(state: InputState, h: Float, v: Float) -> InputState {
    return InputState {
        keys_down_mask: (state).keys_down_mask,
        keys_pressed_mask: (state).keys_pressed_mask,
        keys_released_mask: (state).keys_released_mask,
        mouse_x: (state).mouse_x,
        mouse_y: (state).mouse_y,
        mouse_dx: (state).mouse_dx,
        mouse_dy: (state).mouse_dy,
        mouse_wheel: (state).mouse_wheel,
        axis_horizontal: h,
        axis_vertical: v
    };
}
