// # Tilemap Grid Coordinate Spaces & Math
//
// Logline: Converts between 2D tile coordinates, index offsets, and continuous world space for orthogonal and isometric layouts.
//
// Setup: Grid projection and index mapping utilities for 2D tile engines.
//
// Beats:
//   1. Define tile coordinates, 2D world points, and grid dimension configurations.
//   2. Implement 1D array linear indexing and 2D grid bounds validation.
//   3. Compute bidirectional coordinate transformations for Orthogonal and Isometric projections.

// -------------------------------------------------------------------
// Grid Orientation Constants
// -------------------------------------------------------------------

pub fn grid_type_orthogonal() -> Int { return 0; }
pub fn grid_type_isometric() -> Int { return 1; }
pub fn grid_type_hex_pointy() -> Int { return 2; }
pub fn grid_type_hex_flat() -> Int { return 3; }

// -------------------------------------------------------------------
// Grid Structures
// -------------------------------------------------------------------

pub type TileCoord = struct {
    gx: Int,
    gy: Int
};

pub type TileCoordF = struct {
    gx: Float,
    gy: Float
};

pub type WorldPoint2D = struct {
    wx: Float,
    wy: Float
};

pub type TileGrid = struct {
    width: Int,
    height: Int,
    tile_width: Float,
    tile_height: Float,
    grid_orientation: Int
};

// -------------------------------------------------------------------
// Constructors & Linear Indexing
// -------------------------------------------------------------------

pub fn tile_grid_new(width: Int, height: Int, tile_w: Float, tile_h: Float) -> TileGrid {
    return TileGrid {
        width: width,
        height: height,
        tile_width: tile_w,
        tile_height: tile_h,
        grid_orientation: 0
    };
}

pub fn tile_grid_with_orientation(width: Int, height: Int, tile_w: Float, tile_h: Float, orientation: Int) -> TileGrid {
    return TileGrid {
        width: width,
        height: height,
        tile_width: tile_w,
        tile_height: tile_h,
        grid_orientation: orientation
    };
}

pub fn tile_grid_in_bounds(grid: &TileGrid, gx: Int, gy: Int) -> Int {
    if gx < 0 { return 0; }
    if gx >= (grid).width { return 0; }
    if gy < 0 { return 0; }
    if gy >= (grid).height { return 0; }
    return 1;
}

pub fn tile_grid_to_index(grid: &TileGrid, gx: Int, gy: Int) -> Int {
    if tile_grid_in_bounds(grid, gx, gy) == 0 {
        return 0 - 1;
    }
    return (gy * (grid).width) + gx;
}

pub fn tile_index_to_coord(grid: &TileGrid, index: Int) -> TileCoord {
    if index < 0 {
        return TileCoord { gx: 0 - 1, gy: 0 - 1 };
    }
    let gy: Int = index / (grid).width;
    let gx: Int = index - (gy * (grid).width);
    return TileCoord { gx: gx, gy: gy };
}

// -------------------------------------------------------------------
// Orthogonal Coordinate Projections
// -------------------------------------------------------------------

pub fn tile_grid_to_world_ortho(grid: &TileGrid, gx: Float, gy: Float) -> WorldPoint2D {
    return WorldPoint2D {
        wx: gx * (grid).tile_width,
        wy: gy * (grid).tile_height
    };
}

pub fn tile_world_to_grid_ortho(grid: &TileGrid, wx: Float, wy: Float) -> TileCoordF {
    let gx: Float = wx / (grid).tile_width;
    let gy: Float = wy / (grid).tile_height;
    return TileCoordF { gx: gx, gy: gy };
}

// -------------------------------------------------------------------
// Isometric Coordinate Projections
// -------------------------------------------------------------------

pub fn tile_grid_to_world_iso(grid: &TileGrid, gx: Float, gy: Float) -> WorldPoint2D {
    let half_w: Float = (grid).tile_width * 0.5;
    let half_h: Float = (grid).tile_height * 0.5;
    return WorldPoint2D {
        wx: (gx - gy) * half_w,
        wy: (gx + gy) * half_h
    };
}

pub fn tile_world_to_grid_iso(grid: &TileGrid, wx: Float, wy: Float) -> TileCoordF {
    let half_w: Float = (grid).tile_width * 0.5;
    let half_h: Float = (grid).tile_height * 0.5;
    let iso_x: Float = wx / half_w;
    let iso_y: Float = wy / half_h;
    let gx: Float = (iso_y + iso_x) * 0.5;
    let gy: Float = (iso_y - iso_x) * 0.5;
    return TileCoordF { gx: gx, gy: gy };
}
