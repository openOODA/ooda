// # A* (A-Star) Grid Pathfinding & Heuristics
//
// Logline: Implements A* graph search nodes, evaluation functions, and Manhattan, Euclidean, Octile, and Chebyshev heuristics.
//
// Setup: Grid search node structures and spatial heuristic distance estimators importing tilemap_grid.oo.
//
// Beats:
//   1. Define A* graph node state including G-cost, H-cost, F-cost, and parent back-pointers.
//   2. Implement 4 standard 2D pathfinding distance heuristics (Manhattan, Euclidean, Octile, Chebyshev).
//   3. Provide cost updater and search result summary records for path planning pipelines.

import "./tilemap_grid.oo";

// -------------------------------------------------------------------
// A* Search Node Structure
// -------------------------------------------------------------------

pub type AStarNode = struct {
    gx: Int,
    gy: Int,
    g_cost: Float,
    h_cost: Float,
    f_cost: Float,
    parent_index: Int,
    is_open: Int,
    is_closed: Int,
};

pub type AStarPathResult = struct {
    found: Int,
    total_cost: Float,
    node_count: Int,
};

pub fn astar_node_new(gx: Int, gy: Int) -> AStarNode {
    return AStarNode {
        gx: gx,
        gy: gy,
        g_cost: 1000000.0,
        h_cost: 0.0,
        f_cost: 1000000.0,
        parent_index: 0 - 1,
        is_open: 0,
        is_closed: 0,
    };
}

pub fn astar_calculate_f_cost(g_cost: Float, h_cost: Float) -> Float {
    return g_cost + h_cost;
}

pub fn astar_update_node_cost(node: AStarNode, g: Float, h: Float, parent: Int) -> AStarNode {
    return AStarNode {
        gx: (node).gx,
        gy: (node).gy,
        g_cost: g,
        h_cost: h,
        f_cost: g + h,
        parent_index: parent,
        is_open: 1,
        is_closed: (node).is_closed,
    };
}

pub fn astar_close_node(node: AStarNode) -> AStarNode {
    return AStarNode {
        gx: (node).gx,
        gy: (node).gy,
        g_cost: (node).g_cost,
        h_cost: (node).h_cost,
        f_cost: (node).f_cost,
        parent_index: (node).parent_index,
        is_open: 0,
        is_closed: 1,
    };
}

// -------------------------------------------------------------------
// Heuristic Distance Estimators
// -------------------------------------------------------------------

pub fn astar_abs(val: Float) -> Float {
    if val < 0.0 {
        return 0.0 - val;
    }
    return val;
}

pub fn astar_heuristic_manhattan(x1: Float, y1: Float, x2: Float, y2: Float) -> Float {
    let dx: Float = astar_abs(x2 - x1);
    let dy: Float = astar_abs(y2 - y1);
    return dx + dy;
}

pub fn astar_heuristic_euclidean(x1: Float, y1: Float, x2: Float, y2: Float) -> Float {
    let dx: Float = x2 - x1;
    let dy: Float = y2 - y1;
    return sqrt((dx * dx) + (dy * dy));
}

pub fn astar_heuristic_chebyshev(x1: Float, y1: Float, x2: Float, y2: Float) -> Float {
    let dx: Float = astar_abs(x2 - x1);
    let dy: Float = astar_abs(y2 - y1);
    if dx > dy {
        return dx;
    }
    return dy;
}

pub fn astar_heuristic_octile(x1: Float, y1: Float, x2: Float, y2: Float) -> Float {
    let dx: Float = astar_abs(x2 - x1);
    let dy: Float = astar_abs(y2 - y1);
    let d_diag: Float = if dx < dy { dx } else { dy };
    let d_straight: Float = if dx > dy { dx - dy } else { dy - dx };
    // sqrt(2) ~ 1.41421356
    return (1.41421356 * d_diag) + d_straight;
}

// -------------------------------------------------------------------
// Result Containers
// -------------------------------------------------------------------

pub fn astar_result_success(cost: Float, count: Int) -> AStarPathResult {
    return AStarPathResult {
        found: 1,
        total_cost: cost,
        node_count: count,
    };
}

pub fn astar_result_not_found() -> AStarPathResult {
    return AStarPathResult {
        found: 0,
        total_cost: 0.0,
        node_count: 0,
    };
}
