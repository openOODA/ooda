// # 2D Camera Viewport & Smooth Follow
//
// Logline: Manages 2D camera panning, smooth damping, zoom transformations, deadzones, and world-screen coordinate conversions.
//
// Setup: Viewport projection and tracking matrix calculations for 2D game scenes.
//
// Beats:
//   1. Define 2D camera viewport state, tracking targets, and smooth damp coefficients.
//   2. Compute target tracking updates with deadzone threshold clamping.
//   3. Transform bidirectionally between World Space and Screen Viewport Space.

// -------------------------------------------------------------------
// Camera 2D Types
// -------------------------------------------------------------------

pub type CamVec2 = struct {
    x: Float,
    y: Float,
};

pub type Camera2D = struct {
    x: Float,
    y: Float,
    target_x: Float,
    target_y: Float,
    zoom: Float,
    rotation_rad: Float,
    viewport_w: Float,
    viewport_h: Float,
    smooth_speed: Float,
    deadzone_w: Float,
    deadzone_h: Float,
};

// -------------------------------------------------------------------
// Constructors & Setters
// -------------------------------------------------------------------

pub fn camera_2d_new(viewport_w: Float, viewport_h: Float) -> Camera2D {
    return Camera2D {
        x: 0.0,
        y: 0.0,
        target_x: 0.0,
        target_y: 0.0,
        zoom: 1.0,
        rotation_rad: 0.0,
        viewport_w: viewport_w,
        viewport_h: viewport_h,
        smooth_speed: 5.0,
        deadzone_w: 20.0,
        deadzone_h: 20.0,
    };
}

pub fn camera_2d_set_target(cam: Camera2D, tx: Float, ty: Float) -> Camera2D {
    return Camera2D {
        x: (cam).x,
        y: (cam).y,
        target_x: tx,
        target_y: ty,
        zoom: (cam).zoom,
        rotation_rad: (cam).rotation_rad,
        viewport_w: (cam).viewport_w,
        viewport_h: (cam).viewport_h,
        smooth_speed: (cam).smooth_speed,
        deadzone_w: (cam).deadzone_w,
        deadzone_h: (cam).deadzone_h,
    };
}

pub fn camera_2d_set_zoom(cam: Camera2D, zoom: Float) -> Camera2D {
    let clamped_z: Float = if zoom < 0.01 { 0.01 } else { if zoom > 100.0 { 100.0 } else { zoom } };
    return Camera2D {
        x: (cam).x,
        y: (cam).y,
        target_x: (cam).target_x,
        target_y: (cam).target_y,
        zoom: clamped_z,
        rotation_rad: (cam).rotation_rad,
        viewport_w: (cam).viewport_w,
        viewport_h: (cam).viewport_h,
        smooth_speed: (cam).smooth_speed,
        deadzone_w: (cam).deadzone_w,
        deadzone_h: (cam).deadzone_h,
    };
}

// -------------------------------------------------------------------
// Camera Smooth Tracking Update
// -------------------------------------------------------------------

pub fn camera_2d_update(cam: Camera2D, dt: Float) -> Camera2D {
    let dx: Float = (cam).target_x - (cam).x;
    let dy: Float = (cam).target_y - (cam).y;

    let abs_dx: Float = if dx < 0.0 { 0.0 - dx } else { dx };
    let abs_dy: Float = if dy < 0.0 { 0.0 - dy } else { dy };

    let mut move_x: Float = 0.0;
    let mut move_y: Float = 0.0;

    if abs_dx > (cam).deadzone_w {
        move_x = (dx - (if dx > 0.0 { (cam).deadzone_w } else { 0.0 - (cam).deadzone_w })) * (cam).smooth_speed * dt;
    }
    if abs_dy > (cam).deadzone_h {
        move_y = (dy - (if dy > 0.0 { (cam).deadzone_h } else { 0.0 - (cam).deadzone_h })) * (cam).smooth_speed * dt;
    }

    return Camera2D {
        x: (cam).x + move_x,
        y: (cam).y + move_y,
        target_x: (cam).target_x,
        target_y: (cam).target_y,
        zoom: (cam).zoom,
        rotation_rad: (cam).rotation_rad,
        viewport_w: (cam).viewport_w,
        viewport_h: (cam).viewport_h,
        smooth_speed: (cam).smooth_speed,
        deadzone_w: (cam).deadzone_w,
        deadzone_h: (cam).deadzone_h,
    };
}

// -------------------------------------------------------------------
// Coordinate Transformations
// -------------------------------------------------------------------

pub fn camera_2d_world_to_screen(cam: &Camera2D, wx: Float, wy: Float) -> CamVec2 {
    let half_vw: Float = (cam).viewport_w * 0.5;
    let half_vh: Float = (cam).viewport_h * 0.5;
    let rel_x: Float = (wx - (cam).x) * (cam).zoom;
    let rel_y: Float = (wy - (cam).y) * (cam).zoom;

    return CamVec2 {
        x: half_vw + rel_x,
        y: half_vh + rel_y,
    };
}

pub fn camera_2d_screen_to_world(cam: &Camera2D, sx: Float, sy: Float) -> CamVec2 {
    let half_vw: Float = (cam).viewport_w * 0.5;
    let half_vh: Float = (cam).viewport_h * 0.5;
    let inv_zoom: Float = if (cam).zoom > 0.00001 { 1.0 / (cam).zoom } else { 1.0 };
    let rel_x: Float = (sx - half_vw) * inv_zoom;
    let rel_y: Float = (sy - half_vh) * inv_zoom;

    return CamVec2 {
        x: (cam).x + rel_x,
        y: (cam).y + rel_y,
    };
}
