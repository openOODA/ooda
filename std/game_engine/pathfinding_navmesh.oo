// # Navigation Mesh (NavMesh) & Funnel Smoothing
//
// Logline: Manages convex navigation polygons, portal edge crossings, and funnel-based string pulling path smoothing.
//
// Setup: Geometric representations for 2D polygonal navigation meshes.
//
// Beats:
//   1. Define NavMesh convex polygons and bounding radii.
//   2. Represent portal edges connecting adjacent traversable polygons.
//   3. Implement 2D signed triangle orientation tests for funnel algorithm path refinement.

// -------------------------------------------------------------------
// NavMesh Types & Polygons
// -------------------------------------------------------------------

pub type NavMeshVertex = struct {
    x: Float,
    y: Float
};

pub type NavMeshPoly = struct {
    poly_id: Int,
    center_x: Float,
    center_y: Float,
    radius: Float,
    vertex_count: Int,
    neighbor_count: Int
};

pub type NavMeshPortal = struct {
    left_x: Float,
    left_y: Float,
    right_x: Float,
    right_y: Float
};

pub type NavMeshWayPoint = struct {
    x: Float,
    y: Float
};

// -------------------------------------------------------------------
// Polygon Constructors & Proximity Tests
// -------------------------------------------------------------------

pub fn navmesh_poly_new(poly_id: Int, cx: Float, cy: Float, radius: Float) -> NavMeshPoly {
    return NavMeshPoly {
        poly_id: poly_id,
        center_x: cx,
        center_y: cy,
        radius: radius,
        vertex_count: 3,
        neighbor_count: 0
    };
}

pub fn navmesh_poly_contains_radial(poly: &NavMeshPoly, px: Float, py: Float) -> Int {
    let dx: Float = px - (poly).center_x;
    let dy: Float = py - (poly).center_y;
    let dist_sq: Float = (dx * dx) + (dy * dy);
    if dist_sq <= ((poly).radius * (poly).radius) {
        return 1;
    }
    return 0;
}

pub fn navmesh_portal_new(lx: Float, ly: Float, rx: Float, ry: Float) -> NavMeshPortal {
    return NavMeshPortal {
        left_x: lx,
        left_y: ly,
        right_x: rx,
        right_y: ry
    };
}

// -------------------------------------------------------------------
// Funnel Algorithm Geometric Kernels
// -------------------------------------------------------------------

/// Computes the 2D signed area of triangle (A, B, C).
/// Positive = counterclockwise (left), Negative = clockwise (right), 0 = collinear.
pub fn navmesh_tri_area_2d(ax: Float, ay: Float, bx: Float, by: Float, cx: Float, cy: Float) -> Float {
    return ((bx - ax) * (cy - ay)) - ((by - ay) * (cx - ax));
}

pub fn navmesh_is_left_turn(ax: Float, ay: Float, bx: Float, by: Float, cx: Float, cy: Float) -> Int {
    let area: Float = navmesh_tri_area_2d(ax, ay, bx, by, cx, cy);
    if area > 0.00001 {
        return 1;
    }
    return 0;
}

pub fn navmesh_is_right_turn(ax: Float, ay: Float, bx: Float, by: Float, cx: Float, cy: Float) -> Int {
    let area: Float = navmesh_tri_area_2d(ax, ay, bx, by, cx, cy);
    if area < -0.00001 {
        return 1;
    }
    return 0;
}

pub fn navmesh_portal_width(portal: &NavMeshPortal) -> Float {
    let dx: Float = (portal).right_x - (portal).left_x;
    let dy: Float = (portal).right_y - (portal).left_y;
    return sqrt((dx * dx) + (dy * dy));
}

pub fn navmesh_portal_midpoint(portal: &NavMeshPortal) -> NavMeshWayPoint {
    return NavMeshWayPoint {
        x: ((portal).left_x + (portal).right_x) * 0.5,
        y: ((portal).left_y + (portal).right_y) * 0.5
    };
}
