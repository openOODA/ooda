// # ECS System Scheduling & Execution Logic
//
// Logline: Organizes phase-ordered system pipelines, execution scheduling, and foundational kinematic dispatch routines.
//
// Setup: Pipeline phases and system wrappers importing ecs_component.oo, ecs_entity.oo, and ecs_query.oo.
//
// Beats:
//   1. Define execution phases (Startup, PreUpdate, Update, Physics, PostUpdate, Render).
//   2. Manage system activation flags, priority ordering, and query filters.
//   3. Implement pure 2D kinematic transformation functions for velocity and gravity integration.

import "./ecs_component.oo";
import "./ecs_entity.oo";
import "./ecs_query.oo";

// -------------------------------------------------------------------
// System Execution Phases
// -------------------------------------------------------------------

pub fn system_phase_startup() -> Int { return 0; }
pub fn system_phase_pre_update() -> Int { return 1; }
pub fn system_phase_update() -> Int { return 2; }
pub fn system_phase_physics() -> Int { return 3; }
pub fn system_phase_post_update() -> Int { return 4; }
pub fn system_phase_render() -> Int { return 5; }

// -------------------------------------------------------------------
// System Descriptor & State
// -------------------------------------------------------------------

pub type EcsSystem = struct {
    id: Int,
    phase: Int,
    priority: Int,
    enabled: Int,
    required_mask: Int,
    execution_count: Int
};

pub fn ecs_system_new(id: Int, phase: Int, priority: Int, required_mask: Int) -> EcsSystem {
    return EcsSystem {
        id: id,
        phase: phase,
        priority: priority,
        enabled: 1,
        required_mask: required_mask,
        execution_count: 0
    };
}

pub fn ecs_system_enable(sys: EcsSystem) -> EcsSystem {
    return EcsSystem {
        id: (sys).id,
        phase: (sys).phase,
        priority: (sys).priority,
        enabled: 1,
        required_mask: (sys).required_mask,
        execution_count: (sys).execution_count
    };
}

pub fn ecs_system_disable(sys: EcsSystem) -> EcsSystem {
    return EcsSystem {
        id: (sys).id,
        phase: (sys).phase,
        priority: (sys).priority,
        enabled: 0,
        required_mask: (sys).required_mask,
        execution_count: (sys).execution_count
    };
}

pub fn ecs_system_should_run(sys: &EcsSystem, current_phase: Int) -> Int {
    if (sys).enabled == 0 {
        return 0;
    }
    if (sys).phase != current_phase {
        return 0;
    }
    return 1;
}

pub fn ecs_system_increment_runs(sys: EcsSystem) -> EcsSystem {
    return EcsSystem {
        id: (sys).id,
        phase: (sys).phase,
        priority: (sys).priority,
        enabled: (sys).enabled,
        required_mask: (sys).required_mask,
        execution_count: (sys).execution_count + 1
    };
}

// -------------------------------------------------------------------
// Kinematics & Physics Step Functions
// -------------------------------------------------------------------

pub fn ecs_system_step_movement_2d(t: Transform2D, v: Velocity2D, dt: Float) -> Transform2D {
    return Transform2D {
        x: (t).x + ((v).vx * dt),
        y: (t).y + ((v).vy * dt),
        rotation_rad: (t).rotation_rad + ((v).angular_vel * dt),
        scale_x: (t).scale_x,
        scale_y: (t).scale_y
    };
}

pub fn ecs_system_apply_gravity_2d(v: Velocity2D, gravity_y: Float, dt: Float) -> Velocity2D {
    return Velocity2D {
        vx: (v).vx,
        vy: (v).vy + (gravity_y * dt),
        angular_vel: (v).angular_vel
    };
}

pub fn ecs_system_apply_drag_2d(v: Velocity2D, linear_drag: Float, dt: Float) -> Velocity2D {
    let decay: Float = 1.0 - (linear_drag * dt);
    let factor: Float = if decay < 0.0 { 0.0 } else { decay };
    return Velocity2D {
        vx: (v).vx * factor,
        vy: (v).vy * factor,
        angular_vel: (v).angular_vel * factor
    };
}

// -------------------------------------------------------------------
// Scheduler Structure
// -------------------------------------------------------------------

pub type SystemScheduler = struct {
    system_count: Int,
    active_phase: Int,
    tick_index: Int
};

pub fn system_scheduler_new() -> SystemScheduler {
    return SystemScheduler {
        system_count: 0,
        active_phase: 0,
        tick_index: 0
    };
}

pub fn system_scheduler_set_phase(sched: SystemScheduler, phase: Int) -> SystemScheduler {
    return SystemScheduler {
        system_count: (sched).system_count,
        active_phase: phase,
        tick_index: (sched).tick_index
    };
}

pub fn system_scheduler_next_tick(sched: SystemScheduler) -> SystemScheduler {
    return SystemScheduler {
        system_count: (sched).system_count,
        active_phase: 0,
        tick_index: (sched).tick_index + 1
    };
}
