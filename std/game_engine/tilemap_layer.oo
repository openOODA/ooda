// # Tilemap Multi-Layer & Autotiling Rules
//
// Logline: Manages multi-layered tilemap properties, parallax scroll multipliers, visibility masks, and 4-bit autotile evaluation.
//
// Setup: Layer configurations and topological neighborhood matching importing tilemap_grid.oo.
//
// Beats:
//   1. Represent tilemap layer metadata including parallax coefficients and collision flags.
//   2. Compute 4-bit cardinal autotile bitmasks from adjacent neighbor occupation states.
//   3. Map autotiling bit patterns to standard tileset lookup indices.

import "./tilemap_grid.oo";

// -------------------------------------------------------------------
// Tile Layer Configuration
// -------------------------------------------------------------------

pub type TileLayer = struct {
    layer_id: Int,
    width: Int,
    height: Int,
    visible: Int,
    opacity: Float,
    parallax_x: Float,
    parallax_y: Float,
    collision_enabled: Int
};

pub fn tile_layer_new(layer_id: Int, width: Int, height: Int) -> TileLayer {
    return TileLayer {
        layer_id: layer_id,
        width: width,
        height: height,
        visible: 1,
        opacity: 1.0,
        parallax_x: 1.0,
        parallax_y: 1.0,
        collision_enabled: 0
    };
}

pub fn tile_layer_with_parallax(
    layer_id: Int,
    width: Int,
    height: Int,
    px: Float,
    py: Float,
    has_collision: Int
) -> TileLayer {
    return TileLayer {
        layer_id: layer_id,
        width: width,
        height: height,
        visible: 1,
        opacity: 1.0,
        parallax_x: px,
        parallax_y: py,
        collision_enabled: has_collision
    };
}

pub fn tile_layer_set_visible(layer: TileLayer, visible: Int) -> TileLayer {
    return TileLayer {
        layer_id: (layer).layer_id,
        width: (layer).width,
        height: (layer).height,
        visible: visible,
        opacity: (layer).opacity,
        parallax_x: (layer).parallax_x,
        parallax_y: (layer).parallax_y,
        collision_enabled: (layer).collision_enabled
    };
}

pub fn tile_layer_set_opacity(layer: TileLayer, opacity: Float) -> TileLayer {
    let clamped: Float = if opacity < 0.0 { 0.0 } else { if opacity > 1.0 { 1.0 } else { opacity } };
    return TileLayer {
        layer_id: (layer).layer_id,
        width: (layer).width,
        height: (layer).height,
        visible: (layer).visible,
        opacity: clamped,
        parallax_x: (layer).parallax_x,
        parallax_y: (layer).parallax_y,
        collision_enabled: (layer).collision_enabled
    };
}

pub fn tile_layer_tile_count(layer: &TileLayer) -> Int {
    return (layer).width * (layer).height;
}

// -------------------------------------------------------------------
// 4-Bit Cardinal Autotiling Rules
// -------------------------------------------------------------------

pub type AutotileMask = struct {
    north: Int,
    east: Int,
    south: Int,
    west: Int,
    mask_val: Int
};

pub fn autotile_mask_4bit(north: Int, east: Int, south: Int, west: Int) -> AutotileMask {
    // 4-bit standard: N=1, E=2, S=4, W=8
    let n_bit: Int = if north > 0 { 1 } else { 0 };
    let e_bit: Int = if east > 0 { 2 } else { 0 };
    let s_bit: Int = if south > 0 { 4 } else { 0 };
    let w_bit: Int = if west > 0 { 8 } else { 0 };
    let total_mask: Int = (n_bit | e_bit) | (s_bit | w_bit);

    return AutotileMask {
        north: n_bit,
        east: e_bit,
        south: s_bit,
        west: w_bit,
        mask_val: total_mask
    };
}

pub fn autotile_index_from_mask(mask: &AutotileMask) -> Int {
    return (mask).mask_val;
}

pub fn autotile_is_isolated(mask: &AutotileMask) -> Int {
    if (mask).mask_val == 0 {
        return 1;
    }
    return 0;
}

pub fn autotile_is_surrounded(mask: &AutotileMask) -> Int {
    if (mask).mask_val == 15 {
        return 1;
    }
    return 0;
}
