// # Particle Emitter Generation & Timing
//
// Logline: Regulates continuous emission rates, burst discharges, angular dispersion, and initial particle parameters.
//
// Setup: Rate accumulators and spawn generators importing particle_particle.oo.
//
// Beats:
//   1. Configure 3D emitter position, emission frequencies, lifetime ranges, and spread angles.
//   2. Accumulate delta time to compute discrete particle spawn triggers.
//   3. Generate initialized particles with directional velocity vectors and gravity bias.

import "./particle_particle.oo";

// -------------------------------------------------------------------
// Particle Emitter Configuration
// -------------------------------------------------------------------

pub type ParticleEmitter = struct {
    emitter_id: Int,
    pos_x: Float,
    pos_y: Float,
    pos_z: Float,
    emit_rate: Float,
    spawn_accum: Float,
    burst_count: Int,
    min_life: Float,
    max_life: Float,
    min_speed: Float,
    max_speed: Float,
    spread_angle_rad: Float,
    gravity_y: Float,
    is_active: Int,
};

// -------------------------------------------------------------------
// Constructors & Setters
// -------------------------------------------------------------------

pub fn particle_emitter_new(emitter_id: Int, px: Float, py: Float, pz: Float) -> ParticleEmitter {
    return ParticleEmitter {
        emitter_id: emitter_id,
        pos_x: px,
        pos_y: py,
        pos_z: pz,
        emit_rate: 50.0, // 50 particles/sec
        spawn_accum: 0.0,
        burst_count: 0,
        min_life: 0.5,
        max_life: 2.0,
        min_speed: 10.0,
        max_speed: 25.0,
        spread_angle_rad: 0.785398, // 45 deg cone
        gravity_y: -9.81,
        is_active: 1,
    };
}

pub fn particle_emitter_set_rate(emitter: ParticleEmitter, rate: Float) -> ParticleEmitter {
    return ParticleEmitter {
        emitter_id: (emitter).emitter_id,
        pos_x: (emitter).pos_x,
        pos_y: (emitter).pos_y,
        pos_z: (emitter).pos_z,
        emit_rate: rate,
        spawn_accum: (emitter).spawn_accum,
        burst_count: (emitter).burst_count,
        min_life: (emitter).min_life,
        max_life: (emitter).max_life,
        min_speed: (emitter).min_speed,
        max_speed: (emitter).max_speed,
        spread_angle_rad: (emitter).spread_angle_rad,
        gravity_y: (emitter).gravity_y,
        is_active: (emitter).is_active,
    };
}

pub fn particle_emitter_set_speed_range(emitter: ParticleEmitter, min_s: Float, max_s: Float) -> ParticleEmitter {
    return ParticleEmitter {
        emitter_id: (emitter).emitter_id,
        pos_x: (emitter).pos_x,
        pos_y: (emitter).pos_y,
        pos_z: (emitter).pos_z,
        emit_rate: (emitter).emit_rate,
        spawn_accum: (emitter).spawn_accum,
        burst_count: (emitter).burst_count,
        min_life: (emitter).min_life,
        max_life: (emitter).max_life,
        min_speed: min_s,
        max_speed: max_s,
        spread_angle_rad: (emitter).spread_angle_rad,
        gravity_y: (emitter).gravity_y,
        is_active: (emitter).is_active,
    };
}

// -------------------------------------------------------------------
// Emitter Simulation Step
// -------------------------------------------------------------------

pub fn particle_emitter_update(emitter: ParticleEmitter, dt: Float) -> ParticleEmitter {
    if (emitter).is_active == 0 {
        return emitter;
    }
    let new_accum: Float = (emitter).spawn_accum + (dt * (emitter).emit_rate);
    return ParticleEmitter {
        emitter_id: (emitter).emitter_id,
        pos_x: (emitter).pos_x,
        pos_y: (emitter).pos_y,
        pos_z: (emitter).pos_z,
        emit_rate: (emitter).emit_rate,
        spawn_accum: new_accum,
        burst_count: (emitter).burst_count,
        min_life: (emitter).min_life,
        max_life: (emitter).max_life,
        min_speed: (emitter).min_speed,
        max_speed: (emitter).max_speed,
        spread_angle_rad: (emitter).spread_angle_rad,
        gravity_y: (emitter).gravity_y,
        is_active: (emitter).is_active,
    };
}

pub fn particle_emitter_should_spawn(emitter: &ParticleEmitter) -> Int {
    if (emitter).spawn_accum >= 1.0 {
        return 1;
    }
    return 0;
}

pub fn particle_emitter_consume_spawn(emitter: ParticleEmitter) -> ParticleEmitter {
    let remaining: Float = (emitter).spawn_accum - 1.0;
    return ParticleEmitter {
        emitter_id: (emitter).emitter_id,
        pos_x: (emitter).pos_x,
        pos_y: (emitter).pos_y,
        pos_z: (emitter).pos_z,
        emit_rate: (emitter).emit_rate,
        spawn_accum: if remaining < 0.0 { 0.0 } else { remaining },
        burst_count: (emitter).burst_count,
        min_life: (emitter).min_life,
        max_life: (emitter).max_life,
        min_speed: (emitter).min_speed,
        max_speed: (emitter).max_speed,
        spread_angle_rad: (emitter).spread_angle_rad,
        gravity_y: (emitter).gravity_y,
        is_active: (emitter).is_active,
    };
}

pub fn particle_emitter_spawn_particle(emitter: &ParticleEmitter, angle_deg: Float) -> Particle {
    let rad: Float = (angle_deg * 3.14159265) / 180.0;
    let speed: Float = ((emitter).min_speed + (emitter).max_speed) * 0.5;
    let avg_life: Float = ((emitter).min_life + (emitter).max_life) * 0.5;

    let vx: Float = sin(rad) * speed;
    let vy: Float = cos(rad) * speed;

    let mut p: Particle = particle_new(
        (emitter).pos_x,
        (emitter).pos_y,
        (emitter).pos_z,
        vx,
        vy,
        0.0,
        avg_life
    );

    return Particle {
        x: (p).x,
        y: (p).y,
        z: (p).z,
        vx: (p).vx,
        vy: (p).vy,
        vz: (p).vz,
        ax: 0.0,
        ay: (emitter).gravity_y,
        az: 0.0,
        size: 2.0,
        alpha: 1.0,
        r: 1.0,
        g: 0.8,
        b: 0.2,
        age: 0.0,
        life: avg_life,
        active: 1,
    };
}
