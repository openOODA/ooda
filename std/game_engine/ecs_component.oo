// # ECS Component Types & Data Layouts
//
// Logline: Defines bitmask identifiers, component structs (Transform, Velocity, Sprite, Collider, RigidBody, Camera), and initialization helpers.
//
// Setup: Pure data representations for Entity Component System architectures in 2D and 3D simulations.
//
// Beats:
//   1. Declare standard 32-bit component type bitmasks.
//   2. Define 2D and 3D spatial, kinematic, graphical, and physical component structures.
//   3. Provide ergonomic factory functions for component instantiation and defaults.

// -------------------------------------------------------------------
// Component Bitmask Constants
// -------------------------------------------------------------------

pub fn component_mask_none() -> Int { return 0; }
pub fn component_mask_transform_2d() -> Int { return 1; }
pub fn component_mask_velocity_2d() -> Int { return 2; }
pub fn component_mask_transform_3d() -> Int { return 4; }
pub fn component_mask_velocity_3d() -> Int { return 8; }
pub fn component_mask_sprite() -> Int { return 16; }
pub fn component_mask_collider() -> Int { return 32; }
pub fn component_mask_rigidbody() -> Int { return 64; }
pub fn component_mask_camera() -> Int { return 128; }
pub fn component_mask_audio() -> Int { return 256; }
pub fn component_mask_emitter() -> Int { return 512; }
pub fn component_mask_all() -> Int { return 1023; }

// -------------------------------------------------------------------
// Component Structures
// -------------------------------------------------------------------

pub type Transform2D = struct {
    x: Float,
    y: Float,
    rotation_rad: Float,
    scale_x: Float,
    scale_y: Float
};

pub type Velocity2D = struct {
    vx: Float,
    vy: Float,
    angular_vel: Float
};

pub type Transform3D = struct {
    x: Float,
    y: Float,
    z: Float,
    rx: Float,
    ry: Float,
    rz: Float,
    sx: Float,
    sy: Float,
    sz: Float
};

pub type Velocity3D = struct {
    vx: Float,
    vy: Float,
    vz: Float,
    wx: Float,
    wy: Float,
    wz: Float
};

pub type SpriteComponent = struct {
    texture_id: Int,
    u0: Float,
    v0: Float,
    u1: Float,
    v1: Float,
    width: Float,
    height: Float,
    z_order: Int,
    visible: Int,
    r: Float,
    g: Float,
    b: Float,
    a: Float
};

pub type ColliderComponent = struct {
    shape_type: Int,
    half_w: Float,
    half_h: Float,
    radius: Float,
    is_trigger: Int,
    layer_mask: Int
};

pub type RigidBody2DComponent = struct {
    mass: Float,
    inv_mass: Float,
    restitution: Float,
    friction: Float,
    is_static: Int,
    gravity_scale: Float
};

pub type CameraComponent = struct {
    zoom: Float,
    fov_deg: Float,
    is_active: Int,
    viewport_w: Float,
    viewport_h: Float
};

// -------------------------------------------------------------------
// Constructor & Helper Functions
// -------------------------------------------------------------------

pub fn transform2d_new(x: Float, y: Float) -> Transform2D {
    return Transform2D {
        x: x,
        y: y,
        rotation_rad: 0.0,
        scale_x: 1.0,
        scale_y: 1.0
    };
}

pub fn transform2d_with_scale(x: Float, y: Float, rot: Float, sx: Float, sy: Float) -> Transform2D {
    return Transform2D {
        x: x,
        y: y,
        rotation_rad: rot,
        scale_x: sx,
        scale_y: sy
    };
}

pub fn velocity2d_new(vx: Float, vy: Float) -> Velocity2D {
    return Velocity2D {
        vx: vx,
        vy: vy,
        angular_vel: 0.0
    };
}

pub fn transform3d_identity() -> Transform3D {
    return Transform3D {
        x: 0.0,
        y: 0.0,
        z: 0.0,
        rx: 0.0,
        ry: 0.0,
        rz: 0.0,
        sx: 1.0,
        sy: 1.0,
        sz: 1.0
    };
}

pub fn transform3d_new(x: Float, y: Float, z: Float) -> Transform3D {
    return Transform3D {
        x: x,
        y: y,
        z: z,
        rx: 0.0,
        ry: 0.0,
        rz: 0.0,
        sx: 1.0,
        sy: 1.0,
        sz: 1.0
    };
}

pub fn velocity3d_new(vx: Float, vy: Float, vz: Float) -> Velocity3D {
    return Velocity3D {
        vx: vx,
        vy: vy,
        vz: vz,
        wx: 0.0,
        wy: 0.0,
        wz: 0.0
    };
}

pub fn sprite_component_new(texture_id: Int, w: Float, h: Float) -> SpriteComponent {
    return SpriteComponent {
        texture_id: texture_id,
        u0: 0.0,
        v0: 0.0,
        u1: 1.0,
        v1: 1.0,
        width: w,
        height: h,
        z_order: 0,
        visible: 1,
        r: 1.0,
        g: 1.0,
        b: 1.0,
        a: 1.0
    };
}

pub fn collider_box_new(half_w: Float, half_h: Float) -> ColliderComponent {
    return ColliderComponent {
        shape_type: 0,
        half_w: half_w,
        half_h: half_h,
        radius: 0.0,
        is_trigger: 0,
        layer_mask: 1
    };
}

pub fn collider_circle_new(radius: Float) -> ColliderComponent {
    return ColliderComponent {
        shape_type: 1,
        half_w: 0.0,
        half_h: 0.0,
        radius: radius,
        is_trigger: 0,
        layer_mask: 1
    };
}

pub fn rigidbody2d_new(mass: Float, restitution: Float, friction: Float) -> RigidBody2DComponent {
    let inv_m: Float = if mass > 0.000001 { 1.0 / mass } else { 0.0 };
    let is_st: Int = if mass <= 0.000001 { 1 } else { 0 };
    return RigidBody2DComponent {
        mass: mass,
        inv_mass: inv_m,
        restitution: restitution,
        friction: friction,
        is_static: is_st,
        gravity_scale: 1.0
    };
}

pub fn camera_component_new(viewport_w: Float, viewport_h: Float) -> CameraComponent {
    return CameraComponent {
        zoom: 1.0,
        fov_deg: 60.0,
        is_active: 1,
        viewport_w: viewport_w,
        viewport_h: viewport_h
    };
}
