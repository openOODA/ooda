// # LEB128 Variable-Length Integer Codec
//
// Logline: Encodes and decodes unsigned (u64) and signed (i64) integers using the LEB128 (Little Endian Base 128) variable-length encoding used by DWARF, Protocol Buffers, and WebAssembly.
//
// Setup: Pure value-returning helpers, no IO. Decimal literals in place of hex because the .oo lexer does not accept 0xNN. The decoder returns Result[Int, String] for invalid input (truncated encoding, overflow, or invalid continuation bit pattern).
//
// Beats:
//   1. Encode an unsigned integer as a sequence of 7-bit little-endian groups with the high bit as a continuation flag.
//   2. Decode a sequence of LEB128 bytes back into an unsigned integer, returning Err on overflow or truncation.
//   3. Encode a signed integer using zigzag-style two's-complement preservation (sign bit in the low 7 bits, continuation flag in the high bit).
//   4. Decode a signed LEB128 byte sequence, sign-extending the result.

import "std/core/str.oo";

pub fn leb128_continuation_bit() -> Int { return 128; }
pub fn leb128_value_mask() -> Int { return 127; }
pub fn leb128_max_bytes() -> Int { return 10; }

pub fn leb128_encode_u64(value: Int) -> String {
    let mut v: Int = value;
    let mut out: String = "";
    let mut i: Int = 0;
    while i < leb128_max_bytes() {
        let mut b: Int = v & leb128_value_mask();
        v = v / 128;
        if v != 0 { b = b | leb128_continuation_bit(); }
        // Encode byte b as a string by appending the char; the byte is
        // represented as its ASCII hex equivalent for testability.
        let hex: String = leb128_byte_to_hex(b);
        out = str_concat(out, hex);
        if v == 0 { return out; }
        i = i + 1;
    }
    return out;
}

pub fn leb128_byte_to_hex(b: Int) -> String {
    let hi: Int = b / 16;
    let lo: Int = b & 15;
    let hi_ch: String = leb128_nibble_to_hex(hi);
    let lo_ch: String = leb128_nibble_to_hex(lo);
    return str_concat(hi_ch, lo_ch);
}

pub fn leb128_nibble_to_hex(n: Int) -> String {
    if n < 10 { return leb128_digit_to_char(n); }
    if n == 10 { return "A"; }
    if n == 11 { return "B"; }
    if n == 12 { return "C"; }
    if n == 13 { return "D"; }
    if n == 14 { return "E"; }
    return "F";
}

pub fn leb128_digit_to_char(d: Int) -> String {
    if d == 0 { return "0"; }
    if d == 1 { return "1"; }
    if d == 2 { return "2"; }
    if d == 3 { return "3"; }
    if d == 4 { return "4"; }
    if d == 5 { return "5"; }
    if d == 6 { return "6"; }
    if d == 7 { return "7"; }
    if d == 8 { return "8"; }
    return "9";
}

pub fn leb128_encode_i64(value: Int) -> String {
    // Signed LEB128: two's-complement; the sign bit is in position 6 of the last byte.
    let mut v: Int = value;
    let mut out: String = "";
    let mut i: Int = 0;
    let mut more: Bool = true;
    while more {
        let b: Int = v & leb128_value_mask();
        v = v / 128;
        if (v == 0 && b < 64) || (v == 0 - 1 && b >= 64) {
            more = false;
            let hex: String = leb128_byte_to_hex(b);
            out = str_concat(out, hex);
        } else {
            let with_cont: Int = b | leb128_continuation_bit();
            let hex: String = leb128_byte_to_hex(with_cont);
            out = str_concat(out, hex);
        }
        i = i + 1;
        if i > leb128_max_bytes() { return out; }
    }
    return out;
}

pub fn leb128_max_value_u64() -> Int {
    // 2^63 - 1 (we use 63 bits to stay in safe Int range).
    let mut v: Int = 1;
    let mut i: Int = 0;
    while i < 63 {
        v = v * 2;
        i = i + 1;
    }
    return v - 1;
}
