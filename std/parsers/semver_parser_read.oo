// # SemVer 2.0.0 core field reader
//
// Logline: Reads MAJOR.MINOR.PATCH, prerelease identifiers, and build metadata from a version string.
//
// Setup: Pure. Called from semver_parser.oo. Numeric identifiers reject leading zeros.
//
// Beats:
//   1. Parse three core integers.
//   2. Split prerelease identifiers on dots.
//   3. Capture build metadata after plus.

pub type SemVer = struct {
    flag: Int,
    err: String,
    major: Int,
    minor: Int,
    patch: Int,
    npre: Int,
    pres: List[String],
    bmeta: String
};

fn sv_nopre() -> List[String] {
    let p: List[String] = list_new();
    return p;
}

fn sv_err(m: String) -> SemVer {
    return SemVer { flag: 0, err: m, major: 0, minor: 0, patch: 0, npre: 0, pres: sv_nopre(), bmeta: "" };
}

fn sv_dig(c: Int) -> Int {
    if c >= 48 {
        if c <= 57 {
            return 1;
        }
    }
    return 0;
}

fn sv_ident_ok(c: Int) -> Int {
    if sv_dig(c) > 0 {
        return 1;
    }
    if c >= 65 {
        if c <= 90 {
            return 1;
        }
    }
    if c >= 97 {
        if c <= 122 {
            return 1;
        }
    }
    if c == 45 {
        return 1;
    }
    return 0;
}

fn sv_slice(s: String, a: Int, b: Int) -> String {
    let mut buf: List[Int] = bytes_new();
    let mut i: Int = a;
    while i < b {
        buf = bytes_push(buf, byte_at(s, i));
        i = i + 1;
    }
    return bytes_to_str(buf);
}

fn sv_num(s: String, i: Int, n: Int) -> SemVer {
    if i >= n {
        return sv_err("semver num");
    }
    if sv_dig(byte_at(s, i)) < 1 {
        return sv_err("semver num");
    }
    if byte_at(s, i) == 48 {
        if i + 1 < n {
            if sv_dig(byte_at(s, i + 1)) > 0 {
                return sv_err("semver zero");
            }
        }
    }
    let mut v: Int = 0;
    let mut j: Int = i;
    while j < n {
        if sv_dig(byte_at(s, j)) < 1 {
            break;
        }
        v = v * 10 + (byte_at(s, j) - 48);
        j = j + 1;
    }
    return SemVer { flag: 1, err: "", major: v, minor: j, patch: 0, npre: 0, pres: sv_nopre(), bmeta: "" };
}

fn sv_pre_id(s: String, a: Int, b: Int) -> Result[String, String] {
    if a >= b {
        return Err("semver pre");
    }
    let mut num: Int = 1;
    let mut i: Int = a;
    while i < b {
        if sv_ident_ok(byte_at(s, i)) < 1 {
            return Err("semver pre");
        }
        if sv_dig(byte_at(s, i)) < 1 {
            num = 0;
        }
        i = i + 1;
    }
    if num > 0 {
        if b - a > 1 {
            if byte_at(s, a) == 48 {
                return Err("semver zero");
            }
        }
    }
    return Ok(sv_slice(s, a, b));
}

fn sv_push_pre(pres: List[String], npre: Int, s: String, a: Int, b: Int) -> SemVer {
    let id: Result[String, String] = sv_pre_id(s, a, b);
    match id {
        Ok(p) => {
            return SemVer { flag: 1, err: "", major: 0, minor: 0, patch: 0, npre: npre + 1, pres: list_push(pres, p), bmeta: "" };
        },
        Err(e) => {
            return sv_err(e);
        }
    }
}

pub fn semver_parser_read_parse(s: String) -> SemVer {
    let n: Int = bytes_len(s);
    let a: SemVer = sv_num(s, 0, n);
    if a.flag < 1 {
        return a;
    }
    let mut i: Int = a.minor;
    if i >= n {
        return sv_err("semver dot");
    }
    if byte_at(s, i) != 46 {
        return sv_err("semver dot");
    }
    let b: SemVer = sv_num(s, i + 1, n);
    if b.flag < 1 {
        return b;
    }
    i = b.minor;
    if i >= n {
        return sv_err("semver dot");
    }
    if byte_at(s, i) != 46 {
        return sv_err("semver dot");
    }
    let c: SemVer = sv_num(s, i + 1, n);
    if c.flag < 1 {
        return c;
    }
    i = c.minor;
    let mut pres: List[String] = list_new();
    let mut npre: Int = 0;
    if i < n {
        if byte_at(s, i) == 45 {
            i = i + 1;
            let mut start: Int = i;
            while i <= n {
                let mut cut: Int = 0;
                if i == n {
                    cut = 1;
                } else {
                    let ch: Int = byte_at(s, i);
                    if ch == 46 {
                        cut = 1;
                    }
                    if ch == 43 {
                        cut = 1;
                    }
                }
                if cut > 0 {
                    let p: SemVer = sv_push_pre(pres, npre, s, start, i);
                    if p.flag < 1 {
                        return p;
                    }
                    pres = p.pres;
                    npre = p.npre;
                    if i == n {
                        break;
                    }
                    if byte_at(s, i) == 43 {
                        break;
                    }
                    i = i + 1;
                    start = i;
                } else {
                    i = i + 1;
                }
            }
        }
    }
    if i < n {
        if byte_at(s, i) == 43 {
            if i + 1 >= n {
                return sv_err("semver build");
            }
            i = n;
        }
    }
    if i != n {
        return sv_err("semver trail");
    }
    return SemVer { flag: 1, err: "", major: a.major, minor: b.major, patch: c.major, npre: npre, pres: pres, bmeta: "" };
}

pub fn semver_parser_read_slice(s: String, a: Int, b: Int) -> String { return sv_slice(s, a, b); }
