// # Semantic Versioning 2.0.0 parser
//
// Logline: Parses MAJOR.MINOR.PATCH with optional prerelease and build metadata and rejects numeric leading zeros.
//
// Setup: Pure. Source is a String. Build metadata is stored and ignored by precedence.
//
// Beats:
//   1. Read three numeric core fields with no leading zeros.
//   2. Parse optional -PRERELEASE identifiers.
//   3. Compare versions and match ^, ~, and >= ranges.
//   4. Reject illegal numeric leading zeros.

import "std/parsers/semver_parser_read.oo";
import "std/parsers/semver_parser_ops.oo";

pub fn semver_parser_parse(s: String) -> SemVer { return semver_parser_read_parse(s); }

pub fn semver_parser_cmp(af: Int, ae: String, aM: Int, am: Int, ap: Int, an: Int, apres: List[String], bf: Int, be: String, bM: Int, bm: Int, bp: Int, bn: Int, bpres: List[String]) -> Result[Int, String] { return semver_parser_ops_cmp(af, ae, aM, am, ap, an, apres, bf, be, bM, bm, bp, bn, bpres); }

fn sv_ge(c: Int) -> Int {
    if c < 0 {
        return 0;
    }
    return 1;
}

pub fn semver_parser_range(ver: String, spec: String) -> Result[Int, String] {
    let v: SemVer = semver_parser_parse(ver);
    if v.flag < 1 {
        return Err(v.err);
    }
    let n: Int = bytes_len(spec);
    let mut kind: Int = 0 - 1;
    let mut off: Int = 0;
    if n >= 2 {
        if byte_at(spec, 0) == 62 {
            if byte_at(spec, 1) == 61 {
                kind = 2;
                off = 2;
            }
        }
    }
    if kind < 0 {
        if n >= 1 {
            if byte_at(spec, 0) == 94 {
                kind = 0;
                off = 1;
            }
            if byte_at(spec, 0) == 126 {
                kind = 1;
                off = 1;
            }
        }
    }
    if kind < 0 {
        return Err("semver range");
    }
    if off < n {
        if byte_at(spec, off) == 32 {
            off = off + 1;
        }
    }
    let s: SemVer = semver_parser_parse(semver_parser_read_slice(spec, off, n));
    if s.flag < 1 {
        return Err(s.err);
    }
    let c: Result[Int, String] = semver_parser_cmp(v.flag, v.err, v.major, v.minor, v.patch, v.npre, v.pres, s.flag, s.err, s.major, s.minor, s.patch, s.npre, s.pres);
    match c {
        Ok(x) => {
            if kind == 2 {
                return Ok(sv_ge(x));
            }
            if kind == 1 {
                if v.major != s.major {
                    return Ok(0);
                }
                if v.minor != s.minor {
                    return Ok(0);
                }
                return Ok(sv_ge(x));
            }
            if s.major > 0 {
                if v.major != s.major {
                    return Ok(0);
                }
                return Ok(sv_ge(x));
            }
            if s.minor > 0 {
                if v.major != 0 {
                    return Ok(0);
                }
                if v.minor != s.minor {
                    return Ok(0);
                }
                return Ok(sv_ge(x));
            }
            if v.major != 0 {
                return Ok(0);
            }
            if v.minor != 0 {
                return Ok(0);
            }
            if v.patch != s.patch {
                return Ok(0);
            }
            return Ok(sv_ge(x));
        },
        Err(e) => {
            return Err(e);
        }
    }
}

pub fn semver_parser_stat(flag: Int, err: String, n: Int) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(n);
}
