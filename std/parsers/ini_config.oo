// # Sectioned INI configuration parser
//
// Logline: Parses [section] headers, semicolon and hash comments, and trimmed key=value assignments.
//
// Setup: Pure. Source is a String. Lookups use section.key paths. Last assignment wins.
//
// Beats:
//   1. Skip blank lines and ; or # comments.
//   2. Track the current section from [name] headers.
//   3. Store trimmed key=value pairs under the section path.
//   4. Reject a non-assignment line as a syntax error.

pub type IniDoc = struct {
    flag: Int,
    err: String,
    n: Int,
    keys: List[String],
    vals: List[String]
};

fn ini_is_sp(b: Int) -> Int {
    if b == 32 {
        return 1;
    }
    if b == 9 {
        return 1;
    }
    return 0;
}

fn ini_trim(s: String) -> String {
    let n: Int = bytes_len(s);
    let mut a: Int = 0;
    let mut b: Int = n;
    while a < b {
        if ini_is_sp(byte_at(s, a)) < 1 {
            break;
        }
        a = a + 1;
    }
    while b > a {
        if ini_is_sp(byte_at(s, b - 1)) < 1 {
            break;
        }
        b = b - 1;
    }
    let mut buf: List[Int] = bytes_new();
    let mut i: Int = a;
    while i < b {
        buf = bytes_push(buf, byte_at(s, i));
        i = i + 1;
    }
    return bytes_to_str(buf);
}

fn ini_slice(s: String, a: Int, b: Int) -> String {
    let mut buf: List[Int] = bytes_new();
    let mut i: Int = a;
    while i < b {
        buf = bytes_push(buf, byte_at(s, i));
        i = i + 1;
    }
    return bytes_to_str(buf);
}

fn ini_join(sec: String, key: String) -> String {
    if bytes_len(sec) < 1 {
        return key;
    }
    return sec + "." + key;
}

fn ini_put(d: IniDoc, key: String, val: String) -> IniDoc {
    let mut keys: List[String] = d.keys;
    let mut vals: List[String] = d.vals;
    keys = list_push(keys, key);
    vals = list_push(vals, val);
    return IniDoc { flag: 1, err: "", n: d.n + 1, keys: keys, vals: vals };
}

pub fn ini_config_parse(src: String) -> IniDoc {
    let empty_s: List[String] = list_new();
    let empty_v: List[String] = list_new();
    let mut d: IniDoc = IniDoc { flag: 1, err: "", n: 0, keys: empty_s, vals: empty_v };
    let mut sec: String = "";
    let n: Int = bytes_len(src);
    let mut i: Int = 0;
    while i <= n {
        let mut j: Int = i;
        while j < n {
            let b: Int = byte_at(src, j);
            if b == 10 {
                break;
            }
            if b == 13 {
                break;
            }
            j = j + 1;
        }
        let line: String = ini_trim(ini_slice(src, i, j));
        if bytes_len(line) > 0 {
            let c0: Int = byte_at(line, 0);
            if c0 == 59 {
            } else {
                if c0 == 35 {
                } else {
                    if c0 == 91 {
                        let ln: Int = bytes_len(line);
                        if byte_at(line, ln - 1) != 93 {
                            return IniDoc { flag: 0, err: "ini section", n: 0, keys: empty_s, vals: empty_v };
                        }
                        sec = ini_trim(ini_slice(line, 1, ln - 1));
                    } else {
                        let ln2: Int = bytes_len(line);
                        let mut eq: Int = 0 - 1;
                        let mut k: Int = 0;
                        while k < ln2 {
                            if byte_at(line, k) == 61 {
                                eq = k;
                                break;
                            }
                            k = k + 1;
                        }
                        if eq < 1 {
                            return IniDoc { flag: 0, err: "ini eq", n: 0, keys: empty_s, vals: empty_v };
                        }
                        let key: String = ini_trim(ini_slice(line, 0, eq));
                        let val: String = ini_trim(ini_slice(line, eq + 1, ln2));
                        d = ini_put(d, ini_join(sec, key), val);
                    }
                }
            }
        }
        if j < n {
            if byte_at(src, j) == 13 {
                j = j + 1;
            }
        }
        if j < n {
            if byte_at(src, j) == 10 {
                j = j + 1;
            }
        }
        i = j;
        if i >= n {
            break;
        }
    }
    return d;
}

pub fn ini_config_get(d: IniDoc, key: String) -> Result[String, String] {
    if d.flag < 1 {
        return Err(d.err);
    }
    let mut found: Int = 0;
    let mut val: String = "";
    let mut i: Int = 0;
    while i < d.n {
        if list_get(d.keys, i) == key {
            found = 1;
            val = list_get(d.vals, i);
        }
        i = i + 1;
    }
    if found < 1 {
        return Err("ini missing");
    }
    return Ok(val);
}

pub fn ini_config_stat(d: IniDoc) -> Result[Int, String] {
    if d.flag < 1 {
        return Err(d.err);
    }
    return Ok(d.n);
}
