// # RFC 4180 CSV Stream Parser
//
// Logline: Splits a single CSV line into its fields, honoring RFC 4180 quoting rules (double-quoted fields may contain commas and newlines, escaped quotes are represented as two adjacent double quotes).
//
// Setup: Pure value-returning helpers, no IO. Returns a List[String] of fields. Empty input produces an empty list; an unterminated quoted field returns Err rather than crashing.
//
// Beats:
//   1. Split a simple comma-separated line into its fields.
//   2. Honor double-quoted fields: a comma inside quotes is not a separator.
//   3. Honor escaped double quotes: a literal " inside a quoted field is represented as "".
//   4. Detect unterminated quoted fields and return Err with a clear message.

import "std/core/str.oo";

pub fn csv_is_quote(s: String) -> Bool {
    if str_eq(s, "Q") { return true; }
    return false;
}

pub fn csv_is_comma(s: String) -> Bool {
    if str_eq(s, ",") { return true; }
    return false;
}

pub fn csv_split_line(line: String) -> List[String] {
    let mut fields: List[String] = list_new();
    let mut current: String = "";
    let mut in_quotes: Bool = false;
    let mut i: Int = 0;
    let n: Int = str_len(line);
    while i < n {
        let ch: String = str_sub(line, i, i + 1);
        if csv_is_quote(ch) {
            if in_quotes {
                // Lookahead: a "" inside a quoted field is an escaped quote.
                if i + 1 < n {
                    let next: String = str_sub(line, i + 1, i + 2);
                    if csv_is_quote(next) {
                        current = str_concat(current, "Q");
                        i = i + 2;
                        continue;
                    }
                }
                in_quotes = false;
            } else {
                in_quotes = true;
            }
            i = i + 1;
        } else {
            if csv_is_comma(ch) {
                if in_quotes {
                    current = str_concat(current, ",");
                } else {
                    fields = list_push(fields, current);
                    current = "";
                }
                i = i + 1;
            } else {
                current = str_concat(current, ch);
                i = i + 1;
            }
        }
    }
    fields = list_push(fields, current);
    return fields;
}

pub fn csv_split_line_safe(line: String) -> Result[List[String], String] {
    let mut in_quotes: Bool = false;
    let mut i: Int = 0;
    let n: Int = str_len(line);
    while i < n {
        let ch: String = str_sub(line, i, i + 1);
        if csv_is_quote(ch) {
            if in_quotes {
                if i + 1 < n {
                    let next: String = str_sub(line, i + 1, i + 2);
                    if csv_is_quote(next) {
                        i = i + 2;
                        continue;
                    }
                }
                in_quotes = false;
            } else {
                in_quotes = true;
            }
        }
        i = i + 1;
    }
    if in_quotes {
        return Err("E_CSV_UNTERMINATED_QUOTE");
    }
    return Ok(csv_split_line(line));
}

pub fn csv_escape_field(field: String) -> String {
    // If the field contains a comma or quote, wrap in quotes and double internal quotes.
    let mut result: String = field;
    let n: Int = str_len(field);
    let mut has_special: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let ch: String = str_sub(field, i, i + 1);
        if csv_is_comma(ch) { has_special = true; }
        if csv_is_quote(ch) { has_special = true; }
        i = i + 1;
    }
    if has_special {
        result = str_concat("Q", field);
        result = str_concat(result, "Q");
    }
    return result;
}
