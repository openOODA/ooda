// # TOML key-value parser
//
// Logline: Parses bare keys, nested [table] headers, integers, booleans, and double-quoted strings.
//
// Setup: Pure. Source is a String. Lookups use dotted paths including the table prefix.
//
// Beats:
//   1. Skip blank lines and comments.
//   2. Track the current table prefix from [table] and [table.sub].
//   3. Store key = int|bool|"string" under the full path.
//   4. Lookup later recovers the source value.

pub type TomlDoc = struct {
    flag: Int,
    err: String,
    n: Int,
    keys: List[String],
    kinds: List[Int],
    ints: List[Int],
    strs: List[String]
};

fn toml_is_sp(c: String) -> Int {
    if c == " " {
        return 1;
    }
    if c == "\t" {
        return 1;
    }
    return 0;
}

fn toml_trim(s: String) -> String {
    let n: Int = chars_len(s);
    let mut a: Int = 0;
    let mut b: Int = n;
    while a < b {
        if toml_is_sp(char_at(s, a)) < 1 {
            break;
        }
        a = a + 1;
    }
    while b > a {
        if toml_is_sp(char_at(s, b - 1)) < 1 {
            break;
        }
        b = b - 1;
    }
    return str_slice(s, a, b);
}

fn toml_put(d: TomlDoc, key: String, kind: Int, iv: Int, sv: String) -> TomlDoc {
    return TomlDoc {
        flag: 1,
        err: "",
        n: d.n + 1,
        keys: list_push(d.keys, key),
        kinds: list_push(d.kinds, kind),
        ints: list_push(d.ints, iv),
        strs: list_push(d.strs, sv)
    };
}

fn toml_parse_val(d: TomlDoc, path: String, raw: String) -> TomlDoc {
    let v: String = toml_trim(raw);
    if chars_len(v) < 1 {
        return TomlDoc { flag: 0, err: "toml value", n: 0, keys: d.keys, kinds: d.kinds, ints: d.ints, strs: d.strs };
    }
    if v == "true" {
        return toml_put(d, path, 2, 1, "");
    }
    if v == "false" {
        return toml_put(d, path, 2, 0, "");
    }
    if char_at(v, 0) == "\"" {
        let n: Int = chars_len(v);
        if n < 2 {
            return TomlDoc { flag: 0, err: "toml string", n: 0, keys: d.keys, kinds: d.kinds, ints: d.ints, strs: d.strs };
        }
        if char_at(v, n - 1) != "\"" {
            return TomlDoc { flag: 0, err: "toml string", n: 0, keys: d.keys, kinds: d.kinds, ints: d.ints, strs: d.strs };
        }
        return toml_put(d, path, 3, 0, str_slice(v, 1, n - 1));
    }
    let n2: Int = chars_len(v);
    let mut i: Int = 0;
    let mut sign: Int = 1;
    let mut acc: Int = 0;
    if char_at(v, 0) == "-" {
        sign = 0 - 1;
        i = 1;
    }
    if i >= n2 {
        return TomlDoc { flag: 0, err: "toml int", n: 0, keys: d.keys, kinds: d.kinds, ints: d.ints, strs: d.strs };
    }
    while i < n2 {
        let c: String = char_at(v, i);
        if c == "0" { acc = acc * 10 + 0; }
        else if c == "1" { acc = acc * 10 + 1; }
        else if c == "2" { acc = acc * 10 + 2; }
        else if c == "3" { acc = acc * 10 + 3; }
        else if c == "4" { acc = acc * 10 + 4; }
        else if c == "5" { acc = acc * 10 + 5; }
        else if c == "6" { acc = acc * 10 + 6; }
        else if c == "7" { acc = acc * 10 + 7; }
        else if c == "8" { acc = acc * 10 + 8; }
        else if c == "9" { acc = acc * 10 + 9; }
        else {
            return TomlDoc { flag: 0, err: "toml int", n: 0, keys: d.keys, kinds: d.kinds, ints: d.ints, strs: d.strs };
        }
        i = i + 1;
    }
    return toml_put(d, path, 1, acc * sign, "");
}

fn toml_join(pre: String, key: String) -> String {
    if chars_len(pre) == 0 {
        return key;
    }
    return pre + "." + key;
}

pub fn toml_parser_parse(src: String) -> TomlDoc {
    let empty_s: List[String] = list_new();
    let empty_i: List[Int] = list_new();
    let mut d: TomlDoc = TomlDoc { flag: 1, err: "", n: 0, keys: empty_s, kinds: empty_i, ints: empty_i, strs: empty_s };
    let mut pre: String = "";
    let n: Int = chars_len(src);
    let mut i: Int = 0;
    while i <= n {
        let mut j: Int = i;
        while j < n {
            if char_at(src, j) == "\n" {
                break;
            }
            j = j + 1;
        }
        let line: String = toml_trim(str_slice(src, i, j));
        if chars_len(line) > 0 {
            if char_at(line, 0) != "#" {
                d = toml_line(d, pre, line);
                if d.flag < 1 {
                    return d;
                }
                if char_at(line, 0) == "[" {
                    pre = toml_table_name(line);
                }
            }
        }
        i = j + 1;
        if j >= n {
            break;
        }
    }
    return d;
}

fn toml_table_name(line: String) -> String {
    let n: Int = chars_len(line);
    if n < 3 {
        return "";
    }
    if char_at(line, n - 1) != "]" {
        return "";
    }
    return toml_trim(str_slice(line, 1, n - 1));
}

fn toml_line(d: TomlDoc, pre: String, line: String) -> TomlDoc {
    if char_at(line, 0) == "[" {
        return d;
    }
    let n: Int = chars_len(line);
    let mut eq: Int = 0 - 1;
    let mut k: Int = 0;
    while k < n {
        if char_at(line, k) == "=" {
            eq = k;
            k = n;
        }
        k = k + 1;
    }
    if eq < 1 {
        return TomlDoc { flag: 0, err: "toml eq", n: 0, keys: d.keys, kinds: d.kinds, ints: d.ints, strs: d.strs };
    }
    let key: String = toml_trim(str_slice(line, 0, eq));
    let val: String = str_slice(line, eq + 1, n);
    return toml_parse_val(d, toml_join(pre, key), val);
}

pub fn toml_parser_get_int(d: TomlDoc, key: String) -> Result[Int, String] {
    let mut i: Int = 0;
    while i < d.n {
        if list_get(d.keys, i) == key {
            if list_get(d.kinds, i) == 1 {
                return Ok(list_get(d.ints, i));
            }
            return Err("toml type");
        }
        i = i + 1;
    }
    return Err("toml missing");
}

pub fn toml_parser_get_bool(d: TomlDoc, key: String) -> Result[Int, String] {
    let mut i: Int = 0;
    while i < d.n {
        if list_get(d.keys, i) == key {
            if list_get(d.kinds, i) == 2 {
                return Ok(list_get(d.ints, i));
            }
            return Err("toml type");
        }
        i = i + 1;
    }
    return Err("toml missing");
}

pub fn toml_parser_get_str(d: TomlDoc, key: String) -> Result[String, String] {
    let mut i: Int = 0;
    while i < d.n {
        if list_get(d.keys, i) == key {
            if list_get(d.kinds, i) == 3 {
                return Ok(list_get(d.strs, i));
            }
            return Err("toml type");
        }
        i = i + 1;
    }
    return Err("toml missing");
}

pub fn toml_parser_stat(d: TomlDoc) -> Result[Int, String] {
    if d.flag < 1 {
        return Err(d.err);
    }
    return Ok(d.n);
}
