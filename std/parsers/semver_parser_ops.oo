// # SemVer precedence and range matching
//
// Logline: Compares two parsed SemVer values and matches caret, tilde, and greater-or-equal ranges.
//
// Setup: Pure. Called from semver_parser.oo with primitive fields. Build metadata is ignored.
//
// Beats:
//   1. Compare major, minor, then patch.
//   2. Treat a prerelease as less than the same release.
//   3. Match ^, ~, and >= against a live version string.

fn sv_ops_err(m: String) -> Result[Int, String] {
    return Err(m);
}

fn sv_all_dig(s: String) -> Int {
    let n: Int = bytes_len(s);
    if n < 1 {
        return 0;
    }
    let mut i: Int = 0;
    while i < n {
        let c: Int = byte_at(s, i);
        if c < 48 {
            return 0;
        }
        if c > 57 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn sv_atoi(s: String) -> Int {
    let n: Int = bytes_len(s);
    let mut v: Int = 0;
    let mut i: Int = 0;
    while i < n {
        v = v * 10 + (byte_at(s, i) - 48);
        i = i + 1;
    }
    return v;
}

fn sv_lex(a: String, b: String) -> Int {
    let na: Int = bytes_len(a);
    let nb: Int = bytes_len(b);
    let mut n: Int = na;
    if nb < n {
        n = nb;
    }
    let mut i: Int = 0;
    while i < n {
        let da: Int = byte_at(a, i);
        let db: Int = byte_at(b, i);
        if da < db {
            return 0 - 1;
        }
        if da > db {
            return 1;
        }
        i = i + 1;
    }
    if na < nb {
        return 0 - 1;
    }
    if na > nb {
        return 1;
    }
    return 0;
}

fn sv_id_cmp(a: String, b: String) -> Int {
    let na: Int = sv_all_dig(a);
    let nb: Int = sv_all_dig(b);
    if na > 0 {
        if nb > 0 {
            let va: Int = sv_atoi(a);
            let vb: Int = sv_atoi(b);
            if va < vb {
                return 0 - 1;
            }
            if va > vb {
                return 1;
            }
            return 0;
        }
        return 0 - 1;
    }
    if nb > 0 {
        return 1;
    }
    return sv_lex(a, b);
}

pub fn semver_parser_ops_cmp(af: Int, ae: String, aM: Int, am: Int, ap: Int, an: Int, apres: List[String], bf: Int, be: String, bM: Int, bm: Int, bp: Int, bn: Int, bpres: List[String]) -> Result[Int, String] {
    if af < 1 {
        return Err(ae);
    }
    if bf < 1 {
        return Err(be);
    }
    if aM < bM {
        return Ok(0 - 1);
    }
    if aM > bM {
        return Ok(1);
    }
    if am < bm {
        return Ok(0 - 1);
    }
    if am > bm {
        return Ok(1);
    }
    if ap < bp {
        return Ok(0 - 1);
    }
    if ap > bp {
        return Ok(1);
    }
    if an < 1 {
        if bn < 1 {
            return Ok(0);
        }
        return Ok(1);
    }
    if bn < 1 {
        return Ok(0 - 1);
    }
    let mut i: Int = 0;
    let mut n: Int = an;
    if bn < n {
        n = bn;
    }
    while i < n {
        let c: Int = sv_id_cmp(list_get(apres, i), list_get(bpres, i));
        if c != 0 {
            return Ok(c);
        }
        i = i + 1;
    }
    if an < bn {
        return Ok(0 - 1);
    }
    if an > bn {
        return Ok(1);
    }
    return Ok(0);
}

pub fn semver_parser_ops_alive() -> Int { return 1; }
