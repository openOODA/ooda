// # Ethereum Merkle Patricia Trie (MPT) Traversal & Nibble Codec
//
// Logline: Implements Hex-Prefix (HP) nibble encoding, node hashing, and key path traversal over MPT structures.
//
// Setup: Pure cryptographic trie engine encoding key paths and resolving node child hashes.
//
// Beats:
//   1. Encode byte key strings into 4-bit nibble sequences.
//   2. Apply Hex-Prefix (HP) encoding with odd/even parity and leaf terminator flags.
//   3. Compute node hashes for branch, extension, and leaf MPT nodes.
//   4. Validate path matching against trie branch routes.

import "./mpt_types.oo";
import "./keccak.oo";

fn hex_char_to_nibble(c: Int) -> Int {
    if c >= 48 && c <= 57 { // '0'..'9'
        return c - 48;
    }
    if c >= 97 && c <= 102 { // 'a'..'f'
        return c - 87;
    }
    if c >= 65 && c <= 70 { // 'A'..'F'
        return c - 55;
    }
    return 0;
}

/// Convert hex string to 4-bit nibble list (skipping optional 0x prefix).
pub fn mpt_encode_nibbles(hex_key: String) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = hex_key.len();
    let mut start: Int = 0;
    if n >= 2 {
        let c0: Int = byte_at(hex_key, 0);
        let c1: Int = byte_at(hex_key, 1);
        if c0 == 48 && (c1 == 120 || c1 == 88) { // '0x' or '0X'
            start = 2;
        }
    }
    let mut i: Int = start;
    while i < n {
        let code: Int = byte_at(hex_key, i);
        out = list_push(out, hex_char_to_nibble(code));
        i = i + 1;
    }
    return out;
}

/// Apply Ethereum Hex-Prefix (HP) encoding to nibble sequence.
pub fn mpt_hex_prefix_encode(nibbles: List[Int], is_leaf: Bool) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(nibbles);
    let is_odd: Bool = (n % 2) != 0;
    let mut prefix: Int = 0;
    if is_leaf {
        if is_odd {
            prefix = 3;
        } else {
            prefix = 2;
        }
    } else {
        if is_odd {
            prefix = 1;
        } else {
            prefix = 0;
        }
    }
    if is_odd {
        let first_byte: Int = (prefix << 4) | (list_get(nibbles, 0) & 15);
        out = list_push(out, first_byte);
        let mut i: Int = 1;
        while i < n {
            let b: Int = (list_get(nibbles, i) << 4) | (list_get(nibbles, i + 1) & 15);
            out = list_push(out, b);
            i = i + 2;
        }
    } else {
        let first_byte: Int = prefix << 4;
        out = list_push(out, first_byte);
        let mut i: Int = 0;
        while i < n {
            let b: Int = (list_get(nibbles, i) << 4) | (list_get(nibbles, i + 1) & 15);
            out = list_push(out, b);
            i = i + 2;
        }
    }
    return out;
}

/// Compute MPT node hash.
pub fn mpt_hash_node(node: &MptNode) -> String {
    let k: String = (node).key_nibbles;
    let v: String = (node).value;
    return keccak256_str(k + v);
}
