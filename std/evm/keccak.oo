// # Keccak-256 Cryptographic Hash Function
//
// Logline: Implements Keccak-256 sponge permutation used across Ethereum state tries, transaction hashes, and address derivations.
//
// Setup: Pure cryptographic hash engine producing 32-byte Ethereum Keccak-256 digests.
//
// Beats:
//   1. Sponge absorb input byte streams with rate r=1088 and capacity c=512.
//   2. Apply 24-round Keccak-f[1600] permutation steps (theta, rho, pi, chi, iota).
//   3. Squeeze 32-byte (256-bit) digest from sponge state.
//   4. Validate standard Ethereum Keccak-256 test vectors.

fn kc_rc_lo(r: Int) -> Int {
    if r == 0 { return 1; } if r == 1 { return 32898; } if r == 2 { return 32906; } if r == 3 { return 2147516416; }
    if r == 4 { return 32907; } if r == 5 { return 2147483649; } if r == 6 { return 2147516545; } if r == 7 { return 32777; }
    if r == 8 { return 138; } if r == 9 { return 136; } if r == 10 { return 2147516425; } if r == 11 { return 2147483658; }
    if r == 12 { return 2147516555; } if r == 13 { return 139; } if r == 14 { return 32905; } if r == 15 { return 32771; }
    if r == 16 { return 32770; } if r == 17 { return 128; } if r == 18 { return 32778; } if r == 19 { return 2147483658; }
    if r == 20 { return 2147516545; } if r == 21 { return 32896; } if r == 22 { return 2147483649; } return 2147516424;
}

fn kc_rc_hi(r: Int) -> Int {
    if r == 2 || r == 3 || r == 6 || r == 7 || r == 13 || r == 14 || r == 15 || r == 16 || r == 17 || r == 19 || r == 20 || r == 21 || r == 23 { return 2147483648; }
    return 0;
}

fn kc_rot(lo: Int, hi: Int, r: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = r % 64;
    if n == 0 { return list_push(list_push(out, lo), hi); }
    let m: Int = 4294967295;
    if n < 32 { return list_push(list_push(out, (((lo << n) & m) | (hi >> (32 - n))) & m), (((hi << n) & m) | (lo >> (32 - n))) & m); }
    if n == 32 { return list_push(list_push(out, hi), lo); }
    let s: Int = n - 32;
    return list_push(list_push(out, (((hi << s) & m) | (lo >> (32 - s))) & m), (((lo << s) & m) | (hi >> (32 - s))) & m);
}

fn kc_rot_const(i: Int) -> Int {
    if i == 1 { return 1; } if i == 2 { return 62; } if i == 3 { return 28; } if i == 4 { return 27; }
    if i == 5 { return 36; } if i == 6 { return 44; } if i == 7 { return 6; } if i == 8 { return 55; }
    if i == 9 { return 20; } if i == 10 { return 3; } if i == 11 { return 10; } if i == 12 { return 43; }
    if i == 13 { return 25; } if i == 14 { return 39; } if i == 15 { return 41; } if i == 16 { return 45; }
    if i == 17 { return 15; } if i == 18 { return 21; } if i == 19 { return 8; } if i == 20 { return 18; }
    if i == 21 { return 2; } if i == 22 { return 61; } if i == 23 { return 56; } if i == 24 { return 14; }
    return 0;
}

fn kc_pi_idx(i: Int) -> Int {
    if i == 1 { return 10; } if i == 2 { return 20; } if i == 3 { return 5; } if i == 4 { return 15; }
    if i == 5 { return 16; } if i == 6 { return 1; } if i == 7 { return 11; } if i == 8 { return 21; }
    if i == 9 { return 6; } if i == 10 { return 7; } if i == 11 { return 17; } if i == 12 { return 2; }
    if i == 13 { return 12; } if i == 14 { return 22; } if i == 15 { return 23; } if i == 16 { return 8; }
    if i == 17 { return 18; } if i == 18 { return 3; } if i == 19 { return 13; } if i == 20 { return 14; }
    if i == 21 { return 24; } if i == 22 { return 9; } if i == 23 { return 19; } if i == 24 { return 4; }
    return 0;
}

fn keccak_permute(st_lo: List[Int], st_hi: List[Int]) -> List[Int] {
    let mut a_lo: List[Int] = st_lo;
    let mut a_hi: List[Int] = st_hi;
    let m: Int = 4294967295;
    let mut round: Int = 0;
    while round < 24 {
        let mut c_lo: List[Int] = list_new();
        let mut c_hi: List[Int] = list_new();
        let mut x: Int = 0;
        while x < 5 {
            c_lo = list_push(c_lo, list_get(a_lo, x) ^ list_get(a_lo, x + 5) ^ list_get(a_lo, x + 10) ^ list_get(a_lo, x + 15) ^ list_get(a_lo, x + 20));
            c_hi = list_push(c_hi, list_get(a_hi, x) ^ list_get(a_hi, x + 5) ^ list_get(a_hi, x + 10) ^ list_get(a_hi, x + 15) ^ list_get(a_hi, x + 20));
            x = x + 1;
        }
        let mut d_lo: List[Int] = list_new();
        let mut d_hi: List[Int] = list_new();
        x = 0;
        while x < 5 {
            let r_res: List[Int] = kc_rot(list_get(c_lo, (x + 1) % 5), list_get(c_hi, (x + 1) % 5), 1);
            d_lo = list_push(d_lo, list_get(c_lo, (x + 4) % 5) ^ list_get(r_res, 0));
            d_hi = list_push(d_hi, list_get(c_hi, (x + 4) % 5) ^ list_get(r_res, 1));
            x = x + 1;
        }
        let mut na_lo: List[Int] = list_new();
        let mut na_hi: List[Int] = list_new();
        let mut i: Int = 0;
        while i < 25 {
            na_lo = list_push(na_lo, (list_get(a_lo, i) ^ list_get(d_lo, i % 5)) & m);
            na_hi = list_push(na_hi, (list_get(a_hi, i) ^ list_get(d_hi, i % 5)) & m);
            i = i + 1;
        }
        let mut b_lo: List[Int] = list_new();
        let mut b_hi: List[Int] = list_new();
        i = 0;
        while i < 25 { b_lo = list_push(b_lo, 0); b_hi = list_push(b_hi, 0); i = i + 1; }
        i = 0;
        while i < 25 {
            let rot_v: List[Int] = kc_rot(list_get(na_lo, i), list_get(na_hi, i), kc_rot_const(i));
            let dst: Int = kc_pi_idx(i);
            let mut nb_lo: List[Int] = list_new();
            let mut nb_hi: List[Int] = list_new();
            let mut j: Int = 0;
            while j < 25 {
                if j == dst { nb_lo = list_push(nb_lo, list_get(rot_v, 0)); nb_hi = list_push(nb_hi, list_get(rot_v, 1)); }
                else { nb_lo = list_push(nb_lo, list_get(b_lo, j)); nb_hi = list_push(nb_hi, list_get(b_hi, j)); }
                j = j + 1;
            }
            b_lo = nb_lo; b_hi = nb_hi; i = i + 1;
        }
        a_lo = list_new(); a_hi = list_new();
        i = 0;
        while i < 25 {
            let cur_x: Int = i % 5;
            let cur_y: Int = i / 5;
            let x1: Int = (cur_x + 1) % 5 + cur_y * 5;
            let x2: Int = (cur_x + 2) % 5 + cur_y * 5;
            let out_lo: Int = list_get(b_lo, i) ^ ((list_get(b_lo, x1) ^ m) & list_get(b_lo, x2));
            let out_hi: Int = list_get(b_hi, i) ^ ((list_get(b_hi, x1) ^ m) & list_get(b_hi, x2));
            if i == 0 {
                a_lo = list_push(a_lo, (out_lo ^ kc_rc_lo(round)) & m);
                a_hi = list_push(a_hi, (out_hi ^ kc_rc_hi(round)) & m);
            } else {
                a_lo = list_push(a_lo, out_lo & m);
                a_hi = list_push(a_hi, out_hi & m);
            }
            i = i + 1;
        }
        round = round + 1;
    }
    let mut res: List[Int] = list_new();
    let mut k: Int = 0;
    while k < 25 { res = list_push(list_push(res, list_get(a_lo, k)), list_get(a_hi, k)); k = k + 1; }
    return res;
}

/// Compute Keccak-256 hash of byte list.
pub fn keccak256_hash(bytes: List[Int]) -> List[Int] {
    let n: Int = list_len(bytes);
    let mut padded: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n { padded = list_push(padded, list_get(bytes, i) & 255); i = i + 1; }
    let rate: Int = 136;
    let pad_len: Int = rate - (n % rate);
    if pad_len == 1 {
        padded = list_push(padded, 129);
    } else {
        padded = list_push(padded, 1);
        let mut p: Int = 1;
        while p < (pad_len - 1) { padded = list_push(padded, 0); p = p + 1; }
        padded = list_push(padded, 128);
    }
    let mut st_lo: List[Int] = list_new();
    let mut st_hi: List[Int] = list_new();
    i = 0;
    while i < 25 { st_lo = list_push(st_lo, 0); st_hi = list_push(st_hi, 0); i = i + 1; }
    let total_len: Int = list_len(padded);
    let mut offset: Int = 0;
    while offset < total_len {
        let mut lane: Int = 0;
        while lane < 17 {
            let b_idx: Int = offset + lane * 8;
            let w_lo: Int = list_get(padded, b_idx) | (list_get(padded, b_idx + 1) << 8) | (list_get(padded, b_idx + 2) << 16) | (list_get(padded, b_idx + 3) << 24);
            let w_hi: Int = list_get(padded, b_idx + 4) | (list_get(padded, b_idx + 5) << 8) | (list_get(padded, b_idx + 6) << 16) | (list_get(padded, b_idx + 7) << 24);
            let mut nlo: List[Int] = list_new();
            let mut nhi: List[Int] = list_new();
            let mut l: Int = 0;
            while l < 25 {
                if l == lane { nlo = list_push(nlo, list_get(st_lo, l) ^ w_lo); nhi = list_push(nhi, list_get(st_hi, l) ^ w_hi); }
                else { nlo = list_push(nlo, list_get(st_lo, l)); nhi = list_push(nhi, list_get(st_hi, l)); }
                l = l + 1;
            }
            st_lo = nlo; st_hi = nhi; lane = lane + 1;
        }
        let p_res: List[Int] = keccak_permute(st_lo, st_hi);
        st_lo = list_new(); st_hi = list_new();
        let mut idx: Int = 0;
        while idx < 25 { st_lo = list_push(st_lo, list_get(p_res, 2 * idx)); st_hi = list_push(st_hi, list_get(p_res, 2 * idx + 1)); idx = idx + 1; }
        offset = offset + rate;
    }
    let mut out: List[Int] = list_new();
    let mut lane_out: Int = 0;
    while lane_out < 4 {
        let vlo: Int = list_get(st_lo, lane_out);
        let vhi: Int = list_get(st_hi, lane_out);
        out = list_push(list_push(list_push(list_push(out, vlo & 255), (vlo >> 8) & 255), (vlo >> 16) & 255), (vlo >> 24) & 255);
        out = list_push(list_push(list_push(list_push(out, vhi & 255), (vhi >> 8) & 255), (vhi >> 16) & 255), (vhi >> 24) & 255);
        lane_out = lane_out + 1;
    }
    return out;
}

fn byte_to_hex(b: Int) -> String {
    let hex_chars: String = "0123456789abcdef";
    return char_at(hex_chars, (b >> 4) & 15) + char_at(hex_chars, b & 15);
}

/// Compute Keccak-256 hash of string and return 64-character hex string.
pub fn keccak256_str(s: String) -> String {
    let slen: Int = s.len();
    let mut raw: List[Int] = list_new();
    let mut i: Int = 0;
    while i < slen { raw = list_push(raw, byte_at(s, i)); i = i + 1; }
    let digest: List[Int] = keccak256_hash(raw);
    let mut hex_str: String = "";
    i = 0;
    while i < 32 { hex_str = hex_str + byte_to_hex(list_get(digest, i)); i = i + 1; }
    return hex_str;
}
