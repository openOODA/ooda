// # Ethereum Merkle Patricia Trie (MPT) Structures
//
// Logline: Defines MptAccount, Leaf, Extension, Branch, and Null node types for Ethereum World State tries.
//
// Setup: Pure cryptographic data structures with zero struct trailing commas.
//
// Beats:
//   1. Define MptAccount holding nonce, balance, storage_root hash, and code_hash.
//   2. Define MptNode holding node type tags and child pointer hashes.
//   3. Provide constructors for Ethereum account states.

pub type MptAccount = struct {
    nonce: Int,
    balance_wei: String,
    storage_root: String,
    code_hash: String
};

pub type MptNode = struct {
    node_type: Int,
    key_nibbles: String,
    value: String
};

/// Create a new MptAccount state.
pub fn mpt_account_new(nonce: Int, balance: String) -> MptAccount {
    let empty_root: String = "56e81f171bcc55a6ff8345e692c0f86e5b48e01b996cadc001622fb5e363b421";
    let empty_code: String = "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470";
    return MptAccount {
        nonce: nonce,
        balance_wei: balance,
        storage_root: empty_root,
        code_hash: empty_code
    };
}
