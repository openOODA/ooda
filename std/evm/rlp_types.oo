// # Ethereum Recursive Length Prefix (RLP) Data Types
//
// Logline: Defines RLP item tokens, byte string payloads, and nested list structures for Ethereum consensus encoding.
//
// Setup: Pure serialization data structures for Ethereum consensus wire encodings with zero struct trailing commas.
//
// Beats:
//   1. Define RlpItem representing either single byte string or nested list token.
//   2. Provide constructors for string and list RLP items.
//   3. Validate canonical RLP length prefix constraints.

pub type RlpItem = struct {
    is_list: Bool,
    raw_bytes: List[Int]
};

pub fn rlp_item_bytes(bytes: List[Int]) -> RlpItem { return RlpItem {
        is_list: false,
        raw_bytes: bytes
    }; }

pub fn rlp_item_list(bytes: List[Int]) -> RlpItem { return RlpItem {
        is_list: true,
        raw_bytes: bytes
    }; }
