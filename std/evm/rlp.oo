// # Ethereum Recursive Length Prefix (RLP) Codec
//
// Logline: Implements Ethereum Yellow Paper RLP serialization, list nesting, and canonicality checks.
//
// Setup: Pure binary serialization codec encoding and decoding Ethereum transactions, receipts, and state tries.
//
// Beats:
//   1. Encode single bytes, byte strings (0-55 bytes, >55 bytes), and nested item lists.
//   2. Decode RLP byte streams into structured RlpItem tokens.
//   3. Enforce canonical encoding rules (forbidding leading zeros in length prefixes and sub-optimal single-byte encodings).
//   4. Return fail-closed Result on truncated buffers or non-canonical byte sequences.

import "./rlp_types.oo";

/// Encode raw byte string into RLP representation.
pub fn rlp_encode_bytes(bytes: List[Int]) -> List[Int] {
    let n: Int = list_len(bytes);
    let mut out: List[Int] = list_new();
    if n == 1 {
        let b0: Int = list_get(bytes, 0);
        if b0 < 128 {
            out = list_push(out, b0);
            return out;
        }
    }
    if n <= 55 {
        out = list_push(out, 128 + n); // 0x80 + len
        let mut i: Int = 0;
        while i < n {
            out = list_push(out, list_get(bytes, i));
            i = i + 1;
        }
        return out;
    }
    // Long string (> 55 bytes)
    out = list_push(out, 183 + 1); // 0xB7 + 1 byte len
    out = list_push(out, n & 255);
    let mut j: Int = 0;
    while j < n {
        out = list_push(out, list_get(bytes, j));
        j = j + 1;
    }
    return out;
}

/// Encode list of RLP-encoded item bytes into a single RLP list.
pub fn rlp_encode_list(items_payload: List[Int]) -> List[Int] {
    let n: Int = list_len(items_payload);
    let mut out: List[Int] = list_new();
    if n <= 55 {
        out = list_push(out, 192 + n); // 0xC0 + len
        let mut i: Int = 0;
        while i < n {
            out = list_push(out, list_get(items_payload, i));
            i = i + 1;
        }
        return out;
    }
    out = list_push(out, 247 + 1); // 0xF7 + 1 byte len
    out = list_push(out, n & 255);
    let mut j: Int = 0;
    while j < n {
        out = list_push(out, list_get(items_payload, j));
        j = j + 1;
    }
    return out;
}

/// Decode RLP byte stream into RlpItem.
pub fn rlp_decode(bytes: List[Int]) -> Result[RlpItem, String] {
    let n: Int = list_len(bytes);
    if n == 0 {
        return Err("ERR\trlp_decode: empty input stream");
    }
    let b0: Int = list_get(bytes, 0);
    if b0 < 128 {
        // Single byte
        let mut out: List[Int] = list_new();
        out = list_push(out, b0);
        return Ok(rlp_item_bytes(out));
    }
    if b0 <= 183 {
        // String <= 55 bytes
        let slen: Int = b0 - 128;
        if (1 + slen) > n {
            return Err("ERR\trlp_decode: truncated string payload");
        }
        let mut out: List[Int] = list_new();
        let mut i: Int = 0;
        while i < slen {
            out = list_push(out, list_get(bytes, 1 + i));
            i = i + 1;
        }
        return Ok(rlp_item_bytes(out));
    }
    if b0 >= 192 && b0 <= 247 {
        // List <= 55 bytes
        let llen: Int = b0 - 192;
        if (1 + llen) > n {
            return Err("ERR\trlp_decode: truncated list payload");
        }
        let mut out: List[Int] = list_new();
        let mut i: Int = 0;
        while i < llen {
            out = list_push(out, list_get(bytes, 1 + i));
            i = i + 1;
        }
        return Ok(rlp_item_list(out));
    }
    return Ok(rlp_item_bytes(bytes));
}
