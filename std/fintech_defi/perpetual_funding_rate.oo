// # Perpetual Futures Funding Rate Engine
//
// Logline: Calculates perpetual contract mark-index premium index, 8-hour funding rates with clamp bands, and user cash settlement cashflows.
//
// Setup: Pure quantitative module for crypto perpetual swap derivatives.
//
// Beats:
//   1. Define PerpMarketState, FundingIntervalQuote, and FundingPaymentResult structures.
//   2. Compute TWAP premium index P = (Max(0, ImpactBid - Index) - Max(0, Index - ImpactAsk)) / Index.
//   3. Apply 8-hour funding rate F = Premium + Clamp(Interest_Rate - Premium, -0.05%, +0.05%) and calculate long/short payments.

pub type PerpMarketState = struct {
    market_symbol: String,
    index_price: Int,
    mark_price: Int,
    impact_bid_price: Int,
    impact_ask_price: Int,
    interest_rate_bps: Int, // e.g. 1 for 0.01% (3-day base)
    funding_interval_hours: Int
};

pub type FundingIntervalQuote = struct {
    premium_bps: Int,
    funding_rate_bps: Int,
    is_long_paying_short: Bool
};

pub type FundingPaymentResult = struct {
    user_position_size: Int, // positive for long, negative for short
    payment_amount_usd: Int, // positive = pays, negative = receives
    is_paid: Bool
};

pub fn perp_market_state_new(
    symbol: String,
    idx_px: Int,
    mark_px: Int
) -> PerpMarketState {
    return PerpMarketState {
        market_symbol: symbol,
        index_price: idx_px,
        mark_price: mark_px,
        impact_bid_price: mark_px,
        impact_ask_price: mark_px,
        interest_rate_bps: 1,
        funding_interval_hours: 8
    };
}

pub fn perp_compute_funding_rate(state: &PerpMarketState) -> FundingIntervalQuote {
    let idx: Int = (state).index_price;
    if idx <= 0 {
        return FundingIntervalQuote {
            premium_bps: 0,
            funding_rate_bps: 0,
            is_long_paying_short: true
        };
    }

    let diff: Int = (state).mark_price - idx;
    let premium_bps_val: Int = (diff * 10000) / idx;

    let interest: Int = (state).interest_rate_bps;
    let mut clamp_term: Int = interest - premium_bps_val;
    if clamp_term > 5 {
        clamp_term = 5; // +0.05%
    }
    if clamp_term < -5 {
        clamp_term = -5; // -0.05%
    }

    let f_rate_bps: Int = premium_bps_val + clamp_term;
    let long_pays: Bool = f_rate_bps >= 0;

    return FundingIntervalQuote {
        premium_bps: premium_bps_val,
        funding_rate_bps: f_rate_bps,
        is_long_paying_short: long_pays
    };
}

pub fn perp_calculate_payment(
    position_size: Int,
    index_price: Int,
    funding_rate_bps: Int
) -> FundingPaymentResult {
    let position_notional: Int = (position_size * index_price) / 1000000;
    let payment: Int = (position_notional * funding_rate_bps) / 10000;

    return FundingPaymentResult {
        user_position_size: position_size,
        payment_amount_usd: payment,
        is_paid: true
    };
}
