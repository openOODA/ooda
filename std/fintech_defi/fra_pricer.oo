// # Forward Rate Agreement (FRA) Pricer
//
// Logline: Prices Forward Rate Agreements (FRAs), computing implied forward Libor/SOFR rates, contract PV, and settlement cashflows.
//
// Setup: Pure quantitative finance module with simple forward rate discounting.
//
// Beats:
//   1. Define FraContract and FraValuationResult structures.
//   2. Compute implied simply-compounded forward rate from spot discount factors.
//   3. Calculate FRA payoff at fixing date discounted to settlement date.

pub type FraContract = struct {
    notional: Float,
    fixed_fra_rate: Float,
    start_time_years: Float,
    end_time_years: Float,
    is_payer: Bool
};

pub type FraValuationResult = struct {
    forward_rate: Float,
    settlement_payoff: Float,
    pv: Float,
    basis_point_value: Float
};

pub fn fra_contract_new(
    notional: Float,
    fixed_rate: Float,
    start_t: Float,
    end_t: Float,
    is_payer: Bool
) -> FraContract {
    return FraContract {
        notional: notional,
        fixed_fra_rate: fixed_rate,
        start_time_years: start_t,
        end_time_years: end_t,
        is_payer: is_payer
    };
}

pub fn fra_forward_rate_from_df(df_start: Float, df_end: Float, tau: Float) -> Float {
    if df_end <= 0.0 || tau <= 0.0 {
        return 0.0;
    }
    return ((df_start / df_end) - 1.0) / tau;
}

pub fn fra_price(
    contract: &FraContract,
    df_start: Float,
    df_end: Float
) -> FraValuationResult {
    let t1: Float = (contract).start_time_years;
    let t2: Float = (contract).end_time_years;
    let tau: Float = t2 - t1;
    let n: Float = (contract).notional;
    let r_k: Float = (contract).fixed_fra_rate;

    if tau <= 0.0 || n <= 0.0 {
        return FraValuationResult {
            forward_rate: 0.0,
            settlement_payoff: 0.0,
            pv: 0.0,
            basis_point_value: 0.0
        };
    }

    let fwd_r: Float = fra_forward_rate_from_df(df_start, df_end, tau);

    let num_payoff: Float = n * (fwd_r - r_k) * tau;
    let den_payoff: Float = 1.0 + (fwd_r * tau);
    let mut settlement_amount: Float = num_payoff / den_payoff;

    if !(contract).is_payer {
        settlement_amount = 0.0 - settlement_amount;
    }

    let pv_val: Float = settlement_amount * df_start;
    let bpv_val: Float = (n * tau * df_end) * 0.0001;

    return FraValuationResult {
        forward_rate: fwd_r,
        settlement_payoff: settlement_amount,
        pv: pv_val,
        basis_point_value: bpv_val
    };
}
