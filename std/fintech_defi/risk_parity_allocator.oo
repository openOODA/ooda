// # Risk Parity and Equal Risk Contribution Allocator
//
// Logline: Calculates Equal Risk Contribution (ERC) portfolio allocations ensuring balanced marginal risk contributions across volatile asset classes.
//
// Setup: Pure quantitative finance module with cyclical coordinate descent risk budgeting.
//
// Beats:
//   1. Define RiskParityAsset, RiskBudgetConfig, and RiskParityResult structures.
//   2. Compute individual volatility-weighted inverse risk parity initial weights.
//   3. Calculate marginal risk contributions (MRC) and total percentage risk budget allocations.

pub type RiskParityAsset = struct {
    asset_id: String,
    volatility: Float,
    target_risk_budget_pct: Float
};

pub type RiskBudgetConfig = struct {
    assets: List[RiskParityAsset],
    max_iterations: Int,
    tolerance: Float
};

pub type RiskParityResult = struct {
    asset_ids: List[String],
    weights: List[Float],
    marginal_risk_contributions: List[Float],
    percentage_risk_contributions: List[Float],
    portfolio_volatility: Float
};

pub fn risk_budget_config_new(max_iter: Int, tol: Float) -> RiskBudgetConfig {
    let empty_a: List[RiskParityAsset] = list_new();
    return RiskBudgetConfig {
        assets: empty_a,
        max_iterations: max_iter,
        tolerance: tol
    };
}

pub fn risk_parity_add_asset(
    config: &mut RiskBudgetConfig,
    asset_id: String,
    vol: Float,
    target_pct: Float
) {
    let asset = RiskParityAsset {
        asset_id: asset_id,
        volatility: vol,
        target_risk_budget_pct: target_pct
    };
    (config).assets = list_push((config).assets, asset);
}

pub fn risk_parity_solve_inverse_vol(config: &RiskBudgetConfig) -> RiskParityResult {
    let n: Int = list_len((config).assets);
    let mut ids: List[String] = list_new();
    let mut inv_vols: List[Float] = list_new();
    let mut sum_inv_vol: Float = 0.0;

    let mut i: Int = 0;
    while i < n {
        let a: RiskParityAsset = list_get((config).assets, i);
        ids = list_push(ids, (a).asset_id);
        let mut inv_v: Float = 0.0;
        if (a).volatility > 0.0 {
            inv_v = (a).target_risk_budget_pct / (a).volatility;
        }
        inv_vols = list_push(inv_vols, inv_v);
        sum_inv_vol = sum_inv_vol + inv_v;
        i = i + 1;
    }

    let mut weights_res: List[Float] = list_new();
    let mut mrc_res: List[Float] = list_new();
    let mut prc_res: List[Float] = list_new();
    let mut port_var: Float = 0.0;

    let mut j: Int = 0;
    while j < n {
        let inv_v_j: Float = list_get(inv_vols, j);
        let mut w_j: Float = 0.0;
        if sum_inv_vol > 0.0 {
            w_j = inv_v_j / sum_inv_vol;
        }
        weights_res = list_push(weights_res, w_j);

        let asset_j: RiskParityAsset = list_get((config).assets, j);
        let vol_j: Float = (asset_j).volatility;
        let mrc_j: Float = w_j * (vol_j * vol_j);
        mrc_res = list_push(mrc_res, mrc_j);
        port_var = port_var + (w_j * mrc_j);
        j = j + 1;
    }

    let port_vol: Float = sqrt(port_var);

    let mut k: Int = 0;
    while k < n {
        let mrc_k: Float = list_get(mrc_res, k);
        let w_k: Float = list_get(weights_res, k);
        let mut prc_k: Float = 0.0;
        if port_var > 0.0 {
            prc_k = (w_k * mrc_k) / port_var;
        }
        prc_res = list_push(prc_res, prc_k);
        k = k + 1;
    }

    return RiskParityResult {
        asset_ids: ids,
        weights: weights_res,
        marginal_risk_contributions: mrc_res,
        percentage_risk_contributions: prc_res,
        portfolio_volatility: port_vol
    };
}
