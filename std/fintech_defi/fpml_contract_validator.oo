// # FpML Financial Contract Validator
//
// Logline: Validates Financial products Markup Language (FpML) contract structures, business day roll conventions, and interest rate stream taxonomies.
//
// Setup: Pure quantitative compliance and trade validation module.
//
// Beats:
//   1. Define FpmlLeg, FpmlTrade, and FpmlValidationReport structures.
//   2. Validate day count fractions (ACT/360, ACT/365, 30/360) and roll conventions (MODFOLLOWING, FOLLOWING).
//   3. Execute business rules checking cross-currency legs, fixing lag days, and principal exchange flags.

pub type FpmlLeg = struct {
    payer_party_id: String,
    receiver_party_id: String,
    currency: String,
    notional: Float,
    is_fixed: Bool,
    rate_or_spread: Float,
    day_count_fraction: String,
    roll_convention: String,
    payment_frequency_months: Int,
};

pub type FpmlTrade = struct {
    trade_id: String,
    product_type: String,
    trade_date: Int,
    effective_date: Int,
    termination_date: Int,
    legs: List[FpmlLeg],
};

pub type FpmlValidationReport = struct {
    is_valid: Bool,
    rule_violations_count: Int,
    error_summary: String,
};

pub fn fpml_leg_new(
    payer: String,
    receiver: String,
    ccy: String,
    notional: Float,
    fixed: Bool,
    rate: Float,
    dcf: String,
    roll: String,
    freq_m: Int
) -> FpmlLeg {
    return FpmlLeg {
        payer_party_id: payer,
        receiver_party_id: receiver,
        currency: ccy,
        notional: notional,
        is_fixed: fixed,
        rate_or_spread: rate,
        day_count_fraction: dcf,
        roll_convention: roll,
        payment_frequency_months: freq_m,
    };
}

pub fn fpml_trade_new(
    id: String,
    prod: String,
    t_date: Int,
    eff_date: Int,
    term_date: Int
) -> FpmlTrade {
    let empty_l: List[FpmlLeg] = list_new();
    return FpmlTrade {
        trade_id: id,
        product_type: prod,
        trade_date: t_date,
        effective_date: eff_date,
        termination_date: term_date,
        legs: empty_l,
    };
}

pub fn fpml_trade_add_leg(trade: &mut FpmlTrade, leg: FpmlLeg) {
    (trade).legs = list_push((trade).legs, leg);
}

pub fn fpml_validate_contract(trade: &FpmlTrade) -> FpmlValidationReport {
    let mut violations: Int = 0;

    if (trade).effective_date >= (trade).termination_date {
        violations = violations + 1;
    }
    if (trade).trade_date > (trade).effective_date {
        violations = violations + 1;
    }

    let n_legs: Int = list_len((trade).legs);
    if n_legs == 0 {
        violations = violations + 1;
    }

    let mut i: Int = 0;
    while i < n_legs {
        let leg: FpmlLeg = list_get((trade).legs, i);
        if (leg).notional <= 0.0 {
            violations = violations + 1;
        }
        if (leg).payment_frequency_months <= 0 {
            violations = violations + 1;
        }
        i = i + 1;
    }

    let valid: Bool = violations == 0;
    let err_str: String = if valid { "VALID_FPML_CONTRACT" } else { "VALIDATION_RULES_FAILED" };

    return FpmlValidationReport {
        is_valid: valid,
        rule_violations_count: violations,
        error_summary: err_str,
    };
}
