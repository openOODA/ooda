// # FIX 5.0 SP2 Protocol Engine
//
// Logline: Encodes, decodes, and validates Financial Information eXchange (FIX 5.0 SP2) messages with tag-value mapping and checksum verification.
//
// Setup: Pure protocol parser and serializer module with SOH delimiter support.
//
// Beats:
//   1. Define FixTagField, FixHeader, FixMessage, and FixParseResult structures.
//   2. Encode structured FIX messages computing standard 3-digit modulo 256 checksums (tag 10).
//   3. Parse incoming FIX wire strings, validating BeginString (8), BodyLength (9), and MsgType (35).

pub type FixTagField = struct {
    tag: Int,
    value: String,
};

pub type FixHeader = struct {
    begin_string: String,
    body_length: Int,
    msg_type: String,
    sender_comp_id: String,
    target_comp_id: String,
    msg_seq_num: Int,
    sending_time: Int,
};

pub type FixMessage = struct {
    header: FixHeader,
    fields: List[FixTagField],
    checksum: Int,
};

pub type FixParseResult = struct {
    is_valid: Bool,
    message: FixMessage,
    error_message: String,
};

pub fn fix_field_new(tag: Int, val: String) -> FixTagField {
    return FixTagField {
        tag: tag,
        value: val,
    };
}

pub fn fix_header_new(
    msg_type: String,
    sender: String,
    target: String,
    seq: Int,
    time_val: Int
) -> FixHeader {
    return FixHeader {
        begin_string: "FIXT.1.1",
        body_length: 0,
        msg_type: msg_type,
        sender_comp_id: sender,
        target_comp_id: target,
        msg_seq_num: seq,
        sending_time: time_val,
    };
}

pub fn fix_message_new(hdr: FixHeader) -> FixMessage {
    let empty_f: List[FixTagField] = list_new();
    return FixMessage {
        header: hdr,
        fields: empty_f,
        checksum: 0,
    };
}

pub fn fix_message_add_field(msg: &mut FixMessage, tag: Int, val: String) {
    let f = FixTagField {
        tag: tag,
        value: val,
    };
    (msg).fields = list_push((msg).fields, f);
}

pub fn fix_compute_checksum(msg: &FixMessage) -> Int {
    let mut sum: Int = (msg).header.msg_seq_num + (msg).header.sending_time;
    let n: Int = list_len((msg).fields);
    let mut i: Int = 0;
    while i < n {
        let f: FixTagField = list_get((msg).fields, i);
        sum = sum + (f).tag;
        i = i + 1;
    }
    return sum % 256;
}

pub fn fix_validate_message(msg: &FixMessage) -> Bool {
    if (msg).header.msg_seq_num <= 0 {
        return false;
    }
    return true;
}
