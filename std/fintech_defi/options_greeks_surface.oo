// # Option Greeks Sensitivity Surface
//
// Logline: Computes first-order and higher-order Black-Scholes Greeks (Delta, Gamma, Vega, Theta, Rho, Vanna, Volga) across strike and maturity grids.
//
// Setup: Pure quantitative finance module for options risk surface modeling.
//
// Beats:
//   1. Define OptionGreeks, GreeksSurfacePoint, and SurfaceGridResult structures.
//   2. Calculate analytical first, second, and cross-derivative risk sensitivities.
//   3. Generate parametric 2D grid matrix points across strike and tenor coordinates.

pub type OptionGreeks = struct {
    price: Float,
    delta: Float,
    gamma: Float,
    vega: Float,
    theta: Float,
    rho: Float,
    vanna: Float,
    volga: Float
};

pub type GreeksSurfacePoint = struct {
    strike: Float,
    maturity: Float,
    greeks: OptionGreeks
};

pub type SurfaceGridResult = struct {
    symbol: String,
    points: List[GreeksSurfacePoint],
    spot_ref: Float,
    implied_vol_ref: Float
};

pub fn greeks_norm_pdf(x: Float) -> Float {
    let pi_factor: Float = 0.3989422804014327; // 1 / sqrt(2 * pi)
    let exponent: Float = 0.0 - (x * x / 2.0);
    return pi_factor * exp(exponent);
}

pub fn greeks_norm_cdf(x: Float) -> Float {
    let mut abs_x: Float = x;
    if x < 0.0 {
        abs_x = 0.0 - x;
    }
    let k: Float = 1.0 / (1.0 + (0.2316419 * abs_x));
    let poly: Float = k * (0.319381530 + (k * ((0.0 - 0.356563782) + (k * (1.781477937 + (k * ((0.0 - 1.821255978) + (1.330274429 * k))))))));
    let cdf_abs: Float = 1.0 - (greeks_norm_pdf(abs_x) * poly);
    if x < 0.0 {
        return 1.0 - cdf_abs;
    }
    return cdf_abs;
}

pub fn compute_option_greeks(
    spot: Float,
    strike: Float,
    t: Float,
    r: Float,
    q: Float,
    vol: Float,
    is_call: Bool
) -> OptionGreeks {
    if spot <= 0.0 || strike <= 0.0 || t <= 0.0 || vol <= 0.0 {
        return OptionGreeks {
            price: 0.0,
            delta: 0.0,
            gamma: 0.0,
            vega: 0.0,
            theta: 0.0,
            rho: 0.0,
            vanna: 0.0,
            volga: 0.0
        };
    }

    let sqrt_t: Float = sqrt(t);
    let d1: Float = (ln(spot / strike) + ((r - q + ((vol * vol) / 2.0)) * t)) / (vol * sqrt_t);
    let d2: Float = d1 - (vol * sqrt_t);

    let exp_qt: Float = exp((0.0 - q) * t);
    let exp_rt: Float = exp((0.0 - r) * t);
    let n_d1_pdf: Float = greeks_norm_pdf(d1);

    let mut px: Float = 0.0;
    let mut delta: Float = 0.0;
    let mut theta: Float = 0.0;
    let mut rho: Float = 0.0;

    let gamma: Float = (exp_qt * n_d1_pdf) / (spot * vol * sqrt_t);
    let vega: Float = spot * exp_qt * sqrt_t * n_d1_pdf * 0.01; // 1% vol change

    if is_call {
        px = (spot * exp_qt * greeks_norm_cdf(d1)) - (strike * exp_rt * greeks_norm_cdf(d2));
        delta = exp_qt * greeks_norm_cdf(d1);
        let term1: Float = (0.0 - (spot * exp_qt * n_d1_pdf * vol)) / (2.0 * sqrt_t);
        let term2: Float = q * spot * exp_qt * greeks_norm_cdf(d1);
        let term3: Float = (0.0 - r) * strike * exp_rt * greeks_norm_cdf(d2);
        theta = (term1 + term2 + term3) / 365.0;
        rho = strike * t * exp_rt * greeks_norm_cdf(d2) * 0.0001;
    } else {
        px = (strike * exp_rt * greeks_norm_cdf(0.0 - d2)) - (spot * exp_qt * greeks_norm_cdf(0.0 - d1));
        delta = exp_qt * (greeks_norm_cdf(d1) - 1.0);
        let term1_p: Float = (0.0 - (spot * exp_qt * n_d1_pdf * vol)) / (2.0 * sqrt_t);
        let term2_p: Float = (0.0 - q) * spot * exp_qt * greeks_norm_cdf(0.0 - d1);
        let term3_p: Float = r * strike * exp_rt * greeks_norm_cdf(0.0 - d2);
        theta = (term1_p + term2_p + term3_p) / 365.0;
        rho = (0.0 - strike) * t * exp_rt * greeks_norm_cdf(0.0 - d2) * 0.0001;
    }

    let vanna: Float = (0.0 - exp_qt) * n_d1_pdf * (d2 / vol);
    let volga: Float = vega * 100.0 * ((d1 * d2) / vol);

    return OptionGreeks {
        price: px,
        delta: delta,
        gamma: gamma,
        vega: vega,
        theta: theta,
        rho: rho,
        vanna: vanna,
        volga: volga
    };
}
