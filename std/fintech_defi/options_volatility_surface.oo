// # Implied Volatility Surface and SVI Parametric Model
//
// Logline: Implements Stochastic Volatility Inspired (SVI) parametric formulation and bilinear surface interpolation across strike-tenor grids.
//
// Setup: Pure quantitative finance module for volatility surface construction.
//
// Beats:
//   1. Define SviParameters, VolSurfacePoint, and VolSurfaceGrid structures.
//   2. Calculate total implied variance using Gatheral raw SVI parametrization w(k) = a + b * (rho*(k-m) + sqrt((k-m)^2 + sigma^2)).
//   3. Perform smile interpolation and arbitrage constraint checks (calendar and butterfly).

pub type SviParameters = struct {
    a: Float,
    b: Float,
    rho: Float,
    m: Float,
    sigma: Float,
};

pub type VolSurfacePoint = struct {
    log_moneyness_k: Float,
    tenor_years: Float,
    implied_volatility: Float,
    total_variance: Float,
};

pub type VolSurfaceGrid = struct {
    symbol: String,
    points: List[VolSurfacePoint],
    atm_vol: Float,
};

pub fn svi_params_new(
    a: Float,
    b: Float,
    rho: Float,
    m: Float,
    sigma: Float
) -> SviParameters {
    return SviParameters {
        a: a,
        b: b,
        rho: rho,
        m: m,
        sigma: sigma,
    };
}

pub fn svi_total_variance(params: &SviParameters, k: Float) -> Float {
    let a: Float = (params).a;
    let b: Float = (params).b;
    let rho: Float = (params).rho;
    let m: Float = (params).m;
    let sigma: Float = (params).sigma;

    let k_diff: Float = k - m;
    let sqrt_term: Float = sqrt((k_diff * k_diff) + (sigma * sigma));
    let w: Float = a + (b * ((rho * k_diff) + sqrt_term));

    if w < 0.000001 {
        return 0.000001;
    }
    return w;
}

pub fn svi_implied_volatility(params: &SviParameters, k: Float, t: Float) -> Float {
    if t <= 0.0 {
        return 0.0;
    }
    let total_var: Float = svi_total_variance(params, k);
    return sqrt(total_var / t);
}

pub fn svi_check_no_butterfly_arbitrage(params: &SviParameters, k: Float) -> Bool {
    let b: Float = (params).b;
    let rho: Float = (params).rho;
    let m: Float = (params).m;
    let sigma: Float = (params).sigma;

    let k_diff: Float = k - m;
    let disc: Float = (k_diff * k_diff) + (sigma * sigma);
    let sqrt_d: Float = sqrt(disc);

    let w_prime: Float = b * (rho + (k_diff / sqrt_d));
    let w_second: Float = (b * sigma * sigma) / (disc * sqrt_d);
    let w_val: Float = svi_total_variance(params, k);

    let g_k: Float = (1.0 - ((k * w_prime) / (2.0 * w_val))) * (1.0 - ((k * w_prime) / (2.0 * w_val)))
        - ((w_prime * w_prime) / 4.0) * ((1.0 / w_val) + 0.25)
        + (w_second / 2.0);

    return g_k >= 0.0;
}
