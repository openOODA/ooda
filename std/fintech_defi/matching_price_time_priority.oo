// # Price-Time Priority Order Matching Queue
//
// Logline: Implements strict FIFO queue scheduling at distinct price levels with queue position tracking and fill prioritization.
//
// Setup: Pure queue algorithm for deterministic exchange matching engines.
//
// Beats:
//   1. Define FifoQueueEntry, PriceLevelQueue, and QueueFillResult structures.
//   2. Enqueue orders at price tiers maintaining arrival timestamp priority.
//   3. Match crossing volume sequentially against front-of-queue entries.

pub type FifoQueueEntry = struct {
    order_id: Int,
    initial_qty: Int,
    remaining_qty: Int,
    entry_timestamp_ns: Int,
    queue_position: Int
};

pub type PriceLevelQueue = struct {
    price: Int,
    is_bid: Bool,
    entries: List[FifoQueueEntry],
    total_level_qty: Int,
    next_position_seq: Int
};

pub type QueueFillResult = struct {
    filled_order_id: Int,
    fill_qty: Int,
    is_fully_filled: Bool,
    remaining_in_level: Int
};

pub fn price_level_queue_new(price: Int, is_bid: Bool) -> PriceLevelQueue {
    let empty_q: List[FifoQueueEntry] = list_new();
    return PriceLevelQueue {
        price: price,
        is_bid: is_bid,
        entries: empty_q,
        total_level_qty: 0,
        next_position_seq: 1
    };
}

pub fn fifo_queue_enqueue(
    queue: &mut PriceLevelQueue,
    order_id: Int,
    qty: Int,
    ts_ns: Int
) -> FifoQueueEntry {
    let entry = FifoQueueEntry {
        order_id: order_id,
        initial_qty: qty,
        remaining_qty: qty,
        entry_timestamp_ns: ts_ns,
        queue_position: (queue).next_position_seq
    };
    (queue).entries = list_push((queue).entries, entry);
    (queue).total_level_qty = (queue).total_level_qty + qty;
    (queue).next_position_seq = (queue).next_position_seq + 1;
    return entry;
}

pub fn fifo_queue_match_volume(
    queue: &mut PriceLevelQueue,
    incoming_qty: Int
) -> List[QueueFillResult] {
    let mut fills: List[QueueFillResult] = list_new();
    let mut rem_incoming: Int = incoming_qty;

    if rem_incoming <= 0 || (queue).total_level_qty <= 0 {
        return fills;
    }

    let mut remaining_entries: List[FifoQueueEntry] = list_new();
    let old_entries: List[FifoQueueEntry] = (queue).entries;
    let n: Int = list_len(old_entries);
    let mut i: Int = 0;

    while i < n {
        let mut entry: FifoQueueEntry = list_get(old_entries, i);
        if rem_incoming > 0 && (entry).remaining_qty > 0 {
            let mut fill: Int = rem_incoming;
            if (entry).remaining_qty < fill {
                fill = (entry).remaining_qty;
            }
            entry.remaining_qty = (entry).remaining_qty - fill;
            rem_incoming = rem_incoming - fill;
            (queue).total_level_qty = (queue).total_level_qty - fill;

            let is_done: Bool = (entry).remaining_qty == 0;
            let fill_res = QueueFillResult {
                filled_order_id: (entry).order_id,
                fill_qty: fill,
                is_fully_filled: is_done,
                remaining_in_level: (queue).total_level_qty
            };
            fills = list_push(fills, fill_res);
        }

        if (entry).remaining_qty > 0 {
            remaining_entries = list_push(remaining_entries, entry);
        }
        i = i + 1;
    }

    (queue).entries = remaining_entries;
    return fills;
}

pub fn fifo_queue_cancel_order(
    queue: &mut PriceLevelQueue,
    order_id: Int
) -> Bool {
    let mut found: Bool = false;
    let mut new_list: List[FifoQueueEntry] = list_new();
    let old_list: List[FifoQueueEntry] = (queue).entries;
    let n: Int = list_len(old_list);
    let mut i: Int = 0;

    while i < n {
        let entry: FifoQueueEntry = list_get(old_list, i);
        if (entry).order_id == order_id {
            found = true;
            (queue).total_level_qty = (queue).total_level_qty - (entry).remaining_qty;
        } else {
            new_list = list_push(new_list, entry);
        }
        i = i + 1;
    }

    (queue).entries = new_list;
    return found;
}
