// # FAST Protocol Template Loader
//
// Logline: Defines FAST (FIX Adapted for STreaming) message templates, presence maps (PMAP), and field operator state machines.
//
// Setup: Pure binary decoding protocol module for ultra low latency feeds.
//
// Beats:
//   1. Define FastOperator, FastFieldDef, FastTemplate, and FastDecoderContext structures.
//   2. Manage field dictionary states across sequential messages for COPY, DELTA, INCR, and DEFAULT operators.
//   3. Decode compressed field integers against presence map bits.

pub type FastFieldDef = struct {
    field_id: Int,
    name: String,
    operator_type: Int, // 0: None, 1: Copy, 2: Delta, 3: Increment, 4: Default, 5: Constant
    is_optional: Bool,
    initial_value: Int
};

pub type FastTemplate = struct {
    template_id: Int,
    name: String,
    fields: List[FastFieldDef]
};

pub type FastDecoderContext = struct {
    template_id: Int,
    dictionary_keys: List[Int],
    dictionary_values: List[Int]
};

pub fn fast_field_new(
    id: Int,
    name: String,
    op: Int,
    opt: Bool,
    init_val: Int
) -> FastFieldDef {
    return FastFieldDef {
        field_id: id,
        name: name,
        operator_type: op,
        is_optional: opt,
        initial_value: init_val
    };
}

pub fn fast_template_new(id: Int, name: String) -> FastTemplate {
    let empty_f: List[FastFieldDef] = list_new();
    return FastTemplate {
        template_id: id,
        name: name,
        fields: empty_f
    };
}

pub fn fast_template_add_field(tpl: &mut FastTemplate, fld: FastFieldDef) {
    (tpl).fields = list_push((tpl).fields, fld);
}

pub fn fast_context_new(tpl_id: Int) -> FastDecoderContext {
    let empty_k: List[Int] = list_new();
    let empty_v: List[Int] = list_new();
    return FastDecoderContext {
        template_id: tpl_id,
        dictionary_keys: empty_k,
        dictionary_values: empty_v
    };
}

pub fn fast_decode_field_value(
    ctx: &mut FastDecoderContext,
    field: &FastFieldDef,
    is_present_in_pmap: Bool,
    wire_delta: Int
) -> Int {
    let op: Int = (field).operator_type;

    if op == 0 {
        // None / Direct
        return wire_delta;
    }
    if op == 1 {
        // Copy
        if is_present_in_pmap {
            return wire_delta;
        } else {
            return (field).initial_value;
        }
    }
    if op == 2 {
        // Delta
        let prev_val: Int = (field).initial_value;
        return prev_val + wire_delta;
    }
    if op == 3 {
        // Increment
        if is_present_in_pmap {
            return wire_delta;
        } else {
            return (field).initial_value + 1;
        }
    }
    if op == 4 {
        // Default
        if is_present_in_pmap {
            return wire_delta;
        } else {
            return (field).initial_value;
        }
    }

    return wire_delta;
}
