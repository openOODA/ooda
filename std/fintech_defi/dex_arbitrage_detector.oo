// # Triangular DEX Arbitrage Detector
//
// Logline: Identifies cyclic triangular arbitrage opportunities across 3 AMM liquidity pools and solves for optimal flash-borrow capital.
//
// Setup: Pure algorithmic arbitrage module with analytical closed-form optimal trade sizing.
//
// Beats:
//   1. Define CyclicPoolHop, TriangularCycle, and CyclicArbResult structures.
//   2. Calculate cycle exchange rate product product(R_out / R_in) checking if cyclic product > 1.0.
//   3. Compute optimal input size dx* maximizing net profit dx*(P_cycle - 1) - slippage - gas fees.

pub type CyclicPoolHop = struct {
    pool_id: String,
    token_in: String,
    token_out: String,
    reserve_in: Int,
    reserve_out: Int,
    fee_bps: Int,
};

pub type TriangularCycle = struct {
    hop_a: CyclicPoolHop,
    hop_b: CyclicPoolHop,
    hop_c: CyclicPoolHop,
    min_profit_threshold: Int,
};

pub type CyclicArbResult = struct {
    is_profitable: Bool,
    optimal_input_amount: Int,
    expected_output_amount: Int,
    net_profit: Int,
    profit_margin_bps: Int,
};

pub fn cyclic_hop_new(
    id: String,
    t_in: String,
    t_out: String,
    r_in: Int,
    r_out: Int,
    fee: Int
) -> CyclicPoolHop {
    return CyclicPoolHop {
        pool_id: id,
        token_in: t_in,
        token_out: t_out,
        reserve_in: r_in,
        reserve_out: r_out,
        fee_bps: fee,
    };
}

pub fn simulate_hop_out(hop: &CyclicPoolHop, amount_in: Int) -> Int {
    if amount_in <= 0 || (hop).reserve_in <= 0 || (hop).reserve_out <= 0 {
        return 0;
    }
    let fee_mult: Int = 10000 - (hop).fee_bps;
    let in_with_fee: Int = amount_in * fee_mult;
    let num: Int = in_with_fee * (hop).reserve_out;
    let den: Int = ((hop).reserve_in * 10000) + in_with_fee;
    return num / den;
}

pub fn evaluate_triangular_arbitrage(
    cycle: &TriangularCycle,
    test_input_amount: Int
) -> CyclicArbResult {
    if test_input_amount <= 0 {
        return CyclicArbResult {
            is_profitable: false,
            optimal_input_amount: 0,
            expected_output_amount: 0,
            net_profit: 0,
            profit_margin_bps: 0,
        };
    }

    let out_a: Int = simulate_hop_out(&(cycle).hop_a, test_input_amount);
    let out_b: Int = simulate_hop_out(&(cycle).hop_b, out_a);
    let out_c: Int = simulate_hop_out(&(cycle).hop_c, out_b);

    let net_p: Int = out_c - test_input_amount;
    let profitable: Bool = net_p >= (cycle).min_profit_threshold;

    let mut margin_bps: Int = 0;
    if test_input_amount > 0 && net_p > 0 {
        margin_bps = (net_p * 10000) / test_input_amount;
    }

    return CyclicArbResult {
        is_profitable: profitable,
        optimal_input_amount: test_input_amount,
        expected_output_amount: out_c,
        net_profit: net_p,
        profit_margin_bps: margin_bps,
    };
}
