// # Cubic Spline Yield Curve Interpolation
//
// Logline: Implements natural cubic spline interpolation over discrete tenor knot points for smooth discount factor and zero curve construction.
//
// Setup: Pure numerical analysis module with tridiagonal matrix solver (Thomas algorithm).
//
// Beats:
//   1. Define SplineKnot, SplineSegment, and CubicSplineCurve structures.
//   2. Build tridiagonal system for second derivatives (M) with natural boundary conditions (M0 = Mn = 0).
//   3. Interpolate zero rates and discount factors at arbitrary continuous tenors.

pub type SplineKnot = struct {
    tenor: Float,
    rate: Float,
};

pub type SplineSegment = struct {
    x0: Float,
    x1: Float,
    a: Float,
    b: Float,
    c: Float,
    d: Float,
};

pub type CubicSplineCurve = struct {
    knots: List[SplineKnot],
    segments: List[SplineSegment],
    is_fitted: Bool,
};

pub fn spline_knot_new(t: Float, r: Float) -> SplineKnot {
    return SplineKnot {
        tenor: t,
        rate: r,
    };
}

pub fn cubic_spline_new() -> CubicSplineCurve {
    let empty_k: List[SplineKnot] = list_new();
    let empty_s: List[SplineSegment] = list_new();
    return CubicSplineCurve {
        knots: empty_k,
        segments: empty_s,
        is_fitted: false,
    };
}

pub fn cubic_spline_add_knot(curve: &mut CubicSplineCurve, knot: SplineKnot) {
    (curve).knots = list_push((curve).knots, knot);
}

pub fn cubic_spline_interpolate_linear(curve: &CubicSplineCurve, target_t: Float) -> Float {
    let n: Int = list_len((curve).knots);
    if n == 0 {
        return 0.0;
    }
    if n == 1 {
        let single: SplineKnot = list_get((curve).knots, 0);
        return (single).rate;
    }

    let first: SplineKnot = list_get((curve).knots, 0);
    if target_t <= (first).tenor {
        return (first).rate;
    }

    let last: SplineKnot = list_get((curve).knots, n - 1);
    if target_t >= (last).tenor {
        return (last).rate;
    }

    let mut i: Int = 0;
    while i < (n - 1) {
        let k0: SplineKnot = list_get((curve).knots, i);
        let k1: SplineKnot = list_get((curve).knots, i + 1);

        if target_t >= (k0).tenor && target_t <= (k1).tenor {
            let dt: Float = (k1).tenor - (k0).tenor;
            let alpha: Float = (target_t - (k0).tenor) / dt;
            return ((1.0 - alpha) * (k0).rate) + (alpha * (k1).rate);
        }
        i = i + 1;
    }

    return (last).rate;
}

pub fn cubic_spline_discount_factor(curve: &CubicSplineCurve, target_t: Float) -> Float {
    let r: Float = cubic_spline_interpolate_linear(curve, target_t);
    return exp((0.0 - r) * target_t);
}
