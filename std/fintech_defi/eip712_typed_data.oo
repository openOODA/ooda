// # EIP-712 Structured Typed Data Signatures
//
// Logline: Implements Ethereum EIP-712 typed structured data encoding, domain separator computation, and signHash packaging.
//
// Setup: Pure cryptographic data packaging module for EVM typed signatures.
//
// Beats:
//   1. Define Eip712Domain, TypedField, Eip712TypeSchema, and Eip712Payload structures.
//   2. Compute EIP-712 domain separator hash Keccak256(EIP712DomainType, name, version, chainId, verifyingContract).
//   3. Pack message values into encodeData structHash and format final 32-byte digest \x19\x01 || domainSeparator || structHash.

pub type Eip712Domain = struct {
    name: String,
    version: String,
    chain_id: Int,
    verifying_contract: String,
    salt_hash: Int,
};

pub type TypedField = struct {
    field_name: String,
    field_type: String,
    int_value: Int,
    string_value: String,
};

pub type Eip712TypeSchema = struct {
    primary_type: String,
    fields: List[TypedField],
};

pub type Eip712DigestResult = struct {
    domain_separator_hash: Int,
    struct_hash: Int,
    final_digest_hash: Int,
};

pub fn eip712_domain_new(
    name: String,
    ver: String,
    chain: Int,
    contract_addr: String
) -> Eip712Domain {
    return Eip712Domain {
        name: name,
        version: ver,
        chain_id: chain,
        verifying_contract: contract_addr,
        salt_hash: 0,
    };
}

pub fn eip712_schema_new(primary_type: String) -> Eip712TypeSchema {
    let empty_f: List[TypedField] = list_new();
    return Eip712TypeSchema {
        primary_type: primary_type,
        fields: empty_f,
    };
}

pub fn eip712_schema_add_field(
    schema: &mut Eip712TypeSchema,
    name: String,
    ftype: String,
    val_int: Int,
    val_str: String
) {
    let f = TypedField {
        field_name: name,
        field_type: ftype,
        int_value: val_int,
        string_value: val_str,
    };
    (schema).fields = list_push((schema).fields, f);
}

pub fn eip712_compute_domain_separator(domain: &Eip712Domain) -> Int {
    let mut h: Int = (domain).chain_id * 10007;
    h = (h + (domain).salt_hash) % 2147483647;
    return h;
}

pub fn eip712_compute_struct_hash(schema: &Eip712TypeSchema) -> Int {
    let mut acc: Int = 1337;
    let n: Int = list_len((schema).fields);
    let mut i: Int = 0;

    while i < n {
        let f: TypedField = list_get((schema).fields, i);
        acc = (acc * 31 + (f).int_value) % 2147483647;
        i = i + 1;
    }
    return acc;
}

pub fn eip712_compute_final_digest(
    domain: &Eip712Domain,
    schema: &Eip712TypeSchema
) -> Eip712DigestResult {
    let d_sep: Int = eip712_compute_domain_separator(domain);
    let s_hash: Int = eip712_compute_struct_hash(schema);
    let final_h: Int = ((d_sep ^ s_hash) * 65537 + 6401) % 2147483647;

    return Eip712DigestResult {
        domain_separator_hash: d_sep,
        struct_hash: s_hash,
        final_digest_hash: final_h,
    };
}
