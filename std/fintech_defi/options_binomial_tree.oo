// # Binomial Tree Option Pricing Model
//
// Logline: Implements Cox-Ross-Rubinstein (CRR) binomial lattice backward induction for American and European option valuation.
//
// Setup: Pure quantitative finance module with dynamic lattice arrays.
//
// Beats:
//   1. Define BinomialOptionParams and BinomialLatticeResult structures.
//   2. Compute CRR up/down step ratios and risk-neutral transition probability.
//   3. Construct terminal payoff vector and apply backward induction with early-exercise comparison.

pub type BinomialOptionParams = struct {
    spot: Float,
    strike: Float,
    time_to_expiry: Float,
    risk_free_rate: Float,
    volatility: Float,
    steps: Int,
    is_call: Bool,
    is_american: Bool,
};

pub type BinomialLatticeResult = struct {
    option_price: Float,
    delta: Float,
    gamma: Float,
    early_exercise_premium: Float,
};

pub fn binomial_params_new(
    spot: Float,
    strike: Float,
    t: Float,
    r: Float,
    vol: Float,
    steps: Int,
    is_call: Bool,
    is_american: Bool
) -> BinomialOptionParams {
    return BinomialOptionParams {
        spot: spot,
        strike: strike,
        time_to_expiry: t,
        risk_free_rate: r,
        volatility: vol,
        steps: steps,
        is_call: is_call,
        is_american: is_american,
    };
}

pub fn binomial_price(params: &BinomialOptionParams) -> BinomialLatticeResult {
    let s0: Float = (params).spot;
    let k: Float = (params).strike;
    let t: Float = (params).time_to_expiry;
    let r: Float = (params).risk_free_rate;
    let vol: Float = (params).volatility;
    let n: Int = (params).steps;

    if n <= 0 || t <= 0.0 || s0 <= 0.0 {
        let mut intr: Float = 0.0;
        if (params).is_call {
            if s0 > k { intr = s0 - k; }
        } else {
            if k > s0 { intr = k - s0; }
        }
        return BinomialLatticeResult {
            option_price: intr,
            delta: 0.0,
            gamma: 0.0,
            early_exercise_premium: 0.0,
        };
    }

    let dt: Float = t / (1.0 * n);
    let u: Float = exp(vol * sqrt(dt));
    let d: Float = 1.0 / u;
    let discount: Float = exp((0.0 - r) * dt);
    let p: Float = (exp(r * dt) - d) / (u - d);
    let q: Float = 1.0 - p;

    let mut values: List[Float] = list_new();
    let mut i: Int = 0;
    while i <= n {
        let up_count: Int = n - i;
        let mut spot_terminal: Float = s0;
        let mut u_idx: Int = 0;
        while u_idx < up_count {
            spot_terminal = spot_terminal * u;
            u_idx = u_idx + 1;
        }
        let mut d_idx: Int = 0;
        while d_idx < i {
            spot_terminal = spot_terminal * d;
            d_idx = d_idx + 1;
        }

        let mut payoff: Float = 0.0;
        if (params).is_call {
            if spot_terminal > k {
                payoff = spot_terminal - k;
            }
        } else {
            if k > spot_terminal {
                payoff = k - spot_terminal;
            }
        }
        values = list_push(values, payoff);
        i = i + 1;
    }

    let mut step: Int = n - 1;
    let mut delta_val: Float = 0.0;
    let mut gamma_val: Float = 0.0;

    while step >= 0 {
        let mut next_values: List[Float] = list_new();
        let mut j: Int = 0;
        while j <= step {
            let v_up: Float = list_get(values, j);
            let v_down: Float = list_get(values, j + 1);
            let cont_val: Float = discount * ((p * v_up) + (q * v_down));

            let mut node_spot: Float = s0;
            let up_c: Int = step - j;
            let mut u_c_idx: Int = 0;
            while u_c_idx < up_c {
                node_spot = node_spot * u;
                u_c_idx = u_c_idx + 1;
            }
            let mut d_c_idx: Int = 0;
            while d_c_idx < j {
                node_spot = node_spot * d;
                d_c_idx = d_c_idx + 1;
            }

            let mut final_val: Float = cont_val;
            if (params).is_american {
                let mut intr_node: Float = 0.0;
                if (params).is_call {
                    if node_spot > k { intr_node = node_spot - k; }
                } else {
                    if k > node_spot { intr_node = k - node_spot; }
                }
                if intr_node > cont_val {
                    final_val = intr_node;
                }
            }
            next_values = list_push(next_values, final_val);
            j = j + 1;
        }
        values = next_values;

        if step == 1 {
            let f_u: Float = list_get(values, 0);
            let f_d: Float = list_get(values, 1);
            delta_val = (f_u - f_d) / (s0 * (u - d));
        }
        step = step - 1;
    }

    let option_val: Float = list_get(values, 0);
    return BinomialLatticeResult {
        option_price: option_val,
        delta: delta_val,
        gamma: gamma_val,
        early_exercise_premium: 0.0,
    };
}
