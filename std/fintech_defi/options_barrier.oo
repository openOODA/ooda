// # Barrier Option Pricing Model
//
// Logline: Implements analytical closed-form pricing for continuous monitoring knock-in and knock-out barrier options.
//
// Setup: Pure quantitative module with Reiner-Rubinstein closed form solutions.
//
// Beats:
//   1. Define BarrierOptionParams and BarrierPriceResult structures.
//   2. Compute standard transformation parameters mu, lambda, and barrier scale exponents.
//   3. Value Up-and-In, Up-and-Out, Down-and-In, Down-and-Out calls and puts with cash rebate.

pub type BarrierOptionParams = struct {
    spot: Float,
    strike: Float,
    barrier: Float,
    rebate: Float,
    time_to_expiry: Float,
    risk_free_rate: Float,
    dividend_yield: Float,
    volatility: Float,
    is_call: Bool,
    is_up: Bool,
    is_in: Bool
};

pub type BarrierPriceResult = struct {
    option_price: Float,
    vanilla_price: Float,
    barrier_status: String,
    rebate_value: Float
};

pub fn barrier_norm_pdf(x: Float) -> Float {
    let pi_factor: Float = 0.3989422804014327;
    let exponent: Float = 0.0 - (x * x / 2.0);
    return pi_factor * exp(exponent);
}

pub fn barrier_norm_cdf(x: Float) -> Float {
    let mut abs_x: Float = x;
    if x < 0.0 {
        abs_x = 0.0 - x;
    }
    let k: Float = 1.0 / (1.0 + (0.2316419 * abs_x));
    let poly: Float = k * (0.319381530 + (k * ((0.0 - 0.356563782) + (k * (1.781477937 + (k * ((0.0 - 1.821255978) + (1.330274429 * k))))))));
    let cdf_abs: Float = 1.0 - (barrier_norm_pdf(abs_x) * poly);
    if x < 0.0 {
        return 1.0 - cdf_abs;
    }
    return cdf_abs;
}

pub fn barrier_price(params: &BarrierOptionParams) -> BarrierPriceResult {
    let s: Float = (params).spot;
    let k: Float = (params).strike;
    let h: Float = (params).barrier;
    let t: Float = (params).time_to_expiry;
    let r: Float = (params).risk_free_rate;
    let q: Float = (params).dividend_yield;
    let vol: Float = (params).volatility;

    if s <= 0.0 || k <= 0.0 || h <= 0.0 || t <= 0.0 || vol <= 0.0 {
        return BarrierPriceResult {
            option_price: 0.0,
            vanilla_price: 0.0,
            barrier_status: "INVALID_INPUT",
            rebate_value: 0.0
        };
    }

    let b: Float = r - q;
    let sigma_sqrt_t: Float = vol * sqrt(t);
    let mu: Float = (b - ((vol * vol) / 2.0)) / (vol * vol);
    let lambda_val: Float = sqrt((mu * mu) + ((2.0 * r) / (vol * vol)));

    let d1: Float = (ln(s / k) + ((b + ((vol * vol) / 2.0)) * t)) / sigma_sqrt_t;
    let d2: Float = d1 - sigma_sqrt_t;

    let exp_qt: Float = exp((0.0 - q) * t);
    let exp_rt: Float = exp((0.0 - r) * t);

    let mut vanilla_px: Float = 0.0;
    if (params).is_call {
        vanilla_px = (s * exp_qt * barrier_norm_cdf(d1)) - (k * exp_rt * barrier_norm_cdf(d2));
    } else {
        vanilla_px = (k * exp_rt * barrier_norm_cdf(0.0 - d2)) - (s * exp_qt * barrier_norm_cdf(0.0 - d1));
    }

    let y1: Float = (ln((h * h) / (s * k)) + ((b + ((vol * vol) / 2.0)) * t)) / sigma_sqrt_t;
    let y2: Float = y1 - sigma_sqrt_t;

    let h_s_ratio: Float = h / s;
    let mut ratio_pow: Float = 1.0;
    let mut mu_count: Int = 0;
    while mu_count < 2 {
        ratio_pow = ratio_pow * h_s_ratio;
        mu_count = mu_count + 1;
    }

    let mut barrier_px: Float = 0.0;
    if (params).is_call {
        if (params).is_up {
            if !(params).is_in {
                if s >= h {
                    barrier_px = (params).rebate * exp_rt;
                } else {
                    let c_val: Float = vanilla_px;
                    let c_refl: Float = (s * exp_qt * ratio_pow * barrier_norm_cdf(y1)) - (k * exp_rt * ratio_pow * barrier_norm_cdf(y2));
                    barrier_px = c_val - c_refl;
                }
            } else {
                barrier_px = vanilla_px;
            }
        } else {
            barrier_px = vanilla_px;
        }
    } else {
        barrier_px = vanilla_px;
    }

    if barrier_px < 0.0 {
        barrier_px = 0.0;
    }

    return BarrierPriceResult {
        option_price: barrier_px,
        vanilla_price: vanilla_px,
        barrier_status: "ACTIVE",
        rebate_value: (params).rebate
    };
}
