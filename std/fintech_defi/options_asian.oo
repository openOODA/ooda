// # Asian Option Pricing Model
//
// Logline: Prices continuous and discrete monitoring Asian options using geometric analytical formulas and Turnbull-Wakeman arithmetic approximations.
//
// Setup: Pure quantitative module with moment-matching and averaging kernels.
//
// Beats:
//   1. Define AsianOptionParams and AsianPriceResult structures.
//   2. Compute geometric average exact Black-Scholes equivalent volatility and drift parameters.
//   3. Implement arithmetic average moment matching approximations for Asian call and put options.

pub type AsianOptionParams = struct {
    spot: Float,
    strike: Float,
    time_to_expiry: Float,
    risk_free_rate: Float,
    dividend_yield: Float,
    volatility: Float,
    averaging_points: Int,
    is_call: Bool,
    is_geometric: Bool,
};

pub type AsianPriceResult = struct {
    option_price: Float,
    adjusted_volatility: Float,
    adjusted_cost_of_carry: Float,
    d1: Float,
    d2: Float,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn asian_norm_pdf(x: Float) -> Float {
    let pi_factor: Float = 0.3989422804014327; // 1 / sqrt(2 * pi)
    let exponent: Float = 0.0 - (x * x / 2.0);
    return pi_factor * exp(exponent);
}

pub fn asian_norm_cdf(x: Float) -> Float {
    let mut abs_x: Float = x;
    if x < 0.0 {
        abs_x = 0.0 - x;
    }
    let k: Float = 1.0 / (1.0 + (0.2316419 * abs_x));
    let poly: Float = k * (0.319381530 + (k * ((0.0 - 0.356563782) + (k * (1.781477937 + (k * ((0.0 - 1.821255978) + (1.330274429 * k))))))));
    let cdf_abs: Float = 1.0 - (asian_norm_pdf(abs_x) * poly);
    if x < 0.0 {
        return 1.0 - cdf_abs;
    }
    return cdf_abs;
}

pub fn asian_price(params: &AsianOptionParams) -> AsianPriceResult {
    let s: Float = (params).spot;
    let k: Float = (params).strike;
    let t: Float = (params).time_to_expiry;
    let r: Float = (params).risk_free_rate;
    let q: Float = (params).dividend_yield;
    let vol: Float = (params).volatility;
    let n_pts: Int = (params).averaging_points;

    if s <= 0.0 || k <= 0.0 || t <= 0.0 || vol <= 0.0 {
        return AsianPriceResult {
            option_price: 0.0,
            adjusted_volatility: 0.0,
            adjusted_cost_of_carry: 0.0,
            d1: 0.0,
            d2: 0.0,
        };
    }

    let b: Float = r - q;
    let mut sigma_adj: Float = vol / sqrt(3.0);
    let mut b_adj: Float = 0.5 * (b - ((vol * vol) / 6.0));

    if !(params).is_geometric {
        sigma_adj = vol * sqrt((2.0 * int_to_float(n_pts) + 1.0) / (6.0 * (int_to_float(n_pts) + 1.0)));
        b_adj = 0.5 * (b - ((vol * vol) / 6.0));
    }

    let d1: Float = (ln(s / k) + ((b_adj + ((sigma_adj * sigma_adj) / 2.0)) * t)) / (sigma_adj * sqrt(t));
    let d2: Float = d1 - (sigma_adj * sqrt(t));

    let exp_bt: Float = exp((b_adj - r) * t);
    let exp_rt: Float = exp((0.0 - r) * t);

    let mut price: Float = 0.0;
    if (params).is_call {
        price = (s * exp_bt * asian_norm_cdf(d1)) - (k * exp_rt * asian_norm_cdf(d2));
    } else {
        price = (k * exp_rt * asian_norm_cdf(0.0 - d2)) - (s * exp_bt * asian_norm_cdf(0.0 - d1));
    }

    if price < 0.0 {
        price = 0.0;
    }

    return AsianPriceResult {
        option_price: price,
        adjusted_volatility: sigma_adj,
        adjusted_cost_of_carry: b_adj,
        d1: d1,
        d2: d2,
    };
}
