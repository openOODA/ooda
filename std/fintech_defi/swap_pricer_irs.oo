// # Interest Rate Swap Pricing Engine
//
// Logline: Prices fixed-for-floating vanilla interest rate swaps, computing present values, par swap rates, and DV01 sensitivities.
//
// Setup: Pure quantitative module with multi-period discounted cash flow valuation.
//
// Beats:
//   1. Define SwapCashFlow, VanillaIrsContract, and IrsPriceResult structures.
//   2. Compute fixed and floating leg present values over discount curves.
//   3. Solve for par swap break-even coupon rate and basis-point DV01 sensitivity.

pub type SwapCashFlow = struct {
    period_index: Int,
    payment_time: Float,
    year_fraction: Float,
    discount_factor: Float,
    fixed_amount: Float,
    floating_forward_rate: Float,
};

pub type VanillaIrsContract = struct {
    notional: Float,
    fixed_rate: Float,
    tenor_years: Float,
    payment_frequency: Int,
    is_payer_fixed: Bool,
};

pub type IrsPriceResult = struct {
    npv: Float,
    fixed_leg_pv: Float,
    floating_leg_pv: Float,
    par_swap_rate: Float,
    annuity: Float,
    dv01: Float,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn irs_contract_new(
    notional: Float,
    fixed_rate: Float,
    tenor: Float,
    freq: Int,
    payer: Bool
) -> VanillaIrsContract {
    return VanillaIrsContract {
        notional: notional,
        fixed_rate: fixed_rate,
        tenor_years: tenor,
        payment_frequency: freq,
        is_payer_fixed: payer,
    };
}

pub fn irs_price_constant_curve(
    contract: &VanillaIrsContract,
    zero_rate: Float
) -> IrsPriceResult {
    let n: Float = (contract).notional;
    let r_fixed: Float = (contract).fixed_rate;
    let t: Float = (contract).tenor_years;
    let freq: Int = (contract).payment_frequency;
    let dt: Float = 1.0 / int_to_float(freq);
    let total_periods: Int = (t * int_to_float(freq)) + 0;

    let mut annuity_val: Float = 0.0;
    let mut i: Int = 1;

    while i <= total_periods {
        let ti: Float = int_to_float(i) * dt;
        let df_i: Float = exp((0.0 - zero_rate) * ti);
        annuity_val = annuity_val + (dt * df_i);
        i = i + 1;
    }

    let df_t: Float = exp((0.0 - zero_rate) * t);
    let float_leg_pv: Float = n * (1.0 - df_t);
    let fixed_leg_pv: Float = n * r_fixed * annuity_val;

    let mut par_rate: Float = 0.0;
    if annuity_val > 0.0 {
        par_rate = (1.0 - df_t) / annuity_val;
    }

    let dv01_val: Float = n * annuity_val * 0.0001;

    let mut npv_val: Float = 0.0;
    if (contract).is_payer_fixed {
        npv_val = float_leg_pv - fixed_leg_pv;
    } else {
        npv_val = fixed_leg_pv - float_leg_pv;
    }

    return IrsPriceResult {
        npv: npv_val,
        fixed_leg_pv: fixed_leg_pv,
        floating_leg_pv: float_leg_pv,
        par_swap_rate: par_rate,
        annuity: annuity_val,
        dv01: dv01_val,
    };
}
