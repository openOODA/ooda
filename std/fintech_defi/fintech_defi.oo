pub fn fintech_defi_version() -> String {
    return "1.0.0";
}

pub fn fintech_defi_module_count() -> Int {
    return 50;
}

pub fn fintech_defi_amm_pool_default() -> ConstantProductPool {
    return amm_pool_new("WETH", "USDC", 10000000, 3000000000, 1000000, 30);
}

pub fn fintech_defi_cl_pool_default() -> ConcentratedPool {
    return cl_pool_new("WETH", "USDC", 3000, 60, 79228162514, 0);
}

pub fn fintech_defi_stableswap_default() -> StableSwapPool {
    return stableswap_pool_new("USDC", "USDT", 10000000, 10000000, 100, 4);
}

pub fn fintech_defi_order_book_default() -> L3OrderBook {
    return l3_order_book_new("ETH-USD");
}

pub fn fintech_defi_binomial_params_default() -> BinomialOptionParams {
    return binomial_params_new(100.0, 100.0, 1.0, 0.05, 0.20, 100, true, false);
}

pub fn fintech_defi_ns_params_default() -> NelsonSiegelParams {
    return ns_params_new(0.05, -0.02, 0.01, 1.5);
}

pub fn fintech_defi_irs_contract_default() -> VanillaIrsContract {
    return irs_contract_new(10000000.0, 0.045, 5.0, 2, true);
}

pub fn fintech_defi_cds_contract_default() -> CdsContract {
    return cds_contract_new(10000000.0, 100.0, 5.0, 4, 0.40, true);
}

pub fn fintech_defi_flash_pool_default() -> FlashLoanPool {
    return flash_pool_new("0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48", 100000000, 9);
}

pub fn fintech_defi_test_fixture() -> MockYieldCurveFixture {
    return mock_yield_curve_fixture_usd();
}
