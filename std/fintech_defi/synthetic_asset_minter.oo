// # Synthetic Asset Minter and Debt Pool Engine
//
// Logline: Manages over-collateralized synthetic asset (Synths) issuance, pooled debt percentage tracking, and dynamic collateral redemption.
//
// Setup: Pure DeFi protocol module for synthetic derivatives and debt pool accounting.
//
// Beats:
//   1. Define SynthAsset, UserDebtRecord, and GlobalDebtPool structures.
//   2. Track fluctuating global debt pool value across multi-currency synths (e.g. sUSD, sETH, sBTC).
//   3. Compute individual user debt balance = (User_Debt_Shares / Total_Debt_Shares) * Global_Debt_USD.

pub type SynthAsset = struct {
    symbol: String,
    total_supply: Int,
    oracle_price_usd: Int,
    is_active: Bool
};

pub type GlobalDebtPool = struct {
    total_debt_shares: Int,
    total_debt_usd: Int,
    target_c_ratio_bps: Int, // e.g. 40000 for 400%
    staked_collateral_usd: Int
};

pub type UserDebtRecord = struct {
    user: String,
    staked_collateral: Int,
    debt_shares: Int
};

pub type SynthMintQuote = struct {
    can_mint: Bool,
    user_debt_usd: Int,
    user_c_ratio_bps: Int,
    max_mintable_usd: Int
};

pub fn global_debt_pool_new(target_c_ratio: Int) -> GlobalDebtPool {
    return GlobalDebtPool {
        total_debt_shares: 0,
        total_debt_usd: 0,
        target_c_ratio_bps: target_c_ratio,
        staked_collateral_usd: 0
    };
}

pub fn user_debt_record_new(user: String) -> UserDebtRecord {
    return UserDebtRecord {
        user: user,
        staked_collateral: 0,
        debt_shares: 0
    };
}

pub fn synth_compute_user_debt(
    user_rec: &UserDebtRecord,
    pool: &GlobalDebtPool
) -> Int {
    if (pool).total_debt_shares <= 0 || (user_rec).debt_shares <= 0 {
        return 0;
    }
    return ((user_rec).debt_shares * (pool).total_debt_usd) / (pool).total_debt_shares;
}

pub fn synth_mint_synths(
    pool: &mut GlobalDebtPool,
    user_rec: &mut UserDebtRecord,
    collateral_price_usd: Int,
    mint_amount_usd: Int
) -> SynthMintQuote {
    let user_collat_usd: Int = ((user_rec).staked_collateral * collateral_price_usd) / 1000000;
    let curr_debt: Int = synth_compute_user_debt(user_rec, pool);
    let new_debt: Int = curr_debt + mint_amount_usd;

    let mut can_mint_flag: Bool = false;
    let mut new_ratio: Int = 999999;
    let max_debt: Int = (user_collat_usd * 10000) / (pool).target_c_ratio_bps;

    if new_debt > 0 {
        new_ratio = (user_collat_usd * 10000) / new_debt;
    }

    if new_debt <= max_debt {
        can_mint_flag = true;
        let mut new_shares: Int = mint_amount_usd;
        if (pool).total_debt_usd > 0 && (pool).total_debt_shares > 0 {
            new_shares = (mint_amount_usd * (pool).total_debt_shares) / (pool).total_debt_usd;
        }

        (user_rec).debt_shares = (user_rec).debt_shares + new_shares;
        (pool).total_debt_shares = (pool).total_debt_shares + new_shares;
        (pool).total_debt_usd = (pool).total_debt_usd + mint_amount_usd;
    }

    let mut remaining_mintable: Int = 0;
    if max_debt > new_debt {
        remaining_mintable = max_debt - new_debt;
    }

    return SynthMintQuote {
        can_mint: can_mint_flag,
        user_debt_usd: synth_compute_user_debt(user_rec, pool),
        user_c_ratio_bps: new_ratio,
        max_mintable_usd: remaining_mintable
    };
}
