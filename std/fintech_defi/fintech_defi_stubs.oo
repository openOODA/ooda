// # FinTech & DeFi Testing Stubs and Mock Fixtures
//
// Logline: Provides mock market data feeds, synthetic option surfaces, test accounts, and deterministic fixture generators for testing.
//
// Setup: Standalone test fixture module for FinTech, Quantitative Finance and DeFi suites.
//
// Beats:
//   1. Define MockOrderFeed, MockYieldCurveFixture, and MockDeFiState structures.
//   2. Generate synthetic Brownian motion price ticks and order book depth ladders.
//   3. Provide deterministic mock vaults, pools, and swap quotes for integration tests.

pub type MockOrderFeed = struct {
    symbol: String,
    base_price: Int,
    tick_count: Int,
};

pub type MockYieldCurveFixture = struct {
    curve_name: String,
    tenors: List[Float],
    rates: List[Float],
};

pub type MockDeFiState = struct {
    eth_price_usd: Int,
    btc_price_usd: Int,
    gas_price_gwei: Int,
    pool_liquidity_usd: Int,
};

pub fn mock_order_feed_new(symbol: String, base_px: Int) -> MockOrderFeed {
    return MockOrderFeed {
        symbol: symbol,
        base_price: base_px,
        tick_count: 0,
    };
}

pub fn mock_yield_curve_fixture_usd() -> MockYieldCurveFixture {
    let mut t_list: List[Float] = list_new();
    t_list = list_push(t_list, 0.25);
    t_list = list_push(t_list, 0.5);
    t_list = list_push(t_list, 1.0);
    t_list = list_push(t_list, 2.0);
    t_list = list_push(t_list, 5.0);
    t_list = list_push(t_list, 10.0);

    let mut r_list: List[Float] = list_new();
    r_list = list_push(r_list, 0.045);
    r_list = list_push(r_list, 0.046);
    r_list = list_push(r_list, 0.048);
    r_list = list_push(r_list, 0.050);
    r_list = list_push(r_list, 0.052);
    r_list = list_push(r_list, 0.055);

    return MockYieldCurveFixture {
        curve_name: "USD_SOFR_BENCHMARK",
        tenors: t_list,
        rates: r_list,
    };
}

pub fn mock_defi_state_default() -> MockDeFiState {
    return MockDeFiState {
        eth_price_usd: 3000000000,  // $3000.00 (6 decimals)
        btc_price_usd: 65000000000, // $65000.00 (6 decimals)
        gas_price_gwei: 25,
        pool_liquidity_usd: 50000000,
    };
}

pub fn mock_generate_tick_price(feed: &mut MockOrderFeed, seed: Int) -> Int {
    (feed).tick_count = (feed).tick_count + 1;
    let delta: Int = ((seed * 17 + (feed).tick_count) % 21) - 10;
    return (feed).base_price + delta;
}

pub fn mock_is_test_environment() -> Bool {
    return true;
}
