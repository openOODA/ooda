// # Cross-Venue Latency Arbitrage Engine
//
// Logline: Detects low-latency crossing arbitrage opportunities across fragmented trading venues accounting for taker fees and network latencies.
//
// Setup: Pure algorithmic arbitrage detection module for multi-venue liquidity.
//
// Beats:
//   1. Define VenueQuote, ArbitrageOpportunity, and CrossVenueRouter structures.
//   2. Identify crossed market conditions (Venue A Ask < Venue B Bid) across N exchanges.
//   3. Compute executable size, net profit after exchange taker fees, and round-trip execution feasibility.

pub type VenueQuote = struct {
    venue_id: String,
    bid_price: Int,
    bid_qty: Int,
    ask_price: Int,
    ask_qty: Int,
    taker_fee_bps: Int,
    latency_ms: Int
};

pub type ArbitrageOpportunity = struct {
    buy_venue_id: String,
    sell_venue_id: String,
    buy_price: Int,
    sell_price: Int,
    executable_qty: Int,
    gross_profit: Int,
    total_fees: Int,
    net_profit: Int,
    net_return_bps: Int
};

pub fn venue_quote_new(
    venue: String,
    bp: Int,
    bq: Int,
    ap: Int,
    aq: Int,
    fee_bps: Int,
    lat_ms: Int
) -> VenueQuote {
    return VenueQuote {
        venue_id: venue,
        bid_price: bp,
        bid_qty: bq,
        ask_price: ap,
        ask_qty: aq,
        taker_fee_bps: fee_bps,
        latency_ms: lat_ms
    };
}

pub fn scan_cross_venue_arbitrage(
    venue_a: &VenueQuote,
    venue_b: &VenueQuote
) -> ArbitrageOpportunity {
    let mut buy_venue: String = (venue_a).venue_id;
    let mut sell_venue: String = (venue_b).venue_id;
    let mut p_buy: Int = (venue_a).ask_price;
    let mut p_sell: Int = (venue_b).bid_price;
    let mut q_buy: Int = (venue_a).ask_qty;
    let mut q_sell: Int = (venue_b).bid_qty;
    let mut fee_buy_bps: Int = (venue_a).taker_fee_bps;
    let mut fee_sell_bps: Int = (venue_b).taker_fee_bps;

    if (venue_b).ask_price < (venue_a).bid_price {
        buy_venue = (venue_b).venue_id;
        sell_venue = (venue_a).venue_id;
        p_buy = (venue_b).ask_price;
        p_sell = (venue_a).bid_price;
        q_buy = (venue_b).ask_qty;
        q_sell = (venue_a).bid_qty;
        fee_buy_bps = (venue_b).taker_fee_bps;
        fee_sell_bps = (venue_a).taker_fee_bps;
    }

    if p_sell <= p_buy || p_buy <= 0 {
        return ArbitrageOpportunity {
            buy_venue_id: buy_venue,
            sell_venue_id: sell_venue,
            buy_price: p_buy,
            sell_price: p_sell,
            executable_qty: 0,
            gross_profit: 0,
            total_fees: 0,
            net_profit: 0,
            net_return_bps: 0
        };
    }

    let mut exec_qty: Int = q_buy;
    if q_sell < exec_qty {
        exec_qty = q_sell;
    }

    let gross: Int = (p_sell - p_buy) * exec_qty;
    let notional_buy: Int = p_buy * exec_qty;
    let notional_sell: Int = p_sell * exec_qty;

    let fee_buy: Int = (notional_buy * fee_buy_bps) / 10000;
    let fee_sell: Int = (notional_sell * fee_sell_bps) / 10000;
    let total_fee: Int = fee_buy + fee_sell;
    let net: Int = gross - total_fee;

    let mut return_bps: Int = 0;
    if notional_buy > 0 {
        return_bps = (net * 10000) / notional_buy;
    }

    return ArbitrageOpportunity {
        buy_venue_id: buy_venue,
        sell_venue_id: sell_venue,
        buy_price: p_buy,
        sell_price: p_sell,
        executable_qty: exec_qty,
        gross_profit: gross,
        total_fees: total_fee,
        net_profit: net,
        net_return_bps: return_bps
    };
}
