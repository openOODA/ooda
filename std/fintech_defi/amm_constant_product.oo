// # Constant Product Automated Market Maker
//
// Logline: Implements Uniswap v2 style x*y=k invariant pool mechanics, liquidity mint/burn, and fee-adjusted swaps.
//
// Setup: Pure quantitative module with integer/fixed-point reserve balance arithmetic.
//
// Beats:
//   1. Define ConstantProductPool, SwapQuote, and LiquidityResult structures.
//   2. Implement invariant checks, exact-input and exact-output swap pricing with bps fee.
//   3. Provide liquidity minting, burning, and price impact calculation.

type ConstantProductPool = struct {
    token_a: String,
    token_b: String,
    reserve_a: Int,
    reserve_b: Int,
    total_lp_supply: Int,
    fee_bps: Int,
    is_locked: Bool
};

type SwapQuote = struct {
    amount_in: Int,
    amount_out: Int,
    fee_amount: Int,
    price_impact_bps: Int,
    new_reserve_in: Int,
    new_reserve_out: Int
};

type LiquidityResult = struct {
    amount_a: Int,
    amount_b: Int,
    lp_tokens: Int,
    new_lp_supply: Int
};

pub fn amm_pool_new(
    token_a: String,
    token_b: String,
    reserve_a: Int,
    reserve_b: Int,
    initial_lp: Int,
    fee_bps: Int
) -> ConstantProductPool {
    return ConstantProductPool {
        token_a: token_a,
        token_b: token_b,
        reserve_a: reserve_a,
        reserve_b: reserve_b,
        total_lp_supply: initial_lp,
        fee_bps: fee_bps,
        is_locked: false
    };
}

pub fn amm_get_amount_out(
    amount_in: Int,
    reserve_in: Int,
    reserve_out: Int,
    fee_bps: Int
) -> SwapQuote {
    if amount_in <= 0 || reserve_in <= 0 || reserve_out <= 0 {
        return SwapQuote {
            amount_in: 0,
            amount_out: 0,
            fee_amount: 0,
            price_impact_bps: 0,
            new_reserve_in: reserve_in,
            new_reserve_out: reserve_out
        };
    }
    let fee_multiplier: Int = 10000 - fee_bps;
    let amount_in_with_fee: Int = amount_in * fee_multiplier;
    let numerator: Int = amount_in_with_fee * reserve_out;
    let denominator: Int = (reserve_in * 10000) + amount_in_with_fee;
    let amount_out: Int = numerator / denominator;
    let fee_amount: Int = (amount_in * fee_bps) / 10000;

    let impact_num: Int = amount_in * 10000;
    let impact_den: Int = reserve_in + amount_in;
    let impact_bps: Int = impact_num / impact_den;

    return SwapQuote {
        amount_in: amount_in,
        amount_out: amount_out,
        fee_amount: fee_amount,
        price_impact_bps: impact_bps,
        new_reserve_in: reserve_in + amount_in,
        new_reserve_out: reserve_out - amount_out
    };
}

pub fn amm_get_amount_in(
    amount_out: Int,
    reserve_in: Int,
    reserve_out: Int,
    fee_bps: Int
) -> Int {
    if amount_out <= 0 || reserve_in <= 0 || reserve_out <= amount_out {
        return 0;
    }
    let fee_multiplier: Int = 10000 - fee_bps;
    let numerator: Int = reserve_in * amount_out * 10000;
    let denominator: Int = (reserve_out - amount_out) * fee_multiplier;
    return (numerator / denominator) + 1;
}

pub fn amm_mint_liquidity(
    pool: &mut ConstantProductPool,
    amount_a: Int,
    amount_b: Int
) -> LiquidityResult {
    let mut minted_lp: Int = 0;
    if (pool).total_lp_supply == 0 {
        minted_lp = amount_a * amount_b;
    } else {
        let lp_from_a: Int = (amount_a * (pool).total_lp_supply) / (pool).reserve_a;
        let lp_from_b: Int = (amount_b * (pool).total_lp_supply) / (pool).reserve_b;
        if lp_from_a < lp_from_b {
            minted_lp = lp_from_a;
        } else {
            minted_lp = lp_from_b;
        }
    }
    (pool).reserve_a = (pool).reserve_a + amount_a;
    (pool).reserve_b = (pool).reserve_b + amount_b;
    (pool).total_lp_supply = (pool).total_lp_supply + minted_lp;

    return LiquidityResult {
        amount_a: amount_a,
        amount_b: amount_b,
        lp_tokens: minted_lp,
        new_lp_supply: (pool).total_lp_supply
    };
}

pub fn amm_burn_liquidity(
    pool: &mut ConstantProductPool,
    lp_amount: Int
) -> LiquidityResult {
    if (pool).total_lp_supply <= 0 || lp_amount <= 0 {
        return LiquidityResult {
            amount_a: 0,
            amount_b: 0,
            lp_tokens: 0,
            new_lp_supply: (pool).total_lp_supply
        };
    }
    let amount_a: Int = (lp_amount * (pool).reserve_a) / (pool).total_lp_supply;
    let amount_b: Int = (lp_amount * (pool).reserve_b) / (pool).total_lp_supply;

    (pool).reserve_a = (pool).reserve_a - amount_a;
    (pool).reserve_b = (pool).reserve_b - amount_b;
    (pool).total_lp_supply = (pool).total_lp_supply - lp_amount;

    return LiquidityResult {
        amount_a: amount_a,
        amount_b: amount_b,
        lp_tokens: lp_amount,
        new_lp_supply: (pool).total_lp_supply
    };
}

pub fn amm_spot_price_q64(pool: &ConstantProductPool) -> Int {
    if (pool).reserve_a <= 0 {
        return 0;
    }
    let q64_scale: Int = 1844674407370955161; // 2^64 / 10
    return ((pool).reserve_b * q64_scale) / (pool).reserve_a;
}
