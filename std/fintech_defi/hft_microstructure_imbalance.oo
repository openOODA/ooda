// # Market Microstructure Order Flow Imbalance (OFI)
//
// Logline: Computes multi-level Order Flow Imbalance (OFI) and Volume Order Imbalance (VOI) signals for short-term price jump prediction.
//
// Setup: Pure quantitative microstructure analysis module for high-frequency signal generation.
//
// Beats:
//   1. Define MicrostructureLevel, OfiObservation, and MicrostructureSignal structures.
//   2. Compute Cont-Kukanov-Stoikov Level 1 Order Flow Imbalance from consecutive BBO states.
//   3. Aggregate multi-level book volume imbalances into weighted micro-price signals.

pub type MicrostructureLevel = struct {
    bid_px: Int,
    bid_sz: Int,
    ask_px: Int,
    ask_sz: Int
};

pub type OfiObservation = struct {
    timestamp_ns: Int,
    ofi_value: Int,
    voi_value: Int,
    delta_mid_price: Int
};

pub type MicrostructureSignal = struct {
    instantaneous_ofi: Int,
    smoothed_ofi: Int,
    micro_price: Float,
    predicted_direction: Int // +1 up, -1 down, 0 neutral
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn compute_level1_ofi(
    prev: &MicrostructureLevel,
    curr: &MicrostructureLevel
) -> Int {
    let mut delta_bid: Int = 0;
    if (curr).bid_px > (prev).bid_px {
        delta_bid = (curr).bid_sz;
    } else {
        if (curr).bid_px == (prev).bid_px {
            delta_bid = (curr).bid_sz - (prev).bid_sz;
        } else {
            delta_bid = 0 - (prev).bid_sz;
        }
    }

    let mut delta_ask: Int = 0;
    if (curr).ask_px < (prev).ask_px {
        delta_ask = (curr).ask_sz;
    } else {
        if (curr).ask_px == (prev).ask_px {
            delta_ask = (curr).ask_sz - (prev).ask_sz;
        } else {
            delta_ask = 0 - (prev).ask_sz;
        }
    }

    return delta_bid - delta_ask;
}

pub fn compute_micro_price(level: &MicrostructureLevel) -> Float {
    let bp: Float = int_to_float((level).bid_px);
    let bq: Float = int_to_float((level).bid_sz);
    let ap: Float = int_to_float((level).ask_px);
    let aq: Float = int_to_float((level).ask_sz);

    let total_q: Float = bq + aq;
    if total_q <= 0.0 {
        return (bp + ap) / 2.0;
    }
    return ((bp * aq) + (ap * bq)) / total_q;
}

pub fn generate_microstructure_signal(
    prev: &MicrostructureLevel,
    curr: &MicrostructureLevel,
    prior_smoothed_ofi: Int
) -> MicrostructureSignal {
    let ofi: Int = compute_level1_ofi(prev, curr);
    let micro_px: Float = compute_micro_price(curr);

    let smooth: Int = ((prior_smoothed_ofi * 7) + (ofi * 3)) / 10;
    let mut dir: Int = 0;
    if smooth > 100 {
        dir = 1;
    } else {
        if smooth < -100 {
            dir = -1;
        }
    }

    return MicrostructureSignal {
        instantaneous_ofi: ofi,
        smoothed_ofi: smooth,
        micro_price: micro_px,
        predicted_direction: dir
    };
}
