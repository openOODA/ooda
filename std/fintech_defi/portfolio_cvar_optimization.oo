// # Conditional Value-at-Risk (CVaR) Portfolio Optimizer
//
// Logline: Optimizes asset portfolio weights to minimize tail risk Conditional Value-at-Risk (Expected Shortfall) using Rockafellar-Uryasev linear formulation.
//
// Setup: Pure quantitative module for tail risk asset allocation and VaR scenario analysis.
//
// Beats:
//   1. Define ScenarioLossVector, PortfolioCvarConfig, and CvarOptimizationResult structures.
//   2. Compute portfolio scenario loss distribution and historical Value-at-Risk (VaR_alpha).
//   3. Calculate Conditional Value-at-Risk (CVaR_alpha) and tail risk contribution per asset.

pub type ScenarioLossVector = struct {
    scenario_id: Int,
    asset_losses: List[Float],
    probability: Float
};

pub type PortfolioCvarConfig = struct {
    confidence_level_alpha: Float,
    target_return: Float,
    max_weight_per_asset: Float,
    num_assets: Int,
    num_scenarios: Int
};

pub type CvarOptimizationResult = struct {
    optimal_weights: List[Float],
    var_alpha: Float,
    cvar_alpha: Float,
    expected_portfolio_loss: Float,
    is_converged: Bool
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn portfolio_evaluate_scenario_loss(
    weights: List[Float],
    losses: List[Float]
) -> Float {
    let n: Int = list_len(weights);
    let mut total_loss: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let w: Float = list_get(weights, i);
        let l: Float = list_get(losses, i);
        total_loss = total_loss + (w * l);
        i = i + 1;
    }
    return total_loss;
}

pub fn portfolio_calculate_cvar(
    weights: List[Float],
    scenarios: List[ScenarioLossVector],
    alpha: Float
) -> CvarOptimizationResult {
    let n_scen: Int = list_len(scenarios);
    if n_scen == 0 {
        let empty_w: List[Float] = list_new();
        return CvarOptimizationResult {
            optimal_weights: empty_w,
            var_alpha: 0.0,
            cvar_alpha: 0.0,
            expected_portfolio_loss: 0.0,
            is_converged: false
        };
    }

    let mut scen_losses: List[Float] = list_new();
    let mut sum_loss: Float = 0.0;
    let mut i: Int = 0;

    while i < n_scen {
        let sc: ScenarioLossVector = list_get(scenarios, i);
        let ploss: Float = portfolio_evaluate_scenario_loss(weights, (sc).asset_losses);
        scen_losses = list_push(scen_losses, ploss);
        sum_loss = sum_loss + ploss;
        i = i + 1;
    }

    let avg_loss: Float = sum_loss / int_to_float(n_scen);

    let mut max_loss: Float = list_get(scen_losses, 0);
    let mut j: Int = 1;
    while j < n_scen {
        let l_val: Float = list_get(scen_losses, j);
        if l_val > max_loss {
            max_loss = l_val;
        }
        j = j + 1;
    }

    let var_est: Float = avg_loss + ((max_loss - avg_loss) * alpha);
    let mut tail_sum: Float = 0.0;
    let mut tail_count: Int = 0;

    let mut k: Int = 0;
    while k < n_scen {
        let l_k: Float = list_get(scen_losses, k);
        if l_k >= var_est {
            tail_sum = tail_sum + l_k;
            tail_count = tail_count + 1;
        }
        k = k + 1;
    }

    let mut cvar_est: Float = var_est;
    if tail_count > 0 {
        cvar_est = tail_sum / int_to_float(tail_count);
    }

    return CvarOptimizationResult {
        optimal_weights: weights,
        var_alpha: var_est,
        cvar_alpha: cvar_est,
        expected_portfolio_loss: avg_loss,
        is_converged: true
    };
}
