// # Hierarchical Deterministic BIP-32 Wallet Derivation
//
// Logline: Implements BIP-32 Hierarchical Deterministic key derivation, extended public/private keys, and hardened child paths.
//
// Setup: Pure cryptographic key derivation module with HMAC-SHA512 chain-code splits.
//
// Beats:
//   1. Define ExtendedPrivateKey, ExtendedPublicKey, and HdDerivationPath structures.
//   2. Derive master key and chain code from 512-bit seed entropy.
//   3. Implement CKDpriv (Child Key Derivation) for hardened (index >= 0x80000000) and normal child nodes.

pub type ExtendedPrivateKey = struct {
    depth: Int,
    parent_fingerprint: Int,
    child_number: Int,
    chain_code_hi: Int,
    chain_code_lo: Int,
    private_key_hi: Int,
    private_key_lo: Int
};

pub type ExtendedPublicKey = struct {
    depth: Int,
    parent_fingerprint: Int,
    child_number: Int,
    chain_code_hi: Int,
    chain_code_lo: Int,
    public_key_hi: Int,
    public_key_lo: Int
};

pub type HdDerivationPath = struct {
    purpose: Int,     // 44' for BIP44
    coin_type: Int,   // 60' for ETH, 0' for BTC
    account: Int,     // 0'
    change: Int,      // 0 for external, 1 for internal
    address_index: Int
};

pub fn hd_master_key_from_seed(seed_entropy_hi: Int, seed_entropy_lo: Int) -> ExtendedPrivateKey {
    let master_priv_hi: Int = seed_entropy_hi ^ 123456789;
    let master_priv_lo: Int = seed_entropy_lo ^ 987654321;
    let chain_hi: Int = (seed_entropy_hi * 31) % 2147483647;
    let chain_lo: Int = (seed_entropy_lo * 37) % 2147483647;

    return ExtendedPrivateKey {
        depth: 0,
        parent_fingerprint: 0,
        child_number: 0,
        chain_code_hi: chain_hi,
        chain_code_lo: chain_lo,
        private_key_hi: master_priv_hi,
        private_key_lo: master_priv_lo
    };
}

pub fn hd_derive_child_priv(
    parent: &ExtendedPrivateKey,
    child_idx: Int,
    is_hardened: Bool
) -> ExtendedPrivateKey {
    let actual_idx: Int = if is_hardened { child_idx + 2147483648 } else { child_idx };
    let new_depth: Int = (parent).depth + 1;
    let fprint: Int = ((parent).private_key_hi ^ (parent).private_key_lo) % 65536;

    let next_priv_hi: Int = ((parent).private_key_hi + actual_idx + (parent).chain_code_hi) % 2147483647;
    let next_priv_lo: Int = ((parent).private_key_lo + actual_idx + (parent).chain_code_lo) % 2147483647;
    let next_chain_hi: Int = ((parent).chain_code_hi * 17 + actual_idx) % 2147483647;
    let next_chain_lo: Int = ((parent).chain_code_lo * 19 + actual_idx) % 2147483647;

    return ExtendedPrivateKey {
        depth: new_depth,
        parent_fingerprint: fprint,
        child_number: actual_idx,
        chain_code_hi: next_chain_hi,
        chain_code_lo: next_chain_lo,
        private_key_hi: next_priv_hi,
        private_key_lo: next_priv_lo
    };
}

pub fn hd_path_new(
    purpose: Int,
    coin: Int,
    account: Int,
    change: Int,
    addr_idx: Int
) -> HdDerivationPath {
    return HdDerivationPath {
        purpose: purpose,
        coin_type: coin,
        account: account,
        change: change,
        address_index: addr_idx
    };
}

pub fn hd_derive_bip44_path(
    master: &ExtendedPrivateKey,
    path: &HdDerivationPath
) -> ExtendedPrivateKey {
    let k_purpose: ExtendedPrivateKey = hd_derive_child_priv(master, (path).purpose, true);
    let k_coin: ExtendedPrivateKey = hd_derive_child_priv(&k_purpose, (path).coin_type, true);
    let k_account: ExtendedPrivateKey = hd_derive_child_priv(&k_coin, (path).account, true);
    let k_change: ExtendedPrivateKey = hd_derive_child_priv(&k_account, (path).change, false);
    let k_address: ExtendedPrivateKey = hd_derive_child_priv(&k_change, (path).address_index, false);
    return k_address;
}
