// # Credit Default Swap (CDS) Pricer
//
// Logline: Prices Credit Default Swaps using constant hazard rate intensity models, computing premium/protection legs and par CDS spreads.
//
// Setup: Pure quantitative finance module with piecewise constant survival probabilities.
//
// Beats:
//   1. Define CdsContract, HazardRateCurve, and CdsPriceResult structures.
//   2. Calculate survival probability Q(t) = exp(-lambda * t) and default probability density.
//   3. Compute Premium Leg, Protection Leg, Mark-to-Market NPV, and Break-even Par Spread.

pub type CdsContract = struct {
    notional: Float,
    running_spread_bps: Float,
    tenor_years: Float,
    payment_frequency: Int,
    recovery_rate: Float,
    is_buyer: Bool,
};

pub type HazardRateCurve = struct {
    constant_hazard_rate: Float,
    risk_free_rate: Float,
};

pub type CdsPriceResult = struct {
    npv: Float,
    premium_leg_pv: Float,
    protection_leg_pv: Float,
    par_spread_bps: Float,
    risky_annuity: Float,
    credit_dv01: Float,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 100 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn cds_contract_new(
    notional: Float,
    spread_bps: Float,
    tenor: Float,
    freq: Int,
    rec_rate: Float,
    buyer: Bool
) -> CdsContract {
    return CdsContract {
        notional: notional,
        running_spread_bps: spread_bps,
        tenor_years: tenor,
        payment_frequency: freq,
        recovery_rate: rec_rate,
        is_buyer: buyer,
    };
}

pub fn cds_survival_prob(curve: &HazardRateCurve, t: Float) -> Float {
    return exp((0.0 - (curve).constant_hazard_rate) * t);
}

pub fn cds_price(
    contract: &CdsContract,
    curve: &HazardRateCurve
) -> CdsPriceResult {
    let n: Float = (contract).notional;
    let s_bps: Float = (contract).running_spread_bps;
    let spread: Float = s_bps / 10000.0;
    let t: Float = (contract).tenor_years;
    let freq: Int = (contract).payment_frequency;
    let rec: Float = (contract).recovery_rate;
    let lgd: Float = 1.0 - rec;

    let lambda_val: Float = (curve).constant_hazard_rate;
    let r: Float = (curve).risk_free_rate;

    let dt: Float = 1.0 / int_to_float(freq);
    let total_periods: Int = (t * int_to_float(freq)) + 0;

    let mut risky_ann: Float = 0.0;
    let mut i: Int = 1;

    while i <= total_periods {
        let ti: Float = int_to_float(i) * dt;
        let df_i: Float = exp((0.0 - r) * ti);
        let surv_i: Float = exp((0.0 - lambda_val) * ti);
        risky_ann = risky_ann + (dt * df_i * surv_i);
        i = i + 1;
    }

    let r_plus_lambda: Float = r + lambda_val;
    let mut prot_leg: Float = 0.0;
    if r_plus_lambda > 0.0 {
        let factor: Float = (lambda_val / r_plus_lambda) * (1.0 - exp((0.0 - r_plus_lambda) * t));
        prot_leg = n * lgd * factor;
    }

    let prem_leg: Float = n * spread * risky_ann;

    let mut par_spread: Float = 0.0;
    if risky_ann > 0.0 && n > 0.0 {
        par_spread = (prot_leg / (n * risky_ann)) * 10000.0;
    }

    let mut npv_val: Float = 0.0;
    if (contract).is_buyer {
        npv_val = prot_leg - prem_leg;
    } else {
        npv_val = prem_leg - prot_leg;
    }

    let cr_dv01: Float = n * risky_ann * 0.0001;

    return CdsPriceResult {
        npv: npv_val,
        premium_leg_pv: prem_leg,
        protection_leg_pv: prot_leg,
        par_spread_bps: par_spread,
        risky_annuity: risky_ann,
        credit_dv01: cr_dv01,
    };
}
