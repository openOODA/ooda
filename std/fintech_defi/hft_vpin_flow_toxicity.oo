// # Volume-Synchronized Probability of Toxicity (VPIN)
//
// Logline: Calculates Volume-Synchronized Probability of Toxicity (VPIN) to detect toxic informed order flow and adverse selection risk in real time.
//
// Setup: Pure quantitative microstructure module with equal-volume time-sliced bucketing.
//
// Beats:
//   1. Define VolumeBucket, VpinConfig, and VpinResult structures.
//   2. Fill equal-volume buckets using BVC (Bulk Volume Classification) sign heuristics.
//   3. Compute rolling trade imbalance and VPIN metric across N synchronized volume buckets.

pub type VolumeBucket = struct {
    bucket_index: Int,
    buy_volume: Int,
    sell_volume: Int,
    absolute_imbalance: Int,
    is_completed: Bool,
};

pub type VpinConfig = struct {
    bucket_volume_size: Int,
    rolling_window_buckets: Int,
    toxicity_threshold_bps: Int,
};

pub type VpinResult = struct {
    vpin_bps: Int,
    is_toxic: Bool,
    current_bucket_idx: Int,
    total_buckets_processed: Int,
};

pub fn vpin_config_new(bucket_size: Int, window_size: Int, thresh_bps: Int) -> VpinConfig {
    return VpinConfig {
        bucket_volume_size: bucket_size,
        rolling_window_buckets: window_size,
        toxicity_threshold_bps: thresh_bps,
    };
}

pub fn vpin_bucket_new(idx: Int) -> VolumeBucket {
    return VolumeBucket {
        bucket_index: idx,
        buy_volume: 0,
        sell_volume: 0,
        absolute_imbalance: 0,
        is_completed: false,
    };
}

pub fn vpin_compute_rolling(
    buckets: List[VolumeBucket],
    window_n: Int,
    bucket_size: Int,
    thresh_bps: Int
) -> VpinResult {
    let num_b: Int = list_len(buckets);
    if num_b == 0 || window_n <= 0 || bucket_size <= 0 {
        return VpinResult {
            vpin_bps: 0,
            is_toxic: false,
            current_bucket_idx: 0,
            total_buckets_processed: 0,
        };
    }

    let mut start_idx: Int = num_b - window_n;
    if start_idx < 0 {
        start_idx = 0;
    }

    let mut sum_imbalance: Int = 0;
    let mut count_used: Int = 0;
    let mut i: Int = start_idx;

    while i < num_b {
        let b: VolumeBucket = list_get(buckets, i);
        if (b).is_completed {
            sum_imbalance = sum_imbalance + (b).absolute_imbalance;
            count_used = count_used + 1;
        }
        i = i + 1;
    }

    if count_used == 0 {
        return VpinResult {
            vpin_bps: 0,
            is_toxic: false,
            current_bucket_idx: num_b,
            total_buckets_processed: num_b,
        };
    }

    let total_v: Int = count_used * bucket_size;
    let vpin_bps_val: Int = (sum_imbalance * 10000) / total_v;
    let toxic_flag: Bool = vpin_bps_val >= thresh_bps;

    return VpinResult {
        vpin_bps: vpin_bps_val,
        is_toxic: toxic_flag,
        current_bucket_idx: num_b,
        total_buckets_processed: num_b,
    };
}
