// # Nelson-Siegel Yield Curve Model
//
// Logline: Implements Nelson-Siegel 4-parameter and Svensson 6-parameter term structure models for zero-coupon yield curve fitting.
//
// Setup: Pure quantitative finance module with exponential decay basis functions.
//
// Beats:
//   1. Define NelsonSiegelParams, SvenssonParams, and YieldPoint structures.
//   2. Compute level (beta0), slope (beta1), curvature (beta2/beta3) decay loadings at arbitrary maturities.
//   3. Extract continuous zero rates, discount factors, and instantaneous forward rate curves.

pub type NelsonSiegelParams = struct {
    beta0: Float,
    beta1: Float,
    beta2: Float,
    lambda_val: Float
};

pub type SvenssonParams = struct {
    beta0: Float,
    beta1: Float,
    beta2: Float,
    beta3: Float,
    lambda1: Float,
    lambda2: Float
};

pub type YieldPoint = struct {
    maturity_years: Float,
    zero_rate: Float,
    discount_factor: Float,
    forward_rate: Float
};

pub fn ns_params_new(b0: Float, b1: Float, b2: Float, l: Float) -> NelsonSiegelParams {
    return NelsonSiegelParams {
        beta0: b0,
        beta1: b1,
        beta2: b2,
        lambda_val: l
    };
}

pub fn svensson_params_new(
    b0: Float,
    b1: Float,
    b2: Float,
    b3: Float,
    l1: Float,
    l2: Float
) -> SvenssonParams {
    return SvenssonParams {
        beta0: b0,
        beta1: b1,
        beta2: b2,
        beta3: b3,
        lambda1: l1,
        lambda2: l2
    };
}

pub fn ns_zero_rate(params: &NelsonSiegelParams, t: Float) -> Float {
    if t <= 0.0001 {
        return (params).beta0 + (params).beta1;
    }
    let b0: Float = (params).beta0;
    let b1: Float = (params).beta1;
    let b2: Float = (params).beta2;
    let l: Float = (params).lambda_val;

    let tau: Float = t / l;
    let exp_tau: Float = exp(0.0 - tau);
    let term1: Float = (1.0 - exp_tau) / tau;
    let term2: Float = term1 - exp_tau;

    return b0 + (b1 * term1) + (b2 * term2);
}

pub fn svensson_zero_rate(params: &SvenssonParams, t: Float) -> Float {
    if t <= 0.0001 {
        return (params).beta0 + (params).beta1;
    }
    let b0: Float = (params).beta0;
    let b1: Float = (params).beta1;
    let b2: Float = (params).beta2;
    let b3: Float = (params).beta3;
    let l1: Float = (params).lambda1;
    let l2: Float = (params).lambda2;

    let tau1: Float = t / l1;
    let exp1: Float = exp(0.0 - tau1);
    let term1: Float = (1.0 - exp1) / tau1;
    let term2: Float = term1 - exp1;

    let tau2: Float = t / l2;
    let exp2: Float = exp(0.0 - tau2);
    let term3: Float = ((1.0 - exp2) / tau2) - exp2;

    return b0 + (b1 * term1) + (b2 * term2) + (b3 * term3);
}

pub fn ns_discount_factor(params: &NelsonSiegelParams, t: Float) -> Float {
    let r: Float = ns_zero_rate(params, t);
    return exp((0.0 - r) * t);
}

pub fn ns_instantaneous_forward(params: &NelsonSiegelParams, t: Float) -> Float {
    let b0: Float = (params).beta0;
    let b1: Float = (params).beta1;
    let b2: Float = (params).beta2;
    let l: Float = (params).lambda_val;

    let tau: Float = t / l;
    let exp_tau: Float = exp(0.0 - tau);
    return b0 + (b1 * exp_tau) + (b2 * tau * exp_tau);
}
