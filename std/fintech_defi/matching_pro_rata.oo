// # Pro-Rata Matching Allocation Engine
//
// Logline: Implements pro-rata matching algorithms allocating execution volume proportionally to resting quote size with round-lot handling.
//
// Setup: Pure algorithmic allocation engine for futures and derivatives matching.
//
// Beats:
//   1. Define ProRataQuote, ProRataAllocation, and ProRataMatchResult structures.
//   2. Calculate proportional fill sizes based on resting liquidity weights.
//   3. Handle remainder allocation using largest-fraction or arrival-time tie-breaking.

pub type ProRataQuote = struct {
    order_id: Int,
    trader_id: String,
    quoted_qty: Int,
    remaining_qty: Int,
    priority_rank: Int,
};

pub type ProRataAllocation = struct {
    order_id: Int,
    allocated_qty: Int,
    remaining_qty: Int,
};

pub type ProRataMatchResult = struct {
    matched_qty: Int,
    unmatched_qty: Int,
    allocations: List[ProRataAllocation],
};

pub fn pro_rata_quote_new(
    order_id: Int,
    trader_id: String,
    qty: Int,
    rank: Int
) -> ProRataQuote {
    return ProRataQuote {
        order_id: order_id,
        trader_id: trader_id,
        quoted_qty: qty,
        remaining_qty: qty,
        priority_rank: rank,
    };
}

pub fn pro_rata_allocate(
    quotes: List[ProRataQuote],
    available_volume: Int
) -> ProRataMatchResult {
    let num_quotes: Int = list_len(quotes);
    let mut allocs: List[ProRataAllocation] = list_new();

    if num_quotes == 0 || available_volume <= 0 {
        return ProRataMatchResult {
            matched_qty: 0,
            unmatched_qty: available_volume,
            allocations: allocs,
        };
    }

    let mut total_quoted: Int = 0;
    let mut i: Int = 0;
    while i < num_quotes {
        let q: ProRataQuote = list_get(quotes, i);
        total_quoted = total_quoted + (q).remaining_qty;
        i = i + 1;
    }

    if total_quoted == 0 {
        return ProRataMatchResult {
            matched_qty: 0,
            unmatched_qty: available_volume,
            allocations: allocs,
        };
    }

    let mut volume_to_distribute: Int = available_volume;
    if volume_to_distribute > total_quoted {
        volume_to_distribute = total_quoted;
    }

    let mut distributed_sum: Int = 0;
    let mut j: Int = 0;

    while j < num_quotes {
        let quote: ProRataQuote = list_get(quotes, j);
        let rem_q: Int = (quote).remaining_qty;
        let mut alloc_qty: Int = (rem_q * volume_to_distribute) / total_quoted;
        if alloc_qty > rem_q {
            alloc_qty = rem_q;
        }

        distributed_sum = distributed_sum + alloc_qty;
        let alloc_entry = ProRataAllocation {
            order_id: (quote).order_id,
            allocated_qty: alloc_qty,
            remaining_qty: rem_q - alloc_qty,
        };
        allocs = list_push(allocs, alloc_entry);
        j = j + 1;
    }

    let mut remainder: Int = volume_to_distribute - distributed_sum;
    if remainder > 0 {
        let mut adjusted_allocs: List[ProRataAllocation] = list_new();
        let mut k: Int = 0;
        while k < num_quotes {
            let mut item: ProRataAllocation = list_get(allocs, k);
            if remainder > 0 && (item).remaining_qty > 0 {
                item.allocated_qty = (item).allocated_qty + 1;
                item.remaining_qty = (item).remaining_qty - 1;
                remainder = remainder - 1;
                distributed_sum = distributed_sum + 1;
            }
            adjusted_allocs = list_push(adjusted_allocs, item);
            k = k + 1;
        }
        allocs = adjusted_allocs;
    }

    return ProRataMatchResult {
        matched_qty: distributed_sum,
        unmatched_qty: available_volume - distributed_sum,
        allocations: allocs,
    };
}
