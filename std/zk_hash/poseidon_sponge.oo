// # Poseidon sponge over a prime field
//
// Logline: Mixes a width-3 state with x^5 S-boxes and a circulant MDS matrix.
//
// Setup: Pure. Field prime is 65537. Full rounds sandwich partial rounds. Empty input is Err.
//
// Beats:
//   1. Absorb bytes into the first state word.
//   2. Apply full S-box rounds, then partial rounds, then full rounds.
//   3. Mix with the MDS matrix 2,1,1 / 1,2,1 / 1,1,2.
//   4. Squeeze the first word.

pub type PosOut = struct {
    flag: Int,
    err: String,
    h: Int,
    s0: Int,
    s1: Int,
    s2: Int
};

fn ps_err(m: String) -> PosOut {
    return PosOut { flag: 0, err: "ERR\tposeidon: " + m, h: 0, s0: 0, s1: 0, s2: 0 };
}

fn ps_mod(a: Int) -> Int {
    let mut x: Int = a % 65537;
    if x < 0 {
        x = x + 65537;
    }
    return x;
}

fn ps_sbox(x: Int) -> Int {
    let a: Int = ps_mod(x);
    let a2: Int = ps_mod(a * a);
    return ps_mod(a2 * a2 * a);
}

fn ps_mds(a: Int, b: Int, c: Int) -> PosOut {
    let n0: Int = ps_mod(2 * a + b + c);
    let n1: Int = ps_mod(a + 2 * b + c);
    let n2: Int = ps_mod(a + b + 2 * c);
    return PosOut { flag: 1, err: "", h: n0, s0: n0, s1: n1, s2: n2 };
}

fn ps_full(s0: Int, s1: Int, s2: Int, rc: Int) -> PosOut {
    let a: Int = ps_sbox(ps_mod(s0 + rc));
    let b: Int = ps_sbox(ps_mod(s1 + rc + 1));
    let c: Int = ps_sbox(ps_mod(s2 + rc + 2));
    return ps_mds(a, b, c);
}

fn ps_part(s0: Int, s1: Int, s2: Int, rc: Int) -> PosOut {
    let a: Int = ps_sbox(ps_mod(s0 + rc));
    return ps_mds(a, ps_mod(s1 + rc), ps_mod(s2 + rc));
}

pub fn poseidon_sponge_hash(msg: List[Int]) -> PosOut {
    if list_len(msg) < 1 {
        return ps_err("empty");
    }
    let mut s0: Int = 0;
    let mut i: Int = 0;
    while i < list_len(msg) {
        s0 = ps_mod(s0 + (list_get(msg, i) & 255));
        i = i + 1;
    }
    let mut s1: Int = 1;
    let mut s2: Int = 2;
    let mut r: Int = 0;
    while r < 4 {
        let f: PosOut = ps_full(s0, s1, s2, r * 7);
        let f0: Int = f.s0;
        let f1: Int = f.s1;
        let f2: Int = f.s2;
        s0 = f0;
        s1 = f1;
        s2 = f2;
        r = r + 1;
    }
    r = 0;
    while r < 4 {
        let pr: PosOut = ps_part(s0, s1, s2, 40 + r);
        let p0: Int = pr.s0;
        let p1: Int = pr.s1;
        let p2: Int = pr.s2;
        s0 = p0;
        s1 = p1;
        s2 = p2;
        r = r + 1;
    }
    r = 0;
    while r < 4 {
        let g: PosOut = ps_full(s0, s1, s2, 80 + r * 7);
        let g0: Int = g.s0;
        let g1: Int = g.s1;
        let g2: Int = g.s2;
        s0 = g0;
        s1 = g1;
        s2 = g2;
        r = r + 1;
    }
    return PosOut { flag: 1, err: "", h: s0, s0: s0, s1: s1, s2: s2 };
}

pub fn poseidon_sponge_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}

pub fn poseidon_sponge_flag(o: PosOut) -> Int {
    return o.flag;
}
pub fn poseidon_sponge_err(o: PosOut) -> String {
    return o.err;
}
