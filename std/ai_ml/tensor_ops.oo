// # AI/ML Tensor Arithmetic & Matrix Operations
//
// Logline: Provides elementwise arithmetic, matrix multiplication, transposition, slicing, reduction, and broadcasting.
//
// Setup: Imports tensor_types.oo for tensor representation and shape constraints.
//
// Beats:
//   1. Implement elementwise tensor addition, subtraction, multiplication, and division.
//   2. Implement general matrix multiplication (GEMM) and transposition for 2D tensors.
//   3. Implement reductions (sum, mean, variance, max, min, L2 norm) and dot products.

import "./tensor_types.oo";

// -------------------------------------------------------------------
// 1D Tensor Arithmetic & Reductions
// -------------------------------------------------------------------

pub fn tensor_1d_add(a: Tensor1D, b: Tensor1D) -> Tensor1D {
    let n = (a).size;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < n { out = list_push(out, list_get((a).data, i) + list_get((b).data, i)); i = i + 1; }
    return Tensor1D { data: out, size: n };
}

pub fn tensor_1d_sub(a: Tensor1D, b: Tensor1D) -> Tensor1D {
    let n = (a).size;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < n { out = list_push(out, list_get((a).data, i) - list_get((b).data, i)); i = i + 1; }
    return Tensor1D { data: out, size: n };
}

pub fn tensor_1d_mul(a: Tensor1D, b: Tensor1D) -> Tensor1D {
    let n = (a).size;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < n { out = list_push(out, list_get((a).data, i) * list_get((b).data, i)); i = i + 1; }
    return Tensor1D { data: out, size: n };
}

pub fn tensor_1d_div(a: Tensor1D, b: Tensor1D) -> Tensor1D {
    let n = (a).size;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < n {
        let denom = list_get((b).data, i);
        let mut v = 0.0;
        if denom != 0.0 { v = list_get((a).data, i) / denom; }
        out = list_push(out, v);
        i = i + 1;
    }
    return Tensor1D { data: out, size: n };
}

pub fn tensor_1d_scale(a: Tensor1D, s: Float) -> Tensor1D {
    let n = (a).size;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < n {
        out = list_push(out, list_get((a).data, i) * s);
        i = i + 1;
    }
    return Tensor1D { data: out, size: n };
}

pub fn tensor_1d_dot(a: Tensor1D, b: Tensor1D) -> Float {
    let n = (a).size;
    let mut acc = 0.0;
    let mut i = 0;
    while i < n {
        acc = acc + (list_get((a).data, i) * list_get((b).data, i));
        i = i + 1;
    }
    return acc;
}

pub fn tensor_1d_sum(a: Tensor1D) -> Float {
    let n = (a).size;
    let mut acc = 0.0;
    let mut i = 0;
    while i < n {
        acc = acc + list_get((a).data, i);
        i = i + 1;
    }
    return acc;
}

pub fn tensor_1d_mean(a: Tensor1D) -> Float {
    let n = (a).size;
    if n == 0 { return 0.0; }
    return tensor_1d_sum(a) / int_to_float(n);
}

pub fn tensor_1d_variance(a: Tensor1D) -> Float {
    let n = (a).size;
    if n <= 1 { return 0.0; }
    let m = tensor_1d_mean(a);
    let mut acc = 0.0;
    let mut i = 0;
    while i < n {
        let diff = list_get((a).data, i) - m;
        acc = acc + (diff * diff);
        i = i + 1;
    }
    return acc / int_to_float(n);
}

pub fn tensor_1d_norm(a: Tensor1D) -> Float {
    let mut acc = 0.0;
    let n = (a).size;
    let mut i = 0;
    while i < n {
        let v = list_get((a).data, i);
        acc = acc + (v * v);
        i = i + 1;
    }
    return sqrt(acc);
}

pub fn tensor_1d_max(a: Tensor1D) -> Float {
    let n = (a).size;
    if n == 0 { return 0.0; }
    let mut max_v = list_get((a).data, 0);
    let mut i = 1;
    while i < n {
        let v = list_get((a).data, i);
        if v > max_v { max_v = v; }
        i = i + 1;
    }
    return max_v;
}

pub fn tensor_1d_min(a: Tensor1D) -> Float {
    let n = (a).size;
    if n == 0 { return 0.0; }
    let mut min_v = list_get((a).data, 0);
    let mut i = 1;
    while i < n {
        let v = list_get((a).data, i);
        if v < min_v { min_v = v; }
        i = i + 1;
    }
    return min_v;
}

pub fn tensor_2d_add(a: Tensor2D, b: Tensor2D) -> Tensor2D {
    let r = (a).rows;
    let c = (a).cols;
    let total = r * c;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < total {
        out = list_push(out, list_get((a).data, i) + list_get((b).data, i));
        i = i + 1;
    }
    return Tensor2D { data: out, rows: r, cols: c };
}

pub fn tensor_2d_sub(a: Tensor2D, b: Tensor2D) -> Tensor2D {
    let r = (a).rows;
    let c = (a).cols;
    let total = r * c;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < total {
        out = list_push(out, list_get((a).data, i) - list_get((b).data, i));
        i = i + 1;
    }
    return Tensor2D { data: out, rows: r, cols: c };
}

pub fn tensor_2d_scale(a: Tensor2D, s: Float) -> Tensor2D {
    let r = (a).rows;
    let c = (a).cols;
    let total = r * c;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < total {
        out = list_push(out, list_get((a).data, i) * s);
        i = i + 1;
    }
    return Tensor2D { data: out, rows: r, cols: c };
}

pub fn tensor_2d_transpose(a: Tensor2D) -> Tensor2D {
    let r = (a).rows;
    let c = (a).cols;
    let mut out: List[Float] = list_new();
    let mut j = 0;
    while j < c {
        let mut i = 0;
        while i < r {
            out = list_push(out, list_get((a).data, (i * c) + j));
            i = i + 1;
        }
        j = j + 1;
    }
    return Tensor2D { data: out, rows: c, cols: r };
}

pub fn tensor_2d_matmul(a: Tensor2D, b: Tensor2D) -> Tensor2D {
    let m = (a).rows;
    let k = (a).cols;
    let n = (b).cols;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < m {
        let mut j = 0;
        while j < n {
            let mut acc = 0.0;
            let mut p = 0;
            while p < k {
                acc = acc + (list_get((a).data, (i * k) + p) * list_get((b).data, (p * n) + j));
                p = p + 1;
            }
            out = list_push(out, acc);
            j = j + 1;
        }
        i = i + 1;
    }
    return Tensor2D { data: out, rows: m, cols: n };
}

pub fn tensor_2d_add_bias(a: Tensor2D, bias: Tensor1D) -> Tensor2D {
    let r = (a).rows;
    let c = (a).cols;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < r {
        let mut j = 0;
        while j < c {
            out = list_push(out, list_get((a).data, (i * c) + j) + list_get((bias).data, j));
            j = j + 1;
        }
        i = i + 1;
    }
    return Tensor2D { data: out, rows: r, cols: c };
}

pub fn tensor_2d_flatten(a: Tensor2D) -> Tensor1D {
    return Tensor1D { data: (a).data, size: (a).rows * (a).cols };
}

pub fn tensor_1d_reshape_2d(a: Tensor1D, rows: Int, cols: Int) -> Tensor2D {
    return Tensor2D { data: (a).data, rows: rows, cols: cols };
}

