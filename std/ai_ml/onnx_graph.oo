// # ONNX graph node
//
// Logline: Integer ONNX node with operator id and input count.
// residual: destubbed to Int floor.

type OnnxNode = struct {
    op_id: Int,
    inputs: Int
};

pub fn onnx_node_new(op_id: Int, inputs: Int) -> OnnxNode {
    return OnnxNode {
        op_id: op_id,
        inputs: inputs
    };
}

pub fn onnx_node_op_id(n: OnnxNode) -> Int {
    return n.op_id;
}
