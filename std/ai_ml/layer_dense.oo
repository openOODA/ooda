// # AI/ML Dense Fully-Connected Layer
//
// Logline: Implements linear transformation layers with forward affine mapping, bias addition, and backward gradient computation.
//
// Setup: Imports tensor_types.oo and tensor_ops.oo for matrix operations.
//
// Beats:
//   1. Construct DenseLayer structures with configurable in/out features and bias options.
//   2. Compute forward linear mapping Y = XW + b for batch matrices.
//   3. Compute backward parameter gradients (dW, db) and propagated input gradients (dX).

import "./tensor_types.oo";
import "./tensor_ops.oo";

// -------------------------------------------------------------------
// Dense Layer Data Structure
// -------------------------------------------------------------------

pub type DenseLayer = struct {
    in_features: Int,
    out_features: Int,
    has_bias: Bool,
    weights: Tensor2D,
    bias: Tensor1D,
    grad_weights: Tensor2D,
    grad_bias: Tensor1D
};

pub fn dense_layer_new(in_f: Int, out_f: Int, use_bias: Bool) -> DenseLayer {
    let total_w = in_f * out_f;
    let mut w_data: List[Float] = list_new();
    let mut gw_data: List[Float] = list_new();
    let mut i = 0;
    while i < total_w {
        w_data = list_push(w_data, 0.0);
        gw_data = list_push(gw_data, 0.0);
        i = i + 1;
    }

    let mut b_data: List[Float] = list_new();
    let mut gb_data: List[Float] = list_new();
    let mut j = 0;
    while j < out_f {
        b_data = list_push(b_data, 0.0);
        gb_data = list_push(gb_data, 0.0);
        j = j + 1;
    }

    return DenseLayer {
        in_features: in_f,
        out_features: out_f,
        has_bias: use_bias,
        weights: Tensor2D { data: w_data, rows: in_f, cols: out_f },
        bias: Tensor1D { data: b_data, size: out_f },
        grad_weights: Tensor2D { data: gw_data, rows: in_f, cols: out_f },
        grad_bias: Tensor1D { data: gb_data, size: out_f }
    };
}

// -------------------------------------------------------------------
// Forward Pass: Y = X * W + b
// -------------------------------------------------------------------

pub fn dense_forward(layer: &DenseLayer, input_x: Tensor2D) -> Tensor2D {
    // input_x: [batch_size, in_features]
    // weights: [in_features, out_features]
    // out:     [batch_size, out_features]
    let y = tensor_2d_matmul(input_x, (layer).weights);
    if (layer).has_bias {
        return tensor_2d_add_bias(y, (layer).bias);
    }
    return y;
}

// -------------------------------------------------------------------
// Backward Pass: dX = dY * W^T, dW = X^T * dY, db = sum(dY, axis=0)
// -------------------------------------------------------------------

pub fn dense_backward_input(layer: &DenseLayer, grad_out: Tensor2D) -> Tensor2D {
    // grad_out: [batch_size, out_features]
    // weights^T: [out_features, in_features]
    // dX:        [batch_size, in_features]
    let w_t = tensor_2d_transpose((layer).weights);
    return tensor_2d_matmul(grad_out, w_t);
}

pub fn dense_backward_weights(input_x: Tensor2D, grad_out: Tensor2D) -> Tensor2D {
    // input_x^T: [in_features, batch_size]
    // grad_out:  [batch_size, out_features]
    // dW:        [in_features, out_features]
    let x_t = tensor_2d_transpose(input_x);
    return tensor_2d_matmul(x_t, grad_out);
}

pub fn dense_backward_bias(grad_out: Tensor2D) -> Tensor1D {
    let r = (grad_out).rows;
    let c = (grad_out).cols;
    let mut out: List[Float] = list_new();
    let mut j = 0;
    while j < c {
        let mut acc = 0.0;
        let mut i = 0;
        while i < r {
            acc = acc + list_get((grad_out).data, (i * c) + j);
            i = i + 1;
        }
        out = list_push(out, acc);
        j = j + 1;
    }
    return Tensor1D { data: out, size: c };
}

pub fn dense_step(layer: &mut DenseLayer, lr: Float) {
    let total_w = ((layer).weights).rows * ((layer).weights).cols;
    let mut new_w: List[Float] = list_new();
    let mut i = 0;
    while i < total_w {
        let w = list_get(((layer).weights).data, i);
        let gw = list_get(((layer).grad_weights).data, i);
        new_w = list_push(new_w, w - (lr * gw));
        i = i + 1;
    }
    (layer).weights = Tensor2D {
        data: new_w,
        rows: ((layer).weights).rows,
        cols: ((layer).weights).cols
    };

    if (layer).has_bias {
        let n_b = ((layer).bias).size;
        let mut new_b: List[Float] = list_new();
        let mut j = 0;
        while j < n_b {
            let b = list_get(((layer).bias).data, j);
            let gb = list_get(((layer).grad_bias).data, j);
            new_b = list_push(new_b, b - (lr * gb));
            j = j + 1;
        }
        (layer).bias = Tensor1D { data: new_b, size: n_b };
    }
}

pub fn layer_dense_marker() -> Int {
    return 1;
}
