// # AI/ML ONNX Inference Runtime Engine
//
// Logline: Executes ONNX computation graphs with tensor memory allocation, operator dispatch, and output extraction.
//
// Setup: Imports tensor_types.oo, tensor_ops.oo, activation_ops.oo, and onnx_graph.oo for runtime inference.
//
// Beats:
//   1. Initialize ONNX runtime execution context with memory buffers and tensor registers.
//   2. Dispatch graph operator nodes (Gemm, Add, Relu, Softmax) to native tensor kernels.
//   3. Execute multi-layer neural network pipelines with intermediate tensor propagation.

import "./tensor_types.oo";
import "./tensor_ops.oo";
import "./activation_ops.oo";
import "./onnx_graph.oo";

// -------------------------------------------------------------------
// ONNX Runtime Engine State
// -------------------------------------------------------------------

pub type OnnxEngine = struct {
    is_initialized: Bool,
    op_count: Int,
    total_params: Int,
};

pub fn onnx_engine_new() -> OnnxEngine {
    return OnnxEngine {
        is_initialized: true,
        op_count: 0,
        total_params: 0,
    };
}

// -------------------------------------------------------------------
// Operator Runtime Dispatches
// -------------------------------------------------------------------

pub fn onnx_engine_exec_gemm(engine: &mut OnnxEngine, a: Tensor2D, b: Tensor2D, bias: Tensor1D) -> Tensor2D {
    (engine).op_count = (engine).op_count + 1;
    let y = tensor_2d_matmul(a, b);
    return tensor_2d_add_bias(y, bias);
}

pub fn onnx_engine_exec_relu_2d(engine: &mut OnnxEngine, input: Tensor2D) -> Tensor2D {
    (engine).op_count = (engine).op_count + 1;
    let total = (input).rows * (input).cols;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < total {
        out = list_push(out, act_relu(list_get((input).data, i)));
        i = i + 1;
    }
    return Tensor2D { data: out, rows: (input).rows, cols: (input).cols };
}

pub fn onnx_engine_forward_mlp(
    engine: &mut OnnxEngine,
    x: Tensor2D,
    w1: Tensor2D,
    b1: Tensor1D,
    w2: Tensor2D,
    b2: Tensor1D
) -> Tensor2D {
    let h1 = onnx_engine_exec_gemm(engine, x, w1, b1);
    let a1 = onnx_engine_exec_relu_2d(engine, h1);
    return onnx_engine_exec_gemm(engine, a1, w2, b2);
}
