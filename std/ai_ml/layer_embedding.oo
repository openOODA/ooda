// # AI/ML Token & Positional Embedding Layers
//
// Logline: Implements discrete vocabulary token lookup tables, learned positional embeddings, and sinusoidal encodings.
//
// Setup: Imports tensor_types.oo and tensor_ops.oo for index lookup and embedding matrix manipulation.
//
// Beats:
//   1. Define Embedding table structures and initialize with latent representations.
//   2. Perform forward integer token index lookups to extract dense representation vectors.
//   3. Generate analytical sinusoidal positional encodings for transformer sequence inputs.

import "./tensor_types.oo";
import "./tensor_ops.oo";

// -------------------------------------------------------------------
// Discrete Vocabulary Embedding Table
// -------------------------------------------------------------------

pub type EmbeddingTable = struct {
    num_embeddings: Int,
    embedding_dim: Int,
    table: Tensor2D,
};

pub fn embedding_table_new(num_tokens: Int, dim: Int) -> EmbeddingTable {
    let total = num_tokens * dim;
    let mut data: List[Float] = list_new();
    let mut i = 0;
    while i < total {
        data = list_push(data, 0.0);
        i = i + 1;
    }
    return EmbeddingTable {
        num_embeddings: num_tokens,
        embedding_dim: dim,
        table: Tensor2D { data: data, rows: num_tokens, cols: dim },
    };
}

pub fn embedding_forward_lookup(table: &EmbeddingTable, token_id: Int) -> Tensor1D {
    let dim = (table).embedding_dim;
    let num_tokens = (table).num_embeddings;
    let mut out: List[Float] = list_new();

    let mut id = token_id;
    if id < 0 || id >= num_tokens {
        id = 0; // fallback to index 0 for out-of-bounds
    }

    let mut j = 0;
    while j < dim {
        let idx = (id * dim) + j;
        out = list_push(out, list_get(((table).table).data, idx));
        j = j + 1;
    }
    return Tensor1D { data: out, size: dim };
}

pub fn embedding_forward_sequence(table: &EmbeddingTable, token_ids: List[Int]) -> Tensor2D {
    let seq_len = list_len(token_ids);
    let dim = (table).embedding_dim;
    let mut out: List[Float] = list_new();

    let mut i = 0;
    while i < seq_len {
        let tid = list_get(token_ids, i);
        let emb = embedding_forward_lookup(table, tid);
        let mut j = 0;
        while j < dim {
            out = list_push(out, list_get((emb).data, j));
            j = j + 1;
        }
        i = i + 1;
    }
    return Tensor2D { data: out, rows: seq_len, cols: dim };
}

// -------------------------------------------------------------------
// Sinusoidal Positional Encodings: PE(pos, 2i) = sin(pos / 10000^(2i/d))
// -------------------------------------------------------------------

pub fn positional_encoding_sinusoidal(seq_len: Int, dim: Int) -> Tensor2D {
    let mut out: List[Float] = list_new();
    let mut pos = 0;
    while pos < seq_len {
        let mut i = 0;
        while i < dim {
            let exponent = int_to_float(2 * (i / 2)) / int_to_float(dim);
            let denom = pow(10000.0, exponent);
            let angle = int_to_float(pos) / denom;
            let mut val = sin(angle);
            if i % 2 == 1 {
                val = cos(angle);
            }
            out = list_push(out, val);
            i = i + 1;
        }
        pos = pos + 1;
    }
    return Tensor2D { data: out, rows: seq_len, cols: dim };
}
