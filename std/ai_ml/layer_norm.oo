// # AI/ML Normalization Layers (LayerNorm, RMSNorm, BatchNorm)
//
// Logline: Implements Layer Normalization, Root Mean Square Normalization (RMSNorm), and Batch Normalization.
//
// Setup: Imports tensor_types.oo and tensor_ops.oo for statistical normalization.
//
// Beats:
//   1. Compute Layer Normalization over hidden features with learned scale (gamma) and shift (beta).
//   2. Compute Llama-style RMSNorm with scale parameters and invariant variance scaling.
//   3. Compute 1D Batch Normalization with running mean and running variance tracking for inference.

import "./tensor_types.oo";
import "./tensor_ops.oo";

// -------------------------------------------------------------------
// Layer Normalization: y = ((x - mu) / sqrt(var + eps)) * gamma + beta
// -------------------------------------------------------------------

pub type LayerNorm = struct {
    normalized_shape: Int,
    eps: Float,
    gamma: Tensor1D,
    beta: Tensor1D
};

pub fn layer_norm_new(dim: Int, eps: Float) -> LayerNorm {
    let mut g_data: List[Float] = list_new();
    let mut b_data: List[Float] = list_new();
    let mut i = 0;
    while i < dim {
        g_data = list_push(g_data, 1.0);
        b_data = list_push(b_data, 0.0);
        i = i + 1;
    }
    return LayerNorm {
        normalized_shape: dim,
        eps: eps,
        gamma: Tensor1D { data: g_data, size: dim },
        beta: Tensor1D { data: b_data, size: dim }
    };
}

pub fn layer_norm_forward_1d(ln: &LayerNorm, x: Tensor1D) -> Tensor1D {
    let n = (x).size;
    let mean_val = tensor_1d_mean(x);
    let var_val = tensor_1d_variance(x);
    let std_inv = 1.0 / sqrt(var_val + (ln).eps);

    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < n {
        let x_norm = (list_get((x).data, i) - mean_val) * std_inv;
        let g = list_get(((ln).gamma).data, i);
        let b = list_get(((ln).beta).data, i);
        out = list_push(out, (x_norm * g) + b);
        i = i + 1;
    }
    return Tensor1D { data: out, size: n };
}

// -------------------------------------------------------------------
// RMSNorm (Root Mean Square Normalization): y = (x / RMS(x)) * weight
// -------------------------------------------------------------------

pub type RMSNorm = struct {
    dim: Int,
    eps: Float,
    weight: Tensor1D
};

pub fn rms_norm_new(dim: Int, eps: Float) -> RMSNorm {
    let mut w_data: List[Float] = list_new();
    let mut i = 0;
    while i < dim {
        w_data = list_push(w_data, 1.0);
        i = i + 1;
    }
    return RMSNorm {
        dim: dim,
        eps: eps,
        weight: Tensor1D { data: w_data, size: dim }
    };
}

pub fn rms_norm_forward_1d(rmsn: &RMSNorm, x: Tensor1D) -> Tensor1D {
    let n = (x).size;
    let mut sum_sq = 0.0;
    let mut i = 0;
    while i < n {
        let v = list_get((x).data, i);
        sum_sq = sum_sq + (v * v);
        i = i + 1;
    }
    let rms = sqrt((sum_sq / int_to_float(n)) + (rmsn).eps);
    let rms_inv = 1.0 / rms;

    let mut out: List[Float] = list_new();
    let mut j = 0;
    while j < n {
        let w = list_get(((rmsn).weight).data, j);
        out = list_push(out, (list_get((x).data, j) * rms_inv) * w);
        j = j + 1;
    }
    return Tensor1D { data: out, size: n };
}

// -------------------------------------------------------------------
// BatchNorm 1D: Tracking Running Statistics
// -------------------------------------------------------------------

pub type BatchNorm1D = struct {
    num_features: Int,
    eps: Float,
    momentum: Float,
    running_mean: Tensor1D,
    running_var: Tensor1D,
    gamma: Tensor1D,
    beta: Tensor1D
};

pub fn batch_norm_1d_new(dim: Int, eps: Float, momentum: Float) -> BatchNorm1D {
    let mut rm_data: List[Float] = list_new();
    let mut rv_data: List[Float] = list_new();
    let mut g_data: List[Float] = list_new();
    let mut b_data: List[Float] = list_new();
    let mut i = 0;
    while i < dim {
        rm_data = list_push(rm_data, 0.0);
        rv_data = list_push(rv_data, 1.0);
        g_data = list_push(g_data, 1.0);
        b_data = list_push(b_data, 0.0);
        i = i + 1;
    }
    return BatchNorm1D {
        num_features: dim,
        eps: eps,
        momentum: momentum,
        running_mean: Tensor1D { data: rm_data, size: dim },
        running_var: Tensor1D { data: rv_data, size: dim },
        gamma: Tensor1D { data: g_data, size: dim },
        beta: Tensor1D { data: b_data, size: dim }
    };
}

pub fn batch_norm_forward_1d(bn: &BatchNorm1D, x: Tensor1D) -> Tensor1D {
    let n = (x).size;
    let mut out: List[Float] = list_new();
    let mut i = 0;
    while i < n {
        let mean_v = list_get(((bn).running_mean).data, i);
        let var_v = list_get(((bn).running_var).data, i);
        let std_v = sqrt(var_v + (bn).eps);
        let x_hat = (list_get((x).data, i) - mean_v) / std_v;
        let g = list_get(((bn).gamma).data, i);
        let b = list_get(((bn).beta).data, i);
        out = list_push(out, (x_hat * g) + b);
        i = i + 1;
    }
    return Tensor1D { data: out, size: n };
}
