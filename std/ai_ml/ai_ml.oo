// # AI/ML & Tensor Computing Facade
//
// Logline: Re-exports tensor types, math operations, layers, optimizers, tokenizers, ONNX runtime, and evaluation metrics.
//
// Setup: Pure module shim importing all companion AI/ML submodules.
//
// Beats:
//   1. Import all AI/ML submodules covering tensors, autograd, layers, optimizers, tokenizers, onnx, metrics, and stubs.
//   2. Re-export public entry points with typed shim markers.
//   3. Provide comprehensive AI/ML standard library surface for openOODA applications.

import "./tensor_types.oo";
import "./activation_ops.oo";
import "./tensor_ops.oo";
import "./tensor_autograd.oo";
import "./tensor_engine.oo";
import "./layer_dense.oo";
import "./layer_conv2d.oo";
import "./layer_attention.oo";
import "./layer_recurrent.oo";
import "./layer_norm.oo";
import "./layer_embedding.oo";
import "./loss_cross_entropy.oo";
import "./loss_mse.oo";
import "./opt_sgd.oo";
import "./opt_adamw.oo";
import "./opt_rmsprop.oo";
import "./tokenizer_bpe.oo";
import "./tokenizer_wordpiece.oo";
import "./onnx_parser.oo";
import "./onnx_graph.oo";
import "./onnx_engine.oo";
import "./metric_accuracy.oo";
import "./metric_loss.oo";
import "./ai_ml_stubs.oo";

pub fn shim_ai_ml_marker() -> Int {
    return 1;
}

pub fn shim_tensor_1d_new(data: List[Float], size: Int) -> Tensor1D {
    return tensor_1d_new(data, size);
}

pub fn shim_act_relu(x: Float) -> Float {
    return act_relu(x);
}

pub fn shim_act_gelu(x: Float) -> Float {
    return act_gelu(x);
}

pub fn shim_bpe_tokenizer_new() -> BPETokenizer {
    return bpe_tokenizer_new();
}

pub fn shim_onnx_engine_new() -> OnnxEngine {
    return onnx_engine_new();
}

pub fn shim_metric_top1_accuracy(p: List[Int], t: List[Int]) -> Float {
    return metric_top1_accuracy(p, t);
}
