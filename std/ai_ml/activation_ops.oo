// # AI/ML Activation Functions & Derivatives
//
// Logline: Implements non-linear neural network activations and their exact analytical gradients.
//
// Setup: Pure mathematical module providing ReLU, GELU, SiLU, Sigmoid, Tanh, Softmax, and ELU transformations.
//
// Beats:
//   1. Compute standard elementwise activations (ReLU, LeakyReLU, Sigmoid, Tanh, GELU, SiLU, ELU).
//   2. Compute stable multi-class Softmax and LogSoftmax with max-subtraction stabilization.
//   3. Evaluate exact first-order derivatives for backpropagation passes.

// -------------------------------------------------------------------
// Standard Elementwise Activations
// -------------------------------------------------------------------

pub fn act_relu(x: Float) -> Float {
    if x > 0.0 {
        return x;
    }
    return 0.0;
}

pub fn act_relu_grad(x: Float) -> Float {
    if x > 0.0 {
        return 1.0;
    }
    return 0.0;
}

pub fn act_leaky_relu(x: Float, alpha: Float) -> Float {
    if x > 0.0 {
        return x;
    }
    return alpha * x;
}

pub fn act_leaky_relu_grad(x: Float, alpha: Float) -> Float {
    if x > 0.0 {
        return 1.0;
    }
    return alpha;
}

pub fn act_sigmoid(x: Float) -> Float {
    if x > 40.0 {
        return 1.0;
    }
    if x < 0.0 - 40.0 {
        return 0.0;
    }
    return 1.0 / (1.0 + exp(0.0 - x));
}

pub fn act_sigmoid_grad(x: Float) -> Float {
    let s = act_sigmoid(x);
    return s * (1.0 - s);
}

pub fn act_tanh(x: Float) -> Float {
    if x > 20.0 {
        return 1.0;
    }
    if x < 0.0 - 20.0 {
        return 0.0 - 1.0;
    }
    let e_pos = exp(x);
    let e_neg = exp(0.0 - x);
    return (e_pos - e_neg) / (e_pos + e_neg);
}

pub fn act_tanh_grad(x: Float) -> Float {
    let t = act_tanh(x);
    return 1.0 - (t * t);
}

pub fn act_gelu(x: Float) -> Float {
    // GELU approximation: 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
    let sqrt_2_over_pi = 0.7978845608;
    let poly = x + (0.044715 * (x * (x * x)));
    let inner = sqrt_2_over_pi * poly;
    let t = act_tanh(inner);
    return 0.5 * x * (1.0 + t);
}

pub fn act_gelu_grad(x: Float) -> Float {
    let sqrt_2_over_pi = 0.7978845608;
    let poly = x + (0.044715 * (x * (x * x)));
    let poly_prime = 1.0 + (0.134145 * (x * x));
    let inner = sqrt_2_over_pi * poly;
    let t = act_tanh(inner);
    let dt = (1.0 - (t * t)) * (sqrt_2_over_pi * poly_prime);
    return (0.5 * (1.0 + t)) + (0.5 * x * dt);
}

pub fn act_silu(x: Float) -> Float {
    return x * act_sigmoid(x);
}

pub fn act_silu_grad(x: Float) -> Float {
    let s = act_sigmoid(x);
    return s + (x * (s * (1.0 - s)));
}

pub fn act_elu(x: Float, alpha: Float) -> Float {
    if x >= 0.0 {
        return x;
    }
    return alpha * (exp(x) - 1.0);
}

pub fn act_elu_grad(x: Float, alpha: Float) -> Float {
    if x >= 0.0 {
        return 1.0;
    }
    return alpha * exp(x);
}

// -------------------------------------------------------------------
// Multi-Class Normalizations
// -------------------------------------------------------------------

pub fn act_softmax_1d(logits: List[Float]) -> List[Float] {
    let n = list_len(logits);
    if n == 0 {
        return list_new();
    }
    let mut max_val = list_get(logits, 0);
    let mut i = 1;
    while i < n {
        let v = list_get(logits, i);
        if v > max_val {
            max_val = v;
        }
        i = i + 1;
    }

    let mut sum_exp = 0.0;
    let mut exp_vals: List[Float] = list_new();
    let mut j = 0;
    while j < n {
        let ev = exp(list_get(logits, j) - max_val);
        exp_vals = list_push(exp_vals, ev);
        sum_exp = sum_exp + ev;
        j = j + 1;
    }

    let mut out: List[Float] = list_new();
    let mut k = 0;
    while k < n {
        out = list_push(out, list_get(exp_vals, k) / sum_exp);
        k = k + 1;
    }
    return out;
}

pub fn act_log_softmax_1d(logits: List[Float]) -> List[Float] {
    let n = list_len(logits);
    if n == 0 {
        return list_new();
    }
    let mut max_val = list_get(logits, 0);
    let mut i = 1;
    while i < n {
        let v = list_get(logits, i);
        if v > max_val {
            max_val = v;
        }
        i = i + 1;
    }

    let mut sum_exp = 0.0;
    let mut j = 0;
    while j < n {
        sum_exp = sum_exp + exp(list_get(logits, j) - max_val);
        j = j + 1;
    }
    let log_sum_exp = max_val + ln(sum_exp);

    let mut out: List[Float] = list_new();
    let mut k = 0;
    while k < n {
        out = list_push(out, list_get(logits, k) - log_sum_exp);
        k = k + 1;
    }
    return out;
}
