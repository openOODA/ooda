// # AI/ML Reverse-Mode Automatic Differentiation
//
// Logline: Tape node recording and analytical unary/binary gradient rules.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type TapeNode = struct {
    op_code: Int,
    parent_a: Int,
    parent_b: Int,
    scalar_milli: Int,
    has_parent_b: Bool
};

type AutoGradTape = struct {
    node_count: Int,
    is_recording: Bool,
    last_op: Int,
    last_parent_a: Int,
    last_parent_b: Int
};

pub fn op_add() -> Int { return 1; }
pub fn op_sub() -> Int { return 2; }
pub fn op_mul() -> Int { return 3; }
pub fn op_matmul() -> Int { return 4; }
pub fn op_relu() -> Int { return 5; }
pub fn op_sigmoid() -> Int { return 6; }
pub fn op_tanh() -> Int { return 7; }
pub fn op_scale() -> Int { return 8; }

pub fn autograd_tape_new() -> AutoGradTape {
    return AutoGradTape {
        node_count: 0,
        is_recording: true,
        last_op: 0,
        last_parent_a: 0,
        last_parent_b: 0
    };
}

pub fn autograd_node_new(op: Int, parent_a: Int, parent_b: Int, scalar_milli: Int, has_b: Bool) -> TapeNode {
    return TapeNode {
        op_code: op,
        parent_a: parent_a,
        parent_b: parent_b,
        scalar_milli: scalar_milli,
        has_parent_b: has_b
    };
}

pub fn autograd_record_unary(tape: AutoGradTape, op: Int, parent: Int) -> AutoGradTape {
    return AutoGradTape {
        node_count: tape.node_count + 1,
        is_recording: tape.is_recording,
        last_op: op,
        last_parent_a: parent,
        last_parent_b: 0 - 1
    };
}

pub fn autograd_record_binary(tape: AutoGradTape, op: Int, parent_a: Int, parent_b: Int) -> AutoGradTape {
    return AutoGradTape {
        node_count: tape.node_count + 1,
        is_recording: tape.is_recording,
        last_op: op,
        last_parent_a: parent_a,
        last_parent_b: parent_b
    };
}

pub fn autograd_backward_unary(op: Int, forward_milli: Int, grad_out_milli: Int) -> Int {
    if op == op_relu() {
        if forward_milli > 0 {
            return grad_out_milli;
        }
        return 0;
    }
    if op == op_sigmoid() {
        let s: Int = forward_milli;
        return (grad_out_milli * ((s * (1000 - s)) / 1000)) / 1000;
    }
    if op == op_tanh() {
        let t: Int = forward_milli;
        return (grad_out_milli * (1000 - ((t * t) / 1000))) / 1000;
    }
    return grad_out_milli;
}

pub fn autograd_backward_binary_left(op: Int, b_val_milli: Int, grad_out_milli: Int) -> Int {
    if op == op_add() {
        return grad_out_milli;
    }
    if op == op_sub() {
        return grad_out_milli;
    }
    if op == op_mul() {
        return (grad_out_milli * b_val_milli) / 1000;
    }
    if op == op_scale() {
        return (grad_out_milli * b_val_milli) / 1000;
    }
    return grad_out_milli;
}

pub fn autograd_backward_binary_right(op: Int, a_val_milli: Int, grad_out_milli: Int) -> Int {
    if op == op_add() {
        return grad_out_milli;
    }
    if op == op_sub() {
        return 0 - grad_out_milli;
    }
    if op == op_mul() {
        return (grad_out_milli * a_val_milli) / 1000;
    }
    return grad_out_milli;
}
