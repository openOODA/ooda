// # Classification counters and milli-ratio metrics
//
// Logline: Confusion-matrix counts plus Top-1 / precision / recall / F1 in milli.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: destubbed to Int floor.

type ConfusionMatrix = struct {
    tp: Int,
    fp: Int,
    tn: Int,
    fn_miss: Int,
    total_n: Int
}

type ClassificationMetrics = struct {
    acc_milli: Int,
    prec_milli: Int,
    rec_milli: Int,
    f1_milli: Int
}

type PredBatch = struct {
    p0: Int,
    p1: Int,
    p2: Int,
    p3: Int,
    t0: Int,
    t1: Int,
    t2: Int,
    t3: Int
}

fn metric_hit(pred: Int, target: Int) -> Int {
    if pred == target {
        return 1;
    }
    return 0;
}

pub fn confusion_matrix_new(tp: Int, fp: Int, tn: Int, fn_miss: Int) -> ConfusionMatrix {
    return ConfusionMatrix {
        tp: tp,
        fp: fp,
        tn: tn,
        fn_miss: fn_miss,
        total_n: ((tp + fp) + tn) + fn_miss
    };
}

pub fn metric_accuracy_milli(cm: ConfusionMatrix) -> Int {
    if cm.total_n == 0 {
        return 0;
    }
    return ((cm.tp + cm.tn) * 1000) / cm.total_n;
}

pub fn metric_precision_milli(cm: ConfusionMatrix) -> Int {
    let denom: Int = cm.tp + cm.fp;
    if denom == 0 {
        return 0;
    }
    return (cm.tp * 1000) / denom;
}

pub fn metric_recall_milli(cm: ConfusionMatrix) -> Int {
    let denom: Int = cm.tp + cm.fn_miss;
    if denom == 0 {
        return 0;
    }
    return (cm.tp * 1000) / denom;
}

pub fn metric_f1_milli(cm: ConfusionMatrix) -> Int {
    let prec: Int = metric_precision_milli(cm);
    let rec: Int = metric_recall_milli(cm);
    let denom: Int = prec + rec;
    if denom == 0 {
        return 0;
    }
    return ((2 * prec) * rec) / denom;
}

pub fn metric_evaluate_all(cm: ConfusionMatrix) -> ClassificationMetrics {
    return ClassificationMetrics {
        acc_milli: metric_accuracy_milli(cm),
        prec_milli: metric_precision_milli(cm),
        rec_milli: metric_recall_milli(cm),
        f1_milli: metric_f1_milli(cm)
    };
}

pub fn pred_batch_new(p0: Int, p1: Int, p2: Int, p3: Int, t0: Int, t1: Int, t2: Int, t3: Int) -> PredBatch {
    return PredBatch {
        p0: p0,
        p1: p1,
        p2: p2,
        p3: p3,
        t0: t0,
        t1: t1,
        t2: t2,
        t3: t3
    };
}

pub fn metric_top1_milli(b: PredBatch) -> Int {
    let hits: Int = ((metric_hit(b.p0, b.t0) + metric_hit(b.p1, b.t1)) + metric_hit(b.p2, b.t2)) + metric_hit(b.p3, b.t3);
    return (hits * 1000) / 4;
}
