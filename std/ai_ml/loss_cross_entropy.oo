// # AI/ML Categorical Cross-Entropy Loss
//
// Logline: Computes multi-class categorical cross-entropy loss with numerically stable LogSoftmax, label smoothing, and gradients.
//
// Setup: Imports tensor_types.oo and activation_ops.oo for probability distribution loss evaluation.
//
// Beats:
//   1. Compute single-sample cross entropy loss with numerical log-sum-exp stabilization.
//   2. Compute batch cross-entropy loss with optional uniform label smoothing regularization.
//   3. Compute exact analytical softmax-cross-entropy backpropagation gradients (p - y).

import "./tensor_types.oo";
import "./activation_ops.oo";

// -------------------------------------------------------------------
// Categorical Cross-Entropy Calculations
// -------------------------------------------------------------------

pub fn loss_cross_entropy_single(logits: Tensor1D, target_class: Int) -> Float {
    let log_probs = act_log_softmax_1d((logits).data);
    let n = (logits).size;
    if target_class < 0 || target_class >= n {
        return 0.0;
    }
    return 0.0 - list_get(log_probs, target_class);
}

pub fn loss_cross_entropy_smoothed(logits: Tensor1D, target_class: Int, smoothing: Float) -> Float {
    let log_probs = act_log_softmax_1d((logits).data);
    let n = (logits).size;
    if n == 0 {
        return 0.0;
    }
    let uniform_prob = smoothing / int_to_float(n);
    let target_prob = (1.0 - smoothing) + uniform_prob;

    let mut loss = 0.0;
    let mut i = 0;
    while i < n {
        let lp = list_get(log_probs, i);
        let mut p = uniform_prob;
        if i == target_class {
            p = target_prob;
        }
        loss = loss - (p * lp);
        i = i + 1;
    }
    return loss;
}

pub fn loss_cross_entropy_batch(logits: Tensor2D, targets: List[Int]) -> Float {
    let batch_size = (logits).rows;
    let num_classes = (logits).cols;
    if batch_size == 0 {
        return 0.0;
    }

    let mut total_loss = 0.0;
    let mut i = 0;
    while i < batch_size {
        let mut row_logits: List[Float] = list_new();
        let mut j = 0;
        while j < num_classes {
            row_logits = list_push(row_logits, list_get((logits).data, (i * num_classes) + j));
            j = j + 1;
        }
        let row_t = Tensor1D { data: row_logits, size: num_classes };
        let target = list_get(targets, i);
        total_loss = total_loss + loss_cross_entropy_single(row_t, target);
        i = i + 1;
    }
    return total_loss / int_to_float(batch_size);
}

// -------------------------------------------------------------------
// Analytical Softmax Cross-Entropy Gradients: dL/dz = softmax(z) - y
// -------------------------------------------------------------------

pub fn loss_cross_entropy_grad(logits: Tensor1D, target_class: Int) -> Tensor1D {
    let probs = act_softmax_1d((logits).data);
    let n = (logits).size;
    let mut grad: List[Float] = list_new();

    let mut i = 0;
    while i < n {
        let mut target_val = 0.0;
        if i == target_class {
            target_val = 1.0;
        }
        let p = list_get(probs, i);
        grad = list_push(grad, p - target_val);
        i = i + 1;
    }
    return Tensor1D { data: grad, size: n };
}

pub fn loss_cross_entropy_batch_grad(logits: Tensor2D, targets: List[Int]) -> Tensor2D {
    let batch_size = (logits).rows;
    let num_classes = (logits).cols;
    let scale = 1.0 / int_to_float(batch_size);

    let mut out_grad: List[Float] = list_new();
    let mut i = 0;
    while i < batch_size {
        let mut row_logits: List[Float] = list_new();
        let mut j = 0;
        while j < num_classes {
            row_logits = list_push(row_logits, list_get((logits).data, (i * num_classes) + j));
            j = j + 1;
        }
        let row_t = Tensor1D { data: row_logits, size: num_classes };
        let target = list_get(targets, i);
        let g = loss_cross_entropy_grad(row_t, target);
        let mut k = 0;
        while k < num_classes {
            out_grad = list_push(out_grad, list_get((g).data, k) * scale);
            k = k + 1;
        }
        i = i + 1;
    }
    return Tensor2D { data: out_grad, rows: batch_size, cols: num_classes };
}
