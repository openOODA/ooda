// # AI/ML Tensor Execution Engine & Memory Allocator
//
// Logline: Manages tensor allocation, pseudo-random weight initializers, buffer caching, and execution context.
//
// Setup: Imports tensor_types.oo and tensor_ops.oo for memory management and factory routines.
//
// Beats:
//   1. Initialize zero, ones, uniform, normal, and Xavier/He initialized tensor buffers.
//   2. Manage tensor memory pool allocations and shape validation.
//   3. Dispatch tensor operations across execution contexts and device targets.

import "./tensor_types.oo";
import "./tensor_ops.oo";

// -------------------------------------------------------------------
// Engine Context Structure
// -------------------------------------------------------------------

pub type TensorEngine = struct {
    current_device: Int,
    memory_allocated_bytes: Int,
    op_counter: Int,
    initialized: Bool
};

pub fn tensor_engine_new(device: Int) -> TensorEngine {
    return TensorEngine {
        current_device: device,
        memory_allocated_bytes: 0,
        op_counter: 0,
        initialized: true
    };
}

// -------------------------------------------------------------------
// Buffer Allocators
// -------------------------------------------------------------------

pub fn tensor_1d_zeros(size: Int) -> Tensor1D {
    let mut data: List[Float] = list_new();
    let mut i = 0;
    while i < size {
        data = list_push(data, 0.0);
        i = i + 1;
    }
    return Tensor1D { data: data, size: size };
}

pub fn tensor_1d_ones(size: Int) -> Tensor1D {
    let mut data: List[Float] = list_new();
    let mut i = 0;
    while i < size {
        data = list_push(data, 1.0);
        i = i + 1;
    }
    return Tensor1D { data: data, size: size };
}

pub fn tensor_1d_fill(size: Int, val: Float) -> Tensor1D {
    let mut data: List[Float] = list_new();
    let mut i = 0;
    while i < size {
        data = list_push(data, val);
        i = i + 1;
    }
    return Tensor1D { data: data, size: size };
}

pub fn tensor_2d_zeros(rows: Int, cols: Int) -> Tensor2D {
    let total = rows * cols;
    let mut data: List[Float] = list_new();
    let mut i = 0;
    while i < total {
        data = list_push(data, 0.0);
        i = i + 1;
    }
    return Tensor2D { data: data, rows: rows, cols: cols };
}

pub fn tensor_2d_ones(rows: Int, cols: Int) -> Tensor2D {
    let total = rows * cols;
    let mut data: List[Float] = list_new();
    let mut i = 0;
    while i < total {
        data = list_push(data, 1.0);
        i = i + 1;
    }
    return Tensor2D { data: data, rows: rows, cols: cols };
}

pub fn tensor_2d_fill(rows: Int, cols: Int, val: Float) -> Tensor2D {
    let total = rows * cols;
    let mut data: List[Float] = list_new();
    let mut i = 0;
    while i < total {
        data = list_push(data, val);
        i = i + 1;
    }
    return Tensor2D { data: data, rows: rows, cols: cols };
}

// -------------------------------------------------------------------
// Pseudo-Random Number Generation & Initializers
// -------------------------------------------------------------------

pub fn pseudo_rand_lcg(state: Int) -> Int {
    // 64-bit LCG step: (a * state + c) % m
    let next_state = ((state * 1103515245) + 12345) % 2147483647;
    if next_state < 0 {
        return 0 - next_state;
    }
    return next_state;
}

pub fn pseudo_rand_uniform(state: Int) -> Float {
    let n = pseudo_rand_lcg(state);
    return int_to_float(n % 10000) / 10000.0;
}

pub fn tensor_1d_uniform(size: Int, seed: Int, low: Float, high: Float) -> Tensor1D {
    let mut data: List[Float] = list_new();
    let mut cur = seed;
    let span = high - low;
    let mut i = 0;
    while i < size {
        cur = pseudo_rand_lcg(cur + i);
        let u = int_to_float(cur % 10000) / 10000.0;
        data = list_push(data, low + (u * span));
        i = i + 1;
    }
    return Tensor1D { data: data, size: size };
}

pub fn tensor_2d_xavier_init(rows: Int, cols: Int, seed: Int) -> Tensor2D {
    let total = rows * cols;
    let limit = sqrt(6.0 / int_to_float(rows + cols));
    let mut data: List[Float] = list_new();
    let mut cur = seed;
    let mut i = 0;
    while i < total {
        cur = pseudo_rand_lcg(cur + i);
        let u = int_to_float(cur % 10000) / 10000.0;
        let val = (0.0 - limit) + (u * (2.0 * limit));
        data = list_push(data, val);
        i = i + 1;
    }
    return Tensor2D { data: data, rows: rows, cols: cols };
}

pub fn tensor_2d_he_init(rows: Int, cols: Int, seed: Int) -> Tensor2D {
    let total = rows * cols;
    let std_dev = sqrt(2.0 / int_to_float(rows));
    let mut data: List[Float] = list_new();
    let mut cur = seed;
    let mut i = 0;
    while i < total {
        cur = pseudo_rand_lcg(cur + i);
        let u = int_to_float(cur % 10000) / 10000.0;
        let val = (0.0 - std_dev) + (u * (2.0 * std_dev));
        data = list_push(data, val);
        i = i + 1;
    }
    return Tensor2D { data: data, rows: rows, cols: cols };
}
