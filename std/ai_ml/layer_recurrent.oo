// # AI/ML Recurrent Neural Network & GRU/LSTM Cells
//
// Logline: Implements vanilla RNN, Gated Recurrent Unit (GRU), and Long Short-Term Memory (LSTM) sequence cells.
//
// Setup: Imports tensor_types.oo, tensor_ops.oo, and activation_ops.oo for sequential state transitions.
//
// Beats:
//   1. Execute single-step vanilla RNN state transitions with tanh non-linearities.
//   2. Execute LSTM memory cells with input, forget, cell candidate, and output gating mechanisms.
//   3. Execute GRU cells with reset and update gating for lightweight sequence modeling.

import "./tensor_types.oo";
import "./tensor_ops.oo";
import "./activation_ops.oo";

// -------------------------------------------------------------------
// Vanilla RNN Cell: h_t = tanh(W_ih * x_t + W_hh * h_{t-1} + b)
// -------------------------------------------------------------------

pub type RNNCell = struct {
    in_dim: Int,
    hidden_dim: Int,
    w_ih: Tensor2D,
    w_hh: Tensor2D,
    bias_h: Tensor1D
};

pub fn rnn_cell_new(in_d: Int, h_d: Int) -> RNNCell {
    let mut w_ih_data: List[Float] = list_new();
    let total_ih = in_d * h_d;
    let mut i = 0;
    while i < total_ih {
        w_ih_data = list_push(w_ih_data, 0.0);
        i = i + 1;
    }

    let mut w_hh_data: List[Float] = list_new();
    let total_hh = h_d * h_d;
    let mut j = 0;
    while j < total_hh {
        w_hh_data = list_push(w_hh_data, 0.0);
        j = j + 1;
    }

    let mut b_data: List[Float] = list_new();
    let mut k = 0;
    while k < h_d {
        b_data = list_push(b_data, 0.0);
        k = k + 1;
    }

    return RNNCell {
        in_dim: in_d,
        hidden_dim: h_d,
        w_ih: Tensor2D { data: w_ih_data, rows: in_d, cols: h_d },
        w_hh: Tensor2D { data: w_hh_data, rows: h_d, cols: h_d },
        bias_h: Tensor1D { data: b_data, size: h_d }
    };
}

pub fn rnn_step(cell: &RNNCell, x_t: Tensor1D, h_prev: Tensor1D) -> Tensor1D {
    let h_d = (cell).hidden_dim;
    let in_d = (cell).in_dim;
    let mut out_h: List[Float] = list_new();

    let mut j = 0;
    while j < h_d {
        let mut acc = list_get(((cell).bias_h).data, j);
        let mut p = 0;
        while p < in_d {
            acc = acc + (list_get((x_t).data, p) * list_get(((cell).w_ih).data, (p * h_d) + j));
            p = p + 1;
        }
        let mut q = 0;
        while q < h_d {
            acc = acc + (list_get((h_prev).data, q) * list_get(((cell).w_hh).data, (q * h_d) + j));
            q = q + 1;
        }
        out_h = list_push(out_h, act_tanh(acc));
        j = j + 1;
    }

    return Tensor1D { data: out_h, size: h_d };
}

// -------------------------------------------------------------------
// LSTM Memory Cell: (f, i, c_tilde, o) gates and (c_t, h_t) states
// -------------------------------------------------------------------

pub type LSTMState = struct {
    h: Tensor1D,
    c: Tensor1D
};

pub fn lstm_state_new(hidden_dim: Int) -> LSTMState {
    let mut h_data: List[Float] = list_new();
    let mut c_data: List[Float] = list_new();
    let mut i = 0;
    while i < hidden_dim {
        h_data = list_push(h_data, 0.0);
        c_data = list_push(c_data, 0.0);
        i = i + 1;
    }
    return LSTMState {
        h: Tensor1D { data: h_data, size: hidden_dim },
        c: Tensor1D { data: c_data, size: hidden_dim }
    };
}

pub fn lstm_gate_step(
    x_val: Float,
    h_val: Float,
    c_val: Float,
    w_f: Float,
    w_i: Float,
    w_c: Float,
    w_o: Float
) -> Float {
    let f = act_sigmoid((x_val * w_f) + (h_val * w_f));
    let i = act_sigmoid((x_val * w_i) + (h_val * w_i));
    let c_cand = act_tanh((x_val * w_c) + (h_val * w_c));
    let next_c = (f * c_val) + (i * c_cand);
    let o = act_sigmoid((x_val * w_o) + (h_val * w_o));
    return o * act_tanh(next_c);
}

// -------------------------------------------------------------------
// GRU Cell: reset gate (r) and update gate (z)
// -------------------------------------------------------------------

pub type GRUCell = struct {
    in_dim: Int,
    hidden_dim: Int
};

pub fn gru_gate_step(x_v: Float, h_prev_v: Float, w_z: Float, w_r: Float, w_h: Float) -> Float {
    let z = act_sigmoid((x_v * w_z) + (h_prev_v * w_z));
    let r = act_sigmoid((x_v * w_r) + (h_prev_v * w_r));
    let h_cand = act_tanh((x_v * w_h) + (r * h_prev_v * w_h));
    return ((1.0 - z) * h_prev_v) + (z * h_cand);
}
