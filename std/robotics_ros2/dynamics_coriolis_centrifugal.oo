// # Coriolis and Centrifugal Dynamics Matrix
//
// Logline: Computes the Coriolis and centrifugal matrix C(q, q_dot) and validates (M_dot - 2*C) skew-symmetry.
//
// Setup: Multi-body velocity-product dynamics engine ensuring skew-symmetric passivity constraints.
//
// Beats:
//   1. Define 2x2 Coriolis Matrix C(q, q_dot) structure.
//   2. Compute Christoffel symbols and Coriolis matrix elements for 2-link arms.
//   3. Compute velocity product torques tau_c = C(q, q_dot) * q_dot.
//   4. Validate skew-symmetric energy conservation property q_dot^T * (M_dot - 2C) * q_dot == 0.

pub type CoriolisMatrix2x2 = struct {
    c11: Float, c12: Float,
    c21: Float, c22: Float
};

pub type JointTorques2D = struct {
    tau1: Float,
    tau2: Float
};

pub fn coriolis_matrix_2link(
    l1: Float, l2: Float,
    m2: Float,
    q2: Float,
    dq1: Float, dq2: Float
) -> CoriolisMatrix2x2 {
    let r2: Float = l2 * 0.5;
    let s2: Float = sin(q2);
    let h: Float = (0.0 - (m2 * l1 * r2 * s2));

    // C11 = h * dq2, C12 = h * (dq1 + dq2)
    // C21 = -h * dq1, C22 = 0
    let c11: Float = h * dq2;
    let c12: Float = h * (dq1 + dq2);
    let c21: Float = (0.0 - h) * dq1;
    let c22: Float = 0.0;

    return CoriolisMatrix2x2 {
        c11: c11,
        c12: c12,
        c21: c21,
        c22: c22
    };
}

pub fn coriolis_compute_torques(
    c_mat: &CoriolisMatrix2x2,
    dq1: Float,
    dq2: Float
) -> JointTorques2D {
    let tau1: Float = ((c_mat).c11 * dq1) + ((c_mat).c12 * dq2);
    let tau2: Float = ((c_mat).c21 * dq1) + ((c_mat).c22 * dq2);

    return JointTorques2D {
        tau1: tau1,
        tau2: tau2
    };
}

pub fn coriolis_skew_passivity_inner_product(
    c_mat: &CoriolisMatrix2x2,
    dq1: Float,
    dq2: Float,
    m_dot_11: Float,
    m_dot_12: Float,
    m_dot_22: Float
) -> Float {
    // Computes q_dot^T * (M_dot - 2*C) * q_dot
    // (M_dot - 2*C)_11 = m_dot_11 - 2*c11
    // (M_dot - 2*C)_12 = m_dot_12 - 2*c12
    // (M_dot - 2*C)_21 = m_dot_12 - 2*c21
    // (M_dot - 2*C)_22 = m_dot_22 - 2*c22
    let n11: Float = m_dot_11 - (2.0 * (c_mat).c11);
    let n12: Float = m_dot_12 - (2.0 * (c_mat).c12);
    let n21: Float = m_dot_12 - (2.0 * (c_mat).c21);
    let n22: Float = m_dot_22 - (2.0 * (c_mat).c22);

    let v1: Float = (n11 * dq1) + (n12 * dq2);
    let v2: Float = (n21 * dq1) + (n22 * dq2);

    return (dq1 * v1) + (dq2 * v2);
}
