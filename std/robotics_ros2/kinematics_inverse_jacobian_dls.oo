// # Singularity-Robust Damped Least Squares (DLS) Inverse Kinematics
//
// Logline: Solves differential inverse kinematics near kinematic singularities using damped pseudoinverse Jacobian inversion.
//
// Setup: DLS (Levenberg-Marquardt) solver mapping Cartesian tracking error to stable joint increments.
//
// Beats:
//   1. Define 2x2 Jacobian matrix representation and task-space error vector.
//   2. Compute regularized matrix inversion (J * J^T + lambda^2 * I)^(-1).
//   3. Compute damped least squares joint velocity increment delta_q.
//   4. Evaluate residual error convergence and singularity damping index.

pub type Jacobian2x2 = struct {
    j11: Float, j12: Float,
    j21: Float, j22: Float,
};

pub type IKResult2D = struct {
    delta_q1: Float,
    delta_q2: Float,
    residual_norm: Float,
    is_converged: Bool,
};

pub fn jacobian_2x2_new(j11: Float, j12: Float, j21: Float, j22: Float) -> Jacobian2x2 {
    return Jacobian2x2 {
        j11: j11, j12: j12,
        j21: j21, j22: j22,
    };
}

pub fn ik_solve_dls_2x2(
    jac: &Jacobian2x2,
    err_x: Float,
    err_y: Float,
    damping_lambda: Float
) -> IKResult2D {
    // A = J * J^T
    let a11: Float = ((jac).j11 * (jac).j11) + ((jac).j12 * (jac).j12);
    let a12: Float = ((jac).j11 * (jac).j21) + ((jac).j12 * (jac).j22);
    let a21: Float = a12;
    let a22: Float = ((jac).j21 * (jac).j21) + ((jac).j22 * (jac).j22);

    // Regularize with damping: A_damp = A + lambda^2 * I
    let lambda_sq: Float = damping_lambda * damping_lambda;
    let d11: Float = a11 + lambda_sq;
    let d12: Float = a12;
    let d21: Float = a21;
    let d22: Float = a22 + lambda_sq;

    let det: Float = (d11 * d22) - (d12 * d21);
    if det < 0.000001 && det > (0.0 - 0.000001) {
        return IKResult2D {
            delta_q1: 0.0,
            delta_q2: 0.0,
            residual_norm: sqrt((err_x * err_x) + (err_y * err_y)),
            is_converged: false,
        };
    }

    let inv_det: Float = 1.0 / det;
    let inv_d11: Float = d22 * inv_det;
    let inv_d12: Float = (0.0 - d12) * inv_det;
    let inv_d21: Float = (0.0 - d21) * inv_det;
    let inv_d22: Float = d11 * inv_det;

    // v = A_damp^(-1) * err
    let vx: Float = (inv_d11 * err_x) + (inv_d12 * err_y);
    let vy: Float = (inv_d21 * err_x) + (inv_d22 * err_y);

    // delta_q = J^T * v
    let dq1: Float = ((jac).j11 * vx) + ((jac).j21 * vy);
    let dq2: Float = ((jac).j12 * vx) + ((jac).j22 * vy);

    let norm: Float = sqrt((err_x * err_x) + (err_y * err_y));
    return IKResult2D {
        delta_q1: dq1,
        delta_q2: dq2,
        residual_norm: norm,
        is_converged: norm < 0.001,
    };
}
