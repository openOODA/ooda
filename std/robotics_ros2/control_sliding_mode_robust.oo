// # Robust Sliding Mode Control with Boundary Layer Chattering Reduction
//
// Logline: Implements sliding mode variable structure control with continuous boundary layer saturation against model uncertainties.
//
// Setup: Robust non-linear tracking controller maintaining invariant convergence onto the sliding manifold s = 0.
//
// Beats:
//   1. Define Sliding Surface s = de + lambda * e.
//   2. Compute equivalent control effort u_eq along the sliding manifold.
//   3. Compute discontinuous robust switching effort u_sw = -K * sat(s / epsilon).
//   4. Smooth high-frequency control chattering using continuous boundary layer interpolation.

pub type SlidingModeConfig = struct {
    lambda_surface: Float,
    k_robust_gain: Float,
    boundary_layer_eps: Float,
    max_effort: Float,
};

pub type SlidingModeResult = struct {
    surface_val: Float,
    control_effort: Float,
    is_in_boundary: Bool,
};

pub fn sliding_mode_config_new(
    lambda_val: Float,
    k_gain: Float,
    eps: Float,
    max_u: Float
) -> SlidingModeConfig {
    return SlidingModeConfig {
        lambda_surface: lambda_val,
        k_robust_gain: k_gain,
        boundary_layer_eps: if eps < 0.001 { 0.001 } else { eps },
        max_effort: max_u,
    };
}

pub fn sliding_mode_saturation(s: Float, eps: Float) -> Float {
    let ratio: Float = s / eps;
    if ratio > 1.0 {
        return 1.0;
    }
    if ratio < (0.0 - 1.0) {
        return -1.0;
    }
    return ratio;
}

pub fn sliding_mode_compute(
    cfg: &SlidingModeConfig,
    q_des: Float, dq_des: Float, ddq_des: Float,
    q_curr: Float, dq_curr: Float
) -> SlidingModeResult {
    let e: Float = q_des - q_curr;
    let de: Float = dq_des - dq_curr;

    // Sliding manifold surface s = de + lambda * e
    let s: Float = de + ((cfg).lambda_surface * e);

    // Equivalent acceleration command: a_eq = ddq_des + lambda * de
    let a_eq: Float = ddq_des + ((cfg).lambda_surface * de);

    // Robust switching control with boundary layer smoothing
    let sat_s: Float = sliding_mode_saturation(s, (cfg).boundary_layer_eps);
    let u_sw: Float = (cfg).k_robust_gain * sat_s;

    let u_total: Float = a_eq + u_sw;

    let mut u_clamped: Float = u_total;
    if u_clamped > (cfg).max_effort {
        u_clamped = (cfg).max_effort;
    }
    let min_u: Float = 0.0 - (cfg).max_effort;
    if u_clamped < min_u {
        u_clamped = min_u;
    }

    let abs_s: Float = if s < 0.0 { 0.0 - s } else { s };
    let in_layer: Bool = abs_s <= (cfg).boundary_layer_eps;

    return SlidingModeResult {
        surface_val: s,
        control_effort: u_clamped,
        is_in_boundary: in_layer,
    };
}
