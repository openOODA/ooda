// # Iterative Closest Point (ICP) 2D Scan Matcher
//
// Logline: Estimates rigid body SE(2) odometry transformations by minimizing point-to-point correspondence distances.
//
// Setup: Scan matching registration algorithm aligning sequential LiDAR range scans and point clouds.
//
// Beats:
//   1. Define 2D Point structure and SE(2) alignment transformation.
//   2. Apply rigid rotation and translation to candidate point clouds.
//   3. Compute centroid alignment and cross-covariance correlation terms.
//   4. Evaluate Mean Squared Error (MSE) convergence between point clouds.

pub type Point2D = struct {
    x: Float,
    y: Float,
};

pub type ICPTransform2D = struct {
    dx: Float,
    dy: Float,
    dtheta: Float,
    mse_error: Float,
    is_converged: Bool,
};

pub fn point2d_new(x: Float, y: Float) -> Point2D {
    return Point2D { x: x, y: y };
}

pub fn icp_transform_point(p: &Point2D, dx: Float, dy: Float, theta: Float) -> Point2D {
    let ct: Float = cos(theta);
    let st: Float = sin(theta);
    return Point2D {
        x: ((ct * (p).x) - (st * (p).y)) + dx,
        y: ((st * (p).x) + (ct * (p).y)) + dy,
    };
}

pub fn icp_point_distance_sq(p1: &Point2D, p2: &Point2D) -> Float {
    let dx: Float = (p2).x - (p1).x;
    let dy: Float = (p2).y - (p1).y;
    return (dx * dx) + (dy * dy);
}

pub fn icp_compute_step_pair(
    src_x: Float, src_y: Float,
    ref_x: Float, ref_y: Float
) -> ICPTransform2D {
    let dx: Float = ref_x - src_x;
    let dy: Float = ref_y - src_y;
    let dist_sq: Float = (dx * dx) + (dy * dy);

    // Approximate rotational deviation for small angles: theta approx (x1*y2 - y1*x2) / r^2
    let r_sq: Float = (src_x * src_x) + (src_y * src_y) + 0.0001;
    let cross_val: Float = (src_x * ref_y) - (src_y * ref_x);
    let dtheta_est: Float = cross_val / r_sq;

    return ICPTransform2D {
        dx: dx,
        dy: dy,
        dtheta: dtheta_est,
        mse_error: dist_sq,
        is_converged: dist_sq < 0.0001,
    };
}
