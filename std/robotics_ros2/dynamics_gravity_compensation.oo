// # Joint-Space Gravitational Load & Compensation
//
// Logline: Calculates potential energy gradients and feedforward gravitational cancellation torques G(q).
//
// Setup: Model-based gravitational compensation engine for serial articulated robot manipulators.
//
// Beats:
//   1. Evaluate link center-of-mass positions under current joint configuration.
//   2. Compute total gravitational potential energy V(q).
//   3. Differentiate potential energy to obtain joint gravity torques G(q) = dV/dq.
//   4. Generate feedforward gravity cancellation signals for zero-effort payload float.

import "./dynamics_coriolis_centrifugal.oo";

pub type GravityModel2Link = struct {
    l1: Float,
    l2: Float,
    m1: Float,
    m2: Float,
    gravity_accel: Float, // Typically 9.80665 m/s^2
};

pub fn gravity_model_2link_new(
    l1: Float, l2: Float,
    m1: Float, m2: Float,
    g: Float
) -> GravityModel2Link {
    return GravityModel2Link {
        l1: l1,
        l2: l2,
        m1: m1,
        m2: m2,
        gravity_accel: g,
    };
}

pub fn gravity_compensation_2link(
    model: &GravityModel2Link,
    q1: Float,
    q2: Float
) -> JointTorques2D {
    let r1: Float = (model).l1 * 0.5;
    let r2: Float = (model).l2 * 0.5;
    let g: Float = (model).gravity_accel;
    let m1: Float = (model).m1;
    let m2: Float = (model).m2;
    let l1: Float = (model).l1;

    let g1: Float = g * (((m1 * r1) + (m2 * l1)) * cos(q1) + (m2 * r2 * cos(q1 + q2)));
    let g2: Float = g * (m2 * r2 * cos(q1 + q2));

    return JointTorques2D {
        tau1: g1,
        tau2: g2,
    };
}

pub fn gravity_potential_energy_2link(
    model: &GravityModel2Link,
    q1: Float,
    q2: Float
) -> Float {
    let r1: Float = (model).l1 * 0.5;
    let r2: Float = (model).l2 * 0.5;
    let g: Float = (model).gravity_accel;
    let m1: Float = (model).m1;
    let m2: Float = (model).m2;
    let l1: Float = (model).l1;

    let h1: Float = r1 * sin(q1);
    let h2: Float = (l1 * sin(q1)) + (r2 * sin(q1 + q2));

    return ((m1 * g) * h1) + ((m2 * g) * h2);
}
