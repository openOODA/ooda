// # Time-Optimal Path Parameterization (TOPP)
//
// Logline: Calculates maximum admissible velocity and acceleration curves along geometric paths under actuator limits.
//
// Setup: Optimal trajectory reparameterization converting geometric paths s in [0, 1] to time-parameterized trajectories.
//
// Beats:
//   1. Define Path segment derivative properties (dq/ds, d2q/ds2).
//   2. Compute maximum allowable path velocity s_dot_max subject to joint velocity bounds.
//   3. Compute path acceleration limits (s_ddot_min, s_ddot_max) subject to joint torque bounds.
//   4. Integrate forward acceleration profile and clamp velocity limit curves.

pub type ToppPathSegment = struct {
    s_start: Float,
    s_end: Float,
    dq_ds_norm: Float,
    d2q_ds2_norm: Float
};

pub type ToppVelocityBound = struct {
    s_dot_limit: Float,
    s_ddot_max: Float,
    s_ddot_min: Float
};

pub fn topp_path_segment_new(
    s0: Float, s1: Float,
    dq_norm: Float,
    d2q_norm: Float
) -> ToppPathSegment {
    return ToppPathSegment {
        s_start: s0,
        s_end: s1,
        dq_ds_norm: dq_norm,
        d2q_ds2_norm: d2q_norm
    };
}

pub fn topp_compute_velocity_limit(
    seg: &ToppPathSegment,
    max_joint_vel: Float,
    max_joint_acc: Float
) -> ToppVelocityBound {
    let dq: Float = (seg).dq_ds_norm;
    let d2q: Float = (seg).d2q_ds2_norm;

    // Joint velocity constraint: |dq/ds * s_dot| <= v_max  => s_dot <= v_max / |dq/ds|
    let v_limit: Float = if dq > 0.0001 {
        max_joint_vel / dq
    } else {
        max_joint_vel * 100.0
    };

    // Joint acceleration constraint: |dq/ds * s_ddot + d2q/ds2 * s_dot^2| <= a_max
    let a_max_val: Float = if dq > 0.0001 {
        max_joint_acc / dq
    } else {
        max_joint_acc * 100.0
    };

    return ToppVelocityBound {
        s_dot_limit: v_limit,
        s_ddot_max: a_max_val,
        s_ddot_min: 0.0 - a_max_val
    };
}

pub fn topp_integrate_step(
    current_s_dot: Float,
    s_ddot: Float,
    ds: Float
) -> Float {
    // s_dot_next^2 = s_dot_curr^2 + 2 * s_ddot * ds
    let s_dot_sq: Float = (current_s_dot * current_s_dot) + (2.0 * s_ddot * ds);
    if s_dot_sq < 0.0 {
        return 0.0;
    }
    return sqrt(s_dot_sq);
}
