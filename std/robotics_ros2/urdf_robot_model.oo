// # Unified Robot Description Format (URDF) Model
//
// Logline: Represents articulated robot topologies with rigid link inertials, kinematic joint types, and relative origins.
//
// Setup: Pure kinematic and dynamic robot description model matching URDF specifications.
//
// Beats:
//   1. Define 3D Inertial properties (mass, center-of-mass, inertia tensor).
//   2. Define URDF Joint types (Revolute, Prismatic, Continuous, Fixed, Floating).
//   3. Define URDF Link definitions with inertial parameters.
//   4. Construct Robot Model container tracking link count and cumulative mass.

import "./tf2_spatial_transform.oo";

type UrdfInertial = struct {
    mass: Float,
    com: Vector3,
    ixx: Float,
    iyy: Float,
    izz: Float,
    ixy: Float,
    ixz: Float,
    iyz: Float,
};

type UrdfJoint = struct {
    joint_id: Int,
    parent_link_id: Int,
    child_link_id: Int,
    joint_type: Int, // 0=Revolute, 1=Continuous, 2=Prismatic, 3=Fixed, 4=Floating, 5=Planar
    axis: Vector3,
    origin: Transform3D,
};

type UrdfLink = struct {
    link_id: Int,
    parent_joint_id: Int,
    inertial: UrdfInertial,
};

type UrdfRobotModel = struct {
    model_id: Int,
    link_count: Int,
    joint_count: Int,
    total_mass: Float,
};

pub fn urdf_inertial_new(
    mass: Float,
    cx: Float, cy: Float, cz: Float,
    ixx: Float, iyy: Float, izz: Float
) -> UrdfInertial {
    return UrdfInertial {
        mass: mass,
        com: vector3_new(cx, cy, cz),
        ixx: ixx,
        iyy: iyy,
        izz: izz,
        ixy: 0.0,
        ixz: 0.0,
        iyz: 0.0,
    };
}

pub fn urdf_joint_new(
    joint_id: Int,
    parent_id: Int,
    child_id: Int,
    joint_type: Int,
    axis: Vector3,
    origin: Transform3D
) -> UrdfJoint {
    return UrdfJoint {
        joint_id: joint_id,
        parent_link_id: parent_id,
        child_link_id: child_id,
        joint_type: joint_type,
        axis: axis,
        origin: origin,
    };
}

pub fn urdf_link_new(link_id: Int, parent_joint_id: Int, inertial: UrdfInertial) -> UrdfLink {
    return UrdfLink {
        link_id: link_id,
        parent_joint_id: parent_joint_id,
        inertial: inertial,
    };
}

pub fn urdf_robot_model_new(model_id: Int) -> UrdfRobotModel {
    return UrdfRobotModel {
        model_id: model_id,
        link_count: 0,
        joint_count: 0,
        total_mass: 0.0,
    };
}

pub fn urdf_robot_model_add_link(model: &mut UrdfRobotModel, link: &UrdfLink) -> Int {
    (model).link_count = (model).link_count + 1;
    (model).total_mass = (model).total_mass + (link).inertial.mass;
    return (model).link_count;
}

pub fn urdf_robot_model_add_joint(model: &mut UrdfRobotModel, joint: &UrdfJoint) -> Int {
    (model).joint_count = (model).joint_count + 1;
    return (model).joint_count;
}
