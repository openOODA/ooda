// # Hierarchical Octree 3D Voxel Map
//
// Logline: Indexes 3D point clouds and spatial obstacles using a hierarchical octree for raycasting and clearance queries.
//
// Setup: Spatial indexing engine decomposing 3D volumes into recursive octant subdivisions.
//
// Beats:
//   1. Define Octree Node structure (center coordinates, edge size, occupancy state).
//   2. Determine child octant index (0-7) for spatial point queries.
//   3. Compute octant sub-bounding boxes for recursive subdivision.
//   4. Evaluate raycast step intersection through occupied voxel volumes.

import "./collision_fcl_aabb_tree.oo";

pub type OctreeNode = struct {
    center_x: Float,
    center_y: Float,
    center_z: Float,
    half_size: Float,
    occupancy_prob: Float, // [0.0 = free, 1.0 = fully occupied]
    is_leaf: Bool,
    child_mask: Int // Bitmask of allocated children (0-255)
};

pub type OctreeConfig = struct {
    resolution_m: Float,
    max_depth: Int,
    occupancy_threshold: Float
};

pub fn octree_node_new(cx: Float, cy: Float, cz: Float, half_size: Float) -> OctreeNode {
    return OctreeNode {
        center_x: cx,
        center_y: cy,
        center_z: cz,
        half_size: half_size,
        occupancy_prob: 0.5,
        is_leaf: true,
        child_mask: 0
    };
}

pub fn octree_config_default() -> OctreeConfig {
    return OctreeConfig {
        resolution_m: 0.05,
        max_depth: 16,
        occupancy_threshold: 0.65
    };
}

pub fn octree_get_child_index(node: &OctreeNode, px: Float, py: Float, pz: Float) -> Int {
    let mut idx: Int = 0;
    if px >= (node).center_x {
        idx = idx + 1;
    }
    if py >= (node).center_y {
        idx = idx + 2;
    }
    if pz >= (node).center_z {
        idx = idx + 4;
    }
    return idx;
}

pub fn octree_is_occupied(node: &OctreeNode, threshold: Float) -> Bool {
    return (node).occupancy_prob >= threshold;
}

pub fn octree_update_log_odds(node: &mut OctreeNode, hit: Bool) -> Float {
    let delta: Float = if hit { 0.15 } else { -0.10 };
    let mut prob: Float = (node).occupancy_prob + delta;
    if prob < 0.01 { prob = 0.01; }
    if prob > 0.99 { prob = 0.99; }
    (node).occupancy_prob = prob;
    return prob;
}
