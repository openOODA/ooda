// # SLAM Loop Closure Detection & Hypothesis Verification
//
// Logline: Detects topological loop closures across historical keyframes and validates geometric consistency.
//
// Setup: Loop closure validation engine screening candidate loop edges before factor graph injection.
//
// Beats:
//   1. Define Loop Closure Candidate and Detector configuration parameters.
//   2. Filter candidate keyframes by spatial distance and graph index separation.
//   3. Compute descriptor correlation scores and spatial alignment quality.
//   4. Validate loop hypothesis gating thresholds to eliminate false positive loop closures.

import "./slam_graph_g2o_factor.oo";

pub type LoopCandidate = struct {
    query_keyframe_id: Int,
    match_keyframe_id: Int,
    spatial_distance: Float,
    descriptor_similarity: Float,
    is_accepted: Bool
};

pub type LoopDetectorConfig = struct {
    min_keyframe_separation: Int,
    max_search_radius_m: Float,
    min_similarity_score: Float
};

pub fn loop_detector_config_default() -> LoopDetectorConfig {
    return LoopDetectorConfig {
        min_keyframe_separation: 30, // Require at least 30 keyframes separation
        max_search_radius_m: 5.0,    // Search within 5 meters
        min_similarity_score: 0.75
    };
}

pub fn loop_candidate_new(
    q_id: Int, m_id: Int,
    dist: Float, score: Float
) -> LoopCandidate {
    return LoopCandidate {
        query_keyframe_id: q_id,
        match_keyframe_id: m_id,
        spatial_distance: dist,
        descriptor_similarity: score,
        is_accepted: false
    };
}

pub fn loop_detector_evaluate_pair(
    cfg: &LoopDetectorConfig,
    v_curr: &Pose2DVertex,
    v_cand: &Pose2DVertex,
    similarity_score: Float
) -> LoopCandidate {
    let separation: Int = (v_curr).id - (v_cand).id;
    let abs_sep: Int = if separation < 0 { 0 - separation } else { separation };

    if abs_sep < (cfg).min_keyframe_separation {
        return LoopCandidate {
            query_keyframe_id: (v_curr).id,
            match_keyframe_id: (v_cand).id,
            spatial_distance: 1000000.0,
            descriptor_similarity: 0.0,
            is_accepted: false
        };
    }

    let dx: Float = (v_cand).x - (v_curr).x;
    let dy: Float = (v_cand).y - (v_curr).y;
    let dist: Float = sqrt((dx * dx) + (dy * dy));

    let is_valid: Bool = (dist <= (cfg).max_search_radius_m) && (similarity_score >= (cfg).min_similarity_score);

    return LoopCandidate {
        query_keyframe_id: (v_curr).id,
        match_keyframe_id: (v_cand).id,
        spatial_distance: dist,
        descriptor_similarity: similarity_score,
        is_accepted: is_valid
    };
}
