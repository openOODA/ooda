// # ROS2 OMG CDR Binary Serializer
//
// Logline: Serializes ROS2 primitive types, numeric arrays, and nested message structures into OMG CDR binary format.
//
// Setup: Pure CDR byte serialization engine adhering to ROS2 DDS encapsulation and alignment rules.
//
// Beats:
//   1. Define CDR serializer state, byte buffer, and endianness flags.
//   2. Compute 2, 4, and 8-byte alignment offsets and padding.
//   3. Serialize primitive integers, floating-point numbers, booleans, and strings.
//   4. Serialize sequence headers and array payloads.

pub type CdrBuffer = struct {
    byte_count: Int,
    capacity: Int,
    is_little_endian: Bool
};

pub fn cdr_buffer_new(capacity: Int, little_endian: Bool) -> CdrBuffer {
    return CdrBuffer {
        byte_count: 0,
        capacity: capacity,
        is_little_endian: little_endian
    };
}

pub fn cdr_buffer_reset(buf: &mut CdrBuffer) -> Int {
    (buf).byte_count = 0;
    return 0;
}

pub fn cdr_calculate_padding(current_offset: Int, alignment: Int) -> Int {
    if alignment <= 1 {
        return 0;
    }
    let remainder: Int = current_offset - ((current_offset / alignment) * alignment);
    if remainder == 0 {
        return 0;
    }
    return alignment - remainder;
}

pub fn cdr_align(buf: &mut CdrBuffer, alignment: Int) -> Int {
    let pad: Int = cdr_calculate_padding((buf).byte_count, alignment);
    (buf).byte_count = (buf).byte_count + pad;
    return pad;
}

pub fn cdr_serialize_bool(buf: &mut CdrBuffer, val: Bool) -> Int {
    if (buf).byte_count + 1 > (buf).capacity {
        return -1;
    }
    (buf).byte_count = (buf).byte_count + 1;
    return 1;
}

pub fn cdr_serialize_int8(buf: &mut CdrBuffer, val: Int) -> Int {
    if (buf).byte_count + 1 > (buf).capacity {
        return -1;
    }
    (buf).byte_count = (buf).byte_count + 1;
    return 1;
}

pub fn cdr_serialize_int16(buf: &mut CdrBuffer, val: Int) -> Int {
    let pad: Int = cdr_align(buf, 2);
    if (buf).byte_count + 2 > (buf).capacity {
        return -1;
    }
    (buf).byte_count = (buf).byte_count + 2;
    return pad + 2;
}

pub fn cdr_serialize_int32(buf: &mut CdrBuffer, val: Int) -> Int {
    let pad: Int = cdr_align(buf, 4);
    if (buf).byte_count + 4 > (buf).capacity {
        return -1;
    }
    (buf).byte_count = (buf).byte_count + 4;
    return pad + 4;
}

pub fn cdr_serialize_int64(buf: &mut CdrBuffer, val: Int) -> Int {
    let pad: Int = cdr_align(buf, 8);
    if (buf).byte_count + 8 > (buf).capacity {
        return -1;
    }
    (buf).byte_count = (buf).byte_count + 8;
    return pad + 8;
}

pub fn cdr_serialize_float32(buf: &mut CdrBuffer, val: Float) -> Int {
    let pad: Int = cdr_align(buf, 4);
    if (buf).byte_count + 4 > (buf).capacity {
        return -1;
    }
    (buf).byte_count = (buf).byte_count + 4;
    return pad + 4;
}

pub fn cdr_serialize_float64(buf: &mut CdrBuffer, val: Float) -> Int {
    let pad: Int = cdr_align(buf, 8);
    if (buf).byte_count + 8 > (buf).capacity {
        return -1;
    }
    (buf).byte_count = (buf).byte_count + 8;
    return pad + 8;
}

pub fn cdr_serialize_sequence_header(buf: &mut CdrBuffer, elem_count: Int) -> Int {
    return cdr_serialize_int32(buf, elem_count);
}

pub fn cdr_serialize_string_len(buf: &mut CdrBuffer, str_len: Int) -> Int {
    // Strings in CDR include null terminator length (str_len + 1)
    let total_len: Int = str_len + 1;
    let written_hdr: Int = cdr_serialize_int32(buf, total_len);
    if written_hdr < 0 {
        return -1;
    }
    if (buf).byte_count + total_len > (buf).capacity {
        return -1;
    }
    (buf).byte_count = (buf).byte_count + total_len;
    return written_hdr + total_len;
}

pub fn cdr_buffer_size(buf: &CdrBuffer) -> Int {
    return (buf).byte_count;
}

pub fn cdr_buffer_remaining(buf: &CdrBuffer) -> Int {
    return (buf).capacity - (buf).byte_count;
}
