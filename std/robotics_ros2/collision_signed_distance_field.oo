// # Euclidean Signed Distance Field (ESDF) & Distance Gradients
//
// Logline: Interpolates 3D Signed Distance Fields and computes analytical spatial obstacle gradients for trajectory optimization.
//
// Setup: Continuous distance field engine providing gradient vectors grad(Phi(x)) for collision-free motion planning.
//
// Beats:
//   1. Define 3D SDF Voxel Grid parameters and spatial coordinate origin.
//   2. Transform query points from world coordinates to local voxel indices.
//   3. Trilinearly interpolate continuous distance values between neighboring voxel corners.
//   4. Calculate finite-difference spatial distance gradient vectors grad(Phi(x)).

import "./tf2_spatial_transform.oo";

pub type SDFVoxelGrid = struct {
    dim_x: Int,
    dim_y: Int,
    dim_z: Int,
    voxel_size: Float,
    origin: Vector3,
};

pub type SDFSampleResult = struct {
    distance: Float,
    gradient: Vector3,
    is_inside_obstacle: Bool,
};

pub fn sdf_voxel_grid_new(
    dim_x: Int, dim_y: Int, dim_z: Int,
    voxel_size: Float,
    origin: Vector3
) -> SDFVoxelGrid {
    return SDFVoxelGrid {
        dim_x: dim_x,
        dim_y: dim_y,
        dim_z: dim_z,
        voxel_size: voxel_size,
        origin: origin,
    };
}

pub fn sdf_world_to_grid_float(
    grid: &SDFVoxelGrid,
    world_p: &Vector3
) -> Vector3 {
    let inv_size: Float = 1.0 / (grid).voxel_size;
    return Vector3 {
        x: ((world_p).x - (grid).origin.x) * inv_size,
        y: ((world_p).y - (grid).origin.y) * inv_size,
        z: ((world_p).z - (grid).origin.z) * inv_size,
    };
}

pub fn sdf_trilinear_interp(
    d000: Float, d100: Float, d010: Float, d110: Float,
    d001: Float, d101: Float, d011: Float, d111: Float,
    u: Float, v: Float, w: Float
) -> Float {
    let c00: Float = (d000 * (1.0 - u)) + (d100 * u);
    let c10: Float = (d010 * (1.0 - u)) + (d110 * u);
    let c01: Float = (d001 * (1.0 - u)) + (d101 * u);
    let c11: Float = (d011 * (1.0 - u)) + (d111 * u);

    let c0: Float = (c00 * (1.0 - v)) + (c10 * v);
    let c1: Float = (c01 * (1.0 - v)) + (c11 * v);

    return (c0 * (1.0 - w)) + (c1 * w);
}

pub fn sdf_estimate_gradient_from_samples(
    d_x_pos: Float, d_x_neg: Float,
    d_y_pos: Float, d_y_neg: Float,
    d_z_pos: Float, d_z_neg: Float,
    delta: Float
) -> Vector3 {
    let inv_2d: Float = 1.0 / ((2.0 * delta) + 0.000001);
    return Vector3 {
        x: (d_x_pos - d_x_neg) * inv_2d,
        y: (d_y_pos - d_y_neg) * inv_2d,
        z: (d_z_pos - d_z_neg) * inv_2d,
    };
}
