// # TF2 Static Transform Broadcaster
//
// Logline: Latches and publishes static coordinate frame transforms for invariant robot base, sensor mount, and link frames.
//
// Setup: Coordinate frame registry for static kinematic relationships across the robot model.
//
// Beats:
//   1. Define StaticTransformBroadcaster storage and capacity constraints.
//   2. Register latched static transform frames between robot components.
//   3. Validate static transform frame integrity against self-loops.
//   4. Export static frame count and status diagnostics.

import "./tf2_spatial_transform.oo";
import "./tf2_transform_broadcaster.oo";

pub type StaticTransformBroadcaster = struct {
    registered_count: Int,
    max_capacity: Int,
    is_active: Bool,
};

pub fn static_broadcaster_new(max_capacity: Int) -> StaticTransformBroadcaster {
    return StaticTransformBroadcaster {
        registered_count: 0,
        max_capacity: max_capacity,
        is_active: true,
    };
}

pub fn static_broadcaster_register(
    broadcaster: &mut StaticTransformBroadcaster,
    parent_id: Int,
    child_id: Int,
    transform: Transform3D
) -> Bool {
    if !(broadcaster).is_active {
        return false;
    }
    // Prevent self-loop transform registration
    if parent_id == child_id {
        return false;
    }
    if (broadcaster).registered_count >= (broadcaster).max_capacity {
        return false;
    }
    (broadcaster).registered_count = (broadcaster).registered_count + 1;
    return true;
}

pub fn static_broadcaster_is_full(broadcaster: &StaticTransformBroadcaster) -> Bool {
    return (broadcaster).registered_count >= (broadcaster).max_capacity;
}

pub fn static_broadcaster_count(broadcaster: &StaticTransformBroadcaster) -> Int {
    return (broadcaster).registered_count;
}
