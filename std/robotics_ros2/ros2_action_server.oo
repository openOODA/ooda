// # ROS2 Action Server State Machine
//
// Logline: Implements the ROS2 action execution lifecycle, handling goal acceptance, feedback, cancellation, and terminal states.
//
// Setup: Pure state machine enforcing standard ROS2 action goal state transitions.
//
// Beats:
//   1. Define Action goal states (Accepted, Executing, Canceling, Succeeded, Canceled, Aborted).
//   2. Manage goal acceptance and transition to execution.
//   3. Stream periodic action feedback updates to clients.
//   4. Handle goal cancellation requests and resolve terminal outcomes.

pub type ActionServer = struct {
    action_id: Int,
    current_goal_id: Int,
    state: Int, // 0=Idle, 1=Accepted, 2=Executing, 3=Canceling, 4=Succeeded, 5=Canceled, 6=Aborted
    feedback_count: Int,
    is_active: Bool,
};

pub fn action_server_new(action_id: Int) -> ActionServer {
    return ActionServer {
        action_id: action_id,
        current_goal_id: 0,
        state: 0, // Idle
        feedback_count: 0,
        is_active: true,
    };
}

pub fn action_server_accept_goal(server: &mut ActionServer, goal_id: Int) -> Bool {
    // Only accept if currently Idle or in a terminal state (>= 4)
    if (server).state != 0 && (server).state < 4 {
        return false; // Busy executing another goal
    }
    (server).current_goal_id = goal_id;
    (server).state = 1; // Accepted
    (server).feedback_count = 0;
    return true;
}

pub fn action_server_start_executing(server: &mut ActionServer) -> Bool {
    if (server).state != 1 {
        return false;
    }
    (server).state = 2; // Executing
    return true;
}

pub fn action_server_publish_feedback(server: &mut ActionServer) -> Bool {
    if (server).state != 2 && (server).state != 3 {
        return false;
    }
    (server).feedback_count = (server).feedback_count + 1;
    return true;
}

pub fn action_server_request_cancel(server: &mut ActionServer) -> Bool {
    if (server).state == 2 {
        (server).state = 3; // Canceling
        return true;
    }
    return false;
}

pub fn action_server_succeed(server: &mut ActionServer) -> Bool {
    if (server).state != 2 {
        return false;
    }
    (server).state = 4; // Succeeded
    return true;
}

pub fn action_server_cancel(server: &mut ActionServer) -> Bool {
    if (server).state != 3 {
        return false;
    }
    (server).state = 5; // Canceled
    return true;
}

pub fn action_server_abort(server: &mut ActionServer) -> Bool {
    if (server).state != 2 && (server).state != 3 {
        return false;
    }
    (server).state = 6; // Aborted
    return true;
}

pub fn action_server_is_terminal(server: &ActionServer) -> Bool {
    return (server).state >= 4 || (server).state == 0;
}
