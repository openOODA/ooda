// # 6-Axis Admittance Force & Torque Controller
//
// Logline: Converts 6-DoF measured contact wrenches into compliant Cartesian trajectory offsets for position-controlled manipulators.
//
// Setup: Multi-axis admittance force control engine for robotic deburring, polishing, and peg-in-hole assembly.
//
// Beats:
//   1. Define 6D Spatial Wrench (force, torque) and 6-axis Admittance gains.
//   2. Maintain 6-DoF admittance state (Cartesian displacement and velocity).
//   3. Integrate decoupled translational and rotational admittance dynamics.
//   4. Apply wrench deadband thresholds to prevent sensor drift drift-away.

import "./tf2_spatial_transform.oo";

pub type Wrench6D = struct {
    fx: Float, fy: Float, fz: Float,
    tx: Float, ty: Float, tz: Float,
};

pub type AdmittanceGains6D = struct {
    m_trans: Float, d_trans: Float, k_trans: Float,
    m_rot: Float, d_rot: Float, k_rot: Float,
    force_deadband: Float,
    torque_deadband: Float,
};

pub type AdmittanceState6D = struct {
    dx: Float, dy: Float, dz: Float,
    vx: Float, vy: Float, vz: Float,
    d_rx: Float, d_ry: Float, d_rz: Float,
    w_rx: Float, w_ry: Float, w_rz: Float,
};

pub fn wrench6d_new(fx: Float, fy: Float, fz: Float, tx: Float, ty: Float, tz: Float) -> Wrench6D {
    return Wrench6D {
        fx: fx, fy: fy, fz: fz,
        tx: tx, ty: ty, tz: tz,
    };
}

pub fn admittance_gains6d_default() -> AdmittanceGains6D {
    return AdmittanceGains6D {
        m_trans: 5.0,
        d_trans: 50.0,
        k_trans: 100.0,
        m_rot: 0.5,
        d_rot: 5.0,
        k_rot: 10.0,
        force_deadband: 0.5,
        torque_deadband: 0.05,
    };
}

pub fn admittance_state6d_zero() -> AdmittanceState6D {
    return AdmittanceState6D {
        dx: 0.0, dy: 0.0, dz: 0.0,
        vx: 0.0, vy: 0.0, vz: 0.0,
        d_rx: 0.0, d_ry: 0.0, d_rz: 0.0,
        w_rx: 0.0, w_ry: 0.0, w_rz: 0.0,
    };
}

pub fn admittance_filter_wrench_axis(
    disp: Float, vel: Float,
    force: Float, deadband: Float,
    m: Float, d: Float, k: Float,
    dt: Float
) -> Vector3 {
    let mut f_net: Float = force;
    if f_net < deadband && f_net > (0.0 - deadband) {
        f_net = 0.0;
    }

    let inv_m: Float = 1.0 / (if m < 0.01 { 0.01 } else { m });
    let acc: Float = (f_net - (d * vel) - (k * disp)) * inv_m;
    let next_vel: Float = vel + (acc * dt);
    let next_disp: Float = disp + (next_vel * dt);

    return Vector3 { x: next_disp, y: next_vel, z: acc };
}
