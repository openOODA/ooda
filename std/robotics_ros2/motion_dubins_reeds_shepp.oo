// # Dubins & Reeds-Shepp Non-Holonomic Path Curves
//
// Logline: Computes shortest analytical curvature-constrained curves (LSL, RSR, LSR, RSL) for non-holonomic mobile robots.
//
// Setup: Closed-form path generator for non-holonomic wheeled platforms with minimum turning radius bounds.
//
// Beats:
//   1. Define Dubins word structures (LSL, RSR, LSR, RSL) and minimum turning radius.
//   2. Compute normalized start-to-goal coordinate frames.
//   3. Solve LSL and RSR tangent circle geometry and segment arc lengths.
//   4. Sample intermediate (x, y, yaw) waypoints along Dubins curve segments.

pub type DubinsPath = struct {
    total_length: Float,
    length1: Float, // First arc/straight segment
    length2: Float, // Second segment
    length3: Float, // Third segment
    path_type: Int, // 0=LSL, 1=RSR, 2=LSR, 3=RSL
    is_valid: Bool,
};

pub type DubinsState2D = struct {
    x: Float,
    y: Float,
    yaw: Float,
};

pub fn dubins_state_new(x: Float, y: Float, yaw: Float) -> DubinsState2D {
    return DubinsState2D { x: x, y: y, yaw: yaw };
}

pub fn dubins_plan_lsl(
    dx: Float,
    dy: Float,
    alpha: Float,
    beta: Float,
    rho: Float
) -> DubinsPath {
    let d: Float = sqrt((dx * dx) + (dy * dy)) / rho;
    let sa: Float = sin(alpha);
    let sb: Float = sin(beta);
    let ca: Float = cos(alpha);
    let cb: Float = cos(beta);

    let p_sq: Float = 2.0 + (d * d) - (2.0 * ((ca * cb) + (sa * sb))) + (2.0 * d * (sa - sb));
    if p_sq < 0.0 {
        return DubinsPath {
            total_length: 1000000.0,
            length1: 0.0, length2: 0.0, length3: 0.0,
            path_type: 0,
            is_valid: false,
        };
    }

    let p: Float = sqrt(p_sq);
    let len1: Float = alpha;
    let len2: Float = p;
    let len3: Float = beta;

    let tot: Float = (len1 + len2 + len3) * rho;
    return DubinsPath {
        total_length: tot,
        length1: len1 * rho,
        length2: len2 * rho,
        length3: len3 * rho,
        path_type: 0, // LSL
        is_valid: true,
    };
}

pub fn dubins_plan_rsr(
    dx: Float,
    dy: Float,
    alpha: Float,
    beta: Float,
    rho: Float
) -> DubinsPath {
    let d: Float = sqrt((dx * dx) + (dy * dy)) / rho;
    let sa: Float = sin(alpha);
    let sb: Float = sin(beta);
    let ca: Float = cos(alpha);
    let cb: Float = cos(beta);

    let p_sq: Float = 2.0 + (d * d) - (2.0 * ((ca * cb) + (sa * sb))) - (2.0 * d * (sa - sb));
    if p_sq < 0.0 {
        return DubinsPath {
            total_length: 1000000.0,
            length1: 0.0, length2: 0.0, length3: 0.0,
            path_type: 1,
            is_valid: false,
        };
    }

    let p: Float = sqrt(p_sq);
    let len1: Float = 0.0 - alpha;
    let len2: Float = p;
    let len3: Float = 0.0 - beta;

    let tot: Float = (len1 + len2 + len3) * rho;
    return DubinsPath {
        total_length: tot,
        length1: len1 * rho,
        length2: len2 * rho,
        length3: len3 * rho,
        path_type: 1, // RSR
        is_valid: true,
    };
}
