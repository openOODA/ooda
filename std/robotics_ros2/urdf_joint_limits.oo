// # URDF Joint Limits & Safety Controller
//
// Logline: Enforces position, velocity, and effort bounds with safety soft-limit margins for robot joints.
//
// Setup: Pure joint constraint validation and bound-clamping engine.
//
// Beats:
//   1. Define Joint limits structure for physical bounds and safety margins.
//   2. Validate joint position within permissible excursion envelope.
//   3. Clamp command position, velocity, and effort within hardware limits.
//   4. Apply viscous damping and Coulomb friction compensation models.

pub type UrdfJointLimits = struct {
    lower_pos: Float,
    upper_pos: Float,
    max_velocity: Float,
    max_effort: Float,
    safety_margin: Float,
    friction: Float,
    damping: Float,
};

pub fn joint_limits_new(
    lower: Float,
    upper: Float,
    max_vel: Float,
    max_eff: Float,
    margin: Float
) -> UrdfJointLimits {
    return UrdfJointLimits {
        lower_pos: lower,
        upper_pos: upper,
        max_velocity: max_vel,
        max_effort: max_eff,
        safety_margin: margin,
        friction: 0.0,
        damping: 0.1,
    };
}

pub fn joint_limits_is_position_valid(limits: &UrdfJointLimits, pos: Float) -> Bool {
    let min_allowed: Float = (limits).lower_pos + (limits).safety_margin;
    let max_allowed: Float = (limits).upper_pos - (limits).safety_margin;
    return pos >= min_allowed && pos <= max_allowed;
}

pub fn joint_limits_clamp_position(limits: &UrdfJointLimits, pos: Float) -> Float {
    let min_allowed: Float = (limits).lower_pos + (limits).safety_margin;
    let max_allowed: Float = (limits).upper_pos - (limits).safety_margin;
    if pos < min_allowed {
        return min_allowed;
    }
    if pos > max_allowed {
        return max_allowed;
    }
    return pos;
}

pub fn joint_limits_clamp_velocity(limits: &UrdfJointLimits, vel: Float) -> Float {
    let max_v: Float = (limits).max_velocity;
    let min_v: Float = 0.0 - max_v;
    if vel < min_v {
        return min_v;
    }
    if vel > max_v {
        return max_v;
    }
    return vel;
}

pub fn joint_limits_clamp_effort(limits: &UrdfJointLimits, eff: Float) -> Float {
    let max_e: Float = (limits).max_effort;
    let min_e: Float = 0.0 - max_e;
    if eff < min_e {
        return min_e;
    }
    if eff > max_e {
        return max_e;
    }
    return eff;
}

pub fn joint_limits_compute_resistive_torque(limits: &UrdfJointLimits, vel: Float) -> Float {
    let damping_torque: Float = (limits).damping * vel;
    let friction_torque: Float = if vel > 0.001 {
        (limits).friction
    } else if vel < (0.0 - 0.001) {
        0.0 - (limits).friction
    } else {
        0.0
    };
    return damping_torque + friction_torque;
}
