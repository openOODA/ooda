// # Composite Rigid Body Algorithm (CRBA) Joint Inertia Matrix
//
// Logline: Computes the symmetric positive-definite joint-space inertia matrix M(q) via composite subtree recursions.
//
// Setup: Fast multi-body mass matrix solver for forward dynamics and operational space control.
//
// Beats:
//   1. Define 2x2 Joint Inertia Matrix structure.
//   2. Compute composite rigid body inertia elements across articulated links.
//   3. Verify positive definiteness and matrix symmetry (M = M^T > 0).
//   4. Invert inertia matrix M^(-1) for forward dynamics acceleration resolution.

pub type InertiaMatrix2x2 = struct {
    m11: Float, m12: Float,
    m21: Float, m22: Float,
    determinant: Float
};

pub fn crba_inertia_matrix_2link(
    l1: Float, l2: Float,
    m1: Float, m2: Float,
    q2: Float
) -> InertiaMatrix2x2 {
    let r1: Float = l1 * 0.5;
    let r2: Float = l2 * 0.5;
    let c2: Float = cos(q2);

    let m11: Float = (m1 * r1 * r1) + (m2 * ((l1 * l1) + (r2 * r2) + (2.0 * l1 * r2 * c2)));
    let m12: Float = m2 * ((r2 * r2) + (l1 * r2 * c2));
    let m21: Float = m12;
    let m22: Float = m2 * r2 * r2;

    let det: Float = (m11 * m22) - (m12 * m21);

    return InertiaMatrix2x2 {
        m11: m11,
        m12: m12,
        m21: m21,
        m22: m22,
        determinant: det
    };
}

pub fn crba_inertia_invert(mat: &InertiaMatrix2x2) -> InertiaMatrix2x2 {
    let det: Float = (mat).determinant;
    if det < 0.000001 && det > (0.0 - 0.000001) {
        return InertiaMatrix2x2 {
            m11: 0.0, m12: 0.0,
            m21: 0.0, m22: 0.0,
            determinant: 0.0
        };
    }
    let inv_det: Float = 1.0 / det;
    return InertiaMatrix2x2 {
        m11: (mat).m22 * inv_det,
        m12: (0.0 - (mat).m12) * inv_det,
        m21: (0.0 - (mat).m21) * inv_det,
        m22: (mat).m11 * inv_det,
        determinant: inv_det
    };
}

pub fn crba_is_positive_definite(mat: &InertiaMatrix2x2) -> Bool {
    return (mat).m11 > 0.0 && (mat).determinant > 0.0;
}
