// # Quintic (5th-Order) Polynomial Trajectory Generator
//
// Logline: Generates minimum-jerk C2-continuous trajectory profiles satisfying position, velocity, and acceleration boundary conditions.
//
// Setup: Closed-form analytical 5th-degree polynomial interpolation engine for smooth robotic joint and task space motions.
//
// Beats:
//   1. Define Quintic coefficient representation and trajectory evaluation state.
//   2. Compute 6 polynomial coefficients matching start and goal (pos, vel, acc).
//   3. Evaluate instantaneous position, velocity, acceleration, and jerk at query time t.
//   4. Bound trajectory duration and clamp query times within [0, T].

pub type QuinticCoeffs = struct {
    a0: Float, a1: Float, a2: Float,
    a3: Float, a4: Float, a5: Float,
    duration: Float
};

pub type TrajectoryState1D = struct {
    position: Float,
    velocity: Float,
    acceleration: Float,
    jerk: Float
};

pub fn quintic_solve(
    q0: Float, v0: Float, a0_acc: Float,
    q1: Float, v1: Float, a1_acc: Float,
    total_time: Float
) -> QuinticCoeffs {
    let t: Float = if total_time < 0.0001 { 0.0001 } else { total_time };
    let t2: Float = t * t;
    let t3: Float = t2 * t;
    let t4: Float = t3 * t;
    let t5: Float = t4 * t;

    let h: Float = q1 - q0;

    let c0: Float = q0;
    let c1: Float = v0;
    let c2: Float = 0.5 * a0_acc;

    let c3: Float = ((20.0 * h) - (((8.0 * v1) + (12.0 * v0)) * t) - (((3.0 * a0_acc) - a1_acc) * t2)) / (2.0 * t3);
    let c4: Float = (((0.0 - 30.0) * h) + (((14.0 * v1) + (16.0 * v0)) * t) + (((3.0 * a0_acc) - (2.0 * a1_acc)) * t2)) / (2.0 * t4);
    let c5: Float = ((12.0 * h) - ((6.0 * (v1 + v0)) * t) - ((a1_acc - a0_acc) * t2)) / (2.0 * t5);

    return QuinticCoeffs {
        a0: c0, a1: c1, a2: c2,
        a3: c3, a4: c4, a5: c5,
        duration: t
    };
}

pub fn quintic_eval(coeffs: &QuinticCoeffs, query_time: Float) -> TrajectoryState1D {
    let mut t: Float = query_time;
    if t < 0.0 {
        t = 0.0;
    }
    if t > (coeffs).duration {
        t = (coeffs).duration;
    }

    let t2: Float = t * t;
    let t3: Float = t2 * t;
    let t4: Float = t3 * t;
    let t5: Float = t4 * t;

    // s(t) = a0 + a1*t + a2*t^2 + a3*t^3 + a4*t^4 + a5*t^5
    let pos: Float = (coeffs).a0 + ((coeffs).a1 * t) + ((coeffs).a2 * t2) + ((coeffs).a3 * t3) + ((coeffs).a4 * t4) + ((coeffs).a5 * t5);

    // v(t) = a1 + 2*a2*t + 3*a3*t^2 + 4*a4*t^3 + 5*a5*t^4
    let vel: Float = (coeffs).a1 + ((2.0 * (coeffs).a2) * t) + ((3.0 * (coeffs).a3) * t2) + ((4.0 * (coeffs).a4) * t3) + ((5.0 * (coeffs).a5) * t4);

    // a(t) = 2*a2 + 6*a3*t + 12*a4*t^2 + 20*a5*t^3
    let acc: Float = (2.0 * (coeffs).a2) + ((6.0 * (coeffs).a3) * t) + ((12.0 * (coeffs).a4) * t2) + ((20.0 * (coeffs).a5) * t3);

    // j(t) = 6*a3 + 24*a4*t + 60*a5*t^2
    let jerk: Float = (6.0 * (coeffs).a3) + ((24.0 * (coeffs).a4) * t) + ((60.0 * (coeffs).a5) * t2);

    return TrajectoryState1D {
        position: pos,
        velocity: vel,
        acceleration: acc,
        jerk: jerk
    };
}
