// # Recursive Newton-Euler Algorithm (RNEA) Multi-Body Dynamics
//
// Logline: Computes inverse dynamics joint torques in linear O(N) time via outward kinematic and inward spatial force sweeps.
//
// Setup: High-performance recursive multi-body inverse dynamics solver following Featherstone spatial algebra.
//
// Beats:
//   1. Define 6D Spatial Vector (angular, linear) and spatial cross products.
//   2. Outward kinematic sweep propagating body velocities and accelerations from base to tip.
//   3. Compute link spatial inertial forces F_i = I_i * a_i + v_i x* (I_i * v_i).
//   4. Inward kinetic sweep accumulating joint actuation torques tau_i = S_i^T * f_i.

pub type SpatialVector6D = struct {
    wx: Float, wy: Float, wz: Float,
    vx: Float, vy: Float, vz: Float
};

pub type SpatialInertia = struct {
    mass: Float,
    ixx: Float, iyy: Float, izz: Float
};

pub type RneaResult2Link = struct {
    tau1: Float,
    tau2: Float
};

pub fn spatial_vec_zero() -> SpatialVector6D {
    return SpatialVector6D {
        wx: 0.0, wy: 0.0, wz: 0.0,
        vx: 0.0, vy: 0.0, vz: 0.0
    };
}

pub fn spatial_vec_add(a: &SpatialVector6D, b: &SpatialVector6D) -> SpatialVector6D {
    return SpatialVector6D {
        wx: (a).wx + (b).wx,
        wy: (a).wy + (b).wy,
        wz: (a).wz + (b).wz,
        vx: (a).vx + (b).vx,
        vy: (a).vy + (b).vy,
        vz: (a).vz + (b).vz
    };
}

pub fn spatial_inertia_new(m: Float, ixx: Float, iyy: Float, izz: Float) -> SpatialInertia {
    return SpatialInertia { mass: m, ixx: ixx, iyy: iyy, izz: izz };
}

pub fn dynamics_rnea_2link_planar(
    l1: Float, l2: Float,
    m1: Float, m2: Float,
    q1: Float, q2: Float,
    dq1: Float, dq2: Float,
    ddq1: Float, ddq2: Float,
    gravity_y: Float
) -> RneaResult2Link {
    let s2: Float = sin(q2);
    let c2: Float = cos(q2);
    let g: Float = gravity_y;

    // Direct closed-form expansion of Newton-Euler equations for 2-link revolute manipulator
    // Link 1 center of mass r1 = l1/2, Link 2 center of mass r2 = l2/2
    let r1: Float = l1 * 0.5;
    let r2: Float = l2 * 0.5;

    // Joint-space inertia terms
    let m11: Float = (m1 * r1 * r1) + (m2 * ((l1 * l1) + (r2 * r2) + (2.0 * l1 * r2 * c2)));
    let m12: Float = m2 * ((r2 * r2) + (l1 * r2 * c2));
    let m21: Float = m12;
    let m22: Float = m2 * r2 * r2;

    // Coriolis / centrifugal terms
    let h: Float = (0.0 - (m2 * l1 * r2 * s2));
    let c1: Float = (h * (2.0 * dq1 * dq2)) + (h * dq2 * dq2);
    let c2_term: Float = (0.0 - h) * dq1 * dq1;

    // Gravity terms (g acting vertically along -Y)
    let g1: Float = (0.0 - g) * (((m1 * r1) + (m2 * l1)) * cos(q1) + (m2 * r2 * cos(q1 + q2)));
    let g2: Float = (0.0 - g) * (m2 * r2 * cos(q1 + q2));

    // Torques: tau = M * ddq + C + G
    let tau1: Float = (m11 * ddq1) + (m12 * ddq2) + c1 + g1;
    let tau2: Float = (m21 * ddq1) + (m22 * ddq2) + c2_term + g2;

    return RneaResult2Link {
        tau1: tau1,
        tau2: tau2
    };
}
