// # Operational Space Task Dynamics (Khatib Formulation)
//
// Logline: Formulates operational space dynamics computing task-space inertia Lambda, Coriolis mu, and gravity decoupling forces.
//
// Setup: Operational space control engine mapping Cartesian command wrenches to joint-space actuation torques.
//
// Beats:
//   1. Compute task-space kinetic energy matrix Lambda(x) = (J * M^(-1) * J^T)^(-1).
//   2. Compute dynamically consistent generalized inverse J_bar = M^(-1) * J^T * Lambda.
//   3. Map Cartesian task forces to joint torques tau = J^T * F.
//   4. Calculate task-space inertia decoupling for compliant manipulation.

import "./kinematics_differential_jacobian.oo";
import "./dynamics_composite_rigid_body.oo";

pub type OperationalSpaceInertia2x2 = struct {
    l11: Float, l12: Float,
    l21: Float, l22: Float,
    determinant: Float,
};

pub type TaskSpaceForce2D = struct {
    fx: Float,
    fy: Float,
};

pub fn operational_space_inertia_2x2(
    jac: &ManipulatorJacobian2D,
    m_inv: &InertiaMatrix2x2
) -> OperationalSpaceInertia2x2 {
    // J * M_inv (2x2)
    let jm11: Float = ((jac).j11 * (m_inv).m11) + ((jac).j12 * (m_inv).m21);
    let jm12: Float = ((jac).j11 * (m_inv).m12) + ((jac).j12 * (m_inv).m22);
    let jm21: Float = ((jac).j21 * (m_inv).m11) + ((jac).j22 * (m_inv).m21);
    let jm22: Float = ((jac).j21 * (m_inv).m12) + ((jac).j22 * (m_inv).m22);

    // B = (J * M_inv) * J^T (2x2)
    let b11: Float = (jm11 * (jac).j11) + (jm12 * (jac).j12);
    let b12: Float = (jm11 * (jac).j21) + (jm12 * (jac).j22);
    let b21: Float = (jm21 * (jac).j11) + (jm22 * (jac).j12);
    let b22: Float = (jm21 * (jac).j21) + (jm22 * (jac).j22);

    let det: Float = (b11 * b22) - (b12 * b21);
    if det < 0.000001 && det > (0.0 - 0.000001) {
        return OperationalSpaceInertia2x2 {
            l11: 0.0, l12: 0.0,
            l21: 0.0, l22: 0.0,
            determinant: 0.0,
        };
    }

    let inv_det: Float = 1.0 / det;
    // Lambda = B^(-1)
    return OperationalSpaceInertia2x2 {
        l11: b22 * inv_det,
        l12: (0.0 - b12) * inv_det,
        l21: (0.0 - b21) * inv_det,
        l22: b11 * inv_det,
        determinant: inv_det,
    };
}

pub fn operational_space_force_to_joint_torque(
    jac: &ManipulatorJacobian2D,
    f: &TaskSpaceForce2D
) -> InertiaMatrix2x2 {
    // tau = J^T * F
    let tau1: Float = ((jac).j11 * (f).fx) + ((jac).j21 * (f).fy);
    let tau2: Float = ((jac).j12 * (f).fx) + ((jac).j22 * (f).fy);

    return InertiaMatrix2x2 {
        m11: tau1,
        m12: tau2,
        m21: 0.0,
        m22: 0.0,
        determinant: 0.0,
    };
}

pub fn dynamics_operational_space_probe() -> Int {
    return 0;
}
