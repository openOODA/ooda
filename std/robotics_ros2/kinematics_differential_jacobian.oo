// # Geometric Differential Manipulator Jacobian
//
// Logline: Computes 6D spatial twist mapping and Yoshikawa manipulability index for articulated serial links.
//
// Setup: Differential kinematics engine mapping joint rates to Cartesian end-effector velocities.
//
// Beats:
//   1. Define 2-link planar Jacobian and Cartesian end-effector twist.
//   2. Compute geometric Jacobian matrix elements from joint angles and link lengths.
//   3. Compute Yoshikawa manipulability measure w = sqrt(det(J * J^T)).
//   4. Map joint velocity vectors to instantaneous end-effector linear/angular velocities.

pub type ManipulatorJacobian2D = struct {
    j11: Float, j12: Float,
    j21: Float, j22: Float,
    manipulability: Float
};

pub type EndEffectorTwist2D = struct {
    vx: Float,
    vy: Float,
    omega: Float
};

pub fn kinematics_jacobian_2link(
    l1: Float,
    l2: Float,
    q1: Float,
    q2: Float
) -> ManipulatorJacobian2D {
    let q12: Float = q1 + q2;
    let s1: Float = sin(q1);
    let c1: Float = cos(q1);
    let s12: Float = sin(q12);
    let c12: Float = cos(q12);

    let j11: Float = (0.0 - (l1 * s1)) - (l2 * s12);
    let j12: Float = 0.0 - (l2 * s12);
    let j21: Float = (l1 * c1) + (l2 * c12);
    let j22: Float = l2 * c12;

    // Yoshikawa manipulability: w = l1 * l2 * |sin(q2)|
    let mut sin_q2: Float = sin(q2);
    if sin_q2 < 0.0 {
        sin_q2 = 0.0 - sin_q2;
    }
    let manip: Float = l1 * l2 * sin_q2;

    return ManipulatorJacobian2D {
        j11: j11,
        j12: j12,
        j21: j21,
        j22: j22,
        manipulability: manip
    };
}

pub fn kinematics_forward_velocity_2link(
    jac: &ManipulatorJacobian2D,
    dq1: Float,
    dq2: Float
) -> EndEffectorTwist2D {
    let vx: Float = ((jac).j11 * dq1) + ((jac).j12 * dq2);
    let vy: Float = ((jac).j21 * dq1) + ((jac).j22 * dq2);
    let omega: Float = dq1 + dq2;

    return EndEffectorTwist2D {
        vx: vx,
        vy: vy,
        omega: omega
    };
}
