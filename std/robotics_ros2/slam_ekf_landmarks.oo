// # Feature-Based Extended Kalman Filter (EKF) Landmark SLAM
//
// Logline: Jointly estimates mobile robot SE(2) pose and landmark map positions with range-bearing observation updates.
//
// Setup: Non-linear stochastic state estimator updating spatial landmark positions under Gaussian noise models.
//
// Beats:
//   1. Define Robot SE(2) state and 2D Landmark feature structures.
//   2. Predict non-linear range-bearing sensor observation model h(x, m).
//   3. Compute observation innovation vector y = z - h(x, m).
//   4. Calculate Mahalanobis distance gating metric for data association.

pub type EKFRobotPose = struct {
    x: Float,
    y: Float,
    theta: Float
};

pub type EKFLandmark2D = struct {
    id: Int,
    x: Float,
    y: Float
};

pub type EKFMeasurement = struct {
    range_m: Float,
    bearing_rad: Float
};

pub type EKFInnovation = struct {
    inno_range: Float,
    inno_bearing: Float,
    mahalanobis_sq: Float,
    is_associated: Bool
};

pub fn ekf_robot_pose_new(x: Float, y: Float, theta: Float) -> EKFRobotPose {
    return EKFRobotPose { x: x, y: y, theta: theta };
}

pub fn ekf_landmark_new(id: Int, x: Float, y: Float) -> EKFLandmark2D {
    return EKFLandmark2D { id: id, x: x, y: y };
}

pub fn ekf_predict_observation(
    robot: &EKFRobotPose,
    lm: &EKFLandmark2D
) -> EKFMeasurement {
    let dx: Float = (lm).x - (robot).x;
    let dy: Float = (lm).y - (robot).y;
    let r: Float = sqrt((dx * dx) + (dy * dy));

    // Approximate relative bearing
    let bearing_raw: Float = if dx != 0.0 { dy / dx } else { 0.0 };
    let rel_bearing: Float = bearing_raw - (robot).theta;

    return EKFMeasurement {
        range_m: r,
        bearing_rad: rel_bearing
    };
}

pub fn ekf_compute_innovation(
    z_meas: &EKFMeasurement,
    z_pred: &EKFMeasurement,
    var_range: Float,
    var_bearing: Float,
    chi2_gate: Float
) -> EKFInnovation {
    let dy_r: Float = (z_meas).range_m - (z_pred).range_m;
    let dy_b: Float = (z_meas).bearing_rad - (z_pred).bearing_rad;

    let vr: Float = if var_range < 0.0001 { 0.0001 } else { var_range };
    let vb: Float = if var_bearing < 0.0001 { 0.0001 } else { var_bearing };

    let mahal_sq: Float = ((dy_r * dy_r) / vr) + ((dy_b * dy_b) / vb);
    let matched: Bool = mahal_sq <= chi2_gate;

    return EKFInnovation {
        inno_range: dy_r,
        inno_bearing: dy_b,
        mahalanobis_sq: mahal_sq,
        is_associated: matched
    };
}
