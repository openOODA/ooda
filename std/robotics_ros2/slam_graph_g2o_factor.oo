// # Non-Linear Factor Graph Optimization (g2o/GTSAM SE(2))
//
// Logline: Formulates pose graph SLAM factor graphs computing SE(2) odometry and loop closure edge residuals.
//
// Setup: Factor graph optimization engine evaluating relative pose measurement errors and Mahalanobis costs.
//
// Beats:
//   1. Define SE(2) Pose Vertex and BetweenFactor measurement edges.
//   2. Compute SE(2) relative pose error e_ij = Inv(z_ij) * (Inv(x_i) * x_j).
//   3. Evaluate quadratic factor Chi-square cost 0.5 * e^T * Omega * e.
//   4. Accumulate overall pose graph optimization cost across all edges.

pub type Pose2DVertex = struct {
    id: Int,
    x: Float,
    y: Float,
    theta: Float,
    is_fixed: Bool,
};

pub type BetweenFactorSE2 = struct {
    from_id: Int,
    to_id: Int,
    dx: Float,
    dy: Float,
    dtheta: Float,
    weight_trans: Float,
    weight_rot: Float,
};

pub type FactorResidualSE2 = struct {
    error_x: Float,
    error_y: Float,
    error_theta: Float,
    chi2_cost: Float,
};

pub fn pose2d_vertex_new(id: Int, x: Float, y: Float, theta: Float, fixed: Bool) -> Pose2DVertex {
    return Pose2DVertex {
        id: id,
        x: x,
        y: y,
        theta: theta,
        is_fixed: fixed,
    };
}

pub fn between_factor_se2_new(
    from_id: Int, to_id: Int,
    dx: Float, dy: Float, dtheta: Float,
    w_trans: Float, w_rot: Float
) -> BetweenFactorSE2 {
    return BetweenFactorSE2 {
        from_id: from_id,
        to_id: to_id,
        dx: dx,
        dy: dy,
        dtheta: dtheta,
        weight_trans: w_trans,
        weight_rot: w_rot,
    };
}

pub fn slam_compute_factor_residual(
    v_from: &Pose2DVertex,
    v_to: &Pose2DVertex,
    edge: &BetweenFactorSE2
) -> FactorResidualSE2 {
    let cos_i: Float = cos((v_from).theta);
    let sin_i: Float = sin((v_from).theta);

    // Delta in world frame
    let delta_x: Float = (v_to).x - (v_from).x;
    let delta_y: Float = (v_to).y - (v_from).y;

    // Predicted relative transformation in frame i: R_i^T * delta
    let pred_dx: Float = (cos_i * delta_x) + (sin_i * delta_y);
    let pred_dy: Float = ((0.0 - sin_i) * delta_x) + (cos_i * delta_y);
    let pred_dtheta: Float = (v_to).theta - (v_from).theta;

    // Residual error = predicted - measured
    let ex: Float = pred_dx - (edge).dx;
    let ey: Float = pred_dy - (edge).dy;
    let etheta: Float = pred_dtheta - (edge).dtheta;

    // Chi2 cost: 0.5 * (w_trans*(ex^2 + ey^2) + w_rot*etheta^2)
    let cost_trans: Float = (edge).weight_trans * ((ex * ex) + (ey * ey));
    let cost_rot: Float = (edge).weight_rot * (etheta * etheta);
    let total_cost: Float = 0.5 * (cost_trans + cost_rot);

    return FactorResidualSE2 {
        error_x: ex,
        error_y: ey,
        error_theta: etheta,
        chi2_cost: total_cost,
    };
}
