// # Computed Torque Feedback Linearization Controller
//
// Logline: Implements inverse-dynamics computed torque control canceling non-linear multi-body inertial, Coriolis, and gravity torques.
//
// Setup: Non-linear model-based robot manipulator tracking controller establishing decoupled linear error dynamics.
//
// Beats:
//   1. Define 2-axis PD Tracking Gains structure (Kp, Kd).
//   2. Compute auxiliary acceleration signal v = ddq_d + Kp*(q_d - q) + Kd*(dq_d - dq).
//   3. Multiply joint-space inertia matrix tau_m = M(q) * v.
//   4. Superimpose Coriolis/centrifugal C(q, dq)*dq and gravitational G(q) feedforward torques.

import "./dynamics_composite_rigid_body.oo";
import "./dynamics_coriolis_centrifugal.oo";

pub type PDGains2D = struct {
    kp1: Float, kp2: Float,
    kd1: Float, kd2: Float,
};

pub fn pd_gains_2d_new(kp1: Float, kp2: Float, kd1: Float, kd2: Float) -> PDGains2D {
    return PDGains2D {
        kp1: kp1, kp2: kp2,
        kd1: kd1, kd2: kd2,
    };
}

pub fn computed_torque_control_2d(
    gains: &PDGains2D,
    m_mat: &InertiaMatrix2x2,
    c_torques: &JointTorques2D,
    g_torques: &JointTorques2D,
    q_curr1: Float, q_curr2: Float,
    dq_curr1: Float, dq_curr2: Float,
    q_des1: Float, q_des2: Float,
    dq_des1: Float, dq_des2: Float,
    ddq_des1: Float, ddq_des2: Float
) -> JointTorques2D {
    // Tracking errors
    let e1: Float = q_des1 - q_curr1;
    let e2: Float = q_des2 - q_curr2;

    let de1: Float = dq_des1 - dq_curr1;
    let de2: Float = dq_des2 - dq_curr2;

    // Linearizing acceleration command v = ddq_des + Kp*e + Kd*de
    let v1: Float = ddq_des1 + ((gains).kp1 * e1) + ((gains).kd1 * de1);
    let v2: Float = ddq_des2 + ((gains).kp2 * e2) + ((gains).kd2 * de2);

    // M(q) * v
    let m_v1: Float = ((m_mat).m11 * v1) + ((m_mat).m12 * v2);
    let m_v2: Float = ((m_mat).m21 * v1) + ((m_mat).m22 * v2);

    // Total torque tau = M*v + C*dq + G
    let tau1: Float = m_v1 + (c_torques).tau1 + (g_torques).tau1;
    let tau2: Float = m_v2 + (c_torques).tau2 + (g_torques).tau2;

    return JointTorques2D {
        tau1: tau1,
        tau2: tau2,
    };
}
