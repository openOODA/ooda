// # ROS2 Topic Publisher & QoS Manager
//
// Logline: Manages ROS2 typed topic publication with configurable DDS Quality of Service (QoS) profiles.
//
// Setup: Pure topic publisher abstraction enforcing QoS durability, reliability, and sequence tracking.
//
// Beats:
//   1. Define QoS policies for reliability, durability, and history depth.
//   2. Create standard QoS profiles (Default, SensorData, Parameters).
//   3. Implement ROS2 Topic Publisher tracking sequence IDs and byte throughput.
//   4. Evaluate QoS compatibility between publishers and subscribers.

pub type TopicQos = struct {
    reliability: Int,   // 0 = BestEffort, 1 = Reliable
    durability: Int,    // 0 = Volatile, 1 = TransientLocal
    history: Int,       // 0 = KeepLast, 1 = KeepAll
    depth: Int,         // History queue depth
    deadline_ms: Float, // Maximum expected inter-message period (ms)
    lifespan_ms: Float // Message expiration lifespan (ms)
};

pub type TopicPublisher = struct {
    topic_id: Int,
    qos: TopicQos,
    sequence_num: Int,
    publish_count: Int,
    matched_subscribers: Int,
    total_bytes: Int
};

pub fn topic_qos_default() -> TopicQos {
    return TopicQos {
        reliability: 1, // Reliable
        durability: 0,  // Volatile
        history: 0,     // KeepLast
        depth: 10,
        deadline_ms: 0.0,
        lifespan_ms: 0.0
    };
}

pub fn topic_qos_sensor_data() -> TopicQos {
    return TopicQos {
        reliability: 0, // BestEffort
        durability: 0,  // Volatile
        history: 0,     // KeepLast
        depth: 5,
        deadline_ms: 100.0,
        lifespan_ms: 1000.0
    };
}

pub fn topic_qos_latched() -> TopicQos {
    return TopicQos {
        reliability: 1, // Reliable
        durability: 1,  // TransientLocal
        history: 0,     // KeepLast
        depth: 1,
        deadline_ms: 0.0,
        lifespan_ms: 0.0
    };
}

pub fn topic_publisher_new(topic_id: Int, qos: TopicQos) -> TopicPublisher {
    return TopicPublisher {
        topic_id: topic_id,
        qos: qos,
        sequence_num: 0,
        publish_count: 0,
        matched_subscribers: 0,
        total_bytes: 0
    };
}

pub fn topic_publisher_publish(pub_obj: &mut TopicPublisher, payload_bytes: Int) -> Int {
    (pub_obj).sequence_num = (pub_obj).sequence_num + 1;
    (pub_obj).publish_count = (pub_obj).publish_count + 1;
    (pub_obj).total_bytes = (pub_obj).total_bytes + payload_bytes;
    return (pub_obj).sequence_num;
}

pub fn topic_publisher_set_matched(pub_obj: &mut TopicPublisher, count: Int) -> Int {
    (pub_obj).matched_subscribers = count;
    return count;
}

pub fn topic_publisher_has_subscribers(pub_obj: &TopicPublisher) -> Bool {
    return (pub_obj).matched_subscribers > 0;
}

pub fn topic_qos_is_compatible(pub_qos: &TopicQos, sub_qos: &TopicQos) -> Bool {
    // Subscriber requesting Reliable cannot match with BestEffort publisher
    if (sub_qos).reliability == 1 && (pub_qos).reliability == 0 {
        return false;
    }
    // Subscriber requesting TransientLocal cannot match with Volatile publisher
    if (sub_qos).durability == 1 && (pub_qos).durability == 0 {
        return false;
    }
    return true;
}
