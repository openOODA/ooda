// # ROS2 Asynchronous Service Client
//
// Logline: Manages client-side RPC service requests, sequence IDs, and response timeout tracking.
//
// Setup: Pure service client handling asynchronous request correlation and latency measurement.
//
// Beats:
//   1. Define ServiceClient configuration and pending request tracking.
//   2. Allocate unique sequence identifiers for concurrent requests.
//   3. Handle service response correlation and error status.
//   4. Evaluate timeout expiration for outstanding RPC requests.

pub type ServiceClient = struct {
    service_id: Int,
    next_sequence_id: Int,
    pending_count: Int,
    completed_count: Int,
    timeout_count: Int,
    timeout_threshold_ms: Float
};

pub type ServicePendingRequest = struct {
    sequence_id: Int,
    timestamp_sent_ms: Float,
    is_active: Bool
};

pub fn service_client_new(service_id: Int, timeout_ms: Float) -> ServiceClient {
    return ServiceClient {
        service_id: service_id,
        next_sequence_id: 1,
        pending_count: 0,
        completed_count: 0,
        timeout_count: 0,
        timeout_threshold_ms: timeout_ms
    };
}

pub fn service_pending_request_new(seq_id: Int, sent_ms: Float) -> ServicePendingRequest {
    return ServicePendingRequest {
        sequence_id: seq_id,
        timestamp_sent_ms: sent_ms,
        is_active: true
    };
}

pub fn service_client_send_request(
    client: &mut ServiceClient,
    current_time_ms: Float
) -> ServicePendingRequest {
    let req_id: Int = (client).next_sequence_id;
    (client).next_sequence_id = (client).next_sequence_id + 1;
    (client).pending_count = (client).pending_count + 1;

    return service_pending_request_new(req_id, current_time_ms);
}

pub fn service_client_receive_response(
    client: &mut ServiceClient,
    req: &mut ServicePendingRequest
) -> Bool {
    if !(req).is_active {
        return false;
    }
    (req).is_active = false;
    if (client).pending_count > 0 {
        (client).pending_count = (client).pending_count - 1;
    }
    (client).completed_count = (client).completed_count + 1;
    return true;
}

pub fn service_client_is_timed_out(
    client: &ServiceClient,
    req: &ServicePendingRequest,
    current_time_ms: Float
) -> Bool {
    if !(req).is_active {
        return false;
    }
    let elapsed: Float = current_time_ms - (req).timestamp_sent_ms;
    return elapsed >= (client).timeout_threshold_ms;
}

pub fn service_client_handle_timeout(
    client: &mut ServiceClient,
    req: &mut ServicePendingRequest
) -> Bool {
    if !(req).is_active {
        return false;
    }
    (req).is_active = false;
    if (client).pending_count > 0 {
        (client).pending_count = (client).pending_count - 1;
    }
    (client).timeout_count = (client).timeout_count + 1;
    return true;
}
