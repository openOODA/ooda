// # Geometric Capsule & Cylinder Collision Queries
//
// Logline: Computes exact Euclidean clearance and collision bounds between 3D line segments, capsules, and cylinders.
//
// Setup: Analytic geometric distance engine providing conservative bounding envelopes for robot manipulator links.
//
// Beats:
//   1. Define 3D Capsule geometry (line segment endpoints p1, p2, and radius r).
//   2. Compute closest points between two arbitrary 3D line segments.
//   3. Calculate exact capsule-to-capsule Euclidean clearance distance.
//   4. Evaluate capsule-to-point and swept-sphere collision clearances.

import "./tf2_spatial_transform.oo";

pub type Capsule3D = struct {
    p1: Vector3,
    p2: Vector3,
    radius: Float,
};

pub type SegmentDistanceResult = struct {
    s: Float,
    t: Float,
    distance: Float,
    is_colliding: Bool,
};

pub fn capsule_new(p1: Vector3, p2: Vector3, radius: Float) -> Capsule3D {
    return Capsule3D {
        p1: p1,
        p2: p2,
        radius: radius,
    };
}

pub fn segment_segment_distance(
    p1: &Vector3, q1: &Vector3,
    p2: &Vector3, q2: &Vector3
) -> SegmentDistanceResult {
    let d1x: Float = (q1).x - (p1).x;
    let d1y: Float = (q1).y - (p1).y;
    let d1z: Float = (q1).z - (p1).z;

    let d2x: Float = (q2).x - (p2).x;
    let d2y: Float = (q2).y - (p2).y;
    let d2z: Float = (q2).z - (p2).z;

    let rx: Float = (p1).x - (p2).x;
    let ry: Float = (p1).y - (p2).y;
    let rz: Float = (p1).z - (p2).z;

    let a: Float = (d1x * d1x) + (d1y * d1y) + (d1z * d1z);
    let e: Float = (d2x * d2x) + (d2y * d2y) + (d2z * d2z);
    let f: Float = (d2x * rx) + (d2y * ry) + (d2z * rz);

    let mut s: Float = 0.0;
    let mut t: Float = 0.0;

    if a <= 0.000001 && e <= 0.000001 {
        // Both segments degenerate to points
        s = 0.0;
        t = 0.0;
    } else if a <= 0.000001 {
        // First segment degenerates
        s = 0.0;
        t = f / (e + 0.000001);
        if t < 0.0 { t = 0.0; }
        if t > 1.0 { t = 1.0; }
    } else {
        let c: Float = (d1x * rx) + (d1y * ry) + (d1z * rz);
        if e <= 0.000001 {
            // Second segment degenerates
            t = 0.0;
            s = (0.0 - c) / a;
            if s < 0.0 { s = 0.0; }
            if s > 1.0 { s = 1.0; }
        } else {
            let b: Float = (d1x * d2x) + (d1y * d2y) + (d1z * d2z);
            let denom: Float = (a * e) - (b * b);
            if denom != 0.0 {
                s = ((b * f) - (c * e)) / denom;
                if s < 0.0 { s = 0.0; }
                if s > 1.0 { s = 1.0; }
            } else {
                s = 0.0;
            }
            t = ((b * s) + f) / e;
            if t < 0.0 {
                t = 0.0;
                s = (0.0 - c) / a;
                if s < 0.0 { s = 0.0; }
                if s > 1.0 { s = 1.0; }
            } else if t > 1.0 {
                t = 1.0;
                s = (b - c) / a;
                if s < 0.0 { s = 0.0; }
                if s > 1.0 { s = 1.0; }
            }
        }
    }

    // Closest points: c1 = p1 + s*d1, c2 = p2 + t*d2
    let c1x: Float = (p1).x + (s * d1x);
    let c1y: Float = (p1).y + (s * d1y);
    let c1z: Float = (p1).z + (s * d1z);

    let c2x: Float = (p2).x + (t * d2x);
    let c2y: Float = (p2).y + (t * d2y);
    let c2z: Float = (p2).z + (t * d2z);

    let dx: Float = c1x - c2x;
    let dy: Float = c1y - c2y;
    let dz: Float = c1z - c2z;
    let dist: Float = sqrt((dx * dx) + (dy * dy) + (dz * dz));

    return SegmentDistanceResult {
        s: s,
        t: t,
        distance: dist,
        is_colliding: dist <= 0.0,
    };
}

pub fn capsule_capsule_distance(c1: &Capsule3D, c2: &Capsule3D) -> Float {
    let seg_res: SegmentDistanceResult = segment_segment_distance(
        &(c1).p1, &(c1).p2,
        &(c2).p1, &(c2).p2
    );
    let r_sum: Float = (c1).radius + (c2).radius;
    let clearance: Float = seg_res.distance - r_sum;
    return clearance;
}
