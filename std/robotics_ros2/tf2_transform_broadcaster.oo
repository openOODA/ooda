// # TF2 Transform Broadcaster
//
// Logline: Publishes stamped 6-DoF spatial coordinate frames across parent and child links.
//
// Setup: Pure transform broadcaster tracking time-stamped kinematic link frames.
//
// Beats:
//   1. Define Stamped Transform structures with parent and child frame identifiers.
//   2. Register and validate frame timestamps to prevent time reversal.
//   3. Compute frame inversions for backward tree traversal.
//   4. Track broadcast telemetry and transform update frequencies.

import "./tf2_spatial_transform.oo";

pub type TransformStamped = struct {
    parent_frame_id: Int,
    child_frame_id: Int,
    timestamp_ns: Int,
    transform: Transform3D
};

pub type TransformBroadcaster = struct {
    broadcast_count: Int,
    last_timestamp_ns: Int,
    is_active: Bool
};

pub fn transform_stamped_new(
    parent_id: Int,
    child_id: Int,
    time_ns: Int,
    t: Transform3D
) -> TransformStamped {
    return TransformStamped {
        parent_frame_id: parent_id,
        child_frame_id: child_id,
        timestamp_ns: time_ns,
        transform: t
    };
}

pub fn transform_broadcaster_new() -> TransformBroadcaster {
    return TransformBroadcaster {
        broadcast_count: 0,
        last_timestamp_ns: 0,
        is_active: true
    };
}

pub fn transform_broadcaster_send(
    broadcaster: &mut TransformBroadcaster,
    stamped: &TransformStamped
) -> Bool {
    if !(broadcaster).is_active {
        return false;
    }
    // Reject frames that go backward in time on the broadcaster
    if (stamped).timestamp_ns < (broadcaster).last_timestamp_ns {
        return false;
    }
    (broadcaster).broadcast_count = (broadcaster).broadcast_count + 1;
    (broadcaster).last_timestamp_ns = (stamped).timestamp_ns;
    return true;
}

pub fn transform_stamped_invert(stamped: &TransformStamped) -> TransformStamped {
    return TransformStamped {
        parent_frame_id: (stamped).child_frame_id,
        child_frame_id: (stamped).parent_frame_id,
        timestamp_ns: (stamped).timestamp_ns,
        transform: transform3d_inverse(&(stamped).transform)
    };
}
