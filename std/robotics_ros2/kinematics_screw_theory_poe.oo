// # Lie Group Screw Theory & Product of Exponentials (PoE)
//
// Logline: Computes forward kinematics using Lie algebra se(3) spatial twists and the matrix exponential formula.
//
// Setup: Geometric screw theory engine representing rigid-body motions via exponential coordinates.
//
// Beats:
//   1. Define 6D Spatial Screw Axis S = [omega; v].
//   2. Compute matrix exponential exp([S]*theta) in SE(3) using Rodrigues formula.
//   3. Chain screw exponentials T(theta) = exp(S1*th1) * exp(S2*th2) * M.
//   4. Convert screw coordinates to homogeneous transformation matrices.

import "./tf2_spatial_transform.oo";

pub type SpatialScrewAxis = struct {
    wx: Float, wy: Float, wz: Float, // Angular velocity axis
    vx: Float, vy: Float, vz: Float, // Linear velocity component
};

pub type Se3Transform = struct {
    r11: Float, r12: Float, r13: Float, px: Float,
    r21: Float, r22: Float, r23: Float, py: Float,
    r31: Float, r32: Float, r33: Float, pz: Float,
};

pub fn spatial_screw_new(
    wx: Float, wy: Float, wz: Float,
    vx: Float, vy: Float, vz: Float
) -> SpatialScrewAxis {
    return SpatialScrewAxis {
        wx: wx, wy: wy, wz: wz,
        vx: vx, vy: vy, vz: vz,
    };
}

pub fn se3_identity() -> Se3Transform {
    return Se3Transform {
        r11: 1.0, r12: 0.0, r13: 0.0, px: 0.0,
        r21: 0.0, r22: 1.0, r23: 0.0, py: 0.0,
        r31: 0.0, r32: 0.0, r33: 1.0, pz: 0.0,
    };
}

pub fn matrix_exp6(s: &SpatialScrewAxis, theta: Float) -> Se3Transform {
    let wx: Float = (s).wx;
    let wy: Float = (s).wy;
    let wz: Float = (s).wz;
    let vx: Float = (s).vx;
    let vy: Float = (s).vy;
    let vz: Float = (s).vz;

    let w_norm_sq: Float = (wx * wx) + (wy * wy) + (wz * wz);

    if w_norm_sq < 0.000001 {
        // Pure prismatic translation: R = I, p = v * theta
        return Se3Transform {
            r11: 1.0, r12: 0.0, r13: 0.0, px: vx * theta,
            r21: 0.0, r22: 1.0, r23: 0.0, py: vy * theta,
            r31: 0.0, r32: 0.0, r33: 1.0, pz: vz * theta,
        };
    }

    let st: Float = sin(theta);
    let ct: Float = cos(theta);
    let one_minus_ct: Float = 1.0 - ct;

    // Rodrigues rotation matrix R = I + sin(th)*[w] + (1 - cos(th))*[w]^2
    let r11: Float = 1.0 + (one_minus_ct * ((wx * wx) - 1.0));
    let r12: Float = (0.0 - (wz * st)) + (one_minus_ct * wx * wy);
    let r13: Float = (wy * st) + (one_minus_ct * wx * wz);

    let r21: Float = (wz * st) + (one_minus_ct * wx * wy);
    let r22: Float = 1.0 + (one_minus_ct * ((wy * wy) - 1.0));
    let r23: Float = (0.0 - (wx * st)) + (one_minus_ct * wy * wz);

    let r31: Float = (0.0 - (wy * st)) + (one_minus_ct * wx * wz);
    let r32: Float = (wx * st) + (one_minus_ct * wy * wz);
    let r33: Float = 1.0 + (one_minus_ct * ((wz * wz) - 1.0));

    // Translation G(theta)*v: (I*th + (1-ct)*[w] + (th-st)*[w]^2)*v
    let px: Float = (theta * vx) + (one_minus_ct * ((wy * vz) - (wz * vy)));
    let py: Float = (theta * vy) + (one_minus_ct * ((wz * vx) - (wx * vz)));
    let pz: Float = (theta * vz) + (one_minus_ct * ((wx * vy) - (wy * vx)));

    return Se3Transform {
        r11: r11, r12: r12, r13: r13, px: px,
        r21: r21, r22: r22, r23: r23, py: py,
        r31: r31, r32: r32, r33: r33, pz: pz,
    };
}
