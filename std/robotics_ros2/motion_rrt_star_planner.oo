// # Optimal Rapidly-Exploring Random Trees (RRT*) Motion Planner
//
// Logline: Plans asymptotically optimal collision-free trajectories in configuration space via near-neighbor tree rewiring.
//
// Setup: Sampling-based kinodynamic motion planner for high-dimensional robotic state spaces.
//
// Beats:
//   1. Define RRT* Tree Node and Planner configuration structures.
//   2. Steer from nearest tree vertex towards sampled target state with step clamping.
//   3. Search neighborhood ball for minimum cost-to-come parent connection.
//   4. Rewire adjacent tree vertices to preserve asymptotic path optimality.

pub type RRTNode2D = struct {
    x: Float,
    y: Float,
    cost: Float,
    parent_idx: Int
};

pub type RRTPlannerConfig = struct {
    step_size: Float,
    search_radius: Float,
    goal_threshold: Float,
    goal_bias_prob: Float,
    max_nodes: Int
};

pub fn rrt_node_new(x: Float, y: Float, cost: Float, parent_idx: Int) -> RRTNode2D {
    return RRTNode2D {
        x: x,
        y: y,
        cost: cost,
        parent_idx: parent_idx
    };
}

pub fn rrt_planner_config_default() -> RRTPlannerConfig {
    return RRTPlannerConfig {
        step_size: 0.2,
        search_radius: 0.5,
        goal_threshold: 0.1,
        goal_bias_prob: 0.05,
        max_nodes: 2048
    };
}

pub fn rrt_distance(x1: Float, y1: Float, x2: Float, y2: Float) -> Float {
    let dx: Float = x2 - x1;
    let dy: Float = y2 - y1;
    return sqrt((dx * dx) + (dy * dy));
}

pub fn rrt_steer(
    from_x: Float, from_y: Float,
    to_x: Float, to_y: Float,
    max_step: Float
) -> RRTNode2D {
    let dist: Float = rrt_distance(from_x, from_y, to_x, to_y);
    if dist <= max_step {
        return rrt_node_new(to_x, to_y, dist, -1);
    }
    let ratio: Float = max_step / (dist + 0.000001);
    let new_x: Float = from_x + ((to_x - from_x) * ratio);
    let new_y: Float = from_y + ((to_y - from_y) * ratio);
    return rrt_node_new(new_x, new_y, max_step, -1);
}

pub fn rrt_star_should_rewire(
    new_node: &RRTNode2D,
    neighbor: &RRTNode2D,
    edge_cost: Float
) -> Bool {
    let potential_cost: Float = (new_node).cost + edge_cost;
    return potential_cost < (neighbor).cost;
}

pub fn rrt_is_goal_reached(
    node: &RRTNode2D,
    goal_x: Float,
    goal_y: Float,
    threshold: Float
) -> Bool {
    let dist: Float = rrt_distance((node).x, (node).y, goal_x, goal_y);
    return dist <= threshold;
}
