// # Gilbert-Johnson-Keerthi (GJK) & EPA Convex Collision Engine
//
// Logline: Computes exact Euclidean distance and penetration depth between convex geometric polytopes.
//
// Setup: Narrow-phase convex collision engine evaluating Minkowski difference support mappings.
//
// Beats:
//   1. Define 3D Simplex representation (points, line segments, triangles, tetrahedra).
//   2. Compute Minkowski difference support mappings S_A-B(v) = S_A(v) - S_B(-v).
//   3. Iterate simplex evolution to enclose or approach the origin.
//   4. Estimate penetration depth vector and separating contact normal.

import "./tf2_spatial_transform.oo";

pub type GJKSimplex = struct {
    p1: Vector3,
    p2: Vector3,
    p3: Vector3,
    size: Int
};

pub type GJKContact = struct {
    is_colliding: Bool,
    distance: Float,
    penetration_depth: Float,
    normal: Vector3
};

pub fn gjk_simplex_new() -> GJKSimplex {
    return GJKSimplex {
        p1: vector3_zero(),
        p2: vector3_zero(),
        p3: vector3_zero(),
        size: 0
    };
}

pub fn gjk_support_sphere(center: &Vector3, radius: Float, dir: &Vector3) -> Vector3 {
    let d_sq: Float = ((dir).x * (dir).x) + ((dir).y * (dir).y) + ((dir).z * (dir).z);
    if d_sq < 0.000001 {
        return *center;
    }
    let inv_d: Float = 1.0 / sqrt(d_sq);
    return Vector3 {
        x: (center).x + ((dir).x * inv_d * radius),
        y: (center).y + ((dir).y * inv_d * radius),
        z: (center).z + ((dir).z * inv_d * radius)
    };
}

pub fn gjk_support_minkowski(
    c1: &Vector3, r1: Float,
    c2: &Vector3, r2: Float,
    dir: &Vector3
) -> Vector3 {
    let neg_dir: Vector3 = Vector3 {
        x: 0.0 - (dir).x,
        y: 0.0 - (dir).y,
        z: 0.0 - (dir).z
    };
    let s1: Vector3 = gjk_support_sphere(c1, r1, dir);
    let s2: Vector3 = gjk_support_sphere(c2, r2, &neg_dir);
    return Vector3 {
        x: (s1).x - (s2).x,
        y: (s1).y - (s2).y,
        z: (s1).z - (s2).z
    };
}

pub fn gjk_sphere_sphere_test(
    c1: &Vector3, r1: Float,
    c2: &Vector3, r2: Float
) -> GJKContact {
    let dx: Float = (c2).x - (c1).x;
    let dy: Float = (c2).y - (c1).y;
    let dz: Float = (c2).z - (c1).z;
    let center_dist: Float = sqrt((dx * dx) + (dy * dy) + (dz * dz));
    let r_sum: Float = r1 + r2;

    if center_dist < 0.000001 {
        return GJKContact {
            is_colliding: true,
            distance: 0.0,
            penetration_depth: r_sum,
            normal: vector3_new(1.0, 0.0, 0.0)
        };
    }

    let inv_dist: Float = 1.0 / center_dist;
    let normal: Vector3 = vector3_new(dx * inv_dist, dy * inv_dist, dz * inv_dist);

    if center_dist <= r_sum {
        return GJKContact {
            is_colliding: true,
            distance: 0.0,
            penetration_depth: r_sum - center_dist,
            normal: normal
        };
    } else {
        return GJKContact {
            is_colliding: false,
            distance: center_dist - r_sum,
            penetration_depth: 0.0,
            normal: normal
        };
    }
}
