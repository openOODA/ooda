// # Kinematic Redundancy Resolution & Null-Space Projection
//
// Logline: Projects secondary kinematic objective gradients into the null-space projector (I - J^# * J) for redundant manipulators.
//
// Setup: Redundancy resolution engine for multi-objective optimization (joint limit avoidance, manipulability).
//
// Beats:
//   1. Define 2x3 Jacobian matrix for redundant 3-DoF planar manipulators.
//   2. Compute pseudoinverse J^# = J^T * (J * J^T)^(-1).
//   3. Project secondary joint velocity bias q_dot_0 through null-space projector (I - J^# * J).
//   4. Combine primary Cartesian task tracking with secondary null-space goals.

pub type Jacobian2x3 = struct {
    j11: Float, j12: Float, j13: Float,
    j21: Float, j22: Float, j23: Float,
};

pub type Vector3Joints = struct {
    q1: Float,
    q2: Float,
    q3: Float,
};

pub fn jacobian_2x3_new(
    j11: Float, j12: Float, j13: Float,
    j21: Float, j22: Float, j23: Float
) -> Jacobian2x3 {
    return Jacobian2x3 {
        j11: j11, j12: j12, j13: j13,
        j21: j21, j22: j22, j23: j23,
    };
}

pub fn vector3_joints_new(q1: Float, q2: Float, q3: Float) -> Vector3Joints {
    return Vector3Joints { q1: q1, q2: q2, q3: q3 };
}

pub fn kinematics_nullspace_project_3dof(
    jac: &Jacobian2x3,
    primary_vx: Float,
    primary_vy: Float,
    q0: &Vector3Joints
) -> Vector3Joints {
    // A = J * J^T (2x2)
    let a11: Float = ((jac).j11 * (jac).j11) + ((jac).j12 * (jac).j12) + ((jac).j13 * (jac).j13);
    let a12: Float = ((jac).j11 * (jac).j21) + ((jac).j12 * (jac).j22) + ((jac).j13 * (jac).j23);
    let a21: Float = a12;
    let a22: Float = ((jac).j21 * (jac).j21) + ((jac).j22 * (jac).j22) + ((jac).j23 * (jac).j23);

    let det: Float = (a11 * a22) - (a12 * a21) + 0.000001;
    let inv_det: Float = 1.0 / det;

    // invA = A^(-1)
    let inv11: Float = a22 * inv_det;
    let inv12: Float = (0.0 - a12) * inv_det;
    let inv21: Float = (0.0 - a21) * inv_det;
    let inv22: Float = a11 * inv_det;

    // J_pinv = J^T * invA (3x2)
    let p11: Float = ((jac).j11 * inv11) + ((jac).j21 * inv21);
    let p12: Float = ((jac).j11 * inv12) + ((jac).j21 * inv22);
    let p21: Float = ((jac).j12 * inv11) + ((jac).j22 * inv21);
    let p22: Float = ((jac).j12 * inv12) + ((jac).j22 * inv22);
    let p31: Float = ((jac).j13 * inv11) + ((jac).j23 * inv21);
    let p32: Float = ((jac).j13 * inv12) + ((jac).j23 * inv22);

    // Primary task joint velocities: q_dot_p = J_pinv * v
    let qp1: Float = (p11 * primary_vx) + (p12 * primary_vy);
    let qp2: Float = (p21 * primary_vx) + (p22 * primary_vy);
    let qp3: Float = (p31 * primary_vx) + (p32 * primary_vy);

    // J * q0 (2x1)
    let jq0_1: Float = ((jac).j11 * (q0).q1) + ((jac).j12 * (q0).q2) + ((jac).j13 * (q0).q3);
    let jq0_2: Float = ((jac).j21 * (q0).q1) + ((jac).j22 * (q0).q2) + ((jac).j23 * (q0).q3);

    // J_pinv * (J * q0) (3x1)
    let pj_1: Float = (p11 * jq0_1) + (p12 * jq0_2);
    let pj_2: Float = (p21 * jq0_1) + (p22 * jq0_2);
    let pj_3: Float = (p31 * jq0_1) + (p32 * jq0_2);

    // Nullspace component: (I - J_pinv * J) * q0 = q0 - J_pinv * (J * q0)
    let qn1: Float = (q0).q1 - pj_1;
    let qn2: Float = (q0).q2 - pj_2;
    let qn3: Float = (q0).q3 - pj_3;

    return Vector3Joints {
        q1: qp1 + qn1,
        q2: qp2 + qn2,
        q3: qp3 + qn3,
    };
}
