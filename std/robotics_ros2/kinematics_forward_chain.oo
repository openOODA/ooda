// # Serial Manipulator Forward Kinematic Chain
//
// Logline: Multiplies successive link transformation matrices to determine end-effector Cartesian pose.
//
// Setup: Forward kinematic chain recursion in SE(3) for serial articulated arms.
//
// Beats:
//   1. Implement 4x4 Homogeneous transformation matrix multiplication.
//   2. Chain sequential DH link frames from base to end-effector.
//   3. Compute 3-DoF spatial manipulator forward kinematics.
//   4. Extract end-effector Cartesian position and orientation.

import "./tf2_spatial_transform.oo";
import "./kinematics_dh_parameters.oo";

pub type KinematicChain3DoF = struct {
    link1: DHParameter,
    link2: DHParameter,
    link3: DHParameter,
};

pub type ForwardKinematicsResult = struct {
    end_effector_pos: Vector3,
    transform: Matrix4x4Homogeneous,
};

pub fn matrix4x4_identity() -> Matrix4x4Homogeneous {
    return Matrix4x4Homogeneous {
        r11: 1.0, r12: 0.0, r13: 0.0, tx: 0.0,
        r21: 0.0, r22: 1.0, r23: 0.0, ty: 0.0,
        r31: 0.0, r32: 0.0, r33: 1.0, tz: 0.0,
    };
}

pub fn matrix4x4_multiply(
    a: &Matrix4x4Homogeneous,
    b: &Matrix4x4Homogeneous
) -> Matrix4x4Homogeneous {
    return Matrix4x4Homogeneous {
        r11: ((a).r11 * (b).r11) + ((a).r12 * (b).r21) + ((a).r13 * (b).r31),
        r12: ((a).r11 * (b).r12) + ((a).r12 * (b).r22) + ((a).r13 * (b).r32),
        r13: ((a).r11 * (b).r13) + ((a).r12 * (b).r23) + ((a).r13 * (b).r33),
        tx:  ((a).r11 * (b).tx)  + ((a).r12 * (b).ty)  + ((a).r13 * (b).tz)  + (a).tx,

        r21: ((a).r21 * (b).r11) + ((a).r22 * (b).r21) + ((a).r23 * (b).r31),
        r22: ((a).r21 * (b).r12) + ((a).r22 * (b).r22) + ((a).r23 * (b).r32),
        r23: ((a).r21 * (b).r13) + ((a).r22 * (b).r23) + ((a).r23 * (b).r33),
        ty:  ((a).r21 * (b).tx)  + ((a).r22 * (b).ty)  + ((a).r23 * (b).tz)  + (a).ty,

        r31: ((a).r31 * (b).r11) + ((a).r32 * (b).r21) + ((a).r33 * (b).r31),
        r32: ((a).r31 * (b).r12) + ((a).r32 * (b).r22) + ((a).r33 * (b).r32),
        r33: ((a).r31 * (b).r13) + ((a).r32 * (b).r23) + ((a).r33 * (b).r33),
        tz:  ((a).r31 * (b).tx)  + ((a).r32 * (b).ty)  + ((a).r33 * (b).tz)  + (a).tz,
    };
}

pub fn kinematics_chain_3dof_new(
    l1: DHParameter,
    l2: DHParameter,
    l3: DHParameter
) -> KinematicChain3DoF {
    return KinematicChain3DoF {
        link1: l1,
        link2: l2,
        link3: l3,
    };
}

pub fn kinematics_fk_3dof(
    chain: &KinematicChain3DoF,
    q1: Float,
    q2: Float,
    q3: Float
) -> ForwardKinematicsResult {
    let mut dh1: DHParameter = (chain).link1;
    let mut dh2: DHParameter = (chain).link2;
    let mut dh3: DHParameter = (chain).link3;

    dh1.theta = q1;
    dh2.theta = q2;
    dh3.theta = q3;

    let t1: Matrix4x4Homogeneous = dh_compute_matrix(&dh1);
    let t2: Matrix4x4Homogeneous = dh_compute_matrix(&dh2);
    let t3: Matrix4x4Homogeneous = dh_compute_matrix(&dh3);

    let t12: Matrix4x4Homogeneous = matrix4x4_multiply(&t1, &t2);
    let t123: Matrix4x4Homogeneous = matrix4x4_multiply(&t12, &t3);

    let pos: Vector3 = matrix4x4_get_translation(&t123);
    return ForwardKinematicsResult {
        end_effector_pos: pos,
        transform: t123,
    };
}
