// # Servo Motor and Actuator Controller
//
// Logline: Generate high-precision PWM pulse widths and compute closed-loop PID control outputs for robotic actuators.
//
// Setup: Pure robotics control loop for joint positioning and motion profiles.
//
// Beats:
//   1. Map angular positions (-90 to +90 deg) to PWM pulse widths (1000 to 2000 us).
//   2. Compute proportional, integral, and derivative (PID) error corrections.
//   3. Clamp duty cycle outputs within hardware safety limits.
//   4. Generate trapezoidal velocity profiles for smooth joint acceleration.

pub type ServoControllerState = struct {
    target_angle_deg: Int,
    current_angle_deg: Int,
    pwm_pulse_width_us: Int,
    is_clamped: Bool
};

pub fn servo_controller_angle_to_pwm(angle_deg: Int) -> Int {
    let mut a: Int = angle_deg;
    if a < (0 - 90) { a = 0 - 90; }
    if a > 90 { a = 90; }
    let scaled: Int = ((a + 90) * 1000) / 180;
    return 1000 + scaled;
}

pub fn servo_controller_state_new(target: Int, current: Int) -> ServoControllerState {
    let pwm: Int = servo_controller_angle_to_pwm(target);
    return ServoControllerState {
        target_angle_deg: target,
        current_angle_deg: current,
        pwm_pulse_width_us: pwm,
        is_clamped: false
    };
}

pub fn servo_controller_compute_error(state: ServoControllerState) -> Int {
    let t: Int = state.target_angle_deg;
    let c: Int = state.current_angle_deg;
    return t - c;
}
