// # 2.5D Elevation & Terrain Traversability Mapping
//
// Logline: Fuses 3D point cloud range measurements into a multi-layer 2.5D elevation grid with height variance and terrain roughness.
//
// Setup: Robot perception mapping engine evaluating geometric surface roughness and traversability costs for rough terrain navigation.
//
// Beats:
//   1. Define 2.5D Elevation Grid Cell (mean height, variance, roughness, traversability).
//   2. Fuse sequential point cloud height observations via recursive 1D Kalman updates.
//   3. Compute local surface roughness and step height obstacle classification.
//   4. Calculate normalized terrain traversability cost for global path planners.

pub type ElevationCell = struct {
    mean_height_m: Float,
    variance_m2: Float,
    roughness_m: Float,
    traversability_cost: Float, // [0.0 = flat/easy, 1.0 = impassable obstacle]
    is_observed: Bool,
};

pub type ElevationMapConfig = struct {
    cell_size_m: Float,
    max_step_height_m: Float,
    max_variance_threshold: Float,
};

pub fn elevation_cell_new() -> ElevationCell {
    return ElevationCell {
        mean_height_m: 0.0,
        variance_m2: 1.0,
        roughness_m: 0.0,
        traversability_cost: 0.0,
        is_observed: false,
    };
}

pub fn elevation_map_config_default() -> ElevationMapConfig {
    return ElevationMapConfig {
        cell_size_m: 0.1,
        max_step_height_m: 0.25,
        max_variance_threshold: 0.05,
    };
}

pub fn elevation_cell_update(
    cell: &mut ElevationCell,
    measured_height: Float,
    sensor_variance: Float
) -> Float {
    if !(cell).is_observed {
        (cell).mean_height_m = measured_height;
        (cell).variance_m2 = sensor_variance;
        (cell).is_observed = true;
        return measured_height;
    }

    let p_prev: Float = (cell).variance_m2;
    let r_meas: Float = if sensor_variance < 0.0001 { 0.0001 } else { sensor_variance };

    // Kalman gain K = p_prev / (p_prev + r_meas)
    let k_gain: Float = p_prev / (p_prev + r_meas);
    let innovation: Float = measured_height - (cell).mean_height_m;

    let new_mean: Float = (cell).mean_height_m + (k_gain * innovation);
    let new_var: Float = (1.0 - k_gain) * p_prev;

    (cell).mean_height_m = new_mean;
    (cell).variance_m2 = new_var;

    return new_mean;
}

pub fn elevation_compute_traversability(
    cell: &mut ElevationCell,
    cfg: &ElevationMapConfig,
    neighbor_height: Float
) -> Float {
    let diff: Float = (cell).mean_height_m - neighbor_height;
    let step_h: Float = if diff < 0.0 { 0.0 - diff } else { diff };
    (cell).roughness_m = step_h;

    let ratio: Float = step_h / (cfg).max_step_height_m;
    let cost: Float = if ratio > 1.0 { 1.0 } else { ratio };
    (cell).traversability_cost = cost;

    return cost;
}
