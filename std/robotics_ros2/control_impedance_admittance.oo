// # Cartesian Impedance and Admittance Control
//
// Logline: Regulates physical contact interaction forces by establishing target virtual mass-spring-damper dynamics.
//
// Setup: Compliant interaction controller for safe physical human-robot collaboration and surface finishing.
//
// Beats:
//   1. Define Target Impedance parameters (virtual inertia M_d, damping D_d, stiffness K_d).
//   2. Compute Cartesian impedance restoring forces F = K_d*(x_d - x) + D_d*(v_d - v).
//   3. Implement Admittance filter integrating force measurements into trajectory position offsets.
//   4. Ensure passivity and stability of coupled environmental interaction.

pub type ImpedanceParameters2D = struct {
    mass_d: Float,
    damping_d: Float,
    stiffness_d: Float
};

pub type AdmittanceState2D = struct {
    disp_x: Float,
    disp_y: Float,
    vel_x: Float,
    vel_y: Float
};

pub fn impedance_params_new(m: Float, d: Float, k: Float) -> ImpedanceParameters2D {
    return ImpedanceParameters2D {
        mass_d: m,
        damping_d: d,
        stiffness_d: k
    };
}

pub fn admittance_state_zero() -> AdmittanceState2D {
    return AdmittanceState2D {
        disp_x: 0.0,
        disp_y: 0.0,
        vel_x: 0.0,
        vel_y: 0.0
    };
}

pub fn impedance_compute_force_2d(
    params: &ImpedanceParameters2D,
    x_des: Float, y_des: Float,
    vx_des: Float, vy_des: Float,
    x_curr: Float, y_curr: Float,
    vx_curr: Float, vy_curr: Float
) -> AdmittanceState2D {
    let ex: Float = x_des - x_curr;
    let ey: Float = y_des - y_curr;

    let dex: Float = vx_des - vx_curr;
    let dey: Float = vy_des - vy_curr;

    let fx: Float = ((params).stiffness_d * ex) + ((params).damping_d * dex);
    let fy: Float = ((params).stiffness_d * ey) + ((params).damping_d * dey);

    return AdmittanceState2D {
        disp_x: fx,
        disp_y: fy,
        vel_x: 0.0,
        vel_y: 0.0
    };
}

pub fn admittance_filter_step(
    state: &mut AdmittanceState2D,
    params: &ImpedanceParameters2D,
    f_ext_x: Float,
    f_ext_y: Float,
    dt: Float
) -> Int {
    let m: Float = if (params).mass_d < 0.01 { 0.01 } else { (params).mass_d };
    let inv_m: Float = 1.0 / m;

    // M_d * acc + D_d * vel + K_d * disp = F_ext  =>  acc = (F_ext - D_d*vel - K_d*disp) / M_d
    let ax: Float = (f_ext_x - ((params).damping_d * (state).vel_x) - ((params).stiffness_d * (state).disp_x)) * inv_m;
    let ay: Float = (f_ext_y - ((params).damping_d * (state).vel_y) - ((params).stiffness_d * (state).disp_y)) * inv_m;

    (state).vel_x = (state).vel_x + (ax * dt);
    (state).vel_y = (state).vel_y + (ay * dt);

    (state).disp_x = (state).disp_x + ((state).vel_x * dt);
    (state).disp_y = (state).disp_y + ((state).vel_y * dt);

    return 0;
}
