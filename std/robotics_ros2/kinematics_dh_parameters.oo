// # Denavit-Hartenberg (DH) Kinematic Parameters
//
// Logline: Computes 4x4 homogeneous transformation matrices for Standard and Modified DH parameter conventions.
//
// Setup: Analytical kinematics engine parameterizing serial manipulator links.
//
// Beats:
//   1. Define DH parameter representation (link length a, twist alpha, offset d, joint angle theta).
//   2. Compute Standard DH homogeneous transformation matrix.
//   3. Compute Craig Modified DH homogeneous transformation matrix.
//   4. Convert 4x4 homogeneous matrices into 3D translation vectors and orientations.

import "./tf2_spatial_transform.oo";

pub type DHParameter = struct {
    a: Float,     // Link length (m)
    alpha: Float, // Link twist (rad)
    d: Float,     // Link offset (m)
    theta: Float, // Joint angle (rad)
    is_modified: Bool
};

pub type Matrix4x4Homogeneous = struct {
    r11: Float, r12: Float, r13: Float, tx: Float,
    r21: Float, r22: Float, r23: Float, ty: Float,
    r31: Float, r32: Float, r33: Float, tz: Float
};

pub fn dh_parameter_standard(a: Float, alpha: Float, d: Float, theta: Float) -> DHParameter {
    return DHParameter {
        a: a,
        alpha: alpha,
        d: d,
        theta: theta,
        is_modified: false
    };
}

pub fn dh_parameter_modified(a: Float, alpha: Float, d: Float, theta: Float) -> DHParameter {
    return DHParameter {
        a: a,
        alpha: alpha,
        d: d,
        theta: theta,
        is_modified: true
    };
}

pub fn dh_compute_transform_standard(dh: &DHParameter) -> Matrix4x4Homogeneous {
    let ct: Float = cos((dh).theta);
    let st: Float = sin((dh).theta);
    let ca: Float = cos((dh).alpha);
    let sa: Float = sin((dh).alpha);
    let a_val: Float = (dh).a;
    let d_val: Float = (dh).d;

    return Matrix4x4Homogeneous {
        r11: ct,
        r12: 0.0 - (st * ca),
        r13: st * sa,
        tx:  a_val * ct,

        r21: st,
        r22: ct * ca,
        r23: 0.0 - (ct * sa),
        ty:  a_val * st,

        r31: 0.0,
        r32: sa,
        r33: ca,
        tz:  d_val
    };
}

pub fn dh_compute_transform_modified(dh: &DHParameter) -> Matrix4x4Homogeneous {
    // Modified DH: Rot_x(alpha_{i-1}) * Trans_x(a_{i-1}) * Rot_z(theta_i) * Trans_z(d_i)
    let ct: Float = cos((dh).theta);
    let st: Float = sin((dh).theta);
    let ca: Float = cos((dh).alpha);
    let sa: Float = sin((dh).alpha);
    let a_val: Float = (dh).a;
    let d_val: Float = (dh).d;

    return Matrix4x4Homogeneous {
        r11: ct,
        r12: 0.0 - st,
        r13: 0.0,
        tx:  a_val,

        r21: st * ca,
        r22: ct * ca,
        r23: 0.0 - sa,
        ty:  0.0 - (d_val * sa),

        r31: st * sa,
        r32: ct * sa,
        r33: ca,
        tz:  d_val * ca
    };
}

pub fn dh_compute_matrix(dh: &DHParameter) -> Matrix4x4Homogeneous {
    if (dh).is_modified {
        return dh_compute_transform_modified(dh);
    } else {
        return dh_compute_transform_standard(dh);
    }
}

pub fn matrix4x4_get_translation(m: &Matrix4x4Homogeneous) -> Vector3 {
    return vector3_new((m).tx, (m).ty, (m).tz);
}
