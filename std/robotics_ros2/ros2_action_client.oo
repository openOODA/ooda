// # ROS2 Action Client Goal Manager
//
// Logline: Tracks client-side action goal submission, feedback reception, cancellation requests, and terminal results.
//
// Setup: Pure action client state tracker coordinating goal futures and asynchronous status transitions.
//
// Beats:
//   1. Define ActionClient and GoalHandle tracking structs.
//   2. Send goal requests and assign monotonic goal IDs.
//   3. Process incoming progress feedback from action servers.
//   4. Request goal cancellation and process final result status.

pub type ActionGoalHandle = struct {
    goal_id: Int,
    is_active: Bool,
    feedback_received: Int,
    status: Int, // 0=Pending, 1=Accepted, 2=Executing, 3=Canceling, 4=Succeeded, 5=Canceled, 6=Aborted
    cancel_requested: Bool
};

pub type ActionClient = struct {
    action_id: Int,
    next_goal_id: Int,
    active_goals: Int,
    total_completed: Int
};

pub fn action_client_new(action_id: Int) -> ActionClient {
    return ActionClient {
        action_id: action_id,
        next_goal_id: 1,
        active_goals: 0,
        total_completed: 0
    };
}

pub fn action_client_send_goal(client: &mut ActionClient) -> ActionGoalHandle {
    let gid: Int = (client).next_goal_id;
    (client).next_goal_id = (client).next_goal_id + 1;
    (client).active_goals = (client).active_goals + 1;

    return ActionGoalHandle {
        goal_id: gid,
        is_active: true,
        feedback_received: 0,
        status: 1, // Accepted
        cancel_requested: false
    };
}

pub fn action_goal_handle_feedback(handle: &mut ActionGoalHandle) -> Int {
    if !(handle).is_active {
        return -1;
    }
    (handle).feedback_received = (handle).feedback_received + 1;
    (handle).status = 2; // Executing
    return (handle).feedback_received;
}

pub fn action_goal_cancel(handle: &mut ActionGoalHandle) -> Bool {
    if !(handle).is_active || (handle).status >= 4 {
        return false;
    }
    (handle).cancel_requested = true;
    (handle).status = 3; // Canceling
    return true;
}

pub fn action_goal_complete(
    client: &mut ActionClient,
    handle: &mut ActionGoalHandle,
    terminal_status: Int
) -> Bool {
    if !(handle).is_active {
        return false;
    }
    (handle).is_active = false;
    (handle).status = terminal_status;
    if (client).active_goals > 0 {
        (client).active_goals = (client).active_goals - 1;
    }
    (client).total_completed = (client).total_completed + 1;
    return true;
}
