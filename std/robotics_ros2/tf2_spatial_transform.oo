// # TF2 Spatial Rigid-Body Transformations SE(3)
//
// Logline: 3D rigid body kinematics and coordinate transformations using translation vectors and unit quaternions.
//
// Setup: Geometric algebra engine for SE(3) frame operations, coordinate compounding, and point transformation.
//
// Beats:
//   1. Define 3D Vector, Unit Quaternion, and SE(3) Transform structures.
//   2. Implement Quaternion normalization, conjugation, and Hamilton multiplication.
//   3. Transform 3D points and vectors across reference coordinate frames.
//   4. Compute transform compounding (T_a_c = T_a_b * T_b_c) and matrix inversion.

pub type Vector3 = struct {
    x: Float,
    y: Float,
    z: Float,
};

pub type Quaternion = struct {
    x: Float,
    y: Float,
    z: Float,
    w: Float,
};

pub type Transform3D = struct {
    translation: Vector3,
    rotation: Quaternion,
};

pub fn vector3_new(x: Float, y: Float, z: Float) -> Vector3 {
    return Vector3 { x: x, y: y, z: z };
}

pub fn vector3_zero() -> Vector3 {
    return Vector3 { x: 0.0, y: 0.0, z: 0.0 };
}

pub fn vector3_add(a: &Vector3, b: &Vector3) -> Vector3 {
    return Vector3 {
        x: (a).x + (b).x,
        y: (a).y + (b).y,
        z: (a).z + (b).z,
    };
}

pub fn quaternion_new(x: Float, y: Float, z: Float, w: Float) -> Quaternion {
    return Quaternion { x: x, y: y, z: z, w: w };
}

pub fn quaternion_identity() -> Quaternion {
    return Quaternion { x: 0.0, y: 0.0, z: 0.0, w: 1.0 };
}

pub fn quaternion_norm_sq(q: &Quaternion) -> Float {
    return ((q).x * (q).x) + ((q).y * (q).y) + ((q).z * (q).z) + ((q).w * (q).w);
}

pub fn quaternion_normalize(q: &Quaternion) -> Quaternion {
    let n_sq: Float = quaternion_norm_sq(q);
    if n_sq < 0.000001 {
        return quaternion_identity();
    }
    let inv_n: Float = 1.0 / sqrt(n_sq);
    return Quaternion {
        x: (q).x * inv_n,
        y: (q).y * inv_n,
        z: (q).z * inv_n,
        w: (q).w * inv_n,
    };
}

pub fn quaternion_conjugate(q: &Quaternion) -> Quaternion {
    return Quaternion {
        x: 0.0 - (q).x,
        y: 0.0 - (q).y,
        z: 0.0 - (q).z,
        w: (q).w,
    };
}

pub fn quaternion_multiply(q1: &Quaternion, q2: &Quaternion) -> Quaternion {
    return Quaternion {
        w: ((q1).w * (q2).w) - ((q1).x * (q2).x) - ((q1).y * (q2).y) - ((q1).z * (q2).z),
        x: ((q1).w * (q2).x) + ((q1).x * (q2).w) + ((q1).y * (q2).z) - ((q1).z * (q2).y),
        y: ((q1).w * (q2).y) - ((q1).x * (q2).z) + ((q1).y * (q2).w) + ((q1).z * (q2).x),
        z: ((q1).w * (q2).z) + ((q1).x * (q2).y) - ((q1).y * (q2).x) + ((q1).z * (q2).w),
    };
}

pub fn quaternion_rotate_vector(q: &Quaternion, v: &Vector3) -> Vector3 {
    let q_vec: Quaternion = Quaternion { x: (v).x, y: (v).y, z: (v).z, w: 0.0 };
    let q_conj: Quaternion = quaternion_conjugate(q);
    let q_tmp: Quaternion = quaternion_multiply(q, &q_vec);
    let q_res: Quaternion = quaternion_multiply(&q_tmp, &q_conj);
    return Vector3 { x: (q_res).x, y: (q_res).y, z: (q_res).z };
}

pub fn transform3d_new(t: Vector3, q: Quaternion) -> Transform3D {
    return Transform3D {
        translation: t,
        rotation: quaternion_normalize(&q),
    };
}

pub fn transform3d_identity() -> Transform3D {
    return Transform3D {
        translation: vector3_zero(),
        rotation: quaternion_identity(),
    };
}

pub fn transform3d_apply_point(t: &Transform3D, p: &Vector3) -> Vector3 {
    let rot_p: Vector3 = quaternion_rotate_vector(&(t).rotation, p);
    return vector3_add(&rot_p, &(t).translation);
}

pub fn transform3d_multiply(t1: &Transform3D, t2: &Transform3D) -> Transform3D {
    let rot: Quaternion = quaternion_multiply(&(t1).rotation, &(t2).rotation);
    let rot_trans2: Vector3 = quaternion_rotate_vector(&(t1).rotation, &(t2).translation);
    let trans: Vector3 = vector3_add(&(t1).translation, &rot_trans2);
    return Transform3D {
        translation: trans,
        rotation: quaternion_normalize(&rot),
    };
}

pub fn transform3d_inverse(t: &Transform3D) -> Transform3D {
    let inv_rot: Quaternion = quaternion_conjugate(&(t).rotation);
    let inv_t_raw: Vector3 = quaternion_rotate_vector(&inv_rot, &(t).translation);
    let inv_trans: Vector3 = Vector3 {
        x: 0.0 - (inv_t_raw).x,
        y: 0.0 - (inv_t_raw).y,
        z: 0.0 - (inv_t_raw).z,
    };
    return Transform3D {
        translation: inv_trans,
        rotation: inv_rot,
    };
}
