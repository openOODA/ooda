// -------------------------------------------------------------------
// Unified Robotics Node & Controller Configuration
// -------------------------------------------------------------------

pub type RoboticsSystem = struct {
    system_id: Int,
    loop_frequency_hz: Float,
    is_active: Bool,
};

pub fn robotics_system_new(system_id: Int, freq_hz: Float) -> RoboticsSystem {
    return RoboticsSystem {
        system_id: system_id,
        loop_frequency_hz: freq_hz,
        is_active: true,
    };
}

// -------------------------------------------------------------------
// Facade Convenience Shims & Factory Constructors
// -------------------------------------------------------------------

pub fn create_ros2_publisher(topic_id: Int) -> TopicPublisher {
    return topic_publisher_new(topic_id, topic_qos_default());
}

pub fn create_ros2_subscriber(topic_id: Int) -> TopicSubscriber {
    return topic_subscriber_new(topic_id, topic_qos_default());
}

pub fn create_tf2_transform(x: Float, y: Float, z: Float) -> Transform3D {
    return transform3d_new(vector3_new(x, y, z), quaternion_identity());
}

pub fn create_pid_controller(kp: Float, ki: Float, kd: Float, max_effort: Float) -> PIDConfig {
    return pid_config_new(kp, ki, kd, 0.0 - max_effort, max_effort);
}

pub fn create_quintic_trajectory(
    q0: Float, q1: Float,
    v0: Float, v1: Float,
    total_time: Float
) -> QuinticCoeffs {
    return quintic_solve(q0, v0, 0.0, q1, v1, 0.0, total_time);
}

pub fn create_trapezoidal_profile(
    q0: Float, q1: Float,
    v_max: Float, a_max: Float
) -> TrapezoidalProfile {
    return trapezoidal_profile_plan(q0, q1, v_max, a_max);
}

pub fn create_gjk_contact_test(
    c1: Vector3, r1: Float,
    c2: Vector3, r2: Float
) -> GJKContact {
    return gjk_sphere_sphere_test(&c1, r1, &c2, r2);
}
