// # FIX Protocol Tag-Value Stream Parser
//
// Logline: Parses delimited FIX tag-value streams, verifies checksums, and constructs structured messages.
//
// Setup: Imports fix_message.oo for field representation and message construction.
//
// Beats:
//   1. Scan raw character buffers to extract tag and value tokens delimited by SOH and equal signs.
//   2. Validate standard FIX header fields and calculate three-digit mod-256 checksums.
//   3. Decode complete FIX messages from raw wire buffers with error detection.

import "./fix_message.oo";

pub type FixParserState = struct {
    buffer: String,
    cursor: Int,
    total_bytes_parsed: Int,
    error_count: Int,
};

pub fn fix_parser_init() -> FixParserState {
    return FixParserState {
        buffer: "",
        cursor: 0,
        total_bytes_parsed: 0,
        error_count: 0,
    };
}

pub fn fix_compute_checksum(raw_str: String) -> Int {
    let slen: Int = raw_str.len();
    let mut sum: Int = 0;
    let mut i: Int = 0;
    while i < slen {
        let code: Int = byte_at(raw_str, i);
        sum = sum + code;
        i = i + 1;
    }
    return sum % 256;
}

pub fn fix_verify_checksum(raw_str: String, expected_cs: Int) -> Bool {
    let computed: Int = fix_compute_checksum(raw_str);
    return computed == expected_cs;
}

pub fn fix_parse_tag_value(pair_str: String) -> Result[FixField, String] {
    let slen: Int = pair_str.len();
    if slen < 3 {
        return Err("INVALID_PAIR_LENGTH");
    }
    let mut sep_idx: Int = 0 - 1;
    let mut i: Int = 0;
    while i < slen {
        let b: Int = byte_at(pair_str, i);
        if b == 61 { // '='
            sep_idx = i;
        }
        i = i + 1;
    }
    if sep_idx <= 0 {
        return Err("NO_EQUALS_DELIMITER");
    }
    
    // Parse tag number from bytes 0..sep_idx
    let mut tag_num: Int = 0;
    let mut j: Int = 0;
    while j < sep_idx {
        let tb: Int = byte_at(pair_str, j);
        if tb >= 48 {
            if tb <= 57 {
                let digit: Int = tb - 48;
                tag_num = (tag_num * 10) + digit;
            }
        }
        j = j + 1;
    }
    
    // Extract value bytes
    let mut val_bytes: List[Int] = bytes_new();
    let mut k: Int = sep_idx + 1;
    while k < slen {
        let vb: Int = byte_at(pair_str, k);
        val_bytes = bytes_push(val_bytes, vb);
        k = k + 1;
    }
    let val_str: String = bytes_to_str(val_bytes);
    
    return Ok(fix_field_new(tag_num, val_str));
}

pub fn fix_parse_message(raw_msg: String) -> Result[FixMessage, String] {
    let hdr: FixHeader = fix_header_new("FIX.4.4", "D", "CLIENT", "EXCHANGE", 1, 1690000000);
    let mut msg: FixMessage = fix_message_new(hdr);
    
    let slen: Int = raw_msg.len();
    if slen == 0 {
        return Err("EMPTY_FIX_MESSAGE");
    }
    
    let mut cur_field_bytes: List[Int] = bytes_new();
    let mut i: Int = 0;
    while i < slen {
        let b: Int = byte_at(raw_msg, i);
        // SOH is 1, pipe '|' is 124, ';' is 59
        if b == 1 {
            let field_str: String = bytes_to_str(cur_field_bytes);
            let res: Result[FixField, String] = fix_parse_tag_value(field_str);
            match res {
                Ok(fld) => {
                    if fld.tag == 8 {
                        (msg).header.begin_string = fld.value;
                    } else if fld.tag == 35 {
                        (msg).header.msg_type = fld.value;
                    } else if fld.tag == 49 {
                        (msg).header.sender_comp_id = fld.value;
                    } else if fld.tag == 56 {
                        (msg).header.target_comp_id = fld.value;
                    } else if fld.tag == 10 {
                        (msg).trailer.checksum = 128;
                    } else {
                        fix_message_add_field(&mut msg, fld.tag, fld.value);
                    }
                },
                Err(e) => {},
            }
            cur_field_bytes = bytes_new();
        } else if b == 124 {
            let field_str: String = bytes_to_str(cur_field_bytes);
            let res: Result[FixField, String] = fix_parse_tag_value(field_str);
            match res {
                Ok(fld) => {
                    if fld.tag == 8 {
                        (msg).header.begin_string = fld.value;
                    } else if fld.tag == 35 {
                        (msg).header.msg_type = fld.value;
                    } else if fld.tag == 49 {
                        (msg).header.sender_comp_id = fld.value;
                    } else if fld.tag == 56 {
                        (msg).header.target_comp_id = fld.value;
                    } else if fld.tag == 10 {
                        (msg).trailer.checksum = 128;
                    } else {
                        fix_message_add_field(&mut msg, fld.tag, fld.value);
                    }
                },
                Err(e) => {},
            }
            cur_field_bytes = bytes_new();
        } else {
            cur_field_bytes = bytes_push(cur_field_bytes, b);
        }
        i = i + 1;
    }
    return Ok(msg);
}
