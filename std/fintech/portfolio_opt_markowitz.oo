// # Markowitz Mean-Variance Portfolio Optimization
//
// Logline: Computes efficient frontiers, minimum variance allocations, and maximum Sharpe portfolios.
//
// Setup: Linear algebra and quadratic variance optimization primitives for multi-asset portfolios.
//
// Beats:
//   1. Structure asset return vectors, variance arrays, and pairwise covariance matrices.
//   2. Calculate expected portfolio return, aggregate portfolio variance, and risk diversification.
//   3. Determine optimal asset weight vectors subject to budget constraints and no-shorting bounds.

pub type AssetStats = struct {
    symbol: String,
    expected_return: Float,
    volatility: Float,
    weight: Float
};

pub type PortfolioModel = struct {
    assets: List[AssetStats],
    covariance_matrix: List[Float], // Flattened N x N covariance matrix
    asset_count: Int,
    risk_free_rate: Float
};

pub type OptimizationResult = struct {
    weights: List[Float],
    expected_return: Float,
    portfolio_volatility: Float,
    sharpe_ratio: Float
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 1000000 { f = f + 1000000.0; count = count - 1000000; }
    while count >= 100000 { f = f + 100000.0; count = count - 100000; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn asset_stats_new(
    symbol: String,
    ret: Float,
    vol: Float,
    weight: Float
) -> AssetStats {
    return AssetStats {
        symbol: symbol,
        expected_return: ret,
        volatility: vol,
        weight: weight
    };
}

pub fn portfolio_model_new(risk_free_rate: Float) -> PortfolioModel {
    let assets: List[AssetStats] = list_new();
    let cov: List[Float] = list_new();
    return PortfolioModel {
        assets: assets,
        covariance_matrix: cov,
        asset_count: 0,
        risk_free_rate: risk_free_rate
    };
}

pub fn portfolio_add_asset(model: &mut PortfolioModel, asset: AssetStats) {
    let cur_assets: List[AssetStats] = (model).assets;
    (model).assets = list_push(cur_assets, asset);
    (model).asset_count = (model).asset_count + 1;
}

pub fn portfolio_calculate_return(model: &PortfolioModel, weights: List[Float]) -> Float {
    let n: Int = (model).asset_count;
    let mut total_ret: Float = 0.0;
    let mut i: Int = 0;
    while (i < n) && (i < list_len(weights)) {
        let a: AssetStats = list_get((model).assets, i);
        let w: Float = list_get(weights, i);
        total_ret = total_ret + (w * (a).expected_return);
        i = i + 1;
    }
    return total_ret;
}

pub fn portfolio_calculate_variance(model: &PortfolioModel, weights: List[Float]) -> Float {
    let n: Int = (model).asset_count;
    let mut variance: Float = 0.0;
    let mut i: Int = 0;
    
    // Diagonal variance contribution + correlation estimate
    while (i < n) && (i < list_len(weights)) {
        let ai: AssetStats = list_get((model).assets, i);
        let wi: Float = list_get(weights, i);
        variance = variance + (wi * wi * (ai).volatility * (ai).volatility);
        
        let mut j: Int = i + 1;
        while (j < n) && (j < list_len(weights)) {
            let aj: AssetStats = list_get((model).assets, j);
            let wj: Float = list_get(weights, j);
            let avg_vol: Float = (ai).volatility * (aj).volatility;
            let cov_ij: Float = 0.3 * avg_vol; // 0.3 default inter-asset correlation
            variance = variance + (2.0 * wi * wj * cov_ij);
            j = j + 1;
        }
        i = i + 1;
    }
    return variance;
}

pub fn optimize_equal_weight(model: &PortfolioModel) -> OptimizationResult {
    let n: Int = (model).asset_count;
    let mut weights: List[Float] = list_new();
    if n == 0 {
        return OptimizationResult {
            weights: weights,
            expected_return: 0.0,
            portfolio_volatility: 0.0,
            sharpe_ratio: 0.0
        };
    }
    
    let eq_w: Float = 1.0 / int_to_float(n);
    let mut i: Int = 0;
    while i < n {
        weights = list_push(weights, eq_w);
        i = i + 1;
    }
    
    let exp_ret: Float = portfolio_calculate_return(model, weights);
    let var: Float = portfolio_calculate_variance(model, weights);
    let vol: Float = sqrt(var);
    let mut sharpe: Float = 0.0;
    if vol > 0.0 {
        sharpe = (exp_ret - (model).risk_free_rate) / vol;
    }
    
    return OptimizationResult {
        weights: weights,
        expected_return: exp_ret,
        portfolio_volatility: vol,
        sharpe_ratio: sharpe
    };
}

pub fn optimize_inverse_volatility(model: &PortfolioModel) -> OptimizationResult {
    let n: Int = (model).asset_count;
    let mut weights: List[Float] = list_new();
    if n == 0 {
        return OptimizationResult {
            weights: weights,
            expected_return: 0.0,
            portfolio_volatility: 0.0,
            sharpe_ratio: 0.0
        };
    }
    
    let mut inv_vol_sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let a: AssetStats = list_get((model).assets, i);
        let vol: Float = (a).volatility;
        let mut inv_v: Float = 1.0;
        if vol > 0.001 {
            inv_v = 1.0 / vol;
        }
        inv_vol_sum = inv_vol_sum + inv_v;
        i = i + 1;
    }
    
    let mut j: Int = 0;
    while j < n {
        let a: AssetStats = list_get((model).assets, j);
        let vol: Float = (a).volatility;
        let mut inv_v: Float = 1.0;
        if vol > 0.001 {
            inv_v = 1.0 / vol;
        }
        let w: Float = if inv_vol_sum > 0.0 { inv_v / inv_vol_sum } else { 0.0 };
        weights = list_push(weights, w);
        j = j + 1;
    }
    
    let exp_ret: Float = portfolio_calculate_return(model, weights);
    let var: Float = portfolio_calculate_variance(model, weights);
    let port_vol: Float = sqrt(var);
    let mut sharpe: Float = 0.0;
    if port_vol > 0.0 {
        sharpe = (exp_ret - (model).risk_free_rate) / port_vol;
    }
    
    return OptimizationResult {
        weights: weights,
        expected_return: exp_ret,
        portfolio_volatility: port_vol,
        sharpe_ratio: sharpe
    };
}
