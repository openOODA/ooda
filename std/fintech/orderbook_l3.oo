// # Level-3 Individual Order Market Depth Book
//
// Logline: Manages granular Level-3 order queues with FIFO price-time priority and queue position tracking.
//
// Setup: Pure Level 3 orderbook structures for individual resting orders.
//
// Beats:
//   1. Index individual resting limit orders with unique order identifiers and precise timestamps.
//   2. Insert new orders into price-time sorted FIFO bid and ask queues.
//   3. Modify order quantities, cancel orders in-place, and compute queue position priority.

pub type L3Order = struct {
    order_id: Int,
    price: Int,
    quantity: Int,
    filled_qty: Int,
    timestamp_ns: Int,
    is_buy: Bool,
    priority_index: Int
};

pub type OrderBookL3 = struct {
    symbol: String,
    bid_orders: List[L3Order],
    ask_orders: List[L3Order],
    total_bids_qty: Int,
    total_asks_qty: Int,
    order_count: Int
};

pub fn l3_order_new(
    order_id: Int,
    price: Int,
    qty: Int,
    timestamp_ns: Int,
    is_buy: Bool
) -> L3Order {
    return L3Order {
        order_id: order_id,
        price: price,
        quantity: qty,
        filled_qty: 0,
        timestamp_ns: timestamp_ns,
        is_buy: is_buy,
        priority_index: 0
    };
}

pub fn l3_order_remaining(order: &L3Order) -> Int {
    let rem: Int = (order).quantity - (order).filled_qty;
    if rem > 0 {
        return rem;
    }
    return 0;
}

pub fn orderbook_l3_new(symbol: String) -> OrderBookL3 {
    let bids: List[L3Order] = list_new();
    let asks: List[L3Order] = list_new();
    return OrderBookL3 {
        symbol: symbol,
        bid_orders: bids,
        ask_orders: asks,
        total_bids_qty: 0,
        total_asks_qty: 0,
        order_count: 0
    };
}

pub fn orderbook_l3_add_order(book: &mut OrderBookL3, order: L3Order) -> Bool {
    let mut o = order;
    o.priority_index = (book).order_count + 1;
    let qty: Int = l3_order_remaining(&o);
    
    if o.is_buy {
        let mut new_bids: List[L3Order] = list_new();
        let old_bids: List[L3Order] = (book).bid_orders;
        let n: Int = list_len(old_bids);
        let mut inserted: Bool = false;
        let mut i: Int = 0;
        
        while i < n {
            let cur: L3Order = list_get(old_bids, i);
            if (!inserted) && (o.price > cur.price) {
                new_bids = list_push(new_bids, o);
                inserted = true;
            }
            new_bids = list_push(new_bids, cur);
            i = i + 1;
        }
        if !inserted {
            new_bids = list_push(new_bids, o);
        }
        (book).bid_orders = new_bids;
        (book).total_bids_qty = (book).total_bids_qty + qty;
    } else {
        let mut new_asks: List[L3Order] = list_new();
        let old_asks: List[L3Order] = (book).ask_orders;
        let n: Int = list_len(old_asks);
        let mut inserted: Bool = false;
        let mut i: Int = 0;
        
        while i < n {
            let cur: L3Order = list_get(old_asks, i);
            if (!inserted) && (o.price < cur.price) {
                new_asks = list_push(new_asks, o);
                inserted = true;
            }
            new_asks = list_push(new_asks, cur);
            i = i + 1;
        }
        if !inserted {
            new_asks = list_push(new_asks, o);
        }
        (book).ask_orders = new_asks;
        (book).total_asks_qty = (book).total_asks_qty + qty;
    }
    
    (book).order_count = (book).order_count + 1;
    return true;
}

pub fn orderbook_l3_cancel_order(book: &mut OrderBookL3, order_id: Int) -> Result[L3Order, String] {
    let mut found_order: L3Order = l3_order_new(0, 0, 0, 0, false);
    let mut found: Bool = false;
    
    // Check bids
    let mut new_bids: List[L3Order] = list_new();
    let bids: List[L3Order] = (book).bid_orders;
    let n_bids: Int = list_len(bids);
    let mut i: Int = 0;
    while i < n_bids {
        let o: L3Order = list_get(bids, i);
        if o.order_id == order_id {
            found_order = o;
            found = true;
            (book).total_bids_qty = (book).total_bids_qty - l3_order_remaining(&o);
        } else {
            new_bids = list_push(new_bids, o);
        }
        i = i + 1;
    }
    (book).bid_orders = new_bids;
    
    if found {
        return Ok(found_order);
    }
    
    // Check asks
    let mut new_asks: List[L3Order] = list_new();
    let asks: List[L3Order] = (book).ask_orders;
    let n_asks: Int = list_len(asks);
    let mut j: Int = 0;
    while j < n_asks {
        let o: L3Order = list_get(asks, j);
        if o.order_id == order_id {
            found_order = o;
            found = true;
            (book).total_asks_qty = (book).total_asks_qty - l3_order_remaining(&o);
        } else {
            new_asks = list_push(new_asks, o);
        }
        j = j + 1;
    }
    (book).ask_orders = new_asks;
    
    if found {
        return Ok(found_order);
    }
    return Err("ORDER_NOT_FOUND");
}

pub fn orderbook_l3_best_bid(book: &OrderBookL3) -> Int {
    let n: Int = list_len((book).bid_orders);
    if n == 0 {
        return 0;
    }
    let top: L3Order = list_get((book).bid_orders, 0);
    return top.price;
}

pub fn orderbook_l3_best_ask(book: &OrderBookL3) -> Int {
    let n: Int = list_len((book).ask_orders);
    if n == 0 {
        return 0;
    }
    let top: L3Order = list_get((book).ask_orders, 0);
    return top.price;
}

pub fn orderbook_l3_queue_position(book: &OrderBookL3, order_id: Int) -> Int {
    let mut pos_qty: Int = 0;
    let bids: List[L3Order] = (book).bid_orders;
    let n_bids: Int = list_len(bids);
    let mut i: Int = 0;
    let mut target_price: Int = 0;
    let mut found: Bool = false;
    
    while (i < n_bids) && (!found) {
        let o: L3Order = list_get(bids, i);
        if o.order_id == order_id {
            target_price = o.price;
            found = true;
        }
        i = i + 1;
    }
    
    if found {
        let mut j: Int = 0;
        while j < n_bids {
            let o: L3Order = list_get(bids, j);
            if o.price == target_price {
                if o.order_id == order_id {
                    return pos_qty;
                }
                pos_qty = pos_qty + l3_order_remaining(&o);
            }
            j = j + 1;
        }
    }
    return 0;
}
