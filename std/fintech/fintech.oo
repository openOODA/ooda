pub fn shim_marker_fix_message() -> FixMessage {
    let hdr = fix_header_new("FIX.4.4", "D", "CLI", "EXCH", 1, 0);
    return fix_message_new(hdr);
}

pub fn shim_marker_fix_parser() -> FixParserState {
    return fix_parser_init();
}

pub fn shim_marker_fix_session() -> FixSession {
    let cfg = fix_session_config_new("CLI", "EXCH", 30, "FIX.4.4");
    return fix_session_new(cfg);
}

pub fn shim_marker_fast_decoder() -> FastDecoderState {
    return fast_decoder_init(100);
}

pub fn shim_marker_orderbook_l2() -> OrderBookL2 {
    return orderbook_l2_new("AAPL", 10);
}

pub fn shim_marker_orderbook_l3() -> OrderBookL3 {
    return orderbook_l3_new("AAPL");
}

pub fn shim_marker_matching_engine() -> MatchingEngine {
    return matching_engine_new("AAPL");
}

pub fn shim_marker_execution_report() -> ExecutionReportRecord {
    return exec_report_create(1, "CL01", "EX01", "AAPL", 1, 100, 15000, 0);
}

pub fn shim_marker_black_scholes() -> BsPriceResult {
    let opt = EuropeanOption {
        is_call: true,
        spot: 100.0,
        strike: 100.0,
        time_to_expiry: 1.0,
        risk_free_rate: 0.05,
        dividend_yield: 0.0,
        volatility: 0.20
    };
    return black_scholes_price(&opt);
}

pub fn shim_marker_greeks() -> OptionGreeks {
    let opt = EuropeanOption {
        is_call: true,
        spot: 100.0,
        strike: 100.0,
        time_to_expiry: 1.0,
        risk_free_rate: 0.05,
        dividend_yield: 0.0,
        volatility: 0.20
    };
    return calculate_analytic_greeks(&opt);
}

pub fn shim_marker_vol_surface() -> VolSurfaceModel {
    return vol_surface_model_new(0.20, -0.05, 0.10, 0.02, 100.0);
}

pub fn shim_marker_yield_curve() -> ZeroCurve {
    return zero_curve_new("USD_SOFR", 20260815);
}

pub fn shim_marker_bond_pricing() -> BondInstrument {
    return bond_instrument_new("US912828", 1000.0, 0.045, 2, 5.0);
}

pub fn shim_marker_monte_carlo_var() -> McVarConfig {
    return mc_var_config_new(1000000.0, 10, 1000, 0.95);
}

pub fn shim_marker_portfolio_opt() -> PortfolioModel {
    return portfolio_model_new(0.04);
}

pub fn shim_marker_market_data_tick() -> TickRecord {
    return tick_record_new("AAPL", 15000, 100, 14999, 15001, 500, 500, 0);
}

pub fn shim_marker_algo_engine() -> AlgoOrderConfig {
    return algo_config_new(1, "AAPL", 10000, true, 0, 3600000000000, 1);
}

pub fn shim_marker_fpml() -> FpmlTrade {
    let hdr = fpml_header_new("TR01", 20260815, 20260817, 20310817, "PTY_A", "PTY_B");
    return fpml_trade_new(hdr, "InterestRateSwap");
}

pub fn shim_marker_irs() -> IrsContract {
    return irs_contract_new("IRS01", 10000000.0, 450, 5.0, true);
}

pub fn shim_marker_fx() -> FxPair {
    return fx_pair_new("EUR", "USD", 1.0850, 1.0852, 0.0001);
}

pub fn shim_marker_margin() -> MarginAccount {
    return margin_account_new("ACC01", 50000.0);
}

pub fn shim_marker_settlement() -> SettlementBatch {
    return settlement_batch_new("BATCH01");
}

pub fn fintech_module_ready() -> Bool {
    return true;
}
