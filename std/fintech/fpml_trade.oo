// # Financial Products Markup Language (FpML) Trade Representation
//
// Logline: Structures OTC derivative transactions, trade headers, party roles, and payment schedules.
//
// Setup: Pure domain models for institutional FpML derivative contract lifecycles.
//
// Beats:
//   1. Structure FpML trade identifiers, party representations, trade dates, and settlement conventions.
//   2. Define OTC product taxonomy spanning interest rate derivatives, FX swaps, and credit default swaps.
//   3. Build payment schedule legs and business day adjustment conventions.

pub type FpmlParty = struct {
    party_id: String,
    party_name: String,
    account_id: String,
};

pub type FpmlHeader = struct {
    trade_id: String,
    trade_date: Int,
    effective_date: Int,
    termination_date: Int,
    party_a: String,
    party_b: String,
};

pub type FpmlLeg = struct {
    leg_id: Int,
    is_payer_party_a: Bool,
    notional: Float,
    currency: String,
    rate_or_spread_bps: Int,
    frequency_months: Int,
    day_count_convention: Int, // 0 = ACT_360, 1 = ACT_365, 2 = 30_360
};

pub type FpmlTrade = struct {
    header: FpmlHeader,
    product_type: String, // "InterestRateSwap", "FxForward", "CreditDefaultSwap"
    legs: List[FpmlLeg],
    is_confirmed: Bool,
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 1000000 { f = f + 1000000.0; count = count - 1000000; }
    while count >= 100000 { f = f + 100000.0; count = count - 100000; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn fpml_party_new(id: String, name: String, acct: String) -> FpmlParty {
    return FpmlParty {
        party_id: id,
        party_name: name,
        account_id: acct,
    };
}

pub fn fpml_header_new(
    trade_id: String,
    t_date: Int,
    eff_date: Int,
    term_date: Int,
    pa: String,
    pb: String
) -> FpmlHeader {
    return FpmlHeader {
        trade_id: trade_id,
        trade_date: t_date,
        effective_date: eff_date,
        termination_date: term_date,
        party_a: pa,
        party_b: pb,
    };
}

pub fn fpml_leg_new(
    leg_id: Int,
    is_party_a: Bool,
    notional: Float,
    ccy: String,
    rate_bps: Int,
    freq: Int,
    dc: Int
) -> FpmlLeg {
    return FpmlLeg {
        leg_id: leg_id,
        is_payer_party_a: is_party_a,
        notional: notional,
        currency: ccy,
        rate_or_spread_bps: rate_bps,
        frequency_months: freq,
        day_count_convention: dc,
    };
}

pub fn fpml_trade_new(header: FpmlHeader, product_type: String) -> FpmlTrade {
    let empty_legs: List[FpmlLeg] = list_new();
    return FpmlTrade {
        header: header,
        product_type: product_type,
        legs: empty_legs,
        is_confirmed: false,
    };
}

pub fn fpml_trade_add_leg(trade: &mut FpmlTrade, leg: FpmlLeg) {
    let cur_legs: List[FpmlLeg] = (trade).legs;
    (trade).legs = list_push(cur_legs, leg);
}

pub fn fpml_trade_confirm(trade: &mut FpmlTrade) {
    (trade).is_confirmed = true;
}

pub fn fpml_calc_period_cash_flow(leg: &FpmlLeg, year_fraction: Float) -> Float {
    let rate_dec: Float = int_to_float((leg).rate_or_spread_bps) / 10000.0;
    return (leg).notional * rate_dec * year_fraction;
}

pub fn fpml_trade_leg_count(trade: &FpmlTrade) -> Int {
    return list_len((trade).legs);
}
