// # High-Frequency Limit Order Matching Engine
//
// Logline: Executes deterministic price-time priority crossing, fill allocations, and uncrossing auctions.
//
// Setup: Imports orderbook_l3.oo for order queue management and execution generation.
//
// Beats:
//   1. Evaluate incoming market and limit orders against opposite resting liquidity queues.
//   2. Generate discrete MatchEvent records with aggressive vs passive order fill accounting.
//   3. Support continuous trading crossing cycles and opening/closing batch auction uncrossings.

import "./orderbook_l3.oo";

pub type MatchEvent = struct {
    match_id: Int,
    maker_order_id: Int,
    taker_order_id: Int,
    price: Int,
    quantity: Int,
    timestamp_ns: Int,
    is_maker_complete: Bool,
};

pub type EngineStats = struct {
    orders_processed: Int,
    trades_executed: Int,
    total_volume: Int,
    total_notional: Int,
    last_trade_price: Int,
};

pub type MatchingEngine = struct {
    symbol: String,
    book: OrderBookL3,
    next_match_id: Int,
    stats: EngineStats,
    is_halted: Bool,
};

pub fn match_event_new(
    match_id: Int,
    maker_id: Int,
    taker_id: Int,
    price: Int,
    qty: Int,
    time_ns: Int,
    complete: Bool
) -> MatchEvent {
    return MatchEvent {
        match_id: match_id,
        maker_order_id: maker_id,
        taker_order_id: taker_id,
        price: price,
        quantity: qty,
        timestamp_ns: time_ns,
        is_maker_complete: complete,
    };
}

pub fn matching_engine_new(symbol: String) -> MatchingEngine {
    let bk: OrderBookL3 = orderbook_l3_new(symbol);
    let st = EngineStats {
        orders_processed: 0,
        trades_executed: 0,
        total_volume: 0,
        total_notional: 0,
        last_trade_price: 0,
    };
    return MatchingEngine {
        symbol: symbol,
        book: bk,
        next_match_id: 1,
        stats: st,
        is_halted: false,
    };
}

pub fn matching_engine_submit_order(
    engine: &mut MatchingEngine,
    incoming: L3Order
) -> List[MatchEvent] {
    let mut matches: List[MatchEvent] = list_new();
    if (engine).is_halted {
        return matches;
    }
    
    let mut taker: L3Order = incoming;
    let mut rem_taker: Int = l3_order_remaining(&taker);
    if rem_taker <= 0 {
        return matches;
    }
    
    (engine).stats.orders_processed = (engine).stats.orders_processed + 1;
    
    if taker.is_buy {
        let mut new_asks: List[L3Order] = list_new();
        let old_asks: List[L3Order] = (engine).book.ask_orders;
        let n_asks: Int = list_len(old_asks);
        let mut i: Int = 0;
        
        while i < n_asks {
            let mut maker: L3Order = list_get(old_asks, i);
            let rem_maker: Int = l3_order_remaining(&maker);
            
            if (rem_taker > 0) && (rem_maker > 0) && (taker.price >= maker.price) {
                let mut fill_qty: Int = rem_taker;
                if rem_maker < fill_qty {
                    fill_qty = rem_maker;
                }
                
                maker.filled_qty = maker.filled_qty + fill_qty;
                taker.filled_qty = taker.filled_qty + fill_qty;
                rem_taker = rem_taker - fill_qty;
                
                let is_comp: Bool = l3_order_remaining(&maker) == 0;
                let ev: MatchEvent = match_event_new(
                    (engine).next_match_id,
                    maker.order_id,
                    taker.order_id,
                    maker.price,
                    fill_qty,
                    taker.timestamp_ns,
                    is_comp
                );
                
                (engine).next_match_id = (engine).next_match_id + 1;
                (engine).stats.trades_executed = (engine).stats.trades_executed + 1;
                (engine).stats.total_volume = (engine).stats.total_volume + fill_qty;
                (engine).stats.last_trade_price = maker.price;
                (engine).book.total_asks_qty = (engine).book.total_asks_qty - fill_qty;
                matches = list_push(matches, ev);
            }
            
            if l3_order_remaining(&maker) > 0 {
                new_asks = list_push(new_asks, maker);
            }
            i = i + 1;
        }
        (engine).book.ask_orders = new_asks;
        
        if l3_order_remaining(&taker) > 0 {
            orderbook_l3_add_order(&mut (engine).book, taker);
        }
    } else {
        let mut new_bids: List[L3Order] = list_new();
        let old_bids: List[L3Order] = (engine).book.bid_orders;
        let n_bids: Int = list_len(old_bids);
        let mut j: Int = 0;
        
        while j < n_bids {
            let mut maker: L3Order = list_get(old_bids, j);
            let rem_maker: Int = l3_order_remaining(&maker);
            
            if (rem_taker > 0) && (rem_maker > 0) && (taker.price <= maker.price) {
                let mut fill_qty: Int = rem_taker;
                if rem_maker < fill_qty {
                    fill_qty = rem_maker;
                }
                
                maker.filled_qty = maker.filled_qty + fill_qty;
                taker.filled_qty = taker.filled_qty + fill_qty;
                rem_taker = rem_taker - fill_qty;
                
                let is_comp: Bool = l3_order_remaining(&maker) == 0;
                let ev: MatchEvent = match_event_new(
                    (engine).next_match_id,
                    maker.order_id,
                    taker.order_id,
                    maker.price,
                    fill_qty,
                    taker.timestamp_ns,
                    is_comp
                );
                
                (engine).next_match_id = (engine).next_match_id + 1;
                (engine).stats.trades_executed = (engine).stats.trades_executed + 1;
                (engine).stats.total_volume = (engine).stats.total_volume + fill_qty;
                (engine).stats.last_trade_price = maker.price;
                (engine).book.total_bids_qty = (engine).book.total_bids_qty - fill_qty;
                matches = list_push(matches, ev);
            }
            
            if l3_order_remaining(&maker) > 0 {
                new_bids = list_push(new_bids, maker);
            }
            j = j + 1;
        }
        (engine).book.bid_orders = new_bids;
        
        if l3_order_remaining(&taker) > 0 {
            orderbook_l3_add_order(&mut (engine).book, taker);
        }
    }
    
    return matches;
}

pub fn matching_engine_cancel(engine: &mut MatchingEngine, order_id: Int) -> Bool {
    let res: Result[L3Order, String] = orderbook_l3_cancel_order(&mut (engine).book, order_id);
    match res {
        Ok(o) => { return true; },
        Err(e) => { return false; },
    }
}

pub fn matching_engine_halt(engine: &mut MatchingEngine) {
    (engine).is_halted = true;
}

pub fn matching_engine_resume(engine: &mut MatchingEngine) {
    (engine).is_halted = false;
}

pub fn matching_engine_get_stats(engine: &MatchingEngine) -> EngineStats {
    return (engine).stats;
}
