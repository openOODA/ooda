// # Black-Scholes-Merton Analytical Pricing Model
//
// Logline: Computes European option values, cumulative normal probabilities, and put-call parity bounds.
//
// Setup: Pure mathematical option pricing with dividend yield extensions.
//
// Beats:
//   1. Implement polynomial approximations for normal probability distribution CDF and PDF.
//   2. Calculate log-moneyness d1 and d2 transition parameters.
//   3. Price European Call and Put options and verify Put-Call parity compliance.

type EuropeanOption = struct {
    is_call: Bool,
    spot: Float,
    strike: Float,
    time_to_expiry: Float,
    risk_free_rate: Float,
    dividend_yield: Float,
    volatility: Float
};

type BsPriceResult = struct {
    price: Float,
    intrinsic_value: Float,
    time_value: Float,
    d1: Float,
    d2: Float
};

pub fn norm_pdf(x: Float) -> Float {
    let pi_factor: Float = 0.3989422804014327; // 1 / sqrt(2 * pi)
    let exponent: Float = 0.0 - (x * x / 2.0);
    return pi_factor * exp(exponent);
}

pub fn norm_cdf(x: Float) -> Float {
    let mut abs_x: Float = x;
    if x < 0.0 {
        abs_x = 0.0 - x;
    }
    
    let k: Float = 1.0 / (1.0 + (0.2316419 * abs_x));
    let poly: Float = k * (0.319381530 + (k * ((0.0 - 0.356563782) + (k * (1.781477937 + (k * ((0.0 - 1.821255978) + (1.330274429 * k))))))));
    let cdf_abs: Float = 1.0 - (norm_pdf(abs_x) * poly);
    
    if x < 0.0 {
        return 1.0 - cdf_abs;
    }
    return cdf_abs;
}

pub fn calc_d1(spot: Float, strike: Float, t: Float, r: Float, q: Float, vol: Float) -> Float {
    if spot <= 0.0 { return 0.0; }
    if strike <= 0.0 { return 0.0; }
    if t <= 0.0 { return 0.0; }
    if vol <= 0.0 { return 0.0; }
    
    let num: Float = ln(spot / strike) + ((r - q + ((vol * vol) / 2.0)) * t);
    let den: Float = vol * sqrt(t);
    return num / den;
}

pub fn calc_d2(d1: Float, vol: Float, t: Float) -> Float {
    if t <= 0.0 { return d1; }
    return d1 - (vol * sqrt(t));
}

pub fn option_intrinsic(option: &EuropeanOption) -> Float {
    if (option).is_call {
        let val: Float = (option).spot - (option).strike;
        if val > 0.0 { return val; }
        return 0.0;
    } else {
        let val: Float = (option).strike - (option).spot;
        if val > 0.0 { return val; }
        return 0.0;
    }
}

pub fn black_scholes_price(option: &EuropeanOption) -> BsPriceResult {
    let s: Float = (option).spot;
    let k: Float = (option).strike;
    let t: Float = (option).time_to_expiry;
    let r: Float = (option).risk_free_rate;
    let q: Float = (option).dividend_yield;
    let vol: Float = (option).volatility;
    let intrinsic: Float = option_intrinsic(option);
    
    if t <= 0.0 {
        return BsPriceResult {
            price: intrinsic,
            intrinsic_value: intrinsic,
            time_value: 0.0,
            d1: 0.0,
            d2: 0.0
        };
    }
    
    let d1: Float = calc_d1(s, k, t, r, q, vol);
    let d2: Float = calc_d2(d1, vol, t);
    let exp_qt: Float = exp((0.0 - q) * t);
    let exp_rt: Float = exp((0.0 - r) * t);
    
    let mut px: Float = 0.0;
    if (option).is_call {
        px = (s * exp_qt * norm_cdf(d1)) - (k * exp_rt * norm_cdf(d2));
    } else {
        px = (k * exp_rt * norm_cdf(0.0 - d2)) - (s * exp_qt * norm_cdf(0.0 - d1));
    }
    
    if px < intrinsic {
        px = intrinsic;
    }
    
    let time_val: Float = px - intrinsic;
    return BsPriceResult {
        price: px,
        intrinsic_value: intrinsic,
        time_value: time_val,
        d1: d1,
        d2: d2
    };
}

pub fn put_call_parity_diff(
    spot: Float,
    strike: Float,
    t: Float,
    r: Float,
    q: Float,
    call_px: Float,
    put_px: Float
) -> Float {
    let exp_qt: Float = exp((0.0 - q) * t);
    let exp_rt: Float = exp((0.0 - r) * t);
    let synthetic_call: Float = put_px + (spot * exp_qt) - (strike * exp_rt);
    return call_px - synthetic_call;
}
