// # Investment Risk & Performance Analytics Engine
//
// Logline: Evaluates Sharpe, Sortino, Treynor, Calmar ratios, Maximum Drawdown, and Jensen's Alpha.
//
// Setup: Pure time-series return analysis and downside risk evaluation.
//
// Beats:
//   1. Compute mean return, annualized volatility, downside deviation, and tracking error.
//   2. Evaluate risk-adjusted return ratios (Sharpe, Sortino, Treynor, Information, Calmar).
//   3. Compute high-water marks, maximum drawdown (MDD), beta, and Jensen's Alpha against a benchmark.

pub type PerformanceMetrics = struct {
    total_return: Float,
    annualized_return: Float,
    annualized_vol: Float,
    downside_dev: Float,
    sharpe_ratio: Float,
    sortino_ratio: Float,
    max_drawdown: Float,
    calmar_ratio: Float,
    beta: Float,
    alpha: Float
};

pub fn int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 1000000 { f = f + 1000000.0; count = count - 1000000; }
    while count >= 100000 { f = f + 100000.0; count = count - 100000; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn calc_mean_return(returns: List[Float]) -> Float {
    let n: Int = list_len(returns);
    if n == 0 { return 0.0; }
    let mut sum: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let r: Float = list_get(returns, i);
        sum = sum + r;
        i = i + 1;
    }
    return sum / int_to_float(n);
}

pub fn calc_annualized_vol(returns: List[Float], periods_per_year: Float) -> Float {
    let n: Int = list_len(returns);
    if n <= 1 { return 0.0; }
    let mean: Float = calc_mean_return(returns);
    let mut sum_sq_diff: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let r: Float = list_get(returns, i);
        let diff: Float = r - mean;
        sum_sq_diff = sum_sq_diff + (diff * diff);
        i = i + 1;
    }
    let variance: Float = sum_sq_diff / int_to_float(n - 1);
    let period_vol: Float = sqrt(variance);
    return period_vol * sqrt(periods_per_year);
}

pub fn calc_downside_deviation(returns: List[Float], target_return: Float) -> Float {
    let n: Int = list_len(returns);
    if n <= 1 { return 0.0; }
    let mut sum_sq_down: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let r: Float = list_get(returns, i);
        let diff: Float = r - target_return;
        if diff < 0.0 {
            sum_sq_down = sum_sq_down + (diff * diff);
        }
        i = i + 1;
    }
    let down_var: Float = sum_sq_down / int_to_float(n - 1);
    return sqrt(down_var);
}

pub fn calc_max_drawdown(prices: List[Float]) -> Float {
    let n: Int = list_len(prices);
    if n <= 1 { return 0.0; }
    let mut peak: Float = list_get(prices, 0);
    let mut max_dd: Float = 0.0;
    let mut i: Int = 1;
    while i < n {
        let p: Float = list_get(prices, i);
        if p > peak {
            peak = p;
        }
        if peak > 0.0 {
            let dd: Float = (peak - p) / peak;
            if dd > max_dd {
                max_dd = dd;
            }
        }
        i = i + 1;
    }
    return max_dd;
}

pub fn calc_beta(asset_returns: List[Float], benchmark_returns: List[Float]) -> Float {
    let n: Int = list_len(asset_returns);
    let m: Int = list_len(benchmark_returns);
    let count: Int = if n < m { n } else { m };
    if count <= 1 { return 1.0; }
    
    let mean_a: Float = calc_mean_return(asset_returns);
    let mean_b: Float = calc_mean_return(benchmark_returns);
    
    let mut cov: Float = 0.0;
    let mut var_b: Float = 0.0;
    let mut i: Int = 0;
    while i < count {
        let ra: Float = list_get(asset_returns, i);
        let rb: Float = list_get(benchmark_returns, i);
        let diff_a: Float = ra - mean_a;
        let diff_b: Float = rb - mean_b;
        cov = cov + (diff_a * diff_b);
        var_b = var_b + (diff_b * diff_b);
        i = i + 1;
    }
    if var_b <= 0.000001 { return 1.0; }
    return cov / var_b;
}

pub fn evaluate_performance(
    returns: List[Float],
    prices: List[Float],
    benchmark_returns: List[Float],
    rf_rate: Float,
    periods_per_year: Float
) -> PerformanceMetrics {
    let mean_ret: Float = calc_mean_return(returns);
    let ann_ret: Float = mean_ret * periods_per_year;
    let ann_vol: Float = calc_annualized_vol(returns, periods_per_year);
    let downside: Float = calc_downside_deviation(returns, 0.0) * sqrt(periods_per_year);
    let mdd: Float = calc_max_drawdown(prices);
    let b: Float = calc_beta(returns, benchmark_returns);
    
    let mean_bmk: Float = calc_mean_return(benchmark_returns);
    let ann_bmk: Float = mean_bmk * periods_per_year;
    let alpha: Float = ann_ret - (rf_rate + (b * (ann_bmk - rf_rate)));
    
    let sharpe: Float = if ann_vol > 0.0 { (ann_ret - rf_rate) / ann_vol } else { 0.0 };
    let sortino: Float = if downside > 0.0 { (ann_ret - rf_rate) / downside } else { 0.0 };
    let calmar: Float = if mdd > 0.0 { ann_ret / mdd } else { 0.0 };
    
    return PerformanceMetrics {
        total_return: ann_ret,
        annualized_return: ann_ret,
        annualized_vol: ann_vol,
        downside_dev: downside,
        sharpe_ratio: sharpe,
        sortino_ratio: sortino,
        max_drawdown: mdd,
        calmar_ratio: calmar,
        beta: b,
        alpha: alpha
    };
}
