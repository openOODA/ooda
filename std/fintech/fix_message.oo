// # FIX Protocol Message Structure
//
// Logline: Defines FIX standard header, trailer, tag-value field collections, and serialization formatting.
//
// Setup: Pure data structures and message container primitives for FIX protocol messaging.
//
// Beats:
//   1. Define FixField, FixHeader, FixTrailer, and FixMessage data types.
//   2. Provide constructors and helper functions for tag-value manipulations.
//   3. Compute body lengths and serialize message structures to standardized FIX text formats.

pub type FixField = struct {
    tag: Int,
    value: String
};

pub type FixHeader = struct {
    begin_string: String,
    body_length: Int,
    msg_type: String,
    sender_comp_id: String,
    target_comp_id: String,
    msg_seq_num: Int,
    sending_time: Int
};

pub type FixTrailer = struct {
    checksum: Int
};

pub type FixMessage = struct {
    header: FixHeader,
    fields: List[FixField],
    trailer: FixTrailer,
    raw_length: Int
};

pub fn fix_field_new(tag: Int, value: String) -> FixField {
    return FixField {
        tag: tag,
        value: value
    };
}

pub fn fix_header_new(
    begin_str: String,
    msg_type: String,
    sender: String,
    target: String,
    seq_num: Int,
    send_time: Int
) -> FixHeader {
    return FixHeader {
        begin_string: begin_str,
        body_length: 0,
        msg_type: msg_type,
        sender_comp_id: sender,
        target_comp_id: target,
        msg_seq_num: seq_num,
        sending_time: send_time
    };
}

pub fn fix_trailer_new(checksum: Int) -> FixTrailer {
    return FixTrailer {
        checksum: checksum
    };
}

pub fn fix_message_new(header: FixHeader) -> FixMessage {
    let flds: List[FixField] = list_new();
    let tr: FixTrailer = fix_trailer_new(0);
    return FixMessage {
        header: header,
        fields: flds,
        trailer: tr,
        raw_length: 0
    };
}

pub fn fix_message_add_field(msg: &mut FixMessage, tag: Int, value: String) {
    let fld: FixField = fix_field_new(tag, value);
    let cur_fields: List[FixField] = (msg).fields;
    (msg).fields = list_push(cur_fields, fld);
}

pub fn fix_message_get_field(msg: &FixMessage, tag: Int) -> Result[String, String] {
    let flds: List[FixField] = (msg).fields;
    let n: Int = list_len(flds);
    let mut i: Int = 0;
    while i < n {
        let f: FixField = list_get(flds, i);
        if f.tag == tag {
            return Ok(f.value);
        }
        i = i + 1;
    }
    return Err("FIELD_NOT_FOUND");
}

pub fn fix_message_has_field(msg: &FixMessage, tag: Int) -> Bool {
    let flds: List[FixField] = (msg).fields;
    let n: Int = list_len(flds);
    let mut i: Int = 0;
    while i < n {
        let f: FixField = list_get(flds, i);
        if f.tag == tag {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn fix_message_field_count(msg: &FixMessage) -> Int {
    return list_len((msg).fields);
}

pub fn fix_message_set_seq_num(msg: &mut FixMessage, seq_num: Int) {
    (msg).header.msg_seq_num = seq_num;
}

pub fn fix_message_compute_body_length(msg: &FixMessage) -> Int {
    let flds: List[FixField] = (msg).fields;
    let n: Int = list_len(flds);
    let mut est_len: Int = 30; // standard header overhead (MsgType, Sender, Target, Seq, Time)
    let mut i: Int = 0;
    while i < n {
        let f: FixField = list_get(flds, i);
        est_len = est_len + 6; // tag + '=' + value + SOH estimation
        i = i + 1;
    }
    return est_len;
}
