// # Abstract Octagon Domain
//
// Logline: Implements octagonal relational abstract constraints of the form (+/- X_i +/- X_j <= c) via Difference Bound Matrices.
//
// Setup: Relational abstract domain capturing invariants between pairs of program numeric variables.
//
// Beats:
//   1. Define OctagonMatrix and OctagonConstraint structures.
//   2. Implement 2N x 2N Difference Bound Matrix (DBM) representation and indexing.
//   3. Implement shortest-path closure (Floyd-Warshall), join, and consistency verification.

pub type OctagonConstraint = struct {
    var_i: Int,
    sign_i: Int,
    var_j: Int,
    sign_j: Int,
    bound: Int,
};

pub type OctagonMatrix = struct {
    dimension: Int,
    matrix_size: Int,
    bounds: List[Int],
    is_bottom: Bool,
};

pub fn list_update_int(l: List[Int], idx: Int, val: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let n: Int = list_len(l);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            res = list_push(res, val);
        } else {
            res = list_push(res, list_get(l, i));
        }
        i = i + 1;
    }
    return res;
}

pub fn octagon_index(dim2: Int, row: Int, col: Int) -> Int {
    return (row * dim2) + col;
}

pub fn octagon_matrix_new(dim: Int) -> OctagonMatrix {
    let dim2: Int = dim * 2;
    let total: Int = dim2 * dim2;
    let mut b: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total {
        let r: Int = i / dim2;
        let c: Int = i % dim2;
        if r == c {
            b = list_push(b, 0);
        } else {
            b = list_push(b, 1000000); // Infinity representation
        }
        i = i + 1;
    }
    return OctagonMatrix {
        dimension: dim,
        matrix_size: dim2,
        bounds: b,
        is_bottom: false,
    };
}

pub fn octagon_matrix_bottom(dim: Int) -> OctagonMatrix {
    let dim2: Int = dim * 2;
    let total: Int = dim2 * dim2;
    let mut b: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total {
        b = list_push(b, 0);
        i = i + 1;
    }
    return OctagonMatrix {
        dimension: dim,
        matrix_size: dim2,
        bounds: b,
        is_bottom: true,
    };
}

pub fn octagon_get_bound(oct: &OctagonMatrix, row: Int, col: Int) -> Int {
    let idx: Int = octagon_index((oct).matrix_size, row, col);
    return list_get((oct).bounds, idx);
}

pub fn octagon_set_bound(oct: &mut OctagonMatrix, row: Int, col: Int, val: Int) -> Bool {
    let idx: Int = octagon_index((oct).matrix_size, row, col);
    (oct).bounds = list_update_int((oct).bounds, idx, val);
    return true;
}

pub fn octagon_close_floyd_warshall(oct: &mut OctagonMatrix) -> Bool {
    if (oct).is_bottom {
        return false;
    }
    let n: Int = (oct).matrix_size;
    let mut k: Int = 0;
    while k < n {
        let mut i: Int = 0;
        while i < n {
            let mut j: Int = 0;
            while j < n {
                let ik: Int = octagon_get_bound(oct, i, k);
                let kj: Int = octagon_get_bound(oct, k, j);
                let ij: Int = octagon_get_bound(oct, i, j);
                let alt: Int = ik + kj;
                if alt < ij {
                    octagon_set_bound(oct, i, j, alt);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }

    let mut d: Int = 0;
    while d < n {
        let diag: Int = octagon_get_bound(oct, d, d);
        if diag < 0 {
            (oct).is_bottom = true;
            return false;
        }
        d = d + 1;
    }
    return true;
}

pub fn octagon_is_consistent(oct: &OctagonMatrix) -> Bool {
    return ((oct).is_bottom == false);
}
