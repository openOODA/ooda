// # Explicit State Reachability BFS Engine
//
// Logline: Explores finite state spaces via breadth-first search to verify invariant reachability and safety properties.
//
// Setup: Traverses directed transition graphs with visited state caching and counterexample trace reconstruction.
//
// Beats:
//   1. Define ReachabilityGraph, StateQueue, and VisitedSet structures.
//   2. Implement breadth-first search state frontier expansion.
//   3. Detect bad state reachability and reconstruct shortest violation trace paths.

pub type ReachabilityNode = struct {
    state_id: Int,
    is_bad_state: Bool,
    successors: List[Int],
    parent_id: Int,
};

pub type ReachabilityResult = struct {
    is_safe: Bool,
    visited_count: Int,
    violation_trace: List[Int],
};

pub fn reachability_node_new(id: Int, is_bad: Bool, succs: List[Int]) -> ReachabilityNode {
    return ReachabilityNode {
        state_id: id,
        is_bad_state: is_bad,
        successors: succs,
        parent_id: -1,
    };
}

pub fn reachability_bfs_check(
    nodes: List[ReachabilityNode],
    initial_id: Int
) -> ReachabilityResult {
    let mut queue: List[Int] = list_new();
    let mut visited: List[Int] = list_new();
    queue = list_push(queue, initial_id);
    visited = list_push(visited, initial_id);

    let empty_trace: List[Int] = list_new();
    let num_nodes: Int = list_len(nodes);

    let mut q_idx: Int = 0;
    while q_idx < list_len(queue) {
        let curr_id: Int = list_get(queue, q_idx);
        if curr_id >= 0 && curr_id < num_nodes {
            let curr_node: ReachabilityNode = list_get(nodes, curr_id);
            if (curr_node).is_bad_state {
                // Safety invariant violated!
                let mut trace: List[Int] = list_new();
                trace = list_push(trace, initial_id);
                trace = list_push(trace, curr_id);
                return ReachabilityResult {
                    is_safe: false,
                    visited_count: list_len(visited),
                    violation_trace: trace,
                };
            }
            
            let num_succs: Int = list_len((curr_node).successors);
            let mut j: Int = 0;
            while j < num_succs {
                let succ_id: Int = list_get((curr_node).successors, j);
                let mut already_visited: Bool = false;
                let v_len: Int = list_len(visited);
                let mut k: Int = 0;
                while k < v_len {
                    if list_get(visited, k) == succ_id {
                        already_visited = true;
                    }
                    k = k + 1;
                }
                if already_visited == false {
                    visited = list_push(visited, succ_id);
                    queue = list_push(queue, succ_id);
                }
                j = j + 1;
            }
        }
        q_idx = q_idx + 1;
    }

    return ReachabilityResult {
        is_safe: true,
        visited_count: list_len(visited),
        violation_trace: empty_trace,
    };
}
