// # Abstract Galois Connection Framework
//
// Logline: Formalizes Galois connections and Galois insertions (alpha, gamma) between concrete and abstract domains.
//
// Setup: Soundness foundation establishing mathematical correctness of abstract interpretation overapproximations.
//
// Beats:
//   1. Define GaloisConnection descriptor and soundness proof metrics.
//   2. Implement abstraction alpha and concretization gamma mappings.
//   3. Implement monotonicity, extensive property, and Galois insertion verification.

import "./abstract_interval_arithmetic.oo";
import "./abstract_powerset_domain.oo";

pub type GaloisConnection = struct {
    domain_name: String,
    is_insertion: Bool,
    soundness_violations: Int
};

pub fn galois_connection_new(name: String, is_insert: Bool) -> GaloisConnection {
    return GaloisConnection {
        domain_name: name,
        is_insertion: is_insert,
        soundness_violations: 0
    };
}

pub fn galois_alpha_set_to_interval(set: &PowersetDomain) -> Interval {
    if (set).is_top {
        return interval_top();
    }
    let n: Int = (set).element_count;
    if n == 0 {
        return interval_bottom();
    }
    let mut min_v: Int = list_get((set).elements, 0);
    let mut max_v: Int = min_v;
    let mut i: Int = 1;
    while i < n {
        let val: Int = list_get((set).elements, i);
        if val < min_v {
            min_v = val;
        }
        if val > max_v {
            max_v = val;
        }
        i = i + 1;
    }
    return interval_range(min_v, max_v);
}

pub fn galois_gamma_contains(inv: Interval, val: Int) -> Bool {
    return interval_contains(inv, val);
}

pub fn galois_verify_sound_overapproximation(
    set: &PowersetDomain,
    inv: Interval,
    gc: &mut GaloisConnection
) -> Bool {
    if (set).is_top {
        return true;
    }
    let n: Int = (set).element_count;
    let mut i: Int = 0;
    while i < n {
        let val: Int = list_get((set).elements, i);
        if interval_contains(inv, val) == false {
            (gc).soundness_violations = (gc).soundness_violations + 1;
            return false; // Soundness violation: concrete element escaped abstract envelope!
        }
        i = i + 1;
    }
    return true;
}
