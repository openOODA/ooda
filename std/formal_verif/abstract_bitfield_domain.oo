// # Abstract Bitfield Domain
//
// Logline: Implements 3-valued bitwise abstract domain (0, 1, Top) tracking known-zeros and known-ones masks.
//
// Setup: Low-level bit-precise abstract domain for compiler optimizations and hardware security properties.
//
// Beats:
//   1. Define BitfieldValue structure with known_zeros and known_ones bitmasks.
//   2. Implement bitwise abstract transfer functions (AND, OR, XOR, NOT, shift).
//   3. Implement lattice join, meet, precision refinement, and consistency checks.

pub type BitfieldValue = struct {
    known_zeros: Int,
    known_ones: Int,
    is_bottom: Bool
};

pub fn bitfield_bottom() -> BitfieldValue {
    return BitfieldValue {
        known_zeros: 0,
        known_ones: 0,
        is_bottom: true
    };
}

pub fn bitfield_top() -> BitfieldValue {
    return BitfieldValue {
        known_zeros: 0,
        known_ones: 0,
        is_bottom: false
    };
}

pub fn bitfield_const(val: Int) -> BitfieldValue {
    let ones: Int = val;
    let zeros: Int = val ^ 2147483647;
    return BitfieldValue {
        known_zeros: zeros,
        known_ones: ones,
        is_bottom: false
    };
}

pub fn bitfield_is_valid(bf: &BitfieldValue) -> Bool {
    if (bf).is_bottom {
        return false;
    }
    return (((bf).known_zeros & (bf).known_ones) == 0);
}

pub fn bitfield_join(a: &BitfieldValue, b: &BitfieldValue) -> BitfieldValue {
    if (a).is_bottom {
        return *b;
    }
    if (b).is_bottom {
        return *a;
    }
    return BitfieldValue {
        known_zeros: (a).known_zeros & (b).known_zeros,
        known_ones: (a).known_ones & (b).known_ones,
        is_bottom: false
    };
}

pub fn bitfield_meet(a: &BitfieldValue, b: &BitfieldValue) -> BitfieldValue {
    if (a).is_bottom || (b).is_bottom {
        return bitfield_bottom();
    }
    let z: Int = (a).known_zeros | (b).known_zeros;
    let o: Int = (a).known_ones | (b).known_ones;
    if (z & o) != 0 {
        return bitfield_bottom(); // Contradiction
    }
    return BitfieldValue {
        known_zeros: z,
        known_ones: o,
        is_bottom: false
    };
}

pub fn bitfield_and(a: &BitfieldValue, b: &BitfieldValue) -> BitfieldValue {
    if (a).is_bottom || (b).is_bottom {
        return bitfield_bottom();
    }
    let z: Int = (a).known_zeros | (b).known_zeros;
    let o: Int = (a).known_ones & (b).known_ones;
    return BitfieldValue {
        known_zeros: z,
        known_ones: o,
        is_bottom: false
    };
}

pub fn bitfield_or(a: &BitfieldValue, b: &BitfieldValue) -> BitfieldValue {
    if (a).is_bottom || (b).is_bottom {
        return bitfield_bottom();
    }
    let z: Int = (a).known_zeros & (b).known_zeros;
    let o: Int = (a).known_ones | (b).known_ones;
    return BitfieldValue {
        known_zeros: z,
        known_ones: o,
        is_bottom: false
    };
}

pub fn bitfield_xor(a: &BitfieldValue, b: &BitfieldValue) -> BitfieldValue {
    if (a).is_bottom || (b).is_bottom {
        return bitfield_bottom();
    }
    let z: Int = ((a).known_zeros & (b).known_zeros) | ((a).known_ones & (b).known_ones);
    let o: Int = ((a).known_zeros & (b).known_ones) | ((a).known_ones & (b).known_zeros);
    return BitfieldValue {
        known_zeros: z,
        known_ones: o,
        is_bottom: false
    };
}

pub fn bitfield_not(a: &BitfieldValue) -> BitfieldValue {
    if (a).is_bottom {
        return bitfield_bottom();
    }
    return BitfieldValue {
        known_zeros: (a).known_ones,
        known_ones: (a).known_zeros,
        is_bottom: false
    };
}
