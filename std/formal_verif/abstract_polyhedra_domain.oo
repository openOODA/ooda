// # Abstract Convex Polyhedra Domain
//
// Logline: Implements the linear inequality constraint domain representing convex polyhedra for invariant verification.
//
// Setup: Relational abstract domain capturing arbitrary linear relationships among system variables.
//
// Beats:
//   1. Define LinearConstraint and Polyhedron data structures.
//   2. Implement constraint addition, evaluation, and bounded containment.
//   3. Implement Fourier-Motzkin variable elimination and convex polyhedron intersection.

pub type LinearConstraint = struct {
    coefficients: List[Int],
    constant_bound: Int,
    is_equality: Bool
};

pub type Polyhedron = struct {
    dimension: Int,
    constraints: List[LinearConstraint],
    constraint_count: Int,
    is_empty: Bool
};

pub fn linear_constraint_new(coeffs: List[Int], bound: Int, is_eq: Bool) -> LinearConstraint {
    return LinearConstraint {
        coefficients: coeffs,
        constant_bound: bound,
        is_equality: is_eq
    };
}

pub fn polyhedron_top(dim: Int) -> Polyhedron {
    let empty_cs: List[LinearConstraint] = list_new();
    return Polyhedron {
        dimension: dim,
        constraints: empty_cs,
        constraint_count: 0,
        is_empty: false
    };
}

pub fn polyhedron_bottom(dim: Int) -> Polyhedron {
    let empty_cs: List[LinearConstraint] = list_new();
    return Polyhedron {
        dimension: dim,
        constraints: empty_cs,
        constraint_count: 0,
        is_empty: true
    };
}

pub fn polyhedron_add_constraint(poly: &mut Polyhedron, c: LinearConstraint) -> Bool {
    if (poly).is_empty {
        return false;
    }
    (poly).constraints = list_push((poly).constraints, c);
    (poly).constraint_count = (poly).constraint_count + 1;
    return true;
}

pub fn linear_constraint_eval(c: &LinearConstraint, point: List[Int]) -> Int {
    let mut sum: Int = 0;
    let n: Int = list_len((c).coefficients);
    let mut i: Int = 0;
    while i < n {
        let coeff: Int = list_get((c).coefficients, i);
        let val: Int = list_get(point, i);
        sum = sum + (coeff * val);
        i = i + 1;
    }
    return sum;
}

pub fn linear_constraint_satisfied(c: &LinearConstraint, point: List[Int]) -> Bool {
    let eval: Int = linear_constraint_eval(c, point);
    if (c).is_equality {
        return eval == (c).constant_bound;
    }
    return eval <= (c).constant_bound;
}

pub fn polyhedron_contains_point(poly: &Polyhedron, point: List[Int]) -> Bool {
    if (poly).is_empty {
        return false;
    }
    let n: Int = (poly).constraint_count;
    let mut i: Int = 0;
    while i < n {
        let c: LinearConstraint = list_get((poly).constraints, i);
        if linear_constraint_satisfied(&c, point) == false {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn polyhedron_meet(p1: &Polyhedron, p2: &Polyhedron) -> Polyhedron {
    if (p1).is_empty || (p2).is_empty {
        return polyhedron_bottom((p1).dimension);
    }
    let mut merged: List[LinearConstraint] = list_new();
    let n1: Int = (p1).constraint_count;
    let mut i: Int = 0;
    while i < n1 {
        merged = list_push(merged, list_get((p1).constraints, i));
        i = i + 1;
    }
    let n2: Int = (p2).constraint_count;
    let mut j: Int = 0;
    while j < n2 {
        merged = list_push(merged, list_get((p2).constraints, j));
        j = j + 1;
    }
    return Polyhedron {
        dimension: (p1).dimension,
        constraints: merged,
        constraint_count: n1 + n2,
        is_empty: false
    };
}
