pub fn formal_verif_interval_top() -> Interval {
    return interval_top();
}

pub fn formal_verif_octagon_new(dim: Int) -> OctagonMatrix {
    return octagon_matrix_new(dim);
}

pub fn formal_verif_hoare_env() -> HoareEnvironment {
    return hoare_env_new();
}

pub fn formal_verif_sat_formula(vars: Int) -> SatFormula {
    return sat_formula_new(vars);
}

pub fn formal_verif_egraph() -> EGraph {
    return egraph_new();
}

pub fn formal_verif_kripke() -> KripkeStructure {
    return kripke_structure_new();
}

pub fn formal_verif_bdd() -> BddManager {
    return bdd_manager_new();
}

pub fn formal_verif_bmc(name: String, depth: Int) -> BmcContext {
    return bmc_context_new(name, depth);
}

pub fn formal_verif_cert(thm: String) -> ProofCertificate {
    return proof_certificate_new(thm);
}

pub fn formal_verif_security_policy() -> FormalVerifPolicy {
    return formal_verif_policy_default();
}
