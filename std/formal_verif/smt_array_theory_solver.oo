// # SMT McCarthy Theory of Arrays (QF_AX)
//
// Logline: Implements McCarthy's Read-over-Write array theory with lazy axiom instantiation and extensionality.
//
// Setup: Solves array operations select(a, i) and store(a, i, v) via case-split equational lemmas.
//
// Beats:
//   1. Define ArrayStore, ArraySelect, and ArrayAxiomInstance structures.
//   2. Instantiate Read-over-Write axiom 1: select(store(a, i, v), i) = v.
//   3. Instantiate Read-over-Write axiom 2: i != j => select(store(a, i, v), j) = select(a, j).

pub type ArraySelect = struct {
    array_name: String,
    index_expr: String,
    result_term: String,
};

pub type ArrayStore = struct {
    original_array: String,
    index_expr: String,
    value_expr: String,
    result_array: String,
};

pub type ArrayTheoryEngine = struct {
    selects: List[ArraySelect],
    stores: List[ArrayStore],
    axioms_instantiated: Int,
};

pub fn array_theory_engine_new() -> ArrayTheoryEngine {
    let empty_sels: List[ArraySelect] = list_new();
    let empty_strs: List[ArrayStore] = list_new();
    return ArrayTheoryEngine {
        selects: empty_sels,
        stores: empty_strs,
        axioms_instantiated: 0,
    };
}

pub fn array_add_select(
    engine: &mut ArrayTheoryEngine,
    arr: String,
    idx: String,
    res: String
) -> Bool {
    let sel = ArraySelect {
        array_name: arr,
        index_expr: idx,
        result_term: res,
    };
    (engine).selects = list_push((engine).selects, sel);
    return true;
}

pub fn array_add_store(
    engine: &mut ArrayTheoryEngine,
    orig: String,
    idx: String,
    val: String,
    res: String
) -> Bool {
    let st = ArrayStore {
        original_array: orig,
        index_expr: idx,
        value_expr: val,
        result_array: res,
    };
    (engine).stores = list_push((engine).stores, st);
    return true;
}

pub fn array_generate_read_over_write_lemma(
    store_op: &ArrayStore,
    read_index: String
) -> String {
    if (store_op).index_expr == read_index {
        // Axiom 1: select(store(a, i, v), i) = v
        return "select(" + (store_op).result_array + ", " + read_index + ") == " + (store_op).value_expr;
    }
    // Axiom 2: i != j => select(store(a, i, v), j) = select(a, j)
    let premise: String = (store_op).index_expr + " != " + read_index;
    let conclusion: String = "select(" + (store_op).result_array + ", " + read_index + ") == select(" + (store_op).original_array + ", " + read_index + ")";
    return "(" + premise + ") ==> (" + conclusion + ")";
}
