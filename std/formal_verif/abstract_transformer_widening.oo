// # Abstract Transformer Widening & Narrowing
//
// Logline: Implements widening with threshold heuristics and narrowing operators for fixpoint convergence.
//
// Setup: Accelerates abstract interpretation fixpoint loops by jumping over unbounded infinite chains.
//
// Beats:
//   1. Define WideningThresholds structure containing ordered static cut points.
//   2. Implement threshold-guided widening for intervals jumping to next threshold value.
//   3. Implement narrowing operator recovering lost precision after fixpoint stabilization.

import "./abstract_interval_arithmetic.oo";

pub type WideningThresholds = struct {
    thresholds: List[Int],
    count: Int
};

pub fn default_thresholds() -> WideningThresholds {
    let mut ts: List[Int] = list_new();
    ts = list_push(ts, -1000);
    ts = list_push(ts, -100);
    ts = list_push(ts, -1);
    ts = list_push(ts, 0);
    ts = list_push(ts, 1);
    ts = list_push(ts, 100);
    ts = list_push(ts, 1000);
    return WideningThresholds {
        thresholds: ts,
        count: 7
    };
}

pub fn widen_find_upper_threshold(t: &WideningThresholds, val: Int) -> Int {
    let n: Int = (t).count;
    let mut i: Int = 0;
    while i < n {
        let bound: Int = list_get((t).thresholds, i);
        if bound >= val {
            return bound;
        }
        i = i + 1;
    }
    return 2147483647; // Top upper bound
}

pub fn widen_find_lower_threshold(t: &WideningThresholds, val: Int) -> Int {
    let n: Int = (t).count;
    let mut i: Int = n - 1;
    while i >= 0 {
        let bound: Int = list_get((t).thresholds, i);
        if bound <= val {
            return bound;
        }
        i = i - 1;
    }
    return -2147483647; // Top lower bound
}

pub fn widen_interval_thresholds(
    old_inv: Interval,
    new_inv: Interval,
    t: &WideningThresholds
) -> Interval {
    if (old_inv).is_bottom {
        return new_inv;
    }
    if (new_inv).is_bottom {
        return old_inv;
    }

    let mut low_res: Int = (old_inv).low;
    if (new_inv).low < (old_inv).low {
        low_res = widen_find_lower_threshold(t, (new_inv).low);
    }

    let mut high_res: Int = (old_inv).high;
    if (new_inv).high > (old_inv).high {
        high_res = widen_find_upper_threshold(t, (new_inv).high);
    }

    return Interval {
        low: low_res,
        high: high_res,
        is_bottom: false
    };
}

pub fn narrow_interval(old_inv: Interval, new_inv: Interval) -> Interval {
    if (old_inv).is_bottom || (new_inv).is_bottom {
        return interval_bottom();
    }

    let mut low_res: Int = (old_inv).low;
    if (old_inv).low == -2147483647 {
        low_res = (new_inv).low;
    }

    let mut high_res: Int = (old_inv).high;
    if (old_inv).high == 2147483647 {
        high_res = (new_inv).high;
    }

    return Interval {
        low: low_res,
        high: high_res,
        is_bottom: false
    };
}
