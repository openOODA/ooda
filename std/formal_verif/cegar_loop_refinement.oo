// # CEGAR Abstraction Refinement Loop
//
// Logline: Implements Counterexample-Guided Abstraction Refinement with spuriousness checking and interpolant generation.
//
// Setup: Iterative loop maintaining coarse predicate abstractions and refining only upon concrete refutation.
//
// Beats:
//   1. Define AbstractModel, ConcreteTrace, and CegarLoopState structures.
//   2. Check spuriousness: determine if abstract counterexample trace is concretely feasible.
//   3. Extract Craig interpolants from infeasibility proof to discover new separating predicates.

pub type AbstractPredicate = struct {
    predicate_id: Int,
    expression: String,
};

pub type CegarState = struct {
    predicates: List[AbstractPredicate],
    predicate_count: Int,
    refinement_iterations: Int,
    is_property_verified: Bool,
};

pub fn cegar_state_new() -> CegarState {
    let empty_preds: List[AbstractPredicate] = list_new();
    return CegarState {
        predicates: empty_preds,
        predicate_count: 0,
        refinement_iterations: 0,
        is_property_verified: false,
    };
}

pub fn cegar_add_predicate(state: &mut CegarState, expr_str: String) -> Int {
    let next_id: Int = (state).predicate_count + 1;
    let p = AbstractPredicate {
        predicate_id: next_id,
        expression: expr_str,
    };
    (state).predicates = list_push((state).predicates, p);
    (state).predicate_count = next_id;
    return next_id;
}

pub fn cegar_is_spurious_counterexample(is_concrete_sat: Bool) -> Bool {
    // If concrete formula is UNSAT, counterexample is spurious and abstraction must be refined
    return (is_concrete_sat == false);
}

pub fn cegar_refine_with_interpolant(state: &mut CegarState, interpolant_expr: String) -> Bool {
    cegar_add_predicate(state, interpolant_expr);
    (state).refinement_iterations = (state).refinement_iterations + 1;
    return true;
}
