// # Spatial & Temporal Memory Safety Verifier
//
// Logline: Verifies spatial bounds [base, bound) and temporal validity to prevent buffer overflows, UAF, and double-frees.
//
// Setup: Sound verification rules for raw memory buffers and dynamic heap object lifecycles.
//
// Beats:
//   1. Define MemoryObject, PointerCapability, and MemorySafetyState structures.
//   2. Implement spatial safety bounds check: base <= addr && addr + size <= bound.
//   3. Implement temporal safety state machine: Allocated -> Freed -> Fault on double free / use after free.

pub type MemoryObject = struct {
    object_id: Int,
    base_address: Int,
    size_bytes: Int,
    is_allocated: Bool,
    is_freed: Bool,
};

pub type MemorySafetyMonitor = struct {
    objects: List[MemoryObject],
    spatial_faults: Int,
    temporal_faults: Int,
};

pub fn memory_monitor_new() -> MemorySafetyMonitor {
    let empty_objs: List[MemoryObject] = list_new();
    return MemorySafetyMonitor {
        objects: empty_objs,
        spatial_faults: 0,
        temporal_faults: 0,
    };
}

pub fn memory_allocate(
    mon: &mut MemorySafetyMonitor,
    id: Int,
    base: Int,
    sz: Int
) -> Bool {
    let obj = MemoryObject {
        object_id: id,
        base_address: base,
        size_bytes: sz,
        is_allocated: true,
        is_freed: false,
    };
    (mon).objects = list_push((mon).objects, obj);
    return true;
}

pub fn memory_check_spatial_access(
    obj: &MemoryObject,
    offset: Int,
    access_size: Int
) -> Bool {
    if (obj).is_freed || ((obj).is_allocated == false) {
        return false;
    }
    if offset < 0 {
        return false;
    }
    return (offset + access_size) <= (obj).size_bytes;
}

pub fn memory_free(mon: &mut MemorySafetyMonitor, obj_idx: Int) -> Bool {
    let n: Int = list_len((mon).objects);
    if obj_idx < 0 || obj_idx >= n {
        return false;
    }
    let obj: MemoryObject = list_get((mon).objects, obj_idx);
    if (obj).is_freed {
        (mon).temporal_faults = (mon).temporal_faults + 1; // Double free detected!
        return false;
    }
    let updated_obj = MemoryObject {
        object_id: (obj).object_id,
        base_address: (obj).base_address,
        size_bytes: (obj).size_bytes,
        is_allocated: false,
        is_freed: true,
    };
    let mut updated: List[MemoryObject] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == obj_idx {
            updated = list_push(updated, updated_obj);
        } else {
            updated = list_push(updated, list_get((mon).objects, i));
        }
        i = i + 1;
    }
    (mon).objects = updated;
    return true;
}
