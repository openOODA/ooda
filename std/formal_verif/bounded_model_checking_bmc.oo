// # Bounded Model Checking (BMC) Formula Unroller
//
// Logline: Unrolls transition systems up to depth k and encodes safety violation queries into SAT formulas.
//
// Setup: Translation engine mapping transition relations and temporal assertions into propositional SAT instances.
//
// Beats:
//   1. Define BmcUnrollingContext and SafetyTarget structures.
//   2. Encode transition unrolling: Init(s_0) /\ T(s_0, s_1) /\ ... /\ T(s_k-1, s_k).
//   3. Encode property violation at any unrolled step: \/ (!P(s_i)) for i in 0..k.

pub type BmcContext = struct {
    system_name: String,
    max_k_bound: Int,
    current_k: Int,
    is_counterexample_found: Bool
};

pub fn bmc_context_new(name: String, max_depth: Int) -> BmcContext {
    return BmcContext {
        system_name: name,
        max_k_bound: max_depth,
        current_k: 0,
        is_counterexample_found: false
    };
}

pub fn bmc_build_unrolling_query(
    ctx: &BmcContext,
    init_formula: String,
    trans_formula: String,
    bad_formula: String,
    k: Int
) -> String {
    let mut formula: String = init_formula + "(s_0)";
    let mut i: Int = 0;
    while i < k {
        formula = formula + " /\\ " + trans_formula + "(s_" + "prev" + ", s_" + "curr" + ")";
        i = i + 1;
    }
    formula = formula + " /\\ (" + bad_formula + "(s_" + "last" + "))";
    return formula;
}

pub fn bmc_step_bound(ctx: &mut BmcContext) -> Bool {
    if (ctx).current_k >= (ctx).max_k_bound {
        return false;
    }
    (ctx).current_k = (ctx).current_k + 1;
    return true;
}
