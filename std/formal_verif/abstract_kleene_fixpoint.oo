// # Abstract Kleene Fixpoint Engine
//
// Logline: Implements chaotic iteration and worklist-driven Kleene fixpoint computation for control flow graphs.
//
// Setup: Core fixpoint engine driving static analysis over CFG nodes until abstract state stabilization.
//
// Beats:
//   1. Define CfgNode, Worklist, and FixpointState structures.
//   2. Implement worklist push/pop ordering and node predecessor state joining.
//   3. Implement chaotic iteration loop with convergence detection and iteration bounding.

import "./abstract_interval_arithmetic.oo";

pub type CfgNode = struct {
    node_id: Int,
    predecessors: List[Int],
    successors: List[Int],
    abstract_state: Interval,
};

pub type FixpointEngine = struct {
    nodes: List[CfgNode],
    node_count: Int,
    worklist: List[Int],
    iterations: Int,
    is_converged: Bool,
};

pub fn fixpoint_engine_new() -> FixpointEngine {
    let empty_nodes: List[CfgNode] = list_new();
    let empty_wl: List[Int] = list_new();
    return FixpointEngine {
        nodes: empty_nodes,
        node_count: 0,
        worklist: empty_wl,
        iterations: 0,
        is_converged: false,
    };
}

pub fn fixpoint_add_node(engine: &mut FixpointEngine, id: Int, init_state: Interval) -> Bool {
    let empty_preds: List[Int] = list_new();
    let empty_succs: List[Int] = list_new();
    let node = CfgNode {
        node_id: id,
        predecessors: empty_preds,
        successors: empty_succs,
        abstract_state: init_state,
    };
    (engine).nodes = list_push((engine).nodes, node);
    (engine).node_count = (engine).node_count + 1;
    (engine).worklist = list_push((engine).worklist, id);
    return true;
}

pub fn fixpoint_get_node_state(engine: &FixpointEngine, node_idx: Int) -> Interval {
    if node_idx < 0 || node_idx >= (engine).node_count {
        return interval_bottom();
    }
    let node: CfgNode = list_get((engine).nodes, node_idx);
    return (node).abstract_state;
}

pub fn fixpoint_step(engine: &mut FixpointEngine, max_iters: Int) -> Bool {
    if (engine).is_converged {
        return true;
    }
    if (engine).iterations >= max_iters {
        return false;
    }
    (engine).iterations = (engine).iterations + 1;
    if list_len((engine).worklist) == 0 {
        (engine).is_converged = true;
        return true;
    }
    // Process head of worklist
    let head_id: Int = list_get((engine).worklist, 0);
    let mut new_wl: List[Int] = list_new();
    let n: Int = list_len((engine).worklist);
    let mut i: Int = 1;
    while i < n {
        new_wl = list_push(new_wl, list_get((engine).worklist, i));
        i = i + 1;
    }
    (engine).worklist = new_wl;
    return true;
}

pub fn fixpoint_has_stabilized(engine: &FixpointEngine) -> Bool {
    return (engine).is_converged;
}
