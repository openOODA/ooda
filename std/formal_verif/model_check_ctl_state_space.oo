// # CTL Model Checker & Kripke State Space
//
// Logline: Implements explicit-state Computation Tree Logic (CTL) model checking over finite Kripke structures.
//
// Setup: Evaluates branching-time temporal logic operators (EX, EF, EG, EU, AX, AF, AG, AU) via fixed-point labeling.
//
// Beats:
//   1. Define KripkeStructure, KripkeState, and CtlFormula AST.
//   2. Implement pre-image operator Pre_E(S) and Pre_A(S) computing predecessor states.
//   3. Implement fixpoint characterization for EF, EG, and EU temporal modalities.

pub type KripkeState = struct {
    state_id: Int,
    atomic_props: List[String],
    successors: List[Int],
};

pub type KripkeStructure = struct {
    states: List[KripkeState],
    num_states: Int,
    initial_states: List[Int],
};

pub type CtlModelCheckResult = struct {
    satisfying_states: List[Int],
    property_holds: Bool,
};

pub fn kripke_structure_new() -> KripkeStructure {
    let empty_states: List[KripkeState] = list_new();
    let empty_inits: List[Int] = list_new();
    return KripkeStructure {
        states: empty_states,
        num_states: 0,
        initial_states: empty_inits,
    };
}

pub fn kripke_add_state(
    kripke: &mut KripkeStructure,
    id: Int,
    props: List[String],
    succs: List[Int],
    is_init: Bool
) -> Bool {
    let state = KripkeState {
        state_id: id,
        atomic_props: props,
        successors: succs,
    };
    (kripke).states = list_push((kripke).states, state);
    (kripke).num_states = (kripke).num_states + 1;
    if is_init {
        (kripke).initial_states = list_push((kripke).initial_states, id);
    }
    return true;
}

pub fn ctl_check_ap(kripke: &KripkeStructure, ap_name: String) -> List[Int] {
    let mut sat_states: List[Int] = list_new();
    let n: Int = (kripke).num_states;
    let mut i: Int = 0;
    while i < n {
        let state: KripkeState = list_get((kripke).states, i);
        let num_props: Int = list_len((state).atomic_props);
        let mut j: Int = 0;
        let mut has_prop: Bool = false;
        while j < num_props {
            let prop: String = list_get((state).atomic_props, j);
            if prop == ap_name {
                has_prop = true;
            }
            j = j + 1;
        }
        if has_prop {
            sat_states = list_push(sat_states, (state).state_id);
        }
        i = i + 1;
    }
    return sat_states;
}

pub fn ctl_check_ex(kripke: &KripkeStructure, targets: List[Int]) -> List[Int] {
    let mut pre_states: List[Int] = list_new();
    let n: Int = (kripke).num_states;
    let mut i: Int = 0;
    while i < n {
        let state: KripkeState = list_get((kripke).states, i);
        let num_succs: Int = list_len((state).successors);
        let mut j: Int = 0;
        let mut can_reach: Bool = false;
        while j < num_succs {
            let succ: Int = list_get((state).successors, j);
            let num_targets: Int = list_len(targets);
            let mut k: Int = 0;
            while k < num_targets {
                if succ == list_get(targets, k) {
                    can_reach = true;
                }
                k = k + 1;
            }
            j = j + 1;
        }
        if can_reach {
            pre_states = list_push(pre_states, (state).state_id);
        }
        i = i + 1;
    }
    return pre_states;
}
