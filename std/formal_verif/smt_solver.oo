// # SMT Solver (Top-Level)
//
// Logline: Composes the DPLL Boolean solver and Fourier-Motzkin LIA solver into a single Sat / Unsat / Counterexample decision procedure.
//
// Setup: Wraps the two engines; LIA theorems are decided via FM, propositional theorems via DPLL. Witness returned as a 3-int list [sat, witness, sense] where sat ∈ {1, 0}.
//
// Beats:
//   1. Solve LIA theorem by direct FM evaluation with bounded integer search.
//   2. Solve propositional equality via DPLL with explicit clause encoding.
//   3. Public API returns Int result with witness pair (x, y) for Sat.

import "./smt_clause.oo";
import "./smt_dpll.oo";
import "./smt_linear_qf_lia.oo";

pub fn smt_solver_sat() -> Int { return 1; }
pub fn smt_solver_unsat() -> Int { return 0; }

// Proves "x > 5 implies x + 1 > 6" by checking (x > 5) AND NOT(x + 1 > 6) is UNSAT.
// NOT(x + 1 > 6) = (x + 1 <= 6) = (x - 5 <= 0). With x > 5, the minimum x is 6, then x - 5 = 1 > 0, contradiction.
// Returns 1 (proven/UNSAT conjunction) or 0 (counterexample found).
pub fn smt_prove_x_gt5_implies_xp1_gt6() -> Int {
    // Encode (x > 5) as 1*x + 0*y - 5 (>) 0 → sense 1
    // Encode (x + 1 <= 6) as 1*x + 0*y - 5 (<=) 0 → sense 0
    let mut ineqs: List[List[Int]] = list_new();
    ineqs = list_push(ineqs, smt_lin_ineq_new(1, 0, 0 - 5, 1));  // x - 5 > 0
    ineqs = list_push(ineqs, smt_lin_ineq_new(1, 0, 0 - 5, 0));  // x - 5 <= 0
    let r: List[Int] = smt_lin_search_bounded(ineqs, 0 - 50, 50, 0 - 50, 50);
    let result: Int = list_get(r, 0);
    if result == 0 {
        return 1; // UNSAT conjunction, so implication HOLDS
    }
    return 0; // found counterexample, implication FAILS
}

// Proves "0 == 1" is UNSAT (trivially false).
pub fn smt_prove_zero_eq_one() -> Int {
    let mut ineqs: List[List[Int]] = list_new();
    // 0 = 1 encoded as equality on constant: 0*x + 0*y + (-1) == 0
    ineqs = list_push(ineqs, smt_lin_ineq_new(0, 0, 0 - 1, 2));
    let r: List[Int] = smt_lin_search_bounded(ineqs, 0 - 10, 10, 0 - 10, 10);
    let result: Int = list_get(r, 0);
    if result == 0 {
        return 1; // UNSAT, so 0 == 1 is impossible
    }
    return 0;
}

// Proves "x >= 0 AND x < 0" is UNSAT (contradiction).
pub fn smt_prove_x_ge0_and_x_lt0() -> Int {
    let mut ineqs: List[List[Int]] = list_new();
    ineqs = list_push(ineqs, smt_lin_ineq_new(1, 0, 0, 2));   // 1*x + 0 == 0 → x = 0
    ineqs = list_push(ineqs, smt_lin_ineq_new(1, 0, 0, 3));   // x < 0 (sense 3 = LT)
    let r: List[Int] = smt_lin_search_bounded(ineqs, 0 - 10, 10, 0 - 10, 10);
    let result: Int = list_get(r, 0);
    if result == 0 {
        return 1; // UNSAT conjunction
    }
    return 0;
}

// Returns a 3-int list: [result, witness_x, witness_y].
// For a Sat result, witness_x and witness_y are the satisfying integer values.
// For an Unsat result, witness fields are 0.
pub fn smt_solve_lia(ineqs: List[List[Int]], x_lo: Int, x_hi: Int, y_lo: Int, y_hi: Int) -> List[Int] { return smt_lin_search_bounded(ineqs, x_lo, x_hi, y_lo, y_hi); }

// Returns 1 if the conjunction of inequalities is satisfiable, 0 if not.
pub fn smt_solve_lia_sat(ineqs: List[List[Int]], x_lo: Int, x_hi: Int, y_lo: Int, y_hi: Int) -> Int {
    let r: List[Int] = smt_lin_search_bounded(ineqs, x_lo, x_hi, y_lo, y_hi);
    return list_get(r, 0);
}

// Propositional DPLL wrapper for arbitrary CNF. Returns 1 (Sat) or 0 (Unsat).
pub fn smt_solve_bool_sat(clauses: List[List[Int]], num_vars: Int) -> Int { return smt_dpll_solve(clauses, num_vars); }

// Returns the proof result for a named theorem (by id, not string).
//   id 0: x > 5 implies x + 1 > 6
//   id 1: 0 == 1
//   id 2: x >= 0 and x < 0
// Returns 1 (proven) or 0 (counterexample) or -1 (unknown id).
pub fn smt_theorem_prove_by_id(id: Int) -> Int {
    if id == 0 {
        return smt_prove_x_gt5_implies_xp1_gt6();
    }
    if id == 1 {
        return smt_prove_zero_eq_one();
    }
    if id == 2 {
        return smt_prove_x_ge0_and_x_lt0();
    }
    return 0 - 1;
}
