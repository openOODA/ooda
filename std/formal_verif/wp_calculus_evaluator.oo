// # Weakest Precondition Calculus Evaluator
//
// Logline: Implements Dijkstra's Weakest Precondition (WP) predicate transformer semantics for imperative programs.
//
// Setup: Backward symbolic transformer mapping postconditions and program commands to weakest preconditions.
//
// Beats:
//   1. Define WpCommand AST (Skip, Assign, Seq, IfThenElse, WhileLoop).
//   2. Implement backward substitution wp(x := e, Q) = Q[e/x].
//   3. Implement loop invariant verification obligations for while loops.

pub type WpCommand = struct {
    cmd_type: Int, // 1: Skip, 2: Assign, 3: Seq, 4: IfElse, 5: While
    var_name: String,
    expr_str: String,
    cond_str: String,
    invariant_str: String
};

pub fn wp_cmd_skip() -> WpCommand {
    return WpCommand {
        cmd_type: 1,
        var_name: "",
        expr_str: "",
        cond_str: "",
        invariant_str: ""
    };
}

pub fn wp_cmd_assign(v: String, expr: String) -> WpCommand {
    return WpCommand {
        cmd_type: 2,
        var_name: v,
        expr_str: expr,
        cond_str: "",
        invariant_str: ""
    };
}

pub fn wp_cmd_if_else(cond: String) -> WpCommand {
    return WpCommand {
        cmd_type: 4,
        var_name: "",
        expr_str: "",
        cond_str: cond,
        invariant_str: ""
    };
}

pub fn wp_cmd_while(cond: String, inv: String) -> WpCommand {
    return WpCommand {
        cmd_type: 5,
        var_name: "",
        expr_str: "",
        cond_str: cond,
        invariant_str: inv
    };
}

pub fn wp_eval_skip(postcondition: String) -> String {
    return postcondition;
}

pub fn wp_eval_assign(var_n: String, expr_n: String, post: String) -> String {
    return "subst(" + post + ", " + var_n + " -> " + expr_n + ")";
}

pub fn wp_eval_if(
    cond: String,
    wp_then: String,
    wp_else: String
) -> String {
    return "(" + cond + " => " + wp_then + ") /\\ (!(" + cond + ") => " + wp_else + ")";
}

pub fn wp_eval_while_invariant(
    inv: String,
    cond: String,
    wp_body: String,
    post: String
) -> String {
    let loop_preserves: String = "(" + inv + " /\\ " + cond + " => " + wp_body + ")";
    let post_holds: String = "(" + inv + " /\\ !(" + cond + ") => " + post + ")";
    return inv + " /\\ " + loop_preserves + " /\\ " + post_holds;
}
