// # Loop Ranking Function & Termination Prover
//
// Logline: Synthesizes well-founded ranking functions to prove program loop termination.
//
// Setup: Generates lexicographic and linear variant functions bounded below by zero.
//
// Beats:
//   1. Define RankingFunction, TerminationCertificate, and ProgressCondition structures.
//   2. Implement strict monotonicity check: R(x') < R(x) on every loop iteration.
//   3. Implement lower-bound check: R(x) >= 0 under the loop guard condition.

pub type RankingFunction = struct {
    var_name: String,
    coefficient: Int,
    constant_offset: Int,
    is_valid_variant: Bool
};

pub type TerminationCertificate = struct {
    loop_id: Int,
    ranking_fn: RankingFunction,
    is_proven_terminating: Bool
};

pub fn ranking_function_linear(var_n: String, coeff: Int, offset: Int) -> RankingFunction {
    return RankingFunction {
        var_name: var_n,
        coefficient: coeff,
        constant_offset: offset,
        is_valid_variant: true
    };
}

pub fn ranking_eval(r: &RankingFunction, x_val: Int) -> Int {
    return ((r).coefficient * x_val) + (r).constant_offset;
}

pub fn ranking_proves_progress(r: &RankingFunction, current_x: Int, next_x: Int) -> Bool {
    let r_curr: Int = ranking_eval(r, current_x);
    let r_next: Int = ranking_eval(r, next_x);
    return (r_next < r_curr) && (r_curr >= 0);
}

pub fn prove_loop_termination(
    loop_id_num: Int,
    r: RankingFunction,
    init_val: Int,
    step_val: Int
) -> TerminationCertificate {
    let mut terminates: Bool = false;
    if (r).coefficient > 0 && step_val < 0 {
        terminates = true;
    }
    if (r).coefficient < 0 && step_val > 0 {
        terminates = true;
    }
    return TerminationCertificate {
        loop_id: loop_id_num,
        ranking_fn: r,
        is_proven_terminating: terminates
    };
}
