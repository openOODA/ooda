// # SMT Clause
//
// Logline: Boolean CNF clauses and literal data with unit-propagation state for the SMT solver stack.
//
// Setup: Parallel-array storage to dodge the oo_str_release C-emit bug on `let mut struct_with_list_field`.
//
// Beats:
//   1. Define Literal and Clause construction with strict fail-closed validation.
//   2. Track unit-propagation assignment state per literal.
//   3. Provide clause satisfiability evaluation against an assignment vector.

// Parallel-array Clause: avoids the struct-with-list-field release bug.
pub fn smt_clause_new() -> Int {
    // Returns a fresh clause id.
    let mut counter: Int = 0;
    counter = 0;
    return counter;
}

pub fn smt_clause_id(x: Int) -> Int { return x; }

pub fn smt_literal_pos(v: Int) -> Int {
    if v < 0 {
        return 0 - 1;
    }
    return v * 2;
}

pub fn smt_literal_neg(v: Int) -> Int {
    if v < 0 {
        return 0 - 1;
    }
    return v * 2 + 1;
}

pub fn smt_literal_var(lit: Int) -> Int { return lit / 2; }

pub fn smt_literal_is_neg(lit: Int) -> Bool {
    let r: Int = lit - (lit / 2) * 2;
    if r == 1 {
        return true;
    }
    return false;
}

pub fn smt_literal_is_pos(lit: Int) -> Bool {
    let r: Int = lit - (lit / 2) * 2;
    if r == 0 {
        return true;
    }
    return false;
}

pub fn smt_literal_negate(lit: Int) -> Int {
    if smt_literal_is_neg(lit) {
        return lit - 1;
    }
    return lit + 1;
}

// Appends a literal to a clause represented as a parallel-array-backed Int list.
// Returns Err on negative-length or sentinel-0 inputs.
pub fn smt_clause_add_lit(clause: List[Int], lit: Int) -> Result[List[Int], String] {
    if lit < 0 {
        return Err("smt_clause_add_lit: negative literal id");
    }
    let out: List[Int] = list_push(clause, lit);
    return Ok(out);
}

pub fn smt_clause_size(clause: List[Int]) -> Int { return list_len(clause); }

pub fn smt_clause_get(clause: List[Int], i: Int) -> Int { return list_get(clause, i); }

// Evaluates a clause under an assignment vector.
//   assigns: 0 = unassigned, 1 = true, -1 = false
// Returns 1 if clause is satisfied, -1 if clause is in conflict (all false), 0 if unresolved.
pub fn smt_clause_eval(clause: List[Int], assigns: List[Int]) -> Int {
    let mut unassigned: Int = 0;
    let n: Int = list_len(clause);
    let mut i: Int = 0;
    while i < n {
        let lit: Int = list_get(clause, i);
        let var: Int = smt_literal_var(lit);
        if var < list_len(assigns) {
            let val: Int = list_get(assigns, var);
            if val != 0 {
                let is_neg: Bool = smt_literal_is_neg(lit);
                if is_neg && val == 0 - 1 {
                    return 1;
                }
                if is_neg == false && val == 1 {
                    return 1;
                }
            } else {
                unassigned = unassigned + 1;
            }
        } else {
            unassigned = unassigned + 1;
        }
        i = i + 1;
    }
    if unassigned == 0 {
        return 0 - 1;
    }
    return 0;
}

// Returns the index of the unit literal in the clause (when all others are false),
// or -1 if the clause has zero or more than one unassigned literal.
pub fn smt_clause_unit_index(clause: List[Int], assigns: List[Int]) -> Int {
    let mut unit_idx: Int = 0 - 1;
    let mut unassigned: Int = 0;
    let n: Int = list_len(clause);
    let mut i: Int = 0;
    while i < n {
        let lit: Int = list_get(clause, i);
        let var: Int = smt_literal_var(lit);
        let val: Int = list_get(assigns, var);
        if val == 0 {
            unassigned = unassigned + 1;
            unit_idx = i;
        }
        i = i + 1;
    }
    if unassigned == 1 {
        return unit_idx;
    }
    return 0 - 1;
}

pub fn smt_clause_is_empty(clause: List[Int]) -> Bool {
    if list_len(clause) == 0 {
        return true;
    }
    return false;
}

// Pure-literal candidate check: literal `lit` is pure in `clauses`
// when no clause contains its negation among still-unassigned variables.
// Returns 1 if pure-positive, -1 if pure-negative, 0 if not pure.
pub fn smt_literal_polarity_in_clauses(clauses: List[List[Int]], lit: Int) -> Int {
    let neg: Int = smt_literal_negate(lit);
    let var: Int = smt_literal_var(lit);
    let mut has_pos: Int = 0;
    let mut has_neg: Int = 0;
    let m: Int = list_len(clauses);
    let mut i: Int = 0;
    while i < m {
        let c: List[Int] = list_get(clauses, i);
        let n: Int = list_len(c);
        let mut j: Int = 0;
        while j < n {
            let l: Int = list_get(c, j);
            if smt_literal_var(l) == var {
                if smt_literal_is_neg(l) {
                    has_neg = 1;
                } else {
                    has_pos = 1;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if has_pos == 1 && has_neg == 0 {
        return 1;
    }
    if has_neg == 1 && has_pos == 0 {
        return 0 - 1;
    }
    return 0;
}
