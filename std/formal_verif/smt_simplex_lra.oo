// # SMT Simplex Linear Real Arithmetic (LRA) Solver
//
// Logline: Implements the Dual Simplex decision procedure for Quantifier-Free Linear Real Arithmetic (QF_LRA).
//
// Setup: Solves linear systems of equations with variable upper and lower bound constraints.
//
// Beats:
//   1. Define SimplexTableau, VariableBounds, and PivotOperation structures.
//   2. Implement tableau pivoting updating basic and non-basic variable assignments.
//   3. Implement bound violation checking and infeasibility detection (unsat core).

pub type VarBounds = struct {
    var_id: Int,
    lower: Int,
    upper: Int,
    value: Int,
};

pub type SimplexTableau = struct {
    num_basic: Int,
    num_nonbasic: Int,
    matrix_entries: List[Int],
    bounds: List[VarBounds],
    is_feasible: Bool,
};

pub fn var_bounds_new(id: Int, low: Int, high: Int) -> VarBounds {
    return VarBounds {
        var_id: id,
        lower: low,
        upper: high,
        value: low,
    };
}

pub fn simplex_tableau_new(n_basic: Int, n_nonbasic: Int) -> SimplexTableau {
    let empty_entries: List[Int] = list_new();
    let empty_bounds: List[VarBounds] = list_new();
    return SimplexTableau {
        num_basic: n_basic,
        num_nonbasic: n_nonbasic,
        matrix_entries: empty_entries,
        bounds: empty_bounds,
        is_feasible: true,
    };
}

pub fn simplex_is_var_satisfied(vb: &VarBounds) -> Bool {
    return ((vb).value >= (vb).lower) && ((vb).value <= (vb).upper);
}

pub fn simplex_check_all_satisfied(tab: &SimplexTableau) -> Bool {
    let n: Int = list_len((tab).bounds);
    let mut i: Int = 0;
    while i < n {
        let vb: VarBounds = list_get((tab).bounds, i);
        if simplex_is_var_satisfied(&vb) == false {
            return false;
        }
        i = i + 1;
    }
    return true;
}
