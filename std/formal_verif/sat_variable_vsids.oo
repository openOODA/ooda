// # VSIDS Dynamic Variable Heuristic
//
// Logline: Implements the VSIDS branching heuristic with conflict activity bumping and geometric decay.
//
// Setup: Guides SAT search decisions by prioritizing variables frequently involved in recent conflict clauses.
//
// Beats:
//   1. Define VsidsHeap, VariableActivity, and DecayParameters structures.
//   2. Implement activity bumping during conflict clause resolution.
//   3. Implement periodic activity decay and highest-activity decision variable selection.

pub type VariableActivity = struct {
    variable: Int,
    activity_score: Int,
};

pub type VsidsManager = struct {
    activities: List[VariableActivity],
    num_variables: Int,
    decay_factor_percent: Int, // e.g. 95 for 0.95
    bump_increment: Int,
};

pub fn vsids_manager_new(num_vars: Int) -> VsidsManager {
    let mut acts: List[VariableActivity] = list_new();
    let mut i: Int = 0;
    while i <= num_vars {
        let act = VariableActivity {
            variable: i,
            activity_score: 0,
        };
        acts = list_push(acts, act);
        i = i + 1;
    }
    return VsidsManager {
        activities: acts,
        num_variables: num_vars,
        decay_factor_percent: 95,
        bump_increment: 100,
    };
}

pub fn vsids_bump_variable(mgr: &mut VsidsManager, var_id: Int) -> Bool {
    if var_id < 0 || var_id > (mgr).num_variables {
        return false;
    }
    let old_act: VariableActivity = list_get((mgr).activities, var_id);
    let new_act = VariableActivity {
        variable: var_id,
        activity_score: (old_act).activity_score + (mgr).bump_increment,
    };
    let mut updated_list: List[VariableActivity] = list_new();
    let n: Int = list_len((mgr).activities);
    let mut i: Int = 0;
    while i < n {
        if i == var_id {
            updated_list = list_push(updated_list, new_act);
        } else {
            updated_list = list_push(updated_list, list_get((mgr).activities, i));
        }
        i = i + 1;
    }
    (mgr).activities = updated_list;
    return true;
}

pub fn vsids_decay_all(mgr: &mut VsidsManager) -> Bool {
    let mut new_list: List[VariableActivity] = list_new();
    let n: Int = list_len((mgr).activities);
    let mut i: Int = 0;
    while i < n {
        let act: VariableActivity = list_get((mgr).activities, i);
        let decayed = VariableActivity {
            variable: (act).variable,
            activity_score: ((act).activity_score * (mgr).decay_factor_percent) / 100,
        };
        new_list = list_push(new_list, decayed);
        i = i + 1;
    }
    (mgr).activities = new_list;
    return true;
}

pub fn vsids_pick_best_variable(mgr: &VsidsManager, assigned: List[Int]) -> Int {
    let mut best_var: Int = 0;
    let mut max_score: Int = -1;
    let n: Int = (mgr).num_variables;
    let mut i: Int = 1;
    while i <= n {
        let is_unassigned: Bool = (list_get(assigned, i) == 0);
        if is_unassigned {
            let act: VariableActivity = list_get((mgr).activities, i);
            if (act).activity_score > max_score {
                max_score = (act).activity_score;
                best_var = i;
            }
        }
        i = i + 1;
    }
    return best_var;
}
