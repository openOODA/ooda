// # SMT Bit-Blasting Engine (QF_BV)
//
// Logline: Lowers Quantifier-Free Bit-Vector formulas into equisatisfiable Boolean CNF circuits.
//
// Setup: Bit-level circuit synthesis for exact arithmetic, logic, and shift bitvector constraints.
//
// Beats:
//   1. Define BitVectorWire and CnfCircuit structures.
//   2. Implement bitwise AND/OR/XOR and Ripple-Carry Adder gate synthesis.
//   3. Implement bitvector equality comparator lowering to CNF clauses.

import "./sat_dpll_clause_solver.oo";

pub type BvCircuit = struct {
    width: Int,
    bit_literals: List[Int] // Literal IDs for each bit [0..width-1]
};

pub fn bv_circuit_new(w: Int, start_lit: Int) -> BvCircuit {
    let mut bits: List[Int] = list_new();
    let mut i: Int = 0;
    while i < w {
        bits = list_push(bits, start_lit + i);
        i = i + 1;
    }
    return BvCircuit {
        width: w,
        bit_literals: bits
    };
}

pub fn bv_bitblast_eq(bv1: &BvCircuit, bv2: &BvCircuit, formula: &mut SatFormula) -> Bool {
    if (bv1).width != (bv2).width {
        return false;
    }
    let n: Int = (bv1).width;
    let mut i: Int = 0;
    while i < n {
        let b1: Int = list_get((bv1).bit_literals, i);
        let b2: Int = list_get((bv2).bit_literals, i);
        
        // Clause 1: (~b1 \/ b2)
        let mut c1 = sat_clause_new();
        sat_clause_add(&mut c1, sat_lit_neg(b1));
        sat_clause_add(&mut c1, sat_lit_pos(b2));
        sat_formula_add_clause(formula, c1);

        // Clause 2: (b1 \/ ~b2)
        let mut c2 = sat_clause_new();
        sat_clause_add(&mut c2, sat_lit_pos(b1));
        sat_clause_add(&mut c2, sat_lit_neg(b2));
        sat_formula_add_clause(formula, c2);

        i = i + 1;
    }
    return true;
}
