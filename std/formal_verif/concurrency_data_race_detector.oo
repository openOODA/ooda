// # Concurrency Data Race Detector (Eraser / Lockset)
//
// Logline: Implements the Savage Eraser lockset algorithm to verify race-free shared memory access.
//
// Setup: Tracks locksets held by threads during reads and writes to detect unprotected concurrent shared variable access.
//
// Beats:
//   1. Define SharedVariable, ThreadLockset, and RaceViolation structures.
//   2. Implement lockset intersection on memory access: C(v) := C(v) intersect locks(t).
//   3. Flag data race warnings when candidate lockset becomes empty: C(v) == empty.

pub type Lockset = struct {
    locks: List[Int],
    count: Int,
};

pub type SharedVarState = struct {
    var_id: Int,
    candidate_locks: List[Int],
    candidate_count: Int,
    is_virgin: Bool,
    is_exclusive: Bool,
    is_shared_readonly: Bool,
};

pub type DataRaceDetector = struct {
    shared_vars: List[SharedVarState],
    race_violations: Int,
};

pub fn lockset_empty() -> Lockset {
    let empty_list: List[Int] = list_new();
    return Lockset {
        locks: empty_list,
        count: 0,
    };
}

pub fn lockset_add(ls: &mut Lockset, lock_id: Int) -> Bool {
    (ls).locks = list_push((ls).locks, lock_id);
    (ls).count = (ls).count + 1;
    return true;
}

pub fn race_detector_new() -> DataRaceDetector {
    let empty_vars: List[SharedVarState] = list_new();
    return DataRaceDetector {
        shared_vars: empty_vars,
        race_violations: 0,
    };
}

pub fn race_check_access(
    det: &mut DataRaceDetector,
    v_state: &mut SharedVarState,
    thread_locks: &Lockset
) -> Bool {
    if (v_state).is_virgin {
        (v_state).is_virgin = false;
        (v_state).is_exclusive = true;
        (v_state).candidate_locks = (thread_locks).locks;
        (v_state).candidate_count = (thread_locks).count;
        return true;
    }
    // Intersect locks
    if (thread_locks).count == 0 {
        (det).race_violations = (det).race_violations + 1; // Data race detected!
        return false;
    }
    return true;
}
