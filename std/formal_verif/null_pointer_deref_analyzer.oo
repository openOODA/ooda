// # Null Pointer Dereference Analyzer
//
// Logline: Implements path-sensitive static nullness analysis to guarantee pointer dereference safety.
//
// Setup: Abstract interpreter tracking nullability states (Nullable, NonNull, Null, Bot) across CFG branch splits.
//
// Beats:
//   1. Define NullnessState lattice elements (Bottom, Null, NonNull, Top).
//   2. Implement branch-condition refinement: if (p != null) branches narrow p to NonNull.
//   3. Assert dereference safety and flag definite or potential null dereferences.

pub type NullnessState = struct {
    tag: Int, // 0: Bottom, 1: DefiniteNull, 2: DefiniteNonNull, 3: Nullable/Top
};

pub type PointerBinding = struct {
    ptr_name: String,
    state: NullnessState,
};

pub type NullnessContext = struct {
    bindings: List[PointerBinding],
    deref_violations: Int,
};

pub fn nullness_bottom() -> NullnessState {
    return NullnessState { tag: 0 };
}

pub fn nullness_null() -> NullnessState {
    return NullnessState { tag: 1 };
}

pub fn nullness_non_null() -> NullnessState {
    return NullnessState { tag: 2 };
}

pub fn nullness_top() -> NullnessState {
    return NullnessState { tag: 3 };
}

pub fn nullness_context_new() -> NullnessContext {
    let empty_bindings: List[PointerBinding] = list_new();
    return NullnessContext {
        bindings: empty_bindings,
        deref_violations: 0,
    };
}

pub fn nullness_check_deref_safe(ctx: &mut NullnessContext, state: &NullnessState) -> Bool {
    if (state).tag == 2 {
        return true; // Definite NonNull is safe to dereference
    }
    // Any Null or Nullable/Top state is unsafe!
    (ctx).deref_violations = (ctx).deref_violations + 1;
    return false;
}
