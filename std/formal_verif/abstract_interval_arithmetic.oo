// # Abstract Interval Arithmetic Domain
//
// Logline: Implements the classic interval abstract domain [lower, upper] for sound numeric range analysis.
//
// Setup: Pure interval abstract interpreter evaluating arithmetic bounds, lattice join, meet, and widening.
//
// Beats:
//   1. Define Interval data structure with unbounded infinity representations.
//   2. Implement interval arithmetic primitives: addition, subtraction, multiplication, and division.
//   3. Provide lattice operations including inclusion test, join, meet, and standard widening.

pub type Interval = struct {
    low: Int,
    high: Int,
    is_bottom: Bool,
};

pub fn interval_bottom() -> Interval {
    return Interval {
        low: 0,
        high: 0,
        is_bottom: true,
    };
}

pub fn interval_top() -> Interval {
    return Interval {
        low: -2147483647,
        high: 2147483647,
        is_bottom: false,
    };
}

pub fn interval_const(c: Int) -> Interval {
    return Interval {
        low: c,
        high: c,
        is_bottom: false,
    };
}

pub fn interval_range(l: Int, h: Int) -> Interval {
    if l > h {
        return interval_bottom();
    }
    return Interval {
        low: l,
        high: h,
        is_bottom: false,
    };
}

pub fn interval_is_empty(inv: Interval) -> Bool {
    return (inv).is_bottom;
}

pub fn interval_contains(inv: Interval, val: Int) -> Bool {
    if (inv).is_bottom {
        return false;
    }
    return (val >= (inv).low) && (val <= (inv).high);
}

pub fn interval_is_subset(a: Interval, b: Interval) -> Bool {
    if (a).is_bottom {
        return true;
    }
    if (b).is_bottom {
        return false;
    }
    return ((a).low >= (b).low) && ((a).high <= (b).high);
}

pub fn interval_join(a: Interval, b: Interval) -> Interval {
    if (a).is_bottom {
        return b;
    }
    if (b).is_bottom {
        return a;
    }
    let mut min_l: Int = (a).low;
    if (b).low < min_l {
        min_l = (b).low;
    }
    let mut max_h: Int = (a).high;
    if (b).high > max_h {
        max_h = (b).high;
    }
    return Interval {
        low: min_l,
        high: max_h,
        is_bottom: false,
    };
}

pub fn interval_meet(a: Interval, b: Interval) -> Interval {
    if (a).is_bottom || (b).is_bottom {
        return interval_bottom();
    }
    let mut max_l: Int = (a).low;
    if (b).low > max_l {
        max_l = (b).low;
    }
    let mut min_h: Int = (a).high;
    if (b).high < min_h {
        min_h = (b).high;
    }
    if max_l > min_h {
        return interval_bottom();
    }
    return Interval {
        low: max_l,
        high: min_h,
        is_bottom: false,
    };
}

pub fn interval_add(a: Interval, b: Interval) -> Interval {
    if (a).is_bottom || (b).is_bottom {
        return interval_bottom();
    }
    return Interval {
        low: (a).low + (b).low,
        high: (a).high + (b).high,
        is_bottom: false,
    };
}

pub fn interval_sub(a: Interval, b: Interval) -> Interval {
    if (a).is_bottom || (b).is_bottom {
        return interval_bottom();
    }
    return Interval {
        low: (a).low - (b).high,
        high: (a).high - (b).low,
        is_bottom: false,
    };
}

pub fn interval_neg(a: Interval) -> Interval {
    if (a).is_bottom {
        return interval_bottom();
    }
    return Interval {
        low: -(a).high,
        high: -(a).low,
        is_bottom: false,
    };
}

pub fn interval_widen(old_inv: Interval, new_inv: Interval) -> Interval {
    if (old_inv).is_bottom {
        return new_inv;
    }
    if (new_inv).is_bottom {
        return old_inv;
    }
    let mut res_low: Int = (old_inv).low;
    if (new_inv).low < (old_inv).low {
        res_low = -2147483647;
    }
    let mut res_high: Int = (old_inv).high;
    if (new_inv).high > (old_inv).high {
        res_high = 2147483647;
    }
    return Interval {
        low: res_low,
        high: res_high,
        is_bottom: false,
    };
}
