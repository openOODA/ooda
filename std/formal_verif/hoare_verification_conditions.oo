// # Hoare Logic Verification Condition Generator
//
// Logline: Generates and validates Hoare verification obligations {P} C {Q} for axiomatic program correctness.
//
// Setup: Deductive program verification engine establishing axiomatic partial and total correctness.
//
// Beats:
//   1. Define HoareTriple, VerificationObligation, and HoareEnvironment structures.
//   2. Implement Hoare proof rules: skip, assignment, composition, consequence, and loop rule.
//   3. Implement verification obligation collection and proof discharge validation.

pub type HoareTriple = struct {
    precondition: String,
    command_name: String,
    postcondition: String,
    is_valid: Bool,
};

pub type VerificationObligation = struct {
    obligation_id: Int,
    name: String,
    hypothesis: String,
    conclusion: String,
    is_discharged: Bool,
};

pub type HoareEnvironment = struct {
    triples: List[HoareTriple],
    obligations: List[VerificationObligation],
    obligation_count: Int,
    all_valid: Bool,
};

pub fn hoare_env_new() -> HoareEnvironment {
    let empty_triples: List[HoareTriple] = list_new();
    let empty_obs: List[VerificationObligation] = list_new();
    return HoareEnvironment {
        triples: empty_triples,
        obligations: empty_obs,
        obligation_count: 0,
        all_valid: true,
    };
}

pub fn hoare_make_triple(pre: String, cmd: String, post: String) -> HoareTriple {
    return HoareTriple {
        precondition: pre,
        command_name: cmd,
        postcondition: post,
        is_valid: false,
    };
}

pub fn hoare_emit_obligation(
    env: &mut HoareEnvironment,
    name_str: String,
    hyp: String,
    concl: String
) -> Int {
    let next_id: Int = (env).obligation_count + 1;
    let ob = VerificationObligation {
        obligation_id: next_id,
        name: name_str,
        hypothesis: hyp,
        conclusion: concl,
        is_discharged: false,
    };
    (env).obligations = list_push((env).obligations, ob);
    (env).obligation_count = next_id;
    return next_id;
}

pub fn hoare_discharge_obligation(env: &mut HoareEnvironment, ob_id: Int) -> Bool {
    let n: Int = (env).obligation_count;
    let mut i: Int = 0;
    let mut found: Bool = false;
    let mut updated_obs: List[VerificationObligation] = list_new();
    while i < n {
        let ob: VerificationObligation = list_get((env).obligations, i);
        if (ob).obligation_id == ob_id {
            let discharged_ob = VerificationObligation {
                obligation_id: (ob).obligation_id,
                name: (ob).name,
                hypothesis: (ob).hypothesis,
                conclusion: (ob).conclusion,
                is_discharged: true,
            };
            updated_obs = list_push(updated_obs, discharged_ob);
            found = true;
        } else {
            updated_obs = list_push(updated_obs, ob);
        }
        i = i + 1;
    }
    (env).obligations = updated_obs;
    return found;
}

pub fn hoare_check_all_discharged(env: &HoareEnvironment) -> Bool {
    let n: Int = (env).obligation_count;
    let mut i: Int = 0;
    while i < n {
        let ob: VerificationObligation = list_get((env).obligations, i);
        if (ob).is_discharged == false {
            return false;
        }
        i = i + 1;
    }
    return true;
}
