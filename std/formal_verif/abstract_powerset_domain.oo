// # Abstract Powerset Domain
//
// Logline: Implements finite powerset abstract domain for disjunctive path-sensitive program state abstraction.
//
// Setup: Exact finite set collection providing disjunctive completions over abstract states.
//
// Beats:
//   1. Define PowersetDomain structure containing finite integer elements.
//   2. Implement membership testing, set insertion, subset relational checks.
//   3. Implement set union (join), set intersection (meet), and complement.

pub type PowersetDomain = struct {
    elements: List[Int],
    element_count: Int,
    is_top: Bool,
};

pub fn powerset_empty() -> PowersetDomain {
    let empty_list: List[Int] = list_new();
    return PowersetDomain {
        elements: empty_list,
        element_count: 0,
        is_top: false,
    };
}

pub fn powerset_top() -> PowersetDomain {
    let empty_list: List[Int] = list_new();
    return PowersetDomain {
        elements: empty_list,
        element_count: 0,
        is_top: true,
    };
}

pub fn powerset_singleton(val: Int) -> PowersetDomain {
    let mut list_val: List[Int] = list_new();
    list_val = list_push(list_val, val);
    return PowersetDomain {
        elements: list_val,
        element_count: 1,
        is_top: false,
    };
}

pub fn powerset_contains(set: &PowersetDomain, val: Int) -> Bool {
    if (set).is_top {
        return true;
    }
    let n: Int = (set).element_count;
    let mut i: Int = 0;
    while i < n {
        let elem: Int = list_get((set).elements, i);
        if elem == val {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn powerset_insert(set: &mut PowersetDomain, val: Int) -> Bool {
    if (set).is_top {
        return true;
    }
    if powerset_contains(set, val) {
        return false;
    }
    (set).elements = list_push((set).elements, val);
    (set).element_count = (set).element_count + 1;
    return true;
}

pub fn powerset_is_subset(a: &PowersetDomain, b: &PowersetDomain) -> Bool {
    if (b).is_top {
        return true;
    }
    if (a).is_top {
        return false;
    }
    let n: Int = (a).element_count;
    let mut i: Int = 0;
    while i < n {
        let elem: Int = list_get((a).elements, i);
        if powerset_contains(b, elem) == false {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn powerset_join(a: &PowersetDomain, b: &PowersetDomain) -> PowersetDomain {
    if (a).is_top || (b).is_top {
        return powerset_top();
    }
    let mut res: PowersetDomain = powerset_empty();
    let n1: Int = (a).element_count;
    let mut i: Int = 0;
    while i < n1 {
        let elem1: Int = list_get((a).elements, i);
        powerset_insert(&mut res, elem1);
        i = i + 1;
    }
    let n2: Int = (b).element_count;
    let mut j: Int = 0;
    while j < n2 {
        let elem2: Int = list_get((b).elements, j);
        powerset_insert(&mut res, elem2);
        j = j + 1;
    }
    return res;
}

pub fn powerset_meet(a: &PowersetDomain, b: &PowersetDomain) -> PowersetDomain {
    if (a).is_top {
        return *b;
    }
    if (b).is_top {
        return *a;
    }
    let mut res: PowersetDomain = powerset_empty();
    let n1: Int = (a).element_count;
    let mut i: Int = 0;
    while i < n1 {
        let elem: Int = list_get((a).elements, i);
        if powerset_contains(b, elem) {
            powerset_insert(&mut res, elem);
        }
        i = i + 1;
    }
    return res;
}
