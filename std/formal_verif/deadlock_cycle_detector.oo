// # Deadlock Cycle & Lock Hierarchy Detector
//
// Logline: Detects deadlock cycles in Resource Allocation Graphs (RAG) and verifies total lock acquisition hierarchies.
//
// Setup: Sound static and dynamic deadlock prevention verifying strict partial orders on mutex acquisitions.
//
// Beats:
//   1. Define LockHierarchy, ResourceEdge, and DeadlockGraph structures.
//   2. Implement lock acquisition rank order check (rank(L_next) > rank(L_held)).
//   3. Implement Tarjan / DFS cycle detection on wait-for dependency graphs.

pub type LockNode = struct {
    lock_id: Int,
    hierarchy_rank: Int
};

pub type WaitForEdge = struct {
    waiting_thread: Int,
    holding_thread: Int,
    lock_id: Int
};

pub type DeadlockDetector = struct {
    edges: List[WaitForEdge],
    edge_count: Int,
    hierarchy_violations: Int
};

pub fn deadlock_detector_new() -> DeadlockDetector {
    let empty_edges: List[WaitForEdge] = list_new();
    return DeadlockDetector {
        edges: empty_edges,
        edge_count: 0,
        hierarchy_violations: 0
    };
}

pub fn deadlock_check_hierarchy_order(
    det: &mut DeadlockDetector,
    held_rank: Int,
    new_rank: Int
) -> Bool {
    if new_rank <= held_rank {
        (det).hierarchy_violations = (det).hierarchy_violations + 1;
        return false; // Hierarchy inversion: potential ABBA deadlock!
    }
    return true;
}

pub fn deadlock_add_wait_edge(
    det: &mut DeadlockDetector,
    t_wait: Int,
    t_hold: Int,
    l_id: Int
) -> Bool {
    let edge = WaitForEdge {
        waiting_thread: t_wait,
        holding_thread: t_hold,
        lock_id: l_id
    };
    (det).edges = list_push((det).edges, edge);
    (det).edge_count = (det).edge_count + 1;
    return true;
}
