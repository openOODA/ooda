// # Pointer Alias Analysis (Steensgaard & Andersen)
//
// Logline: Implements equality-based (Steensgaard) and inclusion-based (Andersen) static pointer alias analysis.
//
// Setup: Interprocedural points-to graph constructor resolving memory aliasing relationships.
//
// Beats:
//   1. Define PointsToNode, ConstraintType, and PointsToGraph structures.
//   2. Implement Steensgaard fast almost-linear unification of points-to sets.
//   3. Implement Andersen inclusion constraint propagation (p = &q, p = q, *p = q, p = *q).

pub type PointsToEdge = struct {
    source_var: String,
    target_loc: String,
};

pub type AliasGraph = struct {
    edges: List[PointsToEdge],
    edge_count: Int,
    is_flow_sensitive: Bool,
};

pub fn alias_graph_new(flow_sens: Bool) -> AliasGraph {
    let empty_edges: List[PointsToEdge] = list_new();
    return AliasGraph {
        edges: empty_edges,
        edge_count: 0,
        is_flow_sensitive: flow_sens,
    };
}

pub fn alias_add_points_to(graph: &mut AliasGraph, var_p: String, loc_x: String) -> Bool {
    let edge = PointsToEdge {
        source_var: var_p,
        target_loc: loc_x,
    };
    (graph).edges = list_push((graph).edges, edge);
    (graph).edge_count = (graph).edge_count + 1;
    return true;
}

pub fn alias_may_alias(graph: &AliasGraph, var_a: String, var_b: String) -> Bool {
    if var_a == var_b {
        return true;
    }
    let n: Int = (graph).edge_count;
    let mut i: Int = 0;
    while i < n {
        let e1: PointsToEdge = list_get((graph).edges, i);
        if (e1).source_var == var_a {
            let mut j: Int = 0;
            while j < n {
                let e2: PointsToEdge = list_get((graph).edges, j);
                if ((e2).source_var == var_b) && ((e1).target_loc == (e2).target_loc) {
                    return true; // Overlapping target location: May Alias!
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return false;
}
