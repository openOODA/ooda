// # Design-by-Contract & Blame Assignment
//
// Logline: Implements Eiffel-style contracts (requires, ensures, invariant) with precise Findler-Felleisen blame tracking.
//
// Setup: Runtime and static contract checking assigning blame to caller on precondition failure and callee on postcondition failure.
//
// Beats:
//   1. Define FunctionContract, ContractViolation, and BlameParty structures.
//   2. Implement precondition verification: failure blames the calling context.
//   3. Implement postcondition and class invariant verification: failure blames the callee function.

pub type FunctionContract = struct {
    function_name: String,
    caller_name: String,
    precondition_expr: String,
    postcondition_expr: String,
    class_invariant_expr: String
};

pub type BlameAssignment = struct {
    blamed_party: String,
    violated_contract_part: String, // "Precondition" or "Postcondition"
    function_name: String
};

pub fn contract_new(
    fn_name: String,
    clr_name: String,
    pre: String,
    post: String,
    inv: String
) -> FunctionContract {
    return FunctionContract {
        function_name: fn_name,
        caller_name: clr_name,
        precondition_expr: pre,
        postcondition_expr: post,
        class_invariant_expr: inv
    };
}

pub fn contract_check_precondition(
    c: &FunctionContract,
    pre_satisfied: Bool
) -> BlameAssignment {
    if pre_satisfied == false {
        return BlameAssignment {
            blamed_party: (c).caller_name,
            violated_contract_part: "Precondition",
            function_name: (c).function_name
        };
    }
    return BlameAssignment {
        blamed_party: "None",
        violated_contract_part: "OK",
        function_name: (c).function_name
    };
}

pub fn contract_check_postcondition(
    c: &FunctionContract,
    post_satisfied: Bool
) -> BlameAssignment {
    if post_satisfied == false {
        return BlameAssignment {
            blamed_party: (c).function_name,
            violated_contract_part: "Postcondition",
            function_name: (c).function_name
        };
    }
    return BlameAssignment {
        blamed_party: "None",
        violated_contract_part: "OK",
        function_name: (c).function_name
    };
}
