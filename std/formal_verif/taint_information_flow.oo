// # Information Flow & Taint Lattice Verifier
//
// Logline: Verifies non-interference and secure information flow across multilevel security lattices (Low <= High).
//
// Setup: Sound static taint analyzer tracking confidential sources and enforcing sanitization at untrusted sinks.
//
// Beats:
//   1. Define SecurityLevel, TaintSource, and InformationFlowLattice structures.
//   2. Implement lattice ordering Low <= High and join operations.
//   3. Verify non-interference: High secret data cannot flow into Low public observable sinks.

pub type SecurityLevel = struct {
    level_id: Int, // 0: Public/Low, 1: Confidential/High, 2: Secret
    name: String,
};

pub type TaintVariable = struct {
    var_name: String,
    level: SecurityLevel,
    is_sanitized: Bool,
};

pub type InformationFlowVerifier = struct {
    variables: List[TaintVariable],
    violation_count: Int,
};

pub fn security_low() -> SecurityLevel {
    return SecurityLevel { level_id: 0, name: "Low" };
}

pub fn security_high() -> SecurityLevel {
    return SecurityLevel { level_id: 1, name: "High" };
}

pub fn info_flow_verifier_new() -> InformationFlowVerifier {
    let empty_vars: List[TaintVariable] = list_new();
    return InformationFlowVerifier {
        variables: empty_vars,
        violation_count: 0,
    };
}

pub fn info_flow_can_flow(source_lvl: SecurityLevel, sink_lvl: SecurityLevel) -> Bool {
    // Flow allowed iff source_lvl <= sink_lvl
    return (source_lvl).level_id <= (sink_lvl).level_id;
}

pub fn info_flow_assign_check(
    verifier: &mut InformationFlowVerifier,
    source_lvl: SecurityLevel,
    sink_lvl: SecurityLevel
) -> Bool {
    if info_flow_can_flow(source_lvl, sink_lvl) == false {
        (verifier).violation_count = (verifier).violation_count + 1;
        return false; // Information leak: High data flowing to Low sink!
    }
    return true;
}
