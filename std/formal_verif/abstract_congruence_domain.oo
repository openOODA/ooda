// # Abstract Congruence Domain
//
// Logline: Implements congruence arithmetic aZ + b for memory alignment, array indexing, and stride analysis.
//
// Setup: Non-relational domain capturing modular arithmetic properties and address alignment constraints.
//
// Beats:
//   1. Define Congruence value structure (modulus, remainder, is_bottom).
//   2. Implement greatest common divisor (GCD) and extended Euclidean helpers.
//   3. Implement lattice join, meet, addition, and alignment verification.

pub type Congruence = struct {
    modulus: Int,
    remainder: Int,
    is_bottom: Bool,
};

pub fn gcd(a: Int, b: Int) -> Int {
    let mut x: Int = a;
    if x < 0 {
        x = -x;
    }
    let mut y: Int = b;
    if y < 0 {
        y = -y;
    }
    while y != 0 {
        let t: Int = y;
        y = x % y;
        x = t;
    }
    return x;
}

pub fn congruence_bottom() -> Congruence {
    return Congruence {
        modulus: 0,
        remainder: 0,
        is_bottom: true,
    };
}

pub fn congruence_top() -> Congruence {
    return Congruence {
        modulus: 1,
        remainder: 0,
        is_bottom: false,
    };
}

pub fn congruence_const(c: Int) -> Congruence {
    return Congruence {
        modulus: 0,
        remainder: c,
        is_bottom: false,
    };
}

pub fn congruence_stride(mod_val: Int, rem_val: Int) -> Congruence {
    if mod_val < 0 {
        return congruence_bottom();
    }
    if mod_val == 0 {
        return Congruence { modulus: 0, remainder: rem_val, is_bottom: false };
    }
    let norm_rem: Int = ((rem_val % mod_val) + mod_val) % mod_val;
    return Congruence {
        modulus: mod_val,
        remainder: norm_rem,
        is_bottom: false,
    };
}

pub fn congruence_contains(c: &Congruence, val: Int) -> Bool {
    if (c).is_bottom {
        return false;
    }
    if (c).modulus == 0 {
        return val == (c).remainder;
    }
    let diff: Int = val - (c).remainder;
    return (diff % (c).modulus) == 0;
}

pub fn congruence_join(c1: &Congruence, c2: &Congruence) -> Congruence {
    if (c1).is_bottom {
        return *c2;
    }
    if (c2).is_bottom {
        return *c1;
    }
    let diff: Int = (c1).remainder - (c2).remainder;
    let g1: Int = gcd((c1).modulus, (c2).modulus);
    let g: Int = gcd(g1, diff);
    if g == 0 {
        return Congruence { modulus: 0, remainder: (c1).remainder, is_bottom: false };
    }
    let rem: Int = ((c1).remainder % g + g) % g;
    return Congruence {
        modulus: g,
        remainder: rem,
        is_bottom: false,
    };
}

pub fn congruence_add(c1: &Congruence, c2: &Congruence) -> Congruence {
    if (c1).is_bottom || (c2).is_bottom {
        return congruence_bottom();
    }
    let g: Int = gcd((c1).modulus, (c2).modulus);
    let rem: Int = (c1).remainder + (c2).remainder;
    if g == 0 {
        return Congruence { modulus: 0, remainder: rem, is_bottom: false };
    }
    return Congruence {
        modulus: g,
        remainder: ((rem % g) + g) % g,
        is_bottom: false,
    };
}
