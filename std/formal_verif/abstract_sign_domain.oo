// # Abstract Sign Domain
//
// Logline: Implements the non-relational sign abstract lattice for integer sign analysis.
//
// Setup: Abstract interpretation domain abstracting numeric values into sign equivalence classes.
//
// Beats:
//   1. Define sign lattice elements (Bottom, Negative, Zero, Positive, NonNeg, NonPos, Top).
//   2. Implement abstraction alpha mapping from concrete integer to sign element.
//   3. Implement sign transfer functions for addition, negation, multiplication, and lattice join/meet.

pub type SignValue = struct {
    tag: Int, // 0: Bottom, 1: Neg, 2: Zero, 3: Pos, 4: NonNeg, 5: NonPos, 6: Top
};

pub fn sign_bottom() -> SignValue {
    return SignValue { tag: 0 };
}

pub fn sign_neg() -> SignValue {
    return SignValue { tag: 1 };
}

pub fn sign_zero() -> SignValue {
    return SignValue { tag: 2 };
}

pub fn sign_pos() -> SignValue {
    return SignValue { tag: 3 };
}

pub fn sign_non_neg() -> SignValue {
    return SignValue { tag: 4 };
}

pub fn sign_non_pos() -> SignValue {
    return SignValue { tag: 5 };
}

pub fn sign_top() -> SignValue {
    return SignValue { tag: 6 };
}

pub fn sign_alpha(v: Int) -> SignValue {
    if v < 0 {
        return sign_neg();
    }
    if v == 0 {
        return sign_zero();
    }
    return sign_pos();
}

pub fn sign_is_bottom(s: SignValue) -> Bool {
    return (s).tag == 0;
}

pub fn sign_is_top(s: SignValue) -> Bool {
    return (s).tag == 6;
}

pub fn sign_join(a: SignValue, b: SignValue) -> SignValue {
    if (a).tag == 0 {
        return b;
    }
    if (b).tag == 0 {
        return a;
    }
    if (a).tag == (b).tag {
        return a;
    }
    if ((a).tag == 1 && (b).tag == 2) || ((a).tag == 2 && (b).tag == 1) {
        return sign_non_pos();
    }
    if ((a).tag == 3 && (b).tag == 2) || ((a).tag == 2 && (b).tag == 3) {
        return sign_non_neg();
    }
    if (a).tag == 4 {
        if (b).tag == 2 || (b).tag == 3 {
            return sign_non_neg();
        }
    }
    if (b).tag == 4 {
        if (a).tag == 2 || (a).tag == 3 {
            return sign_non_neg();
        }
    }
    if (a).tag == 5 {
        if (b).tag == 1 || (b).tag == 2 {
            return sign_non_pos();
        }
    }
    if (b).tag == 5 {
        if (a).tag == 1 || (a).tag == 2 {
            return sign_non_pos();
        }
    }
    return sign_top();
}

pub fn sign_negate(s: SignValue) -> SignValue {
    if (s).tag == 1 {
        return sign_pos();
    }
    if (s).tag == 3 {
        return sign_neg();
    }
    if (s).tag == 4 {
        return sign_non_pos();
    }
    if (s).tag == 5 {
        return sign_non_neg();
    }
    return s;
}

pub fn sign_multiply(a: SignValue, b: SignValue) -> SignValue {
    if (a).tag == 0 || (b).tag == 0 {
        return sign_bottom();
    }
    if (a).tag == 2 || (b).tag == 2 {
        return sign_zero();
    }
    if (a).tag == 1 && (b).tag == 1 {
        return sign_pos();
    }
    if (a).tag == 3 && (b).tag == 3 {
        return sign_pos();
    }
    if ((a).tag == 1 && (b).tag == 3) || ((a).tag == 3 && (b).tag == 1) {
        return sign_neg();
    }
    return sign_top();
}
