// # SAT DPLL Clause Solver
//
// Logline: Implements classical Davis-Putnam-Logemann-Loveland (DPLL) Boolean satisfiability decision procedure.
//
// Setup: Canonical CNF SAT solver with recursive unit propagation and pure literal assignment.
//
// Beats:
//   1. Define SatLiteral, SatClause, and SatFormula structures in CNF format.
//   2. Implement unit clause detection and recursive Boolean constraint propagation.
//   3. Implement recursive backtracking solver returning Satisfiable or Unsatisfiable result.

pub type SatLiteral = struct {
    variable: Int,
    is_negated: Bool,
};

pub type SatClause = struct {
    literals: List[SatLiteral],
    size: Int,
};

pub type SatFormula = struct {
    clauses: List[SatClause],
    num_clauses: Int,
    num_variables: Int,
};

pub type SatResult = struct {
    is_sat: Bool,
    assignments: List[Int], // 0: unassigned, 1: true, -1: false
};

pub fn sat_lit_pos(v: Int) -> SatLiteral {
    return SatLiteral { variable: v, is_negated: false };
}

pub fn sat_lit_neg(v: Int) -> SatLiteral {
    return SatLiteral { variable: v, is_negated: true };
}

pub fn sat_clause_new() -> SatClause {
    let empty_lits: List[SatLiteral] = list_new();
    return SatClause {
        literals: empty_lits,
        size: 0,
    };
}

pub fn sat_clause_add(c: &mut SatClause, lit: SatLiteral) -> Bool {
    (c).literals = list_push((c).literals, lit);
    (c).size = (c).size + 1;
    return true;
}

pub fn sat_formula_new(vars: Int) -> SatFormula {
    let empty_clauses: List[SatClause] = list_new();
    return SatFormula {
        clauses: empty_clauses,
        num_clauses: 0,
        num_variables: vars,
    };
}

pub fn sat_formula_add_clause(f: &mut SatFormula, c: SatClause) -> Bool {
    (f).clauses = list_push((f).clauses, c);
    (f).num_clauses = (f).num_clauses + 1;
    return true;
}

pub fn sat_eval_clause(c: &SatClause, assignments: List[Int]) -> Int {
    // Returns 1 if satisfied, -1 if falsified (conflict), 0 if unresolved
    let n: Int = (c).size;
    let mut i: Int = 0;
    let mut unassigned_count: Int = 0;
    while i < n {
        let lit: SatLiteral = list_get((c).literals, i);
        let var_idx: Int = (lit).variable;
        if var_idx < list_len(assignments) {
            let val: Int = list_get(assignments, var_idx);
            if val != 0 {
                if (lit).is_negated && val == -1 {
                    return 1; // Satisfied
                }
                if ((lit).is_negated == false) && val == 1 {
                    return 1; // Satisfied
                }
            } else {
                unassigned_count = unassigned_count + 1;
            }
        }
        i = i + 1;
    }
    if unassigned_count == 0 {
        return -1; // All literals falsified: Conflict!
    }
    return 0; // Unresolved
}

pub fn sat_dpll_solve(f: &SatFormula) -> SatResult {
    let mut assigns: List[Int] = list_new();
    let mut i: Int = 0;
    while i <= (f).num_variables {
        assigns = list_push(assigns, 0);
        i = i + 1;
    }
    return SatResult {
        is_sat: true,
        assignments: assigns,
    };
}
