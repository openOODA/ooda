// # Two-Watched Literals (2WL) Engine
//
// Logline: Implements lazy clause evaluation via the Two-Watched Literals scheme for sub-linear unit propagation.
//
// Setup: High-speed SAT watch list indexing mapping literals to clauses watching them.
//
// Beats:
//   1. Define WatchedClause and WatchList structures.
//   2. Attach exactly two non-false watch pointers to each active CNF clause.
//   3. Implement lazy watch pointer update and unit propagation event dispatch.

pub type WatchedClause = struct {
    clause_id: Int,
    watch_lit_1: Int,
    watch_lit_2: Int,
};

pub type WatchList = struct {
    literal: Int,
    watched_clauses: List[WatchedClause],
    count: Int,
};

pub type WatchEvent = struct { kind: Int, lit: Int };

pub fn watched_clause_new(c_id: Int, w1: Int, w2: Int) -> WatchedClause {
    return WatchedClause {
        clause_id: c_id,
        watch_lit_1: w1,
        watch_lit_2: w2,
    };
}

pub fn watch_list_new(lit: Int) -> WatchList {
    let empty_list: List[WatchedClause] = list_new();
    return WatchList {
        literal: lit,
        watched_clauses: empty_list,
        count: 0,
    };
}

pub fn watch_list_add(wl: &mut WatchList, wc: WatchedClause) -> Bool {
    (wl).watched_clauses = list_push((wl).watched_clauses, wc);
    (wl).count = (wl).count + 1;
    return true;
}

pub fn watch_update_pointer(
    wc: &mut WatchedClause,
    old_lit: Int,
    new_lit: Int
) -> Bool {
    if (wc).watch_lit_1 == old_lit {
        (wc).watch_lit_1 = new_lit;
        return true;
    }
    if (wc).watch_lit_2 == old_lit {
        (wc).watch_lit_2 = new_lit;
        return true;
    }
    return false;
}

fn sat_two_watched_literals_var(lit: Int) -> Int {
    if lit < 0 { return 0 - lit; }
    return lit;
}

fn sat_two_watched_literals_false(lit: Int, assigns: List[Int]) -> Bool {
    let v: Int = sat_two_watched_literals_var(lit);
    if v >= list_len(assigns) { return false; }
    let a: Int = list_get(assigns, v);
    if lit > 0 { return a == -1; }
    return a == 1;
}

fn sat_two_watched_literals_true(lit: Int, assigns: List[Int]) -> Bool {
    let v: Int = sat_two_watched_literals_var(lit);
    if v >= list_len(assigns) { return false; }
    let a: Int = list_get(assigns, v);
    if lit > 0 { return a == 1; }
    return a == -1;
}

fn sat_two_watched_literals_other(
    clause: List[Int],
    old_lit: Int,
    keep: Int,
    assigns: List[Int]
) -> Int {
    let n: Int = list_len(clause);
    let mut i: Int = 0;
    while i < n {
        let lit: Int = list_get(clause, i);
        if lit != old_lit {
            if lit != keep {
                if sat_two_watched_literals_false(lit, assigns) == false {
                    return lit;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

pub fn sat_two_watched_literals_propagate(
    wc: &mut WatchedClause,
    clause: List[Int],
    assigns: List[Int]
) -> WatchEvent {
    let w1: Int = (wc).watch_lit_1;
    let w2: Int = (wc).watch_lit_2;
    if sat_two_watched_literals_true(w1, assigns) {
        return WatchEvent { kind: 1, lit: 0 };
    }
    if sat_two_watched_literals_true(w2, assigns) {
        return WatchEvent { kind: 1, lit: 0 };
    }
    let f1: Bool = sat_two_watched_literals_false(w1, assigns);
    let f2: Bool = sat_two_watched_literals_false(w2, assigns);
    if f1 {
        let alt: Int = sat_two_watched_literals_other(clause, w1, w2, assigns);
        if alt != 0 {
            let _moved: Bool = watch_update_pointer(wc, w1, alt);
            return WatchEvent { kind: 1, lit: alt };
        }
        if f2 { return WatchEvent { kind: 3, lit: 0 }; }
        return WatchEvent { kind: 2, lit: w2 };
    }
    if f2 {
        let alt2: Int = sat_two_watched_literals_other(clause, w2, w1, assigns);
        if alt2 != 0 {
            let _moved2: Bool = watch_update_pointer(wc, w2, alt2);
            return WatchEvent { kind: 1, lit: alt2 };
        }
        return WatchEvent { kind: 2, lit: w1 };
    }
    return WatchEvent { kind: 0, lit: 0 };
}
