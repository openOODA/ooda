// # Two-Watched Literals (2WL) Engine
//
// Logline: Implements lazy clause evaluation via the Two-Watched Literals scheme for sub-linear unit propagation.
//
// Setup: High-speed SAT watch list indexing mapping literals to clauses watching them.
//
// Beats:
//   1. Define WatchedClause and WatchList structures.
//   2. Attach exactly two non-false watch pointers to each active CNF clause.
//   3. Implement lazy watch pointer update and unit propagation event dispatch.

pub type WatchedClause = struct {
    clause_id: Int,
    watch_lit_1: Int,
    watch_lit_2: Int,
};

pub type WatchList = struct {
    literal: Int,
    watched_clauses: List[WatchedClause],
    count: Int,
};

pub fn watched_clause_new(c_id: Int, w1: Int, w2: Int) -> WatchedClause {
    return WatchedClause {
        clause_id: c_id,
        watch_lit_1: w1,
        watch_lit_2: w2,
    };
}

pub fn watch_list_new(lit: Int) -> WatchList {
    let empty_list: List[WatchedClause] = list_new();
    return WatchList {
        literal: lit,
        watched_clauses: empty_list,
        count: 0,
    };
}

pub fn watch_list_add(wl: &mut WatchList, wc: WatchedClause) -> Bool {
    (wl).watched_clauses = list_push((wl).watched_clauses, wc);
    (wl).count = (wl).count + 1;
    return true;
}

pub fn watch_update_pointer(
    wc: &mut WatchedClause,
    old_lit: Int,
    new_lit: Int
) -> Bool {
    if (wc).watch_lit_1 == old_lit {
        (wc).watch_lit_1 = new_lit;
        return true;
    }
    if (wc).watch_lit_2 == old_lit {
        (wc).watch_lit_2 = new_lit;
        return true;
    }
    return false;
}
