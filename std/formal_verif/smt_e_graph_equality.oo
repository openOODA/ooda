// # SMT E-Graph Congruence Closure Engine
//
// Logline: Implements E-graphs and congruence closure for Equality with Uninterpreted Functions (EUF).
//
// Setup: Fast equivalence class unification with memoized function application congruence.
//
// Beats:
//   1. Define ENode, EClass, and EGraph structures.
//   2. Implement Union-Find with path compression for term equivalence.
//   3. Implement congruence propagation: a == b => f(a) == f(b).

pub type ENode = struct {
    op_name: String,
    children_eclasses: List[Int],
};

pub type EClass = struct {
    class_id: Int,
    parent_id: Int,
    nodes: List[ENode],
};

pub type EGraph = struct {
    classes: List[EClass],
    class_count: Int,
};

pub fn egraph_new() -> EGraph {
    let empty_classes: List[EClass] = list_new();
    return EGraph {
        classes: empty_classes,
        class_count: 0,
    };
}

pub fn egraph_add_class(g: &mut EGraph) -> Int {
    let new_id: Int = (g).class_count;
    let empty_nodes: List[ENode] = list_new();
    let ec = EClass {
        class_id: new_id,
        parent_id: new_id,
        nodes: empty_nodes,
    };
    (g).classes = list_push((g).classes, ec);
    (g).class_count = new_id + 1;
    return new_id;
}

pub fn egraph_find(g: &EGraph, class_id: Int) -> Int {
    let mut curr: Int = class_id;
    while curr < (g).class_count {
        let ec: EClass = list_get((g).classes, curr);
        if (ec).parent_id == curr {
            return curr;
        }
        curr = (ec).parent_id;
    }
    return curr;
}

pub fn egraph_union(g: &mut EGraph, c1: Int, c2: Int) -> Int {
    let root1: Int = egraph_find(g, c1);
    let root2: Int = egraph_find(g, c2);
    if root1 == root2 {
        return root1;
    }
    let mut updated: List[EClass] = list_new();
    let n: Int = (g).class_count;
    let mut i: Int = 0;
    while i < n {
        let ec: EClass = list_get((g).classes, i);
        if (ec).class_id == root1 {
            let updated_ec = EClass {
                class_id: (ec).class_id,
                parent_id: root2,
                nodes: (ec).nodes,
            };
            updated = list_push(updated, updated_ec);
        } else {
            updated = list_push(updated, ec);
        }
        i = i + 1;
    }
    (g).classes = updated;
    return root2;
}

pub fn egraph_are_equivalent(g: &EGraph, c1: Int, c2: Int) -> Bool {
    return egraph_find(g, c1) == egraph_find(g, c2);
}
