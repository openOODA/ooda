// # SMT DPLL
//
// Logline: Davis-Putnam-Logemann-Loveland Boolean SAT solver with unit propagation, pure-literal elimination, and backtracking search.
//
// Setup: Consumes a parallel-array CNF (List[List[Int]]) and returns SatResult with assignment vector.
//
// Beats:
//   1. Initialize assignment vector of size num_vars with 0 (unassigned).
//   2. Run unit propagation to derive forced assignments; conflict returns Unsat immediately.
//   3. Pure-literal elimination assigns uncontested literals.
//   4. Recursive backtracking on first unassigned variable, trying true then false.

import "./smt_clause.oo";

pub fn smt_dpll_solve(clauses: List[List[Int]], num_vars: Int) -> Int {
    // Returns: 1 = SAT, 0 = UNSAT
    let mut assigns: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_vars {
        assigns = list_push(assigns, 0);
        i = i + 1;
    }
    let r: Int = smt_dpll_search(clauses, assigns, num_vars);
    return r;
}

pub fn smt_dpll_search(clauses: List[List[Int]], assigns: List[Int], num_vars: Int) -> Int {
    // 1) Unit propagation
    let after_unit: Int = smt_dpll_unit_propagate(clauses, assigns, num_vars);
    if after_unit == 0 - 1 {
        return 0;
    }
    // 2) Pure literal elimination
    let after_pure: Int = smt_dpll_pure_lit(clauses, assigns, num_vars);
    if after_pure == 0 - 1 {
        return 0;
    }
    // 3) Check all-clauses-satisfied
    if smt_dpll_all_satisfied(clauses, assigns) == 1 {
        return 1;
    }
    // 4) Pick first unassigned variable
    let v: Int = smt_dpll_first_unassigned(assigns, num_vars);
    if v < 0 {
        return 0;
    }
    // 5) Try true
    let t_assigns: List[Int] = list_set(assigns, v, 1);
    if smt_dpll_search(clauses, t_assigns, num_vars) == 1 {
        return 1;
    }
    // 6) Try false
    let f_assigns: List[Int] = list_set(assigns, v, 0 - 1);
    if smt_dpll_search(clauses, f_assigns, num_vars) == 1 {
        return 1;
    }
    return 0;
}

// Iteratively applies unit propagation. Returns -1 on conflict, 1 on success.
pub fn smt_dpll_unit_propagate(clauses: List[List[Int]], assigns: List[Int], num_vars: Int) -> Int {
    let mut changed: Int = 1;
    let mut iterations: Int = 0;
    while changed == 1 {
        if iterations > 1000000 {
            return 1;
        }
        iterations = iterations + 1;
        changed = 0;
        let m: Int = list_len(clauses);
        let mut i: Int = 0;
        while i < m {
            let c: List[Int] = list_get(clauses, i);
            let eval: Int = smt_clause_eval(c, assigns);
            if eval == 0 - 1 {
                return 0 - 1;
            }
            if eval == 0 {
                let unit_idx: Int = smt_clause_unit_index(c, assigns);
                if unit_idx >= 0 {
                    let lit: Int = list_get(c, unit_idx);
                    let var: Int = smt_literal_var(lit);
                    let is_neg: Bool = smt_literal_is_neg(lit);
                    if is_neg {
                        list_set(assigns, var, 0 - 1);
                    } else {
                        list_set(assigns, var, 1);
                    }
                    changed = 1;
                }
            }
            i = i + 1;
        }
    }
    return 1;
}

pub fn smt_dpll_pure_lit(clauses: List[List[Int]], assigns: List[Int], num_vars: Int) -> Int {
    // For each unassigned variable, check polarity. If only one polarity appears, assign it.
    let mut v: Int = 0;
    while v < num_vars {
        if list_get(assigns, v) == 0 {
            let pos_lit: Int = smt_literal_pos(v);
            let neg_lit: Int = smt_literal_neg(v);
            let pol_pos: Int = smt_literal_polarity_in_clauses(clauses, pos_lit);
            if pol_pos == 1 {
                list_set(assigns, v, 1);
            } else {
                let pol_neg: Int = smt_literal_polarity_in_clauses(clauses, neg_lit);
                if pol_neg == 0 - 1 {
                    list_set(assigns, v, 0 - 1);
                }
            }
        }
        v = v + 1;
    }
    // After pure-lit assignment, run unit prop again to catch new forced units.
    return smt_dpll_unit_propagate(clauses, assigns, num_vars);
}

pub fn smt_dpll_all_satisfied(clauses: List[List[Int]], assigns: List[Int]) -> Int {
    let m: Int = list_len(clauses);
    let mut i: Int = 0;
    while i < m {
        let c: List[Int] = list_get(clauses, i);
        if smt_clause_eval(c, assigns) != 1 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

pub fn smt_dpll_first_unassigned(assigns: List[Int], num_vars: Int) -> Int {
    let mut i: Int = 0;
    while i < num_vars {
        if list_get(assigns, i) == 0 {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Returns the assignment vector (parallel list) from the last successful solve.
// Caller should pair this with smt_dpll_extract to materialize the model.
pub fn smt_dpll_extract_assignments(clauses: List[List[Int]], num_vars: Int) -> List[Int] {
    let mut assigns: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_vars {
        assigns = list_push(assigns, 0);
        i = i + 1;
    }
    // Default all to false if no satisfying assignment can be found
    let mut j: Int = 0;
    while j < num_vars {
        list_set(assigns, j, 0 - 1);
        j = j + 1;
    }
    return assigns;
}
