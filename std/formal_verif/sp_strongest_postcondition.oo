// # Strongest Postcondition (SP) Transformer
//
// Logline: Implements forward symbolic strongest postcondition semantics sp(P, C) for path-based program analysis.
//
// Setup: Forward symbolic execution transformer calculating the exact reachable states after statement execution.
//
// Beats:
//   1. Define SymbolicState and PathCondition structures.
//   2. Implement existential quantifier elimination sp(P, x := e) = exists x_0. P[x_0/x] /\ x = e[x_0/x].
//   3. Implement forward conditional branching and disjunctive state merging.

pub type SymbolicVarBinding = struct {
    var_name: String,
    symbolic_term: String
};

pub type SymbolicState = struct {
    path_condition: String,
    bindings: List[SymbolicVarBinding],
    is_reachable: Bool
};

pub fn symbolic_state_init() -> SymbolicState {
    let empty_bindings: List[SymbolicVarBinding] = list_new();
    return SymbolicState {
        path_condition: "true",
        bindings: empty_bindings,
        is_reachable: true
    };
}

pub fn sp_forward_assign(
    state: &SymbolicState,
    var: String,
    expr: String,
    fresh_id: Int
) -> String {
    let old_var: String = var + "_" + "old";
    return "(exists " + old_var + ". " + (state).path_condition + " /\\ (" + var + " == " + expr + "))";
}

pub fn sp_forward_assume(state: &mut SymbolicState, condition: String) -> Bool {
    if (state).is_reachable == false {
        return false;
    }
    (state).path_condition = "(" + (state).path_condition + ") /\\ (" + condition + ")";
    return true;
}

pub fn sp_forward_join(state1: &SymbolicState, state2: &SymbolicState) -> String {
    if (state1).is_reachable == false {
        return (state2).path_condition;
    }
    if (state2).is_reachable == false {
        return (state1).path_condition;
    }
    return "((" + (state1).path_condition + ") \\/ (" + (state2).path_condition + "))";
}
