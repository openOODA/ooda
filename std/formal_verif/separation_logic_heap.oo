// # Separation Logic Heap Assertion Verifier
//
// Logline: Implements spatial separation logic formulas (emp, x |-> y, P * Q) and local frame reasoning.
//
// Setup: Modular heap reasoning engine verifying disjoint memory partitions and pointer aliasing safety.
//
// Beats:
//   1. Define HeapCell, SpatialAssertion, and SymbolicHeap structures.
//   2. Implement separating conjunction (*) disjoint union heap evaluation.
//   3. Implement Frame Rule verification: {P} C {Q} => {P * R} C {Q * R}.

pub type HeapCell = struct {
    location: Int,
    value: Int
};

pub type SymbolicHeap = struct {
    cells: List[HeapCell],
    cell_count: Int,
    is_valid_disjoint: Bool
};

pub fn symbolic_heap_empty() -> SymbolicHeap {
    let empty_cells: List[HeapCell] = list_new();
    return SymbolicHeap {
        cells: empty_cells,
        cell_count: 0,
        is_valid_disjoint: true
    };
}

pub fn symbolic_heap_points_to(loc: Int, val: Int) -> SymbolicHeap {
    let cell = HeapCell {
        location: loc,
        value: val
    };
    let mut cells: List[HeapCell] = list_new();
    cells = list_push(cells, cell);
    return SymbolicHeap {
        cells: cells,
        cell_count: 1,
        is_valid_disjoint: true
    };
}

pub fn heap_has_location(h: &SymbolicHeap, loc: Int) -> Bool {
    let n: Int = (h).cell_count;
    let mut i: Int = 0;
    while i < n {
        let c: HeapCell = list_get((h).cells, i);
        if (c).location == loc {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn separation_star_join(h1: &SymbolicHeap, h2: &SymbolicHeap) -> SymbolicHeap {
    if (h1).is_valid_disjoint == false || (h2).is_valid_disjoint == false {
        let empty_cells: List[HeapCell] = list_new();
        return SymbolicHeap { cells: empty_cells, cell_count: 0, is_valid_disjoint: false };
    }

    let n2: Int = (h2).cell_count;
    let mut j: Int = 0;
    while j < n2 {
        let cell2: HeapCell = list_get((h2).cells, j);
        if heap_has_location(h1, (cell2).location) {
            // Disjointness violation: overlapping heap locations!
            let empty_cells: List[HeapCell] = list_new();
            return SymbolicHeap { cells: empty_cells, cell_count: 0, is_valid_disjoint: false };
        }
        j = j + 1;
    }

    let mut merged: List[HeapCell] = list_new();
    let n1: Int = (h1).cell_count;
    let mut i: Int = 0;
    while i < n1 {
        merged = list_push(merged, list_get((h1).cells, i));
        i = i + 1;
    }
    j = 0;
    while j < n2 {
        merged = list_push(merged, list_get((h2).cells, j));
        j = j + 1;
    }
    return SymbolicHeap {
        cells: merged,
        cell_count: n1 + n2,
        is_valid_disjoint: true
    };
}

pub fn frame_rule_check(p_disjoint: Bool, r_disjoint: Bool) -> Bool {
    return p_disjoint && r_disjoint;
}
