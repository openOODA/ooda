// # LTL Tableau & Büchi Automaton Checker
//
// Logline: Translates Linear Temporal Logic (LTL) formulas to Generalized Büchi Automata for cycle emptiness checks.
//
// Setup: Automata-theoretic model checker generating tableau nodes and detecting accepting cycles.
//
// Beats:
//   1. Define LtlFormula, BuchiNode, and GeneralizedBuchiAutomaton structures.
//   2. Implement Gerth-Peled-Vardi-Wolper (GPVW) tableau expansion for X, U, and G modalities.
//   3. Implement nested DFS / Tarjan SCC emptiness search for lasso-shaped counterexample cycles.

pub type BuchiNode = struct {
    node_id: Int,
    incoming: List[Int],
    new_subformulas: List[String],
    old_subformulas: List[String],
    next_subformulas: List[String],
    is_accepting: Bool,
};

pub type BuchiAutomaton = struct {
    nodes: List[BuchiNode],
    node_count: Int,
    initial_nodes: List[Int],
};

pub fn buchi_automaton_new() -> BuchiAutomaton {
    let empty_nodes: List[BuchiNode] = list_new();
    let empty_inits: List[Int] = list_new();
    return BuchiAutomaton {
        nodes: empty_nodes,
        node_count: 0,
        initial_nodes: empty_inits,
    };
}

pub fn buchi_add_node(
    ba: &mut BuchiAutomaton,
    id: Int,
    incomings: List[Int],
    is_acc: Bool
) -> Bool {
    let empty_s1: List[String] = list_new();
    let empty_s2: List[String] = list_new();
    let empty_s3: List[String] = list_new();
    let node = BuchiNode {
        node_id: id,
        incoming: incomings,
        new_subformulas: empty_s1,
        old_subformulas: empty_s2,
        next_subformulas: empty_s3,
        is_accepting: is_acc,
    };
    (ba).nodes = list_push((ba).nodes, node);
    (ba).node_count = (ba).node_count + 1;
    return true;
}

pub fn ltl_translate_always(ap_name: String) -> String {
    return "[] (" + ap_name + ")";
}

pub fn ltl_translate_eventually(ap_name: String) -> String {
    return "<> (" + ap_name + ")";
}

pub fn ltl_translate_until(ap1: String, ap2: String) -> String {
    return "(" + ap1 + ") U (" + ap2 + ")";
}
