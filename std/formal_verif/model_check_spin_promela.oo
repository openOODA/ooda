// # Spin/Promela Interleaving State Explorer
//
// Logline: Explores non-deterministic interleavings and message-passing channels in concurrent process protocols.
//
// Setup: Protocol verification engine executing asynchronous communicating state machines.
//
// Beats:
//   1. Define PromelaProcess, ChannelBuffer, and GlobalSystemState structures.
//   2. Implement non-deterministic interleaved step scheduler.
//   3. Check FIFO channel overflow, deadlock conditions, and assertion violations.

pub type ChannelBuffer = struct {
    channel_id: Int,
    capacity: Int,
    messages: List[Int],
    message_count: Int,
};

pub type PromelaProcess = struct {
    process_id: Int,
    program_counter: Int,
    is_blocked: Bool,
};

pub type GlobalSystemState = struct {
    processes: List[PromelaProcess],
    channels: List[ChannelBuffer],
    is_deadlocked: Bool,
};

pub fn channel_buffer_new(id: Int, cap: Int) -> ChannelBuffer {
    let empty_msgs: List[Int] = list_new();
    return ChannelBuffer {
        channel_id: id,
        capacity: cap,
        messages: empty_msgs,
        message_count: 0,
    };
}

pub fn channel_send(chan: &mut ChannelBuffer, msg: Int) -> Bool {
    if (chan).message_count >= (chan).capacity {
        return false; // Channel buffer full
    }
    (chan).messages = list_push((chan).messages, msg);
    (chan).message_count = (chan).message_count + 1;
    return true;
}

pub fn system_check_deadlock(state: &GlobalSystemState) -> Bool {
    let n: Int = list_len((state).processes);
    if n == 0 {
        return false;
    }
    let mut i: Int = 0;
    while i < n {
        let p: PromelaProcess = list_get((state).processes, i);
        if (p).is_blocked == false {
            return false; // At least one process can make progress
        }
        i = i + 1;
    }
    return true; // All processes are blocked: Deadlock!
}
