// # Timed Automata Zone Valuation Graph
//
// Logline: Implements Alur-Dill Timed Automata zone graph abstractions with Difference Bound Matrices.
//
// Setup: Real-time system model checker tracking continuous clock valuations via convex zone polyhedra.
//
// Beats:
//   1. Define ClockConstraint, TimedLocation, and TimedZone structures.
//   2. Implement continuous time elapse zone operation (zone.up / delay).
//   3. Implement discrete clock reset and guard intersection operations.

pub type ClockConstraint = struct {
    clock_i: Int,
    clock_j: Int,
    bound: Int,
};

pub type TimedZone = struct {
    num_clocks: Int,
    constraints: List[ClockConstraint],
    is_empty: Bool,
};

pub fn timed_zone_init(clocks: Int) -> TimedZone {
    let empty_cs: List[ClockConstraint] = list_new();
    return TimedZone {
        num_clocks: clocks,
        constraints: empty_cs,
        is_empty: false,
    };
}

pub fn timed_zone_add_guard(
    zone: &mut TimedZone,
    c_i: Int,
    c_j: Int,
    max_bound: Int
) -> Bool {
    let c = ClockConstraint {
        clock_i: c_i,
        clock_j: c_j,
        bound: max_bound,
    };
    (zone).constraints = list_push((zone).constraints, c);
    return true;
}

pub fn timed_zone_reset_clock(zone: &mut TimedZone, clock_id: Int) -> Bool {
    // Resets clock_id to 0 in the zone valuation
    let c = ClockConstraint {
        clock_i: clock_id,
        clock_j: 0,
        bound: 0,
    };
    (zone).constraints = list_push((zone).constraints, c);
    return true;
}
