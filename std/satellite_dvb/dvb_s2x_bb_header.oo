// # DVB-S2 / DVB-S2X Baseband Header Framing
//
// Logline: Implements ETSI EN 302 307 Baseband (BB) Header structure, MATYPE, UPL, DFL, and CRC-8 integrity.
//
// Setup: Pure satellite communication baseband framing module for DVB-S2 and DVB-S2X transmissions.
//
// Beats:
//   1. Define 80-bit (10-byte) Baseband Header structure and transmission mode flags.
//   2. Pack and unpack MATYPE-1, MATYPE-2, User Packet Length (UPL), and Data Field Length (DFL).
//   3. Compute CRC-8 checksum with generator polynomial x^8 + x^7 + x^6 + x^4 + x^2 + 1 (0xD5).

pub type DvbS2xBbHeader = struct {
    ts_gs_mode: Int,         // 0: Generic Packetized, 1: Generic Continuous, 2: Reserved, 3: Transport Stream
    sis_mis_mode: Int,       // 0: Multiple Input Stream (MIS), 1: Single Input Stream (SIS)
    ccm_acm_mode: Int,       // 0: ACM / VCM, 1: CCM
    issyi: Int,              // 0: Not active, 1: Active (Input Stream Synchronization)
    npd: Int,                // 0: Null packet deletion not active, 1: Active
    ro_rolloff: Int,         // 0: 0.35, 1: 0.25, 2: 0.20, 3: Reserved (DVB-S2) or smaller rolloff (DVB-S2X)
    stream_id_isi: Int,      // 8-bit Input Stream Identifier (ISI)
    upl_bits: Int,           // User Packet Length in bits (0..65535)
    dfl_bits: Int,           // Data Field Length in bits (0..58112)
    sync_byte: Int,          // User packet sync byte (e.g. 0x47 for MPEG-TS)
    syncd_bits: Int,         // Distance in bits to first user packet
    crc8: Int               // 8-bit Baseband Header error detection checksum
};

pub fn dvb_s2x_bb_header_default() -> DvbS2xBbHeader {
    return DvbS2xBbHeader {
        ts_gs_mode: 3,        // Transport Stream
        sis_mis_mode: 1,      // SIS
        ccm_acm_mode: 1,      // CCM
        issyi: 0,
        npd: 0,
        ro_rolloff: 1,        // 0.25 roll-off
        stream_id_isi: 0,
        upl_bits: 1504,       // 188 bytes * 8
        dfl_bits: 53840,      // Normal FECFRAME DFL
        sync_byte: 71,        // 0x47
        syncd_bits: 0,
        crc8: 0
    };
}

pub fn dvb_s2x_crc8_step(current_crc: Int, data_byte: Int) -> Int {
    let mut crc: Int = current_crc ^ data_byte;
    let mut i: Int = 0;
    while i < 8 {
        if (crc & 128) != 0 {
            crc = ((crc << 1) ^ 213) & 255; // Poly 0xD5
        } else {
            crc = (crc << 1) & 255;
        }
        i = i + 1;
    }
    return crc;
}

pub fn dvb_s2x_bb_header_compute_crc8(header: &DvbS2xBbHeader) -> Int {
    let mut crc: Int = 0;
    let matype1: Int = (((header).ts_gs_mode & 3) << 6) |
                       (((header).sis_mis_mode & 1) << 5) |
                       (((header).ccm_acm_mode & 1) << 4) |
                       (((header).issyi & 1) << 3) |
                       (((header).npd & 1) << 2) |
                       ((header).ro_rolloff & 3);
    crc = dvb_s2x_crc8_step(crc, matype1);
    crc = dvb_s2x_crc8_step(crc, (header).stream_id_isi & 255);
    crc = dvb_s2x_crc8_step(crc, ((header).upl_bits >> 8) & 255);
    crc = dvb_s2x_crc8_step(crc, (header).upl_bits & 255);
    crc = dvb_s2x_crc8_step(crc, ((header).dfl_bits >> 8) & 255);
    crc = dvb_s2x_crc8_step(crc, (header).dfl_bits & 255);
    crc = dvb_s2x_crc8_step(crc, (header).sync_byte & 255);
    crc = dvb_s2x_crc8_step(crc, ((header).syncd_bits >> 8) & 255);
    crc = dvb_s2x_crc8_step(crc, (header).syncd_bits & 255);
    return crc;
}

pub fn dvb_s2x_bb_header_validate(header: &DvbS2xBbHeader) -> Bool {
    let expected_crc: Int = dvb_s2x_bb_header_compute_crc8(header);
    return expected_crc == (header).crc8;
}
