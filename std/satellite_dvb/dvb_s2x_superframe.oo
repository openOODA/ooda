// # DVB-S2X Annex E Super-framing Structure
//
// Logline: Implements DVB-S2X Annex E superframe structures, SOSF, SFFI, pilots, and beam-hopping alignment.
//
// Setup: Pure satellite communication superframe structure for multi-beam precoding and beam-hopping.
//
// Beats:
//   1. Model 612,000-symbol Superframe structure across Format 2, Format 3, and Format 4.
//   2. Define Start of Superframe (SOSF: 720 symbols) and Superframe Format Indicator (SFFI).
//   3. Compute beam-hopping illumination epochs and precoding pilot synchronization grids.

pub type SuperframeConfig = struct {
    format_id: Int,          // 2: Format 2, 3: Format 3 (bundled), 4: Format 4 (flexible)
    total_symbols: Int,      // Fixed 612000 symbols
    sosf_symbols: Int,       // Fixed 720 symbols
    sffi_symbols: Int,       // Superframe Format Indicator symbols (0 or 270)
    num_subframes: Int,      // Number of bundled PL frames per superframe
    beam_hopping_active: Int,
    precoding_pilots_active: Int,
};

pub fn superframe_config_new(format: Int, beam_hopping: Int, precoding: Int) -> SuperframeConfig {
    let mut sffi_len: Int = 0;
    let mut subframes: Int = 0;
    if format == 2 {
        sffi_len = 0;
        subframes = 180;
    } else if format == 3 {
        sffi_len = 270;
        subframes = 175;
    } else {
        sffi_len = 270;
        subframes = 160;
    }

    return SuperframeConfig {
        format_id: format,
        total_symbols: 612000,
        sosf_symbols: 720,
        sffi_symbols: sffi_len,
        num_subframes: subframes,
        beam_hopping_active: beam_hopping,
        precoding_pilots_active: precoding,
    };
}

pub fn superframe_payload_capacity_symbols(cfg: &SuperframeConfig) -> Int {
    let overhead: Int = (cfg).sosf_symbols + (cfg).sffi_symbols;
    let mut precoding_overhead: Int = 0;
    if (cfg).precoding_pilots_active == 1 {
        precoding_overhead = (cfg).num_subframes * 36;
    }
    return (cfg).total_symbols - overhead - precoding_overhead;
}

pub fn superframe_symbol_to_subframe_idx(cfg: &SuperframeConfig, symbol_offset: Int) -> Int {
    let payload_offset: Int = symbol_offset - (cfg).sosf_symbols - (cfg).sffi_symbols;
    if payload_offset < 0 {
        return -1; // Header symbol
    }
    let subframe_len: Int = superframe_payload_capacity_symbols(cfg) / (cfg).num_subframes;
    if subframe_len <= 0 { return 0; }
    let idx: Int = payload_offset / subframe_len;
    if idx >= (cfg).num_subframes {
        return (cfg).num_subframes - 1;
    }
    return idx;
}
