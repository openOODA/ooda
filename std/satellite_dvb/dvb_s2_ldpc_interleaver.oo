// # DVB-S2 / DVB-S2X Bit and Parity Interleaver
//
// Logline: Implements block bit-interleaving and parity interleaving for DVB-S2/S2X APSK modulations.
//
// Setup: Pure standard library bit permutation module for satellite constellation demapping alignment.
//
// Beats:
//   1. Configure row-column bit interleaver matrices for 8PSK, 16APSK, 32APSK, and 64APSK.
//   2. Apply DVB-S2 parity bit interleaving across quasi-cyclic LDPC check nodes.
//   3. Compute write-column / read-row address mappings for hardware interleaver pipelines.

pub type DvbInterleaverConfig = struct {
    mod_order_m: Int,        // 3: 8PSK, 4: 16APSK, 5: 32APSK, 6: 64APSK, 8: 256APSK
    num_rows: Int,           // N_ldpc / m (e.g. 64800 / 4 = 16200 for normal 16APSK)
    num_cols: Int,           // m
    is_short_frame: Int
};

pub fn dvb_interleaver_config_new(mod_m: Int, short_frame: Int) -> DvbInterleaverConfig {
    let mut n_ldpc: Int = 64800;
    if short_frame == 1 {
        n_ldpc = 16200;
    }
    let r: Int = n_ldpc / mod_m;
    return DvbInterleaverConfig {
        mod_order_m: mod_m,
        num_rows: r,
        num_cols: mod_m,
        is_short_frame: short_frame
    };
}

pub fn dvb_interleaver_map_address(cfg: &DvbInterleaverConfig, linear_bit_idx: Int) -> Int {
    // Write in column-wise, read out row-wise
    let col: Int = linear_bit_idx / (cfg).num_rows;
    let row: Int = linear_bit_idx % (cfg).num_rows;
    return (row * (cfg).num_cols) + col;
}

pub fn dvb_deinterleaver_map_address(cfg: &DvbInterleaverConfig, interleaved_bit_idx: Int) -> Int {
    let row: Int = interleaved_bit_idx / (cfg).num_cols;
    let col: Int = interleaved_bit_idx % (cfg).num_cols;
    return (col * (cfg).num_rows) + row;
}
