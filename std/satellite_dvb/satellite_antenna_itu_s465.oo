// # ITU-R S.465 Earth Station Reference Radiation Pattern
//
// Logline: Calculates ITU-R S.465 off-axis radiation pattern gain, sidelobe envelope, and boresight gain.
//
// Setup: Pure antenna radiation pattern module for satellite interference and coordination studies.
//
// Beats:
//   1. Compute antenna on-axis peak gain G_max = 20*log10(D/lambda) + 10*log10(eta) + 20.4.
//   2. Evaluate off-axis envelope G(phi) = 32 - 25*log10(phi) for 1 deg <= phi <= 48 deg.
//   3. Apply ITU-R S.465 -10 dBi backlobe limit for angles phi > 48 deg.

pub type EarthStationAntenna = struct {
    diameter_m: Float,
    efficiency_eta: Float, // Typically 0.60 .. 0.70
    carrier_freq_ghz: Float,
};

pub fn earth_station_antenna_default(diameter: Float, freq_ghz: Float) -> EarthStationAntenna {
    return EarthStationAntenna {
        diameter_m: diameter,
        efficiency_eta: 0.65,
        carrier_freq_ghz: freq_ghz,
    };
}

pub fn antenna_calc_peak_gain_dbi(ant: &EarthStationAntenna) -> Float {
    let wavelength_m: Float = 0.299792458 / (ant).carrier_freq_ghz;
    let d_over_lambda: Float = (ant).diameter_m / wavelength_m;

    let ln10: Float = 2.302585092994046;
    let log_d_lambda: Float = ln(d_over_lambda) / ln10;
    let log_eta: Float = ln((ant).efficiency_eta) / ln10;

    return 20.4 + (20.0 * log_d_lambda) + (10.0 * log_eta);
}

pub fn antenna_calc_off_axis_gain_dbi(ant: &EarthStationAntenna, off_axis_angle_deg: Float) -> Float {
    let mut phi: Float = off_axis_angle_deg;
    if phi < 0.0 { phi = 0.0 - phi; }

    let g_max: Float = antenna_calc_peak_gain_dbi(ant);

    // 1 degree minimum off-axis transition
    if phi < 1.0 {
        return g_max - (12.0 * phi * phi);
    }
    if phi <= 48.0 {
        let ln10: Float = 2.302585092994046;
        let log_phi: Float = ln(phi) / ln10;
        return 32.0 - (25.0 * log_phi);
    }
    return -10.0; // Far sidelobe and backlobe envelope
}
