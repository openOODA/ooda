// # GNSS Real-Time Kinematic (RTK) Carrier Phase Differential
//
// Logline: Implements single and double difference carrier phase equations and integer ambiguity resolution.
//
// Setup: Pure carrier-phase differential positioning module achieving centimeter-level baseline accuracy.
//
// Beats:
//   1. Form single differences between Rover and Base receivers canceling satellite clock errors.
//   2. Form double differences between satellite pairs canceling receiver clock errors.
//   3. Compute double-difference residual equations and integer cycle ambiguity N_ij^kl.

pub type RtkBaselineConfig = struct {
    base_ecef_x: Float,
    base_ecef_y: Float,
    base_ecef_z: Float,
    carrier_wavelength_l1_m: Float, // E.g. 0.19029367 m for GPS L1
    ratio_test_threshold: Float   // Validation threshold (typically 2.0 to 3.0)
};

pub fn rtk_baseline_config_default(base_x: Float, base_y: Float, base_z: Float) -> RtkBaselineConfig {
    return RtkBaselineConfig {
        base_ecef_x: base_x,
        base_ecef_y: base_y,
        base_ecef_z: base_z,
        carrier_wavelength_l1_m: 0.190293672798365,
        ratio_test_threshold: 3.0
    };
}

pub fn rtk_single_difference_phase(rover_phase_cycles: Float, base_phase_cycles: Float) -> Float {
    // Delta_Phi = Phi_rover - Phi_base
    return rover_phase_cycles - base_phase_cycles;
}

pub fn rtk_double_difference_phase(sd_sat_p: Float, sd_sat_q: Float) -> Float {
    // Nabla_Delta_Phi = Delta_Phi^p - Delta_Phi^q
    return sd_sat_p - sd_sat_q;
}

pub fn rtk_double_difference_range_m(dd_geom_range_m: Float, dd_ambiguity_cycles: Int, wavelength_m: Float) -> Float {
    let amb_f: Float = rtk_int_to_float(dd_ambiguity_cycles);
    return dd_geom_range_m + (amb_f * wavelength_m);
}

pub fn rtk_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
