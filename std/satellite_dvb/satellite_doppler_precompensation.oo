// # Satellite Uplink Doppler Precompensation Filter
//
// Logline: Implements ground gateway Doppler pre-rotation e^(-j*2*pi*f_d*t) and symbol rate timing correction.
//
// Setup: Pure DSP precompensation module ensuring zero frequency offset at satellite transponder input.
//
// Beats:
//   1. Compute carrier frequency counter-rotation angle theta(t) = - 2*pi * f_doppler * t.
//   2. Apply complex I/Q baseband frequency shifter to transmit waveform.
//   3. Scale DAC interpolation resampling rate to compensate for orbital relativistic time dilation.

pub type DopplerPrecompensator = struct {
    carrier_freq_hz: Float,
    target_doppler_hz: Float,
    current_phase_rad: Float,
    symbol_rate_rescale: Float, // 1.0 + (v_r / c)
};

pub fn doppler_precompensator_new(carrier_hz: Float) -> DopplerPrecompensator {
    return DopplerPrecompensator {
        carrier_freq_hz: carrier_hz,
        target_doppler_hz: 0.0,
        current_phase_rad: 0.0,
        symbol_rate_rescale: 1.0,
    };
}

pub fn doppler_precomp_set_offset(comp: &mut DopplerPrecompensator, doppler_hz: Float, radial_vel_mps: Float) {
    let c: Float = 299792458.0;
    (*comp).target_doppler_hz = doppler_hz;
    (*comp).symbol_rate_rescale = 1.0 - (radial_vel_mps / c);
}

pub fn doppler_precomp_step_i(comp: &mut DopplerPrecompensator, in_i: Float, in_q: Float, dt_s: Float) -> Float {
    let pi_val: Float = 3.141592653589793;
    // Counter-shift: - 2*pi * f_d * dt
    let delta_phase: Float = (0.0 - (2.0 * pi_val * (*comp).target_doppler_hz)) * dt_s;
    (*comp).current_phase_rad = (*comp).current_phase_rad + delta_phase;

    let cos_p: Float = cos((*comp).current_phase_rad);
    let sin_p: Float = sin((*comp).current_phase_rad);

    return (in_i * cos_p) - (in_q * sin_p);
}

pub fn doppler_precomp_step_q(comp: &mut DopplerPrecompensator, in_i: Float, in_q: Float, dt_s: Float) -> Float {
    let cos_p: Float = cos((*comp).current_phase_rad);
    let sin_p: Float = sin((*comp).current_phase_rad);

    return (in_i * sin_p) + (in_q * cos_p);
}
