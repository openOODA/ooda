// # Optical ISL Erbium-Doped Fiber Amplifier (EDFA)
//
// Logline: Models EDFA optical amplification, gain saturation, Amplified Spontaneous Emission (ASE) noise, and OSNR.
//
// Setup: Pure photonic amplifier simulation module for spaceborne optical transceivers.
//
// Beats:
//   1. Compute saturated optical gain G = G_0 / (1 + P_in / P_sat).
//   2. Calculate ASE noise power P_ase = 2 * n_sp * (G - 1) * h * nu * B_opt.
//   3. Evaluate Optical Signal-to-Noise Ratio (OSNR) and cascaded noise figure.

pub type EdfaConfig = struct {
    small_signal_gain_db: Float,  // E.g. 30.0 dB (G0 = 1000)
    saturation_power_dbm: Float,  // E.g. +17.0 dBm (50 mW)
    noise_figure_db: Float,       // E.g. 4.5 dB
    optical_bandwidth_ghz: Float // Optical filter bandwidth (e.g. 50 GHz)
};

pub fn edfa_config_default() -> EdfaConfig {
    return EdfaConfig {
        small_signal_gain_db: 28.0,
        saturation_power_dbm: 18.0,
        noise_figure_db: 4.8,
        optical_bandwidth_ghz: 50.0
    };
}

pub fn edfa_calc_saturated_gain_db(cfg: &EdfaConfig, pin_dbm: Float) -> Float {
    let ln10: Float = 2.302585092994046;
    let g0_linear: Float = exp((cfg).small_signal_gain_db * (ln10 * 0.1));
    let pin_mw: Float = exp(pin_dbm * (ln10 * 0.1));
    let psat_mw: Float = exp((cfg).saturation_power_dbm * (ln10 * 0.1));

    let g_linear: Float = g0_linear / (1.0 + (pin_mw / psat_mw));
    return 10.0 * (ln(g_linear) / ln10);
}

pub fn edfa_calc_output_power_dbm(cfg: &EdfaConfig, pin_dbm: Float) -> Float {
    let g_sat_db: Float = edfa_calc_saturated_gain_db(cfg, pin_dbm);
    return pin_dbm + g_sat_db;
}

pub fn edfa_calc_osnr_db(cfg: &EdfaConfig, pin_dbm: Float) -> Float {
    // OSNR = P_in - NF - 10*log10(h*nu*B)
    // At 1550nm (h*nu ~ 1.28e-19 J), 10*log10(h*nu*50GHz in mW) ~ -52.0 dBm
    let h_nu_b_dbm: Float = -51.9;
    return (pin_dbm - (cfg).noise_figure_db) - h_nu_b_dbm;
}
