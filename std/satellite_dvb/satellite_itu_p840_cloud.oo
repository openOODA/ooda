// # ITU-R P.840 Cloud and Fog Attenuation Model
//
// Logline: Calculates liquid water cloud and fog absorption from dielectric permittivity and column density.
//
// Setup: Pure propagation model evaluating Rayleigh cloud scattering losses on satellite slant paths.
//
// Beats:
//   1. Compute specific cloud attenuation coefficient K_l (dB/km per g/m^3) using Debye water model.
//   2. Integrate total columnar liquid water content L (kg/m^2) along satellite elevation angle.
//   3. Evaluate total cloud attenuation A_c = K_l * L / sin(theta) for earth station design.

pub type CloudAttenuationConfig = struct {
    carrier_freq_ghz: Float,
    elevation_angle_deg: Float,
    cloud_water_content_kg_m2: Float, // Total column liquid water L (typically 0.2 .. 1.5 kg/m^2)
    cloud_temperature_c: Float       // Cloud layer temperature (typically 0.0 C)
};

pub fn cloud_attenuation_config_default(freq_ghz: Float, elev_deg: Float) -> CloudAttenuationConfig {
    return CloudAttenuationConfig {
        carrier_freq_ghz: freq_ghz,
        elevation_angle_deg: elev_deg,
        cloud_water_content_kg_m2: 0.5,
        cloud_temperature_c: 0.0
    };
}

pub fn cloud_calc_kl_coefficient(freq_ghz: Float, temp_c: Float) -> Float {
    // ITU-R P.840: K_l = 0.819 * f / (epsilon'' * (1 + eta^2))
    // Approximate polynomial for 10-50 GHz at 0 deg C:
    let f: Float = freq_ghz;
    let f2: Float = f * f;
    let kl: Float = (0.00075 * f2) / (1.0 + (0.0012 * f2));
    return kl;
}

pub fn cloud_total_attenuation_db(cfg: &CloudAttenuationConfig) -> Float {
    let kl: Float = cloud_calc_kl_coefficient((cfg).carrier_freq_ghz, (cfg).cloud_temperature_c);
    let l_water: Float = (cfg).cloud_water_content_kg_m2;

    let pi_val: Float = 3.141592653589793;
    let theta_rad: Float = ((cfg).elevation_angle_deg * pi_val) / 180.0;
    let sin_theta: Float = sin(theta_rad);
    let mut sin_val: Float = sin_theta;
    if sin_val < 0.087 { sin_val = 0.087; }

    return (kl * l_water) / sin_val;
}
