// # ITU-R P.676 Atmospheric Gaseous Attenuation
//
// Logline: Calculates zenith and slant path atmospheric attenuation from oxygen (60 GHz) and water vapor (22.2 GHz).
//
// Setup: Pure standard library propagation model for satellite links across 1 GHz to 100 GHz.
//
// Beats:
//   1. Model dry air oxygen specific attenuation gamma_o (dB/km) and pressure broadening.
//   2. Model water vapor resonance specific attenuation gamma_w (dB/km) near 22.235 GHz.
//   3. Integrate equivalent atmospheric scale heights and slant path cosecant mapping.

pub type GaseousAttenuationConfig = struct {
    carrier_freq_ghz: Float,
    elevation_angle_deg: Float,
    surface_pressure_hpa: Float,  // Typically 1013.25 hPa
    surface_temp_c: Float,        // Typically 15.0 C
    water_vapor_density_g_m3: Float // Typically 7.5 g/m^3
};

pub fn gaseous_config_default(freq_ghz: Float, elev_deg: Float) -> GaseousAttenuationConfig {
    return GaseousAttenuationConfig {
        carrier_freq_ghz: freq_ghz,
        elevation_angle_deg: elev_deg,
        surface_pressure_hpa: 1013.25,
        surface_temp_c: 15.0,
        water_vapor_density_g_m3: 7.5
    };
}

pub fn gaseous_oxygen_specific_atten_db_km(freq_ghz: Float) -> Float {
    // Simplified ITU-R P.676 oxygen approximation
    let f: Float = freq_ghz;
    if f < 1.0 { return 0.001; }
    if f > 50.0 && f < 70.0 {
        // High absorption around 60 GHz O2 band
        let diff: Float = f - 60.0;
        let diff_sq: Float = diff * diff;
        return 15.0 / (1.0 + (0.2 * diff_sq));
    }
    // Baseline non-resonant absorption
    let f_term: Float = (f * f) * 0.00001;
    return 0.005 + f_term;
}

pub fn gaseous_water_vapor_specific_atten_db_km(freq_ghz: Float, rho_w: Float) -> Float {
    // Water vapor resonance at 22.235 GHz
    let f: Float = freq_ghz;
    let diff: Float = f - 22.235;
    let diff_sq: Float = diff * diff;
    let peak_factor: Float = (rho_w / 7.5) * (0.18 / (1.0 + (0.3 * diff_sq)));
    let continuum: Float = 0.00002 * (f * f) * (rho_w / 7.5);
    return peak_factor + continuum;
}

pub fn gaseous_total_slant_attenuation_db(cfg: &GaseousAttenuationConfig) -> Float {
    let gamma_o: Float = gaseous_oxygen_specific_atten_db_km((cfg).carrier_freq_ghz);
    let gamma_w: Float = gaseous_water_vapor_specific_atten_db_km((cfg).carrier_freq_ghz, (cfg).water_vapor_density_g_m3);

    // Equivalent scale heights: h_o ~ 6 km, h_w ~ 2 km
    let zenith_att_db: Float = (gamma_o * 6.0) + (gamma_w * 2.2);

    let pi_val: Float = 3.141592653589793;
    let theta_rad: Float = ((cfg).elevation_angle_deg * pi_val) / 180.0;
    let sin_theta: Float = sin(theta_rad);
    let mut sin_val: Float = sin_theta;
    if sin_val < 0.087 { sin_val = 0.087; }

    return zenith_att_db / sin_val;
}
