// # 3GPP 5G Non-Terrestrial Network (NTN) Timing Advance
//
// Logline: Implements 3GPP Rel-17/18 NTN Common TA, UE-specific TA, RTT delay, and K_offset scheduling.
//
// Setup: Pure 5G NTN MAC and physical layer timing management module for LEO and GEO satellite links.
//
// Beats:
//   1. Calculate Common Timing Advance T_c_ta for gateway-to-satellite feeder links.
//   2. Calculate UE-specific Timing Advance T_ue_ta for satellite-to-UE service links.
//   3. Compute HARQ K_offset parameter accounting for long round-trip propagation times.

pub type NtnTimingConfig = struct {
    feeder_link_delay_ms: Float,  // Gateway to Satellite one-way delay
    service_link_delay_ms: Float, // Satellite to UE one-way delay
    subcarrier_spacing_khz: Int,  // 15, 30, 60, or 120 kHz
    k_offset_slots: Int          // Additional HARQ scheduling delay slots
};

pub fn ntn_timing_config_new(feeder_ms: Float, service_ms: Float, scs_khz: Int) -> NtnTimingConfig {
    let rtt_ms: Float = 2.0 * (feeder_ms + service_ms);
    let slot_duration_ms: Float = 1.0 / (ntn_int_to_float(scs_khz) / 15.0);
    let k_slots: Int = ntn_float_to_int_ceil(rtt_ms / slot_duration_ms);

    return NtnTimingConfig {
        feeder_link_delay_ms: feeder_ms,
        service_link_delay_ms: service_ms,
        subcarrier_spacing_khz: scs_khz,
        k_offset_slots: k_slots
    };
}

pub fn ntn_calc_total_timing_advance_us(cfg: &NtnTimingConfig) -> Float {
    // Total TA = 2 * (T_feeder + T_service) in microseconds
    return 2.0 * ((cfg).feeder_link_delay_ms + (cfg).service_link_delay_ms) * 1000.0;
}

pub fn ntn_float_to_int_ceil(v: Float) -> Int {
    let mut count: Int = 0;
    let mut current: Float = 0.0;
    while current < v {
        current = current + 1.0;
        count = count + 1;
    }
    return count;
}

pub fn ntn_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
