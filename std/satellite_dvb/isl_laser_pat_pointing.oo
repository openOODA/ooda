// # Optical ISL Pointing, Acquisition, and Tracking (PAT)
//
// Logline: Implements Point-Ahead Angle (PAA), Fine Steering Mirror (FSM) PID loop, and spatial acquisition.
//
// Setup: Pure electro-optical control module for sub-microradian laser beam pointing across inter-satellite links.
//
// Beats:
//   1. Calculate relativistic Point-Ahead Angle vector theta_paa = 2 * v_tangential / c.
//   2. Model spiral scan pattern for spatial beacon acquisition.
//   3. Implement closed-loop FSM PID controller to suppress satellite micro-vibration jitter.

pub type LaserPatController = struct {
    point_ahead_angle_urad: Float, // Micro-radians (urad)
    fsm_kp: Float,
    fsm_ki: Float,
    fsm_kd: Float,
    fsm_integral_error: Float,
    fsm_prev_error: Float,
    current_pointing_error_urad: Float,
};

pub fn laser_pat_controller_new(kp: Float, ki: Float, kd: Float) -> LaserPatController {
    return LaserPatController {
        point_ahead_angle_urad: 0.0,
        fsm_kp: kp,
        fsm_ki: ki,
        fsm_kd: kd,
        fsm_integral_error: 0.0,
        fsm_prev_error: 0.0,
        current_pointing_error_urad: 0.0,
    };
}

pub fn laser_calc_point_ahead_angle_urad(tangential_velocity_mps: Float) -> Float {
    let c: Float = 299792458.0;
    // theta_paa = 2 * v_perp / c in radians -> multiply by 1e6 for micro-radians
    let theta_rad: Float = (2.0 * tangential_velocity_mps) / c;
    return theta_rad * 1000000.0;
}

pub fn laser_fsm_pid_step(ctrl: &mut LaserPatController, error_urad: Float, dt_s: Float) -> Float {
    (*ctrl).current_pointing_error_urad = error_urad;
    (*ctrl).fsm_integral_error = (*ctrl).fsm_integral_error + (error_urad * dt_s);
    let derivative: Float = (error_urad - (*ctrl).fsm_prev_error) / dt_s;
    (*ctrl).fsm_prev_error = error_urad;

    let p_term: Float = (*ctrl).fsm_kp * error_urad;
    let i_term: Float = (*ctrl).fsm_ki * (*ctrl).fsm_integral_error;
    let d_term: Float = (*ctrl).fsm_kd * derivative;

    return (p_term + i_term) + d_term;
}

pub fn laser_is_tracking_locked(ctrl: &LaserPatController, threshold_urad: Float) -> Bool {
    let mut err: Float = (ctrl).current_pointing_error_urad;
    if err < 0.0 { err = 0.0 - err; }
    return err <= threshold_urad;
}
