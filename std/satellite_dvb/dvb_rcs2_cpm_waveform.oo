// # DVB-RCS2 Continuous Phase Modulation (CPM) Waveform
//
// Logline: Implements power-efficient constant-envelope CPM waveforms for nonlinear satellite transmitters.
//
// Setup: Pure CPM modulator parameterization and instantaneous phase trajectory calculator.
//
// Beats:
//   1. Configure modulation index h = p/q, pulse length L, and frequency pulse shape (2RC / GMSK).
//   2. Compute instantaneous phase state trajectory theta(t) across symbol transitions.
//   3. Generate constant-envelope complex I/Q baseband samples.

pub type DvbCpmConfig = struct {
    mod_index_h_num: Int,    // E.g. 1
    mod_index_h_den: Int,    // E.g. 2 (h = 1/2 for MSK-type)
    pulse_length_l: Int,     // L = 2 (2RC) or L = 3 (3RC)
    samples_per_symbol: Int,
    phase_states: Int       // 2 * q phase states
};

pub fn dvb_cpm_config_new(h_num: Int, h_den: Int, l_val: Int, sps: Int) -> DvbCpmConfig {
    return DvbCpmConfig {
        mod_index_h_num: h_num,
        mod_index_h_den: h_den,
        pulse_length_l: l_val,
        samples_per_symbol: sps,
        phase_states: 2 * h_den
    };
}

pub fn dvb_cpm_raised_cosine_pulse(t_norm: Float, l_val: Int) -> Float {
    // 2RC or 3RC pulse shape: g(t) = 1/(2LT) * (1 - cos(2*pi*t / (L*T)))
    let l_f: Float = dvb_rcs2_cpm_int_to_float(l_val);
    if (t_norm < 0.0) || (t_norm > l_f) {
        return 0.0;
    }
    let pi_val: Float = 3.141592653589793;
    let angle: Float = (2.0 * pi_val * t_norm) / l_f;
    return (1.0 - cos(angle)) / (2.0 * l_f);
}

pub fn dvb_cpm_instantaneous_phase(accumulated_phase: Float, h_num: Int, h_den: Int, pulse_val: Float) -> Float {
    let pi_val: Float = 3.141592653589793;
    let h_val: Float = dvb_rcs2_cpm_int_to_float(h_num) / dvb_rcs2_cpm_int_to_float(h_den);
    return accumulated_phase + (2.0 * pi_val * h_val * pulse_val);
}

pub fn dvb_rcs2_cpm_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
