// # DVB-S2X Modulation and Coding (MODCOD) Parameter Tables
//
// Logline: Defines DVB-S2/S2X MODCOD configurations, spectral efficiencies, and required Es/N0 SNR thresholds.
//
// Setup: Pure spectral efficiency and threshold lookup table module for DVB-S2X physical layer profiles.
//
// Beats:
//   1. Model MODCOD identifiers for QPSK, 8PSK, 16APSK, 32APSK, 64APSK, 128APSK, and 256APSK.
//   2. Provide spectral efficiency (bits/symbol) and code rate fractions.
//   3. Compute nominal AWGN and non-linear satellite channel required Es/N0 (dB) thresholds.

pub type DvbModcodEntry = struct {
    modcod_id: Int,
    constellation_order: Int, // 2: QPSK, 3: 8PSK, 4: 16APSK, 5: 32APSK, 6: 64APSK, 7: 128APSK, 8: 256APSK
    code_rate_num: Int,
    code_rate_den: Int,
    spectral_efficiency: Float,
    min_es_n0_db: Float,
    is_s2x_extension: Int,
};

pub fn dvb_modcod_get(id: Int) -> DvbModcodEntry {
    if id == 1 {
        // QPSK 1/4 (DVB-S2)
        return DvbModcodEntry { modcod_id: 1, constellation_order: 2, code_rate_num: 1, code_rate_den: 4, spectral_efficiency: 0.4902, min_es_n0_db: -2.35, is_s2x_extension: 0 };
    }
    if id == 4 {
        // QPSK 1/2 (DVB-S2)
        return DvbModcodEntry { modcod_id: 4, constellation_order: 2, code_rate_num: 1, code_rate_den: 2, spectral_efficiency: 0.9888, min_es_n0_db: 1.00, is_s2x_extension: 0 };
    }
    if id == 10 {
        // 8PSK 3/4 (DVB-S2)
        return DvbModcodEntry { modcod_id: 10, constellation_order: 3, code_rate_num: 3, code_rate_den: 4, spectral_efficiency: 2.2281, min_es_n0_db: 7.91, is_s2x_extension: 0 };
    }
    if id == 16 {
        // 16APSK 3/4 (DVB-S2)
        return DvbModcodEntry { modcod_id: 16, constellation_order: 4, code_rate_num: 3, code_rate_den: 4, spectral_efficiency: 2.9667, min_es_n0_db: 10.21, is_s2x_extension: 0 };
    }
    if id == 21 {
        // 32APSK 3/4 (DVB-S2)
        return DvbModcodEntry { modcod_id: 21, constellation_order: 5, code_rate_num: 3, code_rate_den: 4, spectral_efficiency: 3.7032, min_es_n0_db: 12.73, is_s2x_extension: 0 };
    }
    if id == 50 {
        // 64APSK 4/5 (DVB-S2X)
        return DvbModcodEntry { modcod_id: 50, constellation_order: 6, code_rate_num: 4, code_rate_den: 5, spectral_efficiency: 4.7523, min_es_n0_db: 16.55, is_s2x_extension: 1 };
    }
    if id == 60 {
        // 128APSK 3/4 (DVB-S2X)
        return DvbModcodEntry { modcod_id: 60, constellation_order: 7, code_rate_num: 3, code_rate_den: 4, spectral_efficiency: 5.2104, min_es_n0_db: 18.40, is_s2x_extension: 1 };
    }
    if id == 70 {
        // 256APSK 29/45 (DVB-S2X)
        return DvbModcodEntry { modcod_id: 70, constellation_order: 8, code_rate_num: 29, code_rate_den: 45, spectral_efficiency: 5.1158, min_es_n0_db: 18.05, is_s2x_extension: 1 };
    }
    // Default fallback: QPSK 3/4
    return DvbModcodEntry { modcod_id: 6, constellation_order: 2, code_rate_num: 3, code_rate_den: 4, spectral_efficiency: 1.4874, min_es_n0_db: 4.03, is_s2x_extension: 0 };
}

pub fn dvb_modcod_select_optimal(snr_es_n0_db: Float, margin_db: Float) -> Int {
    let effective_snr: Float = snr_es_n0_db - margin_db;
    if effective_snr >= 18.5 { return 70; } // 256APSK
    if effective_snr >= 17.0 { return 50; } // 64APSK
    if effective_snr >= 13.0 { return 21; } // 32APSK
    if effective_snr >= 10.5 { return 16; } // 16APSK
    if effective_snr >= 8.2  { return 10; } // 8PSK
    if effective_snr >= 1.5  { return 4;  } // QPSK 1/2
    return 1;                               // QPSK 1/4 robust fallback
}
