// # DVB-S2X Beam Hopping Transmission Scheduler
//
// Logline: Implements DVB-S2X beam hopping illumination timelines, dwell windows, and capacity grid allocation.
//
// Setup: Pure high-throughput satellite (HTS) resource management module for agile spot beam switching.
//
// Beats:
//   1. Configure Beam Hopping Time Plan (BHTP) epochs, slot durations, and guard switching intervals.
//   2. Map traffic demand matrices to active beam dwell allocations.
//   3. Validate adjacent beam co-channel interference constraints during simultaneous hopping slots.

pub type BeamHoppingPlan = struct {
    num_beams: Int,
    cycle_duration_ms: Float,  // Typically 10.0 .. 100.0 ms
    slots_per_cycle: Int,      // E.g. 128 time slots
    guard_symbols: Int,        // RF power amp switching guard time (e.g. 36 symbols)
    active_beam_mask: Int,     // Bitmask of currently illuminated beams
};

pub fn beam_hopping_plan_new(beams: Int, cycle_ms: Float, slots: Int) -> BeamHoppingPlan {
    return BeamHoppingPlan {
        num_beams: beams,
        cycle_duration_ms: cycle_ms,
        slots_per_cycle: slots,
        guard_symbols: 36,
        active_beam_mask: 0,
    };
}

pub fn beam_hopping_slot_duration_ms(plan: &BeamHoppingPlan) -> Float {
    let slots_f: Float = beam_hopping_int_to_float((plan).slots_per_cycle);
    return (plan).cycle_duration_ms / slots_f;
}

pub fn beam_hopping_is_beam_active(plan: &BeamHoppingPlan, beam_idx: Int) -> Bool {
    let mask: Int = 1 << beam_idx;
    return ((plan).active_beam_mask & mask) != 0;
}

pub fn beam_hopping_set_beam_active(plan: &mut BeamHoppingPlan, beam_idx: Int, active: Int) {
    let mask: Int = 1 << beam_idx;
    if active == 1 {
        (*plan).active_beam_mask = (*plan).active_beam_mask | mask;
    } else {
        if ((*plan).active_beam_mask & mask) != 0 {
            (*plan).active_beam_mask = (*plan).active_beam_mask ^ mask;
        }
    }
}

pub fn beam_hopping_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
