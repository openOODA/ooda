// # Galileo E1-B/C PRN Tiered Code Generator
//
// Logline: Generates Galileo E1-B (data) and E1-C (pilot) 4092-chip primary and 25-chip secondary PRN sequences.
//
// Setup: Pure Galileo spreading sequence generator module for Space Vehicles E01 through E36.
//
// Beats:
//   1. Configure 4092-chip primary memory codes at 1.023 Mchip/s (4.0 ms code epoch).
//   2. Configure 25-chip secondary CS25 code for pilot channel symbol synchronization.
//   3. Generate combined tiered composite chips for baseband correlator alignment.

pub type GalileoPrnConfig = struct {
    sv_id: Int,
    primary_code_length: Int,   // 4092 chips
    secondary_code_length: Int, // 25 chips
    primary_chip_idx: Int,
    secondary_chip_idx: Int,
    lfsr_state: Int            // 13-bit Galois register
};

pub fn galileo_prn_config_new(sv: Int) -> GalileoPrnConfig {
    return GalileoPrnConfig {
        sv_id: sv,
        primary_code_length: 4092,
        secondary_code_length: 25,
        primary_chip_idx: 0,
        secondary_chip_idx: 0,
        lfsr_state: 8191 // 0x1FFF
    };
}

pub fn galileo_step_primary_chip(cfg: &mut GalileoPrnConfig) -> Int {
    let reg: Int = (*cfg).lfsr_state;
    let out_chip: Int = reg & 1;
    // Feedback polynomial x^13 + x^4 + x^3 + x + 1
    let fb: Int = (out_chip ^ (reg >> 1) ^ (reg >> 3) ^ (reg >> 4)) & 1;

    (*cfg).lfsr_state = (reg >> 1) | (fb << 12);
    (*cfg).primary_chip_idx = (*cfg).primary_chip_idx + 1;

    if (*cfg).primary_chip_idx >= (*cfg).primary_code_length {
        (*cfg).primary_chip_idx = 0;
        (*cfg).secondary_chip_idx = ((*cfg).secondary_chip_idx + 1) % (*cfg).secondary_code_length;
    }

    return out_chip;
}

pub fn galileo_is_secondary_epoch_boundary(cfg: &GalileoPrnConfig) -> Bool {
    return ((*cfg).primary_chip_idx == 0) && ((*cfg).secondary_chip_idx == 0);
}
