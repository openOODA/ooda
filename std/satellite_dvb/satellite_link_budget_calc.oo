// # Satellite Comprehensive Link Budget Calculator
//
// Logline: Implements uplink, downlink, and composite C/N0, C/N, Eb/N0, EIRP, and G/T figure of merit budgets.
//
// Setup: Pure standard library space-ground and inter-satellite link budget calculation engine.
//
// Beats:
//   1. Compute Effective Isotropically Radiated Power EIRP = P_tx + G_tx - L_feed.
//   2. Compute Free Space Path Loss FSPL = 20*log10(4*pi*d/lambda) and total atmospheric attenuation.
//   3. Compute composite Carrier-to-Noise density (C/N0)_tot and link margin (dB).

pub type SatelliteLinkBudget = struct {
    eirp_tx_dbw: Float,
    carrier_freq_ghz: Float,
    slant_range_km: Float,
    atmospheric_loss_db: Float,
    pointing_loss_db: Float,
    rx_gain_to_noise_temp_dbk: Float, // G/T in dB/K
    data_rate_bps: Float,
    target_eb_n0_db: Float,
};

pub fn satellite_link_budget_default() -> SatelliteLinkBudget {
    return SatelliteLinkBudget {
        eirp_tx_dbw: 55.0,            // 55 dBW satellite spot beam
        carrier_freq_ghz: 19.7,       // Ka-band downlink
        slant_range_km: 37500.0,      // GEO slant range
        atmospheric_loss_db: 1.5,
        pointing_loss_db: 0.5,
        rx_gain_to_noise_temp_dbk: 18.5, // 18.5 dB/K ground terminal
        data_rate_bps: 50000000.0,    // 50 Mbps
        target_eb_n0_db: 8.5,
    };
}

pub fn satellite_calc_fspl_db(freq_ghz: Float, distance_km: Float) -> Float {
    // FSPL (dB) = 92.45 + 20*log10(f_GHz) + 20*log10(d_km)
    let ln10: Float = 2.302585092994046;
    let log_f: Float = ln(freq_ghz) / ln10;
    let log_d: Float = ln(distance_km) / ln10;
    return 92.45 + (20.0 * log_f) + (20.0 * log_d);
}

pub fn satellite_calc_c_n0_dbhz(budget: &SatelliteLinkBudget) -> Float {
    let fspl: Float = satellite_calc_fspl_db((budget).carrier_freq_ghz, (budget).slant_range_km);
    let total_loss: Float = fspl + (budget).atmospheric_loss_db + (budget).pointing_loss_db;
    let k_boltzmann_dbw_k_hz: Float = -228.6; // 10*log10(1.380649e-23)

    // C/N0 = EIRP - Total_Loss + G/T - k
    let c_n0: Float = ((budget).eirp_tx_dbw - total_loss) + (budget).rx_gain_to_noise_temp_dbk - k_boltzmann_dbw_k_hz;
    return c_n0;
}

pub fn satellite_calc_eb_n0_db(budget: &SatelliteLinkBudget) -> Float {
    let c_n0: Float = satellite_calc_c_n0_dbhz(budget);
    let ln10: Float = 2.302585092994046;
    let log_rb: Float = ln((budget).data_rate_bps) / ln10;
    let eb_n0: Float = c_n0 - (10.0 * log_rb);
    return eb_n0;
}

pub fn satellite_calc_link_margin_db(budget: &SatelliteLinkBudget) -> Float {
    let actual_eb_n0: Float = satellite_calc_eb_n0_db(budget);
    return actual_eb_n0 - (budget).target_eb_n0_db;
}
