// # Satellite Ionospheric and Tropospheric Scintillation
//
// Logline: Implements Nakagami-m S4 ionospheric intensity scintillation and tropospheric amplitude variance.
//
// Setup: Pure atmospheric propagation module evaluating rapid signal fluctuations on satellite links.
//
// Beats:
//   1. Model ionospheric scintillation index S4 = sqrt(var(I)) / mean(I) and fading depth.
//   2. Compute tropospheric scintillation variance sigma_chi^2 from ITU-R P.618 wet refractivity N_wet.
//   3. Evaluate deep fade exceedance probabilities for satellite ground terminals.

pub type ScintillationConfig = struct {
    carrier_freq_ghz: Float,
    elevation_angle_deg: Float,
    s4_ionospheric_index: Float, // 0.0 (quiet) .. 1.0 (strong scintillation)
    refractivity_n_wet: Float,   // Typically 20 .. 50 ppm
    antenna_diameter_m: Float,
};

pub fn scintillation_config_default(freq_ghz: Float, elev_deg: Float) -> ScintillationConfig {
    return ScintillationConfig {
        carrier_freq_ghz: freq_ghz,
        elevation_angle_deg: elev_deg,
        s4_ionospheric_index: 0.25,
        refractivity_n_wet: 35.0,
        antenna_diameter_m: 1.2,
    };
}

pub fn scintillation_s4_to_nakagami_m(s4_val: Float) -> Float {
    let s4: Float = s4_val;
    if s4 < 0.05 {
        return 50.0; // Near Gaussian AWGN
    }
    let s4_sq: Float = s4 * s4;
    return 1.0 / s4_sq;
}

pub fn scintillation_tropospheric_variance_db(cfg: &ScintillationConfig) -> Float {
    // ITU-R P.618: sigma_chi = sigma_ref * f^(7/12) * g(x) / (sin(theta))^1.2
    let pi_val: Float = 3.141592653589793;
    let theta_rad: Float = ((cfg).elevation_angle_deg * pi_val) / 180.0;
    let sin_theta: Float = sin(theta_rad);

    let mut sin_factor: Float = sin_theta;
    if sin_factor < 0.087 { // Minimum 5 degrees elevation clamp
        sin_factor = 0.087;
    }

    let f_ghz: Float = (cfg).carrier_freq_ghz;
    let sigma_ref: Float = 0.000036 * (cfg).refractivity_n_wet;
    let f_term: Float = sqrt(f_ghz); // Approximation for f^(7/12)

    return (sigma_ref * f_term) / (sin_factor * sqrt(sin_factor));
}

pub fn scintillation_fade_depth_db(s4: Float, p_exceedance: Float) -> Float {
    // Approximate fade depth in dB for exceedance p (e.g. 0.01 = 99% availability)
    let ln10: Float = 2.302585092994046;
    let log_p: Float = ln(p_exceedance) / ln10;
    return (0.0 - (10.0 * s4)) * (log_p / 2.0);
}
