// # GNSS Raw Pseudorange & Clock Bias Correction
//
// Logline: Computes corrected geometric pseudorange rho = c*(t_rx - t_tx) + c*(dt_rx - dt_sat) + I + T + rel.
//
// Setup: Pure satellite navigation observables reconstruction module.
//
// Beats:
//   1. Reconstruct raw transmission time-of-flight pseudorange measurement.
//   2. Apply satellite polynomial clock correction dt_sat = a0 + a1*(t - toc) + a2*(t - toc)^2.
//   3. Compute general and special relativistic eccentric orbital correction dt_rel = F * e * sqrt(a) * sin(E).

pub type PseudorangeMeasurement = struct {
    sv_id: Int,
    raw_pseudorange_m: Float,
    sat_clock_bias_s: Float,
    relativistic_corr_s: Float,
    iono_delay_m: Float,
    tropo_delay_m: Float
};

pub fn pseudorange_measurement_new(sv: Int, raw_rho: Float) -> PseudorangeMeasurement {
    return PseudorangeMeasurement {
        sv_id: sv,
        raw_pseudorange_m: raw_rho,
        sat_clock_bias_s: 0.0,
        relativistic_corr_s: 0.0,
        iono_delay_m: 0.0,
        tropo_delay_m: 0.0
    };
}

pub fn gnss_calc_sat_clock_correction_s(a0: Float, a1: Float, a2: Float, t_sec: Float, toc_sec: Float) -> Float {
    let dt: Float = t_sec - toc_sec;
    return a0 + (a1 * dt) + (a2 * dt * dt);
}

pub fn gnss_calc_relativistic_correction_s(eccentricity: Float, semi_major_axis_m: Float, eccentric_anomaly_rad: Float) -> Float {
    // Relativistic clock correction constant F = -2 * sqrt(mu) / c^2 = -4.442807633e-10 s / sqrt(m)
    let f_const: Float = -0.0000000004442807633;
    let sqrt_a: Float = sqrt(semi_major_axis_m);
    let sin_e: Float = sin(eccentric_anomaly_rad);
    return f_const * eccentricity * sqrt_a * sin_e;
}

pub fn gnss_calc_corrected_pseudorange_m(meas: &PseudorangeMeasurement, rx_clock_bias_m: Float) -> Float {
    let c: Float = 299792458.0;
    let sat_clock_m: Float = ((meas).sat_clock_bias_s + (meas).relativistic_corr_s) * c;

    // rho_corrected = raw_rho + sat_clock_corr - rx_clock_bias - iono - tropo
    return (((meas).raw_pseudorange_m + sat_clock_m) - rx_clock_bias_m - (meas).iono_delay_m) - (meas).tropo_delay_m;
}
