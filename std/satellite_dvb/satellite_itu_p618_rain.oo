// # ITU-R P.618 Earth-Space Rain Attenuation Model
//
// Logline: Implements ITU-R P.618 rain attenuation, specific attenuation gamma_R = k * R^alpha, and effective path.
//
// Setup: Pure atmospheric attenuation model for satellite link availability and fade margin budgeting.
//
// Beats:
//   1. Compute specific rain attenuation gamma_R (dB/km) from ITU-R P.838 k and alpha parameters.
//   2. Calculate horizontal and vertical path reduction factors and effective slant path length d_eff.
//   3. Scale 0.01% rain attenuation A_0.01 to target annual exceedance probabilities p in [0.001%, 5.0%].

pub type RainAttenuationConfig = struct {
    carrier_freq_ghz: Float,
    elevation_angle_deg: Float,
    station_height_km: Float,
    rain_rate_001_mm_per_h: Float, // Point rain rate R_0.01 (e.g. 30 .. 50 mm/h)
    polarization_tilt_deg: Float
};

pub fn rain_attenuation_config_default(freq_ghz: Float, elev_deg: Float) -> RainAttenuationConfig {
    return RainAttenuationConfig {
        carrier_freq_ghz: freq_ghz,
        elevation_angle_deg: elev_deg,
        station_height_km: 0.1,
        rain_rate_001_mm_per_h: 35.0,
        polarization_tilt_deg: 45.0 // Circular or 45-deg slant linear
    };
}

pub fn rain_calc_specific_attenuation_db_km(freq_ghz: Float, rain_rate_mm_h: Float) -> Float {
    // ITU-R P.838 approximation for 10-30 GHz: gamma_R = k * R^alpha
    let ln10: Float = 2.302585092994046;
    let mut k_val: Float = 0.0188;
    let mut alpha_val: Float = 1.217;

    if freq_ghz >= 20.0 { // Ka-band
        k_val = 0.0916;
        alpha_val = 1.056;
    }

    let log_r: Float = ln(rain_rate_mm_h) / ln10;
    let r_pow_alpha: Float = exp(alpha_val * ln(rain_rate_mm_h));
    return k_val * r_pow_alpha;
}

pub fn rain_calc_effective_path_length_km(cfg: &RainAttenuationConfig) -> Float {
    let pi_val: Float = 3.141592653589793;
    let theta_rad: Float = ((cfg).elevation_angle_deg * pi_val) / 180.0;
    let sin_theta: Float = sin(theta_rad);
    let mut sin_val: Float = sin_theta;
    if sin_val < 0.087 { sin_val = 0.087; }

    // Rain height h_R ~ 4.5 km
    let h_rain: Float = 4.5;
    let l_s: Float = (h_rain - (cfg).station_height_km) / sin_val;

    // Horizontal reduction factor r_001 = 1 / (1 + 0.78 * sqrt(L_G * gamma_R / f) - 0.38*(1 - exp(-2*theta)))
    let r_001: Float = 1.0 / (1.0 + (0.78 * sqrt((l_s * 0.5) / (cfg).carrier_freq_ghz)));
    return l_s * r_001;
}

pub fn rain_calc_a001_attenuation_db(cfg: &RainAttenuationConfig) -> Float {
    let gamma_r: Float = rain_calc_specific_attenuation_db_km((cfg).carrier_freq_ghz, (cfg).rain_rate_001_mm_per_h);
    let d_eff: Float = rain_calc_effective_path_length_km(cfg);
    return gamma_r * d_eff;
}
