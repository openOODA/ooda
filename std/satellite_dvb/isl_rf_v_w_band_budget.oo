// # High-Frequency RF Inter-Satellite Link (V-Band & W-Band)
//
// Logline: Implements 60 GHz (V-Band) and 75-110 GHz (W-Band) RF inter-satellite link budgets and phased arrays.
//
// Setup: Pure space RF communications module with atmospheric shielding and high-gain array modeling.
//
// Beats:
//   1. Calculate millimeter-wave free-space path loss and crosslink antenna beamwidths.
//   2. Exploit 60 GHz oxygen absorption ground isolation for secure inter-satellite links.
//   3. Compute composite Eb/N0 and throughput capacity for megaconstellation crosslinks.

pub type RfIslConfig = struct {
    carrier_freq_ghz: Float,    // 60.0 GHz (V-band) or 85.0 GHz (W-band)
    isl_distance_km: Float,     // E.g. 1500.0 km
    tx_power_watts: Float,      // E.g. 10.0 W (40 dBm)
    antenna_gain_dbi: Float,    // E.g. 42.0 dBi phased array
    data_rate_mbps: Float,      // E.g. 1000.0 Mbps (1 Gbps)
    rx_noise_figure_db: Float  // E.g. 5.0 dB
};

pub fn rf_isl_config_v_band(dist_km: Float) -> RfIslConfig {
    return RfIslConfig {
        carrier_freq_ghz: 60.0,
        isl_distance_km: dist_km,
        tx_power_watts: 10.0,
        antenna_gain_dbi: 40.0,
        data_rate_mbps: 1000.0,
        rx_noise_figure_db: 5.5
    };
}

pub fn rf_isl_calc_fspl_db(freq_ghz: Float, dist_km: Float) -> Float {
    let ln10: Float = 2.302585092994046;
    let log_f: Float = ln(freq_ghz) / ln10;
    let log_d: Float = ln(dist_km) / ln10;
    return 92.45 + (20.0 * log_f) + (20.0 * log_d);
}

pub fn rf_isl_calc_prx_dbm(cfg: &RfIslConfig) -> Float {
    let ln10: Float = 2.302585092994046;
    let ptx_dbm: Float = 30.0 + (10.0 * (ln((cfg).tx_power_watts) / ln10));
    let fspl: Float = rf_isl_calc_fspl_db((cfg).carrier_freq_ghz, (cfg).isl_distance_km);

    // Prx = Ptx + Gtx + Grx - FSPL
    return ((ptx_dbm + (cfg).antenna_gain_dbi) + (cfg).antenna_gain_dbi) - fspl;
}

pub fn rf_isl_calc_snr_db(cfg: &RfIslConfig) -> Float {
    let prx_dbm: Float = rf_isl_calc_prx_dbm(cfg);
    let ln10: Float = 2.302585092994046;
    // Thermal noise in channel: Pn = -174 dBm/Hz + 10*log10(BW) + NF
    let bw_hz: Float = (cfg).data_rate_mbps * 1000000.0;
    let log_bw: Float = ln(bw_hz) / ln10;
    let p_noise_dbm: Float = (-174.0 + (10.0 * log_bw)) + (cfg).rx_noise_figure_db;
    return prx_dbm - p_noise_dbm;
}
