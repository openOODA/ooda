// # Walker Constellation Inter-Satellite Mesh Routing
//
// Logline: Implements intra-plane and inter-plane ISL mesh routing, propagation delay metrics, and seam crossing logic.
//
// Setup: Pure space networking topology module for LEO megaconstellation packet forwarding.
//
// Beats:
//   1. Model 4-ISL grid topology (intra-plane front/back, inter-plane left/right).
//   2. Calculate line-of-sight distance and one-way light time propagation delay.
//   3. Handle Walker-star counter-rotating polar seam crossing link shutdowns.

pub type SatelliteNode = struct {
    plane_idx: Int,
    satellite_in_plane_idx: Int,
    orbital_radius_km: Float,
    true_anomaly_deg: Float,
    is_polar_seam_neighbor: Int,
};

pub fn satellite_node_new(plane: Int, sat: Int, r_km: Float, nu_deg: Float) -> SatelliteNode {
    return SatelliteNode {
        plane_idx: plane,
        satellite_in_plane_idx: sat,
        orbital_radius_km: r_km,
        true_anomaly_deg: nu_deg,
        is_polar_seam_neighbor: 0,
    };
}

pub fn isl_calc_intra_plane_distance_km(r_km: Float, sats_per_plane: Int) -> Float {
    let pi_val: Float = 3.141592653589793;
    let sats_f: Float = isl_int_to_float(sats_per_plane);
    let delta_angle_rad: Float = (2.0 * pi_val) / sats_f;
    // Chord distance = 2 * R * sin(delta_angle / 2)
    return 2.0 * r_km * sin(delta_angle_rad * 0.5);
}

pub fn isl_calc_one_way_delay_ms(distance_km: Float) -> Float {
    let c_kms: Float = 299792.458;
    return (distance_km / c_kms) * 1000.0;
}

pub fn isl_is_link_active(is_inter_plane: Int, is_seam: Int, lat_deg: Float) -> Bool {
    if is_inter_plane == 0 {
        return true; // Intra-plane links always active
    }
    if is_seam == 1 {
        return false; // Polar seam crossing links disabled due to extreme Doppler/angle rate
    }
    // High latitude polar region inter-plane link shutoff (|lat| > 70 deg)
    let mut abs_lat: Float = lat_deg;
    if abs_lat < 0.0 { abs_lat = 0.0 - abs_lat; }
    return abs_lat < 70.0;
}

pub fn isl_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
