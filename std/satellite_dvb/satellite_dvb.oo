pub type SatelliteDvbSystemConfig = struct {
    downlink_freq_ghz: Float,
    uplink_freq_ghz: Float,
    symbol_rate_msps: Float,
    fec_frame_size: Int,     // 0: Normal (64800), 1: Short (16200), 2: Medium (32400)
    current_modcod: Int,
    pilots_enabled: Int,
    roll_off_factor: Float,
};

pub fn satellite_dvb_system_config_default_ka_band() -> SatelliteDvbSystemConfig {
    return SatelliteDvbSystemConfig {
        downlink_freq_ghz: 19.7,
        uplink_freq_ghz: 29.5,
        symbol_rate_msps: 36.0,
        fec_frame_size: 0,
        current_modcod: 16,   // 16APSK 3/4
        pilots_enabled: 1,
        roll_off_factor: 0.10, // DVB-S2X 10% roll-off
    };
}

pub fn satellite_dvb_create_link_budget() -> SatelliteLinkBudget {
    return satellite_link_budget_default();
}

pub fn satellite_dvb_create_saleh_twta() -> SalehHpaModel {
    return saleh_twta_default();
}

pub fn satellite_dvb_create_gps_prn(sv_id: Int) -> GpsPrnConfig {
    return gps_prn_config_new(sv_id);
}

pub fn satellite_dvb_create_laser_isl_budget() -> LaserIslBudget {
    return laser_isl_budget_default();
}

pub fn satellite_dvb_create_phased_array(freq_ghz: Float) -> PhasedArrayConfig {
    return phased_array_config_default(freq_ghz);
}
