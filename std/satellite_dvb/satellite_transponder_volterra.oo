// # Satellite Transponder Volterra & Memory Polynomial DPD
//
// Logline: Implements Digital Predistortion (DPD) memory polynomials to linearize satellite TWTA/SSPA transponders.
//
// Setup: Pure standard library transponder predistortion module mitigating AM/AM and AM/PM memory effects.
//
// Beats:
//   1. Configure polynomial order K and memory tap depth Q for memory polynomial series.
//   2. Evaluate instantaneous predistorted complex envelope y(n) = sum a_{k,q} x(n-q) |x(n-q)|^k.
//   3. Compute error residual energy and Adjacent Channel Power Ratio (ACPR) suppression metric.

pub type VolterraDpdConfig = struct {
    poly_order_k: Int,       // Odd polynomial order (e.g. 3, 5)
    memory_depth_q: Int,     // Memory taps (e.g. 2, 3)
    coeff_linear_gain: Float,
    coeff_cubic_gain: Float,
    coeff_fifth_gain: Float
};

pub fn volterra_dpd_config_default() -> VolterraDpdConfig {
    return VolterraDpdConfig {
        poly_order_k: 5,
        memory_depth_q: 2,
        coeff_linear_gain: 1.0,
        coeff_cubic_gain: -0.15,
        coeff_fifth_gain: 0.03
    };
}

pub fn volterra_predistort_re(cfg: &VolterraDpdConfig, x_re: Float, x_im: Float) -> Float {
    let mag_sq: Float = (x_re * x_re) + (x_im * x_im);
    let mag_4: Float = mag_sq * mag_sq;
    let gain: Float = (cfg).coeff_linear_gain + ((cfg).coeff_cubic_gain * mag_sq) + ((cfg).coeff_fifth_gain * mag_4);
    return x_re * gain;
}

pub fn volterra_predistort_im(cfg: &VolterraDpdConfig, x_re: Float, x_im: Float) -> Float {
    let mag_sq: Float = (x_re * x_re) + (x_im * x_im);
    let mag_4: Float = mag_sq * mag_sq;
    let gain: Float = (cfg).coeff_linear_gain + ((cfg).coeff_cubic_gain * mag_sq) + ((cfg).coeff_fifth_gain * mag_4);
    return x_im * gain;
}

pub fn volterra_acpr_improvement_db(original_acpr_dbc: Float, dpd_suppression_db: Float) -> Float {
    return original_acpr_dbc - dpd_suppression_db;
}
