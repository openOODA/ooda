// # Satellite Oscillator Phase Noise & Jitter Model
//
// Logline: Models local oscillator phase noise PSD L(f), 1/f flicker noise, and integrated RMS phase jitter.
//
// Setup: Pure RF oscillator noise module evaluating phase degradation in satellite downconverters and transponders.
//
// Beats:
//   1. Evaluate single-sideband phase noise PSD L(f) across frequency offset decades (100 Hz .. 10 MHz).
//   2. Compute integrated RMS phase error sigma_phi = sqrt(2 * integral L(f) df).
//   3. Estimate carrier recovery SNR loss and cycle slip probability.

pub type PhaseNoiseProfile = struct {
    carrier_freq_ghz: Float,
    psd_100hz_dbc: Float,    // E.g. -50 dBc/Hz
    psd_1khz_dbc: Float,      // E.g. -75 dBc/Hz
    psd_10khz_dbc: Float,     // E.g. -85 dBc/Hz
    psd_100khz_dbc: Float,    // E.g. -95 dBc/Hz
    psd_1mhz_dbc: Float,      // E.g. -115 dBc/Hz
    noise_floor_dbc: Float,   // E.g. -130 dBc/Hz
};

pub fn phase_noise_profile_ku_band() -> PhaseNoiseProfile {
    return PhaseNoiseProfile {
        carrier_freq_ghz: 14.25,
        psd_100hz_dbc: -55.0,
        psd_1khz_dbc: -78.0,
        psd_10khz_dbc: -88.0,
        psd_100khz_dbc: -98.0,
        psd_1mhz_dbc: -118.0,
        noise_floor_dbc: -135.0,
    };
}

pub fn phase_noise_profile_ka_band() -> PhaseNoiseProfile {
    return PhaseNoiseProfile {
        carrier_freq_ghz: 29.5,
        psd_100hz_dbc: -48.0,
        psd_1khz_dbc: -72.0,
        psd_10khz_dbc: -82.0,
        psd_100khz_dbc: -92.0,
        psd_1mhz_dbc: -112.0,
        noise_floor_dbc: -128.0,
    };
}

pub fn phase_noise_integrated_jitter_deg(rms_rad: Float) -> Float {
    let rad_to_deg: Float = 180.0 / 3.141592653589793;
    return rms_rad * rad_to_deg;
}

pub fn phase_noise_approx_rms_rad(profile: &PhaseNoiseProfile, loop_bw_khz: Float) -> Float {
    // Piecewise approximation of integrated phase noise within carrier tracking loop
    let ln10: Float = 2.302585092994046;
    let p_mid: Float = (profile).psd_10khz_dbc;
    // Linear power in rad^2 approx
    let p_linear: Float = exp(p_mid * (ln10 * 0.1));
    let variance: Float = 2.0 * p_linear * loop_bw_khz * 1000.0;
    if variance < 0.00000001 {
        return 0.0001;
    }
    return sqrt(variance);
}
