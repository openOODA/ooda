// # Continuous Phase Modulation (CPM) Engine
//
// Logline: Implements generalized Laurent decomposition, phase tree navigation, and constant-envelope CPM state machines.
//
// Setup: Pure satellite waveform processing module for power-efficient nonlinear transponder links.
//
// Beats:
//   1. Decompose CPM signals into principal Laurent pulse components h0(t) and pseudo-pulses.
//   2. Model M-ary phase tree state transitions and memory constraint states.
//   3. Compute complex baseband symbols with unity envelope preservation |s(t)| = 1.0.

pub type CpmModulatorState = struct {
    m_ary_alphabet: Int,     // E.g. 2 for binary CPM, 4 for quaternary CPM
    h_modulation_index: Float, // E.g. 0.5 for MSK / GMSK
    pulse_length_l: Int,     // Correlation memory in symbol intervals
    current_phase_rad: Float,
    samples_per_symbol: Int,
};

pub fn cpm_modulator_state_new(alphabet: Int, h_idx: Float, l_len: Int, sps: Int) -> CpmModulatorState {
    return CpmModulatorState {
        m_ary_alphabet: alphabet,
        h_modulation_index: h_idx,
        pulse_length_l: l_len,
        current_phase_rad: 0.0,
        samples_per_symbol: sps,
    };
}

pub fn cpm_laurent_principal_pulse(t_norm: Float, l_len: Int) -> Float {
    // Principal AMP pulse h0(t) approximation: product of sine pulses
    let l_f: Float = cpm_int_to_float(l_len);
    if (t_norm < 0.0) || (t_norm > (l_f + 1.0)) {
        return 0.0;
    }
    let pi_val: Float = 3.141592653589793;
    let s: Float = sin((pi_val * t_norm) / (l_f + 1.0));
    return s * s;
}

pub fn cpm_modulate_step_i(state: &mut CpmModulatorState, symbol_val: Int, dt_norm: Float) -> Float {
    let pi_val: Float = 3.141592653589793;
    let sym_f: Float = cpm_int_to_float(symbol_val);
    let delta_phase: Float = 2.0 * pi_val * (*state).h_modulation_index * sym_f * dt_norm;
    (*state).current_phase_rad = (*state).current_phase_rad + delta_phase;
    return cos((*state).current_phase_rad);
}

pub fn cpm_modulate_step_q(state: &mut CpmModulatorState, symbol_val: Int, dt_norm: Float) -> Float {
    let pi_val: Float = 3.141592653589793;
    let sym_f: Float = cpm_int_to_float(symbol_val);
    let delta_phase: Float = 2.0 * pi_val * (*state).h_modulation_index * sym_f * dt_norm;
    return sin((*state).current_phase_rad + delta_phase);
}

pub fn cpm_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
