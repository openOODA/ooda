// # DVB-RCS2 Return Link Burst Framing
//
// Logline: Implements ETSI EN 301 545-2 DVB-RCS2 return link MF-TDMA burst formats and slot structures.
//
// Setup: Pure satellite return link physical burst generation and timing advance module.
//
// Beats:
//   1. Model MF-TDMA carrier frequency grids, time-slot durations, and burst profiles.
//   2. Partition burst into preamble, distributed pilot blocks, payload data, and postamble.
//   3. Compute terminal transmission burst timing offset with Doppler advance.

pub type DvbRcs2BurstConfig = struct {
    burst_type: Int,         // 0: Traffic Burst (TC2), 1: Control Burst (CSC), 2: Random Access (RA)
    symbol_rate_ksps: Float,
    carrier_bandwidth_khz: Float,
    preamble_symbols: Int,
    payload_symbols: Int,
    pilot_symbols: Int,
    guard_symbols: Int,
    total_slot_symbols: Int,
};

pub fn dvbRcs2_burst_config_new(burst_t: Int, sym_rate: Float) -> DvbRcs2BurstConfig {
    let mut pre_sym: Int = 32;
    let mut pay_sym: Int = 536;
    let mut plt_sym: Int = 16;
    let mut grd_sym: Int = 16;

    if burst_t == 1 { // Control burst
        pre_sym = 48;
        pay_sym = 120;
        plt_sym = 0;
        grd_sym = 24;
    } else if burst_t == 2 { // Random access
        pre_sym = 64;
        pay_sym = 256;
        plt_sym = 0;
        grd_sym = 40;
    }

    let tot: Int = pre_sym + pay_sym + plt_sym + grd_sym;
    let bw: Float = sym_rate * 1.25; // 25% root raised cosine roll-off

    return DvbRcs2BurstConfig {
        burst_type: burst_t,
        symbol_rate_ksps: sym_rate,
        carrier_bandwidth_khz: bw,
        preamble_symbols: pre_sym,
        payload_symbols: pay_sym,
        pilot_symbols: plt_sym,
        guard_symbols: grd_sym,
        total_slot_symbols: tot,
    };
}

pub fn dvb_rcs2_burst_duration_ms(cfg: &DvbRcs2BurstConfig) -> Float {
    let syms: Float = dvb_rcs2_int_to_float((cfg).total_slot_symbols);
    return syms / (cfg).symbol_rate_ksps;
}

pub fn dvb_rcs2_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
