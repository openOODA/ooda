// # Satellite Orbital Doppler Shift & Rate Calculator
//
// Logline: Calculates LEO/MEO/GEO line-of-sight radial velocities, Doppler frequency shift, and Doppler rate.
//
// Setup: Pure astrodynamics and RF tracking module for satellite carrier frequency synchronization.
//
// Beats:
//   1. Project satellite relative velocity vector onto topocentric ground station line-of-sight vector.
//   2. Compute Doppler frequency shift f_d = - f_0 * (v_rel . r_los) / (c * ||r_los||).
//   3. Compute Doppler rate of change df_d/dt (Hz/s) for high-speed LEO overpasses.

pub type DopplerTrackingState = struct {
    carrier_freq_hz: Float,
    current_doppler_hz: Float,
    current_doppler_rate_hz_per_s: Float,
    speed_of_light: Float,
};

pub fn doppler_tracking_state_new(carrier_hz: Float) -> DopplerTrackingState {
    return DopplerTrackingState {
        carrier_freq_hz: carrier_hz,
        current_doppler_hz: 0.0,
        current_doppler_rate_hz_per_s: 0.0,
        speed_of_light: 299792458.0,
    };
}

pub fn satellite_calc_doppler_hz(carrier_hz: Float, radial_velocity_mps: Float) -> Float {
    let c: Float = 299792458.0;
    // Positive radial velocity means moving away -> negative Doppler shift
    return (0.0 - carrier_hz) * (radial_velocity_mps / c);
}

pub fn satellite_calc_doppler_rate_hz_s(carrier_hz: Float, radial_accel_mps2: Float) -> Float {
    let c: Float = 299792458.0;
    return (0.0 - carrier_hz) * (radial_accel_mps2 / c);
}

pub fn satellite_update_doppler_state(
    state: &mut DopplerTrackingState,
    radial_vel_mps: Float,
    radial_acc_mps2: Float
) {
    let fc: Float = (*state).carrier_freq_hz;
    (*state).current_doppler_hz = satellite_calc_doppler_hz(fc, radial_vel_mps);
    (*state).current_doppler_rate_hz_per_s = satellite_calc_doppler_rate_hz_s(fc, radial_acc_mps2);
}
