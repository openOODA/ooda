// # Satellite Phased Array Planar Beamformer
//
// Logline: Implements MxN planar phased array beam steering vectors, progressive phase shifts, and Array Factor.
//
// Setup: Pure satellite payload beamforming module synthesizing electronically steerable spot beams.
//
// Beats:
//   1. Configure MxN rectangular planar element grid with half-wavelength inter-element spacings dx, dy.
//   2. Compute progressive steering phase shift psi_{m,n} = k0 * [m*dx*sin(theta)*cos(phi) + n*dy*sin(theta)*sin(phi)].
//   3. Evaluate normalized Array Factor AF(theta, phi) and mainlobe boresight directivity.

pub type PhasedArrayConfig = struct {
    num_elements_x: Int,     // E.g. 8 elements
    num_elements_y: Int,     // E.g. 8 elements (64 total)
    element_spacing_dx_m: Float,
    element_spacing_dy_m: Float,
    carrier_freq_ghz: Float,
    steer_theta_deg: Float,  // Scan angle from boresight (0 .. 60 deg)
    steer_phi_deg: Float    // Azimuth angle in array plane (0 .. 360 deg)
};

pub fn phased_array_config_default(freq_ghz: Float) -> PhasedArrayConfig {
    let wavelength_m: Float = 0.299792458 / freq_ghz;
    let d_spacing: Float = 0.5 * wavelength_m; // lambda / 2
    return PhasedArrayConfig {
        num_elements_x: 8,
        num_elements_y: 8,
        element_spacing_dx_m: d_spacing,
        element_spacing_dy_m: d_spacing,
        carrier_freq_ghz: freq_ghz,
        steer_theta_deg: 0.0,
        steer_phi_deg: 0.0
    };
}

pub fn phased_array_element_phase_rad(
    cfg: &PhasedArrayConfig,
    elem_m: Int,
    elem_n: Int
) -> Float {
    let pi_val: Float = 3.141592653589793;
    let lambda_m: Float = 0.299792458 / (cfg).carrier_freq_ghz;
    let k0: Float = (2.0 * pi_val) / lambda_m;

    let theta_rad: Float = ((cfg).steer_theta_deg * pi_val) / 180.0;
    let phi_rad: Float = ((cfg).steer_phi_deg * pi_val) / 180.0;

    let sin_t: Float = sin(theta_rad);
    let cos_p: Float = cos(phi_rad);
    let sin_p: Float = sin(phi_rad);

    let m_f: Float = phased_array_int_to_float(elem_m);
    let n_f: Float = phased_array_int_to_float(elem_n);

    let pos_x: Float = m_f * (cfg).element_spacing_dx_m;
    let pos_y: Float = n_f * (cfg).element_spacing_dy_m;

    let phase_rad: Float = (0.0 - k0) * ((pos_x * sin_t * cos_p) + (pos_y * sin_t * sin_p));
    return phase_rad;
}

pub fn phased_array_calc_directivity_dbi(cfg: &PhasedArrayConfig) -> Float {
    let total_elements: Int = (cfg).num_elements_x * (cfg).num_elements_y;
    let ln10: Float = 2.302585092994046;
    let log_n: Float = ln(phased_array_int_to_float(total_elements)) / ln10;
    // Directivity ~ 10*log10(4*pi * Area / lambda^2) ~ 10*log10(N) + element_gain
    return (10.0 * log_n) + 3.0;
}

pub fn phased_array_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
