// # Satellite Multi-Carrier Intermodulation (IM3 / IM5) Analysis
//
// Logline: Models third-order and fifth-order intermodulation products and Carrier-to-Intermodulation (C/IM) ratio.
//
// Setup: Pure RF analysis module for multicarrier satellite transponders sharing high-power amplifiers.
//
// Beats:
//   1. Calculate two-tone 2*f1 - f2 and three-tone f1 + f2 - f3 intermodulation product frequencies.
//   2. Compute transponder Carrier-to-Intermodulation (C/IM) vs Output Back-Off (OBO).
//   3. Estimate transponder Noise Power Ratio (NPR) in frequency division multiplexing transponders.

pub type IntermodConfig = struct {
    num_carriers: Int,
    output_backoff_obo_db: Float, // E.g. 2.0 to 6.0 dB
    amplifier_type: Int          // 0: TWTA, 1: SSPA
};

pub fn intermod_config_new(carriers: Int, obo_db: Float, amp_type: Int) -> IntermodConfig {
    return IntermodConfig {
        num_carriers: carriers,
        output_backoff_obo_db: obo_db,
        amplifier_type: amp_type
    };
}

pub fn intermod_two_tone_im3_freq(f1_mhz: Float, f2_mhz: Float) -> Float {
    return (2.0 * f1_mhz) - f2_mhz;
}

pub fn intermod_three_tone_im3_freq(f1_mhz: Float, f2_mhz: Float, f3_mhz: Float) -> Float {
    return (f1_mhz + f2_mhz) - f3_mhz;
}

pub fn intermod_carrier_to_im_db(cfg: &IntermodConfig) -> Float {
    let obo: Float = (cfg).output_backoff_obo_db;
    let mut slope: Float = 2.0; // Standard 2:1 slope for 3rd order IM
    let mut intercept: Float = 12.0;

    if (cfg).amplifier_type == 1 {
        // SSPA has steeper slope and higher linearity at high OBO
        slope = 2.2;
        intercept = 14.0;
    }

    let c_im: Float = intercept + (slope * obo);
    return c_im;
}

pub fn intermod_npr_db(cfg: &IntermodConfig) -> Float {
    // Noise Power Ratio approximately equals C/IM + 1.5 dB in dense multicarrier
    let c_im: Float = intermod_carrier_to_im_db(cfg);
    return c_im + 1.5;
}
