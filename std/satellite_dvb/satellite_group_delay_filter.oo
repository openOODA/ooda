// # Satellite Transponder IMUX / OMUX Group Delay Filter
//
// Logline: Models transponder multiplexer linear, parabolic, and ripple group delay distortion and equalization.
//
// Setup: Pure RF filter distortion module for satellite channel bandwidth equalization.
//
// Beats:
//   1. Model linear group delay slope (ns/MHz), parabolic curvature (ns/MHz^2), and ripple.
//   2. Evaluate differential delay tau(f) = tau_0 + b1 * delta_f + b2 * delta_f^2 across channel band.
//   3. Compute equalizer phase correction coefficients to minimize Inter-Symbol Interference (ISI).

pub type TransponderGroupDelay = struct {
    channel_bw_mhz: Float,
    center_freq_mhz: Float,
    linear_slope_ns_per_mhz: Float,   // Linear delay coefficient b1
    parabolic_curv_ns_per_mhz2: Float,// Parabolic delay coefficient b2
    ripple_peak_ns: Float,           // Periodic ripple amplitude
    ripple_period_mhz: Float,        // Ripple frequency period
};

pub fn transponder_group_delay_default(bw_mhz: Float) -> TransponderGroupDelay {
    return TransponderGroupDelay {
        channel_bw_mhz: bw_mhz,
        center_freq_mhz: 0.0,
        linear_slope_ns_per_mhz: 0.15,
        parabolic_curv_ns_per_mhz2: 0.04,
        ripple_peak_ns: 0.8,
        ripple_period_mhz: 5.0,
    };
}

pub fn transponder_calc_group_delay_ns(cfg: &TransponderGroupDelay, freq_offset_mhz: Float) -> Float {
    let b1: Float = (cfg).linear_slope_ns_per_mhz;
    let b2: Float = (cfg).parabolic_curv_ns_per_mhz2;
    let f: Float = freq_offset_mhz;
    let f2: Float = f * f;

    let poly_delay: Float = (b1 * f) + (b2 * f2);

    let pi_val: Float = 3.141592653589793;
    let ripple_arg: Float = (2.0 * pi_val * f) / (cfg).ripple_period_mhz;
    let ripple_delay: Float = (cfg).ripple_peak_ns * sin(ripple_arg);

    return poly_delay + ripple_delay;
}

pub fn transponder_phase_distortion_rad(cfg: &TransponderGroupDelay, freq_offset_mhz: Float) -> Float {
    // Phase phi(f) = 2*pi * integral(tau(f) df)
    let b1: Float = (cfg).linear_slope_ns_per_mhz;
    let b2: Float = (cfg).parabolic_curv_ns_per_mhz2;
    let f: Float = freq_offset_mhz;
    let f2: Float = f * f;
    let f3: Float = f2 * f;

    // Integral of (b1*f + b2*f^2) in MHz*ns = 1e-3 radians
    let int_tau_ns_mhz: Float = (0.5 * b1 * f2) + ((1.0 / 3.0) * b2 * f3);
    let pi_val: Float = 3.141592653589793;
    return (2.0 * pi_val * int_tau_ns_mhz) * 0.001;
}
