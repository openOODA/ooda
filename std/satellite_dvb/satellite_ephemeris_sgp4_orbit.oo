// # Simplified Satellite Keplerian Orbit & Ephemeris
//
// Logline: Solves Kepler equation, converts orbital elements to ECEF position, and calculates ground azimuth/elevation.
//
// Setup: Pure orbital mechanics module computing satellite pass geometry for ground terminals.
//
// Beats:
//   1. Solve Kepler equation E - e*sin(E) = M using Newton-Raphson iteration.
//   2. Transform perifocal orbital coordinates to Earth-Centered Earth-Fixed (ECEF) frame.
//   3. Compute topocentric Azimuth, Elevation, and Slant Range from Ground Station coordinates.

pub type KeplerOrbitElements = struct {
    semi_major_axis_km: Float,
    eccentricity: Float,
    inclination_deg: Float,
    raan_deg: Float,             // Right Ascension of Ascending Node
    arg_perigee_deg: Float,      // Argument of Perigee
    mean_anomaly_deg: Float
};

pub fn kepler_orbit_leo_default() -> KeplerOrbitElements {
    return KeplerOrbitElements {
        semi_major_axis_km: 6928.0, // ~550 km altitude LEO
        eccentricity: 0.001,
        inclination_deg: 53.0,
        raan_deg: 120.0,
        arg_perigee_deg: 45.0,
        mean_anomaly_deg: 0.0
    };
}

pub fn kepler_solve_eccentric_anomaly_rad(mean_anom_deg: Float, ecc: Float) -> Float {
    let pi_val: Float = 3.141592653589793;
    let m_rad: Float = (mean_anom_deg * pi_val) / 180.0;
    let mut e_val: Float = m_rad;

    // 4 Newton-Raphson iterations: E_{n+1} = E_n - (E_n - e*sin(E_n) - M) / (1 - e*cos(E_n))
    let mut i: Int = 0;
    while i < 4 {
        let f: Float = (e_val - (ecc * sin(e_val))) - m_rad;
        let f_prime: Float = 1.0 - (ecc * cos(e_val));
        e_val = e_val - (f / f_prime);
        i = i + 1;
    }
    return e_val;
}

pub fn kepler_orbital_radius_km(elem: &KeplerOrbitElements, e_rad: Float) -> Float {
    return (elem).semi_major_axis_km * (1.0 - ((elem).eccentricity * cos(e_rad)));
}

pub fn kepler_calc_elevation_deg(slant_range_km: Float, sat_alt_km: Float, central_angle_deg: Float) -> Float {
    let r_earth_km: Float = 6378.137;
    let pi_val: Float = 3.141592653589793;
    let psi_rad: Float = (central_angle_deg * pi_val) / 180.0;

    let cos_psi: Float = cos(psi_rad);
    let sin_psi: Float = sin(psi_rad);

    let num: Float = cos_psi - (r_earth_km / (r_earth_km + sat_alt_km));
    let den: Float = sin_psi;
    if den < 0.000001 { return 90.0; }

    let ratio: Float = num / den;
    let elev_rad: Float = ratio / (1.0 + (0.28 * ratio * ratio));
    return (elev_rad * 180.0) / pi_val;
}
