// # GPS L1 C/A PRN Gold Code Generator
//
// Logline: Generates 1023-chip GPS L1 C/A pseudorandom Gold code sequences using dual 10-stage LFSRs.
//
// Setup: Pure GNSS baseband signal processing module implementing IS-GPS-200 specifications.
//
// Beats:
//   1. Advance G1 polynomial 1 + x^3 + x^10 and G2 polynomial 1 + x^2 + x^3 + x^6 + x^8 + x^9 + x^10 LFSRs.
//   2. Configure PRN phase selector taps for GPS Space Vehicles SV 1 through 32.
//   3. Generate consecutive Gold code chips at 1.023 Mchip/s chipping rate.

pub type GpsPrnConfig = struct {
    sv_id: Int,
    g2_tap_a: Int,
    g2_tap_b: Int,
    g1_state: Int,           // 10-bit register (all 1s init = 1023)
    g2_state: Int,           // 10-bit register
    chip_counter: Int
};

pub fn gps_prn_config_new(sv: Int) -> GpsPrnConfig {
    // Phase selector taps for SV 1 to SV 8
    let mut tap_a: Int = 2;
    let mut tap_b: Int = 6;
    if sv == 1 { tap_a = 2; tap_b = 6; }
    else if sv == 2 { tap_a = 3; tap_b = 7; }
    else if sv == 3 { tap_a = 4; tap_b = 8; }
    else if sv == 4 { tap_a = 5; tap_b = 9; }
    else if sv == 5 { tap_a = 1; tap_b = 9; }
    else if sv == 6 { tap_a = 2; tap_b = 10; }
    else if sv == 7 { tap_a = 1; tap_b = 8; }
    else if sv == 8 { tap_a = 2; tap_b = 9; }

    return GpsPrnConfig {
        sv_id: sv,
        g2_tap_a: tap_a,
        g2_tap_b: tap_b,
        g1_state: 1023, // 0x3FF
        g2_state: 1023,
        chip_counter: 0
    };
}

pub fn gps_step_ca_chip(cfg: &mut GpsPrnConfig) -> Int {
    // G1 feedback: taps 3 and 10 (bits 3 and 10)
    let g1_reg: Int = (*cfg).g1_state;
    let g1_out: Int = (g1_reg >> 9) & 1; // Bit 10
    let g1_fb: Int = ((g1_reg >> 2) ^ (g1_reg >> 9)) & 1;

    // G2 feedback: taps 2, 3, 6, 8, 9, 10
    let g2_reg: Int = (*cfg).g2_state;
    let g2_t_a: Int = (g2_reg >> ((*cfg).g2_tap_a - 1)) & 1;
    let g2_t_b: Int = (g2_reg >> ((*cfg).g2_tap_b - 1)) & 1;
    let g2_out: Int = g2_t_a ^ g2_t_b;

    let g2_fb: Int = (((g2_reg >> 1) ^ (g2_reg >> 2) ^ (g2_reg >> 5) ^ (g2_reg >> 7) ^ (g2_reg >> 8) ^ (g2_reg >> 9))) & 1;

    (*cfg).g1_state = ((g1_reg << 1) & 1022) | g1_fb;
    (*cfg).g2_state = ((g2_reg << 1) & 1022) | g2_fb;
    (*cfg).chip_counter = ((*cfg).chip_counter + 1) % 1023;

    return g1_out ^ g2_out;
}

pub fn gps_is_epoch_boundary(cfg: &GpsPrnConfig) -> Bool {
    return (*cfg).chip_counter == 0;
}
