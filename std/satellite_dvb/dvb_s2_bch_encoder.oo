// # DVB-S2 Outer BCH Code Generator
//
// Logline: Implements DVB-S2 outer BCH error-correcting code for short and normal FEC frames.
//
// Setup: Pure algebraic forward error correction module operating over GF(2^16).
//
// Beats:
//   1. Configure BCH parameters for t = 8, 10, 12 bit error correction capability.
//   2. Define BCH parity bit lengths (160 bits for short t=12, 192 bits for normal t=12).
//   3. Compute systematic BCH parity bit verification over information bitfields.

pub type DvbBchConfig = struct {
    error_correction_t: Int, // 8, 10, or 12 bits
    is_short_frame: Int,     // 0: Normal (N_ldpc = 64800), 1: Short (N_ldpc = 16200)
    k_bch: Int,              // Information bits into BCH
    n_bch: Int,              // Output bits from BCH (input to LDPC)
    bch_parity_bits: Int,    // Parity length (e.g. 192 bits)
};

pub fn dvb_bch_config_normal_t12(k_info: Int) -> DvbBchConfig {
    return DvbBchConfig {
        error_correction_t: 12,
        is_short_frame: 0,
        k_bch: k_info,
        n_bch: k_info + 192,
        bch_parity_bits: 192,
    };
}

pub fn dvb_bch_config_short_t12(k_info: Int) -> DvbBchConfig {
    return DvbBchConfig {
        error_correction_t: 12,
        is_short_frame: 1,
        k_bch: k_info,
        n_bch: k_info + 168,
        bch_parity_bits: 168,
    };
}

pub fn dvb_bch_step_lfsr(feedback_bit: Int, state_reg: Int, poly_mask: Int) -> Int {
    let mut next_state: Int = state_reg << 1;
    if feedback_bit != 0 {
        next_state = next_state ^ poly_mask;
    }
    return next_state & 65535;
}

pub fn dvb_bch_parity_check_valid(parity_syn: Int) -> Bool {
    return parity_syn == 0;
}
