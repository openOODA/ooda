// # Optical ISL Relativistic Laser Doppler Shift
//
// Logline: Computes relativistic optical Doppler frequency and wavelength shifts for inter-satellite laser links.
//
// Setup: Pure optical tracking module for laser local oscillator carrier locking and wavelength offset tuning.
//
// Beats:
//   1. Project inter-satellite relative velocity vector onto the optical line-of-sight unit vector.
//   2. Compute optical Doppler shift delta_f = f0 * (v_rel / c) * sqrt(1 - (v/c)^2).
//   3. Compute optical wavelength displacement delta_lambda = - lambda0 * (delta_f / f0) in picometers.

pub type LaserDopplerState = struct {
    nominal_wavelength_nm: Float,  // E.g. 1550.0 nm
    optical_freq_thz: Float,       // E.g. 193.414 THz
    current_doppler_ghz: Float,
    current_delta_lambda_pm: Float,// Picometers (pm)
    speed_of_light: Float,
};

pub fn laser_doppler_state_new(wavelength_nm: Float) -> LaserDopplerState {
    let c: Float = 299792458.0;
    let lambda_m: Float = wavelength_nm * 0.000000001;
    let f_thz: Float = (c / lambda_m) * 0.000000000001; // 1e-12
    return LaserDopplerState {
        nominal_wavelength_nm: wavelength_nm,
        optical_freq_thz: f_thz,
        current_doppler_ghz: 0.0,
        current_delta_lambda_pm: 0.0,
        speed_of_light: c,
    };
}

pub fn laser_calc_doppler_shift_ghz(f_thz: Float, relative_radial_velocity_mps: Float) -> Float {
    let c: Float = 299792458.0;
    let beta: Float = relative_radial_velocity_mps / c;
    // Doppler shift in GHz = f_THz * 1000 * beta
    return f_thz * 1000.0 * beta;
}

pub fn laser_calc_delta_wavelength_pm(wavelength_nm: Float, doppler_ghz: Float, f_thz: Float) -> Float {
    // delta_lambda (pm) = - lambda_nm * 1000 * (delta_f_GHz / (f_THz * 1000))
    let fraction: Float = doppler_ghz / (f_thz * 1000.0);
    return (0.0 - (wavelength_nm * 1000.0)) * fraction;
}

pub fn laser_update_doppler_tracking(state: &mut LaserDopplerState, radial_vel_mps: Float) {
    let f_thz: Float = (*state).optical_freq_thz;
    let wl_nm: Float = (*state).nominal_wavelength_nm;

    let df_ghz: Float = laser_calc_doppler_shift_ghz(f_thz, radial_vel_mps);
    let dlam_pm: Float = laser_calc_delta_wavelength_pm(wl_nm, df_ghz, f_thz);

    (*state).current_doppler_ghz = df_ghz;
    (*state).current_delta_lambda_pm = dlam_pm;
}
