// # DVB-S2X Adaptive Coding and Modulation (ACM) Controller
//
// Logline: Implements closed-loop ACM/VCM adaptation, terminal SNR feedback filtering, and hysteresis switching.
//
// Setup: Pure satellite control loop module maintaining optimal MODCOD efficiency under atmospheric fading.
//
// Beats:
//   1. Filter return-channel terminal SNR telemetry using Exponential Moving Average (EMA).
//   2. Apply hysteresis thresholds to prevent rapid MODCOD ping-pong oscillations.
//   3. Dynamically switch physical layer parameters to meet target Frame Error Rate (FER <= 1e-5).

pub type AcmControllerState = struct {
    smoothed_snr_db: Float,
    alpha_filter: Float,     // EMA smoothing factor (0.05 .. 0.2)
    hysteresis_up_db: Float, // SNR headroom needed to upgrade MODCOD (e.g. 0.8 dB)
    hysteresis_dn_db: Float, // Margin before downgrading MODCOD (e.g. 0.3 dB)
    current_modcod: Int,
    switch_count: Int,
};

pub fn acm_controller_state_new(init_snr: Float, init_modcod: Int) -> AcmControllerState {
    return AcmControllerState {
        smoothed_snr_db: init_snr,
        alpha_filter: 0.1,
        hysteresis_up_db: 0.8,
        hysteresis_dn_db: 0.3,
        current_modcod: init_modcod,
        switch_count: 0,
    };
}

pub fn acm_update_snr(state: &mut AcmControllerState, measured_snr_db: Float) {
    let a: Float = (*state).alpha_filter;
    (*state).smoothed_snr_db = (a * measured_snr_db) + ((1.0 - a) * (*state).smoothed_snr_db);
}

pub fn acm_evaluate_modcod_switch(state: &mut AcmControllerState, target_modcod: Int, target_threshold_db: Float) -> Int {
    let current_snr: Float = (*state).smoothed_snr_db;

    if target_modcod > (*state).current_modcod {
        // Upgrading: require threshold + hysteresis_up
        if current_snr >= (target_threshold_db + (*state).hysteresis_up_db) {
            (*state).current_modcod = target_modcod;
            (*state).switch_count = (*state).switch_count + 1;
        }
    } else if target_modcod < (*state).current_modcod {
        // Downgrading: trigger if SNR falls below threshold + hysteresis_dn
        if current_snr < (target_threshold_db + (*state).hysteresis_dn_db) {
            (*state).current_modcod = target_modcod;
            (*state).switch_count = (*state).switch_count + 1;
        }
    }

    return (*state).current_modcod;
}
