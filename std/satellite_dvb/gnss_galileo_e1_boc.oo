// # Galileo E1 Binary Offset Carrier (BOC) Signal Model
//
// Logline: Implements Galileo E1-OS BOC(1,1) / CBOC modulation, split-spectrum correlation, and subcarrier tracking.
//
// Setup: Pure European GNSS signal processing module for Galileo high-accuracy positioning.
//
// Beats:
//   1. Model square-wave subcarrier modulation sc(t) = sign(sin(2*pi*f_sc*t)).
//   2. Compute split-spectrum BOC(1,1) autocorrelation function R_BOC(tau).
//   3. Implement Dual-Peak Side-Peak Cancellation (ASPeCT) discriminator to remove ambiguous false locks.

pub type GalileoBocConfig = struct {
    subcarrier_rate_mhz: Float, // 1.023 MHz for BOC(1,1)
    code_rate_mhz: Float,       // 1.023 MHz
    is_cboc: Int,               // 1: Composite BOC (CBOC) 6,1,1/11
};

pub fn galileo_boc_config_default() -> GalileoBocConfig {
    return GalileoBocConfig {
        subcarrier_rate_mhz: 1.023,
        code_rate_mhz: 1.023,
        is_cboc: 0,
    };
}

pub fn galileo_boc11_autocorrelation(tau_chips: Float) -> Float {
    let mut tau: Float = tau_chips;
    if tau < 0.0 { tau = 0.0 - tau; }
    if tau >= 1.0 { return 0.0; }

    if tau <= 0.5 {
        // Main peak: 1 - 3*|tau|
        return 1.0 - (3.0 * tau);
    }
    // Negative side peaks: |tau| - 1
    return tau - 1.0;
}

pub fn galileo_boc_subcarrier_val(chip_phase: Float) -> Float {
    // Square wave subcarrier: sign(sin(2*pi*phase))
    let pi_val: Float = 3.141592653589793;
    let s: Float = sin(2.0 * pi_val * chip_phase);
    if s >= 0.0 {
        return 1.0;
    }
    return -1.0;
}

pub fn galileo_aspect_unambiguous_discriminator(e_p: Float, l_p: Float, e_m: Float, l_m: Float) -> Float {
    // ASPeCT technique: Combines code cross-correlation with subcarrier cross-correlation
    let dll_raw: Float = e_p - l_p;
    let penalty: Float = e_m - l_m;
    return dll_raw - (0.5 * penalty);
}
