// # GNSS Position-Velocity-Time (PVT) Least Squares Solver
//
// Logline: Implements iterative Weighted Least Squares (WLS) for 4-state user PVT and Dilution of Precision (DOP).
//
// Setup: Pure satellite navigation position estimation engine solving user ECEF coordinates and clock bias.
//
// Beats:
//   1. Formulate linearization observation matrix H containing line-of-sight unit direction cosines.
//   2. Compute iterative normal equation update delta_x = (H^T * W * H)^(-1) * H^T * W * delta_rho.
//   3. Compute Geometric (GDOP), Position (PDOP), Horizontal (HDOP), and Vertical (VDOP) metrics.

pub type GnssPvtSolution = struct {
    pos_x_m: Float,
    pos_y_m: Float,
    pos_z_m: Float,
    clock_bias_m: Float,
    gdop: Float,
    pdop: Float,
    hdop: Float,
    vdop: Float,
    is_converged: Int
};

pub fn gnss_pvt_solution_new() -> GnssPvtSolution {
    return GnssPvtSolution {
        pos_x_m: 0.0,
        pos_y_m: 0.0,
        pos_z_m: 6378137.0, // Earth radius init
        clock_bias_m: 0.0,
        gdop: 99.9,
        pdop: 99.9,
        hdop: 99.9,
        vdop: 99.9,
        is_converged: 0
    };
}

pub fn gnss_calc_geometric_range_m(rx_x: Float, rx_y: Float, rx_z: Float, sat_x: Float, sat_y: Float, sat_z: Float) -> Float {
    let dx: Float = sat_x - rx_x;
    let dy: Float = sat_y - rx_y;
    let dz: Float = sat_z - rx_z;
    let dist_sq: Float = (dx * dx) + (dy * dy) + (dz * dz);
    return sqrt(dist_sq);
}

pub fn gnss_calc_direction_cosine(rx_coord: Float, sat_coord: Float, geometric_dist: Float) -> Float {
    if geometric_dist < 0.001 { return 0.0; }
    return (rx_coord - sat_coord) / geometric_dist;
}

pub fn gnss_calc_dop_metrics(q11: Float, q22: Float, q33: Float, q44: Float) -> Float {
    // PDOP = sqrt(Q11 + Q22 + Q33)
    let sum_pos: Float = q11 + q22 + q33;
    if sum_pos < 0.000001 { return 1.0; }
    return sqrt(sum_pos);
}
