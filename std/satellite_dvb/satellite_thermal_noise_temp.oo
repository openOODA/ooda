// # Satellite System Noise Temperature (T_sys) & G/T
//
// Logline: Calculates system noise temperature T_sys = T_ant + T_feed + T_lna and G/T figure of merit.
//
// Setup: Pure RF receiver front-end thermal noise calculation engine.
//
// Beats:
//   1. Calculate clear-sky and precipitation antenna temperature T_ant.
//   2. Compute waveguide feed attenuation thermal contribution and LNA noise temperature.
//   3. Evaluate Earth station / Satellite G/T receiver sensitivity figure of merit (dB/K).

pub type SystemNoiseConfig = struct {
    antenna_gain_dbi: Float,
    clear_sky_temp_k: Float,     // Typically 30 .. 50 K at zenith
    rain_attenuation_db: Float,  // Dynamic rain attenuation
    feed_loss_db: Float,         // Waveguide / OMT loss (typically 0.2 .. 0.5 dB)
    ambient_temp_k: Float,       // Typically 290 K
    lna_noise_figure_db: Float  // Typically 0.7 .. 1.5 dB (60 .. 120 K)
};

pub fn system_noise_config_default() -> SystemNoiseConfig {
    return SystemNoiseConfig {
        antenna_gain_dbi: 45.0,
        clear_sky_temp_k: 40.0,
        rain_attenuation_db: 0.0,
        feed_loss_db: 0.3,
        ambient_temp_k: 290.0,
        lna_noise_figure_db: 0.8
    };
}

pub fn noise_calc_lna_temp_k(nf_db: Float, t0_k: Float) -> Float {
    let ln10: Float = 2.302585092994046;
    let f_linear: Float = exp(nf_db * (ln10 * 0.1));
    return t0_k * (f_linear - 1.0);
}

pub fn noise_calc_rain_antenna_temp_k(t_sky_clear: Float, rain_att_db: Float, t_rain: Float) -> Float {
    if rain_att_db <= 0.001 {
        return t_sky_clear;
    }
    let ln10: Float = 2.302585092994046;
    let l_rain: Float = exp(rain_att_db * (ln10 * 0.1));
    return (t_sky_clear / l_rain) + (t_rain * (1.0 - (1.0 / l_rain)));
}

pub fn noise_calc_total_system_temp_k(cfg: &SystemNoiseConfig) -> Float {
    let t_ant: Float = noise_calc_rain_antenna_temp_k((cfg).clear_sky_temp_k, (cfg).rain_attenuation_db, 275.0);

    let ln10: Float = 2.302585092994046;
    let l_feed: Float = exp((cfg).feed_loss_db * (ln10 * 0.1));
    let t_feed: Float = (cfg).ambient_temp_k * (1.0 - (1.0 / l_feed));
    let t_lna: Float = noise_calc_lna_temp_k((cfg).lna_noise_figure_db, (cfg).ambient_temp_k);

    // T_sys referred to LNA input
    return (t_ant / l_feed) + t_feed + t_lna;
}

pub fn noise_calc_g_over_t_dbk(cfg: &SystemNoiseConfig) -> Float {
    let t_sys: Float = noise_calc_total_system_temp_k(cfg);
    let ln10: Float = 2.302585092994046;
    let log_tsys: Float = ln(t_sys) / ln10;

    // G/T = G_ant - L_feed - 10*log10(T_sys)
    return ((cfg).antenna_gain_dbi - (cfg).feed_loss_db) - (10.0 * log_tsys);
}
