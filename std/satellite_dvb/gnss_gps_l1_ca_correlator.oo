// # GNSS Early-Prompt-Late (EPL) Correlator & Tracking Loops
//
// Logline: Implements DLL code tracking, PLL Costas carrier tracking, and Early-Prompt-Late correlator arms.
//
// Setup: Pure GNSS baseband tracking channel module for GPS, Galileo, and BeiDou receivers.
//
// Beats:
//   1. Model Early, Prompt, Late (EPL) correlator I/Q integration with spacing d = 0.5 chip.
//   2. Compute normalized Delay Lock Loop (DLL) discriminator D_dll = (E - L) / (E + L).
//   3. Compute Costas Phase Lock Loop (PLL) discriminator D_pll = atan2(Q_P, I_P) and NCO updates.

pub type EplCorrelatorArm = struct {
    i_early: Float,
    q_early: Float,
    i_prompt: Float,
    q_prompt: Float,
    i_late: Float,
    q_late: Float,
    correlator_spacing_chips: Float, // Typically 0.5 chip
};

pub fn epl_correlator_arm_new() -> EplCorrelatorArm {
    return EplCorrelatorArm {
        i_early: 0.0,
        q_early: 0.0,
        i_prompt: 0.0,
        q_prompt: 0.0,
        i_late: 0.0,
        q_late: 0.0,
        correlator_spacing_chips: 0.5,
    };
}

pub fn gnss_dll_noncoherent_discriminator(epl: &EplCorrelatorArm) -> Float {
    let e_mag: Float = sqrt(((epl).i_early * (epl).i_early) + ((epl).q_early * (epl).q_early));
    let l_mag: Float = sqrt(((epl).i_late * (epl).i_late) + ((epl).q_late * (epl).q_late));
    let sum_mag: Float = e_mag + l_mag;
    if sum_mag < 0.000001 {
        return 0.0;
    }
    return (e_mag - l_mag) / sum_mag;
}

pub fn gnss_pll_costas_discriminator(epl: &EplCorrelatorArm) -> Float {
    let ip: Float = (epl).i_prompt;
    let qp: Float = (epl).q_prompt;
    if ip < 0.000001 && ip > -0.000001 {
        if qp >= 0.0 { return 1.5707963; }
        return -1.5707963;
    }
    // Normalized two-quadrant Costas discriminator: Q_P / I_P
    let ratio: Float = qp / ip;
    // atan approximation: atan(x) ~ x / (1 + 0.28*x^2)
    return ratio / (1.0 + (0.28 * ratio * ratio));
}

pub fn gnss_calc_carrier_to_noise_c_n0_dbhz(epl: &EplCorrelatorArm, integration_time_ms: Float) -> Float {
    let p_sig: Float = ((epl).i_prompt * (epl).i_prompt) + ((epl).q_prompt * (epl).q_prompt);
    let p_noise: Float = 0.5 * (((epl).i_early * (epl).i_early) + ((epl).q_early * (epl).q_early));
    if p_noise < 0.000001 { return 45.0; }

    let snr_linear: Float = p_sig / p_noise;
    let ln10: Float = 2.302585092994046;
    let t_int_s: Float = integration_time_ms * 0.001;
    let log_snr: Float = ln(snr_linear) / ln10;
    let log_tint: Float = ln(t_int_s) / ln10;

    return (10.0 * log_snr) - (10.0 * log_tint);
}
