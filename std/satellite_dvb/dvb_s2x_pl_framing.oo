// # DVB-S2 / DVB-S2X Physical Layer Framing
//
// Logline: Formats DVB-S2/S2X PLHEADER, SOF, PLS codes, pilot blocks, and XFECFRAME slot allocation.
//
// Setup: Pure satellite physical layer framing and slot synchronization module.
//
// Beats:
//   1. Generate 90-symbol PLHEADER containing 26-symbol Start of Frame (SOF) and 64-symbol PLS code.
//   2. Calculate XFECFRAME slot count based on modulation order (QPSK to 256-APSK) and FEC frame type.
//   3. Compute pilot symbol insertion boundaries (36 symbols every 16 slots / 1440 data symbols).

pub type DvbPlHeader = struct {
    sof_pattern: Int,        // 26 symbols: 0x18D2E82
    modcod_id: Int,          // 7-bit MODCOD identifier
    fec_frame_type: Int,     // 0: Normal (64800 bits), 1: Short (16200 bits), 2: Medium (32400 bits)
    pilots_active: Int,      // 0: No pilots, 1: Pilots enabled (36 symbols per 16 slots)
    pls_code_word_hi: Int,   // Reed-Muller (64,7) scrambled upper 32 symbols
    pls_code_word_lo: Int,   // Lower 32 symbols
};

pub type DvbPlFrameMetrics = struct {
    total_slots: Int,
    data_symbols: Int,
    pilot_symbols: Int,
    header_symbols: Int,
    total_pl_symbols: Int,
};

pub fn dvb_pl_header_new(modcod: Int, frame_type: Int, pilots: Int) -> DvbPlHeader {
    return DvbPlHeader {
        sof_pattern: 26029698, // 0x18D2E82
        modcod_id: modcod,
        fec_frame_type: frame_type,
        pilots_active: pilots,
        pls_code_word_hi: 0,
        pls_code_word_lo: 0,
    };
}

pub fn dvb_pl_slots_per_xfecframe(mod_order: Int, frame_type: Int) -> Int {
    let mut total_bits: Int = 64800; // Normal
    if frame_type == 1 {
        total_bits = 16200;          // Short
    } else if frame_type == 2 {
        total_bits = 32400;          // Medium
    }

    let symbols: Int = total_bits / mod_order;
    return symbols / 90; // Each slot is 90 symbols
}

pub fn dvb_pl_frame_metrics_calc(mod_order: Int, frame_type: Int, pilots: Int) -> DvbPlFrameMetrics {
    let slots: Int = dvb_pl_slots_per_xfecframe(mod_order, frame_type);
    let data_syms: Int = slots * 90;
    let header_syms: Int = 90; // Fixed 90-symbol PLHEADER

    let mut pilot_syms: Int = 0;
    if pilots == 1 {
        let pilot_blocks: Int = (slots - 1) / 16;
        pilot_syms = pilot_blocks * 36;
    }

    return DvbPlFrameMetrics {
        total_slots: slots,
        data_symbols: data_syms,
        pilot_symbols: pilot_syms,
        header_symbols: header_syms,
        total_pl_symbols: header_syms + data_syms + pilot_syms,
    };
}

pub fn dvb_pl_is_pilot_boundary(slot_index: Int, pilots_active: Int) -> Bool {
    if pilots_active == 0 {
        return false;
    }
    if slot_index > 0 {
        return (slot_index % 16) == 0;
    }
    return false;
}
