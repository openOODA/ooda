// # GLONASS FDMA Frequency Plan & PRN Modulation
//
// Logline: Implements Russian GLONASS FDMA channel allocation fk = f0 + k * delta_f and 511-chip MLS PRN codes.
//
// Setup: Pure GLONASS satellite navigation frequency synthesis and Meander subcarrier encoding module.
//
// Beats:
//   1. Synthesize L1 carrier frequencies f_k = 1602.0 MHz + k * 562.5 kHz for channels k in [-7, +6].
//   2. Advance 9-stage LFSR generating 511-chip standard accuracy (SP) maximal length sequence.
//   3. Apply 100 Hz Manchester / Meander sequence subcarrier bi-phase bit encoding.

pub type GlonassChannelConfig = struct {
    frequency_channel_k: Int, // Channel number: -7 .. +6
    nominal_l1_freq_mhz: Float,
    nominal_l2_freq_mhz: Float,
    lfsr_state: Int,          // 9-bit register
    chip_counter: Int,        // 0 .. 510
};

pub fn glonass_channel_config_new(channel_k: Int) -> GlonassChannelConfig {
    let k_f: Float = glonass_int_to_float(channel_k);
    let l1_freq: Float = 1602.0 + (k_f * 0.5625);
    let l2_freq: Float = 1246.0 + (k_f * 0.4375);

    return GlonassChannelConfig {
        frequency_channel_k: channel_k,
        nominal_l1_freq_mhz: l1_freq,
        nominal_l2_freq_mhz: l2_freq,
        lfsr_state: 511, // 0x1FF
        chip_counter: 0,
    };
}

pub fn glonass_step_prn_chip(cfg: &mut GlonassChannelConfig) -> Int {
    let reg: Int = (*cfg).lfsr_state;
    let out_chip: Int = (reg >> 6) & 1; // Bit 7 output

    // Feedback polynomial 1 + x^5 + x^9
    let fb: Int = ((reg >> 4) ^ (reg >> 8)) & 1;
    (*cfg).lfsr_state = ((reg << 1) & 510) | fb;

    (*cfg).chip_counter = (*cfg).chip_counter + 1;
    if (*cfg).chip_counter >= 511 {
        (*cfg).chip_counter = 0;
        (*cfg).lfsr_state = 511;
    }

    return out_chip;
}

pub fn glonass_meander_encode(data_bit: Int, meander_half_cycle: Int) -> Int {
    // Meander sequence: XOR data bit with 100 Hz square wave
    return (data_bit ^ meander_half_cycle) & 1;
}

pub fn glonass_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}
