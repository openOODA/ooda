// # Optical Inter-Satellite Link (ISL) Laser Budget
//
// Logline: Calculates Free-Space Optical (FSO) laser inter-satellite power budgets, telescope gains, and sensitivity.
//
// Setup: Pure optical satellite communication link budget calculation module.
//
// Beats:
//   1. Compute transmit and receive telescope optical gains G = (pi * D / lambda)^2.
//   2. Calculate free space optical geometric propagation loss (lambda / (4*pi*R))^2.
//   3. Evaluate received optical power (dBm), photodetector photons/bit, and margin.

pub type LaserIslBudget = struct {
    laser_power_tx_dbm: Float,    // E.g. +30 dBm (1.0 Watt)
    wavelength_nm: Float,         // E.g. 1550.0 nm (C-band) or 1064.0 nm (Nd:YAG)
    tx_telescope_dia_m: Float,    // E.g. 0.10 m (10 cm aperture)
    rx_telescope_dia_m: Float,    // E.g. 0.10 m
    isl_distance_km: Float,       // E.g. 2000 km (LEO-LEO) to 45000 km (GEO-GEO)
    optics_efficiency_tx: Float,  // E.g. 0.80
    optics_efficiency_rx: Float,  // E.g. 0.80
    data_rate_gbps: Float,        // E.g. 10.0 Gbps
    rx_sensitivity_dbm: Float,    // E.g. -42.0 dBm for coherent BPSK / APD
};

pub fn laser_isl_budget_default() -> LaserIslBudget {
    return LaserIslBudget {
        laser_power_tx_dbm: 30.0,
        wavelength_nm: 1550.0,
        tx_telescope_dia_m: 0.10,
        rx_telescope_dia_m: 0.10,
        isl_distance_km: 2500.0,
        optics_efficiency_tx: 0.85,
        optics_efficiency_rx: 0.85,
        data_rate_gbps: 10.0,
        rx_sensitivity_dbm: -38.0,
    };
}

pub fn laser_calc_telescope_gain_dbi(diameter_m: Float, wavelength_nm: Float, efficiency: Float) -> Float {
    let lambda_m: Float = wavelength_nm * 0.000000001; // 1e-9
    let pi_val: Float = 3.141592653589793;
    let factor: Float = (pi_val * diameter_m) / lambda_m;

    let ln10: Float = 2.302585092994046;
    let log_factor: Float = ln(factor) / ln10;
    let log_eff: Float = ln(efficiency) / ln10;

    return (20.0 * log_factor) + (10.0 * log_eff);
}

pub fn laser_calc_received_power_dbm(budget: &LaserIslBudget) -> Float {
    let g_tx: Float = laser_calc_telescope_gain_dbi((budget).tx_telescope_dia_m, (budget).wavelength_nm, (budget).optics_efficiency_tx);
    let g_rx: Float = laser_calc_telescope_gain_dbi((budget).rx_telescope_dia_m, (budget).wavelength_nm, (budget).optics_efficiency_rx);

    let lambda_m: Float = (budget).wavelength_nm * 0.000000001;
    let dist_m: Float = (budget).isl_distance_km * 1000.0;
    let pi_val: Float = 3.141592653589793;

    let ln10: Float = 2.302585092994046;
    let path_loss_linear: Float = (4.0 * pi_val * dist_m) / lambda_m;
    let fspl_opt_db: Float = 20.0 * (ln(path_loss_linear) / ln10);

    // P_rx = P_tx + G_tx + G_rx - FSPL
    return (((budget).laser_power_tx_dbm + g_tx) + g_rx) - fspl_opt_db;
}

pub fn laser_calc_link_margin_db(budget: &LaserIslBudget) -> Float {
    let p_rx: Float = laser_calc_received_power_dbm(budget);
    return p_rx - (budget).rx_sensitivity_dbm;
}
