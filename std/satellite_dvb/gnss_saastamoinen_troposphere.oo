// # GNSS Saastamoinen Tropospheric Delay Model
//
// Logline: Implements Saastamoinen hydrostatic and wet zenith delays with standard elevation mapping functions.
//
// Setup: Pure neutral atmospheric refraction model correcting GNSS signal tropospheric delays.
//
// Beats:
//   1. Calculate Zenith Hydrostatic Delay (ZHD) = 0.0022768 * P0 / (1 - 0.00266*cos(2*lat) - 0.00028*H).
//   2. Calculate Zenith Wet Delay (ZWD) = 0.002277 * (1255/T0 + 0.05) * e0 / f(lat, H).
//   3. Map zenith delays to slant path delay Delta_trop = (ZHD * m_h(elev)) + (ZWD * m_w(elev)).

pub type TroposphereWeather = struct {
    surface_pressure_hpa: Float,  // E.g. 1013.25 hPa
    surface_temp_k: Float,        // E.g. 288.15 K (15.0 C)
    water_vapor_pressure_hpa: Float, // E.g. 11.69 hPa
    station_height_km: Float,
    station_latitude_deg: Float
};

pub fn troposphere_weather_standard_atmosphere(height_km: Float, lat_deg: Float) -> TroposphereWeather {
    return TroposphereWeather {
        surface_pressure_hpa: 1013.25,
        surface_temp_k: 288.15,
        water_vapor_pressure_hpa: 11.69,
        station_height_km: height_km,
        station_latitude_deg: lat_deg
    };
}

pub fn saastamoinen_calc_zhd_m(w: &TroposphereWeather) -> Float {
    let pi_val: Float = 3.141592653589793;
    let lat_rad: Float = ((w).station_latitude_deg * pi_val) / 180.0;
    let cos_2lat: Float = cos(2.0 * lat_rad);
    let f_lat_h: Float = 1.0 - (0.00266 * cos_2lat) - (0.00028 * (w).station_height_km);

    // ZHD = 0.0022768 * P0 / f(lat, H)
    return (0.0022768 * (w).surface_pressure_hpa) / f_lat_h;
}

pub fn saastamoinen_calc_zwd_m(w: &TroposphereWeather) -> Float {
    let pi_val: Float = 3.141592653589793;
    let lat_rad: Float = ((w).station_latitude_deg * pi_val) / 180.0;
    let cos_2lat: Float = cos(2.0 * lat_rad);
    let f_lat_h: Float = 1.0 - (0.00266 * cos_2lat) - (0.00028 * (w).station_height_km);

    let temp_term: Float = (1255.0 / (w).surface_temp_k) + 0.05;
    // ZWD = 0.002277 * temp_term * e0 / f(lat, H)
    return (0.002277 * temp_term * (w).water_vapor_pressure_hpa) / f_lat_h;
}

pub fn saastamoinen_calc_slant_delay_m(w: &TroposphereWeather, sat_elevation_deg: Float) -> Float {
    let zhd: Float = saastamoinen_calc_zhd_m(w);
    let zwd: Float = saastamoinen_calc_zwd_m(w);

    let pi_val: Float = 3.141592653589793;
    let elev_rad: Float = (sat_elevation_deg * pi_val) / 180.0;
    let sin_elev: Float = sin(elev_rad);
    let mut sin_val: Float = sin_elev;
    if sin_val < 0.087 { sin_val = 0.087; } // Clamp at 5 degrees

    // Standard 1 / sin(elev) mapping function
    let map_factor: Float = 1.0 / sin_val;
    return (zhd + zwd) * map_factor;
}
