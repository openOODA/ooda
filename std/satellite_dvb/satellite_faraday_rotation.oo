// # Satellite Ionospheric Faraday Rotation & Polarization
//
// Logline: Calculates ionospheric Faraday rotation angle theta_F, TEC dependency, and polarization mismatch.
//
// Setup: Pure space environment electromagnetic propagation module for L-band and S-band satellite systems.
//
// Beats:
//   1. Compute rotation angle theta_F = (2.36e4 / f^2) * B_0 * cos(theta_B) * TEC.
//   2. Evaluate Cross-Polarization Discrimination (XPD) degradation in linearly polarized links.
//   3. Compute polarization mismatch loss (dB) for linear and circular antennas.

pub type FaradayRotationConfig = struct {
    carrier_freq_mhz: Float,
    geomagnetic_field_b0_tesla: Float, // E.g. 50e-6 Tesla (0.5 Gauss)
    angle_to_geomagnetic_field_deg: Float,
    total_electron_content_tec_units: Float, // TECU (1 TECU = 1e16 electrons/m^2, typical 10 .. 100)
    is_circular_polarized: Int,
};

pub fn faraday_rotation_config_default(freq_mhz: Float) -> FaradayRotationConfig {
    return FaradayRotationConfig {
        carrier_freq_mhz: freq_mhz,
        geomagnetic_field_b0_tesla: 0.000045, // 45 microTesla
        angle_to_geomagnetic_field_deg: 30.0,
        total_electron_content_tec_units: 30.0,
        is_circular_polarized: 0,
    };
}

pub fn faraday_calc_rotation_angle_deg(cfg: &FaradayRotationConfig) -> Float {
    let f_hz: Float = (cfg).carrier_freq_mhz * 1000000.0;
    let f_sq: Float = f_hz * f_hz;
    let b0: Float = (cfg).geomagnetic_field_b0_tesla;

    let pi_val: Float = 3.141592653589793;
    let theta_b_rad: Float = ((cfg).angle_to_geomagnetic_field_deg * pi_val) / 180.0;
    let cos_theta_b: Float = cos(theta_b_rad);

    let tec_electrons: Float = (cfg).total_electron_content_tec_units * 10000000000000000.0; // 1e16

    // theta_F (rad) = 2.36e4 * B_0 * cos(theta_B) * TEC / f^2
    let theta_f_rad: Float = ((23600.0 * b0 * cos_theta_b) / f_sq) * tec_electrons;
    let rad_to_deg: Float = 180.0 / pi_val;
    return theta_f_rad * rad_to_deg;
}

pub fn faraday_polarization_loss_db(cfg: &FaradayRotationConfig) -> Float {
    if (cfg).is_circular_polarized == 1 {
        // Circular polarization has 0 dB Faraday mismatch loss (only phase shift)
        return 0.0;
    }
    let rot_deg: Float = faraday_calc_rotation_angle_deg(cfg);
    let pi_val: Float = 3.141592653589793;
    let rot_rad: Float = (rot_deg * pi_val) / 180.0;
    let cos_val: Float = cos(rot_rad);
    let cos_sq: Float = cos_val * cos_val;

    if cos_sq < 0.00001 { return 40.0; } // Cross-polar null
    let ln10: Float = 2.302585092994046;
    return (0.0 - 10.0) * (ln(cos_sq) / ln10);
}
