// # Satellite Transponder Saleh Nonlinear HPA Model
//
// Logline: Implements the Saleh two-parameter nonlinear AM/AM and AM/PM transfer model for TWTA and SSPA.
//
// Setup: Pure RF nonlinear distortion model for satellite high-power amplifier simulation.
//
// Beats:
//   1. Compute amplitude distortion AM/AM F(r) = alpha_a * r / (1 + beta_a * r^2).
//   2. Compute phase distortion AM/PM Phi(r) = alpha_p * r^2 / (1 + beta_p * r^2).
//   3. Evaluate input/output back-off (IBO/OBO) operating points for intermodulation control.

pub type SalehHpaModel = struct {
    alpha_a: Float,          // AM/AM linear scale factor (typically 1.0 .. 2.0)
    beta_a: Float,           // AM/AM compression factor (typically 0.5 .. 1.0)
    alpha_p: Float,          // AM/PM conversion coefficient (typically 2.0 .. 4.0 rad)
    beta_p: Float,           // AM/PM saturation factor (typically 0.5 .. 1.5)
    input_backoff_db: Float // Operating IBO relative to saturation
};

pub fn saleh_twta_default() -> SalehHpaModel {
    return SalehHpaModel {
        alpha_a: 2.0,
        beta_a: 1.0,
        alpha_p: 4.0,        // Typical TWTA high phase shift ~ 45 to 60 deg
        beta_p: 9.1,
        input_backoff_db: 3.0
    };
}

pub fn saleh_sspa_default() -> SalehHpaModel {
    return SalehHpaModel {
        alpha_a: 1.0,
        beta_a: 0.25,
        alpha_p: 0.5,        // SSPA exhibits lower phase conversion
        beta_p: 0.5,
        input_backoff_db: 1.5
    };
}

pub fn saleh_am_am_gain(model: &SalehHpaModel, r_in: Float) -> Float {
    let r2: Float = r_in * r_in;
    return ((model).alpha_a * r_in) / (1.0 + ((model).beta_a * r2));
}

pub fn saleh_am_pm_phase(model: &SalehHpaModel, r_in: Float) -> Float {
    let r2: Float = r_in * r_in;
    return ((model).alpha_p * r2) / (1.0 + ((model).beta_p * r2));
}

pub fn saleh_distort_sample_re(model: &SalehHpaModel, in_re: Float, in_im: Float) -> Float {
    let r_in: Float = sqrt((in_re * in_re) + (in_im * in_im));
    if r_in < 0.000001 {
        return 0.0;
    }
    let r_out: Float = saleh_am_am_gain(model, r_in);
    let phi_shift: Float = saleh_am_pm_phase(model, r_in);

    // Initial phase angle + phi_shift
    let cos_p: Float = cos(phi_shift);
    let sin_p: Float = sin(phi_shift);
    let norm_re: Float = in_re / r_in;
    let norm_im: Float = in_im / r_in;

    let out_re_norm: Float = (norm_re * cos_p) - (norm_im * sin_p);
    return r_out * out_re_norm;
}

pub fn saleh_distort_sample_im(model: &SalehHpaModel, in_re: Float, in_im: Float) -> Float {
    let r_in: Float = sqrt((in_re * in_re) + (in_im * in_im));
    if r_in < 0.000001 {
        return 0.0;
    }
    let r_out: Float = saleh_am_am_gain(model, r_in);
    let phi_shift: Float = saleh_am_pm_phase(model, r_in);

    let cos_p: Float = cos(phi_shift);
    let sin_p: Float = sin(phi_shift);
    let norm_re: Float = in_re / r_in;
    let norm_im: Float = in_im / r_in;

    let out_im_norm: Float = (norm_re * sin_p) + (norm_im * cos_p);
    return r_out * out_im_norm;
}
