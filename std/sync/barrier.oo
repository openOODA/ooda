// # Cyclic Synchronization Barrier Module
//
// Logline: Cyclic synchronization barrier coordinating fixed cohorts of threads and fibers under ThreadCap.
//
// Setup: Coordinates simultaneous rendezvous of multiple tasks across generational epochs.
//
// Beats:
//   1. Construct Barrier with party threshold.
//   2. Wait / arrive at barrier point under ThreadCap.
//   3. Advance generational epoch when all parties arrive.
//   4. Reset and query barrier status.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type Barrier = struct {
    threshold: Int,
    arrived: Int,
    generation: Int
};

// Create a new cyclic Barrier with required participant threshold.
pub fn barrier_new(threshold: Int) -> Barrier {
    let mut thresh: Int = threshold;
    if thresh < 1 {
        thresh = 1;
    }
    return Barrier {
        threshold: thresh,
        arrived: 0,
        generation: 0
    };
}

// Return barrier participant threshold.
pub fn barrier_threshold(b: Barrier) -> Int {
    return b.threshold;
}

// Return number of arrived participants in current generation.
pub fn barrier_arrived(b: Barrier) -> Int {
    return b.arrived;
}

// Return current generation epoch number.
pub fn barrier_generation(b: Barrier) -> Int {
    return b.generation;
}

// Signal arrival of a participant; rolls generation when threshold is reached.
pub fn barrier_wait(thread: &ThreadCap, b: Barrier) -> Result[Barrier, String] {
    let arr: Int = b.arrived;
    let thresh: Int = b.threshold;
    let next_arr: Int = arr + 1;
    if next_arr >= thresh {
        let gen: Int = b.generation;
        let next_gen: Int = gen + 1;
        return Ok(Barrier {
            threshold: thresh,
            arrived: 0,
            generation: next_gen
        });
    }
    return Ok(Barrier {
        threshold: thresh,
        arrived: next_arr,
        generation: b.generation
    });
}

// Reset the barrier back to initial state under ThreadCap.
pub fn barrier_reset(thread: &ThreadCap, b: Barrier) -> Barrier {
    return Barrier {
        threshold: b.threshold,
        arrived: 0,
        generation: b.generation
    };
}
