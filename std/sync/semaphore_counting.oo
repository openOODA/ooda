// # Counting Semaphore Synchronization Module
//
// Logline: Counting semaphore with multi-permit acquire, non-blocking try_acquire, and permit release.
//
// Setup: Coordinates shared resource access and concurrency rate limiting under ThreadCap.
//
// Beats:
//   1. Construct CountingSemaphore with initial permits and maximum capacity.
//   2. Acquire permits with bounds check and capacity decrement.
//   3. Non-blocking try_acquire for optimistic acquisition.
//   4. Release permits back into the pool.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Blocking semaphore wait lowers to futex / sem_wait in host runtime.

import "std/result.oo";

type CountingSemaphore = struct {
    permits: Int,
    max_permits: Int
};

pub fn semaphore_new(initial_permits: Int, max_permits: Int) -> CountingSemaphore {
    return CountingSemaphore {
        permits: initial_permits,
        max_permits: max_permits
    };
}

pub fn semaphore_try_acquire(thread: &ThreadCap, sem: CountingSemaphore, count: Int) -> Result[CountingSemaphore, String] {
    let cur: Int = sem.permits;
    if cur < count {
        return Err("NO_PERMITS_AVAILABLE");
    }
    let updated: CountingSemaphore = CountingSemaphore {
        permits: cur - count,
        max_permits: sem.max_permits
    };
    return Ok(updated);
}

pub fn semaphore_release(thread: &ThreadCap, sem: CountingSemaphore, count: Int) -> CountingSemaphore {
    let cur: Int = sem.permits;
    let mut next_permits: Int = cur + count;
    let max_p: Int = sem.max_permits;
    if next_permits > max_p {
        next_permits = max_p;
    }
    return CountingSemaphore {
        permits: next_permits,
        max_permits: max_p
    };
}

pub fn semaphore_available(sem: CountingSemaphore) -> Int {
    return sem.permits;
}
