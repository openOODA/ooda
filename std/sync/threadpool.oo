// # Thread Pool Execution Engine
//
// Logline: Worker thread pool with task submission, active state tracking, and graceful shutdown under ThreadCap.
//
// Setup: Coordinates fixed cohorts of worker execution threads with bounded task queues.
//
// Beats:
//   1. Initialize thread pool with worker count.
//   2. Submit asynchronous work tasks under ThreadCap.
//   3. Track pending tasks and completed task statistics.
//   4. Gracefully terminate and shutdown thread pool under ThreadCap.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type ThreadPool = struct {
    num_workers: Int,
    queue_handle: String,
    is_active: Bool,
    tasks_submitted: Int,
    tasks_completed: Int
};

// Create and initialize a new ThreadPool with worker count under ThreadCap.
pub fn threadpool_new(thread: &ThreadCap, num_workers: Int) -> Result[ThreadPool, String] {
    if num_workers <= 0 {
        return Err("E_TP: worker count must be greater than 0");
    }
    let handle: String = "tp_queue_default";
    return Ok(ThreadPool {
        num_workers: num_workers,
        queue_handle: handle,
        is_active: true,
        tasks_submitted: 0,
        tasks_completed: 0
    });
}

// Submit a new task payload to the thread pool under ThreadCap.
pub fn threadpool_submit(
    thread: &ThreadCap,
    pool: ThreadPool,
    task_payload: String
) -> Result[ThreadPool, String] {
    let active: Bool = pool.is_active;
    if active == false {
        return Err("E_TP: cannot submit to shutdown threadpool");
    }
    let sub: Int = pool.tasks_submitted;
    let next_sub: Int = sub + 1;
    return Ok(ThreadPool {
        num_workers: pool.num_workers,
        queue_handle: pool.queue_handle,
        is_active: true,
        tasks_submitted: next_sub,
        tasks_completed: pool.tasks_completed
    });
}

// Mark a task as completed within the thread pool.
pub fn threadpool_complete_task(pool: ThreadPool) -> ThreadPool {
    let comp: Int = pool.tasks_completed;
    let next_comp: Int = comp + 1;
    return ThreadPool {
        num_workers: pool.num_workers,
        queue_handle: pool.queue_handle,
        is_active: pool.is_active,
        tasks_submitted: pool.tasks_submitted,
        tasks_completed: next_comp
    };
}

// Gracefully shutdown the thread pool under ThreadCap.
pub fn threadpool_shutdown(thread: &ThreadCap, pool: ThreadPool) -> ThreadPool {
    return ThreadPool {
        num_workers: pool.num_workers,
        queue_handle: pool.queue_handle,
        is_active: false,
        tasks_submitted: pool.tasks_submitted,
        tasks_completed: pool.tasks_completed
    };
}

// Return the configured number of worker threads.
pub fn threadpool_worker_count(pool: ThreadPool) -> Int {
    return pool.num_workers;
}

// True if the thread pool is currently active and accepting tasks.
pub fn threadpool_is_active(pool: ThreadPool) -> Bool {
    return pool.is_active;
}

// Return number of pending uncompleted tasks.
pub fn threadpool_pending(pool: ThreadPool) -> Int {
    let sub: Int = pool.tasks_submitted;
    let comp: Int = pool.tasks_completed;
    if sub > comp {
        return sub - comp;
    }
    return 0;
}
