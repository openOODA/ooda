// # Concurrent Atomic Bitset Module
//
// Logline: Thread-safe atomic bit array, lockless test-and-set bitwise operations, and population counting under ThreadCap.
//
// Setup: Coordinates lockless flag sets, concurrency markers, and bit-level tracking under ThreadCap token.
//
// Beats:
//   1. Construct AtomicBitSet word arrays with configurable bit capacity.
//   2. Atomic set, clear, and test operations on individual bit indices.
//   3. Atomic test-and-set (TAS) coordination primitive with conflict detection.
//   4. Population count (popcount) and word aggregation across the bitset.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware atomic fetch-and-or instructions lower via synchronization runtime.

import "std/result.oo";

type AtomicBitSet = struct {
    words: List[Int],
    num_bits: Int
};

pub fn atomic_bitset_new(bits: Int) -> AtomicBitSet {
    let mut total_bits: Int = bits;
    if total_bits <= 0 {
        total_bits = 64;
    }
    let num_words: Int = (total_bits + 63) / 64;
    let mut ws: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_words {
        ws = list_push(ws, 0);
        i = i + 1;
    }
    return AtomicBitSet {
        words: ws,
        num_bits: total_bits
    };
}

pub fn atomic_bitset_size(bs: AtomicBitSet) -> Int {
    return bs.num_bits;
}

pub fn atomic_bitset_test(
    thread: &ThreadCap,
    bs: AtomicBitSet,
    bit: Int
) -> Bool {
    let max_b: Int = bs.num_bits;
    if bit < 0 || bit >= max_b {
        return false;
    }
    let word_idx: Int = bit / 64;
    let bit_offset: Int = bit % 64;
    let cur_word: Int = list_get(bs.words, word_idx);
    let shifted: Int = cur_word >> bit_offset;
    return (shifted & 1) == 1;
}

fn atomic_bitset_set_word(ws: List[Int], idx: Int, val: Int, n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            out = list_push(out, val);
        } else {
            out = list_push(out, list_get(ws, i));
        }
        i = i + 1;
    }
    return out;
}

pub fn atomic_bitset_set(
    thread: &ThreadCap,
    bs: AtomicBitSet,
    bit: Int
) -> AtomicBitSet {
    let max_b: Int = bs.num_bits;
    if bit < 0 || bit >= max_b {
        return bs;
    }
    let word_idx: Int = bit / 64;
    let bit_offset: Int = bit % 64;
    let mask: Int = 1 << bit_offset;

    let num_words: Int = list_len(bs.words);
    let cur_word: Int = list_get(bs.words, word_idx);
    let updated_word: Int = cur_word | mask;
    let new_words: List[Int] = atomic_bitset_set_word(bs.words, word_idx, updated_word, num_words);

    return AtomicBitSet {
        words: new_words,
        num_bits: max_b
    };
}

pub fn atomic_bitset_clear(
    thread: &ThreadCap,
    bs: AtomicBitSet,
    bit: Int
) -> AtomicBitSet {
    let max_b: Int = bs.num_bits;
    if bit < 0 || bit >= max_b {
        return bs;
    }
    let word_idx: Int = bit / 64;
    let bit_offset: Int = bit % 64;
    let mask: Int = 1 << bit_offset;

    let num_words: Int = list_len(bs.words);
    let cur_word: Int = list_get(bs.words, word_idx);
    let updated_word: Int = (cur_word | mask) - mask;
    let new_words: List[Int] = atomic_bitset_set_word(bs.words, word_idx, updated_word, num_words);

    return AtomicBitSet {
        words: new_words,
        num_bits: max_b
    };
}

// Atomic test-and-set. Returns Err("already_set") if bit was already 1.
pub fn atomic_bitset_test_and_set(
    thread: &ThreadCap,
    bs: AtomicBitSet,
    bit: Int
) -> Result[AtomicBitSet, String] {
    let was_set: Bool = atomic_bitset_test(thread, bs, bit);
    if was_set {
        return Err("already_set");
    }
    let updated: AtomicBitSet = atomic_bitset_set(thread, bs, bit);
    return Ok(updated);
}

fn word_popcount(w: Int) -> Int {
    let mut cur: Int = w;
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < 64 {
        if (cur & 1) == 1 {
            count = count + 1;
        }
        cur = cur >> 1;
        i = i + 1;
    }
    return count;
}

pub fn atomic_bitset_count_ones(bs: AtomicBitSet) -> Int {
    let mut total: Int = 0;
    let n: Int = list_len(bs.words);
    let mut i: Int = 0;
    while i < n {
        let w: Int = list_get(bs.words, i);
        total = total + word_popcount(w);
        i = i + 1;
    }
    return total;
}
