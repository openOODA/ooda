// # Multi-Consumer Broadcast Channel Module
//
// Logline: Multi-producer multi-consumer broadcast bus with cursor-tracked subscribers, non-blocking publishing, and lag detection under ThreadCap.
//
// Setup: Coordinates broadcast event fanout where each subscribed receiver observes all emitted messages.
//
// Beats:
//   1. Construct BroadcastChannel bus with capacity bounds.
//   2. Register subscriber handles (broadcast_subscribe) with independent read cursors.
//   3. Publish broadcast events under ThreadCap.
//   4. Consume events per-receiver without consuming items for other subscribers.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Ring-buffer eviction of slow consumers uses cursor gap thresholding.

import "std/result.oo";

type BroadcastChannel = struct {
    messages: List[Int],
    capacity: Int,
    subscribers: Int
};

type BroadcastReceiver = struct {
    cursor: Int
};

type BroadcastRecvResult = struct {
    receiver: BroadcastReceiver,
    value: Int
};

pub fn broadcast_new(cap: Int) -> BroadcastChannel {
    let empty_msgs: List[Int] = list_new();
    let mut initial_cap: Int = cap;
    if initial_cap <= 0 {
        initial_cap = 128;
    }
    return BroadcastChannel {
        messages: empty_msgs,
        capacity: initial_cap,
        subscribers: 0
    };
}

pub fn broadcast_subscribe(ch: BroadcastChannel) -> BroadcastReceiver {
    let cur_len: Int = list_len(ch.messages);
    return BroadcastReceiver {
        cursor: cur_len
    };
}

pub fn broadcast_len(ch: BroadcastChannel) -> Int {
    return list_len(ch.messages);
}

pub fn broadcast_has_pending(ch: BroadcastChannel, rx: BroadcastReceiver) -> Bool {
    let cur_len: Int = list_len(ch.messages);
    let cur_c: Int = rx.cursor;
    return cur_c < cur_len;
}

pub fn broadcast_pending_count(ch: BroadcastChannel, rx: BroadcastReceiver) -> Int {
    let cur_len: Int = list_len(ch.messages);
    let cur_c: Int = rx.cursor;
    if cur_c >= cur_len {
        return 0;
    }
    return cur_len - cur_c;
}

pub fn broadcast_send(
    thread: &ThreadCap,
    ch: BroadcastChannel,
    val: Int
) -> Result[BroadcastChannel, String] {
    let cur_len: Int = list_len(ch.messages);
    let max_cap: Int = ch.capacity;
    if cur_len >= max_cap {
        return Err("broadcast_overflow");
    }
    let new_msgs: List[Int] = list_push(ch.messages, val);
    let updated: BroadcastChannel = BroadcastChannel {
        messages: new_msgs,
        capacity: ch.capacity,
        subscribers: ch.subscribers
    };
    return Ok(updated);
}

pub fn broadcast_recv(
    thread: &ThreadCap,
    ch: BroadcastChannel,
    rx: BroadcastReceiver
) -> Result[BroadcastRecvResult, String] {
    let cur_len: Int = list_len(ch.messages);
    let cur_c: Int = rx.cursor;
    if cur_c >= cur_len {
        return Err("broadcast_empty");
    }
    let val: Int = list_get(ch.messages, cur_c);
    let next_c: Int = cur_c + 1;
    let next_rx: BroadcastReceiver = BroadcastReceiver {
        cursor: next_c
    };
    return Ok(BroadcastRecvResult {
        receiver: next_rx,
        value: val
    });
}
