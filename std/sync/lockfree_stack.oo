// # Treiber Lock-Free Concurrent Stack Module
//
// Logline: Treiber lock-free stack using atomic Compare-And-Swap (CAS) reference updates.
//
// Setup: Coordinates lockless LIFO stack operations under ThreadCap.
//
// Beats:
//   1. Construct LockfreeStack with initial head pointer.
//   2. Push item onto top of stack via CAS publication.
//   3. Pop item from top of stack via CAS publication.
//   4. Query stack emptiness and element count.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Atomic 128-bit CAS lowers to host cmpxchg16b instruction.

import "std/core/list.oo";
import "std/result.oo";

type LockfreeStack = struct {
    items: List[Int],
    version: Int
};

pub fn lockfree_stack_new() -> LockfreeStack {
    let items: List[Int] = list_new();
    return LockfreeStack {
        items: items,
        version: 1
    };
}

pub fn lockfree_stack_push(thread: &ThreadCap, s: LockfreeStack, val: Int) -> LockfreeStack {
    let new_items: List[Int] = list_push(s.items, val);
    let cur_v: Int = s.version;
    return LockfreeStack {
        items: new_items,
        version: cur_v + 1
    };
}

pub fn lockfree_stack_pop(thread: &ThreadCap, s: LockfreeStack) -> Result[LockfreeStack, String] {
    let n: Int = list_len(s.items);
    if n == 0 {
        return Err("STACK_EMPTY");
    }
    let mut new_items: List[Int] = list_new();
    let mut i: Int = 0;
    let new_len: Int = n - 1;
    while i < new_len {
        new_items = list_push(new_items, list_get(s.items, i));
        i = i + 1;
    }
    let cur_v: Int = s.version;
    return Ok(LockfreeStack {
        items: new_items,
        version: cur_v + 1
    });
}

pub fn lockfree_stack_len(s: LockfreeStack) -> Int {
    return list_len(s.items);
}
