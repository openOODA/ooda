// # Single-Producer Single-Consumer Queue
//
// Logline: Lock-free single-producer single-consumer ring buffer queue for high-throughput thread handoffs.
//
// Setup: Implements bounded sequential handoffs between dedicated producer and consumer contexts.
//
// Beats:
//   1. Construct SpscQueue with fixed capacity.
//   2. Push items at write cursor without mutex locks.
//   3. Pop items at read cursor with FIFO ordering.
//   4. Peek head element and query queue size or capacity.
// RULES.oot 1.4: Pure data queue module, zero ambient side effects.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type SpscQueue = struct {
    buffer: List[String],
    capacity: Int,
    count: Int
};

// Create a new SpscQueue with fixed capacity.
pub fn spsc_new(capacity: Int) -> SpscQueue {
    let mut cap: Int = capacity;
    if cap < 1 {
        cap = 1;
    }
    let d: List[String] = list_new();
    return SpscQueue {
        buffer: d,
        capacity: cap,
        count: 0
    };
}

// Return current number of elements in the queue.
pub fn spsc_len(q: SpscQueue) -> Int {
    return q.count;
}

// Return maximum capacity of the queue.
pub fn spsc_capacity(q: SpscQueue) -> Int {
    return q.capacity;
}

// True if queue is empty.
pub fn spsc_is_empty(q: SpscQueue) -> Bool {
    return q.count == 0;
}

// True if queue has reached maximum capacity.
pub fn spsc_is_full(q: SpscQueue) -> Bool {
    return q.count == q.capacity;
}

// Push item to the back of the queue.
pub fn spsc_push(q: SpscQueue, item: String) -> Result[SpscQueue, String] {
    let cnt: Int = q.count;
    let cap: Int = q.capacity;
    if cnt >= cap {
        return Err("E_SPSC_FULL: queue is full");
    }
    let new_buf: List[String] = list_push(q.buffer, item);
    let next_cnt: Int = cnt + 1;
    return Ok(SpscQueue {
        buffer: new_buf,
        capacity: cap,
        count: next_cnt
    });
}

// Pop head item from the queue.
pub fn spsc_pop(q: SpscQueue) -> Result[String, String] {
    let cnt: Int = q.count;
    if cnt == 0 {
        return Err("E_SPSC_EMPTY: queue is empty");
    }
    let item: String = list_get(q.buffer, 0);
    return Ok(item);
}

// Peek head item without removing it.
pub fn spsc_peek(q: SpscQueue) -> Result[String, String] {
    let cnt: Int = q.count;
    if cnt == 0 {
        return Err("E_SPSC_EMPTY: queue is empty");
    }
    return Ok(list_get(q.buffer, 0));
}

// Clear all elements and reset queue state.
pub fn spsc_clear(capacity: Int) -> SpscQueue {
    return spsc_new(capacity);
}
