// # Cyclic Barrier Synchronization Primitive Module
//
// Logline: Reusable cyclic barrier coordinating a fixed number of participating threads per generation.
//
// Setup: Coordinates lockless multi-thread rendezvous and generation rollover under ThreadCap.
//
// Beats:
//   1. Construct CyclicBarrier with total expected participants.
//   2. Threads arrive and wait at the current generation rendezvous.
//   3. Last arriving thread triggers generation advance and resets arrival count.
//   4. Broken barrier detection and generation tracking.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Futex-backed blocking lowers to kernel futex primitives.

type CyclicBarrier = struct {
    parties: Int,
    arrived: Int,
    generation: Int,
    is_broken: Bool
};

pub fn cyclic_barrier_new(parties: Int) -> CyclicBarrier {
    let mut p: Int = parties;
    if p < 1 { p = 1; }
    return CyclicBarrier {
        parties: p,
        arrived: 0,
        generation: 1,
        is_broken: false
    };
}

pub fn cyclic_barrier_arrive(thread: &ThreadCap, barrier: CyclicBarrier) -> CyclicBarrier {
    let cur_arr: Int = barrier.arrived;
    let next_arr: Int = cur_arr + 1;
    let req: Int = barrier.parties;
    if next_arr >= req {
        let cur_gen: Int = barrier.generation;
        return CyclicBarrier {
            parties: req,
            arrived: 0,
            generation: cur_gen + 1,
            is_broken: false
        };
    }
    return CyclicBarrier {
        parties: req,
        arrived: next_arr,
        generation: barrier.generation,
        is_broken: barrier.is_broken
    };
}

pub fn cyclic_barrier_break(thread: &ThreadCap, barrier: CyclicBarrier) -> CyclicBarrier {
    return CyclicBarrier {
        parties: barrier.parties,
        arrived: barrier.arrived,
        generation: barrier.generation,
        is_broken: true
    };
}

pub fn cyclic_barrier_is_broken(barrier: CyclicBarrier) -> Bool {
    return barrier.is_broken;
}
