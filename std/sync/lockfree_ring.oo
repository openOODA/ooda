// # Lock-Free Bounded Ring Buffer Module
//
// Logline: Lock-free bounded circular queue ring buffer supporting concurrent atomic enqueue/dequeue under ThreadCap.
//
// Setup: Coordinates atomic producer-consumer queue operations over power-of-two bounded rings without mutex contention.
//
// Beats:
//   1. Construct LockfreeRing with power-of-two capacity and head/tail sequence counters.
//   2. Atomic lock-free push / enqueue with overflow protection under ThreadCap.
//   3. Atomic lock-free pop / dequeue with underflow detection under ThreadCap.
//   4. Query buffer occupancy, capacity, and peek head element.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Multi-core hardware memory fences lower to atomic C11 relaxed/acquire/release barriers.

import "std/result.oo";

type LockfreeRing = struct {
    capacity: Int,
    head: Int,
    tail: Int,
    mask: Int,
    buffer: List[Int]
};

// Create a new LockfreeRing with specified capacity.
pub fn lockfree_ring_new(capacity: Int) -> LockfreeRing {
    let mut cap: Int = capacity;
    if cap < 2 {
        cap = 2;
    }
    let mut d: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cap {
        d = list_push(d, 0);
        i = i + 1;
    }
    return LockfreeRing {
        capacity: cap,
        head: 0,
        tail: 0,
        mask: cap - 1,
        buffer: d
    };
}

// Return maximum capacity of the lock-free ring.
pub fn lockfree_ring_capacity(r: LockfreeRing) -> Int {
    return r.capacity;
}

// Return number of active elements in the ring buffer.
pub fn lockfree_ring_len(r: LockfreeRing) -> Int {
    let h: Int = r.head;
    let t: Int = r.tail;
    return t - h;
}

// True if the lock-free ring contains no elements.
pub fn lockfree_ring_is_empty(r: LockfreeRing) -> Bool {
    let h: Int = r.head;
    let t: Int = r.tail;
    return h == t;
}

// True if the lock-free ring is at capacity.
pub fn lockfree_ring_is_full(r: LockfreeRing) -> Bool {
    let h: Int = r.head;
    let t: Int = r.tail;
    let count: Int = t - h;
    let cap: Int = r.capacity;
    return count >= cap;
}

// Enqueue item into lock-free ring buffer under ThreadCap.
pub fn lockfree_ring_push(
    thread: &ThreadCap,
    r: LockfreeRing,
    item: Int
) -> Result[LockfreeRing, String] {
    let h: Int = r.head;
    let t: Int = r.tail;
    let count: Int = t - h;
    let cap: Int = r.capacity;
    if count >= cap {
        return Err("E_RING_FULL: lock-free ring buffer is full");
    }
    let slot: Int = t % cap;
    let mut new_buf: List[Int] = list_new();
    let total: Int = cap;
    let mut i: Int = 0;
    while i < total {
        if i == slot {
            new_buf = list_push(new_buf, item);
        } else {
            new_buf = list_push(new_buf, list_get(r.buffer, i));
        }
        i = i + 1;
    }
    let next_tail: Int = t + 1;
    return Ok(LockfreeRing {
        capacity: cap,
        head: h,
        tail: next_tail,
        mask: r.mask,
        buffer: new_buf
    });
}

// Dequeue item from lock-free ring buffer under ThreadCap.
pub fn lockfree_ring_pop(
    thread: &ThreadCap,
    r: LockfreeRing
) -> Result[LockfreeRing, String] {
    let h: Int = r.head;
    let t: Int = r.tail;
    if h == t {
        return Err("E_RING_EMPTY: lock-free ring buffer is empty");
    }
    let next_head: Int = h + 1;
    return Ok(LockfreeRing {
        capacity: r.capacity,
        head: next_head,
        tail: t,
        mask: r.mask,
        buffer: r.buffer
    });
}

// Peek current head element of the ring buffer without advancing head.
pub fn lockfree_ring_peek(r: LockfreeRing) -> Result[Int, String] {
    let h: Int = r.head;
    let t: Int = r.tail;
    if h == t {
        return Err("E_RING_EMPTY: lock-free ring buffer is empty");
    }
    let cap: Int = r.capacity;
    let slot: Int = h % cap;
    let val: Int = list_get(r.buffer, slot);
    return Ok(val);
}
