// # Actor Supervisor Hierarchy and Restart Strategy Module
//
// Logline: Supervision trees managing actor failure recovery with OneForOne and AllForOne restart strategies.
//
// Setup: Coordinates actor fault tolerance and restart budgets under ThreadCap.
//
// Beats:
//   1. Define ActorSupervisor strategy and restart limits.
//   2. Register child actor cells with supervisor registry.
//   3. Handle child failure and evaluate restart threshold.
//   4. Escalate unrecoverable failure to parent supervisor.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Multi-node supervision lowers to cluster manager.

import "std/core/list.oo";
import "std/result.oo";

type ActorSupervisor = struct {
    strategy: Int, // 0: OneForOne, 1: OneForAll
    max_restarts: Int,
    current_restarts: Int,
    children_ids: List[Int]
};

pub fn actor_sup_create(strategy: Int, max_restarts: Int) -> ActorSupervisor {
    let kids: List[Int] = list_new();
    return ActorSupervisor {
        strategy: strategy,
        max_restarts: max_restarts,
        current_restarts: 0,
        children_ids: kids
    };
}

pub fn actor_sup_add_child(sup: ActorSupervisor, child_id: Int) -> ActorSupervisor {
    let new_kids: List[Int] = list_push(sup.children_ids, child_id);
    return ActorSupervisor {
        strategy: sup.strategy,
        max_restarts: sup.max_restarts,
        current_restarts: sup.current_restarts,
        children_ids: new_kids
    };
}

pub fn actor_sup_handle_failure(thread: &ThreadCap, sup: ActorSupervisor, child_id: Int) -> Result[ActorSupervisor, String] {
    let cur_r: Int = sup.current_restarts;
    let max_r: Int = sup.max_restarts;
    if cur_r >= max_r {
        return Err("ESCALATE_TO_PARENT_SUPERVISOR");
    }
    let next_r: Int = cur_r + 1;
    let updated: ActorSupervisor = ActorSupervisor {
        strategy: sup.strategy,
        max_restarts: sup.max_restarts,
        current_restarts: next_r,
        children_ids: sup.children_ids
    };
    return Ok(updated);
}

pub fn actor_sup_reset_restarts(thread: &ThreadCap, sup: ActorSupervisor) -> ActorSupervisor {
    return ActorSupervisor {
        strategy: sup.strategy,
        max_restarts: sup.max_restarts,
        current_restarts: 0,
        children_ids: sup.children_ids
    };
}
