// # Thread-Safe Message Channel Module
//
// Logline: Safe bounded message channels for asynchronous producer-consumer coordination under ThreadCap.
//
// Setup: Bridges native POSIX mutex/condvar ring buffers with structured handle and result semantics.
//
// Beats:
//   1. Allocate bounded channel slot under ThreadCap.
//   2. Send message into channel ring buffer using channel handle.
//   3. Non-blocking recv message with Result semantics.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";
import "std/str.oo";

// Create a new bounded message channel slot and return handle (e.g. "ch:0").
pub fn channel_create(tc: &ThreadCap) -> Result[String, String] {
    return channel_new(tc);
}

// Push message onto bounded channel queue.
pub fn channel_push(tc: &ThreadCap, handle: String, msg: String) -> Result[String, String] {
    if !handle.contains("ch:") {
        return Err("E_CH: invalid channel handle");
    }
    let slot_str: String = str_slice(handle, 3, chars_len(handle));
    let slot: Int = parse_int(slot_str);
    return channel_send(tc, slot, msg);
}

// Pop message from bounded channel queue (non-blocking).
pub fn channel_pop(tc: &ThreadCap, handle: String) -> Result[String, String] {
    if !handle.contains("ch:") {
        return Err("E_CH: invalid channel handle");
    }
    let slot_str: String = str_slice(handle, 3, chars_len(handle));
    let slot: Int = parse_int(slot_str);
    return channel_recv(tc, slot);
}

// Pop message or return default if empty.
pub fn channel_try_pop(tc: &ThreadCap, handle: String, default_msg: String) -> String {
    let r: Result[String, String] = channel_pop(tc, handle);
    return res_unwrap_or(r, default_msg);
}
