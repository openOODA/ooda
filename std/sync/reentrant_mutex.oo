// # Reentrant Recursive Mutex Synchronization Module
//
// Logline: Recursive mutex tracking owner thread ID and recursion lock depth.
//
// Setup: Allows the same thread to acquire a mutex multiple times without deadlock under ThreadCap.
//
// Beats:
//   1. Construct unlocked ReentrantMutex.
//   2. Lock mutex (acquires on first lock, increments recursion depth if same owner).
//   3. Try-lock for non-blocking acquisition.
//   4. Unlock mutex (decrements recursion depth, releases when depth reaches zero).
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Reentrant pthread_mutex lowers to host POSIX mutex.

import "std/result.oo";

type ReentrantMutex = struct {
    owner_id: Int,
    depth: Int
};

pub fn reentrant_mutex_new() -> ReentrantMutex {
    return ReentrantMutex {
        owner_id: 0,
        depth: 0
    };
}

pub fn reentrant_mutex_try_lock(thread: &ThreadCap, mtx: ReentrantMutex, thread_id: Int) -> Result[ReentrantMutex, String] {
    let cur_depth: Int = mtx.depth;
    let cur_owner: Int = mtx.owner_id;
    if cur_depth == 0 {
        return Ok(ReentrantMutex {
            owner_id: thread_id,
            depth: 1
        });
    }
    if cur_owner == thread_id {
        return Ok(ReentrantMutex {
            owner_id: thread_id,
            depth: cur_depth + 1
        });
    }
    return Err("MUTEX_HELD_BY_OTHER_THREAD");
}

pub fn reentrant_mutex_unlock(thread: &ThreadCap, mtx: ReentrantMutex, thread_id: Int) -> Result[ReentrantMutex, String] {
    let cur_depth: Int = mtx.depth;
    let cur_owner: Int = mtx.owner_id;
    if cur_depth == 0 || cur_owner != thread_id {
        return Err("UNLOCK_NOT_OWNED");
    }
    let next_depth: Int = cur_depth - 1;
    if next_depth == 0 {
        return Ok(ReentrantMutex {
            owner_id: 0,
            depth: 0
        });
    }
    return Ok(ReentrantMutex {
        owner_id: thread_id,
        depth: next_depth
    });
}
