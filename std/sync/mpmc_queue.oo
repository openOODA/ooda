// # Multi-Producer Multi-Consumer Concurrent Queue
//
// Logline: Bounded FIFO concurrent queue for multi-producer multi-consumer worker coordination under ThreadCap.
//
// Setup: Coordinates safe bounded buffer insertion and extraction across concurrent worker tasks.
//
// Beats:
//   1. Construct MpmcQueue with maximum capacity.
//   2. Push items onto queue under ThreadCap with bounds checking.
//   3. Pop items from queue under ThreadCap with FIFO ordering.
//   4. Query queue capacity, size, fullness, and emptiness.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type MpmcQueue = struct {
    items: List[String],
    capacity: Int,
    count: Int
};

// Create a new MpmcQueue with fixed capacity.
pub fn mpmc_new(capacity: Int) -> MpmcQueue {
    let mut cap: Int = capacity;
    if cap < 1 {
        cap = 1;
    }
    let d: List[String] = list_new();
    return MpmcQueue {
        items: d,
        capacity: cap,
        count: 0
    };
}

// Return current number of elements in the queue.
pub fn mpmc_len(q: MpmcQueue) -> Int {
    return q.count;
}

// Return maximum capacity of the queue.
pub fn mpmc_capacity(q: MpmcQueue) -> Int {
    return q.capacity;
}

// True if the queue is empty.
pub fn mpmc_is_empty(q: MpmcQueue) -> Bool {
    return q.count == 0;
}

// True if the queue has reached capacity.
pub fn mpmc_is_full(q: MpmcQueue) -> Bool {
    return q.count == q.capacity;
}

// Push item to the back of the queue under ThreadCap.
pub fn mpmc_push(
    thread: &ThreadCap,
    q: MpmcQueue,
    item: String
) -> Result[MpmcQueue, String] {
    let cnt: Int = q.count;
    let cap: Int = q.capacity;
    if cnt >= cap {
        return Err("E_MPMC_FULL: queue is full");
    }
    let new_items: List[String] = list_push(q.items, item);
    let next_cnt: Int = cnt + 1;
    return Ok(MpmcQueue {
        items: new_items,
        capacity: cap,
        count: next_cnt
    });
}

// Pop front item from the queue under ThreadCap.
pub fn mpmc_pop(thread: &ThreadCap, q: MpmcQueue) -> Result[String, String] {
    let cnt: Int = q.count;
    if cnt == 0 {
        return Err("E_MPMC_EMPTY: queue is empty");
    }
    let item: String = list_get(q.items, 0);
    return Ok(item);
}

// Pop front element or fallback to default value.
pub fn mpmc_try_pop(
    thread: &ThreadCap,
    q: MpmcQueue,
    default_val: String
) -> String {
    let r: Result[String, String] = mpmc_pop(thread, q);
    return res_unwrap_or(r, default_val);
}
