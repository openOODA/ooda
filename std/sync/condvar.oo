// # Condition Variable Synchronization Module
//
// Logline: Condition variable synchronization primitive for signaling and broadcasting thread state changes under ThreadCap.
//
// Setup: Coordinates thread sleep and notification signaling associated with mutex identifiers.
//
// Beats:
//   1. Construct Condvar with unique descriptor ID.
//   2. Wait on condition variable under ThreadCap and associated mutex.
//   3. Signal one waiting thread to wake under ThreadCap.
//   4. Broadcast signal to all waiting threads under ThreadCap.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type Condvar = struct {
    id: Int,
    wait_count: Int,
    signaled: Bool
};

// Create a new Condvar instance.
pub fn condvar_new(id: Int) -> Condvar {
    return Condvar {
        id: id,
        wait_count: 0,
        signaled: false
    };
}

// Wait on condition variable associated with mutex_id under ThreadCap.
pub fn condvar_wait(
    thread: &ThreadCap,
    cv: Condvar,
    mutex_id: Int
) -> Result[Condvar, String] {
    if mutex_id < 0 {
        return Err("E_CV_INVALID_MUTEX: mutex_id must be non-negative");
    }
    let wc: Int = cv.wait_count;
    let next_wc: Int = wc + 1;
    return Ok(Condvar {
        id: cv.id,
        wait_count: next_wc,
        signaled: false
    });
}

// Signal one waiting thread on this condition variable under ThreadCap.
pub fn condvar_signal(thread: &ThreadCap, cv: Condvar) -> Condvar {
    let wc: Int = cv.wait_count;
    if wc <= 0 {
        return Condvar {
            id: cv.id,
            wait_count: 0,
            signaled: true
        };
    }
    let next_wc: Int = wc - 1;
    return Condvar {
        id: cv.id,
        wait_count: next_wc,
        signaled: true
    };
}

// Broadcast signal to all waiting threads under ThreadCap.
pub fn condvar_broadcast(thread: &ThreadCap, cv: Condvar) -> Condvar {
    return Condvar {
        id: cv.id,
        wait_count: 0,
        signaled: true
    };
}

// Return current number of waiting threads.
pub fn condvar_wait_count(cv: Condvar) -> Int {
    return cv.wait_count;
}

// True if condition variable received a signal.
pub fn condvar_is_signaled(cv: Condvar) -> Bool {
    return cv.signaled;
}
