// # Cooperative Fiber Execution Context
//
// Logline: User-space lightweight cooperative coroutines and stackless fiber execution units under ThreadCap.
//
// Setup: Bridges cooperative scheduling primitives with safe state transitions (Runnable, Suspended, Terminated).
//
// Beats:
//   1. Allocate and initialize fiber context with payload and identifier.
//   2. Query fiber state (is_runnable, is_suspended, is_terminated).
//   3. Transition fiber state on yield, resume, and terminate.
//   4. Execute step progression under ThreadCap.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required for execution steps.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type FiberState = struct {
    id: Int,
    name: String,
    status: String,
    yield_count: Int,
    payload: String
};

// Create a new fiber in RUNNABLE state.
pub fn fiber_create(id: Int, name: String, payload: String) -> FiberState {
    return FiberState {
        id: id,
        name: name,
        status: "RUNNABLE",
        yield_count: 0,
        payload: payload
    };
}

// True if fiber is in RUNNABLE status.
pub fn fiber_is_runnable(f: FiberState) -> Bool {
    return f.status == "RUNNABLE";
}

// True if fiber is in SUSPENDED status.
pub fn fiber_is_suspended(f: FiberState) -> Bool {
    return f.status == "SUSPENDED";
}

// True if fiber is in TERMINATED status.
pub fn fiber_is_terminated(f: FiberState) -> Bool {
    return f.status == "TERMINATED";
}

// Yield execution from current fiber, marking it SUSPENDED.
pub fn fiber_yield(f: FiberState, val: String) -> FiberState {
    let yc: Int = f.yield_count;
    let next_yc: Int = yc + 1;
    return FiberState {
        id: f.id,
        name: f.name,
        status: "SUSPENDED",
        yield_count: next_yc,
        payload: val
    };
}

// Resume a suspended fiber back to RUNNABLE status.
pub fn fiber_resume(f: FiberState, arg: String) -> Result[FiberState, String] {
    if f.status == "TERMINATED" {
        return Err("E_FIBER: cannot resume terminated fiber");
    }
    return Ok(FiberState {
        id: f.id,
        name: f.name,
        status: "RUNNABLE",
        yield_count: f.yield_count,
        payload: arg
    });
}

// Terminate a fiber with final result payload.
pub fn fiber_terminate(f: FiberState, result: String) -> FiberState {
    return FiberState {
        id: f.id,
        name: f.name,
        status: "TERMINATED",
        yield_count: f.yield_count,
        payload: result
    };
}

// Advance fiber execution by one step under ThreadCap.
pub fn fiber_step(thread: &ThreadCap, f: FiberState) -> FiberState {
    if f.status != "RUNNABLE" {
        return f;
    }
    let yc: Int = f.yield_count;
    let next_yc: Int = yc + 1;
    return FiberState {
        id: f.id,
        name: f.name,
        status: "SUSPENDED",
        yield_count: next_yc,
        payload: f.payload
    };
}
