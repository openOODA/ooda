// # RCU Lock-Free Linked List Module
//
// Logline: Read-Copy-Update concurrent linked list supporting concurrent lockless readers and atomic writers.
//
// Setup: Implements generational node swapping and list traversal under ThreadCap.
//
// Beats:
//   1. Construct RcuList with root version and node count.
//   2. Insert element at head via atomic reference publication.
//   3. Lockless read traversal across current generation.
//   4. Retire old generations after grace period.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: QSBR epoch tracking lowers to thread quiescence collector.

import "std/core/list.oo";

type RcuList = struct {
    nodes: List[Int],
    generation: Int
};

pub fn rcu_list_new() -> RcuList {
    let nodes: List[Int] = list_new();
    return RcuList {
        nodes: nodes,
        generation: 1
    };
}

pub fn rcu_list_prepend(thread: &ThreadCap, list: RcuList, val: Int) -> RcuList {
    let mut new_nodes: List[Int] = list_new();
    new_nodes = list_push(new_nodes, val);
    let n: Int = list_len(list.nodes);
    let mut i: Int = 0;
    while i < n {
        new_nodes = list_push(new_nodes, list_get(list.nodes, i));
        i = i + 1;
    }
    let cur_gen: Int = list.generation;
    return RcuList {
        nodes: new_nodes,
        generation: cur_gen + 1
    };
}

pub fn rcu_list_len(list: RcuList) -> Int {
    return list_len(list.nodes);
}
