// # Reader-Writer Lock Module
//
// Logline: Shared-read and exclusive-write synchronization lock under ThreadCap.
//
// Setup: Coordinates concurrent readers and mutual exclusion for writers under ThreadCap.
//
// Beats:
//   1. Construct RwLock with identifier and name.
//   2. Acquire and release shared read locks.
//   3. Acquire and release exclusive write locks.
//   4. Query reader count and write-lock state.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type RwLock = struct {
    id: Int,
    readers: Int,
    writer: Bool,
    name: String
};

// Create a new RwLock.
pub fn rwlock_new(id: Int, name: String) -> RwLock {
    return RwLock {
        id: id,
        readers: 0,
        writer: false,
        name: name
    };
}

// Acquire shared read lock under ThreadCap.
pub fn rwlock_read_lock(thread: &ThreadCap, lock: RwLock) -> Result[RwLock, String] {
    let wr: Bool = lock.writer;
    if wr == true {
        return Err("E_RWLOCK_BUSY: write lock currently held");
    }
    let r_cnt: Int = lock.readers;
    let next_r: Int = r_cnt + 1;
    return Ok(RwLock {
        id: lock.id,
        readers: next_r,
        writer: false,
        name: lock.name
    });
}

// Release shared read lock under ThreadCap.
pub fn rwlock_read_unlock(thread: &ThreadCap, lock: RwLock) -> Result[RwLock, String] {
    let r_cnt: Int = lock.readers;
    if r_cnt <= 0 {
        return Err("E_RWLOCK_UNDERFLOW: no active read locks to release");
    }
    let next_r: Int = r_cnt - 1;
    return Ok(RwLock {
        id: lock.id,
        readers: next_r,
        writer: false,
        name: lock.name
    });
}

// Acquire exclusive write lock under ThreadCap.
pub fn rwlock_write_lock(thread: &ThreadCap, lock: RwLock) -> Result[RwLock, String] {
    let wr: Bool = lock.writer;
    if wr == true {
        return Err("E_RWLOCK_BUSY: write lock already held");
    }
    let r_cnt: Int = lock.readers;
    if r_cnt > 0 {
        return Err("E_RWLOCK_BUSY: active readers present");
    }
    return Ok(RwLock {
        id: lock.id,
        readers: 0,
        writer: true,
        name: lock.name
    });
}

// Release exclusive write lock under ThreadCap.
pub fn rwlock_write_unlock(thread: &ThreadCap, lock: RwLock) -> Result[RwLock, String] {
    let wr: Bool = lock.writer;
    if wr == false {
        return Err("E_RWLOCK_NOT_LOCKED: write lock is not held");
    }
    return Ok(RwLock {
        id: lock.id,
        readers: 0,
        writer: false,
        name: lock.name
    });
}

// Return current active reader count.
pub fn rwlock_reader_count(lock: RwLock) -> Int {
    return lock.readers;
}

// True if write lock is held.
pub fn rwlock_is_write_locked(lock: RwLock) -> Bool {
    return lock.writer;
}
