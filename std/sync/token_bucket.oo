// # Token Bucket Traffic Rate Limiter Module
//
// Logline: Token bucket rate limiter with burst capacity, fractional token replenishment, and conformant consumption.
//
// Setup: Enforces deterministic throughput limits and burst handling under ThreadCap.
//
// Beats:
//   1. Construct TokenBucket with capacity and replenishment rate per second.
//   2. Refill tokens based on elapsed milliseconds.
//   3. Consume tokens for outgoing requests.
//   4. Query remaining available tokens.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware monotonic clock polling lowers via os/time.

import "std/result.oo";

type TokenBucket = struct {
    capacity: Int,
    current_tokens: Int,
    refill_rate_per_sec: Int,
    last_refill_ms: Int
};

pub fn token_bucket_new(capacity: Int, refill_rate_per_sec: Int) -> TokenBucket {
    return TokenBucket {
        capacity: capacity,
        current_tokens: capacity,
        refill_rate_per_sec: refill_rate_per_sec,
        last_refill_ms: 0
    };
}

pub fn token_bucket_refill(thread: &ThreadCap, bucket: TokenBucket, current_ms: Int) -> TokenBucket {
    let last_ms: Int = bucket.last_refill_ms;
    if current_ms <= last_ms {
        return bucket;
    }
    let elapsed_ms: Int = current_ms - last_ms;
    let rate: Int = bucket.refill_rate_per_sec;
    let tokens_to_add: Int = (elapsed_ms * rate) / 1000;
    if tokens_to_add == 0 {
        return bucket;
    }
    let cur: Int = bucket.current_tokens;
    let mut next_tokens: Int = cur + tokens_to_add;
    let cap: Int = bucket.capacity;
    if next_tokens > cap {
        next_tokens = cap;
    }
    return TokenBucket {
        capacity: cap,
        current_tokens: next_tokens,
        refill_rate_per_sec: rate,
        last_refill_ms: current_ms
    };
}

pub fn token_bucket_consume(thread: &ThreadCap, bucket: TokenBucket, tokens: Int) -> Result[TokenBucket, String] {
    let cur: Int = bucket.current_tokens;
    if cur < tokens {
        return Err("RATE_LIMIT_EXCEEDED");
    }
    return Ok(TokenBucket {
        capacity: bucket.capacity,
        current_tokens: cur - tokens,
        refill_rate_per_sec: bucket.refill_rate_per_sec,
        last_refill_ms: bucket.last_refill_ms
    });
}
