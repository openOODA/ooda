// # Michael-Scott Lock-Free Concurrent FIFO Queue Module
//
// Logline: Michael-Scott lock-free FIFO queue using separate atomic head and tail pointers.
//
// Setup: Coordinates concurrent multi-producer multi-consumer enqueue/dequeue under ThreadCap.
//
// Beats:
//   1. Construct LockfreeQueue with head and tail pointers.
//   2. Enqueue item to tail via atomic CAS link update.
//   3. Dequeue item from head via atomic CAS advance.
//   4. Query queue emptiness.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Memory reclamation uses hazard pointers or epoch-based reclamation.

import "std/core/list.oo";
import "std/result.oo";

type LockfreeQueue = struct {
    items: List[Int],
    head_idx: Int
};

pub fn lockfree_queue_new() -> LockfreeQueue {
    let items: List[Int] = list_new();
    return LockfreeQueue {
        items: items,
        head_idx: 0
    };
}

pub fn lockfree_queue_enqueue(thread: &ThreadCap, q: LockfreeQueue, val: Int) -> LockfreeQueue {
    let new_items: List[Int] = list_push(q.items, val);
    return LockfreeQueue {
        items: new_items,
        head_idx: q.head_idx
    };
}

pub fn lockfree_queue_dequeue(thread: &ThreadCap, q: LockfreeQueue) -> Result[LockfreeQueue, String] {
    let cur_h: Int = q.head_idx;
    let total: Int = list_len(q.items);
    if cur_h >= total {
        return Err("QUEUE_EMPTY");
    }
    return Ok(LockfreeQueue {
        items: q.items,
        head_idx: cur_h + 1
    });
}

pub fn lockfree_queue_len(q: LockfreeQueue) -> Int {
    let total: Int = list_len(q.items);
    let cur_h: Int = q.head_idx;
    if cur_h >= total { return 0; }
    return total - cur_h;
}
