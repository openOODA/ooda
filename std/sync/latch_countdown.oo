// # Countdown Latch Synchronization Primitive Module
//
// Logline: One-time single-use countdown latch allowing threads to wait until a counter reaches zero.
//
// Setup: Coordinates one-shot barrier completion under ThreadCap.
//
// Beats:
//   1. Construct CountdownLatch with initial countdown count.
//   2. Decrement latch count (count_down).
//   3. Test if countdown latch is completed (count == 0).
//   4. Query remaining count.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Host futex wait lowers to sys_futex.

type CountdownLatch = struct {
    count: Int
};

pub fn latch_new(count: Int) -> CountdownLatch {
    let mut c: Int = count;
    if c < 0 { c = 0; }
    return CountdownLatch { count: c };
}

pub fn latch_count_down(thread: &ThreadCap, latch: CountdownLatch) -> CountdownLatch {
    let cur: Int = latch.count;
    if cur <= 0 {
        return CountdownLatch { count: 0 };
    }
    return CountdownLatch { count: cur - 1 };
}

pub fn latch_is_zero(latch: CountdownLatch) -> Bool {
    let c: Int = latch.count;
    return c == 0;
}

pub fn latch_get_count(latch: CountdownLatch) -> Int {
    return latch.count;
}
