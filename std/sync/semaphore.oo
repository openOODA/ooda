// # Counting Semaphore Module
//
// Logline: Permit-based counting and binary semaphore for bounded concurrency limits under ThreadCap.
//
// Setup: Coordinates permit acquisition, release, and capacity boundaries under ThreadCap.
//
// Beats:
//   1. Construct Semaphore with initial and maximum permit count.
//   2. Acquire permits with boundary verification.
//   3. Release permits back to the semaphore pool.
//   4. Query available permit count and emptiness.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type Semaphore = struct {
    id: Int,
    permits: Int,
    max_permits: Int
};

// Create a new Semaphore with initial permits and upper capacity bound.
pub fn semaphore_new(permits: Int, max_permits: Int) -> Semaphore {
    let mut init_p: Int = permits;
    let mut max_p: Int = max_permits;
    if max_p < 1 {
        max_p = 1;
    }
    if init_p < 0 {
        init_p = 0;
    }
    if init_p > max_p {
        init_p = max_p;
    }
    return Semaphore {
        id: 1,
        permits: init_p,
        max_permits: max_p
    };
}

// Return number of available permits.
pub fn semaphore_available(sem: Semaphore) -> Int {
    return sem.permits;
}

// Acquire count permits under ThreadCap.
pub fn semaphore_acquire(
    thread: &ThreadCap,
    sem: Semaphore,
    count: Int
) -> Result[Semaphore, String] {
    if count <= 0 {
        return Err("E_SEM_INVALID: count must be positive");
    }
    let p: Int = sem.permits;
    if p < count {
        return Err("E_SEM_EXHAUSTED: insufficient permits");
    }
    let next_p: Int = p - count;
    return Ok(Semaphore {
        id: sem.id,
        permits: next_p,
        max_permits: sem.max_permits
    });
}

// Try to acquire count permits (non-blocking).
pub fn semaphore_try_acquire(
    thread: &ThreadCap,
    sem: Semaphore,
    count: Int
) -> Result[Semaphore, String] {
    return semaphore_acquire(thread, sem, count);
}

// Release count permits back to the semaphore under ThreadCap.
pub fn semaphore_release(
    thread: &ThreadCap,
    sem: Semaphore,
    count: Int
) -> Result[Semaphore, String] {
    if count <= 0 {
        return Err("E_SEM_INVALID: count must be positive");
    }
    let p: Int = sem.permits;
    let max_p: Int = sem.max_permits;
    let next_p: Int = p + count;
    if next_p > max_p {
        return Err("E_SEM_OVERFLOW: permits exceed max capacity");
    }
    return Ok(Semaphore {
        id: sem.id,
        permits: next_p,
        max_permits: max_p
    });
}

// True if no permits are currently available.
pub fn semaphore_is_empty(sem: Semaphore) -> Bool {
    return sem.permits == 0;
}
