// # Sequential Lock (SeqLock) Concurrency Module
//
// Logline: Reader-writer sequential lock optimized for frequent lockless reads and occasional exclusive writes.
//
// Setup: Tracks sequence counter where odd values indicate ongoing write operations under ThreadCap.
//
// Beats:
//   1. Construct SeqLock with initial sequence number 0.
//   2. Begin and validate read critical section sequence.
//   3. Acquire exclusive write lock (odd sequence).
//   4. Release exclusive write lock (even sequence).
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware memory fences lower via compiler barrier intrinsics.

type SeqLock = struct {
    sequence: Int
};

pub fn seqlock_new() -> SeqLock {
    return SeqLock { sequence: 0 };
}

pub fn seqlock_read_begin(lock: SeqLock) -> Int {
    return lock.sequence;
}

pub fn seqlock_read_validate(lock: SeqLock, start_seq: Int) -> Bool {
    let cur: Int = lock.sequence;
    if (start_seq & 1) != 0 {
        return false;
    }
    return cur == start_seq;
}

pub fn seqlock_write_lock(thread: &ThreadCap, lock: SeqLock) -> SeqLock {
    let cur: Int = lock.sequence;
    return SeqLock { sequence: cur + 1 };
}

pub fn seqlock_write_unlock(thread: &ThreadCap, lock: SeqLock) -> SeqLock {
    let cur: Int = lock.sequence;
    return SeqLock { sequence: cur + 1 };
}
