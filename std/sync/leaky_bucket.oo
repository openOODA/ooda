// # Leaky Bucket Traffic Shaper Module
//
// Logline: Leaky bucket traffic shaper smoothing bursty arrivals into constant rate output.
//
// Setup: Shapes bursty traffic streams to continuous smooth departure rates under ThreadCap.
//
// Beats:
//   1. Construct LeakyBucket with capacity and leak rate per second.
//   2. Leak queued water/packets according to elapsed time.
//   3. Add water/packets to the bucket if capacity permits.
//   4. Query current queue level.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Timer wheel integration lowers via sync/timer_wheel.

import "std/result.oo";

type LeakyBucket = struct {
    capacity: Int,
    water_level: Int,
    leak_rate_per_sec: Int,
    last_leak_ms: Int
};

pub fn leaky_bucket_new(capacity: Int, leak_rate_per_sec: Int) -> LeakyBucket {
    return LeakyBucket {
        capacity: capacity,
        water_level: 0,
        leak_rate_per_sec: leak_rate_per_sec,
        last_leak_ms: 0
    };
}

pub fn leaky_bucket_leak(thread: &ThreadCap, bucket: LeakyBucket, current_ms: Int) -> LeakyBucket {
    let last_ms: Int = bucket.last_leak_ms;
    if current_ms <= last_ms {
        return bucket;
    }
    let elapsed_ms: Int = current_ms - last_ms;
    let rate: Int = bucket.leak_rate_per_sec;
    let leaked: Int = (elapsed_ms * rate) / 1000;
    let cur_w: Int = bucket.water_level;
    let mut next_w: Int = cur_w - leaked;
    if next_w < 0 {
        next_w = 0;
    }
    return LeakyBucket {
        capacity: bucket.capacity,
        water_level: next_w,
        leak_rate_per_sec: rate,
        last_leak_ms: current_ms
    };
}

pub fn leaky_bucket_add(thread: &ThreadCap, bucket: LeakyBucket, volume: Int) -> Result[LeakyBucket, String] {
    let cur_w: Int = bucket.water_level;
    let cap: Int = bucket.capacity;
    let mut next_w: Int = cur_w + volume;
    if next_w > cap {
        return Err("BUCKET_OVERFLOW");
    }
    return Ok(LeakyBucket {
        capacity: cap,
        water_level: next_w,
        leak_rate_per_sec: bucket.leak_rate_per_sec,
        last_leak_ms: bucket.last_leak_ms
    });
}
