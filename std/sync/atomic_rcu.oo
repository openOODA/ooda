// # Read-Copy-Update (RCU) Synchronization Module
//
// Logline: Read-Copy-Update (RCU) synchronization primitives, quiescent epoch tracking, and deferred reclamation under ThreadCap.
//
// Setup: Coordinates lockless read-side critical sections and deferred reclamation across generational epochs under ThreadCap.
//
// Beats:
//   1. Construct RcuCell and RcuEpoch synchronization state.
//   2. Enter and exit read-side critical sections (rcu_read_lock / rcu_read_unlock).
//   3. Read current value and atomic RCU pointer update (publish new version, retire old).
//   4. Synchronize grace period and reclaim retired memory.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware QSBR (quiescent-state based reclamation) uses cooperative thread epochs.

import "std/result.oo";

type RcuEpoch = struct {
    epoch: Int,
    readers: Int,
    active: Bool
};

type RcuCell = struct {
    version: Int,
    val: Int,
    retired: List[Int]
};

// Create a new RcuEpoch tracking state.
pub fn rcu_epoch_new() -> RcuEpoch {
    return RcuEpoch {
        epoch: 1,
        readers: 0,
        active: true
    };
}

// Create a new RcuCell holding initial value.
pub fn rcu_cell_new(initial: Int) -> RcuCell {
    let empty_ret: List[Int] = list_new();
    return RcuCell {
        version: 1,
        val: initial,
        retired: empty_ret
    };
}

// Enter RCU read-side critical section under ThreadCap.
pub fn rcu_read_lock(thread: &ThreadCap, ep: RcuEpoch) -> RcuEpoch {
    let cur_r: Int = ep.readers;
    let next_r: Int = cur_r + 1;
    return RcuEpoch {
        epoch: ep.epoch,
        readers: next_r,
        active: ep.active
    };
}

// Exit RCU read-side critical section under ThreadCap.
pub fn rcu_read_unlock(thread: &ThreadCap, ep: RcuEpoch) -> RcuEpoch {
    let cur_r: Int = ep.readers;
    let mut next_r: Int = cur_r - 1;
    if next_r < 0 {
        next_r = 0;
    }
    return RcuEpoch {
        epoch: ep.epoch,
        readers: next_r,
        active: ep.active
    };
}

// Read current value from RcuCell under ThreadCap.
pub fn rcu_read(thread: &ThreadCap, cell: RcuCell) -> Int {
    return cell.val;
}

// Read current version number from RcuCell.
pub fn rcu_version(cell: RcuCell) -> Int {
    return cell.version;
}

// Atomic RCU update: stores new value and moves old value to retired list under ThreadCap.
pub fn rcu_update(
    thread: &ThreadCap,
    cell: RcuCell,
    new_val: Int
) -> RcuCell {
    let cur_v: Int = cell.version;
    let cur_val: Int = cell.val;
    let mut next_ret: List[Int] = list_new();
    let n: Int = list_len(cell.retired);
    let mut i: Int = 0;
    while i < n {
        let old: Int = list_get(cell.retired, i);
        next_ret = list_push(next_ret, old);
        i = i + 1;
    }
    next_ret = list_push(next_ret, cur_val);
    let next_v: Int = cur_v + 1;
    return RcuCell {
        version: next_v,
        val: new_val,
        retired: next_ret
    };
}

// Wait for grace period to expire and advance global epoch under ThreadCap.
pub fn rcu_synchronize(thread: &ThreadCap, ep: RcuEpoch) -> RcuEpoch {
    let cur_e: Int = ep.epoch;
    let next_e: Int = cur_e + 1;
    return RcuEpoch {
        epoch: next_e,
        readers: 0,
        active: ep.active
    };
}

// Reclaim retired items and clear retired buffer under ThreadCap.
pub fn rcu_reclaim(thread: &ThreadCap, cell: RcuCell) -> RcuCell {
    let empty_ret: List[Int] = list_new();
    return RcuCell {
        version: cell.version,
        val: cell.val,
        retired: empty_ret
    };
}

// Query number of pending retired elements in cell.
pub fn rcu_retired_count(cell: RcuCell) -> Int {
    return list_len(cell.retired);
}
