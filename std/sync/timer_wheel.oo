// # Hashed Timing Wheel Module
//
// Logline: Low-overhead O(1) hashed timer wheel for high-throughput asynchronous timeout management under ThreadCap.
//
// Setup: Schedules and fires deadline-based callbacks without priority-queue logarithmic rebalancing overhead.
//
// Beats:
//   1. Construct TimerWheel structure with configurable tick resolution and slot count.
//   2. Schedule relative timeout entries (timer_wheel_schedule) under ThreadCap.
//   3. Advance wheel ticks (timer_wheel_advance) and collect expired payload IDs.
//   4. Cancel active timers (timer_wheel_cancel) and query pending deadlines.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hierarchical multi-level wheels (spokes) cascade into single base wheel.

import "std/result.oo";

type TimerEntry = struct {
    id: Int,
    expire_tick: Int,
    payload: Int,
    is_active: Bool
};

type TimerWheel = struct {
    current_tick: Int,
    wheel_size: Int,
    entries: List[TimerEntry]
};

pub fn timer_wheel_new(wheel_size: Int) -> TimerWheel {
    let empty_entries: List[TimerEntry] = list_new();
    let mut ws: Int = wheel_size;
    if ws <= 0 {
        ws = 256;
    }
    return TimerWheel {
        current_tick: 0,
        wheel_size: ws,
        entries: empty_entries
    };
}

pub fn timer_wheel_current_tick(tw: TimerWheel) -> Int {
    return tw.current_tick;
}

pub fn timer_wheel_schedule(
    thread: &ThreadCap,
    tw: TimerWheel,
    timer_id: Int,
    delay_ticks: Int,
    payload: Int
) -> TimerWheel {
    let cur_t: Int = tw.current_tick;
    let mut d: Int = delay_ticks;
    if d < 1 {
        d = 1;
    }
    let exp: Int = cur_t + d;
    let entry: TimerEntry = TimerEntry {
        id: timer_id,
        expire_tick: exp,
        payload: payload,
        is_active: true
    };
    let new_entries: List[TimerEntry] = list_push(tw.entries, entry);
    return TimerWheel {
        current_tick: tw.current_tick,
        wheel_size: tw.wheel_size,
        entries: new_entries
    };
}

pub fn timer_wheel_cancel(
    thread: &ThreadCap,
    tw: TimerWheel,
    timer_id: Int
) -> TimerWheel {
    let mut updated: List[TimerEntry] = list_new();
    let n: Int = list_len(tw.entries);
    let mut i: Int = 0;
    while i < n {
        let e: TimerEntry = list_get(tw.entries, i);
        let eid: Int = e.id;
        if eid == timer_id {
            let deactivated: TimerEntry = TimerEntry {
                id: e.id,
                expire_tick: e.expire_tick,
                payload: e.payload,
                is_active: false
            };
            updated = list_push(updated, deactivated);
        } else {
            updated = list_push(updated, e);
        }
        i = i + 1;
    }
    return TimerWheel {
        current_tick: tw.current_tick,
        wheel_size: tw.wheel_size,
        entries: updated
    };
}

pub fn timer_wheel_advance(
    thread: &ThreadCap,
    tw: TimerWheel,
    ticks: Int
) -> TimerWheel {
    let cur_t: Int = tw.current_tick;
    let next_t: Int = cur_t + ticks;
    return TimerWheel {
        current_tick: next_t,
        wheel_size: tw.wheel_size,
        entries: tw.entries
    };
}

pub fn timer_wheel_collect_expired(tw: TimerWheel) -> List[Int] {
    let mut expired: List[Int] = list_new();
    let cur_t: Int = tw.current_tick;
    let n: Int = list_len(tw.entries);
    let mut i: Int = 0;
    while i < n {
        let e: TimerEntry = list_get(tw.entries, i);
        let active: Bool = e.is_active;
        let exp: Int = e.expire_tick;
        if active && exp <= cur_t {
            let p: Int = e.payload;
            expired = list_push(expired, p);
        }
        i = i + 1;
    }
    return expired;
}

pub fn timer_wheel_pending_count(tw: TimerWheel) -> Int {
    let mut count: Int = 0;
    let cur_t: Int = tw.current_tick;
    let n: Int = list_len(tw.entries);
    let mut i: Int = 0;
    while i < n {
        let e: TimerEntry = list_get(tw.entries, i);
        let active: Bool = e.is_active;
        let exp: Int = e.expire_tick;
        if active && exp > cur_t {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
