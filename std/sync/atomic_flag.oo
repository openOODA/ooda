// # Hardware Atomic Boolean Flag Module
//
// Logline: Lock-free atomic test-and-set boolean flag, spinlock synchronization, and memory-order release under ThreadCap.
//
// Setup: Coordinates low-level spinlock loops and mutual exclusion barriers under ThreadCap token.
//
// Beats:
//   1. Construct AtomicFlag with initial clear state (false).
//   2. Atomic test-and-set (atomic_flag_test_and_set) with busy collision reporting.
//   3. Atomic clear (atomic_flag_clear) to release acquired spinlock.
//   4. Query current flag state without acquisition.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware test-and-set CPU assembly lowers via compiler atomic backend.

import "std/result.oo";

type AtomicFlag = struct {
    is_raised: Bool
};

pub fn atomic_flag_new() -> AtomicFlag {
    return AtomicFlag {
        is_raised: false
    };
}

pub fn atomic_flag_test(flag: AtomicFlag) -> Bool {
    return flag.is_raised;
}

pub fn atomic_flag_test_and_set(
    thread: &ThreadCap,
    flag: AtomicFlag
) -> Result[AtomicFlag, String] {
    let raised: Bool = flag.is_raised;
    if raised {
        return Err("flag_busy");
    }
    return Ok(AtomicFlag {
        is_raised: true
    });
}

pub fn atomic_flag_clear(
    thread: &ThreadCap,
    flag: AtomicFlag
) -> AtomicFlag {
    return AtomicFlag {
        is_raised: false
    };
}
