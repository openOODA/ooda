// # Cooperative Fiber Scheduler Module
//
// Logline: Round-robin and cooperative fiber queue scheduler under ThreadCap and TimeCap.
//
// Setup: Coordinates ready fiber queues with cooperative round-robin execution progression.
//
// Beats:
//   1. Construct fiber scheduler and enqueue ready fiber IDs.
//   2. Advance round-robin scheduling cursor to next runnable fiber.
//   3. Step fiber execution under ThreadCap.
//   4. Run scheduler loop bounded by iteration limit under TimeCap and ThreadCap.
// RULES.oot 1.4: Default-deny for concurrency and timing effects. Explicit &ThreadCap and &TimeCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type FiberScheduler = struct {
    fibers: List[String],
    current_index: Int,
    active_count: Int,
    total_yields: Int
};

// Create a new empty fiber scheduler.
pub fn scheduler_new() -> FiberScheduler {
    let f_list: List[String] = list_new();
    return FiberScheduler {
        fibers: f_list,
        current_index: 0,
        active_count: 0,
        total_yields: 0
    };
}

// Spawn / register a new fiber ID into the scheduler.
pub fn scheduler_spawn(sched: FiberScheduler, fiber_id: String) -> FiberScheduler {
    let new_fibers: List[String] = list_push(sched.fibers, fiber_id);
    let cur_cnt: Int = sched.active_count;
    let new_cnt: Int = cur_cnt + 1;
    return FiberScheduler {
        fibers: new_fibers,
        current_index: sched.current_index,
        active_count: new_cnt,
        total_yields: sched.total_yields
    };
}

// Return number of registered fibers in the scheduler.
pub fn scheduler_len(sched: FiberScheduler) -> Int {
    return sched.active_count;
}

// True if no fibers are registered.
pub fn scheduler_is_empty(sched: FiberScheduler) -> Bool {
    return sched.active_count == 0;
}

// Return the next fiber ID in round-robin order.
pub fn scheduler_next(sched: FiberScheduler) -> Result[String, String] {
    let count: Int = sched.active_count;
    if count == 0 {
        return Err("E_SCHED_EMPTY: no active fibers");
    }
    let idx: Int = sched.current_index;
    let safe_idx: Int = idx % count;
    let f_id: String = list_get(sched.fibers, safe_idx);
    return Ok(f_id);
}

// Advance the scheduler cursor by one step under ThreadCap.
pub fn scheduler_step(thread: &ThreadCap, sched: FiberScheduler) -> FiberScheduler {
    let count: Int = sched.active_count;
    if count == 0 {
        return sched;
    }
    let idx: Int = sched.current_index;
    let next_idx: Int = (idx + 1) % count;
    let ty: Int = sched.total_yields;
    let next_ty: Int = ty + 1;
    return FiberScheduler {
        fibers: sched.fibers,
        current_index: next_idx,
        active_count: count,
        total_yields: next_ty
    };
}

// Run scheduler for up to max_steps iterations under TimeCap and ThreadCap.
pub fn scheduler_run_all(
    time_cap: &TimeCap,
    thread: &ThreadCap,
    sched: FiberScheduler,
    max_steps: Int
) -> Int {
    let mut current: FiberScheduler = sched;
    let mut steps_executed: Int = 0;
    while steps_executed < max_steps {
        if scheduler_is_empty(current) {
            return steps_executed;
        }
        current = scheduler_step(thread, current);
        steps_executed = steps_executed + 1;
    }
    return steps_executed;
}
