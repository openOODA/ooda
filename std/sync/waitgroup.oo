// # WaitGroup Task Synchronization Module
//
// Logline: Concurrent task completion barrier and countdown synchronization primitive under ThreadCap.
//
// Setup: Coordinates synchronization of multiple asynchronous workers by blocking until the task counter reaches zero.
//
// Beats:
//   1. Construct WaitGroup with initial zero counter.
//   2. Increment task counter (waitgroup_add) under ThreadCap.
//   3. Decrement task counter (waitgroup_done) with negative counter bounds checking.
//   4. Await task completion (waitgroup_wait) and query status under ThreadCap.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: OS scheduler parking lowers to futex/condvar primitives via backend runtime.

import "std/result.oo";

type WaitGroup = struct {
    counter: Int,
    waiters: Int
};

// Create a new WaitGroup initialized with zero counter.
pub fn waitgroup_new() -> WaitGroup {
    return WaitGroup {
        counter: 0,
        waiters: 0
    };
}

// Return current active task counter.
pub fn waitgroup_count(wg: WaitGroup) -> Int {
    return wg.counter;
}

// Return number of waiting threads.
pub fn waitgroup_waiters(wg: WaitGroup) -> Int {
    return wg.waiters;
}

// True if all tasks have completed (counter is 0).
pub fn waitgroup_is_done(wg: WaitGroup) -> Bool {
    return wg.counter == 0;
}

// Add delta tasks to the WaitGroup counter under ThreadCap.
pub fn waitgroup_add(
    thread: &ThreadCap,
    wg: WaitGroup,
    delta: Int
) -> WaitGroup {
    let cur: Int = wg.counter;
    let next_cnt: Int = cur + delta;
    return WaitGroup {
        counter: next_cnt,
        waiters: wg.waiters
    };
}

// Decrement task counter by 1 upon task completion under ThreadCap.
pub fn waitgroup_done(
    thread: &ThreadCap,
    wg: WaitGroup
) -> Result[WaitGroup, String] {
    let cur: Int = wg.counter;
    if cur <= 0 {
        return Err("E_WG_NEGATIVE: negative WaitGroup counter");
    }
    let next_cnt: Int = cur - 1;
    return Ok(WaitGroup {
        counter: next_cnt,
        waiters: wg.waiters
    });
}

// Await completion of all tasks in the WaitGroup under ThreadCap.
pub fn waitgroup_wait(
    thread: &ThreadCap,
    wg: WaitGroup
) -> Result[WaitGroup, String] {
    let cur: Int = wg.counter;
    if cur < 0 {
        return Err("E_WG_NEGATIVE: negative WaitGroup counter");
    }
    if cur == 0 {
        return Ok(wg);
    }
    let cur_w: Int = wg.waiters;
    let next_w: Int = cur_w + 1;
    return Ok(WaitGroup {
        counter: cur,
        waiters: next_w
    });
}

// Reset WaitGroup counter and waiters to zero under ThreadCap.
pub fn waitgroup_reset(thread: &ThreadCap, wg: WaitGroup) -> WaitGroup {
    return WaitGroup {
        counter: 0,
        waiters: 0
    };
}
