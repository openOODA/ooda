// # Phase-Fair Reader-Writer Lock Module
//
// Logline: Phase-fair reader-writer lock preventing reader and writer starvation with alternating critical section phases under ThreadCap.
//
// Setup: Coordinates concurrent readers and exclusive writers with deterministic bounded admission wait times.
//
// Beats:
//   1. Construct FairRwLock synchronization ticket counters.
//   2. Phase-fair read lock acquisition and release under ThreadCap.
//   3. Exclusive write lock acquisition and phase transition under ThreadCap.
//   4. Query active readers, pending writers, and lock occupancy status.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware wait-queue parking lowers via futex phase words.

import "std/result.oo";

type FairRwLock = struct {
    readers_in: Int,
    readers_out: Int,
    writers_in: Int,
    writers_out: Int,
    writer_held: Bool
};

pub fn fair_rwlock_new() -> FairRwLock {
    return FairRwLock {
        readers_in: 0,
        readers_out: 0,
        writers_in: 0,
        writers_out: 0,
        writer_held: false
    };
}

pub fn fair_rwlock_active_readers(lock: FairRwLock) -> Int {
    let rin: Int = lock.readers_in;
    let rout: Int = lock.readers_out;
    return rin - rout;
}

pub fn fair_rwlock_is_write_locked(lock: FairRwLock) -> Bool {
    return lock.writer_held;
}

pub fn fair_rwlock_read_lock(
    thread: &ThreadCap,
    lock: FairRwLock
) -> Result[FairRwLock, String] {
    let held: Bool = lock.writer_held;
    if held {
        return Err("writer_busy");
    }
    let cur_rin: Int = lock.readers_in;
    let next_rin: Int = cur_rin + 1;
    let updated: FairRwLock = FairRwLock {
        readers_in: next_rin,
        readers_out: lock.readers_out,
        writers_in: lock.writers_in,
        writers_out: lock.writers_out,
        writer_held: false
    };
    return Ok(updated);
}

pub fn fair_rwlock_read_unlock(
    thread: &ThreadCap,
    lock: FairRwLock
) -> FairRwLock {
    let cur_rout: Int = lock.readers_out;
    let next_rout: Int = cur_rout + 1;
    return FairRwLock {
        readers_in: lock.readers_in,
        readers_out: next_rout,
        writers_in: lock.writers_in,
        writers_out: lock.writers_out,
        writer_held: lock.writer_held
    };
}

pub fn fair_rwlock_write_lock(
    thread: &ThreadCap,
    lock: FairRwLock
) -> Result[FairRwLock, String] {
    let held: Bool = lock.writer_held;
    if held {
        return Err("writer_busy");
    }
    let readers: Int = fair_rwlock_active_readers(lock);
    if readers > 0 {
        return Err("readers_active");
    }
    let cur_win: Int = lock.writers_in;
    let next_win: Int = cur_win + 1;
    let updated: FairRwLock = FairRwLock {
        readers_in: lock.readers_in,
        readers_out: lock.readers_out,
        writers_in: next_win,
        writers_out: lock.writers_out,
        writer_held: true
    };
    return Ok(updated);
}

pub fn fair_rwlock_write_unlock(
    thread: &ThreadCap,
    lock: FairRwLock
) -> FairRwLock {
    let cur_wout: Int = lock.writers_out;
    let next_wout: Int = cur_wout + 1;
    return FairRwLock {
        readers_in: lock.readers_in,
        readers_out: lock.readers_out,
        writers_in: lock.writers_in,
        writers_out: next_wout,
        writer_held: false
    };
}
