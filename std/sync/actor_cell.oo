// # Actor Cell State and Lifecycle Module
//
// Logline: Actor execution cell tracking actor mailbox, behavior dispatch, status flags, and failure escalation.
//
// Setup: Coordinates isolated single-threaded actor state transitions under ThreadCap.
//
// Beats:
//   1. Construct ActorCell with actor ID, initial state, and mailbox size.
//   2. Transition actor lifecycle states: uninitialized, running, suspended, stopped, failed.
//   3. Dispatch incoming message to current actor behavior.
//   4. Query actor failure status and escalated error messages.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Distributed actor remoting lowers to network transport.

import "std/result.oo";

type ActorCell = struct {
    actor_id: Int,
    status: Int, // 0: Init, 1: Running, 2: Suspended, 3: Stopped, 4: Failed
    processed_count: Int,
    last_error: String
};

pub fn actor_cell_new(actor_id: Int) -> ActorCell {
    return ActorCell {
        actor_id: actor_id,
        status: 0,
        processed_count: 0,
        last_error: ""
    };
}

pub fn actor_cell_start(thread: &ThreadCap, cell: ActorCell) -> ActorCell {
    return ActorCell {
        actor_id: cell.actor_id,
        status: 1,
        processed_count: cell.processed_count,
        last_error: cell.last_error
    };
}

pub fn actor_cell_suspend(thread: &ThreadCap, cell: ActorCell) -> ActorCell {
    return ActorCell {
        actor_id: cell.actor_id,
        status: 2,
        processed_count: cell.processed_count,
        last_error: cell.last_error
    };
}

pub fn actor_cell_stop(thread: &ThreadCap, cell: ActorCell) -> ActorCell {
    return ActorCell {
        actor_id: cell.actor_id,
        status: 3,
        processed_count: cell.processed_count,
        last_error: cell.last_error
    };
}

pub fn actor_cell_fail(thread: &ThreadCap, cell: ActorCell, reason: String) -> ActorCell {
    return ActorCell {
        actor_id: cell.actor_id,
        status: 4,
        processed_count: cell.processed_count,
        last_error: reason
    };
}

pub fn actor_cell_record_msg(cell: ActorCell) -> ActorCell {
    let cur_cnt: Int = cell.processed_count;
    return ActorCell {
        actor_id: cell.actor_id,
        status: cell.status,
        processed_count: cur_cnt + 1,
        last_error: cell.last_error
    };
}

pub fn actor_cell_is_active(cell: ActorCell) -> Bool {
    let st: Int = cell.status;
    return st == 1;
}
