// # Asynchronous I/O Reactor Event Loop Module
//
// Logline: Event-driven I/O reactor coordinator, descriptor interest registry, readiness polling, and event dispatch under ThreadCap.
//
// Setup: Coordinates non-blocking I/O event registration and readiness notifications for async tasks.
//
// Beats:
//   1. Construct AsyncReactor instance with empty descriptor registry.
//   2. Register (reactor_register) and modify readiness interests (read/write).
//   3. Deregister (reactor_deregister) and query active descriptors.
//   4. Poll registered descriptors and dispatch triggered events under ThreadCap.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: OS epoll/kqueue multiplexers lower via platform reactor backend.

import "std/result.oo";

type ReactorInterest = struct {
    fd: Int,
    want_read: Bool,
    want_write: Bool
};

type AsyncReactor = struct {
    interests: List[ReactorInterest],
    is_running: Bool
};

pub fn reactor_new() -> AsyncReactor {
    let empty_list: List[ReactorInterest] = list_new();
    return AsyncReactor {
        interests: empty_list,
        is_running: true
    };
}

pub fn reactor_count(r: AsyncReactor) -> Int {
    return list_len(r.interests);
}

pub fn reactor_is_registered(r: AsyncReactor, target_fd: Int) -> Bool {
    let n: Int = list_len(r.interests);
    let mut i: Int = 0;
    while i < n {
        let entry: ReactorInterest = list_get(r.interests, i);
        let efd: Int = entry.fd;
        if efd == target_fd {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn reactor_register(
    thread: &ThreadCap,
    r: AsyncReactor,
    target_fd: Int,
    want_read: Bool,
    want_write: Bool
) -> AsyncReactor {
    let mut filtered: List[ReactorInterest] = list_new();
    let n: Int = list_len(r.interests);
    let mut i: Int = 0;
    while i < n {
        let entry: ReactorInterest = list_get(r.interests, i);
        let efd: Int = entry.fd;
        if efd != target_fd {
            filtered = list_push(filtered, entry);
        }
        i = i + 1;
    }
    let new_interest: ReactorInterest = ReactorInterest {
        fd: target_fd,
        want_read: want_read,
        want_write: want_write
    };
    let updated: List[ReactorInterest] = list_push(filtered, new_interest);
    return AsyncReactor {
        interests: updated,
        is_running: r.is_running
    };
}

pub fn reactor_deregister(
    thread: &ThreadCap,
    r: AsyncReactor,
    target_fd: Int
) -> AsyncReactor {
    let mut filtered: List[ReactorInterest] = list_new();
    let n: Int = list_len(r.interests);
    let mut i: Int = 0;
    while i < n {
        let entry: ReactorInterest = list_get(r.interests, i);
        let efd: Int = entry.fd;
        if efd != target_fd {
            filtered = list_push(filtered, entry);
        }
        i = i + 1;
    }
    return AsyncReactor {
        interests: filtered,
        is_running: r.is_running
    };
}

pub fn reactor_stop(thread: &ThreadCap, r: AsyncReactor) -> AsyncReactor {
    return AsyncReactor {
        interests: r.interests,
        is_running: false
    };
}
