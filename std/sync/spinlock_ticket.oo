// # Fair Ticket Spinlock Synchronization Primitive Module
//
// Logline: FIFO-ordered fair ticket spinlock preventing starvation among waiting threads.
//
// Setup: Coordinates ticket dispensing and serving sequence under ThreadCap.
//
// Beats:
//   1. Construct TicketSpinlock with next_ticket and now_serving initializers.
//   2. Dispense next sequential ticket number.
//   3. Advance now_serving ticket upon unlock.
//   4. Check if a given ticket is currently being served.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware pause / atomic fetch-and-add lowers via compiler intrinsics.

type TicketSpinlock = struct {
    next_ticket: Int,
    now_serving: Int
};

pub fn ticket_spinlock_new() -> TicketSpinlock {
    return TicketSpinlock {
        next_ticket: 0,
        now_serving: 0
    };
}

pub fn ticket_spinlock_take(thread: &ThreadCap, lock: TicketSpinlock) -> TicketSpinlock {
    let nxt: Int = lock.next_ticket;
    return TicketSpinlock {
        next_ticket: nxt + 1,
        now_serving: lock.now_serving
    };
}

pub fn ticket_spinlock_is_my_turn(lock: TicketSpinlock, my_ticket: Int) -> Bool {
    let srv: Int = lock.now_serving;
    return srv == my_ticket;
}

pub fn ticket_spinlock_unlock(thread: &ThreadCap, lock: TicketSpinlock) -> TicketSpinlock {
    let srv: Int = lock.now_serving;
    return TicketSpinlock {
        next_ticket: lock.next_ticket,
        now_serving: srv + 1
    };
}
