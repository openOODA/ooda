// # Atomic Operations Module
//
// Logline: Atomic scalar primitives, compare-and-swap (CAS), fetch-and-add, and store/load under ThreadCap.
//
// Setup: Coordinates lockless thread synchronization via AtomicInt and AtomicBool wrappers.
//
// Beats:
//   1. Construct AtomicInt and AtomicBool primitives.
//   2. Atomic load and store operations under ThreadCap.
//   3. Atomic fetch-and-add / fetch-and-sub arithmetic.
//   4. Compare-and-swap (CAS) conditional value exchanges.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type AtomicInt = struct {
    id: Int,
    value: Int
};

type AtomicBool = struct {
    id: Int,
    value: Bool
};

// Create a new AtomicInt initialized to value.
pub fn atomic_int_new(initial: Int) -> AtomicInt {
    return AtomicInt {
        id: 1,
        value: initial
    };
}

// Load current integer value under ThreadCap.
pub fn atomic_int_load(thread: &ThreadCap, a: AtomicInt) -> Int {
    return a.value;
}

// Store new integer value under ThreadCap.
pub fn atomic_int_store(thread: &ThreadCap, a: AtomicInt, val: Int) -> AtomicInt {
    return AtomicInt {
        id: a.id,
        value: val
    };
}

// Add delta to current value, returning updated AtomicInt under ThreadCap.
pub fn atomic_int_fetch_add(thread: &ThreadCap, a: AtomicInt, delta: Int) -> AtomicInt {
    let cur: Int = a.value;
    let next_val: Int = cur + delta;
    return AtomicInt {
        id: a.id,
        value: next_val
    };
}

// Subtract delta from current value, returning updated AtomicInt under ThreadCap.
pub fn atomic_int_fetch_sub(thread: &ThreadCap, a: AtomicInt, delta: Int) -> AtomicInt {
    let cur: Int = a.value;
    let next_val: Int = cur - delta;
    return AtomicInt {
        id: a.id,
        value: next_val
    };
}

// Compare and swap integer: updates to desired if current equals expected.
pub fn atomic_int_cas(
    thread: &ThreadCap,
    a: AtomicInt,
    expected: Int,
    desired: Int
) -> Result[AtomicInt, String] {
    let cur: Int = a.value;
    if cur != expected {
        return Err("E_CAS_MISMATCH: expected value mismatch");
    }
    return Ok(AtomicInt {
        id: a.id,
        value: desired
    });
}

// Create a new AtomicBool initialized to value.
pub fn atomic_bool_new(initial: Bool) -> AtomicBool {
    return AtomicBool {
        id: 1,
        value: initial
    };
}

// Load current boolean value under ThreadCap.
pub fn atomic_bool_load(thread: &ThreadCap, a: AtomicBool) -> Bool {
    return a.value;
}

// Store new boolean value under ThreadCap.
pub fn atomic_bool_store(thread: &ThreadCap, a: AtomicBool, val: Bool) -> AtomicBool {
    return AtomicBool {
        id: a.id,
        value: val
    };
}

// Compare and swap boolean: updates to desired if current equals expected.
pub fn atomic_bool_cas(
    thread: &ThreadCap,
    a: AtomicBool,
    expected: Bool,
    desired: Bool
) -> Result[AtomicBool, String] {
    let cur: Bool = a.value;
    if cur != expected {
        return Err("E_CAS_MISMATCH: expected bool mismatch");
    }
    return Ok(AtomicBool {
        id: a.id,
        value: desired
    });
}
