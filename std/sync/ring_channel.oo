// # Bounded Ring Channel Synchronization Module
//
// Logline: Lock-free bounded circular ring channel for single-producer single-consumer message passing.
//
// Setup: Coordinates lockless FIFO element transfer across producer and consumer under ThreadCap.
//
// Beats:
//   1. Construct RingChannel with fixed capacity buffer.
//   2. Push element to channel if capacity allows.
//   3. Pop element from channel if not empty.
//   4. Query current occupancy and capacity.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware cacheline alignment handled by compiler backend.

import "std/core/list.oo";
import "std/result.oo";

type RingChannel = struct {
    buffer: List[String],
    capacity: Int,
    read_head: Int
};

pub fn ring_channel_new(capacity: Int) -> RingChannel {
    let buf: List[String] = list_new();
    let mut cap: Int = capacity;
    if cap < 1 { cap = 1; }
    return RingChannel {
        buffer: buf,
        capacity: cap,
        read_head: 0
    };
}

pub fn ring_channel_send(thread: &ThreadCap, ch: RingChannel, val: String) -> Result[RingChannel, String] {
    let cur_total: Int = list_len(ch.buffer);
    let cur_head: Int = ch.read_head;
    let occupancy: Int = cur_total - cur_head;
    let max_cap: Int = ch.capacity;
    if occupancy >= max_cap {
        return Err("CHANNEL_FULL");
    }
    let new_buf: List[String] = list_push(ch.buffer, val);
    return Ok(RingChannel {
        buffer: new_buf,
        capacity: max_cap,
        read_head: cur_head
    });
}

pub fn ring_channel_recv(thread: &ThreadCap, ch: RingChannel) -> Result[RingChannel, String] {
    let cur_total: Int = list_len(ch.buffer);
    let cur_head: Int = ch.read_head;
    if cur_head >= cur_total {
        return Err("CHANNEL_EMPTY");
    }
    return Ok(RingChannel {
        buffer: ch.buffer,
        capacity: ch.capacity,
        read_head: cur_head + 1
    });
}
