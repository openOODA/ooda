// # Bitwise Event Flag Group Synchronization Module
//
// Logline: Bitwise event flag group allowing threads to wait on combinations of event bits (AND/OR masks).
//
// Setup: Coordinates multi-event state signaling and clearing under ThreadCap.
//
// Beats:
//   1. Construct EventFlagGroup with initial 32-bit flags.
//   2. Set event bits in the group (OR operation).
//   3. Clear event bits in the group (AND-NOT operation).
//   4. Test wait conditions for ANY (OR) or ALL (AND) flags matching.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Host futex broadcast lowers to futex CMP_REQUEUE.

type EventFlagGroup = struct {
    flags: Int
};

pub fn event_flag_group_new() -> EventFlagGroup {
    return EventFlagGroup { flags: 0 };
}

pub fn event_flag_set(thread: &ThreadCap, grp: EventFlagGroup, bits: Int) -> EventFlagGroup {
    let cur: Int = grp.flags;
    return EventFlagGroup { flags: cur | bits };
}

pub fn event_flag_clear(thread: &ThreadCap, grp: EventFlagGroup, bits: Int) -> EventFlagGroup {
    let cur: Int = grp.flags;
    let not_bits: Int = bits ^ -1;
    return EventFlagGroup { flags: cur & not_bits };
}

pub fn event_flag_match_all(grp: EventFlagGroup, mask: Int) -> Bool {
    let cur: Int = grp.flags;
    return (cur & mask) == mask;
}

pub fn event_flag_match_any(grp: EventFlagGroup, mask: Int) -> Bool {
    let cur: Int = grp.flags;
    return (cur & mask) != 0;
}
