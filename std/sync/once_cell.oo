// # Thread-Safe OnceCell Lazy Initialization Module
//
// Logline: Thread-safe single-assignment container, race-free once initialization, and deferred value binding under ThreadCap.
//
// Setup: Coordinates one-time initialization across multiple threads without explicit mutual exclusion locks.
//
// Beats:
//   1. Construct uninitialized OnceCell state container.
//   2. Attempt atomic initialization (once_cell_set) with double-initialization rejection.
//   3. Query initialized value (once_cell_get) with Result unwrapping.
//   4. Atomic get-or-init lazy evaluation fallback under ThreadCap.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware memory fences lower via atomic compiler backend.

import "std/result.oo";

type OnceCell = struct {
    val: Int,
    is_set: Bool
};

// Create a new uninitialized OnceCell.
pub fn once_cell_new() -> OnceCell {
    return OnceCell {
        val: 0,
        is_set: false
    };
}

// True if the OnceCell contains an initialized value.
pub fn once_cell_is_set(cell: OnceCell) -> Bool {
    return cell.is_set;
}

// Read value if initialized, or Err("uninitialized").
pub fn once_cell_get(cell: OnceCell) -> Result[Int, String] {
    let set: Bool = cell.is_set;
    if !set {
        return Err("uninitialized");
    }
    let v: Int = cell.val;
    return Ok(v);
}

// Attempt to set value. Returns Err("already_initialized") if already set.
pub fn once_cell_set(
    thread: &ThreadCap,
    cell: OnceCell,
    val: Int
) -> Result[OnceCell, String] {
    let set: Bool = cell.is_set;
    if set {
        return Err("already_initialized");
    }
    let updated: OnceCell = OnceCell {
        val: val,
        is_set: true
    };
    return Ok(updated);
}

// Get initialized value, or initialize with fallback if uninitialized.
pub fn once_cell_get_or_init(
    thread: &ThreadCap,
    cell: OnceCell,
    fallback: Int
) -> OnceCell {
    let set: Bool = cell.is_set;
    if set {
        return cell;
    }
    return OnceCell {
        val: fallback,
        is_set: true
    };
}
