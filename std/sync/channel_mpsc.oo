// # Multi-Producer Single-Consumer (MPSC) Channel Module
//
// Logline: Multi-producer single-consumer FIFO message queue with channel cloning, non-blocking polling, and disconnection detection under ThreadCap.
//
// Setup: Coordinates asynchronous message passing across thread boundaries under ThreadCap token.
//
// Beats:
//   1. Construct MpscChannel with capacity bounds and sender references.
//   2. Clone senders (mpsc_clone_sender) and track active producer count.
//   3. Non-blocking send and try-send operations under ThreadCap.
//   4. Consumer receive, polling (try_recv), and disconnect detection.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: OS thread parking lowers to futex conditional wakeups via backend runtime.

import "std/result.oo";

type MpscChannel = struct {
    messages: List[Int],
    head: Int,
    capacity: Int,
    is_closed: Bool,
    active_senders: Int
};

pub fn mpsc_channel_new(cap: Int) -> MpscChannel {
    let empty_msgs: List[Int] = list_new();
    let mut initial_cap: Int = cap;
    if initial_cap <= 0 {
        initial_cap = 64;
    }
    return MpscChannel {
        messages: empty_msgs,
        head: 0,
        capacity: initial_cap,
        is_closed: false,
        active_senders: 1
    };
}

pub fn mpsc_sender_clone(ch: MpscChannel) -> MpscChannel {
    let cur_senders: Int = ch.active_senders;
    return MpscChannel {
        messages: ch.messages,
        head: ch.head,
        capacity: ch.capacity,
        is_closed: ch.is_closed,
        active_senders: cur_senders + 1
    };
}

pub fn mpsc_sender_drop(ch: MpscChannel) -> MpscChannel {
    let cur_senders: Int = ch.active_senders;
    let mut senders: Int = cur_senders - 1;
    let mut closed: Bool = ch.is_closed;
    if senders <= 0 {
        senders = 0;
        closed = true;
    }
    return MpscChannel {
        messages: ch.messages,
        head: ch.head,
        capacity: ch.capacity,
        is_closed: closed,
        active_senders: senders
    };
}

pub fn mpsc_len(ch: MpscChannel) -> Int {
    let total: Int = list_len(ch.messages);
    let h: Int = ch.head;
    return total - h;
}

pub fn mpsc_is_empty(ch: MpscChannel) -> Bool {
    return mpsc_len(ch) == 0;
}

pub fn mpsc_is_full(ch: MpscChannel) -> Bool {
    let l: Int = mpsc_len(ch);
    let cap: Int = ch.capacity;
    return l >= cap;
}

pub fn mpsc_is_closed(ch: MpscChannel) -> Bool {
    return ch.is_closed;
}

pub fn mpsc_try_send(thread: &ThreadCap, ch: MpscChannel, val: Int) -> Result[MpscChannel, String] {
    let closed: Bool = ch.is_closed;
    if closed {
        return Err("channel_closed");
    }
    if mpsc_is_full(ch) {
        return Err("channel_full");
    }
    let new_msgs: List[Int] = list_push(ch.messages, val);
    let updated: MpscChannel = MpscChannel {
        messages: new_msgs,
        head: ch.head,
        capacity: ch.capacity,
        is_closed: ch.is_closed,
        active_senders: ch.active_senders
    };
    return Ok(updated);
}

pub fn mpsc_send(thread: &ThreadCap, ch: MpscChannel, val: Int) -> Result[MpscChannel, String] {
    return mpsc_try_send(thread, ch, val);
}

type MpscRecvResult = struct {
    channel: MpscChannel,
    value: Int
};

pub fn mpsc_try_recv(thread: &ThreadCap, ch: MpscChannel) -> Result[MpscRecvResult, String] {
    if mpsc_is_empty(ch) {
        let closed: Bool = ch.is_closed;
        if closed {
            return Err("channel_disconnected");
        }
        return Err("channel_empty");
    }
    let val: Int = list_get(ch.messages, ch.head);
    let cur_head: Int = ch.head;
    let next_head: Int = cur_head + 1;
    let updated: MpscChannel = MpscChannel {
        messages: ch.messages,
        head: next_head,
        capacity: ch.capacity,
        is_closed: ch.is_closed,
        active_senders: ch.active_senders
    };
    return Ok(MpscRecvResult {
        channel: updated,
        value: val
    });
}

pub fn mpsc_close(thread: &ThreadCap, ch: MpscChannel) -> MpscChannel {
    return MpscChannel {
        messages: ch.messages,
        head: ch.head,
        capacity: ch.capacity,
        is_closed: true,
        active_senders: 0
    };
}
