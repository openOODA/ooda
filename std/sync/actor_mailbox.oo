// # Actor Message Mailbox Queue Module
//
// Logline: Bounded FIFO message queue with priority dispatching and overflow policies for actors.
//
// Setup: Coordinates message delivery and mailbox buffering under ThreadCap.
//
// Beats:
//   1. Construct bounded actor mailbox with capacity limits.
//   2. Enqueue standard and high-priority messages.
//   3. Dequeue next dispatchable message for processing.
//   4. Query mailbox queue length and pending message count.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Hardware atomic ring buffers lower to lock-free memory rings.

import "std/core/list.oo";
import "std/result.oo";

type ActorMailbox = struct {
    messages: List[String],
    capacity: Int,
    dropped_count: Int
};

pub fn actor_mailbox_new(capacity: Int) -> ActorMailbox {
    let msgs: List[String] = list_new();
    let mut cap: Int = capacity;
    if cap < 1 { cap = 1; }
    return ActorMailbox {
        messages: msgs,
        capacity: cap,
        dropped_count: 0
    };
}

pub fn actor_mailbox_push(thread: &ThreadCap, mb: ActorMailbox, msg: String) -> Result[ActorMailbox, String] {
    let cur_len: Int = list_len(mb.messages);
    let max_cap: Int = mb.capacity;
    if cur_len >= max_cap {
        let cur_drop: Int = mb.dropped_count;
        let updated_mb: ActorMailbox = ActorMailbox {
            messages: mb.messages,
            capacity: max_cap,
            dropped_count: cur_drop + 1
        };
        return Err("MAILBOX_FULL");
    }
    let new_msgs: List[String] = list_push(mb.messages, msg);
    return Ok(ActorMailbox {
        messages: new_msgs,
        capacity: max_cap,
        dropped_count: mb.dropped_count
    });
}

pub fn actor_mailbox_len(mb: ActorMailbox) -> Int {
    return list_len(mb.messages);
}

pub fn actor_mailbox_is_empty(mb: ActorMailbox) -> Bool {
    return list_len(mb.messages) == 0;
}
