// # Standard Library: Concurrency Task Runtime
//
// Logline: Provide structured concurrency task spawning and join handle management with capability security.
//
// Setup: ProcessCap granted for spawning worker tasks, SysCap granted for joining handles.
//
// Beats:
//   1. Spawn asynchronous tasks via ProcessCap privilege.
//   2. Join running tasks and verify completion via SysCap privilege.
//   3. Assert join error semantics on invalid handles.
//
// CAP-G4 split (honest, no greenwash):
//   spawn -> async_spawn_internal prefers &ProcessCap (SysCap supersedes).
//   join  -> async_join_internal is hard SysCap-only residual by design.
// ProcessCap alone must not unlock join.

pub fn spawn_task(proc: &ProcessCap, task_name: String) -> String
    requires task_name.len() > 0
    ensures result.len() > 0
{
    return async_spawn_internal(proc, task_name);
}

pub fn join_task(sys: &SysCap, handle: String) -> Result[String, String] {
    return async_join_internal(sys, handle);
}

// Honesty probe: multi-cap main — ProcessCap for spawn, SysCap for join residual.
pub fn main(proc: &ProcessCap, sys: &SysCap) {
    let h = spawn_task(proc, "demo");
    let r = join_task(sys, h);
    assert_eq!(r.is_ok(), true);
    assert_eq!(join_task(sys, "not_a_handle").is_err(), true);
}
