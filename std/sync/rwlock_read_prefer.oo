// # Read-Preferring Reader-Writer Lock Module
//
// Logline: Shared reader / exclusive writer synchronization lock favoring reader throughput.
//
// Setup: Coordinates shared and exclusive critical sections under ThreadCap.
//
// Beats:
//   1. Construct RwLockReadPrefer with active readers count and writer active flag.
//   2. Acquire shared read lock when no writer is active.
//   3. Release shared read lock.
//   4. Acquire exclusive write lock when no readers or writers are active.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.
// residual: Host futex wait lowers to futex system call.

import "std/result.oo";

type RwLockReadPrefer = struct {
    reader_count: Int,
    writer_active: Bool
};

pub fn rwlock_read_prefer_new() -> RwLockReadPrefer {
    return RwLockReadPrefer {
        reader_count: 0,
        writer_active: false
    };
}

pub fn rwlock_acquire_read(thread: &ThreadCap, lock: RwLockReadPrefer) -> Result[RwLockReadPrefer, String] {
    let wa: Bool = lock.writer_active;
    if wa {
        return Err("WRITER_ACTIVE");
    }
    let cur_r: Int = lock.reader_count;
    return Ok(RwLockReadPrefer {
        reader_count: cur_r + 1,
        writer_active: false
    });
}

pub fn rwlock_release_read(thread: &ThreadCap, lock: RwLockReadPrefer) -> Result[RwLockReadPrefer, String] {
    let cur_r: Int = lock.reader_count;
    if cur_r <= 0 {
        return Err("NO_ACTIVE_READERS");
    }
    return Ok(RwLockReadPrefer {
        reader_count: cur_r - 1,
        writer_active: lock.writer_active
    });
}

pub fn rwlock_acquire_write(thread: &ThreadCap, lock: RwLockReadPrefer) -> Result[RwLockReadPrefer, String] {
    let cur_r: Int = lock.reader_count;
    let wa: Bool = lock.writer_active;
    if cur_r > 0 || wa {
        return Err("RESOURCE_BUSY");
    }
    return Ok(RwLockReadPrefer {
        reader_count: 0,
        writer_active: true
    });
}

pub fn rwlock_release_write(thread: &ThreadCap, lock: RwLockReadPrefer) -> Result[RwLockReadPrefer, String] {
    let wa: Bool = lock.writer_active;
    if !wa {
        return Err("WRITER_NOT_ACTIVE");
    }
    return Ok(RwLockReadPrefer {
        reader_count: lock.reader_count,
        writer_active: false
    });
}
