// # Audio Spectrogram & STFT Time-Frequency Analysis
//
// Logline: Configures Short-Time Fourier Transform (STFT) spectrogram frames, FFT windowing, and Mel-scale mapping.
//
// Setup: Pure multimedia digital signal processing module for audio spectral visualization and analysis.
//
// Beats:
//   1. Define SpectrogramConfig and SpectrogramFrame time-frequency records.
//   2. Map FFT frequency bin indices to physical Hz and compute time frame timestamps.
//   3. Compute logarithmic magnitude power (dBFS) and Mel-scale perceptual filterbank spacing.

pub type SpectrogramConfig = struct {
    fft_size: Int,
    hop_size: Int,
    sample_rate: Float,
    window_type: Int   // 0 = Rectangular, 1 = Hann, 2 = Hamming, 3 = Blackman
};

pub type SpectrogramFrame = struct {
    frame_index: Int,
    timestamp_sec: Float,
    magnitudes_db: List[Float]
};

pub fn spec_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn spec_int_to_f(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    return f;
}

pub fn spec_config_new(fft_size: Int, hop_size: Int, sample_rate: Float) -> SpectrogramConfig {
    return SpectrogramConfig {
        fft_size: fft_size,
        hop_size: hop_size,
        sample_rate: sample_rate,
        window_type: 1 // Hann default
    };
}

pub fn spec_bin_to_freq_hz(cfg: &SpectrogramConfig, bin_idx: Int) -> Float {
    let bin_f: Float = spec_int_to_f(bin_idx);
    let fft_f: Float = spec_int_to_f((cfg).fft_size);
    return (bin_f * (cfg).sample_rate) / fft_f;
}

pub fn spec_num_frequency_bins(cfg: &SpectrogramConfig) -> Int {
    // (N / 2) + 1 positive frequency bins (DC through Nyquist)
    return ((cfg).fft_size / 2) + 1;
}

pub fn spec_frame_timestamp(cfg: &SpectrogramConfig, frame_idx: Int) -> Float {
    let sample_idx: Float = spec_int_to_f(frame_idx * (cfg).hop_size);
    return sample_idx / (cfg).sample_rate;
}

pub fn spec_hz_to_mel(freq_hz: Float) -> Float {
    // Mel(f) = 2595 * log10(1 + f / 700)
    let val: Float = 1.0 + (freq_hz / 700.0);
    let mut k: Float = 0.0;
    let mut v: Float = val;
    while v > 2.0 { v = v / 2.718281828459045; k = k + 1.0; }
    while v < 0.7 { v = v * 2.718281828459045; k = k - 1.0; }

    let y: Float = (v - 1.0) / (v + 1.0);
    let y2: Float = y * y;
    let y3: Float = y2 * y;
    let ln_v: Float = (2.0 * (y + (y3 / 3.0))) + (k * 1.0);
    let log10_val: Float = ln_v / 2.302585092994046;

    return 2595.0 * log10_val;
}

pub fn spec_hann_window(idx: Int, size: Int) -> Float {
    let n_f: Float = spec_int_to_f(idx);
    let m_f: Float = spec_int_to_f(size - 1);
    let two_pi: Float = 2.0 * spec_pi();
    return 0.5 - (0.5 * cos((two_pi * n_f) / m_f));
}
