// # RIFF WAVE Header Protocol
//
// Logline: Defines canonical 44-byte RIFF/WAVE header fields, block alignments, and format tag validation.
//
// Setup: Pure multimedia codec module for Microsoft/IBM RIFF audio file format processing.
//
// Beats:
//   1. Define WavHeader record for canonical 44-byte standard WAVE headers.
//   2. Calculate ByteRate, BlockAlign, and subchunk byte offsets.
//   3. Validate RIFF/WAVE FourCC magic identifiers and PCM format constraints.

pub type WavHeader = struct {
    riff_magic: String,     // "RIFF"
    riff_size: Int,         // 36 + data_size
    wave_magic: String,     // "WAVE"
    fmt_magic: String,      // "fmt "
    fmt_size: Int,          // 16 for PCM
    audio_format: Int,      // 1 = Linear PCM, 3 = IEEE Float
    num_channels: Int,      // 1 = Mono, 2 = Stereo
    sample_rate: Int,
    byte_rate: Int,
    block_align: Int,
    bits_per_sample: Int,
    data_magic: String,     // "data"
    data_size: Int
};

pub fn wav_header_new(sample_rate: Int, channels: Int, bits_per_sample: Int, num_frames: Int) -> Result[WavHeader, String] {
    if sample_rate <= 0 {
        return Err("Sample rate must be positive");
    }
    if channels <= 0 || channels > 32 {
        return Err("Channel count must be between 1 and 32");
    }
    if bits_per_sample != 8 && bits_per_sample != 16 && bits_per_sample != 24 && bits_per_sample != 32 {
        return Err("Bits per sample must be 8, 16, 24, or 32");
    }

    let bytes_per_sample: Int = bits_per_sample / 8;
    let block_align: Int = channels * bytes_per_sample;
    let byte_rate: Int = sample_rate * block_align;
    let data_bytes: Int = num_frames * block_align;
    let riff_size: Int = 36 + data_bytes;

    return Ok(WavHeader {
        riff_magic: "RIFF",
        riff_size: riff_size,
        wave_magic: "WAVE",
        fmt_magic: "fmt ",
        fmt_size: 16,
        audio_format: 1, // PCM
        num_channels: channels,
        sample_rate: sample_rate,
        byte_rate: byte_rate,
        block_align: block_align,
        bits_per_sample: bits_per_sample,
        data_magic: "data",
        data_size: data_bytes
    });
}

pub fn wav_header_is_valid(hdr: &WavHeader) -> Bool {
    if (hdr).riff_magic != "RIFF" { return false; }
    if (hdr).wave_magic != "WAVE" { return false; }
    if (hdr).fmt_magic != "fmt " { return false; }
    if (hdr).data_magic != "data" { return false; }
    if (hdr).audio_format != 1 && (hdr).audio_format != 3 { return false; }
    if (hdr).num_channels <= 0 { return false; }
    if (hdr).sample_rate <= 0 { return false; }
    if (hdr).bits_per_sample != 8 && (hdr).bits_per_sample != 16 && (hdr).bits_per_sample != 24 && (hdr).bits_per_sample != 32 {
        return false;
    }
    let expected_align: Int = (hdr).num_channels * ((hdr).bits_per_sample / 8);
    if (hdr).block_align != expected_align { return false; }
    let expected_byte_rate: Int = (hdr).sample_rate * expected_align;
    if (hdr).byte_rate != expected_byte_rate { return false; }
    return true;
}

pub fn wav_header_num_frames(hdr: &WavHeader) -> Int {
    if (hdr).block_align <= 0 { return 0; }
    return (hdr).data_size / (hdr).block_align;
}
