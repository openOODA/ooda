// # HSV converter body
//
// Logline: Converts RGB 0..255 to HSV and inverts HSV back to RGB.
//
// Setup: Pure. Called from color_spaces.oo. S and V are 0..100.
//
// Beats:
//   1. Scale RGB and find max and min.
//   2. Compute hue, saturation, and value.
//   3. Invert HSV through the six hue sectors.

pub type ColorOut = struct {
    flag: Int,
    err: String,
    h: Float,
    s: Float,
    v: Float,
    r: Float,
    g: Float,
    b: Float
};

fn hsv_itof(n: Int) -> Float {
    let mut x: Float = 0.0;
    let mut i: Int = 0;
    let mut m: Int = n;
    if m < 0 {
        m = 0 - m;
    }
    while i < m {
        x = x + 1.0;
        i = i + 1;
    }
    if n < 0 {
        return 0.0 - x;
    }
    return x;
}

fn hsv_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

pub fn color_spaces_hsv_from_rgb(r: Int, g: Int, b: Int) -> ColorOut {
    if r < 0 {
        return ColorOut { flag: 0, err: "color rgb", h: 0.0, s: 0.0, v: 0.0, r: 0.0, g: 0.0, b: 0.0 };
    }
    if g < 0 {
        return ColorOut { flag: 0, err: "color rgb", h: 0.0, s: 0.0, v: 0.0, r: 0.0, g: 0.0, b: 0.0 };
    }
    if b < 0 {
        return ColorOut { flag: 0, err: "color rgb", h: 0.0, s: 0.0, v: 0.0, r: 0.0, g: 0.0, b: 0.0 };
    }
    if r > 255 {
        return ColorOut { flag: 0, err: "color rgb", h: 0.0, s: 0.0, v: 0.0, r: 0.0, g: 0.0, b: 0.0 };
    }
    if g > 255 {
        return ColorOut { flag: 0, err: "color rgb", h: 0.0, s: 0.0, v: 0.0, r: 0.0, g: 0.0, b: 0.0 };
    }
    if b > 255 {
        return ColorOut { flag: 0, err: "color rgb", h: 0.0, s: 0.0, v: 0.0, r: 0.0, g: 0.0, b: 0.0 };
    }
    let rf: Float = hsv_itof(r) / 255.0;
    let gf: Float = hsv_itof(g) / 255.0;
    let bf: Float = hsv_itof(b) / 255.0;
    let mut mx: Float = rf;
    if gf > mx {
        mx = gf;
    }
    if bf > mx {
        mx = bf;
    }
    let mut mn: Float = rf;
    if gf < mn {
        mn = gf;
    }
    if bf < mn {
        mn = bf;
    }
    let d: Float = mx - mn;
    let mut s: Float = 0.0;
    if mx > 0.0 {
        s = d / mx;
    }
    let mut h: Float = 0.0;
    if d > 0.0 {
        if mx == rf {
            h = 60.0 * ((gf - bf) / d);
        } else {
            if mx == gf {
                h = 60.0 * (2.0 + ((bf - rf) / d));
            } else {
                h = 60.0 * (4.0 + ((rf - gf) / d));
            }
        }
        if h < 0.0 {
            h = h + 360.0;
        }
    }
    return ColorOut { flag: 1, err: "", h: h, s: s * 100.0, v: mx * 100.0, r: hsv_itof(r), g: hsv_itof(g), b: hsv_itof(b) };
}

pub fn color_spaces_hsv_to_rgb_fn(h: Float, s: Float, v: Float) -> ColorOut {
    let ss: Float = s / 100.0;
    let vv: Float = v / 100.0;
    let c: Float = vv * ss;
    let hp: Float = h / 60.0;
    let mut hmod: Float = hp;
    while hmod >= 2.0 {
        hmod = hmod - 2.0;
    }
    let x: Float = c * (1.0 - hsv_abs(hmod - 1.0));
    let m: Float = vv - c;
    let mut r1: Float = 0.0;
    let mut g1: Float = 0.0;
    let mut b1: Float = 0.0;
    if hp < 1.0 {
        r1 = c;
        g1 = x;
    } else {
        if hp < 2.0 {
            r1 = x;
            g1 = c;
        } else {
            if hp < 3.0 {
                g1 = c;
                b1 = x;
            } else {
                if hp < 4.0 {
                    g1 = x;
                    b1 = c;
                } else {
                    if hp < 5.0 {
                        r1 = x;
                        b1 = c;
                    } else {
                        r1 = c;
                        b1 = x;
                    }
                }
            }
        }
    }
    return ColorOut { flag: 1, err: "", h: h, s: s, v: v, r: (r1 + m) * 255.0, g: (g1 + m) * 255.0, b: (b1 + m) * 255.0 };
}
