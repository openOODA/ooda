// # PNG Header & Signature Protocol
//
// Logline: Validates PNG signatures, defines IHDR chunks, and validates color types, bit depths, and dimensions.
//
// Setup: Pure multimedia codec module for ISO/IEC 15948 PNG stream parsing.
//
// Beats:
//   1. Validate 8-byte standard PNG magic signature bytes.
//   2. Define PngIhdr header structure and standard color type constants.
//   3. Compute scanline strides, channel counts, and bits-per-pixel dimensions.

pub type PngIhdr = struct {
    width: Int,
    height: Int,
    bit_depth: Int,
    color_type: Int,
    compression_method: Int,
    filter_method: Int,
    interlace_method: Int
};

pub fn png_magic_byte(idx: Int) -> Int {
    if idx == 0 { return 137; } // 0x89
    if idx == 1 { return 80; }  // 'P'
    if idx == 2 { return 78; }  // 'N'
    if idx == 3 { return 71; }  // 'G'
    if idx == 4 { return 13; }  // \r
    if idx == 5 { return 10; }  // \n
    if idx == 6 { return 26; }  // 0x1A (EOF)
    if idx == 7 { return 10; }  // \n
    return 0;
}

pub fn png_signature_valid(b0: Int, b1: Int, b2: Int, b3: Int, b4: Int, b5: Int, b6: Int, b7: Int) -> Bool {
    if b0 != 137 { return false; }
    if b1 != 80 { return false; }
    if b2 != 78 { return false; }
    if b3 != 71 { return false; }
    if b4 != 13 { return false; }
    if b5 != 10 { return false; }
    if b6 != 26 { return false; }
    if b7 != 10 { return false; }
    return true;
}

pub fn png_color_type_channels(color_type: Int) -> Int {
    // 0 = Grayscale (1 channel)
    // 2 = Truecolor RGB (3 channels)
    // 3 = Indexed-color (1 channel index)
    // 4 = Grayscale + Alpha (2 channels)
    // 6 = Truecolor + Alpha RGBA (4 channels)
    if color_type == 0 { return 1; }
    if color_type == 2 { return 3; }
    if color_type == 3 { return 1; }
    if color_type == 4 { return 2; }
    if color_type == 6 { return 4; }
    return 0;
}

pub fn png_color_type_valid(color_type: Int, bit_depth: Int) -> Bool {
    if color_type == 0 {
        return bit_depth == 1 || bit_depth == 2 || bit_depth == 4 || bit_depth == 8 || bit_depth == 16;
    }
    if color_type == 2 {
        return bit_depth == 8 || bit_depth == 16;
    }
    if color_type == 3 {
        return bit_depth == 1 || bit_depth == 2 || bit_depth == 4 || bit_depth == 8;
    }
    if color_type == 4 {
        return bit_depth == 8 || bit_depth == 16;
    }
    if color_type == 6 {
        return bit_depth == 8 || bit_depth == 16;
    }
    return false;
}

pub fn png_ihdr_new(width: Int, height: Int, bit_depth: Int, color_type: Int, interlace: Int) -> Result[PngIhdr, String] {
    if width <= 0 || height <= 0 {
        return Err("PNG dimensions must be positive non-zero integers");
    }
    if png_color_type_valid(color_type, bit_depth) == false {
        return Err("Invalid bit depth for given PNG color type");
    }
    if interlace != 0 && interlace != 1 {
        return Err("Invalid PNG interlace method; must be 0 (None) or 1 (Adam7)");
    }
    return Ok(PngIhdr {
        width: width,
        height: height,
        bit_depth: bit_depth,
        color_type: color_type,
        compression_method: 0,
        filter_method: 0,
        interlace_method: interlace
    });
}

pub fn png_ihdr_bytes_per_pixel(ihdr: &PngIhdr) -> Int {
    let channels: Int = png_color_type_channels((ihdr).color_type);
    let total_bits: Int = channels * (ihdr).bit_depth;
    let bytes: Int = (total_bits + 7) / 8;
    if bytes < 1 {
        return 1;
    }
    return bytes;
}

pub fn png_ihdr_scanline_raw_bytes(ihdr: &PngIhdr) -> Int {
    let channels: Int = png_color_type_channels((ihdr).color_type);
    let bits_per_pixel: Int = channels * (ihdr).bit_depth;
    let row_bits: Int = (ihdr).width * bits_per_pixel;
    let row_bytes: Int = (row_bits + 7) / 8;
    // 1 byte filter type prefix per scanline
    return 1 + row_bytes;
}

pub fn png_ihdr_is_valid(ihdr: &PngIhdr) -> Bool {
    if (ihdr).width <= 0 || (ihdr).height <= 0 { return false; }
    if (ihdr).compression_method != 0 { return false; }
    if (ihdr).filter_method != 0 { return false; }
    if (ihdr).interlace_method != 0 && (ihdr).interlace_method != 1 { return false; }
    return png_color_type_valid((ihdr).color_type, (ihdr).bit_depth);
}
