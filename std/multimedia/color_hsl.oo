// # HSL Color Space Representation & Manipulations
//
// Logline: Implements HSL (Hue, Saturation, Lightness) model conversions, lightness scaling, and tint shifts.
//
// Setup: Pure multimedia colorimetric module for CSS-standard HSL and photographic adjustments.
//
// Beats:
//   1. Define ColorHsl record (Hue in degrees, Saturation and Lightness in [0..1]).
//   2. Implement standard bidirectional RGB-to-HSL and HSL-to-RGB conversions.
//   3. Provide lightness tinting and color temperature adjustment functions.

import "./color_rgb.oo";

pub type ColorHsl = struct {
    h: Float, // [0.0 .. 360.0)
    s: Float, // [0.0 .. 1.0]
    l: Float, // [0.0 .. 1.0]
};

pub fn color_hsl_abs(v: Float) -> Float {
    if v < 0.0 { return 0.0 - v; }
    return v;
}

pub fn color_hsl_new(h: Float, s: Float, l: Float) -> ColorHsl {
    let mut ch: Float = h;
    while ch >= 360.0 { ch = ch - 360.0; }
    while ch < 0.0 { ch = ch + 360.0; }

    let mut cs: Float = s;
    if cs < 0.0 { cs = 0.0; } if cs > 1.0 { cs = 1.0; }

    let mut cl: Float = l;
    if cl < 0.0 { cl = 0.0; } if cl > 1.0 { cl = 1.0; }

    return ColorHsl { h: ch, s: cs, l: cl };
}

pub fn color_rgb_to_hsl(c: &ColorRgbF) -> ColorHsl {
    let r: Float = (c).r;
    let g: Float = (c).g;
    let b: Float = (c).b;

    let mut max_val: Float = r;
    if g > max_val { max_val = g; }
    if b > max_val { max_val = b; }

    let mut min_val: Float = r;
    if g < min_val { min_val = g; }
    if b < min_val { min_val = b; }

    let delta: Float = max_val - min_val;
    let l: Float = (max_val + min_val) / 2.0;

    let mut s: Float = 0.0;
    if delta > 0.00001 {
        let denom: Float = 1.0 - color_hsl_abs((2.0 * l) - 1.0);
        if denom > 0.00001 {
            s = delta / denom;
        }
    }

    let mut h: Float = 0.0;
    if delta > 0.00001 {
        if max_val == r {
            h = 60.0 * ((g - b) / delta);
        } else if max_val == g {
            h = 60.0 * (2.0 + ((b - r) / delta));
        } else {
            h = 60.0 * (4.0 + ((r - g) / delta));
        }
        if h < 0.0 {
            h = h + 360.0;
        }
    }

    return ColorHsl { h: h, s: s, l: l };
}

pub fn color_hsl_hue_to_rgb(p: Float, q: Float, t_in: Float) -> Float {
    let mut t: Float = t_in;
    if t < 0.0 { t = t + 1.0; }
    if t > 1.0 { t = t - 1.0; }
    if t < 0.166666666667 { return p + ((q - p) * 6.0 * t); }
    if t < 0.5 { return q; }
    if t < 0.666666666667 { return p + ((q - p) * (0.666666666667 - t) * 6.0); }
    return p;
}

pub fn color_hsl_to_rgb(hsl: &ColorHsl) -> ColorRgbF {
    let h: Float = (hsl).h / 360.0;
    let s: Float = (hsl).s;
    let l: Float = (hsl).l;

    if s <= 0.00001 {
        return ColorRgbF { r: l, g: l, b: l };
    }

    let mut q: Float = l * (1.0 + s);
    if l >= 0.5 {
        q = (l + s) - (l * s);
    }
    let p: Float = (2.0 * l) - q;

    let r: Float = color_hsl_hue_to_rgb(p, q, h + 0.333333333333);
    let g: Float = color_hsl_hue_to_rgb(p, q, h);
    let b: Float = color_hsl_hue_to_rgb(p, q, h - 0.333333333333);

    return ColorRgbF { r: r, g: g, b: b };
}

pub fn color_hsl_adjust_lightness(hsl: &ColorHsl, delta: Float) -> ColorHsl {
    return color_hsl_new((hsl).h, (hsl).s, (hsl).l + delta);
}
