// # RGB Color Space & Gamma Transfer Functions
//
// Logline: Implements 8-bit integer and normalized float RGB/RGBA colors, sRGB gamma transfer, and Rec.709 luma.
//
// Setup: Pure multimedia colorimetric module for RGB color processing and ITU-R BT.709 conversions.
//
// Beats:
//   1. Define ColorRgb, ColorRgba, and floating-point normalized representations.
//   2. Implement 32-bit ARGB/RGBA packing/unpacking and channel clamping.
//   3. Compute ITU-R BT.709 perceived luminance and sRGB gamma expansion/compression.

type ColorRgb = struct {
    r: Int,
    g: Int,
    b: Int,
};

type ColorRgba = struct {
    r: Int,
    g: Int,
    b: Int,
    a: Int,
};

type ColorRgbF = struct {
    r: Float,
    g: Float,
    b: Float,
};

type ColorRgbaF = struct {
    r: Float,
    g: Float,
    b: Float,
    a: Float,
};

pub fn color_rgb_new(r: Int, g: Int, b: Int) -> ColorRgb {
    let mut cr: Int = r;
    let mut cg: Int = g;
    let mut cb: Int = b;
    if cr < 0 { cr = 0; } if cr > 255 { cr = 255; }
    if cg < 0 { cg = 0; } if cg > 255 { cg = 255; }
    if cb < 0 { cb = 0; } if cb > 255 { cb = 255; }
    return ColorRgb { r: cr, g: cg, b: cb };
}

pub fn color_rgba_new(r: Int, g: Int, b: Int, a: Int) -> ColorRgba {
    let mut cr: Int = r;
    let mut cg: Int = g;
    let mut cb: Int = b;
    let mut ca: Int = a;
    if cr < 0 { cr = 0; } if cr > 255 { cr = 255; }
    if cg < 0 { cg = 0; } if cg > 255 { cg = 255; }
    if cb < 0 { cb = 0; } if cb > 255 { cb = 255; }
    if ca < 0 { ca = 0; } if ca > 255 { ca = 255; }
    return ColorRgba { r: cr, g: cg, b: cb, a: ca };
}

pub fn color_pack_rgba32(c: &ColorRgba) -> Int {
    return (((c).r & 255) << 24) | (((c).g & 255) << 16) | (((c).b & 255) << 8) | ((c).a & 255);
}

pub fn color_unpack_rgba32(packed: Int) -> ColorRgba {
    let r: Int = (packed >> 24) & 255;
    let g: Int = (packed >> 16) & 255;
    let b: Int = (packed >> 8) & 255;
    let a: Int = packed & 255;
    return ColorRgba { r: r, g: g, b: b, a: a };
}

pub fn color_int_to_f(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    return f;
}

pub fn color_to_float(c: &ColorRgba) -> ColorRgbaF {
    return ColorRgbaF {
        r: color_int_to_f((c).r) / 255.0,
        g: color_int_to_f((c).g) / 255.0,
        b: color_int_to_f((c).b) / 255.0,
        a: color_int_to_f((c).a) / 255.0,
    };
}

pub fn color_rec709_luminance(c: &ColorRgbF) -> Float {
    // Rec. 709 luma coefficients
    return (0.2126 * (c).r) + (0.7152 * (c).g) + (0.0722 * (c).b);
}

pub fn color_srgb_gamma_expand(c: Float) -> Float {
    if c <= 0.04045 {
        return c / 12.92;
    }
    // Approximation for ((c + 0.055)/1.055)^2.4
    let base: Float = (c + 0.055) / 1.055;
    let base2: Float = base * base;
    let sqrt_base: Float = sqrt(base);
    return base2 * sqrt_base; // ~2.5 exponent approximation
}

pub fn color_srgb_gamma_compress(c: Float) -> Float {
    if c <= 0.0031308 {
        return c * 12.92;
    }
    // Approximation for 1.055 * c^(1/2.4) - 0.055
    let sqrt_c: Float = sqrt(c);
    let fourth_root: Float = sqrt(sqrt_c);
    let root_2_4: Float = (sqrt_c + fourth_root) / 2.0; // ~0.416 exponent
    return (1.055 * root_2_4) - 0.055;
}
