// # HSV Cylindrical Color Space
//
// Logline: Implements HSV (Hue, Saturation, Value) color conversions, hue shifting, and saturation adjustment.
//
// Setup: Pure multimedia colorimetric module for cylindrical color space transformations.
//
// Beats:
//   1. Define ColorHsv data structure (Hue in [0..360), Saturation [0..1], Value [0..1]).
//   2. Convert between linear/normalized RGB and cylindrical HSV representations.
//   3. Provide chromatic rotation, saturation boost, and value scaling routines.

import "./color_rgb.oo";

pub type ColorHsv = struct {
    h: Float, // [0.0 .. 360.0)
    s: Float, // [0.0 .. 1.0]
    v: Float // [0.0 .. 1.0]
};

pub fn color_hsv_new(h: Float, s: Float, v: Float) -> ColorHsv {
    let mut ch: Float = h;
    while ch >= 360.0 { ch = ch - 360.0; }
    while ch < 0.0 { ch = ch + 360.0; }

    let mut cs: Float = s;
    if cs < 0.0 { cs = 0.0; } if cs > 1.0 { cs = 1.0; }

    let mut cv: Float = v;
    if cv < 0.0 { cv = 0.0; } if cv > 1.0 { cv = 1.0; }

    return ColorHsv { h: ch, s: cs, v: cv };
}

pub fn color_rgb_to_hsv(c: &ColorRgbF) -> ColorHsv {
    let r: Float = (c).r;
    let g: Float = (c).g;
    let b: Float = (c).b;

    let mut max_val: Float = r;
    if g > max_val { max_val = g; }
    if b > max_val { max_val = b; }

    let mut min_val: Float = r;
    if g < min_val { min_val = g; }
    if b < min_val { min_val = b; }

    let delta: Float = max_val - min_val;
    let v: Float = max_val;

    let mut s: Float = 0.0;
    if max_val > 0.00001 {
        s = delta / max_val;
    }

    let mut h: Float = 0.0;
    if delta > 0.00001 {
        if max_val == r {
            h = 60.0 * ((g - b) / delta);
        } else if max_val == g {
            h = 60.0 * (2.0 + ((b - r) / delta));
        } else {
            h = 60.0 * (4.0 + ((r - g) / delta));
        }
        if h < 0.0 {
            h = h + 360.0;
        }
    }

    return ColorHsv { h: h, s: s, v: v };
}

pub fn color_hsv_to_rgb(hsv: &ColorHsv) -> ColorRgbF {
    let h: Float = (hsv).h;
    let s: Float = (hsv).s;
    let v: Float = (hsv).v;

    if s <= 0.00001 {
        return ColorRgbF { r: v, g: v, b: v };
    }

    let sector: Float = h / 60.0;
    let mut i: Int = 0;
    let mut count: Float = sector;
    while count >= 1.0 { i = i + 1; count = count - 1.0; }

    let f: Float = count;
    let p: Float = v * (1.0 - s);
    let q: Float = v * (1.0 - (s * f));
    let t: Float = v * (1.0 - (s * (1.0 - f)));

    if i == 0 { return ColorRgbF { r: v, g: t, b: p }; }
    if i == 1 { return ColorRgbF { r: q, g: v, b: p }; }
    if i == 2 { return ColorRgbF { r: p, g: v, b: t }; }
    if i == 3 { return ColorRgbF { r: p, g: q, b: v }; }
    if i == 4 { return ColorRgbF { r: t, g: p, b: v }; }
    return ColorRgbF { r: v, g: p, b: q };
}

pub fn color_hsv_shift_hue(hsv: &ColorHsv, delta_degrees: Float) -> ColorHsv {
    return color_hsv_new((hsv).h + delta_degrees, (hsv).s, (hsv).v);
}
