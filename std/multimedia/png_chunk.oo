// # PNG Chunk Structure & CRC Integrity
//
// Logline: Encapsulates PNG chunk formatting, Critical vs Ancillary classification, and CRC-32 validation.
//
// Setup: Pure multimedia codec module for ISO/IEC 15948 PNG stream chunk processing.
//
// Beats:
//   1. Implement IEEE 802.3 bitwise CRC-32 accumulator step.
//   2. Define PngChunk structure with FourCC identifier, payload length, and checksum.
//   3. Provide chunk classification methods (critical, ancillary, private, safe-to-copy).

pub type PngChunk = struct {
    chunk_type: String,
    length: Int,
    data: List[Int],
    crc: Int,
};

pub fn png_crc32_byte_table(idx: Int) -> Int {
    let mut c: Int = idx;
    let mut k: Int = 0;
    while k < 8 {
        if (c & 1) != 0 {
            c = -306674912 ^ ((c >> 1) & 2147483647); // 0xEDB88320
        } else {
            c = (c >> 1) & 2147483647;
        }
        k = k + 1;
    }
    return c;
}

pub fn png_crc32_update(crc: Int, byte_val: Int) -> Int {
    let table_idx: Int = (crc ^ byte_val) & 255;
    let table_val: Int = png_crc32_byte_table(table_idx);
    let shifted: Int = (crc >> 8) & 16777215;
    return table_val ^ shifted;
}

pub fn png_crc32_calculate(bytes: List[Int]) -> Int {
    let mut crc: Int = -1; // 0xFFFFFFFF
    let n: Int = list_len(bytes);
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(bytes, i);
        crc = png_crc32_update(crc, b & 255);
        i = i + 1;
    }
    return crc ^ -1;
}

pub fn png_chunk_new(chunk_type: String, data: List[Int]) -> PngChunk {
    let len: Int = list_len(data);
    let crc: Int = png_crc32_calculate(data);
    return PngChunk {
        chunk_type: chunk_type,
        length: len,
        data: data,
        crc: crc,
    };
}

pub fn png_chunk_is_ihdr(chunk: &PngChunk) -> Bool {
    return (chunk).chunk_type == "IHDR";
}

pub fn png_chunk_is_idat(chunk: &PngChunk) -> Bool {
    return (chunk).chunk_type == "IDAT";
}

pub fn png_chunk_is_iend(chunk: &PngChunk) -> Bool {
    return (chunk).chunk_type == "IEND";
}

pub fn png_chunk_is_plte(chunk: &PngChunk) -> Bool {
    return (chunk).chunk_type == "PLTE";
}

pub fn png_chunk_is_critical(chunk: &PngChunk) -> Bool {
    let t: String = (chunk).chunk_type;
    return t == "IHDR" || t == "PLTE" || t == "IDAT" || t == "IEND";
}

pub fn png_chunk_is_ancillary(chunk: &PngChunk) -> Bool {
    return png_chunk_is_critical(chunk) == false;
}

pub fn png_chunk_total_bytes(chunk: &PngChunk) -> Int {
    // 4 bytes length + 4 bytes type + N bytes data + 4 bytes CRC
    return 12 + (chunk).length;
}
