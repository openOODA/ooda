// # RGB HSL HSV converters
//
// Logline: Converts RGB 0..255 to HSL and HSV with H 0..360 and S,L,V 0..100, then inverts the transforms.
//
// Setup: Pure. Float arithmetic. Inverse round-trips stay within a tight RGB tolerance.
//
// Beats:
//   1. Scale RGB to 0..1 and find max and min.
//   2. Compute HSL and HSV from those extrema.
//   3. Invert HSL and HSV back to RGB.
//   4. Reject channels outside 0..255.

import "std/multimedia/color_spaces_hsv.oo";

fn cs_err(m: String) -> ColorOut {
    return ColorOut { flag: 0, err: m, h: 0.0, s: 0.0, v: 0.0, r: 0.0, g: 0.0, b: 0.0 };
}

fn cs_ok(h: Float, s: Float, v: Float, r: Float, g: Float, b: Float) -> ColorOut {
    return ColorOut { flag: 1, err: "", h: h, s: s, v: v, r: r, g: g, b: b };
}

fn cs_itof(n: Int) -> Float {
    let mut x: Float = 0.0;
    let mut i: Int = 0;
    let mut m: Int = n;
    if m < 0 {
        m = 0 - m;
    }
    while i < m {
        x = x + 1.0;
        i = i + 1;
    }
    if n < 0 {
        return 0.0 - x;
    }
    return x;
}

fn cs_abs(x: Float) -> Float {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

fn cs_chan(c: Int) -> Result[Float, String] {
    if c < 0 {
        return Err("color rgb");
    }
    if c > 255 {
        return Err("color rgb");
    }
    return Ok(cs_itof(c) / 255.0);
}

fn cs_hue(r: Float, g: Float, b: Float, mx: Float, d: Float) -> Float {
    if d <= 0.0 {
        return 0.0;
    }
    let mut h: Float = 0.0;
    if mx == r {
        h = 60.0 * ((g - b) / d);
    } else {
        if mx == g {
            h = 60.0 * (2.0 + ((b - r) / d));
        } else {
            h = 60.0 * (4.0 + ((r - g) / d));
        }
    }
    if h < 0.0 {
        h = h + 360.0;
    }
    return h;
}

fn cs_max3(r: Float, g: Float, b: Float) -> Float {
    let mut m: Float = r;
    if g > m {
        m = g;
    }
    if b > m {
        m = b;
    }
    return m;
}

fn cs_min3(r: Float, g: Float, b: Float) -> Float {
    let mut m: Float = r;
    if g < m {
        m = g;
    }
    if b < m {
        m = b;
    }
    return m;
}

pub fn color_spaces_rgb_to_hsl(r: Int, g: Int, b: Int) -> ColorOut {
    let rr: Result[Float, String] = cs_chan(r);
    let gg: Result[Float, String] = cs_chan(g);
    let bb: Result[Float, String] = cs_chan(b);
    let mut rf: Float = 0.0;
    let mut gf: Float = 0.0;
    let mut bf: Float = 0.0;
    match rr {
        Ok(x) => {
            rf = x;
        },
        Err(e) => {
            return cs_err(e);
        }
    }
    match gg {
        Ok(y) => {
            gf = y;
        },
        Err(e2) => {
            return cs_err(e2);
        }
    }
    match bb {
        Ok(z) => {
            bf = z;
        },
        Err(e3) => {
            return cs_err(e3);
        }
    }
    let mx: Float = cs_max3(rf, gf, bf);
    let mn: Float = cs_min3(rf, gf, bf);
    let d: Float = mx - mn;
    let l: Float = (mx + mn) / 2.0;
    let mut s: Float = 0.0;
    let den: Float = 1.0 - cs_abs(2.0 * l - 1.0);
    if d > 0.0 {
        if den > 0.0 {
            s = d / den;
        }
    }
    let h: Float = cs_hue(rf, gf, bf, mx, d);
    return cs_ok(h, s * 100.0, l * 100.0, cs_itof(r), cs_itof(g), cs_itof(b));
}

pub fn color_spaces_hsl_to_rgb(h: Float, s: Float, l: Float) -> ColorOut {
    let ss: Float = s / 100.0;
    let ll: Float = l / 100.0;
    let c: Float = (1.0 - cs_abs(2.0 * ll - 1.0)) * ss;
    let hp: Float = h / 60.0;
    let mut hmod: Float = hp;
    while hmod >= 2.0 {
        hmod = hmod - 2.0;
    }
    let x: Float = c * (1.0 - cs_abs(hmod - 1.0));
    let m: Float = ll - c / 2.0;
    let mut r1: Float = 0.0;
    let mut g1: Float = 0.0;
    let mut b1: Float = 0.0;
    if hp < 1.0 {
        r1 = c;
        g1 = x;
    } else {
        if hp < 2.0 {
            r1 = x;
            g1 = c;
        } else {
            if hp < 3.0 {
                g1 = c;
                b1 = x;
            } else {
                if hp < 4.0 {
                    g1 = x;
                    b1 = c;
                } else {
                    if hp < 5.0 {
                        r1 = x;
                        b1 = c;
                    } else {
                        r1 = c;
                        b1 = x;
                    }
                }
            }
        }
    }
    return cs_ok(h, s, l, (r1 + m) * 255.0, (g1 + m) * 255.0, (b1 + m) * 255.0);
}

pub fn color_spaces_rgb_to_hsv(r: Int, g: Int, b: Int) -> ColorOut { return color_spaces_hsv_from_rgb(r, g, b); }

pub fn color_spaces_hsv_to_rgb(h: Float, s: Float, v: Float) -> ColorOut { return color_spaces_hsv_to_rgb_fn(h, s, v); }

pub fn color_spaces_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}
