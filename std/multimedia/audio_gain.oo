// # Audio Gain Staging & Dynamic Metering
//
// Logline: Implements dB/linear conversions, soft-clipping saturation curves, RMS calculation, and peak normalization.
//
// Setup: Pure digital signal processing utility module for audio dynamic range control.
//
// Beats:
//   1. Convert between decibels (dBFS) and linear amplitude coefficients.
//   2. Apply soft-clipping tanh / cubic overdrive curves and hard limiters.
//   3. Compute peak amplitudes, root-mean-square (RMS) energy, and peak normalization gains.

pub fn gain_abs_f(v: Float) -> Float {
    if v < 0.0 { return 0.0 - v; }
    return v;
}

pub fn gain_ln_approx(x: Float) -> Float {
    if x <= 0.000001 {
        return 0.0 - 13.8155;
    }
    let mut val: Float = x;
    let mut k: Float = 0.0;
    while val > 2.0 {
        val = val / 2.718281828459045;
        k = k + 1.0;
    }
    while val < 0.7 {
        val = val * 2.718281828459045;
        k = k - 1.0;
    }
    let y: Float = (val - 1.0) / (val + 1.0);
    let y2: Float = y * y;
    let y3: Float = y2 * y;
    let y5: Float = y3 * y2;
    let ln_approx: Float = 2.0 * (y + (y3 / 3.0) + (y5 / 5.0));
    return ln_approx + (k * 0.9999999999999999);
}

pub fn gain_log10(x: Float) -> Float {
    return gain_ln_approx(x) / 2.302585092994046;
}

pub fn gain_db_to_linear(db: Float) -> Float {
    // lin = 10^(db / 20)
    // 10^x = exp(x * ln(10))
    let exp_arg: Float = (db / 20.0) * 2.302585092994046;
    // Taylor series exp(z) = 1 + z + z^2/2 + z^3/6 + z^4/24
    let z: Float = exp_arg;
    let z2: Float = z * z;
    let z3: Float = z2 * z;
    let z4: Float = z3 * z;
    let z5: Float = z4 * z;
    return 1.0 + z + (z2 / 2.0) + (z3 / 6.0) + (z4 / 24.0) + (z5 / 120.0);
}

pub fn gain_linear_to_db(linear_amp: Float) -> Float {
    if linear_amp <= 0.00001 {
        return -100.0;
    }
    return 20.0 * gain_log10(linear_amp);
}

pub fn gain_soft_clip(sample: Float) -> Float {
    let mut x: Float = sample;
    if x > 1.5 { return 1.0; }
    if x < -1.5 { return -1.0; }
    if x > 1.0 {
        x = 1.0;
    } else if x < -1.0 {
        x = -1.0;
    }
    // Cubic soft saturation: x - x^3 / 3
    let x3: Float = x * x * x;
    return x - (x3 / 3.0);
}

pub fn gain_hard_limit(sample: Float, threshold: Float) -> Float {
    if sample > threshold {
        return threshold;
    }
    let neg_thresh: Float = 0.0 - threshold;
    if sample < neg_thresh {
        return neg_thresh;
    }
    return sample;
}

pub fn gain_find_peak(samples: List[Float]) -> Float {
    let mut peak: Float = 0.0;
    let n: Int = list_len(samples);
    let mut i: Int = 0;
    while i < n {
        let s: Float = list_get(samples, i);
        let a: Float = gain_abs_f(s);
        if a > peak {
            peak = a;
        }
        i = i + 1;
    }
    return peak;
}

pub fn gain_calc_rms(samples: List[Float]) -> Float {
    let n: Int = list_len(samples);
    if n <= 0 {
        return 0.0;
    }
    let mut sum_sq: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let s: Float = list_get(samples, i);
        sum_sq = sum_sq + (s * s);
        i = i + 1;
    }
    let mut n_f: Float = 0.0;
    let mut count: Int = n;
    while count >= 1000 { n_f = n_f + 1000.0; count = count - 1000; }
    while count >= 100 { n_f = n_f + 100.0; count = count - 100; }
    while count >= 10 { n_f = n_f + 10.0; count = count - 10; }
    while count >= 1 { n_f = n_f + 1.0; count = count - 1; }

    let mean_sq: Float = sum_sq / n_f;
    return sqrt(mean_sq);
}
