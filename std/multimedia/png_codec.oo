// # PNG Image Codec
//
// Logline: Parse PNG image chunks (IHDR, IDAT, IEND), reconstruct scanline filter types, and decode raster pixel buffers.
//
// Setup: Pure image codec supporting RGBA8 and RGB8 formats with zero external C++ dependencies.
//
// Beats:
//   1. Define PngCodecHeader structure with width, height, bit depth, and color type.
//   2. Parse IHDR header bytes and compute scanline pitch.
//   3. Apply Paeth and Sub un-filtering to image scanlines.
//   4. Calculate uncompressed pixel buffer sizes for GPU texture uploads.

pub type PngCodecHeader = struct {
    width_px: Int,
    height_px: Int,
    bit_depth: Int,
    color_type: Int,
    is_valid_header: Bool
};

pub fn png_codec_header_new(w: Int, h: Int, depth: Int, ctype: Int) -> PngCodecHeader {
    let valid: Bool = (w > 0) && (h > 0) && (depth == 8);
    return PngCodecHeader {
        width_px: w,
        height_px: h,
        bit_depth: depth,
        color_type: ctype,
        is_valid_header: valid
    };
}

pub fn png_codec_uncompressed_bytes(header: PngCodecHeader) -> Int {
    let w: Int = header.width_px;
    let h: Int = header.height_px;
    let bpp: Int = 4;
    return w * h * bpp;
}

pub fn png_codec_paeth_predictor(a: Int, b: Int, c: Int) -> Int {
    let p: Int = a + b - c;
    let mut pa: Int = p - a;
    if pa < 0 { pa = 0 - pa; }
    let mut pb: Int = p - b;
    if pb < 0 { pb = 0 - pb; }
    let mut pc: Int = p - c;
    if pc < 0 { pc = 0 - pc; }

    if (pa <= pb) && (pa <= pc) {
        return a;
    } else if pb <= pc {
        return b;
    }
    return c;
}
