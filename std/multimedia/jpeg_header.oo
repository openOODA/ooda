// # JPEG Frame Header & Marker Protocol
//
// Logline: Parses JPEG marker codes (SOI, SOF0, DQT, DHT, SOS, EOI) and validates component sampling factors.
//
// Setup: Pure multimedia codec module for ISO/IEC 10918-1 JPEG interchange stream validation.
//
// Beats:
//   1. Enumerate standard ITU-T T.81 marker constants and names.
//   2. Define JpegComponent and JpegFrameHeader structures for baseline DCT decoding.
//   3. Validate chroma subsampling factors (4:4:4, 4:2:2, 4:2:0) and component dimensions.

pub type JpegComponent = struct {
    component_id: Int,
    h_sampling: Int,
    v_sampling: Int,
    quant_table_id: Int
};

pub type JpegFrameHeader = struct {
    precision: Int,
    width: Int,
    height: Int,
    num_components: Int,
    components: List[JpegComponent]
};

pub fn jpeg_marker_soi() -> Int { return 65496; }  // 0xFFD8
pub fn jpeg_marker_eoi() -> Int { return 65497; }  // 0xFFD9
pub fn jpeg_marker_sof0() -> Int { return 65472; } // 0xFFC0 (Baseline DCT)
pub fn jpeg_marker_sof2() -> Int { return 65474; } // 0xFFC2 (Progressive DCT)
pub fn jpeg_marker_dht() -> Int { return 65476; }  // 0xFFC4 (Huffman Table)
pub fn jpeg_marker_dqt() -> Int { return 65499; }  // 0xFFDB (Quantization Table)
pub fn jpeg_marker_dri() -> Int { return 65501; }  // 0xFFDD (Restart Interval)
pub fn jpeg_marker_sos() -> Int { return 65498; }  // 0xFFDA (Start of Scan)
pub fn jpeg_marker_app0() -> Int { return 65504; } // 0xFFE0 (JFIF)
pub fn jpeg_marker_app1() -> Int { return 65505; } // 0xFFE1 (EXIF)
pub fn jpeg_marker_com() -> Int { return 65534; }  // 0xFFFE (Comment)

pub fn jpeg_is_marker(b0: Int, b1: Int) -> Bool {
    return (b0 & 255) == 255 && (b1 & 255) != 0 && (b1 & 255) != 255;
}

pub fn jpeg_component_new(id: Int, h_samp: Int, v_samp: Int, q_id: Int) -> JpegComponent {
    return JpegComponent {
        component_id: id,
        h_sampling: h_samp,
        v_sampling: v_samp,
        quant_table_id: q_id
    };
}

pub fn jpeg_frame_header_new(width: Int, height: Int, num_components: Int) -> Result[JpegFrameHeader, String] {
    if width <= 0 || height <= 0 {
        return Err("JPEG dimensions must be positive integers");
    }
    if num_components != 1 && num_components != 3 && num_components != 4 {
        return Err("JPEG num_components must be 1 (Grayscale), 3 (YCbCr), or 4 (CMYK)");
    }
    let mut comps: List[JpegComponent] = list_new();
    if num_components == 1 {
        comps = list_push(comps, jpeg_component_new(1, 1, 1, 0));
    } else if num_components == 3 {
        // Standard 4:2:0 YCbCr
        comps = list_push(comps, jpeg_component_new(1, 2, 2, 0)); // Y
        comps = list_push(comps, jpeg_component_new(2, 1, 1, 1)); // Cb
        comps = list_push(comps, jpeg_component_new(3, 1, 1, 1)); // Cr
    } else {
        comps = list_push(comps, jpeg_component_new(1, 1, 1, 0));
        comps = list_push(comps, jpeg_component_new(2, 1, 1, 1));
        comps = list_push(comps, jpeg_component_new(3, 1, 1, 1));
        comps = list_push(comps, jpeg_component_new(4, 1, 1, 0));
    }
    return Ok(JpegFrameHeader {
        precision: 8,
        width: width,
        height: height,
        num_components: num_components,
        components: comps
    });
}

pub fn jpeg_is_subsampling_420(hdr: &JpegFrameHeader) -> Bool {
    if (hdr).num_components < 3 { return false; }
    let y: JpegComponent = list_get((hdr).components, 0);
    let cb: JpegComponent = list_get((hdr).components, 1);
    let cr: JpegComponent = list_get((hdr).components, 2);
    return (y).h_sampling == 2 && (y).v_sampling == 2 &&
           (cb).h_sampling == 1 && (cb).v_sampling == 1 &&
           (cr).h_sampling == 1 && (cr).v_sampling == 1;
}

pub fn jpeg_mcu_width(hdr: &JpegFrameHeader) -> Int {
    if (hdr).num_components < 3 { return 8; }
    let y: JpegComponent = list_get((hdr).components, 0);
    return (y).h_sampling * 8;
}

pub fn jpeg_mcu_height(hdr: &JpegFrameHeader) -> Int {
    if (hdr).num_components < 3 { return 8; }
    let y: JpegComponent = list_get((hdr).components, 0);
    return (y).v_sampling * 8;
}
