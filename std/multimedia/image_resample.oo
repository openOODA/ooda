// # 2D Image Resampling & Spatial Interpolation
//
// Logline: Implements Nearest Neighbor, Bilinear, and Bicubic filter weights for spatial image resizing.
//
// Setup: Pure multimedia raster processing module for 2D image scaling and aspect-ratio geometry.
//
// Beats:
//   1. Calculate source sub-pixel continuous coordinates for target dimensions.
//   2. Compute 4-tap Bilinear and 16-tap Catmull-Rom Bicubic weighting coefficients.
//   3. Compute aspect-ratio preserving bounding box dimensions (Fit, Fill, Stretch).

pub type ResampleBox = struct {
    src_w: Int,
    src_h: Int,
    dst_w: Int,
    dst_h: Int,
    scale_x: Float,
    scale_y: Float,
};

pub fn resample_int_to_f(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    return f;
}

pub fn resample_abs(v: Float) -> Float {
    if v < 0.0 { return 0.0 - v; }
    return v;
}

pub fn resample_box_new(src_w: Int, src_h: Int, dst_w: Int, dst_h: Int) -> ResampleBox {
    let sw_f: Float = resample_int_to_f(src_w);
    let sh_f: Float = resample_int_to_f(src_h);
    let dw_f: Float = resample_int_to_f(dst_w);
    let dh_f: Float = resample_int_to_f(dst_h);

    return ResampleBox {
        src_w: src_w,
        src_h: src_h,
        dst_w: dst_w,
        dst_h: dst_h,
        scale_x: sw_f / dw_f,
        scale_y: sh_f / dh_f,
    };
}

pub fn resample_bilinear_weights(fx: Float, fy: Float) -> List[Float] {
    // 4 weights: top-left (0,0), top-right (1,0), bottom-left (0,1), bottom-right (1,1)
    let w00: Float = (1.0 - fx) * (1.0 - fy);
    let w10: Float = fx * (1.0 - fy);
    let w01: Float = (1.0 - fx) * fy;
    let w11: Float = fx * fy;

    let mut weights: List[Float] = list_new();
    weights = list_push(weights, w00);
    weights = list_push(weights, w10);
    weights = list_push(weights, w01);
    weights = list_push(weights, w11);
    return weights;
}

pub fn resample_bicubic_catmull_rom(x: Float) -> Float {
    let d: Float = resample_abs(x);
    let d2: Float = d * d;
    let d3: Float = d2 * d;

    // Catmull-Rom cubic spline (a = -0.5)
    if d <= 1.0 {
        return (1.5 * d3) - (2.5 * d2) + 1.0;
    }
    if d < 2.0 {
        return (-0.5 * d3) + (2.5 * d2) - (4.0 * d) + 2.0;
    }
    return 0.0;
}

pub fn resample_interpolate_bilinear_sample(p00: Float, p10: Float, p01: Float, p11: Float, fx: Float, fy: Float) -> Float {
    let w: List[Float] = resample_bilinear_weights(fx, fy);
    let w00: Float = list_get(w, 0);
    let w10: Float = list_get(w, 1);
    let w01: Float = list_get(w, 2);
    let w11: Float = list_get(w, 3);
    return (p00 * w00) + (p10 * w10) + (p01 * w01) + (p11 * w11);
}
