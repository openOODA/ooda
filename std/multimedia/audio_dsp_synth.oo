// # Audio DSP Synthesis & ADSR Envelopes
//
// Logline: Implements wavetable oscillators (Sine, Square, Triangle, Saw), ADSR envelopes, and MIDI pitch tuning.
//
// Setup: Pure digital signal processing synthesis module for musical sound generation.
//
// Beats:
//   1. Implement periodic waveform generators (Sine, Square, Triangle, Sawtooth).
//   2. Define ADSR envelope state machine (Idle, Attack, Decay, Sustain, Release).
//   3. Compute MIDI pitch to Hz frequency conversions and phase increment accumulation.

pub type OscillatorState = struct {
    wave_type: Int,     // 0 = Sine, 1 = Square, 2 = Triangle, 3 = Sawtooth
    freq_hz: Float,
    phase: Float,       // [0.0 .. 1.0)
    sample_rate: Float
};

pub type AdsrEnvelope = struct {
    attack_sec: Float,
    decay_sec: Float,
    sustain_level: Float,
    release_sec: Float,
    state: Int,         // 0 = Idle, 1 = Attack, 2 = Decay, 3 = Sustain, 4 = Release
    current_level: Float
};

pub fn synth_pi() -> Float {
    return 3.14159265358979323846;
}

pub fn synth_abs_f(v: Float) -> Float {
    if v < 0.0 { return 0.0 - v; }
    return v;
}

pub fn synth_osc_new(wave_type: Int, freq_hz: Float, sample_rate: Float) -> OscillatorState {
    return OscillatorState {
        wave_type: wave_type,
        freq_hz: freq_hz,
        phase: 0.0,
        sample_rate: sample_rate
    };
}

pub fn synth_osc_sample(osc: &mut OscillatorState) -> Float {
    let p: Float = (osc).phase;
    let mut out: Float = 0.0;

    // 0 = Sine
    if (osc).wave_type == 0 {
        out = sin(2.0 * synth_pi() * p);
    }
    // 1 = Square
    else if (osc).wave_type == 1 {
        if p < 0.5 {
            out = 1.0;
        } else {
            out = -1.0;
        }
    }
    // 2 = Triangle
    else if (osc).wave_type == 2 {
        out = 4.0 * synth_abs_f(p - 0.5) - 1.0;
    }
    // 3 = Sawtooth
    else {
        out = 2.0 * p - 1.0;
    }

    // Advance phase
    let inc: Float = (osc).freq_hz / (osc).sample_rate;
    let mut next_phase: Float = p + inc;
    while next_phase >= 1.0 {
        next_phase = next_phase - 1.0;
    }
    (osc).phase = next_phase;

    return out;
}

pub fn synth_adsr_new(attack: Float, decay: Float, sustain: Float, release: Float) -> AdsrEnvelope {
    return AdsrEnvelope {
        attack_sec: attack,
        decay_sec: decay,
        sustain_level: sustain,
        release_sec: release,
        state: 0,
        current_level: 0.0
    };
}

pub fn synth_adsr_trigger_note_on(env: &mut AdsrEnvelope) {
    (env).state = 1; // Attack
}

pub fn synth_adsr_trigger_note_off(env: &mut AdsrEnvelope) {
    (env).state = 4; // Release
}

pub fn synth_adsr_tick(env: &mut AdsrEnvelope, dt_sec: Float) -> Float {
    if (env).state == 0 {
        (env).current_level = 0.0;
        return 0.0;
    }
    // Attack
    if (env).state == 1 {
        if (env).attack_sec <= 0.0001 {
            (env).current_level = 1.0;
            (env).state = 2;
        } else {
            (env).current_level = (env).current_level + (dt_sec / (env).attack_sec);
            if (env).current_level >= 1.0 {
                (env).current_level = 1.0;
                (env).state = 2; // Transition to Decay
            }
        }
    }
    // Decay
    else if (env).state == 2 {
        if (env).decay_sec <= 0.0001 {
            (env).current_level = (env).sustain_level;
            (env).state = 3;
        } else {
            let drop: Float = dt_sec / (env).decay_sec;
            (env).current_level = (env).current_level - drop;
            if (env).current_level <= (env).sustain_level {
                (env).current_level = (env).sustain_level;
                (env).state = 3; // Transition to Sustain
            }
        }
    }
    // Sustain
    else if (env).state == 3 {
        (env).current_level = (env).sustain_level;
    }
    // Release
    else if (env).state == 4 {
        if (env).release_sec <= 0.0001 {
            (env).current_level = 0.0;
            (env).state = 0;
        } else {
            let drop: Float = dt_sec / (env).release_sec;
            (env).current_level = (env).current_level - drop;
            if (env).current_level <= 0.0 {
                (env).current_level = 0.0;
                (env).state = 0; // Back to Idle
            }
        }
    }
    return (env).current_level;
}

pub fn synth_midi_note_to_freq(midi_note: Int) -> Float {
    // A4 = MIDI Note 69 = 440 Hz
    let semitones: Int = midi_note - 69;
    let mut factor: Float = 1.0;
    let semitone_ratio: Float = 1.059463094359; // 2^(1/12)

    if semitones >= 0 {
        let mut i: Int = 0;
        while i < semitones {
            factor = factor * semitone_ratio;
            i = i + 1;
        }
    } else {
        let mut count: Int = 0 - semitones;
        let mut i: Int = 0;
        while i < count {
            factor = factor / semitone_ratio;
            i = i + 1;
        }
    }
    return 440.0 * factor;
}
