// # YUV & YCbCr Video Color Spaces
//
// Logline: Implements ITU-R BT.601 and BT.709 RGB-to-YCbCr matrices and video chroma subsampling geometry.
//
// Setup: Pure multimedia colorimetric module for digital video encoding and television broadcast matrices.
//
// Beats:
//   1. Define ColorYuv and ColorYCbCr data structures.
//   2. Implement standard BT.601 forward and inverse matrix transformations.
//   3. Compute chroma subsampling dimensions (4:4:4, 4:2:2, 4:2:0 planar buffers).

import "./color_rgb.oo";

pub type ColorYuv = struct {
    y: Float,
    u: Float,
    v: Float
};

pub type ColorYCbCr = struct {
    y: Int,   // [0 .. 255]
    cb: Int,  // [0 .. 255] (128 neutral)
    cr: Int  // [0 .. 255] (128 neutral)
};

pub fn color_rgb_to_ycbcr_bt601(r: Int, g: Int, b: Int) -> ColorYCbCr {
    let rf: Float = color_int_to_f(r);
    let gf: Float = color_int_to_f(g);
    let bf: Float = color_int_to_f(b);

    // BT.601 Forward Matrix
    let y_f: Float = (0.299 * rf) + (0.587 * gf) + (0.114 * bf);
    let cb_f: Float = 128.0 - (0.168736 * rf) - (0.331264 * gf) + (0.5 * bf);
    let cr_f: Float = 128.0 + (0.5 * rf) - (0.418688 * gf) - (0.081312 * bf);

    let mut y_i: Int = 0;
    let mut cb_i: Int = 0;
    let mut cr_i: Int = 0;

    let mut count_y: Float = y_f;
    while count_y >= 100.0 { y_i = y_i + 100; count_y = count_y - 100.0; }
    while count_y >= 10.0 { y_i = y_i + 10; count_y = count_y - 10.0; }
    while count_y >= 1.0 { y_i = y_i + 1; count_y = count_y - 1.0; }

    let mut count_cb: Float = cb_f;
    while count_cb >= 100.0 { cb_i = cb_i + 100; count_cb = count_cb - 100.0; }
    while count_cb >= 10.0 { cb_i = cb_i + 10; count_cb = count_cb - 10.0; }
    while count_cb >= 1.0 { cb_i = cb_i + 1; count_cb = count_cb - 1.0; }

    let mut count_cr: Float = cr_f;
    while count_cr >= 100.0 { cr_i = cr_i + 100; count_cr = count_cr - 100.0; }
    while count_cr >= 10.0 { cr_i = cr_i + 10; count_cr = count_cr - 10.0; }
    while count_cr >= 1.0 { cr_i = cr_i + 1; count_cr = count_cr - 1.0; }

    if y_i < 0 { y_i = 0; } if y_i > 255 { y_i = 255; }
    if cb_i < 0 { cb_i = 0; } if cb_i > 255 { cb_i = 255; }
    if cr_i < 0 { cr_i = 0; } if cr_i > 255 { cr_i = 255; }

    return ColorYCbCr { y: y_i, cb: cb_i, cr: cr_i };
}

pub fn color_ycbcr_to_rgb_bt601(ycbcr: &ColorYCbCr) -> ColorRgb {
    let yf: Float = color_int_to_f((ycbcr).y);
    let cbf: Float = color_int_to_f((ycbcr).cb) - 128.0;
    let crf: Float = color_int_to_f((ycbcr).cr) - 128.0;

    let rf: Float = yf + (1.402 * crf);
    let gf: Float = yf - (0.344136 * cbf) - (0.714136 * crf);
    let bf: Float = yf + (1.772 * cbf);

    let mut r_i: Int = 0;
    let mut g_i: Int = 0;
    let mut b_i: Int = 0;

    if rf >= 0.0 {
        let mut count_r: Float = rf;
        while count_r >= 100.0 { r_i = r_i + 100; count_r = count_r - 100.0; }
        while count_r >= 10.0 { r_i = r_i + 10; count_r = count_r - 10.0; }
        while count_r >= 1.0 { r_i = r_i + 1; count_r = count_r - 1.0; }
    }
    if gf >= 0.0 {
        let mut count_g: Float = gf;
        while count_g >= 100.0 { g_i = g_i + 100; count_g = count_g - 100.0; }
        while count_g >= 10.0 { g_i = g_i + 10; count_g = count_g - 10.0; }
        while count_g >= 1.0 { g_i = g_i + 1; count_g = count_g - 1.0; }
    }
    if bf >= 0.0 {
        let mut count_b: Float = bf;
        while count_b >= 100.0 { b_i = b_i + 100; count_b = count_b - 100.0; }
        while count_b >= 10.0 { b_i = b_i + 10; count_b = count_b - 10.0; }
        while count_b >= 1.0 { b_i = b_i + 1; count_b = count_b - 1.0; }
    }

    return color_rgb_new(r_i, g_i, b_i);
}

pub fn color_yuv420_buffer_bytes(width: Int, height: Int) -> Int {
    let y_plane: Int = width * height;
    let uv_plane: Int = (width / 2) * (height / 2);
    // Y plane + Cb plane + Cr plane = 1.5 * width * height
    return y_plane + (2 * uv_plane);
}
