// # RIFF chunk container
//
// Logline: Parses RIFF FourCC, 32-bit chunk size, and payload offset for WAVE, AVI, and WebP forms.
//
// Setup: Pure. Bytes are List[Int] 0..255 little-endian. A size that overruns the buffer is Err.
//
// Beats:
//   1. Require RIFF magic and a form type WAVE, AVI, or WEBP.
//   2. Read the first subchunk id, size, and payload offset.
//   3. Reject a truncated header or an overrun size.

import "std/byte_out.oo";

pub type RiffOut = struct {
    flag: Int,
    err: String,
    form: Int,
    size: Int,
    ckid: Int,
    cksize: Int,
    payload: Int
};

fn rf_u32(buf: List[Int], o: Int) -> Int {
    return list_get(buf, o) + list_get(buf, o + 1) * 256 + list_get(buf, o + 2) * 65536 + list_get(buf, o + 3) * 16777216;
}

fn rf_fcc(a: Int, b: Int, c: Int, d: Int) -> Int {
    return a + b * 256 + c * 65536 + d * 16777216;
}

fn rf_push_fcc(o: List[Int], s: String) -> List[Int] {
    let mut b: List[Int] = o;
    b = list_push(b, byte_at(s, 0));
    b = list_push(b, byte_at(s, 1));
    b = list_push(b, byte_at(s, 2));
    b = list_push(b, byte_at(s, 3));
    return b;
}

fn rf_push_u32(o: List[Int], n: Int) -> List[Int] {
    let mut b: List[Int] = o;
    b = list_push(b, n & 255);
    b = list_push(b, (n >> 8) & 255);
    b = list_push(b, (n >> 16) & 255);
    b = list_push(b, (n >> 24) & 255);
    return b;
}

pub fn riff_container_make(form: String, ckid: String, payload: List[Int]) -> ByteOut {
    let n: Int = list_len(payload);
    let mut o: List[Int] = list_new();
    o = rf_push_fcc(o, "RIFF");
    o = rf_push_u32(o, 4 + 8 + n);
    o = rf_push_fcc(o, form);
    o = rf_push_fcc(o, ckid);
    o = rf_push_u32(o, n);
    let mut i: Int = 0;
    while i < n {
        o = list_push(o, list_get(payload, i) & 255);
        i = i + 1;
    }
    return byte_out_ok(o);
}

pub fn riff_container_parse(buf: List[Int]) -> RiffOut {
    if list_len(buf) < 20 {
        return RiffOut { flag: 0, err: "riff short", form: 0, size: 0, ckid: 0, cksize: 0, payload: 0 };
    }
    if rf_u32(buf, 0) != rf_fcc(82, 73, 70, 70) {
        return RiffOut { flag: 0, err: "riff magic", form: 0, size: 0, ckid: 0, cksize: 0, payload: 0 };
    }
    let size: Int = rf_u32(buf, 4);
    let form: Int = rf_u32(buf, 8);
    let wave: Int = rf_fcc(87, 65, 86, 69);
    let avi: Int = rf_fcc(65, 86, 73, 32);
    let webp: Int = rf_fcc(87, 69, 66, 80);
    if form != wave {
        if form != avi {
            if form != webp {
                return RiffOut { flag: 0, err: "riff form", form: form, size: size, ckid: 0, cksize: 0, payload: 0 };
            }
        }
    }
    let ckid: Int = rf_u32(buf, 12);
    let cksize: Int = rf_u32(buf, 16);
    if 20 + cksize > list_len(buf) {
        return RiffOut { flag: 0, err: "riff overrun", form: form, size: size, ckid: ckid, cksize: cksize, payload: 20 };
    }
    if 8 + size > list_len(buf) {
        return RiffOut { flag: 0, err: "riff overrun", form: form, size: size, ckid: ckid, cksize: cksize, payload: 20 };
    }
    return RiffOut { flag: 1, err: "", form: form, size: size, ckid: ckid, cksize: cksize, payload: 20 };
}

pub fn riff_container_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}
