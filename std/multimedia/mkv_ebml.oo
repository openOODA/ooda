// # Matroska MKV & EBML Binary Framing
//
// Logline: Decodes EBML Variable-Size Integers (VINT), Element IDs, and Matroska Segment/Cluster hierarchy.
//
// Setup: Pure multimedia container module for Matroska (MKV) and WebM EBML stream parsing.
//
// Beats:
//   1. Implement RFC 8794 EBML VINT variable-length integer parsing (1..4 octets).
//   2. Enumerate Matroska Core Element IDs (EBML Header, Segment, Tracks, Cluster).
//   3. Define EbmlElement record and calculate total element payload boundaries.

pub type EbmlVint = struct {
    width_octets: Int,
    value: Int
};

pub type EbmlElement = struct {
    element_id: Int,
    element_name: String,
    data_size: Int,
    is_master: Bool
};

pub fn ebml_id_header() -> Int { return 440786851; }   // 0x1A45DFA3 (EBML)
pub fn ebml_id_segment() -> Int { return 408125543; }  // 0x18538067 (Segment)
pub fn ebml_id_info() -> Int { return 357149030; }     // 0x1549A966 (Info)
pub fn ebml_id_tracks() -> Int { return 374648427; }   // 0x1654AE6B (Tracks)
pub fn ebml_id_cluster() -> Int { return 524529013; }  // 0x1F43B675 (Cluster)
pub fn ebml_id_simple_block() -> Int { return 163; }   // 0xA3 (SimpleBlock)
pub fn ebml_id_timecode() -> Int { return 231; }       // 0xE7 (Timecode)

pub fn ebml_vint_width(first_byte: Int) -> Int {
    let b: Int = first_byte & 255;
    if (b & 128) != 0 { return 1; }
    if (b & 64) != 0 { return 2; }
    if (b & 32) != 0 { return 3; }
    if (b & 16) != 0 { return 4; }
    return 0; // Invalid / larger than 4 bytes
}

pub fn ebml_decode_vint_1(b0: Int) -> EbmlVint {
    let val: Int = b0 & 127;
    return EbmlVint { width_octets: 1, value: val };
}

pub fn ebml_decode_vint_2(b0: Int, b1: Int) -> EbmlVint {
    let val: Int = ((b0 & 63) << 8) | (b1 & 255);
    return EbmlVint { width_octets: 2, value: val };
}

pub fn ebml_decode_vint_3(b0: Int, b1: Int, b2: Int) -> EbmlVint {
    let val: Int = ((b0 & 31) << 16) | ((b1 & 255) << 8) | (b2 & 255);
    return EbmlVint { width_octets: 3, value: val };
}

pub fn ebml_decode_vint_4(b0: Int, b1: Int, b2: Int, b3: Int) -> EbmlVint {
    let val: Int = ((b0 & 15) << 24) | ((b1 & 255) << 16) | ((b2 & 255) << 8) | (b3 & 255);
    return EbmlVint { width_octets: 4, value: val };
}

pub fn ebml_element_new(id: Int, name: String, size: Int, is_master: Bool) -> EbmlElement {
    return EbmlElement {
        element_id: id,
        element_name: name,
        data_size: size,
        is_master: is_master
    };
}

pub fn ebml_element_is_cluster(elem: &EbmlElement) -> Bool {
    return (elem).element_id == ebml_id_cluster();
}

pub fn ebml_element_is_tracks(elem: &EbmlElement) -> Bool {
    return (elem).element_id == ebml_id_tracks();
}
