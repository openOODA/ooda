// # Linear PCM WAV header
//
// Logline: Validates a RIFF WAVE fmt chunk of size 16, audio format 1, and legal channel, rate, and bit-depth bounds.
//
// Setup: Pure. Bytes are List[Int] 0..255 little-endian. Other formats are Err.
//
// Beats:
//   1. Require RIFF and WAVE magics.
//   2. Require fmt chunk size 16 and audio format 1.
//   3. Accept channels 1..8, sample rate 8000..192000, and bits 8/16/24/32.
//   4. Reject truncated headers and non-PCM formats.

import "std/byte_out.oo";

pub type WavOut = struct {
    flag: Int,
    err: String,
    channels: Int,
    rate: Int,
    bits: Int,
    format: Int
};

fn wav_u16(buf: List[Int], o: Int) -> Int {
    return list_get(buf, o) + list_get(buf, o + 1) * 256;
}

fn wav_u32(buf: List[Int], o: Int) -> Int {
    return list_get(buf, o) + list_get(buf, o + 1) * 256 + list_get(buf, o + 2) * 65536 + list_get(buf, o + 3) * 16777216;
}

fn wav_push_u16(o: List[Int], n: Int) -> List[Int] {
    let mut b: List[Int] = o;
    b = list_push(b, n & 255);
    b = list_push(b, (n >> 8) & 255);
    return b;
}

fn wav_push_u32(o: List[Int], n: Int) -> List[Int] {
    let mut b: List[Int] = o;
    b = list_push(b, n & 255);
    b = list_push(b, (n >> 8) & 255);
    b = list_push(b, (n >> 16) & 255);
    b = list_push(b, (n >> 24) & 255);
    return b;
}

fn wav_push_fcc(o: List[Int], a: Int, b: Int, c: Int, d: Int) -> List[Int] {
    let mut x: List[Int] = o;
    x = list_push(x, a);
    x = list_push(x, b);
    x = list_push(x, c);
    x = list_push(x, d);
    return x;
}

pub fn wav_pcm_header_make(channels: Int, rate: Int, bits: Int) -> ByteOut {
    if channels < 1 {
        return byte_out_err("wav channels");
    }
    if channels > 8 {
        return byte_out_err("wav channels");
    }
    if rate < 8000 {
        return byte_out_err("wav rate");
    }
    if rate > 192000 {
        return byte_out_err("wav rate");
    }
    if bits != 8 {
        if bits != 16 {
            if bits != 24 {
                if bits != 32 {
                    return byte_out_err("wav bits");
                }
            }
        }
    }
    let align: Int = channels * (bits / 8);
    let brate: Int = rate * align;
    let mut o: List[Int] = list_new();
    o = wav_push_fcc(o, 82, 73, 70, 70);
    o = wav_push_u32(o, 36);
    o = wav_push_fcc(o, 87, 65, 86, 69);
    o = wav_push_fcc(o, 102, 109, 116, 32);
    o = wav_push_u32(o, 16);
    o = wav_push_u16(o, 1);
    o = wav_push_u16(o, channels);
    o = wav_push_u32(o, rate);
    o = wav_push_u32(o, brate);
    o = wav_push_u16(o, align);
    o = wav_push_u16(o, bits);
    o = wav_push_fcc(o, 100, 97, 116, 97);
    o = wav_push_u32(o, 0);
    return byte_out_ok(o);
}

pub fn wav_pcm_header_parse(buf: List[Int]) -> WavOut {
    if list_len(buf) < 44 {
        return WavOut { flag: 0, err: "wav short", channels: 0, rate: 0, bits: 0, format: 0 };
    }
    if wav_u32(buf, 0) != 1179011410 {
        return WavOut { flag: 0, err: "wav riff", channels: 0, rate: 0, bits: 0, format: 0 };
    }
    if wav_u32(buf, 8) != 1163280727 {
        return WavOut { flag: 0, err: "wav wave", channels: 0, rate: 0, bits: 0, format: 0 };
    }
    if wav_u32(buf, 12) != 544501094 {
        return WavOut { flag: 0, err: "wav fmt", channels: 0, rate: 0, bits: 0, format: 0 };
    }
    let fmtsz: Int = wav_u32(buf, 16);
    if fmtsz != 16 {
        return WavOut { flag: 0, err: "wav fmt size", channels: 0, rate: 0, bits: 0, format: 0 };
    }
    let fmt: Int = wav_u16(buf, 20);
    if fmt != 1 {
        return WavOut { flag: 0, err: "wav format", channels: 0, rate: 0, bits: 0, format: fmt };
    }
    let ch: Int = wav_u16(buf, 22);
    if ch < 1 {
        return WavOut { flag: 0, err: "wav channels", channels: ch, rate: 0, bits: 0, format: fmt };
    }
    if ch > 8 {
        return WavOut { flag: 0, err: "wav channels", channels: ch, rate: 0, bits: 0, format: fmt };
    }
    let rate: Int = wav_u32(buf, 24);
    if rate < 8000 {
        return WavOut { flag: 0, err: "wav rate", channels: ch, rate: rate, bits: 0, format: fmt };
    }
    if rate > 192000 {
        return WavOut { flag: 0, err: "wav rate", channels: ch, rate: rate, bits: 0, format: fmt };
    }
    let bits: Int = wav_u16(buf, 34);
    if bits != 8 {
        if bits != 16 {
            if bits != 24 {
                if bits != 32 {
                    return WavOut { flag: 0, err: "wav bits", channels: ch, rate: rate, bits: bits, format: fmt };
                }
            }
        }
    }
    return WavOut { flag: 1, err: "", channels: ch, rate: rate, bits: bits, format: fmt };
}

pub fn wav_pcm_header_stat(flag: Int, err: String) -> Result[Int, String] {
    if flag < 1 {
        return Err(err);
    }
    return Ok(1);
}
