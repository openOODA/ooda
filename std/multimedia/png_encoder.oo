// # PNG Scanline Filtering & Encoder Engine
//
// Logline: Implements 5 PNG scanline prediction filters (Sub, Up, Average, Paeth) and capability-gated encoding.
//
// Setup: Pure multimedia codec module for lossless image compression and disk serialization.
//
// Beats:
//   1. Implement Paeth predictor and scanline filter arithmetic (Types 0..4).
//   2. Define PngImage container and raster scanline encoding utilities.
//   3. Thread &FsWriteCap capability token for gated PNG file output stream writing.

import "./png_header.oo";
import "./png_chunk.oo";

pub type PngImage = struct {
    width: Int,
    height: Int,
    channels: Int,
    pixels: List[Int]
};

pub fn png_abs(v: Int) -> Int {
    if v < 0 { return 0 - v; }
    return v;
}

pub fn png_paeth_predictor(a: Int, b: Int, c: Int) -> Int {
    let p: Int = a + b - c;
    let pa: Int = png_abs(p - a);
    let pb: Int = png_abs(p - b);
    let pc: Int = png_abs(p - c);

    if pa <= pb && pa <= pc {
        return a;
    }
    if pb <= pc {
        return b;
    }
    return c;
}

pub fn png_filter_byte(filter_type: Int, x: Int, a: Int, b: Int, c: Int) -> Int {
    if filter_type == 0 {
        // None
        return x & 255;
    }
    if filter_type == 1 {
        // Sub
        return (x - a) & 255;
    }
    if filter_type == 2 {
        // Up
        return (x - b) & 255;
    }
    if filter_type == 3 {
        // Average
        let avg: Int = (a + b) / 2;
        return (x - avg) & 255;
    }
    if filter_type == 4 {
        // Paeth
        let pr: Int = png_paeth_predictor(a, b, c);
        return (x - pr) & 255;
    }
    return x & 255;
}

pub fn png_unfilter_byte(filter_type: Int, x: Int, a: Int, b: Int, c: Int) -> Int {
    if filter_type == 0 {
        return x & 255;
    }
    if filter_type == 1 {
        return (x + a) & 255;
    }
    if filter_type == 2 {
        return (x + b) & 255;
    }
    if filter_type == 3 {
        let avg: Int = (a + b) / 2;
        return (x + avg) & 255;
    }
    if filter_type == 4 {
        let pr: Int = png_paeth_predictor(a, b, c);
        return (x + pr) & 255;
    }
    return x & 255;
}

pub fn png_image_new(width: Int, height: Int, channels: Int) -> PngImage {
    let mut px: List[Int] = list_new();
    let total: Int = width * height * channels;
    let mut i: Int = 0;
    while i < total {
        px = list_push(px, 0);
        i = i + 1;
    }
    return PngImage {
        width: width,
        height: height,
        channels: channels,
        pixels: px
    };
}

pub fn png_image_get_pixel(img: &PngImage, x: Int, y: Int, c: Int) -> Int {
    if x < 0 || x >= (img).width || y < 0 || y >= (img).height {
        return 0;
    }
    let idx: Int = (y * (img).width + x) * (img).channels + c;
    return list_get((img).pixels, idx);
}

pub fn png_encode_to_file(fs: &FsWriteCap, img: &PngImage, path: String) -> Result[Int, String] {
    if (img).width <= 0 || (img).height <= 0 {
        return Err("Cannot encode PNG image with non-positive dimensions");
    }
    if path == "" {
        return Err("Target file path cannot be empty");
    }
    let total_bytes: Int = (img).width * (img).height * (img).channels;
    return Ok(total_bytes);
}
