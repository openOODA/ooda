// # Pixel Blending Modes & Alpha Compositing
//
// Logline: Implements Porter-Duff compositing, Multiply, Screen, Overlay, Dodge, Burn, and Difference blend modes.
//
// Setup: Pure multimedia raster processing module for multi-layer image compositing.
//
// Beats:
//   1. Implement standard Porter-Duff Source-Over alpha compositing.
//   2. Provide 10 standard Photoshop/SVG blend modes (Multiply, Screen, Overlay, etc.).
//   3. Compute composite RGBA pixel values with normalized float arithmetic.

import "./color_rgb.oo";

pub fn blend_abs(v: Float) -> Float {
    if v < 0.0 { return 0.0 - v; }
    return v;
}

pub fn blend_channel(mode: Int, src: Float, dst: Float) -> Float {
    // 0 = Normal
    if mode == 0 {
        return src;
    }
    // 1 = Multiply
    if mode == 1 {
        return src * dst;
    }
    // 2 = Screen
    if mode == 2 {
        return 1.0 - ((1.0 - src) * (1.0 - dst));
    }
    // 3 = Overlay
    if mode == 3 {
        if dst < 0.5 {
            return 2.0 * src * dst;
        }
        return 1.0 - (2.0 * (1.0 - src) * (1.0 - dst));
    }
    // 4 = Darken
    if mode == 4 {
        if src < dst { return src; }
        return dst;
    }
    // 5 = Lighten
    if mode == 5 {
        if src > dst { return src; }
        return dst;
    }
    // 6 = Color Dodge
    if mode == 6 {
        if dst <= 0.00001 { return 0.0; }
        if src >= 0.99999 { return 1.0; }
        let res: Float = dst / (1.0 - src);
        if res > 1.0 { return 1.0; }
        return res;
    }
    // 7 = Color Burn
    if mode == 7 {
        if src <= 0.00001 { return 0.0; }
        if dst >= 0.99999 { return 1.0; }
        let res: Float = 1.0 - ((1.0 - dst) / src);
        if res < 0.0 { return 0.0; }
        return res;
    }
    // 8 = Difference
    if mode == 8 {
        return blend_abs(src - dst);
    }
    // 9 = Additive / Linear Dodge
    if mode == 9 {
        let sum: Float = src + dst;
        if sum > 1.0 { return 1.0; }
        return sum;
    }

    return src;
}

pub fn blend_rgba_over(src: &ColorRgbaF, dst: &ColorRgbaF, mode: Int) -> ColorRgbaF {
    let sa: Float = (src).a;
    let da: Float = (dst).a;

    let out_a: Float = sa + (da * (1.0 - sa));
    if out_a <= 0.00001 {
        return ColorRgbaF { r: 0.0, g: 0.0, b: 0.0, a: 0.0 };
    }

    let br: Float = blend_channel(mode, (src).r, (dst).r);
    let bg: Float = blend_channel(mode, (src).g, (dst).g);
    let bb: Float = blend_channel(mode, (src).b, (dst).b);

    let out_r: Float = ((br * sa) + ((dst).r * da * (1.0 - sa))) / out_a;
    let out_g: Float = ((bg * sa) + ((dst).g * da * (1.0 - sa))) / out_a;
    let out_b: Float = ((bb * sa) + ((dst).b * da * (1.0 - sa))) / out_a;

    return ColorRgbaF {
        r: out_r,
        g: out_g,
        b: out_b,
        a: out_a,
    };
}
