// # JPEG Quantization Tables & Zig-Zag Mapping
//
// Logline: Implements ITU-T T.81 Annex K 8x8 quantization tables, quality scaling, and zig-zag reordering.
//
// Setup: Pure multimedia codec module for lossy discrete cosine transform (DCT) coefficient quantization.
//
// Beats:
//   1. Define standard Annex K 8x8 Luminance and Chrominance tables.
//   2. Calculate JPEG quality scaling factors (1..100) and clamp quantized coefficients [1..255].
//   3. Provide 64-element diagonal zig-zag scanning indices for DC/AC run-length serialization.

pub type JpegQuantTable = struct {
    table_id: Int,
    values: List[Int],
};

pub fn jpeg_zigzag_index(linear_idx: Int) -> Int {
    // 64-element standard zig-zag array
    if linear_idx == 0 { return 0; }
    if linear_idx == 1 { return 1; }
    if linear_idx == 2 { return 8; }
    if linear_idx == 3 { return 16; }
    if linear_idx == 4 { return 9; }
    if linear_idx == 5 { return 2; }
    if linear_idx == 6 { return 3; }
    if linear_idx == 7 { return 10; }
    if linear_idx == 8 { return 17; }
    if linear_idx == 9 { return 24; }
    if linear_idx == 10 { return 32; }
    if linear_idx == 11 { return 25; }
    if linear_idx == 12 { return 18; }
    if linear_idx == 13 { return 11; }
    if linear_idx == 14 { return 4; }
    if linear_idx == 15 { return 5; }
    if linear_idx == 16 { return 12; }
    if linear_idx == 17 { return 19; }
    if linear_idx == 18 { return 26; }
    if linear_idx == 19 { return 33; }
    if linear_idx == 20 { return 40; }
    if linear_idx == 21 { return 48; }
    if linear_idx == 22 { return 41; }
    if linear_idx == 23 { return 34; }
    if linear_idx == 24 { return 27; }
    if linear_idx == 25 { return 20; }
    if linear_idx == 26 { return 13; }
    if linear_idx == 27 { return 6; }
    if linear_idx == 28 { return 7; }
    if linear_idx == 29 { return 14; }
    if linear_idx == 30 { return 21; }
    if linear_idx == 31 { return 28; }
    if linear_idx == 32 { return 35; }
    if linear_idx == 33 { return 42; }
    if linear_idx == 34 { return 49; }
    if linear_idx == 35 { return 56; }
    if linear_idx == 36 { return 57; }
    if linear_idx == 37 { return 50; }
    if linear_idx == 38 { return 43; }
    if linear_idx == 39 { return 36; }
    if linear_idx == 40 { return 29; }
    if linear_idx == 41 { return 22; }
    if linear_idx == 42 { return 15; }
    if linear_idx == 43 { return 23; }
    if linear_idx == 44 { return 30; }
    if linear_idx == 45 { return 37; }
    if linear_idx == 46 { return 44; }
    if linear_idx == 47 { return 51; }
    if linear_idx == 48 { return 58; }
    if linear_idx == 49 { return 59; }
    if linear_idx == 50 { return 52; }
    if linear_idx == 51 { return 45; }
    if linear_idx == 52 { return 38; }
    if linear_idx == 53 { return 31; }
    if linear_idx == 54 { return 39; }
    if linear_idx == 55 { return 46; }
    if linear_idx == 56 { return 53; }
    if linear_idx == 57 { return 60; }
    if linear_idx == 58 { return 61; }
    if linear_idx == 59 { return 54; }
    if linear_idx == 60 { return 47; }
    if linear_idx == 61 { return 55; }
    if linear_idx == 62 { return 62; }
    if linear_idx == 63 { return 63; }
    return 0;
}

pub fn jpeg_std_luminance_table() -> JpegQuantTable {
    let mut vals: List[Int] = list_new();
    let l_raw: List[Int] = list_new();
    // Row 0..7 standard Annex K luminance entries
    vals = list_push(vals, 16); vals = list_push(vals, 11); vals = list_push(vals, 10); vals = list_push(vals, 16);
    vals = list_push(vals, 24); vals = list_push(vals, 40); vals = list_push(vals, 51); vals = list_push(vals, 61);
    vals = list_push(vals, 12); vals = list_push(vals, 12); vals = list_push(vals, 14); vals = list_push(vals, 19);
    vals = list_push(vals, 26); vals = list_push(vals, 58); vals = list_push(vals, 60); vals = list_push(vals, 55);
    vals = list_push(vals, 14); vals = list_push(vals, 13); vals = list_push(vals, 16); vals = list_push(vals, 24);
    vals = list_push(vals, 40); vals = list_push(vals, 57); vals = list_push(vals, 69); vals = list_push(vals, 56);
    vals = list_push(vals, 14); vals = list_push(vals, 17); vals = list_push(vals, 22); vals = list_push(vals, 29);
    vals = list_push(vals, 51); vals = list_push(vals, 87); vals = list_push(vals, 80); vals = list_push(vals, 62);
    vals = list_push(vals, 18); vals = list_push(vals, 22); vals = list_push(vals, 37); vals = list_push(vals, 56);
    vals = list_push(vals, 68); vals = list_push(vals, 109); vals = list_push(vals, 103); vals = list_push(vals, 77);
    vals = list_push(vals, 24); vals = list_push(vals, 35); vals = list_push(vals, 55); vals = list_push(vals, 64);
    vals = list_push(vals, 81); vals = list_push(vals, 104); vals = list_push(vals, 113); vals = list_push(vals, 92);
    vals = list_push(vals, 49); vals = list_push(vals, 64); vals = list_push(vals, 78); vals = list_push(vals, 87);
    vals = list_push(vals, 103); vals = list_push(vals, 121); vals = list_push(vals, 120); vals = list_push(vals, 101);
    vals = list_push(vals, 72); vals = list_push(vals, 92); vals = list_push(vals, 95); vals = list_push(vals, 98);
    vals = list_push(vals, 112); vals = list_push(vals, 100); vals = list_push(vals, 103); vals = list_push(vals, 99);
    return JpegQuantTable { table_id: 0, values: vals };
}

pub fn jpeg_std_chrominance_table() -> JpegQuantTable {
    let mut vals: List[Int] = list_new();
    vals = list_push(vals, 17); vals = list_push(vals, 18); vals = list_push(vals, 24); vals = list_push(vals, 47);
    vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99);
    vals = list_push(vals, 18); vals = list_push(vals, 21); vals = list_push(vals, 26); vals = list_push(vals, 66);
    vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99);
    vals = list_push(vals, 24); vals = list_push(vals, 26); vals = list_push(vals, 56); vals = list_push(vals, 99);
    vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99);
    vals = list_push(vals, 47); vals = list_push(vals, 66); vals = list_push(vals, 99); vals = list_push(vals, 99);
    vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99);
    vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99);
