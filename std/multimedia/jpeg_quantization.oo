    vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99);
    vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99);
    vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99);
    vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99);
    vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99); vals = list_push(vals, 99);
    return JpegQuantTable { table_id: 1, values: vals };
}

pub fn jpeg_scale_quality(quality: Int) -> Int {
    let mut q: Int = quality;
    if q <= 0 { q = 1; }
    if q > 100 { q = 100; }
    if q < 50 {
        return 5000 / q;
    }
    return 200 - (q * 2);
}

pub fn jpeg_scale_quant_table(base_table: &JpegQuantTable, quality: Int) -> JpegQuantTable {
    let scale: Int = jpeg_scale_quality(quality);
    let mut new_vals: List[Int] = list_new();
    let n: Int = list_len((base_table).values);
    let mut i: Int = 0;
    while i < n {
        let val: Int = list_get((base_table).values, i);
        let mut scaled: Int = (val * scale + 50) / 100;
        if scaled < 1 { scaled = 1; }
        if scaled > 255 { scaled = 255; }
        new_vals = list_push(new_vals, scaled);
        i = i + 1;
    }
    return JpegQuantTable {
        table_id: (base_table).table_id,
        values: new_vals,
    };
}
