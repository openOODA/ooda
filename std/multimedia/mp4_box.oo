// # ISO Base Media File Format (MP4 Box / Atom)
//
// Logline: Parses ISOBMFF / MP4 atom box headers, ftyp brand compatibility, and hierarchical movie containers.
//
// Setup: Pure multimedia container module for ISO/IEC 14496-12 MP4 stream structure traversal.
//
// Beats:
//   1. Enumerate standard ISOBMFF FourCC box types (ftyp, moov, mvhd, trak, mdat).
//   2. Define Mp4BoxHeader and Mp4FtypBox containers.
//   3. Compute box sizes, container offsets, and validate timescale/duration headers.

pub type Mp4BoxHeader = struct {
    box_type: String,   // 4-char FourCC e.g. "ftyp", "moov", "mdat"
    box_size: Int,      // Total box size in bytes including 8-byte header
    is_extended: Bool  // True if 64-bit largesize
};

pub type Mp4FtypBox = struct {
    major_brand: String,        // e.g. "isom", "mp42"
    minor_version: Int,
    compatible_brands: List[String]
};

pub type Mp4MvhdBox = struct {
    version: Int,
    timescale: Int,
    duration: Int,
    rate: Float,
    volume: Float
};

pub fn mp4_box_header_new(box_type: String, payload_size: Int) -> Mp4BoxHeader {
    return Mp4BoxHeader {
        box_type: box_type,
        box_size: 8 + payload_size,
        is_extended: false
    };
}

pub fn mp4_box_is_container(box_type: String) -> Bool {
    return box_type == "moov" || box_type == "trak" || box_type == "mdia" ||
           box_type == "minf" || box_type == "stbl" || box_type == "edts";
}

pub fn mp4_box_is_media_data(box_type: String) -> Bool {
    return box_type == "mdat";
}

pub fn mp4_ftyp_default() -> Mp4FtypBox {
    let mut brands: List[String] = list_new();
    brands = list_push(brands, "isom");
    brands = list_push(brands, "iso2");
    brands = list_push(brands, "avc1");
    brands = list_push(brands, "mp41");

    return Mp4FtypBox {
        major_brand: "isom",
        minor_version: 512,
        compatible_brands: brands
    };
}

pub fn mp4_mvhd_default(timescale: Int, duration_units: Int) -> Mp4MvhdBox {
    return Mp4MvhdBox {
        version: 0,
        timescale: timescale,
        duration: duration_units,
        rate: 1.0,
        volume: 1.0
    };
}

pub fn mp4_duration_seconds(mvhd: &Mp4MvhdBox) -> Float {
    if (mvhd).timescale <= 0 {
        return 0.0;
    }
    let mut ts_f: Float = 0.0;
    let mut count_ts: Int = (mvhd).timescale;
    while count_ts >= 10000 { ts_f = ts_f + 10000.0; count_ts = count_ts - 10000; }
    while count_ts >= 1000 { ts_f = ts_f + 1000.0; count_ts = count_ts - 1000; }
    while count_ts >= 100 { ts_f = ts_f + 100.0; count_ts = count_ts - 100; }
    while count_ts >= 10 { ts_f = ts_f + 10.0; count_ts = count_ts - 10; }
    while count_ts >= 1 { ts_f = ts_f + 1.0; count_ts = count_ts - 1; }

    let mut dur_f: Float = 0.0;
    let mut count_dur: Int = (mvhd).duration;
    while count_dur >= 10000 { dur_f = dur_f + 10000.0; count_dur = count_dur - 10000; }
    while count_dur >= 1000 { dur_f = dur_f + 1000.0; count_dur = count_dur - 1000; }
    while count_dur >= 100 { dur_f = dur_f + 100.0; count_dur = count_dur - 100; }
    while count_dur >= 10 { dur_f = dur_f + 10.0; count_dur = count_dur - 10; }
    while count_dur >= 1 { dur_f = dur_f + 1.0; count_dur = count_dur - 1; }

    return dur_f / ts_f;
}
