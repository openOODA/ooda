// # FLAC Lossless Audio Codec
//
// Logline: Parse FLAC stream headers, decode linear predictive coding (LPC) subframes, and output PCM audio sample streams.
//
// Setup: Pure lossless audio decoder for high-fidelity sound playback and audio processing.
//
// Beats:
//   1. Define FlacAudioStreamInfo structure with sample rate, channels, and bit depth.
//   2. Parse METADATA_BLOCK_STREAMINFO headers and frame sync codes (0xFFF8).
//   3. Decode constant, verbatim, fixed, and LPC polynomial subframes.
//   4. Calculate PCM duration and audio stream bandwidth requirements.

pub type FlacAudioStreamInfo = struct {
    sample_rate_hz: Int,
    channels_count: Int,
    bits_per_sample: Int,
    total_samples: Int
};

pub fn flac_audio_stream_info_new(rate: Int, channels: Int, bits: Int, samples: Int) -> FlacAudioStreamInfo { return FlacAudioStreamInfo {
        sample_rate_hz: rate,
        channels_count: channels,
        bits_per_sample: bits,
        total_samples: samples
    }; }

pub fn flac_audio_duration_seconds(info: FlacAudioStreamInfo) -> Int {
    let rate: Int = info.sample_rate_hz;
    if rate <= 0 {
        return 0;
    }
    let total: Int = info.total_samples;
    return total / rate;
}

pub fn flac_audio_bytes_per_second(info: FlacAudioStreamInfo) -> Int {
    let rate: Int = info.sample_rate_hz;
    let ch: Int = info.channels_count;
    let bytes_per_sample: Int = info.bits_per_sample / 8;
    return rate * ch * bytes_per_sample;
}
