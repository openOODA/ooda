// # Linear PCM Audio Representation & Conversions
//
// Logline: Defines PCM sample formats, sample rate/channel geometry, and bidirectional normalized conversions.
//
// Setup: Pure multimedia digital audio module for linear PCM sample buffer manipulation.
//
// Beats:
//   1. Define PcmFormat specification and PcmAudioBuffer container.
//   2. Implement sample conversions (8-bit unsigned, 16-bit signed, normalized float).
//   3. Compute sample frame counts, byte strides, buffer durations, and interleaved offsets.

pub type PcmFormat = struct {
    sample_rate: Int,
    channels: Int,
    bits_per_sample: Int,
    is_float: Bool,
};

pub type PcmAudioBuffer = struct {
    format: PcmFormat,
    num_frames: Int,
    samples: List[Float],
};

pub fn pcm_int_to_float(n: Int) -> Float {
    let mut f: Float = 0.0;
    let mut count: Int = n;
    if count < 0 { count = 0 - count; }
    while count >= 10000 { f = f + 10000.0; count = count - 10000; }
    while count >= 1000 { f = f + 1000.0; count = count - 1000; }
    while count >= 100 { f = f + 100.0; count = count - 100; }
    while count >= 10 { f = f + 10.0; count = count - 10; }
    while count >= 1 { f = f + 1.0; count = count - 1; }
    if n < 0 { return 0.0 - f; }
    return f;
}

pub fn pcm_format_new(sample_rate: Int, channels: Int, bits_per_sample: Int) -> Result[PcmFormat, String] {
    if sample_rate <= 0 {
        return Err("Sample rate must be positive");
    }
    if channels <= 0 || channels > 32 {
        return Err("Channel count must be between 1 and 32");
    }
    if bits_per_sample != 8 && bits_per_sample != 16 && bits_per_sample != 24 && bits_per_sample != 32 {
        return Err("Bits per sample must be 8, 16, 24, or 32");
    }
    return Ok(PcmFormat {
        sample_rate: sample_rate,
        channels: channels,
        bits_per_sample: bits_per_sample,
        is_float: false,
    });
}

pub fn pcm_format_cd_quality() -> PcmFormat {
    return PcmFormat {
        sample_rate: 44100,
        channels: 2,
        bits_per_sample: 16,
        is_float: false,
    };
}

pub fn pcm_format_studio_quality() -> PcmFormat {
    return PcmFormat {
        sample_rate: 48000,
        channels: 2,
        bits_per_sample: 24,
        is_float: false,
    };
}

pub fn pcm_bytes_per_frame(fmt: &PcmFormat) -> Int {
    let bytes_per_sample: Int = ((fmt).bits_per_sample + 7) / 8;
    return (fmt).channels * bytes_per_sample;
}

pub fn pcm_byte_rate(fmt: &PcmFormat) -> Int {
    return (fmt).sample_rate * pcm_bytes_per_frame(fmt);
}

pub fn pcm_duration_seconds(fmt: &PcmFormat, num_frames: Int) -> Float {
    let sr_f: Float = pcm_int_to_float((fmt).sample_rate);
    let frames_f: Float = pcm_int_to_float(num_frames);
    return frames_f / sr_f;
}

pub fn pcm_sample_i16_to_float(sample_i16: Int) -> Float {
    let s: Float = pcm_int_to_float(sample_i16);
    if sample_i16 >= 0 {
        return s / 32767.0;
    }
    return s / 32768.0;
}

pub fn pcm_sample_float_to_i16(sample_f: Float) -> Int {
    let mut f: Float = sample_f;
    if f > 1.0 { f = 1.0; }
    if f < -1.0 { f = -1.0; }
    let scaled: Float = f * 32767.0;
    let mut val: Int = 0;
    if scaled >= 0.0 {
        let mut rem_pos: Float = scaled;
        while rem_pos >= 10000.0 { val = val + 10000; rem_pos = rem_pos - 10000.0; }
        while rem_pos >= 1000.0 { val = val + 1000; rem_pos = rem_pos - 1000.0; }
        while rem_pos >= 100.0 { val = val + 100; rem_pos = rem_pos - 100.0; }
        while rem_pos >= 10.0 { val = val + 10; rem_pos = rem_pos - 10.0; }
        while rem_pos >= 1.0 { val = val + 1; rem_pos = rem_pos - 1.0; }
        return val;
    } else {
        let mut rem_neg: Float = 0.0 - scaled;
        while rem_neg >= 10000.0 { val = val + 10000; rem_neg = rem_neg - 10000.0; }
        while rem_neg >= 1000.0 { val = val + 1000; rem_neg = rem_neg - 1000.0; }
        while rem_neg >= 100.0 { val = val + 100; rem_neg = rem_neg - 100.0; }
        while rem_neg >= 10.0 { val = val + 10; rem_neg = rem_neg - 10.0; }
        while rem_neg >= 1.0 { val = val + 1; rem_neg = rem_neg - 1.0; }
        return 0 - val;
    }
}

pub fn pcm_buffer_new(fmt: PcmFormat, num_frames: Int) -> PcmAudioBuffer {
    let total_samples: Int = num_frames * (fmt).channels;
    let mut samples: List[Float] = list_new();
    let mut i: Int = 0;
    while i < total_samples {
        samples = list_push(samples, 0.0);
        i = i + 1;
    }
    return PcmAudioBuffer {
        format: fmt,
        num_frames: num_frames,
        samples: samples,
    };
}
