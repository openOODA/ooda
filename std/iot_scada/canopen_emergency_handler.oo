// # CANopen Emergency (EMCY) Message Object
//
// Logline: Encodes and parses CANopen EMCY messages, error registers, and manufacturer codes.
//
// Setup: Broadcasts active device faults and clears error history on communication recovery.
//
// Beats:
//   1. Parse 8-byte EMCY frame (2-byte Emergency Error Code, 1-byte Error Register, 5-byte Manufacturer data).
//   2. Decode standard error categories (0x1000 Generic, 0x2000 Current, 0x3000 Voltage, 0x4000 Temp).
//   3. Maintain active error stack and report fault recovery status.

pub type CanopenEmergency = struct {
    cob_id: Int, // 0x080 + NodeID
    error_code: Int,
    error_register: Int,
    manufacturer_byte0: Int,
    manufacturer_byte1: Int,
    is_error_active: Bool
};

pub fn canopen_emcy_new(node_id: Int, err_code: Int, err_reg: Int) -> CanopenEmergency {
    return CanopenEmergency {
        cob_id: 128 + (node_id % 128),
        error_code: err_code,
        error_register: err_reg,
        manufacturer_byte0: 0,
        manufacturer_byte1: 0,
        is_error_active: (err_code != 0)
    };
}

pub fn canopen_emcy_is_temperature_error(emcy: &CanopenEmergency) -> Bool {
    return (emcy).error_code >= 16384 && (emcy).error_code < 20480; // 0x4000 - 0x4FFF
}

pub fn canopen_emcy_is_voltage_error(emcy: &CanopenEmergency) -> Bool {
    return (emcy).error_code >= 12288 && (emcy).error_code < 16384; // 0x3000 - 0x3FFF
}
