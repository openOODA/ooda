// # Industrial Setpoint Ramp and Soak Profile Generator
//
// Logline: Generates smooth rate-of-change limited ramp trajectories and soak plateaus for process control.
//
// Setup: Prevents thermal/mechanical shock by limiting acceleration and deceleration slopes.
//
// Beats:
//   1. Configure Ramp parameters (Target Setpoint, Acceleration Rate, Deceleration Rate, Hold Time).
//   2. Calculate discrete time step increments towards target setpoint.
//   3. Transition automatically into soak dwell phase upon setpoint convergence.

pub type PlcRampGenerator = struct {
    current_value: Float,
    target_setpoint: Float,
    ramp_rate_up: Float,   // Units per second
    ramp_rate_down: Float, // Units per second
    soak_time_target_s: Float,
    soak_time_elapsed_s: Float,
    is_ramping: Bool,
    is_soaking: Bool,
    is_complete: Bool,
};

pub fn plc_ramp_new(init_val: Float, target: Float, rate: Float, soak_s: Float) -> PlcRampGenerator {
    return PlcRampGenerator {
        current_value: init_val,
        target_setpoint: target,
        ramp_rate_up: rate,
        ramp_rate_down: rate,
        soak_time_target_s: soak_s,
        soak_time_elapsed_s: 0.0,
        is_ramping: true,
        is_soaking: false,
        is_complete: false,
    };
}

pub fn plc_ramp_step(gen: &PlcRampGenerator, dt_s: Float) -> PlcRampGenerator {
    let cur = (gen).current_value;
    let tgt = (gen).target_setpoint;

    if (gen).is_ramping {
        if cur < tgt {
            let next_val = cur + ((gen).ramp_rate_up * dt_s);
            if next_val >= tgt {
                return PlcRampGenerator {
                    current_value: tgt,
                    target_setpoint: tgt,
                    ramp_rate_up: (gen).ramp_rate_up,
                    ramp_rate_down: (gen).ramp_rate_down,
                    soak_time_target_s: (gen).soak_time_target_s,
                    soak_time_elapsed_s: 0.0,
                    is_ramping: false,
                    is_soaking: true,
                    is_complete: false,
                };
            } else {
                return PlcRampGenerator {
                    current_value: next_val,
                    target_setpoint: tgt,
                    ramp_rate_up: (gen).ramp_rate_up,
                    ramp_rate_down: (gen).ramp_rate_down,
                    soak_time_target_s: (gen).soak_time_target_s,
                    soak_time_elapsed_s: 0.0,
                    is_ramping: true,
                    is_soaking: false,
                    is_complete: false,
                };
            }
        }
    }

    if (gen).is_soaking {
        let new_soak = (gen).soak_time_elapsed_s + dt_s;
        let done = new_soak >= (gen).soak_time_target_s;
        return PlcRampGenerator {
            current_value: cur,
            target_setpoint: tgt,
            ramp_rate_up: (gen).ramp_rate_up,
            ramp_rate_down: (gen).ramp_rate_down,
            soak_time_target_s: (gen).soak_time_target_s,
            soak_time_elapsed_s: new_soak,
            is_ramping: false,
            is_soaking: !done,
            is_complete: done,
        };
    }

    return *gen;
}
