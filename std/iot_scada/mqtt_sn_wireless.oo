// # MQTT-SN Wireless Sensor Network Protocol
//
// Logline: Implements MQTT for Sensor Networks (MQTT-SN) message encoding and sleep mode coordination.
//
// Setup: Low-overhead binary packet serialization for battery-powered Zigbee/LoRa industrial nodes.
//
// Beats:
//   1. Encode MQTT-SN messages: SEARCHGW, GWINFO, CONNECT, CONNACK, REGISTER, REGACK, PUBLISH.
//   2. Support 2-octet Short Topic IDs and Pre-defined Topic IDs for bandwidth reduction.
//   3. Manage ASLEEP, AWAKE, and DISCONNECTED power management states.

pub type MqttSnPacket = struct {
    msg_type: Int, // 1=SEARCHGW, 2=GWINFO, 4=CONNECT, 5=CONNACK, 10=REGISTER, 11=REGACK, 12=PUBLISH
    msg_length: Int,
    topic_id: Int,
    msg_id: Int,
    qos: Int,
    retain: Bool,
    payload: List[Int]
};

pub fn mqtt_sn_msg_connect() -> Int { return 4; }
pub fn mqtt_sn_msg_publish() -> Int { return 12; }
pub fn mqtt_sn_msg_disconnect() -> Int { return 24; }

pub fn mqtt_sn_publish_new(topic_id: Int, msg_id: Int, qos: Int, payload: &List[Int]) -> MqttSnPacket {
    let plen = list_len(*payload);
    return MqttSnPacket {
        msg_type: 12, // PUBLISH
        msg_length: plen + 7,
        topic_id: topic_id % 65536,
        msg_id: msg_id % 65536,
        qos: qos % 4,
        retain: false,
        payload: *payload
    };
}

pub fn mqtt_sn_connect_new(duration_sec: Int) -> MqttSnPacket {
    return MqttSnPacket {
        msg_type: 4, // CONNECT
        msg_length: 6,
        topic_id: 0,
        msg_id: 0,
        qos: 0,
        retain: false,
        payload: list_new()
    };
}
