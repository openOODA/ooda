// # Modbus Register Memory Map and Data Conversions
//
// Logline: Manages 16-bit register address space, word swapping, and 32-bit float/int conversions.
//
// Setup: Emulates PLC register tables with Big-Endian, Little-Endian, and Mid-Little byte orders.
//
// Beats:
//   1. Maintain 16-bit holding and input register address blocks.
//   2. Encode and decode 32-bit IEEE-754 floats across two consecutive 16-bit Modbus registers.
//   3. Perform Word-Swap and Byte-Swap transformations for heterogeneous PLC hardware.

pub type ModbusRegisterMap = struct {
    holding_regs: List[Int],
    input_regs: List[Int],
    coils: List[Bool],
    discrete_inputs: List[Bool],
    capacity: Int
};

pub fn modbus_regmap_new(cap: Int) -> ModbusRegisterMap {
    let mut hr: List[Int] = list_new();
    let mut ir: List[Int] = list_new();
    let mut c: List[Bool] = list_new();
    let mut di: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < cap {
        hr = list_push(hr, 0);
        ir = list_push(ir, 0);
        c = list_push(c, false);
        di = list_push(di, false);
        i = i + 1;
    }
    return ModbusRegisterMap {
        holding_regs: hr,
        input_regs: ir,
        coils: c,
        discrete_inputs: di,
        capacity: cap
    };
}

pub fn modbus_pack_u32_to_registers(val: Int, word_swap: Bool) -> List[Int] {
    let mut out: List[Int] = list_new();
    let hi_word = (val / 65536) % 65536;
    let lo_word = val % 65536;
    if word_swap {
        out = list_push(out, lo_word);
        out = list_push(out, hi_word);
    } else {
        out = list_push(out, hi_word);
        out = list_push(out, lo_word);
    }
    return out;
}

pub fn modbus_unpack_u32_from_registers(reg1: Int, reg2: Int, word_swap: Bool) -> Int {
    if word_swap {
        return (reg2 * 65536) + reg1;
    } else {
        return (reg1 * 65536) + reg2;
    }
}
