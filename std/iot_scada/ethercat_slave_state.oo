// # EtherCAT State Machine (ESM) and AL Status Engine
//
// Logline: Manages EtherCAT State Machine transitions (Init, Pre-Op, Safe-Op, Op) and AL control codes.
//
// Setup: Enforces deterministic slave initialization, mailbox verification, and process data sync.
//
// Beats:
//   1. Model ESM states: Init (0x01), Pre-Op (0x02), Boot (0x03), Safe-Op (0x04), Op (0x08).
//   2. Validate AL Control request state transitions and generate AL Status codes.
//   3. Handle error flags, state acknowledgment, and AL Status Code diagnostics.

pub type EthercatSlaveState = struct {
    slave_id: Int,
    current_state: Int, // 1=Init, 2=PreOp, 3=Boot, 4=SafeOp, 8=Op
    requested_state: Int,
    error_flag: Bool,
    al_status_code: Int
};

pub fn ethercat_state_init() -> Int { return 1; }
pub fn ethercat_state_preop() -> Int { return 2; }
pub fn ethercat_state_safeop() -> Int { return 4; }
pub fn ethercat_state_op() -> Int { return 8; }

pub fn ethercat_slave_new(id: Int) -> EthercatSlaveState {
    return EthercatSlaveState {
        slave_id: id,
        current_state: 1, // Init
        requested_state: 1,
        error_flag: false,
        al_status_code: 0
    };
}

pub fn ethercat_slave_request_transition(slave: &EthercatSlaveState, target: Int) -> EthercatSlaveState {
    let cur = (slave).current_state;
    let mut valid = false;
    if cur == 1 && target == 2 { valid = true; } // Init -> PreOp
    if cur == 2 && target == 4 { valid = true; } // PreOp -> SafeOp
    if cur == 4 && target == 8 { valid = true; } // SafeOp -> Op
    if target == 1 { valid = true; }             // Any -> Init
    if cur == 8 && target == 4 { valid = true; } // Op -> SafeOp
    if cur == 4 && target == 2 { valid = true; } // SafeOp -> PreOp

    if valid {
        return EthercatSlaveState {
            slave_id: (slave).slave_id,
            current_state: target,
            requested_state: target,
            error_flag: false,
            al_status_code: 0
        };
    } else {
        return EthercatSlaveState {
            slave_id: (slave).slave_id,
            current_state: cur,
            requested_state: target,
            error_flag: true,
            al_status_code: 17 // Invalid requested state change
        };
    }
}
