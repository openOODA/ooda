// # PROFINET Real-Time (RT) Frame Structure
//
// Logline: Encodes PROFINET IO Real-Time (EtherType 0x8892) cyclic frames, Cycle Counter, and IOxS status.
//
// Setup: Validates FrameID ranges (0x8000-0xBBFF RTC), APDU status, and DataStatus bitmasks.
//
// Beats:
//   1. Build PROFINET RT Frame header with 16-bit FrameID and 16-bit Cycle Counter.
//   2. Encode IO Input/Output Data Object Provider/Consumer Status (IOPS / IOCS).
//   3. Package DataStatus byte (Primary/Backup, DataValid, Problem, Run/Stop) and TransferStatus.

pub type ProfinetRtFrame = struct {
    frame_id: Int, // 0x8000 - 0xBBFF for Real-Time Cyclic
    cycle_counter: Int, // 16-bit counter incremented every send clock
    data_status: Int, // Bit 0: State(Primary), Bit 2: DataValid, Bit 4: Run
    transfer_status: Int,
    payload_length: Int,
    is_valid: Bool
};

pub fn profinet_rt_frame_new(fid: Int, cycle: Int, len: Int) -> ProfinetRtFrame {
    return ProfinetRtFrame {
        frame_id: fid % 65536,
        cycle_counter: cycle % 65536,
        data_status: 53, // Primary, Valid, Run (0x35)
        transfer_status: 0,
        payload_length: len,
        is_valid: true
    };
}

pub fn profinet_rt_is_data_valid(frame: &ProfinetRtFrame) -> Bool {
    return ((frame).data_status / 4) % 2 == 1; // Bit 2 is DataValid
}

pub fn profinet_rt_is_run_mode(frame: &ProfinetRtFrame) -> Bool {
    return ((frame).data_status / 16) % 2 == 1; // Bit 4 is Run
}
