// # OPC UA DataValue and StatusCode Encoding
//
// Logline: Formats DataValue packets with source/server timestamps and status code masks.
//
// Setup: Implements Part 4 StatusCode bitmasks (Good, Uncertain, Bad) and timestamp flags.
//
// Beats:
//   1. Bitmask 32-bit StatusCode values (0x00000000 Good, 0x40000000 Uncertain, 0x80000000 Bad).
//   2. Package 64-bit UTC SourceTimestamp and ServerTimestamp in 100-nanosecond intervals.
//   3. Encode DataValue encoding masks for bandwidth-efficient transmission.

pub type OpcUaDataValue = struct {
    status_code: Int, // 0 = Good, 1 = Uncertain, 2 = Bad
    source_timestamp: Int,
    server_timestamp: Int,
    has_source_timestamp: Bool,
    has_server_timestamp: Bool,
    float_value: Float,
    is_good: Bool,
};

pub fn opcua_status_good() -> Int { return 0; }
pub fn opcua_status_uncertain() -> Int { return 1; }
pub fn opcua_status_bad() -> Int { return 2; }

pub fn opcua_data_value_good(val: Float, src_ts: Int, srv_ts: Int) -> OpcUaDataValue {
    return OpcUaDataValue {
        status_code: 0,
        source_timestamp: src_ts,
        server_timestamp: srv_ts,
        has_source_timestamp: true,
        has_server_timestamp: true,
        float_value: val,
        is_good: true,
    };
}

pub fn opcua_data_value_bad(code: Int) -> OpcUaDataValue {
    return OpcUaDataValue {
        status_code: if code == 0 { 2 } else { code },
        source_timestamp: 0,
        server_timestamp: 0,
        has_source_timestamp: false,
        has_server_timestamp: false,
        float_value: 0.0,
        is_good: false,
    };
}
