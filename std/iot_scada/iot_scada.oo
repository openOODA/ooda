pub fn scada_shim_modbus_rtu_crc(bytes: &List[Int]) -> Int {
    return modbus_rtu_crc16(bytes);
}

pub fn scada_shim_dnp3_app_req(fc: Int, seq: Int) -> Dnp3AppMessage {
    return dnp3_app_request_new(fc, seq);
}

pub fn scada_shim_ethercat_slave(id: Int) -> EthercatSlaveState {
    return ethercat_slave_new(id);
}

pub fn scada_shim_canopen_nmt_start(target: Int) -> CanopenNmtMaster {
    let m = canopen_nmt_master_new(target);
    return canopen_nmt_start_node(&m);
}

pub fn scada_shim_plc_pid(kp: Float, ki: Float, kd: Float, ts: Float) -> PlcPidController {
    return plc_pid_new(kp, ki, kd, ts, 0.0, 100.0);
}

pub fn scada_shim_isa_alarm(id: Int, prio: Int, trip: Float) -> IsaAlarmState {
    return isa_alarm_new(id, prio, trip);
}
