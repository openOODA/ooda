// # IEC 61131-3 Standard Counters (CTU, CTD, CTUD)
//
// Logline: Implements Count Up (CTU), Count Down (CTD), and Up/Down (CTUD) PLC counter function blocks.
//
// Setup: Tracks edge triggers (CU, CD), presets (PV), current count value (CV), and limit flags (QU, QD).
//
// Beats:
//   1. Execute CTU: counts rising edges of CU up to preset PV and asserts output QU.
//   2. Execute CTD: decrements from PV to 0 on CD rising edges and asserts output QD.
//   3. Execute bidirectional CTUD with Reset (R) and Load (LD) inputs.

pub type PlcCounterCtud = struct {
    cu_prev: Bool,
    cd_prev: Bool,
    pv: Int, // Preset Value
    cv: Int, // Current Value
    qu: Bool, // Count Up Done
    qd: Bool // Count Down Done
};

pub fn plc_ctud_new(preset: Int) -> PlcCounterCtud {
    return PlcCounterCtud {
        cu_prev: false,
        cd_prev: false,
        pv: preset,
        cv: 0,
        qu: false,
        qd: true
    };
}

pub fn plc_ctud_step(ctr: &PlcCounterCtud, cu: Bool, cd: Bool, r: Bool, ld: Bool) -> PlcCounterCtud {
    let mut val = (ctr).cv;
    if r {
        val = 0;
    } else {
        if ld {
            val = (ctr).pv;
        } else {
            let rising_cu = cu && (!(ctr).cu_prev);
            let rising_cd = cd && (!(ctr).cd_prev);
            if rising_cu && val < 2147483647 {
                val = val + 1;
            }
            if rising_cd && val > 0 {
                val = val - 1;
            }
        }
    }

    return PlcCounterCtud {
        cu_prev: cu,
        cd_prev: cd,
        pv: (ctr).pv,
        cv: val,
        qu: val >= (ctr).pv,
        qd: val <= 0
    };
}
