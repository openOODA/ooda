// # CANopen over EtherCAT (CoE) Mailbox Protocol
//
// Logline: Implements CoE mailbox protocol headers, SDO upload/download, and emergency transport.
//
// Setup: Bridges standard CANopen object dictionary access over EtherCAT mailbox buffers.
//
// Beats:
//   1. Build standard 6-byte EtherCAT Mailbox Header (Length, Address, Channel, Priority, Type).
//   2. Encode CoE header with service type (Emergency, SDO Request, SDO Response, Information).
//   3. Package SDO Download and Upload requests with 16-bit Index and 8-bit Sub-index.

pub type EthercatMailboxHeader = struct {
    length: Int,
    address: Int,
    channel: Int,
    priority: Int,
    mailbox_type: Int, // 1=ERR, 2=EoE, 3=CoE, 4=FoE, 5=SoE
    counter: Int,
};

pub type EthercatCoeMessage = struct {
    mailbox_header: EthercatMailboxHeader,
    coe_service: Int, // 1=Emergency, 2=SDO Request, 3=SDO Response, 4=TxPDO, 5=RxPDO
    sdo_index: Int,
    sdo_subindex: Int,
    payload: List[Int],
};

pub fn ethercat_coe_sdo_req_new(addr: Int, index: Int, subindex: Int, data: &List[Int]) -> EthercatCoeMessage {
    let dlen = list_len(*data);
    let mbx = EthercatMailboxHeader {
        length: dlen + 6,
        address: addr,
        channel: 0,
        priority: 0,
        mailbox_type: 3, // CoE
        counter: 1,
    };
    return EthercatCoeMessage {
        mailbox_header: mbx,
        coe_service: 2, // SDO Request
        sdo_index: index,
        sdo_subindex: subindex,
        payload: *data,
    };
}
