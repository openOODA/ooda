// # ISA-18.2 / IEC 62682 SCADA Alarm State Machine
//
// Logline: Implements standard industrial alarm lifecycle states, acknowledgment, shelving, and priorities.
//
// Setup: Models Normal, Unack Alarm, Ack Alarm, Unack Return-to-Normal, Shelved, and Suppressed states.
//
// Beats:
//   1. Define ISA-18.2 alarm states and transitions based on process conditions and operator actions.
//   2. Classify alarm priorities (1=Low, 2=Medium, 3=High, 4=Emergency/Critical).
//   3. Handle operator Acknowledge, Reset, Shelve, and Unshelve commands.

pub type IsaAlarmState = struct {
    alarm_id: Int,
    state: Int, // 0=Normal, 1=UnackAlarm, 2=AckAlarm, 3=UnackNormal, 4=Shelved, 5=Suppressed
    priority: Int, // 1=Low, 2=Medium, 3=High, 4=Emergency
    trip_value: Float,
    deadband: Float,
    is_active: Bool,
    unacknowledged: Bool,
};

pub fn isa_alarm_new(id: Int, prio: Int, trip: Float) -> IsaAlarmState {
    return IsaAlarmState {
        alarm_id: id,
        state: 0, // Normal
        priority: prio,
        trip_value: trip,
        deadband: 1.0,
        is_active: false,
        unacknowledged: false,
    };
}

pub fn isa_alarm_evaluate_pv(alarm: &IsaAlarmState, pv: Float) -> IsaAlarmState {
    let triggered = pv >= (alarm).trip_value;
    let cur_state = (alarm).state;

    if triggered && (cur_state == 0 || cur_state == 3) {
        return IsaAlarmState {
            alarm_id: (alarm).alarm_id,
            state: 1, // UnackAlarm
            priority: (alarm).priority,
            trip_value: (alarm).trip_value,
            deadband: (alarm).deadband,
            is_active: true,
            unacknowledged: true,
        };
    }

    if (!triggered) && cur_state == 1 {
        return IsaAlarmState {
            alarm_id: (alarm).alarm_id,
            state: 3, // UnackNormal
            priority: (alarm).priority,
            trip_value: (alarm).trip_value,
            deadband: (alarm).deadband,
            is_active: false,
            unacknowledged: true,
        };
    }

    if (!triggered) && cur_state == 2 {
        return IsaAlarmState {
            alarm_id: (alarm).alarm_id,
            state: 0, // Normal
            priority: (alarm).priority,
            trip_value: (alarm).trip_value,
            deadband: (alarm).deadband,
            is_active: false,
            unacknowledged: false,
        };
    }

    return *alarm;
}

pub fn isa_alarm_ack(alarm: &IsaAlarmState) -> IsaAlarmState {
    let cur = (alarm).state;
    let next = if cur == 1 { 2 } else { if cur == 3 { 0 } else { cur } };
    return IsaAlarmState {
        alarm_id: (alarm).alarm_id,
        state: next,
        priority: (alarm).priority,
        trip_value: (alarm).trip_value,
        deadband: (alarm).deadband,
        is_active: (alarm).is_active,
        unacknowledged: false,
    };
}
