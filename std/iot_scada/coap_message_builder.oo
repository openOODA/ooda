// # CoAP RFC 7252 Constrained Application Protocol Builder
//
// Logline: Builds binary CoAP request and response messages, token headers, and option delta encodings.
//
// Setup: Serializes UDP-based RESTful SCADA telemetry packets with CON, NON, ACK, and RST types.
//
// Beats:
//   1. Construct 4-byte CoAP header (Version 1, Type: CON/NON/ACK/RST, Token Length, Code).
//   2. Encode standard CoAP Method Codes (0.01 GET, 0.02 POST, 0.03 PUT, 0.04 DELETE).
//   3. Compute Option Delta and Option Length encodings for Uri-Path (11) and Content-Format (12).

pub type CoapMessage = struct {
    version: Int,
    message_type: Int, // 0=CON, 1=NON, 2=ACK, 3=RST
    code_class: Int,   // 0=Request, 2=Success, 4=ClientErr, 5=ServerErr
    code_detail: Int,  // e.g. 1=GET, 2=POST, 5=2.05 Content
    message_id: Int,
    token_len: Int,
    token_val: Int,
    payload_len: Int
};

pub fn coap_code_get() -> Int { return 1; }
pub fn coap_code_post() -> Int { return 2; }
pub fn coap_code_content() -> Int { return 69; } // 2.05

pub fn coap_message_con_get(msg_id: Int, token: Int) -> CoapMessage {
    return CoapMessage {
        version: 1,
        message_type: 0, // CON
        code_class: 0,   // Request
        code_detail: 1,  // GET
        message_id: msg_id % 65536,
        token_len: 2,
        token_val: token % 65536,
        payload_len: 0
    };
}

pub fn coap_message_ack_response(msg_id: Int, token: Int, payload_sz: Int) -> CoapMessage {
    return CoapMessage {
        version: 1,
        message_type: 2, // ACK
        code_class: 2,   // Success
        code_detail: 5,  // 2.05 Content
        message_id: msg_id % 65536,
        token_len: 2,
        token_val: token % 65536,
        payload_len: payload_sz
    };
}
