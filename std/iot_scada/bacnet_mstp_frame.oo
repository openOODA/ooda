// # BACnet MS/TP Frame Header and CRC Validation
//
// Logline: Implements BACnet Master-Slave/Token-Passing (MS/TP) RS-485 framing, CRC-8, and CRC-16.
//
// Setup: Validates preamble (0x55 0xFF), frame types, station MAC addresses, and token passing.
//
// Beats:
//   1. Parse standard MS/TP frame header with 0x55 0xFF preamble sync bytes.
//   2. Compute 8-bit Header CRC (CRC-8 polynomial X^8 + X^7 + 2's comp) and 16-bit Data CRC.
//   3. Handle standard frame types (Token, Poll For Master, BACnet Data Expecting Reply).

pub type BacnetMstpFrame = struct {
    frame_type: Int, // 0=Token, 1=PollForMaster, 2=ReplyToPollForMaster, 5=BACnetDataExpectingReply
    destination_address: Int,
    source_address: Int,
    data_length: Int,
    header_crc: Int,
    is_header_valid: Bool,
};

pub fn bacnet_mstp_crc8(bytes: &List[Int]) -> Int {
    let mut crc: Int = 255;
    let len = list_len(*bytes);
    let mut i: Int = 0;
    while i < len {
        let mut b = list_get(*bytes, i) % 256;
        let mut bit: Int = 0;
        while bit < 8 {
            let xor_flag = ((crc / 128) % 2) ^ ((b / 128) % 2);
            crc = (crc * 2) % 256;
            if xor_flag == 1 {
                crc = crc ^ 7; // Polynomial 0x07
            }
            b = (b * 2) % 256;
            bit = bit + 1;
        }
        i = i + 1;
    }
    return 255 - crc;
}

pub fn bacnet_mstp_token_frame(dest: Int, src: Int) -> BacnetMstpFrame {
    return BacnetMstpFrame {
        frame_type: 0, // Token
        destination_address: dest % 256,
        source_address: src % 256,
        data_length: 0,
        header_crc: 0,
        is_header_valid: true,
    };
}
