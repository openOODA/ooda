// # EtherCAT Frame Parser and Datagram Processor
//
// Logline: Parses Ethernet Type II EtherCAT (0x88A4) frames and extracts individual datagram commands.
//
// Setup: Processes APRD, APWR, NPRD, NPWR, BRD, BWR, LRD, and LWR datagrams and Working Counters.
//
// Beats:
//   1. Verify EtherCAT Ethernet frame header (Length, Reserved, Type 1=EtherCAT).
//   2. Parse datagram header (Cmd, Index, Address, Length, More Flag, IRQ, Working Counter).
//   3. Evaluate Working Counter (WKC) updates across industrial slave nodes.

pub type EthercatDatagram = struct {
    cmd: Int, // 1=APRD, 2=APWR, 4=NPRD, 5=NPWR, 7=BRD, 8=BWR, 10=LRD, 11=LWR, 12=LRW
    index: Int,
    address: Int,
    length: Int,
    has_more: Bool,
    circulating: Bool,
    working_counter: Int,
};

pub type EthercatFrame = struct {
    frame_length: Int,
    frame_type: Int,
    datagram_count: Int,
    is_valid: Bool,
};

pub fn ethercat_cmd_lrd() -> Int { return 10; }
pub fn ethercat_cmd_lwr() -> Int { return 11; }
pub fn ethercat_cmd_lrw() -> Int { return 12; }

pub fn ethercat_datagram_new(cmd: Int, idx: Int, addr: Int, len: Int) -> EthercatDatagram {
    return EthercatDatagram {
        cmd: cmd,
        index: idx % 256,
        address: addr,
        length: len % 2048,
        has_more: false,
        circulating: false,
        working_counter: 0,
    };
}

pub fn ethercat_datagram_increment_wkc(dg: &EthercatDatagram, inc: Int) -> EthercatDatagram {
    return EthercatDatagram {
        cmd: (dg).cmd,
        index: (dg).index,
        address: (dg).address,
        length: (dg).length,
        has_more: (dg).has_more,
        circulating: (dg).circulating,
        working_counter: (dg).working_counter + inc,
    };
}
