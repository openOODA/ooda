type OpcUaVariant = struct {
    kind: Int,
    int_val: Int
};

pub fn opcua_variant_new(kind: Int, int_val: Int) -> OpcUaVariant {
    return OpcUaVariant {
        kind: kind,
        int_val: int_val
    };
}

pub fn opcua_variant_int_val(v: OpcUaVariant) -> Int {
    return v.int_val;
}
