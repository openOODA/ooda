// # IEC 61131-3 Standard Timers (TON, TOF, TP)
//
// Logline: Implements On-Delay (TON), Off-Delay (TOF), and Pulse (TP) standard PLC timer function blocks.
//
// Setup: Tracks preset time (PT), accumulated elapsed time (ET), running state, and output Q flags.
//
// Beats:
//   1. Execute TON timer: delays output turn-ON until input IN remains true for duration PT.
//   2. Execute TOF timer: delays output turn-OFF after input IN goes false for duration PT.
//   3. Execute TP timer: generates a fixed pulse of duration PT on the rising edge of IN.

pub type PlcTimerTon = struct {
    in: Bool,
    pt_ms: Int,
    q: Bool,
    et_ms: Int,
    is_running: Bool
};

pub type PlcTimerTof = struct {
    in: Bool,
    pt_ms: Int,
    q: Bool,
    et_ms: Int,
    prev_in: Bool
};

pub type PlcTimerTp = struct {
    in: Bool,
    pt_ms: Int,
    q: Bool,
    et_ms: Int,
    is_pulsing: Bool,
    prev_in: Bool
};

pub fn plc_ton_new(preset_ms: Int) -> PlcTimerTon {
    return PlcTimerTon {
        in: false,
        pt_ms: preset_ms,
        q: false,
        et_ms: 0,
        is_running: false
    };
}

pub fn plc_ton_step(timer: &PlcTimerTon, in_signal: Bool, dt_ms: Int) -> PlcTimerTon {
    if !in_signal {
        return PlcTimerTon {
            in: false,
            pt_ms: (timer).pt_ms,
            q: false,
            et_ms: 0,
            is_running: false
        };
    }

    let mut new_et = (timer).et_ms + dt_ms;
    let mut done = false;
    if new_et >= (timer).pt_ms {
        new_et = (timer).pt_ms;
        done = true;
    }

    return PlcTimerTon {
        in: true,
        pt_ms: (timer).pt_ms,
        q: done,
        et_ms: new_et,
        is_running: !done
    };
}
