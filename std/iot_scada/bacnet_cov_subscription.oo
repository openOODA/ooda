// # BACnet Change of Value (COV) Subscription Manager
//
// Logline: Manages active COV client subscriptions, lifetime countdowns, and change event triggers.
//
// Setup: Automates SubscribeCOV service handling and dispatches confirmed/unconfirmed notifications.
//
// Beats:
//   1. Maintain active subscriber table (Subscriber Process ID, Monitored Object ID, Lifetime).
//   2. Evaluate analog COV increment thresholds and binary state changes.
//   3. Decrement subscription lifetimes and purge expired subscriptions.

pub type BacnetCovSubscription = struct {
    subscriber_process_id: Int,
    monitored_object_type: Int,
    monitored_instance: Int,
    issue_confirmed_notifications: Bool,
    remaining_lifetime_seconds: Int,
    cov_increment: Float,
    last_reported_float: Float,
    last_reported_bool: Bool,
    is_active: Bool
};

pub fn bacnet_cov_sub_new(proc_id: Int, obj_type: Int, inst: Int, lifetime: Int, inc: Float) -> BacnetCovSubscription {
    return BacnetCovSubscription {
        subscriber_process_id: proc_id,
        monitored_object_type: obj_type,
        monitored_instance: inst,
        issue_confirmed_notifications: false,
        remaining_lifetime_seconds: lifetime,
        cov_increment: inc,
        last_reported_float: 0.0,
        last_reported_bool: false,
        is_active: true
    };
}

pub fn bacnet_cov_check_analog(sub: &BacnetCovSubscription, current_val: Float) -> Bool {
    let diff = current_val - (sub).last_reported_float;
    let abs_diff = if diff < 0.0 { 0.0 - diff } else { diff };
    return abs_diff >= (sub).cov_increment;
}

pub fn bacnet_cov_tick(sub: &BacnetCovSubscription, dt_seconds: Int) -> BacnetCovSubscription {
    let rem = (sub).remaining_lifetime_seconds - dt_seconds;
    return BacnetCovSubscription {
        subscriber_process_id: (sub).subscriber_process_id,
        monitored_object_type: (sub).monitored_object_type,
        monitored_instance: (sub).monitored_instance,
        issue_confirmed_notifications: (sub).issue_confirmed_notifications,
        remaining_lifetime_seconds: if rem > 0 { rem } else { 0 },
        cov_increment: (sub).cov_increment,
        last_reported_float: (sub).last_reported_float,
        last_reported_bool: (sub).last_reported_bool,
        is_active: rem > 0
    };
}
