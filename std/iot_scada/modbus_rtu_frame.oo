// # Modbus RTU Serial Framing and CRC-16 Engine
//
// Logline: Modbus RTU RS-485 serial frame framing, CRC-16 validation, and t3.5 timing calculations.
//
// Setup: Computes standard CRC-16 with polynomial 0xA001 and enforces 3.5 character silence intervals.
//
// Beats:
//   1. Calculate CRC-16 tableless polynomial bit shifts over raw byte buffers.
//   2. Encode and decode RTU Application Data Unit (ADU) frames.
//   3. Calculate baudrate-dependent t1.5 and t3.5 character timeout periods in microseconds.

pub type ModbusRtuFrame = struct {
    slave_address: Int,
    function_code: Int,
    payload: List[Int],
    crc: Int,
    is_valid: Bool
};

pub fn modbus_rtu_crc16(bytes: &List[Int]) -> Int {
    let mut crc: Int = 65535; // 0xFFFF
    let len = list_len(*bytes);
    let mut i: Int = 0;
    while i < len {
        let b = list_get(*bytes, i) % 256;
        let lo = (crc % 256) + b;
        let hi = crc / 256;
        crc = (hi * 256) + (lo % 256);
        let mut bit: Int = 0;
        while bit < 8 {
            let lsb = crc % 2;
            crc = crc / 2;
            if lsb == 1 {
                let c_hi = ((crc / 256) + 160) % 256; // 0xA0
                let c_lo = ((crc % 256) + 1) % 256;   // 0x01
                crc = (c_hi * 256) + c_lo;
            }
            bit = bit + 1;
        }
        i = i + 1;
    }
    return crc % 65536;
}

pub fn modbus_rtu_calc_t35_us(baud_rate: Int) -> Int {
    if baud_rate <= 0 { return 1750; }
    if baud_rate > 19200 { return 1750; }
    // 3.5 chars * 11 bits/char * 1,000,000 / baud_rate
    return (38500000 / baud_rate);
}

pub fn modbus_rtu_frame_new(slave: Int, fc: Int, data: List[Int]) -> ModbusRtuFrame {
    let mut raw: List[Int] = list_new();
    raw = list_push(raw, slave % 256);
    raw = list_push(raw, fc % 256);
    let dlen = list_len(data);
    let mut i: Int = 0;
    while i < dlen {
        raw = list_push(raw, list_get(data, i) % 256);
        i = i + 1;
    }
    let computed_crc = modbus_rtu_crc16(&raw);
    return ModbusRtuFrame {
        slave_address: slave,
        function_code: fc,
        payload: data,
        crc: computed_crc,
        is_valid: true
    };
}
