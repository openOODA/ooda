// # DNP3 Unsolicited Response and Class Event Manager
//
// Logline: Manages Class 1, 2, and 3 event queues, unsolicited transmissions, and confirm timeouts.
//
// Setup: Automates event buffering, spontaneous reporting to SCADA masters, and retry policies.
//
// Beats:
//   1. Manage Class 1 (High priority), Class 2 (Medium), and Class 3 (Low) event buffers.
//   2. Evaluate unsolicited generation triggers based on event counts and holdoff timers.
//   3. Handle confirmation handshakes and message retransmission on timeout.

pub type Dnp3EventQueue = struct {
    class1_count: Int,
    class2_count: Int,
    class3_count: Int,
    max_queue_size: Int,
    unsolicited_enabled: Bool,
    unsolicited_seq: Int,
    pending_confirm: Bool,
    retry_count: Int,
};

pub fn dnp3_event_queue_new(max_size: Int) -> Dnp3EventQueue {
    return Dnp3EventQueue {
        class1_count: 0,
        class2_count: 0,
        class3_count: 0,
        max_queue_size: max_size,
        unsolicited_enabled: true,
        unsolicited_seq: 0,
        pending_confirm: false,
        retry_count: 0,
    };
}

pub fn dnp3_push_event(q: &Dnp3EventQueue, class_num: Int) -> Dnp3EventQueue {
    let mut c1 = (q).class1_count;
    let mut c2 = (q).class2_count;
    let mut c3 = (q).class3_count;
    if class_num == 1 && c1 < (q).max_queue_size { c1 = c1 + 1; }
    if class_num == 2 && c2 < (q).max_queue_size { c2 = c2 + 1; }
    if class_num == 3 && c3 < (q).max_queue_size { c3 = c3 + 1; }
    return Dnp3EventQueue {
        class1_count: c1,
        class2_count: c2,
        class3_count: c3,
        max_queue_size: (q).max_queue_size,
        unsolicited_enabled: (q).unsolicited_enabled,
        unsolicited_seq: (q).unsolicited_seq,
        pending_confirm: (q).pending_confirm,
        retry_count: (q).retry_count,
    };
}

pub fn dnp3_has_pending_events(q: &Dnp3EventQueue) -> Bool {
    return ((q).class1_count + (q).class2_count + (q).class3_count) > 0;
}
