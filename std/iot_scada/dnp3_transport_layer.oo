// # DNP3 Transport Layer Segment Reassembly
//
// Logline: Implements DNP3 single and multi-segment fragmentation and reassembly mechanics.
//
// Setup: Parses 1-byte transport control header (FIR, FIN, Sequence Number) for ASDU chunking.
//
// Beats:
//   1. Evaluate Transport Header bitfields (FIR = first segment, FIN = final segment, SEQ = 6-bit counter).
//   2. Fragment large Application Service Data Units (ASDUs) into 249-byte transport chunks.
//   3. Reassemble sequential incoming transport segments with sequence verification.

pub type Dnp3TransportHeader = struct {
    is_fir: Bool, // First segment
    is_fin: Bool, // Final segment
    sequence: Int, // 6-bit sequence number (0-63)
    raw_byte: Int
};

pub type Dnp3TransportReassembler = struct {
    expected_seq: Int,
    buffer: List[Int],
    is_complete: Bool,
    has_error: Bool
};

pub fn dnp3_transport_header_new(fir: Bool, fin: Bool, seq: Int) -> Dnp3TransportHeader {
    let mut b = seq % 64;
    if fir { b = b + 64; }  // bit 6
    if fin { b = b + 128; } // bit 7
    return Dnp3TransportHeader {
        is_fir: fir,
        is_fin: fin,
        sequence: seq % 64,
        raw_byte: b
    };
}

pub fn dnp3_transport_reassembler_new() -> Dnp3TransportReassembler {
    return Dnp3TransportReassembler {
        expected_seq: 0,
        buffer: list_new(),
        is_complete: false,
        has_error: false
    };
}
