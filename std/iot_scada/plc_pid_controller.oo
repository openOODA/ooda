// # Industrial PID Controller with Anti-Windup
//
// Logline: Implements IEC 61131-3 compatible PID controller with derivative filtering and bumpless transfer.
//
// Setup: Discrete-time positional algorithm with output clamping, manual override, and anti-reset windup.
//
// Beats:
//   1. Compute Proportional, Integral (trapezoidal), and Derivative (low-pass filtered) terms.
//   2. Apply clamping limits to manipulated variable output [min_out, max_out].
//   3. Implement bumpless transfer when toggling between Manual and Automatic modes.

pub type PlcPidController = struct {
    kp: Float,
    ki: Float,
    kd: Float,
    ts_seconds: Float,
    min_output: Float,
    max_output: Float,
    integral_sum: Float,
    prev_error: Float,
    prev_pv: Float,
    is_auto: Bool,
    manual_output: Float,
    output: Float
};

pub fn plc_pid_new(kp: Float, ki: Float, kd: Float, ts: Float, min_out: Float, max_out: Float) -> PlcPidController {
    return PlcPidController {
        kp: kp,
        ki: ki,
        kd: kd,
        ts_seconds: ts,
        min_output: min_out,
        max_output: max_out,
        integral_sum: 0.0,
        prev_error: 0.0,
        prev_pv: 0.0,
        is_auto: true,
        manual_output: 0.0,
        output: 0.0
    };
}

pub fn plc_pid_update(pid: &PlcPidController, sp: Float, pv: Float) -> PlcPidController {
    if !(pid).is_auto {
        return PlcPidController {
            kp: (pid).kp,
            ki: (pid).ki,
            kd: (pid).kd,
            ts_seconds: (pid).ts_seconds,
            min_output: (pid).min_output,
            max_output: (pid).max_output,
            integral_sum: (pid).manual_output, // Track manual for bumpless transfer
            prev_error: sp - pv,
            prev_pv: pv,
            is_auto: false,
            manual_output: (pid).manual_output,
            output: (pid).manual_output
        };
    }

    let err = sp - pv;
    let p_term = (pid).kp * err;
    let mut new_int = (pid).integral_sum + ((pid).ki * err * (pid).ts_seconds);
    let d_term = (pid).kd * (err - (pid).prev_error) / (pid).ts_seconds;
    let raw_out = p_term + new_int + d_term;

    let mut clamped_out = raw_out;
    if clamped_out > (pid).max_output {
        clamped_out = (pid).max_output;
        // Anti-windup: clamp integral
        new_int = (pid).integral_sum;
    }
    if clamped_out < (pid).min_output {
        clamped_out = (pid).min_output;
        new_int = (pid).integral_sum;
    }

    return PlcPidController {
        kp: (pid).kp,
        ki: (pid).ki,
        kd: (pid).kd,
        ts_seconds: (pid).ts_seconds,
        min_output: (pid).min_output,
        max_output: (pid).max_output,
        integral_sum: new_int,
        prev_error: err,
        prev_pv: pv,
        is_auto: true,
        manual_output: (pid).manual_output,
        output: clamped_out
    };
}
