// # Dual-SCADA Redundancy Arbiter and Failover Controller
//
// Logline: Manages Primary and Standby server heartbeats, split-brain mitigation, and automatic failover.
//
// Setup: Evaluates network ping health, database sync lag, and operator manual switchover requests.
//
// Beats:
//   1. Track primary server heartbeat counter and detect communication timeout faults.
//   2. Prevent Split-Brain dual-primary state via quorum voting and witness node checks.
//   3. Execute bumpless takeover and promote Standby node to Active Primary.

pub type ScadaRedundancyNode = struct {
    node_id: Int,
    is_primary: Bool,
    heartbeat_count: Int,
    last_heartbeat_ms: Int,
    db_sync_lag_ms: Int,
    witness_ping_ok: Bool,
    is_healthy: Bool
};

pub fn scada_node_primary_new(id: Int) -> ScadaRedundancyNode {
    return ScadaRedundancyNode {
        node_id: id,
        is_primary: true,
        heartbeat_count: 0,
        last_heartbeat_ms: 0,
        db_sync_lag_ms: 0,
        witness_ping_ok: true,
        is_healthy: true
    };
}

pub fn scada_node_standby_new(id: Int) -> ScadaRedundancyNode {
    return ScadaRedundancyNode {
        node_id: id,
        is_primary: false,
        heartbeat_count: 0,
        last_heartbeat_ms: 0,
        db_sync_lag_ms: 5,
        witness_ping_ok: true,
        is_healthy: true
    };
}

pub fn scada_check_failover_trigger(primary: &ScadaRedundancyNode, now_ms: Int, timeout_ms: Int) -> Bool {
    let dt = now_ms - (primary).last_heartbeat_ms;
    return dt > timeout_ms || !(primary).is_healthy;
}
