// # EtherCAT Distributed Clocks (DC) and Synchronization
//
// Logline: Synchronizes slave clocks with sub-microsecond precision and generates Sync0/Sync1 pulses.
//
// Setup: Computes propagation delay offsets and aligns 64-bit hardware system time registers.
//
// Beats:
//   1. Measure port-to-port cable propagation delays across the EtherCAT ring topology.
//   2. Calculate 64-bit System Time Offset against Reference Clock (first DC-capable slave).
//   3. Program Sync0 and Sync1 interrupt cycle times and pulse generation widths.

pub type EthercatDcConfig = struct {
    slave_id: Int,
    system_time_offset_ns: Int,
    propagation_delay_ns: Int,
    sync0_cycle_time_ns: Int,
    sync0_shift_time_ns: Int,
    is_sync0_enabled: Bool,
    sync_locked: Bool
};

pub fn ethercat_dc_new(slave: Int, cycle_ns: Int) -> EthercatDcConfig {
    return EthercatDcConfig {
        slave_id: slave,
        system_time_offset_ns: 0,
        propagation_delay_ns: 0,
        sync0_cycle_time_ns: cycle_ns,
        sync0_shift_time_ns: 0,
        is_sync0_enabled: true,
        sync_locked: false
    };
}

pub fn ethercat_dc_update_offset(cfg: &EthercatDcConfig, offset_ns: Int, prop_delay_ns: Int) -> EthercatDcConfig {
    return EthercatDcConfig {
        slave_id: (cfg).slave_id,
        system_time_offset_ns: offset_ns,
        propagation_delay_ns: prop_delay_ns,
        sync0_cycle_time_ns: (cfg).sync0_cycle_time_ns,
        sync0_shift_time_ns: (cfg).sync0_shift_time_ns,
        is_sync0_enabled: (cfg).is_sync0_enabled,
        sync_locked: true
    };
}
