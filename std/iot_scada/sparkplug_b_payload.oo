// # Sparkplug B SCADA Telemetry Protocol Codec
//
// Logline: Implements Eclipse Sparkplug B message definitions for MQTT SCADA operational infrastructure.
//
// Setup: Structures NBIRTH, NDATA, DBIRTH, DDATA, and DDEATH topic spaces and metric records.
//
// Beats:
//   1. Model Sparkplug B Metric structure with Name, Alias, Datatype, Timestamp, and Value.
//   2. Encode Node Birth (NBIRTH) and Device Birth (DBIRTH) metric dictionaries.
//   3. Track sequential Sequence Numbers (0-255) for edge-of-network state continuity.

pub type SparkplugMetric = struct {
    name: String,
    alias: Int,
    datatype: Int, // 1=Int8, 3=Int32, 9=Float, 11=Boolean, 12=String
    timestamp_ms: Int,
    float_value: Float,
    int_value: Int,
    bool_value: Bool,
    is_null: Bool
};

pub type SparkplugPayload = struct {
    timestamp_ms: Int,
    seq_number: Int, // 0-255
    metrics_count: Int,
    is_historical: Bool
};

pub fn sparkplug_metric_float(name: String, alias: Int, val: Float, ts: Int) -> SparkplugMetric {
    return SparkplugMetric {
        name: name,
        alias: alias,
        datatype: 9, // Float
        timestamp_ms: ts,
        float_value: val,
        int_value: 0,
        bool_value: false,
        is_null: false
    };
}

pub fn sparkplug_payload_new(seq: Int, count: Int, ts: Int) -> SparkplugPayload {
    return SparkplugPayload {
        timestamp_ms: ts,
        seq_number: seq % 256,
        metrics_count: count,
        is_historical: false
    };
}

pub fn sparkplug_next_seq(current: Int) -> Int {
    return (current + 1) % 256;
}
