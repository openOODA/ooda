// # HART Bell 202 FSK Physical and Data Link Framing
//
// Logline: Implements Highway Addressable Remote Transducer (HART) Bell 202 FSK telegram encoding.
//
// Setup: Manages preamble bytes (0xFF), Start Delimiters (STX/ACK), master/slave addresses, and LRC parity.
//
// Beats:
//   1. Encode preamble string (5 to 20 continuous 0xFF octets) for phase-locked loop synchronization.
//   2. Structure Short (1-byte) and Long (5-byte Unique Identifier) address frames.
//   3. Compute Longitudinal Parity Checksum (XOR) over all telegram characters.

pub type HartFrame = struct {
    preamble_length: Int,
    delimiter: Int, // 0x02 = STX (Master to Slave), 0x06 = ACK (Slave to Master)
    address_is_long: Bool,
    command: Int, // Command 0 = Read Unique ID, Command 1 = Read Primary Variable
    byte_count: Int,
    checksum_lrc: Int,
    is_valid: Bool
};

pub fn hart_frame_new(cmd: Int, is_master: Bool) -> HartFrame {
    return HartFrame {
        preamble_length: 5,
        delimiter: if is_master { 2 } else { 6 },
        address_is_long: false,
        command: cmd % 256,
        byte_count: 0,
        checksum_lrc: 0,
        is_valid: true
    };
}

pub fn hart_calc_checksum(bytes: &List[Int]) -> Int {
    let mut xor_sum: Int = 0;
    let len = list_len(*bytes);
    let mut i: Int = 0;
    while i < len {
        xor_sum = xor_sum ^ list_get(*bytes, i);
        i = i + 1;
    }
    return xor_sum % 256;
}
