// # BACnet APDU Protocol Data Unit Codec
//
// Logline: Encodes and parses BACnet Application Protocol Data Units (APDU) and service requests.
//
// Setup: Supports Confirmed-Request, Unconfirmed-Request, Simple-ACK, Complex-ACK, and Error PDUs.
//
// Beats:
//   1. Build APDU header byte specifying PDU Type, Segmented/More flags, and SA/NA flags.
//   2. Encode Confirmed Services (ReadProperty 12, WriteProperty 15, SubscribeCOV 5).
//   3. Handle Error and Abort PDU responses with standard Error Class and Error Code numbers.

pub type BacnetApdu = struct {
    pdu_type: Int, // 0=ConfirmedReq, 1=UnconfirmedReq, 2=SimpleACK, 3=ComplexACK, 5=Error, 7=Abort
    invoke_id: Int,
    service_choice: Int,
    is_segmented: Bool,
    max_segments: Int,
    max_apdu_length: Int
};

pub fn bacnet_service_read_property() -> Int { return 12; }
pub fn bacnet_service_write_property() -> Int { return 15; }
pub fn bacnet_service_subscribe_cov() -> Int { return 5; }

pub fn bacnet_apdu_confirmed_req(invoke_id: Int, service: Int) -> BacnetApdu {
    return BacnetApdu {
        pdu_type: 0, // Confirmed-Request-PDU
        invoke_id: invoke_id % 256,
        service_choice: service,
        is_segmented: false,
        max_segments: 0,
        max_apdu_length: 1476
    };
}

pub fn bacnet_apdu_unconfirmed_req(service: Int) -> BacnetApdu {
    return BacnetApdu {
        pdu_type: 1, // Unconfirmed-Request-PDU
        invoke_id: 0,
        service_choice: service,
        is_segmented: false,
        max_segments: 0,
        max_apdu_length: 1476
    };
}
