// # EtherCAT SyncManager and FMMU Channel Configuration
//
// Logline: Configures SyncManager channels (SM0-SM3) and FMMU logical-to-physical memory mappings.
//
// Setup: Allocates mailbox write/read and process data inputs/outputs across EtherCAT slaves.
//
// Beats:
//   1. Configure SyncManager registers (Physical Start Address, Length, Control, Status, Enable).
//   2. Map SM0 (Mailbox Out), SM1 (Mailbox In), SM2 (Process Outputs), SM3 (Process Inputs).
//   3. Set up Fieldbus Memory Management Unit (FMMU) logical byte/bit offset translation tables.

pub type EthercatSyncManager = struct {
    channel_index: Int, // 0=Mbx Out, 1=Mbx In, 2=PDO Out, 3=PDO In
    physical_start_addr: Int,
    length: Int,
    control_register: Int,
    status_register: Int,
    is_enabled: Bool,
};

pub type EthercatFmmu = struct {
    fmmu_index: Int,
    logical_start_addr: Int,
    length: Int,
    physical_start_addr: Int,
    read_enable: Bool,
    write_enable: Bool,
    is_active: Bool,
};

pub fn ethercat_sm_mailbox_out(start: Int, len: Int) -> EthercatSyncManager {
    return EthercatSyncManager {
        channel_index: 0,
        physical_start_addr: start,
        length: len,
        control_register: 38, // Buffered, Write
        status_register: 0,
        is_enabled: true,
    };
}

pub fn ethercat_sm_mailbox_in(start: Int, len: Int) -> EthercatSyncManager {
    return EthercatSyncManager {
        channel_index: 1,
        physical_start_addr: start,
        length: len,
        control_register: 34, // Buffered, Read
        status_register: 0,
        is_enabled: true,
    };
}

pub fn ethercat_fmmu_new(idx: Int, log_addr: Int, len: Int, phys_addr: Int) -> EthercatFmmu {
    return EthercatFmmu {
        fmmu_index: idx,
        logical_start_addr: log_addr,
        length: len,
        physical_start_addr: phys_addr,
        read_enable: true,
        write_enable: true,
        is_active: true,
    };
}
