// # Industrial Safety Instrumented Systems (SIS) Interlock Matrix
//
// Logline: Implements Cause & Effect matrix voting logic (1oo2, 2oo3) and SIL safety shutdown triggers.
//
// Setup: Evaluates multi-channel sensor diagnostics, proof testing intervals, and emergency trips.
//
// Beats:
//   1. Execute 1oo2 (One out of Two) and 2oo3 (Two out of Three) redundancy voting algorithms.
//   2. Detect channel discrepancy and trigger Safety Integrity Level (SIL) diagnostic alerts.
//   3. Assert Emergency Shutdown (ESD) interlock coil on confirmed multi-channel trip.

pub type SisVotingResult = struct {
    is_trip: Bool,
    channel_discrepancy: Bool,
    voted_value: Bool,
    active_channels: Int,
};

pub fn sis_vote_1oo2(ch1: Bool, ch2: Bool) -> SisVotingResult {
    let trip = ch1 || ch2;
    let disc = ch1 != ch2;
    return SisVotingResult {
        is_trip: trip,
        channel_discrepancy: disc,
        voted_value: trip,
        active_channels: 2,
    };
}

pub fn sis_vote_2oo3(ch1: Bool, ch2: Bool, ch3: Bool) -> SisVotingResult {
    let mut count: Int = 0;
    if ch1 { count = count + 1; }
    if ch2 { count = count + 1; }
    if ch3 { count = count + 1; }
    let trip = count >= 2;
    let disc = count == 1 || count == 2;
    return SisVotingResult {
        is_trip: trip,
        channel_discrepancy: disc,
        voted_value: trip,
        active_channels: 3,
    };
}
