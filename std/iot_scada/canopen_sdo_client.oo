// # CANopen SDO Client and Abort Code Handler
//
// Logline: Implements CANopen Service Data Object (SDO) expedited and segmented upload/download protocols.
//
// Setup: Accesses object dictionary entries with 16-bit index, 8-bit sub-index, and abort codes.
//
// Beats:
//   1. Encode SDO Expedited Download and Upload request command specifiers (CCS/SCS).
//   2. Process multi-segment transfer toggles with sequence byte checks.
//   3. Handle standard CANopen SDO abort codes (Object does not exist, Access unsupported).

pub type CanopenSdoClient = struct {
    node_id: Int,
    state: Int, // 0=Idle, 1=ExpeditedDownload, 2=SegmentedDownload, 3=Upload
    target_index: Int,
    target_subindex: Int,
    toggle_bit: Bool,
    is_complete: Bool,
    abort_code: Int,
};

pub fn canopen_sdo_client_new(node: Int) -> CanopenSdoClient {
    return CanopenSdoClient {
        node_id: node,
        state: 0,
        target_index: 0,
        target_subindex: 0,
        toggle_bit: false,
        is_complete: false,
        abort_code: 0,
    };
}

pub fn canopen_sdo_start_download(client: &CanopenSdoClient, idx: Int, subidx: Int) -> CanopenSdoClient {
    return CanopenSdoClient {
        node_id: (client).node_id,
        state: 1, // ExpeditedDownload
        target_index: idx,
        target_subindex: subidx,
        toggle_bit: false,
        is_complete: false,
        abort_code: 0,
    };
}

pub fn canopen_sdo_abort(client: &CanopenSdoClient, code: Int) -> CanopenSdoClient {
    return CanopenSdoClient {
        node_id: (client).node_id,
        state: 0,
        target_index: (client).target_index,
        target_subindex: (client).target_subindex,
        toggle_bit: false,
        is_complete: false,
        abort_code: code,
    };
}
