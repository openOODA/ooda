// # OPC UA Address Space Node Tree and References
//
// Logline: Organizes hierarchical address space nodes, references, and browse path traversals.
//
// Setup: Models Object, Variable, Method, and ObjectType nodes according to OPC UA Part 3.
//
// Beats:
//   1. Represent standard NodeClasses and hierarchical reference types (Organizes, HasComponent).
//   2. Build node descriptors with NamespaceIndex, IdentifierType, and DisplayName.
//   3. Traverse and resolve BrowsePath elements across nested address space namespaces.

pub type OpcUaNode = struct {
    namespace_index: Int,
    node_id_numeric: Int,
    node_id_string: String,
    node_class: Int, // 1=Object, 2=Variable, 4=Method, 8=ObjectType, 16=VariableType
    browse_name: String,
    display_name: String,
    parent_node_id: Int,
    is_root: Bool
};

pub fn opcua_node_new_root() -> OpcUaNode {
    return OpcUaNode {
        namespace_index: 0,
        node_id_numeric: 84, // RootFolder i=84
        node_id_string: "Root",
        node_class: 1, // Object
        browse_name: "Root",
        display_name: "Root",
        parent_node_id: 0,
        is_root: true
    };
}

pub fn opcua_node_new_variable(ns: Int, id: Int, name: String, parent_id: Int) -> OpcUaNode {
    return OpcUaNode {
        namespace_index: ns,
        node_id_numeric: id,
        node_id_string: name,
        node_class: 2, // Variable
        browse_name: name,
        display_name: name,
        parent_node_id: parent_id,
        is_root: false
    };
}

pub fn opcua_node_is_child_of(node: &OpcUaNode, parent_id: Int) -> Bool {
    return (node).parent_node_id == parent_id;
}
