// # DNP3 Application Layer Control and Function Codes
//
// Logline: Encodes Application Control headers, standard function codes, and Internal Indications (IIN).
//
// Setup: Implements IEEE 1815 master/outstation request-response transactions and indications.
//
// Beats:
//   1. Encode 1-byte Application Control field (FIR, FIN, CON, UNS, 4-bit Sequence Number).
//   2. Define standard Function Codes (Read, Write, Select, Operate, DirectOperate, ColdRestart).
//   3. Decode 2-byte Internal Indications (IIN1.0 All Stations, IIN1.4 Need Time, IIN2.0 Device Trouble).

pub type Dnp3AppControl = struct {
    is_fir: Bool,
    is_fin: Bool,
    is_con: Bool, // Confirmation requested
    is_uns: Bool, // Unsolicited message
    seq_num: Int, // 4-bit sequence (0-15)
    raw_byte: Int,
};

pub type Dnp3AppMessage = struct {
    control: Dnp3AppControl,
    function_code: Int,
    iin1: Int, // Outstation indications byte 1
    iin2: Int, // Outstation indications byte 2
    is_response: Bool,
};

pub fn dnp3_fc_read() -> Int { return 1; }
pub fn dnp3_fc_write() -> Int { return 2; }
pub fn dnp3_fc_select() -> Int { return 3; }
pub fn dnp3_fc_operate() -> Int { return 4; }
pub fn dnp3_fc_direct_operate() -> Int { return 5; }
pub fn dnp3_fc_unsolicited_response() -> Int { return 130; }

pub fn dnp3_app_control_new(fir: Bool, fin: Bool, con: Bool, uns: Bool, seq: Int) -> Dnp3AppControl {
    let mut b = seq % 16;
    if uns { b = b + 16; }
    if con { b = b + 32; }
    if fin { b = b + 64; }
    if fir { b = b + 128; }
    return Dnp3AppControl {
        is_fir: fir,
        is_fin: fin,
        is_con: con,
        is_uns: uns,
        seq_num: seq % 16,
        raw_byte: b,
    };
}

pub fn dnp3_app_request_new(fc: Int, seq: Int) -> Dnp3AppMessage {
    let ctrl = dnp3_app_control_new(true, true, false, false, seq);
    return Dnp3AppMessage {
        control: ctrl,
        function_code: fc,
        iin1: 0,
        iin2: 0,
        is_response: false,
    };
}
