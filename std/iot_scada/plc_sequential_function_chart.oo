// # IEC 61131-3 Sequential Function Chart (SFC)
//
// Logline: Implements SFC step-transition execution engine with initial steps, qualifiers, and branches.
//
// Setup: Executes deterministic step activation, transition condition evaluation, and action dispatches.
//
// Beats:
//   1. Model SFC Steps with active flags, step timers, and action qualifier masks (N, S, R).
//   2. Evaluate Transition guards and perform atomic step clearing and activation.
//   3. Handle parallel divergence (AND-branch) and alternative selection (OR-branch) topologies.

pub type SfcStep = struct {
    step_id: Int,
    is_initial: Bool,
    is_active: Bool,
    active_time_ms: Int
};

pub type SfcTransition = struct {
    from_step_id: Int,
    to_step_id: Int,
    condition: Bool,
    is_cleared: Bool
};

pub fn sfc_step_new(id: Int, init: Bool) -> SfcStep {
    return SfcStep {
        step_id: id,
        is_initial: init,
        is_active: init,
        active_time_ms: 0
    };
}

pub fn sfc_transition_eval(from_s: &SfcStep, trans_cond: Bool) -> Bool {
    return (from_s).is_active && trans_cond;
}

pub fn sfc_advance_step(current: &SfcStep, next: &SfcStep, cond: Bool) -> SfcStep {
    if (current).is_active && cond {
        return SfcStep {
            step_id: (current).step_id,
            is_initial: (current).is_initial,
            is_active: false,
            active_time_ms: 0
        };
    }
    return *current;
}
