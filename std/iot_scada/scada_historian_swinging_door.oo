// # SCADA Historian Swinging Door Trending (SDT)
//
// Logline: Implements Swinging Door lossy compression for high-throughput time-series process archives.
//
// Setup: Maintains opening slope bounds to discard redundant steady-state data points within tolerance.
//
// Beats:
//   1. Initialize upper and lower opening door slope angles from origin baseline point.
//   2. Evaluate incoming time-series telemetry samples and adjust parallel door slopes.
//   3. Archive compressed pivot point when upper slope falls below lower slope (door closed).

pub type SdtCompressor = struct {
    compression_deviation: Float, // Tolerance band E
    last_archived_time: Float,
    last_archived_val: Float,
    prev_time: Float,
    prev_val: Float,
    upper_slope: Float,
    lower_slope: Float,
    has_points: Bool,
    must_archive: Bool
};

pub fn sdt_compressor_new(tolerance: Float) -> SdtCompressor {
    return SdtCompressor {
        compression_deviation: tolerance,
        last_archived_time: 0.0,
        last_archived_val: 0.0,
        prev_time: 0.0,
        prev_val: 0.0,
        upper_slope: 1000000.0,
        lower_slope: -1000000.0,
        has_points: false,
        must_archive: false
    };
}

pub fn sdt_compressor_push(c: &SdtCompressor, t: Float, v: Float) -> SdtCompressor {
    if !(c).has_points {
        return SdtCompressor {
            compression_deviation: (c).compression_deviation,
            last_archived_time: t,
            last_archived_val: v,
            prev_time: t,
            prev_val: v,
            upper_slope: 1000000.0,
            lower_slope: -1000000.0,
            has_points: true,
            must_archive: false
        };
    }

    let dt = t - (c).last_archived_time;
    if dt <= 0.0 { return *c; }

    let s_upper = (v + (c).compression_deviation - (c).last_archived_val) / dt;
    let s_lower = (v - (c).compression_deviation - (c).last_archived_val) / dt;

    let mut new_u = (c).upper_slope;
    let mut new_l = (c).lower_slope;

    if s_upper < new_u { new_u = s_upper; }
    if s_lower > new_l { new_l = s_lower; }

    // If doors cross, previous point must be archived
    if new_u < new_l {
        return SdtCompressor {
            compression_deviation: (c).compression_deviation,
            last_archived_time: (c).prev_time,
            last_archived_val: (c).prev_val,
            prev_time: t,
            prev_val: v,
            upper_slope: 1000000.0,
            lower_slope: -1000000.0,
            has_points: true,
            must_archive: true
        };
    }

    return SdtCompressor {
        compression_deviation: (c).compression_deviation,
        last_archived_time: (c).last_archived_time,
        last_archived_val: (c).last_archived_val,
        prev_time: t,
        prev_val: v,
        upper_slope: new_u,
        lower_slope: new_l,
        has_points: true,
        must_archive: false
    };
}
