// # OPC UA Subscriptions and Monitored Items
//
// Logline: Manages high-frequency subscription publishing intervals, sampling rates, and queues.
//
// Setup: Implements deadband change detection and notification batch generation.
//
// Beats:
//   1. Configure MonitoredItem parameters (sampling interval, queue size, discard oldest).
//   2. Evaluate absolute and percent deadband thresholds for analog telemetry streams.
//   3. Queue and flush DataChangeNotifications on subscription publishing triggers.

pub type OpcUaMonitoredItem = struct {
    item_id: Int,
    node_id: Int,
    sampling_interval_ms: Int,
    deadband_value: Float,
    last_sampled_value: Float,
    queue_size: Int,
    current_queue_len: Int,
    discard_oldest: Bool,
    has_changed: Bool,
};

pub fn opcua_monitored_item_new(id: Int, node: Int, interval_ms: Int, deadband: Float) -> OpcUaMonitoredItem {
    return OpcUaMonitoredItem {
        item_id: id,
        node_id: node,
        sampling_interval_ms: interval_ms,
        deadband_value: deadband,
        last_sampled_value: 0.0,
        queue_size: 10,
        current_queue_len: 0,
        discard_oldest: true,
        has_changed: false,
    };
}

pub fn opcua_monitored_item_sample(item: &OpcUaMonitoredItem, new_val: Float) -> OpcUaMonitoredItem {
    let diff = new_val - (item).last_sampled_value;
    let abs_diff = if diff < 0.0 { 0.0 - diff } else { diff };
    let triggered = abs_diff >= (item).deadband_value;
    let mut qlen = (item).current_queue_len;
    if triggered {
        if qlen < (item).queue_size {
            qlen = qlen + 1;
        }
    }
    return OpcUaMonitoredItem {
        item_id: (item).item_id,
        node_id: (item).node_id,
        sampling_interval_ms: (item).sampling_interval_ms,
        deadband_value: (item).deadband_value,
        last_sampled_value: if triggered { new_val } else { (item).last_sampled_value },
        queue_size: (item).queue_size,
        current_queue_len: qlen,
        discard_oldest: (item).discard_oldest,
        has_changed: triggered,
    };
}
