// # Modbus TCP MBAP Header and ADU Encapsulation
//
// Logline: Modbus TCP MBAP (Modbus Application Protocol) header encoding, parsing, and framing.
//
// Setup: Serializes transaction IDs, protocol identifiers, length fields, and unit IDs.
//
// Beats:
//   1. Construct MBAP 7-byte header with big-endian byte ordering.
//   2. Encode and decode Modbus TCP ADU packets for Ethernet SCADA communications.
//   3. Validate protocol ID (0 for standard Modbus) and payload length boundaries.

pub type ModbusTcpMbap = struct {
    transaction_id: Int,
    protocol_id: Int,
    length: Int,
    unit_id: Int,
};

pub type ModbusTcpAdu = struct {
    mbap: ModbusTcpMbap,
    function_code: Int,
    data: List[Int],
};

pub fn modbus_tcp_mbap_new(tx_id: Int, unit_id: Int, pdu_len: Int) -> ModbusTcpMbap {
    return ModbusTcpMbap {
        transaction_id: tx_id % 65536,
        protocol_id: 0,
        length: (pdu_len + 1) % 65536,
        unit_id: unit_id % 256,
    };
}

pub fn modbus_tcp_mbap_encode(mbap: &ModbusTcpMbap) -> List[Int] {
    let mut out: List[Int] = list_new();
    let tx = (mbap).transaction_id;
    let proto = (mbap).protocol_id;
    let len = (mbap).length;
    let uid = (mbap).unit_id;

    out = list_push(out, (tx / 256) % 256);
    out = list_push(out, tx % 256);
    out = list_push(out, (proto / 256) % 256);
    out = list_push(out, proto % 256);
    out = list_push(out, (len / 256) % 256);
    out = list_push(out, len % 256);
    out = list_push(out, uid % 256);
    return out;
}

pub fn modbus_tcp_mbap_decode(bytes: &List[Int]) -> Result[ModbusTcpMbap, String] {
    if list_len(*bytes) < 7 {
        return Err("MBAP header requires 7 bytes");
    }
    let tx = (list_get(*bytes, 0) * 256) + list_get(*bytes, 1);
    let proto = (list_get(*bytes, 2) * 256) + list_get(*bytes, 3);
    let len = (list_get(*bytes, 4) * 256) + list_get(*bytes, 5);
    let uid = list_get(*bytes, 6);
    return Ok(ModbusTcpMbap {
        transaction_id: tx,
        protocol_id: proto,
        length: len,
        unit_id: uid,
    });
}
