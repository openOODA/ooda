// # BACnet Standard Object Dictionary and Properties
//
// Logline: Models standard BACnet object types (AI, AO, AV, BI, BO, BV, Device) and property maps.
//
// Setup: Organizes object identifiers (Object Type + Instance Number) and tracks Present_Value properties.
//
// Beats:
//   1. Represent standard Object Types: Analog Input (0), Analog Output (1), Binary Input (3), Binary Output (4).
//   2. Model Object Identifier 32-bit bitfield (10-bit Object Type, 22-bit Instance Number).
//   3. Maintain Status_Flags bitmask (In_Alarm, Fault, Overridden, Out_Of_Service).

pub type BacnetObject = struct {
    object_type: Int, // 0=AI, 1=AO, 2=AV, 3=BI, 4=BO, 5=BV, 8=Device
    instance_number: Int,
    present_value_float: Float,
    present_value_bool: Bool,
    in_alarm: Bool,
    fault: Bool,
    overridden: Bool,
    out_of_service: Bool
};

pub fn bacnet_ai_new(instance: Int, init_val: Float) -> BacnetObject {
    return BacnetObject {
        object_type: 0, // Analog Input
        instance_number: instance % 4194304,
        present_value_float: init_val,
        present_value_bool: false,
        in_alarm: false,
        fault: false,
        overridden: false,
        out_of_service: false
    };
}

pub fn bacnet_bi_new(instance: Int, init_val: Bool) -> BacnetObject {
    return BacnetObject {
        object_type: 3, // Binary Input
        instance_number: instance % 4194304,
        present_value_float: 0.0,
        present_value_bool: init_val,
        in_alarm: false,
        fault: false,
        overridden: false,
        out_of_service: false
    };
}

pub fn bacnet_object_id_encode(obj_type: Int, instance: Int) -> Int {
    return ((obj_type % 1024) * 4194304) + (instance % 4194304);
}
