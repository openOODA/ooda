// # Modbus Gateway Router and Transaction Dispatcher
//
// Logline: Routes Modbus TCP client requests to Modbus RTU serial sub-networks with transaction tracking.
//
// Setup: Bridges Ethernet TCP socket connections to serial RS-485 master/slave loops.
//
// Beats:
//   1. Maintain active transaction table mapping TCP TransactionId to RTU serial port queues.
//   2. Translate MBAP header into RTU frame with CRC-16 calculation.
//   3. Handle slave response timeouts and convert gateway communication errors to Modbus exceptions.

pub type ModbusGatewayRoute = struct {
    unit_id_min: Int,
    unit_id_max: Int,
    serial_port_id: Int,
    baud_rate: Int,
    timeout_ms: Int
};

pub type ModbusGatewayTransaction = struct {
    transaction_id: Int,
    unit_id: Int,
    function_code: Int,
    timestamp_ms: Int,
    is_active: Bool
};

pub fn modbus_gateway_route_new(min_uid: Int, max_uid: Int, port: Int, baud: Int) -> ModbusGatewayRoute {
    return ModbusGatewayRoute {
        unit_id_min: min_uid,
        unit_id_max: max_uid,
        serial_port_id: port,
        baud_rate: baud,
        timeout_ms: 1000
    };
}

pub fn modbus_gateway_matches_route(route: &ModbusGatewayRoute, unit_id: Int) -> Bool {
    return unit_id >= (route).unit_id_min && unit_id <= (route).unit_id_max;
}

pub fn modbus_gateway_tx_new(tx_id: Int, uid: Int, fc: Int, now_ms: Int) -> ModbusGatewayTransaction {
    return ModbusGatewayTransaction {
        transaction_id: tx_id,
        unit_id: uid,
        function_code: fc,
        timestamp_ms: now_ms,
        is_active: true
    };
}
