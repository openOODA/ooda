// # OPC UA Binary Encoder and Decoder Primitives
//
// Logline: Low-level binary serialization primitives for OPC UA Part 6 binary protocol encoding.
//
// Setup: Encodes and decodes integers, floating-point numbers, byte arrays, strings, and GUIDs.
//
// Beats:
//   1. Serialize primitive integers (16-bit, 32-bit, 64-bit) in little-endian format.
//   2. Encode length-prefixed UTF-8 strings and ByteString arrays according to OPC-UA Part 6.
//   3. Provide safe stream cursor decoding with boundary and overflow verification.

type OpcUaEncoder = struct {
    buffer: List[Int],
    length: Int,
};

pub fn opcua_encoder_new() -> OpcUaEncoder {
    return OpcUaEncoder {
        buffer: list_new(),
        length: 0,
    };
}

pub fn opcua_encode_u8(enc: &OpcUaEncoder, val: Int) -> OpcUaEncoder {
    let mut b = (enc).buffer;
    b = list_push(b, val % 256);
    return OpcUaEncoder {
        buffer: b,
        length: (enc).length + 1,
    };
}

pub fn opcua_encode_u16(enc: &OpcUaEncoder, val: Int) -> OpcUaEncoder {
    let mut b = (enc).buffer;
    b = list_push(b, val % 256);
    b = list_push(b, (val / 256) % 256);
    return OpcUaEncoder {
        buffer: b,
        length: (enc).length + 2,
    };
}

pub fn opcua_encode_u32(enc: &OpcUaEncoder, val: Int) -> OpcUaEncoder {
    let mut b = (enc).buffer;
    let b0 = val % 256;
    let b1 = (val / 256) % 256;
    let b2 = (val / 65536) % 256;
    let b3 = (val / 16777216) % 256;
    b = list_push(b, b0);
    b = list_push(b, b1);
    b = list_push(b, b2);
    b = list_push(b, b3);
    return OpcUaEncoder {
        buffer: b,
        length: (enc).length + 4,
    };
}

pub fn opcua_encode_bytestring(enc: &OpcUaEncoder, bytes: &List[Int]) -> OpcUaEncoder {
    let blen = list_len(*bytes);
    let cur = opcua_encode_u32(enc, blen);
    let mut i: Int = 0;
    let mut b = (cur).buffer;
    while i < blen {
        b = list_push(b, list_get(*bytes, i) % 256);
        i = i + 1;
    }
    return OpcUaEncoder {
        buffer: b,
        length: (cur).length + blen,
    };
}

pub fn opcua_decode_u16(bytes: &List[Int], offset: Int) -> Result[Int, String] {
    if offset + 2 > list_len(*bytes) {
        return Err("OPC UA decode u16 out of bounds");
    }
    let b0 = list_get(*bytes, offset);
    let b1 = list_get(*bytes, offset + 1);
    return Ok(b0 + (b1 * 256));
}

pub fn opcua_decode_u32(bytes: &List[Int], offset: Int) -> Result[Int, String] {
    if offset + 4 > list_len(*bytes) {
        return Err("OPC UA decode u32 out of bounds");
    }
    let b0 = list_get(*bytes, offset);
    let b1 = list_get(*bytes, offset + 1);
    let b2 = list_get(*bytes, offset + 2);
    let b3 = list_get(*bytes, offset + 3);
    return Ok(b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216));
}
