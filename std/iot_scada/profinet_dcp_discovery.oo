// # PROFINET Discovery and Configuration Protocol (DCP)
//
// Logline: Implements PROFINET DCP service frames for device discovery, station name, and IP assignment.
//
// Setup: Encodes DCP Identify Requests/Responses and Set Configuration blocks over UDP/Ethernet.
//
// Beats:
//   1. Encode DCP Service ID (1=Get, 2=Set, 3=Identify, 4=Hello) and Service Type (0=Req, 1=RspSuccess).
//   2. Process DCP Option Blocks (Option 1 Device Properties / Station Name, Option 2 IP Parameter).
//   3. Parse station MAC address and response delay timers.

pub type ProfinetDcpHeader = struct {
    service_id: Int,   // 3=Identify
    service_type: Int, // 0=Request, 1=ResponseSuccess
    xid: Int,          // Transaction ID
    response_delay: Int,
    dcp_data_length: Int,
};

pub type ProfinetDcpDevice = struct {
    station_name: String,
    ip_address_int: Int,
    subnet_mask_int: Int,
    gateway_int: Int,
    is_configured: Bool,
};

pub fn profinet_dcp_identify_request(xid: Int) -> ProfinetDcpHeader {
    return ProfinetDcpHeader {
        service_id: 3, // Identify
        service_type: 0, // Request
        xid: xid,
        response_delay: 256,
        dcp_data_length: 4,
    };
}

pub fn profinet_dcp_device_new(name: String) -> ProfinetDcpDevice {
    return ProfinetDcpDevice {
        station_name: name,
        ip_address_int: 0,
        subnet_mask_int: 0,
        gateway_int: 0,
        is_configured: false,
    };
}
