// # PLC Ladder Diagram Rung Evaluation Engine
//
// Logline: Evaluates Ladder Logic (LD) rungs, Normally Open/Closed contacts, coils, and latching relays.
//
// Setup: Executes deterministic left-to-right power flow propagation across ladder network elements.
//
// Beats:
//   1. Model Ladder elements (Normally Open Contact, Normally Closed Contact, Standard Coil, Set/Reset).
//   2. Propagate boolean power flow across series (AND) and parallel (OR) branches.
//   3. Update memory coil states and preserve latched (Set/Reset) output registers.

pub type PlcLadderElement = struct {
    elem_type: Int, // 1=NO_Contact, 2=NC_Contact, 3=Coil, 4=SetCoil, 5=ResetCoil
    bit_address: Int,
    invert_state: Bool,
    input_power: Bool,
    output_power: Bool,
};

pub type PlcLadderRung = struct {
    rung_index: Int,
    power_rail: Bool,
    rung_output: Bool,
    elements_count: Int,
};

pub fn plc_ladder_rung_new(idx: Int) -> PlcLadderRung {
    return PlcLadderRung {
        rung_index: idx,
        power_rail: true,
        rung_output: false,
        elements_count: 0,
    };
}

pub fn plc_eval_contact_no(power_in: Bool, bit_state: Bool) -> Bool {
    return power_in && bit_state;
}

pub fn plc_eval_contact_nc(power_in: Bool, bit_state: Bool) -> Bool {
    return power_in && (!bit_state);
}

pub fn plc_eval_series_and(power_in: Bool, c1: Bool, c2: Bool) -> Bool {
    return power_in && c1 && c2;
}

pub fn plc_eval_parallel_or(power_in: Bool, branch1: Bool, branch2: Bool) -> Bool {
    return power_in && (branch1 || branch2);
}
