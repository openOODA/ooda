// # CANopen NMT Master and Node State Machine
//
// Logline: Issues Network Management (NMT) commands and monitors slave node heartbeat states.
//
// Setup: Manages Start Remote Node, Stop, Enter Pre-Operational, and Reset Node transitions.
//
// Beats:
//   1. Construct NMT Master Command telegrams (COB-ID 0x000, CS + Target Node ID).
//   2. Track slave states: Boot-up (0x00), Stopped (0x04), Operational (0x05), Pre-Operational (0x7F).
//   3. Evaluate Heartbeat consumer guards and trigger alarms on slave communication loss.

pub type CanopenNmtMaster = struct {
    command_specifier: Int, // 1=Start, 2=Stop, 128=PreOp, 129=ResetNode, 130=ResetComm
    target_node_id: Int,    // 0 = All nodes
    slave_node_state: Int,  // 4=Stopped, 5=Operational, 127=PreOperational
    heartbeat_producer_time_ms: Int,
    is_alive: Bool
};

pub fn canopen_nmt_master_new(target_node: Int) -> CanopenNmtMaster {
    return CanopenNmtMaster {
        command_specifier: 1, // Start
        target_node_id: target_node,
        slave_node_state: 127, // PreOp initial
        heartbeat_producer_time_ms: 1000,
        is_alive: true
    };
}

pub fn canopen_nmt_start_node(master: &CanopenNmtMaster) -> CanopenNmtMaster {
    return CanopenNmtMaster {
        command_specifier: 1, // Start Remote Node
        target_node_id: (master).target_node_id,
        slave_node_state: 5,  // Operational
        heartbeat_producer_time_ms: (master).heartbeat_producer_time_ms,
        is_alive: (master).is_alive
    };
}

pub fn canopen_nmt_preop_node(master: &CanopenNmtMaster) -> CanopenNmtMaster {
    return CanopenNmtMaster {
        command_specifier: 128, // Enter Pre-Operational
        target_node_id: (master).target_node_id,
        slave_node_state: 127, // Pre-Operational
        heartbeat_producer_time_ms: (master).heartbeat_producer_time_ms,
        is_alive: (master).is_alive
    };
}
