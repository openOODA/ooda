// # CANopen PDO Mapping and Transmission Controller
//
// Logline: Manages Process Data Object (PDO) dictionary mapping, transmission triggers, and COB-IDs.
//
// Setup: Configures TPDO and RPDO communication parameters, transmission types, and inhibit timers.
//
// Beats:
//   1. Configure PDO COB-IDs (Default TPDO1: 0x180+NodeID, RPDO1: 0x200+NodeID).
//   2. Define PDO Transmission Types (0=Acyclic Sync, 1-240=Cyclic Sync, 254/255=Event Driven).
//   3. Map up to 8 object dictionary entries into an 8-byte CAN frame payload.

pub type CanopenPdoMapping = struct {
    cob_id: Int,
    is_tpdo: Bool,
    transmission_type: Int,
    inhibit_time_ms: Int,
    event_timer_ms: Int,
    mapped_objects_count: Int,
    is_enabled: Bool,
};

pub fn canopen_tpdo1_default(node_id: Int) -> CanopenPdoMapping {
    return CanopenPdoMapping {
        cob_id: 384 + (node_id % 128), // 0x180 + node_id
        is_tpdo: true,
        transmission_type: 255, // Asynchronous / Event-driven
        inhibit_time_ms: 10,
        event_timer_ms: 100,
        mapped_objects_count: 1,
        is_enabled: true,
    };
}

pub fn canopen_rpdo1_default(node_id: Int) -> CanopenPdoMapping {
    return CanopenPdoMapping {
        cob_id: 512 + (node_id % 128), // 0x200 + node_id
        is_tpdo: false,
        transmission_type: 255,
        inhibit_time_ms: 0,
        event_timer_ms: 0,
        mapped_objects_count: 1,
        is_enabled: true,
    };
}
