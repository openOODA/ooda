// # Modbus Standard Function Codes and Exception Responses
//
// Logline: Encodes and evaluates standard Modbus function codes (FC 01-06, 15, 16, 23) and exceptions.
//
// Setup: Validates read/write requests for coils, discrete inputs, holding and input registers.
//
// Beats:
//   1. Define standard Modbus function code constants and validation routines.
//   2. Encode read and write PDU request/response buffers with offset and count parameters.
//   3. Generate standard Modbus exception frames (01 Illegal Function, 02 Illegal Address, 03 Illegal Value).

pub type ModbusPdu = struct {
    function_code: Int,
    start_address: Int,
    quantity: Int,
    byte_count: Int,
    values: List[Int],
    is_exception: Bool,
    exception_code: Int
};

pub fn modbus_fc_read_coils() -> Int { return 1; }
pub fn modbus_fc_read_discrete_inputs() -> Int { return 2; }
pub fn modbus_fc_read_holding_registers() -> Int { return 3; }
pub fn modbus_fc_read_input_registers() -> Int { return 4; }
pub fn modbus_fc_write_single_coil() -> Int { return 5; }
pub fn modbus_fc_write_single_register() -> Int { return 6; }
pub fn modbus_fc_write_multiple_coils() -> Int { return 15; }
pub fn modbus_fc_write_multiple_registers() -> Int { return 16; }

pub fn modbus_pdu_read_request(fc: Int, start_addr: Int, qty: Int) -> ModbusPdu {
    return ModbusPdu {
        function_code: fc,
        start_address: start_addr,
        quantity: qty,
        byte_count: 0,
        values: list_new(),
        is_exception: false,
        exception_code: 0
    };
}

pub fn modbus_pdu_exception_response(fc: Int, exc_code: Int) -> ModbusPdu {
    return ModbusPdu {
        function_code: fc + 128, // Exception bit set (0x80)
        start_address: 0,
        quantity: 0,
        byte_count: 0,
        values: list_new(),
        is_exception: true,
        exception_code: exc_code
    };
}
