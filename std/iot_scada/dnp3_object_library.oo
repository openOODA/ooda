// # DNP3 Standard Object Library (Binary & Analog Points)
//
// Logline: Defines DNP3 Object Groups and Variations for Binary and Analog SCADA telemetry.
//
// Setup: Models Group 1/2 Binary Inputs, Group 10/12 Binary Outputs, Group 30/32 Analog Inputs.
//
// Beats:
//   1. Define Object Group/Variation identifiers (G1V1, G2V1, G30V1, G40V1).
//   2. Encode Binary Input objects with Online, Restart, and Quality flag bitmasks.
//   3. Structure Control Relay Output Block (CROB) with Pulse, Trip, and Close operations.

pub type Dnp3BinaryInput = struct {
    point_index: Int,
    value: Bool,
    online: Bool,
    restart: Bool,
    timestamp_ms: Int
};

pub type Dnp3AnalogInput = struct {
    point_index: Int,
    value: Float,
    online: Bool,
    over_range: Bool,
    reference_check: Bool,
    timestamp_ms: Int
};

pub type Dnp3CrobCommand = struct {
    point_index: Int,
    control_code: Int, // 1=Pulse On, 2=Pulse Off, 3=Latch On, 4=Latch Off
    count: Int,
    on_time_ms: Int,
    off_time_ms: Int,
    status_code: Int // 0=Success, 1=Timeout, 2=No Select
};

pub fn dnp3_binary_input_new(idx: Int, val: Bool, now_ms: Int) -> Dnp3BinaryInput {
    return Dnp3BinaryInput {
        point_index: idx,
        value: val,
        online: true,
        restart: false,
        timestamp_ms: now_ms
    };
}

pub fn dnp3_analog_input_new(idx: Int, val: Float, now_ms: Int) -> Dnp3AnalogInput {
    return Dnp3AnalogInput {
        point_index: idx,
        value: val,
        online: true,
        over_range: false,
        reference_check: true,
        timestamp_ms: now_ms
    };
}

pub fn dnp3_crob_pulse(idx: Int, on_ms: Int, off_ms: Int) -> Dnp3CrobCommand {
    return Dnp3CrobCommand {
        point_index: idx,
        control_code: 1, // Pulse On
        count: 1,
        on_time_ms: on_ms,
        off_time_ms: off_ms,
        status_code: 0
    };
}
