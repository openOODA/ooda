// # OTP Actor Supervision Strategy Module
//
// Logline: Defines OneForOne, OneForAll, RestForOne restart strategies, restart intensity, and child restart modes.
//
// Setup: Pure strategy definitions and rate-limiting history tracking for actor supervision trees.
//
// Beats:
//   1. Define restart strategy types (OneForOne, OneForAll, RestForOne) and intensity bounds.
//   2. Define child restart modes (Permanent, Transient, Temporary).
//   3. Track sliding-window restart timestamps to prevent infinite restart loops.
//   4. Determine recovery policy based on child exit status.
// RULES.oot 1.7: Under 256 lines.

pub type RestartStrategy = struct {
    strategy_type: Int,
    max_restarts: Int,
    max_seconds: Int
};

pub type ChildSpec = struct {
    id: String,
    restart_mode: Int,
    shutdown_timeout_ms: Int,
    is_supervisor: Bool,
    order_index: Int
};

pub type RestartHistory = struct {
    timestamps: List[Int],
    count: Int
};

pub fn strategy_one_for_one(max_restarts: Int, max_seconds: Int) -> RestartStrategy {
    let mut mr: Int = max_restarts;
    let mut ms: Int = max_seconds;
    if mr < 1 { mr = 3; }
    if ms < 1 { ms = 5; }
    return RestartStrategy {
        strategy_type: 0,
        max_restarts: mr,
        max_seconds: ms
    };
}

pub fn strategy_one_for_all(max_restarts: Int, max_seconds: Int) -> RestartStrategy {
    let mut mr: Int = max_restarts;
    let mut ms: Int = max_seconds;
    if mr < 1 { mr = 3; }
    if ms < 1 { ms = 5; }
    return RestartStrategy {
        strategy_type: 1,
        max_restarts: mr,
        max_seconds: ms
    };
}

pub fn strategy_rest_for_one(max_restarts: Int, max_seconds: Int) -> RestartStrategy {
    let mut mr: Int = max_restarts;
    let mut ms: Int = max_seconds;
    if mr < 1 { mr = 3; }
    if ms < 1 { ms = 5; }
    return RestartStrategy {
        strategy_type: 2,
        max_restarts: mr,
        max_seconds: ms
    };
}

pub fn child_spec_new(
    id: String,
    mode: Int,
    timeout_ms: Int,
    is_sup: Bool,
    order: Int
) -> ChildSpec {
    let mut to: Int = timeout_ms;
    if to < 1 { to = 5000; }
    return ChildSpec {
        id: id,
        restart_mode: mode,
        shutdown_timeout_ms: to,
        is_supervisor: is_sup,
        order_index: order
    };
}

pub fn strategy_should_restart(spec: ChildSpec, exit_reason: String) -> Bool {
    let mode: Int = spec.restart_mode;
    if mode == 0 {
        return true;
    }
    if mode == 1 {
        if exit_reason != "normal" && exit_reason != "shutdown" {
            return true;
        }
        return false;
    }
    return false;
}

pub fn restart_history_new() -> RestartHistory {
    let empty: List[Int] = list_new();
    return RestartHistory {
        timestamps: empty,
        count: 0
    };
}

pub fn restart_history_record(hist: RestartHistory, ts: Int) -> RestartHistory {
    let new_ts: List[Int] = list_push(hist.timestamps, ts);
    let next_c: Int = hist.count + 1;
    return RestartHistory {
        timestamps: new_ts,
        count: next_c
    };
}

pub fn restart_history_check_intensity(
    hist: RestartHistory,
    max_r: Int,
    window_sec: Int,
    now: Int
) -> Bool {
    let mut recent_count: Int = 0;
    let n: Int = hist.count;
    let mut i: Int = 0;
    let cutoff: Int = now - window_sec;
    while i < n {
        let t: Int = list_get(hist.timestamps, i);
        if t >= cutoff {
            recent_count = recent_count + 1;
        }
        i = i + 1;
    }
    return recent_count <= max_r;
}
