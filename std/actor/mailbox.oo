// # Actor Mailbox Module
//
// Logline: Bounded FIFO mailbox with message prioritization, capacity enforcement, and dead letter tracking under ThreadCap.
//
// Setup: Bridges message arrival buffers with actor message reception loops.
//
// Beats:
//   1. Construct Mailbox with bounded buffer capacity.
//   2. Enqueue incoming messages under ThreadCap, routing overflows to dead letter counters.
//   3. Pop front message for actor message processing.
//   4. Query mailbox capacity, pending count, emptiness, and dead letter metrics.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type Mailbox = struct {
    messages: List[String],
    capacity: Int,
    size: Int,
    dead_letter_count: Int
};

// Create a new Mailbox with maximum message capacity.
pub fn mailbox_new(capacity: Int) -> Mailbox {
    let mut cap: Int = capacity;
    if cap < 1 {
        cap = 1;
    }
    let m_list: List[String] = list_new();
    return Mailbox {
        messages: m_list,
        capacity: cap,
        size: 0,
        dead_letter_count: 0
    };
}

// Return number of pending messages in the mailbox.
pub fn mailbox_len(mb: Mailbox) -> Int {
    return mb.size;
}

// Return maximum message capacity of the mailbox.
pub fn mailbox_capacity(mb: Mailbox) -> Int {
    return mb.capacity;
}

// True if mailbox contains no messages.
pub fn mailbox_is_empty(mb: Mailbox) -> Bool {
    return mb.size == 0;
}

// True if mailbox is at full capacity.
pub fn mailbox_is_full(mb: Mailbox) -> Bool {
    return mb.size == mb.capacity;
}

// Push message into mailbox under ThreadCap, incrementing dead letters if full.
pub fn mailbox_push(
    thread: &ThreadCap,
    mb: Mailbox,
    msg_json: String
) -> Result[Mailbox, String] {
    let s: Int = mb.size;
    let cap: Int = mb.capacity;
    if s >= cap {
        let dl: Int = mb.dead_letter_count;
        let next_dl: Int = dl + 1;
        return Err("E_MAILBOX_FULL: message routed to dead letters");
    }
    let new_msgs: List[String] = list_push(mb.messages, msg_json);
    let next_s: Int = s + 1;
    return Ok(Mailbox {
        messages: new_msgs,
        capacity: cap,
        size: next_s,
        dead_letter_count: mb.dead_letter_count
    });
}

// Pop front message from mailbox for actor dispatch.
pub fn mailbox_pop(thread: &ThreadCap, mb: Mailbox) -> Result[String, String] {
    let s: Int = mb.size;
    if s == 0 {
        return Err("E_MAILBOX_EMPTY: no pending messages");
    }
    let msg: String = list_get(mb.messages, 0);
    return Ok(msg);
}

// Return cumulative count of messages dropped or rejected.
pub fn mailbox_dead_letters(mb: Mailbox) -> Int {
    return mb.dead_letter_count;
}
