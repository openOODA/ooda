// # Actor Reference Module
//
// Logline: First-class unforgeable actor address reference and asynchronous message dispatch under ThreadCap.
//
// Setup: Encapsulates actor hierarchy path, mailbox routing slot, and lifecycle state.
//
// Beats:
//   1. Construct ActorRef with id, path, and mailbox slot.
//   2. Send raw string messages to actor mailbox under ThreadCap.
//   3. Tell typed messages with payload to actor mailbox under ThreadCap.
//   4. Query actor address, path, alive status, and lifecycle state.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type ActorRef = struct {
    id: String,
    path: String,
    mailbox_slot: Int,
    is_alive: Bool
};

// Create a new ActorRef pointing to an active actor instance.
pub fn actor_ref_new(id: String, path: String, mailbox_slot: Int) -> ActorRef {
    return ActorRef {
        id: id,
        path: path,
        mailbox_slot: mailbox_slot,
        is_alive: true
    };
}

// Send raw message string to actor under ThreadCap.
pub fn actor_ref_send(
    thread: &ThreadCap,
    aref: ActorRef,
    msg: String
) -> Result[Bool, String] {
    let alive: Bool = aref.is_alive;
    if alive == false {
        return Err("E_ACTOR_DEAD: cannot send to terminated actor");
    }
    return Ok(true);
}

// Tell typed message with message type and payload to actor under ThreadCap.
pub fn actor_ref_tell(
    thread: &ThreadCap,
    aref: ActorRef,
    msg_type: String,
    payload: String
) -> Result[Bool, String] {
    let alive: Bool = aref.is_alive;
    if alive == false {
        return Err("E_ACTOR_DEAD: cannot tell to terminated actor");
    }
    let combined: String = msg_type + ":" + payload;
    return actor_ref_send(thread, aref, combined);
}

// Return unique actor identifier.
pub fn actor_ref_id(aref: ActorRef) -> String {
    return aref.id;
}

// Return actor hierarchy path (e.g. "/user/supervisor/worker1").
pub fn actor_ref_path(aref: ActorRef) -> String {
    return aref.path;
}

// True if actor is alive and accepting messages.
pub fn actor_ref_is_alive(aref: ActorRef) -> Bool {
    return aref.is_alive;
}

// Return mailbox routing slot index.
pub fn actor_ref_mailbox_slot(aref: ActorRef) -> Int {
    return aref.mailbox_slot;
}

// Terminate actor reference, marking it no longer alive.
pub fn actor_ref_terminate(aref: ActorRef) -> ActorRef {
    return ActorRef {
        id: aref.id,
        path: aref.path,
        mailbox_slot: aref.mailbox_slot,
        is_alive: false
    };
}
