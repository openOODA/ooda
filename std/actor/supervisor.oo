// # Actor Supervisor Tree Module
//
// Logline: OTP-style fault-tolerant actor supervision tree, restart policies, and failure escalation under ThreadCap.
//
// Setup: Coordinates child actor monitoring, health state tracking, and failure recovery strategies.
//
// Beats:
//   1. Construct Supervisor with strategy (OneForOne, OneForAll, RestForOne) and max failure threshold.
//   2. Register supervised child actors in supervision hierarchy.
//   3. Handle child failure events under ThreadCap, evaluating restart quotas.
//   4. Restart supervised children or escalate failures.
// RULES.oot 1.4: Default-deny for concurrency. Explicit &ThreadCap required.
// RULES.oot 1.7: Under 256 lines.

import "std/result.oo";

type Supervisor = struct {
    name: String,
    strategy: String,
    children: List[String],
    child_count: Int,
    failures: Int,
    max_failures: Int
};

// Create a new Supervisor with specified recovery strategy and failure limit.
pub fn supervisor_new(name: String, strategy: String, max_failures: Int) -> Supervisor {
    let mut mf: Int = max_failures;
    if mf < 1 {
        mf = 3;
    }
    let c_list: List[String] = list_new();
    return Supervisor {
        name: name,
        strategy: strategy,
        children: c_list,
        child_count: 0,
        failures: 0,
        max_failures: mf
    };
}

// Add child actor ID to the supervised set.
pub fn supervisor_add_child(sup: Supervisor, child_id: String) -> Supervisor {
    let new_children: List[String] = list_push(sup.children, child_id);
    let cc: Int = sup.child_count;
    let next_cc: Int = cc + 1;
    return Supervisor {
        name: sup.name,
        strategy: sup.strategy,
        children: new_children,
        child_count: next_cc,
        failures: sup.failures,
        max_failures: sup.max_failures
    };
}

// Handle child failure under ThreadCap, incrementing failure counter or escalating.
pub fn supervisor_handle_failure(
    thread: &ThreadCap,
    sup: Supervisor,
    child_id: String
) -> Result[Supervisor, String] {
    let f: Int = sup.failures;
    let max_f: Int = sup.max_failures;
    let next_f: Int = f + 1;
    let s_name: String = sup.name;
    if next_f > max_f {
        return Err("E_SUPERVISOR_ESCALATE: max restart limit reached for supervisor " + s_name);
    }
    return Ok(Supervisor {
        name: sup.name,
        strategy: sup.strategy,
        children: sup.children,
        child_count: sup.child_count,
        failures: next_f,
        max_failures: max_f
    });
}

// Return number of supervised children.
pub fn supervisor_child_count(sup: Supervisor) -> Int {
    return sup.child_count;
}

// Return count of recorded child failures.
pub fn supervisor_failure_count(sup: Supervisor) -> Int {
    return sup.failures;
}

// True if supervisor failure count is below max limit.
pub fn supervisor_is_healthy(sup: Supervisor) -> Bool {
    let f: Int = sup.failures;
    let max_f: Int = sup.max_failures;
    return f <= max_f;
}

// Reset failure count after successful recovery under ThreadCap.
pub fn supervisor_restart_all(thread: &ThreadCap, sup: Supervisor) -> Supervisor {
    return Supervisor {
        name: sup.name,
        strategy: sup.strategy,
        children: sup.children,
        child_count: sup.child_count,
        failures: 0,
        max_failures: sup.max_failures
    };
}
