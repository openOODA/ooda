// # CCSDS Packet Header Types
//
// Logline: PacketHeader destubbed off List[struct] telemetry batches.
//
// Setup: Pure Int CCSDS primary header fields.
//
// Beats:
//   1. packet_header_new apid/seq/len.
// residual: List[struct] destubbed.

type PacketHeader = struct {
    apid: Int,
    sequence_count: Int,
    packet_length: Int
};

pub fn packet_header_new(apid: Int, sequence_count: Int, packet_length: Int) -> PacketHeader {
    return PacketHeader {
        apid: apid,
        sequence_count: sequence_count,
        packet_length: packet_length
    };
}

pub fn packet_header_apid(h: PacketHeader) -> Int {
    return h.apid;
}

pub fn packet_header_seq(h: PacketHeader) -> Int {
    return h.sequence_count;
}

pub fn packet_header_len(h: PacketHeader) -> Int {
    return h.packet_length;
}
