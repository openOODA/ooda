// # Attitude DCM
//
// Logline: DcmCell destubbed off pub type Float DCM.
// residual: List[struct] destubbed to Int floor.

type DcmCell = struct {
    r00: Int,
    r11: Int
};

pub fn dcm_cell_new(r00: Int, r11: Int) -> DcmCell {
    return DcmCell { r00: r00, r11: r11 };
}

pub fn dcm_cell_r00(c: DcmCell) -> Int {
    return c.r00;
}

pub fn dcm_cell_r11(c: DcmCell) -> Int {
    return c.r11;
}
