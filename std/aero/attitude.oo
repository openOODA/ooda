import "./attitude_types.oo";

pub fn attitude_vec3_new(x: Int, y: Int, z: Int) -> AttVec3 {
    return att_vec3_new(x, y, z);
}

pub fn attitude_vec3_x(v: AttVec3) -> Int {
    return att_vec3_x(v);
}

pub fn attitude_vec3_y(v: AttVec3) -> Int {
    return att_vec3_y(v);
}

pub fn attitude_vec3_z(v: AttVec3) -> Int {
    return att_vec3_z(v);
}
