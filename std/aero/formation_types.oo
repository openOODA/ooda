// # Formation types
//
// Logline: Defines RelativeState, Vec3, ChiefOrbitParams, FormationGeometry, and ROE.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//

type Vec3 = struct {
    x: Float,
    y: Float,
    z: Float
};

type RelativeState = struct {
    position: Vec3,
    velocity: Vec3,
    epoch_sec: Float
};

type ChiefOrbitParams = struct {
    semi_major_axis: Float,
    eccentricity: Float,
    mean_motion: Float,
    mu: Float
};

type HillClohessyWiltshire = struct {
    chief_mean_motion: Float,
    chief_radius: Float,
    drift_rate_y: Float
};

type FormationGeometry = struct {
    geometry_type: Int,
    semi_major_axis_rel: Float,
    in_track_offset: Float,
    cross_track_amplitude: Float,
    phase_angle: Float,
    radial_offset: Float
};

type RelativeKeplerianElements = struct {
    delta_a: Float,
    delta_ex: Float,
    delta_ey: Float,
    delta_ix: Float,
    delta_iy: Float,
    delta_lambda: Float
};

type FormationManeuver = struct {
    delta_v_chief: Vec3,
    delta_v_deputy: Vec3,
    total_delta_v: Float,
    maneuver_time_sec: Float
};

type FormationSafety = struct {
    min_approach_distance: Float,
    collision_warning: Bool,
    keep_out_sphere_radius: Float,
    is_pass_safe: Bool
};

type FormationControlState = struct {
    target_state: RelativeState,
    current_state: RelativeState,
    position_error: Vec3,
    velocity_error: Vec3,
    total_pos_error_mag: Float,
    total_vel_error_mag: Float
};

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

pub fn vec3_zero() -> Vec3 {
    return Vec3 { x: 0.0, y: 0.0, z: 0.0 };
}

pub fn vec3_add(a: Vec3, b: Vec3) -> Vec3 {
    let rx: Float = a.x + b.x;
    let ry: Float = a.y + b.y;
    let rz: Float = a.z + b.z;
    return Vec3 { x: rx, y: ry, z: rz };
}

pub fn vec3_sub(a: Vec3, b: Vec3) -> Vec3 {
    let rx: Float = a.x - b.x;
    let ry: Float = a.y - b.y;
    let rz: Float = a.z - b.z;
    return Vec3 { x: rx, y: ry, z: rz };
}

pub fn vec3_scale(v: Vec3, s: Float) -> Vec3 {
    let rx: Float = v.x * s;
    let ry: Float = v.y * s;
    let rz: Float = v.z * s;
    return Vec3 { x: rx, y: ry, z: rz };
}

pub fn vec3_length_sq(v: Vec3) -> Float {
    let vx: Float = v.x;
    let vy: Float = v.y;
    let vz: Float = v.z;
    return ((vx * vx) + (vy * vy)) + (vz * vz);
}

pub fn vec3_length(v: Vec3) -> Float {
    return sqrt(vec3_length_sq(v));
}

pub fn vec3_cross(a: Vec3, b: Vec3) -> Vec3 {
    let ax: Float = a.x;
    let ay: Float = a.y;
    let az: Float = a.z;
    let bx: Float = b.x;
    let by: Float = b.y;
    let bz: Float = b.z;
    let cx: Float = (ay * bz) - (az * by);
    let cy: Float = (az * bx) - (ax * bz);
    let cz: Float = (ax * by) - (ay * bx);
    return Vec3 { x: cx, y: cy, z: cz };
}

pub fn vec3_dot(a: Vec3, b: Vec3) -> Float {
    let ax: Float = a.x;
    let ay: Float = a.y;
    let az: Float = a.z;
    let bx: Float = b.x;
    let by: Float = b.y;
    let bz: Float = b.z;
    return ((ax * bx) + (ay * by)) + (az * bz);
}

pub fn vec3_neg(v: Vec3) -> Vec3 {
    let vx: Float = v.x;
    let vy: Float = v.y;
    let vz: Float = v.z;
    return Vec3 { x: 0.0 - vx, y: 0.0 - vy, z: 0.0 - vz };
}

type FormVec3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn form_vec3_new(x: Int, y: Int, z: Int) -> FormVec3 {
    return FormVec3 { x: x, y: y, z: z };
}

pub fn form_vec3_x(v: FormVec3) -> Int {
    return v.x;
}

pub fn form_vec3_y(v: FormVec3) -> Int {
    return v.y;
}

pub fn form_vec3_z(v: FormVec3) -> Int {
    return v.z;
}
