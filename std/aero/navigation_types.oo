type NavVec3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn nav_vec3_new(x: Int, y: Int, z: Int) -> NavVec3 {
    return NavVec3 { x: x, y: y, z: z };
}

pub fn nav_vec3_x(v: NavVec3) -> Int {
    return v.x;
}

pub fn nav_vec3_y(v: NavVec3) -> Int {
    return v.y;
}

pub fn nav_vec3_z(v: NavVec3) -> Int {
    return v.z;
}
