// # Thrust, Specific Impulse & Staging Operations
//
// Logline: Sea-level/vacuum thrust, Isp, mass flow, and Tsiolkovsky delta-v. Destubbed off &mut.
//
// Setup: By-value RocketEngine burn state. No type import.
//
// Beats:
//   1. Convert Isp to exhaust velocity via g0 = 9.80665.
//   2. Ambient thrust = vacuum thrust - Pa * Ae when ignited.
//   3. Tsiolkovsky dv = ve * ln(m0/mf).

type RocketEngine = struct {
    thrust_vacuum: Float,
    exit_area: Float,
    is_ignited: Bool
};

type ThrustMetrics = struct {
    thrust_n: Float,
    effective_exhaust_velocity: Float,
    characteristic_velocity: Float,
    thrust_coefficient: Float,
    twr: Float
};

pub fn standard_gravity() -> Float {
    return 9.80665;
}

pub fn isp_to_exhaust_velocity(isp_sec: Float) -> Float {
    return isp_sec * standard_gravity();
}

pub fn exhaust_velocity_to_isp(ve: Float) -> Float {
    let g0: Float = standard_gravity();
    if g0 <= 0.0 {
        return 0.0;
    }
    return ve / g0;
}

pub fn calculate_effective_isp(thrust_n: Float, mdot_total: Float) -> Float {
    let g0: Float = standard_gravity();
    let denom: Float = mdot_total * g0;
    if denom <= 0.0 {
        return 0.0;
    }
    return thrust_n / denom;
}

pub fn calculate_mass_flow_from_thrust(thrust_n: Float, isp_sec: Float) -> Float {
    let g0: Float = standard_gravity();
    let denom: Float = isp_sec * g0;
    if denom <= 0.0 {
        return 0.0;
    }
    return thrust_n / denom;
}

pub fn calculate_vacuum_thrust(mdot: Float, ve: Float, exit_area: Float, exit_pressure: Float) -> Float {
    let momentum_thrust: Float = mdot * ve;
    let pressure_thrust: Float = exit_pressure * exit_area;
    return momentum_thrust + pressure_thrust;
}

pub fn calculate_ambient_thrust(thrust_vac: Float, exit_area: Float, ambient_pressure: Float) -> Float {
    let back_pressure_loss: Float = ambient_pressure * exit_area;
    if back_pressure_loss > thrust_vac {
        return 0.0;
    }
    return thrust_vac - back_pressure_loss;
}

pub fn calculate_thrust_coefficient(thrust_n: Float, chamber_pressure: Float, throat_area: Float) -> Float {
    let denom: Float = chamber_pressure * throat_area;
    if denom <= 0.0 {
        return 0.0;
    }
    return thrust_n / denom;
}

pub fn calculate_characteristic_velocity(chamber_pressure: Float, throat_area: Float, mdot: Float) -> Float {
    if mdot <= 0.0 {
        return 0.0;
    }
    return (chamber_pressure * throat_area) / mdot;
}

pub fn calculate_thrust_to_weight(thrust_n: Float, wet_mass_kg: Float) -> Float {
    let g0: Float = standard_gravity();
    let weight: Float = wet_mass_kg * g0;
    if weight <= 0.0 {
        return 0.0;
    }
    return thrust_n / weight;
}

pub fn calculate_total_impulse(thrust_n: Float, burn_time_sec: Float) -> Float {
    if thrust_n < 0.0 {
        return 0.0;
    }
    if burn_time_sec < 0.0 {
        return 0.0;
    }
    return thrust_n * burn_time_sec;
}

pub fn rocket_engine_make(thrust_vacuum: Float, exit_area: Float) -> RocketEngine {
    return RocketEngine {
        thrust_vacuum: thrust_vacuum,
        exit_area: exit_area,
        is_ignited: false
    };
}

pub fn rocket_engine_set_ignition(obj: RocketEngine, ignited: Bool) -> RocketEngine {
    return RocketEngine {
        thrust_vacuum: obj.thrust_vacuum,
        exit_area: obj.exit_area,
        is_ignited: ignited
    };
}

pub fn rocket_engine_current_thrust(eng: RocketEngine, ambient_pressure: Float) -> Float {
    let is_active: Bool = eng.is_ignited;
    if is_active == false {
        return 0.0;
    }
    return calculate_ambient_thrust(eng.thrust_vacuum, eng.exit_area, ambient_pressure);
}

pub fn calculate_thrust_metrics(
    thrust_n: Float,
    mdot_total: Float,
    chamber_pressure: Float,
    throat_area: Float,
    wet_mass_kg: Float
) -> ThrustMetrics {
    let ve: Float = calculate_effective_isp(thrust_n, mdot_total) * standard_gravity();
    let c_star: Float = calculate_characteristic_velocity(chamber_pressure, throat_area, mdot_total);
    let cf: Float = calculate_thrust_coefficient(thrust_n, chamber_pressure, throat_area);
    let twr_val: Float = calculate_thrust_to_weight(thrust_n, wet_mass_kg);
    return ThrustMetrics {
        thrust_n: thrust_n,
        effective_exhaust_velocity: ve,
        characteristic_velocity: c_star,
        thrust_coefficient: cf,
        twr: twr_val
    };
}

pub fn tsiolkovsky_delta_v(isp_sec: Float, m0: Float, mf: Float) -> Float {
    if mf <= 0.0 {
        return 0.0;
    }
    let ratio: Float = m0 / mf;
    if ratio <= 1.0 {
        return 0.0;
    }
    let ve: Float = isp_to_exhaust_velocity(isp_sec);
    return ve * ln(ratio);
}

pub fn tsiolkovsky_final_mass(isp_sec: Float, m0: Float, delta_v: Float) -> Float {
    let ve: Float = isp_to_exhaust_velocity(isp_sec);
    if ve <= 0.0 {
        return 0.0;
    }
    let exponent: Float = 0.0 - (delta_v / ve);
    return m0 * exp(exponent);
}

pub fn tsiolkovsky_propellant_mass(isp_sec: Float, dry_mass: Float, payload_mass: Float, delta_v: Float) -> Float {
    let ve: Float = isp_to_exhaust_velocity(isp_sec);
    if ve <= 0.0 {
        return 0.0;
    }
    let m_final: Float = dry_mass + payload_mass;
    if m_final <= 0.0 {
        return 0.0;
    }
    let ratio: Float = exp(delta_v / ve);
    let m_initial: Float = m_final * ratio;
    return m_initial - m_final;
}

pub fn calculate_burn_duration(propellant_mass: Float, mdot: Float) -> Float {
    if mdot <= 0.0 {
        return 0.0;
    }
    if propellant_mass <= 0.0 {
        return 0.0;
    }
    return propellant_mass / mdot;
}

pub fn calculate_mass_ratio(m0: Float, mf: Float) -> Float {
    if mf <= 0.0 {
        return 0.0;
    }
    return m0 / mf;
}

pub fn calculate_payload_fraction(payload_mass: Float, initial_mass: Float) -> Float {
    if initial_mass <= 0.0 {
        return 0.0;
    }
    return payload_mass / initial_mass;
}

pub fn calculate_two_stage_delta_v(
    isp1: Float,
    m0_1: Float,
    mf_1: Float,
    isp2: Float,
    m0_2: Float,
    mf_2: Float
) -> Float {
    let dv1: Float = tsiolkovsky_delta_v(isp1, m0_1, mf_1);
    let dv2: Float = tsiolkovsky_delta_v(isp2, m0_2, mf_2);
    return dv1 + dv2;
}
