// # Navigation EKF
//
// Logline: NavEkf destubbed off pub type Float INS/GNSS.
// residual: List[struct] destubbed to Int floor.

type NavEkf = struct {
    px: Int,
    vx: Int
};

pub fn nav_ekf_new(px: Int, vx: Int) -> NavEkf {
    return NavEkf { px: px, vx: vx };
}

pub fn nav_ekf_px(e: NavEkf) -> Int {
    return e.px;
}

pub fn nav_ekf_vx(e: NavEkf) -> Int {
    return e.vx;
}
