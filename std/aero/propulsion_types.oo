// # Propulsion types
//
// Logline: RocketEngine destubbed off nested Float SpecificImpulse.
// residual: List[struct] destubbed to Int floor.

type RocketEngine = struct {
    engine_id: Int,
    thrust_n: Int,
    dry_mass_kg: Int
};

pub fn rocket_engine_new(engine_id: Int, thrust_n: Int, dry_mass_kg: Int) -> RocketEngine {
    return RocketEngine {
        engine_id: engine_id,
        thrust_n: thrust_n,
        dry_mass_kg: dry_mass_kg
    };
}

pub fn rocket_engine_id(e: RocketEngine) -> Int {
    return e.engine_id;
}

pub fn rocket_engine_thrust(e: RocketEngine) -> Int {
    return e.thrust_n;
}

pub fn rocket_engine_dry_mass(e: RocketEngine) -> Int {
    return e.dry_mass_kg;
}
