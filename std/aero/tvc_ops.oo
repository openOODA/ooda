// # TVC Kinematics & Deflection Operations
//
// Logline: Computes gimbal deflection magnitudes, angle limits clamping, and torque vector projections.
//
// Setup: TVC operational kinematics importing tvc_types.oo.
//
// Beats:
//   1. Implement gimbal angle arithmetic, vector addition, and scaling.
//   2. Enforce actuator hardstop deflection bounds and rate limits.
//   3. Compute geometric torque arms and thrust vector directional cosines.

import "./tvc_types.oo";

// -------------------------------------------------------------------
// 1. Gimbal Angle Functions
// -------------------------------------------------------------------

pub fn gimbal_angle_new(pitch: Float, yaw: Float, roll: Float) -> GimbalAngle {
    return GimbalAngle {
        pitch: pitch,
        yaw: yaw,
        roll: roll,
        valid: true,
    };
}

pub fn gimbal_angle_zero() -> GimbalAngle {
    return GimbalAngle {
        pitch: 0.0,
        yaw: 0.0,
        roll: 0.0,
        valid: true,
    };
}

pub fn gimbal_angle_magnitude(angle: GimbalAngle) -> Float {
    let p: Float = (angle).pitch;
    let y: Float = (angle).yaw;
    let r: Float = (angle).roll;
    return sqrt((p * p) + (y * y) + (r * r));
}

pub fn gimbal_angle_add(a: GimbalAngle, b: GimbalAngle) -> GimbalAngle {
    let is_valid: Bool = (a).valid && (b).valid;
    return GimbalAngle {
        pitch: (a).pitch + (b).pitch,
        yaw: (a).yaw + (b).yaw,
        roll: (a).roll + (b).roll,
        valid: is_valid,
    };
}

pub fn gimbal_angle_sub(a: GimbalAngle, b: GimbalAngle) -> GimbalAngle {
    let is_valid: Bool = (a).valid && (b).valid;
    return GimbalAngle {
        pitch: (a).pitch - (b).pitch,
        yaw: (a).yaw - (b).yaw,
        roll: (a).roll - (b).roll,
        valid: is_valid,
    };
}

pub fn gimbal_angle_scale(a: GimbalAngle, scale: Float) -> GimbalAngle {
    return GimbalAngle {
        pitch: (a).pitch * scale,
        yaw: (a).yaw * scale,
        roll: (a).roll * scale,
        valid: (a).valid,
    };
}

// -------------------------------------------------------------------
// 2. Actuator Command Functions
// -------------------------------------------------------------------

pub fn actuator_command_new(stroke_p: Float, stroke_y: Float, duty_p: Float, duty_y: Float, enabled: Bool) -> ActuatorCommand {
    let clamped_dp: Float = tvc_clamp(duty_p, 0.0 - 1.0, 1.0);
    let clamped_dy: Float = tvc_clamp(duty_y, 0.0 - 1.0, 1.0);
    return ActuatorCommand {
        actuator_pitch_stroke_mm: stroke_p,
        actuator_yaw_stroke_mm: stroke_y,
        duty_cycle_pitch: clamped_dp,
        duty_cycle_yaw: clamped_dy,
        enabled: enabled,
    };
}

pub fn actuator_command_zero() -> ActuatorCommand {
    return ActuatorCommand {
        actuator_pitch_stroke_mm: 0.0,
        actuator_yaw_stroke_mm: 0.0,
        duty_cycle_pitch: 0.0,
        duty_cycle_yaw: 0.0,
        enabled: false,
    };
}

pub fn actuator_command_clamp(cmd: ActuatorCommand, max_stroke_mm: Float) -> ActuatorCommand {
    let neg_max: Float = 0.0 - max_stroke_mm;
    let clamped_sp: Float = tvc_clamp((cmd).actuator_pitch_stroke_mm, neg_max, max_stroke_mm);
    let clamped_sy: Float = tvc_clamp((cmd).actuator_yaw_stroke_mm, neg_max, max_stroke_mm);
    return ActuatorCommand {
        actuator_pitch_stroke_mm: clamped_sp,
        actuator_yaw_stroke_mm: clamped_sy,
        duty_cycle_pitch: (cmd).duty_cycle_pitch,
        duty_cycle_yaw: (cmd).duty_cycle_yaw,
        enabled: (cmd).enabled,
    };
}

// -------------------------------------------------------------------
// 3. Allocation, Torque, ThrustVector, Limits, State constructors
// -------------------------------------------------------------------

pub fn tvc_allocation_new(thrust: Float, arm: Float, max_p: Float, max_y: Float, lever: Float, slew: Float, g_p: Float, g_y: Float, g_r: Float) -> TvcAllocation {
    return TvcAllocation {
        thrust_n: thrust,
        moment_arm_m: arm,
        max_gimbal_pitch_rad: max_p,
        max_gimbal_yaw_rad: max_y,
        actuator_lever_arm_m: lever,
        max_slew_rate_rad_s: slew,
        pitch_gain: g_p,
        yaw_gain: g_y,
        roll_gain: g_r,
    };
}

pub fn tvc_allocation_default() -> TvcAllocation {
    return TvcAllocation {
        thrust_n: 1000.0,
        moment_arm_m: 2.0,
        max_gimbal_pitch_rad: tvc_deg_to_rad(7.0),
        max_gimbal_yaw_rad: tvc_deg_to_rad(7.0),
        actuator_lever_arm_m: 0.15,
        max_slew_rate_rad_s: tvc_deg_to_rad(20.0),
        pitch_gain: 1.0,
        yaw_gain: 1.0,
        roll_gain: 1.0,
    };
}

pub fn control_torque_new(p_nm: Float, y_nm: Float, r_nm: Float) -> ControlTorque {
    return ControlTorque {
        pitch_moment_nm: p_nm,
        yaw_moment_nm: y_nm,
        roll_moment_nm: r_nm,
    };
}

pub fn control_torque_zero() -> ControlTorque {
    return ControlTorque {
        pitch_moment_nm: 0.0,
        yaw_moment_nm: 0.0,
        roll_moment_nm: 0.0,
    };
}

pub fn thrust_vector_new(fx: Float, fy: Float, fz: Float) -> ThrustVector {
    return ThrustVector { fx: fx, fy: fy, fz: fz };
}

pub fn tvc_limits_new(min_p: Float, max_p: Float, min_y: Float, max_y: Float, slew: Float, max_stroke: Float) -> TvcLimits {
    return TvcLimits {
        min_pitch_rad: min_p,
        max_pitch_rad: max_p,
        min_yaw_rad: min_y,
        max_yaw_rad: max_y,
        max_slew_rate_rad_s: slew,
        max_actuator_stroke_mm: max_stroke,
    };
}

pub fn tvc_limits_default() -> TvcLimits {
    let default_max: Float = tvc_deg_to_rad(7.0);
    let default_min: Float = 0.0 - default_max;
    return TvcLimits {
        min_pitch_rad: default_min,
        max_pitch_rad: default_max,
        min_yaw_rad: default_min,
        max_yaw_rad: default_max,
        max_slew_rate_rad_s: tvc_deg_to_rad(20.0),
        max_actuator_stroke_mm: 50.0,
    };
}

pub fn tvc_state_init(alloc: TvcAllocation, limits: TvcLimits) -> TvcState {
    return TvcState {
        current_angle: gimbal_angle_zero(),
        target_angle: gimbal_angle_zero(),
        actuator_cmd: actuator_command_zero(),
        allocation: alloc,
        limits: limits,
        fault_flags: 0,
        is_armed: false,
        last_update_s: 0.0,
    };
}
