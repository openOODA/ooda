// # Navigation Hardware Receiver & IMU Stubs
//
// Logline: Provides fail-closed security stubs for raw GNSS baseband receivers and hardware IMU interrupts.
//
// Setup: Requires SysCap capability; fails closed on unsupported native navigation FFI.
//
// Beats:
//   1. Guard direct GNSS baseband tracking channel FFI access.
//   2. Guard high-speed DMA ring buffer streaming for hardware IMU sensors.
//   3. Enforce fail-closed termination on unverified sensor drivers.

import "./navigation_engine.oo";

pub fn navigation_engine_marker() -> Int {
    return 1;
}

pub type Navigation = struct {
    ptr: Int,
    len: Int,
    cap: &SysCap,
};

pub fn nav_init() -> Navigation {
    return Navigation { ptr: 0, len: 0, cap: 0 };
}

pub fn nav_do_work(obj: &Navigation) -> Int {
    return (obj).len;
}

/// Raw hardware DMA memory streaming for high-rate IMU and GNSS baseband receivers.
/// COMPILER LIMITATION: openOODA compiler currently lacks kernel driver FFI bindings
/// for direct hardware memory-mapped DMA registers and ring buffer I/O.
pub fn nav_stream_raw_hardware_dma(obj: &Navigation, cap: &SysCap) -> Int {
    // COMPILER LIMITATION: Direct hardware DMA streaming requires kernel driver FFI bindings.
    process_exit(1);
    return 0;
}

/// Double-difference carrier-phase RTK integer ambiguity resolution.
/// COMPILER LIMITATION: Real-time kinematic (RTK) integer ambiguity resolution requires
/// low-level C FFI routines and hardware coprocessor acceleration.
pub fn nav_rtk_carrier_phase_ambiguity(state_ref: &EkfState, cap: &SysCap) -> Int {
    // COMPILER LIMITATION: RTK carrier-phase ambiguity resolution requires native C FFI libraries.
    process_exit(1);
    return 0;
}

/// GPU-accelerated full 15x15 covariance matrix inversion & square-root filtering.
/// COMPILER LIMITATION: openOODA compiler lacks compute shader / GPU FFI bindings (CUDA/Vulkan).
pub fn nav_gpu_covariance_matrix_inversion(state_ref: &EkfState, cap: &SysCap) -> Int {
    // COMPILER LIMITATION: GPU compute acceleration (CUDA/Vulkan) is unavailable in openOODA userland.
    process_exit(1);
    return 0;
}
