// # TVC Kinematics Type Definitions
//
// Logline: Defines GimbalAngle, ActuatorCommand, TvcAllocation, ControlTorque, ThrustVector, TvcLimits, and TvcState structures.
//
// Setup: Pure by-value data structures for thrust vector control kinematics.
//
// Beats:
//   1. Define the gimbal angle, actuator command, allocation, control torque, and thrust vector types.
//   2. Define the limits and full TvcState bundle.

type GimbalAngle = struct {
    pitch: Float,
    yaw: Float,
    roll: Float,
    valid: Bool
};

type ActuatorCommand = struct {
    actuator_pitch_stroke_mm: Float,
    actuator_yaw_stroke_mm: Float,
    duty_cycle_pitch: Float,
    duty_cycle_yaw: Float,
    enabled: Bool
};

type TvcAllocation = struct {
    thrust_n: Float,
    moment_arm_m: Float,
    max_gimbal_pitch_rad: Float,
    max_gimbal_yaw_rad: Float,
    actuator_lever_arm_m: Float,
    max_slew_rate_rad_s: Float,
    pitch_gain: Float,
    yaw_gain: Float,
    roll_gain: Float
};

type ControlTorque = struct {
    pitch_moment_nm: Float,
    yaw_moment_nm: Float,
    roll_moment_nm: Float
};

type ThrustVector = struct {
    fx: Float,
    fy: Float,
    fz: Float
};

type TvcLimits = struct {
    min_pitch_rad: Float,
    max_pitch_rad: Float,
    min_yaw_rad: Float,
    max_yaw_rad: Float,
    max_slew_rate_rad_s: Float,
    max_actuator_stroke_mm: Float
};

type TvcState = struct {
    current_angle: GimbalAngle,
    target_angle: GimbalAngle,
    actuator_cmd: ActuatorCommand,
    allocation: TvcAllocation,
    limits: TvcLimits,
    fault_flags: Int,
    is_armed: Bool,
    last_update_s: Float
};

pub fn tvc_state_is_armed(s: TvcState) -> Bool {
    return (s).is_armed;
}
