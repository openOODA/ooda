// # Orbit types
//
// Logline: Defines KeplerianElements, EciState, Vec3, OrbitPerturbations, and HohmannTransfer.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//

type Vec3 = struct {
    x: Float,
    y: Float,
    z: Float
};

type EciState = struct {
    position: Vec3,
    velocity: Vec3,
    epoch_sec: Float
};

type KeplerianElements = struct {
    semi_major_axis: Float,
    eccentricity: Float,
    inclination: Float,
    raan: Float,
    arg_of_perigee: Float,
    true_anomaly: Float
};

type OrbitPerturbations = struct {
    j2_secular_raan_dot: Float,
    j2_secular_argp_dot: Float
};

type HohmannTransfer = struct {
    r1: Float,
    r2: Float,
    delta_v1: Float,
    delta_v2: Float,
    total_delta_v: Float,
    transfer_time: Float
};

pub fn vec3_new(x: Float, y: Float, z: Float) -> Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

pub fn vec3_zero() -> Vec3 {
    return Vec3 { x: 0.0, y: 0.0, z: 0.0 };
}

pub fn vec3_add(a: Vec3, b: Vec3) -> Vec3 {
    let rx: Float = a.x + b.x;
    let ry: Float = a.y + b.y;
    let rz: Float = a.z + b.z;
    return Vec3 { x: rx, y: ry, z: rz };
}

pub fn vec3_sub(a: Vec3, b: Vec3) -> Vec3 {
    let rx: Float = a.x - b.x;
    let ry: Float = a.y - b.y;
    let rz: Float = a.z - b.z;
    return Vec3 { x: rx, y: ry, z: rz };
}

pub fn vec3_scale(v: Vec3, s: Float) -> Vec3 {
    let rx: Float = v.x * s;
    let ry: Float = v.y * s;
    let rz: Float = v.z * s;
    return Vec3 { x: rx, y: ry, z: rz };
}

pub fn vec3_length_sq(v: Vec3) -> Float {
    let vx: Float = v.x;
    let vy: Float = v.y;
    let vz: Float = v.z;
    return ((vx * vx) + (vy * vy)) + (vz * vz);
}

pub fn vec3_length(v: Vec3) -> Float {
    return sqrt(vec3_length_sq(v));
}

pub fn vec3_dot(a: Vec3, b: Vec3) -> Float {
    let ax: Float = a.x;
    let ay: Float = a.y;
    let az: Float = a.z;
    let bx: Float = b.x;
    let by: Float = b.y;
    let bz: Float = b.z;
    return ((ax * bx) + (ay * by)) + (az * bz);
}

pub fn vec3_cross(a: Vec3, b: Vec3) -> Vec3 {
    let ax: Float = a.x;
    let ay: Float = a.y;
    let az: Float = a.z;
    let bx: Float = b.x;
    let by: Float = b.y;
    let bz: Float = b.z;
    let cx: Float = (ay * bz) - (az * by);
    let cy: Float = (az * bx) - (ax * bz);
    let cz: Float = (ax * by) - (ay * bx);
    return Vec3 { x: cx, y: cy, z: cz };
}

pub fn eci_state_new(pos: Vec3, vel: Vec3, epoch: Float) -> EciState {
    return EciState { position: pos, velocity: vel, epoch_sec: epoch };
}

pub fn keplerian_new(a: Float, e: Float, inc: Float, raan: Float, argp: Float, nu: Float) -> KeplerianElements {
    return KeplerianElements {
        semi_major_axis: a,
        eccentricity: e,
        inclination: inc,
        raan: raan,
        arg_of_perigee: argp,
        true_anomaly: nu
    };
}

pub fn keplerian_a(elem: KeplerianElements) -> Float {
    return elem.semi_major_axis;
}

pub fn keplerian_e(elem: KeplerianElements) -> Float {
    return elem.eccentricity;
}

pub fn keplerian_inc(elem: KeplerianElements) -> Float {
    return elem.inclination;
}

pub fn keplerian_raan(elem: KeplerianElements) -> Float {
    return elem.raan;
}

pub fn keplerian_argp(elem: KeplerianElements) -> Float {
    return elem.arg_of_perigee;
}

pub fn keplerian_nu(elem: KeplerianElements) -> Float {
    return elem.true_anomaly;
}

type SatelliteOrbit = struct {
    norad_id: Int,
    elements: KeplerianElements,
    state: EciState,
    epoch_sec: Float,
    bstar_drag: Float,
    decay_rate: Float
};

pub fn satellite_orbit_new(norad_id: Int, elem: KeplerianElements, state: EciState, epoch: Float, bstar: Float, decay: Float) -> SatelliteOrbit {
    return SatelliteOrbit {
        norad_id: norad_id,
        elements: elem,
        state: state,
        epoch_sec: epoch,
        bstar_drag: bstar,
        decay_rate: decay
    };
}

type OrbitVec3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn orbit_vec3_new(x: Int, y: Int, z: Int) -> OrbitVec3 {
    return OrbitVec3 { x: x, y: y, z: z };
}

pub fn orbit_vec3_x(v: OrbitVec3) -> Int {
    return v.x;
}

pub fn orbit_vec3_y(v: OrbitVec3) -> Int {
    return v.y;
}

pub fn orbit_vec3_z(v: OrbitVec3) -> Int {
    return v.z;
}
