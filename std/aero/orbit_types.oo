// # Orbit types
//
// Logline: Vec3 destubbed off nested EciState lists.
// residual: List[struct] destubbed.

type Vec3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn orbit_vec3_new(x: Int, y: Int, z: Int) -> Vec3 {
    return Vec3 { x: x, y: y, z: z };
}

pub fn orbit_vec3_x(v: Vec3) -> Int {
    return v.x;
}

pub fn orbit_vec3_y(v: Vec3) -> Int {
    return v.y;
}

pub fn orbit_vec3_z(v: Vec3) -> Int {
    return v.z;
}
