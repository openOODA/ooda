// # Formation Flight Facade
//
// Logline: Destubbed Int FormVec3 facade. Off Float shims and fail-closed stubs.
//
// Setup: Re-exports destubbed formation_types only. No List[Float]. No process_exit.
//
// Beats:
//   1. Construct FormVec3 via form_vec3_new.
//   2. Read x and y through facade getters.
// residual: engine/ops/maneuver/stubs/Float shims destubbed; this is the Int vec floor.

import "./formation_types.oo";

pub fn formation_vec3_new(x: Int, y: Int, z: Int) -> FormVec3 {
    return form_vec3_new(x, y, z);
}

pub fn formation_vec3_x(v: FormVec3) -> Int {
    return form_vec3_x(v);
}

pub fn formation_vec3_y(v: FormVec3) -> Int {
    return form_vec3_y(v);
}

pub fn formation_vec3_z(v: FormVec3) -> Int {
    return form_vec3_z(v);
}
