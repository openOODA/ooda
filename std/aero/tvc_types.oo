// # TVC gimbal Int milli destub
//
// Logline: Clamp and deg<->milli-rad. Destubbed off Float / pub type.
//
// Setup: milli-rad = deg * 3142 / 180. PI milli = 3142.
//
// Beats:
//   1. abs and clamp.
//   2. 180 deg -> 3142 milli-rad.
//   3. 3142 milli-rad -> 180 deg.

pub fn tvc_abs_milli(x: Int) -> Int {
    if x < 0 {
        return 0 - x;
    }
    return x;
}

pub fn tvc_clamp(val: Int, min_v: Int, max_v: Int) -> Int {
    if val < min_v {
        return min_v;
    }
    if val > max_v {
        return max_v;
    }
    return val;
}

pub fn tvc_pi_milli() -> Int {
    return 3142;
}

pub fn tvc_deg_to_milli_rad(deg: Int) -> Int {
    return (deg * tvc_pi_milli()) / 180;
}

pub fn tvc_milli_rad_to_deg(milli_rad: Int) -> Int {
    return (milli_rad * 180) / tvc_pi_milli();
}
