// # Navigation coords
//
// Logline: NavCoord destubbed off pub type Float WGS84/ECEF.
// residual: List[struct] destubbed to Int floor.

type NavCoord = struct {
    lat_milli: Int,
    lon_milli: Int
};

pub fn nav_coord_new(lat_milli: Int, lon_milli: Int) -> NavCoord {
    return NavCoord { lat_milli: lat_milli, lon_milli: lon_milli };
}

pub fn nav_coord_lat(c: NavCoord) -> Int {
    return c.lat_milli;
}

pub fn nav_coord_lon(c: NavCoord) -> Int {
    return c.lon_milli;
}
