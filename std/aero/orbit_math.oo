// # Orbit math
//
// Logline: Int Vec3 add destubbed off Float scale.
// residual: destubbed to Int floor.

import "./orbit_types.oo";

pub fn orbit_math_add(a: Vec3, b: Vec3) -> Vec3 {
    let ax: Int = orbit_vec3_x(a);
    let ay: Int = orbit_vec3_y(a);
    let az: Int = orbit_vec3_z(a);
    let bx: Int = orbit_vec3_x(b);
    let by: Int = orbit_vec3_y(b);
    let bz: Int = orbit_vec3_z(b);
    return orbit_vec3_new(ax + bx, ay + by, az + bz);
}

pub fn orbit_math_x(v: Vec3) -> Int {
    return v.x;
}

pub fn orbit_math_y(v: Vec3) -> Int {
    return v.y;
}

pub fn orbit_math_z(v: Vec3) -> Int {
    return v.z;
}
