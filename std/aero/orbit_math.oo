// # Orbit math
//
// Logline: Mathematical and trigonometric helpers for orbital mechanics.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//

import "./orbit_types.oo";

pub fn math_pi() -> Float {
    return 3.141592653589793;
}

pub fn math_two_pi() -> Float {
    return 6.283185307179586;
}

pub fn math_abs(val: Float) -> Float {
    if val < 0.0 {
        return 0.0 - val;
    }
    return val;
}

pub fn math_normalize_angle(angle: Float) -> Float {
    let two_pi: Float = math_two_pi();
    let mut ang: Float = angle;
    while ang < 0.0 {
        ang = ang + two_pi;
    }
    while ang >= two_pi {
        ang = ang - two_pi;
    }
    return ang;
}

pub fn math_atan_unit(z_val: Float) -> Float {
    let z2: Float = z_val * z_val;
    let c1: Float = 0.3333333333333333;
    let c2: Float = 0.2;
    let c3: Float = 0.14285714285714285;
    let c4: Float = 0.1111111111111111;
    let c5: Float = 0.09090909090909091;
    let poly: Float = z2 * (c1 - (z2 * (c2 - (z2 * (c3 - (z2 * (c4 - (z2 * c5))))))));
    return z_val * (1.0 - poly);
}

pub fn math_atan(z_val: Float) -> Float {
    let abs_z: Float = math_abs(z_val);
    if abs_z <= 1.0 {
        let res_atan: Float = math_atan_unit(abs_z);
        if z_val < 0.0 {
            return 0.0 - res_atan;
        }
        return res_atan;
    }
    let half_pi: Float = math_pi() / 2.0;
    let res_atan: Float = half_pi - math_atan_unit(1.0 / abs_z);
    if z_val < 0.0 {
        return 0.0 - res_atan;
    }
    return res_atan;
}

pub fn math_atan2(y_val: Float, x_val: Float) -> Float {
    let pi_val: Float = math_pi();
    if x_val > 0.0 {
        return math_atan(y_val / x_val);
    }
    if x_val < 0.0 {
        if y_val >= 0.0 {
            return math_atan(y_val / x_val) + pi_val;
        }
        return math_atan(y_val / x_val) - pi_val;
    }
    if y_val > 0.0 {
        return pi_val / 2.0;
    }
    if y_val < 0.0 {
        return 0.0 - (pi_val / 2.0);
    }
    return 0.0;
}

pub fn math_acos(x_val: Float) -> Float {
    let mut clamped: Float = x_val;
    if clamped > 1.0 {
        clamped = 1.0;
    }
    let neg_one: Float = 0.0 - 1.0;
    if clamped < neg_one {
        clamped = neg_one;
    }
    let sin_val: Float = sqrt(1.0 - (clamped * clamped));
    return math_atan2(sin_val, clamped);
}
