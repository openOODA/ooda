// # Telemetry batch
//
// Logline: TmBatch destubbed off List[struct] packet batches.
// residual: List[struct] destubbed to Int floor.

type TmBatch = struct {
    count: Int,
    bytes: Int
};

pub fn tm_batch_new(count: Int, bytes: Int) -> TmBatch {
    return TmBatch { count: count, bytes: bytes };
}

pub fn tm_batch_count(b: TmBatch) -> Int {
    return b.count;
}

pub fn tm_batch_bytes(b: TmBatch) -> Int {
    return b.bytes;
}
