// # Aerodynamics Facade
//
// Logline: Re-exports aerodynamic state types, atmospheric force calculations, flight dynamics engine, and fail-closed stubs.
//
// Setup: Pure module shim importing aerodynamics_types, aerodynamics_ops, aerodynamics_engine, and aerodynamics_stubs.
//
// Beats:
//   1. Import aerodynamics types, operations, engine, and fail-closed stubs.
//   2. Re-export public symbols with typed shim markers.
//   3. Maintain compatibility with downstream aerospace consumers.

import "./aerodynamics_types.oo";
import "./aerodynamics_ops.oo";
import "./aerodynamics_engine.oo";
import "./aerodynamics_stubs.oo";

pub fn shim_marker_math_pi() -> Float {
    return math_pi();
}

pub fn shim_marker_vector3_new() -> Vector3 {
    return vector3_new(1.0, 2.0, 3.0);
}

pub fn shim_marker_vector3_normalize(v_in: Vector3) -> Vector3 {
    return vector3_normalize(v_in);
}

pub fn shim_marker_isa_atmosphere() -> AtmosphereState {
    return isa_atmosphere(1000.0);
}

pub fn shim_marker_dynamic_pressure() -> DynamicPressure {
    return dynamic_pressure_new(1.225, 100.0);
}

pub fn shim_marker_aero_coefficients_zero() -> AeroCoefficients {
    return aero_coefficients_zero();
}

pub fn shim_marker_compute_mach() -> Float {
    return compute_mach_number(340.0, 340.0);
}

pub fn shim_marker_wing_geometry() -> WingGeometry {
    return wing_geometry_new(10.0, 20.0, 2.0, 0.8);
}

pub fn shim_marker_thin_airfoil_cl() -> Float {
    return thin_airfoil_cl(0.1, 0.0);
}

pub fn shim_marker_compute_lift() -> Float {
    return compute_lift_force(1000.0, 20.0, 0.5);
}

pub fn shim_marker_aero_forces() -> AeroForces {
    let dyn_pres: DynamicPressure = dynamic_pressure_new(1.225, 50.0);
    let coeffs: AeroCoefficients = aero_coefficients_zero();
    return compute_aero_forces(dyn_pres, 20.0, coeffs);
}

pub fn shim_marker_control_surfaces() -> ControlSurfaces {
    return control_surfaces_new(0.0, 0.0, 0.0, 0.0);
}

pub fn shim_marker_aero_init() -> AeroSystem {
    return aero_init();
}

pub fn shim_marker_aero_do_work(sys: &AeroSystem) -> Int {
    return aero_do_work(sys);
}
