// # Formation Relative Orbit Operations
//
// Logline: Constructs relative state representations, orbital mean motion parameters, and HCW state matrices.
//
// Setup: Relative orbital mechanics operations importing formation_types.oo.
//
// Beats:
//   1. Compute orbital mean motion and fundamental orbital frequency parameters.
//   2. Construct and transform relative Cartesian state vectors.
//   3. Formulate Hill-Clohessy-Wiltshire (HCW) state space coefficient matrices.

import "./formation_types.oo";

pub fn math_pi() -> Float {
    return 3.141592653589793;
}

pub fn math_two_pi() -> Float {
    return 6.283185307179586;
}

pub fn math_abs(val: Float) -> Float {
    if val < 0.0 {
        return 0.0 - val;
    }
    return val;
}

pub fn math_normalize_angle(angle: Float) -> Float {
    let two_pi: Float = math_two_pi();
    let mut ang: Float = angle;
    while ang < 0.0 {
        ang = ang + two_pi;
    }
    while ang >= two_pi {
        ang = ang - two_pi;
    }
    return ang;
}

pub fn math_atan_unit(z_val: Float) -> Float {
    let z2: Float = z_val * z_val;
    let c1: Float = 0.3333333333333333;
    let c2: Float = 0.2;
    let c3: Float = 0.14285714285714285;
    let c4: Float = 0.1111111111111111;
    let c5: Float = 0.09090909090909091;
    let poly: Float = z2 * (c1 - (z2 * (c2 - (z2 * (c3 - (z2 * (c4 - (z2 * c5))))))));
    return z_val * (1.0 - poly);
}

pub fn math_atan(z_val: Float) -> Float {
    let abs_z: Float = math_abs(z_val);
    if abs_z <= 1.0 {
        let res_atan: Float = math_atan_unit(abs_z);
        if z_val < 0.0 {
            return 0.0 - res_atan;
        }
        return res_atan;
    }
    let half_pi: Float = math_pi() / 2.0;
    let res_atan: Float = half_pi - math_atan_unit(1.0 / abs_z);
    if z_val < 0.0 {
        return 0.0 - res_atan;
    }
    return res_atan;
}

pub fn math_atan2(y_val: Float, x_val: Float) -> Float {
    let pi_val: Float = math_pi();
    if x_val > 0.0 {
        return math_atan(y_val / x_val);
    }
    if x_val < 0.0 {
        if y_val >= 0.0 {
            return math_atan(y_val / x_val) + pi_val;
        }
        return math_atan(y_val / x_val) - pi_val;
    }
    if y_val > 0.0 {
        return pi_val / 2.0;
    }
    if y_val < 0.0 {
        return 0.0 - (pi_val / 2.0);
    }
    return 0.0;
}

pub fn math_acos(x_val: Float) -> Float {
    let mut clamped: Float = x_val;
    if clamped > 1.0 {
        clamped = 1.0;
    }
    let neg_one: Float = 0.0 - 1.0;
    if clamped < neg_one {
        clamped = neg_one;
    }
    let sin_val: Float = sqrt(1.0 - (clamped * clamped));
    return math_atan2(sin_val, clamped);
}

pub fn math_asin(x_val: Float) -> Float {
    let mut clamped: Float = x_val;
    if clamped > 1.0 {
        clamped = 1.0;
    }
    let neg_one: Float = 0.0 - 1.0;
    if clamped < neg_one {
        clamped = neg_one;
    }
    let cos_val: Float = sqrt(1.0 - (clamped * clamped));
    return math_atan2(clamped, cos_val);
}

pub fn int_to_float(n_int: Int) -> Float {
    let mut f: Float = 0.0;
    let mut i: Int = 0;
    let mut count: Int = n_int;
    if count < 0 {
        count = 0 - count;
    }
    while count >= 1000 {
        f = f + 1000.0;
        count = count - 1000;
    }
    while count >= 100 {
        f = f + 100.0;
        count = count - 100;
    }
    while count >= 10 {
        f = f + 10.0;
        count = count - 10;
    }
    while i < count {
        f = f + 1.0;
        i = i + 1;
    }
    if n_int < 0 {
        return 0.0 - f;
    }
    return f;
}

// -------------------------------------------------------------------
// 3. Constructors and Factory Helpers
// -------------------------------------------------------------------

pub fn relative_state_new(pos: Vec3, vel: Vec3, epoch: Float) -> RelativeState {
    return RelativeState {
        position: pos,
        velocity: vel,
        epoch_sec: epoch,
    };
}

pub fn relative_state_zero() -> RelativeState {
    return RelativeState {
        position: vec3_zero(),
        velocity: vec3_zero(),
        epoch_sec: 0.0,
    };
}

pub fn chief_params_new(a_sma: Float, e_ecc: Float, mu_val: Float) -> ChiefOrbitParams {
    let mut n_val: Float = 0.0;
    if a_sma > 0.0 {
        if mu_val > 0.0 {
            let a_cubed: Float = a_sma * a_sma * a_sma;
            n_val = sqrt(mu_val / a_cubed);
        }
    }
    return ChiefOrbitParams {
        semi_major_axis: a_sma,
        eccentricity: e_ecc,
        mean_motion: n_val,
        mu: mu_val,
    };
}

pub fn hcw_new(n: Float, r0: Float, drift: Float) -> HillClohessyWiltshire {
    return HillClohessyWiltshire {
        chief_mean_motion: n,
        chief_radius: r0,
        drift_rate_y: drift,
    };
}

pub fn formation_geometry_new(gtype: Int, a_rel: Float, y_off: Float, z_amp: Float, phase: Float, x_off: Float) -> FormationGeometry {
    return FormationGeometry {
        geometry_type: gtype,
        semi_major_axis_rel: a_rel,
        in_track_offset: y_off,
        cross_track_amplitude: z_amp,
        phase_angle: phase,
        radial_offset: x_off,
    };
}

pub fn roe_new(da: Float, dex: Float, dey: Float, dix: Float, diy: Float, dlam: Float) -> RelativeKeplerianElements {
    return RelativeKeplerianElements {
        delta_a: da,
        delta_ex: dex,
        delta_ey: dey,
        delta_ix: dix,
        delta_iy: diy,
        delta_lambda: dlam,
    };
}

pub fn formation_maneuver_new(dv_chief: Vec3, dv_deputy: Vec3, time_sec: Float) -> FormationManeuver {
    let tot_dv: Float = vec3_length(dv_chief) + vec3_length(dv_deputy);
    return FormationManeuver {
        delta_v_chief: dv_chief,
        delta_v_deputy: dv_deputy,
        total_delta_v: tot_dv,
        maneuver_time_sec: time_sec,
    };
}
