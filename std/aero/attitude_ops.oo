// # Attitude ops
//
// Logline: AttOp destubbed off pub type Float QuaternionAttitude.
// residual: List[struct] destubbed to Int floor.

type AttOp = struct {
    roll: Int,
    pitch: Int
};

pub fn att_op_new(roll: Int, pitch: Int) -> AttOp {
    return AttOp { roll: roll, pitch: pitch };
}

pub fn att_op_roll(op: AttOp) -> Int {
    return op.roll;
}

pub fn att_op_pitch(op: AttOp) -> Int {
    return op.pitch;
}
