// # Thrust Vector Control Trigonometric and Math Functions
//
// Logline: Floating-point math primitives and trigonometric approximations for TVC gimbal operations.
//
// Setup: Core trigonometric and clamping math functions.
//
// Beats:
//   1. Implement absolute value, clamp, and degree-radian conversions.
//   2. Implement arctangent and inverse sine polynomial approximations.
//   3. Implement tangent evaluation and singularity protection.

pub fn tvc_pi() -> Float { return 3.14159265358979323846; }
pub fn tvc_abs(x: Float) -> Float {
    if x < 0.0  { return 0.0 - x; }
    return x;
}
pub fn tvc_clamp(val: Float, min_v: Float, max_v: Float) -> Float {
    if val < min_v  { return min_v; }
    if val > max_v  { return max_v; }
    return val;
}
pub fn tvc_deg_to_rad(deg: Float) -> Float { return (deg * tvc_pi()) / 180.0; }
pub fn math_atan_unit(x: Float) -> Float {
    let x2: Float = x * x;
    let num: Float = x * (1.0 + (x2 * 0.280872));
    let den: Float = 1.0 + (x2 * 0.614397);
    return num / den;
}
pub fn math_atan(z: Float) -> Float {
    let abs_z: Float = tvc_abs(z);
    if abs_z <= 1.0 {
        let res_atan: Float = math_atan_unit(abs_z);
        if z < 0.0  { return 0.0 - res_atan; }
        return res_atan;
    }
    let half_pi: Float = tvc_pi() / 2.0;
    let res_atan: Float = half_pi - math_atan_unit(1.0 / abs_z);
    if z < 0.0  { return 0.0 - res_atan; }
    return res_atan;
}
pub fn math_atan2(y_val: Float, x_val: Float) -> Float {
    let pi_val: Float = tvc_pi();
    if x_val > 0.0  { return math_atan(y_val / x_val); }
    if x_val < 0.0 {
        if y_val >= 0.0  { return math_atan(y_val / x_val) + pi_val; }
        return math_atan(y_val / x_val) - pi_val;
    }
    if y_val > 0.0  { return pi_val / 2.0; }
    if y_val < 0.0  { return 0.0 - (pi_val / 2.0); }
    return 0.0;
}
pub fn math_asin(x_val: Float) -> Float {
    let hi: Float = if x_val > 1.0 { 1.0 } else { x_val };
    let neg_one: Float = 0.0 - 1.0;
    let clamped: Float = if hi < neg_one { neg_one } else { hi };
    let cos_val: Float = sqrt(1.0 - (clamped * clamped));
    return math_atan2(clamped, cos_val);
}
pub fn tvc_tan(x: Float) -> Float {
    let c: Float = cos(x);
    if tvc_abs(c) < 0.000001 {
        if sin(x) >= 0.0  { return 1000000.0; }
        return 0.0 - 1000000.0;
    }
    return sin(x) / c;
}
