// # Telemetry ops
//
// Logline: TmOp destubbed off List[CcsdsPacket] batch ops.
// residual: List[struct] destubbed to Int floor.

type TmOp = struct {
    apid: Int,
    seq: Int
};

pub fn tm_op_new(apid: Int, seq: Int) -> TmOp {
    return TmOp { apid: apid, seq: seq };
}

pub fn tm_op_apid(op: TmOp) -> Int {
    return op.apid;
}

pub fn tm_op_seq(op: TmOp) -> Int {
    return op.seq;
}
