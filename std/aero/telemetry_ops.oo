// # Telemetry ops
//
// Logline: TmOp destubbed off List[CcsdsPacket] batch ops.
// residual: List[struct] destubbed to Int floor.

type TmOp = struct {
    apid: Int,
    seq: Int
};

pub fn tm_op_new(apid: Int, seq: Int) -> TmOp {
    return TmOp { apid: apid, seq: seq };
}

pub fn tm_op_apid(op: TmOp) -> Int {
    return op.apid;
}

pub fn tm_op_seq(op: TmOp) -> Int {
    return op.seq;
}

type PacketHeader = struct {
    version: Int,
    packet_type: Int,
    sec_header_flag: Int,
    apid: Int,
    sequence_flags: Int,
    sequence_count: Int,
    packet_length: Int,
};

type CcsdsPacket = struct {
    header: PacketHeader,
    service_type: Int,
    service_subtype: Int,
};

type TelemetryFrame = struct {
    version: Int,
    spacecraft_id: Int,
    virtual_channel_id: Int,
    master_frame_count: Int,
    vc_frame_count: Int,
    operational_control_flag: Bool,
    frame_length: Int,
};

type TelemetryChannel = struct {
    channel_id: Int,
    name: String,
    raw_value: Int,
    eng_value: Float,
    unit: String,
    scale_factor: Float,
    offset: Float,
    alarm_low: Float,
    alarm_high: Float,
    in_alarm: Bool,
};

pub fn int_to_float(n_int: Int) -> Float {
    let mut f: Float = 0.0;
    let mut i: Int = 0;
    let mut count: Int = n_int;
    if count < 0 {
        count = 0 - count;
    }
    while count >= 1000 {
        f = f + 1000.0;
        count = count - 1000;
    }
    while count >= 100 {
        f = f + 100.0;
        count = count - 100;
    }
    while count >= 10 {
        f = f + 10.0;
        count = count - 10;
    }
    while i < count {
        f = f + 1.0;
        i = i + 1;
    }
    if n_int < 0 {
        return 0.0 - f;
    }
    return f;
}
