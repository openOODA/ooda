// # TVC Control Allocation & Slew Rate Engine
//
// Logline: Maps 3-axis torque to gimbal angles with slew limiting. Destubbed off &mut / tvc_ops hang.
//
// Setup: Self-contained by-value TvcState. No tvc_ops import (emit hang).
//
// Beats:
//   1. Allocate pitch/yaw from torque / (thrust * arm).
//   2. Clamp gimbals and slew-limit the step.
//   3. Arm/disarm and advance last_update_s.

import "./tvc_math.oo";

type GimbalAngle = struct { pitch: Float, yaw: Float, roll: Float, valid: Bool };

type ActuatorCommand = struct {
    actuator_pitch_stroke_mm: Float, actuator_yaw_stroke_mm: Float,
    duty_cycle_pitch: Float, duty_cycle_yaw: Float, enabled: Bool
};

type TvcAllocation = struct {
    thrust_n: Float, moment_arm_m: Float, max_gimbal_pitch_rad: Float,
    max_gimbal_yaw_rad: Float, actuator_lever_arm_m: Float,
    max_slew_rate_rad_s: Float, pitch_gain: Float, yaw_gain: Float,
    roll_gain: Float
};

type ControlTorque = struct {
    pitch_moment_nm: Float, yaw_moment_nm: Float, roll_moment_nm: Float
};

type ThrustVector = struct { fx: Float, fy: Float, fz: Float };

type TvcLimits = struct {
    min_pitch_rad: Float, max_pitch_rad: Float, min_yaw_rad: Float,
    max_yaw_rad: Float, max_slew_rate_rad_s: Float, max_actuator_stroke_mm: Float
};

type TvcState = struct {
    current_angle: GimbalAngle, target_angle: GimbalAngle,
    actuator_cmd: ActuatorCommand, allocation: TvcAllocation, limits: TvcLimits,
    fault_flags: Int, is_armed: Bool, last_update_s: Float
};

pub fn gimbal_angle_zero() -> GimbalAngle {
    return GimbalAngle { pitch: 0.0, yaw: 0.0, roll: 0.0, valid: true };
}

pub fn actuator_command_zero() -> ActuatorCommand {
    return ActuatorCommand {
        actuator_pitch_stroke_mm: 0.0, actuator_yaw_stroke_mm: 0.0,
        duty_cycle_pitch: 0.0, duty_cycle_yaw: 0.0, enabled: false
    };
}

pub fn actuator_command_clamp(cmd: ActuatorCommand, max_stroke_mm: Float) -> ActuatorCommand {
    let neg_max: Float = 0.0 - max_stroke_mm;
    let clamped_sp: Float = tvc_clamp(cmd.actuator_pitch_stroke_mm, neg_max, max_stroke_mm);
    let clamped_sy: Float = tvc_clamp(cmd.actuator_yaw_stroke_mm, neg_max, max_stroke_mm);
    return ActuatorCommand {
        actuator_pitch_stroke_mm: clamped_sp, actuator_yaw_stroke_mm: clamped_sy,
        duty_cycle_pitch: cmd.duty_cycle_pitch, duty_cycle_yaw: cmd.duty_cycle_yaw,
        enabled: cmd.enabled
    };
}

pub fn tvc_allocation_default() -> TvcAllocation {
    return TvcAllocation {
        thrust_n: 1000.0, moment_arm_m: 2.0,
        max_gimbal_pitch_rad: tvc_deg_to_rad(7.0),
        max_gimbal_yaw_rad: tvc_deg_to_rad(7.0), actuator_lever_arm_m: 0.15,
        max_slew_rate_rad_s: tvc_deg_to_rad(20.0), pitch_gain: 1.0, yaw_gain: 1.0,
        roll_gain: 1.0
    };
}

pub fn control_torque_new(p_nm: Float, y_nm: Float, r_nm: Float) -> ControlTorque {
    return ControlTorque { pitch_moment_nm: p_nm, yaw_moment_nm: y_nm, roll_moment_nm: r_nm };
}

pub fn tvc_limits_default() -> TvcLimits {
    let default_max: Float = tvc_deg_to_rad(7.0);
    let default_min: Float = 0.0 - default_max;
    return TvcLimits {
        min_pitch_rad: default_min, max_pitch_rad: default_max,
        min_yaw_rad: default_min, max_yaw_rad: default_max,
        max_slew_rate_rad_s: tvc_deg_to_rad(20.0), max_actuator_stroke_mm: 50.0
    };
}

pub fn tvc_state_init(alloc: TvcAllocation, limits: TvcLimits) -> TvcState {
    return TvcState {
        current_angle: gimbal_angle_zero(), target_angle: gimbal_angle_zero(),
        actuator_cmd: actuator_command_zero(), allocation: alloc, limits: limits,
        fault_flags: 0, is_armed: false, last_update_s: 0.0
    };
}

pub fn tvc_clamp_gimbal_angle(angle: GimbalAngle, limits: TvcLimits) -> GimbalAngle {
    let p0: Float = angle.pitch;
    let y0: Float = angle.yaw;
    let p_lo: Float = if p0 < limits.min_pitch_rad { limits.min_pitch_rad } else { p0 };
    let p: Float = if p_lo > limits.max_pitch_rad { limits.max_pitch_rad } else { p_lo };
    let y_lo: Float = if y0 < limits.min_yaw_rad { limits.min_yaw_rad } else { y0 };
    let y: Float = if y_lo > limits.max_yaw_rad { limits.max_yaw_rad } else { y_lo };
    let pitch_hit: Bool = if p0 < limits.min_pitch_rad { true } else { if p0 > limits.max_pitch_rad { true } else { false } };
    let yaw_hit: Bool = if y0 < limits.min_yaw_rad { true } else { if y0 > limits.max_yaw_rad { true } else { false } };
    let is_valid: Bool = if pitch_hit { false } else { if yaw_hit { false } else { angle.valid } };
    return GimbalAngle { pitch: p, yaw: y, roll: angle.roll, valid: is_valid };
}

pub fn tvc_gimbal_to_thrust_vector(angle: GimbalAngle) -> ThrustVector {
    let cp: Float = cos(angle.pitch);
    let sp: Float = sin(angle.pitch);
    let cy: Float = cos(angle.yaw);
    let sy: Float = sin(angle.yaw);
    let fx: Float = cp * cy;
    let fy: Float = sp * cy;
    let fz: Float = 0.0 - sy;
    return ThrustVector { fx: fx, fy: fy, fz: fz };
}

pub fn tvc_thrust_vector_to_gimbal(vec: ThrustVector) -> GimbalAngle {
    let pitch_val: Float = math_atan2(vec.fy, vec.fx);
    let yaw_val: Float = math_asin(0.0 - vec.fz);
    return GimbalAngle { pitch: pitch_val, yaw: yaw_val, roll: 0.0, valid: true };
}

pub fn tvc_compute_control_moments(angle: GimbalAngle, thrust_n: Float, moment_arm_m: Float) -> ControlTorque {
    let control_auth: Float = thrust_n * moment_arm_m;
    let sp: Float = sin(angle.pitch);
    let sy: Float = sin(angle.yaw);
    let p_moment: Float = control_auth * sp;
    let y_moment: Float = control_auth * sy;
    return ControlTorque {
        pitch_moment_nm: p_moment, yaw_moment_nm: y_moment, roll_moment_nm: 0.0
    };
}

pub fn tvc_allocate_control_torque(alloc: TvcAllocation, torque: ControlTorque) -> GimbalAngle {
    let control_auth: Float = alloc.thrust_n * alloc.moment_arm_m;
    if control_auth <= 0.001  { return gimbal_angle_zero(); }
    let raw_p: Float = torque.pitch_moment_nm / control_auth;
    let raw_y: Float = torque.yaw_moment_nm / control_auth;
    let clamped_p: Float = tvc_clamp(raw_p, 0.0 - 1.0, 1.0);
    let clamped_y: Float = tvc_clamp(raw_y, 0.0 - 1.0, 1.0);
    let target_pitch: Float = math_asin(clamped_p) * alloc.pitch_gain;
    let target_yaw: Float = math_asin(clamped_y) * alloc.yaw_gain;
    let target_roll: Float = torque.roll_moment_nm * alloc.roll_gain;
    return GimbalAngle { pitch: target_pitch, yaw: target_yaw, roll: target_roll, valid: true };
}

pub fn tvc_step_slew_rate_limit(current: GimbalAngle, target: GimbalAngle, max_slew_rate: Float, dt_s: Float) -> GimbalAngle {
    if dt_s <= 0.0  { return current; }
    let max_delta: Float = max_slew_rate * dt_s;
    let neg_max: Float = 0.0 - max_delta;
    let delta_p: Float = tvc_clamp(target.pitch - current.pitch, neg_max, max_delta);
    let delta_y: Float = tvc_clamp(target.yaw - current.yaw, neg_max, max_delta);
    let delta_r: Float = tvc_clamp(target.roll - current.roll, neg_max, max_delta);
    return GimbalAngle {
        pitch: current.pitch + delta_p, yaw: current.yaw + delta_y,
        roll: current.roll + delta_r, valid: target.valid
    };
}

pub fn tvc_gimbal_to_actuator_command(angle: GimbalAngle, alloc: TvcAllocation, limits: TvcLimits) -> ActuatorCommand {
    let lever_m: Float = alloc.actuator_lever_arm_m;
    let stroke_p_mm: Float = (lever_m * tvc_tan(angle.pitch)) * 1000.0;
    let stroke_y_mm: Float = (lever_m * tvc_tan(angle.yaw)) * 1000.0;
    let max_stroke: Float = limits.max_actuator_stroke_mm;
    let duty_p: Float = if max_stroke > 0.0 { tvc_clamp(stroke_p_mm / max_stroke, 0.0 - 1.0, 1.0) } else { 0.0 };
    let duty_y: Float = if max_stroke > 0.0 { tvc_clamp(stroke_y_mm / max_stroke, 0.0 - 1.0, 1.0) } else { 0.0 };
    let raw_cmd: ActuatorCommand = ActuatorCommand {
        actuator_pitch_stroke_mm: stroke_p_mm, actuator_yaw_stroke_mm: stroke_y_mm,
        duty_cycle_pitch: duty_p, duty_cycle_yaw: duty_y, enabled: angle.valid
    };
    return actuator_command_clamp(raw_cmd, max_stroke);
}

pub fn tvc_state_step(st: TvcState, torque_cmd: ControlTorque, dt_s: Float) -> TvcState {
    if st.is_armed == false {
        return TvcState {
            current_angle: st.current_angle, target_angle: st.target_angle,
            actuator_cmd: actuator_command_zero(), allocation: st.allocation,
            limits: st.limits, fault_flags: st.fault_flags, is_armed: st.is_armed,
            last_update_s: st.last_update_s
        };
    }
    let target_raw: GimbalAngle = tvc_allocate_control_torque(st.allocation, torque_cmd);
    let target_clamped: GimbalAngle = tvc_clamp_gimbal_angle(target_raw, st.limits);
    let slew_limit_rad: Float = st.limits.max_slew_rate_rad_s;
    let stepped_angle: GimbalAngle = tvc_step_slew_rate_limit(st.current_angle, target_clamped, slew_limit_rad, dt_s);
    let cmd: ActuatorCommand = tvc_gimbal_to_actuator_command(stepped_angle, st.allocation, st.limits);
    let next_t: Float = st.last_update_s + dt_s;
    return TvcState {
        current_angle: stepped_angle, target_angle: target_clamped,
        actuator_cmd: cmd, allocation: st.allocation, limits: st.limits,
        fault_flags: st.fault_flags, is_armed: st.is_armed, last_update_s: next_t
    };
}

pub fn tvc_state_arm(st: TvcState) -> TvcState {
    return TvcState {
        current_angle: st.current_angle, target_angle: st.target_angle,
        actuator_cmd: st.actuator_cmd, allocation: st.allocation, limits: st.limits,
        fault_flags: st.fault_flags, is_armed: true, last_update_s: st.last_update_s
    };
}

pub fn tvc_state_disarm(st: TvcState) -> TvcState {
    return TvcState {
        current_angle: st.current_angle, target_angle: st.target_angle,
        actuator_cmd: actuator_command_zero(), allocation: st.allocation,
        limits: st.limits, fault_flags: st.fault_flags, is_armed: false,
        last_update_s: st.last_update_s
    };
}

pub fn tvc_state_is_armed(st: TvcState) -> Bool { return st.is_armed; }

pub fn tvc_state_last_update_s(st: TvcState) -> Float { return st.last_update_s; }
