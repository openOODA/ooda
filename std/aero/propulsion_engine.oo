type PropEng = struct {
    thrust: Int,
    isp: Int
};

pub fn prop_eng_new(thrust: Int, isp: Int) -> PropEng {
    return PropEng { thrust: thrust, isp: isp };
}

pub fn prop_eng_thrust(e: PropEng) -> Int {
    return e.thrust;
}

pub fn prop_eng_isp(e: PropEng) -> Int {
    return e.isp;
}
