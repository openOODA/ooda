// # Thrust Vector Control (TVC) Facade
//
// Logline: Destubbed Int tvc_types facade. Off Float shims and fail-closed stubs.
//
// Setup: Re-exports destubbed tvc_types only. No List[Float]. No process_exit.
//
// Beats:
//   1. Convert deg to milli-rad and back through facade wrappers.
//   2. Abs and clamp through facade wrappers.
// residual: ops/engine/stubs/Float shims destubbed; this is the Int milli-rad floor.

import "./tvc_types.oo";

pub fn tvc_facade_abs(x: Int) -> Int {
    return tvc_abs_milli(x);
}

pub fn tvc_facade_clamp(val: Int, min_v: Int, max_v: Int) -> Int {
    return tvc_clamp(val, min_v, max_v);
}

pub fn tvc_facade_deg_to_milli(deg: Int) -> Int {
    return tvc_deg_to_milli_rad(deg);
}

pub fn tvc_facade_milli_to_deg(milli_rad: Int) -> Int {
    return tvc_milli_rad_to_deg(milli_rad);
}
