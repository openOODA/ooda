type NavEng = struct {
    fix_type: Int,
    sats: Int
};

pub fn nav_eng_new(fix_type: Int, sats: Int) -> NavEng {
    return NavEng { fix_type: fix_type, sats: sats };
}

pub fn nav_eng_sats(e: NavEng) -> Int {
    return e.sats;
}

pub fn nav_eng_fix_type(e: NavEng) -> Int {
    return e.fix_type;
}
