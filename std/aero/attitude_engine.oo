// # Attitude engine
//
// Logline: AttEng destubbed off pub type Float kinematics.
// residual: List[struct] destubbed to Int floor.

type AttEng = struct {
    mode: Int,
    rate: Int
};

pub fn att_eng_new(mode: Int, rate: Int) -> AttEng {
    return AttEng { mode: mode, rate: rate };
}

pub fn att_eng_mode(e: AttEng) -> Int {
    return e.mode;
}

pub fn att_eng_rate(e: AttEng) -> Int {
    return e.rate;
}
