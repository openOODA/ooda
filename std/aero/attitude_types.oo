type AttVec3 = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn att_vec3_new(x: Int, y: Int, z: Int) -> AttVec3 {
    return AttVec3 { x: x, y: y, z: z };
}

pub fn att_vec3_x(v: AttVec3) -> Int {
    return v.x;
}

pub fn att_vec3_y(v: AttVec3) -> Int {
    return v.y;
}

pub fn att_vec3_z(v: AttVec3) -> Int {
    return v.z;
}
