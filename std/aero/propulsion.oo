// # Rocket & Jet Propulsion Facade
//
// Logline: Destubbed Int prop_eng facade. Off Float shims and fail-closed stubs.
//
// Setup: Re-exports destubbed propulsion_engine only. No List[Float]. No process_exit.
//
// Beats:
//   1. Construct PropEng via prop_eng_new.
//   2. Read thrust and isp through facade getters.
// residual: types/ops/stubs/Float shims destubbed; this is the Int thrust/isp floor.

import "./propulsion_engine.oo";

pub fn propulsion_eng_new(thrust: Int, isp: Int) -> PropEng {
    return prop_eng_new(thrust, isp);
}

pub fn propulsion_eng_thrust(e: PropEng) -> Int {
    return prop_eng_thrust(e);
}

pub fn propulsion_eng_isp(e: PropEng) -> Int {
    return prop_eng_isp(e);
}
