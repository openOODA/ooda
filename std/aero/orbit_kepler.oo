// # Kepler Equation Solver & Orbital Dynamics
//
// Logline: Solves Kepler's equation for elliptic and hyperbolic anomalies and evaluates mean motion.
//
// Setup: Orbital mathematics algorithms importing orbit_math.oo.
//
// Beats:
//   1. Implement Newton-Raphson iterative solver for Kepler's eccentric anomaly.
//   2. Convert between Mean, Eccentric, and True anomalies.
//   3. Compute orbital period, mean motion, and orbital velocity magnitudes.

import "./orbit_math.oo";

pub fn mu_earth() -> Float {
    return 398600441800000.0;
}

pub fn radius_earth() -> Float {
    return 6378137.0;
}

pub fn j2_earth() -> Float {
    return 0.00108263;
}

// -------------------------------------------------------------------
// Fundamental Keplerian Orbital Dynamics
// -------------------------------------------------------------------

/// Orbital period T = 2 * pi * sqrt(a^3 / mu)
pub fn orbital_period(a: Float, mu: Float) -> Float {
    if a <= 0.0 {
        return 0.0;
    }
    if mu <= 0.0 {
        return 0.0;
    }
    let a_cubed: Float = a * a * a;
    return math_two_pi() * sqrt(a_cubed / mu);
}

/// Mean motion n = sqrt(mu / a^3)
pub fn mean_motion(a: Float, mu: Float) -> Float {
    if a <= 0.0 {
        return 0.0;
    }
    if mu <= 0.0 {
        return 0.0;
    }
    let a_cubed: Float = a * a * a;
    return sqrt(mu / a_cubed);
}

/// Orbital speed from Vis-Viva equation: v = sqrt(mu * (2/r - 1/a))
pub fn vis_viva_speed(r: Float, a: Float, mu: Float) -> Float {
    if r <= 0.0 {
        return 0.0;
    }
    let term: Float = (2.0 / r) - (1.0 / a);
    if term <= 0.0 {
        return 0.0;
    }
    return sqrt(mu * term);
}

/// Circular orbital speed v_c = sqrt(mu / r)
pub fn circular_orbit_speed(r: Float, mu: Float) -> Float {
    if r <= 0.0 {
        return 0.0;
    }
    return sqrt(mu / r);
}

/// Escape velocity v_e = sqrt(2 * mu / r)
pub fn escape_speed(r: Float, mu: Float) -> Float {
    if r <= 0.0 {
        return 0.0;
    }
    return sqrt((2.0 * mu) / r);
}

/// Perigee radius r_p = a * (1 - e)
pub fn perigee_radius(a: Float, e: Float) -> Float {
    return a * (1.0 - e);
}

/// Apogee radius r_a = a * (1 + e)
pub fn apogee_radius(a: Float, e: Float) -> Float {
    return a * (1.0 + e);
}

/// Perigee altitude above planetary radius
pub fn perigee_altitude(a: Float, e: Float, r_body: Float) -> Float {
    return perigee_radius(a, e) - r_body;
}

/// Apogee altitude above planetary radius
pub fn apogee_altitude(a: Float, e: Float, r_body: Float) -> Float {
    return apogee_radius(a, e) - r_body;
}

/// Specific orbital energy epsilon = -mu / (2 * a)
pub fn specific_orbital_energy(a: Float, mu: Float) -> Float {
    if a == 0.0 {
        return 0.0;
    }
    return (0.0 - mu) / (2.0 * a);
}

/// Specific angular momentum magnitude h = sqrt(mu * a * (1 - e^2))
pub fn specific_angular_momentum(a: Float, e: Float, mu: Float) -> Float {
    let p: Float = a * (1.0 - (e * e));
    if p <= 0.0 {
        return 0.0;
    }
    return sqrt(mu * p);
}

// -------------------------------------------------------------------
// Anomaly Conversions & Kepler's Solver
// -------------------------------------------------------------------

/// Convert True Anomaly (nu) to Eccentric Anomaly (E)
pub fn true_to_eccentric_anomaly(nu: Float, e: Float) -> Float {
    let sin_nu: Float = sin(nu);
    let cos_nu: Float = cos(nu);
    let e_sq: Float = e * e;
    let factor: Float = sqrt(1.0 - e_sq);
    
    let sin_e: Float = (factor * sin_nu) / (1.0 + (e * cos_nu));
    let cos_e: Float = (e + cos_nu) / (1.0 + (e * cos_nu));
    
    let e_anomaly: Float = math_atan2(sin_e, cos_e);
    return math_normalize_angle(e_anomaly);
}

/// Convert Eccentric Anomaly (E) to Mean Anomaly (M): M = E - e * sin(E)
pub fn eccentric_to_mean_anomaly(e_anomaly: Float, e: Float) -> Float {
    let m_anomaly: Float = e_anomaly - (e * sin(e_anomaly));
    return math_normalize_angle(m_anomaly);
}

/// Convert Eccentric Anomaly (E) to True Anomaly (nu)
pub fn eccentric_to_true_anomaly(e_anomaly: Float, e: Float) -> Float {
    let sin_e: Float = sin(e_anomaly);
    let cos_e: Float = cos(e_anomaly);
    let e_sq: Float = e * e;
    let factor: Float = sqrt(1.0 - e_sq);
    
    let sin_nu: Float = (factor * sin_e) / (1.0 - (e * cos_e));
    let cos_nu: Float = (cos_e - e) / (1.0 - (e * cos_e));
    
    let nu: Float = math_atan2(sin_nu, cos_nu);
    return math_normalize_angle(nu);
}

/// Solve Kepler's equation M = E - e * sin(E) for Eccentric Anomaly E using Newton-Raphson.
pub fn solve_kepler_eccentric(mean_anom: Float, e: Float) -> Float {
    let m_norm: Float = math_normalize_angle(mean_anom);
    let mut e_curr: Float = m_norm;
    let mut iter: Int = 0;
    let max_iter: Int = 15;
    let mut diff: Float = 1.0;

    while iter < max_iter {
        if diff > 0.0000000001 {
            let f_val: Float = (e_curr - (e * sin(e_curr))) - m_norm;
            let f_prime: Float = 1.0 - (e * cos(e_curr));
            let delta: Float = f_val / f_prime;
            e_curr = e_curr - delta;
            diff = math_abs(delta);
            iter = iter + 1;
        } else {
            iter = max_iter;
        }
    }
    return math_normalize_angle(e_curr);
}
