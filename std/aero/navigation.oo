// # Integrated Navigation System Facade
//
// Logline: Destubbed Int nav_coord facade. Off Float shims and fail-closed stubs.
//
// Setup: Re-exports destubbed navigation_coords only. No List[Float]. No process_exit.
//
// Beats:
//   1. Construct NavCoord via nav_coord_new.
//   2. Read lat and lon through facade getters.
// residual: quat/ekf/engine/stubs/Float shims destubbed; this is the Int milli-deg floor.

import "./navigation_coords.oo";

pub fn navigation_fix_new(lat_milli: Int, lon_milli: Int) -> NavCoord {
    return nav_coord_new(lat_milli, lon_milli);
}

pub fn navigation_fix_lat(c: NavCoord) -> Int {
    return nav_coord_lat(c);
}

pub fn navigation_fix_lon(c: NavCoord) -> Int {
    return nav_coord_lon(c);
}
