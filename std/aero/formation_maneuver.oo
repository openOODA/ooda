// # Formation Maneuvering & Proximity Safety
//
// Logline: Computes impulsive orbital maneuvers, relative orbit element (ROE) transitions, and collision safety.
//
// Setup: Relative orbit maneuver algorithms importing formation_engine.oo.
//
// Beats:
//   1. Transform Cartesian states to Relative Orbit Elements (ROE).
//   2. Plan two-impulse and multi-burn relative transfer maneuvers.
//   3. Evaluate passive collision avoidance and proximity safety ellipsoids.

import "./formation_engine.oo";

pub fn eci_to_lvlh(r_chief: Vec3, v_chief: Vec3, r_deputy: Vec3, v_deputy: Vec3) -> RelativeState {
    let r_mag: Float = vec3_length(r_chief);
    if r_mag < 0.000001 {
        return relative_state_zero();
    }

    // Radial unit vector i_r
    let i_r: Vec3 = vec3_scale(r_chief, 1.0 / r_mag);

    // Cross-track unit vector i_h = (r x v) / |r x v|
    let h_vec: Vec3 = vec3_cross(r_chief, v_chief);
    let h_mag: Float = vec3_length(h_vec);
    if h_mag < 0.000001 {
        return relative_state_zero();
    }
    let i_h: Vec3 = vec3_scale(h_vec, 1.0 / h_mag);

    // Along-track unit vector i_theta = i_h x i_r
    let i_theta: Vec3 = vec3_cross(i_h, i_r);

    // Difference vectors in ECI
    let dr_eci: Vec3 = vec3_sub(r_deputy, r_chief);
    let dv_eci: Vec3 = vec3_sub(v_deputy, v_chief);

    // Relative Position in LVLH
    let rx_lvlh: Float = vec3_dot(dr_eci, i_r);
    let ry_lvlh: Float = vec3_dot(dr_eci, i_theta);
    let rz_lvlh: Float = vec3_dot(dr_eci, i_h);

    // Angular velocity vector of LVLH frame w = h_vec / r^2
    let w_mag: Float = h_mag / (r_mag * r_mag);
    let w_vec: Vec3 = vec3_scale(i_h, w_mag);

    // Transport theorem velocity correction: v_rel = dv_eci - (w x dr_eci)
    let w_cross_dr: Vec3 = vec3_cross(w_vec, dr_eci);
    let v_rel_eci: Vec3 = vec3_sub(dv_eci, w_cross_dr);

    let vx_lvlh: Float = vec3_dot(v_rel_eci, i_r);
    let vy_lvlh: Float = vec3_dot(v_rel_eci, i_theta);
    let vz_lvlh: Float = vec3_dot(v_rel_eci, i_h);

    let pos: Vec3 = vec3_new(rx_lvlh, ry_lvlh, rz_lvlh);
    let vel: Vec3 = vec3_new(vx_lvlh, vy_lvlh, vz_lvlh);

    return relative_state_new(pos, vel, 0.0);
}

/// Convert LVLH relative position back to ECI position
pub fn lvlh_to_eci_position(r_chief: Vec3, v_chief: Vec3, rel_pos: Vec3) -> Vec3 {
    let r_mag: Float = vec3_length(r_chief);
    if r_mag < 0.000001 {
        return r_chief;
    }
    let i_r: Vec3 = vec3_scale(r_chief, 1.0 / r_mag);
    let h_vec: Vec3 = vec3_cross(r_chief, v_chief);
    let h_mag: Float = vec3_length(h_vec);
    if h_mag < 0.000001 {
        return r_chief;
    }
    let i_h: Vec3 = vec3_scale(h_vec, 1.0 / h_mag);
    let i_theta: Vec3 = vec3_cross(i_h, i_r);

    let x_part: Vec3 = vec3_scale(i_r, (rel_pos).x);
    let y_part: Vec3 = vec3_scale(i_theta, (rel_pos).y);
    let z_part: Vec3 = vec3_scale(i_h, (rel_pos).z);

    let dr_eci: Vec3 = vec3_add(vec3_add(x_part, y_part), z_part);
    return vec3_add(r_chief, dr_eci);
}

/// Compute Relative Orbital Elements (ROE) between Chief and Deputy Keplerian orbits
pub fn compute_roe(a_c: Float, e_c: Float, i_c: Float, raan_c: Float, argp_c: Float, M_c: Float,
                    a_d: Float, e_d: Float, i_d: Float, raan_d: Float, argp_d: Float, M_d: Float) -> RelativeKeplerianElements {
    let da: Float = (a_d - a_c) / a_c;

    let ex_c: Float = e_c * cos(argp_c);
    let ey_c: Float = e_c * sin(argp_c);
    let ex_d: Float = e_d * cos(argp_d);
    let ey_d: Float = e_d * sin(argp_d);

    let dex: Float = ex_d - ex_c;
    let dey: Float = ey_d - ey_c;

    let di: Float = i_d - i_c;
    let draan: Float = raan_d - raan_c;

    let dix: Float = di;
    let diy: Float = draan * sin(i_c);

    let u_c: Float = argp_c + M_c;
    let u_d: Float = argp_d + M_d;
    let dlam: Float = (u_d - u_c) + (draan * cos(i_c));

    return roe_new(da, dex, dey, dix, diy, dlam);
}

// 7. Relative Impulse Maneuvers & Target Rendezvous

/// Compute immediate single impulse Delta-V to eliminate secular along-track drift
pub fn calculate_drift_correction_dv(state: RelativeState, n_mean: Float) -> Vec3 {
    let x0: Float = ((state).position).x;
    let vy0: Float = ((state).velocity).y;
    let target_vy: Float = hcw_bounded_v_intrack(x0, n_mean);
    let delta_vy: Float = target_vy - vy0;
    return vec3_new(0.0, delta_vy, 0.0);
}

/// Compute 2-Impulse HCW Relative Rendezvous maneuver to reach target position in time tof
pub fn calculate_impulsive_rendezvous_dv(state0: RelativeState, target_pos: Vec3, n_mean: Float, tof: Float) -> FormationManeuver {
    if tof <= 0.000001 {
        let zero_v: Vec3 = vec3_zero();
        return formation_maneuver_new(zero_v, zero_v, tof);
    }
    if n_mean <= 0.000001 {
        let zero_v: Vec3 = vec3_zero();
        return formation_maneuver_new(zero_v, zero_v, tof);
    }

    let x0: Float = ((state0).position).x;
    let y0: Float = ((state0).position).y;
    let z0: Float = ((state0).position).z;

    let vx0: Float = ((state0).velocity).x;
    let vy0: Float = ((state0).velocity).y;
    let vz0: Float = ((state0).velocity).z;

    let xf: Float = (target_pos).x;
    let yf: Float = (target_pos).y;
    let zf: Float = (target_pos).z;

    let theta: Float = n_mean * tof;
    let s: Float = sin(theta);
    let c: Float = cos(theta);

    // Position difference target vector b = r_target - Phi_rr * r_0
    let bx: Float = xf - ((4.0 - (3.0 * c)) * x0);
    let by: Float = yf - (((6.0 * (s - theta)) * x0) + y0);
    let bz: Float = zf - (c * z0);

    // Phi_rv submatrix components
    let a11: Float = s / n_mean;
    let a12: Float = (2.0 * (1.0 - c)) / n_mean;
    let a21: Float = (0.0 - (2.0 * (1.0 - c))) / n_mean;
    let a22: Float = ((4.0 * s) - (3.0 * theta)) / n_mean;

    let det: Float = (a11 * a22) - (a12 * a21);
    if math_abs(det) < 0.000000000001 {
        let zero_v: Vec3 = vec3_zero();
        return formation_maneuver_new(zero_v, zero_v, tof);
    }

    // Solve for required post-impulse initial velocity v0+
    let vx0_plus: Float = ((a22 * bx) - (a12 * by)) / det;
    let vy0_plus: Float = (((0.0 - a21) * bx) + (a11 * by)) / det;
    
    let mut vz0_plus: Float = 0.0;
    if math_abs(s) > 0.000001 {
        vz0_plus = (bz * n_mean) / s;
    }

    // First impulse Delta-V 1 at t = 0
    let dv1: Vec3 = vec3_new(vx0_plus - vx0, vy0_plus - vy0, vz0_plus - vz0);

    // Propagate state with v0+ to t = tof to find arrival velocity v_f_minus
    let state_post_impulse: RelativeState = relative_state_new((state0).position, vec3_new(vx0_plus, vy0_plus, vz0_plus), 0.0);
    let state_arrival: RelativeState = hcw_propagate(state_post_impulse, n_mean, tof);
    let v_arrival: Vec3 = (state_arrival).velocity;

    // Second impulse Delta-V 2 at t = tof to match target (zero relative velocity)
    let dv2: Vec3 = vec3_neg(v_arrival);

    return formation_maneuver_new(dv1, dv2, tof);
}

// 8. Safety Analysis, Proximity Operations & Control Error

/// Compute relative distance between two relative states
pub fn relative_distance(s1: RelativeState, s2: RelativeState) -> Float {
    let dr: Vec3 = vec3_sub((s1).position, (s2).position);
    return vec3_length(dr);
}

/// Compute relative speed between two relative states
pub fn relative_speed(s1: RelativeState, s2: RelativeState) -> Float {
    let dv: Vec3 = vec3_sub((s1).velocity, (s2).velocity);
    return vec3_length(dv);
}

/// Minimum approach distance over propagation duration using discrete sampling
pub fn formation_minimum_distance(state0: RelativeState, n_mean: Float, duration: Float, steps: Int) -> Float {
    if steps <= 0 {
        return vec3_length((state0).position);
    }
    let steps_f: Float = int_to_float(steps);
    let dt_step: Float = duration / steps_f;
    let mut min_dist: Float = vec3_length((state0).position);
    let mut i: Int = 0;

    while i <= steps {
        let t_curr: Float = int_to_float(i) * dt_step;
        let s_t: RelativeState = hcw_propagate(state0, n_mean, t_curr);
        let dist_t: Float = vec3_length((s_t).position);
        if dist_t < min_dist {
            min_dist = dist_t;
        }
        i = i + 1;
    }
    return min_dist;
}

/// Check proximity safety and keep-out sphere violation
pub fn check_formation_safety(state0: RelativeState, n_mean: Float, min_safe_dist: Float, duration: Float) -> FormationSafety {
    let min_dist: Float = formation_minimum_distance(state0, n_mean, duration, 20);
    let is_violated: Bool = min_dist < min_safe_dist;
    let is_safe: Bool = min_dist >= min_safe_dist;

    return FormationSafety {
        min_approach_distance: min_dist,
        collision_warning: is_violated,
        keep_out_sphere_radius: min_safe_dist,
        is_pass_safe: is_safe,
    };
}

/// Compute tracking control error between current and target relative states
pub fn formation_control_error(current: RelativeState, target: RelativeState) -> FormationControlState {
    let pos_err: Vec3 = vec3_sub((current).position, (target).position);
    let vel_err: Vec3 = vec3_sub((current).velocity, (target).velocity);
    let pos_mag: Float = vec3_length(pos_err);
    let vel_mag: Float = vec3_length(vel_err);

    return FormationControlState {
        target_state: target,
        current_state: current,
        position_error: pos_err,
        velocity_error: vel_err,
        total_pos_error_mag: pos_mag,
        total_vel_error_mag: vel_mag,
    };
}
