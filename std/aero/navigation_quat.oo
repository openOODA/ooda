type NavQuat = struct {
    w: Int,
    x: Int
};

pub fn nav_quat_new(w: Int, x: Int) -> NavQuat {
    return NavQuat { w: w, x: x };
}

pub fn nav_quat_w(q: NavQuat) -> Int {
    return q.w;
}

pub fn nav_quat_x(q: NavQuat) -> Int {
    return q.x;
}
