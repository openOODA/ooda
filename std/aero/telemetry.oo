// # CCSDS Aerospace Telemetry Facade
//
// Logline: Destubbed Int packet-header facade. Off Float shims and fail-closed stubs.
//
// Setup: Re-exports destubbed telemetry_types only. No List[Float]. No process_exit.
//
// Beats:
//   1. Construct PacketHeader via packet_header_new.
//   2. Read apid and seq through facade getters.
// residual: engine/stubs/Float shims destubbed; this is the Int header floor.

import "./telemetry_types.oo";

pub fn telemetry_header_new(apid: Int, seq: Int, len: Int) -> PacketHeader {
    return packet_header_new(apid, seq, len);
}

pub fn telemetry_header_apid(h: PacketHeader) -> Int {
    return packet_header_apid(h);
}

pub fn telemetry_header_seq(h: PacketHeader) -> Int {
    return packet_header_seq(h);
}

pub fn telemetry_header_len(h: PacketHeader) -> Int {
    return packet_header_len(h);
}
