// # Formation Safety, Proximity, and Control Error
//
// Logline: Computes relative distance and speed, minimum approach distance, keep-out safety, and tracking control error.
//
// Setup: Imports the formation engine for Vec3, RelativeState, hcw_propagate, FormationSafety, FormationControlState.
//
// Beats:
//   1. Compute relative distance and speed between two relative states.
//   2. Sample the minimum approach distance over a propagation window.
//   3. Evaluate keep-out sphere safety and tracking control error.

import "./formation_engine.oo";

/// Compute relative distance between two relative states
pub fn relative_distance(s1: RelativeState, s2: RelativeState) -> Float {
    let p1: Vec3 = (s1).position;
    let p2: Vec3 = (s2).position;
    let dr: Vec3 = vec3_sub(p1, p2);
    return vec3_length(dr);
}

/// Compute relative speed between two relative states
pub fn relative_speed(s1: RelativeState, s2: RelativeState) -> Float {
    let v1: Vec3 = (s1).velocity;
    let v2: Vec3 = (s2).velocity;
    let dv: Vec3 = vec3_sub(v1, v2);
    return vec3_length(dv);
}

/// Minimum approach distance over propagation duration using discrete sampling
pub fn formation_minimum_distance(state0: RelativeState, n_mean: Float, duration: Float, steps: Int) -> Float {
    let p0: Vec3 = (state0).position;
    if steps <= 0 {
        return vec3_length(p0);
    }
    let steps_f: Float = int_to_float(steps);
    let dt_step: Float = duration / steps_f;
    let mut min_dist: Float = vec3_length(p0);
    let mut i: Int = 0;

    while i <= steps {
        let t_curr: Float = int_to_float(i) * dt_step;
        let s_t: RelativeState = hcw_propagate(state0, n_mean, t_curr);
        let pt: Vec3 = (s_t).position;
        let dist_t: Float = vec3_length(pt);
        if dist_t < min_dist {
            min_dist = dist_t;
        }
        i = i + 1;
    }
    return min_dist;
}

/// Check proximity safety and keep-out sphere violation
pub fn check_formation_safety(state0: RelativeState, n_mean: Float, min_safe_dist: Float, duration: Float) -> FormationSafety {
    let min_dist: Float = formation_minimum_distance(state0, n_mean, duration, 20);
    let is_violated: Bool = min_dist < min_safe_dist;
    let is_safe: Bool = min_dist >= min_safe_dist;

    return FormationSafety {
        min_approach_distance: min_dist,
        collision_warning: is_violated,
        keep_out_sphere_radius: min_safe_dist,
        is_pass_safe: is_safe
    };
}

/// Compute tracking control error between current and target relative states
pub fn formation_control_error(current: RelativeState, target: RelativeState) -> FormationControlState {
    let cp: Vec3 = (current).position;
    let tp: Vec3 = (target).position;
    let cv: Vec3 = (current).velocity;
    let tv: Vec3 = (target).velocity;
    let pos_err: Vec3 = vec3_sub(cp, tp);
    let vel_err: Vec3 = vec3_sub(cv, tv);
    let pos_mag: Float = vec3_length(pos_err);
    let vel_mag: Float = vec3_length(vel_err);

    return FormationControlState {
        target_state: target,
        current_state: current,
        position_error: pos_err,
        velocity_error: vel_err,
        total_pos_error_mag: pos_mag,
        total_vel_error_mag: vel_mag
    };
}
