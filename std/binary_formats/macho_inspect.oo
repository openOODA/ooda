// # Mach-O 64 header inspector
//
// Logline: Parses a Mach-O 64-bit header and counts LC_SEGMENT_64, LC_MAIN, LC_SYMTAB, and LC_DYLD_INFO load commands.
//
// Setup: Pure. Little-endian. Magic 4277009103 is MH_MAGIC_64.
//
// Beats:
//   1. Check MH_MAGIC_64 and read cpu, filetype, ncmds, sizeofcmds.
//   2. Walk load commands by cmd and cmdsize.
//   3. Count LC_SEGMENT_64 (25), LC_SYMTAB (2), LC_DYLD_INFO (34), LC_MAIN (2147483688).
//   4. Refuse a truncated command list.

pub fn macho_inspect_magic() -> Int { return 4277009103; }

fn macho_inspect_u32(b: List[Int], o: Int) -> Int {
    return list_get(b, o) + list_get(b, o + 1) * 256 + list_get(b, o + 2) * 65536 + list_get(b, o + 3) * 16777216;
}

pub fn macho_inspect_header(b: List[Int]) -> Result[List[Int], String] {
    if list_len(b) < 32 { return Err("macho header short"); }
    let mag: Int = macho_inspect_u32(b, 0);
    if mag != macho_inspect_magic() { return Err("macho magic"); }
    let mut rec: List[Int] = list_new();
    rec = list_push(rec, mag);
    rec = list_push(rec, macho_inspect_u32(b, 4));
    rec = list_push(rec, macho_inspect_u32(b, 12));
    rec = list_push(rec, macho_inspect_u32(b, 16));
    rec = list_push(rec, macho_inspect_u32(b, 20));
    return Ok(rec);
}

pub fn macho_inspect_loadcmds(b: List[Int]) -> Result[List[Int], String] {
    let hr: Result[List[Int], String] = macho_inspect_header(b);
    match hr {
        Ok(h) => {
            let ncmds: Int = list_get(h, 3);
            let sizeofcmds: Int = list_get(h, 4);
            let mut pos: Int = 32;
            let end: Int = 32 + sizeofcmds;
            let mut seg: Int = 0;
            let mut sym: Int = 0;
            let mut dyld: Int = 0;
            let mut mainc: Int = 0;
            let mut i: Int = 0;
            while i < ncmds {
                if pos + 8 > list_len(b) { return Err("macho cmd short"); }
                if pos + 8 > end { return Err("macho cmds overrun"); }
                let cmd: Int = macho_inspect_u32(b, pos);
                let cmdsize: Int = macho_inspect_u32(b, pos + 4);
                if cmdsize < 8 { return Err("macho cmdsize"); }
                if cmd == 25 { seg = seg + 1; }
                if cmd == 2 { sym = sym + 1; }
                if cmd == 34 { dyld = dyld + 1; }
                if cmd == 2147483688 { mainc = mainc + 1; }
                pos = pos + cmdsize;
                i = i + 1;
            }
            let mut rec: List[Int] = list_new();
            rec = list_push(rec, seg);
            rec = list_push(rec, mainc);
            rec = list_push(rec, sym);
            rec = list_push(rec, dyld);
            return Ok(rec);
        },
        Err(e) => { return Err(e); }
    }
}
