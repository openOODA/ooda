// # WebAssembly binary inspector
//
// Logline: Walks a WASM module magic, version, section IDs, and LEB128 payload sizes for Type, Import, Function, Table, Memory, Export, and Code.
//
// Setup: Pure. Bytes are List[Int]. Magic is 0,97,115,109. Version 1.
//
// Beats:
//   1. Check magic and version.
//   2. Decode unsigned LEB128 section sizes.
//   3. Record which of Type/Import/Function/Table/Memory/Export/Code appear.
//   4. Refuse a size that runs past the buffer.

fn wasm_inspect_leb(b: List[Int], start: Int) -> Result[List[Int], String] {
    let mut val: Int = 0;
    let mut shift: Int = 0;
    let mut pos: Int = start;
    let mut k: Int = 0;
    while k < 5 {
        if pos >= list_len(b) { return Err("wasm leb short"); }
        let by: Int = list_get(b, pos);
        pos = pos + 1;
        val = val + (by & 127) * (1 << shift);
        if (by & 128) == 0 {
            let mut rec: List[Int] = list_new();
            rec = list_push(rec, val);
            rec = list_push(rec, pos);
            return Ok(rec);
        }
        shift = shift + 7;
        k = k + 1;
    }
    return Err("wasm leb overlong");
}

pub fn wasm_inspect_header(b: List[Int]) -> Result[Bool, String] {
    if list_len(b) < 8 { return Err("wasm header short"); }
    if list_get(b, 0) != 0 { return Ok(false); }
    if list_get(b, 1) != 97 { return Ok(false); }
    if list_get(b, 2) != 115 { return Ok(false); }
    if list_get(b, 3) != 109 { return Ok(false); }
    if list_get(b, 4) != 1 { return Ok(false); }
    if list_get(b, 5) != 0 { return Ok(false); }
    if list_get(b, 6) != 0 { return Ok(false); }
    if list_get(b, 7) != 0 { return Ok(false); }
    return Ok(true);
}

pub fn wasm_inspect_sections(b: List[Int]) -> Result[List[Int], String] {
    let hr: Result[Bool, String] = wasm_inspect_header(b);
    match hr {
        Ok(ok) => {
            if ok == false { return Err("wasm magic"); }
            let mut seen: List[Int] = list_new();
            let mut t: Int = 0;
            while t < 12 {
                seen = list_push(seen, 0);
                t = t + 1;
            }
            let mut pos: Int = 8;
            while pos < list_len(b) {
                let id: Int = list_get(b, pos);
                pos = pos + 1;
                let lr: Result[List[Int], String] = wasm_inspect_leb(b, pos);
                match lr {
                    Ok(v) => {
                        let sz: Int = list_get(v, 0);
                        pos = list_get(v, 1);
                        if pos + sz > list_len(b) { return Err("wasm section size"); }
                        if id >= 0 {
                            if id < 12 { seen = list_set(seen, id, 1); }
                        }
                        pos = pos + sz;
                    },
                    Err(e) => { return Err(e); }
                }
            }
            return Ok(seen);
        },
        Err(e) => { return Err(e); }
    }
}
