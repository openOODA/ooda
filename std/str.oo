// # String helpers
//
// Logline: Thin wrappers publish the CHS string surface Backend-C lowers.
//
// Setup: This module is pure: no FS, net, or env. Callers import this file.
//
// Beats:
//   1. Length, empty, equality, contains, concat, char_at, and slice wrap runtime names.
//   2. starts_with, ends_with, index_of, repeat, and to_uppercase wrap owned free names.
//   3. str_replace walks owned slices and swaps every occurrence of old for new.
//   4. parse_int folds a leading "-" and ASCII digits 0-9 into Int (v*10+n).
//
// residual: no UTF-8 edge APIs beyond runtime; no ambient I/O
// residual: NOT true &str borrow / lifetimes — owned String only (Path A)
// residual: decimal ASCII only; no overflow check

// Character length (UTF-8 scalar count on runtime).
pub fn str_len(s: String) -> Int {
    return s.len();
}

// True when length is zero.
pub fn str_is_empty(s: String) -> Bool {
    return s.len() == 0;
}

// Equality.
pub fn str_eq(a: String, b: String) -> Bool {
    return a == b;
}

// Substring search.
pub fn str_contains(s: String, sub: String) -> Bool {
    return s.contains(sub);
}

// Concatenation.
pub fn str_concat(a: String, b: String) -> String {
    return a + b;
}

// Character at index (free builtin lower).
pub fn str_char_at(s: String, i: Int) -> String {
    return char_at(s, i);
}

// Slice [start, end) via free builtin str_slice (name avoids recursion).
pub fn str_sub(s: String, start: Int, end: Int) -> String {
    return str_slice(s, start, end);
}

// M165 path A free-name wrappers (owned; byte-index search; not &str).
pub fn starts_with(s: String, pre: String) -> Bool {
    return str_starts_with(s, pre);
}

pub fn ends_with(s: String, suf: String) -> Bool {
    return str_ends_with(s, suf);
}

// Byte index of first sub, or -1 if missing (not char index).
pub fn index_of(s: String, sub: String) -> Int {
    return str_index_of(s, sub);
}

// Repeat s n times (runtime caps n<=1024 and len*n safety).
pub fn repeat(s: String, n: Int) -> String {
    return str_repeat(s, n);
}

// ASCII uppercase owned copy. Lowercase remains method: s.to_lowercase().
pub fn to_uppercase(s: String) -> String {
    return str_to_uppercase(s);
}



// Replace all occurrences of old with new.
pub fn str_replace(s: String, old: String, new: String) -> String {
    let old_len: Int = chars_len(old);
    if old_len == 0 {
        return s;
    }
    
    let mut out = "";
    let mut current = s;
    
    while true {
        let mut idx: Int = 0;
        idx = str_index_of(current, old);
        if idx < 0 {
            out = out + current;
            break;
        } else {
            out = out + str_slice(current, 0, idx) + new;
            let cur_len: Int = chars_len(current);
            current = str_slice(current, idx + old_len, cur_len);
        }
    }
    return out;
}

// Signed decimal text to Int. Digit fold only; do not call parse_int (recursion).
pub fn parse_int(s: String) -> Int {
    let n = chars_len(s);
    let mut v = 0;
    let mut i = 0;
    let mut sign = 1;
    if n > 0 {
        if char_at(s, 0) == "-" {
            sign = -1;
            i = 1;
        }
    }
    while i < n {
        let c = char_at(s, i);
        if c == "0" { v = v * 10 + 0; }
        else if c == "1" { v = v * 10 + 1; }
        else if c == "2" { v = v * 10 + 2; }
        else if c == "3" { v = v * 10 + 3; }
        else if c == "4" { v = v * 10 + 4; }
        else if c == "5" { v = v * 10 + 5; }
        else if c == "6" { v = v * 10 + 6; }
        else if c == "7" { v = v * 10 + 7; }
        else if c == "8" { v = v * 10 + 8; }
        else if c == "9" { v = v * 10 + 9; }
        i = i + 1;
    }
    return v * sign;
}

