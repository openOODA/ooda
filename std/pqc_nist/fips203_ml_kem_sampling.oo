// # FIPS 203 ML-KEM Noise & Rejection Sampling
//
// Logline: Implements uniform rejection sampling (Parse) and Centered Binomial Distribution (CBD_eta) sampling for ML-KEM.
//
// Setup: Imports fips203_ml_kem_poly.oo.
//
// Beats:
//   1. Implement Parse uniform rejection sampling from PRF byte streams into R_q.
//   2. Implement CBD_eta1 and CBD_eta2 constant-time sampling.
//   3. Provide polynomial vector sampling utilities.

import "./fips203_ml_kem_poly.oo";

pub type MlKemSampler = struct {
    seed: Int,
    counter: Int
};

pub fn ml_kem_sampler_new(seed: Int) -> MlKemSampler {
    return MlKemSampler {
        seed: seed,
        counter: 0
    };
}

pub fn ml_kem_sample_cbd2(bytes: List[Int]) -> MlKemPoly {
    let mut coeffs: List[Int] = list_new();
    let num_bytes: Int = list_len(bytes);
    let mut i: Int = 0;
    while i < 256 {
        let byte_idx: Int = (i / 2) % num_bytes;
        let b: Int = list_get(bytes, byte_idx);
        let shift: Int = (i % 2) * 4;
        let t: Int = (b >> shift) & 15;
        let a0: Int = t & 1;
        let a1: Int = (t >> 1) & 1;
        let b0: Int = (t >> 2) & 1;
        let b1: Int = (t >> 3) & 1;
        let diff: Int = (a0 + a1) - (b0 + b1);
        let c: Int = (diff + 3329) % 3329;
        coeffs = list_push(coeffs, c);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: coeffs,
        degree: 256,
        modulus: 3329
    };
}

pub fn ml_kem_sample_cbd3(bytes: List[Int]) -> MlKemPoly {
    let mut coeffs: List[Int] = list_new();
    let num_bytes: Int = list_len(bytes);
    let mut i: Int = 0;
    while i < 256 {
        let b0: Int = list_get(bytes, (3 * i / 4) % num_bytes);
        let b1: Int = list_get(bytes, ((3 * i / 4) + 1) % num_bytes);
        let mut bits_a: Int = 0;
        let mut bits_b: Int = 0;
        let mut j: Int = 0;
        while j < 3 {
            let bit_a: Int = (b0 >> (j * 2)) & 1;
            let bit_b: Int = (b1 >> (j * 2)) & 1;
            bits_a = bits_a + bit_a;
            bits_b = bits_b + bit_b;
            j = j + 1;
        }
        let diff: Int = bits_a - bits_b;
        let c: Int = (diff + 3329) % 3329;
        coeffs = list_push(coeffs, c);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: coeffs,
        degree: 256,
        modulus: 3329
    };
}

pub fn ml_kem_sample_uniform(seed_bytes: List[Int]) -> MlKemPoly {
    let mut coeffs: List[Int] = list_new();
    let num_bytes: Int = list_len(seed_bytes);
    let mut i: Int = 0;
    let mut byte_pos: Int = 0;
    while i < 256 {
        let b0: Int = list_get(seed_bytes, byte_pos % num_bytes);
        let b1: Int = list_get(seed_bytes, (byte_pos + 1) % num_bytes);
        let val: Int = b0 | ((b1 & 15) << 8);
        byte_pos = byte_pos + 2;
        if val < 3329 {
            coeffs = list_push(coeffs, val);
            i = i + 1;
        }
    }
    return MlKemPoly {
        coeffs: coeffs,
        degree: 256,
        modulus: 3329
    };
}
