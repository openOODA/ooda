// # FIPS 203 ML-KEM Parameter Configurations
//
// Logline: Defines standard security parameters and dimension sets for ML-KEM-512, ML-KEM-768, and ML-KEM-1024.
//
// Setup: FIPS 203 / NIST SP 800 standard parameter sets for Module-Lattice-based Key Encapsulation.
//
// Beats:
//   1. Define parameter set configuration record.
//   2. Provide constructors for ML-KEM-512, ML-KEM-768, and ML-KEM-1024.
//   3. Implement parameter query and serialization size calculators.

pub type MlKemParams = struct {
    name: String,
    k: Int,
    q: Int,
    eta1: Int,
    eta2: Int,
    du: Int,
    dv: Int,
    pk_size: Int,
    sk_size: Int,
    ct_size: Int,
    ss_size: Int,
};

pub fn ml_kem_params_512() -> MlKemParams {
    return MlKemParams {
        name: "ML-KEM-512",
        k: 2,
        q: 3329,
        eta1: 3,
        eta2: 2,
        du: 10,
        dv: 4,
        pk_size: 800,
        sk_size: 1632,
        ct_size: 768,
        ss_size: 32,
    };
}

pub fn ml_kem_params_768() -> MlKemParams {
    return MlKemParams {
        name: "ML-KEM-768",
        k: 3,
        q: 3329,
        eta1: 2,
        eta2: 2,
        du: 10,
        dv: 4,
        pk_size: 1184,
        sk_size: 2400,
        ct_size: 1088,
        ss_size: 32,
    };
}

pub fn ml_kem_params_1024() -> MlKemParams {
    return MlKemParams {
        name: "ML-KEM-1024",
        k: 4,
        q: 3329,
        eta1: 2,
        eta2: 2,
        du: 11,
        dv: 5,
        pk_size: 1568,
        sk_size: 3168,
        ct_size: 1568,
        ss_size: 32,
    };
}

pub fn ml_kem_params_by_k(k: Int) -> MlKemParams {
    if k == 2 {
        return ml_kem_params_512();
    }
    if k == 4 {
        return ml_kem_params_1024();
    }
    return ml_kem_params_768();
}

pub fn ml_kem_params_security_category(params: &MlKemParams) -> Int {
    if params.k == 2 {
        return 1;
    }
    if params.k == 3 {
        return 3;
    }
    if params.k == 4 {
        return 5;
    }
    return 0;
}
