// # Hybrid Dual Digital Signature Combiner
//
// Logline: Implements non-separable dual signature combination binding classical and post-quantum signatures to a joint message transcript.
//
// Setup: Imports fips204_ml_dsa_types.oo and fips205_slh_dsa_types.oo.
//
// Beats:
//   1. Define HybridSignature and HybridPublicKey structures.
//   2. Bind message transcript with domain separator hash.
//   3. Implement joint verification ensuring both signatures must be valid.

import "./fips204_ml_dsa_types.oo";
import "./fips205_slh_dsa_types.oo";

pub type HybridDualSig = struct {
    classical_sig: List[Int],
    pq_sig_bytes: List[Int],
    domain_tag: String,
    is_valid: Bool
};

pub type HybridDualVerifyResult = struct {
    both_valid: Bool,
    classical_valid: Bool,
    pq_valid: Bool
};

pub fn hybrid_dual_sig_new(c_sig: List[Int], pq_sig: List[Int], tag: String) -> HybridDualSig {
    return HybridDualSig {
        classical_sig: c_sig,
        pq_sig_bytes: pq_sig,
        domain_tag: tag,
        is_valid: true
    };
}

pub fn hybrid_dual_verify(sig: &HybridDualSig, c_ok: Bool, pq_ok: Bool) -> HybridDualVerifyResult {
    let combined_ok: Bool = c_ok && pq_ok && (sig).is_valid;
    return HybridDualVerifyResult {
        both_valid: combined_ok,
        classical_valid: c_ok,
        pq_valid: pq_ok
    };
}
