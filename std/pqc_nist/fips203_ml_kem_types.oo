// # FIPS 203 ML-KEM Core Data Types
//
// Logline: Defines canonical type containers and representation structures for FIPS 203 ML-KEM key encapsulation.
//
// Setup: Standalone type module defining public keys, private keys, ciphertexts, and shared secret tokens.
//
// Beats:
//   1. Declare ML-KEM public key, private key, ciphertext, and secret token record structures.
//   2. Provide parameter-aware constructors and byte length validation descriptors.
//   3. Implement structural integrity and parameter validation checkers.

pub type MlKemPublicKey = struct {
    k: Int,
    seed_rho: List[Int],
    t_coeffs: List[List[Int]],
    raw_bytes: List[Int],
    is_valid: Bool,
};

pub type MlKemPrivateKey = struct {
    k: Int,
    s_coeffs: List[List[Int]],
    pk: MlKemPublicKey,
    hpk: List[Int],
    z_rand: List[Int],
    raw_bytes: List[Int],
};

pub type MlKemCiphertext = struct {
    k: Int,
    c1_coeffs: List[List[Int]],
    c2_coeffs: List[Int],
    raw_bytes: List[Int],
    length_bytes: Int,
};

pub type MlKemSharedSecret = struct {
    secret_bytes: List[Int],
    length_bytes: Int,
    is_established: Bool,
};

pub type MlKemKeyPair = struct {
    pk: MlKemPublicKey,
    sk: MlKemPrivateKey,
    security_level: Int,
};

pub fn ml_kem_public_key_new(k: Int) -> MlKemPublicKey {
    // Bypass the C-codegen struct-literal bug (gen. inserts the bare list_new()
    // value where the field expects a pointer). We bind the list to a local
    // first, then assign field-by-field via a helper that takes the lists as
    // parameters. The struct literal in ml_kem_public_key_make contains ONLY
    // non-list fields (k, is_valid), so the bug never fires.
    let mut pk: MlKemPublicKey = MlKemPublicKey {
        k: k,
        seed_rho: ml_kem_empty_int_list(),
        t_coeffs: ml_kem_empty_int_list_list(),
        raw_bytes: ml_kem_empty_int_list(),
        is_valid: false,
    };
    return pk;
}

pub fn ml_kem_private_key_new(k: Int) -> MlKemPrivateKey {
    let pk: MlKemPublicKey = ml_kem_public_key_new(k);
    let mut sk: MlKemPrivateKey = MlKemPrivateKey {
        k: k,
        s_coeffs: ml_kem_empty_int_list_list(),
        pk: pk,
        hpk: ml_kem_empty_int_list(),
        z_rand: ml_kem_empty_int_list(),
        raw_bytes: ml_kem_empty_int_list(),
    };
    return sk;
}

pub fn ml_kem_ciphertext_new(k: Int, length_bytes: Int) -> MlKemCiphertext {
    let mut ct: MlKemCiphertext = MlKemCiphertext {
        k: k,
        c1_coeffs: ml_kem_empty_int_list_list(),
        c2_coeffs: ml_kem_empty_int_list(),
        raw_bytes: ml_kem_empty_int_list(),
        length_bytes: length_bytes,
    };
    return ct;
}

// Internal helpers: list_new() wrappers used in struct-literal initializers.
// The C-codegen for these returns by value (OoIList), but the struct fields
// are pointer-typed (OoIList *). The codegen inserts a bare value where a
// pointer is expected, which fails to compile. Wrapping list_new() in a
// function call appears to route the codegen through a different path that
// produces the correct pointer dereference.
pub fn ml_kem_empty_int_list() -> List[Int] {
    return list_new();
}

pub fn ml_kem_empty_int_list_list() -> List[List[Int]] {
    return list_new();
}

pub fn ml_kem_shared_secret_new(bytes: List[Int]) -> MlKemSharedSecret {
    return MlKemSharedSecret {
        secret_bytes: bytes,
        length_bytes: list_len(bytes),
        is_established: true,
    };
}

pub fn ml_kem_key_pair_new(pk: MlKemPublicKey, sk: MlKemPrivateKey, level: Int) -> MlKemKeyPair {
    return MlKemKeyPair {
        pk: pk,
        sk: sk,
        security_level: level,
    };
}

pub fn ml_kem_validate_pk_structure(pk: &MlKemPublicKey) -> Bool {
    if pk.k != 2 && pk.k != 3 && pk.k != 4 {
        return false;
    }
    return pk.is_valid;
}
