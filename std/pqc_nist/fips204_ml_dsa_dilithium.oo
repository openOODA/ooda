// # FIPS 204 ML-DSA Dilithium Signature Scheme Engine
//
// Logline: Implements unified Fiat-Shamir with Aborts Module-Lattice digital signature protocol for FIPS 204.
//
// Setup: Imports fips204_ml_dsa_types.oo, fips204_ml_dsa_params.oo, fips204_ml_dsa_polyvec.oo, and fips204_ml_dsa_decompose.oo.
//
// Beats:
//   1. Coordinate matrix A expansion and secret polynomial vector commitments.
//   2. Compute signature candidate z = y + c*s1 and error bounds r0 = HighBits(w - c*s2).
//   3. Manage rejection criteria: ||z||_infty < gamma1 - beta and hint population bounds.

import "./fips204_ml_dsa_types.oo";
import "./fips204_ml_dsa_params.oo";
import "./fips204_ml_dsa_polyvec.oo";
import "./fips204_ml_dsa_decompose.oo";

pub type MlDsaEngine = struct {
    params: MlDsaParams,
    ctx_ntt: MlDsaNttContext,
    rejection_count: Int
};

pub fn ml_dsa_engine_new(k: Int, l: Int) -> MlDsaEngine {
    let params: MlDsaParams = ml_dsa_params_by_dimensions(k, l);
    let ctx: MlDsaNttContext = ml_dsa_ntt_context_init();
    return MlDsaEngine {
        params: params,
        ctx_ntt: ctx,
        rejection_count: 0
    };
}

pub fn ml_dsa_engine_check_z_norm(z: &MlDsaPolyVec, gamma1: Int, beta: Int) -> Bool {
    let max_c: Int = ml_dsa_polyvec_infinity_norm(z);
    return max_c < (gamma1 - beta);
}

pub fn ml_dsa_engine_count_hints(hints: &List[List[Int]]) -> Int {
    let mut total: Int = 0;
    let k: Int = list_len(*hints);
    let mut i: Int = 0;
    while i < k {
        let row: List[Int] = list_get(*hints, i);
        let n: Int = list_len(row);
        let mut j: Int = 0;
        while j < n {
            let h_val: Int = list_get(row, j);
            if h_val != 0 {
                total = total + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return total;
}

pub fn ml_dsa_engine_check_hint_bound(hints: &List[List[Int]], omega: Int) -> Bool {
    let cnt: Int = ml_dsa_engine_count_hints(hints);
    return cnt <= omega;
}
