// # Cryptographic Agility & Migration Policy Manager
//
// Logline: Manages algorithm deprecation timelines, quantum migration security tiers, and dynamic cipher negotiation.
//
// Setup: Policy configuration and algorithm lifecycle state machine for PQC migration.
//
// Beats:
//   1. Define AgilityPolicy, MigrationPhase, and SecurityTier types.
//   2. Implement policy validation checking algorithm compliance with CNSA 2.0.
//   3. Implement dynamic algorithm fallback and negotiation arbitration.

pub type AgilityPolicy = struct {
    name: String,
    minimum_security_level: Int,
    allow_classical_only: Bool,
    require_hybrid: Bool,
    cnsa_2_compliant: Bool,
};

pub type MigrationState = struct {
    current_phase: String,
    primary_kem: String,
    primary_sig: String,
    policy: AgilityPolicy,
};

pub fn agility_policy_cnsa_20() -> AgilityPolicy {
    return AgilityPolicy {
        name: "CNSA-2.0",
        minimum_security_level: 5,
        allow_classical_only: false,
        require_hybrid: false,
        cnsa_2_compliant: true,
    };
}

pub fn agility_policy_transitional() -> AgilityPolicy {
    return AgilityPolicy {
        name: "Transitional-Hybrid",
        minimum_security_level: 3,
        allow_classical_only: false,
        require_hybrid: true,
        cnsa_2_compliant: false,
    };
}

pub fn migration_state_default() -> MigrationState {
    return MigrationState {
        current_phase: "HYBRID_DEPLOYMENT",
        primary_kem: "ML-KEM-768",
        primary_sig: "ML-DSA-65",
        policy: agility_policy_transitional(),
    };
}

pub fn agility_is_algorithm_allowed(algo_name: String, level: Int, policy: &AgilityPolicy) -> Bool {
    let min_lvl: Int = (policy).minimum_security_level;
    return level >= min_lvl;
}
