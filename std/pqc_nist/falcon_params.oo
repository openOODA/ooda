// # Falcon Lattice Signature Parameter Configurations
//
// Logline: Defines standard security parameters and tree dimensions for Falcon-512 and Falcon-1024.
//
// Setup: NIST Round 3 selected NTRU lattice signature standard parameters over Z_12289[X]/(X^N + 1).
//
// Beats:
//   1. Define Falcon parameter record structure.
//   2. Provide constructors for Falcon-512 and Falcon-1024.
//   3. Implement parameter query, signature bound, and l2-norm threshold calculators.

pub type FalconParams = struct {
    name: String,
    degree_n: Int,
    modulus_q: Int,
    sigma: Float,
    sig_bound: Int,
    pk_size: Int,
    sk_size: Int,
    sig_size: Int,
    is_valid: Bool
};

pub fn falcon_params_512() -> FalconParams {
    return FalconParams {
        name: "Falcon-512",
        degree_n: 512,
        modulus_q: 12289,
        sigma: 165.736613,
        sig_bound: 34034726,
        pk_size: 897,
        sk_size: 1281,
        sig_size: 690,
        is_valid: true
    };
}

pub fn falcon_params_1024() -> FalconParams {
    return FalconParams {
        name: "Falcon-1024",
        degree_n: 1024,
        modulus_q: 12289,
        sigma: 168.388571,
        sig_bound: 70265242,
        pk_size: 1793,
        sk_size: 2305,
        sig_size: 1330,
        is_valid: true
    };
}

pub fn falcon_params_by_degree(n_val: Int) -> FalconParams {
    if n_val == 1024 {
        return falcon_params_1024();
    }
    return falcon_params_512();
}

pub fn falcon_params_security_level(params: &FalconParams) -> Int {
    if params.degree_n == 512 {
        return 1;
    }
    if params.degree_n == 1024 {
        return 5;
    }
    return 0;
}
