// # FIPS 204 ML-DSA Challenge & Vector Sampling
//
// Logline: Implements SampleInBall challenge generation and bounded uniform vector sampling for ML-DSA.
//
// Setup: Imports fips204_ml_dsa_poly.oo.
//
// Beats:
//   1. Implement SampleInBall creating challenge polynomial with tau non-zero (+-1) coefficients.
//   2. Implement uniform bounded polynomial sampling for secret keys (eta) and masking vectors (gamma1).
//   3. Implement SHAKE-based pseudorandom byte unpacking for coefficients.

import "./fips204_ml_dsa_poly.oo";

pub fn ml_dsa_sample_in_ball(seed: List[Int], tau: Int) -> MlDsaPoly {
    let mut coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        coeffs = list_push(coeffs, 0);
        i = i + 1;
    }
    
    let seed_len: Int = list_len(seed);
    let mut signs: Int = 0;
    if seed_len >= 8 {
        let mut b_idx: Int = 0;
        while b_idx < 8 {
            signs = signs | (list_get(seed, b_idx) << (b_idx * 8));
            b_idx = b_idx + 1;
        }
    }
    
    let mut pos: Int = 256 - tau;
    let mut s_idx: Int = 8;
    while pos < 256 {
        let mut j: Int = pos;
        if s_idx < seed_len {
            let byte_val: Int = list_get(seed, s_idx);
            s_idx = s_idx + 1;
            j = byte_val % (pos + 1);
        }
        
        let val_at_j: Int = list_get(coeffs, j);
        let sign_bit: Int = signs & 1;
        signs = signs >> 1;
        let c_val: Int = if sign_bit == 1 { 8380416 } else { 1 };
        
        let mut new_coeffs: List[Int] = list_new();
        let mut k_idx: Int = 0;
        while k_idx < 256 {
            if k_idx == pos {
                new_coeffs = list_push(new_coeffs, val_at_j);
            } else {
                if k_idx == j {
                    new_coeffs = list_push(new_coeffs, c_val);
                } else {
                    new_coeffs = list_push(new_coeffs, list_get(coeffs, k_idx));
                }
            }
            k_idx = k_idx + 1;
        }
        coeffs = new_coeffs;
        pos = pos + 1;
    }
    
    return MlDsaPoly {
        coeffs: coeffs,
        degree: 256,
        modulus: 8380417
    };
}

pub fn ml_dsa_sample_eta(bytes: List[Int], eta: Int) -> MlDsaPoly {
    let mut coeffs: List[Int] = list_new();
    let num_bytes: Int = list_len(bytes);
    let mut i: Int = 0;
    while i < 256 {
        let b: Int = list_get(bytes, i % num_bytes);
        let mut t: Int = b % (2 * eta + 1);
        let val: Int = (t - eta + 8380417) % 8380417;
        coeffs = list_push(coeffs, val);
        i = i + 1;
    }
    return MlDsaPoly {
        coeffs: coeffs,
        degree: 256,
        modulus: 8380417
    };
}

pub fn ml_dsa_sample_mask(bytes: List[Int], gamma1: Int) -> MlDsaPoly {
    let mut coeffs: List[Int] = list_new();
    let num_bytes: Int = list_len(bytes);
    let mut i: Int = 0;
    while i < 256 {
        let b0: Int = list_get(bytes, (2 * i) % num_bytes);
        let b1: Int = list_get(bytes, (2 * i + 1) % num_bytes);
        let val24: Int = b0 | (b1 << 8);
        let mod_g: Int = val24 % (2 * gamma1);
        let val: Int = (mod_g - gamma1 + 8380417) % 8380417;
        coeffs = list_push(coeffs, val);
        i = i + 1;
    }
    return MlDsaPoly {
        coeffs: coeffs,
        degree: 256,
        modulus: 8380417
    };
}
