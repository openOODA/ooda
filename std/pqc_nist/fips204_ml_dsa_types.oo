// # FIPS 204 ML-DSA Core Data Types
//
// Logline: Defines canonical type containers and signature structures for FIPS 204 ML-DSA digital signatures.
//
// Setup: Standalone type module defining public keys, private keys, signatures, and hint vectors.
//
// Beats:
//   1. Declare ML-DSA public key, private key, signature, and hint vector structures.
//   2. Provide parameter-aware constructors and field initializers.
//   3. Implement validation and type predicate checkers.

pub type MlDsaPublicKey = struct {
    k_dim: Int,
    l_dim: Int,
    seed_rho: List[Int],
    t1_coeffs: List[List[Int]],
    raw_bytes: List[Int],
    is_valid: Bool,
};

pub type MlDsaPrivateKey = struct {
    k_dim: Int,
    l_dim: Int,
    seed_rho: List[Int],
    seed_k: List[Int],
    tr: List[Int],
    s1_coeffs: List[List[Int]],
    s2_coeffs: List[List[Int]],
    t0_coeffs: List[List[Int]],
    pk: MlDsaPublicKey,
};

pub type MlDsaSignature = struct {
    c_tilde: List[Int],
    z_coeffs: List[List[Int]],
    hint_bits: List[List[Int]],
    raw_bytes: List[Int],
    length_bytes: Int,
};

pub type MlDsaKeyPair = struct {
    pk: MlDsaPublicKey,
    sk: MlDsaPrivateKey,
    security_level: Int,
};

pub type MlDsaVerificationResult = struct {
    is_valid: Bool,
    error_code: Int,
    message_digest: List[Int],
};

pub fn ml_dsa_public_key_new(k: Int, l: Int) -> MlDsaPublicKey {
    return MlDsaPublicKey {
        k_dim: k,
        l_dim: l,
        seed_rho: list_new(),
        t1_coeffs: list_new(),
        raw_bytes: list_new(),
        is_valid: false,
    };
}

pub fn ml_dsa_private_key_new(k: Int, l: Int) -> MlDsaPrivateKey {
    let empty_pk: MlDsaPublicKey = ml_dsa_public_key_new(k, l);
    return MlDsaPrivateKey {
        k_dim: k,
        l_dim: l,
        seed_rho: list_new(),
        seed_k: list_new(),
        tr: list_new(),
        s1_coeffs: list_new(),
        s2_coeffs: list_new(),
        t0_coeffs: list_new(),
        pk: empty_pk,
    };
}

pub fn ml_dsa_signature_new(len_bytes: Int) -> MlDsaSignature {
    return MlDsaSignature {
        c_tilde: list_new(),
        z_coeffs: list_new(),
        hint_bits: list_new(),
        raw_bytes: list_new(),
        length_bytes: len_bytes,
    };
}

pub fn ml_dsa_key_pair_new(pk: MlDsaPublicKey, sk: MlDsaPrivateKey, level: Int) -> MlDsaKeyPair {
    return MlDsaKeyPair {
        pk: pk,
        sk: sk,
        security_level: level,
    };
}

pub fn ml_dsa_verification_result_ok(digest: List[Int]) -> MlDsaVerificationResult {
    return MlDsaVerificationResult {
        is_valid: true,
        error_code: 0,
        message_digest: digest,
    };
}

pub fn ml_dsa_verification_result_err(code: Int) -> MlDsaVerificationResult {
    return MlDsaVerificationResult {
        is_valid: false,
        error_code: code,
        message_digest: list_new(),
    };
}
