// # TLS 1.3 Post-Quantum Hybrid Key Exchange
//
// Logline: Implements TLS 1.3 KeyShare and NamedGroup negotiation for SecP256r1MLKEM768 and X25519MLKEM768 hybrid groups.
//
// Setup: Standalone protocol serializer and key share negotiator for TLS 1.3 PQ extensions.
//
// Beats:
//   1. Define TLS PQ NamedGroup identifiers (0x11ec for X25519MLKEM768, 0x11ed for SecP256r1MLKEM768).
//   2. Implement ClientHello KeyShare extension encoder and parser.
//   3. Implement ServerHello KeyShare encapsulation response handler.

pub type TlsPqNamedGroup = struct {
    group_id: Int,
    group_name: String,
    classical_share_bytes: Int,
    kem_share_bytes: Int
};

pub type TlsKeyShareClient = struct {
    group: TlsPqNamedGroup,
    classical_share: List[Int],
    kem_public_key: List[Int]
};

pub type TlsKeyShareServer = struct {
    group_id: Int,
    classical_ephemeral: List[Int],
    kem_ciphertext: List[Int]
};

pub fn tls_group_x25519_mlkem768() -> TlsPqNamedGroup {
    return TlsPqNamedGroup {
        group_id: 4588,
        group_name: "X25519MLKEM768",
        classical_share_bytes: 32,
        kem_share_bytes: 1184
    };
}

pub fn tls_group_secp256r1_mlkem768() -> TlsPqNamedGroup {
    return TlsPqNamedGroup {
        group_id: 4589,
        group_name: "SecP256r1MLKEM768",
        classical_share_bytes: 65,
        kem_share_bytes: 1184
    };
}

pub fn tls_keyshare_client_new(group: TlsPqNamedGroup, c_share: List[Int], kem_pk: List[Int]) -> TlsKeyShareClient {
    return TlsKeyShareClient {
        group: group,
        classical_share: c_share,
        kem_public_key: kem_pk
    };
}

pub fn tls_keyshare_server_new(group_id: Int, c_eph: List[Int], ct: List[Int]) -> TlsKeyShareServer {
    return TlsKeyShareServer {
        group_id: group_id,
        classical_ephemeral: c_eph,
        kem_ciphertext: ct
    };
}
