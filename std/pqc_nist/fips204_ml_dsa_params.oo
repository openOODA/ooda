// # FIPS 204 ML-DSA Parameter Configurations
//
// Logline: Defines standard security parameters and dimension sets for ML-DSA-44, ML-DSA-65, and ML-DSA-87.
//
// Setup: FIPS 204 / NIST SP 800 standard parameter sets for Module-Lattice-based Digital Signature Algorithm.
//
// Beats:
//   1. Define parameter set configuration record for ML-DSA.
//   2. Provide constructors for ML-DSA-44, ML-DSA-65, and ML-DSA-87.
//   3. Implement parameter query, security level mappings, and bound estimators.

pub type MlDsaParams = struct {
    name: String,
    k: Int,
    l: Int,
    q: Int,
    d: Int,
    tau: Int,
    lambda_bits: Int,
    gamma1: Int,
    gamma2: Int,
    beta: Int,
    omega: Int,
    pk_size: Int,
    sk_size: Int,
    sig_size: Int,
};

pub fn ml_dsa_params_44() -> MlDsaParams {
    return MlDsaParams {
        name: "ML-DSA-44",
        k: 4,
        l: 4,
        q: 8380417,
        d: 13,
        tau: 39,
        lambda_bits: 128,
        gamma1: 131072,
        gamma2: 95232,
        beta: 78,
        omega: 80,
        pk_size: 1312,
        sk_size: 2560,
        sig_size: 2420,
    };
}

pub fn ml_dsa_params_65() -> MlDsaParams {
    return MlDsaParams {
        name: "ML-DSA-65",
        k: 6,
        l: 5,
        q: 8380417,
        d: 13,
        tau: 49,
        lambda_bits: 192,
        gamma1: 524288,
        gamma2: 261888,
        beta: 196,
        omega: 55,
        pk_size: 1952,
        sk_size: 4032,
        sig_size: 3309,
    };
}

pub fn ml_dsa_params_87() -> MlDsaParams {
    return MlDsaParams {
        name: "ML-DSA-87",
        k: 8,
        l: 7,
        q: 8380417,
        d: 13,
        tau: 60,
        lambda_bits: 256,
        gamma1: 524288,
        gamma2: 261888,
        beta: 120,
        omega: 75,
        pk_size: 2592,
        sk_size: 4896,
        sig_size: 4627,
    };
}

pub fn ml_dsa_params_by_dimensions(k: Int, l: Int) -> MlDsaParams {
    if k == 4 && l == 4 {
        return ml_dsa_params_44();
    }
    if k == 8 && l == 7 {
        return ml_dsa_params_87();
    }
    return ml_dsa_params_65();
}

pub fn ml_dsa_params_security_category(params: &MlDsaParams) -> Int {
    if params.k == 4 {
        return 2;
    }
    if params.k == 6 {
        return 3;
    }
    if params.k == 8 {
        return 5;
    }
    return 0;
}
