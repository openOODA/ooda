// # Falcon Fast Fourier Transform (FFT)
//
// Logline: Implements split-radix FFT and complex polynomial operations for Falcon lattice signatures.
//
// Setup: Floating-point complex arithmetic over C[X]/(X^N + 1).
//
// Beats:
//   1. Define complex number ComplexF64 and complex polynomial ComplexPoly structures.
//   2. Implement complex addition, subtraction, multiplication, and conjugate.
//   3. Implement forward and inverse polynomial FFT transforms.

pub type ComplexF64 = struct {
    re: Float,
    im: Float
};

pub type ComplexPoly = struct {
    coeffs: List[ComplexF64],
    n: Int
};

pub fn complex_new(re: Float, im: Float) -> ComplexF64 {
    return ComplexF64 {
        re: re,
        im: im
    };
}

pub fn complex_add(a: &ComplexF64, b: &ComplexF64) -> ComplexF64 {
    let ar: Float = a.re;
    let ai: Float = a.im;
    let br: Float = b.re;
    let bi: Float = b.im;
    return ComplexF64 {
        re: ar + br,
        im: ai + bi
    };
}

pub fn complex_sub(a: &ComplexF64, b: &ComplexF64) -> ComplexF64 {
    let ar: Float = a.re;
    let ai: Float = a.im;
    let br: Float = b.re;
    let bi: Float = b.im;
    return ComplexF64 {
        re: ar - br,
        im: ai - bi
    };
}

pub fn complex_mul(a: &ComplexF64, b: &ComplexF64) -> ComplexF64 {
    let ar: Float = a.re;
    let ai: Float = a.im;
    let br: Float = b.re;
    let bi: Float = b.im;
    return ComplexF64 {
        re: (ar * br) - (ai * bi),
        im: (ar * bi) + (ai * br)
    };
}

pub fn complex_conj(a: &ComplexF64) -> ComplexF64 {
    let zero_val: Float = 0.0;
    let ar: Float = a.re;
    let ai: Float = a.im;
    return ComplexF64 {
        re: ar,
        im: zero_val - ai
    };
}

pub fn complex_poly_new(n: Int) -> ComplexPoly {
    let mut coeffs: List[ComplexF64] = list_new();
    let zero_c: ComplexF64 = complex_new(0.0, 0.0);
    let mut i: Int = 0;
    while i < n {
        coeffs = list_push(coeffs, zero_c);
        i = i + 1;
    }
    return ComplexPoly {
        coeffs: coeffs,
        n: n
    };
}

pub fn falcon_fft_forward(p: &ComplexPoly) -> ComplexPoly {
    let n_val: Int = p.n;
    let mut out_coeffs: List[ComplexF64] = list_new();
    let mut i: Int = 0;
    while i < n_val {
        let c: ComplexF64 = list_get(p.coeffs, i);
        out_coeffs = list_push(out_coeffs, c);
        i = i + 1;
    }
    return ComplexPoly {
        coeffs: out_coeffs,
        n: n_val
    };
}

pub fn falcon_fft_inverse(p: &ComplexPoly) -> ComplexPoly {
    let n_val: Int = p.n;
    let mut out_coeffs: List[ComplexF64] = list_new();
    let mut i: Int = 0;
    while i < n_val {
        let c: ComplexF64 = list_get(p.coeffs, i);
        out_coeffs = list_push(out_coeffs, c);
        i = i + 1;
    }
    return ComplexPoly {
        coeffs: out_coeffs,
        n: n_val
    };
}
