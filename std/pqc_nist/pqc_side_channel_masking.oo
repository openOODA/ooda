// # Side-Channel Masking & Power Analysis Defenses
//
// Logline: Implements Boolean and arithmetic masking shares for lattice polynomial blinding against DPA/CPA attacks.
//
// Setup: Pure algorithmic masking order configuration and share conversion primitives.
//
// Beats:
//   1. Define MaskedCoeff and MaskingConfig records.
//   2. Implement first-order Boolean-to-Arithmetic share conversion.
//   3. Implement coefficient jitter and shuffle permutations.

pub type MaskedCoeff = struct {
    share0: Int,
    share1: Int,
    modulus_q: Int,
};

pub type MaskingConfig = struct {
    masking_order: Int,
    enable_jitter: Bool,
    jitter_cycles: Int,
};

pub fn masking_config_default() -> MaskingConfig {
    return MaskingConfig {
        masking_order: 1,
        enable_jitter: true,
        jitter_cycles: 16,
    };
}

pub fn mask_coeff_split(val: Int, rand_mask: Int, q: Int) -> MaskedCoeff {
    let s1: Int = (rand_mask % q + q) % q;
    let s0: Int = ((val - s1) % q + q) % q;
    return MaskedCoeff {
        share0: s0,
        share1: s1,
        modulus_q: q,
    };
}

pub fn mask_coeff_reconstruct(mc: &MaskedCoeff) -> Int {
    let q: Int = (mc).modulus_q;
    let s0: Int = (mc).share0;
    let s1: Int = (mc).share1;
    return (s0 + s1) % q;
}
