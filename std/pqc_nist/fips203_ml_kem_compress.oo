// # FIPS 203 ML-KEM Compression & Decompression
//
// Logline: Implements Compress_d and Decompress_d lossy coefficient encodings for ML-KEM ciphertexts.
//
// Setup: Imports fips203_ml_kem_poly.oo.
//
// Beats:
//   1. Implement scalar Compress_d and Decompress_d algorithms.
//   2. Implement polynomial-level coefficient compression.
//   3. Implement byte packing and unpacking for compressed coefficient streams.

import "./fips203_ml_kem_poly.oo";

pub fn ml_kem_compress_coeff(x: Int, d: Int) -> Int {
    let q: Int = 3329;
    let two_pow_d: Int = 1 << d;
    let div_val: Int = ((x << d) + (q / 2)) / q;
    return div_val & (two_pow_d - 1);
}

pub fn ml_kem_decompress_coeff(y: Int, d: Int) -> Int {
    let q: Int = 3329;
    let div_val: Int = ((y * q) + (1 << (d - 1))) >> d;
    return div_val % q;
}

pub fn ml_kem_poly_compress(p: &MlKemPoly, d: Int) -> List[Int] {
    let mut compressed: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let coeff: Int = list_get(p.coeffs, i);
        let comp: Int = ml_kem_compress_coeff(coeff, d);
        compressed = list_push(compressed, comp);
        i = i + 1;
    }
    return compressed;
}

pub fn ml_kem_poly_decompress(compressed: List[Int], d: Int) -> MlKemPoly {
    let mut coeffs: List[Int] = list_new();
    let count: Int = list_len(compressed);
    let mut i: Int = 0;
    while i < 256 {
        let val: Int = if i < count { list_get(compressed, i) } else { 0 };
        let decomp: Int = ml_kem_decompress_coeff(val, d);
        coeffs = list_push(coeffs, decomp);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: coeffs,
        degree: 256,
        modulus: 3329
    };
}

pub fn ml_kem_poly_compress_to_bytes(p: &MlKemPoly, d: Int) -> List[Int] {
    let comp_coeffs: List[Int] = ml_kem_poly_compress(p, d);
    let mut bytes: List[Int] = list_new();
    let mut i: Int = 0;
    let total_bits: Int = 256 * d;
    let total_bytes: Int = (total_bits + 7) / 8;
    while i < total_bytes {
        let c_idx: Int = (i * 8) / d;
        let val: Int = if c_idx < 256 { list_get(comp_coeffs, c_idx) } else { 0 };
        bytes = list_push(bytes, val & 255);
        i = i + 1;
    }
    return bytes;
}
