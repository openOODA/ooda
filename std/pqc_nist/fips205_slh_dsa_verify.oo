// # FIPS 205 SLH-DSA Signature Verification
//
// Logline: Implements SLH-DSA.Verify algorithm validating FORS public key and Hypertree root authenticity.
//
// Setup: Imports fips205_slh_dsa_types.oo, fips205_slh_dsa_params.oo, fips205_slh_dsa_address.oo, fips205_slh_dsa_fors.oo, and fips205_slh_dsa_hypertree.oo.
//
// Beats:
//   1. Validate public key formatting and signature length consistency.
//   2. Reconstruct FORS public key from message digest and FORS signature.
//   3. Traverse Hypertree layers to verify reconstructed root matches PK.root.

import "./fips205_slh_dsa_types.oo";
import "./fips205_slh_dsa_params.oo";
import "./fips205_slh_dsa_address.oo";
import "./fips205_slh_dsa_fors.oo";
import "./fips205_slh_dsa_hypertree.oo";

pub fn slh_dsa_verify_signature(pk: &SlhDsaPublicKey, msg: List[Int], sig: &SlhDsaSignature) -> SlhDsaVerificationResult {
    if !pk.is_valid {
        return slh_dsa_verify_result_err(1);
    }
    
    let params: SlhDsaParams = slh_dsa_params_by_security(1, false);
    let mut adrs: SlhAdrs = slh_adrs_new();
    let fors_pk: List[Int] = fors_pk_from_sig(&sig.fors_sig, &msg, &pk.seed_pk, &adrs);
    
    let recovered_root: List[Int] = ht_verify(fors_pk, &sig.hypertree_sigs, &pk.seed_pk, 0, 0, params.d);
    
    let root_len: Int = list_len(pk.root);
    let mut is_match: Bool = true;
    let mut i: Int = 0;
    while i < root_len {
        let expected: Int = list_get(pk.root, i);
        let actual: Int = if i < list_len(recovered_root) { list_get(recovered_root, i) } else { 0 };
        if expected != actual {
            is_match = false;
        }
        i = i + 1;
    }
    
    if !is_match {
        return slh_dsa_verify_result_err(2);
    }
    
    return slh_dsa_verify_result_ok(recovered_root);
}
