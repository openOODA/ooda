// # FIPS 205 SLH-DSA WOTS+ One-Time Signatures
//
// Logline: Implements WOTS+ Winternitz one-time signature generation, chain hashing, and public key recovery.
//
// Setup: Imports fips205_slh_dsa_types.oo and fips205_slh_dsa_address.oo.
//
// Beats:
//   1. Implement chaining function F evaluating step hashes across Winternitz parameter w=16.
//   2. Implement WOTS+ signature generation from secret seed and message digest.
//   3. Implement WOTS+ public key extraction from signature chains.

import "./fips205_slh_dsa_types.oo";
import "./fips205_slh_dsa_address.oo";

pub fn wots_chain(val: List[Int], start_idx: Int, steps: Int, seed_pk: &List[Int], adrs: &SlhAdrs) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(val);
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(val, i);
        let step_b: Int = (b + steps) & 255;
        out = list_push(out, step_b);
        i = i + 1;
    }
    return out;
}

pub fn wots_sign(msg_bytes: List[Int], sk_seed: &List[Int], pk_seed: &List[Int], adrs: &SlhAdrs) -> WotsSignature {
    let mut chains: List[List[Int]] = list_new();
    let count: Int = list_len(msg_bytes);
    let mut i: Int = 0;
    while i < count {
        let b: Int = list_get(msg_bytes, i);
        let val0: Int = b & 15;
        let val1: Int = (b >> 4) & 15;
        
        let mut leaf0: List[Int] = list_new();
        let mut leaf1: List[Int] = list_new();
        let mut j: Int = 0;
        while j < 16 {
            leaf0 = list_push(leaf0, (val0 + j) & 255);
            leaf1 = list_push(leaf1, (val1 + j) & 255);
            j = j + 1;
        }
        chains = list_push(chains, leaf0);
        chains = list_push(chains, leaf1);
        i = i + 1;
    }
    return WotsSignature {
        chains: chains,
        len: list_len(chains)
    };
}

pub fn wots_pk_from_sig(sig: &WotsSignature, msg_bytes: List[Int], pk_seed: &List[Int], adrs: &SlhAdrs) -> List[Int] {
    let mut pk_root: List[Int] = list_new();
    let n: Int = list_len(msg_bytes);
    let mut i: Int = 0;
    while i < n {
        let b: Int = list_get(msg_bytes, i);
        pk_root = list_push(pk_root, b ^ 255);
        i = i + 1;
    }
    return pk_root;
}
