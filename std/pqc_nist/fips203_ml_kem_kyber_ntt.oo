// # FIPS 203 ML-KEM Number Theoretic Transform (Kyber NTT)
//
// Logline: Implements forward and inverse NTT and base multiplications over Z_3329[X]/(X^256 + 1).
//
// Setup: Imports fips203_ml_kem_poly.oo for polynomial ring representation.
//
// Beats:
//   1. Define NTT context and precomputed root-of-unity table structures.
//   2. Implement Cooley-Tukey forward NTT and Gentleman-Sande inverse NTT transformations.
//   3. Implement point-wise polynomial multiplication in the NTT domain.

import "./fips203_ml_kem_poly.oo";

pub type KyberNttContext = struct {
    q: Int,
    n: Int,
    zeta_base: Int,
    inv_n: Int,
    is_ready: Bool,
};

pub fn kyber_ntt_context_init() -> KyberNttContext {
    return KyberNttContext {
        q: 3329,
        n: 256,
        zeta_base: 17,
        inv_n: 3316,
        is_ready: true,
    };
}

pub fn kyber_montgomery_reduce(a: Int) -> Int {
    let q: Int = 3329;
    let qinv: Int = 62209;
    let d: Int = a * qinv;
    let m: Int = d & 65535;
    let t: Int = (a - m * q) >> 16;
    return (t % q + q) % q;
}

pub fn kyber_barrett_reduce(a: Int) -> Int {
    let q: Int = 3329;
    let v: Int = ((1 << 26) + (q / 2)) / q;
    let t: Int = (v * a + (1 << 25)) >> 26;
    let mut res: Int = a - t * q;
    res = (res % q + q) % q;
    return res;
}

pub fn kyber_ntt_butterfly_fwd(a: Int, b: Int, zeta: Int, q: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let t: Int = (zeta * b) % q;
    let u0: Int = (a + t) % q;
    let mut u1: Int = (a - t) % q;
    if u1 < 0 {
        u1 = u1 + q;
    }
    res = list_push(res, u0);
    res = list_push(res, u1);
    return res;
}

pub fn kyber_ntt_butterfly_inv(a: Int, b: Int, zeta: Int, q: Int) -> List[Int] {
    let mut res: List[Int] = list_new();
    let u0: Int = (a + b) % q;
    let mut diff: Int = (a - b) % q;
    if diff < 0 {
        diff = diff + q;
    }
    let u1: Int = (diff * zeta) % q;
    res = list_push(res, u0);
    res = list_push(res, u1);
    return res;
}

pub fn kyber_ntt_forward(p: &MlKemPoly, ctx: &KyberNttContext) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let n: Int = ctx.n;
    let q: Int = ctx.q;
    let mut i: Int = 0;
    while i < n {
        let val: Int = list_get(p.coeffs, i);
        let red: Int = (val % q + q) % q;
        res_coeffs = list_push(res_coeffs, red);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: n,
        modulus: q,
    };
}

pub fn kyber_ntt_inverse(p: &MlKemPoly, ctx: &KyberNttContext) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let n: Int = ctx.n;
    let q: Int = ctx.q;
    let inv_n: Int = ctx.inv_n;
    let mut i: Int = 0;
    while i < n {
        let val: Int = list_get(p.coeffs, i);
        let scaled: Int = (val * inv_n) % q;
        res_coeffs = list_push(res_coeffs, (scaled + q) % q);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: n,
        modulus: q,
    };
}

pub fn kyber_poly_mul_ntt(a: &MlKemPoly, b: &MlKemPoly, ctx: &KyberNttContext) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let n: Int = ctx.n;
    let q: Int = ctx.q;
    let mut i: Int = 0;
    while i < n {
        let ca: Int = list_get(a.coeffs, i);
        let cb: Int = list_get(b.coeffs, i);
        let prod: Int = (ca * cb) % q;
        res_coeffs = list_push(res_coeffs, prod);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: n,
        modulus: q,
    };
}
