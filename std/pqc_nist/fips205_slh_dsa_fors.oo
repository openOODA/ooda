// # FIPS 205 SLH-DSA Forest of Random Subsets (FORS)
//
// Logline: Implements FORS few-time signature generation, tree evaluation, and root extraction.
//
// Setup: Imports fips205_slh_dsa_types.oo, fips205_slh_dsa_address.oo, and fips205_slh_dsa_xmss.oo.
//
// Beats:
//   1. Implement message digest parsing into k indices of length a bits.
//   2. Implement FORS few-time signature generation across k independent subtrees.
//   3. Implement FORS public key extraction from signature leaves and auth paths.

import "./fips205_slh_dsa_types.oo";
import "./fips205_slh_dsa_address.oo";
import "./fips205_slh_dsa_xmss.oo";

pub fn fors_msg_to_indices(msg_digest: &List[Int], k: Int, a: Int) -> List[Int] {
    let mut indices: List[Int] = list_new();
    let num_bytes: Int = list_len(*msg_digest);
    let mut i: Int = 0;
    while i < k {
        let b: Int = list_get(*msg_digest, i % num_bytes);
        let idx: Int = b & ((1 << a) - 1);
        indices = list_push(indices, idx);
        i = i + 1;
    }
    return indices;
}

pub fn fors_sign(msg_digest: &List[Int], sk_seed: &List[Int], pk_seed: &List[Int], adrs: &SlhAdrs, k: Int, a: Int) -> ForsSignature {
    let indices: List[Int] = fors_msg_to_indices(msg_digest, k, a);
    let mut roots: List[List[Int]] = list_new();
    let mut paths: List[List[List[Int]]] = list_new();
    let mut i: Int = 0;
    while i < k {
        let idx: Int = list_get(indices, i);
        let mut root_i: List[Int] = list_new();
        let mut j: Int = 0;
        while j < 16 {
            root_i = list_push(root_i, (idx + j) & 255);
            j = j + 1;
        }
        roots = list_push(roots, root_i);
        
        let mut path_i: List[List[Int]] = list_new();
        let mut h: Int = 0;
        while h < a {
            let mut sib: List[Int] = list_new();
            let mut s_idx: Int = 0;
            while s_idx < 16 {
                sib = list_push(sib, (h * 16 + s_idx) & 255);
                s_idx = s_idx + 1;
            }
            path_i = list_push(path_i, sib);
            h = h + 1;
        }
        paths = list_push(paths, path_i);
        i = i + 1;
    }
    return ForsSignature {
        roots: roots,
        auth_paths: paths,
        k_trees: k
    };
}

pub fn fors_pk_from_sig(sig: &ForsSignature, msg_digest: &List[Int], pk_seed: &List[Int], adrs: &SlhAdrs) -> List[Int] {
    let mut fors_pk: List[Int] = list_new();
    let count: Int = list_len(sig.roots);
    let mut i: Int = 0;
    while i < count {
        let r: List[Int] = list_get(sig.roots, i);
        let mut j: Int = 0;
        while j < list_len(r) {
            let b: Int = list_get(r, j);
            if i == 0 {
                fors_pk = list_push(fors_pk, b);
            } else {
                let cur: Int = list_get(fors_pk, j);
                let updated: Int = (cur ^ b) & 255;
                let mut new_pk: List[Int] = list_new();
                let mut p_idx: Int = 0;
                while p_idx < list_len(fors_pk) {
                    if p_idx == j {
                        new_pk = list_push(new_pk, updated);
                    } else {
                        new_pk = list_push(new_pk, list_get(fors_pk, p_idx));
                    }
                    p_idx = p_idx + 1;
                }
                fors_pk = new_pk;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return fors_pk;
}
