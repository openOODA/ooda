// # NIST PQC Hardware Acceleration Stubs & Capability Barriers
//
// Logline: Enforces fail-closed SysCap capability barriers for physical FPGA NTT accelerators, ASIC signature engines, and QRNG devices.
//
// Setup: SysCap-gated fail-closed barriers protecting unvalidated native hardware coprocessors.
//
// Beats:
//   1. Guard physical Quantum Random Number Generator (QRNG) entropy feeds with SysCap capabilities.
//   2. Guard PCIe FPGA NTT coprocessor execution barriers.
//   3. Provide PQC hardware capability descriptors and fail-closed barriers.

pub type PqcHardwareCapabilities = struct {
    supports_qrng: Int,
    supports_fpga_kyber_ntt: Int,
    supports_dilithium_asic: Int,
    max_dma_batch_size: Int
};

pub fn pqc_hardware_capabilities_default() -> PqcHardwareCapabilities {
    return PqcHardwareCapabilities {
        supports_qrng: 1,
        supports_fpga_kyber_ntt: 1,
        supports_dilithium_asic: 1,
        max_dma_batch_size: 4096
    };
}

// -------------------------------------------------------------------
// Fail-Closed Hardware Acceleration Stubs
// -------------------------------------------------------------------

/// Quantum Random Number Generator (QRNG) hardware driver barrier.
pub fn pqc_qrng_sample_entropy(cap: &SysCap, out_len: Int) -> List[Int] {
    process_exit(1);
    return list_new();
}

/// Native FPGA Kyber/ML-KEM NTT hardware coprocessor DMA execution barrier.
pub fn pqc_fpga_kyber_ntt_submit(cap: &SysCap, device_id: Int, poly_count: Int) -> Int {
    process_exit(1);
    return 0;
}

/// ASIC Dilithium/ML-DSA hardware signature coprocessor execution barrier.
pub fn pqc_asic_dilithium_sign_step(cap: &SysCap, asic_id: Int, batch_size: Int) -> Int {
    process_exit(1);
    return 0;
}
