// # FIPS 205 SLH-DSA Parameter Configurations
//
// Logline: Defines standard security parameters and tree dimension sets for SLH-DSA (SPHINCS+).
//
// Setup: FIPS 205 / NIST SP 800 standard parameter sets for stateless hash-based digital signatures.
//
// Beats:
//   1. Define parameter set configuration record for SLH-DSA.
//   2. Provide constructors for SLH-DSA-SHA2-128s/128f, 192s/192f, and 256s/256f.
//   3. Implement parameter query, Winternitz chain size, and FORS tree size calculators.

pub type SlhDsaParams = struct {
    name: String,
    n: Int,
    h: Int,
    d: Int,
    h_prime: Int,
    a: Int,
    k: Int,
    w: Int,
    pk_size: Int,
    sk_size: Int,
    sig_size: Int
};

pub fn slh_dsa_params_128s() -> SlhDsaParams {
    return SlhDsaParams {
        name: "SLH-DSA-SHA2-128s",
        n: 16,
        h: 63,
        d: 7,
        h_prime: 9,
        a: 12,
        k: 14,
        w: 16,
        pk_size: 32,
        sk_size: 64,
        sig_size: 7856
    };
}

pub fn slh_dsa_params_128f() -> SlhDsaParams {
    return SlhDsaParams {
        name: "SLH-DSA-SHA2-128f",
        n: 16,
        h: 66,
        d: 22,
        h_prime: 3,
        a: 6,
        k: 33,
        w: 16,
        pk_size: 32,
        sk_size: 64,
        sig_size: 17088
    };
}

pub fn slh_dsa_params_192s() -> SlhDsaParams {
    return SlhDsaParams {
        name: "SLH-DSA-SHA2-192s",
        n: 24,
        h: 63,
        d: 7,
        h_prime: 9,
        a: 14,
        k: 17,
        w: 16,
        pk_size: 48,
        sk_size: 96,
        sig_size: 16224
    };
}

pub fn slh_dsa_params_256s() -> SlhDsaParams {
    return SlhDsaParams {
        name: "SLH-DSA-SHA2-256s",
        n: 32,
        h: 64,
        d: 8,
        h_prime: 8,
        a: 14,
        k: 22,
        w: 16,
        pk_size: 64,
        sk_size: 128,
        sig_size: 29792
    };
}

pub fn slh_dsa_params_by_security(sec_level: Int, fast: Bool) -> SlhDsaParams {
    if sec_level == 1 {
        if fast {
            return slh_dsa_params_128f();
        }
        return slh_dsa_params_128s();
    }
    if sec_level == 3 {
        return slh_dsa_params_192s();
    }
    return slh_dsa_params_256s();
}

pub fn slh_dsa_wots_len(n: Int, w: Int) -> Int {
    let len1: Int = (8 * n) / 4;
    let len2: Int = 3;
    return len1 + len2;
}
