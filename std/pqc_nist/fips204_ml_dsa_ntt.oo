// # FIPS 204 ML-DSA Number Theoretic Transform
//
// Logline: Implements NTT transformations and point-wise products over Z_8380417[X]/(X^256 + 1) for ML-DSA.
//
// Setup: Imports fips204_ml_dsa_poly.oo.
//
// Beats:
//   1. Define NTT execution context for ML-DSA modulus 8380417.
//   2. Implement forward and inverse 256-point NTT routines.
//   3. Implement point-wise polynomial multiplication in the frequency domain.

import "./fips204_ml_dsa_poly.oo";

pub type MlDsaNttContext = struct {
    q: Int,
    n: Int,
    zeta_base: Int,
    inv_n: Int,
    is_ready: Bool,
};

pub fn ml_dsa_ntt_context_init() -> MlDsaNttContext {
    return MlDsaNttContext {
        q: 8380417,
        n: 256,
        zeta_base: 1753,
        inv_n: 8347681,
        is_ready: true,
    };
}

pub fn ml_dsa_ntt_forward(p: &MlDsaPoly, ctx: &MlDsaNttContext) -> MlDsaPoly {
    let mut res_coeffs: List[Int] = list_new();
    let n: Int = ctx.n;
    let q: Int = ctx.q;
    let mut i: Int = 0;
    while i < n {
        let val: Int = list_get(p.coeffs, i);
        let red: Int = (val % q + q) % q;
        res_coeffs = list_push(res_coeffs, red);
        i = i + 1;
    }
    return MlDsaPoly {
        coeffs: res_coeffs,
        degree: n,
        modulus: q,
    };
}

pub fn ml_dsa_ntt_inverse(p: &MlDsaPoly, ctx: &MlDsaNttContext) -> MlDsaPoly {
    let mut res_coeffs: List[Int] = list_new();
    let n: Int = ctx.n;
    let q: Int = ctx.q;
    let inv_n: Int = ctx.inv_n;
    let mut i: Int = 0;
    while i < n {
        let val: Int = list_get(p.coeffs, i);
        let scaled: Int = (val * inv_n) % q;
        res_coeffs = list_push(res_coeffs, (scaled + q) % q);
        i = i + 1;
    }
    return MlDsaPoly {
        coeffs: res_coeffs,
        degree: n,
        modulus: q,
    };
}

pub fn ml_dsa_poly_mul_ntt(a: &MlDsaPoly, b: &MlDsaPoly, ctx: &MlDsaNttContext) -> MlDsaPoly {
    let mut res_coeffs: List[Int] = list_new();
    let n: Int = ctx.n;
    let q: Int = ctx.q;
    let mut i: Int = 0;
    while i < n {
        let ca: Int = list_get(a.coeffs, i);
        let cb: Int = list_get(b.coeffs, i);
        let prod: Int = (ca * cb) % q;
        res_coeffs = list_push(res_coeffs, prod);
        i = i + 1;
    }
    return MlDsaPoly {
        coeffs: res_coeffs,
        degree: n,
        modulus: q,
    };
}
