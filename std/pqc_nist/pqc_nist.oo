pub type PqcNistRuntime = struct {
    default_security_level: Int,
    enable_constant_time_checks: Bool,
    enable_side_channel_jitter: Bool,
    active_policy: String,
};

pub fn pqc_nist_runtime_default() -> PqcNistRuntime {
    return PqcNistRuntime {
        default_security_level: 3,
        enable_constant_time_checks: true,
        enable_side_channel_jitter: true,
        active_policy: "CNSA-2.0",
    };
}

pub fn pqc_nist_ml_kem_default() -> MlKemParams {
    return ml_kem_params_768();
}

pub fn pqc_nist_ml_dsa_default() -> MlDsaParams {
    return ml_dsa_params_65();
}

pub fn pqc_nist_slh_dsa_default() -> SlhDsaParams {
    return slh_dsa_params_128s();
}

pub fn pqc_nist_falcon_default() -> FalconParams {
    return falcon_params_512();
}
