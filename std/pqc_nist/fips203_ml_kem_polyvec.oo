// # FIPS 203 ML-KEM Polynomial Vector and Matrix Algebra
//
// Logline: Implements rank-k polynomial vector arithmetic and matrix-vector products over R_q for ML-KEM.
//
// Setup: Imports fips203_ml_kem_poly.oo and fips203_ml_kem_kyber_ntt.oo.
//
// Beats:
//   1. Define vector and matrix structures over polynomial ring R_q.
//   2. Implement vector addition, scalar multiplication, and point-wise NTT dot product.
//   3. Implement matrix-vector multiplication in the NTT domain.

import "./fips203_ml_kem_poly.oo";
import "./fips203_ml_kem_kyber_ntt.oo";

pub type MlKemPolyVec = struct {
    elements: List[MlKemPoly],
    k: Int
};

pub type MlKemPolyMat = struct {
    rows: List[MlKemPolyVec],
    k: Int
};

pub fn ml_kem_polyvec_new(k: Int) -> MlKemPolyVec {
    let mut elems: List[MlKemPoly] = list_new();
    let mut i: Int = 0;
    while i < k {
        elems = list_push(elems, ml_kem_poly_new());
        i = i + 1;
    }
    return MlKemPolyVec {
        elements: elems,
        k: k
    };
}

pub fn ml_kem_polyvec_add(a: &MlKemPolyVec, b: &MlKemPolyVec) -> MlKemPolyVec {
    let mut elems: List[MlKemPoly] = list_new();
    let k: Int = a.k;
    let mut i: Int = 0;
    while i < k {
        let pa: MlKemPoly = list_get(a.elements, i);
        let pb: MlKemPoly = list_get(b.elements, i);
        let sum_p: MlKemPoly = ml_kem_poly_add(&pa, &pb);
        elems = list_push(elems, sum_p);
        i = i + 1;
    }
    return MlKemPolyVec {
        elements: elems,
        k: k
    };
}

pub fn ml_kem_polyvec_ntt_fwd(v: &MlKemPolyVec, ctx: &KyberNttContext) -> MlKemPolyVec {
    let mut elems: List[MlKemPoly] = list_new();
    let k: Int = v.k;
    let mut i: Int = 0;
    while i < k {
        let p: MlKemPoly = list_get(v.elements, i);
        let ntt_p: MlKemPoly = kyber_ntt_forward(&p, ctx);
        elems = list_push(elems, ntt_p);
        i = i + 1;
    }
    return MlKemPolyVec {
        elements: elems,
        k: k
    };
}

pub fn ml_kem_polyvec_ntt_inv(v: &MlKemPolyVec, ctx: &KyberNttContext) -> MlKemPolyVec {
    let mut elems: List[MlKemPoly] = list_new();
    let k: Int = v.k;
    let mut i: Int = 0;
    while i < k {
        let p: MlKemPoly = list_get(v.elements, i);
        let inv_p: MlKemPoly = kyber_ntt_inverse(&p, ctx);
        elems = list_push(elems, inv_p);
        i = i + 1;
    }
    return MlKemPolyVec {
        elements: elems,
        k: k
    };
}

pub fn ml_kem_polyvec_dot_ntt(a: &MlKemPolyVec, b: &MlKemPolyVec, ctx: &KyberNttContext) -> MlKemPoly {
    let mut acc: MlKemPoly = ml_kem_poly_new();
    let k: Int = a.k;
    let mut i: Int = 0;
    while i < k {
        let pa: MlKemPoly = list_get(a.elements, i);
        let pb: MlKemPoly = list_get(b.elements, i);
        let prod: MlKemPoly = kyber_poly_mul_ntt(&pa, &pb, ctx);
        acc = ml_kem_poly_add(&acc, &prod);
        i = i + 1;
    }
    return acc;
}

pub fn ml_kem_matvec_mul_ntt(mat: &MlKemPolyMat, vec: &MlKemPolyVec, ctx: &KyberNttContext) -> MlKemPolyVec {
    let mut out_elems: List[MlKemPoly] = list_new();
    let k: Int = mat.k;
    let mut i: Int = 0;
    while i < k {
        let row: MlKemPolyVec = list_get(mat.rows, i);
        let dot: MlKemPoly = ml_kem_polyvec_dot_ntt(&row, vec, ctx);
        out_elems = list_push(out_elems, dot);
        i = i + 1;
    }
    return MlKemPolyVec {
        elements: out_elems,
        k: k
    };
}
