// # FIPS 204 ML-DSA Polynomial Vector & Matrix Arithmetic
//
// Logline: Implements vector and matrix operations over R_q for ML-DSA dimensions (k, l).
//
// Setup: Imports fips204_ml_dsa_poly.oo and fips204_ml_dsa_ntt.oo.
//
// Beats:
//   1. Define vector and matrix structures over ML-DSA polynomial ring.
//   2. Implement vector addition, infinity norm checking, and NTT conversions.
//   3. Implement matrix-vector multiplication in the NTT domain.

import "./fips204_ml_dsa_poly.oo";
import "./fips204_ml_dsa_ntt.oo";

pub type MlDsaPolyVec = struct {
    elements: List[MlDsaPoly],
    length: Int,
};

pub type MlDsaPolyMat = struct {
    rows: List[MlDsaPolyVec],
    rows_count: Int,
    cols_count: Int,
};

pub fn ml_dsa_polyvec_new(len: Int) -> MlDsaPolyVec {
    let mut elems: List[MlDsaPoly] = list_new();
    let mut i: Int = 0;
    while i < len {
        elems = list_push(elems, ml_dsa_poly_new());
        i = i + 1;
    }
    return MlDsaPolyVec {
        elements: elems,
        length: len,
    };
}

pub fn ml_dsa_polyvec_add(a: &MlDsaPolyVec, b: &MlDsaPolyVec) -> MlDsaPolyVec {
    let mut elems: List[MlDsaPoly] = list_new();
    let len: Int = a.length;
    let mut i: Int = 0;
    while i < len {
        let pa: MlDsaPoly = list_get(a.elements, i);
        let pb: MlDsaPoly = list_get(b.elements, i);
        let sum_p: MlDsaPoly = ml_dsa_poly_add(&pa, &pb);
        elems = list_push(elems, sum_p);
        i = i + 1;
    }
    return MlDsaPolyVec {
        elements: elems,
        length: len,
    };
}

pub fn ml_dsa_polyvec_infinity_norm(v: &MlDsaPolyVec) -> Int {
    let mut max_norm: Int = 0;
    let len: Int = v.length;
    let mut i: Int = 0;
    while i < len {
        let p: MlDsaPoly = list_get(v.elements, i);
        let norm: Int = ml_dsa_poly_infinity_norm(&p);
        if norm > max_norm {
            max_norm = norm;
        }
        i = i + 1;
    }
    return max_norm;
}

pub fn ml_dsa_polyvec_ntt_fwd(v: &MlDsaPolyVec, ctx: &MlDsaNttContext) -> MlDsaPolyVec {
    let mut elems: List[MlDsaPoly] = list_new();
    let len: Int = v.length;
    let mut i: Int = 0;
    while i < len {
        let p: MlDsaPoly = list_get(v.elements, i);
        let ntt_p: MlDsaPoly = ml_dsa_ntt_forward(&p, ctx);
        elems = list_push(elems, ntt_p);
        i = i + 1;
    }
    return MlDsaPolyVec {
        elements: elems,
        length: len,
    };
}

pub fn ml_dsa_polyvec_ntt_inv(v: &MlDsaPolyVec, ctx: &MlDsaNttContext) -> MlDsaPolyVec {
    let mut elems: List[MlDsaPoly] = list_new();
    let len: Int = v.length;
    let mut i: Int = 0;
    while i < len {
        let p: MlDsaPoly = list_get(v.elements, i);
        let inv_p: MlDsaPoly = ml_dsa_ntt_inverse(&p, ctx);
        elems = list_push(elems, inv_p);
        i = i + 1;
    }
    return MlDsaPolyVec {
        elements: elems,
        length: len,
    };
}

pub fn ml_dsa_matvec_mul_ntt(mat: &MlDsaPolyMat, vec: &MlDsaPolyVec, ctx: &MlDsaNttContext) -> MlDsaPolyVec {
    let mut out_elems: List[MlDsaPoly] = list_new();
    let k: Int = mat.rows_count;
    let l: Int = mat.cols_count;
    let mut r: Int = 0;
    while r < k {
        let row: MlDsaPolyVec = list_get(mat.rows, r);
        let mut acc: MlDsaPoly = ml_dsa_poly_new();
        let mut c: Int = 0;
        while c < l {
            let pr: MlDsaPoly = list_get(row.elements, c);
            let pv: MlDsaPoly = list_get(vec.elements, c);
            let prod: MlDsaPoly = ml_dsa_poly_mul_ntt(&pr, &pv, ctx);
            acc = ml_dsa_poly_add(&acc, &prod);
            c = c + 1;
        }
        out_elems = list_push(out_elems, acc);
        r = r + 1;
    }
    return MlDsaPolyVec {
        elements: out_elems,
        length: k,
    };
}
