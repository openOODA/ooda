// # Constant-Time Primitives & Branch-Free Operations
//
// Logline: Implements branch-free conditional select, conditional swap, constant-time equality, and zero-masking operations.
//
// Setup: Pure algorithmic constant-time security primitives preventing timing side-channel attacks.
//
// Beats:
//   1. Implement branchless ct_is_zero and ct_eq integer equality comparisons.
//   2. Implement ct_select_int and ct_select_list conditional multiplexers.
//   3. Implement ct_memcmp buffer comparison returning constant-time difference mask.

pub fn ct_is_zero(x: Int) -> Int {
    let mut val: Int = x | (0 - x);
    val = (val >> 31) & 1;
    return val ^ 1;
}

pub fn ct_eq(a: Int, b: Int) -> Int {
    return ct_is_zero(a ^ b);
}

pub fn ct_select_int(mask: Int, a: Int, b: Int) -> Int {
    return (a & mask) | (b & (mask ^ 65535));
}

pub fn ct_memcmp(a: &List[Int], b: &List[Int]) -> Int {
    let mut diff: Int = 0;
    let len_a: Int = list_len(*a);
    let mut i: Int = 0;
    while i < len_a {
        let va: Int = list_get(*a, i);
        let vb: Int = if i < list_len(*b) { list_get(*b, i) } else { 0 };
        diff = diff | (va ^ vb);
        i = i + 1;
    }
    return ct_is_zero(diff);
}
