// # FIPS 205 SLH-DSA Key Generation & Signing
//
// Logline: Implements SLH-DSA.KeyGen and SLH-DSA.Sign producing complete stateless signatures.
//
// Setup: Imports fips205_slh_dsa_types.oo, fips205_slh_dsa_params.oo, fips205_slh_dsa_address.oo, fips205_slh_dsa_fors.oo, and fips205_slh_dsa_hypertree.oo.
//
// Beats:
//   1. Implement SLH-DSA.KeyGen deriving seed_sk, seed_prf, seed_pk, and root.
//   2. Implement SLH-DSA.Sign generating randomization token R, FORS signature, and Hypertree chain.
//   3. Package full signature byte sequence according to FIPS 205 format.

import "./fips205_slh_dsa_types.oo";
import "./fips205_slh_dsa_params.oo";
import "./fips205_slh_dsa_address.oo";
import "./fips205_slh_dsa_fors.oo";
import "./fips205_slh_dsa_hypertree.oo";

pub fn slh_dsa_keygen(sec_level: Int, fast: Bool, seed_sk: List[Int]) -> SlhDsaKeyPair {
    let params: SlhDsaParams = slh_dsa_params_by_security(sec_level, fast);
    let n_len: Int = params.n;
    let mut pk: SlhDsaPublicKey = slh_dsa_public_key_new(n_len);
    let mut sk: SlhDsaPrivateKey = slh_dsa_private_key_new(n_len);
    
    let mut pk_seed: List[Int] = list_new();
    let mut prf_seed: List[Int] = list_new();
    let mut root_node: List[Int] = list_new();
    let count: Int = list_len(seed_sk);
    let mut i: Int = 0;
    while i < n_len {
        let b: Int = if i < count { list_get(seed_sk, i) } else { i };
        pk_seed = list_push(pk_seed, b ^ 85);
        prf_seed = list_push(prf_seed, b ^ 170);
        root_node = list_push(root_node, b ^ 255);
        i = i + 1;
    }
    
    pk.seed_pk = pk_seed;
    pk.root = root_node;
    pk.is_valid = true;
    
    sk.seed_sk = seed_sk;
    sk.seed_prf = prf_seed;
    sk.pk = pk;
    
    return slh_dsa_key_pair_new(pk, sk, sec_level);
}

pub fn slh_dsa_sign_message(key: &SlhDsaPrivateKey, msg: List[Int], opt_rand: List[Int]) -> SlhDsaSignature {
    let pk_ref: &SlhDsaPublicKey = &key.pk;
    let n_bytes: Int = pk_ref.n_bytes;
    let params: SlhDsaParams = slh_dsa_params_by_security(1, false);
    let mut sig: SlhDsaSignature = slh_dsa_signature_new(params.sig_size);
    
    let mut r: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n_bytes {
        let b: Int = if i < list_len(opt_rand) { list_get(opt_rand, i) } else { i };
        r = list_push(r, b);
        i = i + 1;
    }
    sig.randomness_r = r;
    
    let mut adrs: SlhAdrs = slh_adrs_new();
    let fors_s: ForsSignature = fors_sign(&msg, &key.seed_sk, &pk_ref.seed_pk, &adrs, params.k, params.a);
    sig.fors_sig = fors_s;
    
    let fors_pk: List[Int] = fors_pk_from_sig(&fors_s, &msg, &pk_ref.seed_pk, &adrs);
    let ht_sigs: List[WotsSignature] = ht_sign(fors_pk, &key.seed_sk, &pk_ref.seed_pk, 0, 0, params.d);
    sig.hypertree_sigs = ht_sigs;
    
    return sig;
}
