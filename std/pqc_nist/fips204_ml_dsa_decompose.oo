// # FIPS 204 ML-DSA Coefficient Decomposition & Hints
//
// Logline: Implements Power2Round, Decompose, HighBits, LowBits, MakeHint, and UseHint for ML-DSA.
//
// Setup: FIPS 204 rounding and hint generation algorithms over modulus q = 8380417.
//
// Beats:
//   1. Implement Power2Round scalar and vector coefficient splitting.
//   2. Implement Decompose, HighBits, and LowBits extraction with gamma2 parameter.
//   3. Implement MakeHint and UseHint bit reconstruction functions.

pub type DecomposeResult = struct {
    r1: Int,
    r0: Int,
};

pub type Power2RoundResult = struct {
    r1: Int,
    r0: Int,
};

pub fn ml_dsa_power2round(r: Int, d: Int) -> Power2RoundResult {
    let q: Int = 8380417;
    let r_mod: Int = (r % q + q) % q;
    let two_pow_d: Int = 1 << d;
    let half: Int = 1 << (d - 1);
    let mut r0: Int = r_mod & (two_pow_d - 1);
    if r0 > half {
        r0 = r0 - two_pow_d;
    }
    let r1: Int = (r_mod - r0) >> d;
    return Power2RoundResult {
        r1: r1,
        r0: r0,
    };
}

pub fn ml_dsa_decompose(r: Int, gamma2: Int) -> DecomposeResult {
    let q: Int = 8380417;
    let r_mod: Int = (r % q + q) % q;
    let two_gamma2: Int = 2 * gamma2;
    let mut r0: Int = r_mod % two_gamma2;
    if r0 > gamma2 {
        r0 = r0 - two_gamma2;
    }
    if r_mod - r0 == q - 1 {
        return DecomposeResult {
            r1: 0,
            r0: r0 - 1,
        };
    }
    let r1: Int = (r_mod - r0) / two_gamma2;
    return DecomposeResult {
        r1: r1,
        r0: r0,
    };
}

pub fn ml_dsa_high_bits(r: Int, gamma2: Int) -> Int {
    let dec: DecomposeResult = ml_dsa_decompose(r, gamma2);
    return dec.r1;
}

pub fn ml_dsa_low_bits(r: Int, gamma2: Int) -> Int {
    let dec: DecomposeResult = ml_dsa_decompose(r, gamma2);
    return dec.r0;
}

pub fn ml_dsa_make_hint(z: Int, r: Int, gamma2: Int) -> Int {
    let q: Int = 8380417;
    let r1: Int = ml_dsa_high_bits(r, gamma2);
    let v: Int = (r + z) % q;
    let v1: Int = ml_dsa_high_bits((v + q) % q, gamma2);
    if r1 != v1 {
        return 1;
    }
    return 0;
}

pub fn ml_dsa_use_hint(h: Int, r: Int, gamma2: Int) -> Int {
    let q: Int = 8380417;
    let m: Int = (q - 1) / (2 * gamma2);
    let dec: DecomposeResult = ml_dsa_decompose(r, gamma2);
    if h == 0 {
        return dec.r1;
    }
    if dec.r0 > 0 {
        return (dec.r1 + 1) % m;
    }
    return (dec.r1 - 1 + m) % m;
}
