// # FIPS 205 SLH-DSA XMSS Tree Traversal
//
// Logline: Implements XMSS Merkle subtree hashing, authentication path generation, and root derivation.
//
// Setup: Imports fips205_slh_dsa_types.oo, fips205_slh_dsa_address.oo, and fips205_slh_dsa_wots.oo.
//
// Beats:
//   1. Implement tree hash node evaluation with parent combination.
//   2. Implement leaf computation from WOTS+ public key.
//   3. Implement Merkle root computation from leaf node and authentication path.

import "./fips205_slh_dsa_types.oo";
import "./fips205_slh_dsa_address.oo";
import "./fips205_slh_dsa_wots.oo";

pub type XmssNode = struct {
    hash: List[Int],
    height: Int,
    index: Int,
};

pub fn xmss_node_new(hash: List[Int], height: Int, idx: Int) -> XmssNode {
    return XmssNode {
        hash: hash,
        height: height,
        index: idx,
    };
}

pub fn xmss_compute_root_from_path(leaf_hash: List[Int], leaf_idx: Int, auth_path: List[List[Int]], pk_seed: &List[Int], adrs: &SlhAdrs) -> List[Int] {
    let mut cur: List[Int] = leaf_hash;
    let path_len: Int = list_len(auth_path);
    let mut idx: Int = leaf_idx;
    let mut i: Int = 0;
    while i < path_len {
        let sibling: List[Int] = list_get(auth_path, i);
        let bit: Int = idx & 1;
        let mut parent: List[Int] = list_new();
        let n: Int = list_len(cur);
        let mut j: Int = 0;
        while j < n {
            let b0: Int = if bit == 0 { list_get(cur, j) } else { list_get(sibling, j) };
            let b1: Int = if bit == 0 { list_get(sibling, j) } else { list_get(cur, j) };
            parent = list_push(parent, (b0 ^ b1) & 255);
            j = j + 1;
        }
        cur = parent;
        idx = idx >> 1;
        i = i + 1;
    }
    return cur;
}
