// # FIPS 204 ML-DSA Polynomial Arithmetic
//
// Logline: Implements polynomial ring operations over R_q = Z_8380417[X]/(X^256 + 1) for ML-DSA.
//
// Setup: Canonical polynomial structure and ring arithmetic for Module-LWE / Module-SIS signatures.
//
// Beats:
//   1. Define ML-DSA polynomial data structure over degree 256 and modulus 8380417.
//   2. Implement addition, subtraction, scalar multiplication, and modular reduction.
//   3. Implement infinity norm computation and bound verification.

pub type MlDsaPoly = struct {
    coeffs: List[Int],
    degree: Int,
    modulus: Int,
};

pub fn ml_dsa_poly_new() -> MlDsaPoly {
    let mut coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        coeffs = list_push(coeffs, 0);
        i = i + 1;
    }
    return MlDsaPoly {
        coeffs: coeffs,
        degree: 256,
        modulus: 8380417,
    };
}

pub fn ml_dsa_poly_add(a: &MlDsaPoly, b: &MlDsaPoly) -> MlDsaPoly {
    let mut res: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let ca: Int = list_get(a.coeffs, i);
        let cb: Int = list_get(b.coeffs, i);
        let sum_val: Int = (ca + cb) % 8380417;
        res = list_push(res, sum_val);
        i = i + 1;
    }
    return MlDsaPoly {
        coeffs: res,
        degree: 256,
        modulus: 8380417,
    };
}

pub fn ml_dsa_poly_sub(a: &MlDsaPoly, b: &MlDsaPoly) -> MlDsaPoly {
    let mut res: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let ca: Int = list_get(a.coeffs, i);
        let cb: Int = list_get(b.coeffs, i);
        let mut diff: Int = (ca - cb) % 8380417;
        if diff < 0 {
            diff = diff + 8380417;
        }
        res = list_push(res, diff);
        i = i + 1;
    }
    return MlDsaPoly {
        coeffs: res,
        degree: 256,
        modulus: 8380417,
    };
}

pub fn ml_dsa_poly_scale(a: &MlDsaPoly, scalar: Int) -> MlDsaPoly {
    let mut res: List[Int] = list_new();
    let s: Int = ((scalar % 8380417) + 8380417) % 8380417;
    let mut i: Int = 0;
    while i < 256 {
        let ca: Int = list_get(a.coeffs, i);
        let prod: Int = (ca * s) % 8380417;
        res = list_push(res, prod);
        i = i + 1;
    }
    return MlDsaPoly {
        coeffs: res,
        degree: 256,
        modulus: 8380417,
    };
}

pub fn ml_dsa_poly_infinity_norm(p: &MlDsaPoly) -> Int {
    let mut max_val: Int = 0;
    let mut i: Int = 0;
    while i < 256 {
        let c: Int = list_get(p.coeffs, i);
        let centered: Int = if c > 4190208 { 8380417 - c } else { c };
        if centered > max_val {
            max_val = centered;
        }
        i = i + 1;
    }
    return max_val;
}

pub fn ml_dsa_poly_check_norm(p: &MlDsaPoly, bound: Int) -> Bool {
    let norm: Int = ml_dsa_poly_infinity_norm(p);
    return norm < bound;
}
