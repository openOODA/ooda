// # FIPS 205 SLH-DSA SPHINCS+ Master Scheme Engine
//
// Logline: Orchestrates stateless few-time FORS signatures and multi-layer Hypertree authentication into FIPS 205 SLH-DSA.
//
// Setup: Imports fips205_slh_dsa_types.oo, fips205_slh_dsa_params.oo, fips205_slh_dsa_fors.oo, and fips205_slh_dsa_hypertree.oo.
//
// Beats:
//   1. Configure SLH-DSA master cryptographic orchestration context.
//   2. Bind message randomization hash R and tree leaf selector.
//   3. Coordinate joint verification of FORS public key and Hypertree root.

import "./fips205_slh_dsa_types.oo";
import "./fips205_slh_dsa_params.oo";
import "./fips205_slh_dsa_fors.oo";
import "./fips205_slh_dsa_hypertree.oo";

pub type SlhDsaEngine = struct {
    params: SlhDsaParams,
    security_bits: Int,
};

pub fn slh_dsa_engine_new(sec_level: Int, fast: Bool) -> SlhDsaEngine {
    let params: SlhDsaParams = slh_dsa_params_by_security(sec_level, fast);
    let sec_bits: Int = if sec_level == 1 { 128 } else { if sec_level == 3 { 192 } else { 256 } };
    return SlhDsaEngine {
        params: params,
        security_bits: sec_bits,
    };
}

pub fn slh_dsa_compute_tree_idx(digest: &List[Int], h: Int, d: Int) -> Int {
    let mut tree_idx: Int = 0;
    let count: Int = list_len(*digest);
    let mut i: Int = 0;
    while i < 4 {
        let b: Int = if i < count { list_get(*digest, i) } else { 0 };
        tree_idx = tree_idx | (b << (i * 8));
        i = i + 1;
    }
    let h_prime: Int = h / d;
    let shift_val: Int = 1 << (h - h_prime);
    return tree_idx % shift_val;
}

pub fn slh_dsa_compute_leaf_idx(digest: &List[Int], h_prime: Int) -> Int {
    let count: Int = list_len(*digest);
    let b: Int = if count > 4 { list_get(*digest, 4) } else { 0 };
    return b % (1 << h_prime);
}
