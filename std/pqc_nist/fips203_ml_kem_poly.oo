// # FIPS 203 ML-KEM Polynomial Arithmetic
//
// Logline: Implements polynomial ring operations over R_q = Z_3329[X]/(X^256 + 1) for ML-KEM.
//
// Setup: Canonical polynomial structure and ring arithmetic for Module Learning With Errors.
//
// Beats:
//   1. Define polynomial data structure over degree 256 and modulus 3329.
//   2. Implement addition, subtraction, scalar multiplication, and modular reduction.
//   3. Implement byte packing and unpacking routines.

pub type MlKemPoly = struct {
    coeffs: List[Int],
    degree: Int,
    modulus: Int,
};

pub fn ml_kem_poly_new() -> MlKemPoly {
    let mut coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        coeffs = list_push(coeffs, 0);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: coeffs,
        degree: 256,
        modulus: 3329,
    };
}

pub fn ml_kem_poly_add(a: &MlKemPoly, b: &MlKemPoly) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let ca: Int = list_get(a.coeffs, i);
        let cb: Int = list_get(b.coeffs, i);
        let sum_val: Int = (ca + cb) % 3329;
        res_coeffs = list_push(res_coeffs, sum_val);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: 256,
        modulus: 3329,
    };
}

pub fn ml_kem_poly_sub(a: &MlKemPoly, b: &MlKemPoly) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        let ca: Int = list_get(a.coeffs, i);
        let cb: Int = list_get(b.coeffs, i);
        let mut diff: Int = (ca - cb) % 3329;
        if diff < 0 {
            diff = diff + 3329;
        }
        res_coeffs = list_push(res_coeffs, diff);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: 256,
        modulus: 3329,
    };
}

pub fn ml_kem_poly_scale(a: &MlKemPoly, scalar: Int) -> MlKemPoly {
    let mut res_coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    let s: Int = ((scalar % 3329) + 3329) % 3329;
    while i < 256 {
        let ca: Int = list_get(a.coeffs, i);
        let prod: Int = (ca * s) % 3329;
        res_coeffs = list_push(res_coeffs, prod);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: res_coeffs,
        degree: 256,
        modulus: 3329,
    };
}

pub fn ml_kem_poly_tobytes(p: &MlKemPoly) -> List[Int] {
    let mut bytes: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 128 {
        let c0: Int = list_get(p.coeffs, 2 * i);
        let c1: Int = list_get(p.coeffs, 2 * i + 1);
        let b0: Int = c0 & 255;
        let b1: Int = ((c0 >> 8) & 15) | ((c1 & 15) << 4);
        let b2: Int = (c1 >> 4) & 255;
        bytes = list_push(bytes, b0);
        bytes = list_push(bytes, b1);
        bytes = list_push(bytes, b2);
        i = i + 1;
    }
    return bytes;
}

pub fn ml_kem_poly_frombytes(bytes: List[Int]) -> MlKemPoly {
    let mut coeffs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 128 {
        let b0: Int = list_get(bytes, 3 * i);
        let b1: Int = list_get(bytes, 3 * i + 1);
        let b2: Int = list_get(bytes, 3 * i + 2);
        let c0: Int = (b0 | ((b1 & 15) << 8)) % 3329;
        let c1: Int = (((b1 >> 4) & 15) | (b2 << 4)) % 3329;
        coeffs = list_push(coeffs, c0);
        coeffs = list_push(coeffs, c1);
        i = i + 1;
    }
    return MlKemPoly {
        coeffs: coeffs,
        degree: 256,
        modulus: 3329,
    };
}
