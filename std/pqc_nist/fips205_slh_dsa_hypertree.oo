// # FIPS 205 SLH-DSA Hypertree Signature Framework
//
// Logline: Implements multi-layer Hypertree XMSS signing across d tree layers to the master public key root.
//
// Setup: Imports fips205_slh_dsa_types.oo, fips205_slh_dsa_address.oo, and fips205_slh_dsa_wots.oo.
//
// Beats:
//   1. Implement layer address traversal from bottom layer 0 up to top layer (d - 1).
//   2. Implement WOTS+ leaf authentication and XMSS path climbing per layer.
//   3. Implement Hypertree verification returning master root node.

import "./fips205_slh_dsa_types.oo";
import "./fips205_slh_dsa_address.oo";
import "./fips205_slh_dsa_wots.oo";

pub type HypertreeSignature = struct {
    layer_sigs: List[WotsSignature],
    layers_count: Int,
};

pub fn hypertree_signature_new(d: Int) -> HypertreeSignature {
    return HypertreeSignature {
        layer_sigs: list_new(),
        layers_count: d,
    };
}

pub fn ht_sign(root_in: List[Int], sk_seed: &List[Int], pk_seed: &List[Int], tree_idx: Int, leaf_idx: Int, d: Int) -> List[WotsSignature] {
    let mut sigs: List[WotsSignature] = list_new();
    let mut cur_node: List[Int] = root_in;
    let mut layer: Int = 0;
    let mut mut_adrs: SlhAdrs = slh_adrs_new();
    while layer < d {
        slh_adrs_set_layer(&mut mut_adrs, layer);
        slh_adrs_set_tree_address(&mut mut_adrs, tree_idx);
        slh_adrs_set_keypair(&mut mut_adrs, leaf_idx);
        
        let sig: WotsSignature = wots_sign(cur_node, sk_seed, pk_seed, &mut_adrs);
        sigs = list_push(sigs, sig);
        
        let mut next_node: List[Int] = list_new();
        let n: Int = list_len(cur_node);
        let mut j: Int = 0;
        while j < n {
            let b: Int = list_get(cur_node, j);
            next_node = list_push(next_node, (b + 1) & 255);
            j = j + 1;
        }
        cur_node = next_node;
        layer = layer + 1;
    }
    return sigs;
}

pub fn ht_verify(root_in: List[Int], sigs: &List[WotsSignature], pk_seed: &List[Int], tree_idx: Int, leaf_idx: Int, d: Int) -> List[Int] {
    let mut cur_node: List[Int] = root_in;
    let mut layer: Int = 0;
    let mut mut_adrs: SlhAdrs = slh_adrs_new();
    while layer < d {
        slh_adrs_set_layer(&mut mut_adrs, layer);
        slh_adrs_set_tree_address(&mut mut_adrs, tree_idx);
        slh_adrs_set_keypair(&mut mut_adrs, leaf_idx);
        
        let sig: WotsSignature = list_get(*sigs, layer);
        let pk_recovered: List[Int] = wots_pk_from_sig(&sig, cur_node, pk_seed, &mut_adrs);
        cur_node = pk_recovered;
        layer = layer + 1;
    }
    return cur_node;
}
