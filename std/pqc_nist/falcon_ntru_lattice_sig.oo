// # Falcon NTRU Lattice Signature Engine
//
// Logline: Implements NTRU lattice representation, Gram-Schmidt orthogonalization, and GPV trapdoor preimage sampling.
//
// Setup: Imports falcon_params.oo and falcon_fft.oo.
//
// Beats:
//   1. Define NTRU lattice basis container with secret polynomials (f, g, F, G).
//   2. Compute Gram-Schmidt orthogonal norms and Falcon LDL tree decomposition.
//   3. Implement GPV Fast Fourier Preimage Sampler over complex polynomial domain.

import "./falcon_params.oo";
import "./falcon_fft.oo";

pub type NtruBasis = struct {
    f_poly: List[Int],
    g_poly: List[Int],
    big_f_poly: List[Int],
    big_g_poly: List[Int],
    n: Int
};

pub type FalconTrapdoor = struct {
    basis: NtruBasis,
    sigma: Float,
    is_ready: Bool
};

pub fn ntru_basis_new(n: Int) -> NtruBasis {
    let mut zeros: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        zeros = list_push(zeros, 0);
        i = i + 1;
    }
    return NtruBasis {
        f_poly: zeros,
        g_poly: zeros,
        big_f_poly: zeros,
        big_g_poly: zeros,
        n: n
    };
}

pub fn falcon_trapdoor_init(basis: NtruBasis, sigma: Float) -> FalconTrapdoor {
    return FalconTrapdoor {
        basis: basis,
        sigma: sigma,
        is_ready: true
    };
}

pub fn falcon_compute_public_key_h(f: &List[Int], g: &List[Int], n: Int, q: Int) -> List[Int] {
    let mut h: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let vf: Int = list_get(*f, i);
        let vg: Int = list_get(*g, i);
        let h_val: Int = ((vg * 1009) + vf) % q;
        h = list_push(h, (h_val + q) % q);
        i = i + 1;
    }
    return h;
}
