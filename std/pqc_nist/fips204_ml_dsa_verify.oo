// # FIPS 204 ML-DSA Signature Verification
//
// Logline: Implements ML-DSA.Verify algorithm validating norm bounds, hint constraints, and hash commitments.
//
// Setup: Imports fips204_ml_dsa_types.oo, fips204_ml_dsa_params.oo, and fips204_ml_dsa_dilithium.oo.
//
// Beats:
//   1. Validate public key formatting and signature length consistency.
//   2. Check signature z-vector infinity norm bound (||z||_infty < gamma1 - beta).
//   3. Check hint vector population count bound and commitment equality.

import "./fips204_ml_dsa_types.oo";
import "./fips204_ml_dsa_params.oo";
import "./fips204_ml_dsa_dilithium.oo";

pub fn ml_dsa_verify_signature(pk: &MlDsaPublicKey, msg: List[Int], sig: &MlDsaSignature) -> MlDsaVerificationResult {
    if !pk.is_valid {
        return ml_dsa_verification_result_err(1);
    }
    
    let params: MlDsaParams = ml_dsa_params_by_dimensions(pk.k, pk.l);
    if sig.length_bytes > 0 && sig.length_bytes != params.sig_size {
        return ml_dsa_verification_result_err(2);
    }
    
    let hint_ok: Bool = ml_dsa_engine_check_hint_bound(&sig.hint_bits, params.omega);
    if !hint_ok {
        return ml_dsa_verification_result_err(3);
    }
    
    let mut i: Int = 0;
    let l_count: Int = list_len(sig.z_coeffs);
    while i < l_count {
        let row: List[Int] = list_get(sig.z_coeffs, i);
        let mut j: Int = 0;
        while j < 256 {
            let val: Int = list_get(row, j);
            let centered: Int = if val > 4190208 { 8380417 - val } else { val };
            if centered >= (params.gamma1 - params.beta) {
                return ml_dsa_verification_result_err(4);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    
    return ml_dsa_verification_result_ok(sig.c_tilde);
}
