// # FIPS 205 SLH-DSA Core Data Types
//
// Logline: Defines canonical type containers and structures for FIPS 205 SLH-DSA stateless hash-based signatures.
//
// Setup: Standalone type module defining public keys, private keys, FORS, WOTS+, and Hypertree signature records.
//
// Beats:
//   1. Declare SLH-DSA public key, private key, signature, and tree address structures.
//   2. Provide parameter-aware constructors and field initializers.
//   3. Implement validation and verification token containers.

pub type SlhDsaPublicKey = struct {
    seed_pk: List[Int],
    root: List[Int],
    n_bytes: Int,
    is_valid: Bool
};

pub type SlhDsaPrivateKey = struct {
    seed_sk: List[Int],
    seed_prf: List[Int],
    pk: SlhDsaPublicKey,
    n_bytes: Int
};

pub type WotsSignature = struct {
    chains: List[List[Int]],
    len: Int
};

pub type ForsSignature = struct {
    roots: List[List[Int]],
    auth_paths: List[List[List[Int]]],
    k_trees: Int
};

pub type SlhDsaSignature = struct {
    randomness_r: List[Int],
    fors_sig: ForsSignature,
    hypertree_sigs: List[WotsSignature],
    raw_bytes: List[Int],
    length_bytes: Int
};

pub type SlhDsaKeyPair = struct {
    pk: SlhDsaPublicKey,
    sk: SlhDsaPrivateKey,
    security_category: Int
};

pub type SlhDsaVerificationResult = struct {
    is_valid: Bool,
    error_code: Int,
    recovered_root: List[Int]
};

pub fn slh_dsa_public_key_new(n_bytes: Int) -> SlhDsaPublicKey {
    return SlhDsaPublicKey {
        seed_pk: list_new(),
        root: list_new(),
        n_bytes: n_bytes,
        is_valid: false
    };
}

pub fn slh_dsa_private_key_new(n_bytes: Int) -> SlhDsaPrivateKey {
    let empty_pk: SlhDsaPublicKey = slh_dsa_public_key_new(n_bytes);
    return SlhDsaPrivateKey {
        seed_sk: list_new(),
        seed_prf: list_new(),
        pk: empty_pk,
        n_bytes: n_bytes
    };
}

pub fn slh_dsa_signature_new(len_bytes: Int) -> SlhDsaSignature {
    let empty_fors: ForsSignature = ForsSignature {
        roots: list_new(),
        auth_paths: list_new(),
        k_trees: 0
    };
    return SlhDsaSignature {
        randomness_r: list_new(),
        fors_sig: empty_fors,
        hypertree_sigs: list_new(),
        raw_bytes: list_new(),
        length_bytes: len_bytes
    };
}

pub fn slh_dsa_key_pair_new(pk: SlhDsaPublicKey, sk: SlhDsaPrivateKey, cat: Int) -> SlhDsaKeyPair {
    return SlhDsaKeyPair {
        pk: pk,
        sk: sk,
        security_category: cat
    };
}

pub fn slh_dsa_verify_result_ok(root: List[Int]) -> SlhDsaVerificationResult {
    return SlhDsaVerificationResult {
        is_valid: true,
        error_code: 0,
        recovered_root: root
    };
}

pub fn slh_dsa_verify_result_err(code: Int) -> SlhDsaVerificationResult {
    return SlhDsaVerificationResult {
        is_valid: false,
        error_code: code,
        recovered_root: list_new()
    };
}
