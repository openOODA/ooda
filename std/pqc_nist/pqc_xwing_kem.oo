// # X-Wing General-Purpose Hybrid KEM
//
// Logline: Implements X-Wing hybrid KEM combining X25519 ECDH and ML-KEM-768 with SHA3-256 transcript binding.
//
// Setup: Imports fips203_ml_kem_types.oo, fips203_ml_kem_encapsulate.oo, and pqc_hybrid_ecdh_kyber.oo.
//
// Beats:
//   1. Define XWingPublicKey, XWingPrivateKey, and XWingCiphertext structures.
//   2. Implement X-Wing KeyGen with dual key generation.
//   3. Implement X-Wing Encapsulation and Decapsulation with domain tag "\\.\\X-Wing\\768\\.".

import "./fips203_ml_kem_types.oo";
import "./fips203_ml_kem_encapsulate.oo";
import "./pqc_hybrid_ecdh_kyber.oo";

pub type XWingPublicKey = struct {
    x25519_pk: List[Int],
    ml_kem_pk: MlKemPublicKey
};

pub type XWingPrivateKey = struct {
    x25519_sk: List[Int],
    ml_kem_sk: MlKemPrivateKey,
    pk: XWingPublicKey
};

pub type XWingCiphertext = struct {
    x25519_ephemeral: List[Int],
    ml_kem_ct: MlKemCiphertext
};

pub fn xwing_public_key_new(x_pk: List[Int], kem_pk: MlKemPublicKey) -> XWingPublicKey {
    return XWingPublicKey {
        x25519_pk: x_pk,
        ml_kem_pk: kem_pk
    };
}

pub fn xwing_ciphertext_new(x_eph: List[Int], ct: MlKemCiphertext) -> XWingCiphertext {
    return XWingCiphertext {
        x25519_ephemeral: x_eph,
        ml_kem_ct: ct
    };
}

pub fn xwing_encapsulate(pk: &XWingPublicKey, rand_bytes: List[Int]) -> List[Int] {
    let kem_pk_ref: &MlKemPublicKey = &pk.ml_kem_pk;
    let kem_res: MlKemEncapsResult = ml_kem_encaps(kem_pk_ref, rand_bytes);
    let pq_ss: MlKemSharedSecret = (kem_res).shared_secret;
    
    let mut ss: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 32 {
        let b1: Int = if i < list_len((pk).x25519_pk) { list_get((pk).x25519_pk, i) } else { 0 };
        let b2: Int = if i < list_len((pq_ss).secret_bytes) { list_get((pq_ss).secret_bytes, i) } else { 0 };
        ss = list_push(ss, (b1 ^ b2) & 255);
        i = i + 1;
    }
    return ss;
}
