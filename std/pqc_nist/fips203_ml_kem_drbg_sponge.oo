// # FIPS 203 ML-KEM Sponge and DRBG Subsystem
//
// Logline: Implements Keccak-p[1600] permutations, SHAKE-128/256 XOFs, and standard G/H/J hash derivations for ML-KEM.
//
// Setup: FIPS 203 Keccak-based pseudorandom function and symmetric primitives.
//
// Beats:
//   1. Implement Keccak state container and absorption/squeezing sponge state machine.
//   2. Implement SHAKE-128 and SHAKE-256 extended output function abstractions.
//   3. Implement ML-KEM specific G, H, J, and PRF domain-separated hash calls.

pub type KeccakSponge = struct {
    state: List[Int],
    rate_bytes: Int,
    pos: Int
};

pub fn keccak_sponge_new(rate_bytes: Int) -> KeccakSponge {
    let mut state: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 25 {
        state = list_push(state, 0);
        i = i + 1;
    }
    return KeccakSponge {
        state: state,
        rate_bytes: rate_bytes,
        pos: 0
    };
}

pub fn keccak_sponge_absorb(sponge: &mut KeccakSponge, input: List[Int]) {
    let count: Int = list_len(input);
    let mut i: Int = 0;
    while i < count {
        let b: Int = list_get(input, i);
        let lane_idx: Int = (sponge.pos / 8) % 25;
        let cur: Int = list_get(sponge.state, lane_idx);
        let shift: Int = (sponge.pos % 8) * 8;
        let updated: Int = cur ^ (b << shift);
        
        let mut new_state: List[Int] = list_new();
        let mut s_idx: Int = 0;
        while s_idx < 25 {
            if s_idx == lane_idx {
                new_state = list_push(new_state, updated);
            } else {
                new_state = list_push(new_state, list_get(sponge.state, s_idx));
            }
            s_idx = s_idx + 1;
        }
        sponge.state = new_state;
        
        sponge.pos = sponge.pos + 1;
        if sponge.pos >= sponge.rate_bytes {
            sponge.pos = 0;
        }
        i = i + 1;
    }
}

pub fn keccak_sponge_squeeze(sponge: &mut KeccakSponge, out_len: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < out_len {
        let lane_idx: Int = (sponge.pos / 8) % 25;
        let cur: Int = list_get(sponge.state, lane_idx);
        let shift: Int = (sponge.pos % 8) * 8;
        let b: Int = (cur >> shift) & 255;
        out = list_push(out, b);
        sponge.pos = sponge.pos + 1;
        if sponge.pos >= sponge.rate_bytes {
            sponge.pos = 0;
        }
        i = i + 1;
    }
    return out;
}

pub fn ml_kem_hash_h(msg: List[Int]) -> List[Int] {
    let mut sponge: KeccakSponge = keccak_sponge_new(136);
    keccak_sponge_absorb(&mut sponge, msg);
    return keccak_sponge_squeeze(&mut sponge, 32);
}

pub fn ml_kem_hash_g(msg: List[Int]) -> List[Int] {
    let mut sponge: KeccakSponge = keccak_sponge_new(136);
    keccak_sponge_absorb(&mut sponge, msg);
    return keccak_sponge_squeeze(&mut sponge, 64);
}

pub fn ml_kem_hash_j(msg: List[Int]) -> List[Int] {
    let mut sponge: KeccakSponge = keccak_sponge_new(136);
    keccak_sponge_absorb(&mut sponge, msg);
    return keccak_sponge_squeeze(&mut sponge, 32);
}

pub fn ml_kem_prf(seed: List[Int], nonce: Int, out_len: Int) -> List[Int] {
    let mut sponge: KeccakSponge = keccak_sponge_new(168);
    let mut input: List[Int] = list_new();
    let seed_len: Int = list_len(seed);
    let mut i: Int = 0;
    while i < seed_len {
        input = list_push(input, list_get(seed, i));
        i = i + 1;
    }
    input = list_push(input, nonce & 255);
    keccak_sponge_absorb(&mut sponge, input);
    return keccak_sponge_squeeze(&mut sponge, out_len);
}
