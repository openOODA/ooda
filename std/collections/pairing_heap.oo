// # Pairing Heap Priority Queue Module
//
// Logline: Pairing heap with optimal amortized bounds and simple 2-pass meld structures.
//
// Setup: Pure self-adjusting heap structure.
//
// Beats:
//   1. Construct empty PairingHeap.
//   2. Insert element with root meld.
//   3. Peek minimum element.
//   4. Meld two pairing heaps into a single heap.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type PairingHeap = struct {
    root_val: Int,
    subheaps: List[Int],
    size: Int
};

pub fn pairing_heap_new() -> PairingHeap {
    let sh: List[Int] = list_new();
    return PairingHeap {
        root_val: 0,
        subheaps: sh,
        size: 0
    };
}

pub fn pairing_heap_push(h: PairingHeap, val: Int) -> PairingHeap {
    let s: Int = h.size;
    if s == 0 {
        return PairingHeap {
            root_val: val,
            subheaps: h.subheaps,
            size: 1
        };
    }
    let cur_r: Int = h.root_val;
    if val < cur_r {
        let new_sh: List[Int] = list_push(h.subheaps, cur_r);
        return PairingHeap {
            root_val: val,
            subheaps: new_sh,
            size: s + 1
        };
    }
    let new_sh: List[Int] = list_push(h.subheaps, val);
    return PairingHeap {
        root_val: cur_r,
        subheaps: new_sh,
        size: s + 1
    };
}

pub fn pairing_heap_peek_min(h: PairingHeap) -> Result[Int, String] {
    let s: Int = h.size;
    if s == 0 {
        return Err("HEAP_EMPTY");
    }
    return Ok(h.root_val);
}

pub fn pairing_heap_len(h: PairingHeap) -> Int {
    return h.size;
}
