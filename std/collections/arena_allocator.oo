// # Monotonic Bump Arena Allocator Module
//
// Logline: Monotonic bump-pointer arena allocator with O(1) contiguous allocation, chunk resets, and high-watermark profiling.
//
// Setup: Pure memory allocator abstraction for phase-oriented memory management without individual object freeing.
//
// Beats:
//   1. Construct Arena descriptor with fixed contiguous byte capacity.
//   2. Bump-allocate contiguous memory slices (arena_alloc) with alignment bounds checking.
//   3. O(1) bulk memory reset (arena_reset) returning all allocations to pool.
//   4. Query allocated bytes, remaining capacity, and peak high-watermark.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Virtual memory page mapping / mprotect guards lower via OS virtual memory manager.

import "std/result.oo";

type Arena = struct {
    offset: Int,
    capacity: Int,
    high_watermark: Int
};

type ArenaAllocResult = struct {
    arena: Arena,
    offset: Int
};

pub fn arena_new(cap: Int) -> Arena {
    let mut c: Int = cap;
    if c <= 0 {
        c = 65536;
    }
    return Arena {
        offset: 0,
        capacity: c,
        high_watermark: 0
    };
}

pub fn arena_allocated_bytes(a: Arena) -> Int {
    return a.offset;
}

pub fn arena_remaining_bytes(a: Arena) -> Int {
    let cap: Int = a.capacity;
    let off: Int = a.offset;
    return cap - off;
}

pub fn arena_high_watermark(a: Arena) -> Int {
    return a.high_watermark;
}

pub fn arena_alloc(a: Arena, bytes: Int) -> Result[ArenaAllocResult, String] {
    if bytes <= 0 {
        return Err("invalid_size");
    }
    // 8-byte alignment
    let rem: Int = bytes % 8;
    let mut aligned: Int = bytes;
    if rem != 0 {
        aligned = bytes + (8 - rem);
    }

    let cur_off: Int = a.offset;
    let next_off: Int = cur_off + aligned;
    let cap: Int = a.capacity;

    if next_off > cap {
        return Err("arena_out_of_memory");
    }

    let mut hw: Int = a.high_watermark;
    if next_off > hw {
        hw = next_off;
    }

    let updated: Arena = Arena {
        offset: next_off,
        capacity: a.capacity,
        high_watermark: hw
    };
    return Ok(ArenaAllocResult {
        arena: updated,
        offset: cur_off
    });
}

pub fn arena_reset(a: Arena) -> Arena {
    return Arena {
        offset: 0,
        capacity: a.capacity,
        high_watermark: a.high_watermark
    };
}
