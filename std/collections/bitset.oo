// # Dense BitSet
//
// Logline: Bitset backed by one Int word for set, test, count, union, and intersect.
//
// Setup: Pure bit vector. Emit-c releases List and String struct fields after return.
//
// Beats:
//   1. Construct BitSet of specified bit capacity (capped at 63).
//   2. Set, clear, and test individual bit indices.
//   3. Compute set bit count (popcount) and check emptiness.
//   4. Perform bitwise union and intersection.
//
// residual: capacity is one 63-bit word; List/String field emit UAF

type BitSet = struct {
    word: Int,
    num_bits: Int
};

fn bitset_mask(bit: Int) -> Int {
    let mut m: Int = 1;
    let mut i: Int = 0;
    while i < bit {
        m = m * 2;
        i = i + 1;
    }
    return m;
}

pub fn bitset_new(num_bits: Int) -> BitSet {
    let mut n: Int = num_bits;
    if n < 0 {
        n = 0;
    }
    if n > 63 {
        n = 63;
    }
    return BitSet {
        word: 0,
        num_bits: n
    };
}

pub fn bitset_len(bs: BitSet) -> Int {
    return bs.num_bits;
}

pub fn bitset_clear(bs: BitSet) -> BitSet {
    return bitset_new(bs.num_bits);
}

pub fn bitset_set(bs: BitSet, bit: Int) -> BitSet {
    let n: Int = bs.num_bits;
    if bit < 0 || bit >= n {
        return bs;
    }
    let m: Int = bitset_mask(bit);
    let w: Int = bs.word;
    return BitSet {
        word: w | m,
        num_bits: n
    };
}

pub fn bitset_clear_bit(bs: BitSet, bit: Int) -> BitSet {
    let n: Int = bs.num_bits;
    if bit < 0 || bit >= n {
        return bs;
    }
    let m: Int = bitset_mask(bit);
    let w: Int = bs.word;
    return BitSet {
        word: (w | m) - m,
        num_bits: n
    };
}

pub fn bitset_test(bs: BitSet, bit: Int) -> Bool {
    let n: Int = bs.num_bits;
    if bit < 0 || bit >= n {
        return false;
    }
    let m: Int = bitset_mask(bit);
    let w: Int = bs.word;
    return (w & m) != 0;
}

pub fn bitset_count(bs: BitSet) -> Int {
    let n: Int = bs.num_bits;
    let mut cur: Int = bs.word;
    let mut total: Int = 0;
    let mut i: Int = 0;
    while i < n {
        if (cur & 1) == 1 {
            total = total + 1;
        }
        cur = cur / 2;
        i = i + 1;
    }
    return total;
}

pub fn bitset_is_empty(bs: BitSet) -> Bool {
    return bitset_count(bs) == 0;
}

pub fn bitset_union(a: BitSet, b: BitSet) -> BitSet {
    let mut n: Int = a.num_bits;
    let bn: Int = b.num_bits;
    if bn > n {
        n = bn;
    }
    if n > 63 {
        n = 63;
    }
    let aw: Int = a.word;
    let bw: Int = b.word;
    return BitSet {
        word: aw | bw,
        num_bits: n
    };
}

pub fn bitset_intersect(a: BitSet, b: BitSet) -> BitSet {
    let mut n: Int = a.num_bits;
    let bn: Int = b.num_bits;
    if bn < n {
        n = bn;
    }
    let aw: Int = a.word;
    let bw: Int = b.word;
    return BitSet {
        word: aw & bw,
        num_bits: n
    };
}
