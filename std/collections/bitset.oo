// # Dense BitSet
//
// Logline: Bitset backed by integer words for bit manipulation and membership testing.
//
// Setup: Pure bit vector implementing set, clear, test, count, union, and intersect.
//
// Beats:
//   1. Construct BitSet of specified bit capacity.
//   2. Set, clear, and test individual bit indices.
//   3. Compute set bit count (popcount) and check emptiness.
//   4. Perform bitwise union and intersection.
//
// residual: in-memory list of 64-bit integer words; bit index = word*64 + offset

type BitSet = struct {
    words: List[Int],
    num_bits: Int
};

// Create a new BitSet capable of holding num_bits bits.
pub fn bitset_new(num_bits: Int) -> BitSet {
    let mut total_bits: Int = num_bits;
    if total_bits < 0 {
        total_bits = 0;
    }
    let num_words: Int = (total_bits + 63) / 64;
    let mut ws: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_words {
        ws = list_push(ws, 0);
        i = i + 1;
    }
    return BitSet {
        words: ws,
        num_bits: total_bits
    };
}

// Return bit capacity of the bitset.
pub fn bitset_len(bs: BitSet) -> Int {
    return bs.num_bits;
}

// Clear all bits.
pub fn bitset_clear(bs: BitSet) -> BitSet {
    return bitset_new(bs.num_bits);
}

fn bitset_set_word(ws: List[Int], idx: Int, val: Int, n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            out = list_push(out, val);
        } else {
            out = list_push(out, list_get(ws, i));
        }
        i = i + 1;
    }
    return out;
}

// Set bit at specified index to 1.
pub fn bitset_set(bs: BitSet, bit: Int) -> BitSet {
    let max_b: Int = bs.num_bits;
    if bit < 0 || bit >= max_b {
        return bs;
    }
    let word_idx: Int = bit / 64;
    let bit_offset: Int = bit % 64;
    let mask: Int = 1 << bit_offset;

    let num_words: Int = list_len(bs.words);
    let cur_word: Int = list_get(bs.words, word_idx);
    let updated_word: Int = cur_word | mask;
    let new_words: List[Int] = bitset_set_word(bs.words, word_idx, updated_word, num_words);

    return BitSet {
        words: new_words,
        num_bits: max_b
    };
}

// Clear bit at specified index to 0.
pub fn bitset_clear_bit(bs: BitSet, bit: Int) -> BitSet {
    let max_b: Int = bs.num_bits;
    if bit < 0 || bit >= max_b {
        return bs;
    }
    let word_idx: Int = bit / 64;
    let bit_offset: Int = bit % 64;
    let mask: Int = 1 << bit_offset;

    let num_words: Int = list_len(bs.words);
    let cur_word: Int = list_get(bs.words, word_idx);
    let updated_word: Int = (cur_word | mask) - mask;
    let new_words: List[Int] = bitset_set_word(bs.words, word_idx, updated_word, num_words);

    return BitSet {
        words: new_words,
        num_bits: max_b
    };
}

// Test if bit at specified index is 1.
pub fn bitset_test(bs: BitSet, bit: Int) -> Bool {
    let max_b: Int = bs.num_bits;
    if bit < 0 || bit >= max_b {
        return false;
    }
    let word_idx: Int = bit / 64;
    let bit_offset: Int = bit % 64;
    let cur_word: Int = list_get(bs.words, word_idx);
    let shifted: Int = cur_word >> bit_offset;
    return (shifted & 1) == 1;
}

fn word_popcount(w: Int) -> Int {
    let mut cur: Int = w;
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < 64 {
        if (cur & 1) == 1 {
            count = count + 1;
        }
        cur = cur >> 1;
        i = i + 1;
    }
    return count;
}

// Count total number of set bits (popcount).
pub fn bitset_count(bs: BitSet) -> Int {
    let mut total: Int = 0;
    let n: Int = list_len(bs.words);
    let mut i: Int = 0;
    while i < n {
        let w: Int = list_get(bs.words, i);
        total = total + word_popcount(w);
        i = i + 1;
    }
    return total;
}

// True when no bits are set.
pub fn bitset_is_empty(bs: BitSet) -> Bool {
    return bitset_count(bs) == 0;
}

// Bitwise union of two bitsets.
pub fn bitset_union(a: BitSet, b: BitSet) -> BitSet {
    let mut bits: Int = a.num_bits;
    let b_bits: Int = b.num_bits;
    if b_bits > bits {
        bits = b_bits;
    }
    let res: BitSet = bitset_new(bits);
    let na: Int = list_len(a.words);
    let nb: Int = list_len(b.words);
    let nr: Int = list_len(res.words);

    let mut new_words: List[Int] = list_new();
    let mut i: Int = 0;
    while i < nr {
        let mut wa: Int = 0;
        let mut wb: Int = 0;
        if i < na {
            wa = list_get(a.words, i);
        }
        if i < nb {
            wb = list_get(b.words, i);
        }
        new_words = list_push(new_words, wa | wb);
        i = i + 1;
    }

    return BitSet {
        words: new_words,
        num_bits: bits
    };
}

// Bitwise intersection of two bitsets.
pub fn bitset_intersect(a: BitSet, b: BitSet) -> BitSet {
    let mut bits: Int = a.num_bits;
    let b_bits: Int = b.num_bits;
    if b_bits < bits {
        bits = b_bits;
    }
    let res: BitSet = bitset_new(bits);
    let na: Int = list_len(a.words);
    let nb: Int = list_len(b.words);
    let nr: Int = list_len(res.words);

    let mut new_words: List[Int] = list_new();
    let mut i: Int = 0;
    while i < nr {
        let mut wa: Int = 0;
        let mut wb: Int = 0;
        if i < na {
            wa = list_get(a.words, i);
        }
        if i < nb {
            wb = list_get(b.words, i);
        }
        new_words = list_push(new_words, wa & wb);
        i = i + 1;
    }

    return BitSet {
        words: new_words,
        num_bits: bits
    };
}
