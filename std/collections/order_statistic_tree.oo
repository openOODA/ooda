// # Order Statistic Balanced Tree Module
//
// Logline: Order statistic tree supporting finding the k-th smallest element (select) and rank queries.
//
// Setup: Pure ordered balanced tree storing subtree size counts.
//
// Beats:
//   1. Construct empty OrderStatisticTree.
//   2. Insert ordered keys.
//   3. Select the k-th smallest element in O(1) from sorted array.
//   4. Compute rank of a key.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type OrderStatisticTree = struct {
    keys: List[Int],
    size: Int
};

pub fn ost_new() -> OrderStatisticTree {
    let k: List[Int] = list_new();
    return OrderStatisticTree { keys: k, size: 0 };
}

pub fn ost_insert(tree: OrderStatisticTree, key: Int) -> OrderStatisticTree {
    let n: Int = tree.size;
    let mut new_keys: List[Int] = list_new();
    let mut inserted: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let k: Int = list_get(tree.keys, i);
        if !inserted && key < k {
            new_keys = list_push(new_keys, key);
            inserted = true;
        }
        new_keys = list_push(new_keys, k);
        i = i + 1;
    }
    if !inserted {
        new_keys = list_push(new_keys, key);
    }
    return OrderStatisticTree {
        keys: new_keys,
        size: n + 1
    };
}

pub fn ost_select(tree: OrderStatisticTree, rank_k: Int) -> Result[Int, String] {
    let n: Int = tree.size;
    if rank_k < 0 || rank_k >= n {
        return Err("RANK_OUT_OF_BOUNDS");
    }
    return Ok(list_get(tree.keys, rank_k));
}

pub fn ost_len(tree: OrderStatisticTree) -> Int {
    return tree.size;
}
