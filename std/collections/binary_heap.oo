// # Binary Heap
//
// Logline: Max-heap for integer elements supporting push, pop, and peek.
//
// Setup: Pure array-backed binary max-heap maintaining root-maximum invariant.
//
// Beats:
//   1. Construct empty BinaryHeap and check length or emptiness.
//   2. Push integer elements into heap with sift-up.
//   3. Peek maximum element at root.
//   4. Pop maximum root element and clear heap.
//
// residual: fixed List[Int] tree representation; 0-indexed parent = (i-1)/2

type BinaryHeap = struct {
    data: List[Int],
    size: Int
};

// Create a new empty BinaryHeap.
pub fn heap_new() -> BinaryHeap {
    let d: List[Int] = list_new();
    return BinaryHeap {
        data: d,
        size: 0
    };
}

// Return number of elements in the heap.
pub fn heap_len(h: BinaryHeap) -> Int {
    return h.size;
}

// True when the heap contains no elements.
pub fn heap_is_empty(h: BinaryHeap) -> Bool {
    return h.size == 0;
}

// Return a new empty heap.
pub fn heap_clear() -> BinaryHeap {
    return heap_new();
}

fn heap_set_at(xs: List[Int], idx: Int, val: Int, n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            out = list_push(out, val);
        } else {
            out = list_push(out, list_get(xs, i));
        }
        i = i + 1;
    }
    return out;
}

// Push element into heap with sift-up.
pub fn heap_push(h: BinaryHeap, val: Int) -> BinaryHeap {
    let n: Int = h.size;
    let mut d: List[Int] = list_push(h.data, val);
    let mut curr: Int = n;
    let total: Int = n + 1;

    while curr > 0 {
        let parent: Int = (curr - 1) / 2;
        let c_val: Int = list_get(d, curr);
        let p_val: Int = list_get(d, parent);
        if c_val > p_val {
            d = heap_set_at(d, curr, p_val, total);
            d = heap_set_at(d, parent, c_val, total);
            curr = parent;
        } else {
            break;
        }
    }

    return BinaryHeap {
        data: d,
        size: total
    };
}

// Peek maximum element at root.
pub fn heap_peek(h: BinaryHeap) -> Result[Int, String] {
    if h.size == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(h.data, 0));
}

// Pop maximum root element with sift-down.
pub fn heap_pop(h: BinaryHeap) -> BinaryHeap {
    let n: Int = h.size;
    if n <= 1 {
        return heap_new();
    }

    let last_val: Int = list_get(h.data, n - 1);
    let mut d: List[Int] = list_new();
    let mut k: Int = 0;
    let new_len: Int = n - 1;
    while k < new_len {
        d = list_push(d, list_get(h.data, k));
        k = k + 1;
    }
    d = heap_set_at(d, 0, last_val, new_len);

    let mut curr: Int = 0;
    while curr < new_len {
        let left: Int = 2 * curr + 1;
        let right: Int = 2 * curr + 2;
        let mut largest: Int = curr;

        if left < new_len {
            let l_val: Int = list_get(d, left);
            let big_val: Int = list_get(d, largest);
            if l_val > big_val {
                largest = left;
            }
        }
        if right < new_len {
            let r_val: Int = list_get(d, right);
            let big_val2: Int = list_get(d, largest);
            if r_val > big_val2 {
                largest = right;
            }
        }

        if largest != curr {
            let cur_val: Int = list_get(d, curr);
            let top_val: Int = list_get(d, largest);
            d = heap_set_at(d, curr, top_val, new_len);
            d = heap_set_at(d, largest, cur_val, new_len);
            curr = largest;
        } else {
            break;
        }
    }

    return BinaryHeap {
        data: d,
        size: new_len
    };
}

// Check if value is contained in the heap.
pub fn heap_contains(h: BinaryHeap, val: Int) -> Bool {
    let n: Int = h.size;
    let mut i: Int = 0;
    while i < n {
        if list_get(h.data, i) == val {
            return true;
        }
        i = i + 1;
    }
    return false;
}
