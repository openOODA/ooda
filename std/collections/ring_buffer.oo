// # Fixed-Capacity Ring Buffer
//
// Logline: Circular FIFO buffer with fixed capacity overwriting oldest items.
//
// Setup: Pure circular buffer maintaining FIFO order up to fixed capacity limit.
//
// Beats:
//   1. Construct RingBuffer with specified maximum capacity.
//   2. Push elements, dropping oldest if buffer is full.
//   3. Peek oldest element without removing it.
//   4. Pop oldest element and query capacity or fullness.
//
// residual: in-memory list tracking circular FIFO elements

type RingBuffer = struct {
    data: List[Int],
    capacity: Int,
    size: Int
};

// Create a new RingBuffer with specified capacity limit.
pub fn ring_buffer_new(capacity: Int) -> RingBuffer {
    let mut cap: Int = capacity;
    if cap < 1 {
        cap = 1;
    }
    let d: List[Int] = list_new();
    return RingBuffer {
        data: d,
        capacity: cap,
        size: 0
    };
}

// Return number of elements currently in the buffer.
pub fn ring_buffer_len(rb: RingBuffer) -> Int {
    return rb.size;
}

// Return maximum capacity of the buffer.
pub fn ring_buffer_capacity(rb: RingBuffer) -> Int {
    return rb.capacity;
}

// True when the buffer contains no elements.
pub fn ring_buffer_is_empty(rb: RingBuffer) -> Bool {
    return rb.size == 0;
}

// True when the buffer has reached maximum capacity.
pub fn ring_buffer_is_full(rb: RingBuffer) -> Bool {
    return rb.size == rb.capacity;
}

// Clear all elements, preserving capacity.
pub fn ring_buffer_clear(rb: RingBuffer) -> RingBuffer {
    return ring_buffer_new(rb.capacity);
}

// Push element into buffer, dropping oldest if already full.
pub fn ring_buffer_push(rb: RingBuffer, val: Int) -> RingBuffer {
    let n: Int = rb.size;
    let cap: Int = rb.capacity;

    if n < cap {
        let new_data: List[Int] = list_push(rb.data, val);
        return RingBuffer {
            data: new_data,
            capacity: cap,
            size: n + 1
        };
    }

    // Buffer is full: drop element at index 0 (oldest), append new
    let mut new_data2: List[Int] = list_new();
    let mut i: Int = 1;
    while i < n {
        new_data2 = list_push(new_data2, list_get(rb.data, i));
        i = i + 1;
    }
    new_data2 = list_push(new_data2, val);
    return RingBuffer {
        data: new_data2,
        capacity: cap,
        size: cap
    };
}

// Pop oldest element (index 0).
pub fn ring_buffer_pop(rb: RingBuffer) -> RingBuffer {
    let n: Int = rb.size;
    if n <= 1 {
        return ring_buffer_new(rb.capacity);
    }
    let mut new_data: List[Int] = list_new();
    let mut i: Int = 1;
    while i < n {
        new_data = list_push(new_data, list_get(rb.data, i));
        i = i + 1;
    }
    return RingBuffer {
        data: new_data,
        capacity: rb.capacity,
        size: n - 1
    };
}

// Peek oldest element.
pub fn ring_buffer_peek(rb: RingBuffer) -> Result[Int, String] {
    if rb.size == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(rb.data, 0));
}

// Get element at offset from oldest (0 = oldest).
pub fn ring_buffer_get(rb: RingBuffer, index: Int) -> Result[Int, String] {
    let n: Int = rb.size;
    if index < 0 || index >= n {
        return Err("INDEX_OUT_OF_BOUNDS");
    }
    return Ok(list_get(rb.data, index));
}
