// # Banded Diagonal Matrix Storage Module
//
// Logline: Banded diagonal matrix storing lower, main, and upper diagonals in compact row-major bands.
//
// Setup: Pure numerical container optimizing tridiagonal and banded linear systems.
//
// Beats:
//   1. Construct BandedMatrix with dimension N and lower/upper bandwidth.
//   2. Get and set elements within diagonal bands.
//   3. Compute diagonal trace.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type BandedMatrix = struct {
    dim: Int,
    lower_bandwidth: Int,
    upper_bandwidth: Int,
    diagonal: List[Int]
};

pub fn banded_matrix_new(dim: Int, lower_bw: Int, upper_bw: Int) -> BandedMatrix {
    let mut d: List[Int] = list_new();
    let mut i: Int = 0;
    while i < dim {
        d = list_push(d, 0);
        i = i + 1;
    }
    return BandedMatrix {
        dim: dim,
        lower_bandwidth: lower_bw,
        upper_bandwidth: upper_bw,
        diagonal: d
    };
}

pub fn banded_matrix_set_diag(m: BandedMatrix, idx: Int, val: Int) -> BandedMatrix {
    let d: Int = m.dim;
    let mut new_diag: List[Int] = list_new();
    let mut i: Int = 0;
    while i < d {
        if i == idx {
            new_diag = list_push(new_diag, val);
        } else {
            new_diag = list_push(new_diag, list_get(m.diagonal, i));
        }
        i = i + 1;
    }
    return BandedMatrix {
        dim: d,
        lower_bandwidth: m.lower_bandwidth,
        upper_bandwidth: m.upper_bandwidth,
        diagonal: new_diag
    };
}

pub fn banded_matrix_trace(m: BandedMatrix) -> Int {
    let d: Int = m.dim;
    let mut total: Int = 0;
    let mut i: Int = 0;
    while i < d {
        total = total + list_get(m.diagonal, i);
        i = i + 1;
    }
    return total;
}
