// # String Hash Set
//
// Logline: Set collection for storing unique string elements.
//
// Setup: Pure collection maintaining distinct string items.
//
// Beats:
//   1. Construct empty HashSet and test emptiness.
//   2. Insert unique elements.
//   3. Query element containment.
//   4. Remove elements and list all members.
//
// residual: in-memory list tracking unique string values

type HashSet = struct {
    elements: List[Int],
    size: Int
};

// Create a new empty HashSet.
pub fn hash_set_new() -> HashSet {
    let elems: List[Int] = list_new();
    return HashSet {
        elements: elems,
        size: 0
    };
}

// Return number of elements in the set.
pub fn hash_set_len(s: HashSet) -> Int {
    return s.size;
}

// True when the set contains no elements.
pub fn hash_set_is_empty(s: HashSet) -> Bool {
    return s.size == 0;
}

// Return a new empty set.
pub fn hash_set_clear() -> HashSet {
    return hash_set_new();
}

fn hash_set_find_idx(s: HashSet, val: Int) -> Int {
    let n: Int = s.size;
    let mut i: Int = 0;
    while i < n {
        if list_get(s.elements, i) == val {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Check if element is in the set.
pub fn hash_set_contains(s: HashSet, val: Int) -> Bool {
    let idx: Int = hash_set_find_idx(s, val);
    return idx >= 0;
}

// Insert element into set if not already present.
pub fn hash_set_insert(s: HashSet, val: Int) -> HashSet {
    if hash_set_contains(s, val) {
        return s;
    }
    let new_elems: List[Int] = list_push(s.elements, val);
    let n: Int = s.size;
    return HashSet {
        elements: new_elems,
        size: n + 1
    };
}

// Remove element from set if present.
pub fn hash_set_remove(s: HashSet, val: Int) -> HashSet {
    let idx: Int = hash_set_find_idx(s, val);
    if idx < 0 {
        return s;
    }
    let n: Int = s.size;
    let mut new_elems: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i != idx {
            new_elems = list_push(new_elems, list_get(s.elements, i));
        }
        i = i + 1;
    }
    return HashSet {
        elements: new_elems,
        size: n - 1
    };
}

// Return list of all elements in the set.
pub fn hash_set_to_list(s: HashSet) -> List[Int] {
    return s.elements;
}
