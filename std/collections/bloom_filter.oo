// # Bloom Filter
//
// Logline: Probabilistic set membership filter with zero false negatives.
//
// Setup: Pure bit array using multiple rolling hash functions for fast membership testing.
//
// Beats:
//   1. Construct BloomFilter with specified bit capacity and hash count.
//   2. Add string items by setting computed bit indices.
//   3. Test string membership.
//   4. Clear filter and query size or bit count.
//
// residual: in-memory bitset with deterministic string hash seeds

type BloomFilter = struct {
    words: List[Int],
    num_bits: Int,
    num_hashes: Int,
    size: Int
};

// Create a new BloomFilter with given bit capacity and number of hashes.
pub fn bloom_new(num_bits: Int, num_hashes: Int) -> BloomFilter {
    let mut bits: Int = num_bits;
    if bits < 64 {
        bits = 64;
    }
    let mut k: Int = num_hashes;
    if k < 1 {
        k = 1;
    }
    let num_words: Int = (bits + 63) / 64;
    let mut ws: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_words {
        ws = list_push(ws, 0);
        i = i + 1;
    }
    return BloomFilter {
        words: ws,
        num_bits: bits,
        num_hashes: k,
        size: 0
    };
}

// Return number of inserted items.
pub fn bloom_len(bf: BloomFilter) -> Int {
    return bf.size;
}

// Return total number of bits allocated.
pub fn bloom_num_bits(bf: BloomFilter) -> Int {
    return bf.num_bits;
}

// True when filter has no inserted elements.
pub fn bloom_is_empty(bf: BloomFilter) -> Bool {
    return bf.size == 0;
}

// Clear all bits, resetting filter.
pub fn bloom_clear(bf: BloomFilter) -> BloomFilter {
    return bloom_new(bf.num_bits, bf.num_hashes);
}

fn bloom_hash(s: String, seed: Int, max_val: Int) -> Int {
    let n: Int = chars_len(s);
    let mut h: Int = seed * 31 + 17;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        let o: Int = ord(c);
        h = (h * 37 + o) % 2147483647;
        i = i + 1;
    }
    let mut res: Int = h % max_val;
    if res < 0 {
        res = 0 - res;
    }
    return res;
}

fn bloom_set_word(ws: List[Int], idx: Int, val: Int, n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            out = list_push(out, val);
        } else {
            out = list_push(out, list_get(ws, i));
        }
        i = i + 1;
    }
    return out;
}

// Add string item to the bloom filter.
pub fn bloom_add(bf: BloomFilter, item: String) -> BloomFilter {
    let max_b: Int = bf.num_bits;
    let k: Int = bf.num_hashes;
    let mut current_words: List[Int] = bf.words;
    let num_words: Int = list_len(current_words);

    let mut seed: Int = 1;
    while seed <= k {
        let bit: Int = bloom_hash(item, seed, max_b);
        let word_idx: Int = bit / 64;
        let bit_offset: Int = bit % 64;
        let mask: Int = 1 << bit_offset;

        let cur_word: Int = list_get(current_words, word_idx);
        let updated: Int = cur_word | mask;
        current_words = bloom_set_word(current_words, word_idx, updated, num_words);
        seed = seed + 1;
    }

    return BloomFilter {
        words: current_words,
        num_bits: max_b,
        num_hashes: k,
        size: bf.size + 1
    };
}

// Query whether item may be in the set (true = probably present, false = definitely not).
pub fn bloom_contains(bf: BloomFilter, item: String) -> Bool {
    let max_b: Int = bf.num_bits;
    let k: Int = bf.num_hashes;

    let mut seed: Int = 1;
    while seed <= k {
        let bit: Int = bloom_hash(item, seed, max_b);
        let word_idx: Int = bit / 64;
        let bit_offset: Int = bit % 64;

        let cur_word: Int = list_get(bf.words, word_idx);
        let shifted: Int = cur_word >> bit_offset;
        if (shifted & 1) == 0 {
            return false;
        }
        seed = seed + 1;
    }
    return true;
}
