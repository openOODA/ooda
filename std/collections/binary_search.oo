// # Binary Search and Partition Point Algorithms Module
//
// Logline: Logarithmic binary search, exact matching, lower bound, upper bound, and partition point searching on sorted slices.
//
// Setup: Pure algorithmic search module over sorted List[Int] collections.
//
// Beats:
//   1. Exact binary search with Result index or Err.
//   2. Lower bound search returning first index where element >= target.
//   3. Upper bound search returning first index where element > target.
//   4. Partition point and membership containment tests.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Branchless binary search (Eytzinger layout) lowers via hardware cache layout optimizer.

import "std/result.oo";

pub fn binary_search_lower_bound(xs: List[Int], target: Int) -> Int {
    let mut low: Int = 0;
    let mut high: Int = list_len(xs);
    while low < high {
        let mid: Int = low + (high - low) / 2;
        let mid_val: Int = list_get(xs, mid);
        if mid_val < target {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

pub fn binary_search_upper_bound(xs: List[Int], target: Int) -> Int {
    let mut low: Int = 0;
    let mut high: Int = list_len(xs);
    while low < high {
        let mid: Int = low + (high - low) / 2;
        let mid_val: Int = list_get(xs, mid);
        if mid_val <= target {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

pub fn binary_search_partition_point(xs: List[Int], target: Int) -> Int {
    return binary_search_lower_bound(xs, target);
}

pub fn binary_search_exact(xs: List[Int], target: Int) -> Result[Int, String] {
    let n: Int = list_len(xs);
    let idx: Int = binary_search_lower_bound(xs, target);
    if idx < n {
        let val: Int = list_get(xs, idx);
        if val == target {
            return Ok(idx);
        }
    }
    return Err("not_found");
}

pub fn binary_search_contains(xs: List[Int], target: Int) -> Bool {
    let r: Result[Int, String] = binary_search_exact(xs, target);
    return r.is_ok();
}
