// # Doubly-Linked List Sequence Module
//
// Logline: Doubly-linked list with bidirectional traversal, head and tail insertion, and element removal.
//
// Setup: Pure bidirectional sequence structure.
//
// Beats:
//   1. Construct empty DoublyLinkedList.
//   2. Push elements to front and back.
//   3. Pop elements from front and back.
//   4. Query list size and forward/reverse elements.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type DoublyLinkedList = struct {
    nodes: List[String],
    size: Int
};

pub fn dlist_new() -> DoublyLinkedList {
    let n: List[String] = list_new();
    return DoublyLinkedList { nodes: n, size: 0 };
}

pub fn dlist_push_back(list: DoublyLinkedList, val: String) -> DoublyLinkedList {
    let new_nodes: List[String] = list_push(list.nodes, val);
    let s: Int = list.size;
    return DoublyLinkedList {
        nodes: new_nodes,
        size: s + 1
    };
}

pub fn dlist_push_front(list: DoublyLinkedList, val: String) -> DoublyLinkedList {
    let mut new_nodes: List[String] = list_new();
    new_nodes = list_push(new_nodes, val);
    let n: Int = list.size;
    let mut i: Int = 0;
    while i < n {
        new_nodes = list_push(new_nodes, list_get(list.nodes, i));
        i = i + 1;
    }
    return DoublyLinkedList {
        nodes: new_nodes,
        size: n + 1
    };
}

pub fn dlist_peek_front(list: DoublyLinkedList) -> Result[String, String] {
    let s: Int = list.size;
    if s == 0 {
        return Err("LIST_EMPTY");
    }
    return Ok(list_get(list.nodes, 0));
}

pub fn dlist_peek_back(list: DoublyLinkedList) -> Result[String, String] {
    let s: Int = list.size;
    if s == 0 {
        return Err("LIST_EMPTY");
    }
    return Ok(list_get(list.nodes, s - 1));
}

pub fn dlist_len(list: DoublyLinkedList) -> Int {
    return list.size;
}
