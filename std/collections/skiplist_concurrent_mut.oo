// # Skip list insert and delete
//
// Logline: Inserts and deletes keys on a skip list while splicing forward pointers at every live level.
//
// Setup: Pure. Reuses deleted slots. Height is drawn from the packed LCG and clamped at 32.
//
// Beats:
//   1. Draw a height in 1..32 and find predecessor towers.
//   2. Splice a new node or update an existing key.
//   3. Unlink a deleted node at every level it occupies.
//   4. Keep head and per-node forward arrays consistent.

import "std/collections/skiplist_concurrent.oo";

pub fn skiplist_concurrent_mut_alive() -> Int { return 1; }

fn sl_copy(sl: SkipList, keys: List[Int], vals: List[Int], height: List[Int], head: List[Int], fwd: List[Int], free: List[Int], n: Int, top: Int, seed: Int) -> SkipList {
    return SkipList {
        seed: seed,
        n: n,
        top: top,
        keys: keys,
        vals: vals,
        height: height,
        head: head,
        fwd: fwd,
        free: free
    };
}

fn sl_link(sl: SkipList, node: Int, h: Int, upd: List[Int]) -> SkipList {
    let mut head: List[Int] = sl.head;
    let mut fwd: List[Int] = sl.fwd;
    let mut i: Int = 0;
    while i < h {
        let pred: Int = list_get(upd, i);
        let old: Int = sl_fwd(sl, pred, i);
        fwd = sl_iset(fwd, node * 32 + i, old);
        if pred < 0 {
            head = sl_iset(head, i, node);
        } else {
            fwd = sl_iset(fwd, pred * 32 + i, node);
        }
        i = i + 1;
    }
    let mut top: Int = sl.top;
    if h > top {
        top = h;
    }
    return sl_copy(sl, sl.keys, sl.vals, sl.height, head, fwd, sl.free, sl.n, top, sl.seed);
}

pub fn skiplist_concurrent_insert(sl0: SkipList, key: Int, val: Int) -> SkipList {
    let found: Result[Int, String] = skiplist_concurrent_search(sl0, key);
    if found.is_ok() {
        let mut x: Int = 0 - 1;
        let mut nx: Int = sl_fwd(sl0, x, 0);
        while nx >= 0 {
            if list_get(sl0.keys, nx) == key {
                let vals: List[Int] = sl_iset(sl0.vals, nx, val);
                return sl_copy(sl0, sl0.keys, vals, sl0.height, sl0.head, sl0.fwd, sl0.free, sl0.n, sl0.top, sl0.seed);
            }
            nx = sl_fwd(sl0, nx, 0);
        }
    }
    let dr: List[Int] = sl_draw(sl0.seed);
    let seed: Int = list_get(dr, 0);
    let h: Int = list_get(dr, 1);
    let upd: List[Int] = sl_preds(sl0, key);
    let mut keys: List[Int] = sl0.keys;
    let mut vals: List[Int] = sl0.vals;
    let mut height: List[Int] = sl0.height;
    let mut fwd: List[Int] = sl0.fwd;
    let mut free: List[Int] = sl0.free;
    let mut n: Int = sl0.n;
    let mut node: Int = n;
    if list_len(free) > 0 {
        node = list_get(free, list_len(free) - 1);
        let mut nf: List[Int] = list_new();
        let mut i: Int = 0;
        while i < list_len(free) - 1 {
            nf = list_push(nf, list_get(free, i));
            i = i + 1;
        }
        free = nf;
        keys = sl_iset(keys, node, key);
        vals = sl_iset(vals, node, val);
        height = sl_iset(height, node, h);
    } else {
        keys = list_push(keys, key);
        vals = list_push(vals, val);
        height = list_push(height, h);
        let mut z: Int = 0;
        while z < 32 {
            fwd = list_push(fwd, 0 - 1);
            z = z + 1;
        }
        n = n + 1;
    }
    let sl1: SkipList = sl_copy(sl0, keys, vals, height, sl0.head, fwd, free, n, sl0.top, seed);
    return sl_link(sl1, node, h, upd);
}

pub fn skiplist_concurrent_delete(sl0: SkipList, key: Int) -> SkipList {
    let found: Result[Int, String] = skiplist_concurrent_search(sl0, key);
    if found.is_err() {
        return sl0;
    }
    let upd: List[Int] = sl_preds(sl0, key);
    let node: Int = sl_fwd(sl0, list_get(upd, 0), 0);
    if node < 0 {
        return sl0;
    }
    if list_get(sl0.keys, node) != key {
        return sl0;
    }
    let h: Int = list_get(sl0.height, node);
    let mut head: List[Int] = sl0.head;
    let mut fwd: List[Int] = sl0.fwd;
    let mut i: Int = 0;
    while i < h {
        let pred: Int = list_get(upd, i);
        let nxt: Int = sl_fwd(sl0, node, i);
        if pred < 0 {
            head = sl_iset(head, i, nxt);
        } else {
            fwd = sl_iset(fwd, pred * 32 + i, nxt);
        }
        i = i + 1;
    }
    let height: List[Int] = sl_iset(sl0.height, node, 0);
    let mut free: List[Int] = sl0.free;
    free = list_push(free, node);
    return sl_copy(sl0, sl0.keys, sl0.vals, height, head, fwd, free, sl0.n, sl0.top, sl0.seed);
}
