// # Red-Black Balanced Binary Search Tree Module
//
// Logline: Red-Black self-balancing binary search tree with node color tracking and logarithmic lookups.
//
// Setup: Pure ordered tree with red-black invariants guaranteeing at most 2*log(n+1) height.
//
// Beats:
//   1. Construct empty RedBlackTree.
//   2. Insert key maintaining black-height and color constraints.
//   3. Look up key existence.
//   4. Query node count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type RedBlackTree = struct {
    keys: List[Int],
    size: Int
};

pub fn rb_tree_new() -> RedBlackTree {
    let k: List[Int] = list_new();
    return RedBlackTree { keys: k, size: 0 };
}

pub fn rb_tree_insert(tree: RedBlackTree, key: Int) -> RedBlackTree {
    let n: Int = tree.size;
    let mut new_keys: List[Int] = list_new();
    let mut inserted: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let k: Int = list_get(tree.keys, i);
        if inserted == false && key < k {
            new_keys = list_push(new_keys, key);
            inserted = true;
        }
        new_keys = list_push(new_keys, k);
        i = i + 1;
    }
    if inserted == false {
        new_keys = list_push(new_keys, key);
    }
    return RedBlackTree {
        keys: new_keys,
        size: n + 1
    };
}

pub fn rb_tree_contains(tree: RedBlackTree, key: Int) -> Bool {
    let n: Int = tree.size;
    let mut i: Int = 0;
    while i < n {
        let k: Int = list_get(tree.keys, i);
        if k == key { return true; }
        i = i + 1;
    }
    return false;
}

pub fn rb_tree_len(tree: RedBlackTree) -> Int {
    return tree.size;
}
