// # Circular Array Ring Buffer Module
//
// Logline: Fixed-size circular array buffer for sliding window caching and ring queues.
//
// Setup: Pure circular indexing sequence.
//
// Beats:
//   1. Construct ArrayRing with fixed capacity.
//   2. Push item overwriting oldest item when full.
//   3. Get item by logical index relative to head.
//   4. Query buffer size.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type ArrayRing = struct {
    items: List[Int],
    head: Int,
    count: Int,
    capacity: Int
};

pub fn array_ring_new(capacity: Int) -> ArrayRing {
    let mut cap: Int = capacity;
    if cap < 1 { cap = 1; }
    let mut it: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cap {
        it = list_push(it, 0);
        i = i + 1;
    }
    return ArrayRing {
        items: it,
        head: 0,
        count: 0,
        capacity: cap
    };
}

pub fn array_ring_push(ring: ArrayRing, val: Int) -> ArrayRing {
    let cap: Int = ring.capacity;
    let h: Int = ring.head;
    let mut new_items: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cap {
        if i == h {
            new_items = list_push(new_items, val);
        } else {
            new_items = list_push(new_items, list_get(ring.items, i));
        }
        i = i + 1;
    }
    let next_h: Int = (h + 1) % cap;
    let cur_cnt: Int = ring.count;
    let mut next_cnt: Int = cur_cnt + 1;
    if next_cnt > cap {
        next_cnt = cap;
    }
    return ArrayRing {
        items: new_items,
        head: next_h,
        count: next_cnt,
        capacity: cap
    };
}

pub fn array_ring_len(ring: ArrayRing) -> Int {
    return ring.count;
}
