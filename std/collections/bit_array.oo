// # Dynamic Dense Bit Array Module
//
// Logline: Dynamic dense bit array with bitwise Boolean algebra (AND, OR, XOR), bit toggling, and population counting.
//
// Setup: Pure collection mapping bit positions to compact 64-bit integer words.
//
// Beats:
//   1. Construct BitArray with arbitrary bit length capacity.
//   2. Get, set, clear, and toggle individual bit flags.
//   3. Pairwise bitwise Boolean operations: and, or, xor.
//   4. Population count (popcount) and bit vector length inspection.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: AVX-512 VPOPCNTDQ vector instructions lower via compiler backend.

import "std/result.oo";

type BitArray = struct {
    words: List[Int],
    bit_len: Int
};

pub fn bit_array_new(num_bits: Int) -> BitArray {
    let mut total: Int = num_bits;
    if total < 0 {
        total = 0;
    }
    let num_words: Int = (total + 63) / 64;
    let mut ws: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_words {
        ws = list_push(ws, 0);
        i = i + 1;
    }
    return BitArray {
        words: ws,
        bit_len: total
    };
}

pub fn bit_array_len(ba: BitArray) -> Int {
    return ba.bit_len;
}

pub fn bit_array_get(ba: BitArray, idx: Int) -> Bool {
    let blen: Int = ba.bit_len;
    if idx < 0 || idx >= blen {
        return false;
    }
    let word_idx: Int = idx / 64;
    let bit_offset: Int = idx % 64;
    let w: Int = list_get(ba.words, word_idx);
    let shifted: Int = w >> bit_offset;
    return (shifted & 1) == 1;
}

fn bit_array_set_word(ws: List[Int], idx: Int, val: Int, n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            out = list_push(out, val);
        } else {
            out = list_push(out, list_get(ws, i));
        }
        i = i + 1;
    }
    return out;
}

pub fn bit_array_set(ba: BitArray, idx: Int) -> BitArray {
    let blen: Int = ba.bit_len;
    if idx < 0 || idx >= blen {
        return ba;
    }
    let word_idx: Int = idx / 64;
    let bit_offset: Int = idx % 64;
    let mask: Int = 1 << bit_offset;

    let num_words: Int = list_len(ba.words);
    let cur_w: Int = list_get(ba.words, word_idx);
    let updated_w: Int = cur_w | mask;
    let next_words: List[Int] = bit_array_set_word(ba.words, word_idx, updated_w, num_words);

    return BitArray {
        words: next_words,
        bit_len: ba.bit_len
    };
}

pub fn bit_array_clear_bit(ba: BitArray, idx: Int) -> BitArray {
    let blen: Int = ba.bit_len;
    if idx < 0 || idx >= blen {
        return ba;
    }
    let word_idx: Int = idx / 64;
    let bit_offset: Int = idx % 64;
    let mask: Int = 1 << bit_offset;

    let num_words: Int = list_len(ba.words);
    let cur_w: Int = list_get(ba.words, word_idx);
    let updated_w: Int = (cur_w | mask) - mask;
    let next_words: List[Int] = bit_array_set_word(ba.words, word_idx, updated_w, num_words);

    return BitArray {
        words: next_words,
        bit_len: ba.bit_len
    };
}

pub fn bit_array_toggle(ba: BitArray, idx: Int) -> BitArray {
    let is_set: Bool = bit_array_get(ba, idx);
    if is_set {
        return bit_array_clear_bit(ba, idx);
    }
    return bit_array_set(ba, idx);
}

pub fn bit_array_and(a: BitArray, b: BitArray) -> BitArray {
    let na: Int = list_len(a.words);
    let nb: Int = list_len(b.words);
    let mut min_w: Int = na;
    if nb < min_w { min_w = nb; }

    let mut new_words: List[Int] = list_new();
    let mut i: Int = 0;
    while i < min_w {
        let wa: Int = list_get(a.words, i);
        let wb: Int = list_get(b.words, i);
        new_words = list_push(new_words, wa & wb);
        i = i + 1;
    }
    let mut min_len: Int = a.bit_len;
    let b_len: Int = b.bit_len;
    if b_len < min_len { min_len = b_len; }
    return BitArray {
        words: new_words,
        bit_len: min_len
    };
}

pub fn bit_array_or(a: BitArray, b: BitArray) -> BitArray {
    let na: Int = list_len(a.words);
    let nb: Int = list_len(b.words);
    let mut min_w: Int = na;
    if nb < min_w { min_w = nb; }

    let mut new_words: List[Int] = list_new();
    let mut i: Int = 0;
    while i < min_w {
        let wa: Int = list_get(a.words, i);
        let wb: Int = list_get(b.words, i);
        new_words = list_push(new_words, wa | wb);
        i = i + 1;
    }
    let mut min_len: Int = a.bit_len;
    let b_len: Int = b.bit_len;
    if b_len < min_len { min_len = b_len; }
    return BitArray {
        words: new_words,
        bit_len: min_len
    };
}

pub fn bit_array_xor(a: BitArray, b: BitArray) -> BitArray {
    let na: Int = list_len(a.words);
    let nb: Int = list_len(b.words);
    let mut min_w: Int = na;
    if nb < min_w { min_w = nb; }

    let mut new_words: List[Int] = list_new();
    let mut i: Int = 0;
    while i < min_w {
        let wa: Int = list_get(a.words, i);
        let wb: Int = list_get(b.words, i);
        new_words = list_push(new_words, wa ^ wb);
        i = i + 1;
    }
    let mut min_len: Int = a.bit_len;
    let b_len: Int = b.bit_len;
    if b_len < min_len { min_len = b_len; }
    return BitArray {
        words: new_words,
        bit_len: min_len
    };
}

pub fn bit_array_popcount(ba: BitArray) -> Int {
    let mut total: Int = 0;
    let n: Int = list_len(ba.words);
    let mut i: Int = 0;
    while i < n {
        let mut w: Int = list_get(ba.words, i);
        let mut k: Int = 0;
        while k < 64 {
            if (w & 1) == 1 {
                total = total + 1;
            }
            w = w >> 1;
            k = k + 1;
        }
        i = i + 1;
    }
    return total;
}
