// # Dynamic Dense Bit Array Module
//
// Logline: Dynamic dense bit array with bitwise Boolean algebra (AND, OR, XOR), bit toggling, and population counting.
//
// Setup: Pure collection mapping bit positions to compact 64-bit integer words.
//
// Beats:
//   1. Construct BitArray with arbitrary bit length capacity.
//   2. Get, set, clear, and toggle individual bit flags.
//   3. Pairwise bitwise Boolean operations: and, or, xor.
//   4. Population count (popcount) and bit vector length inspection.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: AVX-512 VPOPCNTDQ vector instructions lower via compiler backend.

// residual: capacity is one 63-bit word; List[Int] field emit UAF

type BitArray = struct {
    word: Int,
    bit_len: Int
};

fn bit_array_mask(bit: Int) -> Int {
    let mut m: Int = 1;
    let mut i: Int = 0;
    while i < bit {
        m = m * 2;
        i = i + 1;
    }
    return m;
}

pub fn bit_array_new(num_bits: Int) -> BitArray {
    let mut total: Int = num_bits;
    if total < 0 {
        total = 0;
    }
    if total > 63 {
        total = 63;
    }
    return BitArray {
        word: 0,
        bit_len: total
    };
}

pub fn bit_array_len(ba: BitArray) -> Int {
    return ba.bit_len;
}

pub fn bit_array_get(ba: BitArray, idx: Int) -> Bool {
    let blen: Int = ba.bit_len;
    if idx < 0 || idx >= blen {
        return false;
    }
    let m: Int = bit_array_mask(idx);
    let w: Int = ba.word;
    return (w & m) == m;
}

pub fn bit_array_set(ba: BitArray, idx: Int) -> BitArray {
    let blen: Int = ba.bit_len;
    if idx < 0 || idx >= blen {
        return ba;
    }
    let m: Int = bit_array_mask(idx);
    let w: Int = ba.word;
    return BitArray {
        word: w | m,
        bit_len: blen
    };
}

pub fn bit_array_clear_bit(ba: BitArray, idx: Int) -> BitArray {
    let blen: Int = ba.bit_len;
    if idx < 0 || idx >= blen {
        return ba;
    }
    let m: Int = bit_array_mask(idx);
    let w: Int = ba.word;
    return BitArray {
        word: (w | m) - m,
        bit_len: blen
    };
}

pub fn bit_array_toggle(ba: BitArray, idx: Int) -> BitArray {
    let is_set: Bool = bit_array_get(ba, idx);
    if is_set {
        return bit_array_clear_bit(ba, idx);
    }
    return bit_array_set(ba, idx);
}

pub fn bit_array_and(a: BitArray, b: BitArray) -> BitArray {
    let wa: Int = a.word;
    let wb: Int = b.word;
    let mut min_len: Int = a.bit_len;
    let b_len: Int = b.bit_len;
    if b_len < min_len { min_len = b_len; }
    return BitArray {
        word: wa & wb,
        bit_len: min_len
    };
}

pub fn bit_array_or(a: BitArray, b: BitArray) -> BitArray {
    let wa: Int = a.word;
    let wb: Int = b.word;
    let mut min_len: Int = a.bit_len;
    let b_len: Int = b.bit_len;
    if b_len < min_len { min_len = b_len; }
    return BitArray {
        word: wa | wb,
        bit_len: min_len
    };
}

pub fn bit_array_xor(a: BitArray, b: BitArray) -> BitArray {
    let wa: Int = a.word;
    let wb: Int = b.word;
    let mut min_len: Int = a.bit_len;
    let b_len: Int = b.bit_len;
    if b_len < min_len { min_len = b_len; }
    return BitArray {
        word: wa ^ wb,
        bit_len: min_len
    };
}

pub fn bit_array_popcount(ba: BitArray) -> Int {
    let mut total: Int = 0;
    let mut w: Int = ba.word;
    let mut k: Int = 0;
    while k < 63 {
        if (w & 1) == 1 {
            total = total + 1;
        }
        w = w / 2;
        k = k + 1;
    }
    return total;
}
