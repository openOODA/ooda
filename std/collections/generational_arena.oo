// # Generational Index Slot Map Arena Module
//
// Logline: Slot map destubbed to parallel List[Int] vals/gens/occ (no List[SlotEntry]).
//
// Setup: Pure collection. Emit-c cannot lower List[struct] as oo_ilist_*.
//
// Beats:
//   1. Construct empty arena.
//   2. Insert Int values; length increases.
//   3. Contains via generation-tagged index.
// residual: List[SlotEntry] destubbed to three List[Int] columns.

type ArenaIndex = struct {
    index: Int,
    generation: Int
};

type GenerationalArena = struct {
    vals: List[Int],
    gens: List[Int],
    occ: List[Int],
    count: Int
};

pub fn gen_arena_new() -> GenerationalArena {
    let ev: List[Int] = list_new();
    let eg: List[Int] = list_new();
    let eo: List[Int] = list_new();
    return GenerationalArena {
        vals: ev,
        gens: eg,
        occ: eo,
        count: 0
    };
}

pub fn gen_arena_len(a: GenerationalArena) -> Int {
    return a.count;
}

pub fn gen_arena_is_empty(a: GenerationalArena) -> Bool {
    let c: Int = a.count;
    return c == 0;
}

pub fn gen_arena_contains(a: GenerationalArena, idx: Int, generation: Int) -> Bool {
    let n: Int = list_len(a.vals);
    if idx < 0 || idx >= n {
        return false;
    }
    let o: Int = list_get(a.occ, idx);
    if o == 0 {
        return false;
    }
    let g: Int = list_get(a.gens, idx);
    return g == generation;
}

pub fn gen_arena_insert(a: GenerationalArena, val: Int) -> GenerationalArena {
    let n: Int = list_len(a.vals);
    let mut vacant_idx: Int = -1;
    let mut i: Int = 0;
    while i < n {
        if list_get(a.occ, i) == 0 {
            vacant_idx = i;
            i = n;
        } else {
            i = i + 1;
        }
    }

    if vacant_idx >= 0 {
        let cur_gen: Int = list_get(a.gens, vacant_idx);
        let mut nv: List[Int] = list_new();
        let mut ng: List[Int] = list_new();
        let mut no: List[Int] = list_new();
        let mut j: Int = 0;
        while j < n {
            if j == vacant_idx {
                nv = list_push(nv, val);
                ng = list_push(ng, cur_gen);
                no = list_push(no, 1);
            } else {
                nv = list_push(nv, list_get(a.vals, j));
                ng = list_push(ng, list_get(a.gens, j));
                no = list_push(no, list_get(a.occ, j));
            }
            j = j + 1;
        }
        return GenerationalArena {
            vals: nv,
            gens: ng,
            occ: no,
            count: a.count + 1
        };
    }

    return GenerationalArena {
        vals: list_push(a.vals, val),
        gens: list_push(a.gens, 1),
        occ: list_push(a.occ, 1),
        count: a.count + 1
    };
}

pub fn gen_arena_remove(a: GenerationalArena, idx: Int, generation: Int) -> GenerationalArena {
    if gen_arena_contains(a, idx, generation) == false {
        return a;
    }
    let n: Int = list_len(a.vals);
    let mut nv: List[Int] = list_new();
    let mut ng: List[Int] = list_new();
    let mut no: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            nv = list_push(nv, 0);
            ng = list_push(ng, list_get(a.gens, i) + 1);
            no = list_push(no, 0);
        } else {
            nv = list_push(nv, list_get(a.vals, i));
            ng = list_push(ng, list_get(a.gens, i));
            no = list_push(no, list_get(a.occ, i));
        }
        i = i + 1;
    }
    return GenerationalArena {
        vals: nv,
        gens: ng,
        occ: no,
        count: a.count - 1
    };
}
