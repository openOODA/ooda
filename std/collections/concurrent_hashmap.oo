// # Striped Concurrent Hash Map Module
//
// Logline: Hash map destubbed to List[Int] keys/values (no ThreadCap, no List[String]).
//
// Setup: Pure map. Emit-c cannot lower List[String] as oo_ilist_* or &ThreadCap.
//
// Beats:
//   1. Construct map with stripe count.
//   2. Insert Int key-value pairs.
//   3. Query containment and length.
// residual: CAS lock stripes / ThreadCap lower via backend; this destub is sequential List[Int].

type ConcurrentHashMap = struct {
    num_stripes: Int,
    keys: List[Int],
    values: List[Int],
    size: Int
};

pub fn chm_hash_key(key: Int) -> Int {
    let mut h: Int = key;
    if h < 0 {
        h = 0 - h;
    }
    return h % 2147483647;
}

pub fn chm_new(stripes: Int) -> ConcurrentHashMap {
    let mut s: Int = stripes;
    if s < 1 {
        s = 1;
    }
    let ks: List[Int] = list_new();
    let vs: List[Int] = list_new();
    return ConcurrentHashMap {
        num_stripes: s,
        keys: ks,
        values: vs,
        size: 0
    };
}

pub fn chm_len(m: ConcurrentHashMap) -> Int {
    return m.size;
}

pub fn chm_is_empty(m: ConcurrentHashMap) -> Bool {
    return m.size == 0;
}

pub fn chm_stripes(m: ConcurrentHashMap) -> Int {
    return m.num_stripes;
}

pub fn chm_stripe_for(m: ConcurrentHashMap, key: Int) -> Int {
    let h: Int = chm_hash_key(key);
    let s: Int = m.num_stripes;
    return h % s;
}

fn chm_find(m: ConcurrentHashMap, key: Int) -> Int {
    let n: Int = list_len(m.keys);
    let mut i: Int = 0;
    while i < n {
        if list_get(m.keys, i) == key {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn chm_contains_key(m: ConcurrentHashMap, key: Int) -> Bool {
    let idx: Int = chm_find(m, key);
    return idx >= 0;
}

pub fn chm_put(m: ConcurrentHashMap, key: Int, val: Int) -> ConcurrentHashMap {
    let n: Int = list_len(m.keys);
    let found_idx: Int = chm_find(m, key);
    let cur_sz: Int = m.size;
    if found_idx >= 0 {
        let mut new_vals: List[Int] = list_new();
        let mut j: Int = 0;
        while j < n {
            if j == found_idx {
                new_vals = list_push(new_vals, val);
            } else {
                new_vals = list_push(new_vals, list_get(m.values, j));
            }
            j = j + 1;
        }
        return ConcurrentHashMap {
            num_stripes: m.num_stripes,
            keys: m.keys,
            values: new_vals,
            size: cur_sz
        };
    }
    return ConcurrentHashMap {
        num_stripes: m.num_stripes,
        keys: list_push(m.keys, key),
        values: list_push(m.values, val),
        size: cur_sz + 1
    };
}

pub fn chm_remove(m: ConcurrentHashMap, key: Int) -> ConcurrentHashMap {
    let n: Int = list_len(m.keys);
    let mut new_keys: List[Int] = list_new();
    let mut new_vals: List[Int] = list_new();
    let mut removed: Bool = false;
    let mut i: Int = 0;
    while i < n {
        if list_get(m.keys, i) == key {
            removed = true;
        } else {
            new_keys = list_push(new_keys, list_get(m.keys, i));
            new_vals = list_push(new_vals, list_get(m.values, i));
        }
        i = i + 1;
    }
    let cur_sz: Int = m.size;
    let mut next_sz: Int = cur_sz;
    if removed == true {
        next_sz = cur_sz - 1;
    }
    return ConcurrentHashMap {
        num_stripes: m.num_stripes,
        keys: new_keys,
        values: new_vals,
        size: next_sz
    };
}
