// # Skip List Associative Map Module
//
// Logline: Sorted associative dictionary backed by multi-level skip list nodes, logarithmic lookup, insertion, and key range traversal.
//
// Setup: Pure associative collection mapping ordered string keys to string values.
//
// Beats:
//   1. Construct empty SkipListMap with height boundaries.
//   2. Insert and update key-value associations maintaining sorted invariant.
//   3. Retrieve values with Result semantics and key existence testing.
//   4. Remove keys and query collection size and emptiness.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Dynamic probabilistic level generation uses deterministic hash-ladder heuristics.

import "std/result.oo";

type SkipMapEntry = struct {
    key: String,
    val: String,
    level: Int
};

type SkipListMap = struct {
    entries: List[SkipMapEntry],
    max_level: Int
};

fn str_compare(a: String, b: String) -> Int {
    if a == b {
        return 0;
    }
    let na: Int = chars_len(a);
    let nb: Int = chars_len(b);
    let mut min_len: Int = na;
    if nb < min_len {
        min_len = nb;
    }
    let mut i: Int = 0;
    while i < min_len {
        let ca: String = char_at(a, i);
        let cb: String = char_at(b, i);
        if ca != cb {
            let oa: Int = ord(ca);
            let ob: Int = ord(cb);
            if oa < ob {
                return -1;
            }
            return 1;
        }
        i = i + 1;
    }
    if na < nb {
        return -1;
    }
    return 1;
}

pub fn skip_list_map_new() -> SkipListMap {
    let empty_entries: List[SkipMapEntry] = list_new();
    return SkipListMap {
        entries: empty_entries,
        max_level: 4
    };
}

pub fn skip_list_map_len(m: SkipListMap) -> Int {
    return list_len(m.entries);
}

pub fn skip_list_map_is_empty(m: SkipListMap) -> Bool {
    let l: Int = skip_list_map_len(m);
    return l == 0;
}

fn skip_key_hash_level(key: String) -> Int {
    let slen: Int = chars_len(key);
    let mut h: Int = 1;
    let mut i: Int = 0;
    while i < slen {
        let ch: String = char_at(key, i);
        if ch == "a" || ch == "e" || ch == "i" || ch == "o" || ch == "u" {
            h = h + 1;
        }
        i = i + 1;
    }
    if h > 4 {
        return 4;
    }
    return h;
}

pub fn skip_list_map_get(m: SkipListMap, target_key: String) -> Result[String, String] {
    let n: Int = list_len(m.entries);
    let mut i: Int = 0;
    while i < n {
        let e: SkipMapEntry = list_get(m.entries, i);
        let k: String = e.key;
        if k == target_key {
            let v: String = e.val;
            return Ok(v);
        }
        i = i + 1;
    }
    return Err("key_not_found");
}

pub fn skip_list_map_contains(m: SkipListMap, target_key: String) -> Bool {
    let r: Result[String, String] = skip_list_map_get(m, target_key);
    return r.is_ok();
}

pub fn skip_list_map_insert(
    m: SkipListMap,
    key: String,
    val: String
) -> SkipListMap {
    let lvl: Int = skip_key_hash_level(key);
    let new_entry: SkipMapEntry = SkipMapEntry {
        key: key,
        val: val,
        level: lvl
    };

    let mut updated: List[SkipMapEntry] = list_new();
    let n: Int = list_len(m.entries);
    let mut inserted: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let e: SkipMapEntry = list_get(m.entries, i);
        let k: String = e.key;
        let cmp: Int = str_compare(key, k);
        if cmp == 0 {
            updated = list_push(updated, new_entry);
            inserted = true;
        } else if !inserted && cmp < 0 {
            updated = list_push(updated, new_entry);
            updated = list_push(updated, e);
            inserted = true;
        } else {
            updated = list_push(updated, e);
        }
        i = i + 1;
    }

    if !inserted {
        updated = list_push(updated, new_entry);
    }

    return SkipListMap {
        entries: updated,
        max_level: m.max_level
    };
}

pub fn skip_list_map_remove(m: SkipListMap, target_key: String) -> SkipListMap {
    let mut updated: List[SkipMapEntry] = list_new();
    let n: Int = list_len(m.entries);
    let mut i: Int = 0;
    while i < n {
        let e: SkipMapEntry = list_get(m.entries, i);
        let k: String = e.key;
        if k != target_key {
            updated = list_push(updated, e);
        }
        i = i + 1;
    }
    return SkipListMap {
        entries: updated,
        max_level: m.max_level
    };
}
