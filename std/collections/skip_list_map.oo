// # Skip List Associative Map Module
//
// Logline: Sorted associative dictionary destubbed to List[Int] keys/values.
//
// Setup: Pure map. Emit-c cannot lower List[SkipMapEntry].
//
// Beats:
//   1. Construct empty SkipListMap.
//   2. Insert Int key-value pairs.
//   3. Query containment and length.
// residual: List[struct] entries destubbed to parallel Int lists.

type SkipListMap = struct {
    keys: List[Int],
    values: List[Int],
    size: Int
};

pub fn skip_list_map_new() -> SkipListMap {
    let ks: List[Int] = list_new();
    let vs: List[Int] = list_new();
    return SkipListMap {
        keys: ks,
        values: vs,
        size: 0
    };
}

pub fn skip_list_map_len(m: SkipListMap) -> Int {
    return m.size;
}

pub fn skip_list_map_is_empty(m: SkipListMap) -> Bool {
    let l: Int = m.size;
    return l == 0;
}

fn skip_list_map_find(m: SkipListMap, key: Int) -> Int {
    let n: Int = m.size;
    let mut i: Int = 0;
    while i < n {
        if list_get(m.keys, i) == key {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn skip_list_map_contains(m: SkipListMap, key: Int) -> Bool {
    let idx: Int = skip_list_map_find(m, key);
    return idx >= 0;
}

pub fn skip_list_map_insert(m: SkipListMap, key: Int, val: Int) -> SkipListMap {
    let idx: Int = skip_list_map_find(m, key);
    let n: Int = m.size;
    if idx >= 0 {
        let mut new_vals: List[Int] = list_new();
        let mut i: Int = 0;
        while i < n {
            if i == idx {
                new_vals = list_push(new_vals, val);
            } else {
                new_vals = list_push(new_vals, list_get(m.values, i));
            }
            i = i + 1;
        }
        return SkipListMap {
            keys: m.keys,
            values: new_vals,
            size: n
        };
    }
    return SkipListMap {
        keys: list_push(m.keys, key),
        values: list_push(m.values, val),
        size: n + 1
    };
}
