// # Compact Prefix Trie Module
//
// Logline: Memory-efficient compact string prefix trie for string dictionary lookups and prefix completions.
//
// Setup: Pure prefix search collection.
//
// Beats:
//   1. Construct CompactTrie with root node.
//   2. Insert string keys into trie.
//   3. Test exact match and prefix match.
//   4. Query word count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/str.oo";

type CompactTrie = struct {
    words: List[String],
    size: Int
};

pub fn compact_trie_new() -> CompactTrie {
    let w: List[String] = list_new();
    return CompactTrie { words: w, size: 0 };
}

pub fn compact_trie_insert(trie: CompactTrie, word: String) -> CompactTrie {
    let new_words: List[String] = list_push(trie.words, word);
    let s: Int = trie.size;
    return CompactTrie {
        words: new_words,
        size: s + 1
    };
}

pub fn compact_trie_search(trie: CompactTrie, word: String) -> Bool {
    let n: Int = trie.size;
    let mut i: Int = 0;
    while i < n {
        let w: String = list_get(trie.words, i);
        if str_eq(w, word) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn compact_trie_has_prefix(trie: CompactTrie, prefix: String) -> Bool {
    let n: Int = trie.size;
    let mut i: Int = 0;
    while i < n {
        let w: String = list_get(trie.words, i);
        if starts_with(w, prefix) { return true; }
        i = i + 1;
    }
    return false;
}
