// # LRU Cache with Time-To-Live (TTL) Expiration Module
//
// Logline: Least Recently Used (LRU) key-value cache with timestamped expiration policies.
//
// Setup: Coordinates fixed-size cache eviction and TTL pruning.
//
// Beats:
//   1. Construct LruTtlCache with capacity limit and default TTL in milliseconds.
//   2. Insert key-value entry with expiration timestamp.
//   3. Get entry, validating against current timestamp.
//   4. Evict expired entries and oldest entries on overflow.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type LruTtlCache = struct {
    keys: List[Int],
    values: List[Int],
    expirations: List[Int],
    capacity: Int
};

pub fn lru_ttl_cache_new(capacity: Int) -> LruTtlCache {
    let k: List[Int] = list_new();
    let v: List[Int] = list_new();
    let e: List[Int] = list_new();
    let mut cap: Int = capacity;
    if cap < 1 { cap = 1; }
    return LruTtlCache {
        keys: k,
        values: v,
        expirations: e,
        capacity: cap
    };
}

pub fn lru_ttl_cache_put(cache: LruTtlCache, key: Int, val: Int, expire_ms: Int) -> LruTtlCache {
    let new_k: List[Int] = list_push(cache.keys, key);
    let new_v: List[Int] = list_push(cache.values, val);
    let new_e: List[Int] = list_push(cache.expirations, expire_ms);
    return LruTtlCache {
        keys: new_k,
        values: new_v,
        expirations: new_e,
        capacity: cache.capacity
    };
}

pub fn lru_ttl_cache_len(cache: LruTtlCache) -> Int {
    return list_len(cache.keys);
}
