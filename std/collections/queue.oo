// # FIFO Queue
//
// Logline: First-In First-Out sequential queue for string elements.
//
// Setup: Pure sequence maintaining strict FIFO enqueue and dequeue order.
//
// Beats:
//   1. Construct empty Queue and query length or emptiness.
//   2. Enqueue elements at the back.
//   3. Peek front element without removing it.
//   4. Dequeue front element and clear queue.
//
// residual: in-memory list tracking FIFO items

type Queue = struct {
    data: List[String],
    size: Int
};

// Create a new empty Queue.
pub fn queue_new() -> Queue {
    let d: List[String] = list_new();
    return Queue {
        data: d,
        size: 0
    };
}

// Return number of elements in the queue.
pub fn queue_len(q: Queue) -> Int {
    return q.size;
}

// True when queue contains no elements.
pub fn queue_is_empty(q: Queue) -> Bool {
    return q.size == 0;
}

// Return a new empty queue.
pub fn queue_clear() -> Queue {
    return queue_new();
}

// Enqueue element at the back of the queue.
pub fn queue_enqueue(q: Queue, val: String) -> Queue {
    let cur: List[String] = q.data;
    let new_data: List[String] = list_push(cur, val);
    let n: Int = q.size;
    return Queue {
        data: new_data,
        size: n + 1
    };
}

// Peek front element (first in line).
pub fn queue_peek(q: Queue) -> Result[String, String] {
    if q.size == 0 {
        return Err("EMPTY");
    }
    let cur: List[String] = q.data;
    return Ok(list_get(cur, 0));
}

// Dequeue front element, returning updated queue.
pub fn queue_dequeue(q: Queue) -> Queue {
    let n: Int = q.size;
    if n <= 1 {
        return queue_new();
    }
    let cur: List[String] = q.data;
    let mut new_data: List[String] = list_new();
    let mut i: Int = 1;
    while i < n {
        let item: String = list_get(cur, i);
        new_data = list_push(new_data, item);
        i = i + 1;
    }
    return Queue {
        data: new_data,
        size: n - 1
    };
}

// Return all elements in FIFO order.
pub fn queue_to_list(q: Queue) -> List[String] {
    return q.data;
}
