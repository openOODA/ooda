// # Skip List
//
// Logline: Multi-level ordered collection mapping string keys to string values.
//
// Setup: Pure ordered sequence with level annotations and fast lookups.
//
// Beats:
//   1. Construct empty SkipList and check length or emptiness.
//   2. Insert key-value pairs maintaining sorted order.
//   3. Retrieve values by key with Result semantics.
//   4. Remove keys and enumerate sorted keys.
//
// residual: in-memory ordered list with deterministic level distribution

type SkipList = struct {
    keys: List[String],
    values: List[String],
    levels: List[Int],
    size: Int
};

fn str_compare(a: String, b: String) -> Int {
    if a == b {
        return 0;
    }
    let na: Int = chars_len(a);
    let nb: Int = chars_len(b);
    let mut min_len: Int = na;
    if nb < min_len {
        min_len = nb;
    }
    let mut i: Int = 0;
    while i < min_len {
        let ca: String = char_at(a, i);
        let cb: String = char_at(b, i);
        if ca != cb {
            let oa: Int = ord(ca);
            let ob: Int = ord(cb);
            if oa < ob {
                return -1;
            }
            return 1;
        }
        i = i + 1;
    }
    if na < nb {
        return -1;
    }
    return 1;
}

// Create a new empty SkipList.
pub fn skip_list_new() -> SkipList {
    let ks: List[String] = list_new();
    let vs: List[String] = list_new();
    let ls: List[Int] = list_new();
    return SkipList {
        keys: ks,
        values: vs,
        levels: ls,
        size: 0
    };
}

// Return number of entries in the skip list.
pub fn skip_list_len(sl: SkipList) -> Int {
    return sl.size;
}

// True when the skip list is empty.
pub fn skip_list_is_empty(sl: SkipList) -> Bool {
    return sl.size == 0;
}

// Return a new empty skip list.
pub fn skip_list_clear() -> SkipList {
    return skip_list_new();
}

fn skip_list_find_idx(sl: SkipList, key: String) -> Int {
    let n: Int = sl.size;
    let mut i: Int = 0;
    while i < n {
        let k: String = list_get(sl.keys, i);
        let cmp: Int = str_compare(k, key);
        if cmp >= 0 {
            return i;
        }
        i = i + 1;
    }
    return n;
}

// Check if key exists in skip list.
pub fn skip_list_contains(sl: SkipList, key: String) -> Bool {
    let n: Int = sl.size;
    let idx: Int = skip_list_find_idx(sl, key);
    if idx < n {
        if list_get(sl.keys, idx) == key {
            return true;
        }
    }
    return false;
}

// Retrieve value associated with key.
pub fn skip_list_get(sl: SkipList, key: String) -> Result[String, String] {
    let n: Int = sl.size;
    let idx: Int = skip_list_find_idx(sl, key);
    if idx < n {
        if list_get(sl.keys, idx) == key {
            return Ok(list_get(sl.values, idx));
        }
    }
    return Err("KEY_NOT_FOUND");
}

// Insert or update key-value association.
pub fn skip_list_insert(sl: SkipList, key: String, val: String) -> SkipList {
    let n: Int = sl.size;
    let idx: Int = skip_list_find_idx(sl, key);
    let mut new_keys: List[String] = list_new();
    let mut new_vals: List[String] = list_new();
    let mut new_levels: List[Int] = list_new();
    let mut i: Int = 0;

    if idx < n && list_get(sl.keys, idx) == key {
        while i < n {
            new_keys = list_push(new_keys, list_get(sl.keys, i));
            new_levels = list_push(new_levels, list_get(sl.levels, i));
            if i == idx {
                new_vals = list_push(new_vals, val);
            } else {
                new_vals = list_push(new_vals, list_get(sl.values, i));
            }
            i = i + 1;
        }
        return SkipList {
            keys: new_keys,
            values: new_vals,
            levels: new_levels,
            size: n
        };
    }

    let lvl: Int = (n % 4) + 1;
    while i < idx {
        new_keys = list_push(new_keys, list_get(sl.keys, i));
        new_vals = list_push(new_vals, list_get(sl.values, i));
        new_levels = list_push(new_levels, list_get(sl.levels, i));
        i = i + 1;
    }
    new_keys = list_push(new_keys, key);
    new_vals = list_push(new_vals, val);
    new_levels = list_push(new_levels, lvl);
    while i < n {
        new_keys = list_push(new_keys, list_get(sl.keys, i));
        new_vals = list_push(new_vals, list_get(sl.values, i));
        new_levels = list_push(new_levels, list_get(sl.levels, i));
        i = i + 1;
    }

    return SkipList {
        keys: new_keys,
        values: new_vals,
        levels: new_levels,
        size: n + 1
    };
}

// Remove key from skip list if present.
pub fn skip_list_remove(sl: SkipList, key: String) -> SkipList {
    let n: Int = sl.size;
    let idx: Int = skip_list_find_idx(sl, key);
    if idx >= n || list_get(sl.keys, idx) != key {
        return sl;
    }
    let mut new_keys: List[String] = list_new();
    let mut new_vals: List[String] = list_new();
    let mut new_levels: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i != idx {
            new_keys = list_push(new_keys, list_get(sl.keys, i));
            new_vals = list_push(new_vals, list_get(sl.values, i));
            new_levels = list_push(new_levels, list_get(sl.levels, i));
        }
        i = i + 1;
    }
    return SkipList {
        keys: new_keys,
        values: new_vals,
        levels: new_levels,
        size: n - 1
    };
}

// Return sorted keys in skip list.
pub fn skip_list_keys(sl: SkipList) -> List[String] {
    return sl.keys;
}
