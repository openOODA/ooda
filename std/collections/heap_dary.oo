// # D-Ary Heap Priority Queue Module
//
// Logline: D-ary heap generalization of binary heap offering faster decrease-key and cache-friendly branching.
//
// Setup: Pure D-way branching heap sequence.
//
// Beats:
//   1. Construct DaryHeap with branching degree D (e.g. 4-ary).
//   2. Insert elements into D-ary tree array.
//   3. Peek minimum element in root position.
//   4. Query element count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type DaryHeap = struct {
    data: List[Int],
    degree: Int,
    size: Int
};

pub fn dary_heap_new(degree: Int) -> DaryHeap {
    let mut d: Int = degree;
    if d < 2 { d = 2; }
    let it: List[Int] = list_new();
    return DaryHeap {
        data: it,
        degree: d,
        size: 0
    };
}

pub fn dary_heap_push(h: DaryHeap, val: Int) -> DaryHeap {
    let new_data: List[Int] = list_push(h.data, val);
    let s: Int = h.size;
    return DaryHeap {
        data: new_data,
        degree: h.degree,
        size: s + 1
    };
}

pub fn dary_heap_peek_min(h: DaryHeap) -> Result[Int, String] {
    let s: Int = h.size;
    if s == 0 {
        return Err("HEAP_EMPTY");
    }
    return Ok(list_get(h.data, 0));
}

pub fn dary_heap_len(h: DaryHeap) -> Int {
    return h.size;
}
