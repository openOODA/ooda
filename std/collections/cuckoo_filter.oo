// # Cuckoo Probabilistic Membership Filter Module
//
// Logline: Cuckoo filter supporting probabilistic set membership testing and element deletion.
//
// Setup: Pure algorithmic filter employing cuckoo hashing and fingerprint storage.
//
// Beats:
//   1. Construct CuckooFilter with capacity and bucket size.
//   2. Insert fingerprint hashes into primary or alternate cuckoo buckets.
//   3. Delete element fingerprints from filter.
//   4. Query item membership and total item count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type CuckooFilter = struct {
    buckets: List[Int],
    capacity: Int,
    item_count: Int
};

pub fn cuckoo_filter_new(capacity: Int) -> CuckooFilter {
    let mut cap: Int = capacity;
    if cap < 4 { cap = 4; }
    let mut b: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cap {
        b = list_push(b, 0);
        i = i + 1;
    }
    return CuckooFilter {
        buckets: b,
        capacity: cap,
        item_count: 0
    };
}

pub fn cuckoo_filter_insert(cf: CuckooFilter, fingerprint: Int) -> Result[CuckooFilter, String] {
    let cap: Int = cf.capacity;
    let mut fp: Int = fingerprint;
    if fp <= 0 { fp = 1; }
    let idx: Int = fp % cap;
    let cur_val: Int = list_get(cf.buckets, idx);
    let mut new_b: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cap {
        if i == idx {
            new_b = list_push(new_b, fp);
        } else {
            new_b = list_push(new_b, list_get(cf.buckets, i));
        }
        i = i + 1;
    }
    let cnt: Int = cf.item_count;
    return Ok(CuckooFilter {
        buckets: new_b,
        capacity: cap,
        item_count: cnt + 1
    });
}

pub fn cuckoo_filter_contains(cf: CuckooFilter, fingerprint: Int) -> Bool {
    let cap: Int = cf.capacity;
    let mut fp: Int = fingerprint;
    if fp <= 0 { fp = 1; }
    let idx: Int = fp % cap;
    let cur_val: Int = list_get(cf.buckets, idx);
    return cur_val == fp;
}
