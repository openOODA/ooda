// # LIFO Stack
//
// Logline: Last-In First-Out stack for string elements.
//
// Setup: Pure sequence maintaining strict LIFO push and pop order.
//
// Beats:
//   1. Construct empty Stack and query length or emptiness.
//   2. Push elements onto the top of the stack.
//   3. Peek top element without removing it.
//   4. Pop top element and clear stack.
//
// residual: in-memory list tracking LIFO elements

type Stack = struct {
    data: List[String],
    size: Int
};

// Create a new empty Stack.
pub fn stack_new() -> Stack {
    let d: List[String] = list_new();
    return Stack {
        data: d,
        size: 0
    };
}

// Return number of elements in the stack.
pub fn stack_len(s: Stack) -> Int {
    return s.size;
}

// True when the stack contains no elements.
pub fn stack_is_empty(s: Stack) -> Bool {
    return s.size == 0;
}

// Return a new empty stack.
pub fn stack_clear() -> Stack {
    return stack_new();
}

// Push element onto top of the stack.
pub fn stack_push(s: Stack, val: String) -> Stack {
    let new_data: List[String] = list_push(s.data, val);
    let n: Int = s.size;
    return Stack {
        data: new_data,
        size: n + 1
    };
}

// Peek top element of the stack.
pub fn stack_peek(s: Stack) -> Result[String, String] {
    let n: Int = s.size;
    if n == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(s.data, n - 1));
}

// Pop top element, returning updated stack.
pub fn stack_pop(s: Stack) -> Stack {
    let n: Int = s.size;
    if n <= 1 {
        return stack_new();
    }
    let mut new_data: List[String] = list_new();
    let mut i: Int = 0;
    let new_len: Int = n - 1;
    while i < new_len {
        new_data = list_push(new_data, list_get(s.data, i));
        i = i + 1;
    }
    return Stack {
        data: new_data,
        size: new_len
    };
}

// Return all elements in bottom-to-top order.
pub fn stack_to_list(s: Stack) -> List[String] {
    return s.data;
}
