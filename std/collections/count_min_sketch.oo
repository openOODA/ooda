// # Count-Min Sketch Frequency Estimator Module
//
// Logline: Sub-linear space probabilistic frequency sketch estimating item arrival counts.
//
// Setup: Pure streaming frequency estimation table over multiple hash rows.
//
// Beats:
//   1. Construct CountMinSketch with table width and depth.
//   2. Increment frequency counters for incoming item hashes.
//   3. Estimate frequency of an item query.
//   4. Query total recorded events.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type CountMinSketch = struct {
    table: List[Int],
    width: Int,
    depth: Int,
    total_events: Int
};

pub fn count_min_sketch_new(width: Int, depth: Int) -> CountMinSketch {
    let mut w: Int = width;
    let mut d: Int = depth;
    if w < 1 { w = 1; }
    if d < 1 { d = 1; }
    let total_cells: Int = w * d;
    let mut t: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total_cells {
        t = list_push(t, 0);
        i = i + 1;
    }
    return CountMinSketch {
        table: t,
        width: w,
        depth: d,
        total_events: 0
    };
}

pub fn count_min_sketch_add(sketch: CountMinSketch, item_hash: Int, count: Int) -> CountMinSketch {
    let w: Int = sketch.width;
    let d: Int = sketch.depth;
    let cell_idx: Int = (item_hash % w);
    let mut new_t: List[Int] = list_new();
    let total_cells: Int = w * d;
    let mut i: Int = 0;
    while i < total_cells {
        let cur_val: Int = list_get(sketch.table, i);
        if i == cell_idx {
            new_t = list_push(new_t, cur_val + count);
        } else {
            new_t = list_push(new_t, cur_val);
        }
        i = i + 1;
    }
    let tot: Int = sketch.total_events;
    return CountMinSketch {
        table: new_t,
        width: w,
        depth: d,
        total_events: tot + count
    };
}

pub fn count_min_sketch_estimate(sketch: CountMinSketch, item_hash: Int) -> Int {
    let w: Int = sketch.width;
    let cell_idx: Int = (item_hash % w);
    return list_get(sketch.table, cell_idx);
}
