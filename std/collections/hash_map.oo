// # String Hash Map
//
// Logline: Associative dictionary for key-value string storage and lookups.
//
// Setup: Pure associative collection mapping unique string keys to string values.
//
// Beats:
//   1. Construct empty HashMap and test emptiness.
//   2. Insert, update, and remove key-value associations.
//   3. Retrieve values with Result semantics.
//   4. List map keys and values.
//
// residual: in-memory key-value arrays with linear uniqueness checks

type HashMap = struct {
    keys: List[String],
    values: List[String],
    size: Int
};

// Create a new empty HashMap.
pub fn hash_map_new() -> HashMap {
    let ks: List[String] = list_new();
    let vs: List[String] = list_new();
    return HashMap {
        keys: ks,
        values: vs,
        size: 0
    };
}

// Return number of entries in the hash map.
pub fn hash_map_len(m: HashMap) -> Int {
    return m.size;
}

// True when the hash map contains no entries.
pub fn hash_map_is_empty(m: HashMap) -> Bool {
    return m.size == 0;
}

// Return a new empty hash map.
pub fn hash_map_clear() -> HashMap {
    return hash_map_new();
}

fn hash_map_find_idx(m: HashMap, key: String) -> Int {
    let n: Int = m.size;
    let mut i: Int = 0;
    while i < n {
        if list_get(m.keys, i) == key {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Check if key exists in the hash map.
pub fn hash_map_contains(m: HashMap, key: String) -> Bool {
    let idx: Int = hash_map_find_idx(m, key);
    return idx >= 0;
}

// Retrieve value associated with key.
pub fn hash_map_get(m: HashMap, key: String) -> Result[String, String] {
    let idx: Int = hash_map_find_idx(m, key);
    if idx >= 0 {
        return Ok(list_get(m.values, idx));
    }
    return Err("KEY_NOT_FOUND");
}

// Insert or update key-value pair.
pub fn hash_map_insert(m: HashMap, key: String, val: String) -> HashMap {
    let n: Int = m.size;
    let idx: Int = hash_map_find_idx(m, key);
    if idx >= 0 {
        let mut new_keys: List[String] = list_new();
        let mut new_vals: List[String] = list_new();
        let mut i: Int = 0;
        while i < n {
            new_keys = list_push(new_keys, list_get(m.keys, i));
            if i == idx {
                new_vals = list_push(new_vals, val);
            } else {
                new_vals = list_push(new_vals, list_get(m.values, i));
            }
            i = i + 1;
        }
        return HashMap {
            keys: new_keys,
            values: new_vals,
            size: n
        };
    }

    let new_keys: List[String] = list_push(m.keys, key);
    let new_vals: List[String] = list_push(m.values, val);
    return HashMap {
        keys: new_keys,
        values: new_vals,
        size: n + 1
    };
}

// Remove key from map if present.
pub fn hash_map_remove(m: HashMap, key: String) -> HashMap {
    let idx: Int = hash_map_find_idx(m, key);
    if idx < 0 {
        return m;
    }
    let n: Int = m.size;
    let mut new_keys: List[String] = list_new();
    let mut new_vals: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i != idx {
            new_keys = list_push(new_keys, list_get(m.keys, i));
            new_vals = list_push(new_vals, list_get(m.values, i));
        }
        i = i + 1;
    }
    return HashMap {
        keys: new_keys,
        values: new_vals,
        size: n - 1
    };
}

// Return list of all keys.
pub fn hash_map_keys(m: HashMap) -> List[String] {
    return m.keys;
}

// Return list of all values.
pub fn hash_map_values(m: HashMap) -> List[String] {
    return m.values;
}
