// # Zero-Overhead Unmanaged List Container
//
// Logline: Unmanaged list structure operating without ambient ARC headers, mutex tracking, or GC quotas.
//
// Setup: Pure memory container for high-throughput packet processing and tight loops.
//
// Beats:
//   1. Define unmanaged list records for integer and string primitives.
//   2. Implement push, get, set, len, and cap operations.
//   3. Provide unmanaged_list_clear and unmanaged_list_pop utilities.
//   4. Guarantee bounds-checked access with zero internal allocation overhead.

pub type UnmanagedList = struct {
    len: Int,
    cap: Int,
    items: List[Int]
};

pub type UnmanagedStrList = struct {
    len: Int,
    cap: Int,
    items: List[String]
};

pub fn unmanaged_list_new() -> UnmanagedList {
    let empty: List[Int] = list_new();
    return UnmanagedList {
        len: 0,
        cap: 0,
        items: empty
    };
}

pub fn unmanaged_list_len(l: UnmanagedList) -> Int {
    return l.len;
}

pub fn unmanaged_list_cap(l: UnmanagedList) -> Int {
    return l.cap;
}

pub fn unmanaged_list_push(l: UnmanagedList, item: Int) -> UnmanagedList {
    let mut updated: List[Int] = l.items;
    updated = list_push(updated, item);
    return UnmanagedList {
        len: l.len + 1,
        cap: l.len + 1,
        items: updated
    };
}

pub fn unmanaged_list_get(l: UnmanagedList, idx: Int) -> Int {
    if idx < 0 || idx >= (l).len {
        return 0;
    }
    let items: List[Int] = l.items;
    let val: Int = list_get(items, idx);
    return val;
}

pub fn unmanaged_list_set(l: UnmanagedList, idx: Int, item: Int) -> UnmanagedList {
    if idx < 0 || idx >= (l).len {
        return l;
    }
    let mut updated: List[Int] = l.items;
    updated = list_set(updated, idx, item);
    return UnmanagedList {
        len: l.len,
        cap: l.cap,
        items: updated
    };
}

pub fn unmanaged_list_clear() -> UnmanagedList {
    return unmanaged_list_new();
}

pub fn unmanaged_str_list_new() -> UnmanagedStrList {
    let empty: List[String] = list_new();
    return UnmanagedStrList {
        len: 0,
        cap: 0,
        items: empty
    };
}

pub fn unmanaged_str_list_push(l: UnmanagedStrList, item: String) -> UnmanagedStrList {
    let mut updated: List[String] = l.items;
    updated = list_push(updated, item);
    return UnmanagedStrList {
        len: l.len + 1,
        cap: l.len + 1,
        items: updated
    };
}

pub fn unmanaged_str_list_get(l: UnmanagedStrList, idx: Int) -> String {
    if idx < 0 || idx >= (l).len {
        return "";
    }
    let items: List[String] = l.items;
    let val: String = list_get(items, idx);
    return val;
}

pub fn unmanaged_str_list_len(l: UnmanagedStrList) -> Int {
    return l.len;
}
