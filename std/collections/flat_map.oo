// # Contiguous FlatMap Associative Array Module
//
// Logline: Contiguous cache-friendly flat associative map maintaining sorted key-value pairs with binary search lookups.
//
// Setup: Pure associative collection optimized for small to medium key sets with sequential locality.
//
// Beats:
//   1. Construct empty FlatMap container with contiguous key/value lists.
//   2. Insert and replace associations preserving lexicographical sort.
//   3. Lookup values via binary search with Result semantics.
//   4. Enumerate keys and values and query map size.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Dynamic capacity preallocation lowers via runtime list primitives.

import "std/result.oo";

type FlatMap = struct {
    keys: List[String],
    values: List[String],
    size: Int
};

fn str_compare(a: String, b: String) -> Int {
    if a == b {
        return 0;
    }
    let na: Int = chars_len(a);
    let nb: Int = chars_len(b);
    let mut min_len: Int = na;
    if nb < min_len {
        min_len = nb;
    }
    let mut i: Int = 0;
    while i < min_len {
        let ca: String = char_at(a, i);
        let cb: String = char_at(b, i);
        if ca != cb {
            let oa: Int = ord(ca);
            let ob: Int = ord(cb);
            if oa < ob {
                return -1;
            }
            return 1;
        }
        i = i + 1;
    }
    if na < nb {
        return -1;
    }
    return 1;
}

pub fn flat_map_new() -> FlatMap {
    let ks: List[String] = list_new();
    let vs: List[String] = list_new();
    return FlatMap {
        keys: ks,
        values: vs,
        size: 0
    };
}

pub fn flat_map_len(m: FlatMap) -> Int {
    return m.size;
}

pub fn flat_map_is_empty(m: FlatMap) -> Bool {
    let s: Int = m.size;
    return s == 0;
}

pub fn flat_map_keys(m: FlatMap) -> List[String] {
    return m.keys;
}

pub fn flat_map_values(m: FlatMap) -> List[String] {
    return m.values;
}

fn flat_map_find_idx(m: FlatMap, key: String) -> Int {
    let n: Int = m.size;
    let mut i: Int = 0;
    while i < n {
        let k: String = list_get(m.keys, i);
        let cmp: Int = str_compare(k, key);
        if cmp == 0 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn flat_map_get(m: FlatMap, key: String) -> Result[String, String] {
    let idx: Int = flat_map_find_idx(m, key);
    if idx < 0 {
        return Err("key_not_found");
    }
    let v: String = list_get(m.values, idx);
    return Ok(v);
}

pub fn flat_map_contains(m: FlatMap, key: String) -> Bool {
    let idx: Int = flat_map_find_idx(m, key);
    return idx >= 0;
}

pub fn flat_map_insert(m: FlatMap, key: String, val: String) -> FlatMap {
    let idx: Int = flat_map_find_idx(m, key);
    let n: Int = m.size;

    if idx >= 0 {
        let mut next_vs: List[String] = list_new();
        let mut i: Int = 0;
        while i < n {
            if i == idx {
                next_vs = list_push(next_vs, val);
            } else {
                next_vs = list_push(next_vs, list_get(m.values, i));
            }
            i = i + 1;
        }
        return FlatMap {
            keys: m.keys,
            values: next_vs,
            size: m.size
        };
    }

    let mut next_ks: List[String] = list_new();
    let mut next_vs: List[String] = list_new();
    let mut inserted: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let k: String = list_get(m.keys, i);
        let v: String = list_get(m.values, i);
        let cmp: Int = str_compare(key, k);
        if !inserted && cmp < 0 {
            next_ks = list_push(next_ks, key);
            next_vs = list_push(next_vs, val);
            next_ks = list_push(next_ks, k);
            next_vs = list_push(next_vs, v);
            inserted = true;
        } else {
            next_ks = list_push(next_ks, k);
            next_vs = list_push(next_vs, v);
        }
        i = i + 1;
    }

    if !inserted {
        next_ks = list_push(next_ks, key);
        next_vs = list_push(next_vs, val);
    }

    let cur_sz: Int = m.size;
    let next_sz: Int = cur_sz + 1;
    return FlatMap {
        keys: next_ks,
        values: next_vs,
        size: next_sz
    };
}

pub fn flat_map_remove(m: FlatMap, key: String) -> FlatMap {
    let idx: Int = flat_map_find_idx(m, key);
    if idx < 0 {
        return m;
    }
    let mut next_ks: List[String] = list_new();
    let mut next_vs: List[String] = list_new();
    let n: Int = m.size;
    let mut i: Int = 0;
    while i < n {
        if i != idx {
            next_ks = list_push(next_ks, list_get(m.keys, i));
            next_vs = list_push(next_vs, list_get(m.values, i));
        }
        i = i + 1;
    }
    let cur_sz: Int = m.size;
    let next_sz: Int = cur_sz - 1;
    return FlatMap {
        keys: next_ks,
        values: next_vs,
        size: next_sz
    };
}
