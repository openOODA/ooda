// # Skip list tower index
//
// Logline: Searches a probabilistic multi-level skip list whose node height is clamped at 32.
//
// Setup: Pure. Forward pointers are node indices. No OS threads. LCG seed is packed in the struct.
//
// Beats:
//   1. Construct an empty skip list with 32 head forwards.
//   2. Walk towers from the top level down to find a key.
//   3. Prove every forward chain is ordered and stays inside live nodes.
//   4. Report the highest live level so callers can check the 32 cap.

pub type SkipList = struct {
    seed: Int,
    n: Int,
    top: Int,
    keys: List[Int],
    vals: List[Int],
    height: List[Int],
    head: List[Int],
    fwd: List[Int],
    free: List[Int]
};

pub fn sl_z(n: Int, v: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        o = list_push(o, v);
        i = i + 1;
    }
    return o;
}

pub fn sl_iset(xs: List[Int], idx: Int, v: Int) -> List[Int] {
    let mut o: List[Int] = list_new();
    let n: Int = list_len(xs);
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            o = list_push(o, v);
        } else {
            o = list_push(o, list_get(xs, i));
        }
        i = i + 1;
    }
    return o;
}

pub fn skiplist_concurrent_new() -> SkipList {
    let empty_i: List[Int] = list_new();
    return SkipList {
        seed: 12345,
        n: 0,
        top: 1,
        keys: empty_i,
        vals: empty_i,
        height: empty_i,
        head: sl_z(32, 0 - 1),
        fwd: empty_i,
        free: empty_i
    };
}

pub fn sl_fwd(sl: SkipList, node: Int, lvl: Int) -> Int {
    if node < 0 {
        return list_get(sl.head, lvl);
    }
    return list_get(sl.fwd, node * 32 + lvl);
}

pub fn sl_lcg(s: Int) -> Int { return (s * 1103515245 + 12345) & 2147483647; }

pub fn sl_draw(seed0: Int) -> List[Int] {
    let mut s: Int = seed0;
    let mut h: Int = 1;
    while h < 32 {
        s = sl_lcg(s);
        if (s & 3) != 0 {
            break;
        }
        h = h + 1;
    }
    let mut rec: List[Int] = list_new();
    rec = list_push(rec, s);
    rec = list_push(rec, h);
    return rec;
}

pub fn skiplist_concurrent_search(sl: SkipList, key: Int) -> Result[Int, String] {
    let mut x: Int = 0 - 1;
    let mut lvl: Int = sl.top - 1;
    while lvl >= 0 {
        let mut nx: Int = sl_fwd(sl, x, lvl);
        while nx >= 0 {
            if list_get(sl.keys, nx) >= key {
                break;
            }
            x = nx;
            nx = sl_fwd(sl, x, lvl);
        }
        lvl = lvl - 1;
    }
    let hit: Int = sl_fwd(sl, x, 0);
    if hit >= 0 {
        if list_get(sl.keys, hit) == key {
            if list_get(sl.height, hit) > 0 {
                return Ok(list_get(sl.vals, hit));
            }
        }
    }
    return Err("skip missing");
}

pub fn skiplist_concurrent_max_level(sl: SkipList) -> Int { return sl.top; }

pub fn skiplist_concurrent_forward_ok(sl: SkipList) -> Int {
    let mut prev: Int = 0 - 1000000000;
    let mut x: Int = sl_fwd(sl, 0 - 1, 0);
    while x >= 0 {
        if x >= sl.n {
            return 0;
        }
        if list_get(sl.height, x) < 1 {
            return 0;
        }
        let k: Int = list_get(sl.keys, x);
        if k <= prev {
            return 0;
        }
        prev = k;
        x = sl_fwd(sl, x, 0);
    }
    let mut lvl: Int = 1;
    while lvl < sl.top {
        prev = 0 - 1000000000;
        x = sl_fwd(sl, 0 - 1, lvl);
        while x >= 0 {
            if x >= sl.n {
                return 0;
            }
            if list_get(sl.height, x) <= lvl {
                return 0;
            }
            let k2: Int = list_get(sl.keys, x);
            if k2 <= prev {
                return 0;
            }
            prev = k2;
            x = sl_fwd(sl, x, lvl);
        }
        lvl = lvl + 1;
    }
    if sl.top > 32 {
        return 0;
    }
    return 1;
}

pub fn sl_preds(sl: SkipList, key: Int) -> List[Int] {
    let mut upd: List[Int] = sl_z(32, 0 - 1);
    let mut x: Int = 0 - 1;
    let mut lvl: Int = 31;
    while lvl >= 0 {
        let mut nx: Int = sl_fwd(sl, x, lvl);
        while nx >= 0 {
            if list_get(sl.keys, nx) >= key {
                break;
            }
            x = nx;
            nx = sl_fwd(sl, x, lvl);
        }
        upd = sl_iset(upd, lvl, x);
        lvl = lvl - 1;
    }
    return upd;
}
