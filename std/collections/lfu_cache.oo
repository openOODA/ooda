// # Least Frequently Used (LFU) Cache
//
// Logline: Fixed-capacity associative cache evicting least-frequently-used items.
//
// Setup: Pure associative cache tracking access counts for each key.
//
// Beats:
//   1. Construct LfuCache with specified capacity limit.
//   2. Put key-value pairs, tracking usage counts.
//   3. Get values and increment frequency counter.
//   4. Evict minimum frequency entry on capacity overflow.
//
// residual: in-memory key-value lists with parallel frequency counts

type LfuCache = struct {
    keys: List[Int],
    values: List[Int],
    freqs: List[Int],
    capacity: Int,
    size: Int
};

// Create a new LFU cache with given capacity.
pub fn lfu_new(capacity: Int) -> LfuCache {
    let mut cap: Int = capacity;
    if cap < 1 {
        cap = 1;
    }
    let ks: List[Int] = list_new();
    let vs: List[Int] = list_new();
    let fs: List[Int] = list_new();
    return LfuCache {
        keys: ks,
        values: vs,
        freqs: fs,
        capacity: cap,
        size: 0
    };
}

// Return number of entries in the cache.
pub fn lfu_len(c: LfuCache) -> Int {
    return c.size;
}

// Return maximum capacity of the cache.
pub fn lfu_capacity(c: LfuCache) -> Int {
    return c.capacity;
}

// True when the cache contains no entries.
pub fn lfu_is_empty(c: LfuCache) -> Bool {
    return c.size == 0;
}

// Clear all entries while preserving capacity.
pub fn lfu_clear(c: LfuCache) -> LfuCache {
    return lfu_new(c.capacity);
}

fn lfu_find_idx(c: LfuCache, key: Int) -> Int {
    let n: Int = c.size;
    let mut i: Int = 0;
    while i < n {
        if list_get(c.keys, i) == key {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Check if key exists in cache.
pub fn lfu_contains(c: LfuCache, key: Int) -> Bool {
    let idx: Int = lfu_find_idx(c, key);
    return idx >= 0;
}

// Retrieve value associated with key.
pub fn lfu_get(c: LfuCache, key: Int) -> Result[Int, String] {
    let idx: Int = lfu_find_idx(c, key);
    if idx >= 0 {
        return Ok(list_get(c.values, idx));
    }
    return Err("KEY_NOT_FOUND");
}

// Retrieve frequency score for key.
pub fn lfu_get_frequency(c: LfuCache, key: Int) -> Int {
    let idx: Int = lfu_find_idx(c, key);
    if idx >= 0 {
        return list_get(c.freqs, idx);
    }
    return 0;
}

fn lfu_find_min_freq_idx(c: LfuCache) -> Int {
    let n: Int = c.size;
    if n == 0 {
        return -1;
    }
    let mut min_idx: Int = 0;
    let mut min_f: Int = list_get(c.freqs, 0);
    let mut i: Int = 1;
    while i < n {
        let f: Int = list_get(c.freqs, i);
        if f < min_f {
            min_f = f;
            min_idx = i;
        }
        i = i + 1;
    }
    return min_idx;
}

// Put key-value pair, incrementing frequency on update or evicting min-frequency on overflow.
pub fn lfu_put(c: LfuCache, key: Int, val: Int) -> LfuCache {
    let n: Int = c.size;
    let cap: Int = c.capacity;
    let idx: Int = lfu_find_idx(c, key);

    if idx >= 0 {
        // Key exists: update value and increment frequency
        let mut new_keys: List[Int] = list_new();
        let mut new_vals: List[Int] = list_new();
        let mut new_freqs: List[Int] = list_new();
        let mut i: Int = 0;
        while i < n {
            new_keys = list_push(new_keys, list_get(c.keys, i));
            if i == idx {
                new_vals = list_push(new_vals, val);
                let cur_f: Int = list_get(c.freqs, i);
                new_freqs = list_push(new_freqs, cur_f + 1);
            } else {
                new_vals = list_push(new_vals, list_get(c.values, i));
                new_freqs = list_push(new_freqs, list_get(c.freqs, i));
            }
            i = i + 1;
        }
        return LfuCache {
            keys: new_keys,
            values: new_vals,
            freqs: new_freqs,
            capacity: cap,
            size: n
        };
    }

    // New key: if full, evict min frequency entry
    let mut evict_idx: Int = -1;
    if n >= cap {
        evict_idx = lfu_find_min_freq_idx(c);
    }

    let mut new_keys2: List[Int] = list_new();
    let mut new_vals2: List[Int] = list_new();
    let mut new_freqs2: List[Int] = list_new();
    let mut j: Int = 0;
    let mut new_sz: Int = 0;

    while j < n {
        if j != evict_idx {
            new_keys2 = list_push(new_keys2, list_get(c.keys, j));
            new_vals2 = list_push(new_vals2, list_get(c.values, j));
            new_freqs2 = list_push(new_freqs2, list_get(c.freqs, j));
            new_sz = new_sz + 1;
        }
        j = j + 1;
    }
    new_keys2 = list_push(new_keys2, key);
    new_vals2 = list_push(new_vals2, val);
    new_freqs2 = list_push(new_freqs2, 1);

    return LfuCache {
        keys: new_keys2,
        values: new_vals2,
        freqs: new_freqs2,
        capacity: cap,
        size: new_sz + 1
    };
}

// Remove key from cache if present.
pub fn lfu_remove(c: LfuCache, key: Int) -> LfuCache {
    let idx: Int = lfu_find_idx(c, key);
    if idx < 0 {
        return c;
    }
    let n: Int = c.size;
    let mut new_keys: List[Int] = list_new();
    let mut new_vals: List[Int] = list_new();
    let mut new_freqs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i != idx {
            new_keys = list_push(new_keys, list_get(c.keys, i));
            new_vals = list_push(new_vals, list_get(c.values, i));
            new_freqs = list_push(new_freqs, list_get(c.freqs, i));
        }
        i = i + 1;
    }
    return LfuCache {
        keys: new_keys,
        values: new_vals,
        freqs: new_freqs,
        capacity: c.capacity,
        size: n - 1
    };
}

// Return all keys in the cache.
pub fn lfu_keys(c: LfuCache) -> List[Int] {
    return c.keys;
}
