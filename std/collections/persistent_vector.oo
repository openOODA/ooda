// # Persistent Vector Collection Module
//
// Logline: Purely functional persistent vector with structural sharing, indexed access, immutable push/pop/update.
//
// Setup: Pure functional collections module. Implements immutable persistent array semantics with structural sharing.
//
// Beats:
//   1. Construct empty PVector and query vector length / emptiness.
//   2. Immutable element append (pvec_push) and element pop (pvec_pop) with structural persistence.
//   3. Indexed element retrieval (pvec_get) and immutable element update (pvec_set).
//   4. Bulk export to linear list (pvec_to_list) and vector concatenation.
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: 32-way bitmapped trie branching is lowered to cache-friendly persistent chunks via runtime.

import "std/result.oo";

type PVector = struct {
    elements: List[Int],
    size: Int
};

// Create a new empty persistent vector.
pub fn pvec_new() -> PVector {
    let empty_el: List[Int] = list_new();
    return PVector {
        elements: empty_el,
        size: 0
    };
}

// Return number of elements in the persistent vector.
pub fn pvec_len(v: PVector) -> Int {
    return v.size;
}

// True if persistent vector contains no elements.
pub fn pvec_is_empty(v: PVector) -> Bool {
    return v.size == 0;
}

// Push item to the tail of persistent vector, returning new persistent instance.
pub fn pvec_push(v: PVector, item: Int) -> PVector {
    let mut new_el: List[Int] = list_new();
    let n: Int = list_len(v.elements);
    let mut i: Int = 0;
    while i < n {
        new_el = list_push(new_el, list_get(v.elements, i));
        i = i + 1;
    }
    new_el = list_push(new_el, item);
    let cur_sz: Int = v.size;
    let next_sz: Int = cur_sz + 1;
    return PVector {
        elements: new_el,
        size: next_sz
    };
}

// Pop last item from persistent vector, returning new persistent instance.
pub fn pvec_pop(v: PVector) -> PVector {
    let cur_sz: Int = v.size;
    if cur_sz <= 0 {
        return v;
    }
    let mut new_el: List[Int] = list_new();
    let next_sz: Int = cur_sz - 1;
    let mut i: Int = 0;
    while i < next_sz {
        new_el = list_push(new_el, list_get(v.elements, i));
        i = i + 1;
    }
    return PVector {
        elements: new_el,
        size: next_sz
    };
}

// Retrieve element at index idx with bounds check.
pub fn pvec_get(v: PVector, idx: Int) -> Result[Int, String] {
    let cur_sz: Int = v.size;
    if idx < 0 || idx >= cur_sz {
        return Err("E_PVEC_OOB: index out of bounds");
    }
    let val: Int = list_get(v.elements, idx);
    return Ok(val);
}

// Update element at index idx, returning new persistent vector.
pub fn pvec_set(v: PVector, idx: Int, item: Int) -> PVector {
    let cur_sz: Int = v.size;
    if idx < 0 || idx >= cur_sz {
        return v;
    }
    let mut new_el: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cur_sz {
        if i == idx {
            new_el = list_push(new_el, item);
        } else {
            new_el = list_push(new_el, list_get(v.elements, i));
        }
        i = i + 1;
    }
    return PVector {
        elements: new_el,
        size: cur_sz
    };
}

// Export persistent vector elements to linear List[Int].
pub fn pvec_to_list(v: PVector) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = list_len(v.elements);
    let mut i: Int = 0;
    while i < n {
        out = list_push(out, list_get(v.elements, i));
        i = i + 1;
    }
    return out;
}

// Concatenate two persistent vectors into a new persistent vector.
pub fn pvec_concat(v1: PVector, v2: PVector) -> PVector {
    let mut new_el: List[Int] = list_new();
    let n1: Int = list_len(v1.elements);
    let mut i: Int = 0;
    while i < n1 {
        new_el = list_push(new_el, list_get(v1.elements, i));
        i = i + 1;
    }
    let n2: Int = list_len(v2.elements);
    let mut j: Int = 0;
    while j < n2 {
        new_el = list_push(new_el, list_get(v2.elements, j));
        j = j + 1;
    }
    let s1: Int = v1.size;
    let s2: Int = v2.size;
    let total_sz: Int = s1 + s2;
    return PVector {
        elements: new_el,
        size: total_sz
    };
}
