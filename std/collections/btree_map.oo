// # B-Tree Map
//
// Logline: Ordered associative collection maintaining sorted key-value pairs.
//
// Setup: Pure sorted sequence mapping unique string keys to string values.
//
// Beats:
//   1. Construct empty BTreeMap and check length or emptiness.
//   2. Insert key-value pairs maintaining lexicographical key order.
//   3. Lookup values by key with Result semantics.
//   4. Remove keys and enumerate ordered keys and values.
//
// residual: fixed in-memory sorted array backing; no node splitting overhead

type BTreeMap = struct {
    keys: List[Int],
    values: List[Int],
    size: Int,
};

fn int_compare(a: Int, b: Int) -> Int {
    if a == b {
        return 0;
    }
    if a < b {
        return -1;
    }
    return 1;
}

// Create a new empty BTreeMap.
pub fn btree_map_new() -> BTreeMap {
    let ks: List[Int] = list_new();
    let vs: List[Int] = list_new();
    return BTreeMap {
        keys: ks,
        values: vs,
        size: 0
    };
}

// Return the number of key-value pairs in the map.
pub fn btree_map_len(m: BTreeMap) -> Int {
    return m.size;
}

// True when the map contains no entries.
pub fn btree_map_is_empty(m: BTreeMap) -> Bool {
    return m.size == 0;
}

// Return a new empty map.
pub fn btree_map_clear() -> BTreeMap {
    return btree_map_new();
}

// Find index where key is located or where it should be inserted.
fn btree_map_find_idx(m: BTreeMap, key: Int) -> Int {
    let mut i: Int = 0;
    let n: Int = m.size;
    while i < n {
        let k: Int = list_get(m.keys, i);
        let cmp: Int = int_compare(k, key);
        if cmp >= 0 {
            return i;
        }
        i = i + 1;
    }
    return n;
}

// Check if a key exists in the map.
pub fn btree_map_contains(m: BTreeMap, key: Int) -> Bool {
    let n: Int = m.size;
    let idx: Int = btree_map_find_idx(m, key);
    if idx < n {
        if list_get(m.keys, idx) == key {
            return true;
        }
    }
    return false;
}

// Retrieve value associated with key.
pub fn btree_map_get(m: BTreeMap, key: Int) -> Result[Int, String] {
    let n: Int = m.size;
    let idx: Int = btree_map_find_idx(m, key);
    if idx < n {
        if list_get(m.keys, idx) == key {
            return Ok(list_get(m.values, idx));
        }
    }
    return Err("KEY_NOT_FOUND");
}

// Insert or update key-value association maintaining sort order.
pub fn btree_map_insert(m: BTreeMap, key: Int, val: Int) -> BTreeMap {
    let n: Int = m.size;
    let idx: Int = btree_map_find_idx(m, key);
    let mut new_keys: List[Int] = list_new();
    let mut new_vals: List[Int] = list_new();
    let mut i: Int = 0;

    if idx < n && list_get(m.keys, idx) == key {
        while i < n {
            new_keys = list_push(new_keys, list_get(m.keys, i));
            if i == idx {
                new_vals = list_push(new_vals, val);
            } else {
                new_vals = list_push(new_vals, list_get(m.values, i));
            }
            i = i + 1;
        }
        return BTreeMap {
            keys: new_keys,
            values: new_vals,
            size: n
        };
    }

    while i < idx {
        new_keys = list_push(new_keys, list_get(m.keys, i));
        new_vals = list_push(new_vals, list_get(m.values, i));
        i = i + 1;
    }
    new_keys = list_push(new_keys, key);
    new_vals = list_push(new_vals, val);
    while i < n {
        new_keys = list_push(new_keys, list_get(m.keys, i));
        new_vals = list_push(new_vals, list_get(m.values, i));
        i = i + 1;
    }

    return BTreeMap {
        keys: new_keys,
        values: new_vals,
        size: n + 1
    };
}

// Remove key from map if present.
pub fn btree_map_remove(m: BTreeMap, key: Int) -> BTreeMap {
    let n: Int = m.size;
    let idx: Int = btree_map_find_idx(m, key);
    if idx >= n || list_get(m.keys, idx) != key {
        return m;
    }
    let mut new_keys: List[Int] = list_new();
    let mut new_vals: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i != idx {
            new_keys = list_push(new_keys, list_get(m.keys, i));
            new_vals = list_push(new_vals, list_get(m.values, i));
        }
        i = i + 1;
    }
    return BTreeMap {
        keys: new_keys,
        values: new_vals,
        size: n - 1
    };
}

// Smallest key in the map.
pub fn btree_map_min_key(m: BTreeMap) -> Result[Int, String] {
    if m.size == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(m.keys, 0));
}

// Largest key in the map.
pub fn btree_map_max_key(m: BTreeMap) -> Result[Int, String] {
    let n: Int = m.size;
    if n == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(m.keys, n - 1));
}

// Enumerate all sorted keys.
pub fn btree_map_keys(m: BTreeMap) -> List[Int] {
    return m.keys;
}

// Enumerate all values in key order.
pub fn btree_map_values(m: BTreeMap) -> List[Int] {
    return m.values;
}
