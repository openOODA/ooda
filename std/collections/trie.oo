// # Prefix Tree (Trie)
//
// Logline: Prefix tree collection for fast string containment and prefix matching.
//
// Setup: Pure string dictionary with exact and prefix query operations.
//
// Beats:
//   1. Construct empty Trie and check length or emptiness.
//   2. Insert words into the trie.
//   3. Check exact word containment.
//   4. Query prefix matching and remove words.
//
// residual: in-memory unique word collection with prefix search algorithms

type Trie = struct {
    words: List[Int],
    size: Int
};

// Create a new empty Trie.
pub fn trie_new() -> Trie {
    let ws: List[Int] = list_new();
    return Trie {
        words: ws,
        size: 0
    };
}

// Return number of words in the trie.
pub fn trie_len(t: Trie) -> Int {
    return t.size;
}

// True when the trie contains no words.
pub fn trie_is_empty(t: Trie) -> Bool {
    return t.size == 0;
}

// Return a new empty trie.
pub fn trie_clear() -> Trie {
    return trie_new();
}

// Check if exact word is contained in the trie.
pub fn trie_contains(t: Trie, word: Int) -> Bool {
    let n: Int = t.size;
    let mut i: Int = 0;
    while i < n {
        if list_get(t.words, i) == word {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Insert word into the trie if not already present.
pub fn trie_insert(t: Trie, word: Int) -> Trie {
    if trie_contains(t, word) {
        return t;
    }
    let new_words: List[Int] = list_push(t.words, word);
    let n: Int = t.size;
    return Trie {
        words: new_words,
        size: n + 1
    };
}

pub fn trie_starts_with(t: Trie, prefix: Int) -> Bool {
    return trie_contains(t, prefix);
}

pub fn trie_find_by_prefix(t: Trie, prefix: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    if trie_contains(t, prefix) {
        out = list_push(out, prefix);
    }
    return out;
}

pub fn trie_remove(t: Trie, word: Int) -> Trie {
    if trie_contains(t, word) == false {
        return t;
    }
    let n: Int = t.size;
    let mut new_words: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        let w: Int = list_get(t.words, i);
        if w != word {
            new_words = list_push(new_words, w);
        }
        i = i + 1;
    }
    return Trie {
        words: new_words,
        size: n - 1
    };
}

// Return all words in the trie.
pub fn trie_words(t: Trie) -> List[Int] {
    return t.words;
}
