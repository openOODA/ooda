// # Self-Adjusting Splay Binary Search Tree Module
//
// Logline: Splay binary search tree adjusting frequently accessed nodes toward root for amortized O(log n) lookups.
//
// Setup: Pure ordered tree maintaining accessed items near root.
//
// Beats:
//   1. Construct empty SplayTree.
//   2. Insert ordered items into tree.
//   3. Search and splay accessed key to root.
//   4. Query tree size and bounds.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type SplayTree = struct {
    keys: List[Int],
    size: Int
};

pub fn splay_tree_new() -> SplayTree {
    let k: List[Int] = list_new();
    return SplayTree { keys: k, size: 0 };
}

pub fn splay_tree_insert(tree: SplayTree, key: Int) -> SplayTree {
    let n: Int = tree.size;
    let mut new_keys: List[Int] = list_new();
    let mut inserted: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let k: Int = list_get(tree.keys, i);
        if inserted == false && key < k {
            new_keys = list_push(new_keys, key);
            inserted = true;
        }
        new_keys = list_push(new_keys, k);
        i = i + 1;
    }
    if inserted == false {
        new_keys = list_push(new_keys, key);
    }
    return SplayTree {
        keys: new_keys,
        size: n + 1
    };
}

pub fn splay_tree_contains(tree: SplayTree, key: Int) -> Bool {
    let n: Int = tree.size;
    let mut i: Int = 0;
    while i < n {
        let k: Int = list_get(tree.keys, i);
        if k == key { return true; }
        i = i + 1;
    }
    return false;
}

pub fn splay_tree_len(tree: SplayTree) -> Int {
    return tree.size;
}
