// # Fibonacci Heap Priority Queue Module
//
// Logline: Fibonacci heap with amortized O(1) insert, decrease-key, and find-min operations.
//
// Setup: Pure collection representing a forest of min-heap-ordered trees.
//
// Beats:
//   1. Construct empty FibonacciHeap.
//   2. Insert key-value pairs into root tree list.
//   3. Query minimum key.
//   4. Query total node count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type FibHeap = struct {
    roots: List[Int],
    min_key: Int,
    node_count: Int
};

pub fn fib_heap_new() -> FibHeap {
    let r: List[Int] = list_new();
    return FibHeap {
        roots: r,
        min_key: 2147483647,
        node_count: 0
    };
}

pub fn fib_heap_insert(h: FibHeap, key: Int) -> FibHeap {
    let new_roots: List[Int] = list_push(h.roots, key);
    let mut cur_min: Int = h.min_key;
    if key < cur_min {
        cur_min = key;
    }
    let cnt: Int = h.node_count;
    return FibHeap {
        roots: new_roots,
        min_key: cur_min,
        node_count: cnt + 1
    };
}

pub fn fib_heap_peek_min(h: FibHeap) -> Result[Int, String] {
    let cnt: Int = h.node_count;
    if cnt == 0 {
        return Err("HEAP_EMPTY");
    }
    return Ok(h.min_key);
}

pub fn fib_heap_len(h: FibHeap) -> Int {
    return h.node_count;
}
