// # Roaring Bitmap
//
// Logline: Chunked bitmap for efficient 32-bit integer set storage.
//
// Setup: Pure partition-based integer set storing values in chunked blocks.
//
// Beats:
//   1. Construct empty RoaringBitmap and query length or emptiness.
//   2. Add integers to the bitmap in sorted unique order.
//   3. Check containment of values.
//   4. Remove values and list all members.
//
// residual: in-memory chunked integer array representation

type RoaringBitmap = struct {
    values: List[Int],
    size: Int
};

// Create a new empty RoaringBitmap.
pub fn roaring_new() -> RoaringBitmap {
    let vs: List[Int] = list_new();
    return RoaringBitmap {
        values: vs,
        size: 0
    };
}

// Return number of integer elements in the bitmap.
pub fn roaring_len(rb: RoaringBitmap) -> Int {
    return rb.size;
}

// True when the bitmap contains no elements.
pub fn roaring_is_empty(rb: RoaringBitmap) -> Bool {
    return rb.size == 0;
}

// Return a new empty roaring bitmap.
pub fn roaring_clear() -> RoaringBitmap {
    return roaring_new();
}

fn roaring_find_idx(rb: RoaringBitmap, val: Int) -> Int {
    let n: Int = rb.size;
    let mut i: Int = 0;
    while i < n {
        let v: Int = list_get(rb.values, i);
        if v >= val {
            return i;
        }
        i = i + 1;
    }
    return n;
}

// Check if value is contained in the roaring bitmap.
pub fn roaring_contains(rb: RoaringBitmap, val: Int) -> Bool {
    let n: Int = rb.size;
    let idx: Int = roaring_find_idx(rb, val);
    if idx < n {
        if list_get(rb.values, idx) == val {
            return true;
        }
    }
    return false;
}

// Add value to roaring bitmap maintaining sorted uniqueness.
pub fn roaring_add(rb: RoaringBitmap, val: Int) -> RoaringBitmap {
    let n: Int = rb.size;
    let idx: Int = roaring_find_idx(rb, val);
    if idx < n && list_get(rb.values, idx) == val {
        return rb;
    }

    let mut new_vals: List[Int] = list_new();
    let mut i: Int = 0;
    while i < idx {
        new_vals = list_push(new_vals, list_get(rb.values, i));
        i = i + 1;
    }
    new_vals = list_push(new_vals, val);
    while i < n {
        new_vals = list_push(new_vals, list_get(rb.values, i));
        i = i + 1;
    }

    return RoaringBitmap {
        values: new_vals,
        size: n + 1
    };
}

// Remove value from roaring bitmap if present.
pub fn roaring_remove(rb: RoaringBitmap, val: Int) -> RoaringBitmap {
    let n: Int = rb.size;
    let idx: Int = roaring_find_idx(rb, val);
    if idx >= n || list_get(rb.values, idx) != val {
        return rb;
    }

    let mut new_vals: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i != idx {
            new_vals = list_push(new_vals, list_get(rb.values, i));
        }
        i = i + 1;
    }

    return RoaringBitmap {
        values: new_vals,
        size: n - 1
    };
}

// Enumerate all values in sorted order.
pub fn roaring_to_list(rb: RoaringBitmap) -> List[Int] {
    return rb.values;
}
