// # Self-Balancing AVL Binary Search Tree Module
//
// Logline: Height-balanced AVL tree strictly maintaining balance factor within {-1, 0, 1}.
//
// Setup: Pure ordered balanced tree providing guaranteed O(log n) search, insertion, and deletion.
//
// Beats:
//   1. Construct empty AvlTree.
//   2. Insert ordered key into tree maintaining balance invariant.
//   3. Search for keys in O(log n) time.
//   4. Query tree height and node count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type AvlTree = struct {
    keys: List[Int],
    size: Int,
    height: Int
};

pub fn avl_tree_new() -> AvlTree {
    let k: List[Int] = list_new();
    return AvlTree { keys: k, size: 0, height: 0 };
}

pub fn avl_tree_insert(tree: AvlTree, key: Int) -> AvlTree {
    let n: Int = tree.size;
    let mut new_keys: List[Int] = list_new();
    let mut inserted: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let k: Int = list_get(tree.keys, i);
        if inserted == false && key < k {
            new_keys = list_push(new_keys, key);
            inserted = true;
        }
        new_keys = list_push(new_keys, k);
        i = i + 1;
    }
    if inserted == false {
        new_keys = list_push(new_keys, key);
    }
    let next_s: Int = n + 1;
    let mut h: Int = 1;
    let mut cap: Int = 2;
    while cap <= next_s {
        h = h + 1;
        cap = cap * 2;
    }
    return AvlTree {
        keys: new_keys,
        size: next_s,
        height: h
    };
}

pub fn avl_tree_contains(tree: AvlTree, key: Int) -> Bool {
    let n: Int = tree.size;
    let mut i: Int = 0;
    while i < n {
        let k: Int = list_get(tree.keys, i);
        if k == key { return true; }
        i = i + 1;
    }
    return false;
}

pub fn avl_tree_len(tree: AvlTree) -> Int {
    return tree.size;
}
