// # Inline Small Vector (SmallVec) Module
//
// Logline: Stack-promoted SmallVec optimization container with fixed inline buffer capacity and automatic dynamic heap spillover.
//
// Setup: Pure collection minimizing allocation overhead for typical short sequences while handling arbitrary length expansion.
//
// Beats:
//   1. Construct SmallVec with designated inline capacity threshold.
//   2. Push items into inline buffer until capacity exhaustion, then spill to dynamic list.
//   3. Pop items and query element index with bounds verification.
//   4. Inspect spill status, length, and inline occupancy metrics.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Stack-allocated fixed memory buffers lower via compiler local storage layout.

import "std/result.oo";

type SmallVec = struct {
    inline_data: List[Int],
    heap_data: List[Int],
    length: Int,
    inline_cap: Int,
    is_spilled: Bool
};

type SmallVecPopResult = struct {
    vec: SmallVec,
    value: Int
};

pub fn small_vec_new(inline_capacity: Int) -> SmallVec {
    let mut cap: Int = inline_capacity;
    if cap <= 0 {
        cap = 8;
    }
    let empty_in: List[Int] = list_new();
    let empty_heap: List[Int] = list_new();
    return SmallVec {
        inline_data: empty_in,
        heap_data: empty_heap,
        length: 0,
        inline_cap: cap,
        is_spilled: false
    };
}

pub fn small_vec_len(v: SmallVec) -> Int {
    return v.length;
}

pub fn small_vec_is_empty(v: SmallVec) -> Bool {
    let l: Int = v.length;
    return l == 0;
}

pub fn small_vec_is_spilled(v: SmallVec) -> Bool {
    return v.is_spilled;
}

pub fn small_vec_push(v: SmallVec, item: Int) -> SmallVec {
    let cur_len: Int = v.length;
    let cap: Int = v.inline_cap;
    let spilled: Bool = v.is_spilled;

    if spilled {
        let next_heap: List[Int] = list_push(v.heap_data, item);
        let next_len: Int = cur_len + 1;
        return SmallVec {
            inline_data: v.inline_data,
            heap_data: next_heap,
            length: next_len,
            inline_cap: v.inline_cap,
            is_spilled: true
        };
    }

    if cur_len < cap {
        let next_in: List[Int] = list_push(v.inline_data, item);
        let next_len: Int = cur_len + 1;
        return SmallVec {
            inline_data: next_in,
            heap_data: v.heap_data,
            length: next_len,
            inline_cap: v.inline_cap,
            is_spilled: false
        };
    }

    // Spill inline items to heap
    let mut spilled_heap: List[Int] = list_new();
    let nin: Int = list_len(v.inline_data);
    let mut i: Int = 0;
    while i < nin {
        spilled_heap = list_push(spilled_heap, list_get(v.inline_data, i));
        i = i + 1;
    }
    spilled_heap = list_push(spilled_heap, item);
    let empty_in: List[Int] = list_new();
    let next_len: Int = cur_len + 1;
    return SmallVec {
        inline_data: empty_in,
        heap_data: spilled_heap,
        length: next_len,
        inline_cap: v.inline_cap,
        is_spilled: true
    };
}

pub fn small_vec_get(v: SmallVec, idx: Int) -> Result[Int, String] {
    let cur_len: Int = v.length;
    if idx < 0 || idx >= cur_len {
        return Err("index_out_of_bounds");
    }
    if v.is_spilled {
        return Ok(list_get(v.heap_data, idx));
    }
    return Ok(list_get(v.inline_data, idx));
}

pub fn small_vec_pop(v: SmallVec) -> Result[SmallVecPopResult, String] {
    let cur_len: Int = v.length;
    if cur_len == 0 {
        return Err("empty_vector");
    }
    let last_idx: Int = cur_len - 1;
    let mut item: Int = 0;

    if v.is_spilled {
        item = list_get(v.heap_data, last_idx);
        let mut next_heap: List[Int] = list_new();
        let mut i: Int = 0;
        while i < last_idx {
            next_heap = list_push(next_heap, list_get(v.heap_data, i));
            i = i + 1;
        }
        let updated: SmallVec = SmallVec {
            inline_data: v.inline_data,
            heap_data: next_heap,
            length: last_idx,
            inline_cap: v.inline_cap,
            is_spilled: true
        };
        return Ok(SmallVecPopResult {
            vec: updated,
            value: item
        });
    }

    item = list_get(v.inline_data, last_idx);
    let mut next_in: List[Int] = list_new();
    let mut i: Int = 0;
    while i < last_idx {
        next_in = list_push(next_in, list_get(v.inline_data, i));
        i = i + 1;
    }
    let updated: SmallVec = SmallVec {
        inline_data: next_in,
        heap_data: v.heap_data,
        length: last_idx,
        inline_cap: v.inline_cap,
        is_spilled: false
    };
    return Ok(SmallVecPopResult {
        vec: updated,
        value: item
    });
}
