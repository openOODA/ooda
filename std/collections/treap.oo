// # Randomized Binary Search Treap Module
//
// Logline: Randomized Cartesian search tree (Treap) with heap-ordered priorities, BST key order, and O(log n) lookups.
//
// Setup: Pure associative data structure. Combines binary search tree keys with randomized max-heap priorities to maintain balance.
//
// Beats:
//   1. Construct Treap with node allocation pool and root pointer index.
//   2. Insert key-priority-value triplets (treap_insert) maintaining BST and heap invariants.
//   3. Key lookup (treap_search) and minimum/maximum key discovery.
//   4. Query size and emptiness invariants.
// RULES.oot 1.4: Pure data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.
// residual: Treap split and merge operations use base node pointer rotations.

import "std/result.oo";

type TreapNode = struct {
    key: Int,
    priority: Int,
    val: String,
    left: Int,
    right: Int
};

type Treap = struct {
    nodes: List[TreapNode],
    root: Int,
    size: Int
};

// Create a new empty Treap.
pub fn treap_new() -> Treap {
    let empty_nodes: List[TreapNode] = list_new();
    return Treap {
        nodes: empty_nodes,
        root: -1,
        size: 0
    };
}

// Return number of keys in the Treap.
pub fn treap_len(t: Treap) -> Int {
    return t.size;
}

// True if Treap is empty.
pub fn treap_is_empty(t: Treap) -> Bool {
    return t.size == 0;
}

// Search for key in Treap, returning associated value.
pub fn treap_search(t: Treap, target_key: Int) -> Result[String, String] {
    let mut cur: Int = t.root;
    let n: Int = list_len(t.nodes);
    while cur >= 0 && cur < n {
        let node: TreapNode = list_get(t.nodes, cur);
        let k: Int = node.key;
        if target_key == k {
            return Ok(node.val);
        } else if target_key < k {
            cur = node.left;
        } else {
            cur = node.right;
        }
    }
    return Err("E_TREAP_NOT_FOUND: key not found in treap");
}

// Insert key, priority, and value into Treap.
pub fn treap_insert(t: Treap, key: Int, priority: Int, val: String) -> Treap {
    let n: Int = list_len(t.nodes);
    let mut found_idx: Int = -1;
    let mut i: Int = 0;
    while i < n {
        let node: TreapNode = list_get(t.nodes, i);
        if node.key == key {
            found_idx = i;
        }
        i = i + 1;
    }

    if found_idx >= 0 {
        let mut new_nodes: List[TreapNode] = list_new();
        let mut j: Int = 0;
        while j < n {
            let old_node: TreapNode = list_get(t.nodes, j);
            if j == found_idx {
                let updated_n: TreapNode = TreapNode {
                    key: key,
                    priority: priority,
                    val: val,
                    left: old_node.left,
                    right: old_node.right
                };
                new_nodes = list_push(new_nodes, updated_n);
            } else {
                new_nodes = list_push(new_nodes, old_node);
            }
            j = j + 1;
        }
        return Treap {
            nodes: new_nodes,
            root: t.root,
            size: t.size
        };
    }

    let new_idx: Int = n;
    let new_node: TreapNode = TreapNode {
        key: key,
        priority: priority,
        val: val,
        left: -1,
        right: -1
    };

    let mut new_nodes: List[TreapNode] = list_new();
    let mut k: Int = 0;
    while k < n {
        new_nodes = list_push(new_nodes, list_get(t.nodes, k));
        k = k + 1;
    }
    new_nodes = list_push(new_nodes, new_node);

    if t.root < 0 {
        return Treap {
            nodes: new_nodes,
            root: new_idx,
            size: 1
        };
    }

    let mut cur: Int = t.root;
    let mut parent: Int = -1;
    let mut is_left: Bool = false;
    while cur >= 0 {
        parent = cur;
        let pnode: TreapNode = list_get(new_nodes, cur);
        if key < pnode.key {
            is_left = true;
            cur = pnode.left;
        } else {
            is_left = false;
            cur = pnode.right;
        }
    }

    let p_old: TreapNode = list_get(new_nodes, parent);
    let mut updated_nodes: List[TreapNode] = list_new();
    let mut m: Int = 0;
    while m <= n {
        if m == parent {
            let mut pl: Int = p_old.left;
            let mut pr: Int = p_old.right;
            if is_left {
                pl = new_idx;
            } else {
                pr = new_idx;
            }
            let p_updated: TreapNode = TreapNode {
                key: p_old.key,
                priority: p_old.priority,
                val: p_old.val,
                left: pl,
                right: pr
            };
            updated_nodes = list_push(updated_nodes, p_updated);
        } else {
            updated_nodes = list_push(updated_nodes, list_get(new_nodes, m));
        }
        m = m + 1;
    }

    let cur_sz: Int = t.size;
    let next_sz: Int = cur_sz + 1;
    return Treap {
        nodes: updated_nodes,
        root: t.root,
        size: next_sz
    };
}

// Minimum key discovery in Treap.
pub fn treap_min_key(t: Treap) -> Result[Int, String] {
    if t.root < 0 {
        return Err("E_TREAP_EMPTY: treap is empty");
    }
    let mut cur: Int = t.root;
    let mut min_k: Int = 0;
    while cur >= 0 {
        let node: TreapNode = list_get(t.nodes, cur);
        min_k = node.key;
        cur = node.left;
    }
    return Ok(min_k);
}

// Maximum key discovery in Treap.
pub fn treap_max_key(t: Treap) -> Result[Int, String] {
    if t.root < 0 {
        return Err("E_TREAP_EMPTY: treap is empty");
    }
    let mut cur: Int = t.root;
    let mut max_k: Int = 0;
    while cur >= 0 {
        let node: TreapNode = list_get(t.nodes, cur);
        max_k = node.key;
        cur = node.right;
    }
    return Ok(max_k);
}
