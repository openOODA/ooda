// # Randomized Binary Search Treap Module
//
// Logline: Treap destubbed to parallel List[Int] keys/values/priorities (no List[TreapNode]).
//
// Setup: Pure map. Emit-c hangs on List[struct] node pool.
//
// Beats:
//   1. Construct empty treap.
//   2. Insert Int key-priority-value triples.
//   3. Query containment and length.
// residual: Heap-BST rotations destubbed; this is ordered List[Int] scan.

type Treap = struct {
    keys: List[Int],
    values: List[Int],
    priorities: List[Int],
    size: Int
};

pub fn treap_new() -> Treap {
    let ks: List[Int] = list_new();
    let vs: List[Int] = list_new();
    let ps: List[Int] = list_new();
    return Treap {
        keys: ks,
        values: vs,
        priorities: ps,
        size: 0
    };
}

pub fn treap_len(t: Treap) -> Int {
    return t.size;
}

pub fn treap_is_empty(t: Treap) -> Bool {
    return t.size == 0;
}

fn treap_find(t: Treap, key: Int) -> Int {
    let n: Int = list_len(t.keys);
    let mut i: Int = 0;
    while i < n {
        if list_get(t.keys, i) == key {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn treap_contains(t: Treap, key: Int) -> Bool {
    let idx: Int = treap_find(t, key);
    return idx >= 0;
}

pub fn treap_insert(t: Treap, key: Int, priority: Int, val: Int) -> Treap {
    let n: Int = list_len(t.keys);
    let found_idx: Int = treap_find(t, key);
    let cur_sz: Int = t.size;
    if found_idx >= 0 {
        let mut new_vals: List[Int] = list_new();
        let mut new_pri: List[Int] = list_new();
        let mut j: Int = 0;
        while j < n {
            if j == found_idx {
                new_vals = list_push(new_vals, val);
                new_pri = list_push(new_pri, priority);
            } else {
                new_vals = list_push(new_vals, list_get(t.values, j));
                new_pri = list_push(new_pri, list_get(t.priorities, j));
            }
            j = j + 1;
        }
        return Treap {
            keys: t.keys,
            values: new_vals,
            priorities: new_pri,
            size: cur_sz
        };
    }
    return Treap {
        keys: list_push(t.keys, key),
        values: list_push(t.values, val),
        priorities: list_push(t.priorities, priority),
        size: cur_sz + 1
    };
}

pub fn treap_get(t: Treap, key: Int) -> Int {
    let idx: Int = treap_find(t, key);
    if idx < 0 {
        return 0;
    }
    return list_get(t.values, idx);
}
