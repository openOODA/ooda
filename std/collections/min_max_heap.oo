// # Min-Max Double-Ended Heap Module
//
// Logline: Double-ended priority queue supporting O(1) find-min, find-max and logarithmic insertions/deletions.
//
// Setup: Pure binary tree structure with alternating min-levels and max-levels.
//
// Beats:
//   1. Construct empty MinMaxHeap.
//   2. Insert integer values into alternating min-max levels.
//   3. Query minimum and maximum elements in O(1) time.
//   4. Query size and emptiness.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type MinMaxHeap = struct {
    tree: List[Int],
    size: Int
};

pub fn min_max_heap_new() -> MinMaxHeap {
    let t: List[Int] = list_new();
    return MinMaxHeap { tree: t, size: 0 };
}

pub fn min_max_heap_push(h: MinMaxHeap, val: Int) -> MinMaxHeap {
    let new_tree: List[Int] = list_push(h.tree, val);
    let s: Int = h.size;
    return MinMaxHeap {
        tree: new_tree,
        size: s + 1
    };
}

pub fn min_max_heap_peek_min(h: MinMaxHeap) -> Result[Int, String] {
    let s: Int = h.size;
    if s == 0 {
        return Err("HEAP_EMPTY");
    }
    return Ok(list_get(h.tree, 0));
}

pub fn min_max_heap_peek_max(h: MinMaxHeap) -> Result[Int, String] {
    let s: Int = h.size;
    if s == 0 {
        return Err("HEAP_EMPTY");
    }
    if s == 1 {
        return Ok(list_get(h.tree, 0));
    }
    let v1: Int = list_get(h.tree, 1);
    if s == 2 {
        return Ok(v1);
    }
    let v2: Int = list_get(h.tree, 2);
    if v2 > v1 {
        return Ok(v2);
    }
    return Ok(v1);
}

pub fn min_max_heap_len(h: MinMaxHeap) -> Int {
    return h.size;
}
