// # Least Recently Used (LRU) Cache
//
// Logline: Fixed-capacity associative cache evicting least-recently-used items.
//
// Setup: Pure associative cache with recency-ordered keys and values.
//
// Beats:
//   1. Construct LruCache with capacity limit.
//   2. Put key-value pairs, evicting oldest on capacity overflow.
//   3. Get values, promoting accessed key to most recent.
//   4. Remove keys and check containment.
//
// residual: in-memory key-value list with recency order (index 0 = LRU, end = MRU)

type LruCache = struct {
    keys: List[String],
    values: List[String],
    capacity: Int,
    size: Int
};

// Create a new LRU cache with given capacity limit.
pub fn lru_new(capacity: Int) -> LruCache {
    let mut cap: Int = capacity;
    if cap < 1 {
        cap = 1;
    }
    let ks: List[String] = list_new();
    let vs: List[String] = list_new();
    return LruCache {
        keys: ks,
        values: vs,
        capacity: cap,
        size: 0
    };
}

// Return number of entries in the cache.
pub fn lru_len(c: LruCache) -> Int {
    return c.size;
}

// Return maximum capacity of the cache.
pub fn lru_capacity(c: LruCache) -> Int {
    return c.capacity;
}

// True when the cache contains no entries.
pub fn lru_is_empty(c: LruCache) -> Bool {
    return c.size == 0;
}

// Clear all entries while preserving capacity.
pub fn lru_clear(c: LruCache) -> LruCache {
    return lru_new(c.capacity);
}

fn lru_find_idx(c: LruCache, key: String) -> Int {
    let n: Int = c.size;
    let mut i: Int = 0;
    while i < n {
        if list_get(c.keys, i) == key {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Check if key is present in cache without updating recency.
pub fn lru_contains(c: LruCache, key: String) -> Bool {
    let idx: Int = lru_find_idx(c, key);
    return idx >= 0;
}

// Retrieve value associated with key.
pub fn lru_get(c: LruCache, key: String) -> Result[String, String] {
    let idx: Int = lru_find_idx(c, key);
    if idx >= 0 {
        return Ok(list_get(c.values, idx));
    }
    return Err("KEY_NOT_FOUND");
}

// Put key-value pair, promoting to MRU and evicting LRU if exceeding capacity.
pub fn lru_put(c: LruCache, key: String, val: String) -> LruCache {
    let n: Int = c.size;
    let cap: Int = c.capacity;
    let idx: Int = lru_find_idx(c, key);

    let mut new_keys: List[String] = list_new();
    let mut new_vals: List[String] = list_new();
    let mut i: Int = 0;

    if idx >= 0 {
        // Remove from current position and append at end (MRU)
        while i < n {
            if i != idx {
                new_keys = list_push(new_keys, list_get(c.keys, i));
                new_vals = list_push(new_vals, list_get(c.values, i));
            }
            i = i + 1;
        }
        new_keys = list_push(new_keys, key);
        new_vals = list_push(new_vals, val);
        return LruCache {
            keys: new_keys,
            values: new_vals,
            capacity: cap,
            size: n
        };
    }

    // New key: check if eviction needed (if size >= capacity, drop index 0)
    let mut start_idx: Int = 0;
    let mut current_size: Int = n;
    if n >= cap {
        start_idx = 1;
        current_size = n - 1;
    }

    i = start_idx;
    while i < n {
        new_keys = list_push(new_keys, list_get(c.keys, i));
        new_vals = list_push(new_vals, list_get(c.values, i));
        i = i + 1;
    }
    new_keys = list_push(new_keys, key);
    new_vals = list_push(new_vals, val);

    return LruCache {
        keys: new_keys,
        values: new_vals,
        capacity: cap,
        size: current_size + 1
    };
}

// Remove key from cache if present.
pub fn lru_remove(c: LruCache, key: String) -> LruCache {
    let idx: Int = lru_find_idx(c, key);
    if idx < 0 {
        return c;
    }
    let n: Int = c.size;
    let mut new_keys: List[String] = list_new();
    let mut new_vals: List[String] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i != idx {
            new_keys = list_push(new_keys, list_get(c.keys, i));
            new_vals = list_push(new_vals, list_get(c.values, i));
        }
        i = i + 1;
    }
    return LruCache {
        keys: new_keys,
        values: new_vals,
        capacity: c.capacity,
        size: n - 1
    };
}

// Return keys in order from LRU (index 0) to MRU (end).
pub fn lru_keys(c: LruCache) -> List[String] {
    return c.keys;
}
