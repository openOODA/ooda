// # Radix (Patricia) Compact Tree Module
//
// Logline: Compressed radix Patricia trie indexing strings with shared edge prefix compression.
//
// Setup: Pure string dictionary with compressed path traversal.
//
// Beats:
//   1. Construct empty RadixTrie.
//   2. Insert key-value string pairs with longest common prefix compression.
//   3. Prefix search and exact key search.
//   4. Query stored key count.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/str.oo";

type RadixTrie = struct {
    keys: List[String],
    size: Int
};

pub fn radix_trie_new() -> RadixTrie {
    let k: List[String] = list_new();
    return RadixTrie { keys: k, size: 0 };
}

pub fn radix_trie_insert(trie: RadixTrie, key: String) -> RadixTrie {
    let new_keys: List[String] = list_push(trie.keys, key);
    let s: Int = trie.size;
    return RadixTrie {
        keys: new_keys,
        size: s + 1
    };
}

pub fn radix_trie_contains(trie: RadixTrie, key: String) -> Bool {
    let n: Int = trie.size;
    let mut i: Int = 0;
    while i < n {
        let k: String = list_get(trie.keys, i);
        if str_eq(k, key) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn radix_trie_starts_with(trie: RadixTrie, prefix: String) -> Bool {
    let n: Int = trie.size;
    let mut i: Int = 0;
    while i < n {
        let k: String = list_get(trie.keys, i);
        if starts_with(k, prefix) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn radix_trie_len(trie: RadixTrie) -> Int {
    return trie.size;
}
