// # Standard Collections Overview
//
// Logline: Unified catalog and registry for the 24 openOODA pure standard collection modules.
//
// Setup: Pure collection registry organizing associative, sequential, tree, and probabilistic collections.
//
// Beats:
//   1. Query collection module availability by name.
//   2. Return total module and category counts in catalog descriptor.
//   3. List all 24 collection modules.
//   4. Classify collection modules into functional categories.
//
// residual: catalog and registry overview for modular pure collection types

type CollectionCatalog = struct {
    total_modules: Int,
    category_count: Int
};

// Return total count of pure collection modules (24).
pub fn collections_count() -> Int {
    return 24;
}

// Return standard collection catalog summary.
pub fn collections_catalog() -> CollectionCatalog {
    return CollectionCatalog {
        total_modules: 24,
        category_count: 5
    };
}

// Check if a given module name is part of standard collections.
pub fn collections_is_available(name: String) -> Bool {
    if name == "btree_map" || name == "btree_set" || name == "priority_queue" || name == "binary_heap" { return true; }
    if name == "trie" || name == "radix_tree" || name == "deque" || name == "ring_buffer" { return true; }
    if name == "lru_cache" || name == "lfu_cache" || name == "bitset" || name == "roaring_bitmap" { return true; }
    if name == "skip_list" || name == "disjoint_set" || name == "hash_map" || name == "hash_set" { return true; }
    if name == "vec" || name == "queue" || name == "stack" || name == "linked_list" { return true; }
    if name == "interval_tree" || name == "bloom_filter" || name == "min_heap" || name == "max_heap" { return true; }
    return false;
}

// Return list of all 24 collection module names.
pub fn collections_list() -> List[String] {
    let mut out: List[String] = list_new();
    out = list_push(out, "btree_map");
    out = list_push(out, "btree_set");
    out = list_push(out, "priority_queue");
    out = list_push(out, "binary_heap");
    out = list_push(out, "trie");
    out = list_push(out, "radix_tree");
    out = list_push(out, "deque");
    out = list_push(out, "ring_buffer");
    out = list_push(out, "lru_cache");
    out = list_push(out, "lfu_cache");
    out = list_push(out, "bitset");
    out = list_push(out, "roaring_bitmap");
    out = list_push(out, "skip_list");
    out = list_push(out, "disjoint_set");
    out = list_push(out, "hash_map");
    out = list_push(out, "hash_set");
    out = list_push(out, "vec");
    out = list_push(out, "queue");
    out = list_push(out, "stack");
    out = list_push(out, "linked_list");
    out = list_push(out, "interval_tree");
    out = list_push(out, "bloom_filter");
    out = list_push(out, "min_heap");
    out = list_push(out, "max_heap");
    return out;
}

// Return functional category name for a collection module.
pub fn collections_category(name: String) -> String {
    if name == "vec" || name == "deque" || name == "queue" || name == "stack" || name == "linked_list" || name == "ring_buffer" {
        return "Sequential";
    }
    if name == "hash_map" || name == "hash_set" || name == "btree_map" || name == "btree_set" || name == "skip_list" || name == "radix_tree" {
        return "Associative";
    }
    if name == "binary_heap" || name == "min_heap" || name == "max_heap" || name == "priority_queue" {
        return "Heap";
    }
    if name == "trie" || name == "interval_tree" || name == "disjoint_set" {
        return "Tree & Forest";
    }
    if name == "bitset" || name == "roaring_bitmap" || name == "bloom_filter" || name == "lru_cache" || name == "lfu_cache" {
        return "Specialized & Cache";
    }
    return "Unknown";
}
