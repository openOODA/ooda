// # Double-Ended Queue (Deque)
//
// Logline: Double-ended queue supporting push and pop at front and back.
//
// Setup: Pure sequence supporting O(1) front and back element access.
//
// Beats:
//   1. Construct empty Deque and check length or emptiness.
//   2. Push elements to the front or back.
//   3. Peek front and back elements.
//   4. Pop elements from the front or back and clear deque.
//
// residual: in-memory list representation with index-based front/back access

type Deque = struct {
    data: List[String],
    size: Int
};

// Create a new empty Deque.
pub fn deque_new() -> Deque {
    let d: List[String] = list_new();
    return Deque {
        data: d,
        size: 0
    };
}

// Return number of elements in the deque.
pub fn deque_len(d: Deque) -> Int {
    return d.size;
}

// True when the deque contains no elements.
pub fn deque_is_empty(d: Deque) -> Bool {
    return d.size == 0;
}

// Return a new empty deque.
pub fn deque_clear() -> Deque {
    return deque_new();
}

// Push element to the back of the deque.
pub fn deque_push_back(d: Deque, val: String) -> Deque {
    let new_data: List[String] = list_push(d.data, val);
    let n: Int = d.size;
    return Deque {
        data: new_data,
        size: n + 1
    };
}

// Push element to the front of the deque.
pub fn deque_push_front(d: Deque, val: String) -> Deque {
    let n: Int = d.size;
    let mut new_data: List[String] = list_new();
    new_data = list_push(new_data, val);
    let mut i: Int = 0;
    while i < n {
        new_data = list_push(new_data, list_get(d.data, i));
        i = i + 1;
    }
    return Deque {
        data: new_data,
        size: n + 1
    };
}

// Pop element from the back of the deque.
pub fn deque_pop_back(d: Deque) -> Deque {
    let n: Int = d.size;
    if n <= 1 {
        return deque_new();
    }
    let mut new_data: List[String] = list_new();
    let mut i: Int = 0;
    let new_len: Int = n - 1;
    while i < new_len {
        new_data = list_push(new_data, list_get(d.data, i));
        i = i + 1;
    }
    return Deque {
        data: new_data,
        size: new_len
    };
}

// Pop element from the front of the deque.
pub fn deque_pop_front(d: Deque) -> Deque {
    let n: Int = d.size;
    if n <= 1 {
        return deque_new();
    }
    let mut new_data: List[String] = list_new();
    let mut i: Int = 1;
    while i < n {
        new_data = list_push(new_data, list_get(d.data, i));
        i = i + 1;
    }
    return Deque {
        data: new_data,
        size: n - 1
    };
}

// Peek front element without removing it.
pub fn deque_peek_front(d: Deque) -> Result[String, String] {
    if d.size == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(d.data, 0));
}

// Peek back element without removing it.
pub fn deque_peek_back(d: Deque) -> Result[String, String] {
    let n: Int = d.size;
    if n == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(d.data, n - 1));
}

// Get element at 0-based index.
pub fn deque_get(d: Deque, index: Int) -> Result[String, String] {
    let n: Int = d.size;
    if index < 0 || index >= n {
        return Err("INDEX_OUT_OF_BOUNDS");
    }
    return Ok(list_get(d.data, index));
}
