// # Interval Tree
//
// Logline: Ordered interval tree for storing numeric ranges and querying overlaps.
//
// Setup: Pure interval collection storing intervals [low, high] with associated string tags.
//
// Beats:
//   1. Construct empty IntervalTree and check length or emptiness.
//   2. Insert interval ranges [low, high] with associated tags.
//   3. Query whether target range [q_low, q_high] overlaps any interval.
//   4. Enumerate all overlapping interval tags and remove intervals.
//
// residual: in-memory list tracking 1D integer intervals with overlap detection

type IntervalTree = struct {
    lows: List[Int],
    highs: List[Int],
    tags: List[Int],
    size: Int
};

// Create a new empty IntervalTree.
pub fn interval_tree_new() -> IntervalTree {
    let ls: List[Int] = list_new();
    let hs: List[Int] = list_new();
    let ts: List[Int] = list_new();
    return IntervalTree {
        lows: ls,
        highs: hs,
        tags: ts,
        size: 0
    };
}

// Return number of intervals in the tree.
pub fn interval_tree_len(it: IntervalTree) -> Int {
    return it.size;
}

// True when interval tree contains no intervals.
pub fn interval_tree_is_empty(it: IntervalTree) -> Bool {
    return it.size == 0;
}

// Return a new empty interval tree.
pub fn interval_tree_clear() -> IntervalTree {
    return interval_tree_new();
}

// Insert interval [low, high] with tag.
pub fn interval_tree_insert(it: IntervalTree, low: Int, high: Int, tag: Int) -> IntervalTree {
    let mut l: Int = low;
    let mut h: Int = high;
    if l > h {
        let tmp: Int = l;
        l = h;
        h = tmp;
    }
    let n: Int = it.size;
    let mut insert_idx: Int = n;
    let mut i: Int = 0;
    while i < n {
        let cur_l: Int = list_get(it.lows, i);
        if cur_l >= l {
            insert_idx = i;
            break;
        }
        i = i + 1;
    }

    let mut new_lows: List[Int] = list_new();
    let mut new_highs: List[Int] = list_new();
    let mut new_tags: List[Int] = list_new();
    let mut j: Int = 0;
    while j < insert_idx {
        new_lows = list_push(new_lows, list_get(it.lows, j));
        new_highs = list_push(new_highs, list_get(it.highs, j));
        new_tags = list_push(new_tags, list_get(it.tags, j));
        j = j + 1;
    }
    new_lows = list_push(new_lows, l);
    new_highs = list_push(new_highs, h);
    new_tags = list_push(new_tags, tag);
    while j < n {
        new_lows = list_push(new_lows, list_get(it.lows, j));
        new_highs = list_push(new_highs, list_get(it.highs, j));
        new_tags = list_push(new_tags, list_get(it.tags, j));
        j = j + 1;
    }

    return IntervalTree {
        lows: new_lows,
        highs: new_highs,
        tags: new_tags,
        size: n + 1
    };
}

// Check if any interval overlaps with [q_low, q_high].
pub fn interval_tree_has_overlap(it: IntervalTree, q_low: Int, q_high: Int) -> Bool {
    let mut ql: Int = q_low;
    let mut qh: Int = q_high;
    if ql > qh {
        let tmp: Int = ql;
        ql = qh;
        qh = tmp;
    }
    let n: Int = it.size;
    let mut i: Int = 0;
    while i < n {
        let l: Int = list_get(it.lows, i);
        let h: Int = list_get(it.highs, i);
        if l <= qh && h >= ql {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Find all tags of intervals overlapping [q_low, q_high].
pub fn interval_tree_find_overlaps(it: IntervalTree, q_low: Int, q_high: Int) -> List[Int] {
    let mut ql: Int = q_low;
    let mut qh: Int = q_high;
    if ql > qh {
        let tmp: Int = ql;
        ql = qh;
        qh = tmp;
    }
    let mut out: List[Int] = list_new();
    let n: Int = it.size;
    let mut i: Int = 0;
    while i < n {
        let l: Int = list_get(it.lows, i);
        let h: Int = list_get(it.highs, i);
        if l <= qh && h >= ql {
            out = list_push(out, list_get(it.tags, i));
        }
        i = i + 1;
    }
    return out;
}

// Remove interval matching exact low and high bounds.
pub fn interval_tree_remove(it: IntervalTree, low: Int, high: Int) -> IntervalTree {
    let mut l: Int = low;
    let mut h: Int = high;
    if l > h {
        let tmp: Int = l;
        l = h;
        h = tmp;
    }
    let n: Int = it.size;
    let mut new_lows: List[Int] = list_new();
    let mut new_highs: List[Int] = list_new();
    let mut new_tags: List[Int] = list_new();
    let mut found: Bool = false;
    let mut i: Int = 0;

    while i < n {
        let cur_l: Int = list_get(it.lows, i);
        let cur_h: Int = list_get(it.highs, i);
        if cur_l == l && cur_h == h && found == false {
            found = true;
        } else {
            new_lows = list_push(new_lows, cur_l);
            new_highs = list_push(new_highs, cur_h);
            new_tags = list_push(new_tags, list_get(it.tags, i));
        }
        i = i + 1;
    }

    if found == false {
        return it;
    }

    return IntervalTree {
        lows: new_lows,
        highs: new_highs,
        tags: new_tags,
        size: n - 1
    };
}
