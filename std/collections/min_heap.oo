// # Binary Min-Heap
//
// Logline: Min-heap for integer elements supporting push, pop, and peek.
//
// Setup: Pure array-backed binary min-heap maintaining root-minimum invariant.
//
// Beats:
//   1. Construct empty MinHeap and check length or emptiness.
//   2. Push integer elements into heap with sift-up.
//   3. Peek minimum element at root.
//   4. Pop minimum root element and clear heap.
//
// residual: fixed List[Int] tree representation; 0-indexed parent = (i-1)/2

type MinHeap = struct {
    data: List[Int],
    size: Int
};

// Create a new empty MinHeap.
pub fn min_heap_new() -> MinHeap {
    let d: List[Int] = list_new();
    return MinHeap {
        data: d,
        size: 0
    };
}

// Return number of elements in the min-heap.
pub fn min_heap_len(h: MinHeap) -> Int {
    return h.size;
}

// True when the min-heap contains no elements.
pub fn min_heap_is_empty(h: MinHeap) -> Bool {
    return h.size == 0;
}

// Return a new empty min-heap.
pub fn min_heap_clear() -> MinHeap {
    return min_heap_new();
}

fn min_heap_set_at(xs: List[Int], idx: Int, val: Int, n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            out = list_push(out, val);
        } else {
            out = list_push(out, list_get(xs, i));
        }
        i = i + 1;
    }
    return out;
}

// Push element into heap with sift-up.
pub fn min_heap_push(h: MinHeap, val: Int) -> MinHeap {
    let n: Int = h.size;
    let mut d: List[Int] = list_push(h.data, val);
    let mut curr: Int = n;
    let total: Int = n + 1;

    while curr > 0 {
        let parent: Int = (curr - 1) / 2;
        let c_val: Int = list_get(d, curr);
        let p_val: Int = list_get(d, parent);
        if c_val < p_val {
            d = min_heap_set_at(d, curr, p_val, total);
            d = min_heap_set_at(d, parent, c_val, total);
            curr = parent;
        } else {
            break;
        }
    }

    return MinHeap {
        data: d,
        size: total
    };
}

// Peek minimum element at root.
pub fn min_heap_peek(h: MinHeap) -> Result[Int, String] {
    if h.size == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(h.data, 0));
}

// Pop minimum root element with sift-down.
pub fn min_heap_pop(h: MinHeap) -> MinHeap {
    let n: Int = h.size;
    if n <= 1 {
        return min_heap_new();
    }

    let last_val: Int = list_get(h.data, n - 1);
    let mut d: List[Int] = list_new();
    let mut k: Int = 0;
    let new_len: Int = n - 1;
    while k < new_len {
        d = list_push(d, list_get(h.data, k));
        k = k + 1;
    }
    d = min_heap_set_at(d, 0, last_val, new_len);

    let mut curr: Int = 0;
    while curr < new_len {
        let left: Int = 2 * curr + 1;
        let right: Int = 2 * curr + 2;
        let mut smallest: Int = curr;

        if left < new_len {
            let l_val: Int = list_get(d, left);
            let s_val: Int = list_get(d, smallest);
            if l_val < s_val {
                smallest = left;
            }
        }
        if right < new_len {
            let r_val: Int = list_get(d, right);
            let s_val2: Int = list_get(d, smallest);
            if r_val < s_val2 {
                smallest = right;
            }
        }

        if smallest != curr {
            let cur_val: Int = list_get(d, curr);
            let top_val: Int = list_get(d, smallest);
            d = min_heap_set_at(d, curr, top_val, new_len);
            d = min_heap_set_at(d, smallest, cur_val, new_len);
            curr = smallest;
        } else {
            break;
        }
    }

    return MinHeap {
        data: d,
        size: new_len
    };
}

// Check if value is contained in the min-heap.
pub fn min_heap_contains(h: MinHeap, val: Int) -> Bool {
    let n: Int = h.size;
    let mut i: Int = 0;
    while i < n {
        if list_get(h.data, i) == val {
            return true;
        }
        i = i + 1;
    }
    return false;
}
