// # Ring Buffer Double-Ended Deque Module
//
// Logline: Fixed-capacity circular ring buffer double-ended queue supporting O(1) front and back push/pop.
//
// Setup: Pure collection module maintaining circular head and tail offsets over flat array.
//
// Beats:
//   1. Construct RingDeque with fixed capacity and zero elements.
//   2. Push elements to the front or back of the ring.
//   3. Pop elements from the front or back.
//   4. Peek front and back elements and query capacity.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";
import "std/result.oo";

type RingDeque = struct {
    elements: List[Int],
    head: Int,
    tail: Int,
    count: Int,
    capacity: Int
};

pub fn ring_deque_new(capacity: Int) -> RingDeque {
    let mut cap: Int = capacity;
    if cap < 1 { cap = 1; }
    let mut elems: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cap {
        elems = list_push(elems, 0);
        i = i + 1;
    }
    return RingDeque {
        elements: elems,
        head: 0,
        tail: 0,
        count: 0,
        capacity: cap
    };
}

pub fn ring_deque_push_back(deque: RingDeque, val: Int) -> RingDeque {
    let cnt: Int = deque.count;
    let cap: Int = deque.capacity;
    if cnt >= cap {
        return deque;
    }
    let t: Int = deque.tail;
    let mut new_elems: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cap {
        if i == t {
            new_elems = list_push(new_elems, val);
        } else {
            new_elems = list_push(new_elems, list_get(deque.elements, i));
        }
        i = i + 1;
    }
    let next_t: Int = (t + 1) % cap;
    return RingDeque {
        elements: new_elems,
        head: deque.head,
        tail: next_t,
        count: cnt + 1,
        capacity: cap
    };
}

pub fn ring_deque_len(deque: RingDeque) -> Int {
    return deque.count;
}

pub fn ring_deque_is_empty(deque: RingDeque) -> Bool {
    let c: Int = deque.count;
    return c == 0;
}
