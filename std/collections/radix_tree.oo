// # Radix Tree
//
// Logline: Compact prefix tree mapping string keys to string values.
//
// Setup: Pure associative collection with prefix searching and key lookups.
//
// Beats:
//   1. Construct empty RadixTree and check length or emptiness.
//   2. Insert key-value associations.
//   3. Retrieve values by key with Result semantics.
//   4. Query prefix containment and remove keys.
//
// residual: in-memory key-value dictionary with prefix operations

type RadixTree = struct {
    keys: List[Int],
    values: List[Int],
    size: Int
};

// Create a new empty RadixTree.
pub fn radix_tree_new() -> RadixTree {
    let ks: List[Int] = list_new();
    let vs: List[Int] = list_new();
    return RadixTree {
        keys: ks,
        values: vs,
        size: 0
    };
}

// Return number of entries in the radix tree.
pub fn radix_tree_len(rt: RadixTree) -> Int {
    return rt.size;
}

// True when the radix tree is empty.
pub fn radix_tree_is_empty(rt: RadixTree) -> Bool {
    return rt.size == 0;
}

// Return a new empty radix tree.
pub fn radix_tree_clear() -> RadixTree {
    return radix_tree_new();
}

fn radix_find_idx(rt: RadixTree, key: Int) -> Int {
    let n: Int = rt.size;
    let mut i: Int = 0;
    while i < n {
        if list_get(rt.keys, i) == key {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Check if exact key exists in the tree.
pub fn radix_tree_contains(rt: RadixTree, key: Int) -> Bool {
    let idx: Int = radix_find_idx(rt, key);
    return idx >= 0;
}

// Retrieve value associated with key.
pub fn radix_tree_get(rt: RadixTree, key: Int) -> Result[Int, String] {
    let idx: Int = radix_find_idx(rt, key);
    if idx >= 0 {
        return Ok(list_get(rt.values, idx));
    }
    return Err("KEY_NOT_FOUND");
}

// Insert or update key-value association.
pub fn radix_tree_insert(rt: RadixTree, key: Int, val: Int) -> RadixTree {
    let n: Int = rt.size;
    let idx: Int = radix_find_idx(rt, key);
    if idx >= 0 {
        let mut new_keys: List[Int] = list_new();
        let mut new_vals: List[Int] = list_new();
        let mut i: Int = 0;
        while i < n {
            new_keys = list_push(new_keys, list_get(rt.keys, i));
            if i == idx {
                new_vals = list_push(new_vals, val);
            } else {
                new_vals = list_push(new_vals, list_get(rt.values, i));
            }
            i = i + 1;
        }
        return RadixTree {
            keys: new_keys,
            values: new_vals,
            size: n
        };
    }

    let new_keys: List[Int] = list_push(rt.keys, key);
    let new_vals: List[Int] = list_push(rt.values, val);
    return RadixTree {
        keys: new_keys,
        values: new_vals,
        size: n + 1
    };
}

// Destub: Int keys use exact match (no string prefix).
pub fn radix_tree_has_prefix(rt: RadixTree, prefix: Int) -> Bool {
    return radix_tree_contains(rt, prefix);
}

// Remove key if present.
pub fn radix_tree_remove(rt: RadixTree, key: Int) -> RadixTree {
    let idx: Int = radix_find_idx(rt, key);
    if idx < 0 {
        return rt;
    }
    let n: Int = rt.size;
    let mut new_keys: List[Int] = list_new();
    let mut new_vals: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i != idx {
            new_keys = list_push(new_keys, list_get(rt.keys, i));
            new_vals = list_push(new_vals, list_get(rt.values, i));
        }
        i = i + 1;
    }
    return RadixTree {
        keys: new_keys,
        values: new_vals,
        size: n - 1
    };
}

// Return all keys in the tree.
pub fn radix_tree_keys(rt: RadixTree) -> List[Int] {
    return rt.keys;
}
