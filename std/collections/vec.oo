// # Dynamic Vector
//
// Logline: Resizable array supporting push, pop, indexed access, and arbitrary insertion.
//
// Setup: Pure sequence for dynamic string array operations.
//
// Beats:
//   1. Construct empty Vec and query length or emptiness.
//   2. Push and pop elements at the end.
//   3. Get and set elements by 0-based index.
//   4. Insert and remove elements at arbitrary index positions.
//
// residual: in-memory list wrapping index-based array operations

type Vec = struct {
    data: List[Int],
    size: Int
};

// Create a new empty Vec.
pub fn vec_new() -> Vec {
    let d: List[Int] = list_new();
    return Vec {
        data: d,
        size: 0
    };
}

// Return number of elements in the vector.
pub fn vec_len(v: Vec) -> Int {
    return v.size;
}

// True when vector contains no elements.
pub fn vec_is_empty(v: Vec) -> Bool {
    return v.size == 0;
}

// Clear all elements.
pub fn vec_clear() -> Vec {
    return vec_new();
}

// Push element to the end of the vector.
pub fn vec_push(v: Vec, val: Int) -> Vec {
    let new_data: List[Int] = list_push(v.data, val);
    let n: Int = v.size;
    return Vec {
        data: new_data,
        size: n + 1
    };
}

// Pop element from the end of the vector.
pub fn vec_pop(v: Vec) -> Vec {
    let n: Int = v.size;
    if n <= 1 {
        return vec_new();
    }
    let mut new_data: List[Int] = list_new();
    let mut i: Int = 0;
    let new_len: Int = n - 1;
    while i < new_len {
        new_data = list_push(new_data, list_get(v.data, i));
        i = i + 1;
    }
    return Vec {
        data: new_data,
        size: new_len
    };
}

// Get element at index.
pub fn vec_get(v: Vec, idx: Int) -> Result[Int, String] {
    let n: Int = v.size;
    if idx < 0 || idx >= n {
        return Err("INDEX_OUT_OF_BOUNDS");
    }
    return Ok(list_get(v.data, idx));
}

// Set element at index.
pub fn vec_set(v: Vec, idx: Int, val: Int) -> Vec {
    let n: Int = v.size;
    if idx < 0 || idx >= n {
        return v;
    }
    let mut new_data: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            new_data = list_push(new_data, val);
        } else {
            new_data = list_push(new_data, list_get(v.data, i));
        }
        i = i + 1;
    }
    return Vec {
        data: new_data,
        size: n
    };
}

// Insert element at arbitrary index (0..size).
pub fn vec_insert(v: Vec, idx: Int, val: Int) -> Vec {
    let n: Int = v.size;
    let mut target: Int = idx;
    if target < 0 {
        target = 0;
    }
    if target > n {
        target = n;
    }

    let mut new_data: List[Int] = list_new();
    let mut i: Int = 0;
    while i < target {
        new_data = list_push(new_data, list_get(v.data, i));
        i = i + 1;
    }
    new_data = list_push(new_data, val);
    while i < n {
        new_data = list_push(new_data, list_get(v.data, i));
        i = i + 1;
    }

    return Vec {
        data: new_data,
        size: n + 1
    };
}

// Remove element at index.
pub fn vec_remove(v: Vec, idx: Int) -> Vec {
    let n: Int = v.size;
    if idx < 0 || idx >= n {
        return v;
    }
    let mut new_data: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i != idx {
            new_data = list_push(new_data, list_get(v.data, i));
        }
        i = i + 1;
    }
    return Vec {
        data: new_data,
        size: n - 1
    };
}

// Check if vector contains value.
pub fn vec_contains(v: Vec, val: Int) -> Bool {
    let n: Int = v.size;
    let mut i: Int = 0;
    while i < n {
        if list_get(v.data, i) == val {
            return true;
        }
        i = i + 1;
    }
    return false;
}
