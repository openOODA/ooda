// # Dense 2D Numerical Matrix Module
//
// Logline: Dense 2D numerical matrix structure supporting 2D indexing, row/column slices, and transpose.
//
// Setup: Pure matrix data container backed by flat List[Int] memory.
//
// Beats:
//   1. Construct DenseMatrix with rows and columns dimensions.
//   2. Get and set matrix elements by (row, col) coordinates.
//   3. Compute matrix transpose.
//   4. Perform scalar scaling.
// RULES.oot 1.4: Pure mathematical data format structure, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type DenseMatrix = struct {
    rows: Int,
    cols: Int,
    data: List[Int]
};

pub fn dense_matrix_new(rows: Int, cols: Int) -> DenseMatrix {
    let total: Int = rows * cols;
    let mut d: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total {
        d = list_push(d, 0);
        i = i + 1;
    }
    return DenseMatrix {
        rows: rows,
        cols: cols,
        data: d
    };
}

pub fn dense_matrix_get(m: DenseMatrix, r: Int, c: Int) -> Int {
    let cols: Int = m.cols;
    let idx: Int = r * cols + c;
    return list_get(m.data, idx);
}

pub fn dense_matrix_set(m: DenseMatrix, r: Int, c: Int, val: Int) -> DenseMatrix {
    let cols: Int = m.cols;
    let rows: Int = m.rows;
    let target_idx: Int = r * cols + c;
    let total: Int = rows * cols;
    let mut new_d: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total {
        if i == target_idx {
            new_d = list_push(new_d, val);
        } else {
            new_d = list_push(new_d, list_get(m.data, i));
        }
        i = i + 1;
    }
    return DenseMatrix {
        rows: rows,
        cols: cols,
        data: new_d
    };
}
