// # Priority Queue
//
// Logline: Max-priority queue returning highest integer priority items first.
//
// Setup: Pure ordered collection maintaining items in descending priority order.
//
// Beats:
//   1. Construct empty PriorityQueue and query length or emptiness.
//   2. Push items with integer priority into ordered position.
//   3. Peek highest priority item and its priority score.
//   4. Pop highest priority item and clear queue.
//
// residual: linear insertion into descending priority list

type PriorityQueue = struct {
    items: List[Int],
    priorities: List[Int],
    size: Int
};

// Create a new empty PriorityQueue.
pub fn pq_new() -> PriorityQueue {
    let its: List[Int] = list_new();
    let prs: List[Int] = list_new();
    return PriorityQueue {
        items: its,
        priorities: prs,
        size: 0
    };
}

// Return number of elements in the priority queue.
pub fn pq_len(pq: PriorityQueue) -> Int {
    return pq.size;
}

// True when the priority queue is empty.
pub fn pq_is_empty(pq: PriorityQueue) -> Bool {
    return pq.size == 0;
}

// Return a new empty priority queue.
pub fn pq_clear() -> PriorityQueue {
    return pq_new();
}

// Push item with priority maintaining descending priority order.
pub fn pq_push(pq: PriorityQueue, item: Int, priority: Int) -> PriorityQueue {
    let n: Int = pq.size;
    let mut insert_idx: Int = n;
    let mut i: Int = 0;
    while i < n {
        let p: Int = list_get(pq.priorities, i);
        if priority > p {
            insert_idx = i;
            break;
        }
        i = i + 1;
    }

    let mut new_items: List[Int] = list_new();
    let mut new_prios: List[Int] = list_new();
    let mut j: Int = 0;
    while j < insert_idx {
        new_items = list_push(new_items, list_get(pq.items, j));
        new_prios = list_push(new_prios, list_get(pq.priorities, j));
        j = j + 1;
    }
    new_items = list_push(new_items, item);
    new_prios = list_push(new_prios, priority);
    while j < n {
        new_items = list_push(new_items, list_get(pq.items, j));
        new_prios = list_push(new_prios, list_get(pq.priorities, j));
        j = j + 1;
    }

    return PriorityQueue {
        items: new_items,
        priorities: new_prios,
        size: n + 1
    };
}

// Peek highest priority item without removing it.
pub fn pq_peek(pq: PriorityQueue) -> Result[Int, String] {
    if pq.size == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(pq.items, 0));
}

// Peek highest priority value without removing it.
pub fn pq_peek_priority(pq: PriorityQueue) -> Result[Int, String] {
    if pq.size == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(pq.priorities, 0));
}

// Pop highest priority item, returning updated queue.
pub fn pq_pop(pq: PriorityQueue) -> PriorityQueue {
    let n: Int = pq.size;
    if n == 0 {
        return pq;
    }
    let mut new_items: List[Int] = list_new();
    let mut new_prios: List[Int] = list_new();
    let mut i: Int = 1;
    while i < n {
        new_items = list_push(new_items, list_get(pq.items, i));
        new_prios = list_push(new_prios, list_get(pq.priorities, i));
        i = i + 1;
    }
    return PriorityQueue {
        items: new_items,
        priorities: new_prios,
        size: n - 1
    };
}

// Enumerate items in descending priority order.
pub fn pq_items(pq: PriorityQueue) -> List[Int] {
    return pq.items;
}
