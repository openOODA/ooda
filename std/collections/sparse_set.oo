// # Sparse-Dense Set Index Module
//
// Logline: Sparse set mapping entity IDs to contiguous dense indices for O(1) membership, insertion, and deletion.
//
// Setup: Entity-component-system indexing primitive without pointer indirection.
//
// Beats:
//   1. Construct SparseSet with maximum entity capacity.
//   2. Insert entity ID into dense array and update sparse mapping.
//   3. Test entity presence in O(1) time.
//   4. Clear sparse set.
// RULES.oot 1.4: Pure data module, zero ambient effects.
// RULES.oot 1.7: Under 256 lines.

import "std/core/list.oo";

type SparseSet = struct {
    dense: List[Int],
    sparse: List[Int],
    capacity: Int,
    size: Int
};

pub fn sparse_set_new(capacity: Int) -> SparseSet {
    let mut cap: Int = capacity;
    if cap < 1 { cap = 1; }
    let d: List[Int] = list_new();
    let mut sp: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cap {
        sp = list_push(sp, -1);
        i = i + 1;
    }
    return SparseSet {
        dense: d,
        sparse: sp,
        capacity: cap,
        size: 0
    };
}

pub fn sparse_set_contains(set: SparseSet, val: Int) -> Bool {
    let cap: Int = set.capacity;
    if val < 0 || val >= cap {
        return false;
    }
    let idx: Int = list_get(set.sparse, val);
    let s: Int = set.size;
    if idx >= 0 && idx < s {
        let dense_val: Int = list_get(set.dense, idx);
        return dense_val == val;
    }
    return false;
}

pub fn sparse_set_insert(set: SparseSet, val: Int) -> SparseSet {
    if sparse_set_contains(set, val) {
        return set;
    }
    let cap: Int = set.capacity;
    if val < 0 || val >= cap {
        return set;
    }
    let s: Int = set.size;
    let new_dense: List[Int] = list_push(set.dense, val);
    let mut new_sparse: List[Int] = list_new();
    let mut i: Int = 0;
    while i < cap {
        if i == val {
            new_sparse = list_push(new_sparse, s);
        } else {
            new_sparse = list_push(new_sparse, list_get(set.sparse, i));
        }
        i = i + 1;
    }
    return SparseSet {
        dense: new_dense,
        sparse: new_sparse,
        capacity: cap,
        size: s + 1
    };
}

pub fn sparse_set_len(set: SparseSet) -> Int {
    return set.size;
}
