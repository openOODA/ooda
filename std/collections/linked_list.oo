// # Singly Linked List
//
// Logline: Node-indexed sequential linked list for string elements.
//
// Setup: Pure sequential list structure with head/tail access and traversal.
//
// Beats:
//   1. Construct empty LinkedList and check length or emptiness.
//   2. Prepend (push front) and append (push back) values.
//   3. Peek head and tail elements.
//   4. Pop front, query containment, and clear linked list.
//
// residual: in-memory sequential node chain representation

type LinkedList = struct {
    data: List[Int],
    size: Int
};

// Create a new empty LinkedList.
pub fn linked_list_new() -> LinkedList {
    let d: List[Int] = list_new();
    return LinkedList {
        data: d,
        size: 0
    };
}

// Return number of nodes in the linked list.
pub fn linked_list_len(ll: LinkedList) -> Int {
    return ll.size;
}

// True when linked list contains no nodes.
pub fn linked_list_is_empty(ll: LinkedList) -> Bool {
    return ll.size == 0;
}

// Return a new empty linked list.
pub fn linked_list_clear() -> LinkedList {
    return linked_list_new();
}

// Prepend value to the head of the linked list.
pub fn linked_list_push_front(ll: LinkedList, val: Int) -> LinkedList {
    let n: Int = ll.size;
    let mut new_data: List[Int] = list_new();
    new_data = list_push(new_data, val);
    let mut i: Int = 0;
    while i < n {
        new_data = list_push(new_data, list_get(ll.data, i));
        i = i + 1;
    }
    return LinkedList {
        data: new_data,
        size: n + 1
    };
}

// Append value to the tail of the linked list.
pub fn linked_list_push_back(ll: LinkedList, val: Int) -> LinkedList {
    let new_data: List[Int] = list_push(ll.data, val);
    let n: Int = ll.size;
    return LinkedList {
        data: new_data,
        size: n + 1
    };
}

// Pop node from head of the linked list.
pub fn linked_list_pop_front(ll: LinkedList) -> LinkedList {
    let n: Int = ll.size;
    if n <= 1 {
        return linked_list_new();
    }
    let mut new_data: List[Int] = list_new();
    let mut i: Int = 1;
    while i < n {
        new_data = list_push(new_data, list_get(ll.data, i));
        i = i + 1;
    }
    return LinkedList {
        data: new_data,
        size: n - 1
    };
}

// Peek head element.
pub fn linked_list_peek_front(ll: LinkedList) -> Result[Int, String] {
    if ll.size == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(ll.data, 0));
}

// Peek tail element.
pub fn linked_list_peek_back(ll: LinkedList) -> Result[Int, String] {
    let n: Int = ll.size;
    if n == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(ll.data, n - 1));
}

// Check if value is contained in the linked list.
pub fn linked_list_contains(ll: LinkedList, val: Int) -> Bool {
    let n: Int = ll.size;
    let mut i: Int = 0;
    while i < n {
        if list_get(ll.data, i) == val {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Return all elements as a list.
pub fn linked_list_to_list(ll: LinkedList) -> List[Int] {
    return ll.data;
}
