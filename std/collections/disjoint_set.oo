// # Disjoint Set (Union-Find)
//
// Logline: Disjoint-set data structure with union by rank and connectivity queries.
//
// Setup: Pure partition forest tracking disjoint sets over 0..N-1.
//
// Beats:
//   1. Initialize DisjointSet of N elements.
//   2. Find canonical root representative of an element.
//   3. Union two subsets by rank.
//   4. Test connectivity and count disjoint components.
//
// residual: in-memory parent and rank lists over N integer elements

type DisjointSet = struct {
    parent: List[Int],
    rank: List[Int],
    num_sets: Int,
    size: Int
};

// Create a new DisjointSet with n elements (0..n-1).
pub fn dsu_new(n: Int) -> DisjointSet {
    let mut total: Int = n;
    if total < 0 {
        total = 0;
    }
    let mut p: List[Int] = list_new();
    let mut r: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total {
        p = list_push(p, i);
        r = list_push(r, 0);
        i = i + 1;
    }
    return DisjointSet {
        parent: p,
        rank: r,
        num_sets: total,
        size: total
    };
}

// Return total number of elements.
pub fn dsu_len(d: DisjointSet) -> Int {
    return d.size;
}

// Return number of disjoint components.
pub fn dsu_num_sets(d: DisjointSet) -> Int {
    return d.num_sets;
}

// Find canonical representative of element x.
pub fn dsu_find(d: DisjointSet, x: Int) -> Int {
    let n: Int = d.size;
    if x < 0 || x >= n {
        return -1;
    }
    let mut root: Int = x;
    while list_get(d.parent, root) != root {
        root = list_get(d.parent, root);
    }
    return root;
}

// True if x and y belong to the same subset.
pub fn dsu_connected(d: DisjointSet, x: Int, y: Int) -> Bool {
    let rx: Int = dsu_find(d, x);
    let ry: Int = dsu_find(d, y);
    if rx < 0 || ry < 0 {
        return false;
    }
    return rx == ry;
}

fn dsu_set_int(xs: List[Int], idx: Int, val: Int, n: Int) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == idx {
            out = list_push(out, val);
        } else {
            out = list_push(out, list_get(xs, i));
        }
        i = i + 1;
    }
    return out;
}

// Union the sets containing x and y by rank.
pub fn dsu_union(d: DisjointSet, x: Int, y: Int) -> DisjointSet {
    let n: Int = d.size;
    let root_x: Int = dsu_find(d, x);
    let root_y: Int = dsu_find(d, y);
    if root_x < 0 || root_y < 0 || root_x == root_y {
        return d;
    }

    let rank_x: Int = list_get(d.rank, root_x);
    let rank_y: Int = list_get(d.rank, root_y);
    let mut new_parents: List[Int] = d.parent;
    let mut new_ranks: List[Int] = d.rank;

    if rank_x < rank_y {
        new_parents = dsu_set_int(new_parents, root_x, root_y, n);
    } else if rank_x > rank_y {
        new_parents = dsu_set_int(new_parents, root_y, root_x, n);
    } else {
        new_parents = dsu_set_int(new_parents, root_y, root_x, n);
        new_ranks = dsu_set_int(new_ranks, root_x, rank_x + 1, n);
    }

    return DisjointSet {
        parent: new_parents,
        rank: new_ranks,
        num_sets: d.num_sets - 1,
        size: n
    };
}
