// # B-Tree Set
//
// Logline: Ordered set maintaining distinct sorted elements.
//
// Setup: Pure sorted unique sequence with string elements.
//
// Beats:
//   1. Construct empty BTreeSet and check length or emptiness.
//   2. Insert unique elements in sorted order.
//   3. Query element containment with ordered search.
//   4. Remove elements and enumerate elements in sorted order.
//
// residual: fixed in-memory sorted array backing; no node splitting overhead

type BTreeSet = struct {
    elements: List[Int],
    size: Int
};

fn int_compare(a: Int, b: Int) -> Int {
    if a == b {
        return 0;
    }
    if a < b {
        return -1;
    }
    return 1;
}

// Create a new empty BTreeSet.
pub fn btree_set_new() -> BTreeSet {
    let elems: List[Int] = list_new();
    return BTreeSet {
        elements: elems,
        size: 0
    };
}

// Return the number of unique elements in the set.
pub fn btree_set_len(s: BTreeSet) -> Int {
    return s.size;
}

// True when the set is empty.
pub fn btree_set_is_empty(s: BTreeSet) -> Bool {
    return s.size == 0;
}

// Return a new empty set.
pub fn btree_set_clear() -> BTreeSet {
    return btree_set_new();
}

fn btree_set_find_idx(s: BTreeSet, val: Int) -> Int {
    let mut i: Int = 0;
    let n: Int = s.size;
    while i < n {
        let el: Int = list_get(s.elements, i);
        let cmp: Int = int_compare(el, val);
        if cmp >= 0 {
            return i;
        }
        i = i + 1;
    }
    return n;
}

// Check if an element is in the set.
pub fn btree_set_contains(s: BTreeSet, val: Int) -> Bool {
    let n: Int = s.size;
    let idx: Int = btree_set_find_idx(s, val);
    if idx < n {
        if list_get(s.elements, idx) == val {
            return true;
        }
    }
    return false;
}

// Insert element into set maintaining sorted uniqueness.
pub fn btree_set_insert(s: BTreeSet, val: Int) -> BTreeSet {
    let n: Int = s.size;
    let idx: Int = btree_set_find_idx(s, val);
    if idx < n && list_get(s.elements, idx) == val {
        return s;
    }
    let mut new_elems: List[Int] = list_new();
    let mut i: Int = 0;
    while i < idx {
        new_elems = list_push(new_elems, list_get(s.elements, i));
        i = i + 1;
    }
    new_elems = list_push(new_elems, val);
    while i < n {
        new_elems = list_push(new_elems, list_get(s.elements, i));
        i = i + 1;
    }
    return BTreeSet {
        elements: new_elems,
        size: n + 1
    };
}

// Remove element from set if present.
pub fn btree_set_remove(s: BTreeSet, val: Int) -> BTreeSet {
    let n: Int = s.size;
    let idx: Int = btree_set_find_idx(s, val);
    if idx >= n || list_get(s.elements, idx) != val {
        return s;
    }
    let mut new_elems: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i != idx {
            new_elems = list_push(new_elems, list_get(s.elements, i));
        }
        i = i + 1;
    }
    return BTreeSet {
        elements: new_elems,
        size: n - 1
    };
}

// Minimum element in the set.
pub fn btree_set_min(s: BTreeSet) -> Result[Int, String] {
    if s.size == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(s.elements, 0));
}

// Maximum element in the set.
pub fn btree_set_max(s: BTreeSet) -> Result[Int, String] {
    let n: Int = s.size;
    if n == 0 {
        return Err("EMPTY");
    }
    return Ok(list_get(s.elements, n - 1));
}

// Return sorted list of elements.
pub fn btree_set_to_list(s: BTreeSet) -> List[Int] {
    return s.elements;
}
