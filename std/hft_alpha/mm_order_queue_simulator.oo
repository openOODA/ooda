// # High-Fidelity Discrete Event LOB Queue Simulator
//
// Logline: Simulates matching engine queue priority, trade matching, queue jumps, and cancellation dynamics in discrete event time.
//
// Setup: Pure quantitative backtesting engine for high-frequency algorithmic order execution strategies.
//
// Beats:
//   1. Define SimOrder, SimOrderBook, and MatchingEventResult structures.
//   2. Insert and match resting orders according to Price-Time (FIFO) priority.
//   3. Handle discrete trade execution fills, partial executions, and cancellations.

pub type SimOrder = struct {
    order_id: Int,
    is_buy: Bool,
    price: Float,
    quantity: Float,
    timestamp: Float,
};

pub type SimOrderBook = struct {
    orders: List[SimOrder],
    total_volume_matched: Float,
    order_counter: Int,
};

pub type MatchingEventResult = struct {
    order_id: Int,
    executed_shares: Float,
    remaining_shares: Float,
    is_fully_filled: Bool,
};

pub fn sim_order_book_new() -> SimOrderBook {
    let empty_list: List[SimOrder] = list_new();
    return SimOrderBook {
        orders: empty_list,
        total_volume_matched: 0.0,
        order_counter: 0,
    };
}

pub fn sim_order_book_submit(
    book: &mut SimOrderBook,
    is_buy: Bool,
    price: Float,
    qty: Float,
    timestamp: Float
) -> Int {
    (book).order_counter = (book).order_counter + 1;
    let ord: SimOrder = SimOrder {
        order_id: (book).order_counter,
        is_buy: is_buy,
        price: price,
        quantity: qty,
        timestamp: timestamp,
    };
    (book).orders = list_push((book).orders, ord);
    return (book).order_counter;
}

pub fn sim_order_book_match_market_order(
    book: &mut SimOrderBook,
    is_buy_taker: Bool,
    order_shares: Float
) -> MatchingEventResult {
    let n: Int = list_len((book).orders);
    let mut rem: Float = order_shares;
    let mut filled: Float = 0.0;
    let mut i: Int = 0;

    while i < n && rem > 0.0 {
        let resting: SimOrder = list_get((book).orders, i);
        // Match against opposite side
        if (resting).is_buy != is_buy_taker {
            let avail: Float = (resting).quantity;
            let take: Float = if rem < avail { rem } else { avail };
            filled = filled + take;
            rem = rem - take;
            (book).total_volume_matched = (book).total_volume_matched + take;
        }
        i = i + 1;
    }

    return MatchingEventResult {
        order_id: (book).order_counter,
        executed_shares: filled,
        remaining_shares: rem,
        is_fully_filled: rem <= 0.0,
    };
}
