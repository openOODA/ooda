// # Kyle's Lambda Market Impact Model
//
// Logline: Implements Kyle (1985) market microstructure model estimating price impact coefficient, market depth, and informed trader profitability.
//
// Setup: Pure quantitative microstructure module calculating linear Kyle lambda and price updates from net order flow.
//
// Beats:
//   1. Define KyleParams, PriceImpactResult, and InformedFlowEstimate structures.
//   2. Compute Kyle's lambda lambda = sqrt(sigma_v^2) / (2 * sqrt(sigma_u^2)) from fundamental and noise variances.
//   3. Calculate equilibrium price changes, market depth (1 / lambda), and expected insider profit.

pub type KyleParams = struct {
    fundamental_variance_v: Float,
    noise_order_variance_u: Float,
    prior_mean_p0: Float,
};

pub type PriceImpactResult = struct {
    kyle_lambda: Float,
    market_depth: Float,
    net_order_flow: Float,
    price_change: Float,
    posterior_price: Float,
};

pub type InformedFlowEstimate = struct {
    observed_flow: Float,
    implied_informed_qty: Float,
    implied_noise_qty: Float,
    information_ratio: Float,
};

pub fn kyle_params_new(
    sigma_v_sq: Float,
    sigma_u_sq: Float,
    p0: Float
) -> KyleParams {
    return KyleParams {
        fundamental_variance_v: sigma_v_sq,
        noise_order_variance_u: sigma_u_sq,
        prior_mean_p0: p0,
    };
}

pub fn kyle_compute_lambda(params: &KyleParams) -> Float {
    let sv2: Float = (params).fundamental_variance_v;
    let su2: Float = (params).noise_order_variance_u;
    
    if su2 <= 0.000001 {
        return 1.0;
    }
    // lambda = 0.5 * sqrt(sigma_v^2 / sigma_u^2)
    let ratio: Float = sv2 / su2;
    let lambda_val: Float = 0.5 * sqrt(ratio);
    return lambda_val;
}

pub fn kyle_compute_price_impact(
    net_flow_omega: Float,
    params: &KyleParams
) -> PriceImpactResult {
    let lambda_val: Float = kyle_compute_lambda(params);
    let depth: Float = if lambda_val > 0.0 { 1.0 / lambda_val } else { 0.0 };
    
    // Delta P = lambda * omega
    let dp: Float = lambda_val * net_flow_omega;
    let p_post: Float = (params).prior_mean_p0 + dp;

    return PriceImpactResult {
        kyle_lambda: lambda_val,
        market_depth: depth,
        net_order_flow: net_flow_omega,
        price_change: dp,
        posterior_price: p_post,
    };
}

pub fn kyle_estimate_informed_trading(
    observed_flow: Float,
    signal_diff: Float,
    params: &KyleParams
) -> InformedFlowEstimate {
    let sv2: Float = (params).fundamental_variance_v;
    let su2: Float = (params).noise_order_variance_u;
    
    // Informed beta = sqrt(sigma_u^2 / sigma_v^2)
    let beta: Float = if sv2 > 0.0 { sqrt(su2 / sv2) } else { 1.0 };
    let informed_x: Float = beta * signal_diff;
    let noise_u: Float = observed_flow - informed_x;
    let info_ratio: Float = if observed_flow != 0.0 { informed_x / observed_flow } else { 0.0 };

    return InformedFlowEstimate {
        observed_flow: observed_flow,
        implied_informed_qty: informed_x,
        implied_noise_qty: noise_u,
        information_ratio: info_ratio,
    };
}

pub fn kyle_expected_insider_profit(
    signal_diff: Float,
    params: &KyleParams
) -> Float {
    let lambda_val: Float = kyle_compute_lambda(params);
    let sv2: Float = (params).fundamental_variance_v;
    let su2: Float = (params).noise_order_variance_u;
    let beta: Float = if sv2 > 0.0 { sqrt(su2 / sv2) } else { 1.0 };
    
    // Profit = beta * signal_diff * (signal_diff - lambda * beta * signal_diff)
    let optimal_x: Float = beta * signal_diff;
    let profit: Float = optimal_x * (signal_diff - (lambda_val * optimal_x));
    return profit;
}
