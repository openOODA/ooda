// # Roll Effective Bid-Ask Spread Estimator
//
// Logline: Estimates the effective bid-ask spread and bid-ask bounce from the serial autocovariance of high-frequency price changes using Roll (1984).
//
// Setup: Pure quantitative microstructure module calculating serial price covariance and implied transaction costs.
//
// Beats:
//   1. Define RollPriceSeries and RollSpreadResult structures.
//   2. Compute lag-1 autocovariance of consecutive trade price differences Cov(Delta P_t, Delta P_{t-1}).
//   3. Compute Roll's effective spread S = 2 * sqrt(-Cov) if negative, or flag non-negative covariance.

pub type RollPriceSeries = struct {
    prices: List[Float],
    trade_count: Int
};

pub type RollSpreadResult = struct {
    autocovariance_lag1: Float,
    effective_spread_dollars: Float,
    effective_spread_bps: Float,
    is_valid_roll_bounce: Bool
};

pub fn roll_price_series_new() -> RollPriceSeries {
    let empty_list: List[Float] = list_new();
    return RollPriceSeries {
        prices: empty_list,
        trade_count: 0
    };
}

pub fn roll_price_series_push(series: &mut RollPriceSeries, price: Float) {
    (series).prices = list_push((series).prices, price);
    (series).trade_count = (series).trade_count + 1;
}

pub fn roll_estimate_spread(series: &RollPriceSeries) -> RollSpreadResult {
    let n: Int = (series).trade_count;
    if n < 3 {
        return RollSpreadResult {
            autocovariance_lag1: 0.0,
            effective_spread_dollars: 0.0,
            effective_spread_bps: 0.0,
            is_valid_roll_bounce: false
        };
    }

    let mut dp_list: List[Float] = list_new();
    let mut i: Int = 1;
    let mut sum_dp: Float = 0.0;

    while i < n {
        let p_curr: Float = list_get((series).prices, i);
        let p_prev: Float = list_get((series).prices, i - 1);
        let dp: Float = p_curr - p_prev;
        dp_list = list_push(dp_list, dp);
        sum_dp = sum_dp + dp;
        i = i + 1;
    }

    let n_dp: Int = list_len(dp_list);
    let mut n_dp_f: Float = 0.0;
    let mut cnt: Int = n_dp;
    while cnt >= 10 { n_dp_f = n_dp_f + 10.0; cnt = cnt - 10; }
    while cnt >= 1 { n_dp_f = n_dp_f + 1.0; cnt = cnt - 1; }
    if n_dp_f <= 0.0 { n_dp_f = 1.0; }

    let mean_dp: Float = sum_dp / n_dp_f;

    let mut sum_cov: Float = 0.0;
    let mut count_cov: Int = 0;
    let mut j: Int = 1;

    while j < n_dp {
        let dp_t: Float = list_get(dp_list, j);
        let dp_t_minus_1: Float = list_get(dp_list, j - 1);
        sum_cov = sum_cov + ((dp_t - mean_dp) * (dp_t_minus_1 - mean_dp));
        count_cov = count_cov + 1;
        j = j + 1;
    }

    let mut cov_cnt_f: Float = 0.0;
    let mut ccnt: Int = count_cov;
    while ccnt >= 10 { cov_cnt_f = cov_cnt_f + 10.0; ccnt = ccnt - 10; }
    while ccnt >= 1 { cov_cnt_f = cov_cnt_f + 1.0; ccnt = ccnt - 1; }
    if cov_cnt_f <= 0.0 { cov_cnt_f = 1.0; }

    let autocov: Float = sum_cov / cov_cnt_f;

    let mut eff_spread: Float = 0.0;
    let mut valid: Bool = false;

    if autocov < 0.0 {
        let neg_cov: Float = 0.0 - autocov;
        eff_spread = 2.0 * sqrt(neg_cov);
        valid = true;
    }

    let last_px: Float = list_get((series).prices, n - 1);
    let eff_bps: Float = if last_px > 0.0 { (eff_spread / last_px) * 10000.0 } else { 0.0 };

    return RollSpreadResult {
        autocovariance_lag1: autocov,
        effective_spread_dollars: eff_spread,
        effective_spread_bps: eff_bps,
        is_valid_roll_bounce: valid
    };
}
