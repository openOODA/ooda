// # Multi-Asset Cross-Asset Price Impact Propagator
//
// Logline: Models coupled order flow impact across correlated instruments using a multi-dimensional cross-impact matrix Delta P = Lambda * Omega.
//
// Setup: Pure quantitative portfolio execution module propagating order flow shocks across a basket of correlated securities.
//
// Beats:
//   1. Define CrossImpactMatrix2x2, FlowVector2D, and ImpactedPrices2D structures.
//   2. Compute direct and cross-asset price displacements from simultaneous order flow.
//   3. Calculate optimal cross-asset order offsetting to minimize portfolio-wide execution slippage.

pub type CrossImpactMatrix2x2 = struct {
    lambda_11_own: Float,
    lambda_12_cross: Float,
    lambda_21_cross: Float,
    lambda_22_own: Float,
};

pub type FlowVector2D = struct {
    order_flow_asset1: Float,
    order_flow_asset2: Float,
};

pub type ImpactedPrices2D = struct {
    price_change_asset1: Float,
    price_change_asset2: Float,
    total_market_impact_cost: Float,
};

pub fn cross_impact_matrix_new(
    l11: Float,
    l12: Float,
    l21: Float,
    l22: Float
) -> CrossImpactMatrix2x2 {
    return CrossImpactMatrix2x2 {
        lambda_11_own: l11,
        lambda_12_cross: l12,
        lambda_21_cross: l21,
        lambda_22_own: l22,
    };
}

pub fn cross_impact_propagate(
    flow: &FlowVector2D,
    matrix: &CrossImpactMatrix2x2
) -> ImpactedPrices2D {
    let q1: Float = (flow).order_flow_asset1;
    let q2: Float = (flow).order_flow_asset2;

    // Delta P1 = Lambda_11 * q1 + Lambda_12 * q2
    let dp1: Float = ((matrix).lambda_11_own * q1) + ((matrix).lambda_12_cross * q2);

    // Delta P2 = Lambda_21 * q1 + Lambda_22 * q2
    let dp2: Float = ((matrix).lambda_21_cross * q1) + ((matrix).lambda_22_own * q2);

    // Total execution impact cost = q1 * dp1 + q2 * dp2
    let total_cost: Float = (q1 * dp1) + (q2 * dp2);

    return ImpactedPrices2D {
        price_change_asset1: dp1,
        price_change_asset2: dp2,
        total_market_impact_cost: total_cost,
    };
}
