// # High-Frequency Cancel-to-Trade Ratio and Quote Stuffing Detector
//
// Logline: Monitors order lifecycle ratios, message velocity, and high-frequency quote stuffing bursts to detect predatory manipulation.
//
// Setup: Pure market surveillance and alpha risk module tracking high-frequency cancellation spikes.
//
// Beats:
//   1. Define MessageCounter, StuffingConfig, and MessageRatioMetrics structures.
//   2. Track new order placements, modifications, executions, and cancellations over rolling windows.
//   3. Compute cancel-to-fill and cancel-to-order ratios with regulatory and algorithmic alert thresholds.

pub type MessageCounter = struct {
    orders_placed: Int,
    orders_cancelled: Int,
    trades_executed: Int,
    time_window_ms: Float
};

pub type StuffingConfig = struct {
    max_cancel_to_trade_ratio: Float,
    max_messages_per_second: Float
};

pub type MessageRatioMetrics = struct {
    cancel_to_trade_ratio: Float,
    cancel_percentage: Float,
    is_quote_stuffing_detected: Bool,
    message_velocity_per_sec: Float
};

pub fn message_counter_new(window_ms: Float) -> MessageCounter {
    return MessageCounter {
        orders_placed: 0,
        orders_cancelled: 0,
        trades_executed: 0,
        time_window_ms: window_ms
    };
}

pub fn message_counter_record(
    counter: &mut MessageCounter,
    placed: Int,
    cancelled: Int,
    executed: Int
) {
    (counter).orders_placed = (counter).orders_placed + placed;
    (counter).orders_cancelled = (counter).orders_cancelled + cancelled;
    (counter).trades_executed = (counter).trades_executed + executed;
}

pub fn calculate_message_ratios(
    counter: &MessageCounter,
    config: &StuffingConfig
) -> MessageRatioMetrics {
    let p_cnt: Int = (counter).orders_placed;
    let c_cnt: Int = (counter).orders_cancelled;
    let t_cnt: Int = (counter).trades_executed;

    let mut p_f: Float = 0.0;
    let mut pc: Int = p_cnt;
    while pc >= 10 { p_f = p_f + 10.0; pc = pc - 10; }
    while pc >= 1 { p_f = p_f + 1.0; pc = pc - 1; }

    let mut c_f: Float = 0.0;
    let mut cc: Int = c_cnt;
    while cc >= 10 { c_f = c_f + 10.0; cc = cc - 10; }
    while cc >= 1 { c_f = c_f + 1.0; cc = cc - 1; }

    let mut t_f: Float = 0.0;
    let mut tc: Int = t_cnt;
    while tc >= 10 { t_f = t_f + 10.0; tc = tc - 10; }
    while tc >= 1 { t_f = t_f + 1.0; tc = tc - 1; }

    let c_to_t: Float = if t_f > 0.0 { c_f / t_f } else { c_f };
    let c_pct: Float = if p_f > 0.0 { c_f / p_f } else { 0.0 };

    let win_sec: Float = (counter).time_window_ms / 1000.0;
    let tot_msgs: Float = p_f + c_f + t_f;
    let vel: Float = if win_sec > 0.0 { tot_msgs / win_sec } else { 0.0 };

    let stuffing: Bool = (c_to_t >= (config).max_cancel_to_trade_ratio) || (vel >= (config).max_messages_per_second);

    return MessageRatioMetrics {
        cancel_to_trade_ratio: c_to_t,
        cancel_percentage: c_pct,
        is_quote_stuffing_detected: stuffing,
        message_velocity_per_sec: vel
    };
}
