pub fn hft_alpha_version() -> String {
    return "1.0.0";
}

pub fn hft_alpha_module_count() -> Int {
    return 50;
}

pub fn hft_alpha_default_as_params() -> AsParams {
    return as_params_new(0.1, 0.02, 1.0, 1.5);
}

pub fn hft_alpha_default_ac_params() -> AlmgrenChrissParams {
    return ac_params_new(10000.0, 60.0, 10, 0.02, 0.0001, 0.001, 0.0005);
}

pub fn hft_alpha_default_kyle_params() -> KyleParams {
    return kyle_params_new(0.04, 1000000.0, 100.0);
}

pub fn hft_alpha_default_vpin_config() -> VpinConfig {
    return vpin_config_new(10000.0, 50, 0.65);
}

pub fn hft_alpha_default_hawkes_params() -> Hawkes1DParams {
    return hawkes_1d_params_new(1.2, 0.8, 1.5);
}

pub fn hft_alpha_default_risk_config() -> HftRiskConfig {
    return hft_risk_config_default();
}

