// # Guilbaud-Pham Pro-Rata Limit Order Market Making
//
// Logline: Implements the Guilbaud-Pham (2013) stochastic control model for market making with limit and market orders in pro-rata order matching markets.
//
// Setup: Pure quantitative finance module analyzing pro-rata fill probability and optimal limit quote placement.
//
// Beats:
//   1. Define ProRataBookLevel, GuilbaudPhamParams, and ProRataAllocation structures.
//   2. Compute expected pro-rata allocation fraction based on quote size relative to total queue depth.
//   3. Determine optimal quoting depth and market order liquidation thresholds.

pub type ProRataBookLevel = struct {
    price_level: Float,
    total_queue_depth: Float,
    own_quote_size: Float
};

pub type GuilbaudPhamParams = struct {
    gamma_risk_aversion: Float,
    transaction_cost_c: Float,
    order_intensity_lambda0: Float,
    inventory_limit: Float
};

pub type ProRataAllocation = struct {
    incoming_market_order_size: Float,
    own_allocated_size: Float,
    pro_rata_fraction: Float,
    remaining_quote_size: Float
};

pub fn pro_rata_params_new(
    gamma: Float,
    cost: Float,
    lambda0: Float,
    limit: Float
) -> GuilbaudPhamParams {
    return GuilbaudPhamParams {
        gamma_risk_aversion: gamma,
        transaction_cost_c: cost,
        order_intensity_lambda0: lambda0,
        inventory_limit: limit
    };
}

pub fn pro_rata_compute_allocation(
    level: &ProRataBookLevel,
    market_order_size: Float
) -> ProRataAllocation {
    let tot: Float = (level).total_queue_depth;
    let own: Float = (level).own_quote_size;

    if tot <= 0.0 || own <= 0.0 || market_order_size <= 0.0 {
        return ProRataAllocation {
            incoming_market_order_size: market_order_size,
            own_allocated_size: 0.0,
            pro_rata_fraction: 0.0,
            remaining_quote_size: own
        };
    }

    // In pro-rata: fill_i = min(own, market_order * (own / tot))
    let fraction: Float = own / tot;
    let mut allocated: Float = market_order_size * fraction;
    if allocated > own {
        allocated = own;
    }

    return ProRataAllocation {
        incoming_market_order_size: market_order_size,
        own_allocated_size: allocated,
        pro_rata_fraction: fraction,
        remaining_quote_size: own - allocated
    };
}

pub fn pro_rata_optimal_quote_size(
    inventory_q: Float,
    target_inventory: Float,
    expected_flow: Float,
    params: &GuilbaudPhamParams
) -> Float {
    let inv_diff: Float = target_inventory - inventory_q;
    let gamma: Float = (params).gamma_risk_aversion;
    
    // Size increases when far from limit and seeking inventory rebalancing
    let base_size: Float = expected_flow * 0.2;
    let penalty: Float = gamma * (inventory_q * inventory_q) / ((params).inventory_limit + 1.0);
    
    let mut adjusted_sz: Float = base_size + (inv_diff * 0.1) - penalty;
    if adjusted_sz < 0.0 {
        adjusted_sz = 0.0;
    }
    return adjusted_sz;
}
