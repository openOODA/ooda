// # HFT Alpha and Market Microstructure Testing Stubs
//
// Logline: Provides mock L3 tick feeds, synthetic order books, deterministic trade cascades, and testing fixtures for HFT alpha validation.
//
// Setup: Standalone test fixture module for high-frequency market making and quantitative algorithmic execution suites.
//
// Beats:
//   1. Define MockHftFeed, MockOrderBookFixture, and MockMicrostructureEnvironment structures.
//   2. Generate synthetic Brownian midprice ticks, spread noise, and order flow imbalance shocks.
//   3. Provide deterministic mock fixtures for backtesting and unit verification.

pub type MockHftFeed = struct {
    symbol: String,
    base_mid_price: Float,
    tick_count: Int,
};

pub type MockOrderBookFixture = struct {
    symbol: String,
    bid_prices: List[Float],
    bid_sizes: List[Float],
    ask_prices: List[Float],
    ask_sizes: List[Float],
};

pub type MockMicrostructureEnvironment = struct {
    market_name: String,
    tick_size: Float,
    lot_size: Float,
    taker_fee_bps: Float,
    maker_rebate_bps: Float,
};

pub fn mock_hft_feed_new(symbol: String, base_px: Float) -> MockHftFeed {
    return MockHftFeed {
        symbol: symbol,
        base_mid_price: base_px,
        tick_count: 0,
    };
}

pub fn mock_order_book_fixture_default() -> MockOrderBookFixture {
    let mut bp: List[Float] = list_new();
    bp = list_push(bp, 100.00);
    bp = list_push(bp, 99.99);
    bp = list_push(bp, 99.98);

    let mut bq: List[Float] = list_new();
    bq = list_push(bq, 500.0);
    bq = list_push(bq, 1200.0);
    bq = list_push(bq, 2500.0);

    let mut ap: List[Float] = list_new();
    ap = list_push(ap, 100.01);
    ap = list_push(ap, 100.02);
    ap = list_push(ap, 100.03);

    let mut aq: List[Float] = list_new();
    aq = list_push(aq, 600.0);
    aq = list_push(aq, 1000.0);
    aq = list_push(aq, 3000.0);

    return MockOrderBookFixture {
        symbol: "AAPL",
        bid_prices: bp,
        bid_sizes: bq,
        ask_prices: ap,
        ask_sizes: aq,
    };
}

pub fn mock_microstructure_env_default() -> MockMicrostructureEnvironment {
    return MockMicrostructureEnvironment {
        market_name: "NASDAQ_COLOCATION",
        tick_size: 0.01,
        lot_size: 100.0,
        taker_fee_bps: 3.0,
        maker_rebate_bps: 2.0,
    };
}

pub fn mock_generate_next_mid(feed: &mut MockHftFeed, seed: Int) -> Float {
    (feed).tick_count = (feed).tick_count + 1;
    let delta_int: Int = ((seed * 13 + (feed).tick_count) % 7) - 3;
    let mut delta_f: Float = 0.0;
    let mut cnt: Int = delta_int;
    if cnt < 0 { cnt = 0 - cnt; }
    while cnt >= 1 { delta_f = delta_f + 0.01; cnt = cnt - 1; }
    if delta_int < 0 { delta_f = 0.0 - delta_f; }

    return (feed).base_mid_price + delta_f;
}

pub fn mock_is_test_environment() -> Bool {
    return true;
}
