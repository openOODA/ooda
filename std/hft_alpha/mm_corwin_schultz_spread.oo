// # Corwin-Schultz High-Low Bid-Ask Spread Estimator
//
// Logline: Estimates high-frequency bid-ask spreads using Corwin-Schultz (2012) high and low prices across single and 2-period intervals.
//
// Setup: Pure quantitative microstructure module calculating variance and spread fractions from intraday price extremes.
//
// Beats:
//   1. Define HighLowBar and CorwinSchultzResult structures.
//   2. Compute logarithmic high-to-low price ratios for consecutive single periods and combined two-day spans.
//   3. Solve for Corwin-Schultz alpha and estimate bid-ask spread fraction S.

pub type HighLowBar = struct {
    high_price: Float,
    low_price: Float
};

pub type CorwinSchultzResult = struct {
    alpha_estimator: Float,
    gamma_two_period: Float,
    beta_sum_single: Float,
    bid_ask_spread_pct: Float,
    bid_ask_spread_bps: Float,
    is_positive_spread: Bool
};

pub fn high_low_bar_new(high_px: Float, low_px: Float) -> HighLowBar {
    return HighLowBar {
        high_price: high_px,
        low_price: low_px
    };
}

pub fn corwin_schultz_estimate(
    bar1: &HighLowBar,
    bar2: &HighLowBar
) -> CorwinSchultzResult {
    let h1: Float = (bar1).high_price;
    let l1: Float = (bar1).low_price;
    let h2: Float = (bar2).high_price;
    let l2: Float = (bar2).low_price;

    if h1 <= 0.0 || l1 <= 0.0 || h2 <= 0.0 || l2 <= 0.0 {
        return CorwinSchultzResult {
            alpha_estimator: 0.0,
            gamma_two_period: 0.0,
            beta_sum_single: 0.0,
            bid_ask_spread_pct: 0.0,
            bid_ask_spread_bps: 0.0,
            is_positive_spread: false
        };
    }

    // ln(H / L)^2
    let log_hl1: Float = ln(h1 / l1);
    let log_hl2: Float = ln(h2 / l2);
    let beta_val: Float = (log_hl1 * log_hl1) + (log_hl2 * log_hl2);

    // 2-period combined high and low
    let h12: Float = if h1 > h2 { h1 } else { h2 };
    let l12: Float = if l1 < l2 { l1 } else { l2 };
    let log_hl12: Float = ln(h12 / l12);
    let gamma_val: Float = log_hl12 * log_hl12;

    // sqrt(2) approx 1.41421356
    // alpha = (sqrt(2*beta) - sqrt(beta)) / (3 - 2*sqrt(2)) - sqrt(gamma / (3 - 2*sqrt(2)))
    // (3 - 2*sqrt(2)) approx 0.171572875
    // denom_const = 3.0 - 2.0 * 1.41421356 = 0.17157288
    let sqrt_denom: Float = 0.41421356; // sqrt(0.17157288) = sqrt(2) - 1
    let term1: Float = (sqrt(2.0 * beta_val) - sqrt(beta_val)) / 0.17157288;
    let term2: Float = sqrt(gamma_val / 0.17157288);
    let alpha_val: Float = term1 - term2;

    let mut spread_pct: Float = 0.0;
    let mut valid: Bool = false;

    if alpha_val > 0.0 {
        // S = 2 * (exp(alpha) - 1) / (1 + exp(alpha))
        let exp_a: Float = exp(alpha_val);
        spread_pct = 2.0 * (exp_a - 1.0) / (1.0 + exp_a);
        valid = true;
    }

    let bps: Float = spread_pct * 10000.0;

    return CorwinSchultzResult {
        alpha_estimator: alpha_val,
        gamma_two_period: gamma_val,
        beta_sum_single: beta_val,
        bid_ask_spread_pct: spread_pct,
        bid_ask_spread_bps: bps,
        is_positive_spread: valid
    };
}
