// # Non-Homogeneous Poisson Trade Flow Intensity
//
// Logline: Estimates time-varying Poisson arrival rates for buyer-initiated and seller-initiated market orders across intraday time windows.
//
// Setup: Pure quantitative microstructure module calculating exponential arrival intensities and instantaneous order flow pressure.
//
// Beats:
//   1. Define FlowArrivalWindow, FlowIntensityEstimate, and FlowImbalancePressure structures.
//   2. Calculate maximum-likelihood Poisson arrival intensity lambda = N / Delta_t for buy and sell flow.
//   3. Compute normalized flow pressure and expected time to next aggressive order arrival.

pub type FlowArrivalWindow = struct {
    window_duration_seconds: Float,
    buy_order_count: Int,
    sell_order_count: Int,
    total_buy_shares: Float,
    total_sell_shares: Float
};

pub type FlowIntensityEstimate = struct {
    buy_arrival_rate_per_sec: Float,
    sell_arrival_rate_per_sec: Float,
    expected_next_buy_delay_sec: Float,
    expected_next_sell_delay_sec: Float,
    intensity_ratio_buy_sell: Float
};

pub fn flow_window_new(duration_sec: Float) -> FlowArrivalWindow {
    return FlowArrivalWindow {
        window_duration_seconds: duration_sec,
        buy_order_count: 0,
        sell_order_count: 0,
        total_buy_shares: 0.0,
        total_sell_shares: 0.0
    };
}

pub fn flow_window_add_trade(
    window: &mut FlowArrivalWindow,
    is_buy: Bool,
    shares: Float
) {
    if is_buy {
        (window).buy_order_count = (window).buy_order_count + 1;
        (window).total_buy_shares = (window).total_buy_shares + shares;
    } else {
        (window).sell_order_count = (window).sell_order_count + 1;
        (window).total_sell_shares = (window).total_sell_shares + shares;
    }
}

pub fn flow_estimate_intensity(window: &FlowArrivalWindow) -> FlowIntensityEstimate {
    let dt: Float = (window).window_duration_seconds;
    if dt <= 0.0 {
        return FlowIntensityEstimate {
            buy_arrival_rate_per_sec: 0.0,
            sell_arrival_rate_per_sec: 0.0,
            expected_next_buy_delay_sec: 999.0,
            expected_next_sell_delay_sec: 999.0,
            intensity_ratio_buy_sell: 1.0
        };
    }

    let b_cnt: Int = (window).buy_order_count;
    let s_cnt: Int = (window).sell_order_count;

    let mut b_f: Float = 0.0;
    let mut bc: Int = b_cnt;
    while bc >= 10 { b_f = b_f + 10.0; bc = bc - 10; }
    while bc >= 1 { b_f = b_f + 1.0; bc = bc - 1; }

    let mut s_f: Float = 0.0;
    let mut sc: Int = s_cnt;
    while sc >= 10 { s_f = s_f + 10.0; sc = sc - 10; }
    while sc >= 1 { s_f = s_f + 1.0; sc = sc - 1; }

    let lambda_b: Float = b_f / dt;
    let lambda_s: Float = s_f / dt;

    let delay_b: Float = if lambda_b > 0.0001 { 1.0 / lambda_b } else { 999.0 };
    let delay_s: Float = if lambda_s > 0.0001 { 1.0 / lambda_s } else { 999.0 };

    let ratio: Float = if lambda_s > 0.0001 { lambda_b / lambda_s } else { 1.0 };

    return FlowIntensityEstimate {
        buy_arrival_rate_per_sec: lambda_b,
        sell_arrival_rate_per_sec: lambda_s,
        expected_next_buy_delay_sec: delay_b,
        expected_next_sell_delay_sec: delay_s,
        intensity_ratio_buy_sell: ratio
    };
}
