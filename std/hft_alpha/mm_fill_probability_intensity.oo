// # Empirical Fill Probability and Intensity
//
// Logline: Models the exponential and power-law fill probability of limit orders as a function of distance to mid-price and queue depth.
//
// Setup: Pure quantitative microstructure module estimating execution intensities for passive order placement.
//
// Beats:
//   1. Define IntensityParams, DistanceToMid, and FillProbabilityResult structures.
//   2. Calculate Poisson arrival intensity lambda(delta) = A * exp(-k * delta).
//   3. Compute cumulative fill probability over execution time horizon T: P(Fill) = 1 - exp(-lambda * T).

pub type IntensityParams = struct {
    scale_a: Float,
    decay_k: Float,
    depth_penalty_beta: Float,
};

pub type DistanceToMid = struct {
    delta_ticks: Float,
    queue_depth_ahead: Float,
    horizon_seconds: Float,
};

pub type FillProbabilityResult = struct {
    instantaneous_intensity: Float,
    cumulative_fill_prob: Float,
    expected_time_to_fill_sec: Float,
    is_high_fill_probability: Bool,
};

pub fn intensity_params_new(
    scale_a: Float,
    decay_k: Float,
    beta: Float
) -> IntensityParams {
    return IntensityParams {
        scale_a: scale_a,
        decay_k: decay_k,
        depth_penalty_beta: beta,
    };
}

pub fn fill_prob_compute(
    placement: &DistanceToMid,
    params: &IntensityParams
) -> FillProbabilityResult {
    let delta: Float = (placement).delta_ticks;
    let ahead: Float = (placement).queue_depth_ahead;
    let horizon: Float = (placement).horizon_seconds;

    let a: Float = (params).scale_a;
    let k: Float = (params).decay_k;
    let beta: Float = (params).depth_penalty_beta;

    // lambda = A * exp(-k * delta) / (1 + beta * queue_ahead)
    let dist_decay: Float = exp((0.0 - k) * delta);
    let queue_factor: Float = 1.0 + (beta * ahead);
    let lambda_val: Float = if queue_factor > 0.0 { (a * dist_decay) / queue_factor } else { 0.0 };

    // Cumulative fill prob over horizon T: 1 - exp(-lambda * T)
    let p_fill: Float = 1.0 - exp((0.0 - lambda_val) * horizon);
    let exp_time: Float = if lambda_val > 0.0001 { 1.0 / lambda_val } else { 9999.0 };
    let high_p: Bool = p_fill >= 0.70;

    return FillProbabilityResult {
        instantaneous_intensity: lambda_val,
        cumulative_fill_prob: p_fill,
        expected_time_to_fill_sec: exp_time,
        is_high_fill_probability: high_p,
    };
}
