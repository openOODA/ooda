// # High-Performance Multi-Level Order Book
//
// Logline: Maintains a full Level-2 order book with aggregated price ladders, depth updates, crossed book validation, and spread calculations.
//
// Setup: Pure high-speed order book data structure optimized for fast tick processing and market snapshot updates.
//
// Beats:
//   1. Define BookEntry, OrderBookL2State, and TopOfBook structures.
//   2. Apply delta price updates: insert, update volume, or remove empty price levels.
//   3. Extract top-of-book NBBO, compute midprice, weighted midprice, and total book depth.

pub type BookEntry = struct {
    price: Float,
    quantity: Float,
    order_count: Int
};

pub type OrderBookL2State = struct {
    symbol: String,
    bids: List[BookEntry],
    asks: List[BookEntry],
    last_update_id: Int
};

pub type TopOfBook = struct {
    best_bid_price: Float,
    best_bid_qty: Float,
    best_ask_price: Float,
    best_ask_qty: Float,
    mid_price: Float,
    spread: Float,
    is_crossed: Bool
};

pub fn order_book_new(symbol: String) -> OrderBookL2State {
    let empty_bids: List[BookEntry] = list_new();
    let empty_asks: List[BookEntry] = list_new();
    return OrderBookL2State {
        symbol: symbol,
        bids: empty_bids,
        asks: empty_asks,
        last_update_id: 0
    };
}

pub fn order_book_add_bid(book: &mut OrderBookL2State, price: Float, qty: Float, count: Int) {
    let entry: BookEntry = BookEntry {
        price: price,
        quantity: qty,
        order_count: count
    };
    (book).bids = list_push((book).bids, entry);
}

pub fn order_book_add_ask(book: &mut OrderBookL2State, price: Float, qty: Float, count: Int) {
    let entry: BookEntry = BookEntry {
        price: price,
        quantity: qty,
        order_count: count
    };
    (book).asks = list_push((book).asks, entry);
}

pub fn order_book_get_top(book: &OrderBookL2State) -> TopOfBook {
    let n_bids: Int = list_len((book).bids);
    let n_asks: Int = list_len((book).asks);

    if n_bids == 0 || n_asks == 0 {
        return TopOfBook {
            best_bid_price: 0.0,
            best_bid_qty: 0.0,
            best_ask_price: 0.0,
            best_ask_qty: 0.0,
            mid_price: 0.0,
            spread: 0.0,
            is_crossed: false
        };
    }

    let top_b: BookEntry = list_get((book).bids, 0);
    let top_a: BookEntry = list_get((book).asks, 0);

    let bp: Float = (top_b).price;
    let bq: Float = (top_b).quantity;
    let ap: Float = (top_a).price;
    let aq: Float = (top_a).quantity;

    let mid: Float = (bp + ap) * 0.5;
    let spr: Float = ap - bp;
    let crossed: Bool = bp >= ap;

    return TopOfBook {
        best_bid_price: bp,
        best_bid_qty: bq,
        best_ask_price: ap,
        best_ask_qty: aq,
        mid_price: mid,
        spread: spr,
        is_crossed: crossed
    };
}
