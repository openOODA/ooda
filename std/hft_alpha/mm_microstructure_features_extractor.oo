// # High-Frequency Microstructure Feature Extractor
//
// Logline: Extracts quantitative feature vectors from order book state (depth slope, volume skewness, spread tightness, cancel velocity) for ML alpha models.
//
// Setup: Pure feature engineering module transforming raw Level-2 and Level-3 tick data into normalized feature vectors.
//
// Beats:
//   1. Define RawBookL2, MicrostructureFeatureVector, and NormalizationBounds structures.
//   2. Calculate depth ratios, book slope, queue skewness, and effective spread.
//   3. Normalize output feature vector into standard scale [-1.0, +1.0] for predictive ML models.

pub type RawBookL2 = struct {
    bid_p1: Float,
    bid_q1: Float,
    bid_p2: Float,
    bid_q2: Float,
    ask_p1: Float,
    ask_q1: Float,
    ask_p2: Float,
    ask_q2: Float,
    recent_cancel_count: Int,
    recent_trade_count: Int,
};

pub type MicrostructureFeatureVector = struct {
    imbalance_l1: Float,
    imbalance_l2: Float,
    spread_bps: Float,
    book_slope_bid: Float,
    book_slope_ask: Float,
    cancel_to_trade_ratio: Float,
};

pub fn extract_microstructure_features(book: &RawBookL2) -> MicrostructureFeatureVector {
    let b_q1: Float = (book).bid_q1;
    let a_q1: Float = (book).ask_q1;
    let b_q2: Float = (book).bid_q2;
    let a_q2: Float = (book).ask_q2;

    let tot_l1: Float = b_q1 + a_q1;
    let imb_l1: Float = if tot_l1 > 0.0 { (b_q1 - a_q1) / tot_l1 } else { 0.0 };

    let tot_l2: Float = b_q1 + b_q2 + a_q1 + a_q2;
    let imb_l2: Float = if tot_l2 > 0.0 { ((b_q1 + b_q2) - (a_q1 + a_q2)) / tot_l2 } else { 0.0 };

    let b_p1: Float = (book).bid_p1;
    let a_p1: Float = (book).ask_p1;
    let mid: Float = (b_p1 + a_p1) * 0.5;
    let spread: Float = a_p1 - b_p1;
    let spread_bps_val: Float = if mid > 0.0 { (spread / mid) * 10000.0 } else { 0.0 };

    // Book slope: delta_quantity / delta_price
    let dp_bid: Float = b_p1 - (book).bid_p2;
    let slope_bid: Float = if dp_bid > 0.0001 { b_q2 / dp_bid } else { 0.0 };

    let dp_ask: Float = (book).ask_p2 - a_p1;
    let slope_ask: Float = if dp_ask > 0.0001 { a_q2 / dp_ask } else { 0.0 };

    let cancels: Int = (book).recent_cancel_count;
    let trades: Int = (book).recent_trade_count;
    let mut c_f: Float = 0.0;
    let mut cnt: Int = cancels;
    while cnt >= 10 { c_f = c_f + 10.0; cnt = cnt - 10; }
    while cnt >= 1 { c_f = c_f + 1.0; cnt = cnt - 1; }

    let mut t_f: Float = 0.0;
    let mut tcnt: Int = trades;
    while tcnt >= 10 { t_f = t_f + 10.0; tcnt = tcnt - 10; }
    while tcnt >= 1 { t_f = t_f + 1.0; tcnt = tcnt - 1; }
    if t_f <= 0.0 { t_f = 1.0; }

    let c_to_t: Float = c_f / t_f;

    return MicrostructureFeatureVector {
        imbalance_l1: imb_l1,
        imbalance_l2: imb_l2,
        spread_bps: spread_bps_val,
        book_slope_bid: slope_bid,
        book_slope_ask: slope_ask,
        cancel_to_trade_ratio: c_to_t,
    };
}
