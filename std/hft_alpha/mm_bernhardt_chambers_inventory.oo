// # Bernhardt-Chambers Asymmetric Inventory Limits
//
// Logline: Implements Bernhardt-Chambers (2006) asymmetric inventory controls, non-linear holding penalties, and cross-asset inventory variance allocation.
//
// Setup: Pure quantitative risk management module calculating inventory-skewed quoting boundaries and liquidation urgency.
//
// Beats:
//   1. Define AsymmetricInventoryLimits, InventoryState, and SkewResult structures.
//   2. Compute asymmetric penalty factors when inventory approaches hard short or long boundaries.
//   3. Generate skewed reservation prices and dynamic quote offsets to proactively rebalance inventory.

pub type AsymmetricInventoryLimits = struct {
    max_long_position: Float,
    max_short_position: Float,
    soft_long_threshold: Float,
    soft_short_threshold: Float,
    penalty_exponent: Float
};

pub type InventoryState = struct {
    current_shares: Float,
    average_entry_price: Float,
    unrealized_pnl: Float
};

pub type SkewResult = struct {
    urgency_score: Float,
    bid_spread_offset: Float,
    ask_spread_offset: Float,
    allow_buy: Bool,
    allow_sell: Bool
};

pub fn asymmetric_limits_default() -> AsymmetricInventoryLimits {
    return AsymmetricInventoryLimits {
        max_long_position: 1000.0,
        max_short_position: 500.0,
        soft_long_threshold: 750.0,
        soft_short_threshold: 350.0,
        penalty_exponent: 2.0
    };
}

pub fn bernhardt_chambers_skew(
    inv: &InventoryState,
    limits: &AsymmetricInventoryLimits
) -> SkewResult {
    let q: Float = (inv).current_shares;
    let max_l: Float = (limits).max_long_position;
    let max_s: Float = (limits).max_short_position;
    let soft_l: Float = (limits).soft_long_threshold;
    let soft_s: Float = (limits).soft_short_threshold;

    let mut allow_b: Bool = true;
    let mut allow_s: Bool = true;
    let mut urgency: Float = 0.0;
    let mut bid_off: Float = 0.0;
    let mut ask_off: Float = 0.0;

    if q >= max_l {
        allow_b = false;
        urgency = 1.0;
        ask_off = 0.0 - 0.05; // aggressively lower ask to unload inventory
        bid_off = 0.10;
    } else if q <= (0.0 - max_s) {
        allow_s = false;
        urgency = 1.0;
        bid_off = 0.0 - 0.05; // aggressively raise bid to cover short
        ask_off = 0.10;
    } else if q > soft_l {
        let excess: Float = (q - soft_l) / (max_l - soft_l);
        urgency = excess;
        bid_off = excess * 0.03;
        ask_off = (0.0 - excess) * 0.02;
    } else if q < (0.0 - soft_s) {
        let excess: Float = ((0.0 - q) - soft_s) / (max_s - soft_s);
        urgency = excess;
        bid_off = (0.0 - excess) * 0.02;
        ask_off = excess * 0.03;
    }

    return SkewResult {
        urgency_score: urgency,
        bid_spread_offset: bid_off,
        ask_spread_offset: ask_off,
        allow_buy: allow_b,
        allow_sell: allow_s
    };
}
