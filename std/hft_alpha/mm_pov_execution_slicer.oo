// # Percentage of Volume (POV) Execution Slicer
//
// Logline: Adjusts child order sizes dynamically to match a specified target market participation rate (POV) based on observed trading volume.
//
// Setup: Pure algorithmic execution engine with participation capping and rate smoothing.
//
// Beats:
//   1. Define PovParams, MarketVolumeTracker, and PovDecision structures.
//   2. Compute target order size given market volume interval and desired participation rate.
//   3. Apply aggressive caps to prevent predatory market impact and adverse selection.

pub type PovParams = struct {
    target_participation_rate: Float,
    max_participation_rate: Float,
    min_child_size: Float,
    max_child_size: Float,
};

pub type MarketVolumeTracker = struct {
    interval_index: Int,
    market_volume_traded: Float,
    own_volume_filled: Float,
    cumulative_market_volume: Float,
    cumulative_own_volume: Float,
};

pub type PovDecision = struct {
    recommended_child_size: Float,
    realized_participation_rate: Float,
    is_rate_capped: Bool,
    remaining_parent_order: Float,
};

pub fn pov_params_new(
    target_rate: Float,
    max_rate: Float,
    min_size: Float,
    max_size: Float
) -> PovParams {
    return PovParams {
        target_participation_rate: target_rate,
        max_participation_rate: max_rate,
        min_child_size: min_size,
        max_child_size: max_size,
    };
}

pub fn market_volume_tracker_new() -> MarketVolumeTracker {
    return MarketVolumeTracker {
        interval_index: 0,
        market_volume_traded: 0.0,
        own_volume_filled: 0.0,
        cumulative_market_volume: 0.0,
        cumulative_own_volume: 0.0,
    };
}

pub fn pov_compute_next_slice(
    tracker: &mut MarketVolumeTracker,
    recent_market_volume: Float,
    recent_own_filled: Float,
    parent_shares_remaining: Float,
    params: &PovParams
) -> PovDecision {
    (tracker).interval_index = (tracker).interval_index + 1;
    (tracker).market_volume_traded = recent_market_volume;
    (tracker).own_volume_filled = recent_own_filled;
    (tracker).cumulative_market_volume = (tracker).cumulative_market_volume + recent_market_volume;
    (tracker).cumulative_own_volume = (tracker).cumulative_own_volume + recent_own_filled;

    if parent_shares_remaining <= 0.0 {
        return PovDecision {
            recommended_child_size: 0.0,
            realized_participation_rate: 0.0,
            is_rate_capped: false,
            remaining_parent_order: 0.0,
        };
    }

    let target_rate: Float = (params).target_participation_rate;
    let max_rate: Float = (params).max_participation_rate;

    // Desired child order = target_rate * market_volume
    let mut desired_size: Float = target_rate * recent_market_volume;
    let mut capped: Bool = false;

    let max_allowed_size: Float = max_rate * recent_market_volume;
    if desired_size > max_allowed_size {
        desired_size = max_allowed_size;
        capped = true;
    }

    if desired_size > (params).max_child_size {
        desired_size = (params).max_child_size;
        capped = true;
    }

    if desired_size < (params).min_child_size && desired_size > 0.0 {
        desired_size = (params).min_child_size;
    }

    if desired_size > parent_shares_remaining {
        desired_size = parent_shares_remaining;
    }

    let tot_mkt: Float = (tracker).cumulative_market_volume;
    let realized_rate: Float = if tot_mkt > 0.0 { (tracker).cumulative_own_volume / tot_mkt } else { 0.0 };

    return PovDecision {
        recommended_child_size: desired_size,
        realized_participation_rate: realized_rate,
        is_rate_capped: capped,
        remaining_parent_order: parent_shares_remaining - desired_size,
    };
}
