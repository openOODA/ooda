// # Volatility-Adaptive Quoting Spread Scheduler
//
// Logline: Adjusts quoting half-spreads dynamically in response to real-time volatility regime transitions and instantaneous market turbulence.
//
// Setup: Pure quantitative execution module scaling bid/ask spread widths across calm, normal, and volatile regimes.
//
// Beats:
//   1. Define VolatilityRegime, SpreadScheduleParams, and AdaptiveSpreadResult structures.
//   2. Classify current market state into low, normal, high, or crisis volatility regimes.
//   3. Compute regime-scaled quoting spreads and minimum inventory protection margins.

pub type SpreadScheduleParams = struct {
    base_spread_bps: Float,
    min_spread_bps: Float,
    max_spread_bps: Float,
    vol_sensitivity_gamma: Float
};

pub type MarketConditions = struct {
    short_term_realized_vol: Float,
    baseline_historical_vol: Float,
    order_book_depth_ratio: Float
};

pub type AdaptiveSpreadResult = struct {
    target_half_spread_bps: Float,
    target_total_spread_bps: Float,
    regime_multiplier: Float,
    volatility_regime_code: Int // 1 = Low Vol, 2 = Normal, 3 = High Vol, 4 = Crisis
};

pub fn spread_params_default() -> SpreadScheduleParams {
    return SpreadScheduleParams {
        base_spread_bps: 5.0,
        min_spread_bps: 1.0,
        max_spread_bps: 50.0,
        vol_sensitivity_gamma: 1.5
    };
}

pub fn adaptive_spread_compute(
    cond: &MarketConditions,
    params: &SpreadScheduleParams
) -> AdaptiveSpreadResult {
    let curr_vol: Float = (cond).short_term_realized_vol;
    let base_vol: Float = (cond).baseline_historical_vol;
    let vol_ratio: Float = if base_vol > 0.0001 { curr_vol / base_vol } else { 1.0 };

    let mut regime: Int = 2; // Normal
    let mut mult: Float = 1.0;

    if vol_ratio < 0.7 {
        regime = 1; // Low Vol
        mult = 0.8;
    } else if vol_ratio > 2.5 {
        regime = 4; // Crisis
        mult = 3.0;
    } else if vol_ratio > 1.4 {
        regime = 3; // High Vol
        mult = 1.8;
    }

    let base_bps: Float = (params).base_spread_bps;
    let sens: Float = (params).vol_sensitivity_gamma;
    let mut total_bps: Float = base_bps * mult * (1.0 + ((vol_ratio - 1.0) * sens * 0.5));

    if total_bps < (params).min_spread_bps {
        total_bps = (params).min_spread_bps;
    }
    if total_bps > (params).max_spread_bps {
        total_bps = (params).max_spread_bps;
    }

    let half_bps: Float = total_bps * 0.5;

    return AdaptiveSpreadResult {
        target_half_spread_bps: half_bps,
        target_total_spread_bps: total_bps,
        regime_multiplier: mult,
        volatility_regime_code: regime
    };
}
