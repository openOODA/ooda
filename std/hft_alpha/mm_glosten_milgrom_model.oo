// # Glosten-Milgrom Sequential Trade Microstructure Model
//
// Logline: Implements the Glosten-Milgrom (1985) sequential trade model with Bayesian belief updating from buy and sell order arrivals.
//
// Setup: Pure quantitative microstructure module calculating bid/ask spreads from informed trader probability and prior beliefs.
//
// Beats:
//   1. Define GmParams, MarketMakerBelief, and GmQuotes structures.
//   2. Compute bid and ask quotes conditioning on buyer-initiated or seller-initiated trade arrivals.
//   3. Perform Bayesian belief updates after observing trade signs to update posterior probability of high asset value.

pub type GmParams = struct {
    value_low: Float,
    value_high: Float,
    prob_informed_mu: Float,
    noise_buy_prob_gamma: Float
};

pub type MarketMakerBelief = struct {
    prior_prob_high: Float,
    current_midpoint: Float,
    trade_count: Int
};

pub type GmQuotes = struct {
    bid_quote: Float,
    ask_quote: Float,
    spread: Float,
    posterior_if_buy: Float,
    posterior_if_sell: Float
};

pub fn gm_params_new(
    v_low: Float,
    v_high: Float,
    mu: Float
) -> GmParams {
    return GmParams {
        value_low: v_low,
        value_high: v_high,
        prob_informed_mu: mu,
        noise_buy_prob_gamma: 0.5
    };
}

pub fn gm_belief_new(p_high: Float, params: &GmParams) -> MarketMakerBelief {
    let mid: Float = (p_high * (params).value_high) + ((1.0 - p_high) * (params).value_low);
    return MarketMakerBelief {
        prior_prob_high: p_high,
        current_midpoint: mid,
        trade_count: 0
    };
}

pub fn gm_compute_quotes(
    belief: &MarketMakerBelief,
    params: &GmParams
) -> GmQuotes {
    let pi: Float = (belief).prior_prob_high;
    let mu: Float = (params).prob_informed_mu;
    let v_h: Float = (params).value_high;
    let v_l: Float = (params).value_low;

    // P(Buy | High) = mu + (1 - mu) * 0.5 = 0.5 + 0.5 * mu
    // P(Buy | Low) = (1 - mu) * 0.5 = 0.5 - 0.5 * mu
    let p_buy_given_high: Float = 0.5 + (0.5 * mu);
    let p_buy_given_low: Float = 0.5 - (0.5 * mu);

    let p_buy: Float = (pi * p_buy_given_high) + ((1.0 - pi) * p_buy_given_low);
    let post_high_buy: Float = if p_buy > 0.0 { (pi * p_buy_given_high) / p_buy } else { pi };

    // P(Sell | High) = 0.5 - 0.5 * mu
    // P(Sell | Low) = 0.5 + 0.5 * mu
    let p_sell_given_high: Float = 0.5 - (0.5 * mu);
    let p_sell_given_low: Float = 0.5 + (0.5 * mu);

    let p_sell: Float = (pi * p_sell_given_high) + ((1.0 - pi) * p_sell_given_low);
    let post_high_sell: Float = if p_sell > 0.0 { (pi * p_sell_given_high) / p_sell } else { pi };

    // Ask = E[V | Buy] = post_high_buy * v_h + (1 - post_high_buy) * v_l
    let ask: Float = (post_high_buy * v_h) + ((1.0 - post_high_buy) * v_l);
    // Bid = E[V | Sell] = post_high_sell * v_h + (1 - post_high_sell) * v_l
    let bid: Float = (post_high_sell * v_h) + ((1.0 - post_high_sell) * v_l);
    let spr: Float = ask - bid;

    return GmQuotes {
        bid_quote: bid,
        ask_quote: ask,
        spread: spr,
        posterior_if_buy: post_high_buy,
        posterior_if_sell: post_high_sell
    };
}

pub fn gm_update_belief_on_trade(
    belief: &mut MarketMakerBelief,
    is_buy: Bool,
    params: &GmParams
) {
    let quotes: GmQuotes = gm_compute_quotes(belief, params);
    if is_buy {
        (belief).prior_prob_high = (quotes).posterior_if_buy;
    } else {
        (belief).prior_prob_high = (quotes).posterior_if_sell;
    }
    (belief).trade_count = (belief).trade_count + 1;
    (belief).current_midpoint = ((belief).prior_prob_high * (params).value_high) + ((1.0 - (belief).prior_prob_high) * (params).value_low);
}
