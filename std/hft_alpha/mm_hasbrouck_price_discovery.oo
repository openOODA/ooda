// # Hasbrouck Information Share and Price Discovery
//
// Logline: Measures venue price discovery contribution and permanent market impact using Hasbrouck's Information Share (IS) and vector autoregression.
//
// Setup: Pure econometrics and market microstructure module estimating price discovery fractions across fragmented venues.
//
// Beats:
//   1. Define VenueDiscoveryStats, HasbrouckVarParams, and InformationShareResult structures.
//   2. Compute venue covariance matrix elements and permanent random-walk innovations.
//   3. Calculate Hasbrouck upper and lower information share bounds using Cholesky factor ordering.

pub type VenueDiscoveryStats = struct {
    venue_name: String,
    variance_innovations: Float,
    lead_coefficient: Float,
};

pub type HasbrouckVarParams = struct {
    cross_venue_covariance: Float,
    venue_a_variance: Float,
    venue_b_variance: Float,
};

pub type InformationShareResult = struct {
    venue_a_is_lower: Float,
    venue_a_is_upper: Float,
    venue_a_is_midpoint: Float,
    venue_b_is_midpoint: Float,
    leading_venue_index: Int,
};

pub fn hasbrouck_params_new(
    var_a: Float,
    var_b: Float,
    cov_ab: Float
) -> HasbrouckVarParams {
    return HasbrouckVarParams {
        cross_venue_covariance: cov_ab,
        venue_a_variance: var_a,
        venue_b_variance: var_b,
    };
}

pub fn hasbrouck_compute_information_share(
    params: &HasbrouckVarParams
) -> InformationShareResult {
    let s11: Float = (params).venue_a_variance;
    let s22: Float = (params).venue_b_variance;
    let s12: Float = (params).cross_venue_covariance;

    // Cholesky lower triangular factorization L:
    // L11 = sqrt(s11)
    // L21 = s12 / sqrt(s11)
    // L22 = sqrt(s22 - s12^2 / s11)
    let l11: Float = if s11 > 0.0 { sqrt(s11) } else { 1.0 };
    let l21: Float = if l11 > 0.0 { s12 / l11 } else { 0.0 };
    let rem_diag: Float = s22 - (l21 * l21);
    let l22: Float = if rem_diag > 0.0 { sqrt(rem_diag) } else { 0.0 };

    // Total variance factor: (L11 + L21)^2 + L22^2
    let sum1: Float = l11 + l21;
    let total_common_var: Float = (sum1 * sum1) + (l22 * l22);

    let is_a_order1: Float = if total_common_var > 0.0 { (sum1 * sum1) / total_common_var } else { 0.5 };

    // Reverse ordering for Cholesky bounds (Venue B first)
    let m22: Float = if s22 > 0.0 { sqrt(s22) } else { 1.0 };
    let m12: Float = if m22 > 0.0 { s12 / m22 } else { 0.0 };
    let rem2_diag: Float = s11 - (m12 * m12);
    let m11: Float = if rem2_diag > 0.0 { sqrt(rem2_diag) } else { 0.0 };

    let sum2: Float = m22 + m12;
    let total_rev_var: Float = (sum2 * sum2) + (m11 * m11);
    let is_b_order2: Float = if total_rev_var > 0.0 { (sum2 * sum2) / total_rev_var } else { 0.5 };
    let is_a_order2: Float = 1.0 - is_b_order2;

    let mut is_a_low: Float = is_a_order1;
    let mut is_a_high: Float = is_a_order2;
    if is_a_order1 > is_a_order2 {
        is_a_low = is_a_order2;
        is_a_high = is_a_order1;
    }

    let is_a_mid: Float = (is_a_low + is_a_high) * 0.5;
    let is_b_mid: Float = 1.0 - is_a_mid;
    let lead_idx: Int = if is_a_mid >= 0.5 { 1 } else { 2 };

    return InformationShareResult {
        venue_a_is_lower: is_a_low,
        venue_a_is_upper: is_a_high,
        venue_a_is_midpoint: is_a_mid,
        venue_b_is_midpoint: is_b_mid,
        leading_venue_index: lead_idx,
    };
}
