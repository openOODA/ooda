// # Stoikov Microprice and Queue Imbalance
//
// Logline: Calculates the Stoikov (2018) microprice adjustment using top-of-book volume imbalance, spread size, and queue asymmetry.
//
// Setup: Pure high-frequency microstructure module providing weighted midprice and Markovian queue transition adjustments.
//
// Beats:
//   1. Define L1BookState, MicropriceParams, and MicropriceResult structures.
//   2. Compute top-of-book volume imbalance I = (q_b - q_a) / (q_b + q_a).
//   3. Calculate Stoikov microprice taking into account non-linear adjustment function g(I) and spread width.

pub type L1BookState = struct {
    best_bid_price: Float,
    best_bid_qty: Float,
    best_ask_price: Float,
    best_ask_qty: Float,
};

pub type MicropriceParams = struct {
    tick_size: Float,
    imbalance_exponent: Float,
    asymmetry_coefficient: Float,
};

pub type MicropriceResult = struct {
    simple_mid: Float,
    volume_imbalance: Float,
    microprice: Float,
    price_delta: Float,
    predicted_next_tick_direction: Int,
};

pub fn l1_book_state_new(
    bid_px: Float,
    bid_sz: Float,
    ask_px: Float,
    ask_sz: Float
) -> L1BookState {
    return L1BookState {
        best_bid_price: bid_px,
        best_bid_qty: bid_sz,
        best_ask_price: ask_px,
        best_ask_qty: ask_sz,
    };
}

pub fn microprice_params_default() -> MicropriceParams {
    return MicropriceParams {
        tick_size: 0.01,
        imbalance_exponent: 1.0,
        asymmetry_coefficient: 0.5,
    };
}

pub fn microprice_compute_imbalance(book: &L1BookState) -> Float {
    let q_b: Float = (book).best_bid_qty;
    let q_a: Float = (book).best_ask_qty;
    let total_q: Float = q_b + q_a;
    
    if total_q <= 0.0 {
        return 0.0;
    }
    return (q_b - q_a) / total_q;
}

pub fn microprice_compute_weighted_mid(book: &L1BookState) -> Float {
    let p_b: Float = (book).best_bid_price;
    let p_a: Float = (book).best_ask_price;
    let q_b: Float = (book).best_bid_qty;
    let q_a: Float = (book).best_ask_qty;
    let total_q: Float = q_b + q_a;

    if total_q <= 0.0 {
        return (p_b + p_a) * 0.5;
    }
    // Weighted mid = (p_b * q_a + p_a * q_b) / (q_b + q_a)
    return ((p_b * q_a) + (p_a * q_b)) / total_q;
}

pub fn microprice_calculate(
    book: &L1BookState,
    params: &MicropriceParams
) -> MicropriceResult {
    let p_b: Float = (book).best_bid_price;
    let p_a: Float = (book).best_ask_price;
    let simple_mid: Float = (p_b + p_a) * 0.5;
    let spread: Float = p_a - p_b;
    
    let imb: Float = microprice_compute_imbalance(book);
    let coeff: Float = (params).asymmetry_coefficient;
    
    // Microprice P_micro = mid + (spread / 2) * (coeff * imb)
    let delta: Float = (spread * 0.5) * (coeff * imb);
    let p_micro: Float = simple_mid + delta;

    let mut direction: Int = 0;
    if imb > 0.2 {
        direction = 1;
    } else if imb < (0.0 - 0.2) {
        direction = 0 - 1;
    }

    return MicropriceResult {
        simple_mid: simple_mid,
        volume_imbalance: imb,
        microprice: p_micro,
        price_delta: delta,
        predicted_next_tick_direction: direction,
    };
}
