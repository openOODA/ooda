// # Target Close and Auction Execution Scheduler
//
// Logline: Schedules optimal order completion ahead of the official market closing cross (MOC/LOC) with continuous risk-adjusted acceleration.
//
// Setup: Pure algorithmic execution module dynamically managing remaining order trajectory into closing auctions.
//
// Beats:
//   1. Define TargetCloseConfig, CloseExecutionState, and AuctionSchedule structures.
//   2. Calculate required continuous trading rate to complete parent order prior to the MOC cutoff.
//   3. Allocate residual position to continuous sweep vs closing cross submission.

pub type TargetCloseConfig = struct {
    total_order_shares: Float,
    auction_cutoff_seconds: Float,
    min_continuous_completion_pct: Float,
    max_auction_participation_pct: Float
};

pub type CloseExecutionState = struct {
    time_to_close_seconds: Float,
    shares_remaining: Float,
    auction_imbalance_shares: Float
};

pub type AuctionSchedule = struct {
    continuous_slice_rate_per_sec: Float,
    allocated_to_closing_cross: Float,
    is_urgency_accelerated: Bool
};

pub fn target_close_config_default() -> TargetCloseConfig {
    return TargetCloseConfig {
        total_order_shares: 10000.0,
        auction_cutoff_seconds: 300.0, // 5 minutes prior to close
        min_continuous_completion_pct: 0.80,
        max_auction_participation_pct: 0.20
    };
}

pub fn target_close_schedule(
    state: &CloseExecutionState,
    config: &TargetCloseConfig
) -> AuctionSchedule {
    let t_rem: Float = (state).time_to_close_seconds;
    let shares_rem: Float = (state).shares_remaining;
    let cutoff: Float = (config).auction_cutoff_seconds;

    if t_rem <= 0.0 || shares_rem <= 0.0 {
        return AuctionSchedule {
            continuous_slice_rate_per_sec: 0.0,
            allocated_to_closing_cross: shares_rem,
            is_urgency_accelerated: false
        };
    }

    let max_cross: Float = (config).total_order_shares * (config).max_auction_participation_pct;
    let cross_target: Float = if shares_rem < max_cross { shares_rem * 0.5 } else { max_cross };
    let continuous_target: Float = shares_rem - cross_target;

    // Remaining time until cutoff
    let mut t_cont: Float = t_rem - cutoff;
    let mut accelerated: Bool = false;

    if t_cont <= 10.0 {
        // Less than 10s to cutoff: accelerate aggressively
        t_cont = if t_cont <= 1.0 { 1.0 } else { t_cont };
        accelerated = true;
    }

    let rate: Float = continuous_target / t_cont;

    return AuctionSchedule {
        continuous_slice_rate_per_sec: rate,
        allocated_to_closing_cross: cross_target,
        is_urgency_accelerated: accelerated
    };
}
