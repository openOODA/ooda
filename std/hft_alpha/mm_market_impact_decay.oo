// # Bouchaud Transient Market Impact Propagator
//
// Logline: Calculates transient and permanent price impact decay using the Bouchaud et al. power-law and exponential propagator model.
//
// Setup: Pure quantitative execution modeling module tracking post-trade price relaxation trajectories.
//
// Beats:
//   1. Define PropagatorParams, TradeShock, and ImpactRelaxation structures.
//   2. Compute instantaneous square-root price impact I_0 = Y * sigma * sqrt(Q / V).
//   3. Calculate power-law impact relaxation G(t) = I_0 / (1 + (t / tau)^gamma).

pub type PropagatorParams = struct {
    decay_gamma: Float,
    time_scale_tau: Float,
    permanent_impact_fraction: Float,
};

pub type TradeShock = struct {
    trade_time: Float,
    trade_size: Float,
    daily_volume: Float,
    daily_volatility: Float,
    price: Float,
};

pub type ImpactRelaxation = struct {
    initial_peak_impact: Float,
    current_impact: Float,
    permanent_residual_impact: Float,
    decay_fraction: Float,
};

pub fn propagator_params_default() -> PropagatorParams {
    return PropagatorParams {
        decay_gamma: 0.5,
        time_scale_tau: 60.0,
        permanent_impact_fraction: 0.3,
    };
}

pub fn bouchaud_compute_impact(
    shock: &TradeShock,
    elapsed_time_sec: Float,
    params: &PropagatorParams
) -> ImpactRelaxation {
    let q: Float = (shock).trade_size;
    let v: Float = (shock).daily_volume;
    let sigma: Float = (shock).daily_volatility;
    let px: Float = (shock).price;

    let vol_frac: Float = if v > 0.0 { q / v } else { 0.0 };
    let sqrt_frac: Float = sqrt(vol_frac);

    // Initial peak impact I_0 = 0.5 * sigma * px * sqrt(Q / V)
    let i0: Float = 0.5 * sigma * px * sqrt_frac;

    let perm_frac: Float = (params).permanent_impact_fraction;
    let perm_impact: Float = i0 * perm_frac;
    let trans_impact: Float = i0 * (1.0 - perm_frac);

    let tau: Float = (params).time_scale_tau;
    let gamma: Float = (params).decay_gamma;

    // Relaxation G(t) = (1 + (t/tau)^gamma)^(-1)
    let t_norm: Float = if tau > 0.0 { elapsed_time_sec / tau } else { 0.0 };
    let power_term: Float = pow(t_norm, gamma);
    let decay_mult: Float = 1.0 / (1.0 + power_term);

    let curr_trans: Float = trans_impact * decay_mult;
    let curr_total: Float = perm_impact + curr_trans;
    let d_frac: Float = if i0 > 0.0 { 1.0 - (curr_total / i0) } else { 0.0 };

    return ImpactRelaxation {
        initial_peak_impact: i0,
        current_impact: curr_total,
        permanent_residual_impact: perm_impact,
        decay_fraction: d_frac,
    };
}
