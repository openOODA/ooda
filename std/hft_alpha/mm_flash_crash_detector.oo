// # Flash Crash and Liquidity Vacuum Detector
//
// Logline: Detects anomalous cascade crashes, liquidity evaporation, and abrupt order book hollow-outs triggering rapid circuit breakers.
//
// Setup: Pure high-frequency market safety module monitoring multi-level depth collapse and cascade indicators.
//
// Beats:
//   1. Define FlashCrashConfig, BookVacuumState, and CircuitBreakerSignal structures.
//   2. Monitor instantaneous top-5 depth collapse ratio and price acceleration.
//   3. Trigger emergency liquidation halts and quoting freeze signals to protect capital.

pub type FlashCrashConfig = struct {
    depth_drop_threshold_pct: Float,
    price_velocity_threshold_bps_per_sec: Float,
    spread_expansion_multiplier: Float
};

pub type BookVacuumState = struct {
    baseline_depth: Float,
    current_depth: Float,
    price_velocity_bps_sec: Float,
    current_spread_ratio: Float
};

pub type CircuitBreakerSignal = struct {
    is_circuit_breaker_triggered: Bool,
    severity_level: Int, // 0 = Safe, 1 = Caution, 2 = Halt Quoting, 3 = Emergency Liquidation
    trigger_reason: String
};

pub fn flash_crash_config_default() -> FlashCrashConfig {
    return FlashCrashConfig {
        depth_drop_threshold_pct: 0.70, // 70% depth vanishing
        price_velocity_threshold_bps_per_sec: 100.0,
        spread_expansion_multiplier: 5.0
    };
}

pub fn evaluate_flash_crash_risk(
    state: &BookVacuumState,
    config: &FlashCrashConfig
) -> CircuitBreakerSignal {
    let b_depth: Float = (state).baseline_depth;
    let c_depth: Float = (state).current_depth;

    let mut depth_drop: Float = 0.0;
    if b_depth > 0.0 {
        depth_drop = (b_depth - c_depth) / b_depth;
    }

    let vel: Float = (state).price_velocity_bps_sec;
    let abs_vel: Float = if vel < 0.0 { 0.0 - vel } else { vel };

    let spr_mult: Float = (state).current_spread_ratio;

    if depth_drop >= (config).depth_drop_threshold_pct && abs_vel >= (config).price_velocity_threshold_bps_per_sec {
        return CircuitBreakerSignal {
            is_circuit_breaker_triggered: true,
            severity_level: 3,
            trigger_reason: "LIQUIDITY_VACUUM_COLLAPSE"
        };
    } else if spr_mult >= (config).spread_expansion_multiplier {
        return CircuitBreakerSignal {
            is_circuit_breaker_triggered: true,
            severity_level: 2,
            trigger_reason: "EXTREME_SPREAD_EXPANSION"
        };
    } else if depth_drop >= 0.50 {
        return CircuitBreakerSignal {
            is_circuit_breaker_triggered: false,
            severity_level: 1,
            trigger_reason: "CAUTION_DEPTH_DROP"
        };
    }

    return CircuitBreakerSignal {
        is_circuit_breaker_triggered: false,
        severity_level: 0,
        trigger_reason: "NORMAL_CONDITIONS"
    };
}
