// # Avellaneda-Stoikov Market Making ODE
//
// Logline: Calculates reservation prices and optimal inventory-dependent bid/ask spreads using the Avellaneda-Stoikov high-frequency market making model.
//
// Setup: Pure quantitative microstructure model utilizing reservation price adjustments and asymptotic spread formulas.
//
// Beats:
//   1. Define AvellanedaStoikovParams, ReservationPriceResult, and OptimalQuotes structures.
//   2. Compute inventory reservation price factoring risk aversion, asset volatility, and remaining time horizon.
//   3. Calculate optimal half-spreads and absolute bid/ask quotes based on order arrival intensity.

pub type AsParams = struct {
    gamma_risk_aversion: Float,
    sigma_volatility: Float,
    time_horizon_t: Float,
    kappa_order_intensity: Float
};

pub type ReservationPriceResult = struct {
    mid_price: Float,
    inventory_q: Float,
    reservation_price: Float,
    inventory_penalty: Float
};

pub type OptimalQuotes = struct {
    reservation_price: Float,
    bid_quote: Float,
    ask_quote: Float,
    half_spread: Float,
    total_spread: Float
};

pub fn as_params_new(
    gamma: Float,
    sigma: Float,
    horizon_t: Float,
    kappa: Float
) -> AsParams {
    return AsParams {
        gamma_risk_aversion: gamma,
        sigma_volatility: sigma,
        time_horizon_t: horizon_t,
        kappa_order_intensity: kappa
    };
}

pub fn as_compute_reservation_price(
    mid_price: Float,
    inventory_q: Float,
    time_remaining: Float,
    params: &AsParams
) -> ReservationPriceResult {
    let gamma: Float = (params).gamma_risk_aversion;
    let sigma: Float = (params).sigma_volatility;
    let sigma_sq: Float = sigma * sigma;
    
    // R(s, q, t) = s - q * gamma * sigma^2 * (T - t)
    let penalty: Float = inventory_q * gamma * sigma_sq * time_remaining;
    let res_price: Float = mid_price - penalty;

    return ReservationPriceResult {
        mid_price: mid_price,
        inventory_q: inventory_q,
        reservation_price: res_price,
        inventory_penalty: penalty
    };
}

pub fn as_compute_optimal_quotes(
    mid_price: Float,
    inventory_q: Float,
    time_remaining: Float,
    params: &AsParams
) -> OptimalQuotes {
    let res_result: ReservationPriceResult = as_compute_reservation_price(mid_price, inventory_q, time_remaining, params);
    let r_price: Float = (res_result).reservation_price;
    
    let gamma: Float = (params).gamma_risk_aversion;
    let kappa: Float = (params).kappa_order_intensity;
    let sigma: Float = (params).sigma_volatility;
    let sigma_sq: Float = sigma * sigma;

    // Asymptotic spread s = (2 / gamma) * ln(1 + gamma / kappa)
    let base_spread: Float = 2.0 / kappa;
    let volatility_spread: Float = gamma * sigma_sq * time_remaining;
    let total_spread: Float = base_spread + volatility_spread;
    let half_spread: Float = total_spread * 0.5;

    let bid: Float = r_price - half_spread;
    let ask: Float = r_price + half_spread;

    return OptimalQuotes {
        reservation_price: r_price,
        bid_quote: bid,
        ask_quote: ask,
        half_spread: half_spread,
        total_spread: total_spread
    };
}

pub fn as_is_inventory_at_limit(inventory_q: Float, max_inventory: Float) -> Bool {
    if inventory_q >= max_inventory {
        return true;
    }
    let neg_limit: Float = 0.0 - max_inventory;
    if inventory_q <= neg_limit {
        return true;
    }
    return false;
}
