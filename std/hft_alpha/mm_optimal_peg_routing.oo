// # Optimal Pegged Order Routing and Offset Scheduler
//
// Logline: Generates optimal pricing and dynamic tick offsets for Primary Peg, Midpoint Peg, and Market Peg order types with discretionary price capping.
//
// Setup: Pure execution routing module computing compliant pegged order limits across exchange order books.
//
// Beats:
//   1. Define PegTypeEnum, PeggedOrderConfig, and PeggedPriceResult structures.
//   2. Calculate dynamically adjusted pegged order prices pegged to NBBO best bid, midquote, or best ask.
//   3. Apply discretionary price offsets and limit price bounds to avoid crosses and taker fees.

pub type PeggedOrderConfig = struct {
    peg_type: Int, // 1 = Primary, 2 = Midpoint, 3 = Market, 4 = Reverse
    tick_offset: Float,
    limit_cap_price: Float,
    is_buy_side: Bool
};

pub type NbboState = struct {
    best_bid: Float,
    best_ask: Float,
    midquote: Float,
    spread: Float
};

pub type PeggedPriceResult = struct {
    pegged_price: Float,
    reference_price: Float,
    offset_applied: Float,
    is_capped: Bool,
    is_passive_quote: Bool
};

pub fn nbbo_state_new(bid: Float, ask: Float) -> NbboState {
    let mid: Float = (bid + ask) * 0.5;
    let spr: Float = ask - bid;
    return NbboState {
        best_bid: bid,
        best_ask: ask,
        midquote: mid,
        spread: spr
    };
}

pub fn peg_calculate_price(
    nbbo: &NbboState,
    config: &PeggedOrderConfig
) -> PeggedPriceResult {
    let p_type: Int = (config).peg_type;
    let offset: Float = (config).tick_offset;
    let cap: Float = (config).limit_cap_price;
    let is_buy: Bool = (config).is_buy_side;

    let mut ref_px: Float = (nbbo).midquote;
    if p_type == 1 {
        // Primary peg: buy pegs to bid, sell pegs to ask
        ref_px = if is_buy { (nbbo).best_bid } else { (nbbo).best_ask };
    } else if p_type == 2 {
        // Midpoint peg
        ref_px = (nbbo).midquote;
    } else if p_type == 3 {
        // Market peg (aggressive): buy pegs to ask, sell pegs to bid
        ref_px = if is_buy { (nbbo).best_ask } else { (nbbo).best_bid };
    }

    let mut raw_px: Float = if is_buy { ref_px + offset } else { ref_px - offset };
    let mut capped: Bool = false;

    if is_buy && cap > 0.0 && raw_px > cap {
        raw_px = cap;
        capped = true;
    } else if (!is_buy) && cap > 0.0 && raw_px < cap {
        raw_px = cap;
        capped = true;
    }

    let passive: Bool = if is_buy { raw_px < (nbbo).best_ask } else { raw_px > (nbbo).best_bid };

    return PeggedPriceResult {
        pegged_price: raw_px,
        reference_price: ref_px,
        offset_applied: offset,
        is_capped: capped,
        is_passive_quote: passive
    };
}
