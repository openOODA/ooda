// # Maker-Taker Fee and Inverted Venue Routing Optimizer
//
// Logline: Optimizes order routing across maker-taker, inverted (taker-rebate), and zero-fee exchanges based on execution urgency and fee economics.
//
// Setup: Pure quantitative smart order routing module selecting venues maximizing net realized fill economics.
//
// Beats:
//   1. Define FeeTierConfig, VenueFeeProfile, and VenueRoutingChoice structures.
//   2. Calculate net effective cost per share: price + taker fee - maker rebate across candidate venues.
//   3. Select optimal venue for aggressive sweeps vs passive limit posting.

pub type VenueFeeProfile = struct {
    venue_name: String,
    maker_rebate_per_share: Float,
    taker_fee_per_share: Float,
    is_inverted_fee_model: Bool,
    average_fill_speed_ms: Float,
};

pub type VenueRoutingChoice = struct {
    chosen_venue: String,
    is_aggressive_taker: Bool,
    expected_fee_or_rebate_per_share: Float,
    net_effective_cost_usd: Float,
};

pub fn venue_fee_profile_new(
    name: String,
    maker_rebate: Float,
    taker_fee: Float,
    is_inverted: Bool,
    speed_ms: Float
) -> VenueFeeProfile {
    return VenueFeeProfile {
        venue_name: name,
        maker_rebate_per_share: maker_rebate,
        taker_fee_per_share: taker_fee,
        is_inverted_fee_model: is_inverted,
        average_fill_speed_ms: speed_ms,
    };
}

pub fn optimize_venue_routing(
    shares: Float,
    is_aggressive: Bool,
    standard_venue: &VenueFeeProfile,
    inverted_venue: &VenueFeeProfile
) -> VenueRoutingChoice {
    if is_aggressive {
        // Aggressive orders want lowest taker fee (or taker rebate on inverted venue)
        let cost_std: Float = (standard_venue).taker_fee_per_share;
        let cost_inv: Float = (inverted_venue).taker_fee_per_share;

        let use_inv: Bool = cost_inv < cost_std;
        let chosen: String = if use_inv { (inverted_venue).venue_name } else { (standard_venue).venue_name };
        let fee: Float = if use_inv { cost_inv } else { cost_std };

        return VenueRoutingChoice {
            chosen_venue: chosen,
            is_aggressive_taker: true,
            expected_fee_or_rebate_per_share: fee,
            net_effective_cost_usd: shares * fee,
        };
    } else {
        // Passive orders want highest maker rebate
        let reb_std: Float = (standard_venue).maker_rebate_per_share;
        let reb_inv: Float = (inverted_venue).maker_rebate_per_share;

        let use_std: Bool = reb_std > reb_inv;
        let chosen: String = if use_std { (standard_venue).venue_name } else { (inverted_venue).venue_name };
        let rebate: Float = if use_std { reb_std } else { reb_inv };

        return VenueRoutingChoice {
            chosen_venue: chosen,
            is_aggressive_taker: false,
            expected_fee_or_rebate_per_share: 0.0 - rebate,
            net_effective_cost_usd: (0.0 - shares) * rebate,
        };
    }
}
