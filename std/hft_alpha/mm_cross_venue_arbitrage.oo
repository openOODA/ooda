// # Cross-Venue High-Frequency Arbitrage
//
// Logline: Detects and executes spatial and latency cross-venue arbitrage opportunities across fragmented limit order books.
//
// Setup: Pure quantitative arbitrage engine calculating net crossed-market spreads, taker fees, and race success probabilities.
//
// Beats:
//   1. Define VenueQuote, ArbitrageOpportunity, and ArbExecutionPlan structures.
//   2. Identify crossed markets where Venue A Best Bid exceeds Venue B Best Ask net of all fees.
//   3. Compute optimal routed size and estimated net PnL accounting for fill latency risk.

pub type VenueQuote = struct {
    venue_id: String,
    bid_price: Float,
    bid_size: Float,
    ask_price: Float,
    ask_size: Float,
    maker_fee_bps: Float,
    taker_fee_bps: Float,
    one_way_latency_ms: Float,
};

pub type ArbitrageOpportunity = struct {
    venue_buy: String,
    venue_sell: String,
    buy_price: Float,
    sell_price: Float,
    executable_size: Float,
    gross_spread: Float,
    net_spread_after_fees: Float,
    expected_pnl: Float,
    is_profitable: Bool,
};

pub type ArbExecutionPlan = struct {
    buy_venue: String,
    sell_venue: String,
    target_shares: Float,
    net_pnl_usd: Float,
    latency_advantage_ms: Float,
};

pub fn venue_quote_new(
    id: String,
    b_px: Float,
    b_sz: Float,
    a_px: Float,
    a_sz: Float,
    maker_bps: Float,
    taker_bps: Float,
    lat_ms: Float
) -> VenueQuote {
    return VenueQuote {
        venue_id: id,
        bid_price: b_px,
        bid_size: b_sz,
        ask_price: a_px,
        ask_size: a_sz,
        maker_fee_bps: maker_bps,
        taker_fee_bps: taker_bps,
        one_way_latency_ms: lat_ms,
    };
}

pub fn arb_detect_opportunity(
    venue_a: &VenueQuote,
    venue_b: &VenueQuote
) -> ArbitrageOpportunity {
    // Scenario 1: Buy on A (ask_a), Sell on B (bid_b)
    let spread_buy_a_sell_b: Float = (venue_b).bid_price - (venue_a).ask_price;
    // Scenario 2: Buy on B (ask_b), Sell on A (bid_a)
    let spread_buy_b_sell_a: Float = (venue_a).bid_price - (venue_b).ask_price;

    let mut is_a_to_b: Bool = true;
    let mut gross_spr: Float = spread_buy_a_sell_b;
    let mut buy_v: String = (venue_a).venue_id;
    let mut sell_v: String = (venue_b).venue_id;
    let mut buy_px: Float = (venue_a).ask_price;
    let mut sell_px: Float = (venue_b).bid_price;
    let mut buy_sz: Float = (venue_a).ask_size;
    let mut sell_sz: Float = (venue_b).bid_size;
    let mut total_taker_fee: Float = (venue_a).taker_fee_bps + (venue_b).taker_fee_bps;

    if spread_buy_b_sell_a > spread_buy_a_sell_b {
        is_a_to_b = false;
        gross_spr = spread_buy_b_sell_a;
        buy_v = (venue_b).venue_id;
        sell_v = (venue_a).venue_id;
        buy_px = (venue_b).ask_price;
        sell_px = (venue_a).bid_price;
        buy_sz = (venue_b).ask_size;
        sell_sz = (venue_a).bid_size;
    }

    let min_size: Float = if buy_sz < sell_sz { buy_sz } else { sell_sz };
    let fee_cost_per_share: Float = buy_px * (total_taker_fee / 10000.0);
    let net_spr: Float = gross_spr - fee_cost_per_share;
    let net_pnl: Float = net_spr * min_size;
    let prof: Bool = (net_spr > 0.0) && (min_size > 0.0);

    return ArbitrageOpportunity {
        venue_buy: buy_v,
        venue_sell: sell_v,
        buy_price: buy_px,
        sell_price: sell_px,
        executable_size: min_size,
        gross_spread: gross_spr,
        net_spread_after_fees: net_spr,
        expected_pnl: net_pnl,
        is_profitable: prof,
    };
}

pub fn arb_plan_execution(opp: &ArbitrageOpportunity, max_risk_size: Float) -> ArbExecutionPlan {
    let mut target_size: Float = (opp).executable_size;
    if target_size > max_risk_size {
        target_size = max_risk_size;
    }
    let pnl: Float = (opp).net_spread_after_fees * target_size;

    return ArbExecutionPlan {
        buy_venue: (opp).venue_buy,
        sell_venue: (opp).venue_sell,
        target_shares: target_size,
        net_pnl_usd: pnl,
        latency_advantage_ms: 0.5,
    };
}
