// # Cartea-Jaimungal Drift-Informed Market Making
//
// Logline: Computes optimal bid/ask quoting spreads incorporate short-term price drift alpha, running inventory penalty, and terminal liquidation risk.
//
// Setup: Pure high-frequency stochastic control module based on the Cartea-Jaimungal market making framework.
//
// Beats:
//   1. Define CjParams, ShortTermAlpha, and CjOptimalQuotes structures.
//   2. Calculate drift-adjusted reservation price offsetting adverse price momentum.
//   3. Compute asymmetric half-spreads to skew execution towards alpha direction.

pub type CjParams = struct {
    gamma_inventory_risk: Float,
    phi_running_penalty: Float,
    kappa_fill_intensity: Float,
    time_horizon_t: Float,
};

pub type ShortTermAlpha = struct {
    drift_alpha: Float,
    signal_confidence: Float,
    decay_rate: Float,
};

pub type CjOptimalQuotes = struct {
    mid_price: Float,
    reservation_price: Float,
    bid_spread: Float,
    ask_spread: Float,
    optimal_bid: Float,
    optimal_ask: Float,
    skew_direction: Int,
};

pub fn cj_params_new(
    gamma: Float,
    phi: Float,
    kappa: Float,
    t_horizon: Float
) -> CjParams {
    return CjParams {
        gamma_inventory_risk: gamma,
        phi_running_penalty: phi,
        kappa_fill_intensity: kappa,
        time_horizon_t: t_horizon,
    };
}

pub fn short_term_alpha_new(alpha: Float, conf: Float, decay: Float) -> ShortTermAlpha {
    return ShortTermAlpha {
        drift_alpha: alpha,
        signal_confidence: conf,
        decay_rate: decay,
    };
}

pub fn cj_compute_quotes(
    mid_price: Float,
    inventory_q: Float,
    time_remaining: Float,
    alpha: &ShortTermAlpha,
    params: &CjParams
) -> CjOptimalQuotes {
    let gamma: Float = (params).gamma_inventory_risk;
    let phi: Float = (params).phi_running_penalty;
    let kappa: Float = (params).kappa_fill_intensity;
    let drift: Float = (alpha).drift_alpha * (alpha).signal_confidence;

    // Cartea-Jaimungal drift adjustment: alpha / (2 * phi) or alpha * tau
    let drift_adjustment: Float = drift * time_remaining;
    let inventory_penalty: Float = (2.0 * inventory_q + 1.0) * sqrt(phi / (2.0 * kappa));

    // Reservation price with drift and running penalty
    let r_price: Float = mid_price + drift_adjustment - (gamma * inventory_q * time_remaining);

    // Symmetric base spread: delta_0 = 1 / kappa + sqrt(phi / (2 * kappa))
    let base_half_spread: Float = (1.0 / kappa) + (0.5 * inventory_penalty);

    // Skew spreads: when drift > 0 (bullish), quote tighter on bid, wider on ask
    let bid_spr: Float = base_half_spread - (drift_adjustment * 0.5);
    let ask_spr: Float = base_half_spread + (drift_adjustment * 0.5);

    let opt_bid: Float = r_price - bid_spr;
    let opt_ask: Float = r_price + ask_spr;

    let mut skew: Int = 0;
    if drift > 0.001 {
        skew = 1;
    } else if drift < (0.0 - 0.001) {
        skew = 0 - 1;
    }

    return CjOptimalQuotes {
        mid_price: mid_price,
        reservation_price: r_price,
        bid_spread: bid_spr,
        ask_spread: ask_spr,
        optimal_bid: opt_bid,
        optimal_ask: opt_ask,
        skew_direction: skew,
    };
}
