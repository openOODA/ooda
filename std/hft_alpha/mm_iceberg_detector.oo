// # Hidden Iceberg Order Detector
//
// Logline: Detects native exchange and synthetic broker iceberg orders by identifying repeated queue refills at identical price levels immediately upon execution.
//
// Setup: Pure high-frequency market microstructure module evaluating level-2 replenishment events and estimating hidden peak sizes.
//
// Beats:
//   1. Define IcebergDetectionState, RefillEvent, and IcebergEstimate structures.
//   2. Track consecutive queue replenishments at identical price ticks without intervening cancellations.
//   3. Estimate total hidden iceberg parent order volume and visible slice display sizes.

pub type IcebergDetectionState = struct {
    price_level: Float,
    is_buy_side: Bool,
    consecutive_refills: Int,
    display_slice_size: Float,
    cumulative_executed_volume: Float,
    last_refill_time: Float,
};

pub type RefillEvent = struct {
    timestamp: Float,
    fill_volume: Float,
    new_displayed_volume: Float,
};

pub type IcebergEstimate = struct {
    is_iceberg_confirmed: Bool,
    estimated_total_hidden_volume: Float,
    display_peak_size: Float,
    confidence_score: Float,
};

pub fn iceberg_state_new(price: Float, is_buy: Bool) -> IcebergDetectionState {
    return IcebergDetectionState {
        price_level: price,
        is_buy_side: is_buy,
        consecutive_refills: 0,
        display_slice_size: 0.0,
        cumulative_executed_volume: 0.0,
        last_refill_time: 0.0,
    };
}

pub fn iceberg_on_refill(
    state: &mut IcebergDetectionState,
    event: &RefillEvent
) -> IcebergEstimate {
    let fill_v: Float = (event).fill_volume;
    let new_disp: Float = (event).new_displayed_volume;
    let t: Float = (event).timestamp;

    (state).cumulative_executed_volume = (state).cumulative_executed_volume + fill_v;
    (state).display_slice_size = new_disp;
    (state).last_refill_time = t;
    (state).consecutive_refills = (state).consecutive_refills + 1;

    let refills: Int = (state).consecutive_refills;
    let confirmed: Bool = refills >= 3;
    let conf: Float = if refills >= 4 { 0.95 } else if refills == 3 { 0.80 } else if refills == 2 { 0.50 } else { 0.20 };

    // Standard iceberg estimation: expected remaining is 3x to 5x visible display size
    let mut est_hidden: Float = 0.0;
    if confirmed {
        est_hidden = new_disp * 4.0;
    }

    return IcebergEstimate {
        is_iceberg_confirmed: confirmed,
        estimated_total_hidden_volume: est_hidden + (state).cumulative_executed_volume,
        display_peak_size: new_disp,
        confidence_score: conf,
    };
}
