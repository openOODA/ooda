// # Alpha Signal Information Decay Tracker
//
// Logline: Models the exponential and hyperbolic information decay of predictive HFT alpha signals over millisecond horizons.
//
// Setup: Pure signal combination module tracking real-time half-life degradation and dynamic weighting.
//
// Beats:
//   1. Define AlphaSignalEntry, DecayConfig, and CombinedAlphaResult structures.
//   2. Compute time-decayed instantaneous alpha strength using exponential kernel e^(-lambda * dt).
//   3. Combine multiple asynchronous alpha signals weighted by their residual informational quality.

pub type AlphaSignalEntry = struct {
    signal_id: String,
    raw_value: Float,
    generation_time_ms: Float,
    half_life_ms: Float,
    weight: Float
};

pub type CombinedAlphaResult = struct {
    combined_signal_value: Float,
    total_effective_weight: Float,
    active_signals_count: Int
};

pub fn alpha_signal_entry_new(
    id: String,
    val: Float,
    gen_time: Float,
    half_life: Float,
    w: Float
) -> AlphaSignalEntry {
    return AlphaSignalEntry {
        signal_id: id,
        raw_value: val,
        generation_time_ms: gen_time,
        half_life_ms: half_life,
        weight: w
    };
}

pub fn alpha_compute_decayed_value(
    sig: &AlphaSignalEntry,
    current_time_ms: Float
) -> Float {
    let dt: Float = current_time_ms - (sig).generation_time_ms;
    if dt <= 0.0 {
        return (sig).raw_value;
    }
    let hl: Float = (sig).half_life_ms;
    if hl <= 0.001 {
        return 0.0;
    }
    let lambda_decay: Float = 0.693147 / hl;
    let decay_mult: Float = exp((0.0 - lambda_decay) * dt);
    return (sig).raw_value * decay_mult;
}

pub fn alpha_combine_signals(
    signals: &List[AlphaSignalEntry],
    current_time_ms: Float
) -> CombinedAlphaResult {
    let n: Int = list_len(*signals);
    let mut sum_weighted_val: Float = 0.0;
    let mut sum_weight: Float = 0.0;
    let mut active_count: Int = 0;
    let mut i: Int = 0;

    while i < n {
        let entry: AlphaSignalEntry = list_get(*signals, i);
        let decayed: Float = alpha_compute_decayed_value(&entry, current_time_ms);
        let w: Float = (entry).weight;

        let abs_d: Float = if decayed < 0.0 { 0.0 - decayed } else { decayed };
        if abs_d > 0.0001 {
            sum_weighted_val = sum_weighted_val + (decayed * w);
            sum_weight = sum_weight + w;
            active_count = active_count + 1;
        }
        i = i + 1;
    }

    let final_val: Float = if sum_weight > 0.0 { sum_weighted_val / sum_weight } else { 0.0 };

    return CombinedAlphaResult {
        combined_signal_value: final_val,
        total_effective_weight: sum_weight,
        active_signals_count: active_count
    };
}
