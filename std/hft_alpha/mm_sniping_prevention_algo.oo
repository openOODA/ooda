// # Toxic Quote Sniping Prevention and Cancellation Optimizer
//
// Logline: Protects market makers from predatory latency snipers by analyzing order cancellation speed, widening quotes during bursts, and throttling exposed limits.
//
// Setup: Pure high-frequency defense engine minimizing adverse selection during macroeconomic and toxic flow events.
//
// Beats:
//   1. Define SnipingDefenseConfig, ToxicFlowIndicator, and DefenseAction structures.
//   2. Monitor order arrival spikes and rapid consecutive fills across correlated tickers.
//   3. Trigger defensive quote widening, mass quote cancellations, and quote shading.

pub type SnipingDefenseConfig = struct {
    max_toxic_fill_rate_per_sec: Float,
    burst_window_ms: Float,
    spread_multiplier_on_alarm: Float,
    cancel_lead_time_us: Float,
};

pub type ToxicFlowIndicator = struct {
    fills_in_last_100ms: Int,
    correlated_venue_breakout: Bool,
    flow_toxicity_score: Float,
};

pub type DefenseAction = struct {
    is_sniping_detected: Bool,
    recommended_spread_multiplier: Float,
    execute_mass_cancel: Bool,
    defense_reason: String,
};

pub fn sniping_config_default() -> SnipingDefenseConfig {
    return SnipingDefenseConfig {
        max_toxic_fill_rate_per_sec: 10.0,
        burst_window_ms: 100.0,
        spread_multiplier_on_alarm: 3.0,
        cancel_lead_time_us: 15.0,
    };
}

pub fn sniping_evaluate_defense(
    indicator: &ToxicFlowIndicator,
    config: &SnipingDefenseConfig
) -> DefenseAction {
    let fills: Int = (indicator).fills_in_last_100ms;
    let breakout: Bool = (indicator).correlated_venue_breakout;
    let tox: Float = (indicator).flow_toxicity_score;

    if fills >= 4 || (breakout && tox > 0.7) {
        return DefenseAction {
            is_sniping_detected: true,
            recommended_spread_multiplier: (config).spread_multiplier_on_alarm,
            execute_mass_cancel: true,
            defense_reason: "TOXIC_BURST_MASS_CANCEL",
        };
    } else if fills >= 2 || tox > 0.5 {
        return DefenseAction {
            is_sniping_detected: true,
            recommended_spread_multiplier: 1.5,
            execute_mass_cancel: false,
            defense_reason: "WIDE_SPREAD_DEFENSE",
        };
    }

    return DefenseAction {
        is_sniping_detected: false,
        recommended_spread_multiplier: 1.0,
        execute_mass_cancel: false,
        defense_reason: "NORMAL_QUOTING",
    };
}
