// # Lee-Ready Trade Sign and Tick Rule Classifier
//
// Logline: Classifies anonymous high-frequency trade prints into buyer-initiated or seller-initiated flow using the Lee-Ready algorithm and tick rule.
//
// Setup: Pure market microstructure module evaluating price ticks and prevailing quotes to determine trade direction.
//
// Beats:
//   1. Define TradePrint, PrevailingQuote, and TradeClassification structures.
//   2. Apply quote rule: classify trades above midquote as Buy (+1) and below midquote as Sell (-1).
//   3. Fall back to tick rule for midpoint trades: uptick/zero-uptick (+1) vs downtick/zero-downtick (-1).

pub type TradePrint = struct {
    timestamp_ns: Int,
    price: Float,
    volume: Float,
};

pub type PrevailingQuote = struct {
    bid_price: Float,
    ask_price: Float,
};

pub type TradeClassification = struct {
    trade_sign: Int,
    is_buyer_initiated: Bool,
    classification_method: Int,
    price_to_mid_bps: Float,
};

pub fn tick_rule_classify(
    trade: &TradePrint,
    prev_trade_price: Float,
    prev_trade_sign: Int,
    quote: &PrevailingQuote
) -> TradeClassification {
    let px: Float = (trade).price;
    let bid: Float = (quote).bid_price;
    let ask: Float = (quote).ask_price;
    let mid: Float = (bid + ask) * 0.5;

    let mut sign: Int = 0;
    let mut method: Int = 0;

    // 1. Quote rule test
    if px > mid {
        sign = 1;
        method = 1; // 1 = Quote rule Buy
    } else if px < mid {
        sign = 0 - 1;
        method = 2; // 2 = Quote rule Sell
    } else {
        // 2. Tick rule fallback (at mid)
        if px > prev_trade_price {
            sign = 1;
            method = 3; // 3 = Uptick
        } else if px < prev_trade_price {
            sign = 0 - 1;
            method = 4; // 4 = Downtick
        } else {
            // Zero-tick: carry forward previous trade sign
            sign = prev_trade_sign;
            method = 5; // 5 = Zero-tick
        }
    }

    let is_buy: Bool = sign > 0;
    let px_diff: Float = px - mid;
    let bps: Float = if mid > 0.0 { (px_diff / mid) * 10000.0 } else { 0.0 };

    return TradeClassification {
        trade_sign: sign,
        is_buyer_initiated: is_buy,
        classification_method: method,
        price_to_mid_bps: bps,
    };
}
