// # Relational SQL Query Planner and Optimizer
//
// Logline: Generates optimized physical execution plans, index scans, cost models, and EXPLAIN summaries.
//
// Setup: Pure query planner transforming AST statements into relational operator trees.
//
// Beats:
//   1. Define execution plan nodes, scan operators, and filter predicates.
//   2. Transform AST statements into sequential or index-assisted execution plans.
//   3. Compute cost estimates and format human-readable query plan summaries.

import "./sql_ast.oo";

type PlanNode = struct {
    kind: Int,
    table_name: String,
    columns: List[String],
    filters: List[SqlBinaryOp],
    index_name: String,
    estimated_cost: Int,
    estimated_rows: Int,
    limit_val: Int,
    order_col: String,
    order_desc: Bool
};

type ExecutionPlan = struct {
    root_node: PlanNode,
    statement_kind: Int,
    total_cost: Int,
    explain_summary: String
};

pub fn sql_plan_node_create(kind: Int, table: String) -> PlanNode {
    let empty_cols: List[String] = list_new();
    let empty_filters: List[SqlBinaryOp] = list_new();
    return PlanNode {
        kind: kind,
        table_name: table,
        columns: empty_cols,
        filters: empty_filters,
        index_name: "",
        estimated_cost: 10,
        estimated_rows: 100,
        limit_val: -1,
        order_col: "",
        order_desc: false
    };
}

pub fn sql_create_plan(stmt: &SqlStatement) -> ExecutionPlan {
    let k: Int = (stmt).kind;

    if k == 1 {
        let sel: SqlSelectStmt = (stmt).select_stmt;
        let mut node: PlanNode = sql_plan_node_create(1, (sel).table_name);
        node.columns = (sel).columns;
        node.filters = (sel).where_clause;
        node.limit_val = (sel).limit_val;

        let num_filters: Int = list_len((sel).where_clause);
        let cost: Int = 100 + num_filters * 10;
        node.estimated_cost = cost;

        let summary: String = "SeqScan on " + (sel).table_name + " (cost=" + cost.to_string() + ")";
        return ExecutionPlan {
            root_node: node,
            statement_kind: 1,
            total_cost: cost,
            explain_summary: summary
        };
    }

    if k == 2 {
        let ins: SqlInsertStmt = (stmt).insert_stmt;
        let mut node2: PlanNode = sql_plan_node_create(7, (ins).table_name);
        node2.columns = (ins).columns;
        let summary2: String = "Insert into " + (ins).table_name;
        return ExecutionPlan {
            root_node: node2,
            statement_kind: 2,
            total_cost: 10,
            explain_summary: summary2
        };
    }

    let default_node: PlanNode = sql_plan_node_create(0, "default");
    return ExecutionPlan {
        root_node: default_node,
        statement_kind: 0,
        total_cost: 0,
        explain_summary: "NoOp"
    };
}

pub fn sql_plan_optimize_index(
    plan: &mut ExecutionPlan,
    indexed_cols: List[String]
) -> Bool {
    let filters: List[SqlBinaryOp] = (plan).root_node.filters;
    let n_f: Int = list_len(filters);
    let n_idx: Int = list_len(indexed_cols);
    let mut i: Int = 0;

    while i < n_f {
        let f: SqlBinaryOp = list_get(filters, i);
        let mut j: Int = 0;
        while j < n_idx {
            let idx_col: String = list_get(indexed_cols, j);
            if (f).left_field == idx_col {
                (plan).root_node.kind = 2; // PLAN_INDEX_SCAN
                (plan).root_node.index_name = "idx_" + (plan).root_node.table_name + "_" + idx_col;
                (plan).root_node.estimated_cost = 5;
                (plan).total_cost = 5;
                (plan).explain_summary = "IndexScan using " + (plan).root_node.index_name;
                return true;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    return false;
}

pub fn sql_plan_explain(plan: &ExecutionPlan) -> String {
    return (plan).explain_summary;
}
