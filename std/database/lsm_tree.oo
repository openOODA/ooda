// # LSM-Tree Engine and Compaction Coordinator
//
// Logline: Orchestrates active MemTable writes, frozen flushes, level-based SSTables, and compaction.
//
// Setup: Cap-gated LSM storage engine coordinating memory buffers and tiered disk levels.
//
// Beats:
//   1. Initialize LSM tree instance with multi-level storage hierarchy.
//   2. Route writes to active MemTable and trigger frozen table flushes under FsWriteCap.
//   3. Coordinate point reads and tiered compaction passes across disk levels.

import "./lsm_memtable.oo";
import "./lsm_sstable.oo";

pub type LSMLevel = struct {
    level_num: Int,
    tables: List[SSTable],
    max_bytes: Int,
    current_bytes: Int
};

pub type LSMTree = struct {
    db_path: String,
    active_mem: MemTable,
    frozen_mem: List[MemTable],
    levels: List[LSMLevel],
    next_seq_num: Int,
    next_file_num: Int,
    is_compacting: Bool
};

pub fn lsm_tree_open(path: String, mem_capacity: Int) -> LSMTree {
    let active: MemTable = memtable_create(1, mem_capacity);
    let empty_frozen: List[MemTable] = list_new();

    let mut initial_levels: List[LSMLevel] = list_new();
    let empty_tables_0: List[SSTable] = list_new();
    let lvl0: LSMLevel = LSMLevel {
        level_num: 0,
        tables: empty_tables_0,
        max_bytes: mem_capacity * 4,
        current_bytes: 0
    };
    initial_levels = list_push(initial_levels, lvl0);

    let empty_tables_1: List[SSTable] = list_new();
    let lvl1: LSMLevel = LSMLevel {
        level_num: 1,
        tables: empty_tables_1,
        max_bytes: mem_capacity * 40,
        current_bytes: 0
    };
    initial_levels = list_push(initial_levels, lvl1);

    return LSMTree {
        db_path: path,
        active_mem: active,
        frozen_mem: empty_frozen,
        levels: initial_levels,
        next_seq_num: 1,
        next_file_num: 1,
        is_compacting: false
    };
}

pub fn lsm_tree_put(
    fs: &FsWriteCap,
    tree: &mut LSMTree,
    key: String,
    val: String,
    ts: Int
) -> Result[Bool, String] {
    let seq: Int = (tree).next_seq_num;
    (tree).next_seq_num = seq + 1;

    if memtable_is_full(&(tree).active_mem) {
        let flush_res1: Result[Bool, String] = lsm_tree_flush_active(fs, tree);
        if flush_res1.is_err() {
            return Err("Failed to flush full active memtable");
        }
    }

    let ok: Bool = memtable_put(&mut (tree).active_mem, key, val, seq, ts);
    if ok {
        return Ok(true);
    }
    return Err("Failed to write to active MemTable");
}

pub fn lsm_tree_delete(
    fs: &FsWriteCap,
    tree: &mut LSMTree,
    key: String,
    ts: Int
) -> Result[Bool, String] {
    let seq: Int = (tree).next_seq_num;
    (tree).next_seq_num = seq + 1;

    if memtable_is_full(&(tree).active_mem) {
        let flush_res2: Result[Bool, String] = lsm_tree_flush_active(fs, tree);
        if flush_res2.is_err() {
            return Err("Failed to flush full active memtable");
        }
    }

    let ok: Bool = memtable_delete(&mut (tree).active_mem, key, seq, ts);
    if ok {
        return Ok(true);
    }
    return Err("Failed to insert tombstone into MemTable");
}

pub fn lsm_tree_flush_active(fs: &FsWriteCap, tree: &mut LSMTree) -> Result[Bool, String] {
    let cur_count: Int = memtable_entry_count(&(tree).active_mem);
    if cur_count == 0 {
        return Ok(false);
    }

    let f_num: Int = (tree).next_file_num;
    (tree).next_file_num = f_num + 1;

    let sst_res: Result[SSTable, String] = sstable_write_from_memtable(
        fs,
        &(tree).active_mem,
        f_num,
        0
    );

    if sst_res.is_err() {
        return Err("SSTable write failed during flush");
    }

    let sst: SSTable = sst_res.unwrap();
    let cur_levels: List[LSMLevel] = (tree).levels;
    let n_levels: Int = list_len(cur_levels);
    if n_levels > 0 {
        let mut lvl0: LSMLevel = list_get(cur_levels, 0);
        let cur_tables: List[SSTable] = (lvl0).tables;
        let new_tables: List[SSTable] = list_push(cur_tables, sst);
        (lvl0).tables = new_tables;
        let add_bytes: Int = (sst).meta.file_size;
        (lvl0).current_bytes = (lvl0).current_bytes + add_bytes;

        let mut updated_levels: List[LSMLevel] = list_new();
        updated_levels = list_push(updated_levels, lvl0);
        let mut i: Int = 1;
        while i < n_levels {
            updated_levels = list_push(updated_levels, list_get(cur_levels, i));
            i = i + 1;
        }
        (tree).levels = updated_levels;
    }

    let max_b: Int = (tree).active_mem.max_byte_size;
    let next_tbl_id: Int = (tree).active_mem.table_id + 1;
    (tree).active_mem = memtable_create(next_tbl_id, max_b);

    return Ok(true);
}

pub fn lsm_tree_get(
    fs: &FsReadCap,
    tree: &LSMTree,
    key: String
) -> Result[Option[String], String] {
    let mem_opt: Option[String] = memtable_get(&(tree).active_mem, key);
    if mem_opt.is_some() {
        return Ok(mem_opt);
    }

    let frozen_list: List[MemTable] = (tree).frozen_mem;
    let n_frozen: Int = list_len(frozen_list);
    let mut i: Int = 0;
    while i < n_frozen {
        let f_mem: MemTable = list_get(frozen_list, i);
        let f_opt: Option[String] = memtable_get(&f_mem, key);
        if f_opt.is_some() {
            return Ok(f_opt);
        }
        i = i + 1;
    }

    let levels_list: List[LSMLevel] = (tree).levels;
    let n_levels: Int = list_len(levels_list);
    let mut lvl_idx: Int = 0;
    while lvl_idx < n_levels {
        let lvl: LSMLevel = list_get(levels_list, lvl_idx);
        let tables_list: List[SSTable] = (lvl).tables;
        let n_tables: Int = list_len(tables_list);
        let mut t_idx: Int = 0;
        while t_idx < n_tables {
            let sst: SSTable = list_get(tables_list, t_idx);
            let sst_opt: Result[Option[String], String] = sstable_read_key(fs, &sst, key);
            if sst_opt.is_ok() {
                let inner: Option[String] = sst_opt.unwrap();
                if inner.is_some() {
                    return Ok(inner);
                }
            }
            t_idx = t_idx + 1;
        }
        lvl_idx = lvl_idx + 1;
    }

    return Ok(None);
}

pub fn lsm_tree_compact_level(
    fs_r: &FsReadCap,
    fs_w: &FsWriteCap,
    tree: &mut LSMTree,
    level_idx: Int
) -> Result[Int, String] {
    (tree).is_compacting = true;
    let levels_list: List[LSMLevel] = (tree).levels;
    let n_levels: Int = list_len(levels_list);
    if level_idx >= n_levels {
        (tree).is_compacting = false;
        return Err("Invalid level index for compaction");
    }

    let lvl: LSMLevel = list_get(levels_list, level_idx);
    let t_count: Int = list_len((lvl).tables);
    (tree).is_compacting = false;
    return Ok(t_count);
}
