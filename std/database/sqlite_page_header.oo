// # SQLite v3 B-tree page header
//
// Logline: Decodes an 8-byte big-endian SQLite B-tree page header and rejects unknown page types.
//
// Setup: Pure. Bytes are List[Int] 0..255. Content offset 0 means 65536.
//
// Beats:
//   1. Require at least 8 bytes.
//   2. Accept page types 2, 5, 10, and 13 only.
//   3. Read freeblock offset, cell count, content offset, and fragments.
//   4. Map a zero content offset to 65536.

pub type SqliteHdr = struct {
    flag: Int,
    err: String,
    ptype: Int,
    freeblock: Int,
    cells: Int,
    content: Int,
    frag: Int
};

fn sqlite_be16(buf: List[Int], o: Int) -> Int {
    return list_get(buf, o) * 256 + list_get(buf, o + 1);
}

pub fn sqlite_page_header_parse(buf: List[Int]) -> SqliteHdr {
    if list_len(buf) < 8 {
        return SqliteHdr { flag: 0, err: "sqlite short", ptype: 0, freeblock: 0, cells: 0, content: 0, frag: 0 };
    }
    let pt: Int = list_get(buf, 0);
    if pt == 2 {
        return sqlite_ok(buf, pt);
    }
    if pt == 5 {
        return sqlite_ok(buf, pt);
    }
    if pt == 10 {
        return sqlite_ok(buf, pt);
    }
    if pt == 13 {
        return sqlite_ok(buf, pt);
    }
    return SqliteHdr { flag: 0, err: "sqlite type", ptype: pt, freeblock: 0, cells: 0, content: 0, frag: 0 };
}

fn sqlite_ok(buf: List[Int], pt: Int) -> SqliteHdr {
    let fb: Int = sqlite_be16(buf, 1);
    let cells: Int = sqlite_be16(buf, 3);
    let mut off: Int = sqlite_be16(buf, 5);
    if off == 0 {
        off = 65536;
    }
    let fr: Int = list_get(buf, 7);
    return SqliteHdr { flag: 1, err: "", ptype: pt, freeblock: fb, cells: cells, content: off, frag: fr };
}

pub fn sqlite_page_header_stat(h: SqliteHdr) -> Result[Int, String] {
    if h.flag < 1 {
        return Err(h.err);
    }
    return Ok(h.ptype);
}
