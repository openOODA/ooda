// # Vector Math and Cosine Distance
//
// Logline: Implements fixed-point dot product, magnitude, integer square root, and cosine similarity distance.
//
// Setup: Pure fixed-point vector arithmetic library scaled by 10,000 for database embeddings.
//
// Beats:
//   1. Define fixed-point vector structures and dimensionality bounds.
//   2. Compute dot products, squared norms, and integer square roots.
//   3. Calculate normalized cosine similarity and euclidean distance metrics.

type VectorFloat = struct {
    dim: Int,
    components: List[Int]
};

pub fn vector_create(components: List[Int]) -> VectorFloat {
    let d: Int = list_len(components);
    return VectorFloat {
        dim: d,
        components: components
    };
}

pub fn vector_dot_product(a: VectorFloat, b: VectorFloat) -> Int {
    let d_a: Int = a.dim;
    let d_b: Int = b.dim;
    let mut min_d: Int = d_a;
    if d_b < min_d {
        min_d = d_b;
    }

    let comp_a: List[Int] = a.components;
    let comp_b: List[Int] = b.components;
    let mut total: Int = 0;
    let mut i: Int = 0;

    while i < min_d {
        let val_a: Int = list_get(comp_a, i);
        let val_b: Int = list_get(comp_b, i);
        total = total + (val_a * val_b);
        i = i + 1;
    }

    return total;
}

pub fn vector_norm_sq(v: VectorFloat) -> Int {
    return vector_dot_product(v, v);
}

pub fn vector_isqrt(n: Int) -> Int {
    if n <= 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }

    let mut x0: Int = n / 2;
    if x0 > 65536 {
        x0 = 65536;
    }
    let mut x1: Int = (x0 + n / x0) / 2;

    while x1 < x0 {
        x0 = x1;
        x1 = (x0 + n / x0) / 2;
    }

    return x0;
}

pub fn vector_magnitude(v: VectorFloat) -> Int {
    let sq: Int = vector_norm_sq(v);
    return vector_isqrt(sq);
}

pub fn vector_cosine_similarity(a: VectorFloat, b: VectorFloat) -> Int {
    let dot: Int = vector_dot_product(a, b);
    let mag_a: Int = vector_magnitude(a);
    let mag_b: Int = vector_magnitude(b);

    if mag_a == 0 || mag_b == 0 {
        return 0;
    }

    let denom: Int = mag_a * mag_b;
    let scaled_dot: Int = dot * 10000;
    return scaled_dot / denom;
}

pub fn vector_cosine_distance(a: VectorFloat, b: VectorFloat) -> Int {
    let sim: Int = vector_cosine_similarity(a, b);
    return 10000 - sim;
}

pub fn vector_euclidean_distance_sq(a: VectorFloat, b: VectorFloat) -> Int {
    let d_a: Int = a.dim;
    let d_b: Int = b.dim;
    let mut min_d: Int = d_a;
    if d_b < min_d {
        min_d = d_b;
    }

    let comp_a: List[Int] = a.components;
    let comp_b: List[Int] = b.components;
    let mut total: Int = 0;
    let mut i: Int = 0;

    while i < min_d {
        let diff: Int = list_get(comp_a, i) - list_get(comp_b, i);
        total = total + (diff * diff);
        i = i + 1;
    }

    return total;
}
