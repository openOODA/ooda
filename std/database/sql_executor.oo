// # SQL Relational Execution Engine
//
// Logline: Executes physical query plans against catalog tables, evaluating filters and producing row sets.
//
// Setup: Pure relational query execution engine over memory catalog tables.
//
// Beats:
//   1. Define database row records, catalog tables, and query execution results.
//   2. Evaluate filter predicates, projections, and row insertions against schemas.
//   3. Execute physical plans and return structured query result batches.

import "./sql_ast.oo";
import "./sql_planner.oo";

pub type DbRow = struct {
    row_id: Int,
    values: List[String],
};

pub type DbTable = struct {
    table_name: String,
    columns: List[String],
    rows: List[DbRow],
    next_row_id: Int,
};

pub type DbCatalog = struct {
    tables: List[DbTable],
};

pub type DbQueryResult = struct {
    columns: List[String],
    rows: List[DbRow],
    rows_affected: Int,
    execution_time_ms: Int,
    success: Bool,
    error_msg: String,
};

pub fn db_catalog_create() -> DbCatalog {
    let empty_tables: List[DbTable] = list_new();
    return DbCatalog {
        tables: empty_tables,
    };
}

pub fn db_catalog_add_table(
    cat: &mut DbCatalog,
    table_name: String,
    columns: List[String]
) {
    let empty_rows: List[DbRow] = list_new();
    let tbl: DbTable = DbTable {
        table_name: table_name,
        columns: columns,
        rows: empty_rows,
        next_row_id: 1,
    };
    let cur_tables: List[DbTable] = (cat).tables;
    let new_tables: List[DbTable] = list_push(cur_tables, tbl);
    (cat).tables = new_tables;
}

pub fn db_catalog_find_table(cat: &DbCatalog, table_name: String) -> Option[DbTable] {
    let tbls: List[DbTable] = (cat).tables;
    let n: Int = list_len(tbls);
    let mut i: Int = 0;
    while i < n {
        let t: DbTable = list_get(tbls, i);
        if (t).table_name == table_name {
            return Some(t);
        }
        i = i + 1;
    }
    return None;
}

pub fn sql_row_matches_filters(
    row: &DbRow,
    cols: List[String],
    filters: List[SqlBinaryOp]
) -> Bool {
    let n_f: Int = list_len(filters);
    if n_f == 0 {
        return true;
    }

    let n_c: Int = list_len(cols);
    let mut i: Int = 0;
    while i < n_f {
        let f: SqlBinaryOp = list_get(filters, i);
        let field: String = (f).left_field;
        let expected: String = (f).right_val;

        let mut col_idx: Int = -1;
        let mut j: Int = 0;
        while j < n_c {
            if list_get(cols, j) == field {
                col_idx = j;
            }
            j = j + 1;
        }

        if col_idx >= 0 {
            let row_val: String = list_get((row).values, col_idx);
            if (f).op == "=" {
                if row_val != expected {
                    return false;
                }
            } else if (f).op == "!=" {
                if row_val == expected {
                    return false;
                }
            }
        }
        i = i + 1;
    }

    return true;
}

pub fn sql_execute_plan(
    cat: &mut DbCatalog,
    plan: &ExecutionPlan,
    now: Int
) -> DbQueryResult {
    let stmt_k: Int = (plan).statement_kind;
    let empty_rows: List[DbRow] = list_new();
    let empty_cols: List[String] = list_new();

    if stmt_k == 1 { // SELECT
        let node: PlanNode = (plan).root_node;
        let tbl_opt: Option[DbTable] = db_catalog_find_table(cat, (node).table_name);
        if tbl_opt.is_none() {
            return DbQueryResult {
                columns: empty_cols,
                rows: empty_rows,
                rows_affected: 0,
                execution_time_ms: 1,
                success: false,
                error_msg: "Table not found: " + (node).table_name,
            };
        }

        let tbl: DbTable = tbl_opt.unwrap();
        let tbl_rows: List[DbRow] = (tbl).rows;
        let n_r: Int = list_len(tbl_rows);
        let mut out_rows: List[DbRow] = list_new();
        let mut i: Int = 0;

        while i < n_r {
            let r: DbRow = list_get(tbl_rows, i);
            let matches: Bool = sql_row_matches_filters(&r, (tbl).columns, (node).filters);
            if matches {
                out_rows = list_push(out_rows, r);
            }
            i = i + 1;
        }

        let res_count: Int = list_len(out_rows);
        return DbQueryResult {
            columns: (node).columns,
            rows: out_rows,
            rows_affected: res_count,
            execution_time_ms: 1,
            success: true,
            error_msg: "",
        };
    }

    return DbQueryResult {
        columns: empty_cols,
        rows: empty_rows,
        rows_affected: 0,
        execution_time_ms: 0,
        success: true,
        error_msg: "",
    };
}
