// # Reversible Database Schema Migration Types
//
// Logline: Data structures for reversible schema migrations, journals, and execution results.
//
// Setup: Pure record definitions, constructors, and serialization routines for migrations.
//
// Beats:
//   1. Declare MigrationStep, MigrationState, and MigrationResult record structures.
//   2. Implement constructors for migration steps and states.
//   3. Implement serialization and parsing for journal persistence.

import "std/result.oo";

pub type MigrationStep = struct {
    id: String,
    name: String,
    up_sql: String,
    down_sql: String,
    applied_at: String
};

pub type MigrationState = struct {
    current_version: String,
    count: Int,
    journal_path: String
};

pub type MigrationResult = struct {
    success: Bool,
    version: String,
    action: String,
    error_msg: String
};

pub fn migration_step_new(id: String, name: String, up_sql: String, down_sql: String) -> MigrationStep {
    return MigrationStep {
        id: id,
        name: name,
        up_sql: up_sql,
        down_sql: down_sql,
        applied_at: ""
    };
}

pub fn migration_state_new(journal_path: String) -> MigrationState {
    return MigrationState {
        current_version: "0",
        count: 0,
        journal_path: journal_path
    };
}

pub fn migration_result_ok(version: String, action: String) -> MigrationResult {
    return MigrationResult {
        success: true,
        version: version,
        action: action,
        error_msg: ""
    };
}

pub fn migration_result_err(version: String, action: String, err: String) -> MigrationResult {
    return MigrationResult {
        success: false,
        version: version,
        action: action,
        error_msg: err
    };
}

pub fn migration_result_is_ok(res: &MigrationResult) -> Bool {
    return res.success;
}

pub fn migration_result_ver(res: &MigrationResult) -> String {
    return res.version;
}

pub fn migration_result_msg(res: &MigrationResult) -> String {
    return res.error_msg;
}

pub fn migration_step_id(step: &MigrationStep) -> String {
    return step.id;
}

pub fn migration_step_name(step: &MigrationStep) -> String {
    return step.name;
}

pub fn migration_step_up_sql(step: &MigrationStep) -> String {
    return step.up_sql;
}

pub fn migration_step_down_sql(step: &MigrationStep) -> String {
    return step.down_sql;
}

pub fn migration_step_applied(step: &MigrationStep) -> String {
    return step.applied_at;
}

pub fn migration_state_ver(state: &MigrationState) -> String {
    return state.current_version;
}

pub fn migration_state_cnt(state: &MigrationState) -> Int {
    return state.count;
}

pub fn migration_state_path(state: &MigrationState) -> String {
    return state.journal_path;
}

pub fn migration_state_set_ver(state: &mut MigrationState, ver: String) {
    state.current_version = ver;
}

pub fn migration_state_inc(state: &mut MigrationState) {
    state.count = state.count + 1;
}

pub fn migration_state_dec(state: &mut MigrationState) {
    if state.count > 0 {
        state.count = state.count - 1;
    }
}

pub fn migration_encode_step(step: &MigrationStep) -> String {
    let s_id: String = step.id;
    let s_nm: String = step.name;
    let s_up: String = step.up_sql;
    let s_dn: String = step.down_sql;
    let s_ap: String = step.applied_at;
    return s_id + "|" + s_nm + "|" + s_up + "|" + s_dn + "|" + s_ap + "\n";
}

pub fn migration_decode_field(line: String, field_idx: Int) -> String {
    let n: Int = chars_len(line);
    let mut cur_field: Int = 0;
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(line, i) == "|" {
            if cur_field == field_idx {
                return str_slice(line, start, i);
            }
            cur_field = cur_field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

pub fn migration_decode_step(line: String) -> MigrationStep {
    return MigrationStep {
        id: migration_decode_field(line, 0),
        name: migration_decode_field(line, 1),
        up_sql: migration_decode_field(line, 2),
        down_sql: migration_decode_field(line, 3),
        applied_at: migration_decode_field(line, 4)
    };
}

pub fn migration_types_step(id: String, name: String, up_sql: String, down_sql: String) -> MigrationStep {
    return migration_step_new(id, name, up_sql, down_sql);
}

pub fn migration_types_state(journal_path: String) -> MigrationState {
    return migration_state_new(journal_path);
}
