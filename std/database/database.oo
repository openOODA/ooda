// # Database and Storage Engine Unified Facade
//
// Logline: Re-exports B+ Tree, LSM-Tree, WAL, Page Cache, Buffer Pool, MVCC, SQL, Indexing, Vector ANN, and Wire Protocols.
//
// Setup: Pure module shim and facade importing all companion database submodules.
//
// Beats:
//   1. Import 24 modular Database and Storage engine subcomponents.
//   2. Re-export public constructors, capability-gated interfaces, and protocol entry points.
//   3. Maintain full compatibility with downstream openOODA database callers.

import "./btree_disk_types.oo";
import "./btree_disk_ops.oo";
import "./btree_disk_engine.oo";
import "./lsm_memtable.oo";
import "./lsm_sstable.oo";
import "./lsm_tree.oo";
import "./wal_writer.oo";
import "./wal_recovery.oo";
import "./page_cache.oo";
import "./buffer_pool.oo";
import "./mvcc_tx.oo";
import "./mvcc_engine.oo";
import "./sql_lexer.oo";
import "./sql_ast.oo";
import "./sql_parser.oo";
import "./sql_planner.oo";
import "./sql_executor.oo";
import "./index_btree.oo";
import "./index_hash.oo";
import "./vector_cosine.oo";
import "./vector_index_hnsw.oo";
import "./redis_wire.oo";
import "./postgres_wire.oo";
import "./db_stubs.oo";

pub fn db_shim_btree_init(path: String, max_degree: Int) -> BTreeDiskEngine {
    return btree_engine_init(path, max_degree);
}

pub fn db_shim_lsm_open(path: String, mem_capacity: Int) -> LSMTree {
    return lsm_tree_open(path, mem_capacity);
}

pub fn db_shim_wal_writer(log_dir: String, max_size: Int) -> WalWriter {
    let cfg: WalWriterConfig = WalWriterConfig {
        log_dir: log_dir,
        max_segment_size: max_size,
        sync_on_write: false,
        buffer_capacity: 1024,
    };
    return wal_writer_create(cfg);
}

pub fn db_shim_buffer_pool(size: Int, page_size: Int) -> BufferPoolManager {
    return buffer_pool_manager_create(size, page_size);
}

pub fn db_shim_mvcc_init() -> MvccEngine {
    return mvcc_engine_init();
}

pub fn db_shim_sql_parse(query: String) -> Result[SqlStatement, String] {
    return sql_parse_query(query);
}

pub fn db_shim_btree_index(name: String, table: String, col: String) -> BTreeIndex {
    return btree_index_create(name, table, col, 16);
}

pub fn db_shim_hash_index(name: String, table: String, col: String) -> HashIndex {
    return hash_index_create(name, table, col, 4);
}

pub fn db_shim_vector_cosine(a: &VectorFloat, b: &VectorFloat) -> Int {
    return vector_cosine_similarity(a, b);
}

pub fn db_shim_hnsw_init(dim: Int) -> HnswIndex {
    let cfg: HnswConfig = HnswConfig {
        dim: dim,
        m_max: 16,
        ef_construction: 64,
        ef_search: 32,
        max_layers: 4,
    };
    return hnsw_index_create(cfg);
}

pub fn db_shim_redis_process(
    net: &NetCap,
    conn: &mut RedisConnection,
    pkt: String
) -> Result[String, String] {
    return redis_process_wire_packet(net, conn, pkt);
}

pub fn db_shim_pg_process(
    net: &NetCap,
    sess: &mut PgSession,
    query: String
) -> Result[List[PgPacket], String] {
    return pg_session_handle_query(net, sess, query);
}

pub fn db_shim_fail_closed_direct_io(sys: &SysCap) -> Int {
    return db_direct_io_raw_read_sector(sys, 0, 0, 0);
}
