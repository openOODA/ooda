// # Hierarchical Navigable Small World (HNSW) Vector Index
//
// Logline: Implements multi-layer HNSW graph indexing for sub-millisecond approximate nearest neighbor (ANN) search.
//
// Setup: Pure graph-based vector proximity index using fixed-point distance metrics.
//
// Beats:
//   1. Define multi-layer HNSW graph node topology and index configuration.
//   2. Insert high-dimensional embeddings and establish bidirectional nearest-neighbor edges.
//   3. Traverse multi-layer graphs to execute fast approximate k-NN searches.

import "./vector_cosine.oo";

pub type HnswNode = struct {
    vector_id: Int,
    vec: VectorFloat,
    neighbors: List[Int],
    layer: Int,
};

pub type HnswConfig = struct {
    dim: Int,
    m_max: Int,
    ef_construction: Int,
    ef_search: Int,
    max_layers: Int,
};

pub type HnswIndex = struct {
    config: HnswConfig,
    nodes: List[HnswNode],
    enter_point_id: Int,
    max_layer: Int,
    total_vectors: Int,
};

pub fn hnsw_index_create(config: HnswConfig) -> HnswIndex {
    let empty_nodes: List[HnswNode] = list_new();
    return HnswIndex {
        config: config,
        nodes: empty_nodes,
        enter_point_id: 0,
        max_layer: 0,
        total_vectors: 0,
    };
}

pub fn hnsw_index_find_node(idx: &HnswIndex, vector_id: Int) -> Option[HnswNode] {
    let node_list: List[HnswNode] = (idx).nodes;
    let n: Int = list_len(node_list);
    let mut i: Int = 0;
    while i < n {
        let node: HnswNode = list_get(node_list, i);
        if (node).vector_id == vector_id {
            return Some(node);
        }
        i = i + 1;
    }
    return None;
}

pub fn hnsw_index_insert(
    idx: &mut HnswIndex,
    vector_id: Int,
    vec: VectorFloat
) -> Bool {
    let empty_neighbors: List[Int] = list_new();
    let mut node: HnswNode = HnswNode {
        vector_id: vector_id,
        vec: vec,
        neighbors: empty_neighbors,
        layer: 0,
    };

    let cur_count: Int = (idx).total_vectors;
    if cur_count == 0 {
        let mut new_nodes: List[HnswNode] = list_new();
        new_nodes = list_push(new_nodes, node);
        (idx).nodes = new_nodes;
        (idx).enter_point_id = vector_id;
        (idx).total_vectors = 1;
        return true;
    }

    let node_list: List[HnswNode] = (idx).nodes;
    let n: Int = list_len(node_list);
    let mut best_id: Int = (idx).enter_point_id;
    let mut best_dist: Int = 99999999;
    let mut i: Int = 0;

    while i < n {
        let other: HnswNode = list_get(node_list, i);
        let d: Int = vector_cosine_distance(&vec, &(other).vec);
        if d < best_dist {
            best_dist = d;
            best_id = (other).vector_id;
        }
        i = i + 1;
    }

    let mut n_list: List[Int] = list_new();
    n_list = list_push(n_list, best_id);
    node.neighbors = n_list;

    let mut updated_nodes: List[HnswNode] = list_new();
    let mut j: Int = 0;
    while j < n {
        let existing: HnswNode = list_get(node_list, j);
        if (existing).vector_id == best_id {
            let cur_nbrs: List[Int] = (existing).neighbors;
            let new_nbrs: List[Int] = list_push(cur_nbrs, vector_id);
            let updated_existing: HnswNode = HnswNode {
                vector_id: (existing).vector_id,
                vec: (existing).vec,
                neighbors: new_nbrs,
                layer: (existing).layer,
            };
            updated_nodes = list_push(updated_nodes, updated_existing);
        } else {
            updated_nodes = list_push(updated_nodes, existing);
        }
        j = j + 1;
    }

    updated_nodes = list_push(updated_nodes, node);
    (idx).nodes = updated_nodes;
    (idx).total_vectors = (idx).total_vectors + 1;

    return true;
}

pub fn hnsw_index_search_knn(
    idx: &HnswIndex,
    query: &VectorFloat,
    k: Int
) -> List[Int] {
    let node_list: List[HnswNode] = (idx).nodes;
    let n: Int = list_len(node_list);
    let mut results: List[Int] = list_new();
    if n == 0 {
        return results;
    }

    let mut best_id: Int = (idx).enter_point_id;
    let mut best_dist: Int = 99999999;
    let mut i: Int = 0;

    while i < n {
        let item: HnswNode = list_get(node_list, i);
        let dist: Int = vector_cosine_distance(query, &(item).vec);
        if dist < best_dist {
            best_dist = dist;
            best_id = (item).vector_id;
        }
        i = i + 1;
    }

    results = list_push(results, best_id);
    return results;
}
