// # SQL Lexer and Tokenizer
//
// Logline: Converts raw SQL query strings into a structured stream of typed lexical tokens.
//
// Setup: Pure lexical scanner for relational SQL query statements.
//
// Beats:
//   1. Define SQL token categories, lexemes, and source position records.
//   2. Scan identifiers, keywords, numbers, string literals, and punctuation.
//   3. Produce ordered token lists for downstream recursive-descent parsing.

type SqlToken = struct {
    token_type: Int,
    lexeme: String,
    pos: Int,
    line: Int,
    col: Int
};

type SqlLexer = struct {
    input: String,
    pos: Int,
    length: Int,
    line: Int,
    col: Int
};

pub fn sql_token_create(
    t: Int,
    lex: String,
    pos: Int,
    line: Int,
    col: Int
) -> SqlToken {
    return SqlToken {
        token_type: t,
        lexeme: lex,
        pos: pos,
        line: line,
        col: col
    };
}

pub fn sql_lexer_create(query: String) -> SqlLexer {
    let len: Int = query.len();
    return SqlLexer {
        input: query,
        pos: 0,
        length: len,
        line: 1,
        col: 1
    };
}

pub fn sql_is_keyword(ident: String) -> Bool {
    if ident == "SELECT" || ident == "select" { return true; }
    if ident == "FROM" || ident == "from" { return true; }
    if ident == "WHERE" || ident == "where" { return true; }
    if ident == "INSERT" || ident == "insert" { return true; }
    if ident == "INTO" || ident == "into" { return true; }
    if ident == "VALUES" || ident == "values" { return true; }
    if ident == "UPDATE" || ident == "update" { return true; }
    if ident == "SET" || ident == "set" { return true; }
    if ident == "DELETE" || ident == "delete" { return true; }
    if ident == "CREATE" || ident == "create" { return true; }
    if ident == "TABLE" || ident == "table" { return true; }
    if ident == "INT" || ident == "int" { return true; }
    if ident == "TEXT" || ident == "text" { return true; }
    if ident == "VARCHAR" || ident == "varchar" { return true; }
    if ident == "PRIMARY" || ident == "primary" { return true; }
    if ident == "KEY" || ident == "key" { return true; }
    if ident == "AND" || ident == "and" { return true; }
    if ident == "OR" || ident == "or" { return true; }
    if ident == "LIMIT" || ident == "limit" { return true; }
    if ident == "OFFSET" || ident == "offset" { return true; }
    if ident == "ORDER" || ident == "order" { return true; }
    if ident == "BY" || ident == "by" { return true; }
    return false;
}

pub fn sql_lexer_next_token(lex: &mut SqlLexer) -> SqlToken {
    let s: String = (lex).input;
    let len: Int = (lex).length;

    while (lex).pos < len {
        let ch: Int = byte_at(s, (lex).pos);
        if ch == 32 || ch == 9 || ch == 13 {
            (lex).pos = (lex).pos + 1;
            (lex).col = (lex).col + 1;
        } else if ch == 10 {
            (lex).pos = (lex).pos + 1;
            (lex).line = (lex).line + 1;
            (lex).col = 1;
        } else {
            let start_pos: Int = (lex).pos;
            let start_col: Int = (lex).col;
            let start_line: Int = (lex).line;

            if ch == 44 {
                (lex).pos = (lex).pos + 1;
                (lex).col = (lex).col + 1;
                return sql_token_create(5, ",", start_pos, start_line, start_col);
            }
            if ch == 59 {
                (lex).pos = (lex).pos + 1;
                (lex).col = (lex).col + 1;
                return sql_token_create(6, ";", start_pos, start_line, start_col);
            }
            if ch == 40 {
                (lex).pos = (lex).pos + 1;
                (lex).col = (lex).col + 1;
                return sql_token_create(7, "(", start_pos, start_line, start_col);
            }
            if ch == 41 {
                (lex).pos = (lex).pos + 1;
                (lex).col = (lex).col + 1;
                return sql_token_create(8, ")", start_pos, start_line, start_col);
            }
            if ch == 42 {
                (lex).pos = (lex).pos + 1;
                (lex).col = (lex).col + 1;
                return sql_token_create(9, "*", start_pos, start_line, start_col);
            }
            if ch == 61 {
                (lex).pos = (lex).pos + 1;
                (lex).col = (lex).col + 1;
                return sql_token_create(10, "=", start_pos, start_line, start_col);
            }
            if ch == 60 {
                (lex).pos = (lex).pos + 1;
                (lex).col = (lex).col + 1;
                return sql_token_create(11, "<", start_pos, start_line, start_col);
            }
            if ch == 62 {
                (lex).pos = (lex).pos + 1;
                (lex).col = (lex).col + 1;
                return sql_token_create(12, ">", start_pos, start_line, start_col);
            }

            if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95 {
                let mut buf: List[Int] = bytes_new();
                while (lex).pos < len {
                    let cur_c: Int = byte_at(s, (lex).pos);
                    let is_id: Bool = (cur_c >= 65 && cur_c <= 90) || (cur_c >= 97 && cur_c <= 122) || (cur_c >= 48 && cur_c <= 57) || cur_c == 95;
                    if is_id {
                        buf = bytes_push(buf, cur_c);
                        (lex).pos = (lex).pos + 1;
                        (lex).col = (lex).col + 1;
                    } else {
                        let word: String = bytes_to_str(buf);
                        if sql_is_keyword(word) {
                            return sql_token_create(1, word, start_pos, start_line, start_col);
                        }
                        return sql_token_create(2, word, start_pos, start_line, start_col);
                    }
                }
                let word2: String = bytes_to_str(buf);
                if sql_is_keyword(word2) {
                    return sql_token_create(1, word2, start_pos, start_line, start_col);
                }
                return sql_token_create(2, word2, start_pos, start_line, start_col);
            }

            if ch >= 48 && ch <= 57 {
                let mut buf_num: List[Int] = bytes_new();
                while (lex).pos < len {
                    let cur_c: Int = byte_at(s, (lex).pos);
                    if cur_c >= 48 && cur_c <= 57 {
                        buf_num = bytes_push(buf_num, cur_c);
                        (lex).pos = (lex).pos + 1;
                        (lex).col = (lex).col + 1;
                    } else {
                        let num_str: String = bytes_to_str(buf_num);
                        return sql_token_create(3, num_str, start_pos, start_line, start_col);
                    }
                }
                let num_str2: String = bytes_to_str(buf_num);
                return sql_token_create(3, num_str2, start_pos, start_line, start_col);
            }

            (lex).pos = (lex).pos + 1;
            (lex).col = (lex).col + 1;
        }
    }

    return sql_token_create(99, "EOF", (lex).pos, (lex).line, (lex).col);
}

pub fn sql_lexer_tokenize_all(query: String) -> List[SqlToken] {
    let mut lexer: SqlLexer = sql_lexer_create(query);
    let mut tokens: List[SqlToken] = list_new();
    let mut done: Bool = false;

    while done == false {
        let tok: SqlToken = sql_lexer_next_token(&mut lexer);
        tokens = list_push(tokens, tok);
        if (tok).token_type == 99 {
            done = true;
        }
    }

    return tokens;
}
