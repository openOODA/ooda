// # SQL Abstract Syntax Tree (AST) Definitions
//
// Logline: Defines relational SQL statement AST nodes for SELECT, INSERT, UPDATE, DELETE, and DDL.
//
// Setup: Pure AST representation for structured database queries.
//
// Beats:
//   1. Define binary filter predicates, column definitions, and statement variants.
//   2. Structure AST records for data manipulation (DML) and table definition (DDL).
//   3. Implement type-safe AST statement constructors and tag wrappers.

type SqlBinaryOp = struct {
    op: String,
    left_field: String,
    right_val: String
};

type SqlColumnDef = struct {
    name: String,
    data_type: String,
    is_primary_key: Bool,
    is_nullable: Bool
};

type SqlSelectStmt = struct {
    table_name: String,
    columns: List[String],
    where_clause: List[SqlBinaryOp],
    limit_val: Int,
    offset_val: Int
};

type SqlInsertStmt = struct {
    table_name: String,
    columns: List[String],
    values: List[String]
};

type SqlUpdateStmt = struct {
    table_name: String,
    set_columns: List[String],
    set_values: List[String],
    where_clause: List[SqlBinaryOp]
};

type SqlDeleteStmt = struct {
    table_name: String,
    where_clause: List[SqlBinaryOp]
};

type SqlCreateTableStmt = struct {
    table_name: String,
    columns: List[SqlColumnDef],
    if_not_exists: Bool
};

type SqlStatement = struct {
    kind: Int,
    select_stmt: SqlSelectStmt,
    insert_stmt: SqlInsertStmt,
    update_stmt: SqlUpdateStmt,
    delete_stmt: SqlDeleteStmt,
    create_table_stmt: SqlCreateTableStmt
};

pub fn sql_select_stmt_create(table: String, cols: List[String]) -> SqlSelectStmt {
    let empty_where: List[SqlBinaryOp] = list_new();
    return SqlSelectStmt {
        table_name: table,
        columns: cols,
        where_clause: empty_where,
        limit_val: -1,
        offset_val: 0
    };
}

pub fn sql_insert_stmt_create(
    table: String,
    cols: List[String],
    vals: List[String]
) -> SqlInsertStmt {
    return SqlInsertStmt {
        table_name: table,
        columns: cols,
        values: vals
    };
}

pub fn sql_update_stmt_create(
    table: String,
    set_cols: List[String],
    set_vals: List[String]
) -> SqlUpdateStmt {
    let empty_where: List[SqlBinaryOp] = list_new();
    return SqlUpdateStmt {
        table_name: table,
        set_columns: set_cols,
        set_values: set_vals,
        where_clause: empty_where
    };
}

pub fn sql_delete_stmt_create(table: String) -> SqlDeleteStmt {
    let empty_where: List[SqlBinaryOp] = list_new();
    return SqlDeleteStmt {
        table_name: table,
        where_clause: empty_where
    };
}

pub fn sql_create_table_stmt_create(
    table: String,
    cols: List[SqlColumnDef]
) -> SqlCreateTableStmt {
    return SqlCreateTableStmt {
        table_name: table,
        columns: cols,
        if_not_exists: false
    };
}

pub fn sql_empty_statement() -> SqlStatement {
    let empty_cols: List[String] = list_new();
    let empty_defs: List[SqlColumnDef] = list_new();
    let sel: SqlSelectStmt = sql_select_stmt_create("", empty_cols);
    let ins: SqlInsertStmt = sql_insert_stmt_create("", empty_cols, empty_cols);
    let upd: SqlUpdateStmt = sql_update_stmt_create("", empty_cols, empty_cols);
    let del: SqlDeleteStmt = sql_delete_stmt_create("");
    let crt: SqlCreateTableStmt = sql_create_table_stmt_create("", empty_defs);

    return SqlStatement {
        kind: 0,
        select_stmt: sel,
        insert_stmt: ins,
        update_stmt: upd,
        delete_stmt: del,
        create_table_stmt: crt
    };
}

pub fn sql_stmt_from_select(sel: SqlSelectStmt) -> SqlStatement {
    let mut stmt: SqlStatement = sql_empty_statement();
    stmt.kind = 1;
    stmt.select_stmt = sel;
    return stmt;
}

pub fn sql_stmt_from_insert(ins: SqlInsertStmt) -> SqlStatement {
    let mut stmt: SqlStatement = sql_empty_statement();
    stmt.kind = 2;
    stmt.insert_stmt = ins;
    return stmt;
}

pub fn sql_stmt_from_update(upd: SqlUpdateStmt) -> SqlStatement {
    let mut stmt: SqlStatement = sql_empty_statement();
    stmt.kind = 3;
    stmt.update_stmt = upd;
    return stmt;
}

pub fn sql_stmt_from_delete(del: SqlDeleteStmt) -> SqlStatement {
    let mut stmt: SqlStatement = sql_empty_statement();
    stmt.kind = 4;
    stmt.delete_stmt = del;
    return stmt;
}

pub fn sql_stmt_from_create_table(crt: SqlCreateTableStmt) -> SqlStatement {
    let mut stmt: SqlStatement = sql_empty_statement();
    stmt.kind = 5;
    stmt.create_table_stmt = crt;
    return stmt;
}
