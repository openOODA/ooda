// # Secondary B-Tree Column Index
//
// Logline: Implements in-memory secondary B-Tree indexing for point lookups and range scans.
//
// Setup: Pure secondary indexing engine mapping key attributes to primary row identifiers.
//
// Beats:
//   1. Define index entry pairs, multi-way node structures, and index schema records.
//   2. Insert key-to-row bindings and maintain ordered key sequences.
//   3. Execute point lookups, key deletions, and range queries returning row ID sets.

pub type BTreeIndexEntry = struct {
    key: String,
    row_id: Int,
};

pub type BTreeIndexNode = struct {
    node_id: Int,
    is_leaf: Bool,
    entries: List[BTreeIndexEntry],
    child_ids: List[Int],
    next_node_id: Int,
};

pub type BTreeIndex = struct {
    index_name: String,
    table_name: String,
    column_name: String,
    nodes: List[BTreeIndexNode],
    root_id: Int,
    max_degree: Int,
    entry_count: Int,
};

pub fn btree_index_create(
    name: String,
    table: String,
    col: String,
    max_degree: Int
) -> BTreeIndex {
    let empty_entries: List[BTreeIndexEntry] = list_new();
    let empty_children: List[Int] = list_new();
    let root: BTreeIndexNode = BTreeIndexNode {
        node_id: 1,
        is_leaf: true,
        entries: empty_entries,
        child_ids: empty_children,
        next_node_id: 0,
    };

    let mut nodes: List[BTreeIndexNode] = list_new();
    nodes = list_push(nodes, root);

    return BTreeIndex {
        index_name: name,
        table_name: table,
        column_name: col,
        nodes: nodes,
        root_id: 1,
        max_degree: max_degree,
        entry_count: 0,
    };
}

pub fn btree_index_find_node(idx: &BTreeIndex, node_id: Int) -> Option[BTreeIndexNode] {
    let node_list: List[BTreeIndexNode] = (idx).nodes;
    let n: Int = list_len(node_list);
    let mut i: Int = 0;
    while i < n {
        let node: BTreeIndexNode = list_get(node_list, i);
        if (node).node_id == node_id {
            return Some(node);
        }
        i = i + 1;
    }
    return None;
}

pub fn btree_index_insert(
    idx: &mut BTreeIndex,
    key: String,
    row_id: Int
) -> Bool {
    let root_opt: Option[BTreeIndexNode] = btree_index_find_node(idx, (idx).root_id);
    if root_opt.is_none() {
        return false;
    }

    let root: BTreeIndexNode = root_opt.unwrap();
    let cur_entries: List[BTreeIndexEntry] = (root).entries;
    let n: Int = list_len(cur_entries);

    let entry: BTreeIndexEntry = BTreeIndexEntry {
        key: key,
        row_id: row_id,
    };

    let mut new_entries: List[BTreeIndexEntry] = list_new();
    let mut inserted: Bool = false;
    let mut i: Int = 0;

    while i < n {
        let item: BTreeIndexEntry = list_get(cur_entries, i);
        if inserted == false {
            if (item).key >= key {
                new_entries = list_push(new_entries, entry);
                inserted = true;
            }
        }
        new_entries = list_push(new_entries, item);
        i = i + 1;
    }

    if inserted == false {
        new_entries = list_push(new_entries, entry);
    }

    let updated_root: BTreeIndexNode = BTreeIndexNode {
        node_id: (root).node_id,
        is_leaf: (root).is_leaf,
        entries: new_entries,
        child_ids: (root).child_ids,
        next_node_id: (root).next_node_id,
    };

    let mut new_nodes: List[BTreeIndexNode] = list_new();
    new_nodes = list_push(new_nodes, updated_root);
    (idx).nodes = new_nodes;
    (idx).entry_count = (idx).entry_count + 1;

    return true;
}

pub fn btree_index_search(idx: &BTreeIndex, key: String) -> List[Int] {
    let mut results: List[Int] = list_new();
    let root_opt: Option[BTreeIndexNode] = btree_index_find_node(idx, (idx).root_id);
    if root_opt.is_none() {
        return results;
    }

    let root: BTreeIndexNode = root_opt.unwrap();
    let entries_list: List[BTreeIndexEntry] = (root).entries;
    let n: Int = list_len(entries_list);
    let mut i: Int = 0;

    while i < n {
        let e: BTreeIndexEntry = list_get(entries_list, i);
        if (e).key == key {
            results = list_push(results, (e).row_id);
        }
        i = i + 1;
    }

    return results;
}

pub fn btree_index_range_search(
    idx: &BTreeIndex,
    min_k: String,
    max_k: String
) -> List[Int] {
    let mut results: List[Int] = list_new();
    let root_opt: Option[BTreeIndexNode] = btree_index_find_node(idx, (idx).root_id);
    if root_opt.is_none() {
        return results;
    }

    let root: BTreeIndexNode = root_opt.unwrap();
    let entries_list: List[BTreeIndexEntry] = (root).entries;
    let n: Int = list_len(entries_list);
    let mut i: Int = 0;

    while i < n {
        let e: BTreeIndexEntry = list_get(entries_list, i);
        let k: String = (e).key;
        if k >= min_k {
            if k <= max_k {
                results = list_push(results, (e).row_id);
            }
        }
        i = i + 1;
    }

    return results;
}

pub fn btree_index_delete(
    idx: &mut BTreeIndex,
    key: String,
    row_id: Int
) -> Bool {
    let root_opt: Option[BTreeIndexNode] = btree_index_find_node(idx, (idx).root_id);
    if root_opt.is_none() {
        return false;
    }

    let root: BTreeIndexNode = root_opt.unwrap();
    let entries_list: List[BTreeIndexEntry] = (root).entries;
    let n: Int = list_len(entries_list);
    let mut new_entries: List[BTreeIndexEntry] = list_new();
    let mut found: Bool = false;
    let mut i: Int = 0;

    while i < n {
        let e: BTreeIndexEntry = list_get(entries_list, i);
        if (e).key == key && (e).row_id == row_id {
            found = true;
        } else {
            new_entries = list_push(new_entries, e);
        }
        i = i + 1;
    }

    if found {
        let updated_root: BTreeIndexNode = BTreeIndexNode {
            node_id: (root).node_id,
            is_leaf: (root).is_leaf,
            entries: new_entries,
            child_ids: (root).child_ids,
            next_node_id: (root).next_node_id,
        };
        let mut new_nodes: List[BTreeIndexNode] = list_new();
        new_nodes = list_push(new_nodes, updated_root);
        (idx).nodes = new_nodes;
        (idx).entry_count = (idx).entry_count - 1;
    }

    return found;
}
