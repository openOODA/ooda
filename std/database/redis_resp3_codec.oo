// # RESP3 List[Int] encode helpers
//
// Logline: Encodes Simple Strings, Errors, Integers, Bulk Strings, Arrays, and Maps with CRLF framing.
//
// Setup: Pure. Bytes are List[Int]. CRLF is 13 then 10.
//
// Beats:
//   1. Write ASCII digits for lengths and integers.
//   2. Frame + - : $ with CRLF.
//   3. Wrap child frames as *n or %n aggregates.

import "std/byte_out.oo";

fn resp_crlf(o: List[Int]) -> List[Int] {
    let mut b: List[Int] = o;
    b = list_push(b, 13);
    b = list_push(b, 10);
    return b;
}

fn resp_cat(o: List[Int], s: List[Int]) -> List[Int] {
    let mut b: List[Int] = o;
    let mut i: Int = 0;
    while i < list_len(s) {
        b = list_push(b, list_get(s, i) & 255);
        i = i + 1;
    }
    return b;
}

fn resp_digits(n: Int) -> List[Int] {
    if n == 0 {
        let mut z: List[Int] = list_new();
        z = list_push(z, 48);
        return z;
    }
    let mut x: Int = n;
    let mut neg: Int = 0;
    if x < 0 {
        neg = 1;
        x = 0 - x;
    }
    let mut tmp: List[Int] = list_new();
    while x > 0 {
        tmp = list_push(tmp, 48 + (x % 10));
        x = x / 10;
    }
    let mut o: List[Int] = list_new();
    if neg == 1 {
        o = list_push(o, 45);
    }
    let mut i: Int = list_len(tmp) - 1;
    while i >= 0 {
        o = list_push(o, list_get(tmp, i));
        i = i - 1;
    }
    return o;
}

pub fn redis_resp3_encode_simple(s: List[Int]) -> ByteOut {
    let mut o: List[Int] = list_new();
    o = list_push(o, 43);
    o = resp_cat(o, s);
    return byte_out_ok(resp_crlf(o));
}

pub fn redis_resp3_encode_error(s: List[Int]) -> ByteOut {
    let mut o: List[Int] = list_new();
    o = list_push(o, 45);
    o = resp_cat(o, s);
    return byte_out_ok(resp_crlf(o));
}

pub fn redis_resp3_encode_int(n: Int) -> ByteOut {
    let mut o: List[Int] = list_new();
    o = list_push(o, 58);
    o = resp_cat(o, resp_digits(n));
    return byte_out_ok(resp_crlf(o));
}

pub fn redis_resp3_encode_bulk(s: List[Int]) -> ByteOut {
    let mut o: List[Int] = list_new();
    o = list_push(o, 36);
    o = resp_cat(o, resp_digits(list_len(s)));
    o = resp_crlf(o);
    o = resp_cat(o, s);
    return byte_out_ok(resp_crlf(o));
}

pub fn redis_resp3_encode_array_n(n: Int, kids: List[Int]) -> ByteOut {
    if n < 0 {
        return byte_out_err("resp3 syntax error");
    }
    let mut o: List[Int] = list_new();
    o = list_push(o, 42);
    o = resp_cat(o, resp_digits(n));
    o = resp_crlf(o);
    o = resp_cat(o, kids);
    return byte_out_ok(o);
}

pub fn redis_resp3_encode_map_n(n: Int, kids: List[Int]) -> ByteOut {
    if n < 0 {
        return byte_out_err("resp3 syntax error");
    }
    let mut o: List[Int] = list_new();
    o = list_push(o, 37);
    o = resp_cat(o, resp_digits(n));
    o = resp_crlf(o);
    o = resp_cat(o, kids);
    return byte_out_ok(o);
}

pub fn redis_resp3_cat_bytes(a: List[Int], b: List[Int]) -> List[Int] { return resp_cat(a, b); }

pub fn redis_resp3_digits(n: Int) -> List[Int] { return resp_digits(n); }
