// # B+ Tree Disk Node Operations
//
// Logline: Ordered insert, lookup, remove, leaf split on four Int key slots.
//
// Setup: Imports btree_disk_types.oo. Keys kept sorted ascending.
//
// Beats:
//   1. find_key_index: first slot with key >= probe, else n_keys.
//   2. Insert replaces equal key; shifts greater keys right; full leaf last_ok=0.
//   3. Split mid = n_keys/2; left keeps [0,mid), right [mid,n).
// residual: List[String]/&mut destubbed to fixed Int slots.

import "./btree_disk_types.oo";

pub fn btree_node_key_at(node: BTreeNode, idx: Int) -> Int {
    if idx == 0 {
        return node.k0;
    }
    if idx == 1 {
        return node.k1;
    }
    if idx == 2 {
        return node.k2;
    }
    if idx == 3 {
        return node.k3;
    }
    return 0;
}

pub fn btree_node_val_at(node: BTreeNode, idx: Int) -> Int {
    if idx == 0 {
        return node.v0;
    }
    if idx == 1 {
        return node.v1;
    }
    if idx == 2 {
        return node.v2;
    }
    if idx == 3 {
        return node.v3;
    }
    return 0;
}

pub fn btree_node_find_key_index(node: BTreeNode, key: Int) -> Int {
    let n: Int = node.n_keys;
    let mut i: Int = 0;
    while i < n {
        let k: Int = btree_node_key_at(node, i);
        if k >= key {
            return i;
        }
        i = i + 1;
    }
    return n;
}

pub fn btree_node_lookup_value(node: BTreeNode, key: Int) -> Int {
    if node.is_leaf == 0 {
        return 0 - 1;
    }
    let n: Int = node.n_keys;
    let mut i: Int = 0;
    while i < n {
        let k: Int = btree_node_key_at(node, i);
        if k == key {
            return btree_node_val_at(node, i);
        }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn btree_node_insert_key_value(node: BTreeNode, key: Int, val: Int) -> BTreeNode {
    let n: Int = node.n_keys;
    let idx: Int = btree_node_find_key_index(node, key);
    if idx < n {
        let existing: Int = btree_node_key_at(node, idx);
        if existing == key {
            let mut v0: Int = node.v0;
            let mut v1: Int = node.v1;
            let mut v2: Int = node.v2;
            let mut v3: Int = node.v3;
            if idx == 0 {
                v0 = val;
            }
            if idx == 1 {
                v1 = val;
            }
            if idx == 2 {
                v2 = val;
            }
            if idx == 3 {
                v3 = val;
            }
            return BTreeNode {
                page_id: node.page_id,
                is_leaf: node.is_leaf,
                n_keys: n,
                k0: node.k0,
                k1: node.k1,
                k2: node.k2,
                k3: node.k3,
                v0: v0,
                v1: v1,
                v2: v2,
                v3: v3,
                next_leaf: node.next_leaf,
                prev_leaf: node.prev_leaf,
                last_ok: 1
            };
        }
    }
    if n >= 4 {
        return BTreeNode {
            page_id: node.page_id,
            is_leaf: node.is_leaf,
            n_keys: n,
            k0: node.k0,
            k1: node.k1,
            k2: node.k2,
            k3: node.k3,
            v0: node.v0,
            v1: node.v1,
            v2: node.v2,
            v3: node.v3,
            next_leaf: node.next_leaf,
            prev_leaf: node.prev_leaf,
            last_ok: 0
        };
    }
    let mut k0: Int = node.k0;
    let mut k1: Int = node.k1;
    let mut k2: Int = node.k2;
    let mut k3: Int = node.k3;
    let mut v0: Int = node.v0;
    let mut v1: Int = node.v1;
    let mut v2: Int = node.v2;
    let mut v3: Int = node.v3;
    if n == 0 {
        k0 = key;
        v0 = val;
    } else {
        if n == 1 {
            if idx == 0 {
                k1 = k0;
                v1 = v0;
                k0 = key;
                v0 = val;
            } else {
                k1 = key;
                v1 = val;
            }
        } else {
            if n == 2 {
                if idx == 0 {
                    k2 = k1;
                    v2 = v1;
                    k1 = k0;
                    v1 = v0;
                    k0 = key;
                    v0 = val;
                } else {
                    if idx == 1 {
                        k2 = k1;
                        v2 = v1;
                        k1 = key;
                        v1 = val;
                    } else {
                        k2 = key;
                        v2 = val;
                    }
                }
            } else {
                if idx == 0 {
                    k3 = k2;
                    v3 = v2;
                    k2 = k1;
                    v2 = v1;
                    k1 = k0;
                    v1 = v0;
                    k0 = key;
                    v0 = val;
                } else {
                    if idx == 1 {
                        k3 = k2;
                        v3 = v2;
                        k2 = k1;
                        v2 = v1;
                        k1 = key;
                        v1 = val;
                    } else {
                        if idx == 2 {
                            k3 = k2;
                            v3 = v2;
                            k2 = key;
                            v2 = val;
                        } else {
                            k3 = key;
                            v3 = val;
                        }
                    }
                }
            }
        }
    }
    return BTreeNode {
        page_id: node.page_id,
        is_leaf: node.is_leaf,
        n_keys: n + 1,
        k0: k0,
        k1: k1,
        k2: k2,
        k3: k3,
        v0: v0,
        v1: v1,
        v2: v2,
        v3: v3,
        next_leaf: node.next_leaf,
        prev_leaf: node.prev_leaf,
        last_ok: 1
    };
}

pub fn btree_node_split_leaf(node: BTreeNode, new_page_id: Int) -> BTreeSplit {
    let total: Int = node.n_keys;
    let mid: Int = total / 2;
    let mut left_n: Int = mid;
    let mut right_n: Int = total - mid;
    if mid < 0 {
        left_n = 0;
    }
    if right_n < 0 {
        right_n = 0;
    }
    let mut left_k0: Int = 0;
    let mut left_k1: Int = 0;
    let mut left_v0: Int = 0;
    let mut left_v1: Int = 0;
    let mut right_k0: Int = 0;
    let mut right_k1: Int = 0;
    let mut right_v0: Int = 0;
    let mut right_v1: Int = 0;
    if left_n >= 1 {
        left_k0 = node.k0;
        left_v0 = node.v0;
    }
    if left_n >= 2 {
        left_k1 = node.k1;
        left_v1 = node.v1;
    }
    if mid == 0 {
        if right_n >= 1 {
            right_k0 = node.k0;
            right_v0 = node.v0;
        }
        if right_n >= 2 {
            right_k1 = node.k1;
            right_v1 = node.v1;
        }
    } else {
        if mid == 1 {
            if right_n >= 1 {
                right_k0 = node.k1;
                right_v0 = node.v1;
            }
            if right_n >= 2 {
                right_k1 = node.k2;
                right_v1 = node.v2;
            }
        } else {
            if right_n >= 1 {
                right_k0 = node.k2;
                right_v0 = node.v2;
            }
            if right_n >= 2 {
                right_k1 = node.k3;
                right_v1 = node.v3;
            }
        }
    }
    let mid_key: Int = right_k0;
    return BTreeSplit {
        left_page: node.page_id,
        right_page: new_page_id,
        left_n: left_n,
        right_n: right_n,
        left_k0: left_k0,
        left_k1: left_k1,
        left_v0: left_v0,
        left_v1: left_v1,
        right_k0: right_k0,
        right_k1: right_k1,
        right_v0: right_v0,
        right_v1: right_v1,
        mid_key: mid_key
    };
}

pub fn btree_node_remove_key(node: BTreeNode, key: Int) -> BTreeNode {
    let n: Int = node.n_keys;
    let idx: Int = btree_node_find_key_index(node, key);
    if idx >= n {
        return BTreeNode {
            page_id: node.page_id,
            is_leaf: node.is_leaf,
            n_keys: n,
            k0: node.k0,
            k1: node.k1,
            k2: node.k2,
            k3: node.k3,
            v0: node.v0,
            v1: node.v1,
            v2: node.v2,
            v3: node.v3,
            next_leaf: node.next_leaf,
            prev_leaf: node.prev_leaf,
            last_ok: 0
        };
    }
    let existing: Int = btree_node_key_at(node, idx);
    if existing != key {
        return BTreeNode {
            page_id: node.page_id,
            is_leaf: node.is_leaf,
            n_keys: n,
            k0: node.k0,
            k1: node.k1,
            k2: node.k2,
            k3: node.k3,
            v0: node.v0,
            v1: node.v1,
            v2: node.v2,
            v3: node.v3,
            next_leaf: node.next_leaf,
            prev_leaf: node.prev_leaf,
            last_ok: 0
        };
    }
    let mut k0: Int = node.k0;
    let mut k1: Int = node.k1;
    let mut k2: Int = node.k2;
    let mut k3: Int = node.k3;
    let mut v0: Int = node.v0;
    let mut v1: Int = node.v1;
    let mut v2: Int = node.v2;
    let mut v3: Int = node.v3;
    if idx == 0 {
        k0 = k1;
        v0 = v1;
        k1 = k2;
        v1 = v2;
        k2 = k3;
        v2 = v3;
        k3 = 0;
        v3 = 0;
    } else {
        if idx == 1 {
            k1 = k2;
            v1 = v2;
            k2 = k3;
            v2 = v3;
            k3 = 0;
            v3 = 0;
        } else {
            if idx == 2 {
                k2 = k3;
                v2 = v3;
                k3 = 0;
                v3 = 0;
            } else {
                k3 = 0;
                v3 = 0;
            }
        }
    }
    return BTreeNode {
        page_id: node.page_id,
        is_leaf: node.is_leaf,
        n_keys: n - 1,
        k0: k0,
        k1: k1,
        k2: k2,
        k3: k3,
        v0: v0,
        v1: v1,
        v2: v2,
        v3: v3,
        next_leaf: node.next_leaf,
        prev_leaf: node.prev_leaf,
        last_ok: 1
    };
}
