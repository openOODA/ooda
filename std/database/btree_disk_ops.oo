// # B+ Tree Disk Node Operations
//
// Logline: Ordered insert, lookup, remove, leaf split on four Int key slots.
//
// Setup: Imports btree_disk_types.oo. Keys kept sorted ascending.
//
// Beats:
//   1. find_key_index: first slot with key >= probe, else n_keys.
//   2. Insert replaces equal key; shifts greater keys right; full leaf last_ok=0.
//   3. Split mid = n_keys/2; left keeps [0,mid), right [mid,n).
// residual: List[String]/&mut destubbed to fixed Int slots.

import "./btree_disk_types.oo";

pub fn btree_node_key_at(node: BTreeNode, idx: Int) -> Int {
    if idx == 0 { return node.k0; }
    if idx == 1 { return node.k1; }
    if idx == 2 { return node.k2; }
    if idx == 3 { return node.k3; }
    return 0;
}

pub fn btree_node_val_at(node: BTreeNode, idx: Int) -> Int {
    if idx == 0 { return node.v0; }
    if idx == 1 { return node.v1; }
    if idx == 2 { return node.v2; }
    if idx == 3 { return node.v3; }
    return 0;
}

pub fn btree_node_set_k(node: BTreeNode, idx: Int, val: Int) -> BTreeNode {
    if idx == 0 { return BTreeNode { page_id: node.page_id, is_leaf: node.is_leaf, n_keys: node.n_keys, k0: val, k1: node.k1, k2: node.k2, k3: node.k3, v0: node.v0, v1: node.v1, v2: node.v2, v3: node.v3, next_leaf: node.next_leaf, prev_leaf: node.prev_leaf, last_ok: node.last_ok }; }
    if idx == 1 { return BTreeNode { page_id: node.page_id, is_leaf: node.is_leaf, n_keys: node.n_keys, k0: node.k0, k1: val, k2: node.k2, k3: node.k3, v0: node.v0, v1: node.v1, v2: node.v2, v3: node.v3, next_leaf: node.next_leaf, prev_leaf: node.prev_leaf, last_ok: node.last_ok }; }
    if idx == 2 { return BTreeNode { page_id: node.page_id, is_leaf: node.is_leaf, n_keys: node.n_keys, k0: node.k0, k1: node.k1, k2: val, k3: node.k3, v0: node.v0, v1: node.v1, v2: node.v2, v3: node.v3, next_leaf: node.next_leaf, prev_leaf: node.prev_leaf, last_ok: node.last_ok }; }
    if idx == 3 { return BTreeNode { page_id: node.page_id, is_leaf: node.is_leaf, n_keys: node.n_keys, k0: node.k0, k1: node.k1, k2: node.k2, k3: val, v0: node.v0, v1: node.v1, v2: node.v2, v3: node.v3, next_leaf: node.next_leaf, prev_leaf: node.prev_leaf, last_ok: node.last_ok }; }
    return node;
}

pub fn btree_node_set_v(node: BTreeNode, idx: Int, val: Int) -> BTreeNode {
    if idx == 0 { return BTreeNode { page_id: node.page_id, is_leaf: node.is_leaf, n_keys: node.n_keys, k0: node.k0, k1: node.k1, k2: node.k2, k3: node.k3, v0: val, v1: node.v1, v2: node.v2, v3: node.v3, next_leaf: node.next_leaf, prev_leaf: node.prev_leaf, last_ok: node.last_ok }; }
    if idx == 1 { return BTreeNode { page_id: node.page_id, is_leaf: node.is_leaf, n_keys: node.n_keys, k0: node.k0, k1: node.k1, k2: node.k2, k3: node.k3, v0: node.v0, v1: val, v2: node.v2, v3: node.v3, next_leaf: node.next_leaf, prev_leaf: node.prev_leaf, last_ok: node.last_ok }; }
    if idx == 2 { return BTreeNode { page_id: node.page_id, is_leaf: node.is_leaf, n_keys: node.n_keys, k0: node.k0, k1: node.k1, k2: node.k2, k3: node.k3, v0: node.v0, v1: node.v1, v2: val, v3: node.v3, next_leaf: node.next_leaf, prev_leaf: node.prev_leaf, last_ok: node.last_ok }; }
    if idx == 3 { return BTreeNode { page_id: node.page_id, is_leaf: node.is_leaf, n_keys: node.n_keys, k0: node.k0, k1: node.k1, k2: node.k2, k3: node.k3, v0: node.v0, v1: node.v1, v2: node.v2, v3: val, next_leaf: node.next_leaf, prev_leaf: node.prev_leaf, last_ok: node.last_ok }; }
    return node;
}

pub fn btree_node_find_key_index(node: BTreeNode, key: Int) -> Int {
    let n: Int = node.n_keys;
    let mut i: Int = 0;
    while i < n {
        let k: Int = btree_node_key_at(node, i);
        if k >= key { return i; }
        i = i + 1;
    }
    return n;
}

pub fn btree_node_lookup_value(node: BTreeNode, key: Int) -> Int {
    if node.is_leaf == 0 { return 0 - 1; }
    let n: Int = node.n_keys;
    let mut i: Int = 0;
    while i < n {
        let k: Int = btree_node_key_at(node, i);
        if k == key { return btree_node_val_at(node, i); }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn btree_node_insert_key_value(node: BTreeNode, key: Int, val: Int) -> BTreeNode {
    let n: Int = node.n_keys;
    let idx: Int = btree_node_find_key_index(node, key);
    if idx < n {
        if btree_node_key_at(node, idx) == key {
            let updated: BTreeNode = btree_node_set_v(node, idx, val);
            return BTreeNode { page_id: updated.page_id, is_leaf: updated.is_leaf, n_keys: updated.n_keys, k0: updated.k0, k1: updated.k1, k2: updated.k2, k3: updated.k3, v0: updated.v0, v1: updated.v1, v2: updated.v2, v3: updated.v3, next_leaf: updated.next_leaf, prev_leaf: updated.prev_leaf, last_ok: 1 };
        }
    }
    if n >= 4 {
        return BTreeNode { page_id: node.page_id, is_leaf: node.is_leaf, n_keys: n, k0: node.k0, k1: node.k1, k2: node.k2, k3: node.k3, v0: node.v0, v1: node.v1, v2: node.v2, v3: node.v3, next_leaf: node.next_leaf, prev_leaf: node.prev_leaf, last_ok: 0 };
    }
    let mut shifted: BTreeNode = node;
    let mut j: Int = n;
    while j > idx {
        shifted = btree_node_set_k(shifted, j, btree_node_key_at(shifted, j - 1));
        shifted = btree_node_set_v(shifted, j, btree_node_val_at(shifted, j - 1));
        j = j - 1;
    }
    shifted = btree_node_set_k(shifted, idx, key);
    shifted = btree_node_set_v(shifted, idx, val);
    return BTreeNode { page_id: shifted.page_id, is_leaf: shifted.is_leaf, n_keys: n + 1, k0: shifted.k0, k1: shifted.k1, k2: shifted.k2, k3: shifted.k3, v0: shifted.v0, v1: shifted.v1, v2: shifted.v2, v3: shifted.v3, next_leaf: shifted.next_leaf, prev_leaf: shifted.prev_leaf, last_ok: 1 };
}

pub fn btree_node_split_leaf(node: BTreeNode, new_page_id: Int) -> BTreeSplit {
    let total: Int = node.n_keys;
    let mid: Int = total / 2;
    let mut left_n: Int = mid;
    let mut right_n: Int = total - mid;
    if mid < 0 { left_n = 0; }
    if right_n < 0 { right_n = 0; }
    return BTreeSplit {
        left_page: node.page_id,
        right_page: new_page_id,
        left_n: left_n,
        right_n: right_n,
        left_k0: btree_node_key_at(node, 0),
        left_k1: btree_node_key_at(node, 1),
        left_v0: btree_node_val_at(node, 0),
        left_v1: btree_node_val_at(node, 1),
        right_k0: btree_node_key_at(node, mid),
        right_k1: btree_node_key_at(node, mid + 1),
        right_v0: btree_node_val_at(node, mid),
        right_v1: btree_node_val_at(node, mid + 1),
        mid_key: btree_node_key_at(node, mid)
    };
}

pub fn btree_node_remove_key(node: BTreeNode, key: Int) -> BTreeNode {
    let n: Int = node.n_keys;
    let idx: Int = btree_node_find_key_index(node, key);
    if idx >= n {
        return BTreeNode { page_id: node.page_id, is_leaf: node.is_leaf, n_keys: n, k0: node.k0, k1: node.k1, k2: node.k2, k3: node.k3, v0: node.v0, v1: node.v1, v2: node.v2, v3: node.v3, next_leaf: node.next_leaf, prev_leaf: node.prev_leaf, last_ok: 0 };
    }
    if btree_node_key_at(node, idx) != key {
        return BTreeNode { page_id: node.page_id, is_leaf: node.is_leaf, n_keys: n, k0: node.k0, k1: node.k1, k2: node.k2, k3: node.k3, v0: node.v0, v1: node.v1, v2: node.v2, v3: node.v3, next_leaf: node.next_leaf, prev_leaf: node.prev_leaf, last_ok: 0 };
    }
    let mut shifted: BTreeNode = node;
    let mut j: Int = idx;
    while j < n - 1 {
        shifted = btree_node_set_k(shifted, j, btree_node_key_at(node, j + 1));
        shifted = btree_node_set_v(shifted, j, btree_node_val_at(node, j + 1));
        j = j + 1;
    }
    if n - 1 == 0 { shifted = btree_node_set_k(shifted, 0, 0); shifted = btree_node_set_v(shifted, 0, 0); }
    if n - 1 == 1 { shifted = btree_node_set_k(shifted, 1, 0); shifted = btree_node_set_v(shifted, 1, 0); }
    if n - 1 == 2 { shifted = btree_node_set_k(shifted, 2, 0); shifted = btree_node_set_v(shifted, 2, 0); }
    if n - 1 == 3 { shifted = btree_node_set_k(shifted, 3, 0); shifted = btree_node_set_v(shifted, 3, 0); }
    return BTreeNode { page_id: shifted.page_id, is_leaf: shifted.is_leaf, n_keys: n - 1, k0: shifted.k0, k1: shifted.k1, k2: shifted.k2, k3: shifted.k3, v0: shifted.v0, v1: shifted.v1, v2: shifted.v2, v3: shifted.v3, next_leaf: shifted.next_leaf, prev_leaf: shifted.prev_leaf, last_ok: 1 };
}
