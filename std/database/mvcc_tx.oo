// # Multi-Version Concurrency Control (MVCC) Transactions
//
// Logline: Defines transaction state, read snapshots, isolation levels, and tuple visibility rules.
//
// Setup: Pure transaction context and snapshot visibility engine for concurrency control.
//
// Beats:
//   1. Define transaction state, isolation levels, and point-in-time snapshots.
//   2. Determine tuple version visibility against transaction snapshot barriers.
//   3. Record read sets and write sets to detect serializability conflicts.

pub type TxSnapshot = struct {
    snapshot_tx_id: Int,
    active_tx_ids: List[Int],
    watermark_tx_id: Int,
    read_timestamp: Int,
};

pub type Transaction = struct {
    tx_id: Int,
    status: Int,
    isolation_level: Int,
    start_ts: Int,
    commit_ts: Int,
    snapshot: TxSnapshot,
    read_set: List[String],
    write_set: List[String],
};

pub fn tx_snapshot_create(
    tx_id: Int,
    active_ids: List[Int],
    watermark: Int,
    now: Int
) -> TxSnapshot {
    return TxSnapshot {
        snapshot_tx_id: tx_id,
        active_tx_ids: active_ids,
        watermark_tx_id: watermark,
        read_timestamp: now,
    };
}

pub fn tx_create(
    tx_id: Int,
    iso_level: Int,
    start_ts: Int,
    active_ids: List[Int],
    watermark: Int
) -> Transaction {
    let snap: TxSnapshot = tx_snapshot_create(tx_id, active_ids, watermark, start_ts);
    let empty_reads: List[String] = list_new();
    let empty_writes: List[String] = list_new();
    return Transaction {
        tx_id: tx_id,
        status: 0,
        isolation_level: iso_level,
        start_ts: start_ts,
        commit_ts: 0,
        snapshot: snap,
        read_set: empty_reads,
        write_set: empty_writes,
    };
}

pub fn tx_is_active(tx: &Transaction) -> Bool {
    return (tx).status == 0;
}

pub fn tx_is_in_active_list(snap: &TxSnapshot, target_id: Int) -> Bool {
    let active_list: List[Int] = (snap).active_tx_ids;
    let n: Int = list_len(active_list);
    let mut i: Int = 0;
    while i < n {
        if list_get(active_list, i) == target_id {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn tx_is_visible(
    tx: &Transaction,
    created_by_tx: Int,
    expired_by_tx: Int
) -> Bool {
    let my_id: Int = (tx).tx_id;
    let snap: TxSnapshot = (tx).snapshot;

    if created_by_tx == my_id {
        if expired_by_tx == 0 {
            return true;
        }
        if expired_by_tx != my_id {
            return false;
        }
        return false;
    }

    if created_by_tx > (snap).snapshot_tx_id {
        return false;
    }

    if tx_is_in_active_list(&snap, created_by_tx) {
        return false;
    }

    if expired_by_tx == 0 {
        return true;
    }

    if expired_by_tx == my_id {
        return false;
    }

    if expired_by_tx > (snap).snapshot_tx_id {
        return true;
    }

    if tx_is_in_active_list(&snap, expired_by_tx) {
        return true;
    }

    return false;
}

pub fn tx_add_read(tx: &mut Transaction, key: String) {
    let cur_reads: List[String] = (tx).read_set;
    let new_reads: List[String] = list_push(cur_reads, key);
    (tx).read_set = new_reads;
}

pub fn tx_add_write(tx: &mut Transaction, key: String) {
    let cur_writes: List[String] = (tx).write_set;
    let new_writes: List[String] = list_push(cur_writes, key);
    (tx).write_set = new_writes;
}
