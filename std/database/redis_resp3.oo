// # Redis RESP3 Wire Protocol Serialization
//
// Logline: Serialize and parse Redis RESP3 wire protocol frames including simple strings, errors, integers, blobs, arrays, and maps.
//
// Setup: Pure network protocol codec. List[Int] APIs fail closed. String GET/SET helpers remain.
//
// Beats:
//   1. Keep RedisResp3Frame and String GET/SET encoders for existing callers.
//   2. Re-export List[Int] encode for + - : $ * %.
//   3. Re-export fail-closed parse with CRLF and depth <= 16.
//   4. Project ByteOut to Result[Int, String] status.

import "std/byte_out.oo";
import "std/database/redis_resp3_codec.oo";
import "std/database/redis_resp3_parse.oo";

pub type RedisResp3Frame = struct {
    frame_type: String,
    content: String,
    integer_value: Int,
    is_null: Bool
};

pub fn redis_resp3_frame_string(val: String) -> RedisResp3Frame { return RedisResp3Frame {
        frame_type: "+",
        content: val,
        integer_value: 0,
        is_null: false
    }; }

pub fn redis_resp3_frame_int(val: Int) -> RedisResp3Frame { return RedisResp3Frame {
        frame_type: ":",
        content: "",
        integer_value: val,
        is_null: false
    }; }

pub fn redis_resp3_encode_get(key: String) -> String {
    let mut out: String = "*2\r\n$3\r\nGET\r\n$";
    let len: Int = key.len();
    out = out + len.to_string();
    out = out + "\r\n";
    out = out + key;
    out = out + "\r\n";
    return out;
}

pub fn redis_resp3_encode_set(key: String, value: String) -> String {
    let mut out: String = "*3\r\n$3\r\nSET\r\n$";
    let k_len: Int = key.len();
    out = out + k_len.to_string();
    out = out + "\r\n";
    out = out + key;
    out = out + "\r\n$";
    let v_len: Int = value.len();
    out = out + v_len.to_string();
    out = out + "\r\n";
    out = out + value;
    out = out + "\r\n";
    return out;
}

pub fn redis_resp3_stat(o: ByteOut) -> Result[Int, String] { return byte_out_stat(o); }

pub fn redis_resp3_simple(s: List[Int]) -> ByteOut { return redis_resp3_encode_simple(s); }

pub fn redis_resp3_error(s: List[Int]) -> ByteOut { return redis_resp3_encode_error(s); }

pub fn redis_resp3_int(n: Int) -> ByteOut { return redis_resp3_encode_int(n); }

pub fn redis_resp3_bulk(s: List[Int]) -> ByteOut { return redis_resp3_encode_bulk(s); }

pub fn redis_resp3_array_n(n: Int, kids: List[Int]) -> ByteOut { return redis_resp3_encode_array_n(n, kids); }

pub fn redis_resp3_map_n(n: Int, kids: List[Int]) -> ByteOut { return redis_resp3_encode_map_n(n, kids); }

pub fn redis_resp3_parse_bytes(buf: List[Int]) -> ByteOut { return redis_resp3_parse(buf); }

pub fn redis_resp3_parse_status(buf: List[Int]) -> Result[Int, String] { return redis_resp3_parse_stat(buf); }

pub fn redis_resp3_join(a: List[Int], b: List[Int]) -> List[Int] { return redis_resp3_cat_bytes(a, b); }
