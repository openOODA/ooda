// # MySQL client/server wire frames
//
// Logline: Wraps and parses 3-byte little-endian length plus sequence id for OK, ERR, and EOF packets.
//
// Setup: Pure. Bytes are List[Int] 0..255. OK is 0x00, ERR is 0xFF, EOF is 0xFE.
//
// Beats:
//   1. Write a 3-byte length and 1-byte sequence.
//   2. Build OK, ERR, and EOF payloads.
//   3. Parse length, sequence, and kind.
//   4. Reject a truncated header or a length that overruns the buffer.

import "std/byte_out.oo";

fn my_le24(n: Int) -> List[Int] {
    let mut b: List[Int] = list_new();
    b = list_push(b, n & 255);
    b = list_push(b, (n >> 8) & 255);
    b = list_push(b, (n >> 16) & 255);
    return b;
}

fn my_u24(buf: List[Int], o: Int) -> Int {
    return list_get(buf, o) + list_get(buf, o + 1) * 256 + list_get(buf, o + 2) * 65536;
}

fn my_cat(o: List[Int], s: List[Int]) -> List[Int] {
    let mut b: List[Int] = o;
    let mut i: Int = 0;
    while i < list_len(s) {
        b = list_push(b, list_get(s, i) & 255);
        i = i + 1;
    }
    return b;
}

pub fn mysql_wire_codec_wrap(seq: Int, payload: List[Int]) -> ByteOut {
    let n: Int = list_len(payload);
    if n > 16777215 {
        return byte_out_err("mysql length");
    }
    let mut o: List[Int] = my_le24(n);
    o = list_push(o, seq & 255);
    o = my_cat(o, payload);
    return byte_out_ok(o);
}

pub fn mysql_wire_codec_ok(seq: Int) -> ByteOut {
    let mut p: List[Int] = list_new();
    p = list_push(p, 0);
    return mysql_wire_codec_wrap(seq, p);
}

pub fn mysql_wire_codec_err(seq: Int, code: Int) -> ByteOut {
    let mut p: List[Int] = list_new();
    p = list_push(p, 255);
    p = list_push(p, code & 255);
    p = list_push(p, (code >> 8) & 255);
    return mysql_wire_codec_wrap(seq, p);
}

pub fn mysql_wire_codec_eof(seq: Int) -> ByteOut {
    let mut p: List[Int] = list_new();
    p = list_push(p, 254);
    p = list_push(p, 0);
    p = list_push(p, 0);
    p = list_push(p, 0);
    p = list_push(p, 0);
    return mysql_wire_codec_wrap(seq, p);
}

pub fn mysql_wire_codec_parse(buf: List[Int]) -> ByteOut {
    if list_len(buf) < 4 {
        return byte_out_err("mysql short");
    }
    let n: Int = my_u24(buf, 0);
    let seq: Int = list_get(buf, 3);
    if 4 + n > list_len(buf) {
        return byte_out_err("mysql length");
    }
    if n < 1 {
        return byte_out_err("mysql empty");
    }
    let kind: Int = list_get(buf, 4);
    let mut rec: List[Int] = list_new();
    rec = list_push(rec, kind);
    rec = list_push(rec, seq);
    rec = list_push(rec, n);
    rec = list_push(rec, 4 + n);
    return byte_out_ok(rec);
}

pub fn mysql_wire_codec_stat(o: ByteOut) -> Result[Int, String] { return byte_out_stat(o); }
