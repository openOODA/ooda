// residual: List[String] destubbed to Int floor.

type BTreeHeader = struct {
    root_page_id: Int,
    page_size: Int,
    tree_depth: Int
};

pub fn btree_header_new(root_page_id: Int, page_size: Int, tree_depth: Int) -> BTreeHeader {
    return BTreeHeader {
        root_page_id: root_page_id,
        page_size: page_size,
        tree_depth: tree_depth
    };
}

pub fn btree_header_page(h: BTreeHeader) -> Int {
    return h.page_size;
}

type BTreeNode = struct {
    page_id: Int,
    is_leaf: Int,
    n_keys: Int,
    k0: Int,
    k1: Int,
    k2: Int,
    k3: Int,
    v0: Int,
    v1: Int,
    v2: Int,
    v3: Int,
    next_leaf: Int,
    prev_leaf: Int,
    last_ok: Int
};

pub fn btree_node_create(page_id: Int, is_leaf: Int) -> BTreeNode {
    return BTreeNode {
        page_id: page_id,
        is_leaf: is_leaf,
        n_keys: 0,
        k0: 0,
        k1: 0,
        k2: 0,
        k3: 0,
        v0: 0,
        v1: 0,
        v2: 0,
        v3: 0,
        next_leaf: 0,
        prev_leaf: 0,
        last_ok: 1
    };
}

type BTreeSplit = struct {
    left_page: Int,
    right_page: Int,
    left_n: Int,
    right_n: Int,
    left_k0: Int,
    left_k1: Int,
    left_v0: Int,
    left_v1: Int,
    right_k0: Int,
    right_k1: Int,
    right_v0: Int,
    right_v1: Int,
    mid_key: Int
};
