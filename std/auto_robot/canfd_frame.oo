// # CAN-FD DLC length
//
// Logline: Maps a CAN-FD DLC code to payload byte count.
// residual: destubbed to Int floor.

pub fn canfd_dlc_to_len(dlc: Int) -> Int {
    if dlc <= 8 {
        return dlc;
    }
    if dlc == 9 {
        return 12;
    }
    if dlc == 10 {
        return 16;
    }
    if dlc == 11 {
        return 20;
    }
    if dlc == 12 {
        return 24;
    }
    if dlc == 13 {
        return 32;
    }
    if dlc == 14 {
        return 48;
    }
    return 64;
}
