// # Local Interconnect Network (LIN) Bus Master Engine
//
// Logline: LIN 2.x PID parity, inverted checksums, and round-robin schedule.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type LinFrame = struct {
    pid: Int,
    data_len: Int,
    checksum: Int,
    is_valid: Bool
};

type LinMaster = struct {
    sched_ids: List[Int],
    sched_delays: List[Int],
    sched_lens: List[Int],
    current_index: Int,
    baud_rate: Int,
    last_frame_id: Int,
    last_delay_ms: Int
};

pub fn lin_compute_pid(id: Int) -> Int {
    let id_clean: Int = id % 64;
    let b0: Int = id_clean % 2;
    let b1: Int = (id_clean / 2) % 2;
    let b2: Int = (id_clean / 4) % 2;
    let b3: Int = (id_clean / 8) % 2;
    let b4: Int = (id_clean / 16) % 2;
    let b5: Int = (id_clean / 32) % 2;
    let p0: Int = (b0 + b1 + b2 + b4) % 2;
    let p1_xor: Int = (b1 + b3 + b4 + b5) % 2;
    let mut p1: Int = 0;
    if p1_xor == 0 {
        p1 = 1;
    }
    return id_clean + (p0 * 64) + (p1 * 128);
}

pub fn lin_compute_checksum(pid: Int, data: List[Int], enhanced: Bool) -> Int {
    let mut sum: Int = 0;
    if enhanced {
        sum = pid;
    }
    let n: Int = list_len(data);
    let mut i: Int = 0;
    while i < n {
        sum = sum + list_get(data, i);
        if sum > 255 {
            sum = (sum % 256) + (sum / 256);
        }
        i = i + 1;
    }
    let final_sum: Int = sum % 256;
    return 255 - final_sum;
}

pub fn lin_frame_new(id: Int, data: List[Int]) -> LinFrame {
    let pid: Int = lin_compute_pid(id);
    let csum: Int = lin_compute_checksum(pid, data, true);
    return LinFrame {
        pid: pid,
        data_len: list_len(data),
        checksum: csum,
        is_valid: true
    };
}

pub fn lin_master_new(baud: Int) -> LinMaster {
    return LinMaster {
        sched_ids: list_new(),
        sched_delays: list_new(),
        sched_lens: list_new(),
        current_index: 0,
        baud_rate: baud,
        last_frame_id: 0,
        last_delay_ms: 10
    };
}

pub fn lin_master_add_entry(master: LinMaster, frame_id: Int, delay_ms: Int, data_len: Int) -> LinMaster {
    return LinMaster {
        sched_ids: list_push(master.sched_ids, frame_id),
        sched_delays: list_push(master.sched_delays, delay_ms),
        sched_lens: list_push(master.sched_lens, data_len),
        current_index: master.current_index,
        baud_rate: master.baud_rate,
        last_frame_id: master.last_frame_id,
        last_delay_ms: master.last_delay_ms
    };
}

pub fn lin_master_next_entry(master: LinMaster) -> LinMaster {
    let n: Int = list_len(master.sched_ids);
    if n == 0 {
        return LinMaster {
            sched_ids: master.sched_ids,
            sched_delays: master.sched_delays,
            sched_lens: master.sched_lens,
            current_index: 0,
            baud_rate: master.baud_rate,
            last_frame_id: 0,
            last_delay_ms: 10
        };
    }
    let idx: Int = master.current_index % n;
    let fid: Int = list_get(master.sched_ids, idx);
    let delay: Int = list_get(master.sched_delays, idx);
    return LinMaster {
        sched_ids: master.sched_ids,
        sched_delays: master.sched_delays,
        sched_lens: master.sched_lens,
        current_index: (idx + 1) % n,
        baud_rate: master.baud_rate,
        last_frame_id: fid,
        last_delay_ms: delay
    };
}
