// # Automotive Traffic Sign & Signal Classification Engine
//
// Logline: Regulatory sign persistence: speed, stop, yield, traffic lights.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type TrafficSignDetection = struct {
    sign_type: Int,
    confidence_milli: Int,
    speed_limit_val: Int,
    distance_milli: Int
};

type TrafficSignState = struct {
    active_speed_limit: Int,
    is_stop_active: Bool,
    is_yield_active: Bool,
    traffic_light_state: Int,
    last_seen_dist_milli: Int
};

pub fn traffic_sign_detection_new(stype: Int, conf_milli: Int, speed_val: Int, dist_milli: Int) -> TrafficSignDetection {
    return TrafficSignDetection {
        sign_type: stype,
        confidence_milli: conf_milli,
        speed_limit_val: speed_val,
        distance_milli: dist_milli
    };
}

pub fn traffic_sign_state_default() -> TrafficSignState {
    return TrafficSignState {
        active_speed_limit: 50,
        is_stop_active: false,
        is_yield_active: false,
        traffic_light_state: 0,
        last_seen_dist_milli: 1000000
    };
}

pub fn traffic_sign_process_detection(state: TrafficSignState, det: TrafficSignDetection) -> TrafficSignState {
    if det.confidence_milli < 600 {
        return state;
    }
    let mut speed: Int = state.active_speed_limit;
    let mut stop_a: Bool = state.is_stop_active;
    let mut yield_a: Bool = state.is_yield_active;
    let mut light: Int = state.traffic_light_state;
    let st: Int = det.sign_type;
    if st == 0 {
        if det.speed_limit_val > 0 {
            speed = det.speed_limit_val;
        }
    } else {
        if st == 1 {
            if det.distance_milli < 30000 {
                stop_a = true;
            } else {
                stop_a = false;
            }
        } else {
            if st == 2 {
                if det.distance_milli < 25000 {
                    yield_a = true;
                } else {
                    yield_a = false;
                }
            } else {
                if st == 4 {
                    light = 3;
                } else {
                    if st == 5 {
                        light = 1;
                        stop_a = false;
                    } else {
                        if st == 6 {
                            light = 2;
                        }
                    }
                }
            }
        }
    }
    return TrafficSignState {
        active_speed_limit: speed,
        is_stop_active: stop_a,
        is_yield_active: yield_a,
        traffic_light_state: light,
        last_seen_dist_milli: det.distance_milli
    };
}

pub fn traffic_sign_requires_stop(state: TrafficSignState) -> Bool {
    if state.is_stop_active {
        return true;
    }
    if state.traffic_light_state == 3 {
        return true;
    }
    return false;
}
