// # Wheel Speed Encoder Odometry Estimator
//
// Logline: Differential-drive dead reckoning from encoder ticks.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type WheelEncoderTicks = struct {
    left_ticks: Int,
    right_ticks: Int,
    timestamp_us: Int
};

type WheelOdomConfig = struct {
    wheel_radius_milli: Int,
    track_width_milli: Int,
    ticks_per_rev: Int
};

type WheelOdometryState = struct {
    x_milli: Int,
    y_milli: Int,
    theta_milli: Int,
    linear_vel_milli: Int,
    angular_vel_milli: Int,
    prev_left_ticks: Int,
    prev_right_ticks: Int,
    prev_timestamp_us: Int
};

pub fn wheel_odom_config_default() -> WheelOdomConfig {
    return WheelOdomConfig {
        wheel_radius_milli: 150,
        track_width_milli: 500,
        ticks_per_rev: 4096
    };
}

pub fn wheel_odometry_new(init_x_milli: Int, init_y_milli: Int, init_theta_milli: Int) -> WheelOdometryState {
    return WheelOdometryState {
        x_milli: init_x_milli,
        y_milli: init_y_milli,
        theta_milli: init_theta_milli,
        linear_vel_milli: 0,
        angular_vel_milli: 0,
        prev_left_ticks: 0,
        prev_right_ticks: 0,
        prev_timestamp_us: 0
    };
}

pub fn wheel_ticks_to_distance_milli(delta_ticks: Int, cfg: WheelOdomConfig) -> Int {
    if cfg.ticks_per_rev <= 0 {
        return 0;
    }
    let circ_milli: Int = (2 * 3142 * cfg.wheel_radius_milli) / 1000;
    return (delta_ticks * circ_milli) / cfg.ticks_per_rev;
}

pub fn wheel_odometry_update(state: WheelOdometryState, ticks: WheelEncoderTicks, cfg: WheelOdomConfig) -> WheelOdometryState {
    let d_left_ticks: Int = ticks.left_ticks - state.prev_left_ticks;
    let d_right_ticks: Int = ticks.right_ticks - state.prev_right_ticks;
    let dt_us: Int = ticks.timestamp_us - state.prev_timestamp_us;
    let d_left_m: Int = wheel_ticks_to_distance_milli(d_left_ticks, cfg);
    let d_right_m: Int = wheel_ticks_to_distance_milli(d_right_ticks, cfg);
    let d_center_m: Int = (d_left_m + d_right_m) / 2;
    let mut d_theta_milli: Int = 0;
    if cfg.track_width_milli > 0 {
        d_theta_milli = ((d_right_m - d_left_m) * 1000) / cfg.track_width_milli;
    }
    let avg_theta: Int = state.theta_milli + (d_theta_milli / 2);
    let cos_milli: Int = 1000 - ((avg_theta * avg_theta) / 2000);
    let sin_milli: Int = avg_theta - ((avg_theta * avg_theta * avg_theta) / 6000000);
    let nx: Int = state.x_milli + ((d_center_m * cos_milli) / 1000);
    let ny: Int = state.y_milli + ((d_center_m * sin_milli) / 1000);
    let ntheta: Int = state.theta_milli + d_theta_milli;
    let mut lin: Int = 0;
    let mut ang: Int = 0;
    if dt_us > 0 {
        lin = (d_center_m * 1000000) / dt_us;
        ang = (d_theta_milli * 1000000) / dt_us;
    }
    return WheelOdometryState {
        x_milli: nx,
        y_milli: ny,
        theta_milli: ntheta,
        linear_vel_milli: lin,
        angular_vel_milli: ang,
        prev_left_ticks: ticks.left_ticks,
        prev_right_ticks: ticks.right_ticks,
        prev_timestamp_us: ticks.timestamp_us
    };
}
