// # Point Cloud 3D Data Types
//
// Logline: PointXYZ destubbed off List[PointXYZI] to Int coordinates.
//
// Setup: Pure Int points.
//
// Beats:
//   1. point_xyz_new.
//   2. point_xyz_dist_sq (3,4,0) from origin is 25.
// residual: List[PointXYZI] destubbed.

type PointXYZ = struct {
    x: Int,
    y: Int,
    z: Int
};

pub fn point_xyz_new(x: Int, y: Int, z: Int) -> PointXYZ {
    return PointXYZ {
        x: x,
        y: y,
        z: z
    };
}

pub fn point_xyz_dist_sq(p: PointXYZ) -> Int {
    let x: Int = p.x;
    let y: Int = p.y;
    let z: Int = p.z;
    return (x * x) + (y * y) + (z * z);
}
