// # 2D Navigation Costmap & Obstacle Inflation Engine
//
// Logline: Layered navigation costmap with lethal, inscribed, and decay costs.
//
// Setup: Pure .oo standard library module or subsystem.
//
// Beats:
//   1. Execute core data structures and functional algorithms.
//   2. Enforce invariant constraints and fail-closed Result returns.
//   3. Export domain interfaces for high-integrity composition.
//
// residual: &mut destubbed to by-value.

type InflationConfig = struct {
    inflation_radius_milli: Int,
    inscribed_radius_milli: Int,
    cost_scaling_milli: Int
};

type Costmap2D = struct {
    width: Int,
    height: Int,
    resolution_milli: Int,
    origin_x_milli: Int,
    origin_y_milli: Int,
    costs: List[Int],
    inflation: InflationConfig
};

pub fn inflation_config_default() -> InflationConfig {
    return InflationConfig {
        inflation_radius_milli: 800,
        inscribed_radius_milli: 300,
        cost_scaling_milli: 5000
    };
}

pub fn costmap_2d_new(w: Int, h: Int, res_milli: Int, ox: Int, oy: Int, inf: InflationConfig) -> Costmap2D {
    let total: Int = w * h;
    let mut initial_costs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < total {
        initial_costs = list_push(initial_costs, 0);
        i = i + 1;
    }
    return Costmap2D {
        width: w,
        height: h,
        resolution_milli: res_milli,
        origin_x_milli: ox,
        origin_y_milli: oy,
        costs: initial_costs,
        inflation: inf
    };
}

pub fn costmap_in_bounds(cm: Costmap2D, mx: Int, my: Int) -> Bool {
    if mx < 0 {
        return false;
    }
    if mx >= cm.width {
        return false;
    }
    if my < 0 {
        return false;
    }
    if my >= cm.height {
        return false;
    }
    return true;
}

pub fn costmap_get_cost(cm: Costmap2D, mx: Int, my: Int) -> Int {
    if costmap_in_bounds(cm, mx, my) == false {
        return 255;
    }
    let idx: Int = (my * cm.width) + mx;
    return list_get(cm.costs, idx);
}

pub fn costmap_set_cost(cm: Costmap2D, mx: Int, my: Int, cost: Int) -> Costmap2D {
    if costmap_in_bounds(cm, mx, my) == false {
        return cm;
    }
    let target_idx: Int = (my * cm.width) + mx;
    let old_costs: List[Int] = cm.costs;
    let n: Int = list_len(old_costs);
    let mut new_costs: List[Int] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == target_idx {
            new_costs = list_push(new_costs, cost);
        } else {
            new_costs = list_push(new_costs, list_get(old_costs, i));
        }
        i = i + 1;
    }
    return Costmap2D {
        width: cm.width,
        height: cm.height,
        resolution_milli: cm.resolution_milli,
        origin_x_milli: cm.origin_x_milli,
        origin_y_milli: cm.origin_y_milli,
        costs: new_costs,
        inflation: cm.inflation
    };
}

pub fn costmap_compute_inflation_cost(dist_milli: Int, inscribed_milli: Int, radius_milli: Int, factor_milli: Int) -> Int {
    if dist_milli <= inscribed_milli {
        return 253;
    }
    if dist_milli > radius_milli {
        return 0;
    }
    let delta_d: Int = dist_milli - inscribed_milli;
    let denom: Int = 1000 + ((factor_milli * delta_d) / 1000);
    if denom <= 0 {
        return 253;
    }
    let cost: Int = (253 * 1000) / denom;
    if cost > 253 {
        return 253;
    }
    return cost;
}

pub fn costmap_mark_obstacle(cm: Costmap2D, mx: Int, my: Int) -> Costmap2D {
    return costmap_set_cost(cm, mx, my, 254);
}

pub fn costmap_is_lethal(cost: Int) -> Bool {
    if cost >= 253 {
        return true;
    }
    return false;
}
