// # Point Cloud Metric Space Primitives
//
// Logline: Implements multi-dimensional point cloud containers and standard pairwise metric space distance metrics.
//
// Setup: High-performance pure geometric coordinate arrays supporting Euclidean, Manhattan, Chebyshev, and Cosine metrics.
//
// Beats:
//   1. Define PointNd and PointCloud structures with coordinate storage.
//   2. Implement standard geometric distance functions between n-dimensional points.
//   3. Compute pairwise distance matrices, bounding radii, and point cloud centroids.

pub type PointNd = struct {
    coords: List[Float],
    dimension: Int,
    id: Int
};

pub type PointCloud = struct {
    points: List[PointNd],
    point_count: Int,
    dimension: Int
};

pub fn point_nd_new(id: Int, coords: List[Float]) -> PointNd {
    let dim: Int = list_len(coords);
    return PointNd {
        coords: coords,
        dimension: dim,
        id: id
    };
}

pub fn point_cloud_new(dimension: Int) -> PointCloud {
    let empty_points: List[PointNd] = list_new();
    return PointCloud {
        points: empty_points,
        point_count: 0,
        dimension: dimension
    };
}

pub fn point_cloud_add(cloud: &mut PointCloud, pt: PointNd) -> Bool {
    if (pt).dimension != (cloud).dimension {
        return false;
    }
    (cloud).points = list_push((cloud).points, pt);
    (cloud).point_count = (cloud).point_count + 1;
    return true;
}

pub fn point_cloud_get(cloud: &PointCloud, idx: Int) -> PointNd {
    return list_get((cloud).points, idx);
}

pub fn metric_euclidean_distance(p1: &PointNd, p2: &PointNd) -> Float {
    let dim: Int = (p1).dimension;
    let mut sum_sq: Float = 0.0;
    let mut i: Int = 0;
    while i < dim {
        let c1: Float = list_get((p1).coords, i);
        let c2: Float = list_get((p2).coords, i);
        let diff: Float = c1 - c2;
        sum_sq = sum_sq + (diff * diff);
        i = i + 1;
    }
    return sqrt(sum_sq);
}

pub fn metric_manhattan_distance(p1: &PointNd, p2: &PointNd) -> Float {
    let dim: Int = (p1).dimension;
    let mut sum_abs: Float = 0.0;
    let mut i: Int = 0;
    while i < dim {
        let c1: Float = list_get((p1).coords, i);
        let c2: Float = list_get((p2).coords, i);
        let diff: Float = c1 - c2;
        if diff < 0.0 {
            sum_abs = sum_abs - diff;
        } else {
            sum_abs = sum_abs + diff;
        }
        i = i + 1;
    }
    return sum_abs;
}

pub fn metric_chebyshev_distance(p1: &PointNd, p2: &PointNd) -> Float {
    let dim: Int = (p1).dimension;
    let mut max_diff: Float = 0.0;
    let mut i: Int = 0;
    while i < dim {
        let c1: Float = list_get((p1).coords, i);
        let c2: Float = list_get((p2).coords, i);
        let mut diff: Float = c1 - c2;
        if diff < 0.0 {
            diff = 0.0 - diff;
        }
        if diff > max_diff {
            max_diff = diff;
        }
        i = i + 1;
    }
    return max_diff;
}

pub fn metric_cosine_similarity(p1: &PointNd, p2: &PointNd) -> Float {
    let dim: Int = (p1).dimension;
    let mut dot: Float = 0.0;
    let mut norm1_sq: Float = 0.0;
    let mut norm2_sq: Float = 0.0;
    let mut i: Int = 0;
    while i < dim {
        let c1: Float = list_get((p1).coords, i);
        let c2: Float = list_get((p2).coords, i);
        dot = dot + (c1 * c2);
        norm1_sq = norm1_sq + (c1 * c1);
        norm2_sq = norm2_sq + (c2 * c2);
        i = i + 1;
    }
    let denom: Float = sqrt(norm1_sq) * sqrt(norm2_sq);
    if denom == 0.0 {
        return 0.0;
    }
    return dot / denom;
}

pub fn point_cloud_centroid(cloud: &PointCloud) -> List[Float] {
    let dim: Int = (cloud).dimension;
    let n: Int = (cloud).point_count;
    let mut centroid: List[Float] = list_new();
    if n == 0 {
        return centroid;
    }
    let mut d: Int = 0;
    while d < dim {
        let mut sum_coord: Float = 0.0;
        let mut p_idx: Int = 0;
        while p_idx < n {
            let pt: PointNd = list_get((cloud).points, p_idx);
            let c: Float = list_get((pt).coords, d);
            sum_coord = sum_coord + c;
            p_idx = p_idx + 1;
        }
        let avg: Float = sum_coord / (0.0 + (0.0 + 1.0 * sum_coord - sum_coord + 1.0 * sum_coord));
        // Better: calculate using loop or float count
        let mut count_f: Float = 0.0;
        let mut c_idx: Int = 0;
        while c_idx < n {
            count_f = count_f + 1.0;
            c_idx = c_idx + 1;
        }
        centroid = list_push(centroid, sum_coord / count_f);
        d = d + 1;
    }
    return centroid;
}

pub fn point_cloud_bounding_radius(cloud: &PointCloud, center: List[Float]) -> Float {
    let n: Int = (cloud).point_count;
    let center_pt: PointNd = point_nd_new(-1, center);
    let mut max_r: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let pt: PointNd = list_get((cloud).points, i);
        let dist: Float = metric_euclidean_distance(&pt, &center_pt);
        if dist > max_r {
            max_r = dist;
        }
        i = i + 1;
    }
    return max_r;
}
