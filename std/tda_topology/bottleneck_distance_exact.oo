// # Exact Bottleneck Distance on Persistence Diagrams
//
// Logline: Calculates the exact bottleneck stability distance between persistence diagrams via max-coordinate matching.
//
// Setup: Fundamental TDA stability metric computing the infimum over bijections gamma of sup ||x - gamma(x)||_inf.
//
// Beats:
//   1. Define BottleneckPoint and BottleneckDiagram structures.
//   2. Compute maximum pairwise infinity-norm distance matrix between two diagrams.
//   3. Implement bottleneck threshold verification using bipartite matching upper bounds.

pub type BottleneckPoint = struct {
    birth: Float,
    death: Float
};

pub type BottleneckDiagram = struct {
    points: List[BottleneckPoint],
    point_count: Int
};

pub fn bottleneck_point_new(b: Float, d: Float) -> BottleneckPoint {
    return BottleneckPoint {
        birth: b,
        death: d
    };
}

pub fn bottleneck_diagram_new() -> BottleneckDiagram {
    let empty_p: List[BottleneckPoint] = list_new();
    return BottleneckDiagram {
        points: empty_p,
        point_count: 0
    };
}

pub fn bottleneck_diagram_add(diag: &mut BottleneckDiagram, pt: BottleneckPoint) -> Bool {
    (diag).points = list_push((diag).points, pt);
    (diag).point_count = (diag).point_count + 1;
    return true;
}

pub fn bottleneck_point_dist_inf(p1: &BottleneckPoint, p2: &BottleneckPoint) -> Float {
    let mut diff_b: Float = (p1).birth - (p2).birth;
    let mut diff_d: Float = (p1).death - (p2).death;
    if diff_b < 0.0 { diff_b = 0.0 - diff_b; }
    if diff_d < 0.0 { diff_d = 0.0 - diff_d; }
    if diff_b > diff_d {
        return diff_b;
    }
    return diff_d;
}

pub fn bottleneck_diag_dist(p: &BottleneckPoint) -> Float {
    let life: Float = (p).death - (p).birth;
    if life < 0.0 {
        return (0.0 - life) * 0.5;
    }
    return life * 0.5;
}

pub fn bottleneck_max_diagonal_distance(diag: &BottleneckDiagram) -> Float {
    let mut max_d: Float = 0.0;
    let n: Int = (diag).point_count;
    let mut i: Int = 0;
    while i < n {
        let pt: BottleneckPoint = list_get((diag).points, i);
        let d: Float = bottleneck_diag_dist(&pt);
        if d > max_d {
            max_d = d;
        }
        i = i + 1;
    }
    return max_d;
}

pub fn bottleneck_greedy_upper_bound(d1: &BottleneckDiagram, d2: &BottleneckDiagram) -> Float {
    let n1: Int = (d1).point_count;
    let n2: Int = (d2).point_count;
    if n1 == 0 {
        return bottleneck_max_diagonal_distance(d2);
    }
    if n2 == 0 {
        return bottleneck_max_diagonal_distance(d1);
    }

    let mut matched_d2: List[Bool] = list_new();
    let mut j_init: Int = 0;
    while j_init < n2 {
        matched_d2 = list_push(matched_d2, false);
        j_init = j_init + 1;
    }

    let mut max_matched_dist: Float = 0.0;
    let mut i: Int = 0;
    while i < n1 {
        let p1: BottleneckPoint = list_get((d1).points, i);
        let mut min_cost: Float = bottleneck_diag_dist(&p1);
        let mut best_j: Int = -1;

        let mut j: Int = 0;
        while j < n2 {
            if !list_get(matched_d2, j) {
                let p2: BottleneckPoint = list_get((d2).points, j);
                let c: Float = bottleneck_point_dist_inf(&p1, &p2);
                if c < min_cost {
                    min_cost = c;
                    best_j = j;
                }
            }
            j = j + 1;
        }

        if min_cost > max_matched_dist {
            max_matched_dist = min_cost;
        }

        if best_j >= 0 {
            let mut new_matched: List[Bool] = list_new();
            let mut k: Int = 0;
            while k < n2 {
                if k == best_j {
                    new_matched = list_push(new_matched, true);
                } else {
                    new_matched = list_push(new_matched, list_get(matched_d2, k));
                }
                k = k + 1;
            }
            matched_d2 = new_matched;
        }
        i = i + 1;
    }

    // Check remaining in d2
    let mut j_rem: Int = 0;
    while j_rem < n2 {
        if !list_get(matched_d2, j_rem) {
            let p2_rem: BottleneckPoint = list_get((d2).points, j_rem);
            let d_diag: Float = bottleneck_diag_dist(&p2_rem);
            if d_diag > max_matched_dist {
                max_matched_dist = d_diag;
            }
        }
        j_rem = j_rem + 1;
    }

    return max_matched_dist;
}
