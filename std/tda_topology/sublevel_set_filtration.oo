// # Sublevel Set & Lower-Star Filtration
//
// Logline: Implements sublevel set filtrations on scalar functions, height fields, and triangulated terrain meshes.
//
// Setup: Continuous and discrete sublevel filtration mapping functional values f(x) <= t to expanding topological spaces.
//
// Beats:
//   1. Assign scalar function values f(v) to vertices of a simplicial mesh.
//   2. Compute lower-star filtration value of an edge or triangle as maximum of its vertex values.
//   3. Extract sublevel set complexes at arbitrary continuous threshold levels t.

pub type SublevelVertex = struct {
    vertex_id: Int,
    scalar_value: Float,
};

pub type SublevelSimplex = struct {
    simplex_id: Int,
    dimension: Int,
    birth_level: Float,
};

pub type SublevelFiltration = struct {
    vertices: List[SublevelVertex],
    simplices: List[SublevelSimplex],
    num_vertices: Int,
    num_simplices: Int,
};

pub fn sublevel_vertex_new(id: Int, val: Float) -> SublevelVertex {
    return SublevelVertex {
        vertex_id: id,
        scalar_value: val,
    };
}

pub fn sublevel_simplex_new(id: Int, dim: Int, birth: Float) -> SublevelSimplex {
    return SublevelSimplex {
        simplex_id: id,
        dimension: dim,
        birth_level: birth,
    };
}

pub fn sublevel_filtration_new() -> SublevelFiltration {
    let empty_v: List[SublevelVertex] = list_new();
    let empty_s: List[SublevelSimplex] = list_new();
    return SublevelFiltration {
        vertices: empty_v,
        simplices: empty_s,
        num_vertices: 0,
        num_simplices: 0,
    };
}

pub fn sublevel_add_vertex(f: &mut SublevelFiltration, v: SublevelVertex) -> Bool {
    (f).vertices = list_push((f).vertices, v);
    (f).num_vertices = (f).num_vertices + 1;
    let s0: SublevelSimplex = sublevel_simplex_new((v).vertex_id, 0, (v).scalar_value);
    (f).simplices = list_push((f).simplices, s0);
    (f).num_simplices = (f).num_simplices + 1;
    return true;
}

pub fn sublevel_add_edge_lower_star(
    f: &mut SublevelFiltration,
    edge_id: Int,
    u_idx: Int,
    v_idx: Int
) -> Bool {
    let u_vert: SublevelVertex = list_get((f).vertices, u_idx);
    let v_vert: SublevelVertex = list_get((f).vertices, v_idx);
    let mut birth: Float = (u_vert).scalar_value;
    if (v_vert).scalar_value > birth {
        birth = (v_vert).scalar_value;
    }
    let s1: SublevelSimplex = sublevel_simplex_new(edge_id, 1, birth);
    (f).simplices = list_push((f).simplices, s1);
    (f).num_simplices = (f).num_simplices + 1;
    return true;
}

pub fn sublevel_count_active(f: &SublevelFiltration, t: Float) -> Int {
    let mut count: Int = 0;
    let n: Int = (f).num_simplices;
    let mut i: Int = 0;
    while i < n {
        let s: SublevelSimplex = list_get((f).simplices, i);
        if (s).birth_level <= t {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
