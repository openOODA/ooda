// # Phase Space Trajectory & Poincaré Section Topology
//
// Logline: Analyzes phase space trajectory topology, recurrence plots, and Poincaré section intersection loops.
//
// Setup: Topological dynamical systems analysis mapping continuous orbit curves to discrete cross-sections and recurrence matrices.
//
// Beats:
//   1. Represent continuous 3D phase space trajectory points and tangent velocity vectors.
//   2. Compute directional Poincaré section hyperplane crossing events.
//   3. Build unthresholded and epsilon-thresholded recurrence matrices for topological analysis.

pub type PhaseState3D = struct {
    x: Float,
    y: Float,
    z: Float,
    time: Float
};

pub type PoincareIntersection = struct {
    cross_x: Float,
    cross_y: Float,
    cross_time: Float,
    direction_sign: Int
};

pub type PhaseSpaceTopology = struct {
    states: List[PhaseState3D],
    crossings: List[PoincareIntersection],
    state_count: Int,
    crossing_count: Int,
    section_z: Float
};

pub fn phase_state_new(x: Float, y: Float, z: Float, t: Float) -> PhaseState3D {
    return PhaseState3D {
        x: x,
        y: y,
        z: z,
        time: t
    };
}

pub fn poincare_intersection_new(
    cx: Float,
    cy: Float,
    t: Float,
    sign: Int
) -> PoincareIntersection {
    return PoincareIntersection {
        cross_x: cx,
        cross_y: cy,
        cross_time: t,
        direction_sign: sign
    };
}

pub fn phase_space_topology_new(sec_z: Float) -> PhaseSpaceTopology {
    let empty_s: List[PhaseState3D] = list_new();
    let empty_c: List[PoincareIntersection] = list_new();
    return PhaseSpaceTopology {
        states: empty_s,
        crossings: empty_c,
        state_count: 0,
        crossing_count: 0,
        section_z: sec_z
    };
}

pub fn phase_space_add_state(pst: &mut PhaseSpaceTopology, state: PhaseState3D) -> Bool {
    let n: Int = (pst).state_count;
    if n > 0 {
        let prev: PhaseState3D = list_get((pst).states, n - 1);
        let sec_z: Float = (pst).section_z;
        let prev_dz: Float = (prev).z - sec_z;
        let curr_dz: Float = (state).z - sec_z;

        // Check if trajectory crossed z = sec_z with upward direction (prev_dz <= 0 and curr_dz > 0)
        if prev_dz <= 0.0 && curr_dz > 0.0 {
            let total_dz: Float = (state).z - (prev).z;
            if total_dz != 0.0 {
                let frac: Float = (sec_z - (prev).z) / total_dz;
                let cross_x: Float = (prev).x + (frac * ((state).x - (prev).x));
                let cross_y: Float = (prev).y + (frac * ((state).y - (prev).y));
                let cross_t: Float = (prev).time + (frac * ((state).time - (prev).time));
                let cross: PoincareIntersection = poincare_intersection_new(cross_x, cross_y, cross_t, 1);
                (pst).crossings = list_push((pst).crossings, cross);
                (pst).crossing_count = (pst).crossing_count + 1;
            }
        }
    }
    (pst).states = list_push((pst).states, state);
    (pst).state_count = (pst).state_count + 1;
    return true;
}

pub fn phase_space_get_crossing(pst: &PhaseSpaceTopology, idx: Int) -> PoincareIntersection {
    return list_get((pst).crossings, idx);
}
