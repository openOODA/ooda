// # Zigzag Persistent Homology Core
//
// Logline: Tracks topological feature births and deaths across non-monotonic sequences of additions and deletions.
//
// Setup: Carlsson-de Silva zigzag persistent homology modeling dynamic topological spaces and time-varying point clouds.
//
// Beats:
//   1. Represent forward (addition) and backward (deletion) simplicial zigzag steps.
//   2. Define ZigzagInterval with start index and end index in filtration history.
//   3. Track active homology classes across dynamic complex insertions and deletions.

pub type ZigzagStep = struct {
    step_index: Int,
    simplex_id: Int,
    is_addition: Bool
};

pub type ZigzagInterval = struct {
    birth_step: Int,
    death_step: Int,
    dimension: Int,
    interval_id: Int
};

pub type ZigzagPersistence = struct {
    steps: List[ZigzagStep],
    step_count: Int,
    intervals: List[ZigzagInterval],
    interval_count: Int
};

pub fn zigzag_step_add(idx: Int, s_id: Int) -> ZigzagStep {
    return ZigzagStep {
        step_index: idx,
        simplex_id: s_id,
        is_addition: true
    };
}

pub fn zigzag_step_remove(idx: Int, s_id: Int) -> ZigzagStep {
    return ZigzagStep {
        step_index: idx,
        simplex_id: s_id,
        is_addition: false
    };
}

pub fn zigzag_interval_new(id: Int, b: Int, d: Int, dim: Int) -> ZigzagInterval {
    return ZigzagInterval {
        birth_step: b,
        death_step: d,
        dimension: dim,
        interval_id: id
    };
}

pub fn zigzag_persistence_new() -> ZigzagPersistence {
    let empty_s: List[ZigzagStep] = list_new();
    let empty_i: List[ZigzagInterval] = list_new();
    return ZigzagPersistence {
        steps: empty_s,
        step_count: 0,
        intervals: empty_i,
        interval_count: 0
    };
}

pub fn zigzag_add_step(zp: &mut ZigzagPersistence, step: ZigzagStep) -> Bool {
    (zp).steps = list_push((zp).steps, step);
    (zp).step_count = (zp).step_count + 1;
    return true;
}

pub fn zigzag_add_interval(zp: &mut ZigzagPersistence, iv: ZigzagInterval) -> Bool {
    (zp).intervals = list_push((zp).intervals, iv);
    (zp).interval_count = (zp).interval_count + 1;
    return true;
}

pub fn zigzag_interval_length(iv: &ZigzagInterval) -> Int {
    return (iv).death_step - (iv).birth_step;
}

pub fn zigzag_count_active_at_step(zp: &ZigzagPersistence, step_idx: Int) -> Int {
    let mut count: Int = 0;
    let n: Int = (zp).interval_count;
    let mut i: Int = 0;
    while i < n {
        let iv: ZigzagInterval = list_get((zp).intervals, i);
        if (iv).birth_step <= step_idx && step_idx <= (iv).death_step {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
