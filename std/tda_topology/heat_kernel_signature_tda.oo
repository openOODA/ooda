// # Persistence Heat Kernel & Scale-Space Signature
//
// Logline: Implements persistence scale-space heat kernels with Dirichlet boundary conditions along the diagonal.
//
// Setup: Reininghaus et al. positive definite kernel on persistence diagrams modeling Gaussian heat diffusion vanishing at y = x.
//
// Beats:
//   1. Represent 2D persistence points and their diagonal reflections (d, b).
//   2. Compute Dirichlet heat diffusion kernel vanishing along the diagonal y = x.
//   3. Calculate pairwise persistence scale-space kernel gram matrices for kernel ML methods.

pub type HeatPoint = struct {
    birth: Float,
    death: Float
};

pub type PersistenceHeatKernel = struct {
    sigma_scale: Float
};

pub fn heat_point_new(b: Float, d: Float) -> HeatPoint {
    return HeatPoint {
        birth: b,
        death: d
    };
}

pub fn persistence_heat_kernel_new(sigma: Float) -> PersistenceHeatKernel {
    return PersistenceHeatKernel {
        sigma_scale: sigma
    };
}

pub fn heat_kernel_eval_pair(
    p1: &HeatPoint,
    p2: &HeatPoint,
    sigma: Float
) -> Float {
    let two_sigma_sq: Float = 2.0 * sigma * sigma;
    if two_sigma_sq <= 0.0 {
        return 0.0;
    }

    // Direct Gaussian: ||p1 - p2||^2
    let db1: Float = (p1).birth - (p2).birth;
    let dd1: Float = (p1).death - (p2).death;
    let dist_direct_sq: Float = (db1 * db1) + (dd1 * dd1);
    let g_direct: Float = exp(0.0 - (dist_direct_sq / two_sigma_sq));

    // Reflected Gaussian: ||p1 - p2_bar||^2 where p2_bar = (p2.death, p2.birth)
    let db2: Float = (p1).birth - (p2).death;
    let dd2: Float = (p1).death - (p2).birth;
    let dist_refl_sq: Float = (db2 * db2) + (dd2 * dd2);
    let g_refl: Float = exp(0.0 - (dist_refl_sq / two_sigma_sq));

    let pi_val: Float = 3.141592653589793;
    let norm_factor: Float = 1.0 / (8.0 * pi_val * sigma * sigma);
    return (g_direct - g_refl) * norm_factor;
}

pub fn heat_kernel_diagram_similarity(
    hk: &PersistenceHeatKernel,
    pts1: List[HeatPoint],
    pts2: List[HeatPoint]
) -> Float {
    let n1: Int = list_len(pts1);
    let n2: Int = list_len(pts2);
    let sigma: Float = (hk).sigma_scale;

    let mut total_sim: Float = 0.0;
    let mut i: Int = 0;
    while i < n1 {
        let p1: HeatPoint = list_get(pts1, i);
        let mut j: Int = 0;
        while j < n2 {
            let p2: HeatPoint = list_get(pts2, j);
            let k_val: Float = heat_kernel_eval_pair(&p1, &p2, sigma);
            total_sim = total_sim + k_val;
            j = j + 1;
        }
        i = i + 1;
    }
    return total_sim;
}
