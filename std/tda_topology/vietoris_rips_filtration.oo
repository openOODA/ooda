// # Vietoris-Rips Simplicial Complex Filtration
//
// Logline: Constructs filtered Vietoris-Rips complexes from metric point clouds up to a maximum dimension and distance threshold.
//
// Setup: Canonical metric filtration mapping point cloud distance matrices to nested simplicial complexes by clique expansion.
//
// Beats:
//   1. Add 0-simplices at filtration parameter zero for all input vertices.
//   2. Add 1-simplices (edges) for all pairs with pairwise distance below threshold.
//   3. Expand 2-simplices (triangles) and 3-simplices whose boundaries are fully present with max-edge filtration.

pub type RipsFiltrationConfig = struct {
    max_dimension: Int,
    max_distance: Float,
    num_points: Int,
};

pub type VrSimplexEntry = struct {
    v0: Int,
    v1: Int,
    v2: Int,
    dim: Int,
    filtration: Float,
};

pub type VrComplex = struct {
    simplices: List[VrSimplexEntry],
    simplex_count: Int,
    config: RipsFiltrationConfig,
};

pub fn vr_config_new(max_dim: Int, max_dist: Float, n_points: Int) -> RipsFiltrationConfig {
    return RipsFiltrationConfig {
        max_dimension: max_dim,
        max_distance: max_dist,
        num_points: n_points,
    };
}

pub fn vr_simplex_0d(v: Int) -> VrSimplexEntry {
    return VrSimplexEntry {
        v0: v,
        v1: -1,
        v2: -1,
        dim: 0,
        filtration: 0.0,
    };
}

pub fn vr_simplex_1d(u: Int, v: Int, weight: Float) -> VrSimplexEntry {
    return VrSimplexEntry {
        v0: u,
        v1: v,
        v2: -1,
        dim: 1,
        filtration: weight,
    };
}

pub fn vr_simplex_2d(u: Int, v: Int, w: Int, filt: Float) -> VrSimplexEntry {
    return VrSimplexEntry {
        v0: u,
        v1: v,
        v2: w,
        dim: 2,
        filtration: filt,
    };
}

pub fn vr_complex_new(cfg: RipsFiltrationConfig) -> VrComplex {
    let empty_s: List[VrSimplexEntry] = list_new();
    return VrComplex {
        simplices: empty_s,
        simplex_count: 0,
        config: cfg,
    };
}

pub fn vr_complex_build_0d(c: &mut VrComplex) -> Int {
    let n: Int = ((c).config).num_points;
    let mut i: Int = 0;
    while i < n {
        let s0: VrSimplexEntry = vr_simplex_0d(i);
        (c).simplices = list_push((c).simplices, s0);
        (c).simplex_count = (c).simplex_count + 1;
        i = i + 1;
    }
    return n;
}

pub fn vr_complex_add_edge_if_valid(c: &mut VrComplex, u: Int, v: Int, dist: Float) -> Bool {
    let max_d: Float = ((c).config).max_distance;
    if dist > max_d {
        return false;
    }
    let s1: VrSimplexEntry = vr_simplex_1d(u, v, dist);
    (c).simplices = list_push((c).simplices, s1);
    (c).simplex_count = (c).simplex_count + 1;
    return true;
}

pub fn vr_complex_add_triangle_if_valid(
    c: &mut VrComplex,
    u: Int, v: Int, w: Int,
    d_uv: Float, d_vw: Float, d_uw: Float
) -> Bool {
    let max_d: Float = ((c).config).max_distance;
    if d_uv > max_d || d_vw > max_d || d_uw > max_d {
        return false;
    }
    let mut max_filt: Float = d_uv;
    if d_vw > max_filt {
        max_filt = d_vw;
    }
    if d_uw > max_filt {
        max_filt = d_uw;
    }
    let s2: VrSimplexEntry = vr_simplex_2d(u, v, w, max_filt);
    (c).simplices = list_push((c).simplices, s2);
    (c).simplex_count = (c).simplex_count + 1;
    return true;
}

pub fn vr_complex_get_simplex(c: &VrComplex, idx: Int) -> VrSimplexEntry {
    return list_get((c).simplices, idx);
}
