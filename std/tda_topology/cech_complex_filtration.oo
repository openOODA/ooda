// # Cech Complex & Nerve Intersection Filtration
//
// Logline: Constructs exact Cech simplicial complexes using minimum enclosing ball intersection radii and nerve representations.
//
// Setup: Exact Nerve-theorem compliant topological filtration capturing true metric ball union topology.
//
// Beats:
//   1. Define CechSimplex with minimum enclosing ball radius as filtration parameter.
//   2. Compute 1-simplex Cech radius as half pairwise distance.
//   3. Compute 2-simplex Cech radius using acute/obtuse triangle enclosing disk logic.

pub type CechSimplex = struct {
    vertices: List[Int],
    dimension: Int,
    cech_radius: Float,
    id: Int
};

pub type CechComplex = struct {
    simplices: List[CechSimplex],
    simplex_count: Int,
    max_radius: Float
};

pub fn cech_simplex_new(id: Int, vertices: List[Int], r: Float) -> CechSimplex {
    let dim: Int = list_len(vertices) - 1;
    return CechSimplex {
        vertices: vertices,
        dimension: dim,
        cech_radius: r,
        id: id
    };
}

pub fn cech_complex_new(max_radius: Float) -> CechComplex {
    let empty_s: List[CechSimplex] = list_new();
    return CechComplex {
        simplices: empty_s,
        simplex_count: 0,
        max_radius: max_radius
    };
}

pub fn cech_radius_1d(pairwise_dist: Float) -> Float {
    return pairwise_dist * 0.5;
}

pub fn cech_radius_2d_triangle(
    a: Float, b: Float, c: Float
) -> Float {
    // Check if triangle is obtuse (one angle >= 90 deg)
    // If obtuse, enclosing disk diameter is longest edge
    let a_sq: Float = a * a;
    let b_sq: Float = b * b;
    let c_sq: Float = c * c;

    if a_sq >= (b_sq + c_sq) {
        return a * 0.5;
    }
    if b_sq >= (a_sq + c_sq) {
        return b * 0.5;
    }
    if c_sq >= (a_sq + b_sq) {
        return c * 0.5;
    }

    // Acute triangle: enclosing radius is circumradius R = a*b*c / (4*Area)
    let s: Float = (a + b + c) * 0.5;
    let area_sq: Float = s * (s - a) * (s - b) * (s - c);
    if area_sq <= 0.0 {
        return a * 0.5;
    }
    let area: Float = sqrt(area_sq);
    return (a * b * c) / (4.0 * area);
}

pub fn cech_complex_add_simplex(c: &mut CechComplex, s: CechSimplex) -> Bool {
    if (s).cech_radius > (c).max_radius {
        return false;
    }
    (c).simplices = list_push((c).simplices, s);
    (c).simplex_count = (c).simplex_count + 1;
    return true;
}

pub fn cech_complex_get_simplex(c: &CechComplex, idx: Int) -> CechSimplex {
    return list_get((c).simplices, idx);
}
