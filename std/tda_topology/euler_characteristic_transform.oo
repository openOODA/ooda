// # Euler Characteristic Transform (ECT)
//
// Logline: Implements the Euler Characteristic Transform across multi-directional hyperplane sweep filtrations for shape analysis.
//
// Setup: Turner et al. injective shape representation measuring directional Euler curves across the unit sphere.
//
// Beats:
//   1. Represent 2D/3D geometric vertex coordinates and simplicial face structures.
//   2. Project vertices onto unit directional vectors v in S^{d-1}.
//   3. Compute directional Euler Characteristic Curves chi_{v}(t) along the filtration height axis.

pub type EctDirection = struct {
    dir_x: Float,
    dir_y: Float,
};

pub type EctVertex = struct {
    x: Float,
    y: Float,
    id: Int,
};

pub type EctSimplex = struct {
    dim: Int,
    v0: Int,
    v1: Int,
    v2: Int,
};

pub type EulerCharacteristicTransform = struct {
    directions: List[EctDirection],
    vertices: List[EctVertex],
    simplices: List[EctSimplex],
    num_directions: Int,
    num_vertices: Int,
    num_simplices: Int,
};

pub fn ect_direction_new(dx: Float, dy: Float) -> EctDirection {
    let norm: Float = sqrt((dx * dx) + (dy * dy));
    if norm == 0.0 {
        return EctDirection { dir_x: 1.0, dir_y: 0.0 };
    }
    return EctDirection {
        dir_x: dx / norm,
        dir_y: dy / norm,
    };
}

pub fn ect_vertex_new(id: Int, x: Float, y: Float) -> EctVertex {
    return EctVertex {
        x: x,
        y: y,
        id: id,
    };
}

pub fn ect_simplex_0d(v0: Int) -> EctSimplex {
    return EctSimplex { dim: 0, v0: v0, v1: -1, v2: -1 };
}

pub fn ect_simplex_1d(v0: Int, v1: Int) -> EctSimplex {
    return EctSimplex { dim: 1, v0: v0, v1: v1, v2: -1 };
}

pub fn ect_simplex_2d(v0: Int, v1: Int, v2: Int) -> EctSimplex {
    return EctSimplex { dim: 2, v0: v0, v1: v1, v2: v2 };
}

pub fn ect_new() -> EulerCharacteristicTransform {
    let empty_d: List[EctDirection] = list_new();
    let empty_v: List[EctVertex] = list_new();
    let empty_s: List[EctSimplex] = list_new();
    return EulerCharacteristicTransform {
        directions: empty_d,
        vertices: empty_v,
        simplices: empty_s,
        num_directions: 0,
        num_vertices: 0,
        num_simplices: 0,
    };
}

pub fn ect_add_direction(ect: &mut EulerCharacteristicTransform, dx: Float, dy: Float) -> Bool {
    let dir: EctDirection = ect_direction_new(dx, dy);
    (ect).directions = list_push((ect).directions, dir);
    (ect).num_directions = (ect).num_directions + 1;
    return true;
}

pub fn ect_add_vertex(ect: &mut EulerCharacteristicTransform, x: Float, y: Float) -> Int {
    let id: Int = (ect).num_vertices;
    let v: EctVertex = ect_vertex_new(id, x, y);
    (ect).vertices = list_push((ect).vertices, v);
    (ect).num_vertices = (ect).num_vertices + 1;
    return id;
}

pub fn ect_add_simplex(ect: &mut EulerCharacteristicTransform, s: EctSimplex) -> Bool {
    (ect).simplices = list_push((ect).simplices, s);
    (ect).num_simplices = (ect).num_simplices + 1;
    return true;
}

pub fn ect_compute_height(v: &EctVertex, dir: &EctDirection) -> Float {
    return ((v).x * (dir).dir_x) + ((v).y * (dir).dir_y);
}
