// # Torus Coordinates & Multi-Cocycle Embeddings
//
// Logline: Implements multi-dimensional torus parametrization T^k = (S^1)^k from k independent persistent 1-cocycles.
//
// Setup: Higher-order topological embedding mapping quasi-periodic data to k-torus coordinates (theta_1, ..., theta_k).
//
// Beats:
//   1. Combine k independent circular coordinate mappings into a k-dimensional torus coordinate vector.
//   2. Compute geodesic distance on flat k-torus metric d_{T^k}(x, y)^2 = sum d_{S^1}(x_i, y_i)^2.
//   3. Extract 3D torus embedding coordinates (x, y, z) for visualization of 2-torus state spaces.

pub type TorusPoint = struct {
    point_id: Int,
    theta_angles: List[Float],
    num_cycles: Int,
};

pub type TorusEmbedding = struct {
    points: List[TorusPoint],
    point_count: Int,
    k_dimension: Int,
};

pub fn torus_point_new(id: Int, angles: List[Float]) -> TorusPoint {
    let k: Int = list_len(angles);
    return TorusPoint {
        point_id: id,
        theta_angles: angles,
        num_cycles: k,
    };
}

pub fn torus_embedding_new(k_dim: Int) -> TorusEmbedding {
    let empty_p: List[TorusPoint] = list_new();
    return TorusEmbedding {
        points: empty_p,
        point_count: 0,
        k_dimension: k_dim,
    };
}

pub fn torus_embedding_add_point(te: &mut TorusEmbedding, pt: TorusPoint) -> Bool {
    if (pt).num_cycles != (te).k_dimension {
        return false;
    }
    (te).points = list_push((te).points, pt);
    (te).point_count = (te).point_count + 1;
    return true;
}

pub fn torus_angular_diff(a1: Float, a2: Float) -> Float {
    let pi_val: Float = 3.141592653589793;
    let two_pi: Float = 2.0 * pi_val;
    let mut diff: Float = a1 - a2;
    if diff < 0.0 { diff = 0.0 - diff; }
    while diff >= two_pi { diff = diff - two_pi; }
    if diff > pi_val {
        return two_pi - diff;
    }
    return diff;
}

pub fn torus_geodesic_distance_sq(p1: &TorusPoint, p2: &TorusPoint) -> Float {
    let k: Int = (p1).num_cycles;
    let mut sum_sq: Float = 0.0;
    let mut i: Int = 0;
    while i < k {
        let a1: Float = list_get((p1).theta_angles, i);
        let a2: Float = list_get((p2).theta_angles, i);
        let d: Float = torus_angular_diff(a1, a2);
        sum_sq = sum_sq + (d * d);
        i = i + 1;
    }
    return sum_sq;
}

pub fn torus_2d_to_3d_coords(theta: Float, phi: Float, r_major: Float, r_minor: Float) -> List[Float] {
    let x: Float = (r_major + (r_minor * cos(phi))) * cos(theta);
    let y: Float = (r_major + (r_minor * cos(phi))) * sin(theta);
    let z: Float = r_minor * sin(phi);
    let mut out: List[Float] = list_new();
    out = list_push(out, x);
    out = list_push(out, y);
    out = list_push(out, z);
    return out;
}
