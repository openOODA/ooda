// # Extended Persistent Homology
//
// Logline: Implements extended persistence pairing Ordinary, Relative, Extended-Ascending, and Extended-Descending topological features.
//
// Setup: Cohen-Steiner, Edelsbrunner, and Harer extended persistent homology mapping manifold critical points to 4 diagram types.
//
// Beats:
//   1. Classify persistence pairs into Ord, Rel, Ext+, and Ext- categories.
//   2. Track ascending and descending filtration sequences on manifolds.
//   3. Compute extended Betti numbers and total essential persistence.

pub type ExtendedPairType = struct {
    type_code: Int, // 0 = Ordinary, 1 = Relative, 2 = ExtendedPlus, 3 = ExtendedMinus
};

pub type ExtendedPair = struct {
    birth_val: Float,
    death_val: Float,
    dimension: Int,
    pair_type: Int,
    pair_id: Int,
};

pub type ExtendedPersistenceDiagram = struct {
    pairs: List[ExtendedPair],
    pair_count: Int,
    manifold_dim: Int,
};

pub fn extended_pair_new(id: Int, b: Float, d: Float, dim: Int, p_type: Int) -> ExtendedPair {
    return ExtendedPair {
        birth_val: b,
        death_val: d,
        dimension: dim,
        pair_type: p_type,
        pair_id: id,
    };
}

pub fn extended_diagram_new(manifold_dim: Int) -> ExtendedPersistenceDiagram {
    let empty_p: List[ExtendedPair] = list_new();
    return ExtendedPersistenceDiagram {
        pairs: empty_p,
        pair_count: 0,
        manifold_dim: manifold_dim,
    };
}

pub fn extended_diagram_add(
    ed: &mut ExtendedPersistenceDiagram,
    pair: ExtendedPair
) -> Bool {
    (ed).pairs = list_push((ed).pairs, pair);
    (ed).pair_count = (ed).pair_count + 1;
    return true;
}

pub fn extended_diagram_count_type(
    ed: &ExtendedPersistenceDiagram,
    p_type: Int
) -> Int {
    let mut count: Int = 0;
    let n: Int = (ed).pair_count;
    let mut i: Int = 0;
    while i < n {
        let p: ExtendedPair = list_get((ed).pairs, i);
        if (p).pair_type == p_type {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn extended_pair_persistence(p: &ExtendedPair) -> Float {
    let diff: Float = (p).death_val - (p).birth_val;
    if diff < 0.0 {
        return 0.0 - diff;
    }
    return diff;
}

pub fn extended_diagram_get(ed: &ExtendedPersistenceDiagram, idx: Int) -> ExtendedPair {
    return list_get((ed).pairs, idx);
}
