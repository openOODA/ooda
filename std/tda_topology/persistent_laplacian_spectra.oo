// # Persistent Laplacian Operators & Spectra
//
// Logline: Implements persistent Laplacian operators Delta_k^p, Schur complements, and persistent harmonic spectral gaps.
//
// Setup: Wang, Wei, and Memoli persistent Laplacians capturing both topological persistence (kernel dim) and geometric shape (eigenvalues).
//
// Beats:
//   1. Represent boundary matrix products d_{k+1} d_{k+1}^T and coboundary products d_k^T d_k.
//   2. Form persistent Laplacian matrix Delta_k^p over simplicial inclusions K_t subset K_{t+p}.
//   3. Compute smallest non-zero spectral eigenvalue lambda_1 (topological spectral gap).

pub type LaplacianMatrix = struct {
    dim_size: Int,
    entries: List[Float]
};

pub type PersistentLaplacian = struct {
    k_dimension: Int,
    filtration_p: Float,
    matrix: LaplacianMatrix,
    harmonic_betti_dim: Int,
    spectral_gap: Float
};

pub fn laplacian_matrix_new(size: Int) -> LaplacianMatrix {
    let total: Int = size * size;
    let mut data: List[Float] = list_new();
    let mut i: Int = 0;
    while i < total {
        data = list_push(data, 0.0);
        i = i + 1;
    }
    return LaplacianMatrix {
        dim_size: size,
        entries: data
    };
}

pub fn laplacian_matrix_set(mat: &mut LaplacianMatrix, r: Int, c: Int, val: Float) -> Bool {
    let n: Int = (mat).dim_size;
    if r < 0 || r >= n || c < 0 || c >= n {
        return false;
    }
    let idx: Int = (r * n) + c;
    let total: Int = n * n;
    let mut new_entries: List[Float] = list_new();
    let mut i: Int = 0;
    while i < total {
        if i == idx {
            new_entries = list_push(new_entries, val);
        } else {
            new_entries = list_push(new_entries, list_get((mat).entries, i));
        }
        i = i + 1;
    }
    (mat).entries = new_entries;
    return true;
}

pub fn laplacian_matrix_get(mat: &LaplacianMatrix, r: Int, c: Int) -> Float {
    let n: Int = (mat).dim_size;
    let idx: Int = (r * n) + c;
    return list_get((mat).entries, idx);
}

pub fn persistent_laplacian_new(k_dim: Int, p_filt: Float, size: Int) -> PersistentLaplacian {
    let mat: LaplacianMatrix = laplacian_matrix_new(size);
    return PersistentLaplacian {
        k_dimension: k_dim,
        filtration_p: p_filt,
        matrix: mat,
        harmonic_betti_dim: 0,
        spectral_gap: 0.0
    };
}

pub fn persistent_laplacian_trace(pl: &PersistentLaplacian) -> Float {
    let n: Int = ((pl).matrix).dim_size;
    let mut tr: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        tr = tr + laplacian_matrix_get(&(pl).matrix, i, i);
        i = i + 1;
    }
    return tr;
}
