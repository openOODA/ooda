// # Persistence Silhouettes & Weighted Functional Summaries
//
// Logline: Calculates power-weighted persistence silhouettes aggregating persistence tent functions into 1D functional profiles.
//
// Setup: Chazal et al. persistence silhouettes providing stable, computationally efficient functional representations for TDA.
//
// Beats:
//   1. Assign persistence power weights w_i = (death_i - birth_i)^p.
//   2. Compute weighted average of elementary tent functions phi_p(t) = sum(w_i * Lambda_i(t)) / sum(w_i).
//   3. Extract discretized silhouette feature vectors and peak maximum values.

pub type SilhouetteInterval = struct {
    birth: Float,
    death: Float,
    weight: Float,
};

pub type PersistenceSilhouette = struct {
    intervals: List[SilhouetteInterval],
    interval_count: Int,
    p_power: Float,
    total_weight: Float,
    t_min: Float,
    t_max: Float,
    num_samples: Int,
};

pub fn silhouette_interval_new(b: Float, d: Float, p_power: Float) -> SilhouetteInterval {
    let life: Float = d - b;
    let mut w: Float = life;
    if p_power == 1.0 {
        w = life;
    } else if p_power == 2.0 {
        w = life * life;
    }
    return SilhouetteInterval {
        birth: b,
        death: d,
        weight: w,
    };
}

pub fn persistence_silhouette_new(
    p_pow: Float,
    t_min: Float,
    t_max: Float,
    n_samples: Int
) -> PersistenceSilhouette {
    let empty_i: List[SilhouetteInterval] = list_new();
    return PersistenceSilhouette {
        intervals: empty_i,
        interval_count: 0,
        p_power: p_pow,
        total_weight: 0.0,
        t_min: t_min,
        t_max: t_max,
        num_samples: n_samples,
    };
}

pub fn persistence_silhouette_add(ps: &mut PersistenceSilhouette, b: Float, d: Float) -> Bool {
    if d <= b {
        return false;
    }
    let p_pow: Float = (ps).p_power;
    let iv: SilhouetteInterval = silhouette_interval_new(b, d, p_pow);
    (ps).intervals = list_push((ps).intervals, iv);
    (ps).interval_count = (ps).interval_count + 1;
    (ps).total_weight = (ps).total_weight + (iv).weight;
    return true;
}

pub fn silhouette_tent_eval(b: Float, d: Float, t: Float) -> Float {
    if t <= b || t >= d {
        return 0.0;
    }
    let mid: Float = (b + d) * 0.5;
    if t <= mid {
        return t - b;
    } else {
        return d - t;
    }
}

pub fn persistence_silhouette_eval_at(ps: &PersistenceSilhouette, t: Float) -> Float {
    let tot_w: Float = (ps).total_weight;
    if tot_w <= 0.0 {
        return 0.0;
    }
    let mut sum_weighted: Float = 0.0;
    let n: Int = (ps).interval_count;
    let mut i: Int = 0;
    while i < n {
        let iv: SilhouetteInterval = list_get((ps).intervals, i);
        let tent: Float = silhouette_tent_eval((iv).birth, (iv).death, t);
        sum_weighted = sum_weighted + ((iv).weight * tent);
        i = i + 1;
    }
    return sum_weighted / tot_w;
}

pub fn persistence_silhouette_discretize(ps: &PersistenceSilhouette) -> List[Float] {
    let mut samples: List[Float] = list_new();
    let n: Int = (ps).num_samples;
    if n <= 1 {
        return samples;
    }
    let t_min: Float = (ps).t_min;
    let t_max: Float = (ps).t_max;

    let mut i: Int = 0;
    while i < n {
        let mut i_f: Float = 0.0;
        let mut c: Int = 0;
        while c < i { i_f = i_f + 1.0; c = c + 1; }
        let mut n_f: Float = 0.0;
        let mut cn: Int = 0;
        while cn < (n - 1) { n_f = n_f + 1.0; cn = cn + 1; }

        let t: Float = t_min + ((t_max - t_min) * (i_f / n_f));
        let val: Float = persistence_silhouette_eval_at(ps, t);
        samples = list_push(samples, val);
        i = i + 1;
    }
    return samples;
}
