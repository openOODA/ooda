// # Discrete Morse Theory & Morse-Smale Complexes
//
// Logline: Implements Forman discrete Morse theory, discrete gradient vector fields, and critical simplex classifications.
//
// Setup: Forman discrete Morse gradient pairs (alpha < beta) reducing simplicial complexes to minimal critical cell complexes.
//
// Beats:
//   1. Represent discrete vector field pairings between codimension-1 face pairs (alpha, beta).
//   2. Identify critical simplices (minima index 0, 1-saddles, 2-saddles, maxima).
//   3. Compute discrete gradient paths (V-paths) connecting critical cells into Morse-Smale complexes.

pub type MorsePair = struct {
    face_simplex_id: Int,
    coface_simplex_id: Int,
    dimension: Int,
};

pub type CriticalSimplex = struct {
    simplex_id: Int,
    morse_index: Int,
    filtration_val: Float,
};

pub type DiscreteMorseField = struct {
    num_simplices: Int,
    pairs: List[MorsePair],
    critical_simplices: List[CriticalSimplex],
    pair_count: Int,
    critical_count: Int,
};

pub fn morse_pair_new(face_id: Int, coface_id: Int, dim: Int) -> MorsePair {
    return MorsePair {
        face_simplex_id: face_id,
        coface_simplex_id: coface_id,
        dimension: dim,
    };
}

pub fn critical_simplex_new(s_id: Int, m_idx: Int, filt: Float) -> CriticalSimplex {
    return CriticalSimplex {
        simplex_id: s_id,
        morse_index: m_idx,
        filtration_val: filt,
    };
}

pub fn discrete_morse_field_new(n_simplices: Int) -> DiscreteMorseField {
    let empty_p: List[MorsePair] = list_new();
    let empty_c: List[CriticalSimplex] = list_new();
    return DiscreteMorseField {
        num_simplices: n_simplices,
        pairs: empty_p,
        critical_simplices: empty_c,
        pair_count: 0,
        critical_count: 0,
    };
}

pub fn morse_field_add_pair(dmf: &mut DiscreteMorseField, pair: MorsePair) -> Bool {
    (dmf).pairs = list_push((dmf).pairs, pair);
    (dmf).pair_count = (dmf).pair_count + 1;
    return true;
}

pub fn morse_field_add_critical(dmf: &mut DiscreteMorseField, crit: CriticalSimplex) -> Bool {
    (dmf).critical_simplices = list_push((dmf).critical_simplices, crit);
    (dmf).critical_count = (dmf).critical_count + 1;
    return true;
}

pub fn morse_field_count_critical_dim(dmf: &DiscreteMorseField, index: Int) -> Int {
    let mut count: Int = 0;
    let n: Int = (dmf).critical_count;
    let mut i: Int = 0;
    while i < n {
        let c: CriticalSimplex = list_get((dmf).critical_simplices, i);
        if (c).morse_index == index {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn morse_euler_characteristic(dmf: &DiscreteMorseField) -> Int {
    let c0: Int = morse_field_count_critical_dim(dmf, 0);
    let c1: Int = morse_field_count_critical_dim(dmf, 1);
    let c2: Int = morse_field_count_critical_dim(dmf, 2);
    let c3: Int = morse_field_count_critical_dim(dmf, 3);
    return c0 - c1 + c2 - c3;
}
