// # Rips Graph 1-Skeleton & Epsilon Adjacency
//
// Logline: Constructs epsilon-neighborhood graphs and 1-skeletons from metric point clouds with connected component labeling.
//
// Setup: Geometric proximity graph generation for Vietoris-Rips complexes and topological cluster analysis.
//
// Beats:
//   1. Define RipsEdge and RipsGraph structures storing graph edges and threshold limits.
//   2. Extract 1-skeleton edges satisfying pairwise epsilon distance bounds.
//   3. Compute connected components and degree distributions on the proximity graph.

pub type RipsEdge = struct {
    u: Int,
    v: Int,
    weight: Float,
};

pub type RipsGraph = struct {
    num_vertices: Int,
    edges: List[RipsEdge],
    edge_count: Int,
    epsilon: Float,
};

pub fn rips_edge_new(u: Int, v: Int, weight: Float) -> RipsEdge {
    return RipsEdge {
        u: u,
        v: v,
        weight: weight,
    };
}

pub fn rips_graph_new(num_vertices: Int, epsilon: Float) -> RipsGraph {
    let empty_edges: List[RipsEdge] = list_new();
    return RipsGraph {
        num_vertices: num_vertices,
        edges: empty_edges,
        edge_count: 0,
        epsilon: epsilon,
    };
}

pub fn rips_graph_add_edge(g: &mut RipsGraph, u: Int, v: Int, weight: Float) -> Bool {
    if weight > (g).epsilon {
        return false;
    }
    let edge: RipsEdge = rips_edge_new(u, v, weight);
    (g).edges = list_push((g).edges, edge);
    (g).edge_count = (g).edge_count + 1;
    return true;
}

pub fn rips_graph_get_edge(g: &RipsGraph, idx: Int) -> RipsEdge {
    return list_get((g).edges, idx);
}

pub fn rips_graph_vertex_degree(g: &RipsGraph, vertex_id: Int) -> Int {
    let mut deg: Int = 0;
    let n: Int = (g).edge_count;
    let mut i: Int = 0;
    while i < n {
        let e: RipsEdge = list_get((g).edges, i);
        if (e).u == vertex_id || (e).v == vertex_id {
            deg = deg + 1;
        }
        i = i + 1;
    }
    return deg;
}

pub fn rips_graph_find_components_uf(num_verts: Int, edges: List[RipsEdge]) -> List[Int] {
    let mut parent: List[Int] = list_new();
    let mut i: Int = 0;
    while i < num_verts {
        parent = list_push(parent, i);
        i = i + 1;
    }

    let num_e: Int = list_len(edges);
    let mut e_idx: Int = 0;
    while e_idx < num_e {
        let edge: RipsEdge = list_get(edges, e_idx);
        let mut root_u: Int = (edge).u;
        while list_get(parent, root_u) != root_u {
            root_u = list_get(parent, root_u);
        }
        let mut root_v: Int = (edge).v;
        while list_get(parent, root_v) != root_v {
            root_v = list_get(parent, root_v);
        }
        if root_u != root_v {
            let mut new_parent: List[Int] = list_new();
            let mut p_idx: Int = 0;
            while p_idx < num_verts {
                if p_idx == root_u {
                    new_parent = list_push(new_parent, root_v);
                } else {
                    new_parent = list_push(new_parent, list_get(parent, p_idx));
                }
                p_idx = p_idx + 1;
            }
            parent = new_parent;
        }
        e_idx = e_idx + 1;
    }

    // Compress paths
    let mut final_comp: List[Int] = list_new();
    let mut v: Int = 0;
    while v < num_verts {
        let mut curr: Int = v;
        while list_get(parent, curr) != curr {
            curr = list_get(parent, curr);
        }
        final_comp = list_push(final_comp, curr);
        v = v + 1;
    }
    return final_comp;
}

pub fn rips_graph_count_components(comp_labels: List[Int]) -> Int {
    let n: Int = list_len(comp_labels);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let root: Int = list_get(comp_labels, i);
        if root == i {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
