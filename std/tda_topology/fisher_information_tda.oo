// # Persistence Fisher Information Metric
//
// Logline: Implements Fisher information geometry and Hellinger-Bhattacharyya distances on smoothed persistence measures.
//
// Setup: Le and Yamada persistence Fisher kernel mapping persistence diagrams to probability density spaces with Fisher metrics.
//
// Beats:
//   1. Represent continuous density estimates of persistence diagrams using normalized Gaussians.
//   2. Compute Fisher information metric on 2D discretized grid bins.
//   3. Calculate Hellinger and Bhattacharyya distances between persistence probability measures.

pub type FisherPoint = struct {
    birth: Float,
    death: Float,
    weight: Float
};

pub type FisherMeasure = struct {
    points: List[FisherPoint],
    point_count: Int,
    bandwidth: Float,
    total_weight: Float
};

pub fn fisher_point_new(b: Float, d: Float) -> FisherPoint {
    let life: Float = d - b;
    let mut w: Float = life;
    if w < 0.0 { w = 0.0 - w; }
    // Bounded weighting function w / (1.0 + w) mapping [0, inf) -> [0, 1)
    let bounded_w: Float = w / (1.0 + w);
    return FisherPoint {
        birth: b,
        death: d,
        weight: bounded_w
    };
}

pub fn fisher_measure_new(sigma: Float) -> FisherMeasure {
    let empty_p: List[FisherPoint] = list_new();
    return FisherMeasure {
        points: empty_p,
        point_count: 0,
        bandwidth: sigma,
        total_weight: 0.0
    };
}

pub fn fisher_measure_add(fm: &mut FisherMeasure, b: Float, d: Float) -> Bool {
    let pt: FisherPoint = fisher_point_new(b, d);
    (fm).points = list_push((fm).points, pt);
    (fm).point_count = (fm).point_count + 1;
    (fm).total_weight = (fm).total_weight + (pt).weight;
    return true;
}

pub fn fisher_measure_density_at(fm: &FisherMeasure, x: Float, y: Float) -> Float {
    let n: Int = (fm).point_count;
    let sigma: Float = (fm).bandwidth;
    let two_s_sq: Float = 2.0 * sigma * sigma;
    if two_s_sq <= 0.0 || (fm).total_weight <= 0.0 {
        return 0.0;
    }

    let mut sum_val: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let pt: FisherPoint = list_get((fm).points, i);
        let dx: Float = x - (pt).birth;
        let dy: Float = y - (pt).death;
        let dist_sq: Float = (dx * dx) + (dy * dy);
        let g: Float = exp(0.0 - (dist_sq / two_s_sq));
        sum_val = sum_val + ((pt).weight * g);
        i = i + 1;
    }
    return sum_val / (fm).total_weight;
}

pub fn hellinger_distance_discrete(
    p_probs: List[Float],
    q_probs: List[Float]
) -> Float {
    let n: Int = list_len(p_probs);
    let mut sum_sq_diff: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let p: Float = list_get(p_probs, i);
        let q: Float = list_get(q_probs, i);
        let diff: Float = sqrt(p) - sqrt(q);
        sum_sq_diff = sum_sq_diff + (diff * diff);
        i = i + 1;
    }
    return sqrt(sum_sq_diff * 0.5);
}
