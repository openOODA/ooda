// # Sliced Wasserstein Distance & Kernel
//
// Logline: Implements Sliced Wasserstein distance between persistence diagrams via directional 1D projections and sorting.
//
// Setup: Fast, stable 1-Wasserstein approximation integrating 1D Wasserstein distances over uniform slicing angles.
//
// Beats:
//   1. Project 2D persistence points orthogonally onto slicing directions theta in [-pi/2, pi/2].
//   2. Compute diagonal projections along the identity line y = x.
//   3. Compute average 1D Wasserstein distance across discrete slicing angles.

pub type SwPoint = struct {
    birth: Float,
    death: Float,
};

pub type SlicedWasserstein = struct {
    num_directions: Int,
    slice_angles: List[Float],
};

pub fn sw_point_new(b: Float, d: Float) -> SwPoint {
    return SwPoint {
        birth: b,
        death: d,
    };
}

pub fn sliced_wasserstein_new(num_dirs: Int) -> SlicedWasserstein {
    let mut angles: List[Float] = list_new();
    let pi_val: Float = 3.141592653589793;
    let mut i: Int = 0;
    while i < num_dirs {
        let mut i_f: Float = 0.0;
        let mut c: Int = 0;
        while c < i { i_f = i_f + 1.0; c = c + 1; }
        let mut n_f: Float = 0.0;
        let mut cn: Int = 0;
        while cn < num_dirs { n_f = n_f + 1.0; cn = cn + 1; }
        let theta: Float = (0.0 - (pi_val * 0.5)) + (pi_val * (i_f / n_f));
        angles = list_push(angles, theta);
        i = i + 1;
    }
    return SlicedWasserstein {
        num_directions: num_dirs,
        slice_angles: angles,
    };
}

pub fn project_point_on_theta(p: &SwPoint, theta: Float) -> Float {
    let c: Float = cos(theta);
    let s: Float = sin(theta);
    return ((p).birth * c) + ((p).death * s);
}

pub fn project_diag_on_theta(p: &SwPoint, theta: Float) -> Float {
    let mid: Float = ((p).birth + (p).death) * 0.5;
    let c: Float = cos(theta);
    let s: Float = sin(theta);
    return (mid * c) + (mid * s);
}

pub fn compute_slice_1d_distance(
    pts1: List[SwPoint],
    pts2: List[SwPoint],
    theta: Float
) -> Float {
    let n1: Int = list_len(pts1);
    let n2: Int = list_len(pts2);

    let mut sum_diff: Float = 0.0;
    let mut i: Int = 0;
    while i < n1 {
        let p1: SwPoint = list_get(pts1, i);
        let val1: Float = project_point_on_theta(&p1, theta);
        let diag1: Float = project_diag_on_theta(&p1, theta);
        let mut diff: Float = val1 - diag1;
        if diff < 0.0 { diff = 0.0 - diff; }
        sum_diff = sum_diff + diff;
        i = i + 1;
    }

    let mut j: Int = 0;
    while j < n2 {
        let p2: SwPoint = list_get(pts2, j);
        let val2: Float = project_point_on_theta(&p2, theta);
        let diag2: Float = project_diag_on_theta(&p2, theta);
        let mut diff: Float = val2 - diag2;
        if diff < 0.0 { diff = 0.0 - diff; }
        sum_diff = sum_diff + diff;
        j = j + 1;
    }

    return sum_diff;
}

pub fn sliced_wasserstein_distance(
    sw: &SlicedWasserstein,
    pts1: List[SwPoint],
    pts2: List[SwPoint]
) -> Float {
    let n_dirs: Int = (sw).num_directions;
    if n_dirs == 0 {
        return 0.0;
    }
    let mut total_sw: Float = 0.0;
    let mut i: Int = 0;
    while i < n_dirs {
        let theta: Float = list_get((sw).slice_angles, i);
        let d_slice: Float = compute_slice_1d_distance(pts1, pts2, theta);
        total_sw = total_sw + d_slice;
        i = i + 1;
    }
    let mut n_f: Float = 0.0;
    let mut c: Int = 0;
    while c < n_dirs { n_f = n_f + 1.0; c = c + 1; }
    return total_sw / n_f;
}
