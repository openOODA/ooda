// # Twist Reduction Algorithm for Fast Persistent Homology
//
// Logline: Implements the Chen-Edelsbrunner twist algorithm combining dual clearing and matrix reduction for persistent homology.
//
// Setup: High-performance persistence reduction accelerating boundary operations by clearing columns born from previous dimension pairings.
//
// Beats:
//   1. Track paired birth and death indices across dimension boundaries.
//   2. Apply the Clearing optimization to zero out columns corresponding to boundarized death simplices.
//   3. Compute paired barcodes in reverse dimension order (d -> d-1 -> 0).

pub type TwistPair = struct {
    birth_col: Int,
    death_col: Int,
    dimension: Int,
};

pub type TwistTracker = struct {
    num_simplices: Int,
    is_cleared: List[Bool],
    pairs: List[TwistPair],
    pair_count: Int,
};

pub fn twist_tracker_new(n_simplices: Int) -> TwistTracker {
    let mut cleared: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < n_simplices {
        cleared = list_push(cleared, false);
        i = i + 1;
    }
    let empty_pairs: List[TwistPair] = list_new();
    return TwistTracker {
        num_simplices: n_simplices,
        is_cleared: cleared,
        pairs: empty_pairs,
        pair_count: 0,
    };
}

pub fn twist_tracker_record_pair(
    tt: &mut TwistTracker,
    birth: Int,
    death: Int,
    dim: Int
) -> Bool {
    let tp: TwistPair = TwistPair {
        birth_col: birth,
        death_col: death,
        dimension: dim,
    };
    (tt).pairs = list_push((tt).pairs, tp);
    (tt).pair_count = (tt).pair_count + 1;

    // Clearing: death column was a boundary, so its birth simplex will not generate persistence in next dimension
    let n: Int = (tt).num_simplices;
    let mut new_cleared: List[Bool] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == birth {
            new_cleared = list_push(new_cleared, true);
        } else {
            new_cleared = list_push(new_cleared, list_get((tt).is_cleared, i));
        }
        i = i + 1;
    }
    (tt).is_cleared = new_cleared;
    return true;
}

pub fn twist_tracker_is_cleared(tt: &TwistTracker, idx: Int) -> Bool {
    let n: Int = (tt).num_simplices;
    if idx < 0 || idx >= n {
        return false;
    }
    return list_get((tt).is_cleared, idx);
}

pub fn twist_tracker_get_pair(tt: &TwistTracker, idx: Int) -> TwistPair {
    return list_get((tt).pairs, idx);
}
