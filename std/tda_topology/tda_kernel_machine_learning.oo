// # Positive Definite TDA Kernels for Machine Learning
//
// Logline: Implements positive definite kernels on persistence diagrams and landscapes for SVMs and kernel Ridge regression.
//
// Setup: Reproducing Kernel Hilbert Space (RKHS) embeddings for persistence summaries ensuring stability and Mercer properties.
//
// Beats:
//   1. Implement Gaussian RBF kernel on discretized persistence landscapes and silhouettes.
//   2. Implement exponential Sliced Wasserstein kernel exp(-gamma * SW(D1, D2)).
//   3. Compute symmetric positive semi-definite Gram kernel matrices for machine learning datasets.

pub type TdaKernelMatrix = struct {
    num_samples: Int,
    gram_entries: List[Float]
};

pub fn tda_kernel_matrix_new(n: Int) -> TdaKernelMatrix {
    let total: Int = n * n;
    let mut data: List[Float] = list_new();
    let mut i: Int = 0;
    while i < total {
        data = list_push(data, 0.0);
        i = i + 1;
    }
    return TdaKernelMatrix {
        num_samples: n,
        gram_entries: data
    };
}

pub fn tda_rbf_kernel(vec1: List[Float], vec2: List[Float], gamma: Float) -> Float {
    let n1: Int = list_len(vec1);
    let n2: Int = list_len(vec2);
    let mut sum_sq_diff: Float = 0.0;
    let mut i: Int = 0;
    while i < n1 && i < n2 {
        let diff: Float = list_get(vec1, i) - list_get(vec2, i);
        sum_sq_diff = sum_sq_diff + (diff * diff);
        i = i + 1;
    }
    return exp(0.0 - (gamma * sum_sq_diff));
}

pub fn tda_sliced_wasserstein_kernel_eval(sw_dist: Float, gamma: Float) -> Float {
    return exp(0.0 - (gamma * sw_dist));
}

pub fn tda_linear_kernel(vec1: List[Float], vec2: List[Float]) -> Float {
    let n1: Int = list_len(vec1);
    let n2: Int = list_len(vec2);
    let mut dot: Float = 0.0;
    let mut i: Int = 0;
    while i < n1 && i < n2 {
        dot = dot + (list_get(vec1, i) * list_get(vec2, i));
        i = i + 1;
    }
    return dot;
}

pub fn tda_kernel_matrix_set(
    km: &mut TdaKernelMatrix,
    i: Int,
    j: Int,
    val: Float
) -> Bool {
    let n: Int = (km).num_samples;
    if i < 0 || i >= n || j < 0 || j >= n {
        return false;
    }
    let idx1: Int = (i * n) + j;
    let idx2: Int = (j * n) + i;
    let total: Int = n * n;

    let mut new_entries: List[Float] = list_new();
    let mut k: Int = 0;
    while k < total {
        if k == idx1 || k == idx2 {
            new_entries = list_push(new_entries, val);
        } else {
            new_entries = list_push(new_entries, list_get((km).gram_entries, k));
        }
        k = k + 1;
    }
    (km).gram_entries = new_entries;
    return true;
}

pub fn tda_kernel_matrix_get(km: &TdaKernelMatrix, i: Int, j: Int) -> Float {
    let n: Int = (km).num_samples;
    let idx: Int = (i * n) + j;
    return list_get((km).gram_entries, idx);
}
