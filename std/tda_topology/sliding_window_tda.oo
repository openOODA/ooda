// # Sliding Window TDA & Topological Change Detection
//
// Logline: Implements sliding window point cloud generators and persistence deviation metrics for online anomaly and regime change detection.
//
// Setup: Dynamic topological analysis segmenting continuous time series into overlapping windows to track topology evolution.
//
// Beats:
//   1. Define SlidingWindowConfig specifying window length W and stride S.
//   2. Extract sequence of windowed point clouds from streaming time series.
//   3. Compute 1-Wasserstein deviation between adjacent window persistence profiles.

pub type SlidingWindowConfig = struct {
    window_length: Int,
    stride: Int,
    embedding_dim: Int,
    delay_tau: Int
};

pub type WindowSummary = struct {
    window_index: Int,
    start_time: Int,
    end_time: Int,
    total_persistence: Float,
    betti_0_count: Int,
    betti_1_count: Int
};

pub type SlidingWindowTda = struct {
    config: SlidingWindowConfig,
    summaries: List[WindowSummary],
    summary_count: Int
};

pub fn sliding_window_config_new(
    w_len: Int,
    stride: Int,
    dim: Int,
    tau: Int
) -> SlidingWindowConfig {
    return SlidingWindowConfig {
        window_length: w_len,
        stride: stride,
        embedding_dim: dim,
        delay_tau: tau
    };
}

pub fn window_summary_new(
    w_idx: Int,
    start: Int,
    end_t: Int,
    tot_pers: Float,
    b0: Int,
    b1: Int
) -> WindowSummary {
    return WindowSummary {
        window_index: w_idx,
        start_time: start,
        end_time: end_t,
        total_persistence: tot_pers,
        betti_0_count: b0,
        betti_1_count: b1
    };
}

pub fn sliding_window_tda_new(cfg: SlidingWindowConfig) -> SlidingWindowTda {
    let empty_s: List[WindowSummary] = list_new();
    return SlidingWindowTda {
        config: cfg,
        summaries: empty_s,
        summary_count: 0
    };
}

pub fn sliding_window_add_summary(
    swt: &mut SlidingWindowTda,
    summary: WindowSummary
) -> Bool {
    (swt).summaries = list_push((swt).summaries, summary);
    (swt).summary_count = (swt).summary_count + 1;
    return true;
}

pub fn sliding_window_detect_anomaly(
    swt: &SlidingWindowTda,
    idx: Int,
    threshold_factor: Float
) -> Bool {
    let n: Int = (swt).summary_count;
    if idx <= 0 || idx >= n {
        return false;
    }
    let prev: WindowSummary = list_get((swt).summaries, idx - 1);
    let curr: WindowSummary = list_get((swt).summaries, idx);
    let diff: Float = (curr).total_persistence - (prev).total_persistence;
    let mut abs_diff: Float = diff;
    if abs_diff < 0.0 { abs_diff = 0.0 - abs_diff; }

    if (prev).total_persistence <= 0.0 {
        return abs_diff > threshold_factor;
    }
    return (abs_diff / (prev).total_persistence) > threshold_factor;
}
