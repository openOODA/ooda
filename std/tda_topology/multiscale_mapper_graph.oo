// # Multiscale Mapper Graph & Resolution Sweeping
//
// Logline: Constructs multi-resolution Mapper graph hierarchies tracking cluster stability and branch persistence across resolutions.
//
// Setup: Multiscale topological analysis varying interval resolutions and overlap parameters to separate robust topological features from noise.
//
// Beats:
//   1. Represent multi-scale resolution levels (number of intervals N_1, N_2, ...).
//   2. Track cluster lineage and parent-child inclusions between adjacent resolution levels.
//   3. Compute scale-persistent Mapper branches and cluster lifetimes across sweeps.

pub type MultiscaleLevel = struct {
    level_id: Int,
    num_intervals: Int,
    overlap_ratio: Float,
    node_count: Int,
    edge_count: Int
};

pub type ClusterLineage = struct {
    parent_level: Int,
    parent_node: Int,
    child_level: Int,
    child_node: Int,
    overlap_size: Int
};

pub type MultiscaleMapper = struct {
    levels: List[MultiscaleLevel],
    lineages: List[ClusterLineage],
    level_count: Int,
    lineage_count: Int
};

pub fn multiscale_level_new(
    id: Int,
    intervals: Int,
    overlap: Float,
    nodes: Int,
    edges: Int
) -> MultiscaleLevel {
    return MultiscaleLevel {
        level_id: id,
        num_intervals: intervals,
        overlap_ratio: overlap,
        node_count: nodes,
        edge_count: edges
    };
}

pub fn cluster_lineage_new(
    p_lvl: Int,
    p_node: Int,
    c_lvl: Int,
    c_node: Int,
    sz: Int
) -> ClusterLineage {
    return ClusterLineage {
        parent_level: p_lvl,
        parent_node: p_node,
        child_level: c_lvl,
        child_node: c_node,
        overlap_size: sz
    };
}

pub fn multiscale_mapper_new() -> MultiscaleMapper {
    let empty_lvl: List[MultiscaleLevel] = list_new();
    let empty_lin: List[ClusterLineage] = list_new();
    return MultiscaleMapper {
        levels: empty_lvl,
        lineages: empty_lin,
        level_count: 0,
        lineage_count: 0
    };
}

pub fn multiscale_mapper_add_level(mm: &mut MultiscaleMapper, lvl: MultiscaleLevel) -> Bool {
    (mm).levels = list_push((mm).levels, lvl);
    (mm).level_count = (mm).level_count + 1;
    return true;
}

pub fn multiscale_mapper_add_lineage(mm: &mut MultiscaleMapper, lin: ClusterLineage) -> Bool {
    (mm).lineages = list_push((mm).lineages, lin);
    (mm).lineage_count = (mm).lineage_count + 1;
    return true;
}

pub fn multiscale_mapper_get_level(mm: &MultiscaleMapper, idx: Int) -> MultiscaleLevel {
    return list_get((mm).levels, idx);
}
