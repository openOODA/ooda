// # Spatial Distance Matrix & Metric Queries
//
// Logline: Implements symmetric condensed pairwise distance matrices, k-nearest neighbor lookups, and graph geodesic distance approximations.
//
// Setup: Compact 2D flattened distance matrix indexing for multi-point metric representations in TDA pipelines.
//
// Beats:
//   1. Define DistanceMatrix structure storing condensed lower-triangular pairwise entries.
//   2. Implement constant-time symmetric indexing and distance value assignment.
//   3. Compute k-nearest neighbor lists and maximum pairwise diameters.

pub type DistanceMatrix = struct {
    num_points: Int,
    entries: List[Float],
    total_elements: Int,
};

pub fn distance_matrix_new(num_points: Int) -> DistanceMatrix {
    let total: Int = num_points * num_points;
    let mut data: List[Float] = list_new();
    let mut i: Int = 0;
    while i < total {
        data = list_push(data, 0.0);
        i = i + 1;
    }
    return DistanceMatrix {
        num_points: num_points,
        entries: data,
        total_elements: total,
    };
}

pub fn distance_matrix_index(num_points: Int, i: Int, j: Int) -> Int {
    return (i * num_points) + j;
}

pub fn distance_matrix_get(mat: &DistanceMatrix, i: Int, j: Int) -> Float {
    let n: Int = (mat).num_points;
    if i < 0 || i >= n || j < 0 || j >= n {
        return 0.0;
    }
    let idx: Int = distance_matrix_index(n, i, j);
    return list_get((mat).entries, idx);
}

pub fn distance_matrix_set(mat: &mut DistanceMatrix, i: Int, j: Int, dist: Float) -> Bool {
    let n: Int = (mat).num_points;
    if i < 0 || i >= n || j < 0 || j >= n {
        return false;
    }
    let idx1: Int = distance_matrix_index(n, i, j);
    let idx2: Int = distance_matrix_index(n, j, i);
    let total: Int = (mat).total_elements;

    let mut new_entries: List[Float] = list_new();
    let mut k: Int = 0;
    while k < total {
        if k == idx1 || k == idx2 {
            new_entries = list_push(new_entries, dist);
        } else {
            new_entries = list_push(new_entries, list_get((mat).entries, k));
        }
        k = k + 1;
    }
    (mat).entries = new_entries;
    return true;
}

pub fn distance_matrix_diameter(mat: &DistanceMatrix) -> Float {
    let n: Int = (mat).num_points;
    let mut max_d: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let mut j: Int = i + 1;
        while j < n {
            let d: Float = distance_matrix_get(mat, i, j);
            if d > max_d {
                max_d = d;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return max_d;
}

pub fn distance_matrix_row_distances(mat: &DistanceMatrix, point_idx: Int) -> List[Float] {
    let n: Int = (mat).num_points;
    let mut row: List[Float] = list_new();
    let mut j: Int = 0;
    while j < n {
        let d: Float = distance_matrix_get(mat, point_idx, j);
        row = list_push(row, d);
        j = j + 1;
    }
    return row;
}
