// # Ball Mapper Algorithm & Epsilon Coverings
//
// Logline: Implements the Ball Mapper algorithm covering point clouds with metric epsilon-balls and building nerve intersection graphs.
//
// Setup: Dlotko et al. parameter-light alternative to Mapper covering point clouds with landmark metric balls B(x, epsilon).
//
// Beats:
//   1. Select landmark centers such that every data point is covered by at least one epsilon-ball.
//   2. Assign points to intersecting epsilon-ball landmarks.
//   3. Build Ball Mapper 1-skeleton graph connecting intersecting balls.

pub type BallNode = struct {
    ball_id: Int,
    center_point_id: Int,
    radius_epsilon: Float,
    covered_points: List[Int],
    point_count: Int,
};

pub type BallMapperGraph = struct {
    balls: List[BallNode],
    ball_count: Int,
    epsilon: Float,
    total_edges: Int,
};

pub fn ball_node_new(b_id: Int, center_id: Int, eps: Float) -> BallNode {
    let empty_pts: List[Int] = list_new();
    return BallNode {
        ball_id: b_id,
        center_point_id: center_id,
        radius_epsilon: eps,
        covered_points: empty_pts,
        point_count: 0,
    };
}

pub fn ball_mapper_graph_new(eps: Float) -> BallMapperGraph {
    let empty_b: List[BallNode] = list_new();
    return BallMapperGraph {
        balls: empty_b,
        ball_count: 0,
        epsilon: eps,
        total_edges: 0,
    };
}

pub fn ball_mapper_add_ball(g: &mut BallMapperGraph, b: BallNode) -> Bool {
    (g).balls = list_push((g).balls, b);
    (g).ball_count = (g).ball_count + 1;
    return true;
}

pub fn ball_node_add_point(b: &mut BallNode, pt_id: Int) -> Bool {
    (b).covered_points = list_push((b).covered_points, pt_id);
    (b).point_count = (b).point_count + 1;
    return true;
}

pub fn ball_nodes_intersect(b1: &BallNode, b2: &BallNode) -> Bool {
    let n1: Int = (b1).point_count;
    let n2: Int = (b2).point_count;
    let mut i: Int = 0;
    while i < n1 {
        let p1: Int = list_get((b1).covered_points, i);
        let mut j: Int = 0;
        while j < n2 {
            if list_get((b2).covered_points, j) == p1 {
                return true;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

pub fn ball_mapper_count_intersections(g: &BallMapperGraph) -> Int {
    let mut count: Int = 0;
    let n: Int = (g).ball_count;
    let mut i: Int = 0;
    while i < n {
        let b1: BallNode = list_get((g).balls, i);
        let mut j: Int = i + 1;
        while j < n {
            let b2: BallNode = list_get((g).balls, j);
            if ball_nodes_intersect(&b1, &b2) {
                count = count + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return count;
}
