// # Graph Persistent Homology & Network Filtrations
//
// Logline: Computes multi-scale persistent homology on complex networks via edge weight, node degree, and curvature filtrations.
//
// Setup: Intrinsic graph topological analysis mapping network structures to persistent 0D connected components and 1D cycles.
//
// Beats:
//   1. Implement edge weight ascending filtration for weighted network topologies.
//   2. Compute degree-based sublevel and superlevel filtrations on vertices.
//   3. Extract graph cycle persistence intervals detecting non-trivial network loops.

pub type GraphFiltrationEdge = struct {
    u: Int,
    v: Int,
    weight: Float,
    filtration_step: Int,
};

pub type GraphPersistenceSummary = struct {
    num_nodes: Int,
    h0_component_count: Int,
    h1_cycle_count: Int,
    max_edge_weight: Float,
    edges: List[GraphFiltrationEdge],
    edge_count: Int,
};

pub fn graph_filtration_edge_new(u: Int, v: Int, w: Float, step: Int) -> GraphFiltrationEdge {
    return GraphFiltrationEdge {
        u: u,
        v: v,
        weight: w,
        filtration_step: step,
    };
}

pub fn graph_persistence_summary_new(num_nodes: Int) -> GraphPersistenceSummary {
    let empty_e: List[GraphFiltrationEdge] = list_new();
    return GraphPersistenceSummary {
        num_nodes: num_nodes,
        h0_component_count: num_nodes,
        h1_cycle_count: 0,
        max_edge_weight: 0.0,
        edges: empty_e,
        edge_count: 0,
    };
}

pub fn graph_persistence_add_edge(
    gps: &mut GraphPersistenceSummary,
    u: Int,
    v: Int,
    w: Float,
    step: Int
) -> Bool {
    let edge: GraphFiltrationEdge = graph_filtration_edge_new(u, v, w, step);
    (gps).edges = list_push((gps).edges, edge);
    (gps).edge_count = (gps).edge_count + 1;
    if w > (gps).max_edge_weight {
        (gps).max_edge_weight = w;
    }
    return true;
}

pub fn graph_persistence_process_step(
    gps: &mut GraphPersistenceSummary,
    creates_cycle: Bool
) -> Bool {
    if creates_cycle {
        (gps).h1_cycle_count = (gps).h1_cycle_count + 1;
    } else {
        if (gps).h0_component_count > 1 {
            (gps).h0_component_count = (gps).h0_component_count - 1;
        }
    }
    return true;
}

pub fn graph_persistence_get_edge(gps: &GraphPersistenceSummary, idx: Int) -> GraphFiltrationEdge {
    return list_get((gps).edges, idx);
}
