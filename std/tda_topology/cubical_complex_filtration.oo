// # Cubical Complex & Grid Scalar Filtration
//
// Logline: Implements 2D and 3D cubical complexes, elementary cubes, and lower-star filtrations for raster images and voxel fields.
//
// Setup: Memory-efficient structured grid topology where cubes represent vertices (0D), edges (1D), squares (2D), and voxels (3D).
//
// Beats:
//   1. Define ElementaryCube and CubicalGrid2D structures.
//   2. Compute lower-star filtration values for higher-dimensional cubes from vertex scalar values.
//   3. Implement boundary operators mapping squares to edges and edges to vertices.

pub type ElementaryCube = struct {
    x_idx: Int,
    y_idx: Int,
    dimension: Int,
    filtration_val: Float
};

pub type CubicalGrid2D = struct {
    width: Int,
    height: Int,
    cubes: List[ElementaryCube],
    total_cubes: Int
};

pub fn elementary_cube_new(x: Int, y: Int, dim: Int, filt: Float) -> ElementaryCube {
    return ElementaryCube {
        x_idx: x,
        y_idx: y,
        dimension: dim,
        filtration_val: filt
    };
}

pub fn cubical_grid_2d_new(w: Int, h: Int) -> CubicalGrid2D {
    let empty_c: List[ElementaryCube] = list_new();
    return CubicalGrid2D {
        width: w,
        height: h,
        cubes: empty_c,
        total_cubes: 0
    };
}

pub fn cubical_grid_2d_build_from_image(
    grid: &mut CubicalGrid2D,
    pixel_values: List[Float],
    w: Int,
    h: Int
) -> Bool {
    (grid).width = w;
    (grid).height = h;

    // 0-cubes (vertices): at (2*x, 2*y)
    let mut y: Int = 0;
    while y < h {
        let mut x: Int = 0;
        while x < w {
            let p_idx: Int = (y * w) + x;
            let val: Float = list_get(pixel_values, p_idx);
            let c0: ElementaryCube = elementary_cube_new(2 * x, 2 * y, 0, val);
            (grid).cubes = list_push((grid).cubes, c0);
            (grid).total_cubes = (grid).total_cubes + 1;
            x = x + 1;
        }
        y = y + 1;
    }

    // 1-cubes (horizontal edges): between (x,y) and (x+1,y) -> lower-star max(v1, v2)
    let mut y_h: Int = 0;
    while y_h < h {
        let mut x_h: Int = 0;
        while x_h < (w - 1) {
            let v1: Float = list_get(pixel_values, (y_h * w) + x_h);
            let v2: Float = list_get(pixel_values, (y_h * w) + (x_h + 1));
            let mut filt_e: Float = v1;
            if v2 > filt_e {
                filt_e = v2;
            }
            let c1: ElementaryCube = elementary_cube_new((2 * x_h) + 1, 2 * y_h, 1, filt_e);
            (grid).cubes = list_push((grid).cubes, c1);
            (grid).total_cubes = (grid).total_cubes + 1;
            x_h = x_h + 1;
        }
        y_h = y_h + 1;
    }

    // 1-cubes (vertical edges): between (x,y) and (x, y+1)
    let mut y_v: Int = 0;
    while y_v < (h - 1) {
        let mut x_v: Int = 0;
        while x_v < w {
            let v1: Float = list_get(pixel_values, (y_v * w) + x_v);
            let v2: Float = list_get(pixel_values, ((y_v + 1) * w) + x_v);
            let mut filt_e: Float = v1;
            if v2 > filt_e {
                filt_e = v2;
            }
            let c1: ElementaryCube = elementary_cube_new(2 * x_v, (2 * y_v) + 1, 1, filt_e);
            (grid).cubes = list_push((grid).cubes, c1);
            (grid).total_cubes = (grid).total_cubes + 1;
            x_v = x_v + 1;
        }
        y_v = y_v + 1;
    }

    // 2-cubes (squares): max of 4 corners
    let mut y_s: Int = 0;
    while y_s < (h - 1) {
        let mut x_s: Int = 0;
        while x_s < (w - 1) {
            let v00: Float = list_get(pixel_values, (y_s * w) + x_s);
            let v10: Float = list_get(pixel_values, (y_s * w) + (x_s + 1));
            let v01: Float = list_get(pixel_values, ((y_s + 1) * w) + x_s);
            let v11: Float = list_get(pixel_values, ((y_s + 1) * w) + (x_s + 1));
            let mut max_sq: Float = v00;
            if v10 > max_sq { max_sq = v10; }
            if v01 > max_sq { max_sq = v01; }
            if v11 > max_sq { max_sq = v11; }

            let c2: ElementaryCube = elementary_cube_new((2 * x_s) + 1, (2 * y_s) + 1, 2, max_sq);
            (grid).cubes = list_push((grid).cubes, c2);
            (grid).total_cubes = (grid).total_cubes + 1;
            x_s = x_s + 1;
        }
        y_s = y_s + 1;
    }
    return true;
}

pub fn cubical_grid_2d_get_cube(grid: &CubicalGrid2D, idx: Int) -> ElementaryCube {
    return list_get((grid).cubes, idx);
}
