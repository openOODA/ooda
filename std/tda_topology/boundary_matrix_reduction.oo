// # Persistent Homology Boundary Matrix Reduction (GF2)
//
// Logline: Implements column-reduction over GF(2) for boundary matrices to extract persistence pairings and low-index functions.
//
// Setup: Core algebraic topology matrix reduction mapping chain boundaries to birth-death persistence pairs over field Z/2Z.
//
// Beats:
//   1. Represent sparse boundary matrix columns as sorted integer lists of non-zero rows.
//   2. Compute lowest non-zero row index low(j) for each column j over GF(2).
//   3. Perform symmetric column addition (symmetric difference XOR) until all low(j) are distinct.

pub type SparseColumn = struct {
    col_index: Int,
    row_indices: List[Int],
    low_row: Int
};

pub type BoundaryMatrix = struct {
    num_columns: Int,
    columns: List[SparseColumn]
};

pub fn sparse_column_new(col_idx: Int, rows: List[Int]) -> SparseColumn {
    let mut max_row: Int = -1;
    let n: Int = list_len(rows);
    let mut i: Int = 0;
    while i < n {
        let r: Int = list_get(rows, i);
        if r > max_row {
            max_row = r;
        }
        i = i + 1;
    }
    return SparseColumn {
        col_index: col_idx,
        row_indices: rows,
        low_row: max_row
    };
}

pub fn boundary_matrix_new(num_cols: Int) -> BoundaryMatrix {
    let empty_cols: List[SparseColumn] = list_new();
    return BoundaryMatrix {
        num_columns: num_cols,
        columns: empty_cols
    };
}

pub fn boundary_matrix_add_column(mat: &mut BoundaryMatrix, col: SparseColumn) -> Bool {
    (mat).columns = list_push((mat).columns, col);
    return true;
}

pub fn boundary_matrix_get_column(mat: &BoundaryMatrix, col_idx: Int) -> SparseColumn {
    return list_get((mat).columns, col_idx);
}

// Compute symmetric difference (XOR over GF(2)) between two sparse columns
pub fn column_add_gf2(col_a: &SparseColumn, col_b: &SparseColumn) -> SparseColumn {
    let mut res_rows: List[Int] = list_new();
    let na: Int = list_len((col_a).row_indices);
    let nb: Int = list_len((col_b).row_indices);

    let mut ia: Int = 0;
    let mut ib: Int = 0;
    while ia < na && ib < nb {
        let ra: Int = list_get((col_a).row_indices, ia);
        let rb: Int = list_get((col_b).row_indices, ib);
        if ra < rb {
            res_rows = list_push(res_rows, ra);
            ia = ia + 1;
        } else if rb < ra {
            res_rows = list_push(res_rows, rb);
            ib = ib + 1;
        } else {
            // ra == rb cancels out in GF(2)
            ia = ia + 1;
            ib = ib + 1;
        }
    }
    while ia < na {
        res_rows = list_push(res_rows, list_get((col_a).row_indices, ia));
        ia = ia + 1;
    }
    while ib < nb {
        res_rows = list_push(res_rows, list_get((col_b).row_indices, ib));
        ib = ib + 1;
    }

    return sparse_column_new((col_a).col_index, res_rows);
}

pub fn column_is_empty(col: &SparseColumn) -> Bool {
    return list_len((col).row_indices) == 0;
}

pub fn get_low_index(col: &SparseColumn) -> Int {
    return (col).low_row;
}
