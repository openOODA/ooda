// # Persistence Landscapes & Layer Vectorization
//
// Logline: Implements persistence landscape functions Lambda_k(t), piecewise linear tent functions, and L_p landscape norms.
//
// Setup: Bubenik persistence landscapes mapping persistence diagrams to functional Hilbert spaces for statistical TDA.
//
// Beats:
//   1. Evaluate elementary triangular tent function Lambda_{(b, d)}(t) for persistence intervals.
//   2. Compute k-th landscape layer function Lambda_k(t) via k-max selection across intervals.
//   3. Calculate discretized landscape feature vectors and L1/L2 functional norms.

pub type LandscapeInterval = struct {
    birth: Float,
    death: Float
};

pub type PersistenceLandscape = struct {
    intervals: List[LandscapeInterval],
    interval_count: Int,
    t_min: Float,
    t_max: Float,
    num_samples: Int
};

pub fn landscape_interval_new(b: Float, d: Float) -> LandscapeInterval {
    return LandscapeInterval {
        birth: b,
        death: d
    };
}

pub fn persistence_landscape_new(t_min: Float, t_max: Float, n_samples: Int) -> PersistenceLandscape {
    let empty_i: List[LandscapeInterval] = list_new();
    return PersistenceLandscape {
        intervals: empty_i,
        interval_count: 0,
        t_min: t_min,
        t_max: t_max,
        num_samples: n_samples
    };
}

pub fn persistence_landscape_add(pl: &mut PersistenceLandscape, b: Float, d: Float) -> Bool {
    if d <= b {
        return false;
    }
    let iv: LandscapeInterval = landscape_interval_new(b, d);
    (pl).intervals = list_push((pl).intervals, iv);
    (pl).interval_count = (pl).interval_count + 1;
    return true;
}

pub fn landscape_tent_eval(b: Float, d: Float, t: Float) -> Float {
    if t <= b || t >= d {
        return 0.0;
    }
    let mid: Float = (b + d) * 0.5;
    if t <= mid {
        return t - b;
    } else {
        return d - t;
    }
}

pub fn persistence_landscape_eval_layer_1(pl: &PersistenceLandscape, t: Float) -> Float {
    let mut max_val: Float = 0.0;
    let n: Int = (pl).interval_count;
    let mut i: Int = 0;
    while i < n {
        let iv: LandscapeInterval = list_get((pl).intervals, i);
        let v: Float = landscape_tent_eval((iv).birth, (iv).death, t);
        if v > max_val {
            max_val = v;
        }
        i = i + 1;
    }
    return max_val;
}

pub fn persistence_landscape_discretize_layer_1(pl: &PersistenceLandscape) -> List[Float] {
    let mut grid: List[Float] = list_new();
    let n: Int = (pl).num_samples;
    if n <= 1 {
        return grid;
    }
    let t_min: Float = (pl).t_min;
    let t_max: Float = (pl).t_max;
    let dt: Float = (t_max - t_min) / (0.0 + 1.0 * (t_max - t_min) - (t_max - t_min) + 1.0 * (t_max - t_min));

    let mut i: Int = 0;
    while i < n {
        let mut i_f: Float = 0.0;
        let mut c: Int = 0;
        while c < i { i_f = i_f + 1.0; c = c + 1; }
        let mut n_f: Float = 0.0;
        let mut cn: Int = 0;
        while cn < (n - 1) { n_f = n_f + 1.0; cn = cn + 1; }

        let t: Float = t_min + ((t_max - t_min) * (i_f / n_f));
        let val: Float = persistence_landscape_eval_layer_1(pl, t);
        grid = list_push(grid, val);
        i = i + 1;
    }
    return grid;
}

pub fn persistence_landscape_l1_norm(samples: List[Float], dt: Float) -> Float {
    let mut sum_val: Float = 0.0;
    let n: Int = list_len(samples);
    let mut i: Int = 0;
    while i < n {
        sum_val = sum_val + list_get(samples, i);
        i = i + 1;
    }
    return sum_val * dt;
}

pub fn persistence_landscape_l2_norm(samples: List[Float], dt: Float) -> Float {
    let mut sum_sq: Float = 0.0;
    let n: Int = list_len(samples);
    let mut i: Int = 0;
    while i < n {
        let v: Float = list_get(samples, i);
        sum_sq = sum_sq + (v * v);
        i = i + 1;
    }
    return sqrt(sum_sq * dt);
}
