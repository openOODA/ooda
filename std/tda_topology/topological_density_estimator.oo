// # Topological Density & k-NN Field Estimation
//
// Logline: Calculates local point cloud density estimates, k-nearest neighbor radii, and Gaussian kernel density fields for weighted filtrations.
//
// Setup: Pure geometric density estimation enabling DTM (Distance to Measure) and density-filtered persistent homology.
//
// Beats:
//   1. Define PointDensityEstimate and DensityFieldConfig structures.
//   2. Compute Gaussian kernel density and k-nearest neighbor radius per sample.
//   3. Implement Distance-to-Measure (DTM) power weighting for robust topological filtration.

pub type DensityPoint = struct {
    point_id: Int,
    density_val: Float,
    knn_radius: Float,
    dtm_val: Float,
};

pub type DensityEstimator = struct {
    points: List[DensityPoint],
    bandwidth: Float,
    k_neighbors: Int,
    point_count: Int,
};

pub fn density_point_new(id: Int, density: Float, knn_r: Float, dtm: Float) -> DensityPoint {
    return DensityPoint {
        point_id: id,
        density_val: density,
        knn_radius: knn_r,
        dtm_val: dtm,
    };
}

pub fn density_estimator_new(bandwidth: Float, k_neighbors: Int) -> DensityEstimator {
    let empty_pts: List[DensityPoint] = list_new();
    return DensityEstimator {
        points: empty_pts,
        bandwidth: bandwidth,
        k_neighbors: k_neighbors,
        point_count: 0,
    };
}

pub fn gaussian_kernel_eval(dist: Float, bandwidth: Float) -> Float {
    if bandwidth <= 0.0 {
        return 0.0;
    }
    let u: Float = dist / bandwidth;
    let exponent: Float = 0.0 - (0.5 * u * u);
    return exp(exponent);
}

pub fn compute_point_density(
    target_idx: Int,
    distances_from_target: List[Float],
    bandwidth: Float
) -> Float {
    let n: Int = list_len(distances_from_target);
    let mut sum_k: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let d: Float = list_get(distances_from_target, i);
        let k_val: Float = gaussian_kernel_eval(d, bandwidth);
        sum_k = sum_k + k_val;
        i = i + 1;
    }
    let mut n_f: Float = 0.0;
    let mut c: Int = 0;
    while c < n {
        n_f = n_f + 1.0;
        c = c + 1;
    }
    if n_f == 0.0 {
        return 0.0;
    }
    return sum_k / n_f;
}

pub fn compute_dtm_value(
    sorted_k_distances: List[Float],
    p_power: Float
) -> Float {
    let k: Int = list_len(sorted_k_distances);
    if k == 0 {
        return 0.0;
    }
    let mut sum_pow: Float = 0.0;
    let mut i: Int = 0;
    while i < k {
        let d: Float = list_get(sorted_k_distances, i);
        let mut d_pow: Float = 1.0;
        if p_power == 2.0 {
            d_pow = d * d;
        } else if p_power == 1.0 {
            d_pow = d;
        } else {
            d_pow = d * d;
        }
        sum_pow = sum_pow + d_pow;
        i = i + 1;
    }
    let mut k_f: Float = 0.0;
    let mut c: Int = 0;
    while c < k {
        k_f = k_f + 1.0;
        c = c + 1;
    }
    let mean_pow: Float = sum_pow / k_f;
    return sqrt(mean_pow);
}

pub fn density_estimator_add(
    est: &mut DensityEstimator,
    id: Int,
    density: Float,
    knn_r: Float,
    dtm: Float
) -> Bool {
    let dp: DensityPoint = density_point_new(id, density, knn_r, dtm);
    (est).points = list_push((est).points, dp);
    (est).point_count = (est).point_count + 1;
    return true;
}

pub fn density_estimator_get(est: &DensityEstimator, idx: Int) -> DensityPoint {
    return list_get((est).points, idx);
}
