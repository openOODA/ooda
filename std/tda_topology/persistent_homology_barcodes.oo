// # Persistent Homology Barcodes & Intervals
//
// Logline: Represents multiscale persistence barcodes, birth-death intervals [b, d), and Betti number summaries across homology dimensions.
//
// Setup: Canonical topological barcode representation capturing invariant multiscale topological features.
//
// Beats:
//   1. Define BarcodeInterval and PersistenceBarcode structures per homology dimension.
//   2. Extract finite and essential (infinite lifetime) intervals from matrix reduction pairs.
//   3. Compute instant Betti numbers beta_k(t) by counting active intersecting intervals at parameter t.

pub type BarcodeInterval = struct {
    dimension: Int,
    birth: Float,
    death: Float,
    is_infinite: Bool,
    interval_id: Int
};

pub type PersistenceBarcode = struct {
    intervals: List[BarcodeInterval],
    interval_count: Int,
    max_dimension: Int
};

pub fn barcode_interval_finite(id: Int, dim: Int, birth: Float, death: Float) -> BarcodeInterval {
    return BarcodeInterval {
        dimension: dim,
        birth: birth,
        death: death,
        is_infinite: false,
        interval_id: id
    };
}

pub fn barcode_interval_infinite(id: Int, dim: Int, birth: Float) -> BarcodeInterval {
    return BarcodeInterval {
        dimension: dim,
        birth: birth,
        death: 999999.0,
        is_infinite: true,
        interval_id: id
    };
}

pub fn persistence_barcode_new(max_dim: Int) -> PersistenceBarcode {
    let empty_i: List[BarcodeInterval] = list_new();
    return PersistenceBarcode {
        intervals: empty_i,
        interval_count: 0,
        max_dimension: max_dim
    };
}

pub fn barcode_add_interval(bc: &mut PersistenceBarcode, iv: BarcodeInterval) -> Bool {
    (bc).intervals = list_push((bc).intervals, iv);
    (bc).interval_count = (bc).interval_count + 1;
    return true;
}

pub fn barcode_interval_persistence(iv: &BarcodeInterval) -> Float {
    if (iv).is_infinite {
        return 999999.0;
    }
    return (iv).death - (iv).birth;
}

pub fn barcode_betti_number_at(bc: &PersistenceBarcode, dim: Int, t: Float) -> Int {
    let mut betti: Int = 0;
    let n: Int = (bc).interval_count;
    let mut i: Int = 0;
    while i < n {
        let iv: BarcodeInterval = list_get((bc).intervals, i);
        if (iv).dimension == dim {
            if (iv).birth <= t {
                if (iv).is_infinite || t < (iv).death {
                    betti = betti + 1;
                }
            }
        }
        i = i + 1;
    }
    return betti;
}

pub fn barcode_count_dim(bc: &PersistenceBarcode, dim: Int) -> Int {
    let mut count: Int = 0;
    let n: Int = (bc).interval_count;
    let mut i: Int = 0;
    while i < n {
        let iv: BarcodeInterval = list_get((bc).intervals, i);
        if (iv).dimension == dim {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn barcode_get_interval(bc: &PersistenceBarcode, idx: Int) -> BarcodeInterval {
    return list_get((bc).intervals, idx);
}
