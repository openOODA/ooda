// # Takens Time-Delay Embedding for TDA
//
// Logline: Implements Takens' time-delay embedding reconstructing dynamical system phase space attractors from 1D time series.
//
// Setup: Non-linear dynamical time-series embedding mapping scalar signals x(t) to d-dimensional vectors (x(t), x(t+tau), ..., x(t+(d-1)tau)).
//
// Beats:
//   1. Configure embedding dimension d and time delay lag parameter tau.
//   2. Extract sliding delay vectors from discrete 1D scalar observation arrays.
//   3. Compute attractor diameter and bounding radius in delay reconstruction space.

pub type DelayEmbeddingConfig = struct {
    dimension: Int,
    time_delay: Int
};

pub type DelayVector = struct {
    time_index: Int,
    coords: List[Float]
};

pub type DelayPointCloud = struct {
    vectors: List[DelayVector],
    vector_count: Int,
    config: DelayEmbeddingConfig
};

pub fn delay_config_new(dim: Int, tau: Int) -> DelayEmbeddingConfig {
    return DelayEmbeddingConfig {
        dimension: dim,
        time_delay: tau
    };
}

pub fn delay_vector_new(t_idx: Int, coords: List[Float]) -> DelayVector {
    return DelayVector {
        time_index: t_idx,
        coords: coords
    };
}

pub fn delay_point_cloud_new(cfg: DelayEmbeddingConfig) -> DelayPointCloud {
    let empty_v: List[DelayVector] = list_new();
    return DelayPointCloud {
        vectors: empty_v,
        vector_count: 0,
        config: cfg
    };
}

pub fn embed_time_series_takens(
    series: List[Float],
    dim: Int,
    tau: Int
) -> DelayPointCloud {
    let cfg: DelayEmbeddingConfig = delay_config_new(dim, tau);
    let mut dpc: DelayPointCloud = delay_point_cloud_new(cfg);
    let n_series: Int = list_len(series);
    let max_start: Int = n_series - ((dim - 1) * tau);

    let mut t: Int = 0;
    while t < max_start {
        let mut coords: List[Float] = list_new();
        let mut k: Int = 0;
        while k < dim {
            let sample_idx: Int = t + (k * tau);
            let val: Float = list_get(series, sample_idx);
            coords = list_push(coords, val);
            k = k + 1;
        }
        let dv: DelayVector = delay_vector_new(t, coords);
        dpc.vectors = list_push(dpc.vectors, dv);
        dpc.vector_count = dpc.vector_count + 1;
        t = t + 1;
    }
    return dpc;
}

pub fn delay_vector_get_coord(dv: &DelayVector, idx: Int) -> Float {
    return list_get((dv).coords, idx);
}
