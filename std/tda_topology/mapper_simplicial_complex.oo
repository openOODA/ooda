// # Mapper Simplicial Complex & Nerve Graph
//
// Logline: Constructs the 1-skeleton Mapper graph and higher-dimensional nerve complexes from overlapping cluster intersections.
//
// Setup: Singh, Memoli, and Carlsson Mapper algorithm generating low-dimensional simplicial summaries of high-dimensional data.
//
// Beats:
//   1. Define MapperNode storing cluster points, mean lens values, and node sizes.
//   2. Define MapperEdge connecting clusters that share non-empty data point intersections.
//   3. Build the Nerve 1-skeleton graph and compute graph topological statistics.

pub type MapperNode = struct {
    node_id: Int,
    interval_id: Int,
    cluster_id: Int,
    point_ids: List[Int],
    size: Int,
    avg_lens_val: Float,
};

pub type MapperEdge = struct {
    u_node: Int,
    v_node: Int,
    shared_points_count: Int,
};

pub type MapperGraph = struct {
    nodes: List[MapperNode],
    edges: List[MapperEdge],
    node_count: Int,
    edge_count: Int,
};

pub fn mapper_node_new(
    n_id: Int,
    iv_id: Int,
    cl_id: Int,
    pts: List[Int],
    avg_lens: Float
) -> MapperNode {
    let sz: Int = list_len(pts);
    return MapperNode {
        node_id: n_id,
        interval_id: iv_id,
        cluster_id: cl_id,
        point_ids: pts,
        size: sz,
        avg_lens_val: avg_lens,
    };
}

pub fn mapper_edge_new(u: Int, v: Int, shared_cnt: Int) -> MapperEdge {
    return MapperEdge {
        u_node: u,
        v_node: v,
        shared_points_count: shared_cnt,
    };
}

pub fn mapper_graph_new() -> MapperGraph {
    let empty_n: List[MapperNode] = list_new();
    let empty_e: List[MapperEdge] = list_new();
    return MapperGraph {
        nodes: empty_n,
        edges: empty_e,
        node_count: 0,
        edge_count: 0,
    };
}

pub fn mapper_graph_add_node(g: &mut MapperGraph, node: MapperNode) -> Bool {
    (g).nodes = list_push((g).nodes, node);
    (g).node_count = (g).node_count + 1;
    return true;
}

pub fn count_shared_points(pts1: List[Int], pts2: List[Int]) -> Int {
    let n1: Int = list_len(pts1);
    let n2: Int = list_len(pts2);
    let mut count: Int = 0;
    let mut i: Int = 0;
    while i < n1 {
        let p1: Int = list_get(pts1, i);
        let mut j: Int = 0;
        while j < n2 {
            if list_get(pts2, j) == p1 {
                count = count + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn mapper_graph_compute_edges(g: &mut MapperGraph) -> Int {
    let num_n: Int = (g).node_count;
    let mut added: Int = 0;
    let mut i: Int = 0;
    while i < num_n {
        let node_i: MapperNode = list_get((g).nodes, i);
        let mut j: Int = i + 1;
        while j < num_n {
            let node_j: MapperNode = list_get((g).nodes, j);
            let shared: Int = count_shared_points((node_i).point_ids, (node_j).point_ids);
            if shared > 0 {
                let e: MapperEdge = mapper_edge_new((node_i).node_id, (node_j).node_id, shared);
                (g).edges = list_push((g).edges, e);
                (g).edge_count = (g).edge_count + 1;
                added = added + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return added;
}

pub fn mapper_graph_get_node(g: &MapperGraph, idx: Int) -> MapperNode {
    return list_get((g).nodes, idx);
}

pub fn mapper_graph_get_edge(g: &MapperGraph, idx: Int) -> MapperEdge {
    return list_get((g).edges, idx);
}
