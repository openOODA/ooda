// # Clique & Flag Simplicial Complex
//
// Logline: Constructs flag complexes and k-clique simplicial complexes from graph connectivity and edge weights.
//
// Setup: Combinatorial expansion of graph cliques into all higher-dimensional simplices where every pairwise edge exists.
//
// Beats:
//   1. Define GraphClique and CliqueComplex structures.
//   2. Check if a candidate vertex subset forms a complete subgraph (clique).
//   3. Filter cliques by maximum edge weight to yield a filtered flag complex.

pub type GraphClique = struct {
    vertices: List[Int],
    k_size: Int,
    max_weight: Float
};

pub type CliqueComplex = struct {
    num_vertices: Int,
    cliques: List[GraphClique],
    clique_count: Int,
    max_k: Int
};

pub fn graph_clique_new(vertices: List[Int], max_weight: Float) -> GraphClique {
    let k: Int = list_len(vertices);
    return GraphClique {
        vertices: vertices,
        k_size: k,
        max_weight: max_weight
    };
}

pub fn clique_complex_new(num_verts: Int, max_k: Int) -> CliqueComplex {
    let empty_c: List[GraphClique] = list_new();
    return CliqueComplex {
        num_vertices: num_verts,
        cliques: empty_c,
        clique_count: 0,
        max_k: max_k
    };
}

pub fn clique_complex_add(cc: &mut CliqueComplex, clique: GraphClique) -> Bool {
    if (clique).k_size > (cc).max_k {
        return false;
    }
    (cc).cliques = list_push((cc).cliques, clique);
    (cc).clique_count = (cc).clique_count + 1;
    return true;
}

pub fn is_clique_in_adj_matrix(
    verts: List[Int],
    adj_matrix: List[Int],
    matrix_dim: Int
) -> Bool {
    let k: Int = list_len(verts);
    let mut i: Int = 0;
    while i < k {
        let u: Int = list_get(verts, i);
        let mut j: Int = i + 1;
        while j < k {
            let v: Int = list_get(verts, j);
            let idx: Int = (u * matrix_dim) + v;
            if list_get(adj_matrix, idx) == 0 {
                return false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

pub fn clique_complex_count_by_dimension(cc: &CliqueComplex, dim: Int) -> Int {
    let target_k: Int = dim + 1;
    let mut count: Int = 0;
    let n: Int = (cc).clique_count;
    let mut i: Int = 0;
    while i < n {
        let c: GraphClique = list_get((cc).cliques, i);
        if (c).k_size == target_k {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn clique_complex_get(cc: &CliqueComplex, idx: Int) -> GraphClique {
    return list_get((cc).cliques, idx);
}
