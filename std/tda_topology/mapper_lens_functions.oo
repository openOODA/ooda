// # Mapper Filter & Lens Functions
//
// Logline: Implements filter and lens functions mapping point cloud metrics to 1D and 2D scalar reference spaces for Mapper.
//
// Setup: Dimensionality reduction and geometric lens projections driving overlapping pre-image pullbacks in Mapper algorithms.
//
// Beats:
//   1. Implement coordinate projection lens selecting specific coordinate axes.
//   2. Compute metric L_p eccentricity lens measuring point centrality within clouds.
//   3. Compute local density lens and graph geodesic distance filter functions.

pub type LensConfig = struct {
    lens_type: Int, // 0 = Coordinate, 1 = Eccentricity, 2 = Density
    axis_index: Int,
    p_power: Float
};

pub fn lens_config_coordinate(axis: Int) -> LensConfig {
    return LensConfig {
        lens_type: 0,
        axis_index: axis,
        p_power: 1.0
    };
}

pub fn lens_config_eccentricity(p: Float) -> LensConfig {
    return LensConfig {
        lens_type: 1,
        axis_index: -1,
        p_power: p
    };
}

pub fn lens_config_density() -> LensConfig {
    return LensConfig {
        lens_type: 2,
        axis_index: -1,
        p_power: 2.0
    };
}

pub fn eval_coordinate_lens(coords: List[Float], axis: Int) -> Float {
    let dim: Int = list_len(coords);
    if axis < 0 || axis >= dim {
        return 0.0;
    }
    return list_get(coords, axis);
}

pub fn eval_eccentricity_lens(
    point_distances: List[Float],
    p_power: Float
) -> Float {
    let n: Int = list_len(point_distances);
    if n == 0 {
        return 0.0;
    }
    if p_power == 999999.0 {
        // L_infinity eccentricity = max distance to any point
        let mut max_d: Float = 0.0;
        let mut i: Int = 0;
        while i < n {
            let d: Float = list_get(point_distances, i);
            if d > max_d {
                max_d = d;
            }
            i = i + 1;
        }
        return max_d;
    }

    // L_p eccentricity = (1/N * sum(d^p))^(1/p)
    let mut sum_p: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let d: Float = list_get(point_distances, i);
        if p_power == 1.0 {
            sum_p = sum_p + d;
        } else if p_power == 2.0 {
            sum_p = sum_p + (d * d);
        } else {
            sum_p = sum_p + d;
        }
        i = i + 1;
    }
    let mut n_f: Float = 0.0;
    let mut c: Int = 0;
    while c < n { n_f = n_f + 1.0; c = c + 1; }

    let mean_p: Float = sum_p / n_f;
    if p_power == 2.0 {
        return sqrt(mean_p);
    }
    return mean_p;
}
