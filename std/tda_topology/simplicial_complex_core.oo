// # Abstract Simplicial Complex Core
//
// Logline: Defines n-dimensional simplices, face relations, boundary maps, and abstract simplicial complex Euler characteristics.
//
// Setup: Fundamental combinatorial topological data structure for all filtered simplicial complex operations in TDA.
//
// Beats:
//   1. Define Simplex and SimplicialComplex data structures with vertex list indexing.
//   2. Generate codimension-1 faces and check simplex face inclusion relations.
//   3. Compute dimension-stratified simplex counts and Euler characteristic.

pub type Simplex = struct {
    vertices: List[Int],
    dimension: Int,
    filtration_val: Float,
    id: Int,
};

pub type SimplicialComplex = struct {
    simplices: List[Simplex],
    simplex_count: Int,
    max_dimension: Int,
};

pub fn simplex_new(id: Int, vertices: List[Int], filtration: Float) -> Simplex {
    let dim: Int = list_len(vertices) - 1;
    return Simplex {
        vertices: vertices,
        dimension: dim,
        filtration_val: filtration,
        id: id,
    };
}

pub fn simplicial_complex_new(max_dim: Int) -> SimplicialComplex {
    let empty_s: List[Simplex] = list_new();
    return SimplicialComplex {
        simplices: empty_s,
        simplex_count: 0,
        max_dimension: max_dim,
    };
}

pub fn simplicial_complex_add(sc: &mut SimplicialComplex, s: Simplex) -> Bool {
    if (s).dimension > (sc).max_dimension {
        return false;
    }
    (sc).simplices = list_push((sc).simplices, s);
    (sc).simplex_count = (sc).simplex_count + 1;
    return true;
}

pub fn simplicial_complex_get(sc: &SimplicialComplex, idx: Int) -> Simplex {
    return list_get((sc).simplices, idx);
}

pub fn simplex_has_vertex(s: &Simplex, v: Int) -> Bool {
    let n: Int = list_len((s).vertices);
    let mut i: Int = 0;
    while i < n {
        if list_get((s).vertices, i) == v {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn simplex_is_face_of(face: &Simplex, sup: &Simplex) -> Bool {
    if (face).dimension >= (sup).dimension {
        return false;
    }
    let n: Int = list_len((face).vertices);
    let mut i: Int = 0;
    while i < n {
        let v: Int = list_get((face).vertices, i);
        if !simplex_has_vertex(sup, v) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn simplicial_complex_count_dim(sc: &SimplicialComplex, dim: Int) -> Int {
    let mut count: Int = 0;
    let n: Int = (sc).simplex_count;
    let mut i: Int = 0;
    while i < n {
        let s: Simplex = list_get((sc).simplices, i);
        if (s).dimension == dim {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn simplicial_complex_euler_characteristic(sc: &SimplicialComplex) -> Int {
    let k0: Int = simplicial_complex_count_dim(sc, 0);
    let k1: Int = simplicial_complex_count_dim(sc, 1);
    let k2: Int = simplicial_complex_count_dim(sc, 2);
    let k3: Int = simplicial_complex_count_dim(sc, 3);
    return k0 - k1 + k2 - k3;
}
