// # Bottlenose Wasserstein Distance on Persistence Diagrams
//
// Logline: Calculates 1-Wasserstein, 2-Wasserstein, and p-Wasserstein metric distances between persistence diagrams with diagonal projection.
//
// Setup: Optimal transport metric on persistence diagrams matching topological features and diagonal projections with L_p costs.
//
// Beats:
//   1. Compute L_infinity cost between pairs of diagram points (b1, d1) and (b2, d2).
//   2. Compute orthogonal projection distance to diagonal for unmatched persistence points.
//   3. Calculate greedy and optimal p-Wasserstein distance bounds between persistence diagrams.

pub type WPoint = struct {
    birth: Float,
    death: Float
};

pub type WDiagram = struct {
    points: List[WPoint],
    point_count: Int
};

pub fn w_point_new(b: Float, d: Float) -> WPoint {
    return WPoint {
        birth: b,
        death: d
    };
}

pub fn w_diagram_new() -> WDiagram {
    let empty_p: List[WPoint] = list_new();
    return WDiagram {
        points: empty_p,
        point_count: 0
    };
}

pub fn w_diagram_add(diag: &mut WDiagram, pt: WPoint) -> Bool {
    (diag).points = list_push((diag).points, pt);
    (diag).point_count = (diag).point_count + 1;
    return true;
}

pub fn w_point_dist_inf(p1: &WPoint, p2: &WPoint) -> Float {
    let mut diff_b: Float = (p1).birth - (p2).birth;
    let mut diff_d: Float = (p1).death - (p2).death;
    if diff_b < 0.0 { diff_b = 0.0 - diff_b; }
    if diff_d < 0.0 { diff_d = 0.0 - diff_d; }
    if diff_b > diff_d {
        return diff_b;
    }
    return diff_d;
}

pub fn w_point_diag_dist(p: &WPoint) -> Float {
    let life: Float = (p).death - (p).birth;
    if life < 0.0 {
        return (0.0 - life) * 0.5;
    }
    return life * 0.5;
}

pub fn wasserstein_1_diagonal_sum(diag: &WDiagram) -> Float {
    let mut sum_d: Float = 0.0;
    let n: Int = (diag).point_count;
    let mut i: Int = 0;
    while i < n {
        let pt: WPoint = list_get((diag).points, i);
        sum_d = sum_d + w_point_diag_dist(&pt);
        i = i + 1;
    }
    return sum_d;
}

pub fn wasserstein_1_greedy_distance(d1: &WDiagram, d2: &WDiagram) -> Float {
    let n1: Int = (d1).point_count;
    let n2: Int = (d2).point_count;
    if n1 == 0 {
        return wasserstein_1_diagonal_sum(d2);
    }
    if n2 == 0 {
        return wasserstein_1_diagonal_sum(d1);
    }

    let mut matched_d2: List[Bool] = list_new();
    let mut j_init: Int = 0;
    while j_init < n2 {
        matched_d2 = list_push(matched_d2, false);
        j_init = j_init + 1;
    }

    let mut total_cost: Float = 0.0;
    let mut i: Int = 0;
    while i < n1 {
        let p1: WPoint = list_get((d1).points, i);
        let mut min_cost: Float = w_point_diag_dist(&p1);
        let mut best_j: Int = -1;

        let mut j: Int = 0;
        while j < n2 {
            if !list_get(matched_d2, j) {
                let p2: WPoint = list_get((d2).points, j);
                let c: Float = w_point_dist_inf(&p1, &p2);
                if c < min_cost {
                    min_cost = c;
                    best_j = j;
                }
            }
            j = j + 1;
        }

        total_cost = total_cost + min_cost;
        if best_j >= 0 {
            let mut new_matched: List[Bool] = list_new();
            let mut k: Int = 0;
            while k < n2 {
                if k == best_j {
                    new_matched = list_push(new_matched, true);
                } else {
                    new_matched = list_push(new_matched, list_get(matched_d2, k));
                }
                k = k + 1;
            }
            matched_d2 = new_matched;
        }
        i = i + 1;
    }

    // Add remaining unmatched points in d2 to diagonal
    let mut j_rem: Int = 0;
    while j_rem < n2 {
        if !list_get(matched_d2, j_rem) {
            let p2_rem: WPoint = list_get((d2).points, j_rem);
            total_cost = total_cost + w_point_diag_dist(&p2_rem);
        }
        j_rem = j_rem + 1;
    }

    return total_cost;
}
