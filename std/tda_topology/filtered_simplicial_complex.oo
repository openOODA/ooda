// # Filtered Simplicial Complex Monotonic Sequence
//
// Logline: Represents monotonically ordered simplicial filtration sequences ensuring subcomplex face-closure at every parameter step.
//
// Setup: Validated filtration sequence data structure mapping sorted simplex indices to persistent homology boundary matrices.
//
// Beats:
//   1. Define FilteredSimplex and FilteredSequence structures with sorted indexing.
//   2. Check monotonic filtration consistency and verify face-closure validity.
//   3. Extract active subcomplexes at given filtration threshold parameters.

pub type FilteredSimplex = struct {
    simplex_id: Int,
    dimension: Int,
    filtration_val: Float,
    sort_rank: Int,
    boundary_indices: List[Int]
};

pub type FilteredSequence = struct {
    elements: List[FilteredSimplex],
    element_count: Int,
    max_dimension: Int,
    is_sorted: Bool
};

pub fn filtered_simplex_new(
    id: Int,
    dim: Int,
    filt: Float,
    boundaries: List[Int]
) -> FilteredSimplex {
    return FilteredSimplex {
        simplex_id: id,
        dimension: dim,
        filtration_val: filt,
        sort_rank: -1,
        boundary_indices: boundaries
    };
}

pub fn filtered_sequence_new(max_dim: Int) -> FilteredSequence {
    let empty_elems: List[FilteredSimplex] = list_new();
    return FilteredSequence {
        elements: empty_elems,
        element_count: 0,
        max_dimension: max_dim,
        is_sorted: true
    };
}

pub fn filtered_sequence_add(seq: &mut FilteredSequence, s: FilteredSimplex) -> Bool {
    let n: Int = (seq).element_count;
    if n > 0 {
        let prev: FilteredSimplex = list_get((seq).elements, n - 1);
        if (s).filtration_val < (prev).filtration_val {
            (seq).is_sorted = false;
        }
    }
    (seq).elements = list_push((seq).elements, s);
    (seq).element_count = (seq).element_count + 1;
    return true;
}

pub fn filtered_sequence_get(seq: &FilteredSequence, idx: Int) -> FilteredSimplex {
    return list_get((seq).elements, idx);
}

pub fn filtered_sequence_active_count(seq: &FilteredSequence, threshold: Float) -> Int {
    let mut count: Int = 0;
    let n: Int = (seq).element_count;
    let mut i: Int = 0;
    while i < n {
        let s: FilteredSimplex = list_get((seq).elements, i);
        if (s).filtration_val <= threshold {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn filtered_sequence_verify_monotonicity(seq: &FilteredSequence) -> Bool {
    let n: Int = (seq).element_count;
    if n <= 1 {
        return true;
    }
    let mut i: Int = 1;
    while i < n {
        let prev: FilteredSimplex = list_get((seq).elements, i - 1);
        let curr: FilteredSimplex = list_get((seq).elements, i);
        if (curr).filtration_val < (prev).filtration_val {
            return false;
        }
        i = i + 1;
    }
    return true;
}
