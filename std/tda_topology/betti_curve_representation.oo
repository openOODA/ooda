// # Betti Curves & Euler Characteristic Representation
//
// Logline: Computes discrete Betti curves beta_k(t) and Euler Characteristic Curves (ECC) across continuous filtration thresholds.
//
// Setup: Dimension-stratified topological feature curves tracking homology ranks and alternating Euler sums over filtration parameters.
//
// Beats:
//   1. Define BettiSample and BettiCurve structures across multiple homology dimensions.
//   2. Compute Betti counts beta_0(t), beta_1(t), and beta_2(t) at discrete parameter steps.
//   3. Calculate the integrated Euler Characteristic Curve chi(t) = beta_0(t) - beta_1(t) + beta_2(t).

pub type BettiInterval = struct {
    birth: Float,
    death: Float,
    dimension: Int
};

pub type BettiCurve = struct {
    intervals: List[BettiInterval],
    interval_count: Int,
    t_min: Float,
    t_max: Float,
    num_steps: Int
};

pub fn betti_interval_new(b: Float, d: Float, dim: Int) -> BettiInterval {
    return BettiInterval {
        birth: b,
        death: d,
        dimension: dim
    };
}

pub fn betti_curve_new(t_min: Float, t_max: Float, steps: Int) -> BettiCurve {
    let empty_i: List[BettiInterval] = list_new();
    return BettiCurve {
        intervals: empty_i,
        interval_count: 0,
        t_min: t_min,
        t_max: t_max,
        num_steps: steps
    };
}

pub fn betti_curve_add_interval(bc: &mut BettiCurve, b: Float, d: Float, dim: Int) -> Bool {
    let iv: BettiInterval = betti_interval_new(b, d, dim);
    (bc).intervals = list_push((bc).intervals, iv);
    (bc).interval_count = (bc).interval_count + 1;
    return true;
}

pub fn betti_curve_eval_dim(bc: &BettiCurve, dim: Int, t: Float) -> Int {
    let mut count: Int = 0;
    let n: Int = (bc).interval_count;
    let mut i: Int = 0;
    while i < n {
        let iv: BettiInterval = list_get((bc).intervals, i);
        if (iv).dimension == dim {
            if (iv).birth <= t && t < (iv).death {
                count = count + 1;
            }
        }
        i = i + 1;
    }
    return count;
}

pub fn betti_curve_eval_ecc(bc: &BettiCurve, t: Float) -> Int {
    let b0: Int = betti_curve_eval_dim(bc, 0, t);
    let b1: Int = betti_curve_eval_dim(bc, 1, t);
    let b2: Int = betti_curve_eval_dim(bc, 2, t);
    return b0 - b1 + b2;
}

pub fn betti_curve_discretize_ecc(bc: &BettiCurve) -> List[Int] {
    let mut ecc_curve: List[Int] = list_new();
    let n: Int = (bc).num_steps;
    if n <= 1 {
        return ecc_curve;
    }
    let t_min: Float = (bc).t_min;
    let t_max: Float = (bc).t_max;

    let mut i: Int = 0;
    while i < n {
        let mut i_f: Float = 0.0;
        let mut c: Int = 0;
        while c < i { i_f = i_f + 1.0; c = c + 1; }
        let mut n_f: Float = 0.0;
        let mut cn: Int = 0;
        while cn < (n - 1) { n_f = n_f + 1.0; cn = cn + 1; }

        let t: Float = t_min + ((t_max - t_min) * (i_f / n_f));
        let ecc_val: Int = betti_curve_eval_ecc(bc, t);
        ecc_curve = list_push(ecc_curve, ecc_val);
        i = i + 1;
    }
    return ecc_curve;
}
