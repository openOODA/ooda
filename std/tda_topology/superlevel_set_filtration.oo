// # Superlevel Set & Merge Tree Filtration
//
// Logline: Implements superlevel set filtrations and merge trees tracking topological peak merges across descending thresholds.
//
// Setup: Dual scalar filtration mapping upper-level sets f(x) >= t to evolving topological components and persistent maxima.
//
// Beats:
//   1. Assign scalar peak values and descending threshold filtration values.
//   2. Track component births at local maxima and merge events at saddle points.
//   3. Build 0D persistent homology merge trees for peak significance ranking.

pub type SuperlevelPeak = struct {
    peak_id: Int,
    height: Float,
    is_alive: Bool
};

pub type MergeEvent = struct {
    parent_peak_id: Int,
    child_peak_id: Int,
    merge_height: Float,
    persistence: Float
};

pub type SuperlevelMergeTree = struct {
    peaks: List[SuperlevelPeak],
    events: List[MergeEvent],
    peak_count: Int,
    event_count: Int
};

pub fn superlevel_peak_new(id: Int, height: Float) -> SuperlevelPeak {
    return SuperlevelPeak {
        peak_id: id,
        height: height,
        is_alive: true
    };
}

pub fn merge_event_new(p_id: Int, c_id: Int, h_merge: Float, h_child: Float) -> MergeEvent {
    return MergeEvent {
        parent_peak_id: p_id,
        child_peak_id: c_id,
        merge_height: h_merge,
        persistence: h_child - h_merge
    };
}

pub fn superlevel_merge_tree_new() -> SuperlevelMergeTree {
    let empty_p: List[SuperlevelPeak] = list_new();
    let empty_e: List[MergeEvent] = list_new();
    return SuperlevelMergeTree {
        peaks: empty_p,
        events: empty_e,
        peak_count: 0,
        event_count: 0
    };
}

pub fn merge_tree_add_peak(tree: &mut SuperlevelMergeTree, p: SuperlevelPeak) -> Bool {
    (tree).peaks = list_push((tree).peaks, p);
    (tree).peak_count = (tree).peak_count + 1;
    return true;
}

pub fn merge_tree_record_merge(
    tree: &mut SuperlevelMergeTree,
    parent_id: Int,
    child_id: Int,
    merge_h: Float,
    child_h: Float
) -> Bool {
    let evt: MergeEvent = merge_event_new(parent_id, child_id, merge_h, child_h);
    (tree).events = list_push((tree).events, evt);
    (tree).event_count = (tree).event_count + 1;
    return true;
}

pub fn merge_tree_get_event(tree: &SuperlevelMergeTree, idx: Int) -> MergeEvent {
    return list_get((tree).events, idx);
}
