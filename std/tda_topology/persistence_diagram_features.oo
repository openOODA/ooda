// # Persistence Diagram Statistical Features
//
// Logline: Extracts 2D birth-death diagram representations, lifetime statistics, and total persistence summary metrics.
//
// Setup: Quantitative persistence diagram analysis mapping multiscale topological points (b, d) to geometric summary statistics.
//
// Beats:
//   1. Define DiagramPoint and PersistenceDiagram structures with dimension stratification.
//   2. Compute total persistence sum (death - birth)^p and average lifetime.
//   3. Extract diagram bounding boxes, diagonal distances, and center-of-mass coordinates.

pub type DiagramPoint = struct {
    birth: Float,
    death: Float,
    lifetime: Float,
    dimension: Int,
    dist_to_diag: Float
};

pub type PersistenceDiagram = struct {
    points: List[DiagramPoint],
    point_count: Int,
    dimension: Int
};

pub fn diagram_point_new(birth: Float, death: Float, dim: Int) -> DiagramPoint {
    let life: Float = death - birth;
    // Orthogonal distance to diagonal line y = x is (death - birth) / sqrt(2)
    let diag_dist: Float = life * 0.7071067811865475;
    return DiagramPoint {
        birth: birth,
        death: death,
        lifetime: life,
        dimension: dim,
        dist_to_diag: diag_dist
    };
}

pub fn persistence_diagram_new(dim: Int) -> PersistenceDiagram {
    let empty_pts: List[DiagramPoint] = list_new();
    return PersistenceDiagram {
        points: empty_pts,
        point_count: 0,
        dimension: dim
    };
}

pub fn persistence_diagram_add(pd: &mut PersistenceDiagram, pt: DiagramPoint) -> Bool {
    (pd).points = list_push((pd).points, pt);
    (pd).point_count = (pd).point_count + 1;
    return true;
}

pub fn persistence_diagram_total_persistence(pd: &PersistenceDiagram, p_power: Float) -> Float {
    let mut total: Float = 0.0;
    let n: Int = (pd).point_count;
    let mut i: Int = 0;
    while i < n {
        let pt: DiagramPoint = list_get((pd).points, i);
        let life: Float = (pt).lifetime;
        if p_power == 1.0 {
            total = total + life;
        } else if p_power == 2.0 {
            total = total + (life * life);
        } else {
            total = total + life;
        }
        i = i + 1;
    }
    return total;
}

pub fn persistence_diagram_max_lifetime(pd: &PersistenceDiagram) -> Float {
    let mut max_life: Float = 0.0;
    let n: Int = (pd).point_count;
    let mut i: Int = 0;
    while i < n {
        let pt: DiagramPoint = list_get((pd).points, i);
        if (pt).lifetime > max_life {
            max_life = (pt).lifetime;
        }
        i = i + 1;
    }
    return max_life;
}

pub fn persistence_diagram_center_of_mass(pd: &PersistenceDiagram) -> List[Float] {
    let mut com: List[Float] = list_new();
    let n: Int = (pd).point_count;
    if n == 0 {
        com = list_push(com, 0.0);
        com = list_push(com, 0.0);
        return com;
    }
    let mut sum_b: Float = 0.0;
    let mut sum_d: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let pt: DiagramPoint = list_get((pd).points, i);
        sum_b = sum_b + (pt).birth;
        sum_d = sum_d + (pt).death;
        i = i + 1;
    }
    let mut n_f: Float = 0.0;
    let mut c: Int = 0;
    while c < n {
        n_f = n_f + 1.0;
        c = c + 1;
    }
    com = list_push(com, sum_b / n_f);
    com = list_push(com, sum_d / n_f);
    return com;
}

pub fn persistence_diagram_get(pd: &PersistenceDiagram, idx: Int) -> DiagramPoint {
    return list_get((pd).points, idx);
}
