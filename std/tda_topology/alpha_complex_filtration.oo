// # Alpha Complex & Alpha Shape Filtration
//
// Logline: Builds filtered Alpha complexes from Delaunay triangulations filtered by circumradii squared.
//
// Setup: Geometric Alpha complex construction providing a homotopy equivalent, compact alternative to Vietoris-Rips complexes.
//
// Beats:
//   1. Define AlphaSimplex with Delaunay circumradius-squared filtration values.
//   2. Filter Delaunay vertices, edges, and 2D triangles below alpha threshold alpha_max.
//   3. Compute Alpha shape surface area and boundary simplex classifications.

pub type AlphaSimplex = struct {
    v0: Int,
    v1: Int,
    v2: Int,
    dimension: Int,
    alpha_sq: Float,
    is_boundary: Bool,
};

pub type AlphaComplex = struct {
    simplices: List[AlphaSimplex],
    simplex_count: Int,
    max_alpha_sq: Float,
    num_points: Int,
};

pub fn alpha_simplex_0d(v: Int) -> AlphaSimplex {
    return AlphaSimplex {
        v0: v,
        v1: -1,
        v2: -1,
        dimension: 0,
        alpha_sq: 0.0,
        is_boundary: false,
    };
}

pub fn alpha_simplex_1d(u: Int, v: Int, r_sq: Float) -> AlphaSimplex {
    return AlphaSimplex {
        v0: u,
        v1: v,
        v2: -1,
        dimension: 1,
        alpha_sq: r_sq,
        is_boundary: false,
    };
}

pub fn alpha_simplex_2d(u: Int, v: Int, w: Int, circum_r_sq: Float) -> AlphaSimplex {
    return AlphaSimplex {
        v0: u,
        v1: v,
        v2: w,
        dimension: 2,
        alpha_sq: circum_r_sq,
        is_boundary: false,
    };
}

pub fn alpha_complex_new(max_alpha_sq: Float, n_points: Int) -> AlphaComplex {
    let empty_s: List[AlphaSimplex] = list_new();
    return AlphaComplex {
        simplices: empty_s,
        simplex_count: 0,
        max_alpha_sq: max_alpha_sq,
        num_points: n_points,
    };
}

pub fn alpha_complex_add_simplex(c: &mut AlphaComplex, s: AlphaSimplex) -> Bool {
    if (s).alpha_sq > (c).max_alpha_sq {
        return false;
    }
    (c).simplices = list_push((c).simplices, s);
    (c).simplex_count = (c).simplex_count + 1;
    return true;
}

pub fn alpha_complex_count_active(c: &AlphaComplex, alpha_limit_sq: Float) -> Int {
    let mut count: Int = 0;
    let n: Int = (c).simplex_count;
    let mut i: Int = 0;
    while i < n {
        let s: AlphaSimplex = list_get((c).simplices, i);
        if (s).alpha_sq <= alpha_limit_sq {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn alpha_complex_get(c: &AlphaComplex, idx: Int) -> AlphaSimplex {
    return list_get((c).simplices, idx);
}
