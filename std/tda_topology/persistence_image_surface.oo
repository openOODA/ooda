// # Persistence Images & Surface Rasterization
//
// Logline: Converts persistence diagrams into fixed-size vectorized 2D persistence images via Gaussian smoothing and linear weighting.
//
// Setup: Adams et al. persistence images transforming topological diagrams into vector representations for standard ML models.
//
// Beats:
//   1. Map persistence points (b, d) to rotated coordinates (birth, persistence = d - b).
//   2. Apply bounded ramp weighting functions w(x, y) = y / y_max.
//   3. Rasterize 2D Gaussian kernels over an N x M pixel grid to generate image matrices.

pub type PiPoint = struct {
    birth: Float,
    persistence: Float,
    weight: Float
};

pub type PersistenceImageGrid = struct {
    width: Int,
    height: Int,
    pixels: List[Float],
    sigma: Float,
    b_min: Float,
    b_max: Float,
    p_min: Float,
    p_max: Float
};

pub fn pi_point_new(b: Float, d: Float, p_max: Float) -> PiPoint {
    let p: Float = d - b;
    let mut w: Float = 0.0;
    if p_max > 0.0 {
        w = p / p_max;
        if w > 1.0 { w = 1.0; }
        if w < 0.0 { w = 0.0; }
    }
    return PiPoint {
        birth: b,
        persistence: p,
        weight: w
    };
}

pub fn persistence_image_grid_new(
    w: Int, h: Int, sigma: Float,
    b_min: Float, b_max: Float,
    p_min: Float, p_max: Float
) -> PersistenceImageGrid {
    let total: Int = w * h;
    let mut px: List[Float] = list_new();
    let mut i: Int = 0;
    while i < total {
        px = list_push(px, 0.0);
        i = i + 1;
    }
    return PersistenceImageGrid {
        width: w,
        height: h,
        pixels: px,
        sigma: sigma,
        b_min: b_min,
        b_max: b_max,
        p_min: p_min,
        p_max: p_max
    };
}

pub fn persistence_image_rasterize_point(
    grid: &mut PersistenceImageGrid,
    pt: &PiPoint
) -> Bool {
    let w: Int = (grid).width;
    let h: Int = (grid).height;
    let sigma: Float = (grid).sigma;
    let two_s_sq: Float = 2.0 * sigma * sigma;
    if two_s_sq <= 0.0 {
        return false;
    }

    let b_min: Float = (grid).b_min;
    let b_max: Float = (grid).b_max;
    let p_min: Float = (grid).p_min;
    let p_max: Float = (grid).p_max;

    let mut new_px: List[Float] = list_new();
    let mut y_idx: Int = 0;
    while y_idx < h {
        let mut y_f: Float = 0.0;
        let mut cy: Int = 0;
        while cy < y_idx { y_f = y_f + 1.0; cy = cy + 1; }
        let mut h_f: Float = 0.0;
        let mut ch: Int = 0;
        while ch < h { h_f = h_f + 1.0; ch = ch + 1; }
        let grid_p: Float = p_min + ((p_max - p_min) * ((y_f + 0.5) / h_f));

        let mut x_idx: Int = 0;
        while x_idx < w {
            let mut x_f: Float = 0.0;
            let mut cx: Int = 0;
            while cx < x_idx { x_f = x_f + 1.0; cx = cx + 1; }
            let mut w_f: Float = 0.0;
            let mut cw: Int = 0;
            while cw < w { w_f = w_f + 1.0; cw = cw + 1; }
            let grid_b: Float = b_min + ((b_max - b_min) * ((x_f + 0.5) / w_f));

            let db: Float = grid_b - (pt).birth;
            let dp: Float = grid_p - (pt).persistence;
            let g_val: Float = exp(0.0 - (((db * db) + (dp * dp)) / two_s_sq));
            let contribution: Float = (pt).weight * g_val;

            let cur_idx: Int = (y_idx * w) + x_idx;
            let old_val: Float = list_get((grid).pixels, cur_idx);
            new_px = list_push(new_px, old_val + contribution);

            x_idx = x_idx + 1;
        }
        y_idx = y_idx + 1;
    }

    (grid).pixels = new_px;
    return true;
}

pub fn persistence_image_get_pixel(grid: &PersistenceImageGrid, x: Int, y: Int) -> Float {
    let w: Int = (grid).width;
    let idx: Int = (y * w) + x;
    return list_get((grid).pixels, idx);
}
