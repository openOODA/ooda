// # Mapper Interval Cover & Clustering
//
// Logline: Generates overlapping interval covers and performs single-linkage clustering on pre-image subsets for Mapper.
//
// Setup: Pullback covering U_alpha of range space and partition of data into connected cluster components.
//
// Beats:
//   1. Construct overlapping 1D intervals [a_i, b_i] with configurable gain/overlap ratio.
//   2. Assign data points to all overlapping interval bins covering their lens values.
//   3. Perform single-linkage threshold clustering on each bin's point subset.

pub type MapperInterval = struct {
    interval_index: Int,
    min_val: Float,
    max_val: Float,
    point_indices: List[Int],
    point_count: Int
};

pub type MapperCover = struct {
    intervals: List[MapperInterval],
    num_intervals: Int,
    overlap_ratio: Float
};

pub fn mapper_interval_new(idx: Int, min_v: Float, max_v: Float) -> MapperInterval {
    let empty_p: List[Int] = list_new();
    return MapperInterval {
        interval_index: idx,
        min_val: min_v,
        max_val: max_v,
        point_indices: empty_p,
        point_count: 0
    };
}

pub fn mapper_cover_new(
    num_intervals: Int,
    overlap: Float,
    data_min: Float,
    data_max: Float
) -> MapperCover {
    let mut intervals: List[MapperInterval] = list_new();
    let total_range: Float = data_max - data_min;
    if num_intervals <= 0 || total_range <= 0.0 {
        return MapperCover {
            intervals: intervals,
            num_intervals: 0,
            overlap_ratio: overlap
        };
    }

    let mut n_f: Float = 0.0;
    let mut cn: Int = 0;
    while cn < num_intervals { n_f = n_f + 1.0; cn = cn + 1; }

    // Base interval length L = range / (N - (N-1)*overlap)
    let denom: Float = n_f - ((n_f - 1.0) * overlap);
    let l_len: Float = total_range / denom;
    let step: Float = l_len * (1.0 - overlap);

    let mut i: Int = 0;
    while i < num_intervals {
        let mut i_f: Float = 0.0;
        let mut ci: Int = 0;
        while ci < i { i_f = i_f + 1.0; ci = ci + 1; }

        let start: Float = data_min + (i_f * step);
        let end_v: Float = start + l_len;
        let iv: MapperInterval = mapper_interval_new(i, start, end_v);
        intervals = list_push(intervals, iv);
        i = i + 1;
    }

    return MapperCover {
        intervals: intervals,
        num_intervals: num_intervals,
        overlap_ratio: overlap
    };
}

pub fn mapper_cover_assign_point(
    cover: &mut MapperCover,
    point_idx: Int,
    lens_val: Float
) -> Int {
    let mut added_count: Int = 0;
    let n: Int = (cover).num_intervals;
    let mut new_intervals: List[MapperInterval] = list_new();

    let mut i: Int = 0;
    while i < n {
        let mut iv: MapperInterval = list_get((cover).intervals, i);
        if (iv).min_val <= lens_val && lens_val <= (iv).max_val {
            iv.point_indices = list_push((iv).point_indices, point_idx);
            iv.point_count = (iv).point_count + 1;
            added_count = added_count + 1;
        }
        new_intervals = list_push(new_intervals, iv);
        i = i + 1;
    }
    (cover).intervals = new_intervals;
    return added_count;
}

pub fn mapper_cover_get_interval(cover: &MapperCover, idx: Int) -> MapperInterval {
    return list_get((cover).intervals, idx);
}
