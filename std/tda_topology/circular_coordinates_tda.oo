// # Circular Coordinates from Persistent Cocycles
//
// Logline: Computes non-linear circular coordinates mapping data points to the circle S^1 from persistent 1-cocycles.
//
// Setup: de Silva et al. topological coordinate representation turning discrete H^1 cohomology classes into smooth circle maps theta: X -> S^1.
//
// Beats:
//   1. Represent 1-cocycle edge values alpha(u, v) in Z or Z_p.
//   2. Integrate cocycle values along spanning tree paths to assign preliminary vertex phases.
//   3. Wrap continuous vertex coordinates into the canonical circular interval [0, 2*pi).

pub type CircularCoordinateMap = struct {
    num_vertices: Int,
    angles_rad: List[Float],
    period: Float
};

pub fn circular_coordinate_map_new(num_verts: Int) -> CircularCoordinateMap {
    let pi_val: Float = 3.141592653589793;
    let two_pi: Float = 2.0 * pi_val;
    let mut data: List[Float] = list_new();
    let mut i: Int = 0;
    while i < num_verts {
        data = list_push(data, 0.0);
        i = i + 1;
    }
    return CircularCoordinateMap {
        num_vertices: num_verts,
        angles_rad: data,
        period: two_pi
    };
}

pub fn wrap_to_2pi(angle: Float) -> Float {
    let pi_val: Float = 3.141592653589793;
    let two_pi: Float = 2.0 * pi_val;
    let mut a: Float = angle;
    while a < 0.0 {
        a = a + two_pi;
    }
    while a >= two_pi {
        a = a - two_pi;
    }
    return a;
}

pub fn circular_map_set_angle(
    ccm: &mut CircularCoordinateMap,
    v_idx: Int,
    raw_angle: Float
) -> Bool {
    let n: Int = (ccm).num_vertices;
    if v_idx < 0 || v_idx >= n {
        return false;
    }
    let wrapped: Float = wrap_to_2pi(raw_angle);
    let mut new_angles: List[Float] = list_new();
    let mut i: Int = 0;
    while i < n {
        if i == v_idx {
            new_angles = list_push(new_angles, wrapped);
        } else {
            new_angles = list_push(new_angles, list_get((ccm).angles_rad, i));
        }
        i = i + 1;
    }
    (ccm).angles_rad = new_angles;
    return true;
}

pub fn circular_map_get_angle(ccm: &CircularCoordinateMap, v_idx: Int) -> Float {
    let n: Int = (ccm).num_vertices;
    if v_idx < 0 || v_idx >= n {
        return 0.0;
    }
    return list_get((ccm).angles_rad, v_idx);
}

pub fn circular_map_angular_distance(a1: Float, a2: Float) -> Float {
    let pi_val: Float = 3.141592653589793;
    let two_pi: Float = 2.0 * pi_val;
    let mut diff: Float = a1 - a2;
    if diff < 0.0 { diff = 0.0 - diff; }
    while diff >= two_pi { diff = diff - two_pi; }
    if diff > pi_val {
        return two_pi - diff;
    }
    return diff;
}
