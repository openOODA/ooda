// # Persistent Entropy & Topological Complexity
//
// Logline: Calculates persistent entropy and normalized Shannon information content from persistence barcode intervals.
//
// Setup: Information-theoretic topological measure quantifying the uniformity and diversity of persistent lifetimes.
//
// Beats:
//   1. Compute normalized persistence probability distribution p_i = l_i / sum(l_j).
//   2. Calculate Shannon persistent entropy H = -sum(p_i * ln(p_i)).
//   3. Compute normalized persistent entropy scaled by log(N) for interval count invariance.

pub type EntropyInterval = struct {
    birth: Float,
    death: Float,
    lifetime: Float
};

pub type PersistentEntropy = struct {
    intervals: List[EntropyInterval],
    interval_count: Int,
    total_lifetime: Float,
    entropy_value: Float,
    normalized_entropy: Float
};

pub fn entropy_interval_new(b: Float, d: Float) -> EntropyInterval {
    return EntropyInterval {
        birth: b,
        death: d,
        lifetime: d - b
    };
}

pub fn persistent_entropy_new() -> PersistentEntropy {
    let empty_i: List[EntropyInterval] = list_new();
    return PersistentEntropy {
        intervals: empty_i,
        interval_count: 0,
        total_lifetime: 0.0,
        entropy_value: 0.0,
        normalized_entropy: 0.0
    };
}

pub fn persistent_entropy_add(pe: &mut PersistentEntropy, b: Float, d: Float) -> Bool {
    let iv: EntropyInterval = entropy_interval_new(b, d);
    (pe).intervals = list_push((pe).intervals, iv);
    (pe).interval_count = (pe).interval_count + 1;
    (pe).total_lifetime = (pe).total_lifetime + (iv).lifetime;
    return true;
}

pub fn persistent_entropy_compute(pe: &mut PersistentEntropy) -> Float {
    let n: Int = (pe).interval_count;
    let tot: Float = (pe).total_lifetime;
    if n <= 1 || tot <= 0.0 {
        (pe).entropy_value = 0.0;
        (pe).normalized_entropy = 0.0;
        return 0.0;
    }

    let mut h: Float = 0.0;
    let mut i: Int = 0;
    while i < n {
        let iv: EntropyInterval = list_get((pe).intervals, i);
        let p_i: Float = (iv).lifetime / tot;
        if p_i > 0.0000001 {
            let log_p: Float = ln(p_i);
            h = h - (p_i * log_p);
        }
        i = i + 1;
    }
    (pe).entropy_value = h;

    let mut n_f: Float = 0.0;
    let mut c: Int = 0;
    while c < n { n_f = n_f + 1.0; c = c + 1; }
    let max_h: Float = ln(n_f);
    if max_h > 0.0 {
        (pe).normalized_entropy = h / max_h;
    } else {
        (pe).normalized_entropy = 0.0;
    }
    return h;
}

pub fn persistent_entropy_get_normalized(pe: &PersistentEntropy) -> Float {
    return (pe).normalized_entropy;
}
