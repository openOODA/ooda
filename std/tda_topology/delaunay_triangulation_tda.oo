// # Delaunay Triangulation & Circumcircle Primitives
//
// Logline: Implements 2D Delaunay geometric predicates, circumcenter calculations, and empty-circumcircle testing for TDA complexes.
//
// Setup: Planar geometric triangulation foundation used in Alpha complexes and Delaunay-based persistent homology.
//
// Beats:
//   1. Define DelaunayTriangle and DelaunayCircumcircle data structures.
//   2. Compute 2D circumcenter coordinates and circumradius from three vertices.
//   3. Implement in-circle determinant test for empty circumcircle verification.

pub type DelaunayCircumcircle = struct {
    center_x: Float,
    center_y: Float,
    radius: Float,
    radius_sq: Float,
};

pub type DelaunayTriangle = struct {
    p0: Int,
    p1: Int,
    p2: Int,
    circle: DelaunayCircumcircle,
};

pub fn circumcircle_new(cx: Float, cy: Float, r: Float) -> DelaunayCircumcircle {
    return DelaunayCircumcircle {
        center_x: cx,
        center_y: cy,
        radius: r,
        radius_sq: r * r,
    };
}

pub fn compute_circumcircle_2d(
    x1: Float, y1: Float,
    x2: Float, y2: Float,
    x3: Float, y3: Float
) -> DelaunayCircumcircle {
    let d: Float = 2.0 * (x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2));
    if d == 0.0 {
        return circumcircle_new(0.0, 0.0, 999999.0);
    }
    let sq1: Float = (x1 * x1) + (y1 * y1);
    let sq2: Float = (x2 * x2) + (y2 * y2);
    let sq3: Float = (x3 * x3) + (y3 * y3);

    let ux: Float = (sq1 * (y2 - y3) + sq2 * (y3 - y1) + sq3 * (y1 - y2)) / d;
    let uy: Float = (sq1 * (x3 - x2) + sq2 * (x1 - x3) + sq3 * (x2 - x1)) / d;

    let dx: Float = x1 - ux;
    let dy: Float = y1 - uy;
    let r_sq: Float = (dx * dx) + (dy * dy);
    let r: Float = sqrt(r_sq);

    return DelaunayCircumcircle {
        center_x: ux,
        center_y: uy,
        radius: r,
        radius_sq: r_sq,
    };
}

pub fn is_point_in_circumcircle(
    circle: &DelaunayCircumcircle,
    px: Float,
    py: Float
) -> Bool {
    let dx: Float = px - (circle).center_x;
    let dy: Float = py - (circle).center_y;
    let dist_sq: Float = (dx * dx) + (dy * dy);
    return dist_sq < (circle).radius_sq;
}

pub fn delaunay_triangle_new(
    p0: Int, p1: Int, p2: Int,
    x0: Float, y0: Float,
    x1: Float, y1: Float,
    x2: Float, y2: Float
) -> DelaunayTriangle {
    let circ: DelaunayCircumcircle = compute_circumcircle_2d(x0, y0, x1, y1, x2, y2);
    return DelaunayTriangle {
        p0: p0,
        p1: p1,
        p2: p2,
        circle: circ,
    };
}

pub fn triangle_area_2d(
    x0: Float, y0: Float,
    x1: Float, y1: Float,
    x2: Float, y2: Float
) -> Float {
    let cross: Float = (x1 - x0) * (y2 - y0) - (y1 - y0) * (x2 - x0);
    if cross < 0.0 {
        return (0.0 - cross) * 0.5;
    }
    return cross * 0.5;
}
