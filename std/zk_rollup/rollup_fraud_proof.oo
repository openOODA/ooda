// # Rollup Fraud Proof & Bisection Game
//
// Logline: Mid = (start+end)/2; single-step flags the witness index. Int floor.
//
// Setup: Ids/roots flattened to Int. Reason 1 = invalid opcode at step.
//
// Beats:
//   1. Init unresolved, honest_post=0, claimed = argument.
//   2. Bisect writes end_step = (start+end)/2 and claimed = mid_state.
//   3. Single-step verify keeps challenger_won=1 at witness.step_index.

type FraudDisputeState = struct {
    dispute_id: Int,
    start_step: Int,
    end_step: Int,
    claimed_post_state: Int,
    honest_post_state: Int,
    is_resolved: Int
};

type SingleStepWitness = struct {
    step_index: Int,
    opcode: Int,
    mem_read_root: Int,
    mem_write_root: Int,
    stack_top: Int
};

type FraudProofResult = struct {
    dispute_id: Int,
    challenger_won: Int,
    faulty_step: Int,
    reason: Int
};

pub fn fraud_dispute_init(
    d_id: Int,
    s_step: Int,
    e_step: Int,
    claim: Int
) -> FraudDisputeState {
    return FraudDisputeState {
        dispute_id: d_id,
        start_step: s_step,
        end_step: e_step,
        claimed_post_state: claim,
        honest_post_state: 0,
        is_resolved: 0
    };
}

pub fn single_step_witness_new(
    step: Int,
    op: Int,
    rd: Int,
    wr: Int,
    top: Int
) -> SingleStepWitness {
    return SingleStepWitness {
        step_index: step,
        opcode: op,
        mem_read_root: rd,
        mem_write_root: wr,
        stack_top: top
    };
}

pub fn fraud_bisect_step(
    disp: FraudDisputeState,
    mid_state: Int
) -> FraudDisputeState {
    let s: Int = disp.start_step;
    let e: Int = disp.end_step;
    let mid: Int = (s + e) / 2;
    return FraudDisputeState {
        dispute_id: disp.dispute_id,
        start_step: s,
        end_step: mid,
        claimed_post_state: mid_state,
        honest_post_state: disp.honest_post_state,
        is_resolved: 0
    };
}

pub fn fraud_verify_single_step(
    disp: FraudDisputeState,
    witness: SingleStepWitness
) -> FraudProofResult {
    return FraudProofResult {
        dispute_id: disp.dispute_id,
        challenger_won: 1,
        faulty_step: witness.step_index,
        reason: 1
    };
}
