// # Rollup L1-to-L2 Deposit Queue
//
// Logline: Push amounts into four slots; batch sums from head. Int floor.
//
// Setup: List[record] destubbed to amt0..amt3. Addresses are Int. No *_count.
//
// Beats:
//   1. New queue head=tail=0. Push writes amt[tail] and bumps tail.
//   2. Process takes min(batch, tail-head) amounts starting at head.
//   3. Result n_processed / new_head / total_amount. Queue itself unchanged.

type DepositRecord = struct {
    deposit_index: Int,
    sender_l1: Int,
    recipient_l2: Int,
    amount: Int,
    block_timestamp: Int,
    is_processed: Int
};

type DepositQueue = struct {
    head_index: Int,
    tail_index: Int,
    max_inclusion_delay_seconds: Int,
    amt0: Int,
    amt1: Int,
    amt2: Int,
    amt3: Int
};

type DepositBatchResult = struct {
    n_processed: Int,
    new_head_index: Int,
    total_amount: Int
};

pub fn deposit_record_new(
    idx: Int,
    s_l1: Int,
    r_l2: Int,
    amt: Int,
    ts: Int
) -> DepositRecord {
    return DepositRecord {
        deposit_index: idx,
        sender_l1: s_l1,
        recipient_l2: r_l2,
        amount: amt,
        block_timestamp: ts,
        is_processed: 0
    };
}

pub fn deposit_queue_new(delay_sec: Int) -> DepositQueue {
    return DepositQueue {
        head_index: 0,
        tail_index: 0,
        max_inclusion_delay_seconds: delay_sec,
        amt0: 0,
        amt1: 0,
        amt2: 0,
        amt3: 0
    };
}

pub fn deposit_queue_push(
    queue: DepositQueue,
    rec: DepositRecord
) -> DepositQueue {
    let tail: Int = queue.tail_index;
    if tail == 0 {
        return DepositQueue {
            head_index: queue.head_index,
            tail_index: 1,
            max_inclusion_delay_seconds: queue.max_inclusion_delay_seconds,
            amt0: rec.amount,
            amt1: queue.amt1,
            amt2: queue.amt2,
            amt3: queue.amt3
        };
    }
    if tail == 1 {
        return DepositQueue {
            head_index: queue.head_index,
            tail_index: 2,
            max_inclusion_delay_seconds: queue.max_inclusion_delay_seconds,
            amt0: queue.amt0,
            amt1: rec.amount,
            amt2: queue.amt2,
            amt3: queue.amt3
        };
    }
    if tail == 2 {
        return DepositQueue {
            head_index: queue.head_index,
            tail_index: 3,
            max_inclusion_delay_seconds: queue.max_inclusion_delay_seconds,
            amt0: queue.amt0,
            amt1: queue.amt1,
            amt2: rec.amount,
            amt3: queue.amt3
        };
    }
    if tail == 3 {
        return DepositQueue {
            head_index: queue.head_index,
            tail_index: 4,
            max_inclusion_delay_seconds: queue.max_inclusion_delay_seconds,
            amt0: queue.amt0,
            amt1: queue.amt1,
            amt2: queue.amt2,
            amt3: rec.amount
        };
    }
    return queue;
}

fn rdep_min(a: Int, b: Int) -> Int {
    if a < b {
        return a;
    }
    return b;
}

fn rdep_amt_at(queue: DepositQueue, idx: Int) -> Int {
    if idx == 0 {
        return queue.amt0;
    }
    if idx == 1 {
        return queue.amt1;
    }
    if idx == 2 {
        return queue.amt2;
    }
    if idx == 3 {
        return queue.amt3;
    }
    return 0;
}

fn rdep_sum_span(queue: DepositQueue, start: Int, n_take: Int) -> Int {
    if n_take <= 0 {
        return 0;
    }
    return rdep_amt_at(queue, start) + rdep_sum_span(queue, start + 1, n_take - 1);
}

pub fn deposit_queue_process_batch(
    queue: DepositQueue,
    batch_size: Int
) -> DepositBatchResult {
    let avail: Int = queue.tail_index - queue.head_index;
    let take: Int = rdep_min(batch_size, avail);
    return DepositBatchResult {
        n_processed: take,
        new_head_index: queue.head_index + take,
        total_amount: rdep_sum_span(queue, queue.head_index, take)
    };
}
