// # Rollup Transaction Envelope
//
// Logline: Intrinsic gas 21000; reject gas < 21000 or value < 0. Int floor.
//
// Setup: Address/sig/data flattened to Int. Defaults: fee=1e9, v=27, r=s=0.
//
// Beats:
//   1. New envelope is_valid=1, data_hex=0, max_fee_per_gas=1000000000.
//   2. Gas below 21000 → error 1, intrinsic stays 21000.
//   3. Negative value → error 2.

type RollupTxEnvelope = struct {
    tx_type: Int,
    chain_id: Int,
    nonce: Int,
    to_address: Int,
    value: Int,
    data_hex: Int,
    gas_limit: Int,
    max_fee_per_gas: Int,
    sig_v: Int,
    sig_r: Int,
    sig_s: Int,
    is_valid: Int
};

type TxValidationResult = struct {
    is_valid: Int,
    intrinsic_gas: Int,
    error_reason: Int
};

pub fn rollup_tx_envelope_new(
    t_type: Int,
    c_id: Int,
    n_val: Int,
    to_addr: Int,
    val_amt: Int,
    g_lim: Int
) -> RollupTxEnvelope {
    return RollupTxEnvelope {
        tx_type: t_type,
        chain_id: c_id,
        nonce: n_val,
        to_address: to_addr,
        value: val_amt,
        data_hex: 0,
        gas_limit: g_lim,
        max_fee_per_gas: 1000000000,
        sig_v: 27,
        sig_r: 0,
        sig_s: 0,
        is_valid: 1
    };
}

pub fn rollup_tx_validate(env: RollupTxEnvelope) -> TxValidationResult {
    let g: Int = env.gas_limit;
    if g < 21000 {
        return TxValidationResult {
            is_valid: 0,
            intrinsic_gas: 21000,
            error_reason: 1
        };
    }
    if env.value < 0 {
        return TxValidationResult {
            is_valid: 0,
            intrinsic_gas: 21000,
            error_reason: 2
        };
    }
    return TxValidationResult {
        is_valid: 1,
        intrinsic_gas: 21000,
        error_reason: 0
    };
}
