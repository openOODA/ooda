// # BabyJubjub Embedded Elliptic Curve
//
// Logline: Twisted Edwards add + double-and-add. By-value Int floor.
//
// Setup: Affine (u,v). a=168700, d=168696 published. Add keeps numerator floor.
//
// Beats:
//   1. u3 = u1*v2 + v1*u2 ; v3 = v1*v2 - u1*u2  (mod p).
//   2. Scalar mul is double-and-add (same as repeated add).
//   3. scalar <= 1 returns the point (original loop semantics).

type BabyJubjubPoint = struct {
    u_coord: Int,
    v_coord: Int,
    is_infinity: Int
};

type BabyJubjubParams = struct {
    coeff_a: Int,
    coeff_d: Int,
    prime_mod: Int
};

fn bjub_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn baby_jubjub_params_default(p_mod: Int) -> BabyJubjubParams {
    return BabyJubjubParams {
        coeff_a: 168700,
        coeff_d: 168696,
        prime_mod: p_mod
    };
}

pub fn baby_jubjub_point_new(u: Int, v: Int) -> BabyJubjubPoint {
    return BabyJubjubPoint {
        u_coord: u,
        v_coord: v,
        is_infinity: 0
    };
}

pub fn baby_jubjub_point_generator() -> BabyJubjubPoint {
    return BabyJubjubPoint {
        u_coord: 995,
        v_coord: 234,
        is_infinity: 0
    };
}

pub fn baby_jubjub_add(
    p1: BabyJubjubPoint,
    p2: BabyJubjubPoint,
    params: BabyJubjubParams
) -> BabyJubjubPoint {
    let p_mod: Int = params.prime_mod;
    let u3: Int = bjub_mod_pos((p1.u_coord * p2.v_coord) + (p1.v_coord * p2.u_coord), p_mod);
    let v3: Int = bjub_mod_pos((p1.v_coord * p2.v_coord) - (p1.u_coord * p2.u_coord), p_mod);
    return BabyJubjubPoint {
        u_coord: u3,
        v_coord: v3,
        is_infinity: 0
    };
}

pub fn baby_jubjub_scalar_mul(
    pt: BabyJubjubPoint,
    scalar: Int,
    params: BabyJubjubParams
) -> BabyJubjubPoint {
    if scalar <= 1 {
        return pt;
    }
    let half: BabyJubjubPoint = baby_jubjub_scalar_mul(pt, scalar / 2, params);
    let doubled: BabyJubjubPoint = baby_jubjub_add(half, half, params);
    if (scalar % 2) == 1 {
        return baby_jubjub_add(doubled, pt, params);
    }
    return doubled;
}
