// # LogUp Fractional Lookup Argument
//
// Logline: sum m/(X+t) == sum 1/(X+f) via cross-multiply. Four-slot floor.
//
// Setup: Field fractions a/b + c/d = (ad+bc)/bd. Four witness and table slots.
//
// Beats:
//   1. Acc add: (a_num*b_den + b_num*a_den) / (a_den*b_den)  (mod p).
//   2. Equality is cross_l == cross_r.
//   3. Table identity: four 1/(X+f_i) vs four m_j/(X+t_j).

type LogupFraction = struct {
    numerator: Int,
    denominator_eval: Int
};

type LogupSumAccumulator = struct {
    sum_numerator: Int,
    sum_denominator: Int,
    prime_mod: Int
};

type LogupVerifyResult = struct {
    is_satisfied: Int,
    lhs_sum: Int,
    rhs_sum: Int
};

fn logup_mod_pos(x: Int, p_mod: Int) -> Int {
    let r: Int = x % p_mod;
    if r < 0 {
        return r + p_mod;
    }
    return r;
}

pub fn logup_fraction_new(num: Int, den: Int) -> LogupFraction {
    return LogupFraction {
        numerator: num,
        denominator_eval: den
    };
}

pub fn logup_accumulator_init(p_mod: Int) -> LogupSumAccumulator {
    return LogupSumAccumulator {
        sum_numerator: 0,
        sum_denominator: 1,
        prime_mod: p_mod
    };
}

pub fn logup_add_fraction(
    acc: LogupSumAccumulator,
    frac: LogupFraction
) -> LogupSumAccumulator {
    let p_mod: Int = acc.prime_mod;
    let a_num: Int = acc.sum_numerator;
    let a_den: Int = acc.sum_denominator;
    let b_num: Int = frac.numerator;
    let b_den: Int = frac.denominator_eval;
    let new_num: Int = logup_mod_pos((a_num * b_den) + (b_num * a_den), p_mod);
    let new_den: Int = logup_mod_pos(a_den * b_den, p_mod);
    return LogupSumAccumulator {
        sum_numerator: new_num,
        sum_denominator: new_den,
        prime_mod: p_mod
    };
}

pub fn logup_add_term(
    acc: LogupSumAccumulator,
    num: Int,
    x_ch: Int,
    slot_val: Int
) -> LogupSumAccumulator {
    let p_mod: Int = acc.prime_mod;
    let den: Int = logup_mod_pos(x_ch + slot_val, p_mod);
    if den == 0 {
        return acc;
    }
    return logup_add_fraction(acc, logup_fraction_new(num, den));
}

pub fn logup_verify_equality(
    lhs: LogupSumAccumulator,
    rhs: LogupSumAccumulator
) -> LogupVerifyResult {
    let p_mod: Int = lhs.prime_mod;
    let cross_l: Int = logup_mod_pos(lhs.sum_numerator * rhs.sum_denominator, p_mod);
    let cross_r: Int = logup_mod_pos(rhs.sum_numerator * lhs.sum_denominator, p_mod);
    if cross_l == cross_r {
        return LogupVerifyResult {
            is_satisfied: 1,
            lhs_sum: cross_l,
            rhs_sum: cross_r
        };
    }
    return LogupVerifyResult {
        is_satisfied: 0,
        lhs_sum: cross_l,
        rhs_sum: cross_r
    };
}

pub fn logup_verify_table(
    x_ch: Int,
    p_mod: Int,
    f0: Int,
    f1: Int,
    f2: Int,
    f3: Int,
    t0: Int,
    t1: Int,
    t2: Int,
    t3: Int,
    m0: Int,
    m1: Int,
    m2: Int,
    m3: Int
) -> LogupVerifyResult {
    let lhs0: LogupSumAccumulator = logup_accumulator_init(p_mod);
    let lhs1: LogupSumAccumulator = logup_add_term(lhs0, 1, x_ch, f0);
    let lhs2: LogupSumAccumulator = logup_add_term(lhs1, 1, x_ch, f1);
    let lhs3: LogupSumAccumulator = logup_add_term(lhs2, 1, x_ch, f2);
    let lhs4: LogupSumAccumulator = logup_add_term(lhs3, 1, x_ch, f3);
    let rhs0: LogupSumAccumulator = logup_accumulator_init(p_mod);
    let rhs1: LogupSumAccumulator = logup_add_term(rhs0, m0, x_ch, t0);
    let rhs2: LogupSumAccumulator = logup_add_term(rhs1, m1, x_ch, t1);
    let rhs3: LogupSumAccumulator = logup_add_term(rhs2, m2, x_ch, t2);
    let rhs4: LogupSumAccumulator = logup_add_term(rhs3, m3, x_ch, t3);
    return logup_verify_equality(lhs4, rhs4);
}
